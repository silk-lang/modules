  run Testing.expect(emitted(&a, &mut at, b"\xd3\xfa"), "sar edx, cl")
  run a.shiftCl(Shift.Sar, Width.W32, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xd3\xfd"), "sar r13d, cl")
  run a.signExtendAccumulator(Width.W32)
  run Testing.expect(emitted(&a, &mut at, b"\x99"), "cdq")
  run a.signExtendAccumulator(Width.W64)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x99"), "cqo")
}

test effect fn arithmeticMatchLlvm() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut a = Assembler.make()
  run arithmeticCases(&mut a) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn conditionsCases(a: &mut Assembler) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut at: usize = 0
  run a.setcc(Cond.Overflow, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x90\xc0"), "seto al")
  run a.setcc(Cond.Overflow, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x90\xc1"), "seto cl")
  run a.cmov(Cond.Overflow, Width.W64, Reg.Rax, Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x0f\x40\xc3"), "cmovo rax, rbx")
  run a.cmov(Cond.Overflow, Width.W32, Reg.Rax, Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x40\xc3"), "cmovo eax, ebx")
  run a.setcc(Cond.NoOverflow, Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x91\xc3"), "setno bl")
  run a.setcc(Cond.NoOverflow, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\x91\xc4"), "setno spl")
  run a.cmov(Cond.NoOverflow, Width.W64, Reg.Rbp, Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x0f\x41\xea"), "cmovno rbp, r10")
  run a.cmov(Cond.NoOverflow, Width.W32, Reg.Rbp, Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x41\xea"), "cmovno ebp, r10d")
  run a.setcc(Cond.Below, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\x92\xc4"), "setb spl")
  run a.setcc(Cond.Below, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\x92\xc7"), "setb dil")
  run a.cmov(Cond.Below, Width.W64, Reg.R10, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x0f\x42\xd1"), "cmovb r10, rcx")
  run a.cmov(Cond.Below, Width.W32, Reg.R10, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\x42\xd1"), "cmovb r10d, ecx")
  run a.setcc(Cond.AboveOrEqual, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\x93\xc5"), "setae bpl")
  run a.setcc(Cond.AboveOrEqual, Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x93\xc2"), "setae r10b")
  run a.cmov(Cond.AboveOrEqual, Width.W64, Reg.R15, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x0f\x43\xf8"), "cmovae r15, r8")
  run a.cmov(Cond.AboveOrEqual, Width.W32, Reg.R15, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x0f\x43\xf8"), "cmovae r15d, r8d")
  run a.setcc(Cond.Equal, Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\x94\xc6"), "sete sil")
  run a.setcc(Cond.Equal, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x94\xc5"), "sete r13b")
  run a.cmov(Cond.Equal, Width.W64, Reg.Rsp, Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x0f\x44\xe7"), "cmove rsp, r15")
  run a.cmov(Cond.Equal, Width.W32, Reg.Rsp, Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x44\xe7"), "cmove esp, r15d")
  run a.setcc(Cond.NotEqual, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x95\xc0"), "setne r8b")
  run a.setcc(Cond.NotEqual, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x95\xc0"), "setne al")
  run a.cmov(Cond.NotEqual, Width.W64, Reg.R9, Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x0f\x45\xce"), "cmovne r9, rsi")
  run a.cmov(Cond.NotEqual, Width.W32, Reg.R9, Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\x45\xce"), "cmovne r9d, esi")
  run a.setcc(Cond.BelowOrEqual, Reg.R12)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x96\xc4"), "setbe r12b")
  run a.setcc(Cond.BelowOrEqual, Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x96\xc3"), "setbe bl")
  run a.cmov(Cond.BelowOrEqual, Width.W64, Reg.R14, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x0f\x46\xf5"), "cmovbe r14, r13")
  run a.cmov(Cond.BelowOrEqual, Width.W32, Reg.R14, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x0f\x46\xf5"), "cmovbe r14d, r13d")
  run a.setcc(Cond.Above, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x97\xc5"), "seta r13b")
  run a.setcc(Cond.Above, Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\x97\xc6"), "seta sil")
  run a.cmov(Cond.Above, Width.W64, Reg.Rbx, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x0f\x47\xdc"), "cmova rbx, rsp")
  run a.cmov(Cond.Above, Width.W32, Reg.Rbx, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x47\xdc"), "cmova ebx, esp")
  run a.setcc(Cond.Sign, Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x98\xc7"), "sets r15b")
  run a.setcc(Cond.Sign, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x98\xc1"), "sets r9b")
  run a.cmov(Cond.Sign, Width.W64, Reg.R8, Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x0f\x48\xc3"), "cmovs r8, r11")
  run a.cmov(Cond.Sign, Width.W32, Reg.R8, Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x0f\x48\xc3"), "cmovs r8d, r11d")
  run a.setcc(Cond.NoSign, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x99\xc0"), "setns al")
  run a.setcc(Cond.NoSign, Reg.R12)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x99\xc4"), "setns r12b")
  run a.cmov(Cond.NoSign, Width.W64, Reg.R13, Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x0f\x49\xea"), "cmovns r13, rdx")
  run a.cmov(Cond.NoSign, Width.W32, Reg.R13, Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\x49\xea"), "cmovns r13d, edx")
  run a.setcc(Cond.Parity, Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x9a\xc3"), "setp bl")
  run a.setcc(Cond.Parity, Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x9a\xc7"), "setp r15b")
  run a.cmov(Cond.Parity, Width.W64, Reg.Rdx, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x0f\x4a\xd1"), "cmovp rdx, r9")
  run a.cmov(Cond.Parity, Width.W32, Reg.Rdx, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x4a\xd1"), "cmovp edx, r9d")
  run a.setcc(Cond.NoParity, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\x9b\xc4"), "setnp spl")
  run a.setcc(Cond.NoParity, Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x9b\xc2"), "setnp dl")
  run a.cmov(Cond.NoParity, Width.W64, Reg.Rdi, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x0f\x4b\xf8"), "cmovnp rdi, rax")
  run a.cmov(Cond.NoParity, Width.W32, Reg.Rdi, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x4b\xf8"), "cmovnp edi, eax")
  run a.setcc(Cond.Less, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\x9c\xc5"), "setl bpl")
  run a.setcc(Cond.Less, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\x9c\xc5"), "setl bpl")
  run a.cmov(Cond.Less, Width.W64, Reg.R12, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x0f\x4c\xe7"), "cmovl r12, rdi")
  run a.cmov(Cond.Less, Width.W32, Reg.R12, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\x4c\xe7"), "cmovl r12d, edi")
  run a.setcc(Cond.GreaterOrEqual, Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\x9d\xc6"), "setge sil")
  run a.setcc(Cond.GreaterOrEqual, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x9d\xc0"), "setge r8b")
  run a.cmov(Cond.GreaterOrEqual, Width.W64, Reg.Rcx, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x0f\x4d\xce"), "cmovge rcx, r14")
  run a.cmov(Cond.GreaterOrEqual, Width.W32, Reg.Rcx, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x4d\xce"), "cmovge ecx, r14d")
  run a.setcc(Cond.LessOrEqual, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x9e\xc0"), "setle r8b")
  run a.setcc(Cond.LessOrEqual, Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x9e\xc3"), "setle r11b")
  run a.cmov(Cond.LessOrEqual, Width.W64, Reg.Rsi, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x0f\x4e\xf5"), "cmovle rsi, rbp")
  run a.cmov(Cond.LessOrEqual, Width.W32, Reg.Rsi, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x4e\xf5"), "cmovle esi, ebp")
  run a.setcc(Cond.Greater, Reg.R12)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x9f\xc4"), "setg r12b")
  run a.setcc(Cond.Greater, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\x9f\xc6"), "setg r14b")
  run a.cmov(Cond.Greater, Width.W64, Reg.R11, Reg.R12)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x0f\x4f\xdc"), "cmovg r11, r12")
  run a.cmov(Cond.Greater, Width.W32, Reg.R11, Reg.R12)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x0f\x4f\xdc"), "cmovg r11d, r12d")
}

test effect fn conditionsMatchLlvm() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut a = Assembler.make()
  run conditionsCases(&mut a) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn doublesCases(a: &mut Assembler) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut at: usize = 0
  run a.loadDouble(Xmm.Xmm1, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x10\x08"), "movsd xmm1, qword ptr [rax]")
  run a.storeDouble(Mem.at(Reg.Rax, 0), Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x11\x08"), "movsd qword ptr [rax], xmm1")
  run a.loadFloat(Xmm.Xmm1, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x0f\x5a\x08"), "cvtss2sd xmm1, dword ptr [rax]")
  run a.storeFloat(Mem.at(Reg.Rax, 0), Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x0f\x11\x08"), "movss dword ptr [rax], xmm1")
  run a.loadDouble(Xmm.Xmm8, Mem.at(Reg.Rsp, 8))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x10\x44\x24\x08"), "movsd xmm8, qword ptr [rsp + 8]")
  run a.storeDouble(Mem.at(Reg.Rsp, 8), Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x11\x44\x24\x08"), "movsd qword ptr [rsp + 8], xmm8")
  run a.loadFloat(Xmm.Xmm8, Mem.at(Reg.Rsp, 8))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x44\x0f\x5a\x44\x24\x08"), "cvtss2sd xmm8, dword ptr [rsp + 8]")
  run a.storeFloat(Mem.at(Reg.Rsp, 8), Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x44\x0f\x11\x44\x24\x08"), "movss dword ptr [rsp + 8], xmm8")
  run a.loadDouble(Xmm.Xmm15, Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x10\x7d\x00"), "movsd xmm15, qword ptr [rbp]")
  run a.storeDouble(Mem.at(Reg.Rbp, 0), Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x11\x7d\x00"), "movsd qword ptr [rbp], xmm15")
  run a.loadFloat(Xmm.Xmm15, Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x44\x0f\x5a\x7d\x00"), "cvtss2sd xmm15, dword ptr [rbp]")
  run a.storeFloat(Mem.at(Reg.Rbp, 0), Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x44\x0f\x11\x7d\x00"), "movss dword ptr [rbp], xmm15")
  run a.loadDouble(Xmm.Xmm6, Mem.at(Reg.R8, 8))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x10\x70\x08"), "movsd xmm6, qword ptr [r8 + 8]")
  run a.storeDouble(Mem.at(Reg.R8, 8), Xmm.Xmm6)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x11\x70\x08"), "movsd qword ptr [r8 + 8], xmm6")
  run a.loadFloat(Xmm.Xmm6, Mem.at(Reg.R8, 8))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x41\x0f\x5a\x70\x08"), "cvtss2sd xmm6, dword ptr [r8 + 8]")
  run a.storeFloat(Mem.at(Reg.R8, 8), Xmm.Xmm6)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x41\x0f\x11\x70\x08"), "movss dword ptr [r8 + 8], xmm6")
  run a.loadDouble(Xmm.Xmm13, Mem.at(Reg.R12, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x45\x0f\x10\x2c\x24"), "movsd xmm13, qword ptr [r12]")
  run a.storeDouble(Mem.at(Reg.R12, 0), Xmm.Xmm13)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x45\x0f\x11\x2c\x24"), "movsd qword ptr [r12], xmm13")
  run a.loadFloat(Xmm.Xmm13, Mem.at(Reg.R12, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x45\x0f\x5a\x2c\x24"), "cvtss2sd xmm13, dword ptr [r12]")
  run a.storeFloat(Mem.at(Reg.R12, 0), Xmm.Xmm13)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x45\x0f\x11\x2c\x24"), "movss dword ptr [r12], xmm13")
  run a.loadDouble(Xmm.Xmm4, Mem.at(Reg.R13, 8))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x10\x65\x08"), "movsd xmm4, qword ptr [r13 + 8]")
  run a.storeDouble(Mem.at(Reg.R13, 8), Xmm.Xmm4)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x11\x65\x08"), "movsd qword ptr [r13 + 8], xmm4")
  run a.loadFloat(Xmm.Xmm4, Mem.at(Reg.R13, 8))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x41\x0f\x5a\x65\x08"), "cvtss2sd xmm4, dword ptr [r13 + 8]")
  run a.storeFloat(Mem.at(Reg.R13, 8), Xmm.Xmm4)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x41\x0f\x11\x65\x08"), "movss dword ptr [r13 + 8], xmm4")
  run a.loadDouble(Xmm.Xmm11, Mem.at(Reg.Rax, 127))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x10\x58\x7f"), "movsd xmm11, qword ptr [rax + 127]")
  run a.storeDouble(Mem.at(Reg.Rax, 127), Xmm.Xmm11)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x11\x58\x7f"), "movsd qword ptr [rax + 127], xmm11")
  run a.loadFloat(Xmm.Xmm11, Mem.at(Reg.Rax, 127))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x44\x0f\x5a\x58\x7f"), "cvtss2sd xmm11, dword ptr [rax + 127]")
  run a.storeFloat(Mem.at(Reg.Rax, 127), Xmm.Xmm11)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x44\x0f\x11\x58\x7f"), "movss dword ptr [rax + 127], xmm11")
  run a.loadDouble(Xmm.Xmm2, Mem.at(Reg.Rax, -129))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x10\x90\x7f\xff\xff\xff"), "movsd xmm2, qword ptr [rax - 129]")
  run a.storeDouble(Mem.at(Reg.Rax, -129), Xmm.Xmm2)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x11\x90\x7f\xff\xff\xff"), "movsd qword ptr [rax - 129], xmm2")
  run a.loadFloat(Xmm.Xmm2, Mem.at(Reg.Rax, -129))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x0f\x5a\x90\x7f\xff\xff\xff"), "cvtss2sd xmm2, dword ptr [rax - 129]")
  run a.storeFloat(Mem.at(Reg.Rax, -129), Xmm.Xmm2)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x0f\x11\x90\x7f\xff\xff\xff"), "movss dword ptr [rax - 129], xmm2")
  run a.loadDouble(Xmm.Xmm9, Mem.at(Reg.Rsp, 128))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x10\x8c\x24\x80\x00\x00\x00"), "movsd xmm9, qword ptr [rsp + 128]")
  run a.storeDouble(Mem.at(Reg.Rsp, 128), Xmm.Xmm9)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x11\x8c\x24\x80\x00\x00\x00"), "movsd qword ptr [rsp + 128], xmm9")
  run a.loadFloat(Xmm.Xmm9, Mem.at(Reg.Rsp, 128))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x44\x0f\x5a\x8c\x24\x80\x00\x00\x00"), "cvtss2sd xmm9, dword ptr [rsp + 128]")
  run a.storeFloat(Mem.at(Reg.Rsp, 128), Xmm.Xmm9)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x44\x0f\x11\x8c\x24\x80\x00\x00\x00"), "movss dword ptr [rsp + 128], xmm9")
  run a.loadDouble(Xmm.Xmm0, Mem.at(Reg.Rbp, 127))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x10\x45\x7f"), "movsd xmm0, qword ptr [rbp + 127]")
  run a.storeDouble(Mem.at(Reg.Rbp, 127), Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x11\x45\x7f"), "movsd qword ptr [rbp + 127], xmm0")
  run a.loadFloat(Xmm.Xmm0, Mem.at(Reg.Rbp, 127))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x0f\x5a\x45\x7f"), "cvtss2sd xmm0, dword ptr [rbp + 127]")
  run a.storeFloat(Mem.at(Reg.Rbp, 127), Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x0f\x11\x45\x7f"), "movss dword ptr [rbp + 127], xmm0")
  run a.loadDouble(Xmm.Xmm7, Mem.at(Reg.R12, 127))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x10\x7c\x24\x7f"), "movsd xmm7, qword ptr [r12 + 127]")
  run a.storeDouble(Mem.at(Reg.R12, 127), Xmm.Xmm7)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x11\x7c\x24\x7f"), "movsd qword ptr [r12 + 127], xmm7")
  run a.loadFloat(Xmm.Xmm7, Mem.at(Reg.R12, 127))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x41\x0f\x5a\x7c\x24\x7f"), "cvtss2sd xmm7, dword ptr [r12 + 127]")
  run a.storeFloat(Mem.at(Reg.R12, 127), Xmm.Xmm7)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x41\x0f\x11\x7c\x24\x7f"), "movss dword ptr [r12 + 127], xmm7")
  run a.loadDouble(Xmm.Xmm14, Mem.at(Reg.R12, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x45\x0f\x10\xb4\x24\x00\x00\x00\x80"), "movsd xmm14, qword ptr [r12 - 2147483648]")
  run a.storeDouble(Mem.at(Reg.R12, -2147483648), Xmm.Xmm14)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x45\x0f\x11\xb4\x24\x00\x00\x00\x80"), "movsd qword ptr [r12 - 2147483648], xmm14")
  run a.loadFloat(Xmm.Xmm14, Mem.at(Reg.R12, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x45\x0f\x5a\xb4\x24\x00\x00\x00\x80"), "cvtss2sd xmm14, dword ptr [r12 - 2147483648]")
  run a.storeFloat(Mem.at(Reg.R12, -2147483648), Xmm.Xmm14)
  run Testing.expect(emitted(&a, &mut at, b"\xf3\x45\x0f\x11\xb4\x24\x00\x00\x00\x80"), "movss dword ptr [r12 - 2147483648], xmm14")
  run a.loadDouble(Xmm.Xmm5, Mem.at(Reg.R13, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x10\xad\x00\x00\x00\x80"), "movsd xmm5, qword ptr [r13 - 2147483648]")
  run a.storeDouble(Mem.at(Reg.R13, -2147483648), Xmm.Xmm5)
