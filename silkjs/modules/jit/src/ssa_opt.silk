//! The optimization pipeline between the translator and the verifier: the ownership pass
//! (ssa_ownership.optimize), then the code quality passes (docs/jit/code-quality.md), one
//! file each (ssa_opt_*.silk) and one switch each, so a wrong answer or a slowdown can be
//! pinned on a pass by turning it off (`--jit-no-<pass>`).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import ssa { Function }
import ssa_translate { FunctionInput }
import ssa_ownership
import ssa_opt_borrow as borrow
import ssa_opt_escape as escape
import ssa_opt_hoist as hoisting
import ssa_opt_unboxed as unboxed
import ssa_opt_bounds as bounding
import silk.collections.list { List }

/// `--jit-no-borrow` clears it: element, length and variable reads that borrow (ssa_opt_borrow).
pub const PASS_BORROW: u32 = 1
/// `--jit-no-hoist` clears it: loop-invariant guards and loads in front of their loop
/// (ssa_opt_hoist).
pub const PASS_HOIST: u32 = 2
/// `--jit-no-unboxed` clears it: exits that name a value's unboxed number (ssa_opt_unboxed).
pub const PASS_UNBOXED: u32 = 4
/// `--jit-no-escape` clears it: own-slot field forwarding on fresh planned constructions
/// (ssa_opt_escape).
pub const PASS_ESCAPE: u32 = 8
/// `--jit-no-bounds` clears it: element indexes of counted loops proved in front of the loop
/// (ssa_opt_bounds). It builds on the hoisting pass's trust, so it does nothing without it.
pub const PASS_BOUNDS: u32 = 16
pub const PASS_ALL: u32 = 31
/// Loop levels one function's instructions move out through.
const HOIST_ROUNDS: u32 = 2

/// Runs the ownership pass and every pass `passes` names over a translated function. The
/// result is compacted and holds the verifier's rules. `input` is what it was translated
/// from. `sites` are the offsets the function's
/// earlier code deoptimized at (jit_recompile).
pub effect fn pipeline(f: &mut Function, input: &FunctionInput, passes: u32, sites: &List<u32>) -> () ! OutOfMemoryError ? &mut Allocator {
  run pipelineWithDeopts(&mut f, input, passes, sites, sites.length())
}
/// Runs `pipeline` where `sites[0..deoptCount]` are offsets earlier compiled code
/// deoptimized at (jit_recompile) and any entries past `deoptCount` are baseline-noted
/// misses (BaselineEnv.misses).
pub effect fn pipelineWithDeopts(f: &mut Function, input: &FunctionInput, passes: u32, sites: &List<u32>, deoptCount: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  // Removed instructions wait for one compaction: the two passes below only remove more.
  let mut loose = run ssa_ownership.optimizeLoose(&mut f)
  if u32.bitAnd(passes, PASS_BORROW) != 0 {
    // A field of an object read from a binding borrows once that read does.
    if run borrow.borrowReads(&mut f) { drop run ssa_ownership.borrowFields(&mut f) loose = true }
  }
  // Conditions made of several tests branch on the last one (it compacts what is loose).
  drop run ssa_ownership.threadConditions(&mut f, loose)
  if u32.bitAnd(passes, PASS_ESCAPE) != 0 && f.constructTargets.length() > 0 {
    if run escape.forwardConstructFields(&mut f, input, sites) {
      run ssa_ownership.simplify(&mut f)
    }
  }
  if u32.bitAnd(passes, PASS_HOIST) != 0 {
    let mut round: u32 = 0
    let mut unboxedEntries = false
    while round < HOIST_ROUNDS && run hoisting.hoist(&mut f, input, sites, deoptCount, &mut unboxedEntries) { run f.compact() round = round + 1 }
    // Entry edges that pass a loop's counters as boxes now: the parameters unbox.
    if unboxedEntries { run ssa_ownership.simplify(&mut f) }
    if run hoisting.sinkBoxes(&mut f) { run f.compact() }
    if u32.bitAnd(passes, PASS_BOUNDS) != 0 && run bounding.bounds(&mut f, sites, deoptCount) { run f.compact() }
  }
  if u32.bitAnd(passes, PASS_UNBOXED) != 0 {
    if run unboxed.repeatedReads(&mut f) { run f.compact() }
    if run unboxed.float64Elements(&mut f, sites) { run f.compact() }
    drop run unboxed.unboxedSlots(&mut f)
  }
  if u32.bitAnd(passes, PASS_ESCAPE) != 0 && f.constructTargets.length() > 0 {
    if run escape.virtualizeConstructs(&mut f, input, sites) {
      run ssa_ownership.simplify(&mut f)
    }
  }
  // Last: it reads every exit and changes none, and no pass after it adds a reader.
  if u32.bitAnd(passes, PASS_UNBOXED) != 0 { run unboxed.zeroProducts(&mut f) }
}
