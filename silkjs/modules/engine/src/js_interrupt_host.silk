//! Registered runtime interrupt callback. Counter policy and pending-error creation
//! belong to the native engine; this boundary invokes only the installed handler.
//! Handlers inherit the active allocator capability so reentrant weak collection
//! can enqueue finalization jobs through the owning runtime or fault allocator.
import silk.mem.allocator { Allocator }
import silk.mem.pointer { Pointer }
import js_heap { HeapHeader }
import js_core_types { NativeFunctionId }
import js_value { ValueBits }
import js_realm { Realm }

/// Host id for a C hot-function callback. The hook's opaque word points to a HotHandler.
pub const C_HOT_FUNCTION: u32 = 0x4c000292
/// function is an extern "C" fn(runtime: *mut HeapHeader, bytecode: *mut HeapHeader,
/// data: ?*mut u8) -> (). The bytecode is borrowed for the call.
pub struct HotHandler { pub function: *const u8, pub data: ?*mut u8 }

/// Invokes an embedder's C callback at a hot-function report. Its descriptor and data must
/// remain valid until the runtime is destroyed, and the callback must never run JavaScript.
pub unsafe fn dispatchHot(runtime: *mut HeapHeader, callback: NativeFunctionId, opaque: ?*mut u8, function: ValueBits) -> () {
  match callback {
    NativeFunctionId.Host { id } => { if id != C_HOT_FUNCTION { Intrinsic.trap("unregistered hot-function callback") } }
    _ => { Intrinsic.trap("unregistered hot-function callback") }
  }
  let bytecode = match function { ValueBits.FunctionBytecode { reference } => reference _ => { return () } }
  let anchor = ()
  let handler = unsafe Pointer.borrow<(), HotHandler>(&anchor, unsafe Intrinsic.pointerRequalify<*mut HotHandler, *const HotHandler>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HotHandler>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(opaque))))
  let entry = handler.function let data = handler.data
  drop handler
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn(*mut HeapHeader, *mut HeapHeader, ?*mut u8) -> ()>(Pointer.fromRef<*const u8>(&entry))
  let call = unsafe Pointer.read<extern "C" fn(*mut HeapHeader, *mut HeapHeader, ?*mut u8) -> ()>(slot)
  unsafe call(runtime, bytecode, data)
}

pub interface InterruptHooks {
  effect fn debugger<'r>(self: &mut Self, realm: Realm<'r>, event: u32) -> () ? &mut Allocator {}
  unsafe effect fn interrupt(self: &mut Self, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8) -> bool ? &mut Allocator
  /// The hot function handler (js_runtime.setHotFunctionHandler): function, a
  /// FunctionBytecode borrowed for the call, ran out of its entry budget. It must
  /// not run JavaScript.
  unsafe effect fn hotFunction(self: &mut Self, runtime: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, function: ValueBits) -> () ? &mut Allocator {}
}
