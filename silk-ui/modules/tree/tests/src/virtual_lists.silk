//! Exercises virtualization through the retained-tree protocol, without loom.
import ui_tree.css
import ui_tree.node { NONE }
import ui_tree.mutation { Role }
import ui_tree.access { AccessTree, ActionOutcome, accessId, doAction }
import accesskit.lib { Action, ActionRequest, TreeId }
import ui_tree.css { px, percent, Keyword }
import ui_tree.legacy {
  UiTree,
  TreeError,
  Batch,
  FrameInput,
  NodeKind,
  FlexDirection,
  Overflow,
  Attribute,
  Mutation,
  VirtualItem,
  VirtualOptions,
  VirtualRange
}
import ui_tree.inspect { info, NodeInfo }
import ui_fixtures.fixtures as fixtures
import ui_protocol.backend { Backend }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.usize
import silk.num.u32
import silk.num.f32

fn viewport(width: f32) -> FrameInput {
  return FrameInput { width: width, height: 400.0, scale: 1.0, time: 0.0 }
}

fn desired(range: VirtualRange, index: usize) -> bool {
  return index >= range.first && index < range.end || index == range.pinned
}

// This is all a binding client does: reconcile requested indices to ordinary node IDs.
// No heights, spacers, scroll correction or overscan calculations live in this client.
effect fn mount(tree: &mut UiTree<'_>, current: &mut List<VirtualItem>) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let range = tree.virtualRange(1).unwrapOr(
    VirtualRange { count: 0, first: 0, end: 0, pinned: usize.MAX, pinnedId: 0 },
  )
  let mut batch = Batch.make()
  let mut r: usize = 0
  while r < current.length() {
    let row = current.get(r)
    if !desired(range, row.index) {
      run batch.push(Mutation.Destroy { id: row.id })
    }
    r = r + 1
  }
  current.clear()
  let mut i = if range.pinned < range.first {
    range.pinned
  } else {
    range.first
  }
  while i < range.end || (i == range.pinned && i < range.count) {
    let id = 100 + usize.toU32(i) * 2
    if !tree.contains(id) {
      run batch.box(
        1,
        id,
        &[
          css.height(px(40.0 + usize.toF32(i % 3) * 30.0)),
          css.flexShrink(0.0),
        ],
      )
      run batch.attribute(id, Attribute.TabIndex { value: 0 })
    } else {
      run batch.push(Mutation.InsertBefore { parent: 1, child: id, before: Option<u32>.None })
    }
    run current.append(VirtualItem { index: i, id: id })
    let next = i + 1
    if i < range.first {
      i = range.first
    } else if next == range.end && range.pinned >= range.end && range.pinned < range.count {
      i = range.pinned
    } else {
      i = next
    }
  }
  run batch.virtualItems(1, current.asSlice())
  run tree.apply(run batch.take())
}

effect fn settle(tree: &mut UiTree<'_>, current: &mut List<VirtualItem>, width: f32) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut pass: usize = 0
  while pass < 6 {
    run tree.frame(viewport(width))
    run mount(&mut tree, &mut current)
    pass = pass + 1
  }
  run tree.frame(viewport(width))
}

effect fn applied(tree: &mut UiTree<'_>, mutation: Mutation) -> bool
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.push(move mutation)
  run tree.apply(run batch.take())
  return false
}

effect fn invalid(error: TreeError) -> bool {
  return match error {
    TreeError.BadVirtualList { index, id } => index == 0 && id == 1
    _ => false
  }
}

effect fn body() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.Role { value: Role.Feed })
  run batch.style(
    1,
    &[
      css.display(Keyword.Flex),
      css.flexDirection(FlexDirection.Column),
      css.height(px(300.0)),
      css.width(percent(100.0)),
      css.overflowY(Overflow.Auto),
    ],
  )
  run batch.virtualList(
    1,
    10000,
    VirtualOptions { estimatedHeight: 80.0, overscan: 150.0, gap: 5.0, revision: 0 },
  )
  run tree.apply(run batch.take())
  let mut current = List<VirtualItem>.make()
  let geometry = &tree.virtualLists.asSlice()[0]
  run Testing.expect(
    geometry.heights.length() == 0 && geometry.prefix(9999) == 849915.0
      && geometry.locate(849915.0) == 9999,
    "an unmeasured list can seek directly without allocating any per-row heights",
  )
  run mount(&mut tree, &mut current)
  run settle(&mut tree, &mut current, 400.0)
  run Testing.expect(tree.nodeCount() < 20, "a direct tree client mounts only requested rows")
  let last = current.get(current.length() - 1)
  run batch.text(last.id, 8, "buffered row")
  run tree.apply(run batch.take())
  run tree.frame(viewport(400.0))
  let mut publisher = AccessTree.make()
  let mut revealable = false
  if let Option.Some { value } = move run publisher.update(&tree) {
    let mut n: usize = 0
    while n < value.nodes.length() {
      let entry = &value.nodes.asSlice()[n]
      if entry.id.equals(accessId(1)) {
        run Testing.expect(entry.node.sizeOfSet().unwrapOr(0) == 10000 && entry.node.children().length < 20,
          "a virtual feed exposes the logical count without inventing accessible children")
      }
      if entry.id.equals(accessId(last.id)) { revealable = entry.node.supportsAction(Action.ScrollIntoView) }
      n = n + 1
    }
  }
  run Testing.expect(revealable, "the platform reader can request the last buffered row be revealed")
  let reveal = ActionRequest { action: Action.ScrollIntoView, targetTree: TreeId.root(),
    targetNode: accessId(8), data: Option.None }
  run Testing.expect((run doAction(&mut tree, &reveal)) == ActionOutcome.Done, "reader reveal accepted")
  run settle(&mut tree, &mut current, 400.0)
  run Testing.expect(current.get(current.length() - 1).index > last.index, "reading advances the mount boundary")
  run batch.scrollTo(1, 0.0, 0.0)
  run tree.apply(run batch.take())
  run settle(&mut tree, &mut current, 400.0)
  let mut invalidItems = List<VirtualItem>.make()
  run invalidItems.appendSlice(current.asSlice())
  invalidItems.set(1, VirtualItem { index: current.get(0).index, id: current.get(1).id })
  run Testing.expect(
    run Effect.catch<TreeError>(
      applied(&mut tree, Mutation.SetVirtualItems { id: 1, items: move invalidItems }),
      invalid,
    ),
    "duplicate item indices are rejected with the mutation index and container ID",
  )
  run Testing.expect(
    tree.virtualLists.asSlice()[0].rows.get(1).index == current.get(1).index,
    "invalid bindings preserve the previous valid bindings",
  )
  run Testing.expect(
    run Effect.catch<TreeError>(
      applied(
        &mut tree,
        Mutation.SetVirtualList {
          id: 1,
          count: 10000,
          options: VirtualOptions { estimatedHeight: 0.0, overscan: 100.0, gap: 0.0, revision: 0 },
        },
      ),
      invalid,
    ),
    "invalid estimates cannot corrupt an existing controller",
  )
  let focus = current.get(1).id
  run batch.box(focus, 9, &[])
  run batch.attribute(9, Attribute.TabIndex { value: 0 })
  run batch.focus(9)
  let mut targets = List<u32>.make()
  run targets.append(current.get(2).id)
  run batch.attribute(9, Attribute.ActiveDescendant { ids: move targets })
  tree.browseCursor = current.get(3).id
  run batch.scrollTo(1, 0.0, 200000.0)
  run tree.apply(run batch.take())
  run tree.frame(viewport(400.0))
  let wanted = run tree.virtualIndices(1)
  run Testing.expect(wanted.get(0) == 1 && wanted.get(1) == 2 && wanted.get(2) == 3 && wanted.get(3) > 1000,
    "focus, active descendant, and browse cursor retain three independent rows")
  let mut through = List<usize>.make()
  run Testing.expect(
    (run Backend.indices(&tree, 1, &mut through)) && through.length() == wanted.length()
      && through.get(0) == 1 && through.get(3) == wanted.get(3),
    "protocol clients such as Loom read the same request",
  )
  run Testing.expect(!(run Backend.indices(&tree, 77, &mut through)) && through.length() == 0,
    "a node with no list requests nothing")
  run Testing.expect(run Effect.catch<TreeError>(
    applied(&mut tree, Mutation.Destroy { id: current.get(2).id }), invalid), "active row cannot be recycled")
  run Testing.expect(run Effect.catch<TreeError>(
    applied(&mut tree, Mutation.Remove { id: current.get(3).id }), invalid), "browse row cannot be detached")
  run batch.attribute(9, Attribute.ActiveDescendant { ids: List<u32>.make() })
  run tree.apply(run batch.take())
  tree.browseCursor = NONE
  run settle(&mut tree, &mut current, 400.0)
  let range = tree.virtualRange(1).unwrapOr(
    VirtualRange { count: 0, first: 0, end: 0, pinned: usize.MAX, pinnedId: 0 },
  )
  run Testing.expect(
    range.first > 1000 && range.pinnedId == focus,
    "tree owns distant range and focus retention",
  )
  run Testing.expect(
    run Effect.catch<TreeError>(applied(&mut tree, Mutation.Destroy { id: focus }), invalid),
    "even a stale frontend cannot recycle the row containing the focused control",
  )
  run Testing.expect(
    run Effect.catch<TreeError>(applied(&mut tree, Mutation.Remove { id: focus }), invalid),
    "detaching the pinned row is rejected too",
  )
  run Testing.expect(tree.node(tree.focused).id == 9, "the same nested control keeps focus")
  run Testing.expect(
    tree.nodeCount() < 20 && tree.layout.nodeCount() < 60,
    "UI and private spacer storage remain bounded",
  )
  let mut visible = false
  let mut i: usize = 0
  while i < current.length() {
    if let Option<NodeInfo>.Some { value } = run info(&tree, current.get(i).id) {
      if value.bounds.yMin < 300.0 && value.bounds.yMax > 0.0 {
        visible = true
      }
    }
    i = i + 1
  }
  run Testing.expect(visible, "measured content covers the viewport after a distant jump")
  let anchor = tree.virtualLists.asSlice()[0].locate(tree.scrollOffset(1).y)
  run settle(&mut tree, &mut current, 600.0)
  run Testing.expect(
    tree.virtualLists.asSlice()[0].locate(tree.scrollOffset(1).y) == anchor,
    "tree preserves the visible index when width invalidates measurements",
  )
  run batch.push(Mutation.Blur)
  run batch.scrollTo(1, 0.0, 0.0)
  run tree.apply(run batch.take())
  run settle(&mut tree, &mut current, 600.0)
  run Testing.expect(tree.scrollOffset(1).y == 0.0, "return to top is exact")
  let nodes = tree.nodeCount()
  run batch.clearVirtualList(1)
  run tree.apply(run batch.take())
  run Testing.expect(
    tree.virtualRange(1).isNone() && tree.nodeCount() == nodes,
    "clearing virtualization preserves ordinary client nodes",
  )
  run batch.virtualList(
    1,
    10000,
    VirtualOptions { estimatedHeight: 80.0, overscan: 150.0, gap: 5.0, revision: 0 },
  )
  run batch.virtualItems(1, current.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(viewport(600.0))
  run batch.push(Mutation.Destroy { id: 1 })
  run tree.apply(run batch.take())
  run Testing.expect(
    tree.virtualLists.length() == 0 && tree.nodeCount() == 0,
    "destroying the container releases its controller and all private spacers",
  )
}

test effect fn directTreeVirtualization() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A client whose rows follow their items: row ids come from item keys, so an item keeps its
// node when items are added or removed around it.
effect fn mountKeyed(tree: &mut UiTree<'_>, keys: &List<usize>, current: &mut List<VirtualItem>) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let wanted = run tree.virtualIndices(1)
  let mut batch = Batch.make()
  let mut r: usize = 0
  while r < current.length() {
    let row = current.get(r)
    let mut kept = false
    let mut w: usize = 0
    while w < wanted.length() {
      if 100 + usize.toU32(keys.get(wanted.get(w))) * 2 == row.id { kept = true }
      w = w + 1
    }
    if !kept { run batch.push(Mutation.Destroy { id: row.id }) }
    r = r + 1
  }
  current.clear()
  let mut w: usize = 0
  while w < wanted.length() {
    let index = wanted.get(w)
    let key = keys.get(index)
    let id = 100 + usize.toU32(key) * 2
    if !tree.contains(id) {
      run batch.box(1, id, &[css.height(px(40.0 + usize.toF32(key % 3) * 30.0)), css.flexShrink(0.0)])
    } else {
      run batch.push(Mutation.InsertBefore { parent: 1, child: id, before: Option<u32>.None })
    }
    run current.append(VirtualItem { index: index, id: id })
    w = w + 1
  }
  run batch.virtualItems(1, current.asSlice())
  run tree.apply(run batch.take())
}

effect fn settleKeyed(tree: &mut UiTree<'_>, keys: &List<usize>, current: &mut List<VirtualItem>) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut pass: usize = 0
  while pass < 6 {
    run tree.frame(viewport(400.0))
    run mountKeyed(&mut tree, keys, &mut current)
    pass = pass + 1
  }
  run tree.frame(viewport(400.0))
}

// Rebinds the same rows to their items' new indices along with the new count, as a client
// does in the batch that adds or removes items.
effect fn recount(tree: &mut UiTree<'_>, keys: &List<usize>, current: &mut List<VirtualItem>) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut rows = List<VirtualItem>.make()
  let mut r: usize = 0
  while r < current.length() {
    let row = current.get(r)
    let mut index: usize = 0
    while index < keys.length() && 100 + usize.toU32(keys.get(index)) * 2 != row.id { index = index + 1 }
    if index < keys.length() {
      run rows.append(VirtualItem { index: index, id: row.id })
    } else {
      run batch1(&mut tree, Mutation.Destroy { id: row.id })
    }
    r = r + 1
  }
  let mut batch = Batch.make()
  run batch.virtualList(1, keys.length(), VirtualOptions { estimatedHeight: 80.0, overscan: 150.0, gap: 0.0, revision: 0 })
  run batch.virtualItems(1, rows.asSlice())
  run tree.apply(run batch.take())
  current.* = move rows
  run tree.frame(viewport(400.0))
}

effect fn batch1(tree: &mut UiTree<'_>, mutation: Mutation) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.push(move mutation)
  run tree.apply(run batch.take())
}

effect fn countChanges() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(1, &[css.display(Keyword.Flex), css.flexDirection(FlexDirection.Column),
    css.height(px(300.0)), css.width(percent(100.0)), css.overflowY(Overflow.Auto)])
  run batch.virtualList(1, 1000, VirtualOptions { estimatedHeight: 80.0, overscan: 150.0, gap: 0.0, revision: 0 })
  run tree.apply(run batch.take())
  let mut keys = List<usize>.make()
  let mut k: usize = 0
  while k < 1000 { run keys.append(k) k = k + 1 }
  let mut current = List<VirtualItem>.make()
  run settleKeyed(&mut tree, &keys, &mut current)
  run batch.scrollTo(1, 0.0, 2000.0)
  run tree.apply(run batch.take())
  run settleKeyed(&mut tree, &keys, &mut current)
  let list = &tree.virtualLists.asSlice()[0]
  let top = list.locate(tree.scrollOffset(1).y)
  let offset = tree.scrollOffset(1).y - list.prefix(top)
  let topKey = keys.get(top)
  let measured = current.get(0).index
  let height = list.heights.get(measured)
  run Testing.expect(height == 40.0 + usize.toF32(keys.get(measured) % 3) * 30.0, "rows near the viewport are measured")

  // One item added at the top.
  run keys.insert(0, 5000)
  run recount(&mut tree, &keys, &mut current)
  let added = &tree.virtualLists.asSlice()[0]
  run Testing.expect(added.count == 1001 && added.heights.get(measured + 1) == height,
    "an item added above keeps the measured heights with their items")
  let scroll = tree.scrollOffset(1).y
  let at = added.locate(scroll)
  run Testing.expect(keys.get(at) == topKey && f32.abs(scroll - added.prefix(at) - offset) < 0.5,
    "the item at the top of the viewport stays there, at the same offset")

  // One item added at the end, one removed at the top.
  run keys.append(5001)
  run recount(&mut tree, &keys, &mut current)
  drop keys.remove(0)
  run recount(&mut tree, &keys, &mut current)
  let moved = &tree.virtualLists.asSlice()[0]
  run Testing.expect(moved.count == 1001 && moved.heights.get(measured) == height,
    "items added below or removed above keep the rest of the measurements")
  run Testing.expect(keys.get(moved.locate(tree.scrollOffset(1).y)) == topKey, "and the viewport keeps its item")
}

test effect fn countChangesKeepMeasurements() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run countChanges() |> Effect.provideMut<Allocator>(&mut allocator)
}
