//! The CSS properties Silk UI animates: what `@keyframes` and `transition` can change over
//! time. A keyframe that sets any other property leaves it at its base value, so the build
//! warns about it ([`stillKeyframes`]). ui-tree's motion fields are the source of this list,
//! and its tests check the two agree.
import style.sheet { Sheet, Declaration }
import properties.catalog { Property }
import properties.catalog
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Every animated longhand, then the shorthands of them.
const NAMES: [&'static [u8]; 73] = [
  b"opacity",
  b"color",
  b"background-color",
  b"border-top-color",
  b"border-right-color",
  b"border-bottom-color",
  b"border-left-color",
  b"border-top-left-radius",
  b"border-top-right-radius",
  b"border-bottom-right-radius",
  b"border-bottom-left-radius",
  b"box-shadow",
  b"backdrop-filter",
  b"width",
  b"height",
  b"min-width",
  b"min-height",
  b"max-width",
  b"max-height",
  b"flex-basis",
  b"margin-top",
  b"margin-right",
  b"margin-bottom",
  b"margin-left",
  b"padding-top",
  b"padding-right",
  b"padding-bottom",
  b"padding-left",
  b"top",
  b"right",
  b"bottom",
  b"left",
  b"border-top-width",
  b"border-right-width",
  b"border-bottom-width",
  b"border-left-width",
  b"row-gap",
  b"column-gap",
  b"font-size",
  b"text-decoration-color",
  b"flex-grow",
  b"flex-shrink",
  b"visibility",
  b"display",
  b"transform",
  b"translate",
  b"rotate",
  b"scale",
  b"transform-origin",
  b"perspective",
  b"perspective-origin",
  b"offset-distance",
  b"offset-rotate",
  b"offset-anchor",
  b"offset-position",
  b"filter",
  b"border-color",
  b"border-radius",
  b"margin",
  b"padding",
  b"inset",
  b"border-width",
  b"border",
  b"border-top",
  b"border-right",
  b"border-bottom",
  b"border-left",
  b"gap",
  b"flex",
  b"background",
  b"font",
  b"text-decoration",
  b"offset",
]

/// Whether the tree animates `name`, a longhand or a shorthand of animated longhands.
pub fn animates(name: &[u8]) -> bool {
  let mut i: usize = 0
  while i < NAMES.length {
    if same(NAMES[i], name) { return true }
    i = i + 1
  }
  return false
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  return true
}

/// The CSS name of `property`.
pub fn propertyName(property: Property) -> &'static [u8] {
  return catalog.name(property)
}

/// A property one `@keyframes` rule sets that does not animate.
pub struct Still {
  /// The `@keyframes` name.
  pub keyframes: Bytes,
  pub property: Property,
}

/// The properties `sheet`'s `@keyframes` rules set that Silk UI does not animate, once per
/// rule and property. `animation-timing-function` and custom properties are not among them.
pub effect fn stillKeyframes(sheet: &Sheet) -> List<Still> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<Still>.make()
  let rules = sheet.keyframes.asSlice()
  let declarations = sheet.declarations.asSlice()
  let mut rule: usize = 0
  while rule < rules.length {
    let frames = rules[rule].frames.asSlice()
    let first = out.length()
    let mut frame: usize = 0
    while frame < frames.length {
      let mut at = frames[frame].declarations.start
      while at < frames[frame].declarations.end && at < declarations.length {
        let property = match &declarations[at] {
          Declaration.ColorExpression { property, .. } => property
          Declaration.Typed { property, .. } => property
          Declaration.Pending { property, .. } => property
          Declaration.Custom { .. } => Property.AnimationTimingFunction
        }
        if property != Property.AnimationTimingFunction && !animates(catalog.name(property)) {
          let mut seen = false
          let mut k = first
          while k < out.length() {
            if out.asSlice()[k].property == property { seen = true }
            k = k + 1
          }
          if !seen {
            run out.append(Still { keyframes: run Bytes.copy(rules[rule].name.asSlice()), property: property })
          }
        }
        at = at + 1
      }
      frame = frame + 1
    }
    rule = rule + 1
  }
  return move out
}
