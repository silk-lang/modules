// ---- A `RawSeqStore_t` and its sequences. ----

unsafe fn readPointer(p: [*]const u8, at: usize) -> ?[*]mut u8 {
  return unsafe Pointer.readUnaligned<?[*]mut u8>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) ?[*]mut u8>(unsafe Pointer.at<u8>(p, at)))
}
unsafe fn writePointer(p: [*]mut u8, at: usize, value: ?[*]mut u8) -> () {
  unsafe Pointer.writeUnaligned<?[*]mut u8>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut align(1) ?[*]mut u8>(unsafe Pointer.atMut<u8>(p, at)), value)
}

@inlineAlways
unsafe fn rz(p: [*]mut u8, at: usize) -> usize { return u64.toUsize(unsafe mem.r64(unsafe mem.ro(p), at)) }
@inlineAlways
unsafe fn wz(p: [*]mut u8, at: usize, v: usize) -> () { unsafe mem.w64(p, at, usize.toU64(v)) }

/// Sets the `RawSeqStore_t` at `store` (`zopt.RSS_BYTES` bytes) to the `size` sequences at `seq`,
/// of which none is consumed, with room for `capacity`.
pub unsafe fn storeInit(store: [*]mut u8, seq: ?[*]mut u8, size: usize, capacity: usize) -> () {
  unsafe writePointer(store, zopt.RSS_SEQ, seq)
  unsafe wz(store, zopt.RSS_POS, 0)
  unsafe wz(store, zopt.RSS_POS_IN_SEQUENCE, 0)
  unsafe wz(store, zopt.RSS_SIZE, size)
  unsafe wz(store, zopt.RSS_CAPACITY, capacity)
}

/// The number of sequences of the store.
pub unsafe fn storeSize(store: [*]mut u8) -> usize { return unsafe rz(store, zopt.RSS_SIZE) }

/// Whether the store has sequences that are not consumed yet (`pos < size`).
pub unsafe fn storePending(store: [*]mut u8) -> bool { return unsafe rz(store, zopt.RSS_POS) < unsafe rz(store, zopt.RSS_SIZE) }

// The sequences of a store: a pointer that is only used when the store is not empty.
@inlineAlways
unsafe fn storeSeq(store: [*]mut u8) -> [*]mut u8 { return unsafe mem.nn(unsafe readPointer(unsafe mem.ro(store), zopt.RSS_SEQ)) }

struct RawSeq {
  offset: u32,
  litLength: u32,
  matchLength: u32,
}
impl Copy for RawSeq {}

// ---- Sizes. ----

/// `ZSTD_ldm_getTableSize`, without the rounding of the workspace: the bytes of the hash table
/// and of the bucket offsets.
pub fn getTableSize(params: &LdmParams) -> usize {
  if params.enableLdm != cparams.PS_ENABLE { return 0 }
  let bucketSizeLog = if params.bucketSizeLog < params.hashLog { params.bucketSizeLog } else { params.hashLog }
  return mem.shlz(1, params.hashLog - bucketSizeLog) + mem.shlz(1, params.hashLog) * 8
}

/// `ZSTD_ldm_getMaxNbSeq`.
pub fn getMaxNbSeq(params: &LdmParams, maxChunkSize: usize) -> usize {
  if params.enableLdm != cparams.PS_ENABLE { return 0 }
  return maxChunkSize / mem.z(params.minMatchLength)
}

// ---- XXH64 of a short range, with seed 0. ----
const XP1: u64 = 0x9E3779B185EBCA87
const XP2: u64 = 0xC2B2AE3D27D4EB4F
const XP3: u64 = 0x165667B19E3779F9
const XP4: u64 = 0x85EBCA77C2B2AE63
const XP5: u64 = 0x27D4EB2F165667C5

@inlineAlways
fn xround(acc: u64, lane: u64) -> u64 {
  return u64.wrappingMultiply(u64.rotateLeft(u64.wrappingAdd(acc, u64.wrappingMultiply(lane, XP2)), 31), XP1)
}
@inlineAlways
fn xmerge(hash: u64, lane: u64) -> u64 {
  return u64.wrappingAdd(u64.wrappingMultiply(hash ^ xround(0, lane), XP1), XP4)
}

// `XXH64(p + at, length, 0)`.
unsafe fn xxh64(p: [*]const u8, at: usize, length: usize) -> u64 {
  let end = mem.ua(at, length)
  let mut i = at
  let mut hash: u64 = XP5
  if length >= 32 {
    let mut v1 = u64.wrappingAdd(XP1, XP2)
    let mut v2 = XP2
    let mut v3: u64 = 0
    let mut v4 = u64.wrappingSubtract(0, XP1)
    while mem.ua(i, 32) <= end {
      v1 = xround(v1, unsafe mem.r64(p, i))
      v2 = xround(v2, unsafe mem.r64(p, mem.ua(i, 8)))
      v3 = xround(v3, unsafe mem.r64(p, mem.ua(i, 16)))
      v4 = xround(v4, unsafe mem.r64(p, mem.ua(i, 24)))
      i = mem.ua(i, 32)
    }
    hash = u64.wrappingAdd(u64.wrappingAdd(u64.rotateLeft(v1, 1), u64.rotateLeft(v2, 7)), u64.wrappingAdd(u64.rotateLeft(v3, 12), u64.rotateLeft(v4, 18)))
    hash = xmerge(hash, v1)
    hash = xmerge(hash, v2)
    hash = xmerge(hash, v3)
    hash = xmerge(hash, v4)
  }
  hash = u64.wrappingAdd(hash, usize.toU64(length))
  while mem.ua(i, 8) <= end {
    hash = hash ^ xround(0, unsafe mem.r64(p, i))
    hash = u64.wrappingAdd(u64.wrappingMultiply(u64.rotateLeft(hash, 27), XP1), XP4)
    i = mem.ua(i, 8)
  }
  if mem.ua(i, 4) <= end {
    hash = hash ^ u64.wrappingMultiply(u32.toU64(unsafe mem.r32(p, i)), XP1)
    hash = u64.wrappingAdd(u64.wrappingMultiply(u64.rotateLeft(hash, 23), XP2), XP3)
    i = mem.ua(i, 4)
  }
  while i < end {
    hash = hash ^ u64.wrappingMultiply(u8.toU64(unsafe mem.r8(p, i)), XP5)
    hash = u64.wrappingMultiply(u64.rotateLeft(hash, 11), XP1)
    i = mem.ua(i, 1)
  }
  hash = hash ^ u64.shiftRight(hash, 33)
  hash = u64.wrappingMultiply(hash, XP2)
  hash = hash ^ u64.shiftRight(hash, 29)
  hash = u64.wrappingMultiply(hash, XP3)
  hash = hash ^ u64.shiftRight(hash, 32)
  return hash
}

// ---- The gear hash (`ldmRollingHashState_t`). ----
struct Gear {
  rolling: u64,
  stopMask: u64,
}

// `ZSTD_ldm_gear_init`: the state that cuts on average every `1 << hashRateLog` bytes.
fn gearInit(params: &LdmParams) -> Gear {
  let maxBitsInMask: u32 = if params.minMatchLength < 64 { params.minMatchLength } else { 64 }
  let hashRateLog = params.hashRateLog
  let mut stopMask: u64 = 0
  if hashRateLog > 0 && hashRateLog <= maxBitsInMask {
    // The bits of highest weight that still depend on `minMatchLength` bytes only.
    stopMask = mem.shl64(u64.wrappingSubtract(mem.shl64(1, hashRateLog), 1), maxBitsInMask - hashRateLog)
  } else {
    // In this degenerate case we simply honor the hash rate.
    stopMask = u64.wrappingSubtract(mem.shl64(1, hashRateLog), 1)
  }
  return Gear { rolling: 0xFFFFFFFF, stopMask: stopMask }
}

// `ZSTD_ldm_gear_reset` is not ported as a function: the reference computes the hash of
// `minMatchLength` bytes and does not store it in the state, so it changes nothing.

// `ZSTD_ldm_gear_feed`: hashes `data[at..at + size]` and adds to `splits` the offsets (from
// `at`, of the byte after the cut) of the cut points, until the data ends or `splits` holds
// `BATCH_SIZE` of them. Returns the number of bytes hashed.
unsafe fn gearFeed(state: &mut Gear, data: [*]const u8, at: usize, size: usize, splits: &mut [usize; 64], numSplits: &mut u32) -> usize {
  let mut hash = state.rolling
  let mask = state.stopMask
  let mut n: usize = 0
  let mut found = numSplits.*
  while n < size {
    hash = u64.wrappingAdd(u64.shiftLeft(hash, 1), GEAR_TAB[u8.toUsize(unsafe mem.r8(data, mem.ua(at, n)))])
    n = mem.ua(n, 1)
    if (hash & mask) == 0 {
      splits[mem.z(found) & 63] = n
      found = found + 1
      if found == BATCH_SIZE { break }
    }
  }
  state.rolling = hash
  numSplits.* = found
  return n
}

// ---- The hash table. ----

// `ZSTD_ldm_insertEntry`: puts the entry in the bucket of `hash`, over the oldest one.
@inlineAlways
unsafe fn insertEntry(table: [*]mut u8, bucketOffsets: [*]mut u8, hash: usize, offset: u32, checksum: u32, bucketSizeLog: u32) -> () {
  let slot = u8.toUsize(unsafe mem.r8(unsafe mem.ro(bucketOffsets), hash))
  let at = usize.wrappingMultiply(mem.ua(mem.shlz(hash, bucketSizeLog), slot), 8)
  unsafe mem.w32(table, at, offset)
  unsafe mem.w32(table, mem.ua(at, 4), checksum)
  unsafe mem.w8(bucketOffsets, hash, usize.wrappingToU8(mem.ua(slot, 1) & mem.us(mem.shlz(1, bucketSizeLog), 1)))
}

// `ZSTD_ldm_countBackwardsMatch`: how many bytes before `inBase[pIn]` and `mBase[pMatch]` are
// equal, not going below `pAnchor` and `pMatchBase`.
@inlineAlways
unsafe fn countBackwardsMatch(inBase: [*]const u8, pIn: usize, pAnchor: usize, mBase: [*]const u8, pMatch: usize, pMatchBase: usize) -> usize {
  let mut length: usize = 0
  while mem.us(pIn, length) > pAnchor && mem.us(pMatch, length) > pMatchBase
    && unsafe mem.r8(inBase, mem.us(mem.us(pIn, length), 1)) == unsafe mem.r8(mBase, mem.us(mem.us(pMatch, length), 1)) {
    length = mem.ua(length, 1)
  }
  return length
}

/// `ZSTD_ldm_fillHashTable`: inserts the cut points of `base[ip..iend]` (indices of the window of
/// `ls`) into the table, without looking for matches: the load of a dictionary.
pub unsafe fn fillHashTable(ls: &mut LdmState, ip0: usize, iend: usize, params: &LdmParams) -> () {
  let minMatchLength = mem.z(params.minMatchLength)
  let bucketSizeLog = params.bucketSizeLog
  let hBits = params.hashLog - bucketSizeLog
  let hMask = mem.us(mem.shlz(1, hBits), 1)
  let base = ls.window.base
  let table = unsafe mem.nn(ls.hashTable)
  let bucketOffsets = unsafe mem.nn(ls.bucketOffsets)
  let istart = ip0
  let mut ip = ip0
  let mut splits: [usize; 64] = [0; 64]
  let mut hashState = gearInit(&params)
  while ip < iend {
    let mut numSplits: u32 = 0
    let hashed = unsafe gearFeed(&mut hashState, base, ip, mem.us(iend, ip), &mut splits, &mut numSplits)
    let mut n: usize = 0
    while n < mem.z(numSplits) {
      if mem.ua(ip, splits[n]) >= mem.ua(istart, minMatchLength) {
        let split = mem.us(mem.ua(ip, splits[n]), minMatchLength)
        let xxhash = unsafe xxh64(base, split, minMatchLength)
        let hash = u64.toUsize(xxhash & 0xFFFFFFFF) & hMask
        unsafe insertEntry(table, bucketOffsets, hash, mem.t32(split), u64.wrappingToU32(u64.shiftRight(xxhash, 32)), bucketSizeLog)
      }
      n = n + 1
    }
    ip = mem.ua(ip, hashed)
  }
}

// `ZSTD_ldm_generateSequences_internal`: finds the long distance matches of `src[0..srcSize]`,
// which is in the window of `ls`, and adds them to `store`. Returns the number of bytes after
// the last match, or an error if the store is full.
unsafe fn generateSequencesInternal(ls: &mut LdmState, store: [*]mut u8, params: &LdmParams, src: [*]const u8, srcSize: usize) -> usize {
  // LDM parameters.
  let extDict = cstate.windowHasExtDict(&ls.window)
  let minMatchLength = mem.z(params.minMatchLength)
  let bucketSizeLog = params.bucketSizeLog
  let entsPerBucket = mem.shlz(1, bucketSizeLog)
  let hBits = params.hashLog - bucketSizeLog
  let hMask = mem.us(mem.shlz(1, hBits), 1)
  // Prefix and extDict parameters.
  let dictLimit = ls.window.dictLimit
  let lowestIndex: u32 = if extDict { ls.window.lowLimit } else { dictLimit }
  let base = ls.window.base
  let dictBase = ls.window.dictBase
  let dictStart = mem.z(lowestIndex)
  let dictEnd = mem.z(dictLimit)
  let lowPrefix = mem.z(dictLimit)
  let table = unsafe mem.nn(ls.hashTable)
  let tableRead = unsafe mem.ro(table)
  let bucketOffsets = unsafe mem.nn(ls.bucketOffsets)
  // Input bounds, as indices of the window.
  let istart = mem.us(mem.addr(src), mem.addr(base))
  let iend = mem.ua(istart, srcSize)
  // Input positions.
  let mut anchor = istart
  let mut ip = istart
  // Arrays for staged processing.
  let mut splits: [usize; 64] = [0; 64]
  let mut candSplit: [usize; 64] = [0; 64]
  let mut candHash: [usize; 64] = [0; 64]
  let mut candChecksum: [u32; 64] = [0; 64]
  if srcSize < minMatchLength { return mem.us(iend, anchor) }
  // The rolling hash starts after the first `minMatchLength` bytes.
  let mut hashState = gearInit(&params)
  ip = mem.ua(ip, minMatchLength)
  // `ip < ilimit`, where `ilimit` is `iend - HASH_READ_SIZE`.
  while mem.ua(ip, cstate.HASH_READ_SIZE) < iend {
    let mut numSplits: u32 = 0
    let hashed = unsafe gearFeed(&mut hashState, base, ip, mem.us(mem.us(iend, cstate.HASH_READ_SIZE), ip), &mut splits, &mut numSplits)
    let count = mem.z(numSplits)
    let mut n: usize = 0
    while n < count {
      let split = mem.us(mem.ua(ip, splits[n]), minMatchLength)
      let xxhash = unsafe xxh64(base, split, minMatchLength)
      candSplit[n] = split
      candHash[n] = u64.toUsize(xxhash & 0xFFFFFFFF) & hMask
      candChecksum[n] = u64.wrappingToU32(u64.shiftRight(xxhash, 32))
      n = n + 1
    }
    n = 0
    while n < count {
      let split = candSplit[n]
      let checksum = candChecksum[n]
      let hash = candHash[n]
      n = n + 1
      let newOffset = mem.t32(split)
      // A cut point that would give a sequence overlapping the previous one is only
      // registered in the table.
      if split < anchor {
        unsafe insertEntry(table, bucketOffsets, hash, newOffset, checksum, bucketSizeLog)
        continue
      }
      let mut forwardMatchLength: usize = 0
      let mut backwardMatchLength: usize = 0
      let mut bestMatchLength: usize = 0
      let mut bestOffset: u32 = 0
      let mut found = false
      let bucket = usize.wrappingMultiply(mem.shlz(hash, bucketSizeLog), 8)
      let mut e: usize = 0
      while e < entsPerBucket {
        let at = mem.ua(bucket, usize.wrappingMultiply(e, 8))
        e = e + 1
        let curOffset = unsafe mem.r32(tableRead, at)
        if unsafe mem.r32(tableRead, mem.ua(at, 4)) != checksum || curOffset <= lowestIndex { continue }
        let cur = mem.z(curOffset)
        let mut curForwardMatchLength: usize = 0
        let mut curBackwardMatchLength: usize = 0
        if extDict {
          let inDict = curOffset < dictLimit
          let curMatchBase = if inDict { dictBase } else { base }
          let matchEnd = if inDict { dictEnd } else { iend }
          let lowMatch = if inDict { dictStart } else { lowPrefix }
          curForwardMatchLength = unsafe cstate.count2segments(base, split, iend, curMatchBase, cur, matchEnd, lowPrefix)
          if curForwardMatchLength < minMatchLength { continue }
          // `ZSTD_ldm_countBackwardsMatch_2segments`.
          curBackwardMatchLength = unsafe countBackwardsMatch(base, split, anchor, curMatchBase, cur, lowMatch)
          let reachedLow = mem.us(cur, curBackwardMatchLength) == lowMatch
          let lowIsDictStart = mem.ua(mem.addr(curMatchBase), lowMatch) == mem.ua(mem.addr(dictBase), dictStart)
          if reachedLow && !lowIsDictStart {
            // The match goes on backwards from the end of the dictionary segment.
            curBackwardMatchLength = mem.ua(curBackwardMatchLength, unsafe countBackwardsMatch(base, mem.us(split, curBackwardMatchLength), anchor, dictBase, dictEnd, dictStart))
          }
        } else {
          curForwardMatchLength = unsafe cstate.count(base, split, base, cur, iend)
          if curForwardMatchLength < minMatchLength { continue }
          curBackwardMatchLength = unsafe countBackwardsMatch(base, split, anchor, base, cur, lowPrefix)
        }
        let curTotalMatchLength = mem.ua(curForwardMatchLength, curBackwardMatchLength)
        if curTotalMatchLength > bestMatchLength {
          bestMatchLength = curTotalMatchLength
          forwardMatchLength = curForwardMatchLength
          backwardMatchLength = curBackwardMatchLength
          bestOffset = curOffset
          found = true
        }
      }
      // No match found: insert the entry and go to the next candidate.
      if !found {
        unsafe insertEntry(table, bucketOffsets, hash, newOffset, checksum, bucketSizeLog)
        continue
      }
      // Match found.
      let size = unsafe rz(store, zopt.RSS_SIZE)
      // Out of sequence storage.
      if size == unsafe rz(store, zopt.RSS_CAPACITY) { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
      let seq = unsafe storeSeq(store)
      let seqAt = usize.wrappingMultiply(size, zopt.RAWSEQ_BYTES)
      unsafe mem.w32(seq, seqAt, mem.s32(newOffset, bestOffset))
      unsafe mem.w32(seq, mem.ua(seqAt, 4), mem.t32(mem.us(mem.us(split, backwardMatchLength), anchor)))
      unsafe mem.w32(seq, mem.ua(seqAt, 8), mem.t32(mem.ua(forwardMatchLength, backwardMatchLength)))
      unsafe wz(store, zopt.RSS_SIZE, mem.ua(size, 1))
      // Insert the current entry after the lookup, so that it does not clobber the best entry.
      unsafe insertEntry(table, bucketOffsets, hash, newOffset, checksum, bucketSizeLog)
      anchor = mem.ua(split, forwardMatchLength)
      // A match that ends after the data hashed so far is a repeating, overlapping pattern (all
      // zeroes, for one). Only its first repetition goes into the table: skip the others.
      if anchor > mem.ua(ip, hashed) {
        // (`ZSTD_ldm_gear_reset` here changes nothing.) Continue the outer loop at `anchor`.
        ip = mem.us(anchor, hashed)
        break
      }
    }
    ip = mem.ua(ip, hashed)
  }
  return mem.us(iend, anchor)
}

// `ZSTD_ldm_reduceTable`: lowers the offsets of the table by `reducerValue`.
unsafe fn reduceTable(table: [*]mut u8, size: usize, reducerValue: u32) -> () {
  let mut u: usize = 0
  while u < size {
    let at = usize.wrappingMultiply(u, 8)
    let offset = unsafe mem.r32(unsafe mem.ro(table), at)
    if offset < reducerValue { unsafe mem.w32(table, at, 0) } else { unsafe mem.w32(table, at, offset - reducerValue) }
    u = u + 1
  }
}

/// `ZSTD_ldm_generateSequences`: adds to `store` the long distance matches of
/// `src[0..srcSize]`, which the caller already added to the window of `ls`
/// (`cstate.windowUpdate`). Returns 0 or an error.
///
/// The literals after the last match are not in the store: the caller counts them with the
/// size of what it compresses.
pub unsafe fn generateSequences(ls: &mut LdmState, store: [*]mut u8, params: &LdmParams, src: [*]const u8, srcSize: usize) -> usize {
  let maxDist = mem.shl32(1, params.windowLog)
  let partial: usize = if srcSize % MAX_CHUNK_SIZE != 0 { 1 } else { 0 }
  let nbChunks = srcSize / MAX_CHUNK_SIZE + partial
  let mut leftoverSize: usize = 0
  let mut chunk: usize = 0
  // The input can be very large (with worker jobs), so it is cut into chunks to enforce the
  // maximum distance and to correct the overflow of the indices.
  while chunk < nbChunks && unsafe rz(store, zopt.RSS_SIZE) < unsafe rz(store, zopt.RSS_CAPACITY) {
    let chunkOffset = chunk * MAX_CHUNK_SIZE
    let chunkStart = unsafe mem.addc(src, chunkOffset)
    let remaining = srcSize - chunkOffset
    let chunkSize = if remaining < MAX_CHUNK_SIZE { remaining } else { MAX_CHUNK_SIZE }
    let chunkEnd = unsafe mem.addc(chunkStart, chunkSize)
    let prevSize = unsafe rz(store, zopt.RSS_SIZE)
    // 1. Perform overflow correction if necessary.
    if cstate.windowNeedOverflowCorrection(&ls.window, chunkEnd) {
      let correction = cstate.windowCorrectOverflow(&mut ls.window, 0, maxDist, chunkStart)
      unsafe reduceTable(unsafe mem.nn(ls.hashTable), mem.shlz(1, params.hashLog), correction)
      // Invalidate dictionaries on overflow correction.
      ls.loadedDictEnd = 0
    }
    // 2. Enforce the maximum offset allowed (`ZSTD_window_enforceMaxDist`). An offset must be
    // valid at the end of its sequence, since a sequence can be split into two.
    let chunkEndIdx = mem.t32(mem.us(mem.addr(chunkEnd), mem.addr(ls.window.base)))
    if chunkEndIdx > mem.a32(maxDist, ls.loadedDictEnd) {
      let newLowLimit = mem.s32(chunkEndIdx, maxDist)
      if ls.window.lowLimit < newLowLimit { ls.window.lowLimit = newLowLimit }
      if ls.window.dictLimit < ls.window.lowLimit { ls.window.dictLimit = ls.window.lowLimit }
      ls.loadedDictEnd = 0
    }
    // 3. Generate the sequences for the chunk, and get the new leftover size.
    let newLeftoverSize = unsafe generateSequencesInternal(&mut ls, store, &params, chunkStart, chunkSize)
    if errors.isError(newLeftoverSize) { return newLeftoverSize }
    // 4. Add the leftover literals of the previous chunks to the first sequence of this one, or
    // keep them with this chunk if it has no sequence.
    if prevSize < unsafe rz(store, zopt.RSS_SIZE) {
      let seq = unsafe storeSeq(store)
      let at = mem.ua(usize.wrappingMultiply(prevSize, zopt.RAWSEQ_BYTES), 4)
      unsafe mem.w32(seq, at, mem.a32(unsafe mem.r32(unsafe mem.ro(seq), at), mem.t32(leftoverSize)))
      leftoverSize = newLeftoverSize
    } else {
      leftoverSize = mem.ua(leftoverSize, chunkSize)
    }
    chunk = chunk + 1
  }
  return 0
}

/// `ZSTD_ldm_skipSequences`: skips past `srcSize` bytes of the sequences of `store`. A match that
/// is cut to less than `minMatch` bytes becomes literals of the next sequence.
pub unsafe fn skipSequences(store: [*]mut u8, srcSize0: usize, minMatch: u32) -> () {
  let mut srcSize = srcSize0
  while srcSize > 0 && unsafe storePending(store) {
    let seq = unsafe storeSeq(store)
    let pos = unsafe rz(store, zopt.RSS_POS)
    let at = usize.wrappingMultiply(pos, zopt.RAWSEQ_BYTES)
    let litLength = unsafe mem.r32(unsafe mem.ro(seq), mem.ua(at, 4))
    let matchLength = unsafe mem.r32(unsafe mem.ro(seq), mem.ua(at, 8))
    if srcSize <= mem.z(litLength) {
      // Skip past `srcSize` literals.
      unsafe mem.w32(seq, mem.ua(at, 4), mem.s32(litLength, mem.t32(srcSize)))
      return
    }
    srcSize = srcSize - mem.z(litLength)
    unsafe mem.w32(seq, mem.ua(at, 4), 0)
    if srcSize < mem.z(matchLength) {
      // Skip past the first `srcSize` bytes of the match.
      let rest = mem.s32(matchLength, mem.t32(srcSize))
      unsafe mem.w32(seq, mem.ua(at, 8), rest)
      if rest < minMatch {
        // The match is too short: omit it.
        if pos + 1 < unsafe rz(store, zopt.RSS_SIZE) {
          let next = mem.ua(at, zopt.RAWSEQ_BYTES + 4)
          unsafe mem.w32(seq, next, mem.a32(unsafe mem.r32(unsafe mem.ro(seq), next), rest))
        }
        unsafe wz(store, zopt.RSS_POS, pos + 1)
      }
      return
    }
    srcSize = srcSize - mem.z(matchLength)
    unsafe mem.w32(seq, mem.ua(at, 8), 0)
    unsafe wz(store, zopt.RSS_POS, pos + 1)
  }
}

// `maybeSplitSequence`: the next sequence of the store, cut to the `remaining` bytes of the
// block. An offset of 0 means that the rest of the block is literals.
unsafe fn maybeSplitSequence(store: [*]mut u8, remaining: u32, minMatch: u32) -> RawSeq {
  let seq = unsafe mem.ro(unsafe storeSeq(store))
  let pos = unsafe rz(store, zopt.RSS_POS)
  let at = usize.wrappingMultiply(pos, zopt.RAWSEQ_BYTES)
  let mut sequence = RawSeq { offset: unsafe mem.r32(seq, at), litLength: unsafe mem.r32(seq, mem.ua(at, 4)), matchLength: unsafe mem.r32(seq, mem.ua(at, 8)) }
  // Likely: no partial sequence.
  if remaining >= mem.a32(sequence.litLength, sequence.matchLength) {
    unsafe wz(store, zopt.RSS_POS, pos + 1)
    return sequence
  }
  // Cut the sequence short.
  if remaining <= sequence.litLength {
    sequence.offset = 0
  } else if remaining < mem.a32(sequence.litLength, sequence.matchLength) {
    sequence.matchLength = remaining - sequence.litLength
    if sequence.matchLength < minMatch { sequence.offset = 0 }
  }
  // Skip past `remaining` bytes for the future sequences.
  unsafe skipSequences(store, mem.z(remaining), minMatch)
  return sequence
}

/// `ZSTD_ldm_skipRawSeqStoreBytes`: moves forward in the store by `nbBytes`, with
/// `posInSequence` (the way of the optimal parser, which does not change the sequences).
pub unsafe fn skipRawSeqStoreBytes(store: [*]mut u8, nbBytes: usize) -> () {
  let mut currPos = mem.t32(mem.ua(unsafe rz(store, zopt.RSS_POS_IN_SEQUENCE), nbBytes))
  while currPos != 0 && unsafe storePending(store) {
    let seq = unsafe mem.ro(unsafe storeSeq(store))
    let pos = unsafe rz(store, zopt.RSS_POS)
    let at = usize.wrappingMultiply(pos, zopt.RAWSEQ_BYTES)
    let total = mem.a32(unsafe mem.r32(seq, mem.ua(at, 4)), unsafe mem.r32(seq, mem.ua(at, 8)))
    if currPos >= total {
      currPos = currPos - total
      unsafe wz(store, zopt.RSS_POS, pos + 1)
    } else {
      unsafe wz(store, zopt.RSS_POS_IN_SEQUENCE, mem.z(currPos))
      break
    }
  }
  if currPos == 0 || !unsafe storePending(store) { unsafe wz(store, zopt.RSS_POS_IN_SEQUENCE, 0) }
}

// `ZSTD_ldm_limitTableUpdate`: after a long match, the tables are only updated for the last
// positions before `anchor`.
fn limitTableUpdate(ms: &mut MatchState, anchor: [*]const u8) -> () {
  let curr = mem.t32(mem.us(mem.addr(anchor), mem.addr(ms.window.base)))
  if curr > mem.a32(ms.nextToUpdate, 1024) {
    let gap = mem.s32(mem.s32(curr, ms.nextToUpdate), 1024)
    ms.nextToUpdate = mem.s32(curr, if gap < 512 { gap } else { 512 })
  }
}

// `ZSTD_ldm_fillFastTables`: fills the tables of `fast` and `dfast` up to `end`. The other
// strategies fill theirs in their block compressors.
unsafe fn fillFastTables(ms: &mut MatchState, end: [*]const u8) -> () {
  // The reference compares `ip + 2` with the pointer `end - HASH_READ_SIZE`, which is below
  // the base of the window when `end` is within 8 bytes of it: nothing to insert then. The
  // ports of the two fill functions compute that bound as an index, which would wrap.
  if mem.us(mem.addr(end), mem.addr(ms.window.base)) < cstate.HASH_READ_SIZE { return }
  if ms.cParams.strategy == cparams.FAST {
    unsafe zfast.fillHashTable(&mut ms, end, zfast.DTLM_FAST)
  } else if ms.cParams.strategy == cparams.DFAST {
    unsafe zdfast.fillDoubleHashTable(&mut ms, end, zfast.DTLM_FAST)
  }
}

/// `ZSTD_ldm_blockCompress`: compresses the block `src[0..srcSize]` with the sequences of
/// `store`, and returns the size of the last literals. Below `btopt` each long distance match
/// is stored as it is and the block compressor runs on the literals between them; from `btopt`
/// the optimal parser reads the store through `ms.ldmSeqStore`.
pub unsafe fn blockCompress(store: [*]mut u8, ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, useRowMatchFinder: u32, src: [*]const u8, srcSize: usize) -> usize {
  let strategy = ms.cParams.strategy
  let minMatch = ms.cParams.minMatch
  let dictMode = cstate.dictMode(&ms)
  // The optimal parser uses the long distance matches as candidates only.
  if strategy >= cparams.BTOPT {
    ms.ldmSeqStore = mem.opt(store)
    let lastLLSize = unsafe cdispatch.compressBlock(strategy, useRowMatchFinder, dictMode, &mut ms, &mut seqStore, rep, src, srcSize)
    unsafe skipRawSeqStoreBytes(store, srcSize)
    return lastLLSize
  }
  let mut ip: usize = 0
  // Loop through each sequence and apply the block compressor to the literals.
  while unsafe storePending(store) && ip < srcSize {
    // `maybeSplitSequence` updates the position of the store.
    let sequence = unsafe maybeSplitSequence(store, mem.t32(srcSize - ip), minMatch)
    // End signal.
    if sequence.offset == 0 { break }
    // Fill the tables for the block compressor.
    let here = unsafe mem.addc(src, ip)
    limitTableUpdate(&mut ms, here)
    unsafe fillFastTables(&mut ms, here)
    // Run the block compressor.
    let newLitLength = unsafe cdispatch.compressBlock(strategy, useRowMatchFinder, dictMode, &mut ms, &mut seqStore, rep, here, mem.z(sequence.litLength))
    ip = ip + mem.z(sequence.litLength)
    // Update the repeat offsets.
    unsafe mem.w32(rep, 8, unsafe mem.r32(unsafe mem.ro(rep), 4))
    unsafe mem.w32(rep, 4, unsafe mem.r32(unsafe mem.ro(rep), 0))
    unsafe mem.w32(rep, 0, sequence.offset)
    // Store the sequence.
    unsafe cstate.storeSeq(&mut seqStore, newLitLength, src, ip - newLitLength, srcSize, cstate.offsetToOffBase(sequence.offset), mem.z(sequence.matchLength))
    ip = ip + mem.z(sequence.matchLength)
  }
  // Fill the tables for the block compressor, and compress the last literals.
  let here = unsafe mem.addc(src, ip)
  limitTableUpdate(&mut ms, here)
  unsafe fillFastTables(&mut ms, here)
  return unsafe cdispatch.compressBlock(strategy, useRowMatchFinder, dictMode, &mut ms, &mut seqStore, rep, here, srcSize - ip)
}

// ---- The hooks of `ZSTD_buildSeqStore` (`cctx.buildSeqStore`). ----

/// Whether the block compressor of the context goes through [`compressBlock`]: the context has
/// external sequences left (the long distance matches of a worker job), or long distance
/// matching is on.
pub unsafe fn isActive(c: &CCtx) -> bool {
  return unsafe storePending(c.externSeqStore) || c.appliedParams.ldmParams.enableLdm == cparams.PS_ENABLE
}

/// The part of `ZSTD_buildSeqStore` for a block of `srcSize` bytes that is too small to be
/// compressed: skips its bytes in the external sequences.
pub unsafe fn skipBlock(c: &mut CCtx, srcSize: usize) -> () {
  if c.appliedParams.cParams.strategy >= cparams.BTOPT {
    unsafe skipRawSeqStoreBytes(c.externSeqStore, srcSize)
  } else {
    unsafe skipSequences(c.externSeqStore, srcSize, c.appliedParams.cParams.minMatch)
  }
}

/// The part of `ZSTD_buildSeqStore` that selects and stores the sequences of the block
/// `src[0..srcSize]` when [`isActive`]: with the external sequences of the context if it has
/// some left, else with the long distance matches of the block, which it generates. Returns
/// the size of the last literals, or an error.
pub unsafe fn compressBlock(c: &mut CCtx, src: [*]const u8, srcSize: usize) -> usize {
  let rep = unsafe mem.add(c.nextCBlock, cstate.CBS_REP)
  let useRowMatchFinder = c.appliedParams.useRowMatchFinder
  if unsafe storePending(c.externSeqStore) {
    let store = c.externSeqStore
    return unsafe blockCompress(store, &mut c.matchState, &mut c.seqStore, rep, useRowMatchFinder, src, srcSize)
  }
  let mut storeBytes: [u8; 40] = [0; 40]
  let store = unsafe mem.nn(Pointer.fromMutSlice<u8>(&mut storeBytes))
  unsafe storeInit(store, c.ldmSequences, 0, c.maxNbLdmSequences)
  let ldmParams = c.appliedParams.ldmParams
  let e = unsafe generateSequences(&mut c.ldmState, store, &ldmParams, src, srcSize)
  if errors.isError(e) { return e }
  let lastLLSize = unsafe blockCompress(store, &mut c.matchState, &mut c.seqStore, rep, useRowMatchFinder, src, srcSize)
  // The store is a local: the match state does not keep a pointer to it.
  c.matchState.ldmSeqStore = mem.nullp()
  return lastLLSize
}
