        if !coldSlow { run self.a.jmp(done) }
      }
      if coldSlow {
        let mut shape: u32 = 0
        if step != 0 {
          let after = self.depthAfter(&function, inst, step)
          shape = leaving.stepShape(0, 0, 0, after)
        }
        let mut closure = NONE
        if inst.frame != 0 { closure = self.inlineClosures.get(u32.toUsize(inst.frame - 1)) }
        run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: done, inst: inst, step: step, shape: shape, out: closure, extra: 0, kind: STEP_PUT_FIELD_SLOW })
        self.a.bind(done)
        return ()
      }
      self.a.bind(slow)
      // A live borrowed field may alias the displaced value. In that case the helper
      // must return to the interpreter before removing its last reference.
      run self.frameInto(Reg.Rsi)
      if inst.k == 0 { run self.a.movImm32(Reg.Rdx, inst.pc) }
      else { run self.a.movImm64(Reg.Rdx, u64.bitOr(u32.toU64(inst.pc), helpers.PUT_FIELD_RELEASE_LAST)) }
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.R8, slotOf(inst.b))
      if self.on { run self.keepXmm() }
      run self.callHelper(helpers.PUT_FIELD)
      if self.on { run self.restoreXmm() }
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 1)
      run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
      self.a.bind(done)
      return ()
    }
    if op == Op.NewObject {
      run self.stressGuard(inst.exit)
      let layout = self.settings.layout
      let c = self.construct
      let miss = self.exitLabels.get(u32.toUsize(inst.exit))
      let retry = run self.a.label()
      let pass = run self.a.label()
      let status = run self.a.label()
      let general = run self.a.label()
      let pollSlow = run self.a.label()
      let done = run self.a.label()
      let sym = self.constructSymbol(&function, i32.wrappingToU32(inst.k))
      // The descriptor is checked here (constructChecks) and the helper only allocates; an
      // epoch change takes the helper that revalidates too. A poll comes back to retry.
      self.a.bind(retry)
      run self.unlessTag(inst.a, layout.object(), miss)
      run self.payloadInto(Reg.R8, inst.a)
      run self.a.movSymbol(Reg.R11, sym)
      run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(c.descCtor)))
      run self.a.alu(Alu.Cmp, Width.W64, Reg.R8, Reg.R9)
      run self.a.jcc(Cond.NotEqual, miss)
