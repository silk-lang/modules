//! libuv 1.51's stream, TCP, pipe, TTY and UDP functions for Node-API addons, in Silk, as C symbols
//! with libuv's names, ABI and record layouts (and 1.52's `uv_tcp_keepalive_ex` and
//! `uv_udp_open_ex`). The behavior follows libuv's src/unix/stream.c, tcp.c, pipe.c, tty.c and
//! udp.c step for step; the comments name the libuv function each part stands for.
//!
//! An addon allocates `uv_tcp_t`, `uv_pipe_t`, `uv_tty_t`, `uv_udp_t` and the requests itself. A
//! record keeps the 96-byte head of ext.uv_api_abi: its inner handle is a descriptor handle of the
//! loop (`ext.uv_loop.ioInit`), which holds the descriptor, its watch and the handle's activity and
//! reference, so that the loop facade's uv_fileno, uv_ref, uv_is_active and uv_is_closing work
//! through it. The head's flags word (offset 88) holds libuv's UV_HANDLE_* flags of the stream
//! or UDP handle, with libuv's values (a libuv test reads UV_HANDLE_BLOCKING_WRITES there).
//!
//! Past the head, the public fields addons may read are kept where libuv's headers put them:
//! `uv_stream_t.write_queue_size` (96), `alloc_cb` (104), `read_cb` (112), `uv_pipe_t.ipc` (248, 264
//! on Darwin), `uv_udp_t.send_queue_size` (96) and `send_queue_count` (104). The rest of each
//! record is libuv's private space, which this module uses for its own fields (offsets below, the
//! same on both targets). Requests keep libuv's layout, private fields included.
//!
//! Callbacks run only inside uv_run, on the loop's thread, as in libuv: write, shutdown and connect
//! errors are deferred to the loop's pending phase (libuv's uv__io_feed) through a pending node in
//! each record. uv_close for these types is the loop facade's: it calls `streamClose` (libuv's
//! uv__stream_close, uv__pipe_close, uv__tty_close, uv__udp_close), then ext.uv_api_abi's
//! closeRecord; the record's `finish` hook runs libuv's uv__stream_destroy or
//! uv__udp_finish_close in the closing phase, before the close callback.
//!
//! Known differences from libuv:
//! - macOS's select() thread for descriptors kqueue refuses (uv__stream_try_select, in uv_tty_init
//!   and uv_pipe_open) is ext.uv_loop's ioSelectIfRefused; the stream keeps its own descriptor
//!   rather than a socket pair's end in the watcher, so uv_fileno reports the real one, as libuv's
//!   uv__stream_fd does.
//! - The descriptor kept for the EMFILE trick is one per process, not one per loop, and is never
//!   closed (libuv closes it in uv_loop_close).
//! - `uv__fd_exists` asks the loop whether a started handle watches the descriptor.
//! - UV_HANDLE_ACTIVE and UV_HANDLE_REF are the inner handle's, not bits of uv_handle_t.flags.
//! - On macOS, a write-side EOF from kqueue reaches the stream as an error condition, so a reading
//!   stream may try one read more than libuv would.
//! - 1.52's uv_udp_open_ex and uv_tcp_keepalive_ex follow 1.52's interface without its source,
//!   which was not at hand: uv_udp_open_ex is uv_udp_open with UV_UDP_REUSEADDR and
//!   UV_UDP_REUSEPORT applied only as `flags` ask (uv_udp_open is UV_UDP_REUSEADDR).
//! - uv_udp_send also sets the public `cb` field, which libuv's Unix code leaves untouched.
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.core.ownership { Copy }
import silk.concurrency.atomic { Atomic, MemoryOrder, CompareExchange }
import silk.num.i32
import silk.num.isize
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import ext.uv_loop as uvl
import ext.uv_api_abi as abi
import ext.uv_inet as inet
import silkjsruntime.ext.process_abi { Message, Iovec, sendmsg, recvmsg }

// ---- C callbacks --------------------------------------------------------------------------------
type Close = ?extern "C" fn(*mut u8) -> ()
type StatusFn = extern "C" fn(*mut u8, i32) -> ()
type Status = ?extern "C" fn(*mut u8, i32) -> ()
type AllocFn = extern "C" fn(*mut u8, usize, *mut Buf) -> ()
type Alloc = ?extern "C" fn(*mut u8, usize, *mut Buf) -> ()
type ReadFn = extern "C" fn(*mut u8, isize, *const Buf) -> ()
type Read = ?extern "C" fn(*mut u8, isize, *const Buf) -> ()
type RecvFn = extern "C" fn(*mut u8, isize, *const Buf, ?*const u8, u32) -> ()
type Recv = ?extern "C" fn(*mut u8, isize, *const Buf, ?*const u8, u32) -> ()

/// libuv's uv_buf_t (base, len), which is also struct iovec on both targets.
pub extern "C" struct Buf { pub base: ?*mut u8, pub len: usize }
impl Copy for Buf {}

// ---- The C library ------------------------------------------------------------------------------
unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
unsafe extern "C" fn realloc(pointer: ?*mut u8, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
@foreign(noCapture: .("dest", "source"))
unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, count: usize) -> *mut u8
unsafe extern "C" fn memmove(dest: *mut u8, source: *const u8, count: usize) -> *mut u8
unsafe extern "C" fn memset(dest: *mut u8, value: i32, count: usize) -> *mut u8
unsafe extern "C" fn memchr(source: *const u8, value: i32, count: usize) -> ?*mut u8
@foreign(noCapture: .("text"))
unsafe extern "C" fn strlen(text: *const u8) -> usize
unsafe extern "C" fn dprintf(fd: i32, format: *const u8, ...) -> i32
@foreign(noCapture: .("buffer"))
unsafe extern "C" fn read(fd: i32, buffer: *mut u8, count: usize) -> isize
@foreign(noCapture: .("buffer"))
unsafe extern "C" fn write(fd: i32, buffer: *const u8, count: usize) -> isize
unsafe extern "C" fn writev(fd: i32, vectors: *const Buf, count: i32) -> isize
unsafe extern "C" fn close(fd: i32) -> i32
unsafe extern "C" fn fcntl(fd: i32, command: i32, ...) -> i32
unsafe extern "C" fn ioctl(fd: i32, request: u64, ...) -> i32
unsafe extern "C" fn open(path: *const u8, flags: i32, ...) -> i32
unsafe extern "C" fn dup2(from: i32, to: i32) -> i32
