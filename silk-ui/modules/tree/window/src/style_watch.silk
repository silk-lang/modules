//! Development updates of compiled application sheets. The build task publishes
//! a complete bundle atomically; this reader never compiles CSS text.
import ui_tree.legacy { UiTree, TreeError }
import ui_tree.style_assets { StyleAssets }
import ui_protocol.style_bundle { DecodeError, MAX_BYTES, same }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.system.filesystem { FileSystem, FileError, FileInfo, Path }
import browser

pub struct SheetWatch {
  path: Option<Path>,
  seen: Bytes,
  next: f64,
}

impl SheetWatch {
  pub fn make() -> SheetWatch {
    return SheetWatch { path: Option<Path>.None, seen: Bytes.make(), next: 0.0 }
  }

  pub effect fn from(path: string) -> SheetWatch ! FileError | OutOfMemoryError ? &mut Allocator {
    if path == "" { return SheetWatch.make() }
    return SheetWatch { path: Option<Path>.Some { value: run Path.make(path) }, seen: Bytes.make(), next: 0.0 }
  }

  pub fn active(self: &Self) -> bool { return self.path.isSome() }

  pub fn wakeAfter(self: &Self, wanted: Option<f64>) -> Option<f64> {
    if !self.active() { return wanted }
    return match wanted {
      Option<f64>.Some { value } => Option<f64>.some(f64.min(value, 0.25))
      Option<f64>.None => Option<f64>.some(0.25)
    }
  }

  /// Provider-based operation used by the host and by filesystem integration tests.
  /// Invalid bytes are remembered, so the host reports them once and retries when
  /// the file changes. An unreadable file leaves both the active sheets and seen bytes.
  pub effect fn pollWith(self: &mut Self, assets: &mut StyleAssets, tree: &mut UiTree<'_>, time: f64) -> bool
    ! FileError | DecodeError | TreeError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
    if time < self.next || !self.active() { return false }
    self.next = time + 0.25
    let path = match &self.path {
      Option<Path>.Some { value } => &value
      Option<Path>.None => { return false }
    }
    let size = match run FileSystem.stat(path) {
      FileInfo value => value.byteLength
      _ => { return false }
    }
    if size > MAX_BYTES { return false }
    let bytes = run FileSystem.readFile(path)
    return run self.received(&mut assets, &mut tree, move bytes)
  }

  pub effect fn poll(self: &mut Self, assets: &mut StyleAssets, tree: &mut UiTree<'_>, time: f64) -> bool
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    static if Intrinsic.targetArchitecture() == "wasm32" {
      if !self.active() || time < self.next { return false }
      self.next = time + 0.25
      if let Option<Bytes>.Some { value } = move run browser.stylesheetUpdate() {
        return run Effect.catch<DecodeError>(self.received(&mut assets, &mut tree, move value), invalidBrowserUpdate)
      }
      return false
    } else {
      if !self.active() || time < self.next { return false }
      let mut files = run MachineFileSystem.make()
      return run Effect.catch<FileError | DecodeError>(self.pollWith(&mut assets, &mut tree, time), unchanged)
        |> Effect.provideMut<FileSystem>(&mut files)
    }
  }

  effect fn received(self: &mut Self, assets: &mut StyleAssets, tree: &mut UiTree<'_>, bytes: Bytes) -> bool
    ! DecodeError | TreeError | OutOfMemoryError ? &mut Allocator {
    if same(bytes.asSlice(), self.seen.asSlice()) { return false }
    self.seen = move bytes
    if !(run assets.replaceBundle(self.seen.asSlice())) { return false }
    return run assets.serveInstalled(&mut tree)
  }
}

static if Intrinsic.targetArchitecture() == "wasm32" {
  effect fn invalidBrowserUpdate(error: DecodeError) -> bool {
    drop error
    return false
  }
}

static if Intrinsic.targetArchitecture() != "wasm32" {
  import silk.system.filesystem_machine { MachineFileSystem }
  import console { StderrWriter }
  effect fn unchanged(error: FileError | DecodeError) -> bool {
    match move error {
      DecodeError invalid => {
        drop invalid
        StderrWriter.print("silkui: ignored an invalid compiled stylesheet update\n", &())
      }
      FileError unavailable => { drop unavailable }
    }
    return false
  }
}
