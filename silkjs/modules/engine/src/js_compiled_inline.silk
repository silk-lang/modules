//! What an embedder's compiler asks the engine in order to inline a call (docs/jit/inlining.md):
//! which function a call site would call right now, read from state the interpreter already
//! keeps, and a place to keep such a function alive while code that names it exists. Nothing
//! here runs JavaScript or fails; a null answer means "do not inline".
import silk.mem.pointer { Pointer }
import silk.num.u32
import silk.num.u64
import silk.num.usize
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import silk.core.option { Option }
import js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, ShapeData, FunctionBytecode, FunctionKind, VarRef, VarRefState, FIELD_PROTO_KEY, FIELD_PASS_THROUGH, fieldCacheIndex, SiteShapes, SITE_SHAPES, siteShapeAt, JS_PROP_TMASK }
import js_native_functions { OBJECT_METHOD_PUSH, OBJECT_METHOD_POP }
import silk.num.u8
import js_gc { HeapHooks }
import js_gc as gc
import js_shapes as shapes
import js_class_data as classes
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import js_atoms { AtomTable }

/// The FunctionBytecode cell of the bytecode closure that the get_field2 at offset pc of
/// bytecode last read from a prototype (its site cache entry, still current), or null: the
/// method a call_method after it would call. A snapshot, to be guarded where it is used.
pub unsafe fn methodTarget(runtime: *mut HeapHeader, bytecode: *mut HeapHeader, pc: u32, closure: &mut ?*mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let site = Pointer.address<u8>(unsafe code.code.start()) + u32.toUsize(pc) + 1
  let realm = code.realm
  drop code
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let entry = &state.fieldCache[fieldCacheIndex(site)]
  if entry.site != site { return Pointer.null<HeapHeader>() }
  if u64.bitAnd(entry.key, FIELD_PROTO_KEY) == 0 { return Pointer.null<HeapHeader>() }
  if entry.epoch != state.shapeEpoch { return Pointer.null<HeapHeader>() }
  let holder = match Pointer.nonNullMut<HeapHeader>(entry.holder) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() } }
  let index = entry.holderIndex
  drop state
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, holder)
  let found = (unsafe object.slotUnchecked(index)).valueBits()
  drop object
  let target = match Pointer.nonNullMut<HeapHeader>(unsafe closureBytecode(found)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() } }
  // An inlined body runs for the caller's realm.
  if Pointer.address<HeapHeader>((unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, target)).realm) != Pointer.address<HeapHeader>(realm) { return Pointer.null<HeapHeader>() }
  closure.* = closureObject(found)
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(target)
}
/// The plain bytecode functions the `get_field2` at pc of bytecode read from prototypes, one
/// for each shape its site cache was filled for (SiteShapes), into targets without
/// repeats, and how many: what a call_method after it called. 0 when the site read from
/// more than SITE_SHAPES shapes or nothing is recorded of it; `partial` is set when some
/// shape's method is not known (an own property, a prototype that changed since, another
/// realm's function). Snapshots, to be guarded where they are used.
pub unsafe fn methodTargets(runtime: *mut HeapHeader, bytecode: *mut HeapHeader, pc: u32, targets: &mut [?*mut HeapHeader; 4], closures: &mut [?*mut HeapHeader; 4], partial: &mut bool) -> u32 {
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let site = Pointer.address<u8>(unsafe code.code.start()) + u32.toUsize(pc) + 1
  let realm = code.realm
  drop code
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let epoch = state.shapeEpoch
  let table = match Pointer.nonNullMut<SiteShapes>(state.compiled.siteShapes) { Option<*mut SiteShapes>.Some { value } => value Option<*mut SiteShapes>.None => { return 0 } }
  let at = unsafe siteShapeAt(table, state.compiled.siteShapeMask, site)
  drop state
  if at == usize.MAX { return 0 }
  let entry = unsafe Pointer.read<SiteShapes>(unsafe Pointer.atMut<SiteShapes>(unsafe Pointer.assumeManyMut<SiteShapes>(table), at))
  if entry.seen > SITE_SHAPES { return 0 }
  let mut count: u32 = 0
  let mut i: usize = 0
  while i < entry.seen {
    let mut found = Pointer.null<HeapHeader>()
    let mut closure = Pointer.null<HeapHeader>()
    // The epoch is the one the entry was filled at: no prototype changed or died since, so
    // the holder is the object it was and the slot is where the property is.
    if u64.bitAnd(entry.keys[i], FIELD_PROTO_KEY) != 0 && u64.shiftRight(entry.keys[i], 62) != 3 && entry.epochs[i] == epoch
      && u64.bitAnd(entry.protoKeys[i], 65535) != FIELD_PASS_THROUGH {
      if let Option<*mut HeapHeader>.Some { value: holder } = Pointer.nonNullMut<HeapHeader>(entry.holders[i]) {
        let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, holder)
        let value = (unsafe object.slotUnchecked(u64.toUsize(u64.bitAnd(entry.protoKeys[i], 65535)))).valueBits()
        drop object
        if let Option<*mut HeapHeader>.Some { value: target } = Pointer.nonNullMut<HeapHeader>(unsafe closureBytecode(value)) {
          if Pointer.address<HeapHeader>((unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, target)).realm) == Pointer.address<HeapHeader>(realm) {
            found = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(target)
            closure = closureObject(value)
          }
        }
      }
    }
    match Pointer.nonNullMut<HeapHeader>(found) {
      Option<*mut HeapHeader>.Some { value: target } => {
        let mut known = false
        let mut n: usize = 0
        while n < u32.toUsize(count) {
          if Pointer.address<HeapHeader>(targets[n]) == Pointer.address<HeapHeader>(target) {
            known = true
            // Two closures of one function: the function is the target, neither closure is.
            if Pointer.address<HeapHeader>(closures[n]) != Pointer.address<HeapHeader>(closure) { closures[n] = Pointer.null<HeapHeader>() }
          }
          n = n + 1
        }
        if !known { targets[u32.toUsize(count)] = found closures[u32.toUsize(count)] = closure count = count + 1 }
      }
      Option<*mut HeapHeader>.None => { partial.* = true }
    }
    i = i + 1
  }
  return count
}
/// Whether target, a FunctionBytecode cell a call of caller's was recorded calling
/// (js_feedback), is one a compiler may inline there: a plain function of caller's realm.
pub unsafe fn plainTarget(target: *mut HeapHeader, caller: *mut HeapHeader) -> bool {
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, target)
  if code.kind != FunctionKind.Normal { return false }
  return Pointer.address<HeapHeader>(code.realm) == Pointer.address<HeapHeader>((unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, caller)).realm)
}
/// Why methodTarget finds none for the `get_field2` at pc (for a compiler's dump): 0 it finds
/// one, 1 the cache entry is another site's, 2 it is not a prototype hit, 3 its epoch is
/// stale, 4 no holder, 5 the slot holds no plain bytecode closure, 6 another realm's.
pub unsafe fn methodMiss(runtime: *mut HeapHeader, bytecode: *mut HeapHeader, pc: u32) -> u32 {
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let site = Pointer.address<u8>(unsafe code.code.start()) + u32.toUsize(pc) + 1
  let realm = code.realm
  drop code
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let entry = &state.fieldCache[fieldCacheIndex(site)]
  if entry.site != site { return 1 }
  if u64.bitAnd(entry.key, FIELD_PROTO_KEY) == 0 { return 2 }
  if entry.epoch != state.shapeEpoch { return 3 }
  let holder = match Pointer.nonNullMut<HeapHeader>(entry.holder) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return 4 } }
  let index = entry.holderIndex
  drop state
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, holder)
  let found = (unsafe object.slotUnchecked(index)).valueBits()
  drop object
  let target = match Pointer.nonNullMut<HeapHeader>(unsafe closureBytecode(found)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return 5 } }
  if Pointer.address<HeapHeader>((unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, target)).realm) != Pointer.address<HeapHeader>(realm) { return 6 }
  return 0
}
/// The FunctionBytecode cell of value when it is a bytecode closure of a plain function, or null.
pub unsafe fn closureBytecode(value: ValueBits) -> ?*mut HeapHeader {
  let reference = match value { ValueBits.Object { reference } => reference _ => { return Pointer.null<HeapHeader>() } }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  let bytecode = match &data.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { return Pointer.null<HeapHeader>() } }
  drop data
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  if code.kind != FunctionKind.Normal { return Pointer.null<HeapHeader>() }
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(bytecode)
}
/// The object of value when it is one, or null.
pub fn closureObject(value: ValueBits) -> ?*mut HeapHeader {
  return match value { ValueBits.Object { reference } => unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(reference) _ => Pointer.null<HeapHeader>() }
}
/// The address of variable cell `index` of the bytecode closure `closure` when that cell owns
/// an initialized value, or 0. Such a cell owns one from then on (a cell never goes back to
/// a frame, and a binding is initialized once), at the same address while the closure lives:
/// code that keeps the closure (keepClosure) may read the cell without a test.
pub unsafe fn ownedCell(closure: *mut HeapHeader, index: u32) -> usize {
  return match Pointer.nonNullMut<HeapHeader>(unsafe initializedCell(closure, index)) {
    Option<*mut HeapHeader>.Some { value } => Pointer.address<HeapHeader>(value)
    Option<*mut HeapHeader>.None => 0
  }
}
/// Variable cell `index` of closure when it is detached and initialized (ownedCell), or null.
unsafe fn initializedCell(closure: *mut HeapHeader, index: u32) -> ?*mut HeapHeader {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, closure)
  let mut cell = Pointer.null<HeapHeader>()
  match &data.payload {
    ObjectPayload.BytecodeFunction { function } => { if u32.toUsize(index) < function.varRefs.length() { cell = function.varRefs.get(u32.toUsize(index)) } }
    _ => ()
  }
  drop data
  let found = match Pointer.nonNullMut<HeapHeader>(cell) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() } }
  let binding = unsafe HeapCell.payload<VarRef, ()>(&anchor, found)
  return match binding.state {
    VarRefState.Detached { value } => match value { ValueBits.Uninitialized => Pointer.null<HeapHeader>() _ => cell }
    _ => Pointer.null<HeapHeader>()
  }
}
/// The first byte of bytecode's code: what CompiledFrame.code holds for it.
pub unsafe fn codeStart(bytecode: *mut HeapHeader) -> *const u8 {
  let anchor = ()
  return unsafe (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)).code.start()
}
/// Lends the runtime capacity cells where keep stores what compiled code names by address
/// (inline targets); destroyRuntime releases them. Null and 0 take the storage back.
pub unsafe fn setKept(runtime: *mut HeapHeader, storage: ?*mut ValueBits, capacity: usize) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  state.compiled.kept = storage state.compiled.keptCapacity = capacity state.compiled.keptCount = 0
}
/// Retains bytecode, a FunctionBytecode cell, until the runtime is destroyed, so its address
/// keeps naming it. False, with nothing kept, when the storage is full.
pub unsafe fn keep(runtime: *mut HeapHeader, bytecode: *mut HeapHeader) -> bool {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let count = state.compiled.keptCount
  if count >= state.compiled.keptCapacity { return false }
  let cells = unsafe Pointer.assumeManyMut<ValueBits>(unsafe Intrinsic.pointerRequalify<?*mut ValueBits, *mut ValueBits>(state.compiled.kept))
  state.compiled.keptCount = count + 1
  drop state
  unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(cells, count), unsafe (ValueBits.FunctionBytecode { reference: bytecode }).retained())
  return true
}
/// keep for a closure object that compiled code tests a callee against by address.
pub unsafe fn keepClosure(runtime: *mut HeapHeader, closure: *mut HeapHeader) -> bool {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let count = state.compiled.keptCount
  if count >= state.compiled.keptCapacity { return false }
  let cells = unsafe Pointer.assumeManyMut<ValueBits>(unsafe Intrinsic.pointerRequalify<?*mut ValueBits, *mut ValueBits>(state.compiled.kept))
  state.compiled.keptCount = count + 1
  drop state
  unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(cells, count), unsafe (ValueBits.Object { reference: closure }).retained())
  return true
}
/// Starts watching holder, a prototype object (ObjectData.isWatched): from then on compiled
/// code may take what a slot of it holds now for what it holds, while the object's watched
/// bit is set. True when it is watched on return. False changes nothing: it is not a plain
/// object with plain data records that is marked as a prototype (a change of shape ends
/// the watch under that mark's test, shapes.noteShapeChange), it was watched before and a write ended that (store keys
/// may hold its version, and a second change of version would strand code compiled for the
/// first), nothing more can be kept, or memory ran out.
///
/// The holder gets a shape of its own with a new version (shapes.ownShape), so that no
/// store key filled before can prove a store to it, and the caches that name it as a
/// direct prototype by the old version are moved to the new one: the records are the same,
/// so what they say stays true.
///
/// Compiled code that is running may hold the old version as a proven fact
/// (ssa_shapes) and store to the holder without a test, which would not end the watch:
/// call this only where such facts are dead, which is inside a call the running code made
/// (the optimizer's compile at a function's entry), never from a poll.
pub unsafe effect fn watchHolder(runtime: *mut HeapHeader, holder: *mut HeapHeader) -> bool ? &mut Allocator {
  let mut anchor = ()
  let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, holder)
  if object.isWatched() { return true }
  if object.wasWatched() || !object.isPrototype() || object.isExotic() || object.classId() != classes.JS_CLASS_OBJECT || !unsafe shapes.plainRecords(object.shape) { return false }
  let shapeAnchor = ()
  let before = unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, object.shape)
  let old = before.version
  let hashed = before.isHashed
  drop before
  let roomAnchor = ()
  let room = unsafe HeapCell.payload<RuntimeState, ()>(&roomAnchor, runtime)
  if room.compiled.keptCount >= room.compiled.keptCapacity { return false }
  drop room
  match run Effect.result(unsafe shapes.ownShape(runtime, &mut object, hashed)) {
    Result<(), OutOfMemoryError>.Failure { .. } => { return false }
    Result<(), OutOfMemoryError>.Success { .. } => ()
  }
  let version = (unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, object.shape)).version
  object.watch()
  drop object
  let _kept = unsafe keepClosure(runtime, holder)
  // A version that does not fit the tests compiled code makes would only miss there.
  let mut stateAnchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, runtime)
  let mut i: usize = 0
  while i < 4096 {
    let entry = &mut state.fieldCache[i]
    // A version names one shape, so the keys of an entry that walks past the holder or
    // finds the property further up than it (midKey, farKey) move the same way.
    if u64.bitAnd(entry.key, FIELD_PROTO_KEY) != 0 && entry.site != 0 {
      if u64.shiftRight(entry.protoKey, 16) == old { entry.protoKey = u64.bitOr(u64.shiftLeft(version, 16), u64.bitAnd(entry.protoKey, 65535)) }
      if u64.shiftRight(entry.midKey, 16) == old { entry.midKey = u64.bitOr(u64.shiftLeft(version, 16), u64.bitAnd(entry.midKey, 65535)) }
      if u64.shiftRight(entry.farKey, 16) == old { entry.farKey = u64.bitOr(u64.shiftLeft(version, 16), u64.bitAnd(entry.farKey, 65535)) }
    }
    i = i + 1
  }
  if let Option<*mut SiteShapes>.Some { value: table } = Pointer.nonNullMut<SiteShapes>(state.compiled.siteShapes) {
    let entries = unsafe Pointer.assumeManyMut<SiteShapes>(table)
    let count = state.compiled.siteShapeMask + 1
    let mut n: usize = 0
    while n < count {
      let mut entryAnchor = ()
      let entry = unsafe Pointer.borrowMut<(), SiteShapes>(&mut entryAnchor, unsafe Pointer.atMut<SiteShapes>(entries, n))
      let mut pair: usize = 0
      while pair < SITE_SHAPES && pair < entry.seen {
        if Pointer.address<HeapHeader>(entry.holders[pair]) == Pointer.address<HeapHeader>(holder) && u64.shiftRight(entry.protoKeys[pair], 16) == old {
          entry.protoKeys[pair] = u64.bitOr(u64.shiftLeft(version, 16), u64.bitAnd(entry.protoKeys[pair], 65535))
        }
        pair = pair + 1
      }
      n = n + 1
    }
  }
  return true
}
/// A record's slot kinds (WatchedRecord.kinds): none (a slot compiled code does not take as
/// a constant), an int32, a boolean, null, undefined.
pub const RECORD_NONE: u8 = 0
pub const RECORD_INT: u8 = 1
pub const RECORD_BOOL: u8 = 2
pub const RECORD_NULL: u8 = 3
pub const RECORD_UNDEFINED: u8 = 4
/// The most slots a record has.
pub const RECORD_SLOTS: usize = 8
/// A watched record (cellRecord): the object, its shape's version before the watch began
/// (`before`; what the inline keys of reads filled earlier hold) and now, and each slot's
/// value as compiled code takes it.
pub struct WatchedRecord { pub object: ?*mut HeapHeader, pub before: u64, pub version: u64, pub count: usize, pub kinds: [u8; 8], pub values: [i32; 8] }
impl Copy for WatchedRecord {}
impl WatchedRecord {
  pub fn none() -> Self { return Self { object: Pointer.null<HeapHeader>(), before: 0, version: 0, count: 0, kinds: [0; 8], values: [0; 8] } }
}
/// The record in variable cell `index` of closure, watched. A record is an ordinary plain
/// object of at most RECORD_SLOTS data properties, each an int32, a boolean, null or
/// undefined, whose prototype is a plain object without one (`var Direction = new Object()`
/// with numbers in it): compiled code reads its slots as constants while the watch holds,
/// testing its shape (its own while watched, so it names the object) and its watched bit.
/// With `start` the watch begins here when it has not: the record takes the prototype role,
/// which only costs epoch bumps, so that every path that ends a prototype's watch ends its
/// own (js_shapes.noteShapeChange), and watchHolder gives it its own shape. The caller's
/// rules are watchHolder's. False when the cell holds no record or it is not watched.
pub unsafe effect fn cellRecord(runtime: *mut HeapHeader, closure: *mut HeapHeader, index: u32, start: bool, out: &mut WatchedRecord) -> bool ? &mut Allocator {
  let cell = match Pointer.nonNullMut<HeapHeader>(unsafe initializedCell(closure, index)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
  let mut anchor = ()
  let binding = unsafe HeapCell.payload<VarRef, ()>(&anchor, cell)
  let object = match binding.state {
    VarRefState.Detached { value } => match value { ValueBits.Object { reference } => reference _ => { return false } }
    _ => { return false }
  }
  drop binding
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  if data.classId() != classes.JS_CLASS_OBJECT || data.isExotic() || data.slotCount() == 0 || data.slotCount() > RECORD_SLOTS { return false }
  if !data.isWatched() && (!start || data.wasWatched() || data.isPrototype()) { return false }
  let shapeAnchor = ()
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, data.shape)
  let before = shape.version
  let parent = match Pointer.nonNullMut<HeapHeader>(shape.prototype) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
  drop shape
  let parentData = unsafe HeapCell.payload<ObjectData, ()>(&shapeAnchor, parent)
  if parentData.classId() != classes.JS_CLASS_OBJECT || !Pointer.isNull<HeapHeader>((unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, parentData.shape)).prototype) { return false }
  drop parentData
  let mut found = WatchedRecord.none()
  found.count = data.slotCount()
  let mut i: usize = 0
  while i < found.count {
    match (unsafe data.slotUnchecked(i)).valueBits() {
      ValueBits.Int { value } => { found.kinds[i] = RECORD_INT found.values[i] = value }
      ValueBits.Bool { value } => { found.kinds[i] = RECORD_BOOL if value { found.values[i] = 1 } }
      ValueBits.Null => { found.kinds[i] = RECORD_NULL }
      ValueBits.Undefined => { found.kinds[i] = RECORD_UNDEFINED }
      _ => { return false }
    }
    i = i + 1
  }
  if !data.isWatched() {
    if !unsafe shapes.plainRecords(data.shape) { return false }
    data.setIsPrototype(true)
    drop data
    if !run unsafe watchHolder(runtime, object) { return false }
  } else { drop data }
  let version = (unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, (unsafe HeapCell.payload<ObjectData, ()>(&shapeAnchor, object)).shape)).version
  found.object = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(object)
  found.before = before
  found.version = version
  out.* = move found
  return true
}
/// Whether the record cellRecord answered for as `version` still is watched, of that shape:
/// what it took as constants is still in its slots. The watch keeps the record
/// (watchHolder keeps it), so its address stays one.
pub unsafe fn recordHolds(object: *mut HeapHeader, version: u64) -> bool {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  if !data.isWatched() { return false }
  return (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).version == version
}
/// Pair `index` of the shapes the `get_field2` at pc of bytecode read by: its holder (a
/// prototype of the receivers), the slot there and the version of the receivers' shape;
/// `first` is null when the holder is the receivers' own prototype, and that prototype when
/// the holder is further up (SiteShapes.firsts); `count` is how many pairs the site has.
/// Null when the pair is none, an own property, or not current.
unsafe fn pairAt(runtime: *mut HeapHeader, bytecode: *mut HeapHeader, pc: u32, index: usize, slot: &mut usize, version: &mut u64, count: &mut usize, first: &mut ?*mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let site = Pointer.address<u8>(unsafe code.code.start()) + u32.toUsize(pc) + 1
  drop code
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let mut key: u64 = 0
  let mut protoKey: u64 = 0
  let mut holder = Pointer.null<HeapHeader>()
  let mut epoch: u64 = 0
  let mut found = false
  count.* = 0
  first.* = Pointer.null<HeapHeader>()
  if let Option<*mut SiteShapes>.Some { value: table } = Pointer.nonNullMut<SiteShapes>(state.compiled.siteShapes) {
    let at = unsafe siteShapeAt(table, state.compiled.siteShapeMask, site)
    if at != usize.MAX {
      let entry = unsafe Pointer.read<SiteShapes>(unsafe Pointer.atMut<SiteShapes>(unsafe Pointer.assumeManyMut<SiteShapes>(table), at))
      if entry.seen != 0 {
        // More shapes than the entry holds: nothing is told of the site.
        if entry.seen > SITE_SHAPES || index >= entry.seen { return Pointer.null<HeapHeader>() }
        count.* = entry.seen
        key = entry.keys[index] protoKey = entry.protoKeys[index] holder = entry.holders[index] epoch = entry.epochs[index]
        first.* = entry.firsts[index]
        found = true
      }
    }
  }
  if !found {
    let entry = &state.fieldCache[fieldCacheIndex(site)]
    if entry.site != site { return Pointer.null<HeapHeader>() }
    count.* = 1
    if index != 0 { return Pointer.null<HeapHeader>() }
    key = entry.key protoKey = entry.protoKey holder = entry.holder epoch = entry.epoch
  }
  // A site cache entry that passes through the prototype, or names no shape at all (a holder
  // further up than its keys reach), tells where the property is but not the way there.
  if u64.bitAnd(key, FIELD_PROTO_KEY) == 0 || u64.shiftRight(key, 62) == 3 || u64.bitAnd(protoKey, 65535) == FIELD_PASS_THROUGH || u64.shiftRight(protoKey, 16) == 0 || epoch != state.shapeEpoch {
    return Pointer.null<HeapHeader>()
  }
  slot.* = u64.toUsize(u64.bitAnd(protoKey, 65535))
  // The shape version of a key: above its low 16 bits, below its top one.
  version.* = u64.shiftRight(u64.shiftLeft(key, 1), 17)
  return holder
}
/// The most objects between a receiver and the prototype that holds a known method, the
/// holder among them (chainOf).
pub const KNOWN_CHAIN: usize = 3
/// The objects a read walks from a receiver to holder, in order: holder alone when first
/// is null (it is the receivers' own prototype), else first, the prototypes above it and
/// holder. How many, or 0 when holder is not reached within KNOWN_CHAIN.
unsafe fn chainOf(holder: *mut HeapHeader, first: ?*mut HeapHeader, chain: &mut [?*mut HeapHeader; 3]) -> usize {
  let mut current = match Pointer.nonNullMut<HeapHeader>(first) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { chain[0] = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(holder) return 1 }
  }
  let anchor = ()
  let mut n: usize = 0
  while n < KNOWN_CHAIN {
    chain[n] = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(current)
    n = n + 1
    if Pointer.address<HeapHeader>(current) == Pointer.address<HeapHeader>(holder) { return n }
    let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, current)
    let next = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)).prototype
    drop object
    current = match Pointer.nonNullMut<HeapHeader>(next) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return 0 } }
  }
  return 0
}
/// Watches the objects the `get_field2` at pc of bytecode reads through, for each shape it
/// saw that reads a slot of a prototype: that prototype and every one between it and the
/// receivers (watchHolder, chainOf). A compiler calls this for every site of the code it is
/// about to compile, before it asks what the sites read (siteShapes, methodTarget): a
/// watch changes the version of what it watches, which those answer.
pub unsafe effect fn watchSite(runtime: *mut HeapHeader, bytecode: *mut HeapHeader, pc: u32) -> () ? &mut Allocator {
  let mut index: usize = 0
  let mut count: usize = 1
  while index < count {
    let mut slot: usize = 0
    let mut version: u64 = 0
    let mut first = Pointer.null<HeapHeader>()
    if let Option<*mut HeapHeader>.Some { value: holder } = Pointer.nonNullMut<HeapHeader>(unsafe pairAt(runtime, bytecode, pc, index, &mut slot, &mut version, &mut count, &mut first)) {
      let mut chain: [?*mut HeapHeader; 3] = [Pointer.null<HeapHeader>(); 3]
      let length = unsafe chainOf(holder, first, &mut chain)
      let mut n: usize = 0
      while n < length {
        if let Option<*mut HeapHeader>.Some { value: object } = Pointer.nonNullMut<HeapHeader>(chain[n]) { let _watched = run unsafe watchHolder(runtime, object) }
        n = n + 1
      }
    }
    index = index + 1
  }
}
/// The shapes knownMethod answers for: the version of each (shapes), and the watched
/// objects a receiver of that shape reads the method through (chain, KNOWN_CHAIN entries a
/// shape, the first lengths[i] of them set: the receivers' prototype first, the holder last).
pub struct KnownMethod { pub count: usize, pub shapes: [u64; 4], pub lengths: [u8; 4], pub chain: [?*mut HeapHeader; 12] }
impl KnownMethod {
  pub fn none() -> Self { return Self { count: 0, shapes: [0, 0, 0, 0], lengths: [0, 0, 0, 0], chain: [Pointer.null<HeapHeader>(); 12] } }
}
/// The shapes for which the `get_field2` at pc of bytecode reads closure from a watched
/// prototype through watched ones. An object of such a shape that is not exotic reads
/// closure there while every object of its chain has its watched bit set: the shape fixes
/// the first as its prototype and has no record of the name; a change to the records or
/// the prototype of an object of the chain, or a write to a slot of it, clears its bit, and
/// none had the name but the holder when the site read through them (no prototype changed
/// since: the epoch the pair was recorded at is still the runtime's). The site may have
/// seen other shapes too: they read what they read.
pub unsafe fn knownMethod(runtime: *mut HeapHeader, bytecode: *mut HeapHeader, pc: u32, closure: *mut HeapHeader, known: &mut KnownMethod) -> () {
  known.count = 0
  let mut index: usize = 0
  let mut count: usize = 1
  while index < count && known.count < 4 {
    let mut slot: usize = 0
    let mut version: u64 = 0
    let mut first = Pointer.null<HeapHeader>()
    let found = unsafe pairAt(runtime, bytecode, pc, index, &mut slot, &mut version, &mut count, &mut first)
    index = index + 1
    let holder = match Pointer.nonNullMut<HeapHeader>(found) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { continue } }
    // A version the code compares as a 32-bit immediate.
    if version == 0 || version >= 2147483648 { continue }
    let anchor = ()
    let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, holder)
    if slot >= object.slotCount() { continue }
    let same = match (unsafe object.slotUnchecked(slot)).valueBits() {
      ValueBits.Object { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(closure)
      _ => false
    }
    drop object
    if !same { continue }
    let mut chain: [?*mut HeapHeader; 3] = [Pointer.null<HeapHeader>(); 3]
    let length = unsafe chainOf(holder, first, &mut chain)
    let mut watched = length != 0
    let mut n: usize = 0
    while n < length {
      match Pointer.nonNullMut<HeapHeader>(chain[n]) {
        Option<*mut HeapHeader>.Some { value } => { if !(unsafe HeapCell.payload<ObjectData, ()>(&anchor, value)).isWatched() { watched = false } }
        Option<*mut HeapHeader>.None => { watched = false }
      }
      n = n + 1
    }
    if !watched { continue }
    let at = known.count
    known.shapes[at] = version
    known.lengths[at] = usize.toU8(length)
    n = 0
    while n < length { known.chain[at * KNOWN_CHAIN + n] = chain[n] n = n + 1 }
    known.count = at + 1
  }
}
/// The address of the string cell that is atom's own in runtime's atom table (what
/// push_atom_value of it pushes, with a count), for compiled code to link; 0 for an integer
/// or a symbol atom. The cell lives while the atom does, and the bytecode naming it keeps it.
pub unsafe fn atomString(runtime: *mut HeapHeader, atom: u32) -> usize {
  if AtomTable.isInteger(atom) { return 0 }
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return match state.atoms.borrowedString(atom) { ValueBits.String { reference } => Pointer.address<HeapHeader>(reference) _ => 0 }
}
/// The version of the shape of a fresh array of bytecode's realm (ContextState.arrayShape:
/// `[]` and `new Array()` have it, with `length` its one property, a writable data slot 0,
/// and the realm's Array.prototype as prototype), or 0 when the realm has none yet.
pub unsafe fn arrayShapeVersion(bytecode: *mut HeapHeader) -> u64 {
  let anchor = ()
  let realm = (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)).realm
  let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)
  let shape = match Pointer.nonNullMut<HeapHeader>(context.arrayShape) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return 0 } }
  drop context
  return (unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)).version
}
/// Array.prototype.push (which 0) or pop (1) of bytecode's realm, when its Array.prototype
/// holds that native function of the realm in a data slot now: the function object, and in
/// atom the name it is under. Null when it holds none (not read yet, or replaced). A
/// snapshot: code that takes a callee for it tests the callee against the object, which
/// keepClosure keeps (js_baseline.SERVICE_ARRAY).
pub unsafe fn arrayNative(bytecode: *mut HeapHeader, which: u32, atom: &mut u32) -> ?*mut HeapHeader {
  let anchor = ()
  let realm = (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)).realm
  let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)
  if u32.toUsize(classes.JS_CLASS_ARRAY) >= context.classPrototypes.length() { return Pointer.null<HeapHeader>() }
  let prototype = match context.classPrototypes.get(u32.toUsize(classes.JS_CLASS_ARRAY)) { ValueBits.Object { reference } => reference _ => { return Pointer.null<HeapHeader>() } }
  drop context
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, prototype)
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, object.shape)
  let mut wanted = OBJECT_METHOD_PUSH
  if which == 1 { wanted = OBJECT_METHOD_POP }
  let mut i: usize = 0
  while i < shape.properties.length() && i < object.slotCount() {
    let property = shape.properties.get(i)
    i = i + 1
    if property.atom == 0 || (u8.toU32(property.flags) & JS_PROP_TMASK) != 0 { continue }
    let function = match (unsafe object.slotUnchecked(i - 1)).valueBits() { ValueBits.Object { reference } => reference _ => { continue } }
    let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, function)
    let found = match &data.payload {
      ObjectPayload.NativeFunction { function: native } => native.callKind == wanted && Pointer.address<HeapHeader>(native.realm()) == Pointer.address<HeapHeader>(realm)
      _ => false
    }
    drop data
    if found {
      atom.* = property.atom
      return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(function)
    }
  }
  return Pointer.null<HeapHeader>()
}
/// Releases every kept value (destroyRuntime).
pub unsafe fn releaseKept<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let count = state.compiled.keptCount
  let storage = state.compiled.kept
  state.compiled.keptCount = 0
  drop state
  if count == 0 { return () }
  let cells = unsafe Pointer.assumeManyMut<ValueBits>(unsafe Intrinsic.pointerRequalify<?*mut ValueBits, *mut ValueBits>(storage))
  let mut index: usize = 0
  while index < count { unsafe gc.release(&mut hooks, runtime, unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(cells, index))) index = index + 1 }
}
/// Lends the runtime `capacity` entries (a power of two, each SiteShapes.none()) in which it
/// records what each cached field site reads from (js_core_types.SiteShapes), for siteShapes
/// to answer from. Null and 0 take the storage back and stop the recording.
pub unsafe fn setSiteShapes(runtime: *mut HeapHeader, storage: ?*mut SiteShapes, capacity: usize) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  state.compiled.siteShapes = storage
  state.compiled.siteShapeMask = 0
  if capacity != 0 { state.compiled.siteShapeMask = capacity - 1 } else { state.compiled.siteShapes = Pointer.null<SiteShapes>() }
}
/// How many shapes the field site at pc of bytecode is recorded with (SiteShapes.seen; 0:
/// nothing is recorded of it). A site that left compiled code and has more since then
/// learned a shape there.
pub unsafe fn siteSeen(runtime: *mut HeapHeader, bytecode: *mut HeapHeader, pc: u32) -> u32 {
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let site = Pointer.address<u8>(unsafe code.code.start()) + u32.toUsize(pc) + 1
  drop code
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  if let Option<*mut SiteShapes>.Some { value: table } = Pointer.nonNullMut<SiteShapes>(state.compiled.siteShapes) {
    let at = unsafe siteShapeAt(table, state.compiled.siteShapeMask, site)
    if at != usize.MAX { return usize.toU32((unsafe Pointer.read<SiteShapes>(unsafe Pointer.atMut<SiteShapes>(unsafe Pointer.assumeManyMut<SiteShapes>(table), at))).seen) }
  }
  return 0
}

/// Whether a get_field2 site's recorded receiver shapes (siteShapes' keys, count of them)
/// include the shape of bytecode's realm's String, Number or Boolean prototype: baseline
/// code reads a primitive's method from its class prototype, which the site records as the
/// receiver (js_baseline.readFieldCached), so the receiver was a primitive.
pub unsafe fn primitiveReceiver(bytecode: *mut HeapHeader, keys: &[u64; 4], count: u32) -> bool {
  let anchor = ()
  let realm = (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)).realm
  let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)
  let mut c: usize = 0
  while c < 3 {
    let classId = if c == 0 { classes.JS_CLASS_STRING } else if c == 1 { classes.JS_CLASS_NUMBER } else { classes.JS_CLASS_BOOLEAN }
    if u32.toUsize(classId) < context.classPrototypes.length() {
      if let ValueBits.Object { reference } = context.classPrototypes.get(u32.toUsize(classId)) {
        let version = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, (unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)).shape)).version
        let mut n: usize = 0
        while n < u32.toUsize(count) && n < 4 {
          if u64.shiftRight(u64.shiftLeft(keys[n], 1), 17) == version { return true }
          n = n + 1
        }
      }
    }
    c = c + 1
  }
  return false
}
/// The shapes the field site at pc of bytecode read a data property from, into keys and
/// protoKeys (SiteShapes: an own slot, or a slot of the direct prototype or of its own
/// prototype, when firstKeys holds the version of the direct prototype's shape), and how many: 0
/// when nothing is known of the site, when it read from more than SITE_SHAPES shapes, or
/// when a version does not fit a signed 32-bit immediate. Snapshots, to be tested where used.
pub unsafe fn siteShapes(runtime: *mut HeapHeader, bytecode: *mut HeapHeader, pc: u32, keys: &mut [u64; 4], protoKeys: &mut [u64; 4], firstKeys: &mut [u64; 4]) -> u32 {
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let site = Pointer.address<u8>(unsafe code.code.start()) + u32.toUsize(pc) + 1
  drop code
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let mut count: usize = 0
  if let Option<*mut SiteShapes>.Some { value: table } = Pointer.nonNullMut<SiteShapes>(state.compiled.siteShapes) {
    let entries = unsafe Pointer.assumeManyMut<SiteShapes>(table)
    let at = unsafe siteShapeAt(table, state.compiled.siteShapeMask, site)
    if at != usize.MAX {
      let entry = unsafe Pointer.read<SiteShapes>(unsafe Pointer.atMut<SiteShapes>(entries, at))
      if entry.seen > SITE_SHAPES { return 0 }
      while count < entry.seen {
        firstKeys[count] = 0
        // A holder further up than the prototype: the prototype's version fixes it when it
        // is the prototype's own prototype (the pair holds while the epoch is the one it
        // was recorded at: the prototype is the object it was then). Any further up has
        // no slot the shapes fix.
        if let Option<*mut HeapHeader>.Some { value: first } = Pointer.nonNullMut<HeapHeader>(entry.firsts[count]) {
          if entry.epochs[count] != state.shapeEpoch { return 0 }
          let firstShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, (unsafe HeapCell.payload<ObjectData, ()>(&anchor, first)).shape)
          if Pointer.address<HeapHeader>(firstShape.prototype) != Pointer.address<HeapHeader>(entry.holders[count]) || firstShape.version == 0 || firstShape.version >= 2147483648 { return 0 }
          firstKeys[count] = firstShape.version
        }
        keys[count] = entry.keys[count] protoKeys[count] = entry.protoKeys[count] count = count + 1
      }
    }
  }
  if count == 0 {
    // The table lost the site to another: its site cache entry, when it still has one.
    let entry = &state.fieldCache[fieldCacheIndex(site)]
    if entry.site != site { return 0 }
    keys[0] = entry.key protoKeys[0] = entry.protoKey
    count = 1
  }
  let mut i: usize = 0
  while i < count {
    let key = keys[i]
    let proto = u64.bitAnd(key, FIELD_PROTO_KEY) != 0
    // Getter and absent keys have other high bits; a deeper chain has no slot here.
    let version = u64.shiftRight(u64.shiftLeft(key, 1), 17)
    if version == 0 || version >= 2147483648 || u64.shiftRight(key, 62) == 3 { return 0 }
    if proto {
      let holder = u64.shiftRight(protoKeys[i], 16)
      if holder == 0 || holder >= 2147483648 || u64.bitAnd(protoKeys[i], 65535) == FIELD_PASS_THROUGH { return 0 }
    }
    i = i + 1
  }
  return usize.toU32(count)
}
