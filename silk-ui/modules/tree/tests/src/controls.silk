//! Form controls center their contents in the block axis as Chromium's do: a one-line input's
//! text even when it overflows, a button's only while it fits, whatever display or
//! align-content the app gives them. A multiline input's text starts at the top.
import ui_tree.css
import ui_tree.css { px, Declaration, Keyword }
import ui_tree.lib { Tree, TreeError, Viewport, Attribute, InputNode, BoxNode, TextNode }
import properties.computed { Align, FlexDirection }
import ui_fixtures.fixtures as fixtures
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn viewport() -> Viewport {
  return Viewport { width: 400.0, height: 600.0, scale: 1.0 }
}

fn near(value: f32, expected: f32) -> bool {
  return f32.abs(value - expected) <= 1.0
}

fn middle(rect: Rect<f32>) -> f32 {
  return (rect.yMin + rect.yMax) / 2.0
}

effect fn rect(tree: &Tree<'_>, node: TextNode) -> Rect<f32> ! OutOfMemoryError ? &mut Allocator {
  return match run tree.bounds(node) {
    Option.Some { value } => value
    Option.None => Rect<f32>.new(-1000.0, -1000.0, 0.0, 0.0)
  }
}

effect fn caret(tree: &Tree<'_>, node: InputNode) -> Rect<f32> ! OutOfMemoryError ? &mut Allocator {
  return match run tree.caretRect(node) {
    Option.Some { value } => value
    Option.None => Rect<f32>.new(-1000.0, -1000.0, 0.0, 0.0)
  }
}

effect fn boxTop(tree: &Tree<'_>, node: BoxNode) -> f32 ! OutOfMemoryError ? &mut Allocator {
  return match run tree.bounds(node) {
    Option.Some { value } => value.yMin
    Option.None => -1000.0
  }
}

effect fn field(tree: &mut Tree<'_>, root: BoxNode, style: &[Declaration]) -> InputNode
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let node = run tree.input(style)
  run tree.append(root, node)
  run tree.setText(node, "Hbc")
  return node
}

effect fn labelled(tree: &mut Tree<'_>, root: BoxNode, tag: string, style: &[Declaration]) -> TextNode
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let node = run tree.box(style)
  run tree.setAttribute(node, Attribute.Element { name: run String.copy(tag) })
  let label = run tree.text("Hbc")
  run tree.append(node, label)
  run tree.append(root, node)
  return label
}

effect fn controlsCenter() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let root = run tree.box(&[css.display(Keyword.Flex), css.flexDirection(FlexDirection.Column), css.alignItems(Align.Start)])
  run tree.setRoot(root)
  let plain = run field(&mut tree, root, &[css.height(px(60.0))])
  let short = run field(&mut tree, root, &[css.height(px(10.0))])
  let padded = run field(&mut tree, root, &[css.height(px(60.0)), css.paddingTop(px(10.0))])
  // shadcn's Input is `display: flex`; Chromium still lays out the inner editor.
  let flexed = run field(&mut tree, root, &[css.height(px(60.0)), css.display(Keyword.Flex), css.alignContent(Align.End)])
  let area = run field(&mut tree, root, &[css.height(px(60.0))])
  run tree.setAttribute(area, Attribute.Multiline { value: true })
  let pressed = run labelled(&mut tree, root, "button", &[css.height(px(60.0)), css.alignContent(Align.End)])
  let squeezed = run labelled(&mut tree, root, "button", &[css.height(px(10.0))])
  let flexButton = run labelled(&mut tree, root, "button", &[css.height(px(60.0)), css.display(Keyword.Flex)])
  let chooser = run labelled(&mut tree, root, "select", &[css.height(px(60.0))])
  let block = run labelled(&mut tree, root, "div", &[css.height(px(60.0))])
  drop run tree.frame(viewport(), 0.0)

  let top = run boxTop(&tree, root)
  let plainCaret = run caret(&tree, plain)
  run Testing.expect(near(middle(plainCaret), top + 30.0), "a one-line input centers its text")
  let shortCaret = run caret(&tree, short)
  run Testing.expect(near(middle(shortCaret), top + 65.0), "and keeps it centered when it overflows")
  let paddedCaret = run caret(&tree, padded)
  run Testing.expect(near(middle(paddedCaret), top + 70.0 + 10.0 + 30.0), "in the content box")
  let flexedCaret = run caret(&tree, flexed)
  run Testing.expect(near(middle(flexedCaret), top + 140.0 + 30.0), "whatever display or align-content it has")
  let areaCaret = run caret(&tree, area)
  run Testing.expect(near(areaCaret.yMin, top + 200.0), "a multiline input starts at the top")

  let pressedText = run rect(&tree, pressed)
  run Testing.expect(near(middle(pressedText), top + 260.0 + 30.0), "a button centers its contents")
  let squeezedText = run rect(&tree, squeezed)
  run Testing.expect(near(squeezedText.yMin, top + 320.0), "but not past its top")
  let flexText = run rect(&tree, flexButton)
  run Testing.expect(near(flexText.yMin, top + 330.0), "a flex button lays out as flex")
  let chooserText = run rect(&tree, chooser)
  run Testing.expect(near(middle(chooserText), top + 390.0 + 30.0), "a select centers as a button")
  let blockText = run rect(&tree, block)
  run Testing.expect(near(blockText.yMin, top + 450.0), "other boxes do not")
}

test effect fn formControlsCenterTheirContents() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run controlsCenter() |> Effect.provideMut<Allocator>(&mut allocator)
}
