//! What a headless recording shows of its input (`record FILE --show-input`): a ring where the
//! pointer went down, fading over half a second, and a caption at the bottom with the keys
//! pressed and the text typed, gone a second and a half after the last. It draws in a root of
//! its own, set aside from the app and hidden from the inspector, so the app, its snapshots and
//! its hit testing never see it; only the video's frames do.
import ui_tree.css
import ui_tree.css { px, percent }
import ui_tree.legacy { UiTree, TreeError, FrameInput, Batch, NodeKind, Keyword, Position, BorderStyle, Mutation, Align, WhiteSpace }
import ui_tree.lib { RootOptions }
import ui_tree.input { Input, MOD_SHIFT, MOD_CONTROL, MOD_ALT, MOD_META }
import ui_inspect_server.lib { Inspector }
import ui_scene.color as color
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

/// The overlay's root, below the screen reader's at the top of the id space.
pub const INPUT_ROOT: u32 = 4294901777

const BOX: u32 = 4278190336

const CAPTION: u32 = 4278190337

const PILL: u32 = 4278190338

const CAPTION_TEXT: u32 = 4278190339

/// Pointer rings: a box each, reused in turn.
const FIRST_RING: u32 = 4278190344

const RINGS: u32 = 4

/// Seconds a ring takes to fade.
const RING_LIFE: f64 = 0.5

/// Seconds the caption stays after the last key or text.
const CAPTION_LIFE: f64 = 1.5

/// Ring diameter, in CSS pixels.
const RING_SIZE: f32 = 34.0

/// How many keys and runs of text the caption keeps.
const CHUNKS: usize = 4

struct Ring {
  x: f32,
  y: f32,
  /// When the pointer went down, in the run's seconds; negative for a ring not in use.
  at: f64,
}

/// The overlay of one recording. See the module documentation.
pub struct InputOverlay {
  rings: List<Ring>,
  next: usize,
  chunks: List<String>,
  /// Whether the last chunk is typed text that more text extends.
  typing: bool,
  lastKey: f64,
  built: bool,
  dirty: bool,
}

impl InputOverlay {
  pub effect fn make() -> InputOverlay
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut rings = List<Ring>.make()
    let mut i: u32 = 0
    while i < RINGS {
      run rings.append(Ring { x: 0.0, y: 0.0, at: -1.0 })
      i = i + 1
    }
    return InputOverlay {
      rings: move rings,
      next: 0,
      chunks: List<String>.make(),
      typing: false,
      lastKey: -100.0,
      built: false,
      dirty: true,
    }
  }

  /// Notes an input the app is about to handle, at `time` seconds into the run.
  pub effect fn note(self: &mut Self, input: &Input, time: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match &input.* {
      Input.PointerDown { x, y, .. } => {
        let slots = self.rings.asMutSlice()
        slots[self.next].x = x
        slots[self.next].y = y
        slots[self.next].at = time
        self.next = (self.next + 1) % u32.toUsize(RINGS)
        self.dirty = true
      }
      Input.KeyDown { key, modifiers, repeat, .. } => {
        let name = String.view(&key)
        if repeat || modifierKey(name) {
          return ()
        }
        let chord = modifiers & (MOD_CONTROL | MOD_ALT | MOD_META) != 0
        // A plain character comes again as text input: the caption shows it there.
        if !chord && String.byteLength(name) > 0 && countChars(name) == 1 && name != " " {
          return ()
        }
        let mut label = String.make()
        if modifiers & MOD_CONTROL != 0 { run label.append("Ctrl+") }
        if modifiers & MOD_ALT != 0 { run label.append("Alt+") }
        if modifiers & MOD_SHIFT != 0 && (chord || countChars(name) > 1) { run label.append("Shift+") }
        if modifiers & MOD_META != 0 { run label.append("Meta+") }
        run label.append(keyText(name))
        run self.push(move label, false, time)
      }
      Input.TextInput { text } => {
        if self.typing && time - self.lastKey < CAPTION_LIFE && self.chunks.length() > 0 {
          let last = self.chunks.length() - 1
          run self.chunks.asMutSlice()[last].append(String.view(&text))
          self.lastKey = time
          self.dirty = true
        } else {
          run self.push(run String.copy(String.view(&text)), true, time)
        }
      }
      Input.Paste { .. } => {
        run self.push(run String.copy("Paste"), false, time)
      }
      _ => {}
    }
  }

  effect fn push(self: &mut Self, chunk: String, typing: bool, time: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if time - self.lastKey >= CAPTION_LIFE {
      self.chunks.clear()
    }
    run self.chunks.append(move chunk)
    while self.chunks.length() > CHUNKS {
      drop self.chunks.remove(0)
    }
    self.typing = typing
    self.lastKey = time
    self.dirty = true
  }

  /// Brings the overlay's nodes up to `time` and lays its root out at `viewport`. Call before
  /// drawing a recorded frame, after the app's own frame; the scene is `tree.sceneOf(INPUT_ROOT)`.
  pub effect fn frame(self: &mut Self, tree: &mut UiTree<'_>, inspector: &mut Inspector, viewport: FrameInput) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.build(&mut tree, &mut inspector)
    let time = viewport.time
    let mut batch = Batch.make()
    let mut changed = self.dirty
    let rings = self.rings.asSlice()
    let mut i: usize = 0
    while i < rings.length {
      let age = time - rings[i].at
      let id = FIRST_RING + usize.toU32(i)
      if rings[i].at >= 0.0 && age < RING_LIFE {
        let left = 1.0 - age / RING_LIFE
        let grow = f64.toF32((1.0 - left) * 10.0)
        let size = RING_SIZE + grow
        run batch.style(
          id,
          &[
            css.display(Keyword.Block),
            css.left(px(rings[i].x - size / 2.0)),
            css.top(px(rings[i].y - size / 2.0)),
            css.width(px(size)),
            css.height(px(size)),
            css.opacity(f64.toF32(left)),
          ],
        )
        changed = true
      } else if rings[i].at >= 0.0 {
        run batch.style(id, &[css.display(Keyword.None)])
        changed = true
      }
      i = i + 1
    }
    if self.rings.length() > 0 {
      let slice = self.rings.asMutSlice()
      let mut j: usize = 0
      while j < slice.length {
        if slice[j].at >= 0.0 && time - slice[j].at >= RING_LIFE {
          slice[j].at = -1.0
        }
        j = j + 1
      }
    }
    let showing = self.chunks.length() > 0 && time - self.lastKey < CAPTION_LIFE
    if self.dirty || (!showing && self.chunks.length() > 0) {
      if !showing {
        self.chunks.clear()
      }
      let mut text = String.make()
      let chunks = self.chunks.asSlice()
      let mut k: usize = 0
      while k < chunks.length {
        if k > 0 { run text.append("   ") }
        run text.append(String.view(&chunks[k]))
        k = k + 1
      }
      run batch.setText(CAPTION_TEXT, String.view(&text))
      run batch.style(CAPTION, &[css.display(if chunks.length > 0 { Keyword.Flex } else { Keyword.None })])
      changed = true
    }
    self.dirty = false
    let back = tree.current
    drop run tree.useRoot(INPUT_ROOT)
    if changed {
      run tree.apply(run batch.take())
    }
    run tree.frameRoot(INPUT_ROOT, viewport)
    drop run tree.useRoot(back)
  }

  /// Makes the overlay's nodes, once.
  effect fn build(self: &mut Self, tree: &mut UiTree<'_>, inspector: &mut Inspector) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.built {
      return ()
    }
    run inspector.hide(INPUT_ROOT, true)
    run tree.setAside(INPUT_ROOT, true)
    let back = tree.current
    let mut batch = Batch.make()
    run batch.create(BOX, NodeKind.Box)
    run batch.style(
      BOX,
      &[
        css.width(percent(100.0)),
        css.height(percent(100.0)),
        css.position(Position.Relative),
        css.pointerEvents(false),
      ],
    )
    let mut i: u32 = 0
    while i < RINGS {
      run batch.box(
        BOX,
        FIRST_RING + i,
        &[
          css.display(Keyword.None),
          css.position(Position.Absolute),
          css.borderWidth(px(3.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(color.rgba(0x2563ebff)),
          css.backgroundColor(color.rgba(0x2563eb33)),
          css.borderRadius(percent(50.0)),
        ],
      )
      i = i + 1
    }
    run batch.box(
      BOX,
      CAPTION,
      &[
        css.display(Keyword.None),
        css.position(Position.Absolute),
        css.left(px(0.0)),
        css.right(px(0.0)),
        css.bottom(px(18.0)),
        css.justifyContent(Align.Center),
      ],
    )
    run batch.box(
      CAPTION,
      PILL,
      &[
        css.padding(px(8.0)),
        css.paddingLeft(px(14.0)),
        css.paddingRight(px(14.0)),
        css.borderRadius(px(8.0)),
        css.backgroundColor(color.rgba(0x111827e6)),
        css.color(color.rgba(0xffffffff)),
        css.fontSize(px(18.0)),
        css.whiteSpace(WhiteSpace.Pre),
      ],
    )
    run batch.text(PILL, CAPTION_TEXT, "")
    run batch.openRoot(INPUT_ROOT, BOX, RootOptions.default())
    drop run tree.useRoot(INPUT_ROOT)
    run tree.apply(run batch.take())
    drop run tree.useRoot(back)
    self.built = true
    self.dirty = true
  }

  /// Removes the overlay's nodes, after a recording.
  pub effect fn tear(self: &mut Self, tree: &mut UiTree<'_>, inspector: &mut Inspector) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if !self.built {
      return ()
    }
    let back = tree.current
    let mut batch = List<Mutation>.make()
    run batch.append(Mutation.CloseRoot { root: INPUT_ROOT })
    run batch.append(Mutation.Destroy { id: BOX })
    drop run tree.useRoot(INPUT_ROOT)
    run tree.apply(move batch)
    drop run tree.useRoot(back)
    run tree.setAside(INPUT_ROOT, false)
    run inspector.hide(INPUT_ROOT, false)
    self.built = false
  }
}

fn modifierKey(name: string) -> bool {
  return name == "Shift" || name == "Control" || name == "Alt" || name == "Meta" || name == "CapsLock"
}

/// The characters in `text`, counting UTF-8 lead bytes.
fn countChars(text: string) -> usize {
  let bytes = String.utf8Bytes(text)
  let mut n: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    if bytes[i] & 192 != 128 {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

/// How the caption names a key: arrows without the `Arrow`, a space as `Space`.
fn keyText(name: string) -> string {
  if name == " " {
    return "Space"
  }
  if String.startsWith(name, "Arrow") {
    return String.slice(name, 5, String.byteLength(name) - 5)
  }
  if name == "Escape" {
    return "Esc"
  }
  return name
}
