  }
  let holder = (unsafe objData.slotUnchecked(u64.toUsize(k1 & 0xffff))).valueBits()
  drop objData
  let target = match holder { ValueBits.Object { reference } => reference _ => { return false } }
  let targetData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, target)
  let targetVersion = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, targetData.shape)).version
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let methodSite = Pointer.address<u8>(unsafe codeAt(ip, ACCESSOR_TAIL + 1))
  let entry = &state.fieldCache[fieldCacheIndex(methodSite)]
