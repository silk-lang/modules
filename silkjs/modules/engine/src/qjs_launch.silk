//! One libc Session owns the qjs realm, loader, handlers and worker services.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.i32
import cli_options { Arguments, QjsOptions }
import cli_io
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_runtime_registry { ClassIdAllocator }
import js_libc_process { Process }
import js_code_cache { CodeCache }
import js_code_cache as code_cache
import js_heap { HeapHeader }
import js_runtime as runtime
import js_exceptions { JsException }
import js_libc { Session }
import js_libc as libc
import runtime_memory { RuntimeAllocator }
import native_stack
import qjs
import js_debugger
import qjs_memory { TraceAllocator }
import qjs_stats
import qjs_benchmark
import silk.core.option { Option }
import silk.collections.list { List }
import cli_options { ArgRef }
import js_libc_platform as platform
import js_libc_platform { PlatformError }
import qjs_feedback
import js_baseline as baseline
import js_libc_services as services

pub effect fn runInterpreter(arguments: &Arguments, options: &QjsOptions) -> i32
  ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  // These embedding-wide owners outlive the Session and every worker it joins.
  let namespace = run ClassIdAllocator.make()
  let mut process = run Process.make(&namespace)
  if options.codeCache { process.codeCache = run CodeCache.enabled(code_cache.DEFAULT_BUDGET) }
  let domain = run WaiterDomain.make()
  // An --image file's bytes: function bodies stay in them, so they outlive the runtime.
  let mut imageBytes = List<u8>.make()
  if let Option<ArgRef>.Some { value: named } = &options.image {
    let loaded = run Effect.result(platform.readFile(arguments.resolve(named)))
    match move loaded {
      Result<List<u8>, OutOfMemoryError | PlatformError>.Success { value } => { imageBytes = move value }
      Result<List<u8>, OutOfMemoryError | PlatformError>.Failure { .. } => { cli_io.stderr(b"qjs: cannot read the image\n") return 2 }
    }
    if imageBytes.length() == 0 { cli_io.stderr(b"qjs: the image is empty\n") return 2 }
  }
  let mut allocator = run RuntimeAllocator.make(TraceAllocator.make(options.traceMemory != 0))
  // Tracing reports every child allocation, so only pool when it is off.
  if options.traceMemory == 0 { allocator.enablePooling() }
  let memory = run allocator.observe()
  let runtimeResult = run Effect.result(runtime.allocateRuntimeStorage(native_stack.currentFrameAddress())) |> Effect.provideMut<Allocator>(&mut allocator)
  let rt = match move runtimeResult {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { .. } => {
      cli_io.stderr(b"qjs: cannot allocate JS runtime\n") return 2
    }
  }
  if options.debugObserved { unsafe js_debugger.configure(rt, true) }
  if options.debugFeedback != 0 { unsafe qjs_feedback.install(rt) }
  if let Option<*const u8>.Some { value: setup } = Pointer.nonNull<u8>(options.runtimeSetup) {
    let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn(*mut HeapHeader, ?*mut u8) -> ()>(Pointer.fromRef<*const u8>(&setup))
    let function = unsafe Pointer.read<extern "C" fn(*mut HeapHeader, ?*mut u8) -> ()>(slot)
    unsafe function(rt, options.runtimeSetupData)
  }
  // What baseline code asks the engine for runs on this allocator (js_libc_services).
  unsafe baseline.setService(rt, unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(services.baselineServiceAddress()),
    unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut RuntimeAllocator<TraceAllocator>, *mut u8>(Pointer.fromMutRef<RuntimeAllocator<TraceAllocator>>(&mut allocator))))
  if options.memoryLimit != 0 { allocator.setLimit(options.memoryLimit) }
  if options.stackSize != 0 {
    let reserved = run Effect.result(unsafe runtime.reserveCallFrames(rt, options.stackSize)) |> Effect.provideMut<Allocator>(&mut allocator)
    match move reserved {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { .. } => { cli_io.stderr(b"qjs: cannot allocate the JS stack\n") return 2 }
    }
    unsafe runtime.setMaxStackSize(rt, options.stackSize)
  }
  unsafe runtime.setStripInfo(rt, i32.toU8(options.stripFlags))
  let opened = run Effect.result(unsafe Session.fromRuntime(&memory, domain.handle(), &process, options.experimental, rt)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut session = match move opened {
    Result<Session, OutOfMemoryError | JsException>.Success { value } => move value
    Result<Session, OutOfMemoryError | JsException>.Failure { .. } => {
      cli_io.stderr(b"qjs: cannot allocate JS context\n") return 2
    }
  }
  let evaluated = run Effect.result(unsafe qjs.execute(&mut session, arguments, options, imageBytes.asSlice())) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut status: i32 = 1
  match move evaluated {
    Result<i32, OutOfMemoryError | JsException>.Success { value } => { status = value }
    Result<i32, OutOfMemoryError | JsException>.Failure { .. } => {
      run libc.dumpError(&mut session.engine, session.context.realm()) |> Effect.provideMut<Allocator>(&mut allocator)
    }
  }
  if status == 0 && options.dumpMemory != 0 { unsafe qjs_stats.dump(session.runtime, &memory) }
  if options.debugFeedback == 2 { unsafe qjs_feedback.print(session.runtime) }
  run unsafe session.close() |> Effect.provideMut<Allocator>(&mut allocator)
  drop session
  drop imageBytes
  if status == 0 && options.emptyRun != 0 && options.dumpMemory != 0 {
    let measured = run Effect.result(unsafe qjs_benchmark.runBenchmark(domain.handle(), &process))
    match move measured {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsException>.Failure { .. } => {
        cli_io.stderr(b"qjs: instantiation benchmark failed\n") return 2
      }
    }
  }
  return status
}
