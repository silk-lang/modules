//! What the steps write to standard error: `silkui` lines, artifact sizes and times, styled
//! on a terminal and plain otherwise.
import silk.num.u32
import silk.core.effect { Effect }
import silk.io.writer_native { StderrWriter }
import silk.num.i64
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.terminal { Terminal }
import silk.text.string { String }

fn styled() -> bool { return Terminal.isTerminal(2) }

fn paint(code: string<'static>) -> string<'static> { return if styled() { code } else { "" } }

fn reset() -> string<'static> { return paint("\x1b[0m") }

/// Nanoseconds on a clock that never goes back, for durations.
pub fn now() -> u64 {
  let mut clock = OsMonotonicClock.make()
  let at = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  return i64.toU64(at.seconds() * 1000000000 + u32.toI64(at.subsecondNanoseconds()))
}

/// `silkui <text>`.
pub fn say(text: string) -> () {
  StderrWriter.print("{}silkui{} {}\n", &.(paint("\x1b[1;36m"), reset(), text))
}

/// `silkui ✓ <text> in <time since started>`.
pub fn done(text: string, started: u64) -> () {
  StderrWriter.print("{}silkui{} {}✓{} {} in ", &.(paint("\x1b[1;36m"), reset(), paint("\x1b[32m"), reset(), text))
  elapsed(started)
  StderrWriter.print("\n", &.())
}

/// One artifact: `  build/x86_64-unknown-linux-gnu/release/my-app-host-window  34.3 MB`, the folder dim and the name bold.
pub fn artifact(path: string, bytes: usize) -> () {
  let mut cut: usize = 0
  let raw = String.utf8Bytes(path)
  let mut at: usize = 0
  while at < raw.length {
    if raw[at] == 47 { cut = at + 1 }
    at = at + 1
  }
  let folder = String.slice(path, 0, cut)
  let name = String.slice(path, cut, raw.length - cut)
  StderrWriter.print("  {}{}{}{}{}{}  ", &.(paint("\x1b[2m"), folder, reset(), paint("\x1b[1;36m"), name, reset()))
  StderrWriter.print("{}", &.(paint("\x1b[1m")))
  size(bytes)
  StderrWriter.print("{}\n", &.(reset()))
}

/// The last line of a build: `✓ built my-app in 1m 52s`.
pub fn built(name: string, started: u64) -> () {
  StderrWriter.print("\n{}✓{} built {} in ", &.(paint("\x1b[32m"), reset(), name))
  elapsed(started)
  StderrWriter.print("\n", &.())
}

/// A size as `34.3 MB` or `258.8 kB`, in powers of 1000 as Vite writes them.
fn size(bytes: usize) -> () {
  if bytes >= 1000000 {
    let tenths = (bytes + 50000) / 100000
    StderrWriter.print("{}.{} MB", &.(tenths / 10, tenths % 10))
  } else {
    let tenths = (bytes + 50) / 100
    StderrWriter.print("{}.{} kB", &.(tenths / 10, tenths % 10))
  }
}

/// The time since `started`, bold: `216ms`, `4.2s` or `5m 03s`.
fn elapsed(started: u64) -> () {
  let current = now()
  let nanos = if current > started { current - started } else { 0 }
  let ms = nanos / 1000000
  StderrWriter.print("{}", &.(paint("\x1b[1m")))
  if ms < 1000 {
    StderrWriter.print("{}ms", &.(ms))
  } else if ms < 60000 {
    StderrWriter.print("{}.{}s", &.(ms / 1000, (ms % 1000) / 100))
  } else {
    let seconds = ms / 1000
    let pad = if seconds % 60 < 10 { "0" } else { "" }
    StderrWriter.print("{}m {}{}s", &.(seconds / 60, pad, seconds % 60))
  }
  StderrWriter.print("{}", &.(reset()))
}
