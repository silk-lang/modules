//! Baseline code (docs/jit/baseline.md) in a live engine: hot functions run it, call each
//! other in it, and leave it for the interpreter where they must.
import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.testing.testing { Testing, AssertionError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.js_engine { Engine }
import silkjs.js_engine as engineEntry
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_owned_value { Value }
import silkjs.js_realm { lendRealm }
import silkjs.js_core_types { HostHook, NativeFunctionId }
import silkjs.js_exceptions { JsException }
import silkjs.js_baseline { BaselineFrame }
import silkjs.js_baseline as engineBaseline
import silkjs.js_runtime as runtime
import silkjs.js_gc as gc
import silkjs.js_eval as eval
import silkjs.js_intrinsic_install as intrinsics
import silkjs.native_stack as stack
import jit_runtime { Jit, Options }
import jit_runtime as jitRuntime
import jit_engine_tests { Compiling }

const HANDLER: u32 = 11

/// js_baseline.ServiceEntry for these tests' engines and allocator.
export "C" fn silkjsJitTestsBaselineService(hooks: *mut u8, allocator: *mut u8, record: *mut BaselineFrame, request: u64, base: *mut ValueBits, count: usize) -> u64 {
  return unsafe engineEntry.baselineService<Compiling, RuntimeAllocator<SystemAllocator>>(hooks, allocator, record, request, base, count)
}
fn serviceAddress() -> *const u8 {
  let entry: extern "C" fn(*mut u8, *mut u8, *mut BaselineFrame, u64, *mut ValueBits, usize) -> u64 = silkjsJitTestsBaselineService
  return unsafe Pointer.read<*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut u8, *mut u8, *mut BaselineFrame, u64, *mut ValueBits, usize) -> u64, *const *const u8>(Pointer.fromRef(&entry)))
}

unsafe effect fn evaluate<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader, source: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let memory = engine.memory
  let result = run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"baseline.js", 0)
  let bits = Value.intoBits(move result)
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), bits)
  return bits
}
fn isInt(bits: ValueBits, expected: i32) -> bool { return match bits { ValueBits.Int { value } => value == expected _ => false } }

/// Methods on a linked list: field reads and writes, a loop, method calls from method to method.
const LIST: &[u8] = b"function P(v,n){this.v=v;this.n=n}P.prototype.sum=function(){var t=0;var p=this;while(p!=null){t=t+p.v;p=p.n}return t};P.prototype.first=function(){return this.v};P.prototype.both=function(){return this.sum()+this.first()};P.prototype.bump=function(d){this.v=this.v+d;return this.v};function build(k){var l=null;for(var i=0;i<k;i++)l=new P(i,l);return l}var L=build(20);"
/// A throw two calls deep, caught by interpreted code.
const THROWS: &[u8] = b"var T={thrower:function(n){if(n>250)throw new Error('boom');return n},mid:function(n){return this.thrower(n)+1}};var c=0;try{for(var i=0;i<300;i++)c+=T.mid(i)}catch(e){c=c+1000000}c"
/// Recursion to the end of the native stack.
const DEEP: &[u8] = b"var R={f:function(n){return n==0?0:1+this.f(n-1)}};var r=0;for(var i=0;i<100;i++)r+=R.f(50);try{R.f(1e6);r=-1}catch(e){r=r+(e instanceof RangeError?1:0)}r"

/// Operators, keep branches, an Array's length, string constants and a construction, all from a
/// compiled driver: 45055491 in the interpreter.
const OPERATORS: &[u8] = b"function Pt(x,y){this.x=x;this.y=y}var K={or:function(a,b){return a||b},and:function(a,b){return a&&b},not:function(a){return !a},mul:function(a,b){return a*b},div:function(a,b){return a/b},mod:function(a,b){return a%b},lt:function(a,b){return a<b?1:0},len:function(a){return a.length},nm:function(i){return i&1?'odd':'even'},chain:function(o,v){var r=o.p=v;return r},set:function(o,v){var q=o;q.g=v;return q.g},make:function(i){return new Pt(i,i+1)},run:function(i,h,a){var t=this.or(0,i)+this.and(i,2)+(this.not(i&1)?1:0)+(this.or('',null)===null?1:0)+this.and('a',7);t+=this.mul(i,3)+this.mul(i,0.5)*2+this.div(i,4)*4+this.mod(i,7)+this.mul(65536,65536)/4294967296+this.lt(i,1500)+this.lt(0.5,i);t+=this.len(a)+this.nm(i).length+this.chain(h,i)+this.set(h,i);var p=this.make(i);return t+p.x+p.y}};var t=0;var h={p:0,g:0};var a=[1,2,3];for(var i=0;i<3000;i++){t=(t+K.run(i,h,a))|0}t"

/// Instructions without templates, which the engine runs one at a time: object and array
/// literals, typeof, instanceof, in, for-in, a closure, try and catch, delete, arguments, a
/// switch. 6408247 in the interpreter.
const STEPPED: &[u8] = b"function Q(x){this.x=x}var S={obj:function(a,b){var o={p:a,q:b};return o.p+o.q},arr:function(a,b){var v=[a,b,a+b];return v[2]+v.length},ty:function(a){return typeof a==='number'?1:2},ins:function(a){return a instanceof Q?3:4},inn:function(o){return 'x' in o?5:6},forin:function(o){var n=0;for(var k in o){n=n+k.length}return n},clo:function(a){var f=function(){return 7};return f()+a},thr:function(a){try{if(a%7==3){throw a}return 1}catch(e){return e}},del:function(a){var o={z:a,w:2};delete o.z;return o.z===undefined?8:9},str:function(a){return ('n'+a).length},args:function(){return arguments.length+arguments[1]},sw:function(a){switch(a%4){case 0:return 10;case 1:return 11;default:return 12}},run:function(i,p){var s=0;s=s+this.obj(i,2)+this.arr(i,3)+this.ty(i)+this.ty('s')+this.ins(p)+this.ins(i)+this.inn(p)+this.forin(p)+this.clo(i)+this.thr(i)+this.del(i)+this.str(i)+this.args(i,4,5)+this.sw(i);return s|0}};var st=0;var q=new Q(1);for(var i=0;i<2000;i++){st=(st+S.run(i,q))|0}st"
/// The fused arithmetic on locals and arguments, doubles, slot steps, shifts, element and
/// length reads from slots, parameter and global stores, constants: -309818 in the interpreter.
const ARITHMETIC: &[u8] = b"var H=0;var A={ll:function(a,b){var x=a,y=b;var p=x+y;var q=x-y;var r=x*y;return p+q+r},ta:function(a,b){var y=b;return ((a+1)+b)+((a+2)-b)+((a+3)*b)+((a+1)+y)+((a+2)-y)+((a+3)*y)},fl:function(a,b){var x=a*0.5,y=b*0.25;return x+y+(x-y)+(x*y)+(x/y)+(a%b)},cmp:function(a,b){var x=a*0.5,y=b*0.5;var n=0;if(x<y)n+=1;if(x<=y)n+=2;if(x>y)n+=4;if(x>=y)n+=8;return n},stl:function(n){var i=0,s=0;while(i<n){s+=i;i++}var k=5;var u=k++ + ++k + k-- + --k;return s+u},sta:function(a,n){var s=0;a++;s+=a;a--;s+=a;n+=2;s+=n;return s},sh:function(a,b){return (a<<b)+(a>>b)+(a>>>b)+(a<<3)+(a|8)+(-a)+(~a)+(+a)},el:function(v,i){var w=v,j=i;return w[j]+v[j]+w[i]+v[i]+w.length+v.length},pa:function(a,b){a=b+1;b=a+a;var c=(a=b);return a+b+c},cst:function(a){return a*1.5+2.25},se:function(a){var n=0;if(a===0)n+=1;if(a!==1)n+=2;if(a*0.5===1)n+=4;return n},und:function(a){var n=0;if(a===undefined)n+=2;if(a===null)n+=4;return n},gv:function(a){H=H+a;H=(H|0)%1000;return H},e3:function(v,i){v[i]+=2;v[i]-=2;return v[i]++ + --v[i]},run:function(i,v){var s=0;s+=this.ll(i,7)+this.ll(i*0.5,3)+this.ta(i,5)+this.ta(i,1.5)+this.fl(i,4)+this.cmp(i,50)+this.cmp(i,0/0)+this.stl(i%20)+this.sta(i,3)+this.sta(i+0.5,1)+this.sh(i,3)+this.sh(-i,31)+this.el(v,i%8)+this.pa(i,2)+this.cst(i)+this.se(i%3)+this.und(i%2?undefined:null)+this.gv(i)+this.e3(v,i%8);return s}};var at=0;var w=[1,2,3,4,5,6,7,8];for(var i=0;i<2000;i++){at=(at+A.run(i,w))%1000003}at|0"

/// Functions that run once and loop long: the interpreter starts each and baseline code takes
/// the activation over at a back edge (js_vm.baselineLoop), with locals, under a for-of's
/// iterator and inside a try. 1105157702 in the interpreter.
const LOOPS: &[u8] = b"var G={once:function(n,k){var s=0;for(var i=0;i<n;i++){s=(s+i*k)|0}return s},of:function(a){var s=0;for(var x of a){s+=x}return s},thr:function(n){var s=0;try{for(var i=0;i<n;i++){s+=i&3;if(i==n-2)throw s}}catch(e){return e+1}return 0}};var a=[];for(var j=0;j<40000;j++)a.push(j&7);G.once(60000,3)+G.of(a)+G.thr(50000)"

/// The counters of the jit's baseline environment the checks read, without a copy of the
/// environment (its tables are large).
struct Counters { directCalls: u64, departures: u64, steps: u64, resumes: u64 }
fn countersOf(jit: &Jit) -> Counters {
  let env = &jit.baselineEnv.asSlice()[0]
  return Counters { directCalls: env.directCalls, departures: env.departures, steps: env.steps, resumes: env.resumes }
}
unsafe effect fn exercise<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, LIST)
  let cold = run unsafe evaluate(&mut engine, context, b"var t=0;for(var i=0;i<5;i++)t=(t+L.both())|0;t")
  run Testing.expect(isInt(cold, 1045) && engine.services.jit.baselineCompiled == 0, "cold: interpreted, nothing compiled")
  // Hot functions are delivered at an interrupt poll, which 3000 rounds of a 20-step loop reach.
  let hot = run unsafe evaluate(&mut engine, context, b"var t=0;for(var i=0;i<3000;i++)t=(t+L.both())|0;t")
  run Testing.expect(isInt(hot, 627000), "hot: baseline code returns the interpreter's sum")
  // The script itself may be a fourth: a poll in its loop reports it too.
  run Testing.expect(engine.services.jit.baselineCompiled >= 3 && engine.services.jit.baselineRefused == 0, "sum, first and both have baseline code")
  let counters = countersOf(&engine.services.jit)
  run Testing.expect(counters.directCalls >= 500, "both calls sum and first without the engine (fails if calls stop linking)")
  run Testing.expect(counters.departures == 0, "and no instruction of theirs left for the interpreter")
  let stored = run unsafe evaluate(&mut engine, context, b"var t=0;for(var i=0;i<100;i++)t=t+L.bump(2);t+L.first()")
  run Testing.expect(isInt(stored, 12219), "field stores in baseline code are the interpreter's")
  // Operands the templates do not take: the interpreter finishes the activation.
  let mixed = run unsafe evaluate(&mut engine, context, b"L.v=0.5;var d=L.both();L.v='a';var s=L.bump('b');L.v=19;d==172&&s==='ab'?1:0")
  run Testing.expect(isInt(mixed, 1), "a double and a string in a field leave to the interpreter and come back right")
  let thrown = run unsafe evaluate(&mut engine, context, THROWS)
  run Testing.expect(isInt(thrown, 1031626), "a throw crosses two baseline frames and the interpreted caller catches it")
  let deep = run unsafe evaluate(&mut engine, context, DEEP)
  run Testing.expect(isInt(deep, 5001), "recursion ends in the interpreter's RangeError")
  let after = run unsafe evaluate(&mut engine, context, b"L.both()")
  run Testing.expect(isInt(after, 209), "and the code still runs afterwards")
  let operated = run unsafe evaluate(&mut engine, context, OPERATORS)
  run Testing.expect(isInt(operated, 45055491), "operators, keep branches, length, constants and a construction agree with the interpreter")
  let before = countersOf(&engine.services.jit)
  let beforeSteps = before.steps
  let beforeDepartures = before.departures
  let stepped = run unsafe evaluate(&mut engine, context, STEPPED)
  run Testing.expect(isInt(stepped, 6408247), "instructions the engine runs one at a time agree with the interpreter")
  let between = countersOf(&engine.services.jit)
  run Testing.expect(between.steps > beforeSteps + 10000, "and they are steps, not departures (fails if the step service stops being used)")
  // What still departs: the throws (286 of 2000 rounds) and the for-in loop's end.
  run Testing.expect(between.departures - beforeDepartures < 3000, "the activations go on in baseline code after a step")
  let betweenSteps = between.steps
  let betweenDepartures = between.departures
  let computed = run unsafe evaluate(&mut engine, context, ARITHMETIC)
  run Testing.expect(isInt(computed, -309818), "fused arithmetic, doubles, slot steps, shifts and slot reads agree with the interpreter")
  let last = countersOf(&engine.services.jit)
  run Testing.expect(last.departures == betweenDepartures, "with no departure")
  // The doubles in Int templates (a parameter that holds 0.5) are steps; the rest are templates.
  run Testing.expect(last.steps - betweenSteps < 20000, "and templates for nearly all of it (fails if a template of the family stops covering its opcode)")
  let looped = run unsafe evaluate(&mut engine, context, LOOPS)
  run Testing.expect(isInt(looped, 1105157702), "an activation that baseline code takes over in a running loop ends as the interpreter's would")
  let entered = countersOf(&engine.services.jit)
  // Each of the three functions is called once; the code can only have run them from a back edge.
  run Testing.expect(entered.resumes >= last.resumes + 3, "and the three loops went on in baseline code (fails if no activation is entered at a back edge)")
  run Testing.expect(entered.departures == last.departures, "with no departure")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}

test effect fn hotFunctionsRunBaselineCode() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut options = Options.make()
  options.enabled = true options.baseline = true options.stats = true options.threshold = 20
  let jit = run Jit.make(move options) |> Effect.provideMut<Allocator>(&mut system)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: Compiling { jit: move jit, failures: 0 } }
  unsafe engineBaseline.setService(rt, unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(serviceAddress()),
    unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut RuntimeAllocator<SystemAllocator>, *mut u8>(Pointer.fromMutRef<RuntimeAllocator<SystemAllocator>>(&mut allocator))))
  unsafe jitRuntime.attach(&mut engine.services.jit, rt)
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: HANDLER }), opaque: Pointer.null<u8>() })
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = run Effect.result(unsafe exercise(&mut engine, context)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), JsException | AssertionError<'static>>.Success { value: _ } => ()
    Result<(), JsException | AssertionError<'static>>.Failure { error } => { fail move error }
  }
}
