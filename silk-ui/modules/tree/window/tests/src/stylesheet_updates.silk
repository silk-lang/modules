import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, FrameInput }
import ui_protocol.options { RootOptions }
import ui_tree.style_assets { StyleAssets }
import ui_tree_window.style_watch { SheetWatch }
import ui_protocol.style_bundle as bundle
import ui_protocol.style_bundle { DecodeError }
import ui_fixtures.fixtures
import css_style.compile
import css_style.compile { Options, CompileError }
import css_style.tokens { CssError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem, FileError, AtomicWriteError, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInputError }
import test_paths { directory }
import silk.testing.testing { Testing, AssertionError }

effect fn sheet(css: &[u8]) -> Bytes ! CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let compiled = run compile.compile(css, &Options.make())
  return run compiled.encode()
}

effect fn two(first: &[u8], second: &[u8]) -> Bytes ! DecodeError | OutOfMemoryError ? &mut Allocator {
  let mut sources = List<Bytes>.make()
  run sources.append(run Bytes.copy(first))
  run sources.append(run Bytes.copy(second))
  return run bundle.encode(sources.asSlice())
}

effect fn publish(path: &Path, bytes: &[u8]) -> () ! AtomicWriteError ? &mut FileSystem {
  run FileSystem.writeFileAtomic(path, bytes, FileSystem.replaceExisting(), FileSystem.buffered())
}

effect fn exercise(path: &Path) -> ()
  ! TreeError | CompileError | CssError | DecodeError | FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut FileSystem {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let first = run sheet(b"div{width:10px;height:8px}")
  let second = run sheet(b"div{width:20px}")
  let mut assets = run StyleAssets.from(&[first.asSlice(), second.asSlice()])
  let original = run two(first.asSlice(), second.asSlice())
  run publish(path, original.asSlice())
  let mut watch = run SheetWatch.from(path.view().unwrapOr(""))
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.openRoot(1, 2, RootOptions.default())
  run batch.create(3, NodeKind.Box)
  run batch.openRoot(2, 3, RootOptions.default())
  run tree.apply(run batch.take())
  drop run assets.serve(&mut tree, 0)
  drop run assets.serve(&mut tree, 1)
  let frame = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frameRoot(0, frame)
  run tree.frameRoot(1, frame)
  run tree.frameRoot(2, frame)
  run Testing.expect(!run watch.pollWith(&mut assets, &mut tree, 0.0), "initial bundle identical to embedded assets does not restyle")
  let changedFirst = run sheet(b"div{width:30px;height:18px}")
  let changedSecond = run sheet(b"div{width:40px}")
  let invalid = run two(changedFirst.asSlice(), b"invalid compiled sheet")
  run publish(path, invalid.asSlice())
  let rejected = run Effect.result(watch.pollWith(&mut assets, &mut tree, 0.5))
  run Testing.expect(match &rejected { Result.Success { .. } => false
    Result.Failure { error } => match &error { DecodeError _rejectedFormat => true
      _ => false } }, "a bad sheet rejects the entire update")
  run Testing.expect(!run assets.serveInstalled(&mut tree), "an earlier valid sheet in a rejected bundle was not committed")
  run Testing.expect(!run watch.pollWith(&mut assets, &mut tree, 1.0), "unchanged bad bytes are not parsed and reported repeatedly")
  run tree.frameRoot(0, frame)
  run Testing.expect(tree.node(tree.slotOf(1)).computed().layout.height.value == 8.0 && tree.node(tree.slotOf(1)).computed().layout.width.value == 20.0, "rejected updates retain previous computed style")
  run FileSystem.removeFile(path)
  run Testing.expect(!run watch.poll(&mut assets, &mut tree, 1.5), "missing files keep the running app and its active styles")
  let changed = run two(changedFirst.asSlice(), changedSecond.asSlice())
  run publish(path, changed.asSlice())
  run Testing.expect(run watch.pollWith(&mut assets, &mut tree, 2.0), "restoring a valid bundle replaces live sheets")
  run Testing.expect(tree.needsFrameOf(0) && tree.needsFrameOf(1), "replacement schedules layout in every owned root")
  run Testing.expect(tree.styleSheets.length() == 2, "application updates never adopt into the inspector root")
  run tree.frameRoot(0, frame)
  run tree.frameRoot(1, frame)
  run Testing.expect(tree.node(tree.slotOf(1)).computed().layout.width.value == 40.0 && tree.node(tree.slotOf(2)).computed().layout.width.value == 40.0, "both roots retain the declared adoption order")
  run Testing.expect(tree.node(tree.slotOf(1)).computed().layout.height.value == 18.0, "all sheets in the valid set replace together")
  run Testing.expect(!run watch.pollWith(&mut assets, &mut tree, 2.5), "unchanged files leave computed styles cached")
  run batch.closeRoot(1)
  run batch.create(4, NodeKind.Box)
  run batch.openRoot(3, 4, RootOptions.default())
  run tree.apply(run batch.take())
  drop run assets.serve(&mut tree, 3)
  run tree.frameRoot(3, frame)
  run Testing.expect(tree.node(tree.slotOf(4)).computed().layout.width.value == 40.0, "later windows inherit the latest assets")
  let mut inactive = SheetWatch.make()
  run Testing.expect(!inactive.active() && inactive.wakeAfter(Option<f64>.None).isNone(), "release defaults do not poll files")
  run Testing.expect(!run inactive.pollWith(&mut assets, &mut tree, 3.0), "inactive watcher does not access the filesystem")
}

effect fn body() -> ()
  ! TreeError | CompileError | CssError | DecodeError | FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static> | HostInputError
  ? &mut Allocator | &mut FileSystem {
  let parent = run directory()
  let temporary = run FileSystem.temporaryDirectory(&parent, "silkui-sheet-update-")
  let path = run Path.joinUtf8(&temporary.path, b"styles.update")
  run exercise(&path) |> Effect.ensuring(FileSystem.releaseIgnored(move temporary))
}

test effect fn compiledUpdatesAreAtomicRootScopedAndRecoverable() -> ()
  ! TreeError | CompileError | CssError | DecodeError | FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static> | HostInputError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run allocated() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn allocated() -> ()
  ! TreeError | CompileError | CssError | DecodeError | FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static> | HostInputError
  ? &mut Allocator {
  let mut files = run MachineFileSystem.make()
  run body() |> Effect.provideMut<FileSystem>(&mut files)
}
