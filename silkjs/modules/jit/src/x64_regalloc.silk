//! Register allocation for x64_backend (docs/jit/ssa.md, "Register allocation"): linear scan
//! over one live interval per value, on the compacted, verified function.
//!
//! Order. Blocks are in reverse postorder; instruction i sits at position 2i + 2, its operands
//! and exit slots are read there and its result is written at 2i + 3. A block's parameters are
//! written at its start, 2 * firstInst + 1. Because lowering reads every operand into scratch
//! registers and writes the result last, after any exit, an operand whose interval ends where a
//! result's begins may share its register.
//!
//! Liveness is the usual backward pass over blocks in reverse order (Wimmer and Franz, "Linear
//! Scan Register Allocation on SSA Form"): a block's live-out is its successors' live-in plus
//! its edge arguments, and a value live into a loop header is live through the whole loop. Each
//! value then gets the hull of its live ranges, from its definition to its last live position:
//! coarse but safe, since a definition comes first in reverse postorder.
//!
//! Pools. Integers and bools take rbx, r12, r13, r14, r15: callee-saved, so they survive the
//! helper calls compiled code makes, and the prologue saves those it uses. Doubles take xmm2 to
//! xmm15. rax, rcx, rdx, rsi, rdi, r8 to r11 and xmm0, xmm1 stay with the lowering (scratch, and
//! the ABI's state, counter and stress words). A `value` (16 bytes) always lives in its slot.
//! A raw word (an Array's elements) takes an integer register, all 64 bits of it.
//! When a pool runs out, the interval that costs least in its slot is spilled there (weigh):
//! each write and read counts 8 to the power of its block's loop depth, less for an operand
//! arithmetic reads from memory as it is (exit slots, read only on the way out, count
//! nothing), and between equal weights the one that ends furthest away goes. A value live
//! across a call (an exit and a re-entry) is never given a register.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import asm_x64 { Alu, Assembler, Mem, PackedOp, Reg, ScalarOp, Width, Xmm }
import ssa { Function, Inst, Op, SlotMode, Type, NONE, ELEM_STEPS, FIELD_STEPS, edgeCount, readsK }
import silk.num.i32
import ssa_verify { readsA, readsB }
import ssa_ranges { mulRangeSafe, mulNoNegZero }

pub const SPILL: u8 = 0
pub const GPR: u8 = 1
pub const XMM: u8 = 2

/// Where a value lives for its whole life: its slot (`mem`) when `kind` is SPILL, else `gpr`
/// or `xmm`.
pub struct Place { pub kind: u8, pub gpr: Reg, pub xmm: Xmm, pub mem: Mem }
impl Copy for Place {}

/// A spilled place at mem.
pub fn spilled(mem: Mem) -> Place { return Place { kind: SPILL, gpr: Reg.Rax, xmm: Xmm.Xmm0, mem: mem } }

/// The outcome of `allocate`: one kind and register per value, and which callee-saved
/// integer registers the code uses.
pub struct Allocation {
  pub kinds: List<u8>,
  pub registers: List<u8>,
  /// Bit n: the pool's register n is used.
  pub savedMask: u32,
  /// Interval bounds, for the tests' checker.
  pub starts: List<u32>,
  pub ends: List<u32>,
  /// The integer registers the scan handed out.
  pub pool: Pool
}

const GPR_COUNT: usize = 8
const XMM_COUNT: usize = 14

/// The integer registers a scan hands out, in order: `count` of `registers`. Bit n of
/// overCalls: register n keeps its value over a call (Op.Call), so a value live across one
/// may take it. pollCalls: a poll may call out (callsOut), so no double lives across one.
/// fragile: register n is caller-saved and kept by none but the instructions keepsFragile
/// names: a value whose interval holds anything else does not take it.
pub struct Pool { pub registers: [Reg; 8], pub count: usize, pub overCalls: u32, pub pollCalls: bool, pub fragile: u32 }
impl Copy for Pool {}
/// x64_backend's: rbx, r12 to r15, none of them over a call (an exit and a re-entry).
pub fn entryPool() -> Pool { return Pool { registers: [Reg.Rbx, Reg.R12, Reg.R13, Reg.R14, Reg.R15, Reg.R15, Reg.R15, Reg.R15], count: 5, overCalls: 0, pollCalls: false, fragile: 0 } }
/// x64_frame's, on a baseline frame (r12 and r13 are pinned there): rbx, which every callee
/// restores, then r14 and r15, which baseline code and its stubs use freely, then rsi, rdi,
/// rdx, r10 and rcx, which only helper calls, frame services and instructions outside
/// keepsFragile touch (fragile; a shift by a register keeps rcx in r11). rax, r8 (an exit's
/// reason), r9 and r11 stay the lowering's own.
pub fn framePool() -> Pool { return Pool { registers: [Reg.Rbx, Reg.R14, Reg.R15, Reg.Rsi, Reg.Rdi, Reg.Rdx, Reg.R10, Reg.Rcx], count: 8, overCalls: 1, pollCalls: false, fragile: 248 } }

/// The integer pool, in the order the scan hands it out.
/// Entry mode's (entryPool), which holds five.
pub fn gprAt(index: usize) -> Reg {
  if index == 0 { return Reg.Rbx }
  if index == 1 { return Reg.R12 }
  if index == 2 { return Reg.R13 }
  if index == 3 { return Reg.R14 }
  return Reg.R15
}
pub fn gprCount() -> usize { return GPR_COUNT }
pub fn xmmAt(index: usize) -> Xmm {
  if index == 0 { return Xmm.Xmm2 }
  if index == 1 { return Xmm.Xmm3 }
  if index == 2 { return Xmm.Xmm4 }
  if index == 3 { return Xmm.Xmm5 }
  if index == 4 { return Xmm.Xmm6 }
  if index == 5 { return Xmm.Xmm7 }
  if index == 6 { return Xmm.Xmm8 }
  if index == 7 { return Xmm.Xmm9 }
  if index == 8 { return Xmm.Xmm10 }
  if index == 9 { return Xmm.Xmm11 }
  if index == 10 { return Xmm.Xmm12 }
  if index == 11 { return Xmm.Xmm13 }
  if index == 12 { return Xmm.Xmm14 }
  return Xmm.Xmm15
}

impl Allocation {
  /// The place of value v, whose slot is mem.
  pub fn place(self: &Self, v: u32, mem: Mem) -> Place {
    let kind = self.kinds.get(u32.toUsize(v))
    let index = u8.toUsize(self.registers.get(u32.toUsize(v)))
    if kind == GPR { return Place { kind: GPR, gpr: self.pool.registers[index], xmm: Xmm.Xmm0, mem: mem } }
    if kind == XMM { return Place { kind: XMM, gpr: Reg.Rax, xmm: xmmAt(index), mem: mem } }
    return spilled(mem)
  }
  /// The register index of v within its pool (meaningful when kind is not SPILL).
  pub fn register(self: &Self, v: u32) -> u8 { return self.registers.get(u32.toUsize(v)) }
  pub fn kind(self: &Self, v: u32) -> u8 { return self.kinds.get(u32.toUsize(v)) }
}

fn position(inst: u32) -> u32 { return inst * 2 + 2 }
fn blockStart(f: &Function, b: u32) -> u32 { return f.blocks.get(u32.toUsize(b)).firstInst * 2 + 1 }
fn blockEnd(f: &Function, b: u32) -> u32 {
  let block = f.blocks.get(u32.toUsize(b))
  return position(block.firstInst + block.instCount - 1)
}

struct Live { words: usize, bits: List<u64> }
impl Live {
  fn has(self: &Self, set: usize, v: u32) -> bool {
    let word = self.bits.get(set * self.words + u32.toUsize(v / 64))
    return u64.bitAnd(u64.shiftRight(word, u32.toU64(v % 64)), 1) != 0
  }
  fn put(self: &mut Self, set: usize, v: u32, on: bool) -> () {
    let index = set * self.words + u32.toUsize(v / 64)
    let bit = u64.shiftLeft(1, u32.toU64(v % 64))
    let word = self.bits.get(index)
    if on { self.bits.set(index, u64.bitOr(word, bit)) } else { self.bits.set(index, u64.bitAnd(word, u64.bitXor(bit, 18446744073709551615))) }
  }
  /// set |= other
  fn join(self: &mut Self, set: usize, other: usize) -> () {
    let mut w: usize = 0
    while w < self.words {
      let a = self.bits.get(set * self.words + w)
      let b = self.bits.get(other * self.words + w)
      self.bits.set(set * self.words + w, u64.bitOr(a, b))
      w = w + 1
    }
  }
}

fn extend(ends: &mut List<u32>, v: u32, end: u32) -> () {
  let index = u32.toUsize(v)
  if ends.get(index) == NONE || ends.get(index) < end { ends.set(index, end) }
}

/// Allocates registers for f, which must be compacted and verified.
pub effect fn allocate(f: &Function) -> Allocation ! OutOfMemoryError ? &mut Allocator {
  return run allocateIn(&f, entryPool())
}
/// allocate with the integer registers of pool.
pub effect fn allocateIn(f: &Function, pool: Pool) -> Allocation ! OutOfMemoryError ? &mut Allocator {
  let values = f.valueCount()
  let count = f.blockCount()
  let mut starts = List<u32>.make()
  run starts.appendRepeated(NONE, u32.toUsize(values))
  let mut ends = List<u32>.make()
  run ends.appendRepeated(NONE, u32.toUsize(values))
  // Definitions.
  let mut b: u32 = 0
  while b < count {
    let block = f.blocks.get(u32.toUsize(b))
    let mut p: u32 = 0
    while p < block.paramCount { starts.set(u32.toUsize(f.paramAt(block, p)), blockStart(&f, b)) p = p + 1 }
    let mut i = block.firstInst
    while i < block.firstInst + block.instCount {
      let inst = f.inst(i)
      if inst.result != NONE { starts.set(u32.toUsize(inst.result), position(i) + 1) }
      i = i + 1
    }
    b = b + 1
  }
  // Live sets: one per block (live-in) plus a working set at index count.
  let words = u32.toUsize(values / 64 + 1)
  let mut live = Live { words: words, bits: List<u64>.make() }
  run live.bits.appendRepeated(0, words * (u32.toUsize(count) + 1))
  let work = u32.toUsize(count)
  b = count
  while b > 0 {
    b = b - 1
    let block = f.blocks.get(u32.toUsize(b))
    let start = blockStart(&f, b)
    let end = blockEnd(&f, b)
    let mut w: usize = 0
    while w < words { live.bits.set(work * words + w, 0) w = w + 1 }
    let term = f.terminator(block)
    if term.edge != NONE {
      let mut e: u32 = 0
      while e < edgeCount(term.op) {
        let edge = f.edge(term.edge + e)
        if edge.target > b { live.join(work, u32.toUsize(edge.target)) }
        let mut g: u32 = 0
        while g < edge.argCount { live.put(work, f.edgeArg(edge, g), true) g = g + 1 }
        e = e + 1
      }
    }
    // Everything live out is live through the block, as far as its definition.
    let mut v: u32 = 0
    while v < values { if live.has(work, v) { extend(&mut ends, v, end) } v = v + 1 }
    let mut i = block.firstInst + block.instCount
    while i > block.firstInst {
      i = i - 1
      let inst = f.inst(i)
      if inst.result != NONE { live.put(work, inst.result, false) }
      let at = position(i)
      if readsA(inst.op) && inst.a != NONE { live.put(work, inst.a, true) extend(&mut ends, inst.a, at) }
      if readsB(inst.op) && inst.b != NONE { live.put(work, inst.b, true) extend(&mut ends, inst.b, at) }
      if readsK(inst.op) { let third = i32.wrappingToU32(inst.k) live.put(work, third, true) extend(&mut ends, third, at) }
      if inst.exit != NONE {
        let exit = f.exit(inst.exit)
        let mut s: u32 = 0
        while s < f.slotCount(exit) {
          let slot = f.slot(exit, s)
          if slot.mode == SlotMode.Virtual {
            let vo = f.virtualObjs.get(u32.toUsize(slot.value))
            let mut fk: u32 = 0
            while fk < vo.slotCount && fk < 8 {
              let fv = vo.fields[u32.toUsize(fk)]
              live.put(work, fv, true) extend(&mut ends, fv, at)
              fk = fk + 1
            }
          } else {
            let slotValue = slot.value
            live.put(work, slotValue, true) extend(&mut ends, slotValue, at)
          }
          s = s + 1
        }
      }
    }
    let mut p: u32 = 0
    while p < block.paramCount { live.put(work, f.paramAt(block, p), false) p = p + 1 }
    // A loop header: what is live into it is live to the end of its last back edge.
    let mut loopEnd: u32 = 0
    let mut s: u32 = b
    while s < count {
      let source = f.blocks.get(u32.toUsize(s))
      let st = f.terminator(source)
      if st.edge != NONE {
        let mut e: u32 = 0
        while e < edgeCount(st.op) { if f.edge(st.edge + e).target == b { loopEnd = blockEnd(&f, s) } e = e + 1 }
      }
      s = s + 1
    }
    v = 0
    while v < values {
      if live.has(work, v) {
        if loopEnd != 0 { extend(&mut ends, v, loopEnd) }
        extend(&mut ends, v, start)
      }
      v = v + 1
    }
    w = 0
    while w < words { let word = live.bits.get(work * words + w) live.bits.set(u32.toUsize(b) * words + w, word) w = w + 1 }
  }
  // A value nothing reads still needs somewhere to be written.
  let mut v: u32 = 0
  while v < values {
    let index = u32.toUsize(v)
    if ends.get(index) == NONE || ends.get(index) < starts.get(index) { ends.set(index, starts.get(index)) }
    v = v + 1
  }
  // A call is an exit and a re-entry (docs/jit/compiled-entry.md 7.3): no register survives
  // it, so a value live across one, or read by its exit, stays in its slot. A helper call
  // (callsOut) keeps the callee-saved integer pool but not xmm2 to xmm15.
  // In a pool with registers that last over a call (Pool.overCalls), an integer live across
  // one may take one of those (OVER_CALL).
  let mut across = List<u8>.make()
  run across.appendRepeated(ANYWHERE, u32.toUsize(values))
  let mut c: usize = 0
  while c < f.insts.length() {
    let inst = f.insts.get(c)
    let op = inst.op
    // On a baseline frame a field read that left before may call its getter
    // (x64_backend.getterCall), which baseline code's r14 and r15 do not survive.
    let exits = op == Op.Call || (pool.overCalls != 0 && op == Op.GetField && (inst.k & FIELD_STEPS) != 0)
    if exits || callsOutInst(inst, pool.overCalls != 0) || (pool.pollCalls && op == Op.Poll) {
      let at = position(usize.toU32(c))
      v = 0
      while v < values {
        let index = u32.toUsize(v)
        let crosses = starts.get(index) != NONE && starts.get(index) < at && ends.get(index) >= at
        if crosses && f.value(v).ty == Type.F64 { across.set(index, NOWHERE) }
        else if crosses && exits { if pool.overCalls == 0 { across.set(index, NOWHERE) } else { across.set(index, OVER_CALL) } }
        v = v + 1
      }
    }
    c = c + 1
  }
  // Whether each value's interval holds gentle instructions alone (Pool.fragile): a prefix
  // count of the others over the instructions, which an interval's positions index.
  let mut harsh = List<u32>.make()
  run harsh.append(0)
  c = 0
  while c < f.insts.length() {
    let before = harsh.get(c)
    if keepsFragile(f.insts.get(c)) { run harsh.append(before) } else { run harsh.append(before + 1) }
    c = c + 1
  }
  let mut calm = List<bool>.make()
  run calm.appendRepeated(false, u32.toUsize(values))
  if pool.fragile != 0 {
    v = 0
    while v < values {
      let index = u32.toUsize(v)
      let start = starts.get(index)
      if start != NONE {
        // From the instruction that defines v (a parameter: the one before its block, the
        // jump that writes it) to the last that reads it.
        let mut low: u32 = 0
        if start >= 3 { low = (start - 3) / 2 }
        let mut high = (ends.get(index) - 2) / 2
        if ends.get(index) < 2 { high = 0 }
        if u32.toUsize(high) >= f.insts.length() { high = usize.toU32(f.insts.length() - 1) }
        if low <= high { calm.set(index, harsh.get(u32.toUsize(high) + 1) == harsh.get(u32.toUsize(low))) }
      }
      v = v + 1
    }
  }
  let weights = run weigh(&f, &ends)
  return run scan(&f, move starts, move ends, &across, &calm, &weights, pool)
}
/// Instructions whose lowering touches neither rsi nor rdi and calls nothing (Pool.fragile):
/// integer arithmetic and compares, constants, boxes and unboxes of numbers, and the moves
/// of jumps and branches (rax, rcx, r8 to r11 and a scratch slot are theirs).
/// Whether a value in a fragile register lives through inst: a gentle instruction or an
/// `inline.frame`; a
/// `check.array`, a `check.bound` or an `elements`, or an element read a `check.array` proved (Inst.trusted), which leave
/// instead of calling out; a trusted element store, a poll or a `grow.bound`, which keep the
/// fragile registers over the call their slow path makes (x64_backend.keepFragile).
fn keepsFragile(inst: Inst) -> bool {
  // An inlined body's `inline.frame` (at each of its blocks) emits nothing.
  if gentle(inst.op) || inst.op == Op.CheckArray || inst.op == Op.CheckBound || inst.op == Op.GrowBound || inst.op == Op.Elements || inst.op == Op.Poll || inst.op == Op.CheckConstruct || inst.op == Op.InlineFrame { return true }
  return (inst.op == Op.GetElem && inst.trusted && inst.k == 0) || (inst.op == Op.PutElem && inst.trusted)
}
fn gentle(op: Op) -> bool {
  return op == Op.ConstI32 || op == Op.Imm || op == Op.Unbox || op == Op.UnboxBool || op == Op.BoxI32 || op == Op.BoxBool
    || op == Op.Add || op == Op.Sub || op == Op.Mul || op == Op.Imul || op == Op.Cmp || op == Op.BitAnd || op == Op.BitOr || op == Op.BitXor
    || op == Op.Shl || op == Op.Sar || op == Op.Shr || op == Op.BitNot || op == Op.Neg || op == Op.NotBool
    || op == Op.ConstF64 || op == Op.UnboxF64 || op == Op.BoxF64 || op == Op.ToF64
    || op == Op.AddF64 || op == Op.SubF64 || op == Op.MulF64 || op == Op.DivF64 || op == Op.CmpF64
    || op == Op.NegF64 || op == Op.SqrtF64 || op == Op.AbsF64 || op == Op.FloorF64
    || op == Op.ToInt32 || op == Op.ExactI32
    || op == Op.Jump || op == Op.Branch || op == Op.Removed
}
/// What a value's interval allows: any register of its pool, only one that lasts over a
/// call, or none.
const ANYWHERE: u8 = 0
const OVER_CALL: u8 = 1
const NOWHERE: u8 = 2

/// What each value costs in its slot, in quarter instructions: every write and read in block b
/// counts 8^depth(b), at most 8^6, times what a slot adds there. A write (the definition, or
/// a parameter's moves) adds a store and a read a load (4 each), but an operand that
/// arithmetic takes from memory as it is adds none, only a little time (1): the second
/// operand, or the first when it lives on and the result gets another place anyway. So a
/// value a loop only reads that way goes to its slot before one the loop carries around.
/// Loops are back edges s -> h with h <= s, their bodies the blocks h..s in reverse postorder.
effect fn weigh(f: &Function, ends: &List<u32>) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let count = f.blockCount()
  let mut depth = List<u32>.make()
  run depth.appendRepeated(0, u32.toUsize(count))
  let mut s: u32 = 0
  while s < count {
    let term = f.terminator(f.blocks.get(u32.toUsize(s)))
    if term.edge != NONE {
      let mut e: u32 = 0
      while e < edgeCount(term.op) {
        let h = f.edge(term.edge + e).target
        if h <= s {
          let mut b = h
          while b <= s { let d = depth.get(u32.toUsize(b)) depth.set(u32.toUsize(b), d + 1) b = b + 1 }
        }
        e = e + 1
      }
    }
    s = s + 1
  }
  let mut weights = List<u64>.make()
  run weights.appendRepeated(0, u32.toUsize(f.valueCount()))
  let mut b: u32 = 0
  while b < count {
    let block = f.blocks.get(u32.toUsize(b))
    let mut d = depth.get(u32.toUsize(b))
    if d > 6 { d = 6 }
    let heat = u64.shiftLeft(1, u32.toU64(3 * d))
    let mut p: u32 = 0
    while p < block.paramCount { addWeight(&mut weights, f.paramAt(block, p), heat * 4) p = p + 1 }
    let mut i = block.firstInst
    while i < block.firstInst + block.instCount {
      let inst = f.inst(i)
      let folds = fromMemory(inst.op)
      if readsA(inst.op) && inst.a != NONE {
        let mut cost: u64 = 4
        if folds && !compares(inst.op) && ends.get(u32.toUsize(inst.a)) > position(i) { cost = 1 }
        addWeight(&mut weights, inst.a, heat * cost)
      }
      if readsB(inst.op) && inst.b != NONE {
        let mut cost: u64 = 4
        if folds { cost = 1 }
        addWeight(&mut weights, inst.b, heat * cost)
      }
      if readsK(inst.op) { addWeight(&mut weights, i32.wrappingToU32(inst.k), heat * 4) }
      if inst.result != NONE { addWeight(&mut weights, inst.result, heat * 4) }
      if inst.edge != NONE {
        let mut e: u32 = 0
        while e < edgeCount(inst.op) {
          let edge = f.edge(inst.edge + e)
          let mut g: u32 = 0
          while g < edge.argCount { addWeight(&mut weights, f.edgeArg(edge, g), heat * 4) g = g + 1 }
          e = e + 1
        }
      }
      i = i + 1
    }
    b = b + 1
  }
  return move weights
}
/// Arithmetic whose lowering takes an operand from its slot as it is (aluWith, scalarWith).
fn fromMemory(op: Op) -> bool {
  return op == Op.Add || op == Op.Sub || op == Op.Mul || op == Op.BitAnd || op == Op.BitOr || op == Op.BitXor || compares(op)
    || op == Op.AddF64 || op == Op.SubF64 || op == Op.MulF64 || op == Op.DivF64
}
fn compares(op: Op) -> bool { return op == Op.Cmp || op == Op.CmpF64 }
fn addWeight(weights: &mut List<u64>, v: u32, heat: u64) -> () {
  let before = weights.get(u32.toUsize(v))
  weights.set(u32.toUsize(v), before + heat)
}

fn poolKind(double: bool) -> u8 { if double { return XMM } return GPR }

effect fn scan(f: &Function, starts: List<u32>, ends: List<u32>, across: &List<u8>, calm: &List<bool>, weights: &List<u64>, pool: Pool) -> Allocation ! OutOfMemoryError ? &mut Allocator {
  let values = f.valueCount()
  let mut kinds = List<u8>.make()
  run kinds.appendRepeated(SPILL, u32.toUsize(values))
  let mut registers = List<u8>.make()
  run registers.appendRepeated(0, u32.toUsize(values))
  // Hints: an edge argument and the parameter it becomes would rather share a register, so
  // the edge moves nothing (a loop's back edge most of all).
  let mut hints = List<u32>.make()
  run hints.appendRepeated(NONE, u32.toUsize(values))
  let mut e: usize = 0
  while e < f.edges.length() {
    let edge = f.edges.get(e)
    let target = f.blocks.get(u32.toUsize(edge.target))
    let mut g: u32 = 0
    while g < edge.argCount {
      let arg = f.edgeArg(edge, g)
      let into = f.paramAt(target, g)
      if hints.get(u32.toUsize(arg)) == NONE { hints.set(u32.toUsize(arg), into) }
      if hints.get(u32.toUsize(into)) == NONE { hints.set(u32.toUsize(into), arg) }
      g = g + 1
    }
    e = e + 1
  }
  // The result of arithmetic would rather take the register of an operand that ends there,
  // where the operation then runs in place (`operand`): the first operand's, or the second's
  // when the operands may change sides. Where they may not (a difference, a quotient), the
  // second operand's register is the one the result would rather not take (`shunned`): the
  // operation there goes through a scratch register and back.
  let mut operand = List<u32>.make()
  run operand.appendRepeated(NONE, u32.toUsize(values))
  let mut shunned = List<u32>.make()
  run shunned.appendRepeated(NONE, u32.toUsize(values))
  // A product that may overflow or be -0 leaves with both factors where they were, so it
  // would rather take neither's register (`shunned` and `aside`): in one of them it is
  // computed in a scratch register and moved. A product that can do neither runs in place.
  let mut aside = List<u32>.make()
  run aside.appendRepeated(NONE, u32.toUsize(values))
  let mut c: usize = 0
  while c < f.insts.length() {
    let inst = f.insts.get(c)
    let op = inst.op
    let sided = op == Op.SubF64 || op == Op.DivF64 || op == Op.Sub
    if (sided || op == Op.AddF64 || op == Op.MulF64 || op == Op.Add) && inst.result != NONE && inst.a != NONE && inst.b != NONE {
      let at = position(usize.toU32(c))
      if ends.get(u32.toUsize(inst.a)) == at { operand.set(u32.toUsize(inst.result), inst.a) }
      else if !sided && ends.get(u32.toUsize(inst.b)) == at { operand.set(u32.toUsize(inst.result), inst.b) }
      if sided { shunned.set(u32.toUsize(inst.result), inst.b) }
    }
    if op == Op.Mul && inst.result != NONE && inst.a != NONE && inst.b != NONE {
      let at = position(usize.toU32(c))
      if mulRangeSafe(f, inst.a, inst.b) && (inst.proven || mulNoNegZero(f, inst.a, inst.b)) {
        if ends.get(u32.toUsize(inst.a)) == at { operand.set(u32.toUsize(inst.result), inst.a) }
        else if ends.get(u32.toUsize(inst.b)) == at { operand.set(u32.toUsize(inst.result), inst.b) }
      } else { shunned.set(u32.toUsize(inst.result), inst.a) aside.set(u32.toUsize(inst.result), inst.b) }
    }
    c = c + 1
  }
  // Candidates by start, then value.
  let mut order = List<u64>.make()
  let mut v: u32 = 0
  while v < values {
    let ty = f.value(v).ty
    // A constant takes no register: its readers take it as an immediate, or from its slot.
    let def = f.value(v).def
    let constant = def != NONE && f.inst(def).op == Op.ConstI32
    if !constant && (ty == Type.I32 || ty == Type.Bool || ty == Type.F64 || ty == Type.Raw) && starts.get(u32.toUsize(v)) != NONE && across.get(u32.toUsize(v)) != NOWHERE {
      run order.append(u64.bitOr(u64.shiftLeft(u32.toU64(starts.get(u32.toUsize(v))), 32), u32.toU64(v)))
    }
    v = v + 1
  }
  run order.sort()
  // The value holding each register (integers first, then doubles), or NONE.
  let mut owners = List<u32>.make()
  run owners.appendRepeated(NONE, GPR_COUNT + XMM_COUNT)
  let mut saved: u32 = 0
  let mut k: usize = 0
  while k < order.length() {
    let v = u64.wrappingToU32(order.get(k))
    let start = starts.get(u32.toUsize(v))
    let double = f.value(v).ty == Type.F64
    let mut first: usize = 0
    let mut last = pool.count
    if double { first = GPR_COUNT last = GPR_COUNT + XMM_COUNT }
    // The registers this value may take: all of its pool, or those that last over a call.
    let mut allowed: u32 = u32.MAX
    if !double && across.get(u32.toUsize(v)) == OVER_CALL { allowed = pool.overCalls }
    if !double && !calm.get(u32.toUsize(v)) { allowed = u32.bitAnd(allowed, u32.bitXor(pool.fragile, u32.MAX)) }
    // Expire what ended before this start; take a free register, the first that is not the
    // shunned one.
    let mut shun = usize.MAX
    let other = shunned.get(u32.toUsize(v))
    if other != NONE && kinds.get(u32.toUsize(other)) == poolKind(double) { shun = first + u8.toUsize(registers.get(u32.toUsize(other))) }
    let mut shunToo = usize.MAX
    let second = aside.get(u32.toUsize(v))
    if second != NONE && kinds.get(u32.toUsize(second)) == poolKind(double) { shunToo = first + u8.toUsize(registers.get(u32.toUsize(second))) }
    let mut free = usize.MAX
    let mut r = first
    while r < last {
      let owner = owners.get(r)
      if owner != NONE && ends.get(u32.toUsize(owner)) < start { owners.set(r, NONE) }
      if owners.get(r) == NONE && (free == usize.MAX || free == shun || free == shunToo) && u32.bitAnd(u32.shiftRight(allowed, usize.toU32(r - first)), 1) != 0 { free = r }
      r = r + 1
    }
    // The register of the operand that ends here, then the hinted value's (which wins),
    // when that value is already placed in this pool and its register is free now.
    let mut pass: u32 = 0
    while pass < 2 {
      let mut hint = operand.get(u32.toUsize(v))
      if pass == 1 { hint = hints.get(u32.toUsize(v)) }
      if free != usize.MAX && hint != NONE && kinds.get(u32.toUsize(hint)) == poolKind(double) {
        let wanted = first + u8.toUsize(registers.get(u32.toUsize(hint)))
        if owners.get(wanted) == NONE && u32.bitAnd(u32.shiftRight(allowed, usize.toU32(wanted - first)), 1) != 0 { free = wanted }
      }
      pass = pass + 1
    }
    if free == usize.MAX {
      // Spill whichever of v and the holders is read least, then ends last.
      let mut furthest = usize.MAX
      let mut furthestEnd = ends.get(u32.toUsize(v))
      let mut lightest = weights.get(u32.toUsize(v))
      r = first
      while r < last {
        let owner = owners.get(r)
        if owner != NONE && u32.bitAnd(u32.shiftRight(allowed, usize.toU32(r - first)), 1) != 0 {
          let end = ends.get(u32.toUsize(owner))
          let weight = weights.get(u32.toUsize(owner))
          if weight < lightest || (weight == lightest && end > furthestEnd) { furthest = r furthestEnd = end lightest = weight }
        }
        r = r + 1
      }
      if furthest != usize.MAX {
        kinds.set(u32.toUsize(owners.get(furthest)), SPILL)
        free = furthest
      }
    }
    if free != usize.MAX {
      owners.set(free, v)
      let index = free - first
      if double { kinds.set(u32.toUsize(v), XMM) } else { kinds.set(u32.toUsize(v), GPR) saved = u32.bitOr(saved, u32.shiftLeft(1, usize.toU32(index))) }
      registers.set(u32.toUsize(v), usize.wrappingToU8(index))
    }
    k = k + 1
  }
  return Allocation { kinds: move kinds, registers: move registers, savedMask: saved, starts: move starts, ends: move ends, pool: pool }
}

// ---- reading and writing places ----

/// dst = the i32 or bool at p (zero-extended).
pub effect fn getI32(a: &mut Assembler, dst: Reg, p: Place) -> () ! OutOfMemoryError ? &mut Allocator {
  if p.kind == GPR { if p.gpr != dst { run a.mov(Width.W32, dst, p.gpr) } return () }
  run a.load(Width.W32, dst, p.mem)
}
/// p = the i32 or bool in src, which holds it zero-extended.
pub effect fn putI32(a: &mut Assembler, p: Place, src: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
  if p.kind == GPR { if p.gpr != src { run a.mov(Width.W32, p.gpr, src) } return () }
  run a.store(Width.W64, p.mem, src)
}
/// dst op= the i32 at p.
pub effect fn aluWith(a: &mut Assembler, op: Alu, dst: Reg, p: Place) -> () ! OutOfMemoryError ? &mut Allocator {
  if p.kind == GPR { run a.alu(op, Width.W32, dst, p.gpr) return () }
  run a.aluLoad(op, Width.W32, dst, p.mem)
}
/// dst = the double at p.
pub effect fn getF64(a: &mut Assembler, dst: Xmm, p: Place) -> () ! OutOfMemoryError ? &mut Allocator {
  if p.kind == XMM { if p.xmm != dst { run a.packed(PackedOp.Movapd, dst, p.xmm) } return () }
  run a.loadDouble(dst, p.mem)
}
/// p = the double in src.
pub effect fn putF64(a: &mut Assembler, p: Place, src: Xmm) -> () ! OutOfMemoryError ? &mut Allocator {
  if p.kind == XMM { if p.xmm != src { run a.packed(PackedOp.Movapd, p.xmm, src) } return () }
  run a.storeDouble(p.mem, src)
}
/// dst = the bits of the double at p.
pub effect fn getBits(a: &mut Assembler, dst: Reg, p: Place) -> () ! OutOfMemoryError ? &mut Allocator {
  if p.kind == XMM { run a.doubleToBits(dst, p.xmm) return () }
  run a.load(Width.W64, dst, p.mem)
}
/// p = the double whose bits are in src.
pub effect fn putBits(a: &mut Assembler, p: Place, src: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
  if p.kind == XMM { run a.bitsToDouble(p.xmm, src) return () }
  run a.store(Width.W64, p.mem, src)
}
/// dst = dst op the double at p (or op of it, for sqrt).
pub effect fn scalarWith(a: &mut Assembler, op: ScalarOp, dst: Xmm, p: Place) -> () ! OutOfMemoryError ? &mut Allocator {
  if p.kind == XMM { run a.scalar(op, dst, p.xmm) return () }
  run a.scalarLoad(op, dst, p.mem)
}

/// Whether lowering `op` calls a helper (x64_backend callHelper), which may change rax, rcx,
/// rdx, rsi, rdi, r8 to r11 and every xmm register.
pub fn callsOut(op: Op) -> bool {
  return op == Op.Release || op == Op.GetField || op == Op.PutField || op == Op.AtomValue || op == Op.GetVar
    || op == Op.PutVar || op == Op.GetScope || op == Op.PutScope || op == Op.GetKey || op == Op.GetElem || op == Op.PutElem || op == Op.PutKey
    || op == Op.GetLength || op == Op.Truthy || op == Op.TypeofAtom || op == Op.Typeof || op == Op.InstanceOf || op == Op.Equals || op == Op.ModF64 || op == Op.NewObject
}

/// Whether lowering `inst` can clobber xmm2..xmm15. In frame mode, cold slow paths for
/// Release, non-stepping GetElem, PutElem, non-stepping GetField, PutField, GetLength,
/// GetVar, and GetScope preserve allocated XMM registers via x64_backend.keepXmm/restoreXmm.
fn callsOutInst(inst: Inst, frameMode: bool) -> bool {
  let op = inst.op
  if frameMode {
    if op == Op.Release { return false }
    if op == Op.GetElem && inst.k != ELEM_STEPS { return false }
    if op == Op.PutElem { return false }
    if op == Op.GetField && (inst.k & FIELD_STEPS) == 0 { return false }
    if op == Op.PutField { return false }
    if op == Op.GetLength { return false }
    if op == Op.GetVar || op == Op.GetScope { return false }
  }
  return callsOut(op)
}
