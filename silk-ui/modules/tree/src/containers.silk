//! Container selection uses source ancestors and content-box geometry from the last layout.
import engine { UiTree }
import node { NONE, NO_INDEX }
import mutation { NodeKind, StyleState }
import style_sheets
import style
import layout.lib { Size, SizeContainment, WritingMode, BoxKind, FontRequest, LineHeight }
import properties.catalog { Property }
import properties.values { Value, Declaration }
import properties.values
import svg_css.written
import properties.convert
import properties.keywords { Keyword }
import svg_css.element { PseudoTarget }
import svg_css.media_features { Environment, QuerySize }
import svg_css.lexer
import svg_css.tokens { Limits, CssError, Kind, equal, insensitive }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32

fn named(tree: &UiTree<'_>, slot: u32, name: &[u8]) -> bool {
  if name.length == 0 { return true }
  if let Option.Some { value } = tree.node(slot).identity() {
    let mut i: usize = 0
    while i < value.containerNames().length {
      if equal(value.containerNames()[i].asSlice(), name) { return true }
      i = i + 1
    }
  }
  return false
}

pub fn contentSize(tree: &UiTree<'_>, slot: u32) -> Option<Size> {
  let node = tree.node(slot)
  if !node.rendered || node.computed().layout.display.isContents() || node.css >= tree.output.firstBySource.length() { return Option<Size>.None }
  let box = tree.output.firstBySource.get(node.css)
  if box == NO_INDEX || box >= tree.output.boxNodes.length() { return Option<Size>.None }
  let kind = tree.output.boxNodes.asSlice()[box].kind
  if kind == BoxKind.Inline || kind == BoxKind.Text { return Option<Size>.None }
  let content = tree.output.boxes.asSlice()[box].contentRect()
  return Option<Size>.some(Size { width: content.width, height: content.height })
}

/// Physical axes are 1/2; logical feature axes are 4/8 in the candidate's writing mode.
pub fn select(tree: &UiTree<'_>, subject: u32, pseudo: PseudoTarget, name: &[u8], axes: u32) -> Option<u32> {
  let mut slot = if pseudo == PseudoTarget.None { tree.node(subject).parent } else { subject }
  while slot != NONE {
    let node = tree.node(slot)
    if node.live && node.kind != NodeKind.Text && named(tree, slot, name) {
      if axes == 0 { return Option<u32>.some(slot) }
      let containment = node.computed().contain.query()
      let horizontal = node.computed().text.writingMode == WritingMode.HorizontalTb
      let width = containment == SizeContainment.Size || containment == SizeContainment.InlineSize && horizontal
      let height = containment == SizeContainment.Size || containment == SizeContainment.InlineSize && !horizontal
      if (axes & 1 == 0 || width) && (axes & 2 == 0 || height)
        && (axes & 4 == 0 || containment != SizeContainment.None)
        && (axes & 8 == 0 || containment == SizeContainment.Size)
        && contentSize(tree, slot).isSome() { return Option<u32>.some(slot) }
    }
    slot = node.parent
  }
  return Option<u32>.None
}

pub fn physicalUnit(tree: &UiTree<'_>, subject: u32, horizontal: bool) -> Option<f32> {
  return physicalUnitFor(tree, subject, PseudoTarget.None, horizontal)
}

pub fn physicalUnitFor(tree: &UiTree<'_>, subject: u32, pseudo: PseudoTarget, horizontal: bool) -> Option<f32> {
  let selected = select(tree, subject, pseudo, b"", if horizontal { 1 } else { 2 })
  if let Option<u32>.Some { value: slot } = selected {
    if let Option<Size>.Some { value } = contentSize(tree, slot) {
      return Option<f32>.some(if horizontal { value.width } else { value.height })
    }
  }
  return Option<f32>.None
}

fn unitDeclarations(list: &[Declaration]) -> bool {
  let mut i: usize = 0
  while i < list.length {
    if style.containerDependent(&list[i]) { return true }
    i = i + 1
  }
  return false
}

pub fn usesUnits(tree: &UiTree<'_>, slot: u32) -> bool {
  let node = tree.node(slot)
  if node.kind == NodeKind.Text { return false }
  if let Option.Some { value } = node.sheetStyle() {
    if unitDeclarations(value.declarations.asSlice()) || unitDeclarations(value.overrides.asSlice()) { return true }
    if let Option.Some { value: starting } = &value.starting {
      if unitDeclarations(starting.asSlice()) { return true }
    }
    return false
  }
  if unitDeclarations(node.base.asSlice()) || unitDeclarations(node.starting()) { return true }
  if node.hovered && unitDeclarations(node.hover()) { return true }
  if node.pressed && unitDeclarations(node.active()) { return true }
  if tree.focused == slot && (unitDeclarations(node.focus()) || unitDeclarations(node.focusVisible())) { return true }
  let overrides = tree.styleOverrides()
  let mut i: usize = 0
  while i < overrides.length {
    if overrides[i].id == node.id && unitDeclarations(overrides[i].declarations.asSlice()) { return true }
    i = i + 1
  }
  return false
}

pub fn query(tree: &UiTree<'_>, subject: u32, name: &[u8], axes: u32, pseudo: PseudoTarget) -> Option<Environment> {
  let selected = select(tree, subject, pseudo, name, axes)
  let slot = match selected { Option<u32>.Some { value } => value _ => { return Option<Environment>.None } }
  let node = tree.node(slot)
  let text = node.computed().text
  let mut environment = Environment.headless(f32.toF64(tree.cssWidth()), f32.toF64(tree.cssHeight()))
  let size = match contentSize(tree, slot) { Option<Size>.Some { value } => value _ => Size { width: 0.0, height: 0.0 } }
  // Queries compare CSS pixels: the container's zoomed box over its effective zoom.
  let zoom = f32.toF64(text.zoom)
  environment.querySize = Option<QuerySize>.some(QuerySize { width: f32.toF64(size.width) / zoom, height: f32.toF64(size.height) / zoom })
  let initial = &mut environment.initial
  initial.fontSize = f32.toF64(text.size)
  initial.vertical = text.writingMode != WritingMode.HorizontalTb
  initial.xHeight = initial.fontSize * 0.5
  initial.capHeight = initial.fontSize
  initial.zeroAdvance = initial.fontSize * 0.5
  initial.ideographAdvance = initial.fontSize
  let metrics = tree.provider.text.font(FontRequest { key: node.fontKey, writingMode: text.writingMode, textOrientation: text.textOrientation, direction: text.direction })
  if metrics.fontSize > 0.0 {
    initial.xHeight = f32.toF64(metrics.xHeight)
    initial.capHeight = f32.toF64(metrics.capHeight)
    initial.zeroAdvance = f32.toF64(metrics.zeroAdvance)
  }
  initial.lineHeight = match text.lineHeight {
    LineHeight.Number { value } => initial.fontSize * f32.toF64(value)
    LineHeight.Length { value } => f32.toF64(value)
    LineHeight.Normal => if metrics.fontSize > 0.0 { f32.toF64(metrics.ascent + metrics.descent + metrics.lineGap) } else { initial.fontSize }
  }
  if tree.root != NONE {
    let root = tree.node(tree.root)
    let rootText = root.computed().text
    let metrics = tree.provider.text.font(FontRequest { key: root.fontKey, writingMode: rootText.writingMode, textOrientation: rootText.textOrientation, direction: rootText.direction })
    initial.rootFontSize = f32.toF64(rootText.size)
    initial.rootXHeight = initial.rootFontSize * 0.5
    initial.rootCapHeight = initial.rootFontSize
    initial.rootZeroAdvance = initial.rootFontSize * 0.5
    initial.rootIdeographAdvance = initial.rootFontSize
    if metrics.fontSize > 0.0 {
      initial.rootXHeight = f32.toF64(metrics.xHeight)
      initial.rootCapHeight = f32.toF64(metrics.capHeight)
      initial.rootZeroAdvance = f32.toF64(metrics.zeroAdvance)
    }
    initial.rootLineHeight = match rootText.lineHeight {
      LineHeight.Number { value } => initial.rootFontSize * f32.toF64(value)
      LineHeight.Length { value } => f32.toF64(value)
      LineHeight.Normal => if metrics.fontSize > 0.0 { f32.toF64(metrics.ascent + metrics.descent + metrics.lineGap) } else { initial.rootFontSize }
    }
  }
  // Relative units in a query are computed on its selected container. Its own
  // ancestor containers supply CQ units, just as for a declaration on that box.
  if let Option<f32>.Some { value } = physicalUnit(tree, slot, true) { initial.containerWidth = Option<f64>.some(f32.toF64(value)) }
  if let Option<f32>.Some { value } = physicalUnit(tree, slot, false) { initial.containerHeight = Option<f64>.some(f32.toF64(value)) }
  if zoom != 1.0 {
    initial.fontSize = initial.fontSize / zoom
    initial.xHeight = initial.xHeight / zoom
    initial.capHeight = initial.capHeight / zoom
    initial.zeroAdvance = initial.zeroAdvance / zoom
    initial.ideographAdvance = initial.ideographAdvance / zoom
    initial.lineHeight = initial.lineHeight / zoom
    if let Option<f64>.Some { value } = initial.containerWidth { initial.containerWidth = Option<f64>.some(value / zoom) }
    if let Option<f64>.Some { value } = initial.containerHeight { initial.containerHeight = Option<f64>.some(value / zoom) }
  }
  if tree.root != NONE {
    let rootZoom = f32.toF64(tree.node(tree.root).computed().text.zoom)
    if rootZoom != 1.0 {
      initial.rootFontSize = initial.rootFontSize / rootZoom
      initial.rootXHeight = initial.rootXHeight / rootZoom
      initial.rootCapHeight = initial.rootCapHeight / rootZoom
      initial.rootZeroAdvance = initial.rootZeroAdvance / rootZoom
      initial.rootIdeographAdvance = initial.rootIdeographAdvance / rootZoom
      initial.rootLineHeight = initial.rootLineHeight / rootZoom
    }
  }
  initial.containerInlineSize = if initial.vertical { initial.containerHeight } else { initial.containerWidth }
  initial.containerBlockSize = if initial.vertical { initial.containerWidth } else { initial.containerHeight }
  return Option<Environment>.some(environment)
}

fn reserved(name: &[u8]) -> bool {
  return insensitive(name, b"none") || insensitive(name, b"and") || insensitive(name, b"or") || insensitive(name, b"not")
    || insensitive(name, b"default") || insensitive(name, b"initial") || insensitive(name, b"inherit")
    || insensitive(name, b"unset") || insensitive(name, b"revert") || insensitive(name, b"revert-layer")
}
effect fn invalidProjection(error: CssError) -> Option<Value> { drop error return Option<Value>.None }
pub effect fn typeOf(declaration: &Declaration) -> Option<Value> ! OutOfMemoryError ? &mut Allocator {
  return run Effect.catch<CssError>(written.longhand(declaration, Property.ContainerType), invalidProjection)
}
effect fn invalidNames(error: CssError) -> Option<List<Bytes>> { drop error return Option<List<Bytes>>.None }
effect fn parseNames(value: &Value) -> Option<List<Bytes>> ! CssError | OutOfMemoryError ? &mut Allocator {
  let css = run values.cssText(value)
  let buffer = run lexer.tokenize(css.asSlice(), &Limits.make())
  let mut names = List<Bytes>.make()
  let mut i: usize = 0
  while i < buffer.tokens.length() {
    let token = &buffer.tokens.asSlice()[i]
    match token.kind {
      Kind.Whitespace => {}
      Kind.Eof => {}
      Kind.Ident { text } => {
        let name = buffer.text(text)
        if reserved(name) { return Option<List<Bytes>>.None }
        run names.append(run Bytes.copy(name))
      }
      _ => { return Option<List<Bytes>>.None }
    }
    i = i + 1
  }
  if names.length() == 0 { return Option<List<Bytes>>.None }
  return Option<List<Bytes>>.some(move names)
}

effect fn applyNames(tree: &UiTree<'_>, parent: u32, list: &[Declaration], result: &mut List<Bytes>) ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < list.length {
    let declaration = &list[i]
    if declaration.property == Property.ContainerName || declaration.property == Property.Container || declaration.property == Property.All {
      let projected = if declaration.property == Property.ContainerName { Option<Value>.some(run values.clone(&declaration.value)) } else { run Effect.catch<CssError>(written.longhand(declaration, Property.ContainerName), invalidProjection) }
      if let Option<Value>.Some { value } = move projected {
        if convert.isKeyword(&value, Keyword.None) || convert.isKeyword(&value, Keyword.Initial) || convert.isKeyword(&value, Keyword.Unset) {
          result.clear()
        } else if convert.isKeyword(&value, Keyword.Inherit) {
          result.clear()
          if parent != NONE {
            if let Option.Some { value: identity } = tree.node(parent).identity() {
              let mut name: usize = 0
              while name < identity.containerNames().length {
                run result.append(run Bytes.copy(identity.containerNames()[name].asSlice()))
                name = name + 1
              }
            }
          }
        } else if let Option<List<Bytes>>.Some { value: names } = move run Effect.catch<CssError>(parseNames(&value), invalidNames) {
          result.* = move names
        }
      }
    }
    i = i + 1
  }
}

pub effect fn names(tree: &UiTree<'_>, slot: u32) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Bytes>.make()
  let node = tree.node(slot)
  if let Option.Some { value } = node.sheetStyle() {
    run applyNames(tree, node.parent, value.declarations.asSlice(), &mut result)
    run applyNames(tree, node.parent, value.overrides.asSlice(), &mut result)
  } else {
    let states = [StyleState.Base, StyleState.Hover, StyleState.Active, StyleState.Focus, StyleState.FocusVisible]
    let mut i: usize = 0
    while i < states.length {
      if style_sheets.active(tree, slot, states[i]) {
        let list = match states[i] {
          StyleState.Hover => node.hover()
          StyleState.Active => node.active()
          StyleState.Focus => node.focus()
          StyleState.FocusVisible => node.focusVisible()
          _ => node.base.asSlice()
        }
        let replaced = match tree.overrideOf(node.id, states[i]) { Option.Some { value } => value.replace _ => false }
        if !replaced { run applyNames(tree, node.parent, list, &mut result) }
      }
      i = i + 1
    }
    if tree.styleOverrides().length != 0 {
      i = 0
      while i < states.length {
        if style_sheets.active(tree, slot, states[i]) {
          if let Option.Some { value } = tree.overrideOf(node.id, states[i]) { run applyNames(tree, node.parent, value.declarations.asSlice(), &mut result) }
        }
        i = i + 1
      }
    }
  }
  return move result
}

pub fn sameNames(tree: &UiTree<'_>, slot: u32, names: &[Bytes]) -> bool {
  if let Option.Some { value } = tree.node(slot).identity() {
    if value.containerNames().length != names.length { return false }
    let mut i: usize = 0
    while i < names.length {
      if !equal(value.containerNames()[i].asSlice(), names[i].asSlice()) { return false }
      i = i + 1
    }
    return true
  }
  return names.length == 0
}
