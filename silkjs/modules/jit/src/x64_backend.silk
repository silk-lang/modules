  run emitter.slotsSetup(&function)
  b = 0
  while b < function.blockCount() {
    let block = function.blocks.get(u32.toUsize(b))
    emitter.current = b
    emitter.cachedArr = NONE
    emitter.scaled = NONE
    emitter.slotsValue = NONE
    if on && emitter.slotPreds.get(u32.toUsize(b)) != 0 && emitter.slotArrivals.get(u32.toUsize(b)) == emitter.slotPreds.get(u32.toUsize(b)) && emitter.entrySlots.get(u32.toUsize(b)) != SLOTS_MIXED {
      emitter.slotsValue = emitter.entrySlots.get(u32.toUsize(b))
    }
    emitter.a.bind(emitter.blockLabels.get(u32.toUsize(b)))
    if block.paramCount == 1 {
      // Every jump here left its lazy parameter in RAX and R9 (lazyStores).
      let first = function.paramAt(block, 0)
      if emitter.lazy.get(u32.toUsize(first)) { emitter.setFresh(first) emitter.unstored = first }
    }
    let mut i: u32 = 0
    while i < block.instCount {
      emitter.cursor = block.firstInst + i
      if emitter.settings.map { run offsets.append(usize.toU32(emitter.a.offset())) }
      if emitter.omitAt == block.firstInst + i { emitter.omitAt = NONE }
      else {
        // An instruction that emits nothing leaves R11 as it was.
        let slots = emitter.slotsValue
        let start = emitter.a.offset()
        let binds = emitter.a.bound()
        run emitter.instruction(&function, function.inst(block.firstInst + i))
        if emitter.slotsValue == NONE && emitter.a.offset() == start && emitter.a.bound() == binds { emitter.slotsValue = slots }
      }
      if emitter.skipAt == block.firstInst + i {
        let kept = emitter.skipSlots
        if emitter.skipOut {
          if kept != NONE {
            let fields = emitter.fields
            run emitter.a.load(Width.W64, Reg.R11, payloadOf(kept))
            run emitter.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectSlots)))
          }
          run emitter.a.jmp(emitter.skipLabel) run emitter.a.endOutlined() emitter.skipOut = false
        }
        emitter.a.bind(emitter.skipLabel) emitter.skipAt = NONE emitter.cachedArr = NONE emitter.scaled = NONE emitter.slotsValue = kept emitter.skipSlots = NONE
      }
      i = i + 1
    }
    b = b + 1
  }
  emitter.memFor = NONE
  // Everything after the hot blocks (cold edges, undo/zero stubs, cold slow paths, frame
  // tails, exit stubs and exit tables) belongs to the cold region in frame mode.
  if on { emitter.a.markCold() }
  let mut ce: usize = 0
  while ce < emitter.coldEdges.length() {
    let item = emitter.coldEdges.get(ce)
    emitter.a.bind(item.entry)
    run emitter.edgeThen(&function, item.edge, false)
    ce = ce + 1
  }
  let mut u: usize = 0
  while u < emitter.undoInsts.length() {
    let inst = emitter.undoInsts.get(u)
    emitter.a.bind(emitter.undoLabels.get(u))
    let mut back = Alu.Add
    if inst.op == Op.Add { back = Alu.Sub }
    let place = emitter.at(inst.result)
    run emitter.operate(back, place.gpr, inst.b)
    run emitter.a.jmp(emitter.exitLabels.get(u32.toUsize(inst.exit)))
    u = u + 1
  }
  // An operation on an element's number that overflowed: the exit reads the number from
  // its slot, and the first operand from where it was.
  let mut em: usize = 0
  while em < emitter.memInsts.length() {
    let inst = emitter.memInsts.get(em)
    let el = emitter.memElements.get(em)
    emitter.a.bind(emitter.memLabels.get(em))
    run emitter.a.load(Width.W32, Reg.Rax, el.at(8))
    let own = emitter.at(inst.b)
    run putI32(&mut emitter.a, own, Reg.Rax)
    if emitter.memUndo.get(em) {
      let mut back = Alu.Add
      if inst.op == Op.Add { back = Alu.Sub }
      let place = emitter.at(inst.result)
      run emitter.a.alu(back, Width.W32, place.gpr, Reg.Rax)
    }
    run emitter.a.jmp(emitter.exitLabels.get(u32.toUsize(inst.exit)))
    em = em + 1
  }
  let mut z: usize = 0
  while z < emitter.zeroInsts.length() {
    let inst = emitter.zeroInsts.get(z)
    emitter.a.bind(emitter.zeroLabels.get(z))
    if inst.op == Op.ToInt32 {
      let left = emitter.at(inst.a) let out = emitter.at(inst.result)
      run float.toInt32Slow(&mut emitter.a, left, out, emitter.zeroBacks.get(z))
      z = z + 1
      continue
    }
    let place = emitter.at(inst.a) run getI32(&mut emitter.a, Reg.R9, place)
    run emitter.operate(Alu.Or, Reg.R9, inst.b)
    run emitter.a.jcc(Cond.Sign, emitter.exitLabels.get(u32.toUsize(inst.exit)))
    run emitter.a.jmp(emitter.zeroBacks.get(z))
    z = z + 1
  }
  run emitter.coldPieces(&function)
  let mut ah: usize = 0
  while ah < emitter.addHashes.length() {
    let item = emitter.addHashes.get(ah)
    run emitter.addHashed(item)
    ah = ah + 1
  }
  // Emit deferred step/PutField slow paths before `outs` so any `releaseAt` inside
  // `getterCall`/`setterCall` has its `OUT_RELEASE` emitted by the loop below.
  let mut ss: usize = 0
  while ss < emitter.stepSlows.length() {
    let item = emitter.stepSlows.get(ss)
    run emitter.emitStepSlow(&function, item)
    ss = ss + 1
  }
  let mut o: usize = 0
  while o < emitter.outs.length() {
    let out = emitter.outs.get(o)
    run emitter.out(&function, out)
    o = o + 1
  }
  if on { run emitter.frameTails(&function) }
  // Exit stubs: the interpreter state at each exit's bytecode boundary.
  emitter.frameOf = 0
  let map = emitter.settings.map
  if map { run offsets.append(usize.toU32(emitter.a.offset())) }
  run exits.emit(&mut emitter, &function)
  // The construct entry's offset, placed with the map's.
  if on { run offsets.append(emitter.constructAt) }
  let finished = run emitter.a.finishPlacedSplit(&mut offsets, 1)
  let mut construct: u32 = 0
  if on { construct = offsets.get(offsets.length() - 1) drop offsets.pop() }
  if map {
    let mut line = List<u8>.make()
    run line.appendSlice(b"jit: optimized map")
    let mut m: usize = 0
    while m < offsets.length() { run line.append(32) run ssa.number(&mut line, offsets.get(m)) m = m + 1 }
    run line.append(10)
    io.stderr(line.asSlice())
  }
  if emitter.fault { return Lowering.Unsupported { reason: Unsupported { why: b"a plain store lost its element" } } }
  return match move finished {
    SplitCode { code, split } => Lowering.Code { value: move code, construct: construct, split: move split }
  }
}

/// The ABI inputs, in argument order: arguments, state, counter, data, env, frame.
pub const INPUT_COUNT: u32 = 6
pub const INPUT_ENV: u32 = 4
pub const INPUT_FRAME: u32 = 5
fn inputRegister(k: u32) -> Reg {
  if k == 0 { return Reg.Rdi }
  if k == 1 { return Reg.Rsi }
  if k == 2 { return Reg.Rdx }
  if k == 3 { return Reg.Rcx }
  if k == 4 { return Reg.R8 }
  return Reg.R9
}

/// The first reason function is outside what this backend lowers, or None.
fn supported(function: &Function, on: bool, stress: u32, steps: &List<u32>) -> Option<&'static [u8]> {
  if function.valueCount() > MAX_VALUES { return Option<&'static [u8]>.some(b"too many values") }
  if on && stress != 0 { return Option<&'static [u8]>.some(b"the stress configuration on a baseline frame") }
  let mut i: usize = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    if inst.op == Op.Removed { return Option<&'static [u8]>.some(b"uncompacted function") }
    // On a baseline frame the interpreter steps a generic instruction (stepOnFrame).
    if on && inst.op == Op.Call && calls.kindOf(inst) == compiled.SITE_CALL && (inst.k & calls.GENERIC) != 0 && (inst.frame != 0 || i >= steps.length() || steps.get(i) == 0) {
      return Option<&'static [u8]>.some(b"a generic instruction that is no plain step on a baseline frame")
    }
    if on && inst.op == Op.Call && calls.kindOf(inst) == compiled.SITE_CALL && (inst.k & calls.LAZY_ARGUMENTS) != 0 { return Option<&'static [u8]>.some(b"a lazy arguments call on a baseline frame") }
    if inst.op == Op.PutKey && (!on || inst.frame != 0) { return Option<&'static [u8]>.some(b"a keyed store off the function's own baseline frame") }
    if inst.op == Op.Call && calls.kindOf(inst) == compiled.SITE_ADD && (!on || inst.frame != 0) { return Option<&'static [u8]>.some(b"a concatenation off the function's own baseline frame") }
    if !on && (inst.op == Op.NewObject || inst.op == Op.InitSlot || inst.op == Op.CheckConstruct || inst.op == Op.KnownMethod || inst.op == Op.ConstVal) { return Option<&'static [u8]>.some(b"inlined construct or constant off a baseline frame") }
    if inst.op == Op.ConstVal && (inst.frame != 0 || inst.k < 0) { return Option<&'static [u8]>.some(b"constant load off own frame") }
    if !on && inst.op == Op.Call && calls.countOf(inst) > calls.MAX_COMPILED_ARGUMENTS { return Option<&'static [u8]>.some(b"too many call arguments off a baseline frame") }
    if !on && inst.op == Op.CallArg && i32.wrappingToU32(inst.k) >= calls.MAX_COMPILED_ARGUMENTS { return Option<&'static [u8]>.some(b"too many call arguments off a baseline frame") }
    if inst.op == Op.GetLength && inst.k == LENGTH_ARGUMENTS && (!on || inst.frame != 0) { return Option<&'static [u8]>.some(b"lazy arguments length off own baseline frame") }
    if inst.op == Op.GetElem && inst.k == ELEM_ARGUMENTS && (!on || inst.frame != 0) { return Option<&'static [u8]>.some(b"lazy arguments element off own baseline frame") }
    i = i + 1
  }
  if !on && function.virtualObjs.length() != 0 { return Option<&'static [u8]>.some(b"virtual object off a baseline frame") }
  if !on {
    let mut ti: usize = 0
    while ti < function.inlineTargets.length() {
      if u32.bitAnd(function.inlineTargets.get(ti), ssa.TARGET_KNOWN_FN) != 0 { return Option<&'static [u8]>.some(b"known function inline target off a baseline frame") }
      ti = ti + 1
    }
  }
  return Option<&'static [u8]>.none()
}

/// Whether frame-mode code needs `realmAt` populated (for polls, inlined frames, or constructs).
fn needsRealm(function: &Function) -> bool {
  if function.inlineTargets.length() != 0 || function.constructTargets.length() != 0 { return true }
  let mut i: usize = 0
  while i < function.insts.length() {
    let op = function.insts.get(i).op
    if op == Op.Poll || op == Op.CheckConstruct { return true }
    i = i + 1
  }
  return false
}

impl Emitter {
  pub fn saves(self: &Self, index: usize) -> bool { return u32.bitAnd(u32.shiftRight(self.places.savedMask, usize.toU32(index)), 1) != 0 }
  /// Where value v lives.
  fn at(self: &Self, v: u32) -> Place { return self.places.place(v, slotOf(v)) }
  /// Whether inline target k is a known local FunctionBytecode (ssa.TARGET_KNOWN_FN).
  fn scopedFn(self: &Self, k: u32) -> bool { return u32.toUsize(k) < self.scopedFns.length() && self.scopedFns.get(u32.toUsize(k)) }
  fn knownFn(self: &Self, k: u32) -> bool { return u32.toUsize(k) < self.knownFns.length() && self.knownFns.get(u32.toUsize(k)) }
  /// Whether lowering `given` in frame mode may safely consume or preserve the cached
  /// trusted fast-array `(cachedArr, r9 = elements, eax = elementCount)` without clobbering
  /// `rax`/`r9` or mutating array length/storage. Instructions with conditional `rax`/`r9`
  /// paths (non-fused GetElem, trustedStore) invalidate `cachedArr` on those paths
  /// themselves; an add or a sub whose result has no register works in R8 while EAX holds
  /// the count. For an access through `elements` (Op.Elements) that has no register,
  /// cachedArr is that value and R9 holds it.
  fn preservesArrCache(self: &Self, function: &Function, given: Inst) -> bool {
    let op = given.op
    if op == Op.AddF64 || op == Op.SubF64 || op == Op.MulF64 || op == Op.DivF64 || op == Op.SqrtF64
      || op == Op.ConstI32 || op == Op.Add || op == Op.Sub || op == Op.InlineFrame || op == Op.Removed { return true }
    if op == Op.GetElem && given.trusted && given.k == 0 { return true }
    if op == Op.PutElem && given.trusted { return true }
    if op == Op.BoxF64 || op == Op.BoxI32 || op == Op.BoxBool { return self.storedBox(function, self.cursor) }
    // Bit operations and shifts work in the result's register or RAX (a shift by a register
    // with rcx kept in R11). So does a product, but for its test of -0, whose piece after
    // the blocks takes R9.
    if op == Op.BitAnd || op == Op.BitOr || op == Op.BitXor || op == Op.Shl || op == Op.Sar || op == Op.Shr { return true }
    if op == Op.Mul && given.a != NONE && given.b != NONE {
      return given.proven || mulNoNegZero(function, given.a, given.b) || positiveConstant(self.constants.get(u32.toUsize(given.b))) > 0
    }
    return false
  }
  effect fn instruction(self: &mut Self, function: &Function, given: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let op = given.op
    self.frameOf = given.frame
    if !self.on || !self.preservesArrCache(&function, given) { self.cachedArr = NONE }
    self.slotsHeld = self.slotsValue
    if !self.on || !self.keepsSlots(&function, given) { self.slotsValue = NONE }
    if !r11Kept(&function, given) && !((op == Op.GetElem || op == Op.PutElem) && function.isElements(given.a)) { self.scaled = NONE }
    // Operands are read where their bits are (stored). A return asks whose count it hands
    // over, which is the copy's own: resultInto and valueInto find the bits themselves.
    let mut inst = given
    if self.on && op != Op.Return {
      if readsA(op) { inst.a = self.storage(inst.a) }
      if readsB(op) { inst.b = self.storage(inst.b) }
      if readsK(op) { inst.k = u32.wrappingToI32(self.storage(i32.wrappingToU32(inst.k))) }
    }
    if op == Op.CheckCallee {
      // A bytecode closure (tag, class) whose FunctionBytecode cell is the target's,
      // or a known local function (ValueBits.FunctionBytecode, tag -2) whose payload is the cell.
      run self.stressGuard(inst.exit)
      let layout = self.settings.layout
      let leave = self.exitLabels.get(u32.toUsize(inst.exit))
      if self.knownFn(i32.wrappingToU32(inst.k)) {
        run self.unlessTag(inst.a, layout.tagOf(-2), leave)
        let target = self.symbol(i32.wrappingToU32(inst.k) * 3)
        let fresh = self.isFresh(inst.a)
        run self.a.movSymbol(Reg.Rax, target)
        if fresh { run self.a.alu(Alu.Cmp, Width.W64, Reg.Rax, Reg.R9) } else { run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, payloadOf(inst.a)) }
        run self.a.jcc(Cond.NotEqual, leave)
        if self.scopedFn(i32.wrappingToU32(inst.k)) {
          // The body reads its scope: the one of the function's level on the frame's own
          // chain, which must be on the heap (a count; a scope still in its frame has
          // none), for an exit inside the body makes a closure that holds it
          // (x64_frame_exit). Rax is the function's cell.
          run self.a.load(Width.W32, Reg.R8, Mem.at(Reg.Rax, signed(self.plan.f.knownLevel)))
          run self.a.test(Width.W32, Reg.R8, Reg.R8)
          run self.a.jcc(Cond.Equal, leave)
          run self.ownScopeInto(Reg.R11)
          run self.levelScope(Reg.R11, Reg.R8, leave)
          run self.a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.R11, 0), 0)
          run self.a.jcc(Cond.Equal, leave)
        }
        return ()
      }
      run self.unlessTag(inst.a, layout.object(), leave)
      if self.exact(&function, i32.wrappingToU32(inst.k)) {
        // The one closure itself: an object at its address.
        let closure = self.symbol(i32.wrappingToU32(inst.k) * 3 + 2)
        let fresh = self.isFresh(inst.a)
        run self.a.movSymbol(Reg.Rax, closure)
        if fresh { run self.a.alu(Alu.Cmp, Width.W64, Reg.Rax, Reg.R9) } else { run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, payloadOf(inst.a)) }
        run self.a.jcc(Cond.NotEqual, leave)
        // A preset value holds no count from here on (presets): the read's goes back. It is
        // never the last: the code keeps the closure.
        if self.isPreset(inst.a) && function.value(inst.a).own == Own.Owned { run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rax, 0), 1) }
        return ()
      }
      run self.payloadInto(Reg.R11, inst.a)
      run self.a.loadZero16(Reg.Rax, Mem.at(Reg.R11, compiled.DIRECT_OBJECT_CLASS))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_BYTECODE_CLASS))
      run self.a.jcc(Cond.NotEqual, leave)
      let target = self.symbol(i32.wrappingToU32(inst.k) * 3)
      run self.a.movSymbol(Reg.Rax, target)
      run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, Mem.at(Reg.R11, compiled.DIRECT_CLOSURE_BYTECODE))
      run self.a.jcc(Cond.NotEqual, leave)
      return ()
    }
    if op == Op.IsCallee {
      // A test whose only reader is the branch right after it is that branch's flags.
      if self.fusedCallee(&function, inst) { return () }
      run self.a.movImm32(Reg.R9, 0)
      run self.calleeFlags(&function, inst)
      run self.a.setcc(Cond.Equal, Reg.R9)
      let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.R9)
      return ()
    }
    // An inlined callee's frame is built where a helper needs it (frameInto): the inline
    // paths read its code and runtime without one.
    // Each block of the body names the closure again, as the value it is there.
    if op == Op.InlineFrame { let held = self.closureSlot(inst.a, i32.wrappingToU32(inst.k)) self.inlineClosures.set(i32.toUsize(inst.k), held) return () }
    if op == Op.Arg {
      // The caller's argument cell, copied (borrowed: no count).
      let at = i32.wrappingToU32(inst.k) * SLOT_BYTES
      let mut cells = Reg.Rdi
      if self.on {
        // The frame's arguments: the caller's cells or its own copy (STUB_PROLOGUE).
        let p = self.plan
        cells = Reg.R8
        run self.a.load(Width.W64, Reg.R8, p.sf(p.f.argumentsData))
      }
      run self.a.load(Width.W64, Reg.Rax, word(cells, at))
      run self.a.load(Width.W64, Reg.R9, word(cells, at + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      return ()
    }
    if op == Op.ConstI32 {
      if self.onlyImmediate(inst.result) { return () }
      let out = self.at(inst.result)
      if out.kind == GPR { run self.a.movImm32(out.gpr, i32.wrappingToU32(inst.k)) return () }
      // In frame mode the slot was written where the function begins (enter).
      if self.on { return () }
      // Zero-extended, as i32 slots are: a negative constant takes two stores.
      if inst.k >= 0 { run self.a.storeImm(Width.W64, slotOf(inst.result), inst.k) return () }
      run self.a.storeImm(Width.W64, slotOf(inst.result), 0)
      run self.a.storeImm(Width.W32, slotOf(inst.result), inst.k)
      return ()
    }
    if op == Op.Imm {
      let layout = self.settings.layout
      run self.a.movImm64(Reg.Rax, layout.tagWord(immTag(&layout, inst.k)))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.storeImm(Width.W64, payloadOf(inst.result), immPayload(inst.k))
      return ()
    }
    if op == Op.Unbox {
      run self.stressGuard(inst.exit)
      if self.on && function.value(inst.a).def != NONE && function.inst(function.value(inst.a).def).op == Op.Imm {
        // An exit that is always taken (ssa_translate.sideExit: a throw, an instruction
        // outside the subset in on-stack-replacement code): the baseline code runs the
        // instruction. No speculation failed, so it does not count against the code.
        run self.a.movImm32(Reg.R8, leaving.HOW_DECLINED)
        run self.a.jmp(self.exitWith.get(u32.toUsize(inst.exit)))
        return ()
      }
      let tag = self.settings.layout.int()
      if inst.k == UNBOX_EXACT {
        // An Int, or a Float64 that is exactly an int32 and not -0 (the interpreter's numbers
        // are one kind): a loop's entry guard (ssa_opt_hoist), for a value made by double
        // arithmetic, which the loop's own unbox of it would have taken as a double add.
        let floatTag = self.settings.layout.float64()
        let float = run self.a.label()
        let done = run self.a.label()
        let exit = self.exitLabels.get(u32.toUsize(inst.exit))
        run self.unlessTag(inst.a, tag, float)
        run self.a.load(Width.W32, Reg.Rax, payloadOf(inst.a))
        run self.a.jmp(done)
        self.a.bind(float)
        run self.unlessTag(inst.a, floatTag, exit)
        run self.a.loadDouble(Xmm.Xmm0, payloadOf(inst.a))
        run self.a.doubleToInt(Width.W32, Reg.Rax, Xmm.Xmm0)
        run self.a.intToDouble(Width.W32, Xmm.Xmm1, Reg.Rax)
        run self.a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1)
        run self.a.jcc(Cond.Parity, exit)
        run self.a.jcc(Cond.NotEqual, exit)
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.NotEqual, done)
        run self.a.load(Width.W64, Reg.R8, payloadOf(inst.a))
        run self.a.test(Width.W64, Reg.R8, Reg.R8)
        run self.a.jcc(Cond.Sign, exit)
        self.a.bind(done)
        run self.a.mov(Width.W32, Reg.Rax, Reg.Rax)
        let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.Rax)
        return ()
      }
      run self.tagGuard(inst.a, tag, inst.exit)
      // A 32-bit load zero-extends: the place holds the i32.
      let out = self.at(inst.result)
      if out.kind == GPR && self.isFresh(inst.a) { run self.a.mov(Width.W32, out.gpr, Reg.R9) return () }
      if out.kind == GPR { run self.a.load(Width.W32, out.gpr, payloadOf(inst.a)) return () }
      run self.a.load(Width.W32, Reg.Rax, payloadOf(inst.a))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      return ()
    }
    if op == Op.UnboxBool {
      run self.stressGuard(inst.exit)
      let tag = self.settings.layout.boolean()
      run self.tagGuard(inst.a, tag, inst.exit)
      run self.a.loadZero8(Reg.Rax, payloadOf(inst.a))
      run self.a.aluImm(Alu.And, Width.W32, Reg.Rax, 1)
      let place101 = self.at(inst.result) run putI32(&mut self.a, place101, Reg.Rax)
      return ()
    }
    if op == Op.TagIs {
      // A test whose only reader is the branch right after it is that branch's flags.
      if self.fusedTag(&function, inst) { return () }
      let layout = self.settings.layout
      run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)))
      run self.a.movImm32(Reg.R9, 0)
      run self.a.movImm32(Reg.R10, 0)
