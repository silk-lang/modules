//! A screen's header: a back button and a title.
import loom.lib { Document, Node, Role }
import loom.css
import loom.css { px, Align, Keyword, FlexDirection }
import silk.core.option { Option }

/// A row with `title` and, when `back` is a message, a button before it that sends it. A
/// screen gives the message its `update` answers with `reporting(Action.Pop)`.
pub fn header<M>(h: &Document<M>, title: string, back: Option<M>) -> Node {
  let button = match move back {
    Option<M>.Some { value } => h.button(
      &[
        h.label("Back"),
        h.testId("back"),
        h.onClick(move value),
        h.style(
          &[
            css.paddingLeft(px(10.0)),
            css.paddingRight(px(10.0)),
            css.paddingTop(px(4.0)),
            css.paddingBottom(px(4.0)),
            css.fontSize(px(20.0)),
          ],
        ),
      ],
      &[h.text("\u{2039}")],
    )
    Option<M>.None => h.empty()
  }
  return h.row(
    &[
      h.style(
        &[
          css.display(Keyword.Flex),
          css.flexDirection(FlexDirection.Row),
          css.alignItems(Align.Center),
          css.columnGap(px(8.0)),
          css.minHeight(px(44.0)),
          css.paddingLeft(px(8.0)),
          css.paddingRight(px(12.0)),
          css.flexShrink(0.0),
        ],
      ),
    ],
    &[
      button,
      h.box(
        &[h.accessRole(Role.Heading), h.level(1), h.style(&[css.fontSize(px(16.0)), css.fontWeight(600.0)])],
        &[h.text(title)],
      ),
    ],
  )
}
