//! `fn.async(...)` of a `.silk` import: each `__ui.nativeStart` call runs the app's exported
//! Silk function on a thread of its own, and the window's loop hands the reply back to
//! JavaScript once the thread ends (see `ui_js_calls.natives`).
import ui_js.lib { Natives, NativeCall, Reply, StartedNative }
import ui_tree_window.background { Background }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

struct Running {
  token: u32,
  job: Background<NativeCall>,
}

/// A call that ended: its promise's token and what the function replied.
pub struct Finished {
  pub token: u32,
  pub reply: Reply,
}

/// The calls running on threads.
pub struct NativeJobs {
  running: List<Running>,
  /// Calls that could not start, answered on the next poll.
  refused: List<Finished>,
}

effect fn outOfMemory(error: OutOfMemoryError) -> () {
  drop error
}

/// Runs `call` on this thread: what a job's thread does.
fn ran(natives: Natives, call: NativeCall) -> NativeCall {
  let mut owned = move call
  let mut allocator = Allocator.systemAllocatorProvider()
  run Effect.catchAll(natives.call(&mut owned), outOfMemory)
    |> Effect.provideMut<Allocator>(&mut allocator)
  return move owned
}

impl NativeJobs {
  pub fn make() -> NativeJobs {
    return NativeJobs { running: List<Running>.make(), refused: List<Finished>.make() }
  }

  /// Whether a call is still running: the loop should come back for it.
  pub fn pending(self: &Self) -> bool {
    return self.running.length() != 0 || self.refused.length() != 0
  }

  /// Starts each of `started` on a thread of its own.
  pub effect fn start(self: &mut Self, started: List<StartedNative>, natives: Natives) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut calls = move started
    while calls.length() > 0 {
      let StartedNative { token, call } = calls.remove(0)
      let begun = run Effect.result(
        Background<NativeCall>.start(
          || -> NativeCall {
            return ran(natives, move call)
          },
        ),
      )
      match move begun {
        Result.Success { value } => {
          run self.running.append(Running { token: token, job: move value })
        }
        Result.Failure { error } => {
          drop error
          run self.refused.append(
            Finished {
              token: token,
              reply: Reply.Failed {
                message: run String.copy("could not start a thread for the Silk function"),
              },
            },
          )
        }
      }
    }
  }

  /// The calls that ended since the last poll, oldest first.
  pub effect fn finished(self: &mut Self) -> List<Finished>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut done = Intrinsic.replace(self.refused, List<Finished>.make())
    let mut at: usize = 0
    while at < self.running.length() {
      if !self.running.asSlice()[at].job.ready() {
        at = at + 1
        continue
      }
      let mut running = self.running.remove(at)
      match running.job.poll() {
        Option<NativeCall>.Some { value } => {
          run done.append(Finished { token: running.token, reply: move value.reply })
        }
        Option<NativeCall>.None => {}
      }
    }
    return move done
  }
}
