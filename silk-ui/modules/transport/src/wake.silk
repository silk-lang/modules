//! Cross-thread wakeup handles and parking waiters, backed by the system allocator.
//!
//! `WakeHandle` is a cheap, `Transferable + Concurrent` handle that producers call without
//! blocking (`WakeHandle.wake`) to end a consumer thread's sleep, whether that consumer sleeps on a
//! `Waiter` (`Parker`), an OS event loop callback (`Waker`), or both.
import silk.concurrency.sync { Parker, Unparker }
import silk.concurrency.thread { Concurrent, Transferable }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.usize

/// Wakes a waiting thread or event loop without blocking.
pub union WakeHandle {
  /// Does nothing when signaled.
  Noop,
  /// Calls a detached `extern "C"` callback with `token`.
  Callback { func: extern "C" fn(usize) -> (), token: usize },
  /// Unparks a [`Waiter`].
  Unpark { unparker: Unparker },
  /// Unparks a [`Waiter`] and also runs a detached `extern "C"` callback.
  UnparkAndCallback { unparker: Unparker, func: extern "C" fn(usize) -> (), token: usize },
}

impl Transferable for WakeHandle {}
impl Concurrent for WakeHandle {}

impl WakeHandle {
  /// A wake handle that does nothing.
  pub fn noop() -> WakeHandle {
    return WakeHandle.Noop
  }

  /// A wake handle that runs `func(token)` without blocking.
  pub fn callback(func: extern "C" fn(usize) -> (), token: usize) -> WakeHandle {
    return WakeHandle.Callback { func: func, token: token }
  }

  /// A wake handle that unparks `unparker`.
  pub fn unpark(unparker: Unparker) -> WakeHandle {
    return WakeHandle.Unpark { unparker: move unparker }
  }

  /// A wake handle that unparks `unparker` and also runs `func(token)`.
  pub fn combined(unparker: Unparker, func: extern "C" fn(usize) -> (), token: usize) -> WakeHandle {
    return WakeHandle.UnparkAndCallback { unparker: move unparker, func: func, token: token }
  }

  /// Signals the target thread or loop without blocking.
  pub fn wake(self: &Self) -> () {
    match &self.* {
      WakeHandle.Noop => ()
      WakeHandle.Callback { func, token } => {
        let call = func
        unsafe call(token)
      }
      WakeHandle.Unpark { unparker } => unparker.unpark()
      WakeHandle.UnparkAndCallback { unparker, func, token } => {
        unparker.unpark()
        let call = func
        unsafe call(token)
      }
    }
  }

  /// Returns another handle to the same wake target.
  pub fn clone(self: &Self) -> WakeHandle {
    return match &self.* {
      WakeHandle.Noop => WakeHandle.Noop
      WakeHandle.Callback { func, token } => WakeHandle.Callback { func: func, token: token }
      WakeHandle.Unpark { unparker } => WakeHandle.Unpark { unparker: unparker.clone() }
      WakeHandle.UnparkAndCallback { unparker, func, token } => WakeHandle.UnparkAndCallback {
        unparker: unparker.clone(),
        func: func,
        token: token,
      }
    }
  }
}

/// The sleeping end paired with one or more [`WakeHandle`]s.
pub struct Waiter {
  parker: Parker,
}

impl Transferable for Waiter {}

impl Waiter {
  /// Creates a new waiter backed by the system allocator.
  pub effect fn make() -> Waiter
    ! OutOfMemoryError {
    let mut heap = Allocator.systemAllocatorProvider()
    let parker = run Parker.make() |> Effect.provideMut<Allocator>(&mut heap)
    return Waiter { parker: move parker }
  }

  /// Returns a [`WakeHandle`] that wakes this waiter.
  pub fn handle(self: &Self) -> WakeHandle {
    return WakeHandle.Unpark { unparker: self.parker.unparker() }
  }

  /// Returns the underlying `Unparker` for this waiter.
  pub fn unparker(self: &Self) -> Unparker {
    return self.parker.unparker()
  }

  /// Sleeps until woken by a [`WakeHandle`], consuming any stored wakeup token.
  pub fn wait(self: &Self) -> () {
    static if Intrinsic.targetArchitecture() == "wasm32" {
      return ()
    } else {
      self.parker.park()
    }
  }

  /// Sleeps until woken or `timeoutNanos` nanoseconds pass. Returns whether a wakeup token was consumed.
  pub fn waitTimeout(self: &Self, timeoutNanos: u64) -> bool {
    static if Intrinsic.targetArchitecture() == "wasm32" {
      drop timeoutNanos
      return false
    } else {
      return self.parker.parkTimeout(timeoutNanos)
    }
  }
}
