//! Per-pass cache of finished cascades: scope ids stay valid only until the next root restyle.
//! A result depends on its parent only through the variable scope, whether there is a parent
//! to inherit from, and the parent's color, so equal elements under different parents share it.
import properties.census { Census }
import mutation { Declaration }
import properties.values
import svg_css.adopted { Candidate, Source, MatchedRule }
import style_sheets { Resolved }
import silk.mem.frozen { Frozen }
import svg_css.cascade
import svg_css.variables { ScopeId }
import svg_css.colors { ColorProgram }
import silk.color.rgba { Rgba }
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.collections.hash_map { HashMap }
import silk.collections.hash { Hash }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize

const LIMIT: usize = 4096
const SUBSTITUTION_LIMIT: usize = 4096

/// What a cascade result takes from the element's parent besides the variable scope.
pub struct Inherited { pub rooted: bool, pub color: Rgba<f32> }
impl Copy for Inherited {}

fn sameInherited(a: Inherited, b: Inherited) -> bool {
  return a.rooted == b.rooted && a.color.r == b.color.r && a.color.g == b.color.g && a.color.b == b.color.b && a.color.a == b.color.a
}

/// A sheet declaration after `var()` substitution, parsed, for every scope that gives its
/// variables the values `reads` (`Inputs.substitutionReads`).
pub struct Substituted {
  reads: List<u64>,
  sheet: usize,
  declaration: usize,
  pub value: Declaration,
  pub program: Option<ColorProgram>,
  next: usize,
}

struct Entry {
  scope: usize,
  parent: Inherited,
  candidates: List<Candidate>,
  inline: List<Declaration>,
  style: Frozen<Resolved>,
  next: usize,
}

/// The inputs of a result that is not in the cache yet. The node's finished style joins it.
pub struct Pending {
  pub scope: ScopeId,
  pub parent: Inherited,
  pub candidates: List<Candidate>,
  pub inline: List<Declaration>,
}

pub struct Cache {
  entries: List<Entry>,
  heads: HashMap<u64, usize>,
  substituted: List<Substituted>,
  substitutedHeads: HashMap<u64, usize>,
  /// Styles of a node's parts (`::before`, `::selection`, scrollbar parts, ...) resolved since
  /// the tree was made that read a variable or declare one. A caller reads it before and
  /// after the resolves it makes for a node to learn whether any of its parts did.
  pub variableUses: u64,
}

pub effect fn copy(source: &[Declaration]) -> List<Declaration> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<Declaration>.make()
  let mut i: usize = 0
  while i < source.length {
    run out.append(run values.cloneDeclaration(&source[i]))
    i = i + 1
  }
  return move out
}

fn substitutionKey(sheet: usize, declaration: usize, reads: &[u64]) -> u64 {
  let mut key = Hash.combine(Hash.mix(&Hash.seed(5381), usize.toU64(sheet)), usize.toU64(declaration))
  let mut i: usize = 0
  while i < reads.length {
    key = Hash.combine(key, reads[i])
    i = i + 1
  }
  return key
}

fn sameReads(a: &[u64], b: &[u64]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  return true
}

fn hash(scope: ScopeId, parent: Inherited, candidates: &[Candidate]) -> u64 {
  let mut result = Hash.mix(&Hash.seed(5347), usize.toU64(scope.index))
  result = Hash.combine(result, if parent.rooted { 1 } else { 0 })
  let mut i: usize = 0
  while i < candidates.length {
    match candidates[i].source {
      Source.Sheet { sheet, declaration } => {
        result = Hash.combine(result, usize.toU64(sheet))
        result = Hash.combine(result, usize.toU64(declaration))
      }
      Source.Inline { declaration } => {
        result = Hash.combine(result, 18446744073709551615)
        result = Hash.combine(result, usize.toU64(declaration))
      }
    }
    let specificity = candidates[i].priority.specificity
    result = Hash.combine(result, usize.toU64(specificity.ids))
    result = Hash.combine(result, usize.toU64(specificity.classes))
    result = Hash.combine(result, usize.toU64(specificity.types))
    i = i + 1
  }
  return result
}

fn sameSource(a: Source, b: Source) -> bool {
  return match a {
    Source.Sheet { sheet, declaration } => match b {
      Source.Sheet { sheet: otherSheet, declaration: otherDeclaration } => sheet == otherSheet && declaration == otherDeclaration
      _ => false
    }
    Source.Inline { declaration } => match b {
      Source.Inline { declaration: otherDeclaration } => declaration == otherDeclaration
      _ => false
    }
  }
}

fn same(entry: &Entry, scope: ScopeId, parent: Inherited, states: u32, reads: u32, candidates: &[Candidate], matches: &[MatchedRule], inline: &[Declaration]) -> bool {
  let style = entry.style.get()
  // Rules that matched without a declaration and state tests that failed still belong to the node.
  // What a match read decides who may take the record next (`style_share`).
  if style.states != states || style.reads != reads || style.matches.length() != matches.length { return false }
  if entry.scope != scope.index || !sameInherited(entry.parent, parent) || entry.candidates.length() != candidates.length || entry.inline.length() != inline.length { return false }
  let mut i: usize = 0
  while i < candidates.length {
    let previous = entry.candidates.asSlice()[i]
    if !sameSource(previous.source, candidates[i].source) || cascade.compare(previous.priority, candidates[i].priority) != 0 { return false }
    i = i + 1
  }
  i = 0
  while i < inline.length {
    if !values.sameDeclaration(&entry.inline.asSlice()[i], &inline[i]) { return false }
    i = i + 1
  }
  i = 0
  while i < matches.length {
    let previous = style.matches.asSlice()[i]
    if previous.sheet != matches[i].sheet || previous.rule != matches[i].rule { return false }
    i = i + 1
  }
  return true
}

impl Cache {
  pub effect fn census(self: &Self, out: &mut Census) -> () ! OutOfMemoryError ? &mut Allocator {
    run out.held("tree.sheet-cache.entries", self.entries.length(), self.entries.capacity(), Intrinsic.layoutOf<Entry>().bytes)
    let mut candidates: usize = 0
    let mut i: usize = 0
    while i < self.entries.length() {
      candidates = candidates + self.entries.asSlice()[i].candidates.capacity()
      i = i + 1
    }
    run out.held("tree.sheet-cache.entries.candidates", candidates, candidates, Intrinsic.layoutOf<Candidate>().bytes)
    run out.held("tree.sheet-cache.substituted", self.substituted.length(), self.substituted.capacity(), Intrinsic.layoutOf<Substituted>().bytes)
    run out.held("tree.sheet-cache.maps", self.heads.length() + self.substitutedHeads.length(), self.heads.bucketCount() + self.substitutedHeads.bucketCount(), 25)
  }

  pub fn make() -> Cache {
    return Cache { entries: List<Entry>.make(), heads: HashMap<u64, usize>.make(Hash.seed(5351)),
      substituted: List<Substituted>.make(), substitutedHeads: HashMap<u64, usize>.make(Hash.seed(5387)), variableUses: 0 }
  }

  pub fn reset(self: &mut Self) -> () {
    self.entries.truncate(0)
    self.heads.clear()
    self.substituted.truncate(0)
    self.substitutedHeads.clear()
  }

  /// The parsed value sheet declaration `declaration` had earlier in this pass in a scope that
  /// gave its variables the values `reads`.
  pub fn substitution(self: &Self, sheet: usize, declaration: usize, reads: &[u64]) -> Option<&Substituted> {
    let mut at = match self.substitutedHeads.get(substitutionKey(sheet, declaration, reads)) { Option.Some { value } => value _ => usize.MAX }
    while at != usize.MAX {
      let entry = &self.substituted.asSlice()[at]
      if entry.sheet == sheet && entry.declaration == declaration && sameReads(entry.reads.asSlice(), reads) { return Option<&Substituted>.some(entry) }
      at = entry.next
    }
    return Option<&Substituted>.None
  }

  pub effect fn keepSubstitution(self: &mut Self, sheet: usize, declaration: usize, reads: List<u64>, value: Declaration, program: Option<ColorProgram>) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    if self.substituted.length() == SUBSTITUTION_LIMIT { return () }
    let key = substitutionKey(sheet, declaration, reads.asSlice())
    let next = match self.substitutedHeads.get(key) { Option.Some { value: head } => head _ => usize.MAX }
    let index = self.substituted.length()
    run self.substituted.append(Substituted { reads: move reads, sheet: sheet, declaration: declaration, value: move value, program: move program, next: next })
    drop run self.substitutedHeads.insert(key, index)
  }

  pub fn find(self: &Self, scope: ScopeId, parent: Inherited, states: u32, reads: u32, candidates: &[Candidate], matches: &[MatchedRule], inline: &[Declaration]) -> Option<Frozen<Resolved>> {
    let mut at = match self.heads.get(hash(scope, parent, candidates)) { Option.Some { value } => value _ => usize.MAX }
    while at != usize.MAX {
      let entry = &self.entries.asSlice()[at]
      if same(entry, scope, parent, states, reads, candidates, matches, inline) { return Option<Frozen<Resolved>>.some(entry.style.clone()) }
      at = entry.next
    }
    return Option<Frozen<Resolved>>.None
  }

  pub effect fn insert(self: &mut Self, pending: Pending, style: Frozen<Resolved>) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    if self.entries.length() == LIMIT { return () }
    let key = hash(pending.scope, pending.parent, pending.candidates.asSlice())
    let next = match self.heads.get(key) { Option.Some { value } => value _ => usize.MAX }
    let entry = Entry { scope: pending.scope.index, parent: pending.parent, candidates: move pending.candidates,
      inline: move pending.inline, style: move style, next: next }
    let index = self.entries.length()
    run self.entries.append(move entry)
    drop run self.heads.insert(key, index)
  }
}
