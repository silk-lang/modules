    CipherState.TdesEcb { v } => {
      let mut n: usize = 0
      if unsafe blockFailed(v.finish(move out), &mut n) { return unsafe failWith(&mut c.*, if encrypt || noFinalBlock { b"error:1C80006B:Provider routines::wrong final block length" } else { b"error:1C800064:Provider routines::bad decrypt" }) }
      c.length = n
    }
    CipherState.TdesCbc { v } => {
      let mut n: usize = 0
      if unsafe blockFailed(v.finish(move out), &mut n) { return unsafe failWith(&mut c.*, if encrypt || noFinalBlock { b"error:1C80006B:Provider routines::wrong final block length" } else { b"error:1C800064:Provider routines::bad decrypt" }) }
      c.length = n
    }
    CipherState.BEcb { v } => {
      let mut n: usize = 0
      if unsafe blockFailed(v.finish(move out), &mut n) { return unsafe failWith(&mut c.*, if encrypt || noFinalBlock { b"error:1C80006B:Provider routines::wrong final block length" } else { b"error:1C800064:Provider routines::bad decrypt" }) }
      c.length = n
    }
    CipherState.BCbc { v } => {
      let mut n: usize = 0
      if unsafe blockFailed(v.finish(move out), &mut n) { return unsafe failWith(&mut c.*, if encrypt || noFinalBlock { b"error:1C80006B:Provider routines::wrong final block length" } else { b"error:1C800064:Provider routines::bad decrypt" }) }
      c.length = n
    }
    CipherState.OcbSeal { v } => {
      let length = x.authTagLength
      let mut n: usize = 0
      if ocbFailed(v.finish(move out, Slice.viewMut<u8>(&mut x.tag, 0, length)), &mut n) { return unsafe failWith(&mut c.*, b"") }
      x.tagLength = length
      c.length = n
    }
    CipherState.OcbOpen { v } => {
      let mut n: usize = 0
      if x.tagLength == 0 || ocbFailed(v.finish(move out, Slice.view<u8>(&x.tag, 0, x.tagLength)), &mut n) { return unsafe failWith(&mut c.*, b"") }
