//! Crypto and TLS over OpenSSL: the runtime's real `Crypto` and `Tls` capabilities.
//!
//! A program that provides them depends on this package, and so compiles OpenSSL; a program that
//! provides `EmptyCrypto` and `EmptyTls` does not.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjsruntime.ext.diagnostics_fatal { RuntimeHeap }
import silkjsruntime.ext.fs_async as fs_async
import silkjsruntime.ext.library_hooks { SecureOps, ThreadSetup }
import silkjsruntime.libs.core.capabilities { Crypto, Tls, Composition }
import silkjsruntime.libs.core.host { Services }
import ext.crypto_native
import ext.tls_native

/// OpenSSL behind `node:crypto` and `globalThis.crypto`.
pub struct OpenSslCrypto {
  state: ?*mut crypto_native.State,
}
impl Copy for OpenSslCrypto {}

impl OpenSslCrypto {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> OpenSslCrypto { return OpenSslCrypto { state: Pointer.null<crypto_native.State>() } }
  unsafe fn opened(self: &Self) -> *mut crypto_native.State {
    if Pointer.isNull<crypto_native.State>(self.state) { Intrinsic.trap("crypto executor is not initialized") }
    return unsafe Intrinsic.pointerRequalify<?*mut crypto_native.State, *mut crypto_native.State>(self.state)
  }
}

impl Crypto for OpenSslCrypto {
  static fn present() -> bool { return true }
  fn forWorker(self: &Self) -> Self { return OpenSslCrypto.make() }
  effect fn open(self: &mut Self, main: bool) -> () ! OutOfMemoryError {
    // The C entry points OpenSSL and the blocking pool call are emitted only when something takes them.
    crypto_native.keepExports()
    self.state = run crypto_native.open(main)
  }
  unsafe fn threadSetup(self: &Self) -> ThreadSetup {
    return ThreadSetup { data: unsafe Intrinsic.pointerReinterpret<?*mut crypto_native.State, ?*mut u8>(self.state), prepare: crypto_native.silkCryptoThreadSetup }
  }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, id: u32, io: *mut fs_async.State, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    // dispatch and submit configure the providers (crypto_native.configureFor).
    if id == 2100 { return run unsafe crypto_native.dispatch(&mut engine, context, unsafe self.opened(), argc, argv) }
    return run unsafe crypto_native.submit(&mut engine, context, unsafe self.opened(), io, argc, argv)
  }
  unsafe effect fn poll<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe crypto_native.poll(&mut engine, context, unsafe self.opened())
  }
  unsafe effect fn appendResources<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, array: ValueBits, index: &mut u32) -> ()
    ! JsException ? &mut Allocator {
    run unsafe crypto_native.appendResources(&mut engine, context, unsafe self.opened(), array, &mut index)
  }
  unsafe fn openHandles(self: &Self) -> usize {
    return match Pointer.nonNullMut<crypto_native.State>(self.state) {
      Option<*mut crypto_native.State>.Some { value } => unsafe crypto_native.openHandles(value)
      Option<*mut crypto_native.State>.None => 0
    }
  }
  unsafe fn close<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, io: *mut fs_async.State) -> () {
    match Pointer.nonNullMut<crypto_native.State>(self.state) {
      Option<*mut crypto_native.State>.Some { value } => {
        unsafe crypto_native.close(&mut engine, context, value, io)
        self.state = Pointer.null<crypto_native.State>()
      }
      Option<*mut crypto_native.State>.None => ()
    }
  }
}

/// OpenSSL behind `node:tls`, `node:https` and the network's native TLS sockets.
pub struct OpenSslTls {
  state: ?*mut tls_native.State,
}
impl Copy for OpenSslTls {}

impl OpenSslTls {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> OpenSslTls { return OpenSslTls { state: Pointer.null<tls_native.State>() } }
}

impl Tls for OpenSslTls {
  static fn present() -> bool { return true }
  fn secureOps(self: &Self) -> SecureOps { return tls_native.secureOps() }
  fn forWorker(self: &Self) -> Self { return OpenSslTls.make() }
  effect fn open(self: &mut Self, allocator: *mut RuntimeHeap) -> () ! OutOfMemoryError {
    tls_native.keepExports()
    self.state = run tls_native.open(allocator)
  }
  unsafe fn sessions(self: &Self) -> ?*mut u8 { return unsafe Intrinsic.pointerReinterpret<?*mut tls_native.State, ?*mut u8>(self.state) }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if Pointer.isNull<tls_native.State>(self.state) { Intrinsic.trap("TLS provider is not initialized") }
    let state = unsafe Intrinsic.pointerRequalify<?*mut tls_native.State, *mut tls_native.State>(self.state)
    return run unsafe tls_native.dispatch(&mut engine, context, state, argc, argv)
  }
  unsafe fn openHandles(self: &Self) -> usize {
    return match Pointer.nonNullMut<tls_native.State>(self.state) {
      Option<*mut tls_native.State>.Some { value } => unsafe tls_native.openHandles(value)
      Option<*mut tls_native.State>.None => 0
    }
  }
  unsafe fn close<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> () {
    match Pointer.nonNullMut<tls_native.State>(self.state) {
      Option<*mut tls_native.State>.Some { value } => {
        unsafe tls_native.close(&mut engine, context, value)
        self.state = Pointer.null<tls_native.State>()
      }
      Option<*mut tls_native.State>.None => ()
    }
  }
}
