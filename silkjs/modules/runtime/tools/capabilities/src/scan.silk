//! What a built-in's JavaScript names: every `require` and `import()` string, whether it runs when
//! the built-in loads or later inside a function, and every name it reads from the runtime's `host`.
//!
//! A tokenizer, not a parser: it knows strings, template literals, regular expression literals and
//! comments, and which braces open a function body. That is all the facts need. A built-in is a
//! function body (tools/embed.py wraps each in a factory), so its top level is depth zero.
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Copy }

/// One `require('x')` or `import('x')`.
pub struct Edge {
  pub specifier: Bytes,
  /// Inside a function: it runs when that function is called, not when the built-in loads.
  pub lazy: bool,
}

/// The facts of one file.
pub struct Facts {
  pub edges: List<Edge>,
  /// Calls of `require` whose argument is not a string literal, at load time and lazily.
  pub dynamicLoad: u32,
  pub dynamicLazy: u32,
  /// Names read from `host` (`host.x`, `c.host.x`, `const { x } = c.host`), once each.
  pub natives: List<Bytes>,
}

// What the previous significant token was, which decides whether `/` starts a regular expression.
const NONE: u8 = 0

const WORD: u8 = 1

const VALUE: u8 = 2

const PUNCT: u8 = 3

// Open frames.
const PAREN: u8 = 1

const BRACKET: u8 = 2

const BLOCK: u8 = 3

const FUNCTION: u8 = 4

const TEMPLATE: u8 = 5

// An arrow function's expression body: no bracket of its own; it ends at `,` `;` or a closer.
const ARROW: u8 = 6

// `{ a, b } =` after const, let or var: a pattern whose keys may be read from host.
const PATTERN: u8 = 7

struct Scanner<'s> {
  text: &'s [u8],
  at: usize,
  previous: u8,
  // The previous significant token's text, for words and punctuation.
  start: usize,
  end: usize,
  frames: List<u8>,
  // Per open parenthesis: whether `if`, `for`, `while`, `switch`, `catch` or `with` came before it.
  parens: List<bool>,
  // Whether the parenthesis just closed was such a control one.
  closedControl: bool,
  // Keys of the pattern just closed, and how far `= host` or `= x.host` has come after it.
  keys: List<Bytes>,
  pendingKeys: List<Bytes>,
  patternStage: u8,
}

fn isWordByte(byte: u8) -> bool {
  return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57)
    || byte == 95
    || byte == 36
    || byte >= 128
}

fn isWordStart(byte: u8) -> bool {
  return isWordByte(byte) && !(byte >= 48 && byte <= 57)
}

fn isSpace(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 11 || byte == 12
}

fn isOperator(byte: u8) -> bool {
  // = ! < > & | + - * % ^ ? : ~
  return byte == 61 || byte == 33 || byte == 60 || byte == 62 || byte == 38 || byte == 124
    || byte == 43
    || byte == 45
    || byte == 42
    || byte == 37
    || byte == 94
    || byte == 63
    || byte == 58
    || byte == 126
}

pub fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}

fn slice<'s>(text: &'s [u8], start: usize, end: usize) -> &'s [u8] {
  return Slice.view<u8>(text, start, end - start)
}

fn wordIs(scanner: &Scanner<'_>, word: &[u8]) -> bool {
  return scanner.previous == WORD && same(slice(scanner.text, scanner.start, scanner.end), word)
}

fn punctIs(scanner: &Scanner<'_>, punct: &[u8]) -> bool {
  return scanner.previous == PUNCT && same(slice(scanner.text, scanner.start, scanner.end), punct)
}

// A `/` here starts a regular expression rather than dividing.
fn regexAllowed(scanner: &Scanner<'_>) -> bool {
  if scanner.previous == NONE {
    return true
  }
  if scanner.previous == VALUE {
    return false
  }
  if scanner.previous == PUNCT {
    return !punctIs(scanner, b")") && !punctIs(scanner, b"]")
  }
  let words = [
    b"return",
    b"typeof",
    b"case",
    b"do",
    b"else",
    b"in",
    b"of",
    b"new",
    b"delete",
    b"void",
    b"throw",
    b"instanceof",
    b"yield",
    b"await",
  ]
  let mut at: usize = 0
  while at < words.length {
    if wordIs(scanner, words[at]) {
      return true
    }
    at = at + 1
  }
  return false
}

fn functionDepth(scanner: &Scanner<'_>) -> u32 {
  let mut depth: u32 = 0
  let frames = scanner.frames.asSlice()
  let mut at: usize = 0
  while at < frames.length {
    if frames[at] == FUNCTION || frames[at] == ARROW {
      depth = depth + 1
    }
    at = at + 1
  }
  return depth
}

fn top(scanner: &Scanner<'_>) -> u8 {
  let frames = scanner.frames.asSlice()
  if frames.length == 0 {
    return 0
  }
  return frames[frames.length - 1]
}

fn closeArrows(scanner: &mut Scanner<'_>) -> () {
  while top(&scanner.*) == ARROW {
    let _closed = scanner.frames.pop()
  }
}

// The next byte that is not space or a comment, from `at`, and where it is.
fn peek(text: &[u8], from: usize) -> usize {
  let mut at = from
  while at < text.length {
    if isSpace(text[at]) {
      at = at + 1
      continue
    }
    if text[at] == 47 && at + 1 < text.length && text[at + 1] == 47 {
      while at < text.length && text[at] != 10 {
        at = at + 1
      }
      continue
    }
    if text[at] == 47 && at + 1 < text.length && text[at + 1] == 42 {
      at = at + 2
      while at + 1 < text.length && !(text[at] == 42 && text[at + 1] == 47) {
        at = at + 1
      }
      at = at + 2
      continue
    }
    return at
  }
  return text.length
}

// The end of the string literal that starts at `from` (its opening quote).
fn stringEnd(text: &[u8], from: usize) -> usize {
  let quote = text[from]
  let mut at = from + 1
  while at < text.length {
    if text[at] == 92 {
      at = at + 2
      continue
    }
    if text[at] == quote {
      return at + 1
    }
    if text[at] == 10 {
      return at
    }
    at = at + 1
  }
  return text.length
}

// Scans template text from `from` (just after a backtick or a `${...}`'s closing brace). Returns
// where scanning goes on, and whether a `${` opened (true) or the template ended (false).
struct Resumed {
  at: usize,
  opened: bool
}

impl Copy for Resumed {}

fn templateText(text: &[u8], from: usize) -> Resumed {
  let mut at = from
  while at < text.length {
    if text[at] == 92 {
      at = at + 2
      continue
    }
    if text[at] == 96 {
      return Resumed { at: at + 1, opened: false }
    }
    if text[at] == 36 && at + 1 < text.length && text[at + 1] == 123 {
      return Resumed { at: at + 2, opened: true }
    }
    at = at + 1
  }
  return Resumed { at: text.length, opened: false }
}

effect fn addOnce(list: &mut List<Bytes>, name: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let items = list.asSlice()
  let mut at: usize = 0
  while at < items.length {
    if same(items[at].asSlice(), name) {
      return
    }
    at = at + 1
  }
  run list.append(run Bytes.copy(name))
}

// A string literal's text between its quotes, when it has no escapes worth decoding.
effect fn literal(text: &[u8], from: usize) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  if from >= text.length || (text[from] != 39 && text[from] != 34) {
    return Option<Bytes>.none()
  }
  let end = stringEnd(text, from)
  if end < from + 2 {
    return Option<Bytes>.none()
  }
  return Option<Bytes>.some(run Bytes.copy(slice(text, from + 1, end - 1)))
}

/// Scans one file.
pub effect fn scan(text: &[u8]) -> Facts
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut facts = Facts {
    edges: List<Edge>.make(),
    dynamicLoad: 0,
    dynamicLazy: 0,
    natives: List<Bytes>.make(),
  }
  let mut s = Scanner {
    text: text,
    at: 0,
    previous: NONE,
    start: 0,
    end: 0,
    frames: List<u8>.make(),
    parens: List<bool>.make(),
    closedControl: false,
    keys: List<Bytes>.make(),
    pendingKeys: List<Bytes>.make(),
    patternStage: 0,
  }
  while s.at < text.length {
    let byte = text[s.at]
    if isSpace(byte) {
      s.at = s.at + 1
      continue
    }

    // Comments.
    if byte == 47 && s.at + 1 < text.length && text[s.at + 1] == 47 {
      while s.at < text.length && text[s.at] != 10 {
        s.at = s.at + 1
      }
      continue
    }
    if byte == 47 && s.at + 1 < text.length && text[s.at + 1] == 42 {
      s.at = s.at + 2
      while s.at + 1 < text.length && !(text[s.at] == 42 && text[s.at + 1] == 47) {
        s.at = s.at + 1
      }
      s.at = s.at + 2
      continue
    }

    // Strings, templates and regular expressions are values.
    if byte == 39 || byte == 34 {
      s.at = stringEnd(text, s.at)
      s.previous = VALUE
      s.patternStage = 0
      continue
    }
    if byte == 96 {
      let resumed = templateText(text, s.at + 1)
      s.at = resumed.at
      if resumed.opened {
        run s.frames.append(TEMPLATE)
        s.previous = NONE
      } else {
        s.previous = VALUE
      }
      s.patternStage = 0
      continue
    }
    if byte == 47 && regexAllowed(&s) {
      let mut at = s.at + 1
      let mut inClass = false
      while at < text.length && text[at] != 10 {
        if text[at] == 92 {
          at = at + 2
          continue
        }
        if text[at] == 91 {
          inClass = true
        } else if text[at] == 93 {
          inClass = false
        } else if text[at] == 47 && !inClass {
          break
        }
        at = at + 1
      }
      at = at + 1
      while at < text.length && isWordByte(text[at]) {
        at = at + 1
      }
      s.at = at
      s.previous = VALUE
      s.patternStage = 0
      continue
    }
    if byte >= 48 && byte <= 57 {
      while s.at < text.length && (isWordByte(text[s.at]) || text[s.at] == 46) {
        s.at = s.at + 1
      }
      s.previous = VALUE
      s.patternStage = 0
      continue
    }
    if isWordStart(byte) {
      let start = s.at
      while s.at < text.length && isWordByte(text[s.at]) {
        s.at = s.at + 1
      }
      let word = slice(text, start, s.at)
      let member = punctIs(&s, b".")
      let afterFunction = wordIs(&s, b"function")
      let next = peek(text, s.at)
      if !member && !afterFunction
        && (same(word, b"require") || same(word, b"internalRequire") || same(word, b"import"))
        && next < text.length
        && text[next] == 40 {
        let lazy = functionDepth(&s) > 0 || same(word, b"import")
        match move run literal(text, peek(text, next + 1)) {
          Option<Bytes>.Some { value } => {
            let after = peek(text, stringEnd(text, peek(text, next + 1)))
            if after < text.length && (text[after] == 41 || text[after] == 44) {
              run facts.edges.append(Edge { specifier: move value, lazy: lazy })
            }
          }
          Option<Bytes>.None => {
            if !same(word, b"import") {
              if lazy {
                facts.dynamicLazy = facts.dynamicLazy + 1
              } else {
                facts.dynamicLoad = facts.dynamicLoad + 1
              }
            }
          }
        }
      }
      if same(word, b"host") {
        // host.x, host?.x and host['x'].
        if next < text.length && text[next] == 46 {
          let name = peek(text, next + 1)
          let mut end = name
          while end < text.length && isWordByte(text[end]) {
            end = end + 1
          }
          if end > name {
            run addOnce(&mut facts.natives, slice(text, name, end))
          }
        } else if next < text.length && text[next] == 91 {
          if let Option<Bytes>.Some { value } = run literal(text, peek(text, next + 1)) {
            run addOnce(&mut facts.natives, value.asSlice())
          }
        } else if s.patternStage == 2 || (s.patternStage == 4 && member) {
          // `const { a, b } = host` or `= c.host`: the pattern's keys are read from host.
          let keys = s.pendingKeys.asSlice()
          let mut at: usize = 0
          while at < keys.length {
            run addOnce(&mut facts.natives, keys[at].asSlice())
            at = at + 1
          }
        }
      }

      // The pattern's keys: words right after `{` or `,` inside it.
      if top(&s) == PATTERN && (punctIs(&s, b"{") || punctIs(&s, b",")) {
        run s.keys.append(run Bytes.copy(word))
      }
      if s.patternStage == 2 && !same(word, b"host") {
        s.patternStage = 3
      } else if s.patternStage != 3 {
        s.patternStage = 0
      }
      s.previous = WORD
      s.start = start
      s.end = s.at
      continue
    }

    // Punctuation.
    let start = s.at
    if byte == 63 && s.at + 1 < text.length && text[s.at + 1] == 46
      && !(s.at + 2 < text.length && text[s.at + 2] >= 48 && text[s.at + 2] <= 57) {
      // ?. is a member access.
      s.at = s.at + 2
      s.previous = PUNCT
      s.start = start + 1
      s.end = s.at
      if s.patternStage == 3 {
        s.patternStage = 4
      } else {
        s.patternStage = 0
      }
      continue
    }
    if byte == 46 && s.at + 2 < text.length && text[s.at + 1] == 46 && text[s.at + 2] == 46 {
      // A spread is not a member access.
      s.at = s.at + 3
      s.previous = PUNCT
      s.start = start
      s.end = s.at
      s.patternStage = 0
      continue
    }
    if isOperator(byte) {
      while s.at < text.length && isOperator(text[s.at]) {
        s.at = s.at + 1
      }
      let operator = slice(text, start, s.at)
      if same(operator, b"=>") {
        let next = peek(text, s.at)
        if next >= text.length || text[next] != 123 {
          run s.frames.append(ARROW)
        }
      }
      if same(operator, b"=") && s.patternStage == 1 {
        s.patternStage = 2
      } else {
        s.patternStage = 0
      }
      s.previous = PUNCT
      s.start = start
      s.end = s.at
      continue
    }
    s.at = s.at + 1
    if byte == 40 {
      let control = wordIs(&s, b"if") || wordIs(&s, b"for") || wordIs(&s, b"while")
        || wordIs(&s, b"switch")
        || wordIs(&s, b"catch")
        || wordIs(&s, b"with")
      run s.parens.append(control)
      run s.frames.append(PAREN)
    } else if byte == 91 {
      run s.frames.append(BRACKET)
    } else if byte == 123 {
      let kind = if punctIs(&s, b"=>") || (punctIs(&s, b")") && !s.closedControl) {
        FUNCTION
      } else if wordIs(&s, b"const") || wordIs(&s, b"let") || wordIs(&s, b"var") {
        PATTERN
      } else {
        BLOCK
      }
      if kind == PATTERN {
        s.keys.clear()
      }
      run s.frames.append(kind)
    } else if byte == 41 || byte == 93 || byte == 125 {
      closeArrows(&mut s)
      let closed = match s.frames.pop() {
        Option<u8>.Some { value } => value
        Option<u8>.None => 0
      }
      if byte == 41 {
        s.closedControl = match s.parens.pop() {
          Option<bool>.Some { value } => value
          Option<bool>.None => false
        }
      }
      if closed == TEMPLATE {
        let resumed = templateText(text, s.at)
        s.at = resumed.at
        if resumed.opened {
          run s.frames.append(TEMPLATE)
          s.previous = NONE
        } else {
          s.previous = VALUE
        }
        s.patternStage = 0
        continue
      }
      if closed == PATTERN {
        let keys = Intrinsic.replace(s.keys, List<Bytes>.make())
        let old = Intrinsic.replace(s.pendingKeys, move keys)
        drop old
        s.previous = PUNCT
        s.start = start
        s.end = s.at
        s.patternStage = 1
        continue
      }
    } else if byte == 44 || byte == 59 {
      closeArrows(&mut s)
    }
    if s.patternStage == 3 && byte == 46 {
      s.patternStage = 4
    } else {
      s.patternStage = 0
    }
    s.previous = PUNCT
    s.start = start
    s.end = s.at
  }
  return move facts
}
