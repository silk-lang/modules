unsafe fn pointerAt(list: *mut ?*mut u8, index: u32) -> ?*mut u8 { return unsafe Pointer.read<?*mut u8>(unsafe Pointer.atMut<?*mut u8>(unsafe Pointer.assumeManyMut<?*mut u8>(list), u32.toUsize(index))) }
unsafe fn countAt(list: *mut u32, index: u32) -> u32 { return unsafe Pointer.read<u32>(unsafe Pointer.atMut<u32>(unsafe Pointer.assumeManyMut<u32>(list), u32.toUsize(index))) }
// libuv's uv__udp_sendmsg: sends from the head of the queue in batches of 20.
unsafe fn udpSendQueued(udp: *mut u8) -> () {
  if isNull(unsafe ptr(udp, U_SEND_FIRST)) { return }
  let mut bufs: [?*mut u8; 20] = [Pointer.null<u8>(); 20]
  let mut counts: [u32; 20] = [0; 20]
  let mut addresses: [?*mut u8; 20] = [Pointer.null<u8>(); 20]
  while true {
    let mut n: usize = 0
    let mut q = unsafe ptr(udp, U_SEND_FIRST)
    while n < 20 && !isNull(q) {
      let request = unsafe nn(q)
      addresses[n] = unsafe offset(request, US_ADDRESS)
      counts[n] = unsafe get<u32>(request, US_NBUFS)
      bufs[n] = unsafe ptr(request, US_BUFS)
      q = unsafe ptr(request, US_NEXT)
      n = n + 1
    }
    let mut sent = unsafe sendMany(unsafe fdOf(udp), usize.toU32(n), Pointer.fromMutRef<?*mut u8>(&mut bufs[0]), Pointer.fromMutRef<u32>(&mut counts[0]), Pointer.fromMutRef<?*mut u8>(&mut addresses[0]))
    while sent > 0 {
      let request = unsafe popSend(udp)
      unsafe set<isize>(request, US_STATUS, usize.toIsize(unsafe countBufs(unsafe nn(unsafe ptr(request, US_BUFS)), u32.toUsize(unsafe get<u32>(request, US_NBUFS)))))
      unsafe pushSend(udp, U_DONE_FIRST, U_DONE_LAST, request)
      sent = sent - 1
    }
    if sent == 0 {
      if isNull(unsafe ptr(udp, U_SEND_FIRST)) { unsafe feed(udp) return }
      continue
    }
    if sent == -EAGAIN { return }
    // The error belongs to the first request, which the batch could not send.
    let failed = unsafe popSend(udp)
    unsafe set<isize>(failed, US_STATUS, i32.toIsize(sent))
    unsafe pushSend(udp, U_DONE_FIRST, U_DONE_LAST, failed)
    unsafe feed(udp)
    return
  }
}
/// libuv's uv_udp_send.
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_udp_send(request: *mut u8, udp: *mut u8, bufs: *const Buf, count: u32, address: ?*const u8, callback: Status) -> i32 {
  let length = unsafe checkBeforeSend(udp, address)
  if length < 0 { return length }
  if !Pointer.isNull<u8>(address) {
    let err = unsafe udpMaybeDeferredBind(udp, familyOf(unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(address)), 0)
    if err != 0 { return err }
  }
  // send_queue_count may be above 0 with an empty queue: failed requests wait to complete.
  let empty = unsafe get<usize>(udp, U_SEND_QUEUE_COUNT) == 0
  unsafe requestInit(unsafe loopOf(udp), request, UV_UDP_SEND)
  let storage = unsafe offset(request, US_ADDRESS)
  if Pointer.isNull<u8>(address) { let _cleared = unsafe memset(storage, 0, 128) unsafe setFamily(storage, AF_UNSPEC) }
  else { let _copied = unsafe memcpy(storage, unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(address), i32.toUsize(length)) }
  unsafe set<Status>(request, US_SEND_CB, callback)
  unsafe set<Status>(request, US_CB, callback)
  unsafe setPtr(request, US_HANDLE, udp)
  unsafe set<u32>(request, US_NBUFS, count)
