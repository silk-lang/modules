//! The bytecode image of a release host's bundle, in a file beside the program.
//!
//! A release host on the SilkJS runtime embeds its bundle's text. Run once with
//! `--silk-write-bundle-image <path>` (`silk build` does, after the host is in place),
//! it compiles that text into a bytecode image with the engine it links and writes the image
//! to the file. Every later launch maps the file and starts from it: nothing is parsed, and
//! each function's code stays in the file's pages until its first call, so a function never
//! called costs no memory at all.
//!
//! The file is this host's own: its header names the bundle it was written from (the text's
//! length and a hash of samples of it), and the engine turns away an image another engine
//! build wrote. A file that is missing, or is another host's, is ignored and the host starts
//! from the text.
import silkjs.js_libc_platform as platform
import node_runtime.runtime.session { moduleImageLoadable }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.num.i64

/// The file's name, beside the program.
pub const NAME: &'static [u8] = b"app.image"

const MAGIC: &'static [u8] = b"SILKUIBI"
const HEADER: usize = 24
const SAMPLES: usize = 64
const SAMPLE: usize = 4096

fn fold(hash: u64, bytes: &[u8]) -> u64 {
  let mut value = hash
  let mut at: usize = 0
  while at < bytes.length {
    value = u64.wrappingMultiply(value ^ u8.toU64(bytes[at]), 1099511628211)
    at = at + 1
  }
  return value
}

/// A hash of `source` that reads little of it: its length and evenly spaced samples, so a
/// launch that starts from the image does not page the embedded text in.
pub fn stamp(source: &[u8]) -> u64 {
  let mut hash: u64 = 14695981039346656037 ^ usize.toU64(source.length)
  if source.length <= SAMPLES * SAMPLE { return fold(hash, source) }
  let stride = (source.length - SAMPLE) / (SAMPLES - 1)
  let mut index: usize = 0
  while index < SAMPLES {
    hash = fold(hash, Slice.view<u8>(source, index * stride, SAMPLE))
    index = index + 1
  }
  return hash
}

fn word(bytes: &[u8], at: usize) -> u64 {
  let mut value: u64 = 0
  let mut index: usize = 8
  while index > 0 {
    index = index - 1
    value = u64.shiftLeft(value, 8) | u8.toU64(bytes[at + index])
  }
  return value
}

effect fn appendWord(bytes: &mut List<u8>, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut index: u64 = 0
  while index < 8 {
    run bytes.append(u64.wrappingToU8(u64.shiftRight(value, index * 8)))
    index = index + 1
  }
}

/// The file's bytes for `image`, the bytecode image of `source`.
pub effect fn assemble(source: &[u8], image: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = List<u8>.make()
  run bytes.reserveExact(HEADER + image.length)
  run bytes.appendSlice(MAGIC)
  run appendWord(&mut bytes, usize.toU64(source.length))
  run appendWord(&mut bytes, stamp(source))
  run bytes.appendSlice(image)
  return move bytes
}

static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
  @foreign(noCapture: .("path"))
  unsafe extern "C" fn open(path: *const u8, flags: i32, ...) -> i32
  unsafe extern "C" fn close(fd: i32) -> i32
  unsafe extern "C" fn lseek(fd: i32, offset: i64, whence: i32) -> i64
  unsafe extern "C" fn mmap(address: ?*mut u8, length: usize, protection: i32, flags: i32, fd: i32, offset: i64) -> ?*mut u8

  // O_RDONLY | O_CLOEXEC.
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    const OPEN_READ: i32 = 0x1000000
  } else {
    const OPEN_READ: i32 = 0x80000
  }

  /// The whole file at `path` (NUL terminated), mapped read only for the life of the
  /// process: its pages are the file's, read when touched and never the process's own.
  unsafe fn mapped(path: *const u8) -> ImageFile {
    let fd = unsafe open(path, OPEN_READ)
    if fd < 0 { return ImageFile.none() }
    let end = unsafe lseek(fd, 0, 2)
    if end <= 0 { let _closed = unsafe close(fd) return ImageFile.none() }
    let length = u64.toUsize(i64.toU64(end))
    // PROT_READ, MAP_PRIVATE.
    let mapping = unsafe mmap(Pointer.null<u8>(), length, 1, 2, fd, 0)
    let _closed = unsafe close(fd)
    let address = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(mapping)
    // MAP_FAILED is the all-ones address.
    if Pointer.address<u8>(address) == usize.MAX || Pointer.address<u8>(address) == 0 { return ImageFile.none() }
    return ImageFile { data: unsafe Intrinsic.pointerRequalify<*mut u8, ?*const u8>(address), length: length, held: List<u8>.make() }
  }
}

/// An image file's bytes, readable until the process ends.
pub struct ImageFile {
  data: ?*const u8,
  length: usize,
  /// The bytes themselves where the system has no file mapping here.
  held: List<u8>,
}

impl ImageFile {
  /// No file.
  pub fn none() -> ImageFile {
    return ImageFile { data: Pointer.null<u8>(), length: 0, held: List<u8>.make() }
  }

  /// The file at `path`, or none when it is not there or cannot be read.
  pub effect fn open(path: &[u8]) -> ImageFile ! OutOfMemoryError ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
      let mut named = List<u8>.make()
      run named.reserveExact(path.length + 1)
      run named.appendSlice(path)
      run named.append(0)
      return unsafe mapped(Pointer.fromRef<u8>(&named.asSlice()[0]))
    } else {
      let read = run Effect.result(platform.readFile(path))
      return match move read {
        Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Success { value } => ImageFile { data: Pointer.null<u8>(), length: value.length(), held: move value }
        Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Failure { error } => { drop error ImageFile.none() }
      }
    }
  }

  fn bytes(self: &Self) -> &[u8] {
    if self.held.length() != 0 { return self.held.asSlice() }
    if self.length == 0 { return &[] }
    let data = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(self.data)
    return unsafe Pointer.borrowMany<Self, u8>(&self.*, unsafe Pointer.assumeMany<u8>(data), self.length)
  }

  /// The bytecode image in the file when this host wrote it from `source` and its engine
  /// loads it; empty otherwise.
  pub fn image<'a>(self: &'a Self, source: &[u8]) -> &'a [u8] {
    let bytes = self.bytes()
    if bytes.length <= HEADER || Slice.view<u8>(bytes, 0, 8) != MAGIC { return &[] }
    if word(bytes, 8) != usize.toU64(source.length) || word(bytes, 16) != stamp(source) { return &[] }
    let image = Slice.view<u8>(bytes, HEADER, bytes.length - HEADER)
    if !moduleImageLoadable(image) { return &[] }
    return image
  }
}
