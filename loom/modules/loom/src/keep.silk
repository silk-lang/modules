// --- What a type is ---

static fn named<T>(name: string<'static>) -> bool {
  return Reflect.typeName<T>() == name
}

static fn leaf<T>() -> bool {
  let name = Reflect.typeName<T>()
  return name == "String" || name == "bool" || name == "u8" || name == "u16" || name == "u32"
    || name == "u64"
    || name == "usize"
    || name == "i8"
    || name == "i16"
    || name == "i32"
    || name == "i64"
    || name == "f32"
    || name == "f64"
}

static fn isList<T>() -> bool {
  let name = Reflect.typeName<T>()
  return StaticText.byteLength(name) > 5 && StaticText.slice(name, 0, 5) == "List<"
}

static fn isStruct<T>() -> bool {
  return Reflect.typeKind(Reflect.typeOf<T>()) == namedKind
}

static fn isUnion<T>() -> bool {
  return Reflect.typeKind(Reflect.typeOf<T>()) == unionKind
}

/// Whether every field of the struct is visible here, so that it can be built from them.
static fn open<T>() -> bool {
  return StaticText.byteLength(Reflect.privateField<T>()) == 0
}

static fn arity<U>(variant: Intrinsic.Variant<U>) -> usize {
  let mut count: usize = 0
  static for _field in Reflect.variantFields(variant) {
    count = count + 1
  }
  return count
}

// `Reflect.borrowFieldMut` and `Reflect.borrowVariantFieldMut` name no output lifetime, which
// dev.74 refuses where they are used (SEM0210).
fn fieldMut<'o, O, V>(owner: &'o mut O, static field: Intrinsic.Field<O, V>) -> &'o mut V {
  return Intrinsic.borrowFieldMut<O, V>(owner, field)
}

fn variantFieldMut<'o, U, V>(
  owner: &'o mut U,
  static variant: Intrinsic.Variant<U>,
  static field: Intrinsic.Field<U, V>,
) -> &'o mut V {
  // The callers test the variant first.
  unsafe {
    return Intrinsic.borrowVariantFieldMut<U, V>(owner, variant, field)
  }
}

struct Holder<'a, T> {
  pub item: &'a T,
}

struct Place<'a, T> {
  pub item: &'a mut T,
}

// --- Writing ---

effect fn leafWritten<T: Leaf>(value: &T, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Leaf.written(value, &mut out)
}

effect fn listWritten<T>(list: &List<T>, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let items = list.asSlice()
  run out.append("[")
  let mut i: usize = 0
  while i < items.length {
    if i != 0 {
      run out.append(",")
    }
    run write(&items[i], &mut out)
    i = i + 1
  }
  run out.append("]")
}

/// Writes `value` to `out` as JSON: a struct as an object of its `pub` fields, a union as one
/// with its variant under [`VARIANT_KEY`], a list as an array, and what does not fit as `null`.
pub effect fn write<T>(value: &T, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let holder = Holder<T> { item: value }

  // One turn, checked with the type `T` is (see `show.walk`).
  static for held in Reflect.fields<Holder<T>>() {
    let item = Reflect.borrowField(&holder, held).*
    static if leaf<T>() {
      run leafWritten(item, &mut out)
    } else {
      static if isList<T>() {
        run listWritten(item, &mut out)
      } else {
        static if isStruct<T>() {
          run out.append("{")
          let mut first = true
          static for field in Reflect.fields<T>() {
            if !first {
              run out.append(",")
            }
            first = false
            run quoted(&mut out, Reflect.fieldLabel(field))
            run out.append(":")
            run write(Reflect.borrowField(item, field), &mut out)
          }
          run out.append("}")
        } else {
          static if isUnion<T>() {
            static for variant in Reflect.variants<T>() {
              if Reflect.isVariant(item, variant) {
                run out.append("{")
                run quoted(&mut out, VARIANT_KEY)
                run out.append(":")
                run quoted(&mut out, Reflect.variantLabel(variant))
                static for field in Reflect.variantFields(variant) {
                  run out.append(",")
                  run quoted(&mut out, Reflect.fieldLabel(field))
                  run out.append(":")
                  run write(Reflect.borrowVariantField(item, variant, field), &mut out)
                }
                run out.append("}")
              }
            }
          } else {
            run out.append("null")
          }
        }
      }
    }
  }
}

/// `value` as JSON (see [`write`]).
pub effect fn encode<T>(value: &T) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = String.make()
  run write(value, &mut out)
  return move out
}

// --- Building a value that init did not make ---

effect fn leafBuilt<T: Leaf>(saved: Option<&Value>) -> Option<T>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move saved {
    Option<&Value>.Some { value } => run Leaf.read(value)
    Option<&Value>.None => Option<T>.some(Leaf.zero())
  }
}

effect fn listBuilt<E>(saved: Option<&Value>) -> Option<List<E>>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut list = List<E>.make()
  if let Option<&Value>.Some { value } = move saved {
    match &value.* {
      Value.Array { values } => {
        let items = values.asSlice()
        let mut i: usize = 0
        while i < items.length {
          match move run build<E>(Option<&Value>.some(&items[i])) {
            Option<E>.Some { value: item } => run list.append(move item)
            Option<E>.None => {
              return Option<List<E>>.none()
            }
          }
          i = i + 1
        }
      }
      _ => {
        return Option<List<E>>.none()
      }
    }
  }
  return Option<List<E>>.some(move list)
}

/// A list type, so that `build` can name its item type.
interface Listed {
  effect fn listed(saved: Option<&Value>) -> Option<Self> ! OutOfMemoryError ? &mut Allocator
}

impl<E> Listed for List<E> {
  effect fn listed(saved: Option<&Value>) -> Option<List<E>>
    ! OutOfMemoryError
    ? &mut Allocator {
    return run listBuilt<E>(saved)
  }
}

effect fn listedBuilt<L: Listed>(saved: Option<&Value>) -> Option<L>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Listed.listed(saved)
}

/// `saved` again: the callers look at it more than once.
fn again<'a>(saved: &Option<&'a Value>) -> Option<&'a Value> {
  return match &saved.* {
    Option.Some { value } => Option<&'a Value>.some(value)
    Option.None => Option<&'a Value>.none()
  }
}

effect fn fieldBuilt<O, V>(static field: Intrinsic.Field<O, V>, saved: Option<&Value>) -> Option<V>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run build<V>(Json.fieldAt(saved, Reflect.fieldLabel(field)))
}

/// The one slot of `buffer`, which may not hold a value yet.
unsafe fn slotOf<T>(buffer: &mut Intrinsic.RawBuffer<T>) -> *mut T {
  unsafe {
    return Pointer.fromMutRef(&mut RawBuffer.viewMut<T>(&mut buffer, 0, 1)[0])
  }
}

/// A struct whose fields are all visible, built field by field in storage of its own.
effect fn structBuilt<T>(saved: Option<&Value>) -> Option<T>
  ! OutOfMemoryError
  ? &mut Allocator {
  if let Option<&Value>.Some { value } = again(&saved) {
    match &value.* {
      Value.Object { .. } => {}
      _ => {
        return Option<T>.none()
      }
    }
  }
  let allocation = run Allocator.allocate(Layout.of<T>())
  let mut buffer = unsafe RawBuffer.from<T>(move allocation, 1)
  let slot = unsafe slotOf(&mut buffer)
  let mut written: usize = 0
  let mut failed = false
  static for field in Reflect.fields<T>() {
    if !failed {
      match move run fieldBuilt(field, again(&saved)) {
        Option.Some { value } => {
          let place = Pointer.fromMutRef(
            fieldMut(unsafe Pointer.borrowMut(&mut buffer, slot), field),
          )
          unsafe Pointer.put(place, move value)
          written = written + 1
        }
        Option.None => {
          failed = true
        }
      }
    }
  }
  if failed {
    // The storage is released without its value: drop the fields that were written.
    let mut at: usize = 0
    static for field in Reflect.fields<T>() {
      if at < written {
        unsafe Pointer.dropInPlace(
          Pointer.fromMutRef(fieldMut(unsafe Pointer.borrowMut(&mut buffer, slot), field)),
        )
      }
      at = at + 1
    }
    return Option<T>.none()
  }
  return Option<T>.some(unsafe Pointer.take(slot))
}

/// The field of `variant` at `ordinal`, built from `saved`.
effect fn variantField<U, V>(static field: Intrinsic.Field<U, V>, saved: Option<&Value>) -> Option<
  V
>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run build<V>(Json.fieldAt(saved, Reflect.fieldLabel(field)))
}

effect fn unionBuilt<T>(saved: Option<&Value>) -> Option<T>
  ! OutOfMemoryError
  ? &mut Allocator {
  // A union a saved struct does not have starts as its `None`, when it has one.
  let label = match again(&saved) {
    Option<&Value>.Some { value } => match move Json.asString(Json.field(value, VARIANT_KEY)) {
      Option<string>.Some { value: text } => text
      Option<string>.None => {
        return Option<T>.none()
      }
    }
    Option<&Value>.None => "None"
  }
  static for variant in Reflect.variants<T>() {
    if Reflect.variantLabel(variant) == label {
      let static count = arity(variant)
      static if count == 0 {
        return Option<T>.some(Reflect.makeVariant(variant, ()))
      }
      static if count == 1 {
        static for a in Reflect.variantFields(variant) {
          if let Option.Some { value: first } = move run variantField(a, again(&saved)) {
            return Option<T>.some(Reflect.makeVariant(variant, .(move first)))
          }
        }
      }
      static if count == 2 {
        static for a in Reflect.variantFields(variant) {
          static if Reflect.fieldOrdinal(a) == 0 {
            static for b in Reflect.variantFields(variant) {
              static if Reflect.fieldOrdinal(b) == 1 {
                if let Option.Some { value: first } = move run variantField(a, again(&saved)) {
                  if let Option.Some { value: second } = move run variantField(b, again(&saved)) {
                    return Option<T>.some(Reflect.makeVariant(variant, (move first, move second)))
                  }
                }
              }
            }
          }
        }
      }
      static if count == 3 {
        static for a in Reflect.variantFields(variant) {
          static if Reflect.fieldOrdinal(a) == 0 {
            static for b in Reflect.variantFields(variant) {
              static if Reflect.fieldOrdinal(b) == 1 {
                static for c in Reflect.variantFields(variant) {
                  static if Reflect.fieldOrdinal(c) == 2 {
                    if let Option.Some { value: first } = move run variantField(a, again(&saved)) {
                      if let Option.Some { value: second } = move run variantField(
                        b,
                        again(&saved),
                      ) {
                        if let Option.Some { value: third } = move run variantField(
                          c,
                          again(&saved),
                        ) {
                          return Option<T>.some(
                            Reflect.makeVariant(variant, (move first, move second, move third)),
                          )
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
      return Option<T>.none()
    }
  }
  return Option<T>.none()
}

/// A `T` from what [`write`] wrote, or what a field missing from a saved struct starts as;
/// none when the saved value does not fit `T`.
effect fn build<T>(saved: Option<&Value>) -> Option<T>
  ! OutOfMemoryError
  ? &mut Allocator {
  static for _held in Reflect.fields<Holder<T>>() {
    static if leaf<T>() {
      return run leafBuilt<T>(again(&saved))
    } else {
      static if isList<T>() {
        return run listedBuilt<T>(again(&saved))
      } else {
        static if isStruct<T>() {
          static if open<T>() {
            return run structBuilt<T>(saved)
          }
        } else {
          static if isUnion<T>() {
            return run unionBuilt<T>(saved)
          }
        }
      }
    }
  }
  return Option<T>.none()
}

// --- Restoring onto what init made ---

effect fn leafRestored<T: Leaf>(into: &mut T, saved: &Value, report: &mut Restored) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match move run Leaf.read(saved) {
    Option<T>.Some { value } => {
      into.* = move value
    }
    Option<T>.None => run report.miss()
  }
}

effect fn listRestored<E>(into: &mut List<E>, saved: &Value, report: &mut Restored) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let items = match &saved.* {
    Value.Array { values } => values.asSlice()
    _ => {
      return run report.miss()
    }
  }

  // Items past the ones init made are built first, so a list that does not fit stays whole.
  let mut more = List<E>.make()
  let mut i = into.length()
  while i < items.length {
    match move run build<E>(Option<&Value>.some(&items[i])) {
      Option<E>.Some { value } => run more.append(move value)
      Option<E>.None => {
        let at = run report.enterIndex(i)
        run report.miss()
        return run report.leave(at)
      }
    }
    i = i + 1
  }
  if into.length() > items.length {
    into.truncate(items.length)
  }
  let mut j: usize = 0
  while j < into.length() {
    let at = run report.enterIndex(j)
    run restoreInto(&mut into.asMutSlice()[j], &items[j], &mut report)
    run report.leave(at)
    j = j + 1
  }
  while more.length() > 0 {
    run into.append(more.remove(0))
  }
}

effect fn restoreInto<T>(into: &mut T, saved: &Value, report: &mut Restored) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut place = Place<T> { item: &mut into }
  static for held in Reflect.fields<Place<T>>() {
    let item = &mut fieldMut(&mut place, held).*.*
    static if leaf<T>() {
      run leafRestored(&mut item, saved, &mut report)
    } else {
      static if isList<T>() {
        run listRestored(&mut item, saved, &mut report)
      } else {
        static if isStruct<T>() {
          match &saved.* {
            Value.Object { .. } => {
              static for field in Reflect.fields<T>() {
                if let Option<&Value>.Some { value } = Json.field(
                  saved,
                  Reflect.fieldLabel(field),
                ) {
                  let at = run report.enter(Reflect.fieldLabel(field))
                  run restoreInto(fieldMut(&mut item, field), value, &mut report)
                  run report.leave(at)
                }
              }
            }
            _ => run report.miss()
          }
        } else {
          static if isUnion<T>() {
            let label = Json.asString(Json.field(saved, VARIANT_KEY)) |> Option<string>.unwrapOr("")
            let mut same = false
            static for variant in Reflect.variants<T>() {
              if Reflect.isVariant(&item.*, variant) && Reflect.variantLabel(variant) == label {
                same = true
                static for field in Reflect.variantFields(variant) {
                  if let Option<&Value>.Some { value } = Json.field(
                    saved,
                    Reflect.fieldLabel(field),
                  ) {
                    let at = run report.enter(Reflect.fieldLabel(field))
                    run restoreInto(variantFieldMut(&mut item, variant, field), value, &mut report)
                    run report.leave(at)
                  }
                }
              }
            }
            if !same {
              match move run build<T>(Option<&Value>.some(saved)) {
                Option<T>.Some { value } => {
                  item.* = move value
                }
                Option<T>.None => run report.miss()
              }
            }
          }
        }
      }
    }
  }
}

/// Writes `saved`, a value [`write`] wrote and since parsed, onto `into` (see [`restore`]).
pub effect fn restoreValue<T>(into: &mut T, saved: &Value) -> Restored
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut report = Restored.make()
  run restoreInto(&mut into, saved, &mut report)
  return move report
}

/// Writes the model saved in `saved` (what [`encode`] made) onto `into`, field by field. What
/// the report names kept the value it had.
pub effect fn restore<T>(into: &mut T, saved: &[u8]) -> Restored
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut report = Restored.make()
  match move run Effect.result(Json.parse(saved)) {
    Result<Value, JsonError | OutOfMemoryError>.Success { value } => run restoreInto(
      &mut into,
      &value,
      &mut report,
    )
    Result<Value, JsonError | OutOfMemoryError>.Failure { error } => {
      drop error
      run report.miss()
    }
  }
  return move report
}
