import engine { UiTree }
import node { Semantics, NONE }
import style_identity { NodeIdentity }
import selector_tree { SelectorTree }
import style_attributes { relationBit }
import svg_css.element { ElementTree, NO_ELEMENT }
import svg_css.tokens { equal }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

fn rootOf(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut at = slot
  while tree.node(at).parent != NONE { at = tree.node(at).parent }
  return at
}

fn target(tree: &UiTree<'_>, root: u32, id: &[u8]) -> u32 {
  let adapter = SelectorTree { tree: tree }
  let mut at = u32.toUsize(root)
  while at != NO_ELEMENT {
    if let Option<&NodeIdentity>.Some { value } = tree.node(usize.toU32(at)).identity() {
      if value.hasId && equal(String.utf8Bytes(value.id()), id) { return tree.node(usize.toU32(at)).id }
    }
    let child = adapter.firstChild(at)
    if child != NO_ELEMENT { at = child continue }
    while at != u32.toUsize(root) && adapter.nextSibling(at) == NO_ELEMENT { at = adapter.parent(at) }
    if at == u32.toUsize(root) { break }
    at = adapter.nextSibling(at)
  }
  return NONE
}

fn space(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13 }

pub effect fn literal(tree: &UiTree<'_>, slot: u32, name: string) -> Option<List<u32>>
  ! OutOfMemoryError ? &mut Allocator {
  let node = tree.node(slot)
  let enabled = match node.semanticsOf() {
    Option<&Semantics>.Some { value } => (value.literalRelations & relationBit(name)) != 0
    _ => false
  }
  if !enabled { return Option<List<u32>>.None }
  let mut found = List<u32>.make()
  if let Option<&NodeIdentity>.Some { value } = node.identity() {
    let attributes = value.attributes()
    let mut a: usize = 0
    while a < attributes.length {
      if String.view(&attributes[a].name) == name {
        let text = String.utf8Bytes(String.view(&attributes[a].value))
        let root = rootOf(tree, slot)
        let mut i: usize = 0
        while i < text.length {
          while i < text.length && space(text[i]) { i = i + 1 }
          let start = i
          while i < text.length && !space(text[i]) { i = i + 1 }
          if i != start {
            let id = target(tree, root, Slice.view(text, start, i - start))
            if id != NONE {
              let mut seen = false
              let mut j: usize = 0
              while j < found.length() { if found.asSlice()[j] == id { seen = true } j = j + 1 }
              if !seen { run found.append(id) }
            }
          }
        }
        break
      }
      a = a + 1
    }
  }
  return Option<List<u32>>.some(move found)
}
