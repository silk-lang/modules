//! The document's text selection, as Chromium makes it: an anchor and a focus, each a point
//! in the tree (a text node and a byte offset, or an element and a child index), the range
//! between them in tree order, and its ends found from where the pointer is on screen.
//!
//! A press on text places a collapsed selection, a drag moves the focus, a double click selects
//! a word and a triple click a paragraph (later moves extend by the same unit), and Shift with a
//! press extends. `user-select` decides what can be selected: `none` text is never highlighted
//! or copied, and a press on it starts nothing; an `all` element is selected whole.
//!
//! Offsets are UTF-8 byte offsets into a text node's text. Inputs keep their own selection
//! (see `edit`); here an input is one atomic piece of the document.
import engine { UiTree }
import node { NONE, NO_INDEX }
import mutation { NodeKind, Role, Position, Direction, LISTEN_SELECTION_CHANGE }
import node { Event, EventKind }
import ui_protocol.request { HostRequest }
import paint { borderBox }
import style { SELECT_NONE, SELECT_ALL, SELECT_CONTAIN }
import caret
import caret { Piece }
import cssom_view
import interact
import edit
import edit { Keymap }
import input { Input, MOD_SHIFT, MOD_CONTROL, MOD_ALT, MOD_META }
import style_identity { NodeIdentity }
import silk.core.option { Option }
import paint { paddingBox }
import scrollbar { userScrolls, usedOverflow }
import layout.lib { FragmentKind }
import properties.computed { DisplayOutside, DisplayInside, WhiteSpaceCollapse, Float }
import silk.collections.list { List }
import silk.geometry.rect { Rect }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.usize
import silk.text.segmentation
import silk.text.string { String }

/// A boundary point: in text node `slot` at byte `offset`, or in element `slot` before its
/// child `offset` (children counted without generated boxes). `id` tells a slot that was
/// reused for another node apart from the one the point was made in.
pub struct Point {
  pub slot: u32,
  pub id: u32,
  pub offset: usize,
}

impl Copy for Point {}

impl Point {
  pub fn none() -> Point { return Point { slot: NONE, id: 0, offset: 0 } }
  pub fn exists(self: &Self) -> bool { return self.slot != NONE }
  pub fn same(self: &Self, other: Point) -> bool {
    return self.slot == other.slot && self.offset == other.offset
  }
}

/// How a press selects: by character, word or paragraph.
pub const UNIT_NONE: u32 = 0
pub const UNIT_CHARACTERS: u32 = 1
pub const UNIT_WORDS: u32 = 2
pub const UNIT_PARAGRAPHS: u32 = 3

/// What of one text node (or one atomic node) the selection covers, for painting.
pub struct Selected {
  pub slot: u32,
  pub start: usize,
  pub end: usize,
  /// The selection goes on past the node's end: the line break after its last line is
  /// selected too.
  pub through: bool,
  /// An image, icon, canvas or input inside the selection, tinted whole.
  pub atomic: bool,
}

impl Copy for Selected {}

impl Selected {
  fn same(self: &Self, other: &Selected) -> bool {
    return self.slot == other.slot && self.start == other.start && self.end == other.end
      && self.through == other.through && self.atomic == other.atomic
  }
}

pub struct TextSelection {
  pub anchor: Point,
  pub focus: Point,
  /// The press under way: its unit, and the unit it selected first (a word, a paragraph), which
  /// the selection keeps covering while the pointer moves.
  pub unit: u32,
  pub pressStart: Point,
  pub pressEnd: Point,
  /// The covered nodes in slot order, rebuilt when the selection or the tree changes.
  pub selected: List<Selected>,
  /// The tree revision `selected` was built at, and whether the ends moved since.
  builtAt: u64,
  pub moved: bool,
  /// Where Shift with Up or Down keeps the focus across, as a caret does.
  preferredX: f32,
  hasPreferredX: bool,
  /// Whether the pointer of the press under way is past the edge of what it selects in, so
  /// frames scroll there.
  pub scrolling: bool,
  /// Counts changes of the ends; `report` queues a `selectionchange` when it moved past
  /// `reported`.
  pub changes: u64,
  reported: u64,
  /// The node a press started a new selection in, for `selectstart`, or NONE.
  startedAt: u32,
  /// Where the caret shows: the collapsed selection inside the focused editing host (see
  /// `focusedHost`), as a point in text where there is one; none otherwise.
  pub caret: Point,
}

impl TextSelection {
  pub fn make() -> TextSelection {
    return TextSelection {
      anchor: Point.none(),
      focus: Point.none(),
      unit: UNIT_NONE,
      pressStart: Point.none(),
      pressEnd: Point.none(),
      selected: List<Selected>.make(),
      builtAt: 0,
      moved: false,
      preferredX: 0.0,
      hasPreferredX: false,
      scrolling: false,
      changes: 0,
      reported: 0,
      startedAt: NONE,
      caret: Point.none(),
    }
  }

  /// Whether anything is selected (a collapsed selection is a caret and shows nothing).
  pub fn ranged(self: &Self) -> bool {
    return self.anchor.exists() && self.focus.exists() && !self.anchor.same(self.focus)
  }
}

/// The covered part of `slot`, or None. `selected` is sorted by slot.
pub fn find(selected: &List<Selected>, slot: u32) -> usize {
  let values = selected.asSlice()
  let mut low: usize = 0
  let mut high = values.length
  while low < high {
    let middle = (low + high) / 2
    if values[middle].slot < slot {
      low = middle + 1
    } else {
      high = middle
    }
  }
  if low < values.length && values[low].slot == slot { return low }
  return NO_INDEX
}

// Tree navigation over the nodes a DOM would have: generated boxes are left out.

fn slotIn(slots: &List<u32>, index: usize) -> u32 {
  if index < slots.length() { return slots.get(index) }
  return NONE
}

fn counted(tree: &UiTree<'_>, slot: u32) -> bool {
  return slot != NONE && !tree.node(slot).isGenerated()
}

fn firstChild(tree: &UiTree<'_>, slot: u32) -> u32 {
  let nodes = &tree.layout
  let mut child = nodes.firstChild(tree.node(slot).css)
  while child != NO_INDEX {
    let found = tree.slotOfCssNode(child)
    if counted(tree, found) { return found }
    child = nodes.nextSibling(child)
  }
  return NONE
}

fn nextSibling(tree: &UiTree<'_>, slot: u32) -> u32 {
  let nodes = &tree.layout
  let mut at = nodes.nextSibling(tree.node(slot).css)
  while at != NO_INDEX {
    let found = tree.slotOfCssNode(at)
    if counted(tree, found) { return found }
    at = nodes.nextSibling(at)
  }
  return NONE
}

/// The `index`th child of `slot`, or NONE past the last.
fn childAt(tree: &UiTree<'_>, slot: u32, index: usize) -> u32 {
  let mut child = firstChild(tree, slot)
  let mut i: usize = 0
  while child != NONE && i < index {
    child = nextSibling(tree, child)
    i = i + 1
  }
  return child
}

fn indexOf(tree: &UiTree<'_>, slot: u32) -> usize {
  let parent = tree.node(slot).parent
  if parent == NONE { return 0 }
  let mut child = firstChild(tree, parent)
  let mut i: usize = 0
  while child != NONE && child != slot {
    child = nextSibling(tree, child)
    i = i + 1
  }
  return i
}

fn childCount(tree: &UiTree<'_>, slot: u32) -> usize {
  let mut child = firstChild(tree, slot)
  let mut i: usize = 0
  while child != NONE {
    child = nextSibling(tree, child)
    i = i + 1
  }
  return i
}

fn isText(tree: &UiTree<'_>, slot: u32) -> bool { return tree.node(slot).kind == NodeKind.Text }

fn textLength(tree: &UiTree<'_>, slot: u32) -> usize {
  return String.byteLength(String.view(&tree.node(slot).text))
}

/// The point before or after node `slot` in its parent.
fn before(tree: &UiTree<'_>, slot: u32) -> Point {
  let parent = tree.node(slot).parent
  if parent == NONE { return at(tree, slot, 0) }
  return at(tree, parent, indexOf(tree, slot))
}

fn after(tree: &UiTree<'_>, slot: u32) -> Point {
  let parent = tree.node(slot).parent
  if parent == NONE { return at(tree, slot, childCount(tree, slot)) }
  return at(tree, parent, indexOf(tree, slot) + 1)
}

fn at(tree: &UiTree<'_>, slot: u32, offset: usize) -> Point {
  return Point { slot: slot, id: tree.node(slot).id, offset: offset }
}

/// Whether `point` still names a node of the current root, and an offset inside it.
fn valid(tree: &UiTree<'_>, point: Point) -> bool {
  if point.slot == NONE || u32.toUsize(point.slot) >= tree.nodes.length() { return false }
  let node = tree.node(point.slot)
  if !node.live || node.id != point.id { return false }
  let mut top = point.slot
  while tree.node(top).parent != NONE { top = tree.node(top).parent }
  return top == tree.root
}

/// `point` clamped to its node: a text offset onto a character boundary of the text as it is
/// now, a child index onto the children there are.
fn clamped(tree: &UiTree<'_>, point: Point) -> Point {
  let mut out = point
  if isText(tree, point.slot) {
    let text = String.view(&tree.node(point.slot).text)
    let length = String.byteLength(text)
    if out.offset > length { out.offset = length }
    while out.offset > 0 && !String.isCharBoundary(text, out.offset) { out.offset = out.offset - 1 }
  } else {
    let count = childCount(tree, point.slot)
    if out.offset > count { out.offset = count }
  }
  return out
}

/// The ancestors of `slot` from the root down, `slot` last, each as its index in its parent.
effect fn path(tree: &UiTree<'_>, slot: u32, out: &mut List<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let mut at = slot
  while tree.node(at).parent != NONE {
    run out.append(indexOf(tree, at))
    at = tree.node(at).parent
  }
  // Reverse into root-first order.
  let values = out.asMutSlice()
  let mut i: usize = 0
  let mut j = values.length
  while i + 1 < j {
    j = j - 1
    let kept = values[i]
    values[i] = values[j]
    values[j] = kept
    i = i + 1
  }
}

/// Tree order of two points: -1, 0 or 1. A point is its node's path with its offset after it;
/// a path that is a prefix of another comes first, as an element's point before child `k` is
/// before everything inside that child.
pub effect fn compare(tree: &UiTree<'_>, a: Point, b: Point) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  if a.slot == b.slot {
    if a.offset < b.offset { return -1 }
    if a.offset > b.offset { return 1 }
    return 0
  }
  let mut left = List<usize>.make()
  let mut right = List<usize>.make()
  run path(tree, a.slot, &mut left)
  run path(tree, b.slot, &mut right)
  run left.append(a.offset)
  run right.append(b.offset)
  let l = left.asSlice()
  let r = right.asSlice()
  let mut i: usize = 0
  while i < l.length && i < r.length {
    if l[i] < r[i] { return -1 }
    if l[i] > r[i] { return 1 }
    i = i + 1
  }
  if l.length < r.length { return -1 }
  if l.length > r.length { return 1 }
  return 0
}

// What styles say.

fn userSelect(tree: &UiTree<'_>, slot: u32) -> u8 { return tree.node(slot).computed().userSelect }

/// The outermost `user-select: all` element holding `slot`, or NONE.
fn allRoot(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut found = NONE
  let mut at = slot
  while at != NONE {
    let node = tree.node(at)
    if node.computed().userSelect == SELECT_ALL && node.kind != NodeKind.Text { found = at }
    at = node.parent
  }
  return found
}

/// Whether node `slot` starts a new line of text: a block-level box, a table row, or a flex or
/// grid item. Table cells are separated by tabs instead.
fn blockLevel(tree: &UiTree<'_>, slot: u32) -> bool {
  let node = tree.node(slot)
  if node.kind == NodeKind.Text { return false }
  let display = node.computed().layout.display
  if display.isNone() || display.isContents() { return false }
  if display.insideIs(DisplayInside.TableCell) { return false }
  if display.outsideIs(DisplayOutside.Block) { return true }
  let parent = node.parent
  if parent != NONE {
    let outer = tree.node(parent).computed().layout.display
    if outer.insideIs(DisplayInside.Flex) || outer.isGrid() { return true }
  }
  return false
}

fn tableCell(tree: &UiTree<'_>, slot: u32) -> bool {
  return tree.node(slot).kind != NodeKind.Text
    && tree.node(slot).computed().layout.display.insideIs(DisplayInside.TableCell)
}

/// Images, icons, canvases and inputs: selected whole or not at all.
fn atomic(tree: &UiTree<'_>, slot: u32) -> bool {
  let kind = tree.node(slot).kind
  return kind == NodeKind.Image || kind == NodeKind.Icon || kind == NodeKind.Canvas || kind == NodeKind.Input
}

fn shown(tree: &UiTree<'_>, slot: u32) -> bool {
  let node = tree.node(slot)
  return node.rendered && node.computed().text.visible
}

// Points from positions on screen.

/// One thing a point can land on: a text fragment, or an atomic box.
struct Leaf {
  slot: u32,
  piece: Piece,
  atomic: bool,
}

impl Copy for Leaf {}

/// The text fragments and atomic boxes drawn for `container`'s subtree.
effect fn leavesOf(tree: &UiTree<'_>, container: u32, out: &mut List<Leaf>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let css = tree.node(container).css
  let mut fragment = if css < tree.fragmentOf.length() { tree.fragmentOf.get(css) } else { NO_INDEX }
  let values = tree.output.fragments.values.asSlice()
  let mut stack = List<usize>.make()
  while fragment != NO_INDEX {
    run stack.append(fragment)
    while stack.length() != 0 {
      let last = stack.length() - 1
      let index = stack.get(last)
      stack.truncate(last)
      let f = values[index]
      let slot = slotIn(&tree.slotOfCss, f.source)
      let mut descend = true
      if f.kind == FragmentKind.Text && f.textData != NO_INDEX {
        if slot != NONE && isText(tree, slot) && shown(tree, slot) {
          let mut runs = tree.output.fragments.textRuns(index)
          while runs.next() {
            run out.append(Leaf { slot: slot, piece: cssom_view.visualTextPiece(tree, index, &runs.current), atomic: false })
          }
        }
        descend = false
      } else if slot != NONE && f.kind == FragmentKind.Box && slot != container
        && (atomic(tree, slot) || firstChild(tree, slot) == NONE && !blockLevel(tree, slot)) {
        if shown(tree, slot) {
          let box = borderBox(&tree.visualFragment(index))
          let mut piece = visualPiece(tree, index)
          piece.x0 = box.xMin
          piece.x1 = box.xMax
          piece.top = box.yMin
          piece.bottom = box.yMax
          run out.append(Leaf { slot: slot, piece: piece, atomic: true })
        }
        descend = false
      }
      if descend {
        // Children pushed in reverse pop in order.
        let mut children = List<usize>.make()
        let mut child = f.firstChild
        while child != NO_INDEX {
          run children.append(child)
          child = values[child].nextSibling
        }
        let mut i = children.length()
        while i > 0 {
          i = i - 1
          run stack.append(children.get(i))
        }
      }
    }
    fragment = tree.nextSourceFragment.get(fragment)
  }
}

/// An atomic box's geometry where it draws, on the line box around it. Boxes have no text range.
fn visualPiece(tree: &UiTree<'_>, index: usize) -> Piece {
  let box = borderBox(&tree.visualFragment(index))
  let mut piece = Piece {
    start: 0,
    end: 0,
    x0: box.xMin,
    x1: box.xMax,
    top: box.yMin,
    bottom: box.yMax,
    fragment: index,
    line: index,
    lineTop: box.yMin,
    lineBottom: box.yMax,
    lineLeft: box.xMin,
    lineRight: box.xMax,
    shapeKey: 0,
    glyphs: false,
    lineBreak: false,
    rtl: false,
    base: 0,
  }
  // An atomic inline sits on its line box: lines are grouped by it. A line with one has a
  // fragment, so this is the line its text runs name too.
  let values = tree.output.fragments.values.asSlice()
  let mut up = values[index].parent
  while up != NO_INDEX {
    if values[up].kind == FragmentKind.Line {
      let line = borderBox(&tree.visualFragment(up))
      piece.line = up
      piece.lineTop = line.yMin
      piece.lineBottom = line.yMax
      piece.lineLeft = line.xMin
      piece.lineRight = line.xMax
      break
    }
    up = values[up].parent
  }
  return piece
}

fn horizontalDistance(x: f32, x0: f32, x1: f32) -> f32 {
  if x < x0 { return x0 - x }
  if x > x1 { return x - x1 }
  return 0.0
}

/// The leaf a point at (`x`, `y`) belongs to: on the line holding `y` nearest to `x`; between
/// lines, on the first line below (as Chromium picks the next block in the gap between two);
/// below everything, on the last line.
fn nearestLeaf(leaves: &List<Leaf>, x: f32, y: f32, upward: bool) -> usize {
  let values = leaves.asSlice()
  let mut best = NO_INDEX
  let mut bestRank: u32 = 3
  let mut bestVertical = f32.MAX
  let mut bestHorizontal = f32.MAX
  let mut i: usize = 0
  while i < values.length {
    let p = values[i].piece
    let found = rankOf(p, y)
    // Moving up, the lines above come before the ones below.
    let rank: u32 = if upward && found != 0 { 3 - found } else { found }
    let vertical: f32 = if found == 0 { 0.0 } else if found == 1 { p.lineTop - y } else { y - p.lineBottom }
    let horizontal = horizontalDistance(x, p.x0, p.x1)
    let better = rank < bestRank || rank == bestRank && (vertical < bestVertical - 0.01
      || f32.abs(vertical - bestVertical) <= 0.01 && horizontal < bestHorizontal)
    if better {
      best = i
      bestRank = rank
      bestVertical = vertical
      bestHorizontal = horizontal
    }
    i = i + 1
  }
  return best
}

fn rankOf(p: Piece, y: f32) -> u32 {
  return if y >= p.lineTop && y < p.lineBottom { 0 } else if p.lineTop >= y { 1 } else { 2 }
}

/// The leaf that starts (or, with `last`, ends) line `line`, left to right.
fn lineEdge(leaves: &List<Leaf>, line: usize, last: bool) -> usize {
  let values = leaves.asSlice()
  let mut best = NO_INDEX
  let mut i: usize = 0
  while i < values.length {
    if values[i].piece.line == line {
      if best == NO_INDEX || last && values[i].piece.x1 >= values[best].piece.x1
        || !last && values[i].piece.x0 < values[best].piece.x0 { best = i }
    }
    i = i + 1
  }
  return best
}

/// The point nearest to (`x`, `y`) in CSS pixels of the viewport, found from what is drawn
/// there: the hit element's text and atomic boxes, the nearest line first.
pub effect fn pointAt(tree: &UiTree<'_>, x: f32, y: f32) -> Point
  ! OutOfMemoryError
  ? &mut Allocator {
  return run pointWith(tree, x, y, true, false)
}

/// `pointAt`; without `edges`, a point off every line goes to the nearest line at `x`
/// (moving a caret a line up or down) rather than to a line's start or end.
effect fn pointWith(tree: &UiTree<'_>, x: f32, y: f32, edges: bool, upward: bool) -> Point
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut container = interact.hitSlot(tree, x, y)
  if container == NONE { container = tree.root }
  if container == NONE { return Point.none() }
  if isText(tree, container) { container = tree.node(container).parent }
  if atomic(tree, container) && container != tree.root {
    let box = borderBox(&tree.visualFragment(firstFragmentOf(tree, container)))
    if x < (box.xMin + box.xMax) * 0.5 { return before(tree, container) }
    return after(tree, container)
  }
  let mut leaves = List<Leaf>.make()
  run leavesOf(tree, container, &mut leaves)
  let index = nearestLeaf(&leaves, x, y, upward)
  if index == NO_INDEX { return at(tree, container, 0) }
  let mut leaf = leaves.get(index)
  let rank = rankOf(leaf.piece, y)
  if rank != 0 && edges {
    // Above a line (in the gap over it, or over all the content) is its start; below the last
    // line is its end, wherever the pointer is across.
    let wanted = lineEdge(&leaves, leaf.piece.line, rank == 2)
    leaf = leaves.get(wanted)
    if leaf.atomic {
      return if rank == 2 { after(tree, leaf.slot) } else { before(tree, leaf.slot) }
    }
    let edge = if rank == 2 { if leaf.piece.lineBreak { leaf.piece.start } else { leaf.piece.end } } else { leaf.piece.start }
    return at(tree, leaf.slot, edge)
  }
  if leaf.atomic {
    if x < (leaf.piece.x0 + leaf.piece.x1) * 0.5 { return before(tree, leaf.slot) }
    return after(tree, leaf.slot)
  }
  let mut pieces = List<Piece>.make()
  let values = leaves.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i].slot == leaf.slot && !values[i].atomic { run pieces.append(values[i].piece) }
    i = i + 1
  }
  let mut boundaries = List<usize>.make()
  run segmentation.graphemes(String.view(&tree.node(leaf.slot).text), &mut boundaries)
  let middle = (leaf.piece.lineTop + leaf.piece.lineBottom) * 0.5
  let byte = caret.offsetNear(&tree.provider.text, &pieces, &boundaries, x, middle)
  if byte == NO_INDEX { return at(tree, leaf.slot, 0) }
  return at(tree, leaf.slot, byte)
}

fn firstFragmentOf(tree: &UiTree<'_>, slot: u32) -> usize {
  let css = tree.node(slot).css
  return if css < tree.fragmentOf.length() { tree.fragmentOf.get(css) } else { NO_INDEX }
}

// Units.

/// One text node of a paragraph and where its text starts in the paragraph's text.
struct Run {
  slot: u32,
  start: usize,
}

impl Copy for Run {}

/// A paragraph: the inline content between two block boundaries, as one string.
struct Paragraph {
  runs: List<Run>,
  text: String,
  /// The point right after the paragraph: the start of the block that ends it, or after the
  /// block holding it.
  end: Point,
}

/// The nearest block-level ancestor of `slot` (or the root).
fn blockOf(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut at = tree.node(slot).parent
  while at != NONE {
    if blockLevel(tree, at) || tableCell(tree, at) || tree.node(at).parent == NONE { return at }
    at = tree.node(at).parent
  }
  return slot
}

/// The paragraph holding text node `slot`.
effect fn paragraphOf(tree: &UiTree<'_>, slot: u32) -> Paragraph
  ! OutOfMemoryError
  ? &mut Allocator {
  let block = blockOf(tree, slot)
  let mut out = Paragraph { runs: List<Run>.make(), text: String.make(), end: after(tree, block) }
  let mut found = false
  // Walk the block's inline content; a block-level descendant ends one paragraph and starts
  // the next, and is not entered.
  let mut stack = List<u32>.make()
  let mut child = firstChild(tree, block)
  let mut pending = List<u32>.make()
  while child != NONE {
    run pending.append(child)
    child = nextSibling(tree, child)
  }
  let mut i = pending.length()
  while i > 0 {
    i = i - 1
    run stack.append(pending.get(i))
  }
  while stack.length() != 0 {
    let last = stack.length() - 1
    let at = stack.get(last)
    stack.truncate(last)
    if blockLevel(tree, at) || tableCell(tree, at) {
      if found {
        out.end = Point { slot: at, id: tree.node(at).id, offset: 0 }
        return move out
      }
      out.runs.clear()
      out.text.clear()
      continue
    }
    if isText(tree, at) {
      if at == slot { found = true }
      run out.runs.append(Run { slot: at, start: String.byteLength(String.view(&out.text)) })
      run out.text.append(String.view(&tree.node(at).text))
      continue
    }
    if !shown(tree, at) { continue }
    pending.clear()
    let mut inner = firstChild(tree, at)
    while inner != NONE {
      run pending.append(inner)
      inner = nextSibling(tree, inner)
    }
    let mut k = pending.length()
    while k > 0 {
      k = k - 1
      run stack.append(pending.get(k))
    }
  }
  return move out
}

/// Where text point `point` is in paragraph `p`'s text.
fn inParagraph(p: &Paragraph, point: Point) -> usize {
  let runs = p.runs.asSlice()
  let mut i: usize = 0
  while i < runs.length {
    if runs[i].slot == point.slot { return runs[i].start + point.offset }
    i = i + 1
  }
  return 0
}

/// The point at byte `offset` of paragraph `p`'s text (at the end of a run rather than the
/// start of the next).
fn fromParagraph(tree: &UiTree<'_>, p: &Paragraph, offset: usize, preferEnd: bool) -> Point {
  let runs = p.runs.asSlice()
  let mut i: usize = 0
  while i < runs.length {
    let start = runs[i].start
    let end = start + textLength(tree, runs[i].slot)
    let last = i + 1 == runs.length
    if offset < end || offset == end && (preferEnd || last) {
      return at(tree, runs[i].slot, offset - start)
    }
    i = i + 1
  }
  return p.end
}

/// The unit around `point`: the word or paragraph it is in, as a start and an end point.
effect fn unitAt(tree: &UiTree<'_>, point: Point, unit: u32, start: &mut Point, end: &mut Point) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  start.* = point
  end.* = point
  if unit == UNIT_CHARACTERS || !point.exists() || !isText(tree, point.slot) { return () }
  let p = run paragraphOf(tree, point.slot)
  let offset = inParagraph(&p, point)
  let text = String.view(&p.text)
  if unit == UNIT_WORDS {
    let span = run edit.wordAt(text, offset)
    // Chromium's words break at a full stop between letters ("foo.bar"), not between digits.
    let bytes = String.utf8Bytes(text)
    let mut low = span.start
    let mut high = span.end
    let mut i = span.start
    while i < span.end {
      if bytes[i] == 46 && i > span.start && i + 1 < span.end && !(digit(bytes[i - 1]) && digit(bytes[i + 1])) {
        if i < offset { low = i + 1 } else if i < high { high = i }
      }
      i = i + 1
    }
    start.* = fromParagraph(tree, &p, low, false)
    end.* = fromParagraph(tree, &p, high, true)
    return ()
  }
  // A preserved line break inside the paragraph ends it too.
  let bytes = String.utf8Bytes(text)
  let mut low = offset
  while low > 0 && bytes[low - 1] != 10 { low = low - 1 }
  let mut high = offset
  while high < bytes.length && bytes[high] != 10 { high = high + 1 }
  start.* = fromParagraph(tree, &p, low, false)
  end.* = if high < bytes.length { fromParagraph(tree, &p, high + 1, false) } else { p.end }
}

fn digit(b: u8) -> bool { return b >= 48 && b <= 57 }

// Changing the selection.

/// Selects from `anchor` to `focus`.
pub effect fn select(tree: &mut UiTree<'_>, anchor: Point, focus: Point) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = &mut tree.textSelection
  if s.anchor.same(anchor) && s.focus.same(focus) { return () }
  s.anchor = anchor
  s.focus = focus
  s.moved = true
  s.changes = s.changes + 1
  run refresh(&mut tree)
}

pub effect fn clear(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  tree.textSelection.unit = UNIT_NONE
  run select(&mut tree, Point.none(), Point.none())
}

/// Whether a press on `slot` (or a node above it) cannot start a selection: `user-select:
/// none`, buttons and links (which are pressed, or dragged, instead).
fn refuses(tree: &UiTree<'_>, slot: u32) -> bool {
  if userSelect(tree, slot) == SELECT_NONE { return true }
  let mut at = slot
  while at != NONE {
    let pressed = tree.node(at).accessRole
    if pressed == Role.Button || pressed == Role.Link { return true }
    at = tree.node(at).parent
  }
  return false
}

/// `point` moved out of a `user-select: all` element to its start or its end.
effect fn widened(tree: &UiTree<'_>, point: Point, toEnd: bool) -> Point
  ! OutOfMemoryError
  ? &mut Allocator {
  if !point.exists() { return point }
  let whole = allRoot(tree, point.slot)
  if whole == NONE { return point }
  return if toEnd { after(tree, whole) } else { before(tree, whole) }
}

/// A primary press at (`x`, `y`) on node `hit`, not on an input and not prevented.
pub effect fn pointerDown(
  tree: &mut UiTree<'_>,
  hit: u32,
  x: f32,
  y: f32,
  clickCount: u32,
  shift: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  tree.textSelection.unit = UNIT_NONE
  tree.textSelection.hasPreferredX = false
  if hit == NONE || refuses(&tree.*, hit) {
    run clear(&mut tree)
    return ()
  }
  let point = run pointAt(&tree.*, x, y)
  if !point.exists() {
    run clear(&mut tree)
    return ()
  }
  let unit = if clickCount <= 1 { UNIT_CHARACTERS } else if clickCount % 2 == 0 { UNIT_WORDS } else { UNIT_PARAGRAPHS }
  let ranged = tree.textSelection.ranged() || tree.textSelection.anchor.exists()
  if shift && unit == UNIT_CHARACTERS && ranged && valid(&tree.*, tree.textSelection.anchor) {
    let mut anchor = tree.textSelection.anchor
    if tree.keymap == Keymap.Mac && valid(&tree.*, tree.textSelection.focus) {
      // Mac selections have no direction: the end farther from the press stays.
      anchor = run fartherEnd(&tree.*, point)
    }
    tree.textSelection.unit = UNIT_CHARACTERS
    tree.textSelection.pressStart = anchor
    tree.textSelection.pressEnd = anchor
    let forward = (run compare(&tree.*, anchor, point)) <= 0
    let focus = run widened(&tree.*, point, forward)
    run select(&mut tree, anchor, focus)
    return ()
  }
  let mut start = point
  let mut end = point
  run unitAt(&tree.*, point, unit, &mut start, &mut end)
  start = run widened(&tree.*, start, false)
  end = run widened(&tree.*, end, true)
  tree.textSelection.unit = unit
  tree.textSelection.pressStart = start
  tree.textSelection.pressEnd = end
  tree.textSelection.startedAt = point.slot
  run select(&mut tree, start, end)
}

/// The end of the selection farther in tree order from `point`, comparing byte distance when
/// both ends and the point share a text node.
effect fn fartherEnd(tree: &UiTree<'_>, point: Point) -> Point
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = &tree.textSelection
  let mut start = s.anchor
  let mut end = s.focus
  if (run compare(tree, start, end)) > 0 {
    start = s.focus
    end = s.anchor
  }
  if (run compare(tree, point, start)) <= 0 { return end }
  if (run compare(tree, point, end)) >= 0 { return start }
  if start.slot == point.slot && end.slot == point.slot {
    return if point.offset - start.offset < end.offset - point.offset { end } else { start }
  }
  return s.anchor
}

/// The pointer moved to (`x`, `y`) with the button down after a press that selects.
pub effect fn pointerDrag(tree: &mut UiTree<'_>, x: f32, y: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let unit = tree.textSelection.unit
  if unit == UNIT_NONE { return () }
  let pressStart = tree.textSelection.pressStart
  let pressEnd = tree.textSelection.pressEnd
  if !valid(&tree.*, pressStart) || !valid(&tree.*, pressEnd) {
    tree.textSelection.unit = UNIT_NONE
    return ()
  }
  let point = run pointAt(&tree.*, x, y)
  if !point.exists() { return () }
  let mut start = point
  let mut end = point
  run unitAt(&tree.*, point, unit, &mut start, &mut end)
  // Past the first unit's end the selection grows forward from its start, before its start it
  // grows backward from its end; over it, the first unit stays selected.
  if (run compare(&tree.*, start, pressStart)) < 0 {
    let focus = run widened(&tree.*, start, false)
    run select(&mut tree, pressEnd, focus)
  } else if (run compare(&tree.*, end, pressEnd)) > 0 {
    let focus = run widened(&tree.*, end, true)
    run select(&mut tree, pressStart, focus)
  } else {
    run select(&mut tree, pressStart, pressEnd)
  }
}

pub fn pointerUp(tree: &mut UiTree<'_>) -> () {
  tree.textSelection.unit = UNIT_NONE
  tree.textSelection.scrolling = false
}

// Keeping up with the tree.

/// Checks the ends against the tree and rebuilds what is covered when either changed. Ends in
/// nodes that left the document clear the selection; text that got shorter pulls them in.
/// Whether [`refresh`] has nothing to do: the selection did not move and was built at the
/// tree's current revision.
pub fn settled(tree: &UiTree<'_>) -> bool {
  return !tree.textSelection.moved && tree.textSelection.builtAt == tree.revision
}

pub effect fn refresh(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !tree.textSelection.moved && tree.textSelection.builtAt == tree.revision {
    run placeCaret(&mut tree)
    return ()
  }
  let mut anchor = tree.textSelection.anchor
  let mut focus = tree.textSelection.focus
  if anchor.exists() || focus.exists() {
    if valid(&tree.*, anchor) && valid(&tree.*, focus) {
      anchor = clamped(&tree.*, anchor)
      focus = clamped(&tree.*, focus)
    } else {
      anchor = Point.none()
      focus = Point.none()
      tree.textSelection.unit = UNIT_NONE
    }
  }
  if !anchor.same(tree.textSelection.anchor) || !focus.same(tree.textSelection.focus) {
    tree.textSelection.changes = tree.textSelection.changes + 1
  }
  tree.textSelection.anchor = anchor
  tree.textSelection.focus = focus
  let mut next = List<Selected>.make()
  if tree.textSelection.ranged() {
    run cover(&tree.*, &mut next)
  }
  // Nodes whose highlight changed paint again; the others replay.
  let mut changed = List<u32>.make()
  let old = tree.textSelection.selected.asSlice()
  let mut i: usize = 0
  while i < old.length {
    let j = find(&next, old[i].slot)
    if j == NO_INDEX || !next.asSlice()[j].same(&old[i]) { run changed.append(old[i].slot) }
    i = i + 1
  }
  let fresh = next.asSlice()
  i = 0
  while i < fresh.length {
    if find(&tree.textSelection.selected, fresh[i].slot) == NO_INDEX { run changed.append(fresh[i].slot) }
    i = i + 1
  }
  i = 0
  while i < changed.length() {
    run touch(&mut tree, changed.get(i))
    i = i + 1
  }
  tree.textSelection.selected = move next
  tree.textSelection.builtAt = tree.revision
  tree.textSelection.moved = false
  run placeCaret(&mut tree)
}

/// Paints text node `slot` again: its fragments' hashes change, and the paint caches are
/// repaired for them (a selection moves no layout, so nothing else would).
effect fn touch(tree: &mut UiTree<'_>, slot: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  if u32.toUsize(slot) >= tree.nodes.length() { return () }
  let node = tree.nodeMut(slot)
  node.content = node.content + 1
  run tree.repair.nodes.append(slot)
  tree.repair.pending = true
  tree.paintDirty = true
}

/// The start and end of the selection in tree order.
effect fn ordered(tree: &UiTree<'_>, start: &mut Point, end: &mut Point) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  start.* = tree.textSelection.anchor
  end.* = tree.textSelection.focus
  if (run compare(tree, start.*, end.*)) > 0 {
    start.* = tree.textSelection.focus
    end.* = tree.textSelection.anchor
  }
}

/// Which order a selection takes where layout places children out of tree order.
pub enum SelectionOrder {
  /// What is seen: a drag across reordered flex items, placed grid cells or a positioned box
  /// selects what the pointer crossed on screen, in several stretches when it has to.
  Visual,
  /// Tree order, as browsers select: one stretch between the ends, wherever it shows.
  Tree,
}

/// A stretch of the selection in tree order.
pub struct Stretch {
  pub start: Point,
  pub end: Point,
}

impl Copy for Stretch {}

fn outOfFlow(tree: &UiTree<'_>, slot: u32) -> bool {
  let node = tree.node(slot)
  if node.kind == NodeKind.Text { return false }
  let position = node.computed().layout.position
  return position == Position.Absolute || position == Position.Fixed || node.computed().layout.float != Float.None
}

fn reorders(tree: &UiTree<'_>, slot: u32) -> bool {
  let display = tree.node(slot).computed().layout.display
  return display.insideIs(DisplayInside.Flex) || display.isGrid()
}

fn boxOf(tree: &UiTree<'_>, slot: u32, out: &mut Rect<f32>) -> bool {
  let fragment = firstFragmentOf(tree, slot)
  if fragment == NO_INDEX { return false }
  out.* = borderBox(&tree.visualFragment(fragment))
  return true
}

/// Reading order of two boxes: by line when they share most of a row, else top first.
fn seenBefore(a: Rect<f32>, b: Rect<f32>, rtl: bool) -> bool {
  let top: f32 = if a.yMin > b.yMin { a.yMin } else { b.yMin }
  let bottom: f32 = if a.yMax < b.yMax { a.yMax } else { b.yMax }
  let ha = a.yMax - a.yMin
  let hb = b.yMax - b.yMin
  let smaller: f32 = if ha < hb { ha } else { hb }
  if bottom - top > smaller / 2.0 {
    if rtl { return a.xMax > b.xMax }
    return a.xMin < b.xMin
  }
  return a.yMin < b.yMin
}

fn positionIn(slots: &List<u32>, slot: u32) -> usize {
  let values = slots.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i] == slot { return i }
    i = i + 1
  }
  return NO_INDEX
}

/// The selection as stretches in tree order, in the order they read. Between two children of
/// a flex or grid container, or with an end in a positioned or floating box, the selection
/// covers what lies between its ends on screen: the rest of the child seen first, the children
/// seen between, and the start of the child seen last. Otherwise, and in
/// `SelectionOrder.Tree`, it is the one stretch between its ends.
pub effect fn stretches(tree: &UiTree<'_>, out: &mut List<Stretch>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let mut start = Point.none()
  let mut end = Point.none()
  run ordered(tree, &mut start, &mut end)
  if tree.selectionOrder == SelectionOrder.Visual && (run visualStretches(tree, start, end, &mut out)) {
    return ()
  }
  out.clear()
  run out.append(Stretch { start: start, end: end })
}

effect fn visualStretches(tree: &UiTree<'_>, start: Point, end: Point, out: &mut List<Stretch>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !start.exists() || !end.exists() { return false }
  // The lowest element holding both ends, and its children `first` (holding the start) and
  // `last` (holding the end).
  let mut chain = List<u32>.make()
  let mut at = start.slot
  while at != NONE {
    run chain.append(at)
    at = tree.node(at).parent
  }
  let mut container = end.slot
  let mut last = NONE
  while container != NONE && positionIn(&chain, container) == NO_INDEX {
    last = container
    container = tree.node(container).parent
  }
  if container == NONE || last == NONE || container == start.slot { return false }
  let first = chain.get(positionIn(&chain, container) - 1)
  if !reorders(tree, container) && !outOfFlow(tree, first) && !outOfFlow(tree, last) { return false }
  let mut firstBox = Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
  let mut lastBox = Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
  if !boxOf(tree, first, &mut firstBox) || !boxOf(tree, last, &mut lastBox) { return false }
  let rtl = tree.node(container).computed().text.direction == Direction.Rtl
  let forward = seenBefore(firstBox, lastBox, rtl)
  let lead = if forward { first } else { last }
  let trail = if forward { last } else { first }
  let leadBox = if forward { firstBox } else { lastBox }
  let trailBox = if forward { lastBox } else { firstBox }
  // The children seen between, in reading order. Positioned and floating ones are only
  // selected as ends.
  let mut between = List<u32>.make()
  let mut boxes = List<Rect<f32>>.make()
  let mut child = firstChild(tree, container)
  while child != NONE {
    let mut box = Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
    if child != first && child != last && !outOfFlow(tree, child) && boxOf(tree, child, &mut box)
      && seenBefore(leadBox, box, rtl) && seenBefore(box, trailBox, rtl) {
      run between.append(child)
      run boxes.append(box)
      let slots = between.asMutSlice()
      let rects = boxes.asMutSlice()
      let mut j = slots.length - 1
      while j > 0 && seenBefore(rects[j], rects[j - 1], rtl) {
        let s = slots[j]
        slots[j] = slots[j - 1]
        slots[j - 1] = s
        let r = rects[j]
        rects[j] = rects[j - 1]
        rects[j - 1] = r
        j = j - 1
      }
    }
    child = nextSibling(tree, child)
  }
  // Seen in tree order: the one stretch says the same.
  if forward {
    let from = indexOf(tree, first)
    let to = indexOf(tree, last)
    let mut inOrder = between.length() + 1 == to - from
    let mut i: usize = 0
    while inOrder && i < between.length() {
      if indexOf(tree, between.get(i)) != from + 1 + i { inOrder = false }
      i = i + 1
    }
    if inOrder { return false }
  }
  let leadPoint = if forward { start } else { end }
  let trailPoint = if forward { end } else { start }
  run out.append(Stretch { start: leadPoint, end: after(tree, lead) })
  let mut i: usize = 0
  while i < between.length() {
    let slot = between.get(i)
    run out.append(Stretch { start: before(tree, slot), end: after(tree, slot) })
    i = i + 1
  }
  run out.append(Stretch { start: before(tree, trail), end: trailPoint })
  return true
}

/// One step of a walk over the range: entering a node, or leaving an element.
union Step { Enter { slot: u32 }, Leave { slot: u32 }, Done }

impl Copy for Step {}

/// A walk over the nodes from `start` to `end` in tree order.
struct Walk {
  at: u32,
  /// Whether `at` is still to be entered (rather than left).
  entering: bool,
  endSlot: u32,
  endText: bool,
  /// For an element end: the child the range stops before, or NONE to stop when leaving the
  /// element itself.
  stopBefore: u32,
  done: bool,
}

fn walkFrom(tree: &UiTree<'_>, start: Point, end: Point) -> Walk {
  let mut first = start.slot
  let mut entering = true
  if !isText(tree, start.slot) {
    let child = childAt(tree, start.slot, start.offset)
    if child != NONE {
      first = child
    } else {
      // Past the last child: the next step leaves the element.
      entering = false
    }
  }
  let endText = isText(tree, end.slot)
  return Walk {
    at: first,
    entering: entering,
    endSlot: end.slot,
    endText: endText,
    stopBefore: if endText { NONE } else { childAt(tree, end.slot, end.offset) },
    done: false,
  }
}

fn step(tree: &UiTree<'_>, w: &mut Walk) -> Step {
  if w.done || w.at == NONE { return Step.Done }
  let current = w.at
  if w.entering {
    if !w.endText && current == w.stopBefore {
      w.done = true
      return Step.Done
    }
    if w.endText && current == w.endSlot {
      w.done = true
      return Step.Enter { slot: current }
    }
    let child = firstChild(tree, current)
    if child != NONE {
      w.at = child
    } else {
      w.entering = false
    }
    return Step.Enter { slot: current }
  }
  // Leaving `current`: an element end that is `current` itself stops here, inside it.
  if !w.endText && w.stopBefore == NONE && current == w.endSlot {
    w.done = true
    return Step.Done
  }
  let sibling = nextSibling(tree, current)
  if sibling != NONE {
    w.at = sibling
    w.entering = true
  } else {
    w.at = tree.node(current).parent
    w.entering = false
  }
  if isText(tree, current) || firstChild(tree, current) == NONE && !blockLevel(tree, current) && !tableCell(tree, current) {
    // Leaves have nothing to close; step on.
    return step(tree, &mut w)
  }
  return Step.Leave { slot: current }
}

/// What the selection covers, node by node.
effect fn cover(tree: &UiTree<'_>, out: &mut List<Selected>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut parts = List<Stretch>.make()
  run stretches(tree, &mut parts)
  let mut k: usize = 0
  while k < parts.length() {
    let start = parts.get(k).start
    let end = parts.get(k).end
    k = k + 1
    let mut w = walkFrom(tree, start, end)
    while true {
      match step(tree, &mut w) {
        Step.Enter { slot } => {
          if isText(tree, slot) {
            if userSelect(tree, slot) != SELECT_NONE && shown(tree, slot) {
              let low = if slot == start.slot { start.offset } else { 0 }
              let high = if slot == end.slot { end.offset } else { textLength(tree, slot) }
              if low < high || slot != end.slot {
                run out.append(Selected { slot: slot, start: low, end: high, through: slot != end.slot, atomic: false })
              }
            }
          } else if atomic(tree, slot) && userSelect(tree, slot) != SELECT_NONE && shown(tree, slot) {
            run out.append(Selected { slot: slot, start: 0, end: 1, through: true, atomic: true })
          }
        }
        Step.Leave { .. } => {}
        Step.Done => { break }
      }
    }
  }
  sortBySlot(&mut out)
}

fn sortBySlot(list: &mut List<Selected>) -> () {
  // Insertion sort: walks mostly produce runs of increasing slots.
  let values = list.asMutSlice()
  let mut i: usize = 1
  while i < values.length {
    let item = values[i]
    let mut j = i
    while j > 0 && values[j - 1].slot > item.slot {
      values[j] = values[j - 1]
      j = j - 1
    }
    values[j] = item
    i = i + 1
  }
}

// Copying.

/// The selected text as Chromium copies it: rendered text with white space collapsed, a line
/// break around each block, two after a paragraph, a tab between table cells, and nothing from
/// `user-select: none` text.
pub effect fn text(tree: &UiTree<'_>) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = String.make()
  if !tree.textSelection.ranged() { return move out }
  let mut parts = List<Stretch>.make()
  run stretches(tree, &mut parts)
  let mut emitted = false
  let mut crossed = false
  // Collapsible white space waits until text follows it on the same line; `lineStart` drops
  // it at the start of a line.
  let mut pendingSpace = false
  let mut pendingKeep = false
  let mut lineStart = true
  let mut k: usize = 0
  while k < parts.length() {
    let start = parts.get(k).start
    let end = parts.get(k).end
    k = k + 1
    let mut w = walkFrom(tree, start, end)
    while true {
      match step(tree, &mut w) {
        Step.Enter { slot } => {
          if isText(tree, slot) && shown(tree, slot) {
            let low = if slot == start.slot { start.offset } else { 0 }
            let high = if slot == end.slot { end.offset } else { textLength(tree, slot) }
            let keep = userSelect(tree, slot) != SELECT_NONE
            let value = String.view(&tree.node(slot).text)
            let bytes = String.utf8Bytes(value)
            let collapse = tree.node(slot).computed().text.whiteSpaceCollapse
            let spaces = collapse == WhiteSpaceCollapse.Collapse || collapse == WhiteSpaceCollapse.PreserveBreaks
            let breaks = collapse != WhiteSpaceCollapse.Collapse
            let mut from = NO_INDEX
            let mut i: usize = 0
            while i < bytes.length {
              let b = bytes[i]
              let inside = keep && i >= low && i < high
              let space = spaces && (b == 32 || b == 9 || b == 13 || b == 10 && !breaks)
              if space {
                if from != NO_INDEX {
                  run emit(&mut out, value, from, i, &mut emitted)
                  from = NO_INDEX
                }
                if !lineStart {
                  pendingSpace = true
                  if inside { pendingKeep = true }
                }
              } else {
                if pendingSpace {
                  if pendingKeep {
                    run out.append(" ")
                    emitted = true
                  }
                  pendingSpace = false
                  pendingKeep = false
                }
                if inside {
                  if from == NO_INDEX { from = i }
                } else if from != NO_INDEX {
                  run emit(&mut out, value, from, i, &mut emitted)
                  from = NO_INDEX
                }
                lineStart = b == 10
              }
              i = i + 1
              if i >= high && !pendingSpace && from == NO_INDEX { break }
            }
            if from != NO_INDEX { run emit(&mut out, value, from, minOf(i, high), &mut emitted) }
            crossed = true
          } else if blockLevel(tree, slot) {
            if crossed && !endsWith(&out, 10) {
              run out.append("\n")
            }
            pendingSpace = false
            pendingKeep = false
            lineStart = true
            crossed = true
          } else if tableCell(tree, slot) {
            if crossed && indexOf(tree, slot) > 0 && !endsWith(&out, 10) { run out.append("\t") }
            pendingSpace = false
            pendingKeep = false
            lineStart = true
            crossed = true
          }
        }
        Step.Leave { slot } => {
          crossed = true
          if blockLevel(tree, slot) && emitted {
            if !endsWith(&out, 10) { run out.append("\n") }
            if tree.node(slot).accessRole == Role.Paragraph && !endsWithTwo(&out) { run out.append("\n") }
            pendingSpace = false
            pendingKeep = false
            lineStart = true
          }
        }
        Step.Done => { break }
      }
    }
  }
  if pendingSpace && pendingKeep { run out.append(" ") }
  return move out
}

effect fn emit(out: &mut String, value: string, low: usize, high: usize, emitted: &mut bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if high <= low { return () }
  run out.append(String.slice(value, low, high - low))
  emitted.* = true
}

fn minOf(a: usize, b: usize) -> usize { return if a < b { a } else { b } }

fn maxOf(a: usize, b: usize) -> usize { return if a > b { a } else { b } }

fn endsWith(out: &String, byte: u8) -> bool {
  let bytes = String.utf8Bytes(String.view(out))
  return bytes.length != 0 && bytes[bytes.length - 1] == byte
}

fn endsWithTwo(out: &String) -> bool {
  let bytes = String.utf8Bytes(String.view(out))
  return bytes.length >= 2 && bytes[bytes.length - 1] == 10 && bytes[bytes.length - 2] == 10
}

/// Ctrl+C (Cmd+C on a Mac) with text selected: the selected text goes to the clipboard.
pub effect fn copy(tree: &mut UiTree<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  run refresh(&mut tree)
  if !tree.textSelection.ranged() { return false }
  let copied = run text(&tree.*)
  if String.byteLength(String.view(&copied)) == 0 { return false }
  run tree.requests.append(HostRequest.WriteClipboard { text: move copied })
  return true
}

// Keys.

fn lastChild(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut child = firstChild(tree, slot)
  let mut last = NONE
  while child != NONE {
    last = child
    child = nextSibling(tree, child)
  }
  return last
}

fn previousSibling(tree: &UiTree<'_>, slot: u32) -> u32 {
  let parent = tree.node(slot).parent
  if parent == NONE { return NONE }
  let mut child = firstChild(tree, parent)
  let mut previous = NONE
  while child != NONE && child != slot {
    previous = child
    child = nextSibling(tree, child)
  }
  return previous
}

/// The node after `slot` in tree order, its subtree skipped.
fn afterSubtree(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut at = slot
  while at != NONE {
    let sibling = nextSibling(tree, at)
    if sibling != NONE { return sibling }
    at = tree.node(at).parent
  }
  return NONE
}

fn caretable(tree: &UiTree<'_>, slot: u32) -> bool {
  return isText(tree, slot) && shown(tree, slot) && userSelect(tree, slot) != SELECT_NONE
    && textLength(tree, slot) != 0
}

/// The first selectable text node at or after `slot` in tree order.
fn textFrom(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut at = slot
  while at != NONE {
    if caretable(tree, at) { return at }
    let child = firstChild(tree, at)
    at = if child != NONE { child } else { afterSubtree(tree, at) }
  }
  return NONE
}

/// The node before `slot` in tree order: its previous sibling's last descendant, or its parent.
fn beforeInOrder(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut at = previousSibling(tree, slot)
  if at == NONE { return tree.node(slot).parent }
  while lastChild(tree, at) != NONE { at = lastChild(tree, at) }
  return at
}

/// The last selectable text node before `slot` in tree order (not inside it).
fn textBefore(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut at = beforeInOrder(tree, slot)
  while at != NONE {
    if caretable(tree, at) { return at }
    at = beforeInOrder(tree, at)
  }
  return NONE
}

/// The focus one character on, crossing into the next or previous text node.
effect fn characterStep(tree: &UiTree<'_>, point: Point, forward: bool) -> Point
  ! OutOfMemoryError
  ? &mut Allocator {
  if !isText(tree, point.slot) {
    let child = childAt(tree, point.slot, point.offset)
    if forward {
      let next = textFrom(tree, if child != NONE { child } else { afterSubtree(tree, point.slot) })
      return if next == NONE { point } else { at(tree, next, 0) }
    }
    let previous = textBefore(tree, if child != NONE { child } else { point.slot })
    let last = if child == NONE { textBeforeEnd(tree, point.slot) } else { previous }
    return if last == NONE { point } else { at(tree, last, textLength(tree, last)) }
  }
  let text = String.view(&tree.node(point.slot).text)
  if forward {
    if point.offset < String.byteLength(text) { return at(tree, point.slot, edit.nextGrapheme(text, point.offset)) }
    let next = textFrom(tree, afterSubtree(tree, point.slot))
    if next == NONE { return point }
    if blockOf(tree, next) != blockOf(tree, point.slot) { return at(tree, next, 0) }
    return at(tree, next, edit.nextGrapheme(String.view(&tree.node(next).text), 0))
  }
  if point.offset > 0 { return at(tree, point.slot, run edit.previousGrapheme(text, point.offset)) }
  let previous = textBefore(tree, point.slot)
  if previous == NONE { return point }
  let length = textLength(tree, previous)
  if blockOf(tree, previous) != blockOf(tree, point.slot) { return at(tree, previous, length) }
  return at(tree, previous, run edit.previousGrapheme(String.view(&tree.node(previous).text), length))
}

/// The last selectable text inside `slot`.
fn textBeforeEnd(tree: &UiTree<'_>, slot: u32) -> u32 {
  let last = lastChild(tree, slot)
  if last == NONE { return textBefore(tree, slot) }
  let mut deepest = last
  while firstChild(tree, deepest) != NONE { deepest = lastChild(tree, deepest) }
  if caretable(tree, deepest) { return deepest }
  return textBefore(tree, deepest)
}

/// The focus moved to the end of this word or the start of the previous one.
effect fn wordStep(tree: &UiTree<'_>, point: Point, forward: bool) -> Point
  ! OutOfMemoryError
  ? &mut Allocator {
  if !isText(tree, point.slot) { return run characterStep(tree, point, forward) }
  let p = run paragraphOf(tree, point.slot)
  let offset = inParagraph(&p, point)
  let text = String.view(&p.text)
  let target = if forward { run edit.nextWordEnd(text, offset) } else { run edit.previousWordStart(text, offset) }
  if target == offset {
    // At the paragraph's edge: on into the next one, then to its word edge.
    let crossed = run characterStep(tree, point, forward)
    if crossed.same(point) { return point }
    return run wordStep(tree, crossed, forward)
  }
  return fromParagraph(tree, &p, target, forward)
}

/// The piece of text node `slot` holding byte `offset`, with its caret x.
effect fn caretOf(tree: &UiTree<'_>, point: Point, piece: &mut Piece, x: &mut f32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !isText(tree, point.slot) { return false }
  let mut pieces = List<Piece>.make()
  run cssom_view.textPieces(tree, point.slot, &mut pieces)
  let index = caret.pieceAt(&pieces, point.offset)
  if index == NO_INDEX { return false }
  piece.* = pieces.get(index)
  x.* = caret.caretX(&tree.provider.text, &piece.*, point.offset)
  return true
}

/// Shift with an arrow, Home or End (or their Mac forms) moves the selection's focus: by
/// character, word, line, to a line's edge or to the document's. The anchor stays.
pub effect fn extend(tree: &mut UiTree<'_>, key: string, modifiers: u32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if u32.bitAnd(modifiers, MOD_SHIFT) == 0 { return false }
  run refresh(&mut tree)
  let s = &tree.textSelection
  if !s.anchor.exists() || !s.focus.exists() { return false }
  let anchor = s.anchor
  let mut next = s.focus
  let host = focusedHost(&tree.*)
  let edge = if host != NONE { host } else { tree.root }
  if !run stepped(&mut tree, key, modifiers, edge, &mut next) { return false }
  if next.exists() { run select(&mut tree, anchor, next) }
  return true
}

/// Where an arrow, Home or End (or their Mac forms) takes the selection's focus: by character,
/// word, line, to a line's edge or to the start or end of `edge` (the document, or an editing
/// host). False for other keys.
effect fn stepped(tree: &mut UiTree<'_>, key: string, modifiers: u32, edge: u32, next: &mut Point) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  // A point between elements moves from the text the caret shows in.
  let focus = caretPoint(&tree.*, next.*)
  let mac = tree.keymap == Keymap.Mac
  let control = u32.bitAnd(modifiers, MOD_CONTROL) != 0
  let alt = u32.bitAnd(modifiers, MOD_ALT) != 0
  let meta = u32.bitAnd(modifiers, MOD_META) != 0
  let byWord = if mac { alt && !meta && !control } else { control && !alt && !meta }
  let lineEdge = if mac { meta && !alt && (key == "ArrowLeft" || key == "ArrowRight") } else { !control && (key == "Home" || key == "End") }
  let documentEdge = if mac { meta && (key == "ArrowUp" || key == "ArrowDown") || key == "Home" || key == "End" } else { control && (key == "Home" || key == "End") }
  let forward = key == "ArrowRight" || key == "ArrowDown" || key == "End"
  if documentEdge {
    next.* = if forward { at(&tree.*, edge, childCount(&tree.*, edge)) } else { at(&tree.*, edge, 0) }
  } else if lineEdge {
    let mut piece = Piece { start: 0, end: 0, x0: 0.0, x1: 0.0, top: 0.0, bottom: 0.0, fragment: NO_INDEX, line: 0, lineTop: 0.0, lineBottom: 0.0, lineLeft: 0.0, lineRight: 0.0, shapeKey: 0, glyphs: false, lineBreak: false, rtl: false, base: 0 }
    let mut x: f32 = 0.0
    if !run caretOf(&tree.*, focus, &mut piece, &mut x) { return false }
    let middle = (piece.lineTop + piece.lineBottom) * 0.5
    next.* = run pointAt(&tree.*, if forward { 1000000.0 } else { -1000000.0 }, middle)
  } else if key == "ArrowUp" || key == "ArrowDown" {
    let mut piece = Piece { start: 0, end: 0, x0: 0.0, x1: 0.0, top: 0.0, bottom: 0.0, fragment: NO_INDEX, line: 0, lineTop: 0.0, lineBottom: 0.0, lineLeft: 0.0, lineRight: 0.0, shapeKey: 0, glyphs: false, lineBreak: false, rtl: false, base: 0 }
    let mut x: f32 = 0.0
    if !run caretOf(&tree.*, focus, &mut piece, &mut x) {
      next.* = run characterStep(&tree.*, focus, forward)
    } else {
      if tree.textSelection.hasPreferredX { x = tree.textSelection.preferredX }
      tree.textSelection.preferredX = x
      tree.textSelection.hasPreferredX = true
      let y = if forward { piece.lineBottom + 0.5 } else { piece.lineTop - 0.5 }
      // The last line down (or first up) goes to the document's edge, as a caret does.
      let mut found = run pointWith(&tree.*, x, y, false, !forward)
      if found.same(focus) || (run compare(&tree.*, found, focus)) != (if forward { 1 } else { -1 }) {
        found = run pointAt(&tree.*, x, y)
      }
      next.* = if found.exists() { found } else { focus }
    }
    return true
  } else if key == "ArrowLeft" || key == "ArrowRight" {
    let mut step = if byWord { run wordStep(&tree.*, focus, forward) } else { run characterStep(&tree.*, focus, forward) }
    if editingHost(&tree.*, edge) == edge { step = pastIsland(&tree.*, edge, step, forward) }
    // A line break's text (a `<br>`) has no place after it: past it is the next line.
    if lineBreak(&tree.*, step.slot) && step.offset > 0 {
      step = if forward { run characterStep(&tree.*, step, true) } else { at(&tree.*, step.slot, 0) }
    }
    next.* = step
  } else {
    return false
  }
  tree.textSelection.hasPreferredX = false
  return true
}

/// Where a caret at `point` goes one line down (`forward`) or up, or with `boundary` to its
/// line's end or start, as the layout has the lines. None when `point` is not in laid out text.
pub effect fn lineStep(tree: &UiTree<'_>, point: Point, forward: bool, boundary: bool) -> Point
  ! OutOfMemoryError
  ? &mut Allocator {
  let focus = caretPoint(tree, point)
  let mut piece = Piece { start: 0, end: 0, x0: 0.0, x1: 0.0, top: 0.0, bottom: 0.0, fragment: NO_INDEX, line: 0, lineTop: 0.0, lineBottom: 0.0, lineLeft: 0.0, lineRight: 0.0, shapeKey: 0, glyphs: false, lineBreak: false, rtl: false, base: 0 }
  let mut x: f32 = 0.0
  if !run caretOf(tree, focus, &mut piece, &mut x) { return Point.none() }
  if boundary {
    return run pointAt(tree, if forward { 1000000.0 } else { -1000000.0 }, (piece.lineTop + piece.lineBottom) * 0.5)
  }
  let y = if forward { piece.lineBottom + 0.5 } else { piece.lineTop - 0.5 }
  let mut found = run pointWith(tree, x, y, false, !forward)
  if found.same(focus) || (run compare(tree, found, focus)) != (if forward { 1 } else { -1 }) {
    found = run pointAt(tree, x, y)
  }
  return found
}

/// Ctrl+A (Cmd+A on a Mac) outside inputs: selects everything in the nearest `user-select:
/// contain` element around the focus (or the selection), or the whole document.
pub effect fn selectAll(tree: &mut UiTree<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let root = tree.root
  if root == NONE { return false }
  run refresh(&mut tree)
  let mut from = tree.focused
  if from == NONE && tree.textSelection.focus.exists() { from = tree.textSelection.focus.slot }
  let mut scope = root
  let mut up = from
  while up != NONE {
    if tree.node(up).kind != NodeKind.Input && tree.node(up).computed().userSelect == SELECT_CONTAIN {
      scope = up
      break
    }
    up = tree.node(up).parent
  }
  tree.textSelection.unit = UNIT_NONE
  let first = at(&tree.*, scope, 0)
  let last = at(&tree.*, scope, childCount(&tree.*, scope))
  run select(&mut tree, first, last)
  return true
}

// Scrolling while dragging.

/// The scroll container a press selects in: the nearest one around its start that the user
/// can scroll, or NONE for the viewport.
fn scrollerOf(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut at = slot
  while at != NONE {
    let c = tree.node(at).computed().*
    if !isText(tree, at) && (userScrolls(usedOverflow(&c, true)) || userScrolls(usedOverflow(&c, false)))
      && firstFragmentOf(tree, at) != NO_INDEX {
      return at
    }
    at = tree.node(at).parent
  }
  return NONE
}

fn beyond(value: f32, low: f32, high: f32) -> f32 {
  if value < low { return value - low }
  if value > high { return value - high }
  return 0.0
}

/// One frame of scrolling while a drag holds the pointer past the edge of what it selects
/// in: the container scrolls by half the distance past its edge (at least two pixels) and the
/// focus follows the pointer. Returns whether anything scrolled.
pub effect fn autoscroll(tree: &mut UiTree<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if tree.textSelection.unit == UNIT_NONE || !valid(&tree.*, tree.textSelection.pressStart) {
    tree.textSelection.scrolling = false
    return false
  }
  let start = tree.textSelection.pressStart.slot
  let scroller = scrollerOf(&tree.*, start)
  let port = if scroller == NONE {
    Rect<f32>.new(0.0, 0.0, tree.input.width, tree.input.height)
  } else {
    paddingBox(&tree.visualFragment(firstFragmentOf(&tree.*, scroller)))
  }
  let x = tree.pointerX
  let y = tree.pointerY
  let dx = beyond(x, port.xMin, port.xMax)
  let dy = beyond(y, port.yMin, port.yMax)
  if dx == 0.0 && dy == 0.0 {
    tree.textSelection.scrolling = false
    return false
  }
  tree.textSelection.scrolling = true
  let stepX: f32 = if dx == 0.0 { 0.0 } else if dx > 0.0 { f32.max(2.0, dx * 0.5) } else { f32.min(-2.0, dx * 0.5) }
  let stepY: f32 = if dy == 0.0 { 0.0 } else if dy > 0.0 { f32.max(2.0, dy * 0.5) } else { f32.min(-2.0, dy * 0.5) }
  let from = if scroller == NONE { start } else { scroller }
  let moved = run interact.scrollChain(&mut tree, from, stepX, stepY)
  run pointerDrag(&mut tree, x, y)
  return moved
}

// Events and DOM offsets.

/// What a `SelectionChange` record's `selectionStart` says when it targets a node that is not
/// an input: a press started a new selection there (`selectstart`). Otherwise the record targets
/// the root, for the document's `selectionchange`.
pub const SELECT_START: usize = 1

fn listens(tree: &UiTree<'_>, slot: u32) -> bool {
  let mut at = slot
  while at != NONE {
    if u32.bitAnd(tree.node(at).listeners, LISTEN_SELECTION_CHANGE) != 0 { return true }
    at = tree.node(at).parent
  }
  return false
}

/// Queues `selectstart` for a press that started a selection, and the document's
/// `selectionchange` when the ends moved since the last one, for listeners. Runs after each
/// input and batch, as `edit.reportSelection` does for inputs.
pub effect fn report(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let started = tree.textSelection.startedAt
  tree.textSelection.startedAt = NONE
  if started != NONE && u32.toUsize(started) < tree.nodes.length() && listens(&tree.*, started) {
    let mut path = List<u32>.make()
    run tree.pathTo(started, &mut path)
    let id = tree.node(started).id
    let mut event = Event.make(EventKind.SelectionChange, id, move path)
    event.selectionStart = SELECT_START
    run tree.queueEvent(move event)
  }
  if tree.textSelection.changes == tree.textSelection.reported { return () }
  tree.textSelection.reported = tree.textSelection.changes
  let root = tree.root
  if root == NONE || u32.bitAnd(tree.node(root).listeners, LISTEN_SELECTION_CHANGE) == 0 { return () }
  let mut path = List<u32>.make()
  run tree.pathTo(root, &mut path)
  let id = tree.node(root).id
  run tree.queueEvent(Event.make(EventKind.SelectionChange, id, move path))
}

/// The DOM offset of `point`: UTF-16 units in text, a child index in an element.
pub fn domOffset(tree: &UiTree<'_>, point: Point) -> usize {
  if !isText(tree, point.slot) { return point.offset }
  return cssom_view.utf16AtByte(String.view(&tree.node(point.slot).text), point.offset)
}

/// The point at DOM offset `offset` of node `id`, clamped to the node; none for an unknown id.
pub fn fromDom(tree: &UiTree<'_>, id: u32, offset: usize) -> Point {
  let slot = tree.slotOf(id)
  if slot == NONE { return Point.none() }
  if isText(tree, slot) {
    return at(tree, slot, cssom_view.byteAtUtf16(String.view(&tree.node(slot).text), offset, false))
  }
  let count = childCount(tree, slot)
  return at(tree, slot, if offset > count { count } else { offset })
}

/// `point` as a point in text: itself in a text node, else the start of the first selectable
/// text after it (`start`) or the end of the last one before it. None when there is none.
pub fn textPoint(tree: &UiTree<'_>, point: Point, start: bool) -> Point {
  if !point.exists() || isText(tree, point.slot) { return point }
  let child = childAt(tree, point.slot, point.offset)
  if start {
    let found = if child != NONE { textFrom(tree, child) } else { textFrom(tree, afterSubtree(tree, point.slot)) }
    return if found == NONE { Point.none() } else { at(tree, found, 0) }
  }
  let found = if child != NONE { textBefore(tree, child) } else { textBeforeEnd(tree, point.slot) }
  return if found == NONE { Point.none() } else { at(tree, found, textLength(tree, found)) }
}

// Editing hosts: elements with `contenteditable`, edited by the client.
//
// The tree keeps no model of what a host holds: its content is the client's nodes. A key or
// text for the focused host becomes an `Input.Edit` follow-up, whose `beforeinput` record the
// client answers by changing its nodes (and the selection) itself, as a browser's editing
// does. Movement keys move the document selection, and the caret is painted at it.

/// What `contenteditable` on `slot` says, in any ASCII case: 1 editable ("", "true"), 3 plain
/// text ("plaintext-only"), 2 not editable ("false"), 0 nothing (absent, "inherit" or unknown).
fn editableValue(tree: &UiTree<'_>, slot: u32) -> u32 {
  if let Option<&NodeIdentity>.Some { value } = tree.node(slot).identity() {
    let attributes = value.attributes()
    let mut i: usize = 0
    while i < attributes.length {
      if String.view(&attributes[i].name) == "contenteditable" {
        let text = String.view(&attributes[i].value)
        if text == "" || asciiSame(text, "true") { return 1 }
        if asciiSame(text, "plaintext-only") { return 3 }
        if asciiSame(text, "false") { return 2 }
        return 0
      }
      i = i + 1
    }
  }
  return 0
}

/// Whether `text` is `lower` (lowercase ASCII) in any ASCII case.
fn asciiSame(text: string, lower: string) -> bool {
  let a = String.utf8Bytes(text)
  let b = String.utf8Bytes(lower)
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length {
    let c = if a[i] >= 65 && a[i] <= 90 { a[i] + 32 } else { a[i] }
    if c != b[i] { return false }
    i = i + 1
  }
  return true
}

/// The outermost element between `slot` and `host` that `contenteditable="false"` takes out of
/// the host, or NONE. The caret steps over such an island whole.
fn islandOf(tree: &UiTree<'_>, host: u32, slot: u32) -> u32 {
  let mut found = NONE
  let mut at = slot
  while at != NONE && at != host {
    let kind = tree.node(at).kind
    if kind != NodeKind.Text && kind != NodeKind.Input && editableValue(tree, at) == 2 { found = at }
    at = tree.node(at).parent
  }
  return if at == host { found } else { NONE }
}

/// `point`, or where it lands inside an island of `host`, the island's far side (in the text
/// after it, or before it backward, when that text is in the same block).
fn pastIsland(tree: &UiTree<'_>, host: u32, point: Point, forward: bool) -> Point {
  if !point.exists() { return point }
  let island = islandOf(tree, host, point.slot)
  if island == NONE { return point }
  let edge = if forward { after(tree, island) } else { before(tree, island) }
  let text = textPoint(tree, edge, forward)
  if text.exists() && inside(tree, host, text.slot) && islandOf(tree, host, text.slot) == NONE
    && blockOf(tree, text.slot) == blockOf(tree, island) { return text }
  return edge
}

/// The editing host `slot` is in: the outermost element above it (or itself) with an editable
/// `contenteditable`, up to one with `contenteditable="false"`. NONE when `slot` is not editable.
pub fn editingHost(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut host = NONE
  let mut at = slot
  while at != NONE {
    let kind = tree.node(at).kind
    if kind != NodeKind.Text && kind != NodeKind.Input {
      let value = editableValue(tree, at)
      if value == 2 { return host }
      if value == 1 || value == 3 { host = at }
    }
    at = tree.node(at).parent
  }
  return host
}

/// The editing host that has focus, or NONE.
pub fn focusedHost(tree: &UiTree<'_>) -> u32 {
  let focused = tree.focused
  if focused == NONE || u32.toUsize(focused) >= tree.nodes.length() { return NONE }
  if !tree.node(focused).live || tree.node(focused).kind == NodeKind.Input { return NONE }
  return editingHost(tree, focused)
}

/// Whether `slot` is text of one U+2028 line separator, as a client's `<br>` is.
fn lineBreak(tree: &UiTree<'_>, slot: u32) -> bool {
  return slot != NONE && isText(tree, slot) && String.view(&tree.node(slot).text) == "\u{2028}"
}

fn inside(tree: &UiTree<'_>, ancestor: u32, slot: u32) -> bool {
  let mut at = slot
  while at != NONE {
    if at == ancestor { return true }
    at = tree.node(at).parent
  }
  return false
}

/// Where the caret of a collapsed selection at `point` shows: in text where the point is in
/// text or next to text in the same block; else the point itself (an empty block).
fn caretPoint(tree: &UiTree<'_>, point: Point) -> Point {
  if isText(tree, point.slot) { return point }
  let child = childAt(tree, point.slot, point.offset)
  let block = if child != NONE && !isText(tree, child) && blockLevel(tree, child) { child } else if blockLevel(tree, point.slot) { point.slot } else { blockOf(tree, point.slot) }
  let after = textPoint(tree, point, true)
  if after.exists() && inside(tree, block, after.slot) { return after }
  let before = textPoint(tree, point, false)
  if before.exists() && inside(tree, block, before.slot) { return before }
  return point
}

/// Places `textSelection.caret`, and repaints the nodes it left and reached.
effect fn placeCaret(tree: &mut UiTree<'_>) -> () ! OutOfMemoryError ? &mut Allocator {
  let s = &tree.textSelection
  let mut next = Point.none()
  if s.anchor.exists() && s.anchor.same(s.focus) && valid(&tree.*, s.focus) {
    let host = focusedHost(&tree.*)
    if host != NONE && inside(&tree.*, host, s.focus.slot) { next = caretPoint(&tree.*, s.focus) }
  }
  let old = tree.textSelection.caret
  if old.same(next) && old.id == next.id { return () }
  tree.textSelection.caret = next
  if old.exists() && u32.toUsize(old.slot) < tree.nodes.length() && tree.node(old.slot).live { run touch(&mut tree, old.slot) }
  if next.exists() { run touch(&mut tree, next.slot) }
}

/// The caret's rectangle in CSS pixels of the viewport, for the input method; false when no
/// host has a caret in text.
pub effect fn caretRect(tree: &UiTree<'_>, rect: &mut Rect<f32>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let point = tree.textSelection.caret
  if !point.exists() { return false }
  let mut piece = Piece { start: 0, end: 0, x0: 0.0, x1: 0.0, top: 0.0, bottom: 0.0, fragment: NO_INDEX, line: 0, lineTop: 0.0, lineBottom: 0.0, lineLeft: 0.0, lineRight: 0.0, shapeKey: 0, glyphs: false, lineBreak: false, rtl: false, base: 0 }
  let mut x: f32 = 0.0
  if run caretOf(tree, point, &mut piece, &mut x) {
    rect.* = Rect<f32>.new(x, piece.top, x + 1.0, piece.bottom)
    return true
  }
  let mut box = Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
  if boxOf(tree, point.slot, &mut box) {
    let size = tree.node(point.slot).computed().text.size
    rect.* = Rect<f32>.new(box.xMin, box.yMin, box.xMin + 1.0, box.yMin + size * 1.2)
    return true
  }
  return false
}

/// Queues the edit `inputType` (with `text`) of host `slot`, for the client to make.
effect fn hostEdit(tree: &mut UiTree<'_>, slot: u32, inputType: string, text: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let id = tree.node(slot).id
  run tree.queueFollowUp(Input.Edit { target: id, inputType: run String.copy(inputType), text: run String.copy(text) })
}

/// Text typed or composed while an editing host has focus: an `insertText` edit, or for the
/// input method's composition an `insertCompositionText` one (empty text ends it). False
/// when no host has focus.
pub effect fn hostText(tree: &mut UiTree<'_>, text: string, composing: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let host = focusedHost(&tree.*)
  if host == NONE { return false }
  if !composing && String.byteLength(text) == 0 { return true }
  run hostEdit(&mut tree, host, if composing { "insertCompositionText" } else { "insertText" }, text)
  return true
}

/// A paste's text for the focused editing host: an `insertFromPaste` edit, unless `slot` is
/// not in it.
pub effect fn hostPaste(tree: &mut UiTree<'_>, slot: u32, text: string) -> bool ! OutOfMemoryError ? &mut Allocator {
  let host = focusedHost(&tree.*)
  if host == NONE || slot == NONE || !inside(&tree.*, host, slot) { return false }
  if String.byteLength(text) != 0 { run hostEdit(&mut tree, host, "insertFromPaste", text) }
  return true
}

/// A cut in the focused editing host: copies the selection, then queues its `deleteByCut`.
pub effect fn hostCut(tree: &mut UiTree<'_>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let host = focusedHost(&tree.*)
  if host == NONE { return false }
  if run copy(&mut tree) { run hostEdit(&mut tree, host, "deleteByCut", "") }
  return true
}

/// Undo (or `redo`) from the edit menu for the focused editing host, as a `historyUndo` (or
/// `historyRedo`) edit. False when no host has focus.
pub effect fn hostHistory(tree: &mut UiTree<'_>, redo: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let host = focusedHost(&tree.*)
  if host == NONE { return false }
  run hostEdit(&mut tree, host, if redo { "historyRedo" } else { "historyUndo" }, "")
  return true
}

/// Selects all of the focused editing host. False when no host has focus.
pub effect fn hostSelectAll(tree: &mut UiTree<'_>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let host = focusedHost(&tree.*)
  if host == NONE { return false }
  let start = at(&tree.*, host, 0)
  let end = at(&tree.*, host, childCount(&tree.*, host))
  run select(&mut tree, start, end)
  return true
}

/// The default of a key down in the focused editing host: deleting and line breaks become
/// edits, movement keys move the caret (Shift extends, see `extend`). False for other keys,
/// or when no host has focus.
pub effect fn hostKey(tree: &mut UiTree<'_>, key: string, modifiers: u32) -> bool ! OutOfMemoryError ? &mut Allocator {
  let host = focusedHost(&tree.*)
  if host == NONE { return false }
  let mac = tree.keymap == Keymap.Mac
  let shift = u32.bitAnd(modifiers, MOD_SHIFT) != 0
  let control = u32.bitAnd(modifiers, MOD_CONTROL) != 0
  let alt = u32.bitAnd(modifiers, MOD_ALT) != 0
  let meta = u32.bitAnd(modifiers, MOD_META) != 0
  if key == "Backspace" || key == "Delete" {
    let backward = key == "Backspace"
    let byWord = if mac { alt && !meta && !control } else { control && !alt && !meta }
    let byLine = mac && meta && !alt && !control
    let kind = if byWord { if backward { "deleteWordBackward" } else { "deleteWordForward" } }
      else if byLine { if backward { "deleteSoftLineBackward" } else { "deleteSoftLineForward" } }
      else if backward { "deleteContentBackward" } else { "deleteContentForward" }
    run hostEdit(&mut tree, host, kind, "")
    return true
  }
  // A plain-text host breaks lines only, as Chromium's does.
  let plain = editableValue(&tree.*, host) == 3
  if key == "Enter" && !control && !alt && !meta {
    run hostEdit(&mut tree, host, if shift || plain { "insertLineBreak" } else { "insertParagraph" }, "")
    return true
  }
  let primary = if mac { meta && !control } else { control && !meta }
  if primary && !alt {
    if edit.letter(key, "z") || !mac && !shift && edit.letter(key, "y") {
      run hostEdit(&mut tree, host, if shift || edit.letter(key, "y") { "historyRedo" } else { "historyUndo" }, "")
      return true
    }
    // Rich hosts take the formatting keys as formatting edits.
    let format = if shift || plain { "" } else if edit.letter(key, "b") { "formatBold" } else if edit.letter(key, "i") { "formatItalic" } else if edit.letter(key, "u") { "formatUnderline" } else { "" }
    if format != "" {
      run hostEdit(&mut tree, host, format, "")
      return true
    }
  }
  if shift { return run extend(&mut tree, key, modifiers) }
  run refresh(&mut tree)
  let anchor = tree.textSelection.anchor
  let focus = tree.textSelection.focus
  if !anchor.exists() || !focus.exists() { return false }
  let byWord = if mac { alt && !meta && !control } else { control && !alt && !meta }
  if !anchor.same(focus) && !byWord && !meta && (key == "ArrowLeft" || key == "ArrowRight") {
    // A selection collapses to the end the arrow points at.
    let mut start = Point.none()
    let mut end = Point.none()
    run ordered(&tree.*, &mut start, &mut end)
    let to = if key == "ArrowLeft" { start } else { end }
    tree.textSelection.hasPreferredX = false
    run select(&mut tree, to, to)
    return true
  }
  let mut next = focus
  if !run stepped(&mut tree, key, modifiers, host, &mut next) { return false }
  if next.exists() { run select(&mut tree, next, next) }
  return true
}
