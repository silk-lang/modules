//! The engine comparison: silkjs against V8 jitless, JSC without its JIT, QuickJS and the
//! WebAssembly builds, on Octane and on `bench/microbench.js`.
//!
//! What is easy to get wrong is fixed here: silkjs runs with `SILKJS_PREPARSE_THREADS=0`,
//! `NODE_OPTIONS` and `BUN_OPTIONS` are dropped, engines are interleaved over the rounds, and
//! nothing is measured while a build runs. Octane runs V8 through a loader (code-load needs a
//! global eval), but the micros run node directly: through the loader microbench.js reads its own
//! path as a test name. jsc has no usable `performance`, so its micros run a copy of microbench.js
//! with a `preciseTime` clock in front. wasmtime gets `-W max-wasm-stack=8388608`, an absolute
//! script path and `--dir /`.

import kit as Kit
import kit { Job, Stream, Table }
import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.num.f64
import silk.num.i64
import silk.num.u32
import silk.num.usize

/// What a task of the comparison was asked.
pub struct Asked {
  /// The engine module's directory, `modules/engine`.
  pub root: Bytes,
  /// The work directory; empty means `build/bench` under `root`.
  pub work: Bytes,
  /// The results directory; empty means `results` under the work directory.
  pub out: Bytes,
  /// The silkjs executable; empty means this host's release build.
  pub engine: Bytes,
  /// Comma-separated columns; empty means every installed one.
  pub engines: Bytes,
  /// Rounds; 0 means the task's default.
  pub rounds: u32,
  /// Whether to add the JIT columns.
  pub jit: bool,
  /// Whether to measure although a build runs.
  pub force: bool,
  /// Benchmarks, tests, binaries or setup steps.
  pub names: List<Bytes>,
}

// QuickJS master on 2026-11-11 (version 2026-06-04); the first wasm tables used it.
const QUICKJS_REVISION: &[u8] = b"e585640ffa2cf88ce7c2d587583c6fe15928ec2f"

const WASM_STACK: &[u8] = b"max-wasm-stack=8388608"

// The loader node runs Octane through: `print`, and the script evaluated as a global script.
const NODE_LOADER: &[u8] = b"globalThis.print = console.log.bind(console); require('vm').runInThisContext(require('fs').readFileSync(process.argv[1], 'utf8'), {filename: process.argv[1]});"

// jsc's shell has preciseTime() (seconds). Its `performance` is missing or, in some builds, a
// stub whose now() returns 0; without a clock microbench.js falls back to Date.now, and JSC
// looks about 4% better than it is. Some builds have no `console`.
const JSC_CLOCK: &[u8] = b"globalThis.performance = { now: function () { return preciseTime() * 1000; } };\nif (typeof console === \"undefined\") globalThis.console = { log: print };\n"

/// Where things are for one task.
struct Places {
  root: Bytes,
  work: Bytes,
  out: Bytes,
  silkjs: Bytes,
  node: Bytes,
  jsc: Bytes,
}

effect fn places(asked: &Asked) -> Places
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let root = Bytes.asSlice(&asked.root)
  let work = if Bytes.length(&asked.work) > 0 {
    run Kit.absolute(root, Bytes.asSlice(&asked.work))
  } else {
    run Kit.cat(root, b"/build/bench")
  }
  run Kit.makeDirectories(Bytes.asSlice(&work))
  let out = if Bytes.length(&asked.out) > 0 {
    run Kit.absolute(root, Bytes.asSlice(&asked.out))
  } else {
    run Kit.cat(Bytes.asSlice(&work), b"/results")
  }
  run Kit.makeDirectories(Bytes.asSlice(&out))
  let silkjs = if Bytes.length(&asked.engine) > 0 {
    run Kit.absolute(root, Bytes.asSlice(&asked.engine))
  } else {
    // Where `silk build --release` writes in this workspace: build/<triple>/release at the repository root.
    let machine = run Kit.firstLine(&[b"uname", b"-m"], Bytes.asSlice(&work))
    let architecture: &[u8] = if Kit.same(Bytes.asSlice(&machine), b"x86_64") {
      b"x86_64"
    } else {
      b"aarch64"
    }
    let mut built = run Kit.cat3(root, b"/../../build/", architecture)
    run Bytes.append(&mut built, b"-unknown-linux-gnu/release/silkjs-engine")
    run Kit.absolute(b"/", Bytes.asSlice(&built))
  }
  let nodeName = run Kit.variable(b"NODE_REFERENCE")
  let node = run Kit.locate(
    if Bytes.length(&nodeName) > 0 {
      Bytes.asSlice(&nodeName)
    } else {
      b"node"
    },
    root,
  )
  let jscName = run Kit.variable(b"JSC")
  let jsc = run Kit.locate(
    if Bytes.length(&jscName) > 0 {
      Bytes.asSlice(&jscName)
    } else {
      b"jsc"
    },
    root,
  )
  return Places {
    root: run Bytes.copy(root),
    work: move work,
    out: move out,
    silkjs: move silkjs,
    node: move node,
    jsc: move jsc,
  }
}

effect fn under(base: &Bytes, rest: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Kit.cat(Bytes.asSlice(base), rest)
}

effect fn add(words: &mut List<Bytes>, word: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run List<Bytes>.append(&mut words.*, run Bytes.copy(word))
}

/// The command of the engine column `name`, without the script: empty when it cannot run, with
/// the reason in `why`. With `micro` the command is the one that runs microbench.js, script included.
effect fn command(at: &Places, name: &[u8], micro: bool, why: &mut Bytes) -> List<Bytes>
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut words = List<Bytes>.make()
  let microbench = run under(&at.root, b"/bench/microbench.js")
  if Kit.same(name, b"silkjs") {
    let size = run Kit.fileSize(Bytes.asSlice(&at.silkjs))
    if size < 0 {
      why.* = run Kit.cat(
        Bytes.asSlice(&at.silkjs),
        b" is missing; run `silk build --release`, or pass --engine / set SILKJS_ENGINE",
      )
      return move words
    }
    run add(&mut words, Bytes.asSlice(&at.silkjs))
  } else if Kit.same(name, b"v8-jitless") || Kit.same(name, b"v8-jit") {
    if Bytes.length(&at.node) == 0 {
      why.* = run Bytes.copy(b"node is missing; install Node 24 or set NODE_REFERENCE")
      return move words
    }
    run add(&mut words, Bytes.asSlice(&at.node))
    if Kit.same(name, b"v8-jitless") {
      run add(&mut words, b"--jitless")
    }
    if !micro {
      run add(&mut words, b"-e")
      run add(&mut words, NODE_LOADER)
    }
  } else if Kit.same(name, b"jsc-nojit") || Kit.same(name, b"jsc-jit") {
    if Bytes.length(&at.jsc) == 0 {
      why.* = run Bytes.copy(b"jsc is missing; run `silk task bench-setup jsc`, or set JSC")
      return move words
    }
    run add(&mut words, Bytes.asSlice(&at.jsc))
    if Kit.same(name, b"jsc-nojit") {
      run add(&mut words, b"--useJIT=false")
    }
    if micro {
      let shimmed = run under(&at.work, b"/microbench-jsc.js")
      let source = run Kit.readOrEmpty(Bytes.asSlice(&microbench))
      let text = run Kit.cat(JSC_CLOCK, Bytes.asSlice(&source))
      run Kit.write(Bytes.asSlice(&shimmed), Bytes.asSlice(&text))
      run add(&mut words, Bytes.asSlice(&shimmed))
      return move words
    }
  } else if Kit.same(name, b"qjs") {
    let qjs = run under(&at.work, b"/quickjs/qjs")
    let size = run Kit.fileSize(Bytes.asSlice(&qjs))
    if size < 0 {
      why.* = run Kit.cat(Bytes.asSlice(&qjs), b" is missing; run `silk task bench-setup quickjs`")
      return move words
    }
    run add(&mut words, Bytes.asSlice(&qjs))
  } else if Kit.same(name, b"silkjs-wasm") || Kit.same(name, b"qjs-wasm") {
    let wasmtime = run under(&at.work, b"/tools/wasmtime/wasmtime")
    let module = run under(
      &at.work,
      if Kit.same(name, b"qjs-wasm") {
        b"/wasm/qjs.cwasm"
      } else {
        b"/wasm/silkjs.cwasm"
      },
    )
    let haveRuntime = run Kit.fileSize(Bytes.asSlice(&wasmtime))
    let haveModule = run Kit.fileSize(Bytes.asSlice(&module))
    if haveRuntime < 0 || haveModule < 0 {
      why.* = run Kit.cat(
        Bytes.asSlice(&module),
        b" or wasmtime is missing; run `silk task bench-setup wasmtime wasi-sdk quickjs wasm`",
      )
      return move words
    }

    // WASI has no working directory: scripts are given by absolute path and the filesystem is preopened.
    run add(&mut words, Bytes.asSlice(&wasmtime))
    run add(&mut words, b"run")
    run add(&mut words, b"--allow-precompiled")
    run add(&mut words, b"--dir")
    run add(&mut words, b"/")
    run add(&mut words, b"-W")
    run add(&mut words, WASM_STACK)
    run add(&mut words, Bytes.asSlice(&module))
  } else {
    why.* = run Bytes.copy(
      b"unknown engine; the engines are silkjs v8-jitless jsc-nojit qjs silkjs-wasm qjs-wasm v8-jit jsc-jit",
    )
    return move words
  }
  if micro {
    run add(&mut words, Bytes.asSlice(&microbench))
  }
  return move words
}

/// One engine column: its name and its command.
struct Column {
  name: Bytes,
  words: List<Bytes>,
}

// The chosen columns. Named engines must exist; the default set skips missing ones, except silkjs.
effect fn columns(asked: &Asked, at: &Places, micro: bool) -> List<Column>
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let named = Bytes.length(&asked.engines) > 0
  let chosen = if named {
    run Kit.split(Bytes.asSlice(&asked.engines), 44)
  } else if asked.jit {
    run Kit.split(b"silkjs,v8-jitless,jsc-nojit,qjs,silkjs-wasm,qjs-wasm,v8-jit,jsc-jit", 44)
  } else {
    run Kit.split(b"silkjs,v8-jitless,jsc-nojit,qjs,silkjs-wasm,qjs-wasm", 44)
  }
  let names = List<Bytes>.asSlice(&chosen)
  let mut found = List<Column>.make()
  let mut index: usize = 0
  while index < names.length {
    let name = Bytes.asSlice(&names[index])
    let mut why = Bytes.make()
    let words = run command(at, name, micro, &mut why)
    if List<Bytes>.length(&words) == 0 {
      if named || Kit.same(name, b"silkjs") {
        run Kit.abort(Bytes.asSlice(&(run Kit.cat(name, b": "))), Bytes.asSlice(&why))
      }
      run Kit.note(name, Bytes.asSlice(&(run Kit.cat(b"SKIPPED, ", Bytes.asSlice(&why)))))
    } else {
      let shown = run Kit.join(&words, b" ")
      run Kit.note(name, Bytes.asSlice(&shown))
      run List<Column>.append(&mut found, Column { name: run Bytes.copy(name), words: move words })
    }
    index = index + 1
  }
  return move found
}

// ---------------------------------------------------------------- Octane

// Octane 2: each benchmark and the files that make it, after base.js.
fn octaneFiles(name: &[u8]) -> &'static [u8] {
  if Kit.same(name, b"richards") {
    return b"richards"
  }
  if Kit.same(name, b"deltablue") {
    return b"deltablue"
  }
  if Kit.same(name, b"crypto") {
    return b"crypto"
  }
  if Kit.same(name, b"raytrace") {
    return b"raytrace"
  }
  if Kit.same(name, b"earley-boyer") {
    return b"earley-boyer"
  }
  if Kit.same(name, b"regexp") {
    return b"regexp"
  }
  if Kit.same(name, b"splay") {
    return b"splay"
  }
  if Kit.same(name, b"navier-stokes") {
    return b"navier-stokes"
  }
  if Kit.same(name, b"pdfjs") {
    return b"pdfjs"
  }
  if Kit.same(name, b"mandreel") {
    return b"mandreel"
  }
  if Kit.same(name, b"gbemu") {
    return b"gbemu-part1 gbemu-part2"
  }
  if Kit.same(name, b"code-load") {
    return b"code-load"
  }
  if Kit.same(name, b"box2d") {
    return b"box2d"
  }
  if Kit.same(name, b"zlib") {
    return b"zlib zlib-data"
  }
  if Kit.same(name, b"typescript") {
    return b"typescript typescript-input typescript-compiler"
  }
  return b""
}

const OCTANE: &[u8] = b"richards deltablue crypto raytrace earley-boyer regexp splay navier-stokes pdfjs mandreel gbemu code-load box2d zlib typescript"

const OCTANE_RUNNER: &[u8] = b"var __print = (typeof print === 'function') ? print : console.log.bind(console);\nBenchmarkSuite.RunSuites({\n  NotifyResult: function(name, result) { __print(name + ': ' + result); },\n  NotifyError: function(name, error) { __print(name + ': ERROR ' + error); },\n  NotifyScore: function(score) { }\n});\n"

// base.js and the files of the benchmark `name`, as one script text without a runner.
effect fn octaneSource(at: &Places, name: &[u8]) -> Bytes
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut text = run Bytes.copy(
    b"if (typeof read === 'undefined') var read = function(){ throw new Error('no read'); };\n",
  )
  let files = run Kit.split(octaneFiles(name), 32)
  let parts = List<Bytes>.asSlice(&files)
  let mut index: usize = 0

  // base.js first.
  let base = run under(&at.work, b"/octane/base.js")
  let baseText = run Kit.readOrEmpty(Bytes.asSlice(&base))
  if Bytes.length(&baseText) == 0 {
    run Kit.abort(
      b"no Octane checkout in the work directory; run `silk task bench-setup octane`",
      b"",
    )
  }
  run Bytes.append(&mut text, Bytes.asSlice(&baseText))
  run Bytes.append(&mut text, b"\n")
  while index < parts.length {
    let file = run Kit.cat3(Bytes.asSlice(&at.work), b"/octane/", Bytes.asSlice(&parts[index]))
    let source = run Kit.readOrEmpty(Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&file), b".js"))))
    run Bytes.append(&mut text, Bytes.asSlice(&source))
    run Bytes.append(&mut text, b"\n")
    index = index + 1
  }
  return move text
}

fn wordByte(value: u8) -> bool {
  return (value >= 48 && value <= 57) || (value >= 65 && value <= 90)
    || (value >= 97 && value <= 122)
    || value == 95
}

// Adds each `Name: score` line of `text` to `table` under `column`; answers how many it found.
effect fn scores(text: &[u8], column: &[u8], table: &mut Table) -> usize
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let mut count: usize = 0
  let mut start: usize = 0
  while start < text.length {
    let end = Kit.find(text, b"\n", start)
    let line = Kit.part(text, start, end)
    let mut nameEnd: usize = 0
    while nameEnd < line.length && wordByte(line[nameEnd]) {
      nameEnd = nameEnd + 1
    }
    if nameEnd > 0 && nameEnd + 2 < line.length && line[nameEnd] == 58 && line[nameEnd + 1] == 32
      && !Kit.contains(Kit.part(line, nameEnd + 2, line.length), b" ") {
      let value = Kit.part(line, nameEnd + 2, line.length)
      count = count + 1
      if Kit.numberEnd(value, 0) == value.length {
        run Table.add(&mut table.*, Kit.part(line, 0, nameEnd), column, Kit.number(value))
      } else {
        run Kit.say(Bytes.asSlice(&(run Kit.cat3(b"ERR ", line, b""))))
      }
    }
    start = end + 1
  }
  return count
}

/// Octane, one process per benchmark and engine, interleaved rounds; writes `octane.json`.
pub effect fn octane(asked: &Asked) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let rounds: u32 = if asked.rounds == 0 {
    3
  } else {
    asked.rounds
  }
  run Kit.checkRounds(rounds, 3)
  let at = run places(asked)
  let all = run Kit.split(OCTANE, 32)
  let known = List<Bytes>.asSlice(&all)
  let wantedNames = List<Bytes>.asSlice(&asked.names)
  let mut w: usize = 0
  while w < wantedNames.length {
    if !Kit.listed(&all, Bytes.asSlice(&wantedNames[w])) {
      run Kit.abort(b"unknown Octane benchmark ", Bytes.asSlice(&wantedNames[w]))
    }
    w = w + 1
  }
  run Kit.say(b"== Octane, best score per engine")
  let engines = run columns(asked, &at, false)
  run Kit.note(b"out", Bytes.asSlice(&at.out))
  run Kit.noteDropped()
  run Kit.refuseWhileBuilding(asked.force)
  let scripts = run under(&at.work, b"/scripts")
  run Kit.makeDirectories(Bytes.asSlice(&scripts))
  let mut table = Table.make()
  let mut g: usize = 0
  while g < known.length {
    let group = Bytes.asSlice(&known[g])
    if Kit.wanted(&asked.names, group) {
      let mut source = run octaneSource(&at, group)
      run Bytes.append(&mut source, OCTANE_RUNNER)
      let script = run Kit.cat3(Bytes.asSlice(&scripts), b"/", group)
      let scriptFile = run Kit.cat(Bytes.asSlice(&script), b".js")
      run Kit.write(Bytes.asSlice(&scriptFile), Bytes.asSlice(&source))
      let mut groupTable = Table.make()
      let mut round: u32 = 0
      while round < rounds {
        let columnList = List<Column>.asSlice(&engines)
        let mut e: usize = 0
        while e < columnList.length {
          let mut job = Job.make()
          run Job.word(&mut job, b"timeout")
          run Job.word(&mut job, b"600")
          run Job.wordsOf(&mut job, &columnList[e].words)
          run Job.word(&mut job, Bytes.asSlice(&scriptFile))
          run Job.within(&mut job, Bytes.asSlice(&at.work))
          let captured = run Kit.capture(&mut job, Bytes.asSlice(&at.work))
          let text = Bytes.asSlice(&captured.text)
          let found = run scores(text, Bytes.asSlice(&columnList[e].name), &mut groupTable)
          if found == 0 {
            let tail = Kit.part(
              text,
              if text.length > 300 {
                text.length - 300
              } else {
                0
              },
              text.length,
            )
            run Kit.say(Bytes.asSlice(&(run Kit.cat3(b"FAIL ", group, b" "))))
            run Kit.say2(Bytes.asSlice(&columnList[e].name), tail)
          }
          e = e + 1
        }
        round = round + 1
      }

      // The best score of each engine on this benchmark's lines.
      let cells = List<Kit.Cell>.asSlice(&groupTable.cells)
      let mut c: usize = 0
      while c < cells.length {
        run Table.add(
          &mut table,
          Bytes.asSlice(&cells[c].row),
          Bytes.asSlice(&cells[c].column),
          cells[c].value,
        )
        c = c + 1
      }
      run printBest(&groupTable, true)
      run Kit.write(
        Bytes.asSlice(&(run under(&at.out, b"/octane.json"))),
        Bytes.asSlice(&(run Table.json(&table))),
      )
    }
    g = g + 1
  }
  run Kit.say2(b"scores: ", Bytes.asSlice(&(run under(&at.out, b"/octane.json"))))
  run Kit.say(
    b"Octane score mode is too noisy to compare two builds; use `silk task bench-fixed` for that.",
  )
}

// Prints one line per benchmark of `table`: the best value of each column.
effect fn printBest(table: &Table, highest: bool) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let rows = run Table.rows(table)
  let columnNames = run Table.columns(table)
  let rowList = List<Bytes>.asSlice(&rows)
  let columnList = List<Bytes>.asSlice(&columnNames)
  let mut r: usize = 0
  while r < rowList.length {
    let mut line = Bytes.make()
    run Kit.appendLeft(&mut line, Bytes.asSlice(&rowList[r]), 18)
    let mut c: usize = 0
    while c < columnList.length {
      let found = run Table.values(table, Bytes.asSlice(&rowList[r]), Bytes.asSlice(&columnList[c]))
      let values = List<f64>.asSlice(&found)
      if values.length > 0 {
        run Bytes.append(&mut line, b"  ")
        run Bytes.append(&mut line, Bytes.asSlice(&columnList[c]))
        run Bytes.append(&mut line, b" ")
        run Kit.appendFixed(
          &mut line,
          if highest {
            Kit.most(values)
          } else {
            Kit.least(values)
          },
          if highest {
            0
          } else {
            2
          },
        )
      }
      c = c + 1
    }
    run Kit.say(Bytes.asSlice(&line))
    r = r + 1
  }
}

// ---------------------------------------------------------------- micro benchmarks

// Adds each result line of microbench.js (`name  N  ns`) to `table` under `column`; answers the count.
effect fn microLines(text: &[u8], column: &[u8], table: &mut Table) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut count: usize = 0
  let mut start: usize = 0
  while start < text.length {
    let end = Kit.find(text, b"\n", start)
    let line = Kit.part(text, start, end)
    let mut at: usize = 0
    while at < line.length && (line[at] == 32 || line[at] == 9) {
      at = at + 1
    }
    let nameStart = at
    while at < line.length && wordByte(line[at]) {
      at = at + 1
    }
    let nameEnd = at
    let blankStart = at
    while at < line.length && (line[at] == 32 || line[at] == 9) {
      at = at + 1
    }
    let countEnd = Kit.numberEnd(line, at)
    let wholeCount = countEnd > at && !Kit.contains(Kit.part(line, at, countEnd), b".")
    let mut valueStart = countEnd
    while valueStart < line.length && (line[valueStart] == 32 || line[valueStart] == 9) {
      valueStart = valueStart + 1
    }
    let valueEnd = Kit.numberEnd(line, valueStart)
    let name = Kit.part(line, nameStart, nameEnd)
    if nameEnd > nameStart && at > blankStart && wholeCount && valueStart > countEnd
      && valueEnd > valueStart
      && !Kit.same(name, b"TEST") {
      run Table.add(&mut table.*, name, column, Kit.number(Kit.part(line, valueStart, valueEnd)))
      count = count + 1
    }
    start = end + 1
  }
  return count
}

/// `bench/microbench.js` under each engine, interleaved rounds; writes `micro.json`.
pub effect fn micro(asked: &Asked) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let rounds: u32 = if asked.rounds == 0 {
    3
  } else {
    asked.rounds
  }
  run Kit.checkRounds(rounds, 3)
  let at = run places(asked)
  run Kit.say(b"== micro benchmarks, best ns per test")
  let engines = run columns(asked, &at, true)
  run Kit.note(b"out", Bytes.asSlice(&at.out))
  run Kit.noteDropped()
  run Kit.refuseWhileBuilding(asked.force)
  let mut table = Table.make()
  let hasNames = List<Bytes>.length(&asked.names) > 0
  let mut round: u32 = 0
  while round < rounds {
    let columnList = List<Column>.asSlice(&engines)
    let mut e: usize = 0
    while e < columnList.length {
      let name = Bytes.asSlice(&columnList[e].name)
      let mut job = Job.make()
      run Job.word(&mut job, b"timeout")
      run Job.word(&mut job, b"7200")
      run Job.wordsOf(&mut job, &columnList[e].words)

      // Test names follow the script. jsc's shell wants `--` before a script's arguments and does
      // not pass the script itself, which microbench.js expects first.
      if hasNames && Kit.startsWith(name, b"jsc") {
        run Job.word(&mut job, b"--")
        run Job.word(&mut job, b"microbench.js")
      }
      run Job.wordsOf(&mut job, &asked.names)
      run Job.within(&mut job, Bytes.asSlice(&at.work))
      let captured = run Kit.capture(&mut job, Bytes.asSlice(&at.work))
      let found = run microLines(Bytes.asSlice(&captured.text), name, &mut table)
      let mut line = run Kit.integer(u32.toI64(round))
      run Bytes.append(&mut line, b" ")
      run Bytes.append(&mut line, name)
      run Bytes.append(&mut line, b" ")
      run Kit.appendInteger(&mut line, usize.toI64(found))
      run Bytes.append(&mut line, b" tests")
      run Kit.say(Bytes.asSlice(&line))
      run Kit.write(
        Bytes.asSlice(&(run under(&at.out, b"/micro.json"))),
        Bytes.asSlice(&(run Table.json(&table))),
      )
      e = e + 1
    }
    round = round + 1
  }
  run Kit.say2(b"times: ", Bytes.asSlice(&(run under(&at.out, b"/micro.json"))))
}

// ---------------------------------------------------------------- fixed work

// Iterations of each fixed-work script, as scripts/v8bench.py --instructions runs them.
fn fixedIterations(name: &[u8]) -> u32 {
  if Kit.same(name, b"richards") || Kit.same(name, b"deltablue") {
    return 20
  }
  if Kit.same(name, b"crypto") || Kit.same(name, b"splay") {
    return 4
  }
  if Kit.same(name, b"raytrace") {
    return 8
  }
  if Kit.same(name, b"earley-boyer") || Kit.same(name, b"regexp")
    || Kit.same(name, b"navier-stokes") {
    return 2
  }
  return 0
}

/// Fixed work for comparing builds: the same iterations of each benchmark under each binary,
/// interleaved, and the minimum user time. Under 2% is noise.
pub effect fn fixed(asked: &Asked, only: &[u8], iterations: u32) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let rounds: u32 = if asked.rounds == 0 {
    7
  } else {
    asked.rounds
  }
  run Kit.checkRounds(rounds, 5)
  let at = run places(asked)
  if only.length == 0 {
    run Kit.abort(b"name the benchmarks: --only richards,deltablue", b"")
  }
  let invoked = run Kit.variable(b"SILK_INVOCATION_DIRECTORY")
  let given = List<Bytes>.asSlice(&asked.names)
  if given.length < 2 {
    run Kit.abort(b"give at least two binaries to compare: OLD NEW", b"")
  }
  let mut binaries = List<Bytes>.make()
  let mut b: usize = 0
  while b < given.length {
    let located = run Kit.locate(
      Bytes.asSlice(&given[b]),
      if Bytes.length(&invoked) > 0 {
        Bytes.asSlice(&invoked)
      } else {
        Bytes.asSlice(&at.root)
      },
    )
    if Bytes.length(&located) == 0 {
      run Kit.abort(Bytes.asSlice(&given[b]), b" is not an executable")
    }
    run List<Bytes>.append(&mut binaries, move located)
    b = b + 1
  }
  let names = run Kit.split(only, 44)
  let nameList = List<Bytes>.asSlice(&names)
  let folder = run under(&at.work, b"/fx")
  run Kit.makeDirectories(Bytes.asSlice(&folder))
  let mut n: usize = 0
  while n < nameList.length {
    let name = Bytes.asSlice(&nameList[n])
    if octaneFiles(name).length == 0 {
      run Kit.abort(b"unknown Octane benchmark ", name)
    }
    let count = if iterations > 0 {
      iterations
    } else {
      fixedIterations(name)
    }
    if count == 0 {
      run Kit.abort(
        name,
        b" has no default iteration count; pass --iterations N (aim for about a second per run)",
      )
    }
    let mut source = run octaneSource(&at, name)
    run Bytes.append(
      &mut source,
      b"for (var s=0;s<BenchmarkSuite.suites.length;s++){var b=BenchmarkSuite.suites[s].benchmarks[0]; BenchmarkSuite.ResetRNG(); if (b.Setup) b.Setup(); for (var k=0;k<",
    )
    run Kit.appendInteger(&mut source, u32.toI64(count))
    run Bytes.append(&mut source, b";k++) b.run(); }\n")
    let script = run Kit.cat3(Bytes.asSlice(&folder), b"/fx-", name)
    run Kit.write(
      Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&script), b".js"))),
      Bytes.asSlice(&source),
    )
    n = n + 1
  }
  run Kit.say(b"== fixed work, minimum user seconds; under 2% is noise")
  run Kit.note(b"binaries", Bytes.asSlice(&(run Kit.join(&binaries, b" "))))
  run Kit.noteDropped()
  run Kit.refuseWhileBuilding(asked.force)
  let binaryList = List<Bytes>.asSlice(&binaries)
  n = 0
  while n < nameList.length {
    let name = Bytes.asSlice(&nameList[n])
    let script = run Kit.cat3(Bytes.asSlice(&folder), b"/fx-", name)
    let scriptFile = run Kit.cat(Bytes.asSlice(&script), b".js")
    let mut table = Table.make()
    let mut round: u32 = 0
    while round < rounds {
      b = 0
      while b < binaryList.length {
        let mut job = Job.make()
        run Job.word(&mut job, Bytes.asSlice(&binaryList[b]))
        run Job.word(&mut job, Bytes.asSlice(&scriptFile))
        run Job.within(&mut job, Bytes.asSlice(&folder))
        let ended = run Kit.runJob(&job)
        if !ended.ok {
          run Kit.say2(b"FAIL ", Bytes.asSlice(&binaryList[b]))
        }
        run Table.add(&mut table, name, Bytes.asSlice(&binaryList[b]), ended.userMs / 1000.0)
        b = b + 1
      }
      round = round + 1
    }
    let mut line = Bytes.make()
    run Kit.appendLeft(&mut line, name, 14)
    let firstValues = run Table.values(&table, name, Bytes.asSlice(&binaryList[0]))
    let base = Kit.least(List<f64>.asSlice(&firstValues))
    b = 0
    while b < binaryList.length {
      let values = run Table.values(&table, name, Bytes.asSlice(&binaryList[b]))
      let best = Kit.least(List<f64>.asSlice(&values))
      if b > 0 {
        run Bytes.append(&mut line, b"  ")
      }
      run Bytes.append(&mut line, Bytes.asSlice(&binaryList[b]))
      run Bytes.append(&mut line, b" ")
      run Kit.appendFixed(&mut line, best, 3)
      run Bytes.append(&mut line, b" (")
      run Kit.appendFixed(
        &mut line,
        if base > 0.0 {
          best / base
        } else {
          0.0
        },
        3,
      )
      run Bytes.append(&mut line, b"x)")
      b = b + 1
    }
    run Kit.say(Bytes.asSlice(&line))
    n = n + 1
  }
}

// ---------------------------------------------------------------- report

fn geomean(values: &[f64]) -> f64 {
  if values.length == 0 {
    return 0.0
  }
  let mut sum: f64 = 0.0
  let mut at: usize = 0
  while at < values.length {
    sum = sum + f64.log(values[at])
    at = at + 1
  }
  return f64.exp(sum / usize.toF64(values.length))
}

fn best(values: &[f64], highest: bool) -> f64 {
  if highest {
    return Kit.most(values)
  }
  return Kit.least(values)
}

// A value in a 12-byte column: no decimals at 100 and above, one below.
effect fn appendValue(line: &mut Bytes, value: f64, wide: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = run Kit.fixed(
    value,
    if wide {
      0
    } else {
      1
    },
  )
  run Kit.appendPadded(&mut line.*, Bytes.asSlice(&text), 12)
}

// The table with the WebAssembly columns. Octane is the best score (higher is better), micros the
// best ns per operation (lower is better). The ratios are above 1 where silkjs-wasm is faster.
effect fn wasmTable(table: &Table, highest: bool) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let order = run Kit.split(
    b"silkjs,v8-jitless,jsc-nojit,qjs,silkjs-wasm,qjs-wasm,v8-jit,jsc-jit",
    44,
  )
  let present = run Table.columns(table)
  let mut names = List<Bytes>.make()
  let ordered = List<Bytes>.asSlice(&order)
  let mut o: usize = 0
  while o < ordered.length {
    if Kit.listed(&present, Bytes.asSlice(&ordered[o])) {
      run List<Bytes>.append(&mut names, run Bytes.copy(Bytes.asSlice(&ordered[o])))
    }
    o = o + 1
  }
  let columnList = List<Bytes>.asSlice(&names)
  let mut head = Bytes.make()
  run Kit.appendLeft(&mut head, b"bench", 24)
  let mut c: usize = 0
  while c < columnList.length {
    run Kit.appendPadded(&mut head, Bytes.asSlice(&columnList[c]), 12)
    c = c + 1
  }
  run Kit.appendPadded(&mut head, b"wasm/qjs-wasm", 14)
  run Kit.appendPadded(&mut head, b"wasm/native", 13)
  run Kit.say(Bytes.asSlice(&head))
  let rows = run Table.rows(table)
  let rowList = List<Bytes>.asSlice(&rows)
  let mut againstQjs = List<f64>.make()
  let mut againstNative = List<f64>.make()
  let mut r: usize = 0
  while r < rowList.length {
    let row = Bytes.asSlice(&rowList[r])
    if !Kit.same(row, b"total") {
      let mut line = Bytes.make()
      run Kit.appendLeft(&mut line, row, 24)
      let mut largest: f64 = 0.0
      c = 0
      while c < columnList.length {
        let found = run Table.values(table, row, Bytes.asSlice(&columnList[c]))
        let value = best(List<f64>.asSlice(&found), highest)
        if value > largest {
          largest = value
        }
        c = c + 1
      }
      let mut wasm: f64 = 0.0
      let mut qjsWasm: f64 = 0.0
      let mut native: f64 = 0.0
      c = 0
      while c < columnList.length {
        let column = Bytes.asSlice(&columnList[c])
        let found = run Table.values(table, row, column)
        if List<f64>.length(&found) == 0 {
          run Kit.appendPadded(&mut line, b"-", 12)
        } else {
          let value = best(List<f64>.asSlice(&found), highest)
          run appendValue(&mut line, value, largest >= 100.0)
          if Kit.same(column, b"silkjs-wasm") {
            wasm = value
          }
          if Kit.same(column, b"qjs-wasm") {
            qjsWasm = value
          }
          if Kit.same(column, b"silkjs") {
            native = value
          }
        }
        c = c + 1
      }
      if wasm > 0.0 && qjsWasm > 0.0 {
        let ratio = if highest {
          wasm / qjsWasm
        } else {
          qjsWasm / wasm
        }
        run List<f64>.append(&mut againstQjs, ratio)
        run Kit.appendPadded(&mut line, Bytes.asSlice(&(run Kit.fixed(ratio, 2))), 14)
      } else {
        run Kit.appendPadded(&mut line, b"-", 14)
      }
      if wasm > 0.0 && native > 0.0 {
        let ratio = if highest {
          wasm / native
        } else {
          native / wasm
        }
        run List<f64>.append(&mut againstNative, ratio)
        run Kit.appendPadded(&mut line, Bytes.asSlice(&(run Kit.fixed(ratio, 2))), 13)
      } else {
        run Kit.appendPadded(&mut line, b"-", 13)
      }
      run Kit.say(Bytes.asSlice(&line))
    }
    r = r + 1
  }
  if List<f64>.length(&againstQjs) > 0 || List<f64>.length(&againstNative) > 0 {
    let mut line = run Bytes.copy(b"geomean: silkjs-wasm is ")
    run Kit.appendFixed(&mut line, geomean(List<f64>.asSlice(&againstQjs)), 2)
    run Bytes.append(&mut line, b"x qjs-wasm and ")
    run Kit.appendFixed(&mut line, geomean(List<f64>.asSlice(&againstNative)), 2)
    run Bytes.append(&mut line, b"x native silkjs (above 1 means silkjs-wasm is faster)")
    run Kit.say(Bytes.asSlice(&line))
  }
}

effect fn bestOf(table: &Table, row: &[u8], column: &[u8], highest: bool) -> f64
  ! OutOfMemoryError
  ? &mut Allocator {
  let found = run Table.values(table, row, column)
  return best(List<f64>.asSlice(&found), highest)
}

// The native-only table: silkjs against V8 jitless and JSC without its JIT, the JIT columns for
// context, then the micro tests where silkjs is more than 3% slower than either.
effect fn nativeTable(octaneTable: &Table, microTable: &Table, everyTest: bool) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let mut head = Bytes.make()
  run Kit.appendLeft(&mut head, b"bench", 16)
  run Kit.appendPadded(&mut head, b"silkjs", 9)
  run Kit.appendPadded(&mut head, b"v8-jitless", 11)
  run Kit.appendPadded(&mut head, b"jsc-nojit", 11)
  run Kit.appendPadded(&mut head, b"vsV8", 8)
  run Kit.appendPadded(&mut head, b"vsJSC", 8)
  run Kit.appendPadded(&mut head, b"v8-jit", 10)
  run Kit.appendPadded(&mut head, b"jsc-jit", 10)
  run Kit.say(Bytes.asSlice(&head))
  let rows = run Table.rows(octaneTable)
  let rowList = List<Bytes>.asSlice(&rows)
  let mut againstV8 = List<f64>.make()
  let mut againstJsc = List<f64>.make()
  let mut r: usize = 0
  while r < rowList.length {
    let row = Bytes.asSlice(&rowList[r])
    let silk = run bestOf(octaneTable, row, b"silkjs", true)
    let v8 = run bestOf(octaneTable, row, b"v8-jitless", true)
    let jsc = run bestOf(octaneTable, row, b"jsc-nojit", true)
    if silk > 0.0 && v8 > 0.0 {
      run List<f64>.append(&mut againstV8, silk / v8)
    }
    if silk > 0.0 && jsc > 0.0 {
      run List<f64>.append(&mut againstJsc, silk / jsc)
    }
    let mut line = Bytes.make()
    run Kit.appendLeft(&mut line, row, 16)
    run Kit.appendPadded(&mut line, Bytes.asSlice(&(run Kit.fixed(silk, 0))), 9)
    run Kit.appendPadded(&mut line, Bytes.asSlice(&(run Kit.fixed(v8, 0))), 11)
    run Kit.appendPadded(&mut line, Bytes.asSlice(&(run Kit.fixed(jsc, 0))), 11)
    run Kit.appendPadded(
      &mut line,
      Bytes.asSlice(
        &(run Kit.fixed(
          if v8 > 0.0 {
            silk / v8
          } else {
            0.0
          },
          2,
        )),
      ),
      8,
    )
    run Kit.appendPadded(
      &mut line,
      Bytes.asSlice(
        &(run Kit.fixed(
          if jsc > 0.0 {
            silk / jsc
          } else {
            0.0
          },
          2,
        )),
      ),
      8,
    )
    run Kit.appendPadded(
      &mut line,
      Bytes.asSlice(&(run Kit.fixed(run bestOf(octaneTable, row, b"v8-jit", true), 0))),
      10,
    )
    run Kit.appendPadded(
      &mut line,
      Bytes.asSlice(&(run Kit.fixed(run bestOf(octaneTable, row, b"jsc-jit", true), 0))),
      10,
    )
    run Kit.say(Bytes.asSlice(&line))
    r = r + 1
  }
  let mut summary = run Bytes.copy(b"geomean ratio vs v8 ")
  run Kit.appendFixed(&mut summary, geomean(List<f64>.asSlice(&againstV8)), 2)
  run Bytes.append(&mut summary, b" vs jsc ")
  run Kit.appendFixed(&mut summary, geomean(List<f64>.asSlice(&againstJsc)), 2)
  run Kit.say(Bytes.asSlice(&summary))

  // Micros are times: a ratio above 1 means silkjs is slower.
  let tests = run Table.rows(microTable)
  let testList = List<Bytes>.asSlice(&tests)
  let mut slowerV8 = List<f64>.make()
  let mut slowerJsc = List<f64>.make()
  let mut countV8: i64 = 0
  let mut countJsc: i64 = 0
  let mut counted: i64 = 0
  let mut detail = Bytes.make()
  let mut t: usize = 0
  while t < testList.length {
    let test = Bytes.asSlice(&testList[t])
    let silk = run bestOf(microTable, test, b"silkjs", false)
    if !Kit.same(test, b"total") && silk > 0.0 {
      let v8 = run bestOf(microTable, test, b"v8-jitless", false)
      let jsc = run bestOf(microTable, test, b"jsc-nojit", false)
      let toV8 = if v8 > 0.0 {
        silk / v8
      } else {
        0.0
      }
      let toJsc = if jsc > 0.0 {
        silk / jsc
      } else {
        0.0
      }
      counted = counted + 1
      if toV8 > 0.0 {
        run List<f64>.append(&mut slowerV8, toV8)
      }
      if toJsc > 0.0 {
        run List<f64>.append(&mut slowerJsc, toJsc)
      }
      if toV8 > 1.03 {
        countV8 = countV8 + 1
      }
      if toJsc > 1.03 {
        countJsc = countJsc + 1
      }
      if everyTest || toV8 > 1.03 || toJsc > 1.03 {
        run Bytes.append(&mut detail, b"  ")
        run Kit.appendLeft(&mut detail, test, 24)
        run Kit.appendPadded(&mut detail, Bytes.asSlice(&(run Kit.fixed(silk, 1))), 10)
        run Kit.appendPadded(&mut detail, Bytes.asSlice(&(run Kit.fixed(v8, 1))), 10)
        run Kit.appendPadded(&mut detail, Bytes.asSlice(&(run Kit.fixed(jsc, 1))), 10)
        run Kit.appendPadded(&mut detail, Bytes.asSlice(&(run Kit.fixed(toV8, 2))), 7)
        run Kit.appendPadded(&mut detail, Bytes.asSlice(&(run Kit.fixed(toJsc, 2))), 6)
        run Bytes.append(&mut detail, b"\n")
      }
    }
    t = t + 1
  }
  let mut line = run Bytes.copy(b"micro: ")
  run Kit.appendInteger(&mut line, counted)
  run Bytes.append(&mut line, b" tests; geomean silk/v8 ")
  run Kit.appendFixed(&mut line, geomean(List<f64>.asSlice(&slowerV8)), 2)
  run Bytes.append(&mut line, b" (")
  run Kit.appendInteger(&mut line, countV8)
  run Bytes.append(&mut line, b" slower), silk/jsc ")
  run Kit.appendFixed(&mut line, geomean(List<f64>.asSlice(&slowerJsc)), 2)
  run Bytes.append(&mut line, b" (")
  run Kit.appendInteger(&mut line, countJsc)
  run Bytes.append(&mut line, b" slower)")
  run Kit.say(Bytes.asSlice(&line))
  run Kit.print(Bytes.asSlice(&detail))
}

/// Prints the tables from `octane.json` and `micro.json` of the results directory: the one with
/// the WebAssembly columns, or with `native` the native-only one.
pub effect fn report(asked: &Asked, native: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let at = run places(asked)
  let octaneText = run Kit.readOrEmpty(Bytes.asSlice(&(run under(&at.out, b"/octane.json"))))
  let microText = run Kit.readOrEmpty(Bytes.asSlice(&(run under(&at.out, b"/micro.json"))))
  if Bytes.length(&octaneText) == 0 {
    run Kit.abort(
      Bytes.asSlice(&at.out),
      b"/octane.json is missing; run `silk task bench-octane` first (or pass --out)",
    )
  }
  let octaneTable = run Table.parse(Bytes.asSlice(&octaneText))
  let microTable = run Table.parse(Bytes.asSlice(&microText))
  if native {
    run nativeTable(&octaneTable, &microTable, false)
    return ()
  }
  run Kit.say(b"Octane (score, higher is better)")
  run wasmTable(&octaneTable, true)
  if Bytes.length(&microText) > 0 {
    run Kit.say(b"\nMicro (ns/op, lower is better)")
    run wasmTable(&microTable, false)
  }
}

// ---------------------------------------------------------------- setup

effect fn unpack(at: &Places, url: &[u8], name: &[u8], flag: &[u8], marker: &[u8]) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let target = run Kit.cat3(Bytes.asSlice(&at.work), b"/tools/", name)
  let present = run Kit.fileSize(
    Bytes.asSlice(&(run Kit.cat3(Bytes.asSlice(&target), b"/", marker))),
  )
  if present >= 0 {
    return ()
  }
  let downloads = run under(&at.work, b"/downloads")
  run Kit.makeDirectories(Bytes.asSlice(&downloads))
  run Kit.makeDirectories(Bytes.asSlice(&target))
  let archive = run Kit.cat3(Bytes.asSlice(&downloads), b"/", name)
  run Kit.download(url, Bytes.asSlice(&archive))
  run Kit.sh(
    &[
      b"tar",
      flag,
      Bytes.asSlice(&archive),
      b"-C",
      Bytes.asSlice(&target),
      b"--strip-components",
      b"1",
    ],
    b"",
  )
}

/// Installs the reference engines into the work directory. Steps: node jsc octane quickjs
/// wasmtime wasi-sdk wasm; `asked.names` selects some of them.
pub effect fn setup(asked: &Asked) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  run Kit.checkNames(
    &asked.names,
    &[b"node", b"jsc", b"octane", b"quickjs", b"wasmtime", b"wasi-sdk", b"wasm"],
    b"setup step",
  )
  let mut at = run places(asked)
  let work = Bytes.asSlice(&at.work)
  let machine = run Kit.firstLine(&[b"uname", b"-m"], work)
  if Kit.wanted(&asked.names, b"node") {
    run Kit.say(b"-- node")
    if Bytes.length(&at.node) == 0 {
      run Kit.abort(
        b"node is missing; install Node 24 or set NODE_REFERENCE (the tables use Node 24 for V8)",
        b"",
      )
    }
    let version = run Kit.firstLine(&[Bytes.asSlice(&at.node), b"--version"], work)
    run Kit.note(Bytes.asSlice(&at.node), Bytes.asSlice(&version))
    if !Kit.startsWith(Bytes.asSlice(&version), b"v24.") {
      run Kit.warn(b"the tables use Node 24 for the V8 columns; set NODE_REFERENCE to one", b"")
    }
  }
  if Kit.wanted(&asked.names, b"jsc") {
    run Kit.say(b"-- jsc")
    if Bytes.length(&at.jsc) == 0 {
      let _installed = run Kit.aptInstall(
        &[
          b"libjavascriptcoregtk-bin",
          b"libjavascriptcoregtk-6.0-bin",
          b"libjavascriptcoregtk-4.1-bin",
        ],
      )
      at.jsc = run Kit.locate(b"jsc", work)
    }
    if Bytes.length(&at.jsc) == 0 {
      run Kit.abort(
        b"no jsc after installing the JavaScriptCore shell package; install it and set JSC",
        b"",
      )
    }
    run Kit.note(b"jsc", Bytes.asSlice(&at.jsc))
  }
  if Kit.wanted(&asked.names, b"octane") {
    run Kit.say(b"-- octane")
    let checkout = run under(&at.work, b"/octane")
    let present = run Kit.fileSize(
      Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&checkout), b"/base.js"))),
    )
    if present < 0 {
      run Kit.sh(
        &[
          b"git",
          b"clone",
          b"-q",
          b"--depth",
          b"1",
          b"https://github.com/chromium/octane",
          Bytes.asSlice(&checkout),
        ],
        b"",
      )
    }
    run Kit.note(b"octane", Bytes.asSlice(&checkout))
  }
  let quickjs = run under(&at.work, b"/quickjs")
  if Kit.wanted(&asked.names, b"quickjs") {
    run Kit.say(b"-- quickjs")
    let cloned = run Kit.exists(Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&quickjs), b"/.git"))))
    if !cloned {
      run Kit.sh(
        &[b"git", b"clone", b"-q", b"https://github.com/bellard/quickjs", Bytes.asSlice(&quickjs)],
        b"",
      )
    }
    run Kit.sh(&[b"git", b"-C", Bytes.asSlice(&quickjs), b"checkout", b"-q", QUICKJS_REVISION], b"")
    let built = run Kit.fileSize(Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&quickjs), b"/qjs"))))
    if built < 0 {
      run Kit.sh(&[b"make", b"-s", b"-C", Bytes.asSlice(&quickjs), b"-j4", b"qjs"], b"")
    }
  }
  if Kit.wanted(&asked.names, b"wasmtime") {
    run Kit.say(b"-- wasmtime")
    let mut url = run Kit.cat(
      b"https://github.com/bytecodealliance/wasmtime/releases/download/v45.0.0/wasmtime-v45.0.0-",
      Bytes.asSlice(&machine),
    )
    run Bytes.append(&mut url, b"-linux.tar.xz")
    run unpack(&at, Bytes.asSlice(&url), b"wasmtime", b"xJf", b"wasmtime")
  }
  if Kit.wanted(&asked.names, b"wasi-sdk") {
    run Kit.say(b"-- wasi-sdk")
    let mut url = run Kit.cat(
      b"https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-33/wasi-sdk-33.0-",
      Bytes.asSlice(&machine),
    )
    run Bytes.append(&mut url, b"-linux.tar.gz")
    run unpack(&at, Bytes.asSlice(&url), b"wasi-sdk", b"xzf", b"bin/clang")
  }
  if Kit.wanted(&asked.names, b"wasm") {
    // silkjs.wasm and qjs.wasm, precompiled by wasmtime with the stack setting they run with.
    run Kit.say(b"-- wasm")
    let wasm = run under(&at.root, b"/bench/wasm")
    let modules = run under(&at.work, b"/wasm")
    run Kit.makeDirectories(Bytes.asSlice(&modules))
    let wasmtime = run under(&at.work, b"/tools/wasmtime/wasmtime")
    let sdk = run under(&at.work, b"/tools/wasi-sdk")
    let haveRuntime = run Kit.fileSize(Bytes.asSlice(&wasmtime))
    let haveSdk = run Kit.fileSize(
      Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&sdk), b"/bin/clang"))),
    )
    let haveSource = run Kit.fileSize(
      Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&quickjs), b"/quickjs.c"))),
    )
    if haveRuntime < 0 || haveSdk < 0 || haveSource < 0 {
      run Kit.abort(b"the wasm step needs the wasmtime, wasi-sdk and quickjs steps first", b"")
    }
    let mut build = Job.make()
    run Job.word(&mut build, Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&wasm), b"/build.sh"))))
    build.output = Stream.shared()
    build.errors = Stream.shared()
    run Kit.say(
      b"   $ bench/wasm/build.sh   (needs SILK_CLANG: a Clang 22 or newer with wasm-ld beside it)",
    )
    run Kit.must(&build)
    let mut reference = Job.make()
    run Job.word(
      &mut reference,
      Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&wasm), b"/quickjs/build.sh"))),
    )
    run Job.word(&mut reference, Bytes.asSlice(&quickjs))
    run Job.word(
      &mut reference,
      Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&wasm), b"/build/qjs.wasm"))),
    )
    run Job.set(&mut reference, b"WASI_SDK", Bytes.asSlice(&sdk))
    reference.output = Stream.shared()
    reference.errors = Stream.shared()
    run Kit.say(b"   $ bench/wasm/quickjs/build.sh")
    run Kit.must(&reference)
    run Kit.sh(
      &[
        Bytes.asSlice(&wasmtime),
        b"compile",
        b"-W",
        WASM_STACK,
        Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&wasm), b"/build/silkjs.wasm"))),
        b"-o",
        Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&modules), b"/silkjs.cwasm"))),
      ],
      b"",
    )
    run Kit.sh(
      &[
        Bytes.asSlice(&wasmtime),
        b"compile",
        b"-W",
        WASM_STACK,
        Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&wasm), b"/build/qjs.wasm"))),
        b"-o",
        Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&modules), b"/qjs.cwasm"))),
      ],
      b"",
    )
  }
  run Kit.say2(b"ready: ", work)
}
