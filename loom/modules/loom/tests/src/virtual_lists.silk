//! Virtual list integration tests through real layout, scrolling, focus, and view diff.
import ui_tree.css
import ui_tree.css { px }
import loom.app { App, Context, NoCommand }
import loom.runtime { Runtime, pump }
import loom_tree.lib { frame }
import loom.ui { Ui }
import loom.lib { drain, Document, Node, NoOutput, Program, Update }
import loom.program as program
import loom_dom.dom { Dom }
import loom_dom.wire { word, float }
import silk.collections.bytes { Bytes }
import ui_tree.mutation { Role }
import silk.num.u64
import loom.virtual_list { VirtualOptions }
import ui_tree.legacy { UiTree, TreeError, Batch, FrameInput, findAll }
import ui_tree.mutation { Mutation }
import ui_fixtures.fixtures as fixtures
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.f32
import silk.num.usize

struct Example {
  count: usize,
  revision: u64,
  visible: bool
}

union Message {
  Nothing
}

impl App<Message, NoCommand> for Example {
  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {
    drop message
  }

  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    // A lazy ancestor must not freeze the runtime's mounted range.
    ui.lazy(
      1,
      |ui| {
        ui.column(
          |ui| {
            ui.testId("port")
            ui.height(px(300.0))
            if !self.visible {
              return ()
            }
            ui.virtualItems(
              1,
              self.count,
              VirtualOptions {
                estimatedHeight: 80.0,
                overscan: 150.0,
                gap: 5.0,
                revision: self.revision,
              },
              |i| usize.toU64(
                if self.revision == 0 {
                  i
                } else {
                  self.count - 1 - i
                },
              ),
              |ui, i| {
                ui.testId("row")
                ui.height(px(40.0 + usize.toF32(i % 3) * 30.0))
                ui.tabIndex(0)
              },
            )
          },
        )
      },
    )
  }
}

fn viewport() -> FrameInput {
  return FrameInput { width: 400.0, height: 400.0, scale: 1.0, time: 0.0 }
}

effect fn body() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut app = Runtime<Example, Message, NoCommand>.make(
    Example { count: 10000, revision: 0, visible: true },
  )
  run app.start(&mut tree, 0.0)
  run frame(&mut app, &mut tree, viewport())
  let mut found = List<u32>.make()
  run findAll(&tree, "port", &mut found)
  let port = found.get(0)
  found.clear()
  run findAll(&tree, "row", &mut found)
  run Testing.expect(found.length() > 2 && found.length() < 20, "only nearby rows are mounted")
  let focused = found.get(1)
  let mut batch = Batch.make()
  run batch.push(Mutation.Focus { id: focused })
  run tree.apply(run batch.take())
  drop run pump(&mut app, &mut tree)
  run batch.push(Mutation.ScrollTo { id: port, x: 0.0, y: 200000.0 })
  run tree.apply(run batch.take())
  drop run pump(&mut app, &mut tree)
  run frame(&mut app, &mut tree, viewport())
  run Testing.expect(
    tree.node(tree.focused).id == focused,
    "focused row remains mounted across a distant jump",
  )
  let indices = &app.ui.virtualLists.asSlice()[0].indices
  run Testing.expect(
    indices.get(0) == 1 && indices.get(1) > 1000,
    "distant jump requests far rows inside a lazy ancestor, and keeps the focused one",
  )
  run Testing.expect(tree.stats.nodes < 50, "distant jump keeps the UI tree bounded")
  let list = &tree.virtualLists.asSlice()[0]
  run Testing.expect(
    list.prefix(list.first) <= list.scroll && list.prefix(list.end) >= list.scroll + list.height,
    "mounted rows cover the viewport after measurement corrections",
  )
  let anchor = list.locate(list.scroll)
  let offset = list.scroll - list.prefix(anchor)
  run frame(&mut app, &mut tree, FrameInput { width: 600.0, height: 400.0, scale: 1.0, time: 0.0 })
  let resized = &tree.virtualLists.asSlice()[0]
  run Testing.expect(
    resized.locate(resized.scroll) == anchor
      && f32.abs(resized.scroll - resized.prefix(anchor) - offset) < 0.5,
    "width invalidation preserves the visible item and its offset",
  )
  app.model.revision = 1
  run app.render(&mut tree)
  drop run pump(&mut app, &mut tree)
  run Testing.expect(
    tree.node(tree.focused).id == focused,
    "focus follows its stable key across reordering before another layout",
  )
  run frame(&mut app, &mut tree, viewport())
  let revised = &tree.virtualLists.asSlice()[0]
  run Testing.expect(
    revised.locate(revised.scroll) == anchor,
    "content revision preserves the visible logical index",
  )
  run batch.push(Mutation.Blur)
  run batch.push(Mutation.ScrollTo { id: port, x: 0.0, y: 0.0 })
  run tree.apply(run batch.take())
  drop run pump(&mut app, &mut tree)
  run frame(&mut app, &mut tree, viewport())
  run Testing.expect(tree.scrollOffset(port).y == 0.0, "return to top is exact")
  app.model.count = 0
  run app.render(&mut tree)
  run frame(&mut app, &mut tree, viewport())
  run Testing.expect(tree.stats.nodes < 10, "empty list releases mounted rows")
  app.model.visible = false
  run app.render(&mut tree)
  run Testing.expect(
    tree.contains(port),
    "ordinary scroll container survives removing virtual content",
  )
  run Testing.expect(
    app.ui.virtualLists.length() == 0 && tree.virtualLists.length() == 0,
    "removing a list releases view bookkeeping and tree measurements",
  )
}

struct Feed {
  /// Item keys, top to bottom.
  items: List<u64>,
}

union FeedMessage {
  Prepend,
}

type FeedNext = Update<Feed, NoCommand, NoOutput>

impl Program<FeedMessage, NoCommand> for Feed {
  effect fn init() -> FeedNext
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut items = List<u64>.make()
    let mut i: u64 = 0
    while i < 5000 {
      run items.append(i)
      i = i + 1
    }
    return FeedNext.of(Feed { items: move items })
  }

  effect fn update(mut model: Feed, message: FeedMessage) -> FeedNext
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      FeedMessage.Prepend => {
        let fresh = 100000 + usize.toU64(model.items.length())
        run model.items.insert(0, fresh)
      }
    }
    return FeedNext.of(move model)
  }

  fn view(model: &Feed, h: &Document<FeedMessage>) -> Node {
    return h.virtualList(
      7,
      model.items.length(),
      VirtualOptions { estimatedHeight: 40.0, overscan: 100.0, gap: 0.0, revision: 0 },
      &[h.testId("feed"), h.style(&[css.height(px(300.0))])],
      |i| model.items.get(i),
      |i| h.box(&[h.testId("item"), h.tabIndex(0), h.style(&[css.height(px(40.0))])], &[h.number(u64.toI64(model.items.get(i)))]),
    )
  }
}

effect fn documentBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut app = run program.make<Feed, FeedMessage, NoCommand>()
  run app.start(&mut tree, 0.0)
  run frame(&mut app, &mut tree, viewport())
  let mut found = List<u32>.make()
  run findAll(&tree, "feed", &mut found)
  let port = found.get(0)
  found.clear()
  run findAll(&tree, "item", &mut found)
  run Testing.expect(found.length() > 6 && found.length() < 30, "h.virtualList builds only nearby rows")
  let row = tree.node(tree.slotOf(found.get(2))).parent
  run Testing.expect(
    tree.node(row).accessRole == Role.ListItem && tree.node(tree.slotOf(port)).accessRole == Role.List,
    "the column is a list of list items",
  )
  let focused = found.get(2)
  let mut batch = Batch.make()
  run batch.push(Mutation.Focus { id: focused })
  run batch.push(Mutation.ScrollTo { id: port, x: 0.0, y: 100000.0 })
  run tree.apply(run batch.take())
  drop run pump(&mut app, &mut tree)
  run frame(&mut app, &mut tree, viewport())
  run Testing.expect(tree.node(tree.focused).id == focused, "the focused row stays across a distant jump")
  let indices = &app.ui.virtualLists.asSlice()[0].indices
  run Testing.expect(indices.get(0) == 2 && indices.get(1) > 2000, "far rows and the focused one are requested")
  app.send(FeedMessage.Prepend)
  run drain(&mut app, &mut tree)
  run frame(&mut app, &mut tree, viewport())
  run Testing.expect(tree.node(tree.focused).id == focused, "an item inserted above keeps the focused row")
  run Testing.expect(
    app.ui.virtualLists.asSlice()[0].indices.get(0) == 3,
    "at its new index, found by its key",
  )

  // An unchanged render emits zero mutations for an already-bound virtual list.
  run app.render(&mut tree)
  run Testing.expect(app.stats.mutations == 0, "unchanged virtual list sends no redundant mutations")
}

struct TransitionBox {
  dim: bool,
}

impl App<Message, NoCommand> for TransitionBox {
  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {
    drop message
  }

  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    let opacity: f32 = if self.dim { 0.2 } else { 1.0 }
    ui.box(
      |ui| {
        ui.width(px(100.0))
        ui.height(px(100.0))
        ui.style(&[css.opacity(opacity)])
        ui.transition("opacity 0.5s linear")
      },
    )
  }
}

effect fn activeTransitionFrameBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut app = Runtime<TransitionBox, Message, NoCommand>.make(TransitionBox { dim: false })
  run app.start(&mut tree, 0.0)
  run frame(&mut app, &mut tree, FrameInput { width: 200.0, height: 200.0, scale: 1.0, time: 0.0 })
  app.model.dim = true
  run app.render(&mut tree)
  let before = tree.frameNumber
  run frame(&mut app, &mut tree, FrameInput { width: 200.0, height: 200.0, scale: 1.0, time: 0.05 })
  run Testing.expect(tree.needsFrame(), "mid-transition still requests the next frame")
  run Testing.expect(
    tree.frameNumber == before + 1,
    "active transition runs one layout+paint pass per frame, not eight",
  )
}

/// A page's report for one list (see `loom_dom.virtual`), written where the page writes it.
effect fn report(dom: &mut Dom, port: u32, scroll: f32, focused: u32, sizes: &[u32]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut bytes = Bytes.make()
  run word(&mut bytes, 1)
  run word(&mut bytes, port)
  run float(&mut bytes, scroll)
  run float(&mut bytes, 300.0)
  run word(&mut bytes, focused)
  run word(&mut bytes, 0)
  run word(&mut bytes, usize.toU32(sizes.length))
  let mut i: usize = 0
  while i < sizes.length {
    run word(&mut bytes, sizes[i])
    run float(&mut bytes, 60.0)
    i = i + 1
  }
  drop run dom.reserve(bytes.length())
  let target = dom.scratch.asMutSlice()
  let source = bytes.asSlice()
  i = 0
  while i < source.length {
    target[i] = source[i]
    i = i + 1
  }
  return run dom.reportVirtual(bytes.length())
}

effect fn pageBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut dom = Dom.make()
  dom.setViewport(400.0, 400.0)
  let mut app = run program.make<Feed, FeedMessage, NoCommand>()
  run app.start(&mut dom, 0.0)
  run drain(&mut app, &mut dom)
  let port = app.ui.arena.entry(app.ui.virtualLists.asSlice()[0].port).id
  drop run report(&mut dom, port, 0.0, 0, &[])
  drop run app.syncVirtual(&mut dom)
  let list = &app.ui.virtualLists.asSlice()[0]
  run Testing.expect(list.rows.length() > 6 && list.rows.length() < 20, "a page mounts the rows around its viewport")
  let focused = app.ui.arena.entry(list.rows.get(2).entry).id
  let measured = app.ui.arena.entry(list.rows.get(0).entry).id
  drop run report(&mut dom, port, 50000.0, focused, &[measured])
  drop run app.syncVirtual(&mut dom)
  let far = &app.ui.virtualLists.asSlice()[0].indices
  run Testing.expect(
    far.get(0) == 2 && far.get(1) > 1000 && far.length() < 20,
    "a distant scroll mounts far rows and keeps the focused one",
  )
  drop run report(&mut dom, port, 50000.0, 0, &[])
  drop run app.syncVirtual(&mut dom)
  run Testing.expect(app.ui.virtualLists.asSlice()[0].indices.get(0) > 1000, "a blurred row is let go")

  // Rows measured at the top, then a distant scroll, then an item added at the top: the
  // measurements stay with their items, so a far row moves down by one estimate only.
  drop run report(&mut dom, port, 0.0, 0, &[])
  drop run app.syncVirtual(&mut dom)
  let top = &app.ui.virtualLists.asSlice()[0]
  let mut sizes = List<u32>.make()
  let mut r: usize = 0
  while r < top.rows.length() {
    run sizes.append(app.ui.arena.entry(top.rows.get(r).entry).id)
    r = r + 1
  }
  drop run report(&mut dom, port, 0.0, 0, sizes.asSlice())
  drop run app.syncVirtual(&mut dom)
  drop run report(&mut dom, port, 50000.0, 0, &[])
  drop run app.syncVirtual(&mut dom)
  let before = dom.virtualPrefix(port, 4000)
  run Testing.expect(before > 4000.0 * 40.0, "the measured rows count in the far rows' place")
  app.send(FeedMessage.Prepend)
  run drain(&mut app, &mut dom)
  run Testing.expect(dom.virtualPrefix(port, 4001) == before + 40.0,
    "an item added at the top moves the rest by its estimate, keeping their measurements")
}

test effect fn pageList() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pageBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn documentList() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run documentBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn measuredList() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn activeTransitionRunsOnePassPerFrame() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run activeTransitionFrameBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
