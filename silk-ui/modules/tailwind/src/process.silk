//! The processor child, owned until the wrapped task ends.
static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
import silk.cli.task { Task, TaskError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { FileError, Path }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.subprocess { Subprocess, SubprocessError, SpawnOptions, Stdio, ExitStatus }

/// One environment variable a started program gets besides the task's own.
pub struct Variable<'a> {
  pub name: string<'static>,
  pub value: string<'a>,
}

/// A started program.
pub struct Child {
  process: Subprocess,
  running: bool,
  code: i32,
}

/// Starts `program` (looked up on `PATH` when it has no `/`) with `arguments` in `directory`,
/// sharing the task's terminal and environment, plus `variables`. Does not wait for it.
pub effect fn start(program: string, arguments: &[string], directory: string, variables: &[Variable<'_>]) -> Child
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator {
  // env looks the program up on PATH, as a shell does.
  let env = run Path.make("/usr/bin/env")
  let within = run Path.make(directory)
  let mut request = run ChildProcess.requestWithin(&env, &within)
  run ChildProcess.addArgument(&mut request, program)
  let mut at: usize = 0
  while at < arguments.length {
    run ChildProcess.addArgument(&mut request, arguments[at])
    at = at + 1
  }
  run Subprocess.inheritEnvironment(&mut request)
  at = 0
  while at < variables.length {
    run ChildProcess.setVariable(&mut request, variables[at].name, variables[at].value)
    at = at + 1
  }
  let mut options = SpawnOptions.make()
  run options.setStdio(0, Stdio.inherit(0))
  run options.setStdio(1, Stdio.inherit(1))
  run options.setStdio(2, Stdio.inherit(2))
  return match move run Effect.result(Subprocess.spawn(&request, &options)) {
    Result<Subprocess, SubprocessError | OutOfMemoryError>.Success { value } => Child { process: move value, running: true, code: 0 }
    Result<Subprocess, SubprocessError | OutOfMemoryError>.Failure { error } => {
      drop error
      run Task.abort("ui-tailwind: a program could not be started")
    }
  }
}

impl Child {
  /// Whether it has ended, collecting its status when it has.
  pub fn ended(self: &mut Self) -> bool {
    if !self.running { return true }
    let result = run Effect.result(Subprocess.tryWait(self.process.pid()))
    match move result {
      Result<Option<ExitStatus>, SubprocessError>.Success { value } => match move value {
        Option<ExitStatus>.Some { value: status } => {
          self.running = false
          self.code = if status.signaled { 128 + status.signal } else { status.code }
        }
        Option<ExitStatus>.None => {}
      }
      Result<Option<ExitStatus>, SubprocessError>.Failure { error } => {
        drop error
        self.running = false
        self.code = 1
      }
    }
    return !self.running
  }

  /// Waits for it to end, and answers its exit status.
  pub fn wait(self: &mut Self) -> i32 {
    while !self.ended() { pause(50) }
    return self.code
  }

  /// Asks it to end (SIGTERM), then makes it (SIGKILL) if it has not after five seconds.
  pub fn stop(self: &mut Self) -> () {
    if self.ended() { return () }
    drop run Effect.result(Subprocess.kill(self.process.pid(), 15))
    let mut waited: u32 = 0
    while !self.ended() {
      if waited == 100 { drop run Effect.result(Subprocess.kill(self.process.pid(), 9)) }
      pause(50)
      waited = waited + 1
    }
  }
}

/// Waits `milliseconds`.
pub fn pause(milliseconds: u64) -> () {
  let mut clock = OsMonotonicClock.make()
  run MonotonicClock.waitFor(milliseconds * 1000000) |> Effect.provideMut<MonotonicClock>(&mut clock)
}
} else {
import silk.cli.task { Task, TaskError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError }

pub struct Variable<'a> {
  pub name: string<'static>,
  pub value: string<'a>,
}

/// Starting programs beside the tasks needs subprocess support Silk has only on macOS and Linux.
pub struct Child {}

pub effect fn start(program: string, arguments: &[string], directory: string, variables: &[Variable<'_>]) -> Child
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator {
  run Task.abort("ui-tailwind: starting programs needs Windows subprocess support in Silk")
}

impl Child {
  pub fn ended(self: &mut Self) -> bool { return true }
  pub fn wait(self: &mut Self) -> i32 { return 0 }
  pub fn stop(self: &mut Self) -> () {}
}

pub fn pause(milliseconds: u64) -> () {}
}
