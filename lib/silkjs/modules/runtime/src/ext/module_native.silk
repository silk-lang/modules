//! Host 19000 is moduleNative: the loader's reads, answered by the program's [`ModuleResolver`].
//! `moduleNative(op, path, follow)`: op 0 is the file type bits of `path` (`mode & 0o170000`),
//! op 1 its canonical path, op 2 its source as a string. A failure is a negative errno, which
//! the bootstrap turns into Node's error for that call.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjs.js_std_support as text
import libs.core.common as common
import libs.core.host
import libs.core.capabilities { Composition }

pub const ID: u32 = 19000

pub unsafe effect fn dispatch<'m, C: Composition>(engine: &mut Engine<'m, host.Services<C>>, context: *mut HeapHeader, argv: &FrameSlots) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let op = (unsafe common.argument(argv, 0)).numericValue()
  let path = run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(unsafe common.argument(argv, 1)))
  if op == 0.0 {
    let follow = (unsafe common.argument(argv, 2)).numericValue() != 0.0
    return ValueBits.Int { value: run Composition.modulesKind(&engine.*, path.asSlice(), follow) }
  }
  let mut into = List<u8>.make()
  let status = if op == 1.0 { run Composition.modulesRealpath(&engine.*, path.asSlice(), &mut into) } else { run Composition.modulesRead(&engine.*, path.asSlice(), &mut into) }
  if status < 0 { return ValueBits.Int { value: status } }
  return (run text.string(&mut engine, unsafe lendRealm(&context, context), into.asSlice())).intoBits()
}
