//! Stage 5 Engine tests: declarative `PreventDefaultRules`, `EditOwnership` & `InputFilter`,
//! optimistic `SetValue` vs `ForceValue`, IME composition deferral, `DRAG_REGION`, and `collectSnapshot`.
import ui_fixtures.fixtures as fixtures
import ui_protocol.editing { AllowedChars, CaseTransform, EditConfig, InputFilter }
import ui_protocol.mutation {
  Attribute,
  LISTEN_BEFORE_INPUT,
  LISTEN_CLIPBOARD,
  LISTEN_INPUT,
  Mutation,
  NodeKind
}
import ui_protocol.prevent {
  KeyMatchKind,
  KeyRule,
  KeyRuleEffect,
  PREVENT_BEFORE_INPUT,
  PREVENT_COPY,
  PREVENT_KEYS,
  PREVENT_SCROLL,
  PreventDefaultRules
}
import ui_tree.css
import ui_tree.css { px }
import ui_tree.legacy {
  Batch,
  Event,
  EventKind,
  FlexDirection,
  FrameInput,
  Input,
  MOD_CONTROL,
  Overflow,
  UiTree,
  TreeError
}
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn viewport() -> FrameInput {
  return FrameInput { width: 320.0, height: 240.0, scale: 1.0, time: 0.0 }
}

effect fn drain(tree: &mut UiTree<'_>) -> List<Event>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut events = List<Event>.make()
  run tree.takeEvents(&mut events)
  return move events
}

effect fn key(tree: &mut UiTree<'_>, name: string, modifiers: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run tree.dispatch(
    Input.KeyDown {
      key: run String.copy(name),
      code: run String.copy(name),
      modifiers: modifiers,
      repeat: false,
    },
  )
  run tree.dispatch(
    Input.KeyUp { key: run String.copy(name), code: run String.copy(name), modifiers: modifiers },
  )
}

fn inputValue<'t>(tree: &'t UiTree<'_>, id: u32) -> string<'t> {
  return String.view(&tree.node(tree.slotOf(id)).text)
}

effect fn rulesBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  // 1. Unit evaluation: flags, exact key+modifiers, key classes, default-deny, composition guard.
  let mut rules = PreventDefaultRules.fromActions(PREVENT_SCROLL)
  run rules.preventKey("Tab", 0, 0, true)
  run rules.preventKey("k", MOD_CONTROL, MOD_CONTROL, false)
  run rules.preventNamedKeys(0, 0, true)
  run Testing.expect(rules.matchesKey("Tab", "Tab", 0, false), "exact Tab rule prevents when not composing")
  run Testing.expect(!rules.matchesKey("Tab", "Tab", 0, true), "requireNotComposing skips during composition")
  run Testing.expect(rules.matchesKey("k", "KeyK", MOD_CONTROL, false), "Ctrl+k rule matches")
  run Testing.expect(!rules.matchesKey("k", "KeyK", 0, false), "unmodified k stays allowed")
  run Testing.expect(rules.matchesKey("F5", "F5", 0, false), "NamedKeys catches function keys")
  run Testing.expect(rules.matchesKey("ArrowDown", "ArrowDown", 0, false), "NamedKeys catches navigation keys")
  run Testing.expect(!rules.matchesKey("a", "KeyA", 0, false), "printable letter stays allowed")

  let allowEnter = KeyRule {
    action: KeyRuleEffect.Allow,
    matchKind: KeyMatchKind.LogicalKey,
    value: run String.copy("Enter"),
    modifiersMask: 0,
    modifiersValue: 0,
    anyModifierMask: 0,
    requireNotComposing: false,
    caseInsensitive: false,
  }
  let mut denyAll = PreventDefaultRules.empty()
  run denyAll.preventAllKeysExcept(&[move allowEnter], false)
  run Testing.expect(!denyAll.matchesKey("Enter", "Enter", 0, false), "allow exception passes default-deny")
  run Testing.expect(denyAll.matchesKey("x", "KeyX", 0, false), "non-excepted key is prevented by default-deny")

  // 2. Tree integration: PREVENT_SCROLL stops wheel scroll, PREVENT_BEFORE_INPUT skips edit apply.
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(1, &[css.width(px(300.0)), css.height(px(200.0)), css.flexDirection(FlexDirection.Column)])
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.style(2, &[css.width(px(300.0)), css.height(px(100.0)), css.overflowY(Overflow.Scroll)])
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  run batch.style(3, &[css.width(px(280.0)), css.height(px(400.0))])
  run batch.create(4, NodeKind.Input)
  run batch.append(1, 4)
  run batch.style(4, &[css.width(px(200.0)), css.height(px(40.0))])
  run batch.focus(4)
  let mut list = run batch.take()
  let scrollRules = run Box<PreventDefaultRules>.make(PreventDefaultRules.fromActions(PREVENT_SCROLL))
  run list.append(Mutation.SetAttribute { id: 2, attribute: Attribute.PreventRules { rules: move scrollRules } })
  let mut inputRules = PreventDefaultRules.fromActions(PREVENT_BEFORE_INPUT | PREVENT_COPY | PREVENT_KEYS)
  run inputRules.preventKey("a", 0, 0, false)
  let inputRulesBox = run Box<PreventDefaultRules>.make(move inputRules)
  run list.append(Mutation.SetAttribute { id: 4, attribute: Attribute.PreventRules { rules: move inputRulesBox } })
  run list.append(Mutation.SetListeners { id: 4, flags: LISTEN_INPUT | LISTEN_BEFORE_INPUT | LISTEN_CLIPBOARD })
  run tree.apply(move list)
  run tree.frame(viewport())

  run tree.dispatch(Input.Wheel { x: 20.0, y: 20.0, deltaX: 0.0, deltaY: 80.0, modifiers: 0 })
  run Testing.expect(tree.node(tree.slotOf(2)).scrollY() == 0.0, "PREVENT_SCROLL blocks wheel scrolling on Engine without App reply")

  run tree.dispatch(Input.TextInput { text: run String.copy("abc") })
  run Testing.expect(inputValue(&tree, 4) == "", "PREVENT_BEFORE_INPUT keeps text unchanged without Reply.Prevent")
  drop run drain(&mut tree)
}

test effect fn stage5PreventDefaultRulesAndModifiers() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rulesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn ownershipBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(1, &[css.width(px(300.0)), css.height(px(200.0)), css.flexDirection(FlexDirection.Column)])
  run batch.create(10, NodeKind.Input)
  run batch.append(1, 10)
  run batch.style(10, &[css.width(px(200.0)), css.height(px(32.0))])
  run batch.create(11, NodeKind.Input)
  run batch.append(1, 11)
  run batch.style(11, &[css.width(px(200.0)), css.height(px(32.0))])
  run batch.create(12, NodeKind.Input)
  run batch.append(1, 12)
  run batch.style(12, &[css.width(px(200.0)), css.height(px(32.0))])
  run batch.focus(10)

  let mut list = run batch.take()
  // Filtered input (id 11): uppercase ASCII hex, max 4 scalars.
  let filter = InputFilter {
    maxLength: 4,
    allowedChars: AllowedChars.AsciiHex,
    allowed: String.make(),
    caseTransform: CaseTransform.Upper,
    rejectWhitespace: true,
  }
  let cfgFiltered = run Box<EditConfig>.make(EditConfig.filtered(move filter))
  run list.append(Mutation.SetAttribute { id: 11, attribute: Attribute.EditMode { config: move cfgFiltered } })
  // AppOwned input (id 12)
  let cfgApp = run Box<EditConfig>.make(EditConfig.appOwned())
  run list.append(Mutation.SetAttribute { id: 12, attribute: Attribute.EditMode { config: move cfgApp } })
  run list.append(Mutation.SetListeners { id: 10, flags: LISTEN_INPUT })
  run list.append(Mutation.SetListeners { id: 11, flags: LISTEN_INPUT })
  run list.append(Mutation.SetListeners { id: 12, flags: LISTEN_INPUT | LISTEN_BEFORE_INPUT })
  run tree.apply(move list)
  run tree.frame(viewport())

  // EngineOwned optimistic typing + SetValue stale rejection vs matching acceptance.
  run tree.dispatch(Input.TextInput { text: run String.copy("hi") })
  run Testing.expect(inputValue(&tree, 10) == "hi", "EngineOwned applies typing synchronously")
  let rev1 = tree.node(tree.slotOf(10)).edit().revision
  run Testing.expect(rev1 == 1, "EngineOwned advances input revision to 1")
  drop run drain(&mut tree)

  // Stale SetValue (baseRevision 0 != 1) must be ignored and emit a "reconcile" Input record.
  let mut staleBatch = List<Mutation>.make()
  run staleBatch.append(Mutation.SetValue { id: 10, value: run String.copy("stale"), baseRevision: 0 })
  run tree.apply(move staleBatch)
  run Testing.expect(inputValue(&tree, 10) == "hi", "stale SetValue is rejected when revision mismatches")
  let staleEvents = run drain(&mut tree)
  let mut sawStaleReconcile = false
  let staleSlice = staleEvents.asSlice()
  let mut si: usize = 0
  while si < staleSlice.length {
    if staleSlice[si].kind == EventKind.Input && String.view(&staleSlice[si].inputType) == "reconcile" {
      sawStaleReconcile = true
    }
    si = si + 1
  }
  run Testing.expect(sawStaleReconcile, "rejected stale SetValue emits reconcile Input record")

  // Matching SetValue (baseRevision 1 == 1) updates value cleanly.
  let mut matchBatch = List<Mutation>.make()
  run matchBatch.append(Mutation.SetValue { id: 10, value: run String.copy("ok"), baseRevision: rev1 })
  run tree.apply(move matchBatch)
  run Testing.expect(inputValue(&tree, 10) == "ok", "matching baseRevision SetValue applies")

  // IME composition deferral: SetValue during active preedit is deferred until composition ends.
  run tree.dispatch(Input.ImePreedit { text: run String.copy("か"), selectionStart: 0, selectionEnd: 3 })
  let revBeforeCompose = tree.node(tree.slotOf(10)).edit().revision
  let mut deferBatch = List<Mutation>.make()
  run deferBatch.append(Mutation.SetValue { id: 10, value: run String.copy("sync"), baseRevision: revBeforeCompose })
  run tree.apply(move deferBatch)
  run Testing.expect(inputValue(&tree, 10) == "ok", "SetValue defers while IME composition is active")
  run tree.dispatch(Input.ImePreedit { text: String.make(), selectionStart: 0, selectionEnd: 0 })
  run Testing.expect(inputValue(&tree, 10) == "sync", "ending composition flushes deferred SetValue")
  drop run drain(&mut tree)

  // Filtered input (id 11): uppercases hex, strips 'z', caps at 4 scalars.
  let mut fBatch = Batch.make()
  run fBatch.focus(11)
  run tree.apply(run fBatch.take())
  run tree.dispatch(Input.TextInput { text: run String.copy("1z aF99") })
  run Testing.expect(inputValue(&tree, 11) == "1AF9", "Filtered enforces AllowedChars, CaseTransform.Upper, rejectWhitespace, and maxLength")
  drop run drain(&mut tree)

  // AppOwned input (id 12): no optimistic echo on TextInput; ForceValue overrides unconditionally.
  let mut aBatch = Batch.make()
  run aBatch.focus(12)
  run tree.apply(run aBatch.take())
  run tree.dispatch(Input.TextInput { text: run String.copy("typed") })
  run Testing.expect(inputValue(&tree, 12) == "", "AppOwned does not echo text without ForceValue")
  let appEvents = run drain(&mut tree)
  let mut sawBefore = false
  let appSlice = appEvents.asSlice()
  let mut ai: usize = 0
  while ai < appSlice.length {
    if appSlice[ai].kind == EventKind.BeforeInput && String.view(&appSlice[ai].value) == "typed" {
      sawBefore = true
    }
    ai = ai + 1
  }
  run Testing.expect(sawBefore, "AppOwned emits BeforeInput record with attempted text")
  let mut forceBatch = List<Mutation>.make()
  run forceBatch.append(Mutation.ForceValue { id: 12, value: run String.copy("FORCED") })
  run tree.apply(move forceBatch)
  run Testing.expect(inputValue(&tree, 12) == "FORCED", "ForceValue overrides unconditionally")
  let forceEvents = run drain(&mut tree)
  let mut sawForceReconcile = false
  let forceSlice = forceEvents.asSlice()
  let mut fi: usize = 0
  while fi < forceSlice.length {
    if forceSlice[fi].kind == EventKind.Input && String.view(&forceSlice[fi].inputType) == "reconcile" {
      sawForceReconcile = true
    }
    fi = fi + 1
  }
  run Testing.expect(sawForceReconcile, "ForceValue emits reconcile Input record")
}

test effect fn stage5EditOwnershipFilteringAndReconcile() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run ownershipBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn snapshotDragBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(1, &[css.width(px(300.0)), css.height(px(200.0)), css.flexDirection(FlexDirection.Column)])
  run batch.create(20, NodeKind.Box)
  run batch.append(1, 20)
  run batch.style(20, &[css.width(px(200.0)), css.height(px(40.0))])
  run batch.create(21, NodeKind.Box)
  run batch.append(20, 21)
  run batch.style(21, &[css.width(px(40.0)), css.height(px(40.0))])
  run batch.create(22, NodeKind.Input)
  run batch.append(1, 22)
  run batch.style(22, &[css.width(px(160.0)), css.height(px(30.0))])
  run batch.focus(22)

  let mut list = run batch.take()
  run list.append(Mutation.SetAttribute { id: 20, attribute: Attribute.DragRegion { value: true } })
  run list.append(Mutation.SetAttribute { id: 21, attribute: Attribute.DragRegion { value: false } })
  let mut subIds = List<u32>.make()
  run subIds.append(20)
  run subIds.append(22)
  run list.append(Mutation.SubscribeGeometry { ids: move subIds })
  run tree.apply(move list)
  run tree.frame(viewport())

  run Testing.expect(!tree.isDragRegionAt(10.0, 10.0), "NoDrag child (id 21 at 0..40) excludes drag region")
  run Testing.expect(tree.isDragRegionAt(100.0, 10.0), "Drag parent (id 20 outside child) matches drag region")
  run Testing.expect(!tree.isDragRegionAt(50.0, 120.0), "outside drag region returns false")

  run tree.dispatch(Input.TextInput { text: run String.copy("abc") })
  let snap = run tree.collectSnapshot(3, 99)
  run Testing.expect(snap.windowGroupId == 3 && snap.appliedSeq == 99, "collectSnapshot preserves groupId and appliedSeq")
  run Testing.expect(snap.focusedNode == 22, "collectSnapshot records focused node")
  run Testing.expect(snap.nodeGeometry(20).isSome() && snap.nodeGeometry(22).isSome(), "collectSnapshot includes subscribed nodes")
  let rev = match snap.inputRevision(22) {
    Option<u64>.Some { value } => value
    Option<u64>.None => 0
  }
  run Testing.expect(rev == 1, "collectSnapshot exposes current input revision")
}

test effect fn stage5DragRegionsAndCollectSnapshot() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run snapshotDragBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
