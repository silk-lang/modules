import silk.build.plan { Plan }
import silk.build.step { sourcePath }

static fn plan() -> Plan {
  let mut plan = Plan.empty()
  if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan
      |> Plan.compileSources(
        "c",
        Plan.archivePath("silkjs-nghttp2", "lib"),
        "*.c",
        &[
          "-O2",
          "-w",
          "-DBUILDING_NGHTTP2",
          "-DNGHTTP2_STATICLIB",
          "-DHAVE_ARPA_INET_H=1",
          "-DHAVE_NETINET_IN_H=1",
          "-DHAVE_CLOCK_GETTIME=1",
          "-DHAVE_DECL_CLOCK_MONOTONIC=1",
        ],
        &[
          Plan.archivePath("silkjs-nghttp2", "lib/includes"),
          Plan.archivePath("silkjs-nghttp2", "lib"),
        ],
      )
  }
  return plan
}

pub const PLAN: Plan = plan()
