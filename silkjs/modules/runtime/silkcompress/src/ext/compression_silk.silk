effect fn newJob() -> *mut Job ! OutOfMemoryError {
  let j = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(run allocate(Layout.of<Job>().bytes))
  unsafe Pointer.put<Job>(j, Job { next: Pointer.null<Job>(), work: pool.job(silkCompressionSilkWork, silkCompressionSilkAfterWork, unsafe raw(j), pool.KIND_ZLIB), callback: ValueBits.Undefined, done: false, handle: Pointer.null<Handle>(), stream: Pointer.null<CodecState>(), op: 0, numbers: [0; 8], data: [nil(); 8], lengths: [0; 8], output: nil(), capacity: 0, written: 0, consumed: 0, status: 0, finished: false, again: false, pledgedSize: 0, message: b"", flush: 0, source: nil(), sourceLength: 0, target: nil(), views: [ValueBits.Undefined; 2], leaseIn: Option<buffers.BufferReadLease>.none(), leaseOut: Option<buffers.BufferReadLease>.none(), stagedOut: false, direct: false, words: ValueBits.Undefined }) return j
}
// Destroys a job on the loop thread, after it lets go of the write op's buffers.
unsafe fn dropJob<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, p: *mut Job) -> () {
  let mut anchor = () let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p) unsafe unbind(&mut engine, context, &mut j) drop j
  unsafe destroyJob(p)
}
unsafe fn destroyJob(p: *mut Job) -> () { let j = unsafe Pointer.take<Job>(p) let mut i: usize = 0 while i < 8 { unsafe free(j.data[i]) i = i + 1 } unsafe free(j.output) unsafe free(unsafe raw(p)) }
unsafe extern "C" fn memcpy(destination: *mut u8, source: *mut u8, count: usize) -> ?*mut u8
// Copies `count` bytes of `backing` from `offset` to `destination`: one copy for private bytes,
// relaxed loads for shared memory.
unsafe fn copyIn(destination: ?*mut u8, backing: buffers.BufferState, offset: usize, count: usize) -> () {
  if count == 0 { return () }
  if backing.physicalCapacity == 0 {
    let _copied = unsafe memcpy(unsafe nonnull(destination), unsafe buffers.dataAt(backing.data, usize.toU64(offset)), count)
    return ()
  }
  let mut n: usize = 0
  while n < count { unsafe Pointer.put<u8>(unsafe at(destination, n), u64.toU8(unsafe buffers.loadScalar(backing, usize.toU64(offset + n), 0))) n = n + 1 }
}
// Copies `count` bytes from `source` into `backing` at `offset`.
unsafe fn copyOut(backing: buffers.BufferState, offset: usize, source: *mut u8, count: usize) -> () {
  if count == 0 { return () }
  if backing.physicalCapacity == 0 {
    let _copied = unsafe memcpy(unsafe buffers.dataAt(backing.data, usize.toU64(offset)), source, count)
    return ()
  }
  let mut n: usize = 0
  while n < count { unsafe buffers.storeScalar(backing, usize.toU64(offset + n), 0, u8.toU64(unsafe Pointer.read<u8>(unsafe at(unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(source), n)))) n = n + 1 }
}
// The write op's buffer `index` (0 input, 1 output) as an ArrayBuffer, with its range checked.
unsafe effect fn writeBuffer<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, j: &Job, index: usize) -> buffers.BufferState ! OutOfMemoryError | JsException ? &mut Allocator {
  let offset = j.lengths[3 + index * 3] let length = j.lengths[4 + index * 3]
  let value = j.views[index]
  let empty = match value { ValueBits.Undefined => true ValueBits.Null => true _ => false }
  if empty {
    if length != 0 { let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid compression buffer range") }
    return buffers.BufferState { data: nil(), byteLength: 0, maxByteLength: 0, detached: false, shared: false, external: false, physicalCapacity: 0 }
  }
  let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value))
  if backing.detached || usize.toU64(offset) > backing.byteLength || usize.toU64(length) > backing.byteLength - usize.toU64(offset) {
    let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid compression buffer range")
  }
  return backing
}
// Sets up the write op for a codec call on this thread: the caller's bytes when they are
// private, else staging copies.
unsafe effect fn bindNow<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, j: &mut Job) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let input = run unsafe writeBuffer(&mut engine, context, &j.*, 0)
  let output = run unsafe writeBuffer(&mut engine, context, &j.*, 1)
