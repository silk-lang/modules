//! Tests of ext/inet, the address conversions that replace libuv's uv_ip*_addr and uv_ip*_name:
//! `silk test --root src/inet_tests.silk`. The expected texts are libuv's (inet_ntop6) and Node's.
import silk.mem.pointer { Pointer }
import silk.collections.slice { Slice }
import silk.testing.testing { Testing, AssertionError }
import silk.num.i32
import silk.num.u8
import silk.num.usize
import ext.inet as inet

type Failures = AssertionError<'static>

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 }
  return true
}
// The text inet's parsing and formatting give for `input`, as an IPv6 or IPv4 sockaddr.
fn roundTrip(input: &[u8], out: &mut [u8; 64]) -> usize {
  let mut address: [u8; 28] = [0; 28]
  let pointer = Pointer.fromMutRef<u8>(&mut address[0])
  if unsafe inet.ip4Sockaddr(input, 80, pointer) != 0 && unsafe inet.ip6Sockaddr(input, 80, pointer) != 0 { return 0 }
  let n = unsafe inet.sockaddrText(Pointer.fromRef<u8>(&address[0]), &mut out.*)
  return if n < 0 { 0 } else { i32.toUsize(n) }
}
fn formats(input: &[u8], expected: &[u8]) -> bool {
  let mut out: [u8; 64] = [0; 64]
  let n = roundTrip(input, &mut out)
  return same(Slice.view<u8>(&out, 0, n), expected)
}

test effect fn ipv4Texts() -> () ! Failures {
  run Testing.expect(formats(b"127.0.0.1", b"127.0.0.1"), "loopback")
  run Testing.expect(formats(b"0.0.0.0", b"0.0.0.0"), "zeros")
  run Testing.expect(formats(b"255.10.200.9", b"255.10.200.9"), "one, two and three digits")
  run Testing.expect(!formats(b"256.0.0.1", b"256.0.0.1"), "an octet over 255 is not an address")
}

test effect fn ipv6TextsAsInetNtop() -> () ! Failures {
  run Testing.expect(formats(b"::", b"::"), "all zeros")
  run Testing.expect(formats(b"::1", b"::1"), "loopback")
  run Testing.expect(formats(b"2001:DB8:0:0:0:0:0:1", b"2001:db8::1"), "the zero run compressed, lowercase")
  run Testing.expect(formats(b"1:0:0:1:0:0:0:1", b"1:0:0:1::1"), "the longest run")
  run Testing.expect(formats(b"1:0:0:1:0:0:1:1", b"1::1:0:0:1:1"), "the first of two runs as long")
  run Testing.expect(formats(b"1:0:1:1:1:1:1:1", b"1:0:1:1:1:1:1:1"), "a single zero group stays")
  run Testing.expect(formats(b"0:0:1::", b"0:0:1::"), "a trailing run")
  run Testing.expect(formats(b"::ffff:1.2.3.4", b"::ffff:1.2.3.4"), "IPv4-mapped, dotted")
  run Testing.expect(formats(b"::1.2.3.4", b"::1.2.3.4"), "IPv4-compatible, dotted")
  run Testing.expect(formats(b"fe80::1%no-such-interface", b"fe80::1"), "a zone does not change the address")
}

test effect fn sockaddrLayout() -> () ! Failures {
  let mut address: [u8; 28] = [0; 28]
  let status = unsafe inet.ip6Sockaddr(b"::1", 443, Pointer.fromMutRef<u8>(&mut address[0]))
  run Testing.expect(status == 0 && address[2] == 1 && address[3] == 187, "the port in network order")
  run Testing.expect(address[23] == 1, "the address after the flow information")
  run Testing.expect(unsafe inet.ip6Sockaddr(b"not an address", 1, Pointer.fromMutRef<u8>(&mut address[0])) == -22, "UV_EINVAL")
}
