# Template: build.sh writes silk.toml with the Silk UI checkout under test and the library
# revisions that checkout pins.
[package]
name = "silk-direct"
version = "0.1.0"
silk-version = "@SILK_VERSION@"

[dependencies]
ui_tree = { path = "@SILKUI@/modules/tree", package = "ui-tree" }
ui_tree_window = { path = "@SILKUI@/modules/tree/window", package = "ui-tree-window" }
ui_inspect_server = { path = "@SILKUI@/modules/inspect/server", package = "ui-inspect-server" }
font_collection = { git = "https://github.com/silk-lang/lib-fonts.git", rev = "@LIB_FONTS@", path = "modules/collection", package = "font-collection" }
atlas = { git = "https://github.com/silk-lang/lib-graphics.git", rev = "@LIB_GRAPHICS@", path = "modules/atlas", package = "graphics-atlas" }
vector = { git = "https://github.com/silk-lang/lib-graphics.git", rev = "@LIB_GRAPHICS@", path = "modules/vector", package = "graphics-vector" }
window = { git = "https://github.com/silk-lang/lib-native.git", rev = "@LIB_NATIVE_WINDOW@", path = "modules/platform/window", package = "platform-window" }
webgpu = { git = "https://github.com/silk-lang/lib-native.git", rev = "@LIB_NATIVE_GPU@", path = "modules/gpu/webgpu", package = "gpu-webgpu" }
