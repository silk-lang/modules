//! Shared String intrinsic ownership and coercion boundaries. Inputs are borrowed.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.simd.u8x16
import silk.simd.mask16
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_realm { Realm, Arguments }
import js_gc { HeapHooks }
import js_coercion_host { CoercionHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_string_types { StringLengthError, latin1Bytes, stringReference }
import js_strings { Strings }
import js_integer_coercions as integers
import js_primitives as primitive
import js_regexp_intrinsics_support as shared
import js_proxy_core as core
import js_runtime as runtime
import js_atom_data as atoms
import js_caught { FailedJs, failedJs, FailedOomJs, failedOomJs, FailedOomLength, failedOomLength }

pub effect fn materializeValue<'a, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, error: OutOfMemoryError | StringLengthError | JsException) -> ValueBits ! JsException ? &mut Allocator {
  return run shared.materialize(&mut hooks, realm, move error)
}
@inlineAlways
pub effect fn check<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  if value.view().tag() == 2 || value.view().tag() == 3 { return run core.throwCalledOnNullish(&mut hooks, realm, b"String.prototype") }
}
@inlineAlways
pub effect fn string<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> Value ! JsException ? &mut Allocator {
  // A flat string receiver converts to itself.
  match value.view() { ValueBits.String { .. } => { return value.dup() } _ => {} }
  run check(&mut hooks, realm, value)
  return run shared.string(&mut hooks, realm, value)
}
/// ToString that consumes `value`, released through the hooks once the text exists.
pub effect fn stringFree<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: Value) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<JsException>(shared.string(&mut hooks, realm, value.borrow()), failedJs)
  unsafe shared.release(&mut hooks, realm, value.intoBits())
  return match move result { Value output => move output FailedJs { error } => { fail move error } }
}
@inlineAlways
pub effect fn slice<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, start: usize, end: usize) -> ValueBits ! JsException ? &mut Allocator {
  if start == end { return run core.atomValue(&mut hooks, realm, atoms.JS_ATOM_empty_string) }
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(Strings.substring(value.view(), start, end), failedOomLength)
  return match move result {
    ValueBits output => output
    FailedOomLength { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
@inlineAlways
pub effect fn index<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> i32 ! JsException ? &mut Allocator {
  match value.view() { ValueBits.Int { value: integer } => { return integer } _ => {} }
  let mut output: i32 = 0
  let result = run Effect.result(integers.toInt32Sat(&mut hooks, realm, &mut output, value.borrow()))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
@inlineAlways
pub effect fn clamp<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>, maximum: i32, offset: i32) -> i32 ! JsException ? &mut Allocator {
  match value.view() { ValueBits.Int { value: integer } => { return primitive.int32Clamped(integer, 0, maximum, offset) } _ => {} }
  let mut output: i32 = 0
  let result = run Effect.result(integers.toInt32Clamp(&mut hooks, realm, &mut output, value.borrow(), 0, maximum, offset))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
@inlineAlways
pub effect fn number<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, value: ValueRef<'b>) -> f64 ! JsException ? &mut Allocator {
  let mut output: f64 = 0.0
  let result = run Effect.result(integers.toFloat64(&mut hooks, realm, &mut output, value.borrow()))
  match move result {
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Success { .. } => { return output }
    Result<(), OutOfMemoryError | StringLengthError | JsException>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
pub effect fn getIndex<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, object: ValueRef<'b>, index: i64) -> Value ! JsException ? &mut Allocator {
  let _rt = realm.runtime()
  let mut anchor = () let state = realm.runtimeStateMut(&mut anchor)
  let result = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError>(state.atoms.internInt64(index), failedOomLength)
  drop state
  let atom = match move result {
    u32 value => value
    FailedOomLength { error } => run shared.materialize(&mut hooks, realm, move error)
  }
  let fetched = run Intrinsic.catchFailure<JsException>(shared.get(&mut hooks, realm, object, atom), failedJs)
  let released = realm.runtimeStateMut(&mut anchor)
  released.atoms.release(atom) drop released
  return match move fetched { Value value => move value FailedJs { error } => { fail move error } }
}
pub effect fn call<'a, 'b, H: CoercionHooks + CallHooks>(hooks: &mut H, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  let result = run Intrinsic.catchFailure<OutOfMemoryError | JsException>(hooks.callArguments(realm, function, receiver, args), failedOomJs)
  return match move result {
    ValueBits value => unsafe Value.adoptBits(value)
    FailedOomJs { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
pub fn contains(value: ValueBits, unit: u16) -> bool {
  let mut i: usize = 0
  while i < Strings.length(value) { if Strings.codeUnit(value, i) == unit { return true } i = i + 1 }
  return false
}
@inlineAlways
unsafe fn equalLatin1Bytes(a: [*]const u8, aOff: usize, b: [*]const u8, bOff: usize, count: usize) -> bool {
  let mut k: usize = 0
  while usize.wrappingSubtract(count, k) >= 8 {
    let left = unsafe Pointer.readUnaligned<u64>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(unsafe Pointer.at<u8>(a, usize.wrappingAdd(aOff, k))))
    let right = unsafe Pointer.readUnaligned<u64>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(unsafe Pointer.at<u8>(b, usize.wrappingAdd(bOff, k))))
    if left != right { return false }
    k = usize.wrappingAdd(k, 8)
  }
  if usize.wrappingSubtract(count, k) >= 4 {
    let left = unsafe Pointer.readUnaligned<u32>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u32>(unsafe Pointer.at<u8>(a, usize.wrappingAdd(aOff, k))))
    let right = unsafe Pointer.readUnaligned<u32>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u32>(unsafe Pointer.at<u8>(b, usize.wrappingAdd(bOff, k))))
    if left != right { return false }
    k = usize.wrappingAdd(k, 4)
  }
  while k < count {
    if unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(a, usize.wrappingAdd(aOff, k))) != unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(b, usize.wrappingAdd(bOff, k))) { return false }
    k = usize.wrappingAdd(k, 1)
  }
  return true
}
pub fn find(value: ValueBits, search: ValueBits, from: usize) -> i32 {
  let count = Strings.length(search) let length = Strings.length(value)
  if count > length || from > length - count { return -1 }
  if count == 0 { return usize.toI32(from) }
  if value.tag() == -7 && search.tag() == -7 && !Strings.isWide(value) && !Strings.isWide(search) {
    // Flat Latin-1 operands: SIMD 16-byte scan over storage bytes.
    let haystack = unsafe latin1Bytes(&value, stringReference(value))
    let needle = unsafe latin1Bytes(&search, stringReference(search))
    let base = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(haystack))
    let nbase = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(needle))
    let first = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(nbase, 0))
    let last = usize.wrappingSubtract(length, count)
    if count == 1 {
      let pat = u8x16.splat(first)
      let mut at = from
      if length >= 16 {
        let limit = usize.wrappingSubtract(length, 16)
        while at <= limit {
          let hits = mask16.toBits(u8x16.lanesEqual(unsafe u8x16.loadUnchecked(unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, at))), pat))
          if hits != 0 { return usize.wrappingToI32(usize.wrappingAdd(at, u32.toUsize(u64.trailingZeros(hits)))) }
          at = usize.wrappingAdd(at, 16)
        }
        if at < length {
          let hits = u64.shiftRight(mask16.toBits(u8x16.lanesEqual(unsafe u8x16.loadUnchecked(unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, limit))), pat)), usize.toU64(usize.wrappingSubtract(at, limit)))
          if hits != 0 { return usize.wrappingToI32(usize.wrappingAdd(at, u32.toUsize(u64.trailingZeros(hits)))) }
        }
        return -1
      }
      while at < length {
        if unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, at)) == first { return usize.wrappingToI32(at) }
        at = usize.wrappingAdd(at, 1)
      }
      return -1
    }
    let tailOff = usize.wrappingSubtract(count, 1)
    let tailByte = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(nbase, tailOff))
    let midCount = usize.wrappingSubtract(count, 2)
    if usize.wrappingSubtract(last, from) >= 15 {
      let headVec = u8x16.splat(first)
      let tailVec = u8x16.splat(tailByte)
      let limit = usize.wrappingSubtract(last, 15)
      let mut at = from
      while at <= limit {
        let h1 = mask16.toBits(u8x16.lanesEqual(unsafe u8x16.loadUnchecked(unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, at))), headVec))
        let h2 = mask16.toBits(u8x16.lanesEqual(unsafe u8x16.loadUnchecked(unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, usize.wrappingAdd(at, tailOff)))), tailVec))
        let mut hits = h1 & h2
        while hits != 0 {
          let pos = usize.wrappingAdd(at, u32.toUsize(u64.trailingZeros(hits)))
          if midCount == 0 || unsafe equalLatin1Bytes(base, usize.wrappingAdd(pos, 1), nbase, 1, midCount) { return usize.wrappingToI32(pos) }
          hits = hits & u64.wrappingSubtract(hits, 1)
        }
        at = usize.wrappingAdd(at, 16)
      }
      if at <= last {
        let shift = usize.toU64(usize.wrappingSubtract(at, limit))
        let h1 = mask16.toBits(u8x16.lanesEqual(unsafe u8x16.loadUnchecked(unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, limit))), headVec))
        let h2 = mask16.toBits(u8x16.lanesEqual(unsafe u8x16.loadUnchecked(unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, usize.wrappingAdd(limit, tailOff)))), tailVec))
        let mut hits = u64.shiftRight(h1 & h2, shift)
        while hits != 0 {
          let pos = usize.wrappingAdd(at, u32.toUsize(u64.trailingZeros(hits)))
          if midCount == 0 || unsafe equalLatin1Bytes(base, usize.wrappingAdd(pos, 1), nbase, 1, midCount) { return usize.wrappingToI32(pos) }
          hits = hits & u64.wrappingSubtract(hits, 1)
        }
      }
      return -1
    }
    let mut i = from
    while i <= last {
      if unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, i)) == first
        && unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, usize.wrappingAdd(i, tailOff))) == tailByte
        && (midCount == 0 || unsafe equalLatin1Bytes(base, usize.wrappingAdd(i, 1), nbase, 1, midCount)) {
        return usize.wrappingToI32(i)
      }
      i = usize.wrappingAdd(i, 1)
    }
    return -1
  }
  let first = Strings.codeUnit(search, 0) let mut i = from
  while i <= length - count {
    if Strings.codeUnit(value, i) == first && Strings.compareRange(value, i + 1, search, 1, count - 1) == 0 { return usize.toI32(i) }
    i = i + 1
  }
  return -1
}
