//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The probes of docs/caniuse/support/css-text.json.
import caniuse_probe { Probe }
import silk.core.option { Option }

/// Probe `at`, none past the last.
pub fn probe(at: usize) -> Option<Probe> {
  let table = [
    Probe { feature: "background-clip-text", works: true, root: b"", lead: b"", setup: b"background-color:red", base: "", sheet: ".sample{background-clip:text}" },
    Probe { feature: "background-clip-text", works: true, root: b"", lead: b"", setup: b"background-color:red", base: "", sheet: ".sample{-webkit-background-clip:text}" },
    Probe { feature: "background-clip-text", works: true, root: b"", lead: b"", setup: b"background-color:red", base: "", sheet: ".sample{-webkit-background-clip:text;-webkit-text-fill-color:transparent}" },
    Probe { feature: "ch-unit", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:10ch}" },
    Probe { feature: "css-first-letter", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample::first-letter{color:red}" },
    Probe { feature: "css-first-letter", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample::first-letter{font-size:40px}" },
    Probe { feature: "css-first-line", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample::first-line{color:red}" },
    Probe { feature: "css-first-line", works: false, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample::first-line{font-size:40px}" },
    Probe { feature: "css-initial-letter", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample::first-letter{initial-letter:2}" },
    Probe { feature: "css-letter-spacing", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{letter-spacing:4px}" },
    Probe { feature: "css-line-clamp", works: true, root: b"", lead: b"", setup: b"display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden;width:60px", base: "", sheet: ".sample{-webkit-line-clamp:1}" },
    Probe { feature: "css-line-clamp", works: true, root: b"", lead: b"", setup: b"overflow:hidden;width:60px", base: "", sheet: ".sample{line-clamp:1}" },
    Probe { feature: "css-text-align-last", works: true, root: b"", lead: b"", setup: b"width:200px", base: "", sheet: ".sample{text-align-last:right}" },
    Probe { feature: "css-text-align-last", works: true, root: b"", lead: b"", setup: b"width:80px", base: "", sheet: ".sample{text-align-last:center}" },
    Probe { feature: "css-text-box-trim", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{text-box:trim-both cap alphabetic}" },
    Probe { feature: "css-text-box-trim", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{text-box-trim:trim-both;text-box-edge:cap alphabetic}" },
    Probe { feature: "css-text-indent", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{text-indent:30px}" },
    Probe { feature: "css-text-justify", works: true, root: b"", lead: b"", setup: b"text-align:justify;width:120px", base: "", sheet: ".sample{text-justify:inter-character}" },
    Probe { feature: "css-text-justify", works: true, root: b"", lead: b"", setup: b"text-align:justify;width:120px", base: "", sheet: ".sample{text-justify:none}" },
    Probe { feature: "css-text-orientation", works: true, root: b"", lead: b"", setup: b"writing-mode:vertical-rl", base: "", sheet: ".sample{text-orientation:upright}" },
    Probe { feature: "css-text-wrap-balance", works: true, root: b"", lead: b"", setup: b"width:150px", base: "", sheet: ".sample{text-wrap:balance}" },
    Probe { feature: "css-text-wrap-balance", works: true, root: b"", lead: b"", setup: b"width:150px", base: "", sheet: ".sample{text-wrap-style:balance}" },
    Probe { feature: "css-text-wrap-balance", works: false, root: b"", lead: b"", setup: b"width:150px", base: "", sheet: ".sample{text-wrap:pretty}" },
    Probe { feature: "css-textshadow", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{text-shadow:1px 1px 2px red}" },
    Probe { feature: "css-writing-mode", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{writing-mode:vertical-rl}" },
    Probe { feature: "css-writing-mode", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{writing-mode:vertical-lr}" },
    Probe { feature: "css-writing-mode", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{writing-mode:sideways-lr}" },
    Probe { feature: "css3-tabsize", works: true, root: b"", lead: b"", setup: b"white-space:pre", base: "", sheet: ".sample{tab-size:2}" },
    Probe { feature: "font-feature", works: true, root: b"", lead: b"", setup: b"", base: ".sample::before{content:\"1111\"}", sheet: ".sample{font-feature-settings:\"pnum\"}" },
    Probe { feature: "font-kerning", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{font-kerning:none}" },
    Probe { feature: "font-kerning", works: true, root: b"", lead: b"", setup: b"font-family:Geist", base: "", sheet: ".sample{font-kerning:none}" },
    Probe { feature: "font-size-adjust", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{font-size-adjust:0.8}" },
    Probe { feature: "font-size-adjust", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{font-size-adjust:cap-height 0.8}" },
    Probe { feature: "font-smooth", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{-webkit-font-smoothing:none}" },
    Probe { feature: "font-smooth", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{font-smooth:never}" },
    Probe { feature: "font-variant-alternates", works: true, root: b"", lead: b"", setup: b"", base: ".sample::before{content:\"IIII\";font-family:Geist}", sheet: "@font-feature-values Geist{@styleset{wide:5}}.sample::before{font-variant-alternates:styleset(wide)}" },
    Probe { feature: "font-variant-numeric", works: true, root: b"", lead: b"", setup: b"", base: ".sample::before{content:\"1111\"}", sheet: ".sample{font-variant-numeric:proportional-nums}" },
    Probe { feature: "font-variant-numeric", works: true, root: b"", lead: b"", setup: b"", base: ".sample::before{content:\"0000\"}", sheet: ".sample{font-variant-numeric:slashed-zero}" },
    Probe { feature: "font-variant-numeric", works: true, root: b"", lead: b"", setup: b"", base: ".sample::before{content:\"3456\"}", sheet: ".sample{font-variant-numeric:oldstyle-nums}" },
    Probe { feature: "kerning-pairs-ligatures", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{font-kerning:none}" },
    Probe { feature: "rem", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{margin-left:2rem}" },
    Probe { feature: "text-decoration", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{text-decoration-line:underline;text-decoration-style:wavy;text-decoration-color:red}" },
    Probe { feature: "text-emphasis", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{text-emphasis:filled red}" },
    Probe { feature: "text-emphasis", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{text-emphasis-style:dot}" },
    Probe { feature: "text-overflow", works: true, root: b"", lead: b"", setup: b"width:60px;white-space:nowrap;overflow:hidden", base: "", sheet: ".sample{text-overflow:ellipsis}" },
    Probe { feature: "text-stroke", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{-webkit-text-fill-color:red}" },
    Probe { feature: "text-stroke", works: false, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{-webkit-text-stroke:2px red}" },
    Probe { feature: "ttf", works: true, root: b"", lead: b"", setup: b"", base: ".sample::before{content:\"Hello\"}", sheet: ".sample::before{font-family:Geist}" },
    Probe { feature: "variable-fonts", works: true, root: b"", lead: b"", setup: b"", base: ".sample::before{content:\"Hello\";font-family:Geist}", sheet: ".sample::before{font-weight:300}" },
    Probe { feature: "variable-fonts", works: true, root: b"", lead: b"", setup: b"", base: ".sample::before{content:\"Hello\";font-family:Geist}", sheet: ".sample::before{font-variation-settings:\"wght\" 800}" },
    Probe { feature: "word-break", works: true, root: b"", lead: b"", setup: b"width:30px", base: "", sheet: ".sample{word-break:break-all}" },
    Probe { feature: "wordwrap", works: true, root: b"", lead: b"", setup: b"width:30px", base: "", sheet: ".sample{overflow-wrap:anywhere}" },
  ]
  if at < table.length {
    return Option<Probe>.some(table[at])
  }
  return Option<Probe>.None
}
