//! The error codes of Zstandard 1.5.7 (`ZSTD_ErrorCode`) and their messages.
//!
//! A function of the port returns a `usize` as the reference does: a size or a hint, or an error,
//! which is `0 - code` and so one of the 119 highest values. [`isError`] tells them apart.
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.num.i32

/// `ZSTD_error_no_error`.
pub const E_NO_ERROR: usize = 0
/// `ZSTD_error_GENERIC`.
pub const E_GENERIC: usize = 1
/// `ZSTD_error_prefix_unknown`.
pub const E_PREFIX_UNKNOWN: usize = 10
/// `ZSTD_error_version_unsupported`.
pub const E_VERSION_UNSUPPORTED: usize = 12
/// `ZSTD_error_frameParameter_unsupported`.
pub const E_FRAMEPARAMETER_UNSUPPORTED: usize = 14
/// `ZSTD_error_frameParameter_windowTooLarge`.
pub const E_FRAMEPARAMETER_WINDOWTOOLARGE: usize = 16
/// `ZSTD_error_corruption_detected`.
pub const E_CORRUPTION_DETECTED: usize = 20
/// `ZSTD_error_checksum_wrong`.
pub const E_CHECKSUM_WRONG: usize = 22
/// `ZSTD_error_literals_headerWrong`.
pub const E_LITERALS_HEADERWRONG: usize = 24
/// `ZSTD_error_dictionary_corrupted`.
pub const E_DICTIONARY_CORRUPTED: usize = 30
/// `ZSTD_error_dictionary_wrong`.
pub const E_DICTIONARY_WRONG: usize = 32
/// `ZSTD_error_dictionaryCreation_failed`.
pub const E_DICTIONARYCREATION_FAILED: usize = 34
/// `ZSTD_error_parameter_unsupported`.
pub const E_PARAMETER_UNSUPPORTED: usize = 40
/// `ZSTD_error_parameter_combination_unsupported`.
pub const E_PARAMETER_COMBINATION_UNSUPPORTED: usize = 41
/// `ZSTD_error_parameter_outOfBound`.
pub const E_PARAMETER_OUTOFBOUND: usize = 42
/// `ZSTD_error_tableLog_tooLarge`.
pub const E_TABLELOG_TOOLARGE: usize = 44
/// `ZSTD_error_maxSymbolValue_tooLarge`.
pub const E_MAXSYMBOLVALUE_TOOLARGE: usize = 46
/// `ZSTD_error_maxSymbolValue_tooSmall`.
pub const E_MAXSYMBOLVALUE_TOOSMALL: usize = 48
/// `ZSTD_error_cannotProduce_uncompressedBlock`.
pub const E_CANNOTPRODUCE_UNCOMPRESSEDBLOCK: usize = 49
/// `ZSTD_error_stabilityCondition_notRespected`.
pub const E_STABILITYCONDITION_NOTRESPECTED: usize = 50
/// `ZSTD_error_stage_wrong`.
pub const E_STAGE_WRONG: usize = 60
/// `ZSTD_error_init_missing`.
pub const E_INIT_MISSING: usize = 62
/// `ZSTD_error_memory_allocation`.
pub const E_MEMORY_ALLOCATION: usize = 64
/// `ZSTD_error_workSpace_tooSmall`.
pub const E_WORKSPACE_TOOSMALL: usize = 66
/// `ZSTD_error_dstSize_tooSmall`.
pub const E_DSTSIZE_TOOSMALL: usize = 70
/// `ZSTD_error_srcSize_wrong`.
pub const E_SRCSIZE_WRONG: usize = 72
/// `ZSTD_error_dstBuffer_null`.
pub const E_DSTBUFFER_NULL: usize = 74
/// `ZSTD_error_noForwardProgress_destFull`.
pub const E_NOFORWARDPROGRESS_DESTFULL: usize = 80
/// `ZSTD_error_noForwardProgress_inputEmpty`.
pub const E_NOFORWARDPROGRESS_INPUTEMPTY: usize = 82
/// `ZSTD_error_frameIndex_tooLarge`.
pub const E_FRAMEINDEX_TOOLARGE: usize = 100
/// `ZSTD_error_seekableIO`.
pub const E_SEEKABLEIO: usize = 102
/// `ZSTD_error_dstBuffer_wrong`.
pub const E_DSTBUFFER_WRONG: usize = 104
/// `ZSTD_error_srcBuffer_wrong`.
pub const E_SRCBUFFER_WRONG: usize = 105
/// `ZSTD_error_sequenceProducer_failed`.
pub const E_SEQUENCEPRODUCER_FAILED: usize = 106
/// `ZSTD_error_externalSequences_invalid`.
pub const E_EXTERNALSEQUENCES_INVALID: usize = 107
/// `ZSTD_error_maxCode`.
pub const E_MAXCODE: usize = 120

/// Returns the error value for `code`, as the reference `ERROR(name)` does.
@inlineAlways
pub fn err(code: usize) -> usize { return usize.wrappingSubtract(0, code) }

/// Returns whether `value` is an error, as `ZSTD_isError` does.
@inlineAlways
pub fn isError(value: usize) -> bool { return value > usize.wrappingSubtract(0, E_MAXCODE) }

/// Returns the code of `value`, or 0 if it is not an error, as `ZSTD_getErrorCode` does.
pub fn code(value: usize) -> i32 {
  if !isError(value) { return 0 }
  return usize.toI32(usize.wrappingSubtract(0, value))
}

/// Returns the message of the error `code` as a NUL-terminated string, as `ZSTD_getErrorString`
/// does.
pub fn message(code: i32) -> ?[*]const u8 {
  if code == 0 { return Pointer.fromSlice<u8>(b"No error detected\0") }
  if code == 1 { return Pointer.fromSlice<u8>(b"Error (generic)\0") }
  if code == 10 { return Pointer.fromSlice<u8>(b"Unknown frame descriptor\0") }
  if code == 12 { return Pointer.fromSlice<u8>(b"Version not supported\0") }
  if code == 14 { return Pointer.fromSlice<u8>(b"Unsupported frame parameter\0") }
  if code == 16 { return Pointer.fromSlice<u8>(b"Frame requires too much memory for decoding\0") }
  if code == 20 { return Pointer.fromSlice<u8>(b"Data corruption detected\0") }
  if code == 22 { return Pointer.fromSlice<u8>(b"Restored data doesn't match checksum\0") }
  if code == 24 { return Pointer.fromSlice<u8>(b"Header of Literals' block doesn't respect format specification\0") }
  if code == 30 { return Pointer.fromSlice<u8>(b"Dictionary is corrupted\0") }
  if code == 32 { return Pointer.fromSlice<u8>(b"Dictionary mismatch\0") }
  if code == 34 { return Pointer.fromSlice<u8>(b"Cannot create Dictionary from provided samples\0") }
  if code == 40 { return Pointer.fromSlice<u8>(b"Unsupported parameter\0") }
  if code == 41 { return Pointer.fromSlice<u8>(b"Unsupported combination of parameters\0") }
  if code == 42 { return Pointer.fromSlice<u8>(b"Parameter is out of bound\0") }
  if code == 44 { return Pointer.fromSlice<u8>(b"tableLog requires too much memory : unsupported\0") }
  if code == 46 { return Pointer.fromSlice<u8>(b"Unsupported max Symbol Value : too large\0") }
  if code == 48 { return Pointer.fromSlice<u8>(b"Specified maxSymbolValue is too small\0") }
  if code == 49 { return Pointer.fromSlice<u8>(b"This mode cannot generate an uncompressed block\0") }
  if code == 50 { return Pointer.fromSlice<u8>(b"pledged buffer stability condition is not respected\0") }
  if code == 60 { return Pointer.fromSlice<u8>(b"Operation not authorized at current processing stage\0") }
  if code == 62 { return Pointer.fromSlice<u8>(b"Context should be init first\0") }
  if code == 64 { return Pointer.fromSlice<u8>(b"Allocation error : not enough memory\0") }
  if code == 66 { return Pointer.fromSlice<u8>(b"workSpace buffer is not large enough\0") }
  if code == 70 { return Pointer.fromSlice<u8>(b"Destination buffer is too small\0") }
  if code == 72 { return Pointer.fromSlice<u8>(b"Src size is incorrect\0") }
  if code == 74 { return Pointer.fromSlice<u8>(b"Operation on NULL destination buffer\0") }
  if code == 80 { return Pointer.fromSlice<u8>(b"Operation made no progress over multiple calls, due to output buffer being full\0") }
  if code == 82 { return Pointer.fromSlice<u8>(b"Operation made no progress over multiple calls, due to input being empty\0") }
  if code == 100 { return Pointer.fromSlice<u8>(b"Frame index is too large\0") }
  if code == 102 { return Pointer.fromSlice<u8>(b"An I/O error occurred when reading/seeking\0") }
  if code == 104 { return Pointer.fromSlice<u8>(b"Destination buffer is wrong\0") }
  if code == 105 { return Pointer.fromSlice<u8>(b"Source buffer is wrong\0") }
  if code == 106 { return Pointer.fromSlice<u8>(b"Block-level external sequence producer returned an error code\0") }
  if code == 107 { return Pointer.fromSlice<u8>(b"External sequences are not valid\0") }
  return Pointer.fromSlice<u8>(b"Unspecified error code\0")
}

/// Returns the message of the result `value`, as `ZSTD_getErrorName` does.
pub fn name(value: usize) -> ?[*]const u8 { return message(code(value)) }
