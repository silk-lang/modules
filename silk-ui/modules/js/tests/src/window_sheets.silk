effect fn firstFrame() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let domain = run WaiterDomain.make()
  let memoryAllocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run memoryAllocator.observe()
  let mut app = run JsApp.open(&memory, move memoryAllocator, domain.handle())
  run app.define(b"@silkui/core", uiPackage())
  run app.entry(b"app.js", b"import {createBox,mount} from '@silkui/core'; const box=createBox(); box.className='card'; mount(box);")
  let result = run Effect.result(checkFrame(&mut app, &mut tree))
  run app.close()
  match move result {
    Result.Success { .. } => {}
    Result.Failure { error } => { fail move error }
  }
}

effect fn checkFrame<'m>(app: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let bytes = runtimeStylesheets().call(b".card { width: 123px; padding: 16px; }").unwrapOr(Bytes.make())
  run Testing.expect(bytes.length() != 0, "test sheet compiles")
  let mut client = JsClient.make(NoTools {})
  client.stylesheets = run StyleAssets.from(&[bytes.asSlice()])
  run app.startEntry(&mut tree.*)
  run Testing.expect(tree.current == 0 && tree.rootId() == 1, "the logical root differs from its root node ID")
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client, &mut app.*, &mut tree.*, FrameInput { width: 420.0, height: 200.0, scale: 1.0, time: 0.0 })
  let computed = &tree.node(tree.slotOf(1)).computed().*
  run Testing.expect(computed.layout.width.value == 123.0 && computed.layout.padding.top.value == 16.0,
    "the real window client adopts build sheets into the logical root before its first frame")
}

test effect fn windowClientAdoptsCompiledSheetsBeforeFirstFrame() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run firstFrame() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn preloadBeforeStart() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  tree.input = FrameInput { width: 420.0, height: 200.0, scale: 1.0, time: 0.0 }
  let domain = run WaiterDomain.make()
  let memoryAllocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run memoryAllocator.observe()
  let mut app = run JsApp.open(&memory, move memoryAllocator, domain.handle())
  run app.define(b"@silkui/core", uiPackage())
  run app.entry(b"app.js", b"import {createBox,mount} from '@silkui/core'; const box=createBox(); box.className='card'; mount(box); const w = box.getBoundingClientRect().width; box.setAttribute('data-w', String(Math.round(w)));")
  let bytes = runtimeStylesheets().call(b".card { width: 123px; padding: 16px; transition: width 200ms; }").unwrapOr(Bytes.make())
  run Testing.expect(bytes.length() != 0, "test sheet compiles")
  let mut client = JsClient.make(NoTools {})
  client.stylesheets = run StyleAssets.from(&[bytes.asSlice()])
  let result = run Effect.result(checkPreload(&mut client, &mut app, &mut tree))
  run app.close()
  match move result {
    Result.Success { .. } => {}
    Result.Failure { error } => { fail move error }
  }
}

effect fn checkPreload<'m>(client: &mut JsClient<NoTools>, app: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run WindowClient<JsApp<'m>, never, never>.start(&mut client.*, &mut app.*, &mut tree.*)
  let slot = tree.slotOf(1)
  run Testing.expect(tree.node(slot).computed().layout.width.value == 123.0,
    "start preloads compiled stylesheets before startEntry queries layout")
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client.*, &mut app.*, &mut tree.*, FrameInput { width: 420.0, height: 200.0, scale: 1.0, time: 0.0 })
  run Testing.expect(tree.transitions.length() == 0,
    "first frame layout does not start spurious transitions from unstyled startEntry")
}

test effect fn windowClientPreloadsCompiledSheetsBeforeStartEntryLayoutRead() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run preloadBeforeStart() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pointerTimeStampsAndRegisterProperty() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  tree.input = FrameInput { width: 420.0, height: 200.0, scale: 1.0, time: 0.0 }
  let domain = run WaiterDomain.make()
  let memoryAllocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run memoryAllocator.observe()
  let mut app = run JsApp.open(&memory, move memoryAllocator, domain.handle())
  app.javascript().setStylesheetCompiler(runtimeStylesheets())
  run app.define(b"@silkui/core", uiPackage())
  run app.entry(
    b"app.js",
    b"import {createBox,mount} from '@silkui/core'; CSS.registerProperty({ name: '--local-y', syntax: '*', inherits: false }); const root = createBox({ width: 200, height: 200 }); const child = createBox({ width: 50, height: 50 }); root.appendChild(child); mount(root); globalThis.stamps = []; root.addEventListener('pointerdown', e => globalThis.stamps.push(e.timeStamp)); root.addEventListener('pointermove', e => globalThis.stamps.push(e.timeStamp)); root.addEventListener('pointerup', e => globalThis.stamps.push(e.timeStamp)); globalThis.setLocal = (v) => root.style.setProperty('--local-y', v);",
  )
  let mut client = JsClient.make(NoTools {})
  let result = run Effect.result(checkPointerAndRegister(&mut client, &mut app, &mut tree))
  run app.close()
  match move result {
    Result.Success { .. } => {}
    Result.Failure { error } => { fail move error }
  }
}

effect fn checkPointerAndRegister<'m>(client: &mut JsClient<NoTools>, app: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run WindowClient<JsApp<'m>, never, never>.start(&mut client.*, &mut app.*, &mut tree.*)
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client.*, &mut app.*, &mut tree.*, FrameInput { width: 420.0, height: 200.0, scale: 1.0, time: 0.0 })
  // Advance host clock before each pointer input and verify Event.timeStamp matches.
  let down = Input.PointerDown { x: 20.0, y: 20.0, button: 0, modifiers: 0, clickCount: 1 }
  let moved = Input.PointerMove { x: 40.0, y: 20.0, modifiers: 0 }
  let up = Input.PointerUp { x: 40.0, y: 20.0, button: 0, modifiers: 0 }
  WindowClient<JsApp<'m>, never, never>.advance(&mut client.*, &mut app.*, 0.10)
  run tree.beginAt(0, &down)
  let p0 = run WindowClient<JsApp<'m>, never, never>.decide(&mut client.*, &mut app.*, &mut tree.*)
  run tree.finish(move down, p0)
  WindowClient<JsApp<'m>, never, never>.advance(&mut client.*, &mut app.*, 0.12)
  run tree.beginAt(0, &moved)
  let p1 = run WindowClient<JsApp<'m>, never, never>.decide(&mut client.*, &mut app.*, &mut tree.*)
  run tree.finish(move moved, p1)
  WindowClient<JsApp<'m>, never, never>.advance(&mut client.*, &mut app.*, 0.15)
  run tree.beginAt(0, &up)
  let p2 = run WindowClient<JsApp<'m>, never, never>.decide(&mut client.*, &mut app.*, &mut tree.*)
  run tree.finish(move up, p2)
  run app.script(&mut tree.*, b"if (stamps.length !== 3 || stamps[0] !== 100 || stamps[1] !== 120 || stamps[2] !== 150) throw new Error('bad stamps: ' + JSON.stringify(stamps));", b"check")
  // Updating the registered non-inheriting property must not move descendant scopes.
  let movesBefore = tree.work.scopeMoves
  run app.script(&mut tree.*, b"setLocal('12px');", b"local")
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client.*, &mut app.*, &mut tree.*, FrameInput { width: 420.0, height: 200.0, scale: 1.0, time: 0.2 })
  run Testing.expect(tree.work.scopeMoves == movesBefore, "CSS.registerProperty(inherits: false) avoids descendant scope moves")
}

test effect fn eventTimeStampAndRegisterPropertyWork() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pointerTimeStampsAndRegisterProperty() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn runNestedScrollerHoistedOrder() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let domain = run WaiterDomain.make()
  let memoryAllocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run memoryAllocator.observe()
  let mut app = run JsApp.open(&memory, move memoryAllocator, domain.handle())
  let mut client = JsClient.make(NoTools {})
  run app.define(b"@silkui/core", uiPackage())
  let code = b"import { createElement, mount } from '@silkui/core'; const root = createElement('div'); root.style.cssText = 'width:400px;height:300px;overflow-y:auto;'; const inner = createElement('div'); inner.id = 'nested'; inner.style.cssText = 'width:200px;height:150px;overflow-y:auto;'; const tall = createElement('div'); tall.style.cssText = 'height:400px;'; inner.appendChild(tall); root.appendChild(inner); const hoisted = createElement('div'); hoisted.style.cssText = 'position:relative;z-index:1;height:500px;'; root.appendChild(hoisted); mount(root);"
  run app.entry(b"nested.js", code)
  let result = run Effect.result(checkNestedScroller(&mut client, &mut app, &mut tree))
  run app.close()
  match move result {
    Result.Success { .. } => {}
    Result.Failure { error } => { fail move error }
  }
}

effect fn checkNestedScroller<'m>(client: &mut JsClient<NoTools>, app: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> ()
  ! TreeError | JsError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run WindowClient<JsApp<'m>, never, never>.start(&mut client.*, &mut app.*, &mut tree.*)
  run WindowClient<JsApp<'m>, never, never>.tick(&mut client.*, &mut app.*, &mut tree.*, 0.0, true)
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client.*, &mut app.*, &mut tree.*, FrameInput { width: 400.0, height: 300.0, scale: 2.0, time: 0.0 })
  let mut nestedId: u32 = 0
  let mut slot: usize = 0
  while slot < tree.nodes.length() {
    let n = tree.node(usize.toU32(slot))
    if n.live {
      if let Option.Some { value: id } = n.identity() {
        if id.id() == "nested" { nestedId = n.id }
      }
    }
    slot = slot + 1
  }
  let fast = run fastScrollOf(&tree.*, 2.0)
  let groups = tree.scene().scrollGroups()
  let scrolls = tree.scene().scrolls()
  // Confirm a later paintThrough group for the root scroller exists after nestedId's group,
  // and that paintOrder-based ranking (matching Compositor.scroll) picks nestedId.
  let mut pdx = List<f32>.make()
  let mut pdy = List<f32>.make()
  let mut cx0 = List<f32>.make()
  let mut cy0 = List<f32>.make()
  let mut cx1 = List<f32>.make()
  let mut cy1 = List<f32>.make()
  run pdx.append(0.0)
  run pdy.append(0.0)
  run cx0.append(-1.0e30)
  run cy0.append(-1.0e30)
  run cx1.append(1.0e30)
  run cy1.append(1.0e30)
  let mut g: usize = 1
  while g < groups.length {
    let grp = groups[g]
    let pIdx = u32.toUsize(grp.parent)
    let mut sx: f32 = 0.0
    let mut sy: f32 = 0.0
    let mut k: usize = 0
    while k < scrolls.length {
      if scrolls[k].node == grp.link.node { sx = scrolls[k].x sy = scrolls[k].y break }
      k = k + 1
    }
    let dx = pdx.get(pIdx) + grp.link.x.at(sx)
    let dy = pdy.get(pIdx) + grp.link.y.at(sy)
    let x0 = f32.max(cx0.get(pIdx), grp.clip.xMin + pdx.get(pIdx))
    let y0 = f32.max(cy0.get(pIdx), grp.clip.yMin + pdy.get(pIdx))
    let x1 = f32.min(cx1.get(pIdx), grp.clip.xMax + pdx.get(pIdx))
    let y1 = f32.min(cy1.get(pIdx), grp.clip.yMax + pdy.get(pIdx))
    run pdx.append(dx)
    run pdy.append(dy)
    run cx0.append(x0)
    run cy0.append(y0)
    run cx1.append(x1)
    run cy1.append(y1)
    g = g + 1
  }
  let wx: f32 = 100.0
  let wy: f32 = 100.0
  let mut bestOrder: u32 = 0
  let mut hasBest = false
  let mut winner: u32 = 0
  g = 1
  while g < groups.length {
    let grp = groups[g]
    if grp.link.x.factor == -1.0 && grp.link.y.factor == -1.0 {
      if wx >= cx0.get(g) && wx < cx1.get(g) && wy >= cy0.get(g) && wy < cy1.get(g) {
        let mut sc: usize = 0
        while sc < fast.scrollers.length() {
          let ax = fast.scrollers.get(sc)
          if ax.node == grp.link.node {
            if (ax.x || ax.y) && ax.order != u32.MAX && (!hasBest || ax.order > bestOrder) {
              bestOrder = ax.order
              winner = grp.link.node
              hasBest = true
            }
            break
          }
          sc = sc + 1
        }
      }
    }
    g = g + 1
  }
  run Testing.expect(nestedId != 0, "found nested scroller")
  run Testing.expect(hasBest && winner == nestedId, "paintOrder ranking selects nested scroller over hoisted ancestor group")
}

test effect fn nestedScrollerNotShadowedByHoistedAncestor() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run runNestedScrollerHoistedOrder() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn runImageAndRangeSmoke() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let domain = run WaiterDomain.make()
  let memoryAllocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run memoryAllocator.observe()
  let mut app = run JsApp.open(&memory, move memoryAllocator, domain.handle())
  app.javascript().enableGpu()
  let mut client = JsClient.make(NoTools {})
  run app.define(b"@silkui/core", uiPackage())
  let code = b"import { createElement, mount, RangeInput, Canvas } from '@silkui/core'; const wrap = createElement('div'); const slider = createElement('input', { type: 'range' }); slider.min = '1'; slider.max = '4'; slider.step = '0.5'; slider.value = '1.5'; slider.style.cssText = 'width:200px;height:24px;accent-color:rgb(200,100,50);'; globalThis.__events = []; slider.addEventListener('input', () => globalThis.__events.push('i:' + slider.value)); slider.addEventListener('change', () => globalThis.__events.push('c:' + slider.value)); wrap.appendChild(slider); const img = createElement('img'); img.src = 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 80\" width=\"120\" height=\"80\"><rect width=\"120\" height=\"80\" fill=\"#e05a2b\"/></svg>'); wrap.appendChild(img); const canvas = new Canvas(); canvas.width = 16; canvas.height = 16; wrap.appendChild(canvas); globalThis.__slider = slider; globalThis.__img = img; globalThis.__canvas = canvas; globalThis.__isRange = slider instanceof RangeInput; mount(wrap);"
  run app.entry(b"smoke.js", code)
  let result = run Effect.result(checkImageAndRange(&mut client, &mut app, &mut tree))
  run app.close()
  match move result {
    Result.Success { .. } => {}
    Result.Failure { error } => { fail move error }
  }
}

effect fn checkImageAndRange<'m>(client: &mut JsClient<NoTools>, app: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> ()
  ! TreeError | JsError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run WindowClient<JsApp<'m>, never, never>.start(&mut client.*, &mut app.*, &mut tree.*)
  run WindowClient<JsApp<'m>, never, never>.tick(&mut client.*, &mut app.*, &mut tree.*, 0.0, true)
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client.*, &mut app.*, &mut tree.*, FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 })
  // Drive keyboard step on slider and verify Image naturalWidth/naturalHeight/complete/decode + Canvas drawImage + toBlob
  run app.script(&mut tree.*, b"(() => { const s = globalThis.__slider; if (!globalThis.__isRange) throw new Error('not RangeInput'); if (s.value !== '1.5' || s.valueAsNumber !== 1.5) throw new Error('bad initial range value: ' + s.value); s.focus(); })();", b"check1")
  let kd = Input.KeyDown { key: run String.copy("ArrowRight"), code: run String.copy("ArrowRight"), modifiers: 0, repeat: false }
  run tree.beginAt(0, &kd)
  let d = run WindowClient<JsApp<'m>, never, never>.decide(&mut client.*, &mut app.*, &mut tree.*)
  run tree.finish(move kd, d)
  run WindowClient<JsApp<'m>, never, never>.pump(&mut client.*, &mut app.*, &mut tree.*)
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client.*, &mut app.*, &mut tree.*, FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.016 })
  run app.script(&mut tree.*, b"(() => { const s = globalThis.__slider; if (s.value !== '2') throw new Error('arrow step failed: ' + s.value); if (globalThis.__events.join(',') !== 'i:2,c:2') throw new Error('bad events: ' + globalThis.__events.join(',')); const img = globalThis.__img; if (!img.complete || img.naturalWidth !== 120 || img.naturalHeight !== 80) throw new Error('bad img info: ' + img.complete + ',' + img.naturalWidth + ',' + img.naturalHeight); const c = globalThis.__canvas; const ctx = c.getContext('2d'); if (!ctx) throw new Error('no 2d ctx'); ctx.drawImage(img, 0, 0, 16, 16); const px = ctx.getImageData(8, 8, 1, 1).data; if (px[0] < 180 || px[3] < 200) throw new Error('drawImage pixel mismatch: ' + Array.from(px).join(',')); c.toBlob((blob) => { if (blob && blob.type === 'image/png' && blob.size > 20) { globalThis.__canvas.id = 'all_ok'; } }); })();", b"check2")
  run WindowClient<JsApp<'m>, never, never>.tick(&mut client.*, &mut app.*, &mut tree.*, 0.032, true)
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client.*, &mut app.*, &mut tree.*, FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.032 })
  let mut allOk = false
  let mut slot: usize = 0
  while slot < tree.nodes.length() {
    let n = tree.node(usize.toU32(slot))
    if n.live {
      if let Option.Some { value: id } = n.identity() {
        if id.id() == "all_ok" { allOk = true }
      }
    }
    slot = slot + 1
  }
  run Testing.expect(allOk, "range input, image natural size, drawImage(HTMLImageElement), and canvas.toBlob all succeeded")
}

