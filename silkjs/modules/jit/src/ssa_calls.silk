//! Calls in the SSA form (workstream H, docs/jit/compiled-entry.md section 7.3): the shape
//! rules the verifier checks for `call.arg` and `call`, and what the backend needs to know
//! about a function's calls.
import silk.num.i32
import silk.num.u32
import silk.num.usize
import ssa { Function, Inst, Op, Type, Own, NONE }
import silkjs.js_compiled as compiled

/// Arguments a call may pass in frame mode (baseline operand stack / dynamic bodyCells).
pub const MAX_ARGUMENTS: u32 = 24
/// Arguments a call may pass in compiled-entry mode (fixed CALL_AREA_SLOTS).
pub const MAX_COMPILED_ARGUMENTS: u32 = 8
/// A `call`'s `k` flag for a constructor call (`new`): its receiver is new.target. The
/// call site word carries it (js_compiled.SITE_CONSTRUCT); `k & 255` is the argument count.
pub const CONSTRUCT: i32 = 256
/// A `call`'s `k` flag for a generic instruction exit (js_compiled.SITE_GENERIC): the engine
/// runs the instruction at its pc on its arguments; function and receiver are unused.
pub const GENERIC: i32 = 512
/// A `call`'s `k` flag for a call site that deoptimized in an earlier compilation
/// (js_compiled.SITE_CALL_ALWAYS): the engine calls a hot callee that has no code yet.
pub const ALWAYS: i32 = 1024
/// A `call`'s `k` flag for `f.apply(x, arguments)` on a lazy arguments object's stand-in
/// (js_compiled.SITE_LAZY_ARGUMENTS): the engine calls f on the frame's own arguments.
pub const LAZY_ARGUMENTS: i32 = 2048
/// A `call`'s `k` flag for a method call inside an inlined body (its receiver is `b`): the
/// function's own code does not show the opcode of a call the body makes. Only code on a
/// baseline frame has such calls (FunctionInput.leavesBodies).
pub const METHOD: i32 = 134217728
/// A generic `call` whose instruction leaves several values on the engine's stack (stream Q's
/// iteration instructions, stream P's define_array_el, append, check_ctor_return): their count
/// in `k` bits 12-15 (js_compiled.siteResults), the cells the instruction leaves as they were
/// in bits 16-23 (siteKept). The engine releases its copies of the kept cells (the code keeps
/// its own values) and leaves the others owned in the area: the call yields cell 0 (undefined
/// when kept), `call.result` cell k (docs/jit/compiled-entry.md 7.8).
pub const RESULTS_SHIFT: i32 = 12
pub const KEPT_SHIFT: i32 = 16
pub const MAX_RESULTS: i32 = 8
/// The argument count of a `call` whose immediate is k.
pub fn argumentCount(k: i32) -> i32 { return k & 255 }
/// The value count a generic call with immediate k leaves (0: one at most, the classic exit).
pub fn resultCount(k: i32) -> i32 { return i32.shiftRight(k, RESULTS_SHIFT) & 15 }
/// The cells a generic call with immediate k leaves as they were (bit c: cell c).
pub fn keptCells(k: i32) -> i32 { return i32.shiftRight(k, KEPT_SHIFT) & 255 }
/// Whether a generic call with immediate k leaves cell c as it was.
pub fn kept(k: i32, c: i32) -> bool { return (keptCells(k) & i32.shiftLeft(1, c)) != 0 }
/// Specialized instruction exits use bits 24–25, above the multi-result encoding.
/// The backend shifts the immediate into the upper half of CALL_SITE (js_compiled.siteKind).
const KIND_SHIFT: i32 = 24
pub const NOT_EQUAL: i32 = 67108864
/// A method `call` in frame mode whose callee was read under the name Array.prototype's
/// push (NATIVE_PUSH, one argument) or pop (NATIVE_POP, none) has: bits 28-29 of `k`. The
/// code asks the engine for the array operation when the callee is that native
/// (js_baseline.SERVICE_ARRAY), and makes the call otherwise.
/// A `call` on the slow path of an inlined `Op.NewObject` (cold allocation fallback when no
/// spare or recyclable cell is available): guards already verified a planned constructor that
/// allocates a fresh plain object without running user JS or mutating existing shapes.
pub const PLANNED: i32 = 1073741824
pub const NATIVE_SHIFT: i32 = 28
pub const NATIVE_PUSH: i32 = 1
pub const NATIVE_POP: i32 = 2
pub fn nativeOf(inst: Inst) -> i32 { return i32.shiftRight(inst.k, NATIVE_SHIFT) & 3 }
pub fn countOf(inst: Inst) -> u32 { return i32.wrappingToU32(argumentCount(inst.k)) }
pub fn kindOf(inst: Inst) -> u32 { return i32.wrappingToU32(i32.shiftRight(inst.k, KIND_SHIFT) & 3) }
pub fn notEqualOf(inst: Inst) -> bool { return (inst.k & NOT_EQUAL) != 0 }
pub fn kAt(count: u32, kind: u32) -> i32 { return u32.wrappingToI32(count) | i32.shiftLeft(u32.wrappingToI32(kind), KIND_SHIFT) }

fn isValue(f: &Function, v: u32) -> bool { return f.value(v).ty == Type.Value }

/// Whether `inst`, a `call.arg` or `call` at instruction `index` of block `b`, is well formed:
/// a call's function and receiver are values (an argument may be an i32 or bool, boxed into
/// the call area), its `k` arguments are the `k` instructions right before it in
/// its block (`call.arg 0` to `k - 1`, in order), and every `call.arg` is part of one.
pub fn wellFormed(f: &Function, b: u32, index: u32, inst: Inst) -> bool {
  let block = f.blocks.get(u32.toUsize(b))
  let end = block.firstInst + block.instCount
  if inst.op == Op.CallArg {
    if inst.a == NONE || inst.result != NONE || inst.k < 0 || i32.wrappingToU32(inst.k) >= MAX_ARGUMENTS { return false }
    if index + 1 >= end { return false }
    let next = f.inst(index + 1)
    if next.op == Op.CallArg { return next.k == inst.k + 1 }
    return next.op == Op.Call && countOf(next) == i32.wrappingToU32(inst.k) + 1
  }
  if !isValue(f, inst.a) || !isValue(f, inst.b) || inst.result == NONE { return false }
  let result = f.value(inst.result)
  if result.ty != Type.Value || result.own != Own.Owned { return false }
  let multi = i32.shiftLeft(15, RESULTS_SHIFT) | i32.shiftLeft(255, KEPT_SHIFT)
  let kind = kindOf(inst)
  let special = i32.shiftLeft(3, KIND_SHIFT) | NOT_EQUAL
  if kind != compiled.SITE_CALL && kind != compiled.SITE_PUT_FIELD && kind != compiled.SITE_EQUAL && kind != compiled.SITE_ADD { return false }
  if notEqualOf(inst) && kind != compiled.SITE_EQUAL { return false }
  if kind != compiled.SITE_CALL && (inst.k & ~special) != 0 { return false }
  if (inst.k & METHOD) != 0 && (inst.frame == 0 || kind != compiled.SITE_CALL || (inst.k & (CONSTRUCT | GENERIC | ALWAYS | LAZY_ARGUMENTS | PLANNED)) != 0) { return false }
  if (inst.k & PLANNED) != 0 && (kind != compiled.SITE_CALL || (inst.k & CONSTRUCT) == 0 || (inst.k & (GENERIC | ALWAYS | LAZY_ARGUMENTS | METHOD | multi)) != 0 || nativeOf(inst) != 0) { return false }
  // The array natives: a plain call, push with one argument, pop with none.
  let native = nativeOf(inst)
  if native != 0 && (kind != compiled.SITE_CALL || (inst.k & (CONSTRUCT | GENERIC | ALWAYS | LAZY_ARGUMENTS | PLANNED | multi)) != 0
    || (native != NATIVE_PUSH && native != NATIVE_POP) || argumentCount(inst.k) != (if native == NATIVE_PUSH { 1 } else { 0 })) { return false }
  if inst.k < 0 || (inst.k & ~(CONSTRUCT | GENERIC | ALWAYS | LAZY_ARGUMENTS | METHOD | PLANNED | 255 | multi | special | i32.shiftLeft(3, NATIVE_SHIFT))) != 0 || ((inst.k & CONSTRUCT) != 0 && (inst.k & GENERIC) != 0)
    || ((inst.k & LAZY_ARGUMENTS) != 0 && ((inst.k & (CONSTRUCT | GENERIC)) != 0 || argumentCount(inst.k) != 2)) || i32.wrappingToU32(argumentCount(inst.k)) > MAX_ARGUMENTS { return false }
  // Kept cells are operands, and only a call that leaves several values keeps any.
  if (inst.k & multi) != 0 && ((inst.k & GENERIC) == 0 || resultCount(inst.k) < 2 || resultCount(inst.k) > MAX_RESULTS) { return false }
  if i32.shiftRight(keptCells(inst.k), resultCount(inst.k)) != 0 || i32.shiftRight(keptCells(inst.k), argumentCount(inst.k)) != 0 { return false }
  let count = i32.wrappingToU32(argumentCount(inst.k))
  if index - block.firstInst < count { return false }
  let mut i: u32 = 0
  while i < count {
    let arg = f.inst(index - count + i)
    if arg.op != Op.CallArg || arg.k != u32.wrappingToI32(i) { return false }
    i = i + 1
  }
  return true
}

/// Whether `inst`, a `call.result` at instruction `index` of block `b`, is well formed: an
/// owned value read from cell `k` (1 to the call's result count - 1) of the generic call `a`,
/// which it follows directly or through other `call.result`s of that call.
pub fn resultWellFormed(f: &Function, b: u32, index: u32, inst: Inst) -> bool {
  let block = f.blocks.get(u32.toUsize(b))
  if inst.result == NONE || inst.a == NONE || inst.exit != NONE || index == block.firstInst { return false }
  let result = f.value(inst.result)
  if result.ty != Type.Value || result.own != Own.Owned { return false }
  let def = f.value(inst.a).def
  if def == NONE { return false }
  let call = f.inst(def)
  if call.op != Op.Call || (call.k & GENERIC) == 0 || inst.k < 1 || inst.k >= resultCount(call.k) || kept(call.k, inst.k) { return false }
  if def < block.firstInst || def >= index { return false }
  let mut at = index - 1
  while at > def && f.inst(at).op == Op.CallResult && f.inst(at).a == inst.a { at = at - 1 }
  return at == def
}

/// The call block `f` needs (js_compiled's layout: its header and area, then two words per
/// value the code saves), or 0 when it makes no call.
pub fn callWords(f: &Function) -> u32 {
  if !makesCalls(f) { return 0 }
  return usize.toU32(compiled.CALL_SAVED) + 2 * f.valueCount()
}

/// The generic instruction exits in `f` (calls flagged GENERIC).
pub fn genericSites(f: &Function) -> u32 {
  let mut n: u32 = 0
  let mut i: usize = 0
  while i < f.insts.length() { let inst = f.insts.get(i) if inst.op == Op.Call && (inst.k & GENERIC) != 0 { n = n + 1 } i = i + 1 }
  return n
}

/// Whether `f` calls a function (a call that is not a generic instruction exit). Generic exits
/// run one instruction in the engine and need no --jit-calls.
pub fn callsFunctions(f: &Function) -> bool {
  let mut i: usize = 0
  while i < f.insts.length() { let inst = f.insts.get(i) if inst.op == Op.Call && (inst.k & GENERIC) == 0 { return true } i = i + 1 }
  return false
}

/// Whether `f` makes any call.
pub fn makesCalls(f: &Function) -> bool {
  let mut i: usize = 0
  while i < f.insts.length() { if f.insts.get(i).op == Op.Call { return true } i = i + 1 }
  return false
}

