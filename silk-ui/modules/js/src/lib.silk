//! A JavaScript application on a UI tree, with the SilkJS engine embedded in the process.
//!
//! JavaScript runs on the thread that owns the tree. It builds nodes through native functions
//! that append to one ui-protocol batch, and it receives each event between the tree's `begin`
//! and `finish`, so `preventDefault()` in a handler decides that event's default action. Start
//! at [`JsHost`].
pub import host { JsHost, JsError, imageLoadable, imageBuild, engineBuild, firstString, secondString, thirdString, fourthString }
pub import ui_js_calls.lib { kindCode, numbersOf }
pub import ui_js_calls.stylesheets { Compiler as StylesheetCompiler }
pub import ui_js_calls.natives { Natives, NativeCall, Reply, Exports, serve }
pub import ui_js_calls.stylesheet_compiler { runtime as runtimeStylesheets }
pub import bridge { Bridge, LogEntry, Outcome, ClipboardRequest, ClipboardData, EncodedItem, encodeItem, ShellRequest, StartedNative }
import generated_library { library }

/// The source of the `@silkui/core` package ([packages/core](../packages/core)), for a host to
/// define in its realm: `app.define(b"@silkui/core", uiPackage())`. It is part of the program,
/// so a host does not read it from disk.
pub fn uiPackage() -> &'static [u8] {
  return library()
}
