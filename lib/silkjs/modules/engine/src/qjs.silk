//! Standalone native interpreter, preserving pinned qjs.c's option execution order.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.num.i32
import cli_options { Arguments, QjsOptions, ArgRef }
import cli_io
import js_libc { Session }
import js_libc as libc
import js_libc_platform as platform
import js_libc_platform { PlatformError }
import js_lexer { Lexer }
import js_eval_compile as compile
import js_eval as evaluation
import js_libc_modules as modules
import js_value { ValueBits }
import js_exceptions { JsException }
import js_gc as gc
import js_runtime as runtime
import qjs_repl
import js_bytecode_image as image
import silk.mem.pointer { Pointer }

unsafe effect fn repl<'m>(session: &mut Session<'m>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let realm = session.context.realm()
  let memory = session.engine.memory
  let compiled = run evaluation.evaluate(&mut session.engine, memory, realm,
    qjs_repl.source(), b"repl.js", compile.TYPE_MODULE | compile.FLAG_COMPILE_ONLY)
  // The embedded source has no filesystem path, just like qjs.c's REPL bytecode.
  let _anchor = () let metadata = run Effect.result(modules.setImportMeta(&mut session.engine, session.context.realm(), compiled.borrow(), false, true))
  match move metadata {
    Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsException>.Failure { error } => {
      session.release(move compiled) fail move error
    }
  }
  let result = run evaluation.evaluateFunction(&mut session.engine, memory, realm, move compiled)
  let awaited = run unsafe libc.awaitValue(&mut session.engine, realm, result.intoBits())
  unsafe gc.release(&mut session.engine, session.runtime, awaited)
}

fn suffix(input: &[u8], ending: &[u8]) -> bool {
  if input.length < ending.length { return false }
  let mut index: usize = 0 let start = input.length - ending.length
  while index < ending.length { if input[start + index] != ending[index] { return false } index = index + 1 }
  return true
}
fn flags(module: bool, strict: bool) -> i32 {
  if module { return compile.TYPE_MODULE }
  if strict { return compile.TYPE_GLOBAL | compile.FLAG_STRICT }
  return compile.TYPE_GLOBAL
}
unsafe effect fn evaluateInput<'m>(session: &mut Session<'m>, source: &[u8], filename: &[u8],
  evalFlags: i32, fileSource: bool) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let realm = session.context.realm()
  if fileSource { return run libc.evalBuffer(&mut session.engine, realm, source, filename, evalFlags) }
  // Inline source has no file metadata; do not manufacture a realpath exception.
  let memory = session.engine.memory
  let value = (run evaluation.evaluate(&mut session.engine, memory, realm, source, filename, evalFlags)).intoBits()
  if (evalFlags & compile.TYPE_MASK) == compile.TYPE_MODULE {
    return run unsafe libc.awaitValue(&mut session.engine, realm, value)
  }
  return value
}
unsafe effect fn buffer<'m>(session: &mut Session<'m>, source: &[u8], filename: &[u8], evalFlags: i32, fileSource: bool) -> bool
  ? &mut Allocator {
  let evaluated = run Effect.result(unsafe evaluateInput(&mut session, source, filename, evalFlags, fileSource))
  match move evaluated {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => {
      unsafe gc.release(&mut session.engine, session.runtime, value) return true
    }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => {
      run libc.dumpError(&mut session.engine, session.context.realm()) return false
    }
  }
}
unsafe effect fn file<'m>(session: &mut Session<'m>, filename: &[u8], module: i32, strict: bool) -> bool
  ? &mut Allocator {
  let loaded = run Effect.result(platform.readFile(filename))
  let source = match move loaded {
    Result<List<u8>, OutOfMemoryError | PlatformError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError | PlatformError>.Failure { error } => {
      match move error {
        PlatformError failure => { platform.printFileError(filename, move failure) }
        OutOfMemoryError _failure => { cli_io.stderr(filename) cli_io.stderr(b": out of memory\n") }
      }
      return false
    }
  }
  let mut isModule = module != 0
  if module < 0 { isModule = suffix(filename, b".mjs") || Lexer.detectModule(source.asSlice()) }
  return run unsafe buffer(&mut session, source.asSlice(), filename, flags(isModule, strict), true)
}
/// --write-image: compiles the input file into the named image and writes it.
unsafe effect fn writeImage<'m>(session: &mut Session<'m>, arguments: &Arguments, options: &QjsOptions, output: &[u8]) -> i32
  ! OutOfMemoryError | JsException ? &mut Allocator {
  if options.firstInput >= arguments.count() { cli_io.stderr(b"qjs: --write-image needs a file to compile\n") return 2 }
  let filename = arguments.bytes(options.firstInput)
  let loaded = run Effect.result(platform.readFile(filename))
  let source = match move loaded {
    Result<List<u8>, OutOfMemoryError | PlatformError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError | PlatformError>.Failure { .. } => { cli_io.stderr(filename) cli_io.stderr(b": cannot read\n") return 2 }
  }
  let mut isModule = options.module > 0
  if options.module < 0 { isModule = suffix(filename, b".mjs") || Lexer.detectModule(source.asSlice()) }
  let memory = session.engine.memory
  let bytes = run image.write(&mut session.engine, memory, session.context.realm(), source.asSlice(), filename, flags(isModule, options.strict))
  let stored = run Effect.result(cli_io.writeFile(output, bytes.asSlice()))
  match move stored {
    Result<(), OutOfMemoryError | cli_io.IoError>.Success { .. } => { return 0 }
    Result<(), OutOfMemoryError | cli_io.IoError>.Failure { .. } => { cli_io.stderr(output) cli_io.stderr(b": cannot write\n") return 2 }
  }
}
/// --image: runs the image as a file of the same kind would run. bytes outlive the runtime.
unsafe effect fn runImage<'m>(session: &mut Session<'m>, bytes: &[u8]) -> bool ? &mut Allocator {
  let realm = session.context.realm()
  if !image.loadable(bytes) { cli_io.stderr(b"qjs: not a bytecode image of this engine build\n") return false }
  let ran = run Effect.result(unsafe imageValue(&mut session, bytes))
  match move ran {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => {
      unsafe gc.release(&mut session.engine, session.runtime, value) return true
    }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { .. } => {
      run libc.dumpError(&mut session.engine, realm) return false
    }
  }
}
unsafe effect fn imageValue<'m>(session: &mut Session<'m>, bytes: &[u8]) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let realm = session.context.realm()
  let memory = session.engine.memory
  let compiled = run unsafe image.load(&mut session.engine, realm, Pointer.fromRef<u8>(&bytes[0]), bytes.length)
  let isModule = match compiled.view() { ValueBits.Module { .. } => true _ => false }
  if isModule {
    // import.meta is the host's to fill, as libc.evalBuffer does for a module file.
    let metadata = run Effect.result(modules.setImportMeta(&mut session.engine, realm, compiled.borrow(), true, true))
    if let Result<(), OutOfMemoryError | JsException>.Failure { error } = move metadata { session.release(move compiled) fail move error }
  }
  let value = (run evaluation.evaluateFunction(&mut session.engine, memory, realm, move compiled)).intoBits()
  if isModule { return run unsafe libc.awaitValue(&mut session.engine, realm, value) }
  return value
}
/// imageBytes is the --image file's content (empty without one), which the caller
/// keeps until the runtime is destroyed.
pub unsafe effect fn execute<'m>(session: &mut Session<'m>, arguments: &Arguments, options: &QjsOptions, imageBytes: &[u8]) -> i32
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let realm = session.context.realm()
  unsafe libc.setRejectionTracker(&mut session.engine, session.runtime, options.dumpUnhandledRejection)
  if options.emptyRun != 0 { return 0 }
  let mut scriptArgs = List<&[u8]>.make()
  let mut at = options.firstInput
  while at < arguments.count() { run scriptArgs.append(arguments.bytes(at)) at = at + 1 }
  run libc.installHelpersBytes(&mut session.engine, realm, scriptArgs.asSlice())
  if options.loadStd {
    // qjs.c deliberately does not abort the main script when --std setup fails.
    let _installed = run unsafe buffer(&mut session,
      b"import * as std from 'std';\nimport * as os from 'os';\nglobalThis.std = std;\nglobalThis.os = os;\n",
      b"<input>", compile.TYPE_MODULE, false)
  }
  if let Option<ArgRef>.Some { value: output } = &options.writeImage {
    return run unsafe writeImage(&mut session, arguments, options, arguments.resolve(output))
  }
  at = 0
  while at < options.includes.length() {
    if !run unsafe file(&mut session, arguments.resolve(options.includes.get(at)), 0, options.strict) { return 1 }
    at = at + 1
  }
  if imageBytes.length != 0 && !run unsafe runImage(&mut session, imageBytes) { return 1 }
  let mut interactive = options.interactive != 0
  match &options.expression {
    Option<ArgRef>.Some { value } => {
      if !run unsafe buffer(&mut session, arguments.resolve(value), b"<cmdline>", flags(options.module > 0, options.strict), false) { return 1 }
    }
    Option<ArgRef>.None => {
      if options.firstInput >= arguments.count() { interactive = imageBytes.length == 0 }
      else if !run unsafe file(&mut session, arguments.bytes(options.firstInput), options.module, options.strict) { return 1 }
    }
  }
  if interactive {
    unsafe libc.setRejectionTracker(&mut session.engine, session.runtime, false)
    run unsafe repl(&mut session)
  }
  return run libc.loop(&mut session.engine, realm)
}
