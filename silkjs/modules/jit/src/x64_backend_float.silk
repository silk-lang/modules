//! x86-64 lowering of the number operations of the SSA form (docs/jit/doubles.md): unboxed
//! doubles with SSE2 and the int32 operators beyond add, sub and mul. x64_backend calls
//! `lowerNumber` for every operation `ssa.isNumberOp` names but `unbox.f64` and `box.f64`,
//! which read and write ValueBits and live there, with the memory operands of the
//! operation's values and the label of its exit. An f64 value's slot holds its 64 bits; an i32
//! slot holds the value zero-extended, a bool 0 or 1, in the first word of the 16-byte slot,
//! as everywhere in x64_backend.
//!
//! Registers: rax, r8, r9, r10, r11 and xmm0, xmm1 are scratch. rcx and rdx hold the stress
//! word and the interrupt counter (the entry ABI's arguments): a shift by a variable count and
//! a division need them, so those save them in r10 and r11 and restore them before anything
//! can leave.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u8
import silk.num.u64
import asm_x64 { Alu, Assembler, Cond, Label, PackedOp, Reg, ScalarOp, Shift, Unary, Width, Xmm }
import ssa { Function, Inst, Op, Cmp }
import x64_regalloc { Place, GPR, XMM, getI32, putI32, aluWith, getF64, putF64, getBits, putBits, scalarWith }

const SIGN: u64 = 0x8000000000000000
const MAGNITUDE: u64 = 0x7fffffffffffffff

/// Lowers `inst`, a number operation. `left`, `right` and `out` are the slots of its operands
/// and result (`right` and `out` unused when the operation has none); `exit` is its exit's
/// label when it has one.
pub effect fn lowerNumber(a: &mut Assembler, f: &Function, inst: Inst, left: Place, right: Place, out: Place, exit: Label) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let op = inst.op
  if op == Op.ConstF64 {
    run a.movImm64(Reg.Rax, f.numbers.get(i32.toUsize(inst.k)))
    run putBits(&mut a, out, Reg.Rax)
    return ()
  }
  if op == Op.ToF64 {
    let mut source = Reg.Rax
    if left.kind == GPR { source = left.gpr } else { run getI32(&mut a, Reg.Rax, left) }
    if out.kind == XMM { run a.intToDouble(Width.W32, out.xmm, source) return () }
    run a.intToDouble(Width.W32, Xmm.Xmm0, source)
    run putF64(&mut a, out, Xmm.Xmm0)
    return ()
  }
  if op == Op.AddF64 || op == Op.SubF64 || op == Op.MulF64 || op == Op.DivF64 {
    let mut scalar = ScalarOp.Add
    if op == Op.SubF64 { scalar = ScalarOp.Sub } else if op == Op.MulF64 { scalar = ScalarOp.Mul } else if op == Op.DivF64 { scalar = ScalarOp.Div }
    // In the result's register when the right operand is elsewhere (or, commuted, the left).
    if out.kind == XMM {
      let commutes = op == Op.AddF64 || op == Op.MulF64
      if !(right.kind == XMM && right.xmm == out.xmm) {
        run getF64(&mut a, out.xmm, left)
        run scalarWith(&mut a, scalar, out.xmm, right)
        return ()
      }
      if commutes && !(left.kind == XMM && left.xmm == out.xmm) {
        run scalarWith(&mut a, scalar, out.xmm, left)
        return ()
      }
    }
    run getF64(&mut a, Xmm.Xmm0, left)
    run scalarWith(&mut a, scalar, Xmm.Xmm0, right)
    run putF64(&mut a, out, Xmm.Xmm0)
    return ()
  }
  if op == Op.SqrtF64 {
    run scalarWith(&mut a, ScalarOp.Sqrt, Xmm.Xmm0, left)
    run putF64(&mut a, out, Xmm.Xmm0)
    return ()
  }
  if op == Op.NegF64 || op == Op.AbsF64 {
    // Sign bit flipped or cleared on the bits; no NaN or -0 special case is needed.
    run getBits(&mut a, Reg.Rax, left)
    if op == Op.NegF64 { run a.movImm64(Reg.R8, SIGN) run a.alu(Alu.Xor, Width.W64, Reg.Rax, Reg.R8) }
    else { run a.movImm64(Reg.R8, MAGNITUDE) run a.alu(Alu.And, Width.W64, Reg.Rax, Reg.R8) }
    run putBits(&mut a, out, Reg.Rax)
    return ()
  }
  if op == Op.FloorF64 {
    // Without SSE4.1's roundsd: truncate to int64, step down when that rounded up (negative
    // non-integers), and keep x's sign on a zero result (floor(-0) is -0, floor(-0.5) is -1).
    // A truncation outside int64 (NaN, infinities, |x| >= 2^63) is already integral: x itself.
    let same = run a.label()
    let exact = run a.label()
    let write = run a.label()
    let end = run a.label()
    run getF64(&mut a, Xmm.Xmm0, left)
    run a.doubleToInt(Width.W64, Reg.Rax, Xmm.Xmm0)
    run a.movImm64(Reg.R8, SIGN)
    run a.alu(Alu.Cmp, Width.W64, Reg.Rax, Reg.R8)
    run a.jcc(Cond.Equal, same)
    run a.intToDouble(Width.W64, Xmm.Xmm1, Reg.Rax)
    run a.packed(PackedOp.Ucomisd, Xmm.Xmm1, Xmm.Xmm0)
    run a.jcc(Cond.BelowOrEqual, exact)
    run a.aluImm(Alu.Sub, Width.W64, Reg.Rax, 1)
    run a.intToDouble(Width.W64, Xmm.Xmm1, Reg.Rax)
    a.bind(exact)
    run a.test(Width.W64, Reg.Rax, Reg.Rax)
    run a.jcc(Cond.NotEqual, write)
    run getBits(&mut a, Reg.R9, left)
    run a.alu(Alu.And, Width.W64, Reg.R9, Reg.R8)
    run putI32OrBits(&mut a, op, out, Reg.R9)
    run a.jmp(end)
    a.bind(write)
    run putF64(&mut a, out, Xmm.Xmm1)
    run a.jmp(end)
    a.bind(same)
    run putF64(&mut a, out, Xmm.Xmm0)
    a.bind(end)
    return ()
  }
  if op == Op.Imul {
    run getI32(&mut a, Reg.Rax, left)
    run getI32(&mut a, Reg.R8, right)
    run a.imul(Width.W32, Reg.Rax, Reg.R8)
    run putI32(&mut a, out, Reg.Rax)
    return ()
  }
  if op == Op.CmpF64 {
    run getF64(&mut a, Xmm.Xmm0, left)
    run getF64(&mut a, Xmm.Xmm1, right)
    run a.movImm32(Reg.R9, 0)
    run compareDoubles(&mut a, inst.k)
    run putI32OrBits(&mut a, op, out, Reg.R9)
    return ()
  }
  if op == Op.ExactI32 {
    // Exactly an int32 and not -0: truncate, convert back, compare; a zero result needs a
    // clear sign bit.
    run getF64(&mut a, Xmm.Xmm0, left)
    run a.doubleToInt(Width.W32, Reg.Rax, Xmm.Xmm0)
    run a.intToDouble(Width.W32, Xmm.Xmm1, Reg.Rax)
    run a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1)
    run a.jcc(Cond.Parity, exit)
    run a.jcc(Cond.NotEqual, exit)
    let fine = run a.label()
    run a.test(Width.W32, Reg.Rax, Reg.Rax)
    run a.jcc(Cond.NotEqual, fine)
    run getBits(&mut a, Reg.R8, left)
    run a.test(Width.W64, Reg.R8, Reg.R8)
    run a.jcc(Cond.Sign, exit)
    a.bind(fine)
    run a.mov(Width.W32, Reg.Rax, Reg.Rax)
    run putI32(&mut a, out, Reg.Rax)
    return ()
  }
  if op == Op.NotBool {
    run getI32(&mut a, Reg.Rax, left)
    run a.aluImm(Alu.Xor, Width.W32, Reg.Rax, 1)
    run putI32(&mut a, out, Reg.Rax)
    return ()
  }
  if op == Op.BitNot || op == Op.Neg {
    run getI32(&mut a, Reg.Rax, left)
    if op == Op.BitNot { run a.unary(Unary.Not, Width.W32, Reg.Rax) }
    else {
      // -0 and the overflow of the minimum make doubles in the interpreter.
      run a.test(Width.W32, Reg.Rax, Reg.Rax)
      run a.jcc(Cond.Equal, exit)
      run a.unary(Unary.Neg, Width.W32, Reg.Rax)
      run a.jcc(Cond.Overflow, exit)
    }
    run putI32(&mut a, out, Reg.Rax)
    return ()
  }
  if op == Op.BitAnd || op == Op.BitOr || op == Op.BitXor {
    let mut alu = Alu.And
    if op == Op.BitOr { alu = Alu.Or } else if op == Op.BitXor { alu = Alu.Xor }
    // A result in a register is computed there; one that shares an operand's register
    // takes the other operand (all three commute).
    if out.kind == GPR {
      if right.kind == GPR && right.gpr == out.gpr && !(left.kind == GPR && left.gpr == out.gpr) {
        run aluWith(&mut a, alu, out.gpr, left)
        return ()
      }
      run getI32(&mut a, out.gpr, left)
      run aluWith(&mut a, alu, out.gpr, right)
      return ()
    }
    run getI32(&mut a, Reg.Rax, left)
    run aluWith(&mut a, alu, Reg.Rax, right)
    run putI32(&mut a, out, Reg.Rax)
    return ()
  }
  if op == Op.Shl || op == Op.Sar || op == Op.Shr {
    let mut shift = Shift.Shl
    if op == Op.Sar { shift = Shift.Sar } else if op == Op.Shr { shift = Shift.Shr }
    // rcx kept in r11, which no value lives in (r10 is a pool register on a baseline frame).
    run a.mov(Width.W64, Reg.R11, Reg.Rcx)
    run getI32(&mut a, Reg.Rax, left)
    run getI32(&mut a, Reg.Rcx, right)
    // The 32-bit shift takes its count modulo 32, as JavaScript does.
    run a.shiftCl(shift, Width.W32, Reg.Rax)
    run a.mov(Width.W64, Reg.Rcx, Reg.R11)
    if op == Op.Shr {
      // An unsigned result past the int32 maximum is a double in the interpreter.
      run a.test(Width.W32, Reg.Rax, Reg.Rax)
      run a.jcc(Cond.Sign, exit)
    }
    run putI32(&mut a, out, Reg.Rax)
    return ()
  }
  if op == Op.Mod {
    // Only a positive divisor (no zero, no -1 fault), and never a -0 result.
    run getI32(&mut a, Reg.R8, right)
    run a.test(Width.W32, Reg.R8, Reg.R8)
    run a.jcc(Cond.LessOrEqual, exit)
    run a.mov(Width.W64, Reg.R11, Reg.Rdx)
    run getI32(&mut a, Reg.Rax, left)
    run a.mov(Width.W32, Reg.R9, Reg.Rax)
    run a.signExtendAccumulator(Width.W32)
    run a.unary(Unary.Idiv, Width.W32, Reg.R8)
    run a.mov(Width.W32, Reg.Rax, Reg.Rdx)
    run a.mov(Width.W64, Reg.Rdx, Reg.R11)
    let fine = run a.label()
    run a.test(Width.W32, Reg.Rax, Reg.Rax)
    run a.jcc(Cond.NotEqual, fine)
    run a.test(Width.W32, Reg.R9, Reg.R9)
    run a.jcc(Cond.Sign, exit)
    a.bind(fine)
    run putI32(&mut a, out, Reg.Rax)
    return ()
  }
  Intrinsic.trap("x64_backend_float: unlowered number operation")
}

/// out = r9: the comparison's bool, or for floor.f64 the bits of a signed zero.
effect fn putI32OrBits(a: &mut Assembler, op: Op, out: Place, src: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
  if op == Op.FloorF64 { run putBits(&mut a, out, src) return () }
  run putI32(&mut a, out, src)
}

/// The register `toInt32` reads its double from: the operand's own, or xmm0 loaded here.
effect fn doubleOf(a: &mut Assembler, left: Place) -> Xmm ! OutOfMemoryError ? &mut Allocator {
  if left.kind == XMM { return left.xmm }
  run getF64(&mut a, Xmm.Xmm0, left)
  return Xmm.Xmm0
}
/// The register `toInt32` leaves its result in: the result's own, or rax.
pub fn toInt32Work(out: Place) -> Reg { if out.kind == GPR { return out.gpr } return Reg.Rax }
/// ToInt32 of the double at `left`, straight line: a truncation that fits int64 has ToInt32 as
/// its low half. NaN, the infinities and |x| >= 2^63 give the int64 minimum, the one value
/// that overflows when 1 is taken from it: those go to `slow` (toInt32Slow), which comes back
/// to the label bound here with the result in the same register.
pub effect fn toInt32Fast(a: &mut Assembler, left: Place, out: Place, slow: Label, back: Label) -> () ! OutOfMemoryError ? &mut Allocator {
  let source = run doubleOf(&mut a, left)
  let work = toInt32Work(out)
  run a.doubleToInt(Width.W64, work, source)
  run a.aluImm(Alu.Cmp, Width.W64, work, 1)
  run a.jcc(Cond.Overflow, slow)
  run a.mov(Width.W32, work, work)
  a.bind(back)
  run putI32(&mut a, out, work)
}
/// The out-of-line half of toInt32Fast, entered with the double still where toInt32Fast read
/// it: 0 for NaN and the infinities, else the low 32 bits of the integer m * 2^(e - 52),
/// negated for a negative x (0 once the shift reaches 32).
pub effect fn toInt32Slow(a: &mut Assembler, left: Place, out: Place, back: Label) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut source = Xmm.Xmm0
  if left.kind == XMM { source = left.xmm }
  let work = toInt32Work(out)
  let zero = run a.label()
  let positive = run a.label()
  run a.doubleToBits(Reg.Rax, source)
  run a.mov(Width.W64, Reg.R9, Reg.Rax)
  run a.shiftImm(Shift.Shr, Width.W64, Reg.R9, 52)
  run a.aluImm(Alu.And, Width.W32, Reg.R9, 0x7ff)
  run a.aluImm(Alu.Cmp, Width.W32, Reg.R9, 0x7ff)
  run a.jcc(Cond.Equal, zero)
  run a.aluImm(Alu.Sub, Width.W32, Reg.R9, 1075)
  run a.aluImm(Alu.Cmp, Width.W32, Reg.R9, 31)
  run a.jcc(Cond.Above, zero)
  // The shift count goes in CL; RCX is a fragile/ABI register, kept in R11 meanwhile.
  run a.mov(Width.W64, Reg.R11, Reg.Rcx)
  run a.mov(Width.W32, Reg.Rcx, Reg.R9)
  run a.mov(Width.W64, Reg.R9, Reg.Rax)
  run a.movImm64(Reg.R8, 0x000fffffffffffff)
  run a.alu(Alu.And, Width.W64, Reg.R9, Reg.R8)
  run a.movImm64(Reg.R8, 0x0010000000000000)
  run a.alu(Alu.Or, Width.W64, Reg.R9, Reg.R8)
  run a.shiftCl(Shift.Shl, Width.W64, Reg.R9)
  run a.mov(Width.W64, Reg.Rcx, Reg.R11)
  run a.test(Width.W64, Reg.Rax, Reg.Rax)
  run a.jcc(Cond.NoSign, positive)
  run a.unary(Unary.Neg, Width.W32, Reg.R9)
  a.bind(positive)
  run a.mov(Width.W32, work, Reg.R9)
  run a.jmp(back)
  a.bind(zero)
  run a.movImm32(work, 0)
  run a.jmp(back)
}
/// The flags of the ordered comparison `k` (lt, le, gt, ge) of the doubles at `left` and
/// `right`, for a branch: the condition returned holds when the comparison does, and is false
/// when either is NaN (so is its opposite's complement: jump on `Cond` or on its negation).
pub effect fn compareDoublesFlags(a: &mut Assembler, k: i32, left: Place, right: Place) -> Cond ! OutOfMemoryError ? &mut Allocator {
  // lt and le compare the other way round, so that an unordered result (CF, ZF and PF set)
  // reads as false.
  let swapped = k == u8.toI32(Cmp.value(Cmp.Lt)) || k == u8.toI32(Cmp.value(Cmp.Le))
  let mut first = left
  let mut second = right
  if swapped { first = right second = left }
  let mut x = Xmm.Xmm0
  if first.kind == XMM { x = first.xmm } else { run getF64(&mut a, Xmm.Xmm0, first) }
  let mut y = Xmm.Xmm1
  if second.kind == XMM { y = second.xmm } else { run getF64(&mut a, Xmm.Xmm1, second) }
  run a.packed(PackedOp.Ucomisd, x, y)
  if k == u8.toI32(Cmp.value(Cmp.Lt)) || k == u8.toI32(Cmp.value(Cmp.Gt)) { return Cond.Above }
  return Cond.AboveOrEqual
}
/// Whether compareDoublesFlags takes comparison `k`: the ordered ones (eq and ne need the
/// parity flag too).
pub fn ordered(k: i32) -> bool {
  return k == u8.toI32(Cmp.value(Cmp.Lt)) || k == u8.toI32(Cmp.value(Cmp.Le)) || k == u8.toI32(Cmp.value(Cmp.Gt)) || k == u8.toI32(Cmp.value(Cmp.Ge))
}
/// Sets r9 (cleared by the caller) to the comparison `k` of xmm0 with xmm1, false when either
/// is NaN except for `ne`.
effect fn compareDoubles(a: &mut Assembler, k: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if k == u8.toI32(Cmp.value(Cmp.Lt)) { run a.packed(PackedOp.Ucomisd, Xmm.Xmm1, Xmm.Xmm0) run a.setcc(Cond.Above, Reg.R9) return () }
  if k == u8.toI32(Cmp.value(Cmp.Le)) { run a.packed(PackedOp.Ucomisd, Xmm.Xmm1, Xmm.Xmm0) run a.setcc(Cond.AboveOrEqual, Reg.R9) return () }
  if k == u8.toI32(Cmp.value(Cmp.Gt)) { run a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1) run a.setcc(Cond.Above, Reg.R9) return () }
  if k == u8.toI32(Cmp.value(Cmp.Ge)) { run a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1) run a.setcc(Cond.AboveOrEqual, Reg.R9) return () }
  run a.movImm32(Reg.R8, 0)
  run a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1)
  if k == u8.toI32(Cmp.value(Cmp.Eq)) {
    run a.setcc(Cond.Equal, Reg.R9) run a.setcc(Cond.NoParity, Reg.R8) run a.alu(Alu.And, Width.W32, Reg.R9, Reg.R8)
  } else {
    run a.setcc(Cond.NotEqual, Reg.R9) run a.setcc(Cond.Parity, Reg.R8) run a.alu(Alu.Or, Width.W32, Reg.R9, Reg.R8)
  }
}

