//! [`encode`] and [`restore`]: a model saved by one build and put back by the next, whose model
//! type may have changed.
import loom.keep { encode, restore }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

enum Filter {
  All,
  Open,
}

union Shape {
  Dot,
  Circle { pub radius: f64 },
  Line { pub from: i32, pub to: i32, pub label: String },
}

struct Todo {
  pub id: u64,
  pub title: String,
  pub done: bool,
}

struct Before {
  pub draft: String,
  pub count: i64,
  pub todos: List<Todo>,
  pub shapes: List<Shape>,
  pub picked: Option<Todo>,
  pub gone: u32,
  pub ratio: f32,
  pub filter: Filter,
  pub renamed: String,
}

/// `Todo` after an edit: a new field, which saved items do not have.
struct NextTodo {
  pub id: u64,
  pub title: String,
  pub done: bool,
  pub tags: List<String>,
}

struct After {
  pub draft: String,
  pub count: i64,
  pub todos: List<NextTodo>,
  pub shapes: List<Shape>,
  pub picked: Option<NextTodo>,
  pub ratio: f32,
  pub filter: Filter,
  /// Was a `String`.
  pub renamed: u32,
  pub added: u32,
  hidden: u32,
}

/// `Todo` with `done` now a number: saved items no longer fit.
struct StrictTodo {
  pub id: u64,
  pub title: String,
  pub done: u32,
}

struct Strict {
  pub todos: List<StrictTodo>,
}

effect fn todo(id: u64, title: string, done: bool) -> Todo
  ! OutOfMemoryError
  ? &mut Allocator {
  return Todo { id: id, title: run String.copy(title), done: done }
}

effect fn fresh() -> After
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut todos = List<NextTodo>.make()
  run todos.append(
    NextTodo { id: 99, title: run String.copy("init"), done: false, tags: List<String>.make() },
  )
  return After {
    draft: String.make(),
    count: 0,
    todos: move todos,
    shapes: List<Shape>.make(),
    picked: Option<NextTodo>.None,
    ratio: 1.0,
    filter: Filter.All,
    renamed: 7,
    added: 5,
    hidden: 3,
  }
}

effect fn keepBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut todos = List<Todo>.make()
  run todos.append(run todo(1, "milk \"oat\"\n", true))
  run todos.append(run todo(2, "bread", false))
  let mut shapes = List<Shape>.make()
  run shapes.append(Shape.Dot)
  run shapes.append(Shape.Circle { radius: 0.1 })
  run shapes.append(Shape.Line { from: -3, to: 4, label: run String.copy("é") })
  let before = Before {
    draft: run String.copy("half a thou"),
    count: -9223372036854775807,
    todos: move todos,
    shapes: move shapes,
    picked: Option<Todo>.some(run todo(2, "bread", false)),
    gone: 4,
    ratio: 0.25,
    filter: Filter.Open,
    renamed: run String.copy("x"),
  }
  let saved = run encode(&before)

  let mut after = run fresh()
  let report = run restore(&mut after, saved.ownedUtf8Bytes())
  run Testing.expect(String.view(&after.draft) == "half a thou", "a string goes back")
  run Testing.expect(after.count == -9223372036854775807, "a number goes back")
  run Testing.expect(after.ratio == 0.25, "a real goes back")
  run Testing.expect(after.added == 5 && after.hidden == 3, "new and private fields keep init")
  run Testing.expect(after.filter == Filter.All, "an enum keeps init")
  run Testing.expect(after.renamed == 7, "a field whose type changed keeps init")
  let items = after.todos.asSlice()
  run Testing.expect(items.length == 2, "the saved list replaces init's")
  run Testing.expect(items[0].id == 1 && items[0].done, "an item init made takes the saved one")
  run Testing.expect(String.view(&items[0].title) == "milk \"oat\"\n", "escapes go back")
  run Testing.expect(
    items[1].id == 2 && String.view(&items[1].title) == "bread",
    "items past init's are built",
  )
  run Testing.expect(items[1].tags.length() == 0, "a built item's new field starts empty")
  let shapesAfter = after.shapes.asSlice()
  run Testing.expect(shapesAfter.length == 3, "union items are built")
  run Testing.expect(
    match &shapesAfter[1] {
      Shape.Circle { radius } => radius == 0.1
      _ => false
    },
    "a variant with a field",
  )
  run Testing.expect(
    match &shapesAfter[2] {
      Shape.Line { from, to, label } => from == -3 && to == 4 && String.view(&label) == "é"
      _ => false
    },
    "a variant with three fields",
  )
  run Testing.expect(
    match &after.picked {
      Option.Some { value } => value.id == 2
      Option.None => false
    },
    "an option goes back from None to Some",
  )
  let reset = report.reset.asSlice()
  run Testing.expect(
    reset.length == 1 && String.view(&reset[0]) == "renamed",
    "the report names what kept init",
  )

  // The same build saves and restores everything it can see.
  let mut again = run fresh()
  let encodedAgain = run encode(&after)
  let whole = run restore(&mut again, encodedAgain.ownedUtf8Bytes())
  run Testing.expect(whole.whole(), "a model restores whole into its own type")
  let resaved = run encode(&again)
  run Testing.expect(
    String.view(&resaved) == String.view(&encodedAgain),
    "and saves the same again",
  )

  // An item that does not fit leaves the list as init made it, and frees what it built.
  let mut strict = Strict { todos: List<StrictTodo>.make() }
  let refused = run restore(&mut strict, saved.ownedUtf8Bytes())
  let paths = refused.reset.asSlice()
  run Testing.expect(strict.todos.length() == 0, "a list whose items no longer fit keeps init")
  run Testing.expect(
    paths.length == 1 && String.view(&paths[0]) == "todos[0]",
    "the report names the item",
  )

  // What is not JSON leaves the model as init made it.
  let mut broken = run fresh()
  let failed = run restore(&mut broken, b"{\"draft\": ")
  run Testing.expect(!failed.whole() && broken.todos.length() == 1, "an unreadable save keeps init")
}

test effect fn aModelGoesBackAcrossARebuild() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run keepBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
