    if Pointer.isNull<u8>(base) { j.source = nil() } else { j.source = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe at(base, consumed)) }
    j.sourceLength = total - consumed
    j.target = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe at(out, written)) j.capacity = room - written
    j.consumed = 0 j.written = 0 j.again = false
    unsafe process(&mut j, &mut h)
