//! Attribute spelling shared by selectors and the native accessibility fields.
import node { Node, Semantics }
import mutation { Attribute, NOT_FOCUSABLE, ariaText, ariaAttribute }
import ui_protocol.aria
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.text.format { Format, ParseError, Display }
import silk.core.result { Result }
import silk.num.f32
import silk.num.u8
import silk.num.usize
import silk.core.effect { Effect }
import silk.collections.slice { Slice }
import silk.io.writer { Writer, WriterError }

/// Whether an attribute sets a table cell's or column's span.
pub fn isSpan(name: string) -> bool { return name == "colspan" || name == "rowspan" || name == "span" }

/// A span attribute's number, as HTML parses it: digits after optional spaces, at most
/// 1000 columns or 65534 rows; usize.MAX when there are none.
pub fn spanValue(text: string) -> usize {
  let bytes = String.utf8Bytes(text)
  let mut i: usize = 0
  while i < bytes.length && (bytes[i] == 32 || bytes[i] == 9 || bytes[i] == 10) { i = i + 1 }
  let start = i
  let mut value: usize = 0
  while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 {
    if value < 65534 { value = value * 10 + u8.toUsize(bytes[i] - 48) }
    i = i + 1
  }
  if i == start { return usize.MAX }
  if value > 65534 { return 65534 }
  return value
}

fn flag(value: bool) -> string<'static> { return if value { "true" } else { "false" } }

pub effect fn semantic(name: string, text: string) -> Option<Attribute>
  ! OutOfMemoryError ? &mut Allocator {
  if name == "aria-label" { return Option<Attribute>.some(Attribute.Label { value: run String.copy(text) }) }
  if name == "aria-checked" { return Option<Attribute>.some(Attribute.Checked { value: text == "true" }) }
  if name == "aria-disabled" { return Option<Attribute>.some(Attribute.Disabled { value: text == "true" }) }
  if name == "aria-selected" { return Option<Attribute>.some(Attribute.Selected { value: text == "true" }) }
  if name == "aria-expanded" { return Option<Attribute>.some(Attribute.Expanded { value: text == "true" }) }
  if name == "aria-readonly" { return Option<Attribute>.some(Attribute.ReadOnly { value: text == "true" }) }
  return run ariaAttribute(String.utf8Bytes(name), String.utf8Bytes(text))
}

/// Writes the attribute as selectors and the accessibility tree spell it, and returns the
/// names written or removed ("" for none).
pub effect fn reflect(node: &mut Node, attribute: &Attribute) -> [string<'static>; 3]
  ! OutOfMemoryError ? &mut Allocator {
  match &attribute.* {
    Attribute.TabIndex { value } => {
      if value != NOT_FOCUSABLE { run reflectValue(&mut node.*, "tabindex", &value) }
      else if node.identity().isSome() {
        let identity = run node.identityMut()
        run identity.set(run String.copy("tabindex"), Option<String>.None)
      }
      return ["tabindex", "", ""]
    }
    Attribute.ValueRange { min, max, value } => {
      run reflectNumber(&mut node.*, "aria-valuemin", min)
      run reflectNumber(&mut node.*, "aria-valuemax", max)
      run reflectNumber(&mut node.*, "aria-valuenow", value)
      return ["aria-valuemin", "aria-valuemax", "aria-valuenow"]
    }
    Attribute.ClearValueRange => {
      if node.identity().isSome() {
        let identity = run node.identityMut()
        run identity.set(run String.copy("aria-valuemin"), Option<String>.None)
        run identity.set(run String.copy("aria-valuemax"), Option<String>.None)
        run identity.set(run String.copy("aria-valuenow"), Option<String>.None)
      }
      return ["aria-valuemin", "aria-valuemax", "aria-valuenow"]
    }
    _ => {}
  }
  let mut bytes = Bytes.make()
  let mut name: string<'static> = ""
  let mut text = ""
  match &attribute.* {
    Attribute.Role { value } => { name = "role" text = aria.roleName(value) }
    Attribute.Label { value } => { name = "aria-label" text = String.view(&value) }
    Attribute.Href { value } => { name = "href" text = String.view(&value) }
    Attribute.TestId { value } => { name = "data-testid" text = String.view(&value) }
    Attribute.Placeholder { value } => { name = "placeholder" text = String.view(&value) }
    Attribute.Checked { value } => {
      name = "aria-checked"
      let mixed = match node.semanticsOf() { Option<&Semantics>.Some { value: state } => state.indeterminate _ => false }
      text = if mixed { "mixed" } else { flag(value) }
    }
    Attribute.Indeterminate { value } => { name = "aria-checked" text = if value { "mixed" } else { flag(node.checked) } }
    Attribute.Disabled { value } => { name = "aria-disabled" text = flag(value) }
    Attribute.Selected { value } => { name = "aria-selected" text = flag(value) }
    Attribute.Expanded { value } => { name = "aria-expanded" text = flag(value) }
    Attribute.ReadOnly { value } => { name = "aria-readonly" text = flag(value) }
    Attribute.Hidden { value } => { name = "aria-hidden" text = flag(value) }
    Attribute.Atomic { value } => { name = "aria-atomic" text = flag(value) }
    Attribute.Busy { value } => { name = "aria-busy" text = flag(value) }
    Attribute.Required { value } => { name = "aria-required" text = flag(value) }
    Attribute.Invalid { value } => { name = "aria-invalid" text = flag(value) }
    Attribute.MultiSelectable { value } => { name = "aria-multiselectable" text = flag(value) }
    Attribute.Modal { value } => { name = "aria-modal" text = flag(value) }
    _ => {
      if let Option<string<'static>>.Some { value } = run ariaText(attribute, &mut bytes) {
        name = value
        text = unsafe String.fromUtf8Unchecked(bytes.asSlice())
      }
    }
  }
  if name != "" {
    let identity = run node.identityMut()
    let value = if text == "" { Option<String>.None } else { Option<String>.some(run String.copy(text)) }
    run identity.set(run String.copy(name), move value)
  }
  return [name, "", ""]
}

pub fn relationBit(name: string) -> u32 {
  if name == "aria-labelledby" { return 1 }
  if name == "aria-describedby" { return 2 }
  if name == "aria-controls" { return 4 }
  if name == "aria-activedescendant" { return 8 }
  return 0
}


effect fn reflectNumber(node: &mut Node, name: string, value: f32) ! OutOfMemoryError ? &mut Allocator {
  // Shortest round-tripping f32 text preserves small values and fractional precision.
  let canonical = if value == 0.0 { 0.0 } else { value }
  run reflectValue(&mut node.*, name, &canonical)
}

effect fn reflectValue<T: Display>(node: &mut Node, name: string, value: &T) ! OutOfMemoryError ? &mut Allocator {
  // Every f32 and i32 representation, including fixed decimal notation, fits here.
  let mut writer = NumberWriter { bytes: [0; 128], length: 0 }
  drop run Format.display(value) |> Effect.provideMut<Writer>(&mut writer) |> Effect.result
  let text = unsafe String.fromUtf8Unchecked(Slice.view<u8>(&writer.bytes, 0, writer.length))
  let identity = run node.identityMut()
  run identity.set(run String.copy(name), Option<String>.some(run String.copy(text)))
}

pub fn isRange(name: string) -> bool {
  return name == "aria-valuemin" || name == "aria-valuemax" || name == "aria-valuenow"
}

fn rangeNumber(node: &Node, name: string) -> Option<f32> {
  if let Option.Some { value: identity } = node.identity() {
    let mut i: usize = 0
    while i < identity.attributes().length {
      let attribute = &identity.attributes()[i]
      if String.view(&attribute.name) == name {
        return match move Format.f32Value(String.trim(String.view(&attribute.value))) {
          Result<f32, ParseError>.Success { value } => if f32.isFinite(value) { Option<f32>.some(value) } else { Option<f32>.None }
          Result<f32, ParseError>.Failure { error } => { drop error Option<f32>.None }
        }
      }
      i = i + 1
    }
  }
  return Option<f32>.None
}

/// Literal ARIA attributes remain intact for selectors, including absent bounds
/// and numeric spelling. Only their parsed accessibility representation changes.
pub effect fn syncRange(node: &mut Node) -> () ! OutOfMemoryError ? &mut Allocator {
  let min = rangeNumber(&node.*, "aria-valuemin")
  let max = rangeNumber(&node.*, "aria-valuemax")
  let now = rangeNumber(&node.*, "aria-valuenow")
  if min.isNone() && max.isNone() && now.isNone() && node.rare.isNone() { return () }
  let rare = run node.rareMut()
  rare.valueMin = match min { Option.Some { value } => value _ => 0.0 }
  rare.valueMax = match max { Option.Some { value } => value _ => 100.0 }
  rare.valueNow = match now { Option.Some { value } => value _ => 0.0 }
  rare.hasValueRange = now.isSome()
}


struct NumberWriter { bytes: [u8; 128], length: usize }
impl Writer for NumberWriter {
  effect fn writeAll(self: &mut Self, value: &[u8]) ! WriterError ? &mut Writer {
    let mut i: usize = 0
    while i < value.length { self.bytes[self.length] = value[i] self.length = self.length + 1 i = i + 1 }
  }
  effect fn flush(self: &mut Self) ! WriterError ? &mut Writer {}
}
