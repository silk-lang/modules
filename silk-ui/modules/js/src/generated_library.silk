  }\x0a  return String(n);\x0a}\x0a\x0a// Step scale & default step per WHATWG \xc2\xa74.10.5.3.9.\x0afunction stepScaleOf(type) {\x0a  if (type === \x22date\x22) return 86400000;\x0a  if (type === \x22week\x22) return 604800000;\x0a  if (type === \x22time\x22 || type === \x22datetime-local\x22) return 1000;\x0a  return 1;\x0a}\x0afunction defaultStepOf(type) {\x0a  if (type === \x22time\x22 || type === \x22datetime-local\x22) return 60;\x0a  return 1;\x0a}\x0afunction allowedValueStep(control) {\x0a  const type = control.type;\x0a  const raw = control.getAttribute(\x22step\x22);\x0a  const scale = stepScaleOf(type);\x0a  if (raw === null || raw.trim() === \x22\x22) return defaultStepOf(type) * scale;\x0a  if (raw.trim().toLowerCase() === \x22any\x22) return null;\x0a  const parsed = Number(raw);\x0a  if (!Number.isFinite(parsed) || parsed <= 0) return defaultStepOf(type) * scale;\x0a  return parsed * scale;\x0a}\x0afunction stepBaseOf(control) {\x0a  const type = control.type;\x0a  const minVal = parseInputValueAsNumber(type, control.getAttribute(\x22min\x22));\x0a  if (Number.isFinite(minVal)) return minVal;\x0a  const defVal = parseInputValueAsNumber(type, control.getAttribute(\x22value\x22));\x0a  if (Number.isFinite(defVal)) return defVal;\x0a  if (type === \x22week\x22) return -259200000; // 1970-W01 Monday\x0a  return 0;\x0a}\x0a\x0afunction stepInputValue(control, delta) {\x0a  const type = control.type;\x0a  if (!NUMERIC_OR_TEMPORAL_TYPES.has(type)) {\x0a    throw domError(\x22InvalidStateError\x22, \x22This input element does not support stepUp/stepDown.\x22);\x0a  }\x0a  const step = allowedValueStep(control);\x0a  if (step === null) throw domError(\x22InvalidStateError\x22, \x22This input element has step=\x5c\x22any\x5c\x22.\x22);\x0a  const min = parseInputValueAsNumber(type, control.getAttribute(\x22min\x22));\x0a  const max = parseInputValueAsNumber(type, control.getAttribute(\x22max\x22));\x0a  const base = stepBaseOf(control);\x0a  let current = control.valueAsNumber;\x0a  if (!Number.isFinite(current)) current = Number.isFinite(min) ? min : 0;\x0a  let next;\x0a  const rem = ((current - base) % step + step) % step;\x0a  if (rem > 1e-9 && step - rem > 1e-9 && delta !== 0) {\x0a    const snapped = delta > 0 ? current - rem + step : current - rem;\x0a    next = snapped + (delta > 0 ? delta - 1 : delta + 1) * step;\x0a  } else {\x0a    next = current + delta * step;\x0a  }\x0a  if (Number.isFinite(min) && next < min) {\x0a    next = min + Math.ceil((min - base) / step) * step - (min - base);\x0a    if (next < min) next = min;\x0a  }\x0a  if (Number.isFinite(max) && next > max) {\x0a    next = base + Math.floor((max - base) / step) * step;\x0a    if (next > max) next = max;\x0a  }\x0a  control.value = formatNumberForInputType(type, next);\x0a}\x0a\x0a// WHATWG \xc2\xa74.10.18.5: disabled directly or inside a disabled `<fieldset>` (exempting its first `<legend>` child).\x0aexport function isControlDisabled(node) {\x0a  if (!node || node.nodeType !== 1) return false;\x0a  if (node.hasAttribute(\x22disabled\x22)) return true;\x0a  if (node instanceof OptionElement) {\x0a    if (node.parentNode instanceof OptGroupElement && node.parentNode.hasAttribute(\x22disabled\x22)) return true;\x0a  }\x0a  let child = node;\x0a  for (let parent = node.parentNode; parent; child = parent, parent = parent.parentNode) {\x0a    if (parent.localName === \x22fieldset\x22 && parent.hasAttribute(\x22disabled\x22)) {\x0a      let firstLegend = null;\x0a      for (const c of parent.childNodes) {\x0a        if (c.localName === \x22legend\x22) { firstLegend = c; break; }\x0a      }\x0a      if (!firstLegend || child !== firstLegend) return true;\x0a    }\x0a  }\x0a  return false;\x0a}\x0a\x0afunction isInDataList(node) {\x0a  for (let p = node.parentNode; p; p = p.parentNode) {\x0a    if (p.localName === \x22datalist\x22) return true;\x0a  }\x0a  return false;\x0a}\x0a\x0a// WHATWG \xc2\xa74.10.18.3: form owner via `form` attribute (if conn