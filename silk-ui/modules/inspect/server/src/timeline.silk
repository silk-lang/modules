//! The frames the tree drew, as the host timed them: the inspector's `frames` command. The tree
//! cannot tell how long a frame took; a host that times its frames says so (`Inspector.timed`),
//! as the window host does.
//!
//! The `performance` command adds what a person waits for: each input that ran handlers and the
//! frame that showed it (`Inspector.interaction`), the startup steps up to the first frame
//! (`Inspector.started`), and the process's memory.
import reply { begin, finish, putFlag, putKey, putInt, putNumber }
import ui_tree.inspect { writeInt, writeNumber }
import ui_tree.node { FrameStats, NONE }
import ui_tree.engine { UiTree }
import ui_tree.inspect { roleName }
import ui_tree.process_memory
import ui_inspect.query { accessibleName }
import ui_tree.input { Input }
import ui_tree.mutation { Role }
import reply { writeString }
import silk.num.u32
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.f32
import silk.num.usize
import silk.text.string { String }

/// How many frames the timeline keeps.
pub const FRAME_LIMIT: usize = 240

/// How many interactions the timeline keeps.
pub const INTERACTION_LIMIT: usize = 100

/// An interaction slower than this, from the input to the frame that shows it, is slow (ms).
pub const SLOW_INTERACTION_MS: f32 = 100.0

/// One input that ran handlers, and the frame that showed what they did.
pub struct Interaction {
  /// The frame that showed it.
  pub frame: u64,
  /// What the person did: `click`, `key Enter`, `type`, `wheel`.
  pub input: String,
  /// What it was done to, as `button "Save"` or `#12`.
  pub target: String,
  /// The handlers and the program's update, then layout and paint of the frame, in ms.
  pub handleMs: f32,
  pub layoutMs: f32,
  pub paintMs: f32,
  /// From the input to the frame handed to the GPU, in ms.
  pub totalMs: f32,
}

/// How long the host took, from its start, to each step up to the first frame (ms).
pub struct Startup {
  pub windowMs: f32,
  pub gpuMs: f32,
  pub firstFrameMs: f32,
}

impl Copy for Startup {}

/// What a person did with an input an interaction starts with (`click`, `key Enter`, `type`),
/// or "" for one that is not (pointer moves, key releases).
pub effect fn interactionName(input: &Input) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &input.* {
    Input.PointerDown { .. } => run String.copy("press")
    Input.PointerUp { .. } => run String.copy("click")
    Input.Wheel { .. } => run String.copy("wheel")
    Input.KeyDown { key, .. } => {
      let mut name = run String.copy("key ")
      run name.append(String.view(&key))
      move name
    }
    Input.TextInput { .. } => run String.copy("type")
    Input.Paste { .. } => run String.copy("paste")
    _ => String.make()
  }
}

/// What `input` was done to, as a person would name it: the node under the pointer, or the
/// focused one for keys and text: `button "Save"`, `textbox "Title"`, `#12`.
pub effect fn interactionTarget(tree: &UiTree<'_>, input: &Input) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let id = match &input.* {
    Input.PointerDown { x, y, .. } => tree.hitTest(x, y)
    Input.PointerUp { x, y, .. } => tree.hitTest(x, y)
    Input.Wheel { x, y, .. } => tree.hitTest(x, y)
    _ => tree.focused
  }
  let mut out = String.make()
  if id == NONE {
    run out.append("the window")
    return move out
  }
  let slot = tree.slotOf(id)
  if slot != NONE {
    let nodeRole = tree.node(slot).accessRole
    if nodeRole != Role.None {
      run out.append(roleName(nodeRole))
      run out.append(" ")
    }
  }
  let mut name = String.make()
  run accessibleName(tree, id, &mut name)
  if String.byteLength(String.view(&name)) != 0 && String.byteLength(String.view(&name)) <= 60 {
    run out.append("\"")
    run out.append(String.view(&name))
    run out.append("\"")
  } else {
    run out.append("#")
    run writeInt(&mut out, u32.toU64(id))
  }
  return move out
}

/// One frame the tree drew.
pub struct FrameRecord {
  pub stats: FrameStats,
  /// How long layout and paint took, in milliseconds; zero when the host does not time them.
  pub layout: f32,
  pub paint: f32,
}

impl Copy for FrameRecord {}

/// The last [`FRAME_LIMIT`] frames.
pub struct Timeline {
  pub frames: List<FrameRecord>,
  layout: f32,
  paint: f32,
  /// Whether the host times its frames: a frame may take too little to show in its record.
  timing: bool,
  pub interactions: List<Interaction>,
  pub startup: Option<Startup>,
}

impl Timeline {
  pub fn make() -> Timeline {
    return Timeline {
      frames: List<FrameRecord>.make(),
      layout: 0.0,
      paint: 0.0,
      timing: false,
      interactions: List<Interaction>.make(),
      startup: Option<Startup>.None,
    }
  }

  /// Adds an interaction, dropping the oldest past [`INTERACTION_LIMIT`].
  pub effect fn interaction(self: &mut Self, interaction: Interaction) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.interactions.append(move interaction)
    if self.interactions.length() > INTERACTION_LIMIT {
      drop self.interactions.remove(0)
    }
  }

  /// performance: `startup` (when the host said), `memoryBytes` (0 where the system cannot
  /// say), and the interactions after frame `since`, at most `limit` of the newest, with the
  /// slowest; `slow` counts those over [`SLOW_INTERACTION_MS`].
  pub effect fn performance(self: &Self, request: &Value, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let since = Json.asU64(Json.field(request, "since")) |> Option<u64>.unwrapOr(0)
    let items = self.interactions.asSlice()
    let mut first: usize = 0
    while first < items.length && items[first].frame <= since {
      first = first + 1
    }
    if let Option<u64>.Some { value } = Json.asU64(Json.field(request, "limit")) {
      let limit = u64.toUsize(value)
      if items.length - first > limit {
        first = items.length - limit
      }
    }
    run begin(&mut out, request)
    if let Option<Startup>.Some { value } = self.startup {
      run putKey(&mut out, "startup")
      run out.append("{\"windowMs\":")
      run writeNumber(&mut out, value.windowMs)
      run out.append(",\"gpuMs\":")
      run writeNumber(&mut out, value.gpuMs)
      run out.append(",\"firstFrameMs\":")
      run writeNumber(&mut out, value.firstFrameMs)
      run out.append("}")
    }
    run putInt(&mut out, "memoryBytes", process_memory.footprint())
    run putKey(&mut out, "interactions")
    run out.append("[")
    let mut slowest = usize.MAX
    let mut slow: u64 = 0
    let mut i = first
    while i < items.length {
      if i > first {
        run out.append(",")
      }
      let item = &items[i]
      if slowest == usize.MAX || item.totalMs > items[slowest].totalMs {
        slowest = i
      }
      if item.totalMs > SLOW_INTERACTION_MS {
        slow = slow + 1
      }
      run writeInteraction(item, &mut out)
      i = i + 1
    }
    run out.append("]")
    run putInt(&mut out, "slow", slow)
    if slowest != usize.MAX {
      run putKey(&mut out, "slowest")
      run writeInteraction(&items[slowest], &mut out)
    }
    run finish(&mut out)
  }

  /// How long the frame about to be recorded took.
  pub fn timed(self: &mut Self, layout: f32, paint: f32) -> () {
    self.layout = layout
    self.paint = paint
    self.timing = true
  }

  /// Records the tree's last frame, once.
  pub effect fn record(self: &mut Self, stats: FrameStats) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.frames.length()
    if count != 0 && self.frames.get(count - 1).stats.frame == stats.frame {
      return ()
    }
    run self.frames.append(FrameRecord { stats: stats, layout: self.layout, paint: self.paint })
    self.layout = 0.0
    self.paint = 0.0
    if self.frames.length() > FRAME_LIMIT {
      drop self.frames.remove(0)
    }
  }

  /// frames: the frames after `since` (a frame number, 0 for all), oldest first, at most
  /// `limit` of the newest; `timed` says whether the host times them.
  pub effect fn describe(self: &Self, request: &Value, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let since = match Json.asU64(Json.field(request, "since")) {
      Option<u64>.Some { value } => value
      Option<u64>.None => 0
    }
    let frames = self.frames.asSlice()
    let mut first: usize = 0
    while first < frames.length && frames[first].stats.frame <= since {
      first = first + 1
    }
    match Json.asU64(Json.field(request, "limit")) {
      Option<u64>.Some { value } => {
        let limit = u64.toUsize(value)
        if frames.length - first > limit {
          first = frames.length - limit
        }
      }
      Option<u64>.None => {}
    }
    run begin(&mut out, request)
    run putKey(&mut out, "frames")
    run out.append("[")
    let mut slowest: f32 = 0.0
    let mut total: f32 = 0.0
    let mut i = first
    while i < frames.length {
      if i > first {
        run out.append(",")
      }
      let f = frames[i]
      let cost = f.layout + f.paint
      total = total + cost
      if cost > slowest {
        slowest = cost
      }
      run out.append("{\"frame\":")
      run writeInt(&mut out, f.stats.frame)
      run out.append(",\"layoutMs\":")
      run writeNumber(&mut out, f.layout)
      run out.append(",\"paintMs\":")
      run writeNumber(&mut out, f.paint)
      run out.append(",\"layoutSkipped\":")
      run out.append(
        if f.stats.layoutSkipped {
          "true"
        } else {
          "false"
        },
      )
      run out.append(",\"layoutPasses\":")
      run writeInt(&mut out, usize.toU64(f.stats.layout.passes))
      run out.append(",\"repainted\":")
      run writeInt(&mut out, usize.toU64(f.stats.repaintedSubtrees))
      run out.append(",\"replayed\":")
      run writeInt(&mut out, usize.toU64(f.stats.replayedSubtrees))
      run out.append(",\"fragments\":")
      run writeInt(&mut out, usize.toU64(f.stats.paintedFragments))
      run out.append(",\"primitives\":")
      run writeInt(&mut out, usize.toU64(f.stats.primitives))
      run out.append(",\"glyphs\":")
      run writeInt(&mut out, usize.toU64(f.stats.glyphs))
      run out.append(",\"nodes\":")
      run writeInt(&mut out, usize.toU64(f.stats.nodes))
      run out.append("}")
      i = i + 1
    }
    run out.append("]")
    let count = frames.length - first
    run putInt(&mut out, "count", usize.toU64(count))
    run putFlag(&mut out, "timed", self.timing)
    run putNumber(&mut out, "slowestMs", slowest)
    run putNumber(
      &mut out,
      "averageMs",
      if count == 0 {
        0.0
      } else {
        total / usize.toF32(count)
      },
    )
    run finish(&mut out)
  }
}

effect fn writeInteraction(item: &Interaction, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append("{\"frame\":")
  run writeInt(&mut out, item.frame)
  run out.append(",\"input\":")
  run writeString(&mut out, String.view(&item.input))
  run out.append(",\"target\":")
  run writeString(&mut out, String.view(&item.target))
  run out.append(",\"totalMs\":")
  run writeNumber(&mut out, item.totalMs)
  run out.append(",\"handleMs\":")
  run writeNumber(&mut out, item.handleMs)
  run out.append(",\"layoutMs\":")
  run writeNumber(&mut out, item.layoutMs)
  run out.append(",\"paintMs\":")
  run writeNumber(&mut out, item.paintMs)
  run out.append("}")
}

/// The line a debug build writes on standard error for a slow interaction.
pub effect fn slowLine(item: &Interaction) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut line = run String.copy("silk-ui: slow ")
  run line.append(String.view(&item.input))
  run line.append(" on ")
  run line.append(String.view(&item.target))
  run line.append(": ")
  run wholeMs(&mut line, item.totalMs)
  run line.append(" to the next frame (handlers ")
  run wholeMs(&mut line, item.handleMs)
  run line.append(", layout ")
  run wholeMs(&mut line, item.layoutMs)
  run line.append(", paint ")
  run wholeMs(&mut line, item.paintMs)
  run line.append(")\n")
  return move line
}

effect fn wholeMs(out: &mut String, ms: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run writeInt(&mut out, f32.toU64(f32.max(0.0, ms) + 0.5))
  run out.append(" ms")
}
