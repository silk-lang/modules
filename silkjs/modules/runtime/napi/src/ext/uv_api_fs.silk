// uv_fs_mkdtemp and uv_fs_mkstemp always copy the template; the copy holds the result.
unsafe fn templateRequest(loop: ?*mut u8, req: ?*mut u8, kind: i32, template: ?*const u8, cb: FsCallback) -> i32 {
  unsafe {
    if !initRequest(loop, req, kind, cb) { return -EINVAL }
    let copy = duplicate(nn<u8>(template))
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, setFields(req))
    r.path = copy
    drop r
    if Pointer.isNull<u8>(copy) { return -ENOMEM }
    return post(loop, req, cb)
  }
}
