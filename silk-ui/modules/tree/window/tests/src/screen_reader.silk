//! The development screen reader as the window host runs it: keys go to it first, it reads the
//! tree the platform adapter would publish, its actions reach the app, and its shortcut turns
//! it off again, overlay and all.
import ui_fixtures.fixtures as fixtures
import ui_tree.legacy { UiTree, TreeError, Batch, Event as Record, EventKind }
import ui_tree.input { Input, MOD_CONTROL, MOD_ALT, MOD_SHIFT }
import ui_tree.node { NONE }
import ui_tree_window.companion { Companion }
import ui_tree_window.screen_reader { ScreenReader, SCREEN_READER_ROOT }
import ui_inspect_server.lib { Inspector }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }
import silk.text.string { String }

effect fn press(
  reader: &mut ScreenReader,
  tree: &mut UiTree<'_>,
  inspector: &mut Inspector,
  key: string,
  code: string,
  modifiers: u32,
) -> bool
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let down = Input.KeyDown { key: run String.copy(key), code: run String.copy(code), modifiers: modifiers, repeat: false }
  let taken = run reader.key(&mut tree, &mut inspector, &down)
  let up = Input.KeyUp { key: run String.copy(key), code: run String.copy(code), modifiers: modifiers }
  drop run reader.key(&mut tree, &mut inspector, &up)
  drop run reader.pump(&mut tree, &mut inspector, 1.0)
  run tree.frame(fixtures.viewport(2))
  drop run reader.pump(&mut tree, &mut inspector, 1.0)
  return taken
}

fn last(reader: &ScreenReader) -> string<'_> {
  let said = reader.screenReader().history()
  if said.length == 0 {
    return ""
  }
  return said[said.length - 1].view()
}

effect fn body() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.inbox(&mut batch)
  run tree.apply(run batch.take())
  run tree.frame(fixtures.viewport(2))
  let mut inspector = Inspector.off()
  let mut reader = run ScreenReader.make(true, Option<String>.some(run String.copy("nvda,muted")))
  run reader.attach(&mut tree, &mut inspector)
  run tree.frame(fixtures.viewport(2))
  drop run reader.pump(&mut tree, &mut inspector, 0.0)
  run Testing.expect(reader.isOn(), "the variable turns it on at start")
  run Testing.expect(reader.overlay() == SCREEN_READER_ROOT, "its ring and captions draw over the window")

  // Started, it reads the line its cursor starts on.
  run Testing.expect(last(&reader) == "New button Archive button Delete button unavailable", "it reads where it starts")

  // B is NVDA's next button in browse mode: it reads that button, and the app never sees the key.
  let taken = run press(&mut reader, &mut tree, &mut inspector, "b", "KeyB", 0)
  run Testing.expect(taken, "browse mode takes quick navigation keys")
  run Testing.expect(last(&reader) == "Archive button", "quick navigation reads the element, not its line")
  run Testing.expect(tree.browseCursor == fixtures.ARCHIVE_BUTTON, "the tree tracks the independent browse cursor")

  // Enter activates it, as assistive technology does: the app hears a click.
  let mut events = List<Record>.make()
  run tree.takeEvents(&mut events)
  events.clear()
  drop run press(&mut reader, &mut tree, &mut inspector, "Enter", "Enter", 0)
  run tree.takeEvents(&mut events)
  let mut clicked = false
  let list = events.asSlice()
  let mut i: usize = 0
  while i < list.length {
    if list[i].kind == EventKind.Click && list[i].target == fixtures.ARCHIVE_BUTTON {
      clicked = true
    }
    i = i + 1
  }
  run Testing.expect(clicked, "Enter clicks the button under the cursor")

  // Its shortcut turns it off, and the app has its keys back.
  let shortcut = MOD_CONTROL | MOD_ALT | MOD_SHIFT
  drop run press(&mut reader, &mut tree, &mut inspector, "S", "KeyS", shortcut)
  run Testing.expect(!reader.isOn() && reader.overlay() == NONE, "Ctrl+Alt+Shift+S turns it off")
  run Testing.expect(tree.browseCursor == NONE, "turning off the reader releases its pin")
  let free = run press(&mut reader, &mut tree, &mut inspector, "b", "KeyB", 0)
  run Testing.expect(!free, "off, it takes no keys")
}

test effect fn theScreenReaderRunsBesideTheApp() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}
