        // the value from RAX and R9 when it was just read: nothing below touches the two
        // before the store.
        let moved = self.movedInto(&function, self.cursor)
        let mut held = self.isFresh(inst.b) && self.settings.layout.tagWidth == 1
        let mut at: i32 = 0
