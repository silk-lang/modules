    if j.status != 0 { break }
    let progressed = j.consumed != 0 || j.written != 0
    if !(j.again && progressed && written < room) { break }
  }
  j.source = base j.sourceLength = total j.target = out j.capacity = room
  j.consumed = consumed j.written = written
}
unsafe fn execute(j: &mut Job) -> () {
