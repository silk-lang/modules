  if err != 0 { return err }
  if (flags & UV_UDP_REUSEADDR) != 0 { let err2 = unsafe reuseAddress(sock) if err2 != 0 { return err2 } }
  if (flags & UV_UDP_REUSEPORT) != 0 { let err3 = unsafe reusePort(sock) if err3 != 0 { return err3 } }
  unsafe setFd(udp, sock)
  if unsafe udpIsConnected(udp) { unsafe raise(udp, UDP_CONNECTED) }
