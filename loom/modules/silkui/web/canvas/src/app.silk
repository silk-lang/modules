import loom_window.program { StylesheetCompiler as Compiler, runtimeStylesheets }
//! A Loom app on the page's canvas: what the host silkui generates for the web-canvas target
//! runs. The page (silkui's `modules/tree/window/browser/app-host.js`) calls the host's `main` through
//! JSPI, and the app runs until the page closes.
//!
//! ```silk,ignore
//! import project.app { Model, Message }
//! import silkui_web_canvas.app { Settings, main as loom }
//!
//! pub fn main() -> i32 {
//!   return loom<Model, Message>(Settings { title: "My app" })
//! }
//! ```
import loom.app { NoCommand }
import loom.program { Program, CommandSet }
import loom.shell { Shell }
import loom_window.program { Launched, Window, StyleAssets, SheetWatch, show, failed }
import ui_fixtures.fixtures as fixtures
import silk.system.filesystem { FileError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The page's title. The canvas fills the page.
pub struct Settings {
  pub title: string<'static>,
}

impl Copy for Settings {}

effect fn opened<P: Program<M, NoCommand>, M>(settings: Settings, sources: &[&[u8]], updatePath: string, compiler: Compiler) -> i32 ! FileError | OutOfMemoryError ? &mut Allocator {
  // The browser has no system fonts to read, so the page gets the tree's own.
  let fonts = run fixtures.fonts()
  let mut window = run Window.make(settings.title, 800.0, 600.0)
  window.withStylesheetCompiler(compiler)
  window.withStyleSheets(run StyleAssets.from(sources))
  window.withStyleSheetUpdates(run SheetWatch.from(updatePath))
  return run show<P, M, NoCommand, never>(move window, &fonts, Option<Launched>.None)
}

effect fn openedWithCommands<P: Program<M, C>, M, C: CommandSet<M, &mut Shell | &mut Allocator>>(settings: Settings, sources: &[&[u8]], updatePath: string, compiler: Compiler) -> i32
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut window = run Window.make(settings.title, 800.0, 600.0)
  window.withStylesheetCompiler(compiler)
  window.withStyleSheets(run StyleAssets.from(sources))
  window.withStyleSheetUpdates(run SheetWatch.from(updatePath))
  let mut shell = window.shell()
  return run show<P, M, C, &mut Shell | &mut Allocator>(move window, &fonts, Option<Launched>.None)
    |> Effect.provideMut<Shell>(&mut shell)
}

/// The host's `main` for an app without commands. Answers the exit code.
pub fn main<P: Program<M, NoCommand>, M>(settings: Settings) -> i32 {
  return mainWithSheets<P, M>(settings, &[])
}

/// Starts with build-compiled application sheets, in adoption order.
pub fn mainWithSheets<P: Program<M, NoCommand>, M>(settings: Settings, sources: &[&[u8]]) -> i32 {
  return mainWithSheetUpdates<P, M>(settings, sources, "")
}

pub fn mainWithSheetUpdates<P: Program<M, NoCommand>, M>(settings: Settings, sources: &[&[u8]], updatePath: string) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(opened<P, M>(settings, sources, updatePath, Compiler.off()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

/// [`main`] for an app with commands `C`, which may ask the page's [`Shell`] for things.
pub fn withCommands<P: Program<M, C>, M, C: CommandSet<M, &mut Shell | &mut Allocator>>(settings: Settings) -> i32 {
  return withCommandsAndSheets<P, M, C>(settings, &[])
}

pub fn withCommandsAndSheets<P: Program<M, C>, M, C: CommandSet<M, &mut Shell | &mut Allocator>>(
  settings: Settings, sources: &[&[u8]],
) -> i32 {
  return withCommandsAndSheetUpdates<P, M, C>(settings, sources, "")
}

pub fn withCommandsAndSheetUpdates<P: Program<M, C>, M, C: CommandSet<M, &mut Shell | &mut Allocator>>(
  settings: Settings, sources: &[&[u8]], updatePath: string,
) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(openedWithCommands<P, M, C>(settings, sources, updatePath, Compiler.off()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn mainWithRuntimeSheets<P: Program<M, NoCommand>, M>(settings: Settings, sources: &[&[u8]], updatePath: string) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(opened<P, M>(settings, sources, updatePath, runtimeStylesheets()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn withCommandsAndRuntimeSheets<P: Program<M, C>, M, C: CommandSet<M, &mut Shell | &mut Allocator>>(
  settings: Settings, sources: &[&[u8]], updatePath: string,
) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(openedWithCommands<P, M, C>(settings, sources, updatePath, runtimeStylesheets()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
