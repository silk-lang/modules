//! [`TextSystem`]: css-layout's `TextMeasure` over a font collection, plus the font metrics
//! its `Measure.font` needs and the glyph runs behind each text fragment.
import properties.census { Census }
import fonts { FontState, TextStyle, KeyInfo }
import glyphs { GlyphStore, GlyphRun, PositionedGlyph }
import analysis { Analyzer, analyze }
import shaping { Shaping, shapeLine }
import lines { LineCache }
import font_collection.lib { FontCollection }
import layout.lib {
  TextMeasure,
  TextContext,
  TextToken,
  TextTokenKind,
  Direction,
  UnicodeBidi,
  WritingMode,
  TextOrientation,
  WhiteSpaceCollapse,
  TextJustify,
  TextRange,
  TextBreak,
  TextAnalysis,
  TextShapeRequest,
  TextRun,
  TextCursor,
  TextError,
  FontRequest,
  FontMetrics,
  Measure,
  MeasureRequest,
  Measured,
  NaturalDimensions,
  ScrollbarRequest,
  ScrollbarMetrics,
  Size,
  Rect,
  BaselineSet
}
import raster.face { FontFace }
import read_fonts.lib { FontRef }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.text.string { String }
import silk.core.ownership { Copy }

/// A glyph of a line shaped by [`TextSystem.shapeOneLine`]: its font key, and its origin from
/// the line's start and from its baseline, y down, in CSS pixels.
pub struct LineGlyph {
  pub fontKey: usize,
  pub glyph: u32,
  pub x: f32,
  pub y: f32,
}

impl Copy for LineGlyph {}

/// Text measurement and shaping for css-layout over the fonts of a [`FontCollection`].
///
/// Register each text style with [`TextSystem.addStyle`] and put the returned key in
/// `Style.fontKey`. Pass the system (or a provider that forwards to it) to `compute`;
/// forward `Measure.font` to [`TextSystem.font`]. After layout, each `TextFragment.shapeKey`
/// names a run in [`TextSystem.glyphs`].
pub struct TextSystem<'a> {
  pub fonts: FontState<'a>,
  pub glyphs: GlyphStore,
  analyzer: Analyzer,
  /// The shaping state, with its counters and its switch for checking.
  pub shaping: Shaping,
  lines: LineCache,
  /// Provider calls, for tests and benchmarks.
  pub analyzeCalls: usize,
  pub shapeCalls: usize,
  /// For the bench census: lines the line cache answered, and the tokens of every line asked.
  pub lineHits: usize,
  pub shapeTokens: usize,
  /// For the bench: after shaping a whole paragraph, shape lines cut where its runs say a cut is
  /// safe, without taking glyphs from it, and count the lines whose runs differ.
  pub verifyCuts: bool,
  pub cutsChecked: usize,
  pub cutsWrong: usize,
  pub cutsSafe: usize,
  pub cutsUnsafe: usize,
}

impl<'a> TextSystem<'a> {
  /// What the text system holds and did, for the bench census.
  pub effect fn census(self: &Self, out: &mut Census) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.fonts.census(&mut out)
    run self.glyphs.census(&mut out)
    run self.shaping.census(&mut out)
    run self.lines.census(&mut out)
    run out.work("text.analyze.calls", self.analyzeCalls)
    run out.work("text.shape.calls(lines asked)", self.shapeCalls)
    run out.work("text.shape.line-cache-hits", self.lineHits)
    run out.work("text.shape.tokens-asked", self.shapeTokens)
  }

  pub fn make(collection: &'a FontCollection) -> TextSystem<'a> {
    return TextSystem {
      fonts: FontState.make(collection),
      glyphs: GlyphStore.make(),
      analyzer: Analyzer.make(),
      shaping: Shaping.make(),
      lines: LineCache.make(),
      analyzeCalls: 0,
      shapeCalls: 0,
      lineHits: 0,
      shapeTokens: 0,
      verifyCuts: false,
      cutsChecked: 0,
      cutsWrong: 0,
      cutsSafe: 0,
      cutsUnsafe: 0,
    }
  }

  /// Adds a text style and returns its font key.
  pub effect fn addStyle(self: &mut Self, style: TextStyle) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.fonts.addStyle(move style)
  }

  /// The metrics of `request.key`, for `Measure.font`. Unknown keys get zero metrics.
  pub fn font(self: &Self, request: FontRequest) -> FontMetrics {
    if request.key >= self.fonts.keyCount() {
      return FontMetrics.zero()
    }
    return self.fonts.metricsOf(request.key)
  }

  /// What font key `key` stands for: its style, face and size.
  pub fn keyInfo(self: &Self, key: usize) -> KeyInfo {
    return self.fonts.key(key)
  }

  /// The run behind a fragment's `shapeKey`.
  /// Forgets every shaped run and line and gives their storage back. The keys handed out
  /// before become invalid: the layout trees that hold them must be laid out afresh
  /// (see [`GlyphStore.clear`]).
  pub fn release(self: &mut Self) -> () {
    self.glyphs.release()
    self.lines.release()
  }

  pub fn glyphRun(self: &Self, shapeKey: usize) -> GlyphRun {
    return self.glyphs.glyphRun(shapeKey)
  }

  /// The glyphs behind a fragment's `shapeKey`, positioned from the fragment's left edge and
  /// its baseline.
  pub fn runGlyphs(self: &Self, shapeKey: usize) -> &[PositionedGlyph] {
    return self.glyphs.glyphsOf(shapeKey)
  }

  /// Shapes `text` as one unbroken left-to-right line in font key `fontKey`, with the fallback
  /// of its style, appends its glyphs to `out`, and returns its advance. For text drawn
  /// outside layout (a 2D canvas): the glyph store and the line cache keep nothing of it.
  pub effect fn shapeOneLine(self: &mut Self, fontKey: usize, text: string, out: &mut List<LineGlyph>) -> f32
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    if String.byteLength(text) == 0 { return 0.0 }
    let tokens = [
      TextToken {
        kind: TextTokenKind.Text, text: text, source: 0, sourceStart: 0, sourceEnd: String.byteLength(text),
        fontKey: fontKey, writingMode: WritingMode.HorizontalTb, textOrientation: TextOrientation.Mixed,
        direction: Direction.Ltr, unicodeBidi: UnicodeBidi.Normal, replacedInline: false,
        whiteSpaceCollapse: WhiteSpaceCollapse.Preserve, textJustify: TextJustify.Auto, shapingBarrier: false,
      },
    ]
    let context = TextContext {
      tokens: &tokens, writingMode: WritingMode.HorizontalTb, textOrientation: TextOrientation.Mixed,
      direction: Direction.Ltr, unicodeBidi: UnicodeBidi.Normal, textJustify: TextJustify.Auto,
    }
    let mut breaks = List<TextBreak>.make()
    let analysis = run analyze(&mut self.analyzer, context, &self.fonts, &mut breaks)
    let hanging: [TextRange; 0] = []
    let request = TextShapeRequest {
      context: context, start: TextCursor { unit: 0, offset: 0 }, end: analysis.paragraph.end,
      analysis: &analysis, hyphenated: false, ellipsis: false, justificationSpace: 0.0, hangingRanges: &hanging,
    }
    let mark = self.glyphs.length()
    let mut runs = List<TextRun>.make()
    run shapeLine(&mut self.shaping, &mut self.fonts, &mut self.glyphs, request, &mut runs)
    let mut pen: f32 = 0.0
    let mut i: usize = 0
    while i < runs.length() {
      if let TextRun.Text { fontKey: key, shapeKey, advance, .. } = runs.get(i) {
        let glyphs = self.glyphs.glyphsOf(shapeKey)
        let mut g: usize = 0
        while g < glyphs.length {
          run out.append(LineGlyph { fontKey: key, glyph: glyphs[g].glyph, x: pen + glyphs[g].x, y: glyphs[g].y })
          g = g + 1
        }
        pen = pen + advance
      }
      i = i + 1
    }
    self.glyphs.truncate(mark)
    return pen
  }

  /// The face of font key `key` at its variation coordinates, for a `font-raster` glyph
  /// cache. Its id identifies the face and variation coordinates in this text system.
  pub effect fn rasterFace(self: &Self, key: usize) -> Option<FontFace<'a>>
    ! OutOfMemoryError
    ? &mut Allocator {
    let info = self.fonts.key(key)
    if info.face == usize.MAX {
      return Option<FontFace<'a>>.None
    }
    if let Option<FontRef<'a>>.Some { value: font } = self.fonts.set.font(info.face) {
      let face = run FontFace.make(
        usize.toU32(self.fonts.instanceOf(key)),
        font,
        self.fonts.coords(key),
      )
      return Option<FontFace<'a>>.Some { value: move face }
    }
    return Option<FontFace<'a>>.None
  }
}

impl<'a> TextMeasure for TextSystem<'a> {
  fn beginTextLayout(provider: &mut Self) {}

  fn plainText(provider: &Self) -> bool {
    return true
  }

  fn reportsBreakSafety(provider: &Self) -> bool {
    return true
  }

  effect fn analyze(
    provider: &mut Self,
    context: TextContext<'_, '_>,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    provider.analyzeCalls = provider.analyzeCalls + 1
    return run analyze(&mut provider.analyzer, context, &provider.fonts, &mut output)
  }

  effect fn shape(
    provider: &mut Self,
    request: TextShapeRequest<'_, '_>,
    output: &mut List<TextRun>,
  )
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    provider.shapeCalls = provider.shapeCalls + 1
    provider.shapeTokens = provider.shapeTokens + (request.end.unit - request.start.unit) + 1
    let mut kept = false
    if run provider.lines.find(&provider.glyphs, &request, &mut output, &mut kept) {
      provider.lineHits = provider.lineHits + 1
      return
    }
    let first = output.length()
    let base = request.start.unit
    run shapeLine(
      &mut provider.shaping,
      &mut provider.fonts,
      &mut provider.glyphs,
      request,
      &mut output,
    )
    if kept {
      run provider.lines.keep(base, Slice.view(output.asSlice(), first, output.length() - first))
    }
    if provider.verifyCuts && request.start.unit == 0 && request.start.offset == 0
      && !request.end.before(request.analysis.paragraph.end) && !request.hyphenated && !request.ellipsis
      && request.justificationSpace == 0.0 {
      run verifyCuts(&mut provider, request, Slice.view(output.asSlice(), first, output.length() - first))
    }
  }
}

fn sameRun(left: TextRun, right: TextRun) -> bool {
  if let TextRun.Text { unit, start, end, advance, fontKey, bidiLevel, shapeKey, .. } = left {
    if let TextRun.Text { unit: otherUnit, start: otherStart, end: otherEnd, advance: otherAdvance,
      fontKey: otherKey, bidiLevel: otherLevel, shapeKey: otherShape, .. } = right {
      return unit == otherUnit && start == otherStart && end == otherEnd && advance == otherAdvance
        && fontKey == otherKey && bidiLevel == otherLevel && shapeKey == otherShape
    }
  }
  return false
}

fn lineStart(value: TextRun) -> usize {
  if let TextRun.Text { unit, start, .. } = value {
    if start == 0 { return unit }
  }
  return usize.MAX
}

// Shapes the lines of a whole paragraph's `runs` that start at a cut its runs call safe, ending
// at one of the next few such cuts or at its end, and counts those whose runs differ.
effect fn verifyCuts<'a>(provider: &mut TextSystem<'a>, request: TextShapeRequest<'_, '_>, runs: &[TextRun]) -> ()
  ! OutOfMemoryError | TextError
  ? &mut Allocator {
  let mut whole = List<TextRun>.make()
  run whole.appendSlice(runs)
  let mut flags = List<bool>.make()
  run flags.appendSlice(provider.shaping.unsafeRuns.asSlice())
  if flags.length() != whole.length() { return }
  let mut starts = List<usize>.make()
  let mut index: usize = 1
  while index < whole.length() {
    if lineStart(whole.get(index)) != usize.MAX {
      if flags.get(index) {
        provider.cutsUnsafe = provider.cutsUnsafe + 1
      } else {
        provider.cutsSafe = provider.cutsSafe + 1
        run starts.append(index)
      }
    }
    index = index + 1
  }
  let reuse = provider.shaping.reuse
  provider.shaping.reuse = false
  let mut line = List<TextRun>.make()
  let mut from: usize = 0
  while from < starts.length() {
    let mut to = from + 1
    while to <= from + 3 && to <= starts.length() {
      let low = starts.get(from)
      let high = if to < starts.length() { starts.get(to) } else { whole.length() }
      let mut sub = request
      sub.start = TextCursor { unit: lineStart(whole.get(low)), offset: 0 }
      if to < starts.length() {
        sub.end = TextCursor { unit: lineStart(whole.get(high)), offset: 0 }
      }
      line.clear()
      run shapeLine(&mut provider.shaping, &mut provider.fonts, &mut provider.glyphs, sub, &mut line)
      provider.cutsChecked = provider.cutsChecked + 1
      let mut same = line.length() == high - low
      let mut at: usize = 0
      while same && at < line.length() {
        same = sameRun(line.get(at), whole.get(low + at))
        at = at + 1
      }
      if !same { provider.cutsWrong = provider.cutsWrong + 1 }
      to = to + 1
    }
    from = from + 1
  }
  provider.shaping.reuse = reuse
}

/// A `Measure` for trees whose only content is text: fonts come from the system, and there
/// are no scrollbars, opaque measurements or replaced resources. Wrap the system in your own
/// provider when the tree has those.
impl<'a> Measure for TextSystem<'a> {
  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    return Measured {
      size: Size { width: 0.0, height: 0.0 },
      contentBlockSize: 0.0,
      firstBaselines: BaselineSet.zero(),
      lastBaselines: BaselineSet.zero(),
      hasBaseline: false,
      hasLineBoxes: false,
      scrollableOverflow: Rect.zero(),
    }
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    return NaturalDimensions.none()
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    return ScrollbarMetrics.zero()
  }

  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    return TextSystem.font(&provider.*, request)
  }
}
