//! Equal nodes take a lent node's whole result: one style handle, one layout style entry, and
//! text under equal parents one inherited style, which stay right through class changes.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput }
import ui_fixtures.fixtures as fixtures
import svg_css.compile { Options, CompileError }
import svg_css.compile
import svg_css.tokens { CssError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.frozen { Frozen }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn frame(time: f64) -> FrameInput { return FrameInput { width: 800.0, height: 300.0, scale: 1.0, time: time } }

fn width(tree: &UiTree<'_>, id: u32) -> f32 { return tree.node(tree.slotOf(id)).computed().layout.width.value }
fn red(tree: &UiTree<'_>, id: u32) -> f32 { return tree.node(tree.slotOf(id)).computed().text.color.r }

/// Whether the two nodes hold one style handle.
fn oneStyle(tree: &UiTree<'_>, first: u32, second: u32) -> bool {
  return Frozen.same(&tree.node(tree.slotOf(first)).styled, &tree.node(tree.slotOf(second)).styled)
}

/// Whether the two elements hold one layout style entry.
fn oneLayout(tree: &UiTree<'_>, first: u32, second: u32) -> bool {
  return tree.layout.styleIndex(tree.node(tree.slotOf(first)).css) == tree.layout.styleIndex(tree.node(tree.slotOf(second)).css)
}

effect fn element(batch: &mut Batch, id: u32, parent: u32, classes: string) -> () ! OutOfMemoryError ? &mut Allocator {
  run batch.create(id, NodeKind.Box)
  run batch.attribute(id, Attribute.ClassName { value: run String.copy(classes) })
  run batch.append(parent, id)
}

effect fn change(tree: &mut UiTree<'_>, id: u32, classes: string, time: f64) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.attribute(id, Attribute.ClassName { value: run String.copy(classes) })
  run tree.apply(run batch.take())
  run tree.frame(frame(time))
}

// Rows 10, 20 … 80 of two cells (row + 1, row + 2), each cell holding text (row + 5, row + 6).
effect fn sharing() -> () ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let mut row: u32 = 10
  while row <= 80 {
    run element(&mut batch, row, 1, "row")
    run element(&mut batch, row + 1, row, "cell")
    run element(&mut batch, row + 2, row, "cell")
    run batch.create(row + 5, NodeKind.Text)
    run batch.append(row + 1, row + 5)
    run batch.setText(row + 5, "one")
    run batch.create(row + 6, NodeKind.Text)
    run batch.append(row + 2, row + 6)
    run batch.setText(row + 6, "two")
    row = row + 10
  }
  let sheet = run compile.compile(b".row{display:flex;width:300px;color:rgb(0,0,255)}.cell{width:20px;height:4px}.wide .cell{width:25px}.warm{color:rgb(255,0,0)}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(0.0))
  run Testing.expect(tree.work.sharedResults > 0 && tree.work.textInherits > 0, "equal nodes and their text take whole results")
  run Testing.expect(oneStyle(&tree, 21, 71) && oneLayout(&tree, 21, 72) && oneStyle(&tree, 25, 76), "cells, their layout style and their text are held once")
  run Testing.expect(width(&tree, 41) == 20.0 && red(&tree, 45) == 0.0, "with the sheet's values")

  run change(&mut tree, 40, "row wide warm", 1.0)
  run Testing.expect(width(&tree, 41) == 25.0 && width(&tree, 42) == 25.0 && width(&tree, 31) == 20.0 && width(&tree, 51) == 20.0, "a changed row's cells take their own width")
  run Testing.expect(red(&tree, 45) == 1.0 && red(&tree, 46) == 1.0 && red(&tree, 35) == 0.0 && red(&tree, 55) == 0.0, "and its text its own color")
  run Testing.expect(!oneLayout(&tree, 41, 51) && oneLayout(&tree, 31, 51) && !oneStyle(&tree, 45, 55), "while the other rows keep theirs")

  run change(&mut tree, 40, "row", 2.0)
  run Testing.expect(width(&tree, 41) == 20.0 && red(&tree, 45) == 0.0 && oneLayout(&tree, 41, 51) && oneStyle(&tree, 45, 55), "and go back to sharing once it is plain again")
}

test effect fn equalNodesTakeWholeResults() -> () ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sharing() |> Effect.provideMut<Allocator>(&mut allocator)
}
