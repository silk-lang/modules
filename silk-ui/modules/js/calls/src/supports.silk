//! `CSS.supports`: the condition `@supports` evaluates, with the same parser and catalog, so a
//! check in JavaScript and a stylesheet's `@supports` block always agree.
import css_style.supports
import css_style.values { Store }
import css_style.input { Input }
import css_style.tokens { Limits, CssError }
import css_style.lexer
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn matches(text: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let evaluated = run Effect.result(evaluate(text, &limits))
  return match move evaluated {
    Result<bool, CssError | OutOfMemoryError>.Success { value } => value
    Result<bool, CssError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      CssError _ => false
    }
  }
}

effect fn evaluate(text: &[u8], limits: &Limits) -> bool ! CssError | OutOfMemoryError ? &mut Allocator {
  let buffer = run lexer.tokenize(text, limits)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  return run supports.matches(&source, &mut store, limits)
}

/// `CSS.supports(conditionText)`: the condition as `@supports` reads it, or else wrapped in
/// parentheses, so `"display: grid"` is a declaration test as in browsers.
pub effect fn condition(text: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  if run matches(text) { return true }
  let mut wrapped = List<u8>.make()
  run wrapped.append(40)
  run wrapped.appendSlice(text)
  run wrapped.append(41)
  return run matches(wrapped.asSlice())
}

/// `CSS.supports(property, value)`: whether `property: value` is a declaration the tree takes.
pub effect fn declaration(property: &[u8], value: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  // A value that would close the test early is not one declaration value.
  if !balanced(value) { return false }
  let mut text = List<u8>.make()
  run text.append(40)
  run text.appendSlice(property)
  run text.append(58)
  run text.appendSlice(value)
  run text.append(41)
  return run matches(text.asSlice())
}

/// Whether the brackets of `value` nest, outside strings: `1px) or (color: red` does not.
fn balanced(value: &[u8]) -> bool {
  let mut depth: usize = 0
  let mut quote: u8 = 0
  let mut i: usize = 0
  while i < value.length {
    let c = value[i]
    if quote != 0 {
      if c == 92 { i = i + 1 } else if c == quote { quote = 0 }
    } else if c == 34 || c == 39 {
      quote = c
    } else if c == 92 {
      i = i + 1
    } else if c == 40 || c == 91 || c == 123 {
      depth = depth + 1
    } else if c == 41 || c == 93 || c == 125 {
      if depth == 0 { return false }
      depth = depth - 1
    } else if c == 59 && depth == 0 {
      return false
    }
    i = i + 1
  }
  return depth == 0 && quote == 0
}
