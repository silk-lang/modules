fn width(environment: Option<Environment>) -> f64 {
  if let Option<Environment>.Some { value } = environment {
    if let Option<QuerySize>.Some { value: size } = value.querySize { return size.width }
  }
  return -1.0
}

effect fn shadow(tree: &UiTree<'_>, slot: u32, x: f32, y: f32, blur: f32) ! AssertionError<'static> {
  if let Option.Some { value } = tree.node(slot).paintEffects() {
    let effects = value
    run Testing.expect(effects.shadows.length() == 1, "container-relative text shadow parses")
    let found = effects.shadows.asSlice()[0]
    run Testing.expect(found.x == x && found.y == y && found.blur == blur, "paint effects use the same independent container axes as layout")
  } else {
    run Testing.expect(false, "container-relative paint effects are installed")
  }
}

effect fn selection() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("outer") })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("inner") })
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("subject") })
  let source = b".outer{container:outer card red currentcolor / size;width:400px;height:300px;font-size:20px}.inner{--name:ca\\72 d;container:var(--name) / inline-size;width:200px;height:100px;font-size:10px}.subject{container-name:inherit;container-type:size;width:100cqw;height:100cqh}.subject::before{content:'';width:1px;height:1px}@container (width>49cqw){.subject{border-top-width:3px}}@container (width>50cqw){.subject{border-bottom-width:4px}}@container card (width>250px){.subject{padding-top:11px}}@container card (height>250px){.subject{margin-top:13px}}@container (width>100px) and (height>250px){.subject{padding-bottom:7px}}@container card (inline-size>15em){.subject{padding-left:9px}}@container (width:200px){.subject::before{margin-left:17px}}"
  let sheet = run compile.compile(source, &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let outer = tree.slotOf(1)
  let inner = tree.slotOf(2)
  let subject = tree.slotOf(3)
  let firstChanges = run container_watch.changed(&tree)
  run Testing.expect(firstChanges.length() == 0, "initial container geometry settles in the first frame")
  run Testing.expect(tree.node(outer).computed().layout.containsSize(true) && tree.node(outer).computed().layout.containsSize(false) && tree.node(inner).computed().layout.containsSize(true) && !tree.node(inner).computed().layout.containsSize(false), "container shorthand projects layout containment")
  let adapter = SelectorTree { tree: &tree }
  run Testing.expect(width(adapter.container(u32.toUsize(subject), b"card", 1, PseudoTarget.None)) == 200.0, "width query selects the nearest named eligible ancestor")
  run Testing.expect(width(adapter.container(u32.toUsize(subject), b"card", 2, PseudoTarget.None)) == 400.0, "height query skips an inline-size-only ancestor")
  run Testing.expect(adapter.container(u32.toUsize(subject), b"Card", 1, PseudoTarget.None).isNone(), "container names are case-sensitive")
  run Testing.expect(width(adapter.container(u32.toUsize(inner), b"card", 1, PseudoTarget.None)) == 400.0, "ordinary elements do not query themselves")
  let computed = tree.node(subject).computed().*
  run Testing.expect(computed.layout.width.value == 200.0 && computed.layout.height.value == 300.0 && computed.usesContainer, "physical container units select ancestors independently")
  run Testing.expect(computed.layout.padding.top.value == 0.0, "a failed query does not try a more distant same-named container")
  run Testing.expect(computed.paint.border.top == 3.0 && computed.paint.border.bottom == 0.0, "container units in conditions resolve on the selected container against its own ancestors")
  run Testing.expect(computed.layout.margin.top.value == 13.0 && computed.layout.padding.bottom.value == 7.0, "one selected size container satisfies all required physical axes")
  run Testing.expect(computed.layout.padding.left.value == 9.0, "query em values use the selected container's font size")
  let pseudoChanges = run container_watch.changed(&tree)
  run Testing.expect(pseudoChanges.length() == 0, "pseudo query changes settle with their originating element")
  let before = tree.node(subject).identity()
  if let Option.Some { value } = before {
    run Testing.expect(tree.node(value.before).computed().layout.margin.left.value == 17.0, "pseudo-element queries can select their originating element")
  }
  run Testing.expect((run container_watch.changed(&tree)).length() == 0, "stable query results and unit bases need no further refinement")
  run Testing.expect(width(SelectorTree { tree: &tree }.container(u32.toUsize(subject), b"outer", 3, PseudoTarget.None)) == 400.0, "all names in a container-name list participate")
  run Testing.expect(width(SelectorTree { tree: &tree }.container(u32.toUsize(subject), b"red", 1, PseudoTarget.None)) == 400.0, "color-named containers remain identifiers")
  run Testing.expect(width(SelectorTree { tree: &tree }.container(u32.toUsize(subject), b"currentcolor", 1, PseudoTarget.None)) == 400.0, "contextual color keywords also remain container identifiers")
  run Testing.expect(width(SelectorTree { tree: &tree }.container(u32.toUsize(subject), b"card", 1, PseudoTarget.Before)) == 200.0, "container-name inheritance preserves the originating element's names")
  let mut edit = Batch.make()
  run edit.style(2, &[Declaration { property: Property.ContainerName, important: false, value: values.keyword(Keyword.None) }])
  run tree.apply(run edit.take())
  run tree.frame(frame)
  run Testing.expect(width(SelectorTree { tree: &tree }.container(u32.toUsize(subject), b"card", 1, PseudoTarget.None)) == 400.0, "removing a nearer name exposes the next named eligible ancestor")
  run Testing.expect(tree.node(subject).computed().layout.padding.top.value == 11.0, "descendant query styles follow a container-name change")
}

test effect fn containerSelectionUsesNamesAxesPseudoOriginsAndLastLayout() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run selection() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn objectUnits() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  let outer = run written.declarations(b"container:red / size;width:400px;height:300px")
  let inner = run written.declarations(b"container-type:inline-size;width:200px;height:100px")
  let subject = run written.declarations(b"width:100cqi;height:100cqb;translate:10cqi 20cqb;perspective:10cqmax;text-shadow:1cqw 2cqh 3cqmin red;writing-mode:vertical-rl")
  run batch.style(1, outer.asSlice())
  run batch.style(2, inner.asSlice())
  run batch.style(3, subject.asSlice())
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let slot = tree.slotOf(3)
  let computed = tree.node(slot).computed().*
  run Testing.expect(computed.layout.width.value == 300.0 && computed.layout.height.value == 200.0, "style-object logical units follow the subject writing mode and independently selected physical ancestors")
  run Testing.expect(computed.transform.translate.x == 30.0 && computed.transform.translate.y == 40.0 && computed.transform.perspective == 30.0, "transforms use container logical axes and min/max bases")
  run shadow(&tree, slot, 2.0, 6.0, 6.0)
  let effectsHash = computed.effects.hash
  run Testing.expect(width(SelectorTree { tree: &tree }.container(u32.toUsize(slot), b"red", 3, PseudoTarget.None)) == 400.0, "style objects install container shorthand names and type")
  let mut edit = Batch.make()
  let normal = run written.declarations(b"container-type:normal")
  run edit.style(1, normal.asSlice())
  run edit.style(2, normal.asSlice())
  run tree.apply(run edit.take())
  run tree.frame(frame)
  let fallback = tree.node(slot).computed().*
  run Testing.expect(fallback.layout.width.value == 600.0 && fallback.layout.height.value == 800.0, "missing containers fall back to the subject's logical viewport axes")
  run Testing.expect(fallback.transform.translate.x == 60.0 && fallback.transform.translate.y == 160.0 && fallback.transform.perspective == 80.0, "transforms follow containment removal")
  run shadow(&tree, slot, 8.0, 12.0, 18.0)
  run Testing.expect(fallback.effects.hash != effectsHash, "changing container bases invalidates cached paint effects")
  run tree.frame(FrameInput { width: 700.0, height: 500.0, scale: 1.0, time: 0.0 })
  let resized = tree.node(slot).computed().*
  run Testing.expect(resized.layout.width.value == 500.0 && resized.layout.height.value == 700.0, "container-unit fallbacks invalidate when the viewport changes")
  run Testing.expect(resized.transform.translate.x == 50.0 && resized.transform.translate.y == 140.0 && resized.transform.perspective == 70.0, "transform fallbacks follow viewport changes")
  run shadow(&tree, slot, 7.0, 10.0, 15.0)
}
test effect fn containerStyleObjectsAndVerticalUnitFallback() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run objectUnits() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn gridWidths(tree: &UiTree<'_>, expected: &[f32]) ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut i: usize = 0
  while i < expected.length {
    let info = run inspect.infoSlot(tree, tree.slotOf(usize.toU32(i) + 4))
    run Testing.expect(match info { Option.Some { value } => value.bounds.width() == expected[i] _ => false }, "grid tracks resolve font, viewport and independent container lengths")
    i = i + 1
  }
}

effect fn gridUnits(sheetStyles: bool) ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  let names = ["outer", "inner", "grid"]
  let mut i: usize = 0
  while i < names.length {
    let id = usize.toU32(i) + 1
    run batch.create(id, NodeKind.Box)
    run batch.attribute(id, Attribute.ClassName { value: run String.copy(names[i]) })
    if i != 0 { run batch.append(id - 1, id) }
    i = i + 1
  }
  run batch.root(1)
  i = 0
  while i < 9 {
    let id = usize.toU32(i) + 4
    run batch.create(id, NodeKind.Box)
    run batch.append(3, id)
    let height = run written.declarations(b"height:1px")
    run batch.style(id, height.asSlice())
    i = i + 1
  }
  if sheetStyles {
    let sheet = run compile.compile(b".outer{container-type:size;width:400px;height:300px}.inner{container-type:inline-size;width:200px;height:100px}.grid{display:grid;width:1000px;grid-template-columns:10cqw 10cqh repeat(2,minmax(0,10cqi)) 10cqb 10cqmin 10cqmax 2em 10vw;font-size:10px}", &Options.make())
    let bytes = run sheet.encode()
    run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  } else {
    let outer = run written.declarations(b"container-type:size;width:400px;height:300px")
    let inner = run written.declarations(b"container-type:inline-size;width:200px;height:100px")
    let grid = run written.declarations(b"display:grid;width:1000px;grid-template-columns:10cqw 10cqh repeat(2,minmax(0,10cqi)) 10cqb 10cqmin 10cqmax 2em 10vw;font-size:10px")
    run batch.style(1, outer.asSlice())
    run batch.style(2, inner.asSlice())
    run batch.style(3, grid.asSlice())
  }
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  run gridWidths(&tree, &[20.0, 30.0, 20.0, 20.0, 30.0, 20.0, 30.0, 20.0, 80.0])
  let width = run written.declarations(b"width:100px")
  let height = run written.declarations(b"height:200px")
  let font = run written.declarations(b"font-size:15px")
  run batch.style(1, height.asSlice())
  run batch.style(2, width.asSlice())
  run batch.style(3, font.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run gridWidths(&tree, &[10.0, 20.0, 10.0, 10.0, 20.0, 10.0, 20.0, 30.0, 80.0])
  let smaller = FrameInput { width: 700.0, height: 500.0, scale: 1.0, time: 0.0 }
  run tree.frame(smaller)
  run gridWidths(&tree, &[10.0, 20.0, 10.0, 10.0, 20.0, 10.0, 20.0, 30.0, 70.0])
  let normal = run written.declarations(b"container-type:normal")
  run batch.style(1, normal.asSlice())
  run batch.style(2, normal.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(smaller)
  run gridWidths(&tree, &[70.0, 50.0, 70.0, 70.0, 50.0, 50.0, 70.0, 30.0, 70.0])
  let hovered = run written.declarations(b"grid-template-columns:repeat(9,5cqw)")
  run batch.styleFor(3, StyleState.Hover, hovered.asSlice())
  run tree.apply(run batch.take())
  let slot = tree.slotOf(3)
  let node = tree.nodeMut(slot)
  node.hovered = true
  tree.restyle(slot)
  run tree.frame(smaller)
  run gridWidths(&tree, &[35.0; 9])
  let override = run written.declarations(b"grid-template-columns:repeat(9,2em)")
  drop run tree.setOverride(3, StyleState.Base, move override, false)
  run tree.frame(smaller)
  run gridWidths(&tree, &[30.0; 9])
  drop tree.clearOverride(3, StyleState.Base)
  run tree.frame(smaller)
  run gridWidths(&tree, &[35.0; 9])
  run batch.push(Mutation.ClearStyle { id: 3, state: StyleState.Hover })
  run tree.apply(run batch.take())
  run tree.frame(smaller)
  run gridWidths(&tree, &[70.0, 50.0, 70.0, 70.0, 50.0, 50.0, 70.0, 30.0, 70.0])
  if sheetStyles {
    run batch.removeStyleSheet(0, 1)
    run tree.apply(run batch.take())
    run tree.frame(smaller)
    run gridWidths(&tree, &[100.0; 9])
  } else {
    let mut explicit = Grid.make()
    i = 0
    while i < 9 {
      run explicit.template.columns.tracks.append(GridTrack.breadth(GridBreadth.fixed(42.0)))
      i = i + 1
    }
    run batch.push(Mutation.SetGrid { id: 3, value: run Box<Grid>.make(move explicit) })
    run tree.apply(run batch.take())
    run tree.frame(smaller)
    run gridWidths(&tree, &[42.0; 9])
    let font = run written.declarations(b"font-size:25px")
    run batch.style(3, font.asSlice())
    run tree.apply(run batch.take())
    run tree.frame(smaller)
    run gridWidths(&tree, &[42.0; 9])
    let columns = run written.declarations(b"grid-template-columns:repeat(9,3em)")
    run batch.style(3, columns.asSlice())
    run tree.apply(run batch.take())
    run tree.frame(smaller)
    run gridWidths(&tree, &[75.0; 9])
  }
}

test effect fn containerGridTracksUseTheFinalStyleContext() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run gridUnits(false) |> Effect.provideMut<Allocator>(&mut allocator)
  run gridUnits(true) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn keyframeUnits(sheetStyles: bool) ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("subject") })
  let container = run written.declarations(b"container-type:size;width:200px;height:100px")
  run batch.style(1, container.asSlice())
  if sheetStyles {
    let sheet = run compile.compile(b".subject{animation:grow 1s linear both;height:1px}@keyframes grow{from{width:10cqw}to{width:20cqw}}", &Options.make())
    let bytes = run sheet.encode()
    run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  } else {
    let mut frames = List<Keyframe>.make()
    run frames.append(Keyframe { offset: 0.0, declarations: run written.declarations(b"width:10cqw") })
    run frames.append(Keyframe { offset: 1.0, declarations: run written.declarations(b"width:20cqw") })
    run batch.keyframes("grow", move frames)
    let animation = run written.declarations(b"animation:grow 1s linear both;height:1px")
    run batch.style(2, animation.asSlice())
  }
  run tree.apply(run batch.take())
  let mut frame = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let slot = tree.slotOf(2)
  run Testing.expect(tree.node(slot).computed().layout.width.value == 20.0 && tree.node(slot).computed().usesContainer, "keyframe-only units select containers without a base declaration using them")
  frame.time = 0.5
  run tree.frame(frame)
  run Testing.expect(tree.node(slot).computed().layout.width.value == 30.0, "keyframe endpoints interpolate against the selected container")
  let wider = run written.declarations(b"width:400px")
  run batch.style(1, wider.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(tree.node(slot).computed().layout.width.value == 60.0, "changing the unit basis retains animation progress")
  let paused = run written.declarations(b"animation-play-state:paused")
  run batch.style(2, paused.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  let normal = run written.declarations(b"container-type:normal")
  run batch.style(1, normal.asSlice())
  run tree.apply(run batch.take())
  frame.time = 2.0
  run tree.frame(frame)
  run Testing.expect(tree.node(slot).computed().layout.width.value == 120.0, "paused keyframes retain progress when containment is removed")
  frame.width = 1000.0
  run tree.frame(frame)
  run Testing.expect(tree.node(slot).computed().layout.width.value == 150.0, "paused keyframe-only fallback units invalidate on viewport resize")
}

test effect fn containerKeyframesResolveUnitsWithoutBaseDeclarations() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run keyframeUnits(false) |> Effect.provideMut<Allocator>(&mut allocator)
  run keyframeUnits(true) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn beforeExists(tree: &UiTree<'_>, slot: u32) -> bool {
  return match tree.node(slot).identity() { Option.Some { value } => value.before != NONE _ => false }
}

effect fn absentPseudo() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("subject") })
  let container = run written.declarations(b"container-type:size;width:400px;height:300px")
  run batch.style(1, container.asSlice())
  let sheet = run compile.compile(b".subject{width:100px;height:20px}@container(width>300px){.subject::before{content:'ready';display:block;width:10px;height:1px}}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let slot = tree.slotOf(2)
  run Testing.expect(beforeExists(&tree, slot) && (run container_watch.changed(&tree)).length() == 0, "an origin refinement creates the newly matching pseudo")
  let smaller = run written.declarations(b"width:200px")
  run batch.style(1, smaller.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(!beforeExists(&tree, slot) && (run container_watch.changed(&tree)).length() == 0, "removing a generated box retains its now-false dependency")
}

test effect fn containerDependenciesRetainAbsentPseudoQueries() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run absentPseudo() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rootWatches() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  let ids: [u32; 2] = [1, 11]
  let rootStyles = [b"container-type:size;width:400px;height:300px", b"container-type:size;width:80px;height:50px"]
  let mut i: usize = 0
  while i < ids.length {
    run batch.create(ids[i], NodeKind.Box)
    let style = run written.declarations(rootStyles[i])
    run batch.style(ids[i], style.asSlice())
    run batch.create(ids[i] + 1, NodeKind.Box)
    run batch.append(ids[i], ids[i] + 1)
    let child = run written.declarations(b"width:100cqw;height:1px")
    run batch.style(ids[i] + 1, child.asSlice())
    i = i + 1
  }
  run batch.root(1)
  run batch.openRoot(1, 11, RootOptions.default())
  run tree.apply(run batch.take())
  let wide = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  let narrow = FrameInput { width: 200.0, height: 100.0, scale: 1.0, time: 0.0 }
  run tree.frameRoot(0, wide)
  run Testing.expect((run container_watch.changed(&tree)).length() == 0, "the first root's unit dependency settles")
  run tree.frameRoot(1, narrow)
  let changes = run container_watch.changed(&tree)
  run Testing.expect(changes.length() == 0 && tree.node(tree.slotOf(12)).computed().layout.width.value == 80.0, "each root settles against only its own container geometry")
  drop run tree.useRoot(0)
  run Testing.expect((run container_watch.changed(&tree)).length() == 0, "parked query and unit records return with their original layout")
  let old = tree.slotOf(2)
  run batch.push(Mutation.Destroy { id: 2 })
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  run tree.apply(run batch.take())
  run Testing.expect(tree.slotOf(3) == old && (run container_watch.changed(&tree)).length() == 0, "a recycled node slot does not inherit an old dependency")
  tree.stylesDirty = true
  run tree.frame(wide)
  run batch.append(1, 12)
  run tree.apply(run batch.take())
  run tree.frameRoot(0, wide)
  run Testing.expect(tree.node(tree.slotOf(12)).computed().layout.width.value == 400.0, "a moved dependent selects its new root's container")
  drop run tree.useRoot(1)
  run Testing.expect((run container_watch.changed(&tree)).length() == 0, "a moved node cannot be reevaluated against its previous root's output")
}

test effect fn containerDependencyRecordsFollowRootsAndSlotReuse() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rootWatches() |> Effect.provideMut<Allocator>(&mut allocator)
}


import ui_tree.legacy { EventKind, LISTEN_ALL, Fragmentainers, LayoutRect }

fn near(a: f32, b: f32) -> bool { return a - b < 0.001 && b - a < 0.001 }
fn eventCount(tree: &UiTree<'_>, kind: EventKind) -> usize {
  let mut count: usize = 0
  let mut i: usize = 0
  while i < tree.events.length() { if tree.events.asSlice()[i].kind == kind { count = count + 1 } i = i + 1 }
  return count
}

effect fn transitionPasses() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  let classes = ["outer", "inner", "subject"]
  let mut i: usize = 0
  while i < classes.length {
    let id = usize.toU32(i + 1)
    run batch.create(id, NodeKind.Box)
    if i == 0 { run batch.root(id) } else { run batch.append(id - 1, id) }
    run batch.attribute(id, Attribute.ClassName { value: run String.copy(classes[i]) })
    i = i + 1
  }
  run batch.listen(3, LISTEN_ALL)
  run batch.create(4, NodeKind.Box)
  run batch.append(1, 4)
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("other") })
  run batch.listen(4, LISTEN_ALL)
  let sheet = run compile.compile(b".outer{container-type:size;width:400px;height:200px}.inner{container-type:size;width:50cqw;height:100px}.subject{width:100cqw;height:10px;transition:width 1s linear}@starting-style{.subject{width:0px}}.other{animation:peer 1s linear both}@keyframes peer{from{opacity:.4}to{opacity:.8}}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let mut frame = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let subject = tree.slotOf(3)
  run Testing.expect(near(tree.node(subject).computed().layout.width.value, 0.0), "starting styles survive all initial geometry refinements")
  run Testing.expect(tree.transitions.length() == 1 && tree.transitions.get(0).duration == 1.0, "settling creates only the final transition")
  run Testing.expect(eventCount(&tree, EventKind.TransitionRun) == 1 && eventCount(&tree, EventKind.TransitionStart) == 1 && eventCount(&tree, EventKind.TransitionCancel) == 0, "initial fallback and intermediate container sizes do not leak transition events")
  run Testing.expect(tree.events.length() >= 3 && tree.events.asSlice()[0].kind == EventKind.TransitionRun
    && tree.events.asSlice()[1].kind == EventKind.TransitionStart && tree.events.asSlice()[2].kind == EventKind.AnimationStart
    && tree.events.asSlice()[2].target == 4, "provisional events retain their position before unrelated motion events")
  frame.time = 0.5
  run tree.frame(frame)
  run Testing.expect(near(tree.node(subject).computed().layout.width.value, 100.0), "the transition targets the final 200px container basis")
  tree.events.clear()
  let larger = run written.declarations(b"width:800px")
  run batch.style(1, larger.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(near(tree.node(subject).computed().layout.width.value, 100.0), "retargeting starts from the same-clock sample")
  run Testing.expect(eventCount(&tree, EventKind.TransitionCancel) == 1 && eventCount(&tree, EventKind.TransitionRun) == 1 && eventCount(&tree, EventKind.TransitionStart) == 1, "only the final retarget emits cancellation and start events")
  frame.time = 1.0
  run tree.frame(frame)
  run Testing.expect(near(tree.node(subject).computed().layout.width.value, 250.0), "retargeted progress is not reset by intermediate passes")
  tree.events.clear()
  let smaller = run written.declarations(b"width:200px")
  run batch.style(1, smaller.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(tree.transitions.length() == 1 && near(tree.transitions.get(0).factor, 0.5) && tree.transitions.get(0).duration == 0.5, "reversal uses the pre-change transition and its shortening factor")
  run Testing.expect(eventCount(&tree, EventKind.TransitionCancel) == 1 && eventCount(&tree, EventKind.TransitionRun) == 1, "a multi-pass reversal emits one event pair")
  frame.time = 1.25
  run tree.frame(frame)
  run Testing.expect(near(tree.node(subject).computed().layout.width.value, 175.0), "the reversal reaches its expected midpoint")
  frame.time = 1.5
  run tree.frame(frame)
  run Testing.expect(near(tree.node(subject).computed().layout.width.value, 100.0), "the reversed transition ends at the settled container basis")
}

test effect fn containerSettlingPreservesStartingTransitionsRetargetsAndReversals()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run transitionPasses() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn transientPseudo() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  let classes = ["outer", "inner", "subject"]
  let mut i: usize = 0
  while i < classes.length {
    let id = usize.toU32(i + 1)
    run batch.create(id, NodeKind.Box)
    if i == 0 { run batch.root(id) } else { run batch.append(id - 1, id) }
    run batch.attribute(id, Attribute.ClassName { value: run String.copy(classes[i]) })
    i = i + 1
  }
  run batch.listen(3, LISTEN_ALL)
  let sheet = run compile.compile(b".outer{container:card / size;width:400px;height:200px}.inner{container-type:inline-size;width:50cqw;height:100px}.subject{width:100px;height:20px}@container card (width>300px){.subject::before{content:'animated';animation:grow 1s linear both}}@keyframes grow{from{font-size:10px;opacity:0}to{font-size:30px;opacity:1}}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let mut frame = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let origin = tree.slotOf(3)
  let before = match tree.node(origin).identity() { Option.Some { value } => value.before _ => NONE }
  run Testing.expect(before != NONE && eventCount(&tree, EventKind.AnimationStart) == 1, "the initially matched pseudo starts one animation")
  frame.time = 0.25
  run tree.frame(frame)
  tree.events.clear()
  let larger = run written.declarations(b"width:800px")
  let named = run written.declarations(b"container-name:card")
  run batch.style(1, larger.asSlice())
  run batch.style(2, named.asSlice())
  run tree.apply(run batch.take())
  frame.time = 0.5
  run tree.frame(frame)
  let after = match tree.node(origin).identity() { Option.Some { value } => value.before _ => NONE }
  run Testing.expect(before == after && tree.node(before).live, "a false intermediate query preserves the original generated box")
  run Testing.expect(near(tree.node(before).computed().paint.opacity, 0.5) && near(tree.node(before).computed().text.size, 20.0), "the final query restores the original animation timeline")
  run Testing.expect(eventCount(&tree, EventKind.AnimationStart) == 0 && eventCount(&tree, EventKind.AnimationCancel) == 0, "transient pseudo disappearance emits no animation lifecycle events")
  let mut children = List<u32>.make()
  run tree.childSlots(before, &mut children)
  run Testing.expect(children.length() == 1 && near(tree.node(children.get(0)).computed().text.size, 20.0), "generated text inherits its parent's final animated font size")
  let smaller = run written.declarations(b"width:400px")
  run batch.style(1, smaller.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(!beforeExists(&tree, origin) && !tree.node(before).live && eventCount(&tree, EventKind.AnimationCancel) == 1, "a final false query destroys the pseudo and cancels exactly once")
}

test effect fn containerSettlingPreservesTransientPseudoIdentityAndAnimatedInheritance()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run transientPseudo() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn depthAndEntryPoints() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  let top = run written.declarations(b"container-type:size;width:512px;height:100px")
  let nested = run written.declarations(b"container-type:size;width:50cqw;height:100px")
  let mut id: u32 = 1
  while id <= 7 {
    run batch.create(id, NodeKind.Box)
    if id == 1 { run batch.root(id) run batch.style(id, top.asSlice()) }
    else { run batch.append(id - 1, id) run batch.style(id, nested.asSlice()) }
    id = id + 1
  }
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let last = tree.slotOf(7)
  run Testing.expect(tree.node(last).computed().layout.width.value == 8.0 && (run container_watch.changed(&tree)).length() == 0, "deeply nested units settle within the same frame")
  run tree.frame(frame)
  run Testing.expect(tree.stats.layoutSkipped, "an idle container tree needs no layout pass")
  let wider = run written.declarations(b"width:1024px")
  run batch.style(1, wider.asSlice())
  run tree.apply(run batch.take())
  run tree.layoutNow()
  run Testing.expect(tree.node(last).computed().layout.width.value == 16.0 && (run container_watch.changed(&tree)).length() == 0, "immediate geometry reads settle all nested container levels")
  run batch.style(1, top.asSlice())
  run tree.apply(run batch.take())
  let pages = [LayoutRect { x: 0.0, y: 0.0, width: 1600.0, height: 2000.0 }]
  run tree.frameFragmented(frame, pagesOf(&pages))
  run Testing.expect(tree.node(last).computed().layout.width.value == 8.0 && (run container_watch.changed(&tree)).length() == 0, "fragmented layout also settles against its own content boxes")
}

test effect fn containerSettlingHandlesDepthIdleImmediateAndFragmentedLayout()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run depthAndEntryPoints() |> Effect.provideMut<Allocator>(&mut allocator)
}


fn pagesOf<'a>(pages: &'a [LayoutRect]) -> Fragmentainers<'a> {
  let mut frames: Fragmentainers<'a> = Fragmentainers.empty()
  frames.rects = Option<&'a [LayoutRect]>.some(pages)
  return move frames
}


effect fn nameOverrides() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  let outer = run written.declarations(b"container:card / size;width:400px;height:200px")
  let inner = run written.declarations(b"container:base / size;width:200px;height:100px")
  let hover = run written.declarations(b"container-name:hover")
  run batch.style(1, outer.asSlice())
  run batch.style(2, inner.asSlice())
  run batch.styleFor(2, StyleState.Hover, hover.asSlice())
  run tree.apply(run batch.take())
  let slot = tree.slotOf(2)
  let node = tree.nodeMut(slot)
  node.hovered = true
  let frame = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let subject = u32.toUsize(tree.slotOf(3))
  run Testing.expect(width(SelectorTree { tree: &tree }.container(subject, b"hover", 1, PseudoTarget.None)) == 200.0, "the active look supplies the ordinary container name")
  let inspector = run written.declarations(b"container-name:panel")
  drop run tree.setOverride(2, StyleState.Base, move inspector, false)
  run tree.frame(frame)
  run Testing.expect(width(SelectorTree { tree: &tree }.container(subject, b"panel", 1, PseudoTarget.None)) == 200.0
    && SelectorTree { tree: &tree }.container(subject, b"hover", 1, PseudoTarget.None).isNone(), "inspector names override later active looks")
  let inherited = run written.declarations(b"container-name:inherit")
  drop run tree.setOverride(2, StyleState.Base, move inherited, false)
  run tree.frame(frame)
  run Testing.expect(width(SelectorTree { tree: &tree }.container(subject, b"card", 1, PseudoTarget.None)) == 200.0, "inspector inheritance exposes the nearer container under its inherited name")
  drop tree.clearOverride(2, StyleState.Base)
  let replacement = run written.declarations(b"opacity:.5")
  drop run tree.setOverride(2, StyleState.Hover, move replacement, true)
  run tree.frame(frame)
  run Testing.expect(width(SelectorTree { tree: &tree }.container(subject, b"base", 1, PseudoTarget.None)) == 200.0
    && SelectorTree { tree: &tree }.container(subject, b"hover", 1, PseudoTarget.None).isNone(), "replacing a look removes its container-name declaration")
  drop tree.clearOverride(2, StyleState.Hover)
  run tree.frame(frame)
  run Testing.expect(width(SelectorTree { tree: &tree }.container(subject, b"hover", 1, PseudoTarget.None)) == 200.0, "clearing the override restores the active look")
}

test effect fn containerNamesHonorInspectorPrecedenceAndLookReplacement() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nameOverrides() |> Effect.provideMut<Allocator>(&mut allocator)
}
