    maxSendHeaderBlock: o.maxSendHeaderBlock, peerMaxConcurrent: o.peerMaxConcurrent, peerMaxSet: o.peerMaxSet, maxSettings: o.maxSettings, noWs: o.noWs,
    resetBurst: o.resetBurst, resetRate: o.resetRate, builtin: o.builtin } copied }
  let mut remote = initialSettings()
