//! Child processes on Darwin with posix_spawn, as libuv 1.51's uv__spawn_and_init_child_posix_spawn
//! (src/unix/process.c): macOS's fork is slow in a process with much JIT-mapped memory, and its
//! posix_spawn takes the setup a forked child does in libuv's uv__process_child_init as attributes
//! and file actions.
//!
//! - POSIX_SPAWN_CLOEXEC_DEFAULT: the child gets only the descriptors the file actions name, that
//!   is its stdio slots; an ignored stdin, stdout or stderr is /dev/null.
//! - Every signal back to its default disposition, and an empty signal mask.
//! - `cwd` with posix_spawn_file_actions_addchdir_np, found with dlsym; UV_PROCESS_DETACHED with
//!   POSIX_SPAWN_SETSID where the kernel honors it (Darwin 19, macOS 10.15, and later).
//! - A name without a slash is searched in the PATH of the child's environment (libuv's emulation
//!   of execvpe, from musl), since Apple's posix_spawnp is unreliable.
//!
//! `spawnPosix` returns UV_ENOSYS when this path cannot do what was asked (a user or group change,
//! or a needed function missing): the caller then forks, as libuv does.
import silk.mem.pointer { Pointer }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.core.ownership { Copy }
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import ext.uv_shapes { Options }

static if Intrinsic.targetOperatingSystem() == "darwin" {
  // posix_spawnattr_t and posix_spawn_file_actions_t are one pointer each (<spawn.h>, <sys/spawn.h>
  // of the macOS 15.5 SDK); sigset_t is a 32-bit word (<sys/_types/_sigset.h>).
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn posix_spawn_file_actions_init(value: *mut u8) -> i32
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn posix_spawn_file_actions_destroy(value: *mut u8) -> i32
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn posix_spawn_file_actions_adddup2(value: *mut u8, from: i32, to: i32) -> i32
  @foreign(noCapture: ("value", "path"))
  unsafe extern "C" fn posix_spawn_file_actions_addopen(value: *mut u8, fd: i32, path: *const u8, flags: i32, mode: u16) -> i32
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn posix_spawn_file_actions_addclose(value: *mut u8, fd: i32) -> i32
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn posix_spawn_file_actions_addinherit_np(value: *mut u8, fd: i32) -> i32
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn posix_spawnattr_init(value: *mut u8) -> i32
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn posix_spawnattr_destroy(value: *mut u8) -> i32
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn posix_spawnattr_setflags(value: *mut u8, flags: i16) -> i32
  @foreign(noCapture: ("value", "set"))
  unsafe extern "C" fn posix_spawnattr_setsigmask(value: *mut u8, set: *const u32) -> i32
  @foreign(noCapture: ("value", "set"))
  unsafe extern "C" fn posix_spawnattr_setsigdefault(value: *mut u8, set: *const u32) -> i32
  @foreign(noCapture: ("pid", "path", "actions", "attributes", "arguments", "environment"))
  unsafe extern "C" fn posix_spawn(pid: *mut i32, path: *const u8, actions: *const u8, attributes: *const u8, arguments: *const ?*const u8, environment: *const ?*const u8) -> i32
  unsafe extern "C" fn dlsym(handle: *mut u8, name: *const u8) -> ?*mut u8
  @foreign(noCapture: .("name", "value", "length", "replacement"))
  unsafe extern "C" fn sysctl(name: *const i32, nameLength: u32, value: *mut u8, length: *mut usize, replacement: ?*mut u8, replacementLength: usize) -> i32
  unsafe extern "C" fn fcntl(fd: i32, command: i32, ...) -> i32
  unsafe extern "C" fn __error() -> *mut i32
  unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
  unsafe extern "C" fn free(pointer: ?*mut u8) -> ()

  // <sys/spawn.h>
  const SPAWN_SETSIGDEF: i16 = 4
  const SPAWN_SETSIGMASK: i16 = 8
  const SPAWN_SETSID: i16 = 1024
  const SPAWN_CLOEXEC_DEFAULT: i16 = 16384
  // <sys/errno.h>
  const EINTR: i32 = 4
  const ENOENT: i32 = 2
  const EACCES: i32 = 13
  const ENOTDIR: i32 = 20
  const ENAMETOOLONG: i32 = 63
  const ENOSYS: i32 = 78
  pub const UV_ENOSYS: i32 = -78
  const UV_ENOMEM: i32 = -12
  // <sys/fcntl.h>
  const O_RDONLY: i32 = 0
  const O_RDWR: i32 = 2
  const F_GETFL: i32 = 3
  const F_SETFL: i32 = 4
  const O_NONBLOCK: i32 = 4
  // <sys/syslimits.h>: NAME_MAX, PATH_MAX.
  const NAME_MAX: usize = 255
  const PATH_MAX: usize = 1024
  // <sys/sysctl.h>: CTL_KERN, KERN_OSRELEASE.
  const CTL_KERN: i32 = 1
  const KERN_OSRELEASE: i32 = 2
  // <dlfcn.h>: RTLD_DEFAULT is ((void *) -2).
  const RTLD_DEFAULT: usize = 18446744073709551614
  // uv.h: UV_PROCESS_SETUID, UV_PROCESS_SETGID, UV_PROCESS_DETACHED.
  const UV_PROCESS_SETUID: u32 = 1
  const UV_PROCESS_SETGID: u32 = 2
  const UV_PROCESS_DETACHED: u32 = 8

  type AddChdir = extern "C" fn(*mut u8, *const u8) -> i32

  unsafe fn errno() -> i32 { return unsafe Pointer.read<i32>(unsafe __error()) }
  fn text(value: &[u8]) -> *const u8 { return Pointer.fromRef<u8>(&value[0]) }
  unsafe fn addressPointer(address: usize) -> ?*mut u8 {
    let word = address
    return unsafe Pointer.read<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*const usize, *const ?*mut u8>(Pointer.fromRef<usize>(&word)))
  }
  unsafe fn function<F: Copy>(address: usize) -> F { let word = address return unsafe Pointer.read<F>(unsafe Intrinsic.pointerReinterpret<*const usize, *const F>(Pointer.fromRef<usize>(&word))) }
  unsafe fn byteAt(text: *const u8, index: usize) -> u8 { return unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(text), index)) }
  unsafe fn slot(use: [*]mut i32, index: i32) -> *mut i32 { return unsafe Pointer.atMut<i32>(use, i32.toUsize(index)) }

  // ---- Feature detection, once per process (uv__spawn_init_posix_spawn) ---------------------------
  // The first word holds 1 once detection ran, plus 2 when POSIX_SPAWN_SETSID works; the second the
  // address of posix_spawn_file_actions_addchdir_np, or 0. Racing detections store the same values.
  fn featuresWord() -> *mut u64 { return Intrinsic.processWord() }
  fn chdirWord() -> *mut u64 { return Intrinsic.processWord() }
  // libuv parses kern.osrelease with "%u.%u.%u" and needs all three numbers; Darwin 19 is macOS
  // 10.15 (Catalina), the first to honor POSIX_SPAWN_SETSID.
  unsafe fn canUseSetsid() -> bool {
    let name: [i32; 2] = [CTL_KERN, KERN_OSRELEASE]
    let mut buffer: [u8; 256] = [0; 256]
    let mut length: usize = 256
    if unsafe sysctl(Pointer.fromRef<i32>(&name[0]), 2, Pointer.fromMutRef<u8>(&mut buffer[0]), Pointer.fromMutRef<usize>(&mut length), Pointer.null<u8>(), 0) != 0 { return false }
    let mut numbers: [u64; 3] = [0; 3]
    let mut at: usize = 0
    let mut field: usize = 0
    while field < 3 {
      if field > 0 { if at >= 255 || buffer[at] != 46 { return false } at = at + 1 }
      // %u skips white space and takes an optional sign.
      while at < 255 && (buffer[at] == 32 || (buffer[at] >= 9 && buffer[at] <= 13)) { at = at + 1 }
      if at < 255 && (buffer[at] == 43 || buffer[at] == 45) { at = at + 1 }
      if at >= 255 || buffer[at] < 48 || buffer[at] > 57 { return false }
      while at < 255 && buffer[at] >= 48 && buffer[at] <= 57 { numbers[field] = numbers[field] * 10 + u8.toU64(buffer[at] - 48) at = at + 1 }
      field = field + 1
    }
    return numbers[0] >= 19
  }
  unsafe fn features() -> u64 {
    let known = unsafe Atomic.load<u64>(featuresWord(), MemoryOrder.Acquire)
    if known != 0 { return known }
    let found = unsafe dlsym(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(unsafe addressPointer(RTLD_DEFAULT)), text(b"posix_spawn_file_actions_addchdir_np\0"))
    unsafe Atomic.store<u64>(chdirWord(), usize.toU64(Pointer.address<u8>(found)), MemoryOrder.Release)
    let detected: u64 = if unsafe canUseSetsid() { 3 } else { 1 }
    unsafe Atomic.store<u64>(featuresWord(), detected, MemoryOrder.Release)
    return detected
  }

  // ---- Attributes and file actions --------------------------------------------------------------
  // uv__spawn_set_posix_spawn_attrs: the attributes, or a positive errno (ENOSYS to fork instead).
  // On failure the attributes are destroyed.
  unsafe fn setAttributes(attributes: *mut u8, options: &Options, features: u64) -> i32 {
    let initialized = unsafe posix_spawnattr_init(attributes)
    if initialized != 0 { return initialized }
    let mut status: i32 = 0
    // posix_spawn's user and group attributes require uid 0 exactly and are undocumented: fork.
    if (options.flags & (UV_PROCESS_SETUID | UV_PROCESS_SETGID)) != 0 { status = ENOSYS }
    let mut flags: i16 = SPAWN_CLOEXEC_DEFAULT | SPAWN_SETSIGDEF | SPAWN_SETSIGMASK
    if status == 0 && (options.flags & UV_PROCESS_DETACHED) != 0 {
      // An older kernel would ignore the flag silently: fork instead.
      if (features & 2) == 0 { status = ENOSYS } else { flags = flags | SPAWN_SETSID }
    }
    if status == 0 { status = unsafe posix_spawnattr_setflags(attributes, flags) }
    // Every signal to its default behavior (sigfillset), and an empty mask (sigemptyset).
    let all: [u32; 1] = [4294967295]
    if status == 0 { status = unsafe posix_spawnattr_setsigdefault(attributes, Pointer.fromRef<u32>(&all[0])) }
    let none: [u32; 1] = [0]
    if status == 0 { status = unsafe posix_spawnattr_setsigmask(attributes, Pointer.fromRef<u32>(&none[0])) }
    if status != 0 { let _destroyed = unsafe posix_spawnattr_destroy(attributes) }
    return status
  }
  // Clears O_NONBLOCK, which the child shares with the parent (uv__nonblock_fcntl(fd, 0)).
  unsafe fn blocking(fd: i32) -> () {
    let mut flags: i32 = -1
    while true { flags = unsafe fcntl(fd, F_GETFL) if flags != -1 || unsafe errno() != EINTR { break } }
    if flags == -1 || (flags & O_NONBLOCK) == 0 { return }
    while true { if unsafe fcntl(fd, F_SETFL, flags & (O_NONBLOCK ^ -1)) != -1 || unsafe errno() != EINTR { break } }
  }
  // uv__spawn_set_posix_spawn_file_actions: the child's working directory and stdio slots, or a
  // positive errno; `use` holds the parent descriptor of each slot (-1 for none) and is changed.
  // On failure the actions are destroyed.
  unsafe fn setFileActions(actions: *mut u8, options: &Options, count: i32, use: [*]mut i32) -> i32 {
    let initialized = unsafe posix_spawn_file_actions_init(actions)
    if initialized != 0 { return initialized }
    let mut status: i32 = 0
    if !Pointer.isNull<u8>(options.cwd) {
      let address = u64.toUsize(unsafe Atomic.load<u64>(chdirWord(), MemoryOrder.Acquire))
      if address == 0 { status = ENOSYS }
      else {
        let addChdir = unsafe function<AddChdir>(address)
        status = unsafe addChdir(actions, unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(options.cwd))
      }
    }
    // No ENOSYS after this point: `use` changes.
    // A low descriptor that a later slot would overwrite moves first, to the lowest number at or
    // above `count` that no slot uses (libuv's scan, which after a match restarts at slot 1).
    let mut fd: i32 = 0
    while status == 0 && fd < count {
      let wanted = unsafe Pointer.read<i32>(unsafe slot(use, fd))
      if wanted >= 0 && wanted < fd {
        let mut target = count
        let mut other: i32 = 0
        while other < count {
          if unsafe Pointer.read<i32>(unsafe slot(use, other)) == target { target = target + 1 other = 0 }
          other = other + 1
        }
        status = unsafe posix_spawn_file_actions_adddup2(actions, wanted, target)
        if status == 0 { unsafe Pointer.write<i32>(unsafe slot(use, fd), target) }
      }
      fd = fd + 1
    }
    // Then each descriptor to its slot; an empty stdin, stdout or stderr is /dev/null.
    fd = 0
    while status == 0 && fd < count {
      let wanted = unsafe Pointer.read<i32>(unsafe slot(use, fd))
      if wanted < 0 {
        if fd < 3 { status = unsafe posix_spawn_file_actions_addopen(actions, fd, text(b"/dev/null\0"), if fd == 0 { O_RDONLY } else { O_RDWR }, 0) }
        fd = fd + 1
        continue
      }
      if fd == wanted { status = unsafe posix_spawn_file_actions_addinherit_np(actions, fd) }
      else { status = unsafe posix_spawn_file_actions_adddup2(actions, wanted, fd) }
      fd = fd + 1
    }
    // Finally close the copies above the slots, each once.
    fd = 0
    while status == 0 && fd < count {
      let wanted = unsafe Pointer.read<i32>(unsafe slot(use, fd))
      if wanted >= count {
        let mut before: i32 = 0
        while before < fd { if unsafe Pointer.read<i32>(unsafe slot(use, before)) == wanted { break } before = before + 1 }
        if before == fd { status = unsafe posix_spawn_file_actions_addclose(actions, wanted) }
      }
      fd = fd + 1
    }
    if status != 0 { let _destroyed = unsafe posix_spawn_file_actions_destroy(actions) }
    return status
  }

  // ---- The program ------------------------------------------------------------------------------
  unsafe extern "C" fn _NSGetEnviron() -> *mut *const ?*const u8
  // libuv's `options->env ? options->env : environ`: a null environment is the parent's.
  unsafe fn childEnvironment(options: &Options) -> *const ?*const u8 {
    if Pointer.address<?*const u8>(options.env) != 0 { return options.env }
    return unsafe Pointer.read<*const ?*const u8>(unsafe _NSGetEnviron())
  }
  unsafe fn spawnRetrying(pid: *mut i32, path: *const u8, actions: *const u8, attributes: *const u8, options: &Options) -> i32 {
    while true {
      let status = unsafe posix_spawn(pid, path, actions, attributes, options.args, unsafe childEnvironment(options))
      if status != EINTR { return status }
    }
    return EINTR
  }
  // uv__spawn_resolve_and_spawn: a positive errno, or 0.
  unsafe fn resolveAndSpawn(options: &Options, actions: *const u8, attributes: *const u8, pid: *mut i32) -> i32 {
    let file = options.file
    let mut index: usize = 0
    // A name with a slash is used as it is.
    while unsafe byteAt(file, index) != 0 { if unsafe byteAt(file, index) == 47 { return unsafe spawnRetrying(pid, file, actions, attributes, options) } index = index + 1 }
    // PATH in the child's environment (uv__spawn_find_path_in_env), or _PATH_DEFPATH (<paths.h>).
    let mut path: *const u8 = text(b"/usr/bin:/bin\0")
    let environment = unsafe Pointer.assumeMany<?*const u8>(unsafe childEnvironment(options))
    let mut entry: usize = 0
    while true {
      let variable = unsafe Pointer.read<?*const u8>(unsafe Pointer.at<?*const u8>(environment, entry))
      if Pointer.isNull<u8>(variable) { break }
      let v = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(variable)
      if unsafe byteAt(v, 0) == 80 && unsafe byteAt(v, 1) == 65 && unsafe byteAt(v, 2) == 84 && unsafe byteAt(v, 3) == 72 && unsafe byteAt(v, 4) == 61 {
        path = unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(v), 5)
        break
      }
      entry = entry + 1
    }
    // The search, as musl's execvp.
    let mut k: usize = 0
    while k <= NAME_MAX && unsafe byteAt(file, k) != 0 { k = k + 1 }
    if k > NAME_MAX { return ENAMETOOLONG }
    let mut l: usize = 0
    while l < PATH_MAX - 1 && unsafe byteAt(path, l) != 0 { l = l + 1 }
    l = l + 1
    let mut candidate: [u8; 1281] = [0; 1281]
    let mut status: i32 = -1
    let mut deniedSeen = false
    let mut p: usize = 0
    while true {
      let mut z = p
      while unsafe byteAt(path, z) != 0 && unsafe byteAt(path, z) != 58 { z = z + 1 }
      let last = unsafe byteAt(path, z) == 0
      if z - p >= l {
        if last { break }
        p = z + 1
        continue
      }
      let mut at: usize = 0
      while at < z - p { candidate[at] = unsafe byteAt(path, p + at) at = at + 1 }
      candidate[z - p] = 47
      // An empty entry names the file alone, relative to the working directory.
      let offset: usize = if z > p { z - p + 1 } else { 0 }
      at = 0
      while at <= k { candidate[offset + at] = unsafe byteAt(file, at) at = at + 1 }
      status = unsafe spawnRetrying(pid, Pointer.fromRef<u8>(&candidate[0]), actions, attributes, options)
      if status == EACCES { deniedSeen = true }
      else if status != ENOENT && status != ENOTDIR { return status }
      if last { break }
      p = z + 1
    }
    if deniedSeen { return EACCES }
    return status
  }

  /// Starts the child as libuv's posix_spawn path: `use` holds the parent descriptor of each of the
  /// `count` stdio slots (-1 for none) and may be changed. 0 with the child's id in `pid`, a negative
  /// errno, or UV_ENOSYS when the caller must fork instead.
  pub unsafe fn spawnPosix(options: &Options, count: i32, use: [*]mut i32, pid: *mut i32) -> i32 {
    let known = unsafe features()
    let mut attributes: [u64; 1] = [0]
    let attributesAt = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef<u64>(&mut attributes[0]))
    let set = unsafe setAttributes(attributesAt, options, known)
    if set != 0 { return -set }
    // The descriptors the child gets, before the file actions renumber them.
    let copy = unsafe calloc(i32.toUsize(count), 4)
    if Pointer.isNull<u8>(copy) { let _destroyed = unsafe posix_spawnattr_destroy(attributesAt) return UV_ENOMEM }
    let given = unsafe Pointer.assumeManyMut<i32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut i32>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(copy)))
    let mut fd: i32 = 0
    while fd < count { unsafe Pointer.write<i32>(unsafe slot(given, fd), unsafe Pointer.read<i32>(unsafe slot(use, fd))) fd = fd + 1 }
    let mut actions: [u64; 1] = [0]
    let actionsAt = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef<u64>(&mut actions[0]))
    let acted = unsafe setFileActions(actionsAt, options, count, use)
    if acted != 0 { unsafe free(copy) let _destroyed = unsafe posix_spawnattr_destroy(attributesAt) return -acted }
    // The child shares each stdio descriptor's file status with the parent: blocking, as libuv
    // makes it. (libuv clears the flag on the descriptor number the actions moved a low slot to,
    // which in the parent is some other descriptor or none; this clears it on the one given.)
    fd = 0
    while fd < count {
      let wanted = unsafe Pointer.read<i32>(unsafe slot(given, fd))
      if wanted >= 0 { unsafe blocking(wanted) }
      fd = fd + 1
    }
    unsafe free(copy)
    let status = unsafe resolveAndSpawn(options, unsafe Intrinsic.pointerRequalify<*mut u8, *const u8>(actionsAt), unsafe Intrinsic.pointerRequalify<*mut u8, *const u8>(attributesAt), pid)
    let _actionsDestroyed = unsafe posix_spawn_file_actions_destroy(actionsAt)
    let _attributesDestroyed = unsafe posix_spawnattr_destroy(attributesAt)
    return -status
  }
}
