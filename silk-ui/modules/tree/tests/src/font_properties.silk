fn frame() -> FrameInput { return FrameInput { width: 400.0, height: 100.0, scale: 1.0, time: 0.0 } }
fn close(a: f32, b: f32) -> bool { return f32.abs(a - b) < 0.05 }

/// `text` in an inline block styled `style`, under sheet `sheet`.
effect fn build<'f>(fonts: &'f FontCollection, sheet: &[u8], style: &[u8], text: string) -> UiTree<'f>
  ! TreeError | CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut tree = run UiTree.make(fonts)
  drop run tree.addFont(run Bytes.copy(COLR))
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.create(3, NodeKind.Text)
  run batch.append(2, 3)
  run batch.setText(3, text)
  let mut css = run Bytes.copy(b"display:inline-block;font-size:16px;color:black;")
  run Bytes.append(&mut css, style)
  let declarations = run written.declarations(Bytes.asSlice(&css))
  run batch.style(2, declarations.asSlice())
  run batch.root(1)
  if sheet.length != 0 {
    let compiled = run compile.compile(sheet, &Options.make())
    let bytes = run compiled.encode()
    run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  }
  run tree.apply(run batch.take())
  run tree.frame(frame())
  return move tree
}

effect fn widthOf(fonts: &FontCollection, sheet: &[u8], style: &[u8], text: string) -> f32
  ! TreeError | CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let tree = run build(fonts, sheet, style, text)
  return match run info(&tree, 2) { Option.Some { value } => value.bounds.width() _ => 0.0 }
}

effect fn alternates() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  // Geist's ss05 draws a wide serifed I (270 to 434 units).
  let rules = b"@font-feature-values Geist{@styleset{wide:5;none:21}@stylistic{one:1}}"
  let plain = run widthOf(&fonts, rules, b"font-family:Geist", "IIIIIIIIII")
  let settings = run widthOf(&fonts, rules, b"font-family:Geist;font-feature-settings:'ss05'", "IIIIIIIIII")
  let named = run widthOf(&fonts, rules, b"font-family:Geist;font-variant-alternates:styleset(wide)", "IIIIIIIIII")
  run Testing.expect(settings > plain + 20.0, "ss05 widens Geist's I")
  run Testing.expect(close(named, settings), "styleset(wide) turns on ss05 through @font-feature-values")
  run Testing.expect(close(run widthOf(&fonts, rules, b"font-family:Geist;font-variant-alternates:styleset(missing)", "IIIIIIIIII"), plain), "an undefined name turns nothing on")
  run Testing.expect(close(run widthOf(&fonts, rules, b"font-family:Geist;font-variant-alternates:styleset(none)", "IIIIIIIIII"), plain), "a style set above 20 is dropped")
  run Testing.expect(close(run widthOf(&fonts, b"", b"font-family:Geist;font-variant-alternates:styleset(wide)", "IIIIIIIIII"), plain), "names need a rule")
  run Testing.expect(close(run widthOf(&fonts, b"@font-feature-values Inter{@styleset{wide:5}}", b"font-family:Geist;font-variant-alternates:styleset(wide)", "IIIIIIIIII"), plain), "rules apply to their own families")
  run Testing.expect(close(run widthOf(&fonts, rules, b"font-family:Geist;font-variant-alternates:styleset(wide);font-feature-settings:'ss05' 0", "IIIIIIIIII"), plain), "font-feature-settings wins")
  run Testing.expect(close(run widthOf(&fonts, rules, b"font-family:Geist;font-variant-alternates:styleset(wide) stylistic(one)", "IIIIIIIIII"), settings), "several alternates combine")
}

test effect fn fontVariantAlternatesResolveFeatureValues() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run alternates() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sizeAdjust() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  // Geist's x-height is 0.53em and its cap height 0.71em.
  let plain = run widthOf(&fonts, b"", b"font-family:Geist", "xxxxxxxxxx")
  run Testing.expect(close(run widthOf(&fonts, b"", b"font-family:Geist;font-size-adjust:0.53", "xxxxxxxxxx"), plain), "the font's own aspect keeps its size")
  run Testing.expect(close(run widthOf(&fonts, b"", b"font-family:Geist;font-size-adjust:from-font", "xxxxxxxxxx"), plain), "from-font keeps its size")
  run Testing.expect(close(run widthOf(&fonts, b"", b"font-family:Geist;font-size-adjust:cap-height 0.71", "xxxxxxxxxx"), plain), "cap-height uses the cap height")
  let doubled = run widthOf(&fonts, b"", b"font-family:Geist;font-size-adjust:1.06", "xxxxxxxxxx")
  run Testing.expect(f32.abs(doubled - plain * 2.0) < 1.0, "twice the aspect draws twice as large")
  run Testing.expect(close(run widthOf(&fonts, b"", b"font-family:Geist;font-size-adjust:1.06;font-size-adjust:none", "xxxxxxxxxx"), plain), "none turns it off")
}

test effect fn fontSizeAdjustScalesToTheAspect() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sizeAdjust() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// The center of the first glyph square of "A" in `style`, under `sheet`.
effect fn swatch(fonts: &FontCollection, sheet: &[u8], style: &[u8]) -> [u8; 3]
  ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError ? &mut Allocator {
  let mut css = run Bytes.copy(b"font-family:'Raster ColrV1';font-size:40px;line-height:1;")
  run Bytes.append(&mut css, style)
  let mut tree = run build(fonts, sheet, Bytes.asSlice(&css), "A")
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let painted = run snapshot.render(&tree)
  let pixel = painted.pixel(20, 20)
  return [pixel.r, pixel.g, pixel.b]
}

fn is(color: [u8; 3], r: u8, g: u8, b: u8) -> bool {
  return u8Near(color[0], r) && u8Near(color[1], g) && u8Near(color[2], b)
}

fn u8Near(a: u8, b: u8) -> bool { return if a > b { a - b <= 8 } else { b - a <= 8 } }

effect fn palettes() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let rules = b"@font-palette-values --sea{font-family:'Raster ColrV1';base-palette:1;override-colors:0 rgb(0,128,0)}@font-palette-values --other{font-family:Geist;base-palette:1}@font-palette-values --night{font-family:'Raster ColrV1';base-palette:dark}"
  run Testing.expect(is(run swatch(&fonts, rules, b""), 255, 0, 0), "the default palette draws red")
  run Testing.expect(is(run swatch(&fonts, rules, b"font-palette:dark"), 255, 255, 0), "dark picks the palette marked dark")
  run Testing.expect(is(run swatch(&fonts, rules, b"font-palette:light"), 255, 0, 0), "light picks the palette marked light")
  run Testing.expect(is(run swatch(&fonts, rules, b"font-palette:--sea"), 0, 128, 0), "a named palette overrides entry 0")
  run Testing.expect(is(run swatch(&fonts, rules, b"font-palette:--night"), 255, 255, 0), "base-palette dark")
  run Testing.expect(is(run swatch(&fonts, rules, b"font-palette:--other"), 255, 0, 0), "a palette for another family changes nothing")
  run Testing.expect(is(run swatch(&fonts, rules, b"font-palette:--missing"), 255, 0, 0), "an unknown palette is normal")
}

test effect fn fontPaletteValuesPickColorGlyphPalettes() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run palettes() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// How many pixels of "Wow" in Geist are neither white nor black.
effect fn grays(fonts: &FontCollection, style: &[u8]) -> u32
  ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError ? &mut Allocator {
  let mut css = run Bytes.copy(b"font-family:Geist;font-size:24px;background:white;")
  run Bytes.append(&mut css, style)
  let mut tree = run build(fonts, b"", Bytes.asSlice(&css), "Wow")
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let painted = run snapshot.render(&tree)
  let mut count: u32 = 0
  let mut y: u32 = 0
  while y < 30 {
    let mut x: u32 = 0
    while x < 60 {
      let pixel = painted.pixel(x, y)
      if pixel.r > 8 && pixel.r < 247 { count = count + 1 }
      x = x + 1
    }
    y = y + 1
  }
  return count
}

effect fn smoothing() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let smooth = run grays(&fonts, b"")
  run Testing.expect(smooth > 20, "antialiased text has gray edges")
  let antialiased = run grays(&fonts, b"-webkit-font-smoothing:antialiased")
  run Testing.expect(antialiased == smooth, "antialiased is the default")
  let none = run grays(&fonts, b"-webkit-font-smoothing:none")
  run Testing.expect(none == 0, "none draws aliased glyphs")
  let never = run grays(&fonts, b"font-smooth:never")
  run Testing.expect(never == 0, "font-smooth never draws aliased glyphs")
}

test effect fn fontSmoothNoneDrawsAliasedGlyphs() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run smoothing() |> Effect.provideMut<Allocator>(&mut allocator)
}


/// A tree with "iiiiiiiiii" in `Brand` (falling back to Noto Sans) from a sheet face with
/// `font-display: <display>`, framed at time 0. Returns the face's load id through `tree`.
effect fn displayTree<'f>(fonts: &'f FontCollection, display: &[u8]) -> UiTree<'f>
  ! TreeError | CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut sheet = run Bytes.copy(b"@font-face{font-family:Brand;src:url(brand.ttf);font-display:")
  run Bytes.append(&mut sheet, display)
  run Bytes.append(&mut sheet, b"}")
  return run build(fonts, Bytes.asSlice(&sheet), b"font-family:Brand,'Noto Sans';background:white", "iiiiiiiiii")
}

effect fn frameAt(tree: &mut UiTree<'_>, time: f64) ! TreeError | OutOfMemoryError ? &mut Allocator {
  run tree.frame(FrameInput { width: 400.0, height: 100.0, scale: 1.0, time: time })
}

/// Whether any text pixel is drawn.
effect fn inked(tree: &mut UiTree<'_>) -> bool ! TreeError | GeometryError | OutOfMemoryError ? &mut Allocator {
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let painted = run snapshot.render(&tree)
  let mut y: u32 = 0
  while y < 24 {
    let mut x: u32 = 0
    while x < 120 {
      let pixel = painted.pixel(x, y)
      if pixel.a > 128 && pixel.r < 128 { return true }
      x = x + 1
    }
    y = y + 1
  }
  return false
}

effect fn boxWidth(tree: &UiTree<'_>) -> f32 ! OutOfMemoryError ? &mut Allocator {
  return match run info(tree, 2) { Option.Some { value } => value.bounds.width() _ => 0.0 }
}

/// Loads the one face `tree` asked for, at `time`.
effect fn loadAt(tree: &mut UiTree<'_>, time: f64) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
  let loads = run tree.takeLoads()
  if loads.length() != 1 { return false }
  let id = match &loads.asSlice()[0] {
    Mutation.LoadFontFace { face, .. } => face
    _ => { return false }
  }
  drop run tree.loadFontFace(id, run Bytes.copy(assets.geistMonoFont()), 0)
  run frameAt(&mut tree, time)
  return true
}

effect fn display() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut swap = run displayTree(&fonts, b"swap")
  run Testing.expect(run inked(&mut swap), "swap shows the fallback at once")
  let fallbackWidth = run boxWidth(&swap)

  let mut block = run displayTree(&fonts, b"block")
  run Testing.expect(f64Near(block.fontWake(), 3.0), "the tree wakes when the block period ends")
  run Testing.expect(!run inked(&mut block), "block hides text while the face loads")
  run frameAt(&mut block, 2.9)
  run Testing.expect(!run inked(&mut block), "for 3 seconds")
  run frameAt(&mut block, 3.0)
  run Testing.expect(run inked(&mut block), "then the fallback shows")
  let loaded1 = run loadAt(&mut block, 10.0)
  run Testing.expect(loaded1, "the face loads")
  let width1 = run boxWidth(&block)
  run Testing.expect(width1 > fallbackWidth * 1.5, "and the face swaps in whenever it loads")

  let mut auto = run displayTree(&fonts, b"auto")
  run Testing.expect(!run inked(&mut auto), "auto blocks as block does")
  let loaded2 = run loadAt(&mut auto, 0.5)
  run Testing.expect(loaded2, "the face loads")
  let ink2 = run inked(&mut auto)
  run Testing.expect(ink2, "a face loading in the block period shows at once")

  let mut fallback = run displayTree(&fonts, b"fallback")
  run Testing.expect(!run inked(&mut fallback), "fallback blocks briefly")
  run frameAt(&mut fallback, 0.1)
  run Testing.expect(run inked(&mut fallback), "for 100 ms")
  let loaded3 = run loadAt(&mut fallback, 2.0)
  run Testing.expect(loaded3, "the face loads")
  let width3 = run boxWidth(&fallback)
  run Testing.expect(width3 > fallbackWidth * 1.5, "and swaps within 3 seconds")
  let mut late = run displayTree(&fonts, b"fallback")
  run frameAt(&mut late, 3.1)
  run Testing.expect(late.fontWake() < 0.0, "nothing is left to wait for")
  let loaded4 = run loadAt(&mut late, 3.2)
  run Testing.expect(loaded4, "the face loads")
  let width4 = run boxWidth(&late)
  run Testing.expect(close(width4, fallbackWidth), "a face loading later keeps the fallback")
  run Testing.expect((run late.takeLoads()).length() == 0, "and is not asked for again")

  let mut optional = run displayTree(&fonts, b"optional")
  run Testing.expect(!run inked(&mut optional), "optional blocks briefly")
  let loaded5 = run loadAt(&mut optional, 0.05)
  run Testing.expect(loaded5, "the face loads")
  let width5 = run boxWidth(&optional)
  run Testing.expect(width5 > fallbackWidth * 1.5, "a face ready within 100 ms is used")
  let mut missed = run displayTree(&fonts, b"optional")
  run frameAt(&mut missed, 0.1)
  let loaded6 = run loadAt(&mut missed, 0.2)
  run Testing.expect(loaded6, "the face loads")
  let width6 = run boxWidth(&missed)
  run Testing.expect(close(width6, fallbackWidth), "later, the fallback stays")
}

fn f64Near(a: f64, b: f64) -> bool { return f64.abs(a - b) < 0.001 }

test effect fn fontDisplayBlocksSwapsAndGivesUp() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run display() |> Effect.provideMut<Allocator>(&mut allocator)
}
