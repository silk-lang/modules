      let coldSlow = self.on
      run self.fieldSlot(inst.a, inst.pc, slow)
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
      run self.heapTest(Reg.Rax, kept)
      run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, 8))
      run self.a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.R9, 0), 1)
      run self.a.jcc(Cond.LessOrEqual, slow)
      run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R9, 0), 1)
      self.a.bind(kept)
      run self.a.load(Width.W64, Reg.Rax, slotOf(inst.b))
      run self.a.load(Width.W64, Reg.R9, payloadOf(inst.b))
      run self.a.store(Width.W64, Mem.at(Reg.R11, 0), Reg.Rax)
      run self.a.store(Width.W64, Mem.at(Reg.R11, 8), Reg.R9)
      if moved {
