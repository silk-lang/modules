//! `ui-inspect-cli`: talks to a running Silk UI's inspector. The commands live in
//! ui-inspect-server's `cli` module, so a development build of an app writes the same program
//! from the Silk UI it is built with.
import ui_inspect_server.cli
import silk.system.host_input { HostInput }

pub effect fn main() -> i32
  ? &mut HostInput {
  return run cli.main()
}
