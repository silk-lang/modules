//! A cached Vite build with source files and locked npm dependencies in its own output directory.
import silk.build.step { Deferred, Step, StepHandle, StepError, StepFailure, Key, Make }
import silk.build.context as Context
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.json.value { Json, Value }
import silk.json.scanner { JsonError }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessOutcome }
import silk.system.executable as Executable
import silk.system.filesystem { FileSystem, Path }
import silk.system.host_input { HostInput }
import silk.text.string { String, InvalidUtf8 }

struct Source {
  name: String,
  path: Deferred<Path>
}

struct Bundle {
  sources: List<Source>,
  web: String,
  certificates: List<Deferred<Path>>,
  npm: Deferred<Path>,
  node: Deferred<Path>
}

impl Step for Bundle {
  effect fn key(self: &Self, key: &mut Key) -> ()
    ! StepFailure
    ? &mut Allocator {
    run key.text(self.web.view())
    run key.file(&self.npm)
    run key.file(&self.node)
    let certificates = self.certificates.asSlice()
    let mut certificate: usize = 0
    while certificate < certificates.length {
      run key.file(&certificates[certificate])
      certificate = certificate + 1
    }
    let sources = self.sources.asSlice()
    let mut at: usize = 0
    while at < sources.length {
      run key.text(sources[at].name.view())
      run key.file(&sources[at].path)
      at = at + 1
    }
    run key.environment("PATH")
    run key.environment("SystemRoot")
    run key.environment("COMSPEC")
    run key.environment("HTTP_PROXY")
    run key.environment("HTTPS_PROXY")
    run key.environment("ALL_PROXY")
    run key.environment("NO_PROXY")
    run key.environment("http_proxy")
    run key.environment("https_proxy")
    run key.environment("all_proxy")
    run key.environment("no_proxy")
    run key.environment("NPM_CONFIG_REGISTRY")
    run key.environment("npm_config_registry")
    run key.environment("NODE_EXTRA_CA_CERTS")
    run key.environment("SSL_CERT_FILE")
    run key.environment("NPM_CONFIG_CAFILE")
    run key.environment("npm_config_cafile")
  }

  effect fn make(self: &Self, make: &mut Make) -> ()
    ! StepFailure
    ? &mut Allocator {
    let sources = self.sources.asSlice()
    let mut at: usize = 0
    while at < sources.length {
      let bytes = run make.read(&sources[at].path)
      run make.write(sources[at].name.view(), bytes.asSlice())
      at = at + 1
    }
    run succeeded(
      run make.exec(
        &self.npm,
        &["ci", "--prefix", self.web.view(), "--cache", ".npm", "--no-audit", "--no-fund"],
      ),
    )
    let output = run Context.text(&run make.output("bundle"))
    run succeeded(
      run make.exec(
        &self.npm,
        &["exec", "--prefix", self.web.view(), "--", "vite", "build", self.web.view(), "--outDir", output.view()],
      ),
    )
    run make.requireOutput("bundle/app.js")
    run succeeded(
      run make.exec(
        &self.node,
        &[
          "-e",
          "const fs = require('node:fs'); for (const path of ['source', '.npm']) fs.rmSync(path, {recursive: true, force: true});",
        ],
      ),
    )
  }
}

effect fn succeeded(outcome: ProcessOutcome) -> ()
  ! StepFailure
  ? &mut Allocator {
  if ChildProcess.exitCode(&outcome).unwrapOr(-1) == 0 {
    return ()
  }
  let mut message = run String.copy("Vite bundle failed")
  if let Result<string, InvalidUtf8>.Success { value } = move String.fromUtf8(
    ChildProcess.errorBytes(&outcome),
  ) {
    run message.append(": ")
    run message.append(value)
  }
  fail StepError { message: move message }
}

effect fn program(name: string) -> Deferred<Path>
  ! StepFailure
  ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let path = match move run Executable.find(name) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      fail StepError {
        message: run String.copy("bundling a JavaScript app requires npm and Node.js on PATH"),
      }
    }
  }
  return run Deferred<Path>.external((run Context.text(&path)).view())
}

effect fn collect(directory: &Path, prefix: string, sources: &mut List<Source>) -> ()
  ! StepFailure
  ? &mut Allocator | &mut FileSystem {
  let entries = run FileSystem.listDirectory(directory)
  let listed = entries.asSlice()
  let mut names = List<string>.make()
  let mut at: usize = 0
  while at < listed.length {
    if let Option<string>.Some { value } = move Path.name(&listed[at].path) {
      if value != "node_modules" && value != "dist" && value != ".git" && value != "build" {
        run names.append(value)
      }
    }
    at = at + 1
  }
  run names.sort()
  let sorted = names.asSlice()
  at = 0
  while at < sorted.length {
    let name = sorted[at]
    let path = run Path.join(directory, name)
    let mut relative = run String.copy(prefix)
    run relative.append(name)
    let mut entry: usize = 0
    while entry < listed.length && Path.rawBytes(&listed[entry].path) != Path.rawBytes(&path) {
      entry = entry + 1
    }
    if entry < listed.length && listed[entry].kind.code == FileSystem.directory().code {
      run relative.append("/")
      run collect(&path, relative.view(), &mut sources.*)
    } else {
      run sources.append(
        Source {
          name: move relative,
          path: run Deferred<Path>.external((run Context.text(&path)).view()),
        },
      )
    }
    at = at + 1
  }
}

// Preserve the relative layout of file: dependencies inside the private step directory.
effect fn packages(directory: &Path, roots: &mut List<Path>) -> ()
  ! StepFailure
  ? &mut Allocator | &mut FileSystem {
  let listed = roots.asSlice()
  let text = run Context.text(directory)
  let mut at: usize = 0
  while at < listed.length {
    if (run Context.text(&listed[at])).view() == text.view() { return () }
    at = at + 1
  }
  run roots.append(run Path.make(text.view()))
  let bytes = run FileSystem.readFile(&run Path.join(directory, "package.json"))
  let document = match move run Effect.result(Json.parse(bytes.asSlice())) {
    Result<Value, JsonError | OutOfMemoryError>.Success {value} => move value
    Result<Value, JsonError | OutOfMemoryError>.Failure {error} => match move error {
      JsonError invalid => { drop invalid fail StepError {message: run String.copy("bundling requires valid package.json files")} }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let fields: [string; 3] = ["dependencies", "devDependencies", "optionalDependencies"]
  at = 0
  while at < fields.length {
    if let Option<&Value>.Some {value} = move Json.field(&document, fields[at]) {
      if let Value.Object {entries} = &value.* {
        let dependencies = entries.asSlice()
        let mut dependency: usize = 0
        while dependency < dependencies.length {
          if let Value.String {text: location} = &dependencies[dependency].value {
            let written = location.view()
            if String.startsWith(written, "file:") {
              let relative = String.slice(written, 5, String.utf8Bytes(written).length - 5)
              let path = run Path.resolve(directory, relative)
              run packages(&path, &mut roots.*)
            }
          }
          dependency = dependency + 1
        }
      }
    }
    at = at + 1
  }
}

/// Registers locked npm inputs, including local file dependencies, in a private cached tree.
pub effect fn register(directory: &Path) -> StepHandle
  ! StepFailure
  ? &mut Allocator | &mut FileSystem | &mut HostInput {
  if !run FileSystem.exists(&run Path.join(directory, "package-lock.json")) {
    fail StepError {message: run String.copy("bundling requires a committed package-lock.json; run npm install --package-lock-only in the web directory")}
  }
  let mut roots = List<Path>.make()
  run packages(directory, &mut roots)
  let listed = roots.asSlice()
  let mut common = run Path.fromBytes(Path.rawBytes(directory))
  let mut at: usize = 0
  while at < listed.length {
    let location = run Context.text(&listed[at])
    while true {
      let text = run Context.text(&common)
      let mut prefix = run String.copy(text.view())
      if text.view() != "/" { run prefix.append("/") }
      if location.view() == text.view() || String.startsWith(location.view(), prefix.view()) { break }
      common = match move run Path.parent(&common) {
        Option<Path>.Some {value} => move value
        Option<Path>.None => { fail StepError {message: run String.copy("local npm dependencies need a common filesystem root")} }
      }
    }
    at = at + 1
  }
  let commonText = run Context.text(&common)
  let skip = if commonText.view() == "/" { 1 } else { String.utf8Bytes(commonText.view()).length + 1 }
  let mut sources = List<Source>.make()
  let mut web = String.make()
  at = 0
  while at < listed.length {
    let text = run Context.text(&listed[at])
    let mut prefix = run String.copy("source")
    if text.view() != commonText.view() {
      run prefix.append("/")
      run prefix.append(String.slice(text.view(), skip, String.utf8Bytes(text.view()).length - skip))
    }
    if at == 0 { web = run String.copy(prefix.view()) }
    run prefix.append("/")
    run collect(&listed[at], prefix.view(), &mut sources)
    at = at + 1
  }
  let mut certificates = List<Deferred<Path>>.make()
  let names: [string; 4] = ["NODE_EXTRA_CA_CERTS", "SSL_CERT_FILE", "NPM_CONFIG_CAFILE", "npm_config_cafile"]
  at = 0
  while at < names.length {
    if let Option<Bytes>.Some {value} = move run HostInput.variableNamed(names[at]) {
      if value.length() > 0 {
        let path = run Path.fromBytes(value.asSlice())
        run certificates.append(run Deferred<Path>.external((run Context.text(&path)).view()))
      }
    }
    at = at + 1
  }
  return run Step.register(
    Bundle { sources: move sources, web: move web, certificates: move certificates, npm: run program("npm"), node: run program("node") },
  )
}
