//! Where the engine keeps the parts of a ValueBits, as compiled code needs them.
//!
//! Compiled code holds a boxed value as a 16-byte ValueBits laid out exactly as the engine
//! lays it out (docs/jit/compiled-entry.md, "Values"). Silk does not promise a union layout, so
//! the JIT reads it once from the engine's own code: it writes each variant into memory filled
//! with zeros and again with ones, and finds the bytes that carry the tag and the payload.
//! The record is a fact of one engine build; an artefact stored ahead of time keys on it.
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }

/// Engine tags (ValueBits.tag) from -9 to 8 index `tags` as tag + 9.
pub const TAG_BIAS: i32 = 9
pub const TAG_COUNT: usize = 18

pub struct ValueLayout {
  /// Bytes from one ValueBits to the next.
  pub size: u32,
  /// The tag field: a little-endian unsigned integer of `tagWidth` (1, 2 or 4) bytes at
  /// `tagOffset`, in the first word.
  pub tagOffset: u32,
  pub tagWidth: u32,
  /// The payload starts at this offset (the second word): an Int's i32, a Bool's byte, a
  /// Float64's bits or a heap reference.
  pub payloadOffset: u32,
  /// The tag field's value per engine tag (index tag + 9); u32.MAX for tags with no variant.
  pub tags: [u32; 18],
  /// The heap variants' field values are exactly lowest..=highest.
  pub heapLowest: u32,
  pub heapHighest: u32
}
impl Copy for ValueLayout {}

impl ValueLayout {
  /// The tag field value of the variant whose engine tag is `tag`.
  pub fn tagOf(self: &Self, tag: i32) -> u32 { return self.tags[i32.toUsize(tag + TAG_BIAS)] }
  pub fn int(self: &Self) -> u32 { return self.tagOf(0) }
  pub fn boolean(self: &Self) -> u32 { return self.tagOf(1) }
  pub fn null(self: &Self) -> u32 { return self.tagOf(2) }
  pub fn undefined(self: &Self) -> u32 { return self.tagOf(3) }
  pub fn uninitialized(self: &Self) -> u32 { return self.tagOf(4) }
  pub fn float64(self: &Self) -> u32 { return self.tagOf(8) }
  /// The marker `catch` pushes; its handler offset is an i32 payload like an Int's.
  pub fn catchOffset(self: &Self) -> u32 { return self.tagOf(5) }
  pub fn object(self: &Self) -> u32 { return self.tagOf(-1) }
  /// The first word of a value whose tag field is `field` and whose other first-word bytes
  /// are zero.
  pub fn tagWord(self: &Self, field: u32) -> u64 { return u64.shiftLeft(u32.toU64(field), u32.toU64(self.tagOffset * 8)) }
}

/// Writes `value` into 16 bytes filled with `fill` and returns them.
fn image(value: ValueBits, fill: u8) -> [u8; 32] {
  let mut bytes: [u8; 32] = [fill; 32]
  let target = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ValueBits>(Pointer.fromMutRef<u8>(&mut bytes[0]))
  unsafe Pointer.write<ValueBits>(target, value)
  return bytes
}

/// Reads the layout, or None when it is not one compiled code understands (then the JIT
/// compiles nothing).
pub fn probe() -> Option<ValueLayout> {
  // Stride: two adjacent cells.
  let mut pair: [ValueBits; 2] = [ValueBits.Undefined, ValueBits.Undefined]
  let first = Pointer.address<ValueBits>(Pointer.fromMutRef<ValueBits>(&mut pair[0]))
  let second = Pointer.address<ValueBits>(Pointer.fromMutRef<ValueBits>(&mut pair[1]))
  let size = second - first
  if size != 16 { return Option<ValueLayout>.none() }
  // The payload: an Int of distinct bytes, found in both fills at the same place.
  let marker: u32 = 0x5a3c1e0f
  let low = image(ValueBits.Int { value: u32.wrappingToI32(marker) }, 0)
  let high = image(ValueBits.Int { value: u32.wrappingToI32(marker) }, 255)
  let payload: usize = 8
  if readU32(&low, payload) != marker || readU32(&high, payload) != marker { return Option<ValueLayout>.none() }
  let handler = image(ValueBits.CatchOffset { offset: 0x1e0f }, 255)
  if readU32(&handler, payload) != 0x1e0f { return Option<ValueLayout>.none() }
  // The tag: the first-word bytes an immediate variant writes the same under both fills.
  let u0 = image(ValueBits.Undefined, 0)
  let u1 = image(ValueBits.Undefined, 255)
  let mut tagStart: usize = 8
  let mut tagEnd: usize = 0
  let mut b: usize = 0
  while b < 8 {
    if u0[b] == u1[b] { if b < tagStart { tagStart = b } tagEnd = b + 1 }
    b = b + 1
  }
  if tagEnd <= tagStart { return Option<ValueLayout>.none() }
  // Silk may copy a whole word for a narrower discriminant, so the stable bytes can be wider
  // than the tag. The variants' values are below 256: the lowest stable byte decides, and the
  // rest of the first word must read zero for every variant (checked below), which makes a
  // one-byte read correct whether the field is one byte with padding or a wider integer.
  let width: usize = 1
  let mut layout = ValueLayout { size: 16, tagOffset: usize.toU32(tagStart), tagWidth: usize.toU32(width), payloadOffset: 8,
    tags: [u32.MAX; 18], heapLowest: u32.MAX, heapHighest: 0 }
  // Each variant's field, read under both fills: they must agree, and differ between variants.
  // Any address will do for the bits; nothing reads through it.
  let mut cell: u64 = 0
  let fake = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut HeapHeader>(Pointer.fromMutRef<u64>(&mut cell))
  let fakeAddress = usize.toU64(Pointer.address<HeapHeader>(fake))
  let mut samples: [ValueBits; 16] = [ValueBits.Undefined; 16]
  samples[0] = ValueBits.BigInt { reference: fake }
  samples[1] = ValueBits.Symbol { reference: fake }
  samples[2] = ValueBits.String { reference: fake }
  samples[3] = ValueBits.Rope { reference: fake }
  samples[4] = ValueBits.Module { reference: fake }
  samples[5] = ValueBits.FunctionBytecode { reference: fake }
  samples[6] = ValueBits.Object { reference: fake }
  samples[7] = ValueBits.Int { value: 7 }
  samples[8] = ValueBits.Bool { value: true }
  samples[9] = ValueBits.Null
  samples[10] = ValueBits.Undefined
  samples[11] = ValueBits.Uninitialized
  samples[12] = ValueBits.CatchOffset { offset: 3 }
  samples[13] = ValueBits.Exception
  samples[14] = ValueBits.ShortBigInt { value: 5 }
  samples[15] = ValueBits.Float64 { value: 1.5 }
  let mut s: usize = 0
  while s < 16 {
    let value = samples[s]
    let tag = value.tag()
    let a = image(value, 0)
    let c = image(value, 255)
    let field = readField(&a, tagStart, width)
    if field != readField(&c, tagStart, width) { return Option<ValueLayout>.none() }
    let mut rest: usize = 0
    while rest < 8 {
      if rest != tagStart && rest >= tagStart && rest < tagEnd && (a[rest] != 0 || c[rest] != 0) { return Option<ValueLayout>.none() }
      rest = rest + 1
    }
    let mut t: usize = 0
    while t < TAG_COUNT { if layout.tags[t] == field { return Option<ValueLayout>.none() } t = t + 1 }
    layout.tags[i32.toUsize(tag + TAG_BIAS)] = field
    if s < 7 {
      // A heap reference: its pointer is the payload word.
      if readU64(&a, payload) != fakeAddress { return Option<ValueLayout>.none() }
      if field < layout.heapLowest { layout.heapLowest = field }
      if field > layout.heapHighest { layout.heapHighest = field }
    }
    s = s + 1
  }
  // Every field from lowest to highest must be a heap variant, so one range check decides.
  if layout.heapHighest - layout.heapLowest != 6 { return Option<ValueLayout>.none() }
  // A Bool's payload byte is 0 or 1; a Float64's payload is its bits.
  let truth = image(ValueBits.Bool { value: true }, 255)
  if truth[payload] != 1 { return Option<ValueLayout>.none() }
  let double = image(ValueBits.Float64 { value: 1.5 }, 255)
  if readU64(&double, payload) != 0x3ff8000000000000 { return Option<ValueLayout>.none() }
  return Option<ValueLayout>.some(layout)
}

fn readField(bytes: &[u8; 32], at: usize, width: usize) -> u32 {
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < width { value = value | u32.shiftLeft(u8.toU32(bytes[at + i]), usize.toU32(i * 8)) i = i + 1 }
  return value
}
fn readU32(bytes: &[u8; 32], at: usize) -> u32 { return readField(bytes, at, 4) }
fn readU64(bytes: &[u8; 32], at: usize) -> u64 {
  return u64.bitOr(u32.toU64(readField(bytes, at, 4)), u64.shiftLeft(u32.toU64(readField(bytes, at + 4, 4)), 32))
}
