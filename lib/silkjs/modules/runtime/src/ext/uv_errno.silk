//! libuv 1.51's error map (UV_ERRNO_MAP): each error's name, message and status, with Linux,
//! Darwin (xnu bsd/sys/errno.h) and Windows values; negative errno on Unix, libuv's fixed values
//! for codes a host lacks, and the EAI_* resolver range. Pure: no engine code, so the C exports of
//! `ext.uv_api_sys` (uv_err_name, uv_strerror) and the runtime's error objects (`ext.system_errors`)
//! read the one table.
import silk.core.option { Option }
import silk.num.i32
import silk.num.i64
import silk.collections.slice { Slice }

pub struct SystemError { pub code: i32, pub name: &'static [u8], pub message: &'static [u8] }

/// Number of entries reachable through `at`.
pub fn count() -> usize { return 85 }

/// Entry at `index` (0 through count() - 1), in libuv map order. Other indices trap.
pub fn at(index: usize) -> SystemError {
  return SystemError { code: code(index), name: name(index), message: message(index) }
}

/// The index of the entry whose code is `wanted`, or count() when there is none.
pub fn indexOf(wanted: i32) -> usize {
  let mut index: usize = 0
  while index < count() {
    if code(index) == wanted { return index }
    index = index + 1
  }
  return index
}

/// The entry whose code is `code`, if any.
pub fn lookup(wanted: i32) -> Option<SystemError> {
  let mut index: usize = 0
  while index < count() {
    if code(index) == wanted { return Option<SystemError>.some(at(index)) }
    index = index + 1
  }
  return Option<SystemError>.none()
}

/// "Unknown system error N", the name and message Node reports for an unmapped code.
pub struct Unknown { bytes: [u8; 32], length: usize }
impl Unknown {
  pub fn make(code: i32) -> Self {
    let prefix = b"Unknown system error "
    let mut result = Self { bytes: [0; 32], length: 0 }
    let mut i: usize = 0
    while i < prefix.length { result.bytes[i] = prefix[i] i = i + 1 }
    // Widen before negating so the i32 minimum prints exactly.
    let mut value = i32.toI64(code)
    if value < 0 { result.bytes[i] = 45 i = i + 1 value = 0 - value }
    let mut digits: [u8; 10] = [0; 10]
    let mut used: usize = 0
    while true {
      digits[used] = i64.toU8(48 + value % 10)
      used = used + 1
      value = value / 10
      if value == 0 { break }
    }
    while used > 0 { used = used - 1 result.bytes[i] = digits[used] i = i + 1 }
    result.length = i
    return move result
  }
  pub fn asSlice<'a>(self: &'a Self) -> &'a [u8] { return Slice.view<u8>(&self.bytes, 0, self.length) }
}

/// The name of entry `index` followed by a zero byte: a C string that lives as long as the program.
pub fn nameText(index: usize) -> &'static [u8] { return nameZ(index) }
/// The message of entry `index` followed by a zero byte.
pub fn messageText(index: usize) -> &'static [u8] { return messageZ(index) }
fn name(index: usize) -> &'static [u8] { let t = nameZ(index) return Slice.view<u8>(t, 0, t.length - 1) }
fn message(index: usize) -> &'static [u8] { let t = messageZ(index) return Slice.view<u8>(t, 0, t.length - 1) }

fn nameZ(index: usize) -> &'static [u8] {
  return match index {
    0 => b"E2BIG\0"
    1 => b"EACCES\0"
    2 => b"EADDRINUSE\0"
    3 => b"EADDRNOTAVAIL\0"
    4 => b"EAFNOSUPPORT\0"
    5 => b"EAGAIN\0"
