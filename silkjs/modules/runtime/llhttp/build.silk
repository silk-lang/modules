import silk.build.plan { Library, Plan }
import silk.build.step { sourcePath }

static fn sources0(start: Plan) -> Plan {
  let files: [string; 3] = [
    "vendor/src/llhttp.c",
    "vendor/src/http.c",
    "src/ext/http_parser_bridge.c",
  ]
  let mut plan = start
  let mut at: usize = 0
  while at < files.length {
    plan = plan |> Plan.compileNative("c", sourcePath(files[at]), &[
      "-std=gnu11",
      "-O2",
      "-w",
    ], &[
      sourcePath("vendor/include"),
    ])
    at = at + 1
  }
  return plan
}

static fn sources1(start: Plan) -> Plan {
  let files: [string; 1] = [
    "vendor/src/api.c",
  ]
  let mut plan = start
  let mut at: usize = 0
  while at < files.length {
    plan = plan |> Plan.compileNative("c", sourcePath(files[at]), &[
      "-std=gnu11",
      "-O2",
      "-w",
      "-Dllhttp__on_message_begin=silk_llhttp_base_on_message_begin",
      "-Dllhttp__on_header_value_complete=silk_llhttp_base_on_header_value_complete",
      "-Dllhttp__on_headers_complete=silk_llhttp_base_on_headers_complete",
      "-Dllhttp__on_message_complete=silk_llhttp_base_on_message_complete",
      "-Dllhttp__on_chunk_header=silk_llhttp_base_on_chunk_header",
      "-Dllhttp__on_chunk_complete=silk_llhttp_base_on_chunk_complete",
    ], &[
      sourcePath("vendor/include"),
    ])
    at = at + 1
  }
  return plan
}

const STEP_0: Plan = sources0(Plan.empty())
const STEP_1: Plan = sources1(STEP_0)

static fn plan() -> Plan {
  let mut plan = STEP_1
  return plan
}

pub const PLAN: Plan = plan()
