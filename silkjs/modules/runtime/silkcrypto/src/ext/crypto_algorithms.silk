  let blockLength: usize = if x.kind == C_TDES_CBC || x.kind == C_TDES_ECB || x.family == 5 || x.family == 6 { 8 } else { 16 }
  let noFinalBlock = x.processed == 0 || x.processed % blockLength != 0
