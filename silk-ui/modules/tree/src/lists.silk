//! CSS Lists 3 and counters: the `::marker` box of a list item, and the counters pass that
//! numbers markers and writes `counter()` and `counters()` in generated content. The pass walks
//! the rendered tree in order after each style pass once any node uses lists (`listsUsed`).
import silk.core.ownership { Copy }
import engine { UiTree }
import node { Node, NO_INDEX }
import mutation { NodeKind }
import ui_protocol.error { TreeError }
import style { Computed, ListStyle, LIST_STRING }
import generated
import svg_css.adopted { StyleSheets }
import svg_css.element { PseudoTarget }
import svg_css.counter_styles { CounterStyle, CounterChange }
import svg_css.counter_styles
import svg_css.input { Input, TokenView }
import svg_css.lexer
import svg_css.tokens { Kind, Limits, CssError, TokenBuffer, insensitive }
import properties.catalog { Property }
import properties.computed { Display, DisplayOutside, DisplayInside, Position, Float, WhiteSpace }
import properties.declare
import properties.values { Declaration, Value }
import properties.values
import properties.keywords { Keyword }
import properties.convert
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String, InvalidUtf8 }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.usize
import silk.num.u8

const NONE: u32 = u32.MAX
const LIST_ITEM: &[u8] = b"list-item"

/// `content` on `::marker`: not set (or `normal`), `none`, or a value that replaces the marker.
pub const CONTENT_NORMAL: u8 = 0
pub const CONTENT_NONE: u8 = 1
pub const CONTENT_SET: u8 = 2

pub fn isMarker(node: &Node) -> bool {
  return match node.identity() { Option.Some { value } => value.generatedTarget == PseudoTarget.Marker _ => false }
}

/// Whether a rule of `sheets` styles `::marker`.
pub fn hasMarkerRules(sheets: &StyleSheets) -> bool {
  let mut i: usize = 0
  while i < sheets.sheets().length {
    let rules = sheets.sheets()[i].sheet.resolver.rules()
    let mut rule: usize = 0
    while rule < rules.length {
      if rules[rule].selectors.hasPseudoTarget(PseudoTarget.Marker) { return true }
      rule = rule + 1
    }
    i = i + 1
  }
  return false
}

fn declared<'a>(declarations: &'a [Declaration], property: Property) -> Option<&'a Value> {
  let mut i = declarations.length
  while i > 0 {
    i = i - 1
    if declarations[i].property == property { return Option<&Value>.some(&declarations[i].value) }
  }
  return Option<&Value>.None
}

pub fn markerContent(declarations: &[Declaration]) -> u8 {
  return match declared(declarations, Property.Content) {
    Option.Some { value } => if convert.isKeyword(value, Keyword.None) { CONTENT_NONE } else if convert.isKeyword(value, Keyword.Normal) { CONTENT_NORMAL } else { CONTENT_SET }
    _ => CONTENT_NORMAL
  }
}

/// The marker box's own layout, which its style cannot change (Lists 3 §3.1, §3.2): inline
/// inside the item, or an out-of-flow block the item places beside its first line.
pub fn markerLayout(computed: &mut Computed, item: ListStyle) {
  if item.inside() {
    computed.layout.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
  } else {
    computed.layout.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.FlowRoot }
    computed.layout.outsideMarker = true
  }
  computed.layout.position = Position.Static
  computed.layout.float = Float.None
  computed.apply(&declare.whiteSpace(WhiteSpace.Pre))
}

// `copy`: made in a style-contained subtree from a counter outside it, which it hides there.
struct Counter { name: Bytes, value: i64, owner: u32, copy: bool }

// A style-contained element and the counters in scope when it was entered.
struct Barrier { owner: u32, at: usize }
impl Copy for Barrier {}

/// The counters in scope at one point of the walk, innermost last. A counter belongs to the
/// parent of the element that made it, and leaves scope with that parent (CSS Lists 3 §4.5).
/// Inside a style-contained element (CSS Containment 2 §3.3) changes to counters from outside go
/// to copies that leave with it.
pub struct Scope { counters: List<Counter>, barriers: List<Barrier> }

impl Scope {
  pub fn empty() -> Scope { return Scope { counters: List<Counter>.make(), barriers: List<Barrier>.make() } }

  effect fn contain(self: &mut Self, owner: u32) ! OutOfMemoryError ? &mut Allocator {
    run self.barriers.append(Barrier { owner: owner, at: self.counters.length() })
  }

  fn innermost(self: &Self, name: &[u8]) -> usize {
    let items = self.counters.asSlice()
    let mut i = items.length
    while i > 0 {
      i = i - 1
      if Bytes.asSlice(&items[i].name) == name { return i }
    }
    return usize.MAX
  }

  /// The value `counter(name)` reads: the innermost counter's, or 0 when none is in scope.
  pub fn value(self: &Self, name: &[u8]) -> i64 {
    let at = self.innermost(name)
    return if at == usize.MAX { 0 } else { self.counters.asSlice()[at].value }
  }

  /// `counter(name, style)`, or with a separator `counters(name, separator, style)`.
  pub effect fn write(self: &Self, name: &[u8], separator: &[u8], nested: bool, style: CounterStyle, out: &mut Bytes) ! OutOfMemoryError ? &mut Allocator {
    if !nested {
      run counter_styles.format(self.value(name), style, &mut out.*)
      return ()
    }
    let items = self.counters.asSlice()
    // A copy stands for the counter it hides, the last one of its name before it.
    let mut found = List<i64>.make()
    let mut i: usize = 0
    while i < items.length {
      if Bytes.asSlice(&items[i].name) == name {
        let count = found.length()
        if items[i].copy && count != 0 { found.set(count - 1, items[i].value) }
        else { run found.append(items[i].value) }
      }
      i = i + 1
    }
    if found.length() == 0 { run found.append(0) }
    i = 0
    while i < found.length() {
      if i > 0 { run out.append(separator) }
      run counter_styles.format(found.get(i), style, &mut out.*)
      i = i + 1
    }
  }

  effect fn reset(self: &mut Self, name: &[u8], value: i64, owner: u32) ! OutOfMemoryError ? &mut Allocator {
    let at = self.innermost(name)
    // A sibling's counter of the name is replaced rather than nested (CSS 2.2 §12.4.1).
    if at != usize.MAX && self.counters.asSlice()[at].owner == owner {
      let items = self.counters.asMutSlice()
      items[at].value = value
      return ()
    }
    run self.counters.append(Counter { name: run Bytes.copy(name), value: value, owner: owner, copy: false })
  }

  effect fn change(self: &mut Self, name: &[u8], value: i64, owner: u32, add: bool) ! OutOfMemoryError ? &mut Allocator {
    let at = self.innermost(name)
    if at == usize.MAX {
      run self.counters.append(Counter { name: run Bytes.copy(name), value: value, owner: owner, copy: false })
      return ()
    }
    if self.barriers.length() != 0 {
      let barrier = self.barriers.get(self.barriers.length() - 1)
      if at < barrier.at {
        let start = self.counters.asSlice()[at].value
        let next = if add { i64.saturatingAdd(start, value) } else { value }
        run self.counters.append(Counter { name: run Bytes.copy(name), value: next, owner: barrier.owner, copy: true })
        return ()
      }
    }
    let items = self.counters.asMutSlice()
    items[at].value = if add { i64.saturatingAdd(items[at].value, value) } else { value }
  }

  fn leave(self: &mut Self, owner: u32) {
    while self.counters.length() != 0 && self.counters.asSlice()[self.counters.length() - 1].owner == owner {
      drop self.counters.pop()
    }
    let count = self.barriers.length()
    if count != 0 && self.barriers.get(count - 1).owner == owner { self.barriers.truncate(count - 1) }
  }
}

fn mentions(changes: &[CounterChange], name: &[u8]) -> bool {
  let mut i: usize = 0
  while i < changes.length {
    if Bytes.asSlice(&changes[i].name) == name { return true }
    i = i + 1
  }
  return false
}

// The declarations a node's computed values came from: its matched record, else its own look.
fn declarationsOf<'a>(node: &'a Node) -> &'a [Declaration] {
  return match node.sheetStyle() {
    Option.Some { value } => value.declarations.asSlice()
    _ => node.base.asSlice()
  }
}

effect fn changesOf(node: &Node, property: Property, default: i32) -> List<CounterChange> ! OutOfMemoryError ? &mut Allocator {
  return match declared(declarationsOf(node), property) {
    Option.Some { value } => {
      let css = run values.cssText(value)
      run counter_styles.changes(css.asSlice(), default)
    }
    _ => List<CounterChange>.make()
  }
}

fn attribute<'a>(node: &'a Node, name: &[u8]) -> Option<&'a [u8]> {
  if let Option.Some { value } = node.identity() {
    let attributes = value.attributes()
    let mut i: usize = 0
    while i < attributes.length {
      if insensitive(String.utf8Bytes(String.view(&attributes[i].name)), name) { return Option<&'a [u8]>.some(String.utf8Bytes(String.view(&attributes[i].value))) }
      i = i + 1
    }
  }
  return Option<&'a [u8]>.None
}

fn integerOf(text: Option<&[u8]>) -> Option<i64> {
  let digits = match text { Option.Some { value } => value _ => { return Option<i64>.None } }
  let mut i: usize = 0
  while i < digits.length && (digits[i] == 32 || digits[i] == 9) { i = i + 1 }
  let negative = i < digits.length && digits[i] == 45
  if negative || i < digits.length && digits[i] == 43 { i = i + 1 }
  let start = i
  let mut value: i64 = 0
  while i < digits.length && digits[i] >= 48 && digits[i] <= 57 {
    if value < 1000000000 { value = value * 10 + u8.toI64(digits[i] - 48) }
    i = i + 1
  }
  if i == start { return Option<i64>.None }
  return Option<i64>.some(if negative { 0 - value } else { value })
}

fn tagIs(node: &Node, name: &[u8]) -> bool {
  return match node.identity() {
    Option.Some { value } => insensitive(String.utf8Bytes(value.tag()), name)
    _ => false
  }
}

// Lists 3 §4.4 and HTML's rendering rules: `ol`, `ul` and `menu` reset `list-item`, an `ol`
// to one before its `start`; an `li` with a `value` sets it.
effect fn enter(tree: &UiTree<'_>, slot: u32, scope: &mut Scope) ! OutOfMemoryError ? &mut Allocator {
  let node = tree.node(slot)
  let list = node.computed().list
  let contained = node.computed().contain.style()
  // A style-contained element's own counters stay inside it too.
  let parent = if contained { slot } else { node.parent }
  if contained { run scope.contain(slot) }
  let listTag = tagIs(node, b"ol") || tagIs(node, b"ul") || tagIs(node, b"menu")
  if !list.counters() && !list.item() && !listTag { return () }
  let resets = if list.counters() { run changesOf(node, Property.CounterReset, 0) } else { List<CounterChange>.make() }
  let increments = if list.counters() { run changesOf(node, Property.CounterIncrement, 1) } else { List<CounterChange>.make() }
  let sets = if list.counters() { run changesOf(node, Property.CounterSet, 0) } else { List<CounterChange>.make() }
  if listTag && !mentions(resets.asSlice(), LIST_ITEM) {
    let start = if tagIs(node, b"ol") { integerOf(attribute(node, b"start")) } else { Option<i64>.None }
    run scope.reset(LIST_ITEM, match start { Option.Some { value } => value - 1 _ => 0 }, parent)
  }
  let mut i: usize = 0
  while i < resets.length() {
    run scope.reset(resets.asSlice()[i].name.asSlice(), i32.toI64(resets.asSlice()[i].value), parent)
    i = i + 1
  }
  if list.item() && !mentions(increments.asSlice(), LIST_ITEM) { run scope.change(LIST_ITEM, 1, parent, true) }
  i = 0
  while i < increments.length() {
    run scope.change(increments.asSlice()[i].name.asSlice(), i32.toI64(increments.asSlice()[i].value), parent, true)
    i = i + 1
  }
  if list.item() && !mentions(sets.asSlice(), LIST_ITEM) {
    if let Option.Some { value } = integerOf(attribute(node, b"value")) { run scope.change(LIST_ITEM, value, parent, false) }
  }
  i = 0
  while i < sets.length() {
    run scope.change(sets.asSlice()[i].name.asSlice(), i32.toI64(sets.asSlice()[i].value), parent, false)
    i = i + 1
  }
}

// The text of a CSS string: `"→ "` gives `→ `.
effect fn stringOf(value: &Value) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let css = run values.cssText(value)
  let mut out = Bytes.make()
  let tokens = match run Effect.result(lexer.tokenize(css.asSlice(), &Limits.make())) {
    Result<TokenBuffer, CssError | OutOfMemoryError>.Success { value: buffer } => move buffer
    Result<TokenBuffer, CssError | OutOfMemoryError>.Failure { error: OutOfMemoryError {} } => { fail OutOfMemoryError {} }
    _ => { return move out }
  }
  let input = Input.Contiguous { buffer: &tokens, range: tokens.all() }
  let mut at: usize = 0
  while at < input.length() {
    if let Option<TokenView>.Some { value: token } = input.at(at) {
      if let Kind.String { text } = token.token.kind {
        run out.append(token.text(text))
        return move out
      }
    }
    at = at + 1
  }
  return move out
}

// The string of `list-style-type: <string>`, from the nearest node that declares the type.
effect fn listString(tree: &UiTree<'_>, origin: u32) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut at = origin
  while at != NONE {
    if let Option.Some { value } = declared(declarationsOf(tree.node(at)), Property.ListStyleType) {
      if !convert.isKeyword(value, Keyword.Inherit) { return run stringOf(value) }
    }
    at = tree.node(at).parent
  }
  return Bytes.make()
}

effect fn noContent(error: CssError | OutOfMemoryError) -> Option<String> ! OutOfMemoryError {
  match move error { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { return Option<String>.None } }
}

// The marker's text: its `content`, else the item's list style with its `list-item` counter.
effect fn markerText(tree: &UiTree<'_>, slot: u32, scope: &Scope) -> Option<String> ! OutOfMemoryError ? &mut Allocator {
  let node = tree.node(slot)
  let origin = node.parent
  if node.sheetStyle().isSome() && markerContent(declarationsOf(node)) == CONTENT_SET {
    let mut counted = false
    return run Effect.catchAll(generated.content(tree, origin, declarationsOf(node), scope, &mut counted), noContent)
  }
  let list = tree.node(origin).computed().list
  let mut out = Bytes.make()
  if list.typeCode() == LIST_STRING {
    out = run listString(tree, origin)
  } else {
    run counter_styles.marker(scope.value(LIST_ITEM), counter_styles.ofCode(list.typeCode()), &mut out)
  }
  return match String.fromUtf8(out.asSlice()) {
    Result<string, InvalidUtf8>.Success { value } => Option<String>.some(run String.copy(value))
    _ => Option<String>.None
  }
}

effect fn generatedText(tree: &UiTree<'_>, slot: u32, scope: &Scope) -> Option<String> ! OutOfMemoryError ? &mut Allocator {
  let node = tree.node(slot)
  if isMarker(node) { return run markerText(tree, slot, scope) }
  if node.sheetStyle().isNone() { return Option<String>.None }
  let mut counted = false
  let text = run Effect.catchAll(generated.content(tree, node.parent, declarationsOf(node), scope, &mut counted), noContent)
  if !counted { return Option<String>.None }
  return move text
}

/// The counters pass: walks the rendered tree in order, keeping the counters in scope, and
/// rewrites the text of every marker and of generated content that names a counter.
pub effect fn update(tree: &mut UiTree<'_>) ! OutOfMemoryError | TreeError ? &mut Allocator {
  if tree.root == NONE { return () }
  let mut scope = Scope.empty()
  let mut fills = List<u32>.make()
  let mut texts = List<String>.make()
  let top = tree.node(tree.root).css
  let mut at = top
  while true {
    let slot = tree.slotOfCssNode(at)
    let mut descend = true
    if slot != NONE {
      let node = tree.node(slot)
      if !node.rendered || node.kind == NodeKind.Text { descend = false }
      else if node.isGenerated() {
        if let Option.Some { value } = run generatedText(&tree.*, slot, &scope) {
          run fills.append(slot)
          run texts.append(move value)
        }
        descend = false
      } else { run enter(&tree.*, slot, &mut scope) }
    }
    let links = &tree.layout
    if descend && links.firstChild(at) != NO_INDEX {
      at = links.firstChild(at)
      continue
    }
    // Leaving `at` and every ancestor that has no next sibling.
    while at != top && links.nextSibling(at) == NO_INDEX {
      let leaving = tree.slotOfCssNode(at)
      if leaving != NONE { scope.leave(leaving) }
      at = links.parent(at)
    }
    let leaving = tree.slotOfCssNode(at)
    if leaving != NONE { scope.leave(leaving) }
    if at == top { break }
    at = links.nextSibling(at)
  }
  while fills.length() != 0 {
    let last = fills.length() - 1
    let slot = fills.get(last)
    fills.truncate(last)
    let text = match texts.pop() { Option.Some { value } => move value _ => { return () } }
    run tree.fillGenerated(slot, move text)
  }
}
