pub unsafe fn nghttp2_session_find_stream(session: ?*mut u8, stream: i32) -> ?*mut u8 {
  return unsafe Intrinsic.pointerReinterpret<?*mut Stream, ?*mut u8>(unsafe findStream(unsafe sessionOf(session), stream))
}
pub unsafe fn nghttp2_stream_get_state(stream: ?*mut u8) -> i32 {
  let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Stream>(unsafe nonnull(stream))
  let mut b = () let t = unsafe str(&mut b, p)
  if u8.bitAnd(t.flags, SF_PUSH) != 0 {
    if u8.bitAnd(t.shut, SHUT_RD) != 0 { return 3 }
    if u8.bitAnd(t.shut, SHUT_WR) != 0 { return 4 }
  }
  if u8.bitAnd(t.shut, SHUT_RD) != 0 { return 6 }
  if u8.bitAnd(t.shut, SHUT_WR) != 0 { return 5 }
  return 2
}
pub unsafe fn nghttp2_stream_get_weight(stream: ?*mut u8) -> i32 { return 16 }
pub unsafe fn nghttp2_stream_get_sum_dependency_weight(stream: ?*mut u8) -> i32 { return 0 }
pub unsafe fn nghttp2_session_get_next_stream_id(session: ?*mut u8) -> u32 { let mut a = () let s = unsafe ses(&mut a, unsafe sessionOf(session)) return s.nextStreamId }
pub unsafe fn nghttp2_session_set_next_stream_id(session: ?*mut u8, id: i32) -> i32 {
  let sp = unsafe sessionOf(session)
  if id <= 0 || unsafe isMyStream(sp, id) == false { return ERR_INVALID_ARGUMENT }
  let mut a = () let s = unsafe ses(&mut a, sp)
  if s.server { if i32.remainder(id, 2) != 0 { return ERR_INVALID_ARGUMENT } } else if i32.remainder(id, 2) == 0 { return ERR_INVALID_ARGUMENT }
  if s.nextStreamId > i32.wrappingToU32(id) { return ERR_INVALID_ARGUMENT }
  s.nextStreamId = i32.wrappingToU32(id)
  return 0
}
