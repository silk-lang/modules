@inlineNever
pub unsafe fn compressBlockBtlazy2DictMatchState(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  return unsafe lazyDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, SEARCH_BT, 2)
}
/// `ZSTD_compressBlock_greedy_dictMatchState_row`.
@inlineNever
pub unsafe fn compressBlockGreedyDictMatchStateRow(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  return unsafe lazyDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, SEARCH_ROW, 0)
