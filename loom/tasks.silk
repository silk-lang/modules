import silk.build.graph { BuildError }
import silk.cli.command { Command, CommandLine }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import src.task_checks { packages, unitTests, goldens }
import src.task_support { setupCi }
import src.task_native_cli { Tasks as NativeTasks }

static if Intrinsic.targetOperatingSystem() != "windows" {
  import src.task_native { httpCheck, httpFixture }
}

union Tasks {
  Check,
  CheckPackages,
  UnitTests,
  Goldens,
  SetupCi { pub browser: bool, pub linuxGpu: bool },
  Native { pub native: NativeTasks },
  HttpFixture,
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Loom checks, native demos and devtools checks")
      |> Command.variant("Check", "Check packages, tests, HTTP images and goldens")
      |> Command.variant("CheckPackages", "Check every workspace package and portable wasm APIs")
      |> Command.variant("UnitTests", "Run the unit-test roots")
      |> Command.variant("Goldens", "Compare the describe/PNG golden suites")
      |> Command.variant("SetupCi", "Provision pinned native tools and CI environment")
      |> Command.variant("HttpFixture", "Serve the loopback image fixture")
      |> Command.variant("Native", "Native demos and integration checks")
      |> Command.subcommand("native")
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! BuildError
      | TaskError
      | ProcessError
      | FileError
      | HostInputError
      | OutOfMemoryError
      | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.CheckPackages => run packages()
      Tasks.UnitTests => run unitTests()
      Tasks.Goldens => run goldens()
      Tasks.SetupCi { browser, linuxGpu } => run setupCi(browser, linuxGpu)
      Tasks.Native { native } => run TaskSet.perform(move native)
      Tasks.Check => {
        static if Intrinsic.targetOperatingSystem() == "windows" {
          run Task.abort(
            "HTTP fixture lifecycle needs Windows subprocess support: https://github.com/silk-lang/silk/issues/3034",
          )
        } else {
          run packages()
          run unitTests()
          run httpCheck("", "")
          run goldens()
        }
      }
      Tasks.HttpFixture => {
        static if Intrinsic.targetOperatingSystem() == "windows" {
          run Task.abort(
            "Windows managed subprocess support: https://github.com/silk-lang/silk/issues/3034",
          )
        } else {
          run httpFixture()
        }
      }
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
