//! Huffman decoding of literals (`huf_decompress.c` of the reference): the single-symbol table
//! (X1) and the double-symbol table (X2), each with its one-stream and four-stream decoders and
//! the fast four-stream loop, and the choice between them.
//!
//! A table is a byte buffer of `TABLE_BYTES`: a `u32` header (the table log in its low byte, 1 in
//! the next byte for an X2 table), then the cells. An X1 cell is two bytes: the number of bits, then the symbol.
import mem
import errors
import entropy
import entropy { DStream }
import silk.simd.cpu { CpuFeatures }
import silk.core.target { Arch, Target }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// The size of a table buffer: the header and 4096 cells of 4 bytes.
pub const TABLE_BYTES: usize = 16388

const FAST_TABLELOG: u32 = 11

/// Returns the table log of the table at `table`.
@inlineAlways
pub unsafe fn tableLog(table: [*]const u8) -> u32 { return unsafe mem.r32(table, 0) & 255 }

/// Reads a Huffman table description from `src[at..at+size]` and builds the X1 table at `table`
/// (`HUF_readDTableX1_wksp`). Returns the number of bytes read, or an error.
pub unsafe fn readTableX1(table: [*]mut u8, src: [*]const u8, at: usize, size: usize) -> usize {
  let mut weights: [u8; 256] = [0; 256]
  let mut rankVal: [u32; 16] = [0; 16]
  let mut rankStart: [u32; 16] = [0; 16]
  let mut symbols: [u8; 256] = [0; 256]
  let mut symbolCount: u32 = 0
  let mut log: u32 = 0
  let iSize = unsafe entropy.readStats(&mut weights, &mut rankVal, &mut symbolCount, &mut log, src, at, size)
  if errors.isError(iSize) { return iSize }
  // HUF_rescaleStats: a table of fewer than 11 bits is widened to 11, which the fast loop needs.
  if log < FAST_TABLELOG {
    let scale = FAST_TABLELOG - log
    let mut s: u32 = 0
    while s < symbolCount {
      let index = u32.toUsize(s)
      if weights[index] != 0 { weights[index] = weights[index] + u32.wrappingToU8(scale) }
      s = s + 1
    }
    s = FAST_TABLELOG
    while s > scale { rankVal[u32.toUsize(s)] = rankVal[u32.toUsize(s - scale)] s = s - 1 }
    s = scale
    while s > 0 { rankVal[u32.toUsize(s)] = 0 s = s - 1 }
    log = FAST_TABLELOG
  }
  if log > 13 { return errors.err(errors.E_TABLELOG_TOOLARGE) }
  unsafe mem.w32(table, 0, log)
  let mut nextRankStart: u32 = 0
  let mut n: u32 = 0
  while n < log + 1 {
    let current = nextRankStart
    nextRankStart = nextRankStart + rankVal[u32.toUsize(n)]
    rankStart[u32.toUsize(n)] = current
    n = n + 1
  }
  n = 0
  while n < symbolCount {
    let weight = u8.toUsize(weights[u32.toUsize(n)])
    symbols[u32.toUsize(rankStart[weight])] = u32.wrappingToU8(n)
    rankStart[weight] = rankStart[weight] + 1
    n = n + 1
  }
  let mut symbol = u32.toUsize(rankVal[0])
  let mut start: usize = 0
  let mut w: u32 = 1
  while w < log + 1 {
    let count = u32.toUsize(rankVal[u32.toUsize(w)])
    let length = u32.toUsize(u32.shiftRight(u32.shiftLeft(1, w), 1))
    let nbBits = log + 1 - w
    let mut s: usize = 0
    let mut uStart = start
    while s < count {
      let cell = u32.wrappingToU16(nbBits | u32.shiftLeft(u8.toU32(symbols[symbol + s]), 8))
      let mut u: usize = 0
      while u < length {
        unsafe mem.w16(table, 4 + (uStart + u) * 2, cell)
        u = u + 1
      }
      uStart = uStart + length
      s = s + 1
    }
    symbol = symbol + count
    start = start + count * length
    w = w + 1
  }
  return iSize
}

// HUF_decodeSymbolX1: the cell for the next `log` bits.
@inlineAlways
unsafe fn symbolX1(bits: &mut DStream, cells: [*]const u8, log: u32) -> u8 {
  let value = u64.wrappingToUsize(entropy.lookBitsFast(&bits, log))
  let cell = unsafe mem.r16(cells, usize.wrappingMultiply(value, 2))
  entropy.skipBits(&mut bits, u16.toU32(cell) & 255)
  return u16.wrappingToU8(u16.shiftRight(cell, 8))
}

// HUF_decodeStreamX1: fills `out[op..end]` from `bits`.
@inlineAlways
unsafe fn streamX1(out: [*]mut u8, start: usize, end: usize, bits: &mut DStream, cells: [*]const u8, log: u32) -> () {
  let mut op = start
  if end - op > 3 {
    while (unsafe entropy.reload(&mut bits)) == entropy.UNFINISHED && op < end - 3 {
      unsafe mem.w8(out, op, unsafe symbolX1(&mut bits, cells, log))
      unsafe mem.w8(out, usize.wrappingAdd(op, 1), unsafe symbolX1(&mut bits, cells, log))
      unsafe mem.w8(out, usize.wrappingAdd(op, 2), unsafe symbolX1(&mut bits, cells, log))
      unsafe mem.w8(out, usize.wrappingAdd(op, 3), unsafe symbolX1(&mut bits, cells, log))
      op = usize.wrappingAdd(op, 4)
    }
  } else {
    let _status = unsafe entropy.reload(&mut bits)
  }
  while op < end {
    unsafe mem.w8(out, op, unsafe symbolX1(&mut bits, cells, log))
    op = usize.wrappingAdd(op, 1)
  }
}

/// Decodes one Huffman stream at `src[at..at+size]` into `out[op..op+length]` with the X1 table
/// (`HUF_decompress1X1_usingDTable`). Returns `length`, or an error.
pub unsafe fn decompress1X1(out: [*]mut u8, op: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  static if Target.arch() == Arch.X86_64 {
    if CpuFeatures.available("bmi2") { return unsafe decompress1X1Bmi2(out, op, length, src, at, size, table) }
  }
  return unsafe decompress1X1Body(out, op, length, src, at, size, table)
}

static if Target.arch() == Arch.X86_64 {
  @features("bmi2")
  @inlineNever
  unsafe fn decompress1X1Bmi2(out: [*]mut u8, op: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize { return unsafe decompress1X1Body(out, op, length, src, at, size, table) }
}

@inlineAlways
unsafe fn decompress1X1Body(out: [*]mut u8, op: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  let cells = unsafe mem.addc(table, 4)
  let log = unsafe tableLog(table)
  let mut bits = entropy.emptyDStream(src)
  let started = unsafe entropy.initDStream(&mut bits, src, at, size)
  if errors.isError(started) { return started }
  unsafe streamX1(out, op, op + length, &mut bits, cells, log)
  if !entropy.endOfDStream(&bits) { return errors.err(errors.E_CORRUPTION_DETECTED) }
  return length
}

// HUF_initFastDStream: the container of the fast loop, with a mark below the unread bits.
@inlineAlways
unsafe fn fastStream(src: [*]const u8, ip: usize) -> u64 {
  let lastByte = unsafe mem.r8(src, ip + 7)
  let mut consumed: u64 = 0
  if lastByte != 0 { consumed = u32.toU64(8 - mem.highbit32(u8.toU32(lastByte))) }
  return u64.shiftLeft(unsafe mem.r64(src, ip) | 1, consumed)
}

// The fast loop decodes five symbols of each stream a pass, with no bounds check inside.
// Returns 0 if the input does not qualify (the caller then uses the checked decoder), `length`
// on success, or an error.
@inlineAlways
unsafe fn decompress4X1Fast(out: [*]mut u8, start: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  if length == 0 { return 0 }
  if size < 10 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  if unsafe tableLog(table) != FAST_TABLELOG { return 0 }
  let cells = unsafe mem.addc(table, 4)
  let length1 = u16.toUsize(unsafe mem.r16(src, at))
  let length2 = u16.toUsize(unsafe mem.r16(src, at + 2))
  let length3 = u16.toUsize(unsafe mem.r16(src, at + 4))
  let length4 = usize.wrappingSubtract(size, length1 + length2 + length3 + 6)
  let iend0 = at + 6
  let iend1 = iend0 + length1
  let iend2 = iend1 + length2
  let iend3 = iend2 + length3
  if length1 < 8 || length2 < 8 || length3 < 8 || length4 < 8 { return 0 }
  if length4 > size { return errors.err(errors.E_CORRUPTION_DETECTED) }
  let oend = start + length
  let segment = (length + 3) / 4
  let mut ip0 = iend1 - 8
  let mut ip1 = iend2 - 8
  let mut ip2 = iend3 - 8
  let mut ip3 = at + size - 8
  let mut op0 = start
  let mut op1 = op0 + segment
  let mut op2 = op1 + segment
  let mut op3 = op2 + segment
  if op3 >= oend { return 0 }
  let mut bits0 = unsafe fastStream(src, ip0)
  let mut bits1 = unsafe fastStream(src, ip1)
  let mut bits2 = unsafe fastStream(src, ip2)
  let mut bits3 = unsafe fastStream(src, ip3)
  let ilowest = at
  while true {
    let oiters = usize.wrappingSubtract(oend, op3) / 5
    let iiters = usize.wrappingSubtract(ip0, ilowest) / 7
    let mut iters = oiters
    if iiters < iters { iters = iiters }
    let olimit = usize.wrappingAdd(op3, usize.wrappingMultiply(iters, 5))
    if op3 == olimit { break }
    if ip1 < ip0 || ip2 < ip1 || ip3 < ip2 { break }
    // The loop runs on pointers, as the reference's does: a base and an index for each of
    // the eight streams' positions take one register more than x86-64 has.
    let mut p0 = unsafe mem.add(out, op0)
    let mut p1 = unsafe mem.add(out, op1)
    let mut p2 = unsafe mem.add(out, op2)
    let mut p3 = unsafe mem.add(out, op3)
    let mut q0 = unsafe mem.addc(src, ip0)
    let mut q1 = unsafe mem.addc(src, ip1)
    let mut q2 = unsafe mem.addc(src, ip2)
    let mut q3 = unsafe mem.addc(src, ip3)
    let pend = unsafe mem.add(out, olimit)
    while true {
      // Symbol 0 of each stream.
        let entry0s0 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits0, 53)), 2))
        bits0 = u64.shiftLeft(bits0, u16.toU64(entry0s0) & 63)
        unsafe mem.w8(p0, 0, u16.wrappingToU8(u16.shiftRight(entry0s0, 8)))
        let entry1s0 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits1, 53)), 2))
        bits1 = u64.shiftLeft(bits1, u16.toU64(entry1s0) & 63)
        unsafe mem.w8(p1, 0, u16.wrappingToU8(u16.shiftRight(entry1s0, 8)))
        let entry2s0 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits2, 53)), 2))
        bits2 = u64.shiftLeft(bits2, u16.toU64(entry2s0) & 63)
        unsafe mem.w8(p2, 0, u16.wrappingToU8(u16.shiftRight(entry2s0, 8)))
        let entry3s0 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits3, 53)), 2))
        bits3 = u64.shiftLeft(bits3, u16.toU64(entry3s0) & 63)
        unsafe mem.w8(p3, 0, u16.wrappingToU8(u16.shiftRight(entry3s0, 8)))
      // Symbol 1 of each stream.
        let entry0s1 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits0, 53)), 2))
        bits0 = u64.shiftLeft(bits0, u16.toU64(entry0s1) & 63)
        unsafe mem.w8(p0, 1, u16.wrappingToU8(u16.shiftRight(entry0s1, 8)))
        let entry1s1 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits1, 53)), 2))
        bits1 = u64.shiftLeft(bits1, u16.toU64(entry1s1) & 63)
        unsafe mem.w8(p1, 1, u16.wrappingToU8(u16.shiftRight(entry1s1, 8)))
        let entry2s1 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits2, 53)), 2))
        bits2 = u64.shiftLeft(bits2, u16.toU64(entry2s1) & 63)
        unsafe mem.w8(p2, 1, u16.wrappingToU8(u16.shiftRight(entry2s1, 8)))
        let entry3s1 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits3, 53)), 2))
        bits3 = u64.shiftLeft(bits3, u16.toU64(entry3s1) & 63)
        unsafe mem.w8(p3, 1, u16.wrappingToU8(u16.shiftRight(entry3s1, 8)))
      // Symbol 2 of each stream.
        let entry0s2 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits0, 53)), 2))
        bits0 = u64.shiftLeft(bits0, u16.toU64(entry0s2) & 63)
        unsafe mem.w8(p0, 2, u16.wrappingToU8(u16.shiftRight(entry0s2, 8)))
        let entry1s2 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits1, 53)), 2))
        bits1 = u64.shiftLeft(bits1, u16.toU64(entry1s2) & 63)
        unsafe mem.w8(p1, 2, u16.wrappingToU8(u16.shiftRight(entry1s2, 8)))
        let entry2s2 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits2, 53)), 2))
        bits2 = u64.shiftLeft(bits2, u16.toU64(entry2s2) & 63)
        unsafe mem.w8(p2, 2, u16.wrappingToU8(u16.shiftRight(entry2s2, 8)))
        let entry3s2 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits3, 53)), 2))
        bits3 = u64.shiftLeft(bits3, u16.toU64(entry3s2) & 63)
        unsafe mem.w8(p3, 2, u16.wrappingToU8(u16.shiftRight(entry3s2, 8)))
      // Symbol 3 of each stream.
        let entry0s3 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits0, 53)), 2))
        bits0 = u64.shiftLeft(bits0, u16.toU64(entry0s3) & 63)
        unsafe mem.w8(p0, 3, u16.wrappingToU8(u16.shiftRight(entry0s3, 8)))
        let entry1s3 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits1, 53)), 2))
        bits1 = u64.shiftLeft(bits1, u16.toU64(entry1s3) & 63)
        unsafe mem.w8(p1, 3, u16.wrappingToU8(u16.shiftRight(entry1s3, 8)))
        let entry2s3 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits2, 53)), 2))
        bits2 = u64.shiftLeft(bits2, u16.toU64(entry2s3) & 63)
        unsafe mem.w8(p2, 3, u16.wrappingToU8(u16.shiftRight(entry2s3, 8)))
        let entry3s3 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits3, 53)), 2))
        bits3 = u64.shiftLeft(bits3, u16.toU64(entry3s3) & 63)
        unsafe mem.w8(p3, 3, u16.wrappingToU8(u16.shiftRight(entry3s3, 8)))
      // Symbol 4 of each stream.
        let entry0s4 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits0, 53)), 2))
        bits0 = u64.shiftLeft(bits0, u16.toU64(entry0s4) & 63)
        unsafe mem.w8(p0, 4, u16.wrappingToU8(u16.shiftRight(entry0s4, 8)))
        let entry1s4 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits1, 53)), 2))
        bits1 = u64.shiftLeft(bits1, u16.toU64(entry1s4) & 63)
        unsafe mem.w8(p1, 4, u16.wrappingToU8(u16.shiftRight(entry1s4, 8)))
        let entry2s4 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits2, 53)), 2))
        bits2 = u64.shiftLeft(bits2, u16.toU64(entry2s4) & 63)
        unsafe mem.w8(p2, 4, u16.wrappingToU8(u16.shiftRight(entry2s4, 8)))
        let entry3s4 = unsafe mem.r16(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits3, 53)), 2))
        bits3 = u64.shiftLeft(bits3, u16.toU64(entry3s4) & 63)
        unsafe mem.w8(p3, 4, u16.wrappingToU8(u16.shiftRight(entry3s4, 8)))
      let ctz0 = u64.trailingZeros(bits0)
      p0 = unsafe mem.add(p0, 5)
      q0 = unsafe mem.subc(q0, u32.toUsize(u32.shiftRight(ctz0, 3)))
      bits0 = u64.shiftLeft(unsafe mem.r64(q0, 0) | 1, u32.toU64(ctz0 & 7))
      let ctz1 = u64.trailingZeros(bits1)
      p1 = unsafe mem.add(p1, 5)
      q1 = unsafe mem.subc(q1, u32.toUsize(u32.shiftRight(ctz1, 3)))
      bits1 = u64.shiftLeft(unsafe mem.r64(q1, 0) | 1, u32.toU64(ctz1 & 7))
      let ctz2 = u64.trailingZeros(bits2)
      p2 = unsafe mem.add(p2, 5)
      q2 = unsafe mem.subc(q2, u32.toUsize(u32.shiftRight(ctz2, 3)))
      bits2 = u64.shiftLeft(unsafe mem.r64(q2, 0) | 1, u32.toU64(ctz2 & 7))
      let ctz3 = u64.trailingZeros(bits3)
      p3 = unsafe mem.add(p3, 5)
      q3 = unsafe mem.subc(q3, u32.toUsize(u32.shiftRight(ctz3, 3)))
      bits3 = u64.shiftLeft(unsafe mem.r64(q3, 0) | 1, u32.toU64(ctz3 & 7))
      if mem.addrm(p3) >= mem.addrm(pend) { break }
    }
    op0 = mem.us(mem.addrm(p0), mem.addrm(out))
    op1 = mem.us(mem.addrm(p1), mem.addrm(out))
    op2 = mem.us(mem.addrm(p2), mem.addrm(out))
    op3 = mem.us(mem.addrm(p3), mem.addrm(out))
    ip0 = mem.us(mem.addr(q0), mem.addr(src))
    ip1 = mem.us(mem.addr(q1), mem.addr(src))
    ip2 = mem.us(mem.addr(q2), mem.addr(src))
    ip3 = mem.us(mem.addr(q3), mem.addr(src))
  }
  // Finish each stream with the checked decoder (HUF_initRemainingDStream).
  let mut segmentEnd = start
  let mut stream: u32 = 0
  while stream < 4 {
    if segment <= oend - segmentEnd { segmentEnd = segmentEnd + segment } else { segmentEnd = oend }
    let mut op = op0 let mut ip = ip0 let mut container = bits0 let mut iend = iend0
    if stream == 1 { op = op1 ip = ip1 container = bits1 iend = iend1 }
    if stream == 2 { op = op2 ip = ip2 container = bits2 iend = iend2 }
    if stream == 3 { op = op3 ip = ip3 container = bits3 iend = iend3 }
    if op > segmentEnd { return errors.err(errors.E_CORRUPTION_DETECTED) }
    if ip + 8 < iend { return errors.err(errors.E_CORRUPTION_DETECTED) }
    let mut bits = DStream { container: unsafe mem.r64(src, ip), consumed: u64.trailingZeros(container), ptr: ip, start: ilowest, limit: ilowest + 8, base: src }
    unsafe streamX1(out, op, segmentEnd, &mut bits, cells, FAST_TABLELOG)
    stream = stream + 1
  }
  return length
}

/// Decodes four Huffman streams at `src[at..at+size]` into `out[start..start+length]` with the X1
/// table (`HUF_decompress4X1_usingDTable`). Returns `length`, or an error.
pub unsafe fn decompress4X1(out: [*]mut u8, start: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  static if Target.arch() == Arch.X86_64 {
    if CpuFeatures.available("bmi2") { return unsafe decompress4X1Bmi2(out, start, length, src, at, size, table) }
  }
  return unsafe decompress4X1Body(out, start, length, src, at, size, table)
}

static if Target.arch() == Arch.X86_64 {
  @features("bmi2")
  @inlineNever
  unsafe fn decompress4X1Bmi2(out: [*]mut u8, start: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize { return unsafe decompress4X1Body(out, start, length, src, at, size, table) }
}

@inlineAlways
unsafe fn decompress4X1Body(out: [*]mut u8, start: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  let fast = unsafe decompress4X1Fast(out, start, length, src, at, size, table)
  if fast != 0 { return fast }
  if size < 10 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  if length < 6 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  let cells = unsafe mem.addc(table, 4)
  let log = unsafe tableLog(table)
  let length1 = u16.toUsize(unsafe mem.r16(src, at))
  let length2 = u16.toUsize(unsafe mem.r16(src, at + 2))
  let length3 = u16.toUsize(unsafe mem.r16(src, at + 4))
  let length4 = usize.wrappingSubtract(size, length1 + length2 + length3 + 6)
  let istart1 = at + 6
  let istart2 = istart1 + length1
  let istart3 = istart2 + length2
  let istart4 = istart3 + length3
  let segment = (length + 3) / 4
  let oend = start + length
  let opStart2 = start + segment
  let opStart3 = opStart2 + segment
  let opStart4 = opStart3 + segment
  if length4 > size { return errors.err(errors.E_CORRUPTION_DETECTED) }
  if opStart4 > oend { return errors.err(errors.E_CORRUPTION_DETECTED) }
  let mut bits1 = entropy.emptyDStream(src)
  let mut bits2 = entropy.emptyDStream(src)
  let mut bits3 = entropy.emptyDStream(src)
  let mut bits4 = entropy.emptyDStream(src)
  let r1 = unsafe entropy.initDStream(&mut bits1, src, istart1, length1)
  if errors.isError(r1) { return r1 }
  let r2 = unsafe entropy.initDStream(&mut bits2, src, istart2, length2)
  if errors.isError(r2) { return r2 }
  let r3 = unsafe entropy.initDStream(&mut bits3, src, istart3, length3)
  if errors.isError(r3) { return r3 }
  let r4 = unsafe entropy.initDStream(&mut bits4, src, istart4, length4)
  if errors.isError(r4) { return r4 }
  unsafe streamX1(out, start, opStart2, &mut bits1, cells, log)
  unsafe streamX1(out, opStart2, opStart3, &mut bits2, cells, log)
  unsafe streamX1(out, opStart3, opStart4, &mut bits3, cells, log)
  unsafe streamX1(out, opStart4, oend, &mut bits4, cells, log)
  if !(entropy.endOfDStream(&bits1) && entropy.endOfDStream(&bits2) && entropy.endOfDStream(&bits3) && entropy.endOfDStream(&bits4)) {
    return errors.err(errors.E_CORRUPTION_DETECTED)
  }
  return length
}

// ---- The double-symbol table (X2). ----
//
// An X2 cell is four bytes: two symbols (`sequence`), the number of bits, and how many of the
// two symbols the code yields. The header of an X2 table has 1 in its second byte.

/// Returns whether the table at `table` is a double-symbol table.
@inlineAlways
pub unsafe fn isX2(table: [*]const u8) -> bool { return (u32.shiftRight(unsafe mem.r32(table, 0), 8) & 255) == 1 }

@inlineAlways
fn cellX2(symbol: u32, nbBits: u32, baseSeq: u32, level: u32) -> u32 {
  let mut sequence = symbol
  if level != 1 { sequence = baseSeq + u32.shiftLeft(symbol, 8) }
  return sequence + u32.shiftLeft(nbBits, 16) + u32.shiftLeft(level, 24)
}

// HUF_fillDTableX2ForWeight: every symbol of `sorted[begin..end]` fills `1 << (tableLog - nbBits)`
// cells from `cells[at]` on.
unsafe fn fillForWeight(cells: [*]mut u8, at: usize, sorted: &[u8; 256], begin: usize, end: usize, nbBits: u32, tableLog: u32, baseSeq: u32, level: u32) -> () {
  let length = u32.toUsize(u32.shiftLeft(1, (tableLog - nbBits) & 31))
  let mut position = at
  let mut index = begin
  while index < end {
    let cell = cellX2(u8.toU32(sorted[index]), nbBits, baseSeq, level)
    if length < 2 {
      unsafe mem.w32(cells, position * 4, cell)
    } else {
      let pair = u32.toU64(cell) | u64.shiftLeft(u32.toU64(cell), 32)
      let mut filled: usize = 0
      while filled < length {
        unsafe mem.w64(cells, usize.wrappingMultiply(usize.wrappingAdd(position, filled), 4), pair)
        filled = usize.wrappingAdd(filled, 2)
      }
    }
    position = position + length
    index = index + 1
  }
}

/// Reads a Huffman table description from `src[at..at+size]` and builds the X2 table at `table`
/// (`HUF_readDTableX2_wksp`). Returns the number of bytes read, or an error.
pub unsafe fn readTableX2(table: [*]mut u8, src: [*]const u8, at: usize, size: usize) -> usize {
  let mut weights: [u8; 256] = [0; 256]
  let mut rankStats: [u32; 16] = [0; 16]
  // `rankStart0[w + 1]` is the reference's `rankStart[w]`.
  let mut rankStart0: [u32; 16] = [0; 16]
  let mut sorted: [u8; 256] = [0; 256]
  // `rankVal[consumed * 13 + w]`.
  let mut rankVal: [u32; 156] = [0; 156]
  let mut symbolCount: u32 = 0
  let mut tableLog: u32 = 0
  let mut maxTableLog: u32 = 12
  let iSize = unsafe entropy.readStats(&mut weights, &mut rankStats, &mut symbolCount, &mut tableLog, src, at, size)
  if errors.isError(iSize) { return iSize }
  if tableLog > maxTableLog { return errors.err(errors.E_TABLELOG_TOOLARGE) }
  if tableLog <= FAST_TABLELOG { maxTableLog = FAST_TABLELOG }
  let mut maxW = tableLog
  while rankStats[u32.toUsize(maxW)] == 0 { maxW = maxW - 1 }
  let mut nextRankStart: u32 = 0
  let mut w: u32 = 1
  while w < maxW + 1 {
    let current = nextRankStart
    nextRankStart = nextRankStart + rankStats[u32.toUsize(w)]
    rankStart0[u32.toUsize(w) + 1] = current
    w = w + 1
  }
  rankStart0[1] = nextRankStart
  rankStart0[u32.toUsize(maxW) + 2] = nextRankStart
  let mut s: u32 = 0
  while s < symbolCount {
    let weight = u8.toUsize(weights[u32.toUsize(s)])
    let rank = rankStart0[weight + 1]
    rankStart0[weight + 1] = rank + 1
    sorted[u32.toUsize(rank)] = u32.wrappingToU8(s)
    s = s + 1
  }
  rankStart0[1] = 0
  let rescale = maxTableLog - tableLog
  let mut nextRankVal: u32 = 0
  w = 1
  while w < maxW + 1 {
    let current = nextRankVal
    // `rankStats[w] << (w + rescale - 1)`; `w + rescale` is at least 1.
    nextRankVal = nextRankVal + u32.shiftLeft(rankStats[u32.toUsize(w)], w + rescale - 1)
    rankVal[u32.toUsize(w)] = current
    w = w + 1
  }
  let minBits = tableLog + 1 - maxW
  let mut consumed = minBits
  while consumed < maxTableLog - minBits + 1 {
    w = 1
    while w < maxW + 1 {
      rankVal[u32.toUsize(consumed) * 13 + u32.toUsize(w)] = u32.shiftRight(rankVal[u32.toUsize(w)], consumed)
      w = w + 1
    }
    consumed = consumed + 1
  }
  // HUF_fillDTableX2
  let cells = unsafe mem.add(table, 4)
  let targetLog = maxTableLog
  let nbBitsBaseline = tableLog + 1
  // `scaleLog = nbBitsBaseline - targetLog` is 1 or less.
  let wEnd = maxW + 1
  w = 1
  while w < wEnd {
    let begin = u32.toUsize(rankStart0[u32.toUsize(w)])
    let end = u32.toUsize(rankStart0[u32.toUsize(w) + 1])
    let nbBits = nbBitsBaseline - w
    if targetLog - nbBits >= minBits {
      let mut start = u32.toUsize(rankVal[u32.toUsize(w)])
      let length = u32.toUsize(u32.shiftLeft(1, (targetLog - nbBits) & 31))
      // minWeight = max(1, nbBits + scaleLog)
      let mut minWeight: u32 = 1
      if nbBits + nbBitsBaseline > targetLog + 1 { minWeight = nbBits + nbBitsBaseline - targetLog }
      let row = u32.toUsize(nbBits) * 13
      let mut index = begin
      while index != end {
        // HUF_fillDTableX2Level2
        let baseSeq = u8.toU32(sorted[index])
        if minWeight > 1 {
          let skipCell = cellX2(baseSeq, nbBits, 0, 1)
          let skipSize = u32.toUsize(rankVal[row + u32.toUsize(minWeight)])
          let mut filled: usize = 0
          while filled < skipSize {
            unsafe mem.w32(cells, (start + filled) * 4, skipCell)
            filled = filled + 1
          }
        }
        let mut w2 = minWeight
        while w2 < wEnd {
          let begin2 = u32.toUsize(rankStart0[u32.toUsize(w2)])
          let end2 = u32.toUsize(rankStart0[u32.toUsize(w2) + 1])
          let totalBits = nbBitsBaseline - w2 + nbBits
          unsafe fillForWeight(cells, start + u32.toUsize(rankVal[row + u32.toUsize(w2)]), &sorted, begin2, end2, totalBits, targetLog, baseSeq, 2)
          w2 = w2 + 1
        }
        start = start + length
        index = index + 1
      }
    } else {
      unsafe fillForWeight(cells, u32.toUsize(rankVal[u32.toUsize(w)]), &sorted, begin, end, nbBits, targetLog, 0, 1)
    }
    w = w + 1
  }
  unsafe mem.w32(table, 0, maxTableLog | 256)
  return iSize
}

// HUF_decodeSymbolX2: writes two bytes at `out[op]` and returns how many of them count.
@inlineAlways
unsafe fn symbolX2(out: [*]mut u8, op: usize, bits: &mut DStream, cells: [*]const u8, log: u32) -> usize {
  let value = u64.wrappingToUsize(entropy.lookBitsFast(&bits, log))
  let cell = unsafe mem.r32(cells, usize.wrappingMultiply(value, 4))
  unsafe mem.w16(out, op, u32.wrappingToU16(cell))
  entropy.skipBits(&mut bits, u32.shiftRight(cell, 16) & 255)
  return u32.toUsize(u32.shiftRight(cell, 24))
}

// HUF_decodeLastSymbolX2: writes one byte.
unsafe fn lastSymbolX2(out: [*]mut u8, op: usize, bits: &mut DStream, cells: [*]const u8, log: u32) -> () {
  let value = u64.wrappingToUsize(entropy.lookBitsFast(&bits, log))
  let cell = unsafe mem.r32(cells, usize.wrappingMultiply(value, 4))
  unsafe mem.w8(out, op, u32.wrappingToU8(cell))
  if u32.shiftRight(cell, 24) == 1 {
    entropy.skipBits(&mut bits, u32.shiftRight(cell, 16) & 255)
  } else if bits.consumed < 64 {
    entropy.skipBits(&mut bits, u32.shiftRight(cell, 16) & 255)
    if bits.consumed > 64 { bits.consumed = 64 }
  }
}

// HUF_decodeStreamX2: fills `out[start..end]` from `bits`, and returns the position it reached.
@inlineAlways
unsafe fn streamX2(out: [*]mut u8, start: usize, end: usize, bits: &mut DStream, cells: [*]const u8, log: u32) -> usize {
  let mut p = start
  if end - p >= 8 {
    if log <= 11 {
      while (unsafe entropy.reload(&mut bits)) == entropy.UNFINISHED && usize.wrappingAdd(p, 9) < end {
        p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
        p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
        p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
        p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
        p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
      }
    } else {
      while (unsafe entropy.reload(&mut bits)) == entropy.UNFINISHED && usize.wrappingAdd(p, 7) < end {
        p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
        p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
        p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
        p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
      }
    }
  } else {
    let _status = unsafe entropy.reload(&mut bits)
  }
  if end >= p && end - p >= 2 {
    while (unsafe entropy.reload(&mut bits)) == entropy.UNFINISHED && usize.wrappingAdd(p, 2) <= end {
      p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
    }
    while usize.wrappingAdd(p, 2) <= end {
      p = usize.wrappingAdd(p, unsafe symbolX2(out, p, &mut bits, cells, log))
    }
  }
  if p < end {
    unsafe lastSymbolX2(out, p, &mut bits, cells, log)
    p = p + 1
  }
  return p
}

/// Decodes one Huffman stream at `src[at..at+size]` into `out[op..op+length]` with the X2 table
/// (`HUF_decompress1X2_usingDTable`). Returns `length`, or an error.
pub unsafe fn decompress1X2(out: [*]mut u8, op: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  static if Target.arch() == Arch.X86_64 {
    if CpuFeatures.available("bmi2") { return unsafe decompress1X2Bmi2(out, op, length, src, at, size, table) }
  }
  return unsafe decompress1X2Body(out, op, length, src, at, size, table)
}

static if Target.arch() == Arch.X86_64 {
  @features("bmi2")
  @inlineNever
  unsafe fn decompress1X2Bmi2(out: [*]mut u8, op: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize { return unsafe decompress1X2Body(out, op, length, src, at, size, table) }
}

@inlineAlways
unsafe fn decompress1X2Body(out: [*]mut u8, op: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  let cells = unsafe mem.addc(table, 4)
  let log = unsafe tableLog(table)
  let mut bits = entropy.emptyDStream(src)
  let started = unsafe entropy.initDStream(&mut bits, src, at, size)
  if errors.isError(started) { return started }
  let _end = unsafe streamX2(out, op, op + length, &mut bits, cells, log)
  if !entropy.endOfDStream(&bits) { return errors.err(errors.E_CORRUPTION_DETECTED) }
  return length
}

// HUF_decompress4X2_usingDTable_internal_fast. Returns 0 if the input does not qualify.
@inlineAlways
unsafe fn decompress4X2Fast(out: [*]mut u8, start: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  if length == 0 { return 0 }
  if size < 10 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  if unsafe tableLog(table) != FAST_TABLELOG { return 0 }
  let cells = unsafe mem.addc(table, 4)
  let length1 = u16.toUsize(unsafe mem.r16(src, at))
  let length2 = u16.toUsize(unsafe mem.r16(src, at + 2))
  let length3 = u16.toUsize(unsafe mem.r16(src, at + 4))
  let length4 = usize.wrappingSubtract(size, length1 + length2 + length3 + 6)
  let iend0 = at + 6
  let iend1 = iend0 + length1
  let iend2 = iend1 + length2
  let iend3 = iend2 + length3
  if length1 < 8 || length2 < 8 || length3 < 8 || length4 < 8 { return 0 }
  if length4 > size { return errors.err(errors.E_CORRUPTION_DETECTED) }
  let oend = start + length
  let segment = (length + 3) / 4
  let mut ip0 = iend1 - 8
  let mut ip1 = iend2 - 8
  let mut ip2 = iend3 - 8
  let mut ip3 = at + size - 8
  let mut op0 = start
  let mut op1 = op0 + segment
  let mut op2 = op1 + segment
  let mut op3 = op2 + segment
  if op3 >= oend { return 0 }
  let oend0 = op1
  let oend1 = op2
  let oend2 = op3
  let mut bits0 = unsafe fastStream(src, ip0)
  let mut bits1 = unsafe fastStream(src, ip1)
  let mut bits2 = unsafe fastStream(src, ip2)
  let mut bits3 = unsafe fastStream(src, ip3)
  let ilowest = at
  while true {
    let mut iters = usize.wrappingSubtract(ip0, ilowest) / 7
    let room0 = usize.wrappingSubtract(oend0, op0) / 10
    if room0 < iters { iters = room0 }
    let room1 = usize.wrappingSubtract(oend1, op1) / 10
    if room1 < iters { iters = room1 }
    let room2 = usize.wrappingSubtract(oend2, op2) / 10
    if room2 < iters { iters = room2 }
    let room3 = usize.wrappingSubtract(oend, op3) / 10
    if room3 < iters { iters = room3 }
    let olimit = usize.wrappingAdd(op3, usize.wrappingMultiply(iters, 5))
    if op3 == olimit { break }
    if ip1 < ip0 || ip2 < ip1 || ip3 < ip2 { break }
    // The loop runs on pointers, as the reference's does: a base and an index for each of
    // the eight streams' positions take one register more than x86-64 has.
    let mut p0 = unsafe mem.add(out, op0)
    let mut p1 = unsafe mem.add(out, op1)
    let mut p2 = unsafe mem.add(out, op2)
    let mut p3 = unsafe mem.add(out, op3)
    let mut q0 = unsafe mem.addc(src, ip0)
    let mut q1 = unsafe mem.addc(src, ip1)
    let mut q2 = unsafe mem.addc(src, ip2)
    let mut q3 = unsafe mem.addc(src, ip3)
    let pend = unsafe mem.add(out, olimit)
    while true {
      // Symbol 0 of each stream.
        let entry0s0 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits0, 53)), 4))
        unsafe mem.w16(p0, 0, u32.wrappingToU16(entry0s0))
        bits0 = u64.shiftLeft(bits0, u32.toU64(u32.shiftRight(entry0s0, 16)) & 63)
        p0 = unsafe mem.add(p0, u32.toUsize(u32.shiftRight(entry0s0, 24)))
        let entry1s0 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits1, 53)), 4))
        unsafe mem.w16(p1, 0, u32.wrappingToU16(entry1s0))
        bits1 = u64.shiftLeft(bits1, u32.toU64(u32.shiftRight(entry1s0, 16)) & 63)
        p1 = unsafe mem.add(p1, u32.toUsize(u32.shiftRight(entry1s0, 24)))
        let entry2s0 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits2, 53)), 4))
        unsafe mem.w16(p2, 0, u32.wrappingToU16(entry2s0))
        bits2 = u64.shiftLeft(bits2, u32.toU64(u32.shiftRight(entry2s0, 16)) & 63)
        p2 = unsafe mem.add(p2, u32.toUsize(u32.shiftRight(entry2s0, 24)))
        let entry3s0 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits3, 53)), 4))
        unsafe mem.w16(p3, 0, u32.wrappingToU16(entry3s0))
        bits3 = u64.shiftLeft(bits3, u32.toU64(u32.shiftRight(entry3s0, 16)) & 63)
        p3 = unsafe mem.add(p3, u32.toUsize(u32.shiftRight(entry3s0, 24)))
      // Symbol 1 of each stream.
        let entry0s1 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits0, 53)), 4))
        unsafe mem.w16(p0, 0, u32.wrappingToU16(entry0s1))
        bits0 = u64.shiftLeft(bits0, u32.toU64(u32.shiftRight(entry0s1, 16)) & 63)
        p0 = unsafe mem.add(p0, u32.toUsize(u32.shiftRight(entry0s1, 24)))
        let entry1s1 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits1, 53)), 4))
        unsafe mem.w16(p1, 0, u32.wrappingToU16(entry1s1))
        bits1 = u64.shiftLeft(bits1, u32.toU64(u32.shiftRight(entry1s1, 16)) & 63)
        p1 = unsafe mem.add(p1, u32.toUsize(u32.shiftRight(entry1s1, 24)))
        let entry2s1 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits2, 53)), 4))
        unsafe mem.w16(p2, 0, u32.wrappingToU16(entry2s1))
        bits2 = u64.shiftLeft(bits2, u32.toU64(u32.shiftRight(entry2s1, 16)) & 63)
        p2 = unsafe mem.add(p2, u32.toUsize(u32.shiftRight(entry2s1, 24)))
        let entry3s1 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits3, 53)), 4))
        unsafe mem.w16(p3, 0, u32.wrappingToU16(entry3s1))
        bits3 = u64.shiftLeft(bits3, u32.toU64(u32.shiftRight(entry3s1, 16)) & 63)
        p3 = unsafe mem.add(p3, u32.toUsize(u32.shiftRight(entry3s1, 24)))
      // Symbol 2 of each stream.
        let entry0s2 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits0, 53)), 4))
        unsafe mem.w16(p0, 0, u32.wrappingToU16(entry0s2))
        bits0 = u64.shiftLeft(bits0, u32.toU64(u32.shiftRight(entry0s2, 16)) & 63)
        p0 = unsafe mem.add(p0, u32.toUsize(u32.shiftRight(entry0s2, 24)))
        let entry1s2 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits1, 53)), 4))
        unsafe mem.w16(p1, 0, u32.wrappingToU16(entry1s2))
        bits1 = u64.shiftLeft(bits1, u32.toU64(u32.shiftRight(entry1s2, 16)) & 63)
        p1 = unsafe mem.add(p1, u32.toUsize(u32.shiftRight(entry1s2, 24)))
        let entry2s2 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits2, 53)), 4))
        unsafe mem.w16(p2, 0, u32.wrappingToU16(entry2s2))
        bits2 = u64.shiftLeft(bits2, u32.toU64(u32.shiftRight(entry2s2, 16)) & 63)
        p2 = unsafe mem.add(p2, u32.toUsize(u32.shiftRight(entry2s2, 24)))
        let entry3s2 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits3, 53)), 4))
        unsafe mem.w16(p3, 0, u32.wrappingToU16(entry3s2))
        bits3 = u64.shiftLeft(bits3, u32.toU64(u32.shiftRight(entry3s2, 16)) & 63)
        p3 = unsafe mem.add(p3, u32.toUsize(u32.shiftRight(entry3s2, 24)))
      // Symbol 3 of each stream.
        let entry0s3 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits0, 53)), 4))
        unsafe mem.w16(p0, 0, u32.wrappingToU16(entry0s3))
        bits0 = u64.shiftLeft(bits0, u32.toU64(u32.shiftRight(entry0s3, 16)) & 63)
        p0 = unsafe mem.add(p0, u32.toUsize(u32.shiftRight(entry0s3, 24)))
        let entry1s3 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits1, 53)), 4))
        unsafe mem.w16(p1, 0, u32.wrappingToU16(entry1s3))
        bits1 = u64.shiftLeft(bits1, u32.toU64(u32.shiftRight(entry1s3, 16)) & 63)
        p1 = unsafe mem.add(p1, u32.toUsize(u32.shiftRight(entry1s3, 24)))
        let entry2s3 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits2, 53)), 4))
        unsafe mem.w16(p2, 0, u32.wrappingToU16(entry2s3))
        bits2 = u64.shiftLeft(bits2, u32.toU64(u32.shiftRight(entry2s3, 16)) & 63)
        p2 = unsafe mem.add(p2, u32.toUsize(u32.shiftRight(entry2s3, 24)))
        let entry3s3 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits3, 53)), 4))
        unsafe mem.w16(p3, 0, u32.wrappingToU16(entry3s3))
        bits3 = u64.shiftLeft(bits3, u32.toU64(u32.shiftRight(entry3s3, 16)) & 63)
        p3 = unsafe mem.add(p3, u32.toUsize(u32.shiftRight(entry3s3, 24)))
      // Symbol 4 of each stream.
        let entry0s4 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits0, 53)), 4))
        unsafe mem.w16(p0, 0, u32.wrappingToU16(entry0s4))
        bits0 = u64.shiftLeft(bits0, u32.toU64(u32.shiftRight(entry0s4, 16)) & 63)
        p0 = unsafe mem.add(p0, u32.toUsize(u32.shiftRight(entry0s4, 24)))
        let entry1s4 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits1, 53)), 4))
        unsafe mem.w16(p1, 0, u32.wrappingToU16(entry1s4))
        bits1 = u64.shiftLeft(bits1, u32.toU64(u32.shiftRight(entry1s4, 16)) & 63)
        p1 = unsafe mem.add(p1, u32.toUsize(u32.shiftRight(entry1s4, 24)))
        let entry2s4 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits2, 53)), 4))
        unsafe mem.w16(p2, 0, u32.wrappingToU16(entry2s4))
        bits2 = u64.shiftLeft(bits2, u32.toU64(u32.shiftRight(entry2s4, 16)) & 63)
        p2 = unsafe mem.add(p2, u32.toUsize(u32.shiftRight(entry2s4, 24)))
        let entry3s4 = unsafe mem.r32(cells, usize.wrappingMultiply(u64.wrappingToUsize(u64.shiftRight(bits3, 53)), 4))
        unsafe mem.w16(p3, 0, u32.wrappingToU16(entry3s4))
        bits3 = u64.shiftLeft(bits3, u32.toU64(u32.shiftRight(entry3s4, 16)) & 63)
        p3 = unsafe mem.add(p3, u32.toUsize(u32.shiftRight(entry3s4, 24)))
      let ctz0 = u64.trailingZeros(bits0)
      q0 = unsafe mem.subc(q0, u32.toUsize(u32.shiftRight(ctz0, 3)))
      bits0 = u64.shiftLeft(unsafe mem.r64(q0, 0) | 1, u32.toU64(ctz0 & 7))
      let ctz1 = u64.trailingZeros(bits1)
      q1 = unsafe mem.subc(q1, u32.toUsize(u32.shiftRight(ctz1, 3)))
      bits1 = u64.shiftLeft(unsafe mem.r64(q1, 0) | 1, u32.toU64(ctz1 & 7))
      let ctz2 = u64.trailingZeros(bits2)
      q2 = unsafe mem.subc(q2, u32.toUsize(u32.shiftRight(ctz2, 3)))
      bits2 = u64.shiftLeft(unsafe mem.r64(q2, 0) | 1, u32.toU64(ctz2 & 7))
      let ctz3 = u64.trailingZeros(bits3)
      q3 = unsafe mem.subc(q3, u32.toUsize(u32.shiftRight(ctz3, 3)))
      bits3 = u64.shiftLeft(unsafe mem.r64(q3, 0) | 1, u32.toU64(ctz3 & 7))
      if mem.addrm(p3) >= mem.addrm(pend) { break }
    }
    op0 = mem.us(mem.addrm(p0), mem.addrm(out))
    op1 = mem.us(mem.addrm(p1), mem.addrm(out))
    op2 = mem.us(mem.addrm(p2), mem.addrm(out))
    op3 = mem.us(mem.addrm(p3), mem.addrm(out))
    ip0 = mem.us(mem.addr(q0), mem.addr(src))
    ip1 = mem.us(mem.addr(q1), mem.addr(src))
    ip2 = mem.us(mem.addr(q2), mem.addr(src))
    ip3 = mem.us(mem.addr(q3), mem.addr(src))
  }
  let mut segmentEnd = start
  let mut stream: u32 = 0
  while stream < 4 {
    if segment <= oend - segmentEnd { segmentEnd = segmentEnd + segment } else { segmentEnd = oend }
    let mut op = op0 let mut ip = ip0 let mut container = bits0 let mut iend = iend0
    if stream == 1 { op = op1 ip = ip1 container = bits1 iend = iend1 }
    if stream == 2 { op = op2 ip = ip2 container = bits2 iend = iend2 }
    if stream == 3 { op = op3 ip = ip3 container = bits3 iend = iend3 }
    if op > segmentEnd { return errors.err(errors.E_CORRUPTION_DETECTED) }
    if ip + 8 < iend { return errors.err(errors.E_CORRUPTION_DETECTED) }
    let mut bits = DStream { container: unsafe mem.r64(src, ip), consumed: u64.trailingZeros(container), ptr: ip, start: ilowest, limit: ilowest + 8, base: src }
    let reached = unsafe streamX2(out, op, segmentEnd, &mut bits, cells, FAST_TABLELOG)
    if reached != segmentEnd { return errors.err(errors.E_CORRUPTION_DETECTED) }
    stream = stream + 1
  }
  return length
}

@inlineAlways
unsafe fn reloadFast(bits: &mut DStream) -> bool {
  if bits.ptr < bits.limit { return false }
  bits.ptr = usize.wrappingSubtract(bits.ptr, u32.toUsize(u32.shiftRight(bits.consumed, 3)))
  bits.consumed = bits.consumed & 7
  bits.container = unsafe mem.r64(bits.base, bits.ptr)
  return true
}

/// Decodes four Huffman streams at `src[at..at+size]` into `out[start..start+length]` with the X2
/// table (`HUF_decompress4X2_usingDTable`). Returns `length`, or an error.
pub unsafe fn decompress4X2(out: [*]mut u8, start: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  static if Target.arch() == Arch.X86_64 {
    if CpuFeatures.available("bmi2") { return unsafe decompress4X2Bmi2(out, start, length, src, at, size, table) }
  }
  return unsafe decompress4X2Body(out, start, length, src, at, size, table)
}

static if Target.arch() == Arch.X86_64 {
  @features("bmi2")
  @inlineNever
  unsafe fn decompress4X2Bmi2(out: [*]mut u8, start: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize { return unsafe decompress4X2Body(out, start, length, src, at, size, table) }
}

@inlineAlways
unsafe fn decompress4X2Body(out: [*]mut u8, start: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  let fast = unsafe decompress4X2Fast(out, start, length, src, at, size, table)
  if fast != 0 { return fast }
  if size < 10 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  if length < 6 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  let cells = unsafe mem.addc(table, 4)
  let log = unsafe tableLog(table)
  let length1 = u16.toUsize(unsafe mem.r16(src, at))
  let length2 = u16.toUsize(unsafe mem.r16(src, at + 2))
  let length3 = u16.toUsize(unsafe mem.r16(src, at + 4))
  let length4 = usize.wrappingSubtract(size, length1 + length2 + length3 + 6)
  let istart1 = at + 6
  let istart2 = istart1 + length1
  let istart3 = istart2 + length2
  let istart4 = istart3 + length3
  let segment = (length + 3) / 4
  let oend = start + length
  let opStart2 = start + segment
  let opStart3 = opStart2 + segment
  let opStart4 = opStart3 + segment
  if length4 > size { return errors.err(errors.E_CORRUPTION_DETECTED) }
  if opStart4 > oend { return errors.err(errors.E_CORRUPTION_DETECTED) }
  let mut bits1 = entropy.emptyDStream(src)
  let mut bits2 = entropy.emptyDStream(src)
  let mut bits3 = entropy.emptyDStream(src)
  let mut bits4 = entropy.emptyDStream(src)
  let r1 = unsafe entropy.initDStream(&mut bits1, src, istart1, length1)
  if errors.isError(r1) { return r1 }
  let r2 = unsafe entropy.initDStream(&mut bits2, src, istart2, length2)
  if errors.isError(r2) { return r2 }
  let r3 = unsafe entropy.initDStream(&mut bits3, src, istart3, length3)
  if errors.isError(r3) { return r3 }
  let r4 = unsafe entropy.initDStream(&mut bits4, src, istart4, length4)
  if errors.isError(r4) { return r4 }
  let mut op1 = start
  let mut op2 = opStart2
  let mut op3 = opStart3
  let mut op4 = opStart4
  if oend - op4 >= 8 {
    let mut endSignal = true
    while endSignal && usize.wrappingAdd(op4, 7) < oend {
      let mut round: u32 = 0
      while round < 4 {
        op1 = usize.wrappingAdd(op1, unsafe symbolX2(out, op1, &mut bits1, cells, log))
        op2 = usize.wrappingAdd(op2, unsafe symbolX2(out, op2, &mut bits2, cells, log))
        op3 = usize.wrappingAdd(op3, unsafe symbolX2(out, op3, &mut bits3, cells, log))
        op4 = usize.wrappingAdd(op4, unsafe symbolX2(out, op4, &mut bits4, cells, log))
        round = round + 1
      }
      let more1 = unsafe reloadFast(&mut bits1)
      let more2 = unsafe reloadFast(&mut bits2)
      let more3 = unsafe reloadFast(&mut bits3)
      let more4 = unsafe reloadFast(&mut bits4)
      endSignal = more1 && more2 && more3 && more4
    }
  }
  if op1 > opStart2 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  if op2 > opStart3 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  if op3 > opStart4 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  let _e1 = unsafe streamX2(out, op1, opStart2, &mut bits1, cells, log)
  let _e2 = unsafe streamX2(out, op2, opStart3, &mut bits2, cells, log)
  let _e3 = unsafe streamX2(out, op3, opStart4, &mut bits3, cells, log)
  let _e4 = unsafe streamX2(out, op4, oend, &mut bits4, cells, log)
  if !(entropy.endOfDStream(&bits1) && entropy.endOfDStream(&bits2) && entropy.endOfDStream(&bits3) && entropy.endOfDStream(&bits4)) {
    return errors.err(errors.E_CORRUPTION_DETECTED)
  }
  return length
}

const ALGO_TIME: [u32; 64] = [
  0, 0, 1, 1, 0, 0, 1, 1, 150, 216, 381, 119, 170, 205, 514, 112,
  177, 199, 539, 110, 197, 194, 644, 107, 221, 192, 735, 107, 256, 189, 881, 106,
  359, 188, 1167, 109, 582, 187, 1570, 114, 688, 187, 1712, 122, 825, 186, 1965, 136,
  976, 185, 2131, 150, 1180, 186, 2070, 175, 1377, 185, 1731, 202, 1412, 185, 1695, 202,
]

/// Returns whether the double-symbol decoder is expected to be the faster one for `dstSize`
/// literals in `srcSize` bytes (`HUF_selectDecoder`).
pub fn selectX2(dstSize: usize, srcSize: usize) -> bool {
  let mut q: usize = 15
  if srcSize < dstSize { q = srcSize * 16 / dstSize }
  let d256 = usize.toU32(dstSize / 256)
  let time0 = ALGO_TIME[q * 4] + ALGO_TIME[q * 4 + 1] * d256
  let mut time1 = ALGO_TIME[q * 4 + 2] + ALGO_TIME[q * 4 + 3] * d256
  time1 = time1 + u32.shiftRight(time1, 5)
  return time1 < time0
}

/// Decodes one stream with the table at `table`, whichever kind it is
/// (`HUF_decompress1X_usingDTable`).
pub unsafe fn decompress1X(out: [*]mut u8, op: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  if unsafe isX2(table) { return unsafe decompress1X2(out, op, length, src, at, size, table) }
  return unsafe decompress1X1(out, op, length, src, at, size, table)
}

/// Decodes four streams with the table at `table`, whichever kind it is
/// (`HUF_decompress4X_usingDTable`).
pub unsafe fn decompress4X(out: [*]mut u8, start: usize, length: usize, src: [*]const u8, at: usize, size: usize, table: [*]const u8) -> usize {
  if unsafe isX2(table) { return unsafe decompress4X2(out, start, length, src, at, size, table) }
  return unsafe decompress4X1(out, start, length, src, at, size, table)
}

/// Reads the table description at `src[at..at+size]` into `table` and decodes the four streams
/// after it, with the decoder that [`selectX2`] picks (`HUF_decompress4X_hufOnly_wksp`).
pub unsafe fn decompress4XWithTable(table: [*]mut u8, out: [*]mut u8, start: usize, length: usize, src: [*]const u8, at: usize, size: usize) -> usize {
  if length == 0 { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
  if size == 0 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  let double = selectX2(length, size)
  let mut headerSize: usize = 0
  if double { headerSize = unsafe readTableX2(table, src, at, size) } else { headerSize = unsafe readTableX1(table, src, at, size) }
  if errors.isError(headerSize) { return headerSize }
  if headerSize >= size { return errors.err(errors.E_SRCSIZE_WRONG) }
  if double { return unsafe decompress4X2(out, start, length, src, at + headerSize, size - headerSize, unsafe mem.ro(table)) }
  return unsafe decompress4X1(out, start, length, src, at + headerSize, size - headerSize, unsafe mem.ro(table))
}
