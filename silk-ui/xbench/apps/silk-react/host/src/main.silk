//! The xbench React scenes on Silk UI: the Vite build of ../react/web (app.js and app.sheet,
//! copied beside this file's package by build.sh) in a 1040 x 720 window, as silkui's own
//! release builds start a React app.
import silk.build.source { Source }
import silkui_window.js { Natives }
import silkui_window.js { Settings, TitleBar, releaseWithSheets as release }
import silk.system.host_input { HostInput }

pub effect fn main() -> i32 ? &mut HostInput {
  return run release(Settings { title: "xbench", width: 1040.0, height: 720.0, titleBar: TitleBar.Transparent, titleBarHeight: 40.0, controlsLeft: 14.0, controlsTop: 12.0, natives: Natives.off() }, Source.read("app.js"), &[Source.read("app.sheet")])
}
