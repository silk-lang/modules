//! Array.prototype every, some, forEach, map, filter, reduce and reduceRight
//! (quickjs.c:43511-43756) called from bytecode, run as a small loop of bytecode
//! in the caller's dispatch loop. The callback is an ordinary call_method from
//! that loop, so a bytecode callback gets an inline frame (or runs as a leaf)
//! instead of a nested dispatch loop per element.
//!
//! The loop is a frame of the realm's iteration code (ContextState.iterationCode,
//! reduceCode) whose current function is the intrinsic itself, so stack traces,
//! Error.captureStackTrace and the CPU profile show the native as before. Its
//! steps are OP_invalid with a phase byte, which no verified bytecode contains:
//!
//!    0  invalid INIT        validate, length, accumulator, then as NEXT
//!                           (skipping NEXT when there is a call to make)
//!    2  invalid NEXT        take the callback's result, find the next element,
//!                           push the call's operands (or the result, jumping to 9)
//!    4  call_method 3 | 4
//!    7  goto8 -6            to NEXT
//!    9  return
//!   10  invalid LEAF        the same loop for a callback that is a leaf
//!   12  call_method 3 | 4   (js_vm_leaf): INIT sends such a callback here and
//!   15  goto8 -6            runs it in place, element after element (leafCalls);
//!                           LEAF is NEXT and then the same
//!
//! The phase bytes are numbers of one-byte opcodes without operands, so a walk
//! over the code by opcode size (js_gc.destroyBytecode) sees whole instructions.
//!
//! The frame owns its state in locals, so an exception unwinding through it
//! releases everything as for any frame.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u32
import silk.num.i32
import silk.num.i64
import silk.num.usize
import silk.num.f64
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, lendBits }
import js_realm { Realm, lendRealm }
import silk.core.result { Result }
import js_core_types { RuntimeState, ContextState, ObjectData, ObjectPayload, ShapeData, SlotBits, FunctionBytecode, FunctionKind, KnownCall, ByteStorage,
  VarDef, ClosureVar, FunctionDebugInfo, HostEdges, NativeFunctionId, BuiltinFamily,
  JS_MODE_STRICT, JS_PROP_C_W_E, JS_PROP_THROW, JS_PROP_WRITABLE, FrameSlots }
import js_compiler_types { PendingFunction }
import js_debugger_metadata { Metadata as DebuggerMetadata }
import js_gc { HeapHooks }
import js_gc as gc
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_exceptions { JsException }
import js_caught { Failed, failed }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_vm_state { Machine, copyCell, copyCellWhole, cellAt }
import js_vm_activation as activation
import js_vm_leaf as leaves
import js_interrupts as interrupts
import js_scopes as scopes
import js_boxing as boxing
import js_function_invoke as invoke
import js_property_get as properties
import js_property_mutations as mutations
import js_typed_array_methods_array_species as arraySpecies
import js_array_intrinsics_support as arrays
import js_array_intrinsics as arrayIds
import js_object_allocate as allocate
import js_primitives as primitives
import js_atom_data as atoms
import js_intl_realm as ops
import js_proxy_core as core
import js_class_data as classes
import js_opcode_data as op
import js_debugger_restricted as restricted
import thin_list { BoxList, ThinBox }

// Method numbers, as js_typed_array_methods_iteration's (Array method - EVERY).
const EVERY: u32 = 0
const SOME: u32 = 1
const FOR_EACH: u32 = 2
const MAP: u32 = 3
const FILTER: u32 = 4
const REDUCE: u32 = 5
const REDUCE_RIGHT: u32 = 6

/// The phase byte after OP_invalid.
const INIT: u8 = 0
const NEXT: u8 = 6
const LEAF: u8 = 7
/// Where NEXT jumps once the loop is over: the return.
const RETURN_PC: usize = 9
/// From the plain loop's call to the leaf loop's.
const LEAF_LOOP: usize = 8
/// And back.
const PLAIN_LOOP: i32 = -8

// The frame's locals.
const LOCAL_OBJECT: usize = 0
const LOCAL_LENGTH: usize = 1
const LOCAL_POSITION: usize = 2
const LOCAL_ACCUMULATOR: usize = 3
const LOCAL_SELECTED: usize = 4
const LOCAL_INDEX: usize = 5
const LOCAL_ELEMENT: usize = 6
const LOCAL_METHOD: usize = 7
const LOCALS: u16 = 8
/// The reduce call's operands: receiver, callback, accumulator, element, index, object.
const STACK: u16 = 6

/// The iteration method of function, when it is one of the seven intrinsic
/// Array.prototype callback methods this file runs; u32.MAX else.
@inlineAlways
pub unsafe fn methodOf(function: ValueBits) -> u32 {
  let reference = match function { ValueBits.Object { reference } => reference _ => { return u32.MAX } }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  if object.classId() != classes.JS_CLASS_C_FUNCTION { return u32.MAX }
  return match &object.payload {
    ObjectPayload.NativeFunction { function: native } => match native.function {
      NativeFunctionId.Builtin { family: BuiltinFamily.Array, method } =>
        if method >= arrayIds.EVERY && method <= arrayIds.REDUCE_RIGHT && !native.isDataFunction() { method - arrayIds.EVERY } else { u32.MAX }
      _ => u32.MAX
    }
    _ => u32.MAX
  }
}

/// Whether function may be a callee js_vm's directInline runs inline: a bound
/// function, an Array callback method or a Reflect intrinsic. One class and
/// payload read, cheap enough for every native method call.
@inlineAlways
pub unsafe fn directFamily(function: ValueBits) -> bool {
  let reference = match function { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  let class = object.classId()
  if class == classes.JS_CLASS_BOUND_FUNCTION { return true }
  if class != classes.JS_CLASS_C_FUNCTION { return false }
  return match &object.payload {
    ObjectPayload.NativeFunction { function: native } => match native.function {
      NativeFunctionId.Builtin { family: BuiltinFamily.Array, method } => method >= arrayIds.EVERY && method <= arrayIds.REDUCE_RIGHT
      NativeFunctionId.Builtin { family: BuiltinFamily.Reflect, .. } => true
      _ => false
    }
    _ => false
  }
}
/// Enters the iteration frame for intrinsic function (methodOf gave method)
/// called on receiver with argv (scratch the frame copies when copy), its
/// caller's first call operand at first.
/// Null, with nothing changed, when it cannot: an observed or restricted run,
/// no room in the call-frame region or no memory for the realm's code.
pub unsafe effect fn enter(machine: &mut Machine, function: ValueBits, method: u32, receiver: ValueBits, argv: FrameSlots,
  first: *mut ValueBits, copy: bool) -> ?*mut Machine ? &mut Allocator {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  let observed = state.observeInstructions drop state
  if observed { return Pointer.null<Machine>() }
  // A native callback (arr.map(String)) is called native to native as before:
  // through call_method it would only add the frame.
  if argv.length() != 0 {
    match unsafe argv.get(0) {
      ValueBits.Object { reference } => {
        if (unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)).classId() == classes.JS_CLASS_C_FUNCTION { return Pointer.null<Machine>() }
      }
      _ => ()
    }
  }
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function))
  let realm = match &object.payload {
    ObjectPayload.NativeFunction { function: native } => native.realm()
    _ => Pointer.null<HeapHeader>()
  }
  drop object
  let home = match Pointer.nonNullMut<HeapHeader>(realm) { Option<*mut HeapHeader>.Some { value } => value _ => { return Pointer.null<Machine>() } }
  if restricted.active(unsafe lendRealm(&home, home)) { return Pointer.null<Machine>() }
  let code = run unsafe codeFor(home, method == REDUCE || method == REDUCE_RIGHT)
  let bytecode = match Pointer.nonNullMut<HeapHeader>(code) { Option<*mut HeapHeader>.Some { value } => value _ => { return Pointer.null<Machine>() } }
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  return match unsafe activation.enterIteration(machine.runtime, function, bytecode, argv, first, running, machine.context, receiver, copy) {
    Option<*mut Machine>.Some { value } => {
      let mut calleeAnchor = () let callee = unsafe Pointer.borrowMut<(), Machine>(&mut calleeAnchor, value)
      drop unsafe callee.setLocal(LOCAL_METHOD, ValueBits.Int { value: u32.toI32(method) })
      value
    }
    Option<*mut Machine>.None => Pointer.null<Machine>()
  }
}

/// The realm's iteration code (reducing: the reduce variant, whose call passes
/// four arguments), made on first use; null when there is no memory for it.
unsafe effect fn codeFor(realm: *mut HeapHeader, reducing: bool) -> ?*mut HeapHeader ? &mut Allocator {
  let anchor = ()
  let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)
  let present = if reducing { context.reduceCode } else { context.iterationCode }
  drop context
  if !Pointer.isNull<HeapHeader>(present) { return present }
  let mut count: u8 = 3
  if reducing { count = 4 }
  let bytes = [op.OP_invalid, INIT, op.OP_invalid, NEXT, op.OP_call_method, count, 0, op.OP_goto8, 250, op.OP_return,
    op.OP_invalid, LEAF, op.OP_call_method, count, 0, op.OP_goto8, 250]
  let made = run Effect.result(unsafe allocateCode(realm, &bytes))
  let code = match move made {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => { drop error return Pointer.null<HeapHeader>() }
  }
  let mut contextAnchor = () let owner = unsafe HeapCell.payloadMut<ContextState, ()>(&mut contextAnchor, realm)
  if reducing { owner.reduceCode = code } else { owner.iterationCode = code }
  return code
}
unsafe effect fn allocateCode(realm: *mut HeapHeader, bytes: &[u8]) -> *mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let code = run ByteStorage.copy(bytes)
  let made = run HeapCell.allocate(HeapKind.FunctionBytecode, FunctionBytecode {
    scriptId: 0, scriptIsEval: false,
    debugger: ThinBox<DebuggerMetadata>.none(), host: ThinBox<HostEdges>.none(),
    mode: JS_MODE_STRICT, hasPrototype: false, hasSimpleParameterList: true, isDerivedClassConstructor: false,
    needsHomeObject: false, kind: FunctionKind.Normal, newTargetAllowed: false, superCallAllowed: false,
    superAllowed: false, argumentsAllowed: false, readOnlyBytecode: true, isDirectOrIndirectEval: false,
    code: move code, name: 0, varDefs: BoxList<VarDef>.make(), closureVars: BoxList<ClosureVar>.make(),
    argumentCount: 2, variableCount: LOCALS, definedArgumentCount: 1, stackSize: STACK, varRefCount: 0,
    scopeCaptures: 0, scopeSlots: 0, scopeVarSlots: 0, frameCells: scopes.inlineFrameCells(LOCALS, STACK, 0, 0),
    scopeParameters: BoxList<u32>.make(), scopeVariables: BoxList<u16>.make(), borrowsArguments: false, leaf: 0, constructForm: 0,
    realm: realm, known: KnownCall.none(), constants: BoxList<ValueBits>.make(), debug: Option<FunctionDebugInfo>.none(),
    pending: ThinBox<PendingFunction>.none()
  })
  // The code holds its realm, as compiled code does.
  unsafe HeapCell.retain(realm)
  let anchor = () let runtime = (unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)).runtime
  unsafe gc.publish(runtime, made)
  return made
}

/// OP_invalid in an iteration frame (machine's ip at the phase byte). False when
/// machine runs no iteration frame: the opcode is then invalid as ever.
pub unsafe effect fn step<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine) -> bool ! JsException ? &mut Allocator {
  if !unsafe running(&machine) { return false }
  let method = match unsafe machine.local(LOCAL_METHOD) { ValueBits.Int { value } => i32.toU32(value) _ => { return false } }
  if unsafe machine.peekU8(0) == LEAF && unsafe leafCalls(&mut hooks, &mut machine, method, true) { return true }
  let context = machine.context
  while true {
    let phase = unsafe machine.readU8()
    unsafe machine.publishPc()
    let advanced = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(
      unsafe advance(&mut hooks, memory, &mut machine, method, phase == INIT), failed)
    match move advanced {
      bool done => {
        if done { return true }
        // INIT found an element: on to its call, past NEXT. A leaf callback's is
        // the leaf loop's call. At that call, here or after LEAF, the leaf calls
        // start; should they end at the phase byte (an element or a result NEXT
        // has no fast path for), that step is taken here and they go on.
        let mut leaf = phase == LEAF
        if phase == INIT {
          unsafe machine.skip(2)
          if unsafe callsLeaf(&machine, method) { unsafe machine.skip(LEAF_LOOP) leaf = true }
        }
        if !leaf || unsafe leafCalls(&mut hooks, &mut machine, method, false) { return true }
      }
      Failed { error } => {
        let _thrown = run Effect.catch<JsException>(ops.materialize(&mut hooks, unsafe lendRealm(&context, context), move error), core.exceptionValue)
        fail JsException {}
      }
    }
  }
  return true
}
/// The executeLoop arm's first try, before step: NEXT for all seven Array
/// callback methods over a fast Array (including loop completion and early
/// exit for every/some), with no failure frame or publishPc.
@inlineNever
pub unsafe fn quick<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool {
  if !unsafe running(&machine) { return false }
  let method = match unsafe machine.local(LOCAL_METHOD) { ValueBits.Int { value } => i32.toU32(value) _ => { return false } }
  if unsafe machine.peekU8(0) != NEXT { return false }
  return unsafe nextFast(&mut hooks, &mut machine, method)
}
/// How many arguments the loop's call passes.
@inlineAlways
fn passed(method: u32) -> usize {
  if method == REDUCE || method == REDUCE_RIGHT { return 4 }
  return 3
}
/// Whether the machine is at the loop's call and the callback is a bytecode
/// function with leaf credit (js_vm_leaf.runsLeaf).
@inlineAlways
unsafe fn callsLeaf(machine: &Machine, method: u32) -> bool {
  if unsafe machine.peekU8(0) != op.OP_call_method { return false }
  let count = passed(method)
  let reference = match unsafe machine.top(count + 1) { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  return match &object.payload {
    ObjectPayload.BytecodeFunction { function: closure } => object.classId() == classes.JS_CLASS_BYTECODE_FUNCTION && unsafe leaves.runsLeaf(closure.bytecode, count)
    _ => false
  }
}
/// The leaf loop: the callback run right here as a leaf (js_vm_leaf) and the
/// NEXT after it, element after element, with no trip through dispatch for the
/// call, the jump back and the step. The machine is at the leaf loop's call with
/// its operands pushed, or with next at LEAF's phase byte, which starts with the
/// NEXT. True leaves the machine at a call with its operands pushed, or
/// finished. False as quick's false: at the phase byte, for step.
///
/// A leaf cannot loop, so the call site does not charge it to the interrupt
/// counter; the loop's backward jump does. Here each element is charged as that
/// jump, and the element whose poll is due is left to the dispatch loop, which
/// comes back through LEAF. Nothing runs here while instructions are observed. A
/// callback that stopped being a leaf goes to the plain loop's call, and stays
/// in that loop.
///
/// Its own loop and phase, not a part of quick: quick is at the limit of what
/// fits in registers, and one more value kept across its NEXT costs every
/// callback about sixteen instructions per element.
@inlineNever
unsafe fn leafCalls<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, method: u32, next: bool) -> bool {
  // map, forEach, filter and reduce, the common ones, each get the loop built for their method
  // alone, with the other methods' tests folded away.
  if method == MAP { return unsafe leafCallsMap(&mut hooks, &mut machine, next) }
  if method == FOR_EACH { return unsafe leafCallsForEach(&mut hooks, &mut machine, next) }
  if method == FILTER { return unsafe leafCallsFilter(&mut hooks, &mut machine, next) }
  if method == REDUCE { return unsafe leafCallsReduce(&mut hooks, &mut machine, next) }
  return unsafe leafCallsFor(&mut hooks, &mut machine, method, next)
}
@inlineNever
unsafe fn leafCallsMap<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, next: bool) -> bool {
  return unsafe leafCallsFor(&mut hooks, &mut machine, MAP, next)
}
@inlineNever
unsafe fn leafCallsForEach<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, next: bool) -> bool {
  return unsafe leafCallsFor(&mut hooks, &mut machine, FOR_EACH, next)
}
@inlineNever
unsafe fn leafCallsFilter<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, next: bool) -> bool {
  return unsafe leafCallsFor(&mut hooks, &mut machine, FILTER, next)
}
@inlineNever
unsafe fn leafCallsReduce<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, next: bool) -> bool {
  return unsafe leafCallsFor(&mut hooks, &mut machine, REDUCE, next)
}
@inlineAlways
unsafe fn leafCallsFor<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, method: u32, next: bool) -> bool {
  let flagAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&flagAnchor, machine.runtime)
  let observed = state.observeInstructions
  drop state
  if observed { return !next }
  let counter = unsafe interrupts.counter(machine.context)
  let count = passed(method)
  let mut pending = next
  while true {
    if pending && (method == MAP || method == FOR_EACH || method == FILTER) && unsafe leafRun(&mut hooks, &mut machine, method) { return true }
    if pending && !unsafe nextFast(&mut hooks, &mut machine, method) { return false }
    pending = true
    if !unsafe callsLeaf(&machine, method) {
      if unsafe machine.peekU8(0) == op.OP_call_method { unsafe machine.jump(PLAIN_LOOP, 0) }
      return true
    }
    let left = unsafe Pointer.read<i32>(counter)
    if left <= 1 { return true }
    let function = unsafe machine.top(count + 1)
    let first = unsafe machine.topCell(count + 2)
    let callee = unsafe activation.calleeOf(function)
    if !unsafe leaves.attempt(&mut hooks, Pointer.fromMutRef<Machine>(&mut machine), function, callee.bytecode,
      FrameSlots { data: unsafe machine.topCell(count), count: count }, first, first) { return true }
    unsafe Pointer.write<i32>(counter, left - 1)
    // As after the call and the jump back: at the phase byte, the result on top.
    unsafe machine.jump(-1, 0)
  }
  return true
}
/// leafCallsFor's loop for map, forEach and filter over a fast Array, from
/// LEAF's phase byte with the previous call's result on top: each element's
/// leaf run reads the element, its index and the array where they are,
/// borrowed, and writes its result to a cell of its own, so no call operands
/// are pushed, retained or released per element. Each step is NEXT's
/// (nextFast's checks, then its commit) followed by the leaf run.
/// True with the machine at the leaf loop's call and its operands pushed, as
/// nextFast leaves it, when a run declined: the call is then made as ever.
/// False with the machine at the phase byte and a result on top, for
/// nextFast: the loop is done, a step needs NEXT's slow path, the callback
/// stopped being a leaf, or an interrupt poll is due.
@inlineNever
unsafe fn leafRun<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, method: u32) -> bool {
  let function = unsafe machine.argument(0)
  let code = match function {
    ValueBits.Object { reference } => {
      let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      if data.classId() != classes.JS_CLASS_BYTECODE_FUNCTION { return false }
      match &data.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { return false } }
    }
    _ => { return false }
  }
  let object = unsafe machine.local(LOCAL_OBJECT)
  let source = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let target = unsafe machine.local(LOCAL_ACCUMULATOR)
  let length = number(unsafe machine.local(LOCAL_LENGTH))
  let counter = unsafe interrupts.counter(machine.context)
  let runtime = machine.runtime
  let receiver = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(machine.arguments), 1)
  // The run completes into result: a caller whose operands end where they start.
  let mut result = ValueBits.Undefined
  let resultCell = Pointer.fromMutRef<ValueBits>(&mut result)
  let mut standin = machine.*
  standin.stackTop = resultCell
  let mut argv: [ValueBits; 3] = [ValueBits.Undefined; 3]
  argv[2] = object
  let arguments = Pointer.fromMutRef<ValueBits>(&mut argv[0])
  // After the first run the previous result stays in result, not on the
  // machine's stack: a completed run writes it word by word, and pushing it
  // to be popped at once would reload it whole (a store-forwarding stall).
  // Every exit puts it back where NEXT expects it.
  let mut held = false
  while true {
    let position = number(unsafe machine.local(LOCAL_POSITION))
    if position >= length || position < 0 { return unsafe declineHeld(&mut machine, held, resultCell) }
    let left = unsafe Pointer.read<i32>(counter)
    if left <= 1 || !unsafe leaves.runsLeaf(code, 3) { return unsafe declineHeld(&mut machine, held, resultCell) }
    let anchor = ()
    let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, source)
    if data.classId() != classes.JS_CLASS_ARRAY || !data.fastArray() { return unsafe declineHeld(&mut machine, held, resultCell) }
    let at = i64.toUsize(position)
    let slot = match &data.payload {
      ObjectPayload.FastArray { array } => {
        if at >= array.values().length() { return unsafe declineHeld(&mut machine, held, resultCell) }
        unsafe Pointer.at<ValueBits>(unsafe array.values().dataConst(), at)
      }
      _ => { return unsafe declineHeld(&mut machine, held, resultCell) }
    }
    let element = unsafe Pointer.read<ValueBits>(slot)
    drop data
    // NEXT's checks for the previous result, before anything changes.
    let mut prevIndex: i64 = 0
    let mut selected: i64 = 0
    let mut accepted = false
    if method == MAP {
      prevIndex = number(unsafe machine.local(LOCAL_INDEX))
      if !unsafe canAppendFast(target, prevIndex) { return unsafe declineHeld(&mut machine, held, resultCell) }
    } else if method == FILTER {
      let topVal = if held { result } else { unsafe machine.top(1) }
      let truth: i32 = match topVal {
        ValueBits.Bool { value: flag } => if flag { 1 } else { 0 }
        ValueBits.Int { value: num } => if num != 0 { 1 } else { 0 }
        ValueBits.Undefined => 0
        ValueBits.Null => 0
        _ => unsafe toBooleanCold(topVal)
      }
      if truth < 0 { return unsafe declineHeld(&mut machine, held, resultCell) }
      accepted = truth > 0
      if accepted {
        selected = number(unsafe machine.local(LOCAL_SELECTED))
        if !unsafe canAppendFast(target, selected) { return unsafe declineHeld(&mut machine, held, resultCell) }
      }
    }
    // NEXT's commit: the previous result is taken, the position advanced.
    if method == MAP {
      // Word by word from the cell the run wrote, never reloaded whole.
      if held { unsafe appendCellInPlace(target, prevIndex, resultCell) }
      else { unsafe appendFastInPlace(target, prevIndex, unsafe machine.pop()) }
      held = false
    } else {
      let previous = if held { result } else { unsafe machine.pop() }
      held = false
      if method == FOR_EACH {
      unsafe gc.releaseValueCold(&mut hooks, runtime, previous)
      } else {
        unsafe gc.releaseValueCold(&mut hooks, runtime, previous)
        let kept = unsafe machine.setLocal(LOCAL_ELEMENT, ValueBits.Undefined)
        if accepted {
          unsafe appendFastInPlace(target, selected, kept)
          drop unsafe machine.setLocal(LOCAL_SELECTED, smallIndexValue(selected + 1))
        } else {
          unsafe gc.releaseValueCold(&mut hooks, runtime, kept)
        }
      }
    }
    let indexValue = smallIndexValue(position)
    drop unsafe machine.setLocal(LOCAL_POSITION, smallIndexValue(position + 1))
    drop unsafe machine.setLocal(LOCAL_INDEX, indexValue)
    if method == FILTER { drop unsafe machine.setLocal(LOCAL_ELEMENT, unsafe element.retained()) }
    // Whole: the run's get_arg0 loads the cell whole, which two 8-byte stores would stall.
    unsafe copyCellWhole(unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(slot), arguments)
    argv[1] = indexValue
    // A completed run leaves its result above resultCell: start each one empty.
    standin.stackTop = resultCell
    if !unsafe leaves.attemptSplit(&mut hooks, Pointer.fromMutRef<Machine>(&mut standin), function, code,
      FrameSlots { data: arguments, count: 3 }, resultCell, receiver) {
      // As nextFast leaves it: the call's operands pushed, at the call.
      unsafe machine.push(unsafe (unsafe Pointer.read<ValueBits>(receiver)).retained())
      unsafe machine.push(unsafe function.retained())
      unsafe machine.push(unsafe element.retained())
      unsafe machine.push(indexValue)
      unsafe machine.push(unsafe object.retained())
      unsafe machine.skip(1)
      return true
    }
    unsafe Pointer.write<i32>(counter, left - 1)
    held = true
  }
  return false
}
/// leafRun's exit before NEXT's commit: a held previous result goes back on
/// the machine's stack, copied word by word as the run wrote it. Always false.
@inlineAlways
unsafe fn declineHeld(machine: &mut Machine, held: bool, resultCell: *mut ValueBits) -> bool {
  if held {
    unsafe copyCell(resultCell, machine.stackTop)
    machine.stackTop = unsafe cellAt(machine.stackTop, 1)
  }
  return false
}
/// Whether target is a fast extensible Array with writable length == expected
/// and spare capacity for one more element without reallocation.
@inlineAlways
unsafe fn canAppendFast(target: ValueBits, expected: i64) -> bool {
  if expected < 0 || expected >= 2147483647 { return false }
  let reference = match target { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  if data.classId() != classes.JS_CLASS_ARRAY || !data.fastArray() || !data.extensible() { return false }
  let lenOk = match (unsafe data.slotUnchecked(0)).valueBits() {
    ValueBits.Int { value } => i32.toI64(value) == expected
    _ => false
  }
  if !lenOk { return false }
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  let writable = (u8.toU32((unsafe shape.properties.getUnchecked(0)).flags) & JS_PROP_WRITABLE) != 0
  drop shape
  if !writable { return false }
  return match &data.payload {
    ObjectPayload.FastArray { array } => {
      let count = array.values().length()
      count == i64.toUsize(expected) && count < array.values().capacity()
    }
    _ => false
  }
}
/// Appends value (owned) to target, previously verified by canAppendFast.
@inlineAlways
unsafe fn appendFastInPlace(target: ValueBits, expected: i64, value: ValueBits) -> () {
  let reference = match target { ValueBits.Object { reference } => reference _ => { return () } }
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference)
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      let out = unsafe array.valuesMut().spareFor(1)
      unsafe Pointer.put<ValueBits>(unsafe Pointer.atMut<ValueBits>(out, 0), value)
      unsafe array.valuesMut().extendFilled(1)
    }
    _ => ()
  }
  unsafe data.setSlotUnchecked(0, SlotBits.value(ValueBits.Int { value: i64.toI32(expected + 1) }))
}
/// appendFastInPlace of the value in cell, an owned result, copied word by word.
@inlineAlways
unsafe fn appendCellInPlace(target: ValueBits, expected: i64, cell: *mut ValueBits) -> () {
  let reference = match target { ValueBits.Object { reference } => reference _ => { return () } }
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, reference)
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      let out = unsafe array.valuesMut().spareFor(1)
      unsafe copyCell(cell, unsafe Pointer.atMut<ValueBits>(out, 0))
      unsafe array.valuesMut().extendFilled(1)
    }
    _ => ()
  }
  unsafe data.setSlotUnchecked(0, SlotBits.value(ValueBits.Int { value: i64.toI32(expected + 1) }))
}
@inlineAlways
fn smallIndexValue(n: i64) -> ValueBits {
  if n >= 0 && n <= 2147483647 { return ValueBits.Int { value: i64.toI32(n) } }
  return ValueBits.number(i64.toF64(n))
}
@cold
unsafe fn toBooleanCold(value: ValueBits) -> i32 {
  return unsafe primitives.toBoolean(value)
}
/// NEXT for all seven iteration methods when the target (if any) has spare
/// capacity and the next element sits in a fast Array (or the loop is done).
/// Checks every precondition before mutating state; false leaves machine intact.
@inlineAlways
unsafe fn nextFast<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, method: u32) -> bool {
  let object = unsafe machine.local(LOCAL_OBJECT)
  let length = number(unsafe machine.local(LOCAL_LENGTH))
  let position = number(unsafe machine.local(LOCAL_POSITION))
  let done = position >= length
  let mut nextIndex: i64 = 0
  let mut nextElement = ValueBits.Undefined
  if !done {
    nextIndex = if method == REDUCE_RIGHT { length - position - 1 } else { position }
    if nextIndex < 0 { return false }
    let objRef = match object { ValueBits.Object { reference } => reference _ => { return false } }
    let anchor = ()
    let objData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, objRef)
    if objData.classId() != classes.JS_CLASS_ARRAY || !objData.fastArray() { return false }
    let idx = i64.toUsize(nextIndex)
    let found = match &objData.payload {
      ObjectPayload.FastArray { array } => {
        let count = array.values().length()
        if idx >= count { ValueBits.Uninitialized } else { unsafe Pointer.read<ValueBits>(unsafe Pointer.at<ValueBits>(unsafe array.values().dataConst(), idx)) }
      }
      _ => ValueBits.Uninitialized
    }
    drop objData
    if let ValueBits.Uninitialized = found { return false }
    nextElement = found
  }
  let mut prevIndex: i64 = 0
  let mut selected: i64 = 0
  let mut accepted = false
  if method == MAP {
    prevIndex = number(unsafe machine.local(LOCAL_INDEX))
    if done && prevIndex + 1 != length { return false }
    if !unsafe canAppendFast(unsafe machine.local(LOCAL_ACCUMULATOR), prevIndex) { return false }
  } else if method == EVERY || method == SOME || method == FILTER {
    let topVal = unsafe machine.top(1)
    if let ValueBits.Bool { value: flag } = topVal {
      accepted = flag
    } else if let ValueBits.Int { value: num } = topVal {
      accepted = num != 0
    } else if let ValueBits.Undefined = topVal {
      accepted = false
    } else if let ValueBits.Null = topVal {
      accepted = false
    } else {
      let truth = unsafe toBooleanCold(topVal)
      if truth < 0 { return false }
      accepted = truth > 0
    }
    if method == FILTER && accepted {
      selected = number(unsafe machine.local(LOCAL_SELECTED))
      if !unsafe canAppendFast(unsafe machine.local(LOCAL_ACCUMULATOR), selected) { return false }
    }
  }
  // All preconditions met: consume the callback result and advance or finish.
  let result = unsafe machine.pop()
  let runtime = machine.runtime
  if method == FOR_EACH {
    unsafe gc.releaseValueCold(&mut hooks, runtime, result)
  } else if method == REDUCE || method == REDUCE_RIGHT {
    let prev = unsafe machine.setLocal(LOCAL_ACCUMULATOR, result)
    unsafe gc.releaseValueCold(&mut hooks, runtime, prev)
  } else if method == MAP {
    unsafe appendFastInPlace(unsafe machine.local(LOCAL_ACCUMULATOR), prevIndex, result)
  } else if method == EVERY {
    unsafe gc.releaseValueCold(&mut hooks, runtime, result)
    if !accepted {
      drop unsafe finish(&mut machine, ValueBits.Bool { value: false })
      return true
    }
  } else if method == SOME {
    unsafe gc.releaseValueCold(&mut hooks, runtime, result)
    if accepted {
      drop unsafe finish(&mut machine, ValueBits.Bool { value: true })
      return true
    }
  } else if method == FILTER {
    unsafe gc.releaseValueCold(&mut hooks, runtime, result)
    let element = unsafe machine.setLocal(LOCAL_ELEMENT, ValueBits.Undefined)
    if accepted {
      unsafe appendFastInPlace(unsafe machine.local(LOCAL_ACCUMULATOR), selected, element)
      drop unsafe machine.setLocal(LOCAL_SELECTED, smallIndexValue(selected + 1))
    } else {
      unsafe gc.releaseValueCold(&mut hooks, runtime, element)
    }
  }
  if done {
    drop unsafe machine.setLocal(LOCAL_POSITION, smallIndexValue(position))
    let accumulator = unsafe machine.setLocal(LOCAL_ACCUMULATOR, ValueBits.Undefined)
    drop unsafe finish(&mut machine, accumulator)
    return true
  }
  // Retain nextElement now (all preconditions passed, and appendFastInPlace only
  // writes to accumulator, never to object's elements).
  let bits = unsafe nextElement.retained()
  let callback = unsafe (unsafe machine.argument(0)).retained()
  let indexValue = smallIndexValue(nextIndex)
  drop unsafe machine.setLocal(LOCAL_POSITION, smallIndexValue(position + 1))
  drop unsafe machine.setLocal(LOCAL_INDEX, indexValue)
  if method == FILTER {
    drop unsafe machine.setLocal(LOCAL_ELEMENT, unsafe bits.retained())
  }
  let top = unsafe Pointer.assumeManyMut<ValueBits>(machine.stackTop)
  if method == REDUCE || method == REDUCE_RIGHT {
    let accumulator = unsafe (unsafe machine.local(LOCAL_ACCUMULATOR)).retained()
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 0), ValueBits.Undefined)
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 1), callback)
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 2), accumulator)
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 3), bits)
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 4), indexValue)
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 5), unsafe object.retained())
    machine.stackTop = unsafe Pointer.atMut<ValueBits>(top, 6)
  } else {
    let thisArg = unsafe (unsafe machine.argument(1)).retained()
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 0), thisArg)
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 1), callback)
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 2), bits)
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 3), indexValue)
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(top, 4), unsafe object.retained())
    machine.stackTop = unsafe Pointer.atMut<ValueBits>(top, 5)
  }
  unsafe machine.skip(1)
  return true
}
/// Whether machine's code is its realm's iteration code.
unsafe fn running(machine: &Machine) -> bool {
  let anchor = () let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  let address = Pointer.address<HeapHeader>(machine.bytecode)
  return address == Pointer.address<HeapHeader>(context.iterationCode) || address == Pointer.address<HeapHeader>(context.reduceCode)
}

unsafe effect fn advance<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine, method: u32, init: bool) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let context = machine.context
  let realm = unsafe lendRealm(&context, context)
  let reducing = method == REDUCE || method == REDUCE_RIGHT
  if init {
    let receiver = machine.thisValue
    let owned = run boxing.toObjectValue(&mut hooks, memory, realm, unsafe lendBits(&receiver, receiver))
    drop unsafe machine.setLocal(LOCAL_OBJECT, owned.intoBits())
    let object = unsafe machine.local(LOCAL_OBJECT)
    let mut length: i64 = 0
    run invoke.getLength64(&mut hooks, realm, &mut length, unsafe lendBits(&object, object))
    drop unsafe machine.setLocal(LOCAL_LENGTH, ValueBits.number(i64.toF64(length)))
    let callback = unsafe machine.argument(0)
    if !hooks.isCallable(realm, unsafe lendBits(&callback, callback)) { return run ops.error(&mut hooks, realm, b"not a function") }
    let mut position: i64 = 0
    let mut accumulator = ValueBits.Undefined
    // map: 1 when the result is an array of this loop's own making, whose length
    // the loop sets at the end. (filter counts its selected elements here.)
    let mut presized: i32 = 0
    if method == EVERY { accumulator = ValueBits.Bool { value: true } }
    if method == SOME { accumulator = ValueBits.Bool { value: false } }
    if method == MAP {
      let constructor = run arraySpecies.getConstructor(&mut hooks, memory, realm, unsafe lendBits(&object, object))
      // A dense source of any length gets its result's room at once: every element
      // is appended. A longer source that is not dense (a sparse array may claim
      // any length) takes the species path's array, which stores by index.
      if core.undefined(constructor.view()) && (length <= 65536 || arrays.fastCount(unsafe lendBits(&object, object)) == length) {
        // Keep the fresh result array dense/fast while filling sequentially;
        // trailing holes (if any) set its final length at loop completion.
        accumulator = run allocate.arrayWithCapacity(&mut hooks, memory, realm, i64.toUsize(length))
        presized = 1
      } else {
        accumulator = (run arraySpecies.createFromConstructor(&mut hooks, memory, realm, constructor.borrow(), length)).intoBits()
      }
    }
    if method == FILTER {
      let constructor = run arraySpecies.getConstructor(&mut hooks, memory, realm, unsafe lendBits(&object, object))
      if core.undefined(constructor.view()) {
        let cap: usize = if length <= 8 { i64.toUsize(length) } else { 8 }
        accumulator = run allocate.arrayWithCapacity(&mut hooks, memory, realm, cap)
      } else {
        accumulator = (run arraySpecies.createFromConstructor(&mut hooks, memory, realm, constructor.borrow(), 0)).intoBits()
      }
    }
    if reducing {
      if unsafe activation.argumentCountOf(&machine) > 1 { accumulator = unsafe (unsafe machine.argument(1)).retained() }
      else { accumulator = (run initial(&mut hooks, realm, object, method, length, &mut position)).intoBits() }
    }
    drop unsafe machine.setLocal(LOCAL_ACCUMULATOR, accumulator)
    drop unsafe machine.setLocal(LOCAL_POSITION, ValueBits.number(i64.toF64(position)))
    drop unsafe machine.setLocal(LOCAL_SELECTED, ValueBits.Int { value: presized })
  } else {
    // The callback's result.
    let result = unsafe Value.adoptBits(unsafe machine.pop())
    let index = unsafe machine.local(LOCAL_INDEX)
    if reducing {
      unsafe gc.release(&mut hooks, machine.runtime, unsafe machine.setLocal(LOCAL_ACCUMULATOR, result.intoBits()))
    } else if method == MAP {
      let target = unsafe machine.local(LOCAL_ACCUMULATOR)
      let _defined = run mutations.definePropertyValueInt64(&mut hooks, realm, unsafe lendBits(&target, target), number(index), move result, JS_PROP_C_W_E | JS_PROP_THROW)
    } else if method != FOR_EACH {
      let accepted = core.toBoolFree(&mut hooks, realm, move result)
      if method == EVERY && !accepted { return unsafe finish(&mut machine, ValueBits.Bool { value: false }) }
      if method == SOME && accepted { return unsafe finish(&mut machine, ValueBits.Bool { value: true }) }
      if method == FILTER {
        let element = unsafe Value.adoptBits(unsafe machine.setLocal(LOCAL_ELEMENT, ValueBits.Undefined))
        if accepted {
          let selected = number(unsafe machine.local(LOCAL_SELECTED))
          let target = unsafe machine.local(LOCAL_ACCUMULATOR)
          let _appended = run mutations.definePropertyValueInt64(&mut hooks, realm, unsafe lendBits(&target, target), selected, move element, JS_PROP_C_W_E | JS_PROP_THROW)
          drop unsafe machine.setLocal(LOCAL_SELECTED, ValueBits.number(i64.toF64(selected + 1)))
        }
      }
    }
  }
  let object = unsafe machine.local(LOCAL_OBJECT)
  let length = number(unsafe machine.local(LOCAL_LENGTH))
  let mut position = number(unsafe machine.local(LOCAL_POSITION))
  while position < length {
    let mut index = position
    if method == REDUCE_RIGHT { index = length - position - 1 }
    position = position + 1
    let mut bits = ValueBits.Undefined
    // A fast Array's elements are plain data slots; the callback may shrink it,
    // so the bound is read again for every element.
    if index < arrays.fastCount(unsafe lendBits(&object, object)) { bits = arrays.fastGet(unsafe lendBits(&object, object), index).intoBits() }
    else {
      drop unsafe machine.setLocal(LOCAL_POSITION, ValueBits.number(i64.toF64(position)))
      if !run properties.tryGetPropertyInt64(&mut hooks, realm, unsafe lendBits(&object, object), index, &mut bits) { continue }
    }
    drop unsafe machine.setLocal(LOCAL_POSITION, ValueBits.number(i64.toF64(position)))
    let indexValue = ValueBits.number(i64.toF64(index))
    drop unsafe machine.setLocal(LOCAL_INDEX, indexValue)
    if method == FILTER { drop unsafe machine.setLocal(LOCAL_ELEMENT, unsafe bits.retained()) }
    // call_method's operands: receiver, callback, then the arguments.
    let callback = unsafe (unsafe machine.argument(0)).retained()
    if reducing {
      let accumulator = unsafe (unsafe machine.local(LOCAL_ACCUMULATOR)).retained()
      unsafe machine.push(ValueBits.Undefined)
      unsafe machine.push(callback)
      unsafe machine.push(accumulator)
    } else {
      let thisArg = unsafe (unsafe machine.argument(1)).retained()
      unsafe machine.push(thisArg)
      unsafe machine.push(callback)
    }
    unsafe machine.push(bits)
    unsafe machine.push(indexValue)
    unsafe machine.push(unsafe object.retained())
    return false
  }
  drop unsafe machine.setLocal(LOCAL_POSITION, ValueBits.number(i64.toF64(position)))
  // Only the loop's own array: one a species constructor made keeps the length
  // its elements gave it.
  if method == MAP && length > 0 && number(unsafe machine.local(LOCAL_SELECTED)) == 1 {
    let target = unsafe machine.local(LOCAL_ACCUMULATOR)
    if let ValueBits.Object { reference } = target {
      let anchor = ()
      let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      let needsLength = data.classId() == classes.JS_CLASS_ARRAY && match (unsafe data.slotUnchecked(0)).valueBits() {
        ValueBits.Int { value } => i32.toI64(value) < length
        _ => false
      }
      drop data
      if needsLength {
        let _written = run mutations.setProperty(&mut hooks, realm, unsafe lendBits(&target, target), atoms.JS_ATOM_length, unsafe Value.adoptBits(ValueBits.number(i64.toF64(length))))
      }
    }
  }
  let accumulator = unsafe machine.setLocal(LOCAL_ACCUMULATOR, ValueBits.Undefined)
  return unsafe finish(&mut machine, accumulator)
}
/// Ends the loop with result (owned): pushed for the return at RETURN_PC.
unsafe fn finish(machine: &mut Machine, result: ValueBits) -> bool {
  unsafe machine.push(result)
  unsafe machine.setPc(RETURN_PC)
  return true
}
/// reduce's accumulator when no initial value is given: the first present element.
effect fn initial<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks>(
  hooks: &mut H, realm: Realm<'a>, object: ValueBits, method: u32, length: i64, position: &mut i64) -> Value
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  while true {
    if position.* >= length { return run ops.error(&mut hooks, realm, b"Reduce of empty array with no initial value") }
    let mut first = position.*
    if method == REDUCE_RIGHT { first = length - position.* - 1 }
    position.* = position.* + 1
    let mut found = ValueBits.Undefined
    let present = run properties.tryGetPropertyInt64(&mut hooks, realm, unsafe lendBits(&object, object), first, &mut found)
    let value = unsafe Value.adoptBits(found)
    if present { return move value }
  }
  return Value.immediate(ValueBits.Undefined)
}
/// A length, position or index local: an Int, or a Float64 past 2^31.
fn number(value: ValueBits) -> i64 {
  return match value {
    ValueBits.Int { value: small } => i32.toI64(small)
    ValueBits.Float64 { value: large } => f64.toI64(large)
    _ => 0
  }
}
