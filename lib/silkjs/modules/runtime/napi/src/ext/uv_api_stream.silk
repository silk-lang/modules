  if count > 4 { copy = unsafe malloc(u32.toUsize(count) * 16) }
  if isNull(copy) { unsafe requestDone(unsafe loopOf(udp)) return -ENOMEM }
  let _copied2 = unsafe memcpy(unsafe nn(copy), unsafe Intrinsic.pointerReinterpret<*const Buf, *const u8>(bufs), u32.toUsize(count) * 16)
  unsafe setPtr(request, US_BUFS, copy)
  unsafe set<usize>(udp, U_SEND_QUEUE_SIZE, unsafe get<usize>(udp, U_SEND_QUEUE_SIZE) + unsafe countBufs(unsafe nn(copy), u32.toUsize(count)))
  unsafe set<usize>(udp, U_SEND_QUEUE_COUNT, unsafe get<usize>(udp, U_SEND_QUEUE_COUNT) + 1)
