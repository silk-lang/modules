      let tooMany = s2.maxNiv - 1 > s2.options.maxSettings drop s2
      if tooMany {
        let rv = unsafe terminateSession(sp, ENHANCE_YOUR_CALM, b"SETTINGS: too many setting entries")
        if isFatal(rv) { return rv }
        return 1
      }
      let s3 = unsafe ses(&mut a, sp) s3.minHeaderTable = 4294967295 drop s3
      unsafe setMark(sp, 6)
      return 0
    }
    drop s2
    unsafe setMark(sp, 0)
    return 2
  }
  if kind == PUSH_PROMISE {
    let s2 = unsafe ses(&mut a, sp) s2.hdFlags = u8.bitAnd(s2.hdFlags, u8.bitOr(F_END_HEADERS, F_PADDED)) drop s2
    let pad = unsafe handlePad(sp)
    if pad < 0 {
      let rv2 = unsafe terminateSession(sp, PROTOCOL_ERROR, b"PUSH_PROMISE: insufficient padding space")
      if isFatal(rv2) { return rv2 }
