// Recompilation (docs/jit/doubles.md): a function unlinked for deoptimizing too often is
// reported again, compiled again with the deopt sites widened to numbers, and refused for
// good once that cannot help.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.testing.testing { Testing, AssertionError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_owned_value { Value, ValueRef }
import silkjs.js_realm { Realm, lendRealm }
import silkjs.js_core_types { HostHook, NativeFunctionId, FunctionBytecode }
import silkjs.js_exceptions { JsException }
import silkjs.js_runtime as runtime
import silkjs.js_gc as gc
import silkjs.js_eval as eval
import silkjs.js_intrinsic_install as intrinsics
import silkjs.native_stack as stack
import code_memory { MemoryError }
import asm_x64 { LinkError }
import jit_runtime { Jit, Options }
import jit_runtime as jitRuntime

const HANDLER: u32 = 11

struct Recompiling { pub jit: Jit, pub failures: usize }
impl EngineServices for Recompiling {
  effect fn initializeShadowRealm<'r, 's, 'm>(engine: &mut Engine<'m, Self>, caller: Realm<'r>, created: Realm<'s>) -> () ! JsException ? &mut Allocator {}
  effect fn dynamicImportStarted<'r, 'v, 'w, 'x, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>, specifier: ValueRef<'v>, referrer: ValueRef<'w>, promise: ValueRef<'x>) -> ValueBits ! JsException ? &mut Allocator {
    return promise.dup().intoBits()
  }
  unsafe effect fn hotFunction<'m>(engine: &mut Engine<'m, Self>, rt: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, function: ValueBits) -> () ? &mut Allocator {
    let bytecode = match function { ValueBits.FunctionBytecode { reference } => reference _ => { return () } }
    let compiled = run Effect.result(unsafe jitRuntime.compileHot(&mut engine.services.jit, bytecode))
    match move compiled {
      Result<(), OutOfMemoryError | MemoryError | LinkError>.Success { .. } => ()
      Result<(), OutOfMemoryError | MemoryError | LinkError>.Failure { .. } => { engine.services.failures = engine.services.failures + 1 }
    }
  }
}
/// Evaluates source; the completion value's bits (an Int or Float64 is all these scripts make).
unsafe effect fn evaluate<'m>(engine: &mut Engine<'m, Recompiling>, context: *mut HeapHeader, source: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let memory = engine.memory
  let result = run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"jit.js", 0)
  let bits = Value.intoBits(move result)
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), bits)
  return bits
}
fn isInt(bits: ValueBits, expected: i32) -> bool { return match bits { ValueBits.Int { value } => value == expected _ => false } }
fn isNumber(bits: ValueBits, expected: f64) -> bool {
  return match bits { ValueBits.Float64 { value } => value == expected ValueBits.Int { value } => i32.toF64(value) == expected _ => false }
}
/// What sum(n) below returns, as the interpreter computes it (int32 while it fits, then a double).
fn sumOf(n: i64) -> f64 {
  if n <= 0 { return 0.0 }
  return i64.toF64(n * (n - 1) / 2)
}


unsafe effect fn exercise<'m>(engine: &mut Engine<'m, Recompiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  // v adds 2^30 three times: an int32 add while x is negative enough, an overflow from x = 0.
  drop run unsafe evaluate(&mut engine, context, b"function v(x){var s=x;for(var i=0;i<3;i++)s=s+1073741824;return s}")
  let hot = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<30;k++)t=t+v(k-2147483648);t")
  run Testing.expect(isNumber(hot, 30.0 * 1073741824.0 + 435.0) && engine.services.jit.compiledFunctions == 1, "v is compiled with int32 adds")
  // From x = 0 the third add overflows at every call: 8 deopts at the add unlink v.
  let big = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<8;k++)t=t+v(k);t")
  engine.services.jit.collect()
  run Testing.expect(isNumber(big, 8.0 * 3221225472.0 + 28.0) && engine.services.jit.unlinked == 1, "the overflow unlinks v")
  let deoptsBefore = engine.services.jit.deopts
  // Hot again: reported a second time, recompiled with the add as a double add, and it then
  // runs compiled without deoptimizing, ints and doubles alike.
  let again = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<60;k++)t=t+v(k+(k&1)*0.5);t")
  run Testing.expect(isNumber(again, 60.0 * 3221225472.0 + 1770.0 + 15.0), "results stay the interpreter's")
  run Testing.expect(engine.services.jit.reported == 2 && engine.services.jit.recompiled == 1 && engine.services.jit.compiledFunctions == 2,
    "v is reported again after its unlink and compiled anew")
  engine.services.jit.collect()
  let runsBefore = engine.services.jit.runs
  let steady = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<50;k++)t=t+v(k*0.25);t")
  engine.services.jit.collect()
  run Testing.expect(isNumber(steady, 50.0 * 3221225472.0 + 306.25), "the double add is exact")
  run Testing.expect(engine.services.jit.runs >= runsBefore + 50 && engine.services.jit.deopts == deoptsBefore, "the widened v runs compiled without a deopt")
  // The bound: a non-number fails v's guards at sites already widened. That ends in a refusal,
  // and a refused function is never reported again: no compile loop.
  let odd = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<200;k++)t=t+(v(undefined)!==v(undefined)?1:0);t")
  run Testing.expect(isInt(odd, 200), "NaN results stay the interpreter's")
  run Testing.expect(engine.services.jit.reported == 3 && engine.services.jit.refused == 1, "deopting where already widened ends the reports")
  let more = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<100;k++)t=t+(v(undefined)!==v(undefined)?1:0);t")
  run Testing.expect(isInt(more, 100) && engine.services.jit.reported == 3, "no further report")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}
test effect fn unlinkedFunctionsAreRecompiledOnce() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut options = Options.make()
  // This test is about learning from deopts: no recording before the first compilation.
  options.enabled = true options.threshold = 20 options.profile = 0
  let jit = run Jit.make(move options) |> Effect.provideMut<Allocator>(&mut system)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: Recompiling { jit: move jit, failures: 0 } }
  unsafe jitRuntime.attach(&mut engine.services.jit, rt)
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: HANDLER }), opaque: Pointer.null<u8>() })
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = run Effect.result(unsafe exercise(&mut engine, context)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), JsException | AssertionError<'static>>.Success { value: _ } => ()
    Result<(), JsException | AssertionError<'static>>.Failure { error } => { fail move error }
  }
}
/// With Options.profile, a function reported hot records feedback first (js_feedback) and is
/// compiled at its next report from what the recording saw.
unsafe effect fn exerciseRecorded<'m>(engine: &mut Engine<'m, Recompiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  // w's add has a double operand at every call: compiled once, as a number add, no deopt.
  drop run unsafe evaluate(&mut engine, context, b"function w(x){var s=x;for(var i=0;i<3;i++)s=s+0.5;return s}")
  let hot = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<200;k++)t=t+w(k);t")
  engine.services.jit.collect()
  run Testing.expect(isNumber(hot, 20200.0), "results stay the interpreter's while w records and after")
  run Testing.expect(engine.services.jit.profiled == 1 && engine.services.jit.learned >= 1, "w records before it is compiled and its add is learned")
  run Testing.expect(engine.services.jit.reported == 1 && engine.services.jit.compiledFunctions == 1, "then it is compiled once")
  run Testing.expect(engine.services.jit.runs >= 100 && engine.services.jit.deopts == 0 && engine.services.jit.unlinked == 0, "and runs compiled without a deopt")
  // z's add sees strings, which compiled arithmetic would deoptimize at: refused, never compiled.
  drop run unsafe evaluate(&mut engine, context, b"function z(a){return a+'x'}")
  let text = run unsafe evaluate(&mut engine, context, b"var n=0;for(var k=0;k<200;k++)n=n+z('a').length;n")
  run Testing.expect(isInt(text, 400), "z's results stay the interpreter's")
  run Testing.expect(engine.services.jit.foreseen == 1 && engine.services.jit.compiledFunctions == 1, "z is refused from its recording")
  // The same nonnumeric feedback is valid input to strict equality's boxed lowering.
  drop run unsafe evaluate(&mut engine, context, b"function eq(a,b){var n=0;for(var i=0;i<3;i++){if(a===b)n++;if(b!==a)n+=2}return n}")
  let before = engine.services.jit.runs
  let same = run unsafe evaluate(&mut engine, context, b"var n=0;for(var k=0;k<200;k++){var a=k&1?'str':undefined;n+=eq(a,k&2?a:null)}n")
  engine.services.jit.collect()
  run Testing.expect(isInt(same, 900), "strict equality handles strings and undefined after recording")
  run Testing.expect(engine.services.jit.foreseen == 1 && engine.services.jit.compiledFunctions == 2 && engine.services.jit.runs > before,
    "nonnumeric strict equality compiles and runs while string addition remains refused")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}
test effect fn recordingComesBeforeTheFirstCompilation() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut options = Options.make()
  options.enabled = true options.threshold = 20
  let jit = run Jit.make(move options) |> Effect.provideMut<Allocator>(&mut system)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: Recompiling { jit: move jit, failures: 0 } }
  unsafe jitRuntime.attach(&mut engine.services.jit, rt)
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: HANDLER }), opaque: Pointer.null<u8>() })
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = run Effect.result(unsafe exerciseRecorded(&mut engine, context)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), JsException | AssertionError<'static>>.Success { value: _ } => ()
    Result<(), JsException | AssertionError<'static>>.Failure { error } => { fail move error }
  }
}
