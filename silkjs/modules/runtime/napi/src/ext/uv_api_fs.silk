unsafe fn twoPathRequest(loop: ?*mut u8, req: ?*mut u8, kind: i32, path: ?*const u8, newPath: ?*const u8, flags: i32, cb: FsCallback) -> i32 {
  unsafe {
    if !initRequest(loop, req, kind, cb) { return -EINVAL }
    let status = setPaths(req, path, newPath, cb)
    if status != 0 { return status }
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, setFields(req))
    if kind == FS_SYMLINK || kind == FS_COPYFILE { r.flags = flags }
    drop r
    return post(loop, req, cb)
  }
}
