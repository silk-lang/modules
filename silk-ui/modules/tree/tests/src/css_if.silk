//! CSS `if()` and `@container style()` queries, from sheets and inline styles.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, StyleState }
import silk.core.option { Option }
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.written
import svg_css.tokens { CssError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import ui_fixtures.fixtures as fixtures

fn frame(width: f32) -> FrameInput {
  return FrameInput { width: width, height: 400.0, scale: 1.0, time: 0.0 }
}

/// A root (1) with class `mode`, a child (2) with class `a`, and a child (3) styled inline.
effect fn build<'f>(tree: &mut UiTree<'f>, mode: string<'static>) -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy(mode) })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("a") })
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  let inline = run written.declarations(b"display:block;height:5px;width:if(style(--mode: dark): 30px; else: 40px)")
  run batch.style(3, inline.asSlice())
  let source = b".dark{--mode:dark}.light{--mode:light}.a{display:block;height:5px;width:if(style(--mode: dark): 10px; media(width >= 600px): 15px; else: 20px)}@container style(--mode: dark){.a{margin-left:7px}}"
  let sheet = run compile.compile(source, &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
}

effect fn body() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run build(&mut tree, "dark")
  run tree.frame(frame(400.0))
  let a = tree.slotOf(2)
  let inline = tree.slotOf(3)
  run Testing.expect(tree.node(a).computed().layout.width.value == 10.0, "if() in a sheet takes the branch whose style() holds")
  run Testing.expect(tree.node(inline).computed().layout.width.value == 30.0, "if() in an inline style reads inherited custom properties")
  run Testing.expect(tree.node(a).computed().layout.margin.left.value == 7.0, "@container style() matches the parent's custom property")
  let mut batch = Batch.make()
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("light") })
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  run Testing.expect(tree.node(a).computed().layout.width.value == 20.0, "a changed custom property picks another branch")
  run Testing.expect(tree.node(inline).computed().layout.width.value == 40.0, "the inline if() follows too")
  run Testing.expect(tree.node(a).computed().layout.margin.left.value == 0.0, "the style query stops matching")
  run tree.frame(frame(800.0))
  run Testing.expect(tree.node(a).computed().layout.width.value == 15.0, "media() in if() follows the window")
}

test effect fn cssIfAndStyleQueriesFollowCustomProperties() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn inlineBody() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.customProperty(1, StyleState.Base, "--x", Option<string>.some("1"), false)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("sample") })
  let sheet = run compile.compile(b"@container style(--x: 1){.sample{margin-left:30px}} .sample{width:if(style(--x: 1): 9px; else: 3px)}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  let a = tree.slotOf(2)
  run Testing.expect(tree.node(a).computed().layout.width.value == 9.0, "if() reads an inline custom property")
  run Testing.expect(tree.node(a).computed().layout.margin.left.value == 30.0, "a style query reads an inline custom property")
}

test effect fn cssStyleQueriesReadInlineCustomProperties() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inlineBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
