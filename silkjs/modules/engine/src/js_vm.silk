      148 => { // OP_lnot
        unsafe refresh(&machine, &mut m)
        let value = unsafe m.top(1)
        let falsy = unsafe operators.notFast(value)
        if falsy >= 0 { unsafe m.set(1, ValueBits.Bool { value: falsy == 1 }) unsafe locals.releaseIn(&mut hooks, &machine, value) }
        else { unsafe sync(&m, &mut machine) drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
      }
      149 => { unsafe sync(&m, &mut machine) run unsafe operators.typeofValue(&mut hooks, &mut machine) unsafe sync(&machine, &mut m) } // OP_typeof
      157 => { unsafe sync(&m, &mut machine) drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_pow
      174 => { // OP_is_undefined_or_null
        unsafe refresh(&machine, &mut m)
        let value = unsafe m.top(1)
