//! A canvas that shows a GPU surface through the view: the node gets the surface, a change of
//! surface reaches it, and a view without one gives the node back to its commands. A canvas
//! that shows a shared drawing or bitmap costs a render nothing while the handle is the same.
import loom.app { App, Context, NoCommand }
import loom.runtime { Runtime }
import loom.ui { Ui, Surface, Drawing, Bitmap }
import ui_protocol.mutation { CanvasCommand }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.num.u32
import ui_tree.legacy { UiTree, TreeError, FrameInput }
import ui_tree.inspect { findAll }
import ui_tree.mutation { NO_SURFACE }
import ui_fixtures.fixtures as fixtures
import silk.collections.list { List }
import silk.num.u8
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

struct Example {
  shown: Surface,
}

enum Message {
  Change
}

impl App<Message, NoCommand> for Example {
  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {}

  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.surface(self.shown, |ui| ui.testId("scene"))
  }
}

fn viewport() -> FrameInput {
  return FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
}

/// The surface of the node with test id "scene", `NO_SURFACE` when there is no such node.
effect fn shown(tree: &UiTree<'_>) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(tree, "scene", &mut found)
  if found.length() == 0 {
    return NO_SURFACE
  }
  return tree.node(tree.slotOf(found.get(0))).surface().id
}

effect fn body() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut app = Runtime<Example, Message, NoCommand>.make(
    Example { shown: Surface { id: 5, width: 200, height: 100, opaque: true } },
  )
  run app.start(&mut tree, 0.0)
  run tree.frame(viewport())
  run Testing.expect((run shown(&tree)) == 5, "the canvas of the first render shows its surface")

  app.model.shown = Surface { id: 6, width: 200, height: 100, opaque: true }
  run app.render(&mut tree)
  run tree.frame(viewport())
  run Testing.expect((run shown(&tree)) == 6, "a view that names another surface changes it")

  app.model.shown = Surface.none()
  run app.render(&mut tree)
  run tree.frame(viewport())
  let mut found = List<u32>.make()
  run findAll(&tree, "scene", &mut found)
  run Testing.expect(
    found.length() == 1 && (run shown(&tree)) == NO_SURFACE,
    "a view without a surface gives the canvas back to its commands",
  )
}

test effect fn canvasShowsTheSurfaceOfItsView() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}

struct Shared {
  drawing: Drawing,
  bitmap: Option<Bitmap>,
}

impl App<Message, NoCommand> for Shared {
  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {}

  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    if let Option<Bitmap>.Some { value } = &self.bitmap {
      ui.bitmap(&value, |ui| ui.testId("scene"))
    } else {
      ui.drawing(&self.drawing, |ui| ui.testId("scene"))
    }
  }
}

effect fn rects(count: u32, red: f32) -> Drawing ! OutOfMemoryError ? &mut Allocator {
  let mut commands = List<CanvasCommand>.make()
  let mut i: u32 = 0
  while i < count {
    run commands.append(CanvasCommand.FillRect {
      x: u32.toF32(i % 100), y: u32.toF32(i / 100), width: 1.0, height: 1.0, radius: 0.0, color: Rgba<f32>.new(red, 0.0, 1.0, 1.0),
    })
    i = i + 1
  }
  return run Drawing.make(move commands)
}

/// The node with test id "scene": its slot, or none.
effect fn scene(tree: &UiTree<'_>) -> u32 ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(tree, "scene", &mut found)
  return tree.slotOf(found.get(0))
}

effect fn sharedBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let drawing = run rects(20000, 1.0)
  let mut app = Runtime<Shared, Message, NoCommand>.make(Shared { drawing: drawing.clone(), bitmap: Option<Bitmap>.None })
  run app.start(&mut tree, 0.0)
  run Testing.expect(tree.node(run scene(&tree)).canvas().length == 20000, "the canvas draws the drawing")

  let compared = app.diffState.comparedCommands
  run app.render(&mut tree)
  run Testing.expect(app.stats.mutations == 0, "the same drawing again sends nothing")
  run Testing.expect(app.diffState.comparedCommands == compared, "and compares none of its commands")

  app.model.drawing = run rects(20000, 1.0)
  run app.render(&mut tree)
  run Testing.expect(app.stats.mutations == 0, "an equal drawing made again sends nothing either")
  run Testing.expect(app.diffState.comparedCommands == compared + 20000, "it is compared command by command")

  app.model.drawing = run rects(20000, 0.5)
  run app.render(&mut tree)
  run Testing.expect(app.stats.mutations == 1, "a changed drawing sends one mutation")
  match tree.node(run scene(&tree)).canvas()[0] {
    CanvasCommand.FillRect { color, .. } => run Testing.expect(color.r == 0.5, "with the new commands")
    _ => run Testing.expect(false, "the canvas draws rects")
  }

  // Two straight RGBA pixels, shown as `putImageData` shows them.
  let pixels: [u8; 8] = [255, 0, 0, 255, 0, 0, 255, 255]
  let mut bytes = List<u8>.make()
  run bytes.appendSlice(&pixels)
  let bitmap = run Bitmap.make(2, 1, move bytes, true)
  app.model.bitmap = Option<Bitmap>.some(bitmap.clone())
  run app.render(&mut tree)
  let shown = tree.canvas2d.all()
  run Testing.expect(shown.length == 1 && shown[0].pixels.width() == 2, "a bitmap becomes the canvas's pixels")
  run Testing.expect(tree.node(run scene(&tree)).canvas().length == 0, "in place of its commands")
  run app.render(&mut tree)
  run Testing.expect(app.stats.mutations == 0, "the same bitmap again sends nothing")

  app.model.bitmap = Option<Bitmap>.None
  run app.render(&mut tree)
  let after = tree.canvas2d.all()
  run Testing.expect(after.length == 1 && after[0].pixels.width() == 0, "a drawing again takes the pixels away")
  run Testing.expect(tree.node(run scene(&tree)).canvas().length == 20000, "and draws its commands")
  drop drawing
}

test effect fn sharedDrawingsCostNothingUnchanged() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sharedBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
