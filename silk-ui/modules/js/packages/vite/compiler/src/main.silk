import css_style.compile { Options, CompileError }
import css_style.compile
import css_style.sheet { DiagnosticKind }
import css_style.sheet_fonts { FaceSource }
import silk.text.string { String }
import silk.core.result { Result }
import css_style.tokens { CssError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import ui_protocol.animatable

static if Intrinsic.targetArchitecture() == "wasm32" {
  unsafe extern "C" fn inputLength() -> usize as "stylesheet#input_length"
  @foreign(noCapture: .("into"))
  unsafe extern "C" fn inputRead(into: ?[*]mut u8, length: usize) -> () as "stylesheet#input_read"
  @foreign(noCapture: .("bytes"))
  unsafe extern "C" fn output(bytes: ?[*]const u8, length: usize) -> () as "stylesheet#output"
  @foreign(noCapture: .("feature"))
  unsafe extern "C" fn diagnostic(kind: u32, feature: ?[*]const u8, length: usize, count: usize) -> () as "stylesheet#diagnostic"

  @foreign(noCapture: .("url"))
  unsafe extern "C" fn fontUrlLength(url: ?[*]const u8, length: usize) -> usize as "stylesheet#font_url_length"
  @foreign(noCapture: .("into"))
  unsafe extern "C" fn fontUrlRead(into: ?[*]mut u8, length: usize) -> () as "stylesheet#font_url_read"

  effect fn compiled(strict: bool) -> i32 ! CompileError | CssError | OutOfMemoryError ? &mut Allocator {
    let length = unsafe inputLength()
    if length > 67108864 { return 2 }
    let mut source = run Bytes.zeroed(length)
    unsafe inputRead(Pointer.fromMutSlice(source.asMutSlice()), length)
    let mut sheet = run compile.compile(source.asSlice(), &Options.make())
    let entries = sheet.diagnostics.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      let item = &entries[i]
      let kind: u32 = match item.kind {
        DiagnosticKind.AtRule => 0
        DiagnosticKind.Selector => 1
        DiagnosticKind.Property => 2
        DiagnosticKind.Value => 3
        DiagnosticKind.Unsupported => 4
      }
      let feature = item.feature.asSlice()
      unsafe diagnostic(kind, Pointer.fromSlice(feature), feature.length, item.count)
      i = i + 1
    }
    if strict && entries.length != 0 { return 1 }
    // Kind 5: what `@keyframes` sets that Silk UI does not animate, as `<name>: <property>`.
    // A warning, never a strict failure: the sheet still compiles and draws.
    let still = run animatable.stillKeyframes(&sheet)
    i = 0
    while i < still.length() {
      let item = &still.asSlice()[i]
      let mut feature = run Bytes.copy(item.keyframes.asSlice())
      run feature.append(b": ")
      run feature.append(animatable.propertyName(item.property))
      unsafe diagnostic(5, Pointer.fromSlice(feature.asSlice()), feature.length(), 1)
      i = i + 1
    }
    i = 0
    while i < sheet.fontFaces.length() {
      let faces = sheet.fontFaces.asMutSlice()
      let mut source: usize = 0
      while source < faces[i].rule.sources.length() {
        let sources = faces[i].rule.sources.asMutSlice()
        if let FaceSource.Url { url, .. } = &mut sources[source] {
          let original = String.utf8Bytes(String.view(&url))
          let size = unsafe fontUrlLength(Pointer.fromSlice(original),original.length)
          if size > 67108864 { return 2 }
          if size != 0 {
            let mut replacement = run Bytes.zeroed(size - 1)
            unsafe fontUrlRead(Pointer.fromMutSlice(replacement.asMutSlice()),size - 1)
            match move String.fromBytes(move replacement) { Result.Success { value } => { url = move value } _ => { return 2 } }
          }
        }
        source = source + 1
      }
      i = i + 1
    }
    let bytes = run sheet.encode()
    unsafe output(Pointer.fromSlice(bytes.asSlice()), bytes.length())
    return 0
  }

  effect fn failed<E>(error: E) -> i32 {
    drop error
    return 2
  }

  export "C" fn compileSheet(strict: u32) -> i32 as "compile_stylesheet" {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(compiled(strict != 0), failed) |> Effect.provideMut<Allocator>(&mut allocator)
  }
}

pub fn main() -> i32 { return 0 }
