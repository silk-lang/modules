{
  "name": "@silkui/core",
  "version": "0.1.15",
  "description": "The node and event API of a Silk UI tree for JavaScript applications that run on the embedded SilkJS engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silk-lang/SilkUI.git",
    "directory": "modules/js/packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./globals": {
      "types": "./src/globals.d.ts",
      "default": "./src/globals.js"
    },
    "./html.css": "./src/html.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": true,
  "license": "MIT",
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "csstype": "^3.1.3"
  }
}
