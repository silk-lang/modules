//! Scroll snapping: user scrolls settle on a snap position once they stop, script scrolls
//! land on one, and a mandatory container stays on one when layout moves its areas.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, FrameInput, Input }
import ui_tree.cssom_view as view
import ui_fixtures.fixtures as fixtures
import svg_css.cssom_view { ScrollBehavior }
import svg_css.cssom_error { CssomError }
import svg_css.written
import svg_css.tokens { CssError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

fn frameAt(time: f64) -> FrameInput {
  return FrameInput { width: 300.0, height: 200.0, scale: 1.0, time: time }
}

effect fn styled(batch: &mut Batch, id: u32, css: &[u8]) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let declarations = run written.declarations(css)
  run batch.style(id, declarations.asSlice())
}

/// A 100px tall scroll container (2) with five 100px rows (10 to 14) that snap with `align`,
/// and a 30px header row (9) before them that does not.
effect fn snapper<'f>(tree: &mut UiTree<'f>, container: &[u8], align: &[u8]) -> ()
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run styled(&mut batch, 1, b"display:block;width:300px;height:200px")
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run styled(&mut batch, 2, container)
  run batch.create(9, NodeKind.Box)
  run batch.append(2, 9)
  run styled(&mut batch, 9, b"display:block;height:30px")
  let mut id: u32 = 10
  while id < 15 {
    run batch.create(id, NodeKind.Box)
    run batch.append(2, id)
    run styled(&mut batch, id, align)
    id = id + 1
  }
  run tree.apply(run batch.take())
}

effect fn wheelSnaps() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run snapper(&mut tree, b"display:block;width:200px;height:100px;overflow-y:auto;scroll-snap-type:y mandatory", b"display:block;height:100px;scroll-snap-align:start")
  run tree.frame(frameAt(0.0))
  run Testing.expect(tree.scrollOffset(2).y == 30.0, "a mandatory container starts on a snap position, past the header")
  run tree.dispatch(Input.Wheel { x: 10.0, y: 10.0, deltaX: 0.0, deltaY: 60.0, modifiers: 0 })
  run tree.frame(frameAt(0.05))
  run Testing.expect(tree.scrollOffset(2).y == 90.0 && tree.needsFrame(), "the wheel scrolls freely and a snap waits")
  run tree.frame(frameAt(0.1))
  run Testing.expect(tree.scrollOffset(2).y == 90.0, "no snap while the wheel may still be turning")
  run tree.frame(frameAt(0.2))
  run tree.frame(frameAt(0.6))
  run Testing.expect(tree.scrollOffset(2).y == 130.0, "once still, it snaps to the nearest row")
  // The snap moved content under the pointer: one more frame lets hover follow it.
  run tree.frame(frameAt(0.8))
  run Testing.expect(!tree.needsFrame(), "and stops asking for frames")
  // A script scroll lands on a snap position right away.
  drop run view.requestScroll(&mut tree, 2, 0.0, 270.0, ScrollBehavior.Instant, false, true)
  run Testing.expect(tree.scrollOffset(2).y == 230.0, "a script scroll ends on the nearest snap position")
}

effect fn alignAndProximity() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut centered = run UiTree.make(&fonts)
  run snapper(&mut centered, b"display:block;width:200px;height:100px;overflow-y:auto;scroll-snap-type:y mandatory;scroll-padding-top:20px", b"display:block;height:100px;scroll-snap-align:center;scroll-margin-top:0")
  run centered.frame(frameAt(0.0))
  // Row 10 spans 30..130; the port with 20px padding is 20..100, centered at 60: offset 20.
  run Testing.expect(centered.scrollOffset(2).y == 20.0, "center alignment uses the padded port")
  let mut near = run UiTree.make(&fonts)
  run snapper(&mut near, b"display:block;width:200px;height:100px;overflow-y:auto;scroll-snap-type:y proximity", b"display:block;height:100px;scroll-snap-align:start")
  run near.frame(frameAt(0.0))
  run Testing.expect(near.scrollOffset(2).y == 0.0, "proximity leaves the start alone")
  drop run view.requestScroll(&mut near, 2, 0.0, 80.0, ScrollBehavior.Instant, false, true)
  run Testing.expect(near.scrollOffset(2).y == 80.0, "proximity does not snap from far away")
  drop run view.requestScroll(&mut near, 2, 0.0, 120.0, ScrollBehavior.Instant, false, true)
  run Testing.expect(near.scrollOffset(2).y == 130.0, "proximity snaps nearby")
}

/// A wheel stream that slows down like momentum, from `first` pixels a frame by `ratio` each
/// frame, 16ms apart from `start`; returns the time after it and checks the offset never goes
/// past `limit`.
effect fn fling(tree: &mut UiTree<'_>, start: f64, first: f32, ratio: f32, count: u32, limit: f32) -> f64
  ! TreeError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut time = start
  let mut delta = first
  let mut i: u32 = 0
  while i < count {
    run tree.dispatch(Input.Wheel { x: 10.0, y: 10.0, deltaX: 0.0, deltaY: delta, modifiers: 0 })
    time = time + 0.016
    run tree.frame(frameAt(time))
    run Testing.expect(tree.scrollOffset(2).y <= limit + 0.01, "an aimed fling never goes past its snap position")
    delta = delta * ratio
    i = i + 1
  }
  return time
}

effect fn flings() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run snapper(&mut tree, b"display:block;width:200px;height:100px;overflow-y:auto;scroll-snap-type:y mandatory", b"display:block;height:100px;scroll-snap-align:start")
  run tree.frame(frameAt(0.0))
  // 27 + 24.3 + ... comes to rest about 270px on, near the row at 330.
  let mut time = run fling(&mut tree, 0.0, 27.0, 0.9, 40, 330.0)
  run Testing.expect(tree.snapWaits.length() == 1 && tree.snapWaits.get(0).aimed, "a slowing wheel stream is taken for a fling and aimed")
  time = time + 0.3
  run tree.frame(frameAt(time))
  time = time + 1.0
  run tree.frame(frameAt(time))
  run Testing.expect(tree.scrollOffset(2).y == 330.0, "the fling ends on the snap position where it would come to rest")
  run Testing.expect(!tree.needsFrame(), "and stops asking for frames")
  // Even steps, as keys or a mouse wheel give, are not a fling.
  let mut steady = run UiTree.make(&fonts)
  run snapper(&mut steady, b"display:block;width:200px;height:100px;overflow-y:auto;scroll-snap-type:y mandatory", b"display:block;height:100px;scroll-snap-align:start")
  run steady.frame(frameAt(0.0))
  drop run fling(&mut steady, 0.0, 10.0, 1.0, 8, 1000.0)
  run Testing.expect(steady.scrollOffset(2).y == 110.0 && !steady.snapWaits.get(0).aimed, "a steady stream scrolls freely")
}

effect fn stops() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run snapper(&mut tree, b"display:block;width:200px;height:100px;overflow-y:auto;scroll-snap-type:y mandatory", b"display:block;height:100px;scroll-snap-align:start")
  let mut batch = Batch.make()
  run styled(&mut batch, 11, b"display:block;height:100px;scroll-snap-align:start;scroll-snap-stop:always")
  run tree.apply(run batch.take())
  run tree.frame(frameAt(0.0))
  run tree.dispatch(Input.Wheel { x: 10.0, y: 10.0, deltaX: 0.0, deltaY: 250.0, modifiers: 0 })
  run tree.frame(frameAt(0.05))
  run tree.frame(frameAt(0.3))
  run tree.frame(frameAt(1.5))
  run Testing.expect(tree.scrollOffset(2).y == 130.0, "a scroll past a scroll-snap-stop: always row stops on it")
  let mut time = run fling(&mut tree, 1.5, 12.0, 0.9, 40, 1000.0)
  time = time + 1.5
  run tree.frame(frameAt(time))
  run Testing.expect(tree.scrollOffset(2).y == 230.0, "a fling starting on it may leave it, and snaps as usual")
  let mut back = run fling(&mut tree, time, -27.0, 0.9, 40, 1000.0)
  back = back + 1.5
  run tree.frame(frameAt(back))
  run Testing.expect(tree.scrollOffset(2).y == 130.0, "a fling back stops on the always row instead of passing it")
}

test effect fn scrollSnapAimsFlings() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run flings() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn scrollSnapStopAlwaysIsNotPassed() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run stops() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn scrollSnapSettlesAfterTheWheelAndOnScriptScrolls() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run wheelSnaps() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn scrollSnapAlignsWithThePaddedPortAndProximity() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run alignAndProximity() |> Effect.provideMut<Allocator>(&mut allocator)
}
