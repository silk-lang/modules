/// Whether the program has crypto (`Crypto.present`): a constant, for `static if`.
pub static fn hasCrypto<C: Composition>() -> bool { return Composition.cryptoPresent() }
/// Whether the program has TLS (`Tls.present`): a constant, for `static if`.
pub static fn hasTls<C: Composition>() -> bool { return Composition.tlsPresent() }

/// Whether the program has a database (`Database.present`): a constant, for `static if`.
pub static fn hasDatabase<C: Composition>() -> bool { return Composition.databasePresent() }
/// Whether the program loads addons (`NativeAddons.present`): a constant, for `static if`.
pub static fn hasAddons<C: Composition>() -> bool { return Composition.addonsPresent() }

/// Whether the program makes child processes (`Processes.present`): a constant, for `static if`.
pub static fn hasProcesses<C: Composition>() -> bool { return Composition.processesPresent() }

/// Whether the program has the network (`Network.present`): a constant, for `static if`.
pub static fn hasNetwork<C: Composition>() -> bool { return Composition.networkPresent() }
/// Whether the program has the HTTP/1 parser (`Http.present`): a constant, for `static if`.
pub static fn hasHttp<C: Composition>() -> bool { return Composition.httpPresent() }

/// Whether the program has the inspector (`Inspector.present`): a constant, for `static if`.
pub static fn hasInspector<C: Composition>() -> bool { return Composition.inspectorPresent() }

/// The capabilities that need others: a combination without what one needs does not build.
pub fn checkCombination<C: Composition>() -> () {
  static if Composition.tlsPresent() && !Composition.cryptoPresent() {
    compileError("Tls needs Crypto: give Capabilities a real crypto (OpenSslCrypto), or no TLS (EmptyTls)")
  }
  static if Composition.networkPresent() && !Composition.httpPresent() {
    compileError("Network needs Http: give Capabilities the HTTP/1 parser (Llhttp), or no network (EmptyNetwork)")
  }
  static if Composition.tlsPresent() && !Composition.networkPresent() {
    compileError("Tls needs Network: give Capabilities a network (OsNetwork), or no TLS (EmptyTls)")
  }
  static if Composition.http2Present() && !Composition.networkPresent() {
    compileError("Http2 needs Network: give Capabilities a network (OsNetwork), or no HTTP/2 (EmptyHttp2)")
  }
  static if Composition.processesPresent() && !Composition.networkPresent() {
    compileError("Processes needs Network for the pipes of child processes: give Capabilities a network (OsNetwork), or no child processes (EmptyProcesses)")
  }
  static if Composition.inspectorPresent() && !Composition.networkPresent() {
    compileError("Inspector needs Network for its server and the network domain: give Capabilities a network (OsNetwork), or no inspector (EmptyInspector)")
  }
  static if Composition.typeStrippingPresent() && !Composition.wasmPresent() {
    compileError("TypeStripping needs Wasm: amaro runs on WebAssembly; give Capabilities WamrWasm, or no TypeScript (EmptyTypeStripping)")
  }
  static if Composition.databasePresent() && !Composition.filesPresent() {
    compileError("Database needs Files: give Capabilities a file system, or no database (EmptyDatabase)")
  }
}

/// Whether the program has compression (`Compression.present`): a constant, for `static if`.
pub static fn hasCompression<C: Composition>() -> bool { return Composition.compressionPresent() }
/// Whether the program has HTTP/2 (`Http2.present`): a constant, for `static if`.
pub static fn hasHttp2<C: Composition>() -> bool { return Composition.http2Present() }

/// Whether the program has a file system (`Files.present`): a constant, for `static if`.
pub static fn hasFiles<C: Composition>() -> bool { return Composition.filesPresent() }

/// Whether the program's capabilities include WebAssembly: a constant, for `static if`.
pub static fn hasWasm<C: Composition>() -> bool { return Composition.wasmPresent() }
