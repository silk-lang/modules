    if j.sourceLength == 0 { j.source = nil() } else { j.source = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe buffers.dataAt(input.data, usize.toU64(j.lengths[3]))) }
  } else {
    j.data[2] = run allocate(j.sourceLength) unsafe copyIn(j.data[2], input, j.lengths[3], j.sourceLength) j.source = j.data[2]
  }
  if output.physicalCapacity == 0 {
    j.target = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe buffers.dataAt(output.data, usize.toU64(j.lengths[6])))
  } else {
    j.data[5] = run allocate(j.capacity) j.target = j.data[5] j.stagedOut = true
  }
}
// A range at least this long is leased for a worker; a shorter one is copied. Starting and ending a
// lease visits every view of the buffer, and a stream's buffers can have thousands of small views
// (pieces of one input, Buffer.allocUnsafe's pool), while copying 64 KiB takes microseconds.
const LEASE_MINIMUM: usize = 65536

// Sets up the write op for a worker: leases of the caller's buffers, which the worker reads and
// writes in place, or staging copies of short ranges and of buffers that cannot be leased.
unsafe effect fn bindLater<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, j: &mut Job) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let input = run unsafe writeBuffer(&mut engine, context, &j.*, 0)
  let _output = run unsafe writeBuffer(&mut engine, context, &j.*, 1)
  j.sourceLength = j.lengths[4] j.capacity = j.lengths[7]
  if j.sourceLength == 0 { j.source = nil() }
  else {
    let object = core.reference(j.views[0])
    if j.sourceLength >= LEASE_MINIMUM && unsafe buffers.canLeaseReadBacking(object) {
      let lease = run unsafe buffers.leaseReadBacking(object)
      j.source = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe buffers.dataAt(lease.data(), usize.toU64(j.lengths[3])))
      j.leaseIn = Option<buffers.BufferReadLease>.some(move lease)
    } else {
      j.data[2] = run allocate(j.sourceLength) unsafe copyIn(j.data[2], input, j.lengths[3], j.sourceLength) j.source = j.data[2]
    }
  }
  let object = core.reference(j.views[1])
  if j.capacity >= LEASE_MINIMUM && unsafe buffers.canLeaseReadBacking(object) {
    let lease = run unsafe buffers.leaseReadBacking(object)
    j.target = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe buffers.dataAt(lease.data(), usize.toU64(j.lengths[6])))
    j.leaseOut = Option<buffers.BufferReadLease>.some(move lease)
  } else {
    j.data[5] = run allocate(j.capacity) j.target = j.data[5] j.stagedOut = true
  }
}
// Ends the write op on this thread: copies a staged output into the caller's buffer, ends the
// leases, and lets go of the buffers, which prepare took from the arguments.
unsafe fn unbind<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, j: &mut Job) -> () {
  if j.stagedOut && j.status == 0 && j.written != 0 {
    let output = unsafe buffers.snapshot(core.reference(j.views[1]))
    if !output.detached && usize.toU64(j.lengths[6]) <= output.byteLength && usize.toU64(j.written) <= output.byteLength - usize.toU64(j.lengths[6]) {
      unsafe copyOut(output, j.lengths[6], unsafe nonnull(j.data[5]), j.written)
    }
  }
  j.stagedOut = false
  let leaseIn = Intrinsic.replace(j.leaseIn, Option<buffers.BufferReadLease>.none())
  if let Option<buffers.BufferReadLease>.Some { value } = move leaseIn { unsafe buffers.releaseReadBacking(core.reference(j.views[0]), move value) }
  let leaseOut = Intrinsic.replace(j.leaseOut, Option<buffers.BufferReadLease>.none())
  if let Option<buffers.BufferReadLease>.Some { value } = move leaseOut { unsafe buffers.releaseReadBacking(core.reference(j.views[1]), move value) }
  j.source = nil() j.target = nil()
  unsafe owners.release(&mut engine, context, j.views[0])
  unsafe owners.release(&mut engine, context, j.views[1])
  unsafe owners.release(&mut engine, context, j.words)
