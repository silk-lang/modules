    }
    if pad == 1 { unsafe setState(sp, IB_READ_NBYTE) return 0 }
    if payload < 4 { unsafe setState(sp, IB_FRAME_SIZE_ERROR) return 2 }
    unsafe setState(sp, IB_READ_NBYTE) unsafe setMark(sp, 4)
    return 0
  }
  if kind == PING {
    let s2 = unsafe ses(&mut a, sp) s2.hdFlags = u8.bitAnd(s2.hdFlags, F_ACK) drop s2
    if payload != 8 { unsafe setState(sp, IB_FRAME_SIZE_ERROR) return 2 }
    unsafe setState(sp, IB_READ_NBYTE) unsafe setMark(sp, 8)
    return 0
  }
  if kind == GOAWAY {
    let s2 = unsafe ses(&mut a, sp) s2.hdFlags = 0 drop s2
    if payload < 8 { unsafe setState(sp, IB_FRAME_SIZE_ERROR) return 2 }
    unsafe setState(sp, IB_READ_NBYTE) unsafe setMark(sp, 8)
    return 0
  }
  if kind == CONTINUATION {
    let rv = unsafe terminateSession(sp, PROTOCOL_ERROR, b"CONTINUATION: unexpected")
    if isFatal(rv) { return rv }
    return 1
  }
  if kind == ALTSVC {
