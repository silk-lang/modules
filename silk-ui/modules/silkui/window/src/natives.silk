//! What the dispatcher silkui generates for an app's exported Silk functions uses: the host's
//! `src/natives.silk` implements [`Exports`] and hands its `export "C"` callback to
//! `Settings.natives`. See `ui_js_calls.natives`.
pub import ui_js.lib { Natives, Reply, Exports, serve }
pub import ui_js_calls.lib { Arg }
pub import ui_js_calls.natives {
  accepts,
  number,
  flag,
  text,
  signed,
  unsigned,
  fromSigned,
  fromUnsigned,
  wrongArguments,
  failed,
  copied
}
