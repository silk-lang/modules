  if err != 0 { return err }
  unsafe set<Alloc>(udp, U_ALLOC, alloc)
  unsafe set<Recv>(udp, U_RECV, callback)
  unsafe ioStart(udp, POLLIN)
  unsafe handleStart(udp)
  return 0
}
pub export "C" fn uv_udp_recv_stop(udp: *mut u8) -> i32 {
  if unsafe kindOf(udp) != UV_UDP { return -EINVAL }
  unsafe ioStop(udp, POLLIN)
  if !unsafe ioActive(udp, POLLOUT) { unsafe handleStop(udp) }
  unsafe set<Alloc>(udp, U_ALLOC, Intrinsic.pointerNullFunction<Alloc>())
  unsafe set<Recv>(udp, U_RECV, Intrinsic.pointerNullFunction<Recv>())
  return 0
}
pub export "C" fn uv_udp_using_recvmmsg(udp: *mut u8) -> i32 { if unsafe has(udp, UDP_RECVMMSG) { return 1 } return 0 }
pub export "C" fn uv_udp_get_send_queue_size(udp: *mut u8) -> usize { return unsafe get<usize>(udp, U_SEND_QUEUE_SIZE) }
pub export "C" fn uv_udp_get_send_queue_count(udp: *mut u8) -> usize { return unsafe get<usize>(udp, U_SEND_QUEUE_COUNT) }
// IPv4 text to an address in network order (libuv's uv_inet_pton for AF_INET).
unsafe fn parse4(text: *const u8, out: *mut u8) -> i32 {
  let mut storage: [u64; 2] = [0; 2]
  let address = unsafe words(Pointer.fromMutRef<u64>(&mut storage[0]))
  let err = unsafe inet.uv_ip4_addr(text, 0, address)
  if err != 0 { return err }
  unsafe set<u32>(out, 0, unsafe get<u32>(address, 4))
  return 0
}
// libuv's uv__udp_set_membership4 and uv__udp_set_membership6.
unsafe fn membership(udp: *mut u8, group: *mut u8, interfaceAddress: ?*const u8, which: i32, six: bool) -> i32 {
