// The zones a realm has loaded from the time zone database of `silk.time.zones_bundled`.
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.time.zone { Zone }
import silk.time.zones { TimeZones, ZoneLookupError }
import silk.time.zones_bundled { BundledTimeZones }

struct Loaded { id: i32, zone: Zone }

pub struct ZoneCache {
  provider: BundledTimeZones,
  loaded: List<Loaded>,
}

effect fn load(provider: &mut BundledTimeZones, name: &[u8]) -> Zone ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
  return run TimeZones.zoneBytes(name) |> Effect.provideMut<TimeZones>(&mut provider)
}
effect fn keep(list: &mut List<Loaded>, id: i32, zone: Zone) -> () ! OutOfMemoryError ? &mut Allocator {
  run list.reserve(1)
  let _kept = list.appendWithinCapacity(Loaded { id: id, zone: move zone })
}

impl ZoneCache {
  pub fn empty() -> ZoneCache { return ZoneCache { provider: BundledTimeZones.make(), loaded: List<Loaded>.make() } }

  /// The zone with the table index `id` and the name `name`, loaded at its first use. `None` if
  /// the database has no such zone or memory ran out.
  pub fn zone(self: &mut Self, id: i32, name: &[u8]) -> Option<&Zone> {
    let mut at: usize = 0
    let mut found = false
    while at < self.loaded.length() {
      if self.loaded.asSlice()[at].id == id { found = true break }
      at = at + 1
    }
    if !found {
      let mut allocator = Allocator.systemAllocatorProvider()
      let result = run Effect.result(load(&mut self.provider, name)) |> Effect.provideMut<Allocator>(&mut allocator)
      match move result {
        Result<Zone, ZoneLookupError | OutOfMemoryError>.Success { value } => {
          let kept = run Effect.result(keep(&mut self.loaded, id, move value)) |> Effect.provideMut<Allocator>(&mut allocator)
          if let Result<(), OutOfMemoryError>.Failure { .. } = move kept { return Option<&Zone>.none() }
        }
        Result<Zone, ZoneLookupError | OutOfMemoryError>.Failure { .. } => { return Option<&Zone>.none() }
      }
      at = self.loaded.length() - 1
    }
    return Option<&Zone>.some(&self.loaded.asSlice()[at].zone)
  }
}
