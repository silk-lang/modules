/// How the render thread sets up the surface.
pub struct RenderSettings {
  /// Check mode: the surface can be read back, and text uses no gamma correction, like the CPU
  /// reference.
  pub check: bool,
}

impl Copy for RenderSettings {}

/// What the render thread last did, for frame timings and the check.
pub struct RenderReport {
  /// Frames presented so far.
  pub frames: u64,
  /// Of those, the frames the UI thread painted; the rest the compositor drew again.
  pub painted: u64,
  /// The result of the last compared frame: 0 within tolerance, 1 outside, -1 none yet.
  pub status: i32,
  /// Milliseconds the last frame spent writing atlas pixels, waiting for a drawable, encoding
  /// and submitting the draw, and presenting.
  pub upload: f64,
  pub acquire: f64,
  pub draw: f64,
  pub present: f64,
  /// Milliseconds between the last two presents, 0 before the second.
  pub interval: f64,
  /// Frames the UI thread handed over that a newer frame replaced before they were drawn.
  pub dropped: u64,
  /// The renderer's layer textures after the last frame (`UiRenderer.textureBytes`).
  pub textures: [u64; 5],
}

impl Copy for RenderReport {}

impl RenderReport {
  fn none() -> RenderReport {
    return RenderReport {
      frames: 0,
      painted: 0,
      status: -1,
      upload: 0.0,
      acquire: 0.0,
      draw: 0.0,
      present: 0.0,
      interval: 0.0,
      dropped: 0,
      textures: [0; 5],
    }
  }
}

/// The window's native surface, sent once to the render thread. The pointers it holds belong to
/// the window, which outlives the render thread: [`RenderThread.stop`] joins it before the
/// window closes.
struct SurfaceHandle {
  raw: RawSurface,
  window: WindowId,
}

impl Transferable for SurfaceHandle {}

/// One frame for the render thread.
pub struct FrameJob {
  scene: Scene,
  width: u32,
  height: u32,
  /// The CPU reference to compare the drawn surface with, when `compare` is set.
  expected: List<u8>,
  compare: bool,
  moves: List<Move>,
  commitEpoch: u64,
  consumedInputSeq: u64,
  atlasFrame: u64,
}

impl Transferable for FrameJob {}

/// A frame of a window past the first, for its surface `surface`.
struct ExtraJob {
  surface: u32,
  scene: Scene,
  width: u32,
  height: u32,
  commitEpoch: u64,
  atlasFrame: u64,
  ownAtlas: bool,
  infos: List<TextureInfo>,
  uploads: Pending,
}

impl Transferable for ExtraJob {}

/// Asynchronous surface-open completion reported to the host/compositor.
pub struct OpenedSurface {
  pub surface: u32,
  pub window: WindowId,
  pub made: bool,
}

impl Copy for OpenedSurface {}
impl Transferable for OpenedSurface {}

/// Lock-free commands queued for the GPU/present thread from UI group and compositor threads.
pub union GpuCommand {
  AttachPrimary { pub surface: SurfaceHandle },
  SubmitPrimary { pub job: FrameJob, pub textures: List<TextureInfo>, pub uploads: Pending, pub gen: u64 },
  ApplyScroll { pub window: WindowId, pub seq: u64, pub positions: List<ScrollPosition> },
  ApplyProperties {
    pub windowId: WindowId,
    pub activeEpoch: u64,
    pub scrolls: List<ScrollPosition>,
    pub overrides: List<LayerOverride>,
  },
  CommitLayers { pub commit: LayerCommit },
  RescrollPrimary {
    pub positions: List<ScrollPosition>,
    pub commitEpoch: u64,
    pub moves: List<Move>,
    pub updateMoves: bool,
    pub consumedInputSeq: u64,
    pub gen: u64,
  },
  OpenSurface { pub surface: u32, pub raw: RawSurface, pub window: WindowId },
  SubmitExtra { pub job: ExtraJob, pub textures: List<TextureInfo>, pub uploads: Pending },
  /// Strict 2-step teardown: GPU unconfigures & dropsDawn surface BEFORE closing OS window.
  CloseSurface { pub surface: u32, pub window: WindowId, pub platform: Option<PlatformClient> },
  SetEventSink { pub tx: UnboundedSender<GpuEvent> },
  SetMetalHud { pub on: bool },
  SetUncapped { pub on: bool },
  AllowCanvasLayers { pub on: bool },
  BeginFrame,
  EndFrame,
  GrabFrame,
  Quit,
}

impl Transferable for GpuCommand {}

/// Events emitted by the GPU/present thread when frames hit screen or surfaces open/close.
pub union GpuEvent {
  FramePresented {
    pub window: WindowId,
    pub commitEpoch: u64,
    pub painted: bool,
    pub report: RenderReport,
    pub dropped: u64,
    pub atMs: f64,
  },
  CommitInstalled { pub ack: CommitAck },
  GpuFinished { pub windowId: WindowId, pub gpuFinishedEpoch: u64, pub atlasFrame: u64 },
  SurfaceOpened { pub surface: u32, pub window: WindowId, pub made: bool },
  SurfaceClosed { pub surface: u32, pub window: WindowId },
}

impl Transferable for GpuEvent {}

/// Transferable multi-producer handle to send scroll updates and secondary-surface commands
/// directly to the GPU thread.
pub struct GpuHandle {
  cmdTx: UnboundedSender<GpuCommand>,
  nextSurface: Arc<Mutex<u32>>,
}

impl Transferable for GpuHandle {}
impl Concurrent for GpuHandle {}

effect fn createSurfaceCounter() -> Arc<Mutex<u32>>
  ! OutOfMemoryError
  ? &mut Allocator {
  let cell = run Mutex<u32>.make(1)
  return run Arc<Mutex<u32>>.make(move cell)
}

fn makeSurfaceCounter() -> Arc<Mutex<u32>> {
  let mut heap = Allocator.systemAllocatorProvider()
  return match run Effect.result(createSurfaceCounter()) |> Effect.provideMut<Allocator>(&mut heap) {
    Result.Success { value } => move value
    Result.Failure { .. } => Intrinsic.trap("ui-tree: out of memory allocating GPU surface id counter")
  }
}

fn allocateSurfaceId(counter: &Arc<Mutex<u32>>) -> u32 {
  let mut guard = counter.get().lock()
  let place = guard.getMut()
  let id = place.*
  place.* = id + 1
  return id
}

impl GpuHandle {
  pub fn make(cmdTx: UnboundedSender<GpuCommand>) -> GpuHandle {
    return GpuHandle { cmdTx: move cmdTx, nextSurface: makeSurfaceCounter() }
  }

  pub fn clone(self: &Self) -> GpuHandle {
    return GpuHandle { cmdTx: self.cmdTx.clone(), nextSurface: self.nextSurface.clone() }
  }

  pub fn send(self: &Self, cmd: GpuCommand) -> () {
    drop run Effect.result(self.cmdTx.send(move cmd))
  }

  /// Opens a GPU surface asynchronously for a secondary group window and returns its surface id.
  pub effect fn openSurface(self: &Self, raw: RawSurface, window: WindowId) -> u32
    ! OutOfMemoryError {
    let surface = allocateSurfaceId(&self.nextSurface)
    self.send(GpuCommand.OpenSurface { surface: surface, raw: raw, window: window })
    return surface
  }

  /// Submits a finished frame of a secondary-group surface directly to the GPU thread without blocking.
  pub effect fn submitSurface(
    self: &Self,
    surface: u32,
    scene: &Scene,
    atlas: &Atlas,
    uploads: &Pending,
    width: u32,
    height: u32,
    commitEpoch: u64,
  ) -> ()
    ! OutOfMemoryError {
    let mut heap = Allocator.systemAllocatorProvider()
    let mut copy = Scene.make()
    run copy.copyDrawnFrom(scene) |> Effect.provideMut<Allocator>(&mut heap)
    let mut textures = List<TextureInfo>.make()
    let mut i: usize = 0
    while i < atlas.textureCount() {
      run textures.append(atlas.texture(i)) |> Effect.provideMut<Allocator>(&mut heap)
      i = i + 1
    }
    let mut uploadCopy = Pending.make()
    run uploadCopy.appendAll(uploads) |> Effect.provideMut<Allocator>(&mut heap)
    let job = ExtraJob {
      surface: surface,
      scene: move copy,
      width: width,
      height: height,
      commitEpoch: commitEpoch,
      atlasFrame: atlas.frame(),
      ownAtlas: true,
      infos: move textures,
      uploads: move uploadCopy,
    }
    self.send(
      GpuCommand.SubmitExtra {
        job: move job,
        textures: List<TextureInfo>.make(),
        uploads: Pending.make(),
      },
    )
  }

  /// Enqueues 2-step async surface teardown for a secondary-group window.
  pub fn closeSurface(
    self: &Self,
    surface: u32,
    window: WindowId,
    platform: Option<PlatformClient>,
  ) -> () {
    self.send(GpuCommand.CloseSurface { surface: surface, window: window, platform: move platform })
  }

  /// Pushes compositor-resolved scrolls and layer overrides without repacking scene instances.
  pub effect fn applyProperties(
    self: &Self,
    windowId: WindowId,
    activeEpoch: u64,
    scrolls: &[ScrollPosition],
    overrides: &[LayerOverride],
  ) -> ()
    ! OutOfMemoryError {
    let mut heap = Allocator.systemAllocatorProvider()
    let mut sCopy = List<ScrollPosition>.make()
    run sCopy.appendSlice(scrolls) |> Effect.provideMut<Allocator>(&mut heap)
    let mut oCopy = List<LayerOverride>.make()
    run oCopy.appendSlice(overrides) |> Effect.provideMut<Allocator>(&mut heap)
    self.send(
      GpuCommand.ApplyProperties {
        windowId: windowId,
        activeEpoch: activeEpoch,
        scrolls: move sCopy,
        overrides: move oCopy,
      },
    )
  }

  /// Forwards a keyframe or delta layer commit to the GPU thread.
  pub fn commitLayers(self: &Self, commit: LayerCommit) -> () {
    self.send(GpuCommand.CommitLayers { commit: move commit })
  }
}

/// Small scalar/telemetry state shared briefly for host queries (never held during GPU present).
struct Status {
  spare: Option<Scene>,
  quit: bool,
  ready: bool,
  format: u32,
  failure: Option<GpuError>,
  report: RenderReport,
  presented: List<f64>,
  dropped: u64,
  grabbed: Option<Grab>,
  submittedGen: u64,
  takenGen: u64,
  redrawSubmittedGen: u64,
  redrawCompletedGen: u64,
  surfaceOpened: List<OpenedSurface>,
  uiWake: Option<WakeHandle>,
}

impl Transferable for Status {}

/// A copy of a frame the render thread drew, read back from the GPU (see
/// [`RenderThread.grab`]). `rows` holds `height` rows of `stride` bytes each, the first
/// `width * 4` of them the row's pixels, in BGRA order when `bgra` is set and RGBA otherwise.
/// `ok` is false, and `rows` empty, when the surface cannot be read back.
pub struct Grab {
  pub rows: List<u8>,
  pub stride: u32,
  pub width: u32,
  pub height: u32,
  pub bgra: bool,
  pub ok: bool,
}

impl Transferable for Grab {}

/// The GPU side of one window, running on its own thread.
pub struct RenderThread {
  shared: Arc<Mutex<Status>>,
  /// The UI thread sleeps here while waiting for initialization, waitFrames, or grab/taken sync.
  parker: Parker,
  wakeUi: Unparker,
  cmdTx: UnboundedSender<GpuCommand>,
  handle: Option<JoinHandle<i32>>,
  /// Shared monotonic surface id counter so primary and secondary group surfaces never collide.
  nextSurface: Arc<Mutex<u32>>,
  /// The frames of GPU canvases (see `canvas_frames`).
  canvases: CanvasPresenter,
  submittedGen: u64,
  redrawSubmittedGen: u64,
}

impl Transferable for RenderThread {}

impl RenderThread {
  /// Starts the render thread for the window's surface `raw`, then waits until its GPU device
  /// is ready. Fails with the thread's error when the surface or device cannot be made.
  pub effect fn start(raw: RawSurface, window: WindowId, settings: RenderSettings) -> RenderThread
    ! GpuError | OutOfMemoryError {
    let mut thread = run RenderThread.prepare(settings, String.make())
    run thread.attach(raw, window)
    return move thread
  }

  /// Starts the render thread before there is a window. It makes the GPU device and the
  /// renderer's pipelines while the caller opens the window and builds its first frame, which
  /// is most of a window's startup; [`RenderThread.attach`] then hands it the window's surface.
  /// With a `cache` directory, the device keeps its translated shaders and pipelines there,
  /// which makes the pipelines of later runs faster.
  pub effect fn prepare(settings: RenderSettings, cache: String) -> RenderThread
    ! GpuError | OutOfMemoryError {
    let mut heap = Allocator.systemAllocatorProvider()
    let shared = run makeStatus() |> Effect.provideMut<Allocator>(&mut heap)
    let parker = run Parker.make() |> Effect.provideMut<Allocator>(&mut heap)
    let wakeUi = parker.unparker()
    let gpuWaiter = run Waiter.make()
    let cmdPair = run UnboundedChannel.make<GpuCommand>(gpuWaiter.handle())
    let UnboundedPair<GpuCommand> { sender: cmdTx, receiver: cmdRx } = move cmdPair
    let canvases = run CanvasPresenter.make(Option<Unparker>.some(gpuWaiter.unparker()))
      |> Effect.provideMut<Allocator>(&mut heap)
    if settings.check {
      canvases.keepLatest()
    }
    let theirs = shared.clone()
    let threadWakeUi = wakeUi.clone()
    let threadWaiter = move gpuWaiter
    let threadCmdRx = move cmdRx
    let theirCanvases = canvases.clone()
    let spawned = run Effect.result(
      NativeThread.spawn(
        || -> i32 {
          let shared = move theirs
          let wakeUi = move threadWakeUi
          let waiter = move threadWaiter
          let mut cmdRx = move threadCmdRx
          let cache = move cache
          let canvases = move theirCanvases
          return renderMain(&shared, &wakeUi, &waiter, &mut cmdRx, settings, String.view(&cache), &canvases)
        },
      ),
    )
      |> Effect.provideMut<Allocator>(&mut heap)
    let handle = match move spawned {
      Result.Success { value } => move value
      Result.Failure { error } => match move error {
        SpawnError failure => {
          StderrWriter.print("ui-tree: the render thread could not start\n", &())
          fail GpuError.status(i32.wrappingToU32(failure.code))
        }
        OutOfMemoryError failure => {
          fail move failure
        }
      }
    }
    let nextSurface = run createSurfaceCounter() |> Effect.provideMut<Allocator>(&mut heap)
    return RenderThread {
      shared: move shared,
      parker: move parker,
      wakeUi: move wakeUi,
      cmdTx: move cmdTx,
      handle: Option<JoinHandle<i32>>.some(move handle),
      nextSurface: move nextSurface,
      canvases: move canvases,
      submittedGen: 0,
      redrawSubmittedGen: 0,
    }
  }

  /// Gives a thread from [`RenderThread.prepare`] the surface `raw` of `window`, then waits until
  /// the surface is set up. Fails with the thread's error when the surface or device cannot be
  /// made.
  pub effect fn attach(self: &mut Self, raw: RawSurface, window: WindowId) -> ()
    ! GpuError {
    self.sendCmd(GpuCommand.AttachPrimary { surface: SurfaceHandle { raw: raw, window: window } })
    run self.waitReady()
  }

  /// The handle apps present GPU canvas frames through (see `canvas_frames`).
  pub fn canvasPresenter(self: &Self) -> CanvasPresenter {
    return self.canvases.clone()
  }

  /// Returns a transferable handle to enqueue scroll updates and surface commands directly on the GPU thread.
  pub fn gpuHandle(self: &Self) -> GpuHandle {
    return GpuHandle { cmdTx: self.cmdTx.clone(), nextSurface: self.nextSurface.clone() }
  }

  /// Routes GPU present and surface lifecycle events to `tx` (typically the compositor thread).
  pub fn setEventSink(self: &mut Self, tx: UnboundedSender<GpuEvent>) -> () {
    self.sendCmd(GpuCommand.SetEventSink { tx: move tx })
  }

  /// Registers an optional waker for non-compositing hosts awaiting async surface answers.
  pub fn setUiWake(self: &mut Self, wake: WakeHandle) -> () {
    let mut guard = self.shared.get().lock()
    let state = guard.getMut()
    state.uiWake = Option<WakeHandle>.some(move wake)
  }

  /// The surface's texture format, chosen by the render thread.
  pub fn format(self: &Self) -> u32 {
    return self.shared.get().lock().get().format
  }

  fn sendCmd(self: &Self, cmd: GpuCommand) -> () {
    drop run Effect.result(self.cmdTx.send(move cmd))
  }

  effect fn waitReady(self: &mut Self) -> ()
    ! GpuError {
    while true {
      let ready = readyOrFailed(&self.shared)
      if ready {
        break
      }
      self.parker.park()
    }
    run raise(&self.shared)
  }

  /// Hands a finished frame to the GPU thread over the lock-free command channel and returns.
  pub effect fn submit(
    self: &mut Self,
    scene: &Scene,
    atlas: &Atlas,
    uploads: &Pending,
    width: u32,
    height: u32,
    compare: bool,
    expected: &[u8],
    moves: &[Move],
    commitEpoch: u64,
    consumedInputSeq: u64,
  ) -> ()
    ! GpuError | OutOfMemoryError {
    run raise(&self.shared)
    let mut heap = Allocator.systemAllocatorProvider()
    let mut copy = match move takeSpare(&self.shared) {
      Option<Scene>.Some { value } => move value
      Option<Scene>.None => Scene.make()
    }
    run copy.copyDrawnFrom(scene) |> Effect.provideMut<Allocator>(&mut heap)
    let mut textures = List<TextureInfo>.make()
    let mut i: usize = 0
    while i < atlas.textureCount() {
      run textures.append(atlas.texture(i)) |> Effect.provideMut<Allocator>(&mut heap)
      i = i + 1
    }
    let mut uploadCopy = Pending.make()
    run uploadCopy.appendAll(uploads) |> Effect.provideMut<Allocator>(&mut heap)
    let mut reference = List<u8>.make()
    if compare {
      run reference.appendSlice(expected) |> Effect.provideMut<Allocator>(&mut heap)
    }
    let mut moveCopy = List<Move>.make()
    run moveCopy.appendSlice(moves) |> Effect.provideMut<Allocator>(&mut heap)
    self.submittedGen = self.submittedGen + 1
    let gen = self.submittedGen
    setSubmittedGen(&self.shared, gen)
    let job = FrameJob {
      scene: move copy,
      width: width,
      height: height,
      expected: move reference,
      compare: compare,
      moves: move moveCopy,
      commitEpoch: commitEpoch,
      consumedInputSeq: consumedInputSeq,
      atlasFrame: atlas.frame(),
    }
    self.sendCmd(
      GpuCommand.SubmitPrimary {
        job: move job,
        textures: move textures,
        uploads: move uploadCopy,
        gen: gen,
      },
    )
  }

  /// Queues surface creation for a secondary window asynchronously and returns its assigned id.
  /// Completion arrives via `GpuEvent.SurfaceOpened` (or `takeSurfaceOpened` without compositor).
  pub effect fn openSurfaceAsync(self: &mut Self, raw: RawSurface, window: WindowId) -> u32
    ! GpuError | OutOfMemoryError {
    run raise(&self.shared)
    let surface = allocateSurfaceId(&self.nextSurface)
    self.sendCmd(GpuCommand.OpenSurface { surface: surface, raw: raw, window: window })
    return surface
  }

  /// Hands a finished frame of a secondary window to the GPU thread without blocking.
  pub effect fn submitTo(
    self: &mut Self,
    surface: u32,
    scene: &Scene,
    atlas: &Atlas,
    uploads: &Pending,
    width: u32,
    height: u32,
  ) -> ()
    ! GpuError | OutOfMemoryError {
    run raise(&self.shared)
    let mut heap = Allocator.systemAllocatorProvider()
    let mut copy = Scene.make()
    run copy.copyDrawnFrom(scene) |> Effect.provideMut<Allocator>(&mut heap)
    let mut textures = List<TextureInfo>.make()
    let mut i: usize = 0
    while i < atlas.textureCount() {
      run textures.append(atlas.texture(i)) |> Effect.provideMut<Allocator>(&mut heap)
      i = i + 1
    }
    let mut uploadCopy = Pending.make()
    run uploadCopy.appendAll(uploads) |> Effect.provideMut<Allocator>(&mut heap)
    let job = ExtraJob {
      surface: surface,
      scene: move copy,
      width: width,
      height: height,
      commitEpoch: 0,
      atlasFrame: atlas.frame(),
      ownAtlas: false,
      infos: List<TextureInfo>.make(),
      uploads: Pending.make(),
    }
    self.sendCmd(GpuCommand.SubmitExtra { job: move job, textures: move textures, uploads: move uploadCopy })
  }

  /// Enqueues 2-step async teardown: GPU unconfigures & drops Dawn surface before closing OS window.
  pub fn closeSurfaceAsync(
    self: &mut Self,
    surface: u32,
    window: WindowId,
    platform: Option<PlatformClient>,
  ) -> () {
    self.sendCmd(GpuCommand.CloseSurface { surface: surface, window: window, platform: move platform })
  }

  /// Drains surface-open completions when running without a compositor event sink.
  pub effect fn takeSurfaceOpened(self: &mut Self, out: &mut List<OpenedSurface>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut guard = self.shared.get().lock()
    let state = guard.getMut()
    run out.appendSlice(state.surfaceOpened.asSlice())
    state.surfaceOpened.clear()
  }

  /// What the render thread last reported.
  pub fn report(self: &Self) -> RenderReport {
    return self.shared.get().lock().get().report
  }

  /// Shows or hides the Metal Performance HUD over the window's frames (macOS 13 and later;
  /// elsewhere nothing happens).
  pub fn setMetalHud(self: &mut Self, on: bool) -> () {
    self.sendCmd(GpuCommand.SetMetalHud { on: on })
  }

  /// Presents each frame immediately (`on`) instead of waiting for display refresh.
  pub fn setUncapped(self: &mut Self, on: bool) -> () {
    self.sendCmd(GpuCommand.SetUncapped { on: on })
  }

  /// Asks for a readback copy of the primary window's next frame.
  pub fn grab(self: &mut Self) -> () {
    self.redrawSubmittedGen = self.redrawSubmittedGen + 1
    let gen = self.redrawSubmittedGen
    setRedrawSubmittedGen(&self.shared, gen)
    self.sendCmd(GpuCommand.GrabFrame)
  }

  /// Lets GPU canvases show in their own compositor layers when eligible.
  pub fn allowCanvasLayers(self: &mut Self, on: bool) -> () {
    self.sendCmd(GpuCommand.AllowCanvasLayers { on: on })
  }

  pub fn beginFrame(self: &mut Self) -> () {
    self.sendCmd(GpuCommand.BeginFrame)
  }

  pub fn endFrame(self: &mut Self) -> () {
    self.sendCmd(GpuCommand.EndFrame)
  }

  /// Redraws the primary window's last scene at updated `positions` / `moves`.
  pub effect fn rescroll(
    self: &mut Self,
    positions: &[ScrollPosition],
    commitEpoch: u64,
    moves: &[Move],
    updateMoves: bool,
    consumedInputSeq: u64,
  ) -> ()
    ! GpuError | OutOfMemoryError {
    run raise(&self.shared)
    let mut heap = Allocator.systemAllocatorProvider()
    let mut posCopy = List<ScrollPosition>.make()
    run posCopy.appendSlice(positions) |> Effect.provideMut<Allocator>(&mut heap)
    let mut moveCopy = List<Move>.make()
    if updateMoves {
      run moveCopy.appendSlice(moves) |> Effect.provideMut<Allocator>(&mut heap)
    }
    self.redrawSubmittedGen = self.redrawSubmittedGen + 1
    let gen = self.redrawSubmittedGen
    setRedrawSubmittedGen(&self.shared, gen)
    self.sendCmd(
      GpuCommand.RescrollPrimary {
        positions: move posCopy,
        commitEpoch: commitEpoch,
        moves: move moveCopy,
        updateMoves: updateMoves,
        consumedInputSeq: consumedInputSeq,
        gen: gen,
      },
    )
  }

  pub fn rescrolls(self: &Self) -> bool {
    return true
  }

  /// Whether a redraw asked for (`rescroll` / `grab`) still waits for the GPU thread.
  pub fn redrawPending(self: &Self) -> bool {
    let guard = self.shared.get().lock()
    let state = guard.get()
    return state.redrawSubmittedGen > state.redrawCompletedGen
  }

  pub fn waitRedrawn(self: &mut Self) -> () {
    while self.redrawPending() && !stopped(&self.shared) {
      self.parker.park()
    }
  }

  /// The frame copy [`RenderThread.grab`] asked for, once it is drawn, or None until then.
  pub fn takeGrab(self: &mut Self) -> Option<Grab> {
    let mut guard = self.shared.get().lock()
    return Intrinsic.replace(guard.getMut().grabbed, Option<Grab>.None)
  }

  /// Waits until the render thread has dequeued the last frame handed over, or has stopped.
  pub fn waitTaken(self: &mut Self) -> () {
    while self.pending() && !stopped(&self.shared) {
      self.parker.park()
    }
  }

  /// Whether the last frame handed over still waits in the GPU command channel.
  pub fn pending(self: &Self) -> bool {
    let guard = self.shared.get().lock()
    let state = guard.get()
    return state.submittedGen > state.takenGen
  }

  /// Moves the milliseconds between the presents since the last call into `out`, oldest
  /// first, and returns how many handed-over frames were replaced undrawn since then.
  pub effect fn takePresented(self: &mut Self, out: &mut List<f64>) -> u64
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut guard = self.shared.get().lock()
    let state = guard.getMut()
    run out.appendSlice(state.presented.asSlice())
    state.presented.clear()
    let dropped = state.dropped
    state.dropped = 0
    return dropped
  }

  /// Waits until `frames` frames have been presented, or the render thread stopped on an error.
  pub effect fn waitFrames(self: &mut Self, frames: u64) -> RenderReport
    ! GpuError {
    while true {
      if presentedOrStopped(&self.shared, frames) {
        break
      }
      self.parker.park()
    }
    run raise(&self.shared)
    return self.report()
  }

  /// As [`RenderThread.waitFrames`], counting only frames the UI thread painted.
  pub effect fn waitPainted(self: &mut Self, frames: u64) -> RenderReport
    ! GpuError {
    while true {
      if paintedOrStopped(&self.shared, frames) {
        break
      }
      self.parker.park()
    }
    run raise(&self.shared)
    return self.report()
  }

  /// Stops the GPU thread cleanly and joins it.
  pub fn stop(self: &mut Self) -> () {
    requestQuit(&self.shared)
    self.sendCmd(GpuCommand.Quit)
    self.cmdTx.close()
    match move Intrinsic.replace(self.handle, Option<JoinHandle<i32>>.None) {
      Option<JoinHandle<i32>>.Some { value } => {
        drop value.join()
      }
      Option<JoinHandle<i32>>.None => ()
    }
  }
}

// A host that fails before it gives the thread a surface drops it while it waits for one.
impl Drop for RenderThread {
  fn drop(self: &mut Self) -> () {
    self.stop()
  }
}

fn readyOrFailed(shared: &Arc<Mutex<Status>>) -> bool {
  let guard = shared.get().lock()
  return guard.get().ready || Option<GpuError>.isSome(&guard.get().failure) || guard.get().quit
}

fn presentedOrStopped(shared: &Arc<Mutex<Status>>, frames: u64) -> bool {
  let guard = shared.get().lock()
  let state = guard.get()
  return state.report.frames >= frames || Option<GpuError>.isSome(&state.failure) || state.quit
}

fn paintedOrStopped(shared: &Arc<Mutex<Status>>, frames: u64) -> bool {
  let guard = shared.get().lock()
  let state = guard.get()
  return state.report.painted >= frames || Option<GpuError>.isSome(&state.failure) || state.quit
}

fn requestQuit(shared: &Arc<Mutex<Status>>) -> () {
  let mut guard = shared.get().lock()
  let state = guard.getMut()
  state.quit = true
}

fn setSubmittedGen(shared: &Arc<Mutex<Status>>, gen: u64) -> () {
  let mut guard = shared.get().lock()
  let state = guard.getMut()
  state.submittedGen = gen
}

fn setRedrawSubmittedGen(shared: &Arc<Mutex<Status>>, gen: u64) -> () {
  let mut guard = shared.get().lock()
  let state = guard.getMut()
  state.redrawSubmittedGen = gen
}

fn recordSurfaceAnswer(shared: &Arc<Mutex<Status>>, answer: OpenedSurface) -> () {
  let mut heap = Allocator.systemAllocatorProvider()
  let mut guard = shared.get().lock()
  let state = guard.getMut()
  drop run Effect.result(state.surfaceOpened.append(answer)) |> Effect.provideMut<Allocator>(&mut heap)
}

fn recordTakenAndDropped(shared: &Arc<Mutex<Status>>, takenGen: u64, batchDropped: u64) -> () {
  let mut guard = shared.get().lock()
  let values = guard.getMut()
  if takenGen > values.takenGen {
    values.takenGen = takenGen
  }
  if batchDropped != 0 {
    values.dropped = values.dropped + batchDropped
    values.report.dropped = values.report.dropped + batchDropped
  }
}

fn takeSpare(shared: &Arc<Mutex<Status>>) -> Option<Scene> {
  let mut guard = shared.get().lock()
  return Intrinsic.replace(guard.getMut().spare, Option<Scene>.None)
}

/// Fails with the render thread's error, if it stopped on one.
effect fn raise(shared: &Arc<Mutex<Status>>) -> ()
  ! GpuError {
  let failure = takeFailure(shared)
  match move failure {
    Option<GpuError>.Some { value } => {
      fail move value
    }
    Option<GpuError>.None => ()
  }
}

fn takeFailure(shared: &Arc<Mutex<Status>>) -> Option<GpuError> {
  let mut guard = shared.get().lock()
  return Intrinsic.replace(guard.getMut().failure, Option<GpuError>.None)
}

fn stopped(shared: &Arc<Mutex<Status>>) -> bool {
  return shared.get().lock().get().quit
}

effect fn makeStatus() -> Arc<Mutex<Status>>
  ! OutOfMemoryError
  ? &mut Allocator {
  let status = Status {
    spare: Option<Scene>.None,
    quit: false,
    ready: false,
    format: 0,
    failure: Option<GpuError>.None,
    report: RenderReport.none(),
    presented: List<f64>.make(),
    dropped: 0,
    grabbed: Option<Grab>.None,
    submittedGen: 0,
    takenGen: 0,
    redrawSubmittedGen: 0,
    redrawCompletedGen: 0,
    surfaceOpened: List<OpenedSurface>.make(),
    uiWake: Option<WakeHandle>.None,
  }
  return run Arc<Mutex<Status>>.make(run Mutex<Status>.make(move status))
}

/// The thread's body: runs the loop and passes its error, if any, to the UI thread.
fn renderMain(
  shared: &Arc<Mutex<Status>>,
  wakeUi: &Unparker,
  waiter: &Waiter,
  cmdRx: &mut UnboundedReceiver<GpuCommand>,
  settings: RenderSettings,
  cache: string,
  canvases: &CanvasPresenter,
) -> i32 {
  let mut heap = Allocator.systemAllocatorProvider()
  let result = run Effect.result(renderLoop(shared, wakeUi, waiter, &mut cmdRx, settings, cache, canvases))
    |> Effect.provideMut<Allocator>(&mut heap)
  let failure = match move result {
    Result.Success { value } => {
      drop value
      requestQuit(shared)
      wakeUi.unpark()
      return 0
    }
    Result.Failure { error } => match move error {
      GpuError failure => move failure
      OutOfMemoryError failure => {
        drop failure
        GpuError.status(0)
      }
    }
  }
  recordFailure(shared, move failure)
  wakeUi.unpark()
  return 2
}

fn recordFailure(shared: &Arc<Mutex<Status>>, failure: GpuError) -> () {
  let mut guard = shared.get().lock()
  let values = guard.getMut()
  values.failure = Option<GpuError>.some(move failure)
  values.quit = true
}

/// Whether the render thread draws the current frame again with no new frame from the UI
/// thread: the compositor asked for it (`redraw`), or a canvas presented a frame
/// (`canvasWaiting`) while the UI thread makes none (`framing`: its frame draws the canvas too).
pub fn redrawsAlone(redraw: bool, canvasWaiting: bool, framing: bool) -> bool {
  return redraw || canvasWaiting && !framing
}

/// The renderer's texture for one GPU canvas surface: one it uploads pixel frames into, or the
/// shared images of the surface's swap chain it imported, one of which it samples.
struct CanvasTexture {
  surface: u32,
  width: u32,
  height: u32,
  texture: Option<Texture>,
  imports: List<ImportedImage>,
  /// The import the renderer samples, with access begun, or `usize.MAX`.
  shown: usize,
}

/// A shared image of a canvas's swap chain, imported on the renderer's device.
struct ImportedImage {
  image: Arc<ChainImage>,
  chain: u32,
  index: u32,
  memory: SharedTextureMemory,
  texture: Texture,
  /// The app's fences the access waited for, kept until it ends.
  fences: List<SharedFence>,
}

fn canvasTextureIndex(shown: &List<CanvasTexture>, surface: u32) -> usize {
  let values = shown.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i].surface == surface {
      return i
    }
    i = i + 1
  }
  return usize.MAX
}

/// Ends the access to the image `entry` samples. With `giveBack` the image goes back to the
/// app with the renderer's fences, to draw into once they signaled.
effect fn endShown(entry: &mut CanvasTexture, canvases: &CanvasPresenter, giveBack: bool) -> ()
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  if entry.shown == usize.MAX {
    return ()
  }
  let image = &mut entry.imports.asMutSlice()[entry.shown]
  entry.shown = usize.MAX
  let end = run image.memory.endAccess(&image.texture, false)
  image.fences = List<SharedFence>.make()
  if giveBack {
    run canvases.giveBack(
      ReturnedImage {
        surface: entry.surface,
        chain: image.chain,
        index: image.index,
        fences: move end.fences,
        values: move end.signaledValues,
      },
    )
  }
}

/// Shows shared frame `frame` of `entry`: imports its image the first time, waits on the GPU
/// for the app's fences, samples it, and gives the image it replaces back to the app.
effect fn showShared(
  canvases: &CanvasPresenter,
  device: &Device,
  renderer: &mut UiRenderer,
  entry: &mut CanvasTexture,
  frame: &CanvasFrame,
) -> ()
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  if let Option<SharedPicture>.Some { value } = &frame.shared {
    run showPicture(canvases, device, &mut renderer, &mut entry, frame.surface, &value)
  }
}

effect fn showPicture(
  canvases: &CanvasPresenter,
  device: &Device,
  renderer: &mut UiRenderer,
  entry: &mut CanvasTexture,
  surface: u32,
  picture: &SharedPicture,
) -> ()
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  while at < entry.imports.length()
    && (entry.imports.asSlice()[at].chain != picture.chain || entry.imports.asSlice()[at].index != picture.index) {
    at = at + 1
  }
  if at == entry.imports.length() {
    let memory = run SharedTextureMemory.importImage(device, b"ui canvas", &picture.image.get().image)
    let texture = run memory.createTexture(b"ui canvas")
    run entry.imports.append(
      ImportedImage {
        image: picture.image.clone(),
        chain: picture.chain,
        index: picture.index,
        memory: move memory,
        texture: move texture,
        fences: List<SharedFence>.make(),
      },
    )
  }
  // A fence belongs to the device that made it: this device imports the app's.
  let mut fences = List<SharedFence>.make()
  let given = picture.fences.asSlice()
  let mut f: usize = 0
  while f < given.length {
    let info = given[f].exportInfo()
    run fences.append(run SharedFence.importMtlSharedEvent(device, info.handle))
    f = f + 1
  }
  let image = &mut entry.imports.asMutSlice()[at]
  run image.memory.beginAccessAfter(&image.texture, BeginAccess.ready(), fences.asSlice(), picture.values.asSlice())
  image.fences = move fences
  let view = run image.texture.createView(&TextureViewDescriptor.default())
  run renderer.setSurface(surface, &view)
  run endShown(&mut entry, canvases, true)
  // Images of chains the app replaced (a resize) are not shown again.
  let mut i: usize = 0
  let mut kept = at
  while i < entry.imports.length() {
    if entry.imports.asSlice()[i].chain != picture.chain {
      drop entry.imports.remove(i)
      if i < kept {
        kept = kept - 1
      }
    } else {
      i = i + 1
    }
  }
  entry.shown = kept
}

/// Shows canvas frame `frame` drawn into the window: uploads a pixel frame into a texture of the
/// renderer's device, or samples a shared one in place.
effect fn showInWindow(
  canvases: &CanvasPresenter,
  device: &Device,
  queue: &Queue,
  renderer: &mut UiRenderer,
  shown: &mut List<CanvasTexture>,
  frame: &CanvasFrame,
) -> ()
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let isShared = frame.shared.isSome()
  let mut at = canvasTextureIndex(&shown.*, frame.surface)
  if at != usize.MAX
    && (shown.asSlice()[at].width != frame.width || shown.asSlice()[at].height != frame.height
      || shown.asSlice()[at].texture.isSome() == isShared) {
    // The old picture stays on screen until the new one is bound below.
    run endShown(&mut shown.asMutSlice()[at], canvases, true)
    if !isShared {
      renderer.removeSurface(frame.surface)
    }
    drop shown.remove(at)
    at = usize.MAX
  }
  if at == usize.MAX {
    let mut texture = Option<Texture>.None
    if !isShared {
      let mut size = Extent3D.default()
      size.setWidth(frame.width)
      size.setHeight(frame.height)
      size.setDepthOrArrayLayers(1)
      let mut descriptor = TextureDescriptor.default().withLabel(b"ui canvas")
      descriptor.setSize(size)
      descriptor.setFormat(flags.WGPUTextureFormat_RGBA8Unorm)
      descriptor.setDimension(flags.WGPUTextureDimension_2D)
      descriptor.setMipLevelCount(1)
      descriptor.setSampleCount(1)
      descriptor.setUsage(flags.WGPUTextureUsage_TextureBinding | flags.WGPUTextureUsage_CopyDst)
      let made = run createTexture(device, &descriptor)
      let view = run made.createView(&TextureViewDescriptor.default())
      run renderer.setSurface(frame.surface, &view)
      texture = Option<Texture>.some(move made)
    }
    at = shown.length()
    run shown.append(
      CanvasTexture {
        surface: frame.surface,
        width: frame.width,
        height: frame.height,
        texture: move texture,
        imports: List<ImportedImage>.make(),
        shown: usize.MAX,
      },
    )
  }
  if isShared {
    run showShared(canvases, device, &mut renderer, &mut shown.asMutSlice()[at], frame)
  } else {
    let mut size = Extent3D.default()
    size.setWidth(frame.width)
    size.setHeight(frame.height)
    size.setDepthOrArrayLayers(1)
    let mut layout = TexelCopyBufferLayout.default()
    layout.setBytesPerRow(frame.width * 4)
    layout.setRowsPerImage(frame.height)
    match &shown.asSlice()[at].texture {
      Option<Texture>.Some { value } => {
        queue.writeTexture(
          &TexelCopyTextureInfo.default().withTexture(&value),
          frame.pixels.asSlice(),
          &layout,
          &size,
        )
      }
      Option<Texture>.None => ()
    }
  }
}

/// Takes the canvas frames presented since the last call: frames of canvases drawn into the
/// window go to the renderer's textures (`showInWindow`), frames of canvases shown in a layer of
/// their own wait in `layered` for their fences (`serviceLayers`). Answers how many frames of
/// canvases drawn into the window it took: when not 0, the window must be drawn.
effect fn serveCanvases(
  canvases: &CanvasPresenter,
  device: &Device,
  queue: &Queue,
  renderer: &mut UiRenderer,
  shown: &mut List<CanvasTexture>,
  layered: &mut List<LayeredCanvas>,
) -> u64
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  if !canvases.waiting() {
    return 0
  }
  let mut window: u64 = 0
  let mut taken = canvases.take()
  let closed = taken.closed.asSlice()
  let mut c: usize = 0
  while c < closed.length {
    renderer.removeSurface(closed[c])
    let at = canvasTextureIndex(&shown.*, closed[c])
    if at != usize.MAX {
      run endShown(&mut shown.asMutSlice()[at], canvases, false)
      drop shown.remove(at)
    }
    let inLayer = layeredIndex(&layered.*, closed[c])
    if inLayer != usize.MAX {
      // Its chain is gone with the canvas: nothing goes back.
      drop layered.remove(inLayer)
    }
    c = c + 1
  }
  let mut frames = Intrinsic.replace(taken.frames, List<CanvasFrame>.make())
  while frames.length() > 0 {
    let frame = frames.remove(0)
    let inLayer = layeredIndex(&layered.*, frame.surface)
    if inLayer != usize.MAX && frame.shared.isSome() {
      let entry = &mut layered.asMutSlice()[inLayer]
      if let Option<SharedPicture>.Some { value } = move frame.shared {
        // A frame not shown yet goes back unseen: the app never shared it with anyone.
        if let Option<SharedPicture>.Some { value: older } = Intrinsic.replace(entry.pending, Option<SharedPicture>.some(move value)) {
          run canvases.giveBack(ReturnedImage { surface: entry.surface, chain: older.chain, index: older.index, fences: List<SharedFence>.make(), values: List<u64>.make() })
        }
      }
    } else {
      if inLayer != usize.MAX {
        // Pixels cannot go into a layer: the canvas is drawn into the window again.
        drop layered.remove(inLayer)
      }
      run showInWindow(canvases, device, queue, &mut renderer, &mut shown, &frame)
      window = window + 1
    }
  }
  return window
}

/// A picture of a canvas's swap chain a layer shows, or showed.
struct LayerPicture {
  surface: u32,
  image: Arc<ChainImage>,
  chain: u32,
  index: u32,
}

/// A GPU canvas shown in a compositor layer of its own (canvas_layer_plan.silk): its layer, where
/// the last frame job placed it, the picture it shows and the one waiting for its fences.
struct LayeredCanvas {
  surface: u32,
  layer: CanvasLayer,
  state: CanvasLayerState,
  /// The place changed since it was last given to the layer.
  moved: bool,
  current: Option<LayerPicture>,
  pending: Option<SharedPicture>,
}

fn layeredIndex(layered: &List<LayeredCanvas>, surface: u32) -> usize {
  let values = layered.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i].surface == surface {
      return i
    }
    i = i + 1
  }
  return usize.MAX
}

/// Shows the pictures of layered canvases whose fences signaled (one transaction for all), and
/// gives the app back the pictures layers replaced once the window server no longer reads them.
/// Answers how soon to look again, in nanoseconds (`layerPollDelay`): 0 when nothing waits.
effect fn serviceLayers(
  canvases: &CanvasPresenter,
  layered: &mut List<LayeredCanvas>,
  retired: &mut List<LayerPicture>,
) -> u64
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut waiting = false
  let mut open = false
  let entries = layered.asMutSlice()
  let mut i: usize = 0
  while i < entries.length {
    let entry = &mut entries[i]
    let mut ready = false
    if let Option<SharedPicture>.Some { value } = &entry.pending {
      let mut states = List<i32>.make()
      let fences = value.fences.asSlice()
      let mut f: usize = 0
      while f < fences.length {
        run states.append(fences[f].poll(value.values.asSlice()[f]))
        f = f + 1
      }
      ready = pictureReady(states.asSlice())
      waiting = waiting || !ready
    }
    if ready {
      if let Option<SharedPicture>.Some { value } = Intrinsic.replace(entry.pending, Option<SharedPicture>.None) {
        if !open {
          canvas_layers.begin()
          open = true
        }
        unsafe entry.layer.set(&entry.state, unsafe value.image.get().image.ioSurface())
        entry.moved = false
        if entry.current.isNone() && canvases.announcing() {
          // What Core Animation holds for the layer, once: whether it can be on screen at all.
          let mut text: [u8; 512] = [0; 512]
          let length = entry.layer.describe(&mut text)
          if let Result<string, InvalidUtf8>.Success { value: line } = String.fromUtf8(Slice.view(&text, 0, length)) {
            StderrWriter.print("silk-ui: canvas layer {}: {}\n", &(entry.surface, line))
          }
        }
        let shown = LayerPicture { surface: entry.surface, image: value.image.clone(), chain: value.chain, index: value.index }
        if let Option<LayerPicture>.Some { value: replaced } = Intrinsic.replace(entry.current, Option<LayerPicture>.some(move shown)) {
          run retired.append(move replaced)
        }
        canvases.layerShown()
        canvases.noteShown(1)
      }
    }
    i = i + 1
  }
  if open {
    canvas_layers.commit()
  }
  let mut r: usize = 0
  while r < retired.length() {
    if retired.asSlice()[r].image.get().image.inUse() {
      r = r + 1
    } else {
      let done = retired.remove(r)
      run canvases.giveBack(ReturnedImage { surface: done.surface, chain: done.chain, index: done.index, fences: List<SharedFence>.make(), values: List<u64>.make() })
    }
  }
  return layerPollDelay(waiting, retired.length() != 0)
}

/// Decides, for a new frame job, which canvases show in a layer of their own
/// (`canvas_layer_plan.wantsLayer`), and moves them:
///
/// - Into a layer: its layer is made now and shows the canvas's next frame; until then the window
///   keeps drawing the canvas, which the layer then covers.
/// - Back into the window: the picture its layer shows is drawn into the window from this job on,
///   and the layer goes.
///
/// Says whether the window draw changed for it (a canvas left a layer or its first layer picture
/// replaced the window's).
effect fn planLayers(
  scene: &Scene,
  placements: &mut List<SurfacePlacement>,
  canvases: &CanvasPresenter,
  device: &Device,
  renderer: &mut UiRenderer,
  shown: &mut List<CanvasTexture>,
  layered: &mut List<LayeredCanvas>,
  metalLayer: ?*mut u8,
  allowed: bool,
) -> ()
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  run surfacePlacements(scene, &mut placements)
  let list = placements.asSlice()
  // Layered canvases that stay get their place; the others go back into the window.
  let mut i: usize = 0
  while i < layered.length() {
    let surface = layered.asSlice()[i].surface
    let change = pathChange(true, wantsLayer(list, surface, true, allowed))
    if change == PATH_TO_WINDOW {
      let leaving = layered.remove(i)
      if let Option<LayerPicture>.Some { value } = &leaving.current {
        let picture = SharedPicture { image: value.image.clone(), chain: value.chain, index: value.index, fences: List<SharedFence>.make(), values: List<u64>.make() }
        let at = canvasTextureIndex(&shown.*, surface)
        if at == usize.MAX {
          run shown.append(CanvasTexture { surface: surface, width: value.image.get().image.width, height: value.image.get().image.height, texture: Option<Texture>.None, imports: List<ImportedImage>.make(), shown: usize.MAX })
        }
        let entry = canvasTextureIndex(&shown.*, surface)
        run showPicture(canvases, device, &mut renderer, &mut shown.asMutSlice()[entry], surface, &picture)
      }
      if let Option<SharedPicture>.Some { value } = &leaving.pending {
        let at = canvasTextureIndex(&shown.*, surface)
        if at == usize.MAX {
          run shown.append(CanvasTexture { surface: surface, width: value.image.get().image.width, height: value.image.get().image.height, texture: Option<Texture>.None, imports: List<ImportedImage>.make(), shown: usize.MAX })
        }
        let entry = canvasTextureIndex(&shown.*, surface)
        run showPicture(canvases, device, &mut renderer, &mut shown.asMutSlice()[entry], surface, &value)
      }
      drop leaving
    } else {
      let entry = &mut layered.asMutSlice()[i]
      let state = layerStateOf(&list[firstOf(list, surface)])
      entry.moved = entry.moved || !sameState(&entry.state, &state)
      entry.state = state
      i = i + 1
    }
  }
  // Canvases drawn into the window from shared images that may now have a layer.
  let mut s: usize = 0
  while s < shown.length() {
    let entry = &shown.asSlice()[s]
    let surface = entry.surface
    let shared = entry.texture.isNone()
    if layeredIndex(&layered.*, surface) == usize.MAX
      && pathChange(false, wantsLayer(list, surface, shared, allowed)) == PATH_TO_LAYER {
      if let Option<CanvasLayer>.Some { value } = unsafe CanvasLayer.create(metalLayer) {
        run layered.append(LayeredCanvas { surface: surface, layer: move value, state: layerStateOf(&list[firstOf(list, surface)]), moved: true, current: Option<LayerPicture>.None, pending: Option<SharedPicture>.None })
      }
    }
    s = s + 1
  }
}

/// The window no longer draws canvases whose layer shows a picture: their window textures go back
/// (`endShown`) and the renderer leaves their sprites out. Says whether that changed the window.
effect fn handOverToLayers(
  canvases: &CanvasPresenter,
  renderer: &mut UiRenderer,
  shown: &mut List<CanvasTexture>,
  layered: &List<LayeredCanvas>,
) -> bool
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let mut changed = false
  let entries = layered.asSlice()
  let mut i: usize = 0
  while i < entries.length {
    if entries[i].current.isSome() {
      let at = canvasTextureIndex(&shown.*, entries[i].surface)
      if at != usize.MAX {
        run endShown(&mut shown.asMutSlice()[at], canvases, true)
        drop shown.remove(at)
        renderer.removeSurface(entries[i].surface)
        changed = true
      }
    }
    i = i + 1
  }
  return changed
}

/// Gives the layers that moved their new place, in one transaction: after the window frame that
/// placed them is presented.
fn placeLayers(layered: &mut List<LayeredCanvas>) -> () {
  let entries = layered.asMutSlice()
  let mut open = false
  let mut i: usize = 0
  while i < entries.length {
    if entries[i].moved && entries[i].current.isSome() {
      if !open {
        canvas_layers.begin()
        open = true
      }
      unsafe entries[i].layer.set(&entries[i].state, Pointer.null<u8>())
      entries[i].moved = false
    }
    i = i + 1
  }
  if open {
    canvas_layers.commit()
  }
}

fn sameState(a: &CanvasLayerState, b: &CanvasLayerState) -> bool {
  return a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height && a.clipX == b.clipX
    && a.clipY == b.clipY && a.clipWidth == b.clipWidth && a.clipHeight == b.clipHeight
    && a.cornerRadius == b.cornerRadius && a.opacity == b.opacity && a.hidden == b.hidden
}

/// A surface of a window past the first, on the render thread.
struct ExtraSurface<'w> {
  id: u32,
  window: WindowId,
  surface: Surface<'w>,
  width: u32,
  height: u32,
  scrolls: List<ScrollPosition>,
  overrides: List<LayerOverride>,
  store: RetainedLayerStore,
  ownTextures: Option<GpuAtlas>,
  ownInfos: List<TextureInfo>,
  ownUploads: Pending,
}

struct GpuScrollEntry {
  node: u32,
  pos: ScrollPosition,
  seq: u64,
}

impl Copy for GpuScrollEntry {}

fn emitGpuEvent(eventTx: &Option<UnboundedSender<GpuEvent>>, event: GpuEvent) -> () {
  if let Option<UnboundedSender<GpuEvent>>.Some { value: tx } = &eventTx.* {
    drop run Effect.result(tx.send(move event))
  }
}

fn wakeNonCompositing(shared: &Arc<Mutex<Status>>, wakeUi: &Unparker) -> () {
  wakeUi.unpark()
  let guard = shared.get().lock()
  if let Option<WakeHandle>.Some { value: wake } = &guard.get().uiWake {
    wake.wake()
  }
}

effect fn processOpenSurface<'w>(
  shared: &Arc<Mutex<Status>>,
  wakeUi: &Unparker,
  eventTx: &Option<UnboundedSender<GpuEvent>>,
  instance: &Instance,
  owner: &'w WindowId,
  surfaces: &mut List<ExtraSurface<'w>>,
  surfaceId: u32,
  raw: RawSurface,
  window: WindowId,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let made = match unsafe targetOf(owner, raw) {
    Option<SurfaceTarget>.Some { value } => {
      let created = run Effect.result(
        Surface.create(instance, &value, String.utf8Bytes("ui tree window")),
      )
      match move created {
        Result.Success { value: surface } => {
          run surfaces.append(
            ExtraSurface<'w> {
              id: surfaceId,
              window: window,
              surface: move surface,
              width: 0,
              height: 0,
              scrolls: List<ScrollPosition>.make(),
              overrides: List<LayerOverride>.make(),
              store: RetainedLayerStore.make(),
              ownTextures: Option<GpuAtlas>.None,
              ownInfos: List<TextureInfo>.make(),
              ownUploads: Pending.make(),
            },
          )
          true
        }
        Result.Failure { error } => {
          drop error
          false
        }
      }
    }
    Option<SurfaceTarget>.None => false
  }
  if eventTx.isSome() {
    emitGpuEvent(eventTx, GpuEvent.SurfaceOpened { surface: surfaceId, window: window, made: made })
  } else {
    recordSurfaceAnswer(shared, OpenedSurface { surface: surfaceId, window: window, made: made })
    wakeNonCompositing(shared, wakeUi)
  }
}

/// Strictly ordered 2-step surface teardown:
/// 1. Unconfigure and drop the Dawn `Surface` (and queued jobs for `surfaceId`).
/// 2. Only afterwards ask the platform thread to destroy the OS window and emit `SurfaceClosed`.
fn processCloseSurface<'w>(
  eventTx: &Option<UnboundedSender<GpuEvent>>,
  surfaces: &mut List<ExtraSurface<'w>>,
  extraJobs: &mut List<ExtraJob>,
  surfaceId: u32,
  window: WindowId,
  platform: Option<PlatformClient>,
) -> () {
  let mut j: usize = 0
  while j < extraJobs.length() {
    if extraJobs.asSlice()[j].surface == surfaceId {
      drop extraJobs.remove(j)
    } else {
      j = j + 1
    }
  }
  let mut i: usize = 0
  while i < surfaces.length() {
    if surfaces.asSlice()[i].id == surfaceId {
      let leaving = surfaces.remove(i)
      leaving.surface.unconfigure()
      drop leaving
    } else {
      i = i + 1
    }
  }
  if let Option<PlatformClient>.Some { value: client } = move platform {
    client.closeWindow(window)
  }
  emitGpuEvent(eventTx, GpuEvent.SurfaceClosed { surface: surfaceId, window: window })
}

/// Writes any queued atlas pixels and syncs atlas texture descriptors on the GPU thread.
effect fn flushUploads(
  uploads: &mut Pending,
  infos: &mut List<TextureInfo>,
  device: &Device,
  queue: &Queue,
  textures: &mut GpuAtlas,
) -> ()
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  if infos.length() != 0 {
    run textures.syncInfos(device, infos.asSlice())
    infos.clear()
  }
  let list = uploads.entries()
  if list.length == 0 {
    return ()
  }
  let mut i: usize = 0
  while i < list.length {
    textures.write(queue, list[i].tile, uploads.pixels(list[i]))
    i = i + 1
  }
  drop Intrinsic.replace(uploads.*, Pending.make())
}

/// Draws the frames of windows past the first that wait, each on its own surface.
effect fn drawOthers<'w>(
  eventTx: &Option<UnboundedSender<GpuEvent>>,
  jobs: &mut List<ExtraJob>,
  device: &Device,
  queue: &Queue,
  renderer: &mut UiRenderer,
  textures: &GpuAtlas,
  surfaces: &mut List<ExtraSurface<'w>>,
  format: u32,
  alphaMode: u32,
  clock: &mut Clock,
) -> bool
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let mut drew = false
  while jobs.length() != 0 {
    let job = jobs.remove(0)
    let mut at = usize.MAX
    let mut i: usize = 0
    while i < surfaces.length() {
      if surfaces.asSlice()[i].id == job.surface {
        at = i
      }
      i = i + 1
    }
    if at == usize.MAX {
      continue
    }
    let targetWin = surfaces.asSlice()[at].window
    if job.width == 0 || job.height == 0 {
      emitGpuEvent(
        eventTx,
        GpuEvent.FramePresented {
          window: targetWin,
          commitEpoch: job.commitEpoch,
          painted: true,
          report: RenderReport.none(),
          dropped: 0,
          atMs: 0.0,
        },
      )
      continue
    }
    let target = &mut surfaces.asMutSlice()[at]
    if job.width != target.width || job.height != target.height {
      let mut configuration = SurfaceConfiguration.make(device, format, job.width, job.height)
      if alphaMode != 0 {
        configuration.setAlphaMode(alphaMode)
      }
      target.surface.configure(&configuration)
      target.width = job.width
      target.height = job.height
    }
    let useOwn = job.ownAtlas
    if useOwn {
      run target.ownUploads.appendAll(&job.uploads)
      if job.infos.length() != 0 {
        target.ownInfos = move job.infos
      }
      if target.ownTextures.isNone() {
        target.ownTextures = Option<GpuAtlas>.some(GpuAtlas.make())
      }
      if let Option<GpuAtlas>.Some { value: ownTex } = &mut target.ownTextures {
        run flushUploads(&mut target.ownUploads, &mut target.ownInfos, device, queue, &mut ownTex)
      }
    }
    let texture = run target.surface.getCurrentTexture()
    let view = run texture.texture.createView(&TextureViewDescriptor.default())
    run renderer.setScrolls(target.scrolls.asSlice())
    run renderer.setLayerOverrides(target.overrides.asSlice())
    if useOwn {
      if let Option<GpuAtlas>.Some { value: ownTex } = &target.ownTextures {
        run renderer.draw(
          device,
          queue,
          &job.scene,
          &ownTex,
          &view,
          job.width,
          job.height,
          color.white(),
        )
      } else {
        run renderer.draw(
          device,
          queue,
          &job.scene,
          textures,
          &view,
          job.width,
          job.height,
          color.white(),
        )
      }
    } else {
      run renderer.draw(
        device,
        queue,
        &job.scene,
        textures,
        &view,
        job.width,
        job.height,
        color.white(),
      )
    }
    run target.surface.present()
    run device.checkErrors()
    let nowMs = (run seconds(&mut clock)) * 1000.0
    target.store.onPresented(job.commitEpoch)
    target.store.onGpuFinished(job.commitEpoch)
    emitGpuEvent(
      eventTx,
      GpuEvent.FramePresented {
        window: targetWin,
        commitEpoch: job.commitEpoch,
        painted: true,
        report: RenderReport.none(),
        dropped: 0,
        atMs: nowMs,
      },
    )
    emitGpuEvent(
      eventTx,
      GpuEvent.GpuFinished { windowId: targetWin, gpuFinishedEpoch: job.commitEpoch, atlasFrame: job.atlasFrame },
    )
    drew = true
  }
  return drew
}

/// A move of the frame on screen, with the time on the render thread's clock at which its
/// transition's active phase starts.
pub struct Motion {
  pub slide: Move,
  pub start: f64,
}

impl Copy for Motion {}

/// Takes the moves of a frame handed over at `now`. A move the last frame already had keeps
/// its start on this thread's clock.
pub effect fn adoptMoves(motions: &mut List<Motion>, moves: &[Move], now: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut next = List<Motion>.make()
  let mut i: usize = 0
  while i < moves.length {
    let slide = moves[i]
    let mut start = now - slide.elapsed
    let old = motions.asSlice()
    let mut o: usize = 0
    while o < old.length {
      let known = old[o].slide
      if known.node == slide.node && known.began == slide.began {
        // The same transition: the time painting took does not shift it, and a frame painted
        // for a time long past (the UI thread was held) does not send it back.
        start = old[o].start
      }
      o = o + 1
    }
    run next.append(Motion { slide: slide, start: start })
    i = i + 1
  }
  motions.* = move next
}

/// Appends where each move is at `now` to `positions`, the offsets a frame is drawn with.
/// Returns whether any still runs.
pub effect fn placeMoves(motions: &List<Motion>, now: f64, positions: &mut List<ScrollPosition>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let list = motions.asSlice()
  let mut running = false
  let mut i: usize = 0
  while i < list.length {
    let slide = list[i].slide
    let seconds = now - list[i].start
    let eased = slide.eased(seconds)
    run positions.append(
      ScrollPosition {
        node: slide.node,
        x: slide.fromX + (slide.toX - slide.fromX) * eased,
        y: slide.fromY + (slide.toY - slide.fromY) * eased,
        minX: -UNBOUNDED,
        maxX: UNBOUNDED,
        minY: -UNBOUNDED,
        maxY: UNBOUNDED,
      },
    )
    if !slide.over(seconds) {
      running = true
    }
    i = i + 1
  }
  return running
}

effect fn gpuScrollPositions(entries: &List<GpuScrollEntry>, motions: &List<Motion>, now: f64, out: &mut List<ScrollPosition>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let list = entries.asSlice()
  let mut i: usize = 0
  while i < list.length {
    run out.append(list[i].pos)
    i = i + 1
  }
  return run placeMoves(motions, now, &mut out)
}

effect fn upsertGpuScroll(entries: &mut List<GpuScrollEntry>, pos: ScrollPosition, seq: u64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let slice = entries.asMutSlice()
  let mut i: usize = 0
  while i < slice.length {
    if slice[i].node == pos.node {
      if seq == 0 && slice[i].seq > 0 {
        return ()
      }
      slice[i] = GpuScrollEntry { node: pos.node, pos: pos, seq: seq }
      return ()
    }
    i = i + 1
  }
  run entries.append(GpuScrollEntry { node: pos.node, pos: pos, seq: seq })
}

fn maxGpuScrollSeq(entries: &List<GpuScrollEntry>) -> u64 {
  let mut top: u64 = 0
  let list = entries.asSlice()
  let mut i: usize = 0
  while i < list.length {
    if list[i].seq > top {
      top = list[i].seq
    }
    i = i + 1
  }
  return top
}

effect fn replaceGpuScrolls(entries: &mut List<GpuScrollEntry>, seq: u64, positions: &List<ScrollPosition>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  entries.clear()
  let list = positions.asSlice()
  let mut i: usize = 0
  while i < list.length {
    run entries.append(GpuScrollEntry { node: list[i].node, pos: list[i], seq: seq })
    i = i + 1
  }
}

fn dropConsumedScrolls(entries: &mut List<GpuScrollEntry>, consumedInputSeq: u64) -> () {
  let mut i: usize = 0
  while i < entries.length() {
    if entries.asSlice()[i].seq <= consumedInputSeq {
      drop entries.remove(i)
    } else {
      i = i + 1
    }
  }
}

fn markReady(shared: &Arc<Mutex<Status>>, format: u32) -> () {
  let mut guard = shared.get().lock()
  let values = guard.getMut()
  values.format = format
  values.ready = true
}

/// Shows or hides the Metal HUD on `raw`, when it is a Metal layer.
fn metalHud(raw: RawSurface, on: bool) -> () {
  match raw {
    RawSurface.MetalLayer { layer } => metal_hud.show(layer, on)
    _ => ()
  }
}

/// Records a presented frame in shared scalar telemetry and notifies waiting threads.
fn recordFrame(shared: &Arc<Mutex<Status>>, report: RenderReport, redrawGen: u64) -> () {
  let mut guard = shared.get().lock()
  let values = guard.getMut()
  let previous = values.report
  values.report = report
  values.report.frames = previous.frames + 1
  values.report.painted = previous.painted + report.painted
  values.report.dropped = previous.dropped + report.dropped
  if redrawGen > values.redrawCompletedGen {
    values.redrawCompletedGen = redrawGen
  }
  if report.status < 0 {
    values.report.status = previous.status
  }
  // An interval over a second is the window idling, not a slow frame. The list is bounded for
  // a host that never takes it.
  if report.interval > 0.0 && report.interval < 1000.0 && values.presented.length() < MAX_PRESENTED {
    let mut heap = Allocator.systemAllocatorProvider()
    drop run Effect.result(values.presented.append(report.interval))
      |> Effect.provideMut<Allocator>(&mut heap)
  }
}

/// How many present intervals wait for [`RenderThread.takePresented`] at most.
const MAX_PRESENTED: usize = 1024

/// Keeps the storage of a frame that is no longer drawn for the next copy.
fn retire(shared: &Arc<Mutex<Status>>, job: FrameJob) -> () {
  let mut guard = shared.get().lock()
  let values = guard.getMut()
  if Option<Scene>.isNone(&values.spare) {
    let FrameJob {
      scene: used,
      width: _,
      height: _,
      expected: e,
      compare: _,
      moves: m,
      commitEpoch: _,
      consumedInputSeq: _,
      atlasFrame: _
    } = move job
    drop e
    drop m
    values.spare = Option<Scene>.some(move used)
  } else {
    drop job
  }
}

struct OpenRequest {
  surface: u32,
  raw: RawSurface,
  window: WindowId,
}

impl Copy for OpenRequest {}

struct CloseRequest {
  surface: u32,
  window: WindowId,
  platform: Option<PlatformClient>,
}

/// The window's surface target, by backend.
unsafe fn targetOf<'w>(owner: &'w WindowId, raw: RawSurface) -> Option<SurfaceTarget<'w>> {
  return match raw {
    RawSurface.MetalLayer { layer } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.metalLayer(owner, layer),
    )
    RawSurface.Win32 { hwnd, hinstance } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.windows(owner, hwnd, hinstance),
    )
    RawSurface.Wayland { display, surface } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.wayland(owner, display, surface),
    )
    RawSurface.Xlib { display, window } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.x11(owner, display, window),
    )
    _ => Option<SurfaceTarget<'w>>.None
  }
}

/// Seconds on the monotonic clock.
effect fn seconds(clock: &mut Clock) -> f64 {
  return run clock.seconds()
}

effect fn enqueueExtraJob(
  extraJobs: &mut List<ExtraJob>,
  accumUploads: &mut Pending,
  latestInfos: &mut List<TextureInfo>,
  job: ExtraJob,
  infos: List<TextureInfo>,
  uploads: Pending,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut nextJob = move job
  if !nextJob.ownAtlas {
    run accumUploads.appendAll(&uploads)
    if infos.length() != 0 {
      latestInfos.* = move infos
    }
  }
  let mut i: usize = 0
  while i < extraJobs.length() {
    if extraJobs.asSlice()[i].surface == nextJob.surface {
      let mut older = extraJobs.remove(i)
      if nextJob.ownAtlas {
        let mut merged = move older.uploads
        run merged.appendAll(&nextJob.uploads)
        nextJob.uploads = move merged
        if nextJob.infos.length() == 0 {
          nextJob.infos = move older.infos
        }
      } else {
        drop older
      }
    } else {
      i = i + 1
    }
  }
  run extraJobs.append(move nextJob)
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn renderThreadQos(class: u32, relative: i32) -> i32 as "pthread_set_qos_class_self_np"
}

effect fn renderLoop(
  shared: &Arc<Mutex<Status>>,
  wakeUi: &Unparker,
  waiter: &Waiter,
  cmdRx: &mut UnboundedReceiver<GpuCommand>,
  settings: RenderSettings,
  cache: string,
  canvases: &CanvasPresenter,
) -> ()
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  // Frames are presented from here: scheduled as the UI thread is (see host.interactiveThread).
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    let _set = unsafe renderThreadQos(0x21, 0)
  }
  let mut clock = Clock.make()

  // The device and the pipelines come first, before the window exists.
  let instance = run Instance.create()
  let mut adapter = run instance.requestAdapter(&RequestAdapterOptions.default())
  let deviceOptions = DeviceDescriptor.cachedIn(String.utf8Bytes(cache)).withRequiredFeatures(sharingFeatures(&adapter))
  let mut device = run adapter.requestDevice(&deviceOptions)
  canvases.setSharing(SharedImage.supported(&device))
  let mut queue = run getQueue(&device)
  let mut renderer = run UiRenderer.make(&device, flags.WGPUTextureFormat_BGRA8Unorm)

  let mut eventTx = Option<UnboundedSender<GpuEvent>>.None
  let mut uncapped = false
  let mut layersAllowed = false
  let mut framing = false
  let mut pendingHud: i32 = -1
  let mut grabWanted = false
  let mut pendingJob = Option<FrameJob>.None
  let mut extraJobs = List<ExtraJob>.make()
  let mut openRequests = List<OpenRequest>.make()
  let mut closeRequests = List<CloseRequest>.make()
  let mut accumUploads = Pending.make()
  let mut latestInfos = List<TextureInfo>.make()
  let mut gpuScrolls = List<GpuScrollEntry>.make()
  let mut primaryOverrides = List<LayerOverride>.make()
  let mut primaryStore = RetainedLayerStore.make()
  let mut primaryAtlasFrame: u64 = 0
  let mut takenGen: u64 = 0
  let mut redrawGen: u64 = 0
  let mut batchDropped: u64 = 0
  let mut attached = Option<SurfaceHandle>.None
  let mut quitting = false

  // Await primary surface attachment while processing non-surface setup commands.
  while attached.isNone() && !quitting {
    let mut didPre = false
    while true {
      match cmdRx.tryRecv() {
        Result.Success { value: cmd } => {
          didPre = true
          match move cmd {
            GpuCommand.AttachPrimary { surface } => {
              attached = Option<SurfaceHandle>.some(move surface)
            }
            GpuCommand.SetEventSink { tx } => {
              eventTx = Option<UnboundedSender<GpuEvent>>.some(move tx)
            }
            GpuCommand.SetUncapped { on } => {
              uncapped = on
            }
            GpuCommand.AllowCanvasLayers { on } => {
              layersAllowed = on
            }
            GpuCommand.SetMetalHud { on } => {
              pendingHud = if on { 1 } else { 0 }
            }
            GpuCommand.BeginFrame => {
              framing = true
            }
            GpuCommand.EndFrame => {
              framing = false
            }
            GpuCommand.GrabFrame => {
              grabWanted = true
            }
            GpuCommand.SubmitPrimary { job, textures, uploads, gen } => {
              run accumUploads.appendAll(&uploads)
              if textures.length() != 0 {
                latestInfos = move textures
              }
              if let Option<FrameJob>.Some { value: older } = Intrinsic.replace(pendingJob, Option<FrameJob>.some(move job)) {
                retire(shared, move older)
                batchDropped = batchDropped + 1
              }
              if gen > takenGen {
                takenGen = gen
              }
            }
            GpuCommand.OpenSurface { surface, raw, window } => {
              run openRequests.append(OpenRequest { surface: surface, raw: raw, window: window })
            }
            GpuCommand.SubmitExtra { job, textures, uploads } => {
              run enqueueExtraJob(&mut extraJobs, &mut accumUploads, &mut latestInfos, move job, move textures, move uploads)
            }
            GpuCommand.CloseSurface { surface, window, platform } => {
              run closeRequests.append(
                CloseRequest { surface: surface, window: window, platform: move platform },
              )
            }
            GpuCommand.ApplyScroll { window, seq, positions } => {
              drop window
              drop run replaceGpuScrolls(&mut gpuScrolls, seq, &positions)
            }
            GpuCommand.ApplyProperties { windowId, activeEpoch, scrolls, overrides } => {
              drop windowId
              drop activeEpoch
              drop run replaceGpuScrolls(&mut gpuScrolls, 0, &scrolls)
              primaryOverrides = move overrides
            }
            GpuCommand.CommitLayers { commit } => {
              let ack = run primaryStore.applyCommit(&commit)
              if ack.applied {
                if commit.atlasFrame != 0 {
                  primaryAtlasFrame = commit.atlasFrame
                }
                if commit.replaceOverrides || commit.overrides.length() != 0 {
                  primaryOverrides = move commit.overrides
                }
              }
              emitGpuEvent(&eventTx, GpuEvent.CommitInstalled { ack: ack })
            }
            GpuCommand.RescrollPrimary { positions, commitEpoch, moves, updateMoves, consumedInputSeq, gen } => {
              drop positions
              drop commitEpoch
              drop moves
              drop updateMoves
              drop consumedInputSeq
              if gen > redrawGen {
                redrawGen = gen
              }
            }
            GpuCommand.Quit => {
              quitting = true
            }
          }
        }
        Result.Failure { error } => match error {
          TryRecvError.Empty => { break }
          TryRecvError.Closed => {
            quitting = true
            break
          }
        }
      }
    }
    if stopped(shared) {
      quitting = true
    }
    if attached.isNone() && !quitting && !didPre {
      waiter.wait()
    }
  }

  let surface = match move attached {
    Option<SurfaceHandle>.Some { value } => move value
    Option<SurfaceHandle>.None => {
      while closeRequests.length() != 0 {
        let req = closeRequests.remove(0)
        if let Option<PlatformClient>.Some { value: client } = move req.platform {
          client.closeWindow(req.window)
        }
        emitGpuEvent(&eventTx, GpuEvent.SurfaceClosed { surface: req.surface, window: req.window })
      }
      return ()
    }
  }
  let owner = surface.window
  let raw = surface.raw
  let target = match unsafe targetOf(&owner, surface.raw) {
    Option<SurfaceTarget>.Some { value } => move value
    Option<SurfaceTarget>.None => {
      StderrWriter.print("ui-tree: this backend has no GPU surface\n", &())
      fail GpuError.status(0)
    }
  }
  let gpuSurface = run Surface.create(&instance, &target, String.utf8Bytes("ui tree"))

  let probed = run Effect.result(gpuSurface.getCapabilities(&adapter))
  let capabilities = match move probed {
    Result.Success { value } => move value
    Result.Failure { error } => {
      drop error
      adapter = run instance.requestAdapter(&RequestAdapterOptions.forSurface(&gpuSurface))
      device = run adapter.requestDevice(&deviceOptions)
      if !SharedImage.supported(&device) {
        StderrWriter.print("ui-tree: the adapter that presents does not share canvas images\n", &())
      }
      queue = run getQueue(&device)
      renderer = run UiRenderer.make(&device, flags.WGPUTextureFormat_BGRA8Unorm)
      run gpuSurface.getCapabilities(&adapter)
    }
  }
  let format = pickFormat(capabilities.formats())
  if format == 0 {
    StderrWriter.print("ui-tree: the surface offers neither BGRA8 nor RGBA8 unorm\n", &())
    fail GpuError.status(0)
  }
  if format != flags.WGPUTextureFormat_BGRA8Unorm {
    renderer = run UiRenderer.make(&device, format)
  }
  let mut textures = GpuAtlas.make()
  let mut configuration = SurfaceConfiguration.make(&device, format, 1, 1)
  let canCopy = u64.bitAnd(capabilities.usages(), flags.WGPUTextureUsage_CopySrc) != 0
  if canCopy {
    configuration.setUsage(flags.WGPUTextureUsage_RenderAttachment | flags.WGPUTextureUsage_CopySrc)
  }
  if settings.check {
    if !canCopy {
      StderrWriter.print("ui-tree: the surface cannot be read back\n", &())
      fail GpuError.status(0)
    }
    renderer.setTextSettings(TextSettings.none())
  }
  let alphaMode = if capabilities.alphaModes().length != 0 {
    capabilities.alphaModes()[0]
  } else {
    0
  }
  if alphaMode != 0 {
    configuration.setAlphaMode(alphaMode)
  }
  markReady(shared, format)
  wakeUi.unpark()
  let mut others = List<ExtraSurface>.make()
  let mut canvasTextures = List<CanvasTexture>.make()

  let mut canImmediate = false
  let modes = capabilities.presentModes()
  let mut m: usize = 0
  while m < modes.length {
    if modes[m] == flags.WGPUPresentMode_Immediate {
      canImmediate = true
    }
    m = m + 1
  }
  let mut immediate = false
  let mut configuredWidth: u32 = 0
  let mut configuredHeight: u32 = 0
  let mut previousPresented = 0.0
  let mut current = Option<FrameJob>.None
  let mut positions = List<ScrollPosition>.make()
  let mut held = false
  let metalLayer = match raw {
    RawSurface.MetalLayer { layer } => layer
    _ => Pointer.null<u8>()
  }
  let mut layered = List<LayeredCanvas>.make()
  let mut retiredPictures = List<LayerPicture>.make()
  let mut placements = List<SurfacePlacement>.make()
  let mut layerPoll: u64 = 0
  let mut windowShown: u64 = 0
  let mut motions = List<Motion>.make()
  let mut redrawRequested = false

  while true {
    if stopped(shared) || quitting {
      break
    }

    let prevTakenGen = takenGen
    while true {
      match cmdRx.tryRecv() {
        Result.Success { value: cmd } => {
          match move cmd {
            GpuCommand.AttachPrimary { .. } => {}
            GpuCommand.SetEventSink { tx } => {
              eventTx = Option<UnboundedSender<GpuEvent>>.some(move tx)
            }
            GpuCommand.SetMetalHud { on } => {
              pendingHud = if on { 1 } else { 0 }
            }
            GpuCommand.SetUncapped { on } => {
              uncapped = on
            }
            GpuCommand.AllowCanvasLayers { on } => {
              layersAllowed = on
            }
            GpuCommand.BeginFrame => {
              framing = true
            }
            GpuCommand.EndFrame => {
              framing = false
            }
            GpuCommand.GrabFrame => {
              grabWanted = true
              redrawRequested = true
            }
            GpuCommand.SubmitPrimary { job, textures: infos, uploads, gen } => {
              run accumUploads.appendAll(&uploads)
              if infos.length() != 0 {
                latestInfos = move infos
              }
              if let Option<FrameJob>.Some { value: older } = Intrinsic.replace(pendingJob, Option<FrameJob>.some(move job)) {
                retire(shared, move older)
                batchDropped = batchDropped + 1
              }
              if gen > takenGen {
                takenGen = gen
              }
              redrawRequested = false
            }
            GpuCommand.ApplyScroll { window, seq, positions: nextPos } => {
              if window.value == owner.value {
                run replaceGpuScrolls(&mut gpuScrolls, seq, &nextPos)
                redrawRequested = true
              } else {
                let extraSlice = others.asMutSlice()
                let mut e: usize = 0
                while e < extraSlice.length {
                  if extraSlice[e].window.value == window.value {
                    extraSlice[e].scrolls = move nextPos
                    break
                  }
                  e = e + 1
                }
              }
            }
            GpuCommand.ApplyProperties { windowId, activeEpoch, scrolls: nextScrolls, overrides: nextOverrides } => {
              drop activeEpoch
              if windowId.value == owner.value {
                let keepSeq = maxGpuScrollSeq(&gpuScrolls)
                run replaceGpuScrolls(&mut gpuScrolls, keepSeq, &nextScrolls)
                primaryOverrides = move nextOverrides
                redrawRequested = true
              } else {
                let extraSlice = others.asMutSlice()
                let mut e: usize = 0
                while e < extraSlice.length {
                  if extraSlice[e].window.value == windowId.value {
                    extraSlice[e].scrolls = move nextScrolls
                    extraSlice[e].overrides = move nextOverrides
                    break
                  }
                  e = e + 1
                }
              }
            }
            GpuCommand.CommitLayers { commit } => {
              if commit.windowId.value == owner.value {
                let ack = run primaryStore.applyCommit(&commit)
                if ack.applied {
                  if commit.atlasFrame != 0 {
                    primaryAtlasFrame = commit.atlasFrame
                  }
                  if commit.replaceOverrides || commit.overrides.length() != 0 {
                    primaryOverrides = move commit.overrides
                  }
                  redrawRequested = true
                }
                emitGpuEvent(&eventTx, GpuEvent.CommitInstalled { ack: ack })
              } else {
                let mut ack = CommitAck {
                  windowId: commit.windowId,
                  groupId: commit.groupId,
                  commitEpoch: commit.commitEpoch,
                  activeEpoch: 0,
                  applied: false,
                  needsKeyframe: true,
                }
                let extraSlice = others.asMutSlice()
                let mut e: usize = 0
                while e < extraSlice.length {
                  if extraSlice[e].window.value == commit.windowId.value {
                    ack = run extraSlice[e].store.applyCommit(&commit)
                    if ack.applied && (commit.replaceOverrides || commit.overrides.length() != 0) {
                      extraSlice[e].overrides = move commit.overrides
                    }
                    break
                  }
                  e = e + 1
                }
                emitGpuEvent(&eventTx, GpuEvent.CommitInstalled { ack: ack })
              }
            }
            GpuCommand.RescrollPrimary { positions: nextPos, commitEpoch, moves, updateMoves, consumedInputSeq, gen } => {
              if let Option<FrameJob>.Some { value: cur } = &mut current {
                cur.commitEpoch = commitEpoch
              }
              if updateMoves {
                let now = run seconds(&mut clock)
                run adoptMoves(&mut motions, moves.asSlice(), now)
              }
              dropConsumedScrolls(&mut gpuScrolls, consumedInputSeq)
              let slice = nextPos.asSlice()
              let mut s: usize = 0
              while s < slice.length {
                run upsertGpuScroll(&mut gpuScrolls, slice[s], 0)
                s = s + 1
              }
              if gen > redrawGen {
                redrawGen = gen
              }
              redrawRequested = true
            }
            GpuCommand.OpenSurface { surface: sid, raw: sraw, window: swin } => {
              run openRequests.append(OpenRequest { surface: sid, raw: sraw, window: swin })
            }
            GpuCommand.SubmitExtra { job, textures: infos, uploads } => {
              run enqueueExtraJob(&mut extraJobs, &mut accumUploads, &mut latestInfos, move job, move infos, move uploads)
            }
            GpuCommand.CloseSurface { surface: sid, window: swin, platform } => {
              run closeRequests.append(
                CloseRequest { surface: sid, window: swin, platform: move platform },
              )
            }
            GpuCommand.Quit => {
              quitting = true
            }
          }
        }
        Result.Failure { error } => match error {
          TryRecvError.Empty => { break }
          TryRecvError.Closed => {
            quitting = true
            break
          }
        }
      }
    }

    if takenGen != prevTakenGen || batchDropped != 0 {
      recordTakenAndDropped(shared, takenGen, batchDropped)
      wakeUi.unpark()
    }
    if quitting || stopped(shared) {
      break
    }

    if pendingHud >= 0 {
      metalHud(raw, pendingHud == 1)
      pendingHud = -1
    }
    while closeRequests.length() != 0 {
      let req = closeRequests.remove(0)
      processCloseSurface(&eventTx, &mut others, &mut extraJobs, req.surface, req.window, move req.platform)
    }
    while openRequests.length() != 0 {
      let req = openRequests.remove(0)
      run processOpenSurface(
        shared,
        wakeUi,
        &eventTx,
        &instance,
        &owner,
        &mut others,
        req.surface,
        req.raw,
        req.window,
      )
    }

    run flushUploads(&mut accumUploads, &mut latestInfos, &device, &queue, &mut textures)
    let taken = run serveCanvases(canvases, &device, &queue, &mut renderer, &mut canvasTextures, &mut layered)
    let mut windowCanvas = taken != 0
    windowShown = windowShown + taken
    layerPoll = run serviceLayers(canvases, &mut layered, &mut retiredPictures)
    if run handOverToLayers(canvases, &mut renderer, &mut canvasTextures, &layered) {
      windowCanvas = true
    }
    if run drawOthers(&eventTx, &mut extraJobs, &device, &queue, &mut renderer, &textures, &mut others, format, alphaMode, &mut clock) {
      held = false
    }

    let fresh = match move Intrinsic.replace(pendingJob, Option<FrameJob>.None) {
      Option<FrameJob>.Some { value: next } => {
        dropConsumedScrolls(&mut gpuScrolls, next.consumedInputSeq)
        let adopted = run seconds(&mut clock)
        run adoptMoves(&mut motions, next.moves.asSlice(), adopted)
        if next.atlasFrame != 0 {
          primaryAtlasFrame = next.atlasFrame
        }
        if layered.length() != 0 || canvasTextures.length() != 0 && layersAllowed {
          run planLayers(
            &next.scene,
            &mut placements,
            canvases,
            &device,
            &mut renderer,
            &mut canvasTextures,
            &mut layered,
            metalLayer,
            layersAllowed,
          )
        }
        match move Intrinsic.replace(current, Option<FrameJob>.some(move next)) {
          Option<FrameJob>.Some { value: older } => retire(shared, move older)
          Option<FrameJob>.None => ()
        }
        redrawRequested = false
        true
      }
      Option<FrameJob>.None => {
        if redrawRequested || redrawsAlone(false, windowCanvas, framing) {
          redrawRequested = false
          false
        } else {
          if canvases.waiting() && !framing {
            continue
          }
          if layerPoll != 0 {
            if !waiter.waitTimeout(layerPoll) {
              layerPoll = run serviceLayers(canvases, &mut layered, &mut retiredPictures)
              if run handOverToLayers(canvases, &mut renderer, &mut canvasTextures, &layered) {
                redrawRequested = true
              }
            }
          } else {
            waiter.wait()
          }
          continue
        }
      }
    }

    let mut job = match move Intrinsic.replace(current, Option<FrameJob>.None) {
      Option<FrameJob>.Some { value } => move value
      Option<FrameJob>.None => {
        continue
      }
    }
    if job.width == 0 || job.height == 0 {
      let epoch = job.commitEpoch
      let zeroReport = RenderReport.none()
      current = Option<FrameJob>.some(move job)
      recordFrame(shared, zeroReport, redrawGen)
      emitGpuEvent(
        &eventTx,
        GpuEvent.FramePresented {
          window: owner,
          commitEpoch: epoch,
          painted: fresh,
          report: zeroReport,
          dropped: batchDropped,
          atMs: 0.0,
        },
      )
      batchDropped = 0
      wakeUi.unpark()
      continue
    }

    if uncapped != immediate {
      immediate = uncapped && canImmediate
      configuration.setPresentMode(if immediate { flags.WGPUPresentMode_Immediate } else { flags.WGPUPresentMode_Fifo })
      configuredWidth = 0
    }
    if job.width != configuredWidth || job.height != configuredHeight {
      gpuSurface.resize(&mut configuration, job.width, job.height)
      configuredWidth = job.width
      configuredHeight = job.height
    }
    let start = run seconds(&mut clock)
    let uploaded = run seconds(&mut clock)
    let texture = run gpuSurface.getCurrentTexture()
    let view = run texture.texture.createView(&TextureViewDescriptor.default())
    let acquired = run seconds(&mut clock)
    drop run gpuScrollPositions(&gpuScrolls, &motions, acquired, &mut positions)
    run renderer.setScrolls(positions.asSlice())
    run renderer.setLayerOverrides(primaryOverrides.asSlice())
    if held && !fresh {
      renderer.reuseInstances()
    }
    held = true
    if canCopy {
      run renderer.drawReadable(
        &device,
        &queue,
        &job.scene,
        &textures,
        &texture.texture,
        &view,
        job.width,
        job.height,
        color.white(),
      )
    } else {
      run renderer.draw(
        &device,
        &queue,
        &job.scene,
        &textures,
        &view,
        job.width,
        job.height,
        color.white(),
      )
    }
    let drawn = run seconds(&mut clock)
    let mut status: i32 = -1
    if fresh && job.compare {
      status = run checkFrame(
        &device,
        &queue,
        &texture.texture,
        isBgra(format),
        job.expected.asSlice(),
        job.width,
        job.height,
      )
    }
    if grabWanted {
      grabWanted = false
      run grabFrame(shared, &device, &queue, &texture.texture, canCopy, isBgra(format), job.width, job.height)
    }
    run gpuSurface.present()
    canvases.noteShown(windowShown)
    windowShown = 0
    placeLayers(&mut layered)
    run device.checkErrors()
    let presented = run seconds(&mut clock)
    let epoch = job.commitEpoch
    let atMs = presented * 1000.0
    primaryStore.onPresented(epoch)
    primaryStore.onGpuFinished(epoch)
    let report = RenderReport {
      frames: 0,
      painted: if fresh { 1 } else { 0 },
      status: status,
      upload: (uploaded - start) * 1000.0,
      acquire: (acquired - uploaded) * 1000.0,
      draw: (drawn - acquired) * 1000.0,
      present: (presented - drawn) * 1000.0,
      interval: if previousPresented == 0.0 { 0.0 } else { (presented - previousPresented) * 1000.0 },
      dropped: batchDropped,
      textures: renderer.textureBytes(),
    }
    batchDropped = 0
    current = Option<FrameJob>.some(move job)
    recordFrame(shared, report, redrawGen)
    emitGpuEvent(
      &eventTx,
      GpuEvent.FramePresented {
        window: owner,
        commitEpoch: epoch,
        painted: fresh,
        report: report,
        dropped: 0,
        atMs: atMs,
      },
    )
    emitGpuEvent(
      &eventTx,
      GpuEvent.GpuFinished { windowId: owner, gpuFinishedEpoch: epoch, atlasFrame: primaryAtlasFrame },
    )
    wakeUi.unpark()
    previousPresented = presented
  }

  while closeRequests.length() != 0 {
    let req = closeRequests.remove(0)
    processCloseSurface(&eventTx, &mut others, &mut extraJobs, req.surface, req.window, move req.platform)
  }
  while others.length() != 0 {
    let leaving = others.remove(0)
    leaving.surface.unconfigure()
    drop leaving
  }
  gpuSurface.unconfigure()
}

/// Reads the drawn surface back for [`RenderThread.grab`].
effect fn grabFrame(
  shared: &Arc<Mutex<Status>>,
  device: &Device,
  queue: &Queue,
  surfaceTexture: &Texture,
  canCopy: bool,
  bgra: bool,
  width: u32,
  height: u32,
) -> ()
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let mut grab = Grab {
    rows: List<u8>.make(),
    stride: readbackStride(width),
    width: width,
    height: height,
    bgra: bgra,
    ok: canCopy,
  }
  if canCopy {
    let buffer = run copyOut(device, queue, surfaceTexture, width, height)
    grab.rows = run runtime.mapRead(device, &buffer, 0, readbackSize(width, height))
  }
  let mut guard = shared.get().lock()
  let values = guard.getMut()
  values.grabbed = Option<Grab>.some(move grab)
}

/// Compares the drawn surface with the CPU reference of the same frame. Returns 0 within
/// tolerance and 1 outside.
effect fn checkFrame(
  device: &Device,
  queue: &Queue,
  surfaceTexture: &Texture,
  bgra: bool,
  expected: &[u8],
  width: u32,
  height: u32,
) -> i32
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run copyOut(device, queue, surfaceTexture, width, height)
  let padded = run runtime.mapRead(device, &buffer, 0, readbackSize(width, height))
  let pixels = run unpack(padded.asSlice(), width, height, bgra)
  let result = compare(expected, pixels.asSlice(), width)
  let ok = result.within(Tolerance.frame())
  StderrWriter.print(
    "check: {} x {} surface, max delta {} at ({}, {}), {} of {} channels over 8, mean {}: {}\n",
    &(
      width,
      height,
      result.max,
      result.worstX,
      result.worstY,
      result.over,
      result.channels,
      result.mean,
      if ok {
        "pass"
      } else {
        "FAIL"
      }
    ),
  )
  return if ok {
    0
  } else {
    1
  }
}
