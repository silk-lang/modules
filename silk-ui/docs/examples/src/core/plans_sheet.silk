//! The plan picker again, styled by a stylesheet. The view names classes, and
//! `docs/styles/plans.css` holds every value.
import loom.lib { Document, Node, NoCommand, NoOutput, Program, Role, Update }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct Plans {
  /// The plan that is chosen: 0, 1 or 2.
  pub chosen: u32,
}

pub union Message {
  ClickedPlan { pub plan: u32 },
}

type Next = Update<Plans, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Plans {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(Plans { chosen: 1 })
  }

  effect fn update(mut model: Plans, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.ClickedPlan { plan } => {
        model.chosen = plan
      }
    }
    return Next.of(move model)
  }

  fn view(model: &Plans, h: &Document<Message>) -> Node {
    return h.box(
      &[h.accessRole(Role.Group), h.label("Plan"), h.class("plans")],
      &[
        plan(h, model, 0, "Solo", "One person", 0),
        plan(h, model, 1, "Team", "Up to ten people", 12),
        plan(h, model, 2, "Company", "Everyone", 40),
      ],
    )
  }
}

/// One plan, as a card that can be chosen.
fn plan(
  h: &Document<Message>,
  model: &Plans,
  index: u32,
  name: string,
  about: string,
  dollars: i64,
) -> Node {
  let chosen = model.chosen == index
  return h.button(
    &[
      h.accessRole(Role.Radio),
      h.checked(chosen),
      h.onClick(Message.ClickedPlan { plan: index }),
      // What depends on the model is one more class. Hover, press and focus are in the sheet.
      h.class(if chosen { "plan chosen" } else { "plan" }),
    ],
    &[
      h.box(
        &[h.class("plan-body")],
        &[
          h.box(&[h.class("plan-name")], &[h.text(name)]),
          h.box(&[h.class("plan-about")], &[h.text(about)]),
          h.box(&[h.class("plan-price")], &[h.text("$"), h.number(dollars)]),
        ],
      ),
    ],
  )
}
