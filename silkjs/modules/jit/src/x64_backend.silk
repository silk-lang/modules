        if u8.shiftRight(fact, FACT_PAIR) != 0 { proven = versionOf(site.keys[u8.toUsize(u8.shiftRight(fact, FACT_PAIR)) - 1]) }
        if target != NONE && proven != 0 && !knownFor(&function, target, proven) { target = NONE }
        let tested = self.shapes.testedAt(self.cursor)
        if (tested & TESTED_SURE) != 0 {
