//! Input editing ownership modes and declarative input filters for `ui-protocol`.
import silk.concurrency.thread { Transferable }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

/// Who owns mutating an `<input>` or `<richinput>` value and echo behavior.
pub enum EditOwnership {
  /// Default: engine applies keystrokes, selection, undo, and composition optimistically and emits
  /// revisioned `Input` events; app writes via `Mutation.SetValue { baseRevision }` reconcile.
  EngineOwned,
  /// Engine applies declarative [`InputFilter`] rules synchronously before echo.
  Filtered,
  /// App owns the value: no optimistic text echo; keystrokes and edits emit ordered `BeforeInput`
  /// intents while the engine still draws live IME composition preedit.
  AppOwned,
}

/// ASCII case transform applied by [`InputFilter`].
pub enum CaseTransform {
  None,
  Upper,
  Lower,
}

/// Allowed character class for [`InputFilter`].
pub enum AllowedChars {
  Any,
  Numeric,
  SignedDecimal,
  AsciiAlphanumeric,
  AsciiHex,
  CustomSet,
}

/// Declarative engine-side input mask & length bound.
pub struct InputFilter {
  /// Maximum number of Unicode scalars across the resulting value (`0` = unlimited).
  pub maxLength: usize,
  pub allowedChars: AllowedChars,
  /// UTF-8 characters allowed when `allowedChars == AllowedChars.CustomSet`.
  pub allowed: String,
  pub caseTransform: CaseTransform,
  pub rejectWhitespace: bool,
}

impl Transferable for InputFilter {}

impl InputFilter {
  pub fn none() -> InputFilter {
    return InputFilter {
      maxLength: 0,
      allowedChars: AllowedChars.Any,
      allowed: String.make(),
      caseTransform: CaseTransform.None,
      rejectWhitespace: false,
    }
  }

  pub fn same(self: &Self, other: &Self) -> bool {
    return self.maxLength == other.maxLength
      && self.allowedChars == other.allowedChars
      && String.view(&self.allowed) == String.view(&other.allowed)
      && self.caseTransform == other.caseTransform
      && self.rejectWhitespace == other.rejectWhitespace
  }

  pub effect fn copy(self: &Self) -> InputFilter
    ! OutOfMemoryError
    ? &mut Allocator {
    return InputFilter {
      maxLength: self.maxLength,
      allowedChars: self.allowedChars,
      allowed: run String.copy(String.view(&self.allowed)),
      caseTransform: self.caseTransform,
      rejectWhitespace: self.rejectWhitespace,
    }
  }
}

/// Per-input editing configuration declared via `Attribute.EditMode`.
pub struct EditConfig {
  pub ownership: EditOwnership,
  pub filter: InputFilter,
}

impl Transferable for EditConfig {}

impl EditConfig {
  pub fn engineOwned() -> EditConfig {
    return EditConfig { ownership: EditOwnership.EngineOwned, filter: InputFilter.none() }
  }

  pub fn appOwned() -> EditConfig {
    return EditConfig { ownership: EditOwnership.AppOwned, filter: InputFilter.none() }
  }

  pub fn filtered(filter: InputFilter) -> EditConfig {
    return EditConfig { ownership: EditOwnership.Filtered, filter: move filter }
  }

  pub fn same(self: &Self, other: &Self) -> bool {
    return self.ownership == other.ownership && self.filter.same(&other.filter)
  }

  pub effect fn copy(self: &Self) -> EditConfig
    ! OutOfMemoryError
    ? &mut Allocator {
    return EditConfig { ownership: self.ownership, filter: run self.filter.copy() }
  }
}

fn scalarCount(text: string) -> usize {
  let bytes = String.utf8Bytes(text)
  let mut count: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    if (bytes[i] & 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

fn isAsciiWhitespace(b: u8) -> bool {
  return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12
}

fn isDigit(b: u8) -> bool {
  return b >= 48 && b <= 57
}

fn isUpper(b: u8) -> bool {
  return b >= 65 && b <= 90
}

fn isLower(b: u8) -> bool {
  return b >= 97 && b <= 122
}

fn isHex(b: u8) -> bool {
  return isDigit(b) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

fn containsSlice(haystack: &[u8], needle: &[u8]) -> bool {
  if needle.length == 0 || needle.length > haystack.length {
    return false
  }
  let mut i: usize = 0
  while i < haystack.length {
    // Only match at UTF-8 scalar start boundaries.
    if (haystack[i] & 0xC0) != 0x80 && i + needle.length <= haystack.length {
      let mut eq = true
      let mut k: usize = 0
      while k < needle.length {
        if haystack[i + k] != needle[k] {
          eq = false
          break
        }
        k = k + 1
      }
      if eq {
        return true
      }
    }
    i = i + 1
  }
  return false
}

fn allowsScalar(filter: &InputFilter, bytes: &[u8]) -> bool {
  if filter.rejectWhitespace && bytes.length == 1 && isAsciiWhitespace(bytes[0]) {
    return false
  }
  return match filter.allowedChars {
    AllowedChars.Any => true
    AllowedChars.Numeric => bytes.length == 1 && isDigit(bytes[0])
    AllowedChars.SignedDecimal => bytes.length == 1
      && (isDigit(bytes[0]) || bytes[0] == 43 || bytes[0] == 45 || bytes[0] == 46)
    AllowedChars.AsciiAlphanumeric => bytes.length == 1
      && (isDigit(bytes[0]) || isUpper(bytes[0]) || isLower(bytes[0]))
    AllowedChars.AsciiHex => bytes.length == 1 && isHex(bytes[0])
    AllowedChars.CustomSet => containsSlice(String.utf8Bytes(String.view(&filter.allowed)), bytes)
  }
}

/// Applies `filter` to candidate insertion `insert` replacing byte range `[lo, hi)` of `current`.
/// Returns the filtered replacement string honoring allowed characters, case transform, and `maxLength`.
pub effect fn applyFilter(
  filter: &InputFilter,
  current: string,
  lo: usize,
  hi: usize,
  insert: string,
) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let len = String.byteLength(current)
  let kept = if filter.maxLength == 0 {
    0
  } else {
    let before = if lo <= len { scalarCount(String.slice(current, 0, lo)) } else { scalarCount(current) }
    let after = if hi <= len { scalarCount(String.slice(current, hi, len - hi)) } else { 0 }
    before + after
  }
  let mut remaining: usize = if filter.maxLength == 0 {
    usize.MAX
  } else if kept >= filter.maxLength {
    0
  } else {
    filter.maxLength - kept
  }
  let bytes = String.utf8Bytes(insert)
  let mut out = String.make()
  let mut i: usize = 0
  while i < bytes.length && remaining > 0 {
    let b = bytes[i]
    let width: usize = if b < 0x80 {
      1
    } else if (b & 0xE0) == 0xC0 {
      2
    } else if (b & 0xF0) == 0xE0 {
      3
    } else {
      4
    }
    let end = if i + width <= bytes.length { i + width } else { bytes.length }
    if width == 1 && end == i + 1 {
      let mut transformed = b
      match filter.caseTransform {
        CaseTransform.Upper => {
          if isLower(transformed) {
            transformed = transformed - 32
          }
        }
        CaseTransform.Lower => {
          if isUpper(transformed) {
            transformed = transformed + 32
          }
        }
        CaseTransform.None => {}
      }
      let single: [u8; 1] = [transformed]
      if allowsScalar(filter, &single) {
        let slice = if transformed == b {
          String.slice(insert, i, 1)
        } else {
          // Single transformed ASCII scalar: append via byte diff from uppercase/lowercase table.
          transformedAscii(transformed)
        }
        run out.append(slice)
        remaining = remaining - 1
      }
    } else {
      let mut sliceBytes: [u8; 4] = [0; 4]
      let mut k: usize = 0
      while k < end - i {
        sliceBytes[k] = bytes[i + k]
        k = k + 1
      }
      let mut passed = true
      if filter.allowedChars != AllowedChars.Any {
        passed = allowsScalar(filter, String.utf8Bytes(String.slice(insert, i, end - i)))
      }
      if passed {
        run out.append(String.slice(insert, i, end - i))
        remaining = remaining - 1
      }
    }
    i = end
  }
  return move out
}

fn transformedAscii(b: u8) -> string<'static> {
  if b == 65 { return "A" }
  if b == 66 { return "B" }
  if b == 67 { return "C" }
  if b == 68 { return "D" }
  if b == 69 { return "E" }
  if b == 70 { return "F" }
  if b == 71 { return "G" }
  if b == 72 { return "H" }
  if b == 73 { return "I" }
  if b == 74 { return "J" }
  if b == 75 { return "K" }
  if b == 76 { return "L" }
  if b == 77 { return "M" }
  if b == 78 { return "N" }
  if b == 79 { return "O" }
  if b == 80 { return "P" }
  if b == 81 { return "Q" }
  if b == 82 { return "R" }
  if b == 83 { return "S" }
  if b == 84 { return "T" }
  if b == 85 { return "U" }
  if b == 86 { return "V" }
  if b == 87 { return "W" }
  if b == 88 { return "X" }
  if b == 89 { return "Y" }
  if b == 90 { return "Z" }
  if b == 97 { return "a" }
  if b == 98 { return "b" }
  if b == 99 { return "c" }
  if b == 100 { return "d" }
  if b == 101 { return "e" }
  if b == 102 { return "f" }
  if b == 103 { return "g" }
  if b == 104 { return "h" }
  if b == 105 { return "i" }
  if b == 106 { return "j" }
  if b == 107 { return "k" }
  if b == 108 { return "l" }
  if b == 109 { return "m" }
  if b == 110 { return "n" }
  if b == 111 { return "o" }
  if b == 112 { return "p" }
  if b == 113 { return "q" }
  if b == 114 { return "r" }
  if b == 115 { return "s" }
  if b == 116 { return "t" }
  if b == 117 { return "u" }
  if b == 118 { return "v" }
  if b == 119 { return "w" }
  if b == 120 { return "x" }
  if b == 121 { return "y" }
  return "z"
}
