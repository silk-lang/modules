//! A canvas node showing a GPU surface: it has the surface's natural size, paints one surface
//! sprite over its content box, and goes back to its commands without the surface. A large
//! canvas's commands are drawn once into a bitmap shown the same way, and a client's pixels
//! become the canvas's bitmap.
import ui_tree.legacy { UiTree, TreeError, Batch, FrameInput, NodeInfo, NodeKind, Mutation, info }
import ui_tree.mutation { NO_SURFACE, CanvasCommand }
import ui_tree.canvas_raster { CancelCheck, Frame as RasterFrame, Job as RasterJob, NeverCancel }
import ui_tree.canvas2d { CommandRasterizer }
import vector.pixmap { Pixmap }
import ui_tree.css { px }
import ui_tree.css
import ui_fixtures.fixtures as fixtures
import ui_scene.primitives { SURFACE_TEXTURE_BASE }
import ui_scene.scene { PrimitiveKind, Scene }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.num.usize
import silk.color.rgba { Rgba }
import silk.num.u32
import silk.num.u8
import silk.num.f32
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError }
import silk.testing.testing { Testing, AssertionError }

import silk.system.host_input { HostInputError }

fn input() -> FrameInput {
  return FrameInput { width: 400.0, height: 300.0, scale: 2.0, time: 0.0 }
}

/// How many image sprites of the scene sample surface `surface`, over every layer.
fn surfaceSprites(scene: &Scene, surface: u32) -> u32 {
  let mut count: u32 = 0
  let mut layer: u32 = 0
  while layer < scene.layerCount() {
    let batches = scene.batches(layer)
    let mut i: usize = 0
    while i < batches.length {
      let image = match batches[i].kind {
        PrimitiveKind.Image => true
        _ => false
      }
      if image && batches[i].texture == SURFACE_TEXTURE_BASE + surface {
        count = count + (batches[i].end - batches[i].start)
      }
      i = i + 1
    }
    layer = layer + 1
  }
  return count
}

effect fn refused(error: TreeError) -> bool {
  drop error
  return true
}

effect fn applied(tree: &mut UiTree<'_>, batch: List<Mutation>) -> bool
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  run tree.apply(move batch)
  return false
}

effect fn body() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Canvas)
  run batch.push(Mutation.InsertBefore { parent: 1, child: 2, before: Option<u32>.None })
  run batch.canvasSurface(2, 5, 200, 100, true)
  run tree.apply(run batch.take())
  run tree.frame(input())

  let shown = match run info(&tree, 2) {
    Option<NodeInfo>.Some { value } => value
    Option<NodeInfo>.None => {
      run Testing.expect(false, "the canvas has info")
      return ()
    }
  }
  run Testing.expect(
    shown.bounds.width() == 200.0 && shown.bounds.height() == 100.0,
    "a canvas with a surface has the surface's natural size",
  )
  run Testing.expect(surfaceSprites(tree.scene(), 5) == 1, "and paints one surface sprite")

  // A styled size wins over the natural one, as on any replaced element.
  run batch.style(2, &[css.width(px(120.0)), css.height(px(90.0))])
  run tree.apply(run batch.take())
  run tree.frame(input())
  let sized = match run info(&tree, 2) {
    Option<NodeInfo>.Some { value } => value
    Option<NodeInfo>.None => shown
  }
  run Testing.expect(
    sized.bounds.width() == 120.0 && sized.bounds.height() == 90.0,
    "a styled size wins over the natural size",
  )
  run Testing.expect(surfaceSprites(tree.scene(), 5) == 1, "and the sprite is still painted")

  let mut wrong = Batch.make()
  run wrong.canvasSurface(1, 5, 10, 10, false)
  run Testing.expect(
    run Effect.catch<TreeError>(applied(&mut tree, run wrong.take()), refused),
    "only canvases take a surface",
  )

  run batch.canvasSurface(2, NO_SURFACE, 0, 0, false)
  run batch.style(2, &[])
  run tree.apply(run batch.take())
  run tree.frame(input())
  run Testing.expect(surfaceSprites(tree.scene(), 5) == 0, "without the surface no sprite is painted")
}

test effect fn canvasShowsItsSurface() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// 20,000 plain rects, 200 by 100 of 2 by 3 CSS pixels, in red and blue: a treemap's worth.
effect fn treemap(shift: f32) -> List<CanvasCommand> ! OutOfMemoryError ? &mut Allocator {
  let mut commands = List<CanvasCommand>.make()
  let mut i: u32 = 0
  while i < 20000 {
    let red = (i + f32.toU32(shift)) % 2 == 0
    let color = if red { Rgba<f32>.new(1.0, 0.0, 0.0, 1.0) } else { Rgba<f32>.new(0.0, 0.0, 1.0, 1.0) }
    run commands.append(CanvasCommand.FillRect {
      x: u32.toF32(i % 200) * 2.0, y: u32.toF32(i / 200) * 3.0, width: 2.0, height: 3.0, radius: 0.0, color: color,
    })
    i = i + 1
  }
  return move commands
}

/// What a window does with the bitmaps `rasterCanvases` drew: shows each through surface
/// `surface`. Gives the number shown and the first one's pixel at `x`, `y`.
effect fn showRasters(tree: &mut UiTree<'_>, surface: u32, x: u32, y: u32) -> [u32; 2] ! OutOfMemoryError ? &mut Allocator {
  run tree.rasterCanvases()
  let frames = Intrinsic.replace(tree.canvasRasters.frames, List<RasterFrame>.make())
  let all = frames.asSlice()
  let mut seen: u32 = 0
  let mut i: usize = 0
  while i < all.length {
    if i == 0 {
      let at = (u32.toUsize(y) * u32.toUsize(all[0].pixels.width()) + u32.toUsize(x)) * 4
      let data = all[0].pixels.data()
      seen = u8.toU32(data[at]) * 65536 + u8.toU32(data[at + 1]) * 256 + u8.toU32(data[at + 2])
    }
    run tree.showRaster(all[i].node, surface, all[i].key, all[i].x, all[i].y, all[i].pixels.width(), all[i].pixels.height())
    i = i + 1
  }
  return [usize.toU32(all.length), seen]
}

effect fn rasterBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Canvas)
  run batch.push(Mutation.InsertBefore { parent: 1, child: 2, before: Option<u32>.None })
  run batch.style(2, &[css.width(px(400.0)), css.height(px(300.0))])
  // A hover outline over the canvas, as a sibling.
  run batch.create(3, NodeKind.Box)
  run batch.push(Mutation.InsertBefore { parent: 1, child: 3, before: Option<u32>.None })
  run batch.style(3, &[css.width(px(10.0)), css.height(px(10.0))])
  let commands = run treemap(0.0)
  run batch.canvas(2, commands.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(input())
  run Testing.expect(tree.scene().primitiveCount() >= 20000, "the first paint draws the commands")
  run Testing.expect(tree.canvasRasters.wants.length() == 1, "and asks for a bitmap")

  // The next frame draws the bitmap: the canvas did not change since.
  let shown = run showRasters(&mut tree, 9, 1, 1)
  run Testing.expect(shown[0] == 1, "the window gets one bitmap")
  run Testing.expect(shown[1] == 0xff0000, "drawn as paint draws the commands (device pixels at scale 2)")
  run tree.frame(input())
  run Testing.expect(surfaceSprites(tree.scene(), 9) == 1, "the canvas paints one sprite")
  run Testing.expect(tree.scene().primitiveCount() < 16, "and none of its commands")

  // A sibling that moves repaints around the sprite, not the commands.
  run batch.style(3, &[css.width(px(12.0)), css.height(px(10.0))])
  run tree.apply(run batch.take())
  run tree.frame(input())
  run Testing.expect(surfaceSprites(tree.scene(), 9) == 1, "a sibling's change keeps the sprite")
  run Testing.expect(tree.scene().primitiveCount() < 16, "and paints no commands")
  run Testing.expect(tree.canvasRasters.wants.length() == 0, "nothing new to draw")

  // New commands: drawn as commands until they hold still for a frame.
  let next = run treemap(1.0)
  run batch.canvas(2, next.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(input())
  run Testing.expect(surfaceSprites(tree.scene(), 9) == 0, "changed commands do not show the old bitmap")
  run Testing.expect(tree.scene().primitiveCount() >= 20000, "they are painted")
  // They change again before the next frame, as an animation's do: no bitmap is drawn.
  let again = run treemap(0.0)
  run batch.canvas(2, again.asSlice())
  run tree.apply(run batch.take())
  let skipped = run showRasters(&mut tree, 9, 0, 0)
  run Testing.expect(skipped[0] == 0, "a canvas that changes every frame gets no bitmap")
  run tree.frame(input())
  let redrawn = run showRasters(&mut tree, 9, 1, 1)
  run Testing.expect(redrawn[0] == 1 && redrawn[1] == 0xff0000, "once it holds still it does")
  run tree.frame(input())
  run Testing.expect(surfaceSprites(tree.scene(), 9) == 1, "and paints one sprite again")

  // A small canvas draws its commands.
  run batch.canvas(2, Slice.view(again.asSlice(), 0, 10))
  run tree.apply(run batch.take())
  run tree.frame(input())
  run Testing.expect(surfaceSprites(tree.scene(), 9) == 0 && tree.canvasRasters.wants.length() == 0, "a small canvas paints its commands")
}

test effect fn largeCanvasPaintsOneSprite() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rasterBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pixelsBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Canvas)
  run batch.push(Mutation.InsertBefore { parent: 1, child: 2, before: Option<u32>.None })
  // Two straight RGBA pixels: opaque red, then half transparent white.
  let pixels: [u8; 8] = [255, 0, 0, 255, 255, 255, 255, 128]
  run batch.canvasPixels(2, 2, 1, false, &pixels)
  run tree.apply(run batch.take())
  let bitmaps = tree.canvas2d.all()
  run Testing.expect(bitmaps.length == 1 && bitmaps[0].node == 2, "the pixels become the canvas's bitmap")
  run Testing.expect(bitmaps[0].pixels.width() == 2 && bitmaps[0].pixels.height() == 1 && bitmaps[0].drawn, "at their size, for the window to show")
  let data = bitmaps[0].pixels.data()
  run Testing.expect(data[0] == 255 && data[3] == 255 && data[4] == 128 && data[7] == 128, "premultiplied, as the renderer takes them")

  let mut wrong = Batch.make()
  run wrong.canvasPixels(1, 1, 1, true, &pixels)
  run Testing.expect(
    run Effect.catch<TreeError>(applied(&mut tree, run wrong.take()), refused),
    "only canvases take pixels",
  )

  run batch.canvasPixels(2, 0, 0, false, &[])
  run tree.apply(run batch.take())
  let after = tree.canvas2d.all()
  run Testing.expect(after.length == 1 && after[0].pixels.width() == 0 && after[0].drawn, "a size of zero leaves an empty bitmap for the window to take away")
}

test effect fn canvasShowsItsPixels() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pixelsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

struct AlwaysCancel {}

impl CancelCheck for AlwaysCancel {
  fn cancelled(self: &Self) -> bool {
    return true
  }
}

effect fn jobAndCancelBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Canvas)
  run batch.push(Mutation.InsertBefore { parent: 1, child: 2, before: Option<u32>.None })
  run batch.style(2, &[css.width(px(200.0)), css.height(px(150.0))])
  let mut commands = List<CanvasCommand>.make()
  let mut i: u32 = 0
  while i < 300 {
    run commands.append(CanvasCommand.FillRect {
      x: u32.toF32(i % 20) * 4.0,
      y: u32.toF32(i / 20) * 4.0,
      width: 4.0,
      height: 4.0,
      radius: 0.0,
      color: Rgba<f32>.new(0.0, 1.0, 0.0, 1.0),
    })
    i = i + 1
  }
  run batch.canvas(2, commands.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(input())
  run Testing.expect(tree.canvasRasters.wants.length() == 1, "large canvas requests a raster")
  let want = tree.canvasRasters.wants.asSlice()[0]
  run Testing.expect(tree.acceptsRaster(want.node, want.content, want.key), "fresh want is accepted")

  let prepared = run tree.prepareRasterJob(want)
  let job = match move prepared {
    Option<RasterJob>.Some { value } => move value
    Option<RasterJob>.None => {
      run Testing.expect(false, "prepareRasterJob produces an owned job")
      return ()
    }
  }
  run Testing.expect(job.commands.length() == 300, "job owns a copy of the commands")

  let mut rasterizer = CommandRasterizer.make()
  let cancelled = AlwaysCancel {}
  let aborted = run rasterizer.draw(
    job.commands.asSlice(),
    job.scale,
    job.dx,
    job.dy,
    job.width,
    job.height,
    &cancelled,
  )
  run Testing.expect(aborted.isNone(), "a cancelled raster stops early and returns None")

  let never = NeverCancel {}
  let drawn = run rasterizer.draw(
    job.commands.asSlice(),
    job.scale,
    job.dx,
    job.dy,
    job.width,
    job.height,
    &never,
  )
  match move drawn {
    Option<Pixmap>.Some { value } => {
      let data = value.data()
      let at = (u32.toUsize(2) * u32.toUsize(value.width()) + u32.toUsize(2)) * 4
      run Testing.expect(data[at] == 0 && data[at + 1] == 255 && data[at + 2] == 0, "standalone rasterizer draws expected pixels")
    }
    Option<Pixmap>.None => {
      run Testing.expect(false, "uncancelled raster returns a bitmap")
    }
  }

  // Mutating the canvas makes the earlier want stale.
  run batch.canvas(2, commands.asSlice())
  run tree.apply(run batch.take())
  run Testing.expect(!tree.acceptsRaster(want.node, want.content, want.key), "stale content is rejected")
  run Testing.expect((run tree.prepareRasterJob(want)).isNone(), "prepareRasterJob refuses stale want")
}

test effect fn commandRasterizerRespectsCancellationAndStaleness() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run jobAndCancelBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
