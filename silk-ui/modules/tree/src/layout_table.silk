//! The tree css-layout lays out, kept compactly beside the UI nodes.
//!
//! Every css-layout node is a row of links and a style index, 29 bytes in all. Elements whose
//! layout styles are equal share one entry of `styles`, held by a count of the elements that use
//! it, so a long document keeps a few hundred layout styles rather than one per element. A text
//! node of a UI text node reads its text from that node (`Node.text`, found by `slotOfCss`); only
//! the text nodes the tree makes for itself (an input's text, a rich input's runs) own theirs.
//! What few nodes have (owned text, a measurement, a scroll offset, a `::first-letter` start)
//! lives in `extras`.
//!
//! Every change goes through the table's methods, which record it in `changes` as css-layout's
//! `Tree` does, and `LayoutView` lays the table out with the UI nodes it reads text from.
import layout.lib {
  Style, NodeId, InvalidNode, Measurement, Changes, LayoutSource, GridTemplate, GridError, FloatShape,
  WrapFlow, Point, StyleChange, DisplayInside, validGridName, validGridAreaName,
  SizeValue, BoxSizing, SizeContainment,
}
import layout.lib as Layout
import node { Node }
import ui_protocol.grid { Grid }
import style_pool { KeyHasher }
import properties.census { Census }
import silk.collections.hash { Hash }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.text.string { String }
import silk.core.ownership { Copy }

pub const NO_NODE: usize = usize.MAX
const NONE: u32 = 4294967295

const LIVE: u8 = 1
const TEXT: u8 = 2
/// A text node whose text is its UI node's.
const BORROWED: u8 = 4
const CONTENT: u8 = 8
const NATURAL: u8 = 16
/// An element with `content-visibility: auto`.
const AUTOMATIC: u8 = 32
/// An automatic element whose contents are skipped: css-layout sees it with no children and the
/// style in its extra's `skip`, sized to the block size it last had.
const SKIPPED: u8 = 64
/// Marks an entry of `automatics` while they are walked, to drop repeats.
const LISTED: u8 = 128

/// One css-layout node's links, as u32 ids (`NONE` for none).
struct Links {
  parent: u32,
  firstChild: u32,
  lastChild: u32,
  nextSibling: u32,
  previousSibling: u32,
  /// The index in `styles`; a text node's is its parent's.
  style: u32,
  /// The index in `extras`, or NONE.
  extra: u32,
}
impl Copy for Links {}

/// What few nodes have.
struct Extra {
  /// An owned text node's text.
  text: String,
  textStart: usize,
  measureKey: usize,
  scrollOffset: Point,
  /// A skipped element's style as css-layout sees it, or NONE.
  skip: u32,
  /// The border-box block size a skipped element keeps.
  skipSize: f32,
}

fn wide(value: u32) -> usize { return if value == NONE { NO_NODE } else { u32.toUsize(value) } }
fn narrow(value: usize) -> u32 { return if value == NO_NODE { NONE } else { usize.toU32(value) } }

pub struct LayoutTable {
  links: List<Links>,
  flags: List<u8>,
  freeNodes: List<u32>,
  extras: List<Extra>,
  freeExtras: List<u32>,
  /// The layout styles elements use, each once while some element holds it.
  styles: List<Style>,
  /// How many elements hold each style; a free entry holds none.
  refs: List<u32>,
  hashes: List<u64>,
  /// Chains of the styles whose hashes share a bucket: the first of each, then the next.
  buckets: List<u32>,
  chains: List<u32>,
  freeStyles: List<u32>,
  hasher: KeyHasher,
  pub grids: List<GridTemplate>,
  pub gridNames: List<String>,
  freeGrids: List<usize>,
  pub shapes: List<FloatShape>,
  freeShapes: List<usize>,
  pub changes: Changes,
  pub viewportScrollOffset: Point,
  /// Sticky boxes stay at their normal position: the tree applies scroll and sticky offsets
  /// while painting, so scrolling needs no layout.
  pub stickyDeferred: bool,
  /// Some style set `wrap-flow` other than auto (see css-layout's exclusions).
  pub exclusionStyles: bool,
  /// The elements made automatic (`setAutomatic`), with ids freed or reused since among them.
  automatics: List<u32>,
  /// The structure revision of the last change to the tree's own structure, which skipping
  /// and waking do not advance (see `treeRevision`).
  treeStructure: usize,
}

impl LayoutTable {
  /// What the table holds, for the bench census (`SILK_UI_BENCH_CENSUS`).
  pub effect fn census(self: &Self, out: &mut Census) ! OutOfMemoryError ? &mut Allocator {
    let mut textBytes: usize = 0
    let mut textRoom: usize = 0
    let mut at: usize = 0
    while at < self.extras.length() {
      let extra = &self.extras.asSlice()[at]
      textBytes = textBytes + String.utf8Bytes(String.view(&extra.text)).length
      textRoom = textRoom + extra.text.capacity()
      at = at + 1
    }
    run out.unit("tree.layout-table.nodes", self.links.length() - self.freeNodes.length())
    run out.held("tree.layout-table.links", self.links.length(), self.links.capacity(), Intrinsic.layoutOf<Links>().bytes)
    run out.held("tree.layout-table.flags", self.flags.length(), self.flags.capacity(), 1)
    run out.held("tree.layout-table.extras", self.extras.length(), self.extras.capacity(), Intrinsic.layoutOf<Extra>().bytes)
    run out.bytes("tree.layout-table.extras.text-bytes", textBytes, textRoom)
    run out.held("tree.layout-table.styles", self.styles.length(), self.styles.capacity(), Intrinsic.layoutOf<Style>().bytes)
    run out.held("tree.layout-table.style-index", self.refs.length() + self.buckets.length() + self.chains.length(), self.refs.capacity() + self.buckets.capacity() + self.chains.capacity(), 4)
    run out.held("tree.layout-table.style-hashes", self.hashes.length(), self.hashes.capacity(), 8)
    run out.held("tree.layout-table.grids", self.grids.length(), self.grids.capacity(), Intrinsic.layoutOf<GridTemplate>().bytes)
    run out.held("tree.layout-table.grid-names", self.gridNames.length(), self.gridNames.capacity(), Intrinsic.layoutOf<String>().bytes)
    run out.held("tree.layout-table.shapes", self.shapes.length(), self.shapes.capacity(), Intrinsic.layoutOf<FloatShape>().bytes)
    run out.held("tree.layout-table.free-lists", self.freeNodes.length() + self.freeExtras.length() + self.freeStyles.length(), self.freeNodes.capacity() + self.freeExtras.capacity() + self.freeStyles.capacity(), 4)
    run out.held("tree.layout-table.free-grids-shapes", self.freeGrids.length() + self.freeShapes.length(), self.freeGrids.capacity() + self.freeShapes.capacity(), Intrinsic.layoutOf<usize>().bytes)
    run self.changes.census(&mut out)
  }
  /// A table holding only the root, styled `style`.
  pub effect fn make(style: Style) -> LayoutTable ! OutOfMemoryError ? &mut Allocator {
    let mut shapes = List<FloatShape>.make()
    run shapes.append(FloatShape.make())
    let mut grids = List<GridTemplate>.make()
    run grids.append(GridTemplate.make())
    let mut gridNames = List<String>.make()
    run gridNames.append(run String.copy(""))
    let mut table = LayoutTable {
      links: List<Links>.make(), flags: List<u8>.make(), freeNodes: List<u32>.make(),
      extras: List<Extra>.make(), freeExtras: List<u32>.make(),
      styles: List<Style>.make(), refs: List<u32>.make(), hashes: List<u64>.make(),
      buckets: List<u32>.make(), chains: List<u32>.make(), freeStyles: List<u32>.make(),
      hasher: KeyHasher.make<Style>(Hash.seed(0x6c61796f7574)),
      grids: move grids, gridNames: move gridNames, freeGrids: List<usize>.make(),
      shapes: move shapes, freeShapes: List<usize>.make(),
      changes: run Changes.make(),
      viewportScrollOffset: Point { x: 0.0, y: 0.0 }, stickyDeferred: false, exclusionStyles: false,
      automatics: List<u32>.make(), treeStructure: 0,
    }
    let mut value = move style
    value.grid = 0
    value.shape = 0
    if value.wrapFlow != WrapFlow.Auto { table.exclusionStyles = true }
    let index = run table.intern(&value)
    run table.links.append(Links { parent: NONE, firstChild: NONE, lastChild: NONE, nextSibling: NONE, previousSibling: NONE, style: index, extra: NONE })
    run table.flags.append(LIVE)
    return move table
  }

  // ---- Reading ----

  pub fn nodeCount(self: &Self) -> usize { return self.links.length() }
  pub fn root(self: &Self) -> NodeId { return NodeId { index: 0 } }
  /// Whether `id` names a node: one in range that destroy has not freed.
  pub fn contains(self: &Self, id: NodeId) -> bool { return self.exists(id.index) }
  @inlineAlways
  pub fn exists(self: &Self, node: usize) -> bool { return node < self.flags.length() && u8.bitAnd(self.flags.get(node), LIVE) != 0 }
  @inlineAlways
  pub fn parent(self: &Self, node: usize) -> usize { return wide(self.links.asSlice()[node].parent) }
  @inlineAlways
  pub fn firstChild(self: &Self, node: usize) -> usize { return wide(self.links.asSlice()[node].firstChild) }
  @inlineAlways
  pub fn lastChild(self: &Self, node: usize) -> usize { return wide(self.links.asSlice()[node].lastChild) }
  @inlineAlways
  pub fn nextSibling(self: &Self, node: usize) -> usize { return wide(self.links.asSlice()[node].nextSibling) }
  @inlineAlways
  pub fn previousSibling(self: &Self, node: usize) -> usize { return wide(self.links.asSlice()[node].previousSibling) }
  @inlineAlways
  pub fn isText(self: &Self, node: usize) -> bool { return u8.bitAnd(self.flags.get(node), TEXT) != 0 }
  @inlineAlways
  pub fn styleIndex(self: &Self, node: usize) -> usize { return u32.toUsize(self.links.asSlice()[node].style) }
  /// Node `node`'s layout style; a text node's is its parent's.
  pub fn style(self: &Self, node: usize) -> &Style { return &self.styles.asSlice()[self.styleIndex(node)] }
  pub fn styleTable(self: &Self) -> &[Style] { return self.styles.asSlice() }
  /// Distinct layout styles held, for tests and memory reports.
  pub fn styleCount(self: &Self) -> usize { return self.styles.length() - self.freeStyles.length() }
  pub fn textStart(self: &Self, node: usize) -> usize {
    let extra = self.links.asSlice()[node].extra
    return if extra == NONE { 0 } else { self.extras.asSlice()[u32.toUsize(extra)].textStart }
  }
  pub fn measurement(self: &Self, node: usize) -> Measurement {
    let flags = self.flags.get(node)
    if u8.bitAnd(flags, CONTENT) != 0 { return Measurement.Content }
    if u8.bitAnd(flags, NATURAL) != 0 { return Measurement.Natural }
    return Measurement.None
  }
  pub fn measureKey(self: &Self, node: usize) -> usize {
    let extra = self.links.asSlice()[node].extra
    return if extra == NONE { 0 } else { self.extras.asSlice()[u32.toUsize(extra)].measureKey }
  }
  pub fn scrollOffset(self: &Self, node: usize) -> Point {
    let extra = self.links.asSlice()[node].extra
    return if extra == NONE { Point { x: 0.0, y: 0.0 } } else { self.extras.asSlice()[u32.toUsize(extra)].scrollOffset }
  }
  /// Whether text node `node` reads its text from its UI node.
  pub fn borrowsText(self: &Self, node: usize) -> bool { return u8.bitAnd(self.flags.get(node), BORROWED) != 0 }
  /// An owned text node's text; empty for a node that borrows its text.
  pub fn ownText<'a>(self: &'a Self, node: usize) -> string<'a> {
    let extra = self.links.asSlice()[node].extra
    if extra == NONE { return "" }
    return String.view(&self.extras.asSlice()[u32.toUsize(extra)].text)
  }
  /// The text of text node `node`, read from `nodes` for a borrowed one.
  pub fn textIn<'a>(self: &'a Self, node: usize, nodes: &'a [Node], slots: &'a [u32]) -> Option<string<'a>> {
    if !self.isText(node) { return Option<string<'a>>.None }
    if self.borrowsText(node) {
      if node >= slots.length || slots[node] == NONE { return Option<string<'a>>.Some { value: "" } }
      return Option<string<'a>>.Some { value: String.view(&nodes[u32.toUsize(slots[node])].text) }
    }
    return Option<string<'a>>.Some { value: self.ownText(node) }
  }
  pub fn revision(self: &Self) -> usize { return self.changes.revision() }
  pub fn structureRevision(self: &Self) -> usize { return self.changes.structureRevision() }
  /// The revision of the last change to which nodes the table holds and how they link, which
  /// skipping an element's contents is not: it changes only what css-layout sees.
  pub fn treeRevision(self: &Self) -> usize { return self.treeStructure }
  pub fn scrollRevision(self: &Self) -> usize { return self.changes.scrollRevision() }
  pub fn changedAt(self: &Self, node: usize) -> usize { return self.changes.changedAt(node) }
  pub fn outerChangedAt(self: &Self, node: usize) -> usize { return self.changes.outerChangedAt(node) }
  pub fn insetsChangedAt(self: &Self, node: usize) -> usize { return self.changes.insetsChangedAt(node) }

  // ---- Making and linking ----

  /// Makes an element outside the tree, for insertBefore to attach. Its id is the one destroy
  /// freed last, if any.
  pub effect fn create(self: &mut Self, style: Style) -> NodeId ! OutOfMemoryError ? &mut Allocator {
    let mut value = move style
    value.grid = 0
    value.shape = 0
    if value.wrapFlow != WrapFlow.Auto { self.exclusionStyles = true }
    run self.reserveSlot()
    let index = run self.intern(&value)
    let id = run self.publish(Links { parent: NONE, firstChild: NONE, lastChild: NONE, nextSibling: NONE, previousSibling: NONE, style: index, extra: NONE }, LIVE)
    return NodeId { index: id }
  }

  /// Makes a text node outside the tree that owns `value`. It takes its parent's style once
  /// attached.
  pub effect fn createText(self: &mut Self, value: String) -> NodeId ! OutOfMemoryError ? &mut Allocator {
    run self.reserveSlot()
    let id = run self.publish(Links { parent: NONE, firstChild: NONE, lastChild: NONE, nextSibling: NONE, previousSibling: NONE, style: 0, extra: NONE }, u8.bitOr(LIVE, TEXT))
    if String.byteLength(String.view(&value)) != 0 {
      let extra = run self.extraOf(id)
      let extras = self.extras.asMutSlice()
      extras[extra].text = move value
    }
    return NodeId { index: id }
  }

  /// Makes a text node outside the tree whose text is its UI node's (`slotOfCss`), empty so far:
  /// the UI tree tells it of every change with `borrowedTextChanged`.
  pub effect fn createBorrowedText(self: &mut Self) -> NodeId ! OutOfMemoryError ? &mut Allocator {
    run self.reserveSlot()
    let id = run self.publish(Links { parent: NONE, firstChild: NONE, lastChild: NONE, nextSibling: NONE, previousSibling: NONE, style: 0, extra: NONE }, u8.bitOr(u8.bitOr(LIVE, TEXT), BORROWED))
    return NodeId { index: id }
  }

  effect fn reserveSlot(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    if self.freeNodes.length() != 0 { return }
    run self.links.reserve(1)
    run self.flags.reserve(1)
    run self.changes.reserve(1)
  }

  effect fn publish(self: &mut Self, links: Links, flags: u8) -> usize ! OutOfMemoryError ? &mut Allocator {
    if self.freeNodes.length() != 0 {
      let last = self.freeNodes.length() - 1
      let index = u32.toUsize(self.freeNodes.get(last))
      self.freeNodes.truncate(last)
      let rows = self.links.asMutSlice()
      rows[index] = links
      self.flags.set(index, flags)
      run self.changes.created(index)
      self.treeStructure = self.changes.structureRevision()
      return index
    }
    let index = self.links.length()
    run self.links.append(links)
    run self.flags.append(flags)
    run self.changes.created(index)
    self.treeStructure = self.changes.structureRevision()
    return index
  }

  fn canParent(self: &Self, parent: NodeId) -> bool {
    return self.contains(parent) && !self.isText(parent.index) && self.measurement(parent.index) == Measurement.None
  }

  /// Inserts `child` among `parent`'s children before `before`, or last without it. A child
  /// already in a tree moves with its subtree. The root cannot move, and a node cannot go inside
  /// itself.
  pub effect fn insertBefore(self: &mut Self, parent: NodeId, child: NodeId, before: Option<NodeId>) ! InvalidNode {
    if !self.canParent(parent) { fail InvalidNode { index: parent.index } }
    if !self.contains(child) || child.index == 0 { fail InvalidNode { index: child.index } }
    let mut ancestor = parent.index
    while ancestor != NO_NODE {
      if ancestor == child.index { fail InvalidNode { index: child.index } }
      ancestor = self.parent(ancestor)
    }
    let mut next = NO_NODE
    match before {
      Option<NodeId>.Some { value } => {
        if !self.contains(value) || self.parent(value.index) != parent.index { fail InvalidNode { index: value.index } }
        next = value.index
      }
      Option<NodeId>.None => {}
    }
    if next == child.index { next = self.nextSibling(child.index) }
    if self.parent(child.index) != NO_NODE { self.unlink(child.index) }
    let style = self.links.asSlice()[parent.index].style
    let text = self.isText(child.index)
    let rows = self.links.asMutSlice()
    let mut previous = wide(rows[parent.index].lastChild)
    if next != NO_NODE { previous = wide(rows[next].previousSibling) }
    rows[child.index].parent = narrow(parent.index)
    rows[child.index].previousSibling = narrow(previous)
    rows[child.index].nextSibling = narrow(next)
    if previous == NO_NODE { rows[parent.index].firstChild = narrow(child.index) } else { rows[previous].nextSibling = narrow(child.index) }
    if next == NO_NODE { rows[parent.index].lastChild = narrow(child.index) } else { rows[next].previousSibling = narrow(child.index) }
    if text { rows[child.index].style = style }
    self.changes.inserted(parent.index, child.index)
    self.treeStructure = self.changes.structureRevision()
  }

  /// Takes a node and its subtree out of the tree, keeping them for a later insertBefore.
  pub effect fn remove(self: &mut Self, id: NodeId) ! InvalidNode {
    if !self.contains(id) || id.index == 0 { fail InvalidNode { index: id.index } }
    let parent = self.parent(id.index)
    if parent == NO_NODE { return }
    self.detach(id.index)
    self.changes.removed(id.index, parent)
    self.treeStructure = self.changes.structureRevision()
  }

  fn unlink(self: &mut Self, id: usize) {
    let parent = self.parent(id)
    self.detach(id)
    self.changes.unlinked(parent)
  }

  fn detach(self: &mut Self, id: usize) {
    let rows = self.links.asMutSlice()
    let parent = u32.toUsize(rows[id].parent)
    let previous = rows[id].previousSibling
    let next = rows[id].nextSibling
    if previous == NONE { rows[parent].firstChild = next } else { rows[u32.toUsize(previous)].nextSibling = next }
    if next == NONE { rows[parent].lastChild = previous } else { rows[u32.toUsize(next)].previousSibling = previous }
    rows[id].parent = NONE
    rows[id].previousSibling = NONE
    rows[id].nextSibling = NONE
  }

  /// Removes a node and frees it and its subtree: their ids, styles, grids and shapes go to
  /// later creates, last freed first.
  pub effect fn destroy(self: &mut Self, id: NodeId) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || id.index == 0 { fail InvalidNode { index: id.index } }
    let mut count: usize = 0
    let mut elements: usize = 0
    let mut extras: usize = 0
    let mut at = id.index
    while at != NO_NODE {
      count = count + 1
      if !self.isText(at) { elements = elements + 1 }
      if self.links.asSlice()[at].extra != NONE { extras = extras + 1 }
      at = self.following(id.index, at)
    }
    run self.freeNodes.reserve(count)
    run self.freeStyles.reserve(elements)
    run self.freeGrids.reserve(elements)
    run self.freeShapes.reserve(elements)
    run self.freeExtras.reserve(extras)
    if self.parent(id.index) != NO_NODE { self.unlink(id.index) } else { self.changes.destroying() }
    at = id.index
    while at != NO_NODE {
      let next = self.following(id.index, at)
      run self.freeNodes.append(narrow(at))
      let text = self.isText(at)
      self.flags.set(at, 0)
      self.changes.freed(at)
      if !text {
        let index = self.styleIndex(at)
        let handle = self.styles.asSlice()[index].grid
        if handle != 0 {
          let templates = self.grids.asMutSlice()
          templates[handle] = GridTemplate.make()
          run self.freeGrids.append(handle)
        }
        let shape = u32.toUsize(self.styles.asSlice()[index].shape)
        if shape != 0 {
          let areas = self.shapes.asMutSlice()
          areas[shape] = FloatShape.make()
          run self.freeShapes.append(shape)
        }
        run self.release(index)
      }
      let extra = self.links.asSlice()[at].extra
      if extra != NONE {
        let skip = self.extras.asSlice()[u32.toUsize(extra)].skip
        if skip != NONE { run self.release(u32.toUsize(skip)) }
        let all = self.extras.asMutSlice()
        all[u32.toUsize(extra)] = Extra { text: String.make(), textStart: 0, measureKey: 0, scrollOffset: Point { x: 0.0, y: 0.0 }, skip: NONE, skipSize: 0.0 }
        run self.freeExtras.append(extra)
        let rows = self.links.asMutSlice()
        rows[at].extra = NONE
      }
      at = next
    }
    // Freed rows keep their links until reused; following walks them above.
    self.changes.structureChanged()
    self.treeStructure = self.changes.structureRevision()
  }

  fn following(self: &Self, root: usize, at: usize) -> usize {
    if self.firstChild(at) != NO_NODE { return self.firstChild(at) }
    let mut node = at
    while node != root {
      if self.nextSibling(node) != NO_NODE { return self.nextSibling(node) }
      node = self.parent(node)
    }
    return NO_NODE
  }

  // ---- Styles ----

  /// Replaces an element's own style. An unchanged style leaves the node clean.
  pub effect fn setStyle(self: &mut Self, id: NodeId, style: Style) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.isText(id.index) { fail InvalidNode { index: id.index } }
    let current = self.styleIndex(id.index)
    let mut value = move style
    value.grid = self.styles.asSlice()[current].grid
    value.shape = self.styles.asSlice()[current].shape
    if self.measurement(id.index) == Measurement.Natural { value.replaced = true }
    let change = self.classify(id.index, &value)
    if change.same { return }
    if value.wrapFlow != WrapFlow.Auto { self.exclusionStyles = true }
    if self.skipped(id.index) {
      // css-layout sees the skipped style, made again from the new one.
      let before = self.seenStyle(id.index).*
      run self.restyle(id.index, &value)
      let size = self.extras.asSlice()[self.extraIndex(id.index)].skipSize
      run self.reskip(id.index, size)
      let seen = self.classifyFrom(id.index, &before, self.seenStyle(id.index))
      let parent = self.parent(id.index)
      self.changes.styleChanged(id.index, parent, seen)
      return
    }
    run self.restyle(id.index, &value)
    let parent = self.parent(id.index)
    self.changes.styleChanged(id.index, parent, change)
  }

  /// Gives element `id` the style entry element `from` holds, when `style` is the style that
  /// entry was made from and `id` would make the same entry from it (the same grid, shape and
  /// measurement): one hold more on that entry and no hashing. Otherwise as `setStyle`.
  pub effect fn shareStyle(self: &mut Self, id: NodeId, from: NodeId, style: Style) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.isText(id.index) || !self.contains(from) || self.isText(from.index) { fail InvalidNode { index: id.index } }
    let current = self.styleIndex(id.index)
    let shared = self.styleIndex(from.index)
    if current == shared { return }
    let mine = &self.styles.asSlice()[current]
    let theirs = &self.styles.asSlice()[shared]
    let natural = self.measurement(id.index) == Measurement.Natural
    if self.skipped(id.index) || self.skipped(from.index) || mine.grid != theirs.grid || mine.shape != theirs.shape
      || natural != (self.measurement(from.index) == Measurement.Natural) || (natural && !theirs.replaced) {
      run self.setStyle(id, move style)
      return
    }
    let change = self.classify(id.index, theirs)
    if change.same { return }
    if theirs.wrapFlow != WrapFlow.Auto { self.exclusionStyles = true }
    let count = self.refs.get(shared) + 1
    self.refs.set(shared, count)
    let entry = usize.toU32(shared)
    let rows = self.links.asMutSlice()
    rows[id.index].style = entry
    drop rows
    let mut child = self.firstChild(id.index)
    while child != NO_NODE {
      if self.isText(child) {
        let texts = self.links.asMutSlice()
        texts[child].style = entry
      }
      child = self.nextSibling(child)
    }
    run self.release(current)
    let parent = self.parent(id.index)
    self.changes.styleChanged(id.index, parent, change)
  }

  // ---- content-visibility: auto ----

  /// Whether element `node` has `content-visibility: auto`.
  pub fn automatic(self: &Self, node: usize) -> bool { return u8.bitAnd(self.flags.get(node), AUTOMATIC) != 0 }
  /// Whether element `node`'s contents are skipped.
  @inlineAlways
  pub fn skipped(self: &Self, node: usize) -> bool { return u8.bitAnd(self.flags.get(node), SKIPPED) != 0 }
  /// The index of the style css-layout sees for `node`: a skipped element's skip style.
  @inlineAlways
  pub fn seenStyleIndex(self: &Self, node: usize) -> usize {
    if !self.skipped(node) { return self.styleIndex(node) }
    return u32.toUsize(self.extras.asSlice()[self.extraIndex(node)].skip)
  }
  pub fn seenStyle(self: &Self, node: usize) -> &Style { return &self.styles.asSlice()[self.seenStyleIndex(node)] }
  /// The border-box block size skipped element `node` keeps.
  pub fn skipSize(self: &Self, node: usize) -> f32 { return self.extras.asSlice()[self.extraIndex(node)].skipSize }
  fn extraIndex(self: &Self, node: usize) -> usize { return u32.toUsize(self.links.asSlice()[node].extra) }

  /// Makes element `id` automatic or not. An element made automatic starts skipped, at block
  /// size `estimate`; one made not automatic is woken.
  pub effect fn setAutomatic(self: &mut Self, id: NodeId, automatic: bool, estimate: f32) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.isText(id.index) { fail InvalidNode { index: id.index } }
    if automatic == self.automatic(id.index) { return }
    if automatic {
      let flags = self.flags.get(id.index)
      self.flags.set(id.index, u8.bitOr(flags, AUTOMATIC))
      run self.automatics.append(narrow(id.index))
      run self.setSkipped(id, true, estimate)
    } else {
      run self.setSkipped(id, false, 0.0)
      let flags = self.flags.get(id.index)
      self.flags.set(id.index, u8.bitAnd(flags, 255 - AUTOMATIC))
    }
  }

  /// Appends the automatic elements to `result`, once each, and forgets freed ones.
  pub effect fn automaticElements(self: &mut Self, result: &mut List<u32>) ! OutOfMemoryError ? &mut Allocator {
    let mut kept: usize = 0
    let mut at: usize = 0
    while at < self.automatics.length() {
      let node = u32.toUsize(self.automatics.get(at))
      at = at + 1
      if !self.exists(node) || !self.automatic(node) || u8.bitAnd(self.flags.get(node), LISTED) != 0 { continue }
      let flags = self.flags.get(node)
      self.flags.set(node, u8.bitOr(flags, LISTED))
      self.automatics.set(kept, narrow(node))
      kept = kept + 1
    }
    self.automatics.truncate(kept)
    at = 0
    while at < kept {
      let node = u32.toUsize(self.automatics.get(at))
      let flags = self.flags.get(node)
      self.flags.set(node, u8.bitAnd(flags, 255 - LISTED))
      run result.append(narrow(node))
      at = at + 1
    }
  }

  /// Skips element `id`'s contents, keeping border-box block size `size`, or lays them out
  /// again. Either way its children generate boxes anew.
  pub effect fn setSkipped(self: &mut Self, id: NodeId, skipped: bool, size: f32) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.isText(id.index) { fail InvalidNode { index: id.index } }
    let node = id.index
    if skipped == self.skipped(node) && (!skipped || self.skipSize(node) == size) { return }
    let before = self.seenStyle(node).*
    if skipped {
      run self.reskip(node, size)
      let flags = self.flags.get(node)
      self.flags.set(node, u8.bitOr(flags, SKIPPED))
    } else {
      let extra = self.extraIndex(node)
      let skip = self.extras.asSlice()[extra].skip
      let flags = self.flags.get(node)
      self.flags.set(node, u8.bitAnd(flags, 255 - SKIPPED))
      let extras = self.extras.asMutSlice()
      extras[extra].skip = NONE
      run self.release(u32.toUsize(skip))
    }
    let change = self.classifyFrom(node, &before, self.seenStyle(node))
    let parent = self.parent(node)
    self.changes.styleChanged(node, parent, change)
    // Its children appear or disappear for css-layout.
    self.changes.unlinked(node)
    self.changes.structureChanged()
  }

  // Makes skipped element `node`'s skip style from its own, at block size `size`.
  effect fn reskip(self: &mut Self, node: usize, size: f32) ! OutOfMemoryError ? &mut Allocator {
    let mut value = self.style(node).*
    value.height = SizeValue.px(size)
    value.boxSizing = BoxSizing.BorderBox
    value.sizeContainment = SizeContainment.Size
    value.layoutContainment = true
    let index = run self.intern(&value)
    let extra = run self.extraOf(node)
    let previous = self.extras.asSlice()[extra].skip
    let extras = self.extras.asMutSlice()
    extras[extra].skip = index
    extras[extra].skipSize = size
    if previous != NONE { run self.release(u32.toUsize(previous)) }
  }

  // How a change of what css-layout sees of element `node`'s style, from `previous` to `next`,
  // reaches it and its parent.
  fn classifyFrom(self: &Self, node: usize, previous: &Style, next: &Style) -> StyleChange {
    let parent = self.parent(node)
    let mut flexParent = false
    let mut gridParent = false
    if parent != NO_NODE { flexParent = self.style(parent).display.insideIs(DisplayInside.Flex) }
    let mut generatedParent = parent
    while generatedParent != NO_NODE {
      let display = &self.style(generatedParent).display
      if !display.isContents() {
        gridParent = display.isGrid()
        break
      }
      generatedParent = self.parent(generatedParent)
    }
    return Layout.classify(previous, next, flexParent, gridParent)
  }

  // How a change of element `node`'s style to `next` reaches it and its parent, as css-layout's
  // `classifyIn` decides.
  fn classify(self: &Self, node: usize, next: &Style) -> StyleChange {
    let parent = self.parent(node)
    let mut flexParent = false
    let mut gridParent = false
    if parent != NO_NODE { flexParent = self.style(parent).display.insideIs(DisplayInside.Flex) }
    let mut generatedParent = parent
    while generatedParent != NO_NODE {
      let display = &self.style(generatedParent).display
      if !display.isContents() {
        gridParent = display.isGrid()
        break
      }
      generatedParent = self.parent(generatedParent)
    }
    return Layout.classify(self.style(node), next, flexParent, gridParent)
  }

  // Moves element `node` to the entry holding `value`, and its text children with it.
  effect fn restyle(self: &mut Self, node: usize, value: &Style) ! OutOfMemoryError ? &mut Allocator {
    let previous = self.styleIndex(node)
    let index = run self.intern(value)
    let rows = self.links.asMutSlice()
    rows[node].style = index
    drop rows
    let mut child = self.firstChild(node)
    while child != NO_NODE {
      if self.isText(child) {
        let texts = self.links.asMutSlice()
        texts[child].style = index
      }
      child = self.nextSibling(child)
    }
    run self.release(previous)
  }

  // The entry holding a style equal to `value`, taking a hold on it.
  effect fn intern(self: &mut Self, value: &Style) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let hash = run self.hasher.hash(value)
    if self.buckets.length() != 0 {
      let mut at = self.buckets.get(u64.wrappingToUsize(hash) % self.buckets.length())
      while at != NONE {
        let index = u32.toUsize(at)
        if self.hashes.get(index) == hash && &self.styles.asSlice()[index] == value {
          let count = self.refs.get(index) + 1
          self.refs.set(index, count)
          return at
        }
        at = self.chains.get(index)
      }
    }
    let mut index = self.styles.length()
    if self.freeStyles.length() != 0 {
      let last = self.freeStyles.length() - 1
      index = u32.toUsize(self.freeStyles.get(last))
      self.freeStyles.truncate(last)
      let all = self.styles.asMutSlice()
      all[index] = value.*
      self.refs.set(index, 1)
      self.hashes.set(index, hash)
    } else {
      run self.styles.append(value.*)
      run self.refs.append(1)
      run self.hashes.append(hash)
      run self.chains.append(NONE)
    }
    if self.held() * 2 > self.buckets.length() { run self.rehash() }
    else { self.link(index) }
    return usize.toU32(index)
  }

  fn held(self: &Self) -> usize { return self.styles.length() - self.freeStyles.length() }

  fn link(self: &mut Self, index: usize) {
    let bucket = u64.wrappingToUsize(self.hashes.get(index)) % self.buckets.length()
    self.chains.set(index, self.buckets.get(bucket))
    self.buckets.set(bucket, usize.toU32(index))
  }

  effect fn rehash(self: &mut Self) ! OutOfMemoryError ? &mut Allocator {
    let mut size: usize = 64
    while size < self.held() * 4 { size = size * 2 }
    self.buckets.clear()
    run self.buckets.appendRepeated(NONE, size)
    let mut index: usize = 0
    while index < self.styles.length() {
      if self.refs.get(index) != 0 { self.link(index) }
      index = index + 1
    }
  }

  // Drops a hold on entry `index`, freeing it when it was the last.
  effect fn release(self: &mut Self, index: usize) ! OutOfMemoryError ? &mut Allocator {
    let count = self.refs.get(index)
    if count > 1 {
      self.refs.set(index, count - 1)
      return
    }
    self.refs.set(index, 0)
    let bucket = u64.wrappingToUsize(self.hashes.get(index)) % self.buckets.length()
    let mut at = self.buckets.get(bucket)
    let after = self.chains.get(index)
    if at == usize.toU32(index) { self.buckets.set(bucket, after) }
    else {
      while at != NONE {
        let next = self.chains.get(u32.toUsize(at))
        if next == usize.toU32(index) {
          self.chains.set(u32.toUsize(at), after)
          break
        }
        at = next
      }
    }
    self.chains.set(index, NONE)
    run self.freeStyles.append(usize.toU32(index))
  }

  // ---- Text ----

  /// Replaces an owned text node's text.
  pub effect fn setText(self: &mut Self, id: NodeId, value: String) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || !self.isText(id.index) || self.borrowsText(id.index) { fail InvalidNode { index: id.index } }
    let wasBlank = Layout.blank(self.ownText(id.index))
    let blank = Layout.blank(String.view(&value))
    let extra = run self.extraOf(id.index)
    let extras = self.extras.asMutSlice()
    extras[extra].text = move value
    extras[extra].textStart = 0
    let parent = self.parent(id.index)
    self.changes.textChanged(id.index, parent, blank != wasBlank)
  }

  /// Records that the UI node whose text borrowed text node `id` reads has new text, blank
  /// (white space only) or not as `blank` and before as `wasBlank`. The start another box takes
  /// goes back to zero.
  pub effect fn borrowedTextChanged(self: &mut Self, id: NodeId, wasBlank: bool, blank: bool) ! InvalidNode {
    if !self.contains(id) || !self.borrowsText(id.index) { fail InvalidNode { index: id.index } }
    let extra = self.links.asSlice()[id.index].extra
    if extra != NONE {
      let extras = self.extras.asMutSlice()
      extras[u32.toUsize(extra)].textStart = 0
    }
    let parent = self.parent(id.index)
    self.changes.textChanged(id.index, parent, blank != wasBlank)
  }

  /// Leaves the first `start` bytes of text node `id`, whose text is `text`, to another box: a
  /// host's ::first-letter lays out the letter it takes.
  pub effect fn setTextStart(self: &mut Self, id: NodeId, start: usize, text: string) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || !self.isText(id.index) { fail InvalidNode { index: id.index } }
    let previous = self.textStart(id.index)
    if previous == start { return }
    let wasBlank = Layout.blank(laid(text, previous))
    let extra = run self.extraOf(id.index)
    let extras = self.extras.asMutSlice()
    extras[extra].textStart = start
    let blank = Layout.blank(laid(text, start))
    let parent = self.parent(id.index)
    self.changes.textChanged(id.index, parent, blank != wasBlank)
  }

  // The extra of node `node`, made if it has none.
  effect fn extraOf(self: &mut Self, node: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
    let current = self.links.asSlice()[node].extra
    if current != NONE { return u32.toUsize(current) }
    let fresh = Extra { text: String.make(), textStart: 0, measureKey: 0, scrollOffset: Point { x: 0.0, y: 0.0 }, skip: NONE, skipSize: 0.0 }
    let mut index = self.extras.length()
    if self.freeExtras.length() != 0 {
      let last = self.freeExtras.length() - 1
      index = u32.toUsize(self.freeExtras.get(last))
      self.freeExtras.truncate(last)
      let extras = self.extras.asMutSlice()
      extras[index] = move fresh
    } else {
      run self.extras.append(move fresh)
    }
    let rows = self.links.asMutSlice()
    rows[node].extra = usize.toU32(index)
    return index
  }

  // ---- Measurement, scrolling, grids and shapes ----

  pub effect fn setScrollOffset(self: &mut Self, id: NodeId, offset: Point) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.isText(id.index) { fail InvalidNode { index: id.index } }
    let current = self.scrollOffset(id.index)
    if current.x == offset.x && current.y == offset.y { return }
    let extra = run self.extraOf(id.index)
    let extras = self.extras.asMutSlice()
    extras[extra].scrollOffset = offset
    self.changes.scrolled(id.index)
  }

  pub effect fn setMeasurement(self: &mut Self, id: NodeId, key: usize) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.isText(id.index) || self.firstChild(id.index) != NO_NODE { fail InvalidNode { index: id.index } }
    let extra = run self.extraOf(id.index)
    let extras = self.extras.asMutSlice()
    extras[extra].measureKey = key
    let flags = u8.bitOr(u8.bitAnd(self.flags.get(id.index), 255 - NATURAL), CONTENT)
    self.flags.set(id.index, flags)
    let parent = self.parent(id.index)
    self.changes.measured(id.index, parent)
  }

  pub effect fn setNaturalMeasurement(self: &mut Self, id: NodeId, key: usize) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.isText(id.index) || self.firstChild(id.index) != NO_NODE { fail InvalidNode { index: id.index } }
    let extra = run self.extraOf(id.index)
    let extras = self.extras.asMutSlice()
    extras[extra].measureKey = key
    let flags = u8.bitOr(u8.bitAnd(self.flags.get(id.index), 255 - CONTENT), NATURAL)
    self.flags.set(id.index, flags)
    // Natural measurement makes a replaced element whatever its style says.
    if !self.style(id.index).replaced {
      let mut value = self.style(id.index).*
      value.replaced = true
      run self.restyle(id.index, &value)
    }
    let parent = self.parent(id.index)
    self.changes.measured(id.index, parent)
  }

  /// Records a change the table cannot see, such as new content behind a measurement key.
  pub effect fn markDirty(self: &mut Self, id: NodeId) ! InvalidNode {
    if !self.contains(id) { fail InvalidNode { index: id.index } }
    self.changes.marked(id.index)
  }

  pub effect fn internGridName(self: &mut Self, name: string) -> usize ! GridError | OutOfMemoryError ? &mut Allocator {
    if !validGridName(name) { fail GridError {} }
    return run self.internName(name)
  }

  pub effect fn internGridAreaName(self: &mut Self, name: string) -> usize ! GridError | OutOfMemoryError ? &mut Allocator {
    if !validGridAreaName(name) { fail GridError {} }
    return run self.internName(name)
  }

  effect fn internName(self: &mut Self, name: string) -> usize ! OutOfMemoryError ? &mut Allocator {
    let mut index: usize = 1
    while index < self.gridNames.length() {
      if String.view(&self.gridNames.asSlice()[index]) == name { return index }
      index = index + 1
    }
    run self.gridNames.append(run String.copy(name))
    return index
  }

  /// Gives element `id` the grid template of `grid`, interning its names here.
  pub effect fn installGrid(self: &mut Self, grid: Grid, id: NodeId) ! GridError | InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !grid.template.valid(grid.names.length() + 1) { fail GridError {} }
    let mut ids = List<usize>.make()
    run ids.append(0)
    let mut i: usize = 0
    while i < grid.names.length() {
      run ids.append(run self.internGridAreaName(String.view(&grid.names.asSlice()[i])))
      i = i + 1
    }
    run self.setGrid(id, run grid.remapped(&ids))
  }

  /// Replaces element `id`'s grid template; empty lists are the initial auto tracks and no
  /// template.
  pub effect fn setGrid(self: &mut Self, id: NodeId, template: GridTemplate) ! InvalidNode | GridError | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.isText(id.index) { fail InvalidNode { index: id.index } }
    if !template.valid(self.gridNames.length()) { fail GridError {} }
    let handle = self.style(id.index).grid
    if handle == 0 && template.isInitial() {
      self.changes.innerChanged(id.index)
      return
    }
    let old = &self.grids.asSlice()[handle]
    // Subgrid metadata affects its parent's placement and descendant track contributions even
    // when the item's outer dimensions stay unchanged.
    let outer = !old.placement.same(&template.placement)
      || old.rows.subgrid || old.columns.subgrid
      || template.rows.subgrid || template.columns.subgrid
    let same = old.same(&template)
    if same && !outer { return }
    if handle != 0 {
      let grids = self.grids.asMutSlice()
      grids[handle] = move template
    } else {
      let mut slot = self.grids.length()
      if self.freeGrids.length() != 0 {
        let last = self.freeGrids.length() - 1
        slot = self.freeGrids.get(last)
        self.freeGrids.truncate(last)
        let grids = self.grids.asMutSlice()
        grids[slot] = move template
      } else {
        run self.grids.append(move template)
      }
      let mut value = self.style(id.index).*
      value.grid = slot
      run self.restyle(id.index, &value)
    }
    self.changes.gridChanged(id.index, !same, outer)
  }

  /// Replaces the `shape-outside` area of a float (CSS Shapes 1 §3.1).
  pub effect fn setShape(self: &mut Self, id: NodeId, shape: &FloatShape) ! InvalidNode | OutOfMemoryError ? &mut Allocator {
    if !self.contains(id) || self.isText(id.index) { fail InvalidNode { index: id.index } }
    let handle = u32.toUsize(self.style(id.index).shape)
    if self.shapes.asSlice()[handle].same(shape) { return }
    let value = run shape.copy()
    if handle != 0 {
      let shapes = self.shapes.asMutSlice()
      shapes[handle] = move value
    } else {
      let mut slot = self.shapes.length()
      if self.freeShapes.length() != 0 {
        let last = self.freeShapes.length() - 1
        slot = self.freeShapes.get(last)
        self.freeShapes.truncate(last)
        let shapes = self.shapes.asMutSlice()
        shapes[slot] = move value
      } else {
        run self.shapes.append(move value)
      }
      let mut restyled = self.style(id.index).*
      restyled.shape = usize.toU32(slot)
      run self.restyle(id.index, &restyled)
    }
    self.changes.shapeChanged(id.index)
  }
}

// The part of `text` after its first `start` bytes.
fn laid(text: string, start: usize) -> string {
  let length = String.byteLength(text)
  let from = if start < length { start } else { length }
  return String.slice(text, from, length - from)
}

/// The table read as css-layout's source tree, with the UI nodes borrowed text nodes read.
pub struct LayoutView<'a> {
  pub table: &'a LayoutTable,
  pub nodes: &'a [Node],
  pub slots: &'a [u32],
}

impl<'a> LayoutSource for LayoutView<'a> {
  @inlineAlways
  fn nodeCount(self: &Self) -> usize { return self.table.nodeCount() }
  @inlineAlways
  fn exists(self: &Self, node: usize) -> bool { return self.table.exists(node) }
  @inlineAlways
  fn parent(self: &Self, node: usize) -> usize { return self.table.parent(node) }
  @inlineAlways
  fn firstChild(self: &Self, node: usize) -> usize { return if self.table.skipped(node) { NO_NODE } else { self.table.firstChild(node) } }
  @inlineAlways
  fn nextSibling(self: &Self, node: usize) -> usize { return self.table.nextSibling(node) }
  @inlineAlways
  fn styles<'b>(self: &'b Self) -> &'b [Style] { return self.table.styles.asSlice() }
  @inlineAlways
  fn styleIndex(self: &Self, node: usize) -> usize { return self.table.seenStyleIndex(node) }
  @inlineAlways
  fn isText(self: &Self, node: usize) -> bool { return self.table.isText(node) }
  fn text<'b>(self: &'b Self, node: usize) -> Option<string<'b>> { return self.table.textIn(node, self.nodes, self.slots) }
  fn textStart(self: &Self, node: usize) -> usize { return self.table.textStart(node) }
  fn measurement(self: &Self, node: usize) -> Measurement { return self.table.measurement(node) }
  fn measureKey(self: &Self, node: usize) -> usize { return self.table.measureKey(node) }
  fn scrollOffset(self: &Self, node: usize) -> Point { return self.table.scrollOffset(node) }
  fn viewportScrollOffset(self: &Self) -> Point { return self.table.viewportScrollOffset }
  fn stickyDeferred(self: &Self) -> bool { return self.table.stickyDeferred }
  fn exclusionStyles(self: &Self) -> bool { return self.table.exclusionStyles }
  fn grids<'b>(self: &'b Self) -> &'b [GridTemplate] { return self.table.grids.asSlice() }
  fn gridNames<'b>(self: &'b Self) -> &'b [String] { return self.table.gridNames.asSlice() }
  fn shapes<'b>(self: &'b Self) -> &'b [FloatShape] { return self.table.shapes.asSlice() }
  fn changes<'b>(self: &'b Self) -> &'b Changes { return &self.table.changes }
}
