//! Which GPU canvases show in a compositor layer of their own (macOS), and the decisions around
//! it, as pure functions the render thread calls (render_thread.silk) and tests check.
//!
//! A canvas in a layer of its own shows above the window, so a frame of it is the layer's new
//! contents and the window is not drawn for it. It may be one when:
//!
//! - layers are allowed: asked for with `SILK_UI_CANVAS_LAYERS=on` (they are opt-in until
//!   verified on screen), not in check mode, not for a window serving the inspector (both read the
//!   window's own pixels);
//! - its frames are shared images (`CanvasFrame.shared`), not pixels;
//! - the scene draws it once, straight into the window, axis aligned, with a rectangular clip of
//!   one corner radius, and nothing drawn after it covers it (`SurfacePlacement.layerable`);
//! - it is not in a scroll group, whose offsets the compositor moves between frames: such a
//!   canvas stays in the window for now.
import ui_scene.placement { SurfacePlacement }
import ui_scene.scroll { ROOT_GROUP }
import window.canvas_layers as canvas_layers
import window.canvas_layers { CanvasLayerState }
import webgpu.shared_texture { FENCE_SIGNALED }
import silk.num.f32

/// Whether canvas layers may be used at all for a window.
pub fn layersAllowed(check: bool, inspector: bool, switchedOn: bool) -> bool {
  return canvas_layers.supported() && !check && !inspector && switchedOn
}

/// Whether `SILK_UI_CANVAS_LAYERS` turns layers on: `on`, `1` or `yes`.
pub fn switchedOn(value: &[u8]) -> bool {
  return same(value, b"on") || same(value, b"1") || same(value, b"yes")
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// How many sprites of `placements` draw `surface`, and the index of the first (or
/// `placements.length` when none does).
pub fn spritesOf(placements: &[SurfacePlacement], surface: u32) -> u32 {
  let mut count: u32 = 0
  let mut i: usize = 0
  while i < placements.length {
    if placements[i].surface == surface {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

pub fn firstOf(placements: &[SurfacePlacement], surface: u32) -> usize {
  let mut i: usize = 0
  while i < placements.length {
    if placements[i].surface == surface {
      return i
    }
    i = i + 1
  }
  return placements.length
}

/// Whether surface `surface` shows in a layer of its own this frame (see the module's notes).
pub fn wantsLayer(placements: &[SurfacePlacement], surface: u32, shared: bool, allowed: bool) -> bool {
  if !allowed || !shared || spritesOf(placements, surface) != 1 {
    return false
  }
  let p = &placements[firstOf(placements, surface)]
  return p.layerable() && p.group == ROOT_GROUP
}

/// The layer's place for `placement`, at the window layer's own scale.
pub fn layerStateOf(placement: &SurfacePlacement) -> CanvasLayerState {
  let b = placement.bounds
  let c = placement.clip
  let mut state = canvas_layers.state(
    f32.toF64(b.xMin),
    f32.toF64(b.yMin),
    f32.toF64(b.xMax - b.xMin),
    f32.toF64(b.yMax - b.yMin),
    f32.toF64(c.xMin),
    f32.toF64(c.yMin),
    f32.toF64(c.xMax - c.xMin),
    f32.toF64(c.yMax - c.yMin),
    f32.toF64(if placement.cornerRadius > 0.0 { placement.cornerRadius } else { 0.0 }),
    0.0,
  )
  state.opacity = f32.toF64(placement.opacity)
  return state
}

/// Whether a picture whose fences polled `states` (`SharedFence.poll`) is finished: every fence
/// signaled. A fence that cannot be asked is not taken as finished: Core Animation reads the
/// surface as it is, so the picture waits.
pub fn pictureReady(states: &[i32]) -> bool {
  let mut i: usize = 0
  while i < states.length {
    if states[i] != FENCE_SIGNALED {
      return false
    }
    i = i + 1
  }
  return true
}

/// What the render thread does with a canvas's path when a new frame job comes: keep it, move it
/// into a layer, or move it back into the window.
pub const PATH_KEEP: u32 = 0

pub const PATH_TO_LAYER: u32 = 1

pub const PATH_TO_WINDOW: u32 = 2

pub fn pathChange(layered: bool, wanted: bool) -> u32 {
  if wanted && !layered {
    return PATH_TO_LAYER
  }
  if !wanted && layered {
    return PATH_TO_WINDOW
  }
  return PATH_KEEP
}

/// Whether a wake for canvas frames alone draws the window: only when a canvas drawn in the window
/// had a new frame (`windowCanvasChanged`); frames of layered canvases change their layers only.
pub fn canvasWakeDrawsWindow(windowCanvasChanged: bool) -> bool {
  return windowCanvasChanged
}

/// How long the render thread waits before looking at waiting layers again, in nanoseconds: a
/// millisecond while a picture waits for its fences (it shows as soon as they signal), 8 ms while
/// only pictures the layers replaced wait for the window server (it lets go of them at its next
/// composite, at most a refresh away), and 0 (no polling) when nothing waits.
pub fn layerPollDelay(pictureWaits: bool, replacedInUse: bool) -> u64 {
  if pictureWaits {
    return 1000000
  }
  if replacedInUse {
    return 8000000
  }
  return 0
}
