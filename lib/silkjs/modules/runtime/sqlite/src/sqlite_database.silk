//! `node:sqlite` and `localStorage` over SQLite: the runtime's real `Database` capability.
//!
//! A program that provides `SqliteDatabase` depends on this package, and so compiles SQLite; a
//! program that provides `EmptyDatabase` does not.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjsruntime.ext.diagnostics_fatal { RuntimeHeap }
import silkjsruntime.libs.core.capabilities { Database, Composition }
import silkjsruntime.libs.core.host { Services }
import ext.sqlite_native

/// SQLite behind `node:sqlite` and `localStorage`.
pub struct SqliteDatabase {
  state: ?*mut sqlite_native.State,
}
impl Copy for SqliteDatabase {}

impl SqliteDatabase {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> SqliteDatabase { return SqliteDatabase { state: Pointer.null<sqlite_native.State>() } }
}

impl Database for SqliteDatabase {
  static fn present() -> bool { return true }
  fn forWorker(self: &Self) -> Self { return SqliteDatabase.make() }
  effect fn open(self: &mut Self, allocator: *mut RuntimeHeap) -> () ! OutOfMemoryError {
    // The C entry points SQLite calls back are emitted only when something takes them.
    sqlite_native.keepExports()
    self.state = run sqlite_native.open(allocator)
  }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if Pointer.isNull<sqlite_native.State>(self.state) { Intrinsic.trap("SQLite provider is not initialized") }
    let state = unsafe Intrinsic.pointerRequalify<?*mut sqlite_native.State, *mut sqlite_native.State>(self.state)
    return run unsafe sqlite_native.dispatch(&mut engine, context, state, argc, argv)
  }
  unsafe fn freeBuffer(self: &Self, data: ?*mut u8) -> () { unsafe sqlite_native.freeBuffer(data) }
  unsafe fn openHandles(self: &Self) -> usize {
    return match Pointer.nonNullMut<sqlite_native.State>(self.state) {
      Option<*mut sqlite_native.State>.Some { value } => unsafe sqlite_native.openHandles(value)
      Option<*mut sqlite_native.State>.None => 0
    }
  }
  unsafe fn close<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> () {
    match Pointer.nonNullMut<sqlite_native.State>(self.state) {
      Option<*mut sqlite_native.State>.Some { value } => {
        unsafe sqlite_native.close(&mut engine, context, value)
        self.state = Pointer.null<sqlite_native.State>()
      }
      Option<*mut sqlite_native.State>.None => ()
    }
  }
}
