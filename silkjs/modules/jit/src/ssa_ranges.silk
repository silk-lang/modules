//! What an i32 value can be, read off its definition: the range of a constant, of a mask,
//! of a shift by a constant and of sums, differences and products of those. The backend
//! drops an overflow test or a test for -0 where the range rules it out, and the register
//! allocator asks the same to know where a multiplication can run in place.
import silk.core.ownership { Copy }
import silk.num.i32
import silk.num.i64
import silk.num.u64
import ssa { Function, Inst, Op, NONE }

const I32_MIN_64: i64 = -2147483648
const I32_MAX_64: i64 = 2147483647

pub struct I32Range { lo: i64, hi: i64 }
impl Copy for I32Range {}

fn clampI32Range(lo: i64, hi: i64) -> I32Range {
  let cLo = if lo < I32_MIN_64 { I32_MIN_64 } else { lo }
  let cHi = if hi > I32_MAX_64 { I32_MAX_64 } else { hi }
  if cLo > cHi { return I32Range { lo: I32_MIN_64, hi: I32_MAX_64 } }
  return I32Range { lo: cLo, hi: cHi }
}

/// Conservative signed 64-bit interval `[lo, hi]` for SSA `i32` value `v` (bounded recursion
/// depth 6). Every surviving `Op.Add`/`Op.Sub`/`Op.Mul` value already exited on i32 overflow.
pub fn i32Range(function: &Function, v: u32, depth: u32) -> I32Range {
  if v == NONE || depth >= 6 { return I32Range { lo: I32_MIN_64, hi: I32_MAX_64 } }
  let def = function.value(v).def
  if def == NONE { return I32Range { lo: I32_MIN_64, hi: I32_MAX_64 } }
  let inst = function.inst(def)
  if inst.op == Op.ConstI32 {
    let k = i32.toI64(inst.k)
    return I32Range { lo: k, hi: k }
  }
  if inst.op == Op.BitAnd {
    let ra = i32Range(&function, inst.a, depth + 1)
    let rb = i32Range(&function, inst.b, depth + 1)
    if ra.lo >= 0 && rb.lo >= 0 { return I32Range { lo: 0, hi: if ra.hi < rb.hi { ra.hi } else { rb.hi } } }
    if ra.lo >= 0 { return I32Range { lo: 0, hi: ra.hi } }
    if rb.lo >= 0 { return I32Range { lo: 0, hi: rb.hi } }
    return I32Range { lo: I32_MIN_64, hi: I32_MAX_64 }
  }
  if inst.op == Op.BitOr || inst.op == Op.BitXor {
    let ra = i32Range(&function, inst.a, depth + 1)
    let rb = i32Range(&function, inst.b, depth + 1)
    if ra.lo >= 0 && rb.lo >= 0 { return I32Range { lo: 0, hi: I32_MAX_64 } }
    return I32Range { lo: I32_MIN_64, hi: I32_MAX_64 }
  }
  if inst.op == Op.Sar {
    let shiftDef = function.value(inst.b).def
    if shiftDef != NONE && function.inst(shiftDef).op == Op.ConstI32 {
      let s = i32.toI64(function.inst(shiftDef).k & 31)
      let ra = i32Range(&function, inst.a, depth + 1)
      return I32Range { lo: i64.shiftRight(ra.lo, s), hi: i64.shiftRight(ra.hi, s) }
    }
    return I32Range { lo: I32_MIN_64, hi: I32_MAX_64 }
  }
  if inst.op == Op.Shr {
    let shiftDef = function.value(inst.b).def
    if shiftDef != NONE && function.inst(shiftDef).op == Op.ConstI32 {
      let s = function.inst(shiftDef).k & 31
      if s != 0 {
        let hi = u64.wrappingToI64(u64.shiftRight(4294967295, i32.wrappingToU64(s)))
        return I32Range { lo: 0, hi: hi }
      }
    }
    return I32Range { lo: I32_MIN_64, hi: I32_MAX_64 }
  }
  if inst.op == Op.Shl {
    let shiftDef = function.value(inst.b).def
    if shiftDef != NONE && function.inst(shiftDef).op == Op.ConstI32 {
      let s = function.inst(shiftDef).k & 31
      let ra = i32Range(&function, inst.a, depth + 1)
      if ra.lo >= 0 && s < 31 {
        let hi = i64.shiftLeft(ra.hi, i32.toI64(s))
        if hi <= I32_MAX_64 { return I32Range { lo: i64.shiftLeft(ra.lo, i32.toI64(s)), hi: hi } }
      }
    }
    return I32Range { lo: I32_MIN_64, hi: I32_MAX_64 }
  }
  if inst.op == Op.Add {
    let ra = i32Range(&function, inst.a, depth + 1)
    let rb = i32Range(&function, inst.b, depth + 1)
    return clampI32Range(ra.lo + rb.lo, ra.hi + rb.hi)
  }
  if inst.op == Op.Sub {
    let ra = i32Range(&function, inst.a, depth + 1)
    let rb = i32Range(&function, inst.b, depth + 1)
    return clampI32Range(ra.lo - rb.hi, ra.hi - rb.lo)
  }
  if inst.op == Op.Mul {
    let ra = i32Range(&function, inst.a, depth + 1)
    let rb = i32Range(&function, inst.b, depth + 1)
    let p0 = ra.lo * rb.lo
    let p1 = ra.lo * rb.hi
    let p2 = ra.hi * rb.lo
    let p3 = ra.hi * rb.hi
    let mut lo = p0
    if p1 < lo { lo = p1 }
    if p2 < lo { lo = p2 }
    if p3 < lo { lo = p3 }
    let mut hi = p0
    if p1 > hi { hi = p1 }
    if p2 > hi { hi = p2 }
    if p3 > hi { hi = p3 }
    return clampI32Range(lo, hi)
  }
  return I32Range { lo: I32_MIN_64, hi: I32_MAX_64 }
}

pub fn addSubRangeSafe(function: &Function, inst: Inst) -> bool {
  let ra = i32Range(&function, inst.a, 0)
  let rb = i32Range(&function, inst.b, 0)
  if inst.op == Op.Add {
    let lo = ra.lo + rb.lo
    let hi = ra.hi + rb.hi
    return lo >= I32_MIN_64 && hi <= I32_MAX_64
  }
  if inst.op == Op.Sub {
    let lo = ra.lo - rb.hi
    let hi = ra.hi - rb.lo
    return lo >= I32_MIN_64 && hi <= I32_MAX_64
  }
  return false
}

pub fn mulRangeSafe(function: &Function, a: u32, b: u32) -> bool {
  let ra = i32Range(&function, a, 0)
  let rb = i32Range(&function, b, 0)
  let p0 = ra.lo * rb.lo
  let p1 = ra.lo * rb.hi
  let p2 = ra.hi * rb.lo
  let p3 = ra.hi * rb.hi
  let mut lo = p0
  if p1 < lo { lo = p1 }
  if p2 < lo { lo = p2 }
  if p3 < lo { lo = p3 }
  let mut hi = p0
  if p1 > hi { hi = p1 }
  if p2 > hi { hi = p2 }
  if p3 > hi { hi = p3 }
  return lo >= I32_MIN_64 && hi <= I32_MAX_64
}

pub fn mulNoNegZero(function: &Function, a: u32, b: u32) -> bool {
  let ra = i32Range(&function, a, 0)
  let rb = i32Range(&function, b, 0)
  return (ra.lo >= 0 && rb.lo >= 0) || ra.lo > 0 || rb.lo > 0
}
