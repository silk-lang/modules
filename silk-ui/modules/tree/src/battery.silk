//! The battery as the Battery Status API reports it: whether the system is on external power,
//! the charge level from 0 to 1, and the seconds until full and until empty. Sources: IOKit
//! power sources on macOS (`native/battery.c`), `/sys/class/power_supply` on Linux and
//! `GetSystemPowerStatus` on Windows. A read makes a few system calls and allocates nothing.
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.f64

/// One reading. A time the system cannot estimate, or one that does not apply (the time to
/// full while discharging), is infinite, as in the web API.
pub struct BatteryState {
  pub charging: bool,
  pub level: f64,
  pub chargingTime: f64,
  pub dischargingTime: f64,
}

impl Copy for BatteryState {}

impl BatteryState {
  /// What the web API reports with no battery to read: a full battery on external power.
  pub fn full() -> BatteryState {
    return BatteryState { charging: true, level: 1.0, chargingTime: 0.0, dischargingTime: f64.INFINITY }
  }

  pub fn equals(self: &Self, other: &BatteryState) -> bool {
    return self.charging == other.charging && self.level == other.level && self.chargingTime == other.chargingTime
      && self.dischargingTime == other.dischargingTime
  }
}

/// The level clamped to 0..1, and the times the web API implies for it: a full battery on
/// power is charged now, and no time to full applies while discharging.
fn settled(charging: bool, level: f64, chargingTime: f64, dischargingTime: f64) -> BatteryState {
  let clamped = if level < 0.0 { 0.0 } else if level > 1.0 { 1.0 } else { level }
  let mut toFull = if charging { chargingTime } else { f64.INFINITY }
  if charging && clamped >= 1.0 { toFull = 0.0 }
  let toEmpty = if charging { f64.INFINITY } else { dischargingTime }
  return BatteryState { charging: charging, level: clamped, chargingTime: toFull, dischargingTime: toEmpty }
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  import silk.mem.pointer { Pointer }

  // Fills charging (0 or 1), level, seconds to full and seconds to empty (-1 when unknown),
  // and returns 1 when the machine has an internal battery.
  unsafe extern "C" fn silk_ui_battery(out: ?[*]mut f64) -> i32

  /// The internal battery, or none on a machine without one.
  pub fn read() -> Option<BatteryState> {
    let mut values: [f64; 4] = [0.0; 4]
    if unsafe silk_ui_battery(Pointer.fromMutSlice<f64>(&mut values)) != 1 { return Option<BatteryState>.None }
    return Option<BatteryState>.some(settled(values[0] != 0.0, values[1], known(values[2]), known(values[3])))
  }

  fn known(seconds: f64) -> f64 { return if seconds < 0.0 { f64.INFINITY } else { seconds } }
} else {
static if Intrinsic.targetOperatingSystem() == "linux" {
  import process_memory
  import silk.mem.pointer { Pointer }
  import silk.collections.slice { Slice }
  import silk.num.u8
  import silk.num.u32
  import silk.num.u64

  unsafe extern "C" fn opendir(path: ?[*]const u8) -> ?*mut u8
  unsafe extern "C" fn readdir(directory: ?*mut u8) -> ?[*]const u8
  unsafe extern "C" fn closedir(directory: ?*mut u8) -> i32

  // `struct dirent` on glibc and musl: inode, offset, record length, type, then the name.
  const NAME_OFFSET: usize = 19

  /// Whether the file `path` starts with `word`.
  fn startsWith(path: &[u8], word: &[u8]) -> bool {
    let mut text: [u8; 64] = [0; 64]
    let length = process_memory.readStart(path, &mut text)
    if length < word.length { return false }
    let mut at: usize = 0
    while at < word.length {
      if text[at] != word[at] { return false }
      at = at + 1
    }
    return true
  }

  /// The decimal number the file `path` starts with, or none.
  fn number(path: &[u8]) -> Option<u64> {
    let mut text: [u8; 32] = [0; 32]
    let length = process_memory.readStart(path, &mut text)
    let mut value: u64 = 0
    let mut at: usize = 0
    while at < length && text[at] >= 48 && text[at] <= 57 {
      value = value * 10 + u8.toU64(text[at] - 48)
      at = at + 1
    }
    return if at == 0 { Option<u64>.None } else { Option<u64>.some(value) }
  }

  /// Sums of every system battery's readings (peripherals such as mice say `scope` Device).
  struct Totals {
    batteries: u32,
    charging: bool,
    discharging: bool,
    now: u64,
    full: u64,
    rate: u64,
    percent: u64,
  }

  fn add(totals: &mut Totals, name: &[u8]) -> () {
    // `/sys/class/power_supply/<name>/<file>` with its zero byte.
    let mut path: [u8; 160] = [0; 160]
    let base = b"/sys/class/power_supply/"
    let mut length: usize = 0
    while length < base.length {
      path[length] = base[length]
      length = length + 1
    }
    let mut at: usize = 0
    while at < name.length && length < 120 {
      path[length] = name[at]
      length = length + 1
      at = at + 1
    }
    path[length] = 47
    length = length + 1
    if !startsWith(file(&mut path, length, b"type"), b"Battery") { return () }
    if startsWith(file(&mut path, length, b"scope"), b"Device") { return () }
    totals.batteries = totals.batteries + 1
    let status = file(&mut path, length, b"status")
    if startsWith(status, b"Discharging") { totals.discharging = true }
    else if startsWith(status, b"Charging") || startsWith(status, b"Full") || startsWith(status, b"Not charging") { totals.charging = true }
    // Energy in microwatt-hours and power in microwatts, or charge in microampere-hours and
    // current in microamperes: either ratio gives hours.
    let mut now = number(file(&mut path, length, b"energy_now"))
    let mut full = number(file(&mut path, length, b"energy_full"))
    let mut rate = number(file(&mut path, length, b"power_now"))
    if now.isNone() || full.isNone() {
      now = number(file(&mut path, length, b"charge_now"))
      full = number(file(&mut path, length, b"charge_full"))
      rate = number(file(&mut path, length, b"current_now"))
    }
    if let Option<u64>.Some { value } = now { totals.now = totals.now + value }
    if let Option<u64>.Some { value } = full { totals.full = totals.full + value }
    if let Option<u64>.Some { value } = rate { totals.rate = totals.rate + value }
    if let Option<u64>.Some { value } = number(file(&mut path, length, b"capacity")) { totals.percent = totals.percent + value }
  }

  /// `path` up to `length` with `leaf` and a zero byte after it.
  fn file<'a>(path: &'a mut [u8; 160], length: usize, leaf: &[u8]) -> &'a [u8] {
    let mut at: usize = 0
    while at < leaf.length {
      path[length + at] = leaf[at]
      at = at + 1
    }
    path[length + at] = 0
    return Slice.view<u8>(&path.*, 0, length + at + 1)
  }

  /// The system's batteries taken together, or none when it has none.
  pub fn read() -> Option<BatteryState> {
    let directory = unsafe opendir(Pointer.fromSlice<u8>(b"/sys/class/power_supply\0"))
    if Pointer.isNull<u8>(directory) { return Option<BatteryState>.None }
    let mut totals = Totals { batteries: 0, charging: false, discharging: false, now: 0, full: 0, rate: 0, percent: 0 }
    while true {
      let entry = unsafe readdir(directory)
      if Pointer.isNullMany<u8>(entry) { break }
      let mut name: [u8; 64] = [0; 64]
      let mut length: usize = 0
      unsafe {
        let start = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(entry)
        while length < 63 && Pointer.read<u8>(Pointer.at<u8>(start, NAME_OFFSET + length)) != 0 {
          name[length] = Pointer.read<u8>(Pointer.at<u8>(start, NAME_OFFSET + length))
          length = length + 1
        }
      }
      if length > 0 && name[0] != 46 { add(&mut totals, Slice.view<u8>(&name, 0, length)) }
    }
    let _closed = unsafe closedir(directory)
    if totals.batteries == 0 { return Option<BatteryState>.None }
    let charging = totals.charging || !totals.discharging
    let level = if totals.full > 0 { u64.toF64(totals.now) / u64.toF64(totals.full) } else { u64.toF64(totals.percent) / (100.0 * u32.toF64(totals.batteries)) }
    let mut toFull = f64.INFINITY
    let mut toEmpty = f64.INFINITY
    if totals.rate > 0 && totals.full > 0 {
      let rate = u64.toF64(totals.rate)
      if charging && totals.full > totals.now { toFull = u64.toF64(totals.full - totals.now) / rate * 3600.0 }
      if !charging { toEmpty = u64.toF64(totals.now) / rate * 3600.0 }
    }
    return Option<BatteryState>.some(settled(charging, level, toFull, toEmpty))
  }
} else {
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.mem.pointer { Pointer }
  import silk.num.u8
  import silk.num.u32

  extern "C" struct PowerStatus {
    acLine: u8,
    flags: u8,
    percent: u8,
    saver: u8,
    lifeTime: u32,
    fullLifeTime: u32,
  }

  unsafe extern "C" fn GetSystemPowerStatus(status: *mut PowerStatus) -> i32

  /// The system battery, or none on a machine without one.
  pub fn read() -> Option<BatteryState> {
    let mut status = PowerStatus { acLine: 0, flags: 0, percent: 0, saver: 0, lifeTime: 0, fullLifeTime: 0 }
    if unsafe GetSystemPowerStatus(Pointer.fromMutRef<PowerStatus>(&mut status)) == 0 { return Option<BatteryState>.None }
    // Flag 128 is "no system battery" and 255 "unknown"; 255 is also an unknown percent.
    if status.flags == 128 || status.flags == 255 || status.percent == 255 { return Option<BatteryState>.None }
    let charging = status.acLine == 1
    let toEmpty = if status.lifeTime == u32.MAX { f64.INFINITY } else { u32.toF64(status.lifeTime) }
    return Option<BatteryState>.some(settled(charging, u8.toF64(status.percent) / 100.0, f64.INFINITY, toEmpty))
  }
} else {
  /// No battery to read here.
  pub fn read() -> Option<BatteryState> { return Option<BatteryState>.None }
}
}
}
