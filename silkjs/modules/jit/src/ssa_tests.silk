e2: pc 13 locals [int v5, int v6] stack [int v5, dup v7 (arg 0)]
e3: pc 16 locals [int v5, int v6] stack [int v5, int v10]
e4: pc 23 locals [int v5, int v6] stack [int v11, int v13]
e5: pc 30 locals [int v14, int v6] stack []
e6: pc 9 locals [int v14, int v16] stack []
"""
test effect fn repeatedElementReadOnce() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectPasses(REPEATED_SOURCE, ssa_opt.PASS_ALL, REPEATED_READ, "a[i] read twice with no store between is read once, and unboxed once")
}

const OWNED_COUNTER_SOURCE: &[u8] = b"function D(){this.array=[1,2,3];this.t=3} D.prototype.shift=function(n,r){var a=this.array;var b=r.array;for(var i=n;i<this.t;++i)b[i-n]=a[i];r.t=Math.max(this.t-n,0)}; var x=new D(); x.shift(1,new D()); D.prototype.shift"
test effect fn ownedCounterReleasedOnEntry() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  // The counter copies an argument into a local the code owns; its unbox on the entry edge
  // passes a box in its place, and the front block releases the local's value.
  let got = run ssaOf(OWNED_COUNTER_SOURCE, false, ssa_opt.PASS_ALL, NONE)
  let text = got.asSlice()
  let refused = startsWith(text, b"verify:") || startsWith(text, b"refused:")
  if refused { StderrWriter.print("{}\n", &.(unsafe String.fromUtf8Unchecked(text))) }
  run Testing.expect(!refused, "a loop counter copied from an argument verifies after its entry unbox")
}
