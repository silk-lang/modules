//! libuv 1.51's file-system requests, thread-pool work, cancellation, name resolution and random
//! requests, exported as C symbols with libuv's names, signatures and record layouts, so that a
//! Node-API addon compiled against libuv's uv.h links against the runtime as it linked against
//! Node: every `uv_fs_*` function except the fs event and fs poll handles, `uv_fs_req_cleanup`,
//! `uv_fs_scandir_next` and the `uv_fs_get_*` accessors, `uv_queue_work`, `uv_cancel`,
//! `uv_getaddrinfo`, `uv_freeaddrinfo`, `uv_getnameinfo` and `uv_random`.
//!
//! Each export follows the C function of the same name in libuv (src/unix/fs.c, src/threadpool.c,
//! src/uv-common.c, src/unix/getaddrinfo.c, src/unix/getnameinfo.c, src/idna.c, src/random.c) on
//! GNU/Linux (x86_64, aarch64) and Darwin (arm64), built without assertions as Node builds it. A
//! request with a NULL callback runs on the calling thread and returns its result; with a
//! callback it counts as an active request of the loop (`uvl.requestStarted`), runs on the loop's
//! thread pool (`uvl.workSubmit`, whose `Work` record sits where libuv keeps `work_req`) and calls
//! back on the loop's thread. File-system requests are fast I/O work, name resolution slow I/O
//! work, `uv_queue_work` and `uv_random` CPU work, as in libuv.
//!
//! The records are the caller's, with the sizes of libuv's headers: `uv_fs_t` (440 bytes),
//! `uv_work_t` (128), `uv_getaddrinfo_t` (160), `uv_getnameinfo_t` (1320), `uv_random_t` (144) and
//! `uv_dir_t` (56). The public fields an addon reads (`type`, `fs_type`, `loop`, `result`, `ptr`,
//! `path`, `statbuf`, `addrinfo`, `host`, `service`...) are at libuv's offsets, and so are the
//! private ones: this module uses them as libuv does.
//!
//! The `uv_loop_t*` an addon passes is the loop memory of `ext.uv_loop` (the loop facade decides
//! what an addon's `uv_loop_t` is; `loopMemory` is the one place that maps it).
//!
//! Memory that libuv takes from uv__malloc (copied paths, the bufs copy, readlink, realpath, statfs
//! and readdir results, opendir's uv_dir_t, getaddrinfo's copy of its arguments) comes from
//! `ext.uv_os`'s uvMalloc, which follows uv_replace_allocator; scandir's entries and realpath's
//! buffer are the C library's and go back with free(), as in libuv.
//!
//! What differs from libuv on purpose:
//! - io_uring is never used. libuv 1.51 uses it for some asynchronous requests only when the
//!   UV_USE_IO_URING environment variable asks for it; otherwise it takes the thread pool, as here.
//! - The random bytes are `ext.uv_api_sys`'s randomFill (libuv's uv__random).
//! - uv_fs_mkstemp and uv_fs_open never take the loop's cloexec lock: the runtime's loop has none
//!   (its uv_spawn does not need one), and both use O_CLOEXEC directly (mkostemp).
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.num.isize
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import ext.uv_loop as uvl
import ext.uv_loop { Work }
import silkjsruntime.ext.uv_fs { UvStat, UvTimespec }
import ext.uv_os as os
import ext.uv_api_sys as sys

// ---- Records ----------------------------------------------------------------------------------
type FsCallback = ?extern "C" fn(*mut u8) -> ()
type WorkCallback = ?extern "C" fn(*mut u8) -> ()
type AfterWorkCallback = ?extern "C" fn(*mut u8, i32) -> ()
type RandomCallback = ?extern "C" fn(*mut u8, i32, ?*mut u8, usize) -> ()
type AddrinfoCallback = ?extern "C" fn(*mut u8, i32, ?*mut u8) -> ()
type NameinfoCallback = ?extern "C" fn(*mut u8, i32, ?*const u8, ?*const u8) -> ()

/// libuv's uv_buf_t on Unix: a struct iovec.
extern "C" struct Buf { base: ?*mut u8, len: usize }
impl Copy for Buf {}
/// libuv's uv_dirent_t.
extern "C" struct Dirent { name: ?*const u8, kind: i32, padding: i32 }
impl Copy for Dirent {}
/// libuv's uv_dir_t: the caller's entries, their count, four reserved words and the DIR stream.
extern "C" struct Dir { dirents: ?*mut Dirent, nentries: usize, reserved: [usize; 4], dir: ?*mut u8 }
extern "C" struct Timespec { seconds: i64, nanoseconds: i64 }
impl Copy for Timespec {}

/// libuv's uv_fs_t (440 bytes): the request head (data, type, six reserved words), the public
/// fields, then UV_FS_PRIVATE_FIELDS of uv/unix.h. `mode` is a mode_t (16 bits on Darwin, where
/// the next two bytes are padding in libuv's record).
extern "C" struct FsReq {
  data: ?*mut u8, kind: i32, padding: i32, reserved: [usize; 6],
  fsType: i32, padding2: i32, loop: ?*mut u8, cb: FsCallback, result: isize, ptr: ?*mut u8, path: ?*const u8, statbuf: UvStat,
  newPath: ?*const u8, file: i32, flags: i32, mode: u32, nbufs: u32, bufs: ?*mut Buf, off: i64, uid: u32, gid: u32,
  atime: f64, mtime: f64, work: Work, bufsml: [Buf; 4]
}
/// libuv's uv_work_t (128 bytes).
extern "C" struct WorkReq {
  data: ?*mut u8, kind: i32, padding: i32, reserved: [usize; 6],
  loop: ?*mut u8, workCb: WorkCallback, afterWorkCb: AfterWorkCallback, work: Work
}
/// libuv's uv_random_t (144 bytes).
extern "C" struct RandomReq {
  data: ?*mut u8, kind: i32, padding: i32, reserved: [usize; 6],
  loop: ?*mut u8, status: i32, padding2: i32, buf: ?*mut u8, buflen: usize, cb: RandomCallback, work: Work
}
/// libuv's uv_getaddrinfo_t (160 bytes).
extern "C" struct AddrinfoReq {
  data: ?*mut u8, kind: i32, padding: i32, reserved: [usize; 6],
  loop: ?*mut u8, work: Work, cb: AddrinfoCallback, hints: ?*mut u8, hostname: ?*mut u8, serviceText: ?*mut u8, addrinfo: ?*mut u8,
  retcode: i32, padding2: i32
}
/// libuv's uv_getnameinfo_t (1320 bytes): a sockaddr_storage, the flags, NI_MAXHOST and NI_MAXSERV
/// bytes of results, and the status.
extern "C" struct NameinfoReq {
  data: ?*mut u8, kind: i32, padding: i32, reserved: [usize; 6],
  loop: ?*mut u8, work: Work, cb: NameinfoCallback, storage: [u64; 16], flags: i32,
  host: [u8; 1025], serviceText: [u8; 32], retcode: i32, padding2: i32
}
// Where each record keeps its Work (libuv's work_req), for container_of.
const FS_WORK: usize = 336
const WORK_WORK: usize = 88
const RANDOM_WORK: usize = 104
const ADDRINFO_WORK: usize = 72
const NAMEINFO_WORK: usize = 72

// libuv's uv_req_type and uv_fs_type values.
const UV_FS: i32 = 6
const UV_WORK: i32 = 7
const UV_GETADDRINFO: i32 = 8
const UV_GETNAMEINFO: i32 = 9
const UV_RANDOM: i32 = 10
const FS_OPEN: i32 = 1
const FS_CLOSE: i32 = 2
const FS_READ: i32 = 3
const FS_WRITE: i32 = 4
const FS_SENDFILE: i32 = 5
const FS_STAT: i32 = 6
const FS_LSTAT: i32 = 7
const FS_FSTAT: i32 = 8
