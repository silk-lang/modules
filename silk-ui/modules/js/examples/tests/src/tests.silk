//! The bundled examples on the embedded engine, without a window. Build them first
//! (`npm ci && npm run build` in modules/js), then run from the repository root:
//! `silk test --manifest-path modules/js/examples/tests/silk.toml --root src/tests.silk`.
import ui_js.lib { JsHost, JsError, runtimeStylesheets }
import ui_tree.lib { Tree, TreeError, ProtocolError, Viewport, Input, Modifiers }
import ui_tree.inspect { findAll, info, NodeInfo }
import ui_fixtures.fixtures as fixtures
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_libc_platform as platform
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.io.writer_native { StderrWriter }
import silk.io.writer { Writer }
import silk.text.string { String }

/// The size the demo host opens its window at: the counter is on screen without scrolling.
fn viewport() -> Viewport {
  return Viewport { width: 1040.0, height: 720.0, scale: 1.0 }
}

/// Whether a node has `value` as its test id, label or text.
effect fn shows(tree: &Tree<'_>, value: string) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(tree.engine(), value, &mut found)
  return found.length() > 0
}

/// Presses and releases the primary button in the middle of the node named `value`.
effect fn click(host: &mut JsHost<'_>, tree: &mut Tree<'_>, value: string<'static>) -> ()
  ! ProtocolError | OutOfMemoryError | JsError | AssertionError<'static>
  ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(tree.engine(), value, &mut found)
  run Testing.expect(found.length() > 0, value)
  let mut x: f32 = 0.0
  let mut y: f32 = 0.0
  if let Option<NodeInfo>.Some { value: node } = run info(tree.engine(), found.get(0)) {
    x = (node.bounds.xMin + node.bounds.xMax) * 0.5
    y = (node.bounds.yMin + node.bounds.yMax) * 0.5
  }
  run host.input(&mut tree, Input.press(x, y))
  run host.input(&mut tree, Input.release(x, y))
}

/// React 19 with hooks: the first render is there when `render` returns, a click commits a
/// state change before the mutations apply, and the page's motion runs on the host's
/// animation frames, on nodes it reached by ref.
effect fn reactCounter(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let bundle = run platform.readFile(b"modules/js/examples/react-counter/dist/app.js")
  run host.module(bundle.asSlice(), b"app.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(run shows(&tree.*, "CLICK ANYWHERE"), "the first render shows the page")
  run Testing.expect(run shows(&tree.*, "0"), "the count starts at zero")

  // The effect that starts the motion runs on a timer of React's scheduler.
  run host.tick(0.5, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.5)

  run click(&mut host, &mut tree, "counter")
  drop run tree.frame(viewport(), 0.6)
  run Testing.expect(run shows(&tree.*, "CLICKED"), "the click changed the words")
  run Testing.expect(run shows(&tree.*, "1"), "the click counted")

  // Frames after the click: its rings and sparks move, then go.
  run host.tick(0.7, true)
  run host.tick(1.5, true)
  run host.tick(3.0, true)
  run host.tick(3.1, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 3.1)

  run click(&mut host, &mut tree, "theme")
  drop run tree.frame(viewport(), 3.2)
  run Testing.expect(run shows(&tree.*, "DARK"), "the switch changed the theme")
  run Testing.expect(run shows(&tree.*, "CLICKED"), "and a click on it did not count")
}

/// Foldkit unmodified, on the document of `@silkui/foldkit`: it renders in an animation
/// frame, a click goes through `update`, and the Commands it returns reach the page's motion.
effect fn foldkitCounter(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let bundle = run platform.readFile(b"modules/js/examples/foldkit-counter/dist/app.js")
  run host.module(bundle.asSlice(), b"app.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(run shows(&tree.*, "CLICK ANYWHERE"), "the first render is there for the first frame")
  run Testing.expect(run shows(&tree.*, "0"), "the count starts at zero")

  run host.tick(0.5, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.5)

  run click(&mut host, &mut tree, "counter")
  run host.tick(0.6, true)
  run host.tick(0.7, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.7)
  run Testing.expect(run shows(&tree.*, "CLICKED"), "the click changed the words")
  run Testing.expect(run shows(&tree.*, "1"), "the click counted")

  run host.tick(1.5, true)
  run host.tick(3.0, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 3.0)

  run click(&mut host, &mut tree, "theme")
  run host.tick(3.1, true)
  run host.tick(3.2, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 3.2)
  run Testing.expect(run shows(&tree.*, "DARK"), "the switch changed the theme")
  run Testing.expect(run shows(&tree.*, "CLICKED"), "and a click on it did not count")
}

/// React on `@silkui/core/globals`, written as for a page: it renders into `document.body`,
/// a keydown that reaches the root goes on to a `document` listener, and the count goes to
/// `localStorage`, the hash and the root's classes.
effect fn browserGlobals(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let bundle = run platform.readFile(b"modules/js/examples/browser-globals/dist/app.js")
  host.attach(tree.engineMut())
  run host.module(bundle.asSlice(), b"app.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(run shows(&tree.*, "keys 0"), "the first render is in the body")
  run Testing.expect(run shows(&tree.*, "root even"), "the root has no class yet")
  run Testing.expect(run shows(&tree.*, "body is an element"), "the body is an HTMLElement")

  run host.input(&mut tree, run Input.key("a"))
  // The key's render, then its effect's (the hash and the root's class) on React's scheduler.
  run host.tick(0.1, true)
  run host.tick(0.2, true)
  run host.tick(0.3, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.3)
  run Testing.expect(run shows(&tree.*, "keys 1"), "a document keydown listener heard the key")
  run Testing.expect(run shows(&tree.*, "hash #/keys/1"), "history.pushState moved the hash")
  run Testing.expect(run shows(&tree.*, "root odd"), "documentElement.classList changed")

  run host.evaluate(b"{ const failed = platformChecks(); if (failed !== '') throw new Error('platform checks failed: ' + failed); }", b"test")
  // A page taller than the window scrolls on the wheel once `<html>` scrolls, as @silkui/react's
  // html.css has it (a browser's viewport does the same); this bundle loads no sheet.
  run host.evaluate(b"document.documentElement.style.overflow = 'auto'", b"test")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.35)
  run host.input(&mut tree, Input.Wheel { x: 100.0, y: 100.0, deltaX: 0.0, deltaY: 300.0, modifiers: Modifiers.none() })
  run host.tick(0.4, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.4)
  run host.evaluate(b"if (!(document.documentElement.scrollTop > 0)) throw new Error('the page did not scroll')", b"test")
}

/// Checks `script` (an expression) on the page: it throws when false.
effect fn expectJs(host: &mut JsHost<'_>, script: string<'static>) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
  let mut source = List<u8>.make()
  run source.appendSlice(b"{ const got = ")
  run source.appendSlice(String.utf8Bytes(script))
  run source.appendSlice(b"; if (got !== true) throw new Error('not true: ' + paragraphs() + ' from ' + editor.state.selection.from + ' sel ' + JSON.stringify([getSelection().anchorNode?.nodeName, getSelection().anchorOffset])); }")
  run host.evaluate(source.asSlice(), b"test")
}

/// ProseMirror on a contenteditable div: a click puts the caret in the text, typing reaches
/// the editor's state through its MutationObserver, Enter and Backspace go through its
/// keymap, and the caret moves with the arrows.
effect fn prosemirrorEditor(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let bundle = run platform.readFile(b"modules/js/examples/prosemirror-editor/dist/app.js")
  // The page's <style> sets white-space: pre-wrap, as ProseMirror asks; an app's host compiles it.
  host.setStylesheetCompiler(runtimeStylesheets())
  host.attach(tree.engineMut())
  run host.module(bundle.asSlice(), b"app.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run expectJs(&mut host, "paragraphs() === 'Hello world / Second paragraph'")
  run click(&mut host, &mut tree, "Hello world")
  run host.tick(0.05, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.05)
  run expectJs(&mut host, "editor.hasFocus()")
  run expectJs(&mut host, "editor.state.selection.empty && editor.state.selection.from > 1 && editor.state.selection.from < 12")
  run host.evaluate(b"editor.dispatch(editor.state.tr.setSelection(editor.state.selection.constructor.create(editor.state.doc, 6)))", b"test")
  run host.tick(0.1, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.1)

  run host.input(&mut tree, run Input.text(","))
  run host.tick(0.15, true)
  run host.flush(&mut tree)
  run expectJs(&mut host, "paragraphs() === 'Hello, world / Second paragraph'")
  run expectJs(&mut host, "editor.state.selection.from === 7")

  run host.input(&mut tree, run Input.key("Backspace"))
  run host.tick(0.2, true)
  run host.flush(&mut tree)
  run expectJs(&mut host, "paragraphs() === 'Hello world / Second paragraph'")

  run host.input(&mut tree, run Input.key("Enter"))
  run host.tick(0.25, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.25)
  run expectJs(&mut host, "paragraphs() === 'Hello /  world / Second paragraph'")
  run expectJs(&mut host, "editor.state.selection.from === 8")

  // As a window sends typing: the key, then its text (a prevented key's text is dropped).
  run host.input(&mut tree, run Input.key("n"))
  run host.input(&mut tree, run Input.text("new"))
  run host.tick(0.3, true)
  run host.flush(&mut tree)
  run expectJs(&mut host, "paragraphs() === 'Hello / new world / Second paragraph'")

  run host.input(&mut tree, Input.ImePreedit { text: run String.copy("ka"), selectionStart: 2, selectionEnd: 2 })
  run host.tick(0.32, true)
  run host.flush(&mut tree)
  run expectJs(&mut host, "paragraphs() === 'Hello / newka world / Second paragraph'")
  run host.input(&mut tree, run Input.text("か"))
  run host.tick(0.35, true)
  run host.flush(&mut tree)
  run expectJs(&mut host, "paragraphs() === 'Hello / newか world / Second paragraph'")

  // Backspace at a paragraph's start joins it to the one before, in the editor's keymap.
  run host.input(&mut tree, run Input.key("Home"))
  run host.tick(0.4, true)
  run host.flush(&mut tree)
  run expectJs(&mut host, "editor.state.selection.from === 8")
  run host.input(&mut tree, run Input.key("Backspace"))
  run host.tick(0.45, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.45)
  run expectJs(&mut host, "paragraphs() === 'Hellonewか world / Second paragraph'")

  run host.input(&mut tree, run Input.key("ArrowDown"))
  run host.tick(0.5, true)
  run host.flush(&mut tree)
  run expectJs(&mut host, "editor.state.selection.$from.parent.textContent === 'Second paragraph'")
}

effect fn withHost(example: u32) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let domain = run WaiterDomain.make()
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut host = run JsHost.open(&memory, domain.handle()) |> Effect.provideMut<Allocator>(&mut allocator)
  let ran = if example == 1 {
    run Effect.result(foldkitCounter(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else if example == 3 {
    run Effect.result(prosemirrorEditor(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else if example == 2 {
    run Effect.result(browserGlobals(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else {
    run Effect.result(reactCounter(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  }
  run host.close() |> Effect.provideMut<Allocator>(&mut allocator)
  match move ran {
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>>.Success { .. } => ()
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>>.Failure { error } => {
      // The example's exception, on stderr: the test runner shows only the error's kind.
      match &error { JsError { message } => {
        let mut writer = StderrWriter.make()
        drop run Effect.result(Writer.writeString(String.view(&message))) |> Effect.provideMut<Writer>(&mut writer)
      } _ => () }
      fail move error
    }
  }
}

test effect fn reactCounterRunsOnTheEmbeddedEngine() -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run withHost(0) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn foldkitCounterRunsOnTheEmbeddedEngine() -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run withHost(1) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn browserGlobalsRunOnTheEmbeddedEngine() -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run withHost(2) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn prosemirrorEditsOnTheEmbeddedEngine() -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run withHost(3) |> Effect.provideMut<Allocator>(&mut allocator)
}
