//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The features caniuse lists (https://github.com/Fyrd/caniuse, CC BY 4.0): what each is
//! called and which browsers have it.
import silk.core.ownership { Copy }

pub struct Feature {
  pub id: string<'static>,
  pub title: string<'static>,
  pub about: string<'static>,
  /// The feature's page on caniuse.com.
  pub link: string<'static>,
  pub group: string<'static>,
  /// Which file of docs/caniuse/support answers it.
  pub area: string<'static>,
  /// The first version of each browser that has it for good, or nothing.
  pub chrome: string<'static>,
  pub firefox: string<'static>,
  pub safari: string<'static>,
}

impl Copy for Feature {}

/// What Silk UI does with a feature.
pub struct Answer {
  /// "y" works, "a" partly, "n" not yet, "x" does not apply, "u" not checked yet.
  pub support: string<'static>,
  pub note: string<'static>,
}

impl Copy for Answer {}

pub const COUNT: usize = 374

pub fn features() -> [Feature; COUNT] {
  return [
    Feature { id: "abortcontroller", title: "AbortController & AbortSignal", about: "Controller object that allows you to abort one or more DOM requests made with the Fetch API.", link: "https://caniuse.com/abortcontroller", group: "JavaScript APIs", area: "javascript-apis", chrome: "66", firefox: "57", safari: "12.1" },
    Feature { id: "accelerometer", title: "Accelerometer", about: "Defines `Accelerometer`, `LinearAccelerationSensor` and `GravitySensor` interfaces for obtaining information about acceleration applied to the X, Y and Z axis of a device that hosts the sensor.", link: "https://caniuse.com/accelerometer", group: "JavaScript APIs", area: "javascript-apis", chrome: "67", firefox: "", safari: "" },
    Feature { id: "ambient-light", title: "Ambient Light Sensor", about: "Defines a concrete sensor interface to monitor the ambient light level or illuminance of the device’s environment.", link: "https://caniuse.com/ambient-light", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "array-find", title: "Array.prototype.find", about: "The `find()` method returns the value of the first item in the array based on the result of the provided testing function.", link: "https://caniuse.com/array-find", group: "JavaScript", area: "javascript", chrome: "45", firefox: "25", safari: "7.1" },
    Feature { id: "array-find-index", title: "Array.prototype.findIndex", about: "The `findIndex()` method returns the index of the first element in the array that satisfies the provided testing function.", link: "https://caniuse.com/array-find-index", group: "JavaScript", area: "javascript", chrome: "45", firefox: "25", safari: "7.1" },
    Feature { id: "array-flat", title: "flat & flatMap array methods", about: "Methods to flatten any sub-arrays found in an array by concatenating their elements.", link: "https://caniuse.com/array-flat", group: "JavaScript", area: "javascript", chrome: "69", firefox: "62", safari: "12" },
    Feature { id: "array-includes", title: "Array.prototype.includes", about: "Determines whether or not an array includes the given value, returning a boolean value (unlike `indexOf`).", link: "https://caniuse.com/array-includes", group: "JavaScript", area: "javascript", chrome: "47", firefox: "43", safari: "9" },
    Feature { id: "arrow-functions", title: "Arrow functions", about: "Function shorthand using `=>` syntax and lexical `this` binding.", link: "https://caniuse.com/arrow-functions", group: "JavaScript", area: "javascript", chrome: "45", firefox: "22", safari: "10" },
    Feature { id: "asmjs", title: "asm.js", about: "An extraordinarily optimizable, low-level subset of JavaScript, intended to be a compile target from languages like C++.", link: "https://caniuse.com/asmjs", group: "JavaScript", area: "javascript", chrome: "", firefox: "22", safari: "" },
    Feature { id: "async-clipboard", title: "Asynchronous Clipboard API", about: "A modern, asynchronous Clipboard API based on Promises", link: "https://caniuse.com/async-clipboard", group: "JavaScript APIs", area: "javascript-apis", chrome: "66", firefox: "125", safari: "13.1" },
    Feature { id: "async-functions", title: "Async functions", about: "Async functions make it possible to treat functions returning Promise objects as if they were synchronous.", link: "https://caniuse.com/async-functions", group: "JavaScript", area: "javascript", chrome: "55", firefox: "52", safari: "11" },
    Feature { id: "atob-btoa", title: "Base64 encoding and decoding", about: "Utility functions for encoding and decoding strings to and from base 64: window.atob() and window.btoa().", link: "https://caniuse.com/atob-btoa", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "audio-api", title: "Web Audio API", about: "High-level JavaScript API for processing and synthesizing audio", link: "https://caniuse.com/audio-api", group: "JavaScript APIs", area: "javascript-apis", chrome: "14", firefox: "25", safari: "6" },
    Feature { id: "auxclick", title: "Auxclick", about: "The click event for non-primary buttons of input devices", link: "https://caniuse.com/auxclick", group: "JavaScript APIs", area: "javascript-apis", chrome: "55", firefox: "53", safari: "18.2" },
    Feature { id: "background-attachment", title: "CSS background-attachment", about: "Method of defining how a background image is attached to a scrollable element. Values include `scroll` (default), `fixed` and `local`.", link: "https://caniuse.com/background-attachment", group: "CSS", area: "css-paint", chrome: "4", firefox: "25", safari: "15.4" },
    Feature { id: "background-clip-text", title: "Background-clip: text", about: "Clipping a background image to the foreground text.", link: "https://caniuse.com/background-clip-text", group: "CSS", area: "css-text", chrome: "4", firefox: "49", safari: "15.5" },
    Feature { id: "background-img-opts", title: "CSS3 Background-image options", about: "New properties to affect background images, including background-clip, background-origin and background-size", link: "https://caniuse.com/background-img-opts", group: "CSS", area: "css-paint", chrome: "15", firefox: "4", safari: "7" },
    Feature { id: "background-position-x-y", title: "background-position-x & background-position-y", about: "CSS longhand properties to define x or y positions separately.", link: "https://caniuse.com/background-position-x-y", group: "CSS", area: "css-paint", chrome: "4", firefox: "49", safari: "3.1" },
    Feature { id: "background-repeat-round-space", title: "CSS background-repeat round and space", about: "Allows CSS background images to be repeated without clipping.", link: "https://caniuse.com/background-repeat-round-space", group: "CSS", area: "css-paint", chrome: "32", firefox: "49", safari: "7" },
    Feature { id: "background-sync", title: "Background Sync API", about: "Provides one-off and periodic synchronization for Service Workers with an onsync event.", link: "https://caniuse.com/background-sync", group: "JavaScript APIs", area: "javascript-apis", chrome: "49", firefox: "", safari: "" },
    Feature { id: "battery-status", title: "Battery Status API", about: "Method to provide information about the battery status of the hosting device.", link: "https://caniuse.com/battery-status", group: "JavaScript APIs", area: "javascript-apis", chrome: "38", firefox: "", safari: "" },
    Feature { id: "beacon", title: "Beacon API", about: "Allows data to be sent asynchronously to a server with `navigator.sendBeacon`, even after a page was closed. Useful for posting analytics data the moment a user was finished using the page.", link: "https://caniuse.com/beacon", group: "JavaScript APIs", area: "javascript-apis", chrome: "39", firefox: "31", safari: "11.1" },
    Feature { id: "beforeafterprint", title: "Printing Events", about: "Window fires `beforeprint` and `afterprint` events so the printed document can be annotated.", link: "https://caniuse.com/beforeafterprint", group: "JavaScript APIs", area: "javascript-apis", chrome: "63", firefox: "6", safari: "13" },
    Feature { id: "bigint", title: "BigInt", about: "Arbitrary-precision integers in JavaScript.", link: "https://caniuse.com/bigint", group: "JavaScript", area: "javascript", chrome: "67", firefox: "68", safari: "14" },
    Feature { id: "blobbuilder", title: "Blob constructing", about: "Construct Blobs (binary large objects) either using the BlobBuilder API (deprecated) or the Blob constructor.", link: "https://caniuse.com/blobbuilder", group: "JavaScript APIs", area: "javascript-apis", chrome: "20", firefox: "13", safari: "6" },
    Feature { id: "bloburls", title: "Blob URLs", about: "Method of creating URL handles to the specified File or Blob object.", link: "https://caniuse.com/bloburls", group: "JavaScript APIs", area: "javascript-apis", chrome: "8", firefox: "4", safari: "6" },
    Feature { id: "border-image", title: "CSS3 Border images", about: "Method of using images for borders", link: "https://caniuse.com/border-image", group: "CSS", area: "css-paint", chrome: "56", firefox: "50", safari: "9.1" },
    Feature { id: "border-radius", title: "CSS3 Border-radius (rounded corners)", about: "Method of making the border corners round. Covers support for the shorthand `border-radius` as well as the long-hand properties (e.g. `border-top-left-radius`)", link: "https://caniuse.com/border-radius", group: "CSS", area: "css-paint", chrome: "4", firefox: "3", safari: "3.1" },
    Feature { id: "broadcastchannel", title: "BroadcastChannel", about: "BroadcastChannel allows scripts from the same origin but other browsing contexts (windows, workers) to send each other messages.", link: "https://caniuse.com/broadcastchannel", group: "JavaScript APIs", area: "javascript-apis", chrome: "54", firefox: "38", safari: "15.4" },
    Feature { id: "calc", title: "calc() as CSS unit value", about: "Method of allowing calculated values for length units, i.e. `width: calc(100% - 3em)`", link: "https://caniuse.com/calc", group: "CSS", area: "css-cascade", chrome: "19", firefox: "4", safari: "6" },
    Feature { id: "ch-unit", title: "ch (character) unit", about: "Unit representing the width of the character \"0\" in the current font, of particular use in combination with monospace fonts.", link: "https://caniuse.com/ch-unit", group: "CSS", area: "css-text", chrome: "27", firefox: "2", safari: "7" },
    Feature { id: "channel-messaging", title: "Channel messaging", about: "Method for having two-way communication between browsing contexts (using MessageChannel)", link: "https://caniuse.com/channel-messaging", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "41", safari: "5" },
    Feature { id: "clipboard", title: "Synchronous Clipboard API", about: "API to provide copy, cut and paste events as well as provide access to the OS clipboard.", link: "https://caniuse.com/clipboard", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "12" },
    Feature { id: "console-basic", title: "Basic console logging functions", about: "Method of outputting data to the browser's console, intended for development purposes.", link: "https://caniuse.com/console-basic", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "4", safari: "3.1" },
    Feature { id: "console-time", title: "console.time and console.timeEnd", about: "Functions for measuring performance", link: "https://caniuse.com/console-time", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "10", safari: "4" },
    Feature { id: "const", title: "const", about: "Declares a constant with block level scope", link: "https://caniuse.com/const", group: "JavaScript", area: "javascript", chrome: "49", firefox: "36", safari: "11" },
    Feature { id: "constraint-validation", title: "Constraint Validation API", about: "API for better control over form field validation. Includes support for `checkValidity()`, `setCustomValidity()`, `reportValidity()` and validation states.", link: "https://caniuse.com/constraint-validation", group: "JavaScript APIs", area: "javascript-apis", chrome: "40", firefox: "51", safari: "10" },
    Feature { id: "cookie-store-api", title: "Cookie Store API", about: "An API for reading and modifying cookies. Compared to the existing `document.cookie` method, the API provides a much more modern interface, which can also be used in service workers.", link: "https://caniuse.com/cookie-store-api", group: "JavaScript APIs", area: "javascript-apis", chrome: "87", firefox: "140", safari: "18.4" },
    Feature { id: "cors", title: "Cross-Origin Resource Sharing", about: "Method of performing XMLHttpRequests across domains", link: "https://caniuse.com/cors", group: "JavaScript APIs", area: "javascript-apis", chrome: "13", firefox: "3.5", safari: "6" },
    Feature { id: "createimagebitmap", title: "createImageBitmap", about: "Create image bitmap with support for resizing and adjusting quality", link: "https://caniuse.com/createimagebitmap", group: "JavaScript APIs", area: "javascript-apis", chrome: "59", firefox: "98", safari: "17.0" },
    Feature { id: "credential-management", title: "Credential Management API", about: "API that provides a programmatic interface to the browser's credential manager. In short, an origin can request a user's credentials to sign them in, or can ask the browser to save credentials on the user's behalf. Both of these requests are user-mediated.", link: "https://caniuse.com/credential-management", group: "JavaScript APIs", area: "javascript-apis", chrome: "51", firefox: "", safari: "" },
    Feature { id: "cross-document-view-transitions", title: "View Transitions (cross-document)", about: "Provides a mechanism for easily creating animated transitions between different DOM states, while also updating the DOM contents in a single step. This API is specific to cross-document transitions.", link: "https://caniuse.com/cross-document-view-transitions", group: "CSS", area: "css-paint", chrome: "126", firefox: "", safari: "18.2" },
    Feature { id: "cryptography", title: "Web Cryptography", about: "JavaScript API for performing basic cryptographic operations in web applications", link: "https://caniuse.com/cryptography", group: "JavaScript APIs", area: "javascript-apis", chrome: "37", firefox: "34", safari: "7.1" },
    Feature { id: "css-all", title: "CSS all property", about: "A shorthand property for resetting all CSS properties except for `direction` and `unicode-bidi`.", link: "https://caniuse.com/css-all", group: "CSS", area: "css-cascade", chrome: "37", firefox: "27", safari: "9.1" },
    Feature { id: "css-anchor-positioning", title: "CSS Anchor Positioning", about: "Allows placing elements anywhere on the page relative to an \"anchor element\", without regard to the layout of other elements besides their containing block", link: "https://caniuse.com/css-anchor-positioning", group: "CSS", area: "css-layout", chrome: "", firefox: "", safari: "27" },
    Feature { id: "css-animation", title: "CSS Animation", about: "Complex method of animating certain properties of an element", link: "https://caniuse.com/css-animation", group: "CSS", area: "css-paint", chrome: "4", firefox: "5", safari: "5.1" },
    Feature { id: "css-any-link", title: "CSS :any-link selector", about: "The `:any-link` CSS pseudo-class matches all elements that match `:link` or `:visited`", link: "https://caniuse.com/css-any-link", group: "CSS", area: "css-cascade", chrome: "15", firefox: "3", safari: "6.1" },
    Feature { id: "css-appearance", title: "CSS Appearance", about: "The `appearance` property defines how elements (particularly form controls) appear by default. By setting the value to `none` the default appearance can be entirely redefined using other CSS properties.", link: "https://caniuse.com/css-appearance", group: "CSS", area: "css-paint", chrome: "83", firefox: "80", safari: "15.4" },
    Feature { id: "css-at-counter-style", title: "CSS Counter Styles", about: "The @counter-style CSS at-rule allows custom counter styles to be defined. A @counter-style rule defines how to convert a counter value into a string representation.", link: "https://caniuse.com/css-at-counter-style", group: "CSS", area: "css-cascade", chrome: "", firefox: "", safari: "" },
    Feature { id: "css-backdrop-filter", title: "CSS Backdrop Filter", about: "Method of applying filter effects (like blur, grayscale or hue) to content/elements below the target element.", link: "https://caniuse.com/css-backdrop-filter", group: "CSS", area: "css-paint", chrome: "76", firefox: "103", safari: "9" },
    Feature { id: "css-background-offsets", title: "CSS background-position edge offsets", about: "Allows CSS background images to be positioned relative to the specified edge using the 3 to 4 value syntax. For example: `background-position: right 5px bottom 5px;` for positioning 5px from the bottom-right corner.", link: "https://caniuse.com/css-background-offsets", group: "CSS", area: "css-paint", chrome: "25", firefox: "13", safari: "7" },
    Feature { id: "css-backgroundblendmode", title: "CSS background-blend-mode", about: "Allows blending between CSS background images, gradients, and colors.", link: "https://caniuse.com/css-backgroundblendmode", group: "CSS", area: "css-paint", chrome: "47", firefox: "30", safari: "10.1" },
    Feature { id: "css-boxdecorationbreak", title: "CSS box-decoration-break", about: "Controls whether the box's margins, borders, padding, and other decorations wrap the broken edges of the box fragments (when the box is split by a break (page/column/region/line).", link: "https://caniuse.com/css-boxdecorationbreak", group: "CSS", area: "css-layout", chrome: "130", firefox: "32", safari: "" },
    Feature { id: "css-boxshadow", title: "CSS3 Box-shadow", about: "Method of displaying an inner or outer shadow effect to elements", link: "https://caniuse.com/css-boxshadow", group: "CSS", area: "css-paint", chrome: "4", firefox: "3.5", safari: "5" },
    Feature { id: "css-canvas", title: "CSS Canvas Drawings", about: "Method of using HTML5 Canvas as a background image. Not currently part of any specification.", link: "https://caniuse.com/css-canvas", group: "CSS", area: "css-paint", chrome: "", firefox: "", safari: "4" },
    Feature { id: "css-caret-color", title: "CSS caret-color", about: "The `caret-color` property allows the color to be set of the caret (blinking text insertion pointer) in an editable text area.", link: "https://caniuse.com/css-caret-color", group: "CSS", area: "css-paint", chrome: "57", firefox: "53", safari: "11.1" },
    Feature { id: "css-cascade-layers", title: "CSS Cascade Layers", about: "The `@layer` at-rule allows authors to explicitly layer their styles in the cascade, before specificity and order of appearance are considered.", link: "https://caniuse.com/css-cascade-layers", group: "CSS", area: "css-cascade", chrome: "99", firefox: "97", safari: "15.4" },
    Feature { id: "css-cascade-scope", title: "Scoped Styles: the @scope rule", about: "Allows CSS rules to be scoped to part of the document, with upper and lower limits described by selectors.", link: "https://caniuse.com/css-cascade-scope", group: "CSS", area: "css-cascade", chrome: "118", firefox: "146", safari: "17.4" },
    Feature { id: "css-case-insensitive", title: "Case-insensitive CSS attribute selectors", about: "Including an `i` before the `]` in a CSS attribute selector causes the attribute value to be matched in an ASCII-case-insensitive manner. For example, `[b=\"xyz\" i]` would match both `<a b=\"xyz\">` and `<a b=\"XYZ\">`.", link: "https://caniuse.com/css-case-insensitive", group: "CSS", area: "css-cascade", chrome: "49", firefox: "47", safari: "9" },
    Feature { id: "css-clip-path", title: "CSS clip-path property (for HTML)", about: "Method of defining the visible region of an HTML element using SVG or a shape definition.", link: "https://caniuse.com/css-clip-path", group: "CSS", area: "css-paint", chrome: "", firefox: "54", safari: "" },
    Feature { id: "css-color-adjust", title: "CSS print-color-adjust", about: "The `print-color-adjust` (or `-webkit-print-color-adjust` as prefixed in WebKit/Blink browsers) property is a CSS extension that can be used to force printing of background colors and images.", link: "https://caniuse.com/css-color-adjust", group: "CSS", area: "css-paint", chrome: "19", firefox: "48", safari: "6" },
    Feature { id: "css-color-function", title: "CSS color() function", about: "The CSS `color()` function allows the browser to display colors in any color space, such as the P3 color space which can display colors outside of the default sRGB color space.", link: "https://caniuse.com/css-color-function", group: "CSS", area: "css-cascade", chrome: "111", firefox: "113", safari: "15" },
    Feature { id: "css-conic-gradients", title: "CSS Conical Gradients", about: "Method of defining a conical or repeating conical color gradient as a CSS image.", link: "https://caniuse.com/css-conic-gradients", group: "CSS", area: "css-paint", chrome: "69", firefox: "83", safari: "12.1" },
    Feature { id: "css-container-queries", title: "CSS Container Queries (Size)", about: "Size queries in Container Queries provide a way to query the size of a container, and conditionally apply CSS to the content of that container.", link: "https://caniuse.com/css-container-queries", group: "CSS", area: "css-layout", chrome: "106", firefox: "110", safari: "16.0" },
    Feature { id: "css-container-queries-style", title: "CSS Container Style Queries", about: "Style queries in Container Queries provide a way to query the current styling of a container, and conditionally apply additional CSS to the contents of that container.", link: "https://caniuse.com/css-container-queries-style", group: "CSS", area: "css-layout", chrome: "", firefox: "151", safari: "" },
    Feature { id: "css-container-query-units", title: "CSS Container Query Units", about: "Container Query Units specify a length relative to the dimensions of a query container. The units include: `cqw`, `cqh`, `cqi`, `cqb`, `cqmin`, and `cqmax`.", link: "https://caniuse.com/css-container-query-units", group: "CSS", area: "css-layout", chrome: "105", firefox: "110", safari: "16.0" },
    Feature { id: "css-containment", title: "CSS Containment", about: "The CSS `contain` property lets developers limit the scope of the browser's styles, layout and paint work for faster and more efficient rendering.", link: "https://caniuse.com/css-containment", group: "CSS", area: "css-layout", chrome: "52", firefox: "69", safari: "15.4" },
    Feature { id: "css-content-visibility", title: "CSS content-visibility", about: "Provides control over when elements are rendered, so rendering can be skipped for elements not yet in the user's viewport.", link: "https://caniuse.com/css-content-visibility", group: "CSS", area: "css-layout", chrome: "85", firefox: "125", safari: "18.0" },
    Feature { id: "css-counters", title: "CSS Counters", about: "Method of controlling number values in generated content, using the `counter-reset` and `counter-increment` properties.", link: "https://caniuse.com/css-counters", group: "CSS", area: "css-cascade", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "css-crisp-edges", title: "Crisp edges/pixelated images", about: "Scales images with an algorithm that preserves edges and contrast, without smoothing colors or introducing blur. This is intended for images such as pixel art. Official values that accomplish this for the `image-rendering` property are `crisp-edges` and `pixelated`.", link: "https://caniuse.com/css-crisp-edges", group: "CSS", area: "css-paint", chrome: "41", firefox: "3.6", safari: "10" },
    Feature { id: "css-cross-fade", title: "CSS Cross-Fade Function", about: "Image function to create a \"crossfade\" between images. This allows one image to transition (fade) into another based on a percentage value.", link: "https://caniuse.com/css-cross-fade", group: "CSS", area: "css-paint", chrome: "17", firefox: "", safari: "5.1" },
    Feature { id: "css-default-pseudo", title: ":default CSS pseudo-class", about: "The `:default` pseudo-class matches checkboxes and radio buttons which are checked by default, `<option>`s with the `selected` attribute, and the default submit button (if any) of a form.", link: "https://caniuse.com/css-default-pseudo", group: "CSS", area: "css-cascade", chrome: "51", firefox: "4", safari: "10.1" },
    Feature { id: "css-descendant-gtgt", title: "Explicit descendant combinator >>", about: "An explicit, non-whitespace spelling of the descendant combinator. `A >> B` is equivalent to `A B`.", link: "https://caniuse.com/css-descendant-gtgt", group: "CSS", area: "css-cascade", chrome: "", firefox: "", safari: "" },
    Feature { id: "css-deviceadaptation", title: "CSS Device Adaptation", about: "Method of overriding the size of viewport in web page using the `@viewport` rule, replacing Apple's own popular `<meta>` viewport implementation. Includes the `extend-to-zoom` width value.", link: "https://caniuse.com/css-deviceadaptation", group: "CSS", area: "css-layout", chrome: "", firefox: "", safari: "" },
    Feature { id: "css-dir-pseudo", title: ":dir() CSS pseudo-class", about: "Matches elements based on their directionality. `:dir(ltr)` matches elements which are Left-to-Right. `:dir(rtl)` matches elements which are Right-to-Left.", link: "https://caniuse.com/css-dir-pseudo", group: "CSS", area: "css-cascade", chrome: "120", firefox: "17", safari: "16.4" },
    Feature { id: "css-display-contents", title: "CSS display: contents", about: "`display: contents` causes an element's children to appear as if they were direct children of the element's parent, ignoring the element itself. This can be useful when a wrapper element should be ignored when using CSS grid or similar layout techniques.", link: "https://caniuse.com/css-display-contents", group: "CSS", area: "css-layout", chrome: "", firefox: "", safari: "" },
    Feature { id: "css-element-function", title: "CSS element() function", about: "This function renders a live image generated from an arbitrary HTML element", link: "https://caniuse.com/css-element-function", group: "CSS", area: "css-paint", chrome: "", firefox: "4", safari: "" },
    Feature { id: "css-env-function", title: "CSS Environment Variables env()", about: "Usage of environment variables like `safe-area-inset-top`.", link: "https://caniuse.com/css-env-function", group: "CSS", area: "css-cascade", chrome: "69", firefox: "65", safari: "11.1" },
    Feature { id: "css-exclusions", title: "CSS Exclusions Level 1", about: "Exclusions defines how inline content flows around elements. It extends the content wrapping ability of floats to any block-level element.", link: "https://caniuse.com/css-exclusions", group: "CSS", area: "css-layout", chrome: "", firefox: "", safari: "" },
    Feature { id: "css-featurequeries", title: "CSS Feature Queries", about: "CSS Feature Queries allow authors to condition rules based on whether particular property declarations are supported in CSS using the @supports at rule.", link: "https://caniuse.com/css-featurequeries", group: "CSS", area: "css-cascade", chrome: "28", firefox: "22", safari: "9" },
    Feature { id: "css-filter-function", title: "CSS filter() function", about: "This function filters a CSS input image with a set of filter functions (like blur, grayscale or hue)", link: "https://caniuse.com/css-filter-function", group: "CSS", area: "css-paint", chrome: "", firefox: "", safari: "9" },
    Feature { id: "css-filters", title: "CSS Filter Effects", about: "Method of applying filter effects using the `filter` property to elements, matching filters available in SVG. Filter functions include blur, brightness, contrast, drop-shadow, grayscale, hue-rotate, invert, opacity, sepia and saturate.", link: "https://caniuse.com/css-filters", group: "CSS", area: "css-paint", chrome: "18", firefox: "35", safari: "6" },
    Feature { id: "css-first-letter", title: "::first-letter CSS pseudo-element selector", about: "CSS pseudo-element that allows styling only the first \"letter\" of text within an element. Useful for implementing initial caps or drop caps styling.", link: "https://caniuse.com/css-first-letter", group: "CSS", area: "css-text", chrome: "9", firefox: "3.5", safari: "5.1" },
    Feature { id: "css-first-line", title: "CSS first-line pseudo-element", about: "Allows styling specifically for the first line of text using the `::first-line` pseudo-element. Note that only a limited set of properties can be applied.", link: "https://caniuse.com/css-first-line", group: "CSS", area: "css-text", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "css-fixed", title: "CSS position:fixed", about: "Method of keeping an element in a fixed location regardless of scroll position", link: "https://caniuse.com/css-fixed", group: "CSS", area: "css-layout", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "css-focus-visible", title: ":focus-visible CSS pseudo-class", about: "The `:focus-visible` pseudo-class applies while an element matches the `:focus` pseudo-class, and the UA determines via heuristics that the focus should be specially indicated on the element (typically via a “focus ring”).", link: "https://caniuse.com/css-focus-visible", group: "CSS", area: "css-cascade", chrome: "86", firefox: "4", safari: "15.4" },
    Feature { id: "css-focus-within", title: ":focus-within CSS pseudo-class", about: "The `:focus-within` pseudo-class matches elements that either themselves match `:focus` or that have descendants which match `:focus`.", link: "https://caniuse.com/css-focus-within", group: "CSS", area: "css-cascade", chrome: "60", firefox: "52", safari: "10.1" },
    Feature { id: "css-font-palette", title: "CSS font-palette", about: "The font-palette CSS property allows selecting a palette from a color font. In combination with the `@font-palette-values` at-rule, custom palettes can be defined.", link: "https://caniuse.com/css-font-palette", group: "CSS", area: "css-text", chrome: "101", firefox: "107", safari: "15.4" },
    Feature { id: "css-font-rendering-controls", title: "CSS font-display", about: "`@font-face` descriptor `font-display` that allows control over how a downloadable font renders before it is fully loaded.", link: "https://caniuse.com/css-font-rendering-controls", group: "CSS", area: "css-text", chrome: "60", firefox: "58", safari: "11.1" },
    Feature { id: "css-font-stretch", title: "CSS font-stretch", about: "If a font has multiple types of variations based on the width of characters, this property allows the appropriate one to be selected. The property in itself does not cause the browser to stretch to a font. Note that `font-stretch` is an alias of the [`font-width`](/wf-font-width) CSS property.", link: "https://caniuse.com/css-font-stretch", group: "CSS", area: "css-text", chrome: "48", firefox: "9", safari: "11" },
    Feature { id: "css-gencontent", title: "CSS Generated content for pseudo-elements", about: "Method of displaying text or images before or after the given element's contents using the ::before and ::after pseudo-elements. All browsers with support also support the `attr()` notation in the `content` property.", link: "https://caniuse.com/css-gencontent", group: "CSS", area: "css-cascade", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "css-gradients", title: "CSS Gradients", about: "Method of defining a linear or radial color gradient as a CSS image.", link: "https://caniuse.com/css-gradients", group: "CSS", area: "css-paint", chrome: "10", firefox: "36", safari: "15.4" },
    Feature { id: "css-grid", title: "CSS Grid Layout (level 1)", about: "Method of using a grid concept to lay out content, providing a mechanism for authors to divide available space for layout into columns and rows using a set of predictable sizing behaviors. Includes support for all `grid-*` properties and the `fr` unit.", link: "https://caniuse.com/css-grid", group: "CSS", area: "css-layout", chrome: "57", firefox: "52", safari: "10.1" },
    Feature { id: "css-grid-lanes", title: "CSS Grid Lanes", about: "CSS Grid Lanes extends CSS Grid to create layouts with columns *or* rows (not both), allowing mixed aspect ratio content to pack neatly (also known as \"masonry\" or \"waterfall\" layout).", link: "https://caniuse.com/css-grid-lanes", group: "CSS", area: "css-layout", chrome: "", firefox: "", safari: "26.4" },
    Feature { id: "css-hanging-punctuation", title: "CSS hanging-punctuation", about: "Allows some punctuation characters from start (or the end) of text elements to be placed \"outside\" of the box in order to preserve the reading flow.", link: "https://caniuse.com/css-hanging-punctuation", group: "CSS", area: "css-text", chrome: "", firefox: "", safari: "17.4" },
    Feature { id: "css-has", title: ":has() CSS relational pseudo-class", about: "Select elements containing specific content. For example, `a:has(img)` selects all `<a>` elements that contain an `<img>` child.", link: "https://caniuse.com/css-has", group: "CSS", area: "css-cascade", chrome: "105", firefox: "121", safari: "15.4" },
    Feature { id: "css-hyphens", title: "CSS Hyphenation", about: "Method of controlling when words at the end of lines should be hyphenated using the \"hyphens\" property.", link: "https://caniuse.com/css-hyphens", group: "CSS", area: "css-text", chrome: "88", firefox: "6", safari: "5.1" },
    Feature { id: "css-if", title: "CSS if() function", about: "The `if()` CSS function allows different values to be set for a property depending on the result of a conditional test. The test can be based on a style query, a media query, or a feature query.", link: "https://caniuse.com/css-if", group: "CSS", area: "css-cascade", chrome: "137", firefox: "", safari: "" },
    Feature { id: "css-image-orientation", title: "CSS3 image-orientation", about: "CSS property used generally to fix the intended orientation of an image. This can be done using 90 degree increments or based on the image's EXIF data using the \"from-image\" value.", link: "https://caniuse.com/css-image-orientation", group: "CSS", area: "css-paint", chrome: "81", firefox: "26", safari: "13.1" },
    Feature { id: "css-image-set", title: "CSS image-set", about: "Method of letting the browser pick the most appropriate CSS image from a given set.", link: "https://caniuse.com/css-image-set", group: "CSS", area: "css-paint", chrome: "113", firefox: "89", safari: "17.0" },
    Feature { id: "css-in-out-of-range", title: ":in-range and :out-of-range CSS pseudo-classes", about: "If a temporal or number `<input>` has `max` and/or `min` attributes, then `:in-range` matches when the value is within the specified range and `:out-of-range` matches when the value is outside the specified range. If there are no range constraints, then neither pseudo-class matches.", link: "https://caniuse.com/css-in-out-of-range", group: "CSS", area: "css-cascade", chrome: "53", firefox: "50", safari: "10.1" },
    Feature { id: "css-indeterminate-pseudo", title: ":indeterminate CSS pseudo-class", about: "The `:indeterminate` pseudo-class matches indeterminate checkboxes, indeterminate `<progress>` bars, and radio buttons with no checked button in their radio button group.", link: "https://caniuse.com/css-indeterminate-pseudo", group: "CSS", area: "css-cascade", chrome: "39", firefox: "51", safari: "10.1" },
    Feature { id: "css-initial-letter", title: "CSS Initial Letter", about: "Method of creating an enlarged cap, including a drop or raised cap, in a robust way.", link: "https://caniuse.com/css-initial-letter", group: "CSS", area: "css-text", chrome: "", firefox: "", safari: "" },
    Feature { id: "css-initial-value", title: "CSS initial value", about: "A CSS value that will apply a property's initial value as defined in the CSS specification that defines the property", link: "https://caniuse.com/css-initial-value", group: "CSS", area: "css-cascade", chrome: "4", firefox: "3.5", safari: "3.2" },
    Feature { id: "css-lch-lab", title: "LCH and Lab color values", about: "The `lch()` and `lab()` color functions are based on the CIE LAB color space, representing colors in a way that closely matches human perception and provides access to a wider spectrum of colors than offered by the usual RGB color space.", link: "https://caniuse.com/css-lch-lab", group: "CSS", area: "css-cascade", chrome: "111", firefox: "113", safari: "15" },
    Feature { id: "css-letter-spacing", title: "letter-spacing CSS property", about: "Controls spacing between characters of text (i.e. \"tracking\" in typographical terms). Not to be confused with kerning.", link: "https://caniuse.com/css-letter-spacing", group: "CSS", area: "css-text", chrome: "30", firefox: "2", safari: "6.1" },
    Feature { id: "css-line-clamp", title: "CSS line-clamp", about: "CSS property that will contain text to a given amount of lines when used in combination with `display: -webkit-box`. It will end with ellipsis when `text-overflow: ellipsis` is included.", link: "https://caniuse.com/css-line-clamp", group: "CSS", area: "css-text", chrome: "14", firefox: "68", safari: "5" },
    Feature { id: "css-logical-props", title: "CSS Logical Properties", about: "Logical properties and values provide control of layout through logical, rather than physical, direction and dimension mappings. These properties are `writing-mode` relative equivalents of their corresponding physical properties.", link: "https://caniuse.com/css-logical-props", group: "CSS", area: "css-layout", chrome: "89", firefox: "66", safari: "15" },
    Feature { id: "css-marker-pseudo", title: "CSS ::marker pseudo-element", about: "The `::marker` pseudo-element allows list item markers to be styled or have their content value customized.", link: "https://caniuse.com/css-marker-pseudo", group: "CSS", area: "css-cascade", chrome: "86", firefox: "68", safari: "" },
    Feature { id: "css-masks", title: "CSS Masks", about: "Method of displaying part of an element, using a selected image as a mask", link: "https://caniuse.com/css-masks", group: "CSS", area: "css-paint", chrome: "120", firefox: "53", safari: "15.4" },
    Feature { id: "css-matches-pseudo", title: ":is() CSS pseudo-class", about: "The `:is()` (formerly `:matches()`, formerly `:any()`) pseudo-class checks whether the element at its position in the outer selector matches any of the selectors in its selector list. It's useful syntactic sugar that allows you to avoid writing out all the combinations manually as separate selectors. The effect is similar to nesting in Sass and most other CSS preprocessors.", link: "https://caniuse.com/css-matches-pseudo", group: "CSS", area: "css-cascade", chrome: "88", firefox: "78", safari: "14" },
    Feature { id: "css-math-functions", title: "CSS math functions min(), max() and clamp()", about: "More advanced mathematical expressions in addition to `calc()`", link: "https://caniuse.com/css-math-functions", group: "CSS", area: "css-cascade", chrome: "79", firefox: "75", safari: "13.1" },
    Feature { id: "css-media-interaction", title: "Media Queries: interaction media features", about: "Allows a media query to be set based on the presence and accuracy of the user's pointing device, and whether they have the ability to hover over elements on the page. This includes the `pointer`, `any-pointer`, `hover`, and `any-hover` media features.", link: "https://caniuse.com/css-media-interaction", group: "CSS", area: "css-cascade", chrome: "41", firefox: "64", safari: "9" },
    Feature { id: "css-media-range-syntax", title: "Media Queries: Range Syntax", about: "Syntax improvements to make media queries using features that have a \"range\" type (like width or height) less verbose. Can be used with ordinary mathematical comparison operators: `>`, `<`, `>=`, or `<=`. For example: `@media (100px <= width <= 1900px)` is the equivalent of `@media (min-width: 100px) and (max-width: 1900px)`", link: "https://caniuse.com/css-media-range-syntax", group: "CSS", area: "css-cascade", chrome: "104", firefox: "63", safari: "16.4" },
    Feature { id: "css-media-resolution", title: "Media Queries: resolution feature", about: "Allows a media query to be set based on the device pixels used per CSS unit. While the standard uses `min`/`max-resolution` for this, some browsers support the older non-standard `device-pixel-ratio` media query.", link: "https://caniuse.com/css-media-resolution", group: "CSS", area: "css-cascade", chrome: "68", firefox: "62", safari: "16.0" },
    Feature { id: "css-mediaqueries", title: "CSS3 Media Queries", about: "Method of applying styles based on media information. Includes things like page and device dimensions", link: "https://caniuse.com/css-mediaqueries", group: "CSS", area: "css-cascade", chrome: "4", firefox: "3.5", safari: "4" },
    Feature { id: "css-mixblendmode", title: "Blending of HTML/SVG elements", about: "Allows blending between arbitrary SVG and HTML elements", link: "https://caniuse.com/css-mixblendmode", group: "CSS", area: "css-paint", chrome: "41", firefox: "32", safari: "" },
    Feature { id: "css-motion-paths", title: "CSS Motion Path", about: "Allows elements to be animated along SVG paths or shapes via the `offset-path` property. Originally defined as the `motion-path` property.", link: "https://caniuse.com/css-motion-paths", group: "CSS", area: "css-paint", chrome: "46", firefox: "72", safari: "16.0" },
    Feature { id: "css-namespaces", title: "CSS namespaces", about: "Using the `@namespace` at-rule, elements of other namespaces (e.g. SVG) can be targeted using the pipe (`|`) selector.", link: "https://caniuse.com/css-namespaces", group: "CSS", area: "css-cascade", chrome: "4", firefox: "2", safari: "4" },
    Feature { id: "css-nesting", title: "CSS Nesting", about: "CSS nesting provides the ability to nest one style rule inside another, with the selector of the child rule relative to the selector of the parent rule. Similar behavior previously required a CSS pre-processor.", link: "https://caniuse.com/css-nesting", group: "CSS", area: "css-cascade", chrome: "120", firefox: "117", safari: "17.2" },
    Feature { id: "css-not-sel-list", title: "selector list argument of :not()", about: "Selectors Level 3 only allowed `:not()` pseudo-class to accept a single simple selector, which the element must not match any of. Thus, `:not(a, .b, [c])` or `:not(a.b[c])` did not work. Selectors Level 4 allows `:not()` to accept a list of selectors. Thus, `:not(a):not(.b):not([c])` can instead be written as `:not(a, .b, [c])` and `:not(a.b[c])` works as intended.", link: "https://caniuse.com/css-not-sel-list", group: "CSS", area: "css-cascade", chrome: "88", firefox: "84", safari: "9" },
    Feature { id: "css-nth-child-of", title: "selector list argument of :nth-child and :nth-last-child CSS pseudo-classes", about: "The newest versions of `:nth-child()` and `:nth-last-child()` accept an optional `of S` clause which filters the children to only those which match the selector list `S`. For example, `:nth-child(1 of .foo)` selects the first child among the children that have the `foo` class (ignoring any non-`foo` children which precede that child). Similar to `:nth-of-type`, but for arbitrary selectors instead of only type selectors.", link: "https://caniuse.com/css-nth-child-of", group: "CSS", area: "css-cascade", chrome: "111", firefox: "113", safari: "9" },
    Feature { id: "css-opacity", title: "CSS3 Opacity", about: "Method of setting the transparency level of an element", link: "https://caniuse.com/css-opacity", group: "CSS", area: "css-paint", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "css-optional-pseudo", title: ":optional CSS pseudo-class", about: "The `:optional` pseudo-class matches form inputs (`<input>`, `<textarea>`, `<select>`) which are not `:required`.", link: "https://caniuse.com/css-optional-pseudo", group: "CSS", area: "css-cascade", chrome: "15", firefox: "4", safari: "5" },
    Feature { id: "css-overflow", title: "CSS overflow property", about: "Originally a single property for controlling overflowing content in both horizontal & vertical directions, the `overflow` property is now a shorthand for `overflow-x` & `overflow-y`. The latest version of the specification also introduces the `clip` value that blocks programmatic scrolling.", link: "https://caniuse.com/css-overflow", group: "CSS", area: "css-layout", chrome: "90", firefox: "81", safari: "16.0" },
    Feature { id: "css-overflow-anchor", title: "CSS overflow-anchor (Scroll Anchoring)", about: "Changes in DOM elements above the visible region of a scrolling box can result in the page moving while the user is in the middle of consuming the content. By default, the value of `overflow-anchor` is `auto`, it can mitigate this jarring user experience by keeping track of the position of an anchor node and adjusting the scroll offset accordingly", link: "https://caniuse.com/css-overflow-anchor", group: "CSS", area: "css-layout", chrome: "56", firefox: "66", safari: "27" },
    Feature { id: "css-overflow-overlay", title: "CSS overflow: overlay", about: "The `overlay` value of the `overflow` CSS property is a non-standard value to make scrollbars appear on top of content rather than take up space. This value is deprecated and related functionality being standardized as [the `scrollbar-gutter` property](mdn-css_properties_scrollbar-gutter).", link: "https://caniuse.com/css-overflow-overlay", group: "CSS", area: "css-layout", chrome: "", firefox: "", safari: "" },
    Feature { id: "css-overscroll-behavior", title: "CSS overscroll-behavior", about: "CSS property to control the behavior when the scroll position of a scroll container reaches the edge of the scrollport.", link: "https://caniuse.com/css-overscroll-behavior", group: "CSS", area: "css-layout", chrome: "65", firefox: "59", safari: "16.0" },
    Feature { id: "css-page-break", title: "CSS page-break properties", about: "Properties to control the way elements are broken across (printed) pages.", link: "https://caniuse.com/css-page-break", group: "CSS", area: "css-layout", chrome: "108", firefox: "", safari: "" },
    Feature { id: "css-paint-api", title: "CSS Painting API", about: "Allows programmatic generation of images used by CSS", link: "https://caniuse.com/css-paint-api", group: "CSS", area: "css-paint", chrome: "65", firefox: "", safari: "" },
    Feature { id: "css-placeholder", title: "::placeholder CSS pseudo-element", about: "The ::placeholder pseudo-element represents placeholder text in an input field: text that represents the input and provides a hint to the user on how to fill out the form. For example, a date-input field might have the placeholder text `YYYY-MM-DD` to clarify that numeric dates are to be entered in year-month-day order.", link: "https://caniuse.com/css-placeholder", group: "CSS", area: "css-cascade", chrome: "57", firefox: "19", safari: "10.1" },
    Feature { id: "css-placeholder-shown", title: ":placeholder-shown CSS pseudo-class", about: "Input elements can sometimes show placeholder text as a hint to the user on what to type in. See, for example, the placeholder attribute in HTML5. The :placeholder-shown pseudo-class matches an input element that is showing such placeholder text.", link: "https://caniuse.com/css-placeholder-shown", group: "CSS", area: "css-cascade", chrome: "47", firefox: "51", safari: "9" },
    Feature { id: "css-read-only-write", title: "CSS :read-only and :read-write selectors", about: ":read-only and :read-write pseudo-classes to match elements which are considered user-alterable", link: "https://caniuse.com/css-read-only-write", group: "CSS", area: "css-cascade", chrome: "36", firefox: "3", safari: "9" },
    Feature { id: "css-rebeccapurple", title: "Rebeccapurple color", about: "The new color added in CSS Color Module Level 4", link: "https://caniuse.com/css-rebeccapurple", group: "CSS", area: "css-cascade", chrome: "38", firefox: "33", safari: "7" },
    Feature { id: "css-reflections", title: "CSS Reflections", about: "Method of displaying a reflection of an element", link: "https://caniuse.com/css-reflections", group: "CSS", area: "css-paint", chrome: "4", firefox: "", safari: "4" },
    Feature { id: "css-regions", title: "CSS Regions", about: "Method of flowing content into multiple elements, allowing magazine-like layouts. While once supported in WebKit-based browsers and Internet Explorer, implementing the feature is no longer being pursued by any browser.", link: "https://caniuse.com/css-regions", group: "CSS", area: "css-layout", chrome: "", firefox: "", safari: "" },
    Feature { id: "css-relative-colors", title: "CSS Relative color syntax", about: "Relative color syntax in CSS allows a color to be defined relative to another color using the `from` keyword and optionally `calc()` for any of the color values.", link: "https://caniuse.com/css-relative-colors", group: "CSS", area: "css-cascade", chrome: "131", firefox: "133", safari: "18.0" },
    Feature { id: "css-repeating-gradients", title: "CSS Repeating Gradients", about: "Method of defining a repeating linear or radial color gradient as a CSS image.", link: "https://caniuse.com/css-repeating-gradients", group: "CSS", area: "css-paint", chrome: "10", firefox: "3.6", safari: "5.1" },
    Feature { id: "css-resize", title: "CSS resize property", about: "Method of allowing an element to be resized by the user, with options to limit to a given direction.", link: "https://caniuse.com/css-resize", group: "CSS", area: "css-paint", chrome: "4", firefox: "4", safari: "4" },
    Feature { id: "css-revert-value", title: "CSS revert value", about: "A CSS keyword value that resets a property's value to the default specified by the browser in its UA stylesheet, as if the webpage had not included any CSS. For example, `display:revert` on a `<div>` would result in `display:block`. This is in contrast to the `initial` value, which is simply defined on a per-property basis, and for `display` would be `inline`.", link: "https://caniuse.com/css-revert-value", group: "CSS", area: "css-cascade", chrome: "84", firefox: "67", safari: "9.1" },
    Feature { id: "css-rrggbbaa", title: "#rrggbbaa hex color notation", about: "The CSS Color Module Level 4 defines new 4 & 8 character hex notation for color to include the opacity level.", link: "https://caniuse.com/css-rrggbbaa", group: "CSS", area: "css-cascade", chrome: "62", firefox: "49", safari: "10" },
    Feature { id: "css-scroll-behavior", title: "CSS Scroll-behavior", about: "Method of specifying the scrolling behavior for a scrolling box, when scrolling happens due to navigation or CSSOM scrolling APIs.", link: "https://caniuse.com/css-scroll-behavior", group: "CSS", area: "css-layout", chrome: "61", firefox: "36", safari: "15.4" },
    Feature { id: "css-scrollbar", title: "CSS scrollbar styling", about: "Methods of styling scrollbars' color and width.", link: "https://caniuse.com/css-scrollbar", group: "CSS", area: "css-layout", chrome: "121", firefox: "64", safari: "26.2" },
    Feature { id: "css-sel2", title: "CSS 2.1 selectors", about: "Basic CSS selectors including: `*` (universal selector), `>` (child selector), `:first-child`, `:link`, `:visited`, `:active`, `:hover`, `:focus`, `:lang()`, `+` (adjacent sibling selector), `[attr]`, `[attr=\"val\"]`, `[attr~=\"val\"]`, `[attr|=\"bar\"]`, `.foo` (class selector), `#foo` (id selector)", link: "https://caniuse.com/css-sel2", group: "CSS", area: "css-cascade", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "css-sel3", title: "CSS3 selectors", about: "Advanced element selection using selectors including: `[foo^=\"bar\"]`, `[foo$=\"bar\"]`, `[foo*=\"bar\"]`, `:root`, `:nth-child()`, `:nth-last-child()`, `:nth-of-type()`, `:nth-last-of-type()`, `:last-child`, `:first-of-type`, `:last-of-type`, `:only-child`, `:only-of-type`, `:empty`, `:target`, `:enabled`, `:disabled`, `:checked`, `:not()`, `~` (general sibling)", link: "https://caniuse.com/css-sel3", group: "CSS", area: "css-cascade", chrome: "4", firefox: "3.5", safari: "3.2" },
    Feature { id: "css-selection", title: "::selection CSS pseudo-element", about: "The ::selection CSS pseudo-element applies rules to the portion of a document that has been highlighted (e.g., selected with the mouse or another pointing device) by the user.", link: "https://caniuse.com/css-selection", group: "CSS", area: "css-paint", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "css-shapes", title: "CSS Shapes Level 1", about: "Allows geometric shapes to be set in CSS to define an area for text to flow around. Includes properties `shape-outside`, `shape-margin` and `shape-image-threshold`", link: "https://caniuse.com/css-shapes", group: "CSS", area: "css-layout", chrome: "37", firefox: "62", safari: "7.1" },
    Feature { id: "css-snappoints", title: "CSS Scroll Snap", about: "CSS technique that allows customizable scrolling experiences like pagination of carousels by setting defined snap positions.", link: "https://caniuse.com/css-snappoints", group: "CSS", area: "css-layout", chrome: "69", firefox: "68", safari: "11" },
    Feature { id: "css-sticky", title: "CSS position:sticky", about: "Keeps elements positioned as \"fixed\" or \"relative\" depending on how it appears in the viewport. As a result the element is \"stuck\" when necessary while scrolling.", link: "https://caniuse.com/css-sticky", group: "CSS", area: "css-layout", chrome: "91", firefox: "59", safari: "7.1" },
    Feature { id: "css-subgrid", title: "CSS Subgrid", about: "Feature of the CSS Grid Layout Module Level 2 that allows a grid-item with its own grid to align in one or both dimensions with its parent grid.", link: "https://caniuse.com/css-subgrid", group: "CSS", area: "css-layout", chrome: "117", firefox: "71", safari: "16.0" },
    Feature { id: "css-supports-api", title: "CSS.supports() API", about: "The CSS.supports() static method returns a Boolean value indicating if the browser supports a given CSS feature, or not.", link: "https://caniuse.com/css-supports-api", group: "JavaScript APIs", area: "javascript-apis", chrome: "61", firefox: "55", safari: "9" },
    Feature { id: "css-table", title: "CSS Table display", about: "Method of displaying elements as tables, rows, and cells. Includes support for all `display: table-*` properties as well as `display: inline-table`", link: "https://caniuse.com/css-table", group: "CSS", area: "css-layout", chrome: "4", firefox: "3", safari: "3.1" },
    Feature { id: "css-text-align-last", title: "CSS3 text-align-last", about: "CSS property to describe how the last line of a block or a line right before a forced line break when `text-align` is `justify`.", link: "https://caniuse.com/css-text-align-last", group: "CSS", area: "css-text", chrome: "47", firefox: "12", safari: "16.0" },
    Feature { id: "css-text-box-trim", title: "CSS Text Box", about: "CSS `text-box` (and its longhands `text-box-trim` & `text-box-edge`) provide the ability to trim extra space over/under text glyphs at the start/end of a block to match specific font-provided metrics. This allows for more precise alignment and positioning of text.", link: "https://caniuse.com/css-text-box-trim", group: "CSS", area: "css-text", chrome: "133", firefox: "154", safari: "18.2" },
    Feature { id: "css-text-indent", title: "CSS text-indent", about: "The `text-indent` property applies indentation to lines of inline content in a block.", link: "https://caniuse.com/css-text-indent", group: "CSS", area: "css-text", chrome: "146", firefox: "121", safari: "16.0" },
    Feature { id: "css-text-justify", title: "CSS text-justify", about: "CSS property to define how text should be justified when `text-align: justify` is set.", link: "https://caniuse.com/css-text-justify", group: "CSS", area: "css-text", chrome: "145", firefox: "55", safari: "" },
    Feature { id: "css-text-orientation", title: "CSS text-orientation", about: "The CSS `text-orientation` property specifies the orientation of text within a line. Current values only have an effect in vertical typographic modes (defined with the `writing-mode` property)", link: "https://caniuse.com/css-text-orientation", group: "CSS", area: "css-text", chrome: "48", firefox: "41", safari: "10.1" },
    Feature { id: "css-text-wrap-balance", title: "CSS text-wrap: balance", about: "Allows multiple lines of text to have their lines broken in such a way that each line is roughly the same width, often used to make headlines more readable and visually appealing.", link: "https://caniuse.com/css-text-wrap-balance", group: "CSS", area: "css-text", chrome: "130", firefox: "121", safari: "17.5" },
    Feature { id: "css-textshadow", title: "CSS3 Text-shadow", about: "Method of applying one or more shadow or blur effects to text", link: "https://caniuse.com/css-textshadow", group: "CSS", area: "css-text", chrome: "4", firefox: "3.5", safari: "4" },
    Feature { id: "css-touch-action", title: "CSS touch-action property", about: "touch-action is a CSS property that controls filtering of gesture events, providing developers with a declarative mechanism to selectively disable touch scrolling (in one or both axes) or double-tap-zooming.", link: "https://caniuse.com/css-touch-action", group: "CSS", area: "css-paint", chrome: "36", firefox: "52", safari: "" },
    Feature { id: "css-transitions", title: "CSS3 Transitions", about: "Simple method of animating certain properties of an element, with ability to define property, duration, delay and timing function.", link: "https://caniuse.com/css-transitions", group: "CSS", area: "css-paint", chrome: "4", firefox: "5", safari: "5.1" },
    Feature { id: "css-unset-value", title: "CSS unset value", about: "A CSS value that's the same as \"inherit\" if a property is inherited or \"initial\" if a property is not inherited.", link: "https://caniuse.com/css-unset-value", group: "CSS", area: "css-cascade", chrome: "41", firefox: "27", safari: "9.1" },
    Feature { id: "css-variables", title: "CSS Variables (Custom Properties)", about: "Permits the declaration and usage of cascading variables in stylesheets.", link: "https://caniuse.com/css-variables", group: "CSS", area: "css-cascade", chrome: "49", firefox: "31", safari: "10" },
    Feature { id: "css-when-else", title: "CSS @when / @else conditional rules", about: "Syntax allowing CSS conditions (like media and support queries) to be written more simply, as well as making it possible to write mutually exclusive rules using `@else` statements.", link: "https://caniuse.com/css-when-else", group: "CSS", area: "css-cascade", chrome: "", firefox: "", safari: "" },
    Feature { id: "css-widows-orphans", title: "CSS widows & orphans", about: "CSS properties to control when lines break across pages or columns by defining the amount of lines that must be left before or after the break.", link: "https://caniuse.com/css-widows-orphans", group: "CSS", area: "css-text", chrome: "25", firefox: "", safari: "7" },
    Feature { id: "css-writing-mode", title: "CSS writing-mode property", about: "Property to define whether lines of text are laid out horizontally or vertically and the direction in which blocks progress.", link: "https://caniuse.com/css-writing-mode", group: "CSS", area: "css-text", chrome: "8", firefox: "41", safari: "5.1" },
    Feature { id: "css-zoom", title: "CSS zoom", about: "Method of scaling content while also affecting layout.", link: "https://caniuse.com/css-zoom", group: "CSS", area: "css-paint", chrome: "4", firefox: "126", safari: "4" },
    Feature { id: "css3-attr", title: "CSS3 attr() function for all properties", about: "While `attr()` is supported for effectively all browsers for the `content` property, CSS Values and Units Level 5 adds the ability to use `attr()` on **any** CSS property, and to use it for non-string values (e.g. numbers, colors).", link: "https://caniuse.com/css3-attr", group: "CSS", area: "css-cascade", chrome: "133", firefox: "155", safari: "TP" },
    Feature { id: "css3-boxsizing", title: "CSS3 Box-sizing", about: "Method of specifying whether or not an element's borders and padding should be included in size units", link: "https://caniuse.com/css3-boxsizing", group: "CSS", area: "css-layout", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "css3-colors", title: "CSS3 Colors", about: "Method of describing colors using Hue, Saturation and Lightness (hsl()) rather than just RGB, as well as allowing alpha-transparency with rgba() and hsla().", link: "https://caniuse.com/css3-colors", group: "CSS", area: "css-cascade", chrome: "4", firefox: "3", safari: "3.1" },
    Feature { id: "css3-cursors", title: "CSS3 Cursors (original values)", about: "CSS3 cursor values added in the 2004 spec, including none, context-menu, cell, vertical-text, alias, copy, no-drop, not-allowed, nesw-resize, nwse-resize, col-resize, row-resize and all-scroll.", link: "https://caniuse.com/css3-cursors", group: "CSS", area: "css-paint", chrome: "5", firefox: "4", safari: "5" },
    Feature { id: "css3-cursors-grab", title: "CSS grab & grabbing cursors", about: "Support for the `grab` & `grabbing` values for the `cursor` property. Used to indicate that something can be grabbed (dragged to be moved).", link: "https://caniuse.com/css3-cursors-grab", group: "CSS", area: "css-paint", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "css3-cursors-newer", title: "CSS3 Cursors: zoom-in & zoom-out", about: "Support for `zoom-in`, `zoom-out` values for the CSS3 `cursor` property.", link: "https://caniuse.com/css3-cursors-newer", group: "CSS", area: "css-paint", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "css3-tabsize", title: "CSS3 tab-size", about: "Method of customizing the width of the tab character. Only effective using 'white-space: pre', 'white-space: pre-wrap', and 'white-space: break-spaces'.", link: "https://caniuse.com/css3-tabsize", group: "CSS", area: "css-text", chrome: "42", firefox: "53", safari: "13.1" },
    Feature { id: "currentcolor", title: "CSS currentColor value", about: "A CSS value that will apply the existing `color` value to other properties like `background-color`, etc.", link: "https://caniuse.com/currentcolor", group: "CSS", area: "css-cascade", chrome: "4", firefox: "2", safari: "4" },
    Feature { id: "customevent", title: "CustomEvent", about: "A DOM event interface that can carry custom application-defined data.", link: "https://caniuse.com/customevent", group: "JavaScript APIs", area: "javascript-apis", chrome: "15", firefox: "11", safari: "6.1" },
    Feature { id: "date-tolocaledatestring", title: "Date.prototype.toLocaleDateString", about: "Date method to generate a language sensitive representation of a given date, formatted based on a specified locale and options.", link: "https://caniuse.com/date-tolocaledatestring", group: "JavaScript", area: "javascript", chrome: "70", firefox: "56", safari: "12" },
    Feature { id: "decorators", title: "Decorators", about: "ECMAScript Decorators are an in-progress proposal for extending JavaScript classes. Decorators use a special syntax, prefixed with an `@` symbol and placed immediately before the code being extended.", link: "https://caniuse.com/decorators", group: "JavaScript", area: "javascript", chrome: "", firefox: "", safari: "" },
    Feature { id: "deviceorientation", title: "DeviceOrientation & DeviceMotion events", about: "API for detecting orientation and motion events from the device running the browser.", link: "https://caniuse.com/deviceorientation", group: "JavaScript APIs", area: "javascript-apis", chrome: "31", firefox: "6", safari: "17.0" },
    Feature { id: "devicepixelratio", title: "Window.devicePixelRatio", about: "Read-only property that returns the ratio of the (vertical) size of one physical pixel on the current display device to the size of one CSS pixel.", link: "https://caniuse.com/devicepixelratio", group: "CSS", area: "css-paint", chrome: "4", firefox: "18", safari: "" },
    Feature { id: "do-not-track", title: "Do Not Track API", about: "API to allow the browser's Do Not Track setting to be queried via `navigator.doNotTrack`. Due to lack of adoption the Do Not Track specification was deprecated in 2018.", link: "https://caniuse.com/do-not-track", group: "JavaScript APIs", area: "javascript-apis", chrome: "23", firefox: "32", safari: "" },
    Feature { id: "document-currentscript", title: "document.currentScript", about: "`document.currentScript` returns the `<script>` element whose script is currently being processed.", link: "https://caniuse.com/document-currentscript", group: "JavaScript APIs", area: "javascript-apis", chrome: "29", firefox: "4", safari: "8" },
    Feature { id: "document-evaluate-xpath", title: "document.evaluate & XPath", about: "Allow nodes in an XML/HTML document to be traversed using XPath expressions.", link: "https://caniuse.com/document-evaluate-xpath", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "3", safari: "3.1" },
    Feature { id: "document-execcommand", title: "Document.execCommand()", about: "Allows running commands to manipulate the contents of an editable region in a document switched to designMode", link: "https://caniuse.com/document-execcommand", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "9", safari: "6" },
    Feature { id: "dom-range", title: "Document Object Model Range", about: "A contiguous range of content in a Document, DocumentFragment or Attr", link: "https://caniuse.com/dom-range", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "element-scroll-methods", title: "Scroll methods on elements (scroll, scrollTo, scrollBy)", about: "Methods to change the scroll position of an element. Similar to setting `scrollTop` & `scrollLeft` properties, but also allows options to be passed to define the scroll behavior.", link: "https://caniuse.com/element-scroll-methods", group: "JavaScript APIs", area: "javascript-apis", chrome: "61", firefox: "36", safari: "14" },
    Feature { id: "eme", title: "Encrypted Media Extensions", about: "The EncryptedMediaExtenstions API provides interfaces for controlling the playback of content which is subject to a DRM scheme.", link: "https://caniuse.com/eme", group: "JavaScript APIs", area: "javascript-apis", chrome: "42", firefox: "38", safari: "12" },
    Feature { id: "es5", title: "ECMAScript 5", about: "Full support for the ECMAScript 5 specification. Features include `Function.prototype.bind`, Array methods like `indexOf`, `forEach`, `map` & `filter`, Object methods like `defineProperty`, `create` & `keys`, the `trim` method on Strings and many more.", link: "https://caniuse.com/es5", group: "JavaScript", area: "javascript", chrome: "23", firefox: "21", safari: "6" },
    Feature { id: "es6", title: "ECMAScript 2015 (ES6)", about: "Support for the ECMAScript 2015 specification. Features include Promises, Modules, Classes, Template Literals, Arrow Functions, Let and Const, Default Parameters, Generators, Destructuring Assignment, Rest & Spread, Map/Set & WeakMap/WeakSet and many more.", link: "https://caniuse.com/es6", group: "JavaScript", area: "javascript", chrome: "51", firefox: "54", safari: "10" },
    Feature { id: "es6-class", title: "ES6 classes", about: "ES6 classes are syntactical sugar to provide a much simpler and clearer syntax to create objects and deal with inheritance.", link: "https://caniuse.com/es6-class", group: "JavaScript", area: "javascript", chrome: "49", firefox: "45", safari: "9" },
    Feature { id: "es6-generators", title: "ES6 Generators", about: "ES6 Generators are special functions that can be used to control the iteration behavior of a loop. Generators are defined using a `function*` declaration.", link: "https://caniuse.com/es6-generators", group: "JavaScript", area: "javascript", chrome: "39", firefox: "26", safari: "10" },
    Feature { id: "es6-module", title: "JavaScript modules via script tag", about: "Loading JavaScript module scripts (aka ES6 modules) using `<script type=\"module\">` Includes support for the `nomodule` attribute.", link: "https://caniuse.com/es6-module", group: "JavaScript", area: "javascript", chrome: "61", firefox: "60", safari: "11" },
    Feature { id: "es6-module-dynamic-import", title: "JavaScript modules: dynamic import()", about: "Loading JavaScript modules dynamically using the import() syntax", link: "https://caniuse.com/es6-module-dynamic-import", group: "JavaScript", area: "javascript", chrome: "63", firefox: "67", safari: "11.1" },
    Feature { id: "es6-number", title: "ES6 Number", about: "Extensions to the `Number` built-in object in ES6, including constant properties `EPSILON`, `MIN_SAFE_INTEGER`, and `MAX_SAFE_INTEGER`, and methods ` isFinite`, `isInteger`, `isSafeInteger`, and `isNaN`.", link: "https://caniuse.com/es6-number", group: "JavaScript", area: "javascript", chrome: "34", firefox: "32", safari: "9" },
    Feature { id: "es6-string-includes", title: "String.prototype.includes", about: "The includes() method determines whether one string may be found within another string, returning true or false as appropriate.", link: "https://caniuse.com/es6-string-includes", group: "JavaScript", area: "javascript", chrome: "41", firefox: "40", safari: "9" },
    Feature { id: "eventsource", title: "Server-sent events", about: "Method of continuously sending data from a server to the browser, rather than repeatedly requesting it (EventSource interface, used to fall under HTML5)", link: "https://caniuse.com/eventsource", group: "JavaScript APIs", area: "javascript-apis", chrome: "6", firefox: "6", safari: "5" },
    Feature { id: "extended-system-fonts", title: "ui-serif, ui-sans-serif, ui-monospace and ui-rounded values for font-family", about: "Allows more control when choosing system interface fonts", link: "https://caniuse.com/extended-system-fonts", group: "CSS", area: "css-text", chrome: "", firefox: "", safari: "13.1" },
    Feature { id: "feature-policy", title: "Feature Policy", about: "This specification defines a mechanism that allows developers to selectively enable and disable use of various browser features and APIs. Feature Policy is deprecated and has been replaced with [Permissions Policy](/permissions-policy) and [Document Policy](/document-policy).", link: "https://caniuse.com/feature-policy", group: "JavaScript APIs", area: "javascript-apis", chrome: "74", firefox: "", safari: "" },
    Feature { id: "fetch", title: "Fetch", about: "A modern replacement for XMLHttpRequest.", link: "https://caniuse.com/fetch", group: "JavaScript APIs", area: "javascript-apis", chrome: "42", firefox: "39", safari: "10.1" },
    Feature { id: "fileapi", title: "File API", about: "Method of manipulating file objects in web applications client-side, as well as programmatically selecting them and accessing their data.", link: "https://caniuse.com/fileapi", group: "JavaScript APIs", area: "javascript-apis", chrome: "38", firefox: "28", safari: "10" },
    Feature { id: "filereader", title: "FileReader API", about: "Method of reading the contents of a File or Blob object into memory", link: "https://caniuse.com/filereader", group: "JavaScript APIs", area: "javascript-apis", chrome: "6", firefox: "3.6", safari: "6" },
    Feature { id: "filereadersync", title: "FileReaderSync", about: "Allows files to be read synchronously in Web Workers", link: "https://caniuse.com/filereadersync", group: "JavaScript APIs", area: "javascript-apis", chrome: "15", firefox: "8", safari: "6" },
    Feature { id: "filesystem", title: "Filesystem & FileWriter API", about: "Method of reading and writing files to a sandboxed file system.", link: "https://caniuse.com/filesystem", group: "JavaScript APIs", area: "javascript-apis", chrome: "13", firefox: "", safari: "" },
    Feature { id: "flexbox", title: "CSS Flexible Box Layout Module", about: "Method of positioning elements in horizontal or vertical stacks. Support includes all properties prefixed with `flex`, as well as `display: flex`, `display: inline-flex`, `align-content`, `align-items`, `align-self`, `justify-content` and `order`.", link: "https://caniuse.com/flexbox", group: "CSS", area: "css-layout", chrome: "21", firefox: "28", safari: "6.1" },
    Feature { id: "flexbox-gap", title: "gap property for Flexbox", about: "`gap` for flexbox containers to create gaps/gutters between flex items", link: "https://caniuse.com/flexbox-gap", group: "CSS", area: "css-layout", chrome: "84", firefox: "63", safari: "14.1" },
    Feature { id: "flow-root", title: "display: flow-root", about: "The element generates a block container box, and lays out its contents using flow layout. It always establishes a new block formatting context for its contents. It provides a better solution to the most use cases of the \"clearfix\" hack.", link: "https://caniuse.com/flow-root", group: "CSS", area: "css-layout", chrome: "58", firefox: "53", safari: "13" },
    Feature { id: "font-family-system-ui", title: "system-ui value for font-family", about: "Value for `font-family` that represents the default user interface font.", link: "https://caniuse.com/font-family-system-ui", group: "CSS", area: "css-text", chrome: "56", firefox: "92", safari: "11" },
    Feature { id: "font-feature", title: "CSS font-feature-settings", about: "Method of applying advanced typographic and language-specific font features to supported OpenType fonts.", link: "https://caniuse.com/font-feature", group: "CSS", area: "css-text", chrome: "21", firefox: "15", safari: "9.1" },
    Feature { id: "font-kerning", title: "CSS3 font-kerning", about: "Controls the usage of the kerning information (spacing between letters) stored in the font. Note that this only affects OpenType fonts with kerning information, it has no effect on other fonts.", link: "https://caniuse.com/font-kerning", group: "CSS", area: "css-text", chrome: "29", firefox: "34", safari: "7" },
    Feature { id: "font-loading", title: "CSS Font Loading", about: "This CSS module defines a scripting interface to font faces in CSS, allowing font faces to be easily created and loaded from script. It also provides methods to track the loading status of an individual font, or of all the fonts on an entire page.", link: "https://caniuse.com/font-loading", group: "CSS", area: "css-text", chrome: "35", firefox: "41", safari: "10" },
    Feature { id: "font-size-adjust", title: "CSS font-size-adjust", about: "Method of adjusting the font size in a matter that relates to the height of lowercase vs. uppercase letters. This makes it easier to set the size of fallback fonts.", link: "https://caniuse.com/font-size-adjust", group: "CSS", area: "css-text", chrome: "127", firefox: "118", safari: "17.0" },
    Feature { id: "font-smooth", title: "CSS font-smooth", about: "Controls the application of anti-aliasing when fonts are rendered.", link: "https://caniuse.com/font-smooth", group: "CSS", area: "css-text", chrome: "", firefox: "", safari: "" },
    Feature { id: "font-unicode-range", title: "Font unicode-range subsetting", about: "This @font-face descriptor defines the set of Unicode codepoints that may be supported by the font face for which it is declared. The descriptor value is a comma-delimited list of Unicode range (<urange>) values. The union of these ranges defines the set of codepoints that serves as a hint for user agents when deciding whether or not to download a font resource for a given text run.", link: "https://caniuse.com/font-unicode-range", group: "CSS", area: "css-text", chrome: "36", firefox: "44", safari: "10" },
    Feature { id: "font-variant-alternates", title: "CSS font-variant-alternates", about: "Controls the usage of alternate glyphs associated to alternative names defined in @font-feature-values for certain types of OpenType fonts.", link: "https://caniuse.com/font-variant-alternates", group: "CSS", area: "css-text", chrome: "111", firefox: "34", safari: "9.1" },
    Feature { id: "font-variant-numeric", title: "CSS font-variant-numeric", about: "CSS property that provides different ways of displaying numbers, fractions, and ordinal markers.", link: "https://caniuse.com/font-variant-numeric", group: "CSS", area: "css-text", chrome: "52", firefox: "34", safari: "9.1" },
    Feature { id: "fontface", title: "@font-face Web fonts", about: "Method of displaying fonts downloaded from websites", link: "https://caniuse.com/fontface", group: "CSS", area: "css-text", chrome: "4", firefox: "3.5", safari: "3.1" },
    Feature { id: "fullscreen", title: "Fullscreen API", about: "API for allowing content (like a video or canvas element) to take up the entire screen.", link: "https://caniuse.com/fullscreen", group: "CSS", area: "css-layout", chrome: "71", firefox: "64", safari: "16.4" },
    Feature { id: "gamepad", title: "Gamepad API", about: "API to support input from USB gamepad controllers through JavaScript.", link: "https://caniuse.com/gamepad", group: "JavaScript APIs", area: "javascript-apis", chrome: "21", firefox: "29", safari: "10.1" },
    Feature { id: "geolocation", title: "Geolocation", about: "Method of informing a website of the user's geographical location", link: "https://caniuse.com/geolocation", group: "JavaScript APIs", area: "javascript-apis", chrome: "5", firefox: "3.5", safari: "5" },
    Feature { id: "getboundingclientrect", title: "Element.getBoundingClientRect()", about: "Method to get the size and position of an element's bounding box, relative to the viewport.", link: "https://caniuse.com/getboundingclientrect", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "12", safari: "4" },
    Feature { id: "getcomputedstyle", title: "getComputedStyle", about: "API to get the current computed CSS styles applied to an element. This may be the current value applied by an animation or as set by a stylesheet.", link: "https://caniuse.com/getcomputedstyle", group: "CSS", area: "css-cascade", chrome: "11", firefox: "4", safari: "5" },
    Feature { id: "getrandomvalues", title: "crypto.getRandomValues()", about: "Method of generating cryptographically random values.", link: "https://caniuse.com/getrandomvalues", group: "JavaScript APIs", area: "javascript-apis", chrome: "11", firefox: "21", safari: "6.1" },
    Feature { id: "gyroscope", title: "Gyroscope", about: "Defines a concrete sensor interface to monitor the rate of rotation around the device’s local three primary axes.", link: "https://caniuse.com/gyroscope", group: "JavaScript APIs", area: "javascript-apis", chrome: "67", firefox: "", safari: "" },
    Feature { id: "hardwareconcurrency", title: "navigator.hardwareConcurrency", about: "Returns the number of logical cores of the user's CPU. The value may be reduced to prevent device fingerprinting or because it exceeds the allowed number of simultaneous web workers.", link: "https://caniuse.com/hardwareconcurrency", group: "JavaScript APIs", area: "javascript-apis", chrome: "37", firefox: "48", safari: "15.4" },
    Feature { id: "hashchange", title: "Hashchange event", about: "Event triggered in JavaScript when the URL's hash has changed (for example: page.html#foo to page.html#bar)", link: "https://caniuse.com/hashchange", group: "JavaScript APIs", area: "javascript-apis", chrome: "5", firefox: "3.6", safari: "5" },
    Feature { id: "high-resolution-time", title: "High Resolution Time API", about: "Method to provide the current time in sub-millisecond resolution and such that it is not subject to system clock skew or adjustments. Called using `performance.now()`", link: "https://caniuse.com/high-resolution-time", group: "JavaScript APIs", area: "javascript-apis", chrome: "20", firefox: "15", safari: "8" },
    Feature { id: "imagecapture", title: "ImageCapture API", about: "The Image Capture API provides access to the Video Camera for taking photos while configuring picture-specific settings such as e.g. zoom or auto focus metering area.", link: "https://caniuse.com/imagecapture", group: "JavaScript APIs", area: "javascript-apis", chrome: "59", firefox: "", safari: "" },
    Feature { id: "ime", title: "Input Method Editor API", about: "Provides scripted access to the Input Method Editor (IME). An IME is often used to input characters from East Asian languages by typing roman characters and selecting from the resulting suggestions.", link: "https://caniuse.com/ime", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "import-maps", title: "Import maps", about: "Import maps allow control over what URLs get fetched by JavaScript `import` statements and `import()` expressions.", link: "https://caniuse.com/import-maps", group: "JavaScript", area: "javascript", chrome: "89", firefox: "108", safari: "16.4" },
    Feature { id: "indexeddb", title: "IndexedDB", about: "Method of storing data client-side, allows indexed database queries.", link: "https://caniuse.com/indexeddb", group: "JavaScript APIs", area: "javascript-apis", chrome: "23", firefox: "10", safari: "15" },
    Feature { id: "indexeddb2", title: "IndexedDB 2.0", about: "Improvements to Indexed DB, including getAll(), renaming stores and indexes, and binary keys.", link: "https://caniuse.com/indexeddb2", group: "JavaScript APIs", area: "javascript-apis", chrome: "58", firefox: "51", safari: "10.1" },
    Feature { id: "inline-block", title: "CSS inline-block", about: "Method of displaying an element as a block while flowing it with text.", link: "https://caniuse.com/inline-block", group: "CSS", area: "css-layout", chrome: "4", firefox: "3", safari: "3.1" },
    Feature { id: "input-file-directory", title: "Directory selection from file input", about: "The `webkitdirectory` attribute on the `<input type=\"file\">` element allows entire directory with file contents (and any subdirectories) to be selected.", link: "https://caniuse.com/input-file-directory", group: "JavaScript APIs", area: "javascript-apis", chrome: "30", firefox: "50", safari: "11.1" },
    Feature { id: "input-selection", title: "Selection controls for input & textarea", about: "Controls for setting and getting text selection via `setSelectionRange()` and the `selectionStart` & `selectionEnd` properties.", link: "https://caniuse.com/input-selection", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "2", safari: "4" },
    Feature { id: "insertadjacenthtml", title: "Element.insertAdjacentHTML()", about: "Inserts a string of HTML into a specified position in the DOM relative to the given element.", link: "https://caniuse.com/insertadjacenthtml", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "8", safari: "4" },
    Feature { id: "internationalization", title: "Internationalization API", about: "Locale-sensitive collation (string comparison), number formatting, and date and time formatting.", link: "https://caniuse.com/internationalization", group: "JavaScript", area: "javascript", chrome: "24", firefox: "29", safari: "10" },
    Feature { id: "intersectionobserver", title: "IntersectionObserver", about: "API that can be used to understand the visibility and position of DOM elements relative to a containing element or to the top-level viewport. The position is delivered asynchronously and is useful for understanding the visibility of elements and implementing pre-loading and deferred loading of DOM content.", link: "https://caniuse.com/intersectionobserver", group: "JavaScript APIs", area: "javascript-apis", chrome: "58", firefox: "55", safari: "12.1" },
    Feature { id: "intersectionobserver-v2", title: "IntersectionObserver V2", about: "Iteration on the original API that also reports if the element is covered by another element or has filters applied to it. Useful for blocking clickjacking attempts or tracking ad exposure.", link: "https://caniuse.com/intersectionobserver-v2", group: "JavaScript APIs", area: "javascript-apis", chrome: "74", firefox: "", safari: "" },
    Feature { id: "intl-pluralrules", title: "Intl.PluralRules API", about: "API for plural sensitive formatting and plural language rules.", link: "https://caniuse.com/intl-pluralrules", group: "JavaScript", area: "javascript", chrome: "63", firefox: "58", safari: "13" },
    Feature { id: "intrinsic-width", title: "Intrinsic & Extrinsic Sizing", about: "Allows for the heights and widths to be specified in intrinsic values using the `max-content`, `min-content`, `fit-content` and `stretch` (formerly `fill`) properties.", link: "https://caniuse.com/intrinsic-width", group: "CSS", area: "css-layout", chrome: "22", firefox: "", safari: "16.0" },
    Feature { id: "js-regexp-lookbehind", title: "Lookbehind in JS regular expressions", about: "The positive lookbehind (`(?<= )`) and negative lookbehind (`(?<! )`) zero-width assertions in JavaScript regular expressions can be used to ensure a pattern is preceded by another pattern.", link: "https://caniuse.com/js-regexp-lookbehind", group: "JavaScript", area: "javascript", chrome: "62", firefox: "78", safari: "16.4" },
    Feature { id: "json", title: "JSON parsing", about: "Method of converting JavaScript objects to JSON strings and JSON back to objects using JSON.stringify() and JSON.parse()", link: "https://caniuse.com/json", group: "JavaScript", area: "javascript", chrome: "4", firefox: "3.5", safari: "4" },
    Feature { id: "justify-content-space-evenly", title: "CSS justify-content: space-evenly", about: "The \"space-evenly\" value for the `justify-content` property distributes the space between items evenly. It is similar to space-around but provides equal instead of half-sized space on the edges. Can be used in both CSS flexbox & grid.", link: "https://caniuse.com/justify-content-space-evenly", group: "CSS", area: "css-layout", chrome: "60", firefox: "52", safari: "11" },
    Feature { id: "kerning-pairs-ligatures", title: "High-quality kerning pairs & ligatures", about: "When used in HTML, the unofficial `text-rendering: optimizeLegibility` CSS property enables high-quality kerning and ligatures in certain browsers. Newer browsers have this behavior enabled by default.", link: "https://caniuse.com/kerning-pairs-ligatures", group: "CSS", area: "css-text", chrome: "4", firefox: "3", safari: "5" },
    Feature { id: "let", title: "let", about: "Declares a variable with block level scope", link: "https://caniuse.com/let", group: "JavaScript", area: "javascript", chrome: "49", firefox: "44", safari: "11" },
    Feature { id: "link-icon-svg", title: "SVG favicons", about: "Icon used by browsers to identify a webpage or site. While all browsers support the `.ico` format, the SVG format can be preferable to more easily support higher resolutions or larger icons.", link: "https://caniuse.com/link-icon-svg", group: "SVG", area: "svg", chrome: "80", firefox: "41", safari: "26.0" },
    Feature { id: "localecompare", title: "localeCompare()", about: "The `localeCompare()` method returns a number indicating whether a reference string comes before or after or is the same as the given string in sort order.", link: "https://caniuse.com/localecompare", group: "JavaScript", area: "javascript", chrome: "24", firefox: "29", safari: "10" },
    Feature { id: "magnetometer", title: "Magnetometer", about: "Defines a concrete sensor interface to measure magnetic field in the X, Y and Z axis.", link: "https://caniuse.com/magnetometer", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "matchesselector", title: "matches() DOM method", about: "Method of testing whether or not a DOM element matches a given selector. Formerly known (and largely supported with prefix) as matchesSelector.", link: "https://caniuse.com/matchesselector", group: "JavaScript APIs", area: "javascript-apis", chrome: "34", firefox: "34", safari: "7.1" },
    Feature { id: "matchmedia", title: "matchMedia", about: "API for finding out whether or not a media query applies to the document.", link: "https://caniuse.com/matchmedia", group: "JavaScript APIs", area: "javascript-apis", chrome: "9", firefox: "6", safari: "5.1" },
    Feature { id: "maxlength", title: "maxlength attribute for input and textarea elements", about: "Declares an upper bound on the number of characters the user can input. Normally the UI ignores attempts by the user to type in additional characters beyond this limit.", link: "https://caniuse.com/maxlength", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "4", safari: "5.1" },
    Feature { id: "mediacapture-fromelement", title: "Media Capture from DOM Elements API", about: "API to capture Real-Time video and audio from a DOM element, such as a `<video>`, `<audio>`, or `<canvas>` element via the `captureStream` method, in the form of a `MediaStream`", link: "https://caniuse.com/mediacapture-fromelement", group: "JavaScript APIs", area: "javascript-apis", chrome: "62", firefox: "", safari: "" },
    Feature { id: "mediarecorder", title: "MediaRecorder API", about: "The MediaRecorder API (MediaStream Recording) aims to provide a really simple mechanism by which developers can record media streams from the user's input devices and instantly use them in web apps, rather than having to perform manual encoding operations on raw PCM data, etc.", link: "https://caniuse.com/mediarecorder", group: "JavaScript APIs", area: "javascript-apis", chrome: "49", firefox: "29", safari: "14.1" },
    Feature { id: "mediasource", title: "Media Source Extensions", about: "API allowing media data to be accessed from HTML `video` and `audio` elements.", link: "https://caniuse.com/mediasource", group: "JavaScript APIs", area: "javascript-apis", chrome: "23", firefox: "42", safari: "8" },
    Feature { id: "midi", title: "Web MIDI API", about: "The Web MIDI API specification defines a means for web developers to enumerate, manipulate and access MIDI devices", link: "https://caniuse.com/midi", group: "JavaScript APIs", area: "javascript-apis", chrome: "43", firefox: "108", safari: "" },
    Feature { id: "minmaxwh", title: "CSS min/max-width/height", about: "Method of setting a minimum or maximum width or height to an element.", link: "https://caniuse.com/minmaxwh", group: "CSS", area: "css-layout", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "multibackgrounds", title: "CSS3 Multiple backgrounds", about: "Method of using multiple images as a background", link: "https://caniuse.com/multibackgrounds", group: "CSS", area: "css-paint", chrome: "4", firefox: "3.6", safari: "3.1" },
    Feature { id: "multicolumn", title: "CSS3 Multiple column layout", about: "Method of flowing information in multiple columns", link: "https://caniuse.com/multicolumn", group: "CSS", area: "css-layout", chrome: "", firefox: "", safari: "10" },
    Feature { id: "mutationobserver", title: "Mutation Observer", about: "Method for observing and reacting to changes to the DOM. Replaces MutationEvents, which is deprecated.", link: "https://caniuse.com/mutationobserver", group: "JavaScript APIs", area: "javascript-apis", chrome: "18", firefox: "14", safari: "6" },
    Feature { id: "namevalue-storage", title: "Web Storage - name/value pairs", about: "Method of storing data locally like cookies, but for larger amounts of data (sessionStorage and localStorage, used to fall under HTML5).", link: "https://caniuse.com/namevalue-storage", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "3.5", safari: "4" },
    Feature { id: "native-filesystem-api", title: "File System Access API", about: "API for manipulating files in the device's local file system (not in a sandbox).", link: "https://caniuse.com/native-filesystem-api", group: "JavaScript APIs", area: "javascript-apis", chrome: "105", firefox: "", safari: "" },
    Feature { id: "nav-timing", title: "Navigation Timing API", about: "API for accessing timing information related to navigation and elements.", link: "https://caniuse.com/nav-timing", group: "JavaScript APIs", area: "javascript-apis", chrome: "6", firefox: "7", safari: "8" },
    Feature { id: "netinfo", title: "Network Information API", about: "The Network Information API enables web applications to access information about the network connection in use by the device. Accessed via `navigator.connection`", link: "https://caniuse.com/netinfo", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "notifications", title: "Web Notifications", about: "Method of alerting the user outside of a web page by displaying notifications (that do not require interaction by the user).", link: "https://caniuse.com/notifications", group: "JavaScript APIs", area: "javascript-apis", chrome: "22", firefox: "22", safari: "6" },
    Feature { id: "object-entries", title: "Object.entries", about: "The `Object.entries()` method creates a multi-dimensional array of key value pairs from the given object.", link: "https://caniuse.com/object-entries", group: "JavaScript", area: "javascript", chrome: "54", firefox: "47", safari: "10.1" },
    Feature { id: "object-fit", title: "CSS3 object-fit/object-position", about: "Method of specifying how an object (image or video) should fit inside its box. object-fit options include \"contain\" (fit according to aspect ratio), \"fill\" (stretches object to fill) and \"cover\" (overflows box but maintains ratio), where object-position allows the object to be repositioned like background-image does.", link: "https://caniuse.com/object-fit", group: "CSS", area: "css-paint", chrome: "32", firefox: "36", safari: "10" },
    Feature { id: "object-observe", title: "Object.observe data binding", about: "Method for data binding, a now-withdrawn ECMAScript 7 proposal", link: "https://caniuse.com/object-observe", group: "JavaScript", area: "javascript", chrome: "", firefox: "", safari: "" },
    Feature { id: "object-values", title: "Object.values method", about: "The `Object.values()` method returns an array of a given object's own enumerable property values.", link: "https://caniuse.com/object-values", group: "JavaScript", area: "javascript", chrome: "54", firefox: "47", safari: "10.1" },
    Feature { id: "objectrtc", title: "Object RTC (ORTC) API for WebRTC", about: "Enables mobile endpoints to talk to servers and web browsers with Real-Time Communications (RTC) capabilities via native and simple JavaScript APIs", link: "https://caniuse.com/objectrtc", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "online-status", title: "Online/offline status", about: "Events to indicate when the user's connected (`online` and `offline` events) and the `navigator.onLine` property to see current status.", link: "https://caniuse.com/online-status", group: "JavaScript APIs", area: "javascript-apis", chrome: "14", firefox: "41", safari: "5" },
    Feature { id: "orientation-sensor", title: "Orientation Sensor", about: "Defines a base orientation sensor interface and concrete sensor subclasses to monitor the device’s physical orientation in relation to a stationary three dimensional Cartesian coordinate system.", link: "https://caniuse.com/orientation-sensor", group: "JavaScript APIs", area: "javascript-apis", chrome: "67", firefox: "", safari: "" },
    Feature { id: "outline", title: "CSS outline properties", about: "The CSS outline properties draw a border around an element that does not affect layout, making it ideal for highlighting. This covers the `outline` shorthand, as well as `outline-width`, `outline-style`, `outline-color` and `outline-offset`.", link: "https://caniuse.com/outline", group: "CSS", area: "css-paint", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "pad-start-end", title: "String.prototype.padStart(), String.prototype.padEnd()", about: "The `padStart()` and `padEnd()` methods pad the current string with a given string (eventually repeated) so that the resulting string reaches a given length. The pad is applied from the start (left) of the current string for `padStart()`, and applied from the end (right) of the current string for `padEnd()`.", link: "https://caniuse.com/pad-start-end", group: "JavaScript", area: "javascript", chrome: "57", firefox: "48", safari: "10" },
    Feature { id: "page-transition-events", title: "PageTransitionEvent", about: "Fired at the Window when the page's entry in the session history stops being the current entry. Includes the `pageshow` and `pagehide` events.", link: "https://caniuse.com/page-transition-events", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "2", safari: "5" },
    Feature { id: "pagevisibility", title: "Page Visibility", about: "JavaScript API for determining whether a document is visible on the display", link: "https://caniuse.com/pagevisibility", group: "JavaScript APIs", area: "javascript-apis", chrome: "14", firefox: "10", safari: "6.1" },
    Feature { id: "passkeys", title: "Passkeys", about: "Passkeys, also known as Multi-device FIDO Credentials, provide users with an alternative to passwords that is much easier to use and far more secure.", link: "https://caniuse.com/passkeys", group: "JavaScript APIs", area: "javascript-apis", chrome: "108", firefox: "122", safari: "16.1" },
    Feature { id: "payment-request", title: "Payment Request API", about: "Payment Request is a new API for the open web that makes checkout flows easier, faster and consistent on shopping sites.", link: "https://caniuse.com/payment-request", group: "JavaScript APIs", area: "javascript-apis", chrome: "78", firefox: "", safari: "12.1" },
    Feature { id: "permissions-api", title: "Permissions API", about: "High-level JavaScript API for checking and requesting permissions", link: "https://caniuse.com/permissions-api", group: "JavaScript APIs", area: "javascript-apis", chrome: "43", firefox: "46", safari: "16.0" },
    Feature { id: "permissions-policy", title: "Permissions Policy", about: "A security mechanism that allows developers to explicitly enable or disable various powerful browser features for a given site. Similar to [Document Policy](/document-policy).", link: "https://caniuse.com/permissions-policy", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "picture-in-picture", title: "Picture-in-Picture", about: "Allows websites to create a floating video window that is always on top of other windows so that users may continue consuming media while they interact with other sites or applications on their device.", link: "https://caniuse.com/picture-in-picture", group: "JavaScript APIs", area: "javascript-apis", chrome: "70", firefox: "153", safari: "13.1" },
    Feature { id: "pointer", title: "Pointer events", about: "This specification integrates various inputs from mice, touchscreens, and pens, making separate implementations no longer necessary and authoring for cross-device pointers easier. Not to be mistaken with the unrelated \"pointer-events\" CSS property.", link: "https://caniuse.com/pointer", group: "CSS", area: "css-paint", chrome: "55", firefox: "59", safari: "13" },
    Feature { id: "pointer-events", title: "CSS pointer-events (for HTML)", about: "This CSS property, when set to \"none\" allows elements to not receive hover/click events, instead the event will occur on anything behind it.", link: "https://caniuse.com/pointer-events", group: "CSS", area: "css-paint", chrome: "4", firefox: "3.6", safari: "4" },
    Feature { id: "pointerlock", title: "Pointer Lock API", about: "API that provides access to raw mouse movement data. This is done by ignoring boundaries resulting from screen edges where the cursor can't go beyond, providing proper control for first person or real time strategy games.", link: "https://caniuse.com/pointerlock", group: "JavaScript APIs", area: "javascript-apis", chrome: "22", firefox: "14", safari: "10.1" },
    Feature { id: "portals", title: "Portals", about: "Portals enable seamless navigation between sites or pages. A new page can be loaded as an inset using the `<portal>` element (similar to an iframe) which can then seamlessly transition to the new navigated state when \"activated\".", link: "https://caniuse.com/portals", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "prefers-color-scheme", title: "prefers-color-scheme media query", about: "Media query to detect if the user has set their system to use a light or dark color theme.", link: "https://caniuse.com/prefers-color-scheme", group: "CSS", area: "css-cascade", chrome: "76", firefox: "67", safari: "12.1" },
    Feature { id: "prefers-reduced-motion", title: "prefers-reduced-motion media query", about: "CSS media query based on a user preference for preferring reduced motion (animation, etc).", link: "https://caniuse.com/prefers-reduced-motion", group: "CSS", area: "css-cascade", chrome: "74", firefox: "63", safari: "10.1" },
    Feature { id: "promise-finally", title: "Promise.prototype.finally", about: "When the promise is settled, whether fulfilled or rejected, the specified callback function is executed.", link: "https://caniuse.com/promise-finally", group: "JavaScript", area: "javascript", chrome: "63", firefox: "58", safari: "11.1" },
    Feature { id: "promises", title: "Promises", about: "A promise represents the eventual result of an asynchronous operation.", link: "https://caniuse.com/promises", group: "JavaScript", area: "javascript", chrome: "33", firefox: "29", safari: "7.1" },
    Feature { id: "proximity", title: "Proximity API", about: "Defines events that provide information about the distance between a device and an object, as measured by a proximity sensor.", link: "https://caniuse.com/proximity", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "15", safari: "" },
    Feature { id: "proxy", title: "Proxy object", about: "The Proxy object allows custom behavior to be defined for fundamental operations. Useful for logging, profiling, object visualization, etc.", link: "https://caniuse.com/proxy", group: "JavaScript", area: "javascript", chrome: "49", firefox: "18", safari: "10" },
    Feature { id: "push-api", title: "Push API", about: "API to allow messages to be pushed from a server to a browser, even when the site isn't focused or even open in the browser.", link: "https://caniuse.com/push-api", group: "JavaScript APIs", area: "javascript-apis", chrome: "50", firefox: "44", safari: "18.0" },
    Feature { id: "rem", title: "rem (root em) units", about: "Type of unit similar to `em`, but relative only to the root element, not any parent element. Thus compounding does not occur as it does with `em` units.", link: "https://caniuse.com/rem", group: "CSS", area: "css-text", chrome: "4", firefox: "3.6", safari: "5" },
    Feature { id: "requestanimationframe", title: "requestAnimationFrame", about: "API allowing a more efficient way of running script-based animation, compared to traditional methods using timeouts. Also covers support for `cancelAnimationFrame`", link: "https://caniuse.com/requestanimationframe", group: "JavaScript APIs", area: "javascript-apis", chrome: "22", firefox: "11", safari: "6" },
    Feature { id: "requestidlecallback", title: "requestIdleCallback", about: "API allowing the execution of JavaScript to be queued to run in idle browser time, either at the end of a frame or when the user is inactive. Also covers support for `cancelIdleCallback`. The API has similarities with `requestAnimationFrame`.", link: "https://caniuse.com/requestidlecallback", group: "JavaScript APIs", area: "javascript-apis", chrome: "47", firefox: "55", safari: "TP" },
    Feature { id: "resizeobserver", title: "Resize Observer", about: "Method for observing and reacting to changes to sizes of DOM elements.", link: "https://caniuse.com/resizeobserver", group: "JavaScript APIs", area: "javascript-apis", chrome: "64", firefox: "69", safari: "13.1" },
    Feature { id: "resource-timing", title: "Resource Timing (basic support)", about: "Method to help web developers to collect complete timing information related to resources on a document.", link: "https://caniuse.com/resource-timing", group: "JavaScript APIs", area: "javascript-apis", chrome: "25", firefox: "35", safari: "11.1" },
    Feature { id: "rest-parameters", title: "Rest parameters", about: "Allows representation of an indefinite number of arguments as an array.", link: "https://caniuse.com/rest-parameters", group: "JavaScript", area: "javascript", chrome: "47", firefox: "15", safari: "10" },
    Feature { id: "rtcpeerconnection", title: "WebRTC Peer-to-peer connections", about: "Method of allowing two users to communicate directly, browser to browser using the RTCPeerConnection API.", link: "https://caniuse.com/rtcpeerconnection", group: "JavaScript APIs", area: "javascript-apis", chrome: "23", firefox: "22", safari: "11" },
    Feature { id: "run-in", title: "display: run-in", about: "If the run-in box contains a block box, same as block. If a block box follows the run-in box, the run-in box becomes the first inline box of the block box. If an inline box follows, the run-in box becomes a block box.", link: "https://caniuse.com/run-in", group: "CSS", area: "css-layout", chrome: "", firefox: "", safari: "" },
    Feature { id: "screen-orientation", title: "Screen Orientation", about: "Provides the ability to read the screen orientation state, to be informed when this state changes, and to be able to lock the screen orientation to a specific state.", link: "https://caniuse.com/screen-orientation", group: "JavaScript APIs", area: "javascript-apis", chrome: "38", firefox: "44", safari: "16.4" },
    Feature { id: "scrollintoview", title: "scrollIntoView", about: "The `Element.scrollIntoView()` method scrolls the current element into the visible area of the browser window. Parameters can be provided to set the position inside the visible area as well as whether scrolling should be instant or smooth.", link: "https://caniuse.com/scrollintoview", group: "JavaScript APIs", area: "javascript-apis", chrome: "61", firefox: "36", safari: "16.0" },
    Feature { id: "scrollintoviewifneeded", title: "Element.scrollIntoViewIfNeeded()", about: "If the element is fully within the visible area of the viewport, it does nothing. Otherwise, the element is scrolled into view. A proprietary variant of the standard `Element.scrollIntoView()` method.", link: "https://caniuse.com/scrollintoviewifneeded", group: "JavaScript APIs", area: "javascript-apis", chrome: "15", firefox: "", safari: "5.1" },
    Feature { id: "selection-api", title: "Selection API", about: "API for accessing selected content of a document, including the `window.getSelection()` method, as well as the `selectstart` & `selectionchange` events on `document`.", link: "https://caniuse.com/selection-api", group: "JavaScript APIs", area: "javascript-apis", chrome: "15", firefox: "52", safari: "5.1" },
    Feature { id: "server-timing", title: "Server Timing", about: "Mechanism for web developers to annotate network requests with server timing information.", link: "https://caniuse.com/server-timing", group: "JavaScript APIs", area: "javascript-apis", chrome: "65", firefox: "61", safari: "16.4" },
    Feature { id: "serviceworkers", title: "Service Workers", about: "Method that enables applications to take advantage of persistent background processing, including hooks to enable bootstrapping of web applications while offline.", link: "https://caniuse.com/serviceworkers", group: "JavaScript APIs", area: "javascript-apis", chrome: "45", firefox: "44", safari: "11.1" },
    Feature { id: "setimmediate", title: "Efficient Script Yielding: setImmediate()", about: "Yields control flow without the minimum delays enforced by setTimeout", link: "https://caniuse.com/setimmediate", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "sharedarraybuffer", title: "Shared Array Buffer", about: "Type of ArrayBuffer that can be shared across Workers.", link: "https://caniuse.com/sharedarraybuffer", group: "JavaScript", area: "javascript", chrome: "68", firefox: "79", safari: "15.2-15.3" },
    Feature { id: "sharedworkers", title: "Shared Web Workers", about: "Method of allowing multiple scripts to communicate with a single web worker.", link: "https://caniuse.com/sharedworkers", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "29", safari: "16.0" },
    Feature { id: "speech-recognition", title: "Speech Recognition API", about: "Method to provide speech input in a web browser.", link: "https://caniuse.com/speech-recognition", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "speech-synthesis", title: "Speech Synthesis API", about: "A web API for controlling a text-to-speech output.", link: "https://caniuse.com/speech-synthesis", group: "JavaScript APIs", area: "javascript-apis", chrome: "33", firefox: "49", safari: "7" },
    Feature { id: "sql-storage", title: "Web SQL Database", about: "Method of storing data client-side, allows SQLite database queries for access and manipulation.", link: "https://caniuse.com/sql-storage", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "stream", title: "getUserMedia/Stream API", about: "Method of accessing external device data (such as a webcam video stream). Formerly this was envisioned as the <device> element.", link: "https://caniuse.com/stream", group: "JavaScript APIs", area: "javascript-apis", chrome: "53", firefox: "36", safari: "11" },
    Feature { id: "streams", title: "Streams", about: "Method of creating, composing, and consuming streams of data, that map efficiently to low-level I/O primitives, and allow easy composition with built-in backpressure and queuing.", link: "https://caniuse.com/streams", group: "JavaScript APIs", area: "javascript-apis", chrome: "89", firefox: "102", safari: "" },
    Feature { id: "style-scoped", title: "Scoped attribute", about: "Deprecated method of allowing scoped CSS styles using a \"scoped\" attribute. Now [removed from the specification](https://github.com/whatwg/html/issues/552) and replaced by the [@scope CSS rule](/css-cascade-scope).", link: "https://caniuse.com/style-scoped", group: "CSS", area: "css-cascade", chrome: "", firefox: "", safari: "" },
    Feature { id: "svg", title: "SVG (basic support)", about: "Method of displaying basic Vector Graphics features using the embed or object elements. Refers to the SVG 1.1 spec.", link: "https://caniuse.com/svg", group: "SVG", area: "svg", chrome: "4", firefox: "3", safari: "3.2" },
    Feature { id: "svg-css", title: "SVG in CSS backgrounds", about: "Method of using SVG images as CSS backgrounds", link: "https://caniuse.com/svg-css", group: "CSS", area: "css-cascade", chrome: "5", firefox: "24", safari: "5" },
    Feature { id: "svg-filters", title: "SVG filters", about: "Method of using Photoshop-like effects on SVG objects including blurring and color manipulation.", link: "https://caniuse.com/svg-filters", group: "SVG", area: "svg", chrome: "8", firefox: "3", safari: "6" },
    Feature { id: "svg-fonts", title: "SVG fonts", about: "Method of using fonts defined as SVG shapes. Removed from [SVG 2.0](https://www.w3.org/TR/SVG2/changes.html#fonts) and considered as a deprecated feature with support being removed from browsers.", link: "https://caniuse.com/svg-fonts", group: "SVG", area: "svg", chrome: "", firefox: "", safari: "3.2" },
    Feature { id: "svg-fragment", title: "SVG fragment identifiers", about: "Method of displaying only a part of an SVG image by defining a view ID or view box dimensions as the file's fragment identifier.", link: "https://caniuse.com/svg-fragment", group: "SVG", area: "svg", chrome: "50", firefox: "15", safari: "11.1" },
    Feature { id: "svg-html", title: "SVG effects for HTML", about: "Method of using SVG transforms, filters, etc on HTML elements using either CSS or the foreignObject element", link: "https://caniuse.com/svg-html", group: "SVG", area: "svg", chrome: "", firefox: "3.5", safari: "" },
    Feature { id: "svg-html5", title: "Inline SVG in HTML5", about: "Method of using SVG tags directly in HTML documents. Requires HTML5 parser.", link: "https://caniuse.com/svg-html5", group: "SVG", area: "svg", chrome: "7", firefox: "4", safari: "5.1" },
    Feature { id: "svg-img", title: "SVG in HTML img element", about: "Method of displaying SVG images in HTML using <img>.", link: "https://caniuse.com/svg-img", group: "SVG", area: "svg", chrome: "28", firefox: "4", safari: "9" },
    Feature { id: "svg-smil", title: "SVG SMIL animation", about: "Method of using animation elements to animate SVG images", link: "https://caniuse.com/svg-smil", group: "SVG", area: "svg", chrome: "5", firefox: "4", safari: "6" },
    Feature { id: "template-literals", title: "ES6 Template Literals (Template Strings)", about: "Template literals are string literals allowing embedded expressions using backtick characters (`). You can use multi-line strings and string interpolation features with them. Formerly known as template strings.", link: "https://caniuse.com/template-literals", group: "JavaScript", area: "javascript", chrome: "41", firefox: "34", safari: "9.1" },
    Feature { id: "temporal", title: "Temporal", about: "A modern API for working with date and time, meant to supersede the original `Date` API.", link: "https://caniuse.com/temporal", group: "JavaScript", area: "javascript", chrome: "144", firefox: "139", safari: "TP" },
    Feature { id: "text-decoration", title: "text-decoration styling", about: "Method of defining the type, style and color of lines in the text-decoration property. These can be defined as shorthand (e.g. `text-decoration: line-through dashed blue`) or as single properties (e.g. `text-decoration-color: blue`)", link: "https://caniuse.com/text-decoration", group: "CSS", area: "css-text", chrome: "", firefox: "", safari: "" },
    Feature { id: "text-emphasis", title: "text-emphasis styling", about: "Method of using small symbols next to each glyph to emphasize a run of text, commonly used in East Asian languages. The `text-emphasis` shorthand, and its `text-emphasis-style` and `text-emphasis-color` longhands, can be used to apply marks to the text. The `text-emphasis-position` property, which inherits separately, allows setting the emphasis marks' position with respect to the text.", link: "https://caniuse.com/text-emphasis", group: "CSS", area: "css-text", chrome: "99", firefox: "46", safari: "7.1" },
    Feature { id: "text-overflow", title: "CSS3 Text-overflow", about: "Append ellipsis when text overflows its containing element", link: "https://caniuse.com/text-overflow", group: "CSS", area: "css-text", chrome: "4", firefox: "7", safari: "3.1" },
    Feature { id: "text-size-adjust", title: "CSS text-size-adjust", about: "On mobile devices, the text-size-adjust CSS property allows Web authors to control if and how the text-inflating algorithm is applied to the textual content of the element it is applied to.", link: "https://caniuse.com/text-size-adjust", group: "CSS", area: "css-text", chrome: "54", firefox: "", safari: "" },
    Feature { id: "text-stroke", title: "CSS text-stroke and text-fill", about: "Method of declaring the outline (stroke) width and color for text.", link: "https://caniuse.com/text-stroke", group: "CSS", area: "css-text", chrome: "4", firefox: "49", safari: "3.1" },
    Feature { id: "textencoder", title: "TextEncoder & TextDecoder", about: "`TextEncoder` encodes a JavaScript string into bytes using the UTF-8 encoding and returns the resulting `Uint8Array` of those bytes. `TextDecoder` does the reverse.", link: "https://caniuse.com/textencoder", group: "JavaScript APIs", area: "javascript-apis", chrome: "38", firefox: "20", safari: "10.1" },
    Feature { id: "touch", title: "Touch events", about: "Method of registering when, where and how the interface is touched, for devices with a touch screen. These DOM events are similar to mousedown, mousemove, etc.", link: "https://caniuse.com/touch", group: "JavaScript APIs", area: "javascript-apis", chrome: "22", firefox: "52", safari: "" },
    Feature { id: "transforms2d", title: "CSS3 2D Transforms", about: "Method of transforming an element including rotating, scaling, etc. Includes support for `transform` as well as `transform-origin` properties.", link: "https://caniuse.com/transforms2d", group: "CSS", area: "css-paint", chrome: "4", firefox: "3.5", safari: "3.1" },
    Feature { id: "transforms3d", title: "CSS3 3D Transforms", about: "Method of transforming an element in the third dimension using the `transform` property. Includes support for the `perspective` property to set the perspective in z-space and the `backface-visibility` property to toggle display of the reverse side of a 3D-transformed element.", link: "https://caniuse.com/transforms3d", group: "CSS", area: "css-paint", chrome: "12", firefox: "10", safari: "4" },
    Feature { id: "trusted-types", title: "Trusted Types for DOM manipulation", about: "An API that forces developers to be very explicit about their use of powerful DOM-injection APIs. Can greatly improve security against XSS attacks.", link: "https://caniuse.com/trusted-types", group: "JavaScript APIs", area: "javascript-apis", chrome: "83", firefox: "148", safari: "26.0" },
    Feature { id: "ttf", title: "TTF/OTF - TrueType and OpenType font support", about: "Support for the TrueType (.ttf) and OpenType (.otf) outline font formats in @font-face.", link: "https://caniuse.com/ttf", group: "CSS", area: "css-text", chrome: "4", firefox: "3.5", safari: "3.1" },
    Feature { id: "typedarrays", title: "Typed Arrays", about: "JavaScript typed arrays provide a mechanism for accessing raw binary data much more efficiently. Includes: `Int8Array`, `Uint8Array`, `Uint8ClampedArray`, `Int16Array`, `Uint16Array`, `Int32Array`, `Uint32Array`, `Float32Array` & `Float64Array`", link: "https://caniuse.com/typedarrays", group: "JavaScript", area: "javascript", chrome: "7", firefox: "4", safari: "6" },
    Feature { id: "u2f", title: "FIDO U2F API", about: "JavaScript API to interact with Universal Second Factor (U2F) devices. This allows users to log into sites more securely using two-factor authentication with a USB dongle.", link: "https://caniuse.com/u2f", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "13" },
    Feature { id: "unhandledrejection", title: "unhandledrejection/rejectionhandled events", about: "The `unhandledrejection` event is fired when a Promise is rejected but there is no rejection handler to deal with the rejection. The `rejectionhandled` event is fired when a Promise is rejected, and after the rejection is handled by the promise's rejection handling code.", link: "https://caniuse.com/unhandledrejection", group: "JavaScript", area: "javascript", chrome: "49", firefox: "69", safari: "11" },
    Feature { id: "url", title: "URL API", about: "API to retrieve the various parts that make up a given URL from a given URL string.", link: "https://caniuse.com/url", group: "JavaScript APIs", area: "javascript-apis", chrome: "32", firefox: "26", safari: "7.1" },
    Feature { id: "urlsearchparams", title: "URLSearchParams", about: "The URLSearchParams interface defines utility methods to work with the query string of a URL.", link: "https://caniuse.com/urlsearchparams", group: "JavaScript APIs", area: "javascript-apis", chrome: "49", firefox: "44", safari: "10.1" },
    Feature { id: "use-strict", title: "ECMAScript 5 Strict Mode", about: "Method of placing code in a \"strict\" operating context.", link: "https://caniuse.com/use-strict", group: "JavaScript", area: "javascript", chrome: "13", firefox: "4", safari: "6" },
    Feature { id: "user-select-none", title: "CSS user-select: none", about: "Method of preventing text/element selection using CSS.", link: "https://caniuse.com/user-select-none", group: "CSS", area: "css-paint", chrome: "4", firefox: "2", safari: "3.1" },
    Feature { id: "user-timing", title: "User Timing API", about: "Method to help web developers measure the performance of their applications by giving them access to high precision timestamps.", link: "https://caniuse.com/user-timing", group: "JavaScript APIs", area: "javascript-apis", chrome: "25", firefox: "38", safari: "11" },
    Feature { id: "variable-fonts", title: "Variable fonts", about: "OpenType font settings that allows a single font file to behave like multiple fonts: it can contain all the allowed variations in width, weight, slant, optical size, or any other exposed axes of variation as defined by the font designer. Variations can be applied via the `font-variation-settings` property.", link: "https://caniuse.com/variable-fonts", group: "CSS", area: "css-text", chrome: "66", firefox: "62", safari: "11" },
    Feature { id: "vector-effect", title: "SVG vector-effect: non-scaling-stroke", about: "The `non-scaling-stroke` value for the `vector-effect` SVG attribute/CSS property makes strokes appear as the same width regardless of any transformations applied.", link: "https://caniuse.com/vector-effect", group: "SVG", area: "svg", chrome: "15", firefox: "15", safari: "5.1" },
    Feature { id: "vibration", title: "Vibration API", about: "Method to access the vibration mechanism of the hosting device.", link: "https://caniuse.com/vibration", group: "JavaScript APIs", area: "javascript-apis", chrome: "30", firefox: "", safari: "" },
    Feature { id: "view-transitions", title: "View Transitions API (single-document)", about: "Provides a mechanism for easily creating animated transitions between different DOM states, while also updating the DOM contents in a single step. This API is specific to single-document transitions.", link: "https://caniuse.com/view-transitions", group: "CSS", area: "css-paint", chrome: "111", firefox: "144", safari: "18.0" },
    Feature { id: "viewport-unit-variants", title: "Small, Large, and Dynamic viewport units", about: "Viewport units similar to `vw` and `vh` that are based on shown or hidden browser UI states to address shortcomings of the original units. Currently defined as the `sv*` units (`svb`, `svh`, `svi`, `svmax`, `svmin`, `svw`), `lv*` units (`lvb`, `lvh`, `lvi`, `lvmax`, `lvmin`, `lvw`), `dv*` units (`dvb`, `dvh`, `dvi`, `dvmax`, `dvmin`, `dvw`) and the logical `vi`/`vb` units.", link: "https://caniuse.com/viewport-unit-variants", group: "CSS", area: "css-layout", chrome: "108", firefox: "101", safari: "15.4" },
    Feature { id: "viewport-units", title: "Viewport units: vw, vh, vmin, vmax", about: "Length units representing a percentage of the current viewport dimensions: width (vw), height (vh), the smaller of the two (vmin), or the larger of the two (vmax).", link: "https://caniuse.com/viewport-units", group: "CSS", area: "css-layout", chrome: "26", firefox: "19", safari: "6.1" },
    Feature { id: "wake-lock", title: "Screen Wake Lock API", about: "API to prevent devices from dimming, locking or turning off the screen when the application needs to keep running.", link: "https://caniuse.com/wake-lock", group: "JavaScript APIs", area: "javascript-apis", chrome: "84", firefox: "126", safari: "16.4" },
    Feature { id: "web-animation", title: "Web Animations API", about: "Lets you create animations that are run in the browser, as well as inspect and manipulate animations created through declarative means like CSS.", link: "https://caniuse.com/web-animation", group: "JavaScript APIs", area: "javascript-apis", chrome: "84", firefox: "75", safari: "13.1" },
    Feature { id: "web-bluetooth", title: "Web Bluetooth", about: "Allows web sites to communicate over GATT with nearby user-selected Bluetooth devices in a secure and privacy-preserving way.", link: "https://caniuse.com/web-bluetooth", group: "JavaScript APIs", area: "javascript-apis", chrome: "56", firefox: "", safari: "" },
    Feature { id: "web-serial", title: "Web Serial API", about: "Allows communication with devices via a serial interface.", link: "https://caniuse.com/web-serial", group: "JavaScript APIs", area: "javascript-apis", chrome: "89", firefox: "151", safari: "" },
    Feature { id: "web-share", title: "Web Share API", about: "A way to allow websites to invoke the native sharing capabilities of the host platform", link: "https://caniuse.com/web-share", group: "JavaScript APIs", area: "javascript-apis", chrome: "128", firefox: "", safari: "12.1" },
    Feature { id: "webcodecs", title: "WebCodecs API", about: "API to provide more control over the encoding and decoding of audio, video, and images.", link: "https://caniuse.com/webcodecs", group: "JavaScript APIs", area: "javascript-apis", chrome: "94", firefox: "130", safari: "26.0" },
    Feature { id: "webgpu", title: "WebGPU", about: "An API for complex rendering and compute, using hardware acceleration. Use cases include demanding 3D games and acceleration of scientific calculations. Meant to supersede WebGL.", link: "https://caniuse.com/webgpu", group: "JavaScript APIs", area: "javascript-apis", chrome: "113", firefox: "", safari: "" },
    Feature { id: "webhid", title: "WebHID API", about: "Enables raw access to HID (Human Interface Device) commands for all connected HIDs. Previously, an HID could only be accessed if the browser had implemented a custom API for the specific device.", link: "https://caniuse.com/webhid", group: "JavaScript APIs", area: "javascript-apis", chrome: "89", firefox: "", safari: "" },
    Feature { id: "webkit-user-drag", title: "CSS -webkit-user-drag property", about: "The non-standard `-webkit-user-drag` CSS property can be used to either make an element draggable or explicitly non-draggable (like links and images). See the standardized [draggable attribute/property](/mdn-api_htmlelement_draggable) for the recommended alternative method of accomplishing the same functionality.", link: "https://caniuse.com/webkit-user-drag", group: "CSS", area: "css-cascade", chrome: "", firefox: "", safari: "3.1" },
    Feature { id: "webnfc", title: "Web NFC", about: "This API allows a website to communicate with NFC tags through a device's NFC reader.", link: "https://caniuse.com/webnfc", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "websockets", title: "Web Sockets", about: "Bidirectional communication technology for web apps", link: "https://caniuse.com/websockets", group: "JavaScript APIs", area: "javascript-apis", chrome: "16", firefox: "11", safari: "7" },
    Feature { id: "webtransport", title: "WebTransport", about: "Protocol framework to send and receive data from servers using [HTTP3](/http3). Similar to [WebSockets](/websockets) but with support for multiple streams, unidirectional streams, out-of-order delivery, and reliable as well as unreliable transport.", link: "https://caniuse.com/webtransport", group: "JavaScript APIs", area: "javascript-apis", chrome: "97", firefox: "114", safari: "26.4" },
    Feature { id: "webusb", title: "WebUSB", about: "Allows communication with devices via USB (Universal Serial Bus).", link: "https://caniuse.com/webusb", group: "JavaScript APIs", area: "javascript-apis", chrome: "61", firefox: "", safari: "" },
    Feature { id: "webvr", title: "WebVR API", about: "API for accessing virtual reality (VR) devices, including sensors and head-mounted displays. Replaced by the [WebXR Device API](/webxr).", link: "https://caniuse.com/webvr", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "55", safari: "" },
    Feature { id: "webworkers", title: "Web Workers", about: "Method of running scripts in the background, isolated from the web page", link: "https://caniuse.com/webworkers", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "3.5", safari: "4" },
    Feature { id: "webxr", title: "WebXR Device API", about: "API for accessing virtual reality (VR) and augmented reality (AR) devices, including sensors and head-mounted displays.", link: "https://caniuse.com/webxr", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "will-change", title: "CSS will-change property", about: "Method of optimizing animations by informing the browser which elements will change and what properties will change.", link: "https://caniuse.com/will-change", group: "CSS", area: "css-paint", chrome: "36", firefox: "36", safari: "9.1" },
    Feature { id: "word-break", title: "CSS3 word-break", about: "Property to prevent or allow words to be broken over multiple lines between letters.", link: "https://caniuse.com/word-break", group: "CSS", area: "css-text", chrome: "44", firefox: "15", safari: "9" },
    Feature { id: "wordwrap", title: "CSS3 Overflow-wrap", about: "Allows lines to be broken within words if an otherwise unbreakable string is too long to fit. Currently mostly supported using the `word-wrap` property.", link: "https://caniuse.com/wordwrap", group: "CSS", area: "css-text", chrome: "23", firefox: "49", safari: "6.1" },
    Feature { id: "x-doc-messaging", title: "Cross-document messaging", about: "Method of sending information from a page on one domain to a page on a different one (using postMessage)", link: "https://caniuse.com/x-doc-messaging", group: "JavaScript APIs", area: "javascript-apis", chrome: "4", firefox: "3", safari: "4" },
    Feature { id: "xhr2", title: "XMLHttpRequest advanced features", about: "Updated functionality to the original XHR specification including things like file uploads, transfer progress information and the ability to send FormData. Previously known as [XMLHttpRequest Level 2](https://www.w3.org/TR/2012/WD-XMLHttpRequest-20120117/), these features now appear simply in the XMLHttpRequest spec.", link: "https://caniuse.com/xhr2", group: "JavaScript APIs", area: "javascript-apis", chrome: "50", firefox: "47", safari: "11.1" },
    Feature { id: "xml-serializer", title: "DOM Parsing and Serialization", about: "Various DOM parsing and serializing functions, specifically `DOMParser`, `XMLSerializer`, `innerHTML`, `outerHTML` and `insertAdjacentHTML`.", link: "https://caniuse.com/xml-serializer", group: "JavaScript APIs", area: "javascript-apis", chrome: "31", firefox: "12", safari: "7.1" },
    Feature { id: "silkui-memory-usage", title: "App memory usage (memoryUsage)", about: "memoryUsage() from @silkui/core: the app's memory in bytes as the system shows it to users (Activity Monitor, footprint, Task Manager), to show or compare with other apps.", link: "https://github.com/silk-lang/SilkUI/tree/main/modules/js/packages/core#the-desktop", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
    Feature { id: "silkui-frame-stats", title: "Presented frame stats (frameStats)", about: "frameStats() from @silkui/core: frames the window presented, presents per second, painted frames the GPU never drew, and frame time percentiles, which requestAnimationFrame cannot measure.", link: "https://github.com/silk-lang/SilkUI/tree/main/modules/js/packages/core#the-desktop", group: "JavaScript APIs", area: "javascript-apis", chrome: "", firefox: "", safari: "" },
  ]
}
