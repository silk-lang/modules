import silk.build.graph { BuildError, Compilation, Deferred, Options }
import silk.build.tasks { Standard, StandardError }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator }
import silk.num.usize
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { FileSystem, Path }
import silk.system.host_input { HostInput }
import silk.text.string { InvalidUtf8, String }

union Tasks {
  Build { pub options: Options, pub out: String },
  Run { pub options: Options, pub arguments: List<String> },
  Dev { pub options: Options, pub arguments: List<String> },
  Plan { pub options: Options },
  BuildSite { pub base: String },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Build and run the docs site")
      |> Command.variant("Build", "Build the program into build/ (--release optimizes)")
      |> Command.variant("Run", "Build the program and run it")
      |> Command.variant("Dev", "Run the program, and run it again when a source changes")
      |> Command.variant("Plan", "Write the editor's compilation requests")
      |> Command.variant("BuildSite", "Build the static docs site into docs/dist")
      |> Command.flatten("options")
      |> Command.option("out", Opt.about("Also copy the program to this directory"))
      |> Command.option("base", Opt.about("URL base path prefix, such as /docs"))
      |> Command.arg("arguments", Opt.about("The program's arguments, after --"))
  }
}

effect fn compilation(options: &Options) -> Compilation
  ! BuildError
  ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let selected = run Compilation.fromPackage(options)
  if options.target.length() == 1 {
    if String.startsWith(options.target.asSlice()[0].view(), "wasm") {
      return run selected.stackSize(run Deferred<u64>.value(8388608))
    }
  }
  return move selected
}

effect fn pathText<'a>(path: &'a Path) -> string<'a>
  ! StandardError
  ? &mut Allocator {
  return match Path.view(path) {
    Option<string>.Some { value } => value
    Option<string>.None => run Task.abort("Docs path must be UTF-8")
  }
}

effect fn copyFile(src: &Path, dst: &Path) -> ()
  ! StandardError
  ? &mut Allocator | &mut FileSystem {
  let bytes = run FileSystem.readFile(src)
  return run FileSystem.writeFile(dst, Bytes.asSlice(&bytes))
}

fn baseName<'a>(text: string<'a>) -> string<'a> {
  let bytes = String.utf8Bytes(text)
  let mut i = bytes.length
  while i > usize.ZERO {
    i = i - usize.ONE
    if bytes[i] == 47 || bytes[i] == 92 {
      let start = i + usize.ONE
      return String.slice(text, start, bytes.length - start)
    }
  }
  return text
}

effect fn copyDirRecursive(src: &Path, dst: &Path) -> ()
  ! StandardError
  ? &mut Allocator | &mut FileSystem {
  run FileSystem.createDirectoriesRecursively(dst)
  let entries = run FileSystem.listDirectory(src)
  let slice = entries.asSlice()
  let mut i = usize.ZERO
  while i < slice.length {
    let entry = &slice[i]
    let full = match Path.view(&entry.path) {
      Option<string>.Some { value } => value
      Option<string>.None => ""
    }
    let name = baseName(full)
    if name != "" {
      let target = run Path.join(dst, name)
      if entry.kind.code == FileSystem.directory().code {
        run copyDirRecursive(&entry.path, &target)
      } else {
        run copyFile(&entry.path, &target)
      }
    }
    i = i + usize.ONE
  }
}

effect fn replaceAll(text: string, needle: string, replacement: string) -> String
  ! StandardError
  ? &mut Allocator {
  let mut out = String.make()
  let mut rest = text
  let nLen = String.utf8Bytes(needle).length
  while true {
    match String.find(rest, needle) {
      Option<usize>.Some { value: idx } => {
        run String.append(&mut out, String.slice(rest, usize.ZERO, idx))
        run String.append(&mut out, replacement)
        let after = idx + nLen
        rest = String.slice(rest, after, String.utf8Bytes(rest).length - after)
      }
      Option<usize>.None => {
        run String.append(&mut out, rest)
        break
      }
    }
  }
  return move out
}

fn hostTriple() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    static if Intrinsic.targetArchitecture() == "aarch64" {
      return "aarch64-apple-darwin"
    } else {
      return "x86_64-apple-darwin"
    }
  } else {
    static if Intrinsic.targetOperatingSystem() == "windows" {
      return "x86_64-pc-windows-msvc"
    } else {
      static if Intrinsic.targetArchitecture() == "aarch64" {
        return "aarch64-unknown-linux-gnu"
      } else {
        return "x86_64-unknown-linux-gnu"
      }
    }
  }
}

fn exeSuffix() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return ".exe"
  } else {
    return ""
  }
}

effect fn buildSite(base: string) -> ()
  ! StandardError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let docsDir = run Task.root()
  let uiDir = match move run Path.parent(&docsDir) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort("silk-ui/docs has no silk-ui parent")
  }
  let repoRoot = match move run Path.parent(&uiDir) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort("silk-ui has no monorepo parent")
  }
  let buildDir = run Path.join(&repoRoot, "build")
  let wasmSizeDir = run Path.join(&buildDir, "wasm32-unknown-unknown/size")
  let hostDir = run Path.join(&buildDir, hostTriple())
  let hostDevDir = run Path.join(&hostDir, "dev")

  // 1. Build wasm32 site & live apps for size without debug info.
  run Task.silk(
    &[
      "build",
      "--manifest-path",
      run pathText(&run Path.join(&docsDir, "silk.toml")),
      "--target",
      "wasm32-unknown-unknown",
      "--optimization",
      "size",
      "--debug",
      "false",
    ],
  )
  run Task.silk(
    &[
      "build",
      "--manifest-path",
      run pathText(&run Path.join(&docsDir, "live/silk.toml")),
      "--target",
      "wasm32-unknown-unknown",
      "--optimization",
      "size",
      "--debug",
      "false",
    ],
  )

  // 2. Build host binaries (prerenderer, shots generator, tree-hello).
  run Task.silk(&["build", "--manifest-path", run pathText(&run Path.join(&docsDir, "silk.toml"))])
  run Task.silk(
    &["build", "--manifest-path", run pathText(&run Path.join(&docsDir, "shots/silk.toml"))],
  )
  run Task.silk(
    &[
      "build",
      "--manifest-path",
      run pathText(&run Path.join(&docsDir, "examples/apps/tree-hello/silk.toml")),
    ],
  )

  let mut hostName = run String.copy("ui-docs-site")
  run String.append(&mut hostName, exeSuffix())
  let hostBin = run Path.join(&hostDevDir, hostName.view())

  let mut shotsName = run String.copy("ui-docs-shots")
  run String.append(&mut shotsName, exeSuffix())
  let shotsBin = run Path.join(&hostDevDir, shotsName.view())

  let mut treeName = run String.copy("tree-hello")
  run String.append(&mut treeName, exeSuffix())
  let treeBin = run Path.join(&hostDevDir, treeName.view())

  // 3. Assemble docs/dist.
  let out = run Path.join(&docsDir, "dist")
  if run FileSystem.exists(&out) {
    run FileSystem.removeDirectoryRecursively(&out)
  }
  run FileSystem.createDirectoriesRecursively(&out)

  let domJs = run Path.join(&repoRoot, "loom/modules/loom/dom/js/silk-ui-dom.js")
  run copyFile(&domJs, &run Path.join(&out, "silk-ui-dom.js"))
  run copyFile(&run Path.join(&docsDir, "web/favicon.svg"), &run Path.join(&out, "favicon.svg"))
  run copyDirRecursive(&run Path.join(&docsDir, "web/fonts"), &run Path.join(&out, "fonts"))

  let stylesOut = run Path.join(&out, "styles")
  run FileSystem.createDirectoriesRecursively(&stylesOut)
  run copyFile(
    &run Path.join(&docsDir, "styles/plans.css"),
    &run Path.join(&stylesOut, "plans.css"),
  )
  run copyFile(
    &run Path.join(&docsDir, "styles/inbox.tailwind.page.css"),
    &run Path.join(&stylesOut, "inbox.tailwind.page.css"),
  )

  run copyDirRecursive(
    &run Path.join(&docsDir, "examples/apps/album/assets/photos"),
    &run Path.join(&out, "photos"),
  )
  run copyDirRecursive(
    &run Path.join(&docsDir, "examples/apps/album/assets/icons"),
    &run Path.join(&out, "icons"),
  )
  let albumFonts = run Path.join(&docsDir, "examples/apps/album/assets/fonts")
  let fontEntries = run FileSystem.listDirectory(&albumFonts)
  let fontSlice = fontEntries.asSlice()
  let mut fi = usize.ZERO
  while fi < fontSlice.length {
    let full = match Path.view(&fontSlice[fi].path) {
      Option<string>.Some { value } => value
      Option<string>.None => ""
    }
    let fname = baseName(full)
    if String.endsWith(fname, ".ttf") {
      let dstDir = run Path.join(&out, "fonts")
      run copyFile(&fontSlice[fi].path, &run Path.join(&dstDir, fname))
    }
    fi = fi + usize.ONE
  }

  run copyFile(&run Path.join(&wasmSizeDir, "ui-docs-site.wasm"), &run Path.join(&out, "site.wasm"))

  // 4. Generate screenshots.
  let shotsOut = run Path.join(&out, "shots")
  run FileSystem.createDirectoriesRecursively(&shotsOut)
  run Task.exec(run pathText(&shotsBin), &[run pathText(&shotsOut)])

  let req = run ChildProcess.requestWithin(&treeBin, &shotsOut)
  let outcome = run ChildProcess.submit(&req)
  if ChildProcess.exitCode(&outcome).unwrapOr(-1) != 0 {
    run Task.abort("tree-hello screenshot generator failed")
  }
  let helloPng = run Path.join(&shotsOut, "hello.png")
  let treePng = run Path.join(&shotsOut, "tree-hello.png")
  run copyFile(&helloPng, &treePng)
  run FileSystem.removeFile(&helloPng)

  // 5. Assemble docs/dist/live with rewritten browser hosts.
  let liveOut = run Path.join(&out, "live")
  let liveWinOut = run Path.join(&liveOut, "window")
  let liveGpuOut = run Path.join(&liveOut, "webgpu")
  run FileSystem.createDirectoriesRecursively(&liveWinOut)
  run FileSystem.createDirectoriesRecursively(&liveGpuOut)

  run copyFile(&run Path.join(&docsDir, "web/live.html"), &run Path.join(&liveOut, "index.html"))
  run copyFile(
    &run Path.join(&wasmSizeDir, "ui-docs-live.wasm"),
    &run Path.join(&liveOut, "app.wasm"),
  )

  let treeBrowserDir = run Path.join(&uiDir, "modules/tree/window/browser")
  let appHostBytes = run FileSystem.readFile(&run Path.join(&treeBrowserDir, "app-host.js"))
  let appHostText = match String.fromUtf8(Bytes.asSlice(&appHostBytes)) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { .. } => run Task.abort("app-host.js is not UTF-8")
  }
  let r1 = run replaceAll(
    appHostText,
    "'/native/platform/window/browser/window-host.js'",
    "'./window/window-host.js'",
  )
  let r2 = run replaceAll(r1.view(), "'/native/gpu/webgpu/browser/host.ts'", "'./webgpu/host.js'")
  run FileSystem.writeFile(&run Path.join(&liveOut, "app-host.js"), String.ownedUtf8Bytes(&r2))

  let tbEntries = run FileSystem.listDirectory(&treeBrowserDir)
  let tbSlice = tbEntries.asSlice()
  let mut ti = usize.ZERO
  while ti < tbSlice.length {
    let full = match Path.view(&tbSlice[ti].path) {
      Option<string>.Some { value } => value
      Option<string>.None => ""
    }
    let tname = baseName(full)
    let isJs = String.endsWith(tname, ".js") || String.endsWith(tname, ".mjs")
    if isJs && !String.endsWith(tname, ".test.mjs") && tname != "app-host.js" {
      run copyFile(&tbSlice[ti].path, &run Path.join(&liveOut, tname))
    }
    ti = ti + usize.ONE
  }

  let winBrowserDir = run Path.join(&repoRoot, "lib/native/modules/platform/window/browser")
  let winFiles = ["window-host.js", "imports.js", "keys.js"]
  let mut wi = usize.ZERO
  while wi < winFiles.length {
    run copyFile(
      &run Path.join(&winBrowserDir, winFiles[wi]),
      &run Path.join(&liveWinOut, winFiles[wi]),
    )
    wi = wi + usize.ONE
  }

  let gpuBrowserDir = run Path.join(&repoRoot, "lib/native/modules/gpu/webgpu/browser")
  let gpuSrcs = ["host.ts", "generated_schema.ts"]
  let gpuDsts = ["host.js", "generated_schema.js"]
  let mut gi = usize.ZERO
  while gi < gpuSrcs.length {
    let raw = run FileSystem.readFile(&run Path.join(&gpuBrowserDir, gpuSrcs[gi]))
    let text = match String.fromUtf8(Bytes.asSlice(&raw)) {
      Result<string, InvalidUtf8>.Success { value } => value
      Result<string, InvalidUtf8>.Failure { .. } => run Task.abort(
        "webgpu browser script is not UTF-8",
      )
    }
    let rewritten = run replaceAll(text, "./generated_schema.ts", "./generated_schema.js")
    run FileSystem.writeFile(
      &run Path.join(&liveGpuOut, gpuDsts[gi]),
      String.ownedUtf8Bytes(&rewritten),
    )
    gi = gi + usize.ONE
  }

  // 6. Prerender all HTML pages.
  return run Task.exec(
    run pathText(&hostBin),
    &[run pathText(&run Path.join(&docsDir, "web/index.html")), run pathText(&out), base],
  )
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! StandardError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Build { options, out } => run Standard.build(run compilation(&options), out.view())
      Tasks.Run { options, arguments } => {
        run Standard.start(run compilation(&options), &options, &arguments)
      }
      Tasks.Dev { options, arguments } => run Standard.dev(&options, &arguments)
      Tasks.Plan { options } => run Standard.plan(run compilation(&options))
      Tasks.BuildSite { base } => run buildSite(base.view())
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
