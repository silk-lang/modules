//! The screen readers this one plays: their keys and their words. The model underneath is the
//! same for all of them ([`reader`]); a flavor decides which key does what, how an element is
//! put into words, and what entering and leaving a list or a table sounds like.
//!
//! NVDA, JAWS, Narrator and Orca read a web document in browse mode (scan mode in Narrator,
//! the virtual cursor in JAWS): the arrow keys move by line and character, single letters jump
//! between headings, links and form fields, and keys go to the application only in focus mode.
//! VoiceOver has no modes: VO (Control+Option) with an arrow moves element by element, and
//! VO+Command with a letter jumps.
//!
//! The reader key (NVDA's, JAWS', Narrator's and Orca's Insert or Caps Lock) can also be
//! pressed as Control+Alt (Control+Option), since many keyboards have no Insert; VoiceOver's
//! VO is Control+Option, or Caps Lock.
import command { Command, Kind }
import document { Info, isLandmark }
import accesskit.lib { Role, Toggled }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.text.string { String }

pub const MOD_SHIFT: u32 = 1
pub const MOD_CONTROL: u32 = 2
pub const MOD_ALT: u32 = 4
pub const MOD_META: u32 = 8

/// A screen reader to play.
pub enum Flavor {
  Nvda,
  VoiceOver,
  Jaws,
  Narrator,
  Orca,
}

/// How many flavors there are.
pub const FLAVORS: usize = 5

/// The flavor at `index` (wrapping), in the order pickers show them.
pub fn flavorAt(index: usize) -> Flavor {
  return match index % FLAVORS {
    0 => Flavor.Nvda
    1 => Flavor.VoiceOver
    2 => Flavor.Jaws
    3 => Flavor.Narrator
    _ => Flavor.Orca
  }
}

pub fn flavorIndex(flavor: Flavor) -> usize {
  return match flavor {
    Flavor.Nvda => 0
    Flavor.VoiceOver => 1
    Flavor.Jaws => 2
    Flavor.Narrator => 3
    Flavor.Orca => 4
  }
}

/// The flavor's name as people write it.
pub fn flavorName(flavor: Flavor) -> string<'static> {
  return match flavor {
    Flavor.Nvda => "NVDA"
    Flavor.VoiceOver => "VoiceOver"
    Flavor.Jaws => "JAWS"
    Flavor.Narrator => "Narrator"
    Flavor.Orca => "Orca"
  }
}

/// The flavor `text` names (`nvda`, `voiceover` or `vo`, `jaws`, `narrator`, `orca`), any case.
pub fn flavorNamed(text: string) -> Option<Flavor> {
  let mut i: usize = 0
  while i < FLAVORS {
    let flavor = flavorAt(i)
    if sameLetters(text, flavorName(flavor)) {
      return Option.Some { value: flavor }
    }
    i = i + 1
  }
  if sameLetters(text, "vo") {
    return Option.Some { value: Flavor.VoiceOver }
  }
  return Option.None
}

/// Whether `a` and `b` are the same ASCII letters, ignoring case.
pub fn sameLetters(a: string, b: string) -> bool {
  let x = String.utf8Bytes(a)
  let y = String.utf8Bytes(b)
  if x.length != y.length {
    return false
  }
  let mut i: usize = 0
  while i < x.length {
    if lower(x[i]) != lower(y[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn lower(b: u8) -> u8 {
  if b >= 65 && b <= 90 {
    return b + 32
  }
  return b
}

/// Whether the flavor reads in browse mode, with a focus mode for typing.
pub fn browses(flavor: Flavor) -> bool {
  return flavor != Flavor.VoiceOver
}

/// What goes between the parts of a phrase.
fn separator(flavor: Flavor) -> string<'static> {
  return match flavor {
    Flavor.VoiceOver => ", "
    Flavor.Narrator => ", "
    _ => " "
  }
}

/// Appends `part` to a phrase, with the flavor's separator.
pub effect fn part(flavor: Flavor, out: &mut String, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let trimmed = String.trim(value)
  if String.byteLength(trimmed) == 0 {
    return ()
  }
  if String.byteLength(out.view()) != 0 && !String.endsWith(out.view(), " ") {
    run out.append(separator(flavor))
  }
  run out.append(trimmed)
}

// ---------------------------------------------------------------------------------------------
// Words

/// The word for `kind`, as the flavor says it; empty when it says none.
pub fn roleWord(flavor: Flavor, kind: Role) -> string<'static> {
  let vo = flavor == Flavor.VoiceOver
  let orca = flavor == Flavor.Orca
  return match kind {
    Role.Button => if orca { "push button" } else { "button" }
    Role.DefaultButton => if orca { "push button" } else { "button" }
    Role.Link => "link"
    Role.Heading => "heading"
    Role.CheckBox => if vo { "checkbox" } else { "check box" }
    Role.MenuItemCheckBox => if vo { "checkbox menu item" } else { "check menu item" }
    Role.RadioButton => "radio button"
    Role.MenuItemRadio => if vo { "radio menu item" } else { "radio menu item" }
    Role.Switch => if flavor == Flavor.Nvda { "toggle button" } else { "switch" }
    Role.TextInput => if vo { "edit text" } else if orca { "entry" } else { "edit" }
    Role.EmailInput => if vo { "edit text" } else if orca { "entry" } else { "edit" }
    Role.UrlInput => if vo { "edit text" } else if orca { "entry" } else { "edit" }
    Role.PhoneNumberInput => if vo { "edit text" } else if orca { "entry" } else { "edit" }
    Role.NumberInput => if vo { "edit text" } else if orca { "entry" } else { "edit" }
    Role.DateInput => if vo { "date field" } else { "edit" }
    Role.DateTimeInput => if vo { "date field" } else { "edit" }
    Role.TimeInput => if vo { "time field" } else { "edit" }
    Role.WeekInput => "edit"
    Role.MonthInput => "edit"
    Role.PasswordInput => if vo { "secure edit text" } else if orca { "password text" } else { "edit protected" }
    Role.MultilineTextInput => if vo { "text entry area" } else if orca { "entry" } else if flavor == Flavor.Nvda { "edit multi line" } else { "edit" }
    Role.SearchInput => if vo { "search text field" } else if orca { "entry" } else { "edit" }
    Role.ComboBox => if vo { "pop-up button" } else { "combo box" }
    Role.EditableComboBox => if vo { "combo box" } else { "combo box" }
    Role.Slider => "slider"
    Role.SpinButton => if vo { "stepper" } else if orca { "spin button" } else { "spin button" }
    Role.ProgressIndicator => if vo { "progress indicator" } else { "progress bar" }
    Role.Meter => if vo { "level indicator" } else { "meter" }
    Role.Image => if flavor == Flavor.Nvda || flavor == Flavor.Jaws { "graphic" } else { "image" }
    Role.Tab => "tab"
    Role.TabList => if vo { "tab group" } else if flavor == Flavor.Nvda { "tab control" } else { "tab list" }
    Role.TabPanel => if vo { "" } else { "property page" }
    Role.MenuItem => "menu item"
    Role.Menu => "menu"
    Role.MenuBar => "menu bar"
    Role.ListBox => "list"
    Role.ListBoxOption => if flavor == Flavor.Nvda { "" } else { "option" }
    Role.TreeItem => if vo { "row" } else { "tree view item" }
    Role.Tree => if vo { "outline" } else { "tree view" }
    Role.List => "list"
    Role.ListItem => ""
    Role.Table => "table"
    Role.Grid => if vo { "table" } else { "grid" }
    Role.TreeGrid => if vo { "outline" } else { "tree grid" }
    Role.Dialog => if vo { "web dialog" } else { "dialog" }
    Role.AlertDialog => if vo { "alert dialog" } else { "alert dialog" }
    Role.Alert => "alert"
    Role.Toolbar => if flavor == Flavor.Nvda { "tool bar" } else { "toolbar" }
    Role.Group => if flavor == Flavor.Nvda { "grouping" } else if orca { "panel" } else { "group" }
    Role.RadioGroup => if flavor == Flavor.Nvda { "grouping" } else if vo { "radio group" } else { "group" }
    Role.Article => "article"
    Role.Figure => "figure"
    Role.Blockquote => if flavor == Flavor.Nvda { "block quote" } else { "blockquote" }
    Role.Splitter => if vo { "splitter" } else { "separator" }
    Role.ColorWell => if vo { "color well" } else { "color chooser" }
    Role.ScrollBar => if vo { "scroll bar" } else { "scroll bar" }
    _ => if isLandmark(kind) { landmarkWord(flavor, kind) } else { "" }
  }
}

fn landmarkWord(flavor: Flavor, kind: Role) -> string<'static> {
  let vo = flavor == Flavor.VoiceOver
  let jaws = flavor == Flavor.Jaws
  return match kind {
    Role.Navigation => if vo { "navigation" } else if jaws { "navigation region" } else { "navigation landmark" }
    Role.Main => if vo { "main" } else if jaws { "main region" } else { "main landmark" }
    Role.Banner => if vo { "banner" } else if jaws { "banner region" } else { "banner landmark" }
    Role.ContentInfo => if vo { "content information" } else if jaws { "content information region" } else { "content info landmark" }
    Role.Complementary => if vo { "complementary" } else if jaws { "complementary region" } else { "complementary landmark" }
    Role.Search => if vo { "search" } else if jaws { "search region" } else { "search landmark" }
    Role.Form => if vo { "form" } else if jaws { "form region" } else { "form landmark" }
    _ => "region"
  }
}

/// The kind's name, one or many ("heading", "headings").
pub fn kindWord(kind: Kind, many: bool) -> string<'static> {
  return match kind {
    Kind.Heading => if many { "headings" } else { "heading" }
    Kind.Heading1 => if many { "headings at level 1" } else { "heading at level 1" }
    Kind.Heading2 => if many { "headings at level 2" } else { "heading at level 2" }
    Kind.Heading3 => if many { "headings at level 3" } else { "heading at level 3" }
    Kind.Heading4 => if many { "headings at level 4" } else { "heading at level 4" }
    Kind.Heading5 => if many { "headings at level 5" } else { "heading at level 5" }
    Kind.Heading6 => if many { "headings at level 6" } else { "heading at level 6" }
    Kind.Link => if many { "links" } else { "link" }
    Kind.FormField => if many { "form fields" } else { "form field" }
    Kind.Button => if many { "buttons" } else { "button" }
    Kind.Edit => if many { "edit fields" } else { "edit field" }
    Kind.CheckBox => if many { "check boxes" } else { "check box" }
    Kind.Radio => if many { "radio buttons" } else { "radio button" }
    Kind.ComboBox => if many { "combo boxes" } else { "combo box" }
    Kind.Table => if many { "tables" } else { "table" }
    Kind.List => if many { "lists" } else { "list" }
    Kind.ListItem => if many { "list items" } else { "list item" }
    Kind.Landmark => if many { "landmarks" } else { "landmark" }
    Kind.Graphic => if many { "graphics" } else { "graphic" }
  }
}

/// Whether a node of `kind` (with heading level `level`) is an element of `wanted`.
pub fn kindMatches(wanted: Kind, kind: Role, level: usize) -> bool {
  return match wanted {
    Kind.Heading => kind == Role.Heading
    Kind.Heading1 => kind == Role.Heading && level == 1
    Kind.Heading2 => kind == Role.Heading && level == 2
    Kind.Heading3 => kind == Role.Heading && level == 3
    Kind.Heading4 => kind == Role.Heading && level == 4
    Kind.Heading5 => kind == Role.Heading && level == 5
    Kind.Heading6 => kind == Role.Heading && level == 6
    Kind.Link => kind == Role.Link
    Kind.FormField => isFormField(kind)
    Kind.Button => kind == Role.Button || kind == Role.DefaultButton
    Kind.Edit => isEdit(kind)
    Kind.CheckBox => kind == Role.CheckBox
    Kind.Radio => kind == Role.RadioButton
    Kind.ComboBox => kind == Role.ComboBox || kind == Role.EditableComboBox
    Kind.Table => kind == Role.Table || kind == Role.Grid || kind == Role.TreeGrid
    Kind.List => kind == Role.List
    Kind.ListItem => kind == Role.ListItem
    Kind.Landmark => isLandmark(kind)
    Kind.Graphic => kind == Role.Image
  }
}

pub fn isEdit(kind: Role) -> bool {
  return match kind {
    Role.TextInput => true
    Role.MultilineTextInput => true
    Role.SearchInput => true
    Role.DateInput => true
    Role.DateTimeInput => true
    Role.WeekInput => true
    Role.MonthInput => true
    Role.TimeInput => true
    Role.EmailInput => true
    Role.NumberInput => true
    Role.PasswordInput => true
    Role.PhoneNumberInput => true
    Role.UrlInput => true
    Role.EditableComboBox => true
    _ => false
  }
}

pub fn isFormField(kind: Role) -> bool {
  return isEdit(kind) || match kind {
    Role.Button => true
    Role.DefaultButton => true
    Role.CheckBox => true
    Role.RadioButton => true
    Role.Switch => true
    Role.ComboBox => true
    Role.Slider => true
    Role.SpinButton => true
    Role.ListBox => true
    Role.ColorWell => true
    _ => false
  }
}

/// What the flavor says when quick navigation finds nothing.
pub effect fn nothingFound(flavor: Flavor, kind: Kind, forward: bool, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match flavor {
    Flavor.Nvda => {
      run out.append(if forward { "no next " } else { "no previous " })
      run out.append(kindWord(kind, false))
    }
    Flavor.Narrator => {
      run out.append(if forward { "no next " } else { "no previous " })
      run out.append(kindWord(kind, false))
    }
    _ => {
      run out.append("no more ")
      run out.append(kindWord(kind, true))
    }
  }
}

/// What the flavor says when the mode changes.
pub fn modeWord(flavor: Flavor, focus: bool) -> string<'static> {
  return match flavor {
    Flavor.Jaws => if focus { "forms mode on" } else { "virtual PC cursor" }
    Flavor.Narrator => if focus { "scan off" } else { "scan on" }
    _ => if focus { "focus mode" } else { "browse mode" }
  }
}

/// The word for reaching the top or bottom of the document.
pub fn edgeWord(flavor: Flavor, bottom: bool) -> string<'static> {
  return match flavor {
    Flavor.Nvda => if bottom { "bottom" } else { "top" }
    Flavor.VoiceOver => if bottom { "end of content" } else { "beginning of content" }
    Flavor.Jaws => if bottom { "bottom" } else { "top" }
    Flavor.Narrator => if bottom { "end of document" } else { "start of document" }
    Flavor.Orca => if bottom { "bottom" } else { "top" }
  }
}

// ---------------------------------------------------------------------------------------------
// Phrases

/// Appends the states of `info`: checked, expanded, selected, unavailable, required and so on.
pub effect fn states(flavor: Flavor, info: &Info, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let vo = flavor == Flavor.VoiceOver
  match info.toggled {
    Option.Some { value } => {
      if info.kind == Role.Switch {
        run part(flavor, &mut out, if value == Toggled.True { "on" } else { "off" })
      } else if info.kind == Role.Button {
        if value == Toggled.True {
          run part(flavor, &mut out, if vo { "selected" } else { "pressed" })
        } else if !vo {
          run part(flavor, &mut out, "not pressed")
        }
      } else {
        let word = match value {
          Toggled.True => "checked"
          Toggled.False => if vo { "unchecked" } else { "not checked" }
          Toggled.Mixed => if vo { "mixed" } else if flavor == Flavor.Nvda { "half checked" } else { "partially checked" }
        }
        run part(flavor, &mut out, word)
      }
    }
    Option.None => {}
  }
  match info.expanded {
    Option.Some { value } => run part(flavor, &mut out, if value { "expanded" } else { "collapsed" })
    Option.None => {}
  }
  match info.selected {
    Option.Some { value } => {
      if value {
        if info.kind != Role.Tab || !vo {
          run part(flavor, &mut out, "selected")
        }
      } else if flavor == Flavor.Nvda && info.kind == Role.ListBoxOption {
        run part(flavor, &mut out, "not selected")
      }
    }
    Option.None => {}
  }
  if info.visited && info.kind == Role.Link {
    run part(flavor, &mut out, "visited")
  }
  if info.disabled {
    run part(flavor, &mut out, match flavor {
      Flavor.VoiceOver => "dimmed"
      Flavor.Narrator => "disabled"
      Flavor.Orca => "grayed"
      _ => "unavailable"
    })
  }
  if info.readOnly && isEdit(info.kind) {
    run part(flavor, &mut out, if vo { "read-only" } else { "read only" })
  }
  if info.required {
    run part(flavor, &mut out, "required")
  }
  if info.invalid {
    run part(flavor, &mut out, match flavor {
      Flavor.VoiceOver => "invalid data"
      Flavor.Narrator => "invalid"
      _ => "invalid entry"
    })
  }
}

/// Appends "2 of 5" when `info` knows its place in a set.
effect fn position(flavor: Flavor, info: &Info, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if info.position == 0 || info.setSize == 0 {
    return ()
  }
  let mut text = String.make()
  run appendNumber(&mut text, info.position)
  run text.append(" of ")
  run appendNumber(&mut text, info.setSize)
  run part(flavor, &mut out, text.view())
}

pub effect fn appendNumber(out: &mut String, value: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 10 {
    run appendNumber(&mut out, value / 10)
  }
  let digit = usize.toU8(value % 10) + 48
  let bytes = [digit]
  run out.append(String.fromUtf8(&bytes).unwrapOr("0"))
}

/// Appends the role with its level ("heading level 2").
effect fn roleWithLevel(flavor: Flavor, info: &Info, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run part(flavor, &mut out, roleWord(flavor, info.kind))
  if info.kind == Role.Heading && info.level > 0 {
    let mut level = String.make()
    run level.append("level ")
    run appendNumber(&mut level, info.level)
    if flavor == Flavor.VoiceOver || flavor == Flavor.Narrator {
      run out.append(" ")
      run out.append(level.view())
    } else {
      run part(flavor, &mut out, level.view())
    }
  }
}

/// Appends what the flavor says for a control, or for any element the cursor or focus lands
/// on: "Subscribe check box not checked" (NVDA), "Subscribe, unchecked, checkbox" (VoiceOver).
pub effect fn element(flavor: Flavor, info: &Info, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let edit = isEdit(info.kind)
  match flavor {
    Flavor.VoiceOver => {
      run part(flavor, &mut out, info.name.view())
      if edit || info.kind == Role.Slider || info.kind == Role.ComboBox || info.kind == Role.SpinButton
        || info.kind == Role.ProgressIndicator {
        run part(flavor, &mut out, info.value.view())
      }
      run states(flavor, info, &mut out)
      run roleWithLevel(flavor, info, &mut out)
      if edit && String.byteLength(info.value.view()) == 0 {
        run part(flavor, &mut out, info.placeholder.view())
      }
      run position(flavor, info, &mut out)
      run part(flavor, &mut out, info.description.view())
    }
    _ => {
      run part(flavor, &mut out, info.name.view())
      run roleWithLevel(flavor, info, &mut out)
      run states(flavor, info, &mut out)
      if edit {
        if String.byteLength(String.trim(info.value.view())) == 0 {
          if String.byteLength(info.placeholder.view()) != 0 {
            run part(flavor, &mut out, info.placeholder.view())
          } else if flavor == Flavor.Nvda || flavor == Flavor.Jaws {
            run part(flavor, &mut out, "blank")
          }
        } else {
          run part(flavor, &mut out, info.value.view())
        }
      } else if info.kind != Role.Link && info.kind != Role.Heading {
        run part(flavor, &mut out, info.value.view())
      }
      run part(flavor, &mut out, info.description.view())
      run position(flavor, info, &mut out)
    }
  }
}

/// Whether the flavor says a field's role before its content (NVDA's "link Home"), rather
/// than after it (VoiceOver's "Home, link").
pub fn rolesFirst(flavor: Flavor) -> bool {
  return flavor == Flavor.Nvda || flavor == Flavor.Jaws
}

/// Whether a field is named by its content: links, headings, cells, list items. Their entry
/// says only the role; the content follows.
pub fn contentField(kind: Role) -> bool {
  return match kind {
    Role.Link => true
    Role.Heading => true
    Role.ListItem => true
    Role.Cell => true
    Role.GridCell => true
    Role.ColumnHeader => true
    Role.RowHeader => true
    Role.Row => true
    Role.Paragraph => true
    _ => false
  }
}

/// Appends what the flavor says when the cursor enters field `info` ("list with 3 items",
/// "navigation landmark", "Settings dialog"). For content fields it is the role and level, at
/// the start for [`rolesFirst`] flavors; the others say it at the end ([`fieldEnd`]).
pub effect fn fieldEnter(flavor: Flavor, info: &Info, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let kind = info.kind
  if contentField(kind) {
    if rolesFirst(flavor) {
      run roleWithLevel(flavor, info, &mut out)
      run states(flavor, info, &mut out)
    }
    return ()
  }
  if kind == Role.List || kind == Role.ListBox || kind == Role.Menu || kind == Role.Tree {
    let mut text = String.make()
    run text.append(roleWord(flavor, kind))
    run text.append(match flavor {
      Flavor.Nvda => " with "
      Flavor.Jaws => " of "
      Flavor.Narrator => ", "
      Flavor.Orca => " with "
      Flavor.VoiceOver => " "
    })
    run appendNumber(&mut text, info.count)
    run text.append(if info.count == 1 { " item" } else { " items" })
    run part(flavor, &mut out, info.name.view())
    run part(flavor, &mut out, text.view())
    return ()
  }
  if kind == Role.Table || kind == Role.Grid || kind == Role.TreeGrid {
    let mut text = String.make()
    run text.append(roleWord(flavor, kind))
    match flavor {
      Flavor.Jaws => {
        run text.append(" with ")
        run appendNumber(&mut text, info.columns)
        run text.append(" columns and ")
        run appendNumber(&mut text, info.rows)
        run text.append(" rows")
      }
      Flavor.Nvda => {
        run text.append(" with ")
        run appendNumber(&mut text, info.rows)
        run text.append(" rows and ")
        run appendNumber(&mut text, info.columns)
        run text.append(" columns")
      }
      _ => {
        run text.append(if flavor == Flavor.Narrator { ", " } else { " " })
        run appendNumber(&mut text, info.rows)
        run text.append(if flavor == Flavor.Narrator { " rows, " } else { " rows " })
        run appendNumber(&mut text, info.columns)
        run text.append(" columns")
      }
    }
    run part(flavor, &mut out, info.name.view())
    run part(flavor, &mut out, text.view())
    return ()
  }
  run part(flavor, &mut out, info.name.view())
  run part(flavor, &mut out, roleWord(flavor, kind))
  run part(flavor, &mut out, info.description.view())
}

/// Appends what the flavor says after a content field's content ("Home, link"), when it does
/// not say it first.
pub effect fn fieldEnd(flavor: Flavor, info: &Info, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if rolesFirst(flavor) || !contentField(info.kind) {
    return ()
  }
  if info.kind == Role.ListItem || info.kind == Role.Paragraph || info.kind == Role.Row || info.kind == Role.Cell
    || info.kind == Role.GridCell || info.kind == Role.ColumnHeader || info.kind == Role.RowHeader {
    return ()
  }
  run roleWithLevel(flavor, info, &mut out)
  run states(flavor, info, &mut out)
}

/// Appends what the flavor says when the cursor leaves field `info` ("out of list").
pub effect fn fieldExit(flavor: Flavor, info: &Info, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let kind = info.kind
  let word = if kind == Role.List {
    "list"
  } else if kind == Role.Table || kind == Role.Grid {
    "table"
  } else if kind == Role.Blockquote {
    if flavor == Flavor.Nvda { "block quote" } else { "blockquote" }
  } else if kind == Role.Dialog || kind == Role.AlertDialog {
    "dialog"
  } else {
    ""
  }
  if String.byteLength(word) == 0 {
    return ()
  }
  let mut text = String.make()
  match flavor {
    Flavor.Nvda => {
      run text.append("out of ")
      run text.append(word)
    }
    Flavor.Jaws => {
      run text.append(word)
      run text.append(" end")
    }
    Flavor.Narrator => {
      run text.append("exiting ")
      run text.append(word)
    }
    Flavor.Orca => {
      run text.append("leaving ")
      run text.append(word)
    }
    Flavor.VoiceOver => {
      run text.append("end of ")
      run text.append(word)
    }
  }
  run part(flavor, &mut out, text.view())
}

/// The name of a character as a reader spells it.
pub fn characterName(flavor: Flavor, text: string) -> string {
  if text == " " {
    return "space"
  }
  if text == "\t" {
    return "tab"
  }
  if text == "\n" {
    return if flavor == Flavor.VoiceOver { "new line" } else { "blank" }
  }
  if text == "." {
    return if flavor == Flavor.VoiceOver { "period" } else { "dot" }
  }
  if text == "," {
    return "comma"
  }
  if text == ":" {
    return "colon"
  }
  if text == ";" {
    return "semicolon"
  }
  if text == "!" {
    return if flavor == Flavor.Nvda { "bang" } else { "exclamation mark" }
  }
  if text == "?" {
    return if flavor == Flavor.Nvda { "question" } else { "question mark" }
  }
  if text == "'" {
    return if flavor == Flavor.Nvda { "tick" } else { "apostrophe" }
  }
  if text == "\"" {
    return "quote"
  }
  if text == "-" {
    return if flavor == Flavor.Nvda { "dash" } else { "hyphen" }
  }
  if text == "(" {
    return if flavor == Flavor.Nvda { "left paren" } else { "left parenthesis" }
  }
  if text == ")" {
    return if flavor == Flavor.Nvda { "right paren" } else { "right parenthesis" }
  }
  if text == "/" {
    return "slash"
  }
  if text == "@" {
    return "at"
  }
  if text == "#" {
    return if flavor == Flavor.Nvda { "number" } else { "number sign" }
  }
  if text == "&" {
    return if flavor == Flavor.Nvda { "and" } else { "ampersand" }
  }
  if text == "*" {
    return "star"
  }
  if text == "+" {
    return "plus"
  }
  if text == "=" {
    return "equals"
  }
  if text == "_" {
    return "underline"
  }
  return text
}

// ---------------------------------------------------------------------------------------------
// Keys

/// The keys the flavors use, by DOM `KeyboardEvent.code`.
pub enum Key {
  Other,
  Escape,
  Backspace,
  A,
  B,
  C,
  ControlLeft,
  ControlRight,
  D,
  Digit1,
  Digit2,
  Digit3,
  Digit4,
  Digit5,
  Digit6,
  Down,
  E,
  End,
  Enter,
  F,
  F2,
  F3,
  F4,
  F5,
  F6,
  F7,
  G,
  H,
  Home,
  I,
  J,
  K,
  L,
  Left,
  M,
  N,
  Q,
  R,
  Right,
  Semicolon,
  Slash,
  Space,
  T,
  Tab,
  U,
  Up,
  X,
  Z,
}

/// The key of a DOM `KeyboardEvent.code`.
pub fn keyOf(code: string) -> Key {
  if code == "ArrowDown" {
    return Key.Down
  }
  if code == "ArrowLeft" {
    return Key.Left
  }
  if code == "ArrowRight" {
    return Key.Right
  }
  if code == "ArrowUp" {
    return Key.Up
  }
  if code == "ControlLeft" {
    return Key.ControlLeft
  }
  if code == "ControlRight" {
    return Key.ControlRight
  }
  if code == "Digit1" {
    return Key.Digit1
  }
  if code == "Digit2" {
    return Key.Digit2
  }
  if code == "Digit3" {
    return Key.Digit3
  }
  if code == "Digit4" {
    return Key.Digit4
  }
  if code == "Digit5" {
    return Key.Digit5
  }
  if code == "Digit6" {
    return Key.Digit6
  }
  if code == "End" {
    return Key.End
  }
  if code == "Enter" {
    return Key.Enter
  }
  if code == "F2" {
    return Key.F2
  }
  if code == "F3" {
    return Key.F3
  }
  if code == "F4" {
    return Key.F4
  }
  if code == "F5" {
    return Key.F5
  }
  if code == "F6" {
    return Key.F6
  }
  if code == "F7" {
    return Key.F7
  }
  if code == "Home" {
    return Key.Home
  }
  if code == "KeyA" {
    return Key.A
  }
  if code == "KeyB" {
    return Key.B
  }
  if code == "KeyC" {
    return Key.C
  }
  if code == "KeyD" {
    return Key.D
  }
  if code == "KeyE" {
    return Key.E
  }
  if code == "KeyF" {
    return Key.F
  }
  if code == "KeyG" {
    return Key.G
  }
  if code == "KeyH" {
    return Key.H
  }
  if code == "KeyI" {
    return Key.I
  }
  if code == "KeyJ" {
    return Key.J
  }
  if code == "KeyK" {
    return Key.K
  }
  if code == "KeyL" {
    return Key.L
  }
  if code == "KeyM" {
    return Key.M
  }
  if code == "KeyN" {
    return Key.N
  }
  if code == "KeyQ" {
    return Key.Q
  }
  if code == "KeyR" {
    return Key.R
  }
  if code == "KeyT" {
    return Key.T
  }
  if code == "KeyU" {
    return Key.U
  }
  if code == "KeyX" {
    return Key.X
  }
  if code == "KeyZ" {
    return Key.Z
  }
  if code == "Semicolon" {
    return Key.Semicolon
  }
  if code == "Slash" {
    return Key.Slash
  }
  if code == "Space" {
    return Key.Space
  }
  if code == "Tab" {
    return Key.Tab
  }
  if code == "Escape" {
    return Key.Escape
  }
  if code == "Backspace" {
    return Key.Backspace
  }
  return Key.Other
}

/// The command key `code` (a DOM `KeyboardEvent.code`) with `modifiers` means to `flavor`.
/// `reader` says the reader key is held (or VO for VoiceOver); `browse` that browse mode is
/// on. None: the key is the application's.
pub fn commandOf(flavor: Flavor, code: string, modifiers: u32, reader: bool, browse: bool) -> Option<Command> {
  let key = keyOf(code)
  let shift = (modifiers & MOD_SHIFT) != 0
  let control = (modifiers & MOD_CONTROL) != 0
  let alt = (modifiers & MOD_ALT) != 0
  let meta = (modifiers & MOD_META) != 0
  if key == Key.ControlLeft || key == Key.ControlRight {
    return Option.None
  }
  if flavor == Flavor.VoiceOver {
    return voiceOver(code, shift, meta, reader)
  }
  // Table navigation: Control+Alt with the arrows, whatever the reader key.
  if control && alt && !shift {
    match arrow(code) {
      Option.Some { value } => {
        return Option.Some { value: Command.TableMove { rows: value.rows, columns: value.columns } }
      }
      Option.None => {}
    }
  }
  if reader {
    return readerKey(flavor, code, shift)
  }
  if flavor == Flavor.Orca && alt && shift && browse {
    // Orca's lists of elements: Alt+Shift+H headings, K links, F form fields, M landmarks.
    return match key {
      Key.H => Option.Some { value: Command.ElementsList { kind: Kind.Heading } }
      Key.K => Option.Some { value: Command.ElementsList { kind: Kind.Link } }
      Key.F => Option.Some { value: Command.ElementsList { kind: Kind.FormField } }
      Key.M => Option.Some { value: Command.ElementsList { kind: Kind.Landmark } }
      _ => Option.None
    }
  }
  if !browse || alt || meta {
    return Option.None
  }
  if control {
    return match key {
      Key.Right => Option.Some { value: Command.NextWord }
      Key.Left => Option.Some { value: Command.PreviousWord }
      Key.Home => Option.Some { value: Command.Top }
      Key.End => Option.Some { value: Command.Bottom }
      _ => Option.None
    }
  }
  return match key {
    Key.Down => Option.Some { value: Command.NextLine }
    Key.Up => Option.Some { value: Command.PreviousLine }
    Key.Right => Option.Some { value: Command.NextCharacter }
    Key.Left => Option.Some { value: Command.PreviousCharacter }
    Key.Home => Option.Some { value: Command.LineStart }
    Key.End => Option.Some { value: Command.LineEnd }
    Key.Enter => Option.Some { value: Command.Activate }
    Key.Space => Option.Some { value: Command.Activate }
    _ => match quickKind(flavor, code) {
      Option.Some { value } => Option.Some { value: Command.Jump { kind: value, forward: !shift } }
      Option.None => Option.None
    }
  }
}

struct Step {
  rows: i32,
  columns: i32,
}

fn arrow(code: string) -> Option<Step> {
  let key = keyOf(code)
  return match key {
    Key.Down => Option.Some { value: Step { rows: 1, columns: 0 } }
    Key.Up => Option.Some { value: Step { rows: -1, columns: 0 } }
    Key.Right => Option.Some { value: Step { rows: 0, columns: 1 } }
    Key.Left => Option.Some { value: Step { rows: 0, columns: -1 } }
    _ => Option.None
  }
}

/// The single-letter quick navigation keys of browse mode.
fn quickKind(flavor: Flavor, code: string) -> Option<Kind> {
  let key = keyOf(code)
  let kind = match key {
    Key.H => Kind.Heading
    Key.Digit1 => Kind.Heading1
    Key.Digit2 => Kind.Heading2
    Key.Digit3 => Kind.Heading3
    Key.Digit4 => Kind.Heading4
    Key.Digit5 => Kind.Heading5
    Key.Digit6 => Kind.Heading6
    Key.K => Kind.Link
    Key.U => Kind.Link
    Key.F => Kind.FormField
    Key.B => Kind.Button
    Key.E => Kind.Edit
    Key.X => Kind.CheckBox
    Key.R => Kind.Radio
    Key.A => Kind.Radio
    Key.C => Kind.ComboBox
    Key.T => Kind.Table
    Key.L => Kind.List
    Key.I => Kind.ListItem
    Key.D => Kind.Landmark
    Key.M => Kind.Landmark
    Key.Semicolon => Kind.Landmark
    Key.G => Kind.Graphic
    _ => {
      return Option.None
    }
  }
  // Each reader has its own letters for links, radio buttons and landmarks.
  let theirs = match flavor {
    Flavor.Jaws => key != Key.K && key != Key.D && key != Key.M
    Flavor.Orca => key != Key.U && key != Key.D && key != Key.Semicolon && key != Key.A
    _ => key != Key.U && key != Key.M && key != Key.Semicolon && key != Key.A
  }
  if !theirs {
    return Option.None
  }
  if flavor == Flavor.Jaws && key == Key.R {
    return Option.Some { value: Kind.Landmark }
  }
  return Option.Some { value: kind }
}

/// Reader key combinations of the browse-mode flavors.
fn readerKey(flavor: Flavor, code: string, shift: bool) -> Option<Command> {
  let key = keyOf(code)
  let shared = match key {
    Key.Space => Option.Some { value: Command.ToggleMode }
    Key.Down => Option.Some { value: Command.SayAll }
    Key.Up => Option.Some { value: Command.CurrentLine }
    Key.Right => Option.Some { value: Command.NextItem }
    Key.Left => Option.Some { value: Command.PreviousItem }
    Key.Tab => Option.Some { value: Command.CurrentFocus }
    Key.Q => Option.Some { value: Command.Quit }
    _ => Option<Command>.None
  }
  if shared.isSome() {
    if flavor == Flavor.Orca && key == Key.Space {
      return Option.None
    }
    return shared
  }
  return match flavor {
    Flavor.Nvda => match key {
      Key.T => Option.Some { value: Command.Title }
      Key.F7 => Option.Some { value: Command.ElementsList { kind: Kind.Link } }
      Key.A => Option.Some { value: Command.SayAll }
      Key.L => Option.Some { value: Command.CurrentLine }
      _ => Option.None
    }
    Flavor.Jaws => match key {
      Key.T => Option.Some { value: Command.Title }
      Key.Z => Option.Some { value: Command.ToggleMode }
      Key.F7 => Option.Some { value: Command.ElementsList { kind: Kind.Link } }
      Key.F6 => Option.Some { value: Command.ElementsList { kind: Kind.Heading } }
      Key.F5 => Option.Some { value: Command.ElementsList { kind: Kind.FormField } }
      _ => Option.None
    }
    Flavor.Narrator => match key {
      Key.T => Option.Some { value: Command.Title }
      Key.R => Option.Some { value: Command.SayAll }
      Key.I => Option.Some { value: Command.CurrentLine }
      Key.F7 => Option.Some { value: Command.ElementsList { kind: Kind.Link } }
      Key.F6 => Option.Some { value: Command.ElementsList { kind: Kind.Heading } }
      Key.F5 => Option.Some { value: Command.ElementsList { kind: Kind.Landmark } }
      _ => Option.None
    }
    Flavor.Orca => match key {
      Key.A => Option.Some { value: Command.ToggleMode }
      Key.Semicolon => Option.Some { value: Command.SayAll }
      Key.I => Option.Some { value: Command.CurrentLine }
      Key.Slash => Option.Some { value: Command.Title }
      _ => Option.None
    }
    Flavor.VoiceOver => Option.None
  }
}

/// VoiceOver: VO+arrows move, VO+Command+letter jumps, VO+Space activates, VO+U the rotor.
fn voiceOver(code: string, shift: bool, command: bool, vo: bool) -> Option<Command> {
  let key = keyOf(code)
  if !vo {
    return Option.None
  }
  if command {
    let kind = match key {
      Key.H => Kind.Heading
      Key.L => Kind.Link
      Key.J => Kind.FormField
      Key.T => Kind.Table
      Key.X => Kind.List
      Key.G => Kind.Graphic
      Key.B => Kind.Button
      Key.N => Kind.Landmark
      _ => {
        return Option.None
      }
    }
    return Option.Some { value: Command.Jump { kind: kind, forward: !shift } }
  }
  return match key {
    Key.Right => Option.Some { value: Command.NextItem }
    Key.Left => Option.Some { value: Command.PreviousItem }
    Key.Down => Option.Some { value: Command.NextLine }
    Key.Up => Option.Some { value: Command.PreviousLine }
    Key.Space => Option.Some { value: Command.Activate }
    Key.A => Option.Some { value: Command.SayAll }
    Key.U => Option.Some { value: Command.ElementsList { kind: Kind.Heading } }
    Key.Home => Option.Some { value: Command.Top }
    Key.End => Option.Some { value: Command.Bottom }
    Key.F2 => Option.Some { value: Command.Title }
    Key.F3 => Option.Some { value: Command.CurrentLine }
    Key.F4 => Option.Some { value: Command.CurrentFocus }
    Key.Q => Option.Some { value: Command.Quit }
    _ => Option.None
  }
}

/// The reader key as a label shows it.
pub fn readerKeyName(flavor: Flavor) -> string<'static> {
  return match flavor {
    Flavor.Nvda => "NVDA"
    Flavor.VoiceOver => "VO"
    Flavor.Jaws => "Insert"
    Flavor.Narrator => "Narrator"
    Flavor.Orca => "Orca"
  }
}

/// Appends the keys for `command` in `flavor`, as a panel button labels it ("H",
/// "NVDA+Space", "VO+Cmd+H"). Empty when the flavor has no key for it.
pub effect fn keyLabel(flavor: Flavor, command: Command, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let sr = readerKeyName(flavor)
  let vo = flavor == Flavor.VoiceOver
  match command {
    Command.NextLine => run keys(&mut out, if vo { sr } else { "" }, "Down")
    Command.PreviousLine => run keys(&mut out, if vo { sr } else { "" }, "Up")
    Command.NextCharacter => run keys(&mut out, "", if vo { "" } else { "Right" })
    Command.PreviousCharacter => run keys(&mut out, "", if vo { "" } else { "Left" })
    Command.NextWord => run keys(&mut out, "", if vo { "" } else { "Ctrl+Right" })
    Command.PreviousWord => run keys(&mut out, "", if vo { "" } else { "Ctrl+Left" })
    Command.NextItem => run keys(&mut out, sr, "Right")
    Command.PreviousItem => run keys(&mut out, sr, "Left")
    Command.LineStart => run keys(&mut out, "", if vo { "" } else { "Home" })
    Command.LineEnd => run keys(&mut out, "", if vo { "" } else { "End" })
    Command.Top => run keys(&mut out, if vo { sr } else { "" }, if vo { "Home" } else { "Ctrl+Home" })
    Command.Bottom => run keys(&mut out, if vo { sr } else { "" }, if vo { "End" } else { "Ctrl+End" })
    Command.Jump { kind, forward } => run jumpLabel(flavor, kind, forward, &mut out)
    Command.Activate => run keys(&mut out, if vo { sr } else { "" }, if vo { "Space" } else { "Enter" })
    Command.ToggleMode => run keys(&mut out, if vo { "" } else { sr }, match flavor {
      Flavor.VoiceOver => ""
      Flavor.Jaws => "Z"
      Flavor.Orca => "A"
      _ => "Space"
    })
    Command.BrowseMode => run keys(&mut out, "", if vo { "" } else { "Esc" })
    Command.SayAll => run keys(&mut out, sr, match flavor {
      Flavor.VoiceOver => "A"
      Flavor.Narrator => "R"
      Flavor.Orca => ";"
      _ => "Down"
    })
    Command.StopSpeech => run keys(&mut out, "", "Ctrl")
    Command.CurrentLine => run keys(&mut out, sr, match flavor {
      Flavor.VoiceOver => "F3"
      Flavor.Narrator => "I"
      Flavor.Orca => "I"
      _ => "Up"
    })
    Command.CurrentFocus => run keys(&mut out, sr, if vo { "F4" } else { "Tab" })
    Command.Title => run keys(&mut out, sr, match flavor {
      Flavor.VoiceOver => "F2"
      Flavor.Orca => "/"
      _ => "T"
    })
    Command.ElementsList { kind } => run listLabel(flavor, kind, &mut out)
    Command.TableMove { rows, columns } => {
      let way = if rows > 0 { "Down" } else if rows < 0 { "Up" } else if columns > 0 { "Right" } else { "Left" }
      run keys(&mut out, if vo { "" } else { "Ctrl+Alt" }, if vo { "" } else { way })
    }
    Command.Quit => run keys(&mut out, sr, "Q")
  }
}

effect fn keys(out: &mut String, modifier: string, key: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if String.byteLength(key) == 0 {
    return ()
  }
  if String.byteLength(modifier) != 0 {
    run out.append(modifier)
    run out.append("+")
  }
  run out.append(key)
}

effect fn jumpLabel(flavor: Flavor, kind: Kind, forward: bool, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let letter = match flavor {
    Flavor.VoiceOver => match kind {
      Kind.Heading => "H"
      Kind.Link => "L"
      Kind.FormField => "J"
      Kind.Table => "T"
      Kind.List => "X"
      Kind.Graphic => "G"
      Kind.Button => "B"
      Kind.Landmark => "N"
      _ => ""
    }
    _ => match kind {
      Kind.Heading => "H"
      Kind.Heading1 => "1"
      Kind.Heading2 => "2"
      Kind.Heading3 => "3"
      Kind.Heading4 => "4"
      Kind.Heading5 => "5"
      Kind.Heading6 => "6"
      Kind.Link => if flavor == Flavor.Jaws { "U" } else { "K" }
      Kind.FormField => "F"
      Kind.Button => "B"
      Kind.Edit => "E"
      Kind.CheckBox => "X"
      Kind.Radio => if flavor == Flavor.Jaws { "A" } else { "R" }
      Kind.ComboBox => "C"
      Kind.Table => "T"
      Kind.List => "L"
      Kind.ListItem => "I"
      Kind.Landmark => match flavor {
        Flavor.Jaws => "R"
        Flavor.Orca => "M"
        _ => "D"
      }
      Kind.Graphic => "G"
    }
  }
  if String.byteLength(letter) == 0 {
    return ()
  }
  if flavor == Flavor.VoiceOver {
    run out.append(if forward { "VO+Cmd+" } else { "VO+Cmd+Shift+" })
  } else if !forward {
    run out.append("Shift+")
  }
  run out.append(letter)
}

effect fn listLabel(flavor: Flavor, kind: Kind, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match flavor {
    Flavor.VoiceOver => run out.append("VO+U")
    Flavor.Nvda => run out.append("NVDA+F7")
    Flavor.Orca => {
      run out.append("Alt+Shift+")
      run out.append(match kind {
        Kind.Link => "K"
        Kind.FormField => "F"
        Kind.Landmark => "M"
        _ => "H"
      })
    }
    _ => {
      run out.append(readerKeyName(flavor))
      run out.append(match kind {
        Kind.Heading => "+F6"
        Kind.FormField => if flavor == Flavor.Jaws { "+F5" } else { "+F7" }
        Kind.Landmark => if flavor == Flavor.Narrator { "+F5" } else { "+F7" }
        _ => "+F7"
      })
    }
  }
}
