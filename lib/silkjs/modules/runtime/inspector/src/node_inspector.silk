//! The inspector protocol: the runtime's real `Inspector` capability.
//!
//! A program that provides `NodeInspector` depends on this package, and so has the inspector's
//! server; a program that provides `EmptyInspector` does not. The debugger metadata the engine
//! keeps on code (ext/inspector_debugger) is the core's.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjsruntime.ext.diagnostics_hub { Mailbox }
import silkjsruntime.libs.core.capabilities { Inspector, Composition }
import silkjsruntime.libs.core.host { Services }
import ext.inspector_native

/// Node's inspector protocol, over the engine.
pub struct NodeInspector {
  state: ?*mut inspector_native.State,
}
impl Copy for NodeInspector {}

impl NodeInspector {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> NodeInspector { return NodeInspector { state: Pointer.null<inspector_native.State>() } }
}

impl Inspector for NodeInspector {
  static fn present() -> bool { return true }
  fn forWorker(self: &Self) -> Self { return NodeInspector.make() }
  effect fn open(self: &mut Self, wake: ?*mut u8, mailbox: Mailbox) -> () ! OutOfMemoryError {
    self.state = run inspector_native.create(wake, mailbox)
  }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, operation: u32, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if Pointer.isNull<inspector_native.State>(self.state) { Intrinsic.trap("inspector provider is not initialized") }
    let state = unsafe Intrinsic.pointerRequalify<?*mut inspector_native.State, *mut inspector_native.State>(self.state)
    return run unsafe inspector_native.dispatch(&mut engine, context, state, operation, argc, argv)
  }
  unsafe effect fn compiledSource<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, compiled: ValueBits) -> ()
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if let Option<*mut inspector_native.State>.Some { value } = Pointer.nonNullMut<inspector_native.State>(self.state) {
      run unsafe inspector_native.compiledSource(&mut engine, context, value, compiled)
    }
  }
  unsafe effect fn markEntry<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, compiled: ValueBits) -> ()
    ! JsException ? &mut Allocator {
    if let Option<*mut inspector_native.State>.Some { value } = Pointer.nonNullMut<inspector_native.State>(self.state) {
      run unsafe inspector_native.markEntry(&mut engine, context, value, compiled)
    }
  }
  unsafe effect fn debuggerCallback<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, event: u32) -> () ? &mut Allocator {
    if let Option<*mut inspector_native.State>.Some { value } = Pointer.nonNullMut<inspector_native.State>(self.state) {
      run unsafe inspector_native.debuggerCallback(&mut engine, context, value, event)
    }
  }
  unsafe effect fn pumpCallback<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, waitMs: i32) -> () ? &mut Allocator {
    if let Option<*mut inspector_native.State>.Some { value } = Pointer.nonNullMut<inspector_native.State>(self.state) {
      run unsafe inspector_native.pumpCallback(&mut engine, context, value, waitMs)
    }
  }
  unsafe fn dispose<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> () {
    if let Option<*mut inspector_native.State>.Some { value } = Pointer.nonNullMut<inspector_native.State>(self.state) {
      // Taken first: the inspector's last events must not reach it again.
      self.state = Pointer.null<inspector_native.State>()
      unsafe inspector_native.dispose(&mut engine, context, value)
    }
  }
}
