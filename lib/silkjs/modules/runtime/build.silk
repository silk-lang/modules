import silk.build.plan { Library, Plan }
import silk.build.step { sourcePath }

// The core's own C: the built-in JavaScript (builtin_sources.c #embeds each file) and the cache of
// its bytecode. The capabilities' C (WAMR, llhttp, the inspector's transport) is in their packages.
static fn plan() -> Plan {
  let mut plan = Plan.empty()
    |> Plan.compileNative("c", sourcePath("builtin_sources.c"), &["-std=c23", "-O2", "-w"], &[])
    |> Plan.compileNative("c", sourcePath("src/ext/builtin_cache.c"), &["-std=gnu23", "-O2", "-w"], &[])
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan
      |> Plan.linkLibrary("pthread", Library.dynamicSearch())
      |> Plan.linkLibrary("dl", Library.dynamicSearch())
      |> Plan.linkLibrary("m", Library.dynamicSearch())
  }
  return plan
}

pub const PLAN: Plan = plan()
