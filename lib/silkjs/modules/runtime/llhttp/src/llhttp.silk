//! The HTTP/1 parser over llhttp: the runtime's real `Http` capability.
//!
//! A program that provides `Llhttp` depends on this package, and so compiles llhttp; a program
//! that provides `EmptyHttp` does not.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjsruntime.ext.diagnostics_fatal { RuntimeHeap }
import silkjsruntime.libs.core.capabilities { Http, Composition }
import silkjsruntime.libs.core.host { Services }
import ext.http_parser_native

/// llhttp behind `node:http`'s parser and `fetch`.
pub struct Llhttp {
  state: ?*mut http_parser_native.State,
}
impl Copy for Llhttp {}

impl Llhttp {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> Llhttp { return Llhttp { state: Pointer.null<http_parser_native.State>() } }
}

impl Http for Llhttp {
  static fn present() -> bool { return true }
  fn forWorker(self: &Self) -> Self { return Llhttp.make() }
  effect fn open(self: &mut Self, allocator: *mut RuntimeHeap) -> () ! OutOfMemoryError {
    self.state = run http_parser_native.open(allocator)
  }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if Pointer.isNull<http_parser_native.State>(self.state) { Intrinsic.trap("HTTP parser provider is not initialized") }
    let state = unsafe Intrinsic.pointerRequalify<?*mut http_parser_native.State, *mut http_parser_native.State>(self.state)
    return run unsafe http_parser_native.dispatch(&mut engine, context, state, argc, argv)
  }
  unsafe fn close<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> () {
    match Pointer.nonNullMut<http_parser_native.State>(self.state) {
      Option<*mut http_parser_native.State>.Some { value } => {
        unsafe http_parser_native.close(&mut engine, context, value)
        self.state = Pointer.null<http_parser_native.State>()
      }
      Option<*mut http_parser_native.State>.None => ()
    }
  }
}
