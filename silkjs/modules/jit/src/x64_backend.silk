      run self.tagGuard(inst.a, tag, inst.exit)
      return ()
    }
    if op == Op.GetField {
      run self.stressGuard(inst.exit)
      let slow = run self.a.label()
      let done = run self.a.label()
      // A borrowed result (ssa_ownership.borrowFields) takes no count, nor does a method a
      // dispatch reads (bareDispatch).
      let borrowed = function.value(inst.result).own == Own.Borrowed || self.isBare(inst.result)
      let same = self.shapes.sameAs(self.cursor)
      if same != NONE {
        // An earlier value still holds this property's value (ssa_shapes): a copy of it,
        // read from that value's slot (stored).
        let object = (self.shapes.fact(self.cursor) & FACT_OBJECT) != 0
        let source = self.storage(inst.result)
        if !borrowed { run self.count(source, object) }
        return ()
      }
      let key = self.shapes.key(self.cursor)
      if key != 0 {
        // The shape and slot the site held when this was compiled, as constants: any other
        // object leaves the code.
        let fact = self.shapes.fact(self.cursor)
        let miss = self.exitLabels.get(u32.toUsize(inst.exit))
        self.lazyAt(inst.a, inst.exit)
        // The shape in R8: RAX and R9 keep a fresh object for the exit. R11 may hold the
        // slots already (slotsValue), when nothing is left to test.
        if self.slotsHeld != inst.a || (fact & FACT_OBJECT) == 0 || (fact & FACT_SHAPE) == 0 { run self.shapedSlots(inst.a, key, fact, miss, Reg.R8) }
        let at = u64.wrappingToI32(u64.bitAnd(key, 65535)) * 16
        if inst.result != NONE && (borrowed || function.value(inst.result).own == Own.Owned) && (inst.k & FIELD_STEPS) == 0 && self.settings.stress == 0 && self.fusedUnboxF64(&function, inst) {
          // The next instruction unboxes this field as F64 and nothing else reads it:
          // a Float64 loads directly from the object's slot into the XMM place (or slot);
          // non-Float64 goes out of line to coldPieces (converting Int via cvtsi2sd or
          // storing the field and exiting at the unbox's exit).
          let unbox = function.inst(self.cursor + 1)
          let layout = self.settings.layout
          let cold = run self.a.label()
          let out = self.at(unbox.result)
          let byteTag = layout.tagWidth == 1 && layout.float64() < 256 && layout.int() < 256
          if byteTag {
            run self.a.cmp8MemImm(Mem.at(Reg.R11, at + u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.float64()))
          } else {
            run self.loadTag(Reg.R8, Mem.at(Reg.R11, at + u32.wrappingToI32(layout.tagOffset)))
            run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
          }
          run self.a.jcc(Cond.NotEqual, cold)
          if out.kind == XMM {
            run self.a.loadDouble(out.xmm, Mem.at(Reg.R11, at + 8))
          } else {
            run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, at + 8))
            run putBits(&mut self.a, out, Reg.Rax)
          }
          self.omitAt = self.cursor + 1
          run self.coldLabels.append(cold) run self.coldBacks.append(done) run self.coldInsts.append(inst) run self.coldAux.append(unbox.exit) run self.coldElements.append(addressed())
          self.a.bind(done)
          self.slotsValue = inst.a
          return ()
        }
        if (inst.k & FIELD_STEPS) == 0 && self.fusedUnboxI32(&function, inst) {
          // The next instruction unboxes this field as an Int and nothing else reads it:
          // the number loads from the object's slot, and anything else goes out of line
          // (coldPieces: the field to its slot, then the unbox's exit).
          self.omitAt = self.unboxAt(&function, inst)
          let unbox = function.inst(self.omitAt)
          let cold = run self.a.label()
          run self.loadInt(unbox, Reg.R11, at, cold)
          run self.coldLabels.append(cold) run self.coldBacks.append(done) run self.coldInsts.append(inst) run self.coldAux.append(unbox.exit) run self.coldElements.append(addressed())
          self.a.bind(done)
          self.slotsValue = inst.a
          return ()
        }
