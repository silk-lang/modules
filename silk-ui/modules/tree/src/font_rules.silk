//! `@font-palette-values` and `@font-feature-values` rules from a root's style sheets, and the
//! tables that turn written `font-palette`, `font-variant-alternates` and `font-size-adjust`
//! values into the handles `FontFeatures.extras` holds.
import engine { UiTree }
import style_sheets
import sheet_faces
import sheet_faces { Registry }
import svg_css.tokens { TokenBuffer, TokenRange, Kind, equal }
import svg_css.input { Input }
import svg_css.value_cursor { Cursor }
import svg_css.colors { Color, Identity }
import svg_css.colors
import svg_fonts.names { same }
import font_raster.color { PaletteChoice, PaletteOverride, PALETTE_LIGHT, PALETTE_DARK }
import vector.pixmap { Rgba8 }
import ui_text.fonts { SizeAdjust, ADJUST_NONE, ADJUST_EX_HEIGHT, ADJUST_CAP_HEIGHT, ADJUST_CH_WIDTH, ADJUST_IC_WIDTH, ADJUST_IC_HEIGHT }
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// `font-palette` handles below the named ones.
pub const PALETTE_NORMAL_HANDLE: u32 = 0
pub const PALETTE_LIGHT_HANDLE: u32 = 1
pub const PALETTE_DARK_HANDLE: u32 = 2
const PALETTE_NAMED: u32 = 3
const HANDLE_LIMIT: usize = 1023

/// `@font-feature-values` blocks.
pub const BLOCK_STYLISTIC: u8 = 1
pub const BLOCK_STYLESET: u8 = 2
pub const BLOCK_CHARACTER_VARIANT: u8 = 3
pub const BLOCK_SWASH: u8 = 4
pub const BLOCK_ORNAMENTS: u8 = 5
pub const BLOCK_ANNOTATION: u8 = 6

/// One `@font-palette-values` rule.
pub struct PaletteRule {
  pub name: Bytes,
  pub families: List<Bytes>,
  pub base: u16,
  pub overrides: List<PaletteOverride>,
}

/// One feature value name of an `@font-feature-values` block: `@styleset { fancy: 3 5 }`.
pub struct FeatureValue {
  pub block: u8,
  pub name: Bytes,
  pub values: List<u32>,
}

/// One `@font-feature-values` rule.
pub struct FeatureRule {
  pub families: List<Bytes>,
  pub values: List<FeatureValue>,
}

/// The rules of one root's sheets.
pub struct RootRules {
  pub root: u32,
  pub palettes: List<PaletteRule>,
  pub features: List<FeatureRule>,
  /// A digest of the rules' text, to tell when they changed.
  pub digest: u64,
}

pub struct FontRules {
  pub roots: List<RootRules>,
  /// `font-palette` names by handle less PALETTE_NAMED.
  palettes: List<Bytes>,
  /// `font-variant-alternates` text by handle less one.
  alternateTexts: List<Bytes>,
  /// `font-size-adjust` values by handle less one.
  adjusts: List<SizeAdjust>,
}

impl FontRules {
  pub fn make() -> FontRules {
    return FontRules {
      roots: List<RootRules>.make(),
      palettes: List<Bytes>.make(),
      alternateTexts: List<Bytes>.make(),
      adjusts: List<SizeAdjust>.make(),
    }
  }

  /// The handle for written `font-palette` `css`, or None when it is not a palette this
  /// supports (such as `palette-mix()`), which CSS then treats as `normal`.
  pub effect fn paletteHandle(self: &mut Self, css: &[u8]) -> Option<u32> ! OutOfMemoryError ? &mut Allocator {
    let word = trim(css)
    if named(word, b"normal") { return Option<u32>.some(PALETTE_NORMAL_HANDLE) }
    if named(word, b"light") { return Option<u32>.some(PALETTE_LIGHT_HANDLE) }
    if named(word, b"dark") { return Option<u32>.some(PALETTE_DARK_HANDLE) }
    if word.length < 3 || word[0] != 45 || word[1] != 45 || !identifier(word) {
      return Option<u32>.None
    }
    let at = run intern(&mut self.palettes, word)
    if at >= HANDLE_LIMIT - 3 { return Option<u32>.None }
    return Option<u32>.some(usize.toU32(at) + PALETTE_NAMED)
  }

  /// The handle for written `font-variant-alternates` `css`; 0 for `normal`.
  pub effect fn alternatesHandle(self: &mut Self, css: &[u8]) -> Option<u32> ! OutOfMemoryError ? &mut Allocator {
    let word = trim(css)
    if named(word, b"normal") { return Option<u32>.some(0) }
    let mut probe = List<u32>.make()
    if !run alternatesFeatures(word, &List<FeatureRule>.make(), b"", &mut probe) {
      return Option<u32>.None
    }
    let at = run intern(&mut self.alternateTexts, word)
    if at >= HANDLE_LIMIT { return Option<u32>.None }
    return Option<u32>.some(usize.toU32(at) + 1)
  }

  /// The handle for written `font-size-adjust` `css`; 0 for `none`.
  pub effect fn adjustHandle(self: &mut Self, css: &[u8]) -> Option<u32> ! OutOfMemoryError ? &mut Allocator {
    let adjust = match parseAdjust(trim(css)) {
      Option.Some { value } => value
      Option.None => { return Option<u32>.None }
    }
    if adjust.metric == ADJUST_NONE { return Option<u32>.some(0) }
    let mut i: usize = 0
    while i < self.adjusts.length() {
      let known = self.adjusts.get(i)
      if known.metric == adjust.metric && known.value == adjust.value { return Option<u32>.some(usize.toU32(i) + 1) }
      i = i + 1
    }
    if self.adjusts.length() >= HANDLE_LIMIT { return Option<u32>.None }
    run self.adjusts.append(adjust)
    return Option<u32>.some(usize.toU32(self.adjusts.length()))
  }

  /// The `font-size-adjust` value of `handle`.
  pub fn adjust(self: &Self, handle: u32) -> SizeAdjust {
    let at = u32.toUsize(handle)
    if at == 0 || at > self.adjusts.length() { return SizeAdjust.none() }
    return self.adjusts.get(at - 1)
  }

  fn rootRules(self: &Self, root: u32) -> Option<&RootRules> {
    let mut i: usize = 0
    while i < self.roots.length() {
      if self.roots.asSlice()[i].root == root { return Option<&RootRules>.some(&self.roots.asSlice()[i]) }
      i = i + 1
    }
    return Option<&RootRules>.None
  }

  /// The OpenType features (tag, value pairs) `font-variant-alternates` `handle` turns on for
  /// text in `families` under `root`, resolving names with the root's `@font-feature-values`.
  pub effect fn alternates(self: &Self, root: u32, handle: u32, families: &[Bytes], out: &mut List<u32>) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    let at = u32.toUsize(handle)
    if at == 0 || at > self.alternateTexts.length() { return () }
    let text = self.alternateTexts.asSlice()[at - 1].asSlice()
    let empty = List<FeatureRule>.make()
    let rules = match self.rootRules(root) {
      Option.Some { value } => &value.features
      Option.None => &empty
    }
    // Names resolve in the first family that defines them (CSS Fonts 4 §6.9.1 looks in the
    // used font's family; the tree resolves per style, before faces are chosen).
    let mut f: usize = 0
    while f <= families.length {
      let family = if f < families.length { families[f].asSlice() } else { b"" }
      let mut trial = List<u32>.make()
      let valid = run alternatesFeatures(text, rules, family, &mut trial)
      if valid && (trial.length() != 0 || f == families.length) {
        run out.appendSlice(trial.asSlice())
        return ()
      }
      f = f + 1
    }
  }

  /// The palette `font-palette` `handle` draws a face of `family` (as text named it) with.
  pub effect fn palette(self: &Self, root: u32, handle: u32, family: &[u8]) -> PaletteChoice ! OutOfMemoryError ? &mut Allocator {
    if handle == PALETTE_LIGHT_HANDLE { return PaletteChoice { base: PALETTE_LIGHT, overrides: List<PaletteOverride>.make() } }
    if handle == PALETTE_DARK_HANDLE { return PaletteChoice { base: PALETTE_DARK, overrides: List<PaletteOverride>.make() } }
    let at = u32.toUsize(handle)
    if at < 3 || at - 3 >= self.palettes.length() || family.length == 0 { return PaletteChoice.normal() }
    let name = self.palettes.asSlice()[at - 3].asSlice()
    if let Option.Some { value: rules } = self.rootRules(root) {
      // The last rule with this name for this family wins.
      let mut i = rules.palettes.length()
      while i > 0 {
        i = i - 1
        let rule = &rules.palettes.asSlice()[i]
        if equal(rule.name.asSlice(), name) && listed(rule.families.asSlice(), family) {
          let mut overrides = List<PaletteOverride>.make()
          run overrides.appendSlice(rule.overrides.asSlice())
          return PaletteChoice { base: rule.base, overrides: move overrides }
        }
      }
    }
    return PaletteChoice.normal()
  }
}

/// Reads the rules of the current root's sheets again; true when they changed.
pub effect fn sync(tree: &mut UiTree<'_>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let root = tree.current
  let mut fresh = RootRules { root: root, palettes: List<PaletteRule>.make(), features: List<FeatureRule>.make(), digest: 14695981039346656037 }
  let at = style_sheets.index(tree.styleSheets.asSlice(), root)
  if at != usize.MAX {
    let sheets = tree.styleSheets.asSlice()[at].sheets.sheets()
    let mut s: usize = 0
    while s < sheets.length {
      let sheet = &sheets[s].sheet
      let mut r: usize = 0
      while r < sheet.metadata.length() {
        let rule = &sheet.metadata.asSlice()[r]
        if rule.buffer < sheet.buffers.length() {
          let buffer = &sheet.buffers.asSlice()[rule.buffer]
          fresh.digest = digest(fresh.digest, rule.name.asSlice())
          fresh.digest = digest(fresh.digest, rangeText(buffer, rule.prelude))
          fresh.digest = digest(fresh.digest, rangeText(buffer, rule.body))
          if equal(rule.name.asSlice(), b"font-palette-values") {
            if let Option.Some { value } = move run paletteRule(buffer, rule.prelude, rule.body) { run fresh.palettes.append(move value) }
          } else if equal(rule.name.asSlice(), b"font-feature-values") {
            if let Option.Some { value } = move run featureRule(buffer, rule.prelude, rule.body) { run fresh.features.append(move value) }
          }
        }
        r = r + 1
      }
      s = s + 1
    }
  }
  let mut i: usize = 0
  while i < tree.fontRules.roots.length() {
    if tree.fontRules.roots.asSlice()[i].root == root {
      let changed = tree.fontRules.roots.asSlice()[i].digest != fresh.digest
      if changed {
        let roots = tree.fontRules.roots.asMutSlice()
        roots[i] = move fresh
      }
      return changed
    }
    i = i + 1
  }
  let any = fresh.palettes.length() != 0 || fresh.features.length() != 0
  run tree.fontRules.roots.append(move fresh)
  return any
}

/// Forgets the rules of `root`.
pub fn close(rules: &mut FontRules, root: u32) -> () {
  let mut i: usize = 0
  while i < rules.roots.length() {
    if rules.roots.asSlice()[i].root == root {
      drop rules.roots.remove(i)
      return ()
    }
    i = i + 1
  }
}

/// The family a sheet face alias stands for, or `name` itself.
pub fn familyName<'r>(registry: &'r Registry, name: &'r [u8]) -> &'r [u8] {
  if let Option.Some { value } = sheet_faces.original(registry, name) { return value.name.asSlice() }
  return name
}

// Parsing.

fn digest(hash: u64, bytes: &[u8]) -> u64 {
  let mut h = hash
  let mut i: usize = 0
  while i < bytes.length {
    h = u64.wrappingMultiply(h ^ u8.toU64(bytes[i]), 1099511628211)
    i = i + 1
  }
  return u64.wrappingMultiply(h ^ 255, 1099511628211)
}

fn rangeText(buffer: &TokenBuffer, range: TokenRange) -> &[u8] {
  let tokens = buffer.tokens.asSlice()
  if range.start >= range.end || range.end > tokens.length { return b"" }
  let start = tokens[range.start].source.start
  let end = tokens[range.end - 1].source.end
  let source = buffer.source()
  if start > end || end > source.length { return b"" }
  return Slice.view<u8>(source, start, end - start)
}

fn whitespace(buffer: &TokenBuffer, at: usize) -> bool {
  return match &buffer.tokens.asSlice()[at].kind {
    Kind.Whitespace => true
    _ => false
  }
}

fn skip(buffer: &TokenBuffer, at: usize, end: usize) -> usize {
  let mut i = at
  while i < end && whitespace(buffer, i) { i = i + 1 }
  return i
}

/// Ranges trimmed of whitespace at both ends.
fn trimmed(buffer: &TokenBuffer, range: TokenRange) -> TokenRange {
  let start = skip(buffer, range.start, range.end)
  let mut end = range.end
  while end > start && whitespace(buffer, end - 1) { end = end - 1 }
  return TokenRange { start: start, end: end }
}

/// The ident text of token `at`, or empty.
fn ident(buffer: &TokenBuffer, at: usize) -> &[u8] {
  return match &buffer.tokens.asSlice()[at].kind {
    Kind.Ident { text } => buffer.text(text)
    _ => b""
  }
}

/// The index after the block or token at `at`.
fn after(buffer: &TokenBuffer, at: usize, end: usize) -> usize {
  let matching = buffer.tokens.asSlice()[at].matching
  if matching > at && matching < end { return matching + 1 }
  return at + 1
}

struct Item {
  /// A declaration's name token, or an at-rule's keyword token.
  name: usize,
  /// The declaration's value, or the block's contents.
  value: TokenRange,
  block: bool,
}

impl Copy for Item {}

/// The declarations and nested at-rule blocks of a block's contents.
effect fn items(buffer: &TokenBuffer, range: TokenRange) -> List<Item> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<Item>.make()
  let mut at = range.start
  while at < range.end {
    let kind = buffer.tokens.asSlice()[at].kind
    match kind {
      Kind.Ident { .. } => {
        let name = at
        let mut i = skip(buffer, at + 1, range.end)
        let colon = i < range.end && match &buffer.tokens.asSlice()[i].kind {
          Kind.Colon => true
          _ => false
        }
        if colon { i = i + 1 }
        let start = i
        while i < range.end && !match &buffer.tokens.asSlice()[i].kind {
          Kind.Semicolon => true
          _ => false
        } {
          i = after(buffer, i, range.end)
        }
        if colon { run out.append(Item { name: name, value: trimmed(buffer, TokenRange { start: start, end: i }), block: false }) }
        at = i + 1
      }
      Kind.AtKeyword { .. } => {
        let name = at
        let mut i = at + 1
        while i < range.end && !match &buffer.tokens.asSlice()[i].kind {
          Kind.OpenBrace => true
          Kind.Semicolon => true
          _ => false
        } {
          i = after(buffer, i, range.end)
        }
        if i < range.end && match &buffer.tokens.asSlice()[i].kind {
          Kind.OpenBrace => true
          _ => false
        } {
          let close = buffer.tokens.asSlice()[i].matching
          let stop = if close > i && close <= range.end { close } else { range.end }
          run out.append(Item { name: name, value: TokenRange { start: i + 1, end: stop }, block: true })
          at = stop + 1
        } else {
          at = i + 1
        }
      }
      _ => { at = after(buffer, at, range.end) }
    }
  }
  return move out
}

/// A family list: idents joined by single spaces, or strings, split by commas.
effect fn familyList(buffer: &TokenBuffer, range: TokenRange, out: &mut List<Bytes>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut name = Bytes.make()
  let mut at = range.start
  let mut fresh = true
  while at <= range.end {
    let comma = at == range.end || match &buffer.tokens.asSlice()[at].kind {
      Kind.Comma => true
      _ => false
    }
    if comma {
      if name.length() == 0 { return false }
      run out.append(move name)
      name = Bytes.make()
      fresh = true
      at = at + 1
      continue
    }
    match buffer.tokens.asSlice()[at].kind {
      Kind.Whitespace => {}
      Kind.Ident { text } => {
        if name.length() != 0 { run name.append(b" ") }
        run name.append(buffer.text(text))
        fresh = false
      }
      Kind.String { text } => {
        if !fresh { return false }
        run name.append(buffer.text(text))
        fresh = false
      }
      _ => { return false }
    }
    at = at + 1
  }
  return out.length() != 0
}

fn integer(buffer: &TokenBuffer, at: usize) -> Option<u32> {
  return match buffer.tokens.asSlice()[at].kind {
    Kind.Number { value, integer } => if integer && value >= 0.0 && value < 65536.0 { Option<u32>.some(f64.toU32(value)) } else { Option<u32>.None }
    _ => Option<u32>.None
  }
}

effect fn paletteRule(buffer: &TokenBuffer, prelude: TokenRange, body: TokenRange) -> Option<PaletteRule> ! OutOfMemoryError ? &mut Allocator {
  let head = trimmed(buffer, prelude)
  if head.end != head.start + 1 { return Option<PaletteRule>.None }
  let name = ident(buffer, head.start)
  if name.length < 3 || name[0] != 45 || name[1] != 45 { return Option<PaletteRule>.None }
  let mut rule = PaletteRule { name: run Bytes.copy(name), families: List<Bytes>.make(), base: 0, overrides: List<PaletteOverride>.make() }
  let list = run items(buffer, body)
  let mut i: usize = 0
  while i < list.length() {
    let item = list.get(i)
    let key = ident(buffer, item.name)
    if !item.block && named(key, b"font-family") {
      let mut families = List<Bytes>.make()
      if run familyList(buffer, item.value, &mut families) { rule.families = move families }
    } else if !item.block && named(key, b"base-palette") && item.value.end == item.value.start + 1 {
      let word = ident(buffer, item.value.start)
      if named(word, b"light") { rule.base = PALETTE_LIGHT }
      else if named(word, b"dark") { rule.base = PALETTE_DARK }
      else if let Option.Some { value } = integer(buffer, item.value.start) {
        if value < 65534 { rule.base = u32.toU16(value) }
      }
    } else if !item.block && named(key, b"override-colors") {
      let mut overrides = List<PaletteOverride>.make()
      if run overrideColors(buffer, item.value, &mut overrides) { rule.overrides = move overrides }
    }
    i = i + 1
  }
  if rule.families.length() == 0 { return Option<PaletteRule>.None }
  return Option<PaletteRule>.Some { value: move rule }
}

/// `override-colors: <integer> <absolute-color>#`.
effect fn overrideColors(buffer: &TokenBuffer, range: TokenRange, out: &mut List<PaletteOverride>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = range.start
  while at < range.end {
    at = skip(buffer, at, range.end)
    let index = match integer(buffer, at) {
      Option.Some { value } => value
      Option.None => { return false }
    }
    at = skip(buffer, at + 1, range.end)
    let start = at
    while at < range.end && !match &buffer.tokens.asSlice()[at].kind {
      Kind.Comma => true
      _ => false
    } {
      at = after(buffer, at, range.end)
    }
    let part = trimmed(buffer, TokenRange { start: start, end: at })
    let input = Input.Contiguous { buffer: buffer, range: part }
    let mut cursor = Cursor.make(&input)
    let color = match run colors.parse(&input, &mut cursor) {
      Option<Color>.Some { value } => value
      Option<Color>.None => { return false }
    }
    if cursor.position != input.length() { return false }
    let absolute = match color.identity {
      Identity.Absolute => true
      _ => false
    }
    if !absolute { return false }
    let rgba = colors.toSrgb(color)
    if index < 65534 {
      run out.append(PaletteOverride { index: u32.toU16(index), color: Rgba8.make(channel(rgba.r), channel(rgba.g), channel(rgba.b), channel(rgba.a)) })
    }
    at = at + 1
  }
  return out.length() != 0
}

fn channel(value: f64) -> u8 {
  let clamped = if value < 0.0 { 0.0 } else if value > 1.0 { 1.0 } else { value }
  return f64.toU8(clamped * 255.0 + 0.5)
}

effect fn featureRule(buffer: &TokenBuffer, prelude: TokenRange, body: TokenRange) -> Option<FeatureRule> ! OutOfMemoryError ? &mut Allocator {
  let mut rule = FeatureRule { families: List<Bytes>.make(), values: List<FeatureValue>.make() }
  if !run familyList(buffer, trimmed(buffer, prelude), &mut rule.families) { return Option<FeatureRule>.None }
  let blocks = run items(buffer, body)
  let mut b: usize = 0
  while b < blocks.length() {
    let block = blocks.get(b)
    b = b + 1
    if !block.block { continue }
    let keyword = match buffer.tokens.asSlice()[block.name].kind {
      Kind.AtKeyword { name } => buffer.text(name)
      _ => b""
    }
    let kind = blockKind(keyword)
    if kind == 0 { continue }
    let entries = run items(buffer, block.value)
    let mut e: usize = 0
    while e < entries.length() {
      let entry = entries.get(e)
      e = e + 1
      if entry.block { continue }
      let mut values = List<u32>.make()
      let mut ok = entry.value.end > entry.value.start
      let mut at = entry.value.start
      while ok && at < entry.value.end {
        if !whitespace(buffer, at) {
          match integer(buffer, at) {
            Option.Some { value } => run values.append(value)
            Option.None => { ok = false }
          }
        }
        at = at + 1
      }
      // Each block's value count (CSS Fonts 4 §6.9.1): one, or two for character variants,
      // or any for style sets; zero is never valid.
      let count = values.length()
      if kind == BLOCK_CHARACTER_VARIANT { ok = ok && count <= 2 && values.get(0) >= 1 && values.get(0) <= 99 }
      else if kind == BLOCK_STYLESET { ok = ok && allBetween(values.asSlice(), 1, 20) }
      else { ok = ok && count == 1 }
      if ok {
        run rule.values.append(FeatureValue { block: kind, name: run Bytes.copy(ident(buffer, entry.name)), values: move values })
      }
    }
  }
  return Option<FeatureRule>.Some { value: move rule }
}

fn allBetween(values: &[u32], low: u32, high: u32) -> bool {
  let mut i: usize = 0
  while i < values.length {
    if values[i] < low || values[i] > high { return false }
    i = i + 1
  }
  return true
}

fn blockKind(keyword: &[u8]) -> u8 {
  if named(keyword, b"stylistic") { return BLOCK_STYLISTIC }
  if named(keyword, b"styleset") { return BLOCK_STYLESET }
  if named(keyword, b"character-variant") { return BLOCK_CHARACTER_VARIANT }
  if named(keyword, b"swash") { return BLOCK_SWASH }
  if named(keyword, b"ornaments") { return BLOCK_ORNAMENTS }
  if named(keyword, b"annotation") { return BLOCK_ANNOTATION }
  return 0
}

/// The features `font-variant-alternates` `css` turns on, with names looked up in the rules
/// for `family`; false when `css` is not valid. An unknown name turns nothing on.
effect fn alternatesFeatures(css: &[u8], rules: &List<FeatureRule>, family: &[u8], out: &mut List<u32>) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let mut seen: u32 = 0
  let mut at: usize = 0
  while true {
    while at < css.length && space(css[at]) { at = at + 1 }
    if at >= css.length { break }
    let start = at
    while at < css.length && css[at] != 40 && !space(css[at]) { at = at + 1 }
    let word = Slice.view<u8>(css, start, at - start)
    if named(word, b"historical-forms") {
      if (seen & 1) != 0 { return false }
      seen = seen | 1
      run pair(&mut out, b"hist", 1)
      continue
    }
    if at >= css.length || css[at] != 40 { return false }
    let kind = blockKind(word)
    if kind == 0 { return false }
    let bit = u32.shiftLeft(1, u8.toU32(kind))
    if (seen & bit) != 0 { return false }
    seen = seen | bit
    at = at + 1
    let mut names = List<Bytes>.make()
    while true {
      while at < css.length && space(css[at]) { at = at + 1 }
      let nameStart = at
      while at < css.length && css[at] != 44 && css[at] != 41 && !space(css[at]) { at = at + 1 }
      if at == nameStart { return false }
      run names.append(run Bytes.copy(Slice.view<u8>(css, nameStart, at - nameStart)))
      while at < css.length && space(css[at]) { at = at + 1 }
      if at >= css.length { return false }
      if css[at] == 41 { at = at + 1 break }
      if css[at] != 44 { return false }
      at = at + 1
    }
    // Only styleset() and character-variant() take several names.
    if names.length() > 1 && kind != BLOCK_STYLESET && kind != BLOCK_CHARACTER_VARIANT { return false }
    let mut n: usize = 0
    while n < names.length() {
      if let Option.Some { value } = lookup(rules, family, kind, names.asSlice()[n].asSlice()) {
        run featuresOf(&mut out, kind, value.values.asSlice())
      }
      n = n + 1
    }
  }
  return seen != 0
}

fn lookup<'r>(rules: &'r List<FeatureRule>, family: &[u8], kind: u8, name: &[u8]) -> Option<&'r FeatureValue> {
  if family.length == 0 { return Option<&'r FeatureValue>.None }
  // Later rules and later definitions win.
  let mut r = rules.length()
  while r > 0 {
    r = r - 1
    let rule = &rules.asSlice()[r]
    if listed(rule.families.asSlice(), family) {
      let mut v = rule.values.length()
      while v > 0 {
        v = v - 1
        let value = &rule.values.asSlice()[v]
        if value.block == kind && equal(value.name.asSlice(), name) { return Option<&'r FeatureValue>.some(value) }
      }
    }
  }
  return Option<&'r FeatureValue>.None
}

effect fn featuresOf(out: &mut List<u32>, kind: u8, values: &[u32]) -> () ! OutOfMemoryError ? &mut Allocator {
  if kind == BLOCK_STYLESET {
    let mut i: usize = 0
    while i < values.length {
      run out.append(numberedTag(115, 115, values[i]))
      run out.append(1)
      i = i + 1
    }
    return ()
  }
  if kind == BLOCK_CHARACTER_VARIANT {
    run out.append(numberedTag(99, 118, values[0]))
    run out.append(if values.length > 1 { values[1] } else { 1 })
    return ()
  }
  let value = values[0]
  if kind == BLOCK_STYLISTIC { run pair(&mut out, b"salt", value) }
  else if kind == BLOCK_SWASH {
    run pair(&mut out, b"swsh", value)
    run pair(&mut out, b"cswh", value)
  }
  else if kind == BLOCK_ORNAMENTS { run pair(&mut out, b"ornm", value) }
  else if kind == BLOCK_ANNOTATION { run pair(&mut out, b"nalt", value) }
}

/// A tag of two letters and a two-digit number: `ss03`, `cv12`.
fn numberedTag(first: u8, second: u8, number: u32) -> u32 {
  let tens = 48 + number / 10
  let ones = 48 + number % 10
  return u32.shiftLeft(u8.toU32(first), 24) | u32.shiftLeft(u8.toU32(second), 16) | u32.shiftLeft(tens, 8) | ones
}

effect fn pair(out: &mut List<u32>, tag: &[u8], value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let packed = u32.shiftLeft(u8.toU32(tag[0]), 24) | u32.shiftLeft(u8.toU32(tag[1]), 16) | u32.shiftLeft(u8.toU32(tag[2]), 8) | u8.toU32(tag[3])
  run out.append(packed)
  run out.append(value)
}

fn parseAdjust(css: &[u8]) -> Option<SizeAdjust> {
  if named(css, b"none") { return Option<SizeAdjust>.some(SizeAdjust.none()) }
  let mut metric = ADJUST_EX_HEIGHT
  let mut at: usize = 0
  let mut start: usize = 0
  while at < css.length && !space(css[at]) { at = at + 1 }
  let first = Slice.view<u8>(css, 0, at)
  let kind = metricOf(first)
  if kind != ADJUST_NONE {
    metric = kind
    while at < css.length && space(css[at]) { at = at + 1 }
    start = at
    if start == css.length { return Option<SizeAdjust>.None }
  }
  let rest = Slice.view<u8>(css, start, css.length - start)
  if named(rest, b"from-font") { return Option<SizeAdjust>.some(SizeAdjust { metric: metric, value: -1.0 }) }
  return match number(rest) {
    Option.Some { value } => Option<SizeAdjust>.some(SizeAdjust { metric: metric, value: value })
    Option.None => Option<SizeAdjust>.None
  }
}

fn metricOf(word: &[u8]) -> u8 {
  if named(word, b"ex-height") { return ADJUST_EX_HEIGHT }
  if named(word, b"cap-height") { return ADJUST_CAP_HEIGHT }
  if named(word, b"ch-width") { return ADJUST_CH_WIDTH }
  if named(word, b"ic-width") { return ADJUST_IC_WIDTH }
  if named(word, b"ic-height") { return ADJUST_IC_HEIGHT }
  return ADJUST_NONE
}

/// A non-negative decimal number.
fn number(text: &[u8]) -> Option<f32> {
  if text.length == 0 { return Option<f32>.None }
  let mut value: f64 = 0.0
  let mut scale: f64 = 0.0
  let mut digits: usize = 0
  let mut i: usize = 0
  while i < text.length {
    let byte = text[i]
    if byte == 46 && scale == 0.0 {
      scale = 1.0
    } else if byte >= 48 && byte <= 57 {
      digits = digits + 1
      if scale == 0.0 {
        value = value * 10.0 + u8.toF64(byte - 48)
      } else {
        scale = scale / 10.0
        value = value + u8.toF64(byte - 48) * scale
      }
    } else {
      return Option<f32>.None
    }
    i = i + 1
  }
  if digits == 0 { return Option<f32>.None }
  return Option<f32>.some(f64.toF32(value))
}

fn listed(families: &[Bytes], family: &[u8]) -> bool {
  let mut i: usize = 0
  while i < families.length {
    if same(families[i].asSlice(), family) { return true }
    i = i + 1
  }
  return false
}

effect fn intern(list: &mut List<Bytes>, text: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < list.length() {
    if equal(list.asSlice()[i].asSlice(), text) { return i }
    i = i + 1
  }
  run list.append(run Bytes.copy(text))
  return list.length() - 1
}

fn identifier(word: &[u8]) -> bool {
  let mut i: usize = 0
  while i < word.length {
    let byte = word[i]
    if space(byte) || byte == 40 || byte == 41 || byte == 44 { return false }
    i = i + 1
  }
  return true
}

fn trim(css: &[u8]) -> &[u8] {
  let mut start: usize = 0
  let mut end = css.length
  while start < end && space(css[start]) { start = start + 1 }
  while end > start && space(css[end - 1]) { end = end - 1 }
  return Slice.view<u8>(css, start, end - start)
}

fn lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 { return byte + 32 }
  return byte
}

fn named(part: &[u8], name: &[u8]) -> bool {
  if part.length != name.length { return false }
  let mut i: usize = 0
  while i < part.length {
    if lower(part[i]) != name[i] { return false }
    i = i + 1
  }
  return true
}

fn space(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13
}
