fn storage<'b>(object: ObjectRef<'b>) -> ?*mut HeapHeader {
  let resolve = object.opaque(ObjectPayloadFamily.AsyncFunctionResolve)
  if !Pointer.isNull<HeapHeader>(resolve) { return resolve }
  return object.opaque(ObjectPayloadFamily.AsyncFunctionReject)
}
pub unsafe fn markResolving(object: *mut HeapHeader, tracer: &mut Tracer) -> () {
  match Pointer.nonNullMut<HeapHeader>(storage(unsafe ObjectRef.lend(&object, object))) { Option<*mut HeapHeader>.Some { value } => { unsafe tracer.header(value) } _ => () }
}
pub unsafe fn finalizeResolving<H: HeapHooks>(hooks: &mut H, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
  let node = match Pointer.nonNullMut<HeapHeader>(storage(unsafe ObjectRef.lend(&object, object))) { Option<*mut HeapHeader>.Some { value } => value _ => { return } }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, object)
  data.payload = ObjectPayload.Empty drop data
  // The frame may still name this object as its await handler.
  let frame = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  if Pointer.address<HeapHeader>(frame.awaitHandler) == Pointer.address<HeapHeader>(object) { frame.awaitHandler = Pointer.null<HeapHeader>() }
  drop frame
  unsafe gc.releaseHeader(&mut hooks, rt, node)
}
/// The function a reaction of one of node's awaits calls: with the settled value
/// it resumes the body, and with a second argument of true it throws the value
/// into it. No script ever holds it, so one object serves both of an await's
/// reactions and every await of the body while a queued reaction or a running
/// job keeps it alive; the frame only names it.
unsafe effect fn awaitHandler<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, node: *mut HeapHeader) -> Value ! JsException ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<AsyncFrame, ()>(&anchor, node)
  let known = data.awaitHandler drop data
  if let Option<*mut HeapHeader>.Some { value: object } = Pointer.nonNullMut<HeapHeader>(known) {
    // One whose last reference is gone waits for its finalizer: it is not reused.
    let header = unsafe Pointer.borrow<(), HeapHeader>(&anchor, object)
    if header.referenceCount > 0 { drop header return unsafe Value.retain(ValueBits.Object { reference: object }) }
  }
  let made = run unsafe resolving(&mut hooks, memory, realm, node, false)
  let mut mutation = () let frame = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut mutation, node)
  frame.awaitHandler = core.reference(made.view())
  return move made
}
unsafe effect fn resolving<'a, H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, node: *mut HeapHeader, reject: bool) -> Value ! JsException ? &mut Allocator {
  let mut classId = classes.JS_CLASS_ASYNC_FUNCTION_RESOLVE let mut family = ObjectPayloadFamily.AsyncFunctionResolve
  if reject { classId = classes.JS_CLASS_ASYNC_FUNCTION_REJECT family = ObjectPayloadFamily.AsyncFunctionReject }
  else {
    let spare = unsafe gc.takeSpareObject(realm.runtime(), gc.SPARE_AWAIT_HANDLER, core.reference(realm.functionPrototype().view()))
    if let Option<*mut HeapHeader>.Some { value: reused } = Pointer.nonNullMut<HeapHeader>(spare) {
      unsafe HeapCell.retain(node)
      let mut reuse = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut reuse, reused)
      data.payload = ObjectPayload.Opaque { family: family, reference: node }
      return unsafe Value.adoptBits(ValueBits.Object { reference: reused })
    }
  }
  let allocated = run Effect.result(objects.withPrototypeClass(&mut hooks, memory, realm, realm.functionPrototype(), classId))
  let object = match move allocated { Result<ValueBits, OutOfMemoryError>.Success { value } => value Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error) }
  unsafe HeapCell.retain(node)
  let mut mutation = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut mutation, core.reference(object))
  data.payload = ObjectPayload.Opaque { family: family, reference: node }
  return unsafe Value.adoptBits(object)
}
unsafe effect fn awaitValue<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, node: *mut HeapHeader, value: Value) -> () ! JsException ? &mut Allocator {
  if unsafe runtime.asyncHooksEnabled(realm.runtime()) {
    let anchor = () let data = unsafe HeapCell.payload<AsyncFrame, ()>(&anchor, node)
    let outerResolve = data.resolvingFunctions[0].dup() drop data
    let fulfill = run unsafe resolving(&mut hooks, memory, realm, node, false)
    let reject = run unsafe resolving(&mut hooks, memory, realm, node, true)
    run promise.awaitObserved(&mut hooks, memory, realm, outerResolve.borrow(), value.borrow(), fulfill.borrow(), reject.borrow())
    return
  }
  let handler = run unsafe awaitHandler(&mut hooks, memory, realm, node)
  // A value that is no object needs no promise to wait on: its reaction is queued
  // as the fulfilled promise Promise.resolve would make queues it.
  if !value.view().isObject() {
    run promise.queueFulfilled(&mut hooks, realm, handler.borrow(), value.borrow())
    drop value
    return
  }
  if run promise.queueIfFulfilled(&mut hooks, realm, handler.borrow(), value.borrow()) { drop value return }
  let wrapper = run promise.resolve(&mut hooks, memory, realm, realm.promiseConstructor(), value.borrow(), false)
  drop value
  run promise.performThen(&mut hooks, realm, wrapper.borrow(), handler.borrow(), handler.borrow(), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined))
}
unsafe effect fn settle<'a, H: HeapHooks + CoercionHooks + CallHooks + PromiseHooks>(hooks: &mut H, realm: Realm<'a>,
  node: *mut HeapHeader, value: Value, reject: bool) -> () ? &mut Allocator {
  let anchor = () let data = unsafe HeapCell.payload<AsyncFrame, ()>(&anchor, node)
  let mut index: usize = 0 if reject { index = 1 } let method = data.resolvingFunctions[index].dup() drop data
  // start's direct capability: the completion promise itself, resolved without
  // resolving functions. The body settles once, so nothing needs their guard.
  if promise.stateOf(method.borrow()) >= 0 {
    let _settled = run Effect.result(promise.resolveDirect(&mut hooks, realm, method.borrow(), value.borrow(), reject))
    drop value
    return
  }
  drop run Effect.catch<JsException>(promise.call(&mut hooks, realm, method.borrow(), immediateRef(ValueBits.Undefined), &[value.view()]), promise.exceptionValue)
  drop value
}
unsafe effect fn resume<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, node: *mut HeapHeader) -> () ? &mut Allocator {
  let returned = run Effect.catch<JsException>(unsafe frames.resume(&mut hooks, memory, realm, node), core.exceptionValue)
  let rt = realm.runtime()
  if unsafe frames.completed(node) {
    if returned.isException() { run unsafe settle(&mut hooks, realm, node, realm.takeException(), true) }
    else { run unsafe settle(&mut hooks, realm, node, unsafe Value.adoptBits(returned), false) }
    return
  }
  unsafe gc.release(&mut hooks, rt, returned)
  let value = unsafe Value.adoptBits(unsafe frames.takeResult(node))
  let awaited = run Effect.result(unsafe awaitValue(&mut hooks, memory, realm, node, move value))
  match move awaited {
    Result<(), JsException>.Success { .. } => ()
    Result<(), JsException>.Failure { .. } => { run unsafe settle(&mut hooks, realm, node, realm.takeException(), true) }
  }
}
pub effect fn resolvingCall<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, functionRef: ValueRef<'a>, argvArgs: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  let object = ObjectRef.of(functionRef)
  let anchor = () let data = object.data(&anchor)
  // An await handler throws on a second argument of true (promise.dispatchJob).
  let reject = data.classId() == classes.JS_CLASS_ASYNC_FUNCTION_REJECT ||
    (argvArgs.slots().length() > 1 && match argvArgs.get(1).view() { ValueBits.Bool { value: flag } => flag _ => false })
  drop data
  return run unsafe resumeWith(&mut hooks, memory, realm, object, argvArgs.get(0).view(), reject)
}
/// resolvingCall of object with its settled input, thrown into the body when reject.
unsafe effect fn resumeWith<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ObjectRef<'b>, input: ValueBits, reject: bool) -> ValueBits ! JsException ? &mut Allocator {
  let node = match Pointer.nonNullMut<HeapHeader>(storage(object)) { Option<*mut HeapHeader>.Some { value } => value _ => invariant() }
  let frameAnchor = () let frameData = unsafe HeapCell.payload<AsyncFrame, ()>(&frameAnchor, node)
  let source = frameData.frame.get().currentFunction drop frameData
  let realm = run constructors.getFunctionRealm(&mut hooks, realm, unsafe lendBits(&source, source))
  unsafe frames.throwing(node, reject)
  if reject {
    let _pending = run Effect.catch<JsException>(realm.throwValue<ValueBits, H>(&mut hooks, unsafe Value.retain(input)), core.exceptionValue)
  } else { unsafe frames.putResult(node, unsafe input.retained()) }
  // Async stack traces start from the function this settlement resumes.
  let mut stateAnchor = () let state = realm.runtimeStateMut(&mut stateAnchor)
  let outer = state.awaitResumed state.awaitResumed = node
  let outerReaction = state.reactionResolve state.reactionResolve = ValueBits.Undefined drop state
  run unsafe resume(&mut hooks, memory, realm, node)
  let restored = realm.runtimeStateMut(&mut stateAnchor) restored.awaitResumed = outer restored.reactionResolve = outerReaction
  return ValueBits.Undefined
}
/// promise.dispatchJob's REACTION_JOB for an await's reaction (an await handler and
/// no capability, as awaitValue and queueFulfilled queue it): the handler's body
/// resumes here, without the generic call of its class callback. Uninitialized
/// leaves the job to dispatchJob untouched; otherwise the job's result.
pub unsafe effect fn awaitReactionJob<'a, 's, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, arguments: Arguments<'s>) -> ValueBits ! JsException ? &mut Allocator {
  let handler = arguments.get(2).view()
  let reference = match handler { ValueBits.Object { reference } => reference _ => { return ValueBits.Uninitialized } }
  if !core.undefined(arguments.get(0).view()) || !core.undefined(arguments.get(1).view()) { return ValueBits.Uninitialized }
  let rejected = match arguments.get(3).view() { ValueBits.Bool { value: flag } => flag _ => { return ValueBits.Uninitialized } }
  let object = unsafe ObjectRef.lend(&reference, reference)
  let anchor = ()
  if object.data(&anchor).classId() != classes.JS_CLASS_ASYNC_FUNCTION_RESOLVE { return ValueBits.Uninitialized }
  // A side-effect-free evaluation refuses the handler on the generic call path.
  if restricted.active(realm) { return ValueBits.Uninitialized }
  // As the generic call would: poll, then run the handler, whose failure ends the
  // job unless the runtime is terminating (dispatchJob drops it otherwise).
  let outcome = run Effect.catch<JsException>(unsafe resumeAwait(&mut hooks, memory, realm, object, arguments.get(4).view(), rejected), core.exceptionValue)
  if outcome.isException() {
    if promise.terminating(realm) { fail JsException {} }
    drop realm.takeException()
  }
  return ValueBits.Undefined
}
unsafe effect fn resumeAwait<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, object: ObjectRef<'b>, input: ValueBits, reject: bool) -> ValueBits ! JsException ? &mut Allocator {
  if interrupts.due(realm) { run interrupts.handle(&mut hooks, memory, realm) }
  return run unsafe resumeWith(&mut hooks, memory, realm, object, input, reject)
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>) -> ValueBits ! JsException ? &mut Allocator {
  return run callWithHandling(&mut hooks, memory, realm, function, receiver, args, false)
}
/// Internal consumers own the completion and must never report the private body
/// Promise as unhandled, including while unwinding an uncatchable interruption.
pub effect fn callHandled<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>) -> Value ! JsException ? &mut Allocator {
  return unsafe Value.adoptBits(run callWithHandling(&mut hooks, memory, realm, function, receiver, args, true))
}
/// An async body call that keeps its frame: the completion promise, as callHandled
/// gives it, and an owned reference to the body's AsyncFrame.
pub struct KeptCall { pub promise: Value, pub frame: *mut HeapHeader }
pub effect fn callKeepingFrame<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>) -> KeptCall ! JsException ? &mut Allocator {
  let started = run start(&mut hooks, memory, realm, function, receiver, args, true)
  return KeptCall { promise: unsafe Value.adoptBits(started.promise), frame: started.frame }
}
effect fn callWithHandling<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, callerRealm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>, handled: bool) -> ValueBits ! JsException ? &mut Allocator {
  if direct(callerRealm, function) { return run callDirect(&mut hooks, memory, callerRealm, function, receiver, args, handled) }
  let started = run start(&mut hooks, memory, callerRealm, function, receiver, args, handled)
  unsafe gc.releaseHeader(&mut hooks, callerRealm.runtime(), started.frame)
  return started.promise
}
/// Whether function's body never suspends (js_bytecode.CONSTRUCT_ASYNC_DIRECT),
/// so callDirect may run it without an AsyncFrame. Async hooks and a
/// side-effect-free evaluation keep the frame's path.
fn direct<'a, 'b>(realm: Realm<'a>, function: ValueRef<'b>) -> bool {
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function.view()))
  let bytecode = match &object.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { return false } }
  drop object
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  if code.constructForm != bytecodes.CONSTRUCT_ASYNC_DIRECT || code.kind != FunctionKind.Async { return false }
  drop code
  return !restricted.active(realm) && !unsafe runtime.asyncHooksEnabled(realm.runtime())
}
/// start for a body that never suspends: the completion promise is made, then
/// the body runs to its end as a plain call (vm.callAsyncBody), and its return
/// value or exception settles the promise as settle would. Nothing could see
/// the AsyncFrame start would make, or the frame's await handler.
effect fn callDirect<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, callerRealm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>, handled: bool) -> ValueBits ! JsException ? &mut Allocator {
  if callerRealm.stackOverflows(currentFrameAddress(), 0) { return run errors.throwStackOverflow(&mut hooks, memory, callerRealm) }
  let realm = run constructors.getFunctionRealm(&mut hooks, callerRealm, function)
  let output = run promise.createPending(&mut hooks, memory, realm)
  if handled { run promise.markHandled(&mut hooks, realm, output.borrow()) }
  let returned = run Effect.catch<JsException>(unsafe vm.callAsyncBody(&mut hooks, memory, realm.context(), function.view(), receiver.view(), args.slots()), core.exceptionValue)
  let mut value = Value.immediate(ValueBits.Undefined)
  let reject = returned.isException()
  if reject { value = realm.takeException() } else { value = unsafe Value.adoptBits(returned) }
  let _settled = run Effect.result(promise.resolveDirect(&mut hooks, realm, output.borrow(), value.borrow(), reject))
  drop value
  return output.intoBits()
}
/// The completion promise of a body that never suspends and ran inline in the
/// dispatch loop (js_vm.settleAsyncInline): its result, or its exception when
/// reject, settles it as callDirect's settles it.
pub effect fn settleInline<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, realm: Realm<'a>, value: ValueRef<'b>, reject: bool) -> ValueBits ! JsException ? &mut Allocator {
  let output = run promise.createPending(&mut hooks, memory, realm)
  let _settled = run Effect.result(promise.resolveDirect(&mut hooks, realm, output.borrow(), value, reject))
  return output.intoBits()
}
// The started body's completion promise and its AsyncFrame, both owned.
struct Started { promise: ValueBits, frame: *mut HeapHeader }
effect fn start<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks + PromiseHooks>(hooks: &mut H,
  memory: &AllocationObserver, callerRealm: Realm<'a>, function: ValueRef<'b>, receiver: ValueRef<'b>, args: Arguments<'a>, handled: bool) -> Started ! JsException ? &mut Allocator {
  // Promise capability and await assimilation belong to the async function,
  // even when its caller or a later settling job belongs to another realm.
  // V8 checks the stack on entry, before the body's implicit catch: the call
  // throws rather than returning a rejected promise.
  if callerRealm.stackOverflows(currentFrameAddress(), 0) { return run errors.throwStackOverflow(&mut hooks, memory, callerRealm) }
  let realm = run constructors.getFunctionRealm(&mut hooks, callerRealm, function)
  let node = run frames.create(&mut hooks, realm, function, receiver, args)
  // A direct capability: the completion promise stands for both of its resolving
  // functions (promise.resolveDirect), which no script can reach.
  let created = run Effect.result(promise.createPending(&mut hooks, memory, realm))
  let output = match move created {
    Result<Value, JsException>.Success { value } => move value
    Result<Value, JsException>.Failure { error } => { unsafe gc.releaseHeader(&mut hooks, realm.runtime(), node) fail move error }
  }
  if handled { run promise.markHandled(&mut hooks, realm, output.borrow()) }
  let mut anchor = () let data = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, node)
  data.resolvingFunctions = [output.dup(), output.dup()] drop data
  run unsafe resume(&mut hooks, memory, realm, node)
  return Started { promise: output.intoBits(), frame: node }
}
