//! `getComputedStyle` for one longhand of one node, as CSS text. The properties the tree keeps
//! typed and animates come from the node's computed style, so a transition's current value
//! shows; box sizes, margins, padding and border widths are the used values of the last layout;
//! every other longhand is its cascaded value with lengths in pixels, the parent's when it
//! inherits, or its initial value. Shorthands and custom properties answer nothing.
import engine { UiTree }
import node { NONE, NO_INDEX }
import mutation { NodeKind, Declaration, CssProperty }
import motion
import motion { Sample }
import font_units
import transform
import transform { TransformList }
import style { Computed }
import properties.catalog
import properties.shorthands
import properties.convert
import properties.convert { Context }
import properties.keywords
import properties.keywords { Keyword }
import properties.values
import properties.values { Value, Unit }
import properties.computed { Fill, Visibility, SizeValue, DimensionKind, Display, DisplayInside, DisplayOutside, BoxSizing }
import properties.computed { WhiteSpaceCollapse, TextWrap }
import properties.values { Separator }
import ui_protocol.error { TreeError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.num.f32
import silk.num.i64
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Appends the computed value of longhand `name` (lowercase, as in `getPropertyValue`) of node
/// `id` to `out`. Says whether there is one: false for a node that is gone, a text node, a
/// shorthand or a name CSS does not have. Resolves pending styles first, and lays out only for
/// the sizes and box edges that read layout, as browsers do.
pub effect fn write(tree: &mut UiTree<'_>, id: u32, name: &[u8], out: &mut Bytes) -> bool
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let slot = tree.slotOf(id)
  if slot == NONE || tree.node(slot).kind == NodeKind.Text { return false }
  if name.length > 2 && name[0] == 45 && name[1] == 45 {
    run tree.stylesNow()
    return run tree.customProperty(slot, name, &mut out.*)
  }
  let property = match catalog.lookup(name) {
    Option.Some { value } => value
    _ => { return false }
  }
  let spacing = name == b"white-space" || name == b"white-space-collapse" || name == b"text-wrap-mode"
  if catalog.longhandCount(property) > 1 && !spacing { return false }
  let field = fieldOf(name)
  if usesLayout(field) {
    if tree.layoutPending() { run tree.layoutNow() }
  } else {
    run tree.stylesNow()
  }
  if spacing {
    run whiteSpace(&tree.node(slot).computed().*, name, &mut out.*)
    return true
  }
  if field != motion.FIELDS {
    if run used(&tree.*, slot, field, &mut out.*) { return true }
    run typed(&tree.node(slot).computed().*, field, &mut out.*)
    return true
  }
  run cascaded(&tree.*, slot, property, &mut out.*)
  return true
}

/// `white-space` and its longhands from the computed style, which is where the shorthand
/// lands: the declarations alone would miss `white-space: pre-wrap` for `white-space-collapse`.
effect fn whiteSpace(computed: &Computed, name: &[u8], out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  let collapse = computed.text.whiteSpaceCollapse
  let wrap = computed.text.textWrap == TextWrap.Wrap
  let collapseName = match collapse {
    WhiteSpaceCollapse.Collapse => b"collapse"
    WhiteSpaceCollapse.Discard => b"discard"
    WhiteSpaceCollapse.Preserve => b"preserve"
    WhiteSpaceCollapse.PreserveBreaks => b"preserve-breaks"
    WhiteSpaceCollapse.PreserveSpaces => b"preserve-spaces"
    WhiteSpaceCollapse.BreakSpaces => b"break-spaces"
  }
  if name == b"white-space-collapse" {
    run out.append(collapseName)
    return
  }
  if name == b"text-wrap-mode" {
    run out.append(if wrap { b"wrap" } else { b"nowrap" })
    return
  }
  if collapse == WhiteSpaceCollapse.Collapse {
    run out.append(if wrap { b"normal" } else { b"nowrap" })
  } else if collapse == WhiteSpaceCollapse.Preserve {
    run out.append(if wrap { b"pre-wrap" } else { b"pre" })
  } else if collapse == WhiteSpaceCollapse.PreserveBreaks && wrap {
    run out.append(b"pre-line")
  } else if collapse == WhiteSpaceCollapse.BreakSpaces && wrap {
    run out.append(b"break-spaces")
  } else {
    run out.append(collapseName)
    if !wrap { run out.append(b" nowrap") }
  }
}

fn fieldOf(name: &[u8]) -> u32 {
  let mut field: u32 = 0
  while field < motion.FIELDS {
    if name == motion.fieldName(field) { return field }
    field = field + 1
  }
  return motion.FIELDS
}

/// `value` as CSSOM writes it. Whole numbers, which most used lengths are, skip the float
/// formatter: it is most of the cost of a read.
effect fn number(out: &mut Bytes, value: f32) -> () ! OutOfMemoryError ? &mut Allocator {
  if value != f32.round(value) || value > 1000000.0 || value < -1000000.0 {
    run values.writeNumber(&mut out.*, value)
    return
  }
  let mut whole = f32.toI64(value)
  if whole < 0 {
    run out.append(b"-")
    whole = 0 - whole
  }
  let mut digits: [u8; 8] = [0; 8]
  let mut count: usize = 0
  while count == 0 || whole > 0 {
    digits[7 - count] = i64.toU8(48 + whole % 10)
    whole = whole / 10
    count = count + 1
  }
  run out.append(Slice.view<u8>(&digits, 8 - count, count))
}

effect fn px(out: &mut Bytes, value: f32) -> () ! OutOfMemoryError ? &mut Allocator {
  run number(&mut out.*, value)
  run out.append(b"px")
}

/// The used value of a box-model field from the node's first fragment; false when the field has
/// none or layout gave the node no box (`display: none`, or `width` of an inline box, which
/// browsers answer with the computed value too).
/// Whether `used` may answer `field` from layout: sizes and box edges.
fn usesLayout(field: u32) -> bool {
  return field == motion.WIDTH || field == motion.WIDTH + 1
    || field >= motion.MARGIN && field < motion.INSET || field >= motion.BORDER_WIDTH && field < motion.ROW_GAP
}

effect fn used(tree: &UiTree<'_>, slot: u32, field: u32, out: &mut Bytes) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !usesLayout(field) { return false }
  let isSize = field == motion.WIDTH || field == motion.WIDTH + 1
  let node = tree.node(slot)
  if node.css >= tree.fragmentOf.length() { return false }
  let index = tree.fragmentOf.get(node.css)
  if index == NO_INDEX { return false }
  let computed = &node.computed().*
  if isSize && match computed.layout.display {
    Display.Box { outside, inside } => inside == DisplayInside.Flow && outside == DisplayOutside.Inline
    _ => true
  } { return false }
  let fragment = tree.visualFragment(index)
  let content = fragment.contentRect
  let padding = fragment.paddingRect
  let borderBox = computed.layout.boxSizing == BoxSizing.BorderBox
  let value = if field == motion.WIDTH {
    if borderBox { fragment.size.width } else { content.width }
  } else if field == motion.WIDTH + 1 {
    if borderBox { fragment.size.height } else { content.height }
  } else if field == motion.MARGIN { fragment.usedMargin.top }
  else if field == motion.MARGIN + 1 { fragment.usedMargin.right }
  else if field == motion.MARGIN + 2 { fragment.usedMargin.bottom }
  else if field == motion.MARGIN + 3 { fragment.usedMargin.left }
  else if field == motion.PADDING { content.y - padding.y }
  else if field == motion.PADDING + 1 { padding.x + padding.width - content.x - content.width }
  else if field == motion.PADDING + 2 { padding.y + padding.height - content.y - content.height }
  else if field == motion.PADDING + 3 { content.x - padding.x }
  else if field == motion.BORDER_WIDTH { padding.y }
  else if field == motion.BORDER_WIDTH + 1 { fragment.size.width - padding.x - padding.width }
  else if field == motion.BORDER_WIDTH + 2 { fragment.size.height - padding.y - padding.height }
  else { padding.x }
  run px(&mut out.*, value)
  return true
}

effect fn size(out: &mut Bytes, value: SizeValue) -> () ! OutOfMemoryError ? &mut Allocator {
  match value.kind {
    DimensionKind.Length => run px(&mut out.*, value.value)
    DimensionKind.Percent => {
      run values.writeNumber(&mut out.*, value.percent * 100.0)
      run out.append(b"%")
    }
    DimensionKind.Calc => {
      run out.append(b"calc(")
      run values.writeNumber(&mut out.*, value.percent * 100.0)
      run out.append(b"% + ")
      run px(&mut out.*, value.value)
      run out.append(b")")
    }
    DimensionKind.Auto => run out.append(b"auto")
    DimensionKind.None => run out.append(b"none")
    DimensionKind.Normal => run out.append(b"normal")
    DimensionKind.MinContent => run out.append(b"min-content")
    DimensionKind.MaxContent => run out.append(b"max-content")
    DimensionKind.FitContent => run out.append(b"fit-content")
    DimensionKind.Content => run out.append(b"content")
    _ => {
      // min(), max() and clamp() of a length and a percentage resolve only against a box.
      run out.append(b"calc(")
      run values.writeNumber(&mut out.*, value.percent * 100.0)
      run out.append(b"% + ")
      run px(&mut out.*, value.value)
      run out.append(b")")
    }
  }
}

/// An origin offset: `length` pixels plus `fraction` of the box, which a computed value lacks.
effect fn offset(out: &mut Bytes, length: f32, fraction: f32) -> () ! OutOfMemoryError ? &mut Allocator {
  if fraction == 0.0 {
    run px(&mut out.*, length)
    return
  }
  if length == 0.0 {
    run values.writeNumber(&mut out.*, fraction * 100.0)
    run out.append(b"%")
    return
  }
  run out.append(b"calc(")
  run values.writeNumber(&mut out.*, fraction * 100.0)
  run out.append(b"% + ")
  run px(&mut out.*, length)
  run out.append(b")")
}

effect fn matrix(out: &mut Bytes, list: &TransformList) -> () ! OutOfMemoryError ? &mut Allocator {
  if list.count == 0 {
    run out.append(b"none")
    return
  }
  // Percentages in translate() resolve against the border box, which a computed value lacks.
  let m = transform.listMatrixOf(list, 0.0, 0.0).values
  let flat = m[2] == 0.0 && m[3] == 0.0 && m[6] == 0.0 && m[7] == 0.0 && m[8] == 0.0 && m[9] == 0.0
    && m[10] == 1.0 && m[11] == 0.0 && m[14] == 0.0 && m[15] == 1.0
  let order2d: [usize; 6] = [0, 1, 4, 5, 12, 13]
  if flat {
    run out.append(b"matrix(")
    let mut i: usize = 0
    while i < 6 {
      if i > 0 { run out.append(b", ") }
      run values.writeNumber(&mut out.*, m[order2d[i]])
      i = i + 1
    }
  } else {
    run out.append(b"matrix3d(")
    let mut i: usize = 0
    while i < 16 {
      if i > 0 { run out.append(b", ") }
      run values.writeNumber(&mut out.*, m[i])
      i = i + 1
    }
  }
  run out.append(b")")
}

/// A field as the tree computed it.
effect fn typed(computed: &Computed, field: u32, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  match motion.sample(computed, field) {
    Sample.Number { value } => {
      if field == motion.OPACITY || field == motion.FLEX_GROW || field == motion.FLEX_SHRINK {
        run number(&mut out.*, value)
      } else if field == motion.BACKDROP {
        if value == 0.0 { run out.append(b"none") } else {
          run out.append(b"blur(")
          run px(&mut out.*, value)
          run out.append(b")")
        }
      } else {
        run px(&mut out.*, value)
      }
    }
    Sample.Color { value } => run values.writeColor(&mut out.*, value)
    Sample.Length { value } => run size(&mut out.*, value)
    Sample.Background { value } => match value {
      Fill.Solid { color } => run values.writeColor(&mut out.*, color)
      _ => run out.append(b"rgba(0, 0, 0, 0)")
    }
    Sample.Shadow { value, present } => {
      if !present { run out.append(b"none") } else {
        run values.writeColor(&mut out.*, value.color)
        run out.append(b" ")
        run px(&mut out.*, value.offsetX)
        run out.append(b" ")
        run px(&mut out.*, value.offsetY)
        run out.append(b" ")
        run px(&mut out.*, value.blur)
        run out.append(b" ")
        run px(&mut out.*, value.spread)
        if value.inset { run out.append(b" inset") }
      }
    }
    Sample.Seen { value } => run out.append(
      if value == Visibility.Hidden { b"hidden" } else if value == Visibility.Collapse { b"collapse" } else { b"visible" },
    )
    Sample.Shown { value } => run out.append(keywords.name(convert.displayKeyword(value)))
    Sample.List { value } => run matrix(&mut out.*, &value)
    Sample.Distance { value } => if value == 0.0 { run out.append(b"none") } else { run px(&mut out.*, value) }
    Sample.Function { value } => {
      if value.kind == transform.NO_OP { run out.append(b"none") } else {
        let mut list = TransformList.none()
        list.count = 1
        list.ops[0] = value
        run matrix(&mut out.*, &list)
      }
    }
    Sample.Place { value } => {
      run offset(&mut out.*, value.x, value.xp)
      run out.append(b" ")
      run offset(&mut out.*, value.y, value.yp)
      if value.z != 0.0 {
        run out.append(b" ")
        run px(&mut out.*, value.z)
      }
    }
    Sample.Along { pixels, fraction } => run offset(&mut out.*, pixels, fraction)
    Sample.Turn { value, auto } => {
      if auto { run out.append(b"auto") }
      if !auto || value != 0.0 {
        if auto { run out.append(b" ") }
        run values.writeNumber(&mut out.*, value * 180.0 / 3.14159265)
        run out.append(b"deg")
      }
    }
    // `filter` is not a `Computed` field (`fieldOf` never gives it): it reads as cascaded.
    Sample.Filters { .. } => run out.append(b"none")
    Sample.Spot { value, kind } => {
      if kind == transform.PLACE_AUTO { run out.append(b"auto") } else if kind == transform.PLACE_NORMAL {
        run out.append(b"normal")
      } else {
        run offset(&mut out.*, value.x, value.xp)
        run out.append(b" ")
        run offset(&mut out.*, value.y, value.yp)
      }
    }
  }
}

/// The last declaration of `property` in `list`, or of a shorthand of it, as a longhand value.
effect fn lastIn(list: &[Declaration], property: CssProperty) -> Option<Value> ! OutOfMemoryError ? &mut Allocator {
  let mut i = list.length
  while i > 0 {
    i = i - 1
    let declaration = &list[i]
    if declaration.property == property { return Option<Value>.some(run values.clone(&declaration.value)) }
    if covers(declaration.property, property) {
      if let Option<Value>.Some { value } = run shorthands.longhand(declaration.property, &declaration.value, property) {
        return Option<Value>.some(move value)
      }
    }
  }
  return Option<Value>.None
}

fn covers(shorthand: CssProperty, property: CssProperty) -> bool {
  let count = catalog.longhandCount(shorthand)
  if count < 2 { return false }
  let mut j: usize = 0
  while j < count {
    if catalog.longhandAt(shorthand, j) == property { return true }
    j = j + 1
  }
  return false
}

/// The node's winning declaration of `property`, if it has one.
effect fn declared(tree: &UiTree<'_>, slot: u32, property: CssProperty) -> Option<Value> ! OutOfMemoryError ? &mut Allocator {
  let node = tree.node(slot)
  if let Option.Some { value: sheet } = node.sheetStyle() {
    let important = run lastIn(sheet.overrides.asSlice(), property)
    if important.isSome() { return move important }
    return run lastIn(sheet.declarations.asSlice(), property)
  }
  if tree.focused == slot {
    if tree.focusVisible || node.kind == NodeKind.Input {
      let found = run lastIn(node.focusVisible(), property)
      if found.isSome() { return move found }
    }
    let found = run lastIn(node.focus(), property)
    if found.isSome() { return move found }
  }
  if node.pressed {
    let found = run lastIn(node.active(), property)
    if found.isSome() { return move found }
  }
  if node.hovered {
    let found = run lastIn(node.hover(), property)
    if found.isSome() { return move found }
  }
  return run lastIn(node.base.asSlice(), property)
}

fn named(value: &Value, word: Keyword) -> bool {
  return match &value.* {
    Value.Keyword { value: found } => found == word
    _ => false
  }
}

/// A cascaded longhand: the node's declaration, else the parent's for an inherited property,
/// else the initial value.
effect fn cascaded(tree: &UiTree<'_>, slot: u32, property: CssProperty, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = slot
  while at != NONE {
    let found = if tree.node(at).kind == NodeKind.Text { Option<Value>.None } else { run declared(tree, at, property) }
    if let Option<Value>.Some { value } = move found {
      let inherits = named(&value, Keyword.Inherit) || named(&value, Keyword.Unset) && catalog.inherited(property)
      if !inherits {
        if named(&value, Keyword.Initial) || named(&value, Keyword.Unset) { break }
        let node = tree.node(at)
        let context = font_units.context(tree, at, &node.computed().*, node.fontKey)
        run absolute(&mut out.*, &value, &context, &node.computed().*)
        return
      }
    } else if !catalog.inherited(property) {
      break
    }
    at = tree.node(at).parent
  }
  let initial = catalog.initial(property)
  if initial == b"currentcolor" {
    run values.writeColor(&mut out.*, tree.node(slot).computed().text.color)
  } else {
    run out.append(initial)
  }
}

/// `value` as CSS text with its lengths in pixels and `currentcolor` as the node's color.
effect fn absolute(out: &mut Bytes, value: &Value, context: &Context, computed: &Computed) -> () ! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Value.Unit { value: amount, unit } => {
      if unit != Unit.Px {
        if let Option<f32>.Some { value: scale } = convert.pixelsPer(unit, context) {
          run px(&mut out.*, amount * scale)
          return
        }
      }
    }
    Value.Keyword { value: word } => {
      if word == Keyword.Currentcolor {
        run values.writeColor(&mut out.*, computed.text.color)
        return
      }
    }
    Value.Sequence { separator, values: items } => {
      let parts = items.asSlice()
      let mut i: usize = 0
      while i < parts.length {
        if i > 0 { run out.append(if separator == Separator.Comma { b", " } else if separator == Separator.Slash { b" / " } else { b" " }) }
        run absolute(&mut out.*, &parts[i], context, computed)
        i = i + 1
      }
      return
    }
    _ => {}
  }
  run values.write(&mut out.*, value)
}

/// Whether `name`, a CSS longhand or shorthand, changes over time in `@keyframes` and
/// `transition`. ui-protocol's `animatable` list (what the build warns about) follows this.
pub fn animates(name: &[u8]) -> bool {
  return name != b"all" && motion.propertyMask(name) != 0
}

