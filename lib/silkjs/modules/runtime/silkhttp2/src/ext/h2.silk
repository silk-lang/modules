pub unsafe fn nghttp2_session_del(session: ?*mut u8) -> () {
  if Pointer.isNull<u8>(session) { return () }
  let sp = unsafe sessionOf(session)
  let mut a = () let s = unsafe ses(&mut a, sp)
  // Streams and their DATA items.
  let mut p = s.streams s.streams = nullStream()
  let aob = s.aob s.aob = nullItem()
  while !Pointer.isNull<Stream>(p) {
    let owned = unsafe Pointer.take<Stream>(unsafe nonnull(p))
    if !Pointer.isNull<Item>(owned.item) && Pointer.address<Item>(unsafe Intrinsic.pointerRequalify<?*mut Item, ?*const Item>(owned.item)) != Pointer.address<Item>(unsafe Intrinsic.pointerRequalify<?*mut Item, ?*const Item>(aob)) { unsafe freeItem(owned.item) }
    unsafe free(unsafe Intrinsic.pointerReinterpret<?*mut Stream, ?*mut u8>(p))
    p = owned.next
  }
  unsafe freeItem(aob)
  unsafe freeQueue(&mut s.urgent) unsafe freeQueue(&mut s.regular) unsafe freeQueue(&mut s.syn)
  let mut f = s.inflight
  while !Pointer.isNull<Inflight>(f) {
    let mut owned = unsafe Pointer.take<Inflight>(unsafe nonnull(f))
    unsafe owned.entries.release()
    unsafe free(unsafe Intrinsic.pointerReinterpret<?*mut Inflight, ?*mut u8>(f))
    f = owned.next
  }
  unsafe releaseTable(&mut s.hdInflate.table) unsafe releaseTable(&mut s.hdDeflate.table) unsafe releaseCodes(&mut s.hdDeflate)
  unsafe s.frameBuf.release() unsafe s.chunkEnds.release() unsafe s.lbuf.release() unsafe s.block.release() unsafe s.decoded.release() unsafe s.iv.release()
  drop s
  let owned = unsafe Pointer.take<Session>(sp) drop owned
  unsafe free(session)
}

// Submissions.
unsafe fn copyNva(item: *mut Item, entries: ?*mut NV, count: usize) -> bool {
  let mut b = () let it = unsafe itm(&mut b, item)
  let mut i: usize = 0
  while i < count {
    let nv = unsafe Pointer.read<NV>(unsafe Intrinsic.pointerRequalify<*mut NV, *const NV>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut NV>(unsafe at(unsafe Intrinsic.pointerReinterpret<?*mut NV, ?*mut u8>(entries), i * Layout.of<NV>().bytes))))
    if !unsafe it.nva.pushU32(usize.toU32(nv.nameLength)) || !unsafe it.nva.pushU32(usize.toU32(nv.valueLength)) || !unsafe it.nva.push(nv.flags)
      || !unsafe it.nva.append(unsafe constant(nv.name), nv.nameLength) || !unsafe it.nva.append(unsafe constant(nv.value), nv.valueLength) { return false }
    i = i + 1
  }
  it.count = count
  return true
}
unsafe fn submitHeadersShared(sp: *mut Session, flags: u8, streamId: i32, entries: ?*mut NV, count: usize, provider: ?*mut Provider) -> i32 {
  let mut id = streamId
  let mut category = HCAT_HEADERS
  let mut a = ()
  if id == -1 {
    let s = unsafe ses(&mut a, sp)
    if s.nextStreamId > 2147483647 { return ERR_STREAM_ID_NOT_AVAILABLE }
    id = u32.wrappingToI32(s.nextStreamId) s.nextStreamId = s.nextStreamId + 2
    category = HCAT_REQUEST
  }
  let p = unsafe newItem(HEADERS, id)
  if Pointer.isNull<Item>(p) { return ERR_NOMEM }
  let item = unsafe nonnull(p)
  if !unsafe copyNva(item, entries, count) { unsafe freeItem(p) return ERR_NOMEM }
  let mut b = () let it = unsafe itm(&mut b, item)
  it.flags = u8.bitOr(u8.bitAnd(flags, u8.bitOr(F_END_STREAM, F_PRIORITY)), F_END_HEADERS) it.category = category
  if !Pointer.isNull<Provider>(provider) { it.provider = unsafe Pointer.read<Provider>(unsafe nonnull(provider)) it.hasProvider = true }
  drop it
  let rv = unsafe addItem(sp, item)
  if rv != 0 { unsafe freeItem(p) return rv }
  if category == HCAT_REQUEST { return id }
  return 0
}
pub unsafe fn nghttp2_submit_headers(session: ?*mut u8, flags: u8, stream: i32, priority: ?*mut Priority, entries: ?*mut NV, count: usize, user: ?*mut u8) -> i32 {
