//! Stage 7 determinism and activation tests: verifies parallel selector matching and
//! parallel text shaping produce bit-identical `paintHash`, `fontKey`, `rendered`,
//! `DigestBox`, and `DigestText` outputs compared to serial execution, across initial
//! layout and incremental mutations.
import ui_tree.legacy { UiTree, TreeError, Batch, FrameInput, Input, NodeKind, Attribute, Mutation }
import ui_tree.digest { DigestBox, DigestText, digestLayout }
import ui_transport.pool { Pools }
import ui_fixtures.fixtures as fixtures
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.tokens { CssError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.num.u32
import silk.num.usize

const SHEET_CSS: string = ".wrap { display: flex; flex-direction: column; gap: 6px; width: 640px; padding: 8px; font-family: 'Noto Sans'; font-size: 14px; } .card { display: flex; flex-direction: column; gap: 4px; padding: 6px; border: 1px solid #444; background: #181a1f; } .card[data-active=\"true\"] { background: #203048; } .card > .title { font-weight: 700; color: #f0f4ff; } .card > .row { display: flex; flex-direction: row; gap: 6px; @starting-style { opacity: 0; } opacity: 1; } .card:hover > .title { color: #ffaa44; } .pill { padding: 0 4px; background: #334; color: #ddd; font-size: 12px; } .tag { padding: 0 3px; border: 1px solid #666; color: #9ecbff; } .rtl { direction: rtl; color: #e2e8f0; } .pre { white-space: pre-wrap; color: #cbd5e1; }"

struct CardIds {
  card: u32,
  edited: u32,
}

impl Copy for CardIds {}

struct BuildResult {
  nextId: u32,
  toggleCard: u32,
  editTextNode: u32,
  appendHost: u32,
}

impl Copy for BuildResult {}

struct BuiltFixture {
  mutations: List<Mutation>,
  info: BuildResult,
}

effect fn addNamedText(
  batch: &mut Batch,
  parent: u32,
  next: &mut u32,
  cls: string,
  text: string,
) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let boxId = next.*
  next.* = next.* + 1
  let textId = next.*
  next.* = next.* + 1
  run batch.create(boxId, NodeKind.Box)
  run batch.attribute(boxId, Attribute.ClassName { value: run String.copy(cls) })
  run batch.append(parent, boxId)
  run batch.text(boxId, textId, text)
  return textId
}

effect fn numberedString(prefix: string, n: usize, suffix: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = run String.copy(prefix)
  let digits = "0123456789"
  let d1 = (n / 10) % 10
  let d0 = n % 10
  run out.append(String.slice(digits, d1, 1))
  run out.append(String.slice(digits, d0, 1))
  run out.append(suffix)
  return move out
}

effect fn addCard(
  batch: &mut Batch,
  host: u32,
  next: &mut u32,
  index: usize,
) -> CardIds
  ! OutOfMemoryError
  ? &mut Allocator {
  let card = next.*
  next.* = next.* + 1
  run batch.create(card, NodeKind.Box)
  run batch.attribute(card, Attribute.ClassName { value: run String.copy("card") })
  run batch.attribute(card, Attribute.Named {
    name: run String.copy("data-active"),
    value: Option<String>.some(run String.copy(if index % 3 == 0 { "true" } else { "false" })),
  })
  run batch.attribute(card, Attribute.Named {
    name: run String.copy("data-item"),
    value: Option<String>.some(run numberedString("id-", index, "")),
  })
  run batch.append(host, card)

  let titleOwned = if index % 4 == 0 {
    run numberedString("Card ", index, ": Alpha \u{65e5}\u{672c}\u{8a9e} Mixed Fallback")
  } else {
    run numberedString("Card ", index, ": Performance & Responsiveness Pipeline")
  }
  let edited = run addNamedText(&mut batch, card, &mut next, "title", titleOwned.view())

  let row = next.*
  next.* = next.* + 1
  run batch.create(row, NodeKind.Box)
  run batch.attribute(row, Attribute.ClassName { value: run String.copy("row") })
  run batch.attribute(row, Attribute.Named {
    name: run String.copy("data-row"),
    value: Option<String>.some(run numberedString("r-", index, "")),
  })
  run batch.append(card, row)
  let pillOwned = run numberedString("status:", index, ":ready")
  drop run addNamedText(&mut batch, row, &mut next, "pill", pillOwned.view())

  let inlineBox = next.*
  next.* = next.* + 1
  let t1 = next.*
  next.* = next.* + 1
  let span = next.*
  next.* = next.* + 1
  let t2 = next.*
  next.* = next.* + 1
  let t3 = next.*
  next.* = next.* + 1
  run batch.create(inlineBox, NodeKind.Box)
  run batch.attribute(inlineBox, Attribute.Named {
    name: run String.copy("data-inline"),
    value: Option<String>.some(run numberedString("i-", index, "")),
  })
  run batch.append(card, inlineBox)
  let t1Owned = run numberedString("   Collapsing   spaces #", index, " before ")
  run batch.text(inlineBox, t1, t1Owned.view())
  run batch.create(span, NodeKind.Box)
  run batch.attribute(span, Attribute.ClassName { value: run String.copy("tag") })
  run batch.append(inlineBox, span)
  let t2Owned = run numberedString("inline-tag-", index, "")
  run batch.text(span, t2, t2Owned.view())
  run batch.text(inlineBox, t3, "  and  trailing  words.  ")

  if index % 3 == 0 {
    drop run addNamedText(
      &mut batch,
      card,
      &mut next,
      "rtl",
      "\u{0647}\u{0630}\u{0627} \u{0646}\u{0635} \u{0639}\u{0631}\u{0628}\u{064a} \u{0637}\u{0648}\u{064a}\u{0644}",
    )
  } else if index % 3 == 1 {
    let preOwned = run numberedString("pre line ", index, "\n  indented line two")
    drop run addNamedText(&mut batch, card, &mut next, "pre", preOwned.view())
  }
  return CardIds { card: card, edited: edited }
}

effect fn buildFixtureBatch() -> BuiltFixture
  ! CompileError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("wrap") })
  run batch.root(1)
  let compiled = run compile.compile(String.utf8Bytes(SHEET_CSS), &Options.make())
  let sheetBytes = run compiled.encode()
  run batch.adoptStyleSheet(0, 1, sheetBytes.asSlice())

  let mut next: u32 = 2
  let mut toggleCard: u32 = 0
  let mut editTextNode: u32 = 0
  let mut i: usize = 0
  while i < 24 {
    let pair = run addCard(&mut batch, 1, &mut next, i)
    if i == 1 {
      toggleCard = pair.card
      editTextNode = pair.edited
    }
    i = i + 1
  }
  return BuiltFixture {
    mutations: run batch.take(),
    info: BuildResult { nextId: next, toggleCard: toggleCard, editTextNode: editTextNode, appendHost: 1 },
  }
}

effect fn assertEqualTrees(serial: &UiTree<'_>, parallel: &UiTree<'_>, label: string<'static>) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run Testing.expect(serial.stats.nodes == parallel.stats.nodes, label)
  run Testing.expect(serial.stats.fragments == parallel.stats.fragments, label)
  run Testing.expect(serial.stats.glyphs == parallel.stats.glyphs, label)
  run Testing.expect(serial.nodes.length() == parallel.nodes.length(), label)

  let mut slot: usize = 0
  while slot < serial.nodes.length() {
    let a = &serial.nodes.asSlice()[slot]
    let b = &parallel.nodes.asSlice()[slot]
    run Testing.expect(a.paintHash == b.paintHash, label)
    run Testing.expect(a.fontKey == b.fontKey, label)
    run Testing.expect(a.rendered == b.rendered, label)
    slot = slot + 1
  }

  let mut boxesA = List<DigestBox>.make()
  let mut textsA = List<DigestText>.make()
  let countsA = run digestLayout(serial, &mut boxesA, &mut textsA)
  let mut boxesB = List<DigestBox>.make()
  let mut textsB = List<DigestText>.make()
  let countsB = run digestLayout(parallel, &mut boxesB, &mut textsB)

  run Testing.expect(countsA.boxes == countsB.boxes && countsA.inlines == countsB.inlines, label)
  run Testing.expect(countsA.lines == countsB.lines && countsA.texts == countsB.texts, label)
  run Testing.expect(boxesA.length() == boxesB.length(), label)
  let mut bi: usize = 0
  while bi < boxesA.length() {
    let a = boxesA.get(bi)
    let b = boxesB.get(bi)
    run Testing.expect(
      a.inline == b.inline && a.source == b.source && a.x == b.x && a.y == b.y
        && a.width == b.width && a.height == b.height
        && a.overflowWidth == b.overflowWidth && a.overflowHeight == b.overflowHeight,
      label,
    )
    bi = bi + 1
  }

  run Testing.expect(textsA.length() == textsB.length(), label)
  let mut ti: usize = 0
  while ti < textsA.length() {
    let a = textsA.get(ti)
    let b = textsB.get(ti)
    run Testing.expect(
      a.source == b.source && a.start == b.start && a.end == b.end
        && a.fontKey == b.fontKey && a.kind == b.kind && a.bidiLevel == b.bidiLevel
        && a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height
        && a.baseline == b.baseline && a.lineTop == b.lineTop && a.lineHeight == b.lineHeight,
      label,
    )
    if a.kind == 0 {
      let ga = serial.provider.text.runGlyphs(a.shapeKey)
      let gb = parallel.provider.text.runGlyphs(b.shapeKey)
      run Testing.expect(ga.length == gb.length, label)
      let mut gi: usize = 0
      while gi < ga.length {
        run Testing.expect(
          ga[gi].glyph == gb[gi].glyph && ga[gi].x == gb[gi].x && ga[gi].y == gb[gi].y
            && ga[gi].advance == gb[gi].advance && ga[gi].cluster == gb[gi].cluster,
          label,
        )
        gi = gi + 1
      }
    }
    ti = ti + 1
  }
}

effect fn makeMutationBatch(info: BuildResult) -> List<Mutation>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.attribute(info.toggleCard, Attribute.Named {
    name: run String.copy("data-active"),
    value: Option<String>.some(run String.copy("true")),
  })
  run batch.setText(info.editTextNode, "Updated Title \u{0647}\u{0630}\u{0627} And More Words")
  let mut next = info.nextId
  drop run addCard(&mut batch, info.appendHost, &mut next, 99)
  return run batch.take()
}

effect fn parallelMatchesSerialBody() -> ()
  ! AssertionError<'static> | TreeError | CompileError | CssError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut pools = match move run Effect.result(Pools.make()) {
    Result.Success { value } => move value
    Result.Failure { error: _ } => {
      run Testing.expect(false, "Pools.make should succeed")
      fail OutOfMemoryError {}
    }
  }
  let mut serial = run UiTree.make(&fonts)
  let mut parallel = run UiTree.make(&fonts)
  parallel.setEnginePool(pools.engine.handle(), 1)

  let mut builtA = run buildFixtureBatch()
  let mut builtB = run buildFixtureBatch()
  run serial.apply(move builtA.mutations)
  run parallel.apply(move builtB.mutations)

  let f1 = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run serial.frame(f1)
  run parallel.frame(f1)

  run Testing.expect(parallel.stats.parallelStyled > 0, "parallel selector matching ran on frame 1")
  run Testing.expect(parallel.stats.parallelLaidOut >= 24, "parallel subtree layout ran on frame 1")
  run assertEqualTrees(&serial, &parallel, "frame 1 parallel vs serial matches identically")

  let mutA = run makeMutationBatch(builtA.info)
  let mutB = run makeMutationBatch(builtB.info)
  run serial.apply(move mutA)
  run parallel.apply(move mutB)
  run serial.dispatch(Input.PointerMove { x: 40.0, y: 120.0, modifiers: 0 })
  run parallel.dispatch(Input.PointerMove { x: 40.0, y: 120.0, modifiers: 0 })

  let f2 = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.016 }
  run serial.frame(f2)
  run parallel.frame(f2)
  run assertEqualTrees(&serial, &parallel, "incremental mutation parallel vs serial matches identically")

  pools.stop()
}

const INLINE_SPAN_CSS: string = ".inline-wrap { display: block; width: 640px; padding: 8px; font-family: 'Noto Sans'; font-size: 14px; } .sp { display: inline; color: #c0d0ff; }"

effect fn buildInlineSpanMutations() -> List<Mutation>
  ! CompileError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("inline-wrap") })
  run batch.root(1)
  let compiled = run compile.compile(String.utf8Bytes(INLINE_SPAN_CSS), &Options.make())
  let sheetBytes = run compiled.encode()
  run batch.adoptStyleSheet(0, 1, sheetBytes.asSlice())

  let mut next: u32 = 2
  let mut i: usize = 0
  while i < 24 {
    let owned = run numberedString("Inline span #", i, ": Mixed \u{65e5}\u{672c}\u{8a9e} Words ")
    drop run addNamedText(&mut batch, 1, &mut next, "sp", owned.view())
    i = i + 1
  }
  return run batch.take()
}

effect fn parallelInlineSpansBody() -> ()
  ! AssertionError<'static> | TreeError | CompileError | CssError | FileError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut pools = match move run Effect.result(Pools.make()) {
    Result.Success { value } => move value
    Result.Failure { error: _ } => {
      run Testing.expect(false, "Pools.make should succeed")
      fail OutOfMemoryError {}
    }
  }
  let mut serial = run UiTree.make(&fonts)
  let mut parallel = run UiTree.make(&fonts)
  parallel.setEnginePool(pools.engine.handle(), 1)

  let mutA = run buildInlineSpanMutations()
  let mutB = run buildInlineSpanMutations()
  run serial.apply(move mutA)
  run parallel.apply(move mutB)

  let frame = FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 }
  run serial.frame(frame)
  run parallel.frame(frame)

  run Testing.expect(parallel.stats.parallelShaped > 0, "inline-rich block container used parallel preShapeTree")
  run assertEqualTrees(&serial, &parallel, "inline spans preShape parallel vs serial matches identically")
  pools.stop()
}

const MULTI_CONTAINER_CSS: string = ".root { display: block; width: 720px; font-family: 'Noto Sans'; font-size: 14px; } .block-stack { display: block; width: 720px; } .bfc-card { display: flow-root; margin: 4px; padding: 6px; border: 1px solid #333; background: #141820; color: #eee; } .bfc-card[data-hi=\"true\"] { background: #224466; padding: 10px; } .grid-box { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; padding: 6px; width: 720px; } .gcell { overflow: hidden; padding: 4px; border: 1px solid #555; color: #ddd; } .gcell[data-hi=\"true\"] { border-width: 2px; color: #ffdd88; } .pos-stage { position: relative; width: 720px; height: 320px; } .tile { position: absolute; width: 140px; height: 28px; color: #f8fafc; } .tile[data-pos=\"0\"] { left: 8px; top: 8px; } .tile[data-pos=\"1\"] { left: 168px; top: 44px; } .tile[data-pos=\"2\"] { left: 328px; top: 88px; } .tile[data-pos=\"3\"] { left: 488px; top: 132px; } .tile[data-hi=\"true\"] { width: 176px; } .tlbl { display: block; font-size: 12px; color: #bae6fd; }"

struct MultiIds {
  blockEdit: u32,
  blockText: u32,
  gridEdit: u32,
  gridText: u32,
  posEdit: u32,
  posText: u32,
}

impl Copy for MultiIds {}

struct MultiFixture {
  mutations: List<Mutation>,
  ids: MultiIds,
}

effect fn buildMultiContainerFixture() -> MultiFixture
  ! CompileError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("root") })
  run batch.root(1)
  let compiled = run compile.compile(String.utf8Bytes(MULTI_CONTAINER_CSS), &Options.make())
  let sheetBytes = run compiled.encode()
  run batch.adoptStyleSheet(0, 1, sheetBytes.asSlice())

  run batch.create(2, NodeKind.Box)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("block-stack") })
  run batch.append(1, 2)
  run batch.create(3, NodeKind.Box)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("grid-box") })
  run batch.append(1, 3)
  run batch.create(4, NodeKind.Box)
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("pos-stage") })
  run batch.append(1, 4)

  let mut next: u32 = 5
  let mut ids = MultiIds { blockEdit: 0, blockText: 0, gridEdit: 0, gridText: 0, posEdit: 0, posText: 0 }

  let mut i: usize = 0
  while i < 20 {
    let card = next
    next = next + 1
    let textId = next
    next = next + 1
    run batch.create(card, NodeKind.Box)
    run batch.attribute(card, Attribute.ClassName { value: run String.copy("bfc-card") })
    run batch.append(2, card)
    let label = run numberedString("Block card #", i, " content line")
    run batch.text(card, textId, label.view())
    if i == 3 {
      ids.blockEdit = card
      ids.blockText = textId
    }
    i = i + 1
  }

  i = 0
  while i < 20 {
    let cell = next
    next = next + 1
    let textId = next
    next = next + 1
    run batch.create(cell, NodeKind.Box)
    run batch.attribute(cell, Attribute.ClassName { value: run String.copy("gcell") })
    run batch.append(3, cell)
    let label = run numberedString("Grid item #", i, "")
    run batch.text(cell, textId, label.view())
    if i == 5 {
      ids.gridEdit = cell
      ids.gridText = textId
    }
    i = i + 1
  }

  i = 0
  while i < 20 {
    let tile = next
    next = next + 1
    run batch.create(tile, NodeKind.Box)
    run batch.attribute(tile, Attribute.ClassName { value: run String.copy("tile") })
    let posBucket = run numberedString("", i % 4, "")
    let posSlice = String.slice(posBucket.view(), 1, 1)
    run batch.attribute(tile, Attribute.Named {
      name: run String.copy("data-pos"),
      value: Option<String>.some(run String.copy(posSlice)),
    })
    run batch.append(4, tile)
    let label = run numberedString("Abs tile #", i, "")
    let textId = if i % 2 == 0 {
      run addNamedText(&mut batch, tile, &mut next, "tlbl", label.view())
    } else {
      let tid = next
      next = next + 1
      run batch.text(tile, tid, label.view())
      tid
    }
    if i == 4 {
      ids.posEdit = tile
      ids.posText = textId
    }
    i = i + 1
  }

  return MultiFixture { mutations: run batch.take(), ids: ids }
}

effect fn makeMultiRestyleBatch(ids: MultiIds) -> List<Mutation>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.attribute(ids.blockEdit, Attribute.Named {
    name: run String.copy("data-hi"),
    value: Option<String>.some(run String.copy("true")),
  })
  run batch.setText(ids.blockText, "Updated block card content with longer text wrapping onto a second line")
  run batch.attribute(ids.gridEdit, Attribute.Named {
    name: run String.copy("data-hi"),
    value: Option<String>.some(run String.copy("true")),
  })
  run batch.setText(ids.gridText, "Updated Grid Item")
  run batch.attribute(ids.posEdit, Attribute.Named {
    name: run String.copy("data-hi"),
    value: Option<String>.some(run String.copy("true")),
  })
  run batch.setText(ids.posText, "Updated Tile")
  return run batch.take()
}

effect fn parallelMultiContainerBody() -> ()
  ! AssertionError<'static> | TreeError | CompileError | CssError | FileError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut pools = match move run Effect.result(Pools.make()) {
    Result.Success { value } => move value
    Result.Failure { error: _ } => {
      run Testing.expect(false, "Pools.make should succeed")
      fail OutOfMemoryError {}
    }
  }
  let mut serial = run UiTree.make(&fonts)
  let mut parallel = run UiTree.make(&fonts)
  parallel.setEnginePool(pools.engine.handle(), 1)

  let fixA = run buildMultiContainerFixture()
  let fixB = run buildMultiContainerFixture()
  run serial.apply(move fixA.mutations)
  run parallel.apply(move fixB.mutations)

  let f1 = FrameInput { width: 800.0, height: 900.0, scale: 1.0, time: 0.0 }
  run serial.frame(f1)
  run parallel.frame(f1)

  run Testing.expect(parallel.stats.parallelLaidOut >= 60, "block, grid, and positioned containers laid out in parallel")
  run assertEqualTrees(&serial, &parallel, "block+grid+abspos frame 1 parallel vs serial matches identically")

  let mutA = run makeMultiRestyleBatch(fixA.ids)
  let mutB = run makeMultiRestyleBatch(fixB.ids)
  run serial.apply(move mutA)
  run parallel.apply(move mutB)

  let f2 = FrameInput { width: 800.0, height: 900.0, scale: 1.0, time: 0.016 }
  run serial.frame(f2)
  run parallel.frame(f2)
  run assertEqualTrees(&serial, &parallel, "block+grid+abspos incremental restyle parallel vs serial matches identically")

  pools.stop()
}

test effect fn parallelStyleAndTextMatchSerialExactly() -> ()
  ! AssertionError<'static> | TreeError | CompileError | CssError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run parallelMatchesSerialBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn parallelInlineSpansPreShapeMatchesSerial() -> ()
  ! AssertionError<'static> | TreeError | CompileError | CssError | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run parallelInlineSpansBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn parallelBlockGridAbsoluteAndIncrementalMatchSerial() -> ()
  ! AssertionError<'static> | TreeError | CompileError | CssError | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run parallelMultiContainerBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

const SCROLL_FEED_CSS: string = ".app { display: flex; flex-direction: column; width: 640px; height: 480px; font-family: 'Noto Sans'; font-size: 14px; } .scroll { display: block; flex-grow: 1; min-height: 0; overflow-y: auto; scrollbar-width: thin; scrollbar-gutter: stable; overflow-x: hidden; } .feed { display: flex; flex-direction: column; gap: 8px; padding: 12px; } .fitem { display: flex; flex-direction: column; gap: 4px; padding: 8px; border: 1px solid #444; background: #1c222b; color: #f1f5f9; } .ftitle { font-weight: 700; font-size: 15px; } .fbody { font-size: 13px; color: #cbd5e1; }"

struct FeedIds {
  editBody: u32,
}

impl Copy for FeedIds {}

struct ScrollFeedFixture {
  mutations: List<Mutation>,
  ids: FeedIds,
}

effect fn buildScrollFeedFixture() -> ScrollFeedFixture
  ! CompileError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("app") })
  run batch.root(1)
  let compiled = run compile.compile(String.utf8Bytes(SCROLL_FEED_CSS), &Options.make())
  let sheetBytes = run compiled.encode()
  run batch.adoptStyleSheet(0, 1, sheetBytes.asSlice())

  run batch.create(2, NodeKind.Box)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("scroll") })
  run batch.append(1, 2)
  run batch.create(3, NodeKind.Box)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("feed") })
  run batch.append(2, 3)

  let mut next: u32 = 4
  let mut editBody: u32 = 0
  let mut i: usize = 0
  while i < 24 {
    let item = next
    next = next + 1
    run batch.create(item, NodeKind.Box)
    run batch.attribute(item, Attribute.ClassName { value: run String.copy("fitem") })
    run batch.append(3, item)
    let titleOwned = run numberedString("Feed Entry #", i, ": Parallel Flex Probe & Shape Cache")
    drop run addNamedText(&mut batch, item, &mut next, "ftitle", titleOwned.view())
    let bodyOwned = run numberedString("Summary paragraph ", i, " wrapping across narrow lines so intrinsic flex prepare exercises shaping.")
    let bText = run addNamedText(&mut batch, item, &mut next, "fbody", bodyOwned.view())
    if i == 5 {
      editBody = bText
    }
    i = i + 1
  }
  return ScrollFeedFixture { mutations: run batch.take(), ids: FeedIds { editBody: editBody } }
}

effect fn parallelFlexProbeAndScrollbarPassBody() -> ()
  ! AssertionError<'static> | TreeError | CompileError | CssError | FileError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut pools = match move run Effect.result(Pools.make()) {
    Result.Success { value } => move value
    Result.Failure { error: _ } => {
      run Testing.expect(false, "Pools.make should succeed")
      fail OutOfMemoryError {}
    }
  }
  let mut serial = run UiTree.make(&fonts)
  let mut parallel = run UiTree.make(&fonts)
  parallel.setEnginePool(pools.engine.handle(), 1)

  let fixA = run buildScrollFeedFixture()
  let fixB = run buildScrollFeedFixture()
  run serial.apply(move fixA.mutations)
  run parallel.apply(move fixB.mutations)

  let f1 = FrameInput { width: 640.0, height: 480.0, scale: 1.0, time: 0.0 }
  run serial.frame(f1)
  run parallel.frame(f1)

  run Testing.expect(parallel.stats.parallelLaidOut >= 24, "scroll+feed parallel flex prepare and pass-2 layout ran")
  run assertEqualTrees(&serial, &parallel, "scroll+feed frame 1 parallel vs serial matches identically")

  let mut modA = Batch.make()
  run modA.setText(fixA.ids.editBody, "Updated feed entry text causing re-probe and pass-2 relayout with scrollbars active.")
  let mut modB = Batch.make()
  run modB.setText(fixB.ids.editBody, "Updated feed entry text causing re-probe and pass-2 relayout with scrollbars active.")
  run serial.apply(run modA.take())
  run parallel.apply(run modB.take())

  let f2 = FrameInput { width: 640.0, height: 480.0, scale: 1.0, time: 0.016 }
  run serial.frame(f2)
  run parallel.frame(f2)
  run assertEqualTrees(&serial, &parallel, "scroll+feed incremental restyle parallel vs serial matches identically")

  pools.stop()
}

test effect fn parallelFlexProbeAndScrollbarPassMatchSerial() -> ()
  ! AssertionError<'static> | TreeError | CompileError | CssError | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run parallelFlexProbeAndScrollbarPassBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
