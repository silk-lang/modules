//! Copy one inherited computed longhand, without resolving relative units again.
import style { Computed, physicalSide }
import properties.catalog { Property }
import properties.computed { WritingMode, Direction, VerticalAlignKind }
import properties.computed
import silk.num.u8
import ui_text.fonts as fonts

/// Copies `property` from `parent`. Lengths computed at another effective zoom move to the
/// target's, as `width: inherit` under `zoom: 2` doubles.
pub fn apply(target: &mut Computed, parent: &Computed, property: Property) -> bool {
  if target.text.zoom == parent.text.zoom || parent.text.zoom <= 0.0 || property == Property.Zoom { return copy(&mut target, parent, property) }
  let zoomed = parent.zoomedBy(target.text.zoom / parent.text.zoom)
  return copy(&mut target, &zoomed, property)
}

fn copy(target: &mut Computed, parent: &Computed, property: Property) -> bool {
  match property {
    Property.WhiteSpace => {
      target.text.textWrap = parent.text.textWrap
      target.text.whiteSpace = parent.text.whiteSpace
      target.text.whiteSpaceCollapse = parent.text.whiteSpaceCollapse
    }
    Property.Cursor => { target.cursor = parent.cursor }
    Property.BorderCollapse => { target.layout.borderCollapse = parent.layout.borderCollapse }
    Property.BorderSpacing => {
      target.layout.borderSpacingX = parent.layout.borderSpacingX
      target.layout.borderSpacingY = parent.layout.borderSpacingY
    }
    Property.CaptionSide => { target.layout.captionSide = parent.layout.captionSide }
    Property.TableLayout => { target.layout.tableLayout = parent.layout.tableLayout }
    Property.EmptyCells => { target.emptyCellsHide = parent.emptyCellsHide }
    Property.AccentColor => {
      target.accentColor = parent.accentColor
      target.hasAccentColor = parent.hasAccentColor
    }
    Property.Appearance => { target.appearanceNone = parent.appearanceNone }
    Property.ContainerType => {
      target.contain.setQuery(parent.contain.query(), &mut target.layout)
    }
    Property.Contain => { target.contain.inheritContain(&parent.contain, &mut target.layout) }
    Property.ContentVisibility => { target.contain.setHidden(parent.contain.hidden(), &mut target.layout) }
    Property.Display => { target.layout.display = parent.layout.display }
    Property.BorderBlockStartStyle => { target.paint.borderStyle = parent.paint.borderStyle }
    Property.BorderBlockEndStyle => { target.paint.borderStyle = parent.paint.borderStyle }
    Property.BorderInlineStartStyle => { target.paint.borderStyle = parent.paint.borderStyle }
    Property.BorderInlineEndStyle => { target.paint.borderStyle = parent.paint.borderStyle }
    Property.BorderBlockStartColor => { target.paint.borderColor = parent.paint.borderColor }
    Property.BorderBlockEndColor => { target.paint.borderColor = parent.paint.borderColor }
    Property.BorderInlineStartColor => { target.paint.borderColor = parent.paint.borderColor }
    Property.BorderInlineEndColor => { target.paint.borderColor = parent.paint.borderColor }
    Property.OutlineWidth => { target.outline.width = parent.outline.width }
    Property.OutlineStyle => {
      target.outline.auto = parent.outline.auto
      target.outline.style = parent.outline.style
    }
    Property.OutlineColor => {
      target.outline.color = parent.outline.color
      target.outline.colorAuto = parent.outline.colorAuto
    }
    Property.OutlineOffset => { target.outline.offset = parent.outline.offset }
    Property.OverscrollBehaviorX => { target.scroll.overscrollX = parent.scroll.overscrollX }
    Property.OverscrollBehaviorY => { target.scroll.overscrollY = parent.scroll.overscrollY }
    Property.ScrollBehavior => { target.scroll.smooth = parent.scroll.smooth }
    Property.TouchAction => { target.scroll.touch = parent.scroll.touch }
    Property.OverflowAnchor => { target.scroll.anchorNone = parent.scroll.anchorNone }
    Property.ScrollSnapType => { target.scroll.snap = u8.bitOr(u8.bitAnd(target.scroll.snap, 248), u8.bitAnd(parent.scroll.snap, 7)) }
    Property.ScrollSnapAlign => { target.scroll.snap = u8.bitOr(u8.bitAnd(target.scroll.snap, 135), u8.bitAnd(parent.scroll.snap, 120)) }
    Property.ScrollSnapStop => { target.scroll.snap = u8.bitOr(u8.bitAnd(target.scroll.snap, 127), u8.bitAnd(parent.scroll.snap, 128)) }
    Property.ScrollMarginTop => { target.scroll.margin.top = parent.scroll.margin.top }
    Property.ScrollMarginRight => { target.scroll.margin.right = parent.scroll.margin.right }
    Property.ScrollMarginBottom => { target.scroll.margin.bottom = parent.scroll.margin.bottom }
    Property.ScrollMarginLeft => { target.scroll.margin.left = parent.scroll.margin.left }
    Property.ScrollPaddingTop => { target.scroll.padding.top = parent.scroll.padding.top }
    Property.ScrollPaddingRight => { target.scroll.padding.right = parent.scroll.padding.right }
    Property.ScrollPaddingBottom => { target.scroll.padding.bottom = parent.scroll.padding.bottom }
    Property.ScrollPaddingLeft => { target.scroll.padding.left = parent.scroll.padding.left }
    Property.Width => { target.layout.width = parent.layout.width }
    Property.Height => { target.layout.height = parent.layout.height }
    Property.MinWidth => { target.layout.minWidth = parent.layout.minWidth }
    Property.MinHeight => { target.layout.minHeight = parent.layout.minHeight }
    Property.MaxWidth => { target.layout.maxWidth = parent.layout.maxWidth }
    Property.MaxHeight => { target.layout.maxHeight = parent.layout.maxHeight }
    Property.FlexBasis => { target.layout.flexBasis = parent.layout.flexBasis }
    Property.RowGap => { target.layout.rowGap = parent.layout.rowGap }
    Property.ColumnGap => { target.layout.columnGap = parent.layout.columnGap }
    Property.MarginTop => { target.layout.margin.top = parent.layout.margin.top }
    Property.PaddingTop => { target.layout.padding.top = parent.layout.padding.top }
    Property.Top => { target.layout.inset.top = parent.layout.inset.top }
    Property.BorderTopWidth => { target.paint.border.top = parent.paint.border.top }
    Property.MarginRight => { target.layout.margin.right = parent.layout.margin.right }
    Property.PaddingRight => { target.layout.padding.right = parent.layout.padding.right }
    Property.Right => { target.layout.inset.right = parent.layout.inset.right }
    Property.BorderRightWidth => { target.paint.border.right = parent.paint.border.right }
    Property.MarginBottom => { target.layout.margin.bottom = parent.layout.margin.bottom }
    Property.PaddingBottom => { target.layout.padding.bottom = parent.layout.padding.bottom }
    Property.Bottom => { target.layout.inset.bottom = parent.layout.inset.bottom }
    Property.BorderBottomWidth => { target.paint.border.bottom = parent.paint.border.bottom }
    Property.MarginLeft => { target.layout.margin.left = parent.layout.margin.left }
    Property.PaddingLeft => { target.layout.padding.left = parent.layout.padding.left }
    Property.Left => { target.layout.inset.left = parent.layout.inset.left }
    Property.BorderLeftWidth => { target.paint.border.left = parent.paint.border.left }
    Property.BorderTopLeftRadius => { target.paint.radii.topLeft = parent.paint.radii.topLeft }
    Property.BorderTopRightRadius => { target.paint.radii.topRight = parent.paint.radii.topRight }
    Property.BorderBottomRightRadius => { target.paint.radii.bottomRight = parent.paint.radii.bottomRight }
    Property.BorderBottomLeftRadius => { target.paint.radii.bottomLeft = parent.paint.radii.bottomLeft }
    Property.Position => { target.layout.position = parent.layout.position }
    Property.BoxSizing => { target.layout.boxSizing = parent.layout.boxSizing }
    Property.FlexDirection => { target.layout.flexDirection = parent.layout.flexDirection }
    Property.FlexWrap => { target.layout.flexWrap = parent.layout.flexWrap }
    Property.OverflowX => { target.layout.overflowX = parent.layout.overflowX }
    Property.OverflowY => { target.layout.overflowY = parent.layout.overflowY }
    Property.UnicodeBidi => { target.layout.unicodeBidi = parent.layout.unicodeBidi }
    Property.BaselineSource => { target.layout.baselineSource = parent.layout.baselineSource }
    Property.BoxDecorationBreak => { target.layout.boxDecorationBreak = parent.layout.boxDecorationBreak }
    Property.MarginBreak => { target.layout.marginBreak = parent.layout.marginBreak }
    Property.BreakBefore => { target.layout.breakBefore = parent.layout.breakBefore }
    Property.BreakAfter => { target.layout.breakAfter = parent.layout.breakAfter }
    Property.BreakInside => { target.layout.breakInside = parent.layout.breakInside }
    Property.ScrollbarColor => { target.scroll.colors = parent.scroll.colors }
    Property.ScrollbarWidth => { target.layout.scrollbarWidth = parent.layout.scrollbarWidth }
    Property.Float => { target.layout.float = parent.layout.float }
    Property.Clear => { target.layout.clear = parent.layout.clear }
    Property.WrapFlow => { target.layout.wrapFlow = parent.layout.wrapFlow }
    Property.WrapThrough => { target.layout.wrapThrough = parent.layout.wrapThrough }
    Property.WritingMode => { target.text.writingMode = parent.text.writingMode }
    Property.TextOrientation => { target.text.textOrientation = parent.text.textOrientation }
    Property.TextAlignLast => { target.text.textAlignLast = parent.text.textAlignLast }
    Property.TextWrapMode => { target.text.textWrap = parent.text.textWrap }
    Property.TextWrapStyle => { target.text.textWrapStyle = parent.text.textWrapStyle }
    Property.WhiteSpaceCollapse => { target.text.whiteSpaceCollapse = parent.text.whiteSpaceCollapse }
    Property.TextJustify => { target.text.textJustify = parent.text.textJustify }
    Property.TextAlignAll => { target.text.align = parent.text.align }
    Property.TextAlign => { target.text.align = parent.text.align }
    Property.Direction => { target.text.direction = parent.text.direction }
    Property.FontStyle => { target.text.style = parent.text.style }
    Property.ObjectFit => { target.paint.objectFit = parent.paint.objectFit }
    Property.ImageRendering => { target.nearest = parent.nearest }
    Property.Fill => {
      target.svg.fillKind = parent.svg.fillKind
      target.svg.fill = parent.svg.fill
    }
    Property.Stroke => {
      target.svg.strokeKind = parent.svg.strokeKind
      target.svg.stroke = parent.svg.stroke
    }
    Property.StrokeWidth => { target.svg.strokeWidth = parent.svg.strokeWidth }
    Property.JustifyContent => {
      target.layout.justifyContent = parent.layout.justifyContent
      target.layout.justifyContentSafety = parent.layout.justifyContentSafety
    }
    Property.AlignItems => {
      target.layout.alignItems = parent.layout.alignItems
      target.layout.alignItemsSafety = parent.layout.alignItemsSafety
    }
    Property.AlignSelf => {
      target.layout.alignSelf = parent.layout.alignSelf
      target.layout.alignSelfSafety = parent.layout.alignSelfSafety
    }
    Property.AlignContent => {
      target.layout.alignContent = parent.layout.alignContent
      target.layout.alignContentSafety = parent.layout.alignContentSafety
    }
    Property.JustifySelf => {
      target.layout.justifySelf = parent.layout.justifySelf
      target.layout.justifySelfSafety = parent.layout.justifySelfSafety
    }
    Property.JustifyItems => {
      target.layout.justifyItems = parent.layout.justifyItems
      target.layout.justifyItemsSafety = parent.layout.justifyItemsSafety
    }
    Property.ScrollbarGutter => { target.layout.scrollbarGutter = parent.layout.scrollbarGutter }
    Property.AlignmentBaseline => {
      let kind = parent.layout.verticalAlign.kind
      target.layout.verticalAlign.kind = if kind == VerticalAlignKind.Shift || kind == VerticalAlignKind.Sub || kind == VerticalAlignKind.Super { VerticalAlignKind.Baseline } else { kind }
    }
    Property.BaselineShift => {
      let kind = parent.layout.verticalAlign.kind
      target.layout.verticalAlign.shift = parent.layout.verticalAlign.shift
      if kind == VerticalAlignKind.Shift || kind == VerticalAlignKind.Sub || kind == VerticalAlignKind.Super { target.layout.verticalAlign.kind = kind }
    }
    Property.VerticalAlign => { target.layout.verticalAlign = parent.layout.verticalAlign }
    Property.TextIndent => { target.text.textIndent = parent.text.textIndent }
    Property.TextBoxEdge => { target.text.textBoxEdge = parent.text.textBoxEdge }
    Property.TextEmphasisStyle => { target.text.emphasis.mark = parent.text.emphasis.mark }
    Property.TextEmphasisColor => { target.text.emphasis.color = parent.text.emphasis.color }
    Property.TextEmphasisPosition => {
      target.text.emphasis.under = parent.text.emphasis.under
      target.text.emphasis.left = parent.text.emphasis.left
    }
    Property.TextBoxTrim => { target.layout.textBoxTrim = parent.layout.textBoxTrim }
    Property.TextBox => {
      target.layout.textBoxTrim = parent.layout.textBoxTrim
      target.text.textBoxEdge = parent.text.textBoxEdge
    }
    Property.TabSize => { target.text.tabSize = parent.text.tabSize }
    Property.LineHeight => { target.text.lineHeight = parent.text.lineHeight }
    Property.TextDecorationLine => { target.text.decoration = parent.text.decoration }
    Property.FlexGrow => { target.layout.flexGrow = parent.layout.flexGrow }
    Property.FlexShrink => { target.layout.flexShrink = parent.layout.flexShrink }
    Property.Visibility => {
      target.text.visibility = parent.text.visibility
      target.text.visible = parent.text.visible
    }
    Property.Order => { target.layout.order = parent.layout.order }
    Property.Orphans => { target.text.orphans = parent.text.orphans }
    Property.Widows => { target.text.widows = parent.text.widows }
    Property.MaxLines => { target.layout.maxLines = parent.layout.maxLines }
    Property.BlockEllipsis => { target.layout.blockEllipsis = parent.layout.blockEllipsis }
    Property.TextOverflow => { target.layout.textOverflowEllipsis = parent.layout.textOverflowEllipsis }
    Property.AspectRatio => {
      target.layout.aspectRatio = parent.layout.aspectRatio
      target.layout.aspectRatioAuto = parent.layout.aspectRatioAuto
    }
    Property.ZIndex => {
      target.zAuto = parent.zAuto
      target.zIndex = parent.zIndex
    }
    Property.Opacity => { target.paint.opacity = parent.paint.opacity }
    Property.ObjectPosition => {
      target.paint.objectX = parent.paint.objectX
      target.paint.objectY = parent.paint.objectY
    }
    Property.BackgroundColor => { target.paint.background = parent.paint.background }
    Property.BorderTopColor => { target.paint.borderColor = parent.paint.borderColor }
    Property.BorderRightColor => { target.paint.borderColor = parent.paint.borderColor }
    Property.BorderBottomColor => { target.paint.borderColor = parent.paint.borderColor }
    Property.BorderLeftColor => { target.paint.borderColor = parent.paint.borderColor }
    Property.BorderTopStyle => { target.paint.borderStyle = parent.paint.borderStyle }
    Property.BorderRightStyle => { target.paint.borderStyle = parent.paint.borderStyle }
    Property.BorderBottomStyle => { target.paint.borderStyle = parent.paint.borderStyle }
    Property.BorderLeftStyle => { target.paint.borderStyle = parent.paint.borderStyle }
    Property.BoxShadow => {
      target.paint.hasShadow = parent.paint.hasShadow
      target.paint.shadow = parent.paint.shadow
    }
    Property.BackdropFilter => { target.paint.backdropBlur = parent.paint.backdropBlur }
    Property.PointerEvents => { target.paint.pointerEvents = parent.paint.pointerEvents }
    Property.UserSelect => { target.userSelect = parent.userSelect }
    Property.AppRegion => { target.appRegion = parent.appRegion }
    Property.FontFamily => { target.text.family = parent.text.family }
    Property.FontSize => { target.text.size = parent.text.size }
    Property.LetterSpacing => { target.text.letterSpacing = parent.text.letterSpacing }
    Property.WordSpacing => { target.text.wordSpacing = parent.text.wordSpacing }
    Property.TextTransform => { target.text.textTransform = parent.text.textTransform }
    Property.LineBreak => { target.text.lineBreak = parent.text.lineBreak }
    Property.Hyphens => { target.text.hyphens = parent.text.hyphens }
    Property.WordBreak => { target.text.wordBreak = parent.text.wordBreak }
    Property.OverflowWrap => { target.text.overflowWrap = parent.text.overflowWrap }
    Property.FontWeight => { target.text.weight = parent.text.weight }
    Property.Color => { target.text.color = parent.text.color }
    Property.TextDecorationColor => {
      target.text.decorationColor = parent.text.decorationColor
      target.text.hasDecorationColor = parent.text.hasDecorationColor
    }
    Property.TextDecorationStyle => { target.text.wavy = parent.text.wavy }
    Property.CaretColor => {
      target.text.caretColor = parent.text.caretColor
      target.text.hasCaretColor = parent.text.hasCaretColor
    }
    Property.SilkSelectionColor => { target.text.selectionColor = parent.text.selectionColor }
    Property.WebkitTextFillColor => {
      target.text.fillColor = parent.text.fillColor
    }
    Property.SilkPlaceholderColor => {
      target.text.hasPlaceholderColor = parent.text.hasPlaceholderColor
      target.text.placeholderColor = parent.text.placeholderColor
    }
    Property.FontWidth => { target.text.width = parent.text.width }
    Property.FontStretch => { target.text.width = parent.text.width }
    Property.FontFeatureSettings => {
      target.text.features.tags = parent.text.features.tags
      target.text.features.values = parent.text.features.values
      target.text.features.count = parent.text.features.count
    }
    Property.FontVariationSettings => {
      target.text.features.variations = parent.text.features.variations
    }
    Property.FontSmooth => { target.text.features.extras = inheritField(target.text.features.extras, parent.text.features.extras, fonts.EXTRAS_SMOOTH) }
    Property.FontPalette => { target.text.features.extras = inheritField(target.text.features.extras, parent.text.features.extras, fonts.EXTRAS_PALETTE) }
    Property.FontVariantAlternates => { target.text.features.extras = inheritField(target.text.features.extras, parent.text.features.extras, fonts.EXTRAS_ALTERNATES) }
    Property.FontSizeAdjust => { target.text.features.extras = inheritField(target.text.features.extras, parent.text.features.extras, fonts.EXTRAS_SIZE_ADJUST) }
    Property.Transform => { target.transform.list = parent.transform.list }
    Property.Translate => { target.transform.translate = parent.transform.translate }
    Property.Rotate => { target.transform.rotate = parent.transform.rotate }
    Property.Scale => { target.transform.scale = parent.transform.scale }
    Property.TransformOrigin => { target.transform.origin = parent.transform.origin }
    Property.Perspective => { target.transform.perspective = parent.transform.perspective }
    Property.PerspectiveOrigin => { target.transform.perspectiveOrigin = parent.transform.perspectiveOrigin }
    Property.BackfaceVisibility => { target.transform.hideBackface = parent.transform.hideBackface }
    Property.TransformStyle => { target.transform.preserve3d = parent.transform.preserve3d }
    Property.OffsetPath => {
      let from = parent.transform.offset
      let to = &mut target.transform.offset
      to.path = from.path
      to.box = from.box
      to.raySize = from.raySize
      to.contain = from.contain
      to.rayAtSet = from.rayAtSet
      to.rayAngle = from.rayAngle
      to.rayAt = from.rayAt
      to.pathHash = from.pathHash
    }
    Property.OffsetDistance => {
      target.transform.offset.distance = parent.transform.offset.distance
      target.transform.offset.distanceFraction = parent.transform.offset.distanceFraction
    }
    Property.OffsetRotate => {
      target.transform.offset.rotate = parent.transform.offset.rotate
      target.transform.offset.autoRotate = parent.transform.offset.autoRotate
    }
    Property.OffsetAnchor => {
      target.transform.offset.anchor = parent.transform.offset.anchor
      target.transform.offset.anchorAuto = parent.transform.offset.anchorAuto
    }
    Property.OffsetPosition => {
      target.transform.offset.position = parent.transform.offset.position
      target.transform.offset.positionKind = parent.transform.offset.positionKind
    }
    Property.TransitionProperty => {
      target.transition.properties = parent.transition.properties
    }
    Property.TransitionDuration => {
      target.transition.durations = parent.transition.durations
    }
    Property.TransitionDelay => {
      target.transition.delays = parent.transition.delays
    }
    Property.TransitionTimingFunction => {
      target.transition.easings = parent.transition.easings
    }
    Property.TransitionBehavior => {
      target.transition.discrete = parent.transition.discrete
    }
    Property.AnimationName => {
      target.animation.names = parent.animation.names
    }
    Property.AnimationDuration => {
      target.animation.durations = parent.animation.durations
    }
    Property.AnimationDelay => {
      target.animation.delays = parent.animation.delays
    }
    Property.AnimationTimingFunction => {
      target.animation.easings = parent.animation.easings
    }
    Property.AnimationIterationCount => {
      target.animation.iterations = parent.animation.iterations
    }
    Property.AnimationDirection => {
      target.animation.directions = parent.animation.directions
    }
    Property.AnimationFillMode => {
      target.animation.fills = parent.animation.fills
    }
    Property.AnimationPlayState => {
      target.animation.paused = parent.animation.paused
    }
    Property.FontVariantLigatures => { target.text.features.variant = (target.text.features.variant & ~computed.FEATURE_LIGATURES) | (parent.text.features.variant & computed.FEATURE_LIGATURES) }
    Property.FontVariantCaps => { target.text.features.variant = (target.text.features.variant & ~computed.FEATURE_CAPS) | (parent.text.features.variant & computed.FEATURE_CAPS) }
    Property.FontVariantNumeric => { target.text.features.variant = (target.text.features.variant & ~computed.FEATURE_NUMERIC) | (parent.text.features.variant & computed.FEATURE_NUMERIC) }
    Property.FontVariantPosition => { target.text.features.variant = (target.text.features.variant & ~computed.FEATURE_POSITION) | (parent.text.features.variant & computed.FEATURE_POSITION) }
    Property.FontKerning => { target.text.features.variant = (target.text.features.variant & ~computed.FEATURE_KERNING) | (parent.text.features.variant & computed.FEATURE_KERNING) }
    Property.MarginBlockStart => {
      let sourceSide = physicalSide(parent.text.writingMode, parent.text.direction, true, false)
      let targetSide = physicalSide(target.text.writingMode, target.text.direction, true, false)
      let value = match sourceSide { 0 => parent.layout.margin.top 1 => parent.layout.margin.right 2 => parent.layout.margin.bottom _ => parent.layout.margin.left }
      match targetSide { 0 => { target.layout.margin.top = value } 1 => { target.layout.margin.right = value } 2 => { target.layout.margin.bottom = value } _ => { target.layout.margin.left = value } }
    }
    Property.MarginBlockEnd => {
      let sourceSide = physicalSide(parent.text.writingMode, parent.text.direction, true, true)
      let targetSide = physicalSide(target.text.writingMode, target.text.direction, true, true)
      let value = match sourceSide { 0 => parent.layout.margin.top 1 => parent.layout.margin.right 2 => parent.layout.margin.bottom _ => parent.layout.margin.left }
      match targetSide { 0 => { target.layout.margin.top = value } 1 => { target.layout.margin.right = value } 2 => { target.layout.margin.bottom = value } _ => { target.layout.margin.left = value } }
    }
    Property.MarginInlineStart => {
      let sourceSide = physicalSide(parent.text.writingMode, parent.text.direction, false, false)
      let targetSide = physicalSide(target.text.writingMode, target.text.direction, false, false)
      let value = match sourceSide { 0 => parent.layout.margin.top 1 => parent.layout.margin.right 2 => parent.layout.margin.bottom _ => parent.layout.margin.left }
      match targetSide { 0 => { target.layout.margin.top = value } 1 => { target.layout.margin.right = value } 2 => { target.layout.margin.bottom = value } _ => { target.layout.margin.left = value } }
    }
    Property.MarginInlineEnd => {
      let sourceSide = physicalSide(parent.text.writingMode, parent.text.direction, false, true)
      let targetSide = physicalSide(target.text.writingMode, target.text.direction, false, true)
      let value = match sourceSide { 0 => parent.layout.margin.top 1 => parent.layout.margin.right 2 => parent.layout.margin.bottom _ => parent.layout.margin.left }
      match targetSide { 0 => { target.layout.margin.top = value } 1 => { target.layout.margin.right = value } 2 => { target.layout.margin.bottom = value } _ => { target.layout.margin.left = value } }
    }
    Property.PaddingBlockStart => {
      let sourceSide = physicalSide(parent.text.writingMode, parent.text.direction, true, false)
      let targetSide = physicalSide(target.text.writingMode, target.text.direction, true, false)
      let value = match sourceSide { 0 => parent.layout.padding.top 1 => parent.layout.padding.right 2 => parent.layout.padding.bottom _ => parent.layout.padding.left }
      match targetSide { 0 => { target.layout.padding.top = value } 1 => { target.layout.padding.right = value } 2 => { target.layout.padding.bottom = value } _ => { target.layout.padding.left = value } }
    }
    Property.PaddingBlockEnd => {
      let sourceSide = physicalSide(parent.text.writingMode, parent.text.direction, true, true)
      let targetSide = physicalSide(target.text.writingMode, target.text.direction, true, true)
      let value = match sourceSide { 0 => parent.layout.padding.top 1 => parent.layout.padding.right 2 => parent.layout.padding.bottom _ => parent.layout.padding.left }
      match targetSide { 0 => { target.layout.padding.top = value } 1 => { target.layout.padding.right = value } 2 => { target.layout.padding.bottom = value } _ => { target.layout.padding.left = value } }
    }
    Property.PaddingInlineStart => {
      let sourceSide = physicalSide(parent.text.writingMode, parent.text.direction, false, false)
      let targetSide = physicalSide(target.text.writingMode, target.text.direction, false, false)
      let value = match sourceSide { 0 => parent.layout.padding.top 1 => parent.layout.padding.right 2 => parent.layout.padding.bottom _ => parent.layout.padding.left }
      match targetSide { 0 => { target.layout.padding.top = value } 1 => { target.layout.padding.right = value } 2 => { target.layout.padding.bottom = value } _ => { target.layout.padding.left = value } }
    }
    Property.PaddingInlineEnd => {
      let sourceSide = physicalSide(parent.text.writingMode, parent.text.direction, false, true)
