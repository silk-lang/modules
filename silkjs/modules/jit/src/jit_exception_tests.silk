// Exceptions in compiled code (stream P, docs/jit/compiled-entry.md 3.1): `throw` leaves through
// a cold exit, try regions run compiled with their catch offset in the exit state, and finally
// blocks run compiled on the normal path. Expected values come from node.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.testing.testing { Testing, AssertionError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_owned_value { Value }
import silkjs.js_realm { lendRealm }
import silkjs.js_core_types { HostHook, NativeFunctionId }
import silkjs.js_exceptions { JsException }
import silkjs.js_runtime as runtime
import silkjs.js_gc as gc
import silkjs.js_eval as eval
import silkjs.js_intrinsic_install as intrinsics
import silkjs.native_stack as stack
import jit_runtime { Jit, Options }
import jit_runtime as jitRuntime
import jit_engine_tests { Compiling }

const HANDLER: u32 = 11

unsafe effect fn evaluate<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader, source: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let memory = engine.memory
  let result = run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"jit.js", 0)
  let bits = Value.intoBits(move result)
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), bits)
  return bits
}
fn isInt(bits: ValueBits, expected: i32) -> bool { return match bits { ValueBits.Int { value } => value == expected _ => false } }

const THROWS: &[u8] = b"function thr(x){let s=0;for(let i=0;i<x;i++)s=s+i;if(x>100)throw s;return s}function always(x){let s=0;for(let i=0;i<x;i++)s=s+i;throw s}function cst(x){const c=1;let s=0;for(let i=0;i<x;i++)s=s+i;if(x>100)c=s;return s+c}"

unsafe effect fn exerciseThrows<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, THROWS)
  let hot = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+thr(k%50);t")
  run Testing.expect(isInt(hot, 117600), "a function with a throw compiles and returns the interpreter's answers")
  engine.services.jit.collect()
  let compiled = engine.services.jit.compiledFunctions
  let runs = engine.services.jit.runs
  run Testing.expect(compiled == 1 && runs >= 250 && engine.services.jit.deopts == 0, "thr runs compiled, never deopting")
  // 100 throws, far past the deopt limit (8): the exit at a throw is cold.
  let thrown = run unsafe evaluate(&mut engine, context, b"var u=0;for(var k=0;k<100;k++){try{thr(200)}catch(e){u=u+e}}u")
  run Testing.expect(isInt(thrown, 1990000), "the compiled throw delivers the thrown value to the caller's catch")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.runs == runs + 100 && engine.services.jit.deopts == 0 && engine.services.jit.unlinked == 0,
    "each throw ran compiled code, counted no deopt and left thr linked")
  // A function that throws on every call compiles and stays linked.
  let every = run unsafe evaluate(&mut engine, context, b"var v=0;for(var k=0;k<300;k++){try{always(k%9)}catch(e){v=v+e}}v")
  run Testing.expect(isInt(every, 2773), "a function throwing on every call")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.compiledFunctions == compiled + 1 && engine.services.jit.deopts == 0 && engine.services.jit.unlinked == 0,
    "always is compiled and stays linked")
  // throw_error: an assignment to a const.
  let constant = run unsafe evaluate(&mut engine, context, b"var w=0;for(var k=0;k<300;k++){try{w=w+cst(k%120)}catch(e){w=w+(e instanceof TypeError?1000:7)}}w")
  run Testing.expect(isInt(constant, 405782), "throw_error raises the interpreter's TypeError")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.compiledFunctions == compiled + 2 && engine.services.jit.deopts == 0 && engine.services.jit.unlinked == 0,
    "cst is compiled and its throw_error is a cold exit")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}

const TRIES: &[u8] = b"function safe(x){let s=0;try{for(let i=0;i<x;i++)s=s+i}catch(e){s=-1}return s}function rare(x){let s=0;try{for(let i=0;i<x%50;i++)s=s+i;if(x%1000===999)throw s}catch(e){s=s+1000000}return s}function ri(x){let s=0;try{for(let i=0;i<x;i++)s=s+i;if(x>5)return s*2}catch(e){return -1}return s}function nest(x){let s=0;for(let i=0;i<x;i++){try{try{s=s+i;if(i===77)throw 1}catch(e){s=s+e*1000}}catch(f){s=-5}}return s}"

unsafe effect fn exerciseTries<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, TRIES)
  let quiet = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+safe(k%40);t")
  run Testing.expect(isInt(quiet, 70300), "a try region that never throws")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.compiledFunctions == 1 && engine.services.jit.runs >= 250 && engine.services.jit.deopts == 0,
    "safe runs compiled with its try region, never deopting")
  let compiled = engine.services.jit.compiledFunctions
  let rarely = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<3000;k++)t=t+rare(k);t")
  run Testing.expect(isInt(rarely, 4176000), "a throw once in 1000 calls is caught by the function's own handler")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.compiledFunctions == compiled + 1 && engine.services.jit.deopts == 0 && engine.services.jit.unlinked == 0,
    "rare compiles and stays linked; its throws are cold exits")
  let returning = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+ri(k%10);t")
  run Testing.expect(isInt(returning, 6600), "a return inside a try region (nip_catch)")
  let nested = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+nest(k%90);t")
  run Testing.expect(isInt(nested, 392500), "nested try regions in a loop, the inner one catching")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.compiledFunctions == compiled + 3 && engine.services.jit.unlinked == 0, "ri and nest compile")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}

const FINALLY: &[u8] = b"function fin(x){let s=0;try{for(let i=0;i<x;i++)s=s+i}finally{s=s+1}return s}function fr(x){let s=0;try{if(x>3)return s+x;s=x*2}finally{s=s+1}return s}function floop(x){let s=0;for(let i=0;i<x;i++){try{if(i===3)continue;if(i===50)break;s=s+i}finally{s=s+2}}return s}function rethrow(x){let s=0;try{try{s=x;if(x===97)throw x}finally{s=s+1}}catch(e){s=s+e*100}return s}"

unsafe effect fn exerciseFinally<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, FINALLY)
  let plain = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+fin(k%40);t")
  run Testing.expect(isInt(plain, 70600), "a finally block on the normal path")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.compiledFunctions == 1 && engine.services.jit.runs >= 250 && engine.services.jit.deopts == 0,
    "fin runs compiled through gosub and ret without a deopt")
  let returned = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+fr(k%7);t")
  run Testing.expect(isInt(returned, 1327), "a return through a finally block")
  let jumps = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+floop(k%60);t")
  run Testing.expect(isInt(jumps, 175750), "break and continue through a finally block")
  let again = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+rethrow(k%100);t")
  run Testing.expect(isInt(again, 44250), "a throw through a finally block to an outer handler")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.unlinked == 0, "nothing is unlinked")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}

const NESTED: &[u8] = b"function risky(x){if(x>50)throw new RangeError('big');return x}function wrap(f,n){let s=0;for(let i=0;i<n;i++){try{s=s+f(i)}catch(e){s=s+100}}return s}function mid(f,n){let s=0;try{s=f(n)}catch(e){s=e.stack.indexOf('inner')<e.stack.indexOf('mid')?n+1000:-n}finally{s=s+1}return s}function inner(n){if(n%10===9)throw new TypeError('inner');return n}function outer(n){let s=0;for(let i=0;i<n;i++)s=s+mid(inner,i);return s}"

unsafe effect fn exerciseNested<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, NESTED)
  let quiet = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+wrap(risky,20);t")
  run Testing.expect(isInt(quiet, 57000), "calls inside a compiled try region")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.compiledFunctions >= 1 && engine.services.jit.deopts == 0, "wrap compiles and calls without a deopt")
  let caught = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<20;k++)t=t+wrap(risky,60);t")
  run Testing.expect(isInt(caught, 43500), "a callee's throw lands in the compiled caller's handler")
  // Three levels: outer's loop calls mid, whose try region catches what inner throws; the
  // backtrace lists inner before mid, and the finally block runs on both paths.
  let deep = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<100;k++)t=t+outer(30);t")
  run Testing.expect(isInt(deep, 346500), "a throw caught by a compiled middle frame, in backtrace order, with its finally block")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.compiledFunctions <= 15, "compilations stay bounded although mid's handler rewrites inline cache keys (100 when the keys were hashed)")
  run Testing.expect(engine.services.jit.unlinked == 0, "nothing is unlinked")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}

/// A runtime with the JIT attached (threshold 20; calls from compiled code when calls).
unsafe effect fn session(calls: bool, which: u32) -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut options = Options.make()
  options.enabled = true options.threshold = 20 options.calls = calls
  let jit = run Jit.make(move options) |> Effect.provideMut<Allocator>(&mut system)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: Compiling { jit: move jit, failures: 0 } }
  unsafe jitRuntime.attach(&mut engine.services.jit, rt)
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: HANDLER }), opaque: Pointer.null<u8>() })
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = run Effect.result(unsafe exercise(&mut engine, context, which)) |> Effect.provideMut<Allocator>(&mut allocator)
  run unsafe gc.collect(&mut engine, rt, true) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), JsException | AssertionError<'static>>.Success { value: _ } => ()
    Result<(), JsException | AssertionError<'static>>.Failure { error } => { fail move error }
  }
}
unsafe effect fn exercise<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader, which: u32) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  if which == 0 { run unsafe exerciseThrows(&mut engine, context) }
  else if which == 1 { run unsafe exerciseTries(&mut engine, context) }
  else if which == 2 { run unsafe exerciseFinally(&mut engine, context) }
  else if which == 3 { run unsafe exerciseNested(&mut engine, context) }
  else if which == 4 { run unsafe exerciseOsrTdz(&mut engine, context) }
  else if which == 5 { run unsafe exerciseReentry(&mut engine, context) }
  else if which == 6 { run unsafe exerciseTryHeaders(&mut engine, context) }
  else { run unsafe exerciseInlinedInTry(&mut engine, context) }
}

/// Methods inlined into a caller's try region (docs/jit/inlining.md): a getter that throws
/// under a nested inlined call leaves to the caller's call pc with the caller's markers, and
/// the caller's handler runs.
const INLINED: &[u8] = b"function P(x){this.x=x}P.prototype.getx=function(){return this.x};P.prototype.chk=function(k){return this.x+k.v};P.prototype.deep=function(k){return this.chk(k)+1};var good={v:1},bad={get v(){throw 1}};function run(o,n){var s=0;for(var i=0;i<n;i++){try{s=s+o.getx()+o.chk(i%50===49?bad:good)+o.deep(i%70===69?bad:good)}catch(e){s=s+100}}return s}var p=new P(3)"

unsafe effect fn exerciseInlinedInTry<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, INLINED)
  let total = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+run(p,200);t")
  run Testing.expect(isInt(total, 878400), "inlined calls in a try region, with throws from inside them, give node's answer")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.inlinedSites >= 1, "a method is inlined into the region")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}

/// Loops whose headers sit inside try regions (their markers under the header), in functions
/// called once: entered by on-stack replacement, a throw, a return and a finally block.
const TRY_HEADERS: &[u8] = b"function tl(n){var s=0;try{for(var i=0;i<n;i++){s=s+(i&7);if(i===n-3)throw 5}}catch(e){s=s+e}return s}function tr(n){var s=0;try{for(var i=0;i<n;i++){s=s+(i&3);if(i===n-2)return s+1000}}catch(e){return -1}return s}function tf(n){var s=0;try{try{for(var i=0;i<n;i++){s=s+(i&3)}}finally{s=s+9}}catch(e){s=-1}return s}"

unsafe effect fn exerciseTryHeaders<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, TRY_HEADERS)
  let before = engine.services.jit.osrRuns
  let thrown = run unsafe evaluate(&mut engine, context, b"tl(200000)")
  run Testing.expect(isInt(thrown, 699992), "a loop inside a try region throws to its handler from OSR code")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.osrRuns >= before + 15, "and runs compiled from its first poll on")
  let returned = run unsafe evaluate(&mut engine, context, b"tr(200000)")
  run Testing.expect(isInt(returned, 300997), "a return from a loop inside a try region")
  let finished = run unsafe evaluate(&mut engine, context, b"tf(200000)")
  run Testing.expect(isInt(finished, 300009), "a loop inside try and finally regions")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.osrRuns >= before + 45, "all three loops run compiled")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}

/// A loop called once whose body throws every 1000 iterations into its own handler: after each
/// catch the next backward jump polls and re-enters the loop's OSR code (js_vm.unwind).
unsafe effect fn exerciseReentry<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  let before = engine.services.jit.osrRuns
  let caught = run unsafe evaluate(&mut engine, context,
    b"function often(n){var s=0;for(var i=0;i<n;i++){try{if(i%1000===999)throw 1;s=s+(i&7)}catch(e){s=s+7}}return s};often(200000)")
  run Testing.expect(isInt(caught, 700000), "a loop that throws into its own handler returns the interpreter's answer")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.osrRuns >= before + 190, "the loop re-enters its OSR code after each of its 200 catches")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}

/// Loops entered by on-stack replacement in functions called once, reading a lexical slot whose
/// TDZ opened before the loop: y is still uninitialized (ReferenceError), c is initialized.
const OSR_TDZ: &[u8] = b"function early(n){var s=0;for(var i=0;i<n;i++){if(i===n-1){s=s+y}else{s=s+1}}let y=5;return s}function late(n){let c=3;var s=0;for(var i=0;i<n;i++)s=s+c;return s}function caught(n){try{return early(n)}catch(e){return e instanceof ReferenceError?-1:-2}}"

unsafe effect fn exerciseOsrTdz<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, OSR_TDZ)
  let thrown = run unsafe evaluate(&mut engine, context, b"caught(200000)")
  run Testing.expect(isInt(thrown, -1), "a lexical slot read before its initialization throws after an OSR entry")
  let read = run unsafe evaluate(&mut engine, context, b"late(200000)")
  run Testing.expect(isInt(read, 600000), "an initialized lexical slot read in an OSR loop")
  engine.services.jit.collect()
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}

test effect fn throwsLeaveThroughColdExits() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run unsafe session(false, 0)
}
test effect fn tryRegionsRunCompiled() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run unsafe session(false, 1)
}
test effect fn finallyBlocksRunCompiled() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run unsafe session(false, 2)
}
test effect fn throwsThroughCompiledFrames() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run unsafe session(true, 3)
}
test effect fn osrEntriesKeepTheTdz() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run unsafe session(false, 4)
}
test effect fn handlersReenterOsrCode() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run unsafe session(false, 5)
}
test effect fn tryHeadersEnterThroughOsr() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run unsafe session(false, 6)
}
test effect fn inlinedCallsInTryRegions() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run unsafe session(true, 7)
}
