//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! Every area's probes, one area after another.
import caniuse_probe { Probe }
import silk.core.option { Option }
import caniuse_probes_css_cascade
import caniuse_probes_css_layout
import caniuse_probes_css_text
import caniuse_probes_css_paint
import caniuse_probes_svg

pub const AREAS: usize = 5

/// Probe `at` of area `area`, none past the last.
pub fn probe(area: usize, at: usize) -> Option<Probe> {
  if area == 0 {
    return caniuse_probes_css_cascade.probe(at)
  }
  if area == 1 {
    return caniuse_probes_css_layout.probe(at)
  }
  if area == 2 {
    return caniuse_probes_css_text.probe(at)
  }
  if area == 3 {
    return caniuse_probes_css_paint.probe(at)
  }
  if area == 4 {
    return caniuse_probes_svg.probe(at)
  }
  return Option<Probe>.None
}
