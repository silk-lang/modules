          // from further up than their prototype): the known paths first, as above.
          let fact = self.shapes.fact(self.cursor)
          let mut target = NONE
          if (fact & FACT_HEDGED) == 0 && (self.skipAt == NONE || self.isPreset(inst.result)) { target = self.knownRead(&function, self.cursor) }
          // The known path or the read's exit, nothing else (ssa_shapes, FACT_KNOWN): what
          // the facts proved of the object holds after it.
          let leaves = (fact & FACT_KNOWN) != 0
          let mut proven: u64 = 0
          if leaves { proven = self.shapes.provenAt(self.cursor) }
          if target != NONE && proven != 0 && !knownFor(&function, target, proven) { target = NONE }
