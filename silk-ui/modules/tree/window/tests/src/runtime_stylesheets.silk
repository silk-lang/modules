import ui_fixtures.fixtures as fixtures
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, StyleSource }
import ui_tree.style_load { LoadState }
import ui_tree.style_runtime
import ui_tree_window.loader { Loader }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }
import silk.text.string { String }

effect fn ready(tree: &UiTree<'_>, id: u32, state: LoadState) -> ()
  ! AssertionError<'static> {
  let actual = tree.styleLoadState(0, id)
  let matches = match actual { Option.Some { value } => value == state Option.None => false }
  run Testing.expect(matches, "the load exposes its current state")
}

effect fn width(tree: &mut UiTree<'_>, expected: f32) -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError ? &mut Allocator {
  run tree.frame(fixtures.viewport(1))
  run Testing.expect(tree.node(tree.slotOf(2)).computed().layout.width.value == expected, "the last successfully loaded sheet wins in request order")
}

effect fn body() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("sample") })
  run batch.append(1, 2)
  run tree.apply(run batch.take())
  let compiler = style_runtime.runtime()
  run tree.requestStyleSheet(0, 10, run StyleSource.text(b".sample { width: 100px }"))
  run tree.requestStyleSheet(0, 20, run StyleSource.text(b".sample { width: 200px }"))
  let requests = tree.takeStyleLoads()
  let first = requests.asSlice()[0].ticket
  let second = requests.asSlice()[1].ticket
  drop run tree.settleStyleSheet(second, compiler.call(b".sample { width: 200px }"))
  drop run tree.settleStyleSheet(first, compiler.call(b".sample { width: 100px }"))
  run width(&mut tree, 200.0)
  run ready(&tree, 20, LoadState.Ready)

  run tree.requestStyleSheet(0, 20, run StyleSource.text(b""))
  let older = tree.takeStyleLoads().asSlice()[0].ticket
  run tree.requestStyleSheet(0, 20, run StyleSource.text(b""))
  let newer = tree.takeStyleLoads().asSlice()[0].ticket
  drop run tree.settleStyleSheet(newer, compiler.call(b".sample { width: 300px }"))
  run Testing.expect(!(run tree.settleStyleSheet(older, compiler.call(b".sample { width: 999px }"))), "stale completion cannot replace a newer sheet")
  run width(&mut tree, 300.0)

  run tree.requestStyleSheet(0, 20, run StyleSource.text(b""))
  let broken = tree.takeStyleLoads().asSlice()[0].ticket
  drop run tree.settleStyleSheet(broken, Option<Bytes>.some(run Bytes.copy(b"bad binary")))
  run ready(&tree, 20, LoadState.Failed)
  run width(&mut tree, 300.0)

  let mut loader = Loader.make()
  run tree.requestStyleSheet(0, 20, run StyleSource.url("https://never-requested.invalid/style.css"))
  drop run loader.serve(&mut tree)
  run ready(&tree, 20, LoadState.Failed)
  run Testing.expect(!loader.pending(), "disabled compilation does not start network work")
  run width(&mut tree, 300.0)
  loader.setStylesheetCompiler(compiler)
  run loader.file("theme.css", b".sample { width: 400px }")
  run tree.requestStyleSheet(0, 20, run StyleSource.url("./theme.css?v=1"))
  drop run loader.serve(&mut tree)
  run ready(&tree, 20, LoadState.Ready)
  run width(&mut tree, 400.0)
  run tree.requestStyleSheet(0, 20, run StyleSource.url("data:text/css,.sample%20%7Bwidth:500px%7D"))
  drop run loader.serve(&mut tree)
  run width(&mut tree, 500.0)
  run tree.requestStyleSheet(0, 20, run StyleSource.url("unsupported:theme"))
  drop run loader.serve(&mut tree)
  run ready(&tree, 20, LoadState.Failed)
  run width(&mut tree, 500.0)

  run tree.requestStyleSheet(0, 20, run StyleSource.text(b""))
  let removed = tree.takeStyleLoads().asSlice()[0].ticket
  run batch.removeStyleSheet(0, 20)
  run tree.apply(run batch.take())
  run Testing.expect(!(run tree.settleStyleSheet(removed, compiler.call(b".sample { width: 999px }"))), "removal cancels a pending load")
  run width(&mut tree, 100.0)
  run tree.requestStyleSheet(0, 20, run StyleSource.text(b".sample { width: 600px }"))
  drop run loader.serve(&mut tree)
  run width(&mut tree, 600.0)
  run tree.requestStyleSheet(0, 20, run StyleSource.text(b""))
  let replaced = tree.takeStyleLoads().asSlice()[0].ticket
  let compiled = compiler.call(b".sample { width: 700px }")
  if let Option<Bytes>.Some { value } = move compiled {
    run batch.replaceStyleSheet(0, 20, value.asSlice())
    run tree.apply(run batch.take())
  }
  run Testing.expect(!(run tree.settleStyleSheet(replaced, compiler.call(b".sample { width: 999px }"))), "direct compiled replacement cancels pending text")
  run width(&mut tree, 700.0)
}

test effect fn runtimeStylesheetsKeepOrderAndRejectStaleLoads() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}

import silk.system.filesystem { FileSystem, FileError, AtomicWriteError, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInputError }
import test_paths { directory }
import silk.concurrency.thread_native { NativeThread }
import ui_tree_window.clock { Clock }

effect fn drain(loader: &mut Loader, tree: &mut UiTree<'_>) -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError ? &mut Allocator {
  let mut clock = Clock.make()
  let deadline = (run clock.seconds()) + 5.0
  drop run loader.serve(&mut tree)
  while loader.pending() && (run clock.seconds()) < deadline {
    NativeThread.yieldNow()
    drop run loader.serve(&mut tree)
  }
  run Testing.expect(!loader.pending(), "native stylesheet workers settle within the test deadline")
}

effect fn fileCase(path: &Path) -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError | FileError | AtomicWriteError
  ? &mut Allocator | &mut FileSystem {
  run FileSystem.writeFileAtomic(path, b"div { width: 123px }", FileSystem.replaceExisting(), FileSystem.buffered())
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run tree.apply(run batch.take())
  let mut url = run String.copy("file:")
  run String.append(&mut url, path.view().unwrapOr(""))
  let mut loader = Loader.make()
  loader.setStylesheetCompiler(style_runtime.runtime())
  run tree.requestStyleSheet(0, 5, run StyleSource.url(String.view(&url)))
  run drain(&mut loader, &mut tree)
  run ready(&tree, 5, LoadState.Ready)
  run width(&mut tree, 123.0)
  run FileSystem.removeFile(path)
  run tree.requestStyleSheet(0, 5, run StyleSource.url(String.view(&url)))
  run drain(&mut loader, &mut tree)
  run ready(&tree, 5, LoadState.Failed)
  run width(&mut tree, 123.0)
}

effect fn fileBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError | FileError | AtomicWriteError | HostInputError
  ? &mut Allocator | &mut FileSystem {
  let parent = run directory()
  let temporary = run FileSystem.temporaryDirectory(&parent, "silkui-runtime-css-")
  let path = run Path.joinUtf8(&temporary.path, b"theme.css")
  run fileCase(&path) |> Effect.ensuring(FileSystem.releaseIgnored(move temporary))
}

effect fn fileAllocated() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError | FileError | AtomicWriteError | HostInputError ? &mut Allocator {
  let mut files = run MachineFileSystem.make()
  run fileBody() |> Effect.provideMut<FileSystem>(&mut files)
}

test effect fn runtimeStylesheetsReadFilesAndKeepStylesAfterIoFailure() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError | FileError | AtomicWriteError | HostInputError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fileAllocated() |> Effect.provideMut<Allocator>(&mut allocator)
}
