pub unsafe fn nghttp2_session_get_effective_recv_data_length(session: ?*mut u8) -> i32 { let mut a = () let s = unsafe ses(&mut a, unsafe sessionOf(session)) return maxI32(0, s.recvWindow) }
pub unsafe fn nghttp2_session_get_outbound_queue_size(session: ?*mut u8) -> usize { let mut a = () let s = unsafe ses(&mut a, unsafe sessionOf(session)) return s.urgent.size + s.regular.size + s.syn.size }
pub unsafe fn nghttp2_session_get_hd_inflate_dynamic_table_size(session: ?*mut u8) -> usize { let mut a = () let s = unsafe ses(&mut a, unsafe sessionOf(session)) return s.hdInflate.table.size }
