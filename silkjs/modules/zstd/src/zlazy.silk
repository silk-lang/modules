/// `ZSTD_compressBlock_lazy2_dictMatchState_row`.
@inlineNever
pub unsafe fn compressBlockLazy2DictMatchStateRow(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  return unsafe lazyDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, SEARCH_ROW, 2)
}
