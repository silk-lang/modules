const OFF_FEATURES_FONT: &[u8] = b"\x00\x01\x00\x00\x00\x04\x00\x10\x00\x00\x00\x30\x47\x53\x55\x42\x00\x00\x00\x00\x00\x00\x00\x4c\x00\x00\x00\x7c\x63\x6d\x61\x70\x00\x00\x00\x00\x00\x00\x00\xc8\x00\x00\x00\x2c\x68\x65\x61\x64\x00\x00\x00\x00\x00\x00\x00\xf4\x00\x00\x00\x36\x6d\x61\x78\x70\x00\x00\x00\x00\x00\x00\x01\x2c\x00\x00\x00\x06\x00\x01\x00\x00\x00\x0a\x00\x34\x00\x4e\x00\x02\x44\x46\x4c\x54\x00\x0e\x6c\x61\x74\x6e\x00\x1c\x00\x04\x00\x00\x00\x00\xff\xff\x00\x02\x00\x00\x00\x01\x00\x04\x00\x00\x00\x00\xff\xff\x00\x02\x00\x00\x00\x01\x00\x02\x66\x72\x61\x63\x00\x0e\x73\x73\x30\x31\x00\x14\x00\x00\x00\x01\x00\x00\x00\x00\x00\x01\x00\x01\x00\x02\x00\x06\x00\x1a\x00\x01\x00\x00\x00\x01\x00\x08\x00\x01\x00\x06\x00\x64\x00\x01\x00\x01\x00\x01\x00\x01\x00\x00\x00\x01\x00\x08\x00\x01\x00\x06\x00\x65\x00\x01\x00\x01\x00\x01\x00\x00\x00\x01\x00\x03\x00\x01\x00\x00\x00\x0c\x00\x04\x00\x20\x00\x00\x00\x04\x00\x02\x00\x00\x00\x00\x00\x7e\xff\xff\x00\x00\x00\x20\xff\xff\xff\xe1\x00\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x5f\x0f\x3c\xf5\x00\x00\x03\xe8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x64\x00\x64\x00\x00\x00\x08\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x50\x00\x00\xc8\x00\x00"

/// liga: 'f' 'i' to glyph 150 (lookup 0); calt: a format 3 chained context blocking glyph 150
/// after a space (lookup 1).
const LIGATURE_FONT: &[u8] = b"\x00\x01\x00\x00\x00\x04\x00\x10\x00\x00\x00\x30\x47\x53\x55\x42\x00\x00\x00\x00\x00\x00\x00\x4c\x00\x00\x00\x96\x63\x6d\x61\x70\x00\x00\x00\x00\x00\x00\x00\xe4\x00\x00\x00\x2c\x68\x65\x61\x64\x00\x00\x00\x00\x00\x00\x01\x10\x00\x00\x00\x36\x6d\x61\x78\x70\x00\x00\x00\x00\x00\x00\x01\x48\x00\x00\x00\x06\x00\x01\x00\x00\x00\x0a\x00\x34\x00\x4e\x00\x02\x44\x46\x4c\x54\x00\x0e\x6c\x61\x74\x6e\x00\x1c\x00\x04\x00\x00\x00\x00\xff\xff\x00\x02\x00\x00\x00\x01\x00\x04\x00\x00\x00\x00\xff\xff\x00\x02\x00\x00\x00\x01\x00\x02\x6c\x69\x67\x61\x00\x0e\x63\x61\x6c\x74\x00\x14\x00\x00\x00\x01\x00\x00\x00\x00\x00\x01\x00\x01\x00\x02\x00\x06\x00\x26\x00\x04\x00\x00\x00\x01\x00\x08\x00\x01\x00\x12\x00\x01\x00\x08\x00\x01\x00\x04\x00\x96\x00\x02\x00\x4a\x00\x01\x00\x01\x00\x47\x00\x06\x00\x00\x00\x01\x00\x08\x00\x03\x00\x01\x00\x0e\x00\x01\x00\x14\x00\x00\x00\x00\x00\x01\x00\x01\x00\x01\x00\x01\x00\x01\x00\x96\x00\x00\x00\x00\x00\x01\x00\x03\x00\x01\x00\x00\x00\x0c\x00\x04\x00\x20\x00\x00\x00\x04\x00\x02\x00\x00\x00\x00\x00\x7e\xff\xff\x00\x00\x00\x20\xff\xff\xff\xe1\x00\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x5f\x0f\x3c\xf5\x00\x00\x03\xe8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x64\x00\x64\x00\x00\x00\x08\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x50\x00\x00\xc8\x00\x00"

/// The word-safe set of `bytes`' default Latin plan with `features`.
effect fn safeSet(bytes: &[u8], features: &[Feature]) -> [u64; 2]
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = match move FontRef.new(bytes) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "test font")
      return [0, 0]
    }
  }
  let data = ShaperData.new(&font)
  let shaper = ConfiguredShaper.new(&data)
  let mut buffer = Buffer.new()
  buffer.setDirection(Direction.LeftToRight)
  buffer.setScript(Script.parse("Latn"))
  buffer.guessSegmentProperties()
  let plan = run ShapePlan.new(&shaper, &buffer, features)
  return run wordSafeAsciiWith(&data, &plan)
}

fn safe(set: [u64; 2], c: u8) -> bool {
  let index = u8.toUsize(c)
  return (set[index / 64] & u64.shiftLeft(1, usize.toU64(index % 64))) != 0
}

/// Whether the characters of 0x21..0x7E outside `set` are exactly those of `expected`.
fn onlyUnsafe(set: [u64; 2], expected: &[u8]) -> bool {
  let mut c: u8 = 0x21
  while c <= 0x7e {
    let mut listed = false
    let mut i: usize = 0
    while i < expected.length {
      if expected[i] == c {
        listed = true
      }
      i = i + 1
    }
    if safe(set, c) == listed {
      return false
    }
    c = c + 1
  }
  return true
}

/// The glyph ids of `text` shaped whole with `bytes`' default Latin plan.
effect fn glyphIds(bytes: &[u8], text: string, out: &mut List<u32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if let Result<FontRef, ReadError>.Success { value: font } = move FontRef.new(bytes) {
    let data = ShaperData.new(&font)
    let shaper = ConfiguredShaper.new(&data)
    let mut buffer = Buffer.new()
    run Buffer.pushStr(&mut buffer, text)
    buffer.setDirection(Direction.LeftToRight)
    buffer.setScript(Script.parse("Latn"))
    buffer.guessSegmentProperties()
    drop run shapeWithFeatures(&shaper, &mut buffer, &[])
    let glyphs = List<Glyph>.asSlice(&buffer.glyphs)
    let mut i: usize = 0
    while i < glyphs.length {
      run List<u32>.append(&mut out, glyphs[i].info.glyphId)
      i = i + 1
    }
  }
}

effect fn cases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  // The calt rule needs the space before '(', so '(' alone is unsafe; the font really does
  // substitute '(' after a space and not at a word's start.
  run Testing.expect(onlyUnsafe(run safeSet(CALT_FONT, &[]), b"("), "calt: only '(' is unsafe")
  let mut whole = List<u32>.make()
  run glyphIds(CALT_FONT, "a (", &mut whole)
  let mut alone = List<u32>.make()
  run glyphIds(CALT_FONT, "(", &mut alone)
  run Testing.expect(
    List<u32>.length(&whole) == 3 && List<u32>.get(&whole, 2) == 109
      && List<u32>.length(&alone) == 1
      && List<u32>.get(&alone, 0) == 9,
    "calt substitutes '(' after a space only",
  )
  let noCalt: [Feature; 1] = [Feature.new(Tag.fromU32(0x63616c74), 0)]
  run Testing.expect(
    onlyUnsafe(run safeSet(CALT_FONT, &noCalt), b""),
    "calt off: every character is safe",
  )

  // Kerning ',' against a following space makes ',' unsafe; a GDEF mark is unsafe too.
  run Testing.expect(onlyUnsafe(run safeSet(KERN_FONT, &[]), b",^"), "kern: ',' and the mark")

  // A lookup that can start at the space makes the whole plan unsafe.
  let spaceStart = run safeSet(SPACE_START_FONT, &[])
  run Testing.expect(spaceStart[0] == 0 && spaceStart[1] == 0, "kern from the space: nothing safe")

  // frac is on only around U+2044, and ss01 is off by default: neither counts until a user
  // feature turns it on everywhere.
  run Testing.expect(
    onlyUnsafe(run safeSet(OFF_FEATURES_FONT, &[]), b""),
    "frac and ss01 are inactive by default",
  )
  let frac: [Feature; 1] = [Feature.new(Tag.fromU32(0x66726163), 1)]
  let withFrac = run safeSet(OFF_FEATURES_FONT, &frac)
  run Testing.expect(withFrac[0] == 0 && withFrac[1] == 0, "frac=1 substitutes the space")
  let ss01: [Feature; 1] = [Feature.ranged(Tag.fromU32(0x73733031), 1, 3, 5)]
  let withSs01 = run safeSet(OFF_FEATURES_FONT, &ss01)
  run Testing.expect(withSs01[0] == 0 && withSs01[1] == 0, "ss01 on a range counts")

  // 'f' and 'i' can become the ligature, which the calt rule starts at after a space.
  run Testing.expect(onlyUnsafe(run safeSet(LIGATURE_FONT, &[]), b"fi"), "ligature closure")
  let noLiga: [Feature; 1] = [Feature.new(Tag.fromU32(0x6c696761), 0)]
  run Testing.expect(
    onlyUnsafe(run safeSet(LIGATURE_FONT, &noLiga), b""),
    "liga off: the ligature is never made",
  )
}

test effect fn wordSafeAsciiSets() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cases() |> Effect.provideMut<Allocator>(&mut allocator)
}
