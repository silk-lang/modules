//! Word-safe ASCII sets of shape plans (`word_safe`), over small fonts built byte by byte.
//!
//! Each font maps U+0020..U+007E to glyphs 1..95 (character minus 0x1F, so the space is glyph
//! 1) and has one layout table whose `DFLT` and `latn` scripts list every feature.
import word_safe { wordSafeAsciiWith }
import font { ShaperData, ConfiguredShaper }
import shape_plan { ShapePlan }
import shape { shapeWithFeatures }
import buffer { Buffer, Glyph }
import direction { Direction }
import feature { Feature }
import script { Script }
import read_fonts.lib { FontRef, ReadError }
import font_types.lib { Tag }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// calt: a chained context (format 3) whose backtrack is the space and input '(', applying a
/// single substitution of '(' (lookup 1, nested only).
const CALT_FONT: &[u8] = b"\x00\x01\x00\x00\x00\x04\x00\x10\x00\x00\x00\x30\x47\x53\x55\x42\x00\x00\x00\x00\x00\x00\x00\x4c\x00\x00\x00\x7e\x63\x6d\x61\x70\x00\x00\x00\x00\x00\x00\x00\xcc\x00\x00\x00\x2c\x68\x65\x61\x64\x00\x00\x00\x00\x00\x00\x00\xf8\x00\x00\x00\x36\x6d\x61\x78\x70\x00\x00\x00\x00\x00\x00\x01\x30\x00\x00\x00\x06\x00\x01\x00\x00\x00\x0a\x00\x30\x00\x3e\x00\x02\x44\x46\x4c\x54\x00\x0e\x6c\x61\x74\x6e\x00\x1a\x00\x04\x00\x00\x00\x00\xff\xff\x00\x01\x00\x00\x00\x04\x00\x00\x00\x00\xff\xff\x00\x01\x00\x00\x00\x01\x63\x61\x6c\x74\x00\x08\x00\x00\x00\x01\x00\x00\x00\x02\x00\x06\x00\x2c\x00\x06\x00\x00\x00\x01\x00\x08\x00\x03\x00\x01\x00\x12\x00\x01\x00\x18\x00\x00\x00\x01\x00\x00\x00\x01\x00\x01\x00\x01\x00\x01\x00\x01\x00\x01\x00\x09\x00\x01\x00\x00\x00\x01\x00\x08\x00\x01\x00\x06\x00\x64\x00\x01\x00\x01\x00\x09\x00\x00\x00\x00\x00\x01\x00\x03\x00\x01\x00\x00\x00\x0c\x00\x04\x00\x20\x00\x00\x00\x04\x00\x02\x00\x00\x00\x00\x00\x7e\xff\xff\x00\x00\x00\x20\xff\xff\xff\xe1\x00\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x5f\x0f\x3c\xf5\x00\x00\x03\xe8\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x64\x00\x64\x00\x00\x00\x08\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x50\x00\x00\xc8\x00\x00"

