    let stateBytes = unsafe nn(memoryAll)
    let state = unsafe selectOf(stateBytes)
    let async = unsafe nn(asyncMemory)
    unsafe Pointer.put<SelectState>(state, SelectState {
      handle: handle, async: async, fd: fd, interruptRead: interrupt[0], interruptWrite: interrupt[1], ackRead: ack[0], ackWrite: ack[1],
      thread: 0, wanted: 0, events: 0, stop: 0, sets: unsafe byteAt(stateBytes, Layout.of<SelectState>().bytes), setBytes: setBytes
    })
    let _init = unsafe uv_async_init(unsafe Intrinsic.pointerReinterpret<*mut Loop, *mut u8>(loop), async, silkUvSelectReady)
    let mut second = () let ah = unsafe Pointer.borrowMut<(), Handle>(&mut second, unsafe handleOf(async))
    ah.data = stateBytes drop ah
    unsafe markInternal(async)
    let mut thread: usize = 0
    if unsafe pthread_create(Pointer.fromMutRef<usize>(&mut thread), Pointer.null<u8>(), silkUvSelectThread, stateBytes) != 0 {
      let code = unsafe errno()
      let _a = unsafe close(interrupt[0]) let _b = unsafe close(interrupt[1]) let _c = unsafe close(ack[0]) let _d = unsafe close(ack[1])
      unsafe uv_close(async, silkUvSelectFreed)
      return -code
    }
    let s = unsafe Pointer.borrowMut<(), SelectState>(&mut anchor, state) s.thread = thread drop s
    let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle) h2.context = stateBytes drop h2
    return 0
  }
  // A select handle's watch: the thread's mask, then a wake so that it selects for it.
  unsafe fn selectWatch(state: *mut u8, wanted: i32) -> () {
    let mut anchor = () let s = unsafe Pointer.borrowMut<(), SelectState>(&mut anchor, unsafe selectOf(state))
    unsafe Atomic.store<u32>(Pointer.fromMutRef<u32>(&mut s.wanted), i32.toU32(wanted), MemoryOrder.SequentiallyConsistent)
    let interrupt = s.interruptWrite drop s
    unsafe poke(interrupt)
  }
  // Stops a select handle's thread and gives back what it held (libuv's uv__stream_close part).
  unsafe fn selectRelease(handle: *mut Handle) -> () {
    let mut anchor = ()
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
    if Pointer.isNull<u8>(h.context) { return }
    let stateBytes = unsafe nn(h.context) h.context = Pointer.null<u8>() drop h
    let s = unsafe Pointer.borrowMut<(), SelectState>(&mut anchor, unsafe selectOf(stateBytes))
    unsafe Atomic.store<u32>(Pointer.fromMutRef<u32>(&mut s.stop), 1, MemoryOrder.SequentiallyConsistent)
    let interruptRead = s.interruptRead let interruptWrite = s.interruptWrite let ackRead = s.ackRead let ackWrite = s.ackWrite
    let thread = s.thread let async = s.async drop s
    unsafe poke(interruptWrite)
    unsafe poke(ackWrite)
    let _joined = unsafe pthread_join(thread, Pointer.null<?*mut u8>())
    let _a = unsafe close(interruptRead) let _b = unsafe close(interruptWrite) let _c = unsafe close(ackRead) let _d = unsafe close(ackWrite)
