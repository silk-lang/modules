        let ok = unsafe s2.block.append(unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe atConst(input, at)), i64.toUsize(dataReadlen)) drop s2
        if !ok { return i32.toI64(ERR_NOMEM) }
      }
      at = at + readlen
      let s3 = unsafe ses(&mut a, sp) s3.payloadLeft = s3.payloadLeft - readlen let remaining = s3.payloadLeft let flags = s3.hdFlags drop s3
      if remaining == 0 {
        if u8.bitAnd(flags, F_END_HEADERS) == 0 {
          let s4 = unsafe ses(&mut a, sp) s4.sbufLength = 0 s4.sbufMark = 9 s4.padlen = 0
          s4.ib = if st == IB_READ_HEADER_BLOCK { IB_EXPECT_CONTINUATION } else { IB_IGN_CONTINUATION }
        } else {
