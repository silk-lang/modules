pub export "C" fn uv_udp_getpeername(udp: *mut u8, name: *mut u8, length: *mut i32) -> i32 { return unsafe socketName(udp, true, name, length) }
pub export "C" fn uv_udp_getsockname(udp: *mut u8, name: *mut u8, length: *mut i32) -> i32 { return unsafe socketName(udp, false, name, length) }
// libuv's uv__udp_check_before_send: the address length, or a negative errno.
unsafe fn checkBeforeSend(udp: *mut u8, address: ?*const u8) -> i32 {
  if unsafe kindOf(udp) != UV_UDP { return -EINVAL }
  let connected = unsafe has(udp, UDP_CONNECTED)
  if !Pointer.isNull<u8>(address) && connected { return -EISCONN }
  if Pointer.isNull<u8>(address) && !connected { return -EDESTADDRREQ }
  if Pointer.isNull<u8>(address) { return 0 }
  let a = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(address)
  let family = familyOf(a)
  if family == AF_INET { return 16 }
  if family == AF_INET6 { return 28 }
  if family == AF_UNIX { return u32.toI32(SOCKADDR_UN_BYTES) }
  return -EINVAL
}
// libuv's uv__udp_prep_pkt: a struct msghdr for one datagram.
unsafe fn preparePacket(header: *mut u8, bufs: *mut u8, count: u32, address: ?*mut u8) -> i32 {
