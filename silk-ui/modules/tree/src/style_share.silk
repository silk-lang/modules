//! A node takes the matched style of another whose selector inputs and ancestors equal its own:
//! a sibling, or the matching child of its parent's twin, as the rows of a list are to each other.
//! Rules that read only identity, state and ancestors give both the same result, and the other
//! node's record says whether its match read more than that (`Resolved.reads`): matching the
//! node would run the same tests in the same order, up to the first one the two can differ on.
//! Edge position and emptiness join the comparison when a sheet reads them. A match that read
//! siblings or an index holds for the node when the siblings it can reach and its index agree
//! too, within the bounds the sheets give (`Sharing`); one that read descendants is not shared.
//! Where neither neighbor serves, as in rows that alternate, `UiTree.styleModels` finds a node
//! of the same kind that matched earlier in the pass, under the same parent or one of its class.
import engine { UiTree }
import node { Node, NONE, WATCH_OUTSIDE }
import mutation { Declaration, NodeKind }
import selector_tree { SelectorTree }
import style_identity { NodeIdentity }
import properties.values
import svg_css.element { ElementTree, NO_ELEMENT }
import svg_css.selectors
import svg_css.selectors { Sharing }
import silk.collections.hash { Hash }
import silk.core.option { Option }
import silk.color.rgba { Rgba }
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

fn sameList(a: &[Declaration], b: &[Declaration]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length {
    if !values.sameDeclaration(&a[i], &b[i]) { return false }
    i = i + 1
  }
  return true
}

fn sameIdentity(a: Option<&NodeIdentity>, b: Option<&NodeIdentity>) -> bool {
  let left = match a { Option.Some { value } => value _ => { return b.isNone() } }
  let right = match b { Option.Some { value } => value _ => { return false } }
  // An id names one element, and custom properties build their own variable scope.
  if left.hasId || right.hasId || left.custom().length != 0 || right.custom().length != 0 { return false }
  if left.hasClasses != right.hasClasses || !left.sameKey(right) { return false }
  if left.attributes().length != right.attributes().length { return false }
  let mut i: usize = 0
  while i < left.attributes().length {
    let one = &left.attributes()[i]
    let other = &right.attributes()[i]
    if String.view(&one.name) != String.view(&other.name) || String.view(&one.value) != String.view(&other.value) { return false }
    i = i + 1
  }
  return true
}

fn plainBox(node: &Node) -> bool {
  return node.kind == NodeKind.Box && node.live && !node.isGenerated() && node.starting().length == 0
}

const STRONG: u32 = selectors.READS_INDEX | selectors.READS_SIBLINGS | selectors.READS_DESCENDANTS

fn readsOf(node: &Node) -> u32 { return match node.sheetStyle() { Option.Some { value } => value.reads _ => 0 } }

/// Whether a selector testing `two` in place of `one`, as a sibling of the element it matches,
/// finds the same name, attributes, state and, where a sheet reads it, emptiness.
fn sameKind(tree: &UiTree<'_>, adapter: &SelectorTree<'_, '_>, one: u32, two: u32, reads: u32) -> bool {
  let a = tree.node(one)
  let b = tree.node(two)
  // Nodes that hold one class were alike when they took it, and are restyled when that changes.
  if a.styleClass != 0 && a.styleClass == b.styleClass && !a.styleDirty && !b.styleDirty { return true }
  if a.kind != NodeKind.Box || b.kind != NodeKind.Box || !sameIdentity(a.identity(), b.identity()) { return false }
  if adapter.state(u32.toUsize(one)).bits != adapter.state(u32.toUsize(two)).bits { return false }
  return u32.bitAnd(reads, selectors.READS_EMPTY) == 0 || adapter.isEmpty(u32.toUsize(one)) == adapter.isEmpty(u32.toUsize(two))
}

/// Whether the `count` element siblings after `slot` exist and are of its kind.
fn followed(tree: &UiTree<'_>, adapter: &SelectorTree<'_, '_>, slot: u32, count: usize, reads: u32) -> bool {
  let mut at = u32.toUsize(slot)
  let mut i: usize = 0
  while i < count {
    at = adapter.nextSibling(at)
    if at == NO_ELEMENT || !sameKind(tree, adapter, slot, usize.toU32(at), reads) { return false }
    i = i + 1
  }
  return true
}

/// Whether `slot` and the clean, classed node `other` would match the same rules given equal ancestors.
fn alike(tree: &UiTree<'_>, adapter: &SelectorTree<'_, '_>, slot: u32, other: u32, reads: u32) -> bool {
  let node = tree.node(slot)
  let model = tree.node(other)
  if !plainBox(model) || model.styleDirty || model.styleClass == 0 || u32.bitAnd(model.styleWatch, WATCH_OUTSIDE) != 0 { return false }
  let shared = match model.sheetStyle() { Option.Some { value } => value.plain _ => false }
  if !shared || !sameIdentity(node.identity(), model.identity()) { return false }
  if adapter.state(u32.toUsize(slot)).bits != adapter.state(u32.toUsize(other)).bits { return false }
  let one = u32.toUsize(slot)
  let two = u32.toUsize(other)
  if u32.bitAnd(reads, selectors.READS_EDGE) != 0 {
    if (adapter.previousSibling(one) == NO_ELEMENT) != (adapter.previousSibling(two) == NO_ELEMENT) { return false }
    if (adapter.nextSibling(one) == NO_ELEMENT) != (adapter.nextSibling(two) == NO_ELEMENT) { return false }
  }
  if u32.bitAnd(reads, selectors.READS_EMPTY) != 0 && adapter.isEmpty(one) != adapter.isEmpty(two) { return false }
  return sameList(node.base.asSlice(), model.base.asSlice()) && sameList(node.hover(), model.hover()) && sameList(node.active(), model.active())
    && sameList(node.focus(), model.focus()) && sameList(node.focusVisible(), model.focusVisible())
}

/// The node `slot` took its record from, while both still hold the same class.
fn twinOf(tree: &UiTree<'_>, slot: u32) -> u32 {
  let node = tree.node(slot)
  let found = node.styleTwin
  if found == NONE || node.styleClass == 0 || u32.toUsize(found) >= tree.nodes.length() { return NONE }
  let other = tree.node(found)
  if !other.live || other.styleDirty || other.styleClass != node.styleClass { return NONE }
  return found
}

/// The longest run of earlier siblings `inStep` compares.
const REACH: usize = 32

/// Whether the siblings before `one` and before `two` are as many and pairwise of one kind.
/// Twin links alone do not say so: a child can enter one parent without the other's restyling.
fn inStep(tree: &UiTree<'_>, adapter: &SelectorTree<'_, '_>, one: u32, two: u32, reads: u32) -> bool {
  let mut a = adapter.previousSibling(u32.toUsize(one))
  let mut b = adapter.previousSibling(u32.toUsize(two))
  let mut i: usize = 0
  while a != NO_ELEMENT && b != NO_ELEMENT {
    if i == REACH || !sameKind(tree, adapter, usize.toU32(a), usize.toU32(b), reads) { return false }
    a = adapter.previousSibling(a)
    b = adapter.previousSibling(b)
    i = i + 1
  }
  return a == b
}

/// Whether the match of `cousin`, a child of the parent's twin, holds for `slot`. What comes
/// before the two has to agree, and what comes after where an index counts from the end.
/// A test on an ancestor's siblings, index or descendants is one the parents were never
/// compared on.
fn cousinHolds(tree: &UiTree<'_>, adapter: &SelectorTree<'_, '_>, slot: u32, cousin: u32, reads: u32, sharing: Sharing) -> bool {
  let read = readsOf(tree.node(cousin))
  if u32.bitAnd(read, u32.shiftLeft(STRONG, selectors.READS_ABOVE)) != 0 { return false }
  if u32.bitAnd(read, STRONG) == 0 { return true }
  if u32.bitAnd(read, selectors.READS_DESCENDANTS) != 0 || !inStep(tree, adapter, slot, cousin, reads) { return false }
  if u32.bitAnd(reads, selectors.READS_INDEX) == 0 { return true }
  if sharing.period == 0 || sharing.fromEnd { return false }
  return followed(tree, adapter, slot, sharing.tail, reads) && followed(tree, adapter, cousin, sharing.tail, reads)
}

/// An earlier sibling whose match holds for `slot`, or NONE. `previous` is alike `slot`.
/// Selectors tell elements one period apart from each other only by the siblings before them:
/// `siblings` of them at most, each of which has to equal the one a period before it. That
/// holds when `lead + (siblings + 1) * period` siblings of `slot`'s kind come before it.
fn siblingHolds(tree: &UiTree<'_>, adapter: &SelectorTree<'_, '_>, slot: u32, previous: u32, reads: u32, sharing: Sharing) -> u32 {
  if u32.bitAnd(readsOf(tree.node(previous)), STRONG) == 0 { return previous }
  let indexed = u32.bitAnd(reads, selectors.READS_INDEX) != 0
  let period = if indexed { sharing.period } else { 1 }
  if period == 0 { return NONE }
  let steps = if u32.bitAnd(reads, selectors.READS_SIBLINGS) != 0 { sharing.siblings } else { 0 }
  let mut lead = if indexed { sharing.lead } else { 0 }
  // `:first-child` sets the first sibling apart from the ones a step can reach.
  if lead == 0 && steps != 0 && u32.bitAnd(reads, selectors.READS_EDGE) != 0 { lead = 1 }
  if indexed && !followed(tree, adapter, slot, sharing.tail, reads) { return NONE }
  let mut model = NONE
  let mut at = u32.toUsize(slot)
  let mut i: usize = 0
  while i < lead + (steps + 1) * period {
    at = adapter.previousSibling(at)
    if at == NO_ELEMENT || !sameKind(tree, adapter, slot, usize.toU32(at), reads) { return NONE }
    i = i + 1
    if i == period { model = usize.toU32(at) }
  }
  if u32.bitAnd(readsOf(tree.node(model)), selectors.READS_DESCENDANTS) != 0 { return NONE }
  return if model == previous || alike(tree, adapter, slot, model, reads) { model } else { NONE }
}

/// A node whose matched style `slot` can take, or NONE. Its selector inputs equal `slot`'s and
/// its ancestors equal `slot`'s: it is a sibling, or a child of the parent's own twin.
pub fn twin(tree: &UiTree<'_>, slot: u32, reads: u32, sharing: Sharing) -> u32 {
  let node = tree.node(slot)
  if !plainBox(node) || node.parent == NONE || tree.styleOverrides().length != 0 { return NONE }
  let adapter = SelectorTree { tree: tree }
  let previous = adapter.previousSibling(u32.toUsize(slot))
  // A record holds values resolved against the parent's color, which a transition can change
  // on one parent only.
  let uncle = twinOf(tree, node.parent)
  if uncle != NONE && sameColor(&tree.node(uncle).computed().text.color, &tree.node(node.parent).computed().text.color) {
    let mut cousin = NO_ELEMENT
    if previous == NO_ELEMENT { cousin = adapter.firstChild(u32.toUsize(uncle)) }
    else {
      let before = twinOf(tree, usize.toU32(previous))
      if before != NONE && tree.node(before).parent == uncle { cousin = adapter.nextSibling(u32.toUsize(before)) }
    }
    if cousin != NO_ELEMENT && alike(tree, &adapter, slot, usize.toU32(cousin), reads)
      && cousinHolds(tree, &adapter, slot, usize.toU32(cousin), reads, sharing) { return usize.toU32(cousin) }
  }
  if previous != NO_ELEMENT && alike(tree, &adapter, slot, usize.toU32(previous), reads) {
    return siblingHolds(tree, &adapter, slot, usize.toU32(previous), reads, sharing)
  }
  return earlier(tree, &adapter, slot, reads)
}

/// What nodes that can stand in for each other have in common: the class of the parent,
/// which nodes with equal ancestors share, and the node's own classes. 0 for a node that
/// takes no part. Equal keys are only a hint; `alike` decides.
pub fn modelKey(tree: &UiTree<'_>, slot: u32) -> u64 {
  let node = tree.node(slot)
  if !plainBox(node) || node.parent == NONE || tree.styleOverrides().length != 0 { return 0 }
  let above = tree.node(node.parent).styleClass
  let group = if above != 0 { u32.toU64(above) } else { u32.toU64(node.parent) | 0x100000000 }
  let mut key = Hash.mix(&Hash.seed(5407), group)
  if let Option<&NodeIdentity>.Some { value } = node.identity() {
    if value.hasId || value.custom().length != 0 { return 0 }
    key = Hash.combine(key, usize.toU64(String.utf8Bytes(value.tag()).length))
    key = Hash.combine(key, usize.toU64(value.attributes().length))
    let atoms = value.classAtoms()
    let mut i: usize = 0
    while i < atoms.length {
      key = Hash.combine(key, usize.toU64(atoms[i]))
      i = i + 1
    }
  }
  return if key == 0 { 1 } else { key }
}

/// A node of `slot`'s kind that matched selectors earlier in this pass, wherever it sits among
/// the children of `slot`'s parent or of a parent holding the same class. Its match holds for
/// `slot` when it ran no test on siblings, an index or descendants; under another parent, the
/// tests on ancestors must not have either, and the record's color comes from the parent.
fn earlier(tree: &UiTree<'_>, adapter: &SelectorTree<'_, '_>, slot: u32, reads: u32) -> u32 {
  let key = modelKey(tree, slot)
  if key == 0 { return NONE }
  let found = match tree.styleModels.get(key) { Option.Some { value } => value _ => { return NONE } }
  if found == slot || u32.toUsize(found) >= tree.nodes.length() || !alike(tree, adapter, slot, found, reads) { return NONE }
  let read = readsOf(tree.node(found))
  if u32.bitAnd(read, STRONG) != 0 { return NONE }
  let parent = tree.node(slot).parent
  let other = tree.node(found).parent
  if other == parent { return found }
  if other == NONE || u32.bitAnd(read, u32.shiftLeft(STRONG, selectors.READS_ABOVE)) != 0 { return NONE }
  let above = tree.node(parent)
  let beside = tree.node(other)
  if above.styleClass == 0 || above.styleClass != beside.styleClass || above.styleDirty || beside.styleDirty { return NONE }
  return if sameColor(&above.computed().text.color, &beside.computed().text.color) { found } else { NONE }
}

fn sameColor(a: &Rgba<f32>, b: &Rgba<f32>) -> bool { return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a }
