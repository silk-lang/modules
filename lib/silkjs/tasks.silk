import silk.cli.command { Command, CommandLine }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }

union Tasks {
  CheckCapabilities,
  Check,
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("silkjs", "SilkJS engine and runtime tasks")
      |> Command.variant("CheckCapabilities", "Verify the runtime capability graph is up to date")
      |> Command.variant("Check", "Check core SilkJS packages")
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.CheckCapabilities => {
        run Task.silk(
          &[
            "task",
            "--manifest-path",
            "modules/runtime/tools/capabilities/silk.toml",
            "graph",
            "--check",
          ],
        )
      }
      Tasks.Check => {
        let packages = [
          "silkjs-engine",
          "silkjs-runtime",
          "silkjs-runtime-cli",
          "silkjs",
          "silkjs-silk",
          "silkjs-runtime-capabilities",
          "pm",
        ]
        let mut i = usize.ZERO
        while i < packages.length {
          run Task.silk(&["check", "--package", packages[i]])
          i = i + usize.ONE
        }
      }
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
