          if isFatal(rv7) { return i32.toI64(rv7) }
          unsafe ibReset(sp)
        }
      }
    } else if st == IB_IGN_DATA {
      let readlen = unsafe payloadReadLen(sp, at, end)
      let s = unsafe ses(&mut a, sp) s.payloadLeft = s.payloadLeft - readlen let remaining = s.payloadLeft drop s
      at = at + readlen
      if readlen > 0 {
        let rv = unsafe updateRecvConnectionWindow(sp, readlen)
        if isFatal(rv) { return i32.toI64(rv) }
        if unsafe state(sp) == IB_IGN_ALL { return inlen }
        if unsafe noAutoWindow(sp) {
          let rv2 = unsafe updateConsumed(sp, nullStream(), readlen)
          if isFatal(rv2) { return i32.toI64(rv2) }
          if unsafe state(sp) == IB_IGN_ALL { return inlen }
        }
      }
      if remaining == 0 { unsafe ibReset(sp) }
    } else {
      return inlen
    }
    if !busy && at == end { break }
  }
  return usize.toI64(at)
}
// READ_HEAD after its nine bytes: 0 to go on, 2 to go on even with no input left, 1 to return the
// whole input, or a fatal error.
unsafe fn readHead(sp: *mut Session) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp)
  s.hdLength = u32.toUsize(u32.shiftRight(unsafe sbU32Raw(&s.*), 8))
  s.hdKind = s.sbuf[3] s.hdFlags = s.sbuf[4]
  s.hdStream = u32.wrappingToI32(u32.bitAnd(u32.bitOr(u32.bitOr(u32.shiftLeft(u8.toU32(s.sbuf[5]), 24), u32.shiftLeft(u8.toU32(s.sbuf[6]), 16)), u32.bitOr(u32.shiftLeft(u8.toU32(s.sbuf[7]), 8), u8.toU32(s.sbuf[8]))), 2147483647))
  s.payloadLeft = s.hdLength
  let tooLarge = s.hdLength > u32.toUsize(s.local.maxFrameSize)
  let kind = s.hdKind let builtin = s.options.builtin let server = s.server let payload = s.payloadLeft drop s
  if tooLarge {
    let rv = unsafe terminateSession(sp, FRAME_SIZE_ERROR, b"too large frame size")
    if isFatal(rv) { return rv }
    return 1
  }
  if kind == DATA {
    let s2 = unsafe ses(&mut a, sp) s2.hdFlags = u8.bitAnd(s2.hdFlags, u8.bitOr(F_END_STREAM, F_PADDED)) drop s2
    let rv = unsafe dataFailFast(sp)
    if unsafe state(sp) == IB_IGN_ALL { return 1 }
    if rv == ERR_IGN_PAYLOAD { unsafe setState(sp, IB_IGN_DATA) return 2 }
    if isFatal(rv) { return rv }
    let pad = unsafe handlePad(sp)
    if pad < 0 {
      let rv2 = unsafe terminateSession(sp, PROTOCOL_ERROR, b"DATA: insufficient padding space")
      if isFatal(rv2) { return rv2 }
      return 1
    }
    unsafe setState(sp, if pad == 1 { IB_READ_PAD_DATA } else { IB_READ_DATA })
    return 2
  }
  if kind == HEADERS {
    let s2 = unsafe ses(&mut a, sp) s2.hdFlags = u8.bitAnd(s2.hdFlags, u8.bitOr(u8.bitOr(F_END_STREAM, F_END_HEADERS), u8.bitOr(F_PADDED, F_PRIORITY))) let flags = s2.hdFlags drop s2
    let pad = unsafe handlePad(sp)
    if pad < 0 {
      let rv2 = unsafe terminateSession(sp, PROTOCOL_ERROR, b"HEADERS: insufficient padding space")
      if isFatal(rv2) { return rv2 }
      return 1
    }
    if pad == 1 { unsafe setState(sp, IB_READ_NBYTE) return 0 }
    let pri = priorityLen(flags)
    if pri > 0 {
      if payload < pri { unsafe setState(sp, IB_FRAME_SIZE_ERROR) return 2 }
      unsafe setState(sp, IB_READ_NBYTE) unsafe setMark(sp, pri)
      return 0
    }
    return unsafe afterHeadersHead(sp)
  }
  if kind == PRIORITY {
    let s2 = unsafe ses(&mut a, sp) s2.hdFlags = 0 drop s2
    if payload != 5 { unsafe setState(sp, IB_FRAME_SIZE_ERROR) return 2 }
    unsafe setState(sp, IB_READ_NBYTE) unsafe setMark(sp, 5)
    return 0
  }
  if kind == RST_STREAM || kind == WINDOW_UPDATE {
    let s2 = unsafe ses(&mut a, sp) s2.hdFlags = 0 drop s2
    if payload != 4 { unsafe setState(sp, IB_FRAME_SIZE_ERROR) return 2 }
    unsafe setState(sp, IB_READ_NBYTE) unsafe setMark(sp, 4)
    return 0
  }
  if kind == SETTINGS {
    let s2 = unsafe ses(&mut a, sp) s2.hdFlags = u8.bitAnd(s2.hdFlags, F_ACK) let flags = s2.hdFlags
    if s2.hdLength % 6 != 0 || (u8.bitAnd(flags, F_ACK) != 0 && payload > 0) { s2.ib = IB_FRAME_SIZE_ERROR return 2 }
    if s2.floodCounter >= s2.maxOutboundAck && u8.bitAnd(flags, F_ACK) == 0 { return ERR_FLOODED }
    s2.ib = IB_READ_SETTINGS
    if payload > 0 {
