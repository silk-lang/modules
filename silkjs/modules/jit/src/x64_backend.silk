      return ()
    }
    if op == Op.CheckBound {
      // The object is a fast Array (the `check.array` before it): the index against its
      // count, unsigned, so one below zero leaves too.
      run self.stressGuard(inst.exit)
      let fields = self.fields
      let mut arr = inst.a
      if self.on { arr = self.storage(inst.a) }
      let place = self.at(inst.b)
      run self.a.load(Width.W64, Reg.R11, payloadOf(arr))
      run getI32(&mut self.a, Reg.R8, place)
      run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.elementCount)))
      run self.a.jcc(Cond.AboveOrEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
      // Below 2^31 too: a proven access doubles its index in 32 bits. A count is at most
      // its list's capacity, which fields.capacityMask bounds (2^30 - 1), so the test above
      // said so already; a wider mask would need the sign tested here.
      if fields.capacityMask >= 0x80000000 {
        run self.a.test(Width.W32, Reg.R8, Reg.R8)
        run self.a.jcc(Cond.Sign, self.exitLabels.get(u32.toUsize(inst.exit)))
      }
      self.cachedArr = NONE
      return ()
    }
    if op == Op.GrowBound {
      // The object is a fast Array (the `check.array` before it). An end below its count
      // asks nothing; for one past it the engine grows the Array (frames.ARRAY_GROW, the
      // Array's cell under r8 and the two ends in r9), or declines and the code leaves.
      run self.stressGuard(inst.exit)
      let fields = self.fields
      let leave = self.exitLabels.get(u32.toUsize(inst.exit))
      let mut arr = inst.a
      if self.on { arr = self.storage(inst.a) }
      let high = self.at(inst.b)
      run self.a.load(Width.W64, Reg.R11, payloadOf(arr))
      run getI32(&mut self.a, Reg.R8, high)
      run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.elementCount)))
      self.cachedArr = NONE
      if !self.on {
        run self.a.jcc(Cond.AboveOrEqual, leave)
        return ()
      }
      let done = run self.a.label()
      run self.a.jcc(Cond.Below, done)
      // Neither end may be negative: the two share r9 as halves.
      let low = self.at(i32.wrappingToU32(inst.k))
      run getI32(&mut self.a, Reg.R9, low)
      run self.a.mov(Width.W32, Reg.Rax, Reg.R8)
      run self.a.alu(Alu.Or, Width.W32, Reg.Rax, Reg.R9)
      run self.a.jcc(Cond.Sign, leave)
      run self.a.mov(Width.W32, Reg.R8, Reg.R8)
      run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 32)
      run self.a.alu(Alu.Or, Width.W64, Reg.R9, Reg.R8)
      run self.keepFragile()
      let p = self.plan
      if function.exit(inst.exit).frames == 0 { run self.a.storeImm(Width.W64, p.sf(p.f.currentPc), u32.wrappingToI32(inst.pc)) }
      run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(u64.bitOr(frames.SERVICE_ARRAY, frames.ARRAY_GROW)))
      run self.a.lea(Width.W64, Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(arr * SLOT_BYTES + SLOT_BYTES)))
      run self.keepXmm()
      run self.engineCall()
      run self.restoreXmm()
      run self.restoreFragile()
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, leave)
      self.a.bind(done)
      return ()
    }
    if op == Op.CheckTag {
      run self.stressGuard(inst.exit)
      // Proved by an earlier check or field site (ssa_shapes).
      if (self.shapes.fact(self.cursor) & FACT_OBJECT) != 0 { return () }
