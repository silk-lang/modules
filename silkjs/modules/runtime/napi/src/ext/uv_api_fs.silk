    if !initRequest(loop, req, FS_COPYFILE, cb) { return -EINVAL }
    if (flags & (~(COPYFILE_EXCL | COPYFILE_FICLONE | COPYFILE_FICLONE_FORCE))) != 0 { return -EINVAL }
    let status = setPaths(req, path, newPath, cb)
    if status != 0 { return status }
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, setFields(req)) r.flags = flags drop r
    return post(loop, req, cb)
  }
}
