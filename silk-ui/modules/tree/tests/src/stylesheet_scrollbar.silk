import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, CpuSnapshot, Input, BUTTON_PRIMARY, NONE }
import ui_tree.scrollbar
import ui_tree.scrollbar { Geometry }
import ui_tree.scrollbar_parts
import ui_fixtures.fixtures as fixtures
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.written
import svg_css.tokens { CssError }
import vector.geometry_error { GeometryError }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.num.f32

fn frame(width: f32) -> FrameInput { return FrameInput { width: width, height: 240.0, scale: 1.0, time: 0.0 } }
fn close(a: f32, b: f32) -> bool { return f32.abs(a-b) < 0.02 }
fn geometry(tree: &UiTree<'_>, vertical: bool) -> Geometry {
  let node = tree.node(tree.slotOf(2))
  let fragment = tree.output.fragments.values.asSlice()[tree.fragmentOf.get(node.css)]
  return scrollbar.geometryOf(node, &fragment, if vertical { node.scrollY() } else { node.scrollX() }, vertical)
}

effect fn base(batch: &mut Batch) ! CssError | OutOfMemoryError ? &mut Allocator {
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("scroll") })
  let declared = run written.declarations(b"display:block;width:200px;height:200px;overflow:auto;background:white")
  run batch.style(2, declared.asSlice())
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  let child = run written.declarations(b"display:block;width:400px;height:600px")
  run batch.style(3, child.asSlice())
}

effect fn sheet(batch: &mut Batch, css: &[u8]) ! CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let compiled = run compile.compile(css, &Options.make())
  let bytes = run compiled.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
}

effect fn paintingAndDragging() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch)
  run sheet(&mut batch, b".scroll::-webkit-scrollbar{width:20px;height:12px;background-color:blue}.scroll::-webkit-scrollbar-track{background-color:lime}.scroll::-webkit-scrollbar-thumb{background-color:red;border:2px solid blue;border-radius:4px}")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  let vertical = geometry(&tree, true)
  let horizontal = geometry(&tree, false)
  run Testing.expect(vertical.thumb.visible && close(vertical.thumb.rect.width(),20.0) && close(vertical.track.height(),188.0), "vertical scrollbar uses authored width and reserves the horizontal bar")
  run Testing.expect(horizontal.thumb.visible && close(horizontal.thumb.rect.height(),12.0) && close(horizontal.track.width(),180.0), "horizontal scrollbar uses authored height and reserves the vertical bar")
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let painted = run snapshot.render(&tree)
  let ink = painted.pixel(190,10)
  let border = painted.pixel(181,10)
  let track = painted.pixel(190,100)
  let corner = painted.pixel(180,0)
  run Testing.expect(ink.r > 250 && ink.g < 5 && ink.b < 5, "thumb background paints")
  run Testing.expect(border.b > 250 && border.r < 5, "thumb border paints")
  run Testing.expect(corner.g > 250 && corner.r < 5, "rounded thumb corners expose the track")
  run Testing.expect(track.g > 250 && track.r < 5 && track.b < 5, "track paints behind the thumb")
  run tree.dispatch(Input.PointerDown { x: 182.0, y: 10.0, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 })
  run Testing.expect(tree.thumbSlot == tree.slotOf(2), "the extra authored width is draggable")
  run tree.dispatch(Input.PointerMove { x: 182.0, y: 30.0, modifiers: 0 })
  run tree.dispatch(Input.PointerUp { x: 182.0, y: 30.0, button: BUTTON_PRIMARY, modifiers: 0 })
  run Testing.expect(close(tree.scrollOffset(2).y,20.0 * vertical.thumb.ratio), "dragging uses the painted thumb travel ratio")
  run tree.frame(frame(240.0))
  run snapshot.sync(&mut tree)
  let moved = run snapshot.render(&tree)
  let old = moved.pixel(190,10)
  let new = moved.pixel(190,30)
  run Testing.expect(old.g > 250 && new.r > 250, "composited scrolling moves only the thumb over the stationary track")
  run batch.removeStyleSheet(0, 1)
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(scrollbar_parts.of(tree.node(tree.slotOf(2))).isNone() && close(geometry(&tree,true).thumb.rect.width(),6.0), "removing the sheet restores native scrollbar geometry")
}

test effect fn stylesheetScrollbarsSharePaintAndDragGeometry() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run paintingAndDragging() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn dependencies() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch)
  let container = run written.declarations(b"container-type:inline-size")
  run batch.style(2,container.asSlice())
  run sheet(&mut batch,b".scroll::-webkit-scrollbar{width:10cqw}.scroll:hover::-webkit-scrollbar-thumb{display:none}")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(close(geometry(&tree,true).thumb.rect.width(),20.0), "scrollbar units use their originating container")
  let small = run written.declarations(b"width:100px")
  run batch.style(2,small.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(close(geometry(&tree,true).thumb.rect.width(),10.0), "container resize updates scrollbar geometry")
  run tree.dispatch(Input.PointerMove { x: 20.0, y: 20.0, modifiers: 0 })
  run tree.frame(frame(240.0))
  run Testing.expect(match scrollbar_parts.of(tree.node(tree.slotOf(2))) { Option.Some { value } => value.thumb.hidden _ => false }, "origin hover selects the scrollbar part")
  run tree.dispatch(Input.PointerDown { x: 95.0, y: 10.0, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 })
  run Testing.expect(tree.thumbSlot == NONE, "a hidden thumb cannot begin a drag")
  run tree.dispatch(Input.PointerUp { x: 95.0, y: 10.0, button: BUTTON_PRIMARY, modifiers: 0 })
  run batch.removeStyleSheet(0,1)
  run sheet(&mut batch,b"@container(width>150px){.scroll::-webkit-scrollbar{width:18px}}")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(scrollbar_parts.of(tree.node(tree.slotOf(2))).isNone(), "unmatched conditional parts allocate no persistent style")
  let large = run written.declarations(b"width:200px")
  let mut i: usize = 0
  while i < 2 {
    run batch.style(2,large.asSlice())
    run tree.apply(run batch.take())
    run tree.frame(frame(240.0))
    run Testing.expect(close(geometry(&tree,true).thumb.rect.width(),18.0), "a previously false container query starts styling the part")
    run batch.style(2,small.asSlice())
    run tree.apply(run batch.take())
    run tree.frame(frame(240.0))
    run Testing.expect(scrollbar_parts.of(tree.node(tree.slotOf(2))).isNone(), "query dependencies survive removing a part style")
    i = i + 1
  }
  run batch.removeStyleSheet(0,1)
  run sheet(&mut batch,b".scroll::-webkit-scrollbar{width:10vw}")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(close(geometry(&tree,true).thumb.rect.width(),24.0), "scrollbar viewport lengths resolve")
  run tree.frame(frame(400.0))
  run Testing.expect(close(geometry(&tree,true).thumb.rect.width(),40.0), "viewport changes invalidate scrollbar parts")
  let thin = run written.declarations(b"scrollbar-width:thin")
  run batch.style(2,thin.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  run Testing.expect(close(geometry(&tree,true).thumb.rect.width(),3.0) && scrollbar_parts.of(tree.node(tree.slotOf(2))).isNone(), "standard thin scrollbar width overrides vendor part styling")
  let none = run written.declarations(b"scrollbar-width:none")
  run batch.style(2,none.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  run Testing.expect(!geometry(&tree,true).thumb.visible && !geometry(&tree,false).thumb.visible, "standard none hides both scrollbars")
}

test effect fn stylesheetScrollbarsTrackOriginStatesContainerQueriesAndViewportUnits() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dependencies() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// `scrollbar-color` paints the thumb and the track, inherits, and wins over the pseudo-elements
/// as it does in Chromium.
effect fn scrollbarColors() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch)
  run sheet(&mut batch, b".scroll{scrollbar-color:red lime}.scroll::-webkit-scrollbar-thumb{background-color:blue}")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(scrollbar_parts.of(tree.node(tree.slotOf(2))).isNone(), "scrollbar-color turns the pseudo-elements off")
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let painted = run snapshot.render(&tree)
  let thumb = painted.pixel(195, 10)
  let track = painted.pixel(195, 150)
  run Testing.expect(thumb.r > 250 && thumb.g < 5 && thumb.b < 5, "the thumb takes the first color")
  run Testing.expect(track.g > 250 && track.r < 5 && track.b < 5, "the track takes the second")
  run batch.removeStyleSheet(0, 1)
  let inherited = run written.declarations(b"scrollbar-color:blue transparent")
  run batch.style(1, inherited.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run snapshot.sync(&mut tree)
  let again = run snapshot.render(&tree)
  let blue = again.pixel(195, 10)
  let clear = again.pixel(195, 150)
  run Testing.expect(blue.b > 250 && blue.r < 5, "the scroller inherits its parent's colors")
  run Testing.expect(clear.r > 250 && clear.g > 250 && clear.b > 250, "a transparent track shows the background")
  let auto = run written.declarations(b"scrollbar-color:auto")
  run batch.style(1, auto.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run snapshot.sync(&mut tree)
  let native = (run snapshot.render(&tree)).pixel(195, 10)
  run Testing.expect(native.r == native.g && native.g == native.b && native.r < 250, "auto goes back to the gray native thumb")
}

test effect fn stylesheetScrollbarColorPaintsThumbAndTrack() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run scrollbarColors() |> Effect.provideMut<Allocator>(&mut allocator)
}
