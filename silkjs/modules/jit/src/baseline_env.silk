  if unsafe engine.setterOf(unsafe runtimeOf(env), ip, cell, out) { return 1 }
  return 0
}
export "C" fn baselinePutElement(env: *mut BaselineEnv, ip: *const u8, cell: *mut ValueBits) -> u32 {
  unsafe noteMiss(env, ip, cell, unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(cell), 1))
  if unsafe engine.storeElement(unsafe runtimeOf(env), cell, Pointer.address<u8>(ip), unsafe sitesOf(env)) { return 1 }
  return 0
}
export "C" fn baselineStoreElement(env: *mut BaselineEnv, object: *const ValueBits, key: *const ValueBits, value: *const ValueBits, ip: *const u8) -> u32 {
  if unsafe engine.storeElementOf(unsafe runtimeOf(env), object, key, value, Pointer.address<u8>(ip), unsafe sitesOf(env)) { return 1 }
  return 0
}
@inlineAlways
fn toInt32Fast(value: ValueBits, out: &mut i32) -> bool {
  return match value {
    ValueBits.Int { value: n } => { out.* = n true }
    ValueBits.Float64 { value: n } => { out.* = primitives.numberToInt32(n) true }
    ValueBits.Bool { value: flag } => { out.* = if flag { 1 } else { 0 } true }
    ValueBits.Null => { out.* = 0 true }
    ValueBits.Undefined => { out.* = 0 true }
    _ => false
  }
}

@inlineAlways
fn primitiveAtom(value: ValueBits) -> u32 {
  return match value {
    ValueBits.Bool { value: flag } => if flag { atoms.JS_ATOM_true } else { atoms.JS_ATOM_false }
    ValueBits.Null => atoms.JS_ATOM_null
    ValueBits.Undefined => atoms.JS_ATOM_undefined
    _ => 0
  }
}

export "C" fn baselineArithmetic(env: *mut BaselineEnv, left: *const ValueBits, right: *const ValueBits, opcode: u32, out: *mut ValueBits) -> u32 {
  let code = u32.wrappingToU8(opcode)
  if unsafe engine.arithmetic(left, right, code, out) { return 1 }
  let a = unsafe Pointer.read<ValueBits>(left)
  let b = unsafe Pointer.read<ValueBits>(right)
  if code == op.OP_mod {
    if a.isNumber() && b.isNumber() {
      let res = f64.remainder(a.numericValue(), b.numericValue())
      unsafe Pointer.write<ValueBits>(out, ValueBits.number(res))
      // Return 2 so S_ARITHMETIC still notes the site for double OP_mod tiering.
      return 2
    }
    return 0
  }
  if code == op.OP_and || code == op.OP_or || code == op.OP_xor
    || code == op.OP_shl || code == op.OP_sar || code == op.OP_shr {
    let mut x: i32 = 0
    let mut y: i32 = 0
    if toInt32Fast(a, &mut x) && toInt32Fast(b, &mut y) {
      if code == op.OP_and { unsafe Pointer.write<ValueBits>(out, ValueBits.Int { value: x & y }) return 1 }
      if code == op.OP_or { unsafe Pointer.write<ValueBits>(out, ValueBits.Int { value: x | y }) return 1 }
      if code == op.OP_xor { unsafe Pointer.write<ValueBits>(out, ValueBits.Int { value: x ^ y }) return 1 }
      let xb = i32.wrappingToU32(x)
      let shift = i32.wrappingToU32(y) & 31
      if code == op.OP_shl { unsafe Pointer.write<ValueBits>(out, ValueBits.Int { value: u32.wrappingToI32(u32.shiftLeft(xb, shift)) }) return 1 }
      if code == op.OP_sar { unsafe Pointer.write<ValueBits>(out, ValueBits.Int { value: i32.shiftRight(x, u32.toI32(shift)) }) return 1 }
      unsafe Pointer.write<ValueBits>(out, ValueBits.number(u32.toF64(u32.shiftRight(xb, shift))))
      return 1
    }
  }
  return 0
}

export "C" fn baselineConcatPrim(env: *mut BaselineEnv, left: *const ValueBits, right: *const ValueBits, out: *mut ValueBits, flags: u32) -> u32 {
  let rt = unsafe runtimeOf(env)
  if unsafe gc.observesFresh(rt) { return 0 }
  let a = unsafe Pointer.read<ValueBits>(left)
  let b = unsafe Pointer.read<ValueBits>(right)
  let mut leftStr = a
  let mut rightStr = b
  if a.isString() {
    let atom = primitiveAtom(b)
    if atom == 0 { return 0 }
    let anchor = ()
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
    rightStr = state.atoms.borrowedString(atom)
    drop state
  } else if b.isString() {
    let atom = primitiveAtom(a)
    if atom == 0 { return 0 }
    let anchor = ()
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
    leftStr = state.atoms.borrowedString(atom)
    drop state
  } else {
    return 0
  }
  if !leftStr.isString() || !rightStr.isString() { return 0 }
  let mut system = Allocator.systemAllocatorProvider()
  let joined = run Effect.result(Strings.concat(leftStr, rightStr)) |> Effect.provideMut<Allocator>(&mut system)
  match move joined {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => {
      unsafe Pointer.write<ValueBits>(out, value)
      if (flags & 1) != 0 && a.isString() { Strings.release(a) }
      if (flags & 2) != 0 && b.isString() { Strings.release(b) }
      return 1
    }
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { .. } => { return 0 }
  }
}
export "C" fn baselinePutVar(env: *mut BaselineEnv, function: *mut HeapHeader, index: u32, cell: *const ValueBits) -> u32 {
  if unsafe engine.writeVariable(function, index, cell) { return 1 }
  return 0
}
