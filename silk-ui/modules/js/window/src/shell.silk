//! Desktop calls of a ui-js application (notifications, the tray, global shortcuts, menus,
//! file dialogs, the window's state, opening URLs, dragging files out), served on the
//! window's platform, and the platform's desktop events, handed to JavaScript.
import ui_js.lib { JsHost, JsError, ShellRequest }
import ui_tree.legacy { UiTree }
import ui_tree.cssom_view { elementFromPoint }
import ui_tree_window.keys { codeName }
import ui_tree_window.platform_thread { HostPlatform }
import window.event { Event, Modifiers, MouseButton }
import window.keys { KeyCode, keyCodeFromValue }
import window.menu { MenuBar, OpenDialog, SaveDialog, Shortcut, ShortcutKey, SystemItem }
import window.types { DialogId, WindowError, WindowId }
import window.keys { NamedKey, namedKeyFromValue }
import ui_tree_window.keys { keyName }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.f32
import silk.num.f64
import silk.num.usize
import window.platform { Platform }
import window.shell { Notification, Tray, TrayIcon }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.text.string { String, ScalarStep }

/// Whether shortcuts take Command where other systems take Control.
const COMMAND_KEY: bool = Intrinsic.targetOperatingSystem() == "darwin"

/// The host's answer to a `__ui.shell` call.
pub struct ShellAnswer {
  pub call: u32,
  pub value: f64,
}

/// Does JavaScript's desktop calls `requests` on `platform`, oldest first, for `window` and
/// its `tree`.
pub effect fn serveShell(
  requests: List<ShellRequest>,
  platform: &mut HostPlatform,
  tree: &mut UiTree<'_>,
  window: WindowId,
) -> List<ShellAnswer>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut rest = move requests
  let mut answers = List<ShellAnswer>.make()
  while rest.length() > 0 {
    let request = rest.remove(0)
    let mut fields = List<string>.make()
    run split(String.view(&request.text), 31, &mut fields)
    let value = if request.op == 0 {
      let notification = Notification { title: field(&fields, 0), body: field(&fields, 1) }
      u32.toF64(run platform.notify(&notification))
    } else if request.op == 1 {
      run setTray(&fields, &mut platform)
    } else if request.op == 2 {
      Platform.removeTray(&mut platform.*)
      0.0
    } else if request.op == 3 {
      let code = codeOf(field(&fields, 1))
      let modifiers = modifiersOf(number(field(&fields, 2)))
      let held = code != KeyCode.Unidentified
        && run platform.registerShortcut(number(field(&fields, 0)), code, modifiers)
      if held {
        1.0
      } else {
        0.0
      }
    } else if request.op == 4 {
      Platform.unregisterShortcut(&mut platform.*, number(field(&fields, 0)))
      0.0
    } else if request.op == 5 {
      let flags = number(field(&fields, 2))
      let options = OpenDialog {
        title: field(&fields, 0),
        directory: optional(field(&fields, 1)),
        files: (flags & 1) != 0,
        directories: (flags & 2) != 0,
        multiple: (flags & 4) != 0,
        extensions: field(&fields, 3),
        parent: Option<WindowId>.some(window),
      }
      dialogAnswer(run Effect.result(platform.openFileDialog(&options)))
    } else if request.op == 6 {
      let options = SaveDialog {
        title: field(&fields, 0),
        directory: optional(field(&fields, 1)),
        name: field(&fields, 2),
        extensions: field(&fields, 3),
        parent: Option<WindowId>.some(window),
      }
      dialogAnswer(run Effect.result(platform.saveFileDialog(&options)))
    } else if request.op == 7 {
      let mut bar = MenuBar.make()
      run describeMenu(field(&fields, 0), &mut bar)
      run platform.setMenuBar(&bar)
      1.0
    } else if request.op == 8 {
      let mut menu = MenuBar.make()
      run describeMenu(field(&fields, 2), &mut menu)
      let x = decimal(field(&fields, 0))
      let y = decimal(field(&fields, 1))
      flag(run platform.showContextMenu(window, x, y, &menu))
    } else if request.op == 9 {
      flag(run platform.setBadge(field(&fields, 0)))
    } else if request.op == 10 {
      flag(run platform.setProgress(decimal(field(&fields, 0))))
    } else if request.op == 11 {
      flag(run platform.openUrl(field(&fields, 0)))
    } else if request.op == 12 {
      flag(run platform.revealPath(field(&fields, 0)))
    } else if request.op == 13 {
      let mut lines = List<string>.make()
      run split(field(&fields, 0), 10, &mut lines)
      let mut paths = List<String>.make()
      let mut l: usize = 0
      while l < lines.length() {
        if String.byteLength(lines.get(l)) > 0 { run paths.append(run String.copy(lines.get(l))) }
        l = l + 1
      }
      flag(run platform.startFileDrag(window, paths.asSlice()))
    } else if request.op == 14 {
      let what = number(field(&fields, 0))
      if what == 0 {
        Platform.toggleFullScreen(&mut platform.*, window)
      } else if what == 1 {
        Platform.minimize(&mut platform.*, window)
      } else if what == 2 {
        Platform.setVisible(&mut platform.*, window, true)
        Platform.focus(&mut platform.*, window)
      } else if what == 3 {
        Platform.setVisible(&mut platform.*, window, false)
      } else if what == 4 {
        run platform.setTitle(window, field(&fields, 1))
      }
      0.0
    } else if request.op == 15 {
      drop tree.setPageZoom(f64.toF32(decimal(field(&fields, 0))))
      f32.toF64(tree.pageZoom())
    } else {
      0.0
    }
    run answers.append(ShellAnswer { call: request.call, value: value })
  }
  return move answers
}

effect fn setTray(fields: &List<string>, platform: &mut HostPlatform) -> f64
  ! OutOfMemoryError
  ? &mut Allocator {
  let width = number(field(fields, 1))
  let height = number(field(fields, 2))
  let mut pixels = List<u8>.make()
  let hex = String.utf8Bytes(field(fields, 4))
  let mut i: usize = 0
  while i + 1 < hex.length {
    run pixels.append(nibble(hex[i]) * 16 + nibble(hex[i + 1]))
    i = i + 2
  }
  if u32.toUsize(width) * u32.toUsize(height) * 4 != pixels.length() || width == 0 {
    return 0.0
  }
  let mut menu = MenuBar.make()
  run describeMenu(field(fields, 5), &mut menu)
  let tray = Tray {
    icon: TrayIcon {
      width: width,
      height: height,
      pixels: pixels.asSlice(),
      template: number(field(fields, 3)) != 0,
    },
    tooltip: field(fields, 0),
    menu: &menu,
  }
  return if run platform.setTray(&tray) {
    1.0
  } else {
    0.0
  }
}

/// Builds `menu` from the lines JavaScript packed it into: `B` title opens a submenu and `E`
/// ends it, `S` is a separator, `R` a system item by its `SystemItem` index, and `A` an item:
/// `Aaction,enabled,checked,key,modifiers,title`, where key is empty, `c` and a character,
/// or `n` and a named key.
effect fn describeMenu(text: string, menu: &mut MenuBar) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut lines = List<string>.make()
  run split(text, 10, &mut lines)
  let mut depth: u32 = 0
  let mut l: usize = 0
  while l < lines.length() {
    let line = lines.get(l)
    let bytes = String.utf8Bytes(line)
    l = l + 1
    if bytes.length == 0 {
      continue
    }
    let rest = String.slice(line, 1, bytes.length - 1)
    if bytes[0] == 66 {
      run menu.begin(rest)
      depth = depth + 1
    } else if bytes[0] == 69 {
      if depth > 0 {
        run menu.end()
        depth = depth - 1
      }
    } else if bytes[0] == 83 {
      run menu.separator()
    } else if bytes[0] == 82 {
      match systemItem(number(rest)) {
        Option<SystemItem>.Some { value } => run menu.system(value)
        Option<SystemItem>.None => {}
      }
    } else if bytes[0] == 65 {
      let mut parts = List<string>.make()
      run split(rest, 44, &mut parts)
      if parts.length() < 6 {
        continue
      }

      // The title is everything after the fifth comma; it may hold commas of its own.
      let restBytes = String.utf8Bytes(rest)
      let mut start: usize = 0
      let mut commas: u32 = 0
      while start < restBytes.length && commas < 5 {
        if restBytes[start] == 44 {
          commas = commas + 1
        }
        start = start + 1
      }
      let title = String.slice(rest, start, restBytes.length - start)
      run menu.item(
        title,
        number(parts.get(0)),
        shortcutOf(parts.get(3), number(parts.get(4))),
        number(parts.get(1)) != 0,
        number(parts.get(2)) != 0,
      )
    }
  }
  while depth > 0 {
    run menu.end()
    depth = depth - 1
  }
}

/// The menu shortcut JavaScript wrote as `key` (`c` and a character, `n` and a key name) with
/// the modifier bits of `registerShortcut`.
fn shortcutOf(key: string, bits: u32) -> Option<Shortcut> {
  let bytes = String.utf8Bytes(key)
  if bytes.length < 2 {
    return Option<Shortcut>.None
  }
  let rest = String.slice(key, 1, bytes.length - 1)
  let shortcutKey = if bytes[0] == 99 {
    match String.nextScalar(rest, String.scalarCursor()) {
      Option<ScalarStep>.Some { value } => ShortcutKey.Character { character: String.scalarValue(&value) }
      Option<ScalarStep>.None => {
        return Option<Shortcut>.None
      }
    }
  } else {
    let named = namedOf(rest)
    if named == NamedKey.Unidentified {
      return Option<Shortcut>.None
    }
    ShortcutKey.Named { key: named }
  }
  return Option<Shortcut>.some(Shortcut { key: shortcutKey, modifiers: modifiersOf(bits) })
}

/// The modifiers of `registerShortcut`'s bits: shift 1, control 2, alt 4, meta 8, and 16 for
/// the platform's command key.
fn modifiersOf(bits: u32) -> Modifiers {
  return Modifiers {
    shift: (bits & 1) != 0,
    control: (bits & 2) != 0 || ((bits & 16) != 0 && !COMMAND_KEY),
    alt: (bits & 4) != 0,
    meta: (bits & 8) != 0 || ((bits & 16) != 0 && COMMAND_KEY),
    capsLock: false,
    function: false,
  }
}

fn systemItem(index: u32) -> Option<SystemItem> {
  let items: [SystemItem; 17] = [
    SystemItem.About,
    SystemItem.Services,
    SystemItem.Hide,
    SystemItem.HideOthers,
    SystemItem.ShowAll,
    SystemItem.Quit,
    SystemItem.CloseWindow,
    SystemItem.Minimize,
    SystemItem.Zoom,
    SystemItem.ToggleFullScreen,
    SystemItem.BringAllToFront,
    SystemItem.Undo,
    SystemItem.Redo,
    SystemItem.Cut,
    SystemItem.Copy,
    SystemItem.Paste,
    SystemItem.SelectAll,
  ]
  if u32.toUsize(index) >= items.length {
    return Option<SystemItem>.None
  }
  return Option<SystemItem>.some(items[u32.toUsize(index)])
}

/// A dialog's id as the answer, 0 when it could not open.
fn dialogAnswer(opened: Result<DialogId, WindowError | OutOfMemoryError>) -> f64 {
  return match move opened {
    Result<DialogId, WindowError | OutOfMemoryError>.Success { value } => u32.toF64(value.value)
    _ => 0.0
  }
}

fn flag(on: bool) -> f64 {
  return if on {
    1.0
  } else {
    0.0
  }
}

fn optional<'a>(text: string<'a>) -> Option<string<'a>> {
  return if String.byteLength(text) == 0 {
    Option<string<'a>>.None
  } else {
    Option<string<'a>>.some(text)
  }
}

/// A desktop event as `__ui.shellEvent(kind, a, x, y, text)` takes it (see
/// `JsHost.shellEvent`).
pub struct ShellEvent {
  pub kind: u32,
  pub a: f64,
  pub x: f64,
  pub y: f64,
  pub text: String,
}

/// `event` as JavaScript takes it, when it is a desktop event: a file drag (aimed at the node
/// under it in `tree`), a global shortcut, the tray or a notification click.
pub effect fn shellEventOf(tree: &UiTree<'_>, event: &Event) -> Option<ShellEvent>
  ! OutOfMemoryError
  ? &mut Allocator {
  let made = match &event.* {
    Event.FileDragEntered { position, paths, .. } => ShellEvent {
      kind: 0,
      a: u32.toF64(elementFromPoint(tree, position.x, position.y)),
      x: position.x,
      y: position.y,
      text: run lines(paths.asSlice()),
    }
    Event.FileDragMoved { position, .. } => ShellEvent {
      kind: 1,
      a: u32.toF64(elementFromPoint(tree, position.x, position.y)),
      x: position.x,
      y: position.y,
      text: String.make(),
    }
    Event.FileDragLeft { .. } => ShellEvent { kind: 2, a: 0.0, x: 0.0, y: 0.0, text: String.make() }
    Event.FileDropped { position, paths, .. } => ShellEvent {
      kind: 3,
      a: u32.toF64(elementFromPoint(tree, position.x, position.y)),
      x: position.x,
      y: position.y,
      text: run lines(paths.asSlice()),
    }
    Event.GlobalShortcut { id } => ShellEvent {
      kind: 4,
      a: u32.toF64(id),
      x: 0.0,
      y: 0.0,
      text: String.make(),
    }
    Event.TrayClicked { button } => ShellEvent {
      kind: 5,
      a: match button {
        MouseButton.Middle => 1.0
        MouseButton.Right => 2.0
        _ => 0.0
      },
      x: 0.0,
      y: 0.0,
      text: String.make(),
    }
    Event.MenuAction { action } => ShellEvent {
      kind: 6,
      a: u32.toF64(action),
      x: 0.0,
      y: 0.0,
      text: String.make(),
    }
    Event.NotificationClicked { id } => ShellEvent {
      kind: 7,
      a: u32.toF64(id),
      x: 0.0,
      y: 0.0,
      text: String.make(),
    }
    Event.DialogClosed { dialog, paths } => ShellEvent {
      kind: 8,
      a: u32.toF64(dialog.value),
      x: 0.0,
      y: 0.0,
      text: run lines(paths.asSlice()),
    }
    Event.ContextMenuClosed { .. } => ShellEvent {
      kind: 9,
      a: 0.0,
      x: 0.0,
      y: 0.0,
      text: String.make(),
    }
    Event.FullScreenChanged { fullScreen, .. } => ShellEvent {
      kind: 10,
      a: flag(fullScreen),
      x: 0.0,
      y: 0.0,
      text: String.make(),
    }
    _ => {
      return Option<ShellEvent>.None
    }
  }
  return Option<ShellEvent>.some(move made)
}

/// Hands a desktop event of the platform to JavaScript. Says whether `event` was one.
pub effect fn deliverShell(host: &mut JsHost<'_>, tree: &UiTree<'_>, event: &Event) -> bool
  ! OutOfMemoryError | JsError
  ? &mut Allocator {
  let made = run shellEventOf(tree, event)
  return match move made {
    Option<ShellEvent>.Some { value } => {
      run host.shellEvent(value.kind, value.a, value.x, value.y, String.view(&value.text))
      true
    }
    Option<ShellEvent>.None => false
  }
}

effect fn lines(paths: &[String]) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut joined = String.make()
  let mut i: usize = 0
  while i < paths.length {
    if i > 0 {
      run joined.append("\n")
    }
    run joined.append(String.view(&paths[i]))
    i = i + 1
  }
  return move joined
}

/// The pieces of `bytes` between the `separator` bytes, in `out`.
effect fn split<'a>(text: string<'a>, separator: u8, out: &mut List<string<'a>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut start: usize = 0
  let mut i: usize = 0
  while i <= bytes.length {
    if i == bytes.length || bytes[i] == separator {
      run out.append(String.slice(text, start, i - start))
      start = i + 1
    }
    i = i + 1
  }
}

fn field<'a>(fields: &List<string<'a>>, at: usize) -> string<'a> {
  return if at < fields.length() {
    fields.get(at)
  } else {
    ""
  }
}

fn number(text: string) -> u32 {
  let bytes = String.utf8Bytes(text)
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 {
    value = value * 10 + u8.toU32(bytes[i] - 48)
    i = i + 1
  }
  return value
}

/// `text` as a decimal number, with an optional sign and fraction; 0 when it is not one.
fn decimal(text: string) -> f64 {
  let bytes = String.utf8Bytes(text)
  let mut i: usize = 0
  let negative = bytes.length > 0 && bytes[0] == 45
  if negative {
    i = 1
  }
  let mut value: f64 = 0.0
  while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 {
    value = value * 10.0 + u32.toF64(u8.toU32(bytes[i] - 48))
    i = i + 1
  }
  if i < bytes.length && bytes[i] == 46 {
    i = i + 1
    let mut scale: f64 = 0.1
    while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 {
      value = value + u32.toF64(u8.toU32(bytes[i] - 48)) * scale
      scale = scale / 10.0
      i = i + 1
    }
  }
  return if negative {
    -value
  } else {
    value
  }
}

/// The named key whose `key` value is `name`.
fn namedOf(name: string) -> NamedKey {
  let mut value: u32 = 1
  while value < 56 {
    let key = namedKeyFromValue(value)
    if keyName(key) == name {
      return key
    }
    value = value + 1
  }
  return NamedKey.Unidentified
}

fn nibble(digit: u8) -> u8 {
  if digit >= 48 && digit <= 57 {
    return digit - 48
  }
  if digit >= 97 && digit <= 102 {
    return digit - 87
  }
  if digit >= 65 && digit <= 70 {
    return digit - 55
  }
  return 0
}

/// The key whose UI Events `code` is `name`.
fn codeOf(name: string) -> KeyCode {
  let mut value: u32 = 1
  while value < 129 {
    let code = keyCodeFromValue(value)
    if codeName(code) == name {
      return code
    }
    value = value + 1
  }
  return KeyCode.Unidentified
}
