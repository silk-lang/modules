//! C exports over ext.zlib_stream for the differential harness (tests/zlib-differential).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.i32
import silk.num.usize
import ext.zlib_stream { Call, Deflater, Inflater, message }
import stdlib_copy.compress.deflate { Hash }
import silk.compress.checksum { CompressionChecksum }
import silk.num.u32

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()

unsafe fn nonnull<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn bytes<'a>(anchor: &'a (), p: ?*mut u8, length: usize) -> &'a [u8] {
  if length == 0 { return unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(Pointer.fromRef<u8>(&EMPTY[0])), 0) }
  return unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(p)), length)
}
const EMPTY: [u8; 1] = [0]

unsafe fn report(call: &Call, consumed: ?*mut usize, written: ?*mut usize) -> i32 {
  unsafe Pointer.write<usize>(unsafe nonnull(consumed), call.consumed)
  unsafe Pointer.write<usize>(unsafe nonnull(written), call.written)
  return call.status
}

export "C" fn zs_deflate_new(level: i32, windowBits: i32, memLevel: i32, strategy: i32) -> ?*mut u8 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let made = run Effect.result(Deflater.make(level, windowBits, memLevel, strategy)) |> Effect.provideMut<Allocator>(&mut allocator)
  match move made {
    Result<Result<Deflater, i32>, OutOfMemoryError>.Success { value } => {
      match move value {
        Result<Deflater, i32>.Success { value: stream } => {
          let raw = unsafe calloc(1, Layout.of<Deflater>().bytes)
          unsafe Pointer.put<Deflater>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Deflater>(unsafe nonnull(raw)), move stream)
          return raw
        }
        Result<Deflater, i32>.Failure {..} => { return Pointer.null<u8>() }
      }
    }
    Result<Result<Deflater, i32>, OutOfMemoryError>.Failure {..} => { return Pointer.null<u8>() }
  }
}
export "C" fn zs_deflate_new_rolling(level: i32, windowBits: i32, memLevel: i32, strategy: i32) -> ?*mut u8 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let made = run Effect.result(Deflater.makeWith(level, windowBits, memLevel, strategy, Hash.Rolling)) |> Effect.provideMut<Allocator>(&mut allocator)
  match move made {
    Result<Result<Deflater, i32>, OutOfMemoryError>.Success { value } => {
      match move value {
        Result<Deflater, i32>.Success { value: stream } => {
          let raw = unsafe calloc(1, Layout.of<Deflater>().bytes)
          unsafe Pointer.put<Deflater>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Deflater>(unsafe nonnull(raw)), move stream)
          return raw
        }
        Result<Deflater, i32>.Failure {..} => { return Pointer.null<u8>() }
      }
    }
    Result<Result<Deflater, i32>, OutOfMemoryError>.Failure {..} => { return Pointer.null<u8>() }
  }
}
export "C" fn zs_deflate_free(handle: ?*mut u8) -> () {
  let owned = unsafe Pointer.take<Deflater>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Deflater>(unsafe nonnull(handle)))
  drop owned
  unsafe free(handle)
}
export "C" fn zs_deflate(handle: ?*mut u8, input: ?*mut u8, length: usize, output: ?*mut u8, capacity: usize, flush: i32, consumed: ?*mut usize, written: ?*mut usize) -> i32 {
  let mut anchor = ()
  let stream = unsafe Pointer.borrowMut<(), Deflater>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Deflater>(unsafe nonnull(handle)))
  let held = ()
  let source = unsafe bytes(&held, input, length)
  let mut other = ()
  let target = unsafe Pointer.borrowManyMut<(), u8>(&mut other, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(output)), capacity)
  let call = Deflater.deflate(&mut stream, source, &mut target, flush)
  return unsafe report(&call, consumed, written)
}
export "C" fn zs_deflate_reset(handle: ?*mut u8) -> () {
  let mut anchor = ()
  let stream = unsafe Pointer.borrowMut<(), Deflater>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Deflater>(unsafe nonnull(handle)))
  let _status = Deflater.reset(&mut stream)
}
export "C" fn zs_deflate_params(handle: ?*mut u8, level: i32, strategy: i32) -> i32 {
  let mut anchor = ()
  let stream = unsafe Pointer.borrowMut<(), Deflater>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Deflater>(unsafe nonnull(handle)))
  return Deflater.params(&mut stream, level, strategy)
}
export "C" fn zs_deflate_dictionary(handle: ?*mut u8, dictionary: ?*mut u8, length: usize) -> i32 {
  let mut anchor = ()
  let stream = unsafe Pointer.borrowMut<(), Deflater>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Deflater>(unsafe nonnull(handle)))
  let held = ()
  return Deflater.setDictionary(&mut stream, unsafe bytes(&held, dictionary, length))
}

export "C" fn zs_inflate_new(windowBits: i32) -> ?*mut u8 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let made = run Effect.result(Inflater.make(windowBits)) |> Effect.provideMut<Allocator>(&mut allocator)
  match move made {
    Result<Result<Inflater, i32>, OutOfMemoryError>.Success { value } => {
      match move value {
        Result<Inflater, i32>.Success { value: stream } => {
          let raw = unsafe calloc(1, Layout.of<Inflater>().bytes)
          unsafe Pointer.put<Inflater>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Inflater>(unsafe nonnull(raw)), move stream)
          return raw
        }
        Result<Inflater, i32>.Failure {..} => { return Pointer.null<u8>() }
      }
    }
    Result<Result<Inflater, i32>, OutOfMemoryError>.Failure {..} => { return Pointer.null<u8>() }
  }
}
export "C" fn zs_inflate_free(handle: ?*mut u8) -> () {
  let owned = unsafe Pointer.take<Inflater>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Inflater>(unsafe nonnull(handle)))
  drop owned
  unsafe free(handle)
}
export "C" fn zs_inflate(handle: ?*mut u8, input: ?*mut u8, length: usize, output: ?*mut u8, capacity: usize, flush: i32, consumed: ?*mut usize, written: ?*mut usize, text: ?*mut u8) -> i32 {
  let mut anchor = ()
  let stream = unsafe Pointer.borrowMut<(), Inflater>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Inflater>(unsafe nonnull(handle)))
  let held = ()
  let source = unsafe bytes(&held, input, length)
  let mut other = ()
  let target = unsafe Pointer.borrowManyMut<(), u8>(&mut other, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(output)), capacity)
  let call = Inflater.inflate(&mut stream, source, &mut target, flush)
  let words = message(call.message)
  let mut index: usize = 0
  let out = unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(text))
  while index < words.length && index < 63 {
    unsafe Pointer.write<u8>(unsafe Pointer.atMut<u8>(out, index), words[index])
    index = index + 1
  }
  unsafe Pointer.write<u8>(unsafe Pointer.atMut<u8>(out, index), 0)
  return unsafe report(&call, consumed, written)
}
export "C" fn zs_inflate_reset(handle: ?*mut u8) -> i32 {
  let mut anchor = ()
  let stream = unsafe Pointer.borrowMut<(), Inflater>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Inflater>(unsafe nonnull(handle)))
  return Inflater.reset(&mut stream)
}
export "C" fn zs_inflate_dictionary(handle: ?*mut u8, dictionary: ?*mut u8, length: usize) -> i32 {
  let mut anchor = ()
  let stream = unsafe Pointer.borrowMut<(), Inflater>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Inflater>(unsafe nonnull(handle)))
  let held = ()
  return Inflater.setDictionary(&mut stream, unsafe bytes(&held, dictionary, length))
}
export "C" fn zs_crc32(crc: u32, data: ?*mut u8, length: usize) -> u32 {
  let held = ()
  return CompressionChecksum.crc32Update(crc, unsafe bytes(&held, data, length))
}
pub fn main() -> i32 { return 0 }
