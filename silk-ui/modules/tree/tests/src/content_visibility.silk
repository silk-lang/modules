//! `content-visibility: auto`: elements far from the viewport skip their contents and keep the
//! size they last had; they wake when they come near, and before geometry is read from inside.
//! The scroll container 2 (200px tall, in a 300px viewport) holds wrapper 3 with items 10 to 29,
//! each holding one 100px tall child (the item's id plus 100) and estimated at 50px.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, FrameInput, Mutation }
import ui_fixtures.fixtures as fixtures
import svg_css.written
import svg_css.tokens { CssError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

const FRAME: FrameInput = FrameInput { width: 300.0, height: 300.0, scale: 1.0, time: 0.0 }
const ITEM: &[u8] = b"display:block;content-visibility:auto;contain-intrinsic-size:auto 50px"

effect fn styled(batch: &mut Batch, id: u32, css: &[u8]) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let declarations = run written.declarations(css)
  run batch.style(id, declarations.asSlice())
}

effect fn items<'f>(tree: &mut UiTree<'f>, item: &[u8]) -> ()
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run styled(&mut batch, 1, b"display:block;width:300px;height:300px")
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run styled(&mut batch, 2, b"display:block;width:200px;height:200px;overflow-y:auto")
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  run styled(&mut batch, 3, b"display:block")
  let mut id: u32 = 10
  while id < 30 {
    run batch.create(id, NodeKind.Box)
    run batch.append(3, id)
    run styled(&mut batch, id, item)
    run batch.create(id + 100, NodeKind.Box)
    run batch.append(id, id + 100)
    run styled(&mut batch, id + 100, b"display:block;height:100px")
    id = id + 1
  }
  run tree.apply(run batch.take())
  run tree.frame(FRAME)
}

effect fn apply<'f>(tree: &mut UiTree<'f>, id: u32, css: &[u8]) -> ()
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run styled(&mut batch, id, css)
  run tree.apply(run batch.take())
  run tree.frame(FRAME)
}

effect fn scrollTo<'f>(tree: &mut UiTree<'f>, y: f32) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut scroll = Batch.make()
  run scroll.scrollTo(2, 0.0, y)
  run tree.apply(run scroll.take())
  run tree.frame(FRAME)
  run tree.frame(FRAME)
}

/// Whether node `id` has a fragment in the last layout.
fn laidOut(tree: &UiTree<'_>, id: u32) -> bool {
  let css = tree.node(tree.slotOf(id)).css
  return css < tree.fragmentOf.length() && tree.fragmentOf.get(css) < tree.output.fragments.values.length()
}

fn height(tree: &UiTree<'_>, id: u32) -> f32 {
  let node = tree.node(tree.slotOf(id))
  return tree.output.fragments.values.asSlice()[tree.fragmentOf.get(node.css)].size.height
}

fn top(tree: &UiTree<'_>, id: u32) -> f32 {
  let node = tree.node(tree.slotOf(id))
  return tree.output.fragments.values.asSlice()[tree.fragmentOf.get(node.css)].location.y
}

effect fn sleepsFarAndWakesNear() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run items(&mut tree, ITEM)
  // Items within two viewports (600px) of the 300px viewport are awake at their real size;
  // the rest keep the estimate and lay out nothing inside.
  run Testing.expect(laidOut(&tree, 110), "the first item lays out its child")
  run Testing.expect(height(&tree, 10) == 100.0, "height of 10 is 100.0")
  run Testing.expect(!laidOut(&tree, 129), "the last item skips its child")
  run Testing.expect(height(&tree, 29) == 50.0, "height of 29 is 50.0")

  // At the end, the last items wake and the first ones sleep at the size they had.
  run scrollTo(&mut tree, 5000.0)
  run Testing.expect(laidOut(&tree, 129), "the last item wakes near the viewport")
  run Testing.expect(height(&tree, 29) == 100.0, "height of 29 is 100.0")
  run Testing.expect(!laidOut(&tree, 110), "the first item sleeps far from it")
  run Testing.expect(height(&tree, 10) == 100.0, "height of 10 is 100.0")

  // A change inside a skipped item waits for it to wake; geometry read from inside wakes it.
  run apply(&mut tree, 110, b"display:block;height:150px")
  run Testing.expect(!laidOut(&tree, 110), "a change does not wake the item")
  run Testing.expect(height(&tree, 10) == 100.0, "height of 10 is 100.0")
  run tree.wakeFor(110)
  run Testing.expect(laidOut(&tree, 110), "a geometry read wakes the item")
  run Testing.expect(height(&tree, 110) == 150.0, "height of 110 is 150.0")
  run Testing.expect(height(&tree, 10) == 150.0, "height of 10 is 150.0")
}

test effect fn contentVisibilityAutoSkipsFarContents() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sleepsFarAndWakesNear() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// With every item awake, the layout is the one without `content-visibility`, but for the
/// containment `auto` brings.
effect fn wakesToTheSameLayout() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut plain = run UiTree.make(&fonts)
  run items(&mut plain, b"display:block;contain:layout paint style")
  let mut lazy = run UiTree.make(&fonts)
  run items(&mut lazy, ITEM)
  run lazy.wakeAll()
  let mut id: u32 = 10
  while id < 30 {
    run Testing.expect(laidOut(&lazy, id + 100), "every child is laid out")
    run Testing.expect(top(&lazy, id) == top(&plain, id), "items sit where they do without auto")
    run Testing.expect(height(&lazy, id) == height(&plain, id), "items keep the height they have without auto")
    run Testing.expect(top(&lazy, id + 100) == top(&plain, id + 100), "children sit where they do without auto")
    id = id + 1
  }
}

test effect fn contentVisibilityAutoWakesToTheSameLayout() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run wakesToTheSameLayout() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Removing an item and reusing its id, and dropping `auto` from a skipped item, leave no skip
/// behind.
effect fn forgetsRemovedAndPlainItems() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run items(&mut tree, ITEM)
  run Testing.expect(!laidOut(&tree, 128), "item 28 starts skipped")
  run apply(&mut tree, 28, b"content-visibility:visible")
  run Testing.expect(laidOut(&tree, 128), "an item that is no longer auto lays out its contents")
  let mut batch = Batch.make()
  run batch.push(Mutation.Destroy { id: 29 })
  run tree.apply(run batch.take())
  run tree.frame(FRAME)
  let mut again = Batch.make()
  run again.create(29, NodeKind.Box)
  run again.append(3, 29)
  run styled(&mut again, 29, b"display:block;height:20px")
  run again.create(129, NodeKind.Box)
  run again.append(29, 129)
  run styled(&mut again, 129, b"display:block;height:10px")
  run tree.apply(run again.take())
  run tree.frame(FRAME)
  run Testing.expect(laidOut(&tree, 129), "a new item in a reused slot is not skipped")
  run Testing.expect(height(&tree, 29) == 20.0, "height of 29 is 20.0")
}

test effect fn contentVisibilityAutoForgetsRemovedItems() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run forgetsRemovedAndPlainItems() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Items are awake within two viewports of the viewport and skipped beyond three, whatever
/// the scroll that brought them there.
effect fn expectReviewed(tree: &UiTree<'_>) -> () ! AssertionError<'static> {
  let y = tree.node(tree.slotOf(2)).scrollY()
  let mut id: u32 = 10
  while id < 30 {
    let yMin = top(&tree.*, id) - y
    let yMax = yMin + height(&tree.*, id)
    let distance: f32 = if yMax < 0.0 { 0.0 - yMax } else if yMin > 300.0 { yMin - 300.0 } else { 0.0 }
    if laidOut(&tree.*, id + 100) {
      run Testing.expect(distance <= 900.0, "an awake item is within three viewports")
    } else {
      run Testing.expect(distance > 600.0, "a skipped item is beyond two viewports")
    }
    id = id + 1
  }
}

effect fn reviewsWhileScrollingInSmallSteps() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run items(&mut tree, ITEM)
  run expectReviewed(&tree)
  let mut y: f32 = 0.0
  while y < 2000.0 {
    y = y + 7.0
    let mut scroll = Batch.make()
    run scroll.scrollTo(2, 0.0, y)
    run tree.apply(run scroll.take())
    run tree.frame(FRAME)
    run expectReviewed(&tree)
  }
  run Testing.expect(laidOut(&tree, 129), "the last item woke on the way")
  run Testing.expect(!laidOut(&tree, 110), "and the first one sleeps")
  while y > 0.0 {
    y = y - 13.0
    let mut scroll = Batch.make()
    run scroll.scrollTo(2, 0.0, y)
    run tree.apply(run scroll.take())
    run tree.frame(FRAME)
    run expectReviewed(&tree)
  }
  run Testing.expect(laidOut(&tree, 110), "the first item woke on the way back")
}

test effect fn contentVisibilityAutoFollowsSmallScrolls() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run reviewsWhileScrollingInSmallSteps() |> Effect.provideMut<Allocator>(&mut allocator)
}
