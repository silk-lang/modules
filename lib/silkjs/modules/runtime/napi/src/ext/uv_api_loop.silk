// libuv's stdio container flags.
const UV_IGNORE: i32 = 0
const UV_CREATE_PIPE: i32 = 1
const UV_INHERIT_FD: i32 = 2
const UV_INHERIT_STREAM: i32 = 4
const UV_READABLE_PIPE: i32 = 16
const UV_WRITABLE_PIPE: i32 = 32
/// libuv's uv_spawn: stdio containers become descriptors for the child (UV_CREATE_PIPE a socket
/// pair whose parent end opens as the container's pipe after the spawn, UV_INHERIT_FD the
/// descriptor, UV_INHERIT_STREAM the stream's descriptor), the child starts, and the record's `pid`
/// is set. As in libuv, the pipes are opened even when exec failed, and its error is returned.
pub unsafe export "C" fn spawn(loop: *mut u8, handle: *mut u8, options: *const Options) -> i32 as "uv_spawn" {
