//! What compiled code (js_compiled) asks the engine about objects: the interpreter's own fast
//! paths, wrapped so they need no Machine. None runs JavaScript, allocates or fails; each
//! answers false where the interpreter would take a slower path, and the code then
//! deoptimizes to let the interpreter run that instruction.
import silk.mem.pointer { Pointer }
import silk.num.u32
import js_heap { HeapCell, HeapHeader }
import silk.core.option { Option }
import js_value { ValueBits }
import js_core_types { ContextState, RuntimeState, ScopeData, VarRef, ObjectData, ObjectPayload, ShapeData, FieldCacheEntry, FastArrayData, TypedArrayCache, TransitionEntry, SlotBits, FIELD_PROTO_KEY, SCOPE_OPERAND, MEMO_ENTRIES, MAX_CHAIN_DEPTH, JS_PROP_C_W_E, scopeSlot }
import js_scopes as scopes
import silk.num.u16
import thin_list { ThinList }
import js_strings { Strings }
import js_class_data as classes
import silk.num.i32
import silk.num.i64
import silk.num.usize
import silk.num.u8
import silk.num.u64
import silk.core.ownership { Copy }
import js_var_refs as cells
import js_gc as gc
import js_atoms { AtomTable }
import js_atom_data as atoms
import js_compiled { CompiledFrame }
import js_vm_property_ops as properties
import js_typed_array_write as typedWrite
import js_vm_object_ops as objectOps
import js_vm_operators as operators
import js_primitives as primitives
import js_primitives { EqualityMode }
import js_array_intrinsics_support as arraySupport
import js_native_functions as nativeFunctions

/// The named property read of the get_field, get_loc_field8 or get_arg_field8 (cached
/// false: its inline key) or get_field2 (cached true: its site cache) at bytecode offset pc
/// of frame.bytecode, from object, first by the shapes the site recorded for a compiler
/// (readSiteShapes). True with the value retained into out (when retain).
pub unsafe fn readField(frame: &CompiledFrame, pc: u32, cached: bool, retain: bool, object: ValueBits, out: *mut ValueBits) -> bool {
  let ip = unsafe operandAt(frame, pc)
  let target = match object {
    ValueBits.Object { reference } => reference
    _ => {
      // A get_field2 of a string, number or boolean (a method read) looks in its class
      // prototype in the frame's realm, as js_baseline.readFieldCached does.
      if !cached { return false }
      let mut classId = classes.JS_CLASS_STRING
      match object {
        ValueBits.Int { .. } => { classId = classes.JS_CLASS_NUMBER }
        ValueBits.Float64 { .. } => { classId = classes.JS_CLASS_NUMBER }
        ValueBits.Bool { .. } => { classId = classes.JS_CLASS_BOOLEAN }
        _ => {
          if !object.isString() { return false }
          let atom = unsafe properties.fieldAtomAt(ip)
          if atom == atoms.JS_ATOM_length || AtomTable.isInteger(atom) { return false }
        }
      }
      let anchor = ()
      let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, frame.context)
      let start = match context.classPrototypes.get(u32.toUsize(classId)) { ValueBits.Object { reference } => reference _ => { return false } }
      drop context
      return unsafe properties.readFieldCachedAt(frame.runtime, ip, start, out, retain)
    }
  }
  // The code's own tests missed: the shapes the site recorded come before its caches,
  // which hold one or two of them.
  if unsafe properties.readSiteShapes(frame.runtime, ip, target, out, retain) { return true }
  if cached { return unsafe properties.readFieldCachedAt(frame.runtime, ip, target, out, retain) }
  return unsafe properties.readFieldKeyedAt(frame.runtime, ip, target, out, retain)
}

/// The store of the put_field, put_loc_field_loc8 or put_loc_field_arg8 at bytecode offset pc
/// of frame.bytecode of the value at source into object: an own writable data property of
/// the shape its inline key names (writeOwnField) or of another shape, or a new property
/// added in place along a cached transition (writeFieldInPlace). WRITE_STORED with the
/// object holding its own count of the value; WRITE_DECLINED or WRITE_NEEDS_ROOM with
/// nothing changed. A last reference may be displaced only when releaseLast proves no
/// field borrow still depends on it.
pub unsafe fn writeField(frame: &CompiledFrame, pc: u32, object: ValueBits, source: *const ValueBits, releaseLast: bool) -> u32 {
  let target = match object { ValueBits.Object { reference } => reference _ => { return WRITE_DECLINED } }
  let ip = unsafe operandAt(frame, pc)
  // The slot takes a count. Retain before replacing it in case the incoming value
  // aliases the old value; a declined store has taken nothing.
  let mut copy = unsafe (unsafe Pointer.read<ValueBits>(source)).retained()
  if unsafe properties.writeOwnField(ip, target, Pointer.fromMutRef(&mut copy))
    || unsafe properties.writeFieldInPlace(frame.runtime, ip, target, Pointer.fromMutRef(&mut copy), releaseLast) { return WRITE_STORED }
  unsafe gc.releaseDeferred(copy)
  if unsafe properties.addNeedsRoom(frame.runtime, target, unsafe properties.fieldAtomAt(ip)) { return WRITE_NEEDS_ROOM }
  return WRITE_DECLINED
}
/// writeField's answers.
pub const WRITE_DECLINED: u32 = 0
pub const WRITE_STORED: u32 = 1
/// Declined only because the object's slot list is full: the add is an ordinary one along
/// a verified transition, which runs no code of the program's (no setter, no proxy), so the
/// interpreter may make it on the frame with the list grown.
pub const WRITE_NEEDS_ROOM: u32 = 2

/// The operand after the opcode at pc of frame.bytecode: the sites' caches key on its address.
unsafe fn operandAt(frame: &CompiledFrame, pc: u32) -> *const u8 {
  return unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(frame.code), u32.toUsize(pc) + 1)
}

/// The string push_atom_value (empty false: its atom operand) or push_empty_string (empty
/// true) at bytecode offset pc of frame.bytecode pushes, retained into out. False for an
/// integer atom, whose text the interpreter makes.
pub unsafe fn atomValue(frame: &CompiledFrame, pc: u32, empty: bool, out: *mut ValueBits) -> bool {
  let anchor = ()
  let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, frame.runtime)
  if empty { unsafe Pointer.write<ValueBits>(out, rt.atoms.storedValue(atoms.JS_ATOM_empty_string, true)) return true }
  let atom = unsafe properties.fieldAtomAt(unsafe operandAt(frame, pc))
  if AtomTable.isInteger(atom) { return false }
  unsafe Pointer.write<ValueBits>(out, rt.atoms.storedAtomValue(atom))
  return true
}

/// The cell of closure variable index of the running function (get_var's and put_var's
/// operand), or None.
unsafe fn variableCell(frame: &CompiledFrame, index: u32) -> ?*mut HeapHeader {
  return unsafe Pointer.read<?*mut HeapHeader>(unsafe Pointer.at<?*mut HeapHeader>(
    unsafe Pointer.assumeMany<?*mut HeapHeader>(frame.closureReferences), u32.toUsize(index)))
}
/// get_var and get_var_undef of an initialized binding: its value into out, retained unless
/// the reader borrows it from the binding (retain false). False
/// for an uninitialized one (a TDZ read, or a global not yet defined), which the
/// interpreter resolves or throws.
pub unsafe fn readVariable(frame: &CompiledFrame, index: u32, retain: bool, out: *mut ValueBits) -> bool {
  let cell = match Pointer.nonNullMut<HeapHeader>(unsafe variableCell(frame, index)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
  let value = unsafe cells.read(cell)
  if match value { ValueBits.Uninitialized => true _ => false } { return false }
  unsafe Pointer.write<ValueBits>(out, if retain { unsafe value.retained() } else { value })
  return true
}
/// put_var into an initialized, non-const binding of the value at source: the binding takes
/// its own count, and the old value is released deferred (no finalizer runs here). False
/// with nothing changed otherwise.
pub unsafe fn writeVariable(frame: &CompiledFrame, index: u32, source: *const ValueBits) -> bool {
  let cell = match Pointer.nonNullMut<HeapHeader>(unsafe variableCell(frame, index)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
  let anchor = () let binding = unsafe HeapCell.payload<VarRef, ()>(&anchor, cell)
  let constant = binding.isConst drop binding
  if constant { return false }
  if match unsafe cells.read(cell) { ValueBits.Uninitialized => true _ => false } { return false }
  let previous = unsafe cells.replace(cell, unsafe (unsafe Pointer.read<ValueBits>(source)).retained())
  unsafe gc.releaseDeferred(previous)
  return true
}

/// Slot `slot` of the running function's own scope (get_scope0's operand), or None when the
/// function has none.
unsafe fn scopeCell(frame: &CompiledFrame, slot: u32) -> ?*mut ValueBits {
  return match Pointer.nonNullMut<HeapHeader>(frame.scope) {
    Option<*mut HeapHeader>.Some { value } => unsafe Intrinsic.pointerRequalify<*mut ValueBits, ?*mut ValueBits>(unsafe scopeSlot(value, u32.toUsize(slot)))
    Option<*mut HeapHeader>.None => Pointer.null<ValueBits>()
  }
}
/// get_scope0 (checked false) or get_scope0_check (checked true: false for an uninitialized
/// slot, which the interpreter throws for): the slot's value into out, retained unless the
/// reader borrows it (retain false).
pub unsafe fn readScope(frame: &CompiledFrame, slot: u32, checked: bool, retain: bool, out: *mut ValueBits) -> bool {
  let at = match Pointer.nonNullMut<ValueBits>(unsafe scopeCell(frame, slot)) { Option<*mut ValueBits>.Some { value } => value Option<*mut ValueBits>.None => { return false } }
  let value = unsafe Pointer.read<ValueBits>(at)
  if checked && match value { ValueBits.Uninitialized => true _ => false } { return false }
  unsafe Pointer.write<ValueBits>(out, if retain { unsafe value.retained() } else { value })
  return true
}
/// put_scope0 or set_scope0 (checked false), or put_scope0_check (checked true: false with
/// nothing changed for an uninitialized slot) of the value at source: the slot takes its own
/// count, the old value is released deferred.
pub unsafe fn writeScope(frame: &CompiledFrame, slot: u32, checked: bool, source: *const ValueBits) -> bool {
  let at = match Pointer.nonNullMut<ValueBits>(unsafe scopeCell(frame, slot)) { Option<*mut ValueBits>.Some { value } => value Option<*mut ValueBits>.None => { return false } }
  let previous = unsafe Pointer.read<ValueBits>(at)
  if checked && match previous { ValueBits.Uninitialized => true _ => false } { return false }
  unsafe Pointer.write<ValueBits>(at, unsafe (unsafe Pointer.read<ValueBits>(source)).retained())
  unsafe gc.releaseDeferred(previous)
  return true
}

/// get_var_ref or get_var_ref_check of an initialized binding (index: a slot of the running
/// scope chain when SCOPE_OPERAND is set, else closure cell index): its value, retained into
/// out. False for an uninitialized one, which the interpreter reads or throws for.
pub unsafe fn readCaptured(frame: &CompiledFrame, index: u32, retain: bool, out: *mut ValueBits) -> bool {
  if index >= u16.toU32(SCOPE_OPERAND) {
    if Pointer.isNull<HeapHeader>(frame.scope) { return false }
    let value = unsafe Pointer.read<ValueBits>(unsafe scopes.operandSlot(frame.scope, u32.wrappingToU16(index)))
    if match value { ValueBits.Uninitialized => true _ => false } { return false }
    unsafe Pointer.write<ValueBits>(out, if retain { unsafe value.retained() } else { value })
    return true
  }
  let cell = match Pointer.nonNullMut<HeapHeader>(unsafe variableCell(frame, index)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
  let value = unsafe cells.read(cell)
  if match value { ValueBits.Uninitialized => true _ => false } { return false }
  unsafe Pointer.write<ValueBits>(out, if retain { unsafe value.retained() } else { value })
  return true
}
/// put_var_ref, set_var_ref or put_var_ref_check into an initialized binding of the value at
/// source: the binding takes its own count, the old value is released deferred. False with
/// nothing changed for an uninitialized one.
pub unsafe fn writeCaptured(frame: &CompiledFrame, index: u32, source: *const ValueBits) -> bool {
  if index >= u16.toU32(SCOPE_OPERAND) {
    if Pointer.isNull<HeapHeader>(frame.scope) { return false }
    let at = unsafe scopes.operandSlot(frame.scope, u32.wrappingToU16(index))
    let previous = unsafe Pointer.read<ValueBits>(at)
    if match previous { ValueBits.Uninitialized => true _ => false } { return false }
    unsafe Pointer.write<ValueBits>(at, unsafe (unsafe Pointer.read<ValueBits>(source)).retained())
    unsafe gc.releaseDeferred(previous)
    return true
  }
  let cell = match Pointer.nonNullMut<HeapHeader>(unsafe variableCell(frame, index)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
  if match unsafe cells.read(cell) { ValueBits.Uninitialized => true _ => false } { return false }
  unsafe gc.releaseDeferred(unsafe cells.replace(cell, unsafe (unsafe Pointer.read<ValueBits>(source)).retained()))
  return true
}

/// Read an ordinary object's property without key coercion or user code. The interpreter's
/// helpers return an owned value on success, and decline accessors and exotic prototypes.
pub unsafe fn readKey(frame: &CompiledFrame, object: ValueBits, key: ValueBits, out: *mut ValueBits) -> bool {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = () let receiver = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if receiver.classId() != classes.JS_CLASS_OBJECT || receiver.isExotic() {
    // A formerly ordinary receiver may now be a dense array or a typed array.
    match key { ValueBits.Int { value } => { if value >= 0 { return unsafe readElement(object, value, out) } } _ => {} }
    return false
  }
  let read = match key {
    ValueBits.Int { .. } => unsafe properties.quickIndexRead(frame.runtime, object, key)
    ValueBits.String { .. } => unsafe properties.namedStringRead(frame.runtime, node, key)
    ValueBits.Symbol { .. } => unsafe properties.quickSymbolRead(frame.runtime, object, key)
    _ => { return false }
  }
  match read {
    Option<ValueBits>.Some { value } => { unsafe Pointer.write<ValueBits>(out, value) return true }
    Option<ValueBits>.None => { return false }
  }
}

/// get_array_el and its fused forms on an Int index: a fast Array's element below its
/// length, a typed array's, or a fast arguments object's (the interpreter's denseRead),
/// retained into out. False for anything else.
pub unsafe fn readElement(object: ValueBits, index: i32, out: *mut ValueBits) -> bool {
  match unsafe properties.elementRead(object, ValueBits.Int { value: index }) {
    Option<ValueBits>.Some { value } => { unsafe Pointer.write<ValueBits>(out, value) return true }
    Option<ValueBits>.None => ()
  }
  if unsafe typedOutside(object, index) == OUTSIDE_NONE { return false }
  unsafe Pointer.write<ValueBits>(out, ValueBits.Undefined)
  return true
}
const OUTSIDE_NONE: u8 = 0
const OUTSIDE_NUMBERS: u8 = 1
const OUTSIDE_BIGINTS: u8 = 2
/// Whether index is outside a typed array's view (or the view is detached), where reads give
/// undefined with no prototype lookup and stores of a number are dropped
/// (IntegerIndexedElementGet/Set): OUTSIDE_NUMBERS, or OUTSIDE_BIGINTS for a BigInt array
/// (a number store throws there). OUTSIDE_NONE for anything else.
unsafe fn typedOutside(object: ValueBits, index: i32) -> u8 {
  let node = match object { ValueBits.Object { reference } => reference _ => { return OUTSIDE_NONE } }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  let classId = data.classId()
  match &data.payload {
    ObjectPayload.TypedArray { array } => {
      if index >= 0 && i32.toU64(index) < array.count { return OUTSIDE_NONE }
      if classId == classes.JS_CLASS_BIG_INT64_ARRAY || classId == classes.JS_CLASS_BIG_UINT64_ARRAY { return OUTSIDE_BIGINTS }
      return OUTSIDE_NUMBERS
    }
    _ => { return OUTSIDE_NONE }
  }
}
/// readElement for a reader that borrows the element from the object: out holds it with no
/// count of its own. False, with nothing kept, when the element is a cell only this read
/// holds (nothing would keep it alive for the borrower).
pub unsafe fn readElementBorrowed(object: ValueBits, index: i32, out: *mut ValueBits) -> bool {
  let value = match unsafe properties.elementRead(object, ValueBits.Int { value: index }) {
    Option<ValueBits>.Some { value } => value
    Option<ValueBits>.None => {
      if unsafe typedOutside(object, index) == OUTSIDE_NONE { return false }
      unsafe Pointer.write<ValueBits>(out, ValueBits.Undefined)
      return true
    }
  }
  match ValueBits.heapReference(&value) {
    Option<*mut HeapHeader>.Some { value: reference } => {
      let mut anchor = ()
      let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, reference)
      if header.referenceCount <= 1 { drop header unsafe gc.releaseDeferred(value) return false }
      header.referenceCount = i32.wrappingSubtract(header.referenceCount, 1)
    }
    Option<*mut HeapHeader>.None => ()
  }
  unsafe Pointer.write<ValueBits>(out, value)
  return true
}
/// put_array_el of the value at source over an existing element of a fast Array (index below
/// its length), or one past its end when it has room (the interpreter's appendElementAt): the
/// array takes its own count, an old element is released deferred. False with nothing
/// changed otherwise (holes, growth, other objects). A number into a typed array's element
/// is stored as the interpreter's quickWrite stores it.
pub unsafe fn writeElement(object: ValueBits, index: i32, source: *const ValueBits) -> bool {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  if unsafe typedOutside(object, index) == OUTSIDE_NUMBERS {
    match unsafe Pointer.read<ValueBits>(source) { ValueBits.Int { .. } => { return true } ValueBits.Float64 { .. } => { return true } _ => { return false } }
  }
  if index < 0 { return false }
  let at = i32.toUsize(index)
  let mut anchor = () let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  if data.classId() != classes.JS_CLASS_ARRAY {
    drop data
    // A number into a typed array's element (no count, no conversion that runs code).
    return unsafe typedWrite.quickWrite(node, i32.toU64(index), unsafe Pointer.read<ValueBits>(source))
  }
  let mut old = ValueBits.Undefined
  let mut append = false
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      if at >= array.values().length() { append = true } else {
        old = array.values().get(at)
        array.store(at, unsafe (unsafe Pointer.read<ValueBits>(source)).retained())
      }
    }
    _ => { return false }
  }
  drop data
  if append {
    let value = unsafe Pointer.read<ValueBits>(source)
    if !unsafe properties.appendElementAt(node, at, value) { return false }
    drop unsafe value.retained()
    return true
  }
  unsafe gc.releaseDeferred(old)
  return true
}
/// get_length of a string or an Array (its first own property), into out. False for
/// anything else.
pub unsafe fn readLength(object: ValueBits, out: *mut ValueBits) -> bool {
  match object {
    ValueBits.String { .. } => { unsafe Pointer.write<ValueBits>(out, ValueBits.Int { value: usize.toI32(Strings.length(object)) }) return true }
    ValueBits.Rope { .. } => { unsafe Pointer.write<ValueBits>(out, ValueBits.Int { value: usize.toI32(Strings.length(object)) }) return true }
    ValueBits.Object { reference } => {
      let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      if data.classId() != classes.JS_CLASS_ARRAY { return false }
      let length = data.slot(0).valueBits()
      drop data
      unsafe Pointer.write<ValueBits>(out, unsafe length.retained())
      return true
    }
    _ => { return false }
  }
}

/// Where compiled code finds what an inline field read needs, in bytes from a cell's header
/// unless noted. An object: its shape pointer, the word holding the address of its first slot
/// (each slot a ValueBits), its flags byte and 16-bit class id. A shape: its version. The
/// runtime: RuntimeState.fieldCache (fieldCacheIndex(site) = site & 4095 picks an entry of
/// entryStride bytes; site, key, epoch, holder and holderIndex are offsets in an entry) and
/// shapeEpoch.
pub struct FieldLayout {
  /// Offsets from a compiled frame to its running scope, and from a scope cell to its parent and slots.
  pub frameScope: u32, pub scopeParent: u32, pub scopeSlots: u32,
  pub objectShape: u32, pub objectSlots: u32, pub objectFlags: u32, pub objectClass: u32, pub shapeVersion: u32,
  /// ShapeData.prototype, from the shape's cell.
  pub shapePrototype: u32,
  pub fieldCache: u32, pub entryStride: u32, pub entrySite: u32, pub entryKey: u32, pub entryEpoch: u32,
  pub entryHolder: u32, pub entryHolderIndex: u32, pub shapeEpoch: u32,
  /// The flags bit of an exotic object, Array's class id, and a prototype entry's key >> 16
  /// without the version (FIELD_PROTO_KEY >> 16).
  pub exotic: u32, pub arrayClass: u32, pub plainClass: u32, pub protoKey: u64,
  /// The flags bit of an object that is falsy and loosely equal to null (ObjectData.isHtmlDda).
  pub falsy: u32,
  /// The byte of an object's roles and the bit of a watched one (ObjectData.isWatched).
  pub objectRoles: u32, pub watched: u32,
  /// A fast Array (class Array with the fast-array flag): the flag, then the word holding
  /// its first element's address and its 32-bit element count (FastArrayData.items), the
  /// 32-bit word whose capacityMask bits are its capacity, and its plain byte
  /// (FastArrayData.plainOffset). A prototype that leaves arrays' element reads to their own
  /// elements has standardPrototype in its flags (ObjectData.isStandardArrayPrototype).
  pub fastArray: u32, pub elements: u32, pub elementCount: u32, pub elementMeta: u32, pub elementPlain: u32, pub standardPrototype: u32,
  /// A typed array (js_typed_array_read.quickRead): class ids typedFirst..=typedLast (Uint8C
  /// to Float64), the payload byte that tells a TypedArray payload (typedTag at typedTagAt),
  /// then TypedArrayCache's 64-bit element count, its shared byte and its data pointer.
  pub typedFirst: u32, pub typedLast: u32, pub typedTagAt: u32, pub typedTag: u32,
  pub typedCount: u32, pub typedShared: u32, pub typedData: u32,
  /// Adds in place (js_vm_property_ops.siteAdd as swapAdd makes it): a store's inline key
  /// whose upper half is addKey names memo entry (lower half & (memoEntries - 1)) of
  /// RuntimeState.transitions (at transitions, transitionStride apart, its fields at the
  /// offsets after, including its verified prototype-chain epoch at transitionEpoch). An
  /// object adds in place when its class is plainClass, its flags masked by addFlags are
  /// extensibleFlag and its roles lack prototypeRole; its slot count is the 32-bit word at
  /// slotCount and its capacity the bits capacityMask of the word at slotMeta. A heap cell's
  /// count is the i32 at referenceCount.
  pub addKey: u32, pub memoEntries: u32, pub transitions: u32, pub transitionStride: u32,
  pub transitionEpoch: u32, pub transitionTarget: u32, pub transitionAtom: u32, pub transitionFlags: u32,
  pub transitionDepth: u32, pub transitionVersion: u32, pub plainAdd: u32, pub maxChainDepth: u32,
  pub addFlags: u32, pub extensibleFlag: u32, pub prototypeRole: u32,
  pub slotCount: u32, pub slotMeta: u32, pub capacityMask: u32, pub referenceCount: u32
}
impl Copy for FieldLayout {}

fn typedSample(view: *mut HeapHeader) -> ObjectPayload {
  return ObjectPayload.TypedArray { array: TypedArrayCache { view: view, cachedData: Pointer.null<u8>(), count: 0, shared: false, requiresExtensible: false, lazy: false } }
}

fn byteOf(payload: &ObjectPayload, b: usize) -> u8 {
  let start = unsafe Intrinsic.pointerReinterpret<*const ObjectPayload, *const u8>(Pointer.fromRef<ObjectPayload>(payload))
  return unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(start), b))
}

/// The first byte before `body` (the TypedArray body's offset in the payload) on which two
/// TypedArray payloads agree and an Empty and a FastArray payload differ from them, as
/// offset << 8 | value; u32.MAX when there is none (then nothing is inlined). The variant
/// field comes before the body; jit_engine_tests read typed arrays through it.
fn typedTagByte(view: *mut HeapHeader, body: usize) -> u32 {
  let t0 = typedSample(view)
  let t1 = typedSample(view)
  let e0 = ObjectPayload.Empty
  let f0 = ObjectPayload.FastArray { array: FastArrayData.of(ThinList<ValueBits>.make()) }
  let mut b: usize = 0
  while b < body {
    let t = byteOf(&t0, b)
    if t == byteOf(&t1, b) && t != byteOf(&e0, b) && t != byteOf(&f0, b) { return u32.bitOr(u32.shiftLeft(usize.toU32(b), 8), u8.toU32(t)) }
    b = b + 1
  }
  return u32.MAX
}

/// FieldLayout of this engine build, from field addresses over a dummy cell: nothing is read
/// or written there.
pub fn fieldLayout() -> FieldLayout {
  let mut cell: [u64; 256] = [0; 256]
  let header = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut HeapHeader>(Pointer.fromMutRef<u64>(&mut cell[0]))
  let base = Pointer.address<HeapHeader>(header)
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, header)
  let start = Pointer.address<ObjectData>(Pointer.fromRef<ObjectData>(data)) - base
  let shape = Pointer.address<*mut HeapHeader>(Pointer.fromRef<*mut HeapHeader>(&data.shape)) - base
  let record = unsafe HeapCell.payload<ShapeData, ()>(&anchor, header)
  let version = Pointer.address<u64>(Pointer.fromRef<u64>(&record.version)) - base
  let shapePrototype = Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&record.prototype)) - base
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, header)
  let first = &state.fieldCache[0]
  let entry = Pointer.address<FieldCacheEntry>(Pointer.fromRef<FieldCacheEntry>(first))
  let next = Pointer.address<FieldCacheEntry>(Pointer.fromRef<FieldCacheEntry>(&state.fieldCache[1]))
  let sample = ObjectPayload.FastArray { array: FastArrayData.of(ThinList<ValueBits>.make()) }
  let payload = Pointer.address<ObjectPayload>(Pointer.fromRef<ObjectPayload>(&data.payload)) - base
  let mut items: usize = 0
  let mut count: usize = 0
  let mut meta: usize = 0
  let mut plain: usize = 0
  match &sample {
    ObjectPayload.FastArray { array } => {
      let list = array.values()
      let within = Pointer.address<ThinList<ValueBits>>(Pointer.fromRef<ThinList<ValueBits>>(list)) - Pointer.address<ObjectPayload>(Pointer.fromRef<ObjectPayload>(&sample))
      items = payload + within + list.dataWordOffset()
      count = payload + within + list.countWordOffset()
      meta = payload + within + list.metaWordOffset()
      plain = payload + Pointer.address<FastArrayData>(Pointer.fromRef<FastArrayData>(&array)) - Pointer.address<ObjectPayload>(Pointer.fromRef<ObjectPayload>(&sample)) + array.plainOffset()
    }
    _ => ()
  }
  let typed = typedSample(header)
  let mut typedBody: usize = 0 let mut typedCount: usize = 0 let mut typedShared: usize = 0 let mut typedData: usize = 0
  match &typed {
    ObjectPayload.TypedArray { array } => {
      let at = Pointer.address<ObjectPayload>(Pointer.fromRef<ObjectPayload>(&typed))
      typedBody = Pointer.address<TypedArrayCache>(Pointer.fromRef<TypedArrayCache>(&array)) - at
      typedCount = Pointer.address<u64>(Pointer.fromRef<u64>(&array.count)) - at
      typedShared = Pointer.address<bool>(Pointer.fromRef<bool>(&array.shared)) - at
      typedData = Pointer.address<?*mut u8>(Pointer.fromRef<?*mut u8>(&array.cachedData)) - at
    }
    _ => ()
  }
  let tagByte = typedTagByte(header, typedBody)
  let mut typedTagAt = u32.MAX let mut typedTag = u32.MAX
  if tagByte != u32.MAX { typedTagAt = usize.toU32(payload) + u32.shiftRight(tagByte, 8) typedTag = tagByte & 255 }
  let frame = unsafe Intrinsic.pointerReinterpret<*mut HeapHeader, *mut CompiledFrame>(header)
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  let scope = unsafe HeapCell.payload<ScopeData, ()>(&anchor, header)
  let memo = &state.transitions[0]
  let memoAt = Pointer.address<TransitionEntry>(Pointer.fromRef<TransitionEntry>(memo))
  let cellHeader = unsafe Pointer.borrow<(), HeapHeader>(&anchor, header)
  return FieldLayout {
    addKey: u64.wrappingToU32(u64.shiftRight(properties.FIELD_ADD_KEY, 32)), memoEntries: usize.toU32(MEMO_ENTRIES),
    transitions: usize.toU32(memoAt - base),
    transitionStride: usize.toU32(Pointer.address<TransitionEntry>(Pointer.fromRef<TransitionEntry>(&state.transitions[1])) - memoAt),
    transitionEpoch: usize.toU32(Pointer.address<u64>(Pointer.fromRef<u64>(&memo.epoch)) - memoAt),
    transitionTarget: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&memo.target)) - memoAt),
    transitionAtom: usize.toU32(Pointer.address<u32>(Pointer.fromRef<u32>(&memo.atom)) - memoAt),
    transitionFlags: usize.toU32(Pointer.address<u8>(Pointer.fromRef<u8>(&memo.flags)) - memoAt),
    transitionDepth: usize.toU32(Pointer.address<u8>(Pointer.fromRef<u8>(&memo.chainDepth)) - memoAt),
    transitionVersion: usize.toU32(Pointer.address<u64>(Pointer.fromRef<u64>(&memo.baseVersion)) - memoAt),
    plainAdd: JS_PROP_C_W_E, maxChainDepth: u8.toU32(MAX_CHAIN_DEPTH),
    addFlags: u8.toU32(ObjectData.addTestedFlags()), extensibleFlag: u8.toU32(ObjectData.extensibleFlag()), prototypeRole: u8.toU32(ObjectData.prototypeRole()),
    slotCount: usize.toU32(start + data.slotCountOffset()), slotMeta: usize.toU32(start + data.slotMetaOffset()), capacityMask: ThinList<SlotBits>.capacityMask(),
    referenceCount: usize.toU32(Pointer.address<i32>(Pointer.fromRef<i32>(&cellHeader.referenceCount)) - base),
    frameScope: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&running.scope)) - base),
    scopeParent: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&scope.parent)) - base),
    scopeSlots: usize.toU32(Pointer.address<ValueBits>(unsafe scopeSlot(header, 0)) - base),
    typedFirst: classes.JS_CLASS_UINT8C_ARRAY, typedLast: classes.JS_CLASS_FLOAT64_ARRAY, typedTagAt: typedTagAt, typedTag: typedTag,
    typedCount: usize.toU32(payload + typedCount), typedShared: usize.toU32(payload + typedShared), typedData: usize.toU32(payload + typedData),
    fastArray: u8.toU32(ObjectData.fastArrayFlag()), elements: usize.toU32(items), elementCount: usize.toU32(count),
    elementMeta: usize.toU32(meta), elementPlain: usize.toU32(plain), standardPrototype: u8.toU32(ObjectData.standardArrayPrototypeFlag()),
    objectShape: usize.toU32(shape), objectSlots: usize.toU32(start + data.slotsWordOffset()),
    objectFlags: usize.toU32(start + data.flagsOffset()), objectClass: usize.toU32(start + data.classOffset()),
    shapeVersion: usize.toU32(version), shapePrototype: usize.toU32(shapePrototype),
    fieldCache: usize.toU32(entry - base), entryStride: usize.toU32(next - entry),
    entrySite: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&first.site)) - entry),
    entryKey: usize.toU32(Pointer.address<u64>(Pointer.fromRef<u64>(&first.key)) - entry),
    entryEpoch: usize.toU32(Pointer.address<u64>(Pointer.fromRef<u64>(&first.epoch)) - entry),
    entryHolder: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&first.holder)) - entry),
    entryHolderIndex: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&first.holderIndex)) - entry),
    shapeEpoch: usize.toU32(Pointer.address<u64>(Pointer.fromRef<u64>(&state.shapeEpoch)) - base),
    exotic: u8.toU32(ObjectData.exoticFlag()), arrayClass: classes.JS_CLASS_ARRAY, plainClass: classes.JS_CLASS_OBJECT, protoKey: u64.shiftRight(FIELD_PROTO_KEY, 16),
    falsy: u8.toU32(ObjectData.htmlDdaFlag()),
    objectRoles: usize.toU32(start + data.rolesOffset()), watched: u8.toU32(ObjectData.watchedFlag()) }
}

/// `left instanceof right` when no JavaScript can run (js_vm_object_ops.quickInstanceOf, the
/// interpreter's own fast path): 1 or 0, or 2 to leave it to the full operator.
pub unsafe fn instanceOf(frame: &CompiledFrame, left: ValueBits, right: ValueBits) -> u32 {
  let answer = unsafe objectOps.quickInstanceOf(frame.runtime, left, right)
  if answer < 0 { return 2 }
  return i32.wrappingToU32(answer)
}

/// Array.prototype.push(value) on object, a fast Array with room for it (arraySupport.pushOne,
/// which retains value): true with the new length in out, false with nothing changed.
pub unsafe fn arrayPush(object: ValueBits, value: ValueBits, out: *mut ValueBits) -> bool {
  let pushed = unsafe arraySupport.pushOne(object, value)
  if pushed < 0 { return false }
  unsafe Pointer.write<ValueBits>(out, ValueBits.Int { value: i64.toI32(pushed) })
  return true
}
/// Array.prototype.pop() on object, a fast Array (nativeFunctions.quickPop): true with the
/// removed value, owned, in out; false with nothing changed.
pub unsafe fn arrayPop(object: ValueBits, out: *mut ValueBits) -> bool {
  match unsafe nativeFunctions.quickPop(object) {
    Option<ValueBits>.Some { value } => { unsafe Pointer.write<ValueBits>(out, value) return true }
    Option<ValueBits>.None => { return false }
  }
}
/// `left === right` (strict) or `left == right` without coercion, as the interpreter's
/// OP_strict_eq and OP_eq arms settle them (strictIdentity with sameText, looseIdentity), and
/// two numbers or two BigInts compared by value: 1 or 0, or 2 when only the full operator can
/// answer (a coercion that may run JavaScript, document.all).
pub unsafe fn equals(left: ValueBits, right: ValueBits, strict: bool) -> u32 {
  let mut same: i32 = 0
  if strict {
    same = operators.strictIdentity(left, right)
    if same == 2 { same = 0 if !operators.knownDistinct(left, right) && unsafe operators.sameText(left, right) { same = 1 } }
  } else { same = unsafe operators.looseIdentity(left, right) }
  if same >= 0 { return i32.wrappingToU32(same) }
  if (left.isNumber() && right.isNumber()) || (left.isBigInt() && right.isBigInt()) {
    if unsafe primitives.equal(left, right, EqualityMode.Strict) { return 1 }
    return 0
  }
  return 2
}

/// The atom typeof answers for value (js_vm_operators.typeofAtom), or 0 for a proxy, whose
/// callability the interpreter asks through its hooks.
pub unsafe fn typeofAtom(frame: &CompiledFrame, value: ValueBits) -> u32 {
  if value.isNumber() { return atoms.JS_ATOM_number }
  if value.isBigInt() { return atoms.JS_ATOM_bigint }
  if value.isString() { return atoms.JS_ATOM_string }
  match value {
    ValueBits.Undefined => { return atoms.JS_ATOM_undefined }
    ValueBits.Bool { .. } => { return atoms.JS_ATOM_boolean }
    ValueBits.Null => { return atoms.JS_ATOM_object }
    ValueBits.Symbol { .. } => { return atoms.JS_ATOM_symbol }
    ValueBits.Object { reference } => {
      let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
      let htmlDda = object.isHtmlDda() let classId = object.classId() drop object
      if htmlDda { return atoms.JS_ATOM_undefined }
      if classId == classes.JS_CLASS_BYTECODE_FUNCTION { return atoms.JS_ATOM_function }
      if classId == classes.JS_CLASS_PROXY { return 0 }
      let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, frame.runtime)
      if rt.classes.asSlice()[u32.toUsize(classId)].call.isSome() { return atoms.JS_ATOM_function }
      return atoms.JS_ATOM_object
    }
    _ => { return 0 }
  }
}
