//! What a host's GPU service answers the WebGPU half of a ui-js realm (`webgpu.js`): the
//! commands leave JavaScript as bytes, and each promise there waits for one [`GpuReply`].
import silk.collections.list { List }
import silk.concurrency.thread { Transferable }
import silk.text.string { String }

/// The answer to the command that carried `token`, or with token 0 something a device tells
/// unasked (`number` is the device then). What `status`, `number`, `text` and `bytes` mean
/// depends on the command.
pub struct GpuReply {
  pub token: u32,
  pub status: u32,
  pub number: f64,
  pub text: String,
  pub bytes: List<u8>,
}

impl Transferable for GpuReply {}

impl GpuReply {
  /// A reply with `status` and nothing else.
  pub fn of(token: u32, status: u32) -> GpuReply {
    return GpuReply { token: token, status: status, number: 0.0, text: String.make(), bytes: List<u8>.make() }
  }
}
