        let cold = run self.deferStep(inst, step, leaving.stepShape(after - 1, 1, 0, after), inst.result, done, kind)
        run self.a.jcc(Cond.Equal, cold)
      } else { run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit))) }
      self.a.bind(done)
      return ()
    }
    if op == Op.GetKey && self.on {
      run self.getKey(&function, inst)
      return ()
    }
    if op == Op.GetKey {
      run self.stressGuard(inst.exit)
      run self.frameInto(Reg.Rsi)
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.b))
      run self.a.lea(Width.W64, Reg.R8, slotOf(inst.result))
      run self.callHelper(helpers.GET_KEY)
