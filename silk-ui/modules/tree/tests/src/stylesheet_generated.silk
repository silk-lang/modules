import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, StyleState, FrameInput }
import ui_tree.css
import ui_tree.css { px }
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.element { PseudoTarget, StateBits, HOVER }
import svg_css.tokens { CssError, Limits, equal }
import svg_css.generated_content { Content, Item }
import svg_css.generated_content
import svg_css.written
import svg_css.lexer
import svg_css.input { Input }
import properties.catalog { Property }
import properties.values { Value, Declaration }
import properties.values
import properties.convert
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn value<'a>(declarations: &'a [Declaration], property: Property) -> Option<&'a Value> {
  let mut i: usize = 0
  while i < declarations.length {
    if declarations[i].property == property { return Option<&Value>.some(&declarations[i].value) }
    i = i + 1
  }
  return Option<&Value>.None
}
fn number(declarations: &[Declaration], property: Property) -> f32 {
  return match value(declarations, property) {
    Option.Some { value: found } => match &found.* {
      Value.Unit { value: amount, .. } => amount
      _ => -1.0
    }
    _ => -1.0
  }
}

effect fn exercise() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("outer") })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("origin") })
  run batch.style(2, &[css.width(px(190.0)), css.marginBottom(px(81.0))])
  run batch.customProperty(2, StyleState.Base, "--label", Option<string>.some("'inline label'"), false)
  run batch.customProperty(2, StyleState.Hover, "--unit", Option<string>.some("23px"), false)
  let source = b"@property --isolated{syntax:'<length>';inherits:false;initial-value:7px}.outer{--unit:5px;color:blue}.origin{--unit:11px;--isolated:99px;color:red;width:170px;height:40px}.origin::before{content:var(--label);width:var(--unit);height:var(--isolated);background:currentColor;animation:glow 1s}.origin::before:hover{opacity:.5}.origin:hover::before{padding:4px}.origin::after{content:'';--unit:29px;width:var(--unit);background:currentColor}@starting-style{.origin::before{width:3px}}@keyframes glow{from{width:var(--unit)}to{width:22px}}"
  let sheet = run compile.compile(source, &Options.make())
  run Testing.expect(sheet.diagnostics.length() == 1 && equal(sheet.diagnostics.asSlice()[0].feature.asSlice(), b"pseudo-element state"), "the compiler diagnoses unsupported pseudo state suffixes")
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  run Testing.expect(tree.node(tree.slotOf(2)).computed().layout.width.value == 190.0, "ordinary inline styles still win on the origin")
  let origin = tree.slotOf(2)
  let before = run tree.resolveGeneratedStyle(origin, PseudoTarget.Before, StateBits { bits: 0 }, false)
  run Testing.expect(number(before.declarations.asSlice(), Property.Width) == 11.0 && number(before.declarations.asSlice(), Property.Height) == 7.0, "pseudo variables inherit from the origin while registered non-inherited values reset")
  run Testing.expect(value(before.declarations.asSlice(), Property.MarginBottom).isNone(), "origin inline declarations do not become pseudo declarations")
  run Testing.expect(match value(before.declarations.asSlice(), Property.BackgroundColor) {
    Option.Some { value } => match convert.color(value) { Option.Some { value: color } => color.r == 1.0 && color.b == 0.0 _ => false }
    _ => false
  }, "currentColor uses the origin's computed color rather than its parent's")
  run Testing.expect(match &before.starting { Option.Some { value } => number(value.asSlice(), Property.Width) == 3.0 _ => false }, "starting rules use the generated target")
  run Testing.expect(before.keyframes.length() == 1 && number(before.keyframes.asSlice()[0].frames.asSlice()[0].declarations.asSlice(), Property.Width) == 11.0, "keyframe variables resolve in the generated scope")
  let contentValue = match value(before.declarations.asSlice(), Property.Content) { Option.Some { value } => value _ => { run Testing.expect(false, "content declaration survives")
    return () } }
  let contentText = run values.cssText(contentValue)
  let tokens = run lexer.tokenize(contentText.asSlice(), &Limits.make())
  let content = run generated_content.parse(&Input.Contiguous { buffer: &tokens, range: tokens.all() })
  run Testing.expect(match &content { Option.Some { value: Content.Items { values } } => values.length() == 1 && match &values.asSlice()[0] { Item.Text { value } => equal(value.asSlice(), b"inline label") _ => false } _ => false }, "inherited inline custom properties substitute into generated content")
  let after = run tree.resolveGeneratedStyle(origin, PseudoTarget.After, StateBits { bits: 0 }, true)
  run Testing.expect(number(after.declarations.asSlice(), Property.Width) == 29.0 && after.starting.isNone(), "after owns a separate variable scope and does not restart an existing box")
  let hovered = run tree.resolveGeneratedStyle(origin, PseudoTarget.Before, StateBits { bits: HOVER }, true)
  run Testing.expect(value(hovered.declarations.asSlice(), Property.Opacity).isNone() && value(hovered.declarations.asSlice(), Property.PaddingTop).isNone(), "unsupported pseudo state suffixes stay inactive without activating origin hover")
  let node = tree.nodeMut(origin)
  node.hovered = true
  tree.restyle(origin)
  run tree.frame(frame)
  let originHovered = run tree.resolveGeneratedStyle(origin, PseudoTarget.Before, StateBits { bits: 0 }, true)
  run Testing.expect(number(originHovered.declarations.asSlice(), Property.Width) == 23.0 && number(originHovered.declarations.asSlice(), Property.PaddingTop) == 4.0 && value(originHovered.declarations.asSlice(), Property.Opacity).isNone(), "origin hover and its inherited variable changes affect the generated target")
  let overrides = run written.declarations(b"width:999px;opacity:.3")
  drop run tree.setOverride(2, StyleState.Base, move overrides, false)
  run tree.frame(frame)
  let overridden = run tree.resolveGeneratedStyle(origin, PseudoTarget.Before, StateBits { bits: 0 }, true)
  run Testing.expect(tree.node(origin).computed().layout.width.value == 999.0 && number(overridden.declarations.asSlice(), Property.Width) == 23.0 && value(overridden.declarations.asSlice(), Property.Opacity).isNone() && overridden.overrides.length() == 0, "origin inspector overrides do not become generated declarations")
}

test effect fn generatedTargetsResolveInheritanceVariablesAndMotionWithoutInlineLeakage() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run exercise() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.node { NONE }
import ui_tree.mutation { Role }
import ui_tree.inspect
import ui_tree.legacy { CpuSnapshot }
import vector.geometry_error { GeometryError }
import ui_tree.interact
import ui_tree.access { AccessTree, accessibleName }
import ui_fixtures.fixtures as fixtures
import silk.collections.list { List }

fn pseudo(tree: &UiTree<'_>, origin: u32, before: bool) -> u32 {
  return match tree.node(origin).identity() {
    Option.Some { value } => if before { value.before } else { value.after }
    _ => NONE
  }
}
fn generatedText<'a>(tree: &'a UiTree<'_>, box: u32) -> string<'a> {
  let child = tree.slotOfCssNode(tree.layout.firstChild(tree.node(box).css))
  return String.view(&tree.node(child).text)
}

effect fn lifecycle() -> ()
  ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(4294967294, NodeKind.Box)
  run batch.append(1, 4294967294)
  run batch.attribute(4294967294, Attribute.ClassName { value: run String.copy("origin") })
  run batch.attribute(4294967294, Attribute.Role { value: Role.Button })
  run batch.create(3, NodeKind.Box)
  run batch.append(4294967294, 3)
  run batch.create(4, NodeKind.Box)
  run batch.append(1, 4)
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("empty") })
  let sheet = run compile.compile(b".origin{display:block;width:200px}.origin::before{content:'pre';display:block;width:80px;height:20px;background:red}.origin::after{content:attr(data-label,'fallback');display:block;height:20px}.origin>:first-child{width:31px;height:10px}.origin>:nth-child(2){width:37px;height:10px}.empty:empty{width:47px}.empty::before{content:''}.off::before,.off::after{content:none}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let origin = tree.slotOf(4294967294)
  let before = pseudo(&tree, origin, true)
  let after = pseudo(&tree, origin, false)
  run Testing.expect(before != NONE && after != NONE && tree.nodeCount() == 4, "generated boxes do not consume client ids")
  run Testing.expect(generatedText(&tree, before) == "pre" && generatedText(&tree, after) == "fallback", "strings and missing attribute fallbacks render")
  run Testing.expect(tree.node(tree.slotOf(3)).computed().layout.width.value == 31.0 && tree.node(tree.slotOf(4)).computed().layout.width.value == 47.0, "generated children do not affect first-child or empty selectors")
  let empty = pseudo(&tree, tree.slotOf(4), true)
  run Testing.expect(empty != NONE && generatedText(&tree, empty) == "", "an empty string generates a box")
  let mut children = List<u32>.make()
  run inspect.childrenOf(&tree, 4294967294, &mut children)
  run Testing.expect(children.length() == 1 && children.get(0) == 3, "public child inspection hides generated boxes")
  run tree.childSlots(origin, &mut children)
  run Testing.expect(children.length() == 3 && children.get(0) == before && children.get(2) == after, "layout sees before, application children, then after")
  if let Option.Some { value: info } = run inspect.infoSlot(&tree, before) {
    run Testing.expect(info.laidOut && info.bounds.width() == 80.0 && info.bounds.height() == 20.0, "generated styles produce real layout fragments")
    run Testing.expect(interact.hitSlot(&tree, info.bounds.xMin + 40.0, info.bounds.yMin + 10.0) == origin, "generated content pointer hits retarget to its origin")
  }
  let mut snapshot = CpuSnapshot.make()
  run snapshot.copyUploads(&tree)
  let pixels = run snapshot.render(&tree)
  let red: usize = (10 * 400 + 50) * 4
  run Testing.expect(pixels.data()[red] == 255 && pixels.data()[red + 1] == 0 && pixels.data()[red + 2] == 0 && pixels.data()[red + 3] == 255, "the generated box reaches the rendered scene")
  run tree.pathTo(before, &mut children)
  run Testing.expect(children.length() == 2 && children.get(0) == 1 && children.get(1) == 4294967294, "event paths contain the origin exactly once")
  let mut name = String.make()
  run accessibleName(&tree, origin, &mut name)
  run Testing.expect(String.view(&name) == "pre fallback", "generated text contributes to a button's accessible name")
  run batch.attribute(4294967294, Attribute.Role { value: Role.None })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  let mut access = AccessTree.make()
  let update = run access.fullUpdate(&tree)
  run Testing.expect(update.nodes.length() >= 6, "generated text and shaped runs are exposed when not folded into a control name")
  let mut a: usize = 0
  while a < update.nodes.length() {
    let mut b = a + 1
    while b < update.nodes.length() {
      run Testing.expect(update.nodes.asSlice()[a].id.value != update.nodes.asSlice()[b].id.value, "generated accessibility ids remain unique even for high public ids")
      b = b + 1
    }
    a = a + 1
  }
  run batch.create(5, NodeKind.Box)
  run batch.append(4294967294, 5)
  run batch.attribute(4294967294, Attribute.Named { name: run String.copy("data-label"), value: Option<String>.some(String.make()) })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run tree.childSlots(origin, &mut children)
  run Testing.expect(children.length() == 4 && children.get(2) == tree.slotOf(5) && children.get(3) == after, "appending application children preserves after as the last layout child")
  run Testing.expect(generatedText(&tree, after) == "" && tree.node(tree.slotOf(5)).computed().layout.width.value == 37.0, "present empty attributes suppress fallback and nth-child counts only application elements")
  let allocated = tree.nodes.length()
  let mut cycle: usize = 0
  while cycle < 20 {
    run batch.attribute(4294967294, Attribute.ClassName { value: run String.copy("origin off") })
    run tree.apply(run batch.take())
    run tree.frame(frame)
    run Testing.expect(pseudo(&tree, origin, true) == NONE && pseudo(&tree, origin, false) == NONE && tree.slotOf(4294967294) == origin, "removing generated content preserves its public origin")
    run batch.attribute(4294967294, Attribute.ClassName { value: run String.copy("origin") })
    run tree.apply(run batch.take())
    run tree.frame(frame)
    cycle = cycle + 1
  }
  run Testing.expect(tree.nodes.length() == allocated && tree.nodeCount() == 5, "repeated content changes reuse private slots")
  run batch.removeStyleSheet(0, 1)
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(pseudo(&tree, origin, true) == NONE && pseudo(&tree, tree.slotOf(4), true) == NONE && tree.nodeCount() == 5, "removing the stylesheet destroys all generated boxes")
}

test effect fn generatedContentParticipatesInLayoutButNotPublicStructure() -> ()
  ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run lifecycle() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.input { Input as TreeInput }
import ui_tree.access { doAction, ActionOutcome, runId }
import accesskit.lib { Action, ActionRequest, TreeId }

effect fn inheritedContent() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("parent") })
  run batch.attribute(1, Attribute.Named { name: run String.copy("data-label"), value: Option<String>.some(run String.copy("ancestor")) })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("inherited") })
  run batch.attribute(2, Attribute.Named { name: run String.copy("data-label"), value: Option<String>.some(run String.copy("origin")) })
  run batch.create(3, NodeKind.Input)
  run batch.append(1, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("inherited") })
  run batch.create(4, NodeKind.Canvas)
  run batch.append(1, 4)
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("inherited") })
  let sheet = run compile.compile(b".parent{content:attr(data-label);width:300px}.inherited{content:inherit}.inherited::before{content:inherit;display:block;width:90px;height:20px;overflow:auto;white-space:nowrap}.inherited::after{content:'caf\\e9 ';display:block;height:20px}.hidden{display:none}.inherited:active::after{content:'active'}.direct::before{content:attr(DATA-LABEL)}.broken::after{content:var(--missing)}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let origin = tree.slotOf(2)
  let after = pseudo(&tree, origin, false)
  run Testing.expect(pseudo(&tree, origin, true) == NONE, "content inherit receives the ordinary origin's computed normal value")
  run Testing.expect(generatedText(&tree, after) == "café", "generated text preserves CSS escapes and UTF-8")
  run Testing.expect(pseudo(&tree, tree.slotOf(3), true) == NONE && pseudo(&tree, tree.slotOf(4), true) == NONE, "replaced controls do not generate before or after boxes")
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("inherited direct") })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  let before = pseudo(&tree, origin, true)
  run Testing.expect(generatedText(&tree, before) == "origin", "attr reads the originating element and matches HTML attribute names without case")
  let action = ActionRequest { action: Action.Click, targetTree: TreeId.root(), targetNode: runId(2, 2), data: Option.None }
  run Testing.expect((run doAction(&mut tree, &action)) == ActionOutcome.Done, "accessibility actions on generated text retarget to its origin")
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("inherited direct hidden") })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(!tree.node(before).rendered && !tree.node(after).rendered, "origin display none hides both generated boxes")
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("inherited direct broken") })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(tree.node(before).rendered && generatedText(&tree, before) == "origin" && pseudo(&tree, origin, false) == NONE, "reentry updates attr content and invalid variable content generates no box")
  run batch.attribute(2, Attribute.Named { name: run String.copy("data-label"), value: Option<String>.some(run String.copy("a long generated line that scrolls independently")) })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  if let Option.Some { value: info } = run inspect.infoSlot(&tree, before) {
    run tree.dispatch(TreeInput.Wheel { x: info.bounds.xMin + 20.0, y: info.bounds.yMin + 10.0, deltaX: 40.0, deltaY: 0.0, modifiers: 0 })
    run tree.frame(frame)
    run Testing.expect(tree.node(before).scrollX() > 0.0 && tree.node(origin).scrollX() == 0.0, "wheel scrolling operates on the generated layout box while event targets stay public")
  }
  let replacement = run compile.compile(b".inherited::before{content:'replacement';display:block;height:20px}@media(width < 100px){.inherited::before{content:none}}", &Options.make())
  let replacementBytes = run replacement.encode()
  run batch.replaceStyleSheet(0, 1, replacementBytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(generatedText(&tree, pseudo(&tree, origin, true)) == "replacement", "replacing a stylesheet updates generated text")
  run tree.frame(FrameInput { width: 80.0, height: 300.0, scale: 1.0, time: 0.0 })
  run Testing.expect(pseudo(&tree, origin, true) == NONE, "media conditions remove generated boxes")
}

test effect fn generatedContentInheritanceVisibilityAccessibilityAndScrolling() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inheritedContent() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.node { Event, EventKind }
import ui_tree.mutation { LISTEN_ANIMATION_START, LISTEN_ANIMATION_CANCEL, LISTEN_TRANSITION_RUN, LISTEN_TRANSITION_CANCEL }

effect fn generatedMotion() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("origin") })
  run batch.listen(1, LISTEN_ANIMATION_START | LISTEN_ANIMATION_CANCEL | LISTEN_TRANSITION_RUN | LISTEN_TRANSITION_CANCEL)
  let sheet = run compile.compile(b".origin::before{content:'';display:block;width:10px;height:20px;transition:width 1s linear;animation:fade 2s linear}@starting-style{.origin::before{width:0}}.off::before{content:none}@keyframes fade{from{opacity:0}to{opacity:1}}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let mut frame = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let origin = tree.slotOf(1)
  let before = pseudo(&tree, origin, true)
  run Testing.expect(tree.node(before).computed().layout.width.value == 0.0, "a newly generated box uses its starting style")
  frame.time = 0.5
  run tree.frame(frame)
  run Testing.expect(tree.node(before).computed().layout.width.value == 5.0 && tree.node(before).computed().paint.opacity == 0.25, "generated boxes run independent transitions and keyframes")
  let mut events = List<Event>.make()
  run tree.takeEvents(&mut events)
  let mut started = false
  let mut i: usize = 0
  while i < events.length() {
    let event = &events.asSlice()[i]
    if event.kind == EventKind.AnimationStart {
      started = event.target == 1 && String.view(&event.pseudoElement) == "::before" && event.path.length() == 1 && event.path.get(0) == 1
    }
    i = i + 1
  }
  run Testing.expect(started, "generated animation events identify the pseudo and use the public event path")
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("origin off") })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run tree.takeEvents(&mut events)
  let mut animationCancelled = false
  let mut transitionCancelled = false
  i = 0
  while i < events.length() {
    let event = &events.asSlice()[i]
    if event.kind == EventKind.AnimationCancel { animationCancelled = event.target == 1 && String.view(&event.pseudoElement) == "::before" && event.path.length() == 1 }
    if event.kind == EventKind.TransitionCancel { transitionCancelled = event.target == 1 && String.view(&event.pseudoElement) == "::before" && event.path.length() == 1 }
    i = i + 1
  }
  run Testing.expect(animationCancelled && transitionCancelled, "removing a pseudo cancels its motion before detaching its event path")
  run Testing.expect(tree.transitions.length() == 0, "removed private slots retain no transitions")
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("origin") })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  let recreated = pseudo(&tree, origin, true)
  run Testing.expect(tree.node(recreated).computed().layout.width.value == 0.0 && tree.node(recreated).computed().paint.opacity == 0.0, "reused private slots start fresh animation and transition clocks")
}

test effect fn generatedMotionStartsCancelsAndRecreatesWithoutStaleSlots() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run generatedMotion() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.legacy { VirtualItem, VirtualOptions }
import ui_tree.cssom_view as view
import svg_css.cssom_error { CssomError }
import svg_css.cssom_geometry { DOMRect }

effect fn generatedPublicBoundaries() -> ()
  ! TreeError | CompileError | CssError | CssomError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  let sheet = run compile.compile(b":root{width:200px}:root::before,:root::after{content:'';display:block;width:80px;height:20px}:root>div{width:31px;height:10px}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let mut rects = List<DOMRect>.make()
  run view.rangeClientRects(&tree, view.Range {
    start: view.BoundaryPoint { node: 1, offset: 0 }, end: view.BoundaryPoint { node: 1, offset: 1 }
  }, &mut rects)
  run Testing.expect(rects.length() == 1 && rects.get(0).width == 31.0 && rects.get(0).height == 10.0, "range child offsets exclude generated boxes")
  run batch.virtualList(1, 1, VirtualOptions { estimatedHeight: 10.0, overscan: 0.0, gap: 0.0, revision: 0 })
  run batch.virtualItems(1, &[VirtualItem { index: 0, id: 2 }])
  run tree.apply(run batch.take())
  run tree.frame(frame)
  let origin = tree.slotOf(1)
  let before = pseudo(&tree, origin, true)
  let after = pseudo(&tree, origin, false)
  let css = tree.node(origin).css
  run Testing.expect(tree.layout.firstChild(css) == tree.node(before).css && tree.layout.lastChild(css) == tree.node(after).css, "virtual list spacers stay inside the generated before and after boxes")
}

test effect fn generatedBoxesStayOutOfRangesAndVirtualBindings() -> ()
  ! TreeError | CompileError | CssError | CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run generatedPublicBoundaries() |> Effect.provideMut<Allocator>(&mut allocator)
}

import silk.collections.bytes { Bytes }

effect fn classed(batch: &mut Batch, id: u32, parent: u32, classes: string) -> () ! OutOfMemoryError ? &mut Allocator {
  run batch.create(id, NodeKind.Box)
  if parent == 0 { run batch.root(id) } else { run batch.append(parent, id) }
  run batch.attribute(id, Attribute.ClassName { value: run String.copy(classes) })
}

fn boxWidth(tree: &UiTree<'_>, slot: u32) -> f32 { return tree.node(slot).computed().layout.width.value }

effect fn variable(tree: &UiTree<'_>, id: u32, expected: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make()
  let found = run tree.customProperty(tree.slotOf(id), b"--w", &mut out)
  return found && equal(out.asSlice(), expected)
}

/// A scroller (2) whose variable changes holds plain boxes (3, 5, 7), boxes that read the
/// variable (4, and the `::before` of 6) and a box that declares its own (8, read by 9).
effect fn movedScopes() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run classed(&mut batch, 1, 0, "top")
  run classed(&mut batch, 2, 1, "plain")
  run classed(&mut batch, 3, 2, "plain")
  run classed(&mut batch, 4, 3, "reader")
  run classed(&mut batch, 5, 3, "plain")
  run classed(&mut batch, 6, 5, "mark")
  run classed(&mut batch, 7, 5, "plain")
  run classed(&mut batch, 8, 2, "setter")
  run classed(&mut batch, 9, 8, "reader")
  run classed(&mut batch, 12, 3, "other")
  let mut row: u32 = 20
  while row < 50 {
    run classed(&mut batch, row, 3, "plain")
    run classed(&mut batch, row + 1, row, "mark")
    run classed(&mut batch, row + 2, row, "reader")
    row = row + 10
  }
  let sheet = run compile.compile(b".top{display:block;width:400px}.plain{display:block;height:5px}.reader{display:block;width:var(--w,10px);height:2px}.mark{display:block}.mark::before{content:'';display:block;width:var(--w,10px);height:2px}.setter{display:block;--w:50px}.top{--unit:7px}.other{display:block;width:var(--unit);height:2px;--own:1px}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let mark = pseudo(&tree, tree.slotOf(6), true)
  run Testing.expect(mark != NONE && boxWidth(&tree, tree.slotOf(4)) == 10.0 && boxWidth(&tree, mark) == 10.0 && boxWidth(&tree, tree.slotOf(9)) == 50.0, "fallbacks and a nearer declaration apply")
  let resolves = tree.work.resolves
  run batch.customProperty(2, StyleState.Base, "--w", Option<string>.some("33px"), false)
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(boxWidth(&tree, tree.slotOf(4)) == 33.0 && boxWidth(&tree, pseudo(&tree, tree.slotOf(6), true)) == 33.0 && boxWidth(&tree, tree.slotOf(9)) == 50.0,
    "boxes that read the variable take its new value, under boxes that kept their style")
  run Testing.expect(tree.work.scopeMoves >= 6 && tree.work.resolves - resolves <= 16, "boxes that read no variable are not resolved again")
  run Testing.expect(boxWidth(&tree, tree.slotOf(22)) == 33.0 && boxWidth(&tree, tree.slotOf(42)) == 33.0 && boxWidth(&tree, pseudo(&tree, tree.slotOf(21), true)) == 33.0
    && boxWidth(&tree, pseudo(&tree, tree.slotOf(41), true)) == 33.0, "equal rows that kept their style hand the value to what reads it")
  let shared = tree.node(tree.slotOf(20)).styleClass
  run Testing.expect(shared != 0 && shared == tree.node(tree.slotOf(40)).styleClass && shared != tree.node(tree.slotOf(8)).styleClass
    && tree.node(tree.slotOf(22)).styleClass == tree.node(tree.slotOf(42)).styleClass, "equal rows share one style after the move as before")
  run Testing.expect(run variable(&tree, 7, b"33px"), "a box that kept its style holds the new variable")
  run batch.customProperty(2, StyleState.Base, "--w", Option<string>.some("34px"), false)
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(boxWidth(&tree, tree.slotOf(4)) == 34.0 && boxWidth(&tree, pseudo(&tree, tree.slotOf(6), true)) == 34.0 && run variable(&tree, 7, b"34px"), "a box moves again with the next value")
  run Testing.expect(boxWidth(&tree, tree.slotOf(12)) == 7.0 && tree.node(tree.slotOf(12)).movedScope != NONE && run variable(&tree, 12, b"34px"),
    "a box that reads and declares other variables keeps its style too, under the new scope")
  run classed(&mut batch, 11, 7, "reader")
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(boxWidth(&tree, tree.slotOf(11)) == 34.0, "a box added under one that moved reads the scope it moved to")
  run batch.attribute(5, Attribute.ClassName { value: run String.copy("plain setter") })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(boxWidth(&tree, tree.slotOf(11)) == 50.0 && boxWidth(&tree, pseudo(&tree, tree.slotOf(6), true)) == 50.0 && boxWidth(&tree, tree.slotOf(4)) == 34.0 && run variable(&tree, 7, b"50px"),
    "a box that moved and then declares the variable hands its own down")
  run batch.customProperty(2, StyleState.Base, "--w", Option<string<'static>>.None, false)
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(boxWidth(&tree, tree.slotOf(4)) == 10.0 && boxWidth(&tree, tree.slotOf(11)) == 50.0 && boxWidth(&tree, tree.slotOf(9)) == 50.0, "removing the variable brings the fallback back")
}

test effect fn aVariableChangeResolvesOnlyTheBoxesThatReadIt() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run movedScopes() |> Effect.provideMut<Allocator>(&mut allocator)
}
