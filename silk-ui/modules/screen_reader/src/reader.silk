//! The screen reader: it keeps the tree an AccessKit adapter keeps, built from the same
//! [`TreeUpdate`]s, and answers keys and [`Command`]s with speech and actions.
//!
//! ```silk
//! let mut reader = Reader.make(Flavor.Nvda)
//! run reader.update(move update)                         // each TreeUpdate, the first full
//! if run reader.key("h", "KeyH", 0, true) { ... }        // taken: the app must not see it
//! run reader.takeSpeech(&mut said)                       // what to say, and whether it interrupts
//! run reader.takeRequests(&mut actions)                  // Focus, Click, ScrollIntoView
//! ```
//!
//! The virtual cursor is an item of the [`Document`] and a byte offset in its text. Moving it
//! never moves the application's focus; activating does (Enter, Space, VO+Space). When focus
//! moves, the cursor follows and the reader says where focus went, entering focus mode in text
//! fields and composite widgets (unless the user chose a mode with the mode key).
import command { Command, Kind, listKind, listIndex, LIST_KINDS }
import document { Document, Info, appendWord, isControl, isLandmark }
import flavor {
  Flavor,
  flavorName,
  Key,
  keyOf,
  browses,
  commandOf,
  element,
  fieldEnter,
  fieldEnd,
  fieldExit,
  part,
  states,
  characterName,
  kindMatches,
  kindWord,
  nothingFound,
  modeWord,
  edgeWord,
  isEdit,
  appendNumber,
  roleWord,
  contentField,
  MOD_CONTROL,
  MOD_ALT,
  MOD_SHIFT,
  MOD_META
}
import accesskit.lib { TreeUpdate, ActionRequest, ActionData, Action, Role, Rect, Live, Toggled }
import accesskit_consumer.lib { Tree, ChangeHandler, NodeRef, FullNodeId, LocatedNode }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.usize
import silk.text.string { String }

/// One thing to say. `interrupt` stops what is being said first; an empty `interrupt` only
/// stops speech.
pub struct Utterance {
  pub text: String,
  pub interrupt: bool,
}

/// The elements list (NVDA+F7) or rotor (VO+U), while it is open.
pub struct ElementsList {
  /// Which kind it lists: an index for [`listKind`].
  pub kindIndex: usize,
  /// The infos listed, in tree order, after the filter.
  pub entries: List<usize>,
  /// Their labels.
  pub labels: List<String>,
  pub selected: usize,
  /// What the user typed to narrow the list.
  pub filter: String,
}

/// A screen reader. See the module documentation.
pub struct Reader {
  playing: Flavor,
  tree: Option<Tree>,
  doc: Document,
  cursor: usize,
  offset: usize,
  inFocusMode: bool,
  /// The user chose the mode with the mode key: focus changes leave it alone.
  chosen: bool,
  /// Insert or Caps Lock is held.
  readerHeld: bool,
  /// Control went down with nothing else: its release stops speech.
  controlAlone: bool,
  sayingAll: bool,
  speech: List<Utterance>,
  requests: List<ActionRequest>,
  list: Option<ElementsList>,
  focus: Option<FullNodeId>,
  /// The last key was taken, so the text it types is too.
  swallowText: bool,
  /// Everything said, oldest first, for transcripts.
  said: List<String>,
}

impl Reader {
  pub fn make(flavor: Flavor) -> Reader {
    return Reader {
      playing: flavor,
      tree: Option<Tree>.None,
      doc: Document.empty(),
      cursor: 0,
      offset: 0,
      inFocusMode: false,
      chosen: false,
      readerHeld: false,
      controlAlone: false,
      sayingAll: false,
      speech: List<Utterance>.make(),
      requests: List<ActionRequest>.make(),
      list: Option<ElementsList>.None,
      focus: Option<FullNodeId>.None,
      swallowText: false,
      said: List<String>.make(),
    }
  }

  pub fn flavor(self: &Self) -> Flavor {
    return self.playing
  }

  /// Plays another screen reader from now on. Browse mode starts over.
  pub effect fn setFlavor(self: &mut Self, flavor: Flavor) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.playing = flavor
    self.chosen = false
    self.inFocusMode = false
    self.list = Option<ElementsList>.None
    let mut spoken = String.make()
    run spoken.append(flavorName(flavor))
    run self.say(spoken.view(), true)
  }

  pub fn document(self: &Self) -> &Document {
    return &self.doc
  }

  /// Whether keys go to the application (focus mode, or VoiceOver).
  pub fn focusMode(self: &Self) -> bool {
    return self.inFocusMode
  }

  pub fn elementsList(self: &Self) -> Option<&ElementsList> {
    return match &self.list {
      Option.Some { value } => Option.Some { value: &value }
      Option.None => Option.None
    }
  }

  /// The item under the virtual cursor, if the document has any.
  pub fn cursorItem(self: &Self) -> Option<usize> {
    if self.cursor < self.doc.items.length() {
      return Option.Some { value: self.cursor }
    }
    return Option.None
  }

  /// What the focus ring goes around: the element under the cursor (for text, its line
  /// fragment), in the tree's coordinates.
  pub fn cursorBounds(self: &Self) -> Option<Rect> {
    if self.cursor >= self.doc.items.length() {
      return Option.None
    }
    let item = self.doc.item(self.cursor)
    if item.isText() {
      return item.bounds
    }
    return self.doc.boundsOf(item.info)
  }

  /// Everything said, oldest first.
  pub fn history(self: &Self) -> &[String] {
    return self.said.asSlice()
  }

  /// Whether something waits to be said.
  pub fn hasSpeech(self: &Self) -> bool {
    return self.speech.length() != 0
  }

  pub effect fn takeSpeech(self: &mut Self, out: &mut List<Utterance>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while self.speech.length() > 0 {
      run out.append(self.speech.remove(0))
    }
  }

  pub effect fn takeRequests(self: &mut Self, out: &mut List<ActionRequest>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while self.requests.length() > 0 {
      run out.append(self.requests.remove(0))
    }
  }

  /// Applies `update`, as an adapter would, and says what the user should hear about it:
  /// focus moves, state changes of the focused element, live regions.
  pub effect fn update(self: &mut Self, update: TreeUpdate) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut heard = Heard.make(self.playing)
    match move Intrinsic.replace(self.tree, Option<Tree>.None) {
      Option.Some { value } => {
        let mut tree = move value
        run tree.update(move update, &mut heard)
        self.tree = Option.Some { value: move tree }
      }
      Option.None => {
        self.tree = Option.Some { value: run Tree.make(move update, true) }
      }
    }
    let keep = self.cursorId()
    let mut focus = Option<FullNodeId>.None
    match &self.tree {
      Option.Some { value } => {
        let state = value.state()
        self.doc = run Document.of(state)
        focus = state.focusId()
      }
      Option.None => {
        return ()
      }
    }
    run self.restore(keep)
    let mut listed = Option<usize>.None
    if let Option<ElementsList>.Some { value } = &self.list {
      listed = Option.Some { value: value.kindIndex }
    }
    if let Option<usize>.Some { value: kind } = listed {
      run self.fillList(kind)
    }
    let moved = match focus {
      Option.Some { value } => match self.focus {
        Option.Some { value: before } => !before.equals(value)
        Option.None => true
      }
      Option.None => false
    }
    if moved {
      let before = self.focus
      self.focus = focus
      run self.focusMoved(before)
    } else if String.byteLength(heard.focused.view()) != 0 {
      let mut spoken = String.make()
      run spoken.append(heard.focused.view())
      run self.say(spoken.view(), true)
    }
    let mut i: usize = 0
    while i < heard.live.length() {
      let live = heard.live.get(i)
      run self.liveChanged(live.id, live.assertive)
      i = i + 1
    }
  }

  pub fn cursorId(self: &Self) -> Option<FullNodeId> {
    if self.cursor < self.doc.items.length() {
      let item = self.doc.item(self.cursor)
      return Option.Some { value: self.doc.info(item.info).id }
    }
    return Option.None
  }

  /// Puts the cursor back on node `id` after the document was rebuilt, or keeps it in range.
  effect fn restore(self: &mut Self, id: Option<FullNodeId>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.doc.items.length()
    if let Option<FullNodeId>.Some { value } = id {
      if let Option<usize>.Some { value: info } = self.doc.find(value) {
        if let Option<usize>.Some { value: item } = self.doc.firstItemOf(info) {
          if item != self.cursor || self.offset > self.textLength(item) {
            self.offset = 0
          }
          // Text split into runs keeps the run the cursor was in, when it still exists.
          if self.cursor >= item && self.cursor < count && self.doc.item(self.cursor).info == info {
            return ()
          }
          self.cursor = item
          return ()
        }
      }
    }
    if self.cursor >= count {
      self.cursor = if count == 0 { 0 } else { count - 1 }
      self.offset = 0
    }
  }

  fn textLength(self: &Self, item: usize) -> usize {
    return String.byteLength(self.doc.item(item).text.view())
  }

  // -------------------------------------------------------------------------------------------
  // Keys

  /// A key went down (`down`) or up. `key` and `code` are the DOM `KeyboardEvent` values,
  /// `modifiers` the `MOD_` bits. Returns whether the reader took it: the application must not
  /// see it, nor the text it types ([`takesText`]).
  pub effect fn key(self: &mut Self, key: string, code: string, modifiers: u32, down: bool) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let named = keyOf(code)
    if code == "Insert" || code == "CapsLock" {
      self.readerHeld = down
      return true
    }
    if code == "ControlLeft" || code == "ControlRight" {
      if down {
        self.controlAlone = (modifiers & (MOD_SHIFT | MOD_ALT | MOD_META)) == 0
        return false
      }
      if self.controlAlone {
        self.controlAlone = false
        run self.perform(Command.StopSpeech)
      }
      return false
    }
    self.controlAlone = false
    if !down {
      let taken = self.swallowText
      return taken && !isModifier(code)
    }
    if isModifier(code) {
      return false
    }
    self.swallowText = false
    if self.list.isSome() {
      self.swallowText = true
      run self.listKey(key, named, modifiers)
      return true
    }
    let control = (modifiers & MOD_CONTROL) != 0
    let alt = (modifiers & MOD_ALT) != 0
    // Control+Alt (Control+Option) is the reader key on keyboards without Insert, and VO.
    let chord = control && alt && !isArrow(named)
    let reader = self.readerHeld || chord
      || (self.playing == Flavor.VoiceOver && control && alt)
    let mods = if chord || (self.playing == Flavor.VoiceOver && control && alt) {
      modifiers & (MOD_SHIFT | MOD_META)
    } else {
      modifiers
    }
    let browse = browses(self.playing) && !self.inFocusMode
    if self.inFocusMode && named == Key.Escape && browses(self.playing) && !reader && self.escapeLeaves() {
      self.swallowText = true
      run self.perform(Command.BrowseMode)
      return true
    }
    let command = commandOf(self.playing, code, mods, reader, browse)
    match command {
      Option.Some { value } => {
        if self.sayingAll {
          self.sayingAll = false
        }
        self.swallowText = true
        run self.perform(value)
        return true
      }
      Option.None => {}
    }
    if self.sayingAll {
      self.sayingAll = false
      run self.stop()
    }
    // Browse mode keeps letters from the application, as the buffer would.
    if browse && !reader && !control && !alt && (modifiers & MOD_META) == 0 && isLetterOrDigit(code) {
      self.swallowText = true
      return true
    }
    return false
  }

  /// Whether the text that the last key typed is the reader's too.
  pub fn takesText(self: &Self) -> bool {
    return self.swallowText
  }

  /// Whether Escape in focus mode returns to browse mode: not in a dialog, menu or combo box,
  /// whose Escape the application needs.
  fn escapeLeaves(self: &Self) -> bool {
    let state = match &self.tree {
      Option.Some { value } => value.state()
      Option.None => {
        return true
      }
    }
    let mut node = state.focusNode()
    while let Option<NodeRef<'_>>.Some { value } = node {
      let kind = value.accessRole()
      if kind == Role.Dialog || kind == Role.AlertDialog || kind == Role.Menu || kind == Role.ComboBox
        || kind == Role.ListBox || kind == Role.MenuBar {
        return false
      }
      node = value.parent()
    }
    return true
  }

  // -------------------------------------------------------------------------------------------
  // Commands

  /// Does what `command` asks. Panels call this directly.
  pub effect fn perform(self: &mut Self, command: Command) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !matchesSayAll(command) {
      self.sayingAll = false
    }
    let count = self.doc.items.length()
    match command {
      Command.StopSpeech => {
        self.sayingAll = false
        run self.stop()
        return ()
      }
      Command.ToggleMode => {
        if !browses(self.playing) {
          return ()
        }
        self.inFocusMode = !self.inFocusMode
        self.chosen = true
        let mut spoken = String.make()
        run spoken.append(modeWord(self.playing, self.inFocusMode))
        run self.say(spoken.view(), true)
        return ()
      }
      Command.BrowseMode => {
        if !browses(self.playing) || !self.inFocusMode {
          return ()
        }
        self.inFocusMode = false
        self.chosen = false
        let mut spoken = String.make()
        run spoken.append(modeWord(self.playing, false))
        run self.say(spoken.view(), true)
        return ()
      }
      Command.Title => {
        let mut text = String.make()
        run text.append(self.doc.title.view())
        if String.byteLength(text.view()) == 0 {
          run text.append("untitled")
        }
        run self.say(text.view(), true)
        return ()
      }
      Command.CurrentFocus => {
        let mut text = String.make()
        run self.focusPhrase(&mut text)
        run self.say(text.view(), true)
        return ()
      }
      Command.ElementsList { kind } => {
        run self.openList(listIndex(kind))
        return ()
      }
      Command.Quit => {
        let mut spoken = String.make()
        run spoken.append("screen reader off")
        run self.say(spoken.view(), true)
        return ()
      }
      _ => {}
    }
    if count == 0 {
      let mut spoken = String.make()
      run spoken.append("blank")
      run self.say(spoken.view(), true)
      return ()
    }
    match command {
      Command.NextLine => run self.moveLine(true)
      Command.PreviousLine => run self.moveLine(false)
      Command.NextItem => run self.moveItem(true)
      Command.PreviousItem => run self.moveItem(false)
      Command.NextCharacter => run self.moveCharacter(true)
      Command.PreviousCharacter => run self.moveCharacter(false)
      Command.NextWord => run self.moveWord(true)
      Command.PreviousWord => run self.moveWord(false)
      Command.LineStart => {
        self.cursor = self.doc.lineStart(self.lineOf(self.cursor))
        self.offset = 0
        run self.sayCharacter()
      }
      Command.LineEnd => {
        let end = self.doc.lineEnd(self.lineOf(self.cursor))
        self.cursor = end - 1
        self.offset = self.lastCharacter(self.cursor)
        run self.sayCharacter()
      }
      Command.Top => {
        let before = self.cursor
        self.cursor = 0
        self.offset = 0
        run self.sayLine(Option.Some { value: before }, true)
      }
      Command.Bottom => {
        let before = self.cursor
        let last = self.doc.lines.length() - 1
        self.cursor = self.doc.lineStart(last)
        self.offset = 0
        run self.sayLine(Option.Some { value: before }, true)
      }
      Command.CurrentLine => {
        let line = self.lineOf(self.cursor)
        let start = self.doc.lineStart(line)
        let mut text = String.make()
        run self.speakRange(Option<usize>.None, start, self.doc.lineEnd(line), &mut text)
        run self.say(text.view(), true)
      }
      Command.SayAll => {
        self.sayingAll = true
        let before = self.cursor
        self.cursor = self.doc.lineStart(self.lineOf(self.cursor))
        self.offset = 0
        run self.sayLine(Option.Some { value: before }, true)
      }
      Command.Jump { kind, forward } => run self.jump(kind, forward)
      Command.Activate => run self.activate()
      Command.TableMove { rows, columns } => run self.tableMove(rows, columns)
      _ => {}
    }
  }

  /// The last utterance finished: say all goes on with the next line.
  pub effect fn spoken(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.sayingAll {
      return ()
    }
    let line = self.lineOf(self.cursor)
    if line + 1 >= self.doc.lines.length() {
      self.sayingAll = false
      return ()
    }
    let before = self.cursor
    self.cursor = self.doc.lineStart(line + 1)
    self.offset = 0
    run self.sayLine(Option.Some { value: before }, false)
  }

  /// Whether say all is reading.
  pub fn isSayingAll(self: &Self) -> bool {
    return self.sayingAll
  }

  effect fn stop(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.speech.append(Utterance { text: String.make(), interrupt: true })
  }

  effect fn say(self: &mut Self, text: string, interrupt: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let trimmed = String.trim(text)
    if String.byteLength(trimmed) == 0 {
      return ()
    }
    let mut copy = String.make()
    run copy.append(trimmed)
    let mut kept = String.make()
    run kept.append(trimmed)
    run self.said.append(move kept)
    if self.said.length() > 200 {
      drop self.said.remove(0)
    }
    run self.speech.append(Utterance { text: move copy, interrupt: interrupt })
  }

  fn lineOf(self: &Self, item: usize) -> usize {
    return self.doc.item(item).line
  }

  // -------------------------------------------------------------------------------------------
  // Moving

  effect fn moveLine(self: &mut Self, forward: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let line = self.lineOf(self.cursor)
    let lines = self.doc.lines.length()
    if forward && line + 1 >= lines || !forward && line == 0 {
      // Readers repeat the edge line, NVDA and JAWS saying where they are.
      let mut text = String.make()
      run text.append(edgeWord(self.playing, forward))
      run self.say(text.view(), true)
      return ()
    }
    let before = self.cursor
    let target = if forward { line + 1 } else { line - 1 }
    self.cursor = self.doc.lineStart(target)
    self.offset = 0
    run self.sayLine(Option.Some { value: before }, true)
  }

  /// The first item of the element after (or before) the one the cursor is on: an item, or
  /// for VoiceOver, a link or heading's whole run of items.
  effect fn moveItem(self: &mut Self, forward: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.doc.items.length()
    let around = self.elementAround(self.cursor)
    let start = around.start
    let end = around.end
    if forward && end >= count || !forward && start == 0 {
      let mut spoken = String.make()
      run spoken.append(edgeWord(self.playing, forward))
      run self.say(spoken.view(), true)
      return ()
    }
    let before = self.cursor
    let next = if forward { end } else { self.elementAround(start - 1).start }
    self.cursor = next
    self.offset = 0
    let span = self.elementAround(next)
    let mut text = String.make()
    run self.speakRange(Option.Some { value: before }, span.start, span.end, &mut text)
    run self.say(text.view(), true)
    run self.scrollTo(next)
  }

  /// The items `[start, end)` of the element item `at` is part of.
  fn elementAround(self: &Self, at: usize) -> Span {
    let mut start = at
    let mut end = at + 1
    if self.playing != Flavor.VoiceOver {
      return Span { start: start, end: end }
    }
    while start > 0 && self.sameElement(start - 1, start) {
      start = start - 1
    }
    while end < self.doc.items.length() && self.sameElement(end - 1, end) {
      end = end + 1
    }
    return Span { start: start, end: end }
  }

  /// Whether VoiceOver reads items `a` and `b` as one element: both text in one link or
  /// heading.
  fn sameElement(self: &Self, a: usize, b: usize) -> bool {
    let ia = self.doc.item(a)
    let ib = self.doc.item(b)
    if !ia.isText() || !ib.isText() {
      return false
    }
    let x = self.wholeField(a)
    return x.isSome() && sameOption(x, self.wholeField(b))
  }

  /// The innermost link or heading item `at` is in.
  fn wholeField(self: &Self, at: usize) -> Option<usize> {
    let fields = self.doc.fieldsOf(at)
    let mut f = fields.length
    while f > 0 {
      f = f - 1
      let kind = self.doc.info(fields[f]).kind
      if kind == Role.Link || kind == Role.Heading {
        return Option.Some { value: fields[f] }
      }
    }
    return Option.None
  }

  effect fn moveCharacter(self: &mut Self, forward: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.doc.items.length()
    let text = self.doc.item(self.cursor).text.view()
    if forward {
      let next = nextBoundary(text, self.offset)
      if next < String.byteLength(text) {
        self.offset = next
      } else if self.cursor + 1 < count {
        self.cursor = self.cursor + 1
        self.offset = 0
      } else {
        let mut spoken = String.make()
        run spoken.append(edgeWord(self.playing, true))
        run self.say(spoken.view(), true)
        return ()
      }
    } else if self.offset > 0 {
      self.offset = previousBoundary(text, self.offset)
    } else if self.cursor > 0 {
      self.cursor = self.cursor - 1
      self.offset = self.lastCharacter(self.cursor)
    } else {
      let mut spoken = String.make()
      run spoken.append(edgeWord(self.playing, false))
      run self.say(spoken.view(), true)
      return ()
    }
    run self.sayCharacter()
  }

  fn lastCharacter(self: &Self, item: usize) -> usize {
    let text = self.doc.item(item).text.view()
    let length = String.byteLength(text)
    if length == 0 {
      return 0
    }
    return previousBoundary(text, length)
  }

  effect fn sayCharacter(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let item = self.doc.item(self.cursor)
    if !item.isText() {
      let mut text = String.make()
      run element(self.playing, self.doc.info(item.info), &mut text)
      run self.say(text.view(), true)
      return ()
    }
    let text = item.text.view()
    let end = nextBoundary(text, self.offset)
    let character = String.slice(text, self.offset, end - self.offset)
    let mut spoken = String.make()
    run spoken.append(characterName(self.playing, character))
    run self.say(spoken.view(), true)
  }

  effect fn moveWord(self: &mut Self, forward: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.doc.items.length()
    let words = self.doc.item(self.cursor).words.asSlice()
    if forward {
      let mut w: usize = 0
      while w < words.length && words[w] <= self.offset {
        w = w + 1
      }
      if w < words.length {
        self.offset = words[w]
      } else if self.cursor + 1 < count {
        self.cursor = self.cursor + 1
        self.offset = self.firstWord(self.cursor)
      } else {
        let mut spoken = String.make()
        run spoken.append(edgeWord(self.playing, true))
        run self.say(spoken.view(), true)
        return ()
      }
    } else {
      let mut found = Option<usize>.None
      let mut w: usize = 0
      while w < words.length && words[w] < self.offset {
        found = Option.Some { value: words[w] }
        w = w + 1
      }
      match found {
        Option.Some { value } => {
          self.offset = value
        }
        Option.None => {
          if self.cursor == 0 {
            let mut spoken = String.make()
            run spoken.append(edgeWord(self.playing, false))
            run self.say(spoken.view(), true)
            return ()
          }
          self.cursor = self.cursor - 1
          let previous = self.doc.item(self.cursor).words.asSlice()
          self.offset = if previous.length > 0 { previous[previous.length - 1] } else { 0 }
        }
      }
    }
    run self.sayWord()
  }

  fn firstWord(self: &Self, item: usize) -> usize {
    let words = self.doc.item(item).words.asSlice()
    return if words.length > 0 { words[0] } else { 0 }
  }

  effect fn sayWord(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let item = self.doc.item(self.cursor)
    if !item.isText() {
      run self.sayCharacter()
      return ()
    }
    let text = item.text.view()
    let words = item.words.asSlice()
    let mut end = String.byteLength(text)
    let mut w: usize = 0
    while w < words.length {
      if words[w] > self.offset {
        end = words[w]
        break
      }
      w = w + 1
    }
    let mut spoken = String.make()
    run spoken.append(String.slice(text, self.offset, end - self.offset))
    run self.say(spoken.view(), true)
  }

  /// Says the cursor's line from the cursor on, after what was left since item `before`.
  effect fn sayLine(self: &mut Self, before: Option<usize>, interrupt: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let end = self.doc.lineEnd(self.lineOf(self.cursor))
    let mut text = String.make()
    run self.speakRange(before, self.cursor, end, &mut text)
    if String.byteLength(text.view()) == 0 {
      run text.append("blank")
    }
    run self.say(text.view(), interrupt)
    let at = self.cursor
    run self.scrollTo(at)
  }

  /// Appends what a reader says for items `[start, end)`: the fields left since item `before`
  /// and the fields entered, then each item's text or element, with the roles that follow the
  /// content in flavors that say them last.
  effect fn speakRange(self: &Self, before: Option<usize>, start: usize, end: usize, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let flavor = self.playing
    let mut previous: &[usize] = match before {
      Option.Some { value } => self.doc.fieldsOf(value)
      Option.None => self.doc.fieldsOf(start)
    }
    if let Option<usize>.Some { value: from } = before {
      // Leaving: innermost first.
      let now = self.doc.fieldsOf(start)
      let mut f = previous.length
      while f > 0 {
        f = f - 1
        if !contains(now, previous[f]) && from != start {
          run fieldExit(flavor, self.doc.info(previous[f]), &mut out)
        }
      }
    }
    let mut i = start
    while i < end {
      let fields = self.doc.fieldsOf(i)
      let mut f: usize = 0
      while f < fields.length {
        let entered = !contains(previous, fields[f]) || before.isNone() && i == start
          && contentField(self.doc.info(fields[f]).kind)
        if entered {
          run fieldEnter(flavor, self.doc.info(fields[f]), &mut out)
        }
        f = f + 1
      }
      let item = self.doc.item(i)
      if item.isText() {
        let text = if i == self.cursor && self.offset > 0 && i == start {
          String.slice(item.text.view(), self.offset, String.byteLength(item.text.view()) - self.offset)
        } else {
          item.text.view()
        }
        run part(flavor, &mut out, text)
      } else {
        run element(flavor, self.doc.info(item.info), &mut out)
      }
      // Fields that end here, innermost first.
      let next: &[usize] = if i + 1 < end { self.doc.fieldsOf(i + 1) } else { &[] }
      let mut g = fields.length
      while g > 0 {
        g = g - 1
        if !contains(next, fields[g]) {
          run fieldEnd(flavor, self.doc.info(fields[g]), &mut out)
        }
      }
      previous = fields
      i = i + 1
    }
  }

  effect fn scrollTo(self: &mut Self, item: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let id = self.doc.info(self.doc.item(item).info).id
    run self.request(Action.ScrollIntoView, id)
  }

  effect fn request(self: &mut Self, action: Action, id: FullNodeId) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let located = match &self.tree {
      Option.Some { value } => value.state().locateNode(id)
      Option.None => Option<LocatedNode>.None
    }
    if let Option.Some { value } = located {
      run self.requests.append(ActionRequest {
        action: action,
        targetTree: value.tree,
        targetNode: value.local,
        data: Option<ActionData>.None,
      })
    }
  }

  // -------------------------------------------------------------------------------------------
  // Quick navigation

  /// The item where the next (or previous) element of `kind` starts.
  /// The items of the element of kind `kind` that starts at item `at`: the innermost one, its
  /// own item or a field around it.
  fn matchedSpan(self: &Self, kind: Kind, at: usize) -> Span {
    let item = self.doc.item(at)
    let own = self.doc.info(item.info)
    let mut info = item.info
    if !kindMatches(kind, own.kind, own.level) {
      let fields = self.doc.fieldsOf(at)
      let mut f = fields.length
      while f > 0 {
        f = f - 1
        let field = self.doc.info(fields[f])
        if kindMatches(kind, field.kind, field.level) {
          info = fields[f]
          break
        }
      }
    }
    let mut end = at + 1
    while end < self.doc.items.length() && self.doc.within(end, info) {
      end = end + 1
    }
    return Span { start: at, end: end }
  }

  fn find(self: &Self, kind: Kind, forward: bool, from: usize) -> Option<usize> {
    let count = self.doc.items.length()
    let own = self.doc.fieldsOf(from)
    let ownInfo = self.doc.item(from).info
    let mut i = from
    while true {
      if forward {
        if i + 1 >= count {
          return Option.None
        }
        i = i + 1
      } else {
        if i == 0 {
          return Option.None
        }
        i = i - 1
      }
      let item = self.doc.item(i)
      let info = self.doc.info(item.info)
      if item.info != ownInfo && kindMatches(kind, info.kind, info.level) && self.startsAt(i, item.info) {
        return Option.Some { value: i }
      }
      let fields = self.doc.fieldsOf(i)
      let mut f: usize = 0
      while f < fields.length {
        let field = self.doc.info(fields[f])
        if kindMatches(kind, field.kind, field.level) && !contains(own, fields[f]) && self.startsAt(i, fields[f]) {
          return Option.Some { value: i }
        }
        f = f + 1
      }
    }
    return Option.None
  }

  /// Whether item `at` is the first of info `info`.
  fn startsAt(self: &Self, at: usize, info: usize) -> bool {
    return at == 0 || !self.doc.within(at - 1, info)
  }

  effect fn jump(self: &mut Self, kind: Kind, forward: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match self.find(kind, forward, self.cursor) {
      Option.Some { value } => {
        let before = self.cursor
        self.cursor = value
        self.offset = 0
        let container = kind == Kind.Table || kind == Kind.List || kind == Kind.Landmark
        if self.playing == Flavor.Orca || container && self.playing != Flavor.VoiceOver {
          // Orca's structural navigation presents the line the element is on, and so do the
          // others for a table, list or landmark: its first line.
          run self.sayLine(Option.Some { value: before }, true)
        } else {
          // The others read the element they moved to, not the rest of its line.
          let span = if self.playing == Flavor.VoiceOver {
            self.elementAround(value)
          } else {
            self.matchedSpan(kind, value)
          }
          let mut text = String.make()
          run self.speakRange(Option.Some { value: before }, span.start, span.end, &mut text)
          run self.say(text.view(), true)
          run self.scrollTo(value)
        }
      }
      Option.None => {
        let mut text = String.make()
        run nothingFound(self.playing, kind, forward, &mut text)
        run self.say(text.view(), true)
      }
    }
  }

  // -------------------------------------------------------------------------------------------
  // Activating and focus

  /// Clicks the element under the cursor, focusing it first; a text field goes into focus
  /// mode instead.
  effect fn activate(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let target = self.activationTarget()
    let info = self.doc.info(target)
    let id = info.id
    let edit = isEdit(info.kind)
    let focusable = info.focusable
    if focusable {
      run self.request(Action.Focus, id)
    }
    if edit {
      if browses(self.playing) && !self.inFocusMode {
        self.inFocusMode = true
        let mut spoken = String.make()
        run spoken.append(modeWord(self.playing, true))
        run self.say(spoken.view(), true)
      }
      return ()
    }
    run self.request(Action.Click, id)
  }

  /// The control under the cursor, or the innermost link or other actionable field around it.
  fn activationTarget(self: &Self) -> usize {
    let item = self.doc.item(self.cursor)
    if isControl(self.doc.info(item.info).kind) {
      return item.info
    }
    let fields = self.doc.fieldsOf(self.cursor)
    let mut f = fields.length
    while f > 0 {
      f = f - 1
      let info = self.doc.info(fields[f])
      if info.kind == Role.Link || info.focusable {
        return fields[f]
      }
    }
    return item.info
  }

  /// Appends what the flavor says about the focused element and the containers around it.
  effect fn focusPhrase(self: &Self, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let focus = match self.focus {
      Option.Some { value } => value
      Option.None => {
        return ()
      }
    }
    match self.doc.find(focus) {
      Option.Some { value } => run element(self.playing, self.doc.info(value), &mut out)
      Option.None => {
        // A focused container that is no item or field (a group, the document).
        match &self.tree {
          Option.Some { value: tree } => match tree.state().nodeById(focus) {
            Option.Some { value: node } => {
              let mut name = String.make()
              drop run node.writeLabel(&mut name)
              run part(self.playing, &mut out, name.view())
              run part(self.playing, &mut out, roleWord(self.playing, node.accessRole()))
            }
            Option.None => {}
          }
          Option.None => {}
        }
      }
    }
  }

  /// Focus moved from `before`: say where it went, with the containers entered, move the
  /// cursor there, and enter or leave focus mode.
  effect fn focusMoved(self: &mut Self, before: Option<FullNodeId>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let focus = match self.focus {
      Option.Some { value } => value
      Option.None => {
        return ()
      }
    }
    let mut text = String.make()
    let mut wantsFocusMode = false
    match &self.tree {
      Option.Some { value: tree } => {
        let state = tree.state()
        match state.nodeById(focus) {
          Option.Some { value: node } => {
            if node.isRoot() {
              return ()
            }
            wantsFocusMode = needsFocusMode(node)
            // Containers entered: those around the new focus that were not around the old.
            let mut around = List<FullNodeId>.make()
            let mut parent = node.parent()
            while let Option<NodeRef<'_>>.Some { value: p } = parent {
              if announcesOnFocus(p.accessRole(), p.data().label().isSome()) {
                run around.insertSlice(0, &[p.id])
              }
              parent = p.parent()
            }
            let mut a: usize = 0
            while a < around.length() {
              let id = around.get(a)
              let wasAround = match before {
                Option.Some { value: old } => match state.nodeById(old) {
                  Option.Some { value: oldNode } => match state.nodeById(id) {
                    Option.Some { value: container } => oldNode.isDescendantOf(&container)
                    Option.None => false
                  }
                  Option.None => false
                }
                Option.None => false
              }
              if !wasAround {
                if let Option<usize>.Some { value: info } = self.doc.find(id) {
                  run fieldEnter(self.playing, self.doc.info(info), &mut text)
                } else if let Option<NodeRef<'_>>.Some { value: container } = state.nodeById(id) {
                  let mut name = String.make()
                  drop run container.writeLabel(&mut name)
                  run part(self.playing, &mut text, name.view())
                  run part(self.playing, &mut text, roleWord(self.playing, container.accessRole()))
                }
              }
              a = a + 1
            }
          }
          Option.None => {}
        }
      }
      Option.None => {}
    }
    run self.focusPhrase(&mut text)
    run self.say(text.view(), true)
    if let Option<usize>.Some { value: info } = self.doc.find(focus) {
      if let Option<usize>.Some { value: item } = self.doc.firstItemOf(info) {
        self.cursor = item
        self.offset = 0
      }
    }
    if browses(self.playing) && !self.chosen && wantsFocusMode != self.inFocusMode {
      self.inFocusMode = wantsFocusMode
    }
  }

  /// A live region changed at node `id`: say its text, or the whole region when it is atomic.
  effect fn liveChanged(self: &mut Self, id: FullNodeId, assertive: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    match &self.tree {
      Option.Some { value: tree } => match tree.state().nodeById(id) {
        Option.Some { value: node } => {
          // The atomic region around the change, or the changed node.
          let mut target = node
          let mut current = Option.Some { value: node }
          while let Option<NodeRef<'_>>.Some { value: n } = current {
            if n.data().isLiveAtomic() {
              target = n
              break
            }
            if n.data().live().isSome() {
              break
            }
            current = n.parent()
          }
          if target.accessRole() == Role.Label {
            run appendWord(&mut text, target.data().value().unwrapOr(""))
          } else {
            run liveText(target, &mut text)
          }
        }
        Option.None => {}
      }
      Option.None => {}
    }
    run self.say(text.view(), assertive)
  }

  // -------------------------------------------------------------------------------------------
  // Tables

  effect fn tableMove(self: &mut Self, rows: i32, columns: i32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let fields = self.doc.fieldsOf(self.cursor)
    let mut table = Option<usize>.None
    let mut f: usize = 0
    while f < fields.length {
      let kind = self.doc.info(fields[f]).kind
      if kind == Role.Table || kind == Role.Grid || kind == Role.TreeGrid {
        table = Option.Some { value: fields[f] }
      }
      f = f + 1
    }
    let tableInfo = match table {
      Option.Some { value } => value
      Option.None => {
        let mut spoken = String.make()
        run spoken.append("not in a table cell")
        run self.say(spoken.view(), true)
        return ()
      }
    }
    let mut grid = Grid.make()
    run grid.read(&self.doc, tableInfo)
    let place = match grid.locate(&self.doc, self.cursor) {
      Option.Some { value } => value
      Option.None => {
        let mut spoken = String.make()
        run spoken.append("not in a table cell")
        run self.say(spoken.view(), true)
        return ()
      }
    }
    let r = usize.toI32(place.start) + rows
    let c = usize.toI32(place.end) + columns
    if r < 0 || c < 0 || i32.toUsize(r) >= grid.rows.length() {
      let mut spoken = String.make()
      run spoken.append("edge of table")
      run self.say(spoken.view(), true)
      return ()
    }
    let targetRow = i32.toUsize(r)
    let targetColumn = i32.toUsize(c)
    let cell = match grid.cell(targetRow, targetColumn) {
      Option.Some { value } => value
      Option.None => {
        let mut spoken = String.make()
        run spoken.append("edge of table")
        run self.say(spoken.view(), true)
        return ()
      }
    }
    let mut text = String.make()
    if rows != 0 {
      let mut header = String.make()
      if let Option<usize>.Some { value } = grid.cell(targetRow, 0) {
        if self.doc.info(value).kind == Role.RowHeader && targetColumn != 0 {
          run header.append(self.doc.info(value).name.view())
        }
      }
      run part(self.playing, &mut text, header.view())
      let mut where = String.make()
      run where.append("row ")
      run appendNumber(&mut where, targetRow + 1)
      run part(self.playing, &mut text, where.view())
    }
    if columns != 0 {
      let mut header = String.make()
      if let Option<usize>.Some { value } = grid.cell(0, targetColumn) {
        if self.doc.info(value).kind == Role.ColumnHeader && targetRow != 0 {
          run header.append(self.doc.info(value).name.view())
        }
      }
      run part(self.playing, &mut text, header.view())
      let mut where = String.make()
      run where.append("column ")
      run appendNumber(&mut where, targetColumn + 1)
      run part(self.playing, &mut text, where.view())
    }
    let info = self.doc.info(cell)
    if String.byteLength(info.name.view()) != 0 {
      run part(self.playing, &mut text, info.name.view())
    } else {
      run part(self.playing, &mut text, "blank")
    }
    run states(self.playing, info, &mut text)
    if let Option<usize>.Some { value: item } = self.doc.firstItemOf(cell) {
      self.cursor = item
      self.offset = 0
    }
    run self.say(text.view(), true)
  }

  // -------------------------------------------------------------------------------------------
  // The elements list

  effect fn openList(self: &mut Self, kindIndex: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.list = Option.Some {
      value: ElementsList {
        kindIndex: kindIndex,
        entries: List<usize>.make(),
        labels: List<String>.make(),
        selected: 0,
        filter: String.make(),
      },
    }
    run self.fillList(kindIndex)
    run self.sayList(true)
  }

  /// Lists the elements of kind `kindIndex`, keeping the filter, selecting the first one at
  /// or after the cursor.
  effect fn fillList(self: &mut Self, kindIndex: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let kind = listKind(kindIndex)
    let mut entries = List<usize>.make()
    let mut labels = List<String>.make()
    let mut selected: usize = 0
    let mut seenCursor = false
    let filter = match &self.list {
      Option.Some { value } => value.filter.view()
      Option.None => ""
    }
    let mut i: usize = 0
    while i < self.doc.infos.length() {
      let info = self.doc.info(i)
      if kindMatches(kind, info.kind, info.level) {
        let mut label = String.make()
        if kind == Kind.Landmark {
          run fieldEnter(self.playing, info, &mut label)
        } else if kind == Kind.Heading || kind == Kind.Link {
          run label.append(info.name.view())
          if kind == Kind.Heading && info.level > 0 {
            run label.append(" level ")
            run appendNumber(&mut label, info.level)
          }
        } else {
          run element(self.playing, info, &mut label)
        }
        if containsLetters(label.view(), filter) {
          if !seenCursor {
            if let Option<usize>.Some { value: first } = self.doc.firstItemOf(i) {
              if first >= self.cursor {
                selected = entries.length()
                seenCursor = true
              }
            }
          }
          run entries.append(i)
          run labels.append(move label)
        }
      }
      i = i + 1
    }
    if let Option<ElementsList>.Some { value } = &mut self.list {
      let keepSelection = value.kindIndex == kindIndex && value.entries.length() > 0
      value.kindIndex = kindIndex
      if !keepSelection || value.selected >= entries.length() {
        value.selected = selected
      }
      value.entries = move entries
      value.labels = move labels
    }
  }

  effect fn sayList(self: &mut Self, opened: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    match &self.list {
      Option.Some { value } => {
        if opened {
          run part(self.playing, &mut text, if self.playing == Flavor.VoiceOver { "rotor" } else { "elements list" })
        }
        if opened || value.selected == 0 {
          let mut heading = String.make()
          run heading.append(kindWord(listKind(value.kindIndex), true))
          run part(self.playing, &mut text, heading.view())
        }
        if value.entries.length() == 0 {
          run part(self.playing, &mut text, "no items")
        } else {
          run part(self.playing, &mut text, value.labels.asSlice()[value.selected].view())
          let mut where = String.make()
          run appendNumber(&mut where, value.selected + 1)
          run where.append(" of ")
          run appendNumber(&mut where, value.entries.length())
          run part(self.playing, &mut text, where.view())
        }
      }
      Option.None => {}
    }
    run self.say(text.view(), true)
  }

  effect fn listKey(self: &mut Self, key: string, named: Key, modifiers: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let shift = (modifiers & MOD_SHIFT) != 0
    let mut kindIndex: usize = 0
    let mut count: usize = 0
    let mut selected: usize = 0
    match &self.list {
      Option.Some { value } => {
        kindIndex = value.kindIndex
        count = value.entries.length()
        selected = value.selected
      }
      Option.None => {
        return ()
      }
    }
    if named == Key.Escape {
      self.list = Option<ElementsList>.None
      let mut spoken = String.make()
      run spoken.append(if self.playing == Flavor.VoiceOver { "closing rotor" } else { "closed" })
      run self.say(spoken.view(), true)
      return ()
    }
    if named == Key.Right || named == Key.Left || named == Key.Tab {
      let forward = named == Key.Right || named == Key.Tab && !shift
      let next = if forward { kindIndex + 1 } else { kindIndex + LIST_KINDS - 1 }
      if let Option<ElementsList>.Some { value } = &mut self.list {
        value.filter.clear()
        value.entries.clear()
      }
      run self.fillList(next % LIST_KINDS)
      run self.sayList(true)
      return ()
    }
    if named == Key.Down || named == Key.Up {
      if count == 0 {
        run self.sayList(false)
        return ()
      }
      if let Option<ElementsList>.Some { value } = &mut self.list {
        value.selected = if named == Key.Down {
          (selected + 1) % count
        } else {
          (selected + count - 1) % count
        }
      }
      run self.sayList(false)
      return ()
    }
    if named == Key.Enter {
      let target = match &self.list {
        Option.Some { value } => if count > 0 { Option.Some { value: value.entries.get(selected) } } else { Option<usize>.None }
        Option.None => Option<usize>.None
      }
      self.list = Option<ElementsList>.None
      if let Option<usize>.Some { value: info } = target {
        if let Option<usize>.Some { value: item } = self.doc.firstItemOf(info) {
          let before = self.cursor
          self.cursor = item
          self.offset = 0
          if self.doc.info(info).focusable && self.playing == Flavor.VoiceOver {
            let id = self.doc.info(info).id
            run self.request(Action.Focus, id)
          }
          run self.sayLine(Option.Some { value: before }, true)
        }
      }
      return ()
    }
    if key == "Backspace" {
      if let Option<ElementsList>.Some { value } = &mut self.list {
        let length = String.byteLength(value.filter.view())
        if length > 0 {
          let cut = previousBoundary(value.filter.view(), length)
          let mut shorter = String.make()
          run shorter.append(String.slice(value.filter.view(), 0, cut))
          value.filter = move shorter
        }
      }
      run self.fillList(kindIndex)
      run self.sayList(false)
      return ()
    }
    if String.byteLength(key) == 1 && (modifiers & (MOD_CONTROL | MOD_ALT | MOD_META)) == 0 {
      if let Option<ElementsList>.Some { value } = &mut self.list {
        run value.filter.append(key)
      }
      run self.fillList(kindIndex)
      run self.sayList(false)
    }
  }
}

fn matchesSayAll(command: Command) -> bool {
  return match command {
    Command.SayAll => true
    _ => false
  }
}

fn sameOption(a: Option<usize>, b: Option<usize>) -> bool {
  return match a {
    Option.Some { value: x } => match b {
      Option.Some { value: y } => x == y
      Option.None => false
    }
    Option.None => b.isNone()
  }
}

fn contains(values: &[usize], value: usize) -> bool {
  let mut i: usize = 0
  while i < values.length {
    if values[i] == value {
      return true
    }
    i = i + 1
  }
  return false
}

/// Whether `text` contains `needle`, ASCII case ignored.
fn containsLetters(text: string, needle: string) -> bool {
  let a = String.utf8Bytes(text)
  let b = String.utf8Bytes(needle)
  if b.length == 0 {
    return true
  }
  let mut i: usize = 0
  while i + b.length <= a.length {
    let mut j: usize = 0
    while j < b.length && lower(a[i + j]) == lower(b[j]) {
      j = j + 1
    }
    if j == b.length {
      return true
    }
    i = i + 1
  }
  return false
}

fn lower(b: u8) -> u8 {
  if b >= 65 && b <= 90 {
    return b + 32
  }
  return b
}

/// The byte offset of the character after the one at `offset`.
fn nextBoundary(text: string, offset: usize) -> usize {
  let length = String.byteLength(text)
  let mut i = offset + 1
  while i < length && !String.isCharBoundary(text, i) {
    i = i + 1
  }
  if i > length {
    return length
  }
  return i
}

fn previousBoundary(text: string, offset: usize) -> usize {
  if offset == 0 {
    return 0
  }
  let mut i = offset - 1
  while i > 0 && !String.isCharBoundary(text, i) {
    i = i - 1
  }
  return i
}

fn isModifier(code: string) -> bool {
  return code == "ShiftLeft" || code == "ShiftRight" || code == "AltLeft" || code == "AltRight"
    || code == "MetaLeft" || code == "MetaRight" || code == "ControlLeft" || code == "ControlRight"
    || code == "Insert" || code == "CapsLock"
}

fn isArrow(key: Key) -> bool {
  return key == Key.Up || key == Key.Down || key == Key.Left || key == Key.Right
}

fn isLetterOrDigit(code: string) -> bool {
  return String.startsWith(code, "Key") || String.startsWith(code, "Digit")
}

/// Whether focus on `node` puts a browse-mode reader in focus mode: text fields, and widgets
/// that take the arrow keys.
fn needsFocusMode(node: NodeRef<'_>) -> bool {
  let kind = node.accessRole()
  if isEdit(kind) || node.isTextInput() {
    return true
  }
  let widget = match kind {
    Role.ComboBox => true
    Role.ListBoxOption => true
    Role.ListBox => true
    Role.MenuItem => true
    Role.MenuItemCheckBox => true
    Role.MenuItemRadio => true
    Role.TreeItem => true
    Role.GridCell => true
    Role.Slider => true
    Role.SpinButton => true
    Role.Tab => false
    _ => false
  }
  if widget {
    return true
  }
  let mut parent = node.parent()
  while let Option<NodeRef<'_>>.Some { value } = parent {
    if value.accessRole() == Role.Application {
      return true
    }
    parent = value.parent()
  }
  return false
}

/// Containers a reader names when focus moves into them.
fn announcesOnFocus(kind: Role, named: bool) -> bool {
  return match kind {
    Role.Dialog => true
    Role.AlertDialog => true
    Role.Menu => true
    Role.MenuBar => true
    Role.ListBox => named
    Role.Toolbar => named
    Role.TabList => named
    Role.RadioGroup => named
    Role.Group => named
    Role.Table => true
    Role.Grid => true
    Role.Tree => named
    Role.List => named
    _ => isLandmark(kind) && (kind != Role.Region || named)
  }
}

/// The text in a live region's changed subtree.
effect fn liveText(node: NodeRef<'_>, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let kind = node.accessRole()
  if kind == Role.Label {
    run appendWord(&mut out, node.data().value().unwrapOr(""))
    return ()
  }
  if kind == Role.TextRun || node.isHidden() {
    return ()
  }
  if node.childCount() == 0 {
    run appendWord(&mut out, node.data().label().unwrapOr(""))
    return ()
  }
  let mut i: usize = 0
  while i < node.childCount() {
    if let Option<NodeRef<'_>>.Some { value } = node.childAt(i) {
      run liveText(value, &mut out)
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------------------------------------
// Tables

/// A range of items, or a table place (row in `start`, column in `end`).
struct Span {
  start: usize,
  end: usize,
}

impl Copy for Span {}

struct Grid {
  /// The cells of each row, as infos: `cells[rows[r]..rows[r + 1]]`.
  rows: List<usize>,
  cells: List<usize>,
}

impl Grid {
  fn make() -> Grid {
    return Grid { rows: List<usize>.make(), cells: List<usize>.make() }
  }

  /// Reads the rows and cells of table `table` from the items inside it.
  effect fn read(self: &mut Self, document: &Document, table: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut lastRow = Option<usize>.None
    let mut lastCell = Option<usize>.None
    let mut i: usize = 0
    while i < document.items.length() {
      if document.within(i, table) {
        let fields = document.fieldsOf(i)
        let mut row = Option<usize>.None
        let mut cell = Option<usize>.None
        let mut f: usize = 0
        while f < fields.length {
          let kind = document.info(fields[f]).kind
          if kind == Role.Row {
            row = Option.Some { value: fields[f] }
          } else if isCell(kind) {
            cell = Option.Some { value: fields[f] }
          }
          f = f + 1
        }
        if let Option<usize>.Some { value: r } = row {
          if !sameOption(row, lastRow) {
            run self.rows.append(self.cells.length())
            lastRow = row
            lastCell = Option<usize>.None
          }
          if let Option<usize>.Some { value: c } = cell {
            if !sameOption(cell, lastCell) {
              run self.cells.append(c)
              lastCell = cell
            }
          }
          drop r
        }
      }
      i = i + 1
    }
  }

  fn rowEnd(self: &Self, row: usize) -> usize {
    if row + 1 < self.rows.length() {
      return self.rows.get(row + 1)
    }
    return self.cells.length()
  }

  fn cell(self: &Self, row: usize, column: usize) -> Option<usize> {
    if row >= self.rows.length() {
      return Option.None
    }
    let at = self.rows.get(row) + column
    if at >= self.rowEnd(row) {
      return Option.None
    }
    return Option.Some { value: self.cells.get(at) }
  }

  /// The row and column of the cell item `item` is in.
  /// As a span: `start` the row, `end` the column.
  fn locate(self: &Self, document: &Document, item: usize) -> Option<Span> {
    let mut r: usize = 0
    while r < self.rows.length() {
      let mut at = self.rows.get(r)
      while at < self.rowEnd(r) {
        if document.within(item, self.cells.get(at)) {
          return Option.Some { value: Span { start: r, end: at - self.rows.get(r) } }
        }
        at = at + 1
      }
      r = r + 1
    }
    return Option.None
  }
}

fn isCell(kind: Role) -> bool {
  return kind == Role.Cell || kind == Role.GridCell || kind == Role.ColumnHeader || kind == Role.RowHeader
}

// ---------------------------------------------------------------------------------------------
// What an update changed

struct LiveChange {
  id: FullNodeId,
  assertive: bool,
}

impl Copy for LiveChange {}

/// What a tree update told the reader, collected while the consumer applies it.
struct Heard {
  flavor: Flavor,
  /// What changed about the focused element ("checked", a typed character).
  focused: String,
  live: List<LiveChange>,
}

impl Heard {
  fn make(flavor: Flavor) -> Heard {
    return Heard { flavor: flavor, focused: String.make(), live: List<LiveChange>.make() }
  }

  effect fn heardLive(self: &mut Self, node: &NodeRef<'_>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let kind = node.accessRole()
    if kind == Role.TextRun || node.isHidden() {
      return ()
    }
    let live = node.live()
    if live == Live.Off {
      return ()
    }
    let mut i: usize = 0
    while i < self.live.length() {
      if self.live.get(i).id.equals(node.id) {
        return ()
      }
      i = i + 1
    }
    run self.live.append(LiveChange { id: node.id, assertive: live == Live.Assertive })
  }
}

impl ChangeHandler for Heard {
  effect fn nodeAdded(self: &mut Self, node: &NodeRef<'_>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.heardLive(node)
  }

  effect fn nodeUpdated(self: &mut Self, old: &NodeRef<'_>, new: &NodeRef<'_>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if new.isFocused() && old.isFocused() {
      run stateChange(self.flavor, old, new, &mut self.focused)
    }
    let a = old.data().value().unwrapOr("")
    let b = new.data().value().unwrapOr("")
    let c = old.data().label().unwrapOr("")
    let d = new.data().label().unwrapOr("")
    if a != b || c != d {
      run self.heardLive(new)
    }
  }

  effect fn focusMoved(self: &mut Self, old: Option<NodeRef<'_>>, new: Option<NodeRef<'_>>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {}

  effect fn nodeRemoved(self: &mut Self, node: &NodeRef<'_>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {}
}

/// Appends what a reader says when the focused element changes in place: its new state, or
/// the characters typed into it.
effect fn stateChange(flavor: Flavor, old: &NodeRef<'_>, new: &NodeRef<'_>, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let a = old.data()
  let b = new.data()
  let toggled = !sameToggle(old.toggled(), new.toggled())
  let expanded = !sameBool(a.isExpanded(), b.isExpanded())
  let selected = !sameBool(old.isSelected(), new.isSelected())
  if toggled || expanded || selected {
    // Only the states that changed: build an info with just those.
    let mut info = Info.blank(new.id, new.accessRole())
    if toggled {
      info.toggled = new.toggled()
    }
    if expanded {
      info.expanded = b.isExpanded()
    }
    if selected {
      info.selected = new.isSelected()
    }
    run states(flavor, &info, &mut out)
  }
  let before = a.value().unwrapOr("")
  let after = b.value().unwrapOr("")
  if before != after {
    let kind = new.accessRole()
    if isEdit(kind) || new.isTextInput() {
      if new.isPasswordInput() {
        return ()
      }
      let x = String.byteLength(before)
      let y = String.byteLength(after)
      if y > x && String.startsWith(after, before) {
        let typed = String.slice(after, x, y - x)
        run part(flavor, &mut out, characterName(flavor, typed))
      } else if x > y && String.startsWith(before, after) {
        let gone = String.slice(before, y, x - y)
        run part(flavor, &mut out, characterName(flavor, gone))
      }
    } else {
      run part(flavor, &mut out, after)
    }
  }
}

fn sameBool(a: Option<bool>, b: Option<bool>) -> bool {
  return match a {
    Option.Some { value: x } => match b {
      Option.Some { value: y } => x == y
      Option.None => false
    }
    Option.None => b.isNone()
  }
}

fn sameToggle(a: Option<Toggled>, b: Option<Toggled>) -> bool {
  return match a {
    Option.Some { value: x } => match b {
      Option.Some { value: y } => x == y
      Option.None => false
    }
    Option.None => b.isNone()
  }
}
