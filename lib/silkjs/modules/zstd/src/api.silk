//! The entry points of the package, shaped as the streaming API of the reference library that an
//! embedding links against: `ZSTD_createDStream`, `ZSTD_decompressStream`, `ZSTD_isError` and the
//! others, under the same names without the prefix.
//!
//! A codec is an opaque pointer. A size result is a size or hint, or an error for which
//! [`isError`] is true; [`getErrorCode`] gives its `ZSTD_ErrorCode` and [`getErrorName`] its
//! message.
import mem
import errors
import decode
import compress
import silk.mem.pointer { Pointer }

unsafe fn many(p: ?*mut u8) -> ?[*]mut u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]mut u8>(p) }
unsafe fn single(p: ?[*]mut u8) -> ?*mut u8 { return unsafe Intrinsic.pointerRequalify<?[*]mut u8, ?*mut u8>(p) }
// A buffer of no bytes can be null in the reference API; the port wants a pointer it never reads.
unsafe fn readable(p: ?*mut u8) -> [*]const u8 {
  if Pointer.isNull<u8>(p) { return unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(b"\0")) }
  return unsafe Intrinsic.pointerRequalify<?*mut u8, [*]const u8>(p)
}
unsafe fn writable(p: ?*mut u8, fallback: ?*mut u8) -> [*]mut u8 {
  if Pointer.isNull<u8>(p) { return unsafe Intrinsic.pointerRequalify<?*mut u8, [*]mut u8>(fallback) }
  return unsafe Intrinsic.pointerRequalify<?*mut u8, [*]mut u8>(p)
}

/// `ZSTD_versionString`: the version of the reference library that this port follows, as a
/// NUL-terminated string.
pub fn versionString() -> *const u8 {
  return unsafe Intrinsic.pointerRequalify<?[*]const u8, *const u8>(Pointer.fromSlice<u8>(b"1.5.7\0"))
}

/// `ZSTD_isError`.
pub fn isError(code: usize) -> u32 { if errors.isError(code) { return 1 } return 0 }

/// `ZSTD_getErrorCode`.
pub fn getErrorCode(code: usize) -> i32 { return errors.code(code) }

/// `ZSTD_getErrorName`: the message of a result, NUL-terminated and static.
pub fn getErrorName(code: usize) -> ?*mut u8 {
  return unsafe Intrinsic.pointerRequalify<?[*]const u8, ?*mut u8>(errors.name(code))
}

/// `ZSTD_getErrorString`: the message of an error code, NUL-terminated and static.
pub fn getErrorString(code: i32) -> ?*mut u8 {
  return unsafe Intrinsic.pointerRequalify<?[*]const u8, ?*mut u8>(errors.message(code))
}

/// `ZSTD_createDStream`.
pub unsafe fn createDStream() -> ?*mut u8 { return unsafe single(unsafe decode.createDStream()) }

/// `ZSTD_freeDStream`.
pub unsafe fn freeDStream(stream: ?*mut u8) -> usize { return unsafe decode.freeDStream(unsafe many(stream)) }

/// `ZSTD_DCtx_setParameter`.
pub unsafe fn dctxSetParameter(stream: ?*mut u8, parameter: i32, value: i32) -> usize {
  return unsafe decode.dctxSetParameter(unsafe many(stream), parameter, value)
}

/// `ZSTD_DCtx_loadDictionary`.
pub unsafe fn dctxLoadDictionary(stream: ?*mut u8, dictionary: ?*mut u8, size: usize) -> usize {
  return unsafe decode.dctxLoadDictionary(unsafe many(stream), unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(dictionary), size)
}

/// `ZSTD_DCtx_reset`.
pub unsafe fn dctxReset(stream: ?*mut u8, directive: i32) -> usize { return unsafe decode.dctxReset(unsafe many(stream), directive) }

/// `ZSTD_decompressStream`, with the two buffers as a pointer, a size and a position each. The
/// positions move by what the call wrote and read.
pub unsafe fn decompressStream(stream: ?*mut u8, output: ?*mut u8, outputSize: usize, outputPos: &mut usize, input: ?*mut u8, inputSize: usize, inputPos: &mut usize) -> usize {
  return unsafe decode.decompressStream(unsafe many(stream), unsafe writable(output, stream), outputSize, &mut outputPos, unsafe readable(input), inputSize, &mut inputPos)
}

/// `ZSTD_createCStream`.
pub unsafe fn createCStream() -> ?*mut u8 { return unsafe single(compress.createCCtx()) }

/// `ZSTD_freeCStream`.
pub unsafe fn freeCStream(stream: ?*mut u8) -> usize {
  unsafe compress.freeCCtx(unsafe many(stream))
  return 0
}

unsafe fn context(stream: ?*mut u8) -> [*]mut u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, [*]mut u8>(stream) }

/// `ZSTD_CCtx_setParameter`.
pub unsafe fn cctxSetParameter(stream: ?*mut u8, parameter: i32, value: i32) -> usize {
  return unsafe compress.cctxSetParameter(unsafe context(stream), parameter, value)
}

/// `ZSTD_CCtx_setPledgedSrcSize`.
pub unsafe fn cctxSetPledgedSrcSize(stream: ?*mut u8, size: u64) -> usize {
  return unsafe compress.cctxSetPledgedSrcSize(unsafe context(stream), size)
}

/// `ZSTD_CCtx_loadDictionary`.
pub unsafe fn cctxLoadDictionary(stream: ?*mut u8, dictionary: ?*mut u8, size: usize) -> usize {
  return unsafe compress.cctxLoadDictionary(unsafe context(stream), unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(dictionary), size)
}

/// `ZSTD_CCtx_reset`.
pub unsafe fn cctxReset(stream: ?*mut u8, directive: i32) -> usize { return unsafe compress.cctxReset(unsafe context(stream), directive) }

/// `ZSTD_compressStream2`, with the two buffers as a pointer, a size and a position each.
pub unsafe fn compressStream2(stream: ?*mut u8, output: ?*mut u8, outputSize: usize, outputPos: &mut usize, input: ?*mut u8, inputSize: usize, inputPos: &mut usize, endOp: i32) -> usize {
  return unsafe compress.compressStream2(unsafe context(stream), unsafe writable(output, stream), outputSize, &mut outputPos, unsafe readable(input), inputSize, &mut inputPos, endOp)
}

// Used by the first version of tools/cli; to be removed with it.
pub unsafe fn probe(a: [*]const u8, b: [*]const u8, n: usize) -> usize { return unsafe mem.count(a, 0, b, 0, n) }
