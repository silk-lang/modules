      if op == Op.GetVar && function.value(inst.result).own == Own.Borrowed { index = u32.bitOr(index, 0x80000000) }
      if self.on {
        let slow = run self.a.label()
        let mut closure = NONE
        if inst.frame != 0 { closure = self.inlineClosures.get(u32.toUsize(inst.frame - 1)) }
        run self.a.jmp(slow)
        self.a.bind(read)
        run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: read, inst: inst, step: 0, shape: 0, out: closure, extra: index, kind: STEP_HELPER_SLOW })
        return ()
      }
      run self.frameInto(Reg.Rsi)
      run self.a.movImm32(Reg.Rdx, index)
      if op == Op.GetVar { run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result)) run self.callHelper(helpers.GET_VAR) }
      else { run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.a)) run self.callHelper(helpers.PUT_VAR) }
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      self.a.bind(read)
      return ()
    }
    if op == Op.AtomValue {
      run self.stressGuard(inst.exit)
      let atom = i32.wrappingToU32(i32.shiftRight(inst.k, 1))
      if self.on && atom != 0 {
        // The atom's own string cell, linked (Function.linkedAtoms), with a count of the
        // value's own.
        let mut n: u32 = 0
        while u32.toUsize(n) < self.atoms.length() && self.atoms.get(u32.toUsize(n)) != atom { n = n + 1 }
        let layout = self.settings.layout
        let symbol = self.atomSymbol(&function, n)
        run self.a.movSymbol(Reg.Rax, symbol)
        run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.Rax, 0), 1)
        run self.a.movImm64(Reg.R9, layout.tagWord(layout.tagOf(0 - 7)))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.R9)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rax)
        return ()
      }
      // atom_value(env, frame, site, out) -> 1 when out holds the owned string.
      let site = u32.bitOr(inst.pc, u32.shiftLeft(i32.wrappingToU32(inst.k) & 1, 31))
      if self.on {
        let slow = run self.a.label()
        let done = run self.a.label()
        let mut closure = NONE
        if inst.frame != 0 { closure = self.inlineClosures.get(u32.toUsize(inst.frame - 1)) }
        run self.a.jmp(slow)
        self.a.bind(done)
        run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: done, inst: inst, step: 0, shape: 0, out: closure, extra: site, kind: STEP_HELPER_SLOW })
        return ()
      }
      run self.frameInto(Reg.Rsi)
      run self.a.movImm32(Reg.Rdx, site)
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
      run self.callHelper(helpers.ATOM_VALUE)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      return ()
    }
    if op == Op.ConstVal {
      let p = self.plan
      let f = p.f
      let index = i32.wrappingToU32(inst.k)
      run self.a.load(Width.W64, Reg.Rcx, p.sf(f.currentFunction + 8))
      if !p.known { run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.Rcx, signed(f.closureBytecode))) }
      run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.Rcx, signed(p.constantsWord)))
      let at = p.constantsDelta + signed(index * 16)
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rcx, at))
      run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rcx, at + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      if function.value(inst.result).own != Own.Borrowed { run self.retainBits(Reg.Rax, Reg.R9) }
      self.setFresh(inst.result)
      return ()
    }
    if op == Op.PutField {
      run self.stressGuard(inst.exit)
      let slow = run self.a.label()
      let done = run self.a.label()
      // Inline (writeOwnField): the old value's count drops unless it is the last one.
      let kept = run self.a.label()
      let key = self.shapes.key(self.cursor)
      let several = self.shapes.read(self.cursor)
      if key != 0 || several != 0 {
