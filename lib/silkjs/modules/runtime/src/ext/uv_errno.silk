    60 => b"EPIPE\0"
    61 => b"EPROTO\0"
    62 => b"EPROTONOSUPPORT\0"
    63 => b"EPROTOTYPE\0"
    64 => b"ERANGE\0"
    65 => b"EROFS\0"
    66 => b"ESHUTDOWN\0"
    67 => b"ESPIPE\0"
    68 => b"ESRCH\0"
    69 => b"ETIMEDOUT\0"
    70 => b"ETXTBSY\0"
    71 => b"EXDEV\0"
    72 => b"UNKNOWN\0"
    73 => b"EOF\0"
    74 => b"ENXIO\0"
    75 => b"EMLINK\0"
    76 => b"EHOSTDOWN\0"
    77 => b"EREMOTEIO\0"
    78 => b"ENOTTY\0"
    79 => b"EFTYPE\0"
    80 => b"EILSEQ\0"
