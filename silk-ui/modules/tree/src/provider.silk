//! The measurement provider css-layout calls during layout: text through ui-text, natural sizes
//! of image and icon nodes, overlay scrollbars that reserve no space.
import layout_table { LayoutView }
import mutation { ScrollbarWidth, ScrollbarGutter }
import ui_text.system { TextSystem }
import layout.lib {
  TextMeasure,
  TextContext,
  TextBreak,
  TextAnalysis,
  TextShapeRequest,
  TextRun,
  TextError,
  FontRequest,
  FontMetrics,
  Measure,
  MeasureRequest,
  Measured,
  NaturalDimensions,
  ScrollbarRequest,
  ScrollbarMetrics,
  Size,
  Rect,
  BaselineSet,
  runLayoutChunk,
  runFlexPrepareChunk
}
import silk.collections.list { List }
import silk.concurrency.sync { Arc }
import silk.concurrency.thread { Concurrent, Transferable }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import ui_transport.pool { WorkPoolHandle }

static if Intrinsic.targetArchitecture() != "wasm32" {
  import silk.core.effect { Effect }
  import silk.system.monotonic_clock { MonotonicClock }
  import silk.system.monotonic_clock_native { OsMonotonicClock }
}

/// Returns current monotonic time in nanoseconds (0 on wasm32).
pub fn nowNs() -> u64 {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    return 0
  } else {
    let mut clock = OsMonotonicClock.make()
    let now = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    let ns = now.seconds() * 1000000000 + u32.toI64(now.subsecondNanoseconds())
    return if ns > 0 { i64.toU64(ns) } else { 0 }
  }
}

struct ParallelLayoutCtx {
  ctx: *const u8,
}

impl Transferable for ParallelLayoutCtx {}
impl Concurrent for ParallelLayoutCtx {}

fn runTreeLayoutChunk(shared: &ParallelLayoutCtx, chunkIdx: usize) -> () {
  runLayoutChunk<Provider<'static>, LayoutView<'static>>(shared.ctx, chunkIdx)
}

fn runTreeFlexPrepareChunk(shared: &ParallelLayoutCtx, chunkIdx: usize) -> () {
  runFlexPrepareChunk<Provider<'static>, LayoutView<'static>>(shared.ctx, chunkIdx)
}

/// Bridges css-layout intrinsic measurement and parallel worker execution onto `TextSystem` and `EnginePool`.
pub struct Provider<'a> {
  pub text: TextSystem<'a>,
  /// Natural sizes by measurement key (the node's slot).
  pub naturals: List<NaturalDimensions>,
  /// Accumulated nanoseconds inside `TextMeasure.analyze` since `resetTimers`.
  pub analyzeNs: u64,
  /// Accumulated nanoseconds inside `TextMeasure.shape` since `resetTimers`.
  pub shapeNs: u64,
  /// Optional engine pool handle used for parallel subtree layout.
  pub enginePool: Option<WorkPoolHandle>,
  /// Work group id within `enginePool`.
  pub engineGroupId: u32,
  /// Count of subtrees laid out in parallel during the current frame.
  pub parallelLaidOut: u32,
  baseFontKeys: usize,
}

impl<'a> Provider<'a> {
  /// Constructs a provider wrapping `text` with zeroed timers and no worker pool attached.
  pub fn make(text: TextSystem<'a>) -> Provider<'a> {
    return Provider<'a> {
      text: move text,
      naturals: List<NaturalDimensions>.make(),
      analyzeNs: 0,
      shapeNs: 0,
      enginePool: Option<WorkPoolHandle>.None,
      engineGroupId: 0,
      parallelLaidOut: 0,
      baseFontKeys: 0,
    }
  }

  /// Resets per-frame text timing accumulators and parallel layout counters.
  pub fn resetTimers(self: &mut Self) -> () {
    self.analyzeNs = 0
    self.shapeNs = 0
    self.parallelLaidOut = 0
  }

  /// Returns how many worker threads are available for parallel subtree layout, or 0 when disabled.
  pub fn parallelWorkers(self: &Self) -> usize {
    if !self.text.canForkForWorker() {
      return 0
    }
    return match &self.enginePool {
      Option<WorkPoolHandle>.Some { value: pool } => pool.workerCount()
      Option<WorkPoolHandle>.None => 0
    }
  }

  /// Sets the natural size of measurement key `key`.
  pub effect fn setNatural(self: &mut Self, key: usize, natural: NaturalDimensions) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while self.naturals.length() <= key {
      run self.naturals.append(NaturalDimensions.none())
    }
    self.naturals.set(key, natural)
  }
}

impl<'a> TextMeasure for Provider<'a> {
  fn beginTextLayout(provider: &mut Self) {
    TextMeasure.beginTextLayout(&mut provider.text)
  }

  fn plainText(provider: &Self) -> bool {
    return TextMeasure.plainText(&provider.text)
  }

  fn reportsBreakSafety(provider: &Self) -> bool {
    return TextMeasure.reportsBreakSafety(&provider.text)
  }

  effect fn analyze(
    provider: &mut Self,
    context: TextContext<'_, '_>,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    let start = nowNs()
    let out = run TextMeasure.analyze(&mut provider.text, context, &mut output)
    let end = nowNs()
    if end > start {
      provider.analyzeNs = provider.analyzeNs + (end - start)
    }
    return move out
  }

  effect fn shape(
    provider: &mut Self,
    request: TextShapeRequest<'_, '_>,
    output: &mut List<TextRun>,
  )
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    let start = nowNs()
    run TextMeasure.shape(&mut provider.text, request, &mut output)
    let end = nowNs()
    if end > start {
      provider.shapeNs = provider.shapeNs + (end - start)
    }
  }
}

impl<'a> Measure for Provider<'a> {
  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    return Measured {
      size: Size { width: 0.0, height: 0.0 },
      contentBlockSize: 0.0,
      firstBaselines: BaselineSet.zero(),
      lastBaselines: BaselineSet.zero(),
      hasBaseline: false,
      hasLineBoxes: false,
      scrollableOverflow: Rect.zero(),
    }
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    if key < provider.naturals.length() {
      return provider.naturals.get(key)
    }
    return NaturalDimensions.none()
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    let thickness: f32 = if request.width == ScrollbarWidth.None {
      0.0
    } else if request.width == ScrollbarWidth.Thin {
      6.0
    } else {
      10.0
    }
    return ScrollbarMetrics {
      horizontal: thickness,
      vertical: thickness,
      overlay: request.gutter == ScrollbarGutter.Auto,
      horizontalOnTop: false,
      verticalOnLeft: false,
    }
  }

  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    return TextSystem.font(&provider.text, request)
  }

  fn parallelWorkers(provider: &Self) -> usize {
    return provider.parallelWorkers()
  }

  effect fn forkForWorker(provider: &Self) -> Option<Self> ! OutOfMemoryError ? &mut Allocator {
    if !provider.text.canForkForWorker() {
      return Option<Self>.None
    }
    let mut naturals = List<NaturalDimensions>.make()
    run naturals.appendSlice(provider.naturals.asSlice())
    let text = run provider.text.forkForWorker()
    return Option<Self>.some(
      Provider<'a> {
        text: move text,
        naturals: move naturals,
        analyzeNs: 0,
        shapeNs: 0,
        enginePool: Option<WorkPoolHandle>.None,
        engineGroupId: 0,
        parallelLaidOut: 0,
        baseFontKeys: provider.text.fonts.keyCount(),
      },
    )
  }

  effect fn mergeWorker(
    provider: &mut Self,
    worker: Self,
    fontKeyRemap: &mut List<usize>,
    shapeKeyRemap: &mut List<u32>,
  ) -> () ! OutOfMemoryError ? &mut Allocator {
    run provider.text.mergeWorker(move worker.text, worker.baseFontKeys, &mut fontKeyRemap, &mut shapeKeyRemap)
  }

  effect fn dispatchParallel(
    provider: &mut Self,
    chunkCount: usize,
    ctx: *const u8,
  ) -> bool ! OutOfMemoryError ? &mut Allocator {
    match &provider.enginePool {
      Option<WorkPoolHandle>.Some { value: pool } => {
        if pool.workerCount() <= 1 {
          return false
        }
        let shared = run Arc<ParallelLayoutCtx>.make(ParallelLayoutCtx { ctx: ctx })
        run pool.runParallel(provider.engineGroupId, chunkCount, move shared, runTreeLayoutChunk)
        return true
      }
      Option<WorkPoolHandle>.None => { return false }
    }
  }

  effect fn dispatchFlexPrepare(
    provider: &mut Self,
    chunkCount: usize,
    ctx: *const u8,
  ) -> bool ! OutOfMemoryError ? &mut Allocator {
    match &provider.enginePool {
      Option<WorkPoolHandle>.Some { value: pool } => {
        if pool.workerCount() <= 1 {
          return false
        }
        let shared = run Arc<ParallelLayoutCtx>.make(ParallelLayoutCtx { ctx: ctx })
        run pool.runParallel(provider.engineGroupId, chunkCount, move shared, runTreeFlexPrepareChunk)
        return true
      }
      Option<WorkPoolHandle>.None => { return false }
    }
  }

  fn noteParallelLaidOut(provider: &mut Self, count: usize) -> () {
    provider.parallelLaidOut = provider.parallelLaidOut + usize.toU32(count)
  }
}
