//! CSS Motion Path: `offset-*` place a box along a path where Chromium places it. Every expected
//! client rect was measured in Chromium on the same page: a 200 by 100 containing block at
//! (50, 40) with a 5px border and 10px padding, holding a 20 by 10 box at margins (30, 20).
import ui_tree.cssom_view as view
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, FrameInput, StyleState, Mutation, Keyframe }
import ui_fixtures.fixtures as fixtures
import svg_css.written
import svg_css.tokens { CssError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.testing.testing { Testing, AssertionError }

fn moment(time: f64) -> FrameInput {
  return FrameInput { width: 400.0, height: 400.0, scale: 1.0, time: time }
}

fn close(a: f64, b: f32) -> bool {
  return f32.abs(f64.toF32(a) - b) <= 0.6
}

/// Restyles the box with the base style plus `style`.
effect fn restyle<'f>(tree: &mut UiTree<'f>, style: &[u8]) -> () ! TreeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  run text.append(b"width:20px;height:10px;margin-left:30px;margin-top:20px;")
  run text.append(style)
  let declarations = run written.declarations(text.asSlice())
  let mut batch = Batch.make()
  run batch.push(Mutation.ClearStyle { id: 3, state: StyleState.Base })
  run batch.style(3, declarations.asSlice())
  run tree.apply(run batch.take())
}

/// The client rect of the box styled `style`, against Chromium's (x, y, width, height).
effect fn expectRect<'f>(tree: &mut UiTree<'f>, style: &[u8], expected: [f32; 4], message: string<'static>) -> ()
  ! AssertionError<'static> | TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  run restyle(&mut tree, style)
  run tree.frame(moment(0.0))
  let rect = run view.getBoundingClientRect(&tree, 3)
  run Testing.expect(close(rect.x, expected[0]) && close(rect.y, expected[1]) && close(rect.width, expected[2]) && close(rect.height, expected[3]), message)
}

effect fn page<'f>(tree: &mut UiTree<'f>) -> () ! TreeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"width:400px;height:400px")
  run batch.style(1, root.asSlice())
  let block = run written.declarations(b"position:relative;left:50px;top:40px;width:200px;height:100px;padding:10px;border:5px solid black;display:flow-root")
  run batch.box(1, 2, block.asSlice())
  let inner = run written.declarations(b"width:20px;height:10px;margin-left:30px;margin-top:20px")
  run batch.box(2, 3, inner.asSlice())
  run tree.apply(run batch.take())
}

effect fn placements() -> () ! AssertionError<'static> | TreeError | CssError | OutOfMemoryError ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run page(&mut tree)
  run expectRect(&mut tree, b"", [95.0, 75.0, 20.0, 10.0], "no path: where layout put it")
  run expectRect(&mut tree, b"offset-path:path('M 0 0 L 100 0')", [85.0, 70.0, 20.0, 10.0], "path() starts at the box's own corner, centered on it")
  run expectRect(&mut tree, b"offset-path:path('M 0 0 L 100 0');offset-distance:50%", [135.0, 70.0, 20.0, 10.0], "a percentage of the path's length")
  run expectRect(&mut tree, b"offset-path:path('M 10 10 L 100 10');offset-rotate:0deg", [95.0, 80.0, 20.0, 10.0], "the path's start point")
  run expectRect(&mut tree, b"offset-path:path('M0 0 L0 100');offset-distance:30px", [90.0, 95.0, 10.0, 20.0], "auto turns along the path")
  run expectRect(&mut tree, b"offset-path:path('M0 0 L100 0');offset-distance:150%", [185.0, 70.0, 20.0, 10.0], "an open path clamps")
  run expectRect(&mut tree, b"offset-path:path('M0 0 L100 0 L100 100 Z');offset-distance:350px;offset-rotate:0deg", [93.58, 70.0, 20.0, 10.0], "a closed path wraps around")
  run expectRect(&mut tree, b"offset-path:path('M0 0 L100 0 L100 100');offset-distance:350px;offset-rotate:0deg", [185.0, 170.0, 20.0, 10.0], "an open path ends at its end")
  run expectRect(&mut tree, b"offset-path:path('M0 0 L100 0');offset-rotate:auto 90deg", [90.0, 65.0, 10.0, 20.0], "auto plus an angle")
  run expectRect(&mut tree, b"offset-path:path('M 0 0 L 100 0');offset-anchor:0 0", [95.0, 75.0, 20.0, 10.0], "offset-anchor picks the point on the path")
  run expectRect(&mut tree, b"offset-path:path('M0 0 L100 0');transform-origin:0 0;offset-anchor:100% 0;offset-distance:50%", [125.0, 75.0, 20.0, 10.0], "an anchor apart from the origin")
  run expectRect(&mut tree, b"offset-path:path('M0 0 L100 0');transform:rotate(90deg);offset-distance:50%", [140.0, 65.0, 10.0, 20.0], "transform applies after the path")
  run expectRect(&mut tree, b"offset:path('M0 0 L100 0') 50% 0deg / 0 0", [145.0, 75.0, 20.0, 10.0], "the offset shorthand")
  run expectRect(&mut tree, b"offset-path:ray(90deg)", [155.0, 100.0, 20.0, 10.0], "a ray starts at the containing block's center")
  run expectRect(&mut tree, b"offset-path:ray(90deg);offset-distance:50%", [187.5, 100.0, 20.0, 10.0], "against the closest side of its border box")
  run expectRect(&mut tree, b"offset-path:ray(0deg farthest-corner);offset-distance:100%;offset-rotate:0deg", [155.0, -32.1, 20.0, 10.0], "farthest-corner")
  run expectRect(&mut tree, b"offset-path:ray(90deg sides);offset-distance:100%", [270.0, 100.0, 20.0, 10.0], "sides")
  run expectRect(&mut tree, b"offset-path:ray(45deg contain);offset-distance:100%", [193.28, 55.5, 21.21, 21.21], "contain keeps the box inside")
  run expectRect(&mut tree, b"offset-path:ray(90deg);offset-distance:-20px", [135.0, 100.0, 20.0, 10.0], "a ray goes back for a negative distance")
  run expectRect(&mut tree, b"offset-path:ray(90deg);offset-position:auto", [85.0, 70.0, 20.0, 10.0], "offset-position: auto starts at the box")
  run expectRect(&mut tree, b"offset-path:ray(90deg);offset-position:0 0", [40.0, 35.0, 20.0, 10.0], "offset-position against the reference box")
  run expectRect(&mut tree, b"offset-path:ray(90deg);offset-position:50% 50%;offset-distance:10px", [165.0, 100.0, 20.0, 10.0], "a centered position")
  run expectRect(&mut tree, b"offset-path:ray(90deg at 0 0)", [40.0, 35.0, 20.0, 10.0], "ray(at) starts there")
  run expectRect(&mut tree, b"offset-path:circle(50px)", [210.0, 95.0, 10.0, 20.0], "a circle starts at its right, heading down")
  run expectRect(&mut tree, b"offset-path:circle(50px);offset-distance:25%", [155.0, 150.0, 20.0, 10.0], "and runs clockwise")
  run expectRect(&mut tree, b"offset-path:ellipse(50px 20px);offset-distance:25%", [155.0, 120.0, 20.0, 10.0], "an ellipse")
  run expectRect(&mut tree, b"offset-path:circle(50px) content-box;offset-rotate:0deg", [205.0, 100.0, 20.0, 10.0], "a shape in the content box")
  run expectRect(&mut tree, b"offset-path:inset(0)", [40.0, 35.0, 20.0, 10.0], "inset() starts at the top left corner")
  run expectRect(&mut tree, b"offset-path:inset(10px round 20px);offset-rotate:0deg", [70.0, 45.0, 20.0, 10.0], "after its rounding")
  run expectRect(&mut tree, b"offset-path:xywh(10px 10px 50px 50px);offset-rotate:0deg", [50.0, 45.0, 20.0, 10.0], "xywh()")
  run expectRect(&mut tree, b"offset-path:polygon(0 0, 100% 0, 100% 100%);offset-distance:50%;offset-rotate:0deg", [270.0, 117.1, 20.0, 10.0], "polygon()")
  run expectRect(&mut tree, b"offset-path:border-box", [40.0, 35.0, 20.0, 10.0], "a box alone is its rectangle")
  run expectRect(&mut tree, b"offset-path:content-box;offset-rotate:0deg", [55.0, 50.0, 20.0, 10.0], "the content box")
  run expectRect(&mut tree, b"offset-path:none;offset-distance:50%", [95.0, 75.0, 20.0, 10.0], "none goes back")
}

test effect fn motionPathPlacesLikeChromium() -> () ! AssertionError<'static> | TreeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run placements() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn motion() -> () ! AssertionError<'static> | TreeError | CssError | OutOfMemoryError ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run page(&mut tree)
  run restyle(&mut tree, b"offset-path:path('M0 0 L100 0');offset-distance:0%;transition:offset-distance 1s linear")
  run tree.frame(moment(0.0))
  run restyle(&mut tree, b"offset-path:path('M0 0 L100 0');offset-distance:100%;transition:offset-distance 1s linear")
  run tree.frame(moment(1.0))
  run tree.frame(moment(1.5))
  let half = run view.getBoundingClientRect(&tree, 3)
  run Testing.expect(close(half.x, 135.0) && close(half.y, 70.0), "offset-distance transitions along the path")
  run tree.frame(moment(3.0))
  let done = run view.getBoundingClientRect(&tree, 3)
  run Testing.expect(close(done.x, 185.0), "and ends at its end")

  let mut frames = List<Keyframe>.make()
  let start = run written.declarations(b"offset-distance:0%")
  run frames.append(Keyframe { offset: 0.0, declarations: move start })
  let end = run written.declarations(b"offset-distance:100%")
  run frames.append(Keyframe { offset: 1.0, declarations: move end })
  let mut batch = Batch.make()
  run batch.keyframes("along", move frames)
  run tree.apply(run batch.take())
  run restyle(&mut tree, b"offset-path:ray(90deg);animation:along 2s linear")
  run tree.frame(moment(10.0))
  run tree.frame(moment(11.0))
  let mid = run view.getBoundingClientRect(&tree, 3)
  run Testing.expect(close(mid.x, 187.5) && close(mid.y, 100.0), "keyframes move it along a ray")
}

test effect fn motionPathTransitions() -> () ! AssertionError<'static> | TreeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run motion() |> Effect.provideMut<Allocator>(&mut allocator)
}

