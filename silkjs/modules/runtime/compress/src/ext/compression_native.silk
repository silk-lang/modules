/// `[zlib, brotli, zstd]`: the libraries' versions for `process.versions`, brotli's packed as
/// major << 24 | minor << 12 | patch. zlib's is the release ext.zlib_stream reproduces.
unsafe effect fn versions<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory
  let output = run unsafe common.array(&mut engine, memory, context)
  let zlibText = zs.VERSION_TEXT
  let zlib = run text.cstring(&mut engine, unsafe lendRealm(&context, context), Pointer.fromRef<u8>(&zlibText[0]))
  run unsafe common.defineIndex(&mut engine, context, output, 0, zlib.intoBits())
  run unsafe common.defineIndex(&mut engine, context, output, 1, ValueBits.number(u32.toF64(unsafe c.BrotliDecoderVersion())))
  let zstdText = run text.cstring(&mut engine, unsafe lendRealm(&context, context), zstd.versionString())
  run unsafe common.defineIndex(&mut engine, context, output, 2, zstdText.intoBits())
  return output
}
pub unsafe effect fn dispatch<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  // A call with no arguments asks for the versions.
  if argc == 0 { return run unsafe versions(&mut engine, context) }
  let p = run newJob() let mut anchor = () let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p)
  let prepared = run Effect.result(unsafe prepare(&mut engine, context, state, &mut j, argv)) drop j
  match move prepared { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe dropJob(&mut engine, context, p) fail move error } }
  let j2 = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p) let converted = run Effect.result(unsafe synchronous(&mut engine, context, state, &mut j2)) drop j2 unsafe dropJob(&mut engine, context, p)
  return match move converted { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
// Runs on a blocking worker.
export "C" fn silkCompressionWork(data: ?*mut u8) -> () {
  let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(data)) let mut anchor = () let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p) unsafe execute(&mut j)
}
export "C" fn silkCompressionAfterWork(data: ?*mut u8) -> () {
  let p = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(data)) let mut anchor = () let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p) j.done = true
}
pub unsafe effect fn submit<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, io: *mut fs_async.State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
