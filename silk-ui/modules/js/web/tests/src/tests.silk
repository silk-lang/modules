//! The calls the page's `__ui` writes (browser/js-host.js), decoded into the tree.
import ui_js_web.wire as wire
import ui_tree.lib { Tree, TreeError, ProtocolError, NodeId }
import ui_tree.legacy { Batch, Keyframe, Mutation }
import ui_fixtures.fixtures as fixtures
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u64
import silk.num.f64
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

/// Writes calls as js-host.js `Calls` does.
struct Calls {
  bytes: List<u8>,
}

impl Calls {
  effect fn word(self: &mut Self, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut i: u32 = 0
    while i < 4 {
      run self.bytes.append(u32.toU8(u32.bitAnd(u32.shiftRight(value, i * 8), 255)))
      i = i + 1
    }
  }

  effect fn op(self: &mut Self, code: u8, id: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.bytes.append(code)
    run self.word(id)
  }

  effect fn number(self: &mut Self, value: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    let bits = f64.toBits(value)
    run self.word(u64.toU32(u64.bitAnd(bits, 4294967295)))
    run self.word(u64.toU32(u64.shiftRight(bits, 32)))
  }

  effect fn text(self: &mut Self, value: string) -> () ! OutOfMemoryError ? &mut Allocator {
    let bytes = String.utf8Bytes(value)
    run self.word(usize.toU32(bytes.length))
    run self.bytes.appendSlice(bytes)
  }
}

import silk.num.usize

effect fn decoded() -> () ! TreeError | ProtocolError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut calls = Calls { bytes: List<u8>.make() }
  run calls.op(wire.CREATE, 1)
  run calls.word(0)
  run calls.op(wire.CREATE, 2)
  run calls.word(1)
  run calls.op(wire.ROOT, 1)
  run calls.op(wire.APPEND, 1)
  run calls.word(2)
  run calls.op(wire.SET_TEXT, 2)
  run calls.text("h\u{e9}llo")
  run calls.op(wire.STYLE, 1)
  run calls.word(0)
  run calls.text("width: 120px; height: 40px")
  run calls.op(wire.ATTRIBUTE, 1)
  run calls.text("tabIndex")
  run calls.bytes.append(1)
  run calls.number(3.0)
  run calls.op(wire.ATTRIBUTE, 1)
  run calls.text("role")
  run calls.bytes.append(2)
  run calls.text("nope button")
  run calls.op(wire.ATTRIBUTE, 2)
  run calls.text("role")
  run calls.bytes.append(2)
  run calls.text("nothing")
  // Keyframes carry no node id.
  run calls.bytes.append(wire.KEYFRAME)
  run calls.number(0.0)
  run calls.text("opacity: 0")
  run calls.bytes.append(wire.KEYFRAMES)
  run calls.text("fade")

  let mut batch = Batch.make()
  let mut frames = List<Keyframe>.make()
  let unknown = run wire.decode(calls.bytes.asSlice(), &mut batch, &mut frames)
  run Testing.expect(frames.length() == 0, "@keyframes took its frames")
  run Testing.expect(unknown.length() == 1, "one role text the tree does not have")
  run Testing.expect(String.view(&unknown.asSlice()[0].value) == "nothing", "the report names it")

  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  run tree.apply(run batch.take())
  let text = match tree.view(NodeId.of(2)) {
    Option.Some { value } => value.text() == "h\u{e9}llo"
    Option.None => false
  }
  run Testing.expect(text, "the text node holds the UTF-8 text")
  let tab = match tree.view(NodeId.of(1)) {
    Option.Some { value } => value.tabIndex() == 3
    Option.None => false
  }
  run Testing.expect(tab, "a number attribute arrives as a number")
}

test effect fn pageCallsDecodeIntoTheTree() -> () ! TreeError | ProtocolError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run decoded() |> Effect.provideMut<Allocator>(&mut allocator)
}


import ui_js_calls.stylesheet_compiler { runtime }
import ui_js_calls.stylesheets { encoded }
import ui_tree.lib { Viewport }

effect fn compiledSheets() -> () ! TreeError | ProtocolError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let compiler = runtime()
  let compiled = compiler.call(b"div{width:123px;height:20px}")
  let bytes = match move compiled {
    Option.Some { value } => move value
    Option.None => { run Testing.expect(false, "fixture compiles") return () }
  }
  let text = run encoded(bytes.asSlice())
  let mut calls = Calls { bytes: List<u8>.make() }
  run calls.op(wire.CREATE, 1)
  run calls.word(0)
  run calls.op(wire.ROOT, 1)
  run calls.op(wire.STYLE_SHEET, 1)
  run calls.word(55)
  run calls.text(String.view(&text))
  let mut batch = Batch.make()
  let mut frames = List<Keyframe>.make()
  drop run wire.decode(calls.bytes.asSlice(), &mut batch, &mut frames)
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  run tree.apply(run batch.take())
  drop run tree.frame(Viewport { width: 400.0, height: 300.0, scale: 1.0 }, 0.0)
  run Testing.expect(match tree.view(NodeId.of(1)) { Option.Some { value } => value.computed().layout.width.value == 123.0 Option.None => false }, "browser wire adopts compiled CSS in root 0")
  calls.bytes.clear()
  run calls.op(wire.STYLE_SHEET, 2)
  run calls.word(55)
  run calls.text("invalid")
  drop run wire.decode(calls.bytes.asSlice(), &mut batch, &mut frames)
  run Testing.expect(batch.length() == 0, "invalid compiled wire data cannot replace the active sheet")
  calls.bytes.clear()
  run calls.op(wire.STYLE_SHEET, 3)
  run calls.word(55)
  run calls.text("")
  drop run wire.decode(calls.bytes.asSlice(), &mut batch, &mut frames)
  run tree.apply(run batch.take())
  drop run tree.frame(Viewport { width: 400.0, height: 300.0, scale: 1.0 }, 0.1)
  run Testing.expect(match tree.view(NodeId.of(1)) { Option.Some { value } => value.computed().layout.width.value != 123.0 Option.None => false }, "browser wire removes an adopted sheet")
}

test effect fn compiledSheetsCrossTheBrowserWire() -> () ! TreeError | ProtocolError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run compiledSheets() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn canvasSurfaces() -> () ! TreeError | ProtocolError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut calls = Calls { bytes: List<u8>.make() }
  run calls.op(wire.CREATE, 1)
  run calls.word(0)
  run calls.op(wire.CREATE, 2)
  run calls.word(5)
  run calls.op(wire.ROOT, 1)
  run calls.op(wire.APPEND, 1)
  run calls.word(2)
  run calls.op(wire.STYLE, 1)
  run calls.word(0)
  run calls.text("display: flex; align-items: flex-start; width: 2000px; height: 1000px")
  run calls.op(wire.SURFACE, 2)
  run calls.word(7)
  run calls.word(640)
  run calls.word(400)
  run calls.bytes.append(1)
  // A frame of the canvas changes nothing in the tree.
  run calls.op(wire.CANVAS_FRAME, 2)
  let mut batch = Batch.make()
  let mut frames = List<Keyframe>.make()
  drop run wire.decode(calls.bytes.asSlice(), &mut batch, &mut frames)
  let mutations = run batch.take()
  let items = mutations.asSlice()
  let mut shown = false
  let mut surfaces: u32 = 0
  let mut i: usize = 0
  while i < items.length {
    if let Mutation.SetCanvasSurface { id, surface, width, height, opaque } = &items[i] {
      surfaces = surfaces + 1
      shown = id == 2 && surface == 7 && width == 640 && height == 400 && opaque
    }
    i = i + 1
  }
  run Testing.expect(shown, "the canvas shows the page's surface at its size")
  run Testing.expect(surfaces == 1, "a frame of the canvas is no mutation")
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  run tree.apply(move mutations)
}

test effect fn pageCanvasShowsItsSurface() -> () ! TreeError | ProtocolError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run canvasSurfaces() |> Effect.provideMut<Allocator>(&mut allocator)
}

