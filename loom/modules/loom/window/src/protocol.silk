//! Cross-thread protocol between the Engine (`UiTree`) thread and the App (`Runtime`) thread.
import loom.shell { Menu, Tray }
import loom_inspect.lib { ProgramReport }
import ui_protocol.mutation { Mutation }
import ui_protocol.record { Event as TreeEvent }
import ui_protocol.root { RootEvent }
import ui_protocol.snapshot { FrameSnapshot }
import ui_transport.channel { UnboundedSender }
import ui_transport.pool { PoolHandles }
import ui_tree_window.platform_thread { Nudge, PlatformClient }
import silk.collections.list { List }
import silk.concurrency.sync { Arc, Mutex }
import silk.concurrency.thread { Concurrent, Transferable }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// Window-shell actions sent from the App thread to the Engine thread for execution on `HostPlatform`.
pub union ShellCommand {
  Title { pub text: String },
  Size { pub width: f64, pub height: f64 },
  Minimize,
  FullScreen,
  Copy { pub text: String },
  SetMenu { pub menu: Menu },
  OpenFile { pub request: u32, pub title: String, pub extensions: String, pub multiple: bool, pub directories: bool },
  SaveFile { pub request: u32, pub title: String, pub name: String, pub extensions: String },
  SetTray { pub tray: Tray },
  RemoveTray,
  Shortcut { pub id: u32, pub code: String, pub modifiers: u32 },
  Unshortcut { pub id: u32 },
  Notify { pub id: u32, pub title: String, pub body: String },
  Quit,
}

impl Transferable for ShellCommand {}

/// Window-shell notifications delivered from the Engine thread to the App thread (`PORT_*`).
pub union ShellEvent {
  MenuAction { pub action: u32 },
  DialogClosed { pub request: u32, pub paths: List<String> },
  DragEntered { pub x: f64, pub y: f64 },
  DragMoved { pub x: f64, pub y: f64 },
  DragLeft,
  Dropped { pub x: f64, pub y: f64, pub paths: List<String> },
  GlobalShortcut { pub id: u32 },
  TrayClicked { pub button: u32 },
  NotificationClicked { pub id: u32 },
  AppearanceChanged { pub dark: bool },
  Focused { pub focused: bool },
  CloseRequested,
  Resized { pub width: f64, pub height: f64 },
  TreeKeeperState { pub digest: u64, pub treeJson: String },
}

impl Transferable for ShellEvent {}

/// Initial Engine window state handed to the App thread on startup.
pub struct EngineReadyInfo {
  pub width: f64,
  pub height: f64,
  pub dark: bool,
  pub inspectorEnabled: bool,
  pub groupId: u32,
}

impl Transferable for EngineReadyInfo {}
impl Concurrent for EngineReadyInfo {}

/// Messages sent from the App (`Runtime`) thread to the Engine (`UiTree`) thread.
pub union AppToEngine {
  Commit {
    pub seq: u64,
    pub needsFrame: bool,
    pub wantsFrames: bool,
    pub interceptClose: bool,
    pub mutations: List<Mutation>,
  },
  Shell { pub command: ShellCommand },
  Inspect { pub report: ProgramReport },
  Shutdown,
}

impl Transferable for AppToEngine {}

/// Messages sent from the Engine (`UiTree`) thread to the App (`Runtime`) thread.
pub union EngineToApp {
  Ready { pub info: EngineReadyInfo, pub snapshot: FrameSnapshot },
  Services { pub groupId: u32, pub pools: PoolHandles, pub platform: Option<PlatformClient> },
  Snapshot { pub snapshot: FrameSnapshot },
  Events { pub events: List<TreeEvent>, pub rootEvents: List<RootEvent>, pub snapshot: FrameSnapshot },
  Tick { pub time: f64, pub animation: bool },
  Resize { pub width: f32, pub height: f32 },
  Shell { pub event: ShellEvent },
  InspectorState { pub enabled: bool },
  RestoreModel { pub json: String, pub label: String },
  Closed { pub exitCode: i32 },
}

impl Transferable for EngineToApp {}

struct WakeTarget {
  nudge: Option<Nudge>,
  closed: bool,
}

impl Transferable for WakeTarget {}

/// Late-bound wakeup handle for nudging the Engine thread's event loop once opened.
pub struct EngineWakeSlot {
  inner: Arc<Mutex<WakeTarget>>,
}

impl Transferable for EngineWakeSlot {}
impl Concurrent for EngineWakeSlot {}

impl EngineWakeSlot {
  pub effect fn make() -> EngineWakeSlot
    ! OutOfMemoryError {
    let mut heap = Allocator.systemAllocatorProvider()
    let target = WakeTarget { nudge: Option<Nudge>.None, closed: false }
    let mutex = run Mutex<WakeTarget>.make(move target) |> Effect.provideMut<Allocator>(&mut heap)
    let arc = run Arc<Mutex<WakeTarget>>.make(move mutex) |> Effect.provideMut<Allocator>(&mut heap)
    return EngineWakeSlot { inner: move arc }
  }

  pub fn clone(self: &Self) -> EngineWakeSlot {
    return EngineWakeSlot { inner: self.inner.clone() }
  }

  /// Stores `nudge` as the active wakeup handle unless already closed; wakes immediately in case
  /// App messages were already enqueued prior to attach.
  pub fn attach(self: &Self, nudge: Nudge) -> () {
    let mut guard = self.inner.get().lock()
    let target = guard.getMut()
    if !target.closed {
      let wakeNow = nudge.clone()
      target.nudge = Option<Nudge>.some(move nudge)
      drop guard
      wakeNow.nudge()
    }
  }

  /// Marks the slot closed so late senders do not hold or call stale nudges.
  pub fn close(self: &Self) -> () {
    let mut guard = self.inner.get().lock()
    let target = guard.getMut()
    target.closed = true
    target.nudge = Option<Nudge>.None
  }

  /// Wakes the Engine thread if an active nudge is registered.
  pub fn nudge(self: &Self) -> () {
    let guard = self.inner.get().lock()
    if let Option<Nudge>.Some { value } = &guard.get().nudge {
      let handle = value.clone()
      drop guard
      handle.nudge()
    }
  }
}

/// Shareable sender from App / worker threads into the Engine thread (`UnboundedSender` + wake).
pub struct AppToEngineTx {
  tx: UnboundedSender<AppToEngine>,
  wake: EngineWakeSlot,
}

impl Transferable for AppToEngineTx {}
impl Concurrent for AppToEngineTx {}

impl AppToEngineTx {
  pub fn make(tx: UnboundedSender<AppToEngine>, wake: EngineWakeSlot) -> AppToEngineTx {
    return AppToEngineTx { tx: move tx, wake: move wake }
  }

  pub fn clone(self: &Self) -> AppToEngineTx {
    return AppToEngineTx { tx: self.tx.clone(), wake: self.wake.clone() }
  }

  /// Enqueues `msg` for the Engine thread and nudges its event loop. Returns false if closed/OOM.
  pub fn send(self: &Self, msg: AppToEngine) -> bool {
    let sent = match move run Effect.result(self.tx.send(move msg)) {
      Result.Success { .. } => true
      Result.Failure { error } => {
        drop error
        false
      }
    }
    if sent {
      self.wake.nudge()
    }
    return sent
  }
}
