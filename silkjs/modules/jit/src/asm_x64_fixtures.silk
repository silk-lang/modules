  run Testing.expect(emitted(&a, &mut at, b"\x43\x0f\xb7\x2c\x07"), "movzx ebp, word ptr [r15 + r8*1]")
  run a.loadSigned32(Reg.Rbp, Mem.indexed(Reg.R15, Reg.R8, Scale.One, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4b\x63\x2c\x07"), "movsxd rbp, dword ptr [r15 + r8*1]")
  run a.loadSigned8(Reg.Rbp, Mem.indexed(Reg.R15, Reg.R8, Scale.One, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x43\x0f\xbe\x2c\x07"), "movsx ebp, byte ptr [r15 + r8*1]")
  run a.loadSigned16(Reg.Rbp, Mem.indexed(Reg.R15, Reg.R8, Scale.One, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x43\x0f\xbf\x2c\x07"), "movsx ebp, word ptr [r15 + r8*1]")
  run a.store8(Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x46\x88\x14\x7f"), "mov byte ptr [rdi + r15*2], r10b")
  run a.store16(Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x46\x89\x14\x7f"), "mov word ptr [rdi + r15*2], r10w")
  run a.loadZero8(Reg.R8, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x46\x0f\xb6\x04\x7f"), "movzx r8d, byte ptr [rdi + r15*2]")
  run a.loadZero16(Reg.R8, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x46\x0f\xb7\x04\x7f"), "movzx r8d, word ptr [rdi + r15*2]")
  run a.loadSigned32(Reg.R8, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4e\x63\x04\x7f"), "movsxd r8, dword ptr [rdi + r15*2]")
  run a.loadSigned8(Reg.R8, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x46\x0f\xbe\x04\x7f"), "movsx r8d, byte ptr [rdi + r15*2]")
  run a.loadSigned16(Reg.R8, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x46\x0f\xbf\x04\x7f"), "movsx r8d, word ptr [rdi + r15*2]")
  run a.store8(Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16), Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x42\x88\x6c\xcd\x10"), "mov byte ptr [rbp + r9*8 + 16], bpl")
  run a.store16(Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16), Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x42\x89\x6c\xcd\x10"), "mov word ptr [rbp + r9*8 + 16], bp")
  run a.loadZero8(Reg.R11, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16))
  run Testing.expect(emitted(&a, &mut at, b"\x46\x0f\xb6\x5c\xcd\x10"), "movzx r11d, byte ptr [rbp + r9*8 + 16]")
  run a.loadZero16(Reg.R11, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16))
  run Testing.expect(emitted(&a, &mut at, b"\x46\x0f\xb7\x5c\xcd\x10"), "movzx r11d, word ptr [rbp + r9*8 + 16]")
  run a.loadSigned32(Reg.R11, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16))
  run Testing.expect(emitted(&a, &mut at, b"\x4e\x63\x5c\xcd\x10"), "movsxd r11, dword ptr [rbp + r9*8 + 16]")
  run a.loadSigned8(Reg.R11, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16))
  run Testing.expect(emitted(&a, &mut at, b"\x46\x0f\xbe\x5c\xcd\x10"), "movsx r11d, byte ptr [rbp + r9*8 + 16]")
  run a.loadSigned16(Reg.R11, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16))
  run Testing.expect(emitted(&a, &mut at, b"\x46\x0f\xbf\x5c\xcd\x10"), "movsx r11d, word ptr [rbp + r9*8 + 16]")
  run a.zeroExtend8(Reg.Rax, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xb6\xc0"), "movzx eax, al")
  run a.signExtend32(Reg.Rax, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\xc0"), "movsxd rax, eax")
  run a.zeroExtend8(Reg.Rcx, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\xb6\xcc"), "movzx ecx, spl")
  run a.signExtend32(Reg.Rcx, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\xcc"), "movsxd rcx, esp")
  run a.zeroExtend8(Reg.Rdx, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\xb6\xd5"), "movzx edx, bpl")
  run a.signExtend32(Reg.Rdx, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\xd5"), "movsxd rdx, ebp")
  run a.zeroExtend8(Reg.Rbx, Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\xb6\xde"), "movzx ebx, sil")
  run a.signExtend32(Reg.Rbx, Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\xde"), "movsxd rbx, esi")
  run a.zeroExtend8(Reg.Rsp, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x0f\xb6\xe7"), "movzx esp, dil")
  run a.signExtend32(Reg.Rsp, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\xe7"), "movsxd rsp, edi")
  run a.zeroExtend8(Reg.Rbp, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\xb6\xe8"), "movzx ebp, r8b")
  run a.signExtend32(Reg.Rbp, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x63\xe8"), "movsxd rbp, r8d")
  run a.zeroExtend8(Reg.Rsi, Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\xb6\xf7"), "movzx esi, r15b")
  run a.signExtend32(Reg.Rsi, Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x63\xf7"), "movsxd rsi, r15d")
  run a.zeroExtend8(Reg.Rdi, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xb6\xf9"), "movzx edi, cl")
  run a.signExtend32(Reg.Rdi, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\xf9"), "movsxd rdi, ecx")
  run a.zeroExtend8(Reg.R8, Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xb6\xc2"), "movzx r8d, dl")
  run a.signExtend32(Reg.R8, Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x63\xc2"), "movsxd r8, edx")
  run a.zeroExtend8(Reg.R9, Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xb6\xcb"), "movzx r9d, bl")
  run a.signExtend32(Reg.R9, Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x63\xcb"), "movsxd r9, ebx")
  run a.zeroExtend8(Reg.R10, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xb6\xd0"), "movzx r10d, al")
  run a.signExtend32(Reg.R10, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x63\xd0"), "movsxd r10, eax")
  run a.zeroExtend8(Reg.R11, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xb6\xdc"), "movzx r11d, spl")
  run a.signExtend32(Reg.R11, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x63\xdc"), "movsxd r11, esp")
  run a.zeroExtend8(Reg.R12, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xb6\xe5"), "movzx r12d, bpl")
  run a.signExtend32(Reg.R12, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x63\xe5"), "movsxd r12, ebp")
  run a.zeroExtend8(Reg.R13, Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xb6\xee"), "movzx r13d, sil")
  run a.signExtend32(Reg.R13, Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x63\xee"), "movsxd r13, esi")
  run a.zeroExtend8(Reg.R14, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xb6\xf7"), "movzx r14d, dil")
  run a.signExtend32(Reg.R14, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x63\xf7"), "movsxd r14, edi")
  run a.zeroExtend8(Reg.R15, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x0f\xb6\xf8"), "movzx r15d, r8b")
  run a.signExtend32(Reg.R15, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x63\xf8"), "movsxd r15, r8d")
  run a.zeroExtend8(Reg.Rax, Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x0f\xb6\xc7"), "movzx eax, r15b")
  run a.signExtend32(Reg.Rax, Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x63\xc7"), "movsxd rax, r15d")
  run a.zeroExtend8(Reg.Rcx, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xb6\xc9"), "movzx ecx, cl")
  run a.signExtend32(Reg.Rcx, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\xc9"), "movsxd rcx, ecx")
  run a.zeroExtend8(Reg.Rdx, Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xb6\xd2"), "movzx edx, dl")
  run a.signExtend32(Reg.Rdx, Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\xd2"), "movsxd rdx, edx")
  run a.zeroExtend8(Reg.Rbx, Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xb6\xdb"), "movzx ebx, bl")
  run a.signExtend32(Reg.Rbx, Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\xdb"), "movsxd rbx, ebx")
}

test effect fn narrowMatchLlvm() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut a = Assembler.make()
  run narrowCases(&mut a) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aluCases(a: &mut Assembler) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut at: usize = 0
  run a.alu(Alu.Add, Width.W64, Reg.Rax, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x01\xc8"), "add rax, rcx")
  run a.alu(Alu.Add, Width.W64, Reg.Rbx, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x01\xcb"), "add rbx, r9")
  run a.alu(Alu.Add, Width.W64, Reg.Rsp, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x01\xfc"), "add rsp, rdi")
  run a.alu(Alu.Add, Width.W64, Reg.Rbp, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x01\xf5"), "add rbp, r14")
  run a.alu(Alu.Add, Width.W64, Reg.Rsi, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x01\xce"), "add rsi, rcx")
  run a.alu(Alu.Add, Width.W64, Reg.R8, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x01\xc8"), "add r8, r9")
  run a.alu(Alu.Add, Width.W64, Reg.R12, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x01\xfc"), "add r12, rdi")
  run a.alu(Alu.Add, Width.W64, Reg.R13, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x01\xf5"), "add r13, r14")
  run a.alu(Alu.Add, Width.W64, Reg.R15, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x01\xcf"), "add r15, rcx")
  run a.aluImm(Alu.Add, Width.W64, Reg.Rax, 0)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xc0\x00"), "add rax, 0")
  run a.aluImm(Alu.Add, Width.W64, Reg.Rcx, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xc1\x01"), "add rcx, 1")
  run a.aluImm(Alu.Add, Width.W64, Reg.Rbp, -1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xc5\xff"), "add rbp, -1")
  run a.aluImm(Alu.Add, Width.W64, Reg.R8, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x83\xc0\x7f"), "add r8, 127")
  run a.aluImm(Alu.Add, Width.W64, Reg.R12, 128)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x81\xc4\x80\x00\x00\x00"), "add r12, 128")
  run a.aluImm(Alu.Add, Width.W64, Reg.R13, -128)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x83\xc5\x80"), "add r13, -128")
  run a.aluImm(Alu.Add, Width.W64, Reg.R15, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x81\xc7\x7f\xff\xff\xff"), "add r15, -129")
  run a.aluImm(Alu.Add, Width.W64, Reg.Rax, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x05\x78\x56\x34\x12"), "add rax, 305419896")
  run a.aluImm(Alu.Add, Width.W64, Reg.Rcx, 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x81\xc1\xff\xff\xff\x7f"), "add rcx, 2147483647")
  run a.aluImm(Alu.Add, Width.W64, Reg.Rbp, -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x81\xc5\x00\x00\x00\x80"), "add rbp, -2147483648")
  run a.aluImm(Alu.Add, Width.W64, Reg.Rax, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x05\x78\x56\x34\x12"), "add rax, 305419896")
  run a.aluImm(Alu.Add, Width.W64, Reg.Rax, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xc0\x7f"), "add rax, 127")
  run a.aluImm(Alu.Add, Width.W64, Reg.Rax, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x05\x7f\xff\xff\xff"), "add rax, -129")
  run a.alu(Alu.Add, Width.W32, Reg.Rax, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x01\xc8"), "add eax, ecx")
  run a.alu(Alu.Add, Width.W32, Reg.Rbx, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x01\xcb"), "add ebx, r9d")
  run a.alu(Alu.Add, Width.W32, Reg.Rsp, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x01\xfc"), "add esp, edi")
  run a.alu(Alu.Add, Width.W32, Reg.Rbp, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x01\xf5"), "add ebp, r14d")
  run a.alu(Alu.Add, Width.W32, Reg.Rsi, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x01\xce"), "add esi, ecx")
  run a.alu(Alu.Add, Width.W32, Reg.R8, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x01\xc8"), "add r8d, r9d")
  run a.alu(Alu.Add, Width.W32, Reg.R12, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x01\xfc"), "add r12d, edi")
  run a.alu(Alu.Add, Width.W32, Reg.R13, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x01\xf5"), "add r13d, r14d")
  run a.alu(Alu.Add, Width.W32, Reg.R15, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x01\xcf"), "add r15d, ecx")
  run a.aluImm(Alu.Add, Width.W32, Reg.Rax, 0)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xc0\x00"), "add eax, 0")
  run a.aluImm(Alu.Add, Width.W32, Reg.Rcx, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xc1\x01"), "add ecx, 1")
  run a.aluImm(Alu.Add, Width.W32, Reg.Rbp, -1)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xc5\xff"), "add ebp, -1")
  run a.aluImm(Alu.Add, Width.W32, Reg.R8, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x83\xc0\x7f"), "add r8d, 127")
  run a.aluImm(Alu.Add, Width.W32, Reg.R12, 128)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x81\xc4\x80\x00\x00\x00"), "add r12d, 128")
  run a.aluImm(Alu.Add, Width.W32, Reg.R13, -128)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x83\xc5\x80"), "add r13d, -128")
  run a.aluImm(Alu.Add, Width.W32, Reg.R15, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x81\xc7\x7f\xff\xff\xff"), "add r15d, -129")
  run a.aluImm(Alu.Add, Width.W32, Reg.Rax, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x05\x78\x56\x34\x12"), "add eax, 305419896")
  run a.aluImm(Alu.Add, Width.W32, Reg.Rcx, 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\x81\xc1\xff\xff\xff\x7f"), "add ecx, 2147483647")
  run a.aluImm(Alu.Add, Width.W32, Reg.Rbp, -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x81\xc5\x00\x00\x00\x80"), "add ebp, -2147483648")
  run a.aluImm(Alu.Add, Width.W32, Reg.Rax, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x05\x78\x56\x34\x12"), "add eax, 305419896")
  run a.aluImm(Alu.Add, Width.W32, Reg.Rax, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xc0\x7f"), "add eax, 127")
  run a.aluImm(Alu.Add, Width.W32, Reg.Rax, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x05\x7f\xff\xff\xff"), "add eax, -129")
  run a.alu(Alu.Or, Width.W64, Reg.Rax, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x09\xc8"), "or rax, rcx")
  run a.alu(Alu.Or, Width.W64, Reg.Rbx, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x09\xcb"), "or rbx, r9")
  run a.alu(Alu.Or, Width.W64, Reg.Rsp, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x09\xfc"), "or rsp, rdi")
  run a.alu(Alu.Or, Width.W64, Reg.Rbp, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x09\xf5"), "or rbp, r14")
  run a.alu(Alu.Or, Width.W64, Reg.Rsi, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x09\xce"), "or rsi, rcx")
  run a.alu(Alu.Or, Width.W64, Reg.R8, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x09\xc8"), "or r8, r9")
  run a.alu(Alu.Or, Width.W64, Reg.R12, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x09\xfc"), "or r12, rdi")
  run a.alu(Alu.Or, Width.W64, Reg.R13, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x09\xf5"), "or r13, r14")
  run a.alu(Alu.Or, Width.W64, Reg.R15, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x09\xcf"), "or r15, rcx")
  run a.aluImm(Alu.Or, Width.W64, Reg.Rax, 0)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xc8\x00"), "or rax, 0")
  run a.aluImm(Alu.Or, Width.W64, Reg.Rcx, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xc9\x01"), "or rcx, 1")
  run a.aluImm(Alu.Or, Width.W64, Reg.Rbp, -1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xcd\xff"), "or rbp, -1")
  run a.aluImm(Alu.Or, Width.W64, Reg.R8, 127)
