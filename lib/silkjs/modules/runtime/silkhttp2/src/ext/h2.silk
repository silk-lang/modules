pub unsafe fn nghttp2_submit_push_promise(session: ?*mut u8, flags: u8, stream: i32, entries: ?*mut NV, count: usize, user: ?*mut u8) -> i32 {
  let sp = unsafe sessionOf(session)
  if stream <= 0 || unsafe isMyStream(sp, stream) { return ERR_INVALID_ARGUMENT }
