//! One atomic update of an application's ordered compiled stylesheet assets.
//! This envelope has no CSS text or compiler dependency. Each payload is SILKCSS.
import style.sheet_binary { Writer, Reader, DecodeReason }
pub import style.sheet_binary { DecodeError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub const MAX_BYTES: usize = 67108864
pub const MAX_SHEETS: usize = 4096

pub fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] { return false }
    i = i + 1
  }
  return true
}

pub effect fn encode(sheets: &[Bytes]) -> Bytes ! DecodeError | OutOfMemoryError ? &mut Allocator {
  if sheets.length > MAX_SHEETS { fail DecodeError { reason: DecodeReason.Limit, offset: 0 } }
  let mut length: usize = 16
  let mut i: usize = 0
  while i < sheets.length {
    let bytes = sheets[i].length()
    if bytes > MAX_BYTES - length || MAX_BYTES - length - bytes < 4 {
      fail DecodeError { reason: DecodeReason.Limit, offset: i }
    }
    length = length + 4 + bytes
    i = i + 1
  }
  let mut writer = Writer.make()
  run writer.bytes.append(b"SILKUIST")
  run writer.word(1)
  run writer.index(sheets.length)
  i = 0
  while i < sheets.length {
    run writer.data(sheets[i].asSlice())
    i = i + 1
  }
  return move writer.bytes
}

pub effect fn decode(bytes: &[u8]) -> List<Bytes> ! DecodeError | OutOfMemoryError ? &mut Allocator {
  if bytes.length > MAX_BYTES { fail DecodeError { reason: DecodeReason.Limit, offset: 0 } }
  let mut reader = Reader.make(bytes)
  let magic = b"SILKUIST"
  let mut i: usize = 0
  while i < magic.length {
    if (run reader.byte()) != magic[i] { run reader.invalid() }
    i = i + 1
  }
  if (run reader.word()) != 1 { fail DecodeError { reason: DecodeReason.Version, offset: 8 } }
  let count = run reader.count(MAX_SHEETS)
  let mut sheets = List<Bytes>.make()
  i = 0
  while i < count {
    run sheets.append(run Bytes.copy(run reader.data()))
    i = i + 1
  }
  run reader.finish()
  return move sheets
}
