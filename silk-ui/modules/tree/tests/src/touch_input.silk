//! Touch input and `touch-action` on the inbox fixture: taps, finger pans of the list, flicks,
//! two-finger gestures and trackpad pinches.
import ui_fixtures.fixtures as fixtures
import ui_tree.legacy { UiTree, TreeError, Batch, FrameInput, Event, EventKind, Input, MOD_CONTROL }
import ui_tree.mutation { Declaration, Value, Keyword, CssProperty }
import properties.values { Separator }
import ui_tree.input { POINTER_TOUCH, POINTER_MOUSE }
import font_collection.lib { FontCollection }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
import silk.testing.testing { Testing, AssertionError }

/// A point in the list clear of the nested box and of the toolbar.
const X: f32 = 340.0

fn at(time: f64) -> FrameInput {
  let base = fixtures.viewport(2)
  return FrameInput { width: base.width, height: base.height, scale: base.scale, time: time }
}

effect fn inbox<'a>(collection: &'a FontCollection, touchAction: &[Keyword]) -> UiTree<'a>
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run fixtures.inbox(&mut batch)
  if touchAction.length == 1 {
    run batch.style(
      fixtures.INBOX_LIST,
      &[Declaration { property: CssProperty.TouchAction, value: Value.Keyword { value: touchAction[0] }, important: false }],
    )
  } else if touchAction.length > 1 {
    let mut words = List<Value>.make()
    let mut i: usize = 0
    while i < touchAction.length {
      run words.append(Value.Keyword { value: touchAction[i] })
      i = i + 1
    }
    run batch.style(
      fixtures.INBOX_LIST,
      &[Declaration { property: CssProperty.TouchAction, value: Value.Sequence { separator: Separator.Space, values: move words }, important: false }],
    )
  }
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  return move tree
}

effect fn drain(tree: &mut UiTree<'_>) -> List<Event>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut events = List<Event>.make()
  run tree.takeEvents(&mut events)
  let mut i: usize = 0
  while i < events.length() {
    if events.asSlice()[i].kind == EventKind.Layout {
      drop events.remove(i)
    } else {
      i = i + 1
    }
  }
  return move events
}

effect fn start(tree: &mut UiTree<'_>, id: u32, x: f32, y: f32, time: f64) -> () ! OutOfMemoryError ? &mut Allocator {
  run tree.dispatch(Input.TouchStart { id: id, x: x, y: y, modifiers: 0, time: time })
}

effect fn slide(tree: &mut UiTree<'_>, id: u32, x: f32, y: f32, time: f64) -> () ! OutOfMemoryError ? &mut Allocator {
  run tree.dispatch(Input.TouchMove { id: id, x: x, y: y, modifiers: 0, time: time })
}

effect fn end(tree: &mut UiTree<'_>, id: u32, x: f32, y: f32, time: f64) -> () ! OutOfMemoryError ? &mut Allocator {
  run tree.dispatch(Input.TouchEnd { id: id, x: x, y: y, modifiers: 0, time: time })
}

fn countKind(events: &List<Event>, kind: EventKind) -> usize {
  let values = events.asSlice()
  let mut found: usize = 0
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == kind {
      found = found + 1
    }
    i = i + 1
  }
  return found
}

/// The index of the first record of `kind`, or the length when there is none.
fn firstOf(events: &List<Event>, kind: EventKind) -> usize {
  let values = events.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == kind {
      return i
    }
    i = i + 1
  }
  return values.length
}

fn listY(tree: &UiTree<'_>) -> f32 {
  return tree.scrollOffset(fixtures.INBOX_LIST).y
}

effect fn tapBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection, &[])
  run start(&mut tree, 7, 100.0, 112.0, 0.0)
  run slide(&mut tree, 7, 103.0, 114.0, 0.02)
  run end(&mut tree, 7, 103.0, 114.0, 0.05)
  let events = run drain(&mut tree)
  let values = events.asSlice()
  let down = firstOf(&events, EventKind.PointerDown)
  let up = firstOf(&events, EventKind.PointerUp)
  let click = firstOf(&events, EventKind.Click)
  run Testing.expect(down < values.length && up < values.length && click < values.length, "a tap is a pointer down, up and click")
  run Testing.expect(
    values[down].target == fixtures.ROW + 10 && values[down].pointerType == POINTER_TOUCH
      && values[down].pointerId == 2 && values[down].primary,
    "of type touch, pointer 2, primary, on the row",
  )
  run Testing.expect(values[click].pointerType == POINTER_TOUCH && values[click].detail == 1, "the click is a touch click")
  run Testing.expect(countKind(&events, EventKind.PointerMove) == 1, "a move inside the slop still goes to the client")
  run Testing.expect(countKind(&events, EventKind.PointerCancel) == 0 && listY(&tree) == 0.0, "and nothing scrolls")

  // The mouse speaks for itself again.
  run tree.dispatch(Input.PointerMove { x: 100.0, y: 130.0, modifiers: 0 })
  let after = run drain(&mut tree)
  let moved = firstOf(&after, EventKind.PointerMove)
  run Testing.expect(
    moved < after.length() && after.asSlice()[moved].pointerType == POINTER_MOUSE && after.asSlice()[moved].pointerId == 1,
    "a mouse move after the tap is pointer 1, a mouse",
  )
}

test effect fn aTapIsATouchPressAndClick() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run tapBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn panBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection, &[])
  run start(&mut tree, 1, X, 300.0, 0.0)
  run slide(&mut tree, 1, X, 250.0, 0.5)
  let events = run drain(&mut tree)
  run Testing.expect(countKind(&events, EventKind.PointerCancel) == 1, "a drag past the slop cancels the pointer")
  run Testing.expect(f32.abs(listY(&tree) - 40.0) < 0.01, "and scrolls the list by the drag past the slop")
  run slide(&mut tree, 1, X, 200.0, 1.0)
  run Testing.expect(f32.abs(listY(&tree) - 90.0) < 0.01, "the list follows the finger")
  run slide(&mut tree, 1, X, 220.0, 1.5)
  run Testing.expect(f32.abs(listY(&tree) - 70.0) < 0.01, "both ways")
  // Held still long before lifting: no flick.
  run end(&mut tree, 1, X, 220.0, 3.0)
  let after = run drain(&mut tree)
  run Testing.expect(
    countKind(&after, EventKind.PointerUp) == 0 && countKind(&after, EventKind.Click) == 0
      && countKind(&after, EventKind.PointerMove) == 0,
    "a cancelled pointer sends nothing more",
  )
  run tree.frame(at(3.1))
  run tree.frame(at(3.2))
  run Testing.expect(f32.abs(listY(&tree) - 70.0) < 0.01 && !tree.needsFrame(), "a slow release does not flick")
}

test effect fn aFingerPanScrollsTheList() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run panBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn flickBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection, &[])
  run start(&mut tree, 1, X, 400.0, 0.0)
  run slide(&mut tree, 1, X, 390.0, 0.01)
  run slide(&mut tree, 1, X, 380.0, 0.02)
  run slide(&mut tree, 1, X, 370.0, 0.03)
  run end(&mut tree, 1, X, 370.0, 0.03)
  let released = listY(&tree)
  run Testing.expect(f32.abs(released - 20.0) < 0.01, "the pan scrolled 20")
  run Testing.expect(tree.needsFrame(), "a flick wants frames")
  run tree.frame(at(0.05))
  run tree.frame(at(0.1))
  let early = listY(&tree)
  run Testing.expect(early > released + 30.0, "and keeps scrolling after the release")
  let mut t: f64 = 0.1
  while t < 4.0 && tree.needsFrame() {
    t = t + 0.016
    run tree.frame(at(t))
  }
  let rest = listY(&tree)
  // 1000 px/s, slowing at FLING per second, travels about 500 pixels or to the end.
  run Testing.expect(rest > early && !tree.needsFrame(), "the flick slows down and stops")
  run start(&mut tree, 1, X, 300.0, 5.0)
  run end(&mut tree, 1, X, 300.0, 5.05)
  drop run drain(&mut tree)
  run Testing.expect(listY(&tree) == rest, "a tap after it scrolls nothing")
}

test effect fn aFlickKeepsScrollingAndStops() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run flickBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn noneBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection, &[Keyword.None])
  run start(&mut tree, 1, X, 300.0, 0.0)
  run slide(&mut tree, 1, X, 250.0, 0.1)
  run slide(&mut tree, 1, X, 200.0, 0.2)
  run end(&mut tree, 1, X, 200.0, 0.3)
  let events = run drain(&mut tree)
  run Testing.expect(listY(&tree) == 0.0, "touch-action: none keeps the list still")
  run Testing.expect(
    countKind(&events, EventKind.PointerCancel) == 0 && countKind(&events, EventKind.PointerMove) == 2
      && countKind(&events, EventKind.PointerUp) == 1,
    "and the client gets every pointer record",
  )
}

test effect fn touchActionNoneLeavesTheGestureToTheClient() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run noneBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn axesBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  // pan-x on a vertical list: a vertical drag is the client's.
  let mut tree = run inbox(&collection, &[Keyword.PanX])
  run start(&mut tree, 1, X, 300.0, 0.0)
  run slide(&mut tree, 1, X, 250.0, 0.1)
  let events = run drain(&mut tree)
  run Testing.expect(listY(&tree) == 0.0 && countKind(&events, EventKind.PointerCancel) == 0, "pan-x does not take a vertical drag")
  run end(&mut tree, 1, X, 250.0, 0.2)

  // pan-down: a drag up (scrolling down) pans, a drag down does not.
  let mut down = run inbox(&collection, &[Keyword.PanDown])
  run start(&mut down, 1, X, 300.0, 0.0)
  run slide(&mut down, 1, X, 330.0, 0.1)
  run Testing.expect(listY(&down) == 0.0, "pan-down leaves a drag down to the client")
  run end(&mut down, 1, X, 330.0, 0.2)
  run start(&mut down, 2, X, 300.0, 1.0)
  run slide(&mut down, 2, X, 270.0, 1.1)
  run Testing.expect(f32.abs(listY(&down) - 20.0) < 0.01, "and pans on a drag up")
  // Once panning, the direction may turn back.
  run slide(&mut down, 2, X, 280.0, 1.2)
  run Testing.expect(f32.abs(listY(&down) - 10.0) < 0.01, "and back")
  run end(&mut down, 2, X, 280.0, 2.0)

  // pan-y pinch-zoom on the list, a sequence of words.
  let mut both = run inbox(&collection, &[Keyword.PinchZoom, Keyword.PanY])
  run start(&mut both, 1, X, 300.0, 0.0)
  run slide(&mut both, 1, X, 260.0, 0.1)
  run Testing.expect(f32.abs(listY(&both) - 30.0) < 0.01, "pinch-zoom pan-y pans vertically")
}

test effect fn panWordsPickTheAxesTheTreeTakes() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run axesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn fingersBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  // Without pinch-zoom the second finger is the client's: a pointer of its own.
  let mut tree = run inbox(&collection, &[Keyword.PanX, Keyword.PanY])
  run start(&mut tree, 1, 100.0, 112.0, 0.0)
  run start(&mut tree, 2, X, 300.0, 0.01)
  run slide(&mut tree, 2, X, 302.0, 0.02)
  run end(&mut tree, 2, X, 302.0, 0.03)
  run end(&mut tree, 1, 100.0, 112.0, 0.04)
  let events = run drain(&mut tree)
  let values = events.asSlice()
  let mut secondary: usize = 0
  let mut i: usize = 0
  while i < values.length {
    let touchRecord = values[i].kind == EventKind.TouchStart || values[i].kind == EventKind.TouchMove
      || values[i].kind == EventKind.TouchEnd
    if values[i].pointerId == 3 && !touchRecord {
      run Testing.expect(!values[i].primary && values[i].pointerType == POINTER_TOUCH, "the second finger is not primary")
      secondary = secondary + 1
    }
    i = i + 1
  }
  run Testing.expect(secondary == 3, "it gets a down, a move and an up")
  run Testing.expect(countKind(&events, EventKind.Click) == 1, "only the first finger clicks")

  // With pinch-zoom (auto), two fingers are a pinch the tree takes.
  let mut pinch = run inbox(&collection, &[])
  run start(&mut pinch, 1, 100.0, 112.0, 0.0)
  run start(&mut pinch, 2, X, 300.0, 0.01)
  let taken = run drain(&mut pinch)
  run Testing.expect(countKind(&taken, EventKind.PointerCancel) == 2, "a second finger under pinch-zoom cancels both pointers")
  // The middle of the fingers pans.
  run slide(&mut pinch, 1, 100.0, 92.0, 0.1)
  run slide(&mut pinch, 2, X, 280.0, 0.1)
  run Testing.expect(f32.abs(listY(&pinch) - 20.0) < 0.01, "and the fingers pan together")
  run end(&mut pinch, 1, 100.0, 92.0, 0.5)
  run end(&mut pinch, 2, X, 280.0, 0.5)
  let after = run drain(&mut pinch)
  run Testing.expect(countKind(&after, EventKind.PointerUp) == 0 && countKind(&after, EventKind.Click) == 0, "no up or click follows")
}

test effect fn aSecondFingerIsItsOwnPointerOrAPinch() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fingersBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pinchBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection, &[])
  run tree.dispatch(Input.Pinch { x: 100.0, y: 112.0, delta: 0.1, modifiers: 0 })
  let events = run drain(&mut tree)
  let index = firstOf(&events, EventKind.Wheel)
  run Testing.expect(index < events.length(), "a trackpad pinch is a wheel record")
  let wheel = &events.asSlice()[index]
  run Testing.expect(
    u32.bitAnd(wheel.modifiers, MOD_CONTROL) != 0 && wheel.deltaY < -9.0 && wheel.deltaY > -10.0,
    "with control held and deltaY -100 ln(1.1), as Chromium reports it",
  )
  run Testing.expect(listY(&tree) == 0.0, "and it scrolls nothing")
}

test effect fn aTrackpadPinchIsAControlWheel() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pinchBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Runs `input` with its records prevented, as a handler calling `preventDefault` would, and
/// gives back the records.
effect fn preventing(tree: &mut UiTree<'_>, input: Input, again: Input) -> List<Event>
  ! OutOfMemoryError
  ? &mut Allocator {
  run tree.begin(&input)
  let events = run drain(&mut tree)
  run tree.finish(move again, true)
  return move events
}

effect fn touchEventsBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection, &[])

  // A finger's touch records follow its pointer records, at the node it went down on.
  run start(&mut tree, 1, X, 300.0, 0.0)
  let down = run drain(&mut tree)
  let pressed = firstOf(&down, EventKind.PointerDown)
  let touched = firstOf(&down, EventKind.TouchStart)
  run Testing.expect(pressed < touched && touched < down.length(), "touchstart follows pointerdown")
  let startTarget = down.asSlice()[touched].target
  run Testing.expect(
    down.asSlice()[touched].detail == 1 && down.asSlice()[touched].pointerId == 2
      && down.asSlice()[touched].pointerType == POINTER_TOUCH,
    "a cancelable touchstart for touch 2",
  )
  // Past the slop the touchmove goes first and the tree pans after it.
  run slide(&mut tree, 1, X, 250.0, 0.5)
  let moved = run drain(&mut tree)
  let first = firstOf(&moved, EventKind.TouchMove)
  run Testing.expect(
    first < firstOf(&moved, EventKind.PointerCancel) && moved.asSlice()[first].detail == 1
      && moved.asSlice()[first].target == startTarget,
    "the deciding touchmove is cancelable and comes before the pointercancel",
  )
  run slide(&mut tree, 1, X, 200.0, 1.0)
  let panning = run drain(&mut tree)
  let later = firstOf(&panning, EventKind.TouchMove)
  run Testing.expect(
    later < panning.length() && panning.asSlice()[later].detail == 0 && panning.asSlice()[later].target == startTarget,
    "while the tree pans, touchmove goes on, not cancelable, to the same node",
  )
  run end(&mut tree, 1, X, 200.0, 3.0)
  let ended = run drain(&mut tree)
  run Testing.expect(countKind(&ended, EventKind.TouchEnd) == 1, "and touchend ends it")
  run tree.frame(at(3.1))
  let scrolled = listY(&tree)

  // A prevented touchmove before the pan keeps the gesture: no scroll, pointer moves go on.
  run start(&mut tree, 2, X, 300.0, 4.0)
  drop run drain(&mut tree)
  drop run preventing(
    &mut tree,
    Input.TouchMove { id: 2, x: X, y: 250.0, modifiers: 0, time: 4.5 },
    Input.TouchMove { id: 2, x: X, y: 250.0, modifiers: 0, time: 4.5 },
  )
  let kept = run drain(&mut tree)
  run Testing.expect(listY(&tree) == scrolled && countKind(&kept, EventKind.PointerCancel) == 0, "a prevented touchmove does not pan")
  run Testing.expect(countKind(&kept, EventKind.PointerMove) == 1, "and the move reaches the client as a pointer move")
  run slide(&mut tree, 2, X, 150.0, 5.0)
  run Testing.expect(listY(&tree) == scrolled, "for the rest of the gesture")
  run end(&mut tree, 2, X, 150.0, 5.5)
  drop run drain(&mut tree)

  // A prevented touchstart: no pan, and the tap clicks nothing.
  drop run preventing(
    &mut tree,
    Input.TouchStart { id: 3, x: 100.0, y: 112.0, modifiers: 0, time: 6.0 },
    Input.TouchStart { id: 3, x: 100.0, y: 112.0, modifiers: 0, time: 6.0 },
  )
  run end(&mut tree, 3, 100.0, 112.0, 6.1)
  let tapped = run drain(&mut tree)
  run Testing.expect(
    countKind(&tapped, EventKind.PointerUp) == 1 && countKind(&tapped, EventKind.TouchEnd) == 1
      && countKind(&tapped, EventKind.Click) == 0,
    "a prevented touchstart makes a tap without a click",
  )
  // The next tap clicks again.
  run start(&mut tree, 4, 100.0, 112.0, 7.0)
  run end(&mut tree, 4, 100.0, 112.0, 7.1)
  let again = run drain(&mut tree)
  run Testing.expect(countKind(&again, EventKind.Click) == 1, "and the next tap clicks")
}

test effect fn touchEventsFollowPointerEventsAndCanKeepTheGesture() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run touchEventsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
