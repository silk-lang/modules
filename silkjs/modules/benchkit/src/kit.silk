//! What the benchmark tasks share: text scanning, files, child processes that are measured, and
//! the checks made before a measurement.
//!
//! Every function fails with a `TaskError` that says what went wrong, so a task reports one line.

import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { DirectoryEntry, DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.subprocess { SpawnOptions, Stdio, Subprocess, SubprocessError }
import silk.text.string { InvalidUtf8, String }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

extern "C" struct TimeVal { seconds: i64, micros: i64 }
extern "C" struct TimeSpec { seconds: i64, nanos: i64 }
// struct rusage of Linux and Darwin on 64-bit targets: two timevals and fourteen longs.
extern "C" struct ResourceUsage {
  user: TimeVal,
  system: TimeVal,
  maxRss: i64,
  sharedText: i64,
  unsharedData: i64,
  unsharedStack: i64,
  minorFaults: i64,
  majorFaults: i64,
  swaps: i64,
  blocksIn: i64,
  blocksOut: i64,
  messagesSent: i64,
  messagesReceived: i64,
  signals: i64,
  voluntarySwitches: i64,
  involuntarySwitches: i64,
}

@foreign(noCapture: .("status", "usage"))
unsafe extern "C" fn wait4(pid: i32, status: ?[*]mut i32, options: i32, usage: ?[*]mut ResourceUsage) -> i32
@foreign(noCapture: .("time"))
unsafe extern "C" fn clock_gettime(clock: i32, time: ?[*]mut TimeSpec) -> i32
@foreign(noCapture: .("path"))
unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32
unsafe extern "C" fn close(fd: i32) -> i32
unsafe extern "C" fn usleep(micros: u32) -> i32
unsafe extern "C" fn kill(pid: i32, signal: i32) -> i32
unsafe extern "C" fn geteuid() -> u32
@foreign(noCapture: .("loads"))
unsafe extern "C" fn getloadavg(loads: ?[*]mut f64, count: i32) -> i32
unsafe extern "C" fn sysconf(name: i32) -> i64

// ---------------------------------------------------------------- failing and printing

/// Fails the task with the parts joined into one message.
pub effect fn abort(first: &[u8], second: &[u8]) -> never ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut message = run Bytes.copy(first)
  run Bytes.append(&mut message, second)
  fail TaskError { message: run textOf(move message), status: 1 }
}

effect fn textOf(bytes: Bytes) -> String ! OutOfMemoryError ? &mut Allocator {
  return match move String.fromBytes(move bytes) {
    Result<String, InvalidUtf8>.Success { value } => move value
    Result<String, InvalidUtf8>.Failure { .. } => run String.copy("a benchmark task failed (its message is not UTF-8)")
  }
}

/// Writes `text` to standard output.
pub effect fn print(text: &[u8]) -> () ! WriterError {
  let mut out = StdoutWriter.make()
  run Writer.writeAll(text) |> Effect.provideMut<Writer>(&mut out)
}

/// Writes `text` and a newline to standard output.
pub effect fn say(text: &[u8]) -> () ! WriterError {
  run print(text)
  run print(b"\n")
}

/// Writes `first`, `second` and a newline to standard output.
pub effect fn say2(first: &[u8], second: &[u8]) -> () ! WriterError {
  run print(first)
  run print(second)
  run print(b"\n")
}

/// Writes a warning line to standard error.
pub effect fn warn(first: &[u8], second: &[u8]) -> () ! WriterError {
  let mut err = StderrWriter.make()
  run Writer.writeAll(b"bench: WARNING, ") |> Effect.provideMut<Writer>(&mut err)
  run Writer.writeAll(first) |> Effect.provideMut<Writer>(&mut err)
  run Writer.writeAll(second) |> Effect.provideMut<Writer>(&mut err)
  run Writer.writeAll(b"\n") |> Effect.provideMut<Writer>(&mut err)
}

// ---------------------------------------------------------------- text

/// Whether `text` and `other` hold the same bytes.
pub fn same(text: &[u8], other: &[u8]) -> bool {
  if text.length != other.length { return false }
  let mut at: usize = 0
  while at < text.length {
    if text[at] != other[at] { return false }
    at = at + 1
  }
  return true
}

/// Whether `text` starts with `prefix`.
pub fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  if text.length < prefix.length { return false }
  return same(Slice.view<u8>(text, 0, prefix.length), prefix)
}

/// Whether `text` ends with `suffix`.
pub fn endsWith(text: &[u8], suffix: &[u8]) -> bool {
  if text.length < suffix.length { return false }
  return same(Slice.view<u8>(text, text.length - suffix.length, suffix.length), suffix)
}

/// The first index at or after `from` where `needle` starts in `text`, or `text.length` when it
/// does not occur.
pub fn find(text: &[u8], needle: &[u8], from: usize) -> usize {
  if needle.length == 0 || text.length < needle.length { return text.length }
  let mut at = from
  while at + needle.length <= text.length {
    if text[at] == needle[0] && same(Slice.view<u8>(text, at, needle.length), needle) { return at }
    at = at + 1
  }
  return text.length
}

/// Whether `needle` occurs in `text`.
pub fn contains(text: &[u8], needle: &[u8]) -> bool {
  return find(text, needle, 0) < text.length
}

/// The bytes of `text` from `start` up to `end`.
pub fn part(text: &[u8], start: usize, end: usize) -> &[u8] {
  return Slice.view<u8>(text, start, end - start)
}

fn isDigit(value: u8) -> bool { return value >= 48 && value <= 57 }
fn isSpace(value: u8) -> bool { return value == 32 || value == 9 || value == 10 || value == 13 }

/// The index after the number that starts at `at`: digits with at most one point.
pub fn numberEnd(text: &[u8], at: usize) -> usize {
  let mut end = at
  let mut point = false
  while end < text.length {
    if isDigit(text[end]) {
      end = end + 1
    } else if text[end] == 46 && !point && end + 1 < text.length && isDigit(text[end + 1]) {
      point = true
      end = end + 1
    } else {
      break
    }
  }
  return end
}

/// The value of the decimal number that `text` is, such as `12` or `3.25`; 0 for anything else.
pub fn number(text: &[u8]) -> f64 {
  let mut whole: f64 = 0.0
  let mut scale: f64 = 1.0
  let mut point = false
  let mut at: usize = 0
  while at < text.length {
    let value = text[at]
    if isDigit(value) {
      whole = whole * 10.0 + u8.toF64(value - 48)
      if point { scale = scale * 10.0 }
    } else if value == 46 && !point {
      point = true
    } else {
      break
    }
    at = at + 1
  }
  return whole / scale
}

/// The number that follows `marker` in `text` (blanks between are skipped), or none.
pub fn numberAfter(text: &[u8], marker: &[u8]) -> Option<f64> {
  let found = find(text, marker, 0)
  if found == text.length { return Option<f64>.none() }
  let mut at = found + marker.length
  while at < text.length && isSpace(text[at]) { at = at + 1 }
  let end = numberEnd(text, at)
  if end == at { return Option<f64>.none() }
  return Option<f64>.some(number(part(text, at, end)))
}

/// The start of the number that ends just before index `end` (blanks before `end` are skipped),
/// or `end` when there is none there.
pub fn numberStartBefore(text: &[u8], end: usize) -> usize {
  let mut stop = end
  while stop > 0 && (text[stop - 1] == 32 || text[stop - 1] == 9) { stop = stop - 1 }
  let mut start = stop
  while start > 0 && (isDigit(text[start - 1]) || text[start - 1] == 46) { start = start - 1 }
  if start == stop { return end }
  return start
}

/// The number that comes just before the first `marker` in `text`, or none.
pub fn numberBefore(text: &[u8], marker: &[u8]) -> Option<f64> {
  let found = find(text, marker, 0)
  if found == text.length { return Option<f64>.none() }
  let start = numberStartBefore(text, found)
  if start == found { return Option<f64>.none() }
  return Option<f64>.some(number(part(text, start, numberEnd(text, start))))
}

/// Appends the decimal digits of `value`.
pub effect fn appendInteger(text: &mut Bytes, value: i64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value < 0 {
    run Bytes.append(&mut text.*, b"-")
    run appendInteger(&mut text.*, 0 - value)
    return ()
  }
  if value >= 10 { run appendInteger(&mut text.*, value / 10) }
  let digit = [i64.wrappingToU8(48 + value % 10)]
  run Bytes.append(&mut text.*, &digit)
}

/// Appends `value` with `decimals` digits after the point, rounded.
pub effect fn appendFixed(text: &mut Bytes, value: f64, decimals: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if f64.isNaN(value) || f64.isInfinite(value) {
    run Bytes.append(&mut text.*, b"0")
    return ()
  }
  let mut scale: f64 = 1.0
  let mut count: usize = 0
  while count < decimals {
    scale = scale * 10.0
    count = count + 1
  }
  let negative = value < 0.0
  let scaled = f64.toI64(f64.round(f64.abs(value) * scale))
  let unit = f64.toI64(scale)
  if negative && scaled != 0 { run Bytes.append(&mut text.*, b"-") }
  run appendInteger(&mut text.*, scaled / unit)
  if decimals == 0 { return () }
  run Bytes.append(&mut text.*, b".")
  let mut fraction = scaled % unit
  let mut divisor = unit / 10
  while divisor > 0 {
    let digit = [i64.wrappingToU8(48 + fraction / divisor)]
    run Bytes.append(&mut text.*, &digit)
    fraction = fraction % divisor
    divisor = divisor / 10
  }
}

/// Appends `value` padded with blanks on the left to `width` bytes.
pub effect fn appendPadded(text: &mut Bytes, value: &[u8], width: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = value.length
  while at < width {
    run Bytes.append(&mut text.*, b" ")
    at = at + 1
  }
  run Bytes.append(&mut text.*, value)
}

/// Appends `value` padded with blanks on the right to `width` bytes.
pub effect fn appendLeft(text: &mut Bytes, value: &[u8], width: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut text.*, value)
  let mut at = value.length
  while at < width {
    run Bytes.append(&mut text.*, b" ")
    at = at + 1
  }
}

/// `value` with `decimals` digits after the point.
pub effect fn fixed(value: f64, decimals: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  run appendFixed(&mut text, value, decimals)
  return move text
}

/// The decimal digits of `value`.
pub effect fn integer(value: i64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  run appendInteger(&mut text, value)
  return move text
}

/// The parts of `text` between `separator` bytes, without empty ones.
pub effect fn split(text: &[u8], separator: u8) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut parts = List<Bytes>.make()
  let mut start: usize = 0
  while start <= text.length {
    let mut end = start
    while end < text.length && text[end] != separator { end = end + 1 }
    if end > start { run List<Bytes>.append(&mut parts, run Bytes.copy(part(text, start, end))) }
    start = end + 1
  }
  return move parts
}

/// The parts joined with `separator`.
pub effect fn join(parts: &List<Bytes>, separator: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  let listed = List<Bytes>.asSlice(parts)
  let mut at: usize = 0
  while at < listed.length {
    if at > 0 { run Bytes.append(&mut text, separator) }
    run Bytes.append(&mut text, Bytes.asSlice(&listed[at]))
    at = at + 1
  }
  return move text
}

/// Whether one of `names` is `name`.
pub fn listed(names: &List<Bytes>, name: &[u8]) -> bool {
  let values = List<Bytes>.asSlice(names)
  let mut at: usize = 0
  while at < values.length {
    if same(Bytes.asSlice(&values[at]), name) { return true }
    at = at + 1
  }
  return false
}

/// The parts joined into one value.
pub effect fn cat(first: &[u8], second: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = run Bytes.copy(first)
  run Bytes.append(&mut text, second)
  return move text
}

/// The three parts joined into one value.
pub effect fn cat3(first: &[u8], second: &[u8], third: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = run cat(first, second)
  run Bytes.append(&mut text, third)
  return move text
}

// ---------------------------------------------------------------- statistics

/// The values in ascending order.
pub effect fn sorted(values: &[f64]) -> List<f64> ! OutOfMemoryError ? &mut Allocator {
  let mut ordered = List<f64>.make()
  let mut at: usize = 0
  while at < values.length {
    run List<f64>.append(&mut ordered, values[at])
    at = at + 1
  }
  let slots = List<f64>.asMutSlice(&mut ordered)
  let mut index: usize = 1
  while index < slots.length {
    let value = slots[index]
    let mut hole = index
    while hole > 0 && slots[hole - 1] > value {
      slots[hole] = slots[hole - 1]
      hole = hole - 1
    }
    slots[hole] = value
    index = index + 1
  }
  return move ordered
}

/// The median of `values`: the mean of the two middle values for an even count; 0 for none.
pub effect fn median(values: &[f64]) -> f64 ! OutOfMemoryError ? &mut Allocator {
  if values.length == 0 { return 0.0 }
  let ordered = run sorted(values)
  let slots = List<f64>.asSlice(&ordered)
  let middle = slots.length / 2
  if slots.length % 2 == 1 { return slots[middle] }
  return (slots[middle - 1] + slots[middle]) / 2.0
}

/// The smallest of `values`; 0 for none.
pub fn least(values: &[f64]) -> f64 {
  if values.length == 0 { return 0.0 }
  let mut best = values[0]
  let mut at: usize = 1
  while at < values.length {
    if values[at] < best { best = values[at] }
    at = at + 1
  }
  return best
}

/// The largest of `values`; 0 for none.
pub fn most(values: &[f64]) -> f64 {
  if values.length == 0 { return 0.0 }
  let mut best = values[0]
  let mut at: usize = 1
  while at < values.length {
    if values[at] > best { best = values[at] }
    at = at + 1
  }
  return best
}

// ---------------------------------------------------------------- files

/// The path `spelled` names, which must be absolute.
pub effect fn path(spelled: &[u8]) -> Path ! TaskError | OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(Path.fromBytes(spelled)) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        run abort(b"not an absolute path: ", spelled)
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

/// `spelled` as a normalized absolute path: itself when it starts with `/`, else under `base`.
/// `.` and `..` components are resolved.
pub effect fn absolute(base: &[u8], spelled: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let joined = if spelled.length > 0 && spelled[0] == 47 { run Bytes.copy(spelled) } else { run cat3(base, b"/", spelled) }
  let parts = run split(Bytes.asSlice(&joined), 47)
  let entries = List<Bytes>.asSlice(&parts)
  let mut kept = List<usize>.make()
  let mut at: usize = 0
  while at < entries.length {
    let name = Bytes.asSlice(&entries[at])
    if same(name, b"..") {
      let _removed = List<usize>.pop(&mut kept)
    } else if !same(name, b".") {
      run List<usize>.append(&mut kept, at)
    }
    at = at + 1
  }
  let mut text = Bytes.make()
  let indexes = List<usize>.asSlice(&kept)
  at = 0
  while at < indexes.length {
    run Bytes.append(&mut text, b"/")
    run Bytes.append(&mut text, Bytes.asSlice(&entries[indexes[at]]))
    at = at + 1
  }
  if Bytes.length(&text) == 0 { run Bytes.append(&mut text, b"/") }
  return move text
}

/// The names of the entries of the directory at `spelled`, sorted; empty when it cannot be listed.
pub effect fn entries(spelled: &[u8]) -> List<Bytes> ! TaskError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut names = List<Bytes>.make()
  let directory = run path(spelled)
  let found = match move run Effect.result(FileSystem.listDirectory(&directory)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unreadable => {
        drop unreadable
        return move names
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let listed = List<DirectoryEntry>.asSlice(&found)
  let mut at: usize = 0
  while at < listed.length {
    run List<Bytes>.append(&mut names, run Bytes.copy(baseName(Path.rawBytes(&listed[at].path))))
    at = at + 1
  }
  return move names
}

/// Whether a file or directory is at `spelled`.
pub effect fn exists(spelled: &[u8]) -> bool ! TaskError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let target = run path(spelled)
  return match move run Effect.result(FileSystem.exists(&target)) {
    Result<bool, FileError>.Success { value } => value
    Result<bool, FileError>.Failure { error } => {
      drop error
      false
    }
  }
}

/// The length in bytes of the file at `spelled`, or -1 when there is no file there.
pub effect fn fileSize(spelled: &[u8]) -> i64 ! TaskError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let target = run path(spelled)
  let missing: i64 = 0 - 1
  return match move run Effect.result(FileSystem.stat(&target)) {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      FileInfo info => usize.toI64(info.byteLength)
      DirectoryInfo directory => {
        drop directory
        missing
      }
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
      missing
    }
  }
}

/// The bytes of the file at `spelled`, or empty when it cannot be read.
pub effect fn readOrEmpty(spelled: &[u8]) -> Bytes ! TaskError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let target = run path(spelled)
  return match move run Effect.result(FileSystem.readFile(&target)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError missing => {
        drop missing
        Bytes.make()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

/// Writes `bytes` to the file at `spelled`, creating its directories.
pub effect fn write(spelled: &[u8], bytes: &[u8]) -> () ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let target = run path(spelled)
  run FileSystem.writeFileWithParents(&target, bytes)
}

/// Creates the directory at `spelled` and its parents.
pub effect fn makeDirectories(spelled: &[u8]) -> () ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let target = run path(spelled)
  run FileSystem.createDirectoriesRecursively(&target)
}

/// The value of the environment variable `name`, or empty.
pub effect fn variable(name: &[u8]) -> Bytes ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  return match move run HostInput.variable(name) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => Bytes.make()
  }
}

/// `given` when it is set, else the environment variable `name` when it is set, else `fallback`.
pub effect fn chosen(given: &Option<Bytes>, name: &[u8], fallback: &[u8]) -> Bytes
  ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  match &given.* {
    Option<Bytes>.Some { value } => { return run Bytes.copy(Bytes.asSlice(&value)) }
    Option<Bytes>.None => {}
  }
  let fromEnvironment = run variable(name)
  if Bytes.length(&fromEnvironment) > 0 { return move fromEnvironment }
  return run Bytes.copy(fallback)
}

/// The executable `written` names: a path when it holds a `/` (relative ones under `base`), else
/// the first file of that name in a directory of `PATH`. Empty when there is none.
pub effect fn locate(written: &[u8], base: &[u8]) -> Bytes
  ! TaskError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  if contains(written, b"/") {
    let candidate = run absolute(base, written)
    if run exists(Bytes.asSlice(&candidate)) { return move candidate }
    return Bytes.make()
  }
  let searched = run variable(b"PATH")
  let directories = run split(Bytes.asSlice(&searched), 58)
  let entries = List<Bytes>.asSlice(&directories)
  let mut at: usize = 0
  while at < entries.length {
    let directory = Bytes.asSlice(&entries[at])
    if directory.length > 0 && directory[0] == 47 {
      let candidate = run cat3(directory, b"/", written)
      let size = run fileSize(Bytes.asSlice(&candidate))
      if size >= 0 { return move candidate }
    }
    at = at + 1
  }
  return Bytes.make()
}

// ---------------------------------------------------------------- processes

/// Where a stream of a child goes.
pub struct Stream {
  // 0: /dev/null, 1: the task's own stream, 2: a file.
  kind: u8,
  file: Bytes,
}

impl Stream {
  /// Discarded.
  pub fn none() -> Stream { return Stream { kind: 0, file: Bytes.make() } }
  /// The task's own stream.
  pub fn shared() -> Stream { return Stream { kind: 1, file: Bytes.make() } }
  /// Written to the file at `spelled`, which is replaced.
  pub effect fn toFile(spelled: &[u8]) -> Stream ! OutOfMemoryError ? &mut Allocator {
    return Stream { kind: 2, file: run Bytes.copy(spelled) }
  }
}

/// A program to run: its arguments, the variables it gets beside the cleaned environment, where it
/// starts and where its output goes.
pub struct Job {
  /// The program and its arguments. The program is a path, or a name looked up on `PATH`.
  pub words: List<Bytes>,
  /// `NAME=value` settings added to the environment, replacing variables of the same name.
  pub settings: List<Bytes>,
  /// The working directory; empty means the task's.
  pub directory: Bytes,
  /// Standard output.
  pub output: Stream,
  /// Standard error.
  pub errors: Stream,
}

impl Job {
  /// A job with no arguments yet, whose output is discarded.
  pub fn make() -> Job {
    return Job {
      words: List<Bytes>.make(),
      settings: List<Bytes>.make(),
      directory: Bytes.make(),
      output: Stream.none(),
      errors: Stream.none(),
    }
  }

  /// Adds one word of the command line.
  pub effect fn word(self: &mut Job, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<Bytes>.append(&mut self.words, run Bytes.copy(value))
  }

  /// Adds each of `values` as a word.
  pub effect fn wordsOf(self: &mut Job, values: &List<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
    let entries = List<Bytes>.asSlice(values)
    let mut at: usize = 0
    while at < entries.length {
      run Job.word(&mut self.*, Bytes.asSlice(&entries[at]))
      at = at + 1
    }
  }

  /// Sets the environment variable `name` to `value` for this job.
  pub effect fn set(self: &mut Job, name: &[u8], value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<Bytes>.append(&mut self.settings, run cat3(name, b"=", value))
  }

  /// Starts the job in `directory`.
  pub effect fn within(self: &mut Job, directory: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    self.directory = run Bytes.copy(directory)
  }

  /// The command line as one text, for a report.
  pub effect fn shown(self: &Job) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    return run join(&self.words, b" ")
  }
}

/// A started job.
pub struct Running {
  /// The process ID.
  pub pid: i32,
  started: i64,
}

/// How a job ended, and what it used.
pub struct Ended {
  /// Whether it exited with status 0.
  pub ok: bool,
  /// The exit status, or 128 plus the signal's number.
  pub status: i32,
  /// Wall time from start to exit, in milliseconds.
  pub wallMs: f64,
  /// User CPU time in milliseconds.
  pub userMs: f64,
  /// System CPU time in milliseconds.
  pub systemMs: f64,
  /// Peak resident set size in megabytes.
  pub rssMb: f64,
  /// Minor and major page faults.
  pub faults: i64,
}

/// Monotonic time in nanoseconds.
pub fn now() -> i64 {
  let mut time = [TimeSpec { seconds: 0, nanos: 0 }]
  let _result = unsafe clock_gettime(1, Pointer.fromMutSlice<TimeSpec>(&mut time))
  return time[0].seconds * 1000000000 + time[0].nanos
}

/// Seconds since 1970.
pub fn wallClock() -> i64 {
  let mut time = [TimeSpec { seconds: 0, nanos: 0 }]
  let _result = unsafe clock_gettime(0, Pointer.fromMutSlice<TimeSpec>(&mut time))
  return time[0].seconds
}

/// Waits `milliseconds`.
pub fn sleep(milliseconds: u32) -> () {
  let _result = unsafe usleep(milliseconds * 1000)
  return ()
}

// Variables a container may export that change what is measured: the cloud container exports
// BUN_OPTIONS=--smol, which makes Bun about 25% slower, and NODE_OPTIONS=--use-openssl-ca,
// which the runtime rejects.
fn dropped(name: &[u8]) -> bool {
  return same(name, b"BUN_OPTIONS") || same(name, b"NODE_OPTIONS")
}

fn settingName(setting: &[u8]) -> &[u8] {
  let mut at: usize = 0
  while at < setting.length && setting[at] != 61 { at = at + 1 }
  return Slice.view<u8>(setting, 0, at)
}

fn overridden(settings: &[Bytes], name: &[u8]) -> bool {
  let mut at: usize = 0
  while at < settings.length {
    if same(settingName(Bytes.asSlice(&settings[at])), name) { return true }
    at = at + 1
  }
  return false
}

// Opens the file a stream names, or /dev/null; -1 for the task's own stream.
effect fn opened(stream: &Stream, forInput: bool) -> i32 ! TaskError | OutOfMemoryError ? &mut Allocator {
  if stream.kind == 1 { return -1 }
  let mut name = if stream.kind == 2 { run Bytes.copy(Bytes.asSlice(&stream.file)) } else { run Bytes.copy(b"/dev/null") }
  run Bytes.append(&mut name, b"\0")
  // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC on Linux; O_RDONLY | O_CLOEXEC for input.
  let flags: i32 = if forInput { 524288 } else { 1 + 64 + 512 + 524288 }
  let fd = unsafe open(Pointer.fromSlice<u8>(Bytes.asSlice(&name)), flags, 420)
  if fd < 0 { run abort(b"cannot open ", Bytes.asSlice(&stream.file)) }
  return fd
}

/// Starts `job` with the cleaned environment: the task's own without `BUN_OPTIONS` and
/// `NODE_OPTIONS`, `SILKJS_PREPARSE_THREADS=0`, and the job's settings.
pub effect fn start(job: &Job) -> Running
  ! TaskError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let words = List<Bytes>.asSlice(&job.words)
  if words.length == 0 { run abort(b"a job has no program", b"") }
  let working = run HostInput.workingDirectory()
  let located = run locate(Bytes.asSlice(&words[0]), Bytes.asSlice(&working))
  if Bytes.length(&located) == 0 { run abort(b"cannot find the program ", Bytes.asSlice(&words[0])) }
  let program = run path(Bytes.asSlice(&located))
  let mut request = if Bytes.length(&job.directory) > 0 {
    let directory = run path(Bytes.asSlice(&job.directory))
    run ChildProcess.requestWithin(&program, &directory)
  } else {
    run ChildProcess.request(&program)
  }
  let mut at: usize = 1
  while at < words.length {
    run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&words[at]))
    at = at + 1
  }
  let settings = List<Bytes>.asSlice(&job.settings)
  let names = run HostInput.variableNames()
  let inherited = List<Bytes>.asSlice(&names)
  at = 0
  while at < inherited.length {
    let name = Bytes.asSlice(&inherited[at])
    if !dropped(name) && !same(name, b"SILKJS_PREPARSE_THREADS") && !overridden(settings, name) {
      let value = run variable(name)
      run ChildProcess.setVariableBytes(&mut request, name, Bytes.asSlice(&value))
    }
    at = at + 1
  }
  // The comparison is single threaded: no background parse threads in silkjs.
  if !overridden(settings, b"SILKJS_PREPARSE_THREADS") {
    run ChildProcess.setVariableBytes(&mut request, b"SILKJS_PREPARSE_THREADS", b"0")
  }
  at = 0
  while at < settings.length {
    let setting = Bytes.asSlice(&settings[at])
    let name = settingName(setting)
    // A later setting of the same name wins.
    let mut last = true
    let mut later = at + 1
    while later < settings.length {
      if same(settingName(Bytes.asSlice(&settings[later])), name) { last = false }
      later = later + 1
    }
    if last && name.length < setting.length {
      run ChildProcess.setVariableBytes(&mut request, name, Slice.view<u8>(setting, name.length + 1, setting.length - name.length - 1))
    }
    at = at + 1
  }
  let input = run opened(&Stream.none(), true)
  let output = run opened(&job.output, false)
  let errors = run opened(&job.errors, false)
  let mut options = SpawnOptions.make()
  run SpawnOptions.setStdio(&mut options, 0, Stdio.inherit(input))
  run SpawnOptions.setStdio(&mut options, 1, Stdio.inherit(if output < 0 { 1 } else { output }))
  run SpawnOptions.setStdio(&mut options, 2, Stdio.inherit(if errors < 0 { 2 } else { errors }))
  let started = now()
  let spawned = run Effect.result(Subprocess.spawn(&request, &options))
  let _closedInput = unsafe close(input)
  if output >= 0 { let _closedOutput = unsafe close(output) }
  if errors >= 0 { let _closedErrors = unsafe close(errors) }
  let child = match move spawned {
    Result<Subprocess, SubprocessError | OutOfMemoryError>.Success { value } => move value
    Result<Subprocess, SubprocessError | OutOfMemoryError>.Failure { error } => match move error {
      SubprocessError refused => {
        drop refused
        run abort(b"cannot start ", Bytes.asSlice(&located))
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let pid = Subprocess.pid(&child)
  drop child
  return Running { pid: pid, started: started }
}

/// Waits for a started job to end, and answers how it ended and what it used.
pub fn finish(running: &Running) -> Ended {
  let mut status = [0]
  let mut usage = [ResourceUsage {
    user: TimeVal { seconds: 0, micros: 0 },
    system: TimeVal { seconds: 0, micros: 0 },
    maxRss: 0, sharedText: 0, unsharedData: 0, unsharedStack: 0, minorFaults: 0, majorFaults: 0, swaps: 0,
    blocksIn: 0, blocksOut: 0, messagesSent: 0, messagesReceived: 0, signals: 0, voluntarySwitches: 0,
    involuntarySwitches: 0,
  }]
  let mut collected: i32 = -1
  // A wait that a signal interrupted is repeated; one that fails for another reason fails again.
  let mut tries: u32 = 0
  while collected < 0 && tries < 1000 {
    collected = unsafe wait4(running.pid, Pointer.fromMutSlice<i32>(&mut status), 0, Pointer.fromMutSlice<ResourceUsage>(&mut usage))
    tries = tries + 1
  }
  let ended = now()
  let raw = status[0]
  let signal = raw & 127
  let code: i32 = if signal == 0 { (raw / 256) % 256 } else { 128 + signal }
  return Ended {
    ok: collected > 0 && code == 0,
    status: code,
    wallMs: i64.toF64(ended - running.started) / 1000000.0,
    userMs: i64.toF64(usage[0].user.seconds) * 1000.0 + i64.toF64(usage[0].user.micros) / 1000.0,
    systemMs: i64.toF64(usage[0].system.seconds) * 1000.0 + i64.toF64(usage[0].system.micros) / 1000.0,
    // ru_maxrss is in kilobytes on Linux.
    rssMb: i64.toF64(usage[0].maxRss) / 1024.0,
    faults: usage[0].minorFaults + usage[0].majorFaults,
  }
}

/// Ends a started job with SIGKILL and collects it.
pub fn stop(running: &Running) -> Ended {
  let _sent = unsafe kill(running.pid, 9)
  return finish(running)
}

/// Runs `job` to its end.
pub effect fn runJob(job: &Job) -> Ended
  ! TaskError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let running = run start(job)
  return finish(&running)
}

/// Runs `job` to its end and fails the task when it does not exit with status 0.
pub effect fn must(job: &Job) -> ()
  ! TaskError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let ended = run runJob(job)
  if !ended.ok {
    let shown = run Job.shown(job)
    let mut message = run cat(Bytes.asSlice(&shown), b" failed with status ")
    run appendInteger(&mut message, i32.toI64(ended.status))
    run abort(Bytes.asSlice(&message), b"")
  }
}

/// What a job wrote, with how it ended.
pub struct Captured {
  /// How the job ended.
  pub ended: Ended,
  /// Standard output followed by standard error.
  pub text: Bytes,
}

/// Runs `job` to its end with its output and errors collected through files under `scratch`,
/// a directory that exists.
pub effect fn capture(job: &mut Job, scratch: &[u8]) -> Captured
  ! TaskError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let outputFile = run cat(scratch, b"/.stdout")
  let errorsFile = run cat(scratch, b"/.stderr")
  job.output = run Stream.toFile(Bytes.asSlice(&outputFile))
  job.errors = run Stream.toFile(Bytes.asSlice(&errorsFile))
  let ended = run runJob(&job.*)
  let mut text = run readOrEmpty(Bytes.asSlice(&outputFile))
  let errors = run readOrEmpty(Bytes.asSlice(&errorsFile))
  run Bytes.append(&mut text, Bytes.asSlice(&errors))
  return Captured { ended: move ended, text: move text }
}

/// Runs a setup command, echoed first, with the task's own output; fails the task when it fails.
pub effect fn sh(words: &[&[u8]], directory: &[u8]) -> ()
  ! TaskError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut job = Job.make()
  let mut at: usize = 0
  while at < words.length {
    run Job.word(&mut job, words[at])
    at = at + 1
  }
  if directory.length > 0 { run Job.within(&mut job, directory) }
  job.output = Stream.shared()
  job.errors = Stream.shared()
  let shown = run Job.shown(&job)
  run say2(b"   $ ", Bytes.asSlice(&shown))
  run must(&job)
}

/// Runs a command quietly and answers whether it exited with status 0.
pub effect fn succeeds(words: &[&[u8]], directory: &[u8]) -> bool
  ! TaskError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut job = Job.make()
  let mut at: usize = 0
  while at < words.length {
    run Job.word(&mut job, words[at])
    at = at + 1
  }
  if directory.length > 0 { run Job.within(&mut job, directory) }
  let located = run locate(words[0], directory)
  if Bytes.length(&located) == 0 { return false }
  let ended = run runJob(&job)
  return ended.ok
}

/// The first line a command writes to standard output, without its newline; empty when it fails.
pub effect fn firstLine(words: &[&[u8]], scratch: &[u8]) -> Bytes
  ! TaskError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut job = Job.make()
  let mut at: usize = 0
  while at < words.length {
    run Job.word(&mut job, words[at])
    at = at + 1
  }
  let captured = run capture(&mut job, scratch)
  if !captured.ended.ok { return Bytes.make() }
  let text = Bytes.asSlice(&captured.text)
  let end = find(text, b"\n", 0)
  return run Bytes.copy(part(text, 0, end))
}

// ---------------------------------------------------------------- before a measurement

// A process name that means a build is running. A build takes every CPU, so nothing measured
// beside it counts.
fn builder(name: &[u8]) -> bool {
  return same(name, b"silkc") || same(name, b"clang") || same(name, b"clang++") || startsWith(name, b"clang-")
    || same(name, b"cc1") || same(name, b"cc1plus") || same(name, b"ld.lld") || same(name, b"lld")
    || same(name, b"llvm") || same(name, b"wasm-ld") || same(name, b"make") || same(name, b"ninja")
    || same(name, b"cargo") || same(name, b"rustc")
}

fn baseName(spelled: &[u8]) -> &[u8] {
  let mut start: usize = 0
  let mut at: usize = 0
  while at < spelled.length {
    if spelled[at] == 47 { start = at + 1 }
    at = at + 1
  }
  return Slice.view<u8>(spelled, start, spelled.length - start)
}

/// The command lines of processes that look like a build in progress, one per line.
pub effect fn runningBuilds() -> Bytes
  ! TaskError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut found = Bytes.make()
  let proc = run path(b"/proc")
  let entries = match move run Effect.result(FileSystem.listDirectory(&proc)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unreadable => {
        drop unreadable
        return move found
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let listed = List<DirectoryEntry>.asSlice(&entries)
  let mut at: usize = 0
  while at < listed.length {
    let spelled = Path.rawBytes(&listed[at].path)
    let name = baseName(spelled)
    if name.length > 0 && isDigit(name[0]) {
      let file = run cat(spelled, b"/cmdline")
      let line = run readOrEmpty(Bytes.asSlice(&file))
      let words = Bytes.asSlice(&line)
      let first = find(words, b"\0", 0)
      let program = baseName(part(words, 0, first))
      // `silk build`, `silk test` and `silk check` compile; `silk task` is this program.
      let rest = part(words, first, words.length)
      let silk = same(program, b"silk") && (contains(rest, b"\0build\0") || contains(rest, b"\0test\0") || contains(rest, b"\0check\0"))
      if builder(program) || silk {
        run Bytes.append(&mut found, b"  ")
        run Bytes.append(&mut found, name)
        run Bytes.append(&mut found, b": ")
        let mut shown: usize = 0
        while shown < words.length && shown < 110 {
          let value = [if words[shown] == 0 { 32 } else { words[shown] }]
          run Bytes.append(&mut found, &value)
          shown = shown + 1
        }
        run Bytes.append(&mut found, b"\n")
      }
    }
    at = at + 1
  }
  return move found
}

/// Never build while benchmarking: fails the task when a compiler is running, and warns when the
/// host is busy (the load average also counts a benchmark that has just ended). With `force` a
/// running build is a warning too.
pub effect fn refuseWhileBuilding(force: bool) -> ()
  ! TaskError | OutOfMemoryError | WriterError ? &mut Allocator | &mut FileSystem {
  let mut loads = [0.0, 0.0, 0.0]
  let _count = unsafe getloadavg(Pointer.fromMutSlice<f64>(&mut loads), 3)
  // _SC_NPROCESSORS_ONLN
  let cpus = unsafe sysconf(84)
  if loads[0] > 0.5 * i64.toF64(cpus) {
    let mut busy = run Bytes.copy(b"the 1-minute load average is ")
    run appendFixed(&mut busy, loads[0], 2)
    run Bytes.append(&mut busy, b" on ")
    run appendInteger(&mut busy, cpus)
    run warn(Bytes.asSlice(&busy), b" CPUs: if anything but a benchmark that just ended is running, the numbers will not be comparable")
  }
  let builds = run runningBuilds()
  if Bytes.length(&builds) == 0 { return () }
  if force {
    run warn(b"measuring while a build is running (--force):\n", Bytes.asSlice(&builds))
    return ()
  }
  run abort(Bytes.asSlice(&(run cat(b"a build is running:\n", Bytes.asSlice(&builds)))), b"Wait for it to finish, or pass --force to measure anyway (the numbers will not be comparable).")
}

/// Fails the task unless servers can be pinned to CPU 0 and clients to CPUs 2 and 3.
pub effect fn requirePinning() -> ()
  ! TaskError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let working = run HostInput.workingDirectory()
  let taskset = run locate(b"taskset", Bytes.asSlice(&working))
  if Bytes.length(&taskset) == 0 {
    run abort(b"taskset is missing (util-linux): the server benchmarks pin servers and clients to separate CPUs", b"")
  }
  let server = run succeeds(&[b"taskset", b"-c", b"0", b"true"], b"")
  let clients = run succeeds(&[b"taskset", b"-c", b"2,3", b"true"], b"")
  if !server || !clients {
    run abort(b"CPUs 0, 2 and 3 are needed (server on 0, wrk and clients on 2,3) and this process may not run on them. ", b"Use a host with at least 4 CPUs.")
  }
}

/// Fails the task for no rounds, and warns below `least`.
pub effect fn checkRounds(rounds: u32, least: u32) -> () ! TaskError | OutOfMemoryError | WriterError ? &mut Allocator {
  if rounds < 1 { run abort(b"rounds must be at least 1", b"") }
  if rounds < least {
    let mut text = run integer(u32.toI64(rounds))
    run Bytes.append(&mut text, b" round(s): host wall time swings about 8%, so take at least ")
    run appendInteger(&mut text, u32.toI64(least))
    run warn(Bytes.asSlice(&text), b" before comparing numbers")
  }
}

/// A sequence of pseudo-random numbers for shuffling, seeded from the clock.
pub struct Shuffler {
  state: u64,
}

impl Shuffler {
  /// A shuffler seeded from the monotonic clock.
  pub fn make() -> Shuffler {
    return Shuffler { state: i64.wrappingToU64(now()) | 1 }
  }

  /// The next number below `bound`, which is at least 1.
  pub fn below(self: &mut Shuffler, bound: usize) -> usize {
    // xorshift64
    let mut value = self.state
    value = value ^ u64.shiftLeft(value, 13)
    value = value ^ u64.shiftRight(value, 7)
    value = value ^ u64.shiftLeft(value, 17)
    self.state = value
    return u64.wrappingToUsize(value % usize.toU64(bound))
  }

  /// The numbers 0 up to `count` in a random order.
  pub effect fn order(self: &mut Shuffler, count: usize) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
    let mut order = List<usize>.make()
    let mut at: usize = 0
    while at < count {
      run List<usize>.append(&mut order, at)
      at = at + 1
    }
    let slots = List<usize>.asMutSlice(&mut order)
    let mut last = count
    while last > 1 {
      let pick = Shuffler.below(&mut self.*, last)
      let held = slots[last - 1]
      slots[last - 1] = slots[pick]
      slots[pick] = held
      last = last - 1
    }
    return move order
  }
}

// ---------------------------------------------------------------- result tables

/// One measured value: `row` is a benchmark, `column` a runtime or an engine.
pub struct Cell {
  /// The benchmark.
  pub row: Bytes,
  /// The runtime or engine.
  pub column: Bytes,
  /// The value.
  pub value: f64,
}

/// Measured values by benchmark and column, in the order they were added.
pub struct Table {
  /// The values.
  pub cells: List<Cell>,
}

impl Table {
  /// An empty table.
  pub fn make() -> Table { return Table { cells: List<Cell>.make() } }

  /// Adds one value.
  pub effect fn add(self: &mut Table, row: &[u8], column: &[u8], value: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<Cell>.append(&mut self.cells, Cell { row: run Bytes.copy(row), column: run Bytes.copy(column), value: value })
  }

  /// The distinct benchmarks, in first-seen order.
  pub effect fn rows(self: &Table) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let mut names = List<Bytes>.make()
    let cells = List<Cell>.asSlice(&self.cells)
    let mut at: usize = 0
    while at < cells.length {
      if !listed(&names, Bytes.asSlice(&cells[at].row)) {
        run List<Bytes>.append(&mut names, run Bytes.copy(Bytes.asSlice(&cells[at].row)))
      }
      at = at + 1
    }
    return move names
  }

  /// The distinct columns, in first-seen order.
  pub effect fn columns(self: &Table) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let mut names = List<Bytes>.make()
    let cells = List<Cell>.asSlice(&self.cells)
    let mut at: usize = 0
    while at < cells.length {
      if !listed(&names, Bytes.asSlice(&cells[at].column)) {
        run List<Bytes>.append(&mut names, run Bytes.copy(Bytes.asSlice(&cells[at].column)))
      }
      at = at + 1
    }
    return move names
  }

  /// The values of one benchmark and column.
  pub effect fn values(self: &Table, row: &[u8], column: &[u8]) -> List<f64> ! OutOfMemoryError ? &mut Allocator {
    let mut found = List<f64>.make()
    let cells = List<Cell>.asSlice(&self.cells)
    let mut at: usize = 0
    while at < cells.length {
      if same(Bytes.asSlice(&cells[at].row), row) && same(Bytes.asSlice(&cells[at].column), column) {
        run List<f64>.append(&mut found, cells[at].value)
      }
      at = at + 1
    }
    return move found
  }

  /// The table as JSON: `{"benchmark": {"column": [values]}}`.
  pub effect fn json(self: &Table) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut text = run Bytes.copy(b"{")
    let rows = run Table.rows(self)
    let columns = run Table.columns(self)
    let rowNames = List<Bytes>.asSlice(&rows)
    let columnNames = List<Bytes>.asSlice(&columns)
    let mut r: usize = 0
    while r < rowNames.length {
      run Bytes.append(&mut text, if r > 0 { b",\n \"" } else { b"\n \"" })
      run Bytes.append(&mut text, Bytes.asSlice(&rowNames[r]))
      run Bytes.append(&mut text, b"\": {")
      let mut first = true
      let mut c: usize = 0
      while c < columnNames.length {
        let found = run Table.values(self, Bytes.asSlice(&rowNames[r]), Bytes.asSlice(&columnNames[c]))
        let values = List<f64>.asSlice(&found)
        if values.length > 0 {
          run Bytes.append(&mut text, if first { b"\n  \"" } else { b",\n  \"" })
          first = false
          run Bytes.append(&mut text, Bytes.asSlice(&columnNames[c]))
          run Bytes.append(&mut text, b"\": [")
          let mut v: usize = 0
          while v < values.length {
            if v > 0 { run Bytes.append(&mut text, b", ") }
            run appendFixed(&mut text, values[v], 3)
            v = v + 1
          }
          run Bytes.append(&mut text, b"]")
        }
        c = c + 1
      }
      run Bytes.append(&mut text, b"\n }")
      r = r + 1
    }
    run Bytes.append(&mut text, b"\n}\n")
    return move text
  }

  /// Reads a table from the JSON that [`Table.json`] writes. Anything else gives what could be read.
  pub effect fn parse(text: &[u8]) -> Table ! OutOfMemoryError ? &mut Allocator {
    let mut table = Table.make()
    let mut depth: usize = 0
    let mut row = Bytes.make()
    let mut column = Bytes.make()
    let mut at: usize = 0
    while at < text.length {
      let value = text[at]
      if value == 123 {
        depth = depth + 1
        at = at + 1
      } else if value == 125 {
        if depth > 0 { depth = depth - 1 }
        at = at + 1
      } else if value == 34 {
        let end = find(text, b"\"", at + 1)
        if depth == 1 { row = run Bytes.copy(part(text, at + 1, end)) } else { column = run Bytes.copy(part(text, at + 1, end)) }
        at = end + 1
      } else if isDigit(value) && depth == 2 {
        let end = numberEnd(text, at)
        run Table.add(&mut table, Bytes.asSlice(&row), Bytes.asSlice(&column), number(part(text, at, end)))
        at = end
      } else {
        at = at + 1
      }
    }
    return move table
  }
}

/// `value`, or empty for none.
pub fn orEmpty(value: Option<Bytes>) -> Bytes {
  return match move value {
    Option<Bytes>.Some { value: given } => move given
    Option<Bytes>.None => Bytes.make()
  }
}

/// Installs the first of `packages` that apt has. The package lists of a fresh container are
/// often empty, so a failed first try refreshes them once. Answers whether one was installed.
pub effect fn aptInstall(packages: &[&[u8]]) -> bool
  ! TaskError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  if unsafe geteuid() != 0 {
    run abort(b"installing packages needs root; install one of them yourself and rerun: ", packages[0])
  }
  let mut refreshed = false
  while true {
    let mut at: usize = 0
    while at < packages.length {
      run say2(b"   $ apt-get install -y --no-install-recommends ", packages[at])
      if run succeeds(&[b"apt-get", b"install", b"-y", b"--no-install-recommends", packages[at]], b"") { return true }
      at = at + 1
    }
    if refreshed { break }
    run say(b"   $ apt-get update")
    let _updated = run succeeds(&[b"apt-get", b"update", b"-q"], b"")
    refreshed = true
  }
  return false
}

/// Downloads `url` to the file `target` unless it is there already.
pub effect fn download(url: &[u8], target: &[u8]) -> ()
  ! TaskError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let size = run fileSize(target)
  if size > 0 { return () }
  let partial = run cat(target, b".part")
  run sh(&[b"curl", b"-fsSL", b"--retry", b"4", b"-o", Bytes.asSlice(&partial), url], b"")
  run sh(&[b"mv", Bytes.asSlice(&partial), target], b"")
}

/// Whether `step` is to run: `only` is empty or names it.
pub fn wanted(only: &List<Bytes>, step: &[u8]) -> bool {
  return List<Bytes>.length(only) == 0 || listed(only, step)
}

/// Fails the task when `only` names a step that is not one of `known`.
pub effect fn checkNames(only: &List<Bytes>, known: &[&[u8]], what: &[u8]) -> () ! TaskError | OutOfMemoryError ? &mut Allocator {
  let names = List<Bytes>.asSlice(only)
  let mut at: usize = 0
  while at < names.length {
    let mut found = false
    let mut k: usize = 0
    while k < known.length {
      if same(known[k], Bytes.asSlice(&names[at])) { found = true }
      k = k + 1
    }
    if !found {
      let mut message = run cat3(b"unknown ", what, b" ")
      run Bytes.append(&mut message, Bytes.asSlice(&names[at]))
      run Bytes.append(&mut message, b"; known:")
      k = 0
      while k < known.length {
        run Bytes.append(&mut message, b" ")
        run Bytes.append(&mut message, known[k])
        k = k + 1
      }
      run abort(Bytes.asSlice(&message), b"")
    }
    at = at + 1
  }
}

/// Prints `   key: value`.
pub effect fn note(key: &[u8], value: &[u8]) -> () ! WriterError {
  run print(b"   ")
  run print(key)
  run print(b": ")
  run say(value)
}

/// Prints the variables that were dropped from the environment, if the task had any of them.
pub effect fn noteDropped() -> () ! HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator {
  let bun = run variable(b"BUN_OPTIONS")
  let node = run variable(b"NODE_OPTIONS")
  if Bytes.length(&bun) > 0 { run note(b"dropped from the environment", Bytes.asSlice(&(run cat(b"BUN_OPTIONS=", Bytes.asSlice(&bun))))) }
  if Bytes.length(&node) > 0 { run note(b"dropped from the environment", Bytes.asSlice(&(run cat(b"NODE_OPTIONS=", Bytes.asSlice(&node))))) }
}
