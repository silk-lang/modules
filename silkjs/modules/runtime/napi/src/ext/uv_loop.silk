  let list = unsafe phaseList(h.loop, h.kind)
  h.fired = unsafe Intrinsic.pointerRequalify<?extern "C" fn(*mut u8) -> (), extern "C" fn(*mut u8) -> ()>(callback)
  h.nextPhase = unsafe Pointer.read<?*mut Handle>(list)
  unsafe Pointer.write<?*mut Handle>(list, handle)
  drop h
  unsafe start(handle)
  return 0
}
unsafe fn phaseStop(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if (h.flags & ACTIVE) == 0 { return }
  let list = unsafe phaseList(h.loop, h.kind)
  let first = unsafe Pointer.read<?*mut Handle>(list)
  if same(first, handle) { unsafe Pointer.write<?*mut Handle>(list, h.nextPhase) }
  else {
    let mut cursor = first
    while !Pointer.isNull<Handle>(cursor) {
      let mut second = () let c = unsafe Pointer.borrowMut<(), Handle>(&mut second, unsafe nn(cursor))
      if same(c.nextPhase, handle) { c.nextPhase = h.nextPhase break }
      cursor = c.nextPhase
