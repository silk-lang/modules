//! The CLI's commands as words (`commands.silk`), and a headless run of a counter
//! (ui-tree-window's `runHeadless`) driven by a script of those commands.
import ui_inspect_server.commands { Command, parseCommand, requestLine, splitWords }
import ui_inspect_server.lib { Inspector }
import ui_tree_window.host { WindowClient, RunOptions, StartedGpu, runHeadless, runBench }
import ui_tree_window.platform_thread { Launched }
import ui_fixtures.fixtures as fixtures
import ui_tree.css
import ui_tree.css { px }
import ui_tree.legacy { UiTree, TreeError, Batch, Mutation, NodeKind, Attribute }
import ui_tree.mutation { Role, LISTEN_CLICK }
import ui_tree.node { Event, EventKind }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u32
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String, InvalidUtf8 }
import codec.png
import codec.png { PngError }
import codec.image { Image, ImageError }
import ui_tree.inspect { writeInt }

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_input { WindowsHostInput }
  import silk.platform.windows.path { WindowsPath }
} else {
  import silk.platform.native.host_input { NativeHostInput }
}

effect fn line(words: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut list = List<String>.make()
  drop run splitWords(words, &mut list)
  let mut problem = String.make()
  let mut out = String.make()
  match move run parseCommand(list.asSlice(), &mut problem) {
    Option<Command>.Some { value } => {
      let mut command = move value
      if !run requestLine(&mut command, &mut out, &mut problem) {
        return move problem
      }
    }
    Option<Command>.None => {
      return move problem
    }
  }
  return move out
}

effect fn wordsBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut words = List<String>.make()
  run Testing.expect(
    run splitWords("click --name \"Save as\" 'it''s'  # the rest is a comment", &mut words),
    "a line splits",
  )
  run Testing.expect(words.length() == 4, "into four words")
  run Testing.expect(String.view(&words.asSlice()[2]) == "Save as", "a quoted word keeps its space")
  run Testing.expect(String.view(&words.asSlice()[3]) == "its", "quotes next to each other join")
  words.clear()
  run Testing.expect(run splitWords("type \"say \\\"hi\\\"\"", &mut words), "escapes")
  run Testing.expect(String.view(&words.asSlice()[1]) == "say \"hi\"", "an escaped quote stays")
  run Testing.expect(!run splitWords("type \"open", &mut words), "an open quote is an error")

  let typed = run line("type \"hello world\" --test-id note")
  run Testing.expect(
    String.view(&typed) == "{\"id\":1,\"cmd\":\"type\",\"text\":\"hello world\",\"testId\":\"note\"}",
    "type becomes its request",
  )
  let extension = run line("screen-reader.set --flavor voiceover --on true --rate 2")
  run Testing.expect(
    String.view(&extension) == "{\"id\":1,\"cmd\":\"screen-reader.set\",\"flavor\":\"voiceover\",\"on\":true,\"rate\":2}",
    "an extension's own options become its request members",
  )
  let theirs = run line("click --flavor voiceover")
  run Testing.expect(String.view(&theirs) == "unknown option --flavor", "the inspector's commands keep their options")
  let clicked = run line("click --role button --name Save --count 2")
  run Testing.expect(
    String.view(&clicked) == "{\"id\":1,\"cmd\":\"click\",\"role\":\"button\",\"name\":\"Save\",\"count\":2}",
    "click becomes its request",
  )
  let pressed = run line("press")
  run Testing.expect(String.startsWith(String.view(&pressed), "press takes a key"), "why a command is wrong")
  let unknown = run line("click --colour red")
  run Testing.expect(String.view(&unknown) == "unknown option --colour", "an unknown option")
}

test effect fn cliCommandsAreWords() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run wordsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A headless run.

struct Counter {
  clicks: u32,
  /// Turns of the loop the counter still waits on outside work for, and the run's time when
  /// that wait ended.
  outside: u32,
  readyAt: f64,
  /// Turns of outside work that start at the first poll after the run's time moved, as a
  /// module asked for after the first one, and the run's time then.
  later: u32,
  laterAt: f64,
}

struct Client {}

impl WindowClient<Counter, never, never> for Client {
  effect fn poll(self: &mut Self, state: &mut Counter, tree: &mut UiTree<'_>, time: f64) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    if state.later > 0 && time > 0.0 {
      state.outside = state.later
      state.later = 0
      state.laterAt = time
    }
    if state.outside > 0 {
      state.outside = state.outside - 1
      if state.outside == 0 { state.readyAt = time }
    }
    return false
  }

  fn awaitsOutside(self: &Self, state: &Counter) -> bool { return state.outside > 0 }

  effect fn start(self: &mut Self, state: &mut Counter, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut batch = Batch.make()
    run batch.create(1, NodeKind.Box)
    run batch.root(1)
    run batch.box(1, 2, &[css.width(px(120.0)), css.height(px(40.0))])
    run batch.attribute(2, Attribute.TestId { value: run String.copy("counter") })
    run batch.attribute(2, Attribute.Role { value: Role.Button })
    run batch.push(Mutation.SetListeners { id: 2, flags: LISTEN_CLICK })
    run batch.text(2, 3, "0")
    run tree.apply(run batch.take())
  }

  effect fn pump(self: &mut Self, state: &mut Counter, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut events = List<Event>.make()
    run tree.takeEvents(&mut events)
    let values = events.asSlice()
    let mut i: usize = 0
    while i < values.length {
      if values[i].kind == EventKind.Click && values[i].target == 2 {
        state.clicks = state.clicks + 1
        let mut batch = Batch.make()
        run batch.setText(3, if state.clicks == 1 { "1" } else { "more" })
        run tree.apply(run batch.take())
      }
      i = i + 1
    }
  }
}

// Names under the working directory, where a headless run looks for relative files too:
// `/tmp` is not a path on Windows.
const SCRIPT: string = "ui-inspect-headless-test.txt"

const TREE: string = "ui-inspect-headless-test-tree.txt"

const SHOT: string = "ui-inspect-headless-test.png"

const FRAMES: string = "ui-inspect-headless-frames"

effect fn placed(name: string) -> Path
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut inputs = run WindowsHostInput.capture()
    let native = run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
    let parent = run WindowsPath.fromNativeBytes(native.asSlice())
    return run Path.resolve(&parent, name)
  } else {
    let native = run NativeHostInput.workingDirectory()
    let parent = run Path.fromBytes(native.asSlice())
    return run Path.resolve(&parent, name)
  }
}

effect fn writeText(path: string, text: string) -> ()
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let place = run placed(path)
  let mut files = run MachineFileSystem.make()
  run FileSystem.writeFile(&place, String.utf8Bytes(text)) |> Effect.provideMut<FileSystem>(&mut files)
}

effect fn readText(path: string) -> String
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let place = run placed(path)
  let mut files = run MachineFileSystem.make()
  let bytes = run FileSystem.readFile(&place) |> Effect.provideMut<FileSystem>(&mut files)
  return String.fromBytes(move bytes) |> Result<String, InvalidUtf8>.unwrapOr(String.make())
}

/// How a headless run of the counter ended.
struct Ran {
  status: i32,
  clicks: u32,
  readyAt: f64,
}

/// Runs the counter headless with `script`.
effect fn runCounter(script: string) -> Ran
  ! FileError | HostInputError | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  return run runCounterAfter(script, 0)
}

/// Runs the counter headless with `script`, after `outside` turns of waiting on outside work.
effect fn runCounterAfter(script: string, outside: u32) -> Ran
  ! FileError | HostInputError | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  run writeText(SCRIPT, script)
  let fonts = run fixtures.fonts()
  let mut state = Counter { clicks: 0, outside: outside, readyAt: -1.0, later: 0, laterAt: -1.0 }
  let mut client = Client {}
  let options = RunOptions {
    title: "Counter",
    width: 200.0,
    height: 100.0,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: Option<Launched>.None,
    gpu: Option<StartedGpu>.None,
  }
  let status = run runHeadless(
    &mut state,
    &fonts,
    List<Mutation>.make(),
    move options,
    Inspector.off(),
    &mut client,
    SCRIPT,
  )
  return Ran { status: status, clicks: state.clicks, readyAt: state.readyAt }
}

/// Runs the counter on the windowless bench for `frames` frames, after `outside` turns of
/// waiting on outside work, and answers the run's time when that wait ended. `later` turns of
/// outside work start once the run's time moves; the answer is then how far it moved during them.
effect fn benchCounterAfter(frames: u32, outside: u32, later: u32) -> f64
  ! FileError | HostInputError | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut state = Counter { clicks: 0, outside: outside, readyAt: -1.0, later: later, laterAt: -1.0 }
  let mut client = Client {}
  let options = RunOptions {
    title: "Counter",
    width: 200.0,
    height: 100.0,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: Option<Launched>.None,
    gpu: Option<StartedGpu>.None,
  }
  drop run runBench(&mut state, &fonts, List<Mutation>.make(), move options, Inspector.off(), &mut client, frames, -1.0, -1.0, 0.0)
  return if later > 0 { state.readyAt - state.laterAt } else { state.readyAt }
}

effect fn headlessBody() -> ()
  ! AssertionError<'static> | PngError | ImageError | FileError | HostInputError | WindowError | GpuError | TreeError | AtlasError
    | GeometryError
    | OutOfMemoryError
  ? &mut Allocator {
  let mut script = run String.copy("# two clicks, then what shows\nclick --test-id counter\n")
  run script.append("wait --text 1\nclick --test-id counter\nwait 100ms\nsnapshot ")
  run script.append(TREE)
  run script.append("\nscreenshot ")
  run script.append(SHOT)
  run script.append("\nsize 300 120 2\n")
  let done = run runCounter(String.view(&script))
  run Testing.expect(done.status == 0 && done.clicks == 2, "the script ran to its end, clicking twice")
  let tree = run readText(TREE)
  run Testing.expect(String.contains(String.view(&tree), "\"more\""), "the snapshot shows the second click")
  let place = run placed(SHOT)
  let mut files = run MachineFileSystem.make()
  let shot = run FileSystem.readFile(&place) |> Effect.provideMut<FileSystem>(&mut files)
  run Testing.expect(shot.length() > 8 && shot.asSlice()[1] == 80, "the screenshot is a PNG")

  let failed = run runCounter("click --test-id counter\nclick --test-id nothing\nclick --test-id counter\n")
  run Testing.expect(failed.status == 1 && failed.clicks == 1, "a failing line ends the run")
  let waited = run runCounter("wait --text never\nclick --test-id counter\n")
  run Testing.expect(waited.status == 1 && waited.clicks == 0, "a wait that never holds gives up")
  let late = run runCounterAfter("click --test-id counter\n", 5)
  run Testing.expect(late.status == 0 && late.clicks == 1 && late.readyAt == 0.0, "outside work takes real time, not the run's")
  run Testing.expect((run benchCounterAfter(3, 5, 0)) == 0.0, "the bench's frames start once outside work is in")
  run Testing.expect((run benchCounterAfter(4, 0, 5)) == 0.0, "the bench's clock waits for outside work asked for later")
  run FileSystem.removeFile(&(run placed(SCRIPT))) |> Effect.provideMut<FileSystem>(&mut files)
  run FileSystem.removeFile(&(run placed(TREE))) |> Effect.provideMut<FileSystem>(&mut files)
  run FileSystem.removeFile(&place) |> Effect.provideMut<FileSystem>(&mut files)

  // A recording that shows its input: a ring where the pointer went down, the keys at the
  // bottom. The frames are kept as PNGs, which needs no ffmpeg.
  let mut recording = run String.copy("record ")
  run recording.append(FRAMES)
  run recording.append("/ --show-input\nclick --test-id counter\nwait 100ms\npress Enter\nwait 200ms\nstop\n")
  let recorded = run runCounter(String.view(&recording))
  run Testing.expect(recorded.status == 0 && recorded.clicks == 1, "the recorded script ran")
  let mut ringed = false
  let mut captioned = false
  let mut frame: u64 = 1
  while true {
    let mut name = run String.copy(FRAMES)
    run name.append("/")
    let mut digits = String.make()
    run writeInt(&mut digits, frame)
    let mut pad = String.byteLength(String.view(&digits))
    while pad < 6 {
      run name.append("0")
      pad = pad + 1
    }
    run name.append(String.view(&digits))
    run name.append(".png")
    let read = run Effect.result(FileSystem.readFile(&(run placed(String.view(&name)))))
      |> Effect.provideMut<FileSystem>(&mut files)
    let bytes = match move read {
      Result.Success { value } => move value
      Result.Failure { error } => {
        drop error
        break
      }
    }
    let image = run png.decode(bytes.asSlice())
    // The counter is 120 by 40 at the top left: the ring is centred on its middle.
    if bluish(&image, 60, 20) { ringed = true }
    // The caption sits at the bottom, in the middle.
    if dark(&image, 100, 70) { captioned = true }
    frame = frame + 1
  }
  run Testing.expect(frame > 10, "the recording kept its frames")
  run Testing.expect(ringed, "a frame shows the ring where the click went down")
  run Testing.expect(captioned, "a frame shows the key pressed")
  run FileSystem.removeDirectoryRecursively(&(run placed(FRAMES))) |> Effect.provideMut<FileSystem>(&mut files)
  run FileSystem.removeFile(&(run placed(SCRIPT))) |> Effect.provideMut<FileSystem>(&mut files)
}

fn pixelAt(image: &Image, x: u32, y: u32) -> usize {
  return u32.toUsize((y * image.width() + x) * 4)
}

fn bluish(image: &Image, x: u32, y: u32) -> bool {
  let at = pixelAt(image, x, y)
  let data = image.data()
  return u8.toU32(data[at + 2]) > u8.toU32(data[at]) + 20
}

fn dark(image: &Image, x: u32, y: u32) -> bool {
  let at = pixelAt(image, x, y)
  let data = image.data()
  return u8.toU32(data[at]) < 60 && u8.toU32(data[at + 1]) < 60
}

test effect fn aHeadlessRunFollowsItsScript() -> ()
  ! AssertionError<'static> | PngError | ImageError | FileError | HostInputError | WindowError | GpuError | TreeError | AtlasError
    | GeometryError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run headlessBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
