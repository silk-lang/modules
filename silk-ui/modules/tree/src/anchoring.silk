//! `Tree.anchor`: a popup placed against an anchor node, through CSS anchor positioning.
//! SetAnchor gives the popup `position: fixed`, the anchor node as its implicit anchor,
//! `position-area: bottom span-right` (or `span-left`) and `position-try-fallbacks:
//! flip-block`; `css_anchor` places it with the popup extras of `AnchorOptions` (a 4px
//! viewport margin, the gap, the preferred height, matching the anchor's width, and hiding
//! while there is no anchor). Put popup nodes after other content for painting and hit testing.
pub import ui_protocol.options { AnchorOptions }
import engine { UiTree, TreeError }
import node { NONE }
import mutation { NodeKind, Position, Overflow, BoxSizing }
import style { Computed }
import anchor_style { AnchorStyle, TRACK_START, TRACK_CENTER, TRACK_END, TRY_FLIP_BLOCK }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u8
import silk.num.usize

/// One retained anchor relationship. Configure it through tree mutations.
pub struct Anchored {
  /// Popup node ID.
  pub id: u32,
  /// Anchor node ID.
  pub target: u32,
  /// Placement preferences.
  pub options: AnchorOptions,
}

pub fn find(tree: &UiTree<'_>, id: u32) -> usize {
  let mut i: usize = 0
  while i < tree.anchors.length() {
    if tree.anchors.asSlice()[i].id == id {
      return i
    }
    i = i + 1
  }
  return usize.MAX
}

/// Installs a relationship after checking IDs, finite dimensions, and dependency cycles.
pub effect fn configure(
  tree: &mut UiTree<'_>,
  index: usize,
  id: u32,
  target: u32,
  options: AnchorOptions,
) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let slot = tree.slotOf(id)
  if slot == NONE {
    fail TreeError.UnknownNode { index: index, id: id }
  }
  let targetSlot = tree.slotOf(target)
  if targetSlot == NONE {
    fail TreeError.UnknownNode { index: index, id: target }
  }
  if tree.node(slot).kind != NodeKind.Box {
    fail TreeError.WrongKind { index: index, id: id }
  }
  if !f32.isFinite(options.gap) || options.gap < 0.0 || !f32.isFinite(options.preferredHeight)
    || options.preferredHeight < 0.0 {
    fail TreeError.BadMove { index: index, id: id }
  }
  let mut ancestor = targetSlot
  while ancestor != NONE {
    if ancestor == slot {
      fail TreeError.BadMove { index: index, id: id }
    }
    ancestor = tree.node(ancestor).parent
  }
  let mut next = target
  let mut limit = tree.anchors.length() + 1
  while limit > 0 {
    if next == id {
      fail TreeError.BadMove { index: index, id: id }
    }
    let at = find(&tree, next)
    if at == usize.MAX {
      break
    }
    next = tree.anchors.asSlice()[at].target
    limit = limit - 1
  }
  let at = find(&tree, id)
  if at == usize.MAX {
    run tree.anchors.append(
      Anchored { id: id, target: target, options: options },
    )
  } else {
    let entry = &mut tree.anchors.asMutSlice()[at]
    entry.target = target
    entry.options = options
  }
  tree.markStylesDirty(0)
}

/// Removes placement overrides. Client styles take effect at the next layout.
pub fn clear(tree: &mut UiTree<'_>, id: u32) -> () {
  let at = find(&tree, id)
  if at != usize.MAX {
    drop tree.anchors.remove(at)
    tree.markStylesDirty(1)
  }
}

/// The CSS a popup gets: `position: fixed`, `position-area: bottom span-right` (`span-left`
/// with `alignEnd`), `position-try-fallbacks: flip-block`, and a scrolling border box.
/// `css_anchor` places it against its anchor node.
pub fn apply(tree: &UiTree<'_>, id: u32, computed: &mut Computed) -> () {
  let at = find(tree, id)
  if at == usize.MAX {
    return ()
  }
  let options = tree.anchors.asSlice()[at].options
  let columns = if options.alignEnd { u8.bitOr(TRACK_START, TRACK_CENTER) } else { u8.bitOr(TRACK_CENTER, TRACK_END) }
  let mut style = AnchorStyle.none()
  style.area = u8.bitOr(TRACK_END, columns * 8)
  style.tries = TRY_FLIP_BLOCK
  computed.anchor = style
  computed.layout.position = Position.Fixed
  computed.layout.boxSizing = BoxSizing.BorderBox
  computed.layout.overflowX = Overflow.Auto
  computed.layout.overflowY = Overflow.Auto
}
