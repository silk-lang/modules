// Room for a pthread mutex, condition variable or attribute set on both targets (Linux 40/48/56,
// Darwin 64/48/64 bytes).
const LOCK_BYTES: usize = 128

static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn __error() -> *mut i32
  unsafe fn errno() -> i32 { return unsafe Pointer.read<i32>(unsafe __error()) }
  unsafe fn setErrno(value: i32) -> () { unsafe Pointer.write<i32>(unsafe __error(), value) }
  unsafe extern "C" fn _NSGetEnviron() -> *mut *const ?*const u8
  unsafe fn environAddress() -> ?*mut *const ?*const u8 { return unsafe _NSGetEnviron() }
  unsafe extern "C" fn pthread_setname_np(name: *const u8) -> i32
  unsafe fn setThreadName(name: *const u8) -> () { let _ignored = unsafe pthread_setname_np(name) }
  const MONOTONIC: i32 = 6
  const EAGAIN: i32 = 35
  const O_NONBLOCK: i32 = 4
  const O_CLOEXEC: i32 = 16777216
  const SA_RESTART: i32 = 2
  const SA_RESETHAND: i32 = 4
  const SIGCHLD: i32 = 20
  const SIGSTOP: i32 = 17
  const SIG_BLOCK: i32 = 1
  const SIG_SETMASK: i32 = 3
  const F_DUPFD_CLOEXEC: i32 = 67
  const ECHILD: i32 = 10
  // sigset_t is one 32-bit word; struct sigaction is { handler, mask, flags }.
  const SIGSET_BYTES: usize = 4
  extern "C" struct SignalAction { handler: extern "C" fn(i32) -> (), mask: u32, flags: i32 }
  extern "C" struct DefaultAction { handler: usize, mask: u32, flags: i32 }
  fn handlerAction(handler: extern "C" fn(i32) -> ()) -> SignalAction { return SignalAction { handler: handler, mask: 4294967295, flags: SA_RESTART } }
  fn defaultAction() -> DefaultAction { return DefaultAction { handler: 0, mask: 0, flags: 0 } }
  // The signals a forked child keeps deliverable until it resets them: KILL, STOP, TRAP, SEGV, BUS,
  // ILL, SYS and ABRT, as in libuv.
  fn forkMask(mask: &mut [u8; 128]) -> () {
    let keep: u32 = u32.shiftLeft(1, 8) | u32.shiftLeft(1, 16) | u32.shiftLeft(1, 4) | u32.shiftLeft(1, 10) | u32.shiftLeft(1, 9) | u32.shiftLeft(1, 3) | u32.shiftLeft(1, 11) | u32.shiftLeft(1, 5)
    let bits: u32 = 4294967295 ^ keep
    mask[0] = u32.toU8(bits & 255) mask[1] = u32.toU8(u32.shiftRight(bits, 8) & 255) mask[2] = u32.toU8(u32.shiftRight(bits, 16) & 255) mask[3] = u32.toU8(u32.shiftRight(bits, 24) & 255)
  }
} else {
  unsafe extern "C" fn __errno_location() -> *mut i32
  unsafe fn errno() -> i32 { return unsafe Pointer.read<i32>(unsafe __errno_location()) }
  unsafe fn setErrno(value: i32) -> () { unsafe Pointer.write<i32>(unsafe __errno_location(), value) }
  @foreign(noCapture: .("name"))
  unsafe extern "C" fn dlsym(handle: ?*mut u8, name: *const u8) -> ?*mut u8
  unsafe extern "C" fn pthread_setname_np(thread: usize, name: *const u8) -> i32
  unsafe fn setThreadName(name: *const u8) -> () { let _ignored = unsafe pthread_setname_np(unsafe pthread_self(), name) }
  unsafe fn environAddress() -> ?*mut *const ?*const u8 {
    let name = b"environ\0"
    return unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut *const ?*const u8>(unsafe dlsym(Pointer.null<u8>(), Pointer.fromRef<u8>(&name[0])))
  }
  const MONOTONIC: i32 = 1
  const EAGAIN: i32 = 11
  const O_NONBLOCK: i32 = 2048
  const O_CLOEXEC: i32 = 524288
  const SA_RESTART: i32 = 268435456
  const SA_RESETHAND: i32 = -2147483648
  const SIGCHLD: i32 = 17
  const SIGSTOP: i32 = 19
  const SIG_BLOCK: i32 = 0
  const SIG_SETMASK: i32 = 2
  const F_DUPFD_CLOEXEC: i32 = 1030
  const ECHILD: i32 = 10
  // glibc's sigset_t is 1024 bits; struct sigaction is { handler, mask, flags, restorer }.
  const SIGSET_BYTES: usize = 128
  extern "C" struct SignalAction { handler: extern "C" fn(i32) -> (), mask: [u64; 16], flags: i32, restorer: usize }
  extern "C" struct DefaultAction { handler: usize, mask: [u64; 16], flags: i32, restorer: usize }
  fn handlerAction(handler: extern "C" fn(i32) -> ()) -> SignalAction { return SignalAction { handler: handler, mask: [18446744073709551615; 16], flags: SA_RESTART, restorer: 0 } }
  fn defaultAction() -> DefaultAction { return DefaultAction { handler: 0, mask: [0; 16], flags: 0, restorer: 0 } }
  // The signals a forked child keeps deliverable until it resets them: KILL, STOP, TRAP, SEGV, BUS,
  // ILL, SYS and ABRT, as in libuv. Bit n-1 of the set is signal n.
  fn forkMask(mask: &mut [u8; 128]) -> () {
    let keep: u64 = u64.shiftLeft(1, 8) | u64.shiftLeft(1, 18) | u64.shiftLeft(1, 4) | u64.shiftLeft(1, 10) | u64.shiftLeft(1, 6) | u64.shiftLeft(1, 3) | u64.shiftLeft(1, 30) | u64.shiftLeft(1, 5)
    let bits: u64 = 18446744073709551615 ^ keep
    let mut index: usize = 0
    while index < 8 { mask[index] = u64.toU8(u64.shiftRight(bits, usize.toU64(index * 8)) & 255) index = index + 1 }
  }
}
const EINTR: i32 = 4
const F_GETFD: i32 = 1
const F_SETFD: i32 = 2
const F_GETFL: i32 = 3
const F_SETFL: i32 = 4
const FD_CLOEXEC: i32 = 1

// uv_poll's event bits.
const UV_READABLE: i32 = 1
const UV_WRITABLE: i32 = 2
const UV_DISCONNECT: i32 = 4
const UV_PRIORITIZED: i32 = 8

/// Every kind of handle is one record, so `uv_handle_size` is the same for all of them. `data`
/// is the caller's; the rest belongs to the loop.
struct Handle {
  data: ?*mut u8, loop: *mut Loop, kind: i32, flags: u32,
  previous: ?*mut Handle, next: ?*mut Handle, nextClosing: ?*mut Handle, closed: CloseCallback,
  // The descriptor in the kernel queue (poll), and the events it is registered for.
  fd: i32, registered: i32,
  woke: AsyncCallback, pending: u32, nextAsync: ?*mut Handle,
  caught: SignalCallback, signum: i32, caughtCount: u32, dispatchedCount: u32, nextSignal: ?*mut Handle,
  polled: PollCallback,
  exited: ExitCallback, pid: i32, status: i32, reaped: bool, nextProcess: ?*mut Handle,
  changed: FsEventCallback, watch: i32, nextWatch: ?*mut Handle, path: ?*mut u8, serial: u64,
  // A stat poll: its current context (PollContext), the newest first.
  statChanged: FsPollCallback, context: ?*mut u8,
  // A timer: its callback, when it is due, its repeat interval, its place among timers due at the
  // same time, and the next timer. Idle, prepare and check handles keep their callback in `fired`
  // and their place in `nextPhase`.
  fired: AsyncCallback, due: u64, repeat: u64, order: u64, nextTimer: ?*mut Handle, nextPhase: ?*mut Handle
}
/// A unit of thread-pool work, laid out as libuv's struct uv__work (work, done, loop, and the two
/// words of its queue node), so that it fits where a uv_work_t or uv_fs_t keeps one. The pool owns
/// the record from `workSubmit` until it calls `done` on the loop's thread.
pub extern "C" struct Work { pub work: ?extern "C" fn(*mut Work) -> (), pub done: ?extern "C" fn(*mut Work, i32) -> (), pub loop: ?*mut u8, pub next: ?*mut Work, pub previous: ?*mut Work }
impl Copy for Work {}
/// A deferred callback of the loop's pending phase (libuv's pending queue): `call(node)` runs at the
/// start of the next iteration. The caller owns the node; it must stay valid while queued.
pub extern "C" struct Pending { pub next: ?*mut Pending, pub call: ?extern "C" fn(*mut Pending) -> (), pub queued: u32, pub reserved: u32 }
struct Loop {
  // The embedder's word and the count of active referenced handles, first as in libuv's uv_loop_t.
  data: ?*mut u8, active: u32, reqs: u32,
  backend: i32, wakeRead: i32, wakeWrite: i32, signalRead: i32, signalWrite: i32, notify: i32,
  time: u64, stopped: bool, idleMetrics: bool, blockProfile: bool, idleTime: u64, entryTime: u64, serial: u64, timerCount: u64,
  loopCount: u64, events: u64, eventsWaiting: u64, waitTimeout: i32, waitReserved: i32,
  first: ?*mut Handle, last: ?*mut Handle, closing: ?*mut Handle, asyncs: ?*mut Handle, processes: ?*mut Handle, watches: ?*mut Handle, timers: ?*mut Handle,
  idles: ?*mut Handle, prepares: ?*mut Handle, checks: ?*mut Handle, ready: ?*mut Handle,
  child: ?*mut Handle,
  pendingFirst: ?*mut Pending, pendingLast: ?*mut Pending,
  // Finished thread-pool work, under `workLock` (a pthread mutex in calloc'd memory), and whether
  // the wake pipe was written for it.
  workLock: ?*mut u8, workFirst: ?*mut Work, workLast: ?*mut Work, workPending: u32, reserved: u32,
  // inotify watch descriptors to the first handle of each, open addressing (Linux).
  watchSlots: ?*mut u8, watchCapacity: usize, watchCount: usize,
  // Darwin: the kevent changes of poll and descriptor handles, applied by the next wait, as libuv's
  // kqueue backend hands its watcher changes to the wait.
  changes: ?*mut u8, changeCount: usize, changeCapacity: usize
}

export "C" fn silkUvNoClose(handle: *mut u8) -> () {}
export "C" fn silkUvNoSignal(handle: *mut u8, signal: i32) -> () {}
export "C" fn silkUvNoPoll(handle: *mut u8, status: i32, events: i32) -> () {}
export "C" fn silkUvNoExit(handle: *mut u8, code: i64, signal: i32) -> () {}
export "C" fn silkUvNoEvent(handle: *mut u8, name: ?*const u8, events: i32, status: i32) -> () {}
export "C" fn silkUvNoStat(handle: *mut u8, status: i32, previous: *const UvStat, current: *const UvStat) -> () {}

fn same(a: ?*mut Handle, b: *mut Handle) -> bool { return Pointer.address<Handle>(a) == Pointer.address<Handle>(b) }
unsafe fn nn<T>(pointer: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(pointer) }
unsafe fn handleOf(pointer: *mut u8) -> *mut Handle { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Handle>(pointer) }
unsafe fn handleOfConst(pointer: *const u8) -> *const Handle { return unsafe Intrinsic.pointerReinterpret<*const u8, *const Handle>(pointer) }
unsafe fn loopOf(pointer: *mut u8) -> *mut Loop { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Loop>(pointer) }
unsafe fn bytesOf(pointer: *mut Handle) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut Handle, *mut u8>(pointer) }
fn zeroTime() -> UvTimespec { return UvTimespec { tv_sec: 0, tv_nsec: 0 } }
fn zeroStat() -> UvStat {
  return UvStat { st_dev: 0, st_mode: 0, st_nlink: 0, st_uid: 0, st_gid: 0, st_rdev: 0, st_ino: 0, st_size: 0, st_blksize: 0, st_blocks: 0, st_flags: 0, st_gen: 0, st_atim: zeroTime(), st_mtim: zeroTime(), st_ctim: zeroTime(), st_birthtim: zeroTime() }
}

/// Monotonic nanoseconds, libuv's uv_hrtime, which is also the loop's clock (libuv's uv__hrtime):
/// on Darwin mach_continuous_time, as ext.uv_os, so that a timer never fires early by uv_hrtime.
pub unsafe fn hrtime() -> u64 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return unsafe uv_os.uv_hrtime() }
  let mut now = TimeSpec { seconds: 0, nanoseconds: 0 }
  let _ignored = unsafe clock_gettime(MONOTONIC, Pointer.fromMutRef<TimeSpec>(&mut now))
  return i64.toU64(now.seconds) * 1000000000 + i64.toU64(now.nanoseconds)
}
unsafe fn cloexec(fd: i32) -> () {
  let flags = unsafe fcntl(fd, F_GETFD)
  if flags >= 0 { let _ignored = unsafe fcntl(fd, F_SETFD, flags | FD_CLOEXEC) }
}
unsafe fn nonblocking(fd: i32, on: bool) -> () {
  let flags = unsafe fcntl(fd, F_GETFL)
  if flags < 0 { return }
  let wanted = if on { flags | O_NONBLOCK } else { flags & (O_NONBLOCK ^ -1) }
  if wanted != flags { let _ignored = unsafe fcntl(fd, F_SETFL, wanted) }
}
// A close-on-exec pipe; both ends nonblocking when `nonblock`.
unsafe fn makePipe(fds: &mut [i32; 2], nonblock: bool) -> i32 {
  if unsafe pipe(Pointer.fromMutRef<i32>(&mut fds[0])) != 0 { return -(unsafe errno()) }
  unsafe cloexec(fds[0]) unsafe cloexec(fds[1])
  if nonblock { unsafe nonblocking(fds[0], true) unsafe nonblocking(fds[1], true) }
  return 0
}

// ---- The kernel queue -------------------------------------------------------------------------
// `queueSet` registers `fd` for the uv_poll events in `events` (0 removes it); `previous` is what it
// was registered for. `queueWait` fills `ready` with (tag, events) pairs: events are uv_poll bits,
// with QUEUE_ERROR for an error or hangup condition.
const QUEUE_ERROR: i32 = 256
struct Ready { tag: u64, events: i32 }
impl Copy for Ready {}
static if Intrinsic.targetOperatingSystem() == "darwin" {
  extern "C" struct KernelEvent { ident: usize, filter: i16, flags: u16, fflags: u32, data: isize, udata: usize }
  impl Copy for KernelEvent {}
  unsafe extern "C" fn kqueue() -> i32
  @foreign(noCapture: .("changes", "events", "timeout"))
  unsafe extern "C" fn kevent(queue: i32, changes: ?[*]const KernelEvent, changeCount: i32, events: ?[*]mut KernelEvent, eventCount: i32, timeout: ?*const TimeSpec) -> i32
  const FILTER_READ: i16 = -1
  const FILTER_WRITE: i16 = -2
  const FILTER_VNODE: i16 = -4
  // libuv's kqueue.c registers UV_PRIORITIZED with EV_OOBAND (EV_FLAG1) in the filter slot. macOS
  // refuses that filter, and libuv, which hands its changes to the wait, receives the refusal as an
  // EV_ERROR event of that filter ahead of the ready events: one UV_PRIORITIZED callback. Poll
  // handles register the same way here (queueSetLoop, applied by queueWait).
  const FILTER_OOBAND: i16 = 8192
  const EV_ADD: u16 = 1
  const EV_DELETE: u16 = 2
  const EV_CLEAR: u16 = 32
  const EV_ONESHOT: u16 = 16
  const EV_ERROR: u16 = 16384
  const EV_EOF: u16 = 32768
  fn kernelEvent(ident: usize, filter: i16, flags: u16, fflags: u32, udata: usize) -> KernelEvent { return KernelEvent { ident: ident, filter: filter, flags: flags, fflags: fflags, data: 0, udata: udata } }
  unsafe fn queueOpen() -> i32 {
    let queue = unsafe kqueue()
    if queue < 0 { return -(unsafe errno()) }
    unsafe cloexec(queue)
    return queue
  }
  unsafe fn queueChange(queue: i32, change: KernelEvent) -> i32 {
    let changes = [change]
    let mut none: [KernelEvent; 0] = []
    if unsafe kevent(queue, Pointer.fromSlice<KernelEvent>(&changes), 1, Pointer.fromMutSlice<KernelEvent>(&mut none), 0, Pointer.null<TimeSpec>()) < 0 { return -(unsafe errno()) }
    return 0
  }
  unsafe fn queueSet(queue: i32, fd: i32, tag: u64, previous: i32, events: i32) -> i32 {
    let ident = i32.toUsize(fd) let data = u64.toUsize(tag)
    let wasRead = (previous & (UV_READABLE | UV_DISCONNECT)) != 0 let wantRead = (events & (UV_READABLE | UV_DISCONNECT)) != 0
    let wasWrite = (previous & UV_WRITABLE) != 0 let wantWrite = (events & UV_WRITABLE) != 0
    let mut status: i32 = 0
    if wantRead && !wasRead { status = unsafe queueChange(queue, kernelEvent(ident, FILTER_READ, EV_ADD, 0, data)) }
    if !wantRead && wasRead { let _ignored = unsafe queueChange(queue, kernelEvent(ident, FILTER_READ, EV_DELETE, 0, data)) }
    if status != 0 { return status }
    if wantWrite && !wasWrite { status = unsafe queueChange(queue, kernelEvent(ident, FILTER_WRITE, EV_ADD, 0, data)) }
    if !wantWrite && wasWrite { let _ignored = unsafe queueChange(queue, kernelEvent(ident, FILTER_WRITE, EV_DELETE, 0, data)) }
    if status != 0 { return status }
    return status
  }
  unsafe fn changeAt(l: &Loop, index: usize) -> *mut KernelEvent {
    let base = unsafe Pointer.assumeManyMut<KernelEvent>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut KernelEvent>(unsafe nn(l.changes)))
    return unsafe Pointer.atMut<KernelEvent>(base, index)
  }
  unsafe fn changesFrom(changes: *mut u8, offset: usize) -> [*]const KernelEvent {
    let base = unsafe Pointer.assumeManyMut<KernelEvent>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut KernelEvent>(changes))
    return unsafe Pointer.assumeMany<KernelEvent>(unsafe Intrinsic.pointerRequalify<*mut KernelEvent, *const KernelEvent>(unsafe Pointer.atMut<KernelEvent>(base, offset)))
  }
  unsafe fn pendChange(loop: *mut Loop, change: KernelEvent) -> i32 {
    let mut anchor = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop)
    if l.changeCount == l.changeCapacity {
      let capacity = if l.changeCapacity == 0 { 16 } else { l.changeCapacity * 2 }
      let grown = unsafe realloc(l.changes, capacity * Layout.of<KernelEvent>().bytes)
      if Pointer.isNull<u8>(grown) { return -12 }
