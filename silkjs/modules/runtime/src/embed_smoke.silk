//! The embedding API's smoke test: a host that runs its own module in an embedded runtime,
//! turns the loop with a bounded wait, and ends it with process.exit. The module calls a
//! native function of the host's (`hostAdd`, its `HostApi`), and the host calls a function of
//! the module's as a callback, whose microtask runs before the call returns. The module also
//! reports whether WebAssembly is there. The host runs the module from a bytecode image it writes
//! first (`Runtime.writeModuleImage`, `evaluateModuleImage`). Its modules are bundled into the program
//! (`MemoryModules`): an ES module, a CommonJS package with a package.json, and an import of a
//! module that is not there. Its environment and working directory are fixed (`FixedPlatform`),
//! and its file system is in memory (`MemoryFiles`), for synchronous and asynchronous calls.
//!
//! ./smoke runs it without WebAssembly (`EmptyWasm`): that program depends on the core alone and
//! does not link WAMR. ./cli/src/embed_smoke_wamr.silk runs the same with `WamrWasm`.
//! Built and run by tests/embed-smoke.py; it prints what the module logged and the status the
//! turn reported.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.system.host_input { HostInput, HostInputError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_exceptions { JsException }
import silkjs.js_engine { Engine }
import silkjs.js_libc_platform as platform
import silkjs.js_value { ValueBits }
import silkjs.js_realm { Realm, Arguments, lendRealm }
import silkjs.js_owned_value { Value }
import silkjs.js_core_types { NativeFunctionId, NativeCallProtocol }
import silkjs.js_native_functions as functions
import silkjs.js_intl_common as common
import runtime.embed { Host, Options }
import runtime.embed
import runtime.session { Runtime, Turn, moduleImageLoadable }
import silk.collections.list { List }
import libs.core.host { Services }
import libs.core.capabilities { Capabilities, Composition, Compression, Crypto, Files, HostApi, Http2, HOST_API_FIRST, Tls, Wasm }
import libs.core.capabilities { EmptyCompression, EmptyCrypto, EmptyHttp2, EmptyTls }
import libs.core.capabilities { Database, EmptyAddons, EmptyDatabase, NativeAddons }
import libs.core.capabilities { EmptyProcesses, OsProcesses, Processes }
import libs.core.capabilities { EmptyHttp, EmptyNetwork, Http, Network, OsNetwork }
import libs.core.capabilities { EmptySystemInfo, EmptyTypeStripping, OsSystemInfo, SystemInfo, TypeStripping }
import libs.core.capabilities { EmptyWorkers, ThreadWorkers, Workers }
import libs.core.capabilities { EmptyInspector, Inspector }
import libs.core.module_sources { MemoryModule, MemoryModules }
import libs.core.platforms { FixedPlatform, Variable }
import libs.core.files { EmptyFiles, MemoryFiles }

const SOURCE: &[u8] = b"import { twice } from './lib.mjs';\nconsole.log('add', hostAdd(2, 3));\nconsole.log('wasm', typeof WebAssembly);\nconsole.log('lib', twice(21));\nconsole.log('meta', (() => (() => import.meta.url)())() === import.meta.url, import.meta.url.endsWith('/embed-smoke/main.mjs'));\nconsole.log('libraries', typeof process.getBuiltinModule('zlib'), typeof process.getBuiltinModule('http2'), typeof CompressionStream, typeof process.getBuiltinModule('tls'), typeof globalThis.crypto, typeof process.getBuiltinModule('node:sqlite'), typeof process.getBuiltinModule('child_process'), typeof process.getBuiltinModule('net'), typeof fetch, typeof process.getBuiltinModule('os'), process.features.typescript, process.features.inspector);\ntry { process.dlopen({ exports: {} }, '/none.node'); } catch (error) { console.log('dlopen', error.code); }\nconsole.log('env', Object.keys(process.env).join(), process.env.EMBED_SMOKE, process.cwd());\ntry { process.env.EMBED_SMOKE = 'changed'; } catch (error) { console.log('setenv', error.code); }\nglobalThis.onHost = x => { queueMicrotask(() => hostAdd(x, 100)); return x * 2; };\nlet ticks = 0;\nlet fs;\nconst timer = setInterval(() => {\n  ticks++;\n  console.log('tick', ticks);\n  if (ticks === 3) {\n    clearInterval(timer);\n    // Nothing referenced is left: a kept-alive runtime keeps turning until the host or\n    // process.exit ends it.\n    // The file system is MemoryFiles on the blocking threads too.\n    (fs.promises ? fs.promises.readFile('/data/out.txt', 'utf8') : Promise.resolve('none')).then(text => {\n      console.log('async', text);\n      setTimeout(() => { process.exitCode = 3; process.exit(); }, 5).unref();\n    });\n  }\n}, 5);\nprocess.on('exit', code => console.log('exit', code));\nfs = await import('node:fs').catch(error => error);\nif (typeof fs.readFileSync === 'function') {\n  console.log('fs', typeof fs.readFileSync);\n  console.log('read', fs.readFileSync('/data/greeting.txt', 'utf8'));\n  fs.writeFileSync('/data/out.txt', 'abc');\n  fs.appendFileSync('/data/out.txt', 'def');\n  console.log('dir', fs.readdirSync('/data').join(), fs.statSync('/data/out.txt').size, fs.existsSync('/etc/passwd'));\n  // SQLite keeps its files in the program's file system too (sqlite/src/ext/sqlite_files.silk).\n  const { DatabaseSync } = await import('node:sqlite');\n  const db = new DatabaseSync('/data/test.db');\n  db.exec('create table t(x)');\n  db.prepare('insert into t values (?)').run(5);\n  console.log('sqlite', db.prepare('select x from t').get().x, fs.existsSync('/data/test.db'), fs.statSync('/data/test.db').size > 0);\n  db.close();\n  // A guest gets no host directory from a program whose files are its own.\n  try { new (await import('node:wasi')).WASI({ version: 'preview1', preopens: { '/sandbox': '/' } }); console.log('wasi', 'preopened'); } catch (error) { console.log('wasi', error.code); }\n} else {\n  console.log('fs', fs.code, process.getBuiltinModule('fs'), (await import('node:module')).builtinModules.includes('fs'));\n}\n// Every await comes after onHost is defined: the host calls it once evaluation reaches the first.\ntry { await import('node:crypto'); console.log('crypto', 'there'); } catch (error) { console.log('crypto', error.code); }\ntry { new (await import('node:worker_threads')).Worker('0', { eval: true }).terminate(); console.log('worker', 'started'); } catch (error) { console.log('worker', error.code); }\nconst { createRequire } = await import('node:module');\nconsole.log('cjs', createRequire(import.meta.url)('./helpers').name);\nconsole.log('missing', await import('./missing.mjs').then(() => 'found', error => error.code));\n"

/// The runtime's whole environment (`FixedPlatform`): it does not see the process's.
// OPENSSL_CONF names a file of the program's own file system: OpenSSL reads it through fs.
const ENVIRONMENT: [Variable; 2] = [Variable { name: b"EMBED_SMOKE", value: b"fixed" }, Variable { name: b"OPENSSL_CONF", value: b"/etc/openssl.cnf" }]

/// The rest of the module graph, bundled into the program.
const MODULES: [MemoryModule; 5] = [
  MemoryModule { path: b"/embed-smoke/lib.mjs", source: b"export const twice = x => x * 2;\n" },
  // Beside the name the main module's image is written under: the image runs as
  // /embed-smoke/main.mjs, so this one is never the `./lib.mjs` it imports.
  MemoryModule { path: b"/embed-smoke-built/lib.mjs", source: b"export const twice = x => x * 3;\n" },
  MemoryModule { path: b"/embed-smoke/helpers/package.json", source: b"{ \"main\": \"main.js\" }\n" },
  MemoryModule { path: b"/embed-smoke/helpers/main.js", source: b"module.exports = { name: require('./name.js') };\n" },
  MemoryModule { path: b"/embed-smoke/helpers/name.js", source: b"module.exports = 'helpers';\n" },
]

/// What the host's native function saw: its last sum.
pub struct Added { last: i32 }

/// The host's functions: `hostAdd(a, b)` returns `a + b` and keeps it in `added`.
pub struct SmokeApi { added: ?*mut Added }
impl Copy for SmokeApi {}
impl HostApi for SmokeApi {
  fn forWorker(self: &Self) -> Self { return SmokeApi { added: Pointer.null<Added>() } }
  effect fn call<'r, 'm, 'w, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, id: u32, realm: Realm<'r>, argc: i32, argv: Arguments<'w>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let sum = integer(argv.get(0).view()) + integer(argv.get(1).view())
    if !Pointer.isNull<Added>(self.added) {
      let mut anchor = ()
      let added = unsafe Pointer.borrowMut<(), Added>(&mut anchor, unsafe Intrinsic.pointerRequalify<?*mut Added, *mut Added>(self.added))
      added.last = sum
    }
    return ValueBits.Int { value: sum }
  }
}

fn integer(value: ValueBits) -> i32 { return match value { ValueBits.Int { value: number } => number _ => 0 } }

/// Defines `hostAdd` on the global object.
effect fn install<'e, 'm, C: Composition>(runtime: &mut Runtime<'e, 'm, C>) -> () ! JsException ? &mut Allocator {
  let context = runtime.rawContext()
  let engine = runtime.rawEngine()
  let memory = engine.memory
  let realm = unsafe lendRealm(&context, context)
  let function = run functions.newFunction(&mut engine.*, memory, realm, NativeFunctionId.Host { id: HOST_API_FIRST }, b"hostAdd", 2, NativeCallProtocol.Generic, 0)
  run common.define(&mut engine.*, realm, realm.globalObject(), b"hostAdd", unsafe Value.adoptBits(function), 7)
}

struct Smoke { turns: u64, added: *mut Added, doubled: i32, afterMicrotask: i32, image: List<u8> }
impl Host for Smoke {
  effect fn drive<'e, 'm, C: Composition>(self: &mut Self, runtime: &mut Runtime<'e, 'm, C>) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
    run install(&mut runtime.*)
    // From a bytecode image, as a host that compiled its bundle when it was built: written
    // under one name, run under the one the module has here. Its functions are read from the
    // image at their first call, so the image lives as long as the host.
    self.image = run runtime.writeModuleImage(b"/embed-smoke-built/main.mjs", SOURCE)
    if !moduleImageLoadable(self.image.asSlice()) {
      let _written = platform.writeAll(1, b"host: the module image does not load\n")
      return 1
    }
    run unsafe runtime.evaluateModuleImage(b"/embed-smoke/main.mjs", SOURCE, Pointer.fromRef<u8>(&self.image.asSlice()[0]), self.image.length())
    run self.callHost(&mut runtime.*)
    while self.turns < 10000 {
      self.turns = self.turns + 1
      match run runtime.turn(50.0) {
        Turn.Running => ()
        Turn.Finished { status } => {
          let _called = platform.writeAll(1, if self.doubled == 42 && self.afterMicrotask == 121 { b"host: callback returned 42 after its microtask\n" } else { b"host: callback went wrong\n" })
          let _written = platform.writeAll(1, if status == 3 { b"host: finished with 3\n" } else { b"host: finished with another status\n" })
          return status
        }
      }
    }
    let _written = platform.writeAll(1, b"host: still running after 10000 turns\n")
    return 1
  }
}

impl Smoke {
  /// Calls the module's `onHost(21)` as a callback: it returns 42, and its microtask has run
  /// `hostAdd(21, 100)` by the time the call returns.
  effect fn callHost<'e, 'm, C: Composition>(self: &mut Self, runtime: &mut Runtime<'e, 'm, C>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = runtime.rawContext()
    let realm = unsafe lendRealm(&context, context)
    let function = run common.get(&mut runtime.rawEngine().*, realm, realm.globalObject(), b"onHost")
    let returned = run runtime.callback(function.borrow().view(), ValueBits.Undefined, &[ValueBits.Int { value: 21 }])
    self.doubled = integer(returned)
    realm.release(&mut runtime.rawEngine().*, unsafe Value.adoptBits(returned))
    let anchor = ()
    self.afterMicrotask = (unsafe Pointer.borrow<(), Added>(&anchor, self.added)).last
    realm.release(&mut runtime.rawEngine().*, move function)
  }
}

/// The runtime's file system: in memory, with one file in it.
effect fn seededFiles() -> MemoryFiles ! OutOfMemoryError ? &mut Allocator {
  let files = run MemoryFiles.make()
  run files.addFile(b"/data/greeting.txt", b"hello from memory")
  run files.addFile(b"/etc/openssl.cnf", b"nodejs_conf = nodejs_init\n[nodejs_init]\nproviders = provider_sect\n[provider_sect]\ndefault = default_sect\n[default_sect]\nactivate = 1\n")
  return files
}

/// The smoke test with the given WebAssembly capability, file system and libraries.
effect fn smoke<W: Wasm + Copy, F: Files + Copy, Z: Compression + Copy, H: Http2 + Copy, K: Crypto + Copy, T: Tls + Copy, D: Database + Copy, N: NativeAddons + Copy, R: Processes + Copy, E: Network + Copy, L: Http + Copy, S: SystemInfo + Copy, Y: TypeStripping + Copy, X: Workers + Copy, I: Inspector + Copy>(image: &[u8], wasm: W, files: F, compression: Z, http2: H, crypto: K, tls: T, database: D, addons: N, processes: R, network: E, http: L, systemInfo: S, typeStripping: Y, workers: X, inspector: I) -> i32 ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  // The host's process ends with the runtime: it starts from the heap image appended to it, or
  // writes one when its own arguments ask (`silk task image`).
  let mut options = run Options.make(b"embed-smoke")
  options.ownsProcess = true
  if image.length != 0 {
    run options.arguments.append(run Bytes.copy(b"--silk-write-heap-image"))
    run options.arguments.append(run Bytes.copy(image))
  }
  let mut added = Added { last: 0 }
  let addedAt = Pointer.fromMutRef<Added>(&mut added)
  let mut host = Smoke { turns: 0, added: addedAt, doubled: 0, afterMicrotask: 0, image: List<u8>.make() }
  let capabilities = Capabilities { platform: FixedPlatform.make(&ENVIRONMENT, b"/embed-smoke"), modules: MemoryModules.make(&MODULES), files: files, compression: compression, http2: http2, crypto: crypto, tls: tls, database: database, addons: addons, processes: processes, network: network, http: http, systemInfo: systemInfo, typeStripping: typeStripping, workers: workers, inspector: inspector, wasm: wasm, hostApi: SmokeApi { added: addedAt } }
  return run embed.start(move options, &mut host, move capabilities)
}

/// The smoke test on a file system in memory (`MemoryFiles`), with every library: the caller
/// gives those of packages of their own (WebAssembly, compression, HTTP/2, HTTP/1, SQLite, OpenSSL, the inspector, amaro, Node-API).
pub effect fn program<W: Wasm + Copy, Z: Compression + Copy, H: Http2 + Copy, L: Http + Copy, D: Database + Copy, K: Crypto + Copy, T: Tls + Copy, I: Inspector + Copy, Y: TypeStripping + Copy, N: NativeAddons + Copy>(image: &[u8], wasm: W, compression: Z, http2: H, http: L, database: D, crypto: K, tls: T, inspector: I, typeStripping: Y, addons: N) -> i32 ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  let files = run seededFiles()
  return run smoke(image, wasm, files, compression, http2, crypto, tls, database, addons, OsProcesses {}, OsNetwork {}, http, OsSystemInfo {}, typeStripping, ThreadWorkers {}, inspector)
}

/// The smoke test with no file system, compression, HTTP/2, crypto or TLS: `node:fs`, `node:zlib`,
/// `node:http2`, `node:crypto` and `node:tls` are not there.
pub effect fn programWithoutFiles<W: Wasm + Copy>(image: &[u8], wasm: W) -> i32 ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  return run smoke(image, wasm, EmptyFiles {}, EmptyCompression {}, EmptyHttp2 {}, EmptyCrypto {}, EmptyTls {}, EmptyDatabase {}, EmptyAddons {}, EmptyProcesses {}, EmptyNetwork {}, EmptyHttp {}, EmptySystemInfo {}, EmptyTypeStripping {}, EmptyWorkers {}, EmptyInspector {})
}

fn status(result: Result<i32, OutOfMemoryError | SynchronizationError>) -> i32 {
  return match move result {
    Result<i32, OutOfMemoryError | SynchronizationError>.Success { value } => value
    Result<i32, OutOfMemoryError | SynchronizationError>.Failure { .. } => 1
  }
}

/// The path after `--silk-write-heap-image`, when that is the host's first argument; empty else.
effect fn imageArgument() -> Bytes ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  match move run HostInput.argument(1) {
    Option.Some { value: flag } => {
      if !same(Bytes.asSlice(&flag), b"--silk-write-heap-image") { return Bytes.make() }
    }
    Option.None => { return Bytes.make() }
  }
  return match move run HostInput.argument(2) { Option.Some { value: path } => move path Option.None => Bytes.make() }
}
fn imageRequest(result: Result<Bytes, HostInputError | OutOfMemoryError>) -> Bytes {
  return match move result { Result<Bytes, HostInputError | OutOfMemoryError>.Success { value } => move value Result<Bytes, HostInputError | OutOfMemoryError>.Failure { .. } => Bytes.make() }
}
fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut at: usize = 0
  while at < a.length { if a[at] != b[at] { return false } at = at + 1 }
  return true
}

/// Runs `program` and turns its failure into status 1.
pub effect fn report<W: Wasm + Copy, Z: Compression + Copy, H: Http2 + Copy, L: Http + Copy, D: Database + Copy, K: Crypto + Copy, T: Tls + Copy, I: Inspector + Copy, Y: TypeStripping + Copy, N: NativeAddons + Copy>(wasm: W, compression: Z, http2: H, http: L, database: D, crypto: K, tls: T, inspector: I, typeStripping: Y, addons: N) -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let image = imageRequest(run Effect.result(imageArgument()) |> Effect.provideMut<Allocator>(&mut allocator))
  return status(run Effect.result(program(image.asSlice(), wasm, compression, http2, http, database, crypto, tls, inspector, typeStripping, addons)) |> Effect.provideMut<Allocator>(&mut allocator))
}

/// Runs `programWithoutFiles` and turns its failure into status 1.
pub effect fn reportWithoutFiles<W: Wasm + Copy>(wasm: W) -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let image = imageRequest(run Effect.result(imageArgument()) |> Effect.provideMut<Allocator>(&mut allocator))
  return status(run Effect.result(programWithoutFiles(image.asSlice(), wasm)) |> Effect.provideMut<Allocator>(&mut allocator))
}
