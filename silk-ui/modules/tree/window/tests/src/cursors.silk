//! CSS `cursor: url(...)` through the adapter: the keyword shows until the image loads, then
//! the platform gets the image with its hot spot, and a keyword replaces it again.
import ui_fixtures.fixtures as fixtures
import ui_tree.css
import ui_tree.css { px, Property }
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Mutation }
import ui_tree_window.lib { feed, showCursor }
import codec.image { Image, ImageError }
import window.event { Event, Modifiers }
import window.headless { HeadlessPlatform, HeadlessWindow }
// Interface methods resolve through this import; silk#2819 reports it as unused.
import window.platform { Platform as _Platform }
import window.types { WindowId, WindowOptions, WindowError, Wait, Cursor }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.point { Point2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

fn shown<'a>(platform: &'a HeadlessPlatform, window: WindowId) -> &'a HeadlessWindow {
  return match platform.window(window) {
    Option<&HeadlessWindow>.Some { value } => value
    _ => Intrinsic.trap("window open")
  }
}

effect fn body() -> ()
  ! AssertionError<'static> | TreeError | WindowError | ImageError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.style(
    1,
    &[
      css.width(px(100.0)),
      css.height(px(100.0)),
      css.declare(Property.Cursor, run css.text(b"url(arrow.png) 1 2, pointer")),
    ],
  )
  run batch.root(1)
  run tree.apply(run batch.take())
  run tree.frame(fixtures.viewport(1))

  let mut platform = run HeadlessPlatform.start()
  let window = run platform.openWindow(&WindowOptions.make("cursor", 100.0, 100.0))
  run platform.push(Event.MouseMoved { window: window, position: Point2<f64>.new(50.0, 50.0), modifiers: Modifiers.none() })
  while true {
    match move run platform.nextEvent(Wait.Poll) {
      Option<Event>.Some { value } => {
        drop run feed(&mut tree, &value)
      }
      Option<Event>.None => {
        break
      }
    }
  }
  run tree.frame(fixtures.viewport(1))
  run showCursor(&mut platform, window, &mut tree, 1.0)
  run Testing.expect(shown(&platform, window).cursor == Cursor.PointingHand && shown(&platform, window).cursorImageWidth == 0, "the keyword shows while the image loads")

  let loads = run tree.takeLoads()
  let resource = match &loads.asSlice()[0] {
    Mutation.LoadImage { resource, .. } => resource
    _ => { run Testing.expect(false, "an image load") 0 }
  }
  let mut image = run Image.make(3, 3)
  let pixels = image.dataMut()
  let mut i: usize = 0
  while i < pixels.length {
    pixels[i] = 255
    i = i + 1
  }
  drop pixels
  run batch.decodedImage(resource, move image)
  run tree.apply(run batch.take())
  run tree.settleSource(resource, true)
  run showCursor(&mut platform, window, &mut tree, 1.0)
  run Testing.expect(
    shown(&platform, window).cursorImageWidth == 3 && shown(&platform, window).cursorHotX == 1 && shown(&platform, window).cursorHotY == 2,
    "the image shows with its hot spot",
  )

  run batch.style(1, &[css.declare(Property.Cursor, run css.text(b"cell"))])
  run tree.apply(run batch.take())
  run tree.frame(fixtures.viewport(1))
  run showCursor(&mut platform, window, &mut tree, 1.0)
  run Testing.expect(
    shown(&platform, window).cursor == Cursor.Cell && shown(&platform, window).cursorImageWidth == 0,
    "a keyword replaces the image",
  )
}

test effect fn cssCursorImages() -> ()
  ! AssertionError<'static> | TreeError | WindowError | ImageError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}
