//! Chooses the native inputs that `[native]` cannot express.
//!
//! - WebAssembly links the archive `scripts/prepare --wasm` builds: `[native].link`'s `os`
//!   filter has no value for a browser.
//! - Windows links the bridge that `scripts/prepare` compiles there: Clang, given the
//!   extended-length path Silk passes on Windows, finds no header beside the file.
//! - Everywhere else compiles the bridge here.
import silk.build.plan { Library, Plan }
import silk.build.step { sourcePath }

static fn plan() -> Plan {
  let mut plan = Plan.empty()
  static if Intrinsic.targetOperatingSystem() != "windows" {
    plan = Plan.compileC(plan, sourcePath("native/bridge.c"))
    plan = Plan.compileC(plan, sourcePath("native/input.c"))
  }
  static if Intrinsic.targetArchitecture() == "wasm32" {
    plan = Plan.linkArchive(plan, sourcePath("native/build/wasm32/libghostty-vt.a"))
  }
  if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkArchive(sourcePath("native/build/lib/libghostty-vt.a"))
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkArchive(sourcePath("native/build/lib/ghostty-vt-static.lib"))
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkArchive(sourcePath("native/build/lib/ghostty-bridge.lib"))
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkLibrary("ucrt", Library.dynamicSearch())
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkArchive(sourcePath("native/build/lib/system/kernel32.lib"))
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkArchive(sourcePath("native/build/lib/system/ntdll.lib"))
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkArchive(sourcePath("native/build/lib/system/vcruntime.lib"))
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("m", Library.dynamicSearch())
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("pthread", Library.dynamicSearch())
  }
  return plan
}

pub const PLAN: Plan = plan()
