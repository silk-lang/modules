//! A JavaScript app (React, Foldkit or plain JS, bundled by Vite) in a window, on the SilkJS
//! engine: what the release host silkui generates runs. `@silkui/core` is defined in the
//! realm, the bundle is the entry, and the fonts are the ones installed on the machine.
//!
//! ```silk,ignore
//! pub effect fn main() -> i32 ? &mut HostInput {
//!   return run release(Settings { title: "My app", width: 900.0, height: 600.0, titleBar: TitleBar.Standard, titleBarHeight: 0.0, controlsLeft: 0.0, controlsTop: 0.0, natives: Natives.off() }, Source.read("app.js"))
//! }
//! ```
import ui_js.lib { StylesheetCompiler, runtimeStylesheets, JsError, uiPackage }
pub import ui_js.lib { Natives }
import ui_js_window.lib { JsApp, JsClient, JsTools, NoTools }
import ui_tree.error { ProtocolError }
import ui_tree.legacy { TreeError, Mutation }
import ui_tree.style_assets { StyleAssets }
import ui_tree_window.style_watch { SheetWatch }
import ui_tree_window.host { RunOptions, runWindow, StartedGpu, startGpu, environmentVariable, showMetalHud as hostShowMetalHud }
import ui_tree_window.platform_thread { Launched, launch }
import ui_tree_window.console { StderrWriter }
import ui_tree.process_memory
import ui_inspect_server.lib { Inspector }
import font_collection.lib { FontCollection }
import font_collection.system as fontFiles
import font_collection.system { Options as FontOptions }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_libc_platform as platform
import window.types { WindowError }
pub import window.types { TitleBar }
import webgpu.runtime { GpuError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_input { WindowsHostInput }
} else {
  import silk.platform.native.host_input { NativeHostInput }
  import silk.system.host_input_native { OsHostInput }
}

/// The window an app opens: what `Target.window(Window { ... })` in the app definition says.
/// `titleBar`, `titleBarHeight`, `controlsLeft` and `controlsTop` are `JsClient`'s.
pub struct Settings {
  pub title: string<'static>,
  pub width: f64,
  pub height: f64,
  pub titleBar: TitleBar,
  pub titleBarHeight: f64,
  pub controlsLeft: f64,
  pub controlsTop: f64,
  /// The app's exported Silk functions, which its JavaScript imports from `.silk` files:
  /// `Natives.off()` for none. silkui generates them (see `natives`).
  pub natives: Natives,
}

impl Copy for Settings {}

/// Shows the Metal Performance HUD over the window on macOS 13 and later (see
/// `ui_tree_window.host.showMetalHud`). A generated host calls it for `.metalHud(true)`.
pub fn showMetalHud(on: bool) -> () {
  hostShowMetalHud(on)
}

/// The app's JavaScript as a release host carries it: the bundle's text, and the bytecode
/// image the app's build compiled it into with the engine the host links (`image.silk`),
/// or an empty image for none. A launch starts from the image and parses nothing; the
/// text is what runs when the image was written by another engine build, which the host
/// says on standard error.
pub struct Bundle {
  pub source: &'static [u8],
  pub image: &'static [u8],
  /// The image of `@silkui/core`, which the bundle imports and the host defines: written by
  /// the same build step, or empty.
  pub library: &'static [u8],
}

impl Copy for Bundle {}

impl Bundle {
  /// A bundle with no image: every launch parses and compiles `source`.
  pub fn text(source: &'static [u8]) -> Bundle {
    return Bundle { source: source, image: b"", library: b"" }
  }
}

/// Runs the bundle `source` (or, when it is empty, the file at `entry`) in a window with
/// `tools`, until the window closes. Answers the exit code.
pub effect fn program<T: JsTools>(settings: Settings, entry: &[u8], source: &[u8], tools: T, inspector: Inspector, launched: Option<Launched>) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError
  ? &mut Allocator {
  return run programWithSheets(settings, entry, source, move tools, move inspector, move launched, StyleAssets.make())
}

/// Runs compiled application sheets before the first frame.
pub effect fn programWithSheets<T: JsTools>(settings: Settings, entry: &[u8], source: &[u8], tools: T, inspector: Inspector, launched: Option<Launched>, sheets: StyleAssets) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError
  ? &mut Allocator {
  return run programWithSheetUpdates(settings, entry, source, move tools, move inspector, move launched, move sheets, SheetWatch.make())
}

pub effect fn programWithSheetUpdates<T: JsTools>(settings: Settings, entry: &[u8], source: &[u8], tools: T, inspector: Inspector, launched: Option<Launched>, sheets: StyleAssets, updates: SheetWatch) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError
  ? &mut Allocator {
  return run programWithStylesheetCompiler(settings, entry, source, move tools, move inspector, move launched, move sheets, move updates, StylesheetCompiler.off())
}

pub effect fn programWithStylesheetCompiler<T: JsTools>(settings: Settings, entry: &[u8], source: &[u8], tools: T, inspector: Inspector, launched: Option<Launched>, sheets: StyleAssets, updates: SheetWatch, compiler: StylesheetCompiler) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError
  ? &mut Allocator {
  return run programWithImages(settings, entry, source, b"", b"", move tools, move inspector, move launched, move sheets, move updates, compiler)
}

/// [`programWithStylesheetCompiler`] for a bundle that also has bytecode images
/// ([`Bundle`]): `image` is the bundle's and `library` is `@silkui/core`'s; an empty one is
/// none.
pub effect fn programWithImages<T: JsTools>(settings: Settings, entry: &[u8], source: &[u8], image: &'static [u8], library: &'static [u8], tools: T, inspector: Inspector, launched: Option<Launched>, sheets: StyleAssets, updates: SheetWatch, compiler: StylesheetCompiler) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError
  ? &mut Allocator {
  // The GPU first: it takes longer than the fonts, the script and the realm together.
  let tracing = (run environmentVariable("SILK_UI_TRACE_FRAMES")).isSome()
  if tracing { StderrWriter.print("silkui: program started\n", &()) }
  let gpu = run startGpu(false)
  if tracing { StderrWriter.print("silkui: gpu started\n", &()) }
  let fonts = run systemFonts()
  if tracing { StderrWriter.print("silkui: fonts loaded\n", &()) }
  let domain = run WaiterDomain.make()
  let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut app = run JsApp.open(&memory, move allocator, domain.handle())
  if tracing { StderrWriter.print("silkui: engine open\n", &()) }
  app.javascript().setStylesheetCompiler(compiler)
  app.javascript().setNatives(settings.natives)
  run app.defineImaged(b"@silkui/core", uiPackage(), library)
  if source.length != 0 {
    run app.entry(b"app.js", source)
    app.entryImage(image)
  } else {
    let read = run Effect.catchAll(platform.readFile(entry), unreadable)
    run app.entry(b"app.js", read.asSlice())
  }
  if tracing { StderrWriter.print("silkui: bundle ready\n", &()) }
  let mut client = JsClient.make(move tools)
  client.titleBar = settings.titleBar
  client.titleBarHeight = settings.titleBarHeight
  client.controlsLeft = settings.controlsLeft
  client.controlsTop = settings.controlsTop
  client.stylesheets = move sheets
  client.stylesheetUpdates = move updates
  let options = RunOptions {
    title: settings.title,
    width: settings.width,
    height: settings.height,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: move launched,
    gpu: Option<StartedGpu>.some(move gpu),
  }
  let status = run Effect.result(runWindow(&mut app, &fonts, List<Mutation>.make(), move options, move inspector, &mut client))
  run app.close()
  return match move status {
    Result<i32, WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError>.Success { value } => value
    Result<i32, WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError>.Failure { error } => { fail move error }
  }
}

effect fn noFonts(error: HostInputError) -> () {
  drop error
}

static if Intrinsic.targetOperatingSystem() == "windows" {
  effect fn loadFonts(collection: &mut FontCollection) -> () ! HostInputError | OutOfMemoryError ? &mut Allocator {
    let mut inputs = run WindowsHostInput.capture()
    drop run fontFiles.load(&mut collection, FontOptions.defaults())
      |> Effect.provideMut<HostInput>(&mut inputs)
  }
} else {
  effect fn loadFonts(collection: &mut FontCollection) -> () ! HostInputError | OutOfMemoryError ? &mut Allocator {
    let snapshot = run unsafe NativeHostInput.environmentSnapshot()
    let mut inputs = OsHostInput.make(move snapshot)
    drop run fontFiles.load(&mut collection, FontOptions.defaults())
      |> Effect.provideMut<HostInput>(&mut inputs)
  }
}

/// The fonts installed on this machine, with the CSS generic families set up.
pub effect fn systemFonts() -> FontCollection ! OutOfMemoryError ? &mut Allocator {
  let mut collection = FontCollection.make()
  run Effect.catch<HostInputError>(loadFonts(&mut collection), noFonts)
  return move collection
}

effect fn unreadable<E>(error: E) -> List<u8> ! E {
  StderrWriter.print("silkui: the app's bundle could not be read\n", &())
  fail move error
}

/// Says which mutation the tree refused, and why, and answers exit code 2.
pub effect fn refused(error: TreeError) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let detail = run ProtocolError.lift(error).message()
  StderrWriter.print("silkui: the JavaScript window host failed: {}\n", &.(detail.view()))
  return 2
}

/// Says that the host failed, as the handler of a `catchAll`, and answers exit code 2.
pub effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("silkui: the JavaScript window host failed\n", &())
  return 2
}

fn released(settings: Settings, bundle: Bundle, launched: Option<Launched>, sheets: StyleAssets, compiler: StylesheetCompiler) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(Effect.catch<TreeError>(programWithImages(settings, b"", bundle.source, bundle.image, bundle.library, NoTools {}, Inspector.off(), move launched, move sheets, SheetWatch.make(), compiler), refused), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

/// The release host's `main`: the bundle `source` is part of the binary, and no development
/// tool is (no reload, no development server, no inspector).
pub effect fn release(settings: Settings, source: &'static [u8]) -> i32 ? &mut HostInput {
  return run releaseWithSheets(settings, source, &[])
}

effect fn launchReleased(settings: Settings, bundle: Bundle, sources: &[&[u8]], compiler: StylesheetCompiler) -> i32
  ! OutOfMemoryError ? &mut Allocator {
  // Before any work: it may restart the process (`launch` calls it too).
  process_memory.useSpaceEfficientMalloc()
  let tracing = (run environmentVariable("SILK_UI_TRACE_FRAMES")).isSome()
  if tracing { StderrWriter.print("silkui: main\n", &()) }
  let sheets = run StyleAssets.from(sources)
  if tracing { StderrWriter.print("silkui: sheets ready\n", &()) }
  return run launch(|launched: Option<Launched>| -> i32 {
    return released(settings, bundle, move launched, move sheets, compiler)
  })
}

/// Release entry with build-compiled stylesheets, in adoption order.
pub effect fn releaseWithSheets(settings: Settings, source: &'static [u8], sheets: &[&[u8]]) -> i32 ? &mut HostInput {
  return run releaseBundle(settings, Bundle.text(source), sheets)
}

/// Release entry that opts into parsing CSS text at runtime.
pub effect fn releaseWithRuntimeSheets(settings: Settings, source: &'static [u8], sheets: &[&[u8]]) -> i32 ? &mut HostInput {
  return run releaseBundleWithRuntimeSheets(settings, Bundle.text(source), sheets)
}

/// The release entry silkui generates: the bundle with the bytecode image the app's build
/// wrote ([`Bundle`]) and its build-compiled stylesheets, in adoption order.
pub effect fn releaseBundle(settings: Settings, bundle: Bundle, sheets: &[&[u8]]) -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(launchReleased(settings, bundle, sheets, StylesheetCompiler.off()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

/// [`releaseBundle`] that opts into parsing CSS text at runtime.
pub effect fn releaseBundleWithRuntimeSheets(settings: Settings, bundle: Bundle, sheets: &[&[u8]]) -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(launchReleased(settings, bundle, sheets, runtimeStylesheets()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
