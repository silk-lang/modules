//! Where compile time goes (docs/jit/compile-cost.md): monotonic nanoseconds per pipeline
//! phase and the sizes they worked on, summed per runtime for `--jit-stats` and printed per
//! compilation by `--jit-dump`.
import silk.mem.pointer { Pointer }
import silk.num.i64

unsafe extern "C" fn clock_gettime(clock: i32, time: *mut i64) -> i32
/// CLOCK_MONOTONIC in nanoseconds.
pub fn now() -> u64 {
  let mut time: [i64; 2] = [0; 2]
  drop unsafe clock_gettime(1, Pointer.fromMutRef<i64>(&mut time[0]))
  return i64.wrappingToU64(time[0]) * 1000000000 + i64.wrappingToU64(time[1])
}
/// Saturating nanosecond difference (guards against virtualized vCPU clock jitter).
pub fn diff(before: u64, after: u64) -> u64 {
  if after > before { return after - before }
  return 0
}
/// Saturating nanoseconds elapsed since `before`.
pub fn elapsed(before: u64) -> u64 { return diff(before, now()) }

pub struct Cost {
  /// Nanoseconds in ssa_translate, ssa_ownership.optimize, ssa_verify and x64_backend.
  pub translate: u64,
  pub optimize: u64,
  pub verify: u64,
  pub backend: u64,
  /// Pipeline runs (one per normal entry or loop header attempted).
  pub attempts: u64,
  /// Bytecode bytes handed to the translator, summed over attempts.
  pub bytecodeBytes: u64,
  /// SSA instructions the translator produced and the optimizer left, summed over attempts.
  pub translated: u64,
  pub optimized: u64,
  /// --jit-dump: x64_lower prints the SSA as the backend receives it.
  pub dump: bool,
  /// The ssa_opt passes x64_lower runs (ssa_opt.PASS_*).
  pub passes: u32,
}
impl Cost {
  pub fn make() -> Cost { return Cost { translate: 0, optimize: 0, verify: 0, backend: 0, attempts: 0, bytecodeBytes: 0, translated: 0, optimized: 0, dump: false, passes: 4294967295 } }
  pub fn add(self: &mut Self, other: &Cost) -> () {
    self.translate = self.translate + other.translate self.optimize = self.optimize + other.optimize
    self.verify = self.verify + other.verify self.backend = self.backend + other.backend
    self.attempts = self.attempts + other.attempts self.bytecodeBytes = self.bytecodeBytes + other.bytecodeBytes
    self.translated = self.translated + other.translated self.optimized = self.optimized + other.optimized
  }
}
