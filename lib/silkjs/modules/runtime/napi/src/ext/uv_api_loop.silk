    let changes = [KernelEvent { ident: i32.toUsize(fd), filter: -1, flags: 1, fflags: 0, data: 0, udata: 0 }, KernelEvent { ident: i32.toUsize(fd), filter: -1, flags: 2, fflags: 0, data: 0, udata: 0 }]
