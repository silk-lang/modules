//! Development tools for a `ui-js-node` window (`--dev <port>` HMR or `--watch <bundle>`).
import ui_tree.legacy { UiTree, TreeError }
import ui_tree_window.platform_thread { HostPlatform }
import ui_js_window.lib { write }
import ui_inspect_server.channel { Channel, SocketChannel }
import ui_inspect_server.client { openSession }
import ui_inspect_server.server { Address }
import silkjs.js_libc_platform as platform
import silk.concurrency.thread_native { SpawnError }
import silk.net.socket_native { NativeSocketError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

const WATCH_INTERVAL: f64 = 0.2
const INVOKE: string = "\"vite:invoke\""

/// Application runtime operations invoked by [`NodeDevTools`].
pub interface DevTarget {
  effect fn devScript(self: &mut Self, tree: &mut UiTree<'_>, source: &[u8], name: &[u8]) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator
  effect fn devMessage(self: &mut Self, tree: &mut UiTree<'_>, line: string) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator
  fn devTakeOutbox(self: &mut Self) -> List<String>
  fn devTakeReload(self: &mut Self) -> bool
  effect fn devReload(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    freshSource: Option<List<u8>>,
    bootstrap: &[u8],
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator
}

fn contains(text: &[u8], needle: &[u8]) -> bool {
  if needle.length > text.length { return false }
  let mut at: usize = 0
  while at + needle.length <= text.length {
    let mut i: usize = 0
    while i < needle.length && text[at + i] == needle[i] { i = i + 1 }
    if i == needle.length { return true }
    at = at + 1
  }
  return false
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] { return false }
    i = i + 1
  }
  return true
}

effect fn readOrEmpty(path: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let read = run Effect.result(platform.readFile(path))
  return match move read {
    Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Success { value } => move value
    Result<List<u8>, OutOfMemoryError | platform.PlatformError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      platform.PlatformError _ => List<u8>.make()
    }
  }
}

/// Development tools for a SilkJS runtime window: watching a bundle or talking to `@silkui/vite`.
pub struct NodeDevTools {
  path: List<u8>,
  stampPath: List<u8>,
  stamp: List<u8>,
  nextCheck: f64,
  port: u16,
  channel: Option<SocketChannel>,
  frame: String,
  bootstrap: String,
  lost: bool,
  invokes: u32,
}

impl NodeDevTools {
  /// Inert tools until [`NodeDevTools.watch`] or [`NodeDevTools.server`] is called.
  pub fn make() -> NodeDevTools {
    return NodeDevTools {
      path: List<u8>.make(),
      stampPath: List<u8>.make(),
      stamp: List<u8>.make(),
      nextCheck: 0.0,
      port: 0,
      channel: Option<SocketChannel>.None,
      frame: String.make(),
      bootstrap: String.make(),
      lost: false,
      invokes: 0,
    }
  }

  /// Reloads the bundle at `path` whenever the content of `stamp` changes.
  pub effect fn watch(self: &mut Self, path: &[u8], stamp: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    self.path.clear()
    run self.path.appendSlice(path)
    self.stampPath.clear()
    run self.stampPath.appendSlice(stamp)
    self.stamp = run readOrEmpty(stamp)
  }

  /// Connects to the `@silkui/vite` development server on `port`.
  pub fn server(self: &mut Self, port: u16) -> () {
    self.port = port
  }

  /// Whether the host evaluates its configured entry before opening the window.
  pub fn startsEntry(self: &Self) -> bool {
    return self.port == 0
  }

  /// Whether startup or HMR waits on the dev server over the socket.
  pub fn awaitsOutside(self: &Self) -> bool {
    if self.port == 0 || self.lost || self.channel.isNone() { return false }
    return String.byteLength(String.view(&self.bootstrap)) == 0 || self.invokes > 0
  }

  /// Connects to the dev server when the window opens.
  pub effect fn opened(self: &mut Self, platform: &HostPlatform) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.port == 0 { return () }
    let mut clock = OsMonotonicClock.make()
    let address = Address.Tcp { port: self.port }
    let opened = run Effect.result(openSession(&address, platform.nudge())) |> Effect.provideMut<MonotonicClock>(&mut clock)
    match move opened {
      Result<SocketChannel, NativeSocketError | SpawnError | OutOfMemoryError>.Success { value } => {
        self.channel = Option<SocketChannel>.some(move value)
      }
      Result<SocketChannel, NativeSocketError | SpawnError | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError allocation => { fail move allocation }
        _ => { write("dev: could not connect to the development server\n") }
      }
    }
  }

  effect fn sendOut<A: DevTarget>(self: &mut Self, app: &mut A) -> () ! OutOfMemoryError ? &mut Allocator {
    let lines = app.devTakeOutbox()
    if let Option<SocketChannel>.Some { value: channel } = &mut self.channel {
      let items = lines.asSlice()
      let mut i: usize = 0
      while i < items.length {
        if contains(String.utf8Bytes(String.view(&items[i])), String.utf8Bytes(INVOKE)) {
          self.invokes = self.invokes + 1
        }
        drop run Channel.send(String.view(&items[i])) |> Effect.provideMut<Channel>(&mut channel)
        i = i + 1
      }
    }
  }

  effect fn bootScript(self: &Self) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
    let mut source = List<u8>.make()
    run source.appendSlice(b"(0, eval)(")
    run source.appendSlice(String.utf8Bytes(String.view(&self.bootstrap)))
    run source.appendSlice(b")")
    return move source
  }

  effect fn receive<A: DevTarget>(self: &mut Self, app: &mut A, tree: &mut UiTree<'_>) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut ran = false
    while true {
      let mut line = String.make()
      let got = match &mut self.channel {
        Option<SocketChannel>.Some { value: channel } => run Channel.receive(&mut line) |> Effect.provideMut<Channel>(&mut channel)
        Option<SocketChannel>.None => false
      }
      if !got { break }
      let text = String.view(&line)
      let length = String.byteLength(text)
      if length < 2 { continue }
      let bytes = String.utf8Bytes(text)
      run self.frame.append(String.slice(text, 2, length - 2))
      if bytes[1] == 43 { continue }
      let message = Intrinsic.replace(self.frame, String.make())
      ran = true
      if bytes[0] == 98 {
        self.bootstrap = move message
        let script = run self.bootScript()
        run app.devScript(&mut tree, script.asSlice(), b"dev.js")
      } else {
        if self.invokes > 0 && contains(String.utf8Bytes(String.view(&message)), String.utf8Bytes(INVOKE)) {
          self.invokes = self.invokes - 1
        }
        run app.devMessage(&mut tree, String.view(&message))
      }
      run self.sendOut(&mut app)
    }
    if !self.lost {
      let gone = match &self.channel {
        Option<SocketChannel>.Some { value: channel } => !channel.open()
        Option<SocketChannel>.None => false
      }
      if gone {
        self.lost = true
        write("dev: the development server closed the connection\n")
      }
    }
    if app.devTakeReload() {
      let script = run self.bootScript()
      write("reloaded\n")
      run app.devReload(&mut tree, Option<List<u8>>.None, script.asSlice())
      ran = true
    }
    return ran
  }

  effect fn changed(self: &mut Self, time: f64) -> bool ! OutOfMemoryError ? &mut Allocator {
    if self.stampPath.length() == 0 || time < self.nextCheck { return false }
    self.nextCheck = time + WATCH_INTERVAL
    let now = run readOrEmpty(self.stampPath.asSlice())
    if now.length() == 0 || sameBytes(now.asSlice(), self.stamp.asSlice()) { return false }
    self.stamp = move now
    return true
  }

  /// Polls DevTools messages / HMR updates or stamp-file changes.
  pub effect fn poll<A: DevTarget>(self: &mut Self, app: &mut A, tree: &mut UiTree<'_>, time: f64) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.port != 0 {
      run self.sendOut(&mut app)
      return run self.receive(&mut app, &mut tree)
    }
    if !(run self.changed(time)) { return false }
    let fresh = run readOrEmpty(self.path.asSlice())
    if fresh.length() == 0 {
      write("reload: the entry could not be read\n")
      return false
    }
    write("reloaded\n")
    run app.devReload(&mut tree, Option<List<u8>>.some(move fresh), b"")
    return true
  }

  /// Poll interval needed by active dev server or file watcher, if any.
  pub fn wakeAfter(self: &Self) -> Option<f64> {
    if self.port != 0 { return Option<f64>.some(0.008) }
    if self.stampPath.length() == 0 { return Option<f64>.None }
    return Option<f64>.some(WATCH_INTERVAL)
  }

  /// Closes any open connection to the development server.
  pub fn close(self: &mut Self) -> () {
    if let Option<SocketChannel>.Some { value: channel } = &mut self.channel {
      channel.close()
    }
  }
}
