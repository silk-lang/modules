//! The browser's accessibility for an app drawn on a canvas. Each AccessKit update goes to
//! `browser/access-mirror.js` as JSON, and that script keeps a hidden copy of the tree in the
//! page's DOM over the canvas, which screen readers read. When a screen reader clicks or
//! focuses one of those elements, the script sends the action back as an [`ActionRequest`].
import accesskit.lib { TreeUpdate, ActionRequest, Action, NodeId, TreeId }
import accesskit.json { encode }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

static if Intrinsic.targetArchitecture() == "wasm32" {
  import silk.mem.pointer { Pointer }

  unsafe extern "C" fn hostAttach(window: u32) -> u32 as "silk_browser#access_attach"

  @foreign(noCapture: .("json"))
  unsafe extern "C" fn hostUpdate(
    window: u32,
    json: ?[*]const u8,
    length: usize,
  ) -> () as "silk_browser#access_update"

  @foreign(noCapture: .("into"))
  unsafe extern "C" fn hostTake(
    window: u32,
    into: ?[*]mut u64,
    capacity: usize,
  ) -> usize as "silk_browser#access_take"
}

/// The most requests one `take` reads; the page keeps the rest for the next.
const TAKE_CAPACITY: usize = 16

/// Asks the page to mirror `window`'s tree. False when the page turned accessibility off, and
/// always natively.
pub fn attach(window: u32) -> bool {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    return unsafe hostAttach(window) != 0
  } else {
    drop window
    return false
  }
}

/// Sends `update` to the page's mirror of `window`.
pub effect fn send(window: u32, update: &TreeUpdate) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    let mut json = Bytes.make()
    run encode(update, &mut json)
    let bytes = json.asSlice()
    unsafe hostUpdate(window, Pointer.fromSlice(bytes), bytes.length)
  } else {
    drop window
    drop update
  }
}

/// The clicks and focus moves screen readers made on the page's mirror of `window`.
pub effect fn take(window: u32) -> List<ActionRequest>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut requests = List<ActionRequest>.make()
  static if Intrinsic.targetArchitecture() == "wasm32" {
    // Each request is two words: the action's number, then the node's id.
    let mut words: [u64; 32] = [0; 32]
    let count = unsafe hostTake(window, Pointer.fromMutSlice(&mut words), TAKE_CAPACITY)
    let mut i: usize = 0
    while i < count {
      match request(words[2 * i], words[2 * i + 1]) {
        Option.Some { value } => run requests.append(move value)
        Option.None => {}
      }
      i = i + 1
    }
  } else {
    drop window
  }
  return move requests
}

/// The request for action number `action` on node `node`, when the action is one the mirror
/// sends.
pub fn request(action: u64, node: u64) -> Option<ActionRequest> {
  if action > 1 {
    return Option.None
  }
  let kind = if action == 0 {
    Action.Click
  } else {
    Action.Focus
  }
  return Option.Some {
    value: ActionRequest { action: kind, targetTree: TreeId.root(), targetNode: NodeId.of(node), data: Option.None },
  }
}
