//! The Node-API functions that take a callback, as C exports of the executable. Addons find them by
//! name, and Silk emits a C export only for the root package or where Silk code takes it as a value,
//! which a function with a callback parameter cannot be. So ./napi keeps them as plain functions and
//! this package, the executable, exports them. Until dependency exports are roots, an embedder that
//! loads addons declares the same.
import addons.ext.napi_async as asyncs
import addons.ext.napi_async {
  AsyncCleanupHook,
  CallJs,
  CleanupHook,
  Complete,
  Function,
  Hook,
  Work
}
import addons.ext.napi_core as core
import addons.ext.napi_core { Finalize }
import addons.ext.napi_values as values
import addons.ext.napi_values { Callback, PropertyDescriptor }

/// Called by main so the module is part of the program: its exports are what it is for.
pub fn keep() -> () {}

@deferredCallbacks("callback")
pub unsafe export "C" fn napi_add_async_cleanup_hook(
  env: ?*mut u8,
  callback: AsyncCleanupHook,
  data: ?*mut u8,
  result: ?*mut ?*mut Hook,
) -> i32 {
  return unsafe asyncs.napi_add_async_cleanup_hook(env, callback, data, result)
}

@deferredCallbacks("callback")
pub unsafe export "C" fn napi_add_env_cleanup_hook(
  env: ?*mut u8,
  callback: CleanupHook,
  data: ?*mut u8,
) -> i32 {
  return unsafe asyncs.napi_add_env_cleanup_hook(env, callback, data)
}

@deferredCallbacks("finalize")
pub unsafe export "C" fn napi_add_finalizer(
  env: ?*mut u8,
  target: ?*mut u8,
  data: ?*mut u8,
  finalize: Finalize,
  hint: ?*mut u8,
  result: ?*mut ?*mut u8,
) -> i32 {
  return unsafe values.napi_add_finalizer(env, target, data, finalize, hint, result)
}

@threadCallbacks("execute")
@deferredCallbacks("callback")
pub unsafe export "C" fn napi_create_async_work(
  env: ?*mut u8,
  resource: ?*mut u8,
  name: ?*mut u8,
  execute: ?extern "C" fn(?*mut u8, ?*mut u8) -> (),
  callback: Complete,
  data: ?*mut u8,
  result: ?*mut ?*mut Work,
) -> i32 {
  return unsafe asyncs.napi_create_async_work(env, resource, name, execute, callback, data, result)
}

@deferredCallbacks("finalize")
pub unsafe export "C" fn napi_create_external(
  env: ?*mut u8,
  data: ?*mut u8,
  finalize: Finalize,
  hint: ?*mut u8,
  result: ?*mut ?*mut u8,
) -> i32 {
  return unsafe values.napi_create_external(env, data, finalize, hint, result)
}

@deferredCallbacks("finalize")
pub unsafe export "C" fn napi_create_external_arraybuffer(
  env: ?*mut u8,
  data: ?*mut u8,
  length: usize,
  finalize: Finalize,
  hint: ?*mut u8,
  result: ?*mut ?*mut u8,
) -> i32 {
  return unsafe values.napi_create_external_arraybuffer(env, data, length, finalize, hint, result)
}

@deferredCallbacks("finalize")
pub unsafe export "C" fn napi_create_external_buffer(
  env: ?*mut u8,
  length: usize,
  data: ?*mut u8,
  finalize: Finalize,
  hint: ?*mut u8,
  result: ?*mut ?*mut u8,
) -> i32 {
  return unsafe values.napi_create_external_buffer(env, length, data, finalize, hint, result)
}

@deferredCallbacks("callback")
pub unsafe export "C" fn napi_create_function(
  env: ?*mut u8,
  name: ?*const u8,
  length: usize,
  callback: ?extern "C" fn(?*mut u8, ?*mut u8) -> ?*mut u8,
  data: ?*mut u8,
  result: ?*mut ?*mut u8,
) -> i32 {
  return unsafe core.napi_create_function(env, name, length, callback, data, result)
}

@deferredCallbacks("finalize", "call")
pub unsafe export "C" fn napi_create_threadsafe_function(
  env: ?*mut u8,
  callback: ?*mut u8,
  resource: ?*mut u8,
  name: ?*mut u8,
  maximum: usize,
  threads: usize,
  finalizeData: ?*mut u8,
  finalize: Finalize,
  context: ?*mut u8,
  call: CallJs,
  result: ?*mut ?*mut Function,
) -> i32 {
  return unsafe asyncs.napi_create_threadsafe_function(
    env,
    callback,
    resource,
    name,
    maximum,
    threads,
    finalizeData,
    finalize,
    context,
    call,
    result,
  )
}

@deferredCallbacks("constructor")
pub unsafe export "C" fn napi_define_class(
  env: ?*mut u8,
  name: ?*const u8,
  length: usize,
  constructor: Callback,
  data: ?*mut u8,
  count: usize,
  properties: ?*const PropertyDescriptor,
  result: ?*mut ?*mut u8,
) -> i32 {
  return unsafe values.napi_define_class(
    env,
    name,
    length,
    constructor,
    data,
    count,
    properties,
    result,
  )
}

@callbacks("callback")
pub unsafe export "C" fn napi_remove_env_cleanup_hook(
  env: ?*mut u8,
  callback: CleanupHook,
  data: ?*mut u8,
) -> i32 {
  return unsafe asyncs.napi_remove_env_cleanup_hook(env, callback, data)
}

@deferredCallbacks("finalize")
pub unsafe export "C" fn napi_set_instance_data(
  env: ?*mut u8,
  data: ?*mut u8,
  finalize: Finalize,
  hint: ?*mut u8,
) -> i32 {
  return unsafe core.napi_set_instance_data(env, data, finalize, hint)
}

@deferredCallbacks("finalize")
pub unsafe export "C" fn napi_wrap(
  env: ?*mut u8,
  target: ?*mut u8,
  data: ?*mut u8,
  finalize: Finalize,
  hint: ?*mut u8,
  result: ?*mut ?*mut u8,
) -> i32 {
  return unsafe values.napi_wrap(env, target, data, finalize, hint, result)
}

@callbacks("finalize")
pub unsafe export "C" fn node_api_create_external_string_latin1(
  env: ?*mut u8,
  data: ?*mut u8,
  length: usize,
  finalize: Finalize,
  hint: ?*mut u8,
  result: ?*mut ?*mut u8,
  copied: ?*mut bool,
) -> i32 {
  return unsafe values.node_api_create_external_string_latin1(
    env,
    data,
    length,
    finalize,
    hint,
    result,
    copied,
  )
}

@callbacks("finalize")
pub unsafe export "C" fn node_api_create_external_string_utf16(
  env: ?*mut u8,
  data: ?*mut u8,
  length: usize,
  finalize: Finalize,
  hint: ?*mut u8,
  result: ?*mut ?*mut u8,
