  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run blendBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn clipBody() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let circle = run paint(
    &collection,
    &[css.backgroundColor(red()), run declared(Property.ClipPath, b"circle(50%)")],
  )
  run Testing.expect(at(&circle, 50, 50, 255, 0, 0), "inside the circle")
  run Testing.expect(at(&circle, 5, 5, 255, 255, 255), "the corner is clipped")

  let inset = run paint(
    &collection,
    &[css.backgroundColor(red()), run declared(Property.ClipPath, b"inset(10px 20px)")],
  )
  run Testing.expect(at(&inset, 50, 5, 255, 255, 255), "the top inset")
  run Testing.expect(at(&inset, 15, 50, 255, 255, 255), "the left inset")
  run Testing.expect(at(&inset, 25, 15, 255, 0, 0), "what the inset keeps")

  let polygon = run paint(
    &collection,
    &[css.backgroundColor(red()), run declared(Property.ClipPath, b"polygon(0 0, 100% 0, 0 100%)")],
  )
  run Testing.expect(at(&polygon, 20, 20, 255, 0, 0), "inside the triangle")
  run Testing.expect(at(&polygon, 80, 80, 255, 255, 255), "outside it")

  let path = run paint(
    &collection,
    &[css.backgroundColor(red()), run declared(Property.ClipPath, b"path('M0 0 H50 V50 H0 Z')")],
  )
  run Testing.expect(at(&path, 25, 25, 255, 0, 0), "inside the path")
  run Testing.expect(at(&path, 75, 75, 255, 255, 255), "outside it")
}

test effect fn clipPathShapes() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run clipBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn maskBody() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let masked = run paint(
    &collection,
    &[
      css.backgroundColor(red()),
      run declared(Property.MaskImage, b"linear-gradient(to right, black 50%, transparent 50%)"),
    ],
  )
  run Testing.expect(at(&masked, 25, 50, 255, 0, 0), "the opaque half of the mask")
  run Testing.expect(at(&masked, 75, 50, 255, 255, 255), "the transparent half")

  // Clip and mask together keep only where both do.
  let both = run paint(
    &collection,
    &[
      css.backgroundColor(red()),
      run declared(Property.MaskImage, b"linear-gradient(to right, black 50%, transparent 50%)"),
      run declared(Property.ClipPath, b"inset(50px 0 0 0)"),
    ],
  )
  run Testing.expect(at(&both, 25, 75, 255, 0, 0), "kept by both")
  run Testing.expect(at(&both, 25, 25, 255, 255, 255), "clipped")
  run Testing.expect(at(&both, 75, 75, 255, 255, 255), "masked")
}

test effect fn maskImages() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run maskBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// How many pixels are mostly red.
fn reds(pixels: &Pixmap) -> u32 {
  let mut count: u32 = 0
  let mut y: u32 = 0
  while y < pixels.height() {
    let mut x: u32 = 0
    while x < pixels.width() {
      let c = pixels.pixel(x, y)
      if c.r > 200 && c.g < 80 && c.b < 80 {
        count = count + 1
      }
      x = x + 1
    }
    y = y + 1
  }
  return count
}

effect fn textBody() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.style(
    1,
    &[
      css.width(px(100.0)),
      css.height(px(100.0)),
      css.backgroundColor(Rgba<f32>.new(1.0, 1.0, 1.0, 1.0)),
      css.color(Rgba<f32>.new(0.0, 0.0, 0.0, 1.0)),
      css.fontSize(px(30.0)),
      run declared(Property.TextShadow, b"30px 0 red"),
    ],
  )
  run batch.box(1, 2, &[])
  run batch.text(2, 3, "Mm")
  run batch.root(1)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let shadowed = run snapshot.render(&tree)
  run Testing.expect(reds(&shadowed) > 30, "the inherited text shadow paints in red")

  let mut none = Batch.make()
  run none.style(2, &[run declared(Property.TextShadow, b"none")])
  run tree.apply(run none.take())
  run tree.frame(viewport())
  run snapshot.sync(&mut tree)
  let plain = run snapshot.render(&tree)
  run Testing.expect(reds(&plain) == 0, "text-shadow: none on the child stops it")
}

test effect fn textShadowsInherit() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run textBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Draws box 2 with `outer` holding box 3 with `inner` (each 100 by 100 unless they say), or
/// the text "Mm" when `inner` is empty, over the white root.
effect fn nested(collection: &FontCollection, outer: &[Declaration], inner: &[Declaration]) -> Pixmap
  ! TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.style(
    1,
    &[css.width(px(100.0)), css.height(px(100.0)), css.backgroundColor(Rgba<f32>.new(1.0, 1.0, 1.0, 1.0))],
  )
  run batch.box(1, 2, &[css.width(px(100.0)), css.height(px(100.0))])
  run batch.style(2, outer)
  if inner.length == 0 {
    run batch.text(2, 3, "Mm")
  } else {
    run batch.box(2, 3, &[css.width(px(100.0)), css.height(px(100.0))])
    run batch.style(3, inner)
  }
  run batch.root(1)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  return run snapshot.render(&tree)
}

effect fn clipsBody() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()

  // The color stops at the padding box, under a see-through border.
  let full = run paint(&collection, &[css.backgroundColor(red()), css.borderWidth(px(10.0)), run declared(Property.BorderStyle, b"solid"), css.borderColor(Rgba<f32>.new(0.0, 0.0, 1.0, 0.5))])
  let padded = run paint(
    &collection,
    &[
      css.backgroundColor(red()),
      css.borderWidth(px(10.0)), run declared(Property.BorderStyle, b"solid"), css.borderColor(Rgba<f32>.new(0.0, 0.0, 1.0, 0.5)),
      run declared(Property.BackgroundClip, b"padding-box"),
    ],
  )
  run Testing.expect(at(&full, 5, 50, 128, 0, 128), "border-box: red shows through the border")
  run Testing.expect(at(&padded, 5, 50, 128, 128, 255), "padding-box: white shows through it")
  run Testing.expect(at(&padded, 50, 50, 255, 0, 0), "the color still fills the padding box")
  let content = run paint(
    &collection,
    &[css.backgroundColor(red()), css.padding(px(20.0)), run declared(Property.BackgroundClip, b"content-box")],
  )
  run Testing.expect(at(&content, 10, 50, 255, 255, 255), "content-box leaves the padding")
  run Testing.expect(at(&content, 50, 50, 255, 0, 0), "and fills the content box")

  // Clipped to the text: the background shows only inside transparent glyphs.
  let style = [
    css.fontSize(px(40.0)),
    css.color(Rgba<f32>.new(0.0, 0.0, 0.0, 0.0)),
    css.backgroundColor(red()),
    run declared(Property.BackgroundClip, b"text"),
  ]
  let text = run nested(&collection, &style, &[])
  run Testing.expect(reds(&text) > 30, "the glyphs fill with the background")
  run Testing.expect(at(&text, 95, 95, 255, 255, 255), "the box around them stays clear")
  let gradient = [
    css.fontSize(px(40.0)),
    css.color(Rgba<f32>.new(0.0, 0.0, 0.0, 0.0)),
    run declared(Property.BackgroundImage, b"linear-gradient(red, red)"),
    run declared(Property.BackgroundClip, b"text"),
  ]
  let painted = run nested(&collection, &gradient, &[])
  run Testing.expect(reds(&painted) > 30, "a gradient fills the glyphs too")
  run Testing.expect(at(&painted, 95, 95, 255, 255, 255), "and nothing else")

  // Percentage radii: 50% of a square is a circle.
  let round = run paint(&collection, &[css.backgroundColor(red()), css.borderRadius(css.percent(50.0))])
  run Testing.expect(at(&round, 50, 50, 255, 0, 0), "the middle is filled")
  run Testing.expect(at(&round, 8, 8, 255, 255, 255), "the corner is cut")
  run Testing.expect(at(&round, 50, 2, 255, 0, 0), "the edge middle is filled")
  let one = run paint(&collection, &[css.backgroundColor(red()), css.borderTopLeftRadius(css.percent(30.0))])
  run Testing.expect(at(&one, 4, 4, 255, 255, 255), "a percentage on one corner")
  run Testing.expect(at(&one, 96, 4, 255, 0, 0), "rounds only that corner")
}

test effect fn backgroundClipAndPercentRadii() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run clipsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn contextsBody() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let blended = [css.backgroundColor(red()), run declared(Property.MixBlendMode, b"difference")]

  // A blended child blends with the white root, unless its parent isolates it.
  let open = run nested(&collection, &[], &blended)
  run Testing.expect(at(&open, 50, 50, 0, 255, 255), "red differenced with white")
  let isolated = run nested(&collection, &[run declared(Property.Isolation, b"isolate")], &blended)
  run Testing.expect(at(&isolated, 50, 50, 255, 0, 0), "isolate: nothing under it to blend with")
  let auto = run nested(&collection, &[run declared(Property.Isolation, b"auto")], &blended)
  run Testing.expect(at(&auto, 50, 50, 0, 255, 255), "auto blends again")

  // A negative z-index child paints under its parent's background, unless `will-change`
  // makes the parent a stacking context.
  let below = [css.backgroundColor(Rgba<f32>.new(0.0, 0.0, 1.0, 1.0)), css.position(Position.Relative), css.declare(Property.ZIndex, css.number(-1.0))]
  let plain = run nested(&collection, &[css.backgroundColor(red())], &below)
  run Testing.expect(at(&plain, 50, 50, 255, 0, 0), "the child sits under the red parent")
  let changing = run nested(&collection, &[css.backgroundColor(red()), run declared(Property.WillChange, b"opacity, transform")], &below)
  run Testing.expect(at(&changing, 50, 50, 0, 0, 255), "will-change: transform puts it in the parent's context")
  let scrolling = run nested(&collection, &[css.backgroundColor(red()), run declared(Property.WillChange, b"scroll-position")], &below)
  run Testing.expect(at(&scrolling, 50, 50, 255, 0, 0), "a property that makes no context does not")
}

test effect fn isolationAndWillChangeMakeContexts() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run contextsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Draws box 2 with `styles`, then serves the one image the paint asks for, a 2 by 2 blue
/// `pic.png`, and draws again.
effect fn paintLoaded(collection: &FontCollection, styles: &[Declaration]) -> Pixmap
  ! AssertionError<'static> | TreeError | GeometryError | ImageError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.style(
    1,
    &[css.width(px(100.0)), css.height(px(100.0)), css.backgroundColor(Rgba<f32>.new(1.0, 1.0, 1.0, 1.0))],
  )
  run batch.box(1, 2, &[css.width(px(100.0)), css.height(px(100.0))])
  run batch.style(2, styles)
  run batch.root(1)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let first = run snapshot.render(&tree)
  run Testing.expect(at(&first, 50, 50, 255, 255, 255), "nothing shows before the image loads")
  let loads = run tree.takeLoads()
  run Testing.expect(loads.length() == 1, "each url is asked for once")
  let resource = match &loads.asSlice()[0] {
    Mutation.LoadImage { resource, url } => {
      run Testing.expect(String.view(&url) == "pic.png", "the stylesheet url is asked for")
      resource
    }
    _ => { run Testing.expect(false, "an image load") 0 }
  }
  let mut image = run Image.make(2, 2)
  let pixels = image.dataMut()
  let mut i: usize = 0
  while i < pixels.length {
    pixels[i] = if i % 4 == 2 || i % 4 == 3 { 255 } else { 0 }
    i = i + 1
  }
  drop pixels
  run batch.decodedImage(resource, move image)
  run tree.apply(run batch.take())
  run tree.settleSource(resource, true)
  run tree.frame(viewport())
  run Testing.expect((run tree.takeLoads()).length() == 0, "a loaded url is not asked for again")
  run snapshot.sync(&mut tree)
  return run snapshot.render(&tree)
}

effect fn urlImagesBody() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | ImageError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let tiled = run paintLoaded(&collection, &[run declared(Property.BackgroundImage, b"url(pic.png)")])
  run Testing.expect(at(&tiled, 1, 1, 0, 0, 255), "the image draws from the corner")
  run Testing.expect(at(&tiled, 77, 51, 0, 0, 255), "the image repeats at its own size")
  let filtered = run paintLoaded(&collection, &[run declared(Property.BackgroundImage, b"filter(url(pic.png), invert(1))")])
  run Testing.expect(at(&filtered, 1, 1, 255, 255, 0), "filter() draws the image filtered")
  let faded = run paintLoaded(&collection, &[run declared(Property.BackgroundImage, b"cross-fade(url(pic.png) 50%, url(pic.png))"), run declared(Property.BackgroundSize, b"100px 100px")])
  // Added, not laid over each other: two halves of one image make the whole image.
  run Testing.expect(at(&faded, 50, 50, 0, 0, 255), "cross-fade() adds its images by weight")

  let placed = run paintLoaded(
    &collection,
    &[
      run declared(Property.BackgroundImage, b"url(pic.png)"),
      run declared(Property.BackgroundSize, b"50px 50px"),
      run declared(Property.BackgroundRepeat, b"no-repeat"),
    ],
  )
  run Testing.expect(at(&placed, 25, 25, 0, 0, 255), "one tile scaled to its size")
  run Testing.expect(at(&placed, 75, 75, 255, 255, 255), "nothing past the tile")

  let short = run paintLoaded(&collection, &[run declared(Property.Background, b"url(pic.png) 0 0 / 50px 50px repeat-x")])
  run Testing.expect(at(&short, 75, 25, 0, 0, 255), "the shorthand takes a url image, and repeat-x tiles across")
  run Testing.expect(at(&short, 25, 75, 255, 255, 255), "but not down")

  let covered = run paintLoaded(
    &collection,
    &[
      run declared(Property.BackgroundImage, b"url(pic.png)"),
      run declared(Property.BackgroundSize, b"cover"),
      run declared(Property.BackgroundRepeat, b"no-repeat"),
    ],
  )
  run Testing.expect(at(&covered, 95, 95, 0, 0, 255), "cover fills the box")

  let masked = run paintLoaded(
    &collection,
    &[
      css.backgroundColor(red()),
      run declared(Property.MaskImage, b"url(pic.png)"),
      run declared(Property.MaskSize, b"50px 100px"),
      run declared(Property.MaskRepeat, b"no-repeat"),
    ],
  )
  run Testing.expect(at(&masked, 25, 50, 255, 0, 0), "the opaque image keeps the box")
  run Testing.expect(at(&masked, 75, 50, 255, 255, 255), "and the box is hidden past it")

  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.style(1, &[css.width(px(100.0)), css.height(px(100.0))])
  run batch.style(1, &[run declared(Property.BackgroundImage, b"url(\"data:image/svg+xml,<svg/>\")")])
  run batch.root(1)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  drop run snapshot.render(&tree)
  let loads = run tree.takeLoads()
  let resource = match &loads.asSlice()[0] {
    Mutation.LoadIcon { resource, .. } => resource
    _ => { run Testing.expect(false, "an SVG url loads as an icon") 0 }
  }
  run batch.icon(resource, b"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\"><rect width=\"10\" height=\"10\" fill=\"red\"/></svg>")
  run tree.apply(run batch.take())
  run tree.settleSource(resource, true)
  run tree.frame(viewport())
  run snapshot.sync(&mut tree)
  let icon = run snapshot.render(&tree)
  run Testing.expect(at(&icon, 5, 5, 255, 0, 0) && at(&icon, 95, 95, 255, 0, 0), "an SVG image tiles at its own size")
}

test effect fn urlBackgroundsAndMasks() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | ImageError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run urlImagesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Where the first line of text node 3 starts.
effect fn firstLineX(tree: &UiTree<'_>) -> f32 ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<FragmentInfo>.make()
  run fragmentsOf(tree, tree.slotOf(3), &mut out)
  return if out.length() == 0 { -1.0 } else { out.get(0).border.xMin }
}

/// A float's `shape-outside: url()` takes the image's opaque pixels once it loads, and
/// `shape-image-threshold` picks the alpha that counts (CSS Shapes 1 §3.1).
effect fn imageShapeBody() -> ()
  ! AssertionError<'static> | TreeError | ImageError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.style(1, &[css.width(px(100.0)), css.fontSize(px(10.0))])
  run batch.box(1, 2, &[
    css.width(px(80.0)),
    css.height(px(80.0)),
    css.float(Float.Left),
    run declared(Property.ShapeOutside, b"url(shape.png)"),
  ])
  run batch.text(1, 3, "a b c d e f g h")
  run batch.root(1)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  run Testing.expect((run firstLineX(&tree)) >= 80.0, "lines keep off the margin box until the image loads")
  let loads = run tree.takeLoads()
  run Testing.expect(loads.length() == 1, "the shape image is asked for")
  let resource = match &loads.asSlice()[0] {
    Mutation.LoadImage { resource, .. } => resource
    _ => { run Testing.expect(false, "an image load") 0 }
  }
  // 4 by 4: the first column opaque, the second at alpha 100, the rest transparent.
  let mut image = run Image.make(4, 4)
  let pixels = image.dataMut()
  let mut i: usize = 0
  while i < pixels.length {
    let column = (i / 4) % 4
    pixels[i] = if i % 4 != 3 { 0 } else if column == 0 { 255 } else if column == 1 { 100 } else { 0 }
    i = i + 1
  }
  drop pixels
  run batch.decodedImage(resource, move image)
  run tree.apply(run batch.take())
  run tree.settleSource(resource, true)
  run tree.frame(viewport())
  let wrapped = run firstLineX(&tree)
  run Testing.expect(wrapped >= 40.0 && wrapped < 50.0, "lines wrap around the pixels with any alpha")
  run batch.style(2, &[run declared(Property.ShapeImageThreshold, b"0.5")])
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let opaque = run firstLineX(&tree)
  run Testing.expect(opaque >= 20.0 && opaque < 30.0, "a higher threshold leaves the translucent column out")
  run batch.style(2, &[run declared(Property.ShapeImageThreshold, b"30%")])
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  run Testing.expect((run firstLineX(&tree)) == wrapped, "a percentage threshold")
  run batch.style(2, &[run declared(Property.ShapeOutside, b"linear-gradient(to right, black 25%, transparent 25%)")])
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let gradient = run firstLineX(&tree)
  run Testing.expect(gradient >= 20.0 && gradient < 30.0, "a gradient's opaque part makes the shape")
}

test effect fn imageShapes() -> ()
  ! AssertionError<'static> | TreeError | ImageError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run imageShapeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
