//! The xbench scenes (SCENES.md) straight onto ui-tree: the app reads the corpus and makes every
//! node itself (create, class, text, insert), and each frame sends the mutations the scene
//! needs. No JavaScript, no framework, no view, no diff: the floor under Silk UI + React and
//! Silk UI + Loom.
//!
//!   silk-direct <scene>            feed, wall, stream, churn; a size after a dash: feed-3000
//!
//! With SILK_UI_BENCH it runs on ui-tree-window's windowless bench (no window, GPU or display,
//! a clock that moves 1/120 s a frame); without it, in a window. Either way it prints the
//! protocol lines (PROTOCOL.md) on standard error.
import ui_tree.css
import ui_tree.css { px }
import ui_tree.legacy { UiTree, TreeError, Mutation, NodeKind, Attribute, StyleState, Keyword, FlexDirection, BoxSizing, Declaration, Event, EventKind, LISTEN_LAYOUT }
