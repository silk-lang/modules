    unsafe ibReset(sp)
    return 0
  }
  if kind == RST_STREAM {
    let rv = unsafe onRstStreamReceived(sp)
    if isFatal(rv) { return rv }
    if unsafe state(sp) == IB_IGN_ALL { return 1 }
    unsafe ibReset(sp)
    return 0
  }
  if kind == PUSH_PROMISE {
    if padlen == 0 && u8.bitAnd(flags, F_PADDED) != 0 {
      let pad = unsafe computePad(sp)
      if pad < 0 || i64.toUsize(pad) + 4 > 1 + left {
        let rv = unsafe terminateSession(sp, PROTOCOL_ERROR, b"PUSH_PROMISE: invalid padding")
        if isFatal(rv) { return rv }
        return 1
      }
      if left < 4 { unsafe setState(sp, IB_FRAME_SIZE_ERROR) return 2 }
      unsafe setState(sp, IB_READ_NBYTE) unsafe setMark(sp, 4)
      return 0
    }
    let rv = unsafe processPushPromiseFrame(sp)
    if isFatal(rv) { return rv }
    if unsafe state(sp) == IB_IGN_ALL { return 1 }
    if rv == ERR_TEMPORAL_CALLBACK_FAILURE {
      let s2 = unsafe ses(&mut a, sp) let promised = s2.promised drop s2
      let rv2 = unsafe addRst(sp, promised, INTERNAL_ERROR, true)
      if isFatal(rv2) { return rv2 }
      unsafe setState(sp, IB_IGN_HEADER_BLOCK)
      return 2
    }
    unsafe setState(sp, if rv == ERR_IGN_HEADER_BLOCK { IB_IGN_HEADER_BLOCK } else { IB_READ_HEADER_BLOCK })
    return 2
  }
  if kind == PING {
    let rv = unsafe onPingReceived(sp)
    if isFatal(rv) { return rv }
    if unsafe state(sp) == IB_IGN_ALL { return 1 }
    unsafe ibReset(sp)
    return 0
  }
  if kind == GOAWAY {
    unsafe setState(sp, IB_READ_GOAWAY_DEBUG)
    return 2
