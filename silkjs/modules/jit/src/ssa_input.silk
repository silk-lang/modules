//! The translator's input read from an engine function: plain numbers and a copy of the code.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u16
import silkjs.js_core_types { FunctionBytecode, FunctionKind, ClosureKind }
import silkjs.js_heap { HeapCell }
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.usize
import silkjs.js_value { ValueBits }
import ssa_translate { FunctionInput, CallTarget, ConstructTarget, NumberConstant, CONSTANT_OTHER, CONSTANT_INT, CONSTANT_DOUBLE, CLOSURE_NONE, CLOSURE_SAFE, CLOSURE_FRAME, SiteShape, RecordSlot }

/// What `ssa_translate.translate` needs from `bytecode`. The caller keeps the function alive
/// for the call; the result owns its copy of the code.
pub effect fn inputOf(bytecode: &FunctionBytecode) -> FunctionInput ! OutOfMemoryError ? &mut Allocator {
  let mut code = List<u8>.make()
  run code.appendSlice(unsafe bytecode.code.asSlice())
  let mut numbers = List<NumberConstant>.make()
  let mut closures = List<u8>.make()
  let mut index: usize = 0
  while index < bytecode.constants.length() {
    let constant = match bytecode.constants.get(index) {
      ValueBits.Int { value } => NumberConstant { kind: CONSTANT_INT, bits: u32.toU64(i32.wrappingToU32(value)) }
      ValueBits.Float64 { value } => NumberConstant { kind: CONSTANT_DOUBLE, bits: f64.toBits(value) }
      _ => NumberConstant { kind: CONSTANT_OTHER, bits: 0 }
    }
    run numbers.append(constant)
    run closures.append(closureOf(bytecode.constants.get(index)))
    index = index + 1
  }
  let mut capturedLocals = false
  index = 0
  while index < bytecode.varDefs.length() { if bytecode.varDefs.get(index).isCaptured { capturedLocals = true } index = index + 1 }
  return FunctionInput { code: move code, argumentCount: u16.toU32(bytecode.argumentCount), localCount: u16.toU32(bytecode.variableCount),
    closureVars: u16.toU32(bytecode.varRefCount), scopeSlots: u16.toU32(bytecode.scopeSlots), normal: bytecode.kind == FunctionKind.Normal,
    numberConstants: move numbers, doubleSites: List<u32>.make(), notedSites: 0, capturedLocals: capturedLocals,
    closures: move closures, strict: bytecode.mode != 0, targets: List<CallTarget>.make(), elementKinds: List<u32>.make(), siteShapes: List<SiteShape>.make(), leavesBodies: false, arrayPush: 0, arrayPop: 0, arrayShape: 0, records: List<RecordSlot>.make(), constructs: List<ConstructTarget>.make() }
}

/// What creating a closure of `constant` needs from the creating frame (FunctionInput.closures).
fn closureOf(constant: ValueBits) -> u8 {
  let reference = match constant { ValueBits.FunctionBytecode { reference } => reference _ => { return CLOSURE_NONE } }
  let anchor = () let child = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, reference)
  if child.kind != FunctionKind.Normal { return CLOSURE_FRAME }
  let count = child.closureVars.length() - u16.toUsize(child.scopeCaptures)
  let mut index: usize = 0
  while index < count {
    let kind = child.closureVars.get(index).kind
    // Local and Argument captures take cells of the frame's own slots (closures.fill), which
    // compiled code keeps in registers; a GlobalDeclaration is eval's.
    if kind == ClosureKind.Local || kind == ClosureKind.Argument || kind == ClosureKind.GlobalDeclaration { return CLOSURE_FRAME }
    index = index + 1
  }
  return CLOSURE_SAFE
}
