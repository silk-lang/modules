    let _ok = unsafe s.iv.append(unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe Intrinsic.pointerReinterpret<*const Setting, *const u8>(Pointer.fromRef<Setting>(&entry))), 8)
