//! Where Motion Path 1 puts a box: the point `offset-distance` along its `offset-path` and the
//! direction there, against the containing block. `transform.matrixAlong` turns it into the
//! offset step of the box's transform.
//!
//! Shapes follow Chromium: `path()` coordinates start at the box's own border-box corner; basic
//! shapes and boxes lie in the containing block's reference box and run clockwise, circles and
//! ellipses from their rightmost point, rectangles from the top-left corner (after its rounding).
import engine { UiTree }
import layers
import node { NO_INDEX }
import paint { borderBox, paddingBox, contentBox }
import paint_css { Effects }
import transform { Offset, Placement }
import transform
import svg_css.effect_values { ClipSource, Shape, RadialSize, Extent, RectangleKind }
import svg_css.transform_values { PositionAxis, Edge }
import svg_css.dimensions { ExprId }
import svg_text.on_path
import silk.collections.list { List }
import silk.core.option { Option }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.usize

const PI: f32 = 3.14159265358979
/// Chords per quarter of an ellipse or a rounded corner.
const QUARTER: usize = 90

/// A flattened path: points and whether it closes.
struct Line {
  xs: List<f32>,
  ys: List<f32>,
  closed: bool,
}

impl Line {
  fn make(closed: bool) -> Line {
    return Line { xs: List<f32>.make(), ys: List<f32>.make(), closed: closed }
  }

  effect fn add(self: &mut Self, x: f32, y: f32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.xs.append(x)
    run self.ys.append(y)
  }

  // The quarter ellipse about (cx, cy) from angle `from` (radians, clockwise from +x).
  effect fn arc(self: &mut Self, cx: f32, cy: f32, rx: f32, ry: f32, from: f32) -> () ! OutOfMemoryError ? &mut Allocator {
    if rx <= 0.0 || ry <= 0.0 {
      run self.add(cx + rx * f32.cos(from), cy + ry * f32.sin(from))
      return ()
    }
    let mut k: usize = 0
    while k <= QUARTER {
      let a = from + PI * 0.5 * usize.toF32(k) / usize.toF32(QUARTER)
      run self.add(cx + rx * f32.cos(a), cy + ry * f32.sin(a))
      k = k + 1
    }
  }
}

fn pixels(effects: &Effects, id: ExprId, basis: f32) -> f32 {
  return effects.pixels(id, basis)
}

fn edgeOr(effects: &Effects, edge: Option<ExprId>, basis: f32, otherwise: f32) -> f32 {
  return match edge {
    Option<ExprId>.Some { value } => effects.pixels(value, basis)
    Option<ExprId>.None => otherwise
  }
}

fn axisOffset(effects: &Effects, axis: PositionAxis, free: f32) -> f32 {
  let offset = effects.pixels(axis.offset, free)
  return match axis.edge {
    Edge.Start => offset
    Edge.End => free - offset
    Edge.Center => free * 0.5 + offset
  }
}

// A rectangle, clockwise from its top-left corner, with corner radii tl, tr, br, bl.
effect fn rectangle(line: &mut Line, r: Rect<f32>, radii: [f32; 4]) -> () ! OutOfMemoryError ? &mut Allocator {
  let w = r.xMax - r.xMin
  let h = r.yMax - r.yMin
  // Radii that do not fit scale down together (CSS Backgrounds 3 §"Overlapping Curves").
  let mut f: f32 = 1.0
  if radii[0] + radii[1] > w && w > 0.0 { f = f32.min(f, w / (radii[0] + radii[1])) }
  if radii[3] + radii[2] > w && w > 0.0 { f = f32.min(f, w / (radii[3] + radii[2])) }
  if radii[0] + radii[3] > h && h > 0.0 { f = f32.min(f, h / (radii[0] + radii[3])) }
  if radii[1] + radii[2] > h && h > 0.0 { f = f32.min(f, h / (radii[1] + radii[2])) }
  let tl = radii[0] * f
  let tr = radii[1] * f
  let br = radii[2] * f
  let bl = radii[3] * f
  run line.add(r.xMin + tl, r.yMin)
  if tr > 0.0 { run line.arc(r.xMax - tr, r.yMin + tr, tr, tr, -PI * 0.5) } else { run line.add(r.xMax, r.yMin) }
  if br > 0.0 { run line.arc(r.xMax - br, r.yMax - br, br, br, 0.0) } else { run line.add(r.xMax, r.yMax) }
  if bl > 0.0 { run line.arc(r.xMin + bl, r.yMax - bl, bl, bl, PI * 0.5) } else { run line.add(r.xMin, r.yMax) }
  if tl > 0.0 { run line.arc(r.xMin + tl, r.yMin + tl, tl, tl, PI) } else { run line.add(r.xMin, r.yMin) }
}

// Basic shape `shape` in reference box `area`; `own` is the box's border box, where `path()`
// coordinates start.
effect fn shapeLine(effects: &Effects, shape: &Shape, area: Rect<f32>, own: Rect<f32>) -> Line ! OutOfMemoryError ? &mut Allocator {
  let w = area.xMax - area.xMin
  let h = area.yMax - area.yMin
  match &shape.* {
    Shape.Rectangle { kind, edges, corners } => {
      let mut rect = area
      if kind == RectangleKind.Inset {
        rect = Rect<f32>.new(
          area.xMin + edgeOr(effects, edges[3], w, 0.0),
          area.yMin + edgeOr(effects, edges[0], h, 0.0),
          area.xMax - edgeOr(effects, edges[1], w, 0.0),
          area.yMax - edgeOr(effects, edges[2], h, 0.0),
        )
      } else if kind == RectangleKind.Rect {
        rect = Rect<f32>.new(
          area.xMin + edgeOr(effects, edges[3], w, 0.0),
          area.yMin + edgeOr(effects, edges[0], h, 0.0),
          area.xMin + edgeOr(effects, edges[1], w, w),
          area.yMin + edgeOr(effects, edges[2], h, h),
        )
      } else {
        let x = area.xMin + edgeOr(effects, edges[0], w, 0.0)
        let y = area.yMin + edgeOr(effects, edges[1], h, 0.0)
        rect = Rect<f32>.new(x, y, x + edgeOr(effects, edges[2], w, w), y + edgeOr(effects, edges[3], h, h))
      }
      let mut radii: [f32; 4] = [0.0; 4]
      let mut i: usize = 0
      while i < 4 {
        radii[i] = f32.min(pixels(effects, corners.x[i], w), pixels(effects, corners.y[i], h))
        i = i + 1
      }
      let mut line = Line.make(true)
      run rectangle(&mut line, rect, radii)
      return move line
    }
    Shape.Ellipse { circle, size, position } => {
      let cx = area.xMin + axisOffset(effects, position.x, w)
      let cy = area.yMin + axisOffset(effects, position.y, h)
      let left = cx - area.xMin
      let right = area.xMax - cx
      let top = cy - area.yMin
      let bottom = area.yMax - cy
      let mut rx: f32 = 0.0
      let mut ry: f32 = 0.0
      match size {
        RadialSize.Extent { extent } => {
          let far = extent == Extent.FarthestSide || extent == Extent.FarthestCorner
          rx = if far { f32.max(f32.abs(left), f32.abs(right)) } else { f32.min(f32.abs(left), f32.abs(right)) }
          ry = if far { f32.max(f32.abs(top), f32.abs(bottom)) } else { f32.min(f32.abs(top), f32.abs(bottom)) }
          if circle {
            let r = if far { f32.max(rx, ry) } else { f32.min(rx, ry) }
            rx = r
            ry = r
          }
        }
        RadialSize.Radii { x, y } => {
          if circle {
            let basis = f32.sqrt(w * w + h * h) / f32.sqrt(2.0)
            rx = effects.pixels(x, basis)
            ry = rx
          } else {
            rx = effects.pixels(x, w)
            ry = match y {
              Option<ExprId>.Some { value } => effects.pixels(value, h)
              Option<ExprId>.None => rx
            }
          }
        }
      }
      let mut line = Line.make(true)
      let mut q: usize = 0
      while q < 4 {
        run line.arc(cx, cy, rx, ry, PI * 0.5 * usize.toF32(q))
        q = q + 1
      }
      return move line
    }
    Shape.Polygon { points, .. } => {
      let mut line = Line.make(true)
      let list = points.asSlice()
      let mut i: usize = 0
      while i < list.length {
        run line.add(area.xMin + effects.pixels(list[i].x, w), area.yMin + effects.pixels(list[i].y, h))
        i = i + 1
      }
      if list.length > 0 {
        run line.add(area.xMin + effects.pixels(list[0].x, w), area.yMin + effects.pixels(list[0].y, h))
      }
      return move line
    }
    Shape.Path { path, .. } => {
      let mut closes = List<bool>.make()
      let subpaths = run on_path.polylines(&path, &mut closes)
      let all = subpaths.asSlice()
      let mut line = Line.make(all.length == 1 && closes.length() == 1 && closes.asSlice()[0])
      let mut s: usize = 0
      while s < all.length {
        let points = all[s].asSlice()
        let mut k: usize = 0
        while k < points.length {
          run line.add(own.xMin + f64.toF32(points[k].x), own.yMin + f64.toF32(points[k].y))
          k = k + 1
        }
        s = s + 1
      }
      return move line
    }
    Shape.Commands { .. } => {
      return Line.make(false)
    }
  }
}

/// The reference box `kind` (a `transform.BOX_*`) of fragment rects `border`, `padding`,
/// `content`.
pub fn referenceBox(kind: u8, border: Rect<f32>, padding: Rect<f32>, content: Rect<f32>) -> Rect<f32> {
  if kind == transform.BOX_PADDING { return padding }
  if kind == transform.BOX_CONTENT { return content }
  return border
}

// The ray's length from `s` against `area` (Motion Path 1 §"ray()").
fn rayLength(size: u8, sx: f32, sy: f32, ux: f32, uy: f32, area: Rect<f32>) -> f32 {
  let left = f32.abs(sx - area.xMin)
  let right = f32.abs(area.xMax - sx)
  let top = f32.abs(sy - area.yMin)
  let bottom = f32.abs(area.yMax - sy)
  if size == transform.RAY_CLOSEST_SIDE { return f32.min(f32.min(left, right), f32.min(top, bottom)) }
  if size == transform.RAY_FARTHEST_SIDE { return f32.max(f32.max(left, right), f32.max(top, bottom)) }
  if size == transform.RAY_SIDES {
    if sx < area.xMin || sx > area.xMax || sy < area.yMin || sy > area.yMax { return 0.0 }
    let mut t: f32 = 1.0e30
    if ux > 0.000001 { t = f32.min(t, (area.xMax - sx) / ux) }
    if ux < -0.000001 { t = f32.min(t, (area.xMin - sx) / ux) }
    if uy > 0.000001 { t = f32.min(t, (area.yMax - sy) / uy) }
    if uy < -0.000001 { t = f32.min(t, (area.yMin - sy) / uy) }
    return if t >= 1.0e29 { 0.0 } else { t }
  }
  let w = f32.max(left, right)
  let h = f32.max(top, bottom)
  if size == transform.RAY_FARTHEST_CORNER { return f32.sqrt(w * w + h * h) }
  let nw = f32.min(left, right)
  let nh = f32.min(top, bottom)
  return f32.sqrt(nw * nw + nh * nh)
}

fn startOf(offset: &Offset, own: Rect<f32>, area: Rect<f32>) -> [f32; 2] {
  if offset.rayAtSet {
    let p = offset.rayAt.at(area)
    return [p.x, p.y]
  }
  if offset.positionKind == transform.PLACE_AUTO {
    return [own.xMin, own.yMin]
  }
  if offset.positionKind == transform.PLACE_SET {
    let p = offset.position.at(area)
    return [p.x, p.y]
  }
  return [(area.xMin + area.xMax) * 0.5, (area.yMin + area.yMax) * 0.5]
}

fn turned(offset: &Offset, tangent: f32) -> f32 {
  return if offset.autoRotate { tangent + offset.rotate } else { offset.rotate }
}

/// Where `offset` puts the box with border box `own` (its layout space), whose containing block
/// has reference box `area` there; `anchor` is the point of the box that goes on the path (the
/// transform origin unless `offset-anchor` sets one). None when the path draws nothing.
pub effect fn place(offset: &Offset, effects: Option<&Effects>, own: Rect<f32>, area: Rect<f32>, anchor: [f32; 2]) -> Option<Placement>
  ! OutOfMemoryError
  ? &mut Allocator {
  if offset.path == transform.PATH_RAY {
    let s = startOf(offset, own, area)
    let ux = f32.sin(offset.rayAngle)
    let uy = -f32.cos(offset.rayAngle)
    let mut length = rayLength(offset.raySize, s[0], s[1], ux, uy, area)
    let rotation = turned(offset, offset.rayAngle - PI * 0.5)
    if offset.contain {
      length = contained(length, own, anchor, rotation, ux, uy)
    }
    let d = offset.distance + offset.distanceFraction * length
    return Option<Placement>.some(Placement { x: s[0] + ux * d, y: s[1] + uy * d, angle: rotation })
  }
  let mut line = Line.make(true)
  if offset.path == transform.PATH_BOX {
    run rectangle(&mut line, area, [0.0; 4])
  } else {
    let found = match effects {
      Option<&Effects>.Some { value } => value
      Option<&Effects>.None => { return Option<Placement>.None }
    }
    if found.offset.length() == 0 { return Option<Placement>.None }
    match &found.offset.asSlice()[0] {
      ClipSource.Shape { shape, .. } => {
        line = run shapeLine(found, &shape, area, own)
      }
      _ => { return Option<Placement>.None }
    }
  }
  return along(&line, offset)
}

// The point `offset-distance` along `line`: open paths clamp, closed ones wrap around.
fn along(line: &Line, offset: &Offset) -> Option<Placement> {
  let xs = line.xs.asSlice()
  let ys = line.ys.asSlice()
  if xs.length == 0 { return Option<Placement>.None }
  let mut total: f32 = 0.0
  let mut i: usize = 1
  while i < xs.length {
    total = total + hypot(xs[i] - xs[i - 1], ys[i] - ys[i - 1])
    i = i + 1
  }
  let mut d = offset.distance + offset.distanceFraction * total
  if line.closed && total > 0.0 {
    d = d - total * f32.floor(d / total)
  } else {
    d = f32.max(0.0, f32.min(total, d))
  }
  // The direction of the first piece with a length, for a point before it.
  let mut tx: f32 = 1.0
  let mut ty: f32 = 0.0
  let mut seen = false
  let mut walked: f32 = 0.0
  i = 1
  while i < xs.length {
    let dx = xs[i] - xs[i - 1]
    let dy = ys[i] - ys[i - 1]
    let size = hypot(dx, dy)
    if size > 0.0 {
      tx = dx / size
      ty = dy / size
      seen = true
      if walked + size >= d {
        let f = (d - walked) / size
        return Option<Placement>.some(Placement {
          x: xs[i - 1] + dx * f,
          y: ys[i - 1] + dy * f,
          angle: turned(offset, f32.atan2(ty, tx)),
        })
      }
      walked = walked + size
    }
    i = i + 1
  }
  let last = xs.length - 1
  let tangent: f32 = if seen { f32.atan2(ty, tx) } else { 0.0 }
  return Option<Placement>.some(Placement { x: xs[last], y: ys[last], angle: turned(offset, tangent) })
}

fn hypot(x: f32, y: f32) -> f32 {
  return f32.sqrt(x * x + y * y)
}

// `ray(... contain)`: the ray shortens until the box, turned by `rotation` about `anchor`, fits
// in the circle of the ray's length about its start.
fn contained(length: f32, own: Rect<f32>, anchor: [f32; 2], rotation: f32, ux: f32, uy: f32) -> f32 {
  let c = f32.cos(rotation)
  let s = f32.sin(rotation)
  let xs = [own.xMin, own.xMax, own.xMax, own.xMin]
  let ys = [own.yMin, own.yMin, own.yMax, own.yMax]
  let mut best = length
  let mut i: usize = 0
  while i < 4 {
    let lx = xs[i] - anchor[0]
    let ly = ys[i] - anchor[1]
    let vx = lx * c - ly * s
    let vy = lx * s + ly * c
    let along = vx * ux + vy * uy
    let disc = along * along - (vx * vx + vy * vy) + length * length
    let reach: f32 = if disc >= 0.0 { f32.sqrt(disc) - along } else { 0.0 }
    best = f32.min(best, f32.max(0.0, reach))
    i = i + 1
  }
  return best
}

/// Places every box with an `offset-path` after layout, into `Node.offsetPlaced`, where
/// `layers.transformOf` reads it. Free until some style uses a path (`UiTree.offsetUsed`).
pub effect fn settle(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !tree.offsetUsed { return () }
  let count = tree.nodes.length()
  let mut slot: usize = 0
  while slot < count {
    let node = &tree.nodes.asSlice()[slot]
    let offset = node.computed().transform.offset
    let mut next = Option<Placement>.None
    if node.live && offset.path != transform.PATH_NONE {
      let index = if node.css < tree.fragmentOf.length() { tree.fragmentOf.get(node.css) } else { NO_INDEX }
      if index != NO_INDEX && index < tree.output.fragments.values.length() {
        let values = tree.output.fragments.values.asSlice()
        let own = borderBox(&values[index])
        let cb = layers.containingFragment(&tree.output, &tree.slotOfCss, &tree.nodes, index)
        let area = if cb == NO_INDEX { own } else {
          let f = &values[cb]
          referenceBox(offset.box, borderBox(f), paddingBox(f), contentBox(f))
        }
        let t = &node.computed().transform
        let origin = t.origin.at(own)
        let anchor = if offset.anchorAuto { [origin.x, origin.y] } else {
          let a = offset.anchor.at(own)
          [a.x, a.y]
        }
        next = run place(&offset, node.paintEffects(), own, area, anchor)
      }
    }
    let target = &mut tree.nodes.asMutSlice()[slot]
    if next.isSome() || target.rare.isSome() {
      let rare = run target.rareMut()
      rare.offsetPlaced = next
    }
    slot = slot + 1
  }
}
