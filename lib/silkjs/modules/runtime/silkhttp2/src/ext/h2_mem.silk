//! Raw memory for the HTTP/2 session: the C allocator (ext/http2_native shares it), byte access by
//! index, and `Buf`, a growable byte buffer the session owns and frees itself.
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.num.u8
import silk.num.u32

pub unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
pub unsafe extern "C" fn realloc(ptr: ?*mut u8, size: usize) -> ?*mut u8
pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
pub unsafe extern "C" fn free(ptr: ?*mut u8) -> ()
@foreign(noCapture: .("dest", "source"))
pub unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, count: usize) -> *mut u8
@foreign(noCapture: .("dest", "source"))
pub unsafe extern "C" fn memmove(dest: *mut u8, source: *const u8, count: usize) -> *mut u8

pub fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
pub unsafe fn nonnull<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
pub unsafe fn constant(p: ?*mut u8) -> ?*const u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, ?*const u8>(p) }
/// The address `index` bytes past `p`.
pub unsafe fn at(p: ?*mut u8, index: usize) -> *mut u8 {
  return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(p)), index)
}
pub unsafe fn atConst(p: ?*const u8, index: usize) -> *const u8 {
  return unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(p)), index)
}
pub unsafe fn byte(p: ?*const u8, index: usize) -> u8 { return unsafe Pointer.read<u8>(unsafe atConst(p, index)) }
pub unsafe fn setByte(p: ?*mut u8, index: usize, value: u8) -> () { unsafe Pointer.put<u8>(unsafe at(p, index), value) }
pub unsafe fn copy(dest: ?*mut u8, source: ?*const u8, count: usize) -> () {
  if count == 0 { return () }
  let _ignored = unsafe memcpy(unsafe nonnull(dest), unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(source), count)
}
pub unsafe fn moveBytes(dest: ?*mut u8, source: ?*const u8, count: usize) -> () {
  if count == 0 { return () }
  let _ignored = unsafe memmove(unsafe nonnull(dest), unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(source), count)
}
/// Whether `count` bytes at `a` and `b` are the same.
pub unsafe fn same(a: ?*const u8, b: ?*const u8, count: usize) -> bool {
  let mut i: usize = 0
  while i < count { if unsafe byte(a, i) != unsafe byte(b, i) { return false } i = i + 1 }
  return true
}
/// Whether `count` bytes at `a` are `text`.
pub unsafe fn equals(a: ?*const u8, count: usize, text: &[u8]) -> bool {
  if count != text.length { return false }
  let mut i: usize = 0
  while i < count { if unsafe byte(a, i) != text[i] { return false } i = i + 1 }
  return true
}
/// A static text as the C string pointer the callbacks expect.
pub fn cText(bytes: &'static [u8]) -> ?*mut u8 {
  return unsafe Intrinsic.pointerRequalify<*const u8, ?*mut u8>(Pointer.fromRef<u8>(&bytes[0]))
}
pub fn textPointer(bytes: &[u8]) -> ?*const u8 {
  if bytes.length == 0 { return unsafe Intrinsic.pointerRequalify<?*mut u8, ?*const u8>(nil()) }
  return unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(Pointer.fromRef<u8>(&bytes[0]))
}
pub fn getU16(p: ?*const u8, index: usize) -> u32 {
  return u32.bitOr(u32.shiftLeft(u8.toU32(unsafe byte(p, index)), 8), u8.toU32(unsafe byte(p, index + 1)))
}
pub fn getU32(p: ?*const u8, index: usize) -> u32 {
  return u32.bitOr(u32.shiftLeft(getU16(p, index), 16), getU16(p, index + 2))
}

/// A growable byte buffer.
pub struct Buf { pub data: ?*mut u8, pub length: usize, pub capacity: usize }

pub fn emptyBuf() -> Buf { return Buf { data: nil(), length: 0, capacity: 0 } }
impl Buf {
  /// Room for `extra` more bytes; false when memory ran out.
  pub unsafe fn reserve(self: &mut Self, extra: usize) -> bool {
    if self.capacity - self.length >= extra { return true }
    let mut wanted = self.capacity * 2
    if wanted < self.length + extra { wanted = self.length + extra }
    if wanted < 64 { wanted = 64 }
    let grown = unsafe realloc(self.data, wanted)
    if Pointer.isNull<u8>(grown) { return false }
    self.data = grown
    self.capacity = wanted
    return true
  }
  pub unsafe fn append(self: &mut Self, source: ?*const u8, count: usize) -> bool {
    if count == 0 { return true }
    if !unsafe self.reserve(count) { return false }
    unsafe copy(unsafe at(self.data, self.length), source, count)
    self.length = self.length + count
    return true
  }
  pub unsafe fn appendText(self: &mut Self, text: &[u8]) -> bool { return unsafe self.append(textPointer(text), text.length) }
  pub unsafe fn push(self: &mut Self, value: u8) -> bool {
    if !unsafe self.reserve(1) { return false }
    unsafe setByte(self.data, self.length, value)
    self.length = self.length + 1
    return true
  }
  pub unsafe fn pushU16(self: &mut Self, value: u32) -> bool {
    return unsafe self.push(u32.wrappingToU8(u32.shiftRight(value, 8))) && unsafe self.push(u32.wrappingToU8(value))
  }
  pub unsafe fn pushU24(self: &mut Self, value: u32) -> bool {
    return unsafe self.push(u32.wrappingToU8(u32.shiftRight(value, 16))) && unsafe self.pushU16(u32.bitAnd(value, 65535))
  }
  pub unsafe fn pushU32(self: &mut Self, value: u32) -> bool {
    return unsafe self.pushU16(u32.shiftRight(value, 16)) && unsafe self.pushU16(u32.bitAnd(value, 65535))
  }
  pub fn byteAt(self: &Self, index: usize) -> u8 { return unsafe byte(unsafe constant(self.data), index) }
  pub fn view(self: &Self) -> ?*const u8 { return unsafe constant(self.data) }
  pub fn clear(self: &mut Self) -> () { self.length = 0 }
  pub unsafe fn release(self: &mut Self) -> () {
    unsafe free(self.data)
    self.data = nil()
    self.length = 0
    self.capacity = 0
  }
}

