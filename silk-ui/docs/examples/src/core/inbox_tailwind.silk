//! A small inbox styled with Tailwind's variants: rows that react as a group, a hint that
//! follows its neighbour, zebra rows, dividers, a data attribute and a dark theme.
import loom.lib { Document, Node, NoCommand, NoOutput, Program, Update }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32

pub struct Inbox {
  /// Which of the three messages have been read.
  pub read: [bool; 3],
  pub dark: bool,
}

pub union Message {
  ClickedMail { pub index: u32 },
  ClickedTheme,
}

type Next = Update<Inbox, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Inbox {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(Inbox { read: [false, true, false], dark: false })
  }

  effect fn update(mut model: Inbox, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.ClickedMail { index } => {
        model.read[u32.toUsize(index)] = !model.read[u32.toUsize(index)]
      }
      Message.ClickedTheme => {
        model.dark = !model.dark
      }
    }
    return Next.of(move model)
  }

  fn view(model: &Inbox, h: &Document<Message>) -> Node {
    return h.box(
      // `dark:` classes below apply inside a node with the class `dark`.
      &[h.class("p-4"), h.classWhen(model.dark, "dark")],
      &[
        h.box(
          &[
            h.class("w-[min(100%,26rem)] rounded-xl border border-gray-200 bg-white text-gray-800"),
            h.class("dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"),
          ],
          &[
            h.box(
              &[h.class("flex items-center gap-2 p-3")],
              &[
                h.box(&[h.class("flex-1 font-bold")], &[h.text("Inbox")]),
                // `peer` names this button for the siblings after it.
                h.button(
                  &[
                    h.onClick(Message.ClickedTheme),
                    h.class("peer rounded-md px-2 py-1 text-[13px] hover:bg-gray-100 dark:hover:bg-gray-800"),
                  ],
                  &[h.text(if model.dark { "Light" } else { "Dark" })],
                ),
                h.box(
                  &[h.class("text-[12px] text-gray-500 opacity-0 transition-opacity peer-hover:opacity-100")],
                  &[h.text("Switches the theme")],
                ),
              ],
            ),
            // `divide-y` draws a line between the rows, not around them.
            h.box(
              &[h.class("divide-y divide-gray-200 border-t border-gray-200 dark:divide-gray-700 dark:border-gray-700")],
              &[
                mail(h, model, 0, "Welcome to Silk"),
                mail(h, model, 1, "Your build passed"),
                mail(h, model, 2, "Review the release notes"),
              ],
            ),
          ],
        ),
      ],
    )
  }
}

/// One message. Clicking it marks it read or unread.
fn mail(h: &Document<Message>, model: &Inbox, index: u32, subject: string) -> Node {
  let read = model.read[u32.toUsize(index)]
  return h.button(
    &[
      h.onClick(Message.ClickedMail { index: index }),
      h.attribute("data-state", if read { "read" } else { "unread" }),
      // `group` names the row for its descendants; `has-[.dot]` reads one of them back.
      h.class("group flex items-center gap-3 p-3 odd:bg-gray-50 hover:bg-teal-50 last:rounded-b-xl has-[.dot]:font-semibold"),
      h.class("dark:odd:bg-gray-800 dark:hover:bg-gray-700"),
    ],
    &[
      h.box(&[h.class("size-2 rounded-full"), h.classSelect(read, "bg-transparent", "dot bg-teal-600")], &[]),
      h.box(&[h.class("flex-1 group-data-[state=read]:text-gray-500")], &[h.text(subject)]),
      h.box(
        &[h.class("text-[12px] text-teal-700 opacity-0 transition-opacity group-hover:opacity-100 dark:text-teal-300")],
        &[h.text(if read { "Mark unread" } else { "Mark read" })],
      ),
    ],
  )
}
