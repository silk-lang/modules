//! Which GPU canvases show in a compositor layer of their own, and the decisions around it
//! (`ui_tree_window.canvas_layer_plan`), without a window.
import ui_tree_window.canvas_layer_plan {
  PATH_KEEP,
  PATH_TO_LAYER,
  PATH_TO_WINDOW,
  canvasWakeDrawsWindow,
  layerPollDelay,
  layerStateOf,
  layersAllowed,
  pathChange,
  pictureReady,
  spritesOf,
  switchedOn,
  wantsLayer
}
import ui_scene.placement { SurfacePlacement }
import window.canvas_layers as canvas_layers
import webgpu.shared_texture { FENCE_PENDING, FENCE_SIGNALED, FENCE_UNKNOWN }
import silk.geometry.rect { Rect }
import silk.testing.testing { AssertionError, Testing }

fn placed(surface: u32) -> SurfacePlacement {
  return SurfacePlacement {
    surface: surface,
    bounds: Rect<f32>.new(100.0, 50.0, 500.0, 250.0),
    clip: Rect<f32>.new(100.0, 50.0, 500.0, 250.0),
    cornerRadius: 0.0,
    opacity: 1.0,
    order: 4,
    group: 0,
    layer: 0,
    axisAligned: true,
    occluded: false,
  }
}

test effect fn aCanvasShowsInALayerOnlyWhenItCan() -> ()
  ! AssertionError<'static> {
  let one = [placed(7)]
  let allowed = canvas_layers.supported()
  run Testing.expect(wantsLayer(&one, 7, true, allowed) == allowed, "an uncovered shared canvas, where layers exist")
  run Testing.expect(!wantsLayer(&one, 7, true, false), "not when layers are not allowed")
  run Testing.expect(!wantsLayer(&one, 7, false, true), "not when its frames are pixels")
  run Testing.expect(!wantsLayer(&one, 8, true, true), "not for a surface the scene does not draw")
  let twice = [placed(7), placed(7)]
  run Testing.expect(spritesOf(&twice, 7) == 2, "two sprites of one surface")
  run Testing.expect(!wantsLayer(&twice, 7, true, true), "not when the scene draws it twice")
  let mut covered = placed(7)
  covered.occluded = true
  run Testing.expect(!wantsLayer(&[covered], 7, true, true), "not when something drawn later covers it")
  let mut scrolled = placed(7)
  scrolled.group = 3
  run Testing.expect(!wantsLayer(&[scrolled], 7, true, true), "not inside a scroll group")
  let mut isolated = placed(7)
  isolated.layer = 1
  run Testing.expect(!wantsLayer(&[isolated], 7, true, true), "not inside an isolated layer")
  let mut turned = placed(7)
  turned.axisAligned = false
  run Testing.expect(!wantsLayer(&[turned], 7, true, true), "not turned")
  let mut uneven = placed(7)
  uneven.cornerRadius = -1.0
  run Testing.expect(!wantsLayer(&[uneven], 7, true, true), "not with a clip of uneven corners")
}

test effect fn layersAreOptInAndOffForCheckAndInspector() -> ()
  ! AssertionError<'static> {
  let here = canvas_layers.supported()
  run Testing.expect(!layersAllowed(false, false, false), "off unless asked for")
  run Testing.expect(layersAllowed(false, false, true) == here, "on when asked for, where layers exist")
  run Testing.expect(!layersAllowed(true, false, true), "off in check mode")
  run Testing.expect(!layersAllowed(false, true, true), "off for a window serving the inspector")
  run Testing.expect(switchedOn(b"on") && switchedOn(b"1") && switchedOn(b"yes"), "SILK_UI_CANVAS_LAYERS=on, 1 or yes")
  run Testing.expect(!switchedOn(b"off") && !switchedOn(b""), "anything else leaves them off")
}

test effect fn aLayerTakesItsCanvasPlace() -> ()
  ! AssertionError<'static> {
  let mut p = placed(7)
  p.clip = Rect<f32>.new(120.0, 50.0, 480.0, 250.0)
  p.cornerRadius = 12.0
  p.opacity = 0.75
  let state = layerStateOf(&p)
  run Testing.expect(state.x == 100.0 && state.y == 50.0 && state.width == 400.0 && state.height == 200.0, "the canvas's bounds")
  run Testing.expect(state.clipX == 120.0 && state.clipWidth == 360.0 && state.clipHeight == 200.0, "its clip")
  run Testing.expect(state.cornerRadius == 12.0 && state.opacity == 0.75, "its corner radius and opacity")
  run Testing.expect(state.scale == 0.0, "at the window layer's own scale")
  run Testing.expect(state.hidden == 0 && state.masks == 1, "shown, masked to the clip")
}

test effect fn aPictureShowsOnlyOnceItsFencesSignaled() -> ()
  ! AssertionError<'static> {
  run Testing.expect(pictureReady(&[]), "no fences: ready")
  run Testing.expect(pictureReady(&[FENCE_SIGNALED, FENCE_SIGNALED]), "all signaled")
  run Testing.expect(!pictureReady(&[FENCE_SIGNALED, FENCE_PENDING]), "one pending")
  run Testing.expect(!pictureReady(&[FENCE_UNKNOWN]), "a fence that cannot be asked")
}

test effect fn pathsChangeWhenTheDecisionDoes() -> ()
  ! AssertionError<'static> {
  run Testing.expect(pathChange(false, true) == PATH_TO_LAYER, "into a layer")
  run Testing.expect(pathChange(true, false) == PATH_TO_WINDOW, "back into the window")
  run Testing.expect(pathChange(true, true) == PATH_KEEP && pathChange(false, false) == PATH_KEEP, "kept")
  run Testing.expect(!canvasWakeDrawsWindow(false), "a layered canvas's frame draws no window")
  run Testing.expect(canvasWakeDrawsWindow(true), "a window canvas's frame does")
}

test effect fn waitingLayersAreLookedAtOnlyWhenItMatters() -> ()
  ! AssertionError<'static> {
  run Testing.expect(layerPollDelay(false, false) == 0, "nothing waits: no polling")
  run Testing.expect(layerPollDelay(true, false) == 1000000, "a picture waits for its fences: a millisecond")
  run Testing.expect(layerPollDelay(true, true) == 1000000, "and that wins over replaced pictures")
  run Testing.expect(layerPollDelay(false, true) == 8000000, "only replaced pictures in use: 8 ms")
}
