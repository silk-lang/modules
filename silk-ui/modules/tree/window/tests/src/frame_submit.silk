//! Frames that change nothing on screen are not drawn again: the host does not hand the
//! renderer a frame that kept the tree's last scene (`host.submitsFrame`), and the render
//! thread draws a canvas frame on its own only while the UI thread makes no frame of its own
//! (`render_thread.redrawsAlone`), so a `requestAnimationFrame` callback that draws a canvas
//! has the window drawn once, not twice.
import ui_tree_window.host { FrameSubmit, submitsFrame }
import ui_tree_window.render_thread { redrawsAlone, Motion, adoptMoves, placeMoves }
import ui_tree.node { Move, MOVE_LINK }
import ui_scene.scroll { ScrollPosition }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.num.usize
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }

fn kept() -> FrameSubmit {
  return FrameSubmit {
    check: false,
    inspector: false,
    layered: false,
    submitted: 3,
    kept: true,
    uploads: 0,
    width: 800,
    height: 600,
    lastWidth: 800,
    lastHeight: 600,
  }
}

test effect fn aFrameThatKeptItsSceneIsNotSubmitted() -> ()
  ! AssertionError<'static> {
  run Testing.expect(!submitsFrame(kept()), "a kept frame of the same size goes nowhere")
  let mut frame = kept()
  frame.kept = false
  run Testing.expect(submitsFrame(frame), "a frame that painted is submitted")
  frame = kept()
  frame.submitted = 0
  run Testing.expect(submitsFrame(frame), "the first frame is submitted")
  frame = kept()
  frame.uploads = 2
  run Testing.expect(submitsFrame(frame), "a frame with atlas pixels is submitted")
  frame = kept()
  frame.width = 801
  run Testing.expect(submitsFrame(frame), "a frame of another width is submitted")
  frame = kept()
  frame.lastHeight = 0
  run Testing.expect(submitsFrame(frame), "a frame of another height is submitted")
  frame = kept()
  frame.check = true
  run Testing.expect(submitsFrame(frame), "check mode submits every frame")
  frame = kept()
  frame.inspector = true
  run Testing.expect(submitsFrame(frame), "a window serving the inspector submits every frame")
  frame = kept()
  frame.layered = true
  run Testing.expect(submitsFrame(frame), "a frame under a dock or an overlay is submitted")
}

test effect fn aCanvasFrameWaitsForTheUiFrameBeingMade() -> ()
  ! AssertionError<'static> {
  run Testing.expect(redrawsAlone(false, true, false), "a canvas frame draws the window when no UI frame is being made")
  run Testing.expect(!redrawsAlone(false, true, true), "a canvas frame waits for the UI frame being made")
  run Testing.expect(redrawsAlone(true, false, true), "a compositor scroll draws at once")
  run Testing.expect(redrawsAlone(true, true, true), "and takes the canvas frame with it")
  run Testing.expect(!redrawsAlone(false, false, false), "nothing to draw")
}

fn slide(began: f64, elapsed: f64) -> Move {
  let mut curve: [f32; 17] = [0.0; 17]
  let mut i: usize = 0
  while i < 17 {
    curve[i] = usize.toF32(i) / 16.0
    i = i + 1
  }
  return Move {
    node: MOVE_LINK + 7,
    slot: 3,
    fromX: 400.0,
    fromY: 0.0,
    toX: 0.0,
    toY: 0.0,
    began: began,
    elapsed: elapsed,
    duration: 1.0,
    curve: curve,
  }
}

fn close(a: f32, b: f32) -> bool {
  return a - b < 0.01 && b - a < 0.01
}

effect fn movesBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut motions = List<Motion>.make()
  let mut positions = List<ScrollPosition>.make()

  // A frame painted a quarter of the way in, handed over at 100 s on the render clock.
  run adoptMoves(&mut motions, &[slide(10.0, 0.25)], 100.0)
  let fresh = run placeMoves(&motions, 100.0, &mut positions)
  run Testing.expect(
    fresh && positions.length() == 1 && positions.get(0).node == MOVE_LINK + 7 && close(positions.get(0).x, 300.0),
    "a frame handed over is drawn where its transition is",
  )

  // No new frame: the same one drawn later is further along, to the end and no further.
  positions.clear()
  let later = run placeMoves(&motions, 100.5, &mut positions)
  run Testing.expect(later && close(positions.get(0).x, 100.0), "drawn again alone, the move went on")
  positions.clear()
  let done = run placeMoves(&motions, 101.0, &mut positions)
  run Testing.expect(!done && close(positions.get(0).x, 0.0), "it ends where the transition ends")

  // The next frame of the same transition arrives a little late: painting took 8 ms. The
  // move keeps its start, so it does not jump back.
  run adoptMoves(&mut motions, &[slide(10.0, 0.5)], 100.258)
  positions.clear()
  drop run placeMoves(&motions, 100.258, &mut positions)
  run Testing.expect(close(positions.get(0).x, 400.0 - 400.0 * 0.508), "a known move keeps its clock")

  // The UI thread was held for longer than the move takes, and then hands over a frame it
  // painted for a time near the start: the move stays at its end.
  run adoptMoves(&mut motions, &[slide(10.0, 0.3)], 102.0)
  positions.clear()
  let held = run placeMoves(&motions, 102.0, &mut positions)
  run Testing.expect(!held && close(positions.get(0).x, 0.0), "a late frame does not send the move back")

  // Another transition of the same node, in its delay: it waits at its start.
  run adoptMoves(&mut motions, &[slide(50.0, -0.2)], 200.0)
  positions.clear()
  let waiting = run placeMoves(&motions, 200.1, &mut positions)
  run Testing.expect(waiting && close(positions.get(0).x, 400.0), "a move waits out its delay at the start")

  // A frame with no moves ends them.
  run adoptMoves(&mut motions, &[], 300.0)
  positions.clear()
  let none = run placeMoves(&motions, 300.0, &mut positions)
  run Testing.expect(!none && positions.length() == 0, "a frame without moves leaves nothing to run")
}

test effect fn theRenderThreadRunsMovesByItsClock() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run movesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
