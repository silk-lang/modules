//! What a canvas shows, kept once and shared: a [`Drawing`] of canvas commands or a [`Bitmap`]
//! of pixels.
//!
//! Make one when what it shows changes and keep it in the model. A view that shows it with
//! `h.drawing` or `h.bitmap` (`ui.drawing`, `ui.bitmap`) passes the handle along without
//! copying, and the view diff knows it unchanged by the handle alone: a canvas of 20,000
//! commands costs a render no more than one of ten.
import ui_protocol.mutation { CanvasCommand }
import silk.collections.list { List }
import silk.concurrency.sync { Arc }
import silk.mem.pointer { Pointer }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u8

/// Canvas commands that never change, shared by every handle to them.
pub struct Drawing {
  list: Arc<List<CanvasCommand>>,
}

impl Drawing {
  /// A drawing of `commands`, in CSS pixels from the canvas's content box corner.
  pub effect fn make(commands: List<CanvasCommand>) -> Drawing ! OutOfMemoryError ? &mut Allocator {
    return Drawing { list: run Arc<List<CanvasCommand>>.make(move commands) }
  }

  /// A drawing of a copy of `commands`.
  pub effect fn copy(commands: &[CanvasCommand]) -> Drawing ! OutOfMemoryError ? &mut Allocator {
    let mut list = List<CanvasCommand>.make()
    run list.appendSlice(commands)
    return run Drawing.make(move list)
  }

  pub fn commands(self: &Self) -> &[CanvasCommand] {
    return self.list.get().asSlice()
  }

  /// Another handle to the same commands.
  pub fn clone(self: &Self) -> Drawing {
    return Drawing { list: self.list.clone() }
  }

  /// Whether both are handles to the same commands (not only equal ones).
  pub fn same(self: &Self, other: &Drawing) -> bool {
    return Pointer.address<List<CanvasCommand>>(Pointer.fromRef(self.list.get())) == Pointer.address<List<CanvasCommand>>(Pointer.fromRef(other.list.get()))
  }
}

struct Pixels {
  width: u32,
  height: u32,
  opaque: bool,
  bytes: List<u8>,
}

/// Pixels that never change, shared by every handle to them: `width` by `height` straight
/// (not premultiplied) RGBA8 rows from the top, without padding, as in the web's `ImageData`.
pub struct Bitmap {
  pixels: Arc<Pixels>,
}

impl Bitmap {
  /// A bitmap of `bytes`. `opaque` says every alpha is 255. Bytes past `width` by `height`
  /// pixels are not shown; missing ones are transparent.
  pub effect fn make(width: u32, height: u32, bytes: List<u8>, opaque: bool) -> Bitmap ! OutOfMemoryError ? &mut Allocator {
    return Bitmap { pixels: run Arc<Pixels>.make(Pixels { width: width, height: height, opaque: opaque, bytes: move bytes }) }
  }

  pub fn width(self: &Self) -> u32 {
    return self.pixels.get().width
  }

  pub fn height(self: &Self) -> u32 {
    return self.pixels.get().height
  }

  pub fn opaque(self: &Self) -> bool {
    return self.pixels.get().opaque
  }

  pub fn bytes(self: &Self) -> &[u8] {
    return self.pixels.get().bytes.asSlice()
  }

  /// Another handle to the same pixels.
  pub fn clone(self: &Self) -> Bitmap {
    return Bitmap { pixels: self.pixels.clone() }
  }

  /// Whether both are handles to the same pixels (not only equal ones).
  pub fn same(self: &Self, other: &Bitmap) -> bool {
    return Pointer.address<Pixels>(Pointer.fromRef(self.pixels.get())) == Pointer.address<Pixels>(Pointer.fromRef(other.pixels.get()))
  }
}

/// What a canvas node of a render shows: commands, or pixels.
pub union CanvasContent {
  Commands { pub drawing: Drawing },
  Pixels { pub bitmap: Bitmap },
}

impl CanvasContent {
  pub fn clone(self: &Self) -> CanvasContent {
    return match &self.* {
      CanvasContent.Commands { drawing } => CanvasContent.Commands { drawing: drawing.clone() }
      CanvasContent.Pixels { bitmap } => CanvasContent.Pixels { bitmap: bitmap.clone() }
    }
  }

  /// The commands it draws: none for pixels.
  pub fn commands(self: &Self) -> &[CanvasCommand] {
    return match &self.* {
      CanvasContent.Commands { drawing } => drawing.commands()
      CanvasContent.Pixels { .. } => &[]
    }
  }
}
