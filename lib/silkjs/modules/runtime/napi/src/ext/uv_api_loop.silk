//! libuv 1.51's C API for loops and handles, exported for Node-API addons: loops (the default loop,
//! `uv_loop_*`, `uv_run`), the handle and request accessors, `uv_close`, `uv_ref` and friends,
//! `uv_walk` and `uv_print_*_handles`, timers, idle, prepare and check handles, async handles,
//! polls, signals, processes, fs events and fs polls. Each function does what libuv's does, on the
//! runtime's loop (ext.uv_loop), and keeps libuv's public fields of the addon's records current
//! (ext.uv_api_abi has the record conventions). A loop record is the runtime's loop itself, which
//! fits in libuv's `uv_loop_t`.
//!
//! The runtime's own loop is what `napi_get_uv_event_loop` hands out. `uv_default_loop` is a
//! separate loop that nothing runs unless the addon does, as it was when the runtime linked libuv.
import silk.mem.pointer { Pointer }
import silk.concurrency.atomic { Atomic, MemoryOrder, CompareExchange }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import ext.uv_loop as uvl
import ext.uv_api_abi as abi
import ext.uv_api_stream as stream
import silkjsruntime.ext.uv_fs { UvStat }
import ext.uv_shapes { Options, Stdio }

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
@foreign(noCapture: .("text"))
unsafe extern "C" fn strlen(text: *const u8) -> usize
@foreign(noCapture: .("dest", "source"))
unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, count: usize) -> *mut u8
unsafe extern "C" fn fprintf(stream: *mut u8, format: *const u8, ...) -> i32
@foreign(noCapture: .("name"))
unsafe extern "C" fn dlsym(handle: ?*mut u8, name: *const u8) -> ?*mut u8
unsafe extern "C" fn fcntl(fd: i32, command: i32, ...) -> i32
@foreign(noCapture: .("buffer"))
unsafe extern "C" fn fstat(fd: i32, buffer: *mut u8) -> i32
unsafe extern "C" fn close(fd: i32) -> i32
unsafe extern "C" fn socketpair(domain: i32, kind: i32, protocol: i32, fds: *mut i32) -> i32
static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn __error() -> *mut i32
  unsafe fn errno() -> i32 { return unsafe Pointer.read<i32>(unsafe __error()) }
  // libuv's sizeof(uv_loop_t) and the handle and request sizes on Darwin arm64.
  const LOOP_BYTES: usize = 1072
  const STDERR_NAME: &[u8] = b"__stderrp\0"
  const DEFAULT_HANDLE: usize = 18446744073709551614
  const O_NONBLOCK: i32 = 4
  const F_GETPATH: i32 = 50
  const ENOBUFS: i32 = 55
  const FIONBIO: u64 = 2147772030
} else {
  unsafe extern "C" fn __errno_location() -> *mut i32
  unsafe fn errno() -> i32 { return unsafe Pointer.read<i32>(unsafe __errno_location()) }
  const LOOP_BYTES: usize = 848
  const STDERR_NAME: &[u8] = b"stderr\0"
  const DEFAULT_HANDLE: usize = 0
  const O_NONBLOCK: i32 = 2048
  const ENOBUFS: i32 = 105
  const FIONBIO: u64 = 21537
}
unsafe extern "C" fn ioctl(fd: i32, request: u64, ...) -> i32
const ENOTTY: i32 = 25
// libuv's uv__nonblock: ioctl(FIONBIO), and fcntl where ioctl does not apply (ENOTTY).
unsafe fn setNonblocking(fd: i32) -> i32 {
  let mut on: i32 = 1
  if unsafe ioctl(fd, FIONBIO, Pointer.fromMutRef<i32>(&mut on)) == 0 { return 0 }
  let code = unsafe errno()
  if code != ENOTTY { return -code }
  let flags = unsafe fcntl(fd, F_GETFL)
  if flags < 0 { return -(unsafe errno()) }
  if (flags & O_NONBLOCK) != 0 { return 0 }
  if unsafe fcntl(fd, F_SETFL, flags | O_NONBLOCK) != 0 { return -(unsafe errno()) }
  return 0
}
const F_GETFL: i32 = 3
const F_SETFL: i32 = 4

type Callback = extern "C" fn(*mut u8) -> ()
type Given = ?extern "C" fn(*mut u8) -> ()

unsafe fn nn(pointer: ?*mut u8) -> *mut u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer) }
unsafe fn at(base: *mut u8, offset: usize) -> *mut u8 { return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), offset) }
unsafe fn readWord(base: *const u8, offset: usize) -> usize {
  return unsafe Pointer.read<usize>(unsafe Intrinsic.pointerReinterpret<*const u8, *const usize>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(base), offset)))
}
unsafe fn writeWord(base: *mut u8, offset: usize, value: usize) -> () {
  unsafe Pointer.write<usize>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut usize>(unsafe at(base, offset)), value)
}
unsafe fn writeInt(base: *mut u8, offset: usize, value: i32) -> () {
  unsafe Pointer.write<i32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut i32>(unsafe at(base, offset)), value)
}
unsafe fn readInt(base: *const u8, offset: usize) -> i32 {
  return unsafe Pointer.read<i32>(unsafe Intrinsic.pointerReinterpret<*const u8, *const i32>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(base), offset)))
}
unsafe fn addressPointer(address: usize) -> ?*mut u8 {
  return unsafe Pointer.read<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*const usize, *const ?*mut u8>(Pointer.fromRef<usize>(&address)))
}
unsafe fn kindOf(outer: *const u8) -> i32 { return unsafe readInt(outer, 16) }
fn isStream(kind: i32) -> bool { return kind == abi.UV_TCP || kind == abi.UV_NAMED_PIPE || kind == abi.UV_TTY || kind == abi.UV_UDP }
// The callback word every handle type keeps at offset 96 (timer_cb, async_cb, poll_cb, signal_cb,
// exit_cb, and the private idle_cb, prepare_cb and check_cb of libuv's records).
const CALLBACK_OFFSET: usize = 96

// ---- Loops ------------------------------------------------------------------------------------
pub export "C" fn loopSize() -> usize as "uv_loop_size" { return LOOP_BYTES }
pub unsafe export "C" fn loopInit(loop: *mut u8) -> i32 as "uv_loop_init" { return unsafe uvl.uv_loop_init(loop) }
fn defaultWord() -> *mut u64 { return Intrinsic.processWord() }
/// libuv's uv_default_loop: one loop per process, made on first use (null when that fails).
pub export "C" fn defaultLoop() -> ?*mut u8 as "uv_default_loop" {
  let word = defaultWord()
  let current = unsafe Atomic.load<u64>(word, MemoryOrder.Acquire)
  if current != 0 { return unsafe addressPointer(u64.toUsize(current)) }
  let memory = unsafe calloc(1, LOOP_BYTES)
  if Pointer.isNull<u8>(memory) { return memory }
  if unsafe uvl.uv_loop_init(unsafe nn(memory)) != 0 { unsafe free(memory) return Pointer.null<u8>() }
  let raced = unsafe Atomic.compareExchange<u64>(word, 0, usize.toU64(Pointer.address<u8>(memory)), MemoryOrder.AcquireRelease, MemoryOrder.Acquire)
  match move raced {
    CompareExchange<u64>.Exchanged => { return memory }
    CompareExchange<u64>.Observed { value } => {
      let _closed = unsafe uvl.uv_loop_close(unsafe nn(memory)) unsafe free(memory)
      return unsafe addressPointer(u64.toUsize(value))
    }
  }
}
unsafe fn isDefault(loop: *const u8) -> bool { return unsafe Atomic.load<u64>(defaultWord(), MemoryOrder.Acquire) == usize.toU64(Pointer.address<u8>(loop)) }
pub export "C" fn loopNew() -> ?*mut u8 as "uv_loop_new" {
  let memory = unsafe calloc(1, LOOP_BYTES)
  if Pointer.isNull<u8>(memory) { return memory }
  if unsafe uvl.uv_loop_init(unsafe nn(memory)) != 0 { unsafe free(memory) return Pointer.null<u8>() }
  return memory
}
/// libuv's uv_loop_close: UV_EBUSY while a handle or request is active; closing the default loop
/// forgets it, so the next uv_default_loop makes a new one.
pub unsafe export "C" fn loopClose(loop: *mut u8) -> i32 as "uv_loop_close" {
  let status = unsafe uvl.uv_loop_close(loop)
  if status != 0 { return status }
  if unsafe isDefault(loop) { unsafe Atomic.store<u64>(defaultWord(), 0, MemoryOrder.Release) }
  return 0
}
pub unsafe export "C" fn loopDelete(loop: *mut u8) -> () as "uv_loop_delete" {
  let wasDefault = unsafe isDefault(loop)
  let _status = unsafe loopClose(loop)
  if !wasDefault { unsafe free(loop) }
}
pub unsafe export "C" fn loopAlive(loop: *const u8) -> i32 as "uv_loop_alive" { return unsafe uvl.uv_loop_alive(loop) }
/// libuv's `int uv_loop_configure(uv_loop_t*, uv_loop_option, ...)`. Silk has no variadic exports
/// (a compiler wall, LIBUV_REPLACEMENT_NOTES.md), so the variadic argument is reached through the
/// calling convention instead:
/// - x86-64 (System V) and GNU arm64 pass a variadic int where the third fixed parameter goes, in
///   a register: the export takes it as `argument`.
/// - Darwin arm64 passes every variadic argument on the stack, the first at the caller's stack
///   pointer, which is where a function's ninth integer parameter is read from; the eight
///   registers before it carry nothing it uses. The export there takes six unused parameters and
///   the argument ninth. It is read only for UV_LOOP_BLOCK_SIGNAL, the one option that has one, so
///   a call without it never reads the slot.
static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" {
  pub unsafe export "C" fn loopConfigure(loop: *mut u8, option: i32, x2: usize, x3: usize, x4: usize, x5: usize, x6: usize, x7: usize, stacked: i32) -> i32 as "uv_loop_configure" {
    // UV_LOOP_BLOCK_SIGNAL is option 0.
    if option != 0 { return unsafe uvl.uv_loop_configure(loop, option, 0) }
    return unsafe uvl.uv_loop_configure(loop, option, stacked)
  }
} else {
  pub unsafe export "C" fn loopConfigure(loop: *mut u8, option: i32, argument: i32) -> i32 as "uv_loop_configure" {
    return unsafe uvl.uv_loop_configure(loop, option, argument)
  }
}
pub unsafe export "C" fn loopFork(loop: *mut u8) -> i32 as "uv_loop_fork" { return unsafe uvl.uv_loop_fork(loop) }
pub unsafe export "C" fn loopGetData(loop: *const u8) -> ?*mut u8 as "uv_loop_get_data" { return unsafe uvl.uv_loop_get_data(loop) }
pub unsafe export "C" fn loopSetData(loop: *mut u8, data: ?*mut u8) -> () as "uv_loop_set_data" { unsafe uvl.uv_loop_set_data(loop, data) }
pub unsafe export "C" fn runLoop(loop: *mut u8, mode: i32) -> i32 as "uv_run" { return unsafe uvl.uv_run(loop, mode) }
pub unsafe export "C" fn stop(loop: *mut u8) -> () as "uv_stop" { unsafe uvl.uv_stop(loop) }
pub unsafe export "C" fn now(loop: *const u8) -> u64 as "uv_now" { return unsafe uvl.uv_now(loop) }
pub unsafe export "C" fn updateTime(loop: *mut u8) -> () as "uv_update_time" { unsafe uvl.uv_update_time(loop) }
pub unsafe export "C" fn backendFd(loop: *const u8) -> i32 as "uv_backend_fd" { return unsafe uvl.uv_backend_fd(loop) }
pub unsafe export "C" fn backendTimeout(loop: *const u8) -> i32 as "uv_backend_timeout" { return unsafe uvl.uv_backend_timeout(loop) }
pub unsafe export "C" fn metricsIdleTime(loop: *mut u8) -> u64 as "uv_metrics_idle_time" { return unsafe uvl.uv_metrics_idle_time(loop) }
/// libuv's uv_metrics_t: loop_count, events, events_waiting, and 13 reserved words, zeroed.
pub unsafe export "C" fn metricsInfo(loop: *mut u8, metrics: *mut u64) -> i32 as "uv_metrics_info" {
  let mut count: u64 = 0 let mut events: u64 = 0 let mut waiting: u64 = 0
  unsafe uvl.metrics(loop, &mut count, &mut events, &mut waiting)
  let slots = unsafe Pointer.assumeManyMut<u64>(metrics)
  unsafe Pointer.write<u64>(unsafe Pointer.atMut<u64>(slots, 0), count)
  unsafe Pointer.write<u64>(unsafe Pointer.atMut<u64>(slots, 1), events)
  unsafe Pointer.write<u64>(unsafe Pointer.atMut<u64>(slots, 2), waiting)
  let mut index: usize = 3
  while index < 16 { unsafe Pointer.write<u64>(unsafe Pointer.atMut<u64>(slots, index), 0) index = index + 1 }
  return 0
}

// ---- Walk and print ---------------------------------------------------------------------------
@deferredCallbacks("callback")
pub unsafe export "C" fn walk(loop: *mut u8, callback: ?extern "C" fn(*mut u8, ?*mut u8) -> (), argument: ?*mut u8) -> () as "uv_walk" {
  if Intrinsic.pointerIsNull<?extern "C" fn(*mut u8, ?*mut u8) -> ()>(callback) { return }
  // The loop calls back with its records; the trampoline hands the addon's callback each handle.
  let mut job = WalkJob { callback: unsafe Intrinsic.pointerRequalify<?extern "C" fn(*mut u8, ?*mut u8) -> (), extern "C" fn(*mut u8, ?*mut u8) -> ()>(callback), argument: argument }
  unsafe uvl.uv_walk(loop, silkUvApiWalk, unsafe Intrinsic.pointerReinterpret<*mut WalkJob, *mut u8>(Pointer.fromMutRef<WalkJob>(&mut job)))
}
struct WalkJob { callback: extern "C" fn(*mut u8, ?*mut u8) -> (), argument: ?*mut u8 }
export "C" fn silkUvApiWalk(handle: *mut u8, raw: *mut u8) -> () {
  let anchor = () let job = unsafe Pointer.borrow<(), WalkJob>(&anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut WalkJob>(raw))
  let callback = job.callback let argument = job.argument drop job
  unsafe callback(handle, argument)
}
struct PrintJob { stream: *mut u8, onlyActive: bool }
export "C" fn silkUvApiPrint(handle: *mut u8, raw: *mut u8) -> () {
  let anchor = () let job = unsafe Pointer.borrow<(), PrintJob>(&anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut PrintJob>(raw))
  let active = unsafe uvl.uv_is_active(handle) != 0
  if job.onlyActive && !active { return }
  let record: *mut u8 = if unsafe uvl.isAddon(handle) { unsafe abi.outerOf(handle) } else { handle }
  let kind = unsafe kindOf(record)
  let name = unsafe typeName(kind)
  let unknown = b"<unknown>\0"
  let shown: *const u8 = if Pointer.isNull<u8>(name) { Pointer.fromRef<u8>(&unknown[0]) } else { unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(name) }
  let format = b"[%c%c%c] %-8s %p\n\0"
  let referenced: i32 = if unsafe uvl.uv_has_ref(handle) != 0 { 82 } else { 45 }
  let activity: i32 = if active { 65 } else { 45 }
  let internal: i32 = if unsafe uvl.isInternal(handle) { 73 } else { 45 }
  let _printed = unsafe fprintf(job.stream, Pointer.fromRef<u8>(&format[0]), referenced, activity, internal, shown, record)
}
unsafe fn printHandles(loop: ?*mut u8, stream: ?*mut u8, onlyActive: bool) -> () {
  let target = if Pointer.isNull<u8>(loop) { unsafe defaultLoop() } else { loop }
  if Pointer.isNull<u8>(target) { return }
  let mut output = stream
  if Pointer.isNull<u8>(output) {
    let variable = unsafe dlsym(unsafe addressPointer(DEFAULT_HANDLE), Pointer.fromRef<u8>(&STDERR_NAME[0]))
    if Pointer.isNull<u8>(variable) { return }
    output = unsafe Pointer.read<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(unsafe nn(variable)))
  }
  let mut job = PrintJob { stream: unsafe nn(output), onlyActive: onlyActive }
  unsafe uvl.walkAll(unsafe nn(target), silkUvApiPrint, unsafe Intrinsic.pointerReinterpret<*mut PrintJob, *mut u8>(Pointer.fromMutRef<PrintJob>(&mut job)))
}
pub unsafe export "C" fn printAllHandles(loop: ?*mut u8, stream: ?*mut u8) -> () as "uv_print_all_handles" { unsafe printHandles(loop, stream, false) }
pub unsafe export "C" fn printActiveHandles(loop: ?*mut u8, stream: ?*mut u8) -> () as "uv_print_active_handles" { unsafe printHandles(loop, stream, true) }

// ---- Handles ----------------------------------------------------------------------------------
// libuv's sizes of each handle and request type (uv_handle_size, uv_req_size), from its headers.
static if Intrinsic.targetOperatingSystem() == "darwin" {
  const HANDLE_SIZES: [usize; 18] = [0, 128, 120, 304, 104, 96, 120, 280, 168, 120, 136, 264, 264, 152, 344, 224, 152, 0]
  const REQUEST_SIZES: [usize; 11] = [0, 64, 96, 192, 80, 320, 440, 128, 160, 1320, 144]
} else {
  const HANDLE_SIZES: [usize; 18] = [0, 128, 120, 136, 104, 96, 120, 264, 160, 120, 136, 248, 248, 152, 312, 216, 152, 0]
  const REQUEST_SIZES: [usize; 11] = [0, 64, 96, 192, 80, 320, 440, 128, 160, 1320, 144]
}
pub export "C" fn handleSize(kind: i32) -> usize as "uv_handle_size" {
  if kind <= 0 || kind >= 17 { return 18446744073709551615 }
  return HANDLE_SIZES[i32.toUsize(kind)]
}
pub export "C" fn requestSize(kind: i32) -> usize as "uv_req_size" {
  if kind <= 0 || kind >= 11 { return 18446744073709551615 }
  return REQUEST_SIZES[i32.toUsize(kind)]
}
unsafe fn typeName(kind: i32) -> ?*const u8 {
  let names: [&[u8]; 18] = [b"\0", b"async\0", b"check\0", b"fs_event\0", b"fs_poll\0", b"handle\0", b"idle\0", b"pipe\0", b"poll\0", b"prepare\0", b"process\0", b"stream\0", b"tcp\0", b"timer\0", b"tty\0", b"udp\0", b"signal\0", b"file\0"]
  if kind <= 0 || kind >= 18 { return Pointer.null<u8>() }
  let name = names[i32.toUsize(kind)]
  return Pointer.fromRef<u8>(&name[0])
}
/// libuv's uv_handle_type_name: null for UV_UNKNOWN_HANDLE and out-of-range types.
pub unsafe export "C" fn handleTypeName(kind: i32) -> ?*const u8 as "uv_handle_type_name" { return unsafe typeName(kind) }
pub unsafe export "C" fn requestTypeName(kind: i32) -> ?*const u8 as "uv_req_type_name" {
  let names: [&[u8]; 11] = [b"\0", b"req\0", b"connect\0", b"write\0", b"shutdown\0", b"udp_send\0", b"fs\0", b"work\0", b"getaddrinfo\0", b"getnameinfo\0", b"random\0"]
  if kind <= 0 || kind >= 11 { return Pointer.null<u8>() }
  let name = names[i32.toUsize(kind)]
  return Pointer.fromRef<u8>(&name[0])
}
pub unsafe export "C" fn handleGetType(handle: *const u8) -> i32 as "uv_handle_get_type" { return unsafe kindOf(handle) }
pub unsafe export "C" fn handleGetData(handle: *const u8) -> ?*mut u8 as "uv_handle_get_data" { return unsafe addressPointer(unsafe readWord(handle, 0)) }
pub unsafe export "C" fn handleSetData(handle: *mut u8, data: ?*mut u8) -> () as "uv_handle_set_data" { unsafe writeWord(handle, 0, Pointer.address<u8>(data)) }
pub unsafe export "C" fn handleGetLoop(handle: *const u8) -> ?*mut u8 as "uv_handle_get_loop" { return unsafe addressPointer(unsafe readWord(handle, 8)) }
pub unsafe export "C" fn requestGetType(request: *const u8) -> i32 as "uv_req_get_type" { return unsafe readInt(request, 8) }
pub unsafe export "C" fn requestGetData(request: *const u8) -> ?*mut u8 as "uv_req_get_data" { return unsafe addressPointer(unsafe readWord(request, 0)) }
pub unsafe export "C" fn requestSetData(request: *mut u8, data: ?*mut u8) -> () as "uv_req_set_data" { unsafe writeWord(request, 0, Pointer.address<u8>(data)) }
pub unsafe export "C" fn isActive(handle: *const u8) -> i32 as "uv_is_active" { let live = unsafe abi.liveInner(handle) if Pointer.isNull<u8>(live) { return 0 } return unsafe uvl.uv_is_active(unsafe nn(live)) }
pub unsafe export "C" fn isClosing(handle: *const u8) -> i32 as "uv_is_closing" { let live = unsafe abi.liveInner(handle) if Pointer.isNull<u8>(live) { return (if (unsafe abi.recordFlags(handle) & (abi.RECORD_CLOSING | abi.RECORD_CLOSED)) != 0 { 1 } else { 0 }) } return unsafe uvl.uv_is_closing(unsafe nn(live)) }
pub unsafe export "C" fn reference(handle: *mut u8) -> () as "uv_ref" { let live = unsafe abi.liveInner(handle) if Pointer.isNull<u8>(live) { return } unsafe uvl.uv_ref(unsafe nn(live)) }
pub unsafe export "C" fn unreference(handle: *mut u8) -> () as "uv_unref" { let live = unsafe abi.liveInner(handle) if Pointer.isNull<u8>(live) { return } unsafe uvl.uv_unref(unsafe nn(live)) }
pub unsafe export "C" fn hasReference(handle: *const u8) -> i32 as "uv_has_ref" { let live = unsafe abi.liveInner(handle) if Pointer.isNull<u8>(live) { return 0 } return unsafe uvl.uv_has_ref(unsafe nn(live)) }
/// libuv's uv_fileno: the descriptor of a TCP, pipe, TTY, UDP or poll handle.
pub unsafe export "C" fn fileno(handle: *const u8, fd: *mut i32) -> i32 as "uv_fileno" {
  let kind = unsafe kindOf(handle)
  if !isStream(kind) && kind != abi.UV_POLL { return -22 }
  let live = unsafe abi.liveInner(handle)
  if Pointer.isNull<u8>(live) { return -9 }
  return unsafe uvl.uv_fileno(unsafe nn(live), fd)
}
/// libuv's uv_close: the type's closing steps now, and `callback(handle)` in the closing phase.
@deferredCallbacks("callback")
pub unsafe export "C" fn closeHandle(handle: *mut u8, callback: Given) -> () as "uv_close" {
  let live = unsafe abi.liveInner(handle)
  if Pointer.isNull<u8>(live) { return }
  let inner = unsafe nn(live)
  if unsafe uvl.uv_is_closing(inner) != 0 { return }
  let kind = unsafe kindOf(handle)
  if isStream(kind) { unsafe stream.streamClose(handle) }
  if kind == abi.UV_FS_EVENT { unsafe writeWord(handle, 96, 0) }
  if kind == abi.UV_SIGNAL { unsafe writeInt(handle, 104, 0) }
  unsafe abi.closeRecord(handle, callback)
}

// ---- Callback trampolines ---------------------------------------------------------------------
// The loop calls these with its inner handle; each finds the addon's record and its callback word.
unsafe fn callbackOf(outer: *const u8) -> Given { return unsafe Pointer.read<Given>(unsafe Intrinsic.pointerReinterpret<*const u8, *const Given>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(outer), CALLBACK_OFFSET))) }
unsafe fn setCallback(outer: *mut u8, callback: Given) -> () { unsafe Pointer.write<Given>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Given>(unsafe at(outer, CALLBACK_OFFSET)), callback) }
export "C" fn silkUvApiFired(inner: *mut u8) -> () {
  let outer = unsafe abi.outerOf(inner)
  let callback = unsafe callbackOf(outer)
  if Intrinsic.pointerIsNull<Given>(callback) { return }
  let present = unsafe Intrinsic.pointerRequalify<Given, Callback>(callback)
  unsafe present(outer)
}
export "C" fn silkUvApiTimer(inner: *mut u8) -> () {
  let outer = unsafe abi.outerOf(inner)
  unsafe mirrorTimer(outer)
  let callback = unsafe callbackOf(outer)
  if Intrinsic.pointerIsNull<Given>(callback) { return }
  let present = unsafe Intrinsic.pointerRequalify<Given, Callback>(callback)
  unsafe present(outer)
}
unsafe fn mirrorTimer(outer: *mut u8) -> () {
  let inner = unsafe abi.innerOf(outer)
  unsafe writeWord(outer, 136, u64.toUsize(unsafe uvl.uv_timer_get_repeat(inner)))
  let loop = unsafe uvl.handleLoop(inner)
  unsafe writeWord(outer, 128, u64.toUsize(u64.wrappingAdd(unsafe uvl.uv_now(loop), unsafe uvl.uv_timer_get_due_in(inner))))
}

// ---- Timers -----------------------------------------------------------------------------------
unsafe fn adopt(loop: *mut u8, outer: *mut u8, kind: i32) -> ?*mut u8 {
  let inner = unsafe abi.prepare(loop, outer, kind)
  if !Pointer.isNull<u8>(inner) { unsafe setCallback(outer, Intrinsic.pointerNullFunction<Given>()) }
  return inner
}
pub unsafe export "C" fn timerInit(loop: *mut u8, handle: *mut u8) -> i32 as "uv_timer_init" {
  let inner = unsafe adopt(loop, handle, abi.UV_TIMER)
  if Pointer.isNull<u8>(inner) { return -12 }
  let _status = unsafe uvl.uv_timer_init(loop, unsafe nn(inner))
  unsafe abi.bind(handle, unsafe nn(inner))
  unsafe writeWord(handle, 128, 0) unsafe writeWord(handle, 136, 0)
  return 0
}
@deferredCallbacks("callback")
pub unsafe export "C" fn timerStart(handle: *mut u8, callback: Given, timeout: u64, repeat: u64) -> i32 as "uv_timer_start" {
  let live = unsafe abi.liveInner(handle)
  if Pointer.isNull<u8>(live) { return -22 }
  let inner = unsafe nn(live)
  if Intrinsic.pointerIsNull<Given>(callback) || unsafe uvl.uv_is_closing(inner) != 0 { return -22 }
  unsafe setCallback(handle, callback)
  let status = unsafe uvl.timerStart(inner, silkUvApiTimer, timeout, repeat)
  unsafe mirrorTimer(handle)
  return status
}
