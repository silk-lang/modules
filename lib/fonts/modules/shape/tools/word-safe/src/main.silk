//! `font-shape-word-safe FONT...`: says of each font whether its space glyph is separable
//! (`spaceSeparable`), and otherwise every reason it takes part in the font's layout, with the
//! features that list each lookup and the lookups that nest it, then the printable ASCII
//! characters the default Latin and Common plans cannot shape word by word.
//!
//! `font-shape-word-safe --words CORPUS FONT...` checks those sets: every line of CORPUS
//! made only of word-safe characters and spaces, and every line with its unsafe characters
//! removed, must shape whole to the glyphs of its words and runs of spaces shaped alone.
import harfrust.lib {
  spaceGlyph,
  glyphLayoutUse,
  glyphLayoutUseAfter,
  LayoutUse,
  reasonText,
  lookupFeatureTags,
  lookupNestingLookups,
  wordSafeAsciiWith,
  Buffer,
  ShaperData,
  ConfiguredShaper,
  ShapePlan,
  Direction,
  Script,
  Glyph,
  shape,
  ShapeOptions,
  ShapeError
}
import silk.collections.list { List }
import read_fonts.lib { FontRef, ReadError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.i32
import silk.num.i64
import silk.num.u64
import silk.num.usize
import silk.num.u8
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.format { Format }
import silk.text.string { String, InvalidUtf8 }

/// The most reasons listed per font.
const MAX_REASONS: usize = 400

effect fn writeTag(tag: u32) -> ()
  ! WriterError
  ? &mut Writer {
  let mut out: [u8; 4] = [0, 0, 0, 0]
  out[0] = u32.toU8(u32.shiftRight(tag, 24) & 255)
  out[1] = u32.toU8(u32.shiftRight(tag, 16) & 255)
  out[2] = u32.toU8(u32.shiftRight(tag, 8) & 255)
  out[3] = u32.toU8(tag & 255)
  let mut i: usize = 0
  while i < 4 {
    if out[i] < 32 || out[i] > 126 {
      out[i] = 63
    }
    i = i + 1
  }
  let view: &[u8] = &out
  run Writer.writeString(String.fromUtf8(view) |> Result<string, InvalidUtf8>.unwrapOr("????"))
}

effect fn describe<'a>(font: &FontRef<'a>, use: LayoutUse) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  run Writer.writeString("  ")
  run writeTag(use.table)
  if use.lookup != 4294967295 {
    run Format.format(
      " lookup {lookup} type {kind} subtable {subtable} format {format}",
      &.{ lookup: use.lookup, kind: use.kind, subtable: use.subtable, format: use.format },
    )
  }
  run Format.format(": {reason}", &.{ reason: reasonText(use.reason) })
  if use.lookup != 4294967295 {
    let mut tags: [u32; 32] = [0; 32]
    let count = lookupFeatureTags(font, use.table, use.lookup, &mut tags)
    run Writer.writeString("; features [")
    let mut i: usize = 0
    while i < count && i < tags.length {
      if i > 0 {
        run Writer.writeString(" ")
      }
      run writeTag(tags[i])
      i = i + 1
    }
    run Writer.writeString("]")
    let mut nesting: [u32; 32] = [0; 32]
    let nested = lookupNestingLookups(font, use.table, use.lookup, &mut nesting)
    if nested > 0 {
      run Writer.writeString("; nested from lookups [")
      let mut k: usize = 0
      while k < nested && k < nesting.length {
        if k > 0 {
          run Writer.writeString(" ")
        }
        run Format.format("{n}", &.{ n: nesting[k] })
        k = k + 1
      }
      if nested > nesting.length {
        run Writer.writeString(" ...")
      }
      run Writer.writeString("]")
    }
  }
  run Writer.writeString("\n")
}

/// Prints the printable ASCII characters the default plan for `script` (None for Common, as
/// ui-text shapes it: no script, guessed from no text) cannot shape word by word.
effect fn unsafeAscii<'a>(data: &ShaperData<'a>, label: string, script: Option<Script>) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let mut buffer = Buffer.new()
  buffer.setDirection(Direction.LeftToRight)
  buffer.setScript(script)
  buffer.guessSegmentProperties()
  let shaper = ConfiguredShaper.new(data)
  let plan = run ShapePlan.new(&shaper, &buffer, &[])
  let safe = run wordSafeAsciiWith(data, &plan)
  run Format.format("  word-unsafe ASCII ({label}): ", &.{ label: label })
  let mut count: usize = 0
  let mut c: usize = 0x21
  while c <= 0x7e {
    if (safe[c / 64] & u64.shiftLeft(1, usize.toU64(c % 64))) == 0 {
      let bytes: [u8; 1] = [usize.toU8(c)]
      let view: &[u8] = &bytes
      run Writer.writeString(String.fromUtf8(view) |> Result<string, InvalidUtf8>.unwrapOr("?"))
      count = count + 1
    }
    c = c + 1
  }
  if count == 0 {
    run Writer.writeString("(none)")
  } else if count == 94 {
    run Writer.writeString(" (all)")
  }
  run Writer.writeString("\n")
}

/// Appends the glyph ids, advances and offsets of `text` shaped with `plan`.
effect fn shapeInto<'a>(
  data: &ShaperData<'a>,
  plan: &ShapePlan<'a>,
  script: Option<Script>,
  text: string,
  out: &mut List<i64>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let shaper = ConfiguredShaper.new(data)
  let mut buffer = Buffer.new()
  run Buffer.pushStr(&mut buffer, text)
  buffer.setDirection(Direction.LeftToRight)
  buffer.setScript(script)
  buffer.guessSegmentProperties()
  if let Result<(), ShapeError>.Failure { error: _ } = run shape(
    &shaper,
    &mut buffer,
    ShapeOptions.forPlan(plan, &[]),
  ) {
    run List<i64>.append(&mut out, -1)
    return
  }
  let glyphs = List<Glyph>.asSlice(&buffer.glyphs)
  let mut i: usize = 0
  while i < glyphs.length {
    run List<i64>.append(&mut out, u32.toI64(glyphs[i].info.glyphId))
    run List<i64>.append(&mut out, i32.toI64(glyphs[i].position.xAdvance))
    run List<i64>.append(&mut out, i32.toI64(glyphs[i].position.xOffset))
    run List<i64>.append(&mut out, i32.toI64(glyphs[i].position.yOffset))
    i = i + 1
  }
}

/// Whether `text` shapes whole to the glyphs of its words and runs of spaces shaped alone.
effect fn wordsAgree<'a>(
  data: &ShaperData<'a>,
  plan: &ShapePlan<'a>,
  script: Option<Script>,
  text: string,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut whole = List<i64>.make()
  run shapeInto(data, plan, script, text, &mut whole)
  let mut parts = List<i64>.make()
  let bytes = String.utf8Bytes(text)
  let mut start: usize = 0
  while start < bytes.length {
    let mut end = start + 1
    while end < bytes.length && (bytes[end] == 32) == (bytes[start] == 32) {
      end = end + 1
    }
    run shapeInto(data, plan, script, String.slice(text, start, end - start), &mut parts)
    start = end
  }
  if List<i64>.length(&whole) != List<i64>.length(&parts) {
    return false
  }
  let mut i: usize = 0
  while i < List<i64>.length(&whole) {
    if List<i64>.get(&whole, i) != List<i64>.get(&parts, i) {
      return false
    }
    i = i + 1
  }
  return true
}

/// Shapes every line of `corpus` whole and word by word with the default plan for `script`:
/// the lines made only of word-safe characters and spaces must agree. Also checks each line
/// with its unsafe characters removed, and counts the other lines that disagree. For Common,
/// letters count as unsafe.
effect fn checkWords<'a>(
  data: &ShaperData<'a>,
  label: string,
  script: Option<Script>,
  corpus: string,
) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let mut buffer = Buffer.new()
  buffer.setDirection(Direction.LeftToRight)
  buffer.setScript(script)
  buffer.guessSegmentProperties()
  let shaper = ConfiguredShaper.new(data)
  let plan = run ShapePlan.new(&shaper, &buffer, &[])
  let safe = run wordSafeAsciiWith(data, &plan)
  let mut safeLines: usize = 0
  let mut safeWrong: usize = 0
  let mut filtered: usize = 0
  let mut filteredWrong: usize = 0
  let mut otherLines: usize = 0
  let mut otherDiffer: usize = 0
  let latin = label == "Latn"
  let mut lines = String.split(corpus, "\n")
  while let Option<string>.Some { value: line } = lines.next() {
    if String.byteLength(line) == 0 {
      continue
    }
    let bytes = String.utf8Bytes(line)
    let mut kept = List<u8>.make()
    let mut allSafe = true
    let mut i: usize = 0
    while i < bytes.length {
      let c = u8.toUsize(bytes[i])

      // Common plans shape text without letters (ui-text itemizes ASCII with a letter as
      // Latin), and the shaper refuses a buffer whose guessed script is not the plan's.
      let letter = (c >= 0x41 && c <= 0x5a) || (c >= 0x61 && c <= 0x7a)
      let ok = c == 32
        || (c >= 0x21 && c <= 0x7e && (safe[c / 64] & u64.shiftLeft(1, usize.toU64(c % 64))) != 0
          && !(letter && !latin))
      if ok {
        run List<u8>.append(&mut kept, bytes[i])
      } else {
        allSafe = false
      }
      i = i + 1
    }
    if allSafe {
      safeLines = safeLines + 1
      if !run wordsAgree(data, &plan, script, line) {
        safeWrong = safeWrong + 1
        run Format.format("    WRONG safe line: {line}\n", &.{ line: line })
      }
    } else {
      otherLines = otherLines + 1
      if !run wordsAgree(data, &plan, script, line) {
        otherDiffer = otherDiffer + 1
      }
      if List<u8>.length(&kept) != 0 {
        let text = String.fromUtf8(List<u8>.asSlice(&kept))
          |> Result<string, InvalidUtf8>.unwrapOr("")
        filtered = filtered + 1
        if !run wordsAgree(data, &plan, script, text) {
          filteredWrong = filteredWrong + 1
          run Format.format("    WRONG filtered line: {line}\n", &.{ line: text })
        }
      }
    }
  }
  run Format.format(
    "  words check ({label}): safe lines {safeLines} wrong {safeWrong}; filtered lines {filtered} wrong {filteredWrong}; other lines {otherLines} of which differ {otherDiffer}\n",
    &.{
      label: label,
      safeLines: safeLines,
      safeWrong: safeWrong,
      filtered: filtered,
      filteredWrong: filteredWrong,
      otherLines: otherLines,
      otherDiffer: otherDiffer,
    },
  )
}

effect fn report(name: string, data: &[u8]) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let font = match move FontRef.new(data) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Format.format("{name}: unreadable font\n", &.{ name: name })
      return
    }
  }
  run involvement(name, &font)
  let shaping = ShaperData.new(&font)
  run unsafeAscii(&shaping, "Latn", Script.parse("Latn"))
  run unsafeAscii(&shaping, "Common", Option<Script>.None)
}

effect fn involvement<'a>(name: string, font: &FontRef<'a>) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let space = match move spaceGlyph(font) {
    Option<u32>.Some { value } => value
    _ => {
      run Format.format("{name}: no space glyph -> not separable\n", &.{ name: name })
      return
    }
  }
  let mut use = glyphLayoutUse(font, space)
  if !use.involved {
    run Format.format("{name}: space glyph {space} -> SEPARABLE\n", &.{ name: name, space: space })
    return
  }
  run Format.format("{name}: space glyph {space} -> involved\n", &.{ name: name, space: space })
  let mut count: usize = 0
  while use.involved && count < MAX_REASONS {
    run describe(font, use)
    use = glyphLayoutUseAfter(font, space, use)
    count = count + 1
  }
  if use.involved {
    run Writer.writeString("  ...\n")
  }
}

effect fn process() -> i32
  ! OutOfMemoryError | HostInputError | FileError | WriterError
  ? &mut Allocator | &mut HostInput | &mut FileSystem | &mut Writer {
  let count = run HostInput.argumentCount()
  if count < 2 {
    run Writer.writeString("Usage: font-shape-word-safe FONT...\n")
    return 2
  }
  let mut i: usize = 1
  let mut corpus = String.make()
  let mut checking = false
  if let Option<Bytes>.Some { value: raw } = run HostInput.argument(1) {
    let first = String.fromUtf8(Bytes.asSlice(&raw)) |> Result<string, InvalidUtf8>.unwrapOr("")
    checking = first == "--words"
  }
  if checking && count > 3 {
    if let Option<Bytes>.Some { value: raw } = run HostInput.argument(2) {
      if let Result<String, InvalidUtf8>.Success { value: name } = move String.fromBytes(move raw) {
        let path = run Path.fromBytes(String.utf8Bytes(String.view(&name)))
        let text = run FileSystem.readFile(&path)
        if let Result<String, InvalidUtf8>.Success { value } = move String.fromBytes(move text) {
          corpus = move value
        }
      }
    }
    i = 3
  }
  while i < count {
    if checking {
      if let Option<Bytes>.Some { value: raw } = run HostInput.argument(i) {
        if let Result<String, InvalidUtf8>.Success { value: name } = move String.fromBytes(
          move raw,
        ) {
          let path = run Path.fromBytes(String.utf8Bytes(String.view(&name)))
          let bytes = run FileSystem.readFile(&path)
          if let Result<FontRef, ReadError>.Success { value: font } = move FontRef.new(
            Bytes.asSlice(&bytes),
          ) {
            let shaping = ShaperData.new(&font)
            run Format.format("{name}\n", &.{ name: String.view(&name) })
            run checkWords(&shaping, "Latn", Script.parse("Latn"), String.view(&corpus))
            run checkWords(&shaping, "Common", Option<Script>.None, String.view(&corpus))
          }
        }
      }
      i = i + 1
      continue
    }
    if let Option<Bytes>.Some { value: raw } = run HostInput.argument(i) {
      if let Result<String, InvalidUtf8>.Success { value: name } = move String.fromBytes(move raw) {
        let path = run Path.fromBytes(String.utf8Bytes(String.view(&name)))
        let bytes = run FileSystem.readFile(&path)
        run report(String.view(&name), Bytes.asSlice(&bytes))
      }
    }
    i = i + 1
  }
  return 0
}

effect fn failed<E>(error: E) -> i32
  ! WriterError {
  drop error
  let mut writer = StderrWriter.make()
  run Writer.writeString("font-shape-word-safe: unable to process input\n")
    |> Effect.provideMut<Writer>(&mut writer)
  return 2
}

effect fn provided() -> i32
  ! OutOfMemoryError | HostInputError | FileError | WriterError
  ? &mut Allocator | &mut HostInput {
  let mut files = run MachineFileSystem.make()
  let mut writer = StdoutWriter.make()
  return run process()
    |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Writer>(&mut writer)
}

pub effect fn main() -> i32
  ! WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(provided(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
