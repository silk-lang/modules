        self.skipAt = self.cursor + 1
      }
      let add = self.shapes.add(self.cursor)
      if self.on && add != 0 && u64.wrappingToU32(u64.shiftRight(add, 32)) == self.fields.addKey {
        // The add the site's inline key names, in place (addInPlace); anything else takes
        // the general way below.
        let general = run self.a.label()
        let memo = u64.wrappingToU32(add) & (self.fields.memoEntries - 1)
        let atom = self.shapes.atom(self.cursor)
        run self.addInPlace(inst, memo, atom, general)
