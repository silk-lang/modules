    20 => b"EALREADY\0"
    21 => b"EBADF\0"
    22 => b"EBUSY\0"
    23 => b"ECANCELED\0"
    24 => b"ECHARSET\0"
    25 => b"ECONNABORTED\0"
    26 => b"ECONNREFUSED\0"
    27 => b"ECONNRESET\0"
    28 => b"EDESTADDRREQ\0"
    29 => b"EEXIST\0"
    30 => b"EFAULT\0"
    31 => b"EFBIG\0"
    32 => b"EHOSTUNREACH\0"
    33 => b"EINTR\0"
    34 => b"EINVAL\0"
    35 => b"EIO\0"
    36 => b"EISCONN\0"
    37 => b"EISDIR\0"
    38 => b"ELOOP\0"
    39 => b"EMFILE\0"
    40 => b"EMSGSIZE\0"
    41 => b"ENAMETOOLONG\0"
    42 => b"ENETDOWN\0"
    43 => b"ENETUNREACH\0"
