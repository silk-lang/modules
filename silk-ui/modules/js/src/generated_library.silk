rn ancestor\x0a        && descendant\x0a        && Boolean(documentPosition(ancestor, descendant) & DOM.DOCUMENT_POSITION_CONTAINED_BY);\x0a}\x0a\x0a/**\x0a * Returns true if ancestor is an ancestor of or equal to descendant, false\x0a * otherwise.\x0a */\x0afunction isAncestorContainer(ancestor, descendant) {\x0a    return (ancestor || descendant)\x0a        && (ancestor == descendant || isAncestor(ancestor, descendant));\x0a}\x0a\x0a/**\x0a * Returns true if descendant is a descendant of ancestor, false otherwise.\x0a */\x0afunction isDescendant(descendant, ancestor) {\x0a    return ancestor\x0a        && descendant\x0a        && Boolean(documentPosition(ancestor, descendant) & DOM.DOCUMENT_POSITION_CONTAINED_BY);\x0a}\x0a\x0a/**\x0a * Returns true if node1 is before node2 in tree order, false otherwise.\x0a */\x0afunction isBefore(node1, node2) {\x0a    return Boolean(documentPosition(node1, node2) & DOM.DOCUMENT_POSITION_FOLLOWING);\x0a}\x0a\x0a/**\x0a * Returns true if node1 is after node2 in tree order, false otherwise.\x0a */\x0afunction isAfter(node1, node2) {\x0a    return Boolean(documentPosition(node1, node2) & DOM.DOCUMENT_POSITION_PRECEDING);\x0a}\x0a\x0afunction getAncestors(node) {\x0a    var ancestors = [];\x0a    while (node.parentNode) {\x0a        ancestors.unshift(node.parentNode);\x0a        node = node.parentNode;\x0a    }\x0a    return ancestors;\x0a}\x0a\x0afunction getInclusiveAncestors(node) {\x0a    return getAncestors(node).concat(node);\x0a}\x0a\x0afunction getDescendants(node) {\x0a    var descendants = [];\x0a    var stop = nextNodeDescendants(node);\x0a    while ((node = nextNode(node))\x0a    && node != stop) {\x0a        descendants.push(node);\x0a    }\x0a    return descendants;\x0a}\x0a\x0afunction getInclusiveDescendants(node) {\x0a    return [node].concat(getDescendants(node));\x0a}\x0a\x0afunction convertProperty(property) {\x0a    // Special-case for now\x0a    var map = {\x0a        \x22fontFamily\x22: \x22font-family\x22,\x0