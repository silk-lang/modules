    36 => "previousRadio"
    37 => "nextComboBox"
    38 => "previousComboBox"
    39 => "nextTable"
    40 => "previousTable"
    41 => "nextList"
    42 => "previousList"
    43 => "nextListItem"
    44 => "previousListItem"
    45 => "nextLandmark"
    46 => "previousLandmark"
    47 => "nextGraphic"
    48 => "previousGraphic"
    49 => "listHeadings"
    50 => "listLinks"
    51 => "listFormFields"
    52 => "listButtons"
