//! Keeping what the tree stores per fragment across layouts.
//!
//! css-layout numbers fragments in tree order, so a layout that adds or drops fragments
//! renumbers those after them, and until now every layout pass threw away everything the tree
//! keeps per fragment: the paint hashes and ink, stacking, and the index of fragments by
//! source. css-layout reports which runs of fragments stand as they did
//! (`FragmentArena.carried`). The tree moves its data by those runs ([`CarryPlan`]) and works
//! out only the rest again: [`repairIndex`] here, `paint.repairFragments` and
//! `Stacking.repair`. `UiTree.verifyCaches` compares the result with a full rebuild.
import properties.census { Census }
import layout.lib { Carry, LayoutTree }
import node { NONE, NO_INDEX }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.num.usize

pub const FRAGILE_NONE: u8 = 0
/// A fragment whose own ink or hash reads another fragment (sticky, offset-path, positioning
/// shell): recomputing it and its ancestors keeps the caches exact.
pub const FRAGILE_SELF: u8 = 1
/// A fragment whose descendants read it (perspective, preserve-3d): a direct change to it
/// rebuilds the caches, while unrelated edits leave it and its children intact.
pub const FRAGILE_SUBTREE: u8 = 2
pub const MAX_TRACKED_FRAGILE: usize = 64

pub struct FragileEntry {
  pub fragment: usize,
  pub kind: u8,
}
impl Copy for FragileEntry {}

/// Whether every tree compares each repair of its paint caches with a full rebuild and stops
/// the program when they differ. False but for test runs: build the tree tests with it set to
/// check the repairs against everything the tests lay out and paint.
pub const VERIFY_ALWAYS: bool = false

/// A run of `length` fragments now at `to` that were at `from` in the layout before.
pub struct Segment {
  pub to: usize,
  pub from: usize,
  pub length: usize,
}

impl Copy for Segment {}

impl Order for Segment {
  fn compare(a: &Self, b: &Self) -> Ordering {
    if a.from < b.from {
      return Ordering.Less
    }
    if a.from > b.from {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

/// How the fragments of a layout map onto those of the layout before it.
pub struct CarryPlan {
  /// Ascending by `to`, disjoint.
  pub segments: List<Segment>,
  /// The same segments ascending by `from`, when that is another order.
  byFrom: List<Segment>,
  /// Whether every carried fragment kept its index.
  pub identity: bool,
  /// Whether `from` ascends with `to`: no carried fragment moved past another.
  pub ordered: bool,
  /// The first segment that moved (an index into `segments`); every one before it kept its
  /// place. `segments.length()` when none moved.
  pub firstMoved: usize,
  pub oldCount: usize,
  pub newCount: usize,
}

impl CarryPlan {
  pub fn make() -> CarryPlan {
    return CarryPlan {
      segments: List<Segment>.make(),
      byFrom: List<Segment>.make(),
      identity: true,
      ordered: true,
      firstMoved: 0,
      oldCount: 0,
      newCount: 0,
    }
  }

  /// Takes css-layout's report of a layout of `newCount` fragments after one of `oldCount`.
  /// False when the report does not fit them: nothing is carried then.
  pub effect fn set(self: &mut Self, carried: &[Carry], oldCount: usize, newCount: usize) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    self.segments.clear()
    self.byFrom.clear()
    self.oldCount = oldCount
    self.newCount = newCount
    self.identity = true
    self.ordered = true
    self.firstMoved = carried.length
    let mut end: usize = 0
    let mut fromEnd: usize = 0
    let mut i: usize = 0
    while i < carried.length {
      let c = carried[i]
      if c.to < end || c.length > newCount || c.to > newCount - c.length || c.length > oldCount || c.from > oldCount - c.length {
        return false
      }
      end = c.to + c.length
      if c.from != c.to && self.identity {
        self.identity = false
        self.firstMoved = i
      }
      if c.from < fromEnd {
        self.ordered = false
      }
      fromEnd = c.from + c.length
      run self.segments.append(Segment { to: c.to, from: c.from, length: c.length })
      i = i + 1
    }
    if !self.ordered {
      run self.byFrom.appendSlice(self.segments.asSlice())
      run self.byFrom.sort()
      let sorted = self.byFrom.asSlice()
      let mut at: usize = 0
      i = 0
      while i < sorted.length {
        if sorted[i].from < at {
          return false
        }
        at = sorted[i].from + sorted[i].length
        i = i + 1
      }
    }
    return true
  }

  /// The segments ascending by `from`.
  pub fn fromOrder(self: &Self) -> &[Segment] {
    if self.ordered {
      return self.segments.asSlice()
    }
    return self.byFrom.asSlice()
  }

  /// Where the fragment at `old` in the layout before is now, or NO_INDEX when it is gone.
  pub fn newIndex(self: &Self, old: usize) -> usize {
    let segments = self.fromOrder()
    let mut low: usize = 0
    let mut high = segments.length
    while low < high {
      let mid = low + (high - low) / 2
      if segments[mid].from <= old {
        low = mid + 1
      } else {
        high = mid
      }
    }
    if low == 0 {
      return NO_INDEX
    }
    let s = segments[low - 1]
    if old - s.from < s.length {
      return s.to + (old - s.from)
    }
    return NO_INDEX
  }

  /// Appends the fragments of the new layout no segment covers, ascending.
  pub effect fn uncovered(self: &Self, out: &mut List<usize>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let segments = self.segments.asSlice()
    let mut at: usize = 0
    let mut s: usize = 0
    while s <= segments.length {
      let stop = if s < segments.length { segments[s].to } else { self.newCount }
      while at < stop {
        run out.append(at)
        at = at + 1
      }
      if s < segments.length {
        at = segments[s].to + segments[s].length
      }
      s = s + 1
    }
  }
}

/// Moves a list with one entry per fragment of the layout before to the fragments of this
/// one: `list[segment.to + i]` becomes what `list[segment.from + i]` was. Entries of uncovered
/// fragments hold anything (new ones `fill`); the caller writes them. `spare` is scratch.
pub effect fn carryList<T: Copy>(plan: &CarryPlan, list: &mut List<T>, spare: &mut List<T>, fill: T) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = plan.newCount
  let segments = plan.segments.asSlice()
  if plan.ordered {
    // Only the segments from the first one that moved go anywhere: through `spare`, packed.
    spare.clear()
    let mut s = plan.firstMoved
    while s < segments.length {
      run spare.appendSlice(Slice.view(list.asSlice(), segments[s].from, segments[s].length))
      s = s + 1
    }
    let have = list.length()
    if have > count {
      list.truncate(count)
    } else if have < count {
      run list.appendRepeated(fill, count - have)
    }
    let out = list.asMutSlice()
    let packed = spare.asSlice()
    let mut at: usize = 0
    s = plan.firstMoved
    while s < segments.length {
      let segment = segments[s]
      let mut i: usize = 0
      while i < segment.length {
        out[segment.to + i] = packed[at + i]
        i = i + 1
      }
      at = at + segment.length
      s = s + 1
    }
    return ()
  }
  // Fragments changed order: every entry goes through `spare`.
  spare.clear()
  run spare.appendRepeated(fill, count)
  let out = spare.asMutSlice()
  let from = list.asSlice()
  let mut s: usize = 0
  while s < segments.length {
    let segment = segments[s]
    let mut i: usize = 0
    while i < segment.length {
      out[segment.to + i] = from[segment.from + i]
      i = i + 1
    }
    s = s + 1
  }
  let filled = Intrinsic.replace(spare.*, List<T>.make())
  let emptied = Intrinsic.replace(list.*, move filled)
  spare.* = move emptied
}

/// A fragment and the source it is indexed under, ordered by source, then fragment.
struct Keyed {
  source: u32,
  index: usize,
}

impl Copy for Keyed {}

impl Order for Keyed {
  fn compare(a: &Self, b: &Self) -> Ordering {
    if a.source != b.source {
      return if a.source < b.source {
        Ordering.Less
      } else {
        Ordering.Greater
      }
    }
    if a.index < b.index {
      return Ordering.Less
    }
    if a.index > b.index {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

/// What the tree keeps beside `UiTree.fragmentOf` and `UiTree.nextSourceFragment` to repair
/// them: each fragment's source as indexed, and the fragment before it in its source's chain.
pub struct SourceIndex {
  /// Per fragment: the css-layout node it is indexed under, or NONE (a positioning shell, or a
  /// source the index has no entry for).
  pub sources: List<u32>,
  /// Per fragment: the fragment before it with the same source, or NO_INDEX.
  pub previous: List<usize>,
  spareSources: List<u32>,
  spareIndices: List<usize>,
  keyed: List<Keyed>,
}

impl SourceIndex {
  pub effect fn census(self: &Self, out: &mut Census) -> () ! OutOfMemoryError ? &mut Allocator {
    run out.bytes("tree.repair.source-index(per fragment)", self.sources.length() * 4 + self.previous.length() * 8,
      (self.sources.capacity() + self.spareSources.capacity()) * 4 + (self.previous.capacity() + self.spareIndices.capacity()) * 8 + self.keyed.capacity() * Intrinsic.layoutOf<Keyed>().bytes)
  }

  pub fn make() -> SourceIndex {
    return SourceIndex {
      sources: List<u32>.make(),
      previous: List<usize>.make(),
      spareSources: List<u32>.make(),
      spareIndices: List<usize>.make(),
      keyed: List<Keyed>.make(),
    }
  }

  pub fn clear(self: &mut Self) -> () {
    self.sources.clearAndFree()
    self.previous.clearAndFree()
    self.spareSources.clearAndFree()
    self.spareIndices.clearAndFree()
    self.keyed.clearAndFree()
  }
}

/// The source fragment `index` is indexed under, or NONE.
fn sourceKey(output: &LayoutTree, nodes: usize, index: usize) -> u32 {
  let f = &output.fragments.values.asSlice()[index]
  if f.source < nodes && !f.positioningShell {
    return usize.toU32(f.source)
  }
  return NONE
}

/// Fills `first` (per css-layout node, of `nodes`: its first fragment) and `next` (per
/// fragment: the next with the same source) from the last layout, and `index` with them.
pub effect fn buildIndex(
  output: &LayoutTree,
  nodes: usize,
  first: &mut List<usize>,
  next: &mut List<usize>,
  index: &mut SourceIndex,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let values = output.fragments.values.asSlice()
  first.clear()
  run first.appendRepeated(NO_INDEX, nodes)
  next.clear()
  run next.appendRepeated(NO_INDEX, values.length)
  index.sources.clear()
  run index.sources.appendRepeated(NONE, values.length)
  index.previous.clear()
  run index.previous.appendRepeated(NO_INDEX, values.length)
  let mut i = values.length
  while i > 0 {
    i = i - 1
    let source = values[i].source
    if source < nodes && !values[i].positioningShell {
      let after = first.get(source)
      next.set(i, after)
      if after != NO_INDEX {
        index.previous.set(after, i)
      }
      first.set(source, i)
      index.sources.set(i, usize.toU32(source))
    }
  }
}

/// Takes fragment `old` of the layout before out of its source's chain.
fn unlink(first: &mut List<usize>, next: &mut List<usize>, index: &mut SourceIndex, old: usize) -> () {
  let source = index.sources.get(old)
  if source == NONE {
    return ()
  }
  let before = index.previous.get(old)
  let after = next.get(old)
  if before == NO_INDEX {
    if u32.toUsize(source) < first.length() {
      first.set(u32.toUsize(source), after)
    }
  } else {
    next.set(before, after)
  }
  if after != NO_INDEX {
    index.previous.set(after, before)
  }
}

/// [`buildIndex`] for a layout that kept the runs of `plan` from the layout before, whose
/// index the lists hold: takes out the fragments that are gone, moves the entries of those
/// that moved, and links in the fragments of `dirty` (every fragment `plan` does not cover,
/// ascending). False, with the lists in no usable state, when they do not fit the plan.
pub effect fn repairIndex(
  plan: &CarryPlan,
  output: &LayoutTree,
  nodes: usize,
  first: &mut List<usize>,
  next: &mut List<usize>,
  index: &mut SourceIndex,
  dirty: &[usize],
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let old = plan.oldCount
  if next.length() != old || index.sources.length() != old || index.previous.length() != old
    || first.length() > nodes || output.fragments.values.length() != plan.newCount {
    return false
  }
  if first.length() < nodes {
    let have = first.length()
    run first.appendRepeated(NO_INDEX, nodes - have)
  }

  // The fragments that are gone leave their chains, by their old indices.
  let ordered = plan.fromOrder()
  let mut at: usize = 0
  let mut s: usize = 0
  while s <= ordered.length {
    let stop = if s < ordered.length { ordered[s].from } else { old }
    while at < stop {
      unlink(&mut first, &mut next, &mut index, at)
      at = at + 1
    }
    if s < ordered.length {
      at = ordered[s].from + ordered[s].length
    }
    s = s + 1
  }

  run carryList<u32>(plan, &mut index.sources, &mut index.spareSources, NONE)
  run carryList<usize>(plan, &mut index.previous, &mut index.spareIndices, NO_INDEX)
  run carryList<usize>(plan, &mut next, &mut index.spareIndices, NO_INDEX)

  // The links of the entries that moved still name old indices: each entry's own first,
  // then the links to it, which the entries that stayed need too.
  let segments = plan.segments.asSlice()
  let start = if plan.ordered { plan.firstMoved } else { 0 }
  s = start
  while s < segments.length {
    let segment = segments[s]
    let mut i: usize = 0
    while i < segment.length {
      let to = segment.to + i
      if index.sources.get(to) != NONE {
        let before = index.previous.get(to)
        if before != NO_INDEX {
          let moved = if before >= segment.from && before - segment.from < segment.length {
            segment.to + (before - segment.from)
          } else {
            plan.newIndex(before)
          }
          index.previous.set(to, moved)
        }
        let after = next.get(to)
        if after != NO_INDEX {
          let moved = if after >= segment.from && after - segment.from < segment.length {
            segment.to + (after - segment.from)
          } else {
            plan.newIndex(after)
          }
          next.set(to, moved)
        }
      }
      i = i + 1
    }
    s = s + 1
  }
  s = start
  while s < segments.length {
    let segment = segments[s]
    let mut i: usize = 0
    while i < segment.length {
      let to = segment.to + i
      let source = index.sources.get(to)
      if source != NONE {
        let before = index.previous.get(to)
        if before == NO_INDEX {
          first.set(u32.toUsize(source), to)
        } else {
          next.set(before, to)
        }
        let after = next.get(to)
        if after != NO_INDEX {
          index.previous.set(after, to)
        }
      }
      i = i + 1
    }
    s = s + 1
  }

  // The new fragments join their sources' chains, which ascend.
  index.keyed.clear()
  let mut d: usize = 0
  while d < dirty.length {
    let to = dirty[d]
    let source = sourceKey(output, nodes, to)
    index.sources.set(to, source)
    index.previous.set(to, NO_INDEX)
    next.set(to, NO_INDEX)
    if source != NONE {
      run index.keyed.append(Keyed { source: source, index: to })
    }
    d = d + 1
  }
  run index.keyed.sort()
  let keyed = index.keyed.asSlice()
  let mut k: usize = 0
  while k < keyed.length {
    let source = keyed[k].source
    let mut before = NO_INDEX
    let mut after = first.get(u32.toUsize(source))
    while k < keyed.length && keyed[k].source == source {
      let to = keyed[k].index
      while after != NO_INDEX && after < to {
        before = after
        after = next.get(after)
      }
      index.previous.set(to, before)
      next.set(to, after)
      if before == NO_INDEX {
        first.set(u32.toUsize(source), to)
      } else {
        next.set(before, to)
      }
      if after != NO_INDEX {
        index.previous.set(after, to)
      }
      before = to
      k = k + 1
    }
  }
  return true
}

/// What changed for the paint caches since they were last refreshed, short of everything
/// (`UiTree.paintCachesStale`), and what repairing them needs.
pub struct Repair {
  /// Whether anything is listed below: the caches are out of date until the next refresh.
  pub pending: bool,
  /// Slots of nodes whose own paint inputs changed: a restyle that repaints, a mutation.
  pub nodes: List<u32>,
  /// Fragments of the last layout that are new or changed.
  pub fragments: List<usize>,
  /// Whether the caches hold more fragile fragments than tracked (`MAX_TRACKED_FRAGILE`) or
  /// have not been built yet: any change then rebuilds them all.
  pub fragile: bool,
  /// Tracked fragile fragments (when `!fragile`), carried across layout passes.
  pub fragiles: List<FragileEntry>,
  /// Scratch list for newly observed fragile fragments during repair.
  pub spareFragiles: List<FragileEntry>,
  /// Whether the last refresh folded fixed boxes' roots into the roots that paint them.
  pub lifted: bool,
  pub plan: CarryPlan,
  pub index: SourceIndex,
  /// Compare every repaired cache with a full rebuild (`UiTree.verifyCaches`), counting the
  /// refreshes that differed.
  pub verify: bool,
  pub mismatches: usize,
  /// How many refreshes repaired the caches, and how many rebuilt them.
  pub repairs: usize,
  pub rebuilds: usize,
  /// Of the rebuilds: those after a layout pass css-layout reported nothing kept for, and
  /// those because the caches were fragile.
  pub uncarried: usize,
  pub fragileRebuilds: usize,
  /// Why the last such layout pass carried nothing: 1 css-layout knew of nothing kept, 2 its
  /// report did not fit the fragment counts, 3 the index by source did not fit it, 4 it kept
  /// too little for a repair to pay.
  pub uncarriedWhy: u8,
  pub dirty: List<usize>,
  pub spareHashes: List<u64>,
  pub spareInk: List<Rect<f32>>,
  pub spareFlags: List<bool>,
  pub stack: List<usize>,
  /// Per fragment, all false between refreshes: scratch for telling which are listed.
  pub marks: List<bool>,
}

impl Repair {
  pub fn make() -> Repair {
    return Repair {
      pending: false,
      nodes: List<u32>.make(),
      fragments: List<usize>.make(),
      fragile: true,
      fragiles: List<FragileEntry>.make(),
      spareFragiles: List<FragileEntry>.make(),
      lifted: false,
      plan: CarryPlan.make(),
      index: SourceIndex.make(),
      verify: VERIFY_ALWAYS,
      mismatches: 0,
      repairs: 0,
      rebuilds: 0,
      uncarried: 0,
      fragileRebuilds: 0,
      uncarriedWhy: 0,
      dirty: List<usize>.make(),
      spareHashes: List<u64>.make(),
      spareInk: List<Rect<f32>>.make(),
      spareFlags: List<bool>.make(),
      stack: List<usize>.make(),
      marks: List<bool>.make(),
    }
  }

  /// Forgets what was pending: the caches were rebuilt, or are about to be.
  pub fn settle(self: &mut Self) -> () {
    self.pending = false
    self.nodes.clear()
    self.fragments.clear()
  }

  /// Forgets everything that describes one root's layout: another root's is current now.
  pub fn reset(self: &mut Self) -> () {
    self.settle()
    self.fragile = true
    self.fragiles.clear()
    self.spareFragiles.clear()
    self.lifted = false
    self.index.clear()
    self.marks.clearAndFree()
  }
}

/// Sorts `list` and drops repeats.
pub effect fn sortUnique(list: &mut List<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run list.sort()
  let values = list.asMutSlice()
  let mut kept: usize = 0
  let mut i: usize = 0
  while i < values.length {
    if kept == 0 || values[kept - 1] != values[i] {
      values[kept] = values[i]
      kept = kept + 1
    }
    i = i + 1
  }
  list.truncate(kept)
}
