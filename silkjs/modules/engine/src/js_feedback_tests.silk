// Call and type feedback (js_feedback): a hot function the embedder starts
// recording from its hot function report gets per-site operand classes, call
// targets and receiver shapes, read through a snapshot. Fails if recording stops.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u32
import silk.testing.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_engine { Engine }
import js_engine_host { EngineServices }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_realm { Realm, lendRealm }
import js_core_types { HostHook, NativeFunctionId }
import js_exceptions { JsException }
import js_feedback { Snapshot, Site }
import js_feedback as feedback
import js_class_data as classes
import js_backtrace as backtrace
import js_runtime as runtime
import js_gc as gc
import js_eval as eval
import js_intrinsic_install as intrinsics
import native_stack as stack

const HANDLER: u32 = 11

pub struct Recorder { pub started: usize }
impl EngineServices for Recorder {
  effect fn initializeShadowRealm<'r, 's, 'm>(engine: &mut Engine<'m, Self>, caller: Realm<'r>, created: Realm<'s>) -> () ! JsException ? &mut Allocator {}
  effect fn dynamicImportStarted<'r, 'v, 'w, 'x, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>, specifier: ValueRef<'v>, referrer: ValueRef<'w>, promise: ValueRef<'x>) -> ValueBits ! JsException ? &mut Allocator {
    return promise.dup().intoBits()
  }
  unsafe effect fn hotFunction<'m>(engine: &mut Engine<'m, Self>, rt: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, function: ValueBits) -> () ? &mut Allocator {
    if let ValueBits.FunctionBytecode { reference } = function {
      match run Effect.result(unsafe feedback.start(rt, reference, feedback.DEFAULT_FUNCTION_BUDGET)) {
        Result<bool, OutOfMemoryError>.Success { value } => { if value { engine.services.started = engine.services.started + 1 } }
        Result<bool, OutOfMemoryError>.Failure { .. } => ()
      }
    }
  }
}
unsafe effect fn run_<'m>(engine: &mut Engine<'m, Recorder>, context: *mut HeapHeader, source: &[u8]) -> () ! JsException ? &mut Allocator {
  let memory = engine.memory
  let result = run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"feedback.js", 0)
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), Value.intoBits(move result))
}
/// The recorded feedback of the global function named by source.
unsafe effect fn feedbackOf<'m>(engine: &mut Engine<'m, Recorder>, context: *mut HeapHeader, source: &[u8]) -> Option<Snapshot>
  ! JsException | OutOfMemoryError ? &mut Allocator {
  let memory = engine.memory
  let rt = unsafe runtime.contextRuntime(context)
  let value = Value.intoBits(move run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"feedback.js", 0))
  let code = unsafe backtrace.bytecode(value)
  unsafe gc.release(&mut engine, rt, value)
  return match code {
    Option<*mut HeapHeader>.Some { value: reference } => run unsafe feedback.snapshot(rt, reference)
    Option<*mut HeapHeader>.None => Option<Snapshot>.none()
  }
}
/// How many sites of kind ran and satisfy want.
fn countSites(snapshot: &Snapshot, kind: u8, left: u8, right: u8, flags: u8) -> usize {
  let mut found: usize = 0 let mut index: usize = 0
  while index < snapshot.sites.length() {
    let site = snapshot.sites.get(index)
    if site.kind == kind && site.count > 0 && site.left == left && site.right == right && site.flags == flags { found = found + 1 }
    index = index + 1
  }
  return found
}
fn ranSites(snapshot: &Snapshot, kind: u8) -> usize {
  let mut found: usize = 0 let mut index: usize = 0
  while index < snapshot.sites.length() {
    let site = snapshot.sites.get(index)
    if site.kind == kind && site.count > 0 { found = found + 1 }
    index = index + 1
  }
  return found
}
/// The call site that ran with targets distinct targets, or none.
fn callSite(snapshot: &Snapshot, targets: u8) -> Option<Site> {
  let mut index: usize = 0
  while index < snapshot.sites.length() {
    let site = snapshot.sites.get(index)
    if site.kind == feedback.KIND_CALL && site.count > 0 && site.targets == targets { return Option<Site>.some(site) }
    index = index + 1
  }
  return Option<Site>.none()
}
unsafe effect fn exercise<'m>(engine: &mut Engine<'m, Recorder>, context: *mut HeapHeader) -> ()
  ! JsException | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: HANDLER }), opaque: Pointer.null<u8>() })
  // Reported after 1000 entries (HOT_ENTRY_BUDGET); then each call records.
  run unsafe run_(&mut engine, context,
    b"function intSum(n){var t=0;for(var j=0;j<n;j++)t=t+j;return t}for(var i=0;i<1500;i++)intSum(3)")
  run Testing.expect(engine.services.started == 1, "the hot function is reported and starts recording")
  let ints = run unsafe feedbackOf(&mut engine, context, b"intSum")
  run Testing.expect(ints.isSome(), "the reported function has a record")
  if let Option<Snapshot>.Some { value: snapshot } = move ints {
    run Testing.expect(ranSites(&snapshot, feedback.KIND_BINARY) >= 2, "the add and the compare ran while recording")
    run Testing.expect(countSites(&snapshot, feedback.KIND_BINARY, feedback.SEEN_INT, feedback.SEEN_INT, 0) == ranSites(&snapshot, feedback.KIND_BINARY),
      "every arithmetic and comparison site of an int-only loop saw only int32 operands, without overflow")
  }
  run unsafe run_(&mut engine, context,
    b"function mixedSum(n,x){var t=0;for(var j=0;j<n;j++)t=t+x;return t}for(var i=0;i<1200;i++)mixedSum(2,1);for(var i=0;i<200;i++)mixedSum(2,0.5)")
  let mixed = run unsafe feedbackOf(&mut engine, context, b"mixedSum")
  if let Option<Snapshot>.Some { value: snapshot } = move mixed {
    let doubles = countSites(&snapshot, feedback.KIND_BINARY, feedback.SEEN_INT | feedback.SEEN_DOUBLE, feedback.SEEN_INT | feedback.SEEN_DOUBLE, 0)
      + countSites(&snapshot, feedback.KIND_BINARY, feedback.SEEN_INT | feedback.SEEN_DOUBLE, feedback.SEEN_INT | feedback.SEEN_DOUBLE, feedback.SEEN_OVERFLOW)
    run Testing.expect(doubles == 1, "the add that saw 0.5 records int32 and double operands")
  } else { run Testing.expect(false, "mixedSum has a record") }
  run unsafe run_(&mut engine, context,
    b"function grow(n){var t=2147483000;for(var j=0;j<n;j++)t=t+1;return t}for(var i=0;i<1300;i++)grow(i%2==0?1:1000)")
  let grown = run unsafe feedbackOf(&mut engine, context, b"grow")
  if let Option<Snapshot>.Some { value: snapshot } = move grown {
    run Testing.expect(countSites(&snapshot, feedback.KIND_BINARY, feedback.SEEN_INT | feedback.SEEN_DOUBLE, feedback.SEEN_INT, feedback.SEEN_OVERFLOW) == 1,
      "an add whose int32 sum overflowed records the overflow")
  } else { run Testing.expect(false, "grow has a record") }
  run unsafe run_(&mut engine, context,
    b"function inc(x){return x+1}function mono(n){var t=0;for(var j=0;j<n;j++)t=inc(t);return t}for(var i=0;i<1500;i++)mono(2)")
  let callee = run unsafe feedbackOf(&mut engine, context, b"inc")
  run Testing.expect(callee.isNone(), "a frameless leaf callee is not reported")
  let monomorphic = run unsafe feedbackOf(&mut engine, context, b"mono")
  if let Option<Snapshot>.Some { value: snapshot } = move monomorphic {
    match callSite(&snapshot, 1) {
      Option<Site>.Some { value: site } => {
        let target = snapshot.targets.get(u32.toUsize(site.first))
        run Testing.expect(target.kind == feedback.TARGET_BYTECODE, "the one target is a bytecode function")
        let memory = engine.memory
        let incBits = Value.intoBits(move run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), b"inc", b"feedback.js", 0))
        let same = match unsafe backtrace.bytecode(incBits) {
          Option<*mut HeapHeader>.Some { value } => match target.function { ValueBits.FunctionBytecode { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(value) _ => false }
          _ => false
        }
        unsafe gc.release(&mut engine, rt, incBits)
        run Testing.expect(same, "the monomorphic target is inc's code")
      }
      Option<Site>.None => { run Testing.expect(false, "the call site of mono records one target") }
    }
    run Testing.expect(callSite(&snapshot, 2).isNone() && callSite(&snapshot, feedback.MEGAMORPHIC_TARGETS).isNone(), "mono has no polymorphic call site")
  } else { run Testing.expect(false, "mono has a record") }
  run unsafe run_(&mut engine, context,
    b"function one(x){return x+1}function two(x){return x+2}function poly(n,g){var t=0;for(var j=0;j<n;j++)t=g(t);return t}for(var i=0;i<1500;i++)poly(2,i%2?one:two)")
  let polymorphic = run unsafe feedbackOf(&mut engine, context, b"poly")
  if let Option<Snapshot>.Some { value: snapshot } = move polymorphic {
    run Testing.expect(callSite(&snapshot, 2).isSome(), "a call site with two targets records both")
  } else { run Testing.expect(false, "poly has a record") }
  run unsafe run_(&mut engine, context,
    b"function getX(n,o){var t=0;for(var j=0;j<n;j++)t=t+o.x;return t}var p={x:1},q={y:2,x:3};for(var i=0;i<1500;i++)getX(2,i%2?p:q)")
  let shapes = run unsafe feedbackOf(&mut engine, context, b"getX")
  if let Option<Snapshot>.Some { value: snapshot } = move shapes {
    let mut two = false let mut index: usize = 0
    while index < snapshot.sites.length() {
      let site = snapshot.sites.get(index)
      if site.kind == feedback.KIND_PROPERTY && site.count > 0 && site.left == feedback.SEEN_OBJECT && site.shapeCount == 2 { two = true }
      index = index + 1
    }
    run Testing.expect(two, "o.x over two object layouts records two shapes")
  } else { run Testing.expect(false, "getX has a record") }
  // Many records open at once, each call site taking its first target before any takes its
  // second: every record keeps room for both (the table never grows while recording).
  run unsafe run_(&mut engine, context,
    b"function k0(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k1(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k2(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k3(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k4(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k5(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k6(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k7(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k8(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k9(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k10(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}function k11(g){var t=0;for(var j=0;j<2;j++)t=g(t);return t}var ks=[k0,k1,k2,k3,k4,k5,k6,k7,k8,k9,k10,k11];for(var a=0;a<ks.length;a++)for(var i=0;i<1005;i++)ks[a](one);for(var a=0;a<ks.length;a++)for(var i=0;i<5;i++)ks[a](two)")
  let last = run unsafe feedbackOf(&mut engine, context, b"k11")
  if let Option<Snapshot>.Some { value: snapshot } = move last {
    run Testing.expect(callSite(&snapshot, 2).isSome(), "the last of twelve records still has room for its second target")
  } else { run Testing.expect(false, "k11 has a record") }
  run unsafe run_(&mut engine, context,
    b"function sum(n,a,b){var t=0;for(var j=0;j<n;j++){t=t+a[j]+b[j];b[j]=t}return t}var f=new Float64Array(4),u=[1,2,3,4],w=[5,6,7,8];for(var i=0;i<1500;i++)sum(4,f,i%2?u:new Int16Array(4))")
  let elements = run unsafe feedbackOf(&mut engine, context, b"sum")
  if let Option<Snapshot>.Some { value: snapshot } = move elements {
    let float64 = feedback.ELEMENT_TYPED + u32.toU8(classes.JS_CLASS_FLOAT64_ARRAY - classes.JS_CLASS_UINT8C_ARRAY)
    run Testing.expect(countSites(&snapshot, feedback.KIND_ELEMENT, feedback.SEEN_OBJECT, float64, 0) == 1, "a[j] over a Float64Array records its class")
    run Testing.expect(countSites(&snapshot, feedback.KIND_ELEMENT, feedback.SEEN_OBJECT, feedback.ELEMENT_MIXED, 0) == 2, "b[j] and b[j]= over an Array and an Int16Array record more than one kind")
  } else { run Testing.expect(false, "sum has a record") }
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() })
}
test effect fn hotFunctionsRecordFeedback() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: Recorder { started: 0 } }
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = run Effect.result(unsafe exercise(&mut engine, context)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), JsException | OutOfMemoryError | AssertionError<'static>>.Success { value: _ } => ()
    Result<(), JsException | OutOfMemoryError | AssertionError<'static>>.Failure { error } => { fail move error }
  }
  run Testing.expect(memory.stats().allocationCount == 0 && memory.stats().usedBytes == 0, "the recorder releases everything it holds")
}
