//! XXH64 with seed 0, in steps: the content checksum of a Zstandard frame.
//!
//! [`reset`] starts a hash, [`update`] adds bytes in any pieces, and [`digest`] returns the hash of
//! the bytes so far without ending it. The state is plain data and owns no storage.
import mem
import silk.num.u8
import silk.num.u64
import silk.num.usize

const PRIME1: u64 = 0x9E3779B185EBCA87
const PRIME2: u64 = 0xC2B2AE3D27D4EB4F
const PRIME3: u64 = 0x165667B19E3779F9
const PRIME4: u64 = 0x85EBCA77C2B2AE63
const PRIME5: u64 = 0x27D4EB2F165667C5

/// The state of one XXH64 hash.
pub struct Xxh64 {
  total: u64,
  v1: u64,
  v2: u64,
  v3: u64,
  v4: u64,
  buffer: [u8; 32],
  buffered: usize,
}

/// Returns the state of a hash of no bytes, with seed 0.
pub fn make() -> Xxh64 {
  return Xxh64 {
    total: 0,
    v1: u64.wrappingAdd(PRIME1, PRIME2),
    v2: PRIME2,
    v3: 0,
    v4: u64.wrappingSubtract(0, PRIME1),
    buffer: [0; 32],
    buffered: 0,
  }
}

/// Starts `state` again as a hash of no bytes.
pub fn reset(state: &mut Xxh64) -> () {
  state.total = 0
  state.v1 = u64.wrappingAdd(PRIME1, PRIME2)
  state.v2 = PRIME2
  state.v3 = 0
  state.v4 = u64.wrappingSubtract(0, PRIME1)
  state.buffered = 0
}

@inlineAlways
fn round(accumulator: u64, lane: u64) -> u64 {
  return u64.wrappingMultiply(u64.rotateLeft(u64.wrappingAdd(accumulator, u64.wrappingMultiply(lane, PRIME2)), 31), PRIME1)
}

@inlineAlways
fn merge(hash: u64, lane: u64) -> u64 {
  return u64.wrappingAdd(u64.wrappingMultiply(hash ^ round(0, lane), PRIME1), PRIME4)
}

/// Adds the `length` bytes at `data[at..]` to the hash. The caller proves that they are readable.
pub unsafe fn update(state: &mut Xxh64, data: [*]const u8, at: usize, length: usize) -> () {
  if length == 0 { return () }
  state.total = u64.wrappingAdd(state.total, usize.toU64(length))
  let mut position = at
  let end = usize.wrappingAdd(at, length)
  if state.buffered != 0 || length < 32 {
    // Fill the pending stripe.
    while state.buffered < 32 && position < end {
      state.buffer[state.buffered] = unsafe mem.r8(data, position)
      state.buffered = state.buffered + 1
      position = usize.wrappingAdd(position, 1)
    }
    if state.buffered < 32 { return () }
    let mut stripe: [u64; 4] = [0; 4]
    let mut lane: usize = 0
    while lane < 4 {
      let mut word: u64 = 0
      let mut byte: usize = 0
      while byte < 8 {
        word = word | u64.shiftLeft(u8.toU64(state.buffer[lane * 8 + byte]), usize.toU64(byte * 8))
        byte = byte + 1
      }
      stripe[lane] = word
      lane = lane + 1
    }
    state.v1 = round(state.v1, stripe[0])
    state.v2 = round(state.v2, stripe[1])
    state.v3 = round(state.v3, stripe[2])
    state.v4 = round(state.v4, stripe[3])
    state.buffered = 0
  }
  if usize.wrappingSubtract(end, position) >= 32 {
    let limit = usize.wrappingSubtract(end, 32)
    let mut v1 = state.v1
    let mut v2 = state.v2
    let mut v3 = state.v3
    let mut v4 = state.v4
    while position <= limit {
      v1 = round(v1, unsafe mem.r64(data, position))
      v2 = round(v2, unsafe mem.r64(data, usize.wrappingAdd(position, 8)))
      v3 = round(v3, unsafe mem.r64(data, usize.wrappingAdd(position, 16)))
      v4 = round(v4, unsafe mem.r64(data, usize.wrappingAdd(position, 24)))
      position = usize.wrappingAdd(position, 32)
    }
    state.v1 = v1
    state.v2 = v2
    state.v3 = v3
    state.v4 = v4
  }
  while position < end {
    state.buffer[state.buffered] = unsafe mem.r8(data, position)
    state.buffered = state.buffered + 1
    position = usize.wrappingAdd(position, 1)
  }
}

/// Returns the XXH64 of the bytes added so far. The hash can take more bytes after it.
pub fn digest(state: &Xxh64) -> u64 {
  let mut hash: u64 = 0
  if state.total >= 32 {
    hash = u64.wrappingAdd(
      u64.wrappingAdd(u64.rotateLeft(state.v1, 1), u64.rotateLeft(state.v2, 7)),
      u64.wrappingAdd(u64.rotateLeft(state.v3, 12), u64.rotateLeft(state.v4, 18)),
    )
    hash = merge(hash, state.v1)
    hash = merge(hash, state.v2)
    hash = merge(hash, state.v3)
    hash = merge(hash, state.v4)
  } else {
    hash = u64.wrappingAdd(state.v3, PRIME5)
  }
  hash = u64.wrappingAdd(hash, state.total)
  let mut position: usize = 0
  while position + 8 <= state.buffered {
    let mut word: u64 = 0
    let mut byte: usize = 0
    while byte < 8 {
      word = word | u64.shiftLeft(u8.toU64(state.buffer[position + byte]), usize.toU64(byte * 8))
      byte = byte + 1
    }
    hash = hash ^ round(0, word)
    hash = u64.wrappingAdd(u64.wrappingMultiply(u64.rotateLeft(hash, 27), PRIME1), PRIME4)
    position = position + 8
  }
  if position + 4 <= state.buffered {
    let mut word: u64 = 0
    let mut byte: usize = 0
    while byte < 4 {
      word = word | u64.shiftLeft(u8.toU64(state.buffer[position + byte]), usize.toU64(byte * 8))
      byte = byte + 1
    }
    hash = hash ^ u64.wrappingMultiply(word, PRIME1)
    hash = u64.wrappingAdd(u64.wrappingMultiply(u64.rotateLeft(hash, 23), PRIME2), PRIME3)
    position = position + 4
  }
  while position < state.buffered {
    hash = hash ^ u64.wrappingMultiply(u8.toU64(state.buffer[position]), PRIME5)
    hash = u64.wrappingMultiply(u64.rotateLeft(hash, 11), PRIME1)
    position = position + 1
  }
  hash = hash ^ u64.shiftRight(hash, 33)
  hash = u64.wrappingMultiply(hash, PRIME2)
  hash = hash ^ u64.shiftRight(hash, 29)
  hash = u64.wrappingMultiply(hash, PRIME3)
  hash = hash ^ u64.shiftRight(hash, 32)
  return hash
}
