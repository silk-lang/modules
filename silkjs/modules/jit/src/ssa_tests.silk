test effect fn argumentCounterUnboxedOnEntry() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectPasses(COUNTER_SOURCE, ssa_opt.PASS_ALL, COUNTER_UNBOXED,
    "arguments the loop counts with are unboxed on the entry edge (b2) and carried as i32s; the dead local l is not carried")
}

const REPEATED_SOURCE: &[u8] = b"function f(a,n){var s=0;for(var i=0;i<n;i++){s=s+(a[i]&255)+(a[i]>>8)}return s} f([1,2],2); f"
