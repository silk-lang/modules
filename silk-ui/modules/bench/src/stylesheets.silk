import harness { Bench }
import walls { Fixture }
import ui_tree.lib { BoxNode, TreeError, ProtocolError, Attribute, StyleState, FlexDirection, Align, BoxSizing, Input }
import ui_tree.batch { Batch }
import ui_tree.style { Fill }
import ui_tree.style_media { Preferences }
import ui_tree.style_runtime
import ui_tree.css
import ui_tree.css { px, Keyword }
import silk.build.source { Source }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

pub enum Step { Create, Idle, Class, Hover, Theme, Append, Style, Has, FocusWithin, Display, Attribute, Custom }

/// The rule a narrowed-restyle step adds, in a sheet of its own after the Tailwind one, or "".
fn extra(step: Step) -> &'static [u8] {
  return match step {
    Step.Has => b".rounded-lg:has(.picked){opacity:.5}"
    Step.FocusWithin => b".rounded-lg:focus-within{opacity:.5}"
    Step.Display => b".gone{display:none}"
    Step.Attribute => b"[aria-selected=true]{opacity:.5}"
    Step.Custom => b".rounded-lg{opacity:var(--row-opacity,1)}"
    _ => b""
  }
}
pub enum Mode { Inline, Tailwind, Registered, SpaceY, Owl, Zebra }

const BASE: string = "flex items-center gap-2 p-2 rounded-lg bg-white text-black hover:bg-black dark:bg-black dark:text-white"
const CELLS: [string; 3] = ["flex items-center gap-2", "p-2 rounded-lg", "flex flex-col p-2"]
const EVEN: string = "flex items-center gap-2 p-2 rounded-lg bg-white text-black hover:bg-black dark:bg-black dark:text-white even:bg-black"
const CHANGED: string = "flex items-center gap-2 p-4 rounded-lg bg-white text-black hover:bg-black dark:bg-black dark:text-white"

fn color(white: bool) -> Rgba<f32> {
  let value: f32 = if white { 1.0 } else { 0.0 }
  return Rgba<f32> { r: value, g: value, b: value, a: 1.0 }
}

fn rootClasses(mode: Mode, dark: bool) -> string<'static> {
  return match mode {
    Mode.SpaceY => if dark { "space-y-2 divide-y divide-black dark" } else { "space-y-2 divide-y divide-black" }
    Mode.Owl => if dark { "owl dark" } else { "owl" }
    _ => if dark { "dark" } else { "" }
  }
}

effect fn protocol(error: ProtocolError) -> never ! TreeError { fail error.error }

pub struct Rows<'a> {
  fixture: Fixture<'a>,
  rows: List<BoxNode>,
  /// The first cell of each row.
  leads: List<BoxNode>,
  count: usize,
  /// Each row also holds three styled boxes, as a list item with an icon, a body and an action does.
  cells: bool,
  /// Odd rows have another padding, so no row equals the one before it and none can take its style.
  distinct: bool,
  sheet: bool,
  mode: Mode,
  step: Step,
  changed: bool,
}

impl<'a> Rows<'a> {
  pub effect fn make(mut fixture: Fixture<'a>, mode: Mode, step: Step, count: usize, cells: bool, distinct: bool) -> Rows<'a>
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    run fixture.tree.setStyle(fixture.root, &[css.display(Keyword.Flex), css.flexDirection(FlexDirection.Column)])
    drop fixture.tree.engineMut().setStylePreferences(Preferences.desktop(false))
    let sheet = mode != Mode.Inline
    if sheet {
      let mut batch = Batch.make()
      // `siblings.sheet` holds `+`, `~`, `:nth-child()` and `:has()` rules whichever of them a case uses.
      let siblings = mode == Mode.SpaceY || mode == Mode.Owl || mode == Mode.Zebra
      run batch.adoptStyleSheet(0, 1, if siblings { Source.read("fixtures/siblings.sheet") } else { Source.read("fixtures/rows.sheet") })
      if mode == Mode.Registered { run batch.adoptStyleSheet(0, 2, Source.read("fixtures/registered.sheet")) }
      if extra(step).length != 0 {
        match style_runtime.runtime().call(extra(step)) {
          Option.Some { value } => run batch.adoptStyleSheet(0, 3, value.asSlice())
          _ => { fail TreeError.Layout }
        }
      }
      run Effect.catch<ProtocolError>(fixture.tree.apply(run batch.take()), protocol)
      run fixture.tree.setAttribute(fixture.root, Attribute.ClassName { value: run String.copy(rootClasses(mode, false)) })
    }
    return Rows { fixture: move fixture, rows: List<BoxNode>.make(), leads: List<BoxNode>.make(), count: count, cells: cells, distinct: distinct, sheet: sheet, mode: mode, step: step, changed: false }
  }

  effect fn build(self: &mut Self) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    while i < self.count {
      run self.row()
      i = i + 1
    }
  }

  effect fn row(self: &mut Self) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let row = run self.fixture.tree.box(&[
      css.width(px(240.0)), css.height(px(40.0)), css.flexShrink(0.0), css.boxSizing(BoxSizing.BorderBox),
    ])
    let wide = self.distinct && self.rows.length() % 2 == 1
    if self.sheet {
      run self.fixture.tree.setAttribute(row, Attribute.ClassName { value: run String.copy(if wide { CHANGED } else if self.mode == Mode.Zebra { EVEN } else { BASE }) })
    } else {
      run self.fixture.tree.setStyle(row, &[
        css.display(Keyword.Flex), css.alignItems(Align.Center), css.gap(px(8.0)), css.padding(px(if wide { 16.0 } else { 8.0 })),
        css.borderRadius(px(8.0)), css.backgroundColor(color(true)), css.color(color(false)),
      ])
      run self.fixture.tree.setStyleFor(row, StyleState.Hover, &[css.backgroundColor(color(false))])
    }
    let label = run self.fixture.tree.text("Row")
    run self.fixture.tree.append(row, label)
    let mut cell: usize = 0
    while self.cells && cell < 3 {
      let child = run self.fixture.tree.box(&[css.width(px(40.0)), css.height(px(24.0))])
      if self.sheet {
        run self.fixture.tree.setAttribute(child, Attribute.ClassName { value: run String.copy(CELLS[cell]) })
      } else if cell == 0 {
        run self.fixture.tree.setStyle(child, &[css.display(Keyword.Flex), css.alignItems(Align.Center), css.gap(px(8.0))])
      } else if cell == 1 {
        run self.fixture.tree.setStyle(child, &[css.padding(px(8.0)), css.borderRadius(px(8.0))])
      } else {
        run self.fixture.tree.setStyle(child, &[css.display(Keyword.Flex), css.flexDirection(FlexDirection.Column), css.padding(px(8.0))])
      }
      if cell == 0 {
        if self.step == Step.FocusWithin { run self.fixture.tree.setAttribute(child, Attribute.TabIndex { value: 0 }) }
        run self.leads.append(child)
      }
      run self.fixture.tree.append(row, child)
      cell = cell + 1
    }
    run self.fixture.tree.append(self.fixture.root, row)
    run self.rows.append(row)
  }

  effect fn verify(self: &Self) -> () ! TreeError {
    let engine = self.fixture.tree.engine()
    let count = self.rows.length()
    // The rows a sibling or index rule tells apart: both ends and their neighbours.
    let checked: [usize; 5] = [0, 1, 2, count - 2, count - 1]
    let mut at: usize = 0
    while at < checked.length {
      let i = checked[at]
      at = at + 1
      if i >= count { continue }
      let node = engine.node(engine.slotOf(self.rows.asSlice()[i].id().raw()))
      let padded = (self.changed && self.step == Step.Class && i == 0) || (self.distinct && i % 2 == 1)
      let dark = self.changed && self.step == Step.Theme
      let hovered = self.changed && self.step == Step.Hover && i == 0
      let background: f32 = match node.computed().paint.background { Fill.Solid { color } => color.r _ => -1.0 }
      let expectedPadding: f32 = if padded { 16.0 } else { 8.0 }
      let expectedColor: f32 = if dark { 1.0 } else { 0.0 }
      let expectedBackground: f32 = if dark || hovered || (self.mode == Mode.Zebra && i % 2 == 1) { 0.0 } else { 1.0 }
      let expectedTop: f32 = if self.mode == Mode.Owl && i != 0 { 8.0 } else { 0.0 }
      let spaced = self.mode == Mode.SpaceY && i != count - 1
      let expectedBottom: f32 = if spaced { 8.0 } else { 0.0 }
      let expectedRule: f32 = if spaced { 1.0 } else { 0.0 }
      if node.computed().layout.width.value != 240.0 || node.computed().layout.height.value != 40.0
        || node.computed().layout.rowGap.value != 8.0 || node.computed().layout.columnGap.value != 8.0
        || node.computed().layout.padding.left.value != expectedPadding
        || node.computed().layout.margin.top.value != expectedTop
        || node.computed().layout.margin.bottom.value != expectedBottom
        || node.computed().layout.border.bottom.value != expectedRule
        || background != expectedBackground
        || node.computed().text.color.r != expectedColor { fail TreeError.Layout }
    }
    let first = engine.node(engine.slotOf(self.rows.asSlice()[0].id().raw()))
    let faded = self.changed && (self.step == Step.Has || self.step == Step.FocusWithin || self.step == Step.Attribute || self.step == Step.Custom)
    let expectedOpacity: f32 = if faded { 0.5 } else { 1.0 }
    if extra(self.step).length != 0 && first.computed().paint.opacity != expectedOpacity { fail TreeError.Layout }
    if self.step == Step.Display && engine.node(engine.slotOf(self.leads.asSlice()[0].id().raw())).rendered == self.changed { fail TreeError.Layout }
  }
}

impl<'a> Bench for Rows<'a> {
  effect fn prepare(self: &mut Self) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    if self.step == Step.Create {
      while self.rows.length() != 0 {
        let last = self.rows.length() - 1
        run self.fixture.tree.destroy(self.rows.get(last))
        self.rows.truncate(last)
      }
      self.leads.clear()
    } else if self.rows.length() == 0 {
      run self.build()
      run self.fixture.frame()
      run self.verify()
    }
  }

  effect fn body(self: &mut Self) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    if self.step == Step.Create { run self.build() }
    else if self.step != Step.Idle {
      self.changed = !self.changed
      if self.step == Step.Class {
        let row = self.rows.get(0)
        if self.sheet {
          run self.fixture.tree.setAttribute(row, Attribute.ClassName { value: run String.copy(if self.changed { CHANGED } else { BASE }) })
        } else { run self.fixture.tree.setStyle(row, &[css.padding(px(if self.changed { 16.0 } else { 8.0 }))]) }
      } else if self.step == Step.Append {
        run self.row()
      } else if self.step == Step.Style {
        // The row's own style object changes; its classes, or its other inline values, stay.
        let opacity: f32 = if self.changed { 0.5 } else { 1.0 }
        let row = self.rows.get(0)
        if self.sheet {
          run self.fixture.tree.setStyle(row, &[
            css.width(px(240.0)), css.height(px(40.0)), css.flexShrink(0.0), css.boxSizing(BoxSizing.BorderBox), css.opacity(opacity),
          ])
        } else {
          run self.fixture.tree.setStyle(row, &[
            css.width(px(240.0)), css.height(px(40.0)), css.flexShrink(0.0), css.boxSizing(BoxSizing.BorderBox),
            css.display(Keyword.Flex), css.alignItems(Align.Center), css.gap(px(8.0)), css.padding(px(8.0)),
            css.borderRadius(px(8.0)), css.backgroundColor(color(true)), css.color(color(false)), css.opacity(opacity),
          ])
        }
      } else if self.step == Step.Has || self.step == Step.Display {
        let added = if self.step == Step.Has { "flex items-center gap-2 picked" } else { "flex items-center gap-2 gone" }
        run self.fixture.tree.setAttribute(self.leads.get(0), Attribute.ClassName { value: run String.copy(if self.changed { added } else { CELLS[0] }) })
      } else if self.step == Step.FocusWithin {
        // Focus goes between the first row and the second; the first row holds it when `changed`.
        run self.fixture.tree.focus(self.leads.get(if self.changed { 0 } else { 1 }))
      } else if self.step == Step.Attribute {
        run self.fixture.tree.setAttribute(self.rows.get(0), Attribute.Selected { value: self.changed })
      } else if self.step == Step.Custom {
        let mut batch = Batch.make()
        run batch.customProperty(self.rows.get(0).id().raw(), StyleState.Base, "--row-opacity", Option<string>.some(if self.changed { "0.5" } else { "1" }), false)
        run Effect.catch<ProtocolError>(self.fixture.tree.apply(run batch.take()), protocol)
      } else if self.step == Step.Hover {
        run self.fixture.tree.dispatch(Input.moveTo(if self.changed { 20.0 } else { 1100.0 }, 20.0))
      } else if self.sheet {
        run self.fixture.tree.setAttribute(self.fixture.root, Attribute.ClassName { value: run String.copy(rootClasses(self.mode, self.changed)) })
      } else {
        let mut i: usize = 0
        while i < self.rows.length() {
          run self.fixture.tree.setStyle(self.rows.get(i), &[css.backgroundColor(color(!self.changed)), css.color(color(self.changed))])
          i = i + 1
        }
      }
    }
    run self.fixture.frame()
    run self.verify()
  }
}
