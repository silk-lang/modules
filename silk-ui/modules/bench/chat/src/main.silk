//! The first layout of xbench's chat scene (`chat-1000`, silk-ui/xbench/apps/react/web/src/Chat.tsx)
//! on the real ui-tree, headless: the scene's nodes and classes (fixtures/chat.tree), its
//! stylesheet (fixtures/chat.sheet: xbench's bench.css + chat.css), Inter and JetBrains Mono, a
//! 1040 x 720 viewport. It times style resolution and layout, and the time layout spends inside
//! the text provider (`TextMeasure.analyze` and `TextMeasure.shape` of ui-text's `TextSystem`),
//! and prints a checksum of every text fragment and its glyphs.
//!
//! ```text
//! ui-bench-chat [--runs N] [--no-timing] [--paint] [--fresh] [--fonts DIR]
//! ```
//!
//! Each run makes a new font collection, tree and text system, so every run is a first layout
//! with cold text caches. With `--runs N` it prints each run and the medians. `--no-timing`
//! leaves the text system's clock off (no `text_ms`; `layout_ms` then has no clock reads in
//! it). `--paint` also times the paint of the first frame after layout. `--fresh` shapes every
//! segment instead of taking glyphs from segments shaped before (`Shaping.reuse` off): the
//! checksum must not change. Fonts are read from
//! `DIR` (default `silk-ui/xbench/assets/fonts`, from the repository root). See README.md.
import ui_tree.lib { Tree, TreeError, Viewport, BoxNode, Attribute, ProtocolError }
import ui_tree.batch { Batch }
import ui_tree.engine { TreeError as RawError }
import ui_text.system { TextSystem }
import font_collection.lib { FontCollection }
import layout.lib { LayoutTree, FragmentKind }
import silk.build.source { Source }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.text.format { Format, ParseError }
import silk.text.string { String, InvalidUtf8 }
import silk.time.mark { Mark }
import silk.platform.native.clock { NativeClock }
import silk.num.f32
import silk.num.i64
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

pub struct InputError {}

const WIDTH: f32 = 1040.0
const HEIGHT: f32 = 720.0

/// The font files of xbench's `@font-face` rules (style/bench.css).
const FONTS: [string; 4] = ["Inter-Regular.ttf", "Inter-Bold.ttf", "Inter-Italic.ttf", "JetBrainsMono-Regular.ttf"]

struct Settings {
  runs: usize,
  timing: bool,
  paint: bool,
  fresh: bool,
}

impl Copy for Settings {}

/// What one run measured and counted.
struct Sample {
  styleNanos: i64,
  layoutNanos: i64,
  paintNanos: i64,
  analyzeNanos: u64,
  shapeNanos: u64,
  nodes: usize,
  texts: usize,
  analyzeCalls: usize,
  shapeCalls: usize,
  lineHits: usize,
  shapeTokens: usize,
  /// Lines that took ui-text's plain-word runs, and the runs it found kept or shaped.
  plainLines: usize,
  plainHits: usize,
  plainMisses: usize,
  /// Calls the shaper itself answered.
  shaperCalls: usize,
  shapeCallsAfterPaint: usize,
  fragments: usize,
  glyphs: usize,
  runs: usize,
  checksum: u64,
  /// Glyphs drawn from each face, in the order of `FONTS` (one face each); the last slot
  /// counts any other face.
  faceGlyphs: [usize; 5],
}

impl Copy for Sample {}

fn nanos(at: &Mark) -> i64 {
  return at.*.seconds() * 1000000000 + u32.toI64(at.*.subsecondNanoseconds())
}

fn mix(hash: u64, value: u64) -> u64 {
  return u64.wrappingMultiply(hash ^ value, 1099511628211)
}

effect fn readFile(name: string) -> Bytes
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator | &mut HostInput {
  let cwd = run HostInput.workingDirectory()
  let base = run Path.fromBytes(Bytes.asSlice(&cwd))
  let path = if String.startsWith(name, "/") {
    run Path.fromBytes(String.utf8Bytes(name))
  } else {
    run Path.resolve(&base, name)
  }
  let mut files = run MachineFileSystem.make()
  return run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
}

effect fn protocol(error: ProtocolError) -> never ! TreeError { fail error.error }

effect fn raw(error: RawError) -> never ! TreeError { fail TreeError.lift(error) }

/// Makes the nodes of `data` (fixtures/chat.tree, see scripts/generate.mjs) and returns the
/// root and the number of text nodes. Each box takes its class names as React's `className`
/// sets them; an `<img>` is a leaf box (its size is the stylesheet's, 480 x 270).
effect fn build(tree: &mut Tree<'_>, data: &[u8], texts: &mut usize) -> BoxNode
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut stack = List<BoxNode>.make()
  let mut root = Option<BoxNode>.None
  let mut at: usize = 0
  while at < data.length {
    let mut end = at
    while end < data.length && data[end] != 10 {
      end = end + 1
    }
    let kind = data[at]
    let payload = unsafe String.fromUtf8Unchecked(Slice.view(data, at + 1, end - at - 1))
    if kind == 66 || kind == 73 {
      // B: a box that the next lines fill until its E; I: an image, a leaf.
      let node = run tree.box(&[])
      if String.byteLength(payload) != 0 {
        run tree.setAttribute(node, Attribute.ClassName { value: run String.copy(payload) })
      }
      if stack.length() != 0 {
        run tree.append(stack.get(stack.length() - 1), node)
      } else {
        root = Option<BoxNode>.Some { value: node }
      }
      if kind == 66 {
        run stack.append(node)
      }
    } else if kind == 84 {
      let node = run tree.text(payload)
      run tree.append(stack.get(stack.length() - 1), node)
      texts.* = texts.* + 1
    } else if kind == 69 {
      drop stack.pop()
    }
    at = end + 1
  }
  return match root {
    Option<BoxNode>.Some { value } => value
    _ => {
      fail TreeError.Layout
    }
  }
}

/// A hash of every text fragment's run (source range, place, size, bidi level, face) and its
/// glyphs (id, cluster, x, y, advance), in fragment order: a change that keeps the output
/// keeps the checksum.
fn checksum<'a>(output: &LayoutTree, system: &TextSystem<'a>, glyphs: &mut usize, fragmentCount: &mut usize, faces: &mut [usize; 5]) -> u64 {
  let mut hash: u64 = 14695981039346656037
  let fragments = output.fragments.values.asSlice()
  let mut index: usize = 0
  while index < fragments.length {
    let fragment = &fragments[index]
    if fragment.kind == FragmentKind.Text && fragment.textData != usize.MAX {
      let mut runs = output.fragments.textRuns(index)
      while runs.next() {
        let data = runs.current
        fragmentCount.* = fragmentCount.* + 1
        hash = mix(hash, usize.toU64(data.sourceStart))
        hash = mix(hash, usize.toU64(data.sourceEnd))
        hash = mix(hash, u32.toU64(f32.toBits(data.location.x)))
        hash = mix(hash, u32.toU64(f32.toBits(data.location.y)))
        hash = mix(hash, u32.toU64(f32.toBits(data.size.width)))
        hash = mix(hash, u32.toU64(f32.toBits(data.size.height)))
        hash = mix(hash, u8.toU64(data.bidiLevel))
        if data.shapeKey < system.glyphs.length() {
          let run_ = system.glyphRun(data.shapeKey)
          hash = mix(hash, usize.toU64(run_.face))
          let shaped = system.runGlyphs(data.shapeKey)
          glyphs.* = glyphs.* + shaped.length
          let slot = if run_.face < 4 { run_.face } else { 4 }
          faces[slot] = faces[slot] + shaped.length
          let mut g: usize = 0
          while g < shaped.length {
            hash = mix(hash, u32.toU64(shaped[g].glyph))
            hash = mix(hash, u32.toU64(shaped[g].cluster))
            hash = mix(hash, u32.toU64(f32.toBits(shaped[g].x)))
            hash = mix(hash, u32.toU64(f32.toBits(shaped[g].y)))
            hash = mix(hash, u32.toU64(f32.toBits(shaped[g].advance)))
            g = g + 1
          }
        }
      }
    }
    index = index + 1
  }
  return hash
}

/// One first layout, on a new font collection, tree and text system.
effect fn firstLayout(fontData: &[Bytes], settings: Settings) -> Sample
  ! TreeError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock {
  let mut fonts = FontCollection.make()
  let mut f: usize = 0
  while f < fontData.length {
    drop run fonts.add(run Bytes.copy(fontData[f].asSlice()))
    f = f + 1
  }
  let mut tree = run Tree.make(&fonts)
  let viewport = Viewport { width: WIDTH, height: HEIGHT, scale: 1.0 }
  // The window's size, given by an empty first frame.
  let first = run tree.box(&[])
  run tree.setRoot(first)
  drop run tree.frame(viewport, 0.0)
  tree.clearUploads()

  let mut batch = Batch.make()
  run batch.adoptStyleSheet(0, 1, Source.read("fixtures/chat.sheet"))
  run Effect.catch<ProtocolError>(tree.apply(run batch.take()), protocol)
  let mut texts: usize = 0
  let root = run build(&mut tree, Source.read("fixtures/chat.tree"), &mut texts)
  run tree.setRoot(root)
  let setup = tree.engineMut()
  setup.provider.text.shaping.reuse = !settings.fresh
  // The provider times every analyze and shape call; only this layout's are wanted.
  setup.provider.resetTimers()

  let start = run MonotonicClock.now()
  run Effect.catch<RawError>(tree.engineMut().stylesNow(), raw)
  let styled = run MonotonicClock.now()
  run tree.layoutNow()
  let laidOut = run MonotonicClock.now()

  let engine = tree.engine()
  let provider = &engine.provider
  let system = &engine.provider.text
  let mut glyphs: usize = 0
  let mut fragments: usize = 0
  let mut faces: [usize; 5] = [0; 5]
  let hash = checksum(&engine.output, system, &mut glyphs, &mut fragments, &mut faces)
  let mut sample = Sample {
    styleNanos: nanos(&styled) - nanos(&start),
    layoutNanos: nanos(&laidOut) - nanos(&styled),
    paintNanos: 0,
    analyzeNanos: provider.analyzeNs,
    shapeNanos: provider.shapeNs,
    nodes: tree.nodeCount() - 1,
    texts: texts,
    analyzeCalls: system.analyzeCalls,
    shapeCalls: system.shapeCalls,
    lineHits: system.lineHits,
    shapeTokens: system.shapeTokens,
    plainLines: system.shaping.plain.lines,
    plainHits: system.shaping.plain.hits,
    plainMisses: system.shaping.plain.misses,
    shaperCalls: system.fonts.shaperCalls,
    shapeCallsAfterPaint: system.shapeCalls,
    fragments: fragments,
    glyphs: glyphs,
    runs: system.glyphs.length(),
    checksum: hash,
    faceGlyphs: faces,
  }
  if settings.paint {
    let before = run MonotonicClock.now()
    drop run tree.frame(viewport, 0.016)
    let painted = run MonotonicClock.now()
    tree.clearUploads()
    sample.paintNanos = nanos(&painted) - nanos(&before)
    sample.shapeCallsAfterPaint = tree.engine().provider.text.shapeCalls
  }
  return sample
}

/// The cost of one read of the clock the text provider's timing uses, in nanoseconds: each
/// timed `analyze` or `shape` call carries about one read inside its interval.
effect fn clockRead() -> f64 {
  let count: i64 = 200000
  let start = run NativeClock.now()
  let mut i: i64 = 0
  while i < count {
    drop run NativeClock.now()
    i = i + 1
  }
  let end = run NativeClock.now()
  return i64.toF64(nanos(&end) - nanos(&start)) / i64.toF64(count)
}

fn ms(nanos: i64) -> f64 {
  return i64.toF64(nanos) / 1000000.0
}

effect fn timings(sample: &Sample, settings: Settings) -> () ! WriterError ? &mut Writer {
  run Format.format("style_ms {style:.3}  layout_ms {layout:.3}  style+layout_ms {both:.3}", &.{
    style: ms(sample.styleNanos), layout: ms(sample.layoutNanos), both: ms(sample.styleNanos + sample.layoutNanos),
  })
  if settings.timing {
    run Format.format("  text_ms {text:.3} (analyze {analyze:.3}, shape {shape:.3})", &.{
      text: ms(u64.toI64(sample.analyzeNanos + sample.shapeNanos)),
      analyze: ms(u64.toI64(sample.analyzeNanos)),
      shape: ms(u64.toI64(sample.shapeNanos)),
    })
  }
  if settings.paint {
    run Format.format("  paint_ms {paint:.3}", &.{ paint: ms(sample.paintNanos) })
  }
  run Writer.writeString("\n")
}

fn medianI64(values: &mut List<i64>) -> i64 {
  // Insertion sort: a handful of runs.
  let items = values.asMutSlice()
  let mut i: usize = 1
  while i < items.length {
    let value = items[i]
    let mut j = i
    while j > 0 && items[j - 1] > value {
      items[j] = items[j - 1]
      j = j - 1
    }
    items[j] = value
    i = i + 1
  }
  let n = items.length
  if n % 2 == 1 { return items[n / 2] }
  return (items[n / 2 - 1] + items[n / 2]) / 2
}

effect fn execute(args: &[String]) -> ()
  ! OutOfMemoryError | InputError | FileError | HostInputError | TreeError | WriterError
  ? &mut Allocator | &mut Writer | &mut MonotonicClock | &mut HostInput {
  let mut settings = Settings { runs: 1, timing: true, paint: false, fresh: false }
  let fallback = run String.copy("silk-ui/xbench/assets/fonts")
  let mut fontDir = fallback.view()
  let mut i: usize = 0
  while i < args.length {
    let arg = args[i].view()
    if arg == "--runs" && i + 1 < args.length {
      settings.runs = match usize.parse(args[i + 1].view()) {
        Result<usize, ParseError>.Success { value } => value
        _ => {
          fail InputError {}
        }
      }
      i = i + 1
    } else if arg == "--fonts" && i + 1 < args.length {
      fontDir = args[i + 1].view()
      i = i + 1
    } else if arg == "--no-timing" {
      settings.timing = false
    } else if arg == "--paint" {
      settings.paint = true
    } else if arg == "--fresh" {
      settings.fresh = true
    } else {
      fail InputError {}
    }
    i = i + 1
  }
  if settings.runs == 0 {
    fail InputError {}
  }
  let mut fontData = List<Bytes>.make()
  let mut f: usize = 0
  while f < FONTS.length {
    let mut path = run String.copy(fontDir)
    run path.append("/")
    run path.append(FONTS[f])
    run fontData.append(run readFile(path.view()))
    f = f + 1
  }

  let mut styles = List<i64>.make()
  let mut layouts = List<i64>.make()
  let mut both = List<i64>.make()
  let mut texts = List<i64>.make()
  let mut analyzes = List<i64>.make()
  let mut shapes = List<i64>.make()
  let mut paints = List<i64>.make()
  let mut last = Option<Sample>.None
  let mut same = true
  let mut r: usize = 0
  while r < settings.runs {
    let sample = run firstLayout(fontData.asSlice(), settings)
    if let Option<Sample>.Some { value: previous } = last {
      same = same && previous.checksum == sample.checksum && previous.shapeCalls == sample.shapeCalls
    }
    run Format.format("run {n}: ", &.{ n: r + 1 })
    run timings(&sample, settings)
    run styles.append(sample.styleNanos)
    run layouts.append(sample.layoutNanos)
    run both.append(sample.styleNanos + sample.layoutNanos)
    run texts.append(u64.toI64(sample.analyzeNanos + sample.shapeNanos))
    run analyzes.append(u64.toI64(sample.analyzeNanos))
    run shapes.append(u64.toI64(sample.shapeNanos))
    run paints.append(sample.paintNanos)
    last = Option<Sample>.Some { value: sample }
    r = r + 1
  }
  let sample = match last {
    Option<Sample>.Some { value } => value
    _ => {
      fail InputError {}
    }
  }
  if settings.runs > 1 {
    let median = Sample {
      styleNanos: medianI64(&mut styles),
      layoutNanos: medianI64(&mut layouts),
      paintNanos: medianI64(&mut paints),
      analyzeNanos: i64.toU64(medianI64(&mut analyzes)),
      shapeNanos: i64.toU64(medianI64(&mut shapes)),
      nodes: sample.nodes,
      texts: sample.texts,
      analyzeCalls: sample.analyzeCalls,
      shapeCalls: sample.shapeCalls,
      lineHits: sample.lineHits,
      shapeTokens: sample.shapeTokens,
      plainLines: sample.plainLines,
      plainHits: sample.plainHits,
      plainMisses: sample.plainMisses,
      shaperCalls: sample.shaperCalls,
      shapeCallsAfterPaint: sample.shapeCallsAfterPaint,
      fragments: sample.fragments,
      glyphs: sample.glyphs,
      runs: sample.runs,
      checksum: sample.checksum,
      faceGlyphs: sample.faceGlyphs,
    }
    run Format.format("median of {n}: ", &.{ n: settings.runs })
    run timings(&median, settings)
    run Format.format("  (median style+layout_ms {both:.3}", &.{ both: ms(medianI64(&mut both)) })
    if settings.timing {
      run Format.format(", median text_ms {text:.3}", &.{ text: ms(medianI64(&mut texts)) })
    }
    run Writer.writeString(")\n")
  }
  run Format.format(
    "ui_nodes {nodes} text_nodes {texts} analyze_calls {analyze} shape_calls {shape} line_cache_hits {hits} shape_tokens {tokens} text_fragments {fragments} glyphs {glyphs} glyph_runs {runs}\n",
    &.{
      nodes: sample.nodes,
      texts: sample.texts,
      analyze: sample.analyzeCalls,
      shape: sample.shapeCalls,
      hits: sample.lineHits,
      tokens: sample.shapeTokens,
      fragments: sample.fragments,
      glyphs: sample.glyphs,
      runs: sample.runs,
    },
  )
  run Format.format("plain_lines {lines} plain_hits {hits} plain_misses {misses} shaper_calls {shaper}\n", &.{
    lines: sample.plainLines, hits: sample.plainHits, misses: sample.plainMisses, shaper: sample.shaperCalls,
  })
  if settings.timing {
    let read = run clockRead()
    run Format.format("clock read {read:.1} ns: about {over:.3} ms of text_ms is the clock ({calls} timed calls)\n", &.{
      read: read, over: read * usize.toF64(sample.analyzeCalls + sample.shapeCalls) / 1000000.0, calls: sample.analyzeCalls + sample.shapeCalls,
    })
  }
  if settings.paint {
    run Format.format("shape_calls after paint {calls}\n", &.{ calls: sample.shapeCallsAfterPaint })
  }
  run Format.format("glyphs by face: {r} {regular}, {b} {bold}, {i} {italic}, {m} {mono}, other faces {other}\n", &.{
    r: FONTS[0], regular: sample.faceGlyphs[0], b: FONTS[1], bold: sample.faceGlyphs[1],
    i: FONTS[2], italic: sample.faceGlyphs[2], m: FONTS[3], mono: sample.faceGlyphs[3], other: sample.faceGlyphs[4],
  })
  run Format.format("checksum {hash:#018x}\n", &.{ hash: sample.checksum })
  if !same {
    run Writer.writeString("WARNING: the runs differ in checksum or shape calls\n")
  }
}

effect fn application() -> i32
  ! OutOfMemoryError | InputError | FileError | HostInputError | TreeError | WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut stdout = StdoutWriter.make()
  let mut clock = OsMonotonicClock.make()
  let mut args = List<String>.make()
  let count = run HostInput.argumentCount()
  let mut index: usize = 1
  while index < count {
    if let Option<Bytes>.Some { value: raw } = run HostInput.argument(index)
      |> Effect.provideMut<Allocator>(&mut allocator) {
      if let Result<String, InvalidUtf8>.Success { value } = move String.fromBytes(move raw) {
        run args.append(move value) |> Effect.provideMut<Allocator>(&mut allocator)
      }
    }
    index = index + 1
  }
  run execute(args.asSlice())
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<Writer>(&mut stdout)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  return 0
}

effect fn failed(error: OutOfMemoryError | InputError | FileError | HostInputError | TreeError | WriterError) -> i32 {
  drop error
  let mut stderr = StderrWriter.make()
  let written = run Writer.writeString("ui-bench-chat: usage: ui-bench-chat [--runs N] [--no-timing] [--paint] [--fresh] [--fonts DIR] (run from the repository root, or pass --fonts); or the run failed\n")
    |> Effect.provideMut<Writer>(&mut stderr)
    |> Effect.result
  drop written
  return 1
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run application() |> Effect.catchAll(failed)
}
