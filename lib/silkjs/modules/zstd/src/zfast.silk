//! The `fast` block compressor: a port of `lib/compress/zstd_fast.c` of Zstandard 1.5.7
//! (`ZSTD_fillHashTable`, `ZSTD_compressBlock_fast`, `ZSTD_compressBlock_fast_extDict`).
//!
//! # The block compressor signature
//! Every block compressor of the package has the signature of `ZSTD_BlockCompressor_f`:
//! `unsafe fn(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8,
//! srcSize: usize) -> usize`. `rep` is the array of 3 `u32` repeat offsets, read at entry and
//! written at exit. It stores sequences in `seqStore` and returns the number of bytes at the end
//! of the block that no sequence covers (the last literals), which the caller stores.
//! Positions in the block are indices from `ms.window.base`.
import mem
import cstate
import cstate { MatchState, SeqStore }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.mem.pointer { Pointer }

/// `ZSTD_dtlm_fast`: when loading a dictionary, insert one position out of three.
pub const DTLM_FAST: u32 = 0
/// `ZSTD_dtlm_full`: insert every position.
pub const DTLM_FULL: u32 = 1

/// `ZSTD_fillHashTable` for a context (`ZSTD_tfp_forCCtx`): inserts the positions from
/// `ms.nextToUpdate` to `end` (a pointer) into the hash table.
pub unsafe fn fillHashTable(ms: &mut MatchState, end: [*]const u8, dtlm: u32) -> () {
  let hashTable = ms.hashTable
  let hBits = ms.cParams.hashLog
  let mls = ms.cParams.minMatch
  let base = ms.window.base
  let mut ip = mem.z(ms.nextToUpdate)
  // The reference compares pointers: with fewer than 8 bytes after the base, `end - 8` is
  // before every position and nothing is inserted. As an index it would wrap.
  if mem.us(mem.addr(end), mem.addr(base)) < 8 { return () }
  let iend = mem.us(mem.us(mem.addr(end), mem.addr(base)), 8)
  // Always insert every fastHashFillStep position; insert the others only if their slot is empty.
  while mem.ua(ip, 3) < mem.ua(iend, 2) {
    let curr = mem.t32(ip)
    let hash0 = unsafe cstate.hashPtr(base, ip, hBits, mls)
    unsafe cstate.tset(hashTable, hash0, curr)
    if dtlm != DTLM_FAST {
      let mut p: u32 = 1
      while p < 3 {
        let hash = unsafe cstate.hashPtr(base, mem.ua(ip, mem.z(p)), hBits, mls)
        if unsafe cstate.tget(hashTable, hash) == 0 { unsafe cstate.tset(hashTable, hash, mem.a32(curr, p)) }
        p = p + 1
      }
    }
    ip = mem.ua(ip, 3)
  }
}

// `ZSTD_compressBlock_fast_noDict_generic`.
@inlineAlways
unsafe fn fastNoDictGeneric(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize, mls: u32) -> usize {
  let hashTable = ms.hashTable
  let hlog = ms.cParams.hashLog
  let targetLength = ms.cParams.targetLength
  let stepExtra: usize = if targetLength == 0 { 2 } else { 1 }
  let stepSize: usize = mem.z(targetLength) + stepExtra
  let base = ms.window.base
  let istart = mem.us(mem.addr(src), mem.addr(base))
  let endIndex = mem.t32(mem.ua(istart, srcSize))
  let prefixStartIndex = cstate.getLowestPrefixIndex(&ms, endIndex, ms.cParams.windowLog)
  let prefixStart = mem.z(prefixStartIndex)
  let iend = mem.ua(istart, srcSize)
  let ilimit = mem.us(iend, 8)
  let mut anchor = istart
  let mut ip0 = istart
  let mut repOffset1 = unsafe mem.r32(unsafe mem.ro(rep), 0)
  let mut repOffset2 = unsafe mem.r32(unsafe mem.ro(rep), 4)
  let mut offsetSaved1: u32 = 0
  let mut offsetSaved2: u32 = 0
  let kStepIncr: usize = 128
  if ip0 == prefixStart { ip0 = mem.ua(ip0, 1) }
  let curr0 = mem.t32(ip0)
  let windowLow = cstate.getLowestPrefixIndex(&ms, curr0, ms.cParams.windowLog)
  let maxRep = mem.s32(curr0, windowLow)
  if repOffset2 > maxRep { offsetSaved2 = repOffset2 repOffset2 = 0 }
  if repOffset1 > maxRep { offsetSaved1 = repOffset1 repOffset1 = 0 }
  // Each turn of this loop is one `_start` of the reference.
  while true {
    let mut step = stepSize
    let mut nextStep = mem.ua(ip0, kStepIncr)
    let mut ip1 = mem.ua(ip0, 1)
    let mut ip2 = mem.ua(ip0, step)
    let mut ip3 = mem.ua(ip2, 1)
    if ip3 >= ilimit { break }
    let mut hash0 = unsafe cstate.hashPtr(base, ip0, hlog, mls)
    let mut hash1 = unsafe cstate.hashPtr(base, ip1, hlog, mls)
    let mut matchIdx = unsafe cstate.tget(hashTable, hash0)
    let mut current0: u32 = 0
    let mut offcode: u32 = 0
    let mut match0: usize = 0
    let mut mLength: usize = 0
    // 0: nothing found before the end of the block; 1: `_offset`; 2: `_match` (a repeat match).
    let mut found: u32 = 0
    while true {
      // `ip2 - repOffset1` is `ip2` itself when there is no repeat offset.
      let rval = unsafe mem.r32(base, mem.us(ip2, mem.z(repOffset1)))
      current0 = mem.t32(ip0)
      unsafe cstate.tset(hashTable, hash0, current0)
      // Check the repeat offset at ip[2].
      if unsafe mem.r32(base, ip2) == rval && repOffset1 > 0 {
        ip0 = ip2
        match0 = mem.us(ip0, mem.z(repOffset1))
        mLength = if unsafe mem.r8(base, mem.us(ip0, 1)) == unsafe mem.r8(base, mem.us(match0, 1)) { 1 } else { 0 }
        ip0 = mem.us(ip0, mLength)
        match0 = mem.us(match0, mLength)
        offcode = cstate.REPCODE1
        mLength = mem.ua(mLength, 4)
        // Write the next hash table entry: it is already calculated.
        unsafe cstate.tset(hashTable, hash1, mem.t32(ip1))
        found = 2
        break
      }
      if matchIdx >= prefixStartIndex && unsafe mem.r32(base, mem.z(matchIdx)) == unsafe mem.r32(base, ip0) {
        unsafe cstate.tset(hashTable, hash1, mem.t32(ip1))
        found = 1
        break
      }
      // Look up ip[1].
      matchIdx = unsafe cstate.tget(hashTable, hash1)
      hash0 = hash1
      hash1 = unsafe cstate.hashPtr(base, ip2, hlog, mls)
      ip0 = ip1
      ip1 = ip2
      ip2 = ip3
      current0 = mem.t32(ip0)
      unsafe cstate.tset(hashTable, hash0, current0)
      if matchIdx >= prefixStartIndex && unsafe mem.r32(base, mem.z(matchIdx)) == unsafe mem.r32(base, ip0) {
        // First match found: write the next entry only for small steps, where it helps ratio.
        if step <= 4 { unsafe cstate.tset(hashTable, hash1, mem.t32(ip1)) }
        found = 1
        break
      }
      matchIdx = unsafe cstate.tget(hashTable, hash1)
      hash0 = hash1
      hash1 = unsafe cstate.hashPtr(base, ip2, hlog, mls)
      ip0 = ip1
      ip1 = ip2
      ip2 = mem.ua(ip0, step)
      ip3 = mem.ua(ip1, step)
      if ip2 >= nextStep {
        step = mem.ua(step, 1)
        nextStep = mem.ua(nextStep, kStepIncr)
      }
      if ip3 >= ilimit { break }
    }
    if found == 0 { break }
    if found == 1 {
      // `_offset`: a match at `matchIdx`.
      match0 = mem.z(matchIdx)
      repOffset2 = repOffset1
      repOffset1 = mem.t32(mem.us(ip0, match0))
      offcode = cstate.offsetToOffBase(repOffset1)
      mLength = 4
      // Count the backwards match length.
      while ip0 > anchor && match0 > prefixStart && unsafe mem.r8(base, mem.us(ip0, 1)) == unsafe mem.r8(base, mem.us(match0, 1)) {
        ip0 = mem.us(ip0, 1)
        match0 = mem.us(match0, 1)
        mLength = mem.ua(mLength, 1)
      }
    }
    // `_match`: count the forward length.
    mLength = mem.ua(mLength, unsafe cstate.count(base, mem.ua(ip0, mLength), base, mem.ua(match0, mLength), iend))
    unsafe cstate.storeSeq(&mut seqStore, mem.us(ip0, anchor), base, anchor, iend, offcode, mLength)
    ip0 = mem.ua(ip0, mLength)
    anchor = ip0
    // Fill the table and check for an immediate repeat code.
    if ip0 <= ilimit {
      unsafe cstate.tset(hashTable, unsafe cstate.hashPtr(base, mem.z(current0) + 2, hlog, mls), mem.a32(current0, 2))
      unsafe cstate.tset(hashTable, unsafe cstate.hashPtr(base, mem.us(ip0, 2), hlog, mls), mem.t32(mem.us(ip0, 2)))
      if repOffset2 > 0 {
        while ip0 <= ilimit && unsafe mem.r32(base, ip0) == unsafe mem.r32(base, mem.us(ip0, mem.z(repOffset2))) {
          // Store the sequence.
          let rLength = mem.ua(unsafe cstate.count(base, mem.ua(ip0, 4), base, mem.us(mem.ua(ip0, 4), mem.z(repOffset2)), iend), 4)
          let tmpOff = repOffset2 repOffset2 = repOffset1 repOffset1 = tmpOff
          unsafe cstate.tset(hashTable, unsafe cstate.hashPtr(base, ip0, hlog, mls), mem.t32(ip0))
          ip0 = mem.ua(ip0, rLength)
          unsafe cstate.storeSeq(&mut seqStore, 0, base, anchor, iend, cstate.REPCODE1, rLength)
          anchor = ip0
        }
      }
    }
  }
  // `_cleanup`: when the repeat offsets were invalidated at the start and not replaced, restore
  // them for the next block. If only the first one was replaced, rotate the saved one.
  if offsetSaved1 != 0 && repOffset1 != 0 { offsetSaved2 = offsetSaved1 }
  unsafe mem.w32(rep, 0, if repOffset1 != 0 { repOffset1 } else { offsetSaved1 })
  unsafe mem.w32(rep, 4, if repOffset2 != 0 { repOffset2 } else { offsetSaved2 })
  // Return the last literals size.
  return mem.us(iend, anchor)
}

@inlineNever
unsafe fn fastNoDict4(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastNoDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 4) }
@inlineNever
unsafe fn fastNoDict5(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastNoDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 5) }
@inlineNever
unsafe fn fastNoDict6(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastNoDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 6) }
@inlineNever
unsafe fn fastNoDict7(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastNoDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 7) }

/// `ZSTD_compressBlock_fast`: the block compressor of `fast` without a dictionary.
pub unsafe fn compressBlockFast(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  let mml = ms.cParams.minMatch
  if mml == 5 { return unsafe fastNoDict5(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mml == 6 { return unsafe fastNoDict6(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mml == 7 { return unsafe fastNoDict7(&mut ms, &mut seqStore, rep, src, srcSize) }
  return unsafe fastNoDict4(&mut ms, &mut seqStore, rep, src, srcSize)
}

// `ZSTD_compressBlock_fast_extDict_generic`.
@inlineAlways
unsafe fn fastExtDictGeneric(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize, mls: u32) -> usize {
  let hashTable = ms.hashTable
  let hlog = ms.cParams.hashLog
  let targetLength = ms.cParams.targetLength
  let stepExtra: usize = if targetLength == 0 { 2 } else { 1 }
  let stepSize: usize = mem.z(targetLength) + stepExtra
  let base = ms.window.base
  let dictBase = ms.window.dictBase
  let istart = mem.us(mem.addr(src), mem.addr(base))
  let mut anchor = istart
  let endIndex = mem.t32(mem.ua(istart, srcSize))
  let lowLimit = cstate.getLowestMatchIndex(&ms, endIndex, ms.cParams.windowLog)
  let dictStartIndex = lowLimit
  let dictStart = mem.z(dictStartIndex)
  let dictLimit = ms.window.dictLimit
  let prefixStartIndex = if dictLimit < lowLimit { lowLimit } else { dictLimit }
  let prefixStart = mem.z(prefixStartIndex)
  let dictEnd = mem.z(prefixStartIndex)
  let iend = mem.ua(istart, srcSize)
  let ilimit = mem.us(iend, 8)
  let mut offset1 = unsafe mem.r32(unsafe mem.ro(rep), 0)
  let mut offset2 = unsafe mem.r32(unsafe mem.ro(rep), 4)
  let mut offsetSaved1: u32 = 0
  let mut offsetSaved2: u32 = 0
  let mut ip0 = istart
  let kStepIncr: usize = 128
  // Switch to the "regular" variant if the external dictionary is invalidated by the max distance.
  if prefixStartIndex == dictStartIndex { return unsafe compressBlockFast(&mut ms, &mut seqStore, rep, src, srcSize) }
  let curr0 = mem.t32(ip0)
  let maxRep = mem.s32(curr0, dictStartIndex)
  if offset2 >= maxRep { offsetSaved2 = offset2 offset2 = 0 }
  if offset1 >= maxRep { offsetSaved1 = offset1 offset1 = 0 }
  while true {
    let mut step = stepSize
    let mut nextStep = mem.ua(ip0, kStepIncr)
    let mut ip1 = mem.ua(ip0, 1)
    let mut ip2 = mem.ua(ip0, step)
    let mut ip3 = mem.ua(ip2, 1)
    if ip3 >= ilimit { break }
    let mut hash0 = unsafe cstate.hashPtr(base, ip0, hlog, mls)
    let mut hash1 = unsafe cstate.hashPtr(base, ip1, hlog, mls)
    let mut idx = unsafe cstate.tget(hashTable, hash0)
    let mut idxBase = if idx < prefixStartIndex { dictBase } else { base }
    let mut current0: u32 = 0
    let mut offcode: u32 = 0
    let mut match0: usize = 0
    let mut matchBase = base
    let mut mLength: usize = 0
    let mut matchEnd: usize = 0
    let mut found: u32 = 0
    while true {
      // Load the repeat offset match for ip[2].
      let current2 = mem.t32(ip2)
      let repIndex = mem.s32(current2, offset1)
      let repBase = if repIndex < prefixStartIndex { dictBase } else { base }
      let mut rval: u32 = 0
      if mem.s32(prefixStartIndex, repIndex) >= 4 && offset1 > 0 {
        rval = unsafe mem.r32(repBase, mem.z(repIndex))
      } else {
        rval = unsafe mem.r32(base, ip2) ^ 1
      }
      // Write back the hash table entry.
      current0 = mem.t32(ip0)
      unsafe cstate.tset(hashTable, hash0, current0)
      // Check the repeat offset at ip[2].
      if unsafe mem.r32(base, ip2) == rval {
        ip0 = ip2
        match0 = mem.z(repIndex)
        matchBase = repBase
        matchEnd = if repIndex < prefixStartIndex { dictEnd } else { iend }
        mLength = if unsafe mem.r8(base, mem.us(ip0, 1)) == unsafe mem.r8(matchBase, mem.us(match0, 1)) { 1 } else { 0 }
        ip0 = mem.us(ip0, mLength)
        match0 = mem.us(match0, mLength)
        offcode = cstate.REPCODE1
        mLength = mem.ua(mLength, 4)
        found = 2
        break
      }
      // Load the match for ip[0].
      if idx >= dictStartIndex && unsafe mem.r32(idxBase, mem.z(idx)) == unsafe mem.r32(base, ip0) {
        found = 1
        break
      }
      // Look up ip[1].
      idx = unsafe cstate.tget(hashTable, hash1)
      idxBase = if idx < prefixStartIndex { dictBase } else { base }
      hash0 = hash1
      hash1 = unsafe cstate.hashPtr(base, ip2, hlog, mls)
      ip0 = ip1
      ip1 = ip2
      ip2 = ip3
      current0 = mem.t32(ip0)
      unsafe cstate.tset(hashTable, hash0, current0)
      if idx >= dictStartIndex && unsafe mem.r32(idxBase, mem.z(idx)) == unsafe mem.r32(base, ip0) {
        found = 1
        break
      }
      idx = unsafe cstate.tget(hashTable, hash1)
      idxBase = if idx < prefixStartIndex { dictBase } else { base }
      hash0 = hash1
      hash1 = unsafe cstate.hashPtr(base, ip2, hlog, mls)
      ip0 = ip1
      ip1 = ip2
      ip2 = mem.ua(ip0, step)
      ip3 = mem.ua(ip1, step)
      if ip2 >= nextStep {
        step = mem.ua(step, 1)
        nextStep = mem.ua(nextStep, kStepIncr)
      }
      if ip3 >= ilimit { break }
    }
    if found == 0 { break }
    if found == 1 {
      // `_offset`: compute the offset code.
      let offset = mem.s32(current0, idx)
      let lowMatchPtr = if idx < prefixStartIndex { dictStart } else { prefixStart }
      matchEnd = if idx < prefixStartIndex { dictEnd } else { iend }
      match0 = mem.z(idx)
      matchBase = idxBase
      offset2 = offset1
      offset1 = offset
      offcode = cstate.offsetToOffBase(offset)
      mLength = 4
      // Count the backwards match length.
      while ip0 > anchor && match0 > lowMatchPtr && unsafe mem.r8(base, mem.us(ip0, 1)) == unsafe mem.r8(matchBase, mem.us(match0, 1)) {
        ip0 = mem.us(ip0, 1)
        match0 = mem.us(match0, 1)
        mLength = mem.ua(mLength, 1)
      }
    }
    // `_match`: count the forward length.
    mLength = mem.ua(mLength, unsafe cstate.count2segments(base, mem.ua(ip0, mLength), iend, matchBase, mem.ua(match0, mLength), matchEnd, prefixStart))
    unsafe cstate.storeSeq(&mut seqStore, mem.us(ip0, anchor), base, anchor, iend, offcode, mLength)
    ip0 = mem.ua(ip0, mLength)
    anchor = ip0
    // Write the next hash table entry.
    if ip1 < ip0 { unsafe cstate.tset(hashTable, hash1, mem.t32(ip1)) }
    // Fill the table and check for an immediate repeat code.
    if ip0 <= ilimit {
      unsafe cstate.tset(hashTable, unsafe cstate.hashPtr(base, mem.z(current0) + 2, hlog, mls), mem.a32(current0, 2))
      unsafe cstate.tset(hashTable, unsafe cstate.hashPtr(base, mem.us(ip0, 2), hlog, mls), mem.t32(mem.us(ip0, 2)))
      while ip0 <= ilimit {
        let repIndex2 = mem.s32(mem.t32(ip0), offset2)
        let repBase2 = if repIndex2 < prefixStartIndex { dictBase } else { base }
        if cstate.indexOverlapCheck(prefixStartIndex, repIndex2) && offset2 > 0 && unsafe mem.r32(repBase2, mem.z(repIndex2)) == unsafe mem.r32(base, ip0) {
          let repEnd2 = if repIndex2 < prefixStartIndex { dictEnd } else { iend }
          let repLength2 = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip0, 4), iend, repBase2, mem.z(repIndex2) + 4, repEnd2, prefixStart), 4)
          let tmpOffset = offset2 offset2 = offset1 offset1 = tmpOffset
          unsafe cstate.storeSeq(&mut seqStore, 0, base, anchor, iend, cstate.REPCODE1, repLength2)
          unsafe cstate.tset(hashTable, unsafe cstate.hashPtr(base, ip0, hlog, mls), mem.t32(ip0))
          ip0 = mem.ua(ip0, repLength2)
          anchor = ip0
        } else {
          break
        }
      }
    }
  }
  // `_cleanup`.
  if offsetSaved1 != 0 && offset1 != 0 { offsetSaved2 = offsetSaved1 }
  unsafe mem.w32(rep, 0, if offset1 != 0 { offset1 } else { offsetSaved1 })
  unsafe mem.w32(rep, 4, if offset2 != 0 { offset2 } else { offsetSaved2 })
  return mem.us(iend, anchor)
}

@inlineNever
unsafe fn fastExtDict4(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastExtDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 4) }
@inlineNever
unsafe fn fastExtDict5(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastExtDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 5) }
@inlineNever
unsafe fn fastExtDict6(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastExtDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 6) }
@inlineNever
unsafe fn fastExtDict7(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastExtDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 7) }

/// `ZSTD_compressBlock_fast_extDict`: the block compressor of `fast` when the window has an
/// external segment.
pub unsafe fn compressBlockFastExtDict(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  let mls = ms.cParams.minMatch
  if mls == 5 { return unsafe fastExtDict5(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mls == 6 { return unsafe fastExtDict6(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mls == 7 { return unsafe fastExtDict7(&mut ms, &mut seqStore, rep, src, srcSize) }
  return unsafe fastExtDict4(&mut ms, &mut seqStore, rep, src, srcSize)
}

// ---- `dictMatchState` (`ZSTD_compressBlock_fast_dictMatchState`): an attached CDict, whose
// hash table has short cache tags (`cdict.silk`). ----

/// The fields of an attached dictionary that the `dictMatchState` compressors read.
pub struct DmsView {
  pub hashTable: [*]mut u8,
  pub chainTable: [*]mut u8,
  pub hashLog: u32,
  pub chainLog: u32,
  /// `dms.window.base`.
  pub base: [*]const u8,
  /// `dms.window.dictLimit`.
  pub startIndex: u32,
  /// `dms.window.nextSrc - dms.window.base`.
  pub endIndex: usize,
}

/// Reads the attached dictionary of `ms`, which must have one.
pub unsafe fn dmsView(ms: &MatchState) -> DmsView {
  let anchor = ()
  let dms = unsafe Pointer.borrow<(), MatchState>(&anchor, unsafe Intrinsic.pointerRequalify<?*mut MatchState, *const MatchState>(ms.dictMatchState))
  return DmsView {
    hashTable: dms.hashTable, chainTable: dms.chainTable, hashLog: dms.cParams.hashLog, chainLog: dms.cParams.chainLog,
    base: dms.window.base, startIndex: dms.window.dictLimit, endIndex: mem.us(mem.addr(dms.window.nextSrc), mem.addr(dms.window.base)),
  }
}

// `ZSTD_compressBlock_fast_dictMatchState_generic`.
@inlineAlways
unsafe fn fastDmsGeneric(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize, mls: u32) -> usize {
  let hashTable = ms.hashTable
  let hlog = ms.cParams.hashLog
  let targetLength = ms.cParams.targetLength
  // Support a step size of 0.
  let stepSize: usize = if targetLength == 0 { 1 } else { mem.z(targetLength) }
  let base = ms.window.base
  let istart = mem.us(mem.addr(src), mem.addr(base))
  let mut ip0 = istart
  let mut ip1 = mem.ua(ip0, stepSize)
  let mut anchor = istart
  let prefixStartIndex = ms.window.dictLimit
  let prefixStart = mem.z(prefixStartIndex)
  let iend = mem.ua(istart, srcSize)
  let ilimit = mem.us(iend, cstate.HASH_READ_SIZE)
  let mut offset1 = unsafe mem.r32(unsafe mem.ro(rep), 0)
  let mut offset2 = unsafe mem.r32(unsafe mem.ro(rep), 4)
  let d = unsafe dmsView(&ms)
  let dictHashTable = d.hashTable
  let dictStartIndex = d.startIndex
  let dictBase = d.base
  let dictStart = mem.z(dictStartIndex)
  let dictEnd = d.endIndex
  let dictIndexDelta = mem.s32(prefixStartIndex, mem.t32(dictEnd))
  let dictAndPrefixLength = mem.t32(mem.ua(mem.us(istart, prefixStart), mem.us(dictEnd, dictStart)))
  let dictHBits = d.hashLog + 8
  let kStepIncr: usize = 256
  if dictAndPrefixLength == 0 { ip0 = mem.ua(ip0, 1) }
  // Outer search loop.
  while ip1 <= ilimit {
    let mut mLength: usize = 0
    let mut hash0 = unsafe cstate.hashPtr(base, ip0, hlog, mls)
    let dictHashAndTag0 = unsafe cstate.hashPtr(base, ip0, dictHBits, mls)
    let mut dictMatchIndexAndTag = unsafe cstate.tget(dictHashTable, usize.shiftRight(dictHashAndTag0, 8))
    let mut dictTagsMatch = (dictMatchIndexAndTag & 255) == (mem.t32(dictHashAndTag0) & 255)
    let mut matchIndex = unsafe cstate.tget(hashTable, hash0)
    let mut curr = mem.t32(ip0)
    let mut step = stepSize
    let mut nextStep = mem.ua(ip0, kStepIncr)
    let mut stop = false
    // Inner search loop.
    while true {
      let match_ = mem.z(matchIndex)
      let repIndex = mem.s32(mem.a32(curr, 1), offset1)
      let repInDict = repIndex < prefixStartIndex
      let repBase = if repInDict { dictBase } else { base }
      let repPos = if repInDict { mem.z(mem.s32(repIndex, dictIndexDelta)) } else { mem.z(repIndex) }
      let hash1 = unsafe cstate.hashPtr(base, ip1, hlog, mls)
      let dictHashAndTag1 = unsafe cstate.hashPtr(base, ip1, dictHBits, mls)
      // Update the hash table.
      unsafe cstate.tset(hashTable, hash0, curr)
      if cstate.indexOverlapCheck(prefixStartIndex, repIndex) && unsafe mem.r32(repBase, repPos) == unsafe mem.r32(base, mem.ua(ip0, 1)) {
        let repMatchEnd = if repInDict { dictEnd } else { iend }
        mLength = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip0, 5), iend, repBase, mem.ua(repPos, 4), repMatchEnd, prefixStart), 4)
        ip0 = mem.ua(ip0, 1)
        unsafe cstate.storeSeq(&mut seqStore, mem.us(ip0, anchor), base, anchor, iend, cstate.REPCODE1, mLength)
        break
      }
      if dictTagsMatch {
        // A possible match in the dictionary.
        let dictMatchIndex = mem.shr32(dictMatchIndexAndTag, 8)
        if dictMatchIndex > dictStartIndex && unsafe mem.r32(dictBase, mem.z(dictMatchIndex)) == unsafe mem.r32(base, ip0) {
          // As the extDict parser: use a dictionary match only when the regular one is invalid.
          if matchIndex <= prefixStartIndex {
            let offset = mem.s32(mem.s32(curr, dictMatchIndex), dictIndexDelta)
            let mut dictMatch = mem.z(dictMatchIndex)
            mLength = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip0, 4), iend, dictBase, mem.ua(dictMatch, 4), dictEnd, prefixStart), 4)
            // Catch up.
            while ip0 > anchor && dictMatch > dictStart && unsafe mem.r8(base, mem.us(ip0, 1)) == unsafe mem.r8(dictBase, mem.us(dictMatch, 1)) {
              ip0 = mem.us(ip0, 1) dictMatch = mem.us(dictMatch, 1) mLength = mem.ua(mLength, 1)
            }
            offset2 = offset1
            offset1 = offset
            unsafe cstate.storeSeq(&mut seqStore, mem.us(ip0, anchor), base, anchor, iend, cstate.offsetToOffBase(offset), mLength)
            break
          }
        }
      }
      if matchIndex >= prefixStartIndex && unsafe mem.r32(base, ip0) == unsafe mem.r32(base, match_) {
        // A regular match of 4 bytes or more.
        let offset = mem.t32(mem.us(ip0, match_))
        let mut m = match_
        mLength = mem.ua(unsafe cstate.count(base, mem.ua(ip0, 4), base, mem.ua(m, 4), iend), 4)
        // Catch up.
        while ip0 > anchor && m > prefixStart && unsafe mem.r8(base, mem.us(ip0, 1)) == unsafe mem.r8(base, mem.us(m, 1)) {
          ip0 = mem.us(ip0, 1) m = mem.us(m, 1) mLength = mem.ua(mLength, 1)
        }
        offset2 = offset1
        offset1 = offset
        unsafe cstate.storeSeq(&mut seqStore, mem.us(ip0, anchor), base, anchor, iend, cstate.offsetToOffBase(offset), mLength)
        break
      }
      // Prepare for the next iteration.
      dictMatchIndexAndTag = unsafe cstate.tget(dictHashTable, usize.shiftRight(dictHashAndTag1, 8))
      dictTagsMatch = (dictMatchIndexAndTag & 255) == (mem.t32(dictHashAndTag1) & 255)
      matchIndex = unsafe cstate.tget(hashTable, hash1)
      if ip1 >= nextStep {
        step = mem.ua(step, 1)
        nextStep = mem.ua(nextStep, kStepIncr)
      }
      ip0 = ip1
      ip1 = mem.ua(ip1, step)
      if ip1 > ilimit { stop = true break }
      curr = mem.t32(ip0)
      hash0 = hash1
    }
    if stop { break }
    // A match was found.
    ip0 = mem.ua(ip0, mLength)
    anchor = ip0
    if ip0 <= ilimit {
      // Fill the table.
      unsafe cstate.tset(hashTable, unsafe cstate.hashPtr(base, mem.ua(mem.z(curr), 2), hlog, mls), mem.a32(curr, 2))
      unsafe cstate.tset(hashTable, unsafe cstate.hashPtr(base, mem.us(ip0, 2), hlog, mls), mem.t32(mem.us(ip0, 2)))
      // Check for an immediate repeat code.
      while ip0 <= ilimit {
        let current2 = mem.t32(ip0)
        let repIndex2 = mem.s32(current2, offset2)
        let inDict2 = repIndex2 < prefixStartIndex
        let repBase2 = if inDict2 { dictBase } else { base }
        let repPos2 = if inDict2 { mem.z(mem.s32(repIndex2, dictIndexDelta)) } else { mem.z(repIndex2) }
        if cstate.indexOverlapCheck(prefixStartIndex, repIndex2) && unsafe mem.r32(repBase2, repPos2) == unsafe mem.r32(base, ip0) {
          let repEnd2 = if inDict2 { dictEnd } else { iend }
          let repLength2 = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip0, 4), iend, repBase2, mem.ua(repPos2, 4), repEnd2, prefixStart), 4)
          let tmpOffset = offset2 offset2 = offset1 offset1 = tmpOffset
          unsafe cstate.storeSeq(&mut seqStore, 0, base, anchor, iend, cstate.REPCODE1, repLength2)
          unsafe cstate.tset(hashTable, unsafe cstate.hashPtr(base, ip0, hlog, mls), current2)
          ip0 = mem.ua(ip0, repLength2)
          anchor = ip0
          continue
        }
        break
      }
    }
    ip1 = mem.ua(ip0, stepSize)
  }
  // Save the repeat offsets for the next block.
  unsafe mem.w32(rep, 0, offset1)
  unsafe mem.w32(rep, 4, offset2)
  return mem.us(iend, anchor)
}

@inlineNever
unsafe fn fastDms4(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 4) }
@inlineNever
unsafe fn fastDms5(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 5) }
@inlineNever
unsafe fn fastDms6(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 6) }
@inlineNever
unsafe fn fastDms7(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe fastDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 7) }

/// `ZSTD_compressBlock_fast_dictMatchState`: the block compressor of `fast` with an attached
/// dictionary.
pub unsafe fn compressBlockFastDictMatchState(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  let mls = ms.cParams.minMatch
  if mls == 5 { return unsafe fastDms5(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mls == 6 { return unsafe fastDms6(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mls == 7 { return unsafe fastDms7(&mut ms, &mut seqStore, rep, src, srcSize) }
  return unsafe fastDms4(&mut ms, &mut seqStore, rep, src, srcSize)
}
