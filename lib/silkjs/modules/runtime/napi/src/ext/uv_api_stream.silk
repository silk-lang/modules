/// libuv's uv_udp_open: SO_REUSEADDR (SO_REUSEPORT on macOS) on the socket.
pub export "C" fn uv_udp_open(udp: *mut u8, sock: i32) -> i32 { return unsafe uv_udp_open_ex(udp, sock, UV_UDP_REUSEADDR) }
