//! Multicolumn layout from CSS: column-count, column-gap and column-rule split a block's
//! content into balanced columns, text included, and the rule paints in each gap.
import ui_tree.lib { Tree, TreeError, Viewport, BoxNode }
import ui_tree.legacy { UiTree, Batch, FrameInput, CpuSnapshot, NodeKind, TreeError as UiTreeError }
import ui_fixtures.fixtures as fixtures
import svg_css.written as written
import svg_css.tokens { CssError }
import font_collection.lib { FontCollection }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u8
import silk.testing.testing { Testing, AssertionError }

effect fn styled(tree: &mut Tree<'_>, css: &[u8]) -> BoxNode
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let declarations = run written.declarations(css)
  return run tree.box(declarations.asSlice())
}

effect fn rect(tree: &Tree<'_>, node: BoxNode) -> Rect<f32>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match run tree.bounds(node) {
    Option.Some { value } => value
    Option.None => Rect<f32> { xMin: -1.0, yMin: -1.0, xMax: -1.0, yMax: -1.0 }
  }
}

effect fn textColumnsBody() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let root = run styled(&mut tree, b"width: 400px")
  let columns = run styled(&mut tree, b"width: 200px; column-count: 2; column-gap: 20px; line-height: 20px")
  let paragraph = run styled(&mut tree, b"")
  let text = run tree.text("one two three four five six seven eight nine ten eleven twelve")
  run tree.append(paragraph, text)
  run tree.append(columns, paragraph)
  run tree.append(root, columns)
  run tree.setRoot(root)
  drop run tree.frame(Viewport { width: 400.0, height: 300.0, scale: 1.0 }, 0.0)
  // One fragment per word; a line's first word starts at its column's left edge.
  let lines = run tree.fragments(text)
  let mut first: usize = 0
  let mut second: usize = 0
  let mut bottom: f32 = 0.0
  let slice = lines.asSlice()
  let mut i: usize = 0
  while i < slice.length {
    let border = slice[i].border
    if border.xMin == 0.0 { first = first + 1 }
    if border.xMin == 110.0 { second = second + 1 }
    if border.yMax > bottom { bottom = border.yMax }
    i = i + 1
  }
  run Testing.expect(first > 0 && second > 0, "the text's lines fill both columns")
  run Testing.expect(first == second || first == second + 1, "the columns balance")
  let bounds = run rect(&tree, columns)
  run Testing.expect(bounds.yMax - bounds.yMin == 80.0, "the container is as tall as its four line column")
  run Testing.expect(bottom < 90.0, "no line falls below it")
  let pieces = run tree.fragments(paragraph)
  run Testing.expect(pieces.length() == 2, "the paragraph breaks into one fragment per column")
  // In a column flex item of a row flex container, what follows sits below the columns.
  let mut nested = run Tree.make(&fonts)
  let page = run styled(&mut nested, b"display: flex; width: 400px")
  let side = run styled(&mut nested, b"display: flex; flex-direction: column; flex-grow: 1; flex-basis: 0; gap: 12px")
  let brief = run styled(&mut nested, b"column-count: 2; column-gap: 20px; line-height: 20px")
  let words = run nested.text("one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen twenty")
  run nested.append(brief, words)
  let tag = run styled(&mut nested, b"height: 10px")
  run nested.append(side, brief)
  run nested.append(side, tag)
  run nested.append(page, side)
  run nested.setRoot(page)
  drop run nested.frame(Viewport { width: 400.0, height: 300.0, scale: 1.0 }, 0.0)
  let briefRect = run rect(&nested, brief)
  let tagRect = run rect(&nested, tag)
  run Testing.expect(tagRect.yMin == briefRect.yMax + 12.0, "the next flex item follows the columns")
  run Testing.expect(briefRect.yMax - briefRect.yMin < 100.0, "the columns balance in a flex item")
}
test effect fn multicolTextFillsBalancedColumns() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run textColumnsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// A 100px wide two column container of four 20px blue boxes, styled with `css`, over white.
effect fn paint(collection: &FontCollection, css: &[u8]) -> Pixmap
  ! UiTreeError | CssError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  let page = run written.declarations(b"width: 100px; height: 100px; background-color: white")
  run batch.style(1, page.asSlice())
  let columns = run written.declarations(b"width: 100px; column-count: 2; column-gap: 20px")
  run batch.box(1, 2, columns.asSlice())
  let extra = run written.declarations(css)
  run batch.style(2, extra.asSlice())
  let item = run written.declarations(b"height: 20px; background-color: blue")
  let mut id: u32 = 3
  while id < 7 {
    run batch.box(2, id, item.asSlice())
    id = id + 1
  }
  run batch.root(1)
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 100.0, height: 100.0, scale: 1.0, time: 0.0 })
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  return run snapshot.render(&tree)
}

fn close(a: u8, b: i32) -> bool {
  let d = u8.toI32(a) - b
  return d <= 10 && d >= -10
}

fn at(pixels: &Pixmap, x: u32, y: u32, r: i32, g: i32, b: i32) -> bool {
  let c = pixels.pixel(x, y)
  return close(c.r, r) && close(c.g, g) && close(c.b, b)
}

effect fn rulesBody() -> ()
  ! UiTreeError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let plain = run paint(&collection, b"")
  run Testing.expect(at(&plain, 20, 10, 0, 0, 255), "the first column holds the first box")
  run Testing.expect(at(&plain, 70, 30, 0, 0, 255), "the second column holds the fourth box")
  run Testing.expect(at(&plain, 50, 10, 255, 255, 255), "the gap stays empty without a rule")
  run Testing.expect(at(&plain, 20, 50, 255, 255, 255), "two balanced columns are 40px tall")
  let ruled = run paint(&collection, b"column-rule: 4px solid red")
  run Testing.expect(at(&ruled, 50, 10, 255, 0, 0), "the rule sits in the middle of the gap")
  run Testing.expect(at(&ruled, 50, 35, 255, 0, 0), "it runs the columns' height")
  run Testing.expect(at(&ruled, 50, 45, 255, 255, 255), "and stops below them")
  run Testing.expect(at(&ruled, 45, 10, 255, 255, 255), "it is as wide as column-rule-width")
  let hidden = run paint(&collection, b"column-rule: 4px none red")
  run Testing.expect(at(&hidden, 50, 10, 255, 255, 255), "column-rule-style none draws nothing")
}
test effect fn multicolPaintsColumnRules() -> ()
  ! UiTreeError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rulesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
