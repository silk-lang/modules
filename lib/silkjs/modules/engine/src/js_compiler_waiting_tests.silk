import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_engine { Engine }
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_heap { HeapHeader }
import js_exceptions { JsException }
import js_value { ValueBits }
import js_owned_value { Value }
import js_realm { lendRealm }
import js_runtime as runtime
import js_gc as gc
import js_intrinsic_install as intrinsics
import native_stack as stack
import js_eval as eval
import js_eval_compile as flags
import js_eval_compile as compilerFinish
import js_debugger_execution_consumer { Services }

// A host finishes, while idle, the functions whose compile waits for a first call
// (waitingStubs, finishWaiting): they run the same afterwards, and none is left waiting.
test effect fn waitingStubsFinishWhileIdle() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: Services.make() }
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = run Effect.result(unsafe exercise(&mut engine, rt, context)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), OutOfMemoryError | JsException | AssertionError<'static>>.Success { value: _ } => ()
    Result<(), OutOfMemoryError | JsException | AssertionError<'static>>.Failure { error } => { fail move error }
  }
  run Testing.expect(memory.stats().allocationCount == 0 && memory.stats().usedBytes == 0, "finished stubs release all engine allocations")
}

unsafe effect fn number<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, source: &[u8]) -> i32
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory
  let bits = Value.intoBits(run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"waiting.js", flags.TYPE_GLOBAL))
  return match bits { ValueBits.Int { value } => value _ => -1 }
}

unsafe effect fn exercise<'m>(engine: &mut Engine<'m, Services>, rt: *mut HeapHeader, context: *mut HeapHeader) -> ()
  ! OutOfMemoryError | JsException | AssertionError<'static> ? &mut Allocator {
  let defined = run unsafe number(&mut engine, context,
    b"var base = 40; function add(a) { var step = 2; function inner(b) { return a + b + step - 2 } return inner(base) } var twice = (x) => x * 2; function never(q) { return q ? [q].map((v) => v + base) : null } 7")
  run Testing.expect(defined == 7, "the script ran")
  let mut stubs = List<*mut HeapHeader>.make()
  run unsafe compilerFinish.waitingStubs(rt, &mut stubs)
  let waiting = stubs.length()
  run Testing.expect(waiting >= 3, "the script's uncalled functions wait as stubs")
  // In two steps, as a host with a time budget takes them.
  let first = run unsafe compilerFinish.finishWaiting(&mut engine, rt, &mut stubs, 1)
  run Testing.expect(first == 1 && stubs.length() == waiting - 1, "a step takes what it was asked for")
  let rest = run unsafe compilerFinish.finishWaiting(&mut engine, rt, &mut stubs, waiting)
  run Testing.expect(rest == waiting - 1 && stubs.length() == 0, "the last step takes the rest")
  // add's inner function became a stub when add finished: one more round takes it.
  let mut round: usize = 0
  while round < 4 {
    run unsafe compilerFinish.waitingStubs(rt, &mut stubs)
    if stubs.length() == 0 { break }
    let count = stubs.length()
    drop run unsafe compilerFinish.finishWaiting(&mut engine, rt, &mut stubs, count)
    round = round + 1
  }
  run unsafe compilerFinish.waitingStubs(rt, &mut stubs)
  run Testing.expect(stubs.length() == 0, "no function waits after the rounds")
  let sum = run unsafe number(&mut engine, context, b"add(1) + twice(4) + never(2)[0]")
  run Testing.expect(sum == 41 + 8 + 42, "functions finished while idle run as written")
}
