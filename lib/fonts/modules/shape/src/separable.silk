//! Whether a glyph can take part in a font's layout across the glyphs around it, so that
//! shaping text that contains it may differ from shaping the pieces on either side of it on
//! their own. `spaceSeparable` asks this of the space glyph, to decide whether a text layer may
//! shape space-separated words one at a time and reuse the results.
//!
//! The answer is conservative: every lookup of GSUB and GPOS is read, whether or not a feature
//! enables it, and anything the scan does not understand (an unknown lookup type or subtable
//! format, a truncated array, a legacy `kern` or AAT table) counts as taking part. It is the
//! analogue of Blink's `HarfBuzzFace::HasSpaceInLigaturesOrKerning`, made stricter: class-based
//! rules count the glyph's class, class 0 included, and lookups that skip base glyphs count
//! whatever their coverage.
import view { View, valueSize }
import font { table }
import read_fonts.lib { FontRef }
import read_fonts.model.charmap { Charmap }
import font_types.lib { GlyphId }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.u16
import silk.num.u32
import silk.num.usize

/// `LayoutUse.lookup` when the reason is not a lookup.
pub const NO_LOOKUP: u32 = 4294967295

pub const REASON_NONE: u8 = 0

/// A lookup's flags skip base glyphs, so a match can step over the glyph.
pub const REASON_IGNORE_BASE: u8 = 1

/// GDEF classifies the glyph as a ligature (class 2).
pub const REASON_LIGATURE_CLASS: u8 = 2

/// GDEF classifies the glyph as a mark (class 3).
pub const REASON_MARK_CLASS: u8 = 3

/// GDEF gives the glyph a nonzero mark attachment class.
pub const REASON_MARK_ATTACH_CLASS: u8 = 4

/// The glyph is in a GDEF mark glyph set.
pub const REASON_MARK_SET: u8 = 5

/// The glyph is in the coverage of the glyph a subtable starts at (for mark attachment, the
/// mark coverage).
pub const REASON_COVERAGE: u8 = 6

/// The glyph is a component of a ligature.
pub const REASON_LIGATURE_COMPONENT: u8 = 7

/// A rule's input sequence (after its first glyph) has the glyph, or the glyph's class.
pub const REASON_RULE_INPUT: u8 = 8

/// A rule's backtrack sequence has the glyph, or the glyph's class.
pub const REASON_RULE_BACKTRACK: u8 = 9

/// A rule's lookahead sequence has the glyph, or the glyph's class.
pub const REASON_RULE_LOOKAHEAD: u8 = 10

/// A format 3 contextual or reverse chaining subtable's input coverage has the glyph.
pub const REASON_INPUT_COVERAGE: u8 = 11

/// A format 3 contextual or reverse chaining subtable's backtrack coverage has the glyph.
pub const REASON_BACKTRACK_COVERAGE: u8 = 12

/// A format 3 contextual or reverse chaining subtable's lookahead coverage has the glyph.
pub const REASON_LOOKAHEAD_COVERAGE: u8 = 13

/// The glyph is the second glyph of a pair adjustment record.
pub const REASON_PAIR_SECOND: u8 = 14

/// A class pair adjustment has a nonzero value record for the glyph's second class.
pub const REASON_PAIR_CLASS: u8 = 15

/// The glyph is in a mark attachment subtable's base, ligature or mark 2 coverage.
pub const REASON_ATTACHMENT_COVERAGE: u8 = 16

/// An unknown lookup type, or a lookup type inside an extension that is not allowed there.
pub const REASON_UNKNOWN_LOOKUP: u8 = 17

/// A subtable format the scan does not read, such as the 24-bit formats.
pub const REASON_UNKNOWN_FORMAT: u8 = 18

/// A table, lookup or subtable that is truncated or otherwise cannot be read.
pub const REASON_MALFORMED: u8 = 19

/// The table is a legacy `kern` table or an AAT table (`morx`, `mort`, `kerx`), which the scan
/// does not analyze.
pub const REASON_UNANALYZED_TABLE: u8 = 20

/// A class pair adjustment gives the glyph a second class past its class count.
pub const REASON_PAIR_CLASS_RANGE: u8 = 21

/// The scan read more than its budget of entries, which only a font with heavily shared
/// subtables reaches.
pub const REASON_BUDGET: u8 = 22

/// Entries the scan reads before it gives up and answers that the glyph takes part. Fonts read
/// each array once, so a font needs millions of shared rule or pair sets to reach it.
const BUDGET: usize = 268435456

const GSUB: u32 = 0x47535542

const GPOS: u32 = 0x47504f53

const GDEF: u32 = 0x47444546

/// Why a glyph takes part in a font's layout: the first reason the scan finds, in the order
/// legacy and AAT tables, GDEF, GSUB lookups, GPOS lookups.
pub struct LayoutUse {
  pub involved: bool,
  /// The tag of the table with the reason, such as `GSUB`; 0 when the glyph is not involved.
  pub table: u32,
  /// The lookup's index in its table's lookup list, or `NO_LOOKUP`.
  pub lookup: u32,
  /// The lookup type, after any extension; 0 without a lookup.
  pub kind: u16,
  /// The subtable's index in its lookup; 0 without a subtable.
  pub subtable: u32,
  /// The subtable's format; 0 without a subtable.
  pub format: u16,
  /// One of the `REASON_` constants.
  pub reason: u8,
}

impl Copy for LayoutUse {}

impl LayoutUse {
  pub fn none() -> Self {
    return Self {
      involved: false,
      table: 0,
      lookup: NO_LOOKUP,
      kind: 0,
      subtable: 0,
      format: 0,
      reason: REASON_NONE,
    }
  }

  fn of(table: u32, reason: u8) -> Self {
    return Self {
      involved: true,
      table: table,
      lookup: NO_LOOKUP,
      kind: 0,
      subtable: 0,
      format: 0,
      reason: reason,
    }
  }
}

/// A description of a `REASON_` constant.
pub fn reasonText(reason: u8) -> string<'static> {
  if reason == REASON_NONE {
    return "not involved"
  }
  if reason == REASON_IGNORE_BASE {
    return "lookup flags ignore base glyphs"
  }
  if reason == REASON_LIGATURE_CLASS {
    return "GDEF glyph class is ligature"
  }
  if reason == REASON_MARK_CLASS {
    return "GDEF glyph class is mark"
  }
  if reason == REASON_MARK_ATTACH_CLASS {
    return "GDEF mark attachment class is nonzero"
  }
  if reason == REASON_MARK_SET {
    return "in a GDEF mark glyph set"
  }
  if reason == REASON_COVERAGE {
    return "in the subtable's coverage"
  }
  if reason == REASON_LIGATURE_COMPONENT {
    return "a ligature component"
  }
  if reason == REASON_RULE_INPUT {
    return "in a rule's input sequence (glyph, or its class)"
  }
  if reason == REASON_RULE_BACKTRACK {
    return "in a rule's backtrack sequence (glyph, or its class)"
  }
  if reason == REASON_RULE_LOOKAHEAD {
    return "in a rule's lookahead sequence (glyph, or its class)"
  }
  if reason == REASON_INPUT_COVERAGE {
    return "in an input coverage"
  }
  if reason == REASON_BACKTRACK_COVERAGE {
    return "in a backtrack coverage"
  }
  if reason == REASON_LOOKAHEAD_COVERAGE {
    return "in a lookahead coverage"
  }
  if reason == REASON_PAIR_SECOND {
    return "the second glyph of a pair record"
  }
  if reason == REASON_PAIR_CLASS {
    return "a nonzero class pair value for its second class"
  }
  if reason == REASON_ATTACHMENT_COVERAGE {
    return "in a base, ligature or mark 2 coverage"
  }
  if reason == REASON_UNKNOWN_LOOKUP {
    return "unknown lookup type"
  }
  if reason == REASON_UNKNOWN_FORMAT {
    return "subtable format not analyzed"
  }
  if reason == REASON_MALFORMED {
    return "malformed table"
  }
  if reason == REASON_UNANALYZED_TABLE {
    return "legacy kern or AAT table present"
  }
  if reason == REASON_PAIR_CLASS_RANGE {
    return "second class out of range"
  }
  if reason == REASON_BUDGET {
    return "scan budget exhausted"
  }
  return "unknown reason"
}

/// The font's glyph for U+0020 SPACE, or None when it maps to no glyph.
pub fn spaceGlyph<'a>(font: &FontRef<'a>) -> Option<u32> {
  let charmap = Charmap.new(font)
  if let Option<GlyphId>.Some { value } = Charmap.mapUnicode(&charmap, 32) {
    let glyph = GlyphId.toU32(value)
    if glyph != 0 {
      return Option<u32>.some(glyph)
    }
  }
  return Option<u32>.None
}

/// Whether shaping text with `font` gives the same glyphs as shaping each space-separated word,
/// and each run of spaces, on its own and joining the results, as far as the font's layout
/// tables go. False when the font has no space glyph or the space glyph takes part in its
/// layout (`glyphInLayout`).
pub fn spaceSeparable<'a>(font: &FontRef<'a>) -> bool {
  if let Option<u32>.Some { value } = spaceGlyph(font) {
    return !glyphInLayout(font, value)
  }
  return false
}

/// Whether `glyph` can take part in any lookup of `font` in a way that could join it with the
/// glyphs around it: it is matched, substituted, positioned, used as context or skipped by a
/// lookup, or the font has tables the scan does not analyze. See `glyphLayoutUse` for the
/// reason.
pub fn glyphInLayout<'a>(font: &FontRef<'a>, glyph: u32) -> bool {
  return glyphLayoutUse(font, glyph).involved
}

/// The first reason `glyph` takes part in `font`'s layout, or `LayoutUse.none()`.
pub fn glyphLayoutUse<'a>(font: &FontRef<'a>, glyph: u32) -> LayoutUse {
  return glyphLayoutUseAfter(font, glyph, LayoutUse.none())
}

/// The first reason after `previous` that `glyph` takes part in `font`'s layout, which lists
/// every lookup with a reason when called with each answer in turn until it is not involved.
/// The legacy and AAT tables and GDEF give at most one reason each, and each lookup at most
/// one.
pub fn glyphLayoutUseAfter<'a>(font: &FontRef<'a>, glyph: u32, previous: LayoutUse) -> LayoutUse {
  // Stages: 0 the legacy and AAT tables, 1 GDEF, 2 GSUB, 3 GPOS.
  let mut stage: u32 = 0
  let mut from: u32 = 0
  if previous.involved {
    if previous.table == GSUB {
      stage = 2
    } else if previous.table == GPOS {
      stage = 3
    } else if previous.table == GDEF {
      stage = 2
    } else {
      stage = 1
    }
    if previous.table == GSUB || previous.table == GPOS {
      if previous.lookup == NO_LOOKUP {
        stage = stage + 1
      } else {
        from = previous.lookup + 1
      }
    }
  }
  if stage == 0 {
    let tags: [u32; 4] = [0x6b65726e, 0x6d6f7278, 0x6d6f7274, 0x6b657278]
    let mut i: usize = 0
    while i < tags.length {
      if View.len(&table(font, tags[i])) != 0 {
        return LayoutUse.of(tags[i], REASON_UNANALYZED_TABLE)
      }
      i = i + 1
    }
    stage = 1
  }
  if stage == 1 {
    let reason = gdefUse(table(font, GDEF), glyph)
    if reason != REASON_NONE {
      return LayoutUse.of(GDEF, reason)
    }
    stage = 2
  }
  if stage > 3 {
    return LayoutUse.none()
  }
  if stage == 2 {
    let found = layoutUse(table(font, GSUB), false, glyph, from)
    if found.involved {
      return found
    }
    stage = 3
    from = 0
  }
  return layoutUse(table(font, GPOS), true, glyph, from)
}

/// The first reason `glyph` takes part in a GSUB (or, with `positioning`, GPOS) table, read
/// from its bytes.
pub fn tableLayoutUse(layout: View<'_>, positioning: bool, glyph: u32) -> LayoutUse {
  return layoutUse(layout, positioning, glyph, 0)
}

/// The first reason GDEF `gdef` gives `glyph` to take part in layout, or `REASON_NONE`.
pub fn gdefUse(gdef: View<'_>, glyph: u32) -> u8 {
  if View.len(&gdef) == 0 {
    return REASON_NONE
  }
  let glyphClass = View.class(&View.gdefList(&gdef, 0), glyph)
  if glyphClass == 2 {
    return REASON_LIGATURE_CLASS
  }
  if glyphClass == 3 {
    return REASON_MARK_CLASS
  }
  if View.class(&View.gdefList(&gdef, 3), glyph) != 0 {
    return REASON_MARK_ATTACH_CLASS
  }
  let sets = View.gdefList(&gdef, 4)
  if View.len(&sets) != 0 {
    let count = u16.toUsize(View.u16(&sets, 2))
    if View.u16(&sets, 0) != 1 || !fits(&sets, 4, count, 4) {
      return REASON_MALFORMED
    }
    let mut i: usize = 0
    while i < count {
      if covers(View.offset32(&sets, 4 + i * 4), glyph) {
        return REASON_MARK_SET
      }
      i = i + 1
    }
  }
  return REASON_NONE
}

struct Scan {
  glyph: u32,
  positioning: bool,
  /// Entries left to read; see `BUDGET`.
  budget: usize,
}

/// Takes `count` entries from the budget; false when it runs out.
fn spend(scan: &mut Scan, count: usize) -> bool {
  if count > scan.budget {
    scan.budget = 0
    return false
  }
  scan.budget = scan.budget - count
  return true
}

/// Whether `count` entries of `stride` bytes from `at` are inside `view`. No entries always
/// fit, as a null offset reads as an empty table with a count of 0.
fn fits(view: &View<'_>, at: usize, count: usize, stride: usize) -> bool {
  if count == 0 {
    return true
  }
  return usize.saturatingAdd(at, usize.saturatingMultiply(count, stride)) <= View.len(view)
}

/// Whether `coverage` may have `glyph`: it has it, or it cannot be read.
fn covers(coverage: View<'_>, glyph: u32) -> bool {
  let format = View.u16(&coverage, 0)
  if format < 1 || format > 4 {
    return true
  }
  let mut width: usize = 2
  if format >= 3 {
    width = 3
  }
  let mut stride = width
  if format == 2 || format == 4 {
    stride = width * 3
  }
  if !fits(&coverage, 2 + width, u32.toUsize(View.uint(&coverage, 2, width)), stride) {
    return true
  }
  if let Option<u32>.Some { value: _ } = View.coverage(&coverage, glyph) {
    return true
  }
  return false
}

/// Whether one of the `count` 16-bit values from `at` in `view` is `value`. The caller has
/// checked that they fit.
fn has16(view: &View<'_>, at: usize, count: usize, value: u32) -> bool {
  if value > 65535 {
    return false
  }
  let mut i: usize = 0
  while i < count {
    if u16.toU32(View.u16(view, at + i * 2)) == value {
      return true
    }
    i = i + 1
  }
  return false
}

fn layoutUse(layout: View<'_>, positioning: bool, glyph: u32, from: u32) -> LayoutUse {
  if View.len(&layout) == 0 {
    return LayoutUse.none()
  }
  let mut tag = GSUB
  if positioning {
    tag = GPOS
  }
  if View.u16(&layout, 0) != 1 || View.len(&layout) < 10 {
    return LayoutUse.of(tag, REASON_MALFORMED)
  }
  let mut scan = Scan { glyph: glyph, positioning: positioning, budget: BUDGET }
  let list = View.layoutList(&layout, 2)
  let mut width: usize = 2
  if View.u16(&layout, 2) >= 2 && View.u32(&layout, 22) != 0 {
    width = 4
  }
  let count = u16.toUsize(View.u16(&list, 0))
  if !fits(&list, 2, count, width) {
    return LayoutUse.of(tag, REASON_MALFORMED)
  }
  let mut index = u32.toUsize(from)
  while index < count {
    let lookup = View.offset(&list, 2 + index * width, width)
    let mut found = LayoutUse.of(tag, REASON_NONE)
    found.lookup = usize.toU32(index)
    let lookupKind = View.u16(&lookup, 0)
    found.kind = lookupKind
    let subtables = u16.toUsize(View.u16(&lookup, 4))
    if View.len(&lookup) < 6 || !fits(&lookup, 6, subtables, 2) {
      found.reason = REASON_MALFORMED
      return found
    }
    if (View.u16(&lookup, 2) & 2) != 0 {
      found.reason = REASON_IGNORE_BASE
      return found
    }
    let mut i: usize = 0
    while i < subtables {
      let mut subtable = View.offset16(&lookup, 6 + i * 2)
      let mut kind = lookupKind
      found.subtable = usize.toU32(i)
      if (!positioning && kind == 7) || (positioning && kind == 9) {
        if View.u16(&subtable, 0) != 1 {
          found.reason = REASON_MALFORMED
          return found
        }
        kind = View.u16(&subtable, 2)
        subtable = View.offset32(&subtable, 4)
        found.kind = kind
        if (!positioning && kind == 7) || (positioning && kind == 9) {
          found.reason = REASON_UNKNOWN_LOOKUP
          return found
        }
      }
      found.format = View.u16(&subtable, 0)
      let reason = subtableUse(&mut scan, subtable, kind)
      if reason != REASON_NONE {
        found.reason = reason
        return found
      }
      i = i + 1
    }
    index = index + 1
  }
  return LayoutUse.none()
}

/// The first reason the subtable of lookup type `kind` gives the glyph to take part.
fn subtableUse(scan: &mut Scan, subtable: View<'_>, kind: u16) -> u8 {
  if View.len(&subtable) < 4 {
    return REASON_MALFORMED
  }
  let format = View.u16(&subtable, 0)
  let glyph = scan.glyph
  if !scan.positioning {
    if kind == 1 || kind == 2 || kind == 3 {
      if format != 1 && !(kind == 1 && format == 2) {
        return REASON_UNKNOWN_FORMAT
      }
      return coverageUse(View.offset16(&subtable, 2), glyph)
    }
    if kind == 4 {
      if format != 1 {
        return REASON_UNKNOWN_FORMAT
      }
      return ligatureUse(&mut scan, subtable)
    }
    if kind == 5 || kind == 6 {
      return contextUse(&mut scan, subtable, kind == 6)
    }
    if kind == 8 {
      if format != 1 {
        return REASON_UNKNOWN_FORMAT
      }
      return reverseUse(subtable, glyph)
    }
    return REASON_UNKNOWN_LOOKUP
  }
  if kind == 1 || kind == 3 {
    if format != 1 && !(kind == 1 && format == 2) {
      return REASON_UNKNOWN_FORMAT
    }
    return coverageUse(View.offset16(&subtable, 2), glyph)
  }
  if kind == 2 {
    if format == 1 {
      return pairGlyphUse(&mut scan, subtable)
    }
    if format == 2 {
      return pairClassUse(&mut scan, subtable)
    }
    return REASON_UNKNOWN_FORMAT
  }
  if kind >= 4 && kind <= 6 {
    if format != 1 {
      return REASON_UNKNOWN_FORMAT
    }
    if covers(View.offset16(&subtable, 2), glyph) {
      return REASON_COVERAGE
    }
    if covers(View.offset16(&subtable, 4), glyph) {
      return REASON_ATTACHMENT_COVERAGE
    }
    return REASON_NONE
  }
  if kind == 7 || kind == 8 {
    return contextUse(&mut scan, subtable, kind == 8)
  }
  return REASON_UNKNOWN_LOOKUP
}

fn coverageUse(coverage: View<'_>, glyph: u32) -> u8 {
  if covers(coverage, glyph) {
    return REASON_COVERAGE
  }
  return REASON_NONE
}

/// Ligature substitution format 1: the coverage of first glyphs and every ligature's other
/// components.
fn ligatureUse(scan: &mut Scan, subtable: View<'_>) -> u8 {
  if covers(View.offset16(&subtable, 2), scan.glyph) {
    return REASON_COVERAGE
  }
  let sets = u16.toUsize(View.u16(&subtable, 4))
  if !fits(&subtable, 6, sets, 2) {
    return REASON_MALFORMED
  }
  let mut i: usize = 0
  while i < sets {
    let set = View.offset16(&subtable, 6 + i * 2)
    let count = u16.toUsize(View.u16(&set, 0))
    if !fits(&set, 2, count, 2) {
      return REASON_MALFORMED
    }
    let mut j: usize = 0
    while j < count {
      let ligature = View.offset16(&set, 2 + j * 2)
      let components = usize.saturatingSubtract(u16.toUsize(View.u16(&ligature, 2)), 1)
      if !fits(&ligature, 4, components, 2) {
        return REASON_MALFORMED
      }
      if !spend(&mut scan, components + 1) {
        return REASON_BUDGET
      }
      if has16(&ligature, 4, components, scan.glyph) {
        return REASON_LIGATURE_COMPONENT
      }
      j = j + 1
    }
    i = i + 1
  }
  return REASON_NONE
}

/// Reverse chaining single substitution format 1: its coverage, backtrack and lookahead
/// coverages.
fn reverseUse(subtable: View<'_>, glyph: u32) -> u8 {
  if covers(View.offset16(&subtable, 2), glyph) {
    return REASON_COVERAGE
  }
  let back = u16.toUsize(View.u16(&subtable, 4))
  if !fits(&subtable, 6, back, 2) {
    return REASON_MALFORMED
  }
  if coveragesHave(subtable, 6, back, glyph) {
    return REASON_BACKTRACK_COVERAGE
  }
  let aheadAt = 6 + back * 2
  let ahead = u16.toUsize(View.u16(&subtable, aheadAt))
  if !fits(&subtable, aheadAt + 2, ahead, 2) {
    return REASON_MALFORMED
  }
  if coveragesHave(subtable, aheadAt + 2, ahead, glyph) {
    return REASON_LOOKAHEAD_COVERAGE
  }
  return REASON_NONE
}

/// Whether one of the `count` coverage offsets from `at` in `table` may have `glyph`.
fn coveragesHave(table: View<'_>, at: usize, count: usize, glyph: u32) -> bool {
  let mut i: usize = 0
  while i < count {
    if covers(View.offset16(&table, at + i * 2), glyph) {
      return true
    }
    i = i + 1
  }
  return false
}

/// Contextual and chained contextual subtables (GSUB 5 and 6, GPOS 7 and 8) of every format.
fn contextUse(scan: &mut Scan, subtable: View<'_>, chained: bool) -> u8 {
  let format = View.u16(&subtable, 0)
  let glyph = scan.glyph
  if format == 1 || format == 2 {
    if covers(View.offset16(&subtable, 2), glyph) {
      return REASON_COVERAGE
    }
    // Format 1 rules hold glyphs; format 2 rules hold classes, each sequence of its own
    // class definition, where class 0 is every glyph the definition does not list.
    let mut back = glyph
    let mut input = glyph
    let mut ahead = glyph
    let mut setsAt: usize = 4
    if format == 2 {
      if chained {
        back = View.class(&View.offset16(&subtable, 4), glyph)
        input = View.class(&View.offset16(&subtable, 6), glyph)
        ahead = View.class(&View.offset16(&subtable, 8), glyph)
        setsAt = 10
      } else {
        input = View.class(&View.offset16(&subtable, 4), glyph)
        setsAt = 6
      }
    }
    return rulesUse(&mut scan, subtable, setsAt, chained, back, input, ahead)
  }
  if format == 3 {
    if !chained {
      let count = u16.toUsize(View.u16(&subtable, 2))
      if !fits(&subtable, 6, count, 2) {
        return REASON_MALFORMED
      }
      if coveragesHave(subtable, 6, count, glyph) {
        return REASON_INPUT_COVERAGE
      }
      return REASON_NONE
    }
    let back = u16.toUsize(View.u16(&subtable, 2))
    if !fits(&subtable, 4, back, 2) {
      return REASON_MALFORMED
    }
    if coveragesHave(subtable, 4, back, glyph) {
      return REASON_BACKTRACK_COVERAGE
    }
    let inputAt = 4 + back * 2
    let input = u16.toUsize(View.u16(&subtable, inputAt))
    if !fits(&subtable, inputAt + 2, input, 2) {
      return REASON_MALFORMED
    }
    if coveragesHave(subtable, inputAt + 2, input, glyph) {
      return REASON_INPUT_COVERAGE
    }
    let aheadAt = inputAt + 2 + input * 2
    let ahead = u16.toUsize(View.u16(&subtable, aheadAt))
    if !fits(&subtable, aheadAt + 2, ahead, 2) {
      return REASON_MALFORMED
    }
    if coveragesHave(subtable, aheadAt + 2, ahead, glyph) {
      return REASON_LOOKAHEAD_COVERAGE
    }
    return REASON_NONE
  }
  return REASON_UNKNOWN_FORMAT
}

/// Every rule of every rule set of a format 1 or 2 contextual subtable, whose rule set count
/// is at `setsAt`: whether a rule's backtrack, input (after the first glyph) or lookahead
/// sequence has `back`, `input` or `ahead`.
fn rulesUse(
  scan: &mut Scan,
  subtable: View<'_>,
  setsAt: usize,
  chained: bool,
  back: u32,
  input: u32,
  ahead: u32,
) -> u8 {
  let sets = u16.toUsize(View.u16(&subtable, setsAt))
  if !fits(&subtable, setsAt + 2, sets, 2) {
    return REASON_MALFORMED
  }
  let mut i: usize = 0
  while i < sets {
    let set = View.offset16(&subtable, setsAt + 2 + i * 2)
    let count = u16.toUsize(View.u16(&set, 0))
    if !fits(&set, 2, count, 2) {
      return REASON_MALFORMED
    }
    let mut j: usize = 0
    while j < count {
      let rule = View.offset16(&set, 2 + j * 2)
      let reason = ruleUse(&mut scan, rule, chained, back, input, ahead)
      if reason != REASON_NONE {
        return reason
      }
      j = j + 1
    }
    i = i + 1
  }
  return REASON_NONE
}

fn ruleUse(scan: &mut Scan, rule: View<'_>, chained: bool, back: u32, input: u32, ahead: u32) -> u8 {
  if !chained {
    // An input count of 0 matches as 1, the first glyph alone, as in HarfBuzz.
    let inputs = usize.saturatingSubtract(u16.toUsize(View.u16(&rule, 0)), 1)
    if View.len(&rule) < 4 || !fits(&rule, 4, inputs, 2) {
      return REASON_MALFORMED
    }
    if !spend(&mut scan, inputs + 1) {
      return REASON_BUDGET
    }
    if has16(&rule, 4, inputs, input) {
      return REASON_RULE_INPUT
    }
    return REASON_NONE
  }
  let backs = u16.toUsize(View.u16(&rule, 0))
  if View.len(&rule) < 2 || !fits(&rule, 2, backs, 2) {
    return REASON_MALFORMED
  }
  let inputAt = 2 + backs * 2
  let inputs = usize.saturatingSubtract(u16.toUsize(View.u16(&rule, inputAt)), 1)
  if !fits(&rule, inputAt + 2, inputs, 2) {
    return REASON_MALFORMED
  }
  let aheadAt = inputAt + 2 + inputs * 2
  let aheads = u16.toUsize(View.u16(&rule, aheadAt))
  if !fits(&rule, aheadAt + 2, aheads, 2) {
    return REASON_MALFORMED
  }
  if !spend(&mut scan, backs + inputs + aheads + 1) {
    return REASON_BUDGET
  }
  if has16(&rule, 2, backs, back) {
    return REASON_RULE_BACKTRACK
  }
  if has16(&rule, inputAt + 2, inputs, input) {
    return REASON_RULE_INPUT
  }
  if has16(&rule, aheadAt + 2, aheads, ahead) {
    return REASON_RULE_LOOKAHEAD
  }
  return REASON_NONE
}

/// Pair adjustment format 1: the coverage of first glyphs and every record's second glyph,
/// whatever its values.
fn pairGlyphUse(scan: &mut Scan, subtable: View<'_>) -> u8 {
  if covers(View.offset16(&subtable, 2), scan.glyph) {
    return REASON_COVERAGE
  }
  let stride = 2 + valueSize(View.u16(&subtable, 4)) + valueSize(View.u16(&subtable, 6))
  let sets = u16.toUsize(View.u16(&subtable, 8))
  if !fits(&subtable, 10, sets, 2) {
    return REASON_MALFORMED
  }
  let mut i: usize = 0
  while i < sets {
    let set = View.offset16(&subtable, 10 + i * 2)
    let count = u16.toUsize(View.u16(&set, 0))
    if !fits(&set, 2, count, stride) {
      return REASON_MALFORMED
    }
    if !spend(&mut scan, count) {
      return REASON_BUDGET
    }
    // Records are sorted, but a linear walk also finds a glyph an unsorted set hides.
    let mut j: usize = 0
    while j < count {
      if u16.toU32(View.u16(&set, 2 + j * stride)) == scan.glyph {
        return REASON_PAIR_SECOND
      }
      j = j + 1
    }
    i = i + 1
  }
  return REASON_NONE
}

/// Pair adjustment format 2: the coverage of first glyphs, then the glyph's second class (0
/// when the class definition does not list it) in every first class's row. A zero value
/// record (no adjustment and no device or variation offset) changes nothing.
fn pairClassUse(scan: &mut Scan, subtable: View<'_>) -> u8 {
  if covers(View.offset16(&subtable, 2), scan.glyph) {
    return REASON_COVERAGE
  }
  let size = valueSize(View.u16(&subtable, 4)) + valueSize(View.u16(&subtable, 6))
  let firstClasses = u16.toUsize(View.u16(&subtable, 12))
  let secondClasses = u16.toUsize(View.u16(&subtable, 14))
  if View.len(&subtable) < 16 || !fits(&subtable, 16, firstClasses * secondClasses, size) {
    return REASON_MALFORMED
  }
  if size == 0 {
    return REASON_NONE
  }
  let second = u32.toUsize(View.class(&View.offset16(&subtable, 10), scan.glyph))
  if second >= secondClasses {
    return REASON_PAIR_CLASS_RANGE
  }
  if !spend(&mut scan, firstClasses * size / 2) {
    return REASON_BUDGET
  }
  let mut first: usize = 0
  while first < firstClasses {
    let at = 16 + (first * secondClasses + second) * size
    let mut k: usize = 0
    while k < size {
      if View.u16(&subtable, at + k) != 0 {
        return REASON_PAIR_CLASS
      }
      k = k + 2
    }
    first = first + 1
  }
  return REASON_NONE
}

/// Tags of the features of GSUB or GPOS `layout` whose lookup list has `lookup`, deduplicated,
/// written to `out`; returns how many there are, which may exceed `out`'s length. A lookup no
/// feature lists is only reached from contextual lookups, or not at all. For diagnostics.
pub fn lookupFeatureTags<'a>(
  font: &FontRef<'a>,
  layoutTag: u32,
  lookup: u32,
  out: &mut [u32],
) -> usize {
  let layout = table(font, layoutTag)
  let list = View.layoutList(&layout, 1)
  let count = u16.toUsize(View.u16(&list, 0))
  let mut found: usize = 0
  let mut i: usize = 0
  while i < count && fits(&list, 2, i + 1, 6) {
    let tag = View.u32(&list, 2 + i * 6)
    let feature = View.offset16(&list, 2 + i * 6 + 4)
    let lookups = u16.toUsize(View.u16(&feature, 2))
    if fits(&feature, 4, lookups, 2) && has16(&feature, 4, lookups, lookup) {
      let mut seen = false
      let mut k: usize = 0
      while k < found && k < out.length {
        if out[k] == tag {
          seen = true
        }
        k = k + 1
      }
      if !seen {
        if found < out.length {
          out[found] = tag
        }
        found = found + 1
      }
    }
    i = i + 1
  }
  return found
}

/// The lookups of GSUB or GPOS `layout` whose contextual rules apply `lookup` as a nested
/// lookup, written to `out`; returns how many there are. For diagnostics.
pub fn lookupNestingLookups<'a>(
  font: &FontRef<'a>,
  layoutTag: u32,
  lookup: u32,
  out: &mut [u32],
) -> usize {
  let layout = table(font, layoutTag)
  let positioning = layoutTag == GPOS
  let list = View.layoutList(&layout, 2)
  let mut width: usize = 2
  if View.u16(&layout, 0) == 1 && View.u16(&layout, 2) >= 2 && View.u32(&layout, 22) != 0 {
    width = 4
  }
  let count = u16.toUsize(View.u16(&list, 0))
  let mut found: usize = 0
  let mut index: usize = 0
  while index < count {
    let view = View.offset(&list, 2 + index * width, width)
    let lookupKind = View.u16(&view, 0)
    let subtables = u16.toUsize(View.u16(&view, 4))
    let mut nests = false
    let mut i: usize = 0
    while i < subtables && !nests {
      let mut subtable = View.offset16(&view, 6 + i * 2)
      let mut kind = lookupKind
      if ((!positioning && kind == 7) || (positioning && kind == 9))
        && View.u16(&subtable, 0) == 1 {
        kind = View.u16(&subtable, 2)
        subtable = View.offset32(&subtable, 4)
      }
      if (!positioning && (kind == 5 || kind == 6)) || (positioning && (kind == 7 || kind == 8)) {
        nests = contextApplies(subtable, kind == 6 || kind == 8, lookup)
      }
      i = i + 1
    }
    if nests {
      if found < out.length {
        out[found] = usize.toU32(index)
      }
      found = found + 1
    }
    index = index + 1
  }
  return found
}

/// Whether a contextual subtable has a sequence lookup record that applies `lookup`.
fn contextApplies(subtable: View<'_>, chained: bool, lookup: u32) -> bool {
  let format = View.u16(&subtable, 0)
  if format == 3 {
    if !chained {
      let inputs = u16.toUsize(View.u16(&subtable, 2))
      return recordsApply(subtable, 6 + inputs * 2, u16.toUsize(View.u16(&subtable, 4)), lookup)
    }
    let backs = u16.toUsize(View.u16(&subtable, 2))
    let inputAt = 4 + backs * 2
    let aheadAt = inputAt + 2 + u16.toUsize(View.u16(&subtable, inputAt)) * 2
    let recordsAt = aheadAt + 2 + u16.toUsize(View.u16(&subtable, aheadAt)) * 2
    return recordsApply(subtable, recordsAt + 2, u16.toUsize(View.u16(&subtable, recordsAt)), lookup)
  }
  if format != 1 && format != 2 {
    return false
  }
  let mut setsAt: usize = 4
  if format == 2 {
    setsAt = 6
    if chained {
      setsAt = 10
    }
  }
  let sets = u16.toUsize(View.u16(&subtable, setsAt))
  let mut i: usize = 0
  while i < sets && fits(&subtable, setsAt + 2, i + 1, 2) {
    let set = View.offset16(&subtable, setsAt + 2 + i * 2)
    let rules = u16.toUsize(View.u16(&set, 0))
    let mut j: usize = 0
    while j < rules && fits(&set, 2, j + 1, 2) {
      let rule = View.offset16(&set, 2 + j * 2)
      if !chained {
        let inputs = usize.saturatingSubtract(u16.toUsize(View.u16(&rule, 0)), 1)
        if recordsApply(rule, 4 + inputs * 2, u16.toUsize(View.u16(&rule, 2)), lookup) {
          return true
        }
      } else {
        let inputAt = 2 + u16.toUsize(View.u16(&rule, 0)) * 2
        let aheadAt = inputAt + 2
          + usize.saturatingSubtract(u16.toUsize(View.u16(&rule, inputAt)), 1) * 2
        let recordsAt = aheadAt + 2 + u16.toUsize(View.u16(&rule, aheadAt)) * 2
        if recordsApply(rule, recordsAt + 2, u16.toUsize(View.u16(&rule, recordsAt)), lookup) {
          return true
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  return false
}

/// Whether one of `count` sequence lookup records from `at` applies `lookup`.
fn recordsApply(table: View<'_>, at: usize, count: usize, lookup: u32) -> bool {
  let mut i: usize = 0
  while i < count && fits(&table, at, i + 1, 4) {
    if u16.toU32(View.u16(&table, at + i * 4 + 2)) == lookup {
      return true
    }
    i = i + 1
  }
  return false
}
