import silk.collections.list { List }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.concurrency.sync { Arc }
import silk.concurrency.thread { Concurrent, Transferable }
import silk.concurrency.thread_native { JoinHandle, NativeThread, SpawnError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.mem.pointer { Pointer }
import silk.num.u64
import silk.num.usize
import silk.testing.testing { AssertionError, Testing }
import ui_transport.channel { TryRecvError }
import ui_transport.rpc { RpcChannel, RpcEnvelope, RpcError, RpcPair, RpcResponder }
import ui_transport.wake { Waiter }
import ui_tree_window.platform_thread { HostPlatform }
import window.native { initialAppearance }
import window.types { Appearance }

union MockCmd {
  Notify { seq: u64 },
  Open { caller: u64, seq: u64 },
  Read { caller: u64, seq: u64 },
}

union MockRep {
  Window { value: u64 },
  Clipboard { value: u64 },
}

impl Transferable for MockCmd {}
impl Transferable for MockRep {}

struct AtomicCount {
  storage: Box<u64>,
  ptr: *mut u64,
}

impl Transferable for AtomicCount {}
impl Concurrent for AtomicCount {}

fn replyOpt(responder: Option<RpcResponder<MockRep>>, rep: MockRep) -> () {
  if let Option<RpcResponder<MockRep>>.Some { value: r } = move responder {
    r.reply(move rep)
  }
}

test effect fn platformRpcHandlesConcurrentCallersAndShutdown() -> ()
  ! AssertionError<'static> | OutOfMemoryError | SpawnError {
  let mut heap = Allocator.systemAllocatorProvider()
  let waiter = run Waiter.make()
  let pair = run RpcChannel.make<MockCmd, MockRep>(waiter.handle())
  let RpcPair<MockCmd, MockRep> { client, server: srvInit } = move pair
  let mut server = move srvInit

  let mut fireBox = run Box<u64>.make(0) |> Effect.provideMut<Allocator>(&mut heap)
  let firePtr = Pointer.fromMutRef(&mut fireBox.getMut()[0])
  let fireSeen = run Arc<AtomicCount>.make(AtomicCount { storage: move fireBox, ptr: firePtr })
    |> Effect.provideMut<Allocator>(&mut heap)
  let serverFire = fireSeen.clone()

  // Serve 4 * 50 tagged calls + 4 * 50 fire-and-forget commands, then close cleanly.
  let serverThread = run NativeThread.spawn(
    || -> () {
      let mut srv = move server
      let w = move waiter
      let fire = move serverFire
      let mut replied: usize = 0
      let mut sentCount: u64 = 0
      while replied < 200 || sentCount < 200 {
        match move srv.tryRecv() {
          Result<RpcEnvelope<MockCmd, MockRep>, TryRecvError>.Success { value: env } => {
            let RpcEnvelope<MockCmd, MockRep> { id: _, request, responder } = move env
            match move request {
              MockCmd.Notify { seq } => {
                let _prev = unsafe Atomic.fetchAdd<u64>(fire.get().ptr, seq + 1, MemoryOrder.Relaxed)
                sentCount = sentCount + 1
                drop responder
              }
              MockCmd.Open { caller, seq } => {
                replyOpt(move responder, MockRep.Window { value: caller * 10000 + seq })
                replied = replied + 1
              }
              MockCmd.Read { caller, seq } => {
                replyOpt(move responder, MockRep.Clipboard { value: caller * 20000 + seq })
                replied = replied + 1
              }
            }
          }
          Result<RpcEnvelope<MockCmd, MockRep>, TryRecvError>.Failure { error } => match error {
            TryRecvError.Empty => w.wait()
            TryRecvError.Closed => {
              break
            }
          }
        }
      }
      // Take one more request and drop without answering so the caller observes RpcError.Closed.
      while true {
        match move srv.tryRecv() {
          Result<RpcEnvelope<MockCmd, MockRep>, TryRecvError>.Success { value: env } => {
            drop env
            break
          }
          Result<RpcEnvelope<MockCmd, MockRep>, TryRecvError>.Failure { error } => match error {
            TryRecvError.Empty => w.wait()
            TryRecvError.Closed => {
              break
            }
          }
        }
      }
      srv.close()
    },
  )
    |> Effect.provideMut<Allocator>(&mut heap)

  let mut callers = List<JoinHandle<bool>>.make()
  let mut t: u64 = 0
  while t < 4 {
    let c = client.clone()
    let callerId = t + 1
    let handle = run NativeThread.spawn(
      || -> bool {
        let client = move c
        let cid = move callerId
        let mut s: u64 = 0
        while s < 25 {
          drop run Effect.result(client.send(MockCmd.Notify { seq: s }))
          let openOk = match run client.call(MockCmd.Open { caller: cid, seq: s }) {
            Result<MockRep, RpcError>.Success { value } => match move value {
              MockRep.Window { value: got } => got == cid * 10000 + s
              MockRep.Clipboard { .. } => false
            }
            Result<MockRep, RpcError>.Failure { .. } => false
          }
          if !openOk {
            return false
          }
          drop run Effect.result(client.send(MockCmd.Notify { seq: s + 25 }))
          let readOk = match run client.call(MockCmd.Read { caller: cid, seq: s }) {
            Result<MockRep, RpcError>.Success { value } => match move value {
              MockRep.Clipboard { value: got } => got == cid * 20000 + s
              MockRep.Window { .. } => false
            }
            Result<MockRep, RpcError>.Failure { .. } => false
          }
          if !readOk {
            return false
          }
          s = s + 1
        }
        return true
      },
    )
      |> Effect.provideMut<Allocator>(&mut heap)
    run callers.append(move handle) |> Effect.provideMut<Allocator>(&mut heap)
    t = t + 1
  }

  let mut allMatched = true
  while callers.length() != 0 {
    let last = callers.length() - 1
    if !callers.remove(last).join() {
      allMatched = false
    }
  }
  run Testing.expect(allMatched, "interleaved multi-caller RPC routes every tagged reply cleanly")

  // Expected sum of (seq + 1) for seq in 0..50 across 4 threads = 4 * (50 * 51 / 2) = 5100.
  let observedFire = unsafe Atomic.load<u64>(fireSeen.get().ptr, MemoryOrder.Acquire)
  run Testing.expect(observedFire == 5100, "every fire-and-forget command reached the server")

  let shutdownClosed = match run client.call(MockCmd.Open { caller: 9, seq: 1 }) {
    Result<MockRep, RpcError>.Failure { error } => error == RpcError.Closed
    Result<MockRep, RpcError>.Success { .. } => false
  }
  run Testing.expect(shutdownClosed, "server shutdown wakes waiting caller with RpcError.Closed")
  serverThread.join()
}

test effect fn preAppKitInitialAppearanceAndHeadlessNudge() -> ()
  ! AssertionError<'static> {
  let appearance = initialAppearance()
  let known = match appearance {
    Appearance.Light => true
    Appearance.Dark => true
  }
  run Testing.expect(known, "initialAppearance reads OS appearance safely without AppKit")

  let platform = HostPlatform.headless()
  let nudge = platform.nudge()
  let copy = nudge.clone()
  copy.nudge()
  nudge.nudge()
  run Testing.expect(!platform.threaded(), "headless platform reports non-threaded")
}
