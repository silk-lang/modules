//! Compression with zlib's and Zstandard's formats in Silk and brotli in C: the runtime's real
//! `Compression` capability. zlib's streams write Node 24's bytes (ZLIB_NOTES.md).
//!
//! A program that provides `NativeCompression` depends on this package, and so compiles brotli;
//! a program that provides `EmptyCompression` has none of it.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjsruntime.libs.core.capabilities { Compression, Composition }
import silkjsruntime.libs.core.host { Services }
import silkjsruntime.ext.fs_async as fs_async
import ext.compression_native

/// zlib, Zstandard and brotli behind `node:zlib`, `CompressionStream` and `DecompressionStream`.
pub struct NativeCompression {
  state: ?*mut compression_native.State,
}
impl Copy for NativeCompression {}

impl NativeCompression {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> NativeCompression { return NativeCompression { state: Pointer.null<compression_native.State>() } }
  unsafe fn opened(self: &Self) -> *mut compression_native.State {
    if Pointer.isNull<compression_native.State>(self.state) { Intrinsic.trap("compression executor is not initialized") }
    return unsafe Intrinsic.pointerRequalify<?*mut compression_native.State, *mut compression_native.State>(self.state)
  }
}

impl Compression for NativeCompression {
  static fn present() -> bool { return true }
  fn forWorker(self: &Self) -> Self { return NativeCompression.make() }
  effect fn open(self: &mut Self) -> () ! OutOfMemoryError {
    // The C entry points the blocking pool calls are emitted only when something takes them.
    compression_native.keepExports()
    self.state = run compression_native.open()
  }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, id: u32, io: *mut fs_async.State, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if id == 2600 { return run unsafe compression_native.dispatch(&mut engine, context, unsafe self.opened(), argc, argv) }
    return run unsafe compression_native.submit(&mut engine, context, unsafe self.opened(), io, argc, argv)
  }
  unsafe effect fn poll<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe compression_native.poll(&mut engine, context, unsafe self.opened())
  }
  unsafe effect fn appendResources<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, array: ValueBits, index: &mut u32) -> ()
    ! JsException ? &mut Allocator {
    run unsafe compression_native.appendResources(&mut engine, context, unsafe self.opened(), array, &mut index)
  }
  unsafe fn openHandles(self: &Self) -> usize {
    return match Pointer.nonNullMut<compression_native.State>(self.state) {
      Option<*mut compression_native.State>.Some { value } => unsafe compression_native.openHandles(value)
      Option<*mut compression_native.State>.None => 0
    }
  }
  unsafe fn close<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, io: *mut fs_async.State) -> () {
    match Pointer.nonNullMut<compression_native.State>(self.state) {
      Option<*mut compression_native.State>.Some { value } => {
        unsafe compression_native.close(&mut engine, context, value, io)
        self.state = Pointer.null<compression_native.State>()
      }
      Option<*mut compression_native.State>.None => ()
    }
  }
}
