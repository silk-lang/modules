  run Testing.expect(emitted(&a, &mut at, b"\x49\x8b\x63\x08"), "mov rsp, qword ptr [r11 + 8]")
  run a.load(Width.W64, Reg.R11, Mem.at(Reg.R12, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x8b\x1c\x24"), "mov r11, qword ptr [r12]")
  run a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R12, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x49\x8b\x54\x24\x08"), "mov rdx, qword ptr [r12 + 8]")
  run a.load(Width.W64, Reg.R9, Mem.at(Reg.R13, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x8b\x4d\x00"), "mov r9, qword ptr [r13]")
