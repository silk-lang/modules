import lock
import silk.cli.task { TaskError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.json.scanner { JsonError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

test effect fn validatesExecutableBytes() -> () ! AssertionError<'static> {
  run Testing.expect(lock.matches(b"abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"), "SHA-256 accepts the pinned bytes")
  run Testing.expect(!lock.matches(b"abd", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"), "modified download and cache bytes are rejected")
  run Testing.expect(!lock.matches(b"abc", "ba7816"), "truncated digest cannot validate")
}

effect fn parseLocks() -> () ! JsonError | TaskError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let good = run lock.parse(b"{\"version\":\"4.3.5\",\"platforms\":{\"linux-x64\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"}}", "linux-x64")
  run Testing.expect(String.view(&good.version) == "4.3.5" && lock.matches(b"abc", String.view(&good.checksum)), "platform pin is read without changing the project lock")
  let cases = [
    "{\"version\":\"../4.3.5\",\"platforms\":{}}",
    "{\"version\":\"latest\",\"platforms\":{}}",
    "{\"version\":\"4.3.5\",\"platforms\":{}}",
    "{\"version\":\"4.3.5\",\"platforms\":{\"linux-x64\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015az\"}}",
  ]
  let mut i: usize = 0
  while i < cases.length {
    let outcome = run Effect.result(lock.parse(String.utf8Bytes(cases[i]), "linux-x64"))
    let rejected = match move outcome {
      Result.Success { value } => { drop value
        false }
      Result.Failure { error } => { drop error
        true }
    }
    run Testing.expect(rejected, "unsafe version, absent platform and invalid digest are rejected before downloading")
    i = i + 1
  }
}

test effect fn validatesProjectLock() -> () ! JsonError | TaskError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run parseLocks() |> Effect.provideMut<Allocator>(&mut allocator)
}
