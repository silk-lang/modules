} else {
  /// libuv's uv__stream_try_select is macOS's: elsewhere every descriptor goes to the queue.
  pub unsafe fn ioSelectIfRefused(memory: *mut u8) -> i32 { return 0 }
  unsafe fn selectWatch(state: *mut u8, wanted: i32) -> () {}
  unsafe fn selectRelease(handle: *mut Handle) -> () {}
}
/// The events a descriptor handle is watched for.
pub unsafe fn ioWatched(memory: *const u8) -> i32 {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  return h.registered
}
/// Whether a poll or descriptor handle of the loop watches `fd` (libuv's uv__fd_exists).
pub unsafe fn ioDescriptorWatched(loopMemory: *const u8, fd: i32) -> bool {
  let anchor = () let l = unsafe Pointer.borrow<(), Loop>(&anchor, unsafe Intrinsic.pointerReinterpret<*const u8, *const Loop>(loopMemory))
  let mut handle = l.first drop l
  while !Pointer.isNull<Handle>(handle) {
    let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(handle))
    if (h.kind == UV_POLL || (h.flags & IO) != 0) && h.fd == fd && h.registered != 0 && (h.flags & (CLOSING | CLOSED)) == 0 { return true }
    handle = h.next
  }
  return false
}
/// libuv's uv__handle_start and uv__handle_stop for a module that manages its handle's activity.
pub unsafe fn ioActivate(memory: *mut u8) -> () { unsafe start(unsafe handleOf(memory)) }
pub unsafe fn ioDeactivate(memory: *mut u8) -> () { unsafe stop(unsafe handleOf(memory)) }

// ---- Handles for other modules ----------------------------------------------------------------
/// Marks a handle as the loop's own: uv_walk does not report it and uv_loop_close does not wait for
/// it. It is also unreferenced, as libuv's internal handles are.
pub unsafe fn markInternal(memory: *mut u8) -> () {
  unsafe uv_unref(memory)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe handleOf(memory))
  h.flags = h.flags | INTERNAL
}
/// Marks a handle as standing for an addon's libuv record `outer`, which becomes its data word.
pub unsafe fn markAddon(memory: *mut u8, outer: *mut u8) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe handleOf(memory))
  h.flags = h.flags | ADDON h.data = outer
}
pub unsafe fn isAddon(memory: *const u8) -> bool {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  return (h.flags & ADDON) != 0
}
/// The loop a handle belongs to.
pub unsafe fn handleLoop(memory: *const u8) -> *mut u8 {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  return unsafe Intrinsic.pointerReinterpret<*mut Loop, *mut u8>(h.loop)
}
/// Whether a handle was closed and its close callback ran.
pub unsafe fn isClosed(memory: *const u8) -> bool {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  return (h.flags & CLOSED) != 0
}
/// The handles of a loop in uv_walk's order, including internal ones, for uv_print_all_handles:
/// `callback(handle, argument)` gets the loop's own record, whatever it stands for.
pub unsafe fn walkAll(memory: *mut u8, callback: WalkCallback, argument: *mut u8) -> () {
  let anchor = () let l = unsafe Pointer.borrow<(), Loop>(&anchor, unsafe loopOf(memory))
  let mut handle = l.first drop l
  while !Pointer.isNull<Handle>(handle) {
    let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(handle))
    let next = h.next drop h
    unsafe callback(unsafe bytesOf(unsafe nn(handle)), argument)
    handle = next
  }
}
/// Whether a handle is the loop's own (libuv's UV_HANDLE_INTERNAL).
pub unsafe fn isInternal(memory: *const u8) -> bool {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  return (h.flags & INTERNAL) != 0
}

// ---- Run --------------------------------------------------------------------------------------
// libuv's uv__io_poll: wait at most `timeout` milliseconds (-1 forever), dispatch the events, poll
// again without waiting while a full batch came back, and run signal watchers last. With idle-time
// metrics on, a first wait that does not block counts the events that were already waiting.
unsafe fn ioPoll(loop: *mut Loop, initial: i64) -> () {
  let mut anchor = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop)
  let queue = l.backend let base = l.time let metricsOn = l.idleMetrics let blockProfile = l.blockProfile
  drop l
  let mut count: i32 = 48
  let mut realTimeout = initial
  let mut timeout = initial
  let mut reset = false let mut userTimeout: i64 = 0
  if metricsOn { reset = true userTimeout = timeout timeout = 0 }
  let mut ready: [Ready; 64] = [Ready { tag: 0, events: 0 }; 64]
  while true {
    if timeout != 0 { unsafe metricsEnter(loop) }
    let l1 = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop) l1.waitTimeout = i64.toI32(timeout) drop l1
    let received = unsafe queueWait(loop, queue, &mut ready, timeout, blockProfile)
    unsafe updateTime(loop)
    let mut cycle = false
    if received <= 0 {
      if reset { timeout = userTimeout reset = false }
      else { if received == 0 { return } }
    } else {
      let mut events: u64 = 0
      let mut signals = false
      let mut index: usize = 0
      while index < i32.toUsize(received) {
        let item = ready[index]
        index = index + 1
        if item.tag == TAG_SIGNAL { signals = true events = events + 1 continue }
        if unsafe dispatch(loop, item) { events = events + 1 }
      }
      let l2 = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop)
      l2.events = l2.events + events
      if reset { timeout = userTimeout reset = false l2.eventsWaiting = l2.eventsWaiting + events }
      drop l2
      if signals { unsafe metricsLeave(loop) unsafe signalReady(loop) return }
      if events != 0 {
        count = count - 1
        if received == 64 && count != 0 { timeout = 0 cycle = true }
        else { return }
      }
    }
    if !cycle {
      if timeout == 0 { return }
      if timeout != -1 {
        let l3 = unsafe Pointer.borrow<(), Loop>(&anchor, loop)
        realTimeout = realTimeout - u64.toI64(l3.time - base) drop l3
        if realTimeout <= 0 { return }
        timeout = realTimeout
      }
    }
  }
}
// One event: true when it reached a callback (libuv counts those).
unsafe fn dispatch(loop: *mut Loop, item: Ready) -> bool {
  if item.tag == TAG_WAKE { unsafe metricsLeave(loop) unsafe asyncReady(loop) return true }
  if item.tag == TAG_INOTIFY { unsafe metricsLeave(loop) unsafe notifyReady(loop) return true }
  let target = unsafe addressPointer(item.tag)
  if Pointer.isNull<u8>(target) { return false }
  let handle = unsafe handleOf(unsafe nn(target))
  let second = () let h = unsafe Pointer.borrow<(), Handle>(&second, handle)
  let kind = h.kind drop h
  let io = (unsafe Pointer.borrow<(), Handle>(&second, handle)).flags & IO != 0
  if kind == UV_POLL || io { return unsafe pollReady(loop, handle, item.events) }
  static if Intrinsic.targetOperatingSystem() == "darwin" { if kind == UV_FS_EVENT { unsafe metricsLeave(loop) unsafe vnodeReady(handle, u32.shiftRight(i32.toU32(item.events), 16)) return true } }
  return false
}
/// Runs the loop as libuv 1.51's uv_run: `UV_RUN_DEFAULT` (0) until nothing keeps it alive or
/// `uv_stop`, `UV_RUN_ONCE` (1) for one iteration that may wait, `UV_RUN_NOWAIT` (2) for one that
/// does not. Each iteration runs pending callbacks, idle and prepare handles, waits, runs pending
/// callbacks again, check handles, close callbacks, and due timers. Returns whether the loop is
/// still alive.
pub unsafe fn uv_run(memory: *mut u8, mode: i32) -> i32 {
  let loop = unsafe loopOf(memory)
  let mut anchor = ()
  let mut running = unsafe alive(loop)
  if !running { unsafe updateTime(loop) }
  let l0 = unsafe Pointer.borrow<(), Loop>(&anchor, loop) let stopped0 = l0.stopped drop l0
  if mode == UV_RUN_DEFAULT && running && !stopped0 { unsafe updateTime(loop) unsafe runTimers(loop) }
  while running {
    let l = unsafe Pointer.borrow<(), Loop>(&anchor, loop)
    if l.stopped { break }
    let canSleep = Intrinsic.pointerIsNull<?*mut Pending>(l.pendingFirst) && Pointer.isNull<Handle>(l.idles)
    drop l
    unsafe runPending(loop)
    unsafe runPhase(loop, UV_IDLE)
    unsafe runPhase(loop, UV_PREPARE)
    let mut timeout: i64 = 0
    if (mode == UV_RUN_ONCE && canSleep) || mode == UV_RUN_DEFAULT { timeout = i32.toI64(unsafe backendTimeout(loop)) }
    let mut second = () let l2 = unsafe Pointer.borrowMut<(), Loop>(&mut second, loop) l2.loopCount = l2.loopCount + 1 drop l2
    unsafe ioPoll(loop, timeout)
    let mut rounds: i32 = 0
    while rounds < 8 && unsafe hasPending(loop) { unsafe runPending(loop) rounds = rounds + 1 }
    unsafe metricsLeave(loop)
    unsafe runPhase(loop, UV_CHECK)
    unsafe runClosing(loop)
    unsafe updateTime(loop)
    unsafe runTimers(loop)
    running = unsafe alive(loop)
    if mode == UV_RUN_ONCE || mode == UV_RUN_NOWAIT { break }
  }
  let mut third = () let l3 = unsafe Pointer.borrowMut<(), Loop>(&mut third, loop)
  l3.stopped = false
  if running { return 1 }
  return 0
}

