  l.backend = queue
  let mut wake: [i32; 2] = [-1; 2]
  let made = unsafe makePipe(&mut wake, true)
  if made != 0 { return made }
  let _a = unsafe close(l.wakeRead) let _b = unsafe close(l.wakeWrite) l.wakeRead = wake[0] l.wakeWrite = wake[1]
  let status = unsafe queueSet(queue, wake[0], TAG_WAKE, 0, UV_READABLE)
  if status != 0 { return status }
  if l.signalRead >= 0 {
    let mut ends: [i32; 2] = [-1; 2]
    let piped = unsafe makePipe(&mut ends, true)
    if piped != 0 { return piped }
    let _c = unsafe close(l.signalRead) let _d = unsafe close(l.signalWrite) l.signalRead = ends[0] l.signalWrite = ends[1]
    let added = unsafe queueSet(queue, ends[0], TAG_SIGNAL, 0, UV_READABLE)
    if added != 0 { return added }
  }
  drop l
  // Descriptor watchers go back in the new queue with the events they waited for, and signal
  // handles forget what the parent caught (libuv's uv__io_fork and uv__signal_loop_fork).
  let walk = () let l2 = unsafe Pointer.borrow<(), Loop>(&walk, loop)
  let mut handle = l2.first drop l2
  while !Pointer.isNull<Handle>(handle) {
    let mut second = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut second, unsafe nn(handle))
    if h.kind == UV_SIGNAL { h.caughtCount = 0 h.dispatchedCount = 0 }
    if (h.kind == UV_POLL || (h.flags & IO) != 0) && h.registered != 0 {
      let status2 = unsafe queueSet(queue, h.fd, usize.toU64(Pointer.address<Handle>(handle)), 0, h.registered)
      if status2 != 0 { return status2 }
    }
    handle = h.next
  }
  return unsafe watchFork(loop)
}

// ---- Handles ----------------------------------------------------------------------------------
unsafe fn blank(loop: *mut Loop, kind: i32) -> Handle {
  return Handle {
    data: Pointer.null<u8>(), loop: loop, kind: kind, flags: REFERENCED,
    previous: Pointer.null<Handle>(), next: Pointer.null<Handle>(), nextClosing: Pointer.null<Handle>(), closed: silkUvNoClose,
    fd: -1, registered: 0,
    woke: silkUvNoClose, pending: 0, nextAsync: Pointer.null<Handle>(),
    caught: silkUvNoSignal, signum: 0, caughtCount: 0, dispatchedCount: 0, nextSignal: Pointer.null<Handle>(),
    polled: silkUvNoPoll,
    exited: silkUvNoExit, pid: 0, status: 0, reaped: false, nextProcess: Pointer.null<Handle>(),
    changed: silkUvNoEvent, watch: -1, nextWatch: Pointer.null<Handle>(), path: Pointer.null<u8>(), serial: 0,
    statChanged: silkUvNoStat, context: Pointer.null<u8>(),
    fired: silkUvNoClose, due: 0, repeat: 0, order: 0, nextTimer: Pointer.null<Handle>(), nextPhase: Pointer.null<Handle>()
  }
}
// Writes a fresh handle of `kind` into `memory` (zeroed, or holding the caller's data word first)
// and links it into the loop's list.
unsafe fn initialize(loop: *mut Loop, memory: *mut u8, kind: i32) -> *mut Handle {
  let handle = unsafe handleOf(memory)
  // The caller's data word survives initialization, as in libuv: callers set it before or after.
  let before = () let old = unsafe Pointer.borrow<(), Handle>(&before, handle) let kept = old.data drop old
  let mut fresh = unsafe blank(loop, kind) fresh.data = kept
  unsafe Pointer.put<Handle>(handle, move fresh)
  // At the tail, as libuv's handle queue: uv_walk reports the oldest handle first.
  let mut anchor = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop)
  let mut second = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut second, handle)
  h.previous = l.last
  if Pointer.isNull<Handle>(l.last) { l.first = handle } else { let mut third = () let t = unsafe Pointer.borrowMut<(), Handle>(&mut third, unsafe nn(l.last)) t.next = handle }
  l.last = handle
  return handle
}
unsafe fn start(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if (h.flags & ACTIVE) != 0 { return }
  h.flags = h.flags | ACTIVE
  if (h.flags & REFERENCED) != 0 { let mut second = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut second, h.loop) l.active = l.active + 1 }
}
unsafe fn stop(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if (h.flags & ACTIVE) == 0 { return }
  h.flags = h.flags & (ACTIVE ^ 4294967295)
  if (h.flags & REFERENCED) != 0 { let mut second = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut second, h.loop) l.active = l.active - 1 }
}
pub unsafe fn uv_ref(memory: *mut u8) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe handleOf(memory))
  if (h.flags & REFERENCED) != 0 { return }
  h.flags = h.flags | REFERENCED
  if (h.flags & CLOSING) != 0 { return }
  if (h.flags & ACTIVE) != 0 { let mut second = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut second, h.loop) l.active = l.active + 1 }
}
pub unsafe fn uv_unref(memory: *mut u8) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe handleOf(memory))
  if (h.flags & REFERENCED) == 0 { return }
  h.flags = h.flags & (REFERENCED ^ 4294967295)
  if (h.flags & CLOSING) != 0 { return }
  if (h.flags & ACTIVE) != 0 { let mut second = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut second, h.loop) l.active = l.active - 1 }
}
pub unsafe fn uv_has_ref(memory: *const u8) -> i32 {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  if (h.flags & REFERENCED) != 0 { return 1 }
  return 0
}
pub unsafe fn uv_is_active(memory: *const u8) -> i32 {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  if (h.flags & ACTIVE) != 0 { return 1 }
  return 0
}
pub unsafe fn uv_is_closing(memory: *const u8) -> i32 {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  if (h.flags & (CLOSING | CLOSED)) != 0 { return 1 }
  return 0
}
pub unsafe fn uv_handle_get_data(memory: *const u8) -> ?*mut u8 {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  return h.data
}
pub unsafe fn uv_handle_set_data(memory: *mut u8, data: ?*mut u8) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe handleOf(memory))
  h.data = data
}
pub unsafe fn uv_handle_get_type(memory: *const u8) -> i32 {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  return h.kind
}
/// libuv's name of a handle kind, NUL-terminated.
pub unsafe fn uv_handle_type_name(kind: i32) -> *const u8 {
  if kind == UV_TIMER { let timer = b"timer\0" return Pointer.fromRef<u8>(&timer[0]) }
  let name: &[u8] = if kind == UV_ASYNC { b"async\0" } else { if kind == UV_FS_EVENT { b"fs_event\0" } else { if kind == UV_FS_POLL { b"fs_poll\0" } else { if kind == UV_POLL { b"poll\0" } else { if kind == UV_PROCESS { b"process\0" } else { if kind == UV_SIGNAL { b"signal\0" } else { b"unknown\0" } } } } } }
  return Pointer.fromRef<u8>(&name[0])
}
/// The descriptor of a poll or descriptor handle, as libuv's uv_fileno: UV_EINVAL for the other
/// kinds, UV_EBADF without a descriptor or once it closes.
pub unsafe fn uv_fileno(memory: *const u8, fd: *mut i32) -> i32 {
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe handleOfConst(memory))
  if h.kind != UV_POLL && (h.flags & IO) == 0 { return -22 }
  if (h.flags & (CLOSING | CLOSED)) != 0 || h.fd < 0 { return -9 }
  unsafe Pointer.write<i32>(fd, h.fd)
  return 0
}
/// Calls `callback(handle, argument)` for each open handle of the loop, oldest first, as libuv. A
/// handle that stands for an addon's record is reported as that record (its `data`).
pub unsafe fn uv_walk(memory: *mut u8, callback: WalkCallback, argument: *mut u8) -> () {
  let anchor = () let l = unsafe Pointer.borrow<(), Loop>(&anchor, unsafe loopOf(memory))
  let mut handle = l.first drop l
  while !Pointer.isNull<Handle>(handle) {
    let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(handle))
    let next = h.next let hidden = (h.flags & INTERNAL) != 0 let addon = (h.flags & ADDON) != 0 let outer = h.data drop h
    if !hidden { if addon { unsafe callback(unsafe nn(outer), argument) } else { unsafe callback(unsafe bytesOf(unsafe nn(handle)), argument) } }
    handle = next
  }
}
unsafe fn unlinkAsync(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let mut second = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut second, h.loop)
  if same(l.asyncs, handle) { l.asyncs = h.nextAsync h.nextAsync = Pointer.null<Handle>() return }
  let mut cursor = l.asyncs
  while !Pointer.isNull<Handle>(cursor) {
    let mut third = () let c = unsafe Pointer.borrowMut<(), Handle>(&mut third, unsafe nn(cursor))
    if same(c.nextAsync, handle) { c.nextAsync = h.nextAsync h.nextAsync = Pointer.null<Handle>() return }
    cursor = c.nextAsync
  }
}
unsafe fn makeClosePending(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let mut second = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut second, h.loop)
  h.nextClosing = l.closing l.closing = handle
}
/// Stops the handle and asks for its close callback, which runs in the closing phase of the next
/// `uv_run`. The memory must stay valid until then.
pub unsafe fn uv_close(memory: *mut u8, callback: CloseCallback) -> () {
  let handle = unsafe handleOf(memory)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if (h.flags & (CLOSING | CLOSED)) != 0 { return }
  let kind = h.kind h.closed = callback drop h
  if kind == UV_ASYNC { unsafe unlinkAsync(handle) unsafe stop(handle) }
  if kind == UV_SIGNAL { unsafe signalStop(handle) }
  if kind == UV_POLL { let _ignored = unsafe uv_poll_stop(memory) }
  if kind == UV_PROCESS { unsafe processClose(handle) }
  if kind == UV_FS_EVENT { let _ignored = unsafe uv_fs_event_stop(memory) }
  if kind == UV_FS_POLL { let _ignored = unsafe uv_fs_poll_stop(memory) }
  if kind == UV_TIMER { let _ignored = unsafe uv_timer_stop(memory) }
  if kind == UV_IDLE || kind == UV_PREPARE || kind == UV_CHECK { unsafe phaseStop(handle) }
  let io = (unsafe Pointer.borrow<(), Handle>(&anchor, handle)).flags & IO != 0
  if io { let _unwatched = unsafe ioWatch(memory, 0, silkUvNoPoll) unsafe selectRelease(handle) unsafe stop(handle) }
  let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  h2.flags = h2.flags | CLOSING
  // A stat poll closes once its last context is gone (libuv's uv__fs_poll_close).
  let waits = kind == UV_FS_POLL && !Pointer.isNull<u8>(h2.context)
  drop h2
  if !waits { unsafe makeClosePending(handle) }
}
unsafe fn runClosing(loop: *mut Loop) -> () {
  let mut anchor = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop)
  let mut handle = l.closing l.closing = Pointer.null<Handle>() drop l
  while !Pointer.isNull<Handle>(handle) {
    let pointer = unsafe nn(handle)
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, pointer)
    let next = h.nextClosing
    // Signals that the handler caught but the loop has not read yet still name this handle: it
    // closes after they are read, and until then keeps the loop turning, as in libuv.
    if h.kind == UV_SIGNAL && unsafe Atomic.load<u32>(Pointer.fromRef<u32>(&h.caughtCount), MemoryOrder.SequentiallyConsistent) != h.dispatchedCount {
      drop h unsafe makeClosePending(pointer) handle = next continue
    }
    h.flags = h.flags | CLOSED
    let before = h.previous let after = h.next let callback = h.closed
    h.previous = Pointer.null<Handle>() h.next = Pointer.null<Handle>() drop h
    if Pointer.isNull<Handle>(before) { let l2 = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop) l2.first = after }
    else { let b = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe nn(before)) b.next = after }
    if !Pointer.isNull<Handle>(after) { let a = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe nn(after)) a.previous = before }
    else { let l3 = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop) l3.last = before }
    unsafe callback(unsafe bytesOf(pointer))
    handle = next
  }
}

// ---- Async ------------------------------------------------------------------------------------
/// An async handle is active from its initialization, and so holds the loop while referenced.
pub unsafe fn uv_async_init(loopMemory: *mut u8, memory: *mut u8, callback: AsyncCallback) -> i32 {
  let loop = unsafe loopOf(loopMemory)
  let handle = unsafe initialize(loop, memory, UV_ASYNC)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let mut second = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut second, loop)
  // At the tail, as libuv's async handle queue: callbacks run oldest first.
  h.woke = callback h.nextAsync = Pointer.null<Handle>()
  if Pointer.isNull<Handle>(l.asyncs) { l.asyncs = handle }
  else {
    let mut cursor = unsafe nn(l.asyncs)
    while true { let mut third = () let c = unsafe Pointer.borrowMut<(), Handle>(&mut third, cursor) if Pointer.isNull<Handle>(c.nextAsync) { c.nextAsync = handle break } cursor = unsafe nn(c.nextAsync) }
  }
  drop h drop l
  unsafe start(handle)
  return 0
}
/// Asks the loop to call the handle's callback. Any thread, or a signal handler, may call it; sends
/// before the callback runs are one call.
pub unsafe fn uv_async_send(memory: *mut u8) -> i32 {
  let handle = unsafe handleOf(memory)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if unsafe Atomic.swap<u32>(Pointer.fromMutRef<u32>(&mut h.pending), 1, MemoryOrder.SequentiallyConsistent) != 0 { return 0 }
  let second = () let l = unsafe Pointer.borrow<(), Loop>(&second, h.loop)
  let fd = l.wakeWrite
  let one: [u8; 1] = [1]
  while true {
    let written = unsafe write(fd, Pointer.fromRef<u8>(&one[0]), 1)
    if written >= 0 { break }
    if unsafe errno() != EINTR { break }
  }
  return 0
}
unsafe fn asyncReady(loop: *mut Loop) -> () {
  let anchor = () let l = unsafe Pointer.borrow<(), Loop>(&anchor, loop)
  let fd = l.wakeRead drop l
  let mut buffer: [u8; 1024] = [0; 1024]
  while true {
    let count = unsafe read(fd, Pointer.fromMutRef<u8>(&mut buffer[0]), 1024)
    if count == 1024 { continue }
    if count >= 0 { break }
    if unsafe errno() != EINTR { break }
  }
  // Finished thread-pool work first: libuv's wq_async is the loop's first async handle.
  unsafe workDone(loop)
  // A callback may close or start async handles, so each step looks for the next one afresh.
  let mut second = () let l2 = unsafe Pointer.borrowMut<(), Loop>(&mut second, loop)
  l2.serial = l2.serial + 1 let serial = l2.serial drop l2
  while true {
    let l3 = unsafe Pointer.borrow<(), Loop>(&anchor, loop)
    let mut cursor = l3.asyncs drop l3
    let mut found: ?*mut Handle = Pointer.null<Handle>()
    while !Pointer.isNull<Handle>(cursor) {
      let mut third = () let c = unsafe Pointer.borrowMut<(), Handle>(&mut third, unsafe nn(cursor))
      if c.serial != serial { c.serial = serial found = cursor break }
      cursor = c.nextAsync
    }
    if Pointer.isNull<Handle>(found) { return }
    let pointer = unsafe nn(found)
    let mut fourth = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut fourth, pointer)
    let callback = h.woke
    let fired = unsafe Atomic.swap<u32>(Pointer.fromMutRef<u32>(&mut h.pending), 0, MemoryOrder.SequentiallyConsistent) != 0
    drop h
    if fired { unsafe callback(unsafe bytesOf(pointer)) }
  }
}

// ---- Poll -------------------------------------------------------------------------------------
/// Watches a socket descriptor, which it makes nonblocking, as libuv does.
pub unsafe fn uv_poll_init_socket(loopMemory: *mut u8, memory: *mut u8, fd: i32) -> i32 {
  if unsafe fcntl(fd, F_GETFL) < 0 { return -(unsafe errno()) }
  unsafe nonblocking(fd, true)
  let handle = unsafe initialize(unsafe loopOf(loopMemory), memory, UV_POLL)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  h.fd = fd
  return 0
}
/// Starts, or changes, the events (`UV_READABLE` 1, `UV_WRITABLE` 2, `UV_DISCONNECT` 4,
/// `UV_PRIORITIZED` 8) that call `callback(handle, status, events)`. No events stops the handle.
pub unsafe fn uv_poll_start(memory: *mut u8, events: i32, callback: PollCallback) -> i32 {
  return unsafe pollStart(memory, events, callback, false)
}
/// uv_poll_start for addons (ext.uv_api_loop): on macOS the additions wait for the next wait's
/// kevent call, as libuv's kqueue backend, so filters report in libuv's order and a refused
/// EV_OOBAND arrives first. The runtime's own poll handles (process IPC) register at once: one may
/// start from another thread than the one waiting, and must not wait for that wait to end.
pub unsafe fn uv_poll_start_deferred(memory: *mut u8, events: i32, callback: PollCallback) -> i32 {
  return unsafe pollStart(memory, events, callback, true)
}
unsafe fn pollStart(memory: *mut u8, events: i32, callback: PollCallback, deferred: bool) -> i32 {
  let handle = unsafe handleOf(memory)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if (h.flags & (CLOSING | CLOSED)) != 0 { return -22 }
  let wanted = events & (UV_READABLE | UV_WRITABLE | UV_DISCONNECT | UV_PRIORITIZED)
  let loop = h.loop let fd = h.fd let previous = h.registered drop h
  let tag = usize.toU64(Pointer.address<Handle>(handle))
  let status = if deferred { unsafe queueSetLoop(loop, fd, tag, previous, wanted) } else {
    let anchorLoop = () let l = unsafe Pointer.borrow<(), Loop>(&anchorLoop, loop) let queue = l.backend drop l
    unsafe queueSet(queue, fd, tag, previous, wanted)
  }
  if status != 0 { return status }
  let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  h2.registered = wanted h2.polled = callback drop h2
  if wanted == 0 { unsafe stop(handle) } else { unsafe start(handle) }
  return 0
}
pub unsafe fn uv_poll_stop(memory: *mut u8) -> i32 {
  let handle = unsafe handleOf(memory)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let loop = h.loop let fd = h.fd let previous = h.registered h.registered = 0 drop h
  if previous != 0 { let _ignored = unsafe queueSetLoop(loop, fd, 0, previous, 0) }
  unsafe stop(handle)
  return 0
}
unsafe fn pollReady(loop: *mut Loop, handle: *mut Handle, ready: i32) -> bool {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if (h.flags & IO) != 0 {
    if h.registered == 0 { return false }
    let callback = h.polled let registered = h.registered
    let mut events = ready & registered
    // libuv's epoll quirk: an error or hangup alone wakes every event the watcher waits for.
    if (ready & QUEUE_ERROR) != 0 { events = events | registered | IO_ERROR | (ready & IO_HANGUP) }
    drop h
    if events == 0 { return false }
    unsafe metricsLeave(loop)
    unsafe callback(unsafe bytesOf(handle), 0, events)
    return true
  }
  if h.kind != UV_POLL || (h.flags & (CLOSING | CLOSED)) != 0 || h.registered == 0 { return false }
  let callback = h.polled let registered = h.registered
  let mut events = ready & registered
  // An error or hangup alone reports every event the handle waits for, as libuv's io poll does.
  if (ready & QUEUE_ERROR) != 0 { events = events | registered }
  if (ready & QUEUE_FAULT) != 0 && (events & UV_PRIORITIZED) == 0 {
    drop h
    unsafe metricsLeave(loop)
    let _ignored = unsafe uv_poll_stop(unsafe bytesOf(handle))
    unsafe callback(unsafe bytesOf(handle), -9, 0)
    return true
  }
  drop h
  if events == 0 { return false }
  unsafe metricsLeave(loop)
  unsafe callback(unsafe bytesOf(handle), 0, events)
  return true
}

// ---- Signals ----------------------------------------------------------------------------------
// The process-wide table: per signal, the started handles of every loop. The handler and the
// loops share it under `lock`; a thread that is not the handler blocks all signals before it takes
// the lock, so the handler never interrupts a holder on its own thread.
struct SignalTable { lock: u32, heads: [?*mut Handle; 65] }
unsafe fn addressPointer(address: u64) -> ?*mut u8 {
  let word = u64.toUsize(address)
  return unsafe Pointer.read<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*const usize, *const ?*mut u8>(Pointer.fromRef<usize>(&word)))
}
unsafe fn signalTable(create: bool) -> ?*mut SignalTable {
  let word = Intrinsic.processWord()
  let current = unsafe Atomic.load<u64>(word, MemoryOrder.Acquire)
  if current != 0 { return unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut SignalTable>(unsafe addressPointer(current)) }
  if !create { return Pointer.null<SignalTable>() }
  let made = unsafe calloc(1, Layout.of<SignalTable>().bytes)
  if Pointer.isNull<u8>(made) { return Pointer.null<SignalTable>() }
  let raced = unsafe Atomic.compareExchange<u64>(word, 0, usize.toU64(Pointer.address<u8>(made)), MemoryOrder.AcquireRelease, MemoryOrder.Acquire)
  match move raced {
    CompareExchange<u64>.Exchanged => { return unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut SignalTable>(made) }
    CompareExchange<u64>.Observed { value } => { unsafe free(made) return unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut SignalTable>(unsafe addressPointer(value)) }
  }
}
unsafe fn tableLock(table: *mut SignalTable) -> () {
  let mut anchor = () let t = unsafe Pointer.borrowMut<(), SignalTable>(&mut anchor, table)
  while unsafe Atomic.swap<u32>(Pointer.fromMutRef<u32>(&mut t.lock), 1, MemoryOrder.Acquire) != 0 {}
}
unsafe fn tableUnlock(table: *mut SignalTable) -> () {
  let mut anchor = () let t = unsafe Pointer.borrowMut<(), SignalTable>(&mut anchor, table)
  unsafe Atomic.store<u32>(Pointer.fromMutRef<u32>(&mut t.lock), 0, MemoryOrder.Release)
}
unsafe fn blockAndLock(table: *mut SignalTable, saved: &mut [u8; 128]) -> () {
  let all: [u8; 128] = [255; 128]
  if unsafe pthread_sigmask(SIG_SETMASK, Pointer.fromRef<u8>(&all[0]), Pointer.fromMutRef<u8>(&mut saved[0])) != 0 { unsafe abort() }
  unsafe tableLock(table)
}
unsafe fn unlockAndRestore(table: *mut SignalTable, saved: &[u8; 128]) -> () {
  unsafe tableUnlock(table)
  if unsafe pthread_sigmask(SIG_SETMASK, Pointer.fromRef<u8>(&saved[0]), Pointer.null<u8>()) != 0 { unsafe abort() }
}
/// The one signal handler. It only writes: a 16-byte message (handle address, signal number) into
/// the pipe of each watching handle's loop. A full pipe drops the message, as in libuv.
export "C" fn silkUvSignalHandler(signum: i32) -> () {
  if signum <= 0 || signum > 64 { return }
  let saved = unsafe errno()
  let found = unsafe signalTable(false)
  if Pointer.isNull<SignalTable>(found) { return }
  let table = unsafe nn(found)
  unsafe tableLock(table)
  let anchor = () let t = unsafe Pointer.borrow<(), SignalTable>(&anchor, table)
  let mut handle = t.heads[i32.toUsize(signum)]
  while !Pointer.isNull<Handle>(handle) {
    let mut second = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut second, unsafe nn(handle))
    let l = unsafe Pointer.borrow<(), Loop>(&anchor, h.loop)
    let message: [u64; 2] = [usize.toU64(Pointer.address<Handle>(handle)), i32.toU64(signum)]
    let mut written: isize = -1
    while true {
      written = unsafe write(l.signalWrite, unsafe Intrinsic.pointerReinterpret<*const u64, *const u8>(Pointer.fromRef<u64>(&message[0])), 16)
      if written >= 0 || unsafe errno() != EINTR { break }
    }
    if written == 16 { let _count = unsafe Atomic.fetchAdd<u32>(Pointer.fromMutRef<u32>(&mut h.caughtCount), 1, MemoryOrder.SequentiallyConsistent) }
    handle = h.nextSignal
  }
  drop t
  unsafe tableUnlock(table)
  unsafe setErrno(saved)
}
pub unsafe fn uv_signal_init(loopMemory: *mut u8, memory: *mut u8) -> i32 {
  let _handle = unsafe initialize(unsafe loopOf(loopMemory), memory, UV_SIGNAL)
  return 0
}
// libuv's order of the watchers of one signal (uv__signal_compare): the repeating ones first, then
// by loop address, then by handle address.
