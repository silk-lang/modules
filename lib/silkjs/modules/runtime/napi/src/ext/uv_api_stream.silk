const W_HANDLE: usize = 80
const W_NEXT: usize = 88
const W_INDEX: usize = 104
const W_BUFS: usize = 112
const W_NBUFS: usize = 120
const W_ERROR: usize = 124
const W_BUFSML: usize = 128
// uv_connect_t: cb, handle. uv_shutdown_t: handle, cb.
const C_CB: usize = 64
const C_HANDLE: usize = 72
const SH_HANDLE: usize = 64
const SH_CB: usize = 72
// uv_udp_send_t: handle, cb, then libuv's private queue, address storage, nbufs, bufs, status,
// send_cb and bufsml[4].
const US_HANDLE: usize = 64
const US_CB: usize = 72
const US_NEXT: usize = 80
const US_ADDRESS: usize = 96
const US_NBUFS: usize = 224
const US_BUFS: usize = 232
const US_STATUS: usize = 240
const US_SEND_CB: usize = 248
const US_BUFSML: usize = 256

// ---- Raw memory -----------------------------------------------------------------------------------
unsafe fn nn(pointer: ?*mut u8) -> *mut u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer) }
unsafe fn offset(base: *mut u8, by: usize) -> *mut u8 { return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), by) }
unsafe fn cell<T>(base: *mut u8, by: usize) -> *mut T { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe offset(base, by)) }
unsafe fn get<T: Copy>(base: *mut u8, by: usize) -> T { return unsafe Pointer.read<T>(unsafe cell<T>(base, by)) }
unsafe fn set<T: Copy>(base: *mut u8, by: usize, value: T) -> () { unsafe Pointer.write<T>(unsafe cell<T>(base, by), value) }
unsafe fn ptr(base: *mut u8, by: usize) -> ?*mut u8 { return unsafe get<?*mut u8>(base, by) }
unsafe fn setPtr(base: *mut u8, by: usize, value: ?*mut u8) -> () { unsafe set<?*mut u8>(base, by, value) }
unsafe fn words(pointer: *mut u64) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(pointer) }
unsafe fn wordsConst(pointer: *mut u64) -> *const u8 { return unsafe Intrinsic.pointerRequalify<*mut u8, *const u8>(unsafe words(pointer)) }
unsafe fn constant(pointer: *const u8) -> *mut u8 { return unsafe Intrinsic.pointerRequalify<*const u8, *mut u8>(pointer) }
unsafe fn fromAddress(address: usize) -> *mut u8 {
  return unsafe Pointer.read<*mut u8>(unsafe Intrinsic.pointerReinterpret<*const usize, *const *mut u8>(Pointer.fromRef<usize>(&address)))
}
fn same(a: ?*mut u8, b: ?*mut u8) -> bool { return Pointer.address<u8>(a) == Pointer.address<u8>(b) }
fn isNull(a: ?*mut u8) -> bool { return Pointer.isNull<u8>(a) }
fn none() -> ?*mut u8 { return Pointer.null<u8>() }
fn text(bytes: &[u8]) -> *const u8 { return Pointer.fromRef<u8>(&bytes[0]) }
unsafe fn bufAt(bufs: *mut u8, index: usize) -> *mut Buf { return unsafe cell<Buf>(bufs, index * 16) }
unsafe fn countBufs(bufs: *mut u8, count: usize) -> usize {
  let mut total: usize = 0 let mut index: usize = 0
  while index < count { total = total + (unsafe Pointer.read<Buf>(unsafe bufAt(bufs, index))).len index = index + 1 }
  return total
}

// ---- Handle state -------------------------------------------------------------------------------
unsafe fn kindOf(outer: *mut u8) -> i32 { return unsafe get<i32>(outer, H_TYPE) }
unsafe fn loopOf(outer: *mut u8) -> *mut u8 { return unsafe nn(unsafe ptr(outer, H_LOOP)) }
// The inner handle, or null once the record closed (or before it was initialized): then the
// record reads as libuv's closed handle, without a descriptor.
unsafe fn innerOf(outer: *mut u8) -> ?*mut u8 { return unsafe abi.liveInner(outer) }
unsafe fn flags(outer: *mut u8) -> usize { return u32.toUsize(unsafe get<u32>(outer, H_FLAGS)) }
unsafe fn setFlags(outer: *mut u8, value: usize) -> () { unsafe set<u32>(outer, H_FLAGS, usize.wrappingToU32(value)) }
unsafe fn has(outer: *mut u8, bits: usize) -> bool { return (unsafe flags(outer) & bits) != 0 }
unsafe fn raise(outer: *mut u8, bits: usize) -> () { unsafe setFlags(outer, unsafe flags(outer) | bits) }
unsafe fn lower(outer: *mut u8, bits: usize) -> () { unsafe setFlags(outer, unsafe flags(outer) & (bits ^ 18446744073709551615)) }
// The stream's descriptor (libuv's io_watcher.fd), kept in the inner handle.
unsafe fn fdOf(outer: *mut u8) -> i32 {
  let inner = unsafe innerOf(outer)
  if isNull(inner) { return -1 }
  return unsafe uvl.ioDescriptor(unsafe nn(inner))
}
unsafe fn setFd(outer: *mut u8, fd: i32) -> () {
  let inner = unsafe innerOf(outer)
  if !isNull(inner) { unsafe uvl.ioSetDescriptor(unsafe nn(inner), fd) }
}
// libuv's uv__stream_try_select (macOS): a descriptor kqueue refuses gets a select() thread.
unsafe fn trySelect(outer: *mut u8) -> i32 {
  let inner = unsafe innerOf(outer)
  if isNull(inner) { return 0 }
  return unsafe uvl.ioSelectIfRefused(unsafe nn(inner))
}
unsafe fn closing(outer: *mut u8) -> bool {
  let inner = unsafe innerOf(outer)
  if isNull(inner) { return (unsafe abi.recordFlags(outer) & abi.RECORD_CLOSING) != 0 }
  return unsafe uvl.uv_is_closing(unsafe nn(inner)) != 0
}
// libuv's uv__io_start, uv__io_stop and uv__io_active on the record's watcher.
unsafe fn ioStart(outer: *mut u8, events: i32) -> () {
  let live = unsafe innerOf(outer)
  if isNull(live) { return }
  let inner = unsafe nn(live)
  let _ignored = unsafe uvl.ioWatch(inner, unsafe uvl.ioWatched(inner) | events, silkUvStreamIo)
}
unsafe fn ioStop(outer: *mut u8, events: i32) -> () {
  let live = unsafe innerOf(outer)
  if isNull(live) { return }
  let inner = unsafe nn(live)
  let _ignored = unsafe uvl.ioWatch(inner, unsafe uvl.ioWatched(inner) & (events ^ -1), silkUvStreamIo)
}
unsafe fn ioActive(outer: *mut u8, events: i32) -> bool {
  let inner = unsafe innerOf(outer)
  if isNull(inner) { return false }
  return (unsafe uvl.ioWatched(unsafe nn(inner)) & events) != 0
}
unsafe fn handleStart(outer: *mut u8) -> () { let inner = unsafe innerOf(outer) if !isNull(inner) { unsafe uvl.ioActivate(unsafe nn(inner)) } }
unsafe fn handleStop(outer: *mut u8) -> () { let inner = unsafe innerOf(outer) if !isNull(inner) { unsafe uvl.ioDeactivate(unsafe nn(inner)) } }
// libuv's uv__io_feed: the watcher's callback runs with POLLOUT in the next pending phase.
unsafe fn feed(outer: *mut u8) -> () {
  let by = if unsafe kindOf(outer) == UV_UDP { U_PENDING } else { S_PENDING }
  unsafe uvl.pendingQueue(unsafe loopOf(outer), unsafe cell<uvl.Pending>(outer, by))
}
// libuv's uv__io_close: no watch, and out of the pending queue.
unsafe fn ioClose(outer: *mut u8) -> () {
  if isNull(unsafe innerOf(outer)) { return }
  unsafe ioStop(outer, POLLIN | POLLOUT | 4 | 8)
  let by = if unsafe kindOf(outer) == UV_UDP { U_PENDING } else { S_PENDING }
  unsafe uvl.pendingCancel(unsafe loopOf(outer), unsafe cell<uvl.Pending>(outer, by))
}
unsafe fn isIpc(outer: *mut u8) -> bool { return unsafe kindOf(outer) == UV_NAMED_PIPE && unsafe get<i32>(outer, PIPE_IPC) != 0 }
// libuv's uv__req_init and uv__req_unregister.
unsafe fn requestInit(loop: *mut u8, request: *mut u8, kind: i32) -> () {
  unsafe set<i32>(request, R_TYPE, kind)
  unsafe uvl.requestStarted(loop)
}
unsafe fn requestDone(loop: *mut u8) -> () { unsafe uvl.requestFinished(loop) }
unsafe fn callStatus(callback: Status, target: *mut u8, status: i32) -> () {
  if Intrinsic.pointerIsNull<Status>(callback) { return }
  let present = unsafe Intrinsic.pointerRequalify<Status, StatusFn>(callback)
  unsafe present(target, status)
}
unsafe fn callRead(outer: *mut u8, count: isize, buf: *const Buf) -> () {
  let callback = unsafe get<Read>(outer, S_READ)
  if Intrinsic.pointerIsNull<Read>(callback) { return }
  let present = unsafe Intrinsic.pointerRequalify<Read, ReadFn>(callback)
  unsafe present(outer, count, buf)
}
unsafe fn callAlloc(callback: Alloc, outer: *mut u8, suggested: usize, buf: *mut Buf) -> () {
  if Intrinsic.pointerIsNull<Alloc>(callback) { return }
  let present = unsafe Intrinsic.pointerRequalify<Alloc, AllocFn>(callback)
  unsafe present(outer, suggested, buf)
}
unsafe fn callRecv(outer: *mut u8, count: isize, buf: *const Buf, address: ?*const u8, bits: u32) -> () {
  let callback = unsafe get<Recv>(outer, U_RECV)
  if Intrinsic.pointerIsNull<Recv>(callback) { return }
  let present = unsafe Intrinsic.pointerRequalify<Recv, RecvFn>(callback)
  unsafe present(outer, count, buf, address, bits)
}

// ---- Descriptors ----------------------------------------------------------------------------------
// libuv's uv__close: closes, keeping errno.
unsafe fn closeFd(fd: i32) -> () {
  let saved = unsafe errno()
  let _ignored = unsafe close(fd)
  unsafe setErrno(saved)
}
// libuv's uv__nonblock (the FIONBIO ioctl on both targets).
unsafe fn nonblock(fd: i32, on: bool) -> i32 {
  let mut value: i32 = if on { 1 } else { 0 }
  while true {
    if unsafe ioctl(fd, FIONBIO, Pointer.fromMutRef<i32>(&mut value)) == 0 { return 0 }
    if unsafe errno() != EINTR { return -(unsafe errno()) }
  }
  return 0
}
unsafe fn cloexec(fd: i32) -> i32 {
  while true {
    if unsafe fcntl(fd, F_SETFD, FD_CLOEXEC) == 0 { return 0 }
    if unsafe errno() != EINTR { return -(unsafe errno()) }
  }
  return 0
}
unsafe fn openCloexec(path: *const u8, flags: i32) -> i32 {
  let fd = unsafe open(path, flags | O_CLOEXEC)
  if fd < 0 { return -(unsafe errno()) }
  return fd
}
// libuv's uv__socket: nonblocking and close-on-exec, atomically where the kernel can.
unsafe fn newSocket(domain: i32, kind: i32, protocol: i32) -> i32 {
  static if Intrinsic.targetOperatingSystem() != "darwin" {
    let fast = unsafe socket(domain, kind | SOCK_NONBLOCK | SOCK_CLOEXEC, protocol)
    if fast != -1 { return fast }
    if unsafe errno() != EINVAL { return -(unsafe errno()) }
  }
  let fd = unsafe socket(domain, kind, protocol)
  if fd == -1 { return -(unsafe errno()) }
  let mut err = unsafe nonblock(fd, true)
  if err == 0 { err = unsafe cloexec(fd) }
  if err != 0 { unsafe closeFd(fd) return err }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    let on: i32 = 1
    let _ignored = unsafe setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, unsafe intBytes(&on), 4)
  }
  return fd
}
// libuv's uv__accept.
unsafe fn acceptFd(fd: i32) -> i32 {
  while true {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      let peer = unsafe accept(fd, none(), Pointer.null<u32>())
      if peer != -1 {
        let mut err = unsafe cloexec(peer)
        if err == 0 { err = unsafe nonblock(peer, true) }
        if err != 0 { unsafe closeFd(peer) return err }
        return peer
      }
    } else {
      let peer = unsafe accept4(fd, none(), Pointer.null<u32>(), SOCK_NONBLOCK | SOCK_CLOEXEC)
      if peer != -1 { return peer }
    }
    if unsafe errno() != EINTR { return -(unsafe errno()) }
  }
  return -EINVAL
}
unsafe fn intBytes(value: &i32) -> *const u8 { return unsafe Intrinsic.pointerReinterpret<*const i32, *const u8>(Pointer.fromRef<i32>(value)) }
unsafe fn setInt(fd: i32, level: i32, option: i32, value: i32) -> i32 {
  let on = value
  if unsafe setsockopt(fd, level, option, unsafe intBytes(&on), 4) != 0 { return -(unsafe errno()) }
  return 0
}
// libuv's uv__sock_reuseport: SO_REUSEPORT on Linux; macOS's does not balance, so UV_ENOTSUP.
unsafe fn reusePort(fd: i32) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return -ENOTSUP } else { return unsafe setInt(fd, SOL_SOCKET, SO_REUSEPORT, 1) }
}
// libuv's uv__sock_reuseaddr: SO_REUSEPORT on macOS (the BSD meaning), SO_REUSEADDR on Linux.
unsafe fn reuseAddress(fd: i32) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return unsafe setInt(fd, SOL_SOCKET, SO_REUSEPORT, 1) } else { return unsafe setInt(fd, SOL_SOCKET, SO_REUSEADDR, 1) }
}
// libuv's uv__tcp_keepalive (1.52's form, with all three intervals).
unsafe fn keepalive(fd: i32, on: bool, idle: u32, interval: u32, count: u32) -> i32 {
  let err = unsafe setInt(fd, SOL_SOCKET, SO_KEEPALIVE, if on { 1 } else { 0 })
  if err != 0 { return err }
  if !on { return 0 }
  if idle < 1 || interval < 1 || count < 1 { return -EINVAL }
  let a = unsafe setInt(fd, IPPROTO_TCP, TCP_KEEPIDLE, u32.wrappingToI32(idle))
  if a != 0 { return a }
  let b = unsafe setInt(fd, IPPROTO_TCP, TCP_KEEPINTVL, u32.wrappingToI32(interval))
  if b != 0 { return b }
  return unsafe setInt(fd, IPPROTO_TCP, TCP_KEEPCNT, u32.wrappingToI32(count))
}
// The address length libuv derives from a sockaddr's family (sockaddr_in or sockaddr_in6).
unsafe fn inetLength(address: *const u8) -> u32 {
  let family = familyOf(address)
  if family == AF_INET { return 16 }
  if family == AF_INET6 { return 28 }
  return 0
}

// The descriptor the EMFILE trick closes to accept and drop pending connections (libuv's
// loop->emfile_fd), one per process, kept as descriptor + 1 in this function's process word.
unsafe fn reserveWord() -> *mut u64 { return Intrinsic.processWord() }
unsafe fn reserveOpen() -> () {
  let word = unsafe reserveWord()
  if unsafe Atomic.load<u64>(word, MemoryOrder.Acquire) != 0 { return }
  let mut fd = unsafe openCloexec(text(b"/dev/null\0"), O_RDONLY)
  if fd < 0 { fd = unsafe openCloexec(text(b"/\0"), O_RDONLY) }
  if fd < 0 { return }
  let raced = unsafe Atomic.compareExchange<u64>(word, 0, i32.toU64(fd) + 1, MemoryOrder.AcquireRelease, MemoryOrder.Acquire)
  match move raced {
    CompareExchange<u64>.Exchanged => {}
    CompareExchange<u64>.Observed { value } => { let _unused = value unsafe closeFd(fd) }
  }
}
// libuv's uv__emfile_trick.
unsafe fn emfileTrick(acceptFdValue: i32) -> i32 {
  let word = unsafe reserveWord()
  let stored = unsafe Atomic.swap<u64>(word, 0, MemoryOrder.AcquireRelease)
  if stored == 0 { return -EMFILE }
  unsafe closeFd(u64.toI32(stored - 1))
  let mut err: i32 = 0
  while true {
    err = unsafe acceptFd(acceptFdValue)
    if err >= 0 { unsafe closeFd(err) continue }
    if err != -EINTR { break }
  }
  let fd = unsafe openCloexec(text(b"/\0"), O_RDONLY)
  if fd >= 0 { unsafe Atomic.store<u64>(word, i32.toU64(fd) + 1, MemoryOrder.Release) }
  return err
}

// ---- Stream lifetime ----------------------------------------------------------------------------
// The record of a stream or UDP handle: the head (ext.uv_api_abi), its inner descriptor handle,
// this module's `finish` hook and pending node.
unsafe fn handleInit(loop: *mut u8, outer: *mut u8, kind: i32) -> i32 {
  let inner = unsafe abi.prepare(loop, outer, kind)
  if isNull(inner) { return -ENOMEM }
  unsafe uvl.ioInit(loop, unsafe nn(inner), kind)
  unsafe abi.bind(outer, unsafe nn(inner))
  unsafe setFlags(outer, 0)
  if kind == UV_UDP {
    unsafe set<Close>(outer, H_FINISH, silkUvUdpFinish)
    unsafe Pointer.put<uvl.Pending>(unsafe cell<uvl.Pending>(outer, U_PENDING), uvl.Pending { next: Pointer.null<uvl.Pending>(), call: silkUvUdpFed, queued: 0, reserved: 0 })
  } else {
    unsafe set<Close>(outer, H_FINISH, silkUvStreamFinish)
    unsafe Pointer.put<uvl.Pending>(unsafe cell<uvl.Pending>(outer, S_PENDING), uvl.Pending { next: Pointer.null<uvl.Pending>(), call: silkUvStreamFed, queued: 0, reserved: 0 })
  }
  return 0
}
// libuv's uv__stream_init.
unsafe fn streamInit(loop: *mut u8, outer: *mut u8, kind: i32) -> i32 {
  let status = unsafe handleInit(loop, outer, kind)
  if status != 0 { return status }
  unsafe set<Read>(outer, S_READ, Intrinsic.pointerNullFunction<Read>())
  unsafe set<Alloc>(outer, S_ALLOC, Intrinsic.pointerNullFunction<Alloc>())
  unsafe set<Status>(outer, S_CONNECTION, Intrinsic.pointerNullFunction<Status>())
  unsafe setPtr(outer, S_CONNECT_REQ, none()) unsafe setPtr(outer, S_SHUTDOWN_REQ, none())
  unsafe set<i32>(outer, S_ACCEPTED_FD, -1) unsafe setPtr(outer, S_QUEUED_FDS, none())
  unsafe set<i32>(outer, S_DELAYED_ERROR, 0)
  unsafe setPtr(outer, S_WRITE_FIRST, none()) unsafe setPtr(outer, S_WRITE_LAST, none())
  unsafe setPtr(outer, S_DONE_FIRST, none()) unsafe setPtr(outer, S_DONE_LAST, none())
  unsafe set<usize>(outer, S_WRITE_QUEUE_SIZE, 0)
  unsafe set<i32>(outer, S_TTY_MODE, 0)
  unsafe reserveOpen()
  return 0
}
// libuv's uv__stream_open: `flags` are READABLE and WRITABLE.
unsafe fn streamOpenFlags(outer: *mut u8, fd: i32, bits: usize) -> i32 {
  let current = unsafe fdOf(outer)
  if !(current == -1 || current == fd) { return -EBUSY }
  unsafe raise(outer, bits)
  if unsafe kindOf(outer) == UV_TCP {
    if unsafe has(outer, TCP_NODELAY_FLAG) { let err = unsafe setInt(fd, IPPROTO_TCP, TCP_NODELAY, 1) if err != 0 { return err } }
    if unsafe has(outer, TCP_KEEPALIVE_FLAG) { let err2 = unsafe keepalive(fd, true, 60, 1, 10) if err2 != 0 { return err2 } }
  }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    if unsafe setInt(fd, SOL_SOCKET, SO_OOBINLINE, 1) != 0 {
      let code = unsafe errno()
      if code != ENOTSOCK && code != EINVAL { return -code }
    }
  }
  unsafe setFd(outer, fd)
  return 0
}
/// libuv's uv__process_open_stream for a UV_CREATE_PIPE stdio slot of uv_spawn: `outer` is a
/// uv_pipe_init'ed record and `fd` the parent's end of the socket pair (made close-on-exec by the
/// caller, as uv_socketpair does). The descriptor becomes nonblocking, then the stream's, readable
/// and writable as asked (libuv's UV_HANDLE_READABLE for UV_WRITABLE_PIPE and UV_HANDLE_WRITABLE
/// for UV_READABLE_PIPE). 0, or a negative errno.
pub unsafe fn streamOpen(outer: *mut u8, fd: i32, readable: bool, writable: bool) -> i32 {
  let _ignored = unsafe nonblock(fd, true)
  let mut bits: usize = 0
  if readable { bits = bits | READABLE }
  if writable { bits = bits | WRITABLE }
  return unsafe streamOpenFlags(outer, fd, bits)
}
// libuv's uv__stream_flush_write_queue.
unsafe fn flushWriteQueue(outer: *mut u8, error: i32) -> () {
  while !isNull(unsafe ptr(outer, S_WRITE_FIRST)) {
    let request = unsafe nn(unsafe ptr(outer, S_WRITE_FIRST))
    unsafe popWrite(outer)
    unsafe set<i32>(request, W_ERROR, error)
    unsafe pushDone(outer, request)
  }
}
unsafe fn popWrite(outer: *mut u8) -> () {
  let request = unsafe nn(unsafe ptr(outer, S_WRITE_FIRST))
  let next = unsafe ptr(request, W_NEXT)
  unsafe setPtr(outer, S_WRITE_FIRST, next)
  if isNull(next) { unsafe setPtr(outer, S_WRITE_LAST, none()) }
  unsafe setPtr(request, W_NEXT, none())
}
unsafe fn pushWrite(outer: *mut u8, request: *mut u8) -> () {
  unsafe setPtr(request, W_NEXT, none())
  let last = unsafe ptr(outer, S_WRITE_LAST)
  if isNull(last) { unsafe setPtr(outer, S_WRITE_FIRST, request) } else { unsafe setPtr(unsafe nn(last), W_NEXT, request) }
  unsafe setPtr(outer, S_WRITE_LAST, request)
}
unsafe fn pushDone(outer: *mut u8, request: *mut u8) -> () {
  unsafe setPtr(request, W_NEXT, none())
  let last = unsafe ptr(outer, S_DONE_LAST)
  if isNull(last) { unsafe setPtr(outer, S_DONE_FIRST, request) } else { unsafe setPtr(unsafe nn(last), W_NEXT, request) }
  unsafe setPtr(outer, S_DONE_LAST, request)
}
/// The closing phase of a TCP, pipe or TTY record (libuv's uv__stream_destroy): the pending
/// connect, write and shutdown callbacks with UV_ECANCELED, in libuv's order, before the close
/// callback.
export "C" fn silkUvStreamFinish(outer: *mut u8) -> () {
  let connect = unsafe ptr(outer, S_CONNECT_REQ)
  if !isNull(connect) {
    unsafe requestDone(unsafe loopOf(outer))
    unsafe setPtr(outer, S_CONNECT_REQ, none())
    unsafe callStatus(unsafe get<Status>(unsafe nn(connect), C_CB), unsafe nn(connect), UV_ECANCELED)
  }
  unsafe flushWriteQueue(outer, UV_ECANCELED)
  unsafe writeCallbacks(outer)
  unsafe drain(outer)
}
/// libuv's uv__stream_close, uv__pipe_close, uv__tty_close and uv__udp_close: the part of uv_close
/// for a TCP, pipe, TTY or UDP record that runs before ext.uv_api_abi's closeRecord. It stops
/// reading and watching, takes the record out of the pending queue and closes its descriptors.
pub unsafe fn streamClose(outer: *mut u8) -> () {
  let kind = unsafe kindOf(outer)
  if kind == UV_UDP {
    unsafe ioClose(outer)
    unsafe handleStop(outer)
    let fd = unsafe fdOf(outer)
    if fd != -1 { unsafe closeFd(fd) unsafe setFd(outer, -1) }
    return
  }
  if kind == UV_NAMED_PIPE {
    let name = unsafe ptr(outer, PIPE_NAME)
    if !isNull(name) {
      // Unlinked before the descriptor closes, as libuv does.
      let _ignored = unsafe unlink(unsafe nn(name))
      unsafe free(name)
      unsafe setPtr(outer, PIPE_NAME, none())
    }
  }
  if kind == UV_TTY { unsafe ttyForget(outer) }
  unsafe ioClose(outer)
  let _stopped = unsafe readStop(outer)
  unsafe handleStop(outer)
  unsafe lower(outer, READABLE | WRITABLE)
  let fd = unsafe fdOf(outer)
  if fd != -1 {
    // libuv does not close the standard descriptors.
    if fd > 2 { unsafe closeFd(fd) }
    unsafe setFd(outer, -1)
  }
  let accepted = unsafe get<i32>(outer, S_ACCEPTED_FD)
  if accepted != -1 { unsafe closeFd(accepted) unsafe set<i32>(outer, S_ACCEPTED_FD, -1) }
  let queued = unsafe ptr(outer, S_QUEUED_FDS)
  if !isNull(queued) {
    let count = unsafe get<u32>(unsafe nn(queued), 4)
    let mut index: u32 = 0
    while index < count { unsafe closeFd(unsafe get<i32>(unsafe nn(queued), 8 + u32.toUsize(index) * 4)) index = index + 1 }
    unsafe free(queued)
    unsafe setPtr(outer, S_QUEUED_FDS, none())
  }
}

// ---- Reading --------------------------------------------------------------------------------------
// The pending phase's call for a fed stream (libuv's uv__run_pending: the watcher's callback with
// POLLOUT).
export "C" fn silkUvStreamFed(node: *mut uvl.Pending) -> () {
  let outer = unsafe fromAddress(Pointer.address<uvl.Pending>(node) - S_PENDING)
  unsafe streamIo(outer, POLLOUT)
}
/// The loop's callback for a record's inner descriptor handle: libuv's uv__stream_io,
/// uv__server_io or uv__udp_io, as the record's state says.
export "C" fn silkUvStreamIo(inner: *mut u8, status: i32, events: i32) -> () {
  let outer = unsafe abi.outerOf(inner)
  let _unused = status
  if unsafe kindOf(outer) == UV_UDP { unsafe udpIo(outer, events) return }
  if unsafe has(outer, LISTENING) { unsafe serverIo(outer) return }
  unsafe streamIo(outer, events)
}
// libuv's uv__stream_io. IO_ERROR stands for POLLERR or POLLHUP and IO_HANGUP for POLLHUP.
unsafe fn streamIo(outer: *mut u8, events: i32) -> () {
  if !isNull(unsafe ptr(outer, S_CONNECT_REQ)) { unsafe streamConnect(outer) return }
  // Ignore POLLHUP here: even with it, there may still be data to read.
  if (events & (POLLIN | uvl.IO_ERROR)) != 0 { unsafe streamRead(outer) }
  if unsafe fdOf(outer) == -1 { return }
  if (events & uvl.IO_HANGUP) != 0 && unsafe has(outer, READING) && unsafe has(outer, READ_PARTIAL) && !unsafe has(outer, READ_EOF) {
    let buf = Buf { base: none(), len: 0 }
    unsafe streamEof(outer, Pointer.fromRef<Buf>(&buf))
  }
  if unsafe fdOf(outer) == -1 { return }
  if (events & (POLLOUT | uvl.IO_ERROR)) != 0 {
    unsafe streamWrite(outer)
    unsafe writeCallbacks(outer)
    if isNull(unsafe ptr(outer, S_WRITE_FIRST)) { unsafe drain(outer) }
  }
}
// libuv's uv__stream_eof.
unsafe fn streamEof(outer: *mut u8, buf: *const Buf) -> () {
  unsafe raise(outer, READ_EOF)
  unsafe lower(outer, READING)
  unsafe ioStop(outer, POLLIN)
  unsafe handleStop(outer)
  unsafe callRead(outer, -4095, buf)
}
// libuv's uv__stream_queue_fd.
unsafe fn queueFd(outer: *mut u8, fd: i32) -> i32 {
  let mut queued = unsafe ptr(outer, S_QUEUED_FDS)
  if isNull(queued) {
    queued = unsafe malloc(7 * 4 + 12)
    if isNull(queued) { return -ENOMEM }
    unsafe set<u32>(unsafe nn(queued), 0, 8) unsafe set<u32>(unsafe nn(queued), 4, 0)
    unsafe setPtr(outer, S_QUEUED_FDS, queued)
  } else {
    let size = unsafe get<u32>(unsafe nn(queued), 0)
    if size == unsafe get<u32>(unsafe nn(queued), 4) {
      let grown = unsafe realloc(queued, u32.toUsize(size + 8 - 1) * 4 + 12)
      if isNull(grown) { return -ENOMEM }
      unsafe set<u32>(unsafe nn(grown), 0, size + 8)
      unsafe setPtr(outer, S_QUEUED_FDS, grown)
      queued = grown
    }
  }
  let at = unsafe get<u32>(unsafe nn(queued), 4)
  unsafe set<i32>(unsafe nn(queued), 8 + u32.toUsize(at) * 4, fd)
  unsafe set<u32>(unsafe nn(queued), 4, at + 1)
  return 0
}
fn alignUp(value: usize, by: usize) -> usize { return (value + by - 1) / by * by }
unsafe fn cmsgLength(header: *mut u8) -> usize {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return u32.toUsize(unsafe get<u32>(header, 0)) } else { return unsafe get<usize>(header, 0) }
}
// CMSG_NXTHDR of the targets' headers.
unsafe fn cmsgNext(header: *mut u8, start: usize, end: usize) -> ?*mut u8 {
  let length = unsafe cmsgLength(header)
  static if Intrinsic.targetOperatingSystem() != "darwin" { if length < CMSG_HEADER { return none() } }
  let next = Pointer.address<u8>(header) + alignUp(length, CMSG_ALIGN)
  if next + CMSG_HEADER > end { return none() }
  let _unused = start
  let pointer = unsafe fromAddress(next)
  static if Intrinsic.targetOperatingSystem() != "darwin" { if next + alignUp(unsafe cmsgLength(pointer), CMSG_ALIGN) > end { return none() } }
  return pointer
}
// libuv's uv__stream_recv_cmsg, with uv__recvmsg's close-on-exec of the descriptors on Darwin.
unsafe fn receiveDescriptors(outer: *mut u8, control: *mut u8, controlLength: usize) -> i32 {
  let mut err: i32 = 0
  if controlLength < CMSG_HEADER { return 0 }
  let start = Pointer.address<u8>(control) let end = start + controlLength
  let mut header: ?*mut u8 = control
  while !isNull(header) {
    let h = unsafe nn(header)
    if unsafe get<i32>(h, CMSG_HEADER - 4) != SCM_RIGHTS {
      let _printed = unsafe dprintf(2, text(b"ignoring non-SCM_RIGHTS ancillary data: %d\n\0"), unsafe get<i32>(h, CMSG_HEADER - 4))
      header = unsafe cmsgNext(h, start, end)
      continue
    }
    let count = (unsafe cmsgLength(h) - CMSG_HEADER) / 4
    let mut index: usize = 0
    while index < count {
      let fd = unsafe get<i32>(h, CMSG_HEADER + index * 4)
      index = index + 1
      static if Intrinsic.targetOperatingSystem() == "darwin" { let _closed = unsafe cloexec(fd) }
      if err == 0 {
        if unsafe get<i32>(outer, S_ACCEPTED_FD) == -1 { unsafe set<i32>(outer, S_ACCEPTED_FD, fd) } else { err = unsafe queueFd(outer, fd) }
      }
      if err != 0 { unsafe closeFd(fd) }
    }
    header = unsafe cmsgNext(h, start, end)
  }
  return err
}
// libuv's uv__read.
unsafe fn streamRead(outer: *mut u8) -> () {
  unsafe lower(outer, READ_PARTIAL)
  let mut count: i32 = 32
  let ipc = unsafe isIpc(outer)
  while !Intrinsic.pointerIsNull<Read>(unsafe get<Read>(outer, S_READ)) && unsafe has(outer, READING) && count > 0 {
    count = count - 1
    let mut buf = Buf { base: none(), len: 0 }
    unsafe callAlloc(unsafe get<Alloc>(outer, S_ALLOC), outer, 65536, Pointer.fromMutRef<Buf>(&mut buf))
    if isNull(buf.base) || buf.len == 0 {
      // The addon cannot or will not take the read.
      unsafe callRead(outer, i32.toIsize(-ENOBUFS), Pointer.fromRef<Buf>(&buf))
      return
    }
    let fd = unsafe fdOf(outer)
    let mut control: [u64; 32] = [0; 32]
    let mut nread: isize = 0
    let mut controlLength: usize = 0
    if !ipc {
      while true { nread = unsafe read(fd, unsafe nn(buf.base), buf.len) if nread >= 0 || unsafe errno() != EINTR { break } }
    } else {
      static if Intrinsic.targetOperatingSystem() == "darwin" {
        let mut message = Message { name: none(), nameLength: 0, vectors: unsafe Intrinsic.pointerReinterpret<*mut Buf, *mut Iovec>(Pointer.fromMutRef<Buf>(&mut buf)), vectorCount: 1, control: unsafe words(Pointer.fromMutRef<u64>(&mut control[0])), controlLength: 256, flags: 0 }
        while true { nread = unsafe recvmsg(fd, Pointer.fromMutRef<Message>(&mut message), 0) if nread >= 0 || unsafe errno() != EINTR { break } }
        controlLength = u32.toUsize(message.controlLength)
      } else {
        let mut message = Message { name: none(), nameLength: 0, vectors: unsafe Intrinsic.pointerReinterpret<*mut Buf, *mut Iovec>(Pointer.fromMutRef<Buf>(&mut buf)), vectorCount: 1, control: unsafe words(Pointer.fromMutRef<u64>(&mut control[0])), controlLength: 256, flags: 0 }
        while true { nread = unsafe recvmsg(fd, Pointer.fromMutRef<Message>(&mut message), MSG_CMSG_CLOEXEC) if nread >= 0 || unsafe errno() != EINTR { break } }
        controlLength = message.controlLength
      }
    }
    if nread < 0 {
      let code = unsafe errno()
      if code == EAGAIN {
        // Wait for the next one.
        if unsafe has(outer, READING) { unsafe ioStart(outer, POLLIN) }
        unsafe callRead(outer, 0, Pointer.fromRef<Buf>(&buf))
      } else {
        // An error: the addon should call uv_close().
        unsafe lower(outer, READABLE | WRITABLE)
        unsafe callRead(outer, i32.toIsize(-code), Pointer.fromRef<Buf>(&buf))
        if unsafe has(outer, READING) {
          unsafe lower(outer, READING)
          unsafe ioStop(outer, POLLIN)
          unsafe handleStop(outer)
        }
      }
      return
    }
    if nread == 0 { unsafe streamEof(outer, Pointer.fromRef<Buf>(&buf)) return }
    let length = buf.len
    if ipc {
      let err = unsafe receiveDescriptors(outer, unsafe words(Pointer.fromMutRef<u64>(&mut control[0])), controlLength)
      if err != 0 { unsafe callRead(outer, i32.toIsize(err), Pointer.fromRef<Buf>(&buf)) return }
    }
    unsafe callRead(outer, nread, Pointer.fromRef<Buf>(&buf))
    // A short read: no more data for now.
    if isize.toUsize(nread) < length { unsafe raise(outer, READ_PARTIAL) return }
  }
}
// libuv's uv__read_start.
unsafe fn readStart(outer: *mut u8, alloc: Alloc, callback: Read) -> i32 {
  unsafe raise(outer, READING)
  unsafe lower(outer, READ_EOF)
  unsafe set<Read>(outer, S_READ, callback)
  unsafe set<Alloc>(outer, S_ALLOC, alloc)
  unsafe ioStart(outer, POLLIN)
  unsafe handleStart(outer)
  return 0
}
unsafe fn readStop(outer: *mut u8) -> i32 {
  if !unsafe has(outer, READING) { return 0 }
  unsafe lower(outer, READING)
  unsafe ioStop(outer, POLLIN)
  unsafe handleStop(outer)
  unsafe set<Read>(outer, S_READ, Intrinsic.pointerNullFunction<Read>())
  unsafe set<Alloc>(outer, S_ALLOC, Intrinsic.pointerNullFunction<Alloc>())
  return 0
}
/// libuv's uv_read_start.
@deferredCallbacks("alloc", "callback")
pub unsafe export "C" fn uv_read_start(stream: ?*mut u8, alloc: Alloc, callback: Read) -> i32 {
  if isNull(stream) || Intrinsic.pointerIsNull<Alloc>(alloc) || Intrinsic.pointerIsNull<Read>(callback) { return -EINVAL }
  let outer = unsafe nn(stream)
  if unsafe closing(outer) { return -EINVAL }
  if unsafe has(outer, READING) { return -EALREADY }
  if !unsafe has(outer, READABLE) { return -ENOTCONN }
  return unsafe readStart(outer, alloc, callback)
}
/// libuv's uv_read_stop.
pub export "C" fn uv_read_stop(stream: *mut u8) -> i32 { return unsafe readStop(stream) }
pub export "C" fn uv_is_readable(stream: *mut u8) -> i32 { if unsafe has(stream, READABLE) { return 1 } return 0 }
pub export "C" fn uv_is_writable(stream: *mut u8) -> i32 { if unsafe has(stream, WRITABLE) { return 1 } return 0 }
pub export "C" fn uv_stream_get_write_queue_size(stream: *mut u8) -> usize { return unsafe get<usize>(stream, S_WRITE_QUEUE_SIZE) }
/// libuv's uv_stream_set_blocking: the descriptor's O_NONBLOCK, nothing else.
pub export "C" fn uv_stream_set_blocking(stream: *mut u8, blocking: i32) -> i32 { return unsafe nonblock(unsafe fdOf(stream), blocking == 0) }

// ---- Writing --------------------------------------------------------------------------------------
// libuv's uv__drain.
unsafe fn drain(outer: *mut u8) -> () {
  let isClosing = unsafe closing(outer)
  if !isClosing { unsafe ioStop(outer, POLLOUT) }
  let request = unsafe ptr(outer, S_SHUTDOWN_REQ)
  if isNull(request) { return }
  if isClosing || !unsafe has(outer, SHUT) {
    unsafe setPtr(outer, S_SHUTDOWN_REQ, none())
    unsafe requestDone(unsafe loopOf(outer))
    let mut err: i32 = 0
    if isClosing { err = UV_ECANCELED }
    else { if unsafe shutdown(unsafe fdOf(outer), SHUT_WR) != 0 { err = -(unsafe errno()) } else { unsafe raise(outer, SHUT) } }
    unsafe callStatus(unsafe get<Status>(unsafe nn(request), SH_CB), unsafe nn(request), err)
  }
}
// libuv's uv__write_req_size: what a request has left to write.
unsafe fn requestSize(request: *mut u8) -> usize {
  let bufs = unsafe nn(unsafe ptr(request, W_BUFS))
  let index = u32.toUsize(unsafe get<u32>(request, W_INDEX))
  return unsafe countBufs(unsafe offset(bufs, index * 16), u32.toUsize(unsafe get<u32>(request, W_NBUFS)) - index)
}
// libuv's uv__write_req_update: true when the request is all written.
unsafe fn requestUpdate(outer: *mut u8, request: *mut u8, written: usize) -> bool {
  let mut n = written
  unsafe set<usize>(outer, S_WRITE_QUEUE_SIZE, unsafe get<usize>(outer, S_WRITE_QUEUE_SIZE) - n)
  let bufs = unsafe nn(unsafe ptr(request, W_BUFS))
  let mut index = u32.toUsize(unsafe get<u32>(request, W_INDEX))
  while true {
    let slot = unsafe bufAt(bufs, index)
    let mut buf = unsafe Pointer.read<Buf>(slot)
    let length = if n < buf.len { n } else { buf.len }
    if buf.len != 0 { buf.base = unsafe offset(unsafe nn(buf.base), length) }
    buf.len = buf.len - length
    unsafe Pointer.write<Buf>(slot, buf)
    if buf.len == 0 { index = index + 1 }
    n = n - length
    if n == 0 { break }
  }
  unsafe set<u32>(request, W_INDEX, usize.toU32(index))
  return index == u32.toUsize(unsafe get<u32>(request, W_NBUFS))
}
// libuv's uv__write_req_finish.
unsafe fn requestFinish(outer: *mut u8, request: *mut u8) -> () {
  unsafe popWrite(outer)
  if unsafe get<i32>(request, W_ERROR) == 0 {
    let bufs = unsafe ptr(request, W_BUFS)
    if !same(bufs, unsafe offset(request, W_BUFSML)) { unsafe free(bufs) }
    unsafe setPtr(request, W_BUFS, none())
  }
  unsafe pushDone(outer, request)
  unsafe feed(outer)
}
// The descriptor of a handle that uv_write2 may send (libuv's uv__handle_fd).
unsafe fn handleFd(handle: *mut u8) -> i32 {
  let kind = unsafe kindOf(handle)
  if kind == UV_NAMED_PIPE || kind == UV_TCP || kind == UV_UDP { return unsafe fdOf(handle) }
  return -1
}
// libuv's uv__try_write: bytes written, or a negative errno.
unsafe fn tryWrite(outer: *mut u8, bufs: *mut u8, count: u32, sendHandle: ?*mut u8) -> isize {
  let vectors = if count > IOV_MAX { IOV_MAX } else { count }
  let fd = unsafe fdOf(outer)
  let mut n: isize = 0
  if !isNull(sendHandle) {
    let handle = unsafe nn(sendHandle)
    if unsafe closing(handle) { return i32.toIsize(-EBADF) }
    let sent = unsafe handleFd(handle)
    // A control message with one descriptor: CMSG_SPACE(sizeof(int)) bytes.
    let mut control: [u64; 32] = [0; 32]
    let header = unsafe words(Pointer.fromMutRef<u64>(&mut control[0]))
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      unsafe set<u32>(header, 0, 16) unsafe set<i32>(header, 4, SOL_SOCKET) unsafe set<i32>(header, 8, SCM_RIGHTS) unsafe set<i32>(header, 12, sent)
      let message = Message { name: none(), nameLength: 0, vectors: unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Iovec>(bufs), vectorCount: u32.wrappingToI32(vectors), control: header, controlLength: 16, flags: 0 }
      while true { n = unsafe sendmsg(fd, Pointer.fromRef<Message>(&message), 0) if n != -1 || unsafe errno() != EINTR { break } }
    } else {
      unsafe set<usize>(header, 0, 20) unsafe set<i32>(header, 8, SOL_SOCKET) unsafe set<i32>(header, 12, SCM_RIGHTS) unsafe set<i32>(header, 16, sent)
      let message = Message { name: none(), nameLength: 0, vectors: unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Iovec>(bufs), vectorCount: u32.toUsize(vectors), control: header, controlLength: 24, flags: 0 }
      while true { n = unsafe sendmsg(fd, Pointer.fromRef<Message>(&message), 0) if n != -1 || unsafe errno() != EINTR { break } }
    }
  } else {
    while true {
      if vectors == 1 { let first = unsafe Pointer.read<Buf>(unsafe bufAt(bufs, 0)) n = unsafe write(fd, unsafe nn(first.base), first.len) }
      else { n = unsafe writev(fd, unsafe Intrinsic.pointerRequalify<*mut Buf, *const Buf>(unsafe cell<Buf>(bufs, 0)), u32.wrappingToI32(vectors)) }
      if n != -1 || unsafe errno() != EINTR { break }
    }
  }
  if n >= 0 { return n }
  let code = unsafe errno()
  if code == EAGAIN || code == ENOBUFS { return i32.toIsize(-EAGAIN) }
  static if Intrinsic.targetOperatingSystem() == "darwin" { if code == EPROTOTYPE { return i32.toIsize(-ECONNRESET) } }
  return i32.toIsize(-code)
}
// libuv's uv__write.
unsafe fn streamWrite(outer: *mut u8) -> () {
  let mut count: i32 = 32
  let mut request: *mut u8 = outer
  let mut n: isize = 0
  while true {
    let first = unsafe ptr(outer, S_WRITE_FIRST)
    if isNull(first) { return }
    request = unsafe nn(first)
    let index = unsafe get<u32>(request, W_INDEX)
    n = unsafe tryWrite(outer, unsafe offset(unsafe nn(unsafe ptr(request, W_BUFS)), u32.toUsize(index) * 16), unsafe get<u32>(request, W_NBUFS) - index, unsafe ptr(request, W_SEND_HANDLE))
    if n >= 0 {
      // The handle is not sent again after a partial write.
      unsafe setPtr(request, W_SEND_HANDLE, none())
      if unsafe requestUpdate(outer, request, isize.toUsize(n)) {
        unsafe requestFinish(outer, request)
        if count > 0 { count = count - 1 continue }
        count = count - 1
        return
      }
    } else { if n != i32.toIsize(-EAGAIN) { break } }
    // A blocking stream tries again.
    if unsafe has(outer, BLOCKING_WRITES) { continue }
    unsafe ioStart(outer, POLLOUT)
    return
  }
  unsafe set<i32>(request, W_ERROR, isize.toI32(n))
  unsafe requestFinish(outer, request)
  unsafe ioStop(outer, POLLOUT)
}
// libuv's uv__write_callbacks.
unsafe fn writeCallbacks(outer: *mut u8) -> () {
  let mut request = unsafe ptr(outer, S_DONE_FIRST)
  if isNull(request) { return }
  unsafe setPtr(outer, S_DONE_FIRST, none()) unsafe setPtr(outer, S_DONE_LAST, none())
  while !isNull(request) {
    let r = unsafe nn(request)
    let next = unsafe ptr(r, W_NEXT)
    unsafe setPtr(r, W_NEXT, none())
    unsafe requestDone(unsafe loopOf(outer))
    let bufs = unsafe ptr(r, W_BUFS)
    if !isNull(bufs) {
      unsafe set<usize>(outer, S_WRITE_QUEUE_SIZE, unsafe get<usize>(outer, S_WRITE_QUEUE_SIZE) - unsafe requestSize(r))
      if !same(bufs, unsafe offset(r, W_BUFSML)) { unsafe free(bufs) }
      unsafe setPtr(r, W_BUFS, none())
    }
    // The callback comes after the request's memory is released.
    unsafe callStatus(unsafe get<Status>(r, W_CB), r, unsafe get<i32>(r, W_ERROR))
    request = next
  }
}
// libuv's uv__check_before_write.
unsafe fn checkBeforeWrite(outer: *mut u8, sendHandle: ?*mut u8) -> i32 {
  if unsafe fdOf(outer) < 0 { return -EBADF }
  if !unsafe has(outer, WRITABLE) { return -EPIPE }
  if !isNull(sendHandle) {
    if !unsafe isIpc(outer) { return -EINVAL }
    if unsafe handleFd(unsafe nn(sendHandle)) < 0 { return -EBADF }
  }
  return 0
}
/// libuv's uv_write2: queues `bufs` (copied; their memory must stay valid until the callback) and
/// writes at once when nothing was queued.
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_write2(request: *mut u8, stream: *mut u8, bufs: *const Buf, count: u32, sendHandle: ?*mut u8, callback: Status) -> i32 {
  let err = unsafe checkBeforeWrite(stream, sendHandle)
  if err < 0 { return err }
  let empty = unsafe get<usize>(stream, S_WRITE_QUEUE_SIZE) == 0
  unsafe requestInit(unsafe loopOf(stream), request, UV_WRITE)
  unsafe set<Status>(request, W_CB, callback)
  unsafe setPtr(request, W_HANDLE, stream)
  unsafe set<i32>(request, W_ERROR, 0)
  unsafe setPtr(request, W_SEND_HANDLE, sendHandle)
  unsafe setPtr(request, W_NEXT, none())
  let mut copy: ?*mut u8 = unsafe offset(request, W_BUFSML)
  if count > 4 { copy = unsafe malloc(u32.toUsize(count) * 16) }
  if isNull(copy) { return -ENOMEM }
  let _copied = unsafe memcpy(unsafe nn(copy), unsafe Intrinsic.pointerReinterpret<*const Buf, *const u8>(bufs), u32.toUsize(count) * 16)
  unsafe setPtr(request, W_BUFS, copy)
  unsafe set<u32>(request, W_NBUFS, count)
  unsafe set<u32>(request, W_INDEX, 0)
  unsafe set<usize>(stream, S_WRITE_QUEUE_SIZE, unsafe get<usize>(stream, S_WRITE_QUEUE_SIZE) + unsafe countBufs(unsafe nn(copy), u32.toUsize(count)))
  unsafe pushWrite(stream, request)
  if !isNull(unsafe ptr(stream, S_CONNECT_REQ)) {
    // Still connecting.
  } else {
    if empty { unsafe streamWrite(stream) } else { unsafe ioStart(stream, POLLOUT) }
  }
  return 0
}
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_write(request: *mut u8, stream: *mut u8, bufs: *const Buf, count: u32, callback: Status) -> i32 {
  return unsafe uv_write2(request, stream, bufs, count, none(), callback)
}
/// libuv's uv_try_write2: UV_EAGAIN while connecting or while anything is queued.
pub export "C" fn uv_try_write2(stream: *mut u8, bufs: *const Buf, count: u32, sendHandle: ?*mut u8) -> i32 {
  if !isNull(unsafe ptr(stream, S_CONNECT_REQ)) || unsafe get<usize>(stream, S_WRITE_QUEUE_SIZE) != 0 { return -EAGAIN }
  let err = unsafe checkBeforeWrite(stream, none())
  if err < 0 { return err }
  return isize.wrappingToI32(unsafe tryWrite(stream, unsafe constant(unsafe Intrinsic.pointerReinterpret<*const Buf, *const u8>(bufs)), count, sendHandle))
}
pub export "C" fn uv_try_write(stream: *mut u8, bufs: *const Buf, count: u32) -> i32 { return unsafe uv_try_write2(stream, bufs, count, none()) }
/// libuv's uv_shutdown: the shutdown(2) call waits for the write queue, in uv__drain.
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_shutdown(request: *mut u8, stream: *mut u8, callback: Status) -> i32 {
  if !unsafe has(stream, WRITABLE) || unsafe has(stream, SHUT) || !isNull(unsafe ptr(stream, S_SHUTDOWN_REQ)) || unsafe closing(stream) { return -ENOTCONN }
  unsafe requestInit(unsafe loopOf(stream), request, UV_SHUTDOWN)
  unsafe setPtr(request, SH_HANDLE, stream)
  unsafe set<Status>(request, SH_CB, callback)
  unsafe setPtr(stream, S_SHUTDOWN_REQ, request)
  unsafe lower(stream, WRITABLE)
  if isNull(unsafe ptr(stream, S_WRITE_FIRST)) { unsafe feed(stream) }
  return 0
}

// ---- Connecting and listening ---------------------------------------------------------------------
// libuv's uv__stream_connect.
unsafe fn streamConnect(outer: *mut u8) -> () {
  let request = unsafe nn(unsafe ptr(outer, S_CONNECT_REQ))
  let mut error: i32 = 0
  let delayed = unsafe get<i32>(outer, S_DELAYED_ERROR)
  if delayed != 0 {
    error = delayed
    unsafe set<i32>(outer, S_DELAYED_ERROR, 0)
  } else {
    let mut value: i32 = 0 let mut size: u32 = 4
    let _ignored = unsafe getsockopt(unsafe fdOf(outer), SOL_SOCKET, SO_ERROR, unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(Pointer.fromMutRef<i32>(&mut value)), Pointer.fromMutRef<u32>(&mut size))
    error = -value
  }
  if error == -EINPROGRESS { return }
  unsafe setPtr(outer, S_CONNECT_REQ, none())
  unsafe requestDone(unsafe loopOf(outer))
  if error < 0 || isNull(unsafe ptr(outer, S_WRITE_FIRST)) { unsafe ioStop(outer, POLLOUT) }
  unsafe callStatus(unsafe get<Status>(request, C_CB), request, error)
  if unsafe fdOf(outer) == -1 { return }
  if error < 0 {
    unsafe flushWriteQueue(outer, UV_ECANCELED)
    unsafe writeCallbacks(outer)
  }
}
// libuv's uv__server_io.
unsafe fn serverIo(outer: *mut u8) -> () {
  let fd = unsafe fdOf(outer)
  let mut err = unsafe acceptFd(fd)
  if err == -EMFILE || err == -ENFILE { err = unsafe emfileTrick(fd) }
  if err < 0 { return }
  unsafe set<i32>(outer, S_ACCEPTED_FD, err)
  unsafe callStatus(unsafe get<Status>(outer, S_CONNECTION), outer, 0)
  // The addon has not called uv_accept() yet.
  if unsafe get<i32>(outer, S_ACCEPTED_FD) != -1 { unsafe ioStop(outer, POLLIN) }
}
/// libuv's uv_accept.
pub export "C" fn uv_accept(server: *mut u8, client: *mut u8) -> i32 {
  let accepted = unsafe get<i32>(server, S_ACCEPTED_FD)
  if accepted == -1 { return -EAGAIN }
  let kind = unsafe kindOf(client)
  let mut err: i32 = 0
  if kind == UV_NAMED_PIPE || kind == UV_TCP {
    err = unsafe streamOpenFlags(client, accepted, READABLE | WRITABLE)
    if err != 0 { unsafe closeFd(accepted) }
  } else {
    if kind == UV_UDP {
      err = unsafe uv_udp_open(client, accepted)
      if err != 0 { unsafe closeFd(accepted) }
    } else { return -EINVAL }
  }
  if err == 0 { unsafe raise(client, BOUND) }
  let queued = unsafe ptr(server, S_QUEUED_FDS)
  if !isNull(queued) {
    let q = unsafe nn(queued)
    unsafe set<i32>(server, S_ACCEPTED_FD, unsafe get<i32>(q, 8))
    let left = unsafe get<u32>(q, 4) - 1
    unsafe set<u32>(q, 4, left)
    if left == 0 { unsafe free(queued) unsafe setPtr(server, S_QUEUED_FDS, none()) }
    else { let _moved = unsafe memmove(unsafe offset(q, 8), unsafe offset(q, 12), u32.toUsize(left) * 4) }
  } else {
    unsafe set<i32>(server, S_ACCEPTED_FD, -1)
    if err == 0 { unsafe ioStart(server, POLLIN) }
  }
  return err
}
/// libuv's uv_listen.
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_listen(stream: *mut u8, backlog: i32, callback: Status) -> i32 {
  if unsafe closing(stream) { return -EINVAL }
  let kind = unsafe kindOf(stream)
  let mut err: i32 = -EINVAL
  if kind == UV_TCP { err = unsafe tcpListen(stream, backlog, callback) }
  if kind == UV_NAMED_PIPE { err = unsafe pipeListen(stream, backlog, callback) }
  if err == 0 { unsafe handleStart(stream) }
  return err
}

// ---- Socket options and names ---------------------------------------------------------------------
// libuv's uv__socket_sockopt.
unsafe fn socketOption(handle: ?*mut u8, option: i32, value: ?*mut i32) -> i32 {
  if isNull(handle) || Pointer.isNull<i32>(value) { return -EINVAL }
  let h = unsafe nn(handle)
  let kind = unsafe kindOf(h)
  if kind != UV_TCP && kind != UV_NAMED_PIPE && kind != UV_UDP { return -ENOTSUP }
  let fd = unsafe fdOf(h)
  let target = unsafe Intrinsic.pointerRequalify<?*mut i32, *mut i32>(value)
  let mut length: u32 = 4
  let bytes = unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(target)
  let r = if unsafe Pointer.read<i32>(target) == 0 { unsafe getsockopt(fd, SOL_SOCKET, option, bytes, Pointer.fromMutRef<u32>(&mut length)) } else { unsafe setsockopt(fd, SOL_SOCKET, option, bytes, length) }
  if r < 0 { return -(unsafe errno()) }
  return 0
}
pub export "C" fn uv_recv_buffer_size(handle: ?*mut u8, value: ?*mut i32) -> i32 { return unsafe socketOption(handle, SO_RCVBUF, value) }
pub export "C" fn uv_send_buffer_size(handle: ?*mut u8, value: ?*mut i32) -> i32 { return unsafe socketOption(handle, SO_SNDBUF, value) }
// libuv's uv__getsockpeername, with uv_fileno's checks.
unsafe fn socketName(outer: *mut u8, peer: bool, name: *mut u8, length: *mut i32) -> i32 {
  let mut fd: i32 = -1
  let inner = unsafe innerOf(outer)
  if isNull(inner) { return -EBADF }
  let r = unsafe uvl.uv_fileno(unsafe nn(inner), Pointer.fromMutRef<i32>(&mut fd))
  if r < 0 { return r }
  let mut size = i32.wrappingToU32(unsafe Pointer.read<i32>(length))
  let status = if peer { unsafe getpeername(fd, name, Pointer.fromMutRef<u32>(&mut size)) } else { unsafe getsockname(fd, name, Pointer.fromMutRef<u32>(&mut size)) }
  if status != 0 { return -(unsafe errno()) }
  unsafe Pointer.write<i32>(length, u32.wrappingToI32(size))
  return 0
}

// ---- TCP ------------------------------------------------------------------------------------------
// libuv's maybe_bind_socket.
unsafe fn maybeBindSocket(fd: i32) -> i32 {
  let mut storage: [u64; 16] = [0; 16]
  let address = unsafe words(Pointer.fromMutRef<u64>(&mut storage[0]))
  let mut length: u32 = 128
  if unsafe getsockname(fd, address, Pointer.fromMutRef<u32>(&mut length)) != 0 { return -(unsafe errno()) }
  let family = familyOf(address)
  // Already bound to a port.
  if (family == AF_INET || family == AF_INET6) && unsafe get<u16>(address, 2) != 0 { return 0 }
  if unsafe bind(fd, address, length) != 0 { return -(unsafe errno()) }
  return 0
}
// libuv's new_socket.
unsafe fn tcpNewSocket(outer: *mut u8, domain: i32, bits: usize) -> i32 {
  let fd = unsafe newSocket(domain, SOCK_STREAM, 0)
  if fd < 0 { return fd }
  let err = unsafe streamOpenFlags(outer, fd, bits)
  if err != 0 { unsafe closeFd(fd) return err }
  if (bits & BOUND) != 0 { return unsafe maybeBindSocket(fd) }
  return 0
}
// libuv's maybe_new_socket.
unsafe fn tcpMaybeNewSocket(outer: *mut u8, domain: i32, bits: usize) -> i32 {
  if domain != AF_UNSPEC {
    let fd = unsafe fdOf(outer)
    if fd == -1 { return unsafe tcpNewSocket(outer, domain, bits) }
    if (bits & BOUND) != 0 && !unsafe has(outer, BOUND) {
      let err = unsafe maybeBindSocket(fd)
      if err != 0 { return err }
    }
  }
  unsafe raise(outer, bits)
  return 0
}
/// libuv's uv_tcp_init_ex: the low 8 bits of `flags` are a domain (AF_UNSPEC, AF_INET or
/// AF_INET6) whose socket is made now.
pub export "C" fn uv_tcp_init_ex(loop: *mut u8, tcp: *mut u8, flags: u32) -> i32 {
  let domain = u32.wrappingToI32(flags & 255)
  if domain != AF_INET && domain != AF_INET6 && domain != AF_UNSPEC { return -EINVAL }
  if (flags & 4294967040) != 0 { return -EINVAL }
  // libuv makes the socket after uv__stream_init and takes the handle off the loop's queue when
  // that fails; making it first leaves the loop the same either way.
  let mut fd: i32 = -1
  if domain != AF_UNSPEC { fd = unsafe newSocket(domain, SOCK_STREAM, 0) if fd < 0 { return fd } }
  let status = unsafe streamInit(loop, tcp, UV_TCP)
  if status != 0 { if fd >= 0 { unsafe closeFd(fd) } return status }
  if fd >= 0 { let _opened = unsafe streamOpenFlags(tcp, fd, 0) }
  return 0
}
pub export "C" fn uv_tcp_init(loop: *mut u8, tcp: *mut u8) -> i32 { return unsafe uv_tcp_init_ex(loop, tcp, 0) }
/// libuv's uv_tcp_open: UV_EEXIST when the loop already watches `sock`.
pub export "C" fn uv_tcp_open(tcp: *mut u8, sock: i32) -> i32 {
  if unsafe uvl.ioDescriptorWatched(unsafe loopOf(tcp), sock) { return -EEXIST }
  let err = unsafe nonblock(sock, true)
  if err != 0 { return err }
  return unsafe streamOpenFlags(tcp, sock, READABLE | WRITABLE)
}
/// libuv's uv_tcp_bind (SO_REUSEADDR always; UV_TCP_IPV6ONLY and UV_TCP_REUSEPORT as asked). An
/// address in use is reported by the later listen or connect, as in libuv.
pub export "C" fn uv_tcp_bind(tcp: *mut u8, address: *const u8, flags: u32) -> i32 {
  if unsafe kindOf(tcp) != UV_TCP { return -EINVAL }
  if unsafe closing(tcp) { return -EINVAL }
  let length = unsafe inetLength(address)
  if length == 0 { return -EINVAL }
  let family = familyOf(address)
  if (flags & UV_TCP_IPV6ONLY) != 0 && family != AF_INET6 { return -EINVAL }
  let made = unsafe tcpMaybeNewSocket(tcp, family, 0)
  if made != 0 { return made }
  let fd = unsafe fdOf(tcp)
  let reuse = unsafe setInt(fd, SOL_SOCKET, SO_REUSEADDR, 1)
  if reuse != 0 { return reuse }
  if (flags & UV_TCP_REUSEPORT) != 0 { let port = unsafe reusePort(fd) if port != 0 { return port } }
  if family == AF_INET6 {
    let only = unsafe setInt(fd, IPPROTO_IPV6, IPV6_V6ONLY, if (flags & UV_TCP_IPV6ONLY) != 0 { 1 } else { 0 })
    if only != 0 { return only }
  }
  unsafe setErrno(0)
  let r = unsafe bind(fd, address, length)
  let code = unsafe errno()
  if r == -1 && code != EADDRINUSE {
    if code == EAFNOSUPPORT { return -EINVAL }
    return -code
  }
  unsafe set<i32>(tcp, S_DELAYED_ERROR, if r == -1 { -code } else { 0 })
  unsafe raise(tcp, BOUND)
  if family == AF_INET6 { unsafe raise(tcp, IPV6) }
  return 0
}
// libuv's uv__ipv6_link_local_scope_id: the scope of the first link-local interface address.
unsafe fn linkLocalScope() -> u32 {
  let mut list: ?*mut u8 = none()
  if unsafe getifaddrs(Pointer.fromMutRef<?*mut u8>(&mut list)) != 0 { return 0 }
  let mut entry = list
  let mut scope: u32 = 0
  while !isNull(entry) {
    let e = unsafe nn(entry)
    let address = unsafe ptr(e, 24)
    if !isNull(address) && unsafe isLinkLocal(unsafe nn(address)) { scope = unsafe get<u32>(unsafe nn(address), 24) break }
    entry = unsafe ptr(e, 0)
  }
  unsafe freeifaddrs(list)
  return scope
}
unsafe fn isLinkLocal(address: *mut u8) -> bool {
  if familyOf(address) != AF_INET6 { return false }
  return unsafe get<u8>(address, 8) == 254 && unsafe get<u8>(address, 9) == 128
}
// libuv's uv__tcp_connect.
unsafe fn tcpConnect(request: *mut u8, tcp: *mut u8, given: *const u8, length: u32, callback: Status) -> i32 {
  if !isNull(unsafe ptr(tcp, S_CONNECT_REQ)) { return -EALREADY }
  if unsafe get<i32>(tcp, S_DELAYED_ERROR) == 0 {
    let made = unsafe tcpMaybeNewSocket(tcp, familyOf(given), READABLE | WRITABLE)
    if made != 0 { return made }
    let mut copy: [u64; 4] = [0; 4]
    let mut address = given
    if unsafe isLinkLocal(unsafe constant(given)) {
      let _copied = unsafe memcpy(unsafe words(Pointer.fromMutRef<u64>(&mut copy[0])), given, 28)
      let local = unsafe words(Pointer.fromMutRef<u64>(&mut copy[0]))
      if unsafe get<u32>(local, 24) == 0 { unsafe set<u32>(local, 24, unsafe linkLocalScope()) address = local }
    }
    let mut r: i32 = 0
    while true { unsafe setErrno(0) r = unsafe connect(unsafe fdOf(tcp), address, length) if r != -1 || unsafe errno() != EINTR { break } }
    let code = unsafe errno()
    // A failure with errno 0 is a connection made (seen on some Android kernels).
    if r == -1 && code != 0 {
      if code == EINPROGRESS {}
      else { if code == ECONNREFUSED { unsafe set<i32>(tcp, S_DELAYED_ERROR, -ECONNREFUSED) } else { return -code } }
    }
  }
  unsafe requestInit(unsafe loopOf(tcp), request, UV_CONNECT)
  unsafe set<Status>(request, C_CB, callback)
  unsafe setPtr(request, C_HANDLE, tcp)
  unsafe setPtr(tcp, S_CONNECT_REQ, request)
  unsafe ioStart(tcp, POLLOUT)
  if unsafe get<i32>(tcp, S_DELAYED_ERROR) != 0 { unsafe feed(tcp) }
  return 0
}
/// libuv's uv_tcp_connect.
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_tcp_connect(request: *mut u8, tcp: *mut u8, address: *const u8, callback: Status) -> i32 {
  if unsafe kindOf(tcp) != UV_TCP { return -EINVAL }
  let length = unsafe inetLength(address)
  if length == 0 { return -EINVAL }
  return unsafe tcpConnect(request, tcp, address, length, callback)
}
pub export "C" fn uv_tcp_getsockname(tcp: *mut u8, name: *mut u8, length: *mut i32) -> i32 {
  let delayed = unsafe get<i32>(tcp, S_DELAYED_ERROR)
  if delayed != 0 { return delayed }
  return unsafe socketName(tcp, false, name, length)
}
pub export "C" fn uv_tcp_getpeername(tcp: *mut u8, name: *mut u8, length: *mut i32) -> i32 {
  let delayed = unsafe get<i32>(tcp, S_DELAYED_ERROR)
  if delayed != 0 { return delayed }
  return unsafe socketName(tcp, true, name, length)
}
// libuv's uv__tcp_listen.
unsafe fn tcpListen(tcp: *mut u8, backlog: i32, callback: Status) -> i32 {
  let delayed = unsafe get<i32>(tcp, S_DELAYED_ERROR)
  if delayed != 0 { return delayed }
  let made = unsafe tcpMaybeNewSocket(tcp, AF_INET, 0)
  if made != 0 { return made }
  if unsafe listen(unsafe fdOf(tcp), backlog) != 0 { return -(unsafe errno()) }
  unsafe set<Status>(tcp, S_CONNECTION, callback)
  unsafe raise(tcp, BOUND | LISTENING)
  unsafe ioStart(tcp, POLLIN)
  return 0
}
pub export "C" fn uv_tcp_nodelay(tcp: *mut u8, on: i32) -> i32 {
  let fd = unsafe fdOf(tcp)
  if fd != -1 { let err = unsafe setInt(fd, IPPROTO_TCP, TCP_NODELAY, on) if err != 0 { return err } }
  if on != 0 { unsafe raise(tcp, TCP_NODELAY_FLAG) } else { unsafe lower(tcp, TCP_NODELAY_FLAG) }
  return 0
}
/// libuv 1.52's uv_tcp_keepalive_ex: SO_KEEPALIVE, and when on, the idle time, probe interval and
/// probe count (each at least 1, or UV_EINVAL).
pub export "C" fn uv_tcp_keepalive_ex(tcp: *mut u8, on: i32, idle: u32, interval: u32, count: u32) -> i32 {
  let fd = unsafe fdOf(tcp)
  if fd != -1 { let err = unsafe keepalive(fd, on != 0, idle, interval, count) if err != 0 { return err } }
  if on != 0 { unsafe raise(tcp, TCP_KEEPALIVE_FLAG) } else { unsafe lower(tcp, TCP_KEEPALIVE_FLAG) }
  return 0
}
/// libuv's uv_tcp_keepalive: probes every second, ten of them, after `delay` idle seconds.
pub export "C" fn uv_tcp_keepalive(tcp: *mut u8, on: i32, delay: u32) -> i32 { return unsafe uv_tcp_keepalive_ex(tcp, on, delay, 1, 10) }
pub export "C" fn uv_tcp_simultaneous_accepts(tcp: *mut u8, enable: i32) -> i32 { let _unused = tcp let _off = enable return 0 }
/// libuv's uv_tcp_close_reset: SO_LINGER 0, then uv_close (this module's part and closeRecord).
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_tcp_close_reset(tcp: *mut u8, callback: Close) -> i32 {
  if !isNull(unsafe ptr(tcp, S_SHUTDOWN_REQ)) { return -EINVAL }
  let linger: [i32; 2] = [1, 0]
  if unsafe setsockopt(unsafe fdOf(tcp), SOL_SOCKET, SO_LINGER, unsafe Intrinsic.pointerReinterpret<*const i32, *const u8>(Pointer.fromRef<i32>(&linger[0])), 8) != 0 {
    // EINVAL may mean the socket was shut down already (Solaris, illumos, macOS).
    if unsafe errno() == EINVAL { unsafe setErrno(0) } else { return -(unsafe errno()) }
  }
  unsafe streamClose(tcp)
  unsafe abi.closeRecord(tcp, callback)
  return 0
}

// ---- Pipes ----------------------------------------------------------------------------------------
/// libuv's uv_pipe_init: `ipc` pipes pass handles with uv_write2.
pub export "C" fn uv_pipe_init(loop: *mut u8, pipe: *mut u8, ipc: i32) -> i32 {
  let status = unsafe streamInit(loop, pipe, UV_NAMED_PIPE)
  if status != 0 { return status }
  unsafe setPtr(pipe, PIPE_NAME, none())
  unsafe set<i32>(pipe, PIPE_IPC, ipc)
  return 0
}
// libuv's includes_invalid_nul (Linux's abstract names may hold NUL bytes).
unsafe fn invalidNul(name: *const u8, length: usize) -> bool {
  if length == 0 { return false }
  static if Intrinsic.targetOperatingSystem() != "darwin" { if unsafe Pointer.read<u8>(name) == 0 { return false } }
  return !isNull(unsafe memchr(name, 0, length))
}
// A struct sockaddr_un for `name`, and its length as libuv computes it.
unsafe fn unixAddress(storage: &mut [u64; 16], name: *const u8, length: usize) -> u32 {
  let address = unsafe words(Pointer.fromMutRef<u64>(&mut storage[0]))
  let _cleared = unsafe memset(address, 0, 128)
  let _copied = unsafe memcpy(unsafe offset(address, 2), name, length)
  unsafe setFamily(address, AF_UNIX)
  if unsafe Pointer.read<u8>(name) == 0 { return usize.toU32(2 + length) }
  return SOCKADDR_UN_BYTES
}
/// libuv's uv_pipe_bind2: a long name is truncated unless UV_PIPE_NO_TRUNCATE; Linux's empty name
/// autobinds in the abstract namespace.
pub export "C" fn uv_pipe_bind2(pipe: *mut u8, name: ?*const u8, given: usize, flags: u32) -> i32 {
  if (flags & (UV_PIPE_NO_TRUNCATE ^ 4294967295)) != 0 { return -EINVAL }
  if Pointer.isNull<u8>(name) { return -EINVAL }
  let n = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(name)
  let mut length = given
  static if Intrinsic.targetOperatingSystem() == "darwin" { if length == 0 { return -EINVAL } }
  if unsafe invalidNul(n, length) { return -EINVAL }
  if (flags & UV_PIPE_NO_TRUNCATE) != 0 && length > SUN_PATH_BYTES { return -EINVAL }
  if length > SUN_PATH_BYTES { length = SUN_PATH_BYTES }
  if unsafe fdOf(pipe) >= 0 { return -EINVAL }
  if unsafe closing(pipe) { return -EINVAL }
  let mut copy: ?*mut u8 = none()
  // A copy of the path for the unlink at close; an abstract name has none.
  if length != 0 && unsafe Pointer.read<u8>(n) != 0 {
    copy = unsafe malloc(length + 1)
    if isNull(copy) { return -ENOMEM }
    let _copied = unsafe memcpy(unsafe nn(copy), n, length)
    unsafe set<u8>(unsafe nn(copy), length, 0)
  }
  let fd = unsafe newSocket(AF_UNIX, SOCK_STREAM, 0)
  if fd < 0 { unsafe free(copy) return fd }
  let mut storage: [u64; 16] = [0; 16]
  let mut addressLength = unsafe unixAddress(&mut storage, n, length)
  if length == 0 { addressLength = 2 }
  if unsafe bind(fd, unsafe wordsConst(Pointer.fromMutRef<u64>(&mut storage[0])), addressLength) != 0 {
    let mut err = -(unsafe errno())
    // ENOENT becomes EACCES, as on Windows.
    if err == -ENOENT { err = -EACCES }
    unsafe closeFd(fd)
    unsafe free(copy)
    return err
  }
  unsafe raise(pipe, BOUND)
  unsafe setPtr(pipe, PIPE_NAME, copy)
  unsafe setFd(pipe, fd)
  return 0
}
pub export "C" fn uv_pipe_bind(pipe: *mut u8, name: *const u8) -> i32 { return unsafe uv_pipe_bind2(pipe, name, unsafe strlen(name), 0) }
// libuv's uv__pipe_listen.
unsafe fn pipeListen(pipe: *mut u8, backlog: i32, callback: Status) -> i32 {
  let fd = unsafe fdOf(pipe)
  if fd == -1 { return -EINVAL }
  if unsafe isIpc(pipe) { return -EINVAL }
  if unsafe listen(fd, backlog) != 0 { return -(unsafe errno()) }
  unsafe set<Status>(pipe, S_CONNECTION, callback)
  unsafe raise(pipe, LISTENING)
  unsafe ioStart(pipe, POLLIN)
  return 0
}
/// libuv's uv_pipe_open: the descriptor's access mode decides readable and writable.
pub export "C" fn uv_pipe_open(pipe: *mut u8, fd: i32) -> i32 {
  if unsafe uvl.ioDescriptorWatched(unsafe loopOf(pipe), fd) { return -EEXIST }
  let mut mode: i32 = -1
  while true { mode = unsafe fcntl(fd, F_GETFL) if mode != -1 || unsafe errno() != EINTR { break } }
  if mode == -1 { return -(unsafe errno()) }
  let err = unsafe nonblock(fd, true)
  if err != 0 { return err }
  let access = mode & O_ACCMODE
  let mut bits: usize = 0
  if access != O_WRONLY { bits = bits | READABLE }
  if access != O_RDONLY { bits = bits | WRITABLE }
  let opened = unsafe streamOpenFlags(pipe, fd, bits)
  if opened != 0 { return opened }
  return unsafe trySelect(pipe)
}
/// libuv's uv_pipe_connect2: errors, the connect's included, reach the callback in the next
/// pending phase.
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_pipe_connect2(request: *mut u8, pipe: *mut u8, name: ?*const u8, given: usize, flags: u32, callback: Status) -> i32 {
  if (flags & (UV_PIPE_NO_TRUNCATE ^ 4294967295)) != 0 { return -EINVAL }
  if Pointer.isNull<u8>(name) { return -EINVAL }
  if given == 0 { return -EINVAL }
  let n = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(name)
  let mut length = given
  if unsafe invalidNul(n, length) { return -EINVAL }
  if (flags & UV_PIPE_NO_TRUNCATE) != 0 && length > SUN_PATH_BYTES { return -EINVAL }
  if length > SUN_PATH_BYTES { length = SUN_PATH_BYTES }
  let fresh = unsafe fdOf(pipe) == -1
  let mut err: i32 = 0
  let mut connected = false
  if fresh {
    let fd = unsafe newSocket(AF_UNIX, SOCK_STREAM, 0)
    if fd < 0 { err = fd } else { unsafe setFd(pipe, fd) }
  }
  if err == 0 {
    let mut storage: [u64; 16] = [0; 16]
    let addressLength = unsafe unixAddress(&mut storage, n, length)
    let mut r: i32 = 0
    while true { r = unsafe connect(unsafe fdOf(pipe), unsafe wordsConst(Pointer.fromMutRef<u64>(&mut storage[0])), addressLength) if r != -1 || unsafe errno() != EINTR { break } }
    if r == -1 && unsafe errno() != EINPROGRESS { err = -(unsafe errno()) } else { connected = true }
  }
  if connected {
    if fresh { err = unsafe streamOpenFlags(pipe, unsafe fdOf(pipe), READABLE | WRITABLE) }
    if err == 0 { unsafe ioStart(pipe, POLLOUT) }
  }
  unsafe set<i32>(pipe, S_DELAYED_ERROR, err)
  unsafe setPtr(pipe, S_CONNECT_REQ, request)
  unsafe requestInit(unsafe loopOf(pipe), request, UV_CONNECT)
  unsafe setPtr(request, C_HANDLE, pipe)
  unsafe set<Status>(request, C_CB, callback)
  // An error reaches the callback in the next tick.
  if err != 0 { unsafe feed(pipe) }
  return 0
}
/// libuv's uv_pipe_connect: every error reaches the callback.
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_pipe_connect(request: *mut u8, pipe: *mut u8, name: *const u8, callback: Status) -> () {
  let err = unsafe uv_pipe_connect2(request, pipe, name, unsafe strlen(name), 0, callback)
  if err != 0 {
    unsafe set<i32>(pipe, S_DELAYED_ERROR, err)
    unsafe setPtr(pipe, S_CONNECT_REQ, request)
    unsafe requestInit(unsafe loopOf(pipe), request, UV_CONNECT)
    unsafe setPtr(request, C_HANDLE, pipe)
    unsafe set<Status>(request, C_CB, callback)
    unsafe feed(pipe)
  }
}
// libuv's uv__pipe_getsockpeername.
unsafe fn pipeName(pipe: *mut u8, peer: bool, buffer: ?*mut u8, size: ?*mut usize) -> i32 {
  if isNull(buffer) || Pointer.isNull<usize>(size) { return -EINVAL }
  let out = unsafe nn(buffer)
  let sizePointer = unsafe Intrinsic.pointerRequalify<?*mut usize, *mut usize>(size)
  if unsafe Pointer.read<usize>(sizePointer) == 0 { return -EINVAL }
  let mut storage: [u64; 16] = [0; 16]
  let address = unsafe words(Pointer.fromMutRef<u64>(&mut storage[0]))
  let mut length: i32 = u32.toI32(SOCKADDR_UN_BYTES)
  let err = unsafe socketName(pipe, peer, address, Pointer.fromMutRef<i32>(&mut length))
  if err < 0 { unsafe Pointer.write<usize>(sizePointer, 0) return err }
  let path = unsafe offset(address, 2)
  let mut slop: usize = 1
  let mut count: usize = 0
  let mut abstractName = false
  static if Intrinsic.targetOperatingSystem() != "darwin" { abstractName = unsafe get<u8>(path, 0) == 0 }
  if abstractName {
    // Linux's abstract namespace: not NUL-terminated.
    slop = 0
    count = i32.toUsize(length) - 2
  } else {
    let end = unsafe memchr(path, 0, SUN_PATH_BYTES)
    count = if isNull(end) { SUN_PATH_BYTES } else { Pointer.address<u8>(end) - Pointer.address<u8>(path) }
  }
  if count + slop > unsafe Pointer.read<usize>(sizePointer) { unsafe Pointer.write<usize>(sizePointer, count + slop) return -ENOBUFS }
  let _copied = unsafe memcpy(out, path, count)
  unsafe Pointer.write<usize>(sizePointer, count)
  // Only a name that is not abstract is NUL-terminated.
  if unsafe get<u8>(out, 0) != 0 { unsafe set<u8>(out, count, 0) }
  return 0
}
pub export "C" fn uv_pipe_getsockname(pipe: *mut u8, buffer: ?*mut u8, size: ?*mut usize) -> i32 { return unsafe pipeName(pipe, false, buffer, size) }
pub export "C" fn uv_pipe_getpeername(pipe: *mut u8, buffer: ?*mut u8, size: ?*mut usize) -> i32 { return unsafe pipeName(pipe, true, buffer, size) }
pub export "C" fn uv_pipe_pending_instances(pipe: *mut u8, count: i32) -> () { let _unused = pipe let _count = count }
pub export "C" fn uv_pipe_pending_count(pipe: *mut u8) -> i32 {
  if !unsafe isIpc(pipe) { return 0 }
  if unsafe get<i32>(pipe, S_ACCEPTED_FD) == -1 { return 0 }
  let queued = unsafe ptr(pipe, S_QUEUED_FDS)
  if isNull(queued) { return 1 }
  return u32.wrappingToI32(unsafe get<u32>(unsafe nn(queued), 4)) + 1
}
pub export "C" fn uv_pipe_pending_type(pipe: *mut u8) -> i32 {
  if !unsafe isIpc(pipe) { return UV_UNKNOWN_HANDLE }
  let accepted = unsafe get<i32>(pipe, S_ACCEPTED_FD)
  if accepted == -1 { return UV_UNKNOWN_HANDLE }
  return unsafe guessHandle(accepted)
}
/// libuv's uv_pipe_chmod: fchmod, or chmod of the socket's name where fchmod does not apply.
pub export "C" fn uv_pipe_chmod(pipe: ?*mut u8, mode: i32) -> i32 {
  if isNull(pipe) { return -EBADF }
  let p = unsafe nn(pipe)
  let fd = unsafe fdOf(p)
  if fd == -1 { return -EBADF }
  if mode != UV_READABLE && mode != UV_WRITABLE && mode != (UV_READABLE | UV_WRITABLE) { return -EINVAL }
  let mut desired: u32 = 0
  if (mode & UV_READABLE) != 0 { desired = desired | 292 }
  if (mode & UV_WRITABLE) != 0 { desired = desired | 146 }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    if unsafe fchmod(fd, desired) != 0 { let code = unsafe errno() if code != EINVAL && code != EOPNOTSUPP { return -code } }
  } else {
    if unsafe fchmod(fd, desired) != 0 { let code = unsafe errno() if code != EINVAL && code != EOPNOTSUPP { return -code } }
  }
  let mut buffer: [u8; 4097] = [0; 4097]
  let mut length: usize = 4097
  let r = unsafe pipeName(p, false, Pointer.fromMutRef<u8>(&mut buffer[0]), Pointer.fromMutRef<usize>(&mut length))
  if r != 0 { return r }
  let mut name: *const u8 = Pointer.fromRef<u8>(&buffer[0])
  // Some platforms answer getsockname with an empty name; the bound name serves then.
  let bound = unsafe ptr(p, PIPE_NAME)
  if length == 0 && !isNull(bound) { name = unsafe nn(bound) }
  if unsafe chmod(name, desired) != 0 { return -(unsafe errno()) }
  return 0
}

// ---- TTY ------------------------------------------------------------------------------------------
/// libuv's uv_guess_handle: UV_TTY, UV_FILE, UV_NAMED_PIPE, UV_TCP, UV_UDP or UV_UNKNOWN_HANDLE.
pub unsafe fn guessHandle(fd: i32) -> i32 {
  if fd < 0 { return UV_UNKNOWN_HANDLE }
  if unsafe isatty(fd) != 0 { return UV_TTY }
  let mut status: [u64; 32] = [0; 32]
  let bytes = unsafe words(Pointer.fromMutRef<u64>(&mut status[0]))
  if unsafe fstat(fd, bytes) != 0 { return UV_UNKNOWN_HANDLE }
  let mode = if STAT_MODE_WIDE { unsafe get<u32>(bytes, STAT_MODE) } else { u16.toU32(unsafe get<u16>(bytes, STAT_MODE)) }
  let format = mode & S_IFMT
  if format == S_IFREG { return UV_FILE }
  if format == S_IFCHR { return UV_FILE }
  if format == S_IFIFO { return UV_NAMED_PIPE }
  if format != S_IFSOCK { return UV_UNKNOWN_HANDLE }
  let mut storage: [u64; 16] = [0; 16]
  let address = unsafe words(Pointer.fromMutRef<u64>(&mut storage[0]))
  let mut length: u32 = 128
  if unsafe getsockname(fd, address, Pointer.fromMutRef<u32>(&mut length)) != 0 { return UV_UNKNOWN_HANDLE }
  let mut kind: i32 = 0 let mut size: u32 = 4
  if unsafe getsockopt(fd, SOL_SOCKET, SO_TYPE, unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(Pointer.fromMutRef<i32>(&mut kind)), Pointer.fromMutRef<u32>(&mut size)) != 0 { return UV_UNKNOWN_HANDLE }
  let family = familyOf(address)
  if kind == SOCK_DGRAM && (family == AF_INET || family == AF_INET6) { return UV_UDP }
  if kind == SOCK_STREAM {
    if family == AF_INET || family == AF_INET6 { return UV_TCP }
    if family == AF_UNIX { return UV_NAMED_PIPE }
  }
  return UV_UNKNOWN_HANDLE
}
// The process's terminal state for uv_tty_reset_mode (libuv's orig_termios, orig_termios_fd and
// termios_spinlock), made by the first raw mode and never freed.
struct TtyState { lock: u32, fd: i32, termios: [u64; 9] }
unsafe fn ttyState(create: bool) -> ?*mut TtyState {
  let word = Intrinsic.processWord()
  let current = unsafe Atomic.load<u64>(word, MemoryOrder.Acquire)
  if current != 0 { return unsafe stateOf(unsafe fromAddress(u64.toUsize(current))) }
  if !create { return Pointer.null<TtyState>() }
  let made = unsafe malloc(Layout.of<TtyState>().bytes)
  if isNull(made) { return Pointer.null<TtyState>() }
  unsafe Pointer.put<TtyState>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut TtyState>(unsafe nn(made)), TtyState { lock: 0, fd: -1, termios: [0; 9] })
  let raced = unsafe Atomic.compareExchange<u64>(word, 0, usize.toU64(Pointer.address<u8>(made)), MemoryOrder.AcquireRelease, MemoryOrder.Acquire)
  match move raced {
    CompareExchange<u64>.Exchanged => { return unsafe stateOf(unsafe nn(made)) }
    CompareExchange<u64>.Observed { value } => { unsafe free(made) return unsafe stateOf(unsafe fromAddress(u64.toUsize(value))) }
  }
}
unsafe fn stateOf(pointer: *mut u8) -> ?*mut TtyState { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut TtyState>(pointer) }
unsafe fn stateBytes(state: *mut TtyState) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut TtyState, *mut u8>(state) }
unsafe fn ttyLock(state: *mut TtyState) -> () {
  let lock = unsafe cell<u32>(unsafe stateBytes(state), 0)
  while true {
    let raced = unsafe Atomic.compareExchange<u32>(lock, 0, 1, MemoryOrder.AcquireRelease, MemoryOrder.Acquire)
    match move raced {
      CompareExchange<u32>.Exchanged => { return }
      CompareExchange<u32>.Observed { value } => { let _unused = value }
    }
  }
}
unsafe fn ttyUnlock(state: *mut TtyState) -> () { unsafe Atomic.store<u32>(unsafe cell<u32>(unsafe stateBytes(state), 0), 0, MemoryOrder.SequentiallyConsistent) }
// libuv's uv__tcsetattr.
unsafe fn setAttributes(fd: i32, how: i32, termios: *const u8) -> i32 {
  while true {
    if unsafe tcsetattr(fd, how, termios) == 0 { return 0 }
    if unsafe errno() != EINTR { return -(unsafe errno()) }
  }
  return 0
}
// libuv's uv__tty_is_slave.
unsafe fn ttyIsSlave(fd: i32) -> bool {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    let mut name: [u8; 256] = [0; 256]
    return unsafe ioctl(fd, TIOCPTYGNAME, Pointer.fromMutRef<u8>(&mut name[0])) != 0
  } else {
    let mut dummy: i32 = 0
    return unsafe ioctl(fd, TIOCGPTN, Pointer.fromMutRef<i32>(&mut dummy)) != 0
  }
}
// libuv's uv__dup2_cloexec.
unsafe fn dupCloexec(from: i32, to: i32) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    let r = unsafe dup2(from, to)
    if r == -1 { return -(unsafe errno()) }
    let err = unsafe cloexec(to)
    if err != 0 { unsafe closeFd(to) return err }
    return r
  } else {
    let r = unsafe dup3(from, to, O_CLOEXEC)
    if r == -1 { return -(unsafe errno()) }
    return r
  }
}
/// libuv's uv_tty_init: a terminal is reopened through its name, so that nonblocking mode does not
/// reach other processes that share it; without a name, writes block.
pub export "C" fn uv_tty_init(loop: *mut u8, tty: *mut u8, given: i32, unused: i32) -> i32 {
  let _deprecated = unused
  let mut fd = given
  let kind = unsafe guessHandle(fd)
  if kind == UV_FILE || kind == UV_UNKNOWN_HANDLE { return -EINVAL }
  let mut bits: usize = 0
  let mut saved: i32 = -1
  while true { saved = unsafe fcntl(fd, F_GETFL) if saved != -1 || unsafe errno() != EINTR { break } }
  if saved == -1 { return -(unsafe errno()) }
  let mode = saved & O_ACCMODE
  if kind == UV_TTY {
    let mut path: [u8; 256] = [0; 256]
    let mut r: i32 = -1
    if unsafe ttyIsSlave(fd) && unsafe ttyname_r(fd, Pointer.fromMutRef<u8>(&mut path[0]), 256) == 0 { r = unsafe openCloexec(Pointer.fromRef<u8>(&path[0]), mode | O_NOCTTY) }
    if r < 0 {
      // Writes block instead.
      if mode != O_RDONLY { bits = bits | BLOCKING_WRITES }
    } else {
      let fresh = r
      let d = unsafe dupCloexec(fresh, fd)
      // EINVAL: `fresh` is `fd`, if another thread closed fd in between.
      if d < 0 && d != -EINVAL { unsafe closeFd(fresh) return d }
      fd = fresh
    }
  }
  let status = unsafe streamInit(loop, tty, UV_TTY)
  if status != 0 { return status }
  if (bits & BLOCKING_WRITES) == 0 { let _ignored = unsafe nonblock(fd, true) }
  if mode != O_WRONLY { bits = bits | READABLE }
  if mode != O_RDONLY { bits = bits | WRITABLE }
  unsafe raise(tty, bits & BLOCKING_WRITES)
  let _opened = unsafe streamOpenFlags(tty, fd, bits & (READABLE | WRITABLE))
  let selected = unsafe trySelect(tty)
  if selected != 0 { return selected }
  unsafe set<i32>(tty, S_TTY_MODE, UV_TTY_MODE_NORMAL)
  return 0
}
unsafe fn flagWord(termios: *mut u8, index: usize) -> u64 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return unsafe get<u64>(termios, index * 8) } else { return u32.toU64(unsafe get<u32>(termios, index * 4)) }
}
unsafe fn setFlagWord(termios: *mut u8, index: usize, value: u64) -> () {
  static if Intrinsic.targetOperatingSystem() == "darwin" { unsafe set<u64>(termios, index * 8, value) } else { unsafe set<u32>(termios, index * 4, u64.wrappingToU32(value)) }
}
/// libuv's uv_tty_set_mode: UV_TTY_MODE_NORMAL, UV_TTY_MODE_RAW (UV_TTY_MODE_RAW_VT is the same on
/// Unix) or UV_TTY_MODE_IO (cfmakeraw). The first mode that is not normal saves the terminal's
/// attributes for uv_tty_reset_mode.
pub export "C" fn uv_tty_set_mode(tty: *mut u8, given: i32) -> i32 {
  let mut mode = given
  if mode == UV_TTY_MODE_RAW_VT { mode = UV_TTY_MODE_RAW }
  let current = unsafe get<i32>(tty, S_TTY_MODE)
  if current == mode { return 0 }
  let fd = unsafe fdOf(tty)
  let original = unsafe offset(tty, TTY_TERMIOS)
  if current == UV_TTY_MODE_NORMAL && mode != UV_TTY_MODE_NORMAL {
    let mut rc: i32 = 0
    while true { rc = unsafe tcgetattr(fd, original) if rc != -1 || unsafe errno() != EINTR { break } }
    if rc == -1 { return -(unsafe errno()) }
    let made = unsafe ttyState(true)
    if !Pointer.isNull<TtyState>(made) {
      let state = unsafe Intrinsic.pointerRequalify<?*mut TtyState, *mut TtyState>(made)
      unsafe ttyLock(state)
      let bytes = unsafe stateBytes(state)
      if unsafe get<i32>(bytes, 4) == -1 {
        let _copied = unsafe memcpy(unsafe offset(bytes, 8), original, TERMIOS_BYTES)
        unsafe set<i32>(bytes, 4, fd)
      }
      unsafe ttyUnlock(state)
    }
  }
  let mut copy: [u64; 9] = [0; 9]
  let temporary = unsafe words(Pointer.fromMutRef<u64>(&mut copy[0]))
  let _copied = unsafe memcpy(temporary, original, TERMIOS_BYTES)
  if mode == UV_TTY_MODE_RAW {
    unsafe setFlagWord(temporary, 0, unsafe flagWord(temporary, 0) & ((BRKINT | ICRNL | INPCK | ISTRIP | IXON) ^ 18446744073709551615))
    unsafe setFlagWord(temporary, 1, unsafe flagWord(temporary, 1) | ONLCR)
    unsafe setFlagWord(temporary, 2, unsafe flagWord(temporary, 2) | CS8)
    unsafe setFlagWord(temporary, 3, unsafe flagWord(temporary, 3) & ((ECHO | ICANON | IEXTEN | ISIG) ^ 18446744073709551615))
    unsafe set<u8>(temporary, TERMIOS_CC + VMIN, 1)
    unsafe set<u8>(temporary, TERMIOS_CC + VTIME, 0)
  } else {
    if mode == UV_TTY_MODE_IO { unsafe cfmakeraw(temporary) }
    else { if mode != UV_TTY_MODE_NORMAL { return -EINVAL } }
  }
  // Applied after the output drains.
  let rc = unsafe setAttributes(fd, TCSADRAIN, temporary)
  if rc == 0 { unsafe set<i32>(tty, S_TTY_MODE, mode) }
  return rc
}
// libuv's uv__tty_close before uv__stream_close: the saved attributes go back to the terminal.
unsafe fn ttyForget(tty: *mut u8) -> () {
  let fd = unsafe fdOf(tty)
  if fd == -1 { return }
  let made = unsafe ttyState(false)
  if Pointer.isNull<TtyState>(made) { return }
  let state = unsafe Intrinsic.pointerRequalify<?*mut TtyState, *mut TtyState>(made)
  unsafe ttyLock(state)
  let bytes = unsafe stateBytes(state)
  if unsafe get<i32>(bytes, 4) == fd {
    let _ignored = unsafe setAttributes(fd, TCSANOW, unsafe offset(bytes, 8))
    unsafe set<i32>(bytes, 4, -1)
  }
  unsafe ttyUnlock(state)
}
/// libuv's uv_tty_reset_mode: async-signal-safe; UV_EBUSY while another thread is in
/// uv_tty_set_mode or closing a TTY.
pub export "C" fn uv_tty_reset_mode() -> i32 {
  let savedErrno = unsafe errno()
  let made = unsafe ttyState(false)
  if Pointer.isNull<TtyState>(made) { return 0 }
  let state = unsafe Intrinsic.pointerRequalify<?*mut TtyState, *mut TtyState>(made)
  let bytes = unsafe stateBytes(state)
  if unsafe Atomic.swap<u32>(unsafe cell<u32>(bytes, 0), 1, MemoryOrder.SequentiallyConsistent) != 0 { return -EBUSY }
  let mut err: i32 = 0
  let fd = unsafe get<i32>(bytes, 4)
  if fd != -1 { err = unsafe setAttributes(fd, TCSANOW, unsafe offset(bytes, 8)) }
  unsafe ttyUnlock(state)
  unsafe setErrno(savedErrno)
  return err
}
pub export "C" fn uv_tty_get_winsize(tty: *mut u8, width: *mut i32, height: *mut i32) -> i32 {
  let mut size: [u16; 4] = [0; 4]
  while true {
    if unsafe ioctl(unsafe fdOf(tty), TIOCGWINSZ, Pointer.fromMutRef<u16>(&mut size[0])) == 0 { break }
    if unsafe errno() != EINTR { return -(unsafe errno()) }
  }
  unsafe Pointer.write<i32>(width, u16.toI32(size[1]))
  unsafe Pointer.write<i32>(height, u16.toI32(size[0]))
  return 0
}
pub export "C" fn uv_tty_set_vterm_state(state: i32) -> () { let _unused = state }
pub export "C" fn uv_tty_get_vterm_state(state: *mut i32) -> i32 { let _unused = state return -ENOTSUP }

// ---- UDP ------------------------------------------------------------------------------------------
// libuv's uv__udp_init_ex and uv_udp_init_ex: the low 8 bits of `flags` are a domain, the others
// may hold UV_UDP_RECVMMSG.
pub export "C" fn uv_udp_init_ex(loop: *mut u8, udp: *mut u8, flags: u32) -> i32 {
  let domain = u32.wrappingToI32(flags & 255)
  if domain != AF_INET && domain != AF_INET6 && domain != AF_UNSPEC { return -EINVAL }
  let extra = flags & 4294967040
  if (extra & (UV_UDP_RECVMMSG ^ 4294967295)) != 0 { return -EINVAL }
  let mut fd: i32 = -1
  if domain != AF_UNSPEC { fd = unsafe newSocket(domain, SOCK_DGRAM, 0) if fd < 0 { return fd } }
  let status = unsafe handleInit(loop, udp, UV_UDP)
  if status != 0 { if fd >= 0 { unsafe closeFd(fd) } return status }
  unsafe set<Alloc>(udp, U_ALLOC, Intrinsic.pointerNullFunction<Alloc>())
  unsafe set<Recv>(udp, U_RECV, Intrinsic.pointerNullFunction<Recv>())
  unsafe set<usize>(udp, U_SEND_QUEUE_SIZE, 0) unsafe set<usize>(udp, U_SEND_QUEUE_COUNT, 0)
  unsafe setPtr(udp, U_SEND_FIRST, none()) unsafe setPtr(udp, U_SEND_LAST, none())
  unsafe setPtr(udp, U_DONE_FIRST, none()) unsafe setPtr(udp, U_DONE_LAST, none())
  unsafe setFd(udp, fd)
  if (extra & UV_UDP_RECVMMSG) != 0 { unsafe raise(udp, UDP_RECVMMSG) }
  return 0
}
pub export "C" fn uv_udp_init(loop: *mut u8, udp: *mut u8) -> i32 { return unsafe uv_udp_init_ex(loop, udp, 0) }
unsafe fn popSend(udp: *mut u8) -> *mut u8 {
  let request = unsafe nn(unsafe ptr(udp, U_SEND_FIRST))
  let next = unsafe ptr(request, US_NEXT)
  unsafe setPtr(udp, U_SEND_FIRST, next)
  if isNull(next) { unsafe setPtr(udp, U_SEND_LAST, none()) }
  unsafe setPtr(request, US_NEXT, none())
  return request
}
unsafe fn pushSend(udp: *mut u8, first: usize, last: usize, request: *mut u8) -> () {
  unsafe setPtr(request, US_NEXT, none())
  let tail = unsafe ptr(udp, last)
  if isNull(tail) { unsafe setPtr(udp, first, request) } else { unsafe setPtr(unsafe nn(tail), US_NEXT, request) }
  unsafe setPtr(udp, last, request)
}
/// The closing phase of a UDP record (libuv's uv__udp_finish_close): queued sends complete with
/// UV_ECANCELED, then the callbacks are dropped.
export "C" fn silkUvUdpFinish(udp: *mut u8) -> () {
  while !isNull(unsafe ptr(udp, U_SEND_FIRST)) {
    let request = unsafe popSend(udp)
    unsafe set<isize>(request, US_STATUS, i32.toIsize(UV_ECANCELED))
    unsafe pushSend(udp, U_DONE_FIRST, U_DONE_LAST, request)
  }
  unsafe udpRunCompleted(udp)
  unsafe set<Recv>(udp, U_RECV, Intrinsic.pointerNullFunction<Recv>())
  unsafe set<Alloc>(udp, U_ALLOC, Intrinsic.pointerNullFunction<Alloc>())
}
export "C" fn silkUvUdpFed(node: *mut uvl.Pending) -> () {
  let udp = unsafe fromAddress(Pointer.address<uvl.Pending>(node) - U_PENDING)
  unsafe udpIo(udp, POLLOUT)
}
// libuv's uv__udp_run_completed.
unsafe fn udpRunCompleted(udp: *mut u8) -> () {
  unsafe raise(udp, UDP_PROCESSING)
  while !isNull(unsafe ptr(udp, U_DONE_FIRST)) {
    let request = unsafe nn(unsafe ptr(udp, U_DONE_FIRST))
    let next = unsafe ptr(request, US_NEXT)
    unsafe setPtr(udp, U_DONE_FIRST, next)
    if isNull(next) { unsafe setPtr(udp, U_DONE_LAST, none()) }
    unsafe setPtr(request, US_NEXT, none())
    unsafe requestDone(unsafe loopOf(udp))
    let bufs = unsafe nn(unsafe ptr(request, US_BUFS))
    unsafe set<usize>(udp, U_SEND_QUEUE_SIZE, unsafe get<usize>(udp, U_SEND_QUEUE_SIZE) - unsafe countBufs(bufs, u32.toUsize(unsafe get<u32>(request, US_NBUFS))))
    unsafe set<usize>(udp, U_SEND_QUEUE_COUNT, unsafe get<usize>(udp, U_SEND_QUEUE_COUNT) - 1)
    if !same(bufs, unsafe offset(request, US_BUFSML)) { unsafe free(bufs) }
    unsafe setPtr(request, US_BUFS, none())
    let callback = unsafe get<Status>(request, US_SEND_CB)
    if Intrinsic.pointerIsNull<Status>(callback) { continue }
    // The status is the bytes sent, or a negative errno.
    let status = unsafe get<isize>(request, US_STATUS)
    unsafe callStatus(callback, request, if status >= 0 { 0 } else { isize.wrappingToI32(status) })
  }
  if isNull(unsafe ptr(udp, U_SEND_FIRST)) {
    // Nothing queued and nothing completed: no write watch.
    unsafe ioStop(udp, POLLOUT)
    if !unsafe ioActive(udp, POLLIN) { unsafe handleStop(udp) }
  }
  unsafe lower(udp, UDP_PROCESSING)
}
// libuv's uv__udp_io.
unsafe fn udpIo(udp: *mut u8, events: i32) -> () {
  if (events & POLLIN) != 0 { unsafe udpReceive(udp) }
  if (events & POLLOUT) != 0 && !unsafe closing(udp) {
    unsafe udpSendQueued(udp)
    unsafe udpRunCompleted(udp)
  }
}
// libuv's uv__udp_recvmmsg: datagrams of UDP_DGRAM_MAXSIZE bytes in `buf`, at most 20.
unsafe fn udpReceiveMany(udp: *mut u8, buf: *mut Buf) -> isize {
  let whole = unsafe Pointer.read<Buf>(buf)
  let mut chunks = whole.len / UDP_DGRAM_MAXSIZE
  if chunks > 20 { chunks = 20 }
  let mut peers: [u64; 80] = [0; 80]
  let mut vectors: [Buf; 20] = [Buf { base: none(), len: 0 }; 20]
  let mut headers: [u64; 160] = [0; 160]
  let peerBase = unsafe words(Pointer.fromMutRef<u64>(&mut peers[0]))
  let headerBase = unsafe words(Pointer.fromMutRef<u64>(&mut headers[0]))
  let mut k: usize = 0
  while k < chunks {
    vectors[k] = Buf { base: unsafe offset(unsafe nn(whole.base), k * UDP_DGRAM_MAXSIZE), len: UDP_DGRAM_MAXSIZE }
    let h = unsafe offset(headerBase, k * MMSG_BYTES)
    unsafe setPtr(h, 0, unsafe offset(peerBase, k * 32))
    unsafe set<u32>(h, 8, 28)
    unsafe setPtr(h, 16, unsafe Intrinsic.pointerReinterpret<*mut Buf, *mut u8>(Pointer.fromMutRef<Buf>(&mut vectors[k])))
    static if Intrinsic.targetOperatingSystem() == "darwin" { unsafe set<i32>(h, 24, 1) } else { unsafe set<usize>(h, 24, 1) }
    k = k + 1
  }
  let mut nread: isize = 0
  while true {
    static if Intrinsic.targetOperatingSystem() == "darwin" { nread = unsafe recvmsg_x(unsafe fdOf(udp), headerBase, usize.toU32(chunks), MSG_DONTWAIT) }
    else { nread = i32.toIsize(unsafe recvmmsg(unsafe fdOf(udp), headerBase, usize.toU32(chunks), 0, none())) }
    if nread != -1 || unsafe errno() != EINTR { break }
  }
  if nread < 1 {
    let code = unsafe errno()
    if nread == 0 || code == EAGAIN { unsafe callRecv(udp, 0, buf, Pointer.null<u8>(), 0) }
    else { unsafe callRecv(udp, i32.toIsize(-code), buf, Pointer.null<u8>(), 0) }
    return nread
  }
  k = 0
  while k < isize.toUsize(nread) && !Intrinsic.pointerIsNull<Recv>(unsafe get<Recv>(udp, U_RECV)) {
    let h = unsafe offset(headerBase, k * MMSG_BYTES)
    let mut bits = UV_UDP_MMSG_CHUNK
    let mut messageFlags: i32 = 0
    static if Intrinsic.targetOperatingSystem() == "darwin" { messageFlags = unsafe get<i32>(h, 44) } else { messageFlags = unsafe get<i32>(h, 48) }
    if (messageFlags & MSG_TRUNC) != 0 { bits = bits | UV_UDP_PARTIAL }
    let chunk = vectors[k]
    let mut length: isize = 0
    static if Intrinsic.targetOperatingSystem() == "darwin" { length = usize.toIsize(unsafe get<usize>(h, MMSG_LENGTH)) } else { length = u32.toIsize(unsafe get<u32>(h, MMSG_LENGTH)) }
    unsafe callRecv(udp, length, Pointer.fromRef<Buf>(&chunk), unsafe ptr(h, 0), bits)
    k = k + 1
  }
  // One last callback, so that the addon frees the whole buffer.
  if !Intrinsic.pointerIsNull<Recv>(unsafe get<Recv>(udp, U_RECV)) { unsafe callRecv(udp, 0, buf, Pointer.null<u8>(), UV_UDP_MMSG_FREE) }
  return nread
}
// libuv's uv__udp_recvmsg.
unsafe fn udpReceive(udp: *mut u8) -> () {
  let mut count: i32 = 32
  let mut nread: isize = 0
  while true {
    let mut buf = Buf { base: none(), len: 0 }
    unsafe callAlloc(unsafe get<Alloc>(udp, U_ALLOC), udp, UDP_DGRAM_MAXSIZE, Pointer.fromMutRef<Buf>(&mut buf))
    if isNull(buf.base) || buf.len == 0 {
      unsafe callRecv(udp, i32.toIsize(-ENOBUFS), Pointer.fromRef<Buf>(&buf), Pointer.null<u8>(), 0)
      return
    }
    if unsafe uv_udp_using_recvmmsg(udp) != 0 {
      nread = unsafe udpReceiveMany(udp, Pointer.fromMutRef<Buf>(&mut buf))
      if nread > 0 { count = count - isize.wrappingToI32(nread) }
    } else {
      let mut peer: [u64; 16] = [0; 16]
      let peerBytes = unsafe words(Pointer.fromMutRef<u64>(&mut peer[0]))
      let fd = unsafe fdOf(udp)
      static if Intrinsic.targetOperatingSystem() == "darwin" {
        let mut message = Message { name: peerBytes, nameLength: 128, vectors: unsafe Intrinsic.pointerReinterpret<*mut Buf, *mut Iovec>(Pointer.fromMutRef<Buf>(&mut buf)), vectorCount: 1, control: none(), controlLength: 0, flags: 0 }
        while true { nread = unsafe recvmsg(fd, Pointer.fromMutRef<Message>(&mut message), 0) if nread != -1 || unsafe errno() != EINTR { break } }
        if nread == -1 {
          let code = unsafe errno()
          unsafe callRecv(udp, if code == EAGAIN { 0 } else { i32.toIsize(-code) }, Pointer.fromRef<Buf>(&buf), Pointer.null<u8>(), 0)
        } else {
          unsafe callRecv(udp, nread, Pointer.fromRef<Buf>(&buf), peerBytes, if (message.flags & MSG_TRUNC) != 0 { UV_UDP_PARTIAL } else { 0 })
        }
      } else {
        let mut message = Message { name: peerBytes, nameLength: 128, vectors: unsafe Intrinsic.pointerReinterpret<*mut Buf, *mut Iovec>(Pointer.fromMutRef<Buf>(&mut buf)), vectorCount: 1, control: none(), controlLength: 0, flags: 0 }
        while true { nread = unsafe recvmsg(fd, Pointer.fromMutRef<Message>(&mut message), 0) if nread != -1 || unsafe errno() != EINTR { break } }
        if nread == -1 {
          let code = unsafe errno()
          unsafe callRecv(udp, if code == EAGAIN { 0 } else { i32.toIsize(-code) }, Pointer.fromRef<Buf>(&buf), Pointer.null<u8>(), 0)
        } else {
          unsafe callRecv(udp, nread, Pointer.fromRef<Buf>(&buf), peerBytes, if (message.flags & MSG_TRUNC) != 0 { UV_UDP_PARTIAL } else { 0 })
        }
      }
      count = count - 1
    }
    // The receive callback may stop or close the handle.
    if !(nread != -1 && count > 0 && unsafe fdOf(udp) != -1 && !Intrinsic.pointerIsNull<Recv>(unsafe get<Recv>(udp, U_RECV))) { break }
  }
