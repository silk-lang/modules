//! What `getComputedStyle` costs a JavaScript app on the embedded engine: 1,000 styled rows,
//! then loops of 1,000 reads of one kind each, timed around the call that runs them. Prints
//! the median of seven runs per loop in microseconds per read. Run from the repository root:
//! `silk build --manifest-path modules/js/bench/computed/silk.toml --profile release`, then
//! the binary. `bench/computed.html` runs the same loops in a browser, for comparison.
import ui_js.lib { JsHost, JsError, uiPackage, runtimeStylesheets }
import ui_tree.lib { Tree, TreeError, ProtocolError, Viewport }
import ui_fixtures.fixtures as fixtures
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.runtime_memory { RuntimeAllocator }
import silk.num.u32
import silk.core.effect { Effect }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.collections.list { List }
import silk.text.string { String }
import silk.core.result { Result }
import silk.num.i64
import silk.num.f64

fn viewport() -> Viewport {
  return Viewport { width: 800.0, height: 600.0, scale: 1.0 }
}

effect fn now() -> f64 {
  let mut clock = OsMonotonicClock.make()
  let at = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  return i64.toF64(at.seconds()) * 1000.0 + i64.toF64(u32.toI64(at.subsecondNanoseconds())) / 1000000.0
}

const SETUP: &[u8] = b"import { CSSStyleSheet, IntersectionObserver, createBox, createText, elementFromPoint, mount } from '@silkui/core'; globalThis.elementFromPoint = elementFromPoint; globalThis.IntersectionObserver = IntersectionObserver; const root = createBox({ fontSize: '10px', color: 'rgb(0, 0, 255)' }); const sheet = new CSSStyleSheet(); sheet.replaceSync('.row { padding: 4px 1em; margin: 2px; border: 1px solid red; display: flex; cursor: pointer } .row:nth-child(odd) { opacity: 0.5 }'); root.adoptedStyleSheets.push(sheet); globalThis.rows = []; for (let i = 0; i < 1000; i++) { const row = createBox({ height: '12px' }); row.className = 'row'; row.appendChild(createText('row ' + i)); root.appendChild(row); rows.push(row); } const list = createBox({ height: '600px', overflow: 'auto' }); globalThis.items = []; for (let i = 0; i < 1000; i++) { const item = createBox({ height: '20px', flexShrink: 0 }); items.push(item); list.appendChild(item); } globalThis.list = list; const page = createBox({ flexDirection: 'row' }); page.appendChild(root); page.appendChild(list); mount(page); globalThis.first = getComputedStyle(rows[0]); globalThis.sink = 0;"

/// The loops: a name and the JavaScript that does 1,000 reads.
fn loops() -> [[&'static [u8]; 2]; 16] {
  return [
    [b"empty loop (subtracted from the rest)", b"for (let i = 0; i < 1000; i++) sink += i;"],
    [b"__ui.now(), a native call that does nothing", b"for (let i = 0; i < 1000; i++) sink += __ui.now();"],
    [b"__ui.computed(id, 'opacity'), the native read alone", b"for (let i = 0; i < 1000; i++) sink += __ui.computed(rows[0].nodeId, 'opacity').length;"],
    [b"style.opacity, one node (typed value)", b"for (let i = 0; i < 1000; i++) sink += first.opacity.length;"],
    [b"style.cursor, one node (cascaded value)", b"for (let i = 0; i < 1000; i++) sink += first.cursor.length;"],
    [b"style.width, one node (used value)", b"for (let i = 0; i < 1000; i++) sink += first.width.length;"],
    [b"getPropertyValue('padding-left'), one node", b"for (let i = 0; i < 1000; i++) sink += first.getPropertyValue('padding-left').length;"],
    [b"getComputedStyle(row).paddingLeft, 1,000 nodes", b"for (let i = 0; i < 1000; i++) sink += getComputedStyle(rows[i]).paddingLeft.length;"],
    [b"getComputedStyle(row).color, 1,000 nodes (inherited)", b"for (let i = 0; i < 1000; i++) sink += getComputedStyle(rows[i]).color.length;"],
    [b"write height then read it, 1,000 times (a layout per read)", b"for (let i = 0; i < 1000; i++) { rows[i].style.set({ height: (10 + i % 7) + 'px' }); sink += first.height.length; }"],
    [b"getBoundingClientRect(), one node, nothing pending", b"for (let i = 0; i < 1000; i++) sink += rows[5].getBoundingClientRect().width;"],
    [b"getBoundingClientRect(), 1,000 nodes", b"for (let i = 0; i < 1000; i++) sink += rows[i].getBoundingClientRect().top;"],
    [b"offsetWidth, one node", b"for (let i = 0; i < 1000; i++) sink += rows[5].offsetWidth;"],
    [b"write height then getBoundingClientRect(), 1,000 times (a layout per read)", b"for (let i = 0; i < 1000; i++) { rows[i].style.set({ height: (10 + i % 7) + 'px' }); sink += rows[0].getBoundingClientRect().height; }"],
    [b"elementFromPoint(x, y)", b"for (let i = 0; i < 1000; i++) sink += elementFromPoint(20, i % 500) ? 1 : 0;"],
    [b"scrollIntoView() in a 1,000-item list", b"for (let i = 0; i < 1000; i++) items[(i * 37) % 1000].scrollIntoView({ block: 'nearest' });"],
  ]
}

effect fn measure(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> () ! TreeError | ProtocolError | OutOfMemoryError | JsError ? &mut Allocator {
  host.setStylesheetCompiler(runtimeStylesheets())
  run host.define(b"@silkui/core", uiPackage())
  host.attach(tree.engineMut())
  run host.module(SETUP, b"setup.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  let table = loops()
  let mut empty = 0.0
  let mut i: usize = 0
  while i < table.length {
    let mut times = List<f64>.make()
    let mut run_: usize = 0
    while run_ < 7 {
      host.attach(tree.engineMut())
      let start = run now()
      run host.evaluate(table[i][1], b"loop.js")
      let end = run now()
      let took = end - start
      run times.append(took)
      run host.flush(&mut tree)
      drop run tree.frame(viewport(), 0.0)
      run_ = run_ + 1
    }
    let sorted = times.asMutSlice()
    // Insertion sort: seven entries.
    let mut a: usize = 1
    while a < sorted.length {
      let mut b = a
      while b > 0 && sorted[b - 1] > sorted[b] {
        let t = sorted[b]
        sorted[b] = sorted[b - 1]
        sorted[b - 1] = t
        b = b - 1
      }
      a = a + 1
    }
    let median = sorted[3]
    if i == 0 { empty = median }
    let perRead = if i == 0 { median } else { median - empty }
    // Milliseconds for 1,000 reads are microseconds per read.
    StderrWriter.print("{}: {} us per read ({} ms for the loop)\n", &(unsafe String.fromUtf8Unchecked(table[i][0]), f64.round(perRead * 100.0) / 100.0, f64.round(median * 100.0) / 100.0))
    i = i + 1
  }
  run scrolling(&mut host.*, &mut tree.*, false)
  run scrolling(&mut host.*, &mut tree.*, true)
}

/// 300 frames that scroll the 1,000-item list by 7 px, without and then with one
/// IntersectionObserver on every item: the frame's layout and the observers, per frame.
effect fn scrolling(host: &mut JsHost<'_>, tree: &mut Tree<'_>, observed: bool) -> () ! TreeError | ProtocolError | OutOfMemoryError | JsError ? &mut Allocator {
  if observed {
    run host.evaluate(b"globalThis.entries = 0; const io = new IntersectionObserver((list) => { entries += list.length; }, { threshold: [0, 0.5, 1] }); for (const item of items) io.observe(item);", b"observe.js")
  }
  let mut framing = 0.0
  let mut observing = 0.0
  let mut i: usize = 0
  while i < 300 {
    host.attach(tree.engineMut())
    run host.evaluate(b"list.scrollTop = (list.scrollTop + 7) % 19000;", b"scroll.js")
    run host.flush(&mut tree)
    let start = run now()
    drop run tree.frame(viewport(), 0.0)
    let framed = run now()
    run host.observe(tree.engineMut())
    let end = run now()
    framing = framing + (framed - start)
    observing = observing + (end - framed)
    i = i + 1
  }
  StderrWriter.print("scrolling 1,000 items, {}: frame {} ms, observers {} ms per frame\n", &(if observed { "observed" } else { "not observed" }, f64.round(framing / 300.0 * 1000.0) / 1000.0, f64.round(observing / 300.0 * 1000.0) / 1000.0))
  if observed {
    run host.evaluate(b"console.log('entries delivered over 300 frames: ' + entries)", b"log.js")
  }
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("ui-js-bench-computed: failed\n", &())
  return 1
}

effect fn ran() -> i32 ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let domain = run WaiterDomain.make()
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut host = run JsHost.open(&memory, domain.handle()) |> Effect.provideMut<Allocator>(&mut allocator)
  let measured = run Effect.result(measure(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  run host.close() |> Effect.provideMut<Allocator>(&mut allocator)
  return match move measured {
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError>.Success { .. } => 0
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError>.Failure { error } => match move error {
      JsError { message } => {
        StderrWriter.print("{}\n", &.(String.view(&message)))
        1
      }
      _ => 1
    }
  }
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(ran(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
