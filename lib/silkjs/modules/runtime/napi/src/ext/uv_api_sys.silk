pub export "C" fn uv_os_getppid() -> i32 { return unsafe os.uv_os_getppid() }
pub export "C" fn uv_os_getpriority(pid: i32, priority: ?*mut i32) -> i32 {
  if Pointer.isNull<i32>(priority) { return 0 - EINVAL }
