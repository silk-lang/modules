      drop v
      let mut full: [u8; 16] = [0; 16]
      if x.tagLength == 0 || aeadFailed(shadow.finish(&mut full)) { return unsafe failWith(&mut c.*, b"") }
      // Constant time over the given tag's length.
      let mut difference: u8 = 0
      let mut i: usize = 0
      while i < x.tagLength { difference = u8.bitOr(difference, u8.bitXor(full[i], x.tag[i])) i = i + 1 }
      if difference != 0 { return unsafe failWith(&mut c.*, b"") }
