    let rv2 = unsafe addRst(sp, id, INTERNAL_ERROR, true)
    if isFatal(rv2) { return rv2 }
    unsafe setState(sp, IB_IGN_HEADER_BLOCK)
    return 2
  }
  unsafe setState(sp, if rv == ERR_IGN_HEADER_BLOCK { IB_IGN_HEADER_BLOCK } else { IB_READ_HEADER_BLOCK })
  return 2
}
unsafe fn readNbyteDone(sp: *mut Session) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let kind = s.hdKind let flags = s.hdFlags let left = s.payloadLeft let padlen = s.padlen drop s
  if kind == HEADERS {
    if padlen == 0 && u8.bitAnd(flags, F_PADDED) != 0 {
      let pri = priorityLen(flags)
      let pad = unsafe computePad(sp)
      if pad < 0 || i64.toUsize(pad) + pri > 1 + left {
        let rv = unsafe terminateSession(sp, PROTOCOL_ERROR, b"HEADERS: invalid padding")
        if isFatal(rv) { return rv }
        return 1
      }
      if pri > 0 {
        if left < pri { unsafe setState(sp, IB_FRAME_SIZE_ERROR) return 2 }
        unsafe setState(sp, IB_READ_NBYTE) unsafe setMark(sp, pri)
        return 0
      }
      unsafe setMark(sp, 0)
