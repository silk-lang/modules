import silk.build.plan { Library, Plan }
import silk.build.step { sourcePath }

static fn plan() -> Plan {
  let mut plan = Plan.empty()
  if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan
      |> Plan.compileNative(
        "c",
        sourcePath("native/pty_unix.c"),
        &["-std=c11", "-O2", "-Wall", "-Wextra", "-Werror"],
        &[],
      )
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan
      |> Plan.compileNative(
        "c",
        sourcePath("native/pty_windows.c"),
        &["-std=c11", "-O2", "-Wall", "-Wextra", "-Werror"],
        &[],
      )
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("util", Library.dynamicSearch())
  }
  return plan
}

pub const PLAN: Plan = plan()
