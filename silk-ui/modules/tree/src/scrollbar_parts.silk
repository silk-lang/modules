//! Styles for the existing overlay scrollbar, its track, and its draggable thumb.
import thin { Thin }
import engine { UiTree, TreeError, applyUsing }
import node { Node }
import mutation { NodeKind, ScrollbarWidth }
import style { Computed, Paint, Fill, NATIVE_THUMB }
import style
import style_sheets
import scrollbar
import font_units
import containers
import container_watch
import timing { EasingStops }
import svg_css.adopted { StyleSheets }
import svg_css.element { PseudoTarget, StateBits }
import properties.catalog { Property }
import properties.values { Declaration }
import properties.values
import properties.computed { SizeValue, DimensionKind }
import silk.collections.list { List }
import silk.geometry.corners { Corners }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.usize

pub struct Part { pub paint: Paint, pub hidden: bool }
impl Copy for Part {}

pub struct Scrollbars {
  pub bar: Part,
  pub thumb: Part,
  pub track: Part,
  pub width: Option<f32>,
  pub height: Option<f32>,
  pub usesViewport: bool,
}
impl Copy for Scrollbars {}

pub fn of(node: &Node) -> Option<&Scrollbars> {
  if let Option.Some { value } = node.identity() {
    return value.scrollbars.get()
  }
  return Option<&Scrollbars>.None
}

pub fn usesViewport(node: &Node) -> bool { return match of(node) { Option.Some { value } => value.usesViewport _ => false } }

pub fn present(sheets: &StyleSheets) -> bool {
  let mut i: usize = 0
  while i < sheets.sheets().length {
    let rules = sheets.sheets()[i].sheet.resolver.rules()
    let mut j: usize = 0
    while j < rules.length {
      let selectors = &rules[j].selectors
      if selectors.hasPseudoTarget(PseudoTarget.Scrollbar) || selectors.hasPseudoTarget(PseudoTarget.ScrollbarThumb)
        || selectors.hasPseudoTarget(PseudoTarget.ScrollbarTrack) { return true }
      j = j + 1
    }
    i = i + 1
  }
  return false
}

fn applies(property: Property, target: PseudoTarget) -> bool {
  if property == Property.Width || property == Property.Height { return target == PseudoTarget.Scrollbar }
  return match property {
    Property.Display | Property.Visibility | Property.Color | Property.BackgroundColor
    | Property.BorderTopLeftRadius | Property.BorderTopRightRadius | Property.BorderBottomLeftRadius | Property.BorderBottomRightRadius
    | Property.BorderTopWidth | Property.BorderRightWidth | Property.BorderBottomWidth | Property.BorderLeftWidth
    | Property.BorderTopColor | Property.BorderRightColor | Property.BorderBottomColor | Property.BorderLeftColor
    | Property.BorderTopStyle | Property.BorderRightStyle | Property.BorderBottomStyle | Property.BorderLeftStyle => true
    _ => false
  }
}

struct ResolvedPart { computed: Computed, declared: bool }

effect fn resolvePart(tree: &mut UiTree<'_>, slot: u32, target: PseudoTarget) -> ResolvedPart
  ! TreeError | OutOfMemoryError ? &mut Allocator {
  let resolved = run tree.resolveGeneratedStyle(slot, target, StateBits.empty(), true)
  let mut declarations = List<Declaration>.make()
  let parent = tree.node(slot).computed().*
  let mut computed = Computed.inViewport(parent.text, parent.viewportWidth, parent.viewportHeight)
  if target == PseudoTarget.ScrollbarThumb {
    computed.paint.background = Fill.Solid { color: NATIVE_THUMB }
    computed.paint.radii = Corners<f32>.uniform(3.0)
  }
  let mut i: usize = 0
  while i < resolved.declarations.length() {
    let declaration = &resolved.declarations.asSlice()[i]
    if applies(declaration.property, target) {
      if style.containerDependent(declaration) { computed.usesContainer = true computed.usesViewport = true }
      run declarations.append(run values.cloneDeclaration(declaration))
    }
    i = i + 1
  }
  if computed.usesContainer {
    computed.containerWidth = containers.physicalUnitFor(&tree, slot, target, true)
    computed.containerHeight = containers.physicalUnitFor(&tree, slot, target, false)
  }
  let units = font_units.descendantContext(&tree, &computed, tree.node(slot).fontKey)
  let mut stops = EasingStops.make()
  run applyUsing(&mut computed, declarations.asSlice(), &parent, &mut stops, &units)
  run container_watch.partUnits(&mut tree, slot, target, computed.usesContainer, computed.containerWidth, computed.containerHeight)
  return ResolvedPart { computed: computed, declared: declarations.length() != 0 }
}

fn part(computed: &Computed) -> Part {
  return Part { paint: computed.paint, hidden: computed.layout.display.isNone() || !computed.text.visible }
}

fn length(value: SizeValue) -> Option<f32> {
  if value.kind == DimensionKind.Length || value.kind == DimensionKind.Calc && value.percent == 0.0 {
    return Option<f32>.some(f32.max(0.0, value.value))
  }
  return Option<f32>.None
}

effect fn clear(tree: &mut UiTree<'_>, slot: u32) ! OutOfMemoryError ? &mut Allocator {
  if of(tree.node(slot)).isSome() {
    let node = tree.nodeMut(slot)
    let identity = run node.identityMut()
    identity.scrollbars.clear()
    node.content = node.content + 1
  }
}

pub effect fn resolve(tree: &mut UiTree<'_>, slot: u32) ! TreeError | OutOfMemoryError ? &mut Allocator {
  let at = style_sheets.index(tree.styleSheets.asSlice(), tree.current)
  let origin = tree.node(slot)
  let c = origin.computed().*
  let enabled = at != usize.MAX && tree.styleSheets.asSlice()[at].sheets.length() != 0 && tree.styleSheets.asSlice()[at].hasScrollbars
    && origin.kind != NodeKind.Text && !origin.isGenerated() && c.layout.scrollbarWidth == ScrollbarWidth.Auto && c.scroll.colors.auto()
    && (scrollbar.userScrolls(scrollbar.usedOverflow(&c, true)) || scrollbar.userScrolls(scrollbar.usedOverflow(&c, false)))
    && tree.styleSheets.asSlice()[at].scrollbarSubjects.mayMatch(origin, tree.isRootNode(slot))
  if !enabled {
    run clear(&mut tree, slot)
    let targets = [PseudoTarget.Scrollbar, PseudoTarget.ScrollbarThumb, PseudoTarget.ScrollbarTrack]
    let mut i: usize = 0
    while i < targets.length {
      run container_watch.record(&mut tree, slot, targets[i], &[])
      run container_watch.partUnits(&mut tree, slot, targets[i], false, Option<f32>.None, Option<f32>.None)
      i = i + 1
    }
    return ()
  }
  let bar = run resolvePart(&mut tree, slot, PseudoTarget.Scrollbar)
  let thumb = run resolvePart(&mut tree, slot, PseudoTarget.ScrollbarThumb)
  let track = run resolvePart(&mut tree, slot, PseudoTarget.ScrollbarTrack)
  if !bar.declared && !thumb.declared && !track.declared { run clear(&mut tree, slot) return () }
  let resolved = Scrollbars { bar: part(&bar.computed), thumb: part(&thumb.computed), track: part(&track.computed),
    width: length(bar.computed.layout.width), height: length(bar.computed.layout.height),
    usesViewport: bar.computed.usesViewport || thumb.computed.usesViewport || track.computed.usesViewport }
  let node = tree.nodeMut(slot)
  let identity = run node.identityMut()
  match identity.scrollbars.getMut() {
    Option.Some { value } => { value.* = resolved }
    _ => { identity.scrollbars.set(run Thin<Scrollbars>.make(resolved)) }
  }
  node.content = node.content + 1
}
