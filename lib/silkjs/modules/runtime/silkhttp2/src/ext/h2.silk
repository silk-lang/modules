                let rv4 = unsafe updateConsumed(sp, nullStream(), i64.toUsize(dataReadlen))
                if isFatal(rv4) { return i32.toI64(rv4) }
                if unsafe state(sp) == IB_IGN_DATA { return inlen }
              }
              let rv5 = unsafe addRst(sp, id, PROTOCOL_ERROR, true)
              if isFatal(rv5) { return i32.toI64(rv5) }
              busy = true
              unsafe setState(sp, IB_IGN_DATA)
              handled = true
            } else {
              let s3 = unsafe ses(&mut a, sp) let set = u32.bitAnd(s3.callbacks.set, CB_DATA) != 0 let callback = s3.callbacks.dataChunk let me = s3.me let user = s3.user drop s3
              if set {
