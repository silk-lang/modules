//! Scripted interaction tests: synthetic input in, event records, states and pixels out.
//! The inbox fixture: a toolbar of three buttons (the last disabled) over a scrolling list of
//! ten rows, row 3 holding a nested scroll box; every node listens for every record.
import ui_tree.css
import ui_fixtures.fixtures as fixtures
import ui_tree.legacy {
  UiTree,
  TreeError,
  Batch,
  FrameInput,
  CpuSnapshot,
  NodeInfo,
  NodeKind,
  FlexDirection,
  Overflow,
  Position,
  Attribute,
  Event,
  EventKind,
  Input,
  Cursor,
  NONE,
  MOD_SHIFT,
  BUTTON_PRIMARY,
  StyleState,
  info
}
import ui_tree.mutation { Declaration, Value, Keyword, CssProperty, LISTEN_REQUEST }
import ui_tree.input { Request, REQUEST_ANYWHERE, MOD_ALT, BUTTON_BACK }
import ui_tree.style { Fill }
import font_collection.lib { FontCollection }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import svg_css.written
import svg_css.tokens { CssError }
import ui_tree.style { REGION_NONE, REGION_NO_DRAG }

fn viewport() -> FrameInput {
  return fixtures.viewport(2)
}

/// A fresh inbox after its first frame.
effect fn inbox(collection: &FontCollection) -> UiTree<'_>
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run fixtures.inbox(&mut batch)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  return move tree
}

effect fn drain(tree: &mut UiTree<'_>) -> List<Event>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut events = List<Event>.make()
  run tree.takeEvents(&mut events)

  // This suite asserts input ordering; geometry notifications have separate app coverage.
  let mut i: usize = 0
  while i < events.length() {
    if events.asSlice()[i].kind == EventKind.Layout {
      drop events.remove(i)
    } else {
      i = i + 1
    }
  }
  return move events
}

effect fn pointerMove(tree: &mut UiTree<'_>, x: f32, y: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run tree.dispatch(Input.PointerMove { x: x, y: y, modifiers: 0 })
}

effect fn down(tree: &mut UiTree<'_>, x: f32, y: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run tree.dispatch(
    Input.PointerDown { x: x, y: y, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 },
  )
}

effect fn up(tree: &mut UiTree<'_>, x: f32, y: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run tree.dispatch(Input.PointerUp { x: x, y: y, button: BUTTON_PRIMARY, modifiers: 0 })
}

effect fn wheel(tree: &mut UiTree<'_>, x: f32, y: f32, deltaY: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run tree.dispatch(Input.Wheel { x: x, y: y, deltaX: 0.0, deltaY: deltaY, modifiers: 0 })
}

effect fn keyDown(tree: &mut UiTree<'_>, key: string, modifiers: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run tree.dispatch(
    Input.KeyDown {
      key: run String.copy(key),
      code: run String.copy(key),
      modifiers: modifiers,
      repeat: false,
    },
  )
}

effect fn keyUp(tree: &mut UiTree<'_>, key: string, modifiers: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run tree.dispatch(
    Input.KeyUp { key: run String.copy(key), code: run String.copy(key), modifiers: modifiers },
  )
}

/// Tab (or Shift+Tab) down and up.
effect fn tab(tree: &mut UiTree<'_>, backward: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let modifiers: u32 = if backward {
    MOD_SHIFT
  } else {
    0
  }
  run keyDown(&mut tree, "Tab", modifiers)
  run keyUp(&mut tree, "Tab", modifiers)
}

/// The number of records of `kind` for `target`.
fn count(events: &List<Event>, kind: EventKind, target: u32) -> usize {
  let values = events.asSlice()
  let mut found: usize = 0
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == kind && values[i].target == target {
      found = found + 1
    }
    i = i + 1
  }
  return found
}

/// The number of records of `kind` for any target.
fn countKind(events: &List<Event>, kind: EventKind) -> usize {
  let values = events.asSlice()
  let mut found: usize = 0
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == kind {
      found = found + 1
    }
    i = i + 1
  }
  return found
}

/// The first record of `kind`, or a dummy with target NONE.
effect fn first(events: &List<Event>, kind: EventKind) -> Event
  ! OutOfMemoryError
  ? &mut Allocator {
  let values = events.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == kind {
      let e = &values[i]
      let mut path = List<u32>.make()
      run path.appendSlice(e.path.asSlice())
      let mut copy = Event.make(e.kind, e.target, move path)
      copy.x = e.x
      copy.y = e.y
      copy.button = e.button
      copy.detail = e.detail
      copy.deltaY = e.deltaY
      return move copy
    }
    i = i + 1
  }
  return Event.make(kind, NONE, List<u32>.make())
}

fn samePath(path: &List<u32>, expected: &[u32]) -> bool {
  if path.length() != expected.length {
    return false
  }
  let mut i: usize = 0
  while i < expected.length {
    if path.get(i) != expected[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn sameColor(a: Rgba<f32>, b: Rgba<f32>) -> bool {
  return f32.abs(a.r - b.r) < 0.002 && f32.abs(a.g - b.g) < 0.002 && f32.abs(a.b - b.b) < 0.002
    && f32.abs(a.a - b.a) < 0.002
}

fn background(tree: &UiTree<'_>, id: u32) -> Rgba<f32> {
  return match tree.node(tree.slotOf(id)).computed().paint.background {
    Fill.Solid { color } => color
    _ => Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
  }
}

fn near(a: f32, b: f32) -> bool {
  return f32.abs(a - b) < 0.5
}

effect fn boundsOf(tree: &UiTree<'_>, id: u32) -> NodeInfo
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  return match run info(tree, id) {
    Option<NodeInfo>.Some { value } => value
    Option<NodeInfo>.None => {
      run Testing.expect(false, "the node exists")
      return run boundsOf(tree, fixtures.PANEL)
    }
  }
}

fn samePixels(a: &Pixmap, b: &Pixmap) -> bool {
  let x = a.data()
  let y = b.data()
  if a.width() != b.width() || a.height() != b.height() || x.length != y.length {
    return false
  }
  let mut i: usize = 0
  while i < x.length {
    if x[i] != y[i] {
      return false
    }
    i = i + 1
  }
  return true
}

// Pointer.

/// New: center (40, 27). Archive: (113, 27). Delete (disabled): (194, 27). The toolbar gap
/// between New and Archive: (71, 27).
effect fn pointerBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  run Testing.expect(tree.hitTest(30.0, 27.0) == fixtures.NEW_BUTTON, "text hits its element")
  run Testing.expect(tree.hitTest(71.0, 27.0) == fixtures.TOOLBAR, "a gap hits the toolbar")
  run Testing.expect(tree.hitTest(5.0, 5.0) == fixtures.PANEL, "padding hits the panel")
  run Testing.expect(tree.hitTest(400.0, 5.0) == NONE, "outside the viewport hits nothing")

  // Hover: over on the target, enter records outermost first, then the move.
  run pointerMove(&mut tree, 40.0, 27.0)
  let mut events = run drain(&mut tree)
  run Testing.expect(
    events.length() == 5 && events.asSlice()[0].kind == EventKind.PointerOver
      && events.asSlice()[0].target == fixtures.NEW_BUTTON
      && events.asSlice()[1].kind == EventKind.PointerEnter
      && events.asSlice()[1].target == fixtures.PANEL
      && events.asSlice()[2].target == fixtures.TOOLBAR
      && events.asSlice()[3].target == fixtures.NEW_BUTTON,
    "entering New is over the button, then enters the panel, the toolbar and the button",
  )
  let moved = run first(&events, EventKind.PointerMove)
  run Testing.expect(
    moved.target == fixtures.NEW_BUTTON && moved.x == 40.0 && moved.y == 27.0
      && samePath(&moved.path, &[fixtures.PANEL, fixtures.TOOLBAR, fixtures.NEW_BUTTON]),
    "the move record has the position and the path",
  )
  run Testing.expect(tree.needsFrame(), "a hover change needs a frame")
  run tree.frame(viewport())
  run Testing.expect(
    sameColor(background(&tree, fixtures.NEW_BUTTON), fixtures.rgb(0xd1d5db)),
    "the hover look applies",
  )
  run Testing.expect(tree.cursor() == Cursor.Pointer, "the button's cursor shows")
  run Testing.expect(
    tree.stats.layoutSkipped && tree.stats.repaintedSubtrees == 3,
    "a hover look repaints the button and its ancestors without layout",
  )
  run Testing.expect(!tree.needsFrame(), "nothing more to draw")

  run pointerMove(&mut tree, 113.0, 27.0)
  events = run drain(&mut tree)
  run Testing.expect(
    count(&events, EventKind.PointerLeave, fixtures.NEW_BUTTON) == 1
      && count(&events, EventKind.PointerEnter, fixtures.ARCHIVE_BUTTON) == 1
      && count(&events, EventKind.PointerLeave, fixtures.TOOLBAR) == 0,
    "moving to Archive leaves New only",
  )

  // Press Archive, drag to New and release: the moves and the release go to Archive, which
  // holds the capture, and the click goes to the toolbar, the nearest common ancestor.
  run down(&mut tree, 113.0, 27.0)
  events = run drain(&mut tree)
  let pressed = run first(&events, EventKind.PointerDown)
  run Testing.expect(
    pressed.target == fixtures.ARCHIVE_BUTTON && pressed.detail == 1,
    "the down record goes to Archive",
  )
  run Testing.expect(
    count(&events, EventKind.Focus, fixtures.ARCHIVE_BUTTON) == 1,
    "pressing a focusable node focuses it",
  )
  run tree.frame(viewport())
  run Testing.expect(
    sameColor(background(&tree, fixtures.ARCHIVE_BUTTON), fixtures.rgb(0x9ca3af)),
    "the active look applies while pressed",
  )
  run Testing.expect(
    !tree.node(tree.slotOf(fixtures.ARCHIVE_BUTTON)).computed().paint.hasShadow,
    "focus from the pointer does not show the focus-visible ring",
  )
  run pointerMove(&mut tree, 40.0, 27.0)
  events = run drain(&mut tree)
  run Testing.expect(
    count(&events, EventKind.PointerMove, fixtures.ARCHIVE_BUTTON) == 1,
    "moves go to the node holding the capture",
  )
  run up(&mut tree, 40.0, 27.0)
  events = run drain(&mut tree)
  let click = run first(&events, EventKind.Click)
  run Testing.expect(
    count(&events, EventKind.PointerUp, fixtures.ARCHIVE_BUTTON) == 1,
    "the up record goes to the capture",
  )
  run Testing.expect(
    click.target == fixtures.TOOLBAR && samePath(&click.path, &[fixtures.PANEL, fixtures.TOOLBAR]),
    "the click goes to the common ancestor",
  )
  run tree.frame(viewport())
  run Testing.expect(
    sameColor(background(&tree, fixtures.ARCHIVE_BUTTON), fixtures.rgb(0xe5e7eb)),
    "the active look ends with the release",
  )

  // A plain click on New.
  run down(&mut tree, 40.0, 27.0)
  run up(&mut tree, 40.0, 27.0)
  events = run drain(&mut tree)
  let plain = run first(&events, EventKind.Click)
  run Testing.expect(
    plain.target == fixtures.NEW_BUTTON && plain.detail == 1 && plain.button == BUTTON_PRIMARY,
    "a click on New",
  )
  run Testing.expect(
    count(&events, EventKind.Blur, fixtures.ARCHIVE_BUTTON) == 1
      && count(&events, EventKind.Focus, fixtures.NEW_BUTTON) == 1,
    "and focus moves to it",
  )

  // The disabled button: no down, up or click, and focus leaves.
  run down(&mut tree, 194.0, 27.0)
  run up(&mut tree, 194.0, 27.0)
  events = run drain(&mut tree)
  run Testing.expect(
    countKind(&events, EventKind.PointerDown) == 0 && countKind(&events, EventKind.PointerUp) == 0
      && countKind(&events, EventKind.Click) == 0,
    "a disabled button takes no press",
  )
  run Testing.expect(tree.focused == NONE, "pressing a disabled node blurs")

  // Pointer events off: the button is skipped and the toolbar takes the hit.
  let mut batch = Batch.make()
  run batch.style(fixtures.NEW_BUTTON, &[css.pointerEvents(false)])
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  run Testing.expect(tree.hitTest(30.0, 27.0) == fixtures.TOOLBAR, "pointer-events: none")

  // Leaving the window leaves everything.
  run tree.dispatch(Input.PointerLeave)
  events = run drain(&mut tree)
  run Testing.expect(
    count(&events, EventKind.PointerLeave, fixtures.PANEL) == 1,
    "leaving the window leaves the root",
  )
}

test effect fn pointerHoverPressCaptureAndClick() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pointerBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Window drag regions.

/// A 40px header (2) with `app-region: drag` holds a no-drag button (3, with an `inherit`
/// child 7) and a plain label (4); below it, the body (5) holds a drag handle (6) whose child
/// 8 sets `app-region: drag` and then `initial`.
effect fn region(batch: &mut Batch, id: u32, parent: u32, declarations: &[u8]) -> () ! TreeError | CssError | OutOfMemoryError ? &mut Allocator {
  run batch.create(id, NodeKind.Box)
  if parent == 0 { run batch.root(id) } else { run batch.append(parent, id) }
  let written = run written.declarations(declarations)
  run batch.style(id, written.asSlice())
}

effect fn regionsBody() -> () ! AssertionError<'static> | TreeError | CssError | OutOfMemoryError ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run region(&mut batch, 1, 0, b"display:block;width:300px;height:100px")
  run region(&mut batch, 2, 1, b"display:flex;height:40px;app-region:drag")
  run region(&mut batch, 3, 2, b"display:block;width:50px;height:20px;-webkit-app-region:no-drag")
  run region(&mut batch, 7, 3, b"display:block;width:10px;height:10px;-webkit-app-region:inherit")
  run region(&mut batch, 4, 2, b"display:block;width:100px;height:40px")
  run region(&mut batch, 5, 1, b"display:block;height:60px")
  run region(&mut batch, 6, 5, b"display:block;width:40px;height:40px;app-region:drag")
  run region(&mut batch, 8, 6, b"display:block;width:20px;height:20px;app-region:drag;app-region:initial")
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 300.0, height: 100.0, scale: 1.0, time: 0.0 })
  run Testing.expect(tree.dragsWindow(250.0, 10.0), "the drag header moves the window")
  run Testing.expect(tree.dragsWindow(100.0, 10.0), "so does a child that sets no region")
  run Testing.expect(!tree.dragsWindow(30.0, 15.0), "a no-drag button inside it takes the press")
  run Testing.expect(!tree.dragsWindow(5.0, 5.0), "and so does its inheriting child")
  run Testing.expect(tree.node(tree.slotOf(7)).computed().appRegion == REGION_NO_DRAG, "inherit copies the parent's region")
  run Testing.expect(!tree.dragsWindow(200.0, 70.0), "a press outside any drag region is a click, whatever its height")
  run Testing.expect(tree.dragsWindow(35.0, 75.0), "a drag region below the title bar moves the window")
  run Testing.expect(tree.node(tree.slotOf(8)).computed().appRegion == REGION_NONE, "initial is none")
  run Testing.expect(tree.dragsWindow(5.0, 45.0), "so its press falls to the drag ancestor")
}

test effect fn appRegionDecidesWhichPressesMoveTheWindow() -> ()
  ! AssertionError<'static> | TreeError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run regionsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Keyboard.

effect fn keyboardBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)

  // Nothing focused: keys go to the root, Tab focuses the first button.
  run keyDown(&mut tree, "Tab", 0)
  let mut events = run drain(&mut tree)
  let key = run first(&events, EventKind.KeyDown)
  run Testing.expect(
    key.target == fixtures.PANEL && samePath(&key.path, &[fixtures.PANEL]),
    "keys go to the root when nothing has focus",
  )
  run Testing.expect(count(&events, EventKind.Focus, fixtures.NEW_BUTTON) == 1, "Tab focuses New")
  run keyUp(&mut tree, "Tab", 0)
  run tree.frame(viewport())
  run Testing.expect(
    tree.node(tree.slotOf(fixtures.NEW_BUTTON)).computed().paint.hasShadow,
    "keyboard focus shows the focus-visible ring",
  )
  run tab(&mut tree, false)
  run Testing.expect(tree.focused == tree.slotOf(fixtures.ARCHIVE_BUTTON), "then Archive")
  run tab(&mut tree, false)
  run Testing.expect(
    tree.focused == tree.slotOf(fixtures.ROW),
    "the disabled button is skipped: the first row",
  )
  run tab(&mut tree, true)
  run Testing.expect(tree.focused == tree.slotOf(fixtures.ARCHIVE_BUTTON), "Shift+Tab goes back")
  drop run drain(&mut tree)

  // Enter clicks a button on key down, Space on key up.
  run keyDown(&mut tree, "Enter", 0)
  events = run drain(&mut tree)
  let enter = run first(&events, EventKind.Click)
  run Testing.expect(
    count(&events, EventKind.KeyDown, fixtures.ARCHIVE_BUTTON) == 1
      && enter.target == fixtures.ARCHIVE_BUTTON
      && enter.detail == 0,
    "Enter clicks the focused button",
  )
  run keyUp(&mut tree, "Enter", 0)
  run keyDown(&mut tree, " ", 0)
  events = run drain(&mut tree)
  run Testing.expect(countKind(&events, EventKind.Click) == 0, "Space waits for the key up")
  run keyUp(&mut tree, " ", 0)
  events = run drain(&mut tree)
  run Testing.expect(count(&events, EventKind.Click, fixtures.ARCHIVE_BUTTON) == 1, "and clicks")

  // Tabbing to the last row scrolls the list to show it, and Tab wraps around.
  let mut i: u32 = 0
  while i < fixtures.ROWS {
    run tab(&mut tree, false)
    i = i + 1
  }
  let last = fixtures.ROW + 10 * (fixtures.ROWS - 1)
  run Testing.expect(tree.focused == tree.slotOf(last), "the last row has focus")
  run tree.frame(viewport())
  let list = run boundsOf(&tree, fixtures.INBOX_LIST)
  let row = run boundsOf(&tree, last)
  run Testing.expect(list.scrollY > 0.0, "the list scrolled")
  run Testing.expect(
    near(row.bounds.yMax, list.bounds.yMax - 1.0),
    "the row's bottom meets the list's padding box",
  )
  run tab(&mut tree, false)
  run Testing.expect(tree.focused == tree.slotOf(fixtures.NEW_BUTTON), "Tab wraps around")
}

test effect fn keyboardTabOrderAndKeyboardClicks() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run keyboardBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// A root with five boxes: 2 (tab index 0), 3 (2), 4 (1), and a focus trap 5 holding 6 and 7
/// (both 0).
effect fn trapBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.box(1, 2, &[])
  run batch.box(1, 3, &[])
  run batch.box(1, 4, &[])
  run batch.box(1, 5, &[])
  run batch.box(5, 6, &[])
  run batch.box(5, 7, &[])
  run batch.attribute(2, Attribute.TabIndex { value: 0 })
  run batch.attribute(3, Attribute.TabIndex { value: 2 })
  run batch.attribute(4, Attribute.TabIndex { value: 1 })
  run batch.attribute(6, Attribute.TabIndex { value: 0 })
  run batch.attribute(7, Attribute.TabIndex { value: 0 })
  run batch.attribute(5, Attribute.FocusTrap { value: true })
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let expected: [u32; 6] = [4, 3, 2, 6, 7, 6]
  let mut i: usize = 0
  while i < 6 {
    run tab(&mut tree, false)
    run Testing.expect(
      tree.focused == tree.slotOf(expected[i]),
      "positive tab indices first, then tree order, then held by the trap",
    )
    i = i + 1
  }
  let mut focus = Batch.make()
  run focus.focus(6)
  run tree.apply(run focus.take())
  run tab(&mut tree, false)
  run Testing.expect(tree.focused == tree.slotOf(7), "inside the trap: 7")
  run tab(&mut tree, false)
  run Testing.expect(tree.focused == tree.slotOf(6), "and back to 6, never leaving")
  run tab(&mut tree, true)
  run Testing.expect(tree.focused == tree.slotOf(7), "Shift+Tab cycles too")
}

test effect fn focusTrapsAndPositiveTabIndices() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run trapBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Requests.

/// The target of the one record of `kind` queued since the last drain, 0 when there is not
/// exactly one.
effect fn heardAt(tree: &mut UiTree<'_>, kind: EventKind) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let events = run drain(&mut tree)
  let values = events.asSlice()
  let mut target: u32 = 0
  let mut count: u32 = 0
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == kind {
      target = values[i].target
      count = count + 1
    }
    i = i + 1
  }
  return if count == 1 { target } else { 0 }
}

effect fn requestBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  // Two panes that listen for requests, each with a focusable child, and a third node that
  // nothing above listens for.
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.box(1, 2, &[])
  run batch.box(2, 3, &[])
  run batch.box(1, 4, &[])
  run batch.box(4, 5, &[])
  run batch.box(1, 6, &[])
  run batch.attribute(3, Attribute.TabIndex { value: 0 })
  run batch.attribute(5, Attribute.TabIndex { value: 0 })
  run batch.attribute(6, Attribute.TabIndex { value: 0 })
  run batch.listen(2, LISTEN_REQUEST)
  run batch.listen(4, LISTEN_REQUEST)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  drop run drain(&mut tree)

  run keyDown(&mut tree, "Escape", 0)
  run Testing.expect(
    (run heardAt(&mut tree, EventKind.CloseRequest)) == 4,
    "with nothing focused or pressed, Escape asks the last listener in tree order to close",
  )
  let mut focus = Batch.make()
  run focus.focus(3)
  run tree.apply(run focus.take())
  run keyDown(&mut tree, "Escape", 0)
  run Testing.expect(
    (run heardAt(&mut tree, EventKind.CloseRequest)) == 3,
    "the close request starts at the focused node, so its pane hears it while bubbling",
  )
  run keyDown(&mut tree, "ArrowLeft", MOD_ALT)
  let events = run drain(&mut tree)
  let back = run first(&events, EventKind.Navigate)
  run Testing.expect(back.target == 3 && back.detail == 0, "Alt+Left asks to go back from the focused node")
  run Testing.expect(back.path.length() == 3, "and the record carries the path from the root")
  run keyDown(&mut tree, "ArrowRight", MOD_ALT)
  let forward = run first(&(run drain(&mut tree)), EventKind.Navigate)
  run Testing.expect(forward.detail == 1, "Alt+Right asks to go forward")

  let mut elsewhere = Batch.make()
  run elsewhere.focus(6)
  run tree.apply(run elsewhere.take())
  run keyDown(&mut tree, "Escape", 0)
  run Testing.expect(
    (run heardAt(&mut tree, EventKind.CloseRequest)) == 4,
    "focus where nothing listens falls back to the last listener",
  )
  let mut cover = Batch.make()
  run cover.attribute(4, Attribute.Inert { value: true })
  run tree.apply(run cover.take())
  run keyDown(&mut tree, "Escape", 0)
  run Testing.expect(
    (run heardAt(&mut tree, EventKind.CloseRequest)) == 2,
    "an inert pane is skipped: the request goes to the listener that can act",
  )
  run tree.dispatch(Input.Request { request: Request.Back, target: 5 })
  run Testing.expect(
    (run heardAt(&mut tree, EventKind.Navigate)) == 2,
    "a request named for a node in an inert pane goes to a live one too",
  )
  run tree.dispatch(Input.Request { request: Request.Back, target: REQUEST_ANYWHERE })
  run Testing.expect((run heardAt(&mut tree, EventKind.Navigate)) == 2, "a host's own back request is heard")

  // The back button of a mouse asks on release; a prevented release asks for nothing.
  let release = Input.PointerUp { x: 5.0, y: 5.0, button: BUTTON_BACK, modifiers: 0 }
  run tree.dispatch(move release)
  run Testing.expect((run heardAt(&mut tree, EventKind.Navigate)) == 2, "the mouse back button asks to go back")
  let again = Input.PointerUp { x: 5.0, y: 5.0, button: BUTTON_BACK, modifiers: 0 }
  run tree.begin(&again)
  run tree.finish(move again, true)
  run Testing.expect(tree.takeFollowUp().isNone(), "a prevented release raises no request")

  let escape = Input.KeyDown {
    key: run String.copy("Escape"),
    code: run String.copy("Escape"),
    modifiers: 0,
    repeat: false,
  }
  run tree.begin(&escape)
  run tree.finish(move escape, true)
  run Testing.expect(tree.takeFollowUp().isNone(), "a prevented Escape raises no request")
}

test effect fn escapeAndBackRaiseRequests() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run requestBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Scrolling.

/// Row 1's center is (100, 112) before scrolling; the nested box's (100, 240). The list's
/// padding box ends at y 427.
effect fn scrollBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let row0 = run boundsOf(&tree, fixtures.ROW)
  run Testing.expect(row0.bounds.yMin == 52.0, "row 0 starts at the list's padding box")

  run wheel(&mut tree, 100.0, 112.0, 30.0)
  let mut events = run drain(&mut tree)
  let wheeled = run first(&events, EventKind.Wheel)
  let scrolled = run first(&events, EventKind.Scroll)
  run Testing.expect(
    wheeled.target == fixtures.ROW + 10 && wheeled.deltaY == 30.0,
    "the wheel record goes to the row under the pointer",
  )
  run Testing.expect(
    scrolled.target == fixtures.INBOX_LIST && scrolled.y == 30.0,
    "the list scrolls by the delta",
  )
  run tree.frame(viewport())
  let moved = run boundsOf(&tree, fixtures.ROW)
  run Testing.expect(moved.bounds.yMin == 22.0, "its rows move up")
  events = run drain(&mut tree)
  // As in browsers, hover holds while content scrolls under a still pointer: the rows sliding
  // under it get no enter, leave or hover restyle until the scroll settles.
  run Testing.expect(
    count(&events, EventKind.PointerLeave, fixtures.ROW + 10) == 0
      && count(&events, EventKind.PointerEnter, fixtures.ROW + 20) == 0
      && tree.needsFrame(),
    "hover holds while the content scrolls",
  )
  run wheel(&mut tree, 100.0, 112.0, 10.0)
  events = run drain(&mut tree)
  let held = run first(&events, EventKind.Wheel)
  run Testing.expect(
    held.target == fixtures.ROW + 20 && countKind(&events, EventKind.PointerEnter) == 0
      && countKind(&events, EventKind.PointerLeave) == 0,
    "a wheel at the same point goes to the row now under it, and hover still holds",
  )
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 1.0, time: 0.05 })
  events = run drain(&mut tree)
  run Testing.expect(count(&events, EventKind.PointerEnter, fixtures.ROW + 20) == 0, "and until it has been still a moment")
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 1.0, time: 0.2 })
  events = run drain(&mut tree)
  run Testing.expect(
    count(&events, EventKind.PointerLeave, fixtures.ROW + 10) == 1
      && count(&events, EventKind.PointerEnter, fixtures.ROW + 20) == 1 && !tree.needsFrame(),
    "then hover follows the content under a still pointer",
  )
  run Testing.expect(tree.hitTest(100.0, 112.0) == fixtures.ROW + 20, "and hit testing does")

  // Past the end: clamped to the range. (At x 340 the pointer stays clear of the nested box.)
  run wheel(&mut tree, 340.0, 112.0, 1000.0)
  run tree.frame(viewport())
  let list = run boundsOf(&tree, fixtures.INBOX_LIST)
  let last = run boundsOf(&tree, fixtures.ROW + 10 * (fixtures.ROWS - 1))
  run Testing.expect(
    near(last.bounds.yMax, list.bounds.yMax - 1.0),
    "scrolled to the end, the last row ends at the padding box",
  )
  let end = list.scrollY
  drop run drain(&mut tree)
  run wheel(&mut tree, 340.0, 112.0, 50.0)
  events = run drain(&mut tree)
  run Testing.expect(countKind(&events, EventKind.Scroll) == 0, "at the end nothing scrolls")
  run wheel(&mut tree, 340.0, 112.0, -1000.0)
  run Testing.expect(tree.scrollOffset(fixtures.INBOX_LIST).y == 0.0, "and back to the top")
  run tree.frame(viewport())

  // Nested: the inner box scrolls first; what it cannot take goes to the list.
  run wheel(&mut tree, 100.0, 240.0, 30.0)
  run Testing.expect(
    tree.scrollOffset(fixtures.NESTED).y == 30.0 && tree.scrollOffset(fixtures.INBOX_LIST).y == 0.0,
    "the nested box scrolls first",
  )
  run tree.frame(viewport())
  run wheel(&mut tree, 100.0, 240.0, 30.0)
  let inner = tree.scrollOffset(fixtures.NESTED).y
  let outer = tree.scrollOffset(fixtures.INBOX_LIST).y
  run Testing.expect(inner > 30.0 && inner < 60.0, "the nested box reaches its end")
  run Testing.expect(near(outer, 60.0 - inner), "and the rest scrolls the list")
  run tree.frame(viewport())

  // The pixels match a fresh tree scrolled to the same offsets by mutations.
  run tree.dispatch(Input.PointerLeave)
  let mut snapshot = CpuSnapshot.make()
  run tree.frame(viewport())
  run snapshot.sync(&mut tree)
  let drawn = run snapshot.render(&tree)
  let mut fresh = run inbox(&collection)
  let mut batch = Batch.make()
  run batch.scrollTo(fixtures.NESTED, 0.0, inner)
  run batch.scrollTo(fixtures.INBOX_LIST, 0.0, outer)
  run fresh.apply(run batch.take())
  let mut freshSnapshot = CpuSnapshot.make()
  run fresh.frame(viewport())
  run freshSnapshot.sync(&mut fresh)
  let expected = run freshSnapshot.render(&fresh)
  run Testing.expect(samePixels(&drawn, &expected), "scrolled pixels match a fresh tree")

  // ScrollTo clamps; ScrollIntoView scrolls the least.
  let mut far = Batch.make()
  run far.scrollTo(fixtures.INBOX_LIST, 0.0, 5000.0)
  run fresh.apply(run far.take())
  run fresh.frame(viewport())
  run Testing.expect(near(fresh.scrollOffset(fixtures.INBOX_LIST).y, end), "ScrollTo clamps")
  let mut reveal = Batch.make()
  run reveal.scrollIntoView(fixtures.ROW + 10)
  run fresh.apply(run reveal.take())
  run fresh.frame(viewport())
  let shown = run boundsOf(&fresh, fixtures.ROW + 10)
  run Testing.expect(shown.bounds.yMin == 52.0, "ScrollIntoView brings row 1 to the top edge")

  // scroll-margin keeps room above the revealed row.
  let mut margin = List<Declaration>.make()
  run margin.append(Declaration { property: CssProperty.ScrollMarginTop, value: css.px(10.0), important: false })
  drop run fresh.setOverride(fixtures.ROW + 10, StyleState.Base, move margin, false)
  let mut back = Batch.make()
  run back.scrollTo(fixtures.INBOX_LIST, 0.0, 5000.0)
  run fresh.apply(run back.take())
  run fresh.frame(viewport())
  let mut again = Batch.make()
  run again.scrollIntoView(fixtures.ROW + 10)
  run fresh.apply(run again.take())
  run fresh.frame(viewport())
  let spaced = run boundsOf(&fresh, fixtures.ROW + 10)
  run Testing.expect(spaced.bounds.yMin == 62.0, "scroll-margin-top leaves 10px above the row")

  // overscroll-behavior: contain keeps what the nested box cannot take from the list.
  let mut contained = run inbox(&collection)
  let mut contain = List<Declaration>.make()
  run contain.append(
    Declaration { property: CssProperty.OverscrollBehaviorY, value: Value.Keyword { value: Keyword.Contain }, important: false },
  )
  drop run contained.setOverride(fixtures.NESTED, StyleState.Base, move contain, false)
  run contained.frame(viewport())
  run wheel(&mut contained, 100.0, 240.0, 30.0)
  run contained.frame(viewport())
  run wheel(&mut contained, 100.0, 240.0, 30.0)
  run Testing.expect(
    contained.scrollOffset(fixtures.NESTED).y > 30.0 && contained.scrollOffset(fixtures.INBOX_LIST).y == 0.0,
    "overscroll-behavior: contain stops scroll chaining",
  )
}

effect fn scrollCaptureBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  run tree.frame(viewport())
  // The list no longer listens, the panel above it does: its capture listeners hear the
  // list's scroll, so the record is still queued, at the list.
  let mut quiet = Batch.make()
  run quiet.listen(fixtures.INBOX_LIST, 0)
  run tree.apply(run quiet.take())
  run wheel(&mut tree, 100.0, 112.0, 30.0)
  let above = run drain(&mut tree)
  run Testing.expect(
    count(&above, EventKind.Scroll, fixtures.INBOX_LIST) == 1,
    "a listener above the scroller asks for its scroll record",
  )
  // Nothing on the path listens: no record.
  let mut none = Batch.make()
  run none.listen(fixtures.PANEL, 0)
  run tree.apply(run none.take())
  run wheel(&mut tree, 100.0, 112.0, 30.0)
  let silent = run drain(&mut tree)
  run Testing.expect(countKind(&silent, EventKind.Scroll) == 0, "with no listener on the path there is none")
  // An offset before the start is the start (CSSOM View, "scroll an element": the position
  // is clamped to the scrolling area).
  let mut back = Batch.make()
  run back.scrollTo(fixtures.INBOX_LIST, 0.0, -50.0)
  run tree.apply(run back.take())
  run tree.frame(viewport())
  run Testing.expect(tree.node(tree.slotOf(fixtures.INBOX_LIST)).scrollY() == 0.0, "a negative offset clamps to zero")
}

test effect fn aScrollRecordIsQueuedForListenersAboveTheScroller() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run scrollCaptureBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn wheelScrollsNestedContainersAndClamps() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run scrollBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// The pixels of `tree`'s next frame. `snapshot` is the tree's own: it holds the atlas pixels
/// of the frames before.
effect fn drawnFrame(tree: &mut UiTree<'_>, snapshot: &mut CpuSnapshot) -> Pixmap
  ! TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  run tree.frame(viewport())
  run snapshot.sync(&mut tree)
  return run snapshot.render(&tree)
}

/// The pixels of a fresh inbox whose list is scrolled to `y` before its first frame.
effect fn inboxScrolledTo(collection: &FontCollection, y: f32) -> Pixmap
  ! AssertionError<'static> | TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut fresh = run inbox(collection)
  let mut batch = Batch.make()
  run batch.scrollTo(fixtures.INBOX_LIST, 0.0, y)
  run fresh.apply(run batch.take())
  // Painted from nothing: the reference must not be a kept scene itself.
  fresh.invalidatePaint()
  let mut snapshot = CpuSnapshot.make()
  let pixels = run drawnFrame(&mut fresh, &mut snapshot)
  run Testing.expect(fresh.scrollsKept == 0, "the reference frame is painted")
  return move pixels
}

effect fn scrolledSceneBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut snapshot = CpuSnapshot.make()
  drop run drawnFrame(&mut tree, &mut snapshot)
  let painted = tree.paintsKept

  // A scroll within the paint's lead moves the scene's scroll group and paints nothing.
  let mut near = Batch.make()
  run near.scrollTo(fixtures.INBOX_LIST, 0.0, 30.0)
  run tree.apply(run near.take())
  let moved = run drawnFrame(&mut tree, &mut snapshot)
  run Testing.expect(tree.scrollsKept == 1, "a scroll within the lead keeps the scene")
  run Testing.expect(tree.paintsKept == painted + 1, "and counts as a kept paint")
  run Testing.expect(tree.stats.repaintedSubtrees == 0, "it repaints nothing")
  let expected = run inboxScrolledTo(&collection, 30.0)
  run Testing.expect(samePixels(&moved, &expected), "the kept scene draws the scrolled frame")

  // A second one moves the same scene again, and back.
  let mut more = Batch.make()
  run more.scrollTo(fixtures.INBOX_LIST, 0.0, 44.0)
  run tree.apply(run more.take())
  let again = run drawnFrame(&mut tree, &mut snapshot)
  run Testing.expect(tree.scrollsKept == 2, "a second scroll keeps it too")
  let expectedAgain = run inboxScrolledTo(&collection, 44.0)
  run Testing.expect(samePixels(&again, &expectedAgain), "and draws the new offset")

  // A change after the scroll, with no scroll of its own, paints: what it replays around the
  // change is at the offsets the kept scene moved to, not those of the last paint.
  let mut after = Batch.make()
  run after.setText(fixtures.NEW_BUTTON + 1, "Later")
  run tree.apply(run after.take())
  let later = run drawnFrame(&mut tree, &mut snapshot)
  run Testing.expect(tree.scrollsKept == 2, "a change after a kept scroll paints")
  let repainted = tree.stats.repaintedSubtrees
  let mut freshLater = run inbox(&collection)
  let mut laterChange = Batch.make()
  run laterChange.setText(fixtures.NEW_BUTTON + 1, "Later")
  run laterChange.scrollTo(fixtures.INBOX_LIST, 0.0, 44.0)
  run freshLater.apply(run laterChange.take())
  freshLater.invalidatePaint()
  let mut laterSnapshot = CpuSnapshot.make()
  let expectedLater = run drawnFrame(&mut freshLater, &mut laterSnapshot)
  run Testing.expect(samePixels(&later, &expectedLater), "and draws the offset the scene was moved to")
  // The list did not change: its paint is replayed, as it is with no scroll before.
  let mut still = Batch.make()
  run still.setText(fixtures.NEW_BUTTON + 1, "Again")
  run tree.apply(run still.take())
  drop run drawnFrame(&mut tree, &mut snapshot)
  run Testing.expect(repainted == tree.stats.repaintedSubtrees, "a kept scroll before the change repaints nothing more")
  let mut back = Batch.make()
  run back.setText(fixtures.NEW_BUTTON + 1, "Later")
  run tree.apply(run back.take())
  let same = run drawnFrame(&mut tree, &mut snapshot)
  run Testing.expect(samePixels(&same, &expectedLater), "and the offset holds through later paints")

  // A change with the scroll paints.
  let mut both = Batch.make()
  run both.scrollTo(fixtures.INBOX_LIST, 0.0, 10.0)
  run both.setText(fixtures.ROW + 11, "Changed")
  run tree.apply(run both.take())
  drop run drawnFrame(&mut tree, &mut snapshot)
  run Testing.expect(tree.scrollsKept == 2, "a scroll with another change paints")

  // Past the lead (one viewport height) the content was never painted: the frame paints.
  let mut far = Batch.make()
  run far.scrollTo(fixtures.INBOX_LIST, 0.0, 10.0 + viewport().height + 40.0)
  run tree.apply(run far.take())
  let beyond = run drawnFrame(&mut tree, &mut snapshot)
  let end = tree.scrollOffset(fixtures.INBOX_LIST).y
  if end > 10.0 + viewport().height {
    run Testing.expect(tree.scrollsKept == 2, "a scroll past the lead paints")
  }
  let mut freshFar = run inbox(&collection)
  let mut change = Batch.make()
  run change.setText(fixtures.NEW_BUTTON + 1, "Later")
  run change.setText(fixtures.ROW + 11, "Changed")
  run change.scrollTo(fixtures.INBOX_LIST, 0.0, end)
  run freshFar.apply(run change.take())
  freshFar.invalidatePaint()
  let mut farSnapshot = CpuSnapshot.make()
  let expectedFar = run drawnFrame(&mut freshFar, &mut farSnapshot)
  run Testing.expect(samePixels(&beyond, &expectedFar), "and draws what a fresh tree draws there")
}

test effect fn scrollsWithinThePaintedLeadKeepTheScene() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run scrolledSceneBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// The list's thumb runs down its right edge: x 339 to 345, from y 54.
effect fn thumbBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  run down(&mut tree, 342.0, 100.0)
  run pointerMove(&mut tree, 342.0, 120.0)
  run up(&mut tree, 342.0, 120.0)
  let events = run drain(&mut tree)
  run Testing.expect(
    countKind(&events, EventKind.PointerDown) == 0 && countKind(&events, EventKind.Click) == 0,
    "a thumb drag is not a press",
  )
  let y = tree.scrollOffset(fixtures.INBOX_LIST).y
  run Testing.expect(y > 20.0 && y < 40.0, "dragging the thumb 20 pixels scrolls more than 20")
  run Testing.expect(
    count(&events, EventKind.Scroll, fixtures.INBOX_LIST) == 1,
    "and queues a scroll record",
  )
}

test effect fn draggingAScrollbarThumbScrolls() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run thumbBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Builds a sibling status bar above a fixed-height scroll container with 40 uniquely coloured
/// rows (960px tall total) so kept scrolls can step across a 160px paint lead in two moves.
effect fn longScrollList<'a>(
  collection: &'a FontCollection,
  status: string,
  input: FrameInput,
  y: f32,
) -> UiTree<'a>
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.style(
    1,
    &[
      css.display(Keyword.Flex),
      css.flexDirection(FlexDirection.Column),
      css.width(css.px(240.0)),
      css.height(css.px(160.0)),
      css.backgroundColor(Rgba<f32>.new(0.06, 0.06, 0.08, 1.0)),
    ],
  )
  run batch.root(1)
  run batch.box(1, 2, &[css.height(css.px(24.0)), css.flexShrink(0.0)])
  run batch.text(2, 3, status)
  run batch.box(
    1,
    4,
    &[
      css.height(css.px(120.0)),
      css.flexShrink(0.0),
      css.overflowY(Overflow.Scroll),
      css.backgroundColor(Rgba<f32>.new(0.08, 0.08, 0.11, 1.0)),
    ],
  )
  let mut i: u32 = 0
  while i < 40 {
    let rowId: u32 = 100 + i
    let step: f32 = if i % 2 == 0 { 0.25 } else { 0.55 }
    let r: f32 = 0.15 + 0.02 * u32.toF32(i)
    run batch.box(
      4,
      rowId,
      &[
        css.height(css.px(24.0)),
        css.flexShrink(0.0),
        css.backgroundColor(Rgba<f32>.new(r, step, 0.7, 1.0)),
      ],
    )
    i = i + 1
  }
  run tree.apply(run batch.take())
  run tree.frame(input)
  if y != 0.0 {
    let mut scroll = Batch.make()
    run scroll.scrollTo(4, 0.0, y)
    run tree.apply(run scroll.take())
  }
  return move tree
}

effect fn drawnFrameAt(tree: &mut UiTree<'_>, snapshot: &mut CpuSnapshot, input: FrameInput) -> Pixmap
  ! TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  run tree.frame(input)
  run snapshot.sync(&mut tree)
  return run snapshot.render(&tree)
}

effect fn scrollLeadDriftBody() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let input = FrameInput { width: 240.0, height: 160.0, scale: 1.0, time: 0.0 }
  let mut tree = run longScrollList(&collection, "Ready", input, 0.0)
  let mut snapshot = CpuSnapshot.make()

  // Frame 1 (already painted at y = 0 in `longScrollList`; lead = 160px, rows past y = 280 culled).
  run snapshot.sync(&mut tree)

  // Frame 2: kept scroll to y = 120 (within the 160px lead of y = 0).
  let mut step1 = Batch.make()
  run step1.scrollTo(4, 0.0, 120.0)
  run tree.apply(run step1.take())
  drop run drawnFrameAt(&mut tree, &mut snapshot, input)
  run Testing.expect(tree.scrollsKept == 1, "first scroll within lead keeps the scene")

  // Frame 3: an unrelated sibling changes, so the frame paints and replays the scroll container
  // (still culled around y = 0, not y = 120).
  let mut sibling = Batch.make()
  run sibling.setText(3, "Tick")
  run tree.apply(run sibling.take())
  drop run drawnFrameAt(&mut tree, &mut snapshot, input)
  run Testing.expect(tree.scrollsKept == 1, "sibling change paints")

  // Frame 4: scroll to y = 240 (within 160px of y = 120, but past the 160px lead of y = 0).
  // The list must repaint instead of keeping the stale y = 0 cull.
  let mut step2 = Batch.make()
  run step2.scrollTo(4, 0.0, 240.0)
  run tree.apply(run step2.take())
  let down = run drawnFrameAt(&mut tree, &mut snapshot, input)
  run Testing.expect(tree.scrollsKept == 1, "scrolling past the original painted lead repaints")
  let mut freshDown = run longScrollList(&collection, "Tick", input, 240.0)
  freshDown.invalidatePaint()
  let mut freshDownSnap = CpuSnapshot.make()
  let expectedDown = run drawnFrameAt(&mut freshDown, &mut freshDownSnap, input)
  run Testing.expect(
    samePixels(&down, &expectedDown),
    "scrolling down after a replayed kept scroll repaints past the original lead",
  )

  // Now test the same drift scrolling upward from near the bottom.
  let mut jump = Batch.make()
  run jump.scrollTo(4, 0.0, 600.0)
  run tree.apply(run jump.take())
  drop run drawnFrameAt(&mut tree, &mut snapshot, input)

  // Prime the scroller's paint cache at y = 600 (as a settle or sibling paint does).
  let mut prime = Batch.make()
  run prime.setText(3, "At 600")
  run tree.apply(run prime.take())
  drop run drawnFrameAt(&mut tree, &mut snapshot, input)
  let keptAfterJump = tree.scrollsKept

  let mut up1 = Batch.make()
  run up1.scrollTo(4, 0.0, 480.0)
  run tree.apply(run up1.take())
  drop run drawnFrameAt(&mut tree, &mut snapshot, input)
  run Testing.expect(tree.scrollsKept == keptAfterJump + 1, "first upward scroll keeps the scene")

  // Unrelated paint replays the y = 600 cache; `paintedScrolls` must remain at y = 600.
  let mut sibling2 = Batch.make()
  run sibling2.setText(3, "Tick 2")
  run tree.apply(run sibling2.take())
  drop run drawnFrameAt(&mut tree, &mut snapshot, input)

  let mut up2 = Batch.make()
  run up2.scrollTo(4, 0.0, 360.0)
  run tree.apply(run up2.take())
  let up = run drawnFrameAt(&mut tree, &mut snapshot, input)
  run Testing.expect(
    tree.scrollsKept == keptAfterJump + 1,
    "scrolling up past the original painted lead repaints",
  )
  let mut freshUp = run longScrollList(&collection, "Tick 2", input, 360.0)
  freshUp.invalidatePaint()
  let mut freshUpSnap = CpuSnapshot.make()
  let expectedUp = run drawnFrameAt(&mut freshUp, &mut freshUpSnap, input)
  run Testing.expect(
    samePixels(&up, &expectedUp),
    "scrolling up after a replayed kept scroll repaints past the original lead",
  )
}

test effect fn keptScrollBeforeUnrelatedPaintDoesNotDriftPaintedLead() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run scrollLeadDriftBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn viewportGrowLeadBody() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let small = FrameInput { width: 240.0, height: 160.0, scale: 1.0, time: 0.0 }
  let tall = FrameInput { width: 240.0, height: 400.0, scale: 1.0, time: 0.0 }
  let mut tree = run longScrollList(&collection, "Ready", small, 0.0)
  let mut snapshot = CpuSnapshot.make()

  // Frame 1 (painted at 160px viewport height: lead = 160px, rows past y = 280 culled).
  run snapshot.sync(&mut tree)

  // Frame 2: grow viewport to 400px height. The fixed-height scroll container must not
  // replay its 160px-lead ops under a 400px quietInput lead.
  drop run drawnFrameAt(&mut tree, &mut snapshot, tall)

  // Frame 3: scroll to y = 300 (within 400px lead, past the earlier 160px lead).
  let mut scroll = Batch.make()
  run scroll.scrollTo(4, 0.0, 300.0)
  run tree.apply(run scroll.take())
  let moved = run drawnFrameAt(&mut tree, &mut snapshot, tall)

  let mut fresh = run longScrollList(&collection, "Ready", tall, 300.0)
  fresh.invalidatePaint()
  let mut freshSnap = CpuSnapshot.make()
  let expected = run drawnFrameAt(&mut fresh, &mut freshSnap, tall)
  run Testing.expect(
    samePixels(&moved, &expected),
    "growing the viewport does not let a kept scroll outrun a replayed scroller's painted lead",
  )
}

test effect fn growingViewportDoesNotOutrunReplayedScrollLead() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run viewportGrowLeadBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Same long scroll list as `longScrollList`, except row 1 is `position: relative` (so it is
/// hoisted out of the scroll container into the root stacking context and painted via
/// `paintHoisted` / `paintThrough`).
effect fn longScrollListWithHoisted<'a>(
  collection: &'a FontCollection,
  status: string,
  input: FrameInput,
  y: f32,
) -> UiTree<'a>
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.style(
    1,
    &[
      css.display(Keyword.Flex),
      css.flexDirection(FlexDirection.Column),
      css.width(css.px(240.0)),
      css.height(css.px(160.0)),
      css.backgroundColor(Rgba<f32>.new(0.06, 0.06, 0.08, 1.0)),
    ],
  )
  run batch.root(1)
  run batch.box(1, 2, &[css.height(css.px(24.0)), css.flexShrink(0.0)])
  run batch.text(2, 3, status)
  run batch.box(
    1,
    4,
    &[
      css.height(css.px(120.0)),
      css.flexShrink(0.0),
      css.overflowY(Overflow.Scroll),
      css.backgroundColor(Rgba<f32>.new(0.08, 0.08, 0.11, 1.0)),
    ],
  )
  let mut i: u32 = 0
  while i < 40 {
    let rowId: u32 = 100 + i
    let step: f32 = if i % 2 == 0 { 0.25 } else { 0.55 }
    let r: f32 = 0.15 + 0.02 * u32.toF32(i)
    if i == 1 {
      run batch.box(
        4,
        rowId,
        &[
          css.position(Position.Relative),
          css.height(css.px(24.0)),
          css.flexShrink(0.0),
          css.backgroundColor(Rgba<f32>.new(r, step, 0.7, 1.0)),
        ],
      )
    } else {
      run batch.box(
        4,
        rowId,
        &[
          css.height(css.px(24.0)),
          css.flexShrink(0.0),
          css.backgroundColor(Rgba<f32>.new(r, step, 0.7, 1.0)),
        ],
      )
    }
    i = i + 1
  }
  run tree.apply(run batch.take())
  run tree.frame(input)
  if y != 0.0 {
    let mut scroll = Batch.make()
    run scroll.scrollTo(4, 0.0, y)
    run tree.apply(run scroll.take())
  }
  return move tree
}

effect fn hoistedDriftBody() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let input = FrameInput { width: 240.0, height: 160.0, scale: 1.0, time: 0.0 }
  let mut tree = run longScrollListWithHoisted(&collection, "Ready", input, 0.0)
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)

  // Frame 2: kept scroll to y = 120 (within 160px lead of y = 0).
  let mut step1 = Batch.make()
  run step1.scrollTo(4, 0.0, 120.0)
  run tree.apply(run step1.take())
  drop run drawnFrameAt(&mut tree, &mut snapshot, input)
  run Testing.expect(tree.scrollsKept == 1, "first scroll keeps the scene")

  // Frame 3: unrelated sibling changes; scroller 4 replays at y = 0 while row 101 paints via
  // `paintThrough` / `openScrollerAt(4)`. `openScrollerAt` must not advance `paintedScrolls[4]`
  // to y = 120 while scroller 4's in-flow content is still culled at y = 0.
  let mut sibling = Batch.make()
  run sibling.setText(3, "Tick")
  run tree.apply(run sibling.take())
  drop run drawnFrameAt(&mut tree, &mut snapshot, input)

  // Frame 4: scroll to y = 240 (within 160px of y = 120, past 160px of y = 0).
  let mut step2 = Batch.make()
  run step2.scrollTo(4, 0.0, 240.0)
  run tree.apply(run step2.take())
  let down = run drawnFrameAt(&mut tree, &mut snapshot, input)
  run Testing.expect(
    tree.scrollsKept == 1,
    "hoisted child in replayed scroller does not drift paintedScrolls past the original lead",
  )
  let mut freshDown = run longScrollListWithHoisted(&collection, "Tick", input, 240.0)
  freshDown.invalidatePaint()
  let mut freshDownSnap = CpuSnapshot.make()
  let expectedDown = run drawnFrameAt(&mut freshDown, &mut freshDownSnap, input)
  run Testing.expect(
    samePixels(&down, &expectedDown),
    "in-flow rows past the original lead paint instead of turning blank",
  )
}

test effect fn hoistedChildInScrollerDoesNotDriftPaintedLead() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hoistedDriftBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn replayedScrollerPaintOrderBody() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let input = FrameInput { width: 240.0, height: 160.0, scale: 1.0, time: 0.0 }
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.style(
    1,
    &[
      css.display(Keyword.Flex),
      css.flexDirection(FlexDirection.Column),
      css.width(css.px(240.0)),
      css.height(css.px(160.0)),
    ],
  )
  run batch.root(1)
  run batch.box(1, 2, &[css.height(css.px(24.0)), css.flexShrink(0.0)])
  run batch.text(2, 3, "Status")
  run batch.box(
    1,
    4,
    &[css.height(css.px(120.0)), css.flexShrink(0.0), css.overflowY(Overflow.Scroll)],
  )
  let mut i: u32 = 0
  while i < 20 {
    let rowId: u32 = 100 + i
    if i == 15 {
      // Nested clipped/scrollable row at layout y = 360..384 (below unscrolled 0..120 port).
      run batch.box(
        4,
        rowId,
        &[css.height(css.px(24.0)), css.flexShrink(0.0), css.overflowY(Overflow.Scroll)],
      )
      run batch.box(rowId, 215, &[css.height(css.px(48.0)), css.flexShrink(0.0)])
    } else if i == 16 {
      // Hoisted clipped row at layout y = 384..408.
      run batch.box(
        4,
        rowId,
        &[
          css.position(Position.Relative),
          css.height(css.px(24.0)),
          css.flexShrink(0.0),
          css.overflowY(Overflow.Hidden),
        ],
      )
      run batch.box(rowId, 216, &[css.height(css.px(24.0)), css.flexShrink(0.0)])
    } else {
      run batch.box(4, rowId, &[css.height(css.px(24.0)), css.flexShrink(0.0)])
    }
    i = i + 1
  }
  run tree.apply(run batch.take())
  run tree.frame(input)

  // Scroll to y = 320 so rows 15 and 16 are visible inside the 120px scrollport, then prime
  // scroller 4's paint cache at y = 320.
  let mut scroll = Batch.make()
  run scroll.scrollTo(4, 0.0, 320.0)
  run tree.apply(run scroll.take())
  run tree.frame(input)

  let mut prime = Batch.make()
  run prime.setText(3, "Primed")
  run tree.apply(run prime.take())
  run tree.frame(input)
  let slot215 = u32.toUsize(tree.slotOf(215))
  let slot216 = u32.toUsize(tree.slotOf(216))
  run Testing.expect(tree.paintIndexOf.get(slot215) != NONE, "scrolled nested child has paintOrder after paint")
  run Testing.expect(tree.paintIndexOf.get(slot216) != NONE, "scrolled hoisted child has paintOrder after paint")

  // Unrelated sibling changes: scroller 4 replays via `shiftCaches`.
  let mut tick = Batch.make()
  run tick.setText(3, "Tick")
  run tree.apply(run tick.take())
  run tree.frame(input)
  run Testing.expect(
    tree.paintIndexOf.get(slot215) != NONE,
    "replaying scroller 4 preserves paintOrder of scrolled nested clipped child",
  )
  run Testing.expect(
    tree.paintIndexOf.get(slot216) != NONE,
    "replaying scroller 4 preserves paintOrder of scrolled hoisted clipped child",
  )
}

test effect fn replayedScrollerKeepsPaintOrderOfScrolledNestedClippedChildren() -> ()
  ! AssertionError<'static> | TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run replayedScrollerPaintOrderBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
