//! The libuv loop that `napi_get_uv_event_loop` gives an addon. It is made at the first call and
//! runs as the runtime loop's guest (`fs_async.Guest`): its backend descriptor waits in the
//! runtime's reactor, and each turn runs it without blocking, so addon libuv handles share the
//! runtime's turns as they share Node's one loop. The runtime's core has no libuv loop (the loop
//! plan, docs/composable-runtime.md). This package has libuv's C API, written in Silk (ext.uv_loop,
//! ext.uv_api_*), for addons.
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silkjsruntime.ext.fs_async as loops
import ext.uv_loop as uvl

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
const RUN_DEFAULT: i32 = 0
const RUN_NOWAIT: i32 = 2
const ASYNC: i32 = 1

// `anchor` is an unreferenced async handle whose reference a turn borrows: libuv reports a 0
// timeout, and UV_RUN_NOWAIT skips its poll, while nothing holds a reference, though the runtime
// (its JavaScript timers) keeps the turns going.
struct Guest { loop: *mut u8, anchor: *mut u8 }

unsafe fn nn<T>(pointer: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(pointer) }
unsafe fn guestOf(context: *mut u8) -> *mut Guest { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Guest>(context) }

export "C" fn silkNapiLoopAnchor(handle: *mut u8) -> () {}
export "C" fn silkNapiLoopAnchorClosed(handle: *mut u8) -> () { unsafe free(handle) }

// Runs `body` on the loop with the anchor's reference borrowed when nothing else holds one.
export "C" fn silkNapiLoopTimeout(context: *mut u8) -> i32 {
  let anchor = () let guest = unsafe Pointer.borrow<(), Guest>(&anchor, unsafe guestOf(context))
  let borrowed = unsafe uvl.uv_has_ref(guest.anchor) == 0
  if borrowed { unsafe uvl.uv_ref(guest.anchor) }
  let timeout = unsafe uvl.uv_backend_timeout(guest.loop)
  if borrowed { unsafe uvl.uv_unref(guest.anchor) }
  return timeout
}
export "C" fn silkNapiLoopPoll(context: *mut u8) -> () {
  let anchor = () let guest = unsafe Pointer.borrow<(), Guest>(&anchor, unsafe guestOf(context))
  let loop = guest.loop let handle = guest.anchor drop guest
  let borrowed = unsafe uvl.uv_has_ref(handle) == 0
  if borrowed { unsafe uvl.uv_ref(handle) }
  let _ignored = unsafe uvl.uv_run(loop, RUN_NOWAIT)
  if borrowed { unsafe uvl.uv_unref(handle) }
}
export "C" fn silkNapiLoopAlive(context: *mut u8) -> i32 {
  let anchor = () let guest = unsafe Pointer.borrow<(), Guest>(&anchor, unsafe guestOf(context))
  return unsafe uvl.uv_loop_alive(guest.loop)
}
// After the runtime's last turn: the anchor closes, the loop drains its close callbacks, and closes.
export "C" fn silkNapiLoopClose(context: *mut u8) -> () {
  let pointer = unsafe guestOf(context)
  let guest = unsafe Pointer.take<Guest>(pointer)
  unsafe uvl.uv_close(guest.anchor, silkNapiLoopAnchorClosed)
  let _drained = unsafe uvl.uv_run(guest.loop, RUN_DEFAULT)
  let _closed = unsafe uvl.uv_loop_close(guest.loop)
  unsafe free(guest.loop) unsafe free(context)
}

/// The libuv loop of the runtime whose loop is `io`, made and attached at the first call; null when
/// it cannot be made.
pub unsafe fn loopOf(io: *mut loops.State) -> ?*mut u8 {
  let existing = unsafe loops.guestContext(io)
  if !Pointer.isNull<u8>(existing) {
    let anchor = () let guest = unsafe Pointer.borrow<(), Guest>(&anchor, unsafe guestOf(unsafe nn(existing)))
    return guest.loop
  }
  let context = unsafe calloc(1, Layout.of<Guest>().bytes)
  let loop = unsafe calloc(1, unsafe uvl.uv_loop_size())
  let handle = unsafe calloc(1, unsafe uvl.uv_handle_size(ASYNC))
  if Pointer.isNull<u8>(context) || Pointer.isNull<u8>(loop) || Pointer.isNull<u8>(handle) { unsafe free(context) unsafe free(loop) unsafe free(handle) return Pointer.null<u8>() }
  if unsafe uvl.uv_loop_init(unsafe nn(loop)) != 0 { unsafe free(context) unsafe free(loop) unsafe free(handle) return Pointer.null<u8>() }
  if unsafe uvl.uv_async_init(unsafe nn(loop), unsafe nn(handle), silkNapiLoopAnchor) != 0 { Intrinsic.trap("libuv cannot initialize the addon loop's anchor") }
  unsafe uvl.uv_unref(unsafe nn(handle))
  unsafe Pointer.put<Guest>(unsafe guestOf(unsafe nn(context)), Guest { loop: unsafe nn(loop), anchor: unsafe nn(handle) })
  let attached = unsafe loops.attachGuest(io, loops.Guest { context: unsafe nn(context), descriptor: unsafe uvl.uv_backend_fd(unsafe nn(loop)), timeout: silkNapiLoopTimeout, poll: silkNapiLoopPoll, alive: silkNapiLoopAlive, close: silkNapiLoopClose })
  if attached != 0 { unsafe silkNapiLoopClose(unsafe nn(context)) return Pointer.null<u8>() }
  return loop
}

// Generated by tools/keep_exports.py; do not edit below.
/// Takes each C export as a value, so that Silk emits it (see tools/keep_exports.py).
pub fn keepExports() -> () {
  let _silkNapiLoopAnchor: extern "C" fn(*mut u8) -> () = silkNapiLoopAnchor
  let _silkNapiLoopAnchorClosed: extern "C" fn(*mut u8) -> () = silkNapiLoopAnchorClosed
  let _silkNapiLoopTimeout: extern "C" fn(*mut u8) -> i32 = silkNapiLoopTimeout
  let _silkNapiLoopPoll: extern "C" fn(*mut u8) -> () = silkNapiLoopPoll
  let _silkNapiLoopAlive: extern "C" fn(*mut u8) -> i32 = silkNapiLoopAlive
  let _silkNapiLoopClose: extern "C" fn(*mut u8) -> () = silkNapiLoopClose
}
