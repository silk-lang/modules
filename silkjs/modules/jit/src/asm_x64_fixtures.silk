  run a.aluStoreImm(Alu.Cmp, Width.W64, Mem.at(Reg.R13, -2147483648), 1)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x83\xbd\x00\x00\x00\x80\x01"), "cmp qword ptr [r13 - 2147483648], 1")
  run a.aluLoad(Alu.Cmp, Width.W64, Reg.Rsp, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x3b\x64\xad\x00"), "cmp rsp, qword ptr [rbp + rbp*4]")
  run a.aluStore(Alu.Cmp, Width.W64, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x39\x64\xad\x00"), "cmp qword ptr [rbp + rbp*4], rsp")
  run a.aluStoreImm(Alu.Cmp, Width.W64, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), -1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\x7c\xad\x00\xff"), "cmp qword ptr [rbp + rbp*4], -1")
  run a.aluLoad(Alu.Cmp, Width.W64, Reg.R13, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4e\x3b\x2c\x7f"), "cmp r13, qword ptr [rdi + r15*2]")
  run a.aluStore(Alu.Cmp, Width.W64, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x4e\x39\x2c\x7f"), "cmp qword ptr [rdi + r15*2], r13")
  run a.aluStoreImm(Alu.Cmp, Width.W64, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), 127)
  run Testing.expect(emitted(&a, &mut at, b"\x4a\x83\x3c\x7f\x7f"), "cmp qword ptr [rdi + r15*2], 127")
  run a.aluLoad(Alu.Cmp, Width.W32, Reg.Rdi, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x3b\x38"), "cmp edi, dword ptr [rax]")
  run a.aluStore(Alu.Cmp, Width.W32, Mem.at(Reg.Rax, 0), Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x39\x38"), "cmp dword ptr [rax], edi")
  run a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.Rax, 0), 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x81\x38\x78\x56\x34\x12"), "cmp dword ptr [rax], 305419896")
  run a.aluLoad(Alu.Cmp, Width.W32, Reg.Rax, Mem.at(Reg.R8, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x41\x3b\x40\x08"), "cmp eax, dword ptr [r8 + 8]")
  run a.aluStore(Alu.Cmp, Width.W32, Mem.at(Reg.R8, 8), Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x39\x40\x08"), "cmp dword ptr [r8 + 8], eax")
  run a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.R8, 8), 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x81\x78\x08\xff\xff\xff\x7f"), "cmp dword ptr [r8 + 8], 2147483647")
  run a.aluLoad(Alu.Cmp, Width.W32, Reg.R9, Mem.at(Reg.Rax, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x3b\x48\x7f"), "cmp r9d, dword ptr [rax + 127]")
  run a.aluStore(Alu.Cmp, Width.W32, Mem.at(Reg.Rax, 127), Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x39\x48\x7f"), "cmp dword ptr [rax + 127], r9d")
  run a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.Rax, 127), -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x81\x78\x7f\x00\x00\x00\x80"), "cmp dword ptr [rax + 127], -2147483648")
  run a.aluLoad(Alu.Cmp, Width.W32, Reg.Rdx, Mem.at(Reg.Rbp, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x3b\x55\x7f"), "cmp edx, dword ptr [rbp + 127]")
  run a.aluStore(Alu.Cmp, Width.W32, Mem.at(Reg.Rbp, 127), Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x39\x55\x7f"), "cmp dword ptr [rbp + 127], edx")
  run a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.Rbp, 127), 0)
  run Testing.expect(emitted(&a, &mut at, b"\x83\x7d\x7f\x00"), "cmp dword ptr [rbp + 127], 0")
  run a.aluLoad(Alu.Cmp, Width.W32, Reg.R11, Mem.at(Reg.R13, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\x45\x3b\x9d\x00\x00\x00\x80"), "cmp r11d, dword ptr [r13 - 2147483648]")
  run a.aluStore(Alu.Cmp, Width.W32, Mem.at(Reg.R13, -2147483648), Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x39\x9d\x00\x00\x00\x80"), "cmp dword ptr [r13 - 2147483648], r11d")
  run a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.R13, -2147483648), 1)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x83\xbd\x00\x00\x00\x80\x01"), "cmp dword ptr [r13 - 2147483648], 1")
  run a.aluLoad(Alu.Cmp, Width.W32, Reg.Rsp, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x3b\x64\xad\x00"), "cmp esp, dword ptr [rbp + rbp*4]")
  run a.aluStore(Alu.Cmp, Width.W32, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x39\x64\xad\x00"), "cmp dword ptr [rbp + rbp*4], esp")
  run a.aluStoreImm(Alu.Cmp, Width.W32, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), -1)
  run Testing.expect(emitted(&a, &mut at, b"\x83\x7c\xad\x00\xff"), "cmp dword ptr [rbp + rbp*4], -1")
  run a.aluLoad(Alu.Cmp, Width.W32, Reg.R13, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x46\x3b\x2c\x7f"), "cmp r13d, dword ptr [rdi + r15*2]")
  run a.aluStore(Alu.Cmp, Width.W32, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x46\x39\x2c\x7f"), "cmp dword ptr [rdi + r15*2], r13d")
  run a.aluStoreImm(Alu.Cmp, Width.W32, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), 127)
  run Testing.expect(emitted(&a, &mut at, b"\x42\x83\x3c\x7f\x7f"), "cmp dword ptr [rdi + r15*2], 127")
}

test effect fn aluMemoryMatchLlvm() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut a = Assembler.make()
  run aluMemoryCases(&mut a) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn arithmeticCases(a: &mut Assembler) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut at: usize = 0
  run a.test(Width.W64, Reg.Rax, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x85\xc8"), "test rax, rcx")
  run a.imul(Width.W64, Reg.Rax, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x0f\xaf\xc1"), "imul rax, rcx")
  run a.test(Width.W64, Reg.Rbx, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x85\xcb"), "test rbx, r9")
  run a.imul(Width.W64, Reg.Rbx, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x0f\xaf\xd9"), "imul rbx, r9")
  run a.test(Width.W64, Reg.Rsp, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x85\xfc"), "test rsp, rdi")
  run a.imul(Width.W64, Reg.Rsp, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x0f\xaf\xe7"), "imul rsp, rdi")
  run a.test(Width.W64, Reg.Rbp, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x85\xf5"), "test rbp, r14")
  run a.imul(Width.W64, Reg.Rbp, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x0f\xaf\xee"), "imul rbp, r14")
  run a.test(Width.W64, Reg.Rsi, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x85\xce"), "test rsi, rcx")
  run a.imul(Width.W64, Reg.Rsi, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x0f\xaf\xf1"), "imul rsi, rcx")
  run a.test(Width.W64, Reg.R8, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x85\xc8"), "test r8, r9")
  run a.imul(Width.W64, Reg.R8, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x0f\xaf\xc1"), "imul r8, r9")
  run a.test(Width.W64, Reg.R12, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x85\xfc"), "test r12, rdi")
  run a.imul(Width.W64, Reg.R12, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x0f\xaf\xe7"), "imul r12, rdi")
  run a.test(Width.W64, Reg.R13, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x85\xf5"), "test r13, r14")
  run a.imul(Width.W64, Reg.R13, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x0f\xaf\xee"), "imul r13, r14")
  run a.test(Width.W64, Reg.R15, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x85\xcf"), "test r15, rcx")
  run a.imul(Width.W64, Reg.R15, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x0f\xaf\xf9"), "imul r15, rcx")
  run a.imulImm(Width.W64, Reg.Rax, Reg.Rcx, 0)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x6b\xc1\x00"), "imul rax, rcx, 0")
  run a.imulImm(Width.W64, Reg.Rbx, Reg.R9, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x6b\xd9\x01"), "imul rbx, r9, 1")
  run a.imulImm(Width.W64, Reg.Rsp, Reg.Rdi, -1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x6b\xe7\xff"), "imul rsp, rdi, -1")
  run a.imulImm(Width.W64, Reg.Rbp, Reg.R14, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x6b\xee\x7f"), "imul rbp, r14, 127")
  run a.imulImm(Width.W64, Reg.Rsi, Reg.Rcx, 128)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x69\xf1\x80\x00\x00\x00"), "imul rsi, rcx, 128")
  run a.imulImm(Width.W64, Reg.R8, Reg.R9, -128)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x6b\xc1\x80"), "imul r8, r9, -128")
  run a.imulImm(Width.W64, Reg.R12, Reg.Rdi, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x69\xe7\x7f\xff\xff\xff"), "imul r12, rdi, -129")
  run a.imulImm(Width.W64, Reg.R13, Reg.R14, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x69\xee\x78\x56\x34\x12"), "imul r13, r14, 305419896")
  run a.imulImm(Width.W64, Reg.R15, Reg.Rcx, 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x69\xf9\xff\xff\xff\x7f"), "imul r15, rcx, 2147483647")
  run a.imulImm(Width.W64, Reg.Rax, Reg.R9, -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x69\xc1\x00\x00\x00\x80"), "imul rax, r9, -2147483648")
  run a.testImm(Width.W64, Reg.Rax, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xa9\x01\x00\x00\x00"), "test rax, 1")
  run a.testImm(Width.W64, Reg.Rcx, -1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xc1\xff\xff\xff\xff"), "test rcx, -1")
  run a.testImm(Width.W64, Reg.Rbp, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xc5\x78\x56\x34\x12"), "test rbp, 305419896")
  run a.testImm(Width.W64, Reg.R8, -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xc0\x00\x00\x00\x80"), "test r8, -2147483648")
  run a.testImm(Width.W64, Reg.R13, 255)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xc5\xff\x00\x00\x00"), "test r13, 255")
  run a.unary(Unary.Not, Width.W64, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xd0"), "not rax")
  run a.unary(Unary.Not, Width.W64, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xd1"), "not rcx")
  run a.unary(Unary.Not, Width.W64, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xd5"), "not rbp")
  run a.unary(Unary.Not, Width.W64, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xd0"), "not r8")
  run a.unary(Unary.Not, Width.W64, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xd5"), "not r13")
  run a.unary(Unary.Neg, Width.W64, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xd8"), "neg rax")
  run a.unary(Unary.Neg, Width.W64, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xd9"), "neg rcx")
  run a.unary(Unary.Neg, Width.W64, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xdd"), "neg rbp")
  run a.unary(Unary.Neg, Width.W64, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xd8"), "neg r8")
  run a.unary(Unary.Neg, Width.W64, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xdd"), "neg r13")
  run a.unary(Unary.Mul, Width.W64, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xe0"), "mul rax")
  run a.unary(Unary.Mul, Width.W64, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xe1"), "mul rcx")
  run a.unary(Unary.Mul, Width.W64, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xe5"), "mul rbp")
  run a.unary(Unary.Mul, Width.W64, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xe0"), "mul r8")
  run a.unary(Unary.Mul, Width.W64, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xe5"), "mul r13")
  run a.unary(Unary.Imul, Width.W64, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xe8"), "imul rax")
  run a.unary(Unary.Imul, Width.W64, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xe9"), "imul rcx")
  run a.unary(Unary.Imul, Width.W64, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xed"), "imul rbp")
  run a.unary(Unary.Imul, Width.W64, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xe8"), "imul r8")
  run a.unary(Unary.Imul, Width.W64, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xed"), "imul r13")
  run a.unary(Unary.Div, Width.W64, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xf0"), "div rax")
  run a.unary(Unary.Div, Width.W64, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xf1"), "div rcx")
  run a.unary(Unary.Div, Width.W64, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xf5"), "div rbp")
  run a.unary(Unary.Div, Width.W64, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xf0"), "div r8")
  run a.unary(Unary.Div, Width.W64, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xf5"), "div r13")
  run a.unary(Unary.Idiv, Width.W64, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xf8"), "idiv rax")
  run a.unary(Unary.Idiv, Width.W64, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xf9"), "idiv rcx")
  run a.unary(Unary.Idiv, Width.W64, Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xf7\xfd"), "idiv rbp")
  run a.unary(Unary.Idiv, Width.W64, Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xf8"), "idiv r8")
  run a.unary(Unary.Idiv, Width.W64, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xf7\xfd"), "idiv r13")
  run a.shiftImm(Shift.Rol, Width.W64, Reg.Rax, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xd1\xc0"), "rol rax, 1")
  run a.shiftImm(Shift.Rol, Width.W64, Reg.Rbx, 2)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc1\xc3\x02"), "rol rbx, 2")
  run a.shiftImm(Shift.Rol, Width.W64, Reg.Rbp, 31)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc1\xc5\x1f"), "rol rbp, 31")
  run a.shiftImm(Shift.Rol, Width.W64, Reg.R9, 63)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc1\xc1\x3f"), "rol r9, 63")
  run a.shiftImm(Shift.Rol, Width.W64, Reg.R12, 7)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc1\xc4\x07"), "rol r12, 7")
  run a.shiftCl(Shift.Rol, Width.W64, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xd3\xc0"), "rol rax, cl")
  run a.shiftCl(Shift.Rol, Width.W64, Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xd3\xc2"), "rol rdx, cl")
  run a.shiftCl(Shift.Rol, Width.W64, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xd3\xc5"), "rol r13, cl")
  run a.shiftImm(Shift.Ror, Width.W64, Reg.Rax, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xd1\xc8"), "ror rax, 1")
  run a.shiftImm(Shift.Ror, Width.W64, Reg.Rbx, 2)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc1\xcb\x02"), "ror rbx, 2")
  run a.shiftImm(Shift.Ror, Width.W64, Reg.Rbp, 31)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc1\xcd\x1f"), "ror rbp, 31")
  run a.shiftImm(Shift.Ror, Width.W64, Reg.R9, 63)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc1\xc9\x3f"), "ror r9, 63")
  run a.shiftImm(Shift.Ror, Width.W64, Reg.R12, 7)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc1\xcc\x07"), "ror r12, 7")
  run a.shiftCl(Shift.Ror, Width.W64, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xd3\xc8"), "ror rax, cl")
  run a.shiftCl(Shift.Ror, Width.W64, Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xd3\xca"), "ror rdx, cl")
  run a.shiftCl(Shift.Ror, Width.W64, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xd3\xcd"), "ror r13, cl")
  run a.shiftImm(Shift.Shl, Width.W64, Reg.Rax, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xd1\xe0"), "shl rax, 1")
  run a.shiftImm(Shift.Shl, Width.W64, Reg.Rbx, 2)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc1\xe3\x02"), "shl rbx, 2")
  run a.shiftImm(Shift.Shl, Width.W64, Reg.Rbp, 31)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc1\xe5\x1f"), "shl rbp, 31")
  run a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 63)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc1\xe1\x3f"), "shl r9, 63")
  run a.shiftImm(Shift.Shl, Width.W64, Reg.R12, 7)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc1\xe4\x07"), "shl r12, 7")
  run a.shiftCl(Shift.Shl, Width.W64, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xd3\xe0"), "shl rax, cl")
