//! What a tree asks of its host.
import silk.text.string { String }

/// Something the tree asks of its host, which owns the clipboard and loads files. Drain them
/// with `UiTree.takeRequests` after dispatching input and after each frame.
pub union HostRequest {
  /// Put `text` on the clipboard (copy and cut).
  WriteClipboard { pub text: String },
  /// Put a copy on the clipboard in two flavors: `text` as `text/plain`, and `html` as
  /// `text/html` unless it is empty.
  WriteClipboardItem { pub text: String, pub html: String },
  /// Open the edit context menu of an input at (`x`, `y`), CSS pixels of the viewport, after
  /// a secondary press no listener prevented. `cut`, `copy` and `paste` say which items are
  /// enabled; Select All always is. Answer a chosen item with `Input.Command`.
  ShowEditMenu { pub x: f32, pub y: f32, pub cut: bool, pub copy: bool, pub paste: bool },
  /// Read the clipboard and answer with `Input.Paste` for `target` (paste).
  ReadClipboard { pub target: u32 },
  /// Load the file of declared font face `face`: text laid out needs a character its
  /// `unicode-range` covers. Answer with `UiTree.loadFontFace`, or `UiTree.failFontFace` when
  /// it cannot load; the text draws with a fallback until then.
  LoadFontFace { pub face: u32 },
}
