//! The environment compiled code receives as its fifth argument (CompiledEntry.env), and the
//! numbering of the runtime helpers it calls.
//!
//! Compiled code names a helper by its index into `CompiledEnv.helpers`, never by address, so
//! the code bytes hold no process-local pointer (ahead-of-time compilation). The JIT fills the
//! table once per runtime. Indices are partitioned by workstream so they can be added without
//! colliding: J (objects) 0-31, H (calls) 32-63, I (loops) 64-95, K (numbers) 96-127.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.num.f64
import silk.num.i32
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silkjs.thin_list { ThinList, BoxList }
import silkjs.js_heap { HeapCell, HeapHeader, HeapKind }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { ObjectData, ObjectPayload, BytecodeClosure, FunctionBytecode, FastArrayData, BuiltinFamily, NativeFunctionId, NativeFunctionData, NativeCallProtocol, RuntimeState, ReceiverCacheEntry, InstanceCacheEntry, VarRef, VarRefState, ShapeData, SlotBits, GcPhase }
import silkjs.js_core_types as census
import silkjs.js_class_data as classes
import silkjs.js_gc as gc
import silkjs.js_shapes as shapes
import silkjs.js_interrupts as interrupts
import silkjs.js_compiled { CompiledFrame }
import silkjs.js_compiled_objects as objects
import silkjs.js_compiled_math as mathematics
import silkjs.js_vm as vm
import silkjs.js_compiled as compiled
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import jit_exit_state { jitExitState }
import silkjs.js_primitives as primitives

pub const HELPER_COUNT: usize = 128

// ---- J: 0-31 ----
/// release(env, value: *const ValueBits): drops the count the value owns (gc.releaseDeferred).
pub const RELEASE: u32 = 0
/// get_field(env, frame, site, object: *const ValueBits, out: *mut ValueBits) -> u32: the
/// named property read of the instruction at bytecode offset `site & 0x7fffffff` of
/// frame.bytecode through the interpreter's own caches (bit 31 set: the site cache of
/// get_field2, else the inline key of get_field and its fused forms). 1 with the value owned
/// in out; 0 when that path cannot answer (out untouched), and the code deoptimizes.
pub const GET_FIELD: u32 = 1
/// put_field(env, frame, site, object, value) stores an own writable data property.
/// The low 32 bits of site are the bytecode offset. Returns 1 when the object holds
/// a count of value, else 0 or 2 for interpreter fallback while the original slot is intact:
/// 2 when only a full slot list kept an ordinary add from going in place
/// (js_compiled_objects.WRITE_NEEDS_ROOM), which the code may have the interpreter step.
pub const PUT_FIELD: u32 = 2
/// Bit 32 of PUT_FIELD's site word. The compiler sets it when no live borrowed field
/// relies on the displaced value, so the helper may release its last reference.
pub const PUT_FIELD_RELEASE_LAST: u64 = 0x100000000
/// atom_value(env, frame, site, out: *mut ValueBits) -> u32: the string of the push_atom_value
/// at bytecode offset `site & 0x7fffffff` (bit 31 set: push_empty_string's ""), owned in out;
/// 0 for an integer atom.
pub const ATOM_VALUE: u32 = 3
/// get_var(env, frame, index, out: *mut ValueBits) -> u32: closure variable `index` (a global
/// for get_var), owned in out; 0 when uninitialized.
pub const GET_VAR: u32 = 4
/// put_var(env, frame, index, value: *const ValueBits) -> u32: stores into closure variable
/// `index`, which takes its own count; 0 with nothing changed for a const or uninitialized one.
pub const PUT_VAR: u32 = 5
/// get_scope(env, frame, site, out: *mut ValueBits) -> u32: slot `site & 0xffff` of the
/// function's own scope, owned in out; with bit 31 (a checked read) 0 when uninitialized.
pub const GET_SCOPE: u32 = 6
/// put_scope(env, frame, site, value: *const ValueBits) -> u32: stores into that slot, which
/// takes its own count; with bit 31, 0 with nothing changed when uninitialized.
pub const PUT_SCOPE: u32 = 7
/// get_elem(env, object: *const ValueBits, index: i32, out: *mut ValueBits) -> u32: element
/// `index` of a fast Array, typed array or fast arguments object, owned in out; else 0.
pub const GET_ELEM: u32 = 8
/// put_elem(env, object: *const ValueBits, index: i32, value: *const ValueBits) -> u32: stores
/// over an existing element of a fast Array, which takes its own count; else 0, nothing changed.
pub const PUT_ELEM: u32 = 9
/// get_length(env, object: *const ValueBits, out: *mut ValueBits) -> u32: a string's or an
/// Array's length into out; else 0.
pub const GET_LENGTH: u32 = 10
/// truthy(env, value: *const ValueBits) -> u32: ToBoolean of the value, 1 or 0.
pub const TRUTHY: u32 = 11
/// typeof(env, frame, value: *const ValueBits) -> u32: the atom typeof answers; 0 for a proxy.
pub const TYPEOF: u32 = 12
/// instanceof(env, frame, left, right) -> 0 or 1 (js_vm_object_ops.quickInstanceOf), 2 when
/// the full operator must answer.
pub const INSTANCEOF: u32 = 13
/// equals(env, left, right, strict) -> 0 or 1 (js_compiled_objects.equals), 2 when the full
/// operator must answer.
pub const EQUALS: u32 = 14
/// array_push(env, object: *const ValueBits, value: *const ValueBits, out: *mut ValueBits) ->
/// u32: push(value) on a fast Array with room for it, 1 with the new length in out (the
/// array takes a count of value); else 0, nothing changed (js_compiled_objects.arrayPush).
pub const ARRAY_PUSH: u32 = 15
/// array_pop(env, object: *const ValueBits, out: *mut ValueBits) -> u32: pop() on a fast
/// Array, 1 with the removed value owned in out; else 0, nothing changed.
pub const ARRAY_POP: u32 = 16
/// new_object(env, desc: *mut ConstructDesc, out: *mut ValueBits) -> u32: validates a
/// planned constructor descriptor and allocates a fresh inline object from a spare cell
/// with `desc.stores` uninitialized slots ready for Op.InitSlot; returns 1 on hit else 0.
pub const NEW_OBJECT: u32 = 17
/// check_construct(env, desc: *mut ConstructDesc) -> u32: validates a planned constructor
/// descriptor without allocating (escape-eliminated construct); returns 1 on hit, 2 on
/// interrupt poll due, 0 on guard miss.
pub const CHECK_CONSTRUCT: u32 = 18
/// typeof_str(env, frame, value: *const ValueBits, out: *mut ValueBits) -> u32: the string
/// typeof answers for value, owned in out; 0 for a proxy (out untouched).
pub const TYPEOF_STR: u32 = 19

/// Runtime validation descriptor for an inlined `new C(...)` site (Op.NewObject).
/// `ctor` MUST stay at offset 0: generated machine code loads `[desc + 0]` to guard the
/// callee and `new.target` pointers before calling `jitNewObject`.
pub struct ConstructDesc {
  pub ctor: ?*mut HeapHeader,
  pub proto: ?*mut HeapHeader,
  pub target: ?*mut HeapHeader,
  pub fnProto: ?*mut HeapHeader,
  pub applyFn: ?*mut HeapHeader,
  pub realm: ?*mut HeapHeader,
  pub finalShapePtr: ?*mut HeapHeader,
  pub ctorVersion: u64,
  pub targetVersion: u64,
  pub fnProtoVersion: u64,
  pub shapeEpoch: u64,
  pub finalShape: usize,
  pub emptyShape: usize,
  pub protoSlot: usize,
  pub holderSlot: usize,
  pub applySlot: usize,
  pub receiverSlot: usize,
  pub stores: usize,
  pub tail: usize,
  pub protoObjs: [?*mut HeapHeader; 4],
  pub protoVersions: [u64; 4],
  pub addAtoms: [u32; 8],
  pub protoCount: u8,
  pub forward: u8,
  pub fromEmpty: u8,
  pub checkInterrupt: u8,
  pub guardVarCell: ?*mut HeapHeader,
  pub guardVarExpect: ?*mut HeapHeader,
  pub guardHopObjs: [?*mut HeapHeader; 2],
  pub guardHopExpect: [?*mut HeapHeader; 2],
  pub guardHopVersions: [u64; 2],
  pub guardHopSlots: [usize; 2],
  pub guardHopCount: u8,
  pub nestedKind: u8,
  pub nestedInitCount: u8,
  pub nestedDescIdx: u32,
  pub nestedDesc: ?*mut u8,
  pub nestedArrayShape: ?*mut HeapHeader,
  pub nestedInitVals: [ValueBits; 8]
}
impl Copy for ConstructDesc {}

/// Byte offsets of ConstructDesc and RuntimeState receiver-cache fields, probed over a dummy
/// cell so x64_backend can inline Op.CheckConstruct without hardcoded struct offsets.
pub struct ConstructLayout {
  pub descCtor: u32,
  pub descProto: u32,
  pub descTarget: u32,
  pub descFnProto: u32,
  pub descApplyFn: u32,
  pub descRealm: u32,
  pub descFinalShapePtr: u32,
  pub descCtorVersion: u32,
  pub descTargetVersion: u32,
  pub descFnProtoVersion: u32,
  pub descShapeEpoch: u32,
  pub descFinalShape: u32,
  pub descEmptyShape: u32,
  pub descReceiverSlot: u32,
  pub descProtoSlot: u32,
  pub descHolderSlot: u32,
  pub descApplySlot: u32,
  pub descStores: u32,
  pub descTail: u32,
  pub descForward: u32,
  pub descFromEmpty: u32,
  pub descCheckInterrupt: u32,
  pub descNestedKind: u32,
  pub rtObserveFresh: u32,
  pub rtReceiverFunctions: u32,
  pub rtReceiverCache: u32,
  pub rcEntryStride: u32,
  pub rcEntryEmpty: u32,
  pub rcEntryFinal: u32,
  pub rtInstanceCache: u32,
  pub icEntryStride: u32,
  pub icEntryVersion: u32,
  pub icEntryIndex: u32,
  pub bytecodeFnClass: u32,
  pub cFnClass: u32,
  pub objectClass: u32,
  pub varRefIsConst: u32
}
impl Copy for ConstructLayout {}

/// Computes ConstructLayout by taking field addresses over a dummy cell (nothing is read or written).
pub fn constructLayout() -> ConstructLayout {
  let mut cell: [u64; 256] = [0; 256]
  let header = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut HeapHeader>(Pointer.fromMutRef<u64>(&mut cell[0]))
  let base = Pointer.address<HeapHeader>(header)
  let anchor = ()
  let descPtr = unsafe Intrinsic.pointerReinterpret<*mut HeapHeader, *mut ConstructDesc>(header)
  let desc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, header)
  let variable = unsafe HeapCell.payload<VarRef, ()>(&anchor, header)
  let rc0 = &state.receiverCache[0]
  let rc0Addr = Pointer.address<ReceiverCacheEntry>(Pointer.fromRef<ReceiverCacheEntry>(rc0))
  let rc1Addr = Pointer.address<ReceiverCacheEntry>(Pointer.fromRef<ReceiverCacheEntry>(&state.receiverCache[1]))
  let ic0 = &state.instanceCache[0]
  let ic0Addr = Pointer.address<InstanceCacheEntry>(Pointer.fromRef<InstanceCacheEntry>(ic0))
  let ic1Addr = Pointer.address<InstanceCacheEntry>(Pointer.fromRef<InstanceCacheEntry>(&state.instanceCache[1]))
  return ConstructLayout {
    descCtor: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&desc.ctor)) - base),
    descProto: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&desc.proto)) - base),
    descTarget: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&desc.target)) - base),
    descFnProto: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&desc.fnProto)) - base),
    descApplyFn: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&desc.applyFn)) - base),
    descRealm: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&desc.realm)) - base),
    descFinalShapePtr: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&desc.finalShapePtr)) - base),
    descCtorVersion: usize.toU32(Pointer.address<u64>(Pointer.fromRef<u64>(&desc.ctorVersion)) - base),
    descTargetVersion: usize.toU32(Pointer.address<u64>(Pointer.fromRef<u64>(&desc.targetVersion)) - base),
    descFnProtoVersion: usize.toU32(Pointer.address<u64>(Pointer.fromRef<u64>(&desc.fnProtoVersion)) - base),
    descShapeEpoch: usize.toU32(Pointer.address<u64>(Pointer.fromRef<u64>(&desc.shapeEpoch)) - base),
    descFinalShape: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&desc.finalShape)) - base),
    descEmptyShape: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&desc.emptyShape)) - base),
    descReceiverSlot: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&desc.receiverSlot)) - base),
    descProtoSlot: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&desc.protoSlot)) - base),
    descHolderSlot: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&desc.holderSlot)) - base),
    descApplySlot: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&desc.applySlot)) - base),
    descStores: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&desc.stores)) - base),
    descTail: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&desc.tail)) - base),
    descForward: usize.toU32(Pointer.address<u8>(Pointer.fromRef<u8>(&desc.forward)) - base),
    descFromEmpty: usize.toU32(Pointer.address<u8>(Pointer.fromRef<u8>(&desc.fromEmpty)) - base),
    descCheckInterrupt: usize.toU32(Pointer.address<u8>(Pointer.fromRef<u8>(&desc.checkInterrupt)) - base),
    descNestedKind: usize.toU32(Pointer.address<u8>(Pointer.fromRef<u8>(&desc.nestedKind)) - base),
    rtObserveFresh: usize.toU32(Pointer.address<bool>(Pointer.fromRef<bool>(&state.observeFresh)) - base),
    rtReceiverFunctions: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&state.receiverFunctions[0])) - base),
    rtReceiverCache: usize.toU32(rc0Addr - base),
    rcEntryStride: usize.toU32(rc1Addr - rc0Addr),
    rcEntryEmpty: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&rc0.empty)) - rc0Addr),
    rcEntryFinal: usize.toU32(Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&rc0.final)) - rc0Addr),
    rtInstanceCache: usize.toU32(ic0Addr - base),
    icEntryStride: usize.toU32(ic1Addr - ic0Addr),
    icEntryVersion: usize.toU32(Pointer.address<u64>(Pointer.fromRef<u64>(&ic0.version)) - ic0Addr),
    icEntryIndex: usize.toU32(Pointer.address<usize>(Pointer.fromRef<usize>(&ic0.index)) - ic0Addr),
    bytecodeFnClass: classes.JS_CLASS_BYTECODE_FUNCTION,
    cFnClass: classes.JS_CLASS_C_FUNCTION,
    objectClass: classes.JS_CLASS_OBJECT,
    varRefIsConst: usize.toU32(Pointer.address<bool>(Pointer.fromRef<bool>(&variable.isConst)) - base)
  }
}

/// Byte offsets (from an ObjectData cell header) and discriminant bytes that identify a
/// JS_CLASS_C_FUNCTION whose payload is NativeFunctionId.Builtin { family: BuiltinFamily.Math }.
/// `fnTagAt` or `familyAt` is `u32.MAX` if probing could not uniquely identify the bytes.
pub struct MathLayout {
  pub fnTagAt: u32,
  pub familyAt: u32,
  pub methodAt: u32,
  pub builtinTag: u8,
  pub mathFamily: u8
}
impl Copy for MathLayout {}

fn sampleNativePayload(id: NativeFunctionId) -> ObjectPayload {
  return ObjectPayload.NativeFunction {
    function: NativeFunctionData {
      context: Pointer.null<HeapHeader>(),
      function: id,
      magicBits: 0,
      length: 0,
      protocol: NativeCallProtocol.FloatUnary,
      callKind: 0
    }
  }
}

fn nativePayloadBytes(p: ObjectPayload, fill: u8) -> [u8; 64] {
  let mut bytes: [u8; 64] = [fill; 64]
  let dst = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ObjectPayload>(Pointer.fromMutRef<u8>(&mut bytes[0]))
  unsafe Pointer.put<ObjectPayload>(dst, move p)
  return bytes
}

/// Probes the exact NativeFunctionId.Builtin discriminant byte, BuiltinFamily.Math byte,
/// and u32 method ID offset within ObjectData.payload so mathCallOnFrame and STEP_MATH_SLOW
/// can dispatch Math builtins inline.
pub fn mathLayout() -> MathLayout {
  let payloadSize = Layout.of<ObjectPayload>().bytes
  if payloadSize > 64 { return MathLayout { fnTagAt: u32.MAX, familyAt: u32.MAX, methodAt: u32.MAX, builtinTag: 0, mathFamily: 0 } }
  let mut cell: [u64; 64] = [0; 64]
  let header = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut HeapHeader>(Pointer.fromMutRef<u64>(&mut cell[0]))
  let base = Pointer.address<HeapHeader>(header)
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, header)
  let payloadOff = Pointer.address<ObjectPayload>(Pointer.fromRef<ObjectPayload>(&data.payload)) - base
  let m0_0 = nativePayloadBytes(sampleNativePayload(NativeFunctionId.Builtin { family: BuiltinFamily.Math, method: 0 }), 0)
  let m0_f = nativePayloadBytes(sampleNativePayload(NativeFunctionId.Builtin { family: BuiltinFamily.Math, method: 0 }), 255)
  let m1_0 = nativePayloadBytes(sampleNativePayload(NativeFunctionId.Builtin { family: BuiltinFamily.Math, method: 0x01020304 }), 0)
  let m2_0 = nativePayloadBytes(sampleNativePayload(NativeFunctionId.Builtin { family: BuiltinFamily.Math, method: 0x11223344 }), 0)
  let j0_0 = nativePayloadBytes(sampleNativePayload(NativeFunctionId.Builtin { family: BuiltinFamily.Json, method: 0 }), 0)
  let s0_0 = nativePayloadBytes(sampleNativePayload(NativeFunctionId.Builtin { family: BuiltinFamily.String, method: 0 }), 0)
  let h0_0 = nativePayloadBytes(sampleNativePayload(NativeFunctionId.Host { id: 0 }), 0)
  let h0_f = nativePayloadBytes(sampleNativePayload(NativeFunctionId.Host { id: 0 }), 255)
  let h1_0 = nativePayloadBytes(sampleNativePayload(NativeFunctionId.Host { id: 0x01020304 }), 0)
  let mut tagAt = u32.MAX
  let mut tagCount: u32 = 0
  let mut builtinTag: u8 = 0
  let mut famAt = u32.MAX
  let mut famCount: u32 = 0
  let mut mathFamily: u8 = 0
  let mut methodAt = u32.MAX
  let mut methodCount: u32 = 0
  let mut b: usize = 0
  while b < payloadSize {
    if m0_0[b] == m0_f[b] && m0_0[b] == m1_0[b] {
      if m0_0[b] == j0_0[b] && m0_0[b] == s0_0[b] && h0_0[b] == h0_f[b] && h0_0[b] == h1_0[b] && m0_0[b] != h0_0[b] {
        tagAt = usize.toU32(payloadOff + b)
        builtinTag = m0_0[b]
        tagCount = tagCount + 1
      }
      if m0_0[b] != j0_0[b] && m0_0[b] != s0_0[b] && j0_0[b] != s0_0[b] {
        famAt = usize.toU32(payloadOff + b)
        mathFamily = m0_0[b]
        famCount = famCount + 1
      }
    }
    if b + 4 <= payloadSize
      && m0_0[b] == 0 && m0_0[b + 1] == 0 && m0_0[b + 2] == 0 && m0_0[b + 3] == 0
      && m0_f[b] == 0 && m0_f[b + 1] == 0 && m0_f[b + 2] == 0 && m0_f[b + 3] == 0
      && m1_0[b] == 4 && m1_0[b + 1] == 3 && m1_0[b + 2] == 2 && m1_0[b + 3] == 1
      && m2_0[b] == 0x44 && m2_0[b + 1] == 0x33 && m2_0[b + 2] == 0x22 && m2_0[b + 3] == 0x11 {
      methodAt = usize.toU32(payloadOff + b)
      methodCount = methodCount + 1
    }
    b = b + 1
  }
  if tagCount != 1 || famCount != 1 { return MathLayout { fnTagAt: u32.MAX, familyAt: u32.MAX, methodAt: u32.MAX, builtinTag: 0, mathFamily: 0 } }
  if methodCount != 1 { methodAt = u32.MAX }
  return MathLayout { fnTagAt: tagAt, familyAt: famAt, methodAt: methodAt, builtinTag: builtinTag, mathFamily: mathFamily }
}

// ---- H: 32-63 ----
/// call_fast(env, frame, block: *mut u64) -> u32: the call the call block describes (site and
/// area as for EXIT_CALL), made at once when the callee is linked code that makes no calls
/// (js_vm.fastCall); a js_compiled.FAST_* status.
pub const CALL_FAST: u32 = 32
/// call_pop(env, activation: *mut u8) -> (): pops an activation machine code pushed, called
/// and saw return, when its frame was published meanwhile (js_vm.popDirect).
pub const CALL_POP: u32 = 33

// ---- K: 96-127 ----
/// math(env, area: *const ValueBits, count: u32, out: *mut ValueBits) -> u32: a call block's
/// callee, receiver and count arguments; 1 with the result in out when the callee is a Math
/// function of Numbers (js_compiled_math.mathCall), else 0 and the call is made.
pub const MATH: u32 = 98
/// math_frame(env, calleeCell: *const ValueBits, count: u32, out: *mut ValueBits) -> u32:
/// frame-mode layout where callee is at [0] and arguments follow at [1..1+count]; handles
/// js_compiled_math.mathCall as well as 2-arg Math.min and Math.max on Numbers.
pub const MATH_FRAME: u32 = 99
/// mod_f64(env, aBits: u64, bBits: u64) -> u64: IEEE fmod (f64.remainder) of two doubles.
pub const MOD_F64: u32 = 100
// ---- compile cost and code quality: 120-127 (from K's range) ----
/// exit_state(env, state, frame, record, dump) -> u32: writes the interpreter state an exit
/// record describes and returns the exit status (jit_exit_state).
pub const EXIT_STATE: u32 = 120
/// get_elem_borrowed(env, object, index, out) -> u32: get_elem for a result that borrows from
/// the object (ssa_opt_borrow): out takes no count.
pub const GET_ELEM_BORROWED: u32 = 121
/// get_key(env, frame, object, key, out): an owned value on success; zero on a guard miss.
pub const GET_KEY: u32 = 122

/// Host callback that allocates a fresh pooled ObjectData cell with `tailBytes` of inline tail
/// from the runtime's own allocator when below the runtime's GC threshold; returns null otherwise.
pub type AllocCellFn = extern "C" fn(*mut u8, *mut u8, *mut HeapHeader, usize) -> ?*mut HeapHeader

/// The layout compiled code reads: offsets below are part of the code ABI.
pub struct CompiledEnv {
  /// The runtime the code runs in (offset 0).
  pub runtime: ?*mut HeapHeader,
  /// Helper entry points, at offset 8 + 8 * index; null where none is installed.
  pub helpers: [?*const u8; 128],
  /// Direct calls (--jit-stats direct-calls), at offset DIRECT_CALLS_OFFSET: CALL_FAST's,
  /// and those machine code makes itself, which add to it.
  pub directCalls: u64,
  /// Generic instruction exits taken (--jit-stats generic-runs), at GENERIC_RUNS_OFFSET: the
  /// code counts each before it leaves.
  pub genericRuns: u64,
  /// Optional host callback (AllocCellFn) for Tier-3 pooled fresh-cell allocation.
  pub allocCell: ?*const u8
}
pub const DIRECT_CALLS_OFFSET: i32 = 8 + 8 * 128
pub const GENERIC_RUNS_OFFSET: i32 = DIRECT_CALLS_OFFSET + 8
impl Copy for CompiledEnv {}

/// The byte offset of helper `index` in a CompiledEnv.
pub fn helperOffset(index: u32) -> i32 { return u32.wrappingToI32(8 + index * 8) }

impl CompiledEnv {
  /// An environment with every helper this module defines installed.
  pub fn make() -> CompiledEnv {
    let mut env = CompiledEnv { runtime: Pointer.null<HeapHeader>(), helpers: [Pointer.null<u8>(); 128], directCalls: 0, genericRuns: 0, allocCell: Pointer.null<u8>() }
    let release: extern "C" fn(*mut CompiledEnv, *const ValueBits) -> () = jitRelease
    env.helpers[u32.toUsize(RELEASE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits) -> (), *const ?*const u8>(Pointer.fromRef(&release)))
    let getField: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *const ValueBits, *mut ValueBits) -> u32 = jitGetField
    env.helpers[u32.toUsize(GET_FIELD)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *const ValueBits, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getField)))
    let putField: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u64, *const ValueBits, *const ValueBits) -> u32 = jitPutField
    env.helpers[u32.toUsize(PUT_FIELD)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u64, *const ValueBits, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&putField)))
    let atomValue: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *mut ValueBits) -> u32 = jitAtomValue
    env.helpers[u32.toUsize(ATOM_VALUE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&atomValue)))
    let getVar: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *mut ValueBits) -> u32 = jitGetVar
    env.helpers[u32.toUsize(GET_VAR)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getVar)))
    let putVar: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *const ValueBits) -> u32 = jitPutVar
    env.helpers[u32.toUsize(PUT_VAR)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&putVar)))
    let getScope: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *mut ValueBits) -> u32 = jitGetScope
    env.helpers[u32.toUsize(GET_SCOPE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getScope)))
    let putScope: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *const ValueBits) -> u32 = jitPutScope
    env.helpers[u32.toUsize(PUT_SCOPE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, u32, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&putScope)))
    let getElem: extern "C" fn(*mut CompiledEnv, *const ValueBits, i32, *mut ValueBits) -> u32 = jitGetElem
    env.helpers[u32.toUsize(GET_ELEM)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits, i32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getElem)))
    let putElem: extern "C" fn(*mut CompiledEnv, *const ValueBits, i32, *const ValueBits) -> u32 = jitPutElem
    env.helpers[u32.toUsize(PUT_ELEM)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits, i32, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&putElem)))
    let getLength: extern "C" fn(*mut CompiledEnv, *const ValueBits, *mut ValueBits) -> u32 = jitGetLength
    env.helpers[u32.toUsize(GET_LENGTH)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getLength)))
    let truthy: extern "C" fn(*mut CompiledEnv, *const ValueBits) -> u32 = jitTruthy
    env.helpers[u32.toUsize(TRUTHY)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&truthy)))
    let typeofOf: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, *const ValueBits) -> u32 = jitTypeof
    env.helpers[u32.toUsize(TYPEOF)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&typeofOf)))
    let instanceOf: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, *const ValueBits, *const ValueBits) -> u32 = jitInstanceOf
    env.helpers[u32.toUsize(INSTANCEOF)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, *const ValueBits, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&instanceOf)))
    let equalsOf: extern "C" fn(*mut CompiledEnv, *const ValueBits, *const ValueBits, u32) -> u32 = jitEquals
    env.helpers[u32.toUsize(EQUALS)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits, *const ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&equalsOf)))
    let arrayPush: extern "C" fn(*mut CompiledEnv, *const ValueBits, *const ValueBits, *mut ValueBits) -> u32 = jitArrayPush
    env.helpers[u32.toUsize(ARRAY_PUSH)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits, *const ValueBits, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&arrayPush)))
    let arrayPop: extern "C" fn(*mut CompiledEnv, *const ValueBits, *mut ValueBits) -> u32 = jitArrayPop
    env.helpers[u32.toUsize(ARRAY_POP)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&arrayPop)))
    let callFast: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, *mut u64) -> u32 = jitCallFast
    env.helpers[u32.toUsize(CALL_FAST)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, *mut u64) -> u32, *const ?*const u8>(Pointer.fromRef(&callFast)))
    let math: extern "C" fn(*mut CompiledEnv, *const ValueBits, u32, *mut ValueBits) -> u32 = jitMath
    env.helpers[u32.toUsize(MATH)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&math)))
    let callPop: extern "C" fn(*mut CompiledEnv, *mut u8) -> () = jitCallPop
    env.helpers[u32.toUsize(CALL_POP)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *mut u8) -> (), *const ?*const u8>(Pointer.fromRef(&callPop)))
    let getKey: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, *const ValueBits, *const ValueBits, *mut ValueBits) -> u32 = jitGetKey
    env.helpers[u32.toUsize(GET_KEY)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, *const ValueBits, *const ValueBits, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getKey)))
    let getElemBorrowed: extern "C" fn(*mut CompiledEnv, *const ValueBits, i32, *mut ValueBits) -> u32 = jitGetElemBorrowed
    env.helpers[u32.toUsize(GET_ELEM_BORROWED)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits, i32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getElemBorrowed)))
    let exitState: extern "C" fn(*mut u8, *mut u64, *mut u8, *mut u32, *mut u64) -> u32 = jitExitState
    env.helpers[u32.toUsize(EXIT_STATE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut u8, *mut u64, *mut u8, *mut u32, *mut u64) -> u32, *const ?*const u8>(Pointer.fromRef(&exitState)))
    let mathFrame: extern "C" fn(*mut CompiledEnv, *const ValueBits, u32, *mut ValueBits) -> u32 = jitMathFrame
    env.helpers[u32.toUsize(MATH_FRAME)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&mathFrame)))
    let modF64: extern "C" fn(*mut CompiledEnv, u64, u64) -> u64 = jitModF64
    env.helpers[u32.toUsize(MOD_F64)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, u64, u64) -> u64, *const ?*const u8>(Pointer.fromRef(&modF64)))
    let newObj: extern "C" fn(*mut CompiledEnv, *mut ConstructDesc, *mut ValueBits) -> u32 = jitNewObject
    env.helpers[u32.toUsize(NEW_OBJECT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *mut ConstructDesc, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&newObj)))
    let checkConstruct: extern "C" fn(*mut CompiledEnv, *mut ConstructDesc) -> u32 = jitCheckConstruct
    env.helpers[u32.toUsize(CHECK_CONSTRUCT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *mut ConstructDesc) -> u32, *const ?*const u8>(Pointer.fromRef(&checkConstruct)))
    let typeofStr: extern "C" fn(*mut CompiledEnv, *const CompiledFrame, *const ValueBits, *mut ValueBits) -> u32 = jitTypeofStr
    env.helpers[u32.toUsize(TYPEOF_STR)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const CompiledFrame, *const ValueBits, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&typeofStr)))
    return env
  }
}

export "C" fn jitArrayPush(env: *mut CompiledEnv, object: *const ValueBits, value: *const ValueBits, out: *mut ValueBits) -> u32 {
  if unsafe objects.arrayPush(unsafe Pointer.read<ValueBits>(object), unsafe Pointer.read<ValueBits>(value), out) { return 1 }
  return 0
}

export "C" fn jitArrayPop(env: *mut CompiledEnv, object: *const ValueBits, out: *mut ValueBits) -> u32 {
  if unsafe objects.arrayPop(unsafe Pointer.read<ValueBits>(object), out) { return 1 }
  return 0
}

export "C" fn jitMath(env: *mut CompiledEnv, area: *const ValueBits, count: u32, out: *mut ValueBits) -> u32 {
  if unsafe mathematics.mathCall(area, count, out) { return 1 }
  return 0
}

fn numberBitsOf(value: ValueBits, out: &mut f64) -> bool {
  match value {
    ValueBits.Int { value: x } => { out.* = i32.toF64(x) return true }
    ValueBits.Float64 { value: x } => { out.* = x return true }
    _ => { return false }
  }
}

export "C" fn jitMathFrame(env: *mut CompiledEnv, calleeCell: *const ValueBits, count: u32, out: *mut ValueBits) -> u32 {
  if count != 1 && count != 2 { return 0 }
  let many = unsafe Pointer.assumeMany<ValueBits>(calleeCell)
  let callee = unsafe Pointer.read<ValueBits>(calleeCell)
  let arg0 = unsafe Pointer.read<ValueBits>(unsafe Pointer.at<ValueBits>(many, 1))
  let mut arg1 = ValueBits.Undefined
  if count == 2 { arg1 = unsafe Pointer.read<ValueBits>(unsafe Pointer.at<ValueBits>(many, 2)) }
  let area: [ValueBits; 4] = [callee, ValueBits.Undefined, arg0, arg1]
  if unsafe mathematics.mathCall(Pointer.fromRef<ValueBits>(&area[0]), count, out) { return 1 }
  if count != 2 { return 0 }
  let object = match callee { ValueBits.Object { reference } => reference _ => { return 0 } }
  let anchor = ()
  let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let mut method: u32 = u32.MAX
  match &p.payload {
    ObjectPayload.NativeFunction { function: native } => {
      match native.function {
        NativeFunctionId.Builtin { family, method: m } => {
          if family == BuiltinFamily.Math && (m == 0 || m == 1) { method = m }
        }
        _ => ()
      }
    }
    _ => ()
  }
  drop p
  if method == u32.MAX { return 0 }
  let mut x: f64 = 0.0 let mut y: f64 = 0.0
  if !numberBitsOf(arg0, &mut x) || !numberBitsOf(arg1, &mut y) { return 0 }
  let mut res: f64 = 0.0
  if x != x || y != y { res = x + y }
  else if method == 0 {
    // Math.min(x, y): -0 < +0.
    if x < y || (x == y && (f64.toBits(x) & 0x8000000000000000) != 0) { res = x } else { res = y }
  } else {
    // Math.max(x, y): +0 > -0.
    if x > y || (x == y && (f64.toBits(x) & 0x8000000000000000) == 0) { res = x } else { res = y }
  }
  unsafe Pointer.write<ValueBits>(out, ValueBits.number(res))
  return 1
}

export "C" fn jitModF64(env: *mut CompiledEnv, aBits: u64, bBits: u64) -> u64 {
  return f64.toBits(f64.remainder(f64.fromBits(aBits), f64.fromBits(bBits)))
}

export "C" fn jitCallPop(env: *mut CompiledEnv, activation: *mut u8) -> () {
  unsafe vm.popDirect(activation)
}

export "C" fn jitRelease(env: *mut CompiledEnv, value: *const ValueBits) -> () {
  unsafe gc.releaseDeferred(unsafe Pointer.read<ValueBits>(value))
}

export "C" fn jitGetField(env: *mut CompiledEnv, frame: *const CompiledFrame, site: u32, object: *const ValueBits, out: *mut ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  // site: pc | borrowed << 30 | cached << 31.
  if unsafe objects.readField(&running, site & 0x3fffffff, (site & 0x80000000) != 0, (site & 0x40000000) == 0, unsafe Pointer.read<ValueBits>(object), out) { return 1 }
  return 0
}

export "C" fn jitPutField(env: *mut CompiledEnv, frame: *const CompiledFrame, site: u64, object: *const ValueBits, value: *const ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  return unsafe objects.writeField(&running, u64.wrappingToU32(site), unsafe Pointer.read<ValueBits>(object), value, (site & PUT_FIELD_RELEASE_LAST) != 0)
}

export "C" fn jitAtomValue(env: *mut CompiledEnv, frame: *const CompiledFrame, site: u32, out: *mut ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  if unsafe objects.atomValue(&running, site & 0x7fffffff, (site & 0x80000000) != 0, out) { return 1 }
  return 0
}

export "C" fn jitGetVar(env: *mut CompiledEnv, frame: *const CompiledFrame, index: u32, out: *mut ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  // index: closure variable | borrowed << 31.
  if unsafe objects.readVariable(&running, index & 0x7fffffff, (index & 0x80000000) == 0, out) { return 1 }
  return 0
}

export "C" fn jitPutVar(env: *mut CompiledEnv, frame: *const CompiledFrame, index: u32, value: *const ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  if unsafe objects.writeVariable(&running, index, value) { return 1 }
  return 0
}

export "C" fn jitGetScope(env: *mut CompiledEnv, frame: *const CompiledFrame, site: u32, out: *mut ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  // site: slot | checked << 31 | captured << 30 | borrowed << 29.
  let retain = (site & 0x20000000) == 0
  if (site & 0x40000000) != 0 { if unsafe objects.readCaptured(&running, site & 0xffff, retain, out) { return 1 } return 0 }
  if unsafe objects.readScope(&running, site & 0xffff, (site & 0x80000000) != 0, retain, out) { return 1 }
  return 0
}

export "C" fn jitPutScope(env: *mut CompiledEnv, frame: *const CompiledFrame, site: u32, value: *const ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  if (site & 0x40000000) != 0 { if unsafe objects.writeCaptured(&running, site & 0xffff, value) { return 1 } return 0 }
  if unsafe objects.writeScope(&running, site & 0xffff, (site & 0x80000000) != 0, value) { return 1 }
  return 0
}

export "C" fn jitGetKey(env: *mut CompiledEnv, frame: *const CompiledFrame, object: *const ValueBits, key: *const ValueBits, out: *mut ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  if unsafe objects.readKey(&running, unsafe Pointer.read<ValueBits>(object), unsafe Pointer.read<ValueBits>(key), out) { return 1 }
  return 0
}

export "C" fn jitGetElem(env: *mut CompiledEnv, object: *const ValueBits, index: i32, out: *mut ValueBits) -> u32 {
  if unsafe objects.readElement(unsafe Pointer.read<ValueBits>(object), index, out) { return 1 }
  return 0
}

export "C" fn jitGetElemBorrowed(env: *mut CompiledEnv, object: *const ValueBits, index: i32, out: *mut ValueBits) -> u32 {
  if unsafe objects.readElementBorrowed(unsafe Pointer.read<ValueBits>(object), index, out) { return 1 }
  return 0
}

export "C" fn jitPutElem(env: *mut CompiledEnv, object: *const ValueBits, index: i32, value: *const ValueBits) -> u32 {
  if unsafe objects.writeElement(unsafe Pointer.read<ValueBits>(object), index, value) { return 1 }
  return 0
}

export "C" fn jitGetLength(env: *mut CompiledEnv, object: *const ValueBits, out: *mut ValueBits) -> u32 {
  if unsafe objects.readLength(unsafe Pointer.read<ValueBits>(object), out) { return 1 }
  return 0
}

export "C" fn jitTruthy(env: *mut CompiledEnv, value: *const ValueBits) -> u32 {
  if unsafe primitives.toBoolean(unsafe Pointer.read<ValueBits>(value)) > 0 { return 1 }
  return 0
}

export "C" fn jitTypeof(env: *mut CompiledEnv, frame: *const CompiledFrame, value: *const ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  return unsafe objects.typeofAtom(&running, unsafe Pointer.read<ValueBits>(value))
}

export "C" fn jitTypeofStr(env: *mut CompiledEnv, frame: *const CompiledFrame, value: *const ValueBits, out: *mut ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  let atom = unsafe objects.typeofAtom(&running, unsafe Pointer.read<ValueBits>(value))
  if atom == 0 { return 0 }
  let rt = unsafe nonnullHeader((unsafe Pointer.borrow<(), CompiledEnv>(&anchor, env)).runtime)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let strVal = state.atoms.storedAtomValue(atom)
  drop state
  unsafe Pointer.write<ValueBits>(out, strVal)
  return 1
}

export "C" fn jitEquals(env: *mut CompiledEnv, left: *const ValueBits, right: *const ValueBits, strict: u32) -> u32 {
  return unsafe objects.equals(unsafe Pointer.read<ValueBits>(left), unsafe Pointer.read<ValueBits>(right), strict == 1)
}

export "C" fn jitInstanceOf(env: *mut CompiledEnv, frame: *const CompiledFrame, left: *const ValueBits, right: *const ValueBits) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  return unsafe objects.instanceOf(&running, unsafe Pointer.read<ValueBits>(left), unsafe Pointer.read<ValueBits>(right))
}

export "C" fn jitCallFast(env: *mut CompiledEnv, frame: *const CompiledFrame, block: *mut u64) -> u32 {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), CompiledFrame>(&anchor, frame)
  let status = unsafe vm.fastCall(&running, block)
  if status != compiled.FAST_GENERIC {
    let mut envAnchor = () let state = unsafe Pointer.borrowMut<(), CompiledEnv>(&mut envAnchor, env)
    state.directCalls = state.directCalls + 1
  }
  return status
}

const CONSTRUCT_PAYLOAD_TAG_BYTES: usize = 8

unsafe fn revalidateConstructEpoch(descPtr: *mut ConstructDesc, epoch: u64) -> bool {
  let mut descAnchor = ()
  let desc = unsafe Pointer.borrowMut<(), ConstructDesc>(&mut descAnchor, descPtr)
  let anchor = ()
  let mut p: usize = 0
  let count = u8.toUsize(desc.protoCount)
  while p < count {
    let link = match Pointer.nonNullMut<HeapHeader>(desc.protoObjs[p]) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return false }
    }
    let ld = unsafe HeapCell.payload<ObjectData, ()>(&anchor, link)
    let lv = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, ld.shape)).version
    drop ld
    if lv != desc.protoVersions[p] { return false }
    p = p + 1
  }
  if desc.forward != 0 {
    let fnProto = match Pointer.nonNullMut<HeapHeader>(desc.fnProto) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return false }
    }
    let fd = unsafe HeapCell.payload<ObjectData, ()>(&anchor, fnProto)
    let fv = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, fd.shape)).version
    drop fd
    if fv != desc.fnProtoVersion { return false }
  }
  desc.shapeEpoch = epoch
  return true
}

@inlineAlways
unsafe fn nonnullHeader(p: ?*mut HeapHeader) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(p)
}

@inlineNever
unsafe fn releaseRecycledHeap(data: &ObjectData, count: usize) -> () {
  let mut oldVals: [ValueBits; 8] = [ValueBits.Undefined; 8]
  let mut i: usize = 0
  while i < count {
    oldVals[i] = (unsafe data.slotUnchecked(i)).valueBits()
    i = i + 1
  }
  i = 0
  while i < count {
    match oldVals[i] {
      ValueBits.Object { reference } => {
        let mut hAnchor = ()
        let hdr = unsafe Pointer.borrowMut<(), HeapHeader>(&mut hAnchor, reference)
        if hdr.referenceCount > 1 { hdr.referenceCount = i32.wrappingSubtract(hdr.referenceCount, 1) }
        else { drop hdr unsafe gc.releaseDeferred(oldVals[i]) }
      }
      _ => {
        if oldVals[i].tag() < 0 { unsafe gc.releaseDeferred(oldVals[i]) }
      }
    }
    i = i + 1
  }
}

@inlineNever
unsafe fn resolveFromEmpty(rt: *mut HeapHeader, descPtr: *mut ConstructDesc, entryEmpty: ?*mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let desc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
  let empty = match Pointer.nonNullMut<HeapHeader>(entryEmpty) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  if Pointer.address<HeapHeader>(empty) != desc.emptyShape { return Pointer.null<HeapHeader>() }
  let mut cur = empty
  let stores = desc.stores
  let mut i: usize = 0
  while i < stores {
    match Pointer.nonNullMut<HeapHeader>(unsafe shapes.verifiedAdd(rt, cur, desc.addAtoms[i])) {
      Option<*mut HeapHeader>.Some { value: next } => { cur = next }
      Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
    }
    i = i + 1
  }
  if Pointer.address<HeapHeader>(cur) != desc.finalShape { return Pointer.null<HeapHeader>() }
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(cur)
}

@inlineNever
unsafe fn allocSpareNewObject(rt: *mut HeapHeader, final: *mut HeapHeader, stores: usize, tail: usize) -> ?*mut HeapHeader {
  let mut headerAnchor = ()
  let shapeHeader = unsafe Pointer.borrowMut<(), HeapHeader>(&mut headerAnchor, final)
  if shapeHeader.referenceCount <= 0 { return Pointer.null<HeapHeader>() }
  drop shapeHeader
  let spare = match Pointer.nonNullMut<HeapHeader>(unsafe gc.takeSpareCell(rt, tail, true)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  let mut retainAnchor = ()
  let finalHeader = unsafe Pointer.borrowMut<(), HeapHeader>(&mut retainAnchor, final)
  finalHeader.referenceCount = i32.wrappingAdd(finalHeader.referenceCount, 1)
  drop finalHeader
  unsafe census.censusBump(rt, census.CENSUS_OBJECTS_ALLOCATED, 1)
  let node = unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, spare)
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, node)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.Empty)
  let slotPtr = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(
    unsafe Intrinsic.pointerReinterpret<*mut ObjectPayload, *mut u8>(payload)), CONSTRUCT_PAYLOAD_TAG_BYTES))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotPtr, tail)
  unsafe slots.extendFilled(stores)
  unsafe data.putSlots(move slots)
  data.setIsStandardArrayPrototype(false)
  data.setExtensible(true)
  data.setFreeMark(false)
  data.setIsExotic(false)
  data.setFastArray(false)
  data.setIsConstructor(false)
  data.setHasImmutablePrototype(false)
  data.setIsHtmlDda(false)
  data.clearRoles()
  data.setClassId(classes.JS_CLASS_OBJECT)
  data.weakRefCount = 0
  data.shape = final
  drop data
  unsafe gc.publishObject(rt, node)
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(node)
}

/// Tries to recycle a dead young plain inline object of capacity `tail` directly off
/// `RuntimeState.zeroStack`, preferring one that already holds `final` shape (zero shape
/// refcount ops). Returns the revived live object (referenceCount == 1, mark == 0, still
/// published in its young GC arena) with `stores` slot entries ready for Op.InitSlot, or null.
@inlineAlways
unsafe fn tryRecycleZero(rt: *mut HeapHeader, final: *mut HeapHeader, stores: usize, tail: usize) -> ?*mut HeapHeader {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let depth = u16.toUsize(state.zeroStackCount)
  if depth == 0 || state.gcPhase != GcPhase.None { return Pointer.null<HeapHeader>() }
  let finalAddr = Pointer.address<HeapHeader>(final)
  let mut bestIdx = usize.MAX
  let mut sameShape = false
  let mut scan: usize = 0
  let limit = if depth < 6 { depth } else { 6 }
  while scan < limit {
    let idx = depth - 1 - scan
    let candOpt = state.zeroStack[idx]
    if !Pointer.isNull<HeapHeader>(candOpt) {
      let cand = unsafe nonnullHeader(candOpt)
      let hdr = unsafe Pointer.borrow<(), HeapHeader>(&anchor, cand)
      if hdr.kind == HeapKind.Object && hdr.young == 1 && hdr.referenceCount == 0 && hdr.mark == 1 {
        let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, cand)
        if data.classId() == classes.JS_CLASS_OBJECT && data.pristineFunction(false) && data.slotsInCell() && data.slotCapacity() == tail && data.slotCount() <= 8 {
          let emptyPayload = match &data.payload { ObjectPayload.Empty => true _ => false }
          if emptyPayload {
            let oldShape = data.shape
            if Pointer.address<HeapHeader>(oldShape) == finalAddr { bestIdx = idx sameShape = true break }
            if bestIdx == usize.MAX && (unsafe Pointer.borrow<(), HeapHeader>(&anchor, oldShape)).referenceCount > 1 { bestIdx = idx }
          }
        }
      }
    }
    scan = scan + 1
  }
  drop state
  if bestIdx == usize.MAX { return Pointer.null<HeapHeader>() }
  let mut stateAnchor = ()
  let stateMut = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, rt)
  let topIdx = u16.toUsize(stateMut.zeroStackCount) - 1
  let chosen = unsafe nonnullHeader(stateMut.zeroStack[bestIdx])
  if bestIdx != topIdx { stateMut.zeroStack[bestIdx] = stateMut.zeroStack[topIdx] }
  stateMut.zeroStackCount = usize.toU16(topIdx)
  drop stateMut
  let mut hdrAnchor = ()
  let hdr = unsafe Pointer.borrowMut<(), HeapHeader>(&mut hdrAnchor, chosen)
  hdr.referenceCount = 1
  hdr.mark = 0
  drop hdr
  let mut dataAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut dataAnchor, chosen)
  let oldCount = data.slotCount()
  let mut anyHeap = false
  let mut i: usize = 0
  while i < oldCount {
    if (unsafe data.slotUnchecked(i)).valueBits().tag() < 0 { anyHeap = true break }
    i = i + 1
  }
  if anyHeap { unsafe releaseRecycledHeap(&data.*, oldCount) }
  if oldCount != stores {
    let mut s = data.takeSlots()
    s.truncate(0)
    unsafe s.extendFilled(stores)
    data.setSlotsFresh(move s)
  }
  if !sameShape {
    let oldShape = data.shape
    data.shape = final
    drop data
    let mut oldAnchor = ()
    let oldHdr = unsafe Pointer.borrowMut<(), HeapHeader>(&mut oldAnchor, oldShape)
    oldHdr.referenceCount = i32.wrappingSubtract(oldHdr.referenceCount, 1)
    drop oldHdr
    let mut newAnchor = ()
    let newHdr = unsafe Pointer.borrowMut<(), HeapHeader>(&mut newAnchor, final)
    newHdr.referenceCount = i32.wrappingAdd(newHdr.referenceCount, 1)
    drop newHdr
  } else {
    drop data
  }
  unsafe census.censusBump(rt, census.CENSUS_OBJECTS_ALLOCATED, 1)
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(chosen)
}

struct FreshCell { node: *mut HeapHeader }

effect fn allocateFreshCell(tailBytes: usize) -> FreshCell ! OutOfMemoryError ? &mut Allocator {
  return FreshCell { node: run HeapCell.allocateUninitWithTail<ObjectData>(HeapKind.Object, tailBytes) }
}

/// Cold fallback allocator for a plain inline object of `final` shape with `stores` slots
/// and inline capacity `tail`, allocating a fresh cell directly from the system allocator.
@inlineNever
unsafe fn allocFreshNewObject(rt: *mut HeapHeader, final: *mut HeapHeader, stores: usize, tail: usize) -> ?*mut HeapHeader {
  let mut headerAnchor = ()
  let shapeHeader = unsafe Pointer.borrowMut<(), HeapHeader>(&mut headerAnchor, final)
  if shapeHeader.referenceCount <= 0 { return Pointer.null<HeapHeader>() }
  drop shapeHeader
  let mut tailBytes = tail * Layout.of<SlotBits>().bytes
  let reused = Layout.of<ObjectPayload>().bytes - CONSTRUCT_PAYLOAD_TAG_BYTES
  if tailBytes > reused { tailBytes = tailBytes - reused } else { tailBytes = 0 }
  let mut system = Allocator.systemAllocatorProvider()
  let allocated = run Effect.result(allocateFreshCell(tailBytes)) |> Effect.provideMut<Allocator>(&mut system)
  let node = match move allocated {
    Result<FreshCell, OutOfMemoryError>.Success { value } => value.node
    Result<FreshCell, OutOfMemoryError>.Failure { .. } => { return Pointer.null<HeapHeader>() }
  }
  let mut retainAnchor = ()
  let finalHeader = unsafe Pointer.borrowMut<(), HeapHeader>(&mut retainAnchor, final)
  finalHeader.referenceCount = i32.wrappingAdd(finalHeader.referenceCount, 1)
  drop finalHeader
  unsafe census.censusBump(rt, census.CENSUS_OBJECTS_ALLOCATED, 1)
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, node)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.Empty)
  let slotPtr = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(
    unsafe Intrinsic.pointerReinterpret<*mut ObjectPayload, *mut u8>(payload)), CONSTRUCT_PAYLOAD_TAG_BYTES))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotPtr, tail)
  unsafe slots.extendFilled(stores)
  unsafe data.putSlots(move slots)
  data.setIsStandardArrayPrototype(false)
  data.setExtensible(true)
  data.setFreeMark(false)
  data.setIsExotic(false)
  data.setFastArray(false)
  data.setIsConstructor(false)
  data.setHasImmutablePrototype(false)
  data.setIsHtmlDda(false)
  data.clearRoles()
  data.setClassId(classes.JS_CLASS_OBJECT)
  data.weakRefCount = 0
  data.shape = final
  drop data
  unsafe gc.publishObject(rt, node)
  if unsafe gc.observesFresh(rt) { unsafe gc.noteFreshObserved(rt, node) }
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(node)
}

/// Allocates one plain object with shape `final` and `stores` Undefined slots (`rc == 1`),
/// pinned in the runtime's kept table by `commitConstructDesc` so `final` stays alive for
/// the runtime's entire lifetime (including deopt materialization).
pub unsafe fn allocSentinelPlain(rt: *mut HeapHeader, final: *mut HeapHeader, stores: usize, tail: usize) -> ?*mut HeapHeader {
  let mut nodeOpt = unsafe tryRecycleZero(rt, final, stores, tail)
  if Pointer.isNull<HeapHeader>(nodeOpt) { nodeOpt = unsafe allocSpareNewObject(rt, final, stores, tail) }
  if Pointer.isNull<HeapHeader>(nodeOpt) { nodeOpt = unsafe allocFreshNewObject(rt, final, stores, tail) }
  let node = match Pointer.nonNullMut<HeapHeader>(nodeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let mut i: usize = 0
  while i < stores {
    data.setSlotFresh(i, SlotBits.value(ValueBits.Undefined))
    i = i + 1
  }
  drop data
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(node)
}

/// Materializes an escape-eliminated virtual object on deoptimization exit (`x64_frame_exit`).
/// Allocates an object of `desc.finalShapePtr` via the 3-tier allocator (zeroStack recycle ->
/// spare cell -> fresh cell) and moves caller-owned `fields[0..slotCount]` into its slots
/// (filling any remaining slots up to `desc.stores` with Undefined). Returns an owned
/// `ValueBits.Object` (`rc == 1`).
pub unsafe fn materializeConstruct(rt: *mut HeapHeader, descPtr: *mut ConstructDesc, fields: *const ValueBits, slotCount: usize) -> ValueBits {
  let anchor = ()
  let desc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
  let stores = desc.stores
  let tail = desc.tail
  let finalOpt = desc.finalShapePtr
  drop desc
  let final = match Pointer.nonNullMut<HeapHeader>(finalOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { Intrinsic.trap("materializeConstruct: construct descriptor has no final shape") }
  }
  let mut fresh = false
  let mut nodeOpt = unsafe tryRecycleZero(rt, final, stores, tail)
  if Pointer.isNull<HeapHeader>(nodeOpt) { nodeOpt = unsafe allocSpareNewObject(rt, final, stores, tail) }
  if Pointer.isNull<HeapHeader>(nodeOpt) { nodeOpt = unsafe allocFreshNewObject(rt, final, stores, tail) fresh = true }
  let node = match Pointer.nonNullMut<HeapHeader>(nodeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { Intrinsic.trap("materializeConstruct: out of memory materializing virtual object") }
  }
  if !fresh && unsafe gc.observesFresh(rt) { unsafe gc.noteFreshObserved(rt, node) }
  let fieldMany = unsafe Pointer.assumeMany<ValueBits>(fields)
  let mut dataAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut dataAnchor, node)
  let mut s: usize = 0
  while s < stores {
    let val = if s < slotCount { unsafe Pointer.read<ValueBits>(unsafe Pointer.at<ValueBits>(fieldMany, s)) } else { ValueBits.Undefined }
    data.setSlotFresh(s, SlotBits.value(val))
    s = s + 1
  }
  drop data
  return ValueBits.Object { reference: node }
}

/// Materializes a temporary `JS_CLASS_BYTECODE_FUNCTION` closure object wrapping a known
/// local function (`ValueBits.FunctionBytecode`) when an inlined known-function body exits
/// mid-body (`SERVICE_INLINED` -> `callResuming`). `baselineInlined` / `callInlined` takes
/// ownership of the returned object and releases it when the resumed call completes.
/// scope is the scope the function runs under, on the heap (the closure takes a count), or
/// null for a body that reads none.
@inlineNever
pub unsafe fn materializeKnownClosure(rt: *mut HeapHeader, cell: *mut HeapHeader, scope: ?*mut HeapHeader) -> ValueBits {
  let mut system = Allocator.systemAllocatorProvider()
  let shapeRes = run Effect.result(unsafe shapes.empty(rt, Pointer.null<HeapHeader>())) |> Effect.provideMut<Allocator>(&mut system)
  let shape = match move shapeRes {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { .. } => { Intrinsic.trap("materializeKnownClosure: out of memory allocating shape") }
  }
  let allocated = run Effect.result(allocateFreshCell(0)) |> Effect.provideMut<Allocator>(&mut system)
  let node = match move allocated {
    Result<FreshCell, OutOfMemoryError>.Success { value } => value.node
    Result<FreshCell, OutOfMemoryError>.Failure { .. } => { Intrinsic.trap("materializeKnownClosure: out of memory allocating closure") }
  }
  let codeAnchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&codeAnchor, cell)
  let refCount = code.known.refs.length()
  let mut varRefs = BoxList<?*mut HeapHeader>.make()
  if refCount != 0 {
    let made = run Effect.result(BoxList<?*mut HeapHeader>.makeFilled(refCount, Pointer.null<HeapHeader>())) |> Effect.provideMut<Allocator>(&mut system)
    varRefs = match move made {
      Result<BoxList<?*mut HeapHeader>, OutOfMemoryError>.Success { value } => move value
      Result<BoxList<?*mut HeapHeader>, OutOfMemoryError>.Failure { .. } => { Intrinsic.trap("materializeKnownClosure: out of memory allocating varRefs") }
    }
    let mut i: usize = 0
    while i < refCount {
      let r = code.known.refs.get(i)
      if let Option<*mut HeapHeader>.Some { value: vr } = Pointer.nonNullMut<HeapHeader>(r) {
        unsafe HeapCell.retain(vr)
      }
      varRefs.set(i, r)
      i = i + 1
    }
  }
  drop code
  unsafe HeapCell.retain(cell)
  if let Option<*mut HeapHeader>.Some { value: held } = Pointer.nonNullMut<HeapHeader>(scope) { unsafe HeapCell.retain(held) }
  unsafe census.censusBump(rt, census.CENSUS_OBJECTS_ALLOCATED, 1)
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, node)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.BytecodeFunction { function: BytecodeClosure {
    bytecode: cell, varRefs: move varRefs, homeObject: Pointer.null<HeapHeader>(), scope: scope
  } })
  unsafe data.putSlots(ThinList<SlotBits>.make())
  data.setIsStandardArrayPrototype(false)
  data.setExtensible(true)
  data.setFreeMark(false)
  data.setIsExotic(false)
  data.setFastArray(false)
  data.setIsConstructor(false)
  data.setHasImmutablePrototype(false)
  data.setIsHtmlDda(false)
  data.clearRoles()
  data.setClassId(classes.JS_CLASS_BYTECODE_FUNCTION)
  data.weakRefCount = 0
  data.shape = shape
  drop data
  unsafe gc.publishObject(rt, node)
  if unsafe gc.observesFresh(rt) { unsafe gc.noteFreshObserved(rt, node) }
  return ValueBits.Object { reference: node }
}

/// Validates a planned constructor descriptor and ticks its interrupt counter if required.
/// Returns 1 on hit (setting `outFinal`), 2 when an interrupt poll is due, or 0 on guard miss.
pub const NESTED_NONE: u8 = 0
pub const NESTED_PLAIN: u8 = 1
pub const NESTED_EMPTY_ARRAY: u8 = 2

/// Validates a single planned constructor descriptor (without recursing into nestedDesc).
@inlineAlways
unsafe fn validateConstructOne(descPtr: *mut ConstructDesc, epoch: u64, outFinal: &mut ?*mut HeapHeader) -> u32 {
  let anchor = ()
  let desc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
  let ctor = unsafe nonnullHeader(desc.ctor)
  let proto = unsafe nonnullHeader(desc.proto)
  let ctorVersion = desc.ctorVersion
  let protoSlot = desc.protoSlot
  let forward = desc.forward
  let finalOpt = desc.finalShapePtr
  let checkInterrupt = desc.checkInterrupt
  let descEpoch = desc.shapeEpoch
  let realm = unsafe nonnullHeader(desc.realm)
  let guardVarCellOpt = desc.guardVarCell
  let guardVarExpectOpt = desc.guardVarExpect
  let guardHopCount = desc.guardHopCount
  drop desc
  if Pointer.isNull<HeapHeader>(finalOpt) { return 0 }
  if epoch != descEpoch {
    if !unsafe revalidateConstructEpoch(descPtr, epoch) { return 0 }
  }
  let ctorData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, ctor)
  if (unsafe HeapCell.payload<ShapeData, ()>(&anchor, ctorData.shape)).version != ctorVersion { return 0 }
  match (unsafe ctorData.slotUnchecked(protoSlot)).valueBits() {
    ValueBits.Object { reference } => {
      if Pointer.address<HeapHeader>(reference) != Pointer.address<HeapHeader>(proto) { return 0 }
    }
    _ => { return 0 }
  }
  drop ctorData
  if forward != 0 {
    let d2 = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
    let target = unsafe nonnullHeader(d2.target)
    let fnProto = unsafe nonnullHeader(d2.fnProto)
    let applyFn = unsafe nonnullHeader(d2.applyFn)
    let holderSlot = d2.holderSlot
    let targetVersion = d2.targetVersion
    let applySlot = d2.applySlot
    drop d2
    let protoData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, proto)
    match (unsafe protoData.slotUnchecked(holderSlot)).valueBits() {
      ValueBits.Object { reference } => {
        if Pointer.address<HeapHeader>(reference) != Pointer.address<HeapHeader>(target) { return 0 }
      }
      _ => { return 0 }
    }
    drop protoData
    let targetData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, target)
    if (unsafe HeapCell.payload<ShapeData, ()>(&anchor, targetData.shape)).version != targetVersion { return 0 }
    drop targetData
    let fnProtoData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, fnProto)
    match (unsafe fnProtoData.slotUnchecked(applySlot)).valueBits() {
      ValueBits.Object { reference } => {
        if Pointer.address<HeapHeader>(reference) != Pointer.address<HeapHeader>(applyFn) { return 0 }
      }
      _ => { return 0 }
    }
    drop fnProtoData
  }
  if let Option<*mut HeapHeader>.Some { value: varCell } = Pointer.nonNullMut<HeapHeader>(guardVarCellOpt) {
    let varRef = unsafe HeapCell.payload<VarRef, ()>(&anchor, varCell)
    let okVar = match varRef.state {
      VarRefState.Detached { value } => match value {
        ValueBits.Object { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(guardVarExpectOpt)
        _ => false
      }
      _ => false
    }
    drop varRef
    if !okVar { return 0 }
    let mut h: usize = 0
    while h < u8.toUsize(guardHopCount) {
      let d3 = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
      let hopObj = unsafe nonnullHeader(d3.guardHopObjs[h])
      let hopExpect = d3.guardHopExpect[h]
      let hopVersion = d3.guardHopVersions[h]
      let hopSlot = d3.guardHopSlots[h]
      drop d3
      let hopData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, hopObj)
      if (unsafe HeapCell.payload<ShapeData, ()>(&anchor, hopData.shape)).version != hopVersion { return 0 }
      match (unsafe hopData.slotUnchecked(hopSlot)).valueBits() {
        ValueBits.Object { reference } => {
          if Pointer.address<HeapHeader>(reference) != Pointer.address<HeapHeader>(hopExpect) { return 0 }
        }
        _ => { return 0 }
      }
      drop hopData
      h = h + 1
    }
  }
  if checkInterrupt != 0 {
    let counter = unsafe interrupts.counter(realm)
    let next = i32.wrappingSubtract(unsafe Pointer.read<i32>(counter), 1)
    if next <= 0 {
      unsafe Pointer.write<i32>(counter, 10000)
      return 2
    }
    unsafe Pointer.write<i32>(counter, next)
  }
  outFinal.* = finalOpt
  return 1
}

/// Validates a planned constructor descriptor (and any nested plain descriptors) and ticks its
/// interrupt counter if required. Returns 1 on hit (setting `outFinal`), 2 on poll, or 0 on miss.
@inlineAlways
unsafe fn validateConstruct(env: *mut CompiledEnv, descPtr: *mut ConstructDesc, outFinal: &mut ?*mut HeapHeader) -> u32 {
  let anchor = ()
  let rt = unsafe nonnullHeader((unsafe Pointer.borrow<(), CompiledEnv>(&anchor, env)).runtime)
  if unsafe gc.observesFresh(rt) { return 0 }
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let epoch = state.shapeEpoch
  drop state
  let status = unsafe validateConstructOne(descPtr, epoch, &mut outFinal)
  if status != 1 { return status }
  let mut cur = descPtr
  let mut depth: usize = 0
  while depth < 2 {
    let d = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, cur)
    let nk = d.nestedKind
    let nd = d.nestedDesc
    drop d
    if nk != NESTED_PLAIN { break }
    let nextPtr = match Pointer.nonNullMut<u8>(nd) {
      Option<*mut u8>.Some { value } => unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ConstructDesc>(value)
      Option<*mut u8>.None => { return 0 }
    }
    let mut innerFinal = Pointer.null<HeapHeader>()
    let s2 = unsafe validateConstructOne(nextPtr, epoch, &mut innerFinal)
    if s2 != 1 { return s2 }
    cur = nextPtr
    depth = depth + 1
  }
  return 1
}

/// Fast non-nested validation (identical to the single-descriptor hot path: no guardVarCell,
/// guardHop, or nestedDesc loop). Used by jitNewObject and jitCheckConstruct when nestedKind == 0.
@inlineAlways
unsafe fn validateConstructSimple(env: *mut CompiledEnv, descPtr: *mut ConstructDesc, outFinal: &mut ?*mut HeapHeader) -> u32 {
  let anchor = ()
  let rt = unsafe nonnullHeader((unsafe Pointer.borrow<(), CompiledEnv>(&anchor, env)).runtime)
  if unsafe gc.observesFresh(rt) { return 0 }
  let desc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
  let ctor = unsafe nonnullHeader(desc.ctor)
  let proto = unsafe nonnullHeader(desc.proto)
  let ctorVersion = desc.ctorVersion
  let protoSlot = desc.protoSlot
  let forward = desc.forward
  let finalOpt = desc.finalShapePtr
  let checkInterrupt = desc.checkInterrupt
  let descEpoch = desc.shapeEpoch
  let realm = unsafe nonnullHeader(desc.realm)
  drop desc
  if Pointer.isNull<HeapHeader>(finalOpt) { return 0 }
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let epoch = state.shapeEpoch
  drop state
  if epoch != descEpoch {
    if !unsafe revalidateConstructEpoch(descPtr, epoch) { return 0 }
  }
  let ctorData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, ctor)
  if (unsafe HeapCell.payload<ShapeData, ()>(&anchor, ctorData.shape)).version != ctorVersion { return 0 }
  match (unsafe ctorData.slotUnchecked(protoSlot)).valueBits() {
    ValueBits.Object { reference } => {
      if Pointer.address<HeapHeader>(reference) != Pointer.address<HeapHeader>(proto) { return 0 }
    }
    _ => { return 0 }
  }
  drop ctorData
  if forward != 0 {
    let d2 = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
    let target = unsafe nonnullHeader(d2.target)
    let fnProto = unsafe nonnullHeader(d2.fnProto)
    let applyFn = unsafe nonnullHeader(d2.applyFn)
    let holderSlot = d2.holderSlot
    let targetVersion = d2.targetVersion
    let applySlot = d2.applySlot
    drop d2
    let protoData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, proto)
    match (unsafe protoData.slotUnchecked(holderSlot)).valueBits() {
      ValueBits.Object { reference } => {
        if Pointer.address<HeapHeader>(reference) != Pointer.address<HeapHeader>(target) { return 0 }
      }
      _ => { return 0 }
    }
    drop protoData
    let targetData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, target)
    if (unsafe HeapCell.payload<ShapeData, ()>(&anchor, targetData.shape)).version != targetVersion { return 0 }
    drop targetData
    let fnProtoData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, fnProto)
    match (unsafe fnProtoData.slotUnchecked(applySlot)).valueBits() {
      ValueBits.Object { reference } => {
        if Pointer.address<HeapHeader>(reference) != Pointer.address<HeapHeader>(applyFn) { return 0 }
      }
      _ => { return 0 }
    }
    drop fnProtoData
  }
  if checkInterrupt != 0 {
    let counter = unsafe interrupts.counter(realm)
    let next = i32.wrappingSubtract(unsafe Pointer.read<i32>(counter), 1)
    if next <= 0 {
      unsafe Pointer.write<i32>(counter, 10000)
      return 2
    }
    unsafe Pointer.write<i32>(counter, next)
  }
  outFinal.* = finalOpt
  return 1
}

@inlineNever
unsafe fn jitCheckConstructNested(env: *mut CompiledEnv, descPtr: *mut ConstructDesc) -> u32 {
  let mut finalOpt = Pointer.null<HeapHeader>()
  return unsafe validateConstruct(env, descPtr, &mut finalOpt)
}

export "C" fn jitCheckConstruct(env: *mut CompiledEnv, descPtr: *mut ConstructDesc) -> u32 {
  let anchor = ()
  if (unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)).nestedKind != NESTED_NONE {
    return unsafe jitCheckConstructNested(env, descPtr)
  }
  let mut finalOpt = Pointer.null<HeapHeader>()
  return unsafe validateConstructSimple(env, descPtr, &mut finalOpt)
}

/// Generic host implementation for `AllocCellFn`: allocates a fresh pooled ObjectData cell
/// from the runtime's own allocator `A` when `memory.usedBytes() + ObjectData <= mallocGcThreshold`.
pub unsafe fn allocPooledCell<'m, S: EngineServices, A: Allocator>(
  hooks: *mut u8, allocator: *mut u8, rt: *mut HeapHeader, tailBytes: usize
) -> ?*mut HeapHeader {
  let mut anchor = ()
  let eng = unsafe Pointer.borrowMut<(), Engine<'m, S>>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Engine<'m, S>>(hooks))
  let memory = eng.memory
  let stAnchor = ()
  let threshold = (unsafe HeapCell.payload<RuntimeState, ()>(&stAnchor, rt)).mallocGcThreshold
  if usize.wrappingAdd(memory.usedBytes(), Layout.of<ObjectData>().bytes) > threshold {
    return Pointer.null<HeapHeader>()
  }
  let mut providerAnchor = ()
  let provider = unsafe Pointer.borrowMut<(), A>(&mut providerAnchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut A>(allocator))
  let allocated = run Effect.result(allocateFreshCell(tailBytes)) |> Effect.provideMut<Allocator>(&mut provider)
  return match move allocated {
    Result<FreshCell, OutOfMemoryError>.Success { value } => unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(value.node)
    Result<FreshCell, OutOfMemoryError>.Failure { .. } => Pointer.null<HeapHeader>()
  }
}

/// Invokes the host's optional `allocCell` callback to obtain a fresh uninitialized pooled
/// `ObjectData` cell with exact `tailBytes`, respecting the runtime's GC threshold.
@inlineNever
unsafe fn takePooledCellBytes(env: *mut CompiledEnv, rt: *mut HeapHeader, tailBytes: usize) -> ?*mut HeapHeader {
  let anchor = ()
  let raw = (unsafe Pointer.borrow<(), CompiledEnv>(&anchor, env)).allocCell
  if Pointer.isNull<u8>(raw) { return Pointer.null<HeapHeader>() }
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let hooksOpt = state.compiled.serviceHooks
  let allocOpt = state.compiled.serviceAllocator
  drop state
  let hooks = match Pointer.nonNullMut<u8>(hooksOpt) { Option<*mut u8>.Some { value } => value Option<*mut u8>.None => { return Pointer.null<HeapHeader>() } }
  let alloc = match Pointer.nonNullMut<u8>(allocOpt) { Option<*mut u8>.Some { value } => value Option<*mut u8>.None => { return Pointer.null<HeapHeader>() } }
  let callback = unsafe Pointer.read<AllocCellFn>(unsafe Intrinsic.pointerReinterpret<*const ?*const u8, *const AllocCellFn>(Pointer.fromRef(&raw)))
  return unsafe callback(hooks, alloc, rt, tailBytes)
}

/// Invokes the host's optional `allocCell` callback to obtain a fresh uninitialized pooled
/// plain inline `ObjectData` cell with inline capacity `tail` (slots starting over ObjectPayload).
@inlineNever
pub unsafe fn takePooledCell(env: *mut CompiledEnv, rt: *mut HeapHeader, tail: usize) -> ?*mut HeapHeader {
  let mut tailBytes = tail * Layout.of<SlotBits>().bytes
  let reused = Layout.of<ObjectPayload>().bytes - CONSTRUCT_PAYLOAD_TAG_BYTES
  if tailBytes > reused { tailBytes = tailBytes - reused } else { tailBytes = 0 }
  return unsafe takePooledCellBytes(env, rt, tailBytes)
}

@inlineNever
unsafe fn allocPooledNewObject(env: *mut CompiledEnv, rt: *mut HeapHeader, final: *mut HeapHeader, stores: usize, tail: usize) -> ?*mut HeapHeader {
  let mut headerAnchor = ()
  let shapeHeader = unsafe Pointer.borrowMut<(), HeapHeader>(&mut headerAnchor, final)
  if shapeHeader.referenceCount <= 0 { return Pointer.null<HeapHeader>() }
  drop shapeHeader
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe takePooledCell(env, rt, tail)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  let mut retainAnchor = ()
  let finalHeader = unsafe Pointer.borrowMut<(), HeapHeader>(&mut retainAnchor, final)
  finalHeader.referenceCount = i32.wrappingAdd(finalHeader.referenceCount, 1)
  drop finalHeader
  unsafe census.censusBump(rt, census.CENSUS_OBJECTS_ALLOCATED, 1)
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, node)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.Empty)
  let slotPtr = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(
    unsafe Intrinsic.pointerReinterpret<*mut ObjectPayload, *mut u8>(payload)), CONSTRUCT_PAYLOAD_TAG_BYTES))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotPtr, tail)
  unsafe slots.extendFilled(stores)
  unsafe data.putSlots(move slots)
  data.setIsStandardArrayPrototype(false)
  data.setExtensible(true)
  data.setFreeMark(false)
  data.setIsExotic(false)
  data.setFastArray(false)
  data.setIsConstructor(false)
  data.setHasImmutablePrototype(false)
  data.setIsHtmlDda(false)
  data.clearRoles()
  data.setClassId(classes.JS_CLASS_OBJECT)
  data.weakRefCount = 0
  data.shape = final
  drop data
  unsafe gc.publishObject(rt, node)
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(node)
}

@inlineNever
unsafe fn allocSpareEmptyArray(env: *mut CompiledEnv, rt: *mut HeapHeader, arrayShape: *mut HeapHeader) -> ?*mut HeapHeader {
  let mut headerAnchor = ()
  let shapeHeader = unsafe Pointer.borrowMut<(), HeapHeader>(&mut headerAnchor, arrayShape)
  if shapeHeader.referenceCount <= 0 { return Pointer.null<HeapHeader>() }
  drop shapeHeader
  let mut nodeOpt = Pointer.null<HeapHeader>()
  if let Option<*mut HeapHeader>.Some { value: spare } = Pointer.nonNullMut<HeapHeader>(unsafe gc.takeSpareCell(rt, shapes.INLINE_SLOTS, false)) {
    nodeOpt = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, spare))
  } else {
    nodeOpt = unsafe takePooledCellBytes(env, rt, shapes.INLINE_SLOTS * Layout.of<SlotBits>().bytes)
  }
  let node = match Pointer.nonNullMut<HeapHeader>(nodeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  let mut retainAnchor = ()
  let finalHeader = unsafe Pointer.borrowMut<(), HeapHeader>(&mut retainAnchor, arrayShape)
  finalHeader.referenceCount = i32.wrappingAdd(finalHeader.referenceCount, 1)
  drop finalHeader
  unsafe census.censusBump(rt, census.CENSUS_OBJECTS_ALLOCATED, 1)
  let slotPtr = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe HeapCell.tailAddress<ObjectData>(node))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotPtr, shapes.INLINE_SLOTS)
  slots.push(SlotBits.value(ValueBits.Int { value: 0 }))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, node)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.FastArray { array: FastArrayData.empty() })
  unsafe data.putSlots(move slots)
  data.setIsStandardArrayPrototype(false)
  data.setExtensible(true)
  data.setFreeMark(false)
  data.setIsExotic(true)
  data.setFastArray(true)
  data.setIsConstructor(false)
  data.setHasImmutablePrototype(false)
  data.setIsHtmlDda(false)
  data.clearRoles()
  data.setClassId(classes.JS_CLASS_ARRAY)
  data.weakRefCount = 0
  data.shape = arrayShape
  drop data
  unsafe gc.publishObject(rt, node)
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(node)
}

@inlineAlways
unsafe fn allocPlainCell(env: *mut CompiledEnv, rt: *mut HeapHeader, final: *mut HeapHeader, stores: usize, tail: usize) -> ?*mut HeapHeader {
  let anchor = ()
  if let Option<*mut HeapHeader>.Some { value: recycled } = Pointer.nonNullMut<HeapHeader>(unsafe tryRecycleZero(rt, final, stores, tail)) {
    return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(recycled)
  }
  let zeroCount = (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)).zeroStackCount
  if zeroCount < 240 {
    if let Option<*mut HeapHeader>.Some { value: node } = Pointer.nonNullMut<HeapHeader>(unsafe allocSpareNewObject(rt, final, stores, tail)) {
      return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(node)
    }
    if let Option<*mut HeapHeader>.Some { value: node } = Pointer.nonNullMut<HeapHeader>(unsafe allocPooledNewObject(env, rt, final, stores, tail)) {
      return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(node)
    }
  }
  return Pointer.null<HeapHeader>()
}

/// Allocates and initializes the nested child object for a `CONSTRUCT_PLAN_PREINIT` descriptor
/// (up to 2 levels deep: e.g. `IntersectionInfo -> Color`, `OrderedCollection -> Array`, or
/// `Plan -> OrderedCollection -> Array`). Returns null if spare/recycled cells are unavailable.
@inlineNever
unsafe fn allocNestedChild(env: *mut CompiledEnv, rt: *mut HeapHeader, descPtr: *mut ConstructDesc, depth: usize) -> ?*mut HeapHeader {
  let anchor = ()
  let desc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
  let nk = desc.nestedKind
  let arrShapeOpt = desc.nestedArrayShape
  let innerRaw = desc.nestedDesc
  let initCount = u8.toUsize(desc.nestedInitCount)
  let initVals = desc.nestedInitVals
  drop desc
  if nk == NESTED_EMPTY_ARRAY {
    let zeroCount = (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)).zeroStackCount
    if zeroCount >= 240 { return Pointer.null<HeapHeader>() }
    let arrShape = match Pointer.nonNullMut<HeapHeader>(arrShapeOpt) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
    }
    return unsafe allocSpareEmptyArray(env, rt, arrShape)
  }
  if nk != NESTED_PLAIN { return Pointer.null<HeapHeader>() }
  let innerDescPtr = match Pointer.nonNullMut<u8>(innerRaw) {
    Option<*mut u8>.Some { value } => unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ConstructDesc>(value)
    Option<*mut u8>.None => { return Pointer.null<HeapHeader>() }
  }
  let idesc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, innerDescPtr)
  let innerFinalOpt = idesc.finalShapePtr
  let innerStores = idesc.stores
  let innerTail = idesc.tail
  let innerNestedKind = idesc.nestedKind
  drop idesc
  let innerFinal = match Pointer.nonNullMut<HeapHeader>(innerFinalOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  if innerNestedKind != NESTED_NONE {
    if depth >= 2 { return Pointer.null<HeapHeader>() }
    let grand = match Pointer.nonNullMut<HeapHeader>(unsafe allocNestedChild(env, rt, innerDescPtr, depth + 1)) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
    }
    let innerNode = match Pointer.nonNullMut<HeapHeader>(unsafe allocPlainCell(env, rt, innerFinal, innerStores, innerTail)) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => {
        unsafe gc.releaseDeferred(ValueBits.Object { reference: grand })
        return Pointer.null<HeapHeader>()
      }
    }
    let mut dAnchor = ()
    let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut dAnchor, innerNode)
    data.setSlotFresh(0, SlotBits.value(ValueBits.Object { reference: grand }))
    drop data
    return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(innerNode)
  }
  let innerNode = match Pointer.nonNullMut<HeapHeader>(unsafe allocPlainCell(env, rt, innerFinal, innerStores, innerTail)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  let mut dAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut dAnchor, innerNode)
  let mut s: usize = 0
  while s < innerStores {
    let val = if s < initCount { initVals[s] } else { ValueBits.Undefined }
    data.setSlotFresh(s, SlotBits.value(val))
    s = s + 1
  }
  drop data
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(innerNode)
}

/// Fast in-place recycle for a 1-level `NESTED_PLAIN` constructor (`stores == 1`, e.g.
/// `IntersectionInfo -> Color(0, 0, 0)`): scans top 6 entries of `zeroStack` for a dead young
/// plain inline outer object whose `slot[0]` is a uniquely-owned (`rc == 1`) plain inline child
/// of `innerDesc.finalShapePtr` with non-heap slots, resets the child's slots in place, releases
/// only extra outer slots `1..oldCount`, and returns the revived outer object with zero child
/// allocation or `releaseDeferred(child)`.
@inlineAlways
unsafe fn tryRecycleNestedPlain(rt: *mut HeapHeader, final: *mut HeapHeader, tail: usize, descPtr: *mut ConstructDesc) -> ?*mut HeapHeader {
  let anchor = ()
  let desc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
  let innerRaw = desc.nestedDesc
  let initCount = u8.toUsize(desc.nestedInitCount)
  let initVals = desc.nestedInitVals
  drop desc
  let innerDescPtr = match Pointer.nonNullMut<u8>(innerRaw) {
    Option<*mut u8>.Some { value } => unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ConstructDesc>(value)
    Option<*mut u8>.None => { return Pointer.null<HeapHeader>() }
  }
  let idesc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, innerDescPtr)
  let innerFinalOpt = idesc.finalShapePtr
  let innerStores = idesc.stores
  let innerTail = idesc.tail
  let innerNestedKind = idesc.nestedKind
  drop idesc
  if innerNestedKind != NESTED_NONE { return Pointer.null<HeapHeader>() }
  let innerFinal = match Pointer.nonNullMut<HeapHeader>(innerFinalOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let depth = u16.toUsize(state.zeroStackCount)
  if depth == 0 || state.gcPhase != GcPhase.None { return Pointer.null<HeapHeader>() }
  let finalAddr = Pointer.address<HeapHeader>(final)
  let innerFinalAddr = Pointer.address<HeapHeader>(innerFinal)
  let mut bestIdx = usize.MAX
  let mut sameShape = false
  let mut scan: usize = 0
  let limit = if depth < 6 { depth } else { 6 }
  while scan < limit {
    let idx = depth - 1 - scan
    let candOpt = state.zeroStack[idx]
    if !Pointer.isNull<HeapHeader>(candOpt) {
      let cand = unsafe nonnullHeader(candOpt)
      let hdr = unsafe Pointer.borrow<(), HeapHeader>(&anchor, cand)
      if hdr.kind == HeapKind.Object && hdr.young == 1 && hdr.referenceCount == 0 && hdr.mark == 1 {
        let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, cand)
        if data.classId() == classes.JS_CLASS_OBJECT && data.pristineFunction(false) && data.weakRefCount == 0
          && data.slotsInCell() && data.slotCapacity() == tail && data.slotCount() >= 1 && data.slotCount() <= 8 {
          let emptyPayload = match &data.payload { ObjectPayload.Empty => true _ => false }
          if emptyPayload {
            let oldShape = data.shape
            let isSame = Pointer.address<HeapHeader>(oldShape) == finalAddr
            if isSame || (unsafe Pointer.borrow<(), HeapHeader>(&anchor, oldShape)).referenceCount > 1 {
              match (unsafe data.slotUnchecked(0)).valueBits() {
                ValueBits.Object { reference: child } => {
                  let chdr = unsafe Pointer.borrow<(), HeapHeader>(&anchor, child)
                  if chdr.referenceCount == 1 && chdr.mark == 0 && chdr.kind == HeapKind.Object && chdr.young == 1 {
                    let cdata = unsafe HeapCell.payload<ObjectData, ()>(&anchor, child)
                    if Pointer.address<HeapHeader>(cdata.shape) == innerFinalAddr
                      && cdata.classId() == classes.JS_CLASS_OBJECT && cdata.pristineFunction(false) && cdata.weakRefCount == 0
                      && cdata.slotsInCell() && cdata.slotCapacity() == innerTail && cdata.slotCount() == innerStores {
                      let cEmpty = match &cdata.payload { ObjectPayload.Empty => true _ => false }
                      if cEmpty {
                        let mut nonHeap = true
                        let mut s: usize = 0
                        while s < innerStores {
                          if (unsafe cdata.slotUnchecked(s)).valueBits().tag() < 0 { nonHeap = false break }
                          s = s + 1
                        }
                        if nonHeap { bestIdx = idx sameShape = isSame break }
                      }
                    }
                  }
                }
                _ => ()
              }
            }
          }
        }
      }
    }
    scan = scan + 1
  }
  drop state
  if bestIdx == usize.MAX { return Pointer.null<HeapHeader>() }
  let mut stateAnchor = ()
  let stateMut = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, rt)
  let topIdx = u16.toUsize(stateMut.zeroStackCount) - 1
  let chosen = unsafe nonnullHeader(stateMut.zeroStack[bestIdx])
  if bestIdx != topIdx { stateMut.zeroStack[bestIdx] = stateMut.zeroStack[topIdx] }
  stateMut.zeroStackCount = usize.toU16(topIdx)
  drop stateMut
  let mut hdrAnchor = ()
  let hdr = unsafe Pointer.borrowMut<(), HeapHeader>(&mut hdrAnchor, chosen)
  hdr.referenceCount = 1
  hdr.mark = 0
  drop hdr
  let mut dataAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut dataAnchor, chosen)
  let oldCount = data.slotCount()
  let child = match (unsafe data.slotUnchecked(0)).valueBits() {
    ValueBits.Object { reference } => reference
    _ => { Intrinsic.trap("tryRecycleNestedPlain: slot 0 changed") }
  }
  let mut extraVals: [ValueBits; 8] = [ValueBits.Undefined; 8]
  let mut k: usize = 1
  while k < oldCount {
    extraVals[k] = (unsafe data.slotUnchecked(k)).valueBits()
    k = k + 1
  }
  if oldCount != 1 {
    let mut s = data.takeSlots()
    s.truncate(1)
    data.setSlotsFresh(move s)
  }
  let oldShape = data.shape
  if !sameShape { data.shape = final }
  drop data
  let mut cAnchor = ()
  let cdata = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut cAnchor, child)
  let mut si: usize = 0
  while si < innerStores {
    let val = if si < initCount { initVals[si] } else { ValueBits.Undefined }
    cdata.setSlotFresh(si, SlotBits.value(val))
    si = si + 1
  }
  drop cdata
  if !sameShape {
    let mut oldAnchor = ()
    let oldHdr = unsafe Pointer.borrowMut<(), HeapHeader>(&mut oldAnchor, oldShape)
    oldHdr.referenceCount = i32.wrappingSubtract(oldHdr.referenceCount, 1)
    drop oldHdr
    let mut newAnchor = ()
    let newHdr = unsafe Pointer.borrowMut<(), HeapHeader>(&mut newAnchor, final)
    newHdr.referenceCount = i32.wrappingAdd(newHdr.referenceCount, 1)
    drop newHdr
  }
  k = 1
  while k < oldCount {
    match extraVals[k] {
      ValueBits.Object { reference } => {
        let mut hAnchor = ()
        let ehdr = unsafe Pointer.borrowMut<(), HeapHeader>(&mut hAnchor, reference)
        if ehdr.referenceCount > 1 { ehdr.referenceCount = i32.wrappingSubtract(ehdr.referenceCount, 1) }
        else { drop ehdr unsafe gc.releaseDeferred(extraVals[k]) }
      }
      _ => {
        if extraVals[k].tag() < 0 { unsafe gc.releaseDeferred(extraVals[k]) }
      }
    }
    k = k + 1
  }
  unsafe census.censusBump(rt, census.CENSUS_OBJECTS_ALLOCATED, 2)
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(chosen)
}

@inlineNever
unsafe fn jitNewObjectNested(env: *mut CompiledEnv, descPtr: *mut ConstructDesc, out: *mut ValueBits) -> u32 {
  let mut finalOpt = Pointer.null<HeapHeader>()
  let status = unsafe validateConstruct(env, descPtr, &mut finalOpt)
  if status != 1 { return status }
  let anchor = ()
  let rt = unsafe nonnullHeader((unsafe Pointer.borrow<(), CompiledEnv>(&anchor, env)).runtime)
  let desc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
  let stores = desc.stores
  let tail = desc.tail
  let nestedKind = desc.nestedKind
  drop desc
  let final = unsafe nonnullHeader(finalOpt)
  if nestedKind == NESTED_PLAIN && stores == 1 {
    if let Option<*mut HeapHeader>.Some { value: reused } = Pointer.nonNullMut<HeapHeader>(unsafe tryRecycleNestedPlain(rt, final, tail, descPtr)) {
      unsafe Pointer.write<ValueBits>(out, ValueBits.Object { reference: reused })
      return 1
    }
  }
  let child = match Pointer.nonNullMut<HeapHeader>(unsafe allocNestedChild(env, rt, descPtr, 0)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => {
      unsafe Pointer.write<ValueBits>(out, ValueBits.Undefined)
      return 3
    }
  }
  let outer = match Pointer.nonNullMut<HeapHeader>(unsafe allocPlainCell(env, rt, final, stores, tail)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => {
      unsafe gc.releaseDeferred(ValueBits.Object { reference: child })
      unsafe Pointer.write<ValueBits>(out, ValueBits.Undefined)
      return 3
    }
  }
  let mut dAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut dAnchor, outer)
  data.setSlotFresh(0, SlotBits.value(ValueBits.Object { reference: child }))
  drop data
  unsafe Pointer.write<ValueBits>(out, ValueBits.Object { reference: outer })
  return 1
}

export "C" fn jitNewObject(env: *mut CompiledEnv, descPtr: *mut ConstructDesc, out: *mut ValueBits) -> u32 {
  let anchor = ()
  if (unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)).nestedKind != NESTED_NONE {
    return unsafe jitNewObjectNested(env, descPtr, out)
  }
  let mut finalOpt = Pointer.null<HeapHeader>()
  let status = unsafe validateConstructSimple(env, descPtr, &mut finalOpt)
  if status != 1 { return status }
  let rt = unsafe nonnullHeader((unsafe Pointer.borrow<(), CompiledEnv>(&anchor, env)).runtime)
  let desc = unsafe Pointer.borrow<(), ConstructDesc>(&anchor, descPtr)
  let stores = desc.stores
  let tail = desc.tail
  drop desc
  let final = unsafe nonnullHeader(finalOpt)
  if let Option<*mut HeapHeader>.Some { value: node } = Pointer.nonNullMut<HeapHeader>(unsafe allocPlainCell(env, rt, final, stores, tail)) {
    unsafe Pointer.write<ValueBits>(out, ValueBits.Object { reference: node })
    return 1
  }
  // Guards passed; only spare/recyclable cells were unavailable. Signal the non-deopting
  // planned-constructor slow path instead of deopting and backing out the function.
  unsafe Pointer.write<ValueBits>(out, ValueBits.Undefined)
  return 3
}
