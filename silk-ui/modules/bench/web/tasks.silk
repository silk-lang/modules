import silk.build.graph { BuildError, Compilation, Deferred, Options }
import silk.build.options { Optimize }
import silk.build.tasks { Standard, StandardError }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator }
import silk.num.usize
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { FileSystem, Path }
import silk.system.host_input { HostInput }
import silk.text.string { InvalidUtf8, String }

union Tasks {
  Build { pub options: Options, pub out: String },
  Run { pub options: Options, pub arguments: List<String> },
  Dev { pub options: Options, pub arguments: List<String> },
  Plan { pub options: Options },
  BuildBenchmark { pub checkout: String, pub size: bool, pub prerender: bool },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Build and run the benchmark")
      |> Command.variant("Build", "Build the program into build/ (--release optimizes)")
      |> Command.variant("Run", "Build the program and run it")
      |> Command.variant("Dev", "Run the program, and run it again when a source changes")
      |> Command.variant("Plan", "Write the editor's compilation requests")
      |> Command.variant("BuildBenchmark", "Build the entry into a js-framework-benchmark checkout")
      |> Command.flatten("options")
      |> Command.option("out", Opt.about("Also copy the program to this directory"))
      |> Command.arg("arguments", Opt.about("The program's arguments, after --"))
      |> Command.arg("checkout", Opt.about("Path to js-framework-benchmark checkout"))
      |> Command.option("size", Opt.about("Optimize wasm for size instead of speed"))
      |> Command.option("prerender", Opt.about("Prerender the initial shell into index.html"))
  }
}

effect fn compilation(options: &Options) -> Compilation
  ! BuildError
  ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let selected = run Compilation.fromPackage(options)
  if options.target.length() == 1 {
    if String.startsWith(options.target.asSlice()[0].view(), "wasm") {
      return run selected.stackSize(run Deferred<u64>.value(262144))
    }
  }
  return move selected
}

effect fn copyFile(src: &Path, dst: &Path) -> ()
  ! StandardError
  ? &mut Allocator | &mut FileSystem {
  let bytes = run FileSystem.readFile(src)
  return run FileSystem.writeFile(dst, Bytes.asSlice(&bytes))
}

effect fn buildBenchmark(checkout: string, size: bool, prerender: bool) -> ()
  ! StandardError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  if checkout == "" {
    run Task.abort("Pass the js-framework-benchmark checkout directory")
  }
  let opt = if size {
    Optimize.Size
  } else {
    Optimize.Speed
  }
  let options = Options.make()
  let base = run Compilation.fromPackage(&options)
  let targeted = run base.target(
    run Deferred<String>.value(run String.copy("wasm32-unknown-unknown")),
  )
  let optimized = run targeted.optimize(run Deferred<Optimize>.value(opt))
  let stripped = run optimized.debug(run Deferred<bool>.value(false))
  let sized = run stripped.stackSize(run Deferred<u64>.value(262144))
  let built = run sized.build()
  let artifacts = built.artifacts.asSlice()
  if artifacts.length == usize.ZERO {
    run Task.abort("ui-bench-web produced no wasm artifact")
  }

  let mut shellBytes = Bytes.make()
  if prerender {
    let hostComp = run Compilation.fromPackage(&options)
    let hostBuilt = run hostComp.build()
    let hostArts = hostBuilt.artifacts.asSlice()
    if hostArts.length == usize.ZERO {
      run Task.abort("ui-bench-web host build produced no binary")
    }
    let mut req = run ChildProcess.request(&hostArts[0].path)
    run ChildProcess.addArgument(&mut req, "shell")
    let out = run ChildProcess.submit(&req)
    if ChildProcess.exitCode(&out).unwrapOr(-1) != 0 {
      run Task.abort("ui-bench-web shell prerender failed")
    }
    shellBytes = run Bytes.copy(ChildProcess.outputBytes(&out))
  }

  let here = run Task.root()
  let benchDir = match move run Path.parent(&here) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort("bench/web has no parent")
  }
  let modulesDir = match move run Path.parent(&benchDir) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort("bench has no modules parent")
  }
  let uiDir = match move run Path.parent(&modulesDir) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort("modules has no silk-ui parent")
  }
  let repoRoot = match move run Path.parent(&uiDir) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort("silk-ui has no monorepo parent")
  }

  let checkoutPath = run Path.make(checkout)
  let target = run Path.join(&checkoutPath, "frameworks/keyed/silk-ui")
  let dist = run Path.join(&target, "dist")
  run FileSystem.createDirectoriesRecursively(&dist)

  run copyFile(&run Path.join(&here, "page/package.json"), &run Path.join(&target, "package.json"))
  run copyFile(
    &run Path.join(&here, "page/package-lock.json"),
    &run Path.join(&target, "package-lock.json"),
  )

  let htmlRaw = run FileSystem.readFile(&run Path.join(&here, "page/index.html"))
  let htmlText = match String.fromUtf8(Bytes.asSlice(&htmlRaw)) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { .. } => run Task.abort("page/index.html is not UTF-8")
  }
  let marker = "<!--shell-->"
  let mut htmlOut = Bytes.make()
  match String.find(htmlText, marker) {
    Option<usize>.Some { value: idx } => {
      run Bytes.append(&mut htmlOut, String.utf8Bytes(String.slice(htmlText, usize.ZERO, idx)))
      run Bytes.append(&mut htmlOut, Bytes.asSlice(&shellBytes))
      let after = idx + String.utf8Bytes(marker).length
      run Bytes.append(
        &mut htmlOut,
        String.utf8Bytes(String.slice(htmlText, after, String.utf8Bytes(htmlText).length - after)),
      )
    }
    Option<usize>.None => run Bytes.append(&mut htmlOut, Bytes.asSlice(&htmlRaw))
  }
  run FileSystem.writeFile(&run Path.join(&target, "index.html"), Bytes.asSlice(&htmlOut))
  run copyFile(&artifacts[0].path, &run Path.join(&dist, "bench.wasm"))
  let domJs = run Path.join(&repoRoot, "loom/modules/loom/dom/js/silk-ui-dom.js")
  return run copyFile(&domJs, &run Path.join(&dist, "silk-ui-dom.js"))
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! StandardError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Build { options, out } => run Standard.build(run compilation(&options), out.view())
      Tasks.Run { options, arguments } => {
        run Standard.start(run compilation(&options), &options, &arguments)
      }
      Tasks.Dev { options, arguments } => run Standard.dev(&options, &arguments)
      Tasks.Plan { options } => run Standard.plan(run compilation(&options))
      Tasks.BuildBenchmark { checkout, size, prerender } => {
        run buildBenchmark(checkout.view(), size, prerender)
      }
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
