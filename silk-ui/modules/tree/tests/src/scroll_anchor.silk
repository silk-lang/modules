//! Scroll anchoring (`overflow-anchor`): content that changes size above what a scrolled
//! container shows leaves what it shows in place. Each expectation is what Chromium does with
//! the same markup (a 200px tall container of 50px rows).
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, FrameInput, Input, Mutation }
import ui_fixtures.fixtures as fixtures
import svg_css.written
import svg_css.tokens { CssError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

const FRAME: FrameInput = FrameInput { width: 300.0, height: 300.0, scale: 1.0, time: 0.0 }

effect fn styled(batch: &mut Batch, id: u32, css: &[u8]) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let declarations = run written.declarations(css)
  run batch.style(id, declarations.asSlice())
}

/// Scroll container 2 (200px tall, styled with `extra`) holding wrapper 3 with rows 10 to 29,
/// 50px each, scrolled to `y`.
effect fn rows<'f>(tree: &mut UiTree<'f>, extra: &[u8], y: f32) -> ()
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run styled(&mut batch, 1, b"display:block;width:300px;height:300px")
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run styled(&mut batch, 2, b"display:block;width:200px;height:200px;overflow-y:auto")
  run styled(&mut batch, 2, extra)
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  run styled(&mut batch, 3, b"display:block")
  let mut id: u32 = 10
  while id < 30 {
    run batch.create(id, NodeKind.Box)
    run batch.append(3, id)
    run styled(&mut batch, id, b"display:block;height:50px")
    id = id + 1
  }
  run tree.apply(run batch.take())
  run tree.frame(FRAME)
  if y != 0.0 {
    run scrollTo(&mut tree, y)
  }
}

effect fn scrollTo<'f>(tree: &mut UiTree<'f>, y: f32) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut scroll = Batch.make()
  run scroll.scrollTo(2, 0.0, y)
  run tree.apply(run scroll.take())
  run tree.frame(FRAME)
}

/// Inserts a `height` tall row (id 9) before row 10.
effect fn insertAbove<'f>(tree: &mut UiTree<'f>, height: &[u8]) -> ()
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(9, NodeKind.Box)
  run batch.insertBefore(3, 9, 10)
  run styled(&mut batch, 9, height)
  run tree.apply(run batch.take())
}

effect fn restyle<'f>(tree: &mut UiTree<'f>, id: u32, css: &[u8]) -> ()
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run styled(&mut batch, id, css)
  run tree.apply(run batch.take())
}

effect fn insertedAbove(extra: &[u8], y: f32) -> f32
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run rows(&mut tree, extra, y)
  run insertAbove(&mut tree, b"display:block;height:30px")
  run tree.frame(FRAME)
  return tree.scrollOffset(2).y
}

effect fn anchoring() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run Testing.expect((run insertedAbove(b"display:block", 0.0)) == 0.0, "nothing anchors at offset zero")
  run Testing.expect((run insertedAbove(b"display:block", 100.0)) == 130.0, "a row inserted above moves the offset by its height")
  run Testing.expect((run insertedAbove(b"overflow-anchor:none", 100.0)) == 100.0, "overflow-anchor: none on the container turns it off")

  let fonts = run fixtures.fonts()

  // Opting out a box leaves its subtree out: with the wrapper out, nothing is left to anchor.
  let mut wrapper = run UiTree.make(&fonts)
  run rows(&mut wrapper, b"display:block", 0.0)
  run restyle(&mut wrapper, 3, b"display:block;overflow-anchor:none")
  run scrollTo(&mut wrapper, 100.0)
  run insertAbove(&mut wrapper, b"display:block;height:30px")
  run wrapper.frame(FRAME)
  run Testing.expect(wrapper.scrollOffset(2).y == 100.0, "overflow-anchor: none on the wrapper leaves nothing to anchor")

  // Opting out the first visible row: the next one anchors.
  let mut row = run UiTree.make(&fonts)
  run rows(&mut row, b"display:block", 0.0)
  run restyle(&mut row, 12, b"display:block;height:50px;overflow-anchor:none")
  run scrollTo(&mut row, 100.0)
  run restyle(&mut row, 12, b"display:block;height:80px;overflow-anchor:none")
  run row.frame(FRAME)
  run Testing.expect(row.scrollOffset(2).y == 130.0, "the next row anchors when the first opts out")

  // A row above that grows; a partially visible anchor that grows keeps its top.
  let mut grow = run UiTree.make(&fonts)
  run rows(&mut grow, b"display:block", 125.0)
  run restyle(&mut grow, 11, b"display:block;height:80px")
  run grow.frame(FRAME)
  run Testing.expect(grow.scrollOffset(2).y == 155.0, "a row above growing by 30px moves the offset by 30px")
  let mut partial = run UiTree.make(&fonts)
  run rows(&mut partial, b"display:block", 110.0)
  run restyle(&mut partial, 12, b"display:block;height:80px")
  run partial.frame(FRAME)
  run Testing.expect(partial.scrollOffset(2).y == 110.0, "the partially visible anchor growing moves nothing")

  // Removing a row above scrolls back by its height.
  let mut removed = run UiTree.make(&fonts)
  run rows(&mut removed, b"display:block", 100.0)
  let mut batch = Batch.make()
  run batch.push(Mutation.Remove { id: 10 })
  run removed.apply(run batch.take())
  run removed.frame(FRAME)
  run Testing.expect(removed.scrollOffset(2).y == 50.0, "removing a row above moves the offset back")

  // A layout change to the anchor itself suppresses the adjustment.
  let mut suppressed = run UiTree.make(&fonts)
  run rows(&mut suppressed, b"display:block", 100.0)
  run insertAbove(&mut suppressed, b"display:block;height:30px")
  run restyle(&mut suppressed, 12, b"display:block;height:50px;margin-top:5px")
  run suppressed.frame(FRAME)
  run Testing.expect(suppressed.scrollOffset(2).y == 100.0, "a margin change on the anchor suppresses anchoring")

  // The anchor holds over successive layouts.
  let mut twice = run UiTree.make(&fonts)
  run rows(&mut twice, b"display:block", 100.0)
  run insertAbove(&mut twice, b"display:block;height:30px")
  run twice.frame(FRAME)
  let mut more = Batch.make()
  run more.create(8, NodeKind.Box)
  run more.insertBefore(3, 8, 9)
  run styled(&mut more, 8, b"display:block;height:20px")
  run twice.apply(run more.take())
  run twice.frame(FRAME)
  run Testing.expect(twice.scrollOffset(2).y == 150.0, "a second insertion moves the offset again")

  // A wheel scroll moves the anchor: content inserted right after still keeps the view.
  let mut wheel = run UiTree.make(&fonts)
  run rows(&mut wheel, b"display:block", 100.0)
  run wheel.dispatch(Input.Wheel { x: 50.0, y: 50.0, deltaX: 0.0, deltaY: 100.0, modifiers: 0 })
  run insertAbove(&mut wheel, b"display:block;height:30px")
  run wheel.frame(FRAME)
  run Testing.expect(wheel.scrollOffset(2).y == 230.0, "after a wheel scroll the row now in view anchors")
}

test effect fn scrollAnchoringKeepsTheVisibleContentStill() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run anchoring() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// A scrolled container whose slot is past the end of the node table once removing most of
/// the tree trims it, as a Vite reload does.
effect fn trimmedAway() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run styled(&mut batch, 1, b"display:block;width:300px;height:300px")
  let mut filler: u32 = 100
  while filler < 1300 {
    run batch.create(filler, NodeKind.Box)
    run batch.append(1, filler)
    filler = filler + 1
  }
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run styled(&mut batch, 2, b"display:block;width:200px;height:200px;overflow-y:auto")
  let mut id: u32 = 10
  while id < 30 {
    run batch.create(id, NodeKind.Box)
    run batch.append(2, id)
    run styled(&mut batch, id, b"display:block;height:50px")
    id = id + 1
  }
  run tree.apply(run batch.take())
  run tree.frame(FRAME)
  run scrollTo(&mut tree, 100.0)
  let mut gone = Batch.make()
  run gone.push(Mutation.Destroy { id: 2 })
  filler = 100
  while filler < 1300 {
    run gone.push(Mutation.Destroy { id: filler })
    filler = filler + 1
  }
  run tree.apply(run gone.take())
  run tree.frame(FRAME)
  run Testing.expect(tree.scrollOffset(1).y == 0.0, "the frame after the trim lays out")
}

test effect fn aScrolledContainerTrimmedFromTheTreeIsForgotten() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run trimmedAway() |> Effect.provideMut<Allocator>(&mut allocator)
}
