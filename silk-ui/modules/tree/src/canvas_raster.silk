//! Large canvases drawn once: a canvas node with many commands is drawn into a bitmap, which the
//! window shows through a surface, and paint then emits one sprite for it instead of a quad or
//! path per command.
//!
//! Paint asks for a bitmap ([`Want`]) each time it draws the commands of a canvas with at least
//! [`MIN_COMMANDS`] of them. A window host waits for the canvas to settle and rasterizes a
//! snapshot ([`Job`]) off the UI thread (`ui_tree_window.canvas_bitmaps`), discarding stale
//! results if the canvas changed in the meantime; a synchronous caller can still call
//! [`UiTree.rasterCanvases`]. The window presents each bitmap and tells the tree
//! ([`UiTree.showRaster`]); from then on paint shows the sprite while the node's content, the
//! scale and the content box's place within a device pixel stay the same.
//!
//! A bitmap covers the commands' ink in device pixels and starts on a whole device pixel, so
//! the sprite samples it one to one.
import ui_protocol.mutation { CanvasCommand }
import vector.pixmap { Pixmap }
import silk.collections.hash { Hash, HashSeed }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.num.f32
import silk.num.u32
import silk.num.u64

/// The fewest commands of a canvas paint draws through a bitmap.
pub const MIN_COMMANDS: usize = 256

/// The largest side of a bitmap, in device pixels: a larger canvas draws its commands.
pub const MAX_SIDE: f32 = 8192.0

/// What a bitmap of canvas commands is drawn for: the node's `content` revision, the device
/// scale, and where the content box's corner falls within a device pixel.
pub fn key(seed: &HashSeed, content: u64, scale: f32, fx: f32, fy: f32) -> u64 {
  let mut h = Hash.mix(seed, content)
  h = Hash.combine(h, u32.toU64(f32.toBits(scale)))
  h = Hash.combine(h, u32.toU64(f32.toBits(fx)))
  h = Hash.combine(h, u32.toU64(f32.toBits(fy)))
  // Never 0, which `CanvasRaster` uses for none.
  return if h == 0 { 1 } else { h }
}

/// A bitmap paint asked for: canvas node `node` (an id) at content revision `content`.
pub struct Want {
  pub node: u32,
  pub key: u64,
  pub content: u64,
  pub scale: f32,
  pub fx: f32,
  pub fy: f32,
}

impl Copy for Want {}

/// A bitmap drawn for canvas node `node`, at `x`, `y` device pixels from the device pixel
/// of the content box's corner, waiting for the window to present it.
pub struct Frame {
  pub node: u32,
  pub key: u64,
  pub content: u64,
  pub x: i32,
  pub y: i32,
  pub pixels: Pixmap,
}

/// Owned command snapshot and geometry to draw one canvas bitmap off the UI thread
/// (see [`UiTree.prepareRasterJob`]).
pub struct Job {
  pub node: u32,
  pub key: u64,
  pub content: u64,
  pub scale: f32,
  pub dx: f32,
  pub dy: f32,
  pub x: i32,
  pub y: i32,
  pub width: u32,
  pub height: u32,
  pub commands: List<CanvasCommand>,
}

/// Cooperative cancellation check polled while rasterizing a large canvas's commands.
pub interface CancelCheck {
  fn cancelled(self: &Self) -> bool
}

/// A [`CancelCheck`] that never cancels, for synchronous rasterization.
pub struct NeverCancel {}

impl CancelCheck for NeverCancel {
  fn cancelled(self: &Self) -> bool {
    return false
  }
}

/// A canvas node with a bitmap surface, so the window can close the surface once the node is gone.
pub struct Live {
  pub node: u32,
  pub surface: u32,
}

impl Copy for Live {}

pub struct CanvasRasters {
  pub wants: List<Want>,
  pub frames: List<Frame>,
  pub live: List<Live>,
}

impl CanvasRasters {
  pub fn make() -> CanvasRasters {
    return CanvasRasters { wants: List<Want>.make(), frames: List<Frame>.make(), live: List<Live>.make() }
  }

  /// The surface of canvas node `node`'s bitmap, or `none`.
  pub fn surfaceOf(self: &Self, node: u32, none: u32) -> u32 {
    let live = self.live.asSlice()
    let mut i: usize = 0
    while i < live.length {
      if live[i].node == node { return live[i].surface }
      i = i + 1
    }
    return none
  }
}

/// The device pixels `commands` draw into, from the device pixel of the content box's corner,
/// when a command point (x, y) lands at (x * scale + fx, y * scale + fy). Empty when they draw
/// nothing.
pub fn ink(commands: &[CanvasCommand], scale: f32, fx: f32, fy: f32) -> Rect<f32> {
  let mut area = Rect<f32>.new(f32.MAX, f32.MAX, 0.0 - f32.MAX, 0.0 - f32.MAX)
  let mut path = Rect<f32>.new(f32.MAX, f32.MAX, 0.0 - f32.MAX, 0.0 - f32.MAX)
  let mut i: usize = 0
  while i < commands.length {
    match commands[i] {
      CanvasCommand.FillRect { x, y, width, height, radius: _, color } => {
        if width > 0.0 && height > 0.0 && color.a > 0.0 {
          area = joined(area, Rect<f32>.new(x, y, x + width, y + height), 0.0)
        }
      }
      CanvasCommand.MoveTo { x, y } => { path = point(path, x, y) }
      CanvasCommand.LineTo { x, y } => { path = point(path, x, y) }
      CanvasCommand.QuadTo { x1, y1, x, y } => { path = point(point(path, x1, y1), x, y) }
      CanvasCommand.CubicTo { x1, y1, x2, y2, x, y } => { path = point(point(point(path, x1, y1), x2, y2), x, y) }
      CanvasCommand.Close => {}
      CanvasCommand.Fill { color: _ } => {
        area = joined(area, path, 0.0)
        path = Rect<f32>.new(f32.MAX, f32.MAX, 0.0 - f32.MAX, 0.0 - f32.MAX)
      }
      CanvasCommand.Stroke { color: _, width } => {
        // Miter joins reach past the line by up to twice its width.
        area = joined(area, path, width * 2.0)
        path = Rect<f32>.new(f32.MAX, f32.MAX, 0.0 - f32.MAX, 0.0 - f32.MAX)
      }
    }
    i = i + 1
  }
  if area.xMin > area.xMax { return Rect<f32>.new(0.0, 0.0, 0.0, 0.0) }
  // A pixel more on each side for antialiased edges.
  return Rect<f32>.new(
    f32.floor(area.xMin * scale + fx) - 1.0,
    f32.floor(area.yMin * scale + fy) - 1.0,
    f32.ceil(area.xMax * scale + fx) + 1.0,
    f32.ceil(area.yMax * scale + fy) + 1.0,
  )
}

fn point(r: Rect<f32>, x: f32, y: f32) -> Rect<f32> {
  return Rect<f32>.new(f32.min(r.xMin, x), f32.min(r.yMin, y), f32.max(r.xMax, x), f32.max(r.yMax, y))
}

fn joined(a: Rect<f32>, b: Rect<f32>, out: f32) -> Rect<f32> {
  if b.xMin > b.xMax { return a }
  return Rect<f32>.new(
    f32.min(a.xMin, b.xMin - out),
    f32.min(a.yMin, b.yMin - out),
    f32.max(a.xMax, b.xMax + out),
    f32.max(a.yMax, b.yMax + out),
  )
}
