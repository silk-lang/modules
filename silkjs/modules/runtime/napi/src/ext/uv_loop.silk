//! The native handle loop, in Silk: what the runtime used libuv's loop for. A loop owns a kernel
//! queue (epoll on Linux, kqueue on Darwin) and the handles that wait on it: async wakeups, signal
//! watchers, child processes, descriptor polls (child IPC sockets), file-system event watchers and
//! file-system stat polls. The functions keep libuv's names, statuses and ordering, so a caller
//! reads as it did against libuv 1.51: handles are caller-allocated (`uv_handle_size`), start
//! referenced, and a closed handle gets its close callback in the closing phase of a later run.
//!
//! One iteration of `uv_run` is: update the clock, run due timers, wait on the kernel queue (not at
//! all for `UV_RUN_NOWAIT`), dispatch what it reported, run close callbacks. Callbacks are
//! `extern "C"` functions and run only inside `uv_run`, on the thread that runs the loop.
//! `uv_async_send` is the only function another thread, or a signal handler, may call.
//!
//! Signals follow libuv: one process-wide handler writes a message into the pipe of every loop that
//! watches the signal, under a spin lock that non-handler code takes with all signals blocked.
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.isize
import silk.num.u16
import silk.num.u8
import silk.core.ownership { Copy }
import silkjsruntime.ext.uv_fs { UvStat, UvTimespec }
import silk.concurrency.atomic { CompareExchange }
import ext.uv_shapes { Options, Stdio }
import ext.uv_os
import ext.uv_fsevents as fsevents
import ext.uv_spawn_darwin as spawn_darwin

pub type CloseCallback = extern "C" fn(*mut u8) -> ()
pub type AsyncCallback = extern "C" fn(*mut u8) -> ()
pub type SignalCallback = extern "C" fn(*mut u8, i32) -> ()
pub type PollCallback = extern "C" fn(*mut u8, i32, i32) -> ()
pub type ExitCallback = extern "C" fn(*mut u8, i64, i32) -> ()
pub type FsEventCallback = extern "C" fn(*mut u8, ?*const u8, i32, i32) -> ()
pub type FsPollCallback = extern "C" fn(*mut u8, i32, *const UvStat, *const UvStat) -> ()
pub type WalkCallback = extern "C" fn(*mut u8, *mut u8) -> ()

// libuv's handle kinds (uv_handle_type), which Node reports by name.
pub const UV_ASYNC: i32 = 1
pub const UV_CHECK: i32 = 2
pub const UV_FS_EVENT: i32 = 3
pub const UV_FS_POLL: i32 = 4
pub const UV_IDLE: i32 = 6
pub const UV_POLL: i32 = 8
pub const UV_PREPARE: i32 = 9
pub const UV_PROCESS: i32 = 10
pub const UV_TIMER: i32 = 13
pub const UV_SIGNAL: i32 = 16
pub const UV_RUN_DEFAULT: i32 = 0
pub const UV_RUN_ONCE: i32 = 1
pub const UV_RUN_NOWAIT: i32 = 2

const ACTIVE: u32 = 1
const REFERENCED: u32 = 2
const CLOSING: u32 = 4
const CLOSED: u32 = 8
// A handle of the loop itself (the child watcher): uv_walk does not report it.
const INTERNAL: u32 = 16
// A handle that stands for a Node-API addon's own libuv record (ext.uv_api_loop): `data` points at
// that record, and uv_walk reports the record.
const ADDON: u32 = 32
// A signal watcher started with uv_signal_start_oneshot.
const ONESHOT: u32 = 64
// A timer that is due and waits on the ready list of the running uv__run_timers.
const READY: u32 = 128
// A timer that has a callback (libuv's handle->timer_cb != NULL), for uv_timer_again.
const HAS_CALLBACK: u32 = 256
// A descriptor handle of another module (a TCP, pipe, TTY or UDP handle of ext.uv_api_stream): the
// loop watches its descriptor and calls back, and the module decides when it is active.
const IO: u32 = 512

const TAG_WAKE: u64 = 1
const TAG_SIGNAL: u64 = 2
const TAG_INOTIFY: u64 = 3

