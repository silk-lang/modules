import silk.build.plan { Library, Plan }
import silk.build.step { sourcePath }

static fn plan() -> Plan {
  let mut plan = Plan.empty()
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan
      |> Plan.compileNative(
        "c",
        sourcePath("native/uia.c"),
        &[
          "-O2",
          "-Wall",
          "-Wextra",
          "-Werror",
          "-Wno-unused-parameter",
          "-ffreestanding",
          "-fno-builtin",
          "-fno-stack-protector",
        ],
        &[],
      )
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkLibrary("uiautomationcore", Library.dynamicSearch())
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkLibrary("oleaut32", Library.dynamicSearch())
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkLibrary("user32", Library.dynamicSearch())
  }
  return plan
}

pub const PLAN: Plan = plan()
