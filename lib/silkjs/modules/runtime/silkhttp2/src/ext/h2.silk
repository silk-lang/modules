  }
  unsafe setState(sp, IB_IGN_PAYLOAD)
  return 2
}
// HEADERS once its padding and priority are read.
unsafe fn afterHeadersHead(sp: *mut Session) -> i32 {
  let rv = unsafe processHeadersFrame(sp)
  if isFatal(rv) { return rv }
  if unsafe state(sp) == IB_IGN_ALL { return 1 }
  if rv == ERR_TEMPORAL_CALLBACK_FAILURE {
