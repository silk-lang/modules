 context object. (Thus the active range may be null.)\x22\x0a//\x0a// We cheat and return globalRange if that's defined.  We also ensure that the\x0a// active range meets the requirements that selection boundary points are\x0a// supposed to meet, i.e., that the nodes are both Text or Element nodes that\x0a// descend from a Document.\x0a// \x22The active range is the range of the selection given by calling\x0a// getSelection() on the context object. (Thus the active range may be null.)\x22\x0a// While a command runs, the range it first read stays the active range: the algorithms\x0a// below move it alongside each change they make to the selection (as the reference\x0a// implementation does), and the selection takes it when the command ends.\x0afunction getActiveRange() {\x0a    if (globalRange) {\x0a        return globalRange;\x0a    }\x0a    var selection = getSelection();\x0a    var range = selection.rangeCount ? selection.getRangeAt(0) : null;\x0a    if (commandDepth > 0) {\x0a        globalRange = range;\x0a    }\x0a    return range;\x0a}\x0a\x0a// \x22For some commands, each HTMLDocument must have a boolean state override\x0a// and/or a string value override. These do not change the command's state or\x0a// value, but change the way some algorithms behave, as specified in those\x0a// algorithms' definitions. Initially, both must be unset for every command.\x0a// Whenever the number of ranges in the Selection changes to something\x0a// different, and whenever a boundary point of the range at a given index in\x0a// the Selection changes to something different, the state override and value\x0a// override must be unset for every command.\x22\x0a//\x0a// We implement this crudely by using setters and getters.  To verify that the\x0a// selection hasn't changed, we copy the active range and just check the\x0a// endpoints match.  This isn't really correct, but it's good enough for us.\x0a// Unset state/value overrides are undefined.  We put everything in a function\x0a// so no one can access anything except via the provided functions, since\x0a// otherwise callers might mistakenly use outdated overrides (if the selection\x0a// has changed).\x0avar getStateOverride, setStateOverride, unsetStateOverride,\x0a    getValueOverride, setValueOverride, unsetValueOverride;\x0a(function() {\x0a    var stateOverrides = {};\x0a    var valueOverrides = {};\x0a    var storedRange = null;\x0a\x0a    function resetOverrides() {\x0a        if (!storedRange\x0a        || storedRange.startContainer != getActiveRange().startContainer\x0a        || storedRange.endContainer != getActiveRange().endContainer\x0a        || storedRange.startOffset != getActiveRange().startOffset\x0a        || storedRange.endOffset != getActiveRange().endOffset) {\x0a            stateOverrides = {};\x0a            valueOverrides = {};\x0a            storedRange = getActiveRange().cloneRange();\x0a        }\x0a    }\x0a\x0a    getStateOverride = function(command) {\x0a        resetOverrides();\x0a        return stateOverrides[command];\x0a    };\x0a\x0a    setStateOverride = function(command, newState) {\x0a        resetOverrides();\x0a        stateOverrides[command] = newState;\x0a    };\x0a\x0a    unsetStateOverride = function(command) {\x0a        resetOverrides();\x0a        delete stateOverrides[command];\x0a    }\x0a\x0a    getValueOverride = function(command) {\x0a        resetOverrides();\x0a        return valueOverrides[command];\x0a    }\x0a\x0a    // \x22The value override for the backColor command must be the same as the\x0a    // value override for the hiliteColor command, such that setting one sets\x0a    // the other to the same thing and unsetting one unsets the other.\x22\x0a    setValueOverride = function(command, newValue) {\x0a        resetOverrides();\x0a        valueOverrides[command] = newValue;\x0a        if (command == \x22backcolor\x22) {\x0a            valueOverrides.hilitecolor = newValue;\x0a        } else if (command == \x22hilitecolor\x22) {\x0