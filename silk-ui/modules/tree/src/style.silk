              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.TextWrapStyle => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            if word == Keyword.Auto || word == Keyword.Stable || word == Keyword.AvoidOrphans {
              self.text.textWrapStyle = TextWrapStyle.Auto
            } else if word == Keyword.Balance {
              self.text.textWrapStyle = TextWrapStyle.Balance
            } else if word == Keyword.Pretty {
              self.text.textWrapStyle = TextWrapStyle.Pretty
            }
          }
          Option.None => {}
        }
      }
      CssProperty.WhiteSpaceCollapse => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.whiteSpaceCollapseOf(word) {
              Option.Some { value: found } => {
                self.text.whiteSpaceCollapse = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.TextJustify => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.textJustifyOf(word) {
              Option.Some { value: found } => {
                self.text.textJustify = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.TextAlignAll => { self.set(CssProperty.TextAlign, value, &context) }
      CssProperty.TextAlign => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.textAlignOf(word) {
              Option.Some { value: found } => {
                self.text.align = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.Direction => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.directionOf(word) {
              Option.Some { value: found } => {
                self.text.direction = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.FontStyle => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.fontStyleOf(word) {
              Option.Some { value: found } => {
                self.text.style = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.ObjectFit => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.objectFitOf(word) {
              Option.Some { value: found } => {
                self.paint.objectFit = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.JustifyContent => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.justifyContent = found.align
            self.layout.justifyContentSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.AlignItems => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.alignItems = found.align
            self.layout.alignItemsSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.AlignSelf => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.alignSelf = found.align
            self.layout.alignSelfSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.AlignContent => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.alignContent = found.align
            self.layout.alignContentSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.JustifySelf => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.justifySelf = found.align
            self.layout.justifySelfSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.JustifyItems => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.justifyItems = found.align
            self.layout.justifyItemsSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.ScrollbarGutter => {
        match convert.scrollbarGutter(value) {
          Option.Some { value: found } => {
            self.layout.scrollbarGutter = found
          }
          Option.None => {}
        }
      }
      CssProperty.AlignmentBaseline => { self.set(CssProperty.VerticalAlign, value, &context) }
      CssProperty.BaselineShift => {
        if let Option.Some { value: found } = convert.verticalAlign(value, &context) {
          // A zero shift leaves the independently selected alignment baseline.
          if found.kind != VerticalAlignKind.Shift || found.shift.value != 0.0 || found.shift.percent != 0.0 {
            self.layout.verticalAlign = found
          }
        }
      }
      CssProperty.VerticalAlign => {
        match convert.verticalAlign(value, &context) {
          Option.Some { value: found } => {
            self.layout.verticalAlign = found
          }
          Option.None => {}
        }
      }
      CssProperty.TextBox => {
        match convert.textBox(value) {
          Option.Some { value: found } => {
            self.layout.textBoxTrim = found.trim
            self.text.textBoxEdge = found.edge
          }
          Option.None => {}
        }
      }
      CssProperty.TextBoxTrim => {
        match convert.textBoxTrim(value) {
          Option.Some { value: found } => {
            self.layout.textBoxTrim = found
          }
          Option.None => {}
        }
      }
      CssProperty.TextBoxEdge => {
        match convert.textBoxEdge(value) {
          Option.Some { value: found } => {
            self.text.textBoxEdge = found
          }
          Option.None => {}
        }
      }
      CssProperty.TextIndent => {
        match convert.textIndent(value, &context) {
          Option.Some { value: found } => {
            self.text.textIndent = found
          }
          Option.None => {}
        }
      }
      CssProperty.TabSize => {
        match convert.tabSize(value, &context) {
          Option.Some { value: found } => {
            self.text.tabSize = found
          }
          Option.None => {}
        }
      }
      CssProperty.LineHeight => {
        match convert.lineHeight(value, &context) {
          Option.Some { value: found } => {
            self.text.lineHeight = found
          }
          Option.None => {}
        }
      }
      CssProperty.TextDecorationLine => {
        match convert.decorationLine(value) {
          Option.Some { value: found } => {
            self.text.decoration = found
          }
          Option.None => {}
        }
      }
      CssProperty.FlexGrow => {
        match convert.number(value) {
          Option.Some { value: found } => {
            self.layout.flexGrow = found
          }
          Option.None => {}
        }
      }
      CssProperty.FlexShrink => {
        match convert.number(value) {
          Option.Some { value: found } => {
            self.layout.flexShrink = found
          }
          Option.None => {}
        }
      }
      CssProperty.Visibility => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.visibilityOf(word) {
              Option.Some { value: found } => {
                self.text.visibility = found
                self.text.visible = found == Visibility.Visible
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      // Numbers.
      CssProperty.Order => {
        match convert.number(value) {
          Option.Some { value: found } => {
            self.layout.order = f32.toI32(f32.round(found))
          }
          Option.None => {}
        }
      }
      // Multi-column layout.
      CssProperty.ColumnCount => {
        if convert.isKeyword(value, Keyword.Auto) {
          self.layout.columnCount = 0
        } else if let Option.Some { value: found } = convert.number(value) {
          if found >= 1.0 {
            self.layout.columnCount = f32.toU32(f32.round(f32.min(found, 1000.0)))
          }
        }
      }
      CssProperty.ColumnWidth => {
        if convert.isKeyword(value, Keyword.Auto) {
          self.layout.columnWidth = -1.0
        } else if let Option.Some { value: found } = convert.dimension(value, &context) {
          if found.kind == DimensionKind.Length && found.value >= 0.0 {
            self.layout.columnWidth = found.value
          }
        }
      }
      CssProperty.ColumnFill => {
        if let Option.Some { value: word } = convert.keywordOf(value) {
          if let Option.Some { value: found } = keyword_enums.columnFillOf(word) {
            self.layout.columnFill = found
          }
        }
      }
      CssProperty.ColumnSpan => {
        if let Option.Some { value: word } = convert.keywordOf(value) {
          if let Option.Some { value: found } = keyword_enums.columnSpanOf(word) {
            self.layout.multicolSpan = found
          }
        }
      }
      CssProperty.ColumnRuleWidth => {
        setBorderWidth(&mut self.columnRule.width, value, &context)
      }
      CssProperty.ColumnRuleStyle => {
        if let Option.Some { value: word } = convert.keywordOf(value) {
          if let Option.Some { value: found } = outlineStyleOf(word) {
            self.columnRule.style = found
          }
        }
      }
      CssProperty.ColumnRuleColor => {
        if convert.isKeyword(value, Keyword.Currentcolor) {
          self.columnRule.current = true
        } else if setColor(&mut self.columnRule.color, value) {
          self.columnRule.current = false
        }
      }
      CssProperty.Orphans => {
        match convert.number(value) {
          Option.Some { value: found } => {
            if found >= 1.0 {
              self.text.orphans = f32.toU32(found)
            }
          }
          Option.None => {}
        }
      }
      CssProperty.Widows => {
        match convert.number(value) {
          Option.Some { value: found } => {
            if found >= 1.0 {
              self.text.widows = f32.toU32(found)
            }
          }
          Option.None => {}
        }
      }
      // line-clamp's longhands and text-overflow (CSS Overflow 3 and 4).
      CssProperty.MaxLines => {
        if convert.isKeyword(value, Keyword.None) {
          self.layout.maxLines = 0
        } else if let Option.Some { value: found } = convert.number(value) {
          if found >= 1.0 {
            self.layout.maxLines = f32.toUsize(found)
          }
        }
      }
      CssProperty.BlockEllipsis => {
        self.layout.blockEllipsis = !convert.isKeyword(value, Keyword.NoEllipsis) && !convert.isKeyword(value, Keyword.None)
      }
      CssProperty.TextOverflow => {
        // With two values the second is the inline end's.
        let mut last = value
        if let Value.Sequence { separator: _, values } = &value.* {
          let items = values.asSlice()
          if items.length != 0 {
            last = &items[items.length - 1]
          }
        }
        self.layout.textOverflowEllipsis = convert.isKeyword(last, Keyword.Ellipsis)
      }
      CssProperty.AspectRatio => {
        // `auto`, `<ratio>`, `auto <ratio>`, or `<ratio> auto`, where `<ratio>` is `a` or `a / b`.
        if convert.isKeyword(value, Keyword.Auto) {
          self.layout.aspectRatio = 0.0
          self.layout.aspectRatioAuto = true
        } else if let Option<f32>.Some { value: found } = ratioOf(value) {
          self.layout.aspectRatio = found
          self.layout.aspectRatioAuto = false
        } else if let Value.Sequence { separator, values } = &value.* {
          let items = values.asSlice()
          if items.length == 2 {
            if separator == Separator.Space {
              if convert.isKeyword(&items[0], Keyword.Auto) {
                if let Option<f32>.Some { value: found } = ratioOf(&items[1]) {
                  self.layout.aspectRatio = found
                  self.layout.aspectRatioAuto = true
                }
              } else if convert.isKeyword(&items[1], Keyword.Auto) {
                if let Option<f32>.Some { value: found } = ratioOf(&items[0]) {
                  self.layout.aspectRatio = found
                  self.layout.aspectRatioAuto = true
                }
              }
            } else if separator == Separator.Slash {
              // Slashes bind looser than spaces in `lib-css`: `auto 4 / 3` -> `Slash([Space([auto, 4]), 3])`,
              // `4 / 3 auto` -> `Slash([4, Space([3, auto])])`.
              if let Value.Sequence { separator: leftSep, values: leftVals } = &items[0] {
                let left = leftVals.asSlice()
                if leftSep == Separator.Space && left.length == 2 && convert.isKeyword(&left[0], Keyword.Auto) {
                  if let Option<f32>.Some { value: found } = slashRatio(&left[1], &items[1]) {
                    self.layout.aspectRatio = found
                    self.layout.aspectRatioAuto = true
                  }
                }
              } else if let Value.Sequence { separator: rightSep, values: rightVals } = &items[1] {
                let right = rightVals.asSlice()
                if rightSep == Separator.Space && right.length == 2 && convert.isKeyword(&right[1], Keyword.Auto) {
                  if let Option<f32>.Some { value: found } = slashRatio(&items[0], &right[0]) {
                    self.layout.aspectRatio = found
                    self.layout.aspectRatioAuto = true
                  }
                }
              }
            }
          }
        }
      }
      CssProperty.ZIndex => {
        if convert.isKeyword(value, Keyword.Auto) {
          self.zAuto = true
          self.zIndex = 0
        } else if let Option<f32>.Some { value: found } = convert.number(value) {
          // An integer only, as in CSS.
          if f32.floor(found) == found && f32.abs(found) < 2147483520.0 {
            self.zAuto = false
            self.zIndex = f32.toI32(found)
          }
        }
      }
      CssProperty.Fill => { setPaint(&mut self.svg.fillKind, &mut self.svg.fill, value) }
      CssProperty.Stroke => { setPaint(&mut self.svg.strokeKind, &mut self.svg.stroke, value) }
      CssProperty.StrokeWidth => {
        if let Option.Some { value: found } = convert.length(value, &context) {
          if found >= 0.0 { self.svg.strokeWidth = if context.zoom > 0.0 { found / context.zoom } else { found } }
        }
      }
      CssProperty.Opacity => {
        if let Option.Some { value: found } = alpha(value) {
          self.paint.opacity = f32.max(0.0, f32.min(1.0, found))
        }
      }
      // Paint.
      CssProperty.ObjectPosition => {
        match convert.pair(value, &context) {
          Option.Some { value: found } => {
            self.paint.objectX = found.first
            self.paint.objectY = found.second
          }
          Option.None => {}
        }
      }
      CssProperty.BackgroundColor => {
        match convert.color(value) {
          Option.Some { value: found } => {
            self.paint.background = Fill.Solid { color: found }
          }
          Option.None => {}
        }
      }
      CssProperty.BorderTopColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderRightColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderBottomColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderLeftColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderTopStyle => {
        self.setBorderStyle(value, 1)
      }
      CssProperty.BorderRightStyle => {
        self.setBorderStyle(value, 2)
      }
      CssProperty.BorderBottomStyle => {
        self.setBorderStyle(value, 4)
      }
      CssProperty.BorderLeftStyle => {
        self.setBorderStyle(value, 8)
      }
      CssProperty.BoxShadow => {
        if convert.isKeyword(value, Keyword.None) {
          self.paint.hasShadow = false
        } else {
          match convert.boxShadow(value, &context) {
            Option.Some { value: found } => {
              self.paint.shadow = found
              self.paint.hasShadow = true
            }
            Option.None => {}
          }
        }
      }
      CssProperty.BackdropFilter => {
        match backdropBlurOf(value, &context) {
          Option.Some { value: found } => {
            self.paint.backdropBlur = f32.max(0.0, found)
          }
          Option.None => {}
        }
      }
      CssProperty.ImageRendering => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            self.nearest = word == Keyword.Pixelated || word == Keyword.CrispImageEdges || word == Keyword.OptimizeSpeed
          }
          Option.None => {}
        }
      }
      CssProperty.UserSelect => {
        if convert.isKeyword(value, Keyword.Auto) {
          self.userSelect = SELECT_AUTO
        } else if convert.isKeyword(value, Keyword.Text) {
          self.userSelect = SELECT_TEXT
        } else if convert.isKeyword(value, Keyword.None) {
          self.userSelect = SELECT_NONE
        } else if convert.isKeyword(value, Keyword.All) {
          self.userSelect = SELECT_ALL
        } else if convert.isKeyword(value, Keyword.Contain) {
          self.userSelect = SELECT_CONTAIN
        }
      }
      CssProperty.AppRegion => {
        if convert.isKeyword(value, Keyword.None) {
          self.appRegion = REGION_NONE
        } else if convert.isKeyword(value, Keyword.Drag) {
          self.appRegion = REGION_DRAG
        } else if convert.isKeyword(value, Keyword.NoDrag) {
          self.appRegion = REGION_NO_DRAG
        }
      }
      CssProperty.PointerEvents => {
        if convert.isKeyword(value, Keyword.None) {
          self.paint.pointerEvents = false
        } else if convert.isKeyword(value, Keyword.Auto) {
          self.paint.pointerEvents = true
        }
      }
      // Text.
      CssProperty.FontFamily => {
        match convert.number(value) {
          Option.Some { value: found } => {
            if found >= 0.0 {
              self.text.family = f32.toU32(found)
            }
          }
          Option.None => {}
        }
      }
      CssProperty.FontSize => {
        // `em` and percentages refer to the inherited size, which is the size so far.
        match &value.* {
          Value.Unit { value: amount, unit } => {
            if unit == Unit.Percent {
              self.text.size = context.fontSize * amount / 100.0
              return ()
            }
          }
          _ => {}
        }
        setPixels(&mut self.text.size, value, &context)
      }
      CssProperty.LetterSpacing => {
        if convert.isKeyword(value, Keyword.Normal) {
          self.text.letterSpacing = 0.0
        } else {
          setPixels(&mut self.text.letterSpacing, value, &context)
        }
      }
      CssProperty.WordSpacing => {
        if convert.isKeyword(value, Keyword.Normal) {
          self.text.wordSpacing = 0.0
        } else {
          setPixels(&mut self.text.wordSpacing, value, &context)
        }
      }
      CssProperty.TextTransform => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.textTransformOf(word) {
              Option.Some { value: found } => {
                self.text.textTransform = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.LineBreak => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.lineBreakOf(word) {
              Option.Some { value: found } => {
                self.text.lineBreak = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.Hyphens => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.hyphensOf(word) {
              Option.Some { value: found } => {
                self.text.hyphens = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.WordBreak => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.wordBreakOf(word) {
              Option.Some { value: found } => {
                self.text.wordBreak = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.OverflowWrap => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.overflowWrapOf(word) {
              Option.Some { value: found } => {
                self.text.overflowWrap = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.FontWeight => {
        if convert.isKeyword(value, Keyword.Normal) {
          self.text.weight = 400.0
        } else if convert.isKeyword(value, Keyword.Bold) {
          self.text.weight = 700.0
        } else {
          match convert.number(value) {
            Option.Some { value: found } => {
              self.text.weight = found
            }
            Option.None => {}
          }
        }
      }
      CssProperty.Color => {
        drop setColor(&mut self.text.color, value)
      }
      CssProperty.TextDecorationColor => {
        if convert.isKeyword(value, Keyword.Currentcolor) {
          self.text.hasDecorationColor = false
        } else if setColor(&mut self.text.decorationColor, value) {
          self.text.hasDecorationColor = true
        }
      }
      CssProperty.TextDecorationStyle => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            self.text.wavy = word == Keyword.Wavy
          }
          Option.None => {}
        }
      }
      CssProperty.CaretColor => {
        if convert.isKeyword(value, Keyword.Auto) {
          self.text.hasCaretColor = false
        } else if setColor(&mut self.text.caretColor, value) {
          self.text.hasCaretColor = true
        }
      }
      CssProperty.AccentColor => {
        if convert.isKeyword(value, Keyword.Auto) {
          self.hasAccentColor = false
        } else if setColor(&mut self.accentColor, value) {
          self.hasAccentColor = true
        }
      }
      CssProperty.Appearance => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            if word == Keyword.None { self.appearanceNone = true }
            else if word == Keyword.Auto { self.appearanceNone = false }
          }
          Option.None => {}
        }
      }
      CssProperty.SilkSelectionColor => {
        drop setColor(&mut self.text.selectionColor, value)
      }
      CssProperty.TextEmphasisStyle => {
        match convert.textEmphasisStyle(value) {
          Option.Some { value: found } => { self.text.emphasis.mark = found }
          Option.None => {}
        }
      }
      CssProperty.TextEmphasisColor => {
        let mut mark = self.text.color
        let given = !convert.isKeyword(value, Keyword.Currentcolor) && setColor(&mut mark, value)
        self.text.emphasis.color = if given { TextStyle.packFill(mark) } else { 0 }
      }
      CssProperty.TextEmphasisPosition => {
        match convert.textEmphasisPosition(value) {
          Option.Some { value: found } => {
            self.text.emphasis.under = found.under
            self.text.emphasis.left = found.left
          }
          Option.None => {}
        }
      }
      CssProperty.WebkitTextFillColor => {
        let mut fill = self.text.color
        let given = !convert.isKeyword(value, Keyword.Currentcolor) && setColor(&mut fill, value)
        self.text.fillColor = if given { TextStyle.packFill(fill) } else { 0 }
      }
      CssProperty.SilkPlaceholderColor => {
        if convert.isKeyword(value, Keyword.Auto) {
          self.text.hasPlaceholderColor = false
        } else if setColor(&mut self.text.placeholderColor, value) {
          self.text.hasPlaceholderColor = true
        }
      }
      // Read with the paint effects (`paint_css.reads`), but not in its hot `handles` test.
      CssProperty.Isolation | CssProperty.WillChange => {
        self.effects.declared = true
      }
      // Properties the tree does not support are ignored.
      _ => {}
    }
  }

  /// `side` is the physical side's bit in `layout.borderHidden` (top 1, right 2, bottom 4,
  /// left 8): `hidden` marks it, which lays out as zero and wins collapsed-border conflicts.
  fn setBorderStyle(self: &mut Self, value: &Value, side: u8) -> () {
    match convert.keywordOf(value) {
      Option.Some { value: word } => {
        if word == Keyword.Hidden {
          self.layout.borderHidden = self.layout.borderHidden | side
          return ()
        }
        self.layout.borderHidden = self.layout.borderHidden & (15 - side)
        match keyword_enums.borderStyleOf(word) {
          Option.Some { value: found } => {
            self.paint.borderStyle = found
          }
          Option.None => {}
        }
      }
      Option.None => {}
    }
  }

  /// Whether the node clips its children to its padding box.
  pub fn clips(self: &Self) -> bool {
    return self.layout.overflowX != Overflow.Visible || self.layout.overflowY != Overflow.Visible || self.contain.paint()
  }

  /// Whether the node draws anything of its own box: a background, border or shadow.
  pub fn decorated(self: &Self) -> bool {
    let fills = match self.paint.background {
      Fill.None => false
      Fill.Solid { color } => color.a > 0.0
      Fill.Gradient { .. } => true
    }
    let border = self.paint.borderStyle != BorderStyle.None && self.paint.borderColor.a > 0.0
      && (self.paint.border.top > 0.0 || self.paint.border.right > 0.0 || self.paint.border.bottom > 0.0
        || self.paint.border.left > 0.0)
    return fills || border || self.paint.hasShadow
  }

  /// A hash of everything that changes how the node paints but not its layout.
  pub fn paintHash(self: &Self, seed: &HashSeed) -> u64 {
    let mut h = Hash.mix(seed, 7)
    h = Hash.combine(h, u8.toU64(ObjectFit.value(self.paint.objectFit)))
    h = dimensionHash(dimensionHash(h, self.paint.objectX), self.paint.objectY)
    match self.paint.background {
      Fill.None => {
        h = Hash.combine(h, 0)
      }
      Fill.Solid { color } => {
        h = colorHash(Hash.combine(h, 1), color)
      }
      Fill.Gradient { angle, from, to } => {
        h = colorHash(colorHash(floatHash(Hash.combine(h, 2), angle), from), to)
      }
    }
    h = colorHash(h, self.paint.borderColor)
    h = Hash.combine(h, borderStyleIndex(self.paint.borderStyle))
    let emptyBit: u64 = if self.emptyCellsHide { 16 } else { 0 }
    let appearBit: u64 = if self.appearanceNone { 32 } else { 0 }
    let accentBit: u64 = if self.hasAccentColor { 64 } else { 0 }
    h = Hash.combine(h, u8.toU64(self.layout.borderHidden) + emptyBit + appearBit + accentBit)
    if self.hasAccentColor { h = colorHash(h, self.accentColor) }
    h = floatHash(h, self.paint.radii.topLeft)
    h = floatHash(h, self.paint.radii.topRight)
    h = floatHash(h, self.paint.radii.bottomRight)
    h = floatHash(h, self.paint.radii.bottomLeft)
    if self.paint.hasShadow {
      h = floatHash(h, self.paint.shadow.offsetX)
      h = floatHash(h, self.paint.shadow.offsetY)
      h = floatHash(h, self.paint.shadow.blur)
      h = floatHash(h, self.paint.shadow.spread)
      h = colorHash(h, self.paint.shadow.color)
      h = Hash.combine(
        h,
        if self.paint.shadow.inset {
          3
        } else {
          2
        },
      )
    }
    if self.outline.drawn() {
      h = floatHash(floatHash(h, self.outline.width), self.outline.offset)
      h = Hash.combine(Hash.combine(h, borderStyleIndex(self.outline.style)), if self.outline.auto { 1 } else { 0 })
      h = if self.outline.colorAuto { Hash.combine(h, 5) } else { colorHash(h, self.outline.color) }
    }
    if self.columnRule.drawn() {
      h = floatHash(h, self.columnRule.width)
      h = Hash.combine(h, borderStyleIndex(self.columnRule.style))
      h = if self.columnRule.current { Hash.combine(h, 5) } else { colorHash(h, self.columnRule.color) }
    }
    h = Hash.combine(h, self.svg.key())
    h = floatHash(h, self.paint.opacity)
    h = floatHash(h, self.paint.backdropBlur)
    h = Hash.combine(Hash.combine(h, self.effects.hash), self.effects.shadowHash)
    // Paint order: where the box's stacking context puts it.
    h = Hash.combine(h, u8.toU64(Position.value(self.layout.position)))
    h = Hash.combine(
      h,
      if self.zAuto {
        1
      } else {
        2
      },
    )
    h = Hash.combine(h, u32.toU64(i32.wrappingToU32(self.zIndex)))
    h = colorHash(h, self.text.color)
    h = Hash.combine(h, decorationIndex(self.text.decoration))
    h = colorHash(h, self.text.lineColor())
    h = Hash.combine(
      h,
      if self.text.wavy {
        1
      } else {
        0
      },
    )
    h = colorHash(h, self.text.caret())
    h = colorHash(h, self.text.selectionColor)
    h = colorHash(h, self.text.placeholder())
    if self.text.fillColor != 0 { h = Hash.combine(h, u32.toU64(self.text.fillColor)) }
    // font-palette and font-smooth only change paint; the other extras change layout too.
    if self.text.features.extras != 0 { h = Hash.combine(h, u32.toU64(self.text.features.extras)) }
    if self.text.emphasis.mark != 0 {
      h = Hash.combine(Hash.combine(h, u32.toU64(self.text.emphasis.mark)), u32.toU64(self.text.emphasis.color))
      let side: u64 = if self.text.emphasis.under { 1 } else { 0 }
      let edge: u64 = if self.text.emphasis.left { 2 } else { 0 }
      h = Hash.combine(h, side + edge)
    }
    if self.contain.paint() { h = Hash.combine(h, if self.contain.hidden() { 5 } else { 4 }) }
    if self.contain.layout() { h = Hash.combine(h, 6) }
    if !self.scroll.colors.auto() { h = Hash.combine(Hash.combine(h, 3), self.scroll.colors.words()) }
    if self.nearest { h = Hash.combine(h, 6) }
    h = Hash.combine(
      h,
      if self.paint.pointerEvents {
        1
      } else {
        0
      },
    )
    h = Hash.combine(h, u8.toU64(self.userSelect))
    h = Hash.combine(h, u8.toU64(self.appRegion))
    return h
  }

  /// Completes the layout style once every property is applied: the font key the text style
  /// resolved to, the inherited text properties, and the border widths.
  pub fn finish(self: &mut Self, fontKey: usize) -> () {
    let text = self.text
    self.layout.fontKey = fontKey
    self.layout.border = if self.paint.borderStyle == BorderStyle.None {
      Edges.all(Dimension.px(0.0))
    } else {
      borderEdges(self.paint.border)
    }
    let hidden = self.layout.borderHidden
    if hidden != 0 {
      if hidden & 1 != 0 { self.layout.border.top = Dimension.px(0.0) }
      if hidden & 2 != 0 { self.layout.border.right = Dimension.px(0.0) }
      if hidden & 4 != 0 { self.layout.border.bottom = Dimension.px(0.0) }
      if hidden & 8 != 0 { self.layout.border.left = Dimension.px(0.0) }
    }
    self.layout.lineHeight = text.lineHeight
    self.layout.textAlign = text.align
    self.layout.direction = text.direction
    self.layout.visibility = text.visibility
    self.layout.writingMode = text.writingMode
    self.layout.textOrientation = text.textOrientation
    self.layout.textAlignLast = text.textAlignLast
    self.layout.textWrap = text.textWrap
    self.layout.textWrapStyle = text.textWrapStyle
    self.layout.whiteSpaceCollapse = text.whiteSpaceCollapse
    self.layout.textJustify = text.textJustify
    self.layout.textIndent = text.textIndent
    self.layout.textBoxEdge = text.textBoxEdge
    // Vertical lines put `right` marks on their over side, horizontal ones `over` marks.
    let vertical = text.writingMode != WritingMode.HorizontalTb
    let under = if vertical { text.emphasis.left } else { text.emphasis.under }
    self.layout.emphasis = if text.emphasis.mark == 0 { EmphasisSide.None } else if under { EmphasisSide.Under } else { EmphasisSide.Over }
    self.layout.tabSize = text.tabSize
    self.layout.orphans = u32.toUsize(text.orphans)
    self.layout.widows = u32.toUsize(text.widows)
  }
}

fn borderEdges(border: Insets<f32>) -> Edges {
  return Edges {
    top: Dimension.px(border.top),
    right: Dimension.px(border.right),
    bottom: Dimension.px(border.bottom),
    left: Dimension.px(border.left),
  }
}

fn floatHash(h: u64, value: f32) -> u64 {
  return Hash.combine(h, u32.toU64(f32.toBits(value)))
}

fn colorHash(h: u64, color: Rgba<f32>) -> u64 {
  return floatHash(floatHash(floatHash(floatHash(h, color.r), color.g), color.b), color.a)
}

fn dimensionHash(h: u64, value: Dimension) -> u64 {
  return floatHash(floatHash(Hash.combine(h, u8.toU64(DimensionKind.value(value.kind))), value.value), value.percent)
}

fn borderStyleIndex(value: BorderStyle) -> u64 {
  return match value {
    BorderStyle.None => 0
    BorderStyle.Solid => 1
    BorderStyle.Dashed => 2
  }
}

fn decorationIndex(value: DecorationLine) -> u64 {
  let mut bits: u64 = 0
  if value.underline {
    bits = bits + 1
  }
  if value.overline {
    bits = bits + 2
  }
  if value.lineThrough {
    bits = bits + 4
  }
  return bits
}

/// Parses a CSS `<ratio>`: a non-negative number (`1.5`), or `a / b` where both are
/// non-negative numbers. Negative values are invalid and return None.
fn ratioOf(value: &Value) -> Option<f32> {
  if let Option<f32>.Some { value: found } = convert.number(value) {
    if found >= 0.0 {
      return Option<f32>.some(found)
    }
    return Option<f32>.None
  }
  if let Value.Sequence { separator, values } = &value.* {
    let items = values.asSlice()
    if separator == Separator.Slash && items.length == 2 {
      return slashRatio(&items[0], &items[1])
    }
  }
  return Option<f32>.None
}

fn slashRatio(numerator: &Value, denominator: &Value) -> Option<f32> {
  if let Option<f32>.Some { value: num } = convert.number(numerator) {
    if let Option<f32>.Some { value: den } = convert.number(denominator) {
      if num >= 0.0 && den >= 0.0 {
        return Option<f32>.some(if num == 0.0 || den == 0.0 { 0.0 } else { num / den })
      }
    }
  }
  return Option<f32>.None
}
