// ---- Idle, prepare and check ------------------------------------------------------------------
unsafe fn phaseList(loop: *mut Loop, kind: i32) -> *mut ?*mut Handle {
  let mut anchor = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop)
  if kind == UV_IDLE { return Pointer.fromMutRef<?*mut Handle>(&mut l.idles) }
  if kind == UV_PREPARE { return Pointer.fromMutRef<?*mut Handle>(&mut l.prepares) }
  return Pointer.fromMutRef<?*mut Handle>(&mut l.checks)
}
unsafe fn phaseInit(loopMemory: *mut u8, memory: *mut u8, kind: i32) -> i32 {
  let _handle = unsafe initialize(unsafe loopOf(loopMemory), memory, kind)
  return 0
}
pub unsafe fn uv_idle_init(loop: *mut u8, memory: *mut u8) -> i32 { return unsafe phaseInit(loop, memory, UV_IDLE) }
pub unsafe fn uv_prepare_init(loop: *mut u8, memory: *mut u8) -> i32 { return unsafe phaseInit(loop, memory, UV_PREPARE) }
pub unsafe fn uv_check_init(loop: *mut u8, memory: *mut u8) -> i32 { return unsafe phaseInit(loop, memory, UV_CHECK) }
/// Starts an idle, prepare or check handle: `callback(handle)` runs once per iteration in its
/// phase. libuv inserts at the head, so the newest started runs first. UV_EINVAL without callback.
pub unsafe fn phaseStart(memory: *mut u8, callback: ?extern "C" fn(*mut u8) -> ()) -> i32 {
