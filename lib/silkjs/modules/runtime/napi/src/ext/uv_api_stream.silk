  if length < 0 { return length }
  if count < 1 { return -EINVAL }
  if unsafe get<usize>(udp, U_SEND_QUEUE_COUNT) != 0 { return -EAGAIN }
  if !Pointer.isNull<u8>(address) {
    let err = unsafe udpMaybeDeferredBind(udp, familyOf(unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(address)), 0)
    if err != 0 { return err }
  }
  let raw = unsafe constant(unsafe Intrinsic.pointerReinterpret<*const Buf, *const u8>(bufs))
  let err2 = unsafe sendOne(unsafe fdOf(udp), raw, count, unsafe Intrinsic.pointerRequalify<?*const u8, ?*mut u8>(address))
