//! Generated text belongs to a private layout box, while selectors and attr() see its origin.
import engine { UiTree }
import selector_tree { SelectorTree }
import svg_css.element { ElementTree, PseudoTarget }
import svg_css.adopted { StyleSheets }
import svg_css.sheet { Declaration as SheetDeclaration }
import svg_css.generated_content { Content, Item }
import svg_css.generated_content
import svg_css.counter_styles { CounterStyle }
import svg_css.counter_styles
import lists { Scope }
import svg_css.input { Input }
import svg_css.lexer
import svg_css.tokens { CssError, Limits, insensitive }
import properties.catalog { Property }
import properties.values { Declaration, Value }
import properties.values
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String, InvalidUtf8 }
import silk.num.u32

/// Preflight's universal pseudo declarations alone must not allocate or resolve boxes.
pub fn hasContent(sheets: &StyleSheets) -> bool {
  let mut i: usize = 0
  while i < sheets.sheets().length {
    let sheet = &sheets.sheets()[i].sheet
    let rules = sheet.resolver.rules()
    let mut rule: usize = 0
    while rule < rules.length {
      if rules[rule].selectors.hasPseudoTarget(PseudoTarget.Before) || rules[rule].selectors.hasPseudoTarget(PseudoTarget.After) {
        let range = rules[rule].declarations
        let mut at = range.start
        while at < range.end {
          let mentions = match &sheet.declarations.asSlice()[at] {
            SheetDeclaration.Custom { .. } => false
            SheetDeclaration.Typed { property, .. } => property == Property.Content || property == Property.All
            SheetDeclaration.Pending { property, .. } => property == Property.Content || property == Property.All
            SheetDeclaration.ColorExpression { property, .. } => property == Property.Content || property == Property.All
          }
          if mentions { return true }
          at = at + 1
        }
      }
      rule = rule + 1
    }
    i = i + 1
  }
  return false
}

fn declared<'a>(declarations: &'a [Declaration]) -> Option<&'a Value> {
  let mut i: usize = 0
  while i < declarations.length {
    if declarations[i].property == Property.Content { return Option<&Value>.some(&declarations[i].value) }
    i = i + 1
  }
  return Option<&Value>.None
}

/// The text of generated content from `declarations`, with counters read from `scope`.
/// `counted` is set when the content names a counter, which the counters pass then rewrites.
pub effect fn content(tree: &UiTree<'_>, origin: u32, declarations: &[Declaration], scope: &Scope, counted: &mut bool) -> Option<String>
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let specified = match declared(declarations) { Option.Some { value } => value _ => { return Option<String>.None } }
  // Ordinary elements have computed content: normal (CSS 2.2). Inheriting that
  // value into before/after therefore generates no box, as in Chromium.
  return run evaluate(tree, origin, specified, scope, &mut counted)
}

effect fn evaluate(tree: &UiTree<'_>, source: u32, specified: &Value, scope: &Scope, counted: &mut bool) -> Option<String>
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let text = run values.cssText(specified)
  let tokens = run lexer.tokenize(text.asSlice(), &Limits.make())
  let parsed = run generated_content.parse(&Input.Contiguous { buffer: &tokens, range: tokens.all() })
  let items = match move parsed {
    Option.Some { value: Content.Items { values } } => move values
    _ => { return Option<String>.None }
  }
  let adapter = SelectorTree { tree: tree }
  let mut out = Bytes.make()
  let mut i: usize = 0
  while i < items.length() {
    match &items.asSlice()[i] {
      Item.Text { value } => { run out.append(value.asSlice()) }
      Item.Attribute { name, fallback } => {
        let mut value = fallback.asSlice()
        let mut at: usize = 0
        while at < adapter.attributeCount(u32.toUsize(source)) {
          let attribute = adapter.attribute(u32.toUsize(source), at)
          if attribute.namespace.length == 0 && insensitive(attribute.name, name.asSlice()) { value = attribute.value break }
          at = at + 1
        }
        run out.append(value)
      }
      Item.Counter { name, separator, style, nested } => {
        counted.* = true
        let found = if style.length() == 0 { CounterStyle.Decimal } else {
          match counter_styles.named(style.asSlice()) { Option.Some { value } => value _ => CounterStyle.Decimal }
        }
        run scope.write(name.asSlice(), separator.asSlice(), nested, found, &mut out)
      }
    }
    i = i + 1
  }
  return match String.fromUtf8(out.asSlice()) {
    Result<string, InvalidUtf8>.Success { value } => Option<String>.some(run String.copy(value))
    _ => Option<String>.None
  }
}
