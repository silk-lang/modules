//! What baseline code (baseline.silk, docs/jit/baseline.md) finds through its pinned
//! environment register: the runtime, the helpers it calls and its counters.
//!
//! The code names a helper by its index, never by address, so its bytes hold no
//! process-local pointer (ahead-of-time compilation). One BaselineEnv serves a runtime.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.num.f64
import silk.num.i32
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silkjs.thin_list { ThinList, BoxList }
import silkjs.js_heap { HeapCell, HeapHeader, HeapKind }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots, ObjectData, ObjectPayload, BytecodeClosure, FunctionBytecode, RuntimeState, ShapeData, SlotBits, PropertySlot, BuiltinFamily, NativeFunctionId, NativeFunctionData, NativeCallProtocol, GcPhase }
import silkjs.js_core_types as census
import silkjs.js_class_data as classes
import silkjs.js_gc as gc
import silkjs.js_shapes as shapes
import silkjs.js_constructor_ops as constructors
import silkjs.js_construct_eval as evaluation
import silkjs.js_interrupts as interrupts
