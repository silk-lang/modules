import headless { HeadlessWebViews }
import wire { WireViews, WireEvent, OP_OPEN, OP_COMMAND, OP_CLEAR, OP_CLOSE }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

effect fn codes(events: &List<WireEvent>, out: &mut List<u32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < events.length() {
    run out.append(events.asSlice()[i].code)
    i = i + 1
  }
}

fn textOf(events: &List<WireEvent>, code: u32) -> string {
  let mut i: usize = 0
  while i < events.length() {
    if events.asSlice()[i].code == code {
      return String.view(&events.asSlice()[i].text)
    }
    i = i + 1
  }
  return "(none)"
}

test effect fn callsAsTextDriveViews() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run callsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callsBody() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut views = WireViews<HeadlessWebViews>.make(HeadlessWebViews.make())
  let opened = run views.serve(OP_OPEN, 1, "3\u{1f}12\u{1f}about:blank\u{1f}\u{1f}1")
  run Testing.expect(opened == 1.0, "the view opens")
  run Testing.expect(views.any(), "an open view is counted")
  drop run views.serve(
    OP_COMMAND,
    1,
    "3\u{1f}loadHtml\u{1f}https://silk.test/\u{1f}<title>A\u{1f}B</title>",
  )
  drop run views.serve(OP_COMMAND, 1, "3\u{1f}find\u{1f}9\u{1f}1\u{1f}1\u{1f}needle")
  drop run views.serve(OP_CLEAR, 1, "4\u{1f}1\u{1f}0\u{1f}work")
  let mut events = List<WireEvent>.make()
  run views.take(&mut events)
  let mut seen = List<u32>.make()
  run codes(&events, &mut seen)
  run Testing.expect(seen.length() > 0 && seen.get(0) == 1, "Created comes first")
  run Testing.expect(
    textOf(&events, 7) == "A\u{1f}B",
    "the title keeps its separator as the last field",
  )
  run Testing.expect(
    String.startsWith(textOf(&events, 5), "1\u{1f}0\u{1f}"),
    "a load that ended well says so, with net error 0",
  )
  run Testing.expect(textOf(&events, 20) == "9\u{1f}0\u{1f}0", "find answers its request")
  run Testing.expect(textOf(&events, 21) == "4", "clearing answers its request")
  drop run views.serve(OP_CLOSE, 1, "3")
  run Testing.expect(!views.any(), "the closed view is gone")
}
