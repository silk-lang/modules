  let header = unsafe words(Pointer.fromMutRef<u64>(&mut storage[0]))
  let prepared = unsafe preparePacket(header, bufs, count, address)
  if prepared != 0 { return prepared }
  let mut r: isize = 0
  while true { r = unsafe sendHeader(fd, header) if r != -1 || unsafe errno() != EINTR { break } }
  if r < 0 {
    let code = unsafe errno()
    if code == EAGAIN || code == ENOBUFS { return -EAGAIN }
    return -code
