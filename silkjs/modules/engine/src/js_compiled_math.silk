//! Math calls from compiled code (docs/jit/doubles.md, "Math"): a call whose callee is one of
//! the engine's own Math functions of the FloatUnary or FloatBinary protocol, on Number
//! arguments, computed here with the interpreter's own implementations, so results are bit
//! for bit the interpreter's. Anything else declines and the compiled code makes the call.
import silk.num.i32
import silk.num.u32
import silk.mem.pointer { Pointer }
import js_heap { HeapCell }
import js_value { ValueBits }
import js_core_types { BuiltinFamily, NativeFunctionId, NativeCallProtocol, ObjectData, ObjectPayload }
import js_math_intrinsics_callbacks as mathIds

fn numberOf(value: ValueBits, out: &mut f64) -> bool {
  match value {
    ValueBits.Int { value: x } => { out.* = i32.toF64(x) return true }
    ValueBits.Float64 { value: x } => { out.* = x return true }
    _ => { return false }
  }
}

/// The call whose callee, receiver and `count` arguments are the ValueBits at `area`, when
/// the callee is a Math function of the FloatUnary or FloatBinary protocol and the arguments
/// it reads are Numbers (ToNumber runs no code on them): its result, as the interpreter's
/// dispatch returns it (ValueBits.number), into `out`, and true. False changes nothing.
pub unsafe fn mathCall(area: *const ValueBits, count: u32, out: *mut ValueBits) -> bool {
  let many = unsafe Pointer.assumeMany<ValueBits>(area)
  let callee = unsafe Pointer.read<ValueBits>(unsafe Pointer.at<ValueBits>(many, 0))
  let object = match callee {
    ValueBits.Object { reference } => reference
    _ => { return false }
  }
  let anchor = ()
  let p = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let mut method: u32 = u32.MAX
  match &p.payload {
    ObjectPayload.NativeFunction { function: native } => {
      match native.function {
        NativeFunctionId.Builtin { family, method: m } => {
          if family == BuiltinFamily.Math && (native.protocol == NativeCallProtocol.FloatUnary || native.protocol == NativeCallProtocol.FloatBinary) { method = m }
        }
        _ => ()
      }
    }
    _ => ()
  }
  drop p
  if method == u32.MAX { return false }
  let binary = mathIds.protocol(method) == NativeCallProtocol.FloatBinary
  let mut x: f64 = 0.0 let mut y: f64 = 0.0
  if count < 1 || !numberOf(unsafe Pointer.read<ValueBits>(unsafe Pointer.at<ValueBits>(many, 2)), &mut x) { return false }
  if binary {
    if count < 2 || !numberOf(unsafe Pointer.read<ValueBits>(unsafe Pointer.at<ValueBits>(many, 3)), &mut y) { return false }
    unsafe Pointer.write<ValueBits>(out, ValueBits.number(mathIds.binary(method, x, y)))
    return true
  }
  unsafe Pointer.write<ValueBits>(out, ValueBits.number(mathIds.unary(method, x)))
  return true
}
