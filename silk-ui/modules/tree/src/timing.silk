//! The timing half of CSS transitions: easing functions, and the `transition-*` lists of a
//! computed style, read from CSS text.
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The mask of every field `motion` transitions (`transition-property: all`).
pub const ALL: u64 = 0xFFFFFFFFFFFFFF

pub const LINEAR: u8 = 0
pub const BEZIER: u8 = 1
pub const STEPS: u8 = 2
/// `linear()` with stops: `steps` holds the key of its points in an [`EasingStops`].
pub const STOPS: u8 = 3

pub const JUMP_END: u8 = 0
pub const JUMP_START: u8 = 1
pub const JUMP_NONE: u8 = 2
pub const JUMP_BOTH: u8 = 3

/// An easing function (CSS Easing 2): linear, linear() with stops, a cubic Bézier curve or steps.
pub struct Easing {
  pub kind: u8,
  pub x1: f32,
  pub y1: f32,
  pub x2: f32,
  pub y2: f32,
  pub steps: u32,
  pub jump: u8,
}

impl Copy for Easing {}

impl Easing {
  pub fn linear() -> Easing {
    return Easing { kind: LINEAR, x1: 0.0, y1: 0.0, x2: 1.0, y2: 1.0, steps: 1, jump: JUMP_END }
  }

  pub fn bezier(x1: f32, y1: f32, x2: f32, y2: f32) -> Easing {
    return Easing { kind: BEZIER, x1: x1, y1: y1, x2: x2, y2: y2, steps: 1, jump: JUMP_END }
  }

  /// `ease`, the initial `transition-timing-function`.
  pub fn ease() -> Easing {
    return Easing.bezier(0.25, 0.1, 0.25, 1.0)
  }

  pub fn stepped(steps: u32, jump: u8) -> Easing {
    return Easing { kind: STEPS, x1: 0.0, y1: 0.0, x2: 1.0, y2: 1.0, steps: steps, jump: jump }
  }

  /// The output progress at input progress `p`, 0 to 1, with `linear()` stops from `stops`.
  pub fn at(self: &Self, p: f32, stops: &EasingStops) -> f32 {
    if self.kind == STOPS {
      return stops.at(self.steps, p)
    }
    if self.kind == BEZIER {
      if p <= 0.0 {
        return 0.0
      }
      if p >= 1.0 {
        return 1.0
      }
      let t = solveX(self.x1, self.x2, p)
      return bezierAt(self.y1, self.y2, t)
    }
    if self.kind == STEPS {
      let steps = u32.toF32(self.steps)
      let mut step = f32.floor(p * steps)
      if self.jump == JUMP_START || self.jump == JUMP_BOTH {
        step = step + 1.0
      }
      let jumps = if self.jump == JUMP_BOTH {
        steps + 1.0
      } else if self.jump == JUMP_NONE {
        f32.max(1.0, steps - 1.0)
      } else {
        steps
      }
      if p >= 0.0 && step < 0.0 {
        step = 0.0
      }
      if p <= 1.0 && step > jumps {
        step = jumps
      }
      return step / jumps
    }
    return p
  }
}

// One coordinate of a cubic Bézier from (0, 0) to (1, 1) with control points a and b.
fn bezierAt(a: f32, b: f32, t: f32) -> f32 {
  let u = 1.0 - t
  return 3.0 * u * u * t * a + 3.0 * u * t * t * b + t * t * t
}

fn bezierSlope(a: f32, b: f32, t: f32) -> f32 {
  let u = 1.0 - t
  return 3.0 * u * u * a + 6.0 * u * t * (b - a) + 3.0 * t * t * (1.0 - b)
}

// The curve parameter whose x is `x`: Newton steps, then bisection if they stall.
fn solveX(x1: f32, x2: f32, x: f32) -> f32 {
  let mut t = x
  let mut i: u32 = 0
  while i < 8 {
    let error = bezierAt(x1, x2, t) - x
    if f32.abs(error) < 0.000001 {
      return t
    }
    let slope = bezierSlope(x1, x2, t)
    if f32.abs(slope) < 0.000001 {
      break
    }
    t = t - error / slope
    i = i + 1
  }
  let mut low: f32 = 0.0
  let mut high: f32 = 1.0
  t = x
  i = 0
  while i < 40 {
    let value = bezierAt(x1, x2, t)
    if f32.abs(value - x) < 0.000001 {
      return t
    }
    if value < x {
      low = t
    } else {
      high = t
    }
    t = (low + high) * 0.5
    i = i + 1
  }
  return t
}

pub struct TimingList { pub start: usize, pub count: usize }
impl Copy for TimingList {}
impl TimingList {
  pub fn initial() -> TimingList { return TimingList { start: usize.MAX, count: 1 } }
}

pub struct TransitionItem {
  pub property: u64,
  pub duration: f32,
  pub delay: f32,
  pub easing: Easing,
  pub discrete: bool,
}
impl Copy for TransitionItem {}
impl TransitionItem {
  pub fn initial() -> TransitionItem {
    return TransitionItem { property: ALL, duration: 0.0, delay: 0.0, easing: Easing.ease(), discrete: false }
  }
}

/// Shared immutable lists in the tree's timing store; the initial values need no allocation.
pub struct TransitionLists {
  pub properties: TimingList,
  pub durations: TimingList,
  pub delays: TimingList,
  pub easings: TimingList,
  pub discrete: TimingList,
}
impl Copy for TransitionLists {}

pub struct TransitionSpec {
  pub duration: f32,
  pub delay: f32,
  pub easing: Easing,
  pub allowDiscrete: bool,
}
impl Copy for TransitionSpec {}

impl TransitionLists {
  pub fn initial() -> TransitionLists {
    let initial = TimingList.initial()
    return TransitionLists { properties: initial, durations: initial, delays: initial, easings: initial, discrete: initial }
  }

  pub fn any(self: &Self, store: &EasingStops) -> bool {
    if self.durations.start == usize.MAX && self.delays.start == usize.MAX { return false }
    let mut i: usize = 0
    while i < self.properties.count {
      let duration = store.transitionItem(self.durations, i).duration
      if duration + store.transitionItem(self.delays, i).delay > 0.0 && store.transitionItem(self.properties, i).property != 0 { return true }
      i = i + 1
    }
    return false
  }

  pub fn spec(self: &Self, field: u32, store: &EasingStops) -> TransitionSpec {
    let bit = u64.shiftLeft(1, u32.toU64(field))
    let mut found = usize.MAX
    let mut i: usize = 0
    while i < self.properties.count {
      if u64.bitAnd(store.transitionItem(self.properties, i).property, bit) != 0 { found = i }
      i = i + 1
    }
    if found == usize.MAX {
      return TransitionSpec { duration: 0.0, delay: 0.0, easing: Easing.linear(), allowDiscrete: false }
    }
    return TransitionSpec {
      duration: store.transitionItem(self.durations, found).duration,
      delay: store.transitionItem(self.delays, found).delay,
      easing: store.transitionItem(self.easings, found).easing,
      allowDiscrete: store.transitionItem(self.discrete, found).discrete,
    }
  }
}

// CSS text.

/// A byte range of a text.
pub struct Span {
  pub start: usize,
  pub end: usize,
}

impl Copy for Span {}

fn lower(byte: u8) -> u8 {
  return if byte >= 65 && byte <= 90 {
    byte + 32
  } else {
    byte
  }
}

fn isSpace(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13
}

fn isDigit(byte: u8) -> bool {
  return byte >= 48 && byte <= 57
}

/// Whether `a` is `b` (lowercase) in ASCII case-insensitive comparison.
pub fn named(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if lower(a[i]) != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// The bytes of `text` from `start` to `end`.
pub fn part(text: &[u8], start: usize, end: usize) -> &[u8] {
  return Slice.view<u8>(text, start, end - start)
}

pub fn trimmed(text: &[u8]) -> &[u8] {
  let start = trimStart(text, 0, text.length)
  return part(text, start, trimEnd(text, start, text.length))
}

/// The end of the item that starts at `at`: the next comma (or space) outside parentheses.
pub fn itemEnd(text: &[u8], at: usize, comma: bool) -> usize {
  let mut depth: u32 = 0
  let mut quote: u8 = 0
  let mut i = at
  while i < text.length {
    let byte = text[i]
    if byte == 92 { i = escapeEnd(text, i)
      continue }
    if quote != 0 {
      if byte == quote { quote = 0 }
    } else if byte == 34 || byte == 39 { quote = byte }
    else if byte == 40 { depth = depth + 1 }
    else if byte == 41 && depth > 0 { depth = depth - 1 }
    else if depth == 0 && ((comma && byte == 44) || (!comma && isSpace(byte))) { return i }
    i = i + 1
  }
  return text.length
}

fn hex(byte: u8) -> u32 {
  if byte >= 48 && byte <= 57 { return u8.toU32(byte - 48) }
  if byte >= 65 && byte <= 70 { return u8.toU32(byte - 65 + 10) }
  if byte >= 97 && byte <= 102 { return u8.toU32(byte - 97 + 10) }
  return 16
}

fn escapeEnd(text: &[u8], slash: usize) -> usize {
  let mut at = slash + 1
  if at == text.length { return at }
  if hex(text[at]) == 16 {
    if text[at] == 13 && at + 1 < text.length && text[at + 1] == 10 { return at + 2 }
    return at + 1
  }
  let mut count: usize = 0
  while at < text.length && count < 6 && hex(text[at]) != 16 { at = at + 1
    count = count + 1 }
  if at < text.length && isSpace(text[at]) {
    if text[at] == 13 && at + 1 < text.length && text[at + 1] == 10 { return at + 2 }
    return at + 1
  }
  return at
}

fn trimStart(text: &[u8], start: usize, end: usize) -> usize {
  let mut i = start
  while i < end && isSpace(text[i]) {
    i = i + 1
  }
  return i
}

fn trimEnd(text: &[u8], start: usize, end: usize) -> usize {
  let mut i = end
  while i > start && isSpace(text[i - 1]) {
    i = i - 1
  }
  return i
}

/// How many bytes the number at the start of `text` takes (0 when there is none).
fn numberLength(text: &[u8]) -> usize {
  let mut i: usize = 0
  if i < text.length && (text[i] == 45 || text[i] == 43) {
    i = i + 1
  }
  let mut digits: usize = 0
  while i < text.length && isDigit(text[i]) {
    i = i + 1
    digits = digits + 1
  }
  if i < text.length && text[i] == 46 {
    i = i + 1
    while i < text.length && isDigit(text[i]) {
      i = i + 1
      digits = digits + 1
    }
  }
  return if digits == 0 {
    0
  } else {
    i
  }
}

/// The value of the number spelled by all of `text`.
fn numberValue(text: &[u8]) -> f32 {
  let mut i: usize = 0
  let mut sign: f32 = 1.0
  if i < text.length && (text[i] == 45 || text[i] == 43) {
    if text[i] == 45 {
      sign = -1.0
    }
    i = i + 1
  }
  let mut value: f32 = 0.0
  while i < text.length && isDigit(text[i]) {
    value = value * 10.0 + u32.toF32(u8.toU32(text[i]) - 48)
    i = i + 1
  }
  if i < text.length && text[i] == 46 {
    i = i + 1
    let mut scale: f32 = 0.1
    while i < text.length && isDigit(text[i]) {
      value = value + scale * u32.toF32(u8.toU32(text[i]) - 48)
      scale = scale * 0.1
      i = i + 1
    }
  }
  return sign * value
}

/// A `<time>` in seconds: `150ms`, `0.2s`, or a bare `0`.
pub fn time(text: &[u8]) -> Option<f32> {
  let used = numberLength(text)
  if used == 0 {
    return Option<f32>.None
  }
  let value = numberValue(part(text, 0, used))
  let unit = part(text, used, text.length)
  if named(unit, b"s") {
    return Option<f32>.some(value)
  }
  if named(unit, b"ms") {
    return Option<f32>.some(value / 1000.0)
  }
  if unit.length == 0 && value == 0.0 {
    return Option<f32>.some(0.0)
  }
  return Option<f32>.None
}

/// Whether `text` is the function `name(...)`.
fn isFunction(text: &[u8], name: &[u8]) -> bool {
  return text.length >= name.length + 2 && text[text.length - 1] == 41
    && named(part(text, 0, name.length), name)
    && text[name.length] == 40
}

/// The `index`th comma-separated number of the arguments of the function `text` whose name
/// is `skip` bytes long.
fn argument(text: &[u8], skip: usize, index: u32) -> Option<f32> {
  let inner = part(text, skip + 1, text.length - 1)
  let mut at: usize = 0
  let mut i: u32 = 0
  while at <= inner.length {
    let end = itemEnd(inner, at, true)
    if i == index {
      let start = trimStart(inner, at, end)
      let stop = trimEnd(inner, start, end)
      let spelled = part(inner, start, stop)
      let used = numberLength(spelled)
      if used == 0 || used != spelled.length {
        return Option<f32>.None
      }
      return Option<f32>.some(numberValue(spelled))
    }
    at = end + 1
    i = i + 1
  }
  return Option<f32>.None
}

fn argumentOr(text: &[u8], skip: usize, index: u32, ok: &mut bool) -> f32 {
  let found = argument(text, skip, index)
  if found.isNone() {
    ok.* = false
  }
  return found.unwrapOr(0.0)
}

/// An `<easing-function>`.
pub fn easing(text: &[u8]) -> Option<Easing> {
  if named(text, b"linear") {
    return Option<Easing>.some(Easing.linear())
  }
  if named(text, b"ease") {
    return Option<Easing>.some(Easing.ease())
  }
  if named(text, b"ease-in") {
    return Option<Easing>.some(Easing.bezier(0.42, 0.0, 1.0, 1.0))
  }
  if named(text, b"ease-out") {
    return Option<Easing>.some(Easing.bezier(0.0, 0.0, 0.58, 1.0))
  }
  if named(text, b"ease-in-out") {
    return Option<Easing>.some(Easing.bezier(0.42, 0.0, 0.58, 1.0))
  }
  if named(text, b"step-start") {
    return Option<Easing>.some(Easing.stepped(1, JUMP_START))
  }
  if named(text, b"step-end") {
    return Option<Easing>.some(Easing.stepped(1, JUMP_END))
  }
  if isFunction(text, b"cubic-bezier") {
    let mut ok = true
    let x1 = argumentOr(text, 12, 0, &mut ok)
    let y1 = argumentOr(text, 12, 1, &mut ok)
    let x2 = argumentOr(text, 12, 2, &mut ok)
    let y2 = argumentOr(text, 12, 3, &mut ok)
    if ok && x1 >= 0.0 && x1 <= 1.0 && x2 >= 0.0 && x2 <= 1.0 {
      return Option<Easing>.some(Easing.bezier(x1, y1, x2, y2))
    }
    return Option<Easing>.None
  }
  if isFunction(text, b"steps") {
    let mut ok = true
    let count = argumentOr(text, 5, 0, &mut ok)
    if !ok || count < 1.0 {
      return Option<Easing>.None
    }
    let inner = part(text, 6, text.length - 1)
    let comma = itemEnd(inner, 0, true)
    let mut jump = JUMP_END
    if comma < inner.length {
      let start = trimStart(inner, comma + 1, inner.length)
      let word = part(inner, start, trimEnd(inner, start, inner.length))
      if named(word, b"jump-start") || named(word, b"start") {
        jump = JUMP_START
      } else if named(word, b"jump-none") {
        jump = JUMP_NONE
        if count < 2.0 {
          return Option<Easing>.None
        }
      } else if named(word, b"jump-both") {
        jump = JUMP_BOTH
      } else if !(named(word, b"jump-end") || named(word, b"end")) {
        return Option<Easing>.None
      }
    }
    return Option<Easing>.some(Easing.stepped(f32.toU32(count), jump))
  }
  if isFunction(text, b"linear") {
    if linearPoints(text) < 2 {
      return Option<Easing>.None
    }
    return Option<Easing>.some(Easing {
      kind: STOPS,
      x1: 0.0,
      y1: 0.0,
      x2: 1.0,
      y2: 1.0,
      steps: stopsKey(text),
      jump: JUMP_END,
    })
  }
  return Option<Easing>.None
}

fn stopsKey(text: &[u8]) -> u32 {
  let hash = nameHash(text)
  return u64.toU32(u64.bitAnd(u64.bitXor(hash, u64.shiftRight(hash, 32)), 0xFFFFFFFF))
}

/// How many points `linear(...)` text has (CSS Easing 2 §"linear()"), 0 when it is invalid.
fn linearPoints(text: &[u8]) -> usize {
  let inner = part(text, 7, text.length - 1)
  let mut count: usize = 0
  let mut at: usize = 0
  while at <= inner.length {
    let end = itemEnd(inner, at, true)
    let mut spans = [Span { start: 0, end: 0 }; 8]
    let item = part(inner, at, end)
    let words = words(item, &mut spans)
    if words == 0 || words > 3 {
      return 0
    }
    let mut numbers: usize = 0
    let mut w: usize = 0
    while w < words {
      let word = part(item, spans[w].start, spans[w].end)
      if percentOf(word).isNone() {
        let used = numberLength(word)
        if used == 0 || used != word.length {
          return 0
        }
        numbers = numbers + 1
      }
      w = w + 1
    }
    if numbers != 1 {
      return 0
    }
    let points: usize = if words == 3 { 2 } else { 1 }
    count = count + points
    at = end + 1
  }
  if count < 2 {
    return 0
  }
  return count
}

fn percentOf(word: &[u8]) -> Option<f32> {
  if word.length < 2 || word[word.length - 1] != 37 {
    return Option<f32>.None
  }
  let digits = part(word, 0, word.length - 1)
  let used = numberLength(digits)
  if used == 0 || used != digits.length {
    return Option<f32>.None
  }
  return Option<f32>.some(numberValue(digits) / 100.0)
}

struct StopsEntry {
  key: u32,
  start: usize,
  count: usize,
}

impl Copy for StopsEntry {}

fn timingList(entries: &[TimingEntry], which: u32, text: &[u8]) -> Option<TimingList> {
  let hash = nameHash(text)
  let mut i: usize = 0
  while i < entries.length {
    let entry = &entries[i]
    if entry.which == which && entry.hash == hash && entry.text.length() == text.length {
      let mut at: usize = 0
      while at < text.length && entry.text.asSlice()[at] == text[at] { at = at + 1 }
      if at == text.length { return Option<TimingList>.some(entry.list) }
    }
    i = i + 1
  }
  return Option<TimingList>.None
}

struct TimingEntry { which: u32, hash: u64, text: Bytes, list: TimingList }

/// Interned motion lists and `linear()` points. Indices stay valid for the tree's lifetime.
pub struct EasingStops {
  entries: List<StopsEntry>,
  /// (input, output) pairs.
  points: List<f32>,
  transitionEntries: List<TimingEntry>,
  transitionValues: List<TransitionItem>,
  animationEntries: List<TimingEntry>,
  animationValues: List<AnimationSpec>,
}

impl EasingStops {
  pub fn make() -> EasingStops {
    return EasingStops { entries: List<StopsEntry>.make(), points: List<f32>.make(), transitionEntries: List<TimingEntry>.make(), transitionValues: List<TransitionItem>.make(), animationEntries: List<TimingEntry>.make(), animationValues: List<AnimationSpec>.make() }
  }

  pub fn transitionItem(self: &Self, list: TimingList, index: usize) -> TransitionItem {
    if list.start == usize.MAX { return TransitionItem.initial() }
    return self.transitionValues.asSlice()[list.start + index % list.count]
  }

  pub fn transitionList(self: &Self, which: u32, text: &[u8]) -> Option<TimingList> {
    return timingList(self.transitionEntries.asSlice(), which, text)
  }

  pub fn animationItem(self: &Self, list: TimingList, index: usize) -> AnimationSpec {
    if list.start == usize.MAX { return AnimationSpec.initial() }
    return self.animationValues.asSlice()[list.start + index % list.count]
  }

  pub fn animationList(self: &Self, which: u32, text: &[u8]) -> Option<TimingList> {
    return timingList(self.animationEntries.asSlice(), which, text)
  }

  pub effect fn keepAnimation(self: &mut Self, which: u32, text: &[u8], values: &[AnimationSpec]) -> TimingList
    ! OutOfMemoryError ? &mut Allocator {
    let list = TimingList { start: self.animationValues.length(), count: values.length }
    let entry = TimingEntry { which: which, hash: nameHash(text), text: run Bytes.copy(text), list: list }
    run self.animationValues.appendSlice(values)
    run self.animationEntries.append(move entry)
    return list
  }

  pub effect fn keepTransition(self: &mut Self, which: u32, text: &[u8], values: &[TransitionItem]) -> TimingList
    ! OutOfMemoryError ? &mut Allocator {
    let list = TimingList { start: self.transitionValues.length(), count: values.length }
    let entry = TimingEntry { which: which, hash: nameHash(text), text: run Bytes.copy(text), list: list }
    run self.transitionValues.appendSlice(values)
    run self.transitionEntries.append(move entry)
    return list
  }

  fn find(self: &Self, key: u32) -> usize {
    let entries = self.entries.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      if entries[i].key == key {
        return i
      }
      i = i + 1
    }
    return entries.length
  }

  /// Reads the points of every `linear(...)` with stops in CSS `text`.
  pub effect fn read(self: &mut Self, text: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i + 7 <= text.length {
      let starts = (i == 0 || !isNameByte(text[i - 1])) && named(part(text, i, i + 7), b"linear(")
      if !starts {
        i = i + 1
        continue
      }
      let close = closing(text, i + 6)
      if close >= text.length {
        return ()
      }
      let function = part(text, i, close + 1)
      let key = stopsKey(function)
      if self.find(key) == self.entries.length() {
        let count = linearPoints(function)
        if count >= 2 {
          let start = self.points.length()
          run self.points.appendRepeated(0.0, count * 2)
          fillPoints(function, Slice.viewMut<f32>(self.points.asMutSlice(), start, count * 2))
          run self.entries.append(StopsEntry { key: key, start: start, count: count })
        }
      }
      i = close + 1
    }
  }

  /// The output of the easing with key `key` at input `p`; `p` itself for an unknown key.
  pub fn at(self: &Self, key: u32, p: f32) -> f32 {
    let index = self.find(key)
    if index == self.entries.length() {
      return p
    }
    let entry = self.entries.get(index)
    let points = Slice.view<f32>(self.points.asSlice(), entry.start, entry.count * 2)
    return linearAt(points, entry.count, p)
  }
}

fn isNameByte(byte: u8) -> bool {
  return isDigit(byte) || byte == 45 || byte == 95 || (lower(byte) >= 97 && lower(byte) <= 122)
}

// The index of the parenthesis that closes the one at `open`.
fn closing(text: &[u8], open: usize) -> usize {
  let mut depth: u32 = 0
  let mut i = open
  while i < text.length {
    if text[i] == 40 {
      depth = depth + 1
    } else if text[i] == 41 {
      depth = depth - 1
      if depth == 0 {
        return i
      }
    }
    i = i + 1
  }
  return text.length
}

const MISSING: f32 = -1.0e30

// Writes the points of valid `linear(...)` text into `out` (two floats each), filling in
// missing inputs: the first is 0, the last 1, each at least the largest before it, and runs
// of missing ones spread evenly between their neighbours.
fn fillPoints(text: &[u8], out: &mut [f32]) -> () {
  let inner = part(text, 7, text.length - 1)
  let mut n: usize = 0
  let mut at: usize = 0
  while at <= inner.length {
    let end = itemEnd(inner, at, true)
    let mut spans = [Span { start: 0, end: 0 }; 8]
    let item = part(inner, at, end)
    let words = words(item, &mut spans)
    let mut output: f32 = 0.0
    let mut inputs = [MISSING, MISSING]
    let mut seen: usize = 0
    let mut w: usize = 0
    while w < words {
      let word = part(item, spans[w].start, spans[w].end)
      match percentOf(word) {
        Option<f32>.Some { value } => {
          inputs[seen] = value
          seen = seen + 1
        }
        Option<f32>.None => {
          output = numberValue(word)
        }
      }
      w = w + 1
    }
    out[n * 2] = inputs[0]
    out[n * 2 + 1] = output
    n = n + 1
    if seen == 2 {
      out[n * 2] = inputs[1]
      out[n * 2 + 1] = output
      n = n + 1
    }
    at = end + 1
  }
  if out[0] == MISSING {
    out[0] = 0.0
  }
  if out[(n - 1) * 2] == MISSING {
    out[(n - 1) * 2] = 1.0
  }
  let mut largest = out[0]
  let mut i: usize = 1
  while i < n {
    if out[i * 2] != MISSING {
      if out[i * 2] < largest {
        out[i * 2] = largest
      }
      largest = out[i * 2]
    }
    i = i + 1
  }
  i = 1
  while i < n {
    if out[i * 2] == MISSING {
      let mut j = i
      while out[j * 2] == MISSING {
        j = j + 1
      }
      let from = out[(i - 1) * 2]
      let to = out[j * 2]
      let gaps = usize.toF32(j - i + 1)
      let mut k = i
      while k < j {
        out[k * 2] = from + (to - from) * usize.toF32(k - i + 1) / gaps
        k = k + 1
      }
      i = j
    }
    i = i + 1
  }
}

// The piecewise linear function through `count` points at `p`, extended past its ends along
// its first and last segments.
fn linearAt(points: &[f32], count: usize, p: f32) -> f32 {
  // The last point whose input is at most p.
  let mut a: usize = 0
  let mut matched = false
  let mut i: usize = 0
  while i < count {
    if points[i * 2] == p {
      a = i
      matched = true
    } else if points[i * 2] < p {
      a = i
    }
    i = i + 1
  }
  if matched {
    return points[a * 2 + 1]
  }
  if p < points[0] {
    a = 0
  } else if a == count - 1 {
    a = count - 2
  }
  let x0 = points[a * 2]
  let y0 = points[a * 2 + 1]
  let x1 = points[(a + 1) * 2]
  let y1 = points[(a + 1) * 2 + 1]
  if x1 == x0 {
    return y1
  }
  return y0 + (y1 - y0) * (p - x0) / (x1 - x0)
}

/// The space-separated words of `text`, at most 8. Returns the count.
pub fn words(text: &[u8], out: &mut [Span; 8]) -> usize {
  let mut count: usize = 0
  let mut at = trimStart(text, 0, text.length)
  while at < text.length && count < 8 {
    let end = itemEnd(text, at, false)
    out[count] = Span { start: at, end: end }
    count = count + 1
    at = trimStart(text, end, text.length)
  }
  return count
}

// Animations.

pub const NORMAL: u8 = 0
pub const REVERSE: u8 = 1
pub const ALTERNATE: u8 = 2
pub const ALTERNATE_REVERSE: u8 = 3

pub const FILL_NONE: u8 = 0
pub const FILL_FORWARDS: u8 = 1
pub const FILL_BACKWARDS: u8 = 2
pub const FILL_BOTH: u8 = 3

/// `animation-iteration-count: infinite`.
pub const INFINITE: f32 = -1.0

/// The `animation-*` lists of a computed style. Names are hashed (see `nameHash`); 0 is
/// `none`.
pub struct AnimationLists {
  pub names: TimingList,
  pub durations: TimingList,
  pub delays: TimingList,
  pub easings: TimingList,
  pub iterations: TimingList,
  pub directions: TimingList,
  pub fills: TimingList,
  pub paused: TimingList,
}

impl Copy for AnimationLists {}

/// What one entry of the `animation-*` lists asks for.
pub struct AnimationSpec {
  pub name: u64,
  pub duration: f32,
  pub delay: f32,
  pub easing: Easing,
  pub iterations: f32,
  pub direction: u8,
  pub fill: u8,
  pub paused: bool,
}

impl Copy for AnimationSpec {}

impl AnimationSpec {
  pub fn initial() -> AnimationSpec {
    return AnimationSpec { name: 0, duration: 0.0, delay: 0.0, easing: Easing.ease(), iterations: 1.0, direction: NORMAL, fill: FILL_NONE, paused: false }
  }
}

impl AnimationLists {
  pub fn initial() -> AnimationLists {
    let initial = TimingList.initial()
    return AnimationLists {
      names: initial, durations: initial, delays: initial, easings: initial,
      iterations: initial, directions: initial, fills: initial, paused: initial,
    }
  }

  pub fn any(self: &Self, store: &EasingStops) -> bool {
    if self.names.start == usize.MAX { return false }
    let mut i: usize = 0
    while i < self.names.count {
      if store.animationItem(self.names, i).name != 0 { return true }
      i = i + 1
    }
    return false
  }

  pub fn spec(self: &Self, index: usize, store: &EasingStops) -> AnimationSpec {
    return AnimationSpec {
      name: store.animationItem(self.names, index).name,
      duration: store.animationItem(self.durations, index).duration,
      delay: store.animationItem(self.delays, index).delay,
      easing: store.animationItem(self.easings, index).easing,
      iterations: store.animationItem(self.iterations, index).iterations,
      direction: store.animationItem(self.directions, index).direction,
      fill: store.animationItem(self.fills, index).fill,
      paused: store.animationItem(self.paused, index).paused,
    }
  }
}

/// The hash `animation-name` and `@keyframes` names meet by (FNV-1a; never 0).
pub fn nameHash(name: &[u8]) -> u64 {
  let mut hash: u64 = 0xcbf29ce484222325
  let mut i: usize = 0
  while i < name.length {
    hash = u64.wrappingMultiply(u64.bitXor(hash, u8.toU64(name[i])), 0x100000001b3)
    i = i + 1
  }
  return if hash == 0 {
    1
  } else {
    hash
  }
}

fn hashByte(hash: u64, byte: u32) -> u64 {
  return u64.wrappingMultiply(u64.bitXor(hash, u32.toU64(byte)), 0x100000001b3)
}

fn hashScalar(hash: u64, scalar: u32) -> u64 {
  if scalar < 128 { return hashByte(hash, scalar) }
  if scalar < 2048 { return hashByte(hashByte(hash, 192 | u32.shiftRight(scalar, 6)), 128 | (scalar & 63)) }
  if scalar < 65536 { return hashByte(hashByte(hashByte(hash, 224 | u32.shiftRight(scalar, 12)), 128 | (u32.shiftRight(scalar, 6) & 63)), 128 | (scalar & 63)) }
  return hashByte(hashByte(hashByte(hashByte(hash, 240 | u32.shiftRight(scalar, 18)), 128 | (u32.shiftRight(scalar, 12) & 63)), 128 | (u32.shiftRight(scalar, 6) & 63)), 128 | (scalar & 63))
}

fn cssNameHash(text: &[u8]) -> u64 {
  let name = unquoted(text)
  let mut hash: u64 = 0xcbf29ce484222325
  let mut at: usize = 0
  while at < name.length {
    if name[at] != 92 { hash = hashByte(hash, u8.toU32(name[at]))
      at = at + 1
      continue }
    let end = escapeEnd(name, at)
    at = at + 1
    if at == name.length { hash = hashScalar(hash, 65533)
      break }
    if hex(name[at]) == 16 {
      if name[at] != 10 && name[at] != 13 && name[at] != 12 { hash = hashByte(hash, u8.toU32(name[at])) }
    } else {
      let mut scalar: u32 = 0
      let mut count: usize = 0
      while at < name.length && count < 6 && hex(name[at]) != 16 {
        scalar = scalar * 16 + hex(name[at])
        at = at + 1
        count = count + 1
      }
      if scalar == 0 || scalar > 1114111 || (scalar >= 55296 && scalar <= 57343) { scalar = 65533 }
      hash = hashScalar(hash, scalar)
    }
    at = end
  }
  return if hash == 0 { 1 } else { hash }
}

fn direction(word: &[u8]) -> u8 {
  if named(word, b"normal") {
    return NORMAL
  }
  if named(word, b"reverse") {
    return REVERSE
  }
  if named(word, b"alternate") {
    return ALTERNATE
  }
  if named(word, b"alternate-reverse") {
    return ALTERNATE_REVERSE
  }
  return 255
}

fn fill(word: &[u8]) -> u8 {
  if named(word, b"none") {
    return FILL_NONE
  }
  if named(word, b"forwards") {
    return FILL_FORWARDS
  }
  if named(word, b"backwards") {
    return FILL_BACKWARDS
  }
  if named(word, b"both") {
    return FILL_BOTH
  }
  return 255
}

fn iterations(word: &[u8]) -> Option<f32> {
  if named(word, b"infinite") {
    return Option<f32>.some(INFINITE)
  }
  let used = numberLength(word)
  if used == 0 || used != word.length {
    return Option<f32>.None
  }
  let value = numberValue(word)
  if value < 0.0 {
    return Option<f32>.None
  }
  return Option<f32>.some(value)
}

pub const ANIMATION: u32 = 0
pub const ANIMATION_NAME: u32 = 1
pub const ANIMATION_DURATION: u32 = 2
pub const ANIMATION_TIMING: u32 = 3
pub const ANIMATION_DELAY: u32 = 4
pub const ANIMATION_ITERATIONS: u32 = 5
pub const ANIMATION_DIRECTION: u32 = 6
pub const ANIMATION_FILL: u32 = 7
pub const ANIMATION_PLAY_STATE: u32 = 8

/// Sets the lists that `which` (`ANIMATION`, `ANIMATION_NAME`, ...) declares as CSS `text`.
/// An invalid value leaves them as they were.
pub effect fn declareAnimation(lists: &mut AnimationLists, which: u32, text: &[u8], store: &mut EasingStops) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  if let Option<TimingList>.Some { value } = store.animationList(which, text) {
    assignAnimation(&mut lists, which, value)
    return ()
  }
  let mut parsed = List<AnimationSpec>.make()
  let mut at: usize = 0
  while at <= text.length {
    let end = itemEnd(text, at, true)
    let item = trimmed(part(text, at, end))
    if item.length == 0 { return () }
    let mut next = AnimationSpec.initial()
    if which == ANIMATION {
      if !animationItem(&mut next, item) {
        return ()
      }
    } else if which == ANIMATION_NAME {
      next.name = if named(item, b"none") {
        0
      } else {
        cssNameHash(item)
      }
    } else if which == ANIMATION_DURATION {
      match time(item) {
        Option<f32>.Some { value } => {
          if value < 0.0 {
            return ()
          }
          next.duration = value
        }
        Option<f32>.None => {
          return ()
        }
      }
    } else if which == ANIMATION_DELAY {
      match time(item) {
        Option<f32>.Some { value } => {
          next.delay = value
        }
        Option<f32>.None => {
          return ()
        }
      }
    } else if which == ANIMATION_TIMING {
      match easing(item) {
        Option<Easing>.Some { value } => {
          next.easing = value
        }
        Option<Easing>.None => {
          return ()
        }
      }
    } else if which == ANIMATION_ITERATIONS {
      match iterations(item) {
        Option<f32>.Some { value } => {
          next.iterations = value
        }
        Option<f32>.None => {
          return ()
        }
      }
    } else if which == ANIMATION_DIRECTION {
      let found = direction(item)
      if found == 255 {
        return ()
      }
      next.direction = found
    } else if which == ANIMATION_FILL {
      let found = fill(item)
      if found == 255 {
        return ()
      }
      next.fill = found
    } else {
      if named(item, b"paused") {
        next.paused = true
      } else if named(item, b"running") {
        next.paused = false
      } else {
        return ()
      }
    }
    run parsed.append(next)
    at = end + 1
  }
  let kept = run store.keepAnimation(which, text, parsed.asSlice())
  assignAnimation(&mut lists, which, kept)
}

fn assignAnimation(lists: &mut AnimationLists, which: u32, list: TimingList) -> () {
  if which == ANIMATION || which == ANIMATION_NAME { lists.names = list }
  if which == ANIMATION || which == ANIMATION_DURATION { lists.durations = list }
  if which == ANIMATION || which == ANIMATION_DELAY { lists.delays = list }
  if which == ANIMATION || which == ANIMATION_TIMING { lists.easings = list }
  if which == ANIMATION || which == ANIMATION_ITERATIONS { lists.iterations = list }
  if which == ANIMATION || which == ANIMATION_DIRECTION { lists.directions = list }
  if which == ANIMATION || which == ANIMATION_FILL { lists.fills = list }
  if which == ANIMATION || which == ANIMATION_PLAY_STATE { lists.paused = list }
}

/// A name without the quotes of a `<string>`.
pub fn unquoted(name: &[u8]) -> &[u8] {
  if name.length >= 2 && (name[0] == 34 || name[0] == 39) && name[name.length - 1] == name[0] {
    return part(name, 1, name.length - 1)
  }
  return name
}

// One item of the `animation` shorthand. Keywords fill the other longhands first, as the
// grammar says, and the identifier left is the name.
fn animationItem(next: &mut AnimationSpec, item: &[u8]) -> bool {
  let mut spans = [Span { start: 0, end: 0 }; 8]
  let count = words(item, &mut spans)
  if count == 8 && trimmed(part(item, spans[7].end, item.length)).length != 0 { return false }
  next.name = 0
  next.duration = 0.0
  next.delay = 0.0
  next.easing = Easing.ease()
  next.iterations = 1.0
  next.direction = NORMAL
  next.fill = FILL_NONE
  next.paused = false
  let mut times: u32 = 0
  let mut eased = false
  let mut counted = false
  let mut directed = false
  let mut filled = false
  let mut played = false
  let mut hasName = false
  let mut i: usize = 0
  while i < count {
    let word = part(item, spans[i].start, spans[i].end)
    let mut done = false
    if times < 2 {
      match time(word) {
        Option<f32>.Some { value } => {
          if times == 0 {
            if value < 0.0 {
              return false
            }
            next.duration = value
          } else {
            next.delay = value
          }
          times = times + 1
          done = true
        }
        Option<f32>.None => {}
      }
    }
    if !done && !eased {
      match easing(word) {
        Option<Easing>.Some { value } => {
          next.easing = value
          eased = true
          done = true
        }
        Option<Easing>.None => {}
      }
    }
    if !done && !counted {
      match iterations(word) {
        Option<f32>.Some { value } => {
          next.iterations = value
          counted = true
          done = true
        }
        Option<f32>.None => {}
      }
    }
    if !done && !directed && direction(word) != 255 {
      next.direction = direction(word)
      directed = true
      done = true
    }
    if !done && !filled && fill(word) != 255 && !(fill(word) == FILL_NONE && filled) {
      next.fill = fill(word)
      filled = true
      done = true
    }
    if !done && !played && (named(word, b"running") || named(word, b"paused")) {
      next.paused = named(word, b"paused")
      played = true
      done = true
    }
    if !done {
      if hasName {
        return false
      }
      hasName = true
      next.name = if named(word, b"none") { 0 } else { cssNameHash(word) }
    }
    i = i + 1
  }
  return true
}
