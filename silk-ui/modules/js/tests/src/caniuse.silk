//! The evidence for the `javascript` and `javascript-apis` answers of the docs' Can I use
//! page: `fixtures/caniuse.js` runs one check per caniuse feature in the realm a Silk UI app
//! gets, and fails when a check disagrees with what the page says.
import ui_js.lib { JsHost, JsError, uiPackage }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_libc_platform as platform
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.io.writer_native { StderrWriter }
import silk.io.writer { Writer }

effect fn checks(host: &mut JsHost<'_>) -> () ! OutOfMemoryError | JsError | platform.PlatformError ? &mut Allocator {
  run host.define(b"@silkui/core", uiPackage())
  run host.define(b"caniuse/dependency.js", b"export const value = 42; export default 'module';")
  let source = run platform.readFile(b"modules/js/tests/fixtures/caniuse.js")
  run host.module(source.asSlice(), b"caniuse/checks.js")
  // Checks that wait on timers and animation frames settle over a few ticks of the clock.
  run host.tick(0.5, true)
  run host.tick(1.0, true)
  run host.tick(1.5, true)
  run host.tick(2.0, true)
  run host.drain()
  run host.evaluate(b"caniuseFinish()", b"caniuse/finish.js")
}

effect fn run_() -> () ! OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError ? &mut Allocator {
  let domain = run WaiterDomain.make()
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut host = run JsHost.open(&memory, domain.handle()) |> Effect.provideMut<Allocator>(&mut allocator)
  let ran = run Effect.result(checks(&mut host)) |> Effect.provideMut<Allocator>(&mut allocator)
  run host.close() |> Effect.provideMut<Allocator>(&mut allocator)
  match move ran {
    Result<(), OutOfMemoryError | JsError | platform.PlatformError>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsError | platform.PlatformError>.Failure { error } => {
      match &error { JsError { message } => {
        let mut writer = StderrWriter.make()
        drop run Effect.result(Writer.writeString(String.view(&message))) |> Effect.provideMut<Writer>(&mut writer)
      } _ => () }
      fail move error
    }
  }
}

/// Every check of `fixtures/caniuse.js` agrees with the page: a feature the page says works
/// passes its check, and one it says is missing fails it.
test effect fn javascriptCanIUseChecks() -> () ! OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run run_() |> Effect.provideMut<Allocator>(&mut allocator)
}
