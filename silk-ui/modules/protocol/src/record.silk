//! The event record a tree queues for its client, in the flat form that travels: one struct
//! with a kind and every payload field. `event.EventRecord` is the typed reading of it.
import silk.collections.list { List }
import silk.geometry.rect { Rect }
import silk.text.string { String }
import rich { MarkSpan, Atom }

pub enum EventKind {
  PointerDown,
  PointerUp,
  Click,
  PointerMove,
  PointerEnter,
  PointerLeave,
  Wheel,
  KeyDown,
  KeyUp,
  Focus,
  Blur,
  Input,
  Scroll,
  /// The target border box changed after layout; does not bubble.
  Layout,
  /// The press ended without a release (`Input.PointerCancel`). No click follows.
  PointerCancel,
  /// The node took the pointer capture of the press (`Mutation.SetPointerCapture`).
  GotPointerCapture,
  /// The node lost a capture it took: it was released, another node took it, or the press
  /// ended.
  LostPointerCapture,
  /// The target's image or icon source loaded. Does not bubble.
  Load,
  /// The target's image or icon source failed to load or decode. Does not bubble.
  Error,
  /// A transition was created, as DOM `transitionrun`: it may still wait for its delay.
  TransitionRun,
  /// A transition left its delay, as DOM `transitionstart`.
  TransitionStart,
  /// A transition finished, as DOM `transitionend`.
  TransitionEnd,
  /// A transition was removed before it finished, as DOM `transitioncancel`.
  TransitionCancel,
  /// A keyframe animation left its delay, as DOM `animationstart`.
  AnimationStart,
  /// A keyframe animation began another iteration, as DOM `animationiteration`.
  AnimationIteration,
  /// A keyframe animation finished, as DOM `animationend`.
  AnimationEnd,
  /// A keyframe animation was removed before it finished, as DOM `animationcancel`.
  AnimationCancel,
  /// The focused input's selection moved, or a rich input's typing marks changed, as DOM
  /// `selectionchange` at an input. It follows the `Input` record of an edit.
  SelectionChange,
  /// The pointer moved onto the target, which is the deepest node under it now, as DOM
  /// `pointerover`. It follows `PointerOut` and comes before the enter records.
  PointerOver,
  /// The pointer moved off the target, the deepest node it was over, as DOM `pointerout`.
  PointerOut,
  /// A finger touched the screen, as DOM `touchstart`. Touch records go to the node the finger
  /// went down on until it lifts, and follow the finger's pointer records. `detail` is 1 when
  /// a handler can still prevent the tree's pan (and the tap's click).
  TouchStart,
  /// A finger moved, as DOM `touchmove`. `detail` is 0 once the tree pans.
  TouchMove,
  /// A finger lifted, as DOM `touchend`.
  TouchEnd,
  /// The host took a finger away, as DOM `touchcancel`.
  TouchCancel,
  /// Copy, cut and paste at the focused node, as DOM `ClipboardEvent`; they bubble. A paste
  /// record carries the clipboard in `value`, `html` and `image`.
  Copy,
  Cut,
  Paste,
  /// An edit is about to change the target input, as DOM `beforeinput`; it bubbles. It has
  /// `inputType`, and the text it inserts in `value`.
  BeforeInput,
  /// Something asked to close what is on top, as a browser's close request (Escape). It
  /// bubbles from the node the request started at. The tree does nothing by itself: the
  /// listener that closes something stops the record there.
  CloseRequest,
  /// Something asked to go back (`detail` 0) or forward (`detail` 1), as a browser's
  /// `navigate` event for a history traversal. It bubbles as `CloseRequest` does.
  Navigate,
}

/// An event record for the client. `path` holds the node ids from the root to the target, so
/// the client can run capture and bubbling over it.
///
/// Pointer down, up, move, click and wheel records and key records are queued when the target
/// or any node on its path listens for them (they bubble). Enter, leave, focus, blur and scroll
/// records are queued only for a target that listens itself.
pub struct Event {
  pub kind: EventKind,
  pub target: u32,
  /// The measured viewport-relative border box in CSS pixels, for Layout records.
  pub bounds: Rect<f32>,
  pub path: List<u32>,
  /// The pointer in CSS pixels of the viewport, for pointer and wheel records. For `Scroll`
  /// records, the container's new scroll offset.
  pub x: f32,
  pub y: f32,
  /// `MOD_*` bits.
  pub modifiers: u32,
  /// The button of pointer down, up and click records (`BUTTON_*`).
  pub button: u32,
  /// The DOM `pointerId` of pointer records: `MOUSE_POINTER_ID` for the mouse, 2 and up for
  /// touches.
  pub pointerId: u32,
  /// `POINTER_MOUSE`, `POINTER_PEN` or `POINTER_TOUCH`.
  pub pointerType: u32,
  /// For pointer records at a live svg: the number of its element under the pointer (the
  /// deepest shape drawn there), 0 when the pointer is over none of them.
  pub element: u32,
  /// Whether the pointer is the primary one of its type, as DOM `isPrimary`: the mouse, and
  /// the first finger of a touch.
  pub primary: bool,
  /// The click count of pointer down and click records: 1 for a single click, 2 for a double
  /// click, 0 for a click made with the keyboard.
  pub detail: u32,
  /// The wheel delta of `Wheel` records in CSS pixels, positive down and right.
  pub deltaX: f32,
  pub deltaY: f32,
  /// The UI Events `key` and `code` of key records.
  pub key: String,
  pub code: String,
  pub repeat: bool,
  /// The value of an input after the change an `Input` record reports.
  pub value: String,
  /// What the change was, named as DOM `InputEvent.inputType` names it: `insertText`,
  /// `insertLineBreak`, `insertFromPaste`, `deleteContentBackward`, `deleteContentForward`,
  /// `deleteWordBackward`, `deleteWordForward`, `deleteSoftLineBackward`,
  /// `deleteSoftLineForward`, `deleteByCut`, `deleteByComposition`, `historyUndo` or
  /// `historyRedo`.
  pub inputType: String,
  /// The selection of an `Input` or `SelectionChange` record's input after the change:
  /// UTF-8 byte offsets into its value, start before end.
  pub selectionStart: usize,
  pub selectionEnd: usize,
  /// The CSS property of transition records (`opacity`, `margin-top`), and the
  /// `@keyframes` name of animation records.
  pub name: String,
  /// Seconds the transition or animation had run, not counting its delay, as DOM
  /// `elapsedTime`.
  pub elapsedTime: f32,
  /// Empty for an element, otherwise the generated target ("::before" or "::after").
  pub pseudoElement: String,
  /// For an `Input` record of a rich input: the marks of its runs and its atoms, in order.
  /// Empty for a plain input.
  pub marks: List<MarkSpan>,
  pub atoms: List<Atom>,
  /// The marks text typed at the caret would get (`Input` and `SelectionChange` records).
  pub activeMarks: u32,
  /// The `text/html` and `image/png` flavors of a `Paste` record (its `text/plain` is
  /// `value`). Empty when the clipboard had none.
  pub html: String,
  pub image: List<u8>,
}

impl Event {
  /// A record of `kind` for `target` with every payload field empty.
  pub fn make(kind: EventKind, target: u32, path: List<u32>) -> Event {
    return Event {
      kind: kind,
      target: target,
      bounds: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
      path: move path,
      x: 0.0,
      y: 0.0,
      modifiers: 0,
      button: 0,
      pointerId: 1,
      pointerType: 0,
      element: 0,
      primary: true,
      detail: 0,
      deltaX: 0.0,
      deltaY: 0.0,
      key: String.make(),
      code: String.make(),
      repeat: false,
      value: String.make(),
      inputType: String.make(),
      selectionStart: 0,
      selectionEnd: 0,
      name: String.make(),
      elapsedTime: 0.0,
      pseudoElement: String.make(),
      marks: List<MarkSpan>.make(),
      atoms: List<Atom>.make(),
      activeMarks: 0,
      html: String.make(),
      image: List<u8>.make(),
    }
  }
}
