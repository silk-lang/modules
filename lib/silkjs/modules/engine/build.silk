import silk.build.plan { Plan }
import silk.build.step { sourcePath }

static fn plan() -> Plan {
  let mut plan = Plan.empty()
  plan = plan |> Plan.compileNative("c", sourcePath("native/text_align.c"), &[], &[])
  plan = plan |> Plan.functionOrder(sourcePath("startup.order"))
  return plan
}

pub const PLAN: Plan = plan()
