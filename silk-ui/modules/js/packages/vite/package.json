{
  "name": "@silkui/vite",
  "version": "0.1.15",
  "description": "Vite plugin that builds a ui-js application and reloads it in the native window",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silk-lang/SilkUI.git",
    "directory": "modules/js/packages/vite"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "silkui-natives": "bin/silkui-natives.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.js"
      ],
      "compilerOptions": [],
      "dynamicConfig": false
    }
  },
  "dependencies": {
    "ts-content-mapper": "0.1.1"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "license": "MIT",
  "scripts": {
    "build:compiler": "silk task --manifest-path compiler/silk.toml sync-wasm"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5"
  }
}
