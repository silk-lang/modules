//! CSS lists and counters: `display: list-item` markers, `list-style-*`, `::marker`, and
//! `counter-reset`, `counter-increment`, `counter-set` with `counter()` and `counters()`.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, Mutation }
import ui_tree.inspect
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.tokens { CssError }
import svg_css.written
import ui_fixtures.fixtures as fixtures
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.num.u32

const NONE: u32 = u32.MAX

fn markerOf(tree: &UiTree<'_>, id: u32) -> u32 {
  return match tree.node(tree.slotOf(id)).identity() { Option.Some { value } => value.marker _ => NONE }
}
fn textOf<'a>(tree: &'a UiTree<'_>, box: u32) -> string<'a> {
  if box == NONE { return "<none>" }
  let child = tree.slotOfCssNode(tree.layout.firstChild(tree.node(box).css))
  return String.view(&tree.node(child).text)
}
fn beforeOf(tree: &UiTree<'_>, id: u32) -> u32 {
  return match tree.node(tree.slotOf(id)).identity() { Option.Some { value } => value.before _ => NONE }
}
fn marker<'a>(tree: &'a UiTree<'_>, id: u32) -> string<'a> { return textOf(tree, markerOf(tree, id)) }

effect fn node(batch: &mut Batch, parent: u32, id: u32, tag: string, css: &[u8]) -> ()
  ! CssError | OutOfMemoryError ? &mut Allocator {
  run batch.create(id, NodeKind.Box)
  run batch.attribute(id, Attribute.Element { name: run String.copy(tag) })
  let declarations = run written.declarations(css)
  run batch.style(id, declarations.asSlice())
  run batch.append(parent, id)
}
effect fn named(batch: &mut Batch, id: u32, name: string, value: string) -> () ! OutOfMemoryError ? &mut Allocator {
  run batch.attribute(id, Attribute.Named { name: run String.copy(name), value: Option<String>.some(run String.copy(value)) })
}
effect fn restyle(tree: &mut UiTree<'_>, id: u32, css: &[u8]) -> () ! TreeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  let declarations = run written.declarations(css)
  run batch.style(id, declarations.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 400.0, height: 600.0, scale: 1.0, time: 0.0 })
}
effect fn boundsOf(tree: &UiTree<'_>, slot: u32) -> Option<inspect.NodeInfo> ! OutOfMemoryError ? &mut Allocator {
  return run inspect.infoSlot(tree, slot)
}

effect fn markersFromStyles() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let item = b"display: list-item; font-size: 16px; line-height: 20px"
  run node(&mut batch, 1, 2, "ol", b"display: block; padding-left: 40px; width: 300px; list-style-type: decimal")
  run node(&mut batch, 2, 3, "li", item)
  run batch.text(3, 100, "One")
  run node(&mut batch, 2, 4, "li", item)
  run batch.text(4, 101, "Two")
  // A nested list counts on its own, in its own style.
  run node(&mut batch, 4, 5, "ol", b"display: block; padding-left: 40px; list-style-type: lower-alpha")
  run node(&mut batch, 5, 6, "li", item)
  run node(&mut batch, 5, 7, "li", item)
  run node(&mut batch, 2, 8, "li", item)
  run named(&mut batch, 8, "value", "10")
  run node(&mut batch, 2, 9, "li", item)
  // li > p: the marker sits on the paragraph's first line.
  run node(&mut batch, 2, 10, "li", item)
  run node(&mut batch, 10, 11, "p", b"display: block; margin-top: 12px")
  run batch.text(11, 102, "Para")
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 400.0, height: 600.0, scale: 1.0, time: 0.0 })
  run Testing.expect(marker(&tree, 3) == "1. " && marker(&tree, 4) == "2. ", "list items count from one")
  run Testing.expect(marker(&tree, 6) == "a. " && marker(&tree, 7) == "b. ", "a nested ol restarts its count in its own style")
  run Testing.expect(marker(&tree, 8) == "10. " && marker(&tree, 9) == "11. ", "value sets the count and the next item follows it")
  run Testing.expect(markerOf(&tree, 2) == NONE, "a block that is not a list item has no marker")
  let first = match run boundsOf(&tree, markerOf(&tree, 3)) { Option.Some { value } => value _ => { run Testing.expect(false, "the marker is laid out")
    return () } }
  let li = match run boundsOf(&tree, tree.slotOf(3)) { Option.Some { value } => value _ => { return () } }
  run Testing.expect(first.laidOut && first.bounds.xMax == li.bounds.xMin && first.bounds.width() > 0.0, "an outside marker ends at the item's start edge")
  run Testing.expect(first.bounds.yMin == li.bounds.yMin, "on the item's first line")
  let text = match run boundsOf(&tree, tree.slotOf(100)) { Option.Some { value } => value _ => { return () } }
  run Testing.expect(text.bounds.xMin == li.bounds.xMin, "and takes no room from the item's text")
  let paragraph = match run boundsOf(&tree, tree.slotOf(11)) { Option.Some { value } => value _ => { return () } }
  let beside = match run boundsOf(&tree, markerOf(&tree, 10)) { Option.Some { value } => value _ => { return () } }
  run Testing.expect(beside.bounds.yMin == paragraph.bounds.yMin, "beside a paragraph's first line, past the paragraph's margin")

  // Inside markers start the item's line; other types; none removes the marker.
  run restyle(&mut tree, 3, b"display: list-item; font-size: 16px; line-height: 20px; list-style: square inside")
  let inside = match run boundsOf(&tree, markerOf(&tree, 3)) { Option.Some { value } => value _ => { return () } }
  let moved = match run boundsOf(&tree, tree.slotOf(100)) { Option.Some { value } => value _ => { return () } }
  run Testing.expect(marker(&tree, 3) == "\u{25aa} " && inside.bounds.xMin == li.bounds.xMin && moved.bounds.xMin == inside.bounds.xMax, "an inside marker is the first box of the line")
  run restyle(&mut tree, 4, b"display: list-item; list-style-type: '\xE2\x86\x92 '")
  run Testing.expect(marker(&tree, 4) == "\u{2192} ", "a string type is the marker's text")
  run restyle(&mut tree, 3, b"display: list-item; list-style-type: none")
  run Testing.expect(markerOf(&tree, 3) == NONE && marker(&tree, 4) == "\u{2192} " && marker(&tree, 8) == "10. ", "list-style-type: none drops the marker but the item still counts")
  run restyle(&mut tree, 9, b"display: block")
  run Testing.expect(markerOf(&tree, 9) == NONE, "an item that stops being one loses its marker")
  run restyle(&mut tree, 2, b"display: block; padding-left: 40px; list-style-type: upper-roman")
  run Testing.expect(marker(&tree, 8) == "X. " && marker(&tree, 6) == "a. ", "the type inherits from the list")

  // Removing an item renumbers the ones after it; start on an ol offsets the count.
  let mut edit = Batch.make()
  run edit.push(Mutation.Remove { id: 8 })
  run named(&mut edit, 2, "start", "5")
  run tree.apply(run edit.take())
  run tree.frame(FrameInput { width: 400.0, height: 600.0, scale: 1.0, time: 0.0 })
  run Testing.expect(marker(&tree, 4) == "\u{2192} " && marker(&tree, 10) == "VII. ", "start offsets the count and removal renumbers")
}

test effect fn listItemsHaveNumberedMarkers() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run markersFromStyles() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn countersFromSheets() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run node(&mut batch, 1, 2, "section", b"")
  run node(&mut batch, 2, 3, "h2", b"")
  run node(&mut batch, 3, 4, "h3", b"")
  run node(&mut batch, 3, 5, "h3", b"")
  run node(&mut batch, 2, 6, "h2", b"")
  run node(&mut batch, 6, 7, "h3", b"")
  run node(&mut batch, 1, 8, "ul", b"")
  run node(&mut batch, 8, 9, "li", b"")
  run node(&mut batch, 8, 10, "li", b"")
  let sheet = run compile.compile(b"section{counter-reset:h2}h2{counter-increment:h2;counter-reset:h3}h3{counter-increment:h3 2}h2::before{content:counter(h2, upper-alpha) '. '}h3::before{content:counters(h2, '.') '-' counter(h3)}li{display:list-item}li::marker{content:'(' counter(list-item) ') ';color:red}li+li::marker{content:none}", &Options.make())
  run Testing.expect(sheet.diagnostics.length() == 0, "the sheet compiles")
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 400.0, height: 600.0, scale: 1.0, time: 0.0 })
  run Testing.expect(textOf(&tree, beforeOf(&tree, 3)) == "A. " && textOf(&tree, beforeOf(&tree, 6)) == "B. ", "counter() with a style")
  run Testing.expect(textOf(&tree, beforeOf(&tree, 4)) == "1-2" && textOf(&tree, beforeOf(&tree, 5)) == "1-4" && textOf(&tree, beforeOf(&tree, 7)) == "2-2", "counters() and a reset per heading")
  run Testing.expect(marker(&tree, 9) == "(1) ", "::marker content replaces the marker")
  let color = tree.node(markerOf(&tree, 9)).computed().text.color
  run Testing.expect(color.r == 1.0 && color.g == 0.0, "::marker styles its box")
  run Testing.expect(markerOf(&tree, 10) == NONE, "::marker content: none drops it")
}

test effect fn countersNumberGeneratedContent() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run countersFromSheets() |> Effect.provideMut<Allocator>(&mut allocator)
}

// CSS Containment 2 §3.3: inside a style-contained element counters from outside are read and
// changed as copies, so the changes stay inside; counters() shows the copy in place of the outer
// counter.
effect fn countersStayInStyleContainment() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run node(&mut batch, 1, 2, "section", b"")
  run node(&mut batch, 2, 3, "p", b"")
  run node(&mut batch, 2, 4, "div", b"")
  run node(&mut batch, 4, 5, "p", b"")
  run node(&mut batch, 4, 6, "p", b"")
  run node(&mut batch, 2, 7, "p", b"")
  let sheet = run compile.compile(b"section{counter-reset:n}p{counter-increment:n}p::before{content:counters(n, '.')}div{contain:style}", &Options.make())
  run Testing.expect(sheet.diagnostics.length() == 0, "the sheet compiles")
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 400.0, height: 600.0, scale: 1.0, time: 0.0 })
  run Testing.expect(textOf(&tree, beforeOf(&tree, 3)) == "1" && textOf(&tree, beforeOf(&tree, 5)) == "2" && textOf(&tree, beforeOf(&tree, 6)) == "3", "a contained element counts on from the counter outside")
  run Testing.expect(textOf(&tree, beforeOf(&tree, 7)) == "2", "but its increments stay inside")
  run restyle(&mut tree, 4, b"contain: none")
  run Testing.expect(textOf(&tree, beforeOf(&tree, 7)) == "4", "without containment they reach out")
}

test effect fn styleContainmentScopesCounters() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run countersStayInStyleContainment() |> Effect.provideMut<Allocator>(&mut allocator)
}
