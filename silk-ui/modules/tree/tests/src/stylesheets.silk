effect fn addRow(tree: &mut UiTree<'_>, id: u32, before: u32) -> ()
  ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(id, NodeKind.Box)
  run batch.attribute(id, Attribute.ClassName { value: run String.copy("row") })
  if before == 0 { run batch.append(1, id) } else { run batch.insertBefore(1, id, before) }
  run tree.apply(run batch.take())
}

effect fn dropNode(tree: &mut UiTree<'_>, id: u32) -> ()
  ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.push(Mutation.Destroy { id: id })
  run tree.apply(run batch.take())
}

effect fn localStructure() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut plain = run UiTree.make(&fonts)
  run rowsTree(&mut plain, b".absent")
  run addRow(&mut plain, 7, 0)
  run Testing.expect(!plain.stylesDirty && !plain.node(plain.slotOf(6)).styleDirty, "an insert under plain rules dirties only the new node")
  run plain.frame(motionFrame(1.0))
  run Testing.expect(rowWidth(&plain, 7) == 20.0 && sameClass(&plain, 6, 7), "the new row takes its sibling's style")
  let mut batch = Batch.make()
  let wide = run written.declarations(b"width:50px;color:blue")
  run batch.style(3, wide.asSlice())
  run plain.apply(run batch.take())
  run Testing.expect(!plain.stylesDirty && !plain.node(plain.slotOf(4)).styleDirty, "a style object dirties only its node")
  run plain.frame(motionFrame(2.0))
  let background: f32 = match plain.node(plain.slotOf(3)).computed().paint.background { Fill.Solid { color } => color.b _ => -1.0 }
  run Testing.expect(rowWidth(&plain, 3) == 50.0 && rowWidth(&plain, 4) == 20.0 && background == 1.0, "the style object joins the node's cascade")
  run dropNode(&mut plain, 2)
  run Testing.expect(!plain.stylesDirty && !plain.stylesPending, "a removal under plain rules restyles nothing")
  run batch.attribute(5, Attribute.TabIndex { value: 0 })
  run plain.apply(run batch.take())
  run plain.frame(motionFrame(3.0))
  run batch.focus(5)
  run plain.apply(run batch.take())
  run Testing.expect(!plain.stylesDirty && plain.node(plain.slotOf(5)).styleDirty && !plain.node(plain.slotOf(1)).styleDirty, "focus dirties only the focused node")

  let mut edge = run UiTree.make(&fonts)
  run rowsTree(&mut edge, b".row:last-child")
  run Testing.expect(sameClass(&edge, 3, 4) && sameClass(&edge, 4, 5) && !sameClass(&edge, 2, 3) && !sameClass(&edge, 5, 6), "rows between the edges share under edge rules")
  run addRow(&mut edge, 7, 0)
  run Testing.expect(!edge.stylesDirty && edge.node(edge.slotOf(6)).styleDirty && !edge.node(edge.slotOf(5)).styleDirty, "an insert under edge rules dirties its neighbours")
  run edge.frame(motionFrame(1.0))
  run Testing.expect(rowWidth(&edge, 6) == 20.0 && rowWidth(&edge, 7) == 25.0 && sameClass(&edge, 5, 6), "the old last child joins the middle rows")
  run dropNode(&mut edge, 7)
  run edge.frame(motionFrame(2.0))
  run Testing.expect(rowWidth(&edge, 6) == 25.0 && rowWidth(&edge, 5) == 20.0, "a removal makes its neighbour the last child")

  let mut index = run UiTree.make(&fonts)
  run rowsTree(&mut index, b".row:nth-child(2)")
  run addRow(&mut index, 7, 2)
  run index.frame(motionFrame(1.0))
  run Testing.expect(rowWidth(&index, 7) == 20.0 && rowWidth(&index, 2) == 25.0 && rowWidth(&index, 3) == 20.0, "an insert shifts indexed rules")
  run dropNode(&mut index, 7)
  run index.frame(motionFrame(2.0))
  run Testing.expect(rowWidth(&index, 2) == 20.0 && rowWidth(&index, 3) == 25.0, "a removal shifts them back")

  let mut next = run UiTree.make(&fonts)
  run rowsTree(&mut next, b".row+.row")
  run addRow(&mut next, 7, 2)
  run next.frame(motionFrame(1.0))
  run Testing.expect(rowWidth(&next, 7) == 20.0 && rowWidth(&next, 2) == 25.0, "an insert reaches the following sibling")
  run dropNode(&mut next, 7)
  run next.frame(motionFrame(2.0))
  run Testing.expect(rowWidth(&next, 2) == 20.0 && rowWidth(&next, 3) == 25.0, "a removal reaches it too")

  let mut empty = run UiTree.make(&fonts)
  run rowsTree(&mut empty, b".row:empty")
  run Testing.expect(sameClass(&empty, 2, 3) && !sameClass(&empty, 3, 4) && sameClass(&empty, 5, 6), "empty rows share apart from the filled one")
  run dropNode(&mut empty, 10)
  run empty.frame(motionFrame(1.0))
  run Testing.expect(rowWidth(&empty, 4) == 25.0, "removing the only child empties its parent")
  run batch.create(11, NodeKind.Box)
  run batch.append(5, 11)
  run empty.apply(run batch.take())
  run empty.frame(motionFrame(2.0))
  run Testing.expect(rowWidth(&empty, 5) == 20.0 && rowWidth(&empty, 6) == 25.0, "a first child fills its parent")
}

test effect fn structureAndStyleObjectsRestyleLocally() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run localStructure() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Whether one holds the other's computed values, copied instead of computed again.
fn sameValues(tree: &UiTree<'_>, first: u32, second: u32) -> bool {
  let one = tree.node(tree.slotOf(first)).computedStamp
  return one != 0 && one == tree.node(tree.slotOf(second)).computedStamp
}

fn wideFrame(time: f64) -> FrameInput {
  return FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: time }
}

effect fn copiedValues() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let mut row: u32 = 10
  while row < 60 {
    run nestedRow(&mut batch, row, "row")
    row = row + 10
  }
  let bytes = run sheetBytes(b".row{height:20px}.cell{height:10px}.icon{width:var(--icon,8px)}.label{width:10vw}.dark{--icon:12px}.on .label{width:90px}.row:hover .icon{width:9px}.slow{transition:width 1s linear}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(0.0))
  run Testing.expect(sameValues(&tree, 10, 20) && sameValues(&tree, 11, 51) && sameValues(&tree, 12, 22) && sameValues(&tree, 13, 53) && sameValues(&tree, 13, 14) && !sameValues(&tree, 12, 13),
    "equal rows and their descendants hold one set of computed values")
  run Testing.expect(rowWidth(&tree, 12) == 8.0 && rowWidth(&tree, 52) == 8.0 && rowWidth(&tree, 13) == 80.0 && rowWidth(&tree, 54) == 80.0, "copied values are the computed ones")
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("dark") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(1.0))
  run Testing.expect(rowWidth(&tree, 12) == 12.0 && rowWidth(&tree, 32) == 12.0 && rowWidth(&tree, 52) == 12.0 && sameValues(&tree, 12, 52), "a changed custom property reaches every copy")
  run tree.frame(wideFrame(2.0))
  run Testing.expect(rowWidth(&tree, 13) == 40.0 && rowWidth(&tree, 34) == 40.0 && rowWidth(&tree, 54) == 40.0, "a resized window reaches every copy")
  run batch.attribute(30, Attribute.ClassName { value: run String.copy("row on") })
  let tall = run written.declarations(b"height:7px")
  run batch.style(41, tall.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(wideFrame(3.0))
  run Testing.expect(rowWidth(&tree, 33) == 90.0 && rowWidth(&tree, 23) == 40.0 && !sameValues(&tree, 30, 20) && !sameValues(&tree, 41, 21) && sameValues(&tree, 21, 11),
    "rows with other inputs compute their own values")
  run Testing.expect(tree.node(tree.slotOf(41)).computed().layout.height.value == 7.0 && tree.node(tree.slotOf(51)).computed().layout.height.value == 10.0, "a style object stays with its node")
  run tree.dispatch(Input.PointerMove { x: 2.0, y: 25.0, modifiers: 0 })
  run tree.frame(wideFrame(4.0))
  run Testing.expect(rowWidth(&tree, 22) == 9.0 && rowWidth(&tree, 12) == 12.0 && rowWidth(&tree, 52) == 12.0 && !sameValues(&tree, 20, 10), "a hovered row computes its own values")
  run batch.focus(50)
  run tree.apply(run batch.take())
  run tree.frame(wideFrame(5.0))
  run Testing.expect(!sameValues(&tree, 50, 10), "a focused row computes its own values")
  run batch.attribute(13, Attribute.ClassName { value: run String.copy("label slow") })
  run batch.attribute(53, Attribute.ClassName { value: run String.copy("label slow") })
  run tree.apply(run batch.take())
  run tree.frame(wideFrame(6.0))
  run Testing.expect(!sameValues(&tree, 13, 53) && rowWidth(&tree, 53) == 40.0, "nodes with transitions compute their own values")
  run batch.attribute(10, Attribute.ClassName { value: run String.copy("row on") })
  run batch.attribute(50, Attribute.ClassName { value: run String.copy("row on") })
  run tree.apply(run batch.take())
  run tree.frame(wideFrame(7.0))
  run tree.frame(wideFrame(7.5))
  run Testing.expect(closeTo(rowWidth(&tree, 13), 65.0) && closeTo(rowWidth(&tree, 53), 65.0) && rowWidth(&tree, 14) == 90.0 && rowWidth(&tree, 24) == 40.0 && rowWidth(&tree, 34) == 90.0,
    "running transitions keep their own values while the rest stay right")
}

test effect fn equalRowsCopyComputedValues() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run copiedValues() |> Effect.provideMut<Allocator>(&mut allocator)
}
