//! Lines of text as css-layout stores them: a text fragment holds many runs (a word, a space),
//! and the lines of a paragraph that hold nothing but text have no fragments of their own.
//! Hit testing, caret positions, selection rectangles and the incremental layout path must read
//! those runs as they read one fragment a word: on wrapped, justified, right-to-left and
//! mixed-font lines.
import ui_tree.css
import ui_tree.css { px }
import ui_tree.legacy { UiTree, TreeError, Batch, FrameInput, NodeKind, Keyword }
import ui_tree.mutation { Declaration, Direction, TextAlign, UnicodeBidi }
import ui_tree.caret as caret
import ui_tree.cssom_view as view
import ui_fixtures.fixtures as fixtures
import font_collection.lib { FontCollection }
import svg_css.cssom_geometry { DOMRect }
import svg_css.cssom_error { CssomError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

const ROOT: u32 = 1
const PARAGRAPH: u32 = 2
const TEXT: u32 = 3
const SPAN: u32 = 4
const SPAN_TEXT: u32 = 5
const TAIL: u32 = 6
const MONO: u32 = 2

const WORDS: string<'static> = "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega"

fn viewport() -> FrameInput {
  return FrameInput { width: 400.0, height: 600.0, scale: 1.0, time: 0.0 }
}

/// A 200 px paragraph (`PARAGRAPH`, styled `style`) holding `text` in one text node (`TEXT`).
effect fn paragraph<'a>(fonts: &'a FontCollection, style: &[Declaration], text: string) -> UiTree<'a>
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(fonts)
  let mut batch = Batch.make()
  run batch.fontFamily(fixtures.SANS, "Noto Sans, sans-serif")
  run batch.fontFamily(MONO, "Geist Mono, monospace")
  run batch.create(ROOT, NodeKind.Box)
  run batch.root(ROOT)
  run batch.style(ROOT, &[css.width(px(400.0)), css.fontFamily(fixtures.SANS), css.fontSize(px(16.0))])
  run batch.box(ROOT, PARAGRAPH, &[css.width(px(200.0)), css.marginLeft(px(20.0)), css.marginTop(px(10.0))])
  run batch.style(PARAGRAPH, style)
  run batch.text(PARAGRAPH, TEXT, text)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  return move tree
}

/// How many lines the pieces sit on, checking that the pieces of one line share its box and
/// that lines follow one another downwards.
effect fn lineCount(pieces: &List<caret.Piece>) -> usize
  ! AssertionError<'static> {
  let values = pieces.asSlice()
  let mut lines: usize = 0
  let mut i: usize = 0
  while i < values.length {
    let p = values[i]
    run Testing.expect(p.lineBottom > p.lineTop, "a line box has a height")
    run Testing.expect(p.top < p.lineBottom && p.bottom > p.lineTop, "a run sits on its line")
    if i == 0 || values[i - 1].line != p.line {
      lines = lines + 1
      if i != 0 {
        run Testing.expect(p.lineTop >= values[i - 1].lineBottom - 0.01, "the next line starts below the one before")
      }
    } else {
      run Testing.expect(
        p.lineTop == values[i - 1].lineTop && p.lineBottom == values[i - 1].lineBottom,
        "the runs of one line share its line box",
      )
    }
    i = i + 1
  }
  return lines
}

/// The runs cover the text in order, with nothing twice.
effect fn coversText(pieces: &List<caret.Piece>, length: usize) -> ()
  ! AssertionError<'static> {
  let values = pieces.asSlice()
  run Testing.expect(values.length != 0 && values[0].start == 0, "the runs start at the text's start")
  let mut i: usize = 1
  while i < values.length {
    run Testing.expect(values[i].start >= values[i - 1].end, "runs follow one another in the text")
    i = i + 1
  }
  run Testing.expect(values[values.length - 1].end == length, "the runs end at the text's end")
}

/// For every offset that starts a cluster inside a run: the caret there, and a point just
/// inside that cluster, which hit testing must send back to the same offset of node `id`.
effect fn roundTrips(tree: &UiTree<'_>, id: u32, target: u32) -> usize
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut pieces = List<caret.Piece>.make()
  run view.textPieces(tree, tree.slotOf(id), &mut pieces)
  let values = pieces.asSlice()
  let mut checked: usize = 0
  let mut i: usize = 0
  while i < values.length {
    let p = values[i]
    let mut d = p.start
    while d < p.end && p.glyphs {
      let rect = caret.caretRect(&tree.provider.text, &pieces, d)
      run Testing.expect(rect.yMin == p.top && rect.yMax == p.bottom, "the caret is as tall as its run")
      run Testing.expect(rect.xMin >= p.x0 - 0.01 && rect.xMin <= p.x1 + 0.01, "the caret is inside its run")
      let next = caret.caretX(&tree.provider.text, &p, d + 1)
      // A point a quarter of the way into the cluster that starts at `d`.
      let x = rect.xMin + (next - rect.xMin) * 0.25
      let y = (p.top + p.bottom) * 0.5
      if f32.abs(next - rect.xMin) > 1.0 {
        run Testing.expect(tree.hitTest(x, y) == target, "a point on a run hits the text's element")
        let found = run view.caretPositionFromPoint(tree, f32.toF64(x), f32.toF64(y))
        run Testing.expect(
          match found {
            Option<view.CaretPosition>.Some { value } => value.offsetNode == id && value.offset == d
            _ => false
          },
          "a point just inside a cluster gives the offset the cluster starts at",
        )
        checked = checked + 1
      }
      d = d + 1
    }
    i = i + 1
  }
  return checked
}

effect fn wrappedBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let tree = run paragraph(&fonts, &[], WORDS)
  let mut pieces = List<caret.Piece>.make()
  run view.textPieces(&tree, tree.slotOf(TEXT), &mut pieces)
  let lines = run lineCount(&pieces)
  run Testing.expect(lines >= 4, "the paragraph wraps onto several lines")
  run coversText(&pieces, String.byteLength(WORDS))
  let values = pieces.asSlice()
  let mut i: usize = 0
  while i < values.length {
    let p = values[i]
    run Testing.expect(!p.rtl, "left to right")
    run Testing.expect(p.x0 >= 20.0 - 0.01 && p.x1 <= 220.0 + 0.01, "inside the paragraph")
    if i != 0 && values[i - 1].line == p.line {
      run Testing.expect(f32.abs(p.x0 - values[i - 1].x1) < 0.01, "runs of a line follow one another")
    } else {
      run Testing.expect(f32.abs(p.x0 - 20.0) < 0.01, "a line starts at the paragraph's left edge")
    }
    i = i + 1
  }
  let checked = run roundTrips(&tree, TEXT, PARAGRAPH)
  run Testing.expect(checked > 80, "most offsets were checked")

  // Outside the runs: right of a line's end there is the paragraph, not the text.
  let first = values[0]
  run Testing.expect(tree.hitTest(first.x0 + 1.0, (first.top + first.bottom) * 0.5) == PARAGRAPH, "the first run")
  run Testing.expect(
    tree.hitTest(300.0, (first.top + first.bottom) * 0.5) == ROOT,
    "right of the paragraph there is the root",
  )
}

test effect fn wrappedLinesHitAndCaret() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run wrappedBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn justifiedBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let tree = run paragraph(&fonts, &[css.textAlign(TextAlign.Justify)], WORDS)
  let mut pieces = List<caret.Piece>.make()
  run view.textPieces(&tree, tree.slotOf(TEXT), &mut pieces)
  let lines = run lineCount(&pieces)
  run Testing.expect(lines >= 4, "the paragraph wraps onto several lines")
  run coversText(&pieces, String.byteLength(WORDS))
  let values = pieces.asSlice()
  let mut justified: usize = 0
  let mut i: usize = 0
  while i < values.length {
    let p = values[i]
    let lineStart = i == 0 || values[i - 1].line != p.line
    let lineEnd = i + 1 == values.length || values[i + 1].line != p.line
    if lineStart {
      run Testing.expect(f32.abs(p.x0 - 20.0) < 0.01, "a justified line starts at the left edge")
    }
    // The last run of every line but the last ends at the right edge (a space that hangs
    // there aside).
    if lineEnd && i + 1 != values.length {
      let mut last = i
      while last > 0 && values[last].line == p.line && values[last].end - values[last].start == 1 && values[last].x1 > 220.01 {
        last = last - 1
      }
      if f32.abs(values[last].x1 - 220.0) < 0.5 {
        justified = justified + 1
      }
    }
    i = i + 1
  }
  run Testing.expect(justified + 1 >= lines - 1, "lines but the last reach the right edge")
  let checked = run roundTrips(&tree, TEXT, PARAGRAPH)
  run Testing.expect(checked > 80, "most offsets were checked")
}

test effect fn justifiedLinesHitAndCaret() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run justifiedBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rightToLeftBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  // Every character right to left, whatever it is: the fixture fonts hold no Arabic or Hebrew.
  let tree = run paragraph(
    &fonts,
    &[css.direction(Direction.Rtl), css.unicodeBidi(UnicodeBidi.BidiOverride)],
    WORDS,
  )
  let mut pieces = List<caret.Piece>.make()
  run view.textPieces(&tree, tree.slotOf(TEXT), &mut pieces)
  let values = pieces.asSlice()
  run Testing.expect(values.length > 8, "the paragraph has runs")
  let mut tops = List<f32>.make()
  let mut reversed: usize = 0
  let mut i: usize = 0
  while i < values.length {
    let p = values[i]
    run Testing.expect(p.rtl, "every run is right to left")
    run Testing.expect(p.x0 >= 20.0 - 0.01 && p.x1 <= 220.0 + 0.01, "inside the paragraph")
    run Testing.expect(
      caret.caretX(&tree.provider.text, &p, p.start) == p.x1,
      "a right-to-left run starts at its right edge",
    )
    let mut seen = false
    let mut t: usize = 0
    while t < tops.length() {
      if tops.get(t) == p.lineTop { seen = true }
      t = t + 1
    }
    if !seen { run tops.append(p.lineTop) }
    // Later text of the same line lies to the left.
    let mut j: usize = 0
    while j < values.length {
      if values[j].line == p.line && values[j].start > p.start {
        run Testing.expect(values[j].x1 <= p.x0 + 0.01, "later text is further left")
        reversed = reversed + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  run Testing.expect(tops.length() >= 4, "the paragraph wraps onto several lines")
  run Testing.expect(reversed > 20, "lines hold several runs")
  let checked = run roundTrips(&tree, TEXT, PARAGRAPH)
  run Testing.expect(checked > 80, "most offsets were checked")
}

test effect fn rightToLeftLinesHitAndCaret() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rightToLeftBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// A paragraph whose middle is an inline box in another font and size: its lines hold an
/// inline box, so they keep their line fragments, between lines of plain text.
effect fn mixedBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run paragraph(&fonts, &[], "alpha beta gamma delta epsilon zeta eta theta iota kappa ")
  let mut batch = Batch.make()
  run batch.box(PARAGRAPH, SPAN, &[css.display(Keyword.Inline), css.fontFamily(MONO), css.fontSize(px(22.0))])
  run batch.text(SPAN, SPAN_TEXT, "lambda mu nu xi omicron pi")
  run batch.text(PARAGRAPH, TAIL, " rho sigma tau upsilon phi chi psi omega alpha beta gamma delta")
  run tree.apply(run batch.take())
  run tree.frame(viewport())

  let mut head = List<caret.Piece>.make()
  let mut middle = List<caret.Piece>.make()
  let mut tail = List<caret.Piece>.make()
  run view.textPieces(&tree, tree.slotOf(TEXT), &mut head)
  run view.textPieces(&tree, tree.slotOf(SPAN_TEXT), &mut middle)
  run view.textPieces(&tree, tree.slotOf(TAIL), &mut tail)
  run Testing.expect((run lineCount(&head)) >= 2, "the head wraps")
  run Testing.expect((run lineCount(&middle)) >= 2, "the span wraps")
  run Testing.expect((run lineCount(&tail)) >= 2, "the tail wraps")
  let a = head.asSlice()
  let b = middle.asSlice()
  let c = tail.asSlice()
  run Testing.expect(b[0].bottom - b[0].top > a[0].bottom - a[0].top + 2.0, "the span's runs are taller")

  // The head's last line is the span's first, and the span's last the tail's first: one line
  // box, whichever fragments hold the runs.
  let headEnd = a[a.length - 1]
  let spanEnd = b[b.length - 1]
  run Testing.expect(headEnd.lineTop == b[0].lineTop && headEnd.lineBottom == b[0].lineBottom, "head and span share a line")
  run Testing.expect(spanEnd.lineTop == c[0].lineTop && spanEnd.lineBottom == c[0].lineBottom, "span and tail share a line")
  run Testing.expect(f32.abs(b[0].x0 - headEnd.x1) < 0.01, "the span follows the head")
  run Testing.expect(f32.abs(c[0].x0 - spanEnd.x1) < 0.01, "the tail follows the span")
  // A line with the taller font is taller than a line of plain text.
  run Testing.expect(
    b[0].lineBottom - b[0].lineTop > a[0].lineBottom - a[0].lineTop + 2.0,
    "the mixed line is taller than a plain one",
  )
  let last = c[c.length - 1]
  run Testing.expect(last.lineTop > c[0].lineTop, "the tail goes on below the mixed line")

  let first = run roundTrips(&tree, TEXT, PARAGRAPH)
  let second = run roundTrips(&tree, SPAN_TEXT, SPAN)
  let third = run roundTrips(&tree, TAIL, PARAGRAPH)
  run Testing.expect(first > 30 && second > 15 && third > 30, "offsets of all three texts were checked")
}

test effect fn mixedFontLinesHitAndCaret() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run mixedBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Two text nodes side by side in one paragraph, on lines shorter than the text is tall: the
/// line where the first ends and the second begins is one line box in two text fragments
/// (css-layout's `TEXT_LINE_CONTINUED`), and each line carries the overflow of its runs
/// (`TEXT_LINE_OVERFLOW`).
effect fn sharedBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run paragraph(&fonts, &[css.lineHeight(px(10.0))], "alpha beta gamma delta epsilon zeta eta ")
  let mut batch = Batch.make()
  run batch.text(PARAGRAPH, TAIL, "theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon")
  run tree.apply(run batch.take())
  run tree.frame(viewport())

  // Both kinds of record are there: this test is about them.
  let records = tree.output.fragments.texts.asSlice()
  let mut continued: usize = 0
  let mut overflowing: usize = 0
  let mut lines: usize = 0
  let mut r: usize = 0
  while r < records.length {
    if records[r].part == 1 { lines = lines + 1 }
    if records[r].part == 2 { continued = continued + 1 }
    if records[r].part == 3 { overflowing = overflowing + 1 }
    r = r + 1
  }
  run Testing.expect(lines >= 3, "the paragraph's lines are records")
  run Testing.expect(continued == 1, "the line the two texts share is in both their fragments")
  run Testing.expect(overflowing == lines, "every line holds text taller than it is")

  let mut head = List<caret.Piece>.make()
  let mut tail = List<caret.Piece>.make()
  run view.textPieces(&tree, tree.slotOf(TEXT), &mut head)
  run view.textPieces(&tree, tree.slotOf(TAIL), &mut tail)
  run Testing.expect((run lineCount(&head)) >= 2, "the head wraps")
  run Testing.expect((run lineCount(&tail)) >= 2, "the tail wraps")
  let a = head.asSlice()
  let b = tail.asSlice()
  let last = a[a.length - 1]
  run Testing.expect(last.line == b[0].line, "the head's last line is the tail's first")
  run Testing.expect(last.lineTop == b[0].lineTop && last.lineBottom == b[0].lineBottom, "one line box")
  run Testing.expect(f32.abs(b[0].x0 - last.x1) < 0.01, "the tail follows the head on it")
  run Testing.expect(b[b.length - 1].line != b[0].line, "and goes on below")
  run Testing.expect(f32.abs((last.lineBottom - last.lineTop) - 10.0) < 0.01, "a line is as tall as its line height")
  run Testing.expect(last.bottom - last.top > 12.0, "its text is taller")

  // The paragraph is as tall as its lines; the text of its last line reaches below it, into
  // its scrollable overflow.
  let box = tree.output.fragments.values.asSlice()[tree.fragmentOf.get(tree.node(tree.slotOf(PARAGRAPH)).css)]
  let bottom = b[b.length - 1].bottom
  run Testing.expect(f32.abs(box.size.height - usize.toF32(lines) * 10.0) < 0.01, "the paragraph is its lines tall")
  run Testing.expect(bottom > box.worldLocation.y + box.size.height, "the last line's text reaches below the paragraph")
  run Testing.expect(
    f32.abs(box.scrollableOverflow.y + box.scrollableOverflow.height - (bottom - box.worldLocation.y)) < 0.01,
    "the paragraph's scrollable overflow reaches the bottom of that text",
  )

  // With lines as tall as their text, where no run lies over another line's: every offset of
  // both texts round-trips, on the shared line as on the others.
  let mut plain = run paragraph(&fonts, &[], "alpha beta gamma delta epsilon zeta eta ")
  run batch.text(PARAGRAPH, TAIL, "theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon")
  run plain.apply(run batch.take())
  run plain.frame(viewport())
  let plainRecords = plain.output.fragments.texts.asSlice()
  continued = 0
  overflowing = 0
  r = 0
  while r < plainRecords.length {
    if plainRecords[r].part == 2 { continued = continued + 1 }
    if plainRecords[r].part == 3 { overflowing = overflowing + 1 }
    r = r + 1
  }
  run Testing.expect(continued == 1 && overflowing == 0, "one shared line, and no text outside its line")
  let first = run roundTrips(&plain, TEXT, PARAGRAPH)
  let second = run roundTrips(&plain, TAIL, PARAGRAPH)
  run Testing.expect(first > 25 && second > 40, "offsets of both texts were checked")
}

test effect fn linesSharedByTextsAndOverflowingText() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sharedBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn selectionBody() -> ()
  ! AssertionError<'static> | TreeError | CssomError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let tree = run paragraph(&fonts, &[], WORDS)
  let mut pieces = List<caret.Piece>.make()
  run view.textPieces(&tree, tree.slotOf(TEXT), &mut pieces)
  let values = pieces.asSlice()

  // From inside the first line's second word to inside a word two lines below.
  let from: usize = 8
  let mut target: usize = 0
  let mut seen: usize = 0
  let mut i: usize = 1
  while i < values.length && target == 0 {
    if values[i].line != values[i - 1].line {
      seen = seen + 1
      if seen == 2 { target = i + 2 }
    }
    i = i + 1
  }
  run Testing.expect(target != 0 && target < values.length, "the paragraph has three lines")
  let to = values[target].start + 2
  let mut rects = List<DOMRect>.make()
  run view.rangeClientRects(
    &tree,
    view.Range {
      start: view.BoundaryPoint { node: TEXT, offset: from },
      end: view.BoundaryPoint { node: TEXT, offset: to },
    },
    &mut rects,
  )
  let startX = caret.caretRect(&tree.provider.text, &pieces, from).xMin
  let endX = caret.caretRect(&tree.provider.text, &pieces, to).xMin
  let firstLine = values[caret.pieceAt(&pieces, from)]
  let lastLine = values[target]

  // One rectangle for each run the range meets, each on its run.
  let mut expected: usize = 0
  let mut width: f32 = 0.0
  i = 0
  while i < values.length {
    let p = values[i]
    if to > p.start && from < p.end {
      expected = expected + 1
      let a = caret.caretX(&tree.provider.text, &p, if from > p.start { from } else { p.start })
      let b = caret.caretX(&tree.provider.text, &p, if to < p.end { to } else { p.end })
      width = width + f32.abs(b - a)
    }
    i = i + 1
  }
  run Testing.expect(rects.length() == expected && expected > 10, "one rectangle a run")
  let mut total: f64 = 0.0
  let mut top: f64 = 1.0e9
  let mut bottom: f64 = 0.0
  let mut left: f64 = 1.0e9
  let mut right: f64 = 0.0
  let mut r: usize = 0
  while r < rects.length() {
    let rect = rects.get(r)
    total = total + rect.width
    if rect.y < top { top = rect.y }
    if rect.y + rect.height > bottom { bottom = rect.y + rect.height }
    // On the first line nothing lies left of the start, on the last nothing right of the end.
    if f64.abs(rect.y - f32.toF64(firstLine.top)) < 0.01 && rect.x < left { left = rect.x }
    if f64.abs(rect.y - f32.toF64(lastLine.top)) < 0.01 && rect.x + rect.width > right { right = rect.x + rect.width }
    r = r + 1
  }
  run Testing.expect(f64.abs(total - f32.toF64(width)) < 0.01, "the rectangles are as wide as the selected text")
  run Testing.expect(f64.abs(top - f32.toF64(firstLine.top)) < 0.01, "the selection starts on the first line")
  run Testing.expect(f64.abs(bottom - f32.toF64(lastLine.bottom)) < 0.01, "and ends on the third")
  run Testing.expect(f64.abs(left - f32.toF64(startX)) < 0.01, "at the start offset's caret")
  run Testing.expect(f64.abs(right - f32.toF64(endX)) < 0.01, "to the end offset's caret")
}

test effect fn selectionAcrossLines() -> ()
  ! AssertionError<'static> | TreeError | CssomError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run selectionBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// One run of text of a layout: where it is, what it holds and the line it is on.
struct Run {
  source: usize,
  start: usize,
  end: usize,
  shapeKey: usize,
  x: f32,
  y: f32,
  width: f32,
  height: f32,
  lineY: f32,
  lineHeight: f32,
}

impl Copy for Run {}

/// Every run of text of the last layout, in fragment order.
effect fn runsOf(tree: &UiTree<'_>, out: &mut List<Run>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let count = tree.output.fragments.values.length()
  let mut index: usize = 0
  while index < count {
    let source = tree.output.fragments.values.asSlice()[index].source
    let mut runs = tree.output.fragments.textRuns(index)
    while runs.next() {
      let placed = runs.current
      run out.append(
        Run {
          source: source,
          start: placed.sourceStart,
          end: placed.sourceEnd,
          shapeKey: placed.shapeKey,
          x: placed.location.x,
          y: placed.location.y,
          width: placed.size.width,
          height: placed.size.height,
          lineY: placed.lineLocation.y,
          lineHeight: placed.lineSize.height,
        },
      )
    }
    index = index + 1
  }
}

const PARAGRAPHS: u32 = 40
/// The paragraph whose text changes: most of the document stands before it, so a change
/// that moves what follows still leaves the paint caches worth repairing.
const EDITED: u32 = 36

/// Forty paragraphs of text: paragraph `i` is box `10 * i` holding text `10 * i + 1`.
effect fn document<'a>(fonts: &'a FontCollection, changed: string) -> UiTree<'a>
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(fonts)
  let mut batch = Batch.make()
  run batch.fontFamily(fixtures.SANS, "Noto Sans, sans-serif")
  run batch.create(ROOT, NodeKind.Box)
  run batch.root(ROOT)
  run batch.style(ROOT, &[css.width(px(300.0)), css.fontFamily(fixtures.SANS), css.fontSize(px(14.0))])
  let mut index: u32 = 1
  while index <= PARAGRAPHS {
    run batch.box(ROOT, index * 10, &[css.marginTop(px(6.0)), css.paddingLeft(px(4.0))])
    if index == EDITED && String.byteLength(changed) != 0 {
      run batch.text(index * 10, index * 10 + 1, changed)
    } else {
      run batch.text(index * 10, index * 10 + 1, WORDS)
    }
    index = index + 1
  }
  run tree.apply(run batch.take())
  // Tall enough that nothing overflows: a scrollbar that takes room turns layout reuse off.
  run tree.frame(FrameInput { width: 300.0, height: 12000.0, scale: 1.0, time: 0.0 })
  return move tree
}

effect fn sameRuns(a: &List<Run>, b: &List<Run>, what: string<'static>) -> ()
  ! AssertionError<'static> {
  run Testing.expect(a.length() == b.length() && a.length() > 1000, what)
  let mut i: usize = 0
  while i < a.length() && i < b.length() {
    let x = a.get(i)
    let y = b.get(i)
    run Testing.expect(
      x.source == y.source && x.start == y.start && x.end == y.end && x.x == y.x && x.y == y.y
        && x.width == y.width && x.height == y.height && x.lineY == y.lineY && x.lineHeight == y.lineHeight,
      what,
    )
    i = i + 1
  }
}

effect fn incrementalBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let input = FrameInput { width: 300.0, height: 12000.0, scale: 1.0, time: 0.0 }
  let mut tree = run document(&fonts, "")
  tree.repair.verify = true
  let mut batch = Batch.make()
  let mut edited = List<Run>.make()
  let mut fresh = List<Run>.make()

  // A word in the middle of paragraph `EDITED` changes for one of the same width class,
  // then for a longer text that adds lines, then for a shorter one that takes lines away:
  // each layout in place must give what a first layout of the same text gives.
  let texts = [
    "alpha beta gamma delta epsilon zeta eta THETA iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega",
    "alpha beta gamma delta epsilon zeta eta theta and a good many more words in the middle of the paragraph, enough for two more lines of text, iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega",
    "alpha beta gamma",
  ]
  let mut step: usize = 0
  while step < texts.length {
    run batch.setText(EDITED * 10 + 1, texts[step])
    run tree.apply(run batch.take())
    run tree.frame(input)
    run Testing.expect(tree.repair.mismatches == 0, "the repaired paint caches match a rebuild")
    run Testing.expect(tree.output.lastMode != 4 && tree.output.lastMode != 3, "the layout works in place")
    let other = run document(&fonts, texts[step])
    run runsOf(&tree, &mut edited)
    run runsOf(&other, &mut fresh)
    run sameRuns(&edited, &fresh, "a text change laid out in place gives the runs of a first layout")

    // Hit testing and carets read the same runs in both.
    let mut id: u32 = (EDITED - 1) * 10 + 1
    while id <= (EDITED + 1) * 10 + 1 {
      let mut a = List<caret.Piece>.make()
      let mut b = List<caret.Piece>.make()
      run view.textPieces(&tree, tree.slotOf(id), &mut a)
      run view.textPieces(&other, other.slotOf(id), &mut b)
      run Testing.expect(a.length() == b.length() && a.length() != 0, "the same pieces")
      let last = a.asSlice()[a.length() - 1]
      let x = (last.x0 + last.x1) * 0.5
      let y = (last.top + last.bottom) * 0.5
      run Testing.expect(tree.hitTest(x, y) == id - 1 && other.hitTest(x, y) == id - 1, "the same hit")
      let d = last.start
      let here = caret.caretRect(&tree.provider.text, &a, d)
      let there = caret.caretRect(&other.provider.text, &b, d)
      run Testing.expect(
        here.xMin == there.xMin && here.yMin == there.yMin && here.yMax == there.yMax,
        "the same caret",
      )
      id = id + 10
    }
    step = step + 1
  }
  run Testing.expect(tree.repair.fragileRebuilds == 0, "nothing here is fragile")
  run Testing.expect(tree.repair.uncarried == 0, "css-layout reports what each pass kept")
  run Testing.expect(tree.repair.repairs >= 3, "each change repaired the caches")
}

test effect fn textChangeInTheMiddleLaysOutInPlace() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run incrementalBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
