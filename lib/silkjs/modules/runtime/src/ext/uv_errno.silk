fn messageZ(index: usize) -> &'static [u8] {
  return match index {
    0 => b"argument list too long\0"
    1 => b"permission denied\0"
    2 => b"address already in use\0"
    3 => b"address not available\0"
    4 => b"address family not supported\0"
    5 => b"resource temporarily unavailable\0"
    6 => b"address family not supported\0"
    7 => b"temporary failure\0"
    8 => b"bad ai_flags value\0"
    9 => b"invalid value for hints\0"
    10 => b"request canceled\0"
    11 => b"permanent failure\0"
    12 => b"ai_family not supported\0"
    13 => b"out of memory\0"
    14 => b"no address\0"
    15 => b"unknown node or service\0"
    16 => b"argument buffer overflow\0"
    17 => b"resolved protocol is unknown\0"
    18 => b"service not available for socket type\0"
    19 => b"socket type not supported\0"
    20 => b"connection already in progress\0"
    21 => b"bad file descriptor\0"
    22 => b"resource busy or locked\0"
    23 => b"operation canceled\0"
    24 => b"invalid Unicode character\0"
    25 => b"software caused connection abort\0"
    26 => b"connection refused\0"
    27 => b"connection reset by peer\0"
    28 => b"destination address required\0"
    29 => b"file already exists\0"
    30 => b"bad address in system call argument\0"
    31 => b"file too large\0"
    32 => b"host is unreachable\0"
    33 => b"interrupted system call\0"
    34 => b"invalid argument\0"
    35 => b"i/o error\0"
    36 => b"socket is already connected\0"
    37 => b"illegal operation on a directory\0"
    38 => b"too many symbolic links encountered\0"
    39 => b"too many open files\0"
    40 => b"message too long\0"
    41 => b"name too long\0"
    42 => b"network is down\0"
    43 => b"network is unreachable\0"
    44 => b"file table overflow\0"
    45 => b"no buffer space available\0"
    46 => b"no such device\0"
    47 => b"no such file or directory\0"
    48 => b"not enough memory\0"
    49 => b"machine is not on the network\0"
    50 => b"protocol not available\0"
    51 => b"no space left on device\0"
    52 => b"function not implemented\0"
    53 => b"socket is not connected\0"
    54 => b"not a directory\0"
    55 => b"directory not empty\0"
    56 => b"socket operation on non-socket\0"
    57 => b"operation not supported on socket\0"
    58 => b"value too large for defined data type\0"
    59 => b"operation not permitted\0"
    60 => b"broken pipe\0"
    61 => b"protocol error\0"
    62 => b"protocol not supported\0"
    63 => b"protocol wrong type for socket\0"
    64 => b"result too large\0"
    65 => b"read-only file system\0"
    66 => b"cannot send after transport endpoint shutdown\0"
    67 => b"invalid seek\0"
    68 => b"no such process\0"
    69 => b"connection timed out\0"
    70 => b"text file is busy\0"
    71 => b"cross-device link not permitted\0"
    72 => b"unknown error\0"
    73 => b"end of file\0"
    74 => b"no such device or address\0"
    75 => b"too many links\0"
    76 => b"host is down\0"
    77 => b"remote I/O error\0"
    78 => b"inappropriate ioctl for device\0"
