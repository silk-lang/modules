//! Prints what a font's default Latin plan does across a space (`harfrust.separable`): the
//! lookups whose matches can go on past one, how far around a cut after a space they reach,
//! and the characters they take as input, which keep a paragraph's glyphs from being reused
//! where words are added near them.
//!
//! ```text
//! font-shape-space-separable FONT [TEXT]
//! ```
//!
//! With `TEXT`, also prints for each space of the text whether a cut right after it is one
//! the glyphs on either side can be kept across (`Separation.separates`).
import harfrust.lib { Buffer, ShaperData, Shaper, ShapePlan, Separation, separation }
import read_fonts.lib { FontRef, ReadError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u8
import silk.num.usize
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.format { Format }
import silk.text.string { String, InvalidUtf8 }

effect fn read(base: &Path, name: string) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let path = if String.startsWith(name, "/") {
    run Path.fromBytes(String.utf8Bytes(name))
  } else {
    run Path.resolve(&base.*, name)
  }
  return run FileSystem.readFile(&path)
}

effect fn appendScalar(out: &mut List<u8>, scalar: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if scalar < 0x80 {
    run out.append(u32.toU8(scalar))
  } else if scalar < 0x800 {
    run out.append(u32.toU8(0xc0 | u32.shiftRight(scalar, 6)))
    run out.append(u32.toU8(0x80 | (scalar & 0x3f)))
  } else {
    run out.append(u32.toU8(0xe0 | u32.shiftRight(scalar, 12)))
    run out.append(u32.toU8(0x80 | (u32.shiftRight(scalar, 6) & 0x3f)))
    run out.append(u32.toU8(0x80 | (scalar & 0x3f)))
  }
}

effect fn process() -> i32
  ! OutOfMemoryError | HostInputError | FileError | WriterError
  ? &mut Allocator | &mut HostInput | &mut FileSystem | &mut Writer {
  let mut args = List<String>.make()
  let total = run HostInput.argumentCount()
  let mut argument: usize = 0
  while argument < total {
    if let Option<Bytes>.Some { value: raw } = run HostInput.argument(argument) {
      if let Result<String, InvalidUtf8>.Success { value: text } = move String.fromBytes(move raw) {
        run args.append(move text)
      }
    }
    argument = argument + 1
  }
  let values = args.asSlice()
  if values.length < 2 {
    run Writer.writeString("usage: font-shape-space-separable FONT [TEXT]\n")
    return 2
  }
  let cwd = run HostInput.workingDirectory()
  let base = run Path.fromBytes(Bytes.asSlice(&cwd))
  let fontBytes = run read(&base, String.view(&values[1]))
  let font = match move FontRef.fromIndex(Bytes.asSlice(&fontBytes), 0) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Writer.writeString("font-shape-space-separable: not a font\n")
      return 2
    }
  }
  let data = ShaperData.new(&font)
  let shaper = Shaper.new(&data)
  let mut buffer = Buffer.new()
  run Buffer.pushStr(&mut buffer, "a")
  Buffer.guessSegmentProperties(&mut buffer)
  let plan = run ShapePlan.new(&shaper, &buffer, &[])
  let space = data.nominalGlyph(32)
  let found = run separation(&data, &plan, space)
  run Format.format(
    "space glyph {space} never {never} reach {reach} fractions {fractions} lookups",
    &.{ space: space, never: found.never, reach: found.reach, fractions: found.fractions },
  )
  let mut index: usize = 0
  while index < found.lookups.length() {
    let lookup = found.lookups.get(index)
    if lookup >= 0x10000 {
      run Format.format(" GPOS {index}", &.{ index: lookup - 0x10000 })
    } else {
      run Format.format(" GSUB {index}", &.{ index: lookup })
    }
    index = index + 1
  }
  run Writer.writeString("\n")

  // The characters below U+3000 whose glyph is a trigger.
  let mut chars = List<u8>.make()
  let mut count: usize = 0
  let mut scalar: u32 = 0x21
  while scalar < 0x3000 {
    let glyph = data.nominalGlyph(scalar)
    if glyph != 0 && found.triggers.has(glyph) {
      run appendScalar(&mut chars, scalar)
      count = count + 1
    }
    scalar = scalar + 1
  }
  let shown = String.fromUtf8(chars.asSlice()) |> Result<string, InvalidUtf8>.unwrapOr("")
  run Format.format(
    "trigger characters {count} (notdef {notdef}): {shown}\n",
    &.{ count: count, notdef: found.triggers.has(0), shown: shown },
  )
  if values.length > 2 {
    let text = String.utf8Bytes(String.view(&values[2]))
    let mut at: usize = 0
    while at < text.length {
      if text[at] == 32 {
        let kept = Separation.separates(&found, &data, text, 0, at + 1, text.length)
        run Format.format("cut at {at}: {kept}\n", &.{ at: at + 1, kept: kept })
      }
      at = at + 1
    }
  }
  return 0
}

effect fn failed<E>(error: E) -> i32
  ! WriterError {
  drop error
  let mut writer = StderrWriter.make()
  run Writer.writeString("font-shape-space-separable: unable to process input\n")
    |> Effect.provideMut<Writer>(&mut writer)
  return 2
}

effect fn provided() -> i32
  ! OutOfMemoryError | HostInputError | FileError | WriterError
  ? &mut Allocator | &mut HostInput {
  let mut files = run MachineFileSystem.make()
  let mut writer = StdoutWriter.make()
  return run process()
    |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Writer>(&mut writer)
}

pub effect fn main() -> i32
  ! WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(provided(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
