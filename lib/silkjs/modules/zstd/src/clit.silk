//! The literals section of a compressed block: a port of `lib/compress/zstd_compress_literals.c`
//! of Zstandard 1.5.7.
import mem
import errors
import cstate
import cparams
import huf_compress as huf
import silk.num.u8
import silk.num.u32
import silk.num.usize

/// `ZSTD_minGain`: how much smaller a compressed block or literals section must be.
pub fn minGain(srcSize: usize, strategy: u32) -> usize {
  let minlog: u32 = if strategy >= cparams.BTULTRA { strategy - 1 } else { 6 }
  return mem.shrz(srcSize, minlog) + 2
}

/// `ZSTD_noCompressLiterals`: a raw literals section.
pub unsafe fn noCompressLiterals(dst: [*]mut u8, dstCapacity: usize, src: [*]const u8, srcSize: usize) -> usize {
  let mut flSize: usize = 1
  if srcSize > 31 { flSize = flSize + 1 }
  if srcSize > 4095 { flSize = flSize + 1 }
  if srcSize + flSize > dstCapacity { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
  let size32 = mem.t32(srcSize)
  if flSize == 1 {
    unsafe mem.w8(dst, 0, u32.wrappingToU8(cstate.SET_BASIC + u32.shiftLeft(size32, 3)))
  } else if flSize == 2 {
    unsafe mem.w16(dst, 0, u32.wrappingToU16(cstate.SET_BASIC + 4 + u32.shiftLeft(size32, 4)))
  } else {
    unsafe mem.w32(dst, 0, cstate.SET_BASIC + 12 + u32.shiftLeft(size32, 4))
  }
  let _c = unsafe mem.memcpy(unsafe mem.add(dst, flSize), src, srcSize)
  return srcSize + flSize
}

unsafe fn allBytesIdentical(src: [*]const u8, srcSize: usize) -> bool {
  let b = unsafe mem.r8(src, 0)
  let mut p: usize = 1
  while p < srcSize {
    if unsafe mem.r8(src, p) != b { return false }
    p = p + 1
  }
  return true
}

/// `ZSTD_compressRleLiteralsBlock`: a literals section of one repeated byte.
pub unsafe fn compressRleLiteralsBlock(dst: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  let mut flSize: usize = 1
  if srcSize > 31 { flSize = flSize + 1 }
  if srcSize > 4095 { flSize = flSize + 1 }
  let size32 = mem.t32(srcSize)
  if flSize == 1 {
    unsafe mem.w8(dst, 0, u32.wrappingToU8(cstate.SET_RLE + u32.shiftLeft(size32, 3)))
  } else if flSize == 2 {
    unsafe mem.w16(dst, 0, u32.wrappingToU16(cstate.SET_RLE + 4 + u32.shiftLeft(size32, 4)))
  } else {
    unsafe mem.w32(dst, 0, cstate.SET_RLE + 12 + u32.shiftLeft(size32, 4))
  }
  unsafe mem.w8(dst, flSize, unsafe mem.r8(src, 0))
  return flSize + 1
}

// `ZSTD_minLiteralsToCompress`.
fn minLiteralsToCompress(strategy: u32, hufRepeat: u32) -> usize {
  // Higher strategies try to compress smaller literals sections.
  let mut shift: u32 = 9 - strategy
  if shift > 3 { shift = 3 }
  if hufRepeat == huf.REPEAT_VALID { return 6 }
  return mem.shlz(8, shift)
}

/// `ZSTD_compressLiterals`. `prevHuf` and `nextHuf` are `ZSTD_hufCTables_t` (the first
/// `cstate.CBS_HUF_SIZE` bytes of a block state).
pub unsafe fn compressLiterals(dst: [*]mut u8, dstCapacity: usize, src: [*]const u8, srcSize: usize, entropyWorkspace: [*]mut u8, entropyWorkspaceSize: usize, prevHuf: [*]const u8, nextHuf: [*]mut u8, strategy: u32, disableLiteralCompression: bool, suspectUncompressible: bool) -> usize {
  let mut lhSize: usize = 3
  if srcSize >= 1024 { lhSize = lhSize + 1 }
  if srcSize >= 16384 { lhSize = lhSize + 1 }
  let mut singleStream = srcSize < 256
  let mut hType = cstate.SET_COMPRESSED
  // Prepare nextEntropy assuming that the existing table is reused.
  let _c0 = unsafe mem.memcpy(nextHuf, prevHuf, cstate.CBS_HUF_SIZE)
  if disableLiteralCompression { return unsafe noCompressLiterals(dst, dstCapacity, src, srcSize) }
  let prevRepeat = unsafe mem.r32(prevHuf, cstate.CBS_HUF_REPEAT)
  // If too small, don't even attempt compression (speed opt).
  if srcSize < minLiteralsToCompress(strategy, prevRepeat) { return unsafe noCompressLiterals(dst, dstCapacity, src, srcSize) }
  if dstCapacity < lhSize + 1 { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
  let mut repeat = prevRepeat
  let mut flags: u32 = 0
  if strategy < cparams.LAZY && srcSize <= 1024 { flags = flags | huf.FLAG_PREFER_REPEAT }
  if strategy >= cparams.BTULTRA { flags = flags | huf.FLAG_OPTIMAL_DEPTH }
  if suspectUncompressible { flags = flags | huf.FLAG_SUSPECT_UNCOMPRESSIBLE }
  if repeat == huf.REPEAT_VALID && lhSize == 3 { singleStream = true }
  let mut cLitSize: usize = 0
  if singleStream {
    cLitSize = unsafe huf.compress1XRepeat(unsafe mem.add(dst, lhSize), dstCapacity - lhSize, src, srcSize, 255, 11, entropyWorkspace, entropyWorkspaceSize, nextHuf, &mut repeat, flags)
  } else {
    cLitSize = unsafe huf.compress4XRepeat(unsafe mem.add(dst, lhSize), dstCapacity - lhSize, src, srcSize, 255, 11, entropyWorkspace, entropyWorkspaceSize, nextHuf, &mut repeat, flags)
  }
  if repeat != huf.REPEAT_NONE {
    // Reused the existing table.
    hType = cstate.SET_REPEAT
  }
  let gain = minGain(srcSize, strategy)
  if cLitSize == 0 || cLitSize >= mem.us(srcSize, gain) || errors.isError(cLitSize) {
    let _c1 = unsafe mem.memcpy(nextHuf, prevHuf, cstate.CBS_HUF_SIZE)
    return unsafe noCompressLiterals(dst, dstCapacity, src, srcSize)
  }
  if cLitSize == 1 {
    // A return value of 1 means that the block is one repeated byte: check it for small inputs.
    if srcSize >= 8 || unsafe allBytesIdentical(src, srcSize) {
      let _c2 = unsafe mem.memcpy(nextHuf, prevHuf, cstate.CBS_HUF_SIZE)
      return unsafe compressRleLiteralsBlock(dst, src, srcSize)
    }
  }
  if hType == cstate.SET_COMPRESSED {
    // Using a newly constructed table.
    unsafe mem.w32(nextHuf, cstate.CBS_HUF_REPEAT, huf.REPEAT_CHECK)
  }
  // Build the header.
  let size32 = mem.t32(srcSize)
  let cSize32 = mem.t32(cLitSize)
  if lhSize == 3 {
    let streams: u32 = if singleStream { 0 } else { 4 }
    let lhc = hType + streams + u32.shiftLeft(size32, 4) + u32.shiftLeft(cSize32, 14)
    unsafe mem.w24(dst, 0, lhc)
  } else if lhSize == 4 {
    let lhc = hType + 8 + u32.shiftLeft(size32, 4) + u32.shiftLeft(cSize32, 18)
    unsafe mem.w32(dst, 0, lhc)
  } else {
    let lhc = mem.a32(hType + 12 + u32.shiftLeft(size32, 4), u32.shiftLeft(cSize32, 22))
    unsafe mem.w32(dst, 0, lhc)
    unsafe mem.w8(dst, 4, u32.wrappingToU8(u32.shiftRight(cSize32, 10)))
  }
  return lhSize + cLitSize
}
