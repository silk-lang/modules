  run a.alu(Alu.Xor, Width.W32, Reg.Rsi, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x31\xce"), "xor esi, ecx")
  run a.alu(Alu.Xor, Width.W32, Reg.R8, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x31\xc8"), "xor r8d, r9d")
  run a.alu(Alu.Xor, Width.W32, Reg.R12, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x31\xfc"), "xor r12d, edi")
  run a.alu(Alu.Xor, Width.W32, Reg.R13, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x31\xf5"), "xor r13d, r14d")
  run a.alu(Alu.Xor, Width.W32, Reg.R15, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x31\xcf"), "xor r15d, ecx")
  run a.aluImm(Alu.Xor, Width.W32, Reg.Rax, 0)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xf0\x00"), "xor eax, 0")
  run a.aluImm(Alu.Xor, Width.W32, Reg.Rcx, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xf1\x01"), "xor ecx, 1")
  run a.aluImm(Alu.Xor, Width.W32, Reg.Rbp, -1)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xf5\xff"), "xor ebp, -1")
  run a.aluImm(Alu.Xor, Width.W32, Reg.R8, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x83\xf0\x7f"), "xor r8d, 127")
  run a.aluImm(Alu.Xor, Width.W32, Reg.R12, 128)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x81\xf4\x80\x00\x00\x00"), "xor r12d, 128")
  run a.aluImm(Alu.Xor, Width.W32, Reg.R13, -128)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x83\xf5\x80"), "xor r13d, -128")
  run a.aluImm(Alu.Xor, Width.W32, Reg.R15, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x81\xf7\x7f\xff\xff\xff"), "xor r15d, -129")
  run a.aluImm(Alu.Xor, Width.W32, Reg.Rax, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x35\x78\x56\x34\x12"), "xor eax, 305419896")
  run a.aluImm(Alu.Xor, Width.W32, Reg.Rcx, 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\x81\xf1\xff\xff\xff\x7f"), "xor ecx, 2147483647")
  run a.aluImm(Alu.Xor, Width.W32, Reg.Rbp, -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x81\xf5\x00\x00\x00\x80"), "xor ebp, -2147483648")
  run a.aluImm(Alu.Xor, Width.W32, Reg.Rax, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x35\x78\x56\x34\x12"), "xor eax, 305419896")
  run a.aluImm(Alu.Xor, Width.W32, Reg.Rax, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xf0\x7f"), "xor eax, 127")
  run a.aluImm(Alu.Xor, Width.W32, Reg.Rax, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x35\x7f\xff\xff\xff"), "xor eax, -129")
  run a.alu(Alu.Cmp, Width.W64, Reg.Rax, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x39\xc8"), "cmp rax, rcx")
  run a.alu(Alu.Cmp, Width.W64, Reg.Rbx, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x39\xcb"), "cmp rbx, r9")
  run a.alu(Alu.Cmp, Width.W64, Reg.Rsp, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x39\xfc"), "cmp rsp, rdi")
  run a.alu(Alu.Cmp, Width.W64, Reg.Rbp, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x39\xf5"), "cmp rbp, r14")
  run a.alu(Alu.Cmp, Width.W64, Reg.Rsi, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x39\xce"), "cmp rsi, rcx")
  run a.alu(Alu.Cmp, Width.W64, Reg.R8, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x39\xc8"), "cmp r8, r9")
  run a.alu(Alu.Cmp, Width.W64, Reg.R12, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x39\xfc"), "cmp r12, rdi")
  run a.alu(Alu.Cmp, Width.W64, Reg.R13, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x39\xf5"), "cmp r13, r14")
  run a.alu(Alu.Cmp, Width.W64, Reg.R15, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x39\xcf"), "cmp r15, rcx")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.Rax, 0)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xf8\x00"), "cmp rax, 0")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.Rcx, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xf9\x01"), "cmp rcx, 1")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.Rbp, -1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xfd\xff"), "cmp rbp, -1")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.R8, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x83\xf8\x7f"), "cmp r8, 127")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.R12, 128)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x81\xfc\x80\x00\x00\x00"), "cmp r12, 128")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.R13, -128)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x83\xfd\x80"), "cmp r13, -128")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.R15, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x81\xff\x7f\xff\xff\xff"), "cmp r15, -129")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.Rax, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x3d\x78\x56\x34\x12"), "cmp rax, 305419896")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.Rcx, 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x81\xf9\xff\xff\xff\x7f"), "cmp rcx, 2147483647")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.Rbp, -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x81\xfd\x00\x00\x00\x80"), "cmp rbp, -2147483648")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.Rax, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x3d\x78\x56\x34\x12"), "cmp rax, 305419896")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.Rax, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\xf8\x7f"), "cmp rax, 127")
  run a.aluImm(Alu.Cmp, Width.W64, Reg.Rax, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x3d\x7f\xff\xff\xff"), "cmp rax, -129")
  run a.alu(Alu.Cmp, Width.W32, Reg.Rax, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x39\xc8"), "cmp eax, ecx")
  run a.alu(Alu.Cmp, Width.W32, Reg.Rbx, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x39\xcb"), "cmp ebx, r9d")
  run a.alu(Alu.Cmp, Width.W32, Reg.Rsp, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x39\xfc"), "cmp esp, edi")
  run a.alu(Alu.Cmp, Width.W32, Reg.Rbp, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x39\xf5"), "cmp ebp, r14d")
  run a.alu(Alu.Cmp, Width.W32, Reg.Rsi, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x39\xce"), "cmp esi, ecx")
  run a.alu(Alu.Cmp, Width.W32, Reg.R8, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x39\xc8"), "cmp r8d, r9d")
  run a.alu(Alu.Cmp, Width.W32, Reg.R12, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x39\xfc"), "cmp r12d, edi")
  run a.alu(Alu.Cmp, Width.W32, Reg.R13, Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x39\xf5"), "cmp r13d, r14d")
  run a.alu(Alu.Cmp, Width.W32, Reg.R15, Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x39\xcf"), "cmp r15d, ecx")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 0)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xf8\x00"), "cmp eax, 0")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.Rcx, 1)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xf9\x01"), "cmp ecx, 1")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.Rbp, -1)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xfd\xff"), "cmp ebp, -1")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.R8, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x83\xf8\x7f"), "cmp r8d, 127")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.R12, 128)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x81\xfc\x80\x00\x00\x00"), "cmp r12d, 128")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.R13, -128)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x83\xfd\x80"), "cmp r13d, -128")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.R15, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x81\xff\x7f\xff\xff\xff"), "cmp r15d, -129")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x3d\x78\x56\x34\x12"), "cmp eax, 305419896")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.Rcx, 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\x81\xf9\xff\xff\xff\x7f"), "cmp ecx, 2147483647")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.Rbp, -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x81\xfd\x00\x00\x00\x80"), "cmp ebp, -2147483648")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x3d\x78\x56\x34\x12"), "cmp eax, 305419896")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 127)
  run Testing.expect(emitted(&a, &mut at, b"\x83\xf8\x7f"), "cmp eax, 127")
  run a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, -129)
  run Testing.expect(emitted(&a, &mut at, b"\x3d\x7f\xff\xff\xff"), "cmp eax, -129")
}

test effect fn aluMatchLlvm() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut a = Assembler.make()
  run aluCases(&mut a) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aluMemoryCases(a: &mut Assembler) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut at: usize = 0
  run a.aluLoad(Alu.Add, Width.W64, Reg.Rax, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x03\x00"), "add rax, qword ptr [rax]")
  run a.aluStore(Alu.Add, Width.W64, Mem.at(Reg.Rax, 0), Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x01\x00"), "add qword ptr [rax], rax")
  run a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.Rax, 0), 0)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\x00\x00"), "add qword ptr [rax], 0")
  run a.aluLoad(Alu.Add, Width.W64, Reg.R9, Mem.at(Reg.R8, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x03\x48\x08"), "add r9, qword ptr [r8 + 8]")
  run a.aluStore(Alu.Add, Width.W64, Mem.at(Reg.R8, 8), Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x01\x48\x08"), "add qword ptr [r8 + 8], r9")
  run a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R8, 8), 1)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x83\x40\x08\x01"), "add qword ptr [r8 + 8], 1")
  run a.aluLoad(Alu.Add, Width.W64, Reg.Rdx, Mem.at(Reg.Rax, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x03\x50\x7f"), "add rdx, qword ptr [rax + 127]")
  run a.aluStore(Alu.Add, Width.W64, Mem.at(Reg.Rax, 127), Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x01\x50\x7f"), "add qword ptr [rax + 127], rdx")
  run a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.Rax, 127), -1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\x40\x7f\xff"), "add qword ptr [rax + 127], -1")
  run a.aluLoad(Alu.Add, Width.W64, Reg.R11, Mem.at(Reg.Rbp, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x03\x5d\x7f"), "add r11, qword ptr [rbp + 127]")
  run a.aluStore(Alu.Add, Width.W64, Mem.at(Reg.Rbp, 127), Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x01\x5d\x7f"), "add qword ptr [rbp + 127], r11")
  run a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.Rbp, 127), 127)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\x45\x7f\x7f"), "add qword ptr [rbp + 127], 127")
  run a.aluLoad(Alu.Add, Width.W64, Reg.Rsp, Mem.at(Reg.R13, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\x49\x03\xa5\x00\x00\x00\x80"), "add rsp, qword ptr [r13 - 2147483648]")
  run a.aluStore(Alu.Add, Width.W64, Mem.at(Reg.R13, -2147483648), Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x01\xa5\x00\x00\x00\x80"), "add qword ptr [r13 - 2147483648], rsp")
  run a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R13, -2147483648), 128)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x81\x85\x00\x00\x00\x80\x80\x00\x00\x00"), "add qword ptr [r13 - 2147483648], 128")
  run a.aluLoad(Alu.Add, Width.W64, Reg.R13, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x03\x6c\xad\x00"), "add r13, qword ptr [rbp + rbp*4]")
  run a.aluStore(Alu.Add, Width.W64, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x01\x6c\xad\x00"), "add qword ptr [rbp + rbp*4], r13")
  run a.aluStoreImm(Alu.Add, Width.W64, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), -128)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x83\x44\xad\x00\x80"), "add qword ptr [rbp + rbp*4], -128")
  run a.aluLoad(Alu.Add, Width.W64, Reg.Rsi, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4a\x03\x34\x7f"), "add rsi, qword ptr [rdi + r15*2]")
  run a.aluStore(Alu.Add, Width.W64, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x4a\x01\x34\x7f"), "add qword ptr [rdi + r15*2], rsi")
  run a.aluStoreImm(Alu.Add, Width.W64, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), -129)
  run Testing.expect(emitted(&a, &mut at, b"\x4a\x81\x04\x7f\x7f\xff\xff\xff"), "add qword ptr [rdi + r15*2], -129")
  run a.aluLoad(Alu.Add, Width.W32, Reg.Rax, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x03\x00"), "add eax, dword ptr [rax]")
  run a.aluStore(Alu.Add, Width.W32, Mem.at(Reg.Rax, 0), Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x01\x00"), "add dword ptr [rax], eax")
  run a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.Rax, 0), 0)
  run Testing.expect(emitted(&a, &mut at, b"\x83\x00\x00"), "add dword ptr [rax], 0")
  run a.aluLoad(Alu.Add, Width.W32, Reg.R9, Mem.at(Reg.R8, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x45\x03\x48\x08"), "add r9d, dword ptr [r8 + 8]")
  run a.aluStore(Alu.Add, Width.W32, Mem.at(Reg.R8, 8), Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x01\x48\x08"), "add dword ptr [r8 + 8], r9d")
  run a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R8, 8), 1)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x83\x40\x08\x01"), "add dword ptr [r8 + 8], 1")
  run a.aluLoad(Alu.Add, Width.W32, Reg.Rdx, Mem.at(Reg.Rax, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x03\x50\x7f"), "add edx, dword ptr [rax + 127]")
  run a.aluStore(Alu.Add, Width.W32, Mem.at(Reg.Rax, 127), Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x01\x50\x7f"), "add dword ptr [rax + 127], edx")
  run a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.Rax, 127), -1)
  run Testing.expect(emitted(&a, &mut at, b"\x83\x40\x7f\xff"), "add dword ptr [rax + 127], -1")
  run a.aluLoad(Alu.Add, Width.W32, Reg.R11, Mem.at(Reg.Rbp, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x03\x5d\x7f"), "add r11d, dword ptr [rbp + 127]")
  run a.aluStore(Alu.Add, Width.W32, Mem.at(Reg.Rbp, 127), Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x01\x5d\x7f"), "add dword ptr [rbp + 127], r11d")
  run a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.Rbp, 127), 127)
  run Testing.expect(emitted(&a, &mut at, b"\x83\x45\x7f\x7f"), "add dword ptr [rbp + 127], 127")
  run a.aluLoad(Alu.Add, Width.W32, Reg.Rsp, Mem.at(Reg.R13, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\x41\x03\xa5\x00\x00\x00\x80"), "add esp, dword ptr [r13 - 2147483648]")
  run a.aluStore(Alu.Add, Width.W32, Mem.at(Reg.R13, -2147483648), Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x01\xa5\x00\x00\x00\x80"), "add dword ptr [r13 - 2147483648], esp")
  run a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R13, -2147483648), 128)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x81\x85\x00\x00\x00\x80\x80\x00\x00\x00"), "add dword ptr [r13 - 2147483648], 128")
  run a.aluLoad(Alu.Add, Width.W32, Reg.R13, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x03\x6c\xad\x00"), "add r13d, dword ptr [rbp + rbp*4]")
  run a.aluStore(Alu.Add, Width.W32, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x01\x6c\xad\x00"), "add dword ptr [rbp + rbp*4], r13d")
  run a.aluStoreImm(Alu.Add, Width.W32, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), -128)
  run Testing.expect(emitted(&a, &mut at, b"\x83\x44\xad\x00\x80"), "add dword ptr [rbp + rbp*4], -128")
  run a.aluLoad(Alu.Add, Width.W32, Reg.Rsi, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x42\x03\x34\x7f"), "add esi, dword ptr [rdi + r15*2]")
  run a.aluStore(Alu.Add, Width.W32, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), Reg.Rsi)
