  let _copied = unsafe memcpy(bytes6, unsafe offset(group, 8), 16)
  let option6 = if which == UV_JOIN_GROUP { IPV6_JOIN_GROUP } else { if which == UV_LEAVE_GROUP { IPV6_LEAVE_GROUP } else { 0 } }
  if option6 == 0 { return -EINVAL }
  if unsafe setsockopt(fd, IPPROTO_IPV6, option6, bytes6, 20) != 0 { return -(unsafe errno()) }
  return 0
}
/// libuv's uv_udp_set_membership: binds with UV_UDP_REUSEADDR first if not bound.
pub export "C" fn uv_udp_set_membership(udp: *mut u8, group: *const u8, interfaceAddress: ?*const u8, which: i32) -> i32 {
  let mut storage: [u64; 4] = [0; 4]
  let address = unsafe words(Pointer.fromMutRef<u64>(&mut storage[0]))
  if unsafe inet.uv_ip4_addr(group, 0, address) == 0 {
