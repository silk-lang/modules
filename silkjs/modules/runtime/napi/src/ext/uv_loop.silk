// Runs a phase's handles, each once, as libuv's uv__run_idle (a handle started by a callback waits
// for the next iteration; one stopped by a callback does not run).
unsafe fn runPhase(loop: *mut Loop, kind: i32) -> () {
  let list = unsafe phaseList(loop, kind)
  if Pointer.isNull<Handle>(unsafe Pointer.read<?*mut Handle>(list)) { return }
  let mut anchor = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop)
  l.serial = l.serial + 1 let serial = l.serial drop l
  // Mark the handles that were started when the phase began.
  let mut cursor = unsafe Pointer.read<?*mut Handle>(list)
  while !Pointer.isNull<Handle>(cursor) { let mut second = () let c = unsafe Pointer.borrowMut<(), Handle>(&mut second, unsafe nn(cursor)) c.serial = serial cursor = c.nextPhase }
  while true {
    let mut found: ?*mut Handle = Pointer.null<Handle>()
    let mut walk = unsafe Pointer.read<?*mut Handle>(list)
    while !Pointer.isNull<Handle>(walk) {
      let mut third = () let c = unsafe Pointer.borrowMut<(), Handle>(&mut third, unsafe nn(walk))
      if c.serial == serial { c.serial = 0 found = walk break }
