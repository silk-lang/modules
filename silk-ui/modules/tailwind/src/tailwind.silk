//! Optional CSS preprocessing. The UI build pipeline itself only consumes CSS.
import lock
import process { Child, start }
import silk.cli.task { Task, TaskError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.json.scanner { JsonError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, AtomicWriteError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

pub struct Tailwind {
  input: string<'static>,
  output: string<'static>,
  directory: string<'static>,
  lockFile: string<'static>,
  standalonePlatform: string<'static>,
}

fn platform() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    static if Intrinsic.targetArchitecture() == "aarch64" { return "macos-arm64" } else { return "macos-x64" }
  } else {
    static if Intrinsic.targetArchitecture() == "aarch64" { return "linux-arm64" } else { return "linux-x64" }
  }
}

impl Tailwind {
  pub fn make(input: string<'static>, output: string<'static>) -> Self {
    return Self { input: input, output: output, directory: ".", lockFile: "tailwind.lock.json", standalonePlatform: platform() }
  }

  pub fn within(self: Self, directory: string<'static>) -> Self {
    let mut value = move self
    value.directory = directory
    return move value
  }
  pub fn locked(self: Self, file: string<'static>) -> Self {
    let mut value = move self
    value.lockFile = file
    return move value
  }
  /// Select a musl asset explicitly for Alpine and other musl-based hosts.
  pub fn forPlatform(self: Self, name: string<'static>) -> Self {
    let mut value = move self
    value.standalonePlatform = name
    return move value
  }

  /// Produces CSS before returning its path, relative to the task's working directory.
  pub effect fn build(self: &Self) -> String
    ! TaskError | FileError | HostInputError | OutOfMemoryError ? &mut Allocator | &mut FileSystem | &mut HostInput {
    let directory = run self.project()
    let program = run self.executable(String.view(&directory))
    run self.compile(String.view(&program), String.view(&directory))
    return run joined(self.directory, self.output)
  }

  /// Builds once before running the task and keeps Tailwind's scanner watching its sources.
  pub effect fn watching<'env, T, E, ?R>(self: &'env Self, task: once Effect<'env; T ! E ? R>) -> T
    ! E | TaskError | FileError | HostInputError | OutOfMemoryError ? R | &mut Allocator | &mut FileSystem | &mut HostInput {
    let directory = run self.project()
    let program = run self.executable(String.view(&directory))
    run self.compile(String.view(&program), String.view(&directory))
    let child = run start(String.view(&program), &["--input", self.input, "--output", self.output, "--watch=always"], String.view(&directory), &[])
    return run move task |> Effect.ensuring(stop(move child))
  }

  effect fn compile(self: &Self, program: string, directory: string) -> ()
    ! TaskError | FileError | OutOfMemoryError ? &mut Allocator {
    run execute(program, &["--input", self.input, "--output", self.output, "--minify"], directory)
  }

  effect fn project(self: &Self) -> String
    ! TaskError | FileError | HostInputError | OutOfMemoryError ? &mut Allocator | &mut HostInput {
    let cwdBytes = run HostInput.workingDirectory()
    let cwd = run text(cwdBytes.asSlice())
    let cwdPath = run Path.make(cwd)
    let absolute = run Path.resolve(&cwdPath, self.directory)
    return run String.copy(absolute.view().unwrapOr(""))
  }

  effect fn executable(self: &Self, directory: string) -> String
    ! TaskError | FileError | HostInputError | OutOfMemoryError ? &mut Allocator | &mut FileSystem | &mut HostInput {
    static if Intrinsic.targetOperatingSystem() != "darwin" && Intrinsic.targetOperatingSystem() != "linux" {
      run Task.abort("ui-tailwind: build and watch need subprocess support on macOS or Linux")
    }
    let local = run joined(directory, "node_modules/.bin/tailwindcss")
    let localPath = run Path.make(String.view(&local))
    if run FileSystem.exists(&localPath) { return move local }
    let lockPath = run Path.make(String.view(&run joined(directory, self.lockFile)))
    if !run FileSystem.exists(&lockPath) { run Task.abort("ui-tailwind: install @tailwindcss/cli in this project or add tailwind.lock.json (see ui-tailwind README)") }
    let bytes = run FileSystem.readFile(&lockPath)
    let pinned = run Effect.catch<JsonError>(lock.parse(bytes.asSlice(), self.standalonePlatform), invalidLock)
    let homeBytes = match move run HostInput.variableNamed("HOME") {
      Option.Some { value } => move value
      Option.None => run Task.abort("ui-tailwind: HOME is required for the standalone cache")
    }
    let home = run text(homeBytes.asSlice())
    let cacheBase = run joined(home, ".silk/cache/tailwind")
    let versionCache = run joined(String.view(&cacheBase), String.view(&pinned.version))
    let cache = run joined(String.view(&versionCache), String.view(&pinned.checksum))
    let cachePath = run Path.make(String.view(&cache))
    run FileSystem.createDirectoriesRecursively(&cachePath)
    let target = run joined(String.view(&cache), self.standalonePlatform)
    let targetPath = run Path.make(String.view(&target))
    if run FileSystem.exists(&targetPath) {
      let cached = run FileSystem.readFile(&targetPath)
      if !lock.matches(cached.asSlice(), String.view(&pinned.checksum)) { run Task.abort("ui-tailwind: cached executable failed SHA-256 validation; remove it and retry") }
    } else {
      let temporary = run FileSystem.temporaryDirectory(&cachePath, ".download-")
      let download = run joined(temporary.path.view().unwrapOr(""), "tailwind")
      let mut url = run String.copy("https://github.com/tailwindlabs/tailwindcss/releases/download/v")
      run String.append(&mut url, String.view(&pinned.version))
      run String.append(&mut url, "/tailwindcss-")
      run String.append(&mut url, self.standalonePlatform)
      if self.standalonePlatform == "windows-x64" { run String.append(&mut url, ".exe") }
      run downloadVerified(String.view(&url), String.view(&download), &targetPath, String.view(&pinned.checksum))
        |> Effect.ensuring(FileSystem.releaseIgnored(move temporary))
    }
    run execute("chmod", &["700", String.view(&target)], "/")
    return move target
  }
}

effect fn stop(child: Child) -> () {
  let mut owned = move child
  owned.stop()
}

effect fn joined(base: string, child: string) -> String ! OutOfMemoryError ? &mut Allocator {
  if String.startsWith(child, "/") { return run String.copy(child) }
  let mut out = run String.copy(base)
  if !String.endsWith(base, "/") { run String.append(&mut out, "/") }
  run String.append(&mut out, child)
  return move out
}

effect fn execute(program: string, args: &[string], directory: string) -> ()
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator {
  let mut child = run start(program, args, directory, &[])
  let code = child.wait()
  if code != 0 {
    let mut message = run String.copy("ui-tailwind: command failed: ")
    run String.append(&mut message, program)
    fail TaskError { message: move message, status: code }
  }
}

effect fn invalidLock(error: JsonError) -> never ! TaskError | OutOfMemoryError ? &mut Allocator {
  drop error
  run Task.abort("ui-tailwind: invalid JSON in Tailwind lock file")
}

effect fn atomicFailure(error: AtomicWriteError) -> never ! FileError { fail move error.cause }

effect fn downloadVerified(url: string, download: string, target: &Path, checksum: string) -> ()
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  run execute("curl", &["--fail", "--location", "--proto", "=https", "--proto-redir", "=https", "--retry", "2", "--max-time", "300", "--max-filesize", "268435456", "--output", download, url], "/")
  let downloaded = run FileSystem.readFile(&run Path.make(download))
  if !lock.matches(downloaded.asSlice(), checksum) { run Task.abort("ui-tailwind: downloaded executable failed SHA-256 validation") }
  run Effect.catch<AtomicWriteError>(FileSystem.writeFileAtomic(target, downloaded.asSlice(), FileSystem.replaceExisting(), FileSystem.buffered()), atomicFailure)
}

effect fn text(bytes: &[u8]) -> string ! TaskError | OutOfMemoryError ? &mut Allocator {
  return match HostInput.text(bytes) {
    Result.Success { value } => value
    Result.Failure { .. } => run Task.abort("ui-tailwind: paths must be valid UTF-8")
  }
}
