//! Build-time CSS assets. Processors run before App.stylesheet; this module
//! accepts their CSS output and writes either compiled bytes or a DOM stylesheet.
import font_assets
import css_style.compile { Options, CompileError }
import ui_protocol.style_bundle as bundle
import ui_protocol.style_bundle { DecodeError }
import ui_protocol.animatable
import silk.collections.list { List }
import css_style.compile
import css_style.sheet { Sheet, DiagnosticKind }
import css_style.tokens { CssError, Limits }
import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, AtomicWriteError, FileSystem, Path }
import silk.text.string { String }
import silk.num.usize
import silk.num.u8

pub effect fn name(index: usize, dom: bool) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut number = String.make()
  let mut rest = index
  while true {
    let mut digit = run String.copy(String.slice("0123456789", rest % 10, 1))
    run String.append(&mut digit, String.view(&number))
    number = move digit
    rest = rest / 10
    if rest == 0 { break }
  }
  let mut out = run String.copy("style-")
  run String.append(&mut out, String.view(&number))
  run String.append(&mut out, if dom { ".css" } else { ".sheet" })
  return move out
}

/// The module a generated host embeds the compiled sheet `index` as: `style_<index>`.
pub effect fn module(index: usize) -> String ! OutOfMemoryError ? &mut Allocator {
  let file = run name(index, false)
  let digits = String.slice(String.view(&file), 6, String.byteLength(String.view(&file)) - 12)
  let mut out = run String.copy("style_")
  run String.append(&mut out, digits)
  return move out
}

pub effect fn joined(base: string, child: string) -> String ! OutOfMemoryError ? &mut Allocator {
  if String.startsWith(child, "/") { return run String.copy(child) }
  let mut out = run String.copy(base)
  if !String.endsWith(base, "/") { run String.append(&mut out, "/") }
  run String.append(&mut out, child)
  return move out
}

pub effect fn compiled(source: &[u8], path: string) -> Bytes
  ! TaskError | OutOfMemoryError ? &mut Allocator {
  let result = run Effect.result(compile.compile(source, &Options.make()))
  let sheet = match move result {
    Result<Sheet, CompileError | CssError | OutOfMemoryError>.Success { value } => move value
    Result<Sheet, CompileError | CssError | OutOfMemoryError>.Failure { error } => {
      match move error {
        OutOfMemoryError allocation => { fail move allocation }
        _ => {
          let mut message = run String.copy("silkui: could not compile stylesheet: ")
          run String.append(&mut message, path)
          fail TaskError { message: move message, status: 1 }
        }
      }
    }
  }
  let diagnostics = sheet.diagnostics.asSlice()
  let mut i: usize = 0
  while i < diagnostics.length {
    let item = &diagnostics[i]
    let kind = match item.kind {
      DiagnosticKind.AtRule => "at-rule"
      DiagnosticKind.Selector => "selector"
      DiagnosticKind.Property => "property"
      DiagnosticKind.Value => "value"
      DiagnosticKind.Unsupported => "feature"
    }
    let feature = match String.fromUtf8(item.feature.asSlice()) {
      Result.Success { value } => value
      Result.Failure { .. } => "<non-UTF-8>"
    }
    StderrWriter.print("silkui: {}: dropped {} {} occurrence(s): {}\n", &.(path, item.count, kind, feature))
    i = i + 1
  }
  let still = run animatable.stillKeyframes(&sheet)
  i = 0
  while i < still.length() {
    let item = &still.asSlice()[i]
    let rule = match String.fromUtf8(item.keyframes.asSlice()) {
      Result.Success { value } => value
      Result.Failure { .. } => "<non-UTF-8>"
    }
    let property = match String.fromUtf8(animatable.propertyName(item.property)) {
      Result.Success { value } => value
      Result.Failure { .. } => "<non-UTF-8>"
    }
    StderrWriter.print("silkui: {}: @keyframes {} sets {}, which Silk UI does not animate: it keeps its base value\n", &.(path, rule, property))
    i = i + 1
  }
  return run sheet.encode()
}

pub effect fn emit(root: string, paths: &[string<'static>], host: string, dom: bool) -> ()
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  run emitWithCompiled(root, paths, host, dom, "")
}

pub effect fn emitWithCompiled(root: string, paths: &[string<'static>], host: string, dom: bool, compiledPath: string) -> ()
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut encoded = List<Bytes>.make()
  let mut i: usize = 0
  while i < paths.length {
    let sourceName = run joined(root, paths[i])
    let sourcePath = run sourcePath(root, paths[i])
    if !run FileSystem.exists(&sourcePath) {
      let mut message = run String.copy("silkui: stylesheet not found: ")
      run String.append(&mut message, String.view(&sourceName))
      fail TaskError { message: move message, status: 1 }
    }
    let source = run FileSystem.readFile(&sourcePath)
    let bundled = run font_assets.bundle(source.asSlice(),root,String.view(&sourceName))
    let data = if dom { move bundled } else { run compiled(bundled.asSlice(), String.view(&sourceName)) }
    let destination = run joined(host, String.view(&run name(i, dom)))
    let file = run Path.make(String.view(&destination))
    run FileSystem.writeFileWithParents(&file, data.asSlice())
    if !dom { run encoded.append(move data) }
    i = i + 1
  }
  if !dom && compiledPath != "" {
    let source = run Path.make(compiledPath)
    let data = run FileSystem.readFile(&source)
    drop run Effect.catch<DecodeError>(Sheet.decode(data.asSlice(), &Limits.make()), compiledFailure)
    let file = run Path.make(String.view(&run joined(host, String.view(&run name(i, false)))))
    run FileSystem.writeFileWithParents(&file, data.asSlice())
    run encoded.append(move data)
  }
  if !dom && encoded.length() != 0 {
    let update = run Effect.catch<DecodeError>(bundle.encode(encoded.asSlice()), bundleFailure)
    let path = run Path.make(String.view(&run joined(host, "styles.update")))
    run Effect.catch<AtomicWriteError>(FileSystem.writeFileAtomic(&path, update.asSlice(), FileSystem.replaceExisting(), FileSystem.buffered()), atomicFailure)
  }
}

effect fn compiledFailure(error: DecodeError) -> never ! TaskError | OutOfMemoryError ? &mut Allocator {
  drop error
  fail TaskError { message: run String.copy("silkui: app.sheet is invalid or was built with a different stylesheet compiler; rebuild it with the matching @silkui/vite version"), status: 1 }
}

effect fn bundleFailure(error: DecodeError) -> never ! TaskError | OutOfMemoryError ? &mut Allocator {
  drop error
  fail TaskError { message: run String.copy("silkui: compiled stylesheets exceed the update bundle limits"), status: 1 }
}

effect fn atomicFailure(error: AtomicWriteError) -> never ! FileError {
  fail move error.cause
}

/// Content fingerprints include missing paths so deletion and recreation are changes.
pub effect fn fingerprint(root: string, paths: &[string<'static>]) -> u64
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut hash: u64 = 2166136261
  let mut i: usize = 0
  while i < paths.length {
    let path = run sourcePath(root, paths[i])
    let present = run FileSystem.exists(&path)
    let marker: u64 = if present { 1 } else { 0 }
    hash = ((hash ^ marker) * 16777619) & 4294967295
    if present {
      let bytes = run FileSystem.readFile(&path)
      let sourceName = run joined(root,paths[i])
      let bundled = run font_assets.bundle(bytes.asSlice(),root,String.view(&sourceName))
      let source = bundled.asSlice()
      let mut at: usize = 0
      while at < source.length {
        hash = ((hash ^ u8.toU64(source[at])) * 16777619) & 4294967295
        at = at + 1
      }
    }
    hash = ((hash ^ 255) * 16777619) & 4294967295
    i = i + 1
  }
  return hash
}

pub effect fn sourcePath(root: string, child: string) -> Path
  ! FileError | OutOfMemoryError ? &mut Allocator {
  if String.startsWith(child, "/") { return run Path.make(child) }
  let base = run Path.make(root)
  return run Path.resolve(&base, child)
}
