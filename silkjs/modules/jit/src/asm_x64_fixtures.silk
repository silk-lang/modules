effect fn chainProgram() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  let mut labels = List<Label>.make()
  while labels.length() < 3 { let label = run a.label() run labels.append(label) }
  run a.jmp(labels.get(1))
  run nops(&mut a, 60)
  run a.jcc(Cond.Sign, labels.get(2))
  run nops(&mut a, 63)
  a.bind(labels.get(1))
  run nops(&mut a, 2)
  a.bind(labels.get(2))
  run a.ret()
  return run a.finish()
}

