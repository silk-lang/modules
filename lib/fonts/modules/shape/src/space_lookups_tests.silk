//! Whether glyphs take part in layout (`separable`), over corpus fonts and hand-built tables.
import test_fonts
import space_lookups {
  spaceGlyph,
  spaceSeparable,
  glyphInLayout,
  glyphLayoutUse,
  glyphLayoutUseAfter,
  tableLayoutUse,
  gdefUse,
  LayoutUse,
  REASON_NONE,
  REASON_IGNORE_BASE,
  REASON_MARK_CLASS,
  REASON_COVERAGE,
  REASON_LIGATURE_COMPONENT,
  REASON_RULE_LOOKAHEAD,
  REASON_INPUT_COVERAGE,
  REASON_PAIR_SECOND,
  REASON_PAIR_CLASS,
  REASON_UNKNOWN_LOOKUP,
  REASON_UNANALYZED_TABLE,
  NO_LOOKUP
}
import view { View }
import read_fonts.lib { FontRef, ReadError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
import silk.testing.testing { Testing, AssertionError }

const GSUB: u32 = 0x47535542

const GPOS: u32 = 0x47504f53

/// The space glyph of the tables below.
const SPACE: u32 = 3

// The tables are a version 1.0 header with null script and feature lists and one or two
// lookups; their first glyphs are glyph 5.

/// GPOS: a class pair adjustment of glyph 5 with one first class and two second classes, where
/// ClassDef2 lists glyph 7 alone (class 1) and the class 0 column moves by -50.
const PAIR_CLASS_ZERO: &[u8] = b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x01\x00\x04\x00\x02\x00\x00\x00\x01\x00\x08\x00\x02\x00\x14\x00\x04\x00\x00\x00\x00\x00\x1a\x00\x01\x00\x02\xff\xce\x00\x00\x00\x01\x00\x01\x00\x05\x00\x02\x00\x01\x00\x07\x00\x07\x00\x01"

/// The same with the class 0 column zero and the class 1 column moving by -50.
const PAIR_CLASS_OTHER: &[u8] = b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x01\x00\x04\x00\x02\x00\x00\x00\x01\x00\x08\x00\x02\x00\x14\x00\x04\x00\x00\x00\x00\x00\x1a\x00\x01\x00\x02\x00\x00\xff\xce\x00\x01\x00\x01\x00\x05\x00\x02\x00\x01\x00\x07\x00\x07\x00\x01"

/// GPOS: lookup 0 a single adjustment of glyph 9; lookup 1 an extension (type 9) holding a
/// glyph pair adjustment of glyph 5 followed by glyph 3.
const PAIR_EXTENSION: &[u8] = b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x02\x00\x06\x00\x1a\x00\x01\x00\x00\x00\x01\x00\x08\x00\x01\x00\x06\x00\x00\x00\x01\x00\x01\x00\x09\x00\x09\x00\x00\x00\x01\x00\x08\x00\x01\x00\x02\x00\x00\x00\x08\x00\x01\x00\x12\x00\x04\x00\x00\x00\x01\x00\x0c\x00\x01\x00\x03\xff\xd8\x00\x01\x00\x01\x00\x05"

/// GSUB: a chained class context of glyph 5 with one rule whose lookahead is class 0, where the
/// lookahead ClassDef lists glyph 10 alone (class 1).
const CHAIN_CLASS_ZERO: &[u8] = b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x01\x00\x04\x00\x06\x00\x00\x00\x01\x00\x08\x00\x02\x00\x1c\x00\x00\x00\x00\x00\x22\x00\x01\x00\x0e\x00\x01\x00\x04\x00\x00\x00\x01\x00\x01\x00\x00\x00\x00\x00\x01\x00\x01\x00\x05\x00\x01\x00\x0a\x00\x01\x00\x01"

/// The same with the rule's lookahead class 1.
const CHAIN_CLASS_OTHER: &[u8] = b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x01\x00\x04\x00\x06\x00\x00\x00\x01\x00\x08\x00\x02\x00\x1c\x00\x00\x00\x00\x00\x22\x00\x01\x00\x0e\x00\x01\x00\x04\x00\x00\x00\x01\x00\x01\x00\x01\x00\x00\x00\x01\x00\x01\x00\x05\x00\x01\x00\x0a\x00\x01\x00\x01"

/// GSUB: a single substitution of glyph 5 whose lookup ignores base glyphs.
const IGNORE_BASE: &[u8] = b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x01\x00\x04\x00\x01\x00\x02\x00\x01\x00\x08\x00\x01\x00\x06\x00\x01\x00\x01\x00\x01\x00\x05"

/// GSUB: the ligature of glyphs 5 and 3.
const LIGATURE: &[u8] = b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x01\x00\x04\x00\x04\x00\x00\x00\x01\x00\x08\x00\x01\x00\x12\x00\x01\x00\x08\x00\x01\x00\x04\x00\x14\x00\x02\x00\x03\x00\x01\x00\x01\x00\x05"

/// GSUB: a lookup of type 9, which GSUB does not define.
const UNKNOWN: &[u8] = b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x01\x00\x04\x00\x09\x00\x00\x00\x01\x00\x08\x00\x01\x00\x06\x00\x01\x00\x01\x00\x01\x00\x05"

/// GDEF 1.0 whose glyph class definition makes glyph 3 a mark.
const GDEF_MARKS: &[u8] = b"\x00\x01\x00\x00\x00\x0c\x00\x00\x00\x00\x00\x00\x00\x01\x00\x03\x00\x01\x00\x03"

fn uses(table: &[u8], positioning: bool, glyph: u32) -> LayoutUse {
  return tableLayoutUse(View.bytes(table), positioning, glyph)
}

test effect fn layoutTablesFromBytes() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    !uses(b"", false, SPACE).involved && !uses(b"", true, SPACE).involved,
    "no table, no use",
  )

  // A class pair adjustment counts the second class of an unlisted glyph, class 0.
  let zero = uses(PAIR_CLASS_ZERO, true, SPACE)
  run Testing.expect(
    zero.involved && zero.table == GPOS && zero.lookup == 0 && zero.kind == 2 && zero.format == 2
      && zero.reason == REASON_PAIR_CLASS,
    "a nonzero class 0 column involves unlisted glyphs",
  )
  run Testing.expect(
    !uses(PAIR_CLASS_ZERO, true, 7).involved,
    "a zero column leaves its glyphs out",
  )
  run Testing.expect(
    !uses(PAIR_CLASS_OTHER, true, SPACE).involved,
    "a zero class 0 column leaves unlisted glyphs out",
  )
  run Testing.expect(
    uses(PAIR_CLASS_OTHER, true, 7).reason == REASON_PAIR_CLASS,
    "a nonzero class 1 column involves its glyphs",
  )
  run Testing.expect(
    uses(PAIR_CLASS_OTHER, true, 5).reason == REASON_COVERAGE,
    "first glyphs are covered",
  )

  // Extensions resolve to the lookup type they hold.
  let extended = uses(PAIR_EXTENSION, true, SPACE)
  run Testing.expect(
    extended.involved && extended.lookup == 1 && extended.kind == 2 && extended.format == 1
      && extended.reason == REASON_PAIR_SECOND,
    "an extension's pair second glyph",
  )
  run Testing.expect(
    uses(PAIR_EXTENSION, true, 5).lookup == 1 && uses(PAIR_EXTENSION, true, 9).lookup == 0
      && !uses(PAIR_EXTENSION, true, 4).involved,
    "extension coverage, plain coverage and an unused glyph",
  )
  run Testing.expect(
    uses(PAIR_EXTENSION, false, 4).reason == REASON_UNKNOWN_LOOKUP,
    "the same lookup types read as GSUB are unknown",
  )

  // Class context rules count class 0 for unlisted glyphs, in every sequence.
  let chained = uses(CHAIN_CLASS_ZERO, false, SPACE)
  run Testing.expect(
    chained.involved && chained.table == GSUB && chained.kind == 6 && chained.format == 2
      && chained.reason == REASON_RULE_LOOKAHEAD,
    "a class 0 lookahead involves unlisted glyphs",
  )
  run Testing.expect(
    !uses(CHAIN_CLASS_ZERO, false, 10).involved,
    "a listed glyph outside the rule's class",
  )
  run Testing.expect(
    !uses(CHAIN_CLASS_OTHER, false, SPACE).involved
      && uses(CHAIN_CLASS_OTHER, false, 10).reason == REASON_RULE_LOOKAHEAD,
    "a class 1 lookahead involves only its glyphs",
  )

  run Testing.expect(
    uses(IGNORE_BASE, false, SPACE).reason == REASON_IGNORE_BASE,
    "a lookup that skips base glyphs involves every glyph",
  )
  run Testing.expect(
    uses(LIGATURE, false, SPACE).reason == REASON_LIGATURE_COMPONENT
      && !uses(LIGATURE, false, 4).involved,
    "ligature components",
  )
  let unknown = uses(UNKNOWN, false, SPACE)
  run Testing.expect(
    unknown.involved && unknown.kind == 9 && unknown.reason == REASON_UNKNOWN_LOOKUP,
    "unknown lookup types involve every glyph",
  )

  run Testing.expect(
    gdefUse(View.bytes(GDEF_MARKS), SPACE) == REASON_MARK_CLASS
      && gdefUse(View.bytes(GDEF_MARKS), 4) == REASON_NONE,
    "GDEF marks",
  )

  // Truncated tables involve the glyph rather than hide it.
  run Testing.expect(
    tableLayoutUse(View.range(&View.bytes(PAIR_CLASS_OTHER), 0, 40), true, SPACE).involved,
    "a truncated class pair table",
  )
}

effect fn font(name: string) -> Bytes
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  return run test_fonts.read(name)
}

effect fn fontCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError
  ? &mut Allocator {
  // No layout tables at all: the space glyph is separable.
  let plainBytes = run font("tests/fonts/in-house/1c2c3fc37b2d4c3cb2ef726c6cdaaabd4b7f3eb9.ttf")
  let plain = match move FontRef.new(Bytes.asSlice(&plainBytes)) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "font without layout tables")
      return
    }
  }
  run Testing.expect(
    (spaceGlyph(&plain) |> Option<u32>.unwrapOr(0)) == 1 && spaceSeparable(&plain)
      && !glyphInLayout(&plain, 1),
    "a font without layout tables is separable",
  )

  // Roboto kerns space as the first glyph of pairs.
  let robotoBytes = run font("benches/fonts/Roboto-Regular.ttf")
  let roboto = match move FontRef.new(Bytes.asSlice(&robotoBytes)) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "Roboto fixture")
      return
    }
  }
  let space = spaceGlyph(&roboto) |> Option<u32>.unwrapOr(0)
  let kerned = glyphLayoutUse(&roboto, space)
  run Testing.expect(
    space == 5 && !spaceSeparable(&roboto) && kerned.table == GPOS && kerned.lookup == 1
      && kerned.kind == 2
      && kerned.reason == REASON_COVERAGE,
    "Roboto kerns space",
  )

  // Every reason in turn: two frac lookups, then kerning.
  let serifBytes = run font("benches/fonts/SourceSerifVariable-Roman.ttf")
  let serif = match move FontRef.new(Bytes.asSlice(&serifBytes)) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "Source Serif fixture")
      return
    }
  }
  let serifSpace = spaceGlyph(&serif) |> Option<u32>.unwrapOr(0)
  let first = glyphLayoutUse(&serif, serifSpace)
  let second = glyphLayoutUseAfter(&serif, serifSpace, first)
  let third = glyphLayoutUseAfter(&serif, serifSpace, second)
  let last = glyphLayoutUseAfter(&serif, serifSpace, third)
  run Testing.expect(
    first.table == GSUB && first.lookup == 17 && first.reason == REASON_INPUT_COVERAGE
      && second.table == GSUB
      && second.lookup == 18
      && second.reason == REASON_COVERAGE
      && third.table == GPOS
      && third.lookup == 7
      && !last.involved
      && last.lookup == NO_LOOKUP,
    "reasons in table and lookup order",
  )

  // Legacy and AAT tables are not analyzed.
  let kernBytes = run font("tests/fonts/text-rendering-tests/TestKERNOne.otf")
  let kern = match move FontRef.new(Bytes.asSlice(&kernBytes)) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "kern fixture")
      return
    }
  }
  let legacy = glyphLayoutUse(&kern, spaceGlyph(&kern) |> Option<u32>.unwrapOr(0))
  run Testing.expect(
    legacy.table == 0x6b65726e && legacy.reason == REASON_UNANALYZED_TABLE
      && !spaceSeparable(&kern),
    "a legacy kern table",
  )
  let morxBytes = run font("tests/fonts/text-rendering-tests/TestMORXTen.ttf")
  let morx = match move FontRef.new(Bytes.asSlice(&morxBytes)) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "morx fixture")
      return
    }
  }
  run Testing.expect(
    glyphLayoutUse(&morx, 1).table == 0x6d6f7278 && !spaceSeparable(&morx),
    "a morx table",
  )
}

test effect fn spaceInCorpusFonts() -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fontCases() |> Effect.provideMut<Allocator>(&mut allocator)
}
