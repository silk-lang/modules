//! Shaped glyph runs, the paint side of `TextRun.shapeKey`.
//!
//! Every text fragment css-layout produces carries the `shapeKey` of the run it came from.
//! [`GlyphStore.glyphRun`] and [`GlyphStore.glyphsOf`] give that run's font and its glyphs, positioned
//! from the fragment's left edge, ready to be looked up in a `font-raster` glyph cache.
//! Identical runs share one key, so reshaping the same text during line fitting adds nothing.
import properties.census { Census }
import silk.collections.hash { Hash, HashSeed, Word }
import silk.collections.hash_map { HashMap }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// One glyph of a run, in CSS pixels. A long document holds one for every glyph it shows, so
/// the fields are narrow and ordered to pack: 24 bytes.
pub struct PositionedGlyph {
  pub glyph: u32,
  /// Where the cluster the glyph belongs to starts, in bytes from the start of the run's own
  /// text: add the text fragment's `sourceStart` for the offset in the text node. Runs of the
  /// same text in the same font are then equal, and the store keeps one of them. A run's
  /// offsets fit: the shaper's own clusters are 32 bits.
  pub cluster: u32,
  /// The glyph origin, from the left edge of the run and from its baseline, y down.
  pub x: f32,
  pub y: f32,
  /// The pen advance after the glyph, justification included.
  pub advance: f32,
  /// An upright glyph shaped with vertical metrics, in logical inline/block coordinates.
  pub upright: bool,
}

impl Copy for PositionedGlyph {}

/// A run of glyphs in one font, in visual (left to right) order.
pub struct GlyphRun {
  /// The font key of the run, as `TextFragment.fontKey` and `Measure.font` use it.
  pub fontKey: usize,
  /// The face index in the font collection, and the face id for `font-raster` keys.
  pub face: usize,
  /// The font size in CSS pixels.
  pub size: f32,
  pub rtl: bool,
  /// The sum of the glyph advances: the width of the fragment.
  pub advance: f32,
  start: usize,
  end: usize,
  hash: u64,
}

impl Copy for GlyphRun {}

impl GlyphRun {
  /// Fingerprint of the font key, size, direction and positioned glyphs. Together
  /// with the raster face identity, this validates paint metadata across key reuse.
  pub fn fingerprint(self: &Self) -> u64 {
    return self.hash
  }
}

pub struct GlyphStore {
  seed: HashSeed,
  map: HashMap<Word, u32>,
  runs: List<GlyphRun>,
  glyphs: List<PositionedGlyph>,
  // Counts the clears, for holders of keys.
  clears: usize,
  // For the bench census: intern calls, the glyphs they hashed, and those that found their run.
  pub interns: usize,
  pub internGlyphs: usize,
  pub internHits: usize,
}

fn sameGlyphs(left: &[PositionedGlyph], right: &[PositionedGlyph]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index: usize = 0
  while index < left.length {
    let a = left[index]
    let b = right[index]
    if a.upright != b.upright || a.glyph != b.glyph || a.cluster != b.cluster || a.x != b.x
      || a.y != b.y
      || a.advance != b.advance {
      return false
    }
    index = index + 1
  }
  return true
}

impl GlyphStore {
  /// What the store holds, for the bench census.
  pub effect fn census(self: &Self, out: &mut Census) -> () ! OutOfMemoryError ? &mut Allocator {
    run out.held("text.glyph-store.map", self.map.length(), self.map.bucketCount(), 25)
    run out.held("text.glyph-store.runs", self.runs.length(), self.runs.capacity(), Intrinsic.layoutOf<GlyphRun>().bytes)
    run out.held("text.glyph-store.glyphs(PositionedGlyph)", self.glyphs.length(), self.glyphs.capacity(), Intrinsic.layoutOf<PositionedGlyph>().bytes)
    run out.work("text.glyph-store.interns", self.interns)
    run out.work("text.glyph-store.intern-glyphs-hashed", self.internGlyphs)
    run out.work("text.glyph-store.intern-hits", self.internHits)
  }

  pub fn make() -> GlyphStore {
    let seed = Hash.seed(0x676c797068)
    return GlyphStore {
      seed: seed,
      map: HashMap<Word, u32>.make(seed),
      runs: List<GlyphRun>.make(),
      glyphs: List<PositionedGlyph>.make(),
      clears: 0,
      interns: 0, internGlyphs: 0, internHits: 0,
    }
  }

  /// A number that changes whenever [`GlyphStore.clear`] invalidates the keys handed out.
  pub fn epoch(self: &Self) -> usize {
    return self.clears
  }

  /// The number of distinct runs kept.
  pub fn length(self: &Self) -> usize {
    return self.runs.length()
  }

  /// Forgets every run. Keys handed out before become invalid, so the layout tree that holds
  /// them must be invalidated (`LayoutTree.invalidate`) before its next compute.
  pub fn clear(self: &mut Self) -> () {
    self.map.clear()
    self.runs.clear()
    self.glyphs.clear()
    self.clears = self.clears + 1
  }

  /// Forgets the runs added after the store had `length` of them; the keys of the others stay
  /// valid.
  pub fn truncate(self: &mut Self, length: usize) -> () {
    while self.runs.length() > length {
      let last = self.runs.get(self.runs.length() - 1)
      if let Option<u32>.Some { value } = self.map.get(Word { value: last.hash }) {
        if u32.toUsize(value) == self.runs.length() - 1 { drop self.map.remove(Word { value: last.hash }) }
      }
      self.glyphs.truncate(last.start)
      drop self.runs.pop()
    }
  }

  /// [`GlyphStore.clear`], giving the runs' storage back as well: for a tree that shows far
  /// less text than it did.
  pub fn release(self: &mut Self) -> () {
    self.map.clearAndFree()
    self.runs.clearAndFree()
    self.glyphs.clearAndFree()
    self.clears = self.clears + 1
  }

  fn hashOf(self: &Self, fontKey: usize, size: f32, rtl: bool, glyphs: &[PositionedGlyph]) -> u64 {
    let mut hashed = Hash.mix(&self.seed, usize.toU64(fontKey))
    hashed = Hash.combine(hashed, u32.toU64(f32.toBits(size)))
    if rtl {
      hashed = Hash.combine(hashed, 1)
    }
    let mut index: usize = 0
    while index < glyphs.length {
      let glyph = glyphs[index]
      hashed = Hash.combine(
        hashed,
        u64.bitOr(u32.toU64(glyph.glyph), u64.shiftLeft(u32.toU64(glyph.cluster), 32)),
      )
      hashed = Hash.combine(
        hashed,
        u64.bitOr(
          u32.toU64(f32.toBits(glyph.x)),
          u64.shiftLeft(u32.toU64(f32.toBits(glyph.advance)), 32),
        ),
      )
      hashed = Hash.combine(hashed, u32.toU64(f32.toBits(glyph.y)))
      hashed = Hash.combine(
        hashed,
        if glyph.upright {
          1
        } else {
          0
        },
      )
      index = index + 1
    }
    return hashed
  }

  /// The key of a run with these glyphs, adding it when it is new.
  pub effect fn intern(
    self: &mut Self,
    fontKey: usize,
    face: usize,
    size: f32,
    rtl: bool,
    glyphs: &[PositionedGlyph],
  ) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    self.interns = self.interns + 1
    self.internGlyphs = self.internGlyphs + glyphs.length
    let hashed = self.hashOf(fontKey, size, rtl, glyphs)
    if let Option<u32>.Some { value } = self.map.get(Word { value: hashed }) {
      let existing = self.runs.get(u32.toUsize(value))
      if existing.fontKey == fontKey && existing.size == size && existing.rtl == rtl
        && sameGlyphs(
          Slice.view(self.glyphs.asSlice(), existing.start, existing.end - existing.start),
          glyphs,
        ) {
        self.internHits = self.internHits + 1
        return u32.toUsize(value)
      }
    }
    let start = self.glyphs.length()
    run self.glyphs.appendSlice(glyphs)
    let mut advance: f32 = 0.0
    let mut index: usize = 0
    while index < glyphs.length {
      advance = advance + glyphs[index].advance
      index = index + 1
    }
    let key = self.runs.length()
    run self.runs.append(
      GlyphRun {
        fontKey: fontKey,
        face: face,
        size: size,
        rtl: rtl,
        advance: advance,
        start: start,
        end: self.glyphs.length(),
        hash: hashed,
      },
    )
    drop run self.map.insert(Word { value: hashed }, usize.toU32(key))
    return key
  }

  /// The run behind `shapeKey`.
  pub fn glyphRun(self: &Self, shapeKey: usize) -> GlyphRun {
    return self.runs.get(shapeKey)
  }

  /// The glyphs of the run behind `shapeKey`, in visual order.
  pub fn glyphsOf(self: &Self, shapeKey: usize) -> &[PositionedGlyph] {
    let value = self.runs.get(shapeKey)
    return Slice.view(self.glyphs.asSlice(), value.start, value.end - value.start)
  }
}
