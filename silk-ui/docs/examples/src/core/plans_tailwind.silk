//! The plan picker a third time, with Tailwind classes. Tailwind reads the literal
//! class strings in this file and writes the CSS for them.
import loom.lib { Document, Node, NoCommand, NoOutput, Program, Role, Update }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct Plans {
  /// The plan that is chosen: 0, 1 or 2.
  pub chosen: u32,
}

pub union Message {
  ClickedPlan { pub plan: u32 },
}

type Next = Update<Plans, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Plans {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(Plans { chosen: 1 })
  }

  effect fn update(mut model: Plans, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.ClickedPlan { plan } => {
        model.chosen = plan
      }
    }
    return Next.of(move model)
  }

  fn view(model: &Plans, h: &Document<Message>) -> Node {
    return h.box(
      &[h.accessRole(Role.Group), h.label("Plan"), h.class("flex gap-3 p-4 text-gray-800")],
      &[
        plan(h, model, 0, "Solo", "One person", 0),
        plan(h, model, 1, "Team", "Up to ten people", 12),
        plan(h, model, 2, "Company", "Everyone", 40),
      ],
    )
  }
}

/// One plan, as a card that can be chosen.
fn plan(
  h: &Document<Message>,
  model: &Plans,
  index: u32,
  name: string,
  about: string,
  dollars: i64,
) -> Node {
  let chosen = model.chosen == index
  return h.button(
    &[
      h.accessRole(Role.Radio),
      h.checked(chosen),
      h.onClick(Message.ClickedPlan { plan: index }),
      // Tailwind finds classes by reading this file, so each one is written out whole.
      h.class("flex-1 basis-0 rounded-xl border p-3.5 transition-colors active:translate-y-px focus-visible:border-gray-800"),
      h.classSelect(chosen, "border-teal-700 bg-teal-50", "border-gray-300 bg-white hover:border-gray-500"),
    ],
    &[
      h.box(
        &[h.class("flex flex-col items-start gap-1")],
        &[
          h.box(&[h.class("font-bold")], &[h.text(name)]),
          h.box(&[h.class("text-[13px] text-gray-500")], &[h.text(about)]),
          h.box(&[h.class("mt-2 text-xl font-bold")], &[h.text("$"), h.number(dollars)]),
        ],
      ),
    ],
  )
}
