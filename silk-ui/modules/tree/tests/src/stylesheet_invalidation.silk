import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, Input, StyleState, BUTTON_PRIMARY, Role }
import ui_tree.mutation { Mutation }
import font_collection.lib { FontCollection }
import ui_fixtures.fixtures as fixtures
import svg_css.compile { Options, CompileError }
import svg_css.compile
import svg_css.tokens { CssError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import ui_tree.style { Fill }

fn frame() -> FrameInput { return FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 } }
fn width(tree: &UiTree<'_>, id: u32) -> f32 { return tree.node(tree.slotOf(id)).computed().layout.width.value }
fn height(tree: &UiTree<'_>, id: u32) -> f32 { return tree.node(tree.slotOf(id)).computed().layout.height.value }
fn opacity(tree: &UiTree<'_>, id: u32) -> f32 { return tree.node(tree.slotOf(id)).computed().paint.opacity }
fn scope(tree: &UiTree<'_>, id: u32) -> usize {
  return match tree.node(tree.slotOf(id)).sheetStyle() { Option.Some { value } => value.scope.index _ => 999999 }
}

effect fn node(batch: &mut Batch, id: u32, parent: u32, classes: string) -> () ! OutOfMemoryError ? &mut Allocator {
  run batch.create(id, NodeKind.Box)
  if parent == 0 { run batch.root(id) } else { run batch.append(parent, id) }
  run batch.attribute(id, Attribute.ClassName { value: run String.copy(classes) })
}

effect fn sheet(batch: &mut Batch, source: &[u8]) -> () ! CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let compiled = run compile.compile(source, &Options.make())
  let bytes = run compiled.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
}

effect fn localChanges() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run node(&mut batch, 1, 0, "host")
  run node(&mut batch, 2, 1, "row")
  run node(&mut batch, 3, 1, "row")
  run node(&mut batch, 4, 2, "leaf")
  run sheet(&mut batch, b"@property --unit{syntax:'<length>';inherits:false;initial-value:10px}.host{display:block;width:400px;height:300px}.row{display:block;width:100px;height:50px;--unit:10px}.wide{width:120px}.leaf{width:inherit;height:var(--unit)}.row:hover{opacity:.5}.row:active{opacity:.25}")
  run tree.apply(run batch.take())
  run tree.frame(frame())
  let rowScope = scope(&tree, 2)
  let leafScope = scope(&tree, 4)
  let mut wide = false
  let mut i: usize = 0
  while i < 200 {
    wide = !wide
    run batch.attribute(2, Attribute.ClassName { value: run String.copy(if wide { "row wide" } else { "row" }) })
    run tree.apply(run batch.take())
    run Testing.expect(!tree.stylesDirty && tree.stylesPending && !tree.node(tree.slotOf(3)).styleDirty, "a local class change does not dirty the root or sibling")
    run tree.frame(frame())
    let expected: f32 = if wide { 120.0 } else { 100.0 }
    run Testing.expect(width(&tree, 2) == expected && width(&tree, 4) == expected, "partial restyles propagate explicit inheritance of non-text properties")
    run Testing.expect(height(&tree, 4) == 10.0 && scope(&tree, 2) == rowScope && scope(&tree, 4) == leafScope
      && tree.styleSheets.asSlice()[0].sheets.canRetainScopes(), "repeated ordinary class changes retain registered variable scopes")
    i = i + 1
  }
  run tree.dispatch(Input.PointerMove { x: 20.0, y: 20.0, modifiers: 0 })
  run Testing.expect(!tree.stylesDirty && tree.stylesPending && !tree.node(tree.slotOf(1)).styleDirty, "hover dirties only nodes with candidate state dependencies")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 2) == 0.5 && opacity(&tree, 3) == 1.0, "local hover applies without changing the sibling")
  run tree.dispatch(Input.PointerDown { x: 20.0, y: 20.0, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 })
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 2) == 0.25, "active state uses the same incremental path")
  run tree.dispatch(Input.PointerUp { x: 20.0, y: 20.0, button: BUTTON_PRIMARY, modifiers: 0 })
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 2) == 0.5, "release restores hover")
  run tree.dispatch(Input.PointerMove { x: 350.0, y: 250.0, modifiers: 0 })
  run tree.frame(frame())
  run tree.dispatch(Input.PointerMove { x: 360.0, y: 250.0, modifiers: 0 })
  run Testing.expect(!tree.stylesDirty && !tree.stylesPending && opacity(&tree, 2) == 1.0, "pointer movement over plain nodes does no stylesheet work")
}

test effect fn stylesheetLocalClassesAndPointerStatesRetainScopes() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run localChanges() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn relationalChanges() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run node(&mut batch, 1, 0, "host")
  run node(&mut batch, 2, 1, "row eligible")
  run node(&mut batch, 3, 1, "row eligible")
  run node(&mut batch, 4, 1, "row eligible")
  run sheet(&mut batch, b".host{display:block;width:400px;height:300px}.row{width:100px;height:50px}.selected+.row{width:130px}.row:nth-child(2 of .eligible){height:25px}.host:has(.selected){opacity:.5}.row:nth-last-child(1 of :hover){opacity:.25}.host:has(.row:hover){opacity:.75}")
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(height(&tree, 3) == 25.0, "initial nth-of membership")
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("row eligible selected") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && tree.node(tree.slotOf(1)).styleDirty, "a class read by a sibling rule and by :has() restyles the parent, which is also the anchor")
  run tree.frame(frame())
  run Testing.expect(width(&tree, 3) == 130.0 && opacity(&tree, 1) == 0.5, "class changes update siblings and ancestors")
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("row selected") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && tree.node(tree.slotOf(1)).styleDirty, "changing a filtered nth-child member restyles its parent's subtree, not the root")
  run tree.frame(frame())
  run Testing.expect(height(&tree, 3) == 50.0 && height(&tree, 4) == 25.0, "nth-of filtering recomputes the affected sibling positions")
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("row") })
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(width(&tree, 3) == 100.0 && opacity(&tree, 1) == 1.0, "removing a relational class clears prior matches")
  run tree.dispatch(Input.PointerMove { x: 20.0, y: 20.0, modifiers: 0 })
  run Testing.expect(!tree.stylesDirty && tree.node(tree.slotOf(1)).styleDirty, "state changes inside has and nth-of reach the anchor and the siblings, not the root")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 2) == 0.25 && opacity(&tree, 1) == 0.75, "relational hover updates sibling filtering and the ancestor")
  run tree.dispatch(Input.PointerMove { x: 20.0, y: 70.0, modifiers: 0 })
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 2) == 1.0 && opacity(&tree, 3) == 0.25, "moving between siblings updates the filtered hover subject")
  run tree.dispatch(Input.PointerLeave)
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 1) == 1.0 && opacity(&tree, 3) == 1.0, "leaving clears relational state matches")
}

test effect fn stylesheetInvalidationReachesSiblingsAncestorsAndNthFilters() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run relationalChanges() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn laidHeight(tree: &UiTree<'_>, id: u32) -> f32 {
  let node = tree.node(tree.slotOf(id))
  return tree.output.fragments.values.asSlice()[tree.fragmentOf.get(node.css)].size.height
}
fn matched(tree: &UiTree<'_>) -> usize { return tree.work.sheetMatches + tree.work.sheetTwins }

effect fn childListChanges() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run node(&mut batch, 1, 0, "host")
  run node(&mut batch, 2, 1, "list")
  run node(&mut batch, 10, 2, "row")
  run node(&mut batch, 20, 10, "leaf")
  run node(&mut batch, 11, 2, "row")
  run node(&mut batch, 21, 11, "leaf")
  run node(&mut batch, 12, 2, "pick")
  let mut id: u32 = 100
  while id < 140 {
    run node(&mut batch, id, 2, "plain")
    run node(&mut batch, id + 100, id, "cell")
    id = id + 1
  }
  run sheet(&mut batch, b".host{display:block;width:400px}.list{display:block;width:300px}.row{display:block;width:100px;height:20px}.leaf{display:block;width:10px;height:5px}.plain{display:block;width:90px;height:4px}.cell{display:block;width:8px;height:2px}.pick{display:block;width:60px}.mark{display:block;height:3px}.mark+.row{width:130px}.row:nth-child(2){opacity:.5}.mark+.row>.leaf{width:17px}.pick:nth-child(3)::before{content:'';display:block;height:7px}")
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 11) == 0.5 && width(&tree, 10) == 100.0 && width(&tree, 20) == 10.0 && laidHeight(&tree, 12) == 7.0, "initial places")

  // A child put first moves every place after it: the rules that read a place answer anew,
  // on the children, below them and on a pseudo-element, and nothing else restyles.
  let mut before = matched(&tree)
  run batch.create(50, NodeKind.Box)
  run batch.attribute(50, Attribute.ClassName { value: run String.copy("mark") })
  run batch.insertBefore(2, 50, 10)
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && !tree.node(tree.slotOf(2)).styleDirty && !tree.node(tree.slotOf(100)).styleDirty, "an inserted child does not restyle its parent's subtree")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 10) == 0.5 && opacity(&tree, 11) == 1.0, "nth-child follows the new places")
  run Testing.expect(width(&tree, 10) == 130.0 && width(&tree, 20) == 17.0 && width(&tree, 21) == 10.0, "the next-sibling rules reach the child and what is below it")
  run Testing.expect(laidHeight(&tree, 12) == 0.0, "a pseudo-element that read a place goes with it")
  run Testing.expect(matched(&tree) - before <= 8, "only the nodes whose rules read a place matched again")

  before = matched(&tree)
  run batch.push(Mutation.Remove { id: 50 })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && !tree.node(tree.slotOf(2)).styleDirty, "a removed child does not restyle its parent's subtree")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 10) == 1.0 && opacity(&tree, 11) == 0.5 && width(&tree, 10) == 100.0 && width(&tree, 20) == 10.0 && laidHeight(&tree, 12) == 7.0, "removing the child gives the places back")
  run Testing.expect(matched(&tree) - before <= 8, "a removal matches the readers again, no more")

  // Rows that mount at the end of a list, as a virtual list does while it scrolls.
  before = matched(&tree)
  id = 300
  while id < 304 {
    run batch.create(id, NodeKind.Box)
    run batch.attribute(id, Attribute.ClassName { value: run String.copy("plain") })
    run batch.create(id + 100, NodeKind.Box)
    run batch.attribute(id + 100, Attribute.ClassName { value: run String.copy("cell") })
    run batch.append(id, id + 100)
    run batch.append(2, id)
    id = id + 1
  }
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(width(&tree, 303) == 90.0 && width(&tree, 403) == 8.0 && opacity(&tree, 11) == 0.5, "appended rows take their styles")
  run Testing.expect(matched(&tree) - before <= 16, "appended rows match themselves and the readers")
}

test effect fn stylesheetChildListChangesRestyleOnlyThePlaceReaders() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run childListChanges() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn descendantsAndVariables() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run node(&mut batch, 1, 0, "host")
  run node(&mut batch, 2, 1, "group")
  run node(&mut batch, 3, 2, "leaf")
  run sheet(&mut batch, b".host{display:block;width:400px;height:300px}.group{width:200px;height:100px;--v:10px}.leaf{width:50px;height:var(--v)}.hot .leaf{width:70px}.group:hover .leaf{width:80px}.variable{--v:23px}.hidden{display:none}")
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("group hot") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty, "ordinary descendant selectors stay within the changed subtree")
  run tree.frame(frame())
  run Testing.expect(width(&tree, 3) == 70.0, "descendant class dependencies restyle children")
  run tree.dispatch(Input.PointerMove { x: 20.0, y: 20.0, modifiers: 0 })
  run tree.frame(frame())
  run Testing.expect(width(&tree, 3) == 80.0, "an ancestor's state invalidates descendant rules even when it has no own hover rule")
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("group hot variable") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && tree.node(tree.slotOf(2)).styleDirty, "custom-property candidate changes stay within the changed subtree")
  run tree.frame(frame())
  run Testing.expect(height(&tree, 3) == 23.0, "inherited variables update in the restyled subtree")
  run batch.customProperty(2, StyleState.Hover, "--v", Option<string>.some("31px"), false)
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(height(&tree, 3) == 31.0 && tree.styleSheets.asSlice()[0].sheets.canRetainScopes(), "inline state variables keep the retained scopes")
  run tree.dispatch(Input.PointerLeave)
  run tree.frame(frame())
  run Testing.expect(height(&tree, 3) == 23.0, "leaving an inline variable state restores the sheet scope")
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("leaf hidden") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && tree.node(tree.slotOf(3)).styleDirty, "a display change restyles the node's subtree")
  run tree.frame(frame())
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("leaf") })
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(tree.node(tree.slotOf(3)).rendered && height(&tree, 3) == 23.0, "reentry uses current inherited variables")
}

test effect fn stylesheetPartialRestylesPreserveDescendantsAndVariableEpochs() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run descendantsAndVariables() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pressureFallback() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run node(&mut batch, 1, 0, "host")
  let mut id: u32 = 2
  // One more distinct scope per node than the cache retains (4,096).
  while id <= 4300 {
    run node(&mut batch, id, id / 2, "branch")
    id = id + 1
  }
  run sheet(&mut batch, b"@property --unit{syntax:'<length>';inherits:false;initial-value:3px}.host{--unit:99px}.branch{width:100px;height:var(--unit)}.branch:nth-child(even){--unit:3px}.wide{width:120px}")
  run tree.apply(run batch.take())
  run tree.frame(frame())
  let initial = scope(&tree, 4300)
  run Testing.expect(!tree.styleSheets.asSlice()[0].sheets.canRetainScopes(), "distinct parent scopes exhaust the bounded scope cache")
  let mut wide = false
  let mut i: usize = 0
  while i < 3 {
    wide = !wide
    run batch.attribute(4300, Attribute.ClassName { value: run String.copy(if wide { "branch wide" } else { "branch" }) })
    run tree.apply(run batch.take())
    run tree.frame(frame())
    let expected: f32 = if wide { 120.0 } else { 100.0 }
    run Testing.expect(scope(&tree, 4300) == initial && height(&tree, 4300) == 3.0 && width(&tree, 4300) == expected, "pressure falls back to full restyles without accumulating stale scopes")
    i = i + 1
  }
}

test effect fn stylesheetScopePressureFallsBackToFullRestyles() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pressureFallback() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn dirty(tree: &UiTree<'_>, id: u32) -> bool { return tree.node(tree.slotOf(id)).styleDirty }

/// A host, a list, two rows with a cell each: ids 1, 2, 3 and 4, 5 (in row 3) and 6 (in row 4).
effect fn rows(batch: &mut Batch) -> () ! OutOfMemoryError ? &mut Allocator {
  run node(&mut batch, 1, 0, "host")
  run node(&mut batch, 2, 1, "list")
  run node(&mut batch, 3, 2, "row")
  run node(&mut batch, 4, 2, "row")
  run node(&mut batch, 5, 3, "cell")
  run node(&mut batch, 6, 4, "cell")
}

const ROWS: &[u8] = b".host{display:block;width:400px;height:300px}.list{display:block;width:200px;height:60px}.row{display:block;width:100px;height:20px}.cell{width:10px;height:10px}"

effect fn hasAnchors() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run rows(&mut batch)
  let mut source = List<u8>.make()
  run source.appendSlice(ROWS)
  run source.appendSlice(b".row:has(.on){width:120px}.row:has(.on) .cell{height:12px}")
  run sheet(&mut batch, source.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run batch.attribute(5, Attribute.ClassName { value: run String.copy("cell on") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 3) && !dirty(&tree, 4) && !dirty(&tree, 2) && !dirty(&tree, 1), "a class read inside :has() restyles the anchors above it, not the root")
  run tree.frame(frame())
  run Testing.expect(width(&tree, 3) == 120.0 && height(&tree, 5) == 12.0 && width(&tree, 4) == 100.0 && height(&tree, 6) == 10.0, "the anchor and what its match reaches take the new style")
  run batch.attribute(5, Attribute.ClassName { value: run String.copy("cell") })
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(width(&tree, 3) == 100.0 && height(&tree, 5) == 10.0, "removing the class clears the anchor's match")
  run node(&mut batch, 8, 6, "on")
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 4) && !dirty(&tree, 3) && !dirty(&tree, 1), "an insert restyles the anchors that hold it")
  run tree.frame(frame())
  run Testing.expect(width(&tree, 4) == 120.0 && height(&tree, 6) == 12.0 && width(&tree, 3) == 100.0, "an inserted descendant matches its ancestor's :has()")
  run batch.push(Mutation.Remove { id: 8 })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 4) && !dirty(&tree, 3), "a removal restyles the anchors that held it")
  run tree.frame(frame())
  run Testing.expect(width(&tree, 4) == 100.0 && height(&tree, 6) == 10.0, "a removed descendant no longer matches")
}

effect fn hasStatesAndEmptiness() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run rows(&mut batch)
  run node(&mut batch, 7, 1, "list")
  run node(&mut batch, 8, 7, "row")
  let mut source = List<u8>.make()
  run source.appendSlice(ROWS)
  run source.appendSlice(b".list:has(.cell:hover){opacity:.75}.list:has(> :empty){width:150px}")
  run sheet(&mut batch, source.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(width(&tree, 7) == 150.0 && width(&tree, 2) == 200.0, "the second list holds an empty row")
  run tree.dispatch(Input.PointerMove { x: 300.0, y: 200.0, modifiers: 0 })
  run tree.frame(frame())
  run tree.dispatch(Input.PointerMove { x: 5.0, y: 5.0, modifiers: 0 })
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 2) && !dirty(&tree, 1) && !dirty(&tree, 7), "a state read inside :has() restyles its anchor")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 2) == 0.75, "hover inside the anchor matches")
  run tree.dispatch(Input.PointerLeave)
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 2) == 1.0, "leaving clears it")
  run batch.push(Mutation.Remove { id: 6 })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 2) && !dirty(&tree, 1) && !dirty(&tree, 7), "emptiness read inside :has() reaches the anchor above the emptied node")
  run tree.frame(frame())
  run Testing.expect(width(&tree, 2) == 150.0, "the emptied row matches :empty for its list")
  run batch.text(4, 9, "x")
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 2) && !dirty(&tree, 1), "a text child ends emptiness for the anchor too")
  run tree.frame(frame())
  run Testing.expect(width(&tree, 2) == 200.0 && width(&tree, 7) == 150.0, "text makes the row non-empty")
}

test effect fn stylesheetHasRestylesAnchorsNotTheRoot() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hasAnchors() |> Effect.provideMut<Allocator>(&mut allocator)
  run hasStatesAndEmptiness() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn siblingAnchors() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run rows(&mut batch)
  run node(&mut batch, 7, 1, "list")
  let mut source = List<u8>.make()
  run source.appendSlice(ROWS)
  run source.appendSlice(b".row:has(+ .row .on){height:25px}.row:has(~ .mark){opacity:.5}")
  run sheet(&mut batch, source.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run batch.attribute(6, Attribute.ClassName { value: run String.copy("cell on") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 3) && !dirty(&tree, 2) && !dirty(&tree, 1) && !dirty(&tree, 7), "a class read past a sibling combinator in :has() restyles the earlier sibling it anchors")
  run tree.frame(frame())
  run Testing.expect(height(&tree, 3) == 25.0 && height(&tree, 4) == 20.0, "the earlier sibling is the anchor")
  run node(&mut batch, 8, 2, "mark")
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && !dirty(&tree, 1), "an appended sibling restyles the anchors before it")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 3) == 0.5 && opacity(&tree, 4) == 0.5, "both earlier rows see the new sibling")
  run batch.push(Mutation.Remove { id: 8 })
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 3) == 1.0 && opacity(&tree, 4) == 1.0 && height(&tree, 3) == 25.0, "removing it clears their match")
}

test effect fn stylesheetHasWithSiblingArgumentsRestylesEarlierSiblings() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run siblingAnchors() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn focusWithin() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run rows(&mut batch)
  run batch.attribute(5, Attribute.TabIndex { value: 0 })
  run batch.attribute(6, Attribute.TabIndex { value: 0 })
  let mut source = List<u8>.make()
  run source.appendSlice(ROWS)
  run source.appendSlice(b".row:focus-within{opacity:.5}.row:focus-within .cell{width:14px}.list:focus-within{opacity:.75}")
  run sheet(&mut batch, source.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(tree.node(tree.slotOf(4)).styleTwin == tree.slotOf(3), "the second row took the first row's matched style")
  run batch.focus(5)
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 2) && !dirty(&tree, 1), "focus restyles the ancestors asked :focus-within, not the root")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 3) == 0.5 && width(&tree, 5) == 14.0 && opacity(&tree, 4) == 1.0 && width(&tree, 6) == 10.0 && opacity(&tree, 2) == 0.75, "the focused cell's ancestors match")
  run batch.focus(6)
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 3) && dirty(&tree, 4) && !dirty(&tree, 2) && !dirty(&tree, 1), "moving focus restyles the rows that lost and gained it, not their common ancestors")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 3) == 1.0 && width(&tree, 5) == 10.0 && opacity(&tree, 4) == 0.5 && width(&tree, 6) == 14.0 && opacity(&tree, 2) == 0.75, "a row that shared its style still follows focus")
  run batch.push(Mutation.Blur)
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 2) && !dirty(&tree, 1), "blur restyles what held focus")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 4) == 1.0 && width(&tree, 6) == 10.0 && opacity(&tree, 2) == 1.0, "nothing holds focus")
  run batch.focus(6)
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run batch.push(Mutation.Remove { id: 4 })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 2), "removing the subtree that holds focus restyles its former ancestors")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 2) == 1.0, "the list no longer holds focus")
}

test effect fn stylesheetFocusWithinRestylesTheAncestorsThatChange() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run focusWithin() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn attributes() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run rows(&mut batch)
  let mut source = List<u8>.make()
  run source.appendSlice(ROWS)
  run source.appendSlice(b".row[aria-selected=true]{opacity:.25}.row[aria-selected=true] .cell{width:14px}[data-lead]+.row{height:25px}#pick{opacity:.75}.row:disabled .cell{height:12px}.cell:lang(fr){width:13px}")
  run sheet(&mut batch, source.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run batch.attribute(3, Attribute.Selected { value: true })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 3) && !dirty(&tree, 4) && !dirty(&tree, 2), "an attribute a rule reads restyles the node's subtree, not the root")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 3) == 0.25 && width(&tree, 5) == 14.0 && opacity(&tree, 4) == 1.0, "the attribute selector matches")
  run batch.attribute(3, Attribute.Selected { value: false })
  run batch.attribute(4, Attribute.Label { value: run String.copy("second") })
  run batch.attribute(4, Attribute.ValueRange { min: 0.0, max: 10.0, value: 4.0 })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 3) && !dirty(&tree, 4), "attributes no rule reads restyle nothing")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 3) == 1.0 && width(&tree, 5) == 10.0, "the attribute selector stops matching")
  run batch.attribute(3, Attribute.Named { name: run String.copy("data-lead"), value: Option<String>.some(run String.copy("")) })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 2) && !dirty(&tree, 1), "an attribute read across a sibling combinator restyles the parent's subtree")
  run tree.frame(frame())
  run Testing.expect(height(&tree, 4) == 25.0, "the later sibling matches")
  run batch.attribute(4, Attribute.ElementId { value: run String.copy("pick") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 4) && !dirty(&tree, 2), "an id a rule names restyles the node")
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 4) == 0.75, "the id selector matches")
  run batch.attribute(4, Attribute.ElementId { value: run String.copy("other") })
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 4) == 1.0, "the old id stops matching")
  run batch.attribute(3, Attribute.Disabled { value: true })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 3) && !dirty(&tree, 2), "a state an attribute sets restyles the subtree that reads it")
  run tree.frame(frame())
  run Testing.expect(height(&tree, 5) == 12.0 && height(&tree, 6) == 10.0, "the state selector matches")
  run batch.attribute(4, Attribute.Named { name: run String.copy("lang"), value: Option<String>.some(run String.copy("fr")) })
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(width(&tree, 6) == 13.0 && width(&tree, 5) == 10.0, "what the host derives from an attribute, as :lang() from lang, still restyles")
}

test effect fn stylesheetAttributeChangesRestyleWhatReadsThem() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run attributes() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn displayAndVariables() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run rows(&mut batch)
  let mut source = List<u8>.make()
  run source.appendSlice(ROWS)
  run source.appendSlice(b".cell{width:var(--w,10px)}.gone{display:none}.reset{all:unset;display:block}.mark::before{content:'x'}")
  run sheet(&mut batch, source.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("row gone") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 3) && !dirty(&tree, 2), "a class that sets display restyles the node's subtree, not the root")
  run tree.frame(frame())
  run Testing.expect(!tree.node(tree.slotOf(3)).rendered && !tree.node(tree.slotOf(5)).rendered && tree.node(tree.slotOf(4)).rendered, "the subtree leaves the rendering")
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("row reset") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 3), "a class that sets all stays local")
  run tree.frame(frame())
  run Testing.expect(tree.node(tree.slotOf(5)).rendered && width(&tree, 5) == 10.0, "the subtree is rendered again")
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("row mark") })
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 3), "a class that sets content stays local")
  run tree.frame(frame())
  run Testing.expect(width(&tree, 3) == 100.0, "the row's own rules apply again")
  let leaf = scope(&tree, 6)
  let mut i: usize = 0
  while i < 200 {
    let wide = i % 2 == 0
    run batch.customProperty(3, StyleState.Base, "--w", Option<string>.some(if wide { "33px" } else { "34px" }), false)
    run tree.apply(run batch.take())
    run Testing.expect(!tree.stylesDirty && dirty(&tree, 3) && !dirty(&tree, 4) && !dirty(&tree, 2), "an inline custom property restyles the node's subtree, not the root")
    run tree.frame(frame())
    let expected: f32 = if wide { 33.0 } else { 34.0 }
    run Testing.expect(width(&tree, 5) == expected && width(&tree, 6) == 10.0 && scope(&tree, 6) == leaf
      && tree.styleSheets.asSlice()[0].sheets.canRetainScopes(), "repeated inline values keep the retained variable scopes")
    i = i + 1
  }
  run batch.customProperty(3, StyleState.Base, "--w", Option<string<'static>>.None, false)
  run tree.apply(run batch.take())
  run Testing.expect(!tree.stylesDirty && dirty(&tree, 3), "removing the property stays local")
  run tree.frame(frame())
  run Testing.expect(width(&tree, 5) == 10.0, "the fallback applies again")
}

test effect fn stylesheetDisplayAndInlineVariablesRestyleTheSubtree() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run displayAndVariables() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn red(tree: &UiTree<'_>, id: u32) -> f32 {
  return match tree.node(tree.slotOf(id)).computed().paint.background { Fill.Solid { color } => color.r _ => -1.0 }
}

effect fn cousins() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run node(&mut batch, 1, 0, "host")
  run node(&mut batch, 2, 1, "row a")
  run node(&mut batch, 3, 1, "row b")
  run node(&mut batch, 6, 1, "row a")
  run node(&mut batch, 4, 2, "leaf")
  run node(&mut batch, 5, 3, "leaf")
  run node(&mut batch, 7, 6, "leaf")
  run node(&mut batch, 8, 3, "leaf")
  run sheet(&mut batch, b"@layer base{.leaf{min-height:7px}}.host{display:block;width:400px;height:300px}.row{display:block;height:50px}.a{color:rgb(255 0 0);--w:10px;width:100px}.b{color:rgb(0 0 255);--w:20px;width:200px}.leaf{background-color:currentColor;height:var(--w);width:inherit;opacity:.5!important;min-height:9px}.leaf{opacity:.75;min-height:revert-layer;padding:4px;padding-left:6px}")
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(red(&tree, 4) == 1.0 && red(&tree, 5) == 0.0 && red(&tree, 7) == 1.0 && red(&tree, 8) == 0.0, "equal elements under parents of another color keep their own currentColor")
  run Testing.expect(height(&tree, 4) == 10.0 && height(&tree, 5) == 20.0 && height(&tree, 7) == 10.0 && height(&tree, 8) == 20.0, "equal elements in another variable scope substitute their own values")
  run Testing.expect(width(&tree, 4) == 100.0 && width(&tree, 5) == 200.0 && width(&tree, 7) == 100.0, "explicit inheritance reads each parent")
  let leaf = &tree.node(tree.slotOf(7)).computed().*
  run Testing.expect(leaf.paint.opacity == 0.5 && leaf.layout.minHeight.value == 7.0, "importance outranks order, and revert-layer falls back to the layer below")
  run Testing.expect(leaf.layout.padding.left.value == 6.0 && leaf.layout.padding.top.value == 4.0, "a later longhand wins inside an earlier shorthand")
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("row a") })
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(red(&tree, 5) == 1.0 && height(&tree, 5) == 10.0 && width(&tree, 8) == 100.0, "a parent's class change reaches children that share a cascade")
}

test effect fn stylesheetEqualElementsUnderDifferentParentsKeepTheirOwnValues() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cousins() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn alternating(tree: &mut UiTree<'_>, rules: &[u8]) -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run node(&mut batch, 1, 0, "host")
  let mut id: u32 = 2
  while id <= 6 {
    run node(&mut batch, id, 1, if id % 2 == 0 { "row a" } else { "row b" })
    run node(&mut batch, id + 10, id, "leaf")
    id = id + 1
  }
  run node(&mut batch, 24, 4, "leaf")
  run sheet(&mut batch, rules)
  run tree.apply(run batch.take())
  run tree.frame(frame())
}

fn twin(tree: &UiTree<'_>, id: u32) -> u32 { return tree.node(tree.slotOf(id)).styleTwin }

effect fn alternatingRows() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  run alternating(&mut tree, b".host{display:block;width:400px;height:300px}.row{display:block;height:20px}.a{width:100px}.b{width:200px}.leaf{height:5px;width:inherit}")
  run Testing.expect(twin(&tree, 4) == tree.slotOf(2) && twin(&tree, 6) == tree.slotOf(2) && twin(&tree, 5) == tree.slotOf(3), "a row takes the match of an equal row that is not its neighbor")
  run Testing.expect(twin(&tree, 14) == tree.slotOf(12) && twin(&tree, 16) == tree.slotOf(12) && twin(&tree, 15) == tree.slotOf(13) && twin(&tree, 24) == tree.slotOf(14), "its children take those of the other row's children")
  run Testing.expect(width(&tree, 4) == 100.0 && width(&tree, 5) == 200.0 && width(&tree, 14) == 100.0 && width(&tree, 15) == 200.0 && width(&tree, 24) == 100.0 && height(&tree, 16) == 5.0, "shared matches compute against each element's own parent")
  run setClasses(&mut tree, 4, "row b")
  run Testing.expect(width(&tree, 4) == 200.0 && width(&tree, 14) == 200.0 && width(&tree, 24) == 200.0 && width(&tree, 6) == 100.0 && width(&tree, 16) == 100.0, "a class change restyles the row and its children, and no other row")

  let mut ordered = run UiTree.make(&fonts)
  run alternating(&mut ordered, b".host{display:block;width:400px;height:300px}.row{display:block;height:20px}.leaf{height:5px}.b+.a{opacity:.5}.b+.row>.leaf{opacity:.25}.a:first-child{height:30px}")
  run Testing.expect(opacity(&ordered, 2) == 1.0 && opacity(&ordered, 4) == 0.5 && opacity(&ordered, 6) == 0.5 && opacity(&ordered, 3) == 1.0, "a match that tested siblings is not taken by a row elsewhere")
  run Testing.expect(opacity(&ordered, 12) == 1.0 && opacity(&ordered, 14) == 0.25 && opacity(&ordered, 24) == 0.25 && opacity(&ordered, 16) == 0.25 && opacity(&ordered, 13) == 1.0 && opacity(&ordered, 15) == 1.0, "nor is one that tested a parent's siblings, under another parent")
  run Testing.expect(height(&ordered, 2) == 30.0 && height(&ordered, 4) == 20.0 && height(&ordered, 6) == 20.0, "the first child keeps what only it matches")
}

effect fn setClasses(tree: &mut UiTree<'_>, id: u32, classes: string) -> ()
  ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.attribute(id, Attribute.ClassName { value: run String.copy(classes) })
  run tree.apply(run batch.take())
  run tree.frame(frame())
}

test effect fn stylesheetAlternatingRowsShareMatchesAcrossTheList() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run alternatingRows() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn formStates() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run rows(&mut batch)
  run batch.attribute(3, Attribute.Role { value: Role.Radio })
  run batch.attribute(4, Attribute.Role { value: Role.Radio })
  run batch.attribute(5, Attribute.ValueRange { min: 0.0, max: 10.0, value: 4.0 })
  run batch.attribute(6, Attribute.Role { value: Role.ProgressBar })
  let mut source = List<u8>.make()
  run source.appendSlice(ROWS)
  run source.appendSlice(b".row:indeterminate{opacity:.5}.cell:in-range{width:11px}.cell:out-of-range{width:12px}.cell:indeterminate{height:13px}.cell:dir(rtl){height:14px}")
  run sheet(&mut batch, source.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 3) == 0.5 && opacity(&tree, 4) == 0.5, "radios of a group with nothing checked are :indeterminate")
  run Testing.expect(width(&tree, 5) == 11.0 && height(&tree, 6) == 13.0, "a value inside its range is :in-range; a progress bar with no value is :indeterminate")
  run batch.attribute(3, Attribute.Checked { value: true })
  run batch.attribute(5, Attribute.ValueRange { min: 0.0, max: 10.0, value: 40.0 })
  run batch.attribute(6, Attribute.ValueRange { min: 0.0, max: 1.0, value: 0.5 })
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(opacity(&tree, 3) == 1.0 && opacity(&tree, 4) == 1.0, "checking one radio restyles the rest of its group")
  run Testing.expect(width(&tree, 5) == 12.0 && height(&tree, 6) == 10.0, "range states follow the value")
  run batch.attribute(2, Attribute.Named { name: run String.copy("dir"), value: Option<String>.some(run String.copy("rtl")) })
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(height(&tree, 5) == 14.0 && height(&tree, 6) == 14.0, "a dir attribute on an ancestor restyles :dir()")
}

test effect fn formStatesAndDirectionMatchAndRestyle() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run formStates() |> Effect.provideMut<Allocator>(&mut allocator)
}
