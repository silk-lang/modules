//! Times ui-text under css-layout on a chat-like page.
//!
//! ```text
//! ui-text-bench mount  FAMILY CORPUS MESSAGES FONT...   first layout of MESSAGES paragraphs of 40 words
//! ui-text-bench labels FAMILY CORPUS MESSAGES FONT...   the same with 2 words in each
//! ui-text-bench stream FAMILY CORPUS WORDS FONT...      one paragraph growing a word at a time
//! ui-text-bench cold   FAMILY                           load the system's fonts, lay out one line
//! ```
//!
//! `fresh-mount`, `fresh-labels` and `fresh-stream` shape every segment instead of taking
//! glyphs from segments shaped before; the checksum must be the same either way.
//!
//! Messages are made of the corpus's words in a fixed pseudo-random order, so words repeat as
//! they do in real text while no two lines are equal. Both print a checksum of every text
//! fragment's place, size and glyphs: a change that keeps the output keeps the checksum.
import ui_text.lib { TextSystem, TextStyle, FontCollection, Family }
import font_collection.system as systemFonts
import font_collection.system { Options as FontOptions }
import layout.lib as Engine
import layout.lib {
  Style,
  SizeValue,
  Tree,
  LayoutTree,
  OptionalSize,
  InvalidNode,
  TextError,
  FragmentationError,
  FragmentKind
}
import silk.system.host_input { HostInput, HostInputError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.time.mark { Mark }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.io.writer { Writer, WriterError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.text.string { String, InvalidUtf8 }
import silk.text.format { Format, ParseError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.num.f32
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i64

pub struct InputError {}

struct Range {
  start: usize,
  length: usize,
}

impl Copy for Range {}

const WIDTH: f32 = 640.0

fn nanos(at: &Mark) -> i64 {
  return at.*.seconds() * 1000000000 + u32.toI64(at.*.subsecondNanoseconds())
}

fn mix(hash: u64, value: u64) -> u64 {
  return u64.wrappingMultiply(hash ^ value, 1099511628211)
}

effect fn readFile(name: string) -> Bytes
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator | &mut HostInput {
  let cwd = run HostInput.workingDirectory()
  let base = run Path.fromBytes(Bytes.asSlice(&cwd))
  let path = if String.startsWith(name, "/") {
    run Path.fromBytes(String.utf8Bytes(name))
  } else {
    run Path.resolve(&base, name)
  }
  let mut files = run MachineFileSystem.make()
  return run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
}

effect fn words(text: string, out: &mut List<Range>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut start: usize = 0
  let mut at: usize = 0
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 10 || bytes[at] == 32 {
      if at > start {
        run out.append(Range { start: start, length: at - start })
      }
      start = at + 1
    }
    at = at + 1
  }
}

// The next word of the fixed order.
fn pick(seed: &mut u64, count: usize) -> usize {
  seed.* = u64.wrappingAdd(u64.wrappingMultiply(seed.*, 6364136223846793005), 1442695040888963407)
  return u64.toUsize(u64.shiftRight(seed.*, 33)) % count
}

fn checksum<'a>(
  output: &LayoutTree,
  system: &TextSystem<'a>,
  glyphs: &mut usize,
  fragmentCount: &mut usize,
) -> u64 {
  let mut hash: u64 = 14695981039346656037
  let fragments = output.fragments.values.asSlice()
  let mut index: usize = 0
  while index < fragments.length {
    let fragment = &fragments[index]
    if fragment.kind == FragmentKind.Text && fragment.textData != usize.MAX {
      // Every run of the fragment: a fragment holds the runs of its text node.
      let mut runs = output.fragments.textRuns(index)
      while runs.next() {
        let data = runs.current
        fragmentCount.* = fragmentCount.* + 1
        hash = mix(hash, usize.toU64(data.sourceStart))
        hash = mix(hash, usize.toU64(data.sourceEnd))
        hash = mix(hash, u32.toU64(f32.toBits(data.location.x)))
        hash = mix(hash, u32.toU64(f32.toBits(data.location.y)))
        hash = mix(hash, u32.toU64(f32.toBits(data.size.width)))
        hash = mix(hash, u32.toU64(f32.toBits(data.size.height)))
        hash = mix(hash, u8.toU64(data.bidiLevel))
        if data.shapeKey < system.glyphs.length() {
          let run_ = system.glyphRun(data.shapeKey)
          hash = mix(hash, usize.toU64(run_.face))
          let shaped = system.runGlyphs(data.shapeKey)
          glyphs.* = glyphs.* + shaped.length
          let mut g: usize = 0
          while g < shaped.length {
            hash = mix(hash, u32.toU64(shaped[g].glyph))
            hash = mix(hash, u32.toU64(shaped[g].cluster))
            hash = mix(hash, u32.toU64(f32.toBits(shaped[g].x)))
            hash = mix(hash, u32.toU64(f32.toBits(shaped[g].y)))
            hash = mix(hash, u32.toU64(f32.toBits(shaped[g].advance)))
            g = g + 1
          }
        }
      }
    }
    index = index + 1
  }
  return hash
}

effect fn execute(args: &[String]) -> ()
  ! OutOfMemoryError
    | InputError
    | FileError
    | HostInputError
    | InvalidNode
    | TextError
    | FragmentationError
    | WriterError
  ? &mut Allocator | &mut Writer | &mut MonotonicClock | &mut HostInput {
  if args.length == 2 && args[0].view() == "cold" {
    run cold(args[1].view())
    return
  }
  if args.length < 5 {
    fail InputError {}
  }

  // `fresh-MODE` shapes every segment instead of taking glyphs from segments shaped before:
  // the checksum must be the same either way.
  let mut mode = args[0].view()
  let verify = String.startsWith(mode, "verify-")
  if verify {
    mode = String.slice(mode, 7, String.byteLength(mode) - 7)
  }
  let fresh = String.startsWith(mode, "fresh-")
  if fresh {
    mode = String.slice(mode, 6, String.byteLength(mode) - 6)
  }
  let count = match usize.parse(args[3].view()) {
    Result<usize, ParseError>.Success { value } => value
    _ => {
      fail InputError {}
    }
  }
  let corpusBytes = run readFile(args[2].view())
  let corpus = String.fromUtf8(Bytes.asSlice(&corpusBytes))
    |> Result<string, InvalidUtf8>.unwrapOr("")
  let mut vocabulary = List<Range>.make()
  run words(corpus, &mut vocabulary)
  if vocabulary.length() == 0 {
    fail InputError {}
  }
  let mut collection = FontCollection.make()
  let mut font: usize = 4
  while font < args.length {
    drop run collection.add(run readFile(args[font].view()))
    font = font + 1
  }
  let mut system = TextSystem.make(&collection)
  let mut families = List<Family>.make()
  run families.append(run Family.named(String.utf8Bytes(args[1].view())))
  let key = run system.addStyle(TextStyle.make(move families, 15.0))
  system.shaping.reuse = !fresh
  system.verifyCuts = verify
  let mut tree = run Tree.make(Style.make())
  let mut output = LayoutTree.make()
  let mut seed: u64 = 0x9E3779B97F4A7C15
  let mut glyphs: usize = 0
  let mut fragments: usize = 0
  if mode == "mount" || mode == "labels" {
    let perMessage: usize = if mode == "mount" {
      40
    } else {
      2
    }
    let mut message: usize = 0
    while message < count {
      let mut text = String.make()
      let mut word: usize = 0
      while word < perMessage {
        let range = vocabulary.get(pick(&mut seed, vocabulary.length()))
        if word > 0 {
          run text.append(" ")
        }
        run text.append(String.slice(corpus, range.start, range.length))
        word = word + 1
      }
      let mut style = Style.make()
      style.width = SizeValue.px(WIDTH)
      style.fontKey = key
      let root = tree.root()
      let block = run tree.append(root, move style)
      drop run tree.appendText(block, move text)
      message = message + 1
    }
    let start = run MonotonicClock.now()
    run Engine.compute(&tree, &mut output, &mut system, OptionalSize.definite(WIDTH, 100000000.0))
    let end = run MonotonicClock.now()
    output.fragments.resolveLocations()
    let hash = checksum(&output, &system, &mut glyphs, &mut fragments)
    let micros = (nanos(&end) - nanos(&start)) / 1000
    if verify {
      run Format.format("cuts safe {safe} unsafe {flagged} lines checked {checked} wrong {wrong}\n", &.{ safe: system.cutsSafe, flagged: system.cutsUnsafe, checked: system.cutsChecked, wrong: system.cutsWrong })
    }
    run Format.format(
      "{mode} messages {count} fragments {fragments} glyphs {glyphs} ms {whole}.{part} shapeCalls {shapes} shaperCalls {shaper} shaperBytes {bytes} taken {taken} runs {runs} checksum {hash}\n",
      &.{
        mode: mode,
        count: count,
        fragments: fragments,
        glyphs: glyphs,
        whole: micros / 1000,
        part: (micros % 1000) / 100,
        shapes: system.shapeCalls,
        shaper: system.fonts.shaperCalls,
        bytes: system.fonts.shaperBytes,
        taken: system.shaping.taken,
        runs: system.glyphs.length(),
        hash: hash,
      },
    )
    return
  }
  if mode != "stream" {
    fail InputError {}
  }
  let mut style = Style.make()
  style.width = SizeValue.px(WIDTH)
  style.fontKey = key
  let root = tree.root()
  let block = run tree.append(root, move style)
  let node = run tree.appendText(block, String.make())
  let mut text = String.make()
  let mut hash: u64 = 0

  // Appends are timed in windows of 32 words; the first and the last window are reported.
  let mut window: i64 = 0
  let mut firstWindow: i64 = 0
  let mut firstCalls: usize = 0
  let mut windowCalls: usize = 0
  let mut firstShaped: usize = 0
  let mut windowShaped: usize = 0

  // The checksums of the layout after every window, folded together.
  let mut rolling: u64 = 0
  let mut firstBytes: usize = 0
  let mut word: usize = 0
  while word < count {
    let range = vocabulary.get(pick(&mut seed, vocabulary.length()))
    if word > 0 {
      run text.append(" ")
    }
    run text.append(String.slice(corpus, range.start, range.length))
    if word % 32 == 0 {
      window = 0
      windowCalls = system.fonts.shaperCalls
      windowShaped = system.fonts.shaperBytes
    }
    let start = run MonotonicClock.now()
    run tree.setText(node, run String.copy(text.view()))
    run Engine.compute(&tree, &mut output, &mut system, OptionalSize.definite(WIDTH, 100000000.0))
    let end = run MonotonicClock.now()
    window = window + nanos(&end) - nanos(&start)
    if word == 31 {
      firstWindow = window
      firstCalls = system.fonts.shaperCalls - windowCalls
      firstShaped = system.fonts.shaperBytes - windowShaped
      firstBytes = String.byteLength(text.view())
    }
    if word % 32 == 31 {
      output.fragments.resolveLocations()
      rolling = u64.wrappingMultiply(
        rolling ^ checksum(&output, &system, &mut glyphs, &mut fragments),
        1099511628211,
      )
    }
    word = word + 1
  }
  output.fragments.resolveLocations()
  glyphs = 0
  fragments = 0
  hash = checksum(&output, &system, &mut glyphs, &mut fragments)
  run Format.format(
    "stream words {count} at {firstBytes} bytes: us/append {first} shaperCalls/32 {firstCalls} shaperBytes/append {firstShaped}; at {bytes} bytes: us/append {last} shaperCalls/32 {lastCalls} shaperBytes/append {lastShaped}; continued {continued} runs {runs} checksum {hash} rolling {rolling}\n",
    &.{
      count: count,
      firstBytes: firstBytes,
      first: firstWindow / 32000,
      firstCalls: firstCalls,
      firstShaped: firstShaped / 32,
      bytes: String.byteLength(text.view()),
      last: window / 32000,
      lastCalls: system.fonts.shaperCalls - windowCalls,
      lastShaped: (system.fonts.shaperBytes - windowShaped) / 32,
      continued: system.shaping.continued,
      runs: system.glyphs.length(),
      hash: hash,
      rolling: rolling,
    },
  )
}

// Start-up: finding the system's fonts, then the first line of text.
effect fn cold(family: string) -> ()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | WriterError
  ? &mut Allocator | &mut Writer | &mut MonotonicClock | &mut HostInput {
  let start = run MonotonicClock.now()
  let mut collection = FontCollection.make()
  let report = run systemFonts.load(&mut collection, FontOptions.defaults())
  let loaded = run MonotonicClock.now()
  let mut system = TextSystem.make(&collection)
  let mut families = List<Family>.make()
  run families.append(run Family.named(String.utf8Bytes(family)))
  let key = run system.addStyle(TextStyle.make(move families, 15.0))
  let mut style = Style.make()
  style.width = SizeValue.px(WIDTH)
  style.fontKey = key
  let mut tree = run Tree.make(move style)
  let root = tree.root()
  drop run tree.appendText(root, run String.copy("Hello, world"))
  let mut output = LayoutTree.make()
  run Engine.compute(&tree, &mut output, &mut system, OptionalSize.definite(WIDTH, 100000000.0))
  let shaped = run MonotonicClock.now()
  let mut glyphs: usize = 0
  let mut fragments: usize = 0
  output.fragments.resolveLocations()
  drop checksum(&output, &system, &mut glyphs, &mut fragments)
  let find = (nanos(&loaded) - nanos(&start)) / 1000
  let first = (nanos(&shaped) - nanos(&loaded)) / 1000
  run Format.format(
    "cold files {files} mapped {mapped} read {read} find-ms {findWhole}.{findPart} first-line-ms {firstWhole}.{firstPart} glyphs {glyphs}\n",
    &.{
      files: report.files,
      mapped: report.mapped,
      read: report.bytes,
      findWhole: find / 1000,
      findPart: (find % 1000) / 100,
      firstWhole: first / 1000,
      firstPart: (first % 1000) / 100,
      glyphs: glyphs,
    },
  )
}

effect fn application() -> i32
  ! OutOfMemoryError
    | InputError
    | FileError
    | HostInputError
    | InvalidNode
    | TextError
    | FragmentationError
    | WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut stdout = StdoutWriter.make()
  let mut clock = OsMonotonicClock.make()
  let mut args = List<String>.make()
  let count = run HostInput.argumentCount()
  let mut index: usize = 1
  while index < count {
    if let Option<Bytes>.Some { value: raw } = run HostInput.argument(index)
      |> Effect.provideMut<Allocator>(&mut allocator) {
      if let Result<String, InvalidUtf8>.Success { value } = move String.fromBytes(move raw) {
        run args.append(move value) |> Effect.provideMut<Allocator>(&mut allocator)
      }
    }
    index = index + 1
  }
  run execute(args.asSlice())
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<Writer>(&mut stdout)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  return 0
}

effect fn failed(
  error: OutOfMemoryError
    | InputError
    | FileError
    | HostInputError
    | InvalidNode
    | TextError
    | FragmentationError
    | WriterError,
) -> i32 {
  drop error
  let mut stderr = StderrWriter.make()
  let written = run Writer.writeString(
    "usage: ui-text-bench mount|labels|stream FAMILY CORPUS COUNT FONT...\n",
  )
    |> Effect.provideMut<Writer>(&mut stderr)
    |> Effect.result
  drop written
  return 1
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run application() |> Effect.catchAll(failed)
}
