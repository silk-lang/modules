//! Provisional container passes share one before-change style and motion state.
import engine { UiTree }
import node { NONE, Event }
import style { Computed }
import container_watch
import motion { Running }
import animation { Playing }
import animation
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.frozen { Frozen }
import silk.num.u32
import silk.num.usize

pub struct Change {
  pub slot: u32,
  pub id: u32,
  before: Frozen<Computed>,
  rendered: bool,
  transitions: List<Running>,
  animations: List<Playing>,
  events: List<Event>,
  eventAt: usize,
}

fn index(tree: &UiTree<'_>, slot: u32) -> usize {
  if !tree.changingStyles { return usize.MAX }
  let node = tree.node(slot)
  let at = u32.toUsize(node.styleChange)
  if at < tree.styleChanges.length() {
    let change = &tree.styleChanges.asSlice()[at]
    if change.slot == slot && change.id == node.id { return at }
  }
  return usize.MAX
}

pub fn tracks(tree: &UiTree<'_>, slot: u32) -> bool {
  return tree.changingStyles && (index(tree, slot) != usize.MAX || container_watch.queries(tree, slot))
}

pub fn rendered(tree: &UiTree<'_>, slot: u32) -> bool {
  let at = index(tree, slot)
  return if at == usize.MAX { tree.node(slot).rendered } else { tree.styleChanges.asSlice()[at].rendered }
}

pub fn before(tree: &UiTree<'_>, slot: u32) -> Computed {
  let at = index(tree, slot)
  return if at == usize.MAX { tree.node(slot).computed().* } else { tree.styleChanges.asSlice()[at].before.get().* }
}

pub fn begin(tree: &mut UiTree<'_>) {
  tree.styleChanges.clear()
  tree.changingStyles = true
}

pub effect fn prepare(tree: &mut UiTree<'_>, slot: u32, units: bool) ! OutOfMemoryError ? &mut Allocator {
  if !tree.changingStyles { return () }
  let at = index(&tree, slot)
  let parent = tree.node(slot).parent
  if at == usize.MAX {
    if !units && !container_watch.queries(&tree, slot) && (parent == NONE || !tracks(&tree, parent)) { return () }
    let node = tree.node(slot)
    let savedBefore = if node.moving.isNone() { node.styled.clone() } else { run Frozen<Computed>.make(node.computed().*) }
    let mut change = Change { slot: slot, id: node.id, before: move savedBefore, rendered: node.rendered,
      transitions: List<Running>.make(), animations: List<Playing>.make(), events: List<Event>.make(), eventAt: tree.events.length() }
    let mut i: usize = 0
    if node.activeTransitions != 0 {
      while i < tree.transitions.length() {
        let item = tree.transitions.get(i)
        if item.slot == slot && item.id == node.id { run change.transitions.append(item) }
        i = i + 1
      }
    }
    let playing = animation.rangeOf(tree.animations.asSlice(), slot)
    i = playing[0]
    while i < playing[1] {
      let item = tree.animations.get(i)
      if item.id == node.id { run change.animations.append(item) }
      i = i + 1
    }
    let added = tree.styleChanges.length()
    run tree.styleChanges.append(move change)
    let saved = tree.nodeMut(slot)
    saved.styleChange = usize.toU32(added)
    return ()
  }
  let changes = tree.styleChanges.asMutSlice()
  let change = &mut changes[at]
  change.events.clear()
  let changeId = change.id
  let savedCount = change.transitions.length()
  if tree.node(slot).activeTransitions != 0 || savedCount != 0 {
    let mut i: usize = 0
    let mut kept: usize = 0
    while i < tree.transitions.length() {
      let item = tree.transitions.get(i)
      if item.slot != slot || item.id != changeId { tree.transitions.set(kept, item) kept = kept + 1 }
      i = i + 1
    }
    tree.transitions.truncate(kept)
    let changesAgain = tree.styleChanges.asMutSlice()
    run tree.transitions.appendSlice(changesAgain[at].transitions.asSlice())
    let restoredNode = tree.nodeMut(slot)
    restoredNode.activeTransitions = usize.toU8(savedCount)
  }
  let changesForAnim = tree.styleChanges.asMutSlice()
  let restored = Intrinsic.replace(changesForAnim[at].animations, List<Playing>.make())
  run animation.replace(&mut tree, slot, restored.asSlice())
  let again = tree.styleChanges.asMutSlice()
  again[at].animations = move restored
}

pub effect fn event(tree: &mut UiTree<'_>, slot: u32, value: Event) ! OutOfMemoryError ? &mut Allocator {
  let at = index(&tree, slot)
  if at == usize.MAX { run tree.queueEvent(move value) return () }
  let changes = tree.styleChanges.asMutSlice()
  run changes[at].events.append(move value)
}

pub effect fn finish(tree: &mut UiTree<'_>) ! OutOfMemoryError ? &mut Allocator {
  tree.changingStyles = false
  let changes = tree.styleChanges.asMutSlice()
  let mut i: usize = 0
  let mut inserted: usize = 0
  while i < changes.length {
    let mut events = Intrinsic.replace(changes[i].events, List<Event>.make())
    while events.length() != 0 {
      run tree.events.insert(changes[i].eventAt + inserted, events.remove(0))
      inserted = inserted + 1
    }
    i = i + 1
  }
  if tree.styleChanges.capacity() > 64 {
    tree.styleChanges.clearAndFree()
  } else {
    tree.styleChanges.clear()
  }
}
