//! The component gallery in a native window.
//!
//!   loom-components-demo [--check | --showcase]
//!
//! Every loom-components component in one window: buttons with a tooltip, a checkbox, a switch, a
//! slider, a text field and area, a dialog, a menu, a select, a popover, tabs, a list, a select
//! list and a virtual list of ten thousand rows. Tab and Shift+Tab move focus, and every
//! component works from the keyboard.
//!
//! In a debug build with `SILK_UI_INSPECT` set it serves the inspector protocol, so the devtools
//! window (modules/devtools) and ui-inspect-cli can inspect and drive it.
//!
//! `--showcase` shows the components one case at a time instead, in the showcase
//! (`loom_components.showcase`): pick an exhibit on the left, a width and the theme at the top.
//!
//! `--check` ignores real input: it clicks Save and presses Tab, then compares the window's
//! surface with the CPU reference of the same frame. Exit code 0 within tolerance, 1 outside,
//! 2 on an error.
import ui_gallery.lib { Gallery, Message, SANS, ComponentExhibits }
import loom_components.lib { Showcase, Shown }
import loom.app { NoCommand }
import loom.runtime { Runtime }
import loom_window.lib { launch, Launched, RunOptions, runWindowWith, startInspector, StartedGpu }
import ui_inspect_server.lib { InspectorOptions }
import ui_fixtures.fixtures as fixtures
import ui_tree.legacy { TreeError, Batch }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// Whether `flag` is one of the arguments.
effect fn flagged(flag: &[u8]) -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run HostInput.argument(i) {
      if same(Bytes.asSlice(&value), flag) {
        return true
      }
    }
    i = i + 1
  }
  return false
}

effect fn checkMode() -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  return run flagged(b"--check")
}

effect fn showcaseMode() -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  return run flagged(b"--showcase")
}

effect fn showcase(platform: Option<Launched>) -> i32
  ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut batch = Batch.make()
  let shown = run Showcase<ComponentExhibits>.make(ComponentExhibits {}, SANS)
  let mut app = Runtime<Showcase<ComponentExhibits>, Shown, NoCommand>.make(move shown)
  let options = RunOptions {
    title: "Showcase",
    width: 1040.0,
    height: 680.0,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: move platform,
    gpu: Option<StartedGpu>.None,
  }
  let inspector = run startInspector(InspectorOptions.make())
  return run runWindowWith(&mut app, &collection, run batch.take(), move options, move inspector)
}

effect fn program(check: bool, platform: Option<Launched>) -> i32
  ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut batch = Batch.make()
  let mut app = Runtime<Gallery, Message, NoCommand>.make(Gallery.make())
  let options = RunOptions {
    title: "Components",
    width: 880.0,
    height: 680.0,
    check: check,
    checkClick: "Save",
    checkExpect: "Saved",
    lowestLatency: false,
    platform: move platform,
    gpu: Option<StartedGpu>.None,
  }

  // Debug builds with SILK_UI_INSPECT set serve the inspector (modules/inspect/server), so
  // ui-inspect-cli, ui-inspect-mcp and the devtools window can look at the gallery.
  let inspector = run startInspector(InspectorOptions.make())
  return run runWindowWith(&mut app, &collection, run batch.take(), move options, move inspector)
}

effect fn windowFailed(error: WindowError) -> i32 {
  drop error
  StderrWriter.print("loom-components-demo: could not open a window (no display server?)\n", &())
  return 2
}

effect fn gpuFailed(error: GpuError) -> i32 {
  StderrWriter.print("loom-components-demo: GPU error {}\n", &.(error.code))
  return 2
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("loom-components-demo: failed (tree, atlas, geometry or allocation)\n", &())
  return 2
}

/// The app, on the UI thread `launch` made.
fn runApp(check: bool, shows: bool, platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  if shows {
    return run Effect.catchAll(
      Effect.catch<GpuError>(
        Effect.catch<WindowError>(showcase(move platform), windowFailed),
        gpuFailed,
      ),
      failed,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
  return run Effect.catchAll(
    Effect.catch<GpuError>(
      Effect.catch<WindowError>(program(check, move platform), windowFailed),
      gpuFailed,
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn noCheck<E>(error: E) -> bool {
  drop error
  return false
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let check = run Effect.catchAll(checkMode(), noCheck)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let shows = run Effect.catchAll(showcaseMode(), noCheck)
    |> Effect.provideMut<Allocator>(&mut allocator)

  // The main thread keeps the OS event loop; the app runs on its own thread.
  return run Effect.catchAll(
    launch(
      |platform: Option<Launched>| -> i32 {
        return runApp(check, shows, move platform)
      },
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
