// Time zone names follow the pinned temporal/timezone.c (see LICENSE.quickjs); the rules of
// each zone come from `silk.time` (temporal_zone).
import silk.core.option { Option }
import silk.time.zone { Zone }
import temporal_timezone_data as data
import temporal_zone as rules
import temporal_zones { ZoneCache }

pub const NO_TRANSITION: i64 = -9223372036854775807 - 1

fn same(a: &[u8], b: &[u8], fold: bool) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length {
    let mut x = a[i]
    let mut y = b[i]
    if fold {
      if x >= 65 && x <= 90 { x = x + 32 }
      if y >= 65 && y <= 90 { y = y + 32 }
    }
    if x != y { return false }
    i = i + 1
  }
  return true
}

pub fn ti_tz_find_id(name: &[u8]) -> i32 {
  let mut i: i32 = 0
  while i < data.ti_tz_alias_count {
    if same(name, data.tzAliasName(i), true) { return data.tzAliasCanonicalId(i) }
    i = i + 1
  }
  i = 0
  while i < data.ti_tz_zone_count {
    if same(name, data.tzZoneName(i), true) { return i }
    i = i + 1
  }
  return -1
}

pub fn ti_canonicalize_timezone_alias<'a>(tz: &'a [u8]) -> &'a [u8] {
  let mut i: i32 = 0
  while i < 78 {
    let canonical = overrideCanonical(i)
    if same(tz, overrideAlias(i), false) || same(tz, canonical, false) { return canonical }
    i = i + 1
  }
  let id = ti_tz_find_id(tz)
  if id >= 0 { return data.tzZoneName(id) }
  return tz
}
pub fn ti_timezones_are_equal(a: &[u8], b: &[u8]) -> bool {
  if same(a, b, true) { return true }
  return same(ti_canonicalize_timezone_alias(a), ti_canonicalize_timezone_alias(b), false)
}
/// The `tzName` index of `name`, ignoring ASCII case, or -1.
pub fn ti_tz_name_index(name: &[u8]) -> i32 {
  let mut i: i32 = 0
  while i < data.ti_tz_name_count {
    if same(name, data.tzName(i), true) { return i }
    i = i + 1
  }
  return -1
}
pub fn ti_tz_can_be_named(name: &[u8]) -> bool {
  let mut i: i32 = 0
  while i < data.ti_tz_name_count {
    if same(name, data.tzName(i), true) { return true }
    i = i + 1
  }
  i = 0
  while i < 78 {
    if same(name, overrideAlias(i), true) || same(name, overrideCanonical(i), true) { return true }
    i = i + 1
  }
  return false
}
fn valid(id: i32) -> bool { return id >= 0 && id < data.ti_tz_zone_count }

// The rules of zone `id` come from `silk.time`, through the zones the realm has loaded. A zone
// that cannot be loaded answers as an id outside the table does: offset zero, no transitions.

/// The UTC offset of zone `id` in seconds at UTC second `sec`.
pub fn ti_tz_offset_at_sec(zones: &mut ZoneCache, id: i32, sec: i64) -> i32 {
  if !valid(id) { return 0 }
  if let Option<&Zone>.Some { value } = zones.zone(id, data.tzZoneName(id)) { return rules.offsetAtSec(value, sec) }
  return 0
}
/// Whether zone `id` observes daylight saving time at UTC second `sec`.
pub fn ti_tz_is_daylight_at_sec(zones: &mut ZoneCache, id: i32, sec: i64) -> bool {
  if !valid(id) { return false }
  if let Option<&Zone>.Some { value } = zones.zone(id, data.tzZoneName(id)) { return rules.isDaylightAtSec(value, sec) }
  return false
}
/// Whether zone `id` leaves daylight saving time within `range` seconds before UTC second `sec`,
/// or enters it within `range` seconds after, as ICU checks before it uses a standard name.
pub fn ti_tz_daylight_near(zones: &mut ZoneCache, id: i32, sec: i64, range: i64) -> bool {
  if !valid(id) { return false }
  if let Option<&Zone>.Some { value } = zones.zone(id, data.tzZoneName(id)) { return rules.daylightNear(value, sec, range) }
  return false
}
pub fn ti_tz_prev_offset_at_sec(zones: &mut ZoneCache, id: i32, sec: i64) -> i32 {
  if !valid(id) { return 0 }
  if let Option<&Zone>.Some { value } = zones.zone(id, data.tzZoneName(id)) { return rules.prevOffsetAtSec(value, sec) }
  return 0
}
pub fn ti_tz_next_transition_sec(zones: &mut ZoneCache, id: i32, sec: i64) -> i64 {
  if !valid(id) { return NO_TRANSITION }
  if let Option<&Zone>.Some { value } = zones.zone(id, data.tzZoneName(id)) { return rules.nextTransitionSec(value, sec) }
  return NO_TRANSITION
}
// The subsecond forms accept negative nanoseconds, as the source comparisons do.
pub fn ti_tz_next_transition_at(zones: &mut ZoneCache, id: i32, sec: i64, nsec: i32) -> i64 {
  if !valid(id) { return NO_TRANSITION }
  if let Option<&Zone>.Some { value } = zones.zone(id, data.tzZoneName(id)) { return rules.nextTransitionAt(value, sec, nsec) }
  return NO_TRANSITION
}
pub fn ti_tz_prev_transition_at(zones: &mut ZoneCache, id: i32, sec: i64, nsec: i32) -> i64 {
  if !valid(id) { return NO_TRANSITION }
  if let Option<&Zone>.Some { value } = zones.zone(id, data.tzZoneName(id)) { return rules.prevTransitionAt(value, sec, nsec) }
  return NO_TRANSITION
}
// `dis` is 0 earlier, 1 later, 2 compatible, 3 reject. On rejection the borrowed output slots
// remain untouched.
pub fn ti_tz_local_to_utc(zones: &mut ZoneCache, id: i32, local: i64, dis: i32, outUtc: &mut i64, outOffset: &mut i32) -> i32 {
  if valid(id) {
    if let Option<&Zone>.Some { value } = zones.zone(id, data.tzZoneName(id)) { return rules.localToUtc(value, local, dis, &mut outUtc.*, &mut outOffset.*) }
  }
  outUtc.* = local
  outOffset.* = 0
  return 0
}
pub fn ti_get_start_of_day_sec(zones: &mut ZoneCache, id: i32, local: i64) -> i64 {
  if valid(id) {
    if let Option<&Zone>.Some { value } = zones.zone(id, data.tzZoneName(id)) { return rules.startOfDaySec(value, local) }
  }
  return local
}

