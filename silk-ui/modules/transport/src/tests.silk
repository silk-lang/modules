test effect fn boundedChannelFifoBackpressureAndMultiProducer() -> ()
  ! AssertionError<'static> | OutOfMemoryError | SpawnError {
  let mut heap = Allocator.systemAllocatorProvider()
  let waiter = run Waiter.make()
  let pair = run BoundedChannel.make<u64>(4, waiter.handle())
  let BoundedPair<u64> { sender, receiver: rx } = move pair
  let mut receiver = move rx

  // Backpressure: capacity 4 rejects 5th item with Full returning the value.
  let mut k: u64 = 1
  while k <= 4 {
    let ok = match move sender.trySend(k) {
      Result<(), TrySendError<u64>>.Success { .. } => true
      Result<(), TrySendError<u64>>.Failure { .. } => false
    }
    run Testing.expect(ok, "bounded channel accepts items up to capacity")
    k = k + 1
  }
  let fullReturned = match move sender.trySend(99) {
    Result<(), TrySendError<u64>>.Failure { error } => match move error {
      TrySendError<u64>.Full { value } => value == 99
      TrySendError<u64>.Closed { .. } => false
    }
    Result<(), TrySendError<u64>>.Success { .. } => false
  }
  run Testing.expect(fullReturned, "trySend returns Full with the unsent value")

  // FIFO order.
  let mut drained = List<u64>.make()
  let got = run receiver.drain(&mut drained, 0) |> Effect.provideMut<Allocator>(&mut heap)
  run Testing.expect(
    got == 4
      && drained.get(0) == 1
      && drained.get(1) == 2
      && drained.get(2) == 3
      && drained.get(3) == 4,
    "bounded channel preserves FIFO order",
  )

  // Multi-producer blocking send across 4 threads (500 items each = 2000 items).
  let mut handles = List<JoinHandle<()>>.make()
  let mut p: u64 = 0
  while p < 4 {
    let s = sender.clone()
    let base = p * 500
    let h = run NativeThread.spawn(
      || -> () {
        let senderThread = move s
        let baseOffset = move base
        let mut i: u64 = 0
        while i < 500 {
          drop senderThread.send(baseOffset + i + 1)
          i = i + 1
        }
      },
    )
      |> Effect.provideMut<Allocator>(&mut heap)
    run handles.append(move h) |> Effect.provideMut<Allocator>(&mut heap)
    p = p + 1
  }
  drop sender

  let mut sum: u64 = 0
  let mut count: usize = 0
  while true {
    match move receiver.recv() {
      Option<u64>.Some { value } => {
        sum = sum + value
        count = count + 1
      }
      Option<u64>.None => {
        break
      }
    }
  }
  while handles.length() != 0 {
    let last = handles.length() - 1
    handles.remove(last).join()
  }
  // Sum 1..=2000 = 2000 * 2001 / 2 = 2001000
  run Testing.expect(count == 2000 && sum == 2001000, "bounded MPSC delivers every item without loss")
}

struct AtomicFlag {
  storage: Box<u32>,
  ptr: *mut u32,
}

impl Transferable for AtomicFlag {}
impl Concurrent for AtomicFlag {}

test effect fn unboundedChannelLockFreeMpscStress() -> ()
  ! AssertionError<'static> | OutOfMemoryError | SpawnError {
  let mut heap = Allocator.systemAllocatorProvider()
  let waiter = run Waiter.make()
  let pair = run UnboundedChannel.make<u64>(waiter.handle())
  let UnboundedPair<u64> { sender, receiver: rx } = move pair
  let mut receiver = move rx

  let mut handles = List<JoinHandle<()>>.make()
  let mut p: u64 = 0
  while p < 4 {
    let s = sender.clone()
    let base = p * 1000
    let h = run NativeThread.spawn(
      || -> () {
        let senderThread = move s
        let baseOffset = move base
        let mut i: u64 = 0
        while i < 1000 {
          drop run Effect.result(senderThread.send(baseOffset + i + 1))
          i = i + 1
        }
      },
    )
      |> Effect.provideMut<Allocator>(&mut heap)
    run handles.append(move h) |> Effect.provideMut<Allocator>(&mut heap)
    p = p + 1
  }
  drop sender

  let mut count: usize = 0
  let mut sum: u64 = 0
  while true {
    match move receiver.tryRecv() {
      Result<u64, TryRecvError>.Success { value } => {
        sum = sum + value
        count = count + 1
      }
      Result<u64, TryRecvError>.Failure { error } => match error {
        TryRecvError.Empty => waiter.wait()
        TryRecvError.Closed => {
          break
        }
      }
    }
  }
  while handles.length() != 0 {
    let last = handles.length() - 1
    handles.remove(last).join()
  }
  // Sum 1..=4000 = 4000 * 4001 / 2 = 8002000
  run Testing.expect(count == 4000 && sum == 8002000, "unbounded MPSC delivers all 4000 items")
}

fn finishInHelper(token: CancellationToken) -> () {
  let _guard = CancelFinishGuard.make(move token)
}

test effect fn cancellationTokenThreeStates() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let token = run CancellationToken.make()
  run Testing.expect(token.state() == CancellationState.Active && !token.check(), "starts Active")
  token.request()
  run Testing.expect(
    token.state() == CancellationState.Requested && token.isRequested() && !token.isObserved(),
    "transitions to Requested before check",
  )
  run Testing.expect(token.check(), "checkpoint observes Requested")
  run Testing.expect(
    token.state() == CancellationState.Observed && token.isObserved() && !token.isFinished(),
    "transitions to Observed at checkpoint",
  )
  token.finish()
  run Testing.expect(
    token.state() == CancellationState.Finished && token.isFinished(),
    "transitions to Finished",
  )

  let normal = run CancellationToken.make()
  finishInHelper(normal.clone())
  run Testing.expect(
    normal.isFinished() && !normal.isRequested() && !normal.isObserved(),
    "CancelFinishGuard sets Finished without marking Requested/Observed",
  )
}

test effect fn rpcMultiCallerConcurrentTaggedRepliesAndShutdown() -> ()
  ! AssertionError<'static> | OutOfMemoryError | SpawnError {
  let mut heap = Allocator.systemAllocatorProvider()
  let serverWaiter = run Waiter.make()
  let pair = run RpcChannel.make<u64, u64>(serverWaiter.handle())
  let RpcPair<u64, u64> { client, server: srvInit } = move pair
  let mut server = move srvInit

  // Server thread replies `request * 10 + 7`.
  let serverThread = run NativeThread.spawn(
    || -> () {
      let mut srv = move server
      let w = move serverWaiter
      let mut served: usize = 0
      while served < 400 {
        match move srv.tryRecv() {
          Result<RpcEnvelope<u64, u64>, TryRecvError>.Success { value: env } => {
            let RpcEnvelope<u64, u64> { id: _, request, responder } = move env
            if let Option<RpcResponder<u64>>.Some { value: r } = move responder {
              r.reply(request * 10 + 7)
            }
            served = served + 1
          }
          Result<RpcEnvelope<u64, u64>, TryRecvError>.Failure { error } => match error {
            TryRecvError.Empty => w.wait()
            TryRecvError.Closed => {
              break
            }
          }
        }
      }
      // Leave one pending request unanswered and drop server to test Closed error wakeup.
      while true {
        match move srv.tryRecv() {
          Result<RpcEnvelope<u64, u64>, TryRecvError>.Success { value: env } => {
            drop env
            break
          }
          Result<RpcEnvelope<u64, u64>, TryRecvError>.Failure { error } => match error {
            TryRecvError.Empty => w.wait()
            TryRecvError.Closed => {
              break
            }
          }
        }
      }
    },
  )
    |> Effect.provideMut<Allocator>(&mut heap)

  let mut callers = List<JoinHandle<bool>>.make()
  let mut t: u64 = 0
  while t < 4 {
    let c = client.clone()
    let tag = (t + 1) * 1000
    let h = run NativeThread.spawn(
      || -> bool {
        let clientThread = move c
        let baseTag = move tag
        let mut i: u64 = 0
        while i < 100 {
          let req = baseTag + i
          let rep = match run clientThread.call(req) {
            Result<u64, RpcError>.Success { value } => value
            Result<u64, RpcError>.Failure { .. } => {
              return false
            }
          }
          if rep != req * 10 + 7 {
            return false
          }
          i = i + 1
        }
        return true
      },
    )
      |> Effect.provideMut<Allocator>(&mut heap)
    run callers.append(move h) |> Effect.provideMut<Allocator>(&mut heap)
    t = t + 1
  }

  let mut allOk = true
  while callers.length() != 0 {
    let last = callers.length() - 1
    if !callers.remove(last).join() {
      allOk = false
    }
  }
  run Testing.expect(allOk, "every concurrent caller receives its own exact tagged reply")

  // Verify dropped responder / closed server unblocks caller with RpcError.Closed.
  let closedWait = match run client.call(42) {
    Result<u64, RpcError>.Failure { error } => error == RpcError.Closed
    Result<u64, RpcError>.Success { .. } => false
  }
  run Testing.expect(closedWait, "dropping responder unblocks caller with RpcError.Closed")
  serverThread.join()
}

struct SharedSum {
  storage: Box<u64>,
  total: *mut u64,
}

impl Transferable for SharedSum {}
impl Concurrent for SharedSum {}

struct ParallelBuffer {
  items: Arc<Mutex<List<u64>>>,
}

impl Transferable for ParallelBuffer {}
impl Concurrent for ParallelBuffer {}

fn addIndex(buf: &ParallelBuffer, idx: usize) -> () {
  let mut guard = buf.items.get().lock()
  let slice = guard.getMut().asMutSlice()
  slice[idx] = usize.toU64(idx * 3 + 1)
}

test effect fn workPoolQosIsolationFairnessClaimAndParallel() -> ()
  ! AssertionError<'static> | OutOfMemoryError | SpawnError {
  let mut heap = Allocator.systemAllocatorProvider()
  let mut pools = run Pools.make()

  // 1. Saturate AppPool with tasks waiting on a gate, while EnginePool runs unimpeded.
  let mut appGate = run Box<u32>.make(0) |> Effect.provideMut<Allocator>(&mut heap)
  let gatePtr = Pointer.fromMutRef(&mut appGate.getMut()[0])
  let appGateShared = run Arc<AtomicFlag>.make(
    AtomicFlag { storage: move appGate, ptr: gatePtr },
  )
    |> Effect.provideMut<Allocator>(&mut heap)
  let mut gateCount: usize = 0
  while gateCount < pools.app.workerCount() {
    let g = appGateShared.clone()
    let cancel = run CancellationToken.make()
    drop run pools.app.submit(
      1,
      move cancel,
      WakeHandle.noop(),
      |_: &CancellationToken| -> () {
        let gateOwned = move g
        while unsafe Atomic.load<u32>(gateOwned.get().ptr, MemoryOrder.Acquire) == 0 {
          NativeThread.yieldNow()
        }
      },
    )
    gateCount = gateCount + 1
  }

  // Enqueue a claimable task behind the saturated AppPool and claim it inline on this thread.
  let mut ranBox = run Box<u32>.make(0) |> Effect.provideMut<Allocator>(&mut heap)
  let ranPtr = Pointer.fromMutRef(&mut ranBox.getMut()[0])
  let ranFlag = run Arc<AtomicFlag>.make(AtomicFlag { storage: move ranBox, ptr: ranPtr })
    |> Effect.provideMut<Allocator>(&mut heap)
  let ranRef = ranFlag.clone()
  let claimCancel = run CancellationToken.make()
  let claim = run pools.app.submit(
    1,
    move claimCancel,
    WakeHandle.noop(),
    |_: &CancellationToken| -> () {
      let flagOwned = move ranRef
      unsafe Atomic.store<u32>(flagOwned.get().ptr, 1, MemoryOrder.Release)
    },
  )
  let claimed = claim.tryClaimAndRun()
  run Testing.expect(
    claimed
      && claim.isDone()
      && unsafe Atomic.load<u32>(ranFlag.get().ptr, MemoryOrder.Acquire) == 1,
    "tryClaimAndRun executes queued task inline without blocking on saturated AppPool",
  )

  // Meanwhile, EnginePool completes immediately despite AppPool saturation.
  let engineDoneWaiter = run Waiter.make()
  let engineCancel = run CancellationToken.make()
  let engineJob = run pools.engine.submit(
    1,
    move engineCancel,
    engineDoneWaiter.handle(),
    |_: &CancellationToken| -> () {},
  )
  engineJob.wait()
  run Testing.expect(engineJob.isDone(), "EnginePool stays responsive while AppPool is saturated")

  // Release AppPool gate.
  unsafe Atomic.store<u32>(appGateShared.get().ptr, 1, MemoryOrder.Release)

  // 2. Per-group fairness on a 1-worker pool: group 2 runs ahead of group 1 backlog.
  let mut single = run WorkPool.make(PoolQos.Engine, 1)
  let g1GateBox = run Box<u32>.make(0) |> Effect.provideMut<Allocator>(&mut heap)
  let mut g1GateMut = move g1GateBox
  let g1GatePtr = Pointer.fromMutRef(&mut g1GateMut.getMut()[0])
  let g1Gate = run Arc<AtomicFlag>.make(AtomicFlag { storage: move g1GateMut, ptr: g1GatePtr })
    |> Effect.provideMut<Allocator>(&mut heap)

  let mut startedBox = run Box<u32>.make(0) |> Effect.provideMut<Allocator>(&mut heap)
  let startedPtr = Pointer.fromMutRef(&mut startedBox.getMut()[0])
  let startedFlag = run Arc<AtomicFlag>.make(
    AtomicFlag { storage: move startedBox, ptr: startedPtr },
  )
    |> Effect.provideMut<Allocator>(&mut heap)

  let mut g2OrderBox = run Box<u32>.make(0) |> Effect.provideMut<Allocator>(&mut heap)
  let g2OrderPtr = Pointer.fromMutRef(&mut g2OrderBox.getMut()[0])
  let g2Order = run Arc<AtomicFlag>.make(AtomicFlag { storage: move g2OrderBox, ptr: g2OrderPtr })
    |> Effect.provideMut<Allocator>(&mut heap)

  let mut seqBox = run Box<u32>.make(0) |> Effect.provideMut<Allocator>(&mut heap)
  let seqPtr = Pointer.fromMutRef(&mut seqBox.getMut()[0])
  let seqCounter = run Arc<AtomicFlag>.make(AtomicFlag { storage: move seqBox, ptr: seqPtr })
    |> Effect.provideMut<Allocator>(&mut heap)

  // Hold the single worker on group 1 item 0 until started, then populate group 1 and group 2.
  let hold = g1Gate.clone()
  let started = startedFlag.clone()
  let c0 = run CancellationToken.make()
  drop run single.submit(
    1,
    move c0,
    WakeHandle.noop(),
    |_: &CancellationToken| -> () {
      let startedOwned = move started
      let holdOwned = move hold
      unsafe Atomic.store<u32>(startedOwned.get().ptr, 1, MemoryOrder.Release)
      while unsafe Atomic.load<u32>(holdOwned.get().ptr, MemoryOrder.Acquire) == 0 {
        NativeThread.yieldNow()
      }
    },
  )
  while unsafe Atomic.load<u32>(startedFlag.get().ptr, MemoryOrder.Acquire) == 0 {
    NativeThread.yieldNow()
  }
  let mut i: usize = 0
  while i < 10 {
    let sc = seqCounter.clone()
    let ci = run CancellationToken.make()
    drop run single.submit(
      1,
      move ci,
      WakeHandle.noop(),
      |_: &CancellationToken| -> () {
        let scOwned = move sc
        let _prev = unsafe Atomic.fetchAdd<u32>(scOwned.get().ptr, 1, MemoryOrder.Relaxed)
      },
    )
    i = i + 1
  }
  let sc2 = seqCounter.clone()
  let ord2 = g2Order.clone()
  let c2 = run CancellationToken.make()
  let g2Handle = run single.submit(
    2,
    move c2,
    WakeHandle.noop(),
    |_: &CancellationToken| -> () {
      let sc2Owned = move sc2
      let ord2Owned = move ord2
      let seen = unsafe Atomic.load<u32>(sc2Owned.get().ptr, MemoryOrder.Relaxed) + 1
      unsafe Atomic.store<u32>(ord2Owned.get().ptr, seen, MemoryOrder.Release)
    },
  )
  // Release hold; round-robin runs group 2 ahead of group 1's remaining backlog (FIFO would be 11).
  unsafe Atomic.store<u32>(g1Gate.get().ptr, 1, MemoryOrder.Release)
  g2Handle.wait()
  let recordedOrder = unsafe Atomic.load<u32>(g2Order.get().ptr, MemoryOrder.Acquire)
  run Testing.expect(recordedOrder <= 2, "per-group round-robin runs group 2 ahead of group 1 backlog")

  // 3. Cancellation skips queued work and marks Observed + Finished.
  let preCancel = run CancellationToken.make()
  preCancel.request()
  let mut skippedRan = run Box<u32>.make(0) |> Effect.provideMut<Allocator>(&mut heap)
  let skippedPtr = Pointer.fromMutRef(&mut skippedRan.getMut()[0])
  let skippedFlag = run Arc<AtomicFlag>.make(
    AtomicFlag { storage: move skippedRan, ptr: skippedPtr },
  )
    |> Effect.provideMut<Allocator>(&mut heap)
  let sf = skippedFlag.clone()
  let cancelledHandle = run single.submit(
    3,
    preCancel.clone(),
    WakeHandle.noop(),
    |_: &CancellationToken| -> () {
      let sfOwned = move sf
      unsafe Atomic.store<u32>(sfOwned.get().ptr, 1, MemoryOrder.Release)
    },
  )
  cancelledHandle.wait()
  run Testing.expect(
    preCancel.isObserved()
      && preCancel.isFinished()
      && unsafe Atomic.load<u32>(skippedFlag.get().ptr, MemoryOrder.Acquire) == 0,
    "cancelled queued task is skipped and transitions to Observed -> Finished",
  )
  single.stop()

  // 4. Caller-helps runParallel across 256 items on EnginePool.
  let mut items = List<u64>.make()
  let mut z: usize = 0
  while z < 256 {
    run items.append(0) |> Effect.provideMut<Allocator>(&mut heap)
    z = z + 1
  }
  let listMutex = run Mutex<List<u64>>.make(move items) |> Effect.provideMut<Allocator>(&mut heap)
  let listArc = run Arc<Mutex<List<u64>>>.make(move listMutex)
    |> Effect.provideMut<Allocator>(&mut heap)
  let buf = run Arc<ParallelBuffer>.make(ParallelBuffer { items: move listArc })
    |> Effect.provideMut<Allocator>(&mut heap)
  run pools.engine.runParallel(7, 256, buf.clone(), addIndex)
  let guard = buf.get().items.get().lock()
  let slice = guard.get().asSlice()
  let mut parallelOk = true
  z = 0
  while z < 256 {
    if slice[z] != usize.toU64(z * 3 + 1) {
      parallelOk = false
    }
    z = z + 1
  }
  drop guard
  run Testing.expect(parallelOk, "runParallel computes deterministic output across all 256 items")
  pools.stop()
}
