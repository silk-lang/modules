//! A check behind an answer of the docs' "Can I use" page (docs/caniuse/README.md).
import silk.core.ownership { Copy }

/// `sheet` changes how the fixture looks (`works`), or changes nothing yet. `base` is a sheet
/// the fixture has either way, and `root`, `lead` and `setup` are inline styles of its nodes.
pub struct Probe {
  pub feature: string<'static>,
  pub works: bool,
  pub root: &'static [u8],
  pub lead: &'static [u8],
  pub setup: &'static [u8],
  pub base: string<'static>,
  pub sheet: string<'static>,
}

impl Copy for Probe {}
