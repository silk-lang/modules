      if isFatal(rv) { return i32.toI64(rv) }
      return inlen
    } else if st == IB_READ_SETTINGS {
      let readlen = unsafe bufRead(sp, input, at, end)
      at = at + readlen
      let s = unsafe ses(&mut a, sp) s.payloadLeft = s.payloadLeft - readlen let remaining = s.payloadLeft drop s
      if unsafe markAvail(sp) == 0 {
        if readlen > 0 { unsafe settingsEntry(sp) }
        if remaining > 0 { unsafe setMark(sp, 6) }
        else {
          let rv = unsafe processSettingsFrame(sp)
          if isFatal(rv) { return i32.toI64(rv) }
          if unsafe state(sp) == IB_IGN_ALL { return inlen }
          unsafe ibReset(sp)
        }
      }
    } else if st == IB_READ_GOAWAY_DEBUG || st == IB_READ_ALTSVC_PAYLOAD || st == IB_READ_ORIGIN_PAYLOAD {
      let readlen = unsafe payloadReadLen(sp, at, end)
      if readlen > 0 {
        let s = unsafe ses(&mut a, sp)
        let ok = unsafe s.lbuf.append(unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe atConst(input, at)), readlen)
        s.payloadLeft = s.payloadLeft - readlen drop s
        if !ok { return i32.toI64(ERR_NOMEM) }
        at = at + readlen
      }
      let s2 = unsafe ses(&mut a, sp) let remaining = s2.payloadLeft drop s2
      if remaining == 0 {
        let rv = if st == IB_READ_GOAWAY_DEBUG { unsafe onGoawayReceived(sp) } else if st == IB_READ_ALTSVC_PAYLOAD { unsafe onAltsvcReceived(sp) } else { unsafe onOriginReceived(sp) }
        if isFatal(rv) { return i32.toI64(rv) }
        if st != IB_READ_ALTSVC_PAYLOAD && unsafe state(sp) == IB_IGN_ALL { return inlen }
        unsafe ibReset(sp)
      }
    } else if st == IB_EXPECT_CONTINUATION || st == IB_IGN_CONTINUATION {
      let s = unsafe ses(&mut a, sp) s.numContinuations = s.numContinuations + 1 let tooMany = s.numContinuations > s.maxContinuations drop s
      if tooMany { return i32.toI64(ERR_TOO_MANY_CONTINUATIONS) }
      at = at + unsafe bufRead(sp, input, at, end)
      if unsafe markAvail(sp) > 0 { return usize.toI64(at) }
      let s2 = unsafe ses(&mut a, sp)
      let contLength = u32.toUsize(u32.shiftRight(unsafe sbU32Raw(&s2.*), 8))
      let contKind = s2.sbuf[3] let contFlags = s2.sbuf[4]
      let contStream = u32.wrappingToI32(u32.bitAnd(u32.bitOr(u32.bitOr(u32.shiftLeft(u8.toU32(s2.sbuf[5]), 24), u32.shiftLeft(u8.toU32(s2.sbuf[6]), 16)), u32.bitOr(u32.shiftLeft(u8.toU32(s2.sbuf[7]), 8), u8.toU32(s2.sbuf[8]))), 2147483647))
      s2.payloadLeft = contLength
