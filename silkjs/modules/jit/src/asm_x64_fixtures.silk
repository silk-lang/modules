}

test effect fn movesMatchLlvm() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut a = Assembler.make()
  run movesCases(&mut a) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn loadsCases(a: &mut Assembler) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut at: usize = 0
  run a.load(Width.W64, Reg.Rbx, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x8b\x18"), "mov rbx, qword ptr [rax]")
  run a.load(Width.W64, Reg.R10, Mem.at(Reg.Rax, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\x50\x08"), "mov r10, qword ptr [rax + 8]")
  run a.load(Width.W64, Reg.Rcx, Mem.at(Reg.Rcx, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x8b\x09"), "mov rcx, qword ptr [rcx]")
  run a.load(Width.W64, Reg.R8, Mem.at(Reg.Rcx, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\x41\x08"), "mov r8, qword ptr [rcx + 8]")
  run a.load(Width.W64, Reg.R15, Mem.at(Reg.Rdx, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\x3a"), "mov r15, qword ptr [rdx]")
  run a.load(Width.W64, Reg.Rsi, Mem.at(Reg.Rdx, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x8b\x72\x08"), "mov rsi, qword ptr [rdx + 8]")
  run a.load(Width.W64, Reg.R13, Mem.at(Reg.Rbx, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\x2b"), "mov r13, qword ptr [rbx]")
  run a.load(Width.W64, Reg.Rsp, Mem.at(Reg.Rbx, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x8b\x63\x08"), "mov rsp, qword ptr [rbx + 8]")
  run a.load(Width.W64, Reg.R11, Mem.at(Reg.Rsp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\x1c\x24"), "mov r11, qword ptr [rsp]")
  run a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rsp, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x8b\x54\x24\x08"), "mov rdx, qword ptr [rsp + 8]")
  run a.load(Width.W64, Reg.R9, Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\x4d\x00"), "mov r9, qword ptr [rbp]")
  run a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rbp, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x8b\x45\x08"), "mov rax, qword ptr [rbp + 8]")
  run a.load(Width.W64, Reg.Rdi, Mem.at(Reg.Rsi, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x8b\x3e"), "mov rdi, qword ptr [rsi]")
  run a.load(Width.W64, Reg.R14, Mem.at(Reg.Rsi, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\x76\x08"), "mov r14, qword ptr [rsi + 8]")
  run a.load(Width.W64, Reg.Rbp, Mem.at(Reg.Rdi, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x8b\x2f"), "mov rbp, qword ptr [rdi]")
  run a.load(Width.W64, Reg.R12, Mem.at(Reg.Rdi, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\x67\x08"), "mov r12, qword ptr [rdi + 8]")
  run a.load(Width.W64, Reg.Rbx, Mem.at(Reg.R8, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x49\x8b\x18"), "mov rbx, qword ptr [r8]")
  run a.load(Width.W64, Reg.R10, Mem.at(Reg.R8, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x8b\x50\x08"), "mov r10, qword ptr [r8 + 8]")
  run a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R9, 0))
