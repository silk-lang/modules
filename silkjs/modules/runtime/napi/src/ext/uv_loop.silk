}

// ---- Descriptor handles for other modules -----------------------------------------------------
/// The `events` bit that a descriptor handle's callback gets with an error or hangup condition.
pub const IO_ERROR: i32 = 256
/// The `events` bit that comes with IO_ERROR when the condition is a hangup (epoll's EPOLLHUP;
/// kqueue reports none).
pub const IO_HANGUP: i32 = 1024
/// Initializes a descriptor handle of libuv kind `kind` (UV_TCP 12, UV_NAMED_PIPE 7, UV_TTY 14,
/// UV_UDP 15) with no descriptor yet.
pub unsafe fn ioInit(loopMemory: *mut u8, memory: *mut u8, kind: i32) -> () {
  let handle = unsafe initialize(unsafe loopOf(loopMemory), memory, kind)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  h.flags = h.flags | IO
}
/// Sets the descriptor of a descriptor handle (-1 for none). Its watch must be off.
pub unsafe fn ioSetDescriptor(memory: *mut u8, fd: i32) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, unsafe handleOf(memory))
