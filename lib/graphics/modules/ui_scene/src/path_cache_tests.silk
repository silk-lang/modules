//! Path cache tests: hits on whole-pixel moves, misses on new subpixel offsets, eviction, and
//! coverage that matches a direct `vector` fill.
import color
import path_cache { PathCache, PathWorkItem, rasterizeWork }
import primitives { Background, ContentMask }
import scene { Scene }
import scene_tests { rect, window }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u32
import silk.num.u8
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }
import vector.geometry { Affine }
import vector.geometry_error { GeometryError }
import vector.path { Path }
import vector.strips { Coverage, NONZERO, Rasterizer }
import vector.stroke { Stroke }

fn at(x: f64, y: f64) -> Affine {
  return Affine.new(1.0, 0.0, 0.0, 1.0, x, y)
}

/// The coverage of path sprite `index` of layer 0 at pixel `(x, y)` of the window, 0 outside.
fn coverageAt(scene: &Scene, index: usize, x: i32, y: i32) -> u32 {
  let p = scene.paths(0)[index]
  let lx = x - p.x
  let ly = y - p.y
  if lx < 0 || ly < 0 || lx >= u32.toI32(p.width) || ly >= u32.toI32(p.height) {
    return 0
  }
  let ux = i32.toU32(lx)
  let uy = i32.toU32(ly)
  let band = uy - uy % 4
  let strips = scene.pathStrips()
  let mut s = u32.toUsize(p.stripStart)
  while s < u32.toUsize(p.stripStart + p.stripCount) {
    let strip = strips[s]
    if strip.y == band && ux >= strip.x && ux < strip.x + strip.width {
      return u8.toU32(
        scene.pathAlphas()[u32.toUsize(strip.alphaOffset + (ux - strip.x) * 4 + uy - band)],
      )
    }
    s = s + 1
  }
  let fills = scene.pathFills()
  let mut f = u32.toUsize(p.fillStart)
  while f < u32.toUsize(p.fillStart + p.fillCount) {
    let fill = fills[f]
    if fill.y == band && ux >= fill.x && ux < fill.x + fill.width {
      return 255
    }
    f = f + 1
  }
  return 0
}

effect fn caching() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut path = Path.make()
  run path.circle(0.0, 0.0, 10.3)
  let paint = Background.solid(color.black())
  let mut cache = PathCache.make()
  let mut scene = Scene.make()

  run cache.beginFrame()
  drop run cache.fill(&mut scene, 7, &path, &at(50.25, 40.0), NONZERO, paint, window())
  drop run cache.fill(&mut scene, 7, &path, &at(150.25, 140.0), NONZERO, paint, window())
  drop run cache.fill(&mut scene, 7, &path, &at(50.5, 40.0), NONZERO, paint, window())
  run Testing.expect(
    cache.misses() == 2 && cache.hits() == 1,
    "a whole-pixel move hits, a new subpixel offset misses",
  )
  run Testing.expect(cache.length() == 2, "two placements cached")
  run scene.finish()

  // Placements 100 px apart have the same coverage, 100 px apart.
  let mut same = true
  let mut y: i32 = 25
  while y < 56 {
    let mut x: i32 = 35
    while x < 66 {
      same = same && coverageAt(&scene, 0, x, y) == coverageAt(&scene, 1, x + 100, y + 100)
      x = x + 1
    }
    y = y + 1
  }
  run Testing.expect(same, "reused coverage lands at the new origin")

  // The cached coverage equals a direct fill at the same transform.
  let mut raster = Rasterizer.make()
  let mut direct = Coverage.make(200, 200)
  run raster.fill(&path, &at(50.25, 40.0), NONZERO, &mut direct)
  let mut equal = true
  let mut yy: u32 = 25
  while yy < 56 {
    let mut xx: u32 = 35
    while xx < 66 {
      equal = equal
        && coverageAt(&scene, 0, u32.toI32(xx), u32.toI32(yy)) == u8.toU32(direct.alphaAt(xx, yy))
      xx = xx + 1
    }
    yy = yy + 1
  }
  run Testing.expect(equal, "path-relative coverage matches vector's own fill")

  // Unused for two frames: evicted on the third.
  run cache.beginFrame()
  run cache.beginFrame()
  run Testing.expect(cache.length() == 2, "kept while unused for up to two frames")
  run cache.beginFrame()
  run Testing.expect(cache.length() == 0, "evicted after two unused frames")

  // Strokes cache on their style.
  scene.clear()
  let mut style = Stroke.make(3.0)
  drop run cache.stroke(&mut scene, 9, &path, &style, &at(50.0, 50.0), paint, window())
  drop run cache.stroke(&mut scene, 9, &path, &style, &at(60.0, 50.0), paint, window())
  style.width = 4.0
  drop run cache.stroke(&mut scene, 9, &path, &style, &at(70.0, 50.0), paint, window())
  run Testing.expect(
    cache.hits() == 2 && cache.misses() == 4,
    "same style hits, a new width misses",
  )
}

test effect fn coverageIsCachedAcrossFrames() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run caching() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn uncached() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut path = Path.make()
  run path.circle(0.0, 0.0, 30.0)
  let mut cache = PathCache.make()
  let mut scene = Scene.make()
  run cache.beginFrame()
  let mask = ContentMask.new(rect(40.0, 40.0, 100.0, 100.0))
  let order = run cache.fill(
    &mut scene,
    0,
    &path,
    &at(50.0, 50.0),
    NONZERO,
    Background.solid(color.black()),
    mask,
  )
  run Testing.expect(order == 1 && cache.length() == 0, "id 0 is drawn but not cached")
  let hidden = run cache.fill(
    &mut scene,
    0,
    &path,
    &at(500.0, 500.0),
    NONZERO,
    Background.solid(color.black()),
    mask,
  )
  run Testing.expect(hidden == 0, "a path outside its mask adds nothing")
  run scene.finish()
  let p = scene.paths(0)[0]
  run Testing.expect(
    p.x == 40 && p.y == 40 && p.width == 40 && p.height == 40,
    "clipped to the mask",
  )
}

test effect fn uncachedPathsClipToTheirMask() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run uncached() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn preRasterParity() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut path = Path.make()
  run path.circle(0.0, 0.0, 12.5)
  let paint = Background.solid(color.black())
  let tr = at(50.25, 45.75)

  let mut serialCache = PathCache.make()
  let mut parallelCache = PathCache.make()
  run serialCache.beginFrame()
  run parallelCache.beginFrame()

  let fillKey = parallelCache.makeFillKey(101, &tr, NONZERO)
  run Testing.expect(!parallelCache.isCached(fillKey), "fill key not cached initially")
  let fillWork = PathWorkItem {
    key: fillKey,
    path: Path.make(),
    transform: tr,
    rule: NONZERO,
    isStroke: false,
    stroke: Stroke.make(1.0),
  }
  let mut fillPathCopy = Path.make()
  run fillPathCopy.circle(0.0, 0.0, 12.5)
  let fillItem = PathWorkItem {
    key: fillKey,
    path: move fillPathCopy,
    transform: tr,
    rule: NONZERO,
    isStroke: false,
    stroke: Stroke.make(1.0),
  }
  drop move fillWork
  let preFill = run rasterizeWork(&fillItem)
  run Testing.expect(preFill.cacheable, "pre-raster fill is cacheable")
  let insertedFill = run parallelCache.insertPreRasterized(move preFill)
  run Testing.expect(insertedFill && parallelCache.isCached(fillKey), "pre-raster fill inserted")

  let mut style = Stroke.make(2.5)
  let strokeKey = parallelCache.makeStrokeKey(102, &style, &tr)
  let mut strokePathCopy = Path.make()
  run strokePathCopy.circle(0.0, 0.0, 12.5)
  let strokeItem = PathWorkItem {
    key: strokeKey,
    path: move strokePathCopy,
    transform: tr,
    rule: NONZERO,
    isStroke: true,
    stroke: move style,
  }
  let preStroke = run rasterizeWork(&strokeItem)
  run Testing.expect(preStroke.cacheable, "pre-raster stroke is cacheable")
  let insertedStroke = run parallelCache.insertPreRasterized(move preStroke)
  run Testing.expect(insertedStroke && parallelCache.isCached(strokeKey), "pre-raster stroke inserted")

  let mut serialScene = Scene.make()
  let mut parallelScene = Scene.make()
  drop run serialCache.fill(&mut serialScene, 101, &path, &tr, NONZERO, paint, window())
  drop run parallelCache.fill(&mut parallelScene, 101, &path, &tr, NONZERO, paint, window())
  drop run serialCache.stroke(&mut serialScene, 102, &path, &Stroke.make(2.5), &tr, paint, window())
  drop run parallelCache.stroke(&mut parallelScene, 102, &path, &Stroke.make(2.5), &tr, paint, window())
  run Testing.expect(
    parallelCache.hits() == 2 && serialCache.misses() == 2,
    "parallel fills/strokes hit cache cleanly after pre-raster insertion",
  )
  run serialScene.finish()
  run parallelScene.finish()
  let sp = serialScene.paths(0)
  let pp = parallelScene.paths(0)
  run Testing.expect(sp.length == 2 && pp.length == 2, "both scenes emitted 2 path sprites")
  run Testing.expect(
    sp[0].width == pp[0].width && sp[0].height == pp[0].height
      && sp[1].width == pp[1].width && sp[1].height == pp[1].height,
    "pre-rasterized path dimensions match serial rasterization",
  )
  let mut y: i32 = 25
  while y < 70 {
    let mut x: i32 = 30
    while x < 75 {
      run Testing.expect(
        coverageAt(&serialScene, 0, x, y) == coverageAt(&parallelScene, 0, x, y),
        "fill coverage pixel parity",
      )
      run Testing.expect(
        coverageAt(&serialScene, 1, x, y) == coverageAt(&parallelScene, 1, x, y),
        "stroke coverage pixel parity",
      )
      x = x + 1
    }
    y = y + 1
  }
}

test effect fn preRasterizedPathsMatchDirectFillAndStroke() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run preRasterParity() |> Effect.provideMut<Allocator>(&mut allocator)
}
