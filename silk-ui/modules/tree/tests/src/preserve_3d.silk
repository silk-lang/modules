//! `transform-style: preserve-3d`: boxes share a 3D rendering context, sorted by depth and split
//! where they cross, as in Chromium. Every expectation was measured in Chromium on the same
//! page: a 400 by 300 stage with `perspective: 600px` holding a 200 by 200 context box at
//! (100, 50) with two 200 by 200 children, `a` red and `b` blue.
import ui_tree.cssom_view as view
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, FrameInput, StyleState, Mutation, CpuSnapshot }
import ui_fixtures.fixtures as fixtures
import svg_css.written
import svg_css.tokens { CssError }
import svg_css.cssom_error { CssomError }
import vector.pixmap { Pixmap }
import vector.geometry_error { GeometryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.testing.testing { Testing, AssertionError }

const STAGE: u32 = 2
const CONTEXT: u32 = 3
const A: u32 = 4
const B: u32 = 5

fn close(a: f64, b: f32) -> bool {
  return f32.abs(f64.toF32(a) - b) <= 0.6
}

/// The color at (`x`, `y`): `R`ed, `B`lue, `W`hite or `?`.
fn colorAt(image: &Pixmap, x: u32, y: u32) -> u8 {
  let p = image.pixel(x, y)
  if p.r > 200 && p.g < 60 && p.b < 60 { return 82 }
  if p.b > 200 && p.r < 60 && p.g < 60 { return 66 }
  if p.r > 200 && p.g > 200 && p.b > 200 { return 87 }
  return 63
}

effect fn style<'f>(batch: &mut Batch, id: u32, base: &[u8], extra: &[u8]) -> () ! CssError | OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  run text.append(base)
  run text.append(b";")
  run text.append(extra)
  let declarations = run written.declarations(text.asSlice())
  run batch.push(Mutation.ClearStyle { id: id, state: StyleState.Base })
  run batch.style(id, declarations.asSlice())
}

/// Builds the page, or restyles it: the context box and its children get `ctx`, `a` and `b`.
effect fn scene<'f>(tree: &mut UiTree<'f>, first: bool, ctx: &[u8], a: &[u8], b: &[u8]) -> Pixmap
  ! TreeError | CssError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  if first {
    run batch.create(1, NodeKind.Box)
    run batch.root(1)
    let root = run written.declarations(b"width:400px;height:300px")
    run batch.style(1, root.asSlice())
    let stage = run written.declarations(b"position:absolute;left:0;top:0;width:400px;height:300px;perspective:600px;background:#fff")
    run batch.box(1, STAGE, stage.asSlice())
    let none = run written.declarations(b"display:block")
    run batch.box(STAGE, CONTEXT, none.asSlice())
    run batch.box(CONTEXT, A, none.asSlice())
    run batch.box(CONTEXT, B, none.asSlice())
  }
  run style(&mut batch, CONTEXT, b"position:absolute;left:100px;top:50px;width:200px;height:200px", ctx)
  run style(&mut batch, A, b"position:absolute;left:0;top:0;width:200px;height:200px;background:rgb(255,0,0)", a)
  run style(&mut batch, B, b"position:absolute;left:0;top:0;width:200px;height:200px;background:rgb(0,0,255)", b)
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 })
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  return run snapshot.render(&tree)
}

const PROBES: [[u32; 2]; 11] = [
  [130, 150], [170, 150], [200, 150], [230, 150], [270, 150], [200, 80], [200, 220], [150, 100],
  [250, 200], [95, 150], [305, 150],
]

/// Chromium's colors at `PROBES` (`.` where it is not checked: an edge).
effect fn expectColors(image: &Pixmap, expected: &[u8], message: string<'static>) -> () ! AssertionError<'static> {
  let mut i: usize = 0
  while i < PROBES.length {
    if expected[i] != 46 && colorAt(image, PROBES[i][0], PROBES[i][1]) != expected[i] {
      run Testing.expect(false, message)
    }
    i = i + 1
  }
}

/// Chromium's `elementFromPoint` at `PROBES` (0 where it is not checked).
effect fn expectHits<'f>(tree: &UiTree<'f>, expected: [u32; 11], message: string<'static>) -> () ! AssertionError<'static> {
  let mut i: usize = 0
  while i < PROBES.length {
    if expected[i] != 0 && tree.hitTest(u32.toF32(PROBES[i][0]), u32.toF32(PROBES[i][1])) != expected[i] {
      run Testing.expect(false, message)
    }
    i = i + 1
  }
}

effect fn expectRect<'f>(tree: &mut UiTree<'f>, id: u32, expected: [f32; 4], message: string<'static>) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let rect = run view.getBoundingClientRect(&tree, id)
  run Testing.expect(close(rect.x, expected[0]) && close(rect.y, expected[1]) && close(rect.width, expected[2]) && close(rect.height, expected[3]), message)
}

effect fn contexts() -> () ! AssertionError<'static> | TreeError | CssError | CssomError | GeometryError | OutOfMemoryError ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)

  let depth = run scene(&mut tree, true, b"transform-style:preserve-3d;transform:rotateY(30deg)", b"transform:translateZ(50px)", b"transform:translateZ(-50px)")
  run expectColors(&depth, b"RRRRRRRRRBR", "the nearer box draws over the later one")
  run expectHits(&tree, [A, A, A, A, A, A, A, A, A, B, A], "and takes the pointer")
  run expectRect(&mut tree, A, [127.05, 31.59, 183.32, 236.83], "the nearer box's client rect")
  run expectRect(&mut tree, B, [87.14, 48.87, 166.17, 202.26], "the farther box's client rect")

  let flat = run scene(&mut tree, false, b"transform-style:preserve-3d;transform:rotateY(30deg);opacity:0.999", b"transform:translateZ(50px)", b"transform:translateZ(-50px)")
  run expectColors(&flat, b"BBBBBBBBBWW", "opacity flattens the context: tree order")
  run expectHits(&tree, [B, B, B, B, B, B, B, B, B, 0, 0], "and hits in tree order")
  run expectRect(&mut tree, A, [105.52, 40.91, 174.42, 218.18], "a flattened box's client rect")

  let cross = run scene(&mut tree, false, b"transform-style:preserve-3d", b"transform:rotateY(45deg)", b"transform:rotateY(-45deg)")
  run expectColors(&cross, b"RR.BBBBRBWW", "crossing planes split where they meet")
  run expectHits(&tree, [A, A, 0, B, B, B, B, A, B, 0, 0], "and each half takes the pointer where it is in front")
  run expectRect(&mut tree, A, [119.84, 36.64, 143.41, 226.72], "a turned plane's client rect")

  let crossFlat = run scene(&mut tree, false, b"", b"transform:rotateY(45deg)", b"transform:rotateY(-45deg)")
  run expectColors(&crossFlat, b"BBBB.BBBBWW", "without preserve-3d the later box covers")

  let chain = run scene(&mut tree, false, b"transform-style:preserve-3d;transform:rotateX(40deg)", b"transform:rotateY(50deg);width:100px;height:100px", b"display:none")
  run expectColors(&chain, b"WRWWWWWRWWW", "transforms accumulate through the context")
  run expectRect(&mut tree, A, [113.64, 54.35, 70.91, 119.13], "an accumulated client rect")
  run expectRect(&mut tree, CONTEXT, [88.0, 80.81, 224.0, 154.99], "the context's own client rect")

  let chainFlat = run scene(&mut tree, false, b"transform:rotateX(40deg)", b"transform:rotateY(50deg);width:100px;height:100px", b"display:none")
  run expectColors(&chainFlat, b"WWWWWWWRWWW", "flattened, the child turns in its parent's plane")
  run expectRect(&mut tree, A, [117.86, 80.81, 66.01, 69.19], "a flattened child's client rect")

  let flip = run scene(&mut tree, false, b"transform-style:preserve-3d;transform:rotateY(180deg)", b"backface-visibility:hidden", b"backface-visibility:hidden;transform:rotateY(180deg)")
  run expectColors(&flip, b"BBBBBBBBBWW", "a turned context hides the back faces in it")
  run expectHits(&tree, [B, B, B, B, B, B, B, B, B, 0, 0], "which take no pointer")

  let tilt = run scene(&mut tree, false, b"transform-style:preserve-3d;transform:rotateX(60deg)", b"transform:translateZ(40px);width:100px;height:100px;left:50px;top:50px", b"transform:rotateX(-90deg);transform-origin:50% 100%;height:100px")
  run expectColors(&tilt, b"WWWWWBWBWWW", "a box standing up in a tilted context")
  run expectHits(&tree, [CONTEXT, CONTEXT, CONTEXT, CONTEXT, CONTEXT, B, STAGE, B, CONTEXT, 0, 0], "hits by depth")
  run expectRect(&mut tree, A, [144.1, 92.59, 111.79, 46.63], "a lifted box's client rect")
  run expectRect(&mut tree, B, [90.91, 55.52, 218.18, 94.48], "a standing box's client rect")
}

test effect fn preserve3dLikeChromium() -> ()
  ! AssertionError<'static> | TreeError | CssError | CssomError | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run contexts() |> Effect.provideMut<Allocator>(&mut allocator)
}
