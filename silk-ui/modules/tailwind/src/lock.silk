import silk.crypto.sha2 { Sha256 }
import silk.json.value { Json }
import silk.json.scanner { JsonError }
import silk.cli.task { Task, TaskError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.u8

pub struct Lock {
  pub version: String,
  pub checksum: String,
}

fn safeVersion(value: string) -> bool {
  let bytes = String.utf8Bytes(value)
  if bytes.length == 0 || bytes.length > 80 || bytes[0] < 48 || bytes[0] > 57 { return false }
  let mut i: usize = 0
  while i < bytes.length {
    let c = bytes[i]
    if !((c >= 48 && c <= 57) || (c >= 97 && c <= 122) || c == 46 || c == 45) { return false }
    i = i + 1
  }
  return true
}

pub fn supported(platform: string) -> bool {
  return platform == "linux-x64" || platform == "linux-arm64" || platform == "linux-x64-musl" || platform == "linux-arm64-musl" || platform == "macos-x64" || platform == "macos-arm64" || platform == "windows-x64"
}

pub effect fn parse(bytes: &[u8], platform: string) -> Lock
  ! JsonError | TaskError | OutOfMemoryError ? &mut Allocator {
  if !supported(platform) { run Task.abort("ui-tailwind: unsupported standalone platform") }
  let document = run Json.parse(bytes)
  let version = Json.asString(Json.field(&document, "version")).unwrapOr("")
  let checksum = Json.asString(Json.fieldAt(Json.field(&document, "platforms"), platform)).unwrapOr("")
  if !safeVersion(version) { run Task.abort("ui-tailwind: lock file needs an exact Tailwind version") }
  if String.utf8Bytes(checksum).length != 64 { run Task.abort("ui-tailwind: lock file needs a SHA-256 for this platform") }
  let mut i: usize = 0
  while i < 64 {
    let c = String.utf8Bytes(checksum)[i]
    if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) { run Task.abort("ui-tailwind: SHA-256 must be lowercase hexadecimal") }
    i = i + 1
  }
  return Lock { version: run String.copy(version), checksum: run String.copy(checksum) }
}

pub fn matches(bytes: &[u8], expected: string) -> bool {
  let wanted = String.utf8Bytes(expected)
  if wanted.length != 64 { return false }
  let digest = Sha256.hash(bytes)
  let digits = b"0123456789abcdef"
  let mut i: usize = 0
  while i < 32 {
    if digits[u8.toUsize(digest[i] / 16)] != wanted[i * 2] || digits[u8.toUsize(digest[i] % 16)] != wanted[i * 2 + 1] { return false }
    i = i + 1
  }
  return true
}
