import runtime_stylesheets as _runtime_stylesheets
import gpu_canvases as _gpu_canvases
import frame_submit as _frame_submit
import canvas_layer_plan as _canvas_layer_plan
import canvas_rasters as _canvas_rasters
import screen_reader as _screen_reader
//! Window events through the adapter into the inbox fixture: modules/platform/window's headless
//! backend delivers synthetic mouse, wheel and key events, the adapter turns them into tree
//! input, and the tree answers with records, focus and scroll offsets.
import ui_fixtures.fixtures as fixtures
import loading as _loading
import cursors as _cursors
import stylesheet_updates as _stylesheet_updates
import ui_tree.legacy { UiTree, TreeError, Batch, Event as Record, EventKind, Keymap }
import ui_tree_window.lib { feed, serve, runFollowUps, windowCursor, HostState, coalesce, editMenuEvent, EDIT_MENU_ACTION }
import window.event { Event, Key, MouseButton, Modifiers, Phase, ScrollDelta }
import window.headless { HeadlessPlatform, HeadlessWindow }
import window.keys { KeyCode, NamedKey }
// Interface methods resolve through this import; silk#2819 reports it as unused.
import window.platform { Platform as _Platform }
import window.types { WindowId, WindowOptions, WindowError, Wait, Cursor, ImeState }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.point { Point2 }
import silk.geometry.size { Size2 }
import silk.geometry.vector { Vector2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
import silk.testing.testing { AssertionError, Testing }
import silk.text.string { String }

fn at(x: f64, y: f64) -> Point2<f64> {
  return Point2<f64>.new(x, y)
}

/// Pulls every queued window event and feeds it to the tree. Returns how many were input.
effect fn pump(platform: &mut HeadlessPlatform, tree: &mut UiTree<'_>) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut fed: u32 = 0
  while true {
    match move run platform.nextEvent(Wait.Poll) {
      Option<Event>.Some { value } => {
        if run feed(&mut tree, &value) {
          fed = fed + 1
        }
      }
      Option<Event>.None => {
        break
      }
    }
  }
  return fed
}

fn count(events: &List<Record>, kind: EventKind, target: u32) -> usize {
  let values = events.asSlice()
  let mut found: usize = 0
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == kind && values[i].target == target {
      found = found + 1
    }
    i = i + 1
  }
  return found
}

/// Whether the key down record says Tab for both key and code.
fn namesTab(events: &List<Record>) -> bool {
  let values = events.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == EventKind.KeyDown {
      return String.view(&values[i].key) == "Tab" && String.view(&values[i].code) == "Tab"
    }
    i = i + 1
  }
  return false
}

effect fn body() -> ()
  ! AssertionError<'static>
    | TreeError
    | WindowError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.inbox(&mut batch)
  run tree.apply(run batch.take())
  run tree.frame(fixtures.viewport(2))

  let mut platform = run HeadlessPlatform.start()
  let window = run platform.openWindow(&WindowOptions.make("inbox", 360.0, 440.0))
  drop run pump(&mut platform, &mut tree)
  let none = Modifiers.none()

  // Hover and click New.
  run platform.push(Event.MouseMoved { window: window, position: at(40.0, 27.0), modifiers: none })
  run platform.push(
    Event.MouseDown {
      window: window,
      button: MouseButton.Left,
      position: at(40.0, 27.0),
      modifiers: none,
      clickCount: 1,
    },
  )
  run platform.push(
    Event.MouseUp {
      window: window,
      button: MouseButton.Left,
      position: at(40.0, 27.0),
      modifiers: none,
    },
  )
  let fed = run pump(&mut platform, &mut tree)
  run Testing.expect(fed == 3, "three window events became input")
  let mut events = List<Record>.make()
  run tree.takeEvents(&mut events)
  run Testing.expect(count(&events, EventKind.Click, fixtures.NEW_BUTTON) == 1, "New was clicked")
  run Testing.expect(windowCursor(tree.cursor()) == Cursor.PointingHand, "the cursor maps")

  // One wheel notch towards the user scrolls the list down by 40 pixels.
  run platform.push(
    Event.Scroll {
      window: window,
      position: at(340.0, 112.0),
      delta: ScrollDelta.Lines { delta: Vector2<f64> { x: 0.0, y: -1.0 } },
      phase: Phase.None,
      modifiers: none,
    },
  )

  // Tab moves focus from New to Archive.
  run platform.push(
    Event.KeyDown {
      window: window,
      key: Key.Named { key: NamedKey.Tab },
      code: KeyCode.Tab,
      modifiers: none,
      repeat: false,
      imeHandled: false,
    },
  )
  drop run pump(&mut platform, &mut tree)
  events.clear()
  run tree.takeEvents(&mut events)
  run Testing.expect(tree.scrollOffset(fixtures.INBOX_LIST).y == 40.0, "a notch is 40 pixels")
  run Testing.expect(
    count(&events, EventKind.KeyDown, fixtures.NEW_BUTTON) == 1 && namesTab(&events),
    "the key record names the key",
  )
  run Testing.expect(tree.focused == tree.slotOf(fixtures.ARCHIVE_BUTTON), "Tab moved focus")
}

test effect fn windowEventsDriveTheTree() -> ()
  ! AssertionError<'static>
    | TreeError
    | WindowError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn valueOf<'t>(tree: &'t UiTree<'_>, id: u32) -> string<'t> {
  return String.view(&tree.node(tree.slotOf(id)).text)
}

effect fn shortcut(
  platform: &mut HeadlessPlatform,
  window: WindowId,
  letter: string,
  code: KeyCode,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut modifiers = Modifiers.none()
  modifiers.control = true
  run platform.push(
    Event.KeyDown {
      window: window,
      key: Key.Character { text: run String.copy(letter) },
      code: code,
      modifiers: modifiers,
      repeat: false,
      imeHandled: false,
    },
  )
}

/// Text input, composition and the clipboard through the adapter: the editor's focused
/// search field takes typed and committed text, its caret reaches the platform's input method,
/// and copy and paste go through the headless clipboard.
effect fn editingBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | WindowError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  tree.keymap = Keymap.Standard
  let mut batch = Batch.make()
  run fixtures.editor(&mut batch)
  run tree.apply(run batch.take())
  run tree.frame(fixtures.viewport(3))
  let mut platform = run HeadlessPlatform.start()
  let window = run platform.openWindow(&WindowOptions.make("editor", 360.0, 300.0))
  drop run pump(&mut platform, &mut tree)
  let mut host = HostState.make()
  run serve(&mut platform, window, &mut tree, &mut host)
  run runFollowUps(&mut platform, window, &mut tree, &mut host)
  let ime = match platform.window(window) {
    Option<&HeadlessWindow>.Some { value } => value.ime
    Option<&HeadlessWindow>.None => ImeState.disabled()
  }
  run Testing.expect(ime.enabled && ime.cursorArea.xMin > 29.0, "the input method gets the caret")

  // Copy "wonderful", type over it, compose and commit, then paste.
  run shortcut(&mut platform, window, "c", KeyCode.KeyC)
  drop run pump(&mut platform, &mut tree)
  run serve(&mut platform, window, &mut tree, &mut host)
  run runFollowUps(&mut platform, window, &mut tree, &mut host)
  run platform.push(Event.TextInput { window: window, text: run String.copy("great") })
  run platform.push(
    Event.ImePreedit {
      window: window,
      text: run String.copy("\u{306b}"),
      selectionStart: 3,
      selectionEnd: 3,
    },
  )
  drop run pump(&mut platform, &mut tree)
  run Testing.expect(
    valueOf(&tree, fixtures.SEARCH) == "Hello great world",
    "typed text replaces the selection",
  )
  run platform.push(
    Event.ImePreedit { window: window, text: String.make(), selectionStart: 0, selectionEnd: 0 },
  )
  run platform.push(Event.TextInput { window: window, text: run String.copy("\u{4e8c}") })
  run shortcut(&mut platform, window, "v", KeyCode.KeyV)
  drop run pump(&mut platform, &mut tree)
  run serve(&mut platform, window, &mut tree, &mut host)
  run runFollowUps(&mut platform, window, &mut tree, &mut host)
  run Testing.expect(
    valueOf(&tree, fixtures.SEARCH) == "Hello great\u{4e8c}wonderful world",
    "the commit and the paste land at the caret",
  )

  // A secondary press opens the edit menu; its Copy copies as the shortcut does.
  run shortcut(&mut platform, window, "a", KeyCode.KeyA)
  drop run pump(&mut platform, &mut tree)
  run platform.writeClipboard("before")
  run platform.push(Event.MouseDown {
    window: window,
    button: MouseButton.Right,
    position: Point2<f64> { x: ime.cursorArea.xMin + 4.0, y: (ime.cursorArea.yMin + ime.cursorArea.yMax) * 0.5 },
    modifiers: Modifiers.none(),
    clickCount: 1,
  })
  drop run pump(&mut platform, &mut tree)
  run serve(&mut platform, window, &mut tree, &mut host)
  run Testing.expect(platform.contextMenu.isSome(), "a secondary press on the input opens its edit menu")
  drop run platform.answerContextMenu(Option<u32>.some(EDIT_MENU_ACTION + 3))
  while true {
    match move run platform.nextEvent(Wait.Poll) {
      Option<Event>.Some { value } => {
        drop run feed(&mut tree, &editMenuEvent(move value, window))
      }
      Option<Event>.None => {
        break
      }
    }
  }
  run serve(&mut platform, window, &mut tree, &mut host)
  let copied = run platform.readClipboard()
  run Testing.expect(
    match &copied { Option<String>.Some { value } => String.view(&value) == "Hello great\u{4e8c}wonderful world" _ => false },
    "the menu's Copy copies the selection",
  )
}

test effect fn textInputImeAndClipboardThroughTheAdapter() -> ()
  ! AssertionError<'static>
    | TreeError
    | WindowError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run editingBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Drains the queue so only pushed events follow.
effect fn drain(platform: &mut HeadlessPlatform) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  while true {
    match move run platform.nextEvent(Wait.Poll) {
      Option<Event>.Some { value } => {
        drop value
      }
      Option<Event>.None => {
        break
      }
    }
  }
}

effect fn coalesceBody() -> ()
  ! AssertionError<'static> | WindowError | OutOfMemoryError
  ? &mut Allocator {
  let mut platform = run HeadlessPlatform.start()
  let window = run platform.openWindow(&WindowOptions.make("coalesce", 200.0, 200.0))
  run drain(&mut platform)
  let none = Modifiers.none()
  run platform.push(Event.MouseMoved { window: window, position: at(1.0, 1.0), modifiers: none })
  run platform.push(Event.MouseMoved { window: window, position: at(2.0, 2.0), modifiers: none })
  run platform.push(Event.MouseMoved { window: window, position: at(3.0, 4.0), modifiers: none })
  run platform.push(
    Event.Scroll {
      window: window,
      position: at(5.0, 5.0),
      delta: ScrollDelta.Points { delta: Vector2<f64> { x: 0.0, y: -10.0 } },
      phase: Phase.Changed,
      modifiers: none,
    },
  )
  run platform.push(
    Event.Scroll {
      window: window,
      position: at(6.0, 6.0),
      delta: ScrollDelta.Points { delta: Vector2<f64> { x: 1.0, y: -15.0 } },
      phase: Phase.Changed,
      modifiers: none,
    },
  )
  run platform.push(
    Event.Scroll {
      window: window,
      position: at(6.0, 6.0),
      delta: ScrollDelta.Points { delta: Vector2<f64> { x: 0.0, y: 0.0 } },
      phase: Phase.Ended,
      modifiers: none,
    },
  )
  let mut backlog = List<Event>.make()
  let first = match move run platform.nextEvent(Wait.Poll) {
    Option<Event>.Some { value } => move value
    Option<Event>.None => Event.QuitRequested
  }
  let moved = run coalesce(&mut platform, move first, &mut backlog)
  let lastMove = match &moved {
    Event.MouseMoved { position, .. } => position.x == 3.0 && position.y == 4.0
    _ => false
  }
  run Testing.expect(lastMove, "three queued moves fold into the last one")
  let next = if backlog.length() != 0 {
    backlog.remove(0)
  } else {
    Event.QuitRequested
  }
  let scrolled = run coalesce(&mut platform, move next, &mut backlog)
  let summed = match &scrolled {
    Event.Scroll { position, delta, .. } => match delta {
      ScrollDelta.Points { delta: d } => d.x == 1.0 && d.y == -25.0 && position.x == 6.0
      _ => false
    }
    _ => false
  }
  run Testing.expect(summed, "two scrolls in one phase sum their deltas")
  let ended = backlog.length() == 1 && match &backlog.asSlice()[0] {
    Event.Scroll { phase, .. } => phase == Phase.Ended
    _ => false
  }
  run Testing.expect(ended, "the gesture's end is kept for the next pass")
  backlog.clear()

  // Moves that queued up between frame requests, as when frames are slower than the pointer:
  // one move and one request are left, not a move and a frame for each.
  let mut x: f64 = 10.0
  while x < 14.0 {
    run platform.push(Event.MouseMoved { window: window, position: at(x, 1.0), modifiers: none })
    run platform.push(Event.RequestFrame { window: window, targetTime: x })
    x = x + 1.0
  }
  run platform.push(Event.MouseMoved { window: window, position: at(20.0, 1.0), modifiers: none })
  run platform.push(Event.MouseDown {
    window: window,
    button: MouseButton.Left,
    position: at(20.0, 1.0),
    modifiers: none,
    clickCount: 1,
  })
  run platform.push(Event.MouseMoved { window: window, position: at(30.0, 1.0), modifiers: none })
  let head = match move run platform.nextEvent(Wait.Poll) {
    Option<Event>.Some { value } => move value
    Option<Event>.None => Event.QuitRequested
  }
  let now = run coalesce(&mut platform, move head, &mut backlog)
  let frame = match &now {
    Event.RequestFrame { targetTime, .. } => targetTime == 13.0
    _ => false
  }
  run Testing.expect(frame, "the last frame request stands for the four")
  let after = match &backlog.asSlice()[0] {
    Event.MouseMoved { position, .. } => position.x == 20.0
    _ => false
  }
  run Testing.expect(after && backlog.length() == 3, "then the last move before the press")
  let press = match &backlog.asSlice()[1] {
    Event.MouseDown { .. } => true
    _ => false
  }
  run Testing.expect(press, "a press is never folded over")
  backlog.clear()

  // Queued resizes and window moves fold to the latest, and supersede older frame requests.
  run platform.push(Event.Resized { window: window, size: Size2<f64>.new(300.0, 200.0), scaleFactor: 2.0 })
  run platform.push(Event.Moved { window: window, position: at(10.0, 20.0) })
  run platform.push(Event.RequestFrame { window: window, targetTime: 1.0 })
  run platform.push(Event.Resized { window: window, size: Size2<f64>.new(400.0, 250.0), scaleFactor: 2.0 })
  run platform.push(Event.Moved { window: window, position: at(15.0, 25.0) })
  run platform.push(Event.Resized { window: window, size: Size2<f64>.new(500.0, 300.0), scaleFactor: 2.0 })
  let resizeHead = match move run platform.nextEvent(Wait.Poll) {
    Option<Event>.Some { value } => move value
    Option<Event>.None => Event.QuitRequested
  }
  let firstOut = run coalesce(&mut platform, move resizeHead, &mut backlog)
  let movedLast = match &firstOut {
    Event.Moved { position, .. } => position.x == 15.0 && position.y == 25.0
    _ => false
  }
  let resizedLast = backlog.length() == 1 && match &backlog.asSlice()[0] {
    Event.Resized { size, .. } => size.width == 500.0 && size.height == 300.0
    _ => false
  }
  run Testing.expect(movedLast && resizedLast, "queued resizes, moves, and stale frames fold to the latest")
  drop firstOut
  drop now
  drop moved
  drop scrolled
}

test effect fn queuedPointerAndWheelEventsCoalesce() -> ()
  ! AssertionError<'static> | WindowError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run coalesceBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
