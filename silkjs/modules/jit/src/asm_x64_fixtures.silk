effect fn backwardEdgeProgram() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  let mut labels = List<Label>.make()
  while labels.length() < 2 { let label = run a.label() run labels.append(label) }
  a.bind(labels.get(0))
  run nops(&mut a, 126)
  run a.jmp(labels.get(0))
  a.bind(labels.get(1))
  run nops(&mut a, 127)
  run a.jcc(Cond.Greater, labels.get(1))
  run a.ret()
  return run a.finish()
}

