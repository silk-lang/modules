//! Decodes the file named by ZIN into the file named by ZOUT with `decode.decompressStream`.
//!
//! ZINCHUNK and ZOUTCHUNK set how many bytes of input and of output room each call gets (default:
//! everything, and 16384). ZTRACE prints each call's positions and result. ZDICT names a dictionary file, ZWLM sets ZSTD_d_windowLogMax, ZREPEAT
//! decodes the input that many times for timing. It prints the sizes, the microseconds of the last
//! run, and on failure the error code and message, and exits with 1.
import zstd.decode
import zstd.errors
import zstd.mem
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.num.i32
import silk.num.i64

unsafe extern "C" fn getenv(name: ?[*]const u8) -> ?[*]const u8
unsafe extern "C" fn fopen(path: ?[*]const u8, mode: ?[*]const u8) -> ?*mut u8
unsafe extern "C" fn fread(data: ?[*]mut u8, size: usize, count: usize, file: ?*mut u8) -> usize
unsafe extern "C" fn fwrite(data: ?[*]const u8, size: usize, count: usize, file: ?*mut u8) -> usize
unsafe extern "C" fn fclose(file: ?*mut u8) -> i32
unsafe extern "C" fn atol(text: ?[*]const u8) -> i64
unsafe extern "C" fn clock() -> i64
unsafe extern "C" fn printf(format: ?[*]const u8, a: usize, b: usize, c: usize, d: usize, e: usize) -> i32

fn code(value: usize) -> usize { return i32.toUsize(errors.code(value)) }
fn where(value: ?[*]const u8) -> usize { return Pointer.addressMany<u8>(value) }

fn text(literal: &[u8]) -> ?[*]const u8 { return Pointer.fromSlice<u8>(literal) }

unsafe fn number(name: &[u8], fallback: usize) -> usize {
  let value = unsafe getenv(text(name))
  if Pointer.isNullMany<u8>(value) { return fallback }
  return i64.toUsize(unsafe atol(value))
}

unsafe fn readFile(name: ?[*]const u8, length: &mut usize) -> ?[*]mut u8 {
  let capacity: usize = 2147483648
  let buffer = unsafe mem.malloc(capacity)
  let file = unsafe fopen(name, text(b"rb\0"))
  if Pointer.isNull<u8>(file) { length.* = 0 return buffer }
  length.* = unsafe fread(buffer, 1, capacity, file)
  let _c = unsafe fclose(file)
  return buffer
}

pub fn main() -> i32 {
  let mut inputLength: usize = 0
  let input = unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]const u8>(unsafe readFile(unsafe getenv(text(b"ZIN\0")), &mut inputLength))
  let capacity: usize = 4294967296
  let output = unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(unsafe mem.malloc(capacity))
  let inChunk = unsafe number(b"ZINCHUNK\0", inputLength + 1)
  let outChunk = unsafe number(b"ZOUTCHUNK\0", 16384)
  let repeat = unsafe number(b"ZREPEAT\0", 1)
  let windowLogMax = unsafe number(b"ZWLM\0", 0)
  let trace = !Pointer.isNullMany<u8>(unsafe getenv(text(b"ZTRACE\0")))
  let stream = unsafe decode.createDStream()
  if windowLogMax != 0 {
    let set = unsafe decode.dctxSetParameter(stream, 100, usize.toI32(windowLogMax))
    if errors.isError(set) {
      let _p = unsafe printf(text(b"parameter error %zu: %s\n\0"), code(set), where(errors.name(set)), 0, 0, 0)
      return 1
    }
  }
  let dictName = unsafe getenv(text(b"ZDICT\0"))
  if !Pointer.isNullMany<u8>(dictName) {
    let mut dictLength: usize = 0
    let dict = unsafe readFile(dictName, &mut dictLength)
    let loaded = unsafe decode.dctxLoadDictionary(stream, unsafe Intrinsic.pointerRequalify<?[*]mut u8, ?[*]const u8>(dict), dictLength)
    if errors.isError(loaded) {
      let _p = unsafe printf(text(b"dictionary error %zu: %s\n\0"), code(loaded), where(errors.name(loaded)), 0, 0, 0)
      return 1
    }
  }
  let mut written: usize = 0
  let mut elapsed: i64 = 0
  let mut round: usize = 0
  let mut last: usize = 0
  while round < repeat {
    let _r = unsafe decode.dctxReset(stream, 1)
    let start = unsafe clock()
    let mut inPos: usize = 0
    let mut outPos: usize = 0
    let mut inLimit: usize = 0
    last = 0
    while true {
      if inPos == inLimit {
        inLimit = inLimit + inChunk
        if inLimit > inputLength { inLimit = inputLength }
      }
      let mut outLimit = outPos + outChunk
      if outLimit > capacity { outLimit = capacity }
      let beforeIn = inPos
      let beforeOut = outPos
      last = unsafe decode.decompressStream(stream, output, outLimit, &mut outPos, input, inLimit, &mut inPos)
      if trace {
        let mut shown = last
        if errors.isError(last) { shown = usize.wrappingSubtract(0, i32.toUsize(errors.code(last))) }
        let _t = unsafe printf(text(b"call in %zu->%zu out %zu->%zu ret %zu\n\0"), beforeIn, inPos, beforeOut, outPos, shown)
      }
      if errors.isError(last) { break }
      if inPos == inputLength && outPos < outLimit && beforeIn == inPos && beforeOut == outPos { break }
      if inPos == inputLength && last == 0 { break }
    }
    elapsed = unsafe clock() - start
    written = outPos
    round = round + 1
  }
  if errors.isError(last) {
    let _p = unsafe printf(text(b"error %zu after %zu bytes (usec %zu): %s\n\0"), code(last), written, i64.toUsize(elapsed), where(errors.name(last)), 0)
  } else {
    let _p = unsafe printf(text(b"in %zu out %zu usec %zu\n\0"), inputLength, written, i64.toUsize(elapsed), 0, 0)
    if last != 0 { let _q = unsafe printf(text(b"unfinished: hint %zu\n\0"), last, 0, 0, 0, 0) }
  }
  let out = unsafe fopen(unsafe getenv(text(b"ZOUT\0")), text(b"wb\0"))
  if !Pointer.isNull<u8>(out) {
    let _w = unsafe fwrite(unsafe Intrinsic.pointerRequalify<[*]mut u8, ?[*]const u8>(output), 1, written, out)
    let _d = unsafe fclose(out)
  }
  if errors.isError(last) || last != 0 { return 1 }
  return 0
}
