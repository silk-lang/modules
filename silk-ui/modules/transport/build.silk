import silk.build.plan { Framework, Plan }

// Links macOS CoreFoundation on Darwin so `pthread_set_qos_class_self_np` binds against the SDK's
// libSystem instead of Silk's minimal SDK-free libSystem stub. Other targets need nothing here.
static fn plan() -> Plan {
  let mut plan = Plan.empty()
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("CoreFoundation", Framework.make())
  }
  return plan
}

pub const PLAN: Plan = plan()
