//! Computed styles: the base look of a node with its active variants applied over it, and text
//! properties inherited from the parent. The layout part is a css-layout `Style`, written as
//! each declaration is applied; paint and text are css-properties' computed structs.
import mutation { Declaration, Value, Keyword, CssProperty, Cursor }
import layout.lib {
  Style as CssStyle,
  SizeContainment,
  Edges,
  Dimension,
  SizeValue,
  DimensionKind,
  Overflow,
  TextWrap,
  WhiteSpaceCollapse,
  Visibility,
  TableLayout,
  BorderCollapse,
  CaptionSide,
}
pub import properties.computed { Text as TextStyle, Paint, Fill, DisplayOutside, DisplayInside }
import properties.computed { Display, Bounds, EmphasisSide }
import svg_css.counter_styles
import properties.computed { BorderStyle, DecorationLine, WhiteSpace, ObjectFit, Position }
import properties.computed { WritingMode, Direction, VerticalAlignKind, TextWrapStyle, WrapFlow, WrapThrough }
import properties.convert { Context }
import timing { TransitionLists, AnimationLists }
import transform { Transform }
import properties.values { Unit, Separator, MathOperator }
import properties.convert
import properties.keyword_enums
import paint_css
import css_cursor { cursorOf, textCursor, textHasUrl }
import anchor_style { AnchorStyle }
import properties.keywords
import silk.collections.hash { Hash, HashSeed }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.ownership { Copy }
import silk.core.equal { Equal }
import silk.geometry.insets { Insets }
import silk.geometry.corners { Corners }
import silk.geometry.rect { Rect }
import silk.num.f32
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.u64

// Opacity percentages are numbers with a 100% basis, including inside math functions.
fn alpha(value: &Value) -> Option<f32> {
  match &value.* {
    Value.Unit { value: amount, unit } => {
      if unit == Unit.Number { return Option<f32>.some(amount) }
      if unit == Unit.Percent { return Option<f32>.some(amount / 100.0) }
    }
    Value.Math { operator, values } => {
      let items = values.asSlice()
      if items.length == 0 { return Option<f32>.None }
      let mut total = match alpha(&items[0]) { Option.Some { value: found } => found _ => { return Option<f32>.None } }
      if operator == MathOperator.Negate { return Option<f32>.some(0.0 - total) }
      if operator == MathOperator.Invert {
        return if total == 0.0 { Option<f32>.None } else { Option<f32>.some(1.0 / total) }
      }
      if operator == MathOperator.Clamp {
        if items.length != 3 { return Option<f32>.None }
        let preferred = match alpha(&items[1]) { Option.Some { value: found } => found _ => { return Option<f32>.None } }
        let maximum = match alpha(&items[2]) { Option.Some { value: found } => found _ => { return Option<f32>.None } }
        return Option<f32>.some(f32.max(total, f32.min(preferred, maximum)))
      }
      let mut i: usize = 1
      while i < items.length {
        let next = match alpha(&items[i]) { Option.Some { value: found } => found _ => { return Option<f32>.None } }
        total = match operator {
          MathOperator.Sum => total + next
          MathOperator.Product => total * next
          MathOperator.Min => f32.min(total, next)
          MathOperator.Max => f32.max(total, next)
          _ => { return Option<f32>.None }
        }
        i = i + 1
      }
      return Option<f32>.some(total)
    }
    _ => {}
  }
  return Option<f32>.None
}

/// A node's computed style.
pub struct Computed {
  /// What css-layout reads. The inherited text properties and the border widths reach it in
  /// [`Computed.finish`].
  pub layout: CssStyle,
  /// What only the tree paints. `paint.border` holds the widths as set; `border-style: none`
  /// lays out as zero.
  pub paint: Paint,
  pub text: TextStyle,
  pub effects: EffectState,
  /// The viewport that `vw`, `vh` and the other viewport units resolve against.
  pub viewportWidth: f32,
  pub viewportHeight: f32,
  /// A declaration used a viewport unit, so the style changes when the viewport does.
  pub usesViewport: bool,
  pub containerWidth: Option<f32>,
  pub containerHeight: Option<f32>,
  pub usesContainer: bool,
  /// The `transition-*` lists.
  pub transition: TransitionLists,
  /// The `animation-*` lists.
  pub animation: AnimationLists,
  /// `transform`, `translate`, `rotate`, `scale`, their origin, `perspective` and its origin.
  pub transform: Transform,
  /// `z-index`: `zIndex` counts only when `zAuto` is false. It applies to positioned boxes and
  /// to flex and grid items (see `stacking`).
  pub zIndex: i32,
  pub zAuto: bool,
  /// `image-rendering: pixelated` or `crisp-edges` (inherits): bitmaps scale by nearest texel.
  pub nearest: bool,
  /// `empty-cells: hide`: an empty cell of a table with separate borders paints no
  /// background or border. It inherits.
  pub emptyCellsHide: bool,
  /// `accent-color`: native form-control highlight color (inherits).
  pub accentColor: Rgba<f32>,
  pub hasAccentColor: bool,
  /// `appearance: none`: suppresses native form-control painting.
  pub appearanceNone: bool,
  pub list: ListStyle,
  pub outline: Outline,
  pub columnRule: ColumnRule,
  pub scroll: ScrollStyle,
  /// The CSS `cursor`, when the node sets one other than `auto`. Hovering finds it on the
  /// node or the nearest ancestor that sets one, as inheritance would.
  pub cursor: Option<Cursor>,
  /// `cursor` lists images before its keyword, read back from the declaration on hover
  /// (`css_cursor`).
  pub cursorUrl: bool,
  pub contain: Containment,
  /// Anchor positioning: names, `anchor()` insets, `position-area` (see `anchor_style`).
  pub anchor: AnchorStyle,
  /// `user-select`: the declared keyword while the cascade runs, the used value after it
  /// (see `usedUserSelect`). One of the `SELECT_` constants.
  pub userSelect: u8,
  /// `app-region` (`-webkit-app-region`): one of the `REGION_` constants. It does not inherit;
  /// a press finds the nearest ancestor-or-self that sets one (see `appRegionAt`).
  pub appRegion: u8,
  /// `fill`, `stroke` and `stroke-width` from page CSS, which an inline `<svg>` draws with over
  /// its root's presentation attributes. They inherit.
  pub svg: SvgPaint,
}

impl Copy for Computed {}

/// A paint `SvgPaint` has not got: the markup's own applies.
pub const PAINT_UNSET: u8 = 0
pub const PAINT_NONE: u8 = 1
pub const PAINT_CURRENT: u8 = 2
pub const PAINT_COLOR: u8 = 3

/// SVG paint properties as CSS sets them, colors as RGBA8 (red in the high byte).
pub struct SvgPaint {
  pub fillKind: u8,
  pub strokeKind: u8,
  pub fill: u32,
  pub stroke: u32,
  /// In user units; negative when unset.
  pub strokeWidth: f32,
}

impl Copy for SvgPaint {}

impl SvgPaint {
  pub fn initial() -> SvgPaint {
    return SvgPaint { fillKind: PAINT_UNSET, strokeKind: PAINT_UNSET, fill: 0, stroke: 0, strokeWidth: -1.0 }
  }

  pub fn isSet(self: &Self) -> bool {
    return self.fillKind != PAINT_UNSET || self.strokeKind != PAINT_UNSET || self.strokeWidth >= 0.0
  }

  /// A key for drawings of the same markup in this paint; 0 when unset.
  pub fn key(self: &Self) -> u64 {
    if !self.isSet() { return 0 }
    let mut h = Hash.combine(u8.toU64(self.fillKind) * 4 + u8.toU64(self.strokeKind), u32.toU64(self.fill))
    h = Hash.combine(h, u32.toU64(self.stroke))
    h = floatHash(h, self.strokeWidth)
    return if h == 0 { 1 } else { h }
  }
}

impl SvgPaint {
  /// The declarations for an SVG root's style, such as `fill:#ff0000ff;stroke-width:1.5;`.
  pub effect fn css(self: &Self) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
    let mut out = List<u8>.make()
    run paintCss(&mut out, b"fill:", self.fillKind, self.fill)
    run paintCss(&mut out, b"stroke:", self.strokeKind, self.stroke)
    if self.strokeWidth >= 0.0 {
      run out.appendSlice(b"stroke-width:")
      let thousandths = f32.toU64(f32.min(self.strokeWidth, 1000000.0) * 1000.0 + 0.5)
      run decimal(&mut out, thousandths / 1000)
      run out.append(46)
      let fraction = thousandths % 1000
      run out.append(u64.toU8(48 + fraction / 100))
      run out.append(u64.toU8(48 + (fraction / 10) % 10))
      run out.append(u64.toU8(48 + fraction % 10))
      run out.append(59)
    }
    return move out
  }
}

effect fn paintCss(out: &mut List<u8>, name: &[u8], kind: u8, color: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  if kind == PAINT_UNSET { return () }
  run out.appendSlice(name)
  if kind == PAINT_NONE {
    run out.appendSlice(b"none")
  } else if kind == PAINT_CURRENT {
    run out.appendSlice(b"currentColor")
  } else {
    run out.append(35)
    let digits = b"0123456789abcdef"
    let mut shift: u32 = 28
    let mut more = true
    while more {
      run out.append(digits[u32.toUsize(u32.bitAnd(u32.shiftRight(color, shift), 15))])
      if shift == 0 { more = false } else { shift = shift - 4 }
    }
  }
  run out.append(59)
}

effect fn decimal(out: &mut List<u8>, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run decimal(&mut out, value / 10) }
  run out.append(u64.toU8(48 + value % 10))
}

// A paint value: `none`, `currentColor` or a color. `url()` paints keep the markup's.
fn setPaint(kind: &mut u8, color: &mut u32, value: &Value) -> () {
  if convert.isKeyword(value, Keyword.None) {
    kind.* = PAINT_NONE
  } else if convert.isKeyword(value, Keyword.Currentcolor) {
    kind.* = PAINT_CURRENT
  } else if let Option.Some { value: found } = convert.color(value) {
    kind.* = PAINT_COLOR
    color.* = packColor(found)
  }
}

pub const SELECT_AUTO: u8 = 0
pub const SELECT_TEXT: u8 = 1
pub const SELECT_NONE: u8 = 2
pub const SELECT_ALL: u8 = 3
/// Selectable like `text`, and a scope that select-all and drags started inside stay in.
pub const SELECT_CONTAIN: u8 = 4

pub const REGION_NONE: u8 = 0
pub const REGION_DRAG: u8 = 1
pub const REGION_NO_DRAG: u8 = 2

/// The used `user-select` (CSS UI 4 §6.1) of a node declaring `declared` under a parent whose
/// used value is `parent`: `auto` takes `none` and `all` from the parent and is `text`
/// otherwise. Inputs keep their own selection, so `auto` there is a contain scope.
pub fn usedUserSelect(declared: u8, parent: u8, input: bool) -> u8 {
  if declared != SELECT_AUTO { return declared }
  if input { return SELECT_CONTAIN }
  if parent == SELECT_NONE || parent == SELECT_ALL { return parent }
  return SELECT_TEXT
}

/// `display: list-item`, `list-style-type` and `list-style-position`, and whether the node
/// changes counters, in one byte. Type and position inherit (copied in the engine's
/// `resolve`); the other two bits do not. A string type is read back from the declarations.
pub struct ListStyle { bits: u8 }

impl Copy for ListStyle {}

impl Equal for ListStyle {
  fn equals(left: &ListStyle, right: &ListStyle) -> bool { return left.bits == right.bits }
}

const LIST_TYPE: u8 = 15
/// `list-style-type: <string>`, after the counter styles' codes.
pub const LIST_STRING: u8 = 13
/// `list-style-type: none`.
pub const LIST_NONE: u8 = 12
const LIST_INSIDE: u8 = 16
const LIST_ITEM: u8 = 32
const LIST_COUNTERS: u8 = 64

impl ListStyle {
  pub fn initial() -> ListStyle { return ListStyle { bits: 0 } }
  /// The counter style's code (`counter_styles.CounterStyle` order), or LIST_STRING.
  pub fn typeCode(self: &Self) -> u8 { return u8.bitAnd(self.bits, LIST_TYPE) }
  pub fn inside(self: &Self) -> bool { return u8.bitAnd(self.bits, LIST_INSIDE) != 0 }
  pub fn item(self: &Self) -> bool { return u8.bitAnd(self.bits, LIST_ITEM) != 0 }
  pub fn counters(self: &Self) -> bool { return u8.bitAnd(self.bits, LIST_COUNTERS) != 0 }
  /// The inherited part of the parent's list style.
  pub fn inherited(parent: ListStyle) -> ListStyle { return ListStyle { bits: u8.bitAnd(parent.bits, u8.bitOr(LIST_TYPE, LIST_INSIDE)) } }
  fn flag(self: &mut Self, bit: u8, on: bool) { self.bits = if on { u8.bitOr(self.bits, bit) } else { u8.bitAnd(self.bits, u8.bitNot(bit)) } }
  fn setType(self: &mut Self, code: u8) { self.bits = u8.bitOr(u8.bitAnd(self.bits, u8.bitNot(LIST_TYPE)), code) }
}

// A keyword value's name, whether the catalog knows it as a keyword or not.
fn wordOf<'a>(value: &'a Value) -> Option<&'a [u8]> {
  return match &value.* {
    Value.Keyword { value: word } => Option<&[u8]>.some(keywords.name(word))
    Value.Text { css } => Option<&[u8]>.some(Bytes.asSlice(&css))
    _ => Option<&[u8]>.None
  }
}

fn keywordNamed(word: &[u8], name: &[u8]) -> bool {
  if word.length != name.length { return false }
  let mut index: usize = 0
  while index < word.length {
    let mut byte = word[index]
    if byte >= 65 && byte <= 90 { byte = byte + 32 }
    if byte != name[index] { return false }
    index = index + 1
  }
  return true
}

// CSS Exclusions 1 §3.1.
fn wrapFlowOf(value: &Value) -> Option<WrapFlow> {
  match wordOf(value) {
    Option.Some { value: word } => {
      if keywordNamed(word, b"auto") { return Option<WrapFlow>.some(WrapFlow.Auto) }
      if keywordNamed(word, b"both") { return Option<WrapFlow>.some(WrapFlow.Both) }
      if keywordNamed(word, b"start") { return Option<WrapFlow>.some(WrapFlow.Start) }
      if keywordNamed(word, b"end") { return Option<WrapFlow>.some(WrapFlow.End) }
      if keywordNamed(word, b"minimum") { return Option<WrapFlow>.some(WrapFlow.Minimum) }
      if keywordNamed(word, b"maximum") { return Option<WrapFlow>.some(WrapFlow.Maximum) }
      if keywordNamed(word, b"clear") { return Option<WrapFlow>.some(WrapFlow.Clear) }
    }
    Option.None => {}
  }
  return Option<WrapFlow>.None
}

fn listTypeOf(value: &Value) -> Option<u8> {
  return match &value.* {
    Value.Keyword { value: word } => listTypeNamed(keywords.name(word))
    Value.Text { css } => listTypeNamed(Bytes.asSlice(&css))
    _ => Option<u8>.None
  }
}

fn listTypeNamed(name: &[u8]) -> Option<u8> {
  if name.length > 0 && (name[0] == 34 || name[0] == 39) { return Option<u8>.some(LIST_STRING) }
  return match counter_styles.named(name) {
    Option.Some { value: style } => Option<u8>.some(counter_styles.code(style))
    _ => Option<u8>.None
  }
}

/// `container-type`, `contain` and `content-visibility`, in one byte (the record is copied for
/// every restyled node). css-layout reads the union of the two size containments, in
/// `layout.sizeContainment`; container queries read only `query`.
pub struct Containment {
  bits: u8,
  /// `content-visibility: auto`: the contents are laid out only near the viewport.
  autoVisible: bool,
  /// The block size `contain-intrinsic-size` gives a skipped box before it was laid out, in
  /// px; negative for none.
  intrinsic: f32,
}

impl Copy for Containment {}

struct Contained { size: SizeContainment, paint: bool, layout: bool, style: bool }
impl Copy for Contained {}

const QUERY_SHIFT: u8 = 0
const CONTAIN_SHIFT: u8 = 2
const CONTAIN_PAINT: u8 = 16
const HIDDEN: u8 = 32
const CONTAIN_LAYOUT: u8 = 64
const CONTAIN_STYLE: u8 = 128

fn sizeCode(size: SizeContainment) -> u8 {
  return if size == SizeContainment.Size { 2 } else if size == SizeContainment.InlineSize { 1 } else { 0 }
}

fn sizeOfCode(code: u8) -> SizeContainment {
  return if code == 2 { SizeContainment.Size } else if code == 1 { SizeContainment.InlineSize } else { SizeContainment.None }
}

impl Containment {
  pub fn initial() -> Containment { return Containment { bits: 0, autoVisible: false, intrinsic: -1.0 } }

  /// The size containment `container-type` asks for.
  pub fn query(self: &Self) -> SizeContainment { return sizeOfCode(u8.bitAnd(u8.shiftRight(self.bits, QUERY_SHIFT), 3)) }

  /// Paint containment, from `contain` or `content-visibility: hidden`.
  pub fn paint(self: &Self) -> bool { return self.autoVisible || u8.bitAnd(self.bits, u8.bitOr(CONTAIN_PAINT, HIDDEN)) != 0 }

  /// Layout containment, from `contain` or `content-visibility: hidden`.
  pub fn layout(self: &Self) -> bool { return self.autoVisible || u8.bitAnd(self.bits, u8.bitOr(CONTAIN_LAYOUT, HIDDEN)) != 0 }

  /// Style containment: counters changed inside stay inside.
  pub fn style(self: &Self) -> bool { return self.autoVisible || u8.bitAnd(self.bits, u8.bitOr(CONTAIN_STYLE, HIDDEN)) != 0 }

  /// `content-visibility: hidden`: the contents are skipped like `display: none`.
  pub fn hidden(self: &Self) -> bool { return u8.bitAnd(self.bits, HIDDEN) != 0 }

  /// `content-visibility: auto`: far from the viewport, the contents are skipped and the box
  /// keeps the size it had (see `skipped` in layout_table.silk).
  pub fn automatic(self: &Self) -> bool { return self.autoVisible }

  /// The block size a skipped box takes before it was ever laid out, in px.
  pub fn intrinsicBlock(self: &Self) -> f32 { return if self.intrinsic < 0.0 { 0.0 } else { self.intrinsic } }

  pub fn setIntrinsic(self: &mut Self, value: f32) -> () { self.intrinsic = value }

  fn contained(self: &Self) -> Contained {
    return Contained {
      size: sizeOfCode(u8.bitAnd(u8.shiftRight(self.bits, CONTAIN_SHIFT), 3)), paint: u8.bitAnd(self.bits, CONTAIN_PAINT) != 0,
      layout: u8.bitAnd(self.bits, CONTAIN_LAYOUT) != 0, style: u8.bitAnd(self.bits, CONTAIN_STYLE) != 0,
    }
  }

  fn write(self: &mut Self, query: SizeContainment, contain: Contained, hidden: bool, layout: &mut CssStyle) -> () {
    let size = if hidden { SizeContainment.Size } else { contain.size }
    let mut bits = u8.bitOr(u8.shiftLeft(sizeCode(query), QUERY_SHIFT), u8.shiftLeft(sizeCode(contain.size), CONTAIN_SHIFT))
    if contain.paint { bits = u8.bitOr(bits, CONTAIN_PAINT) }
    if contain.layout { bits = u8.bitOr(bits, CONTAIN_LAYOUT) }
    if contain.style { bits = u8.bitOr(bits, CONTAIN_STYLE) }
    if hidden { bits = u8.bitOr(bits, HIDDEN) }
    self.bits = bits
    layout.layoutContainment = hidden || self.autoVisible || contain.paint || contain.layout
    layout.sizeContainment = if query == SizeContainment.Size || size == SizeContainment.Size {
      SizeContainment.Size
    } else if query == SizeContainment.InlineSize || size == SizeContainment.InlineSize {
      SizeContainment.InlineSize
    } else {
      SizeContainment.None
    }
  }

  pub fn setQuery(self: &mut Self, query: SizeContainment, layout: &mut CssStyle) -> () {
    let contain = self.contained()
    let hidden = self.hidden()
    self.write(query, contain, hidden, &mut layout)
  }

  fn setContain(self: &mut Self, contain: Contained, layout: &mut CssStyle) -> () {
    let query = self.query()
    let hidden = self.hidden()
    self.write(query, contain, hidden, &mut layout)
  }

  pub fn setHidden(self: &mut Self, hidden: bool, layout: &mut CssStyle) -> () {
    let query = self.query()
    let contain = self.contained()
    self.write(query, contain, hidden, &mut layout)
  }

  /// Sets `content-visibility`: `hidden`, `auto` (`automatic`) or visible (neither).
  pub fn setVisibility(self: &mut Self, hidden: bool, automatic: bool, layout: &mut CssStyle) -> () {
    self.autoVisible = automatic && !hidden
    self.setHidden(hidden, &mut layout)
  }

  pub fn inheritContain(self: &mut Self, parent: &Containment, layout: &mut CssStyle) -> () {
    let contain = parent.contained()
    self.setContain(contain, &mut layout)
  }
}

/// The blur of a `backdrop-filter` list such as Tailwind's `blur(40px) saturate(150%)`: its
/// `blur()` (the other functions are not drawn on the backdrop yet), 0 for a list without one.
/// Names the shared keywords lack (`saturate`) leave the list as text.
fn backdropBlurOf(value: &Value, context: &Context) -> Option<f32> {
  match &value.* {
    Value.Sequence { separator: Separator.Space, values } => {
      let items = values.asSlice()
      let mut i: usize = 0
      while i < items.length {
        if let Option<f32>.Some { value: found } = convert.blur(&items[i], context) {
          return Option<f32>.some(found)
        }
        i = i + 1
      }
      return Option<f32>.some(0.0)
    }
    Value.Text { css } => { return blurInText(Bytes.asSlice(&css), context) }
    _ => { return convert.blur(value, context) }
  }
}

/// The `blur(<number>px|em|rem)` in filter list text, 0 when the list has none.
fn blurInText(css: &[u8], context: &Context) -> Option<f32> {
  let name = b"blur("
  let mut at: usize = 0
  while at + name.length <= css.length {
    let mut matched = at == 0 || !(lower(css[at - 1]) >= 97 && lower(css[at - 1]) <= 122 || css[at - 1] == 45)
    let mut k: usize = 0
    while matched && k < name.length {
      matched = lower(css[at + k]) == name[k]
      k = k + 1
    }
    if matched {
      let mut i = at + name.length
      while i < css.length && css[i] == 32 { i = i + 1 }
      let mut amount: f32 = 0.0
      let mut digits: usize = 0
      while i < css.length && css[i] >= 48 && css[i] <= 57 {
        amount = amount * 10.0 + u8.toF32(css[i] - 48)
        i = i + 1
        digits = digits + 1
      }
      if i < css.length && css[i] == 46 {
        i = i + 1
        let mut place: f32 = 0.1
        while i < css.length && css[i] >= 48 && css[i] <= 57 {
          amount = amount + place * u8.toF32(css[i] - 48)
          place = place / 10.0
          i = i + 1
          digits = digits + 1
        }
      }
      if digits == 0 { return Option<f32>.None }
      let rest = css.length - i
      if rest >= 3 && lower(css[i]) == 114 && lower(css[i + 1]) == 101 && lower(css[i + 2]) == 109 {
        return Option<f32>.some(amount * context.rootFontSize)
      }
      if rest >= 2 && lower(css[i]) == 101 && lower(css[i + 1]) == 109 {
        return Option<f32>.some(amount * context.fontSize)
      }
      if rest >= 2 && lower(css[i]) == 112 && lower(css[i + 1]) == 120 {
        return Option<f32>.some(amount * context.zoom)
      }
      if rest >= 1 && css[i] == 41 && amount == 0.0 {
        return Option<f32>.some(0.0)
      }
      return Option<f32>.None
    }
    at = at + 1
  }
  return Option<f32>.some(0.0)
}

fn lower(byte: u8) -> u8 {
  return if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

/// `contain`'s keywords; `None` for a value that is not one.
fn containOf(value: &Value) -> Option<Contained> {
  let mut out = Contained { size: SizeContainment.None, paint: false, layout: false, style: false }
  if let Option<Keyword>.Some { value: word } = convert.keywordOf(value) {
    if word == Keyword.None { return Option<Contained>.some(out) }
    if !containWord(&mut out, word) { return Option<Contained>.None }
    return Option<Contained>.some(out)
  }
  if let Value.Sequence { separator: Separator.Space, values } = &value.* {
    let items = values.asSlice()
    let mut i: usize = 0
    while i < items.length {
      match convert.keywordOf(&items[i]) {
        Option.Some { value: word } => { if word == Keyword.None || !containWord(&mut out, word) { return Option<Contained>.None } }
        Option.None => { return Option<Contained>.None }
      }
      i = i + 1
    }
    return Option<Contained>.some(out)
  }
  return Option<Contained>.None
}

fn containWord(out: &mut Contained, word: Keyword) -> bool {
  if word == Keyword.Size || word == Keyword.Strict { out.size = SizeContainment.Size }
  if word == Keyword.InlineSize && out.size == SizeContainment.None { out.size = SizeContainment.InlineSize }
  if word == Keyword.Paint || word == Keyword.Strict || word == Keyword.Content { out.paint = true }
  if word == Keyword.Layout || word == Keyword.Strict || word == Keyword.Content { out.layout = true }
  if word == Keyword.Style || word == Keyword.Strict || word == Keyword.Content { out.style = true }
  return word == Keyword.Size || word == Keyword.InlineSize || word == Keyword.Paint || word == Keyword.Layout
    || word == Keyword.Style || word == Keyword.Strict || word == Keyword.Content
}

// Widest fields first: in declaration order the flags between them padded this to 40 bytes.
/// What a node's style says about its paint effects, which `paint_css` reads into the node.
pub struct EffectState {
  /// `paint_css.Effects.hash` of the node's effects.
  pub hash: u64,
  pub shadowHash: u64,
  /// The node whose `text-shadow` this one paints (it inherits), or `NO_SHADOW`.
  pub shadowFrom: u32,
  /// Whether the node's looks set a property `paint_css` reads.
  pub declared: bool,
  /// Whether `will-change` makes the box a stacking context.
  pub stacks: bool,
  /// Whether a corner radius has a percentage or a vertical radius of its own, which
  /// `paint_css.Effects` holds; `paint.radii` holds the horizontal length parts.
  pub radiusShare: bool,
  /// Whether the effects paint through a layer of their own (filter, clip, mask, blend mode),
  /// which makes the box a stacking context.
  pub layered: bool,
}

impl Copy for EffectState {}

/// `EffectState.shadowFrom` when no `text-shadow` applies.
pub const NO_SHADOW: u32 = 4294967295
fn viewportUnit(unit: Unit) -> bool {
  return unit == Unit.Vw || unit == Unit.Vh || unit == Unit.Vi || unit == Unit.Vb
    || unit == Unit.Vmin || unit == Unit.Vmax
    || unit == Unit.Svw || unit == Unit.Svh || unit == Unit.Svi || unit == Unit.Svb
    || unit == Unit.Svmin || unit == Unit.Svmax
    || unit == Unit.Lvw || unit == Unit.Lvh || unit == Unit.Lvi || unit == Unit.Lvb
    || unit == Unit.Lvmin || unit == Unit.Lvmax
    || unit == Unit.Dvw || unit == Unit.Dvh || unit == Unit.Dvi || unit == Unit.Dvb
    || unit == Unit.Dvmin || unit == Unit.Dvmax
}

/// Whether `value` has a viewport unit anywhere in it.
fn hasViewportUnit(value: &Value) -> bool {
  match &value.* {
    Value.Unit { value: _, unit } => {
      return viewportUnit(unit)
    }
    Value.Math { operator: _, values } => {
      return anyViewportUnit(values.asSlice())
    }
    Value.Function { name: _, values } => {
      return anyViewportUnit(values.asSlice())
    }
    Value.Sequence { separator: _, values } => {
      return anyViewportUnit(values.asSlice())
    }
    Value.Text { css } => {
      // A number followed by `v`, `sv`, `lv` or `dv` starts a viewport unit.
      let bytes = css.asSlice()
      let mut i: usize = 1
      while i < bytes.length {
        if (bytes[i] | 32) == 118 {
          let before = bytes[i - 1] | 32
          if isDigit(bytes[i - 1]) {
            return true
          }
          if i >= 2 && (before == 115 || before == 108 || before == 100) && isDigit(bytes[i - 2]) {
            return true
          }
        }
        i = i + 1
      }
      return false
    }
    _ => {
      return false
    }
  }
}

fn isDigit(byte: u8) -> bool {
  return byte >= 48 && byte <= 57
}

fn anyViewportUnit(items: &[Value]) -> bool {
  let mut i: usize = 0
  while i < items.length {
    if hasViewportUnit(&items[i]) {
      return true
    }
    i = i + 1
  }
  return false
}

/// `outline`: a ring `offset` outside the border box, drawn over the content.
// Flags last, so they share one word of padding.
pub struct Outline {
  pub width: f32,
  pub offset: f32,
  pub color: Rgba<f32>,
  pub style: BorderStyle,
  /// `outline-style: auto`, the platform focus ring.
  pub auto: bool,
  /// `outline-color: auto`: the focus ring color for an `auto` ring, the text color otherwise.
  pub colorAuto: bool,
}

impl Copy for Outline {}

impl Outline {
  pub fn initial() -> Outline {
    return Outline {
      width: 3.0,
      style: BorderStyle.None,
      auto: false,
      color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      colorAuto: true,
      offset: 0.0,
    }
  }

  /// Whether the ring draws: it has a style and a width.
  pub fn drawn(self: &Self) -> bool {
    return (self.auto || self.style != BorderStyle.None) && self.width > 0.0
  }
}

/// `column-rule`: a line drawn in the gap between two columns of a multi-column container.
pub struct ColumnRule {
  pub width: f32,
  pub style: BorderStyle,
  pub color: Rgba<f32>,
  /// `currentcolor`: the text color.
  pub current: bool,
}

impl Copy for ColumnRule {}

impl ColumnRule {
  pub fn initial() -> ColumnRule {
    return ColumnRule { width: 3.0, style: BorderStyle.None, color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }, current: true }
  }

  pub fn drawn(self: &Self) -> bool {
    return self.style != BorderStyle.None && self.width > 0.0
  }
}

/// `overscroll-behavior` per axis.
pub enum Overscroll {
  Auto,
  Contain,
  None,
}

impl Equal for Overscroll {
  fn equals(left: &Overscroll, right: &Overscroll) -> bool {
    return left.* == right.*
  }
}

/// What a scroll container does with scrolls: chaining, smooth programmatic scrolls, and the
/// scroll margin and padding `scrollIntoView` keeps clear.
pub struct ScrollStyle {
  pub overscrollX: Overscroll,
  pub overscrollY: Overscroll,
  /// `scroll-behavior: smooth`.
  pub smooth: bool,
  /// `overflow-anchor: none` (see `scroll_anchor`).
  pub anchorNone: bool,
  /// `scroll-snap-type` (container) and `scroll-snap-align`/`-stop` (item), packed: see `SNAP_*`.
  pub snap: u8,
  /// `scroll-margin` of the box, in pixels.
  pub margin: Insets<f32>,
  /// `scroll-padding` of the scroll container; `auto` is zero.
  pub padding: Edges,
  /// `scrollbar-color`, which inherits.
  pub colors: ScrollbarColors,
  /// `touch-action` as `TOUCH_*` bits: the gestures the tree may take for itself.
  pub touch: u8,
}

/// `scrollbar-color`, as two 8-bit RGBA words in one (it is copied with every computed style).
/// 0 is `auto`, the native thumb over no track; a set value has the lowest bit of the track's
/// alpha on, so `transparent transparent` stays apart from `auto`.
pub struct ScrollbarColors { word: u64 }

impl Copy for ScrollbarColors {}

impl ScrollbarColors {
  pub fn initial() -> ScrollbarColors { return ScrollbarColors { word: 0 } }

  pub fn of(thumb: Rgba<f32>, track: Rgba<f32>) -> ScrollbarColors {
    let both = u64.bitOr(u64.shiftLeft(u32.toU64(packColor(thumb)), 32), u32.toU64(packColor(track)))
    return ScrollbarColors { word: u64.bitOr(both, 1) }
  }

  pub fn auto(self: &Self) -> bool { return self.word == 0 }

  pub fn thumb(self: &Self) -> Rgba<f32> { return if self.word == 0 { NATIVE_THUMB } else { unpackColor(u64.toU32(u64.shiftRight(self.word, 32))) } }

  pub fn track(self: &Self) -> Rgba<f32> { return unpackColor(u64.toU32(u64.bitAnd(self.word, 0xFFFFFFFF))) }

  pub fn words(self: &Self) -> u64 { return self.word }
}

impl Equal for ScrollbarColors {
  fn equals(left: &ScrollbarColors, right: &ScrollbarColors) -> bool { return left.word == right.word }
}

fn channel(value: f32) -> u32 { return f32.toU32(f32.floor(f32.max(0.0, f32.min(1.0, value)) * 255.0 + 0.5)) }

fn packColor(c: Rgba<f32>) -> u32 {
  return u32.bitOr(u32.bitOr(u32.shiftLeft(channel(c.r), 24), u32.shiftLeft(channel(c.g), 16)), u32.bitOr(u32.shiftLeft(channel(c.b), 8), channel(c.a)))
}

fn unpackColor(word: u32) -> Rgba<f32> {
  let r = u32.bitAnd(u32.shiftRight(word, 24), 255)
  let g = u32.bitAnd(u32.shiftRight(word, 16), 255)
  let b = u32.bitAnd(u32.shiftRight(word, 8), 255)
  let a = u32.bitAnd(word, 255)
  return Rgba<f32> { r: u32.toF32(r) / 255.0, g: u32.toF32(g) / 255.0, b: u32.toF32(b) / 255.0, a: u32.toF32(a) / 255.0 }
}

pub const NATIVE_THUMB: Rgba<f32> = Rgba<f32> { r: 0.5, g: 0.5, b: 0.5, a: 0.6 }

impl Copy for ScrollStyle {}

impl ScrollStyle {
  pub fn initial() -> ScrollStyle {
    return ScrollStyle {
      overscrollX: Overscroll.Auto,
      overscrollY: Overscroll.Auto,
      smooth: false,
      anchorNone: false,
      snap: 0,
      margin: Insets<f32>.zero(),
      padding: Edges.all(Dimension.px(0.0)),
      colors: ScrollbarColors.initial(),
      touch: TOUCH_AUTO,
    }
  }
}

/// `ScrollStyle.snap` bits: the container's snapping axes and strictness, then the item's
/// alignment per axis (`SNAP_NONE` to `SNAP_END`) and `scroll-snap-stop: always`.
pub const SNAP_X: u8 = 1
pub const SNAP_Y: u8 = 2
pub const SNAP_MANDATORY: u8 = 4
pub const SNAP_STOP: u8 = 128
pub const SNAP_NONE: u8 = 0
pub const SNAP_START: u8 = 1
pub const SNAP_CENTER: u8 = 2
pub const SNAP_END: u8 = 3

impl ScrollStyle {
  /// Whether the box is a snap container on that axis.
  pub fn snapsX(self: &Self) -> bool { return u8.bitAnd(self.snap, SNAP_X) != 0 }
  pub fn snapsY(self: &Self) -> bool { return u8.bitAnd(self.snap, SNAP_Y) != 0 }
  pub fn snapMandatory(self: &Self) -> bool { return u8.bitAnd(self.snap, SNAP_MANDATORY) != 0 }
  /// The item's `scroll-snap-align` on that axis.
  pub fn alignX(self: &Self) -> u8 { return u8.bitAnd(u8.shiftRight(self.snap, 3), 3) }
  pub fn alignY(self: &Self) -> u8 { return u8.bitAnd(u8.shiftRight(self.snap, 5), 3) }
  /// The item's `scroll-snap-stop: always`.
  pub fn snapStop(self: &Self) -> bool { return u8.bitAnd(self.snap, SNAP_STOP) != 0 }

  fn setSnapType(self: &mut Self, bits: u8) -> () {
    self.snap = u8.bitOr(u8.bitAnd(self.snap, 248), bits)
  }

  fn setSnapAlign(self: &mut Self, x: u8, y: u8) -> () {
    self.snap = u8.bitOr(u8.bitAnd(self.snap, 135), u8.bitOr(u8.shiftLeft(x, 3), u8.shiftLeft(y, 5)))
  }

  fn setSnapStop(self: &mut Self, always: bool) -> () {
    self.snap = if always { u8.bitOr(self.snap, SNAP_STOP) } else { u8.bitAnd(self.snap, 127) }
  }
}

/// `ScrollStyle.touch` bits: the directions a touch may start panning in (`pan-left` is the
/// finger moving right, the content scrolling left) and `pinch-zoom`.
pub const TOUCH_PAN_LEFT: u8 = 1
pub const TOUCH_PAN_RIGHT: u8 = 2
pub const TOUCH_PAN_UP: u8 = 4
pub const TOUCH_PAN_DOWN: u8 = 8
pub const TOUCH_PINCH: u8 = 16
pub const TOUCH_PAN_X: u8 = 3
pub const TOUCH_PAN_Y: u8 = 12
/// `auto` and `manipulation`: every gesture (the tree has no double-tap zoom to leave out).
pub const TOUCH_AUTO: u8 = 31

fn touchWord(word: Keyword) -> u8 {
  return if word == Keyword.PanX { TOUCH_PAN_X }
    else if word == Keyword.PanLeft { TOUCH_PAN_LEFT }
    else if word == Keyword.PanRight { TOUCH_PAN_RIGHT }
    else if word == Keyword.PanY { TOUCH_PAN_Y }
    else if word == Keyword.PanUp { TOUCH_PAN_UP }
    else if word == Keyword.PanDown { TOUCH_PAN_DOWN }
    else if word == Keyword.PinchZoom { TOUCH_PINCH }
    else { 0 }
}

/// `touch-action`: `auto`, `none`, `manipulation`, or up to one horizontal pan word, one
/// vertical pan word and `pinch-zoom`, in any order.
fn touchActionOf(value: &Value) -> Option<u8> {
  if let Option<Keyword>.Some { value: word } = convert.keywordOf(value) {
    if word == Keyword.Auto || word == Keyword.Manipulation { return Option<u8>.some(TOUCH_AUTO) }
    if word == Keyword.None { return Option<u8>.some(0) }
    let bits = touchWord(word)
    return if bits == 0 { Option<u8>.None } else { Option<u8>.some(bits) }
  }
  if let Value.Sequence { separator: Separator.Space, values } = &value.* {
    let items = values.asSlice()
    if items.length > 3 { return Option<u8>.None }
    let mut bits: u8 = 0
    let mut i: usize = 0
    while i < items.length {
      let word = match convert.keywordOf(&items[i]) {
        Option.Some { value: found } => found
        Option.None => { return Option<u8>.None }
      }
      let one = touchWord(word)
      // Each group (horizontal, vertical, pinch) may be named once.
      let group: u8 = if u8.bitAnd(one, TOUCH_PAN_X) != 0 { TOUCH_PAN_X }
        else if u8.bitAnd(one, TOUCH_PAN_Y) != 0 { TOUCH_PAN_Y }
        else { one }
      if one == 0 || u8.bitAnd(bits, group) != 0 { return Option<u8>.None }
      bits = u8.bitOr(bits, one)
      i = i + 1
    }
    return Option<u8>.some(bits)
  }
  return Option<u8>.None
}

/// `scroll-snap-type`: `none`, or an axis and an optional strictness.
fn snapTypeOf(value: &Value) -> Option<u8> {
  let mut axis: u8 = 0
  let mut strict: u8 = 0
  let mut words: [Keyword; 2] = [Keyword.None; 2]
  let mut count: usize = 0
  if let Option<Keyword>.Some { value: word } = convert.keywordOf(value) {
    words[0] = word
    count = 1
  } else if let Value.Sequence { separator: Separator.Space, values } = &value.* {
    let items = values.asSlice()
    if items.length != 2 { return Option<u8>.None }
    let mut i: usize = 0
    while i < 2 {
      match convert.keywordOf(&items[i]) {
        Option.Some { value: word } => { words[i] = word }
        Option.None => { return Option<u8>.None }
      }
      i = i + 1
    }
    count = 2
  } else {
    return Option<u8>.None
  }
  let first = words[0]
  if first == Keyword.None { return if count == 1 { Option<u8>.some(0) } else { Option<u8>.None } }
  // Block and inline are y and x in horizontal writing modes.
  axis = if first == Keyword.X || first == Keyword.Inline { SNAP_X }
    else if first == Keyword.Y || first == Keyword.Block { SNAP_Y }
    else if first == Keyword.Both { u8.bitOr(SNAP_X, SNAP_Y) } else { 0 }
  if axis == 0 { return Option<u8>.None }
  if count == 2 {
    if words[1] == Keyword.Mandatory { strict = SNAP_MANDATORY } else if words[1] != Keyword.Proximity { return Option<u8>.None }
  }
  return Option<u8>.some(u8.bitOr(axis, strict))
}

fn snapAlignWord(word: Keyword) -> u8 {
  return if word == Keyword.None { SNAP_NONE } else if word == Keyword.Start { SNAP_START }
    else if word == Keyword.Center { SNAP_CENTER } else if word == Keyword.End { SNAP_END } else { 255 }
}

/// `scroll-snap-align`: one value for both axes, or the block (y) then the inline (x) one.
fn snapAlignOf(value: &Value) -> Option<[u8; 2]> {
  if let Option<Keyword>.Some { value: word } = convert.keywordOf(value) {
    let a = snapAlignWord(word)
    return if a == 255 { Option<[u8; 2]>.None } else { Option<[u8; 2]>.some([a, a]) }
  }
  if let Value.Sequence { separator: Separator.Space, values } = &value.* {
    let items = values.asSlice()
    if items.length != 2 { return Option<[u8; 2]>.None }
    let block = match convert.keywordOf(&items[0]) { Option.Some { value: word } => snapAlignWord(word) Option.None => 255 }
    let inline = match convert.keywordOf(&items[1]) { Option.Some { value: word } => snapAlignWord(word) Option.None => 255 }
    if block == 255 || inline == 255 { return Option<[u8; 2]>.None }
    return Option<[u8; 2]>.some([inline, block])
  }
  return Option<[u8; 2]>.None
}

impl ScrollStyle {
  /// The part of scrollport `rect` that `scroll-padding` leaves for revealed boxes.
  pub fn port(self: &Self, rect: Rect<f32>) -> Rect<f32> {
    let w = rect.width()
    let h = rect.height()
    let p = self.padding
    let x0 = rect.xMin + p.left.value + p.left.percent * w
    let x1 = rect.xMax - p.right.value - p.right.percent * w
    let y0 = rect.yMin + p.top.value + p.top.percent * h
    let y1 = rect.yMax - p.bottom.value - p.bottom.percent * h
    return Rect<f32>.new(x0, y0, f32.max(x0, x1), f32.max(y0, y1))
  }

  /// Border box `rect` grown by `scroll-margin`: what revealing the box brings into view.
  pub fn target(self: &Self, rect: Rect<f32>) -> Rect<f32> {
    let m = self.margin
    return Rect<f32>.new(rect.xMin - m.left, rect.yMin - m.top, rect.xMax + m.right, rect.yMax + m.bottom)
  }
}

fn overscrollOf(value: &Value) -> Option<Overscroll> {
  return match convert.keywordOf(value) {
    Option.Some { value: word } => {
      if word == Keyword.Auto {
        Option<Overscroll>.some(Overscroll.Auto)
      } else if word == Keyword.Contain {
        Option<Overscroll>.some(Overscroll.Contain)
      } else if word == Keyword.None {
        Option<Overscroll>.some(Overscroll.None)
      } else {
        Option<Overscroll>.None
      }
    }
    Option.None => Option<Overscroll>.None
  }
}

fn setOverscroll(target: &mut Overscroll, value: &Value) -> () {
  match overscrollOf(value) {
    Option.Some { value: found } => {
      target.* = found
    }
    Option.None => {}
  }
}

/// The physical side (0 top, 1 right, 2 bottom, 3 left) of a logical one, as css-logical maps
/// it for the box's writing mode and direction.
pub fn physicalSide(mode: WritingMode, direction: Direction, block: bool, end: bool) -> usize {
  let rtl = direction == Direction.Rtl
  if mode == WritingMode.HorizontalTb {
    if block {
      return if end { 2 } else { 0 }
    }
    return if end != rtl { 1 } else { 3 }
  }
  if block {
    let rightFirst = mode == WritingMode.VerticalRl || mode == WritingMode.SidewaysRl
    return if end == rightFirst { 3 } else { 1 }
  }
  let bottomFirst = mode == WritingMode.SidewaysLr
  return if (end != rtl) != bottomFirst { 2 } else { 0 }
}

fn pickSide(side: usize, top: CssProperty, right: CssProperty, bottom: CssProperty, left: CssProperty) -> CssProperty {
  return if side == 0 { top } else if side == 1 { right } else if side == 2 { bottom } else { left }
}

/// The outline style keyword: the border styles, with the line styles the tree does not draw
/// painted as the nearest one it does.
fn outlineStyleOf(word: Keyword) -> Option<BorderStyle> {
  if word == Keyword.Dotted {
    return Option<BorderStyle>.some(BorderStyle.Dashed)
  }
  if word == Keyword.Double || word == Keyword.Groove || word == Keyword.Ridge
    || word == Keyword.Inset
    || word == Keyword.Outset {
    return Option<BorderStyle>.some(BorderStyle.Solid)
  }
  return keyword_enums.borderStyleOf(word)
}

fn setDimension(target: &mut Dimension, value: &Value, context: &Context) -> () {
  match convert.dimension(value, context) {
    Option.Some { value: found } => {
      target.* = found
    }
    Option.None => {}
  }
}

// A width, height, minimum, maximum or flex basis, which also takes `min(100%, 600px)` and
// `clamp(200px, 50% + 2rem, 800px)`, whose bounds go in `bounds`.
fn setSize(target: &mut SizeValue, bounds: &mut Bounds, value: &Value, context: &Context) -> () {
  match convert.sizeIn(value, context, &mut bounds.*) {
    Option.Some { value: found } => {
      target.* = found
    }
    Option.None => {}
  }
}

// A margin, padding or inset, which also takes `clamp(1rem, 5%, 3rem)` (see `setSize`).
fn setEdge(target: &mut Dimension, bounds: &mut Bounds, value: &Value, context: &Context) -> () {
  match convert.edge(value, context, &mut bounds.*) {
    Option.Some { value: found } => {
      target.* = found
    }
    Option.None => {}
  }
}

// A `border-spacing` length in px; negative for anything else, which CSS rejects.
fn spacingOf(value: &Value, context: &Context) -> f32 {
  return match convert.dimension(value, context) {
    Option.Some { value: found } => if found.kind == DimensionKind.Length && found.value >= 0.0 { found.value } else { -1.0 }
    Option.None => -1.0
  }
}

fn setGap(target: &mut Dimension, bounds: &mut Bounds, value: &Value, context: &Context) -> () {
  match convert.edge(value, context, &mut bounds.*) {
    Option.Some { value: found } => {
      target.* = if found.kind == DimensionKind.Auto || found.kind == DimensionKind.None {
        Dimension.keyword(DimensionKind.Normal)
      } else {
        found
      }
    }
    Option.None => {}
  }
}

/// A `scroll-padding` side: `auto` is zero, a length or a percentage of the scrollport.
fn setScrollPadding(target: &mut Dimension, value: &Value, context: &Context) -> () {
  match convert.dimension(value, context) {
    Option.Some { value: found } => {
      target.* = if found.kind == DimensionKind.Auto { Dimension.px(0.0) } else { found }
    }
    Option.None => {}
  }
}

/// A `zoom` value: a non-negative number or percentage, `normal` for 1. Zero is 1, as in browsers.
pub fn zoomOf(value: &Value) -> Option<f32> {
  if convert.isKeyword(value, Keyword.Normal) { return Option<f32>.some(1.0) }
  return match &value.* {
    Value.Unit { value: amount, unit } => {
      let factor: f32 = if unit == Unit.Number { amount } else if unit == Unit.Percent { amount / 100.0 } else { -1.0 }
      if factor < 0.0 { Option<f32>.None } else if factor == 0.0 { Option<f32>.some(1.0) } else { Option<f32>.some(factor) }
    }
    _ => Option<f32>.None
  }
}

fn zoomedEdges(edges: Edges, ratio: f32) -> Edges {
  return Edges { top: edges.top.zoomed(ratio), right: edges.right.zoomed(ratio),
    bottom: edges.bottom.zoomed(ratio), left: edges.left.zoomed(ratio) }
}

fn setPixels(target: &mut f32, value: &Value, context: &Context) -> () {
  match convert.length(value, context) {
    Option.Some { value: found } => {
      target.* = found
    }
    Option.None => {}
  }
}

/// Whether `value` is a percentage or a math function, which may hold one.
fn hasPercent(value: &Value) -> bool {
  return match &value.* {
    Value.Unit { unit, .. } => unit == Unit.Percent
    Value.Math { .. } => true
    _ => false
  }
}

/// A corner radius with a percentage: its length part in `length`, and a percentage part noted in `effects` for
/// `paint_css` to read.
fn setRadius(length: &mut f32, effects: &mut EffectState, value: &Value, context: &Context) -> () {
  match convert.dimension(value, context) {
    Option.Some { value: found } => {
      if (found.kind == DimensionKind.Length || found.kind == DimensionKind.Percent
        || found.kind == DimensionKind.Calc) && found.value >= 0.0 && found.percent >= 0.0 {
        length.* = found.value
        if found.percent > 0.0 {
          effects.radiusShare = true
          effects.declared = true
        }
      }
    }
    Option.None => {}
  }
}

/// Whether `value` is a valid corner radius: a length-percentage, not negative.
fn validRadius(value: &Value, context: &Context) -> bool {
  return match convert.dimension(value, context) {
    Option.Some { value: found } => (found.kind == DimensionKind.Length || found.kind == DimensionKind.Percent
      || found.kind == DimensionKind.Calc) && found.value >= 0.0 && found.percent >= 0.0
    Option.None => false
  }
}

/// A corner radius longhand: one radius for both axes, or a horizontal and a vertical one
/// (`8px 4px`). `length` keeps the horizontal length part; a vertical radius is noted in
/// `effects` for `paint_css` to read, as a percentage is.
fn setCornerRadius(length: &mut f32, effects: &mut EffectState, value: &Value, context: &Context) -> () {
  match &value.* {
    Value.Sequence { separator: Separator.Space, values } => {
      let items = values.asSlice()
      if items.length == 2 {
        setCornerPair(&mut length.*, &mut effects.*, &items[0], &items[1], true, context)
      }
    }
    _ => setCornerPair(&mut length.*, &mut effects.*, value, value, false, context)
  }
}

/// A corner's radii: `horizontal`, and `vertical` when `paired` (else the same).
fn setCornerPair(length: &mut f32, effects: &mut EffectState, horizontal: &Value, vertical: &Value, paired: bool, context: &Context) -> () {
  if !validRadius(horizontal, context) {
    return
  }
  if paired {
    if !validRadius(vertical, context) {
      return
    }
    effects.radiusShare = true
    effects.declared = true
  }
  if hasPercent(horizontal) { setRadius(&mut length.*, &mut effects.*, horizontal, context) } else { setPixels(&mut length.*, horizontal, context) }
}

/// How many space-separated values `value` lists (one for a single value).
fn spacedCount(value: &Value) -> usize {
  return match &value.* {
    Value.Sequence { separator: Separator.Space, values } => values.length()
    _ => 1
  }
}

/// Value `index` of a list of `spacedCount(value)` values.
fn spacedItem(value: &Value, index: usize) -> &Value {
  return match &value.* {
    Value.Sequence { separator: Separator.Space, values } => &values.asSlice()[index]
    _ => value
  }
}

/// Which of `count` values (one to four) corner `corner` takes, top-left first, as `margin`
/// repeats them.
fn cornerPick(count: usize, corner: usize) -> usize {
  if count == 1 {
    return 0
  }
  if count == 2 {
    return corner % 2
  }
  if count == 3 {
    return if corner == 3 { 1 } else { corner }
  }
  return corner
}

/// A border width: a length, or `thin`, `medium`, `thick`.
fn setBorderWidth(target: &mut f32, value: &Value, context: &Context) -> () {
  match convert.keywordOf(value) {
    Option.Some { value: word } => {
      if word == Keyword.Thin {
        target.* = context.zoom
      } else if word == Keyword.Medium {
        target.* = 3.0 * context.zoom
      } else if word == Keyword.Thick {
        target.* = 5.0 * context.zoom
      }
    }
    Option.None => {
      setPixels(&mut target, value, context)
    }
  }
}

fn setColor(target: &mut Rgba<f32>, value: &Value) -> bool {
  match convert.color(value) {
    Option.Some { value: found } => {
      target.* = found
      return true
    }
    Option.None => {
      return false
    }
  }
}

pub fn containerDependent(declaration: &Declaration) -> bool { return hasContainerUnit(&declaration.value) }
fn hasContainerUnit(value: &Value) -> bool {
  match &value.* {
    Value.Unit { unit, .. } => { return unit == Unit.Cqw || unit == Unit.Cqh || unit == Unit.Cqi || unit == Unit.Cqb || unit == Unit.Cqmin || unit == Unit.Cqmax }
    Value.Math { values, .. } => { return anyContainerUnit(values.asSlice()) }
    Value.Function { values, .. } => { return anyContainerUnit(values.asSlice()) }
    Value.Sequence { values, .. } => { return anyContainerUnit(values.asSlice()) }
    Value.Text { css } => {
      let bytes = css.asSlice()
      let mut i: usize = 1
      while i + 1 < bytes.length {
        if isDigit(bytes[i - 1]) && (bytes[i] | 32) == 99 && (bytes[i + 1] | 32) == 113 { return true }
        i = i + 1
      }
      return false
    }
    _ => { return false }
  }
}
fn anyContainerUnit(values: &[Value]) -> bool {
  let mut i: usize = 0
  while i < values.length { if hasContainerUnit(&values[i]) { return true } i = i + 1 }
  return false
}

/// Whether `declaration` uses a viewport unit.
pub fn viewportDependent(declaration: &Declaration) -> bool {
  return hasViewportUnit(&declaration.value)
}

// The direct path accepts only declarations that Computed can apply without ordered
// font passes, relative-unit queries, or the motion/font/transform text grammars.
pub fn requiresContext(list: &[Declaration]) -> bool {
  let mut i: usize = 0
  while i < list.length {
    let declaration = &list[i]
    match declaration.property {
      CssProperty.WritingMode | CssProperty.Direction | CssProperty.TextOrientation
        | CssProperty.ContainerName | CssProperty.Container
        | CssProperty.FontVariant | CssProperty.FontFeatureSettings | CssProperty.FontVariationSettings | CssProperty.FontWidth | CssProperty.FontStretch
        | CssProperty.FontPalette | CssProperty.FontVariantAlternates | CssProperty.FontSizeAdjust | CssProperty.FontSmooth
        | CssProperty.FontVariantLigatures | CssProperty.FontVariantCaps | CssProperty.FontVariantNumeric
        | CssProperty.FontVariantPosition | CssProperty.FontKerning
        | CssProperty.Transform | CssProperty.Translate | CssProperty.Rotate | CssProperty.Scale
        | CssProperty.TransformOrigin | CssProperty.Perspective | CssProperty.PerspectiveOrigin | CssProperty.BackfaceVisibility | CssProperty.TransformStyle
        | CssProperty.OffsetPath | CssProperty.OffsetDistance | CssProperty.OffsetRotate | CssProperty.OffsetAnchor | CssProperty.OffsetPosition
        | CssProperty.Animation | CssProperty.AnimationName | CssProperty.AnimationDuration | CssProperty.AnimationTimingFunction
        | CssProperty.AnimationDelay | CssProperty.AnimationIterationCount | CssProperty.AnimationDirection
        | CssProperty.AnimationFillMode | CssProperty.AnimationPlayState
        | CssProperty.Transition | CssProperty.TransitionProperty | CssProperty.TransitionDuration
        | CssProperty.TransitionTimingFunction | CssProperty.TransitionDelay | CssProperty.TransitionBehavior
        | CssProperty.Zoom => { return true }
      _ => {}
    }
    let font = declaration.property == CssProperty.FontSize || declaration.property == CssProperty.LineHeight
    match &declaration.value {
      Value.Unit { unit, .. } => {
        if unit != Unit.Number && unit != Unit.Px && (font || unit != Unit.Percent) { return true }
      }
      Value.Math { values, .. } => { if font || relativeValues(values.asSlice()) { return true } }
      Value.Function { values, .. } => { if font || relativeValues(values.asSlice()) { return true } }
      Value.Sequence { values, .. } => { if font || relativeValues(values.asSlice()) { return true } }
      Value.Text { .. } => { return true }
      _ => { if font { return true } }
    }
    i = i + 1
  }
  return false
}
fn relativeValue(value: &Value) -> bool {
  match &value.* {
    Value.Unit { unit, .. } => { return unit != Unit.Number && unit != Unit.Px && unit != Unit.Percent }
    Value.Math { values, .. } => { return relativeValues(values.asSlice()) }
    Value.Function { values, .. } => { return relativeValues(values.asSlice()) }
    Value.Sequence { values, .. } => { return relativeValues(values.asSlice()) }
    Value.Text { .. } => { return true }
    _ => { return false }
  }
}
fn relativeValues(values: &[Value]) -> bool {
  let mut i: usize = 0
  while i < values.length { if relativeValue(&values[i]) { return true } i = i + 1 }
  return false
}

impl Computed {
  pub fn unitContext(self: &Self) -> Context {
    let mut context = Context.make()
    context.fontSize = self.text.size
    context.viewportWidth = self.viewportWidth
    context.viewportHeight = self.viewportHeight
    context.vertical = self.text.writingMode != WritingMode.HorizontalTb
    context.containerWidth = self.containerWidth
    context.containerHeight = self.containerHeight
    context.containerInlineSize = if context.vertical { self.containerHeight } else { self.containerWidth }
    context.containerBlockSize = if context.vertical { self.containerWidth } else { self.containerHeight }
    context.zoom = self.text.zoom
    context.rootFontSize = context.rootFontSize * self.text.zoom
    return context
  }

  /// Sets the effective zoom to `parentZoom` times the element's own `zoom`. Inherited
  /// lengths, which the parent computed at its zoom, move to the new one.
  pub fn setZoom(self: &mut Self, own: f32, parentZoom: f32) -> () {
    let zoom = parentZoom * own
    if zoom == self.text.zoom || self.text.zoom <= 0.0 { return () }
    let ratio = zoom / self.text.zoom
    self.text.rezoom(zoom)
    self.layout.borderSpacingX = self.layout.borderSpacingX * ratio
    self.layout.borderSpacingY = self.layout.borderSpacingY * ratio
    // Lengths the element's own declarations have not set yet hold initial values.
    self.outline.width = self.outline.width * ratio
    self.columnRule.width = self.columnRule.width * ratio
  }

  /// This style with every length it holds multiplied by `ratio`, for `inherit` across a change
  /// of zoom.
  pub fn zoomedBy(self: &Self, ratio: f32) -> Computed {
    let mut out = self.*
    if ratio == 1.0 { return out }
    out.text.rezoom(self.text.zoom * ratio)
    let l = &mut out.layout
    l.width = l.width.zoomed(ratio)
    l.height = l.height.zoomed(ratio)
    l.minWidth = l.minWidth.zoomed(ratio)
    l.minHeight = l.minHeight.zoomed(ratio)
    l.maxWidth = l.maxWidth.zoomed(ratio)
    l.maxHeight = l.maxHeight.zoomed(ratio)
    l.flexBasis = l.flexBasis.zoomed(ratio)
    l.rowGap = l.rowGap.zoomed(ratio)
    l.columnGap = l.columnGap.zoomed(ratio)
    l.margin = zoomedEdges(l.margin, ratio)
    l.padding = zoomedEdges(l.padding, ratio)
    l.inset = zoomedEdges(l.inset, ratio)
    l.border = zoomedEdges(l.border, ratio)
    l.borderSpacingX = l.borderSpacingX * ratio
    l.borderSpacingY = l.borderSpacingY * ratio
    if l.columnWidth > 0.0 { l.columnWidth = l.columnWidth * ratio }
    out.paint.border = Insets<f32> { top: out.paint.border.top * ratio, right: out.paint.border.right * ratio,
      bottom: out.paint.border.bottom * ratio, left: out.paint.border.left * ratio }
    out.paint.radii = Corners<f32> { topLeft: out.paint.radii.topLeft * ratio, topRight: out.paint.radii.topRight * ratio,
      bottomRight: out.paint.radii.bottomRight * ratio, bottomLeft: out.paint.radii.bottomLeft * ratio }
    out.outline.width = out.outline.width * ratio
    out.outline.offset = out.outline.offset * ratio
    out.columnRule.width = out.columnRule.width * ratio
    return out
  }
  pub fn containerWidthBasis(self: &Self) -> f32 {
    return match self.containerWidth { Option.Some { value } => value _ => self.viewportWidth }
  }
  pub fn containerHeightBasis(self: &Self) -> f32 {
    return match self.containerHeight { Option.Some { value } => value _ => self.viewportHeight }
  }
  pub fn paintBasis(self: &Self) -> paint_css.Basis {
    return paint_css.Basis { units: self.unitContext(), color: self.text.color }
  }

  /// The initial style of an element whose parent's text style is `text`.
  pub fn inheriting(text: TextStyle) -> Computed {
    return Computed.inViewport(text, 0.0, 0.0)
  }

  /// `inheriting`, with viewport units resolving against a `width` by `height` viewport.
  pub fn inViewport(text: TextStyle, width: f32, height: f32) -> Computed {
    return Computed {
      layout: CssStyle.make(),
      paint: Paint.initial(),
      text: text,
      effects: EffectState { declared: false, hash: 0, shadowFrom: NO_SHADOW, shadowHash: 0, layered: false, stacks: false, radiusShare: false },
      viewportWidth: width,
      viewportHeight: height,
      usesViewport: false,
      containerWidth: Option<f32>.None, containerHeight: Option<f32>.None, usesContainer: false,
      transition: TransitionLists.initial(),
      animation: AnimationLists.initial(),
      transform: Transform.initial(),
      zIndex: 0,
      zAuto: true,
      nearest: false,
      emptyCellsHide: false,
      accentColor: Rgba<f32> { r: 0.0, g: 0.459, b: 1.0, a: 1.0 },
      hasAccentColor: false,
      appearanceNone: false,
      outline: Outline.initial(),
      columnRule: ColumnRule.initial(),
      scroll: ScrollStyle.initial(),
      cursor: Option<Cursor>.None,
      cursorUrl: false,
      contain: Containment.initial(),
      list: ListStyle.initial(),
      anchor: AnchorStyle.none(),
      userSelect: SELECT_AUTO,
      appRegion: REGION_NONE,
      svg: SvgPaint.initial(),
    }
  }

  /// Applies one declaration. A value that does not fit its property is ignored, as an
  /// invalid declaration is in CSS.
  pub fn apply(self: &mut Self, declaration: &Declaration) -> () {
    let context = self.unitContext()
    self.applyIn(declaration, &context)
  }

  // The caller has excluded relative units and dependency-ordered declarations.
  pub fn applyFixed(self: &mut Self, declaration: &Declaration, context: &Context) -> () {
    self.set(declaration.property, &declaration.value, context)
  }

  pub fn applyIn(self: &mut Self, declaration: &Declaration, context: &Context) -> () {
    if !self.usesContainer && containerDependent(declaration) { self.usesContainer = true
      self.usesViewport = true }
    if !self.usesViewport && hasViewportUnit(&declaration.value) {
      self.usesViewport = true
    }
    self.set(declaration.property, &declaration.value, context)
  }

  /// Applies a shorthand of four sides or corners: one value for all, or two to four in the
  /// CSS order with the usual defaults.
  fn four(self: &mut Self, value: &Value, a: CssProperty, b: CssProperty, c: CssProperty, d: CssProperty, context: &Context) -> () {
    match &value.* {
      Value.Sequence { separator: _, values } => {
        let items = values.asSlice()
        let count = items.length
        if count == 0 || count > 4 {
          return ()
        }
        self.set(a, &items[0], context)
        self.set(b, &items[if count > 1 { 1 } else { 0 }], context)
        self.set(c, &items[if count > 2 { 2 } else { 0 }], context)
        self.set(d, &items[if count > 3 { 3 } else if count > 1 { 1 } else { 0 }], context)
      }
      _ => {
        self.set(a, value, context)
        self.set(b, value, context)
        self.set(c, value, context)
        self.set(d, value, context)
      }
    }
  }

  /// `border-radius`: one to four radii, then optionally a slash and one to four vertical radii.
  fn radiusShorthand(self: &mut Self, value: &Value, context: &Context) -> () {
    let mut horizontal = value
    let mut vertical = value
    let mut paired = false
    match &value.* {
      Value.Sequence { separator: Separator.Slash, values } => {
        let items = values.asSlice()
        if items.length != 2 {
          return ()
        }
        horizontal = &items[0]
        vertical = &items[1]
        paired = true
      }
      _ => {}
    }
    let across = spacedCount(horizontal)
    let down = spacedCount(vertical)
    if across == 0 || across > 4 || down == 0 || down > 4 {
      return ()
    }
    let mut corner: usize = 0
    while corner < 4 {
      let h = spacedItem(horizontal, cornerPick(across, corner))
      let v = spacedItem(vertical, cornerPick(down, corner))
      if corner == 0 {
        setCornerPair(&mut self.paint.radii.topLeft, &mut self.effects, h, v, paired, context)
      } else if corner == 1 {
        setCornerPair(&mut self.paint.radii.topRight, &mut self.effects, h, v, paired, context)
      } else if corner == 2 {
        setCornerPair(&mut self.paint.radii.bottomRight, &mut self.effects, h, v, paired, context)
      } else {
        setCornerPair(&mut self.paint.radii.bottomLeft, &mut self.effects, h, v, paired, context)
      }
      corner = corner + 1
    }
  }

  /// Applies a shorthand of two longhands: one value for both, or one each.
  fn two(self: &mut Self, value: &Value, a: CssProperty, b: CssProperty, context: &Context) -> () {
    match &value.* {
      Value.Sequence { separator: _, values } => {
        let items = values.asSlice()
        if items.length == 2 {
          self.set(a, &items[0], context)
          self.set(b, &items[1], context)
        }
      }
      _ => {
        self.set(a, value, context)
        self.set(b, value, context)
      }
    }
  }

  /// Applies a logical longhand as the physical one it maps to now: the box's own writing mode
  /// and direction, inherited or declared before it.
  fn logical(self: &mut Self, value: &Value, block: bool, end: bool, top: CssProperty, right: CssProperty, bottom: CssProperty, left: CssProperty, context: &Context) -> () {
    let side = physicalSide(self.text.writingMode, self.text.direction, block, end)
    self.set(pickSide(side, top, right, bottom, left), value, context)
  }

  /// A logical corner radius: the corner between a block side and an inline side.
  fn logicalCorner(self: &mut Self, value: &Value, blockEnd: bool, inlineEnd: bool, context: &Context) -> () {
    let block = physicalSide(self.text.writingMode, self.text.direction, true, blockEnd)
    let inline = physicalSide(self.text.writingMode, self.text.direction, false, inlineEnd)
    let top = block == 0 || inline == 0
    let left = block == 3 || inline == 3
    self.set(
      if top && left {
        CssProperty.BorderTopLeftRadius
      } else if top {
        CssProperty.BorderTopRightRadius
      } else if left {
        CssProperty.BorderBottomLeftRadius
      } else {
        CssProperty.BorderBottomRightRadius
      },
      value, context,
    )
  }

  /// A logical size: `inline` sizes are widths in horizontal writing and heights in vertical.
  fn logicalSize(self: &mut Self, value: &Value, inline: bool, width: CssProperty, height: CssProperty, context: &Context) -> () {
    let horizontal = self.text.writingMode == WritingMode.HorizontalTb
    self.set(if inline == horizontal { width } else { height }, value, context)
  }

  fn set(self: &mut Self, property: CssProperty, value: &Value, basis: &Context) -> () {
    if paint_css.handles(property) {
      self.effects.declared = true
      return ()
    }
    let context = basis.*
    match property {
      CssProperty.ContainerType => {
        if let Option<Keyword>.Some { value: word } = convert.keywordOf(value) {
          if word == Keyword.Normal { self.contain.setQuery(SizeContainment.None, &mut self.layout) }
          if word == Keyword.Size { self.contain.setQuery(SizeContainment.Size, &mut self.layout) }
          if word == Keyword.InlineSize { self.contain.setQuery(SizeContainment.InlineSize, &mut self.layout) }
        }
      }
      CssProperty.Contain => {
        if let Option<Contained>.Some { value: found } = containOf(value) { self.contain.setContain(found, &mut self.layout) }
      }
      CssProperty.ContentVisibility => {
        if let Option<Keyword>.Some { value: word } = convert.keywordOf(value) {
          if word == Keyword.Hidden || word == Keyword.Visible || word == Keyword.Auto {
            self.contain.setVisibility(word == Keyword.Hidden, word == Keyword.Auto, &mut self.layout)
          }
        }
      }
      CssProperty.ContainIntrinsicSize | CssProperty.ContainIntrinsicHeight | CssProperty.ContainIntrinsicBlockSize => {
        // The last length: `auto 300px`, `200px 300px` and `300px` all give a block size of 300.
        let mut last = value
        if let Value.Sequence { values, .. } = &value.* {
          if values.length() != 0 { last = &values.asSlice()[values.length() - 1] }
        }
        let mut size = SizeValue.auto()
        let mut bounds = Bounds.none()
        setSize(&mut size, &mut bounds, last, &context)
        self.contain.setIntrinsic(if size.kind == DimensionKind.Length { size.value } else { -1.0 })
      }
      CssProperty.Container => {
        self.contain.setQuery(SizeContainment.None, &mut self.layout)
        if let Value.Sequence { separator: Separator.Slash, values } = &value.* {
          if values.length() == 2 { self.set(CssProperty.ContainerType, &values.asSlice()[1], &context) }
        }
      }
      // Shorthands.
      CssProperty.Margin => {
        self.four(value, CssProperty.MarginTop, CssProperty.MarginRight, CssProperty.MarginBottom, CssProperty.MarginLeft, &context)
      }
      CssProperty.Padding => {
        self.four(value, CssProperty.PaddingTop, CssProperty.PaddingRight, CssProperty.PaddingBottom, CssProperty.PaddingLeft, &context)
      }
      CssProperty.Inset => {
        self.four(value, CssProperty.Top, CssProperty.Right, CssProperty.Bottom, CssProperty.Left, &context)
      }
      CssProperty.BorderWidth => {
        self.four(value, CssProperty.BorderTopWidth, CssProperty.BorderRightWidth, CssProperty.BorderBottomWidth, CssProperty.BorderLeftWidth, &context)
      }
      CssProperty.BorderRadius => {
        self.radiusShorthand(value, &context)
      }
      // The tree paints one border color and style, so every side sets the same one.
      CssProperty.BorderColor => {
        self.set(CssProperty.BorderTopColor, value, &context)
      }
      CssProperty.BorderStyle => {
        self.set(CssProperty.BorderTopStyle, value, &context)
      }
      CssProperty.Gap => {
        self.two(value, CssProperty.RowGap, CssProperty.ColumnGap, &context)
      }
      CssProperty.Overflow => {
        self.two(value, CssProperty.OverflowX, CssProperty.OverflowY, &context)
      }
      CssProperty.WhiteSpace => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.whiteSpaceOf(word) {
              Option.Some { value: found } => {
                self.text.whiteSpace = found
                self.text.textWrap = if found == WhiteSpace.NoWrap || found == WhiteSpace.Pre {
                  TextWrap.NoWrap
                } else {
                  TextWrap.Wrap
                }
                self.text.whiteSpaceCollapse = if found == WhiteSpace.Pre || found == WhiteSpace.PreWrap {
                  WhiteSpaceCollapse.Preserve
                } else if found == WhiteSpace.PreLine {
                  WhiteSpaceCollapse.PreserveBreaks
                } else {
                  WhiteSpaceCollapse.Collapse
                }
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      // Sizes and edges.
      CssProperty.Cursor => {
        self.cursorUrl = false
        match &value.* {
          Value.Keyword { value: word } => {
            self.cursor = cursorOf(keywords.name(word))
          }
          Value.Text { css } => {
            self.cursor = textCursor(Bytes.asSlice(&css))
            self.cursorUrl = textHasUrl(Bytes.asSlice(&css))
          }
          Value.Sequence { values, .. } => {
            // `url(...) x y, ..., keyword`: the images are read back on hover.
            self.cursorUrl = true
            let list = values.asSlice()
            self.cursor = Option<Cursor>.Some { value: Cursor.Default }
            if list.length > 0 {
              if let Value.Keyword { value: word } = &list[list.length - 1] {
                self.cursor = cursorOf(keywords.name(word))
              }
            }
          }
          Value.Function { .. } => {
            self.cursorUrl = true
            self.cursor = Option<Cursor>.Some { value: Cursor.Default }
          }
          _ => {}
        }
      }
      CssProperty.Display => {
        match convert.display(value) {
          Option.Some { value: found } => {
            self.layout.display = found
            self.list.flag(LIST_ITEM, false)
          }
          Option.None => {
            if convert.isKeyword(value, Keyword.ListItem) {
              self.layout.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
              self.list.flag(LIST_ITEM, true)
            }
          }
        }
      }
      CssProperty.ListStyleType => {
        if let Option<u8>.Some { value: code } = listTypeOf(value) { self.list.setType(code) }
      }
      CssProperty.ListStylePosition => {
        if convert.isKeyword(value, Keyword.Inside) { self.list.flag(LIST_INSIDE, true) }
        if convert.isKeyword(value, Keyword.Outside) { self.list.flag(LIST_INSIDE, false) }
      }
      CssProperty.CounterReset => {
        self.list.flag(LIST_COUNTERS, true)
      }
      CssProperty.CounterIncrement => {
        self.list.flag(LIST_COUNTERS, true)
      }
      CssProperty.CounterSet => {
        self.list.flag(LIST_COUNTERS, true)
      }

      // Logical properties, mapped to the physical ones.
      CssProperty.MarginBlockStart => {
        self.logical(value, true, false, CssProperty.MarginTop, CssProperty.MarginRight, CssProperty.MarginBottom, CssProperty.MarginLeft, &context)
      }
      CssProperty.MarginBlockEnd => {
        self.logical(value, true, true, CssProperty.MarginTop, CssProperty.MarginRight, CssProperty.MarginBottom, CssProperty.MarginLeft, &context)
      }
      CssProperty.MarginInlineStart => {
