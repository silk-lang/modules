              // there is one, loads it again).
              if self.on && self.slotsHeld == inst.a && self.a.offset() == start && !self.lazy.get(u32.toUsize(inst.a)) { self.skipSlots = inst.a }
              if outline { self.skipOut = true } else { run self.a.jmp(self.skipLabel) }
