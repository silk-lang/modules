import silk.build.plan { Library, Plan }
import silk.build.step { sourcePath }

static fn plan() -> Plan {
  let mut plan = Plan.empty()
  if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan
      |> Plan.compileSources(
        "c",
        Plan.archivePath("silkjs-brotli", "c/common"),
        "*.c",
        &["-O2", "-w"],
        &[
          sourcePath("patched/include"),
          Plan.archivePath("silkjs-brotli", "c/include"),
          Plan.archivePath("silkjs-brotli", "c/dec"),
        ],
      )
    plan = plan
      |> Plan.compileSources(
        "c",
        Plan.archivePath("silkjs-brotli", "c/enc"),
        "*.c",
        &["-O2", "-w"],
        &[
          sourcePath("patched/include"),
          Plan.archivePath("silkjs-brotli", "c/include"),
          Plan.archivePath("silkjs-brotli", "c/dec"),
        ],
      )
    plan = plan
      |> Plan.compileNative(
        "c",
        Plan.archivePath("silkjs-brotli", "c/dec/bit_reader.c"),
        &["-O2", "-w"],
        &[
          sourcePath("patched/include"),
          Plan.archivePath("silkjs-brotli", "c/include"),
          Plan.archivePath("silkjs-brotli", "c/dec"),
        ],
      )
    plan = plan
      |> Plan.compileNative(
        "c",
        Plan.archivePath("silkjs-brotli", "c/dec/huffman.c"),
        &["-O2", "-w"],
        &[
          sourcePath("patched/include"),
          Plan.archivePath("silkjs-brotli", "c/include"),
          Plan.archivePath("silkjs-brotli", "c/dec"),
        ],
      )
    plan = plan
      |> Plan.compileNative(
        "c",
        Plan.archivePath("silkjs-brotli", "c/dec/prefix.c"),
        &["-O2", "-w"],
        &[
          sourcePath("patched/include"),
          Plan.archivePath("silkjs-brotli", "c/include"),
          Plan.archivePath("silkjs-brotli", "c/dec"),
        ],
      )
    plan = plan
      |> Plan.compileNative(
        "c",
        Plan.archivePath("silkjs-brotli", "c/dec/state.c"),
        &["-O2", "-w"],
        &[
          sourcePath("patched/include"),
          Plan.archivePath("silkjs-brotli", "c/include"),
          Plan.archivePath("silkjs-brotli", "c/dec"),
        ],
      )
    plan = plan
      |> Plan.compileNative(
        "c",
        Plan.archivePath("silkjs-brotli", "c/dec/static_init.c"),
        &["-O2", "-w"],
        &[
          sourcePath("patched/include"),
          Plan.archivePath("silkjs-brotli", "c/include"),
          Plan.archivePath("silkjs-brotli", "c/dec"),
        ],
      )
    plan = plan
      |> Plan.compileNative(
        "c",
        sourcePath("patched/dec/decode.c"),
        &["-O2", "-w"],
        &[
          sourcePath("patched/include"),
          Plan.archivePath("silkjs-brotli", "c/include"),
          Plan.archivePath("silkjs-brotli", "c/dec"),
        ],
      )
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("m", Library.dynamicSearch())
  }
  return plan
}

pub const PLAN: Plan = plan()
