//! The development host of a JavaScript app: [`js.program`] with the development tools.
//!
//!   <host> --dev <port>        runs the app from the @silkui/vite development server at that
//!                              port, replacing the modules an edit touches
//!   <host> --watch <bundle>    runs the bundle, reloading it whenever `<bundle>.stamp` changes
//!   <host> <bundle>            runs the bundle once
//!
//! A debug build serves the inspector when `SILK_UI_INSPECT` is set. The release host
//! (`js.release`) has none of this code.
import js { Settings, programWithStylesheetCompiler, failed, refused }
import ui_js_window_dev.lib { DevTools }
import ui_tree_window.host { startInspector }
import ui_tree_window.platform_thread { Launched, launch }
import ui_inspect_server.lib { InspectorOptions }
import ui_js.lib { JsError, runtimeStylesheets }
import ui_tree.legacy { TreeError }
import ui_tree.style_assets { StyleAssets }
import ui_tree_window.style_watch { SheetWatch }
import silk.system.filesystem { FileError }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_libc_platform as platform
import window.types { WindowError }
import webgpu.runtime { GpuError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.system.host_input { HostInput }

/// The port number `text` spells, or 0 when it is not one.
fn portOf(text: &[u8]) -> u16 {
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < text.length {
    if text[i] < 48 || text[i] > 57 { return 0 }
    value = value * 10 + u8.toU32(text[i] - 48)
    if value > 65535 { return 0 }
    i = i + 1
  }
  return u32.toU16(value)
}

pub fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] { return false }
    i = i + 1
  }
  return true
}

effect fn develop(settings: Settings, watch: bool, port: u16, entry: &[u8], launched: Option<Launched>, sheets: StyleAssets, updates: SheetWatch) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError
  ? &mut Allocator {
  let mut tools = DevTools.make()
  if port != 0 { tools.server(port) }
  if watch && entry.length != 0 {
    let mut stamp = List<u8>.make()
    run stamp.appendSlice(entry)
    run stamp.appendSlice(b".stamp")
    run tools.watch(entry, stamp.asSlice())
  }
  let inspector = run startInspector(InspectorOptions.make())
  // Under the development server the app comes from the server: start from an empty module.
  let source: &[u8] = if entry.length == 0 { b"export {};" } else { b"" }
  return run programWithStylesheetCompiler(settings, entry, source, move tools, move inspector, move launched, move sheets, move updates, runtimeStylesheets())
}

fn developed(settings: Settings, watch: bool, port: u16, entry: Bytes, launched: Option<Launched>, sheets: StyleAssets, updates: SheetWatch) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(Effect.catch<TreeError>(develop(settings, watch, port, Bytes.asSlice(&entry), move launched, move sheets, move updates), refused), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn noArgument<E>(error: E) -> Option<Bytes> {
  drop error
  return Option<Bytes>.None
}

effect fn noArguments<E>(error: E) -> usize {
  drop error
  return 0
}

/// The development host's `main`: reads the command line above and opens the window.
pub effect fn main(settings: Settings) -> i32 ? &mut HostInput {
  return run mainWithSheets(settings, &[])
}

effect fn launchDeveloped(settings: Settings, watch: bool, port: u16, entry: Bytes, sources: &[&[u8]], updatePath: string) -> i32
  ! FileError | OutOfMemoryError ? &mut Allocator {
  let sheets = run StyleAssets.from(sources)
  let updates = run SheetWatch.from(updatePath)
  return run launch(|launched: Option<Launched>| -> i32 {
    return developed(settings, watch, port, move entry, move launched, move sheets, move updates)
  })
}

/// Development entry with the application's initially compiled sheets.
pub effect fn mainWithSheets(settings: Settings, sources: &[&[u8]]) -> i32 ? &mut HostInput {
  return run mainWithSheetUpdates(settings, sources, "")
}

pub effect fn mainWithSheetUpdates(settings: Settings, sources: &[&[u8]], updatePath: string) -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let count = run Effect.catchAll(HostInput.argumentCount(), noArguments)
  let mut watch = false
  let mut port: u16 = 0
  let mut portNext = false
  let mut entry = Bytes.make()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run Effect.catchAll(HostInput.argument(i), noArgument) |> Effect.provideMut<Allocator>(&mut allocator) {
      if portNext {
        portNext = false
        port = portOf(Bytes.asSlice(&value))
      } else if same(Bytes.asSlice(&value), b"--dev") {
        portNext = true
      } else if same(Bytes.asSlice(&value), b"--watch") {
        watch = true
      } else {
        entry = move value
      }
    }
    i = i + 1
  }
  let watching = watch
  let serving = port
  let path = move entry
  // The main thread keeps the OS event loop; the app runs on its own thread.
  return run Effect.catchAll(
    launchDeveloped(settings, watching, serving, move path, sources, updatePath),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
