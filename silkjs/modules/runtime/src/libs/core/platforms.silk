//! The [`Platform`] implementations the core ships: `OsPlatform`, the process's own environment
//! and working directory, and `FixedPlatform`, a fixed environment and working directory given by
//! the embedder, for tests, heap images and runtimes that should not see the process's.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silkjs.js_std_native as std
import silkjs.js_os_platform as os
import libs.core.capabilities { Platform }

const EPERM: i32 = 1

/// `text` followed by a NUL, for libc.
effect fn terminated(text: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = List<u8>.make()
  run bytes.reserveExact(text.length + 1)
  run bytes.appendBytes(text)
  run bytes.append(0)
  return move bytes
}

/// Appends the NUL-terminated `text` to `into`, without its NUL.
effect fn appendTerminated(into: &mut List<u8>, text: *const u8, length: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = unsafe Pointer.assumeMany(text)
  let mut at: usize = 0
  while at < length { run into.append(unsafe Pointer.read(unsafe Pointer.at(bytes, at))) at = at + 1 }
}

/// The process's environment and working directory, as Node has them.
pub struct OsPlatform {}
impl Copy for OsPlatform {}
impl Platform for OsPlatform {
  fn forWorker(self: &Self) -> Self { return OsPlatform {} }
  effect fn getenv(self: &Self, name: &[u8], into: &mut List<u8>) -> bool ! OutOfMemoryError ? &mut Allocator {
    let key = run terminated(name)
    return match Pointer.nonNull(unsafe std.getenv(Pointer.fromRef<u8>(&key.asSlice()[0]))) {
      Option<*const u8>.Some { value } => {
        run appendTerminated(&mut into.*, value, unsafe os.length(value))
        true
      }
      _ => false
    }
  }
  effect fn setenv(self: &Self, name: &[u8], value: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let key = run terminated(name)
    let text = run terminated(value)
    if unsafe std.setenv(Pointer.fromRef<u8>(&key.asSlice()[0]), Pointer.fromRef<u8>(&text.asSlice()[0]), 1) < 0 { return -(unsafe std.errno()) }
    return 0
  }
  effect fn unsetenv(self: &Self, name: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let key = run terminated(name)
    if unsafe std.unsetenv(Pointer.fromRef<u8>(&key.asSlice()[0])) < 0 { return -(unsafe std.errno()) }
    return 0
  }
  effect fn environmentNames(self: &Self, into: &mut List<u8>) -> () ! OutOfMemoryError ? &mut Allocator {
    let pointer = unsafe std.environ()
    if Pointer.isNullMany(pointer) { return () }
    let entries = unsafe Intrinsic.pointerRequalify<?[*]const ?[*]const u8, [*]const ?[*]const u8>(pointer)
    let mut index: usize = 0
    while true {
      let entry = unsafe Pointer.read(unsafe Pointer.at(entries, index))
      if Pointer.isNullMany(entry) { break }
      let text = unsafe Intrinsic.pointerRequalify<?[*]const u8, *const u8>(entry)
      let length = unsafe os.length(text)
      let bytes = unsafe Pointer.assumeMany(text)
      let mut split: usize = 0
      while split < length && unsafe Pointer.read(unsafe Pointer.at(bytes, split)) != 61 { split = split + 1 }
      if split < length {
        run appendTerminated(&mut into.*, text, split)
        run into.append(0)
      }
      index = index + 1
    }
  }
  effect fn cwd(self: &Self, into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let mut buffer = List<u8>.make()
    run buffer.appendRepeated(0, os.pathMax() + 1)
    let data = Pointer.fromMutRef<u8>(&mut buffer.asMutSlice()[0])
    if Pointer.isNull<u8>(unsafe os.getcwd(data, os.pathMax())) { return -os.errno() }
    run into.appendBytes(Slice.view(buffer.asSlice(), 0, unsafe os.length(data)))
    return 0
  }
  effect fn chdir(self: &Self, path: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let name = run terminated(path)
    if unsafe os.chdir(Pointer.fromRef<u8>(&name.asSlice()[0])) < 0 { return -os.errno() }
    return 0
  }
  fn exit(self: &Self, status: i32) -> never { return unsafe std.exit(status) }
}

/// One environment variable of a [`FixedPlatform`].
pub struct Variable { pub name: &'static [u8], pub value: &'static [u8] }
impl Copy for Variable {}

/// An environment and a working directory fixed by the embedder: `process.env` has these
/// variables and no others, `process.cwd()` is this directory, and changing either throws
/// `EPERM`. Removing a variable that is not there is not a change. Exit ends the process, as
/// the process's own does. Native code that reads the process's environment itself, and child
/// processes, still see the process's.
pub struct FixedPlatform { environment: &'static [Variable], directory: &'static [u8] }
impl Copy for FixedPlatform {}
impl FixedPlatform {
  pub fn make(environment: &'static [Variable], directory: &'static [u8]) -> Self { return FixedPlatform { environment: environment, directory: directory } }
  fn find(self: &Self, name: &[u8]) -> Option<Variable> {
    let mut index: usize = 0
    while index < self.environment.length {
      let variable = self.environment[index]
      if same(variable.name, name) { return Option<Variable>.some(variable) }
      index = index + 1
    }
    return Option<Variable>.none()
  }
}
fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut at: usize = 0
  while at < a.length { if a[at] != b[at] { return false } at = at + 1 }
  return true
}
impl Platform for FixedPlatform {
  fn forWorker(self: &Self) -> Self { return FixedPlatform { environment: self.environment, directory: self.directory } }
  effect fn getenv(self: &Self, name: &[u8], into: &mut List<u8>) -> bool ! OutOfMemoryError ? &mut Allocator {
    return match self.find(name) {
      Option<Variable>.Some { value } => {
        run into.appendBytes(value.value)
        true
      }
      _ => false
    }
  }
  effect fn setenv(self: &Self, name: &[u8], value: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator { return -EPERM }
  effect fn unsetenv(self: &Self, name: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
    return match self.find(name) { Option<Variable>.Some { .. } => -EPERM _ => 0 }
  }
  effect fn environmentNames(self: &Self, into: &mut List<u8>) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut index: usize = 0
    while index < self.environment.length {
      run into.appendBytes(self.environment[index].name)
      run into.append(0)
      index = index + 1
    }
  }
  effect fn cwd(self: &Self, into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator {
    run into.appendBytes(self.directory)
    return 0
  }
  effect fn chdir(self: &Self, path: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator { return -EPERM }
  fn exit(self: &Self, status: i32) -> never { return unsafe std.exit(status) }
}
