//! The Metal Performance HUD (`native/metal_hud.m`): the frame rate and frame times Metal
//! measures for what a window's layer presents, drawn over it. macOS only; elsewhere every
//! call does nothing.
import silk.num.i32

static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn silk_ui_metal_hud(layer: ?*mut u8, on: i32) -> ()
  unsafe extern "C" fn silk_ui_metal_hud_default(on: i32) -> ()
  unsafe extern "C" fn silk_ui_metal_hud_default_on() -> i32
}

/// Shows the HUD on the windows opened from now on, or not.
pub fn showByDefault(on: bool) -> () {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe silk_ui_metal_hud_default(if on { 1 } else { 0 })
  }
}

/// Whether windows opened now show the HUD.
pub fn defaultOn() -> bool {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return unsafe silk_ui_metal_hud_default_on() != 0
  } else {
    return false
  }
}

/// Shows or hides the HUD on `layer`, a `CAMetalLayer`.
pub fn show(layer: ?*mut u8, on: bool) -> () {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe silk_ui_metal_hud(layer, if on { 1 } else { 0 })
  }
}
