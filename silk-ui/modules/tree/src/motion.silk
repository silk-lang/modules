//! CSS transitions (CSS Transitions 1 and 2): when a node's computed style changes, the
//! fields its `transition-*` lists name ease from the old value to the new one over the frame
//! clock, with `transitionrun`, `transitionstart`, `transitionend` and `transitioncancel`
//! records.
//!
//! The node's stored computed style is what shows, transitions included, so it is the
//! before-change style of the next style change. `resolve` hands each new style to
//! [`transition`], which starts, keeps, reverses or cancels transitions and writes the
//! values of the running ones over it. While any run, [`tick`] restyles their nodes each
//! frame, which also carries an eased inherited value (a color) down to the children.
import engine { UiTree }
import style_change
import style { Computed }
import timing { EasingStops, Easing, TransitionLists, TransitionSpec, TransitionItem, TimingList, Span, ALL }
import timing
import node { NONE, Event, EventKind, Move, MOVE_LINK, MOVE_CURVE }
import mutation {
  FIRST_ROOT,
  LISTEN_TRANSITION_RUN,
  LISTEN_TRANSITION_START,
  LISTEN_TRANSITION_END,
  LISTEN_TRANSITION_CANCEL
}
import transform
import transform { TransformList, Op, Origin }
import filter_motion { FilterList }
import filter_motion
import properties.computed { Fill, BoxShadow, Visibility, Dimension, SizeValue, DimensionKind, Display }
import animation
import silk.geometry.rect { Rect }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

// Fields: what the tree transitions, one longhand each.

pub const OPACITY: u32 = 0
pub const COLOR: u32 = 1
pub const BACKGROUND_COLOR: u32 = 2
pub const BORDER_TOP_COLOR: u32 = 3
pub const BORDER_RADIUS: u32 = 7
pub const BOX_SHADOW: u32 = 11
pub const BACKDROP: u32 = 12
pub const WIDTH: u32 = 13
pub const MARGIN: u32 = 20
pub const PADDING: u32 = 24
pub const INSET: u32 = 28
pub const BORDER_WIDTH: u32 = 32
pub const ROW_GAP: u32 = 36
pub const COLUMN_GAP: u32 = 37
pub const FONT_SIZE: u32 = 38
pub const DECORATION_COLOR: u32 = 39
pub const FLEX_GROW: u32 = 40
pub const FLEX_SHRINK: u32 = 41
pub const VISIBILITY: u32 = 42
pub const DISPLAY: u32 = 43
pub const TRANSFORM: u32 = 44
pub const TRANSLATE: u32 = 45
pub const ROTATE: u32 = 46
pub const SCALE: u32 = 47
pub const TRANSFORM_ORIGIN: u32 = 48
pub const PERSPECTIVE: u32 = 49
pub const PERSPECTIVE_ORIGIN: u32 = 50
pub const OFFSET_DISTANCE: u32 = 51
pub const OFFSET_ROTATE: u32 = 52
pub const OFFSET_ANCHOR: u32 = 53
pub const OFFSET_POSITION: u32 = 54
pub const FIELDS: u32 = 55
/// `filter`, which lives in the node's paint effects rather than in `Computed`: the loops over
/// `FIELDS` leave it out, and [`transitionFilter`] and `animation.applyFilters` ease it.
pub const FILTER: u32 = 55


/// The CSS longhand of field `field`, as transition records name it.
pub fn fieldName(field: u32) -> &'static [u8] {
  return match field {
    0 => b"opacity"
    1 => b"color"
    2 => b"background-color"
    3 => b"border-top-color"
    4 => b"border-right-color"
    5 => b"border-bottom-color"
    6 => b"border-left-color"
    7 => b"border-top-left-radius"
    8 => b"border-top-right-radius"
    9 => b"border-bottom-right-radius"
    10 => b"border-bottom-left-radius"
    11 => b"box-shadow"
    12 => b"backdrop-filter"
    13 => b"width"
    14 => b"height"
    15 => b"min-width"
    16 => b"min-height"
    17 => b"max-width"
    18 => b"max-height"
    19 => b"flex-basis"
    20 => b"margin-top"
    21 => b"margin-right"
    22 => b"margin-bottom"
    23 => b"margin-left"
    24 => b"padding-top"
    25 => b"padding-right"
    26 => b"padding-bottom"
    27 => b"padding-left"
    28 => b"top"
    29 => b"right"
    30 => b"bottom"
    31 => b"left"
    32 => b"border-top-width"
    33 => b"border-right-width"
    34 => b"border-bottom-width"
    35 => b"border-left-width"
    36 => b"row-gap"
    37 => b"column-gap"
    38 => b"font-size"
    39 => b"text-decoration-color"
    40 => b"flex-grow"
    41 => b"flex-shrink"
    42 => b"visibility"
    43 => b"display"
    44 => b"transform"
    45 => b"translate"
    46 => b"rotate"
    47 => b"scale"
    48 => b"transform-origin"
    49 => b"perspective"
    50 => b"perspective-origin"
    51 => b"offset-distance"
    52 => b"offset-rotate"
    53 => b"offset-anchor"
    54 => b"offset-position"
    _ => b"filter"
  }
}

fn bits(first: u32, count: u32) -> u64 {
  return u64.shiftLeft(u64.shiftLeft(1, u32.toU64(count)) - 1, u32.toU64(first))
}

fn bit(field: u32) -> u64 {
  return u64.shiftLeft(1, u32.toU64(field))
}

/// The fields `transition-property` name `name` covers: a longhand, a shorthand of them, or
/// `all`. Zero for a property the tree does not transition.
pub fn propertyMask(name: &[u8]) -> u64 {
  if timing.named(name, b"all") {
    return ALL
  }
  let mut field: u32 = 0
  while field <= FILTER {
    if timing.named(name, fieldName(field)) {
      return bit(field)
    }
    field = field + 1
  }
  if timing.named(name, b"border-color") {
    return bits(BORDER_TOP_COLOR, 4)
  }
  if timing.named(name, b"border-radius") {
    return bits(BORDER_RADIUS, 4)
  }
  if timing.named(name, b"margin") {
    return bits(MARGIN, 4)
  }
  if timing.named(name, b"padding") {
    return bits(PADDING, 4)
  }
  if timing.named(name, b"inset") {
    return bits(INSET, 4)
  }
  if timing.named(name, b"border-width") {
    return bits(BORDER_WIDTH, 4)
  }
  if timing.named(name, b"border") {
    return bits(BORDER_TOP_COLOR, 4) | bits(BORDER_WIDTH, 4)
  }
  if timing.named(name, b"border-top") {
    return bit(BORDER_TOP_COLOR) | bit(BORDER_WIDTH)
  }
  if timing.named(name, b"border-right") {
    return bit(BORDER_TOP_COLOR + 1) | bit(BORDER_WIDTH + 1)
  }
  if timing.named(name, b"border-bottom") {
    return bit(BORDER_TOP_COLOR + 2) | bit(BORDER_WIDTH + 2)
  }
  if timing.named(name, b"border-left") {
    return bit(BORDER_TOP_COLOR + 3) | bit(BORDER_WIDTH + 3)
  }
  if timing.named(name, b"gap") {
    return bits(ROW_GAP, 2)
  }
  if timing.named(name, b"flex") {
    return bit(WIDTH + 6) | bits(FLEX_GROW, 2)
  }
  if timing.named(name, b"background") {
    return bit(BACKGROUND_COLOR)
  }
  if timing.named(name, b"font") {
    return bit(FONT_SIZE)
  }
  if timing.named(name, b"text-decoration") {
    return bit(DECORATION_COLOR)
  }
  if timing.named(name, b"offset") {
    return bits(OFFSET_DISTANCE, 4)
  }
  return 0
}

// Reading `transition-*` declarations.

pub const SHORTHAND: u32 = 0
pub const PROPERTY: u32 = 1
pub const DURATION: u32 = 2
pub const TIMING: u32 = 3
pub const DELAY: u32 = 4
pub const BEHAVIOR: u32 = 5

/// Sets the lists that `which` (`SHORTHAND`, `PROPERTY`, ...) declares as CSS `text`. An
/// invalid value leaves them as they were, as an invalid declaration does.
pub effect fn declare(lists: &mut TransitionLists, which: u32, text: &[u8], store: &mut EasingStops) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  if let Option<TimingList>.Some { value } = store.transitionList(which, text) {
    assign(&mut lists, which, value)
    return ()
  }
  let mut parsed = List<TransitionItem>.make()
  let mut at: usize = 0
  while at <= text.length {
    let end = timing.itemEnd(text, at, true)
    let item = timing.trimmed(timing.part(text, at, end))
    if item.length == 0 { return () }
    let single = at == 0 && end == text.length
    let mut next = TransitionItem.initial()
    if which == SHORTHAND {
      if !shorthandItem(&mut next, item, single) { return () }
    } else if which == PROPERTY {
      if timing.named(item, b"none") {
        if !single { return () }
        next.property = 0
      } else { next.property = propertyMask(item) }
    } else if which == DURATION || which == DELAY {
      match timing.time(item) {
        Option<f32>.Some { value } => {
          if which == DURATION {
            if value < 0.0 { return () }
            next.duration = value
          } else { next.delay = value }
        }
        Option<f32>.None => { return () }
      }
    } else if which == TIMING {
      match timing.easing(item) {
        Option<Easing>.Some { value } => { next.easing = value }
        Option<Easing>.None => { return () }
      }
    } else {
      if timing.named(item, b"allow-discrete") { next.discrete = true }
      else if !timing.named(item, b"normal") { return () }
    }
    run parsed.append(next)
    at = end + 1
  }
  let kept = run store.keepTransition(which, text, parsed.asSlice())
  assign(&mut lists, which, kept)
}

fn assign(lists: &mut TransitionLists, which: u32, list: TimingList) -> () {
  if which == SHORTHAND || which == PROPERTY { lists.properties = list }
  if which == SHORTHAND || which == DURATION { lists.durations = list }
  if which == SHORTHAND || which == DELAY { lists.delays = list }
  if which == SHORTHAND || which == TIMING { lists.easings = list }
  if which == SHORTHAND || which == BEHAVIOR { lists.discrete = list }
}

// One item of the `transition` shorthand: a property, up to two times, an easing and a
// behavior, in any order. `none` is valid only alone.
fn shorthandItem(next: &mut TransitionItem, item: &[u8], single: bool) -> bool {
  let mut spans = [Span { start: 0, end: 0 }; 8]
  let count = timing.words(item, &mut spans)
  if count == 8 && timing.trimmed(timing.part(item, spans[7].end, item.length)).length != 0 { return false }
  let mut property: u64 = ALL
  let mut named = false
  let mut none = false
  let mut times: u32 = 0
  let mut eased = false
  let mut behaved = false
  next.duration = 0.0
  next.delay = 0.0
  next.easing = Easing.ease()
  next.discrete = false
  let mut i: usize = 0
  while i < count {
    let word = timing.part(item, spans[i].start, spans[i].end)
    let mut done = false
    if times < 2 {
      match timing.time(word) {
        Option<f32>.Some { value } => {
          if times == 0 {
            if value < 0.0 {
              return false
            }
            next.duration = value
          } else {
            next.delay = value
          }
          times = times + 1
          done = true
        }
        Option<f32>.None => {}
      }
    }
    if !done && !eased {
      match timing.easing(word) {
        Option<Easing>.Some { value } => {
          next.easing = value
          eased = true
          done = true
        }
        Option<Easing>.None => {}
      }
    }
    if !done && !behaved && (timing.named(word, b"allow-discrete") || timing.named(word, b"normal")) {
      next.discrete = timing.named(word, b"allow-discrete")
      behaved = true
      done = true
    }
    if !done {
      if named {
        return false
      }
      named = true
      if timing.named(word, b"none") {
        none = true
        property = 0
      } else {
        property = propertyMask(word)
      }
    }
    i = i + 1
  }
  if none && !single {
    return false
  }
  next.property = property
  return true
}

// Samples: the value of one field.

pub union Sample {
  Number { pub value: f32 },
  Color { pub value: Rgba<f32> },
  Length { pub value: SizeValue },
  Background { pub value: Fill },
  Shadow { pub value: BoxShadow, pub present: bool },
  Seen { pub value: Visibility },
  Shown { pub value: Display },
  List { pub value: TransformList },
  Function { pub value: Op },
  Place { pub value: Origin },
  /// A `perspective` distance, 0 for `none`.
  Distance { pub value: f32 },
  /// An `offset-distance`: pixels and a fraction of the path.
  Along { pub pixels: f32, pub fraction: f32 },
  /// An `offset-rotate`: radians, and whether it follows the path.
  Turn { pub value: f32, pub auto: bool },
  /// An `offset-anchor` or `offset-position`, with its `transform.PLACE_*` kind (an anchor is
  /// `PLACE_AUTO` or `PLACE_SET`).
  Spot { pub value: Origin, pub kind: u8 },
  /// A `filter` list ([`FILTER`]), read from the node's paint effects.
  Filters { pub value: FilterList },
}

impl Copy for Sample {}

/// The value of `field` in `computed`.
pub fn sample(computed: &Computed, field: u32) -> Sample {
  let paint = &computed.paint
  let layout = &computed.layout
  return match field {
    0 => Sample.Number { value: paint.opacity }
    1 => Sample.Color { value: computed.text.color }
    2 => Sample.Background { value: paint.background }
    3 => Sample.Color { value: paint.borderColor }
    4 => Sample.Color { value: paint.borderColor }
    5 => Sample.Color { value: paint.borderColor }
    6 => Sample.Color { value: paint.borderColor }
    7 => Sample.Number { value: paint.radii.topLeft }
    8 => Sample.Number { value: paint.radii.topRight }
    9 => Sample.Number { value: paint.radii.bottomRight }
    10 => Sample.Number { value: paint.radii.bottomLeft }
    11 => Sample.Shadow { value: paint.shadow, present: paint.hasShadow }
    12 => Sample.Number { value: paint.backdropBlur }
    13 => Sample.Length { value: layout.width }
    14 => Sample.Length { value: layout.height }
    15 => Sample.Length { value: layout.minWidth }
    16 => Sample.Length { value: layout.minHeight }
    17 => Sample.Length { value: layout.maxWidth }
    18 => Sample.Length { value: layout.maxHeight }
    19 => Sample.Length { value: layout.flexBasis }
    20 => Sample.Length { value: SizeValue.of(layout.margin.top) }
    21 => Sample.Length { value: SizeValue.of(layout.margin.right) }
    22 => Sample.Length { value: SizeValue.of(layout.margin.bottom) }
    23 => Sample.Length { value: SizeValue.of(layout.margin.left) }
    24 => Sample.Length { value: SizeValue.of(layout.padding.top) }
    25 => Sample.Length { value: SizeValue.of(layout.padding.right) }
    26 => Sample.Length { value: SizeValue.of(layout.padding.bottom) }
    27 => Sample.Length { value: SizeValue.of(layout.padding.left) }
    28 => Sample.Length { value: SizeValue.of(layout.inset.top) }
    29 => Sample.Length { value: SizeValue.of(layout.inset.right) }
    30 => Sample.Length { value: SizeValue.of(layout.inset.bottom) }
    31 => Sample.Length { value: SizeValue.of(layout.inset.left) }
    32 => Sample.Number { value: paint.border.top }
    33 => Sample.Number { value: paint.border.right }
    34 => Sample.Number { value: paint.border.bottom }
    35 => Sample.Number { value: paint.border.left }
    36 => Sample.Length { value: SizeValue.of(layout.rowGap) }
    37 => Sample.Length { value: SizeValue.of(layout.columnGap) }
    38 => Sample.Number { value: computed.text.size }
    39 => Sample.Color {
      value: if computed.text.hasDecorationColor {
        computed.text.decorationColor
      } else {
        computed.text.color
      },
    }
    40 => Sample.Number { value: layout.flexGrow }
    41 => Sample.Number { value: layout.flexShrink }
    42 => Sample.Seen { value: computed.text.visibility }
    43 => Sample.Shown { value: layout.display }
    44 => Sample.List { value: computed.transform.list }
    45 => Sample.Function { value: computed.transform.translate }
    46 => Sample.Function { value: computed.transform.rotate }
    47 => Sample.Function { value: computed.transform.scale }
    48 => Sample.Place { value: computed.transform.origin }
    49 => Sample.Distance { value: computed.transform.perspective }
    50 => Sample.Place { value: computed.transform.perspectiveOrigin }
    51 => Sample.Along { pixels: computed.transform.offset.distance, fraction: computed.transform.offset.distanceFraction }
    52 => Sample.Turn { value: computed.transform.offset.rotate, auto: computed.transform.offset.autoRotate }
    53 => Sample.Spot {
      value: computed.transform.offset.anchor,
      kind: if computed.transform.offset.anchorAuto { transform.PLACE_AUTO } else { transform.PLACE_SET },
    }
    _ => Sample.Spot { value: computed.transform.offset.position, kind: computed.transform.offset.positionKind }
  }
}

fn numberOf(of: Sample) -> f32 {
  return match of {
    Sample.Number { value } => value
    Sample.Distance { value } => value
    _ => 0.0
  }
}

fn colorOf(of: Sample) -> Rgba<f32> {
  return match of {
    Sample.Color { value } => value
    _ => Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
  }
}

fn lengthOf(of: Sample) -> SizeValue {
  return match of {
    Sample.Length { value } => value
    _ => SizeValue.auto()
  }
}

// A margin, padding, inset or gap: never one of the comparisons only a size holds.
fn edgeOf(of: Sample) -> Dimension {
  let value = lengthOf(of)
  return Dimension { kind: value.kind, slot: value.slot, value: value.value, percent: value.percent }
}

/// Writes `value` as field `field` of `computed`.
pub fn write(computed: &mut Computed, field: u32, value: Sample) -> () {
  if field == 0 {
    computed.paint.opacity = numberOf(value)
  } else if field == 1 {
    computed.text.color = colorOf(value)
  } else if field == 2 {
    match value {
      Sample.Background { value: fill } => {
        computed.paint.background = fill
      }
      _ => {}
    }
  } else if field >= 3 && field <= 6 {
    computed.paint.borderColor = colorOf(value)
  } else if field == 7 {
    computed.paint.radii.topLeft = numberOf(value)
  } else if field == 8 {
    computed.paint.radii.topRight = numberOf(value)
  } else if field == 9 {
    computed.paint.radii.bottomRight = numberOf(value)
  } else if field == 10 {
    computed.paint.radii.bottomLeft = numberOf(value)
  } else if field == 11 {
    match value {
      Sample.Shadow { value: shadow, present } => {
        computed.paint.shadow = shadow
        computed.paint.hasShadow = present
      }
      _ => {}
    }
  } else if field == 12 {
    computed.paint.backdropBlur = numberOf(value)
  } else if field == 13 {
    computed.layout.width = lengthOf(value)
  } else if field == 14 {
    computed.layout.height = lengthOf(value)
  } else if field == 15 {
    computed.layout.minWidth = lengthOf(value)
  } else if field == 16 {
    computed.layout.minHeight = lengthOf(value)
  } else if field == 17 {
    computed.layout.maxWidth = lengthOf(value)
  } else if field == 18 {
    computed.layout.maxHeight = lengthOf(value)
  } else if field == 19 {
    computed.layout.flexBasis = lengthOf(value)
  } else if field == 20 {
    computed.layout.margin.top = edgeOf(value)
  } else if field == 21 {
    computed.layout.margin.right = edgeOf(value)
  } else if field == 22 {
    computed.layout.margin.bottom = edgeOf(value)
  } else if field == 23 {
    computed.layout.margin.left = edgeOf(value)
  } else if field == 24 {
    computed.layout.padding.top = edgeOf(value)
  } else if field == 25 {
    computed.layout.padding.right = edgeOf(value)
  } else if field == 26 {
    computed.layout.padding.bottom = edgeOf(value)
  } else if field == 27 {
    computed.layout.padding.left = edgeOf(value)
  } else if field == 28 {
    computed.layout.inset.top = edgeOf(value)
  } else if field == 29 {
    computed.layout.inset.right = edgeOf(value)
  } else if field == 30 {
    computed.layout.inset.bottom = edgeOf(value)
  } else if field == 31 {
    computed.layout.inset.left = edgeOf(value)
  } else if field == 32 {
    computed.paint.border.top = numberOf(value)
  } else if field == 33 {
    computed.paint.border.right = numberOf(value)
  } else if field == 34 {
    computed.paint.border.bottom = numberOf(value)
  } else if field == 35 {
    computed.paint.border.left = numberOf(value)
  } else if field == 36 {
    computed.layout.rowGap = edgeOf(value)
  } else if field == 37 {
    computed.layout.columnGap = edgeOf(value)
  } else if field == 38 {
    computed.text.size = numberOf(value)
  } else if field == 39 {
    computed.text.decorationColor = colorOf(value)
    computed.text.hasDecorationColor = true
  } else if field == 40 {
    computed.layout.flexGrow = numberOf(value)
  } else if field == 41 {
    computed.layout.flexShrink = numberOf(value)
  } else if field == 42 {
    match value {
      Sample.Seen { value: seen } => {
        computed.text.visibility = seen
        computed.text.visible = seen == Visibility.Visible
      }
      _ => {}
    }
  } else {
    match value {
      Sample.Shown { value: shown } => {
        computed.layout.display = shown
      }
      Sample.List { value: list } => {
        computed.transform.list = list
      }
      Sample.Function { value: op } => {
        if field == TRANSLATE {
          computed.transform.translate = op
        } else if field == ROTATE {
          computed.transform.rotate = op
        } else {
          computed.transform.scale = op
        }
      }
      Sample.Place { value: origin } => {
        if field == TRANSFORM_ORIGIN {
          computed.transform.origin = origin
        } else {
          computed.transform.perspectiveOrigin = origin
        }
      }
      Sample.Distance { value: distance } => {
        computed.transform.perspective = distance
      }
      Sample.Along { pixels, fraction } => {
        computed.transform.offset.distance = pixels
        computed.transform.offset.distanceFraction = fraction
      }
      Sample.Turn { value: turn, auto } => {
        computed.transform.offset.rotate = turn
        computed.transform.offset.autoRotate = auto
      }
      Sample.Spot { value: spot, kind } => {
        if field == OFFSET_ANCHOR {
          computed.transform.offset.anchor = spot
          computed.transform.offset.anchorAuto = kind != transform.PLACE_SET
        } else {
          computed.transform.offset.position = spot
          computed.transform.offset.positionKind = kind
        }
      }
      _ => {}
    }
  }
}

fn sameColor(a: Rgba<f32>, b: Rgba<f32>) -> bool {
  return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a
}

fn sameFill(a: Fill, b: Fill) -> bool {
  return match a {
    Fill.None => match b {
      Fill.None => true
      _ => false
    }
    Fill.Solid { color } => match b {
      Fill.Solid { color: other } => sameColor(color, other)
      _ => false
    }
    Fill.Gradient { angle, from, to } => match b {
      Fill.Gradient { angle: otherAngle, from: otherFrom, to: otherTo } => angle == otherAngle
        && sameColor(from, otherFrom)
        && sameColor(to, otherTo)
      _ => false
    }
  }
}

fn sameShadow(a: BoxShadow, b: BoxShadow) -> bool {
  return a.offsetX == b.offsetX && a.offsetY == b.offsetY && a.blur == b.blur && a.spread == b.spread
    && a.inset == b.inset
    && sameColor(a.color, b.color)
}

/// Whether two samples of one field are the same value.
pub fn same(a: Sample, b: Sample) -> bool {
  return match a {
    Sample.Number { value } => numberOf(b) == value
    Sample.Color { value } => sameColor(value, colorOf(b))
    Sample.Length { value } => &value == &lengthOf(b)
    Sample.Background { value } => match b {
      Sample.Background { value: other } => sameFill(value, other)
      _ => false
    }
    Sample.Shadow { value, present } => match b {
      Sample.Shadow { value: other, present: otherPresent } => present == otherPresent
        && (!present || sameShadow(value, other))
      _ => false
    }
    Sample.Seen { value } => match b {
      Sample.Seen { value: other } => value == other
      _ => false
    }
    Sample.Shown { value } => match b {
      Sample.Shown { value: other } => &value == &other
      _ => false
    }
    Sample.List { value } => match b {
      Sample.List { value: other } => value.same(&other)
      _ => false
    }
    Sample.Function { value } => match b {
      Sample.Function { value: other } => value.same(&other)
      _ => false
    }
    Sample.Place { value } => match b {
      Sample.Place { value: other } => value.same(&other)
      _ => false
    }
    Sample.Distance { value } => match b {
      Sample.Distance { value: other } => value == other
      _ => false
    }
    Sample.Along { pixels, fraction } => match b {
      Sample.Along { pixels: otherPixels, fraction: otherFraction } => pixels == otherPixels && fraction == otherFraction
      _ => false
    }
    Sample.Turn { value, auto } => match b {
      Sample.Turn { value: other, auto: otherAuto } => value == other && auto == otherAuto
      _ => false
    }
    Sample.Spot { value, kind } => match b {
      Sample.Spot { value: other, kind: otherKind } => kind == otherKind && value.same(&other)
      _ => false
    }
    Sample.Filters { value } => match b {
      Sample.Filters { value: other } => filter_motion.same(&value, &other)
      _ => false
    }
  }
}

fn numeric(kind: DimensionKind) -> bool {
  return kind == DimensionKind.Length || kind == DimensionKind.Percent || kind == DimensionKind.Calc
}

fn transparentLike(color: Rgba<f32>) -> Rgba<f32> {
  return Rgba<f32> { r: color.r, g: color.g, b: color.b, a: 0.0 }
}

fn noShadow(like: BoxShadow) -> BoxShadow {
  return BoxShadow {
    offsetX: 0.0,
    offsetY: 0.0,
    blur: 0.0,
    spread: 0.0,
    color: transparentLike(like.color),
    inset: like.inset,
  }
}

/// Whether the field can ease smoothly from `a` to `b`. A pair that cannot transitions only
/// with `transition-behavior: allow-discrete`, flipping halfway.
pub fn interpolable(a: Sample, b: Sample) -> bool {
  return match a {
    Sample.Length { value } => numeric(value.kind) && numeric(lengthOf(b).kind)
    Sample.Background { value } => match value {
      Fill.Gradient { .. } => match b {
        Sample.Background { value: Fill.Gradient { .. } } => true
        _ => false
      }
      _ => match b {
        Sample.Background { value: Fill.Gradient { .. } } => false
        _ => true
      }
    }
    Sample.Shadow { value, present } => match b {
      Sample.Shadow { value: other, present: otherPresent } => !present || !otherPresent
        || value.inset == other.inset
      _ => false
    }
    Sample.Shown { .. } => false
    Sample.Turn { auto, .. } => match b {
      Sample.Turn { auto: otherAuto, .. } => auto == otherAuto
      _ => false
    }
    Sample.Spot { kind, .. } => match b {
      Sample.Spot { kind: otherKind, .. } => kind == transform.PLACE_SET && otherKind == transform.PLACE_SET
      _ => false
    }
    Sample.Distance { value } => match b {
      Sample.Distance { value: other } => value > 0.0 && other > 0.0
      _ => false
    }
    Sample.Filters { value } => match b {
      Sample.Filters { value: other } => filter_motion.interpolable(&value, &other)
      _ => false
    }
    _ => true
  }
}

fn lerp(a: f32, b: f32, p: f32) -> f32 {
  return a + (b - a) * p
}

// Colors ease premultiplied, as CSS Color 4 interpolates in sRGB.
fn mixColor(a: Rgba<f32>, b: Rgba<f32>, p: f32) -> Rgba<f32> {
  let alpha = lerp(a.a, b.a, p)
  if alpha <= 0.0 {
    return Rgba<f32> { r: lerp(a.r, b.r, p), g: lerp(a.g, b.g, p), b: lerp(a.b, b.b, p), a: 0.0 }
  }
  let clamped = f32.min(1.0, alpha)
  return Rgba<f32> {
    r: lerp(a.r * a.a, b.r * b.a, p) / alpha,
    g: lerp(a.g * a.a, b.g * b.a, p) / alpha,
    b: lerp(a.b * a.a, b.b * b.a, p) / alpha,
    a: clamped,
  }
}

fn solidOf(fill: Fill, other: Fill) -> Rgba<f32> {
  return match fill {
    Fill.Solid { color } => color
    _ => match other {
      Fill.Solid { color } => transparentLike(color)
      _ => Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
    }
  }
}

fn nonNegative(field: u32) -> bool {
  return (field >= 7 && field <= 10) || field == BACKDROP || (field >= 32 && field <= 35)
    || field == FONT_SIZE || field == FLEX_GROW || field == FLEX_SHRINK
}

fn shown(of: Sample) -> bool {
  return match of {
    Sample.Shown { value } => !value.isNone()
    _ => true
  }
}

fn shadowOf(of: Sample) -> BoxShadow {
  return match of {
    Sample.Shadow { value, .. } => value
    _ => noShadow(BoxShadow { offsetX: 0.0, offsetY: 0.0, blur: 0.0, spread: 0.0, color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }, inset: false })
  }
}

fn presentOf(of: Sample) -> bool {
  return match of {
    Sample.Shadow { present, .. } => present
    _ => false
  }
}

fn fillOf(of: Sample) -> Fill {
  return match of {
    Sample.Background { value } => value
    _ => Fill.None
  }
}

fn seenOf(of: Sample) -> Visibility {
  return match of {
    Sample.Seen { value } => value
    _ => Visibility.Visible
  }
}

fn mixNumber(field: u32, a: f32, b: f32, p: f32) -> f32 {
  let mixed = lerp(a, b, p)
  if nonNegative(field) {
    return f32.max(0.0, mixed)
  }
  if field == OPACITY {
    return f32.max(0.0, f32.min(1.0, mixed))
  }
  return mixed
}

fn mixLength(value: SizeValue, other: SizeValue, p: f32) -> SizeValue {
  // A bounded value's bounds are in its own style, and the style being written holds the
  // end's: it switches at the end, as values that do not interpolate do.
  if value.kind == DimensionKind.Bounded || other.kind == DimensionKind.Bounded {
    return other
  }
  let length = lerp(value.value, other.value, p)
  let percent = lerp(value.percent, other.percent, p)
  if value.kind == DimensionKind.Length && other.kind == DimensionKind.Length {
    return SizeValue.px(length)
  }
  if value.kind == DimensionKind.Percent && other.kind == DimensionKind.Percent {
    return SizeValue.pct(percent)
  }
  return SizeValue.calc(length, percent)
}

fn mixFill(value: Fill, other: Fill, p: f32) -> Fill {
  match value {
    Fill.Gradient { angle, from, to } => {
      match other {
        Fill.Gradient { angle: otherAngle, from: otherFrom, to: otherTo } => {
          return Fill.Gradient {
            angle: lerp(angle, otherAngle, p),
            from: mixColor(from, otherFrom, p),
            to: mixColor(to, otherTo, p),
          }
        }
        _ => {
          return value
        }
      }
    }
    _ => {}
  }
  return Fill.Solid { color: mixColor(solidOf(value, other), solidOf(other, value), p) }
}

// A missing shadow eases as a transparent one with no offsets.
fn mixShadow(a: Sample, b: Sample, p: f32) -> Sample {
  let presentA = presentOf(a)
  let presentB = presentOf(b)
  if !presentA && !presentB {
    return a
  }
  let from = if presentA {
    shadowOf(a)
  } else {
    noShadow(shadowOf(b))
  }
  let to = if presentB {
    shadowOf(b)
  } else {
    noShadow(shadowOf(a))
  }
  if p >= 1.0 && !presentB {
    return b
  }
  if p <= 0.0 && !presentA {
    return a
  }
  return Sample.Shadow {
    value: BoxShadow {
      offsetX: lerp(from.offsetX, to.offsetX, p),
      offsetY: lerp(from.offsetY, to.offsetY, p),
      blur: f32.max(0.0, lerp(from.blur, to.blur, p)),
      spread: lerp(from.spread, to.spread, p),
      color: mixColor(from.color, to.color, p),
      inset: from.inset,
    },
    present: true,
  }
}

// Visible for the whole transition when either end is visible.
fn mixSeen(a: Visibility, b: Visibility, p: f32) -> Visibility {
  if p <= 0.0 {
    return a
  }
  if p >= 1.0 {
    return b
  }
  if a == Visibility.Visible || b == Visibility.Visible {
    return Visibility.Visible
  }
  if p < 0.5 {
    return a
  }
  return b
}

/// The value of field `field` at eased progress `p` from `a` to `b`, on a `width` by `height`
/// border box (what transform lists that ease through matrices resolve percentages against).
pub fn mix(field: u32, a: Sample, b: Sample, p: f32, width: f32, height: f32) -> Sample {
  if !interpolable(a, b) {
    // `display` shows for the whole transition when either end is shown.
    if field == DISPLAY && !shown(a) {
      if p > 0.0 {
        return b
      }
      return a
    }
    if field == DISPLAY && !shown(b) {
      if p < 1.0 {
        return a
      }
      return b
    }
    if p < 0.5 {
      return a
    }
    return b
  }
  match a {
    Sample.Number { value } => {
      return Sample.Number { value: mixNumber(field, value, numberOf(b), p) }
    }
    Sample.Color { value } => {
      return Sample.Color { value: mixColor(value, colorOf(b), p) }
    }
    Sample.Length { value } => {
      return Sample.Length { value: mixLength(value, lengthOf(b), p) }
    }
    Sample.Background { value } => {
      return Sample.Background { value: mixFill(value, fillOf(b), p) }
    }
    Sample.Shadow { .. } => {
      return mixShadow(a, b, p)
    }
    Sample.Seen { value } => {
      return Sample.Seen { value: mixSeen(value, seenOf(b), p) }
    }
    Sample.Shown { .. } => {
      return b
    }
    Sample.List { value } => {
      return match b {
        Sample.List { value: other } => Sample.List { value: transform.mixLists(&value, &other, p, width, height) }
        _ => b
      }
    }
    Sample.Function { value } => {
      return match b {
        Sample.Function { value: other } => Sample.Function { value: transform.mixOp(value, other, p) }
        _ => b
      }
    }
    Sample.Place { value } => {
      return match b {
        Sample.Place { value: other } => Sample.Place { value: transform.mixOrigin(value, other, p) }
        _ => b
      }
    }
    Sample.Distance { value } => {
      return Sample.Distance { value: lerp(value, numberOf(b), p) }
    }
    Sample.Along { pixels, fraction } => {
      return match b {
        Sample.Along { pixels: otherPixels, fraction: otherFraction } => Sample.Along {
          pixels: lerp(pixels, otherPixels, p),
          fraction: lerp(fraction, otherFraction, p),
        }
        _ => b
      }
    }
    Sample.Turn { value, auto } => {
      return match b {
        Sample.Turn { value: other, .. } => Sample.Turn { value: lerp(value, other, p), auto: auto }
        _ => b
      }
    }
    Sample.Spot { value, kind } => {
      return match b {
        Sample.Spot { value: other, .. } => Sample.Spot { value: transform.mixOrigin(value, other, p), kind: kind }
        _ => b
      }
    }
    Sample.Filters { value } => {
      return match b {
        Sample.Filters { value: other } => Sample.Filters { value: filter_motion.mix(&value, &other, p) }
        _ => b
      }
    }
  }
}

// Running transitions.

/// One transition of one field of one node.
pub struct Running {
  pub slot: u32,
  pub id: u32,
  pub field: u32,
  pub from: Sample,
  pub to: Sample,
  /// The reversing-adjusted start value and shortening factor (CSS Transitions 1 §3).
  pub reversingFrom: Sample,
  pub factor: f32,
  /// Frame clock seconds when the active phase starts, and how long it lasts.
  pub start: f64,
  pub duration: f64,
  pub easing: Easing,
  /// The border box size a `transform` list eases over.
  pub width: f32,
  pub height: f32,
  /// Whether its `transitionstart` was queued.
  pub started: bool,
}

impl Copy for Running {}

impl Running {
  /// The input progress at `now`, 0 before the start.
  pub fn progress(self: &Self, now: f64) -> f32 {
    if now <= self.start {
      return 0.0
    }
    if self.duration <= 0.0 || now >= self.start + self.duration {
      return 1.0
    }
    return f64.toF32((now - self.start) / self.duration)
  }

  /// The value at `now`, with `linear()` easings from `stops`.
  pub fn at(self: &Self, now: f64, stops: &EasingStops) -> Sample {
    return mix(self.field, self.from, self.to, self.easing.at(self.progress(now), stops), self.width, self.height)
  }

  /// Seconds of the active phase run by `now`, as `elapsedTime`.
  fn elapsed(self: &Self, now: f64) -> f32 {
    return f64.toF32(f64.max(0.0, f64.min(now - self.start, self.duration)))
  }
}

fn find(tree: &UiTree<'_>, slot: u32, id: u32, field: u32) -> usize {
  let list = tree.transitions.asSlice()
  let mut i: usize = 0
  while i < list.length {
    if list[i].slot == slot && list[i].id == id && list[i].field == field {
      return i
    }
    i = i + 1
  }
  return usize.MAX
}

/// Whether the node at `slot` has a running transition.
pub fn running(tree: &UiTree<'_>, slot: u32) -> bool {
  return tree.node(slot).activeTransitions != 0
}

fn listenFlag(kind: EventKind) -> u32 {
  return match kind {
    EventKind.TransitionRun => LISTEN_TRANSITION_RUN
    EventKind.TransitionStart => LISTEN_TRANSITION_START
    EventKind.TransitionEnd => LISTEN_TRANSITION_END
    _ => LISTEN_TRANSITION_CANCEL
  }
}

/// Queues a transition record for `slot` when it or a node above it listens.
effect fn record(tree: &mut UiTree<'_>, kind: EventKind, slot: u32, field: u32, elapsed: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let flag = listenFlag(kind)
  let mut at = slot
  let mut heard = false
  while at != NONE {
    if u32.bitAnd(tree.node(at).listeners, flag) != 0 {
      heard = true
      break
    }
    at = tree.node(at).parent
  }
  if !heard {
    return ()
  }
  let mut path = List<u32>.make()
  run tree.pathTo(slot, &mut path)
  let mut event = Event.make(kind, tree.node(slot).id, move path)
  event.name = run String.copy(unsafe String.fromUtf8Unchecked(fieldName(field)))
  event.pseudoElement = run String.copy(tree.node(slot).pseudoElement())
  event.elapsedTime = elapsed
  run style_change.event(&mut tree, slot, move event)
}

/// Removes running transition `index`, queuing `transitioncancel`.
effect fn cancel(tree: &mut UiTree<'_>, index: usize, now: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let gone = tree.transitions.remove(index)
  if u32.toUsize(gone.slot) < tree.nodes.length() {
    let node = tree.nodeMut(gone.slot)
    if node.live && node.id == gone.id && node.activeTransitions != 0 {
      node.activeTransitions = node.activeTransitions - 1
    }
  }
  run record(&mut tree, EventKind.TransitionCancel, gone.slot, gone.field, gone.elapsed(now))
}

/// Cancels every transition of the node at `slot`.
pub effect fn cancelAll(tree: &mut UiTree<'_>, slot: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if tree.node(slot).activeTransitions == 0 { return () }
  let now = tree.input.time
  let mut i: usize = 0
  while i < tree.transitions.length() {
    if tree.transitions.asSlice()[i].slot == slot {
      run cancel(&mut tree, i, now)
    } else {
      i = i + 1
    }
  }
}

/// Starts, keeps, reverses or cancels the transitions of the node at `slot` for its new
/// style `computed` (CSS Transitions 1 §3, "Starting of transitions"), and writes the values
/// of the running ones over it. `before` is the before-change style; `hasBefore` is false
/// when the node had none (it is new, or it or an ancestor was `display: none`).
pub effect fn transition(
  tree: &mut UiTree<'_>,
  slot: u32,
  before: &Computed,
  hasBefore: bool,
  computed: &mut Computed,
  animated: u64,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let lists = computed.transition
  let mine = tree.transitions.length() != 0 && running(&tree.*, slot)
  if !mine && (!hasBefore || !lists.any(&tree.easingStops)) {
    return ()
  }
  let now = tree.input.time
  let id = tree.node(slot).id
  // The after-change style, before any running transition writes over it: some fields share
  // one value (the four border colors, and the decoration color that follows `color`), and
  // a value one of them writes is not the end another one heads to.
  let target = computed.*
  let mut field: u32 = 0
  while field < FIELDS {
    if u64.bitAnd(animated, u64.shiftLeft(1, u32.toU64(field))) != 0 {
      // An animation sets the field: its value wins over any transition.
      field = field + 1
      continue
    }
    let spec = lists.spec(field, &tree.easingStops)
    if !mine && spec.duration + spec.delay <= 0.0 {
      field = field + 1
      continue
    }
    let moved = run settle(&mut tree, slot, id, field, &spec, before, Option<Sample>.None, hasBefore, sample(&target, field), now, mine)
    if let Option<Sample>.Some { value } = moved {
      write(&mut computed, field, value)
    }
    field = field + 1
  }
  if computed.layout.display.isNone() {
    run cancelAll(&mut tree, slot)
  }
}

// The value field `field` of the node at `slot` shows when its after-change value is
// `after`: a running transition's, a new one's, or None for `after` itself. `previous` is the
// before-change value, `sample(before, field)` when None.
effect fn settle(
  tree: &mut UiTree<'_>,
  slot: u32,
  id: u32,
  field: u32,
  spec: &TransitionSpec,
  before: &Computed,
  previous: Option<Sample>,
  hasBefore: bool,
  after: Sample,
  now: f64,
  mayRun: bool,
) -> Option<Sample>
  ! OutOfMemoryError
  ? &mut Allocator {
  let at = if mayRun { find(&tree.*, slot, id, field) } else { usize.MAX }
  if at != usize.MAX {
    let old = tree.transitions.asSlice()[at]
    if same(old.to, after) {
      // Still heading where it was.
      return Option<Sample>.some(old.at(now, &tree.easingStops))
    }
    let current = old.at(now, &tree.easingStops)
    run cancel(&mut tree, at, now)
    if hasBefore && spec.duration + spec.delay > 0.0 && !same(current, after)
      && (spec.allowDiscrete || interpolable(current, after)) {
      let mut next = startOf(&tree.*, slot, id, field, current, after, spec, now)
      if same(old.reversingFrom, after) {
        // Reversing a transition part way takes as long as the part it undoes.
        let output = old.easing.at(old.progress(now), &tree.easingStops)
        let factor = f32.max(0.0, f32.min(1.0, f32.abs(output * old.factor + 1.0 - old.factor)))
        next.reversingFrom = old.to
        next.factor = factor
        next.duration = next.duration * f32.toF64(factor)
        if spec.delay < 0.0 {
          next.start = now + f32.toF64(spec.delay * factor)
        }
      }
      return Option<Sample>.some(run begin(&mut tree, next, now))
    }
    return Option<Sample>.None
  }
  if hasBefore && spec.duration + spec.delay > 0.0 {
    let from = match previous {
      Option<Sample>.Some { value } => value
      _ => sample(before, field)
    }
    if !same(from, after) && (spec.allowDiscrete || interpolable(from, after)) {
      let next = startOf(&tree.*, slot, id, field, from, after, spec, now)
      return Option<Sample>.some(run begin(&mut tree, next, now))
    }
  }
  return Option<Sample>.None
}

/// Whether the node at `slot` eases its `filter`: an animation sets it (`animated`), a
/// transition of it runs, or one may start because it showed a filter and `lists` transition it.
pub fn filterMoves(tree: &UiTree<'_>, slot: u32, lists: &TransitionLists, animated: u64) -> bool {
  if u64.bitAnd(animated, u64.shiftLeft(1, u32.toU64(FILTER))) != 0 {
    return true
  }
  if tree.node(slot).activeTransitions != 0 && find(tree, slot, tree.node(slot).id, FILTER) != usize.MAX {
    return true
  }
  if let Option.Some { value } = tree.node(slot).paintEffects() {
    if value.filters.length() != 0 {
      let spec = lists.spec(FILTER, &tree.easingStops)
      return spec.duration + spec.delay > 0.0
    }
  }
  return false
}

/// [`transition`] for `filter`, which `Computed` does not hold: `before` is the list the node
/// showed, `after` the one its new style computes. Gives the list to show while a transition
/// runs, None for `after` itself. `style` is the new style, for its `transition-*` lists.
pub effect fn transitionFilter(
  tree: &mut UiTree<'_>,
  slot: u32,
  style: &Computed,
  before: FilterList,
  hasBefore: bool,
  after: FilterList,
  animated: u64,
) -> Option<FilterList>
  ! OutOfMemoryError
  ? &mut Allocator {
  let id = tree.node(slot).id
  let now = tree.input.time
  if u64.bitAnd(animated, u64.shiftLeft(1, u32.toU64(FILTER))) != 0 || style.layout.display.isNone() {
    if tree.node(slot).activeTransitions != 0 {
      let at = find(&tree.*, slot, id, FILTER)
      if at != usize.MAX { run cancel(&mut tree, at, now) }
    }
    return Option<FilterList>.None
  }
  let spec = style.transition.spec(FILTER, &tree.easingStops)
  let mayRun = tree.node(slot).activeTransitions != 0
  let moved = run settle(&mut tree, slot, id, FILTER, &spec, style, Option<Sample>.some(Sample.Filters { value: before }), hasBefore, Sample.Filters { value: after }, now, mayRun)
  return match moved {
    Option<Sample>.Some { value: Sample.Filters { value } } => Option<FilterList>.some(value)
    _ => Option<FilterList>.None
  }
}

/// The border box size of the node at `slot` in the last layout, zero before its first.
pub fn boxSize(tree: &UiTree<'_>, slot: u32) -> [f32; 2] {
  let source = tree.node(slot).css
  if source >= tree.fragmentOf.length() {
    return [0.0, 0.0]
  }
  let index = tree.fragmentOf.get(source)
  if index >= tree.output.fragments.values.length() {
    return [0.0, 0.0]
  }
  let f = tree.output.fragments.values.asSlice()[index]
  return [f.size.width, f.size.height]
}

fn startOf(
  tree: &UiTree<'_>,
  slot: u32,
  id: u32,
  field: u32,
  from: Sample,
  to: Sample,
  spec: &TransitionSpec,
  now: f64,
) -> Running {
  let size: [f32; 2] = if field == TRANSFORM { boxSize(tree, slot) } else { [0.0, 0.0] }
  return Running {
    slot: slot,
    id: id,
    field: field,
    from: from,
    to: to,
    reversingFrom: from,
    factor: 1.0,
    start: now + f32.toF64(spec.delay),
    duration: f32.toF64(spec.duration),
    easing: spec.easing,
    width: size[0],
    height: size[1],
    started: false,
  }
}

// Adds `next`, queues its `transitionrun` (and `transitionstart` when it has no delay left)
// and gives its value now.
effect fn begin(tree: &mut UiTree<'_>, next: Running, now: f64) -> Sample
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut added = next
  run record(&mut tree, EventKind.TransitionRun, added.slot, added.field, added.elapsed(now))
  if now >= added.start {
    added.started = true
    run record(&mut tree, EventKind.TransitionStart, added.slot, added.field, added.elapsed(now))
  }
  let value = added.at(now, &tree.easingStops)
  let targetSlot = added.slot
  run tree.transitions.append(added)
  let target = tree.nodeMut(targetSlot)
  if target.activeTransitions < 255 { target.activeTransitions = target.activeTransitions + 1 }
  return value
}

/// Advances the transitions of the current root to the frame clock: queues the records of
/// the ones that started or ended, and restyles their nodes so the next style resolve
/// writes their new values (and the final value of the ones that ended).
pub effect fn tick(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if tree.transitions.length() == 0 {
    return ()
  }
  let now = tree.input.time
  let mut i: usize = 0
  while i < tree.transitions.length() {
    let item = tree.transitions.asSlice()[i]
    let slot = item.slot
    if u32.toUsize(slot) >= tree.nodes.length() || !tree.node(slot).live || tree.node(slot).id != item.id {
      drop tree.transitions.remove(i)
      continue
    }
    if !tree.holdsCurrent(slot) {
      i = i + 1
      continue
    }
    if !item.started && now >= item.start {
      let mut marked = item
      marked.started = true
      tree.transitions.set(i, marked)
      run record(&mut tree, EventKind.TransitionStart, slot, item.field, item.elapsed(now))
    }
    if now >= item.start + item.duration {
      // Ended: the style shows its final value, and the next resolve starts from it.
      let mut ended = tree.node(slot).computed().*
      write(&mut ended, item.field, item.to)
      run tree.setComputed(slot, &ended)
      if let Sample.Filters { value } = item.to {
        // `filter` shows from the node's paint effects, which the next resolve eases from.
        run tree.recordEndedFilter(slot, item.id, value)
      }
      drop tree.transitions.remove(i)
      let endedNode = tree.nodeMut(slot)
      if endedNode.activeTransitions != 0 { endedNode.activeTransitions = endedNode.activeTransitions - 1 }
      run record(&mut tree, EventKind.TransitionEnd, slot, item.field, f64.toF32(item.duration))
      tree.restyleTick(slot)
      continue
    }
    tree.restyleTick(slot)
    i = i + 1
  }
}

/// Whether the current root has transitions to draw.
pub fn animating(tree: &UiTree<'_>) -> bool {
  let list = tree.transitions.asSlice()
  let mut i: usize = 0
  while i < list.length {
    if tree.holdsCurrent(list[i].slot) {
      return true
    }
    i = i + 1
  }
  return false
}

/// Whether another transition of `slot` moves how its transform maps, besides `translate`.
fn turns(tree: &UiTree<'_>, slot: u32) -> bool {
  let list = tree.transitions.asSlice()
  let mut i: usize = 0
  while i < list.length {
    if list[i].slot == slot && list[i].field >= TRANSFORM && list[i].field <= OFFSET_POSITION
      && list[i].field != TRANSLATE {
      return true
    }
    i = i + 1
  }
  return false
}

/// Finds the `translate` transitions a renderer can run by itself and writes them to
/// `tree.moves` (see [`Move`]), for the frame about to be painted. Only when the host asked
/// (`tree.compositedMoves`), and only for a node whose transform is a plain move at both ends
/// with nothing else easing it. Returns whether the set of nodes changed since the last
/// frame: those paint through another group.
pub effect fn slides(tree: &mut UiTree<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if tree.current != FIRST_ROOT {
    // Only the first window's frames are drawn again by the renderer.
    return false
  }
  let mut m: usize = 0
  while m < tree.moves.length() {
    let slot = tree.moves.get(m).slot
    if u32.toUsize(slot) < tree.nodes.length() {
      let nodes = tree.nodes.asMutSlice()
      nodes[u32.toUsize(slot)].sliding = false
    }
    m = m + 1
  }
  tree.moves.clear()
  let mut key: u64 = 0
  if tree.compositedMoves && !animation.animating(&tree.*) {
    let now = tree.input.time
    let mut i: usize = 0
    while i < tree.transitions.length() {
      let item = tree.transitions.asSlice()[i]
      i = i + 1
      let slot = item.slot
      if item.field != TRANSLATE || item.duration <= 0.0 || u32.toUsize(slot) >= tree.nodes.length()
        || !tree.node(slot).live
        || tree.node(slot).id != item.id
        || !tree.holdsCurrent(slot)
        || tree.node(slot).sliding
        || turns(&tree.*, slot) {
        continue
      }
      let shown = tree.node(slot).computed().*
      if shown.transform.deep() || shown.transform.preserve3d || shown.transform.offset.path != transform.PATH_NONE {
        continue
      }
      let size = boxSize(&tree.*, slot)
      let box = Rect<f32>.new(0.0, 0.0, size[0], size[1])
      let mut first = shown
      write(&mut first, TRANSLATE, item.from)
      let mut last = shown
      write(&mut last, TRANSLATE, item.to)
      let from = transform.flatten(transform.matrix(&first.transform, box))
      let to = transform.flatten(transform.matrix(&last.transform, box))
      if !transform.translation(&from) || !transform.translation(&to) {
        continue
      }
      let mut curve: [f32; 17] = [0.0; 17]
      let mut c: usize = 0
      while c < MOVE_CURVE {
        curve[c] = item.easing.at(usize.toF32(c) / 16.0, &tree.easingStops)
        c = c + 1
      }
      run tree.moves.append(
        Move {
          node: u32.bitOr(MOVE_LINK, item.id),
          slot: slot,
          fromX: from.values[6],
          fromY: from.values[7],
          toX: to.values[6],
          toY: to.values[7],
          began: item.start,
          elapsed: now - item.start,
          duration: item.duration,
          curve: curve,
        },
      )
      let nodes = tree.nodes.asMutSlice()
      nodes[u32.toUsize(slot)].sliding = true
      key = u64.wrappingMultiply(key ^ (u32.toU64(item.id) + 1), 1099511628211)
    }
  }
  let changed = key != tree.movesKey
  tree.movesKey = key
  return changed
}
