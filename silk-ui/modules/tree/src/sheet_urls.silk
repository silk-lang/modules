import svg_css.sheet { Sheet }
import svg_css.sheet_fonts { FaceSource }
import silk.core.result { Result }
import silk.collections.bytes { Bytes }
import silk.uri.percent { UriPercent, PercentComponent }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.uri.uri { Uri, OwnedUri }
import silk.uri.reference { UriReference }

// URI resolution is portable to wasm32; percent-encode raw filename bytes first.
effect fn escaped(text: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut out = Bytes.make()
  let mut at: usize = 0
  while at < bytes.length {
    let byte = bytes[at]
    if byte <= 32 || byte >= 127 || byte == 34 || byte == 60 || byte == 62 || byte == 92 || byte == 94 || byte == 96 || byte == 123 || byte == 124 || byte == 125 {
      let encoded = run UriPercent.encodeOwned(&[byte],PercentComponent.Unreserved)
      run out.append(String.utf8Bytes(String.view(&encoded)))
    } else { run out.append(&[byte]) }
    at = at + 1
  }
  return match move String.fromBytes(move out) { Result.Success { value } => move value _ => run String.copy(text) }
}

pub effect fn rebase(sheet: &mut Sheet, base: string) ! OutOfMemoryError ? &mut Allocator {
  if String.byteLength(base) == 0 { return () }
  let encodedBase = run escaped(base)
  let parsed = Uri.parse(String.view(&encodedBase))
  let baseReference = UriReference.parse(String.view(&encodedBase))
  let path = match &baseReference { Result.Success { value } => UriReference.path(&value) _ => String.view(&encodedBase) }
  let bytes = String.utf8Bytes(path)
  let mut directory = bytes.length
  while directory > 0 && bytes[directory - 1] != 47 { directory = directory - 1 }
  let mut i: usize = 0
  while i < sheet.fontFaces.length() {
    let faces = sheet.fontFaces.asMutSlice()
    let mut j: usize = 0
    while j < faces[i].rule.sources.length() {
      let sources = faces[i].rule.sources.asMutSlice()
      if let FaceSource.Url { url, .. } = &mut sources[j] {
        let referenceText = run escaped(String.view(&url))
        if let Result.Success { value } = &parsed {
          if let Result.Success { value: reference } = UriReference.parse(String.view(&referenceText)) {
            if let Result.Success { value: resolved } = run Uri.resolveOwned(&value,&reference) {
              let view = OwnedUri.view(&resolved)
              url = run String.copy(Uri.format(&view))
            }
          }
        } else if directory != 0 && !String.startsWith(String.view(&url),"/") {
          if let Result.Failure { .. } = Uri.parse(String.view(&url)) {
            let mut joined = run String.copy(String.slice(path,0,directory))
            run String.append(&mut joined,String.view(&referenceText))
            url = move joined
          }
        }
      }
      j = j + 1
    }
    i = i + 1
  }
}
