//! Immutable per-frame geometry, virtual-list, and input-revision snapshots delivered in-band
//! from the Engine thread to the Loom App thread so layout reads never synchronize cross-thread.
import options { VirtualRange }
import silk.collections.list { List }
import silk.concurrency.thread { Transferable }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize

/// Measured layout box, scroll state, and interaction flags for one subscribed node.
pub struct NodeGeometry {
  pub id: u32,
  pub generation: u32,
  pub bounds: Rect<f32>,
  pub scrollX: f32,
  pub scrollY: f32,
  pub scrollWidth: f32,
  pub scrollHeight: f32,
  pub pressed: bool,
  pub hovered: bool,
  pub focused: bool,
}

impl Copy for NodeGeometry {}
impl Transferable for NodeGeometry {}

/// Mounted range and overscan indices for one virtualized container.
pub struct VirtualListSnapshot {
  pub port: u32,
  pub generation: u32,
  pub range: VirtualRange,
  pub indices: List<usize>,
}

impl Transferable for VirtualListSnapshot {}

impl VirtualListSnapshot {
  pub effect fn copy(self: &Self) -> VirtualListSnapshot
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut indices = List<usize>.make()
    run indices.appendSlice(self.indices.asSlice())
    return VirtualListSnapshot {
      port: self.port,
      generation: self.generation,
      range: self.range,
      indices: move indices,
    }
  }
}

/// Measured viewport rectangle and generation of one open root.
pub struct RootSnapshot {
  pub root: u32,
  pub generation: u32,
  pub viewport: Rect<f32>,
}

impl Copy for RootSnapshot {}
impl Transferable for RootSnapshot {}

/// Latest authoritative input revision known by the Engine thread for input node `id`.
pub struct InputRevision {
  pub id: u32,
  pub revision: u64,
}

impl Copy for InputRevision {}
impl Transferable for InputRevision {}

/// Immutable snapshot of Engine geometry and state stamped `(windowGroupId, appliedSeq)`.
pub struct FrameSnapshot {
  pub windowGroupId: u32,
  pub appliedSeq: u64,
  pub rootGeneration: u32,
  pub roots: List<RootSnapshot>,
  pub nodes: List<NodeGeometry>,
  pub virtualLists: List<VirtualListSnapshot>,
  pub inputRevisions: List<InputRevision>,
  pub focusedNode: u32,
}

impl Transferable for FrameSnapshot {}

impl FrameSnapshot {
  pub fn empty(windowGroupId: u32) -> FrameSnapshot {
    return FrameSnapshot {
      windowGroupId: windowGroupId,
      appliedSeq: 0,
      rootGeneration: 0,
      roots: List<RootSnapshot>.make(),
      nodes: List<NodeGeometry>.make(),
      virtualLists: List<VirtualListSnapshot>.make(),
      inputRevisions: List<InputRevision>.make(),
      focusedNode: 0,
    }
  }

  /// Viewport of `root` in CSS pixels, or an empty 0-rect if absent.
  pub fn viewportOf(self: &Self, root: u32) -> Rect<f32> {
    let list = self.roots.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].root == root {
        return list[i].viewport
      }
      i = i + 1
    }
    return Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
  }

  /// Raw geometry of node `id` if present.
  pub fn nodeGeometry(self: &Self, id: u32) -> Option<NodeGeometry> {
    let list = self.nodes.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].id == id {
        return Option<NodeGeometry>.Some { value: list[i] }
      }
      i = i + 1
    }
    return Option<NodeGeometry>.None
  }

  /// Geometry of node `id` only if present and `generation >= minGeneration`.
  pub fn measure(self: &Self, id: u32, minGeneration: u32) -> Option<NodeGeometry> {
    let list = self.nodes.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].id == id {
        if list[i].generation >= minGeneration {
          return Option<NodeGeometry>.Some { value: list[i] }
        }
        return Option<NodeGeometry>.None
      }
      i = i + 1
    }
    return Option<NodeGeometry>.None
  }

  pub fn virtualRange(self: &Self, id: u32) -> Option<VirtualRange> {
    let list = self.virtualLists.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].port == id {
        return Option<VirtualRange>.Some { value: list[i].range }
      }
      i = i + 1
    }
    return Option<VirtualRange>.None
  }

  pub effect fn virtualIndices(self: &Self, id: u32, out: &mut List<usize>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    let list = self.virtualLists.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].port == id {
        run out.appendSlice(list[i].indices.asSlice())
        return true
      }
      i = i + 1
    }
    return false
  }

  pub fn inputRevision(self: &Self, id: u32) -> Option<u64> {
    let list = self.inputRevisions.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].id == id {
        return Option<u64>.Some { value: list[i].revision }
      }
      i = i + 1
    }
    return Option<u64>.None
  }

  pub effect fn copy(self: &Self) -> FrameSnapshot
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut roots = List<RootSnapshot>.make()
    run roots.appendSlice(self.roots.asSlice())
    let mut nodes = List<NodeGeometry>.make()
    run nodes.appendSlice(self.nodes.asSlice())
    let mut virtualLists = List<VirtualListSnapshot>.make()
    let vSlice = self.virtualLists.asSlice()
    let mut i: usize = 0
    while i < vSlice.length {
      run virtualLists.append(run vSlice[i].copy())
      i = i + 1
    }
    let mut inputRevisions = List<InputRevision>.make()
    run inputRevisions.appendSlice(self.inputRevisions.asSlice())
    return FrameSnapshot {
      windowGroupId: self.windowGroupId,
      appliedSeq: self.appliedSeq,
      rootGeneration: self.rootGeneration,
      roots: move roots,
      nodes: move nodes,
      virtualLists: move virtualLists,
      inputRevisions: move inputRevisions,
      focusedNode: self.focusedNode,
    }
  }
}
