//! Async function promises and await continuations, quickjs.c:21622-21769.
import js_realm { Realm, Arguments }
import js_errors as errors
import native_stack { currentFrameAddress }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import runtime_memory { AllocationObserver }
import js_heap { HeapCell, HeapHeader }
import js_core_types { AsyncFrame, ObjectData, ObjectPayload, ObjectPayloadFamily, FunctionBytecode, FunctionKind }
import js_bytecode as bytecodes
import js_vm as vm
import js_value { ValueBits }
import js_object_ref { ObjectRef }
import js_owned_value { Value, ValueRef, lendBits, immediateRef }
