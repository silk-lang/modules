//! CSS Scroll Anchoring 1: a scroll container that is scrolled away from its start keeps what
//! it shows still when content above it changes size. Each such container has an anchor node,
//! the first box in tree order that is fully visible, or the deepest partially visible one;
//! after a layout moves the anchor, the block scroll offset moves by as much.
//!
//! As in Chromium: only the block axis (vertical) anchors; nothing anchors at offset zero;
//! `overflow-anchor: none` on the container turns it off and on a box leaves that box and its
//! subtree out of selection; fixed and sticky boxes are left out; the anchor moves again after
//! every scroll; and a layout change to the anchor or to a box between it and the container
//! (size, margin, padding, insets, position) skips the adjustment (§2.3 suppression).
//! Virtual lists keep their own first visible item, so their ports do not anchor; for an outer
//! container a nested scroll container is a leaf.
import engine { UiTree }
import node { NONE, NO_INDEX }

import paint { borderBox, paddingBox }
import scrollbar { rangeOf, scrolls, usedOverflow }
import mutation { NodeKind, Position }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.usize

const PENDING: u8 = 0
const FOUND: u8 = 1
const EMPTY: u8 = 2

/// A scroll container away from its block start, and its anchor.
pub struct ScrollAnchor {
  pub slot: u32,
  pub id: u32,
  /// The root the container belongs to: fragments are per root.
  pub root: u32,
  state: u8,
  anchor: u32,
  anchorId: u32,
  /// The anchor's top minus the container's, in layout space (scroll offsets left out).
  top: f32,
  /// css-layout's revision when `top` was taken.
  revision: usize,
}

impl Copy for ScrollAnchor {}

fn find(tree: &UiTree<'_>, slot: u32) -> usize {
  let mut i: usize = 0
  while i < tree.scrollAnchors.length() {
    if tree.scrollAnchors.get(i).slot == slot {
      return i
    }
    i = i + 1
  }
  return usize.MAX
}

fn virtualPort(tree: &UiTree<'_>, id: u32) -> bool {
  let mut i: usize = 0
  while i < tree.virtualLists.length() {
    if tree.virtualLists.asSlice()[i].port == id {
      return true
    }
    i = i + 1
  }
  return false
}

/// Whether `slot` anchors: a live box that scrolls vertically, not opted out, not a virtual list.
fn anchors(tree: &UiTree<'_>, slot: u32, id: u32) -> bool {
  if u32.toUsize(slot) >= tree.nodes.length() {
    return false
  }
  let node = tree.node(slot)
  return node.live && node.id == id && node.kind == NodeKind.Box && !node.computed().scroll.anchorNone
    && scrolls(usedOverflow(&node.computed().*, false)) && !virtualPort(tree, id)
}

/// The scroll offset of `slot` changed, other than by an anchoring adjustment: its anchor is
/// chosen again before the next layout that could move it.
pub effect fn scrolled(tree: &mut UiTree<'_>, slot: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let at = find(&tree.*, slot)
  let id = tree.node(slot).id
  if tree.node(slot).scrollY() == 0.0 || !anchors(&tree.*, slot, id) {
    if at != usize.MAX {
      drop tree.scrollAnchors.remove(at)
    }
    return ()
  }
  let entry = ScrollAnchor { slot: slot, id: id, root: tree.current, state: PENDING, anchor: NONE,
    anchorId: 0, top: 0.0, revision: 0 }
  if at != usize.MAX {
    tree.scrollAnchors.set(at, entry)
  } else {
    run tree.scrollAnchors.append(entry)
  }
}

fn fragmentOf(tree: &UiTree<'_>, slot: u32) -> usize {
  let css = tree.node(slot).css
  return if css < tree.fragmentOf.length() { tree.fragmentOf.get(css) } else { NO_INDEX }
}

/// The union of the border boxes of every fragment of `slot`, in layout space.
fn rectOf(tree: &UiTree<'_>, first: usize) -> Rect<f32> {
  let values = tree.output.fragments.values.asSlice()
  let mut rect = borderBox(&values[first])
  let mut at = tree.nextSourceFragment.get(first)
  while at != NO_INDEX {
    let b = borderBox(&values[at])
    rect = Rect<f32>.new(f32.min(rect.xMin, b.xMin), f32.min(rect.yMin, b.yMin), f32.max(rect.xMax, b.xMax),
      f32.max(rect.yMax, b.yMax))
    at = tree.nextSourceFragment.get(at)
  }
  return rect
}

fn skipped(tree: &UiTree<'_>, slot: u32) -> bool {
  let c = &tree.node(slot).computed().*
  if tree.node(slot).kind == NodeKind.Text {
    return false
  }
  return c.scroll.anchorNone || c.layout.display.isNone() || c.layout.position == Position.Fixed
    || c.layout.position == Position.Sticky
}

fn isScroller(tree: &UiTree<'_>, slot: u32) -> bool {
  let c = &tree.node(slot).computed().*
  return tree.node(slot).kind == NodeKind.Box && (scrolls(usedOverflow(c, false)) || scrolls(usedOverflow(c, true)))
}

/// The anchor among the descendants of `parent` that `visible` shows, or NONE. Walks
/// css-layout's children in place: a long list is read, not copied.
fn search(tree: &UiTree<'_>, parent: u32, visible: Rect<f32>) -> u32 {
  let nodes = &tree.layout
  let mut css = nodes.firstChild(tree.node(parent).css)
  while css != NO_INDEX {
    let child = tree.slotOfCssNode(css)
    css = nodes.nextSibling(css)
    if child == NONE || skipped(tree, child) {
      continue
    }
    let at = fragmentOf(tree, child)
    if at == NO_INDEX {
      // `display: contents` has no box of its own; its children stand in its place.
      if tree.node(child).kind == NodeKind.Box {
        let inner = search(tree, child, visible)
        if inner != NONE {
          return inner
        }
      }
      continue
    }
    let r = rectOf(tree, at)
    if r.width() <= 0.0 || r.height() <= 0.0 || r.yMax <= visible.yMin || r.yMin >= visible.yMax
      || r.xMax <= visible.xMin || r.xMin >= visible.xMax {
      continue
    }
    if (r.yMin >= visible.yMin && r.yMax <= visible.yMax && r.xMin >= visible.xMin && r.xMax <= visible.xMax)
      || tree.node(child).kind != NodeKind.Box || isScroller(tree, child) {
      return child
    }
    let inner = search(tree, child, visible)
    return if inner != NONE { inner } else { child }
  }
  return NONE
}

/// Chooses the anchor of entry `i` from the last layout, which must still be current.
effect fn choose(tree: &mut UiTree<'_>, i: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut entry = tree.scrollAnchors.get(i)
  entry.state = EMPTY
  entry.anchor = NONE
  entry.revision = tree.layout.revision()
  let at = fragmentOf(&tree.*, entry.slot)
  if at != NO_INDEX {
    let f = tree.output.fragments.values.asSlice()[at]
    let node = tree.node(entry.slot)
    let port = node.computed().scroll.port(paddingBox(&f))
    let visible = Rect<f32>.new(port.xMin + node.scrollX(), port.yMin + node.scrollY(), port.xMax + node.scrollX(),
      port.yMax + node.scrollY())
    let anchor = search(&tree.*, entry.slot, visible)
    if anchor != NONE {
      entry.state = FOUND
      entry.anchor = anchor
      entry.anchorId = tree.node(anchor).id
      entry.top = rectOf(&tree.*, fragmentOf(&tree.*, anchor)).yMin - borderBox(&f).yMin
    }
  }
  tree.scrollAnchors.set(i, entry)
}

/// Chooses the anchors still to choose from the last layout's fragments. The engine calls it
/// while they still describe every node: before a batch, after styles resolve, after a frame.
pub effect fn select(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if tree.scrollAnchors.length() == 0 {
    return ()
  }
  let mut i: usize = 0
  while i < tree.scrollAnchors.length() {
    let entry = tree.scrollAnchors.get(i)
    if entry.root != tree.current || entry.state != PENDING {
      i = i + 1
    } else if !anchors(&tree.*, entry.slot, entry.id) || tree.node(entry.slot).scrollY() == 0.0 {
      drop tree.scrollAnchors.remove(i)
    } else {
      run choose(&mut tree, i)
      i = i + 1
    }
  }
}

/// Whether a layout change since `since` to the anchor or a box up to the container makes this
/// layout's move of the anchor its own (§2.3 suppression triggers).
fn suppressed(tree: &UiTree<'_>, entry: &ScrollAnchor) -> bool {
  let mut at = entry.anchor
  while at != NONE && at != entry.slot {
    let node = tree.node(at)
    if node.kind == NodeKind.Box && (tree.layout.outerChangedAt(node.css) > entry.revision
      || tree.layout.insetsChangedAt(node.css) > entry.revision) {
      return true
    }
    at = node.parent
  }
  return false
}

/// After a layout of the current root: moves each anchored container by as much as its anchor
/// moved. Returns nothing; the move is a scroll like any other (scroll listeners hear it).
pub effect fn adjust(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < tree.scrollAnchors.length() {
    let mut entry = tree.scrollAnchors.get(i)
    i = i + 1
    if entry.root != tree.current {
      continue
    }
    if entry.state != FOUND {
      // A layout can bring a box into view where there was none.
      entry.state = PENDING
      tree.scrollAnchors.set(i - 1, entry)
      continue
    }
    let anchor = entry.anchor
    // A removed container's slot can be past the end of a trimmed node table: ask first.
    let gone = !anchors(&tree.*, entry.slot, entry.id) || u32.toUsize(anchor) >= tree.nodes.length()
      || !tree.node(anchor).live || tree.node(anchor).id != entry.anchorId
    let box = if gone { NO_INDEX } else { fragmentOf(&tree.*, entry.slot) }
    let at = if box == NO_INDEX { NO_INDEX } else { fragmentOf(&tree.*, anchor) }
    if at == NO_INDEX {
      entry.state = PENDING
      tree.scrollAnchors.set(i - 1, entry)
      continue
    }
    let f = tree.output.fragments.values.asSlice()[box]
    let top = rectOf(&tree.*, at).yMin - borderBox(&f).yMin
    let delta = top - entry.top
    if delta != 0.0 && !suppressed(&tree.*, &entry) {
      let x = tree.node(entry.slot).scrollX()
      let y = rangeOf(&tree.node(entry.slot).computed().*, &f).clampY(tree.node(entry.slot).scrollY() + delta)
      run interact.anchorScroll(&mut tree, entry.slot, x, y)
    }
    entry.top = top
    entry.revision = tree.layout.revision()
    tree.scrollAnchors.set(i - 1, entry)
  }
}

import interact
