//! Object construction from quickjs.c:5721-5889,5939-5959. No JS coercion or
//! intrinsic installation. Raw entry points require a live context, registered
//! class, matching runtime allocator/observer, and borrowed Object-or-Null prototype.
//! Construction consumes shape/property ownership on both success and failure.
//! Class constructors must install their nonempty family payload before exposing it.
import thin_list { ThinList }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.core.option { Option }
import silk.num.u8
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.u32
import silk.num.usize
import runtime_memory { AllocationObserver }
import runtime_memory as memory
import js_core_types as census
import js_heap { HeapCell, HeapHeader, HeapKind }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_realm { Realm }
import js_core_types { ContextState, ObjectData, ObjectPayload, SlotBits,
  ShapeData, FastArrayData, MappedArgumentsData, RegExpData, GlobalObjectData,
  JS_PROP_WRITABLE, JS_PROP_LENGTH, JS_PROP_INITIAL_SIZE, JS_PROP_INITIAL_HASH_SIZE, ExoticCallbacks }
import js_gc { HeapHooks }
import js_gc as gc
import js_allocation_realms as allocationRealms
import js_shapes as shapes
import js_runtime as runtimeApi
import js_class_data as classes
import js_atom_data as atoms
import js_caught { FailedOom, failedOom }
import js_invariant { invariant, present }
import silk.core.effect { Effect }
import silk.core.result { Result }

fn prototypeObject(value: ValueBits) -> ?*mut HeapHeader {
  return match value { ValueBits.Object { reference } => reference _ => Pointer.null<HeapHeader>() }
}
fn boxedClass(classId: u32) -> bool {
  return classId == classes.JS_CLASS_NUMBER || classId == classes.JS_CLASS_STRING
    || classId == classes.JS_CLASS_BOOLEAN || classId == classes.JS_CLASS_SYMBOL
    || classId == classes.JS_CLASS_DATE || classId == classes.JS_CLASS_BIG_INT
}
@inlineAlways
fn initialPayload(classId: u32) -> ObjectPayload {
  if classId == classes.JS_CLASS_ARRAY || classId == classes.JS_CLASS_ARGUMENTS {
    return ObjectPayload.FastArray { array: FastArrayData.empty() }
  }
  if classId == classes.JS_CLASS_MAPPED_ARGUMENTS {
    return ObjectPayload.MappedArguments { arguments: MappedArgumentsData { varRefs: ThinList<*mut HeapHeader>.make() } }
  }
  if boxedClass(classId) { return ObjectPayload.Boxed { value: ValueBits.Undefined } }
  if classId == classes.JS_CLASS_REGEXP {
    return ObjectPayload.RegExp { regexp: RegExpData.of(ValueBits.Null, ValueBits.Null) }
  }
  if classId == classes.JS_CLASS_GLOBAL_OBJECT {
    return ObjectPayload.GlobalObject { global: GlobalObjectData { uninitializedVariables: ValueBits.Undefined } }
  }
  // Source opaque/native-function/bytecode/typed-view pointers are all null here.
  // Empty has no owned edges; the relevant constructor replaces it with its typed payload.
  return ObjectPayload.Empty
}
/// Releases slots laid out by shape.
unsafe fn releaseSlots<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, shape: *mut HeapHeader,
  slots: ThinList<SlotBits>) -> () {
  let mut i: usize = 0
  while i < slots.length() { unsafe gc.releaseProperty(&mut hooks, runtime, unsafe slots.get(i).retire(unsafe shapes.slotFlags(shape, i))) i = i + 1 }
}
unsafe fn releaseSupplied<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, shape: *mut HeapHeader,
  supplied: Option<ThinList<SlotBits>>) -> () {
  match move supplied {
    Option<ThinList<SlotBits>>.Some { value } => { unsafe releaseSlots(&mut hooks, runtime, shape, move value) }
    Option<ThinList<SlotBits>>.None => ()
  }
}
unsafe effect fn initialize<'a>(realm: Realm<'a>, node: *mut HeapHeader,
  supplied: &mut Option<ThinList<SlotBits>>) -> ?*mut HeapHeader ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = ()
  let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let shape = object.shape
  let mut sourceAnchor = ()
  let shapeData = unsafe HeapCell.payload<ShapeData, ()>(&sourceAnchor, shape)
  let capacity = shapeData.properties.capacity()
  let count = shapeData.properties.length()
  drop shapeData
  let mut hasProperties = false
  match &mut supplied.* {
    Option<ThinList<SlotBits>>.Some { value } => {
      // A supplied list owns exactly one initialized slot for each shape property.
      if value.length() != count { Intrinsic.trap("QuickJS invariant violated") }
      if value.capacity() < capacity { let extra = capacity - value.length() run value.reserveExact(extra) }
      hasProperties = true
    }
    Option<ThinList<SlotBits>>.None => ()
  }
  if hasProperties {
    let owned = Intrinsic.replace(supplied.*, Option<ThinList<SlotBits>>.none())
    match move owned {
      Option<ThinList<SlotBits>>.Some { value } => { object.setSlots(move value) }
      Option<ThinList<SlotBits>>.None => { Intrinsic.trap("QuickJS invariant violated") }
    }
    return Pointer.null<HeapHeader>()
  }
  let spareOwner = realm.runtime()
  match unsafe shapes.takeSpareSlots(spareOwner, capacity) {
    Option<ThinList<SlotBits>>.Some { value } => {
      let mut slots = move value
      unsafe fillSlots(&mut slots, count, 0)
      object.setSlots(move slots)
    }
    Option<ThinList<SlotBits>>.None => { object.setSlots(run unsafe shapes.allocateSlots(shape)) }
  }
  let isArray = object.classId() == classes.JS_CLASS_ARRAY
  drop object
  if isArray { return run unsafe arrayLength(realm, node) }
  // C_FUNCTION's first slot is already Undefined, including an empty prototype shape.
  return Pointer.null<HeapHeader>()
}
/// Stores an Array's length 0, adding the length property unless the node already
/// has the context's cached array shape. Returns the shape retired by that add.
unsafe effect fn arrayLength<'a>(realm: Realm<'a>, node: *mut HeapHeader) -> ?*mut HeapHeader
  ! OutOfMemoryError ? &mut Allocator {
  let mut anchor = ()
  let object = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let sourceAnchor = ()
  let ctx = realm.state(&sourceAnchor)
  let cached = ctx.arrayShape
  let runtime = ctx.runtime
  drop ctx
  if Pointer.address<HeapHeader>(cached) == Pointer.address<HeapHeader>(object.shape) {
    object.setSlot(0, SlotBits.value(ValueBits.Int { value: 0 }))
    return Pointer.null<HeapHeader>()
  }
  let added = run unsafe shapes.addProperty(runtime, &mut object, atoms.JS_ATOM_length, u32.toU8(JS_PROP_WRITABLE | JS_PROP_LENGTH))
  object.setSlot(added.index, SlotBits.value(ValueBits.Int { value: 0 }))
  return added.retiredShape
}

// catchFailure handlers for the allocation hot path: Effect.result costs an
// out-of-line Effect.map call, and a pointer success arm cannot be matched yet.
struct AllocatedNode { node: *mut HeapHeader }
/// An uninitialized node with its slot list; every shape property starts Undefined.
struct PreparedNode { node: *mut HeapHeader, slots: ThinList<SlotBits> }
/// A node with room for capacity slots in its cell. A full-size one (the spare
/// cells' size) comes from a spare cell when there is one.
///
/// A plain object's (plain: JS_CLASS_OBJECT, no extra values) payload is always
/// Empty, which needs only the payload's tag word: its slots start right after
/// that word, over the rest of the payload (objects.slotsOverPayload), so a
/// two-slot object takes 96 bytes, not 128. Nothing may store another payload
/// variant into such an object.
@inlineNever
unsafe effect fn allocateInlineCellOrNull<H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver, runtime: *mut HeapHeader, tailBytes: usize) -> ?*mut HeapHeader ? &mut Allocator {
  let _collected = run unsafe runtimeApi.triggerGC(observer, &mut hooks, runtime, Layout.of<ObjectData>().bytes, false)
  let allocated = run Effect.result(HeapCell.allocateUninitWithTail<ObjectData>(HeapKind.Object, tailBytes))
  return match move allocated {
    Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => value
    Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => { drop error Pointer.null<HeapHeader>() }
  }
}
@inlineAlways
unsafe effect fn inlineNode<H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver, runtime: *mut HeapHeader, capacity: usize, count: usize, extra: usize, plain: bool, written: usize) -> PreparedNode ! OutOfMemoryError ? &mut Allocator {
  let mut tailBytes = capacity * Layout.of<SlotBits>().bytes + extra * Layout.of<ValueBits>().bytes
  let over = plain && extra == 0
  if over {
    let reused = Layout.of<ObjectPayload>().bytes - PAYLOAD_TAG_BYTES
    if tailBytes > reused { tailBytes = tailBytes - reused } else { tailBytes = 0 }
  }
  let mut spare = Pointer.null<HeapHeader>()
  // Spare cells come in the INLINE_SLOTS and PAIR_SLOTS tails (ordinary/small),
  // plus WIDE_SLOTS (12) ordinary cells for wide inline arrays (Bin 4).
  let totalTail = usize.wrappingAdd(capacity, extra)
  if extra == 0 && (capacity == shapes.INLINE_SLOTS || capacity == shapes.PAIR_SLOTS) {
    spare = unsafe gc.takeSpareCell(runtime, capacity, over)
  } else if !over && extra != 0 && Layout.of<SlotBits>().bytes == Layout.of<ValueBits>().bytes {
    if totalTail == shapes.INLINE_SLOTS || totalTail == shapes.WIDE_SLOTS {
      spare = unsafe gc.takeSpareCell(runtime, totalTail, false)
    }
  }
  let node = match Pointer.nonNullMut<HeapHeader>(spare) {
    Option<*mut HeapHeader>.Some { value } => unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, value)
    Option<*mut HeapHeader>.None => {
      // Only a fresh cell can take the heap over the GC threshold: a spare one is
      // already counted, so reusing it skips the check.
      let _collected = run unsafe runtimeApi.triggerGC(observer, &mut hooks, runtime, Layout.of<ObjectData>().bytes, false)
      run HeapCell.allocateUninitWithTail<ObjectData>(HeapKind.Object, tailBytes)
    }
  }
  let mut tail = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe HeapCell.tailAddress<ObjectData>(node))
  if over {
    let mut payloadAnchor = ()
    let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut payloadAnchor, node)
    // The tag first: the slots below then overwrite the rest of the payload.
    let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
    unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.Empty)
    drop data
    tail = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(
      unsafe Intrinsic.pointerReinterpret<*mut ObjectPayload, *mut u8>(payload)), PAYLOAD_TAG_BYTES))
  }
  let mut slots = unsafe ThinList<SlotBits>.borrowing(tail, capacity)
  // The caller stores the first `written` slots before anything reads them.
  let mut i = written
  if i > count { i = count }
  unsafe slots.extendFilled(i)
  while i < count { slots.push(SlotBits.value(ValueBits.Undefined)) i = usize.wrappingAdd(i, 1) }
  return PreparedNode { node: node, slots: move slots }
}
/// The most slots a record keeps in its own cell (see recordFromShapeWritten).
const RECORD_INLINE_SLOTS: usize = 24
/// Bytes of ObjectPayload's tag word: an Empty payload's only meaningful bytes.
const PAYLOAD_TAG_BYTES: usize = 8
/// Whether object (a JS_CLASS_OBJECT object) keeps its slots over its payload:
/// all such objects with slots in their own cell do (see inlineNode).
@inlineAlways
pub fn slotsOverPayload(object: &ObjectData) -> bool {
  return object.classId() == classes.JS_CLASS_OBJECT && object.slotsInCell()
}
/// A node for an object of shape, keeping small slot lists in its cell.
/// plan, when not null, is the shape whose slot plan picks the tail: the empty
/// shape a constructor's objects start from, for objects born with its final one.
@inlineAlways
unsafe effect fn prepareNode<H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver, runtime: *mut HeapHeader, shape: *mut HeapHeader, extra: usize, plan: ?*mut HeapHeader, plain: bool, function: bool, written: usize, exact: bool) -> PreparedNode ! OutOfMemoryError ? &mut Allocator {
  let anchor = ()
  let data = unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)
  let capacity = data.properties.capacity()
  let count = data.properties.length()
  let built = u8.toUsize(data.builtSlots)
  drop data
  // A record (exact) takes a tail of just its slots: it is born with its final
  // shape and seldom grows (a later property moves its slots out of the cell).
  if exact && count != 0 && count <= RECORD_INLINE_SLOTS {
    return run unsafe inlineNode(&mut hooks, observer, runtime, count, count, extra, plain, written)
  }
  // A construct plan's object past the inline tail is born with all its slots
  // written: one cell of exactly that many, as the field-by-field build ends with.
  if plain && extra == 0 && written == count && count > shapes.INLINE_SLOTS && count <= shapes.BUILT_SLOTS_LIMIT && !Pointer.isNull<HeapHeader>(plan) {
    return run unsafe inlineNode(&mut hooks, observer, runtime, count, count, extra, plain, written)
  }
  // Inline objects always get the full tail: properties added later (a constructor's
  // this.x = ...) then stay in the cell, and every such cell fits a spare one.
  if capacity <= shapes.INLINE_SLOTS {
    match Pointer.nonNullMut<HeapHeader>(plan) {
      Option<*mut HeapHeader>.Some { value } => {
        let mut tail = unsafe shapes.planInline(value, count)
        if tail != 0 && tail < count { tail = shapes.INLINE_SLOTS }
        if tail >= count { return run unsafe inlineNode(&mut hooks, observer, runtime, tail, count, extra, plain, written) }
      }
      Option<*mut HeapHeader>.None => {
        let mut tail = unsafe shapes.planInline(shape, count)
        if function && tail == shapes.INLINE_SLOTS && count <= shapes.QUAD_SLOTS { tail = shapes.QUAD_SLOTS }
        if tail != 0 { return run unsafe inlineNode(&mut hooks, observer, runtime, tail, count, extra, plain, written) }
        // Objects a constructor builds field by field past the inline tail all
        // reach the size the earlier ones returned with: a tail of exactly that
        // keeps them in one cell, with no slot list to grow on the way.
        if built != 0 { return run unsafe inlineNode(&mut hooks, observer, runtime, built, count, extra, plain, written) }
      }
    }
  }
  return run unsafe separateNode(&mut hooks, observer, runtime, shape, written)
}
/// Writes slots into the uninitialized node's properties.
@inlineAlways
unsafe fn placeSlots(node: *mut HeapHeader, slots: ThinList<SlotBits>) -> *mut HeapHeader {
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  return node
}
/// A plain node with slot storage of its own for shape.
@inlineNever
unsafe effect fn separateNode<H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver, runtime: *mut HeapHeader, shape: *mut HeapHeader, written: usize) -> PreparedNode ! OutOfMemoryError ? &mut Allocator {
  let prepared = run unsafe shapeSlots(runtime, shape, written)
  match move prepared {
    PreparedSlots { slots } => {
      // A small PAIR_SLOTS cell (Bin 3) has zero tail bytes when PAIR_SLOTS
      // fits inside ObjectPayload past its tag word, so it has the exact same
      // allocation layout as a tailless separateNode cell.
      let spare = if Layout.of<ObjectPayload>().bytes >= PAYLOAD_TAG_BYTES + shapes.PAIR_SLOTS * Layout.of<SlotBits>().bytes {
        unsafe gc.takeSpareCell(runtime, shapes.PAIR_SLOTS, true)
      } else {
        Pointer.null<HeapHeader>()
      }
      // On failure the dropped slots release nothing: they hold plain bits.
      let node = match Pointer.nonNullMut<HeapHeader>(spare) {
        Option<*mut HeapHeader>.Some { value } => unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, value)
        Option<*mut HeapHeader>.None => {
          let _collected = run unsafe runtimeApi.triggerGC(observer, &mut hooks, runtime, Layout.of<ObjectData>().bytes, false)
          run HeapCell.allocateUninit<ObjectData>(HeapKind.Object)
        }
      }
      return PreparedNode { node: node, slots: move slots }
    }
  }
}
@inlineAlways
effect fn allocateNode(data: ObjectData) -> AllocatedNode ! OutOfMemoryError ? &mut Allocator {
  return AllocatedNode { node: run HeapCell.allocateInline<ObjectData>(HeapKind.Object, move data) }
}
struct Retired { shape: ?*mut HeapHeader }
@inlineAlways
unsafe effect fn arrayLengthRetired<'a>(realm: Realm<'a>, node: *mut HeapHeader) -> Retired
  ! OutOfMemoryError ? &mut Allocator {
  return Retired { shape: run unsafe arrayLength(realm, node) }
}
struct PreparedSlots { slots: ThinList<SlotBits> }
/// Slot storage for a new object of shape: a parked list of the shape's capacity
/// when one is spare, else a fresh one; every shape property past the first
/// `written` (which the caller stores before anything reads them) starts Undefined.
@inlineAlways
unsafe effect fn shapeSlots(runtime: *mut HeapHeader, shape: *mut HeapHeader, written: usize) -> PreparedSlots
  ! OutOfMemoryError ? &mut Allocator {
  let anchor = ()
  let data = unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)
  // An empty shape whose objects get separate slots starts them at the size its
  // objects grew to (slotHint), so they do not regrow on the way there; and in
  // a spare bin's size, so the list is recycled when the object dies.
  let mut capacity = data.properties.capacity()
  let hint = u8.toUsize(data.slotHint)
  if capacity < hint { capacity = hint }
  capacity = shapes.spareCapacity(capacity)
  let count = data.properties.length()
  drop data
  match unsafe shapes.takeSpareSlots(runtime, capacity) {
    Option<ThinList<SlotBits>>.Some { value } => {
      let mut slots = move value
      unsafe fillSlots(&mut slots, count, written)
      return PreparedSlots { slots: move slots }
    }
    Option<ThinList<SlotBits>>.None => {
      let mut slots = ThinList<SlotBits>.make()
      run slots.reserveExact(capacity)
      unsafe fillSlots(&mut slots, count, written)
      return PreparedSlots { slots: move slots }
    }
  }
}
/// Grows slots (with room for count) to count: the first `written` are left for
/// the caller to store, the rest Undefined.
@inlineAlways
unsafe fn fillSlots(slots: &mut ThinList<SlotBits>, count: usize, written: usize) -> () {
  let mut kept = slots.length()
  if kept < written { let had = kept if written < count { kept = written } else { kept = count } unsafe slots.extendFilled(kept - had) }
  if kept < count { slots.pushRepeated(SlotBits.value(ValueBits.Undefined), count - kept) }
}
/// Frees a node that was never published, with its slots and shape.
unsafe fn discardUnpublished<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let failed = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  let shape = failed.shape
  let slots = failed.takeSlots()
  drop failed
  // Before the cell goes: the slots may live in its tail.
  unsafe releaseSlots(&mut hooks, runtime, shape, move slots)
  unsafe HeapCell.destroy<ObjectData>(node)
  unsafe gc.releaseHeader(&mut hooks, runtime, shape)
}
@inlineAlways
unsafe effect fn initializeRetired<'a>(realm: Realm<'a>, node: *mut HeapHeader,
  supplied: &mut Option<ThinList<SlotBits>>) -> Retired ! OutOfMemoryError ? &mut Allocator {
  return Retired { shape: run unsafe initialize(realm, node, &mut supplied) }
}

/// fromShape without supplied slots: builds the node with its final slot storage,
/// so no empty list is created and dropped and no separate initialize pass runs.
@inlineAlways
unsafe effect fn freshNode<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, ownedShape: *mut HeapHeader, classId: u32,
  exotic: bool, fast: bool, extra: usize, plan: ?*mut HeapHeader) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run unsafe freshNodeWith(&mut hooks, memory, realm, ownedShape, classId, exotic, fast, extra, plan, false, 0, false)
}
/// freshNode, where sized tells an Array whose shape already holds its length
/// record (an exec result's) from one that still needs it added.
@inlineAlways
unsafe effect fn freshNodeWith<'a, H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver, realm: Realm<'a>, ownedShape: *mut HeapHeader, classId: u32,
  exotic: bool, fast: bool, extra: usize, plan: ?*mut HeapHeader, sized: bool, written: usize, exact: bool) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let runtime = realm.runtime()
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  let created = run Intrinsic.catchFailure<OutOfMemoryError>(unsafe prepareNode(&mut hooks, observer, runtime, ownedShape, extra, plan, classId == classes.JS_CLASS_OBJECT, classId == classes.JS_CLASS_BYTECODE_FUNCTION, written, exact), failedOom)
  let fresh = match move created {
    PreparedNode { node, slots } => unsafe placeSlots(node, move slots)
    FailedOom { error } => {
      unsafe gc.releaseHeader(&mut hooks, runtime, ownedShape)
      fail move error
    }
  }
  // The constructor or literal fills the slots next, in the cell's second line
  // (its tail): start loading that line now, while the header is written.
  unsafe memory.prefetch(Pointer.address<HeapHeader>(fresh) + 64)
  // Every field is written in place before the node is read or published.
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let noTail = Layout.of<ObjectPayload>().bytes >= PAYLOAD_TAG_BYTES + shapes.PAIR_SLOTS * Layout.of<SlotBits>().bytes
    && (!data.slotsInCell() || (classId == classes.JS_CLASS_OBJECT && extra == 0 && data.slotCapacity() == shapes.PAIR_SLOTS))
  data.initHeader(classId, ownedShape, exotic, fast, noTail)
  // inlineNode already wrote a plain object's Empty payload tag; its slots fill the rest.
  if !(classId == classes.JS_CLASS_OBJECT && extra == 0 && data.slotsInCell()) {
    unsafe Pointer.put<ObjectPayload>(Pointer.fromMutRef<ObjectPayload>(&mut data.payload), initialPayload(classId))
  }
  // A fast array's extra value slots follow the property slots in an inline
  // cell's tail; other classes own those cells (functionFromShape).
  if fast && extra != 0 && data.slotsInCell() {
    let start = unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(unsafe HeapCell.tailAddress<ObjectData>(fresh)),
      data.slotCapacity() * Layout.of<SlotBits>().bytes)
    match &mut data.payload {
      ObjectPayload.FastArray { array } => {
        unsafe array.put(unsafe ThinList<ValueBits>.borrowing(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ValueBits>(start), extra))
        // No element yet.
        unsafe array.setPlain(true)
      }
      _ => invariant()
    }
  }
  drop data
  if classId == classes.JS_CLASS_ARRAY && !sized {
    let finished = run Intrinsic.catchFailure<OutOfMemoryError>(unsafe arrayLengthRetired(realm, fresh), failedOom)
    match move finished {
      Retired { shape: retired } => {
        unsafe gc.publish(runtime, fresh)
        unsafe gc.releaseOptional(&mut hooks, runtime, retired)
        if unsafe gc.observesFresh(runtime) { run unsafe recordFresh(&mut hooks, realm, fresh) }
        return ValueBits.Object { reference: fresh }
      }
      FailedOom { error } => {
        unsafe discardUnpublished(&mut hooks, runtime, fresh)
        fail move error
      }
    }
  }
  unsafe gc.publishObject(runtime, fresh)
  // One test for both watchers of fresh objects: a restricted debugger
  // evaluation and allocation realm records.
  if unsafe gc.observesFresh(runtime) { run unsafe observedFresh(&mut hooks, realm, fresh) }
  return ValueBits.Object { reference: fresh }
}
/// freshNodeWith's one out-of-line call for an observed fresh object.
@inlineNever
unsafe effect fn observedFresh<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, fresh: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  unsafe gc.noteFreshObserved(realm.runtime(), fresh)
  run unsafe recordFresh(&mut hooks, realm, fresh)
}
/// Records realm as fresh's allocation realm (js_allocation_realms) when realm
/// records them; called only while the runtime observes fresh cells. fresh is
/// published and owned by the caller; when the record cannot be stored, fresh is
/// released and the allocation fails.
@inlineNever
unsafe effect fn recordFresh<'a, H: HeapHooks>(hooks: &mut H, realm: Realm<'a>, fresh: *mut HeapHeader) -> () ! OutOfMemoryError ? &mut Allocator {
  if !allocationRealms.recording(realm) { return () }
  let recorded = run Effect.result(unsafe allocationRealms.record(realm, fresh))
  match move recorded {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => {
      unsafe gc.releaseHeader(&mut hooks, realm.runtime(), fresh)
      fail move error
    }
  }
}
/// ordinaryFromShape for an object born with a constructor's final shape, whose
/// cell tail follows the slot plan of plan, the constructor's empty shape. The
/// caller stores the first `written` slots before anything reads the object.
@inlineAlways
pub unsafe effect fn ordinaryFromPlan<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  ownedShape: *mut HeapHeader, plan: *mut HeapHeader, written: usize) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run unsafe freshNodeWith(&mut hooks, memory, realm, ownedShape, classes.JS_CLASS_OBJECT, false, false, 0,
    unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(plan), false, written, false)
}
/// Pure leaf spare-cell path of ordinaryFromPlan: pops a Bin 1 or Bin 3 spare
/// cell with no GC or OOM possible, retains shape, initializes and publishes
/// the object, and returns it; returns null without modifying anything on miss.
@inlineAlways
pub unsafe fn ordinaryFromPlanSpare(runtime: *mut HeapHeader, shape: *mut HeapHeader, plan: *mut HeapHeader, written: usize, knownTail: usize) -> ?*mut HeapHeader {
  if unsafe gc.observesFresh(runtime) { return Pointer.null<HeapHeader>() }
  let mut tail = knownTail
  if tail != shapes.INLINE_SLOTS && tail != shapes.PAIR_SLOTS {
    if tail != 0 { return Pointer.null<HeapHeader>() }
    let anchor = ()
    let shapeData = unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)
    let capacity = shapeData.properties.capacity()
    let count = shapeData.properties.length()
    drop shapeData
    if capacity > shapes.INLINE_SLOTS || written != count { return Pointer.null<HeapHeader>() }
    tail = unsafe shapes.planInline(plan, count)
    if tail != 0 && tail < count { tail = shapes.INLINE_SLOTS }
    if tail < count || (tail != shapes.INLINE_SLOTS && tail != shapes.PAIR_SLOTS) { return Pointer.null<HeapHeader>() }
  }
  let mut shapeAnchor = ()
  let shapeHeader = unsafe Pointer.borrowMut<(), HeapHeader>(&mut shapeAnchor, shape)
  let refCount = shapeHeader.referenceCount
  if refCount <= 0 { return Pointer.null<HeapHeader>() }
  let spare = unsafe gc.takeSpareCell(runtime, tail, true)
  let fresh = match Pointer.nonNullMut<HeapHeader>(spare) {
    Option<*mut HeapHeader>.Some { value } => unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, value)
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  shapeHeader.referenceCount = i32.wrappingAdd(refCount, 1)
  drop shapeHeader
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  unsafe memory.prefetch(usize.wrappingAdd(Pointer.address<HeapHeader>(fresh), 64))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.Empty)
  let slotBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(
    unsafe Intrinsic.pointerReinterpret<*mut ObjectPayload, *mut u8>(payload)), PAYLOAD_TAG_BYTES))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotBase, tail)
  unsafe slots.extendFilled(written)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  let noTail = tail == shapes.PAIR_SLOTS && Layout.of<ObjectPayload>().bytes >= PAYLOAD_TAG_BYTES + shapes.PAIR_SLOTS * Layout.of<SlotBits>().bytes
  data.initHeader(classes.JS_CLASS_OBJECT, shape, false, false, noTail)
  drop data
  unsafe gc.publishObject(runtime, fresh)
  return fresh
}
/// Fast path of ordinaryFromPlan: takes an unretained final shape and plan,
/// reuses a spare small cell inline or allocates a fresh inline-tail cell up to
/// BUILT_SLOTS_LIMIT without re-probing receiverCache, retains shape, and
/// returns the published node; returns null without modifying anything on miss or OOM.
@inlineAlways
pub unsafe effect fn ordinaryFromPlanFast<H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver,
  runtime: *mut HeapHeader, shape: *mut HeapHeader, plan: *mut HeapHeader, written: usize, knownTail: usize) -> ?*mut HeapHeader ? &mut Allocator {
  if unsafe gc.observesFresh(runtime) { return Pointer.null<HeapHeader>() }
  let mut tail = knownTail
  let mut poolable = true
  if tail != shapes.INLINE_SLOTS && tail != shapes.PAIR_SLOTS {
    poolable = false
    if tail > shapes.INLINE_SLOTS && tail <= shapes.BUILT_SLOTS_LIMIT {
      // Settled non-poolable inline tail (9..BUILT_SLOTS_LIMIT) cached in receiverCache.
    } else {
      let anchor = ()
      let shapeData = unsafe HeapCell.payload<ShapeData, ()>(&anchor, shape)
      let capacity = shapeData.properties.capacity()
      let count = shapeData.properties.length()
      drop shapeData
      if written != count { return Pointer.null<HeapHeader>() }
      if capacity <= shapes.INLINE_SLOTS {
        tail = unsafe shapes.planInline(plan, count)
        if tail != 0 && tail < count { tail = shapes.INLINE_SLOTS }
        if tail < count || (tail != shapes.INLINE_SLOTS && tail != shapes.PAIR_SLOTS) { return Pointer.null<HeapHeader>() }
        poolable = true
      } else if count > shapes.INLINE_SLOTS && count <= shapes.BUILT_SLOTS_LIMIT {
        tail = count
      } else {
        return Pointer.null<HeapHeader>()
      }
    }
  }
  let mut shapeAnchor = ()
  let shapeHeader = unsafe Pointer.borrowMut<(), HeapHeader>(&mut shapeAnchor, shape)
  let refCount = shapeHeader.referenceCount
  if refCount <= 0 { return Pointer.null<HeapHeader>() }
  shapeHeader.referenceCount = i32.wrappingAdd(refCount, 1)
  drop shapeHeader
  let spare = if poolable { unsafe gc.takeSpareCell(runtime, tail, true) } else { Pointer.null<HeapHeader>() }
  let fresh = match Pointer.nonNullMut<HeapHeader>(spare) {
    Option<*mut HeapHeader>.Some { value } => unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, value)
    Option<*mut HeapHeader>.None => {
      let mut tailBytes = usize.wrappingMultiply(tail, Layout.of<SlotBits>().bytes)
      let reused = Layout.of<ObjectPayload>().bytes - PAYLOAD_TAG_BYTES
      if tailBytes > reused { tailBytes = usize.wrappingSubtract(tailBytes, reused) } else { tailBytes = 0 }
      match Pointer.nonNullMut<HeapHeader>(run unsafe allocateInlineCellOrNull(&mut hooks, observer, runtime, tailBytes)) {
        Option<*mut HeapHeader>.Some { value } => value
        Option<*mut HeapHeader>.None => {
          unsafe gc.releaseHeader(&mut hooks, runtime, shape)
          return Pointer.null<HeapHeader>()
        }
      }
    }
  }
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  unsafe memory.prefetch(usize.wrappingAdd(Pointer.address<HeapHeader>(fresh), 64))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.Empty)
  let slotBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(
    unsafe Intrinsic.pointerReinterpret<*mut ObjectPayload, *mut u8>(payload)), PAYLOAD_TAG_BYTES))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotBase, tail)
  unsafe slots.extendFilled(written)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  let noTail = tail == shapes.PAIR_SLOTS && Layout.of<ObjectPayload>().bytes >= PAYLOAD_TAG_BYTES + shapes.PAIR_SLOTS * Layout.of<SlotBits>().bytes
  data.initHeader(classes.JS_CLASS_OBJECT, shape, false, false, noTail)
  drop data
  unsafe gc.publishObject(runtime, fresh)
  return fresh
}
/// Lean fast path of ordinaryFromShape for an empty plain object shape
/// (createReceiver's cached empty shape): one inline allocation path with no
/// extra/record/plan branches or OOM landing pads; returns Uninitialized on OOM
/// after releasing ownedShape.
@inlineAlways
pub unsafe effect fn ordinaryFromEmptyShapeOrUninit<'a, H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver,
  realm: Realm<'a>, ownedShape: *mut HeapHeader) -> ValueBits ? &mut Allocator {
  let runtime = realm.runtime()
  if unsafe gc.observesFresh(runtime) {
    return run unsafe ordinaryFromShapeOrUninitSlow(&mut hooks, observer, realm, ownedShape)
  }
  let mut tail = unsafe shapes.planInline(ownedShape, 0)
  if tail == 0 {
    let anchor = ()
    let built = u8.toUsize((unsafe HeapCell.payload<ShapeData, ()>(&anchor, ownedShape)).builtSlots)
    if built == 0 {
      return run unsafe ordinaryFromShapeOrUninitSlow(&mut hooks, observer, realm, ownedShape)
    }
    tail = built
  }
  let mut spare = Pointer.null<HeapHeader>()
  if tail == shapes.INLINE_SLOTS || tail == shapes.PAIR_SLOTS {
    spare = unsafe gc.takeSpareCell(runtime, tail, true)
  }
  let fresh = match Pointer.nonNullMut<HeapHeader>(spare) {
    Option<*mut HeapHeader>.Some { value } => unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, value)
    Option<*mut HeapHeader>.None => {
      let mut tailBytes = usize.wrappingMultiply(tail, Layout.of<SlotBits>().bytes)
      let reused = Layout.of<ObjectPayload>().bytes - PAYLOAD_TAG_BYTES
      if tailBytes > reused { tailBytes = usize.wrappingSubtract(tailBytes, reused) } else { tailBytes = 0 }
      match Pointer.nonNullMut<HeapHeader>(run unsafe allocateInlineCellOrNull(&mut hooks, observer, runtime, tailBytes)) {
        Option<*mut HeapHeader>.Some { value } => value
        Option<*mut HeapHeader>.None => {
          unsafe gc.releaseHeader(&mut hooks, runtime, ownedShape)
          return ValueBits.Uninitialized
        }
      }
    }
  }
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  unsafe memory.prefetch(usize.wrappingAdd(Pointer.address<HeapHeader>(fresh), 64))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.Empty)
  let slotBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(
    unsafe Intrinsic.pointerReinterpret<*mut ObjectPayload, *mut u8>(payload)), PAYLOAD_TAG_BYTES))
  let slots = unsafe ThinList<SlotBits>.borrowing(slotBase, tail)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  let noTail = tail == shapes.PAIR_SLOTS && Layout.of<ObjectPayload>().bytes >= PAYLOAD_TAG_BYTES + shapes.PAIR_SLOTS * Layout.of<SlotBits>().bytes
  data.initHeader(classes.JS_CLASS_OBJECT, ownedShape, false, false, noTail)
  drop data
  unsafe gc.publishObject(runtime, fresh)
  return ValueBits.Object { reference: fresh }
}
@inlineNever
unsafe effect fn ordinaryFromShapeOrUninitSlow<'a, H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver,
  realm: Realm<'a>, ownedShape: *mut HeapHeader) -> ValueBits ? &mut Allocator {
  let created = run Intrinsic.catchFailure<OutOfMemoryError>(
    unsafe freshNode(&mut hooks, observer, realm, ownedShape, classes.JS_CLASS_OBJECT, false, false, 0, Pointer.null<HeapHeader>()), failedOom)
  return match move created {
    ValueBits value => value
    FailedOom { error } => { drop error ValueBits.Uninitialized }
  }
}
/// fromShape for a plain JS_CLASS_OBJECT with no supplied slots (constructed
/// receivers, object literals): the class table lookup and the array and
/// exotic-class branches fold away.
@inlineAlways
pub unsafe effect fn ordinaryFromShape<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  ownedShape: *mut HeapHeader) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run unsafe freshNode(&mut hooks, memory, realm, ownedShape, classes.JS_CLASS_OBJECT, false, false, 0, Pointer.null<HeapHeader>())
}
/// ordinaryFromShape for a caller that stores the first `written` slots before
/// anything reads the object (a spread's clone stores them all).
pub unsafe effect fn ordinaryFromShapeWritten<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  ownedShape: *mut HeapHeader, written: usize) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run unsafe freshNodeWith(&mut hooks, memory, realm, ownedShape, classes.JS_CLASS_OBJECT, false, false, 0, Pointer.null<HeapHeader>(), false, written, false)
}
/// ordinaryFromShapeWritten for a record: an object born with its final shape
/// that seldom gains properties (a database row). Up to RECORD_INLINE_SLOTS slots
/// sit in a tail of just their count, so a six-field row takes a 160-byte cell
/// instead of 192 and a wider row still takes one allocation; a property added
/// later moves the slots out.
pub unsafe effect fn recordFromShapeWritten<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  ownedShape: *mut HeapHeader, written: usize) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run unsafe freshNodeWith(&mut hooks, memory, realm, ownedShape, classes.JS_CLASS_OBJECT, false, false, 0, Pointer.null<HeapHeader>(), false, written, true)
}
/// ordinaryFromShape for a RegExp (a RegExp literal's object): not exotic, not
/// a fast array, so the class table lookup folds away as well.
pub unsafe effect fn regexpFromShape<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  ownedShape: *mut HeapHeader) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run unsafe freshNode(&mut hooks, memory, realm, ownedShape, classes.JS_CLASS_REGEXP, false, false, 0, Pointer.null<HeapHeader>())
}
/// Consumes ownedShape and supplied slots, including OOM. Native slot storage is
/// transferred when supplied, avoiding a redundant copy; capacity still covers shape.
/// No class finalizer runs for an allocation that was never published.
pub unsafe effect fn fromShape<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, ownedShape: *mut HeapHeader, classId: u32,
  mut properties: Option<ThinList<SlotBits>>) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let runtime = realm.runtime()
  let anchor = ()
  let state = realm.runtimeState(&anchor)
  let mut exotic = match &state.classes.asSlice()[u32.toUsize(classId)].exotic {
    Option<ExoticCallbacks>.Some { .. } => true Option<ExoticCallbacks>.None => false
  }
  drop state
  let fast = classId == classes.JS_CLASS_ARRAY || classId == classes.JS_CLASS_ARGUMENTS
    || classId == classes.JS_CLASS_MAPPED_ARGUMENTS
    || (classId >= classes.JS_CLASS_UINT8C_ARRAY && classId <= classes.JS_CLASS_FLOAT64_ARRAY)
  if fast { exotic = true }
  // These source switch arms deliberately bypass the generic exotic descriptor.
  if classId == classes.JS_CLASS_OBJECT || classId == classes.JS_CLASS_C_FUNCTION
    || classId == classes.JS_CLASS_DATAVIEW || classId == classes.JS_CLASS_REGEXP
    || classId == classes.JS_CLASS_GLOBAL_OBJECT { exotic = false }
  let hasSupplied = match &properties {
    Option<ThinList<SlotBits>>.Some { .. } => true Option<ThinList<SlotBits>>.None => false
  }
  if !hasSupplied { return run unsafe freshNode(&mut hooks, memory, realm, ownedShape, classId, exotic, fast, 0, Pointer.null<HeapHeader>()) }
  let _collected = run unsafe runtimeApi.triggerGC(memory, &mut hooks, runtime, Layout.of<ObjectData>().bytes, false)
  let allocated = run Intrinsic.catchFailure<OutOfMemoryError>(allocateNode(ObjectData.make(classId, ownedShape, ThinList<SlotBits>.make(), initialPayload(classId), exotic, fast)), failedOom)
  let node = match move allocated {
    AllocatedNode { node } => node
    FailedOom { error } => {
      unsafe releaseSupplied(&mut hooks, runtime, ownedShape, move properties)
      unsafe gc.releaseHeader(&mut hooks, runtime, ownedShape)
      fail move error
    }
  }
  // Initialized in place: a moved copy of the Option was re-read through a
  // misaligned overlapping store (a store-forwarding stall on every object).
  let initialized = run Intrinsic.catchFailure<OutOfMemoryError>(unsafe initializeRetired(realm, node, &mut properties), failedOom)
  match move initialized {
    Retired { shape: retired } => {
      unsafe gc.publish(runtime, node)
      unsafe gc.releaseOptional(&mut hooks, runtime, retired)
      if unsafe gc.observesFresh(runtime) { run unsafe recordFresh(&mut hooks, realm, node) }
      return ValueBits.Object { reference: node }
    }
    FailedOom { error } => {
      unsafe releaseSupplied(&mut hooks, runtime, ownedShape, move properties)
      unsafe discardUnpublished(&mut hooks, runtime, node)
      fail move error
    }
  }
}
/// fromShape without supplied slots for a function class, with extra 16-byte
/// cells after the property slots of an inline cell's tail for the caller (a
/// closure's reference table, js_closures.fill); extra is 0 for none. The cells
/// start at functionTail when the slots are in the cell, and are unused otherwise.
pub unsafe effect fn functionFromShape<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  ownedShape: *mut HeapHeader, classId: u32, extra: usize) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let _collected = run unsafe runtimeApi.triggerGC(memory, &mut hooks, realm.runtime(), Layout.of<ObjectData>().bytes, false)
  return run unsafe freshNode(&mut hooks, memory, realm, ownedShape, classId, false, false, extra, Pointer.null<HeapHeader>())
}
/// Where functionFromShape's extra cells start in node, or null when its slots
/// are not in its cell.
pub unsafe fn functionTail(node: *mut HeapHeader) -> ?*mut u8 {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if !data.slotsInCell() { return Pointer.null<u8>() }
  let offset = data.slotCapacity() * Layout.of<SlotBits>().bytes
  drop data
  return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(unsafe HeapCell.tailAddress<ObjectData>(node)), offset)
}
pub effect fn withPrototypeClass<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, prototype: ValueRef<'b>, classId: u32) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let runtime = realm.runtime()
  let shape = run unsafe gc.cachedEmpty(&mut hooks, runtime, prototypeObject(prototype.view()))
  if classId == classes.JS_CLASS_OBJECT { return run unsafe ordinaryFromShape(&mut hooks, memory, realm, shape) }
  return run unsafe fromShape(&mut hooks, memory, realm, shape, classId, Option<ThinList<SlotBits>>.none())
}
/// Unshared shape for prototypes/constructors whose property layout is not interned.
pub effect fn withPrototypeClassCapacity<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, prototype: ValueRef<'b>, classId: u32, propertyCapacity: i32) -> ValueBits
  ! OutOfMemoryError ? &mut Allocator {
  let runtime = realm.runtime()
  let mut capacity = JS_PROP_INITIAL_SIZE
  let mut hashSize = JS_PROP_INITIAL_HASH_SIZE
  if propertyCapacity > 2 {
    capacity = i32.toUsize(propertyCapacity)
    hashSize = 1
    while hashSize < capacity * 4 { hashSize = hashSize * 2 }
  }
  let shape = run unsafe shapes.createUnhashed(runtime, prototypeObject(prototype.view()), hashSize, capacity)
  return run unsafe fromShape(&mut hooks, memory, realm, shape, classId, Option<ThinList<SlotBits>>.none())
}
@inlineAlways
pub effect fn withClass<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, classId: u32) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run withPrototypeClass(&mut hooks, memory, realm, realm.classPrototype(classId), classId)
}
pub effect fn withPrototype<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>, prototype: ValueRef<'b>) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run withPrototypeClass(&mut hooks, memory, realm, prototype, classes.JS_CLASS_OBJECT)
}
// Owned-result forms of object/array/withPrototype.
@inlineAlways
pub effect fn newObject<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> Value ! OutOfMemoryError ? &mut Allocator {
  return unsafe Value.adoptBits(run object(&mut hooks, memory, realm))
}
@inlineAlways
pub effect fn newArray<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>) -> Value ! OutOfMemoryError ? &mut Allocator {
  return unsafe Value.adoptBits(run array(&mut hooks, memory, realm))
}
@inlineAlways
pub effect fn newWithPrototype<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, prototype: ValueRef<'b>) -> Value ! OutOfMemoryError ? &mut Allocator {
  return unsafe Value.adoptBits(run withPrototype(&mut hooks, memory, realm, prototype))
}
@inlineAlways
pub effect fn newWithPrototypeClass<'a, 'b, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, prototype: ValueRef<'b>, classId: u32) -> Value ! OutOfMemoryError ? &mut Allocator {
  return unsafe Value.adoptBits(run withPrototypeClass(&mut hooks, memory, realm, prototype, classId))
}
@inlineAlways
pub effect fn newWithClass<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, classId: u32) -> Value ! OutOfMemoryError ? &mut Allocator {
  return unsafe Value.adoptBits(run withClass(&mut hooks, memory, realm, classId))
}
pub effect fn object<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  return run withClass(&mut hooks, memory, realm, classes.JS_CLASS_OBJECT)
}
/// Fast path for 1..(WIDE_SLOTS - 1) element array literals: borrows a Bin 0 or
/// Bin 4 cell directly, writes the length slot and elements via ValueBits.copyScan,
/// and preserves FastArrayData.plain when no element is a heap value. Returns
/// Uninitialized without side effects on miss, OOM, or observed fresh allocations.
@inlineAlways
pub unsafe effect fn literalArrayFast<H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver,
  context: *mut HeapHeader, runtime: *mut HeapHeader, values: *const ValueBits, count: usize) -> ValueBits ? &mut Allocator {
  if count == 0 || count >= shapes.WIDE_SLOTS || Layout.of<SlotBits>().bytes != Layout.of<ValueBits>().bytes || unsafe gc.observesFresh(runtime) {
    return ValueBits.Uninitialized
  }
  let ctxAnchor = ()
  let shapeOpt = (unsafe HeapCell.payload<ContextState, ()>(&ctxAnchor, context)).arrayShape
  let shape = match Pointer.nonNullMut<HeapHeader>(shapeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return ValueBits.Uninitialized }
  }
  let shapeAnchor = ()
  if (unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, shape)).properties.length() != 1 {
    return ValueBits.Uninitialized
  }
  let totalTail = if count < shapes.INLINE_SLOTS { shapes.INLINE_SLOTS } else { shapes.WIDE_SLOTS }
  let extra = usize.wrappingSubtract(totalTail, 1)
  unsafe HeapCell.retain(shape)
  let spare = unsafe gc.takeSpareCell(runtime, totalTail, false)
  let fresh = match Pointer.nonNullMut<HeapHeader>(spare) {
    Option<*mut HeapHeader>.Some { value } => unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, value)
    Option<*mut HeapHeader>.None => {
      let tailBytes = usize.wrappingMultiply(totalTail, Layout.of<ValueBits>().bytes)
      match Pointer.nonNullMut<HeapHeader>(run unsafe allocateInlineCellOrNull(&mut hooks, observer, runtime, tailBytes)) {
        Option<*mut HeapHeader>.Some { value } => value
        Option<*mut HeapHeader>.None => {
          unsafe gc.releaseHeader(&mut hooks, runtime, shape)
          return ValueBits.Uninitialized
        }
      }
    }
  }
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  unsafe memory.prefetch(usize.wrappingAdd(Pointer.address<HeapHeader>(fresh), 64))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let tailRaw = unsafe HeapCell.tailAddress<ObjectData>(fresh)
  let slotBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(tailRaw)
  unsafe Pointer.put<SlotBits>(slotBase, SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotBase, 1)
  unsafe slots.extendFilled(1)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  let valueBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ValueBits>(unsafe Pointer.atMut<u8>(
    unsafe Pointer.assumeManyMut<u8>(tailRaw), Layout.of<SlotBits>().bytes))
  let heap = unsafe ValueBits.copyScan(unsafe Pointer.assumeManyMut<ValueBits>(valueBase), unsafe Pointer.assumeMany<ValueBits>(values), count)
  let mut items = unsafe ThinList<ValueBits>.borrowing(valueBase, extra)
  unsafe items.extendFilled(count)
  let array = if !heap { unsafe FastArrayData.ofPlain(move items) } else { FastArrayData.of(move items) }
  unsafe Pointer.put<ObjectPayload>(Pointer.fromMutRef<ObjectPayload>(&mut data.payload), ObjectPayload.FastArray { array: move array })
  data.initHeader(classes.JS_CLASS_ARRAY, shape, true, true, false)
  drop data
  unsafe gc.publishObject(runtime, fresh)
  return ValueBits.Object { reference: fresh }
}
/// An array literal's array of count values (1 to LITERAL_TAIL_VALUES), moved
/// from values into the cell's tail: arrayWithCapacity and the copy without the
/// generic construction layers. Takes the values only on success. Always inlined:
/// OP_array_from's allocation fast path (arrayFrom) depends on it, and LLVM's own
/// choice flips with unrelated code changes (Splay +1.4% when it stays out of line).
@inlineAlways
pub unsafe effect fn literalArray<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  values: *const ValueBits, count: usize) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let _context = realm.context()
  let runtime = realm.runtime()
  let anchor = ()
  let ctx = realm.state(&anchor)
  let shape = present(ctx.arrayShape)
  drop ctx
  unsafe HeapCell.retain(shape)
  // The context's array shape already holds length (as arrayLength relies on), set below.
  // Short literals (1..=7) reuse Bin 0 (1 slot + 7 values = INLINE_SLOTS);
  // 8..=11 reuse Bin 4 (1 slot + 11 values = WIDE_SLOTS).
  let mut extra: usize = count
  let mut exact = false
  if count >= 1 && count <= LITERAL_TAIL_VALUES {
    exact = true
    if count <= shapes.INLINE_SLOTS - 1 { extra = shapes.INLINE_SLOTS - 1 }
    else if count <= shapes.WIDE_SLOTS - 1 { extra = shapes.WIDE_SLOTS - 1 }
  }
  let array = run unsafe freshNodeWith(&mut hooks, memory, realm, shape, classes.JS_CLASS_ARRAY, true, true, extra, Pointer.null<HeapHeader>(), true, 0, exact)
  let node = match array { ValueBits.Object { reference } => reference _ => invariant() }
  let placedAnchor = ()
  let placed = match &(unsafe HeapCell.payload<ObjectData, ()>(&placedAnchor, node)).payload {
    ObjectPayload.FastArray { array: fast } => fast.values().capacity() >= count
    _ => false
  }
  if !placed {
    let reserved = run Effect.result(unsafe reserveValues(runtime, node, count))
    match move reserved {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => {
        unsafe gc.release(&mut hooks, runtime, array)
        fail move error
      }
    }
  }
  let mut madeAnchor = ()
  let made = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut madeAnchor, node)
  match &mut made.payload {
    ObjectPayload.FastArray { array: fast } => {
      let spare = unsafe (unsafe fast.plainMut()).spareFor(count)
      let heap = unsafe ValueBits.copyScan(spare, unsafe Pointer.assumeMany<ValueBits>(values), count)
      unsafe (unsafe fast.plainMut()).extendFilled(count)
      unsafe fast.setPlain(!heap)
    }
    _ => invariant()
  }
  made.setSlot(0, SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  return array
}
/// Fast path for 1..(WIDE_SLOTS - 1) element copied arrays (Object.keys from
/// shape.enumKeys): borrows a Bin 0 or Bin 4 spare cell directly, copies and
/// retains elements in one loop, and publishes without arrayWithCapacity or
/// freshNodeWith. Returns Uninitialized on miss, OOM, or observed fresh allocs.
@inlineAlways
pub unsafe effect fn copiedArrayFast<H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver,
  context: *mut HeapHeader, runtime: *mut HeapHeader, values: *const ValueBits, count: usize) -> ValueBits ? &mut Allocator {
  if count == 0 || count >= shapes.WIDE_SLOTS || Layout.of<SlotBits>().bytes != Layout.of<ValueBits>().bytes || unsafe gc.observesFresh(runtime) {
    return ValueBits.Uninitialized
  }
  let ctxAnchor = ()
  let shapeOpt = (unsafe HeapCell.payload<ContextState, ()>(&ctxAnchor, context)).arrayShape
  let shape = match Pointer.nonNullMut<HeapHeader>(shapeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return ValueBits.Uninitialized }
  }
  let shapeAnchor = ()
  if (unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, shape)).properties.length() != 1 {
    return ValueBits.Uninitialized
  }
  let totalTail = if count < shapes.INLINE_SLOTS { shapes.INLINE_SLOTS } else { shapes.WIDE_SLOTS }
  let extra = usize.wrappingSubtract(totalTail, 1)
  unsafe HeapCell.retain(shape)
  let spare = unsafe gc.takeSpareCell(runtime, totalTail, false)
  let fresh = match Pointer.nonNullMut<HeapHeader>(spare) {
    Option<*mut HeapHeader>.Some { value } => unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, value)
    Option<*mut HeapHeader>.None => {
      let tailBytes = usize.wrappingMultiply(totalTail, Layout.of<ValueBits>().bytes)
      match Pointer.nonNullMut<HeapHeader>(run unsafe allocateInlineCellOrNull(&mut hooks, observer, runtime, tailBytes)) {
        Option<*mut HeapHeader>.Some { value } => value
        Option<*mut HeapHeader>.None => {
          unsafe gc.releaseHeader(&mut hooks, runtime, shape)
          return ValueBits.Uninitialized
        }
      }
    }
  }
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  unsafe memory.prefetch(usize.wrappingAdd(Pointer.address<HeapHeader>(fresh), 64))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let tailRaw = unsafe HeapCell.tailAddress<ObjectData>(fresh)
  let slotBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(tailRaw)
  unsafe Pointer.put<SlotBits>(slotBase, SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotBase, 1)
  unsafe slots.extendFilled(1)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  let valueBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ValueBits>(unsafe Pointer.atMut<u8>(
    unsafe Pointer.assumeManyMut<u8>(tailRaw), Layout.of<SlotBits>().bytes))
  let src = unsafe Pointer.assumeMany<ValueBits>(values)
  let dst = unsafe Pointer.assumeManyMut<ValueBits>(valueBase)
  let mut heap = false
  let mut i: usize = 0
  while i < count {
    let v = unsafe Pointer.read<ValueBits>(unsafe Pointer.at<ValueBits>(src, i))
    if v.tag() < 0 {
      heap = true
      drop unsafe v.retained()
    }
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(dst, i), v)
    i = usize.wrappingAdd(i, 1)
  }
  let mut items = unsafe ThinList<ValueBits>.borrowing(valueBase, extra)
  unsafe items.extendFilled(count)
  let array = if !heap { unsafe FastArrayData.ofPlain(move items) } else { FastArrayData.of(move items) }
  unsafe Pointer.put<ObjectPayload>(Pointer.fromMutRef<ObjectPayload>(&mut data.payload), ObjectPayload.FastArray { array: move array })
  data.initHeader(classes.JS_CLASS_ARRAY, shape, true, true, false)
  drop data
  unsafe gc.publishObject(runtime, fresh)
  return ValueBits.Object { reference: fresh }
}
/// An Array of count values copied from values, each retained (Object.keys
/// from a shape's enumeration cache): arrayWithCapacity and one block copy.
pub unsafe effect fn copiedArray<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  values: *const ValueBits, count: usize) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  if count >= 1 && count < shapes.WIDE_SLOTS {
    let fast = run unsafe copiedArrayFast(&mut hooks, memory, realm.context(), realm.runtime(), values, count)
    if fast.isObject() { return fast }
  }
  let array = run arrayWithCapacity(&mut hooks, memory, realm, count)
  if count == 0 { return array }
  let node = match array { ValueBits.Object { reference } => reference _ => invariant() }
  let mut madeAnchor = ()
  let made = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut madeAnchor, node)
  match &mut made.payload {
    ObjectPayload.FastArray { array: fast } => { unsafe fast.valuesMut().pushCopies(values, count) }
    _ => invariant()
  }
  made.setSlot(0, SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  let mut i: usize = 0
  while i < count {
    let value = unsafe Pointer.read<ValueBits>(unsafe Pointer.at<ValueBits>(unsafe Pointer.assumeMany<ValueBits>(values), i))
    if let Option<*mut HeapHeader>.Some { value: cell } = ValueBits.heapReference(&value) { unsafe HeapCell.retain(cell) }
    i = i + 1
  }
  return array
}
/// An Array of count string values copied from string HeapHeader pointers, each retained.
pub unsafe effect fn copiedStringArray<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  values: *const *mut HeapHeader, count: usize) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let array = run arrayWithCapacity(&mut hooks, memory, realm, count)
  if count == 0 { return array }
  let node = match array { ValueBits.Object { reference } => reference _ => invariant() }
  let mut madeAnchor = ()
  let made = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut madeAnchor, node)
  match &mut made.payload {
    ObjectPayload.FastArray { array: fast } => {
      let dst = unsafe fast.valuesMut().spareFor(count)
      let src = unsafe Pointer.assumeMany<*mut HeapHeader>(values)
      let mut i: usize = 0
      while i < count {
        let cell = unsafe Pointer.read<*mut HeapHeader>(unsafe Pointer.at<*mut HeapHeader>(src, i))
        unsafe HeapCell.retain(cell)
        unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(dst, i), ValueBits.String { reference: cell })
        i = usize.wrappingAdd(i, 1)
      }
      unsafe fast.valuesMut().extendFilled(count)
    }
    _ => invariant()
  }
  made.setSlot(0, SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  return array
}
/// Fast path for RegExp exec result arrays with 1..=WIDE_SLOTS-4 captures (1..=8):
/// borrows a Bin 0 (INLINE_SLOTS = 8: 4 slots + 4 values) or Bin 4 (WIDE_SLOTS = 12:
/// 4 slots + 8 values) spare cell, initializes slots 0..3 (length, index, input,
/// groups) and an empty inline-tail FastArrayData, and publishes without freshNodeWith.
/// Retains shape only on success. Returns Uninitialized on miss, OOM, or observed fresh allocations.
@inlineAlways
pub unsafe effect fn regexpResultFast<H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver,
  runtime: *mut HeapHeader, shape: *mut HeapHeader, count: usize, index: i32, input: ValueBits, groups: ValueBits) -> ValueBits ? &mut Allocator {
  if count == 0 || count > shapes.WIDE_SLOTS - 4 || Layout.of<SlotBits>().bytes != Layout.of<ValueBits>().bytes || unsafe gc.observesFresh(runtime) {
    return ValueBits.Uninitialized
  }
  let bin: usize = if count <= shapes.INLINE_SLOTS - 4 { 0 } else { 4 }
  let totalTail = if count <= shapes.INLINE_SLOTS - 4 { shapes.INLINE_SLOTS } else { shapes.WIDE_SLOTS }
  let extra = usize.wrappingSubtract(totalTail, 4)
  unsafe HeapCell.retain(shape)
  let spare = unsafe gc.takeSpareCellBin(runtime, bin)
  let fresh = match Pointer.nonNullMut<HeapHeader>(spare) {
    Option<*mut HeapHeader>.Some { value } => unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, value)
    Option<*mut HeapHeader>.None => {
      let tailBytes = usize.wrappingMultiply(totalTail, Layout.of<ValueBits>().bytes)
      match Pointer.nonNullMut<HeapHeader>(run unsafe allocateInlineCellOrNull(&mut hooks, observer, runtime, tailBytes)) {
        Option<*mut HeapHeader>.Some { value } => value
        Option<*mut HeapHeader>.None => {
          unsafe gc.releaseHeader(&mut hooks, runtime, shape)
          return ValueBits.Uninitialized
        }
      }
    }
  }
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  unsafe memory.prefetch(usize.wrappingAdd(Pointer.address<HeapHeader>(fresh), 64))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let tailRaw = unsafe HeapCell.tailAddress<ObjectData>(fresh)
  let slotBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(tailRaw)
  let slotMany = unsafe Pointer.assumeManyMut<SlotBits>(slotBase)
  unsafe Pointer.put<SlotBits>(unsafe Pointer.atMut<SlotBits>(slotMany, 0), SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  unsafe Pointer.put<SlotBits>(unsafe Pointer.atMut<SlotBits>(slotMany, 1), SlotBits.value(ValueBits.Int { value: index }))
  unsafe Pointer.put<SlotBits>(unsafe Pointer.atMut<SlotBits>(slotMany, 2), SlotBits.value(unsafe input.retained()))
  unsafe Pointer.put<SlotBits>(unsafe Pointer.atMut<SlotBits>(slotMany, 3), SlotBits.value(unsafe groups.retained()))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotBase, 4)
  unsafe slots.extendFilled(4)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  let valueBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ValueBits>(unsafe Pointer.atMut<u8>(
    unsafe Pointer.assumeManyMut<u8>(tailRaw), usize.wrappingMultiply(4, Layout.of<SlotBits>().bytes)))
  let items = unsafe ThinList<ValueBits>.borrowing(valueBase, extra)
  let array = FastArrayData.of(move items)
  unsafe Pointer.put<ObjectPayload>(Pointer.fromMutRef<ObjectPayload>(&mut data.payload), ObjectPayload.FastArray { array: move array })
  data.initHeader(classes.JS_CLASS_ARRAY, shape, true, true, false)
  drop data
  unsafe gc.publishObjectCold(runtime, fresh)
  return ValueBits.Object { reference: fresh }
}
/// A RegExp exec result: an Array of ownedShape, whose records start with
/// length, the caller filling its first four slots, with room for count values
/// in the cell's tail
/// when count is at most LITERAL_TAIL_VALUES (its value list may be shorter
/// otherwise). Consumes ownedShape.
pub unsafe effect fn shapedArray<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  ownedShape: *mut HeapHeader, count: usize) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let mut extra: usize = 0
  let mut exact = false
  if count >= 1 && count <= LITERAL_TAIL_VALUES {
    exact = true
    // 4 result slots + 4 values = INLINE_SLOTS (Bin 0); + 8 values = WIDE_SLOTS (Bin 4).
    if count <= shapes.INLINE_SLOTS - 4 { extra = shapes.INLINE_SLOTS - 4 }
    else if count <= shapes.WIDE_SLOTS - 4 { extra = shapes.WIDE_SLOTS - 4 }
    else { extra = count }
  }
  return run unsafe freshNodeWith(&mut hooks, memory, realm, ownedShape, classes.JS_CLASS_ARRAY, true, true, extra, Pointer.null<HeapHeader>(), true, 4, exact)
}
/// Fast path for empty fast arrays (`[]` and `Object.keys({})`): borrows a
/// Bin 1 (PAIR_SLOTS, non-small) spare cell directly, sets length = 0 and an
/// empty plain FastArrayData, and publishes without freshNodeWith. Returns
/// Uninitialized without side effects on miss, OOM, or observed fresh allocations.
@inlineAlways
pub unsafe effect fn emptyArrayFast<H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver,
  context: *mut HeapHeader, runtime: *mut HeapHeader) -> ValueBits ? &mut Allocator {
  if unsafe gc.observesFresh(runtime) { return ValueBits.Uninitialized }
  let ctxAnchor = ()
  let shapeOpt = (unsafe HeapCell.payload<ContextState, ()>(&ctxAnchor, context)).arrayShape
  let shape = match Pointer.nonNullMut<HeapHeader>(shapeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return ValueBits.Uninitialized }
  }
  let shapeAnchor = ()
  if (unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, shape)).properties.length() != 1 {
    return ValueBits.Uninitialized
  }
  let tail = shapes.PAIR_SLOTS
  unsafe HeapCell.retain(shape)
  let spare = unsafe gc.takeSpareCell(runtime, tail, false)
  let fresh = match Pointer.nonNullMut<HeapHeader>(spare) {
    Option<*mut HeapHeader>.Some { value } => unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, value)
    Option<*mut HeapHeader>.None => {
      let tailBytes = usize.wrappingMultiply(tail, Layout.of<SlotBits>().bytes)
      match Pointer.nonNullMut<HeapHeader>(run unsafe allocateInlineCellOrNull(&mut hooks, observer, runtime, tailBytes)) {
        Option<*mut HeapHeader>.Some { value } => value
        Option<*mut HeapHeader>.None => {
          unsafe gc.releaseHeader(&mut hooks, runtime, shape)
          return ValueBits.Uninitialized
        }
      }
    }
  }
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  unsafe memory.prefetch(usize.wrappingAdd(Pointer.address<HeapHeader>(fresh), 64))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let slotBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe HeapCell.tailAddress<ObjectData>(fresh))
  unsafe Pointer.put<SlotBits>(slotBase, SlotBits.value(ValueBits.Int { value: 0 }))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotBase, tail)
  unsafe slots.extendFilled(1)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  let array = unsafe FastArrayData.ofPlain(ThinList<ValueBits>.make())
  unsafe Pointer.put<ObjectPayload>(Pointer.fromMutRef<ObjectPayload>(&mut data.payload), ObjectPayload.FastArray { array: move array })
  data.initHeader(classes.JS_CLASS_ARRAY, shape, true, true, false)
  drop data
  unsafe gc.publishObject(runtime, fresh)
  return ValueBits.Object { reference: fresh }
}
/// Out-of-line fresh cell allocation for plannedConstructInPlace when the
/// spare-cell bin is empty: avoids re-probing receiverCache while keeping
/// allocateInlineCellOrNull out of the spare-hit hot path.
@inlineNever
pub unsafe effect fn allocatePlanCell<H: HeapHooks>(hooks: &mut H, observer: &AllocationObserver,
  runtime: *mut HeapHeader, tail: usize) -> ?*mut HeapHeader ? &mut Allocator {
  let mut tailBytes = usize.wrappingMultiply(tail, Layout.of<SlotBits>().bytes)
  let reused = Layout.of<ObjectPayload>().bytes - PAYLOAD_TAG_BYTES
  if tailBytes > reused { tailBytes = usize.wrappingSubtract(tailBytes, reused) } else { tailBytes = 0 }
  return run unsafe allocateInlineCellOrNull(&mut hooks, observer, runtime, tailBytes)
}
/// Initializes a revived spare small cell for a planned constructor fast path
/// (shape already retained by caller), sets inline slots over payload, and
/// publishes the object without Allocator/effect overhead.
@inlineAlways
pub unsafe fn initPlanSpareCell(runtime: *mut HeapHeader, raw: *mut HeapHeader,
  shape: *mut HeapHeader, written: usize, tail: usize) -> *mut HeapHeader {
  let fresh = unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, raw)
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  unsafe memory.prefetch(usize.wrappingAdd(Pointer.address<HeapHeader>(fresh), 64))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.Empty)
  let slotBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(
    unsafe Intrinsic.pointerReinterpret<*mut ObjectPayload, *mut u8>(payload)), PAYLOAD_TAG_BYTES))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotBase, tail)
  unsafe slots.extendFilled(written)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  let noTail = tail == shapes.PAIR_SLOTS && Layout.of<ObjectPayload>().bytes >= PAYLOAD_TAG_BYTES + shapes.PAIR_SLOTS * Layout.of<SlotBits>().bytes
  data.initHeader(classes.JS_CLASS_OBJECT, shape, false, false, noTail)
  drop data
  unsafe gc.publishObject(runtime, fresh)
  return fresh
}
/// Variant of initPlanSpareCell using gc.publishObjectCold for constructRecipeFast,
/// keeping claimCells/listYoung/HeapList.pushBack out of its hot frame.
@inlineAlways
pub unsafe fn initPlanSpareCellCold(runtime: *mut HeapHeader, raw: *mut HeapHeader,
  shape: *mut HeapHeader, written: usize, tail: usize) -> *mut HeapHeader {
  let fresh = unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, raw)
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  unsafe memory.prefetch(usize.wrappingAdd(Pointer.address<HeapHeader>(fresh), 64))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.Empty)
  let slotBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(
    unsafe Intrinsic.pointerReinterpret<*mut ObjectPayload, *mut u8>(payload)), PAYLOAD_TAG_BYTES))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotBase, tail)
  unsafe slots.extendFilled(written)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  let noTail = tail == shapes.PAIR_SLOTS && Layout.of<ObjectPayload>().bytes >= PAYLOAD_TAG_BYTES + shapes.PAIR_SLOTS * Layout.of<SlotBits>().bytes
  data.initHeader(classes.JS_CLASS_OBJECT, shape, false, false, noTail)
  drop data
  unsafe gc.publishObjectCold(runtime, fresh)
  return fresh
}
/// Unified non-effect spare-cell fast path for Object.keys on cached shapes
/// (count == 0 uses a Bin 1 PAIR_SLOTS cell; 1..WIDE_SLOTS-1 uses Bin 0/4):
/// shares one observesFresh/arrayShape/takeSpareCell/publishObject path to
/// keep objectKeysInline compact. Returns Uninitialized on miss.
@inlineAlways
pub unsafe fn keysArraySpare(context: *mut HeapHeader, runtime: *mut HeapHeader, values: ?*const *mut HeapHeader, count: usize) -> ValueBits {
  if count >= shapes.WIDE_SLOTS || Layout.of<SlotBits>().bytes != Layout.of<ValueBits>().bytes || unsafe gc.observesFresh(runtime) {
    return ValueBits.Uninitialized
  }
  let ctxAnchor = ()
  let shapeOpt = (unsafe HeapCell.payload<ContextState, ()>(&ctxAnchor, context)).arrayShape
  let shape = match Pointer.nonNullMut<HeapHeader>(shapeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return ValueBits.Uninitialized }
  }
  let shapeAnchor = ()
  if (unsafe HeapCell.payload<ShapeData, ()>(&shapeAnchor, shape)).properties.length() != 1 {
    return ValueBits.Uninitialized
  }
  let bin: usize = if count == 0 { 1 } else if count < shapes.INLINE_SLOTS { 0 } else { 4 }
  let totalTail = if count == 0 { shapes.PAIR_SLOTS } else if count < shapes.INLINE_SLOTS { shapes.INLINE_SLOTS } else { shapes.WIDE_SLOTS }
  let spare = unsafe gc.takeSpareCellBin(runtime, bin)
  let raw = match Pointer.nonNullMut<HeapHeader>(spare) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return ValueBits.Uninitialized }
  }
  unsafe HeapCell.retain(shape)
  let fresh = unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, raw)
  unsafe census.censusBump(runtime, census.CENSUS_OBJECTS_ALLOCATED, 1)
  unsafe memory.prefetch(usize.wrappingAdd(Pointer.address<HeapHeader>(fresh), 64))
  let mut nodeAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, fresh)
  let tailRaw = unsafe HeapCell.tailAddress<ObjectData>(fresh)
  let slotBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(tailRaw)
  unsafe Pointer.put<SlotBits>(slotBase, SlotBits.value(ValueBits.Int { value: usize.toI32(count) }))
  let slotCap = if count == 0 { totalTail } else { 1 }
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotBase, slotCap)
  unsafe slots.extendFilled(1)
  unsafe Pointer.put<ThinList<SlotBits>>(Pointer.fromMutRef<ThinList<SlotBits>>(data.slotListMut()), move slots)
  if count == 0 {
    let array = unsafe FastArrayData.ofPlain(ThinList<ValueBits>.make())
    unsafe Pointer.put<ObjectPayload>(Pointer.fromMutRef<ObjectPayload>(&mut data.payload), ObjectPayload.FastArray { array: move array })
  } else {
    let extra = usize.wrappingSubtract(totalTail, 1)
    let valueBase = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ValueBits>(unsafe Pointer.atMut<u8>(
      unsafe Pointer.assumeManyMut<u8>(tailRaw), Layout.of<SlotBits>().bytes))
    let src = unsafe Pointer.assumeMany<*mut HeapHeader>(unsafe Intrinsic.pointerRequalify<?*const *mut HeapHeader, *const *mut HeapHeader>(values))
    let dst = unsafe Pointer.assumeManyMut<ValueBits>(valueBase)
    let mut i: usize = 0
    while i < count {
      let cell = unsafe Pointer.read<*mut HeapHeader>(unsafe Pointer.at<*mut HeapHeader>(src, i))
      unsafe HeapCell.retain(cell)
      unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(dst, i), ValueBits.String { reference: cell })
      i = usize.wrappingAdd(i, 1)
    }
    let mut items = unsafe ThinList<ValueBits>.borrowing(valueBase, extra)
    unsafe items.extendFilled(count)
    let array = FastArrayData.of(move items)
    unsafe Pointer.put<ObjectPayload>(Pointer.fromMutRef<ObjectPayload>(&mut data.payload), ObjectPayload.FastArray { array: move array })
  }
  data.initHeader(classes.JS_CLASS_ARRAY, shape, true, true, false)
  drop data
  unsafe gc.publishObjectCold(runtime, fresh)
  return ValueBits.Object { reference: fresh }
}
/// The longest array whose values arrayWithCapacity keeps in the object's own cell.
const LITERAL_TAIL_VALUES: usize = 16
/// array with value storage for exactly count elements (an array literal's or a
/// dense copy's), taken from a parked list when one fits. Requires the context's
/// Array intrinsic cached shape.
pub effect fn arrayWithCapacity<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>,
  count: usize) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  if count == 0 {
    let fast = run unsafe emptyArrayFast(&mut hooks, memory, realm.context(), realm.runtime())
    if fast.isObject() { return fast }
  }
  let _context = realm.context()
  let runtime = realm.runtime()
  let anchor = ()
  let ctx = realm.state(&anchor)
  let shape = present(ctx.arrayShape)
  drop ctx
  unsafe HeapCell.retain(shape)
  let mut extra: usize = 0
  let mut exact = false
  if count >= 1 && count <= LITERAL_TAIL_VALUES {
    exact = true
    if count <= shapes.INLINE_SLOTS - 1 { extra = shapes.INLINE_SLOTS - 1 }
    else if count <= shapes.WIDE_SLOTS - 1 { extra = shapes.WIDE_SLOTS - 1 }
    else { extra = count }
  }
  // The context's array shape already holds length (as arrayLength relies on).
  let array = run unsafe freshNodeWith(&mut hooks, memory, realm, shape, classes.JS_CLASS_ARRAY, true, true, extra, Pointer.null<HeapHeader>(), true, 0, exact)
  let node = match array { ValueBits.Object { reference } => reference _ => invariant() }
  let mut madeAnchor = ()
  let made = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut madeAnchor, node)
  made.setSlot(0, SlotBits.value(ValueBits.Int { value: 0 }))
  if count == 0 { return array }
  let placed = match &made.payload { ObjectPayload.FastArray { array: fast } => fast.values().capacity() >= count _ => false }
  drop made
  if placed { return array }
  let reserved = run Effect.result(unsafe reserveValues(runtime, node, count))
  match move reserved {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => {
      unsafe gc.release(&mut hooks, runtime, array)
      fail move error
    }
  }
  return array
}
@inlineAlways
unsafe effect fn reserveValues(runtime: *mut HeapHeader, node: *mut HeapHeader, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let spare = unsafe shapes.takeSpareValues(runtime, count)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, node)
  match &mut data.payload {
    ObjectPayload.FastArray { array } => {
      match move spare {
        Option<ThinList<ValueBits>>.Some { value } => {
          let wasPlain = array.isPlain()
          let empty = array.replace(move value) drop empty
          // A spare list comes back empty, so an empty array stays plain.
          if wasPlain && array.values().length() == 0 { unsafe array.setPlain(true) }
        }
        Option<ThinList<ValueBits>>.None => { run (unsafe array.plainMut()).reserveExact(count) }
      }
    }
    _ => invariant()
  }
}
/// Requires the context's Array intrinsic cached shape to have been installed.
pub effect fn array<'a, H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,realm: Realm<'a>) -> ValueBits ! OutOfMemoryError ? &mut Allocator {
  let anchor = ()
  let ctx = realm.state(&anchor)
  let shape = present(ctx.arrayShape)
  drop ctx
  unsafe HeapCell.retain(shape)
  return run unsafe fromShape(&mut hooks, memory, realm, shape, classes.JS_CLASS_ARRAY, Option<ThinList<SlotBits>>.none())
}
