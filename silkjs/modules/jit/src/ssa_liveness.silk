//! Which values compiled code keeps across each call it makes (workstream H): the backend saves
//! only these in the call block (docs/jit/compiled-entry.md, section 7.3).
import silk.num.i32
import silk.num.u32
import silk.num.usize
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import ssa { Function, Op, SlotMode, NONE, edgeCount, readsK }
import ssa_verify { readsA, readsB }

/// For each call of `f`, in instruction order, the values its code must keep while the call
/// runs: those live after it, and those its throw exit materializes (that exit runs after the
/// code resumes). Nothing else the frame holds is read again, so nothing else is saved.
pub effect fn savedAcross(f: &Function) -> List<List<u32>> ! OutOfMemoryError ? &mut Allocator {
  let n = u32.toUsize(f.valueCount())
  let blocks = u32.toUsize(f.blockCount())
  let mut liveIn = List<bool>.make() run liveIn.appendRepeated(false, n * blocks)
  let mut live = List<bool>.make() run live.appendRepeated(false, n)
  let mut saved = List<List<u32>>.make()
  // Passes until the live-in sets settle, then one more that records.
  let mut recording = false
  while true {
    let mut changed = false
    let mut b = blocks
    while b > 0 {
      b = b - 1
      let block = f.blocks.get(b)
      clear(&mut live)
      // Live out: each successor's live-in but its parameters, and the edge arguments.
      let term = f.terminator(block)
      let mut e: u32 = 0
      while e < edgeCount(term.op) {
        let edge = f.edge(term.edge + e)
        let target = f.blocks.get(u32.toUsize(edge.target))
        let mut v: usize = 0
        while v < n { if liveIn.get(u32.toUsize(edge.target) * n + v) { live.set(v, true) } v = v + 1 }
        let mut p: u32 = 0
        while p < target.paramCount { live.set(u32.toUsize(f.paramAt(target, p)), false) p = p + 1 }
        let mut g: u32 = 0
        while g < edge.argCount { mark(&mut live, f.edgeArg(edge, g)) g = g + 1 }
        e = e + 1
      }
      let mut i = block.instCount
      while i > 0 {
        i = i - 1
        let inst = f.inst(block.firstInst + i)
        if inst.result != NONE { live.set(u32.toUsize(inst.result), false) }
        if inst.op == Op.Call && recording {
          let mut keep = List<bool>.make() run keep.appendSlice(live.asSlice())
          let exit = f.exit(inst.exit)
          let mut s: u32 = 0
          while s < f.slotCount(exit) {
            let slot = f.slot(exit, s)
            if slot.mode == SlotMode.Virtual {
              let vo = f.virtualObjs.get(u32.toUsize(slot.value))
              let mut fk: u32 = 0
              while fk < vo.slotCount && fk < 8 { mark(&mut keep, vo.fields[u32.toUsize(fk)]) fk = fk + 1 }
            } else { mark(&mut keep, slot.value) }
            s = s + 1
          }
          let mut values = List<u32>.make()
          let mut v: usize = 0
          while v < n { if keep.get(v) { run values.append(usize.toU32(v)) } v = v + 1 }
          run saved.append(move values)
        }
        if readsA(inst.op) { mark(&mut live, inst.a) }
        if readsB(inst.op) { mark(&mut live, inst.b) }
        if readsK(inst.op) { mark(&mut live, i32.wrappingToU32(inst.k)) }
        if inst.exit != NONE {
          let exit = f.exit(inst.exit)
          let mut s: u32 = 0
          while s < f.slotCount(exit) {
            let slot = f.slot(exit, s)
            if slot.mode == SlotMode.Virtual {
              let vo = f.virtualObjs.get(u32.toUsize(slot.value))
              let mut fk: u32 = 0
              while fk < vo.slotCount && fk < 8 { mark(&mut live, vo.fields[u32.toUsize(fk)]) fk = fk + 1 }
            } else { mark(&mut live, slot.value) }
            s = s + 1
          }
        }
      }
      let mut p: u32 = 0
      while p < block.paramCount { live.set(u32.toUsize(f.paramAt(block, p)), false) p = p + 1 }
      let mut v: usize = 0
      while v < n {
        let at = b * n + v
        if live.get(v) && !liveIn.get(at) { liveIn.set(at, true) changed = true }
        v = v + 1
      }
    }
    if recording { break }
    if !changed { recording = true }
  }
  // Recorded walking backwards: put them in instruction order.
  let mut ordered = List<List<u32>>.make()
  while saved.length() > 0 { run ordered.append(saved.pop().unwrapOr(List<u32>.make())) }
  return move ordered
}
fn clear(live: &mut List<bool>) -> () { let mut v: usize = 0 while v < live.length() { live.set(v, false) v = v + 1 } }
fn mark(live: &mut List<bool>, v: u32) -> () { if v != NONE { live.set(u32.toUsize(v), true) } }
