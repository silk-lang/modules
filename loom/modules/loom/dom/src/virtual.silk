//! Virtual lists in the document. ui-tree owns virtualization for a tree; in a page the browser
//! lays out and scrolls, so this keeps each list's controller (ui-tree's `VirtualList`, as plain
//! data) and the page reports what it needs: the list's scroll offset and height, the heights
//! of the bound rows, and which bound rows hold focus or the focused widget's active
//! descendant. The page shows spacers in place of the rows that are not mounted.
//!
//! A screen reader's browse cursor is not something a page can see, so a document retains
//! focus and active-descendant rows only.
import wire { OP_VIRTUAL, byte, word, float, readWord, readFloat }
import ui_protocol.virtual_list { VirtualList }
import ui_protocol.mutation { Mutation }
import ui_protocol.options { VirtualItem, VirtualOptions }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.usize

const NONE: u32 = 0

struct Port {
  list: VirtualList,
  /// The bound row that holds focus, or `NONE`.
  focused: u32,
  /// The bound row that holds the focused widget's active descendant, or `NONE`.
  active: u32,
  /// Whether the page's spacers are out of date.
  dirty: bool,
}

/// The virtual lists of a page.
pub struct Ports {
  ports: List<Port>,
  /// Lists the program cleared, for the page to forget.
  cleared: List<u32>,
}

impl Ports {
  pub fn make() -> Ports {
    return Ports { ports: List<Port>.make(), cleared: List<u32>.make() }
  }

  fn find(self: &Self, port: u32) -> usize {
    let mut i: usize = 0
    while i < self.ports.length() {
      if self.ports.asSlice()[i].list.port == port {
        return i
      }
      i = i + 1
    }
    return usize.MAX
  }

  /// Takes the virtual list mutations; returns false for any other.
  pub effect fn take(self: &mut Self, mutation: &Mutation) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match &mutation.* {
      Mutation.SetVirtualList { id, count, options } => {
        run self.configure(id, count, options)
        return true
      }
      Mutation.SetVirtualItems { id, items } => {
        let at = self.find(id)
        if at != usize.MAX {
          let port = &mut self.ports.asMutSlice()[at]
          if port.list.previous != usize.MAX {
            // The count changed: these rows say where items came and went.
            let count = port.list.count
            let before = Intrinsic.replace(port.list.rows, List<VirtualItem>.make())
            drop run port.list.remap(count, before.asSlice(), items.asSlice())
            port.dirty = true
          }
          if !sameRows(port.list.rows.asSlice(), items.asSlice()) {
            port.list.rows.clear()
            run port.list.rows.appendSlice(items.asSlice())
            port.dirty = true
          }
        }
        return true
      }
      Mutation.ClearVirtualList { id } => {
        let at = self.find(id)
        if at != usize.MAX {
          drop self.ports.remove(at)
          run self.cleared.append(id)
        }
        return true
      }
      Mutation.Destroy { id } => {
        // The page drops a destroyed list's spacers with it.
        let at = self.find(id)
        if at != usize.MAX {
          drop self.ports.remove(at)
        }
        return false
      }
      _ => {
        return false
      }
    }
  }

  /// Ends a count change no rows were bound for: the bound rows kept their indices.
  pub effect fn settle(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < self.ports.length() {
      let port = &mut self.ports.asMutSlice()[i]
      if port.list.previous != usize.MAX {
        let count = port.list.count
        let rows = Intrinsic.replace(port.list.rows, List<VirtualItem>.make())
        drop run port.list.remap(count, rows.asSlice(), rows.asSlice())
        port.list.rows = move rows
        port.dirty = true
      }
      i = i + 1
    }
  }

  effect fn configure(self: &mut Self, id: u32, count: usize, options: VirtualOptions) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut at = self.find(id)
    if at == usize.MAX {
      let mut list = VirtualList.make(options)
      list.port = id
      run self.ports.append(Port { list: move list, focused: NONE, active: NONE, dirty: true })
      at = self.ports.length() - 1
    }
    let port = &mut self.ports.asMutSlice()[at]
    let list = &mut port.list
    let known = if list.previous == usize.MAX { list.count } else { list.previous }
    if list.count != count && known != 0 && list.options.revision == options.revision
      && list.options.estimatedHeight == options.estimatedHeight && list.options.gap == options.gap {
      // Items came or went: the rows bound next say where (`take`, or `settle` when none are).
      list.previous = known
      list.count = count
      list.options = options
      return ()
    }
    if list.previous != usize.MAX {
      list.count = list.previous
      list.previous = usize.MAX
    }
    let fresh = list.count != count || list.options.revision != options.revision
      || list.options.estimatedHeight != options.estimatedHeight
      || list.options.gap != options.gap
    if fresh {
      // The browser keeps the scroll offset; its scroll anchoring keeps the visible row.
      run list.reset(count, options)
      port.dirty = true
    }
    let overscan = list.options.overscan != options.overscan
    list.options = options
    drop list.range(fresh || overscan)
  }

  /// Where item `index` of list `id` starts in the list, by its measured or estimated height.
  pub fn prefix(self: &Self, id: u32, index: usize) -> f32 {
    let at = self.find(id)
    if at == usize.MAX {
      return 0.0
    }
    let list = &self.ports.asSlice()[at].list
    return list.prefix(least(index, list.count))
  }

  /// The indices list `id` wants mounted, in order: the range around the viewport and the
  /// rows that hold focus or the active descendant. False for no list.
  pub effect fn indices(self: &Self, id: u32, out: &mut List<usize>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    let at = self.find(id)
    if at == usize.MAX {
      return false
    }
    let port = &self.ports.asSlice()[at]
    let list = &port.list
    let end = least(list.end, list.count)
    let first = least(list.first, end)
    let one = indexOf(list, port.focused)
    let two = indexOf(list, port.active)
    let low = least(one, two)
    let high = if one < two { two } else { one }
    let mut wanted = List<usize>.make()
    if low < first { run wanted.append(low) }
    if high < first && high != low { run wanted.append(high) }
    let mut i = first
    while i < end {
      run wanted.append(i)
      i = i + 1
    }
    if low >= end && low < list.count { run wanted.append(low) }
    if high >= end && high < list.count && high != low { run wanted.append(high) }
    run out.appendSlice(wanted.asSlice())
    return true
  }

  /// Reads what the page reported (see `page.CALL_VIRTUAL`): a count of lists, and for each its
  /// id, scroll offset, height, focused row and active row; then a count of rows, and for
  /// each its id and border-box height. Returns whether a list's request may have changed.
  pub effect fn report(self: &mut Self, bytes: &[u8]) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut changed = false
    let mut at: usize = 0
    if bytes.length < 4 {
      return false
    }
    let mut lists = readWord(bytes, &mut at)
    while lists > 0 && at + 20 <= bytes.length {
      lists = lists - 1
      let id = readWord(bytes, &mut at)
      let scroll = readFloat(bytes, &mut at)
      let height = readFloat(bytes, &mut at)
      let focused = readWord(bytes, &mut at)
      let active = readWord(bytes, &mut at)
      let p = self.find(id)
      if p != usize.MAX {
        let port = &mut self.ports.asMutSlice()[p]
        port.list.scroll = f32.max(0.0, scroll)
        let resized = port.list.height != f32.max(0.0, height)
        port.list.height = f32.max(0.0, height)
        // The controller starts at a guessed height; a real one asks again, smaller too.
        if resized && port.list.range(true) {
          changed = true
        }
        if port.focused != focused || port.active != active {
          port.focused = focused
          port.active = active
          changed = true
        }
      }
    }
    if at + 4 <= bytes.length {
      let mut rows = readWord(bytes, &mut at)
      while rows > 0 && at + 8 <= bytes.length {
        rows = rows - 1
        let id = readWord(bytes, &mut at)
        let height = readFloat(bytes, &mut at)
        let mut p: usize = 0
        while p < self.ports.length() {
          let port = &mut self.ports.asMutSlice()[p]
          let index = indexOf(&port.list, id)
          if index != usize.MAX {
            let stride = height + port.list.options.gap
            if run port.list.measure(index, stride) {
              port.dirty = true
            }
            break
          }
          p = p + 1
        }
      }
    }
    let ports = self.ports.asMutSlice()
    let mut p: usize = 0
    while p < ports.length {
      if ports[p].list.range(false) {
        changed = true
      }
      p = p + 1
    }
    return changed
  }

  /// Whether a list's spacers wait to be written.
  pub fn pending(self: &Self) -> bool {
    if self.cleared.length() != 0 {
      return true
    }
    let mut p: usize = 0
    while p < self.ports.length() {
      if self.ports.asSlice()[p].dirty {
        return true
      }
      p = p + 1
    }
    return false
  }

  /// Writes the spacers of the lists that changed to `out`.
  pub effect fn write(self: &mut Self, out: &mut Bytes) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut c: usize = 0
    while c < self.cleared.length() {
      run byte(&mut out, OP_VIRTUAL)
      run word(&mut out, self.cleared.get(c))
      run word(&mut out, u32.MAX)
      c = c + 1
    }
    self.cleared.clear()
    let ports = self.ports.asMutSlice()
    let mut p: usize = 0
    while p < ports.length {
      if ports[p].dirty {
        ports[p].dirty = false
        let list = &ports[p].list
        let gap = list.options.gap
        run byte(&mut out, OP_VIRTUAL)
        run word(&mut out, list.port)
        run word(&mut out, usize.toU32(list.rows.length()))
        let mut after: f32 = 0.0
        let mut r: usize = 0
        while r < list.rows.length() {
          let row = list.rows.get(r)
          let space: f32 = if r == 0 { 0.0 } else { gap }
          let before = list.prefix(row.index) - after + space
          run word(&mut out, row.id)
          run float(&mut out, f32.max(0.0, before))
          after = list.prefix(row.index + 1)
          r = r + 1
        }
        let total = list.prefix(list.count)
        let tail = if list.rows.length() == 0 { total - gap } else { total - after }
        run float(&mut out, f32.max(0.0, tail))
      }
      p = p + 1
    }
  }
}

fn least(a: usize, b: usize) -> usize {
  return if a < b { a } else { b }
}

fn indexOf(list: &VirtualList, id: u32) -> usize {
  if id == NONE {
    return usize.MAX
  }
  let mut r: usize = 0
  while r < list.rows.length() {
    if list.rows.get(r).id == id {
      return list.rows.get(r).index
    }
    r = r + 1
  }
  return usize.MAX
}

fn sameRows(a: &[VirtualItem], b: &[VirtualItem]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i].index != b[i].index || a[i].id != b[i].id {
      return false
    }
    i = i + 1
  }
  return true
}
