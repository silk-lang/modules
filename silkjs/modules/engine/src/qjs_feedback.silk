//! --debug-feedback and --debug-feedback-stats: record call and type feedback
//! (js_feedback) for every function the hot function report names, and with
//! -stats print what was recorded to stderr before the session closes.
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.num.u64
import cli_io
import js_heap { HeapHeader }
import js_core_types { HostHook, NativeFunctionId }
import js_runtime as runtime
import js_feedback as feedback

/// The host hook id of the qjs hot function handler.
pub const HOT_HANDLER: u32 = 0x4c000293

pub unsafe fn install(rt: *mut HeapHeader) -> () {
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: HOT_HANDLER }), opaque: Pointer.null<u8>() })
}
fn number(value: usize) -> () {
  let mut digits: [u8; 32] = [0; 32] let mut length: usize = 0 let mut rest = value
  while true { digits[31 - length] = usize.toU8(rest % 10) + 48 length = length + 1 rest = rest / 10 if rest == 0 { break } }
  cli_io.stderr(Slice.view(&digits, 32 - length, length))
}
fn field(name: &[u8], value: usize) -> () { cli_io.stderr(b" ") cli_io.stderr(name) cli_io.stderr(b"=") number(value) }
/// One line per kind, `key=value` pairs, for scripts to parse.
pub unsafe fn print(rt: *mut HeapHeader) -> () {
  let s = unsafe feedback.summary(rt)
  cli_io.stderr(b"feedback:") field(b"functions", s.functions) field(b"sites", s.sites) field(b"observed", u64.toUsize(s.observedTotal)) field(b"observed-recorded", u64.toUsize(s.observedRecorded)) cli_io.stderr(b"\n")
  cli_io.stderr(b"feedback-arith:") field(b"binary", s.binaryRun) field(b"unary", s.unaryRun) field(b"int", s.intOnly)
  field(b"int-overflow", s.intOverflow) field(b"number", s.numeric) field(b"string", s.stringy) field(b"other", s.mixed) cli_io.stderr(b"\n")
  cli_io.stderr(b"feedback-call:") field(b"run", s.callRun) field(b"mono", s.monomorphic) field(b"mono-bytecode", s.monoBytecode)
  field(b"mono-native", s.monoNative) field(b"poly", s.polymorphic) field(b"mega", s.megamorphic) cli_io.stderr(b"\n")
  cli_io.stderr(b"feedback-property:") field(b"run", s.propertyRun) field(b"mono", s.shapeMono) field(b"poly", s.shapePoly)
  field(b"mega", s.shapeMega) field(b"primitive", s.primitiveReceiver) cli_io.stderr(b"\n")
}
