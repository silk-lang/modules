//! The engine's tasks, run with `silk task <name>` from `modules/engine`.
//!
//! Each task runs one of the Python scripts in `scripts/` with typed options, so `silk task`
//! lists what there is to run and `silk task <name> --help` says how. The scripts still hold
//! the work; this program is their entry point.

import benchkit.kit as Kit
import benchkit.engines as Engines
import benchkit.engines { Asked }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }

union Tasks {
  Check { pub skipNative: bool, pub skipBench: bool },
  Bench {
    pub label: Option<Bytes>,
    pub compare: Option<Bytes>,
    pub runs: Option<Bytes>,
    pub reference: Option<Bytes>,
    pub skipMicro: bool,
    pub skipMacro: bool,
    pub only: List<Bytes>,
  },
  Pgo { pub pgoOutput: Option<Bytes>, pub keep: bool },
  FunctionOrder { pub binary: Option<Bytes> },
  BenchSetup { pub work: Option<Bytes>, pub steps: List<Bytes> },
  BenchOctane { pub measure: Measure, pub benchmarks: List<Bytes> },
  BenchMicro { pub measure: Measure, pub tests: List<Bytes> },
  BenchFixed { pub measure: Measure, pub fixedOnly: Option<Bytes>, pub iterations: Option<u32>, pub binaries: List<Bytes> },
  BenchStartup { pub measure: Measure },
  BenchWarmup { pub measure: Measure, pub iterations: Option<u32>, pub warmupBenchmarks: List<Bytes> },
  BenchReport { pub measure: Measure, pub native: bool, pub spread: bool },
  Differential {
    pub count: Option<Bytes>,
    pub seed: Option<Bytes>,
    pub hot: Option<Bytes>,
    pub configs: Option<Bytes>,
    pub engine: Option<Bytes>,
    pub selfTest: bool,
    pub definitions: List<Bytes>,
  },
}

/// The options the measuring tasks share.
struct Measure {
  pub rounds: Option<u32>,
  pub engine: Option<Bytes>,
  pub engines: Option<Bytes>,
  pub jit: bool,
  pub out: Option<Bytes>,
  pub work: Option<Bytes>,
  pub force: bool,
}

impl CommandLine for Measure {
  static fn command() -> Command<Measure> {
    return Command<Measure>.make("measure", "")
      |> Command.option("rounds", Opt.about("Interleaved rounds (default 3; 7 for bench-fixed)"))
      |> Command.option("engine", Opt.about("The engine executable (default: this host's release build)") |> Opt.env("SILKJS_ENGINE"))
      |> Command.option("engines", Opt.about("Columns, comma-separated (default: every installed one of silkjs,silkjs-jit,v8-jitless,jsc-nojit,qjs,silkjs-wasm,qjs-wasm; silkjs-jit is silkjs-jit-shell --jit from $SILKJS_JIT or beside the engine)"))
      |> Command.option("jit", Opt.about("Add the v8-jit and jsc-jit columns, for context only"))
      |> Command.option("out", Opt.about("The results directory (default: <work>/results)"))
      |> Command.option(
        "work",
        Opt.about("The work directory of bench-setup (default: build/bench)")
          |> Opt.env("SILKJS_BENCH_WORK"),
      )
      |> Command.option("force", Opt.about("Measure even while a build runs"))
  }
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "The SilkJS engine's tasks")
      |> Command.variant(
        "Check",
        "The correctness gate: entry-point type check, native suite, QuickJS and SilkJS tests, benchmark outputs (needs `silk build --release`)",
      )
      |> Command.option("skipNative", Opt.about("Skip the native regression suite"))
      |> Command.option("skipBench", Opt.about("Skip the benchmark output check"))
      |> Command.variant("Bench", "Run the performance suite and record or compare results")
      |> Command.option("label", Opt.about("Write bench/results/<label>.json"))
      |> Command.option(
        "compare",
        Opt.about("Compare against a recorded results JSON; fails on a regression"),
      )
      |> Command.option("runs", Opt.about("Runs per macro workload (default 5)"))
      |> Command.option("reference", Opt.about("Also measure this C QuickJS qjs binary"))
      |> Command.option("skipMicro", Opt.about("Skip the micro benchmark (about 15 minutes)"))
      |> Command.option("skipMacro", Opt.about("Skip the macro workloads"))
      |> Command.arg("only", Opt.about("Macro names or micro test prefixes to run"))
      |> Command.variant(
        "Pgo",
        "Build the release CLI with profile-guided optimization (build/pgo/silkjs-engine)",
      )
      |> Command.option(
        "pgoOutput",
        Opt.about("Where to write the optimized CLI") |> Opt.long("output"),
      )
      |> Command.option("keep", Opt.about("Keep build/pgo/work: profiles and the instrumented CLI"))
      |> Command.variant(
        "FunctionOrder",
        "Regenerate startup.order from a release build under callgrind",
      )
      |> Command.arg("binary", Opt.about("The release CLI (default: this host's release build)"))
      |> Command.variant(
        "BenchSetup",
        "Install the reference engines of the comparison: Node check, jsc, Octane, QuickJS, wasmtime, wasi-sdk, the wasm builds",
      )
      |> Command.option(
        "work",
        Opt.about("The work directory (default: build/bench)") |> Opt.env("SILKJS_BENCH_WORK"),
      )
      |> Command.arg(
        "steps",
        Opt.about("Steps to run (default all): node jsc octane quickjs wasmtime wasi-sdk wasm"),
      )
      |> Command.variant(
        "BenchOctane",
        "Run Octane under silkjs, V8 jitless, JSC without its JIT, QuickJS and the wasm builds",
      )
      |> Command.flatten("measure")
      |> Command.arg("benchmarks", Opt.about("Octane benchmarks to run, such as richards splay"))
      |> Command.variant("BenchMicro", "Run bench/microbench.js under the same engines")
      |> Command.arg("tests", Opt.about("microbench.js test names to run"))
      |> Command.variant("BenchFixed", "Compare builds on fixed Octane work: minimum user time, under 2% is noise")
      |> Command.option("fixedOnly", Opt.about("Octane benchmarks, comma-separated, such as richards,deltablue") |> Opt.long("only"))
      |> Command.option("iterations", Opt.about("Iterations of each benchmark (bench-fixed default: as scripts/v8bench.py; bench-warmup default: 200)"))
      |> Command.arg("binaries", Opt.about("The executables to compare: OLD NEW"))
      |> Command.variant("BenchStartup", "Startup of an empty script (wall, CPU, peak RSS per process) and each engine's binary size")
      |> Command.variant("BenchWarmup", "Per-iteration time of Octane benchmarks over the first iterations in one process")
      |> Command.arg("warmupBenchmarks", Opt.about("Octane benchmarks (default richards deltablue)"))
      |> Command.variant("BenchReport", "Print the tables from the results of bench-octane and bench-micro")
      |> Command.option("native", Opt.about("The native-only table instead of the one with the wasm columns"))
      |> Command.option("spread", Opt.about("Min, median and max over rounds, with peak RSS, startup and size when recorded"))
      |> Command.variant("Differential", "Run generated programs under several engine configurations and report disagreements (scripts/differential.py)")
      |> Command.option("count", Opt.about("Number of programs (default 200)"))
      |> Command.option("seed", Opt.about("First seed (default 1)"))
      |> Command.option("hot", Opt.about("Iterations of each stable loop (default 300)"))
      |> Command.option("configs", Opt.about("Configurations, comma-separated; the first is the baseline (default plain,observed)"))
      |> Command.option("engine", Opt.about("The engine executable (default: this host's release build)") |> Opt.env("SILKJS_ENGINE"))
      |> Command.option("selfTest", Opt.about("Check that the harness finds and reduces a planted bug in each generated area"))
      |> Command.arg("definitions", Opt.about("Extra configurations as NAME=TEMPLATE, such as jit='{engine} --jit {file}'"))
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let mut argv = List<Bytes>.make()
    match move self {
      Tasks.BenchSetup { work, steps } => {
        let measure = Measure {
          rounds: Option<u32>.none(),
          engine: Option<Bytes>.none(),
          engines: Option<Bytes>.none(),
          jit: false,
          out: Option<Bytes>.none(),
          work: move work,
          force: false,
        }
        let asked = run asked(move measure, move steps)
        run Engines.setup(&asked)
        return
      }
      Tasks.BenchOctane { measure, benchmarks } => {
        let asked = run asked(move measure, move benchmarks)
        run Engines.octane(&asked)
        return
      }
      Tasks.BenchMicro { measure, tests } => {
        let asked = run asked(move measure, move tests)
        run Engines.micro(&asked)
        return
      }
      Tasks.BenchFixed { measure, fixedOnly, iterations, binaries } => {
        let asked = run asked(move measure, move binaries)
        let only = Kit.orEmpty(move fixedOnly)
        let count = match move iterations {
          Option<u32>.Some { value } => value
          Option<u32>.None => 0
        }
        run Engines.fixed(&asked, Bytes.asSlice(&only), count)
        return
      }
      Tasks.BenchStartup { measure } => {
        let asked = run asked(move measure, List<Bytes>.make())
        run Engines.startup(&asked)
        return
      }
      Tasks.BenchWarmup { measure, iterations, warmupBenchmarks } => {
        let asked = run asked(move measure, move warmupBenchmarks)
        let count = match move iterations {
          Option<u32>.Some { value } => value
          Option<u32>.None => 0
        }
        run Engines.warmup(&asked, count)
        return
      }
      Tasks.BenchReport { measure, native, spread } => {
        let asked = run asked(move measure, List<Bytes>.make())
        run Engines.report(&asked, native, spread)
        return
      }
      Tasks.Check { skipNative, skipBench } => {
        run word(&mut argv, b"scripts/check.py")
        if skipNative {
          run word(&mut argv, b"--skip-native")
        }
        if skipBench {
          run word(&mut argv, b"--skip-bench")
        }
      }
      Tasks.Bench { label, compare, runs, reference, skipMicro, skipMacro, only } => {
        run word(&mut argv, b"scripts/bench.py")
        run valued(&mut argv, b"--label", move label)
        run valued(&mut argv, b"--compare", move compare)
        run valued(&mut argv, b"--runs", move runs)
        run valued(&mut argv, b"--reference", move reference)
        if skipMicro {
          run word(&mut argv, b"--skip-micro")
        }
        if skipMacro {
          run word(&mut argv, b"--skip-macro")
        }
        if List<Bytes>.length(&only) > 0 {
          run word(&mut argv, b"--only")
          run words(&mut argv, &only)
        }
      }
      Tasks.Pgo { pgoOutput, keep } => {
        run word(&mut argv, b"scripts/pgo_build.py")
        run valued(&mut argv, b"--output", move pgoOutput)
        if keep {
          run word(&mut argv, b"--keep")
        }
      }
      Tasks.Differential { count, seed, hot, configs, engine, selfTest, definitions } => {
        run word(&mut argv, b"scripts/differential.py")
        run valued(&mut argv, b"--count", move count)
        run valued(&mut argv, b"--seed", move seed)
        run valued(&mut argv, b"--hot", move hot)
        run valued(&mut argv, b"--configs", move configs)
        run valued(&mut argv, b"--engine", move engine)
        if selfTest { run word(&mut argv, b"--self-test") }
        let listed = List<Bytes>.asSlice(&definitions)
        let mut at: usize = 0
        while at < listed.length {
          run word(&mut argv, b"--config")
          run word(&mut argv, Bytes.asSlice(&listed[at]))
          at = at + 1
        }
      }
      Tasks.FunctionOrder { binary } => {
        run word(&mut argv, b"scripts/function_order.py")
        match move binary {
          Option<Bytes>.Some { value } => run List<Bytes>.append(&mut argv, move value)
          Option<Bytes>.None => {}
        }
      }
    }
    run Task.execBytes(b"python3", List<Bytes>.asSlice(&argv))
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}

// What a comparison task was asked, from its options and names.
effect fn asked(measure: Measure, names: List<Bytes>) -> Asked
  ! TaskError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let root = run Task.root()
  let Measure { rounds, engine, engines, jit, out, work, force } = move measure
  return Asked {
    root: run Bytes.copy(Path.rawBytes(&root)),
    work: Kit.orEmpty(move work),
    out: Kit.orEmpty(move out),
    engine: Kit.orEmpty(move engine),
    engines: Kit.orEmpty(move engines),
    rounds: match move rounds {
      Option<u32>.Some { value } => value
      Option<u32>.None => 0
    },
    jit: jit,
    force: force,
    names: move names,
  }
}

// Appends one argument.
effect fn word(argv: &mut List<Bytes>, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run List<Bytes>.append(&mut argv.*, run Bytes.copy(text))
}

// Appends a copy of each argument in `values`.
effect fn words(argv: &mut List<Bytes>, values: &List<Bytes>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let listed = List<Bytes>.asSlice(values)
  let mut at: usize = 0
  while at < listed.length {
    run word(&mut argv.*, Bytes.asSlice(&listed[at]))
    at = at + 1
  }
}

// Appends `flag` and its value when the option was given.
effect fn valued(argv: &mut List<Bytes>, flag: &[u8], value: Option<Bytes>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match move value {
    Option<Bytes>.Some { value: given } => {
      run word(&mut argv.*, flag)
      run List<Bytes>.append(&mut argv.*, move given)
    }
    Option<Bytes>.None => {}
  }
}
