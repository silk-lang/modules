/// `__ui.*` in the runtime's realm: the bridge's functions, from the embedder's first id.
/// Wakes the runtime whose waker is at `address`, for the window's platform thread.
export "C" fn wakeRuntime(address: usize) -> () as "ui_js_node_wake" {
  wakeAt(address)
}

/// `__ui.*` in the runtime's realm: the runtime's [`HostApi`], whose ids from
/// [`HOST_API_FIRST`] are the bridge's functions. The bridge belongs to the running
/// [`NodeApp`], which lends it before each turn and callback.
pub struct UiApi { slot: *mut BridgeSlot }
impl Copy for UiApi {}

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
/// Where a [`UiApi`] finds the bridge it calls.
pub struct BridgeSlot { bridge: ?*mut Bridge }

impl UiApi {
  /// An API with no bridge lent yet. Its slot stays allocated for the life of the process.
  pub effect fn make() -> UiApi ! OutOfMemoryError ? &mut Allocator {
    let allocation = unsafe calloc(1, Layout.of<BridgeSlot>().bytes)
    if Pointer.isNull<u8>(allocation) { fail OutOfMemoryError {} }
    let slot = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BridgeSlot>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(allocation))
    unsafe Pointer.put<BridgeSlot>(slot, BridgeSlot { bridge: Pointer.null<Bridge>() })
    return UiApi { slot: slot }
  }
  fn lend(self: &Self, bridge: &mut Bridge) -> () {
    let mut anchor: u8 = 0
    let slot = unsafe Pointer.borrowMut<u8, BridgeSlot>(&mut anchor, self.slot)
    slot.bridge = Pointer.fromMutRef<Bridge>(&mut bridge.*)
  }
}

impl HostApi for UiApi {
  // Worker threads get no window: their `__ui` calls find no bridge.
  fn forWorker(self: &Self) -> Self { return self.* }
  effect fn call<'r, 'm, 'w, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, id: u32, realm: Realm<'r>, argc: i32, argv: Arguments<'w>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut anchor: u8 = 0
    let slot = unsafe Pointer.borrowMut<u8, BridgeSlot>(&mut anchor, self.slot)
    if Pointer.isNull<Bridge>(slot.bridge) { return ValueBits.Undefined }
    let mut bridgeAnchor: u8 = 0
    let ui = unsafe Pointer.borrowMut<u8, Bridge>(&mut bridgeAnchor, unsafe Intrinsic.pointerRequalify<?*mut Bridge, *mut Bridge>(slot.bridge))
    let called = run bridge.call(&mut ui.*, id - HOST_API_FIRST, argv)
    return match move called {
      Outcome.Returned { value } => value
      Outcome.TypeError { message } => {
        let memory = engine.memory
        return run errors.throwError(&mut engine.*, memory, realm, NativeErrorKind.Type, message.asSlice())
      }
      Outcome.Failed { message } => {
        let memory = engine.memory
        return run errors.throwError(&mut engine.*, memory, realm, NativeErrorKind.Internal, message.asSlice())
      }
    }
  }
}

/// A ui-js application in a started runtime: the bridge its `__ui` functions write to.
pub struct NodeApp<'r, 'e, 'm, C> {
  runtime: &'r mut Runtime<'e, 'm, C>,
  api: UiApi,
  bridge: Bridge,
  openers: Openers,
  /// The runtime finished (process.exit): the window closes.
  finished: bool,
  status: i32,
  /// The page zoom JavaScript last heard of, to tell it when a zoom key changes it.
  zoom: f32,
  /// What 2D canvases show their bitmaps through, once the window gave it.
  presenter: Option<CanvasPresenter>,
  /// JavaScript's bytes in use when the last quiet moment ended ([`NodeApp.releaseIdle`]).
  settled: usize,
  /// Whether SILK_UI_TRACE_JS asked for a line for each quiet moment that did something.
  quietTraced: bool,
  /// Whether SILK_UI_TRACE_JS=census asked for the engine's census of the heap after each
  /// quiet moment that collected: what the live JavaScript memory is made of.
  censusTraced: bool,
  /// Functions compiled as far as a stub and never called, each with a reference of this
  /// list's: quiet moments finish them a step at a time ([`FINISH_STEP`]).
  waiting: List<*mut HeapHeader>,
  /// Whether the heap was searched for such functions since it last changed much.
  searched: bool,
  /// The web views JavaScript opened, each shown at its node.
  webViews: List<HostedView>,
  /// A layout moved or toggled a web view: the next turn places it.
  placesPending: bool,
  /// Ends the window's wait, for a layout that moved a web view.
  nudge: Option<Nudge>,
}

/// A web view and the node it shows at.
struct HostedView {
  view: u32,
  node: u32,
  /// JavaScript's `shown`: a hidden view keeps its page.
  shown: bool,
  /// Where it was last placed, and where the last layout puts it.
  placed: Placement,
  wanted: Placement,
}

/// `__ui.shell` op 44, show or hide a web view: view, 0 or 1. Served here, not by the views.
const OP_SHOW: u32 = 44

/// `__ui.shell` op 45, quit: the exit code.
const OP_QUIT: u32 = 45

/// `__ui.shellEvent` kind of a web view event: `a` the view, `x` its code, `text` its fields.
const WEB_VIEW_EVENT: u32 = 20

fn samePlacement(a: &Placement, b: &Placement) -> bool {
  return a.visible == b.visible && a.bounds.xMin == b.bounds.xMin && a.bounds.yMin == b.bounds.yMin
    && a.bounds.xMax == b.bounds.xMax
    && a.bounds.yMax == b.bounds.yMax
    && a.clip.xMin == b.clip.xMin
    && a.clip.yMin == b.clip.yMin
    && a.clip.xMax == b.clip.xMax
    && a.clip.yMax == b.clip.yMax
}

fn fieldNumber(text: string, at: usize) -> u32 {
  let bytes = String.utf8Bytes(text)
  let mut field: usize = 0
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < bytes.length {
    if bytes[i] == 31 {
      if field == at {
        return value
      }
      field = field + 1
      value = 0
    } else if field == at && bytes[i] >= 48 && bytes[i] <= 57 {
      value = value * 10 + u8.toU32(bytes[i] - 48)
    }
    i = i + 1
  }
  return if field == at {
    value
  } else {
    0
  }
}

/// How many never-called functions one quiet step finishes. A function waiting for its first
/// call keeps its whole definition, some 1.5 KB and its unresolved code, against the few
/// hundred bytes of its finished form, and a large bundle leaves tens of thousands. A step
/// takes a few milliseconds; the next follows while the window stays quiet.
const FINISH_STEP: usize = 512

/// A quiet moment collects garbage when JavaScript's memory moved at least this much since
/// the last one, and at least a sixteenth of what was in use then ([`RELEASE_MOVED_SHARE`]):
/// a launch, a screen built or taken down, a few screens opened one after another. A full
/// collection walks the whole heap, so a large application pays for one only after a change
/// of some size; smaller changes are the engine's own business.
const RELEASE_MOVED_BYTES: usize = 4194304
/// The share of the settled heap a quiet moment needs it to move by, as a divisor. A quarter
/// let a 420 MB heap grow by 100 MB without a collection: opening five chats one by one never
/// moved it that far, so what they left stayed until the next launch-sized change.
const RELEASE_MOVED_SHARE: usize = 16
/// The most idle memory a quiet moment leaves with the engine for what comes next. An eighth
/// of what is in use, uncapped, kept everything a collection freed in a large heap: 75 MB of
/// a 600 MB one.
const RELEASE_RESERVE_BYTES: usize = 8388608


impl<'r, 'e, 'm, C: Composition> NodeApp<'r, 'e, 'm, C> {
  /// Shows what 2D canvases drew since the last call. Says whether that changed the tree.
  effect fn show2d(self: &mut Self, tree: &mut UiTree<'_>) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    return match &self.presenter {
      Option<CanvasPresenter>.Some { value } => run presentCanvas2d(&value, &mut tree)
      Option<CanvasPresenter>.None => false
    }
  }

  /// Installs `__ui` and the prelude in `runtime`'s realm; `api` is the runtime's [`HostApi`].
  pub effect fn make(runtime: &'r mut Runtime<'e, 'm, C>, api: UiApi) -> NodeApp<'r, 'e, 'm, C> ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut app = NodeApp { runtime: move runtime, api: api, bridge: Bridge.make(), openers: Openers.make(), finished: false, status: 0, zoom: 1.0, presenter: Option<CanvasPresenter>.None, settled: 0, quietTraced: false, censusTraced: false, waiting: List<*mut HeapHeader>.make(), searched: false, webViews: List<HostedView>.make(), placesPending: false, nudge: Option<Nudge>.None }
    app.lend()
    run app.install()
    run app.script(prelude(), b"ui-js:node-prelude")
    return move app
  }

  /// Hands back what JavaScript no longer uses, for a window gone quiet
  /// (`WindowClient.quiet`). First a step of finishing the functions compiled as far as a
  /// stub and never called, which frees their definitions; while any are left the rest
  /// waits for a later step ([`NodeApp.finishing`]). Then a full collection when the heap
  /// moved enough since the last one ([`RELEASE_MOVED_BYTES`]) or `shed` says a large
  /// subtree went, and the pooled arenas left wholly idle go back to the system, keeping an
  /// eighth of what is in use for what comes next, [`RELEASE_RESERVE_BYTES`] at most. What
  /// parsing and starting a large bundle
  /// left behind goes this way.
  effect fn releaseIdle(self: &mut Self, shed: bool) -> () ? &mut Allocator {
    let context = self.runtime.rawContext()
    let engine = self.runtime.rawEngine()
    let memory = engine.memory
    let heap = unsafe engineRuntime.contextRuntime(context)
    let used = memory.usedBytes()
    let moved = if used > self.settled { used - self.settled } else { self.settled - used }
    let changed = moved >= RELEASE_MOVED_BYTES && moved >= self.settled / RELEASE_MOVED_SHARE
    if changed { self.searched = false }
    if !self.searched && self.waiting.length() == 0 {
      // Without memory for the list the functions wait, as they did.
      drop run Effect.result(unsafe compilerFinish.waitingStubs(heap, &mut self.waiting))
      self.searched = true
      if self.quietTraced && self.waiting.length() != 0 {
        StderrWriter.print("silkui: quiet, {} functions never called to finish, {} a step\n", &(self.waiting.length(), FINISH_STEP))
      }
    }
    if self.waiting.length() != 0 {
      drop run unsafe compilerFinish.finishWaiting(&mut engine.*, heap, &mut self.waiting, FINISH_STEP)
      if self.waiting.length() != 0 { return }
    }
    let collected = shed || changed
    if collected { drop run unsafe engineRuntime.triggerGC(memory, &mut engine.*, heap, 0, true) }
    let live = memory.usedBytes()
    let reserve = if live / 8 < RELEASE_RESERVE_BYTES { live / 8 } else { RELEASE_RESERVE_BYTES }
    let released = unsafe engineRuntime.releaseIdle(memory, heap, reserve)
    if collected { self.settled = live }
    if self.quietTraced && (collected || released != 0) {
      StderrWriter.print("silkui: quiet, javascript used {} then {} bytes, {} released\n", &(used, live, released))
    }
    if self.censusTraced && collected {
      // Without memory for the rows there is no census this time.
      let mut rows = CensusRows.make()
      if let Result.Success { .. } = run Effect.result(unsafe engineCensus.collect(heap, memory, &mut rows)) {
        let names = rows.names.asSlice()
        let values = rows.values.asSlice()
        let mut index: usize = 0
        while index < names.length {
          let kind = values[index * 4]
          let label = if kind == engineCensus.HELD { "held" } else if kind == engineCensus.UNIT { "unit" } else { "work" }
          StderrWriter.print("silkui: js census {} {} {} {} {}\n", &(names[index], label, values[index * 4 + 1], values[index * 4 + 2], values[index * 4 + 3]))
          index = index + 1
        }
      }
    }
  }

  /// Whether the last quiet step left never-called functions to finish.
  fn finishing(self: &Self) -> bool {
    return self.waiting.length() != 0
  }

  /// Gives back the references of the functions still listed, before the runtime goes.
  fn forget(self: &mut Self) -> () {
    let context = self.runtime.rawContext()
    let engine = self.runtime.rawEngine()
    unsafe compilerFinish.forgetWaiting(&mut engine.*, unsafe engineRuntime.contextRuntime(context), &mut self.waiting)
  }

  /// Points the runtime's [`UiApi`] at this app's bridge, which may have moved since.
  fn lend(self: &mut Self) -> () {
    self.api.lend(&mut self.bridge)
  }

  effect fn install(self: &mut Self) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = self.runtime.rawContext()
    let engine = self.runtime.rawEngine()
    let memory = engine.memory
    let realm = unsafe lendRealm(&context, context)
    let ui = run objects.newObject(&mut engine.*, memory, realm)
    let mut at: usize = 0
    while true {
      match bridge.native(at) {
        Option.Some { value } => {
          let function = run functions.newFunction(&mut engine.*, memory, realm, NativeFunctionId.Host { id: HOST_API_FIRST + bridge.nativeId(value.name) }, value.name, value.arity, NativeCallProtocol.Generic, 0)
          run common.define(&mut engine.*, realm, ui.borrow(), value.name, unsafe Value.adoptBits(function), 7)
        }
        Option.None => { break }
      }
      at = at + 1
    }
    run common.define(&mut engine.*, realm, realm.globalObject(), b"__ui", move ui, 7)
  }

  /// Runs `source` as a script named `name`.
  effect fn script(self: &mut Self, source: &[u8], name: &[u8]) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    let context = self.runtime.rawContext()
    let engine = self.runtime.rawEngine()
    let memory = engine.memory
    let realm = unsafe lendRealm(&context, context)
    let value = run evaluation.evaluate(&mut engine.*, memory, realm, source, name, flags.TYPE_GLOBAL)
    realm.release(&mut engine.*, move value)
  }

  /// Makes `source` importable as `name` from every module (`import { x } from "name"`).
  pub effect fn define(self: &mut Self, name: &[u8], source: &[u8]) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    let first = run text(name)
    let second = run text(source)
    let defined = run self.callUi(b"defineModule", &[first.borrow().view(), second.borrow().view()])
    self.release(move defined)
    self.release(move first)
    self.release(move second)
  }

  /// Runs the ES module `source` named `name`, an absolute path or a URL its relative imports
  /// resolve from. Its errors are the runtime's, reported as uncaught.
  pub effect fn entry(self: &mut Self, name: &[u8], source: &[u8]) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    self.lend()
    run self.runtime.evaluateModule(name, source)
  }

  /// [`NodeApp.entry`] from `image`, the bytecode image this program's build wrote of
  /// `source` ([`NodeApp.writeImage`]): nothing is parsed, and each function's code stays in
  /// the image's bytes until its first call.
  ///
  /// Safety: `image` stays readable and unchanged until the process ends.
  pub unsafe effect fn entryImage(self: &mut Self, name: &[u8], source: &[u8], image: &[u8]) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
    self.lend()
    run unsafe self.runtime.evaluateModuleImage(name, source, Pointer.fromRef<u8>(&image[0]), image.length)
  }

  /// The ES module `source` named `name` as a bytecode image, compiled and not run. The
  /// modules it imports are defined first ([`NodeApp.define`]).
  pub effect fn writeImage(self: &mut Self, name: &[u8], source: &[u8]) -> List<u8> ! OutOfMemoryError | JsException ? &mut Allocator {
    self.lend()
    return run self.runtime.writeModuleImage(name, source)
  }

  fn release(self: &mut Self, value: Value) -> () {
    let context = self.runtime.rawContext()
    let realm = unsafe lendRealm(&context, context)
    realm.release(&mut self.runtime.rawEngine().*, move value)
  }

  /// Calls `__ui.<name>(...arguments)` as a callback of the runtime's, and returns what it
  /// returned. An exception it throws reaches the caller.
  effect fn callUi(self: &mut Self, name: &[u8], arguments: &[ValueBits]) -> Value ! OutOfMemoryError | JsException ? &mut Allocator {
    self.lend()
    let context = self.runtime.rawContext()
    let realm = unsafe lendRealm(&context, context)
    let ui = run common.get(&mut self.runtime.rawEngine().*, realm, realm.globalObject(), b"__ui")
    let function = run common.get(&mut self.runtime.rawEngine().*, realm, ui.borrow(), name)
    if !function.borrow().view().isObject() {
      self.release(move function)
      self.release(move ui)
      return Value.immediate(ValueBits.Undefined)
    }
    let called = run Effect.result(self.runtime.callback(function.borrow().view(), ui.borrow().view(), arguments))
    self.release(move function)
    self.release(move ui)
    return match move called {
      Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => unsafe Value.adoptBits(value)
      Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error }
    }
  }

  /// [`NodeApp.callUi`], with an exception it throws printed as uncaught (`__ui.report`).
  effect fn callReporting(self: &mut Self, name: &[u8], arguments: &[ValueBits]) -> Value ! OutOfMemoryError ? &mut Allocator {
    let called = run Effect.result(self.callUi(name, arguments))
    return match move called {
      Result<Value, OutOfMemoryError | JsException>.Success { value } => move value
      Result<Value, OutOfMemoryError | JsException>.Failure { error } => match move error {
        OutOfMemoryError allocation => { fail move allocation }
        JsException _ => {
          run self.reportPending()
          Value.immediate(ValueBits.Undefined)
        }
      }
    }
  }

  /// Prints the pending exception as uncaught, with its stack (`__ui.report`).
  effect fn reportPending(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let context = self.runtime.rawContext()
    let realm = unsafe lendRealm(&context, context)
    let thrown = realm.takeException()
    let reported = run Effect.result(self.callUi(b"report", &[thrown.borrow().view()]))
    self.release(move thrown)
    match move reported {
      Result<Value, OutOfMemoryError | JsException>.Success { value } => { self.release(move value) }
      Result<Value, OutOfMemoryError | JsException>.Failure { error: failure } => match move failure {
        OutOfMemoryError allocation => { fail move allocation }
        JsException _ => {
          let again = realm.takeException()
          self.release(move again)
          write("Uncaught exception, and __ui.report threw too\n")
        }
      }
    }
  }

  /// Applies what JavaScript queued to `tree`, and opens the addresses it asked to open.
  /// Says whether the tree changed.
  pub effect fn flush(self: &mut Self, tree: &mut UiTree<'_>) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    let opened = Intrinsic.replace(self.bridge.opened, List<String>.make())
    let addresses = opened.asSlice()
    let mut i: usize = 0
    while i < addresses.length {
      if !run self.openers.open(String.utf8Bytes(String.view(&addresses[i]))) {
        write("Could not open ")
        write(String.view(&addresses[i]))
        write("\n")
      }
      i = i + 1
    }
    if self.bridge.batch.length() == 0 { return false }
    let stale = tree.staleSkipped
    run tree.apply(run self.bridge.batch.take())
    if tree.staleSkipped != stale {
      StderrWriter.print("silkui: skipped {count} mutations of nodes that no longer exist\n", &.{ count: tree.staleSkipped - stale })
    }
    return true
  }

  /// Answers JavaScript's clipboard calls through `platform`, and the calls their promise
  /// jobs made, then applies what it built. Says whether there were calls.
  pub effect fn clipboard(self: &mut Self, tree: &mut UiTree<'_>, platform: &mut HostPlatform) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    let mut round: usize = 0
    while round < CLIPBOARD_ROUNDS {
      let requests = Intrinsic.replace(self.bridge.clipboard, List<bridge.ClipboardRequest>.make())
      if requests.length() == 0 { break }
      let mut answers = run serveClipboard(move requests, &mut platform)
      while answers.length() > 0 {
        let ClipboardAnswer { call, text: answer, item } = answers.remove(0)
        if let Option<EncodedItem>.Some { value: encoded } = move item {
          let header = run text(String.utf8Bytes(encoded.header.view()))
          let body = run binary(encoded.body.asSlice())
          let returned = run self.callReporting(b"clipboardItem", &[ValueBits.number(u32.toF64(call)), header.borrow().view(), body.borrow().view()])
          self.release(move returned)
          self.release(move header)
          self.release(move body)
          continue
        }
        let value = match move answer {
          Option.Some { value } => run text(String.utf8Bytes(String.view(&value)))
          Option.None => Value.immediate(ValueBits.Undefined)
        }
        let returned = run self.callReporting(b"clipboard", &[ValueBits.number(u32.toF64(call)), value.borrow().view()])
        self.release(move returned)
        self.release(move value)
      }
      round = round + 1
    }
    if round == 0 { return false }
    drop run self.flush(&mut tree)
    return true
  }

  /// Starts JavaScript's `fn.async(...)` calls of exported Silk functions on threads, and
  /// settles the ones that ended, then applies what their promise jobs built. Says whether a
  /// call ended.
  pub effect fn natives(self: &mut Self, jobs: &mut NativeJobs, tree: &mut UiTree<'_>) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    let started = Intrinsic.replace(self.bridge.started, List<bridge.StartedNative>.make())
    if started.length() != 0 { run jobs.start(move started, self.bridge.natives) }
    let mut done = run jobs.finished()
    if done.length() == 0 { return false }
    while done.length() > 0 {
      let Finished { token, reply } = done.remove(0)
      let mut kind: f64 = 0.0
      let value = match move reply {
        Reply.Nothing => Value.immediate(ValueBits.Undefined)
        Reply.Number { value: number } => Value.immediate(ValueBits.number(number))
        Reply.Flag { value: flag } => Value.immediate(ValueBits.Bool { value: flag })
        Reply.Text { value: words } => run text(String.utf8Bytes(String.view(&words)))
        Reply.TypeError { message } => {
          kind = 1.0
          run text(String.utf8Bytes(String.view(&message)))
        }
        Reply.Failed { message } => {
          kind = 2.0
          run text(String.utf8Bytes(String.view(&message)))
        }
        Reply.OutOfMemory => {
          kind = 2.0
          run text(b"out of memory")
        }
      }
      let returned = run self.callReporting(b"nativeDone", &[ValueBits.number(u32.toF64(token)), ValueBits.number(kind), value.borrow().view()])
      self.release(move returned)
      self.release(move value)
    }
    drop run self.flush(&mut tree)
    return true
  }

  /// Runs web view call `op` with `text`'s fields: opening and closing keep the view's node here,
  /// showing is served here, the rest goes to the platform's views.
  effect fn webView(
    self: &mut Self,
    op: u32,
    text: string,
    platform: &mut HostPlatform,
    window: WindowId,
  ) -> f64
    ! OutOfMemoryError
    ? &mut Allocator {
    let view = fieldNumber(text, 0)
    if op == OP_QUIT {
      self.finished = true
      self.status = u32.toI32(view)
      return 0.0
    }
    if op == OP_SHOW {
      let shown = fieldNumber(text, 1) != 0
      let list = self.webViews.asMutSlice()
      let mut i: usize = 0
      while i < list.length {
        if list[i].view == view {
          list[i].shown = shown
          list[i].wanted.visible = shown
            && list[i].wanted.bounds.xMax > list[i].wanted.bounds.xMin
            && list[i].wanted.bounds.yMax > list[i].wanted.bounds.yMin
          self.placesPending = true
        }
        i = i + 1
      }
      return 0.0
    }
    let value = run platform.webView(op, window, text)
    if op == OP_OPEN && value != 0.0 {
      let hidden = Placement.hidden()
      run self.webViews.append(
        HostedView {
          view: view,
          node: fieldNumber(text, 1),
          shown: true,
          placed: hidden,
          wanted: hidden,
        },
      )
      self.placesPending = true
    }
    if op == OP_CLOSE {
      let mut i: usize = 0
      while i < self.webViews.length() {
        if self.webViews.asSlice()[i].view == view {
          drop self.webViews.remove(i)
        } else {
          i = i + 1
        }
      }
    }
    return value
  }

  /// Where the last layout puts each web view: its node's border box, in the window.
  effect fn measureWebViews(self: &mut Self, tree: &UiTree<'_>, scale: f32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.webViews.length() == 0 {
      return ()
    }
    let window = Rect<f32>.new(0.0, 0.0, tree.input.width, tree.input.height)
    let list = self.webViews.asMutSlice()
    let mut moved = false
    let mut i: usize = 0
    while i < list.length {
      let rect = run getBoundingClientRect(tree, list[i].node)
      let x = f64.toF32(rect.x)
      let y = f64.toF32(rect.y)
      let bounds = Rect<f32>.new(x, y, x + f64.toF32(rect.width), y + f64.toF32(rect.height))
      let wanted = Placement {
        bounds: bounds,
        clip: window,
        visible: list[i].shown && rect.width > 0.0 && rect.height > 0.0,
        scale: scale,
      }
      if !samePlacement(&wanted, &list[i].wanted) {
        list[i].wanted = wanted
        moved = true
      }
      i = i + 1
    }
    if moved {
      self.placesPending = true
      if let Option<Nudge>.Some { value } = &self.nudge {
        value.nudge()
      }
    }
  }

  /// Places the web views a layout moved and hands what the views reported to JavaScript, then
  /// applies what it built. Says whether there were events.
  effect fn webViewTurn(self: &mut Self, tree: &mut UiTree<'_>, platform: &mut HostPlatform) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.placesPending {
      self.placesPending = false
      let list = self.webViews.asMutSlice()
      let mut i: usize = 0
      while i < list.length {
        if !samePlacement(&list[i].placed, &list[i].wanted) {
          list[i].placed = list[i].wanted
          run platform.placeWebView(list[i].view, list[i].wanted)
        }
        i = i + 1
      }
    }
    let mut events = List<WireEvent>.make()
    run platform.takeWebViewEvents(&mut events)
    if events.length() == 0 {
      return false
    }
    while events.length() != 0 {
      let event = events.remove(0)
      let value = run text(String.utf8Bytes(String.view(&event.text)))
      let arguments = [
        ValueBits.number(u32.toF64(WEB_VIEW_EVENT)),
        ValueBits.number(u32.toF64(event.view)),
        ValueBits.number(u32.toF64(event.code)),
        ValueBits.number(0.0),
        value.borrow().view(),
      ]
      let returned = run self.callReporting(b"shellEvent", &arguments)
      self.release(move returned)
      self.release(move value)
    }
    drop run self.flush(&mut tree)
    return true
  }

  /// Serves JavaScript's desktop calls (notifications, the tray, global shortcuts, menus,
  /// dialogs, `window`'s state) through `platform`, and the calls their promise jobs made,
  /// then applies what it built. Tells JavaScript when the page zoom changed. Says whether
  /// there were calls.
  pub effect fn shell(self: &mut Self, tree: &mut UiTree<'_>, platform: &mut HostPlatform, window: WindowId) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    let zoomed = tree.pageZoom() != self.zoom
    if zoomed {
      self.zoom = tree.pageZoom()
      let value = run text(b"")
      let arguments = [ValueBits.number(11.0), ValueBits.number(f32.toF64(self.zoom)), ValueBits.number(0.0), ValueBits.number(0.0), value.borrow().view()]
      let returned = run self.callReporting(b"shellEvent", &arguments)
      self.release(move returned)
      self.release(move value)
    }
    let mut round: usize = 0
    while round < CLIPBOARD_ROUNDS {
      let all = Intrinsic.replace(self.bridge.shell, List<bridge.ShellRequest>.make())
      if all.length() == 0 { break }
      let mut requests = List<bridge.ShellRequest>.make()
      let mut early = List<ShellAnswer>.make()
      let mut taken = move all
      while taken.length() != 0 {
        let request = taken.remove(0)
        if request.op >= OP_OPEN {
          let value = run self.webView(request.op, String.view(&request.text), &mut platform, window)
          run early.append(ShellAnswer { call: request.call, value: value })
        } else {
          run requests.append(move request)
        }
      }
      let mut answers = run serveShell(move requests, &mut platform, &mut tree, window)
      while early.length() > 0 { run answers.append(early.remove(0)) }
      while answers.length() > 0 {
        let ShellAnswer { call, value } = answers.remove(0)
        let returned = run self.callReporting(b"shellAnswer", &[ValueBits.number(u32.toF64(call)), ValueBits.number(value)])
        self.release(move returned)
      }
      round = round + 1
    }
    if round == 0 && !zoomed { return false }
    drop run self.flush(&mut tree)
    return true
  }

  /// Hands a desktop event (a file drag, a global shortcut, the tray, a notification click)
  /// to JavaScript and applies what it built. Says whether `event` was one.
  pub effect fn desktop(self: &mut Self, tree: &mut UiTree<'_>, event: &Event) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    let made = run shellEventOf(&tree.*, event)
    let ShellEvent { kind, a, x, y, text: words } = match move made {
      Option.Some { value } => move value
      Option.None => {
        return false
      }
    }
    let value = run text(String.utf8Bytes(String.view(&words)))
    let arguments = [ValueBits.number(u32.toF64(kind)), ValueBits.number(a), ValueBits.number(x), ValueBits.number(y), value.borrow().view()]
    let returned = run self.callReporting(b"shellEvent", &arguments)
    self.release(move returned)
    self.release(move value)
    drop run self.flush(&mut tree)
    return true
  }

  /// Hands the tree's queued event records to JavaScript, then applies what it queued. Says
  /// whether a handler prevented a default.
  pub effect fn handle(self: &mut Self, tree: &mut UiTree<'_>) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    let mut raw = List<RawEvent>.make()
    run tree.takeEvents(&mut raw)
    let items = raw.asSlice()
    let mut prevented = false
    let mut i: usize = 0
    while i < items.length {
      let record = run EventRecord.lift(&items[i])
      if run self.dispatch(&record) { prevented = true }
      i = i + 1
    }
    let error = run self.callReporting(b"takeError", &[])
    self.release(move error)
    drop run self.flush(&mut tree)
    return prevented
  }

  /// Calls `__ui.dispatch(kind, target, a, b, modifiers, d, e, first, second, third, fourth)` with `record`
  /// (as the engine-only host does), and says whether it returned true.
  effect fn dispatch(self: &mut Self, record: &EventRecord) -> bool ! OutOfMemoryError ? &mut Allocator {
    let numbers = numbersOf(&record.event)
    let first = run firstString(&record.event)
    let second = run secondString(&record.event)
    let third = run thirdString(&record.event)
    let fourth = run fourthString(&record.event)
    let arguments = [
      ValueBits.number(u32.toF64(kindCode(record.event.kind()))),
      ValueBits.number(u32.toF64(record.target.raw())),
      ValueBits.number(numbers[0]),
      ValueBits.number(numbers[1]),
      ValueBits.number(numbers[2]),
      ValueBits.number(numbers[3]),
      ValueBits.number(numbers[4]),
      first.borrow().view(),
      second.borrow().view(),
      third.borrow().view(),
      fourth.borrow().view(),
    ]
    let returned = run self.callReporting(b"dispatch", &arguments)
    let prevented = match returned.borrow().view() { ValueBits.Bool { value } => value _ => false }
    self.release(move returned)
    self.release(move first)
    self.release(move second)
    self.release(move third)
    self.release(move fourth)
    return prevented
  }

  /// Takes the media of the frame about to be drawn, for `matchMedia`. When it differs,
  /// `__ui.media()` runs, which sends the `change` events of the lists.
  pub effect fn media(self: &mut Self, media: MediaState) -> () ! OutOfMemoryError ? &mut Allocator {
    if !self.bridge.media.differs(&media) { return }
    self.bridge.media = media
    let returned = run self.callReporting(b"media", &[])
    self.release(move returned)
  }

  /// Runs the animation frame callbacks when JavaScript asked for a frame.
  pub effect fn frame(self: &mut Self, seconds: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    if !self.bridge.frame { return }
    self.bridge.frame = false
    let returned = run self.callReporting(b"frame", &[ValueBits.number(seconds * 1000.0)])
    self.release(move returned)
  }

  /// Runs IntersectionObserver and ResizeObserver on `tree`'s last layout (see `JsHost.observe`).
  pub effect fn observe<'t>(self: &mut Self, tree: &mut UiTree<'t>) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    if !self.bridge.observers.any() { return }
    self.bridge.geometry.clear()
    let count = run self.bridge.observers.update(&tree.*, &mut self.bridge.geometry)
    if count == 0 { return }
    self.bridge.attach(&mut tree)
    let returned = run self.callReporting(b"observed", &[ValueBits.number(usize.toF64(count))])
    self.release(move returned)
    drop run self.flush(&mut tree)
  }

  /// One turn of the runtime's loop, waiting at most `seconds` (with no limit when negative)
  /// for a timer, a completion or a window event. Says whether the turn left mutations for the tree.
  pub effect fn turn(self: &mut Self, seconds: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.finished { return }
    self.lend()
    let turned = run Effect.result(self.runtime.turn(if seconds < 0.0 { -1.0 } else { seconds * 1000.0 }))
    match move turned {
      Result<Turn, OutOfMemoryError | JsException>.Success { value } => match move value {
        Turn.Running => ()
        Turn.Finished { status } => {
          self.finished = true
          self.status = status
        }
      }
      Result<Turn, OutOfMemoryError | JsException>.Failure { error } => match move error {
        OutOfMemoryError allocation => { fail move allocation }
        JsException _ => { run self.reportPending() }
      }
    }
  }

  /// How many mutations JavaScript queued since the last flush.
  pub fn pending(self: &Self) -> usize { return self.bridge.batch.length() }

  /// Whether JavaScript asked for an animation frame.
  pub fn wantsFrame(self: &Self) -> bool { return self.bridge.frame }

  /// Whether a newly registered observer awaits its initial delivery after layout.
  pub fn observersPending(self: &Self) -> bool { return self.bridge.observers.pending }

  /// The runtime's exit status once it finished.
  pub fn exitStatus(self: &Self) -> Option<i32> {
    if self.finished { return Option<i32>.some(self.status) }
    return Option<i32>.none()
  }
}

/// A JavaScript string of `bytes`, which are UTF-8.
effect fn text(bytes: &[u8]) -> Value ! OutOfMemoryError ? &mut Allocator {
  let made = run Effect.result(Strings.fromUtf8(bytes))
  return match move made {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError _ => Value.immediate(ValueBits.Undefined)
    }
  }
}

/// `bytes` as a string of one code unit per byte.
effect fn binary(bytes: &[u8]) -> Value ! OutOfMemoryError ? &mut Allocator {
  let made = run Effect.result(Strings.fromLatin1(bytes))
  return match move made {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => unsafe Value.adoptBits(value)
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError _ => Value.immediate(ValueBits.Undefined)
    }
  }
}

/// The window client of a [`NodeApp`].
pub struct NodeClient {
  pub stylesheetCompiler: StylesheetCompiler,
  /// The app's exported Silk functions, which `__ui.native` calls.
  pub natives: Natives,
  /// Compiled application stylesheets, installed before each root first paints.
  pub stylesheets: StyleAssets,
  pub stylesheetUpdates: SheetWatch,
  /// How the window's title bar is drawn (see `ui_js_window.lib.JsClient.titleBar`).
  pub titleBar: TitleBar,
  pub titleBarHeight: f64,
  /// With a transparent title bar, the window controls' gaps from the window's left and top
  /// edges; 0 centres them in the bar (see `WindowOptions.controlsLeft`).
  pub controlsLeft: f64,
  pub controlsTop: f64,
  windowDrag: bool,
  /// Loads the image, icon and `url()` addresses the application names (see
  /// `ui_js_window.lib.JsClient.loader`).
  pub loader: Loader,
  /// The `fn.async(...)` calls of exported Silk functions running on threads.
  jobs: NativeJobs,
}

impl NodeClient {
  pub fn make() -> NodeClient {
    return NodeClient { stylesheetCompiler: StylesheetCompiler.off(), natives: Natives.off(), titleBar: TitleBar.Standard, titleBarHeight: 0.0, controlsLeft: 0.0, controlsTop: 0.0, windowDrag: false, stylesheets: StyleAssets.make(), stylesheetUpdates: SheetWatch.make(), loader: Loader.make(), jobs: NativeJobs.make() }
  }

  /// Starts the loads the last batch asked for; what ended is told to the application's
  /// `load` and `error` listeners at once.
  effect fn load<'r, 'e, 'm, C: Composition>(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if !(run self.loader.serve(&mut tree)) { return false }
    drop run state.handle(&mut tree)
    return true
  }
}

/// A [`NodeClient`] as the window client of a runtime of capabilities `C`.
struct Driven<'c, C> {
  client: &'c mut NodeClient,
  // Names `C` in the type, which the window client's conformance needs; always null.
  composition: ?*mut C,
}

impl<'c, 'r, 'e, 'm, C: Composition> WindowClient<NodeApp<'r, 'e, 'm, C>, never, never> for Driven<'c, C> {
  fn needsFrame(self: &Self, state: &NodeApp<'r, 'e, 'm, C>, tree: &UiTree<'_>) -> bool {
    // A callback requested by input, a timer, or I/O must wake an idle window before it
    // changes the tree. wantsFrames keeps callbacks going once frames are running.
    return state.wantsFrame() || state.observersPending() || tree.needsFrame()
  }

  effect fn layout(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>, input: FrameInput) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    state.bridge.attach(&mut tree)
    run state.media(tree.mediaState(input))
    let root = tree.current
    drop run self.client.stylesheets.serve(&mut tree.*, root)
    run tree.frame(input)
    let mut at: usize = 0
    while at < tree.virtualLists.length() {
      let args = run bridge.virtualRequest(&tree, at)
      if args.length() != 0 {
        let returned = run state.callReporting(b"virtualRequest", args.asSlice())
        state.release(move returned)
      }
      at = at + 1
    }
    if tree.virtualLists.length() != 0 && run state.flush(&mut tree) { run tree.frame(input) }
    run state.observe(&mut tree)
    drop run self.client.load(&mut state, &mut tree)
    run state.measureWebViews(&tree.*, input.scale)
  }

  effect fn layoutRoot(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>, root: u32, input: FrameInput) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    if (run tree.useRoot(root)) || tree.current == root {
      run WindowClient<NodeApp<'r, 'e, 'm, C>, never, never>.layout(&mut self.*, &mut state.*, &mut tree.*, input)
    }
  }

  effect fn canvases(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, presenter: CanvasPresenter) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    state.presenter = Option<CanvasPresenter>.some(move presenter)
    state.bridge.canvas2dEnabled = true
  }

  fn configure(self: &Self, state: &NodeApp<'r, 'e, 'm, C>, options: &mut WindowOptions<'_>) -> () {
    options.titleBar = self.client.titleBar
    options.titleBarHeight = self.client.titleBarHeight
    options.controlsLeft = self.client.controlsLeft
    options.controlsTop = self.client.controlsTop
  }

  effect fn event(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>, event: &Event) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    state.bridge.attach(&mut tree)
    if run state.desktop(&mut tree, event) {
      drop run self.client.load(&mut state, &mut tree)
      return true
    }
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      if let Event.MouseDown { button, position, .. } = &event.* {
        if self.client.titleBar == TitleBar.Transparent && button == MouseButton.Left && tree.dragsWindow(f64.toF32(position.x), f64.toF32(position.y)) {
          self.client.windowDrag = true
          return true
        }
      }
    }
    return false
  }

  effect fn update(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>, platform: &mut HostPlatform, window: WindowId) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    state.bridge.attach(&mut tree)
    if self.client.windowDrag {
      self.client.windowDrag = false
      Platform.startWindowDrag(&mut platform.*, window)
    }
    let clipboard = run state.clipboard(&mut tree, &mut platform.*)
    let shell = run state.shell(&mut tree, &mut platform.*, window)
    let views = run state.webViewTurn(&mut tree, &mut platform.*)
    let natives = run state.natives(&mut self.client.jobs, &mut tree)
    let drawn = run state.show2d(&mut tree)
    return clipboard || shell || views || natives || drawn
  }

  effect fn start(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    state.bridge.attach(&mut tree)
    tree.skipsStale = true
    run self.client.stylesheets.preload(&mut tree.*)
    // The entry ran before the window opened; what it built is the first frame.
    drop run state.flush(&mut tree)
    drop run state.show2d(&mut tree)
    drop run self.client.load(&mut state, &mut tree)
  }

  effect fn opened(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, platform: &mut HostPlatform, window: WindowId) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    state.nudge = Option<Nudge>.some(platform.nudge())
    platform.alsoWake(AlsoWake { wake: wakeRuntime, token: state.runtime.wakerAddress() })
  }

  effect fn poll(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>, time: f64) -> bool
    ! WindowError | TreeError | OutOfMemoryError ? &mut Allocator {
    state.bridge.attach(&mut tree)
    let styled = run self.client.stylesheetUpdates.poll(&mut self.client.stylesheets, &mut tree, time)
    run self.client.loader.watch(time)
    let loaded = run self.client.load(&mut state, &mut tree)
    let natives = run state.natives(&mut self.client.jobs, &mut tree)
    return styled || loaded || natives || state.wantsFrame()
  }

  fn wakeAfter(self: &Self, state: &NodeApp<'r, 'e, 'm, C>) -> Option<f64> {
    let wanted = self.client.loader.watchAfter(self.client.stylesheetUpdates.wakeAfter(Option<f64>.None))
    if !self.client.loader.pending() && !self.client.jobs.pending() { return wanted }
    // Collect running loads and Silk calls about once a frame.
    return match wanted {
      Option<f64>.Some { value } => Option<f64>.some(f64.min(value, 0.016))
      Option<f64>.None => Option<f64>.some(0.016)
    }
  }

  fn quitting(self: &Self, state: &NodeApp<'r, 'e, 'm, C>) -> bool {
    return state.finished
  }

  fn waitsItself(self: &Self, state: &NodeApp<'r, 'e, 'm, C>) -> bool {
    return true
  }

  effect fn wait(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>, seconds: f64) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    state.bridge.attach(&mut tree)
    run state.turn(seconds)
    let flushed = run state.flush(&mut tree)
    let drawn = run state.show2d(&mut tree)
    let loaded = run self.client.load(&mut state, &mut tree)
    return flushed || drawn || loaded || state.wantsFrame() || state.observersPending()
  }

  // A build with the development tools serves it, so headless scripts run; a release build
  // leaves it out.
  fn servesInspector(self: &Self) -> bool {
    static if devtools.enabled {
      return true
    } else {
      return false
    }
  }

  effect fn pump(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    state.bridge.attach(&mut tree)
    drop run state.handle(&mut tree)
    drop run self.client.load(&mut state, &mut tree)
  }

  effect fn decide(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    state.bridge.attach(&mut tree)
    let prevented = run state.handle(&mut tree)
    drop run self.client.load(&mut state, &mut tree)
    return prevented
  }

  effect fn tick(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>, time: f64, animation: bool) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    state.bridge.attach(&mut tree)
    // Timers are the runtime's and run in `wait`; a frame runs the animation callbacks.
    if animation { run state.frame(time) }
    drop run state.flush(&mut tree)
    drop run state.show2d(&mut tree)
    drop run self.client.load(&mut state, &mut tree)
  }

  fn wantsFrames(self: &Self, state: &NodeApp<'r, 'e, 'm, C>) -> bool {
    return state.wantsFrame()
  }

  effect fn presented(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, intervals: &[f64], dropped: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run state.bridge.presented(intervals, dropped)
  }

  effect fn quiet(self: &mut Self, state: &mut NodeApp<'r, 'e, 'm, C>, tree: &mut UiTree<'_>, shed: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run state.releaseIdle(shed)
  }

  fn quietAgain(self: &Self, state: &NodeApp<'r, 'e, 'm, C>) -> bool {
    return state.finishing()
  }
}

/// A module for [`NodeWindow.define`].
struct Defined {
  name: List<u8>,
  source: List<u8>,
}

/// What [`NodeWindow.run`] starts: the runtime, the application's modules, then the window.
pub struct NodeWindow<'f> {
  fonts: &'f FontCollection,
  options: Option<RunOptions>,
  client: NodeClient,
  modules: List<Defined>,
  name: List<u8>,
  source: List<u8>,
  /// The entry's text when it is part of the program ([`NodeWindow.entryEmbedded`]).
  embedded: &'static [u8],
  /// The file that may hold the entry's bytecode image ([`NodeWindow.imageFile`]).
  image: ImageFile,
  /// The runtime's `HostApi`, set by `start`.
  api: Option<UiApi>,
  /// Whether the process ends with the runtime, which then starts from the program's heap image.
  ownsProcess: bool,
  /// What failed in the window host, kept until `run` returns.
  failure: Option<WindowError | GpuError | TreeError | AtlasError | GeometryError>,
}

impl<'f> NodeWindow<'f> {
  pub fn make(fonts: &'f FontCollection, options: RunOptions, client: NodeClient) -> NodeWindow<'f> {
    return NodeWindow {
      fonts: fonts,
      options: Option<RunOptions>.some(move options),
      client: move client,
      modules: List<Defined>.make(),
      name: List<u8>.make(),
      source: List<u8>.make(),
      embedded: b"",
      image: ImageFile.none(),
      api: Option<UiApi>.None,
      ownsProcess: false,
      failure: Option<WindowError | GpuError | TreeError | AtlasError | GeometryError>.None,
    }
  }

  /// Makes `source` importable as `name` (see [`NodeApp.define`]).
  pub effect fn define(self: &mut Self, name: &[u8], source: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut nameCopy = List<u8>.make()
    run nameCopy.appendSlice(name)
    let mut sourceCopy = List<u8>.make()
    run sourceCopy.appendSlice(source)
    run self.modules.append(Defined { name: move nameCopy, source: move sourceCopy })
  }

  /// The process ends when the window's runtime does, and the runtime starts from the heap image
  /// appended to the program ([`writeHeapImage`]) when it has one, skipping its bootstrap. A
  /// release host's choice: nothing runs after `start` then.
  pub fn ownProcess(self: &mut Self) -> () {
    self.ownsProcess = true
  }

  /// The ES module the window runs, named by an absolute path or a URL.
  pub effect fn entry(self: &mut Self, name: &[u8], source: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    self.name.clear()
    run self.name.appendSlice(name)
    self.source = List<u8>.make()
    run self.source.reserveExact(source.length)
    run self.source.appendSlice(source)
  }

  /// [`NodeWindow.entry`] for a text that is part of the program: it is not copied.
  pub effect fn entryEmbedded(self: &mut Self, name: &[u8], source: &'static [u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    self.name.clear()
    run self.name.appendSlice(name)
    self.source = List<u8>.make()
    self.embedded = source
  }

  /// The file that holds the entry's bytecode image when this program wrote one
  /// ([`writeBundleImage`]): the window then starts from it and parses nothing. A file that
  /// is not this program's image of this entry is ignored.
  pub fn imageFile(self: &mut Self, file: ImageFile) -> () {
    self.image = move file
  }

  /// Starts the runtime on this thread with `executable` as its `process.argv[0]` and
  /// `capabilities` (`node_runtime.libs.core.capabilities.Capabilities`, whose `hostApi` is
  /// `api`), runs the entry and the window until it closes or the application calls
  /// `process.exit`, and returns the exit status.
  pub effect fn start<C: Composition>(self: &mut Self, executable: &[u8], api: UiApi, capabilities: C) -> i32
    ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError | SynchronizationError
    ? &mut Allocator {
    let mut options = run Options.make(executable)
    options.ownsProcess = self.ownsProcess
    self.api = Option<UiApi>.some(api)
    let status = run embed.start(move options, &mut self.*, move capabilities)
    let failure = Intrinsic.replace(self.failure, Option<WindowError | GpuError | TreeError | AtlasError | GeometryError>.None)
    match move failure {
      Option<WindowError | GpuError | TreeError | AtlasError | GeometryError>.Some { value } => { fail move value }
      Option<WindowError | GpuError | TreeError | AtlasError | GeometryError>.None => ()
    }
    return status
  }
}

/// Writes the heap image of a runtime with `capabilities` to `path` and ends the process: what a
/// program that starts its windows with [`NodeWindow.ownProcess`] runs when its first argument
/// is `--silk-write-heap-image`. Appended to the program, the image holds the runtime as its
/// bootstrap leaves it, so it must have the capabilities the windows start with.
pub effect fn writeHeapImage<C: Composition>(executable: &[u8], path: &[u8], capabilities: C) -> i32
  ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  let mut options = run Options.make(executable)
  options.ownsProcess = true
  run options.arguments.append(run Bytes.copy(b"--silk-write-heap-image"))
  run options.arguments.append(run Bytes.copy(path))
  let mut host = Imaging {}
  return run embed.start(move options, &mut host, move capabilities)
}

/// Writes the bytecode image of the ES module `source` to the file `path`
/// ([`NodeWindow.imageFile`] reads it), compiled by a runtime with `capabilities` as the
/// windows start one, where `@silkui/core` is `library`. What a release host runs when its
/// first argument is `--silk-write-bundle-image`: the image is of the engine this program
/// links, so only the program itself can write it. Returns the exit status.
pub effect fn writeBundleImage<C: Composition>(executable: &[u8], path: &[u8], library: &[u8], source: &'static [u8], api: UiApi, capabilities: C) -> i32
  ! OutOfMemoryError | SynchronizationError ? &mut Allocator {
  let mut options = run Options.make(executable)
  options.ownsProcess = true
  options.keepAlive = false
  let mut pathCopy = List<u8>.make()
  run pathCopy.appendSlice(path)
  let mut libraryCopy = List<u8>.make()
  run libraryCopy.appendSlice(library)
  let mut host = BundleImaging { api: api, path: move pathCopy, library: move libraryCopy, source: source }
  return run embed.start(move options, &mut host, move capabilities)
}

/// Writes `image`, the bytecode image of `source` ([`NodeApp.writeImage`]), to the file `path`
/// in the form [`ImageFile`] reads.
pub effect fn saveImage(path: &[u8], source: &[u8], image: &[u8]) -> usize ! FileError | OutOfMemoryError ? &mut Allocator {
  let file = run imageFiles.assemble(source, image)
  run saved(path, file.asSlice())
  return file.length()
}

effect fn saved(path: &[u8], bytes: &[u8]) -> () ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut files = run MachineFileSystem.make()
  run FileSystem.writeFile(&run Path.fromBytes(path), bytes) |> Effect.provideMut<FileSystem>(&mut files)
}

/// Compiles the bundle in a runtime set up as a window's, and never runs it.
struct BundleImaging {
  api: UiApi,
  path: List<u8>,
  library: List<u8>,
  source: &'static [u8],
}

impl Host for BundleImaging {
  effect fn drive<'e, 'm, C: Composition>(self: &mut Self, runtime: &mut Runtime<'e, 'm, C>) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut app = run NodeApp.make(&mut runtime.*, self.api)
    run app.define(b"@silkui/core", self.library.asSlice())
    // Any name: the image runs under the one the bundle has where the app is installed.
    let image = run app.writeImage(b"/app/app.js", self.source)
    let written = run Effect.result(saveImage(self.path.asSlice(), self.source, image.asSlice()))
    match move written {
      Result<usize, FileError | OutOfMemoryError>.Success { value } => {
        StderrWriter.print("silkui: {} bytes of JavaScript compiled into a {} byte bytecode image\n", &(self.source.length, value))
      }
      Result<usize, FileError | OutOfMemoryError>.Failure { error } => {
        drop error
        StderrWriter.print("silkui: the bytecode image could not be written to its file\n", &())
        return 1
      }
    }
    return 0
  }
}

/// The runtime ends the process when its image is written, before any host runs.
struct Imaging {}

impl Host for Imaging {
  effect fn drive<'e, 'm, C: Composition>(self: &mut Self, runtime: &mut Runtime<'e, 'm, C>) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
    return 1
  }
}

fn sayTreeError(error: TreeError) -> () {
  match error {
    TreeError.StyleSheet { index, sheet, .. } => sayFailure("a style sheet failed", index, sheet)
    TreeError.UnknownNode { index, id } => sayFailure("a mutation names a node that does not exist", index, id)
    TreeError.IdInUse { index, id } => sayFailure("a mutation creates a node id already in use", index, id)
    TreeError.WrongKind { index, id } => sayFailure("a mutation does not apply to the node's kind", index, id)
    TreeError.BadMove { index, id } => sayFailure("a mutation would put a node inside itself", index, id)
    TreeError.UnknownResource { index, resource } => sayFailure("a mutation names an undefined resource", index, resource)
    TreeError.BadResource { index, resource } => sayFailure("a resource did not decode", index, resource)
    TreeError.Layout => sayFailure("layout or text shaping failed", 0, 0)
    TreeError.BadVirtualList { index, id } => sayFailure("a virtual list is invalid", index, id)
    TreeError.View { .. } => sayFailure("a scroll operation failed", 0, 0)
  }
}

fn sayFailure(what: string, index: usize, id: u32) -> () {
  StderrWriter.print("silkui: the JavaScript window host failed: {what} (mutation {index}, id {id})\n", &.{ what: what, index: index, id: id })
}

/// The inspector of a build with the development tools, when SILK_UI_INSPECT asks for it.
effect fn windowInspector() -> Inspector ! OutOfMemoryError ? &mut Allocator {
  static if devtools.enabled {
    return run startInspector(InspectorOptions { releaseBuilds: true, announce: true })
  } else {
    return Inspector.off()
  }
}

impl<'f> Host for NodeWindow<'f> {
  effect fn drive<'e, 'm, C: Composition>(self: &mut Self, runtime: &mut Runtime<'e, 'm, C>) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
    let tracing = (run environmentVariable("SILK_UI_TRACE_FRAMES")).isSome()
    if tracing { StderrWriter.print("silkui: runtime open\n", &()) }
    let api = match self.api { Option<UiApi>.Some { value } => value Option<UiApi>.None => { return 1 } }
    let mut app = run NodeApp.make(&mut runtime.*, api)
    if tracing { StderrWriter.print("silkui: ui installed\n", &()) }
    app.bridge.stylesheetCompiler = self.client.stylesheetCompiler
    app.bridge.natives = self.client.natives
    let items = self.modules.asSlice()
    let mut i: usize = 0
    while i < items.length {
      run app.define(items[i].name.asSlice(), items[i].source.asSlice())
      i = i + 1
    }
    // Each module's text is the engine's from here: a large bundle's is not kept twice.
    self.modules = List<Defined>.make()
    if self.embedded.length != 0 {
      let text = self.embedded
      let compiled = self.image.image(text)
      if compiled.length != 0 {
        // The file stays mapped until the process ends, which is as long as the engine reads it.
        run unsafe app.entryImage(self.name.asSlice(), text, compiled)
        if tracing { StderrWriter.print("silkui: JavaScript starts from its bytecode image ({} bytes, for {} bytes of text)\n", &(compiled.length, text.length)) }
      } else {
        run app.entry(self.name.asSlice(), text)
      }
    } else {
      run app.entry(self.name.asSlice(), self.source.asSlice())
    }
    self.source = List<u8>.make()
    let jsTrace = run environmentVariable("SILK_UI_TRACE_JS")
    app.quietTraced = jsTrace.isSome()
    app.censusTraced = match &jsTrace {
      Option<String>.Some { value } => value.view() == "census"
      Option<String>.None => false
    }
    // The entry's first turn: its imports and top-level code run before the first frame.
    run app.turn(0.0)
    if tracing { StderrWriter.print("silkui: bundle ready\n", &()) }
    let options = match Intrinsic.replace(self.options, Option<RunOptions>.None) {
      Option<RunOptions>.Some { value } => move value
      Option<RunOptions>.None => { return 1 }
    }
    let mut client = Driven<C> { client: &mut self.client, composition: Pointer.null<C>() }
    let inspector = run windowInspector()
    let ran = run Effect.result(runWindow(&mut app, self.fonts, List<Mutation>.make(), move options, move inspector, &mut client))
    app.forget()
    let status = match move ran {
      Result<i32, WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError>.Success { value } => value
      Result<i32, WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError allocation => { fail move allocation }
        WindowError failure => {
          StderrWriter.print("silkui: the JavaScript window host failed: window error\n", &())
          self.failure = Option<WindowError | GpuError | TreeError | AtlasError | GeometryError>.some(move failure) 1
        }
        GpuError failure => {
          StderrWriter.print("silkui: the JavaScript window host failed: GPU error\n", &())
          self.failure = Option<WindowError | GpuError | TreeError | AtlasError | GeometryError>.some(move failure) 1
        }
        TreeError failure => {
          sayTreeError(failure)
          self.failure = Option<WindowError | GpuError | TreeError | AtlasError | GeometryError>.some(move failure) 1
        }
        AtlasError failure => {
          StderrWriter.print("silkui: the JavaScript window host failed: atlas error\n", &())
          self.failure = Option<WindowError | GpuError | TreeError | AtlasError | GeometryError>.some(move failure) 1
        }
        GeometryError failure => {
          StderrWriter.print("silkui: the JavaScript window host failed: geometry error\n", &())
          self.failure = Option<WindowError | GpuError | TreeError | AtlasError | GeometryError>.some(move failure) 1
        }
      }
    }
    return match app.exitStatus() {
      Option<i32>.Some { value } => value
      Option<i32>.None => status
    }
  }
}
