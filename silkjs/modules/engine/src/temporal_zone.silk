// Time zone rules for Temporal and Intl, read from a `Zone` of `silk.time.zone`. The engine
// keeps the zones it has loaded (temporal_zones); these functions keep the second-based
// shapes that the Temporal objects use.
import silk.num.i32
import silk.num.i64
import silk.core.option { Option }
import silk.time.instant { Instant }
import silk.time.plain_date_time { PlainDateTime }
import silk.time.zone { Zone }

pub const NO_TRANSITION: i64 = -9223372036854775807 - 1

// Disambiguation of a local time, as the Temporal option table numbers it.
pub const EARLIER: i32 = 0
pub const LATER: i32 = 1
pub const COMPATIBLE: i32 = 2
pub const REJECT: i32 = 3

// An instant for a second count of any size: one outside the range of `Instant` reads as the
// nearest end of the range, where no zone changes its offset.
fn at(sec: i64, nsec: i64) -> Instant {
  if let Option<Instant>.Some { value } = Instant.checkedMake(sec, nsec) { return value }
  if sec < 0 { return Instant.min() }
  return Instant.max()
}
fn seconds(found: Option<Instant>) -> i64 {
  if let Option<Instant>.Some { value } = found { return value.unixSeconds() }
  return NO_TRANSITION
}

/// The UTC offset of `zone` in seconds at UTC second `sec`.
pub fn offsetAtSec(zone: &Zone, sec: i64) -> i32 { return zone.offsetAt(at(sec, 0)).totalSeconds() }

/// Whether `zone` is on its summer time at UTC second `sec`, for the choice between a standard
/// and a daylight name.
///
/// The time zone database flags the winter of a zone with negative daylight saving time
/// (`Europe/Dublin`, `Africa/Casablanca`), and ICU and CLDR name the other part of the year the
/// daylight one. So a flagged time with a smaller offset than an unflagged time next to it is
/// standard time, and an unflagged time between two such times is daylight time.
pub fn isDaylightAtSec(zone: &Zone, sec: i64) -> bool {
  let flag = zone.isDaylightAt(at(sec, 0))
  let offset = offsetAtSec(zone, sec)
  let previous = seconds(zone.previousTransition(at(sec, 1)))
  let next = seconds(zone.nextTransition(at(sec, 0)))
  // A side counts only if the flag holds from the change of offset on that side up to `sec`:
  // otherwise the time next to this one has the same offset.
  let before = previous != NO_TRANSITION && zone.isDaylightAt(at(previous, 0)) == flag
  let after = next != NO_TRANSITION && zone.isDaylightAt(at(next - 1, 0)) == flag
  if flag {
    if before && !zone.isDaylightAt(at(previous - 1, 0)) && offset < offsetAtSec(zone, previous - 1) { return false }
    if after && !zone.isDaylightAt(at(next, 0)) && offset < offsetAtSec(zone, next) { return false }
    return true
  }
  if !before || !after { return false }
  return zone.isDaylightAt(at(previous - 1, 0)) && offsetAtSec(zone, previous - 1) < offset && zone.isDaylightAt(at(next, 0)) && offsetAtSec(zone, next) < offset
}

/// Whether `zone` leaves daylight saving time within `range` seconds before UTC second `sec`,
/// or enters it within `range` seconds after, as ICU checks before it uses a standard name.
pub fn daylightNear(zone: &Zone, sec: i64, range: i64) -> bool {
  let previous = seconds(zone.previousTransition(at(sec, 1)))
  if previous != NO_TRANSITION && sec - previous < range && isDaylightAtSec(zone, previous - 1) { return true }
  let next = seconds(zone.nextTransition(at(sec, 0)))
  if next != NO_TRANSITION && next - sec < range && isDaylightAtSec(zone, next) { return true }
  return false
}

/// The offset of `zone` before its last change of offset at or before UTC second `sec`, or the
/// offset at `sec` if it did not change before.
pub fn prevOffsetAtSec(zone: &Zone, sec: i64) -> i32 {
  let previous = seconds(zone.previousTransition(at(sec, 1)))
  if previous == NO_TRANSITION { return offsetAtSec(zone, sec) }
  return offsetAtSec(zone, previous - 1)
}

/// The first UTC second after `sec` at which the offset of `zone` changes, or `NO_TRANSITION`.
pub fn nextTransitionSec(zone: &Zone, sec: i64) -> i64 { return seconds(zone.nextTransition(at(sec, 0))) }

/// The first change of offset after the instant `sec` and `nsec`, or `NO_TRANSITION`. A
/// negative `nsec` names an instant before `sec`, so a change at `sec` itself counts.
pub fn nextTransitionAt(zone: &Zone, sec: i64, nsec: i32) -> i64 {
  if nsec < 0 { return seconds(zone.nextTransition(at(sec - 1, 0))) }
  return seconds(zone.nextTransition(at(sec, 0)))
}

/// The last change of offset before the instant `sec` and `nsec`, or `NO_TRANSITION`.
pub fn prevTransitionAt(zone: &Zone, sec: i64, nsec: i32) -> i64 {
  if nsec > 0 { return seconds(zone.previousTransition(at(sec, 1))) }
  return seconds(zone.previousTransition(at(sec, 0)))
}

/// The UTC second and offset for the local second count `local`, in `outUtc` and `outOffset`.
/// Returns -1, with both left as they were, if `dis` is `REJECT` and the local time names no
/// instant or two.
pub fn localToUtc(zone: &Zone, local: i64, dis: i32, outUtc: &mut i64, outOffset: &mut i32) -> i32 {
  if let Option<PlainDateTime>.Some { value: reading } = PlainDateTime.fromEpochSeconds(local, 0) {
    let found = zone.candidates(reading)
    if found.count == 1 || (found.count >= 2 && dis != REJECT) {
      let mut utc = found.earlier.unixSeconds()
      if found.count >= 2 && dis == LATER { utc = found.later.unixSeconds() }
      outUtc.* = utc
      outOffset.* = i64.toI32(local - utc)
      return 0
    }
    if found.count >= 2 { return -1 }
    if found.skipped {
      if dis == REJECT { return -1 }
      // Read with the offset after the change, the time is before it; with the one before, after.
      let mut offset = found.before.totalSeconds()
      if dis == EARLIER { offset = found.after.totalSeconds() }
      outUtc.* = local - i32.toI64(offset)
      outOffset.* = offset
      return 0
    }
  }
  // Outside the range of dates, no zone changes its offset.
  let offset = offsetAtSec(zone, local)
  outUtc.* = local - i32.toI64(offset)
  outOffset.* = offset
  return 0
}

/// The UTC second at which the day that starts at local second count `local` begins in `zone`:
/// midnight, or the instant of the change on a day when clocks go forward over midnight.
pub fn startOfDaySec(zone: &Zone, local: i64) -> i64 {
  if let Option<PlainDateTime>.Some { value: reading } = PlainDateTime.fromEpochSeconds(local, 0) {
    let found = zone.candidates(reading)
    if found.count > 0 { return found.earlier.unixSeconds() }
    if found.skipped { return found.transition.unixSeconds() }
  }
  return local - i32.toI64(offsetAtSec(zone, local))
}
