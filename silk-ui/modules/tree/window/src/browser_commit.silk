//! Compact little-endian binary serializer for browser compositor `LayerCommit` metadata.
//!
//! Portable across native tests and `wasm32-unknown-unknown` so the Worker Group thread can
//! stream scene scroll ranges, blocked non-passive wheel regions, declarative prevent flags,
//! and retained layer descriptors over `postMessage` (Transferable `ArrayBuffer`) with zero
//! `SharedArrayBuffer` requirement.
import ui_scene.scene { Scene }
import window.types { WindowId }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

pub const BROWSER_COMMIT_VERSION: u32 = 1

/// Declarative browser-level event prevention bits exported to the main-thread shim.
pub const PREVENT_WHEEL_BIT: u32 = 1
pub const PREVENT_TOUCH_BIT: u32 = 2
pub const PREVENT_KEYS_BIT: u32 = 4

/// Decoded fixed header of a serialized browser `LayerCommit` payload (40 bytes).
pub struct BrowserCommitHeader {
  pub version: u32,
  pub windowId: u32,
  pub commitEpoch: u64,
  pub consumedInputSeq: u64,
  pub viewportWidth: u32,
  pub viewportHeight: u32,
  pub deviceScale: f32,
  pub preventFlags: u32,
}

impl Copy for BrowserCommitHeader {}

effect fn writeU32(out: &mut Bytes, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let buf: [u8; 4] = [
    u32.toU8(u32.bitAnd(value, 255)),
    u32.toU8(u32.bitAnd(u32.shiftRight(value, 8), 255)),
    u32.toU8(u32.bitAnd(u32.shiftRight(value, 16), 255)),
    u32.toU8(u32.bitAnd(u32.shiftRight(value, 24), 255)),
  ]
  run out.append(&buf)
}

effect fn writeU64(out: &mut Bytes, value: u64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run writeU32(&mut out, u64.toU32(u64.bitAnd(value, 4294967295)))
  run writeU32(&mut out, u64.toU32(u64.shiftRight(value, 32)))
}

effect fn writeF32(out: &mut Bytes, value: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run writeU32(&mut out, f32.toBits(value))
}

fn readU32(bytes: &[u8], at: &mut usize) -> u32 {
  let i = at.*
  at.* = i + 4
  return u32.bitOr(
    u32.bitOr(u8.toU32(bytes[i]), u32.shiftLeft(u8.toU32(bytes[i + 1]), 8)),
    u32.bitOr(
      u32.shiftLeft(u8.toU32(bytes[i + 2]), 16),
      u32.shiftLeft(u8.toU32(bytes[i + 3]), 24),
    ),
  )
}

fn readU64(bytes: &[u8], at: &mut usize) -> u64 {
  let lo = u32.toU64(readU32(bytes, &mut at))
  let hi = u32.toU64(readU32(bytes, &mut at))
  return u64.bitOr(lo, u64.shiftLeft(hi, 32))
}

fn readF32(bytes: &[u8], at: &mut usize) -> f32 {
  return f32.fromBits(readU32(bytes, &mut at))
}

/// Serializes compositor metadata for `windowId` and `scene` into little-endian bytes.
pub effect fn encodeBrowserCommit(
  windowId: WindowId,
  commitEpoch: u64,
  consumedInputSeq: u64,
  viewportWidth: u32,
  viewportHeight: u32,
  deviceScale: f32,
  preventFlags: u32,
  scene: &Scene,
  blocked: &[Rect<f32>],
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  run writeU32(&mut out, BROWSER_COMMIT_VERSION)
  run writeU32(&mut out, windowId.value)
  run writeU64(&mut out, commitEpoch)
  run writeU64(&mut out, consumedInputSeq)
  run writeU32(&mut out, viewportWidth)
  run writeU32(&mut out, viewportHeight)
  run writeF32(&mut out, deviceScale)
  run writeU32(&mut out, preventFlags)

  let scrolls = scene.scrolls()
  run writeU32(&mut out, usize.toU32(scrolls.length))
  let mut si: usize = 0
  while si < scrolls.length {
    let sp = scrolls[si]
    run writeU32(&mut out, sp.node)
    run writeF32(&mut out, sp.x)
    run writeF32(&mut out, sp.y)
    run writeF32(&mut out, sp.minX)
    run writeF32(&mut out, sp.maxX)
    run writeF32(&mut out, sp.minY)
    run writeF32(&mut out, sp.maxY)
    si = si + 1
  }

  run writeU32(&mut out, usize.toU32(blocked.length))
  let mut bi: usize = 0
  while bi < blocked.length {
    let r = blocked[bi]
    run writeF32(&mut out, r.xMin)
    run writeF32(&mut out, r.yMin)
    run writeF32(&mut out, r.xMax)
    run writeF32(&mut out, r.yMax)
    bi = bi + 1
  }

  if scene.layerCount() == 0 {
    run writeU32(&mut out, 0)
    return move out
  }
  let topLayers = scene.layers(0)
  let mut taggedCount: u32 = 0
  let mut ti: usize = 0
  while ti < topLayers.length {
    if topLayers[ti].id != 0 {
      taggedCount = taggedCount + 1
    }
    ti = ti + 1
  }
  run writeU32(&mut out, taggedCount)
  let mut li: usize = 0
  while li < topLayers.length {
    let layer = topLayers[li]
    if layer.id != 0 {
      run writeU32(&mut out, layer.id)
      run writeF32(&mut out, layer.bounds.xMin)
      run writeF32(&mut out, layer.bounds.yMin)
      run writeF32(&mut out, layer.bounds.xMax)
      run writeF32(&mut out, layer.bounds.yMax)
      run writeU32(&mut out, 0)
      run writeF32(&mut out, layer.isolation.opacity)
    }
    li = li + 1
  }
  return move out
}

/// Decodes the 40-byte fixed header from serialized browser commit bytes.
pub fn decodeBrowserCommitHeader(bytes: &[u8]) -> Option<BrowserCommitHeader> {
  if bytes.length < 40 {
    return Option<BrowserCommitHeader>.None
  }
  let mut at: usize = 0
  let version = readU32(bytes, &mut at)
  if version != BROWSER_COMMIT_VERSION {
    return Option<BrowserCommitHeader>.None
  }
  let windowId = readU32(bytes, &mut at)
  let commitEpoch = readU64(bytes, &mut at)
  let consumedInputSeq = readU64(bytes, &mut at)
  let viewportWidth = readU32(bytes, &mut at)
  let viewportHeight = readU32(bytes, &mut at)
  let deviceScale = readF32(bytes, &mut at)
  let preventFlags = readU32(bytes, &mut at)
  return Option<BrowserCommitHeader>.some(
    BrowserCommitHeader {
      version: version,
      windowId: windowId,
      commitEpoch: commitEpoch,
      consumedInputSeq: consumedInputSeq,
      viewportWidth: viewportWidth,
      viewportHeight: viewportHeight,
      deviceScale: deviceScale,
      preventFlags: preventFlags,
    },
  )
}
