//! Rows that match through `+`, `~`, an index or `:has()` still hold the right styles when
//! equal rows take each other's match, and keep them through inserts, removals and changes.
import ui_tree.legacy { Mutation, UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, StyleState }
import font_collection.lib { FontCollection }
import svg_css.compile { Options, CompileError }
import svg_css.compile
import svg_css.tokens { CssError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.frozen { Frozen }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.num.u32

fn frame(time: f64) -> FrameInput { return FrameInput { width: 800.0, height: 300.0, scale: 1.0, time: time } }

fn wide(tree: &UiTree<'_>, id: u32) -> bool { return tree.node(tree.slotOf(id)).computed().layout.width.value == 25.0 }

/// Whether one took the other's matched style without matching selectors itself.
fn shared(tree: &UiTree<'_>, first: u32, second: u32) -> bool {
  let one = tree.node(tree.slotOf(first)).styleClass
  return one != 0 && one == tree.node(tree.slotOf(second)).styleClass
}

effect fn box(batch: &mut Batch, id: u32, parent: u32, before: u32, classes: string) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run batch.create(id, NodeKind.Box)
  run batch.attribute(id, Attribute.ClassName { value: run String.copy(classes) })
  if before == 0 { run batch.append(parent, id) } else { run batch.insertBefore(parent, id, before) }
}

/// A stack (1) of `rows` rows, 10, 20 and on, each of `cells` cells, 11, 12 and on under 10.
/// Rows and cells are 20px wide, and `rule` makes what it selects 25px wide.
effect fn stack(tree: &mut UiTree<'_>, rows: u32, cells: u32, rule: &[u8]) -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("stack") })
  let mut row: u32 = 1
  while row <= rows {
    run box(&mut batch, row * 10, 1, 0, "row")
    let mut cell: u32 = 1
    while cell <= cells {
      run box(&mut batch, row * 10 + cell, row * 10, 0, "cell")
      cell = cell + 1
    }
    row = row + 1
  }
  let mut source = List<u8>.make()
  run source.appendSlice(b".row{width:20px;height:5px}.cell{width:20px;height:1px}")
  run source.appendSlice(rule)
  run source.appendSlice(b"{width:25px}")
  let sheet = run compile.compile(source.asSlice(), &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(0.0))
}

/// Whether the nodes `ids` are 25px wide exactly where `pattern` has a `1`.
fn widths(tree: &UiTree<'_>, ids: &[u32], pattern: &[u8]) -> bool {
  let mut i: usize = 0
  while i < ids.length {
    if wide(tree, ids[i]) != (pattern[i] == 49) { return false }
    i = i + 1
  }
  return true
}

effect fn change(tree: &mut UiTree<'_>, id: u32, classes: string, time: f64) -> ()
  ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.attribute(id, Attribute.ClassName { value: run String.copy(classes) })
  run tree.apply(run batch.take())
  run tree.frame(frame(time))
}

effect fn add(tree: &mut UiTree<'_>, id: u32, parent: u32, before: u32, classes: string, time: f64) -> ()
  ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run box(&mut batch, id, parent, before, classes)
  run tree.apply(run batch.take())
  run tree.frame(frame(time))
}

effect fn remove(tree: &mut UiTree<'_>, id: u32, time: f64) -> ()
  ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.push(Mutation.Destroy { id: id })
  run tree.apply(run batch.take())
  run tree.frame(frame(time))
}

const ROWS: [u32; 8] = [10, 20, 30, 40, 50, 60, 70, 80]

effect fn siblingRules() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut owl = run UiTree.make(&fonts)
  run stack(&mut owl, 8, 0, b".row+.row")
  run Testing.expect(widths(&owl, &ROWS, b"01111111"), "every row after the first follows a row")
  run Testing.expect(!shared(&owl, 10, 20) && shared(&owl, 20, 30) && shared(&owl, 70, 80), "rows with two rows before them take the match of the one before")
  run add(&mut owl, 90, 1, 10, "row", 1.0)
  run Testing.expect(!wide(&owl, 90) && widths(&owl, &ROWS, b"11111111") && shared(&owl, 70, 80), "a row put first makes the old first row a follower")
  run remove(&mut owl, 90, 2.0)
  run Testing.expect(widths(&owl, &ROWS, b"01111111"), "and its removal makes it the first again")
  run change(&mut owl, 40, "gap", 3.0)
  run Testing.expect(widths(&owl, &ROWS, b"01100111") && !shared(&owl, 50, 60) && shared(&owl, 60, 70), "a row after another kind of sibling matches for itself")

  let mut later = run UiTree.make(&fonts)
  run stack(&mut later, 8, 0, b".on~.row")
  run Testing.expect(widths(&later, &ROWS, b"00000000") && shared(&later, 60, 70), "no row follows a marked one")
  run change(&mut later, 30, "row on", 1.0)
  run Testing.expect(widths(&later, &ROWS, b"00011111") && shared(&later, 60, 70) && !shared(&later, 30, 40), "every row after the marked one follows it")
  run change(&mut later, 30, "row", 2.0)
  run Testing.expect(widths(&later, &ROWS, b"00000000") && shared(&later, 30, 40), "and none once the mark is gone")

  let mut first = run UiTree.make(&fonts)
  run stack(&mut first, 8, 0, b".row:first-child+.row")
  run Testing.expect(widths(&first, &ROWS, b"01000000") && !shared(&first, 20, 30) && shared(&first, 40, 50), "a step that tests the first child sets the second row apart")
}

test effect fn rowsShareMatchesThatReadSiblings() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run siblingRules() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn indexRules() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut zebra = run UiTree.make(&fonts)
  run stack(&mut zebra, 8, 0, b".row:nth-child(even)")
  run Testing.expect(widths(&zebra, &ROWS, b"01010101"), "even rows")
  run Testing.expect(shared(&zebra, 10, 30) && shared(&zebra, 20, 40) && shared(&zebra, 60, 80) && !shared(&zebra, 10, 20), "a row takes the match of the row two before it")
  run add(&mut zebra, 90, 1, 10, "row", 1.0)
  run Testing.expect(!wide(&zebra, 90) && widths(&zebra, &ROWS, b"10101010"), "a row put first shifts every index")
  run remove(&mut zebra, 90, 2.0)
  run Testing.expect(widths(&zebra, &ROWS, b"01010101"), "and its removal shifts them back")
  run change(&mut zebra, 50, "row other", 3.0)
  run Testing.expect(widths(&zebra, &ROWS, b"01010101"), "another kind of row keeps its place in the count")

  let mut third = run UiTree.make(&fonts)
  run stack(&mut third, 8, 0, b".row:nth-child(3n+1)")
  run Testing.expect(widths(&third, &ROWS, b"10010010") && shared(&third, 20, 50) && shared(&third, 30, 60) && !shared(&third, 10, 40), "a period of three, past its lead")

  let mut some = run UiTree.make(&fonts)
  run stack(&mut some, 8, 0, b".row:nth-child(-n+3)")
  run Testing.expect(widths(&some, &ROWS, b"11100000") && !shared(&some, 30, 40) && shared(&some, 40, 50), "the first three, then one match for the rest")

  let mut ending = run UiTree.make(&fonts)
  run stack(&mut ending, 8, 0, b".row:nth-last-child(2)")
  run Testing.expect(widths(&ending, &ROWS, b"00000010") && shared(&ending, 10, 20) && shared(&ending, 50, 60) && !shared(&ending, 60, 70), "rows share up to the tail an index from the end reads")
  run add(&mut ending, 90, 1, 0, "row", 1.0)
  run Testing.expect(widths(&ending, &ROWS, b"00000001") && !wide(&ending, 90) && shared(&ending, 60, 70), "a row put last moves the tail")

  let mut back = run UiTree.make(&fonts)
  run stack(&mut back, 8, 0, b".row:nth-last-child(2n)")
  run Testing.expect(widths(&back, &ROWS, b"10101010") && shared(&back, 10, 30), "a period counted from the end")
  run add(&mut back, 90, 1, 0, "row", 1.0)
  run Testing.expect(widths(&back, &ROWS, b"01010101") && !wide(&back, 90), "a row put last flips it")

  let mut typed = run UiTree.make(&fonts)
  run stack(&mut typed, 8, 0, b".row:first-of-type,.row:last-of-type")
  run Testing.expect(widths(&typed, &ROWS, b"10000001") && shared(&typed, 30, 40) && !shared(&typed, 10, 20) && !shared(&typed, 70, 80), "the first and last of a type stand apart")

  let mut listed = run UiTree.make(&fonts)
  run stack(&mut listed, 8, 0, b".row:nth-child(2 of .row)")
  run Testing.expect(widths(&listed, &ROWS, b"01000000") && !shared(&listed, 40, 50), "an index over a selector list is matched for each row")

  let mut both = run UiTree.make(&fonts)
  run stack(&mut both, 8, 0, b".row:nth-child(4n+1)+.row")
  run Testing.expect(widths(&both, &ROWS, b"01000100"), "a step onto an indexed row")
  run add(&mut both, 90, 1, 10, "row", 1.0)
  run Testing.expect(wide(&both, 10) && widths(&both, &ROWS, b"10001000"), "shifts with the index")

  let mut long = run UiTree.make(&fonts)
  run stack(&mut long, 24, 0, b".row:nth-child(4n+1)+.row")
  let mut row: u32 = 1
  let mut right = true
  while row <= 24 {
    if wide(&long, row * 10) != (row % 4 == 2) { right = false }
    row = row + 1
  }
  run Testing.expect(right && shared(&long, 110, 150) && shared(&long, 140, 220) && !shared(&long, 140, 150), "a long run shares by the period, each row with the one four before")
}

test effect fn rowsShareMatchesThatReadIndexes() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run indexRules() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn descendantRules() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut other = run UiTree.make(&fonts)
  run stack(&mut other, 8, 0, b".card:has(.x),.card+.card,.card:nth-child(2)")
  run Testing.expect(shared(&other, 10, 20) && shared(&other, 70, 80), "rows that no such rule tests share as if the sheet had none")

  let mut has = run UiTree.make(&fonts)
  run stack(&mut has, 8, 0, b".row:has(.x)")
  run add(&mut has, 41, 40, 0, "x", 1.0)
  run Testing.expect(widths(&has, &ROWS, b"00010000") && !shared(&has, 50, 60), "a row that tests its descendants matches for itself")
  run add(&mut has, 61, 60, 0, "x", 2.0)
  run remove(&mut has, 41, 3.0)
  run Testing.expect(widths(&has, &ROWS, b"00000100"), "and follows them")
}

test effect fn rowsThatReadDescendantsMatchForThemselves() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run descendantRules() |> Effect.provideMut<Allocator>(&mut allocator)
}

const CELLS: [u32; 12] = [11, 12, 13, 21, 22, 23, 31, 32, 33, 41, 42, 43]

effect fn cousinRules() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut owl = run UiTree.make(&fonts)
  run stack(&mut owl, 4, 3, b".cell+.cell")
  run Testing.expect(widths(&owl, &CELLS, b"011011011011") && shared(&owl, 11, 21) && shared(&owl, 12, 32) && shared(&owl, 13, 43), "cells take the match of the cell in their place in the row before")
  run add(&mut owl, 29, 20, 21, "cell", 1.0)
  run change(&mut owl, 31, "cell on", 2.0)
  run change(&mut owl, 31, "cell", 3.0)
  run change(&mut owl, 32, "cell on", 4.0)
  run change(&mut owl, 32, "cell", 5.0)
  run Testing.expect(!wide(&owl, 29) && widths(&owl, &CELLS, b"011111011011"), "a cell put first in one row leaves the other rows' cells in their places")

  let mut second = run UiTree.make(&fonts)
  run stack(&mut second, 4, 3, b".cell:nth-child(2)")
  run Testing.expect(widths(&second, &CELLS, b"010010010010") && shared(&second, 12, 22) && shared(&second, 13, 33), "indexed cells too")
  run add(&mut second, 29, 20, 21, "cell", 1.0)
  run change(&mut second, 32, "cell on", 2.0)
  run change(&mut second, 32, "cell", 3.0)
  run change(&mut second, 33, "cell on", 4.0)
  run change(&mut second, 33, "cell", 5.0)
  run change(&mut second, 42, "cell on", 6.0)
  run change(&mut second, 42, "cell", 7.0)
  run Testing.expect(!wide(&second, 29) && widths(&second, &CELLS, b"010100010010"), "a cell is compared with the cell at its own index")

  let mut ending = run UiTree.make(&fonts)
  run stack(&mut ending, 4, 3, b".cell:nth-last-child(2)")
  run add(&mut ending, 39, 30, 0, "cell", 1.0)
  run change(&mut ending, 42, "cell on", 2.0)
  run change(&mut ending, 42, "cell", 3.0)
  run Testing.expect(wide(&ending, 33) && !wide(&ending, 39) && widths(&ending, &CELLS, b"010010001010"), "and with the cells after it where an index counts from the end")

  let mut above = run UiTree.make(&fonts)
  run stack(&mut above, 4, 3, b".row:nth-child(even) .cell")
  run Testing.expect(widths(&above, &CELLS, b"000111000111") && shared(&above, 10, 20), "a rule that tests the row's index is matched for the cells of each row")

  let mut after = run UiTree.make(&fonts)
  run stack(&mut after, 4, 3, b".row+.row .cell")
  run Testing.expect(widths(&after, &CELLS, b"000111111111"), "or the row's siblings")

  let mut holds = run UiTree.make(&fonts)
  run stack(&mut holds, 4, 3, b".row:has(.on) .cell")
  run change(&mut holds, 32, "cell on", 1.0)
  run Testing.expect(widths(&holds, &CELLS, b"000000111000"), "or its descendants")
}

test effect fn cellsShareMatchesAcrossRows() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cousinRules() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn startingSubjects() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let mut id: u32 = 2
  while id <= 65 {
    run box(&mut batch, id, 1, 0, if id == 65 { "row enter:w" } else { "row" })
    id = id + 1
  }
  run box(&mut batch, 66, 1, 0, "custom")
  run batch.customProperty(66, StyleState.Starting, "--w", Option<string>.some("7px"), false)
  let sheet = run compile.compile(b".row{width:25px}.custom{width:var(--w,25px)}.custom,.enter\\:w{transition:width 1s linear}@media(width>600px){@starting-style{.unused,.row + .enter\\:w{width:5px}}}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(0.0))
  run Testing.expect(wide(&tree, 2) && wide(&tree, 64) && tree.node(tree.slotOf(65)).computed().layout.width.value == 5.0, "only the eligible row enters at its starting width")
  run Testing.expect(shared(&tree, 2, 64), "an unrelated starting rule does not prevent equal rows from sharing their match")
  run Testing.expect(tree.node(tree.slotOf(66)).computed().layout.width.value == 7.0, "an inline starting variable still feeds the starting cascade")
  run tree.frame(frame(1.0))
  run Testing.expect(wide(&tree, 65) && wide(&tree, 66), "both entry transitions finish at the normal width")
}

test effect fn startingRulesOnlyIsolateCandidateRows() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run startingSubjects() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Whether the two nodes hold one computed style (see `style_pool`).
fn oneStyle(tree: &UiTree<'_>, first: u32, second: u32) -> bool {
  return Frozen.same(&tree.node(tree.slotOf(first)).styled, &tree.node(tree.slotOf(second)).styled)
}

effect fn pooledStyles() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  run stack(&mut tree, 8, 2, b".wide")
  run Testing.expect(oneStyle(&tree, 10, 20) && oneStyle(&tree, 20, 80), "equal rows hold one computed style")
  run Testing.expect(oneStyle(&tree, 11, 12) && oneStyle(&tree, 11, 82), "and so do equal cells, under any row")
  run Testing.expect(!oneStyle(&tree, 10, 11) && !oneStyle(&tree, 1, 10), "nodes with different values hold their own")
  run Testing.expect(tree.stylePool.length() < 16, "twenty-five nodes hold a handful of styles")
  run change(&mut tree, 40, "row wide", 1.0)
  run Testing.expect(wide(&tree, 40) && !wide(&tree, 30) && !wide(&tree, 50), "a row that changes leaves its twins the style they hold")
  run Testing.expect(!oneStyle(&tree, 40, 30) && oneStyle(&tree, 30, 50) && oneStyle(&tree, 41, 31), "and takes another, its cells keeping theirs")
  run change(&mut tree, 40, "row", 2.0)
  run Testing.expect(!wide(&tree, 40) && oneStyle(&tree, 40, 30), "equal again, it holds the shared one again")
}

test effect fn equalNodesHoldOneComputedStyle() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pooledStyles() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unrelatedAncestorStructuralRules() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  run stack(&mut tree, 8, 2, b".seats-letters > :nth-child(5), .seats-row > :nth-child(5), .other .row + .row, .other .cell:nth-child(even)")
  run Testing.expect(shared(&tree, 10, 20) && shared(&tree, 20, 80), "unrelated multi-arm :nth-child and single-arm sibling rules do not prevent twin sharing")
  run Testing.expect(shared(&tree, 11, 12) && shared(&tree, 11, 82), "cells under shared rows take twins too")
  run Testing.expect(tree.work.sheetTwins > 0 && tree.work.sharedResults > 0, "whole-result lending runs with unrelated structural rules present")
  let before = tree.work.resolves
  run add(&mut tree, 90, 1, 0, "row", 1.0)
  // Only the new row resolves (plus at most the previous last sibling for :last-child); unrelated rows stay clean.
  run Testing.expect(tree.work.resolves - before <= 3, "appending a row does not restyle all unrelated siblings")
}

test effect fn unrelatedAncestorStructuralRulesPreserveSharing() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run unrelatedAncestorStructuralRules() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nonInheritingCustomPropertySkipsSubtree() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run box(&mut batch, 2, 1, 0, "scroller")
  let mut i: u32 = 10
  while i < 20 {
    run box(&mut batch, i, 2, 0, "row")
    i = i + 1
  }
  let sheet = run compile.compile(b"@property --scroll-y{syntax:'*';inherits:false}.scroller{width:200px}.row{width:100px;height:10px}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(0.0))
  let movesBefore = tree.work.scopeMoves
  let resolvesBefore = tree.work.resolves
  let mut update = Batch.make()
  run update.customProperty(2, StyleState.Base, "--scroll-y", Option<string>.some("42px"), false)
  run tree.apply(run update.take())
  run tree.frame(frame(1.0))
  run Testing.expect(tree.work.scopeMoves == movesBefore, "updating a non-inheriting custom property does not move descendant scopes")
  run Testing.expect(tree.work.resolves - resolvesBefore == 1, "only the scroller itself resolves")
}

test effect fn nonInheritingCustomPropertyDoesNotWalkDescendants() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nonInheritingCustomPropertySkipsSubtree() |> Effect.provideMut<Allocator>(&mut allocator)
}
