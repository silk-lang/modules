/// Whether the fixture looks the same with the target styled `first` as with `second`.
effect fn sameLook(first: &'static [u8], second: &'static [u8]) -> bool
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut one = run Tree.make(&fonts)
  let f1 = run fixture(&mut one, Row { root: b"", lead: b"", setup: first, sample: b"" })
  drop run one.frame(viewport(), 0.0)
  let mut paint1 = List<u64>.make()
  let look1 = run look(&one, f1, &mut paint1)
  let mut two = run Tree.make(&fonts)
  let f2 = run fixture(&mut two, Row { root: b"", lead: b"", setup: second, sample: b"" })
  drop run two.frame(viewport(), 0.0)
  let mut paint2 = List<u64>.make()
  let look2 = run look(&two, f2, &mut paint2)
  return sameFloats(&look1, &look2) && sameHashes(&paint1, &paint2)
}

/// Sizes compare a length with a percentage of the 400px root.
effect fn sizesWithPercentages() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run Testing.expect(run sameLook(b"width: min(50%, 120px)", b"width: 120px"), "min() takes the length when it is smaller")
  run Testing.expect(run sameLook(b"width: min(50%, 300px)", b"width: 200px"), "min() takes the percentage when it is smaller")
  run Testing.expect(run sameLook(b"width: max(25%, 3em, 40px)", b"width: 100px"), "max() takes the larger of them")
  run Testing.expect(run sameLook(b"width: 300px; max-width: min(50%, 250px)", b"width: 200px"), "a maximum compares them too")
  run Testing.expect(run sameLook(b"width: 10px; min-width: max(25%, 40px)", b"width: 100px"), "and a minimum")
  run Testing.expect(run sameLook(b"display: flex; flex-basis: min(50%, 120px); height: min(10%, 100px)", b"display: flex; flex-basis: 120px; height: 30px"), "flex-basis and height")
  run Testing.expect(run sameLook(b"width: min(100% - 20px, 600px)", b"width: 380px"), "min() takes a percentage with a length")
  run Testing.expect(run sameLook(b"width: max(50% + 10px, 100px)", b"width: 210px"), "and so does max()")
  run Testing.expect(run sameLook(b"width: clamp(50px, 50%, 90px)", b"width: 90px"), "clamp() holds a percentage under its maximum")
  run Testing.expect(run sameLook(b"width: clamp(250px, 50%, 300px)", b"width: 250px"), "and over its minimum")
  run Testing.expect(run sameLook(b"width: max(50px, min(50%, 90px))", b"width: 90px"), "max() of min() is a clamp")
  run Testing.expect(run sameLook(b"width: clamp(50px, 50% + 10px, 250px)", b"width: 210px"), "clamp() holds a length plus a percentage")
  run Testing.expect(run sameLook(b"width: calc(min(100%, 300px) - 2em)", b"width: 268px"), "a sum moves the bound of a min()")
  run Testing.expect(run sameLook(b"padding-left: max(10%, 30px)", b"padding-left: 40px"), "padding compares them too")
  run Testing.expect(run sameLook(b"margin-left: clamp(10px, 5%, 15px); padding-right: clamp(10px, 5%, 30px)", b"margin-left: 15px; padding-right: 20px"), "and margins, each with its own bounds")
  run Testing.expect(run sameLook(b"display: flex; column-gap: min(5%, 30px)", b"display: flex; column-gap: 20px"), "and gaps")
  run Testing.expect(run sameLook(b"position: relative; left: max(1em, 10% - 20px)", b"position: relative; left: 20px"), "and insets")
  run Testing.expect(run sameLook(b"width: round(up, 6.3em, 10px)", b"width: 110px"), "round() steps a font length")
  run Testing.expect(run sameLook(b"padding-left: min(10%, 5% + 20px)", b""), "two values that both need the basis are dropped")
}

test effect fn cssCoverageSizesWithPercentages() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sizesWithPercentages() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// `font` and `text-decoration` set their longhands, and reset the ones they leave out.
effect fn fontShorthands() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let whole = run sameLook(
    b"font: italic bold 24px/40px Noto Sans, sans-serif",
    b"font-style: italic; font-weight: bold; font-size: 24px; line-height: 40px; font-family: Noto Sans, sans-serif",
  )
  run Testing.expect(whole, "font sets its longhands")
  let reset = run sameLook(
    b"font-weight: bold; line-height: 50px; font: 24px sans-serif",
    b"font-size: 24px; font-family: sans-serif",
  )
  run Testing.expect(reset, "font resets the longhands it leaves out")
  let dropped = run sameLook(b"font: bold", b"")
  run Testing.expect(dropped, "font without a size is dropped")
  let decoration = run sameLook(
    b"text-decoration: red underline wavy",
    b"text-decoration-line: underline; text-decoration-style: wavy; text-decoration-color: red",
  )
  run Testing.expect(decoration, "text-decoration sets its longhands")
}

/// The width of "1111" in Noto Sans, styled `style`.
effect fn digitsWidth(style: &[u8]) -> f32
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let sans = run tree.fontFamily("Noto Sans, sans-serif")
  let root = run tree.box(&[css.fontFamily(sans.raw())])
  run restyle(&mut tree, root, style)
  let text = run tree.text("1111")
  run tree.append(root, text)
  run tree.setRoot(root)
  drop run tree.frame(viewport(), 0.0)
  let fragments = run tree.fragments(text)
  let box = fragments.get(0).border
  return box.xMax - box.xMin
}

/// Font features reach the shaper: Noto Sans digits are tabular unless `pnum` is on.
effect fn fontFeatures() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let tabular = run digitsWidth(b"display: inline-block")
  let proportional = run digitsWidth(b"display: inline-block; font-variant-numeric: proportional-nums")
  run Testing.expect(proportional < tabular, "proportional-nums narrows the ones")
  let settings = run digitsWidth(b"display: inline-block; font-feature-settings: \"pnum\" on")
  run Testing.expect(settings == proportional, "font-feature-settings turns pnum on")
  let off = run digitsWidth(b"display: inline-block; font-variant-numeric: proportional-nums; font-feature-settings: \"pnum\" 0")
  run Testing.expect(off == tabular, "font-feature-settings wins over font-variant")
  let reset = run digitsWidth(b"display: inline-block; font-variant-numeric: proportional-nums; font: 16px Noto Sans")
  run Testing.expect(reset == tabular, "font resets font-variant")
}

/// How tall "super·cali·fragilistic" (with soft hyphens) is in a 60px wide box styled `style`.
effect fn hyphenatedHeight(style: &[u8]) -> f32
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let sans = run tree.fontFamily("Noto Sans, sans-serif")
  let root = run tree.box(&[css.fontFamily(sans.raw())])
  run restyle(&mut tree, root, b"width: 60px")
  run restyle(&mut tree, root, style)
  let text = run tree.text("super\u{AD}cali\u{AD}fragilistic")
  run tree.append(root, text)
  run tree.setRoot(root)
  drop run tree.frame(viewport(), 0.0)
  let fragments = run tree.fragments(root)
  let box = fragments.get(0).border
  return box.yMax - box.yMin
}

/// Soft hyphens break a word unless `hyphens: none`; `auto` breaks as `manual` does.
effect fn hyphensAtSoftHyphens() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let manual = run hyphenatedHeight(b"hyphens: manual")
  let none = run hyphenatedHeight(b"hyphens: none")
  let auto = run hyphenatedHeight(b"hyphens: auto")
  run Testing.expect(none < manual, "hyphens: none keeps the word on one line")
  run Testing.expect(auto == manual, "hyphens: auto breaks at soft hyphens")
}

test effect fn cssCoverageHyphens() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hyphensAtSoftHyphens() |> Effect.provideMut<Allocator>(&mut allocator)
}

