//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The answers of docs/caniuse/support/css-paint.json.
import caniuse_data { Answer }

pub fn answer(id: string) -> Answer {
  if id == "background-attachment" {
    return Answer { support: "y", note: "`fixed` layers are placed on the viewport and stay put while scroll containers scroll, without painting again; `local` layers scroll with a scroll container's content. Inside a transformed box `fixed` still follows the viewport." }
  }
  if id == "background-img-opts" {
    return Answer { support: "y", note: "" }
  }
  if id == "background-position-x-y" {
    return Answer { support: "y", note: "" }
  }
  if id == "background-repeat-round-space" {
    return Answer { support: "y", note: "" }
  }
  if id == "border-image" {
    return Answer { support: "y", note: "`border-image` and its longhands draw on every renderer: `url()` images, `image-set()` and gradients as the source, nine slices with `fill`, widths in numbers, lengths, percentages or `auto`, `outset`, and `stretch`, `repeat`, `round` and `space`. The image replaces the border style; the border widths still take their space." }
  }
  if id == "border-radius" {
    return Answer { support: "y", note: "" }
  }
  if id == "cross-document-view-transitions" {
    return Answer { support: "x", note: "About animating a navigation from one web page to another. An app does not navigate between documents." }
  }
  if id == "css-animation" {
    return Answer { support: "a", note: "Keyframes and transitions change opacity, the colors, border radii and widths, `box-shadow`, `filter`, `backdrop-filter`, sizes, margins, padding, insets, gaps, `font-size`, `flex-grow` and `flex-shrink`, `visibility`, `display`, the transforms, `perspective` and the `offset-*` motion path. Other properties, `background-position` and `background-image` among them, keep their base value; the build warns about each `@keyframes` that sets one." }
  }
  if id == "css-appearance" {
    return Answer { support: "n", note: "`appearance` is ignored. Silk UI draws its controls itself, so there is no platform look for `appearance: none` to remove." }
  }
  if id == "css-backdrop-filter" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-background-offsets" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-backgroundblendmode" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-boxshadow" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-canvas" {
    return Answer { support: "n", note: "Not supported. `-webkit-canvas()` was a WebKit-only extension that never became a standard." }
  }
  if id == "css-caret-color" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-clip-path" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-color-adjust" {
    return Answer { support: "x", note: "About printing. An app window always draws the colors it is given." }
  }
  if id == "css-conic-gradients" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-crisp-edges" {
    return Answer { support: "y", note: "`pixelated` and `crisp-edges` scale images, `url()` backgrounds and mask images by the nearest pixel." }
  }
  if id == "css-cross-fade" {
    return Answer { support: "y", note: "`cross-fade()` and `-webkit-cross-fade()` add their images by weight (plus-lighter in an isolated layer) wherever an image goes: backgrounds, masks, `border-image`. A missing percentage shares what the others leave. A `<color>` in place of an image is not read." }
  }
  if id == "css-element-function" {
    return Answer { support: "n", note: "`element()` is not supported." }
  }
  if id == "css-filter-function" {
    return Answer { support: "y", note: "`filter(<image>, <filters>)` works wherever an image goes. A loaded bitmap is filtered once, in its own pixels, and the result is kept with it; gradients and SVG images draw through filter layers." }
  }
  if id == "css-filters" {
    return Answer { support: "y", note: "`filter` animates and transitions. Lists ease function by function when one is `none` or one starts with the other's functions; other pairs, lists with `url()` and lists of more than 6 functions switch halfway or keep their value." }
  }
  if id == "css-gradients" {
    return Answer { support: "y", note: "Linear and radial gradients with any number of stops, hard edges and repeating runs. Stops mix in the gradient's `in <space> [<hue> hue]` (Oklab, Oklch, Lab, LCH, HSL, HWB, linear sRGB, Display P3 and the other CSS Color 4 spaces), or by default in sRGB for legacy colors and Oklab when any stop is a modern color, and clip to sRGB as Chromium does. Interpolation hints (a bare percentage between stops) are ignored." }
  }
  if id == "css-image-orientation" {
    return Answer { support: "a", note: "Photos show upright: a JPEG's EXIF orientation is applied when it is decoded, as `from-image` does. `image-orientation: none` is ignored." }
  }
  if id == "css-image-set" {
    return Answer { support: "a", note: "`image-set()` and `-webkit-image-set()` work wherever an image does, with `url()`, strings and gradients, `x`, `dppx`, `dpi` and `dpcm` resolutions and `type()`. One image is chosen when the style is read, not per display: the densest one up to 2x, else the least dense." }
  }
  if id == "css-masks" {
    return Answer { support: "y", note: "`mask-image` with `url()` images and linear, radial and conic gradients works, with `mask-size`, `mask-position`, `mask-repeat`, `mask-origin`, `mask-clip`, `mask-mode`, `mask-composite` and the `mask` shorthand. `mask-border` and its longhands (with `mask-border-mode: luminance`) cut a nine-slice mask over the border area that multiplies with the mask layers." }
  }
  if id == "css-mixblendmode" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-motion-paths" {
    return Answer { support: "a", note: "`offset-path` with `ray()`, basic shapes, `path()` and a `<coord-box>`, `offset-distance`, `offset-rotate`, `offset-anchor`, `offset-position` and the `offset` shorthand work, and animate. `url()` and `shape()` paths are not followed." }
  }
  if id == "css-opacity" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-paint-api" {
    return Answer { support: "n", note: "There are no paint worklets, so `paint()` draws nothing." }
  }
  if id == "css-reflections" {
    return Answer { support: "n", note: "`-webkit-box-reflect` is ignored." }
  }
  if id == "css-repeating-gradients" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-resize" {
    return Answer { support: "n", note: "`resize` is ignored: a box has no handle to drag it bigger." }
  }
  if id == "css-selection" {
    return Answer { support: "y", note: "Applies to selected document text and to the text of inputs." }
  }
  if id == "css-touch-action" {
    return Answer { support: "a", note: "Decides which finger gestures the tree takes for itself: `auto`, `none`, `pan-x`, `pan-y`, `pan-left`, `pan-right`, `pan-up`, `pan-down`, `pinch-zoom` and `manipulation`, intersected up to the nearest scroll container. A pan cancels the pointers, scrolls under the finger and flicks on release. Pinching does not change page zoom, so `pinch-zoom` only lets the tree take a two-finger gesture, which pans." }
  }
  if id == "css-transitions" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-zoom" {
    return Answer { support: "y", note: "Lengths in the subtree multiply by the effective zoom and lay out again, as in the standardized `zoom`: text is shaped at the zoomed size, images take zoomed natural sizes, and container queries compare CSS pixels. `zoom: inherit` reads as 1. Windows also have page zoom (Ctrl or Cmd with + and -)." }
  }
  if id == "css3-cursors" {
    return Answer { support: "y", note: "Every keyword has its own cursor; where a system has none (zoom on Windows and X11, `cell` and `no-drop` on macOS and Windows) a bundled image shows. `url()` images (PNG, JPEG or SVG) show with their hot spot, the next one in the list when one fails, and the keyword while they load. A `.cur` file's own hot spot is not read." }
  }
  if id == "css3-cursors-grab" {
    return Answer { support: "y", note: "" }
  }
  if id == "css3-cursors-newer" {
    return Answer { support: "y", note: "" }
  }
  if id == "devicepixelratio" {
    return Answer { support: "y", note: "`window.devicePixelRatio` is the window's real scale factor, and it changes when the window moves to another display. The `resolution` media query follows it in stylesheets and `matchMedia`, and so do `-webkit-device-pixel-ratio` and its `-webkit-min-` and `-webkit-max-` forms." }
  }
  if id == "multibackgrounds" {
    return Answer { support: "y", note: "" }
  }
  if id == "object-fit" {
    return Answer { support: "y", note: "" }
  }
  if id == "outline" {
    return Answer { support: "y", note: "" }
  }
  if id == "pointer" {
    return Answer { support: "a", note: "Every pointer event, `pointerover` and `pointerout` included, with `pointerId`, `pointerType` (`mouse` or `touch`, each finger its own pointer), `isPrimary`, `buttons`, `setPointerCapture()`, `releasePointerCapture()`, `hasPointerCapture()`, the capture events and `getCoalescedEvents()`, followed by the compatibility mouse events (`mousedown`, `mousemove`, `mouseup`, `mouseover`, `mouseout`, `mouseenter`, `mouseleave`) in Chrome's order. Pressure, tilt and contact size are the spec defaults (0.5 while pressed, 1 by 1 pixel) because no host reports them yet, pens arrive as a mouse, and `getPredictedEvents()` is empty. Capturing a second finger to another node does not move its events." }
  }
  if id == "pointer-events" {
    return Answer { support: "y", note: "" }
  }
  if id == "transforms2d" {
    return Answer { support: "y", note: "" }
  }
  if id == "transforms3d" {
    return Answer { support: "y", note: "3D transform functions, `perspective`, `perspective-origin`, `backface-visibility` and `transform-style: preserve-3d`: boxes in one 3D rendering context are sorted by depth and split where they cross, as in Chromium." }
  }
  if id == "user-select-none" {
    return Answer { support: "y", note: "`none`, `text`, `all`, `contain` and `-webkit-user-select`, used values as in Chromium. Text is selectable by default: a press, drag, double click (word) or triple click (paragraph) selects it, Shift extends, and Ctrl+C or Cmd+C copies plain text the way Chromium does. Selections follow tree order for now, as Chromium does; reordered layouts (flex `order`, grid placement) come next." }
  }
  if id == "view-transitions" {
    return Answer { support: "n", note: "No `document.startViewTransition()` and no `::view-transition` pseudo-elements. CSS transitions and animations work." }
  }
  if id == "will-change" {
    return Answer { support: "a", note: "Only a hint, so nothing else changes, but as in browsers it makes the box a stacking context when it names a property that would make one (`transform`, `opacity`, `filter`, ...)." }
  }
  return Answer { support: "u", note: "" }
}
