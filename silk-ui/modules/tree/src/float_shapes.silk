//! `shape-outside` and `shape-margin` as css-layout's `FloatShape`: what a float's lines wrap
//! around (CSS Shapes 1 §3).
import paint_css { Effects }
import layout.lib { FloatShape, ShapeKind, ShapeBox, ShapeRadius }
import properties.computed { Dimension, DimensionKind, BoxSizing }
import layout.lib { Style }
import svg_css.dimensions { ExprId }
import svg_css.effect_values { ClipSource, GeometryBox, Shape, RadialSize, Extent, RectangleKind, Corners as ShapeCorners }
import svg_css.transform_values { PositionAxis, Edge }
import silk.geometry.corners { Corners }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.num.f32
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import svg_css.effect_values { Image }
import codec.image { Image as Picture }
import resources { Resources }
import paint_effects

/// The float shape `effects` declares over a border box with horizontal corner radius lengths
/// `radii` (`elliptical` when `effects` holds the vertical radii, else they are the same);
/// none when it declares no shape or one css-layout cannot wrap around (a path). An image
/// shape reads `resources` for a `url()` it has loaded, and samples a gradient over a
/// `content` sized box, the float's content box when known.
pub effect fn of(effects: &Effects, radii: Corners<f32>, elliptical: bool, resources: &Resources<'_>, content: [f32; 2]) -> FloatShape ! OutOfMemoryError ? &mut Allocator {
  let mut shape = FloatShape.make()
  if effects.shape.length() == 0 && effects.shapeImage.length() == 0 { return move shape }
  shape.margin = match effects.shapeMargin {
    Option.Some { value } => dimension(effects, value)
    Option.None => Dimension.px(0.0)
  }
  if effects.shapeImage.length() != 0 {
    let image = &effects.shapeImage.asSlice()[0]
    match &image.* {
      Image.Url { url } => {
        match resources.cssImageNamed(Bytes.asSlice(&url)) {
          Option<&Picture>.Some { value } => run imageRows(value, effects.shapeThreshold, &mut shape.rows)
          Option<&Picture>.None => {}
        }
      }
      _ => run paint_effects.gradientRows(effects, image, content[0], content[1], effects.shapeThreshold, &mut shape.rows)
    }
    // An image not loaded yet, or one with no rows, leaves the float's margin box.
    if shape.rows.length() != 0 { shape.kind = ShapeKind.Image }
    return move shape
  }
  match &effects.shape.asSlice()[0] {
    ClipSource.Box { reference } => {
      shape.kind = ShapeKind.Box
      shape.reference = referenceOf(effects, reference)
      let share = effects.radii
      let lengths = [radii.topLeft, radii.topRight, radii.bottomRight, radii.bottomLeft]
      let shares = [share.topLeft, share.topRight, share.bottomRight, share.bottomLeft]
      let mut i: usize = 0
      while i < 4 {
        run shape.values.append(Dimension.calc(lengths[i], shares[i]))
        i = i + 1
      }
      let downShare = if elliptical { effects.radiiY } else { share }
      let down = if elliptical { effects.lengthsY } else { radii }
      let downLengths = [down.topLeft, down.topRight, down.bottomRight, down.bottomLeft]
      let downShares = [downShare.topLeft, downShare.topRight, downShare.bottomRight, downShare.bottomLeft]
      i = 0
      while i < 4 {
        run shape.values.append(Dimension.calc(downLengths[i], downShares[i]))
        i = i + 1
      }
    }
    ClipSource.Shape { shape: found, reference } => {
      shape.reference = referenceOf(effects, reference)
      match &found {
        Shape.Ellipse { circle, size, position } => {
          shape.kind = if circle { ShapeKind.Circle } else { ShapeKind.Ellipse }
          match size {
            RadialSize.Extent { extent } => {
              let side = if extent == Extent.ClosestSide || extent == Extent.ClosestCorner { ShapeRadius.ClosestSide } else { ShapeRadius.FarthestSide }
              shape.radiusX = side
              shape.radiusY = side
              run shape.values.append(Dimension.px(0.0))
              if !circle { run shape.values.append(Dimension.px(0.0)) }
            }
            RadialSize.Radii { x, y } => {
              run shape.values.append(dimension(effects, x))
              if !circle {
                run shape.values.append(match y {
                  Option.Some { value } => dimension(effects, value)
                  Option.None => dimension(effects, x)
                })
              }
            }
          }
          run shape.values.append(axisOf(effects, position.x))
          run shape.values.append(axisOf(effects, position.y))
        }
        Shape.Rectangle { kind, edges, corners } => {
          shape.kind = ShapeKind.Inset
          run appendInsets(&mut shape.values, effects, kind, edges)
          run appendCorners(&mut shape.values, effects, corners)
        }
        Shape.Polygon { points, .. } => {
          shape.kind = ShapeKind.Polygon
          let list = points.asSlice()
          let mut i: usize = 0
          while i < list.length {
            run shape.values.append(dimension(effects, list[i].x))
            run shape.values.append(dimension(effects, list[i].y))
            i = i + 1
          }
        }
        _ => {
          return FloatShape.make()
        }
      }
    }
    ClipSource.Url { .. } => {}
  }
  return move shape
}

/// The content box size a gradient shape is sampled over: `style`'s definite width and
/// height, or a square when either is not a length.
pub fn contentSize(style: &Style) -> [f32; 2] {
  if style.width.kind != DimensionKind.Length || style.height.kind != DimensionKind.Length { return [100.0, 100.0] }
  let mut w = style.width.value
  let mut h = style.height.value
  if style.boxSizing == BoxSizing.BorderBox {
    w = w - px(style.padding.left) - px(style.padding.right) - px(style.border.left) - px(style.border.right)
    h = h - px(style.padding.top) - px(style.padding.bottom) - px(style.border.top) - px(style.border.bottom)
  }
  return [f32.max(1.0, w), f32.max(1.0, h)]
}
fn px(value: Dimension) -> f32 { return if value.kind == DimensionKind.Length { value.value } else { 0.0 } }

/// The rows of decoded `image`: per band of pixel rows, at most 256 bands, the low and high
/// fraction of its width where some pixel's alpha passes `threshold`.
effect fn imageRows(image: &Picture, threshold: f32, rows: &mut List<f32>) -> () ! OutOfMemoryError ? &mut Allocator {
  let width = image.width()
  let height = image.height()
  if width == 0 || height == 0 { return () }
  let data = image.data()
  // Alpha is the fourth byte of each premultiplied pixel; it passes when above the threshold.
  let cut = f32.toU32(f32.floor(threshold * 255.0))
  let bands = if height > 256 { 256 } else { height }
  run rows.reserve(u32.toUsize(bands) * 2)
  let stride = u32.toUsize(width) * 4
  let mut band: u32 = 0
  while band < bands {
    let from = u64.toUsize(u32.toU64(band) * u32.toU64(height) / u32.toU64(bands))
    let to = u64.toUsize(u32.toU64(band + 1) * u32.toU64(height) / u32.toU64(bands))
    let mut low = u32.toUsize(width)
    let mut high: usize = 0
    let mut y = from
    while y < to {
      let line = y * stride
      let mut x: usize = 0
      while x < low && u8.toU32(data[line + x * 4 + 3]) <= cut { x = x + 1 }
      if x < low { low = x }
      let mut end = u32.toUsize(width)
      while end > high && u8.toU32(data[line + (end - 1) * 4 + 3]) <= cut { end = end - 1 }
      if end > high { high = end }
      y = y + 1
    }
    if high > low {
      run rows.append(usize.toF32(low) / u32.toF32(width))
      run rows.append(usize.toF32(high) / u32.toF32(width))
    } else {
      run rows.append(1.0)
      run rows.append(0.0)
    }
    band = band + 1
  }
}

/// The margin box unless the value names its box (CSS Shapes 1 §3.1).
fn referenceOf(effects: &Effects, reference: GeometryBox) -> ShapeBox {
  if !effects.shapeBox { return ShapeBox.MarginBox }
  return match reference {
    GeometryBox.Content => ShapeBox.ContentBox
    GeometryBox.Padding => ShapeBox.PaddingBox
    GeometryBox.Margin => ShapeBox.MarginBox
    _ => ShapeBox.BorderBox
  }
}

/// A computed length or percentage as a length plus a fraction of its basis.
fn dimension(effects: &Effects, id: ExprId) -> Dimension {
  let length = effects.pixels(id, 0.0)
  return Dimension.calc(length, (effects.pixels(id, 1000.0) - length) / 1000.0)
}

/// A position axis as an offset from the reference box's left or top edge.
fn axisOf(effects: &Effects, axis: PositionAxis) -> Dimension {
  let d = dimension(effects, axis.offset)
  return match axis.edge {
    Edge.Start => d
    Edge.Center => Dimension.calc(d.value, 0.5 + d.percent)
    Edge.End => Dimension.calc(-d.value, 1.0 - d.percent)
  }
}

/// `inset()`, `rect()` and `xywh()` as top, right, bottom and left insets.
effect fn appendInsets(values: &mut List<Dimension>, effects: &Effects, kind: RectangleKind, edges: [Option<ExprId>; 4]) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let mut e = [Dimension.px(0.0); 4]
  let mut set = [false; 4]
  let mut i: usize = 0
  while i < 4 {
    match edges[i] {
      Option.Some { value } => {
        e[i] = dimension(effects, value)
        set[i] = true
      }
      Option.None => {}
    }
    i = i + 1
  }
  if kind == RectangleKind.Inset {
    run values.appendSlice(&e)
    return
  }
  if kind == RectangleKind.Rect {
    // rect(top right bottom left), edges from the top and left; `auto` is the box's own edge.
    let right = if set[1] { Dimension.calc(-e[1].value, 1.0 - e[1].percent) } else { Dimension.px(0.0) }
    let bottom = if set[2] { Dimension.calc(-e[2].value, 1.0 - e[2].percent) } else { Dimension.px(0.0) }
    run values.appendSlice(&[e[0], right, bottom, e[3]])
    return
  }
  // xywh(x y width height).
  let right = Dimension.calc(-e[0].value - e[2].value, 1.0 - e[0].percent - e[2].percent)
  let bottom = Dimension.calc(-e[1].value - e[3].value, 1.0 - e[1].percent - e[3].percent)
  run values.appendSlice(&[e[1], right, bottom, e[0]])
}

effect fn appendCorners(values: &mut List<Dimension>, effects: &Effects, corners: ShapeCorners) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < 4 {
    run values.append(dimension(effects, corners.x[i]))
    i = i + 1
  }
  i = 0
  while i < 4 {
    run values.append(dimension(effects, corners.y[i]))
    i = i + 1
  }
}
