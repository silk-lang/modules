struct Post {
  name: String,
  text: String,
}

/// What the shell, the posters and the window's loop share.
struct Desk {
  asks: List<ShellCommand>,
  posts: List<Post>,
  appWake: Option<WakeHandle>,
  engineTx: Option<AppToEngineTx>,
  nudge: Option<Nudge>,
  platform: Option<PlatformClient>,
  quit: bool,
  dark: bool,
  window: Option<WindowId>,
  // The window's loop ended: nothing answers a worker any more.
  closed: bool,
}

impl Transferable for Desk {}

fn wake(desk: &Arc<Mutex<Desk>>) -> () {
  let guard = desk.get().lock()
  let state = guard.get()
  let maybeWake = match &state.appWake {
    Option<WakeHandle>.Some { value } => Option<WakeHandle>.some(value.clone())
    Option<WakeHandle>.None => Option<WakeHandle>.None
  }
  let maybeNudge = match &state.nudge {
    Option<Nudge>.Some { value } => Option<Nudge>.some(value.clone())
    Option<Nudge>.None => Option<Nudge>.None
  }
  drop guard
  if let Option<WakeHandle>.Some { value } = move maybeWake {
    value.wake()
  }
  if let Option<Nudge>.Some { value } = move maybeNudge {
    value.nudge()
  }
}

/// The window a program opens: its title and size, its fonts, and its [`Shell`].
pub import ui_tree.style_assets { StyleAssets }
pub import ui_tree_window.style_watch { SheetWatch }
pub import window.types { TitleBar }

pub struct Window {
  title: string<'static>,
  width: f64,
  height: f64,
  titleBar: TitleBar,
  titleBarHeight: f64,
  controlsLeft: f64,
  controlsTop: f64,
  resources: Batch,
  stylesheetCompiler: StylesheetCompiler,
  stylesheets: StyleAssets,
  stylesheetUpdates: SheetWatch,
  files: List<CarriedFile>,
  inspect: bool,
  check: bool,
  checkClick: string<'static>,
  checkExpect: string<'static>,
  lowestLatency: bool,
  desk: Arc<Mutex<Desk>>,
}

impl Window {
  /// A window titled `title` whose content is `width` by `height` CSS pixels.
  pub effect fn make(title: string<'static>, width: f64, height: f64) -> Window
    ! OutOfMemoryError
    ? &mut Allocator {
    let desk = Desk {
      asks: List<ShellCommand>.make(),
      posts: List<Post>.make(),
      appWake: Option<WakeHandle>.None,
      engineTx: Option<AppToEngineTx>.None,
      nudge: Option<Nudge>.None,
      platform: Option<PlatformClient>.None,
      quit: false,
      dark: false,
      window: Option<WindowId>.None,
      closed: false,
    }
    return Window {
      title: title,
      width: width,
      height: height,
      titleBar: TitleBar.Standard,
      titleBarHeight: 0.0,
      controlsLeft: 0.0,
      controlsTop: 0.0,
      resources: Batch.make(),
      stylesheetCompiler: StylesheetCompiler.off(),
      stylesheets: StyleAssets.make(),
      stylesheetUpdates: SheetWatch.make(),
      files: List<CarriedFile>.make(),
      inspect: true,
      check: false,
      checkClick: "",
      checkExpect: "",
      lowestLatency: false,
      desk: run Arc<Mutex<Desk>>.make(run Mutex<Desk>.make(move desk)),
    }
  }

  /// Installs precompiled application sheets in their supplied order before layout.
  pub fn withStylesheetCompiler(self: &mut Self, compiler: StylesheetCompiler) -> () { self.stylesheetCompiler = compiler }

  pub fn withStyleSheets(self: &mut Self, stylesheets: StyleAssets) -> () {
    self.stylesheets = move stylesheets
  }

  /// Enables compiled stylesheet updates prepared by the development task.
  pub fn withStyleSheetUpdates(self: &mut Self, updates: SheetWatch) -> () {
    self.stylesheetUpdates = move updates
  }

  pub effect fn stylesheet(self: &mut Self, bytes: &[u8]) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    run self.stylesheets.append(bytes)
  }

  /// The families `css.fontFamilyNumber(family)` stands for, most wanted first:
  /// `"Inter, system-ui, sans-serif"`. A program's own fonts are `Font`s, declared in its
  /// `fonts`, and need nothing here.
  pub effect fn font(self: &mut Self, family: u32, names: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.resources.fontFamily(family, names)
  }

  /// Serves the relative URL `path` from `data`, bytes the program carries, so
  /// `h.image("photos/dusk.png")` needs no file beside the program:
  /// `window.file("photos/dusk.png", Source.read("assets/photos/dusk.png"))`. A relative URL
  /// the program does not carry is read from the working directory.
  pub effect fn file(self: &mut Self, path: string<'static>, data: &'static [u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.files.append(CarriedFile { path: path, data: data })
  }

  /// How the title bar is drawn. `TitleBar.Transparent` puts the program under the bar on
  /// macOS, with the window controls over it; other systems keep their bar. `height` is the
  /// bar the program draws at its top: the controls are centred in it, a press in it moves
  /// the window, and the program gets no pointer presses there.
  pub fn withTitleBar(self: &mut Self, titleBar: TitleBar, height: f64) -> () {
    self.titleBar = titleBar
    self.titleBarHeight = height
  }

  /// With a transparent title bar, puts the window buttons' top-left corner `left` and `top`
  /// points from the window's edges; 0 keeps that one centred in the bar.
  pub fn withControls(self: &mut Self, left: f64, top: f64) -> () {
    self.controlsLeft = left
    self.controlsTop = top
  }

  /// Does not serve the inspector, even in a debug build with `SILK_UI_INSPECT` set.
  pub fn uninspected(self: &mut Self) -> () {
    self.inspect = false
  }

  /// Draws for the lowest latency between input and pixels (games, drawing).
  pub fn lowLatency(self: &mut Self) -> () {
    self.lowestLatency = true
  }

  /// Checks the window instead of taking input: clicks the node named `click`, expects a
  /// node named `expect`, and compares the frame with its CPU reference (see
  /// `loom_window.lib`).
  pub fn checking(self: &mut Self, click: string<'static>, expect: string<'static>) -> () {
    self.check = true
    self.checkClick = click
    self.checkExpect = expect
  }

  /// The [`Shell`] of this window: provide it to `run` with `Effect.provideMut<Shell>`.
  pub fn shell(self: &Self) -> WindowShell {
    return WindowShell { desk: self.desk.clone() }
  }

  /// A handle that posts to the program's ports from any thread.
  pub fn poster(self: &Self) -> Poster {
    return Poster { desk: self.desk.clone() }
  }
}

/// Posts to a program's ports from any thread: `subs.port(key, name, …)` hears it on the UI
/// thread. This is how a worker says it has a result.
pub struct Poster {
  desk: Arc<Mutex<Desk>>,
}

impl Transferable for Poster {}

effect fn unposted(error: OutOfMemoryError) -> () {
  drop error
}

impl Poster {
  pub fn clone(self: &Self) -> Poster {
    return Poster { desk: self.desk.clone() }
  }

  /// Posts `text` to the port `name`. A post that cannot be allocated is dropped.
  pub fn post(self: &Self, name: string, text: string) -> () {
    let mut allocator = Allocator.systemAllocatorProvider()
    run Effect.catchAll(self.queue(name, text), unposted)
      |> Effect.provideMut<Allocator>(&mut allocator)
    wake(&self.desk)
  }

  effect fn queue(self: &Self, name: string, text: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let post = Post { name: run String.copy(name), text: run String.copy(text) }
    let mut guard = self.desk.get().lock()
    let state = guard.getMut()
    run state.posts.append(move post)
  }
}

/// The [`Shell`] of a [`Window`].
pub struct WindowShell {
  desk: Arc<Mutex<Desk>>,
}

impl Transferable for WindowShell {}

impl WindowShell {
  effect fn ask(self: &mut Self, ask: ShellCommand) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut guard = self.desk.get().lock()
    let state = guard.getMut()
    if state.closed {
      return ()
    }
    if let Option<AppToEngineTx>.Some { value: tx } = &state.engineTx {
      let sender = tx.clone()
      drop guard
      drop sender.send(AppToEngine.Shell { command: move ask })
      return ()
    }
    run state.asks.append(move ask)
    drop guard
    wake(&self.desk)
  }

  /// A cloneable handle usable from worker threads.
  fn onWorker(self: &Self) -> WindowShell {
    return WindowShell { desk: self.desk.clone() }
  }
}

impl Shell for WindowShell {
  effect fn setTitle(self: &mut Self, title: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(ShellCommand.Title { text: run String.copy(title) })
  }

  effect fn setSize(self: &mut Self, width: f64, height: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(ShellCommand.Size { width: width, height: height })
  }

  effect fn minimize(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(ShellCommand.Minimize)
  }

  effect fn toggleFullScreen(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(ShellCommand.FullScreen)
  }

  effect fn quit(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut guard = self.desk.get().lock()
    let state = guard.getMut()
    state.quit = true
    let maybeTx = match &state.engineTx {
      Option<AppToEngineTx>.Some { value } => Option<AppToEngineTx>.some(value.clone())
      Option<AppToEngineTx>.None => Option<AppToEngineTx>.None
    }
    drop guard
    if let Option<AppToEngineTx>.Some { value: tx } = move maybeTx {
      drop tx.send(AppToEngine.Shell { command: ShellCommand.Quit })
    }
    wake(&self.desk)
  }

  effect fn copy(self: &mut Self, text: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(ShellCommand.Copy { text: run String.copy(text) })
  }

  effect fn paste(self: &mut Self) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let guard = self.desk.get().lock()
    let state = guard.get()
    if state.closed {
      return String.make()
    }
    let client = match &state.platform {
      Option<PlatformClient>.Some { value } => Option<PlatformClient>.some(value.clone())
      Option<PlatformClient>.None => Option<PlatformClient>.None
    }
    drop guard
    if let Option<PlatformClient>.Some { value: platform } = move client {
      if let Option<String>.Some { value: text } = move run platform.readClipboard() {
        return move text
      }
    }
    return String.make()
  }

  effect fn dark(self: &mut Self) -> bool {
    let guard = self.desk.get().lock()
    return guard.get().dark
  }

  effect fn setMenu(self: &mut Self, menu: Menu) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(ShellCommand.SetMenu { menu: move menu })
  }

  effect fn openFile(self: &mut Self, request: u32, dialog: FileDialog<'_>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(
      ShellCommand.OpenFile {
        request: request,
        title: run String.copy(dialog.title),
        extensions: run String.copy(dialog.extensions),
        multiple: dialog.multiple,
        directories: dialog.directories,
      },
    )
  }

  effect fn saveFile(self: &mut Self, request: u32, dialog: FileDialog<'_>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(
      ShellCommand.SaveFile {
        request: request,
        title: run String.copy(dialog.title),
        name: run String.copy(dialog.name),
        extensions: run String.copy(dialog.extensions),
      },
    )
  }

  effect fn setTray(self: &mut Self, tray: Tray) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(ShellCommand.SetTray { tray: move tray })
  }

  effect fn removeTray(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(ShellCommand.RemoveTray)
  }

  effect fn registerShortcut(self: &mut Self, id: u32, code: string, modifiers: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(ShellCommand.Shortcut { id: id, code: run String.copy(code), modifiers: modifiers })
  }

  effect fn unregisterShortcut(self: &mut Self, id: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(ShellCommand.Unshortcut { id: id })
  }

  effect fn notify(self: &mut Self, id: u32, title: string, body: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ask(
      ShellCommand.Notify { id: id, title: run String.copy(title), body: run String.copy(body) },
    )
  }
}

/// The key whose UI Events `code` is `name`, `Unidentified` for none.
fn keyCodeOf(name: string) -> KeyCode {
  let mut value: u32 = 1
  while value < 129 {
    let code = keyCodeFromValue(value)
    if codeName(code) == name {
      return code
    }
    value = value + 1
  }
  return KeyCode.Unidentified
}

/// `text` for `PORT_DRAG`: `kind`, then the position in whole CSS pixels.
effect fn dragText(kind: string, x: f64, y: f64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy(kind)
  run text.append(" ")
  run decimal(&mut text, if x > 0.0 { f64.toU32(x) } else { 0 })
  run text.append(" ")
  run decimal(&mut text, if y > 0.0 { f64.toU32(y) } else { 0 })
  return move text
}

const DIGITS: string = "0123456789"

/// `value` in decimal, appended to `out`.
effect fn decimal(out: &mut String, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 10 {
    run decimal(&mut out, value / 10)
  }
  run out.append(String.slice(DIGITS, u32.toUsize(value % 10), 1))
}

fn systemItem(item: StandardItem) -> SystemItem {
  return match item {
    StandardItem.About => SystemItem.About
    StandardItem.Services => SystemItem.Services
    StandardItem.Hide => SystemItem.Hide
    StandardItem.HideOthers => SystemItem.HideOthers
    StandardItem.ShowAll => SystemItem.ShowAll
    StandardItem.Quit => SystemItem.Quit
    StandardItem.CloseWindow => SystemItem.CloseWindow
    StandardItem.Minimize => SystemItem.Minimize
    StandardItem.Zoom => SystemItem.Zoom
    StandardItem.ToggleFullScreen => SystemItem.ToggleFullScreen
    StandardItem.BringAllToFront => SystemItem.BringAllToFront
  }
}

/// The shortcut `modifiers` + `key` of a menu item: a key of one character, or none.
fn shortcut(key: string, modifiers: u32) -> Option<Shortcut> {
  let first = match String.nextScalar(key, String.scalarCursor()) {
    Option.Some { value } => move value
    Option.None => {
      return Option<Shortcut>.None
    }
  }
  let character = String.scalarValue(&first)
  if String.scalarByteOffset(&first) != 0
    || String.cursorByteOffset(&String.nextCursor(move first)) != String.byteLength(key) {
    return Option<Shortcut>.None
  }
  let mut held = Modifiers.none()
  held.shift = (modifiers & MOD_SHIFT) != 0
  held.control = (modifiers & MOD_CONTROL) != 0
  held.alt = (modifiers & MOD_ALT) != 0
  held.meta = (modifiers & MOD_META) != 0
  return Option<Shortcut>.some(
    Shortcut { key: ShortcutKey.Character { character: character }, modifiers: held },
  )
}

effect fn menuBar(menu: &Menu) -> MenuBar
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut bar = MenuBar.make()
  let entries = menu.entries.asSlice()
  let mut i: usize = 0
  while i < entries.length {
    match &entries[i] {
      MenuEntry.Begin { title } => run bar.begin(String.view(&title))
      MenuEntry.End => run bar.end()
      MenuEntry.Action { title, action, key, modifiers, enabled, checked } => run bar.item(
        String.view(&title),
        action,
        shortcut(String.view(&key), modifiers),
        enabled,
        checked,
      )
      MenuEntry.Separator => run bar.separator()
      MenuEntry.Standard { item } => run bar.system(systemItem(item))
    }
    i = i + 1
  }
  return move bar
}

struct Asked {
  dialog: u32,
  request: u32,
}

/// A notification the platform showed as `shown`, for the program's `id`.
struct Notice {
  shown: u32,
  id: u32,
}

/// How many notifications nobody clicked are remembered.
const NOTICES_KEPT: usize = 64

/// The window's side of the shell: does what was asked, and posts what the window says.
/// Shared OS shell command execution used by both split `ShellExtension` and single-thread `ShellContent`.
effect fn executeShellCommand(
  ask: ShellCommand,
  platform: &mut HostPlatform,
  window: WindowId,
  dialogs: &mut List<Asked>,
  notices: &mut List<Notice>,
) -> ()
  ! WindowError | OutOfMemoryError
  ? &mut Allocator {
  match move ask {
    ShellCommand.Title { text } => run platform.setTitle(window, String.view(&text))
    ShellCommand.Size { width, height } => platform.setContentSize(window, Size2<f64>.new(width, height))
    ShellCommand.Minimize => platform.minimize(window)
    ShellCommand.FullScreen => platform.toggleFullScreen(window)
    ShellCommand.Copy { text } => run platform.writeClipboard(String.view(&text))
    ShellCommand.SetMenu { menu } => {
      let bar = run menuBar(&menu)
      run platform.setMenuBar(&bar)
    }
    ShellCommand.OpenFile { request, title, extensions, multiple, directories } => {
      let mut options = OpenDialog.file(String.view(&title), String.view(&extensions))
      options.multiple = multiple
      options.directories = directories
      options.files = !directories
      options.parent = Option<WindowId>.some(window)
      let dialog = run platform.openFileDialog(&options)
      run dialogs.append(Asked { dialog: dialog.value, request: request })
    }
    ShellCommand.SaveFile { request, title, name, extensions } => {
      let mut options = SaveDialog.named(
        String.view(&title),
        String.view(&name),
        String.view(&extensions),
      )
      options.parent = Option<WindowId>.some(window)
      let dialog = run platform.saveFileDialog(&options)
      run dialogs.append(Asked { dialog: dialog.value, request: request })
    }
    ShellCommand.SetTray { tray } => {
      let bar = run menuBar(&tray.menu)
      let options = TrayOptions {
        icon: TrayIcon {
          width: tray.width,
          height: tray.height,
          pixels: tray.pixels.asSlice(),
          template: tray.template,
        },
        tooltip: String.view(&tray.tooltip),
        menu: &bar,
      }
      drop run platform.setTray(&options)
    }
    ShellCommand.RemoveTray => platform.removeTray()
    ShellCommand.Shortcut { id, code, modifiers } => {
      let key = keyCodeOf(String.view(&code))
      if key != KeyCode.Unidentified {
        let mut held = Modifiers.none()
        held.shift = (modifiers & MOD_SHIFT) != 0
        held.control = (modifiers & MOD_CONTROL) != 0
        held.alt = (modifiers & MOD_ALT) != 0
        held.meta = (modifiers & MOD_META) != 0
        drop run platform.registerShortcut(id, key, held)
      }
    }
    ShellCommand.Unshortcut { id } => platform.unregisterShortcut(id)
    ShellCommand.Notify { id, title, body } => {
      let notification = Notification { title: String.view(&title), body: String.view(&body) }
      let shown = run platform.notify(&notification)
      if shown != 0 {
        if notices.length() >= NOTICES_KEPT {
          drop notices.remove(0)
        }
        run notices.append(Notice { shown: shown, id: id })
      }
    }
    ShellCommand.Quit => {}
  }
}

fn takeAskedRequest(dialogs: &mut List<Asked>, dialog: u32) -> u32 {
  let mut i: usize = 0
  while i < dialogs.length() {
    if dialogs.asSlice()[i].dialog == dialog {
      return dialogs.remove(i).request
    }
    i = i + 1
  }
  return 0
}

fn takeNoticeProgram(notices: &mut List<Notice>, shown: u32) -> u32 {
  let mut i: usize = 0
  while i < notices.length() {
    if notices.asSlice()[i].shown == shown {
      return notices.remove(i).id
    }
    i = i + 1
  }
  return 0
}

/// Engine-thread shell integration for [`Window`] when running the 2-thread split host.
struct ShellExtension {
  stylesheetCompiler: StylesheetCompiler,
  dialogs: List<Asked>,
  notices: List<Notice>,
  files: List<CarriedFile>,
  treeKeeper: TreeKeeper,
  titleBar: TitleBar,
  titleBarHeight: f64,
  controlsLeft: f64,
  controlsTop: f64,
  windowDrag: bool,
}

impl Transferable for ShellExtension {}

impl EngineExtension for ShellExtension {
  effect fn files(self: &mut Self, loader: &mut Loader) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    loader.setStylesheetCompiler(self.stylesheetCompiler)
    let files = self.files.asSlice()
    let mut i: usize = 0
    while i < files.length {
      run loader.file(files[i].path, files[i].data)
      i = i + 1
    }
  }

  fn configure(self: &Self, options: &mut WindowOptions<'_>) -> () {
    options.titleBar = self.titleBar
    options.titleBarHeight = self.titleBarHeight
    options.controlsLeft = self.controlsLeft
    options.controlsTop = self.controlsTop
  }

  effect fn event(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    event: &Event,
    appTx: &UnboundedSender<EngineToApp>,
  ) -> bool
    ! WindowError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    drop tree
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      if let Event.MouseDown { button, position, .. } = &event.* {
        if self.titleBar == TitleBar.Transparent && button == MouseButton.Left && position.y < self.titleBarHeight {
          self.windowDrag = true
          return true
        }
      }
    }
    match &event.* {
      Event.MenuAction { action } => {
        drop run Effect.result(appTx.send(EngineToApp.Shell { event: ShellEvent.MenuAction { action: action } }))
        return true
      }
      Event.DialogClosed { dialog, paths } => {
        let req = takeAskedRequest(&mut self.dialogs, dialog.value)
        let mut copied = List<String>.make()
        let chosen = paths.asSlice()
        let mut i: usize = 0
        while i < chosen.length {
          run copied.append(run String.copy(String.view(&chosen[i])))
          i = i + 1
        }
        drop run Effect.result(
          appTx.send(EngineToApp.Shell { event: ShellEvent.DialogClosed { request: req, paths: move copied } }),
        )
        return true
      }
      Event.FileDragEntered { position, .. } => {
        drop run Effect.result(
          appTx.send(EngineToApp.Shell { event: ShellEvent.DragEntered { x: position.x, y: position.y } }),
        )
        return true
      }
      Event.FileDragMoved { position, .. } => {
        drop run Effect.result(
          appTx.send(EngineToApp.Shell { event: ShellEvent.DragMoved { x: position.x, y: position.y } }),
        )
        return true
      }
      Event.FileDragLeft { .. } => {
        drop run Effect.result(appTx.send(EngineToApp.Shell { event: ShellEvent.DragLeft }))
        return true
      }
      Event.FileDropped { position, paths, .. } => {
        let mut copied = List<String>.make()
        let dropped = paths.asSlice()
        let mut i: usize = 0
        while i < dropped.length {
          run copied.append(run String.copy(String.view(&dropped[i])))
          i = i + 1
        }
        drop run Effect.result(
          appTx.send(
            EngineToApp.Shell {
              event: ShellEvent.Dropped { x: position.x, y: position.y, paths: move copied },
            },
          ),
        )
        return true
      }
      Event.GlobalShortcut { id } => {
        drop run Effect.result(appTx.send(EngineToApp.Shell { event: ShellEvent.GlobalShortcut { id: id } }))
        return true
      }
      Event.TrayClicked { button } => {
        let btn: u32 = match button {
          MouseButton.Middle => 1
          MouseButton.Right => 2
          _ => 0
        }
        drop run Effect.result(appTx.send(EngineToApp.Shell { event: ShellEvent.TrayClicked { button: btn } }))
        return true
      }
      Event.NotificationClicked { id } => {
        let program = takeNoticeProgram(&mut self.notices, id)
        if program != 0 {
          drop run Effect.result(
            appTx.send(EngineToApp.Shell { event: ShellEvent.NotificationClicked { id: program } }),
          )
        }
        return true
      }
      Event.AppearanceChanged { appearance } => {
        let dark = match appearance {
          Appearance.Dark => true
          _ => false
        }
        drop run Effect.result(appTx.send(EngineToApp.Shell { event: ShellEvent.AppearanceChanged { dark: dark } }))
      }
      Event.Focused { focused, .. } => {
        drop run Effect.result(appTx.send(EngineToApp.Shell { event: ShellEvent.Focused { focused: focused } }))
      }
      _ => {}
    }
    return false
  }

  effect fn onShellCommand(
    self: &mut Self,
    command: ShellCommand,
    platform: &mut HostPlatform,
    window: WindowId,
    appTx: &UnboundedSender<EngineToApp>,
  ) -> bool
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    drop appTx
    run executeShellCommand(move command, &mut platform, window, &mut self.dialogs, &mut self.notices)
    return false
  }

  effect fn update(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    platform: &mut HostPlatform,
    window: WindowId,
    appTx: &UnboundedSender<EngineToApp>,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    drop tree
    drop appTx
    if self.windowDrag {
      self.windowDrag = false
      Platform.startWindowDrag(&mut platform.*, window)
    }
    return false
  }

  effect fn afterLayout(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    appTx: &UnboundedSender<EngineToApp>,
  ) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if let Option.Some { value: upd } = move run self.treeKeeper.track(&mut tree) {
      if let Option<String>.Some { value: json } = move upd.treeJson {
        drop run Effect.result(
          appTx.send(
            EngineToApp.Shell {
              event: ShellEvent.TreeKeeperState { digest: upd.digest, treeJson: move json },
            },
          ),
        )
      }
      return upd.restored
    }
    return false
  }
}

/// App-thread bridge for [`Program`] connecting [`Desk`], [`Keeper`], [`PlatformClient`], and ports.
struct ProgramAppBridge<A, M, C> {
  desk: Arc<Mutex<Desk>>,
  keeper: Keeper,
  greeted: bool,
}

impl<A, M, C> ProgramAppBridge<A, M, C> {
  fn setDark(self: &mut Self, dark: bool) -> () {
    let mut guard = self.desk.get().lock()
    let state = guard.getMut()
    state.dark = dark
  }
}

impl<A: App<M, C>, M, C> AppBridge<A, M, C> for ProgramAppBridge<A, M, C> {
  effect fn onReady(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    info: EngineReadyInfo,
    wake: WakeHandle,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    drop wake
    self.setDark(info.dark)
    if !self.greeted {
      self.greeted = true
      if info.dark {
        run app.posted(PORT_APPEARANCE, "dark")
      }
    }
  }

  effect fn onServices(
    self: &mut Self,
    groupId: u32,
    pools: PoolHandles,
    platform: Option<PlatformClient>,
    wake: WakeHandle,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    drop groupId
    drop pools
    drop wake
    let mut guard = self.desk.get().lock()
    let state = guard.getMut()
    state.platform = move platform
  }

  effect fn onShellEvent(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    event: ShellEvent,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match move event {
      ShellEvent.MenuAction { action } => {
        let mut text = String.make()
        run decimal(&mut text, action)
        run app.posted(PORT_MENU, String.view(&text))
      }
      ShellEvent.DialogClosed { request, paths } => {
        let mut text = String.make()
        run decimal(&mut text, request)
        let chosen = paths.asSlice()
        let mut i: usize = 0
        while i < chosen.length {
          run text.append("\n")
          run text.append(String.view(&chosen[i]))
          i = i + 1
        }
        run app.posted(PORT_FILES, String.view(&text))
      }
      ShellEvent.DragEntered { x, y } => {
        let text = run dragText("enter", x, y)
        run app.posted(PORT_DRAG, String.view(&text))
      }
      ShellEvent.DragMoved { x, y } => {
        let text = run dragText("over", x, y)
        run app.posted(PORT_DRAG, String.view(&text))
      }
      ShellEvent.DragLeft => {
        run app.posted(PORT_DRAG, "leave")
      }
      ShellEvent.Dropped { x, y, paths } => {
        let mut text = run dragText("drop", x, y)
        let dropped = paths.asSlice()
        let mut i: usize = 0
        while i < dropped.length {
          run text.append("\n")
          run text.append(String.view(&dropped[i]))
          i = i + 1
        }
        run app.posted(PORT_DRAG, String.view(&text))
      }
      ShellEvent.GlobalShortcut { id } => {
        let mut text = String.make()
        run decimal(&mut text, id)
        run app.posted(PORT_SHORTCUT, String.view(&text))
      }
      ShellEvent.TrayClicked { button } => {
        run app.posted(
          PORT_TRAY,
          match button {
            1 => "1"
            2 => "2"
            _ => "0"
          },
        )
      }
      ShellEvent.NotificationClicked { id } => {
        let mut text = String.make()
        run decimal(&mut text, id)
        run app.posted(PORT_NOTIFICATION, String.view(&text))
      }
      ShellEvent.AppearanceChanged { dark } => {
        self.setDark(dark)
        if self.greeted {
          run app.posted(
            PORT_APPEARANCE,
            if dark {
              "dark"
            } else {
              "light"
            },
          )
        } else {
          self.greeted = true
          if dark {
            run app.posted(PORT_APPEARANCE, "dark")
          }
        }
      }
      ShellEvent.Focused { focused } => {
        run app.posted(
          PORT_FOCUS,
          if focused {
            "1"
          } else {
            "0"
          },
        )
      }
      ShellEvent.CloseRequested => {
        let guard = self.desk.get().lock()
        let quit = guard.get().quit
        drop guard
        if !quit && app.listens(PORT_CLOSE) {
          run app.posted(PORT_CLOSE, "")
        }
      }
      ShellEvent.Resized { width, height } => {
        self.keeper.resized(width, height)
      }
      ShellEvent.TreeKeeperState { digest, treeJson } => {
        self.keeper.setTreeState(digest, move treeJson)
      }
    }
  }

  effect fn pollExternal(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    backend: &mut SnapshotBackend,
    now: f64,
  ) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    drop backend
    drop now
    let mut guard = self.desk.get().lock()
    let state = guard.getMut()
    let mut posts = Intrinsic.replace(state.posts, List<Post>.make())
    drop guard
    let had = posts.length() > 0
    while posts.length() > 0 {
      let post = posts.remove(0)
      run app.posted(String.view(&post.name), String.view(&post.text))
    }
    return had
  }

  effect fn afterTurn(self: &mut Self, app: &Runtime<A, M, C>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.keeper.save(&app.model, app.stats.messages)
  }

  fn interceptClose(self: &Self, app: &mut Runtime<A, M, C>) -> bool {
    return app.listens(PORT_CLOSE)
  }

  fn quitting(self: &Self) -> bool {
    let guard = self.desk.get().lock()
    return guard.get().quit
  }
}

/// App-thread worker-dispatched bridge used by [`openWithWorkers`].
struct WorkerAppBridge<A, M, C, F: fn<'static>(C, WindowShell, Option<WorkPoolHandle>, u32, Option<WakeHandle>) -> Option<Worker<M>>> {
  shell: ProgramAppBridge<A, M, C>,
  hands: WindowShell,
  jobs: List<Job<M>>,
  appPool: Option<WorkPoolHandle>,
  groupId: u32,
  wake: Option<WakeHandle>,
  start: F,
}

impl<
  A: App<M, C>,
  M,
  C,
  F: fn<'static>(C, WindowShell, Option<WorkPoolHandle>, u32, Option<WakeHandle>) -> Option<Worker<M>>
> AppBridge<A, M, C> for WorkerAppBridge<A, M, C, F> {
  effect fn onReady(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    info: EngineReadyInfo,
    wake: WakeHandle,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.wake = Option<WakeHandle>.some(wake.clone())
    run AppBridge<A, M, C>.onReady(&mut self.shell, &mut app, move info, move wake)
  }

  effect fn onServices(
    self: &mut Self,
    groupId: u32,
    pools: PoolHandles,
    platform: Option<PlatformClient>,
    wake: WakeHandle,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.appPool = Option<WorkPoolHandle>.some(pools.app.clone())
    self.groupId = groupId
    self.wake = Option<WakeHandle>.some(wake.clone())
    run AppBridge<A, M, C>.onServices(&mut self.shell, groupId, move pools, move platform, move wake)
  }

  effect fn onShellEvent(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    event: ShellEvent,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run AppBridge<A, M, C>.onShellEvent(&mut self.shell, &mut app, move event)
  }

  fn runsCommands(self: &Self) -> bool {
    return true
  }

  effect fn pollExternal(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    backend: &mut SnapshotBackend,
    now: f64,
  ) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut changed = run AppBridge<A, M, C>.pollExternal(&mut self.shell, &mut app, &mut backend, now)
    let mut i: usize = 0
    while i < self.jobs.length() {
      if workerReady(&self.jobs.asSlice()[i].work) {
        let mut job = self.jobs.remove(i)
        if let Option<Background<bool>>.Some { value: thread } = move job.work.thread {
          let mut t = move thread
          drop t.poll()
        }
        drop job.work.claim
        let mut guard = job.work.slot.get().lock()
        let place = guard.getMut()
        let message = Intrinsic.replace(place.*, Option<M>.None)
        drop guard
        if let Option<M>.Some { value } = move message {
          if app.finish(job.ticket, move value) {
            changed = true
          }
        }
      } else {
        i = i + 1
      }
    }
    while self.jobs.length() < WORKERS && app.deferredOn(false) != 0 {
      let held = run app.takeWorkOn(false)
      let ticket = held.ticket
      let pool = match &self.appPool {
        Option<WorkPoolHandle>.Some { value } => Option<WorkPoolHandle>.some(value.clone())
        Option<WorkPoolHandle>.None => Option<WorkPoolHandle>.None
      }
      let wake = match &self.wake {
        Option<WakeHandle>.Some { value } => Option<WakeHandle>.some(value.clone())
        Option<WakeHandle>.None => Option<WakeHandle>.None
      }
      match self.start(move held.command, self.hands.onWorker(), move pool, self.groupId, move wake) {
        Option<Worker<M>>.Some { value } => run self.jobs.append(Job<M> { ticket: ticket, work: move value })
        Option<Worker<M>>.None => {
          drop app.abandon(ticket)
          break
        }
      }
    }
    return changed
  }

  effect fn afterTurn(self: &mut Self, app: &Runtime<A, M, C>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run AppBridge<A, M, C>.afterTurn(&mut self.shell, app)
  }

  fn interceptClose(self: &Self, app: &mut Runtime<A, M, C>) -> bool {
    return AppBridge<A, M, C>.interceptClose(&self.shell, &mut app)
  }

  fn quitting(self: &Self) -> bool {
    return AppBridge<A, M, C>.quitting(&self.shell)
  }
}

/// Fallback single-threaded `WindowContent` used on `wasm32` where OS threads are unavailable.
struct ShellContent<A, M, C> {
  stylesheetCompiler: StylesheetCompiler,
  desk: Arc<Mutex<Desk>>,
  dialogs: List<Asked>,
  notices: List<Notice>,
  greeted: bool,
  files: List<CarriedFile>,
  keeper: Keeper,
  titleBar: TitleBar,
  titleBarHeight: f64,
  controlsLeft: f64,
  controlsTop: f64,
  windowDrag: bool,
}

impl<A, M, C> ShellContent<A, M, C> {
  effect fn perform(self: &mut Self, ask: ShellCommand, platform: &mut HostPlatform, window: WindowId) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    run executeShellCommand(move ask, &mut platform, window, &mut self.dialogs, &mut self.notices)
  }

  fn setDark(self: &mut Self, dark: bool) -> () {
    let mut guard = self.desk.get().lock()
    let state = guard.getMut()
    state.dark = dark
  }
}

impl<A: App<M, C>, M, C> WindowContent<A, M, C> for ShellContent<A, M, C> {
  effect fn files(self: &mut Self, loader: &mut Loader) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    loader.setStylesheetCompiler(self.stylesheetCompiler)
    let files = self.files.asSlice()
    let mut i: usize = 0
    while i < files.length {
      run loader.file(files[i].path, files[i].data)
      i = i + 1
    }
  }

  fn configure(self: &Self, options: &mut WindowOptions<'_>) -> () {
    options.titleBar = self.titleBar
    options.titleBarHeight = self.titleBarHeight
    options.controlsLeft = self.controlsLeft
    options.controlsTop = self.controlsTop
  }

  effect fn opened(self: &mut Self, platform: &mut HostPlatform, window: WindowId) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    let dark = match platform.appearance() {
      Appearance.Dark => true
      _ => false
    }
    let nudge = platform.nudge()
    let mut guard = self.desk.get().lock()
    let state = guard.getMut()
    state.dark = dark
    state.nudge = Option<Nudge>.some(move nudge)
    state.window = Option<WindowId>.some(window)
  }

  effect fn event(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    tree: &mut UiTree<'_>,
    event: &Event,
  ) -> bool
    ! WindowError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    drop tree
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      if let Event.MouseDown { button, position, .. } = &event.* {
        if self.titleBar == TitleBar.Transparent && button == MouseButton.Left && position.y < self.titleBarHeight {
          self.windowDrag = true
          return true
        }
      }
    }
    match &event.* {
      Event.Resized { size, .. } => {
        self.keeper.resized(size.width, size.height)
      }
      Event.MenuAction { action } => {
        let mut text = String.make()
        run decimal(&mut text, action)
        run app.posted(PORT_MENU, String.view(&text))
        return true
      }
      Event.DialogClosed { dialog, paths } => {
        let mut text = String.make()
        run decimal(&mut text, takeAskedRequest(&mut self.dialogs, dialog.value))
        let chosen = paths.asSlice()
        let mut i: usize = 0
        while i < chosen.length {
          run text.append("\n")
          run text.append(String.view(&chosen[i]))
          i = i + 1
        }
        run app.posted(PORT_FILES, String.view(&text))
        return true
      }
      Event.FileDragEntered { position, .. } => {
        let text = run dragText("enter", position.x, position.y)
        run app.posted(PORT_DRAG, String.view(&text))
        return true
      }
      Event.FileDragMoved { position, .. } => {
        let text = run dragText("over", position.x, position.y)
        run app.posted(PORT_DRAG, String.view(&text))
        return true
      }
      Event.FileDragLeft { .. } => {
        run app.posted(PORT_DRAG, "leave")
        return true
      }
      Event.FileDropped { position, paths, .. } => {
        let mut text = run dragText("drop", position.x, position.y)
        let dropped = paths.asSlice()
        let mut i: usize = 0
        while i < dropped.length {
          run text.append("\n")
          run text.append(String.view(&dropped[i]))
          i = i + 1
        }
        run app.posted(PORT_DRAG, String.view(&text))
        return true
      }
      Event.GlobalShortcut { id } => {
        let mut text = String.make()
        run decimal(&mut text, id)
        run app.posted(PORT_SHORTCUT, String.view(&text))
        return true
      }
      Event.TrayClicked { button } => {
        run app.posted(
          PORT_TRAY,
          match button {
            MouseButton.Middle => "1"
            MouseButton.Right => "2"
            _ => "0"
          },
        )
        return true
      }
      Event.NotificationClicked { id } => {
        let program = takeNoticeProgram(&mut self.notices, id)
        if program != 0 {
          let mut text = String.make()
          run decimal(&mut text, program)
          run app.posted(PORT_NOTIFICATION, String.view(&text))
        }
        return true
      }
      Event.AppearanceChanged { appearance } => {
        let dark = match appearance {
          Appearance.Dark => true
          _ => false
        }
        self.setDark(dark)
        run app.posted(
          PORT_APPEARANCE,
          if dark {
            "dark"
          } else {
            "light"
          },
        )
        wake(&self.desk)
      }
      Event.Focused { focused, .. } => {
        run app.posted(
          PORT_FOCUS,
          if focused {
            "1"
          } else {
            "0"
          },
        )
        wake(&self.desk)
      }
      _ => {}
    }
    return false
  }

  effect fn update(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    tree: &mut UiTree<'_>,
    platform: &mut HostPlatform,
    window: WindowId,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    drop tree
    let mut changed = false
    if self.windowDrag {
      self.windowDrag = false
      Platform.startWindowDrag(&mut platform.*, window)
    }
    if !self.greeted {
      self.greeted = true
      let guard = self.desk.get().lock()
      let dark = guard.get().dark
      drop guard
      if dark {
        run app.posted(PORT_APPEARANCE, "dark")
        changed = true
      }
    }
    while true {
      let mut guard = self.desk.get().lock()
      let state = guard.getMut()
      if state.asks.length() == 0 {
        break
      }
      let ask = state.asks.remove(0)
      drop guard
      run self.perform(move ask, &mut platform, window)
    }
    return changed
  }

  effect fn closing(self: &mut Self, app: &mut Runtime<A, M, C>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let guard = self.desk.get().lock()
    let quit = guard.get().quit
    drop guard
    if quit || !app.listens(PORT_CLOSE) {
      return true
    }
    run app.posted(PORT_CLOSE, "")
    return false
  }

  fn quitting(self: &Self, app: &Runtime<A, M, C>) -> bool {
    drop app
    let guard = self.desk.get().lock()
    return guard.get().quit
  }

  effect fn poll(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    tree: &mut UiTree<'_>,
    time: f64,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    drop time
    let mut guard = self.desk.get().lock()
    let state = guard.getMut()
    let mut posts = Intrinsic.replace(state.posts, List<Post>.make())
    drop guard
    let restored = run self.keeper.track(&mut tree)
    run self.keeper.save(&app.model, app.stats.messages)
    let changed = restored || posts.length() > 0
    while posts.length() > 0 {
      let post = posts.remove(0)
      run app.posted(String.view(&post.name), String.view(&post.text))
    }
    return changed
  }
}

/// Initialized program state ready for split execution or wasm32 fallback.
struct Opening<P, M, C> {
  app: Runtime<Hosted<P>, M, Run<C>>,
  keeper: Keeper,
  options: RunOptions,
  inspector: Inspector,
}

effect fn opening<P: Program<M, C>, M, C>(
  window: &mut Window,
  platform: Option<Launched>,
) -> Opening<P, M, C>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut app = run make<P, M, C>()
  if !window.check {
    app.deferCommands()
  }
  let mut keeper = run Keeper.fromEnvironment()
  run keeper.restore(&mut app.model)
  if let Option<Size2<f64>>.Some { value } = keeper.size() {
    window.width = value.width
    window.height = value.height
  }
  let options = RunOptions {
    title: window.title,
    width: window.width,
    height: window.height,
    check: window.check,
    checkClick: window.checkClick,
    checkExpect: window.checkExpect,
    lowestLatency: window.lowestLatency,
    platform: move platform,
    gpu: Option<StartedGpu>.None,
  }
  let inspector = if window.inspect {
    run startInspector(InspectorOptions.make())
  } else {
    Inspector.off()
  }
  return Opening<P, M, C> {
    app: move app,
    keeper: move keeper,
    options: move options,
    inspector: move inspector,
  }
}

fn attachSplitDesk(window: &Window, wake: WakeHandle, tx: AppToEngineTx) -> () {
  let mut guard = window.desk.get().lock()
  let state = guard.getMut()
  state.appWake = Option<WakeHandle>.some(move wake)
  state.engineTx = Option<AppToEngineTx>.some(tx.clone())
  let mut queued = Intrinsic.replace(state.asks, List<ShellCommand>.make())
  drop guard
  while queued.length() != 0 {
    let ask = queued.remove(0)
    drop tx.send(AppToEngine.Shell { command: move ask })
  }
}

/// The platform ends with the window, and so does what answers a worker.
fn closed(window: &Window) -> () {
  let mut guard = window.desk.get().lock()
  let state = guard.getMut()
  state.platform = Option<PlatformClient>.None
  state.appWake = Option<WakeHandle>.None
  state.engineTx = Option<AppToEngineTx>.None
  state.nudge = Option<Nudge>.None
  state.closed = true
}

/// Opens `window` in a native 2-thread Engine + App split (or single-threaded on `wasm32`).
pub effect fn open<P: Program<M, C>, M, C: CommandSet<M, R>, ? R>(
  window: Window,
  fonts: &FontCollection,
  platform: Option<Launched>,
) -> i32
  ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut Allocator {
  let mut window = move window
  let mut opening = run opening<P, M, C>(&mut window, move platform)
  static if Intrinsic.targetArchitecture() != "wasm32" {
    let pendingJson = run opening.keeper.takePendingJson()
    let ext = ShellExtension {
      stylesheetCompiler: window.stylesheetCompiler,
      dialogs: List<Asked>.make(),
      notices: List<Notice>.make(),
      files: Intrinsic.replace(window.files, List<CarriedFile>.make()),
      treeKeeper: TreeKeeper.make(opening.keeper.on(), move pendingJson),
      titleBar: window.titleBar,
      titleBarHeight: window.titleBarHeight,
      controlsLeft: window.controlsLeft,
      controlsTop: window.controlsTop,
      windowDrag: false,
    }
    let waiter = run Waiter.make()
    let appWake = waiter.handle()
    let toAppPair = run UnboundedChannel.make<EngineToApp>(appWake.clone())
    let UnboundedPair<EngineToApp> { sender: appTx, receiver: appRx } = move toAppPair
    let wakeSlot = run EngineWakeSlot.make()
    let toEnginePair = run UnboundedChannel.make<AppToEngine>(WakeHandle.noop())
    let UnboundedPair<AppToEngine> { sender: engineTx, receiver: engineRx } = move toEnginePair
    let tx = AppToEngineTx.make(move engineTx, wakeSlot.clone())
    attachSplitDesk(&window, move appWake, tx.clone())
    let width = f64.toF32(window.width)
    let height = f64.toF32(window.height)
    let mut guard = run spawnEngineThread<ShellExtension>(
      fonts,
      run window.resources.take(),
      move opening.options,
      move opening.inspector,
      Intrinsic.replace(window.stylesheets, StyleAssets.make()),
      Intrinsic.replace(window.stylesheetUpdates, SheetWatch.make()),
      move ext,
      move engineRx,
      move appTx,
      move wakeSlot,
      tx.clone(),
    )
    let mut bridge = ProgramAppBridge<Hosted<P>, M, Run<C>> {
      desk: window.desk.clone(),
      keeper: move opening.keeper,
      greeted: false,
    }
    let appCode = run runSplitAppLoop<Hosted<P>, M, Run<C>, ProgramAppBridge<Hosted<P>, M, Run<C>>, OutOfMemoryError, R>(
      &mut opening.app,
      &mut bridge,
      move tx,
      move appRx,
      move waiter,
      width,
      height,
      true,
    )
    closed(&window)
    let engineCode = guard.finish()
    return if appCode != 0 { appCode } else { engineCode }
  } else {
    let mut content = ShellContent<Hosted<P>, M, Run<C>> {
      stylesheetCompiler: window.stylesheetCompiler,
      desk: window.desk.clone(),
      dialogs: List<Asked>.make(),
      notices: List<Notice>.make(),
      greeted: false,
      files: Intrinsic.replace(window.files, List<CarriedFile>.make()),
      keeper: move opening.keeper,
      titleBar: window.titleBar,
      titleBarHeight: window.titleBarHeight,
      controlsLeft: window.controlsLeft,
      controlsTop: window.controlsTop,
      windowDrag: false,
    }
    let code = run runWindowHostedWithSheetUpdates<
      ShellContent<Hosted<P>, M, Run<C>>,
      Hosted<P>,
      M,
      Run<C>,
      OutOfMemoryError,
      R
    >(
      &mut opening.app,
      fonts,
      run window.resources.take(),
      move opening.options,
      move opening.inspector,
      &mut content,
      Intrinsic.replace(window.stylesheets, StyleAssets.make()),
      Intrinsic.replace(window.stylesheetUpdates, SheetWatch.make()),
    )
    closed(&window)
    return code
  }
}

/// A command that runs on a worker, and the ticket the runtime knows it by.
struct Job<M> {
  ticket: u64,
  work: Worker<M>,
}

/// A worker job and where it leaves its command's message. The message waits in a slot
/// of its own so that the loop reads it without knowing what the message type can do.
struct Worker<M> {
  thread: Option<Background<bool>>,
  claim: Option<ClaimHandle>,
  slot: Arc<Mutex<Option<M>>>,
}

fn workerReady<M>(work: &Worker<M>) -> bool {
  if let Option<ClaimHandle>.Some { value: claim } = &work.claim {
    return claim.isDone()
  }
  if let Option<Background<bool>>.Some { value: thread } = &work.thread {
    return thread.ready()
  }
  return true
}

struct PooledWorkerWork<M, C> {
  command: C,
  hands: WindowShell,
  slot: Arc<Mutex<Option<M>>>,
}

impl<M: Transferable, C: Transferable> Transferable for PooledWorkerWork<M, C> {}

fn runPooledWorker<
  M: 'static + Transferable,
  C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>
>(
  work: PooledWorkerWork<M, C>,
  cancel: &CancellationToken,
) -> () {
  drop cancel
  let PooledWorkerWork<M, C> { command, hands, slot } = move work
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut shell = move hands
  let message = run Effect.catch<OutOfMemoryError>(
    CommandSet<M, &mut Shell | &mut Allocator>.execute(move command),
    exhausted<M>,
  )
    |> Effect.provideMut<Shell>(&mut shell)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut guard = slot.get().lock()
  let place = guard.getMut()
  place.* = Option<M>.some(move message)
}

/// How many commands run at once; the rest wait their turn.
const WORKERS: usize = 8

/// [`ShellContent`] that runs the program's commands on shared AppPool or fallback worker threads.
struct WorkerContent<A, M, C, F: fn<'static>(C, WindowShell, Option<WorkPoolHandle>, u32, Option<WakeHandle>) -> Option<Worker<M>>> {
  shell: ShellContent<A, M, C>,
  hands: WindowShell,
  jobs: List<Job<M>>,
  appPool: Option<WorkPoolHandle>,
  groupId: u32,
  wake: Option<WakeHandle>,
  /// Starts a command on a worker, or says None when no thread could start.
  start: F,
}

effect fn unstarted<M>(error: SpawnError) -> Option<Worker<M>> {
  drop error
  return Option<Worker<M>>.None
}

effect fn noWorker<M>(error: OutOfMemoryError) -> Option<Worker<M>> {
  drop error
  return Option<Worker<M>>.None
}

effect fn starting<
  M: 'static + Transferable,
  C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>
>(
  command: Run<C>,
  hands: WindowShell,
  pool: Option<WorkPoolHandle>,
  groupId: u32,
  wake: Option<WakeHandle>,
) -> Option<Worker<M>>
  ! OutOfMemoryError | SpawnError {
  let command = move command.command
  let mut allocator = Allocator.systemAllocatorProvider()
  let empty = run Mutex<Option<M>>.make(Option<M>.None)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let slot = run Arc<Mutex<Option<M>>>.make(move empty)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<WorkPoolHandle>.Some { value: appPool } = &pool {
    let work = PooledWorkerWork<M, C> {
      command: move command,
      hands: move hands,
      slot: slot.clone(),
    }
    let completionWake = match move wake {
      Option<WakeHandle>.Some { value } => move value
      Option<WakeHandle>.None => WakeHandle.noop()
    }
    let claim = run appPool.submitWith(
      groupId,
      move work,
      runPooledWorker<M, C>,
      run CancellationToken.make(),
      move completionWake,
    )
    return Option<Worker<M>>.some(
      Worker<M> {
        thread: Option<Background<bool>>.None,
        claim: Option<ClaimHandle>.some(move claim),
        slot: move slot,
      },
    )
  }
  let filled = slot.clone()
  let thread = run Background<bool>.startWithWake(
    || -> bool {
      let mut allocator = Allocator.systemAllocatorProvider()
      let mut shell = move hands
      let filled = move filled
      let message = run Effect.catch<OutOfMemoryError>(
        CommandSet<M, &mut Shell | &mut Allocator>.execute(move command),
        exhausted<M>,
      )
        |> Effect.provideMut<Shell>(&mut shell)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut guard = filled.get().lock()
      let place = guard.getMut()
      place.* = Option<M>.some(move message)
      return true
    },
    move wake,
  )
  return Option<Worker<M>>.some(
    Worker<M> {
      thread: Option<Background<bool>>.some(move thread),
      claim: Option<ClaimHandle>.None,
      slot: move slot,
    },
  )
}

/// Runs `command` on the shared `pool` when available, or on a fallback worker thread, with the shell `hands` to ask.
fn startWorker<
  M: 'static + Transferable,
  C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>
>(
  command: Run<C>,
  hands: WindowShell,
  pool: Option<WorkPoolHandle>,
  groupId: u32,
  wake: Option<WakeHandle>,
) -> Option<Worker<M>> {
  return run Effect.catch<OutOfMemoryError>(
    Effect.catch<SpawnError>(starting<M, C>(move command, move hands, move pool, groupId, move wake), unstarted<M>),
    noWorker<M>,
  )
}

effect fn exhausted<M>(error: OutOfMemoryError) -> M {
  drop error
  return Intrinsic.trap("silk-ui: a command ran out of memory on its worker")
}

impl<
  A: App<M, C>,
  M,
  C,
  F: fn<'static>(C, WindowShell, Option<WorkPoolHandle>, u32, Option<WakeHandle>) -> Option<Worker<M>>
> WindowContent<A, M, C> for WorkerContent<A, M, C, F> {
  effect fn files(self: &mut Self, loader: &mut Loader) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.files(&mut self.shell, &mut loader)
  }

  fn configure(self: &Self, options: &mut WindowOptions<'_>) -> () {
    return WindowContent<A, M, C>.configure(&self.shell, &mut options)
  }

  effect fn opened(self: &mut Self, platform: &mut HostPlatform, window: WindowId) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.opened(&mut self.shell, &mut platform, window)
  }

  effect fn attachRuntime(
    self: &mut Self,
    appPool: WorkPoolHandle,
    groupId: u32,
    wake: Nudge,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    drop wake
    self.appPool = Option<WorkPoolHandle>.some(move appPool)
    self.groupId = groupId
  }

  effect fn event(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    tree: &mut UiTree<'_>,
    event: &Event,
  ) -> bool
    ! WindowError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.event(&mut self.shell, &mut app, &mut tree, event)
  }

  effect fn update(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    tree: &mut UiTree<'_>,
    platform: &mut HostPlatform,
    window: WindowId,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.update(&mut self.shell, &mut app, &mut tree, &mut platform, window)
  }

  effect fn closing(self: &mut Self, app: &mut Runtime<A, M, C>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.closing(&mut self.shell, &mut app)
  }

  fn quitting(self: &Self, app: &Runtime<A, M, C>) -> bool {
    return WindowContent<A, M, C>.quitting(&self.shell, app)
  }

  fn runsCommands(self: &Self) -> bool {
    return true
  }

  effect fn poll(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    tree: &mut UiTree<'_>,
    time: f64,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut changed = run WindowContent<A, M, C>.poll(&mut self.shell, &mut app, &mut tree, time)
    let mut i: usize = 0
    while i < self.jobs.length() {
      if workerReady(&self.jobs.asSlice()[i].work) {
        let mut job = self.jobs.remove(i)
        if let Option<Background<bool>>.Some { value: thread } = move job.work.thread {
          let mut t = move thread
          drop t.poll()
        }
        drop job.work.claim
        let mut guard = job.work.slot.get().lock()
        let place = guard.getMut()
        let message = Intrinsic.replace(place.*, Option<M>.None)
        drop guard
        if let Option<M>.Some { value } = move message {
          if app.finish(job.ticket, move value) {
            changed = true
          }
        }
      } else {
        i = i + 1
      }
    }
    while self.jobs.length() < WORKERS && app.deferredOn(false) != 0 {
      let held = run app.takeWorkOn(false)
      let ticket = held.ticket
      let pool = match &self.appPool {
        Option<WorkPoolHandle>.Some { value } => Option<WorkPoolHandle>.some(value.clone())
        Option<WorkPoolHandle>.None => Option<WorkPoolHandle>.None
      }
      let wake = match &self.wake {
        Option<WakeHandle>.Some { value } => Option<WakeHandle>.some(value.clone())
        Option<WakeHandle>.None => Option<WakeHandle>.None
      }
      match self.start(move held.command, self.hands.onWorker(), move pool, self.groupId, move wake) {
        Option<Worker<M>>.Some { value } => run self.jobs.append(Job<M> { ticket: ticket, work: move value })
        Option<Worker<M>>.None => {
          drop app.abandon(ticket)
          fail WindowError.CreationFailed
        }
      }
    }
    return changed
  }
}

effect fn runWorkerSplit<
  P: Program<M, C>,
  M: 'static + Transferable,
  C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>,
  F: fn<'static>(Run<C>, WindowShell, Option<WorkPoolHandle>, u32, Option<WakeHandle>) -> Option<Worker<M>>
>(
  opening: Opening<P, M, C>,
  fonts: &FontCollection,
  window: &mut Window,
  start: F,
) -> i32
  ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Shell | &mut Allocator {
  let mut opening = move opening
  static if Intrinsic.targetArchitecture() != "wasm32" {
    let pendingJson = run opening.keeper.takePendingJson()
    let ext = ShellExtension {
      stylesheetCompiler: window.stylesheetCompiler,
      dialogs: List<Asked>.make(),
      notices: List<Notice>.make(),
      files: Intrinsic.replace(window.files, List<CarriedFile>.make()),
      treeKeeper: TreeKeeper.make(opening.keeper.on(), move pendingJson),
      titleBar: window.titleBar,
      titleBarHeight: window.titleBarHeight,
      controlsLeft: window.controlsLeft,
      controlsTop: window.controlsTop,
      windowDrag: false,
    }
    let waiter = run Waiter.make()
    let appWake = waiter.handle()
    let bridgeWake = waiter.handle()
    let toAppPair = run UnboundedChannel.make<EngineToApp>(appWake.clone())
    let UnboundedPair<EngineToApp> { sender: appTx, receiver: appRx } = move toAppPair
    let wakeSlot = run EngineWakeSlot.make()
    let toEnginePair = run UnboundedChannel.make<AppToEngine>(WakeHandle.noop())
    let UnboundedPair<AppToEngine> { sender: engineTx, receiver: engineRx } = move toEnginePair
    let tx = AppToEngineTx.make(move engineTx, wakeSlot.clone())
    attachSplitDesk(&window.*, move appWake, tx.clone())
    let width = f64.toF32(window.width)
    let height = f64.toF32(window.height)
    let mut guard = run spawnEngineThread<ShellExtension>(
      fonts,
      run window.resources.take(),
      move opening.options,
      move opening.inspector,
      Intrinsic.replace(window.stylesheets, StyleAssets.make()),
      Intrinsic.replace(window.stylesheetUpdates, SheetWatch.make()),
      move ext,
      move engineRx,
      move appTx,
      move wakeSlot,
      tx.clone(),
    )
    let shellBridge = ProgramAppBridge<Hosted<P>, M, Run<C>> {
      desk: window.desk.clone(),
      keeper: move opening.keeper,
      greeted: false,
    }
    let mut bridge = WorkerAppBridge<Hosted<P>, M, Run<C>, F> {
      shell: move shellBridge,
      hands: window.shell(),
      jobs: List<Job<M>>.make(),
      appPool: Option<WorkPoolHandle>.None,
      groupId: 0,
      wake: Option<WakeHandle>.some(move bridgeWake),
      start: move start,
    }
    let appCode = run runSplitAppLoop<
      Hosted<P>,
      M,
      Run<C>,
      WorkerAppBridge<Hosted<P>, M, Run<C>, F>,
      OutOfMemoryError,
      &mut Shell | &mut Allocator
    >(
      &mut opening.app,
      &mut bridge,
      move tx,
      move appRx,
      move waiter,
      width,
      height,
      true,
    )
    let engineCode = guard.finish()
    return if appCode != 0 { appCode } else { engineCode }
  } else {
    let shell = ShellContent<Hosted<P>, M, Run<C>> {
      stylesheetCompiler: window.stylesheetCompiler,
      desk: window.desk.clone(),
      dialogs: List<Asked>.make(),
      notices: List<Notice>.make(),
      greeted: false,
      files: Intrinsic.replace(window.files, List<CarriedFile>.make()),
      keeper: move opening.keeper,
      titleBar: window.titleBar,
      titleBarHeight: window.titleBarHeight,
      controlsLeft: window.controlsLeft,
      controlsTop: window.controlsTop,
      windowDrag: false,
    }
    let mut content = WorkerContent<Hosted<P>, M, Run<C>, F> {
      shell: move shell,
      hands: window.shell(),
      jobs: List<Job<M>>.make(),
      appPool: Option<WorkPoolHandle>.None,
      groupId: 0,
      wake: Option<WakeHandle>.None,
      start: move start,
    }
    return run runWindowHostedWithSheetUpdates<
      WorkerContent<Hosted<P>, M, Run<C>, F>,
      Hosted<P>,
      M,
      Run<C>,
      OutOfMemoryError,
      &mut Shell | &mut Allocator
    >(
      &mut opening.app,
      fonts,
      run window.resources.take(),
      move opening.options,
      move opening.inspector,
      &mut content,
      Intrinsic.replace(window.stylesheets, StyleAssets.make()),
      Intrinsic.replace(window.stylesheetUpdates, SheetWatch.make()),
    )
  }
}

/// [`open`] with the program's commands on worker threads (`AppPool` + `Waiter` wakeup).
pub effect fn openWithWorkers<
  P: Program<M, C>,
  M: 'static + Transferable,
  C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>
>(
  window: Window,
  fonts: &FontCollection,
  platform: Option<Launched>,
) -> i32
  ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Shell | &mut Allocator {
  let mut window = move window
  let opening = run opening<P, M, C>(&mut window, move platform)
  let code = run runWorkerSplit(move opening, fonts, &mut window, startWorker<M, C>)
  closed(&window)
  return code
}

effect fn windowFailed(error: WindowError) -> i32 {
  drop error
  StderrWriter.print("silk-ui: could not open a window (no display server?)\n", &())
  return 2
}

effect fn gpuFailed(error: GpuError) -> i32 {
  StderrWriter.print("silk-ui: GPU error {}\n", &.(error.code))
  return 2
}

/// Says that the program failed and returns exit code 2: the handler of a `catchAll` around
/// what opens the window.
pub effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("silk-ui: failed (tree, atlas, geometry or allocation)\n", &())
  return 2
}

/// [`open`], with a failure said on standard error and turned into exit code 2.
pub effect fn show<P: Program<M, C>, M, C: CommandSet<M, R>, ? R>(
  window: Window,
  fonts: &FontCollection,
  platform: Option<Launched>,
) -> i32
  ? R | &mut Allocator {
  return run Effect.catchAll(
    Effect.catch<GpuError>(
      Effect.catch<WindowError>(open<P, M, C, R>(move window, fonts, move platform), windowFailed),
      gpuFailed,
    ),
    failed,
  )
}

/// [`openWithWorkers`], with a failure said on standard error and turned into exit code 2.
pub effect fn showWithWorkers<
  P: Program<M, C>,
  M: 'static + Transferable,
  C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>
>(
  window: Window,
  fonts: &FontCollection,
  platform: Option<Launched>,
) -> i32
  ? &mut Shell | &mut Allocator {
  return run Effect.catchAll(
    Effect.catch<GpuError>(
      Effect.catch<WindowError>(openWithWorkers<P, M, C>(move window, fonts, move platform), windowFailed),
      gpuFailed,
    ),
    failed,
  )
}

/// Starts the app on its own thread and keeps the OS event loop on this one, which must be
/// the main thread. `app` gets what `run` takes as `platform`, and returns the exit code.
pub fn launch<F: 'static + once fn(Option<Launched>) -> i32 + Intrinsic.Detached + Transferable>(
  app: F,
) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(launchThread(move app), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

static if Intrinsic.targetOperatingSystem() == "darwin"
  || Intrinsic.targetOperatingSystem() == "linux" {
  effect fn noFonts(error: HostInputError) -> () {
    drop error
  }

  effect fn loadFonts(collection: &mut FontCollection) -> ()
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    let snapshot = run unsafe NativeHostInput.environmentSnapshot()
    let mut inputs = OsHostInput.make(move snapshot)
    drop run fontFiles.load(&mut collection, FontOptions.defaults())
      |> Effect.provideMut<HostInput>(&mut inputs)
  }

  /// The fonts installed on this machine, with the generic families (`system-ui`,
  /// `sans-serif`, `serif`, `monospace`) set up. An app that ships its own fonts makes a
  /// `FontCollection` of them instead.
  pub effect fn systemFonts() -> FontCollection
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut collection = FontCollection.make()
    run Effect.catch<HostInputError>(loadFonts(&mut collection), noFonts)
    return move collection
  }
}

static if Intrinsic.targetOperatingSystem() == "windows" {
  effect fn noFonts(error: HostInputError) -> () {
    drop error
  }

  effect fn loadFonts(collection: &mut FontCollection) -> ()
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    let mut inputs = run WindowsHostInput.capture()
    drop run fontFiles.load(&mut collection, FontOptions.defaults())
      |> Effect.provideMut<HostInput>(&mut inputs)
  }

  /// The fonts installed on this machine, with the generic families (`system-ui`,
  /// `sans-serif`, `serif`, `monospace`) set up. An app that ships its own fonts makes a
  /// `FontCollection` of them instead.
  pub effect fn systemFonts() -> FontCollection
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut collection = FontCollection.make()
    run Effect.catch<HostInputError>(loadFonts(&mut collection), noFonts)
    return move collection
  }
}

pub import ui_tree_window.platform_thread { Launched }
pub import font_collection.lib { FontCollection }
