//! The C memory functions of the WASI binding (ext/wasi_native), which keeps guest buffers in
//! native scratch. WASI itself is ext/wasi_host's, in Silk.
pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
pub unsafe extern "C" fn free(data: ?*mut u8) -> ()
@foreign(noCapture: .("dest", "source"))
pub unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, size: usize) -> *mut u8
