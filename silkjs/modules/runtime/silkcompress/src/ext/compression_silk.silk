  if kind == 1 || kind == 3 || kind == 5 { unsafe deflateStep(&mut j, &mut h, input, length, output, capacity) return () }
  if kind <= 7 { unsafe inflateStep(&mut j, &mut h, input, length, output, capacity) return () }
  if h.ended && (kind == 8 || kind == 9 || length == 0) { j.finished = true return () }
  if kind == 8 || kind == 9 { unsafe brotliStep(&mut j, &mut h, input, length, output, capacity) return () }
