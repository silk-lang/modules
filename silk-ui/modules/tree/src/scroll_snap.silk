//! CSS Scroll Snap 1: a snap container (`scroll-snap-type`) comes to rest where one of its
//! snap areas (`scroll-snap-align` on a descendant, grown by its `scroll-margin`) lines up
//! with the scrollport (shrunk by `scroll-padding`).
//!
//! A user scroll (wheel, keys, a scrollbar thumb, a compositor scroll) snaps once it has been
//! still for `IDLE`, with a smooth scroll. A wheel stream that slows down the way momentum does
//! (a fling) is aimed at once: the tree predicts where it would come to rest, scrolls smoothly
//! to the snap position there, and takes the rest of the fling. A user scroll never passes an
//! area with `scroll-snap-stop: always`: it stops on the first one past where it started.
//! A script scroll snaps its destination right away.
//! After a layout, a mandatory container that no longer rests on a snap position goes back to
//! one (Scroll Snap 1 §5.1).
import engine { UiTree }
import touch
import node { NO_INDEX }
import paint { borderBox, paddingBox }
import scrollbar { rangeOf, scrolls, usedOverflow }
import style { SNAP_NONE, SNAP_START, SNAP_END }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64

/// Seconds a user scroll stays still before it snaps: longer than the gap between wheel or
/// momentum events, short enough to feel like the end of the gesture.
pub const IDLE: f64 = 0.12

/// Below this gap, in seconds, wheel events are one stream whose speed is measured.
const STREAM: f64 = 0.05
/// Wheel events of a stream before a fling can be recognised.
const FLING_EVENTS: u32 = 4
/// The least speed, in pixels a second, of a fling.
const FLING_SPEED: f32 = 300.0

/// A container a user scrolled, and when.
pub struct SnapWait {
  pub slot: u32,
  pub id: u32,
  pub time: f64,
  /// The offset before the gesture, for `scroll-snap-stop: always`.
  pub fromX: f32,
  pub fromY: f32,
  /// The measured speed, in pixels a second, the speed before it, and events in the stream.
  pub vx: f32,
  pub vy: f32,
  pub speed: f32,
  pub events: u32,
  /// A fling is aimed: the rest of it goes nowhere.
  pub aimed: bool,
}

impl Copy for SnapWait {}

fn container(tree: &UiTree<'_>, slot: u32) -> bool {
  let s = &tree.node(slot).computed().scroll
  return s.snapsX() || s.snapsY()
}

fn waitOf(tree: &UiTree<'_>, slot: u32) -> usize {
  let id = tree.node(slot).id
  let mut i: usize = 0
  while i < tree.snapWaits.length() {
    let wait = tree.snapWaits.get(i)
    if wait.slot == slot && wait.id == id {
      return i
    }
    i = i + 1
  }
  return NO_INDEX
}

/// A user scrolled `slot` from (`fromX`, `fromY`): snap it once scrolling stops. `stream` is
/// a wheel scroll the tree made, whose fling it may aim.
pub effect fn userScrolled(tree: &mut UiTree<'_>, slot: u32, fromX: f32, fromY: f32, stream: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !tree.snapUsed || !container(&tree.*, slot) {
    return ()
  }
  let time = tree.input.time
  let id = tree.node(slot).id
  let x = tree.node(slot).scrollX()
  let y = tree.node(slot).scrollY()
  let at = waitOf(&tree.*, slot)
  if at == NO_INDEX {
    run tree.snapWaits.append(SnapWait { slot: slot, id: id, time: time, fromX: fromX, fromY: fromY,
      vx: 0.0, vy: 0.0, speed: 0.0, events: 1, aimed: false })
    return ()
  }
  let mut wait = tree.snapWaits.get(at)
  let gap = time - wait.time
  wait.time = time
  if !stream || gap <= 0.0 || gap > STREAM {
    wait.events = 1
    wait.vx = 0.0
    wait.vy = 0.0
    wait.speed = 0.0
    tree.snapWaits.set(at, wait)
    return ()
  }
  let dt = f64.toF32(gap)
  let mut vx = (x - fromX) / dt
  let mut vy = (y - fromY) / dt
  if wait.events > 1 {
    vx = (vx + wait.vx) * 0.5
    vy = (vy + wait.vy) * 0.5
  }
  let speed = f32.sqrt(vx * vx + vy * vy)
  let slowing = wait.events >= FLING_EVENTS && speed > FLING_SPEED && speed < wait.speed
    && vx * wait.vx >= 0.0 && vy * wait.vy >= 0.0
  // Momentum decays exponentially: the speeds of two events give its time constant, and the
  // distance left is the speed times it.
  let tau: f32 = if slowing { f32.max(0.05, f32.min(1.0, dt / f32.log(wait.speed / speed))) } else { 0.0 }
  wait.events = wait.events + 1
  wait.vx = vx
  wait.vy = vy
  wait.speed = speed
  if slowing && !wait.aimed {
    wait.aimed = true
    tree.snapWaits.set(at, wait)
    let target = run aimedAt(&tree.*, slot, x + vx * tau, y + vy * tau, wait.fromX, wait.fromY)
    if f32.abs(target[0] - x) >= 0.5 || f32.abs(target[1] - y) >= 0.5 {
      run cssom_view.snapTo(&mut tree.*, slot, target[0], target[1], true)
    }
    return ()
  }
  tree.snapWaits.set(at, wait)
}

/// Whether a wheel scroll by (`dx`, `dy`) goes on with an aimed fling, so it leaves the smooth
/// scroll to the snap position running.
pub fn continuesFling(tree: &UiTree<'_>, dx: f32, dy: f32) -> bool {
  let mut i: usize = 0
  while i < tree.snapWaits.length() {
    let wait = tree.snapWaits.get(i)
    if wait.aimed && tree.input.time - wait.time <= IDLE && dx * wait.vx >= 0.0 && dy * wait.vy >= 0.0 {
      return true
    }
    i = i + 1
  }
  return false
}

/// Whether a wheel scroll of `slot` by (`dx`, `dy`) is the rest of an aimed fling, which goes
/// nowhere. A scroll the other way, or after a pause, ends the fling.
pub fn absorbs(tree: &mut UiTree<'_>, slot: u32, dx: f32, dy: f32) -> bool {
  if !tree.snapUsed || tree.snapWaits.length() == 0 {
    return false
  }
  let at = waitOf(&tree.*, slot)
  if at == NO_INDEX {
    return false
  }
  let mut wait = tree.snapWaits.get(at)
  if !wait.aimed {
    return false
  }
  let gap = tree.input.time - wait.time
  if gap > IDLE || dx * wait.vx < 0.0 || dy * wait.vy < 0.0 {
    wait.aimed = false
    wait.events = 0
    tree.snapWaits.set(at, wait)
    return false
  }
  wait.time = tree.input.time
  tree.snapWaits.set(at, wait)
  return true
}

/// Whether a user scroll waits to snap: the host keeps drawing frames until it has.
/// A finger holding a pan still needs no frames: the wait resumes when it lifts.
pub fn waiting(tree: &UiTree<'_>) -> bool {
  return tree.snapWaits.length() != 0 && tree.touch.gesture != touch.GESTURE_PAN
}

/// The snapped destination of a scroll of `slot` to (`x`, `y`), or (`x`, `y`) when `slot` is
/// not a snap container or no snap position is close enough.
pub effect fn snapped(tree: &UiTree<'_>, slot: u32, x: f32, y: f32) -> [f32; 2]
  ! OutOfMemoryError
  ? &mut Allocator {
  return run choose(tree, slot, x, y, x, y)
}

/// The destination of a user scroll of `slot` from (`fromX`, `fromY`) that would come to rest at
/// (`x`, `y`): the nearest snap position, unless it passes an area with `scroll-snap-stop:
/// always` first.
pub effect fn aimedAt(tree: &UiTree<'_>, slot: u32, x: f32, y: f32, fromX: f32, fromY: f32) -> [f32; 2]
  ! OutOfMemoryError
  ? &mut Allocator {
  return run choose(tree, slot, x, y, fromX, fromY)
}

/// Whether `candidate` lies past `from` on the way to `to`, and closer to `from` than `stop`.
fn passes(candidate: f32, from: f32, to: f32, stop: f32) -> bool {
  if to > from + 0.5 { return candidate > from + 0.5 && candidate < to - 0.5 && candidate < stop }
  if to < from - 0.5 { return candidate < from - 0.5 && candidate > to + 0.5 && candidate > stop }
  return false
}

effect fn choose(tree: &UiTree<'_>, slot: u32, x: f32, y: f32, fromX: f32, fromY: f32) -> [f32; 2]
  ! OutOfMemoryError
  ? &mut Allocator {
  if !tree.snapUsed || !container(tree, slot) {
    return [x, y]
  }
  let index = fragmentOf(tree, slot)
  if index == NO_INDEX {
    return [x, y]
  }
  let c = tree.node(slot).computed().*
  let f = tree.visualFragment(index)
  let port = c.scroll.port(paddingBox(&f))
  let range = rangeOf(&c, &f)
  let mandatory = c.scroll.snapMandatory()
  let snapX = c.scroll.snapsX() && scrolls(usedOverflow(&c, true))
  let snapY = c.scroll.snapsY() && scrolls(usedOverflow(&c, false))
  // Positions are found at the current offset; a candidate is that offset plus the distance
  // its area has to move to line up with the port.
  let atX = tree.node(slot).scrollX()
  let atY = tree.node(slot).scrollY()
  let mut best = [x, y]
  let mut bestDistance = [f32.INFINITY, f32.INFINITY]
  // The first `scroll-snap-stop: always` position the scroll passes, per axis.
  let mut stop = [if x > fromX { f32.INFINITY } else { -f32.INFINITY }, if y > fromY { f32.INFINITY } else { -f32.INFINITY }]
  let mut stopped = [false, false]
  let mut stack = List<u32>.make()
  let mut children = List<u32>.make()
  run tree.childSlots(slot, &mut children)
  run pushAll(&mut stack, &children)
  while stack.length() != 0 {
    let last = stack.length() - 1
    let item = stack.get(last)
    stack.truncate(last)
    let ic = tree.node(item).computed().*
    let at = fragmentOf(tree, item)
    if at != NO_INDEX {
      let ax = ic.scroll.alignX()
      let ay = ic.scroll.alignY()
      if ax != SNAP_NONE || ay != SNAP_NONE {
        let b = borderBox(&tree.visualFragment(at))
        let m = ic.scroll.margin
        let area = Rect<f32>.new(b.xMin - m.left, b.yMin - m.top, b.xMax + m.right, b.yMax + m.bottom)
        if snapX && ax != SNAP_NONE {
          let candidate = range.clampX(atX + shift(ax, area.xMin, area.xMax, port.xMin, port.xMax))
          if ic.scroll.snapStop() && passes(candidate, fromX, x, stop[0]) {
            stop[0] = candidate
            stopped[0] = true
          }
          let distance = f32.abs(candidate - x)
          if distance < bestDistance[0] {
            bestDistance[0] = distance
            best[0] = candidate
          }
        }
        if snapY && ay != SNAP_NONE {
          let candidate = range.clampY(atY + shift(ay, area.yMin, area.yMax, port.yMin, port.yMax))
          if ic.scroll.snapStop() && passes(candidate, fromY, y, stop[1]) {
            stop[1] = candidate
            stopped[1] = true
          }
          let distance = f32.abs(candidate - y)
          if distance < bestDistance[1] {
            bestDistance[1] = distance
            best[1] = candidate
          }
        }
      }
    }
    // A nested scroll container snaps its own descendants.
    if !(scrolls(usedOverflow(&ic, true)) || scrolls(usedOverflow(&ic, false))) {
      run tree.childSlots(item, &mut children)
      run pushAll(&mut stack, &children)
    }
  }
  // Proximity snaps only near a position: within a third of the scrollport.
  if !mandatory {
    if bestDistance[0] > port.width() / 3.0 { best[0] = x }
    if bestDistance[1] > port.height() / 3.0 { best[1] = y }
  }
  // An `always` area is a snap position the scroll may not pass, whatever the strictness.
  if stopped[0] && ((x > fromX && best[0] > stop[0]) || (x < fromX && best[0] < stop[0])) { best[0] = stop[0] }
  if stopped[1] && ((y > fromY && best[1] > stop[1]) || (y < fromY && best[1] < stop[1])) { best[1] = stop[1] }
  return best
}

effect fn pushAll(stack: &mut List<u32>, items: &List<u32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i = items.length()
  while i > 0 {
    i = i - 1
    run stack.append(items.get(i))
  }
}

fn fragmentOf(tree: &UiTree<'_>, slot: u32) -> usize {
  let node = tree.node(slot)
  if !node.live {
    return NO_INDEX
  }
  return if node.css < tree.fragmentOf.length() { tree.fragmentOf.get(node.css) } else { NO_INDEX }
}

/// How far the scroll offset moves so that the area's `align` edge meets the port's.
fn shift(align: u8, min: f32, max: f32, portMin: f32, portMax: f32) -> f32 {
  if align == SNAP_START {
    return min - portMin
  }
  if align == SNAP_END {
    return max - portMax
  }
  return (min + max) * 0.5 - (portMin + portMax) * 0.5
}

/// Snaps the containers whose user scroll has been still for `IDLE`, and puts mandatory
/// containers that a layout moved off a snap position back on one.
pub effect fn settle(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !tree.snapUsed {
    return ()
  }
  let now = tree.input.time
  let mut i: usize = 0
  // Fingers or a flick still move the scroll: it snaps once they let go.
  if touch.holding(&tree.*) {
    while i < tree.snapWaits.length() {
      let mut wait = tree.snapWaits.get(i)
      wait.time = now
      tree.snapWaits.set(i, wait)
      i = i + 1
    }
    return ()
  }
  while i < tree.snapWaits.length() {
    let wait = tree.snapWaits.get(i)
    let gone = u32.toUsize(wait.slot) >= tree.nodes.length() || !tree.node(wait.slot).live
      || tree.node(wait.slot).id != wait.id
    if gone {
      drop tree.snapWaits.remove(i)
    } else if tree.thumbSlot == wait.slot || now - wait.time < IDLE || cssom_view.animatesSlot(&tree.*, wait.slot) {
      i = i + 1
    } else {
      drop tree.snapWaits.remove(i)
      drop run snapFrom(&mut tree, wait.slot, wait.fromX, wait.fromY)
    }
  }
}

/// After a layout: a mandatory snap container that rests off every snap position, and is not
/// being scrolled, moves to the nearest one at once.
pub effect fn resnap(tree: &mut UiTree<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !tree.snapUsed || tree.stats.layoutSkipped {
    return false
  }
  let mut moved = false
  let mut slot: u32 = 0
  while u32.toUsize(slot) < tree.nodes.length() {
    let node = tree.node(slot)
    if node.live && node.computed().scroll.snapMandatory() && container(&tree.*, slot) && !busy(&tree.*, slot) {
      moved = (run snapNow(&mut tree, slot, false)) || moved
    }
    slot = slot + 1
  }
  return moved
}

fn busy(tree: &UiTree<'_>, slot: u32) -> bool {
  if tree.thumbSlot == slot {
    return true
  }
  let mut i: usize = 0
  while i < tree.snapWaits.length() {
    if tree.snapWaits.get(i).slot == slot {
      return true
    }
    i = i + 1
  }
  return cssom_view.animatesSlot(tree, slot)
}

effect fn snapFrom(tree: &mut UiTree<'_>, slot: u32, fromX: f32, fromY: f32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let x = tree.node(slot).scrollX()
  let y = tree.node(slot).scrollY()
  let target = run choose(&tree.*, slot, x, y, fromX, fromY)
  if f32.abs(target[0] - x) < 0.5 && f32.abs(target[1] - y) < 0.5 {
    return false
  }
  run cssom_view.snapTo(&mut tree.*, slot, target[0], target[1], true)
  return true
}

effect fn snapNow(tree: &mut UiTree<'_>, slot: u32, smooth: bool) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let x = tree.node(slot).scrollX()
  let y = tree.node(slot).scrollY()
  let target = run snapped(&tree.*, slot, x, y)
  if f32.abs(target[0] - x) < 0.5 && f32.abs(target[1] - y) < 0.5 {
    return false
  }
  run cssom_view.snapTo(&mut tree.*, slot, target[0], target[1], smooth)
  return true
}

import cssom_view
import silk.num.u32
