//! Per-function hotness for an optional tier above the interpreter. Each
//! FunctionBytecode counts its entries down from HOT_ENTRY_BUDGET; at zero,
//! exhausted hands it to RuntimeState.hotPending when an embedder set
//! hotFunctions, and the next interrupt poll reports it (js_interrupts.handle).
//! Where entries are counted, and why back edges are not: docs/jit/tier-seam.md.
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.u32
import js_heap { HeapCell, HeapHeader }
import js_value { ValueBits }
import js_core_types { FunctionBytecode, ContextState, RuntimeState }

/// Counts one entry of bytecode, a FunctionBytecode cell.
@inlineAlways
pub unsafe fn enter(bytecode: *mut HeapHeader) -> () {
  let mut anchor = () let code = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut anchor, bytecode)
  let left = u32.wrappingSubtract(code.hotness, 1)
  code.hotness = left
  drop code
  if left == 0 { unsafe exhausted(bytecode) }
}
/// bytecode used up its budget. With no handler it starts again. Otherwise it
/// waits in hotPending for the next poll and is not counted down again for
/// 2^32 entries; while another function waits there, it retries at its next entry.
@inlineNever
unsafe fn exhausted(bytecode: *mut HeapHeader) -> () {
  let mut anchor = ()
  let realm = (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)).realm
  let runtime = (unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)).runtime
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let handled = state.hotFunctions.callback.isSome()
  let waiting = match state.hotPending { ValueBits.FunctionBytecode { .. } => true _ => false }
  let mut budget = state.hotEntryBudget
  if handled && waiting { budget = 1 }
  else if handled {
    state.hotPending = unsafe (ValueBits.FunctionBytecode { reference: bytecode }).retained()
    state.compiled.loopPc = u32.MAX
    budget = u32.MAX
  }
  let first = state.contexts.first
  drop state
  let mut codeAnchor = () let code = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut codeAnchor, bytecode)
  code.hotness = budget
  drop code
  if handled && !waiting { unsafe pollSoon(first) }
}
/// js_interrupts.forcePolls, which this module cannot import: the next backward
/// jump or call in every context polls.
unsafe fn pollSoon(first: ?*mut HeapHeader) -> () {
  let mut anchor = ()
  let mut cursor = first
  while let Option<*mut HeapHeader>.Some { value: context } = Pointer.nonNullMut<HeapHeader>(cursor) {
    let data = unsafe HeapCell.payloadMut<ContextState, ()>(&mut anchor, context)
    data.interruptCounter = 1 cursor = data.nextContext
  }
}
/// Budgets at or above this are a reported function's (exhausted parks it at u32.MAX).
pub const REPORTED_FLOOR: u32 = 2147483648
/// An interrupt poll on a backward jump landed at loop header pc in a frame of bytecode, which
/// is therefore running a long loop: report it now with pc (CompiledTable.loopPc), as exhausted
/// does, unless no handler is set or another function waits (the next poll in it retries).
/// An unlinked function already reported is not reported again; a linked one is reported for
/// a header it has no OSR entry for. Polls are at most every JS_INTERRUPT_COUNTER_INIT back
/// edges and calls, so this costs nothing on the paths that count entries (docs/jit/osr.md).
@inlineNever
pub unsafe fn loopPoll(bytecode: *mut HeapHeader, pc: u32, linked: bool) -> () {
  let mut anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let realm = code.realm
  let reported = code.hotness >= REPORTED_FLOOR
  drop code
  if reported && !linked { return () }
  let runtime = (unsafe HeapCell.payload<ContextState, ()>(&anchor, realm)).runtime
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  if !state.hotFunctions.callback.isSome() { return () }
  match state.hotPending { ValueBits.FunctionBytecode { .. } => { return () } _ => () }
  state.hotPending = unsafe (ValueBits.FunctionBytecode { reference: bytecode }).retained()
  state.compiled.loopPc = pc
  let first = state.contexts.first
  drop state
  if !linked {
    let mut codeAnchor = () let parked = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut codeAnchor, bytecode)
    parked.hotness = u32.MAX
    drop parked
  }
  unsafe pollSoon(first)
}
