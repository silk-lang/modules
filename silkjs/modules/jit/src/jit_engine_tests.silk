const GENERIC: &[u8] = b"function kind(x){var k=0;if(x==null)k=k+1;if(typeof x===\"number\")k=k+2;if(typeof x===\"string\")k=k+4;if(typeof x===\"boolean\")k=k+8;if(x===undefined)k=k+16;if(x===null)k=k+32;if(x)k=k+64;if(!x)k=k+128;return k}function pick(a,b){var r=a??b;if(r?.length)return r.length;return r?1:0}function chain(o){var s=0;if(o&&o.n)s=s+o.n;return s+(o||{n:7}).n}function shuf(o,v){o.a=o.b=v;o.c+=1;return o.a+o.b+o.c}function P(x,y){this.x=x;this.y=y}function store(o,n){o.v=n;return n}function same(a,b){if(a==b)return 1;if(a!=null)return 2;return 3}function ne(a,b){return a!=b?1:0}function strict(a,b){return a===b?5:(a!==b?7:9)}function callee(k){try{return k+1}catch(e){return 0}}function caller(o,k){return o.m(k)+callee(k)}var W=[\"\",\"ab\",[1,2],null,undefined,\"xyz\"];var V=[0,1,-0,NaN,2.5,\"\",\"s\",\"abc\",true,false,null,undefined,{},[],Infinity,-1];var H={m:function(k){return k*2}};var S={set v(n){this.w=n}};function phase(r){var t=0;for(var q=0;q<r;q++)for(var i=0;i<V.length;i++){var a=V[i],b=V[(i*7)%V.length];t=(t*31+kind(a)+pick(W[i%6],W[(i+1)%6])*3+chain(i%3?{n:i}:null))%1000003;var o={a:0,b:0,c:i};t=(t+shuf(o,i))%1000003;var p=new P(i,q);t=(t+p.x+p.y+store(i&1?S:{},i)+same(a,b)*3+ne(a,b)*11+strict(a,b)+caller(H,i))%1000003}return t}"

/// Tag tests (== null, typeof, ??, ?., truthiness of any value, which is ToBoolean inline and
/// never deoptimizes), stack shuffles, and sites that deoptimize at first: == and != that
/// coerce, and a call to a callee with a try block (=== on any values compares inline and
/// stays compiled). A store whose site last added
/// its property (store's o.v, which also meets a setter) takes the helper and steps from
/// the first compilation, and does not deoptimize. Recompiled, the generic sites stop
/// deoptimizing. Checksums are node's.
unsafe effect fn exerciseGeneric<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, GENERIC)
  // Re-enter phase so its compiled entry and the callees reached from it both warm up.
  // Successive branches in kind and chain can each need their own generic path.
  let warm = run unsafe evaluate(&mut engine, context, b"for(var round=0;round<4;round++) phase(60)")
  run Testing.expect(isNumber(warm, 844324.0), "tag tests, shuffles and generic sites compute what the interpreter does")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.compiledFunctions >= 10 && engine.services.jit.waited == 2 && engine.services.jit.recompiled == 2, "each unlinked entry waits and recompiles")
  run Testing.expect(engine.services.jit.refused == 0 && engine.services.jit.unlinked == 2 && engine.services.jit.deopts == 16, "both entries reach their eight-deopt limit; truthiness of any value never deopts")
  let deopts = engine.services.jit.deopts
  let runs = engine.services.jit.runs
  let again = run unsafe evaluate(&mut engine, context, b"phase(20)")
  run Testing.expect(isNumber(again, 501789.0), "the same answers once recompiled")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.deopts == deopts && engine.services.jit.recompiled == 2 && engine.services.jit.runs > runs + 1000, "the recompiled entries keep running without further deopts or recompilations")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}
