unsafe extern "C" fn ttyname_r(fd: i32, buffer: *mut u8, size: usize) -> i32
unsafe extern "C" fn tcgetattr(fd: i32, termios: *mut u8) -> i32
unsafe extern "C" fn tcsetattr(fd: i32, how: i32, termios: *const u8) -> i32
unsafe extern "C" fn cfmakeraw(termios: *mut u8) -> ()
unsafe extern "C" fn unlink(path: *const u8) -> i32
unsafe extern "C" fn chmod(path: *const u8, mode: u32) -> i32
unsafe extern "C" fn socket(domain: i32, kind: i32, protocol: i32) -> i32
unsafe extern "C" fn bind(fd: i32, address: *const u8, length: u32) -> i32
unsafe extern "C" fn connect(fd: i32, address: *const u8, length: u32) -> i32
unsafe extern "C" fn listen(fd: i32, backlog: i32) -> i32
unsafe extern "C" fn accept(fd: i32, address: ?*mut u8, length: ?*mut u32) -> i32
unsafe extern "C" fn shutdown(fd: i32, how: i32) -> i32
unsafe extern "C" fn setsockopt(fd: i32, level: i32, option: i32, value: *const u8, length: u32) -> i32
unsafe extern "C" fn getsockopt(fd: i32, level: i32, option: i32, value: *mut u8, length: *mut u32) -> i32
