//! Opt-in runtime CSS compilation. Hosts that only consume compiled sheets do not call this factory.
import style_compiler { Compiler }
import svg_css.compile { Options, CompileError }
import svg_css.compile
import svg_css.tokens { CssError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }

pub fn runtime() -> Compiler { return unsafe Compiler.fromCallback(compileText) }

effect fn compiled(source: ?[*]const u8, length: usize) -> Bytes
  ! CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut input = run Bytes.zeroed(length)
  let into = input.asMutSlice()
  if let Option<[*]const u8>.Some { value } = Pointer.nonNullMany(source) {
    let mut i: usize = 0
    while i < length {
      into[i] = unsafe Pointer.read(unsafe Pointer.at(value, i))
      i = i + 1
    }
  }
  let sheet = run compile.compile(input.asSlice(), &Options.make())
  return run sheet.encode()
}

export "C" fn compileText(source: ?[*]const u8, length: usize, output: ?*mut u8) -> u32 {
  if length > 67108864 || Pointer.isNull(output) || (length != 0 && Pointer.nonNullMany(source).isNone()) { return 0 }
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(compiled(source, length)) |> Effect.provideMut<Allocator>(&mut allocator)
  let bytes = match move result {
    Result.Success { value } => move value
    Result.Failure { .. } => { return 0 }
  }
  let pointer = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(output)
  let target = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Bytes>(pointer)
  let mut anchor = ()
  let into = unsafe Pointer.borrowMut(&mut anchor, target)
  into.* = move bytes
  return 1
}
