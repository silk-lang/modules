/// libuv's uv_udp_set_source_membership.
pub export "C" fn uv_udp_set_source_membership(udp: *mut u8, group: *const u8, interfaceAddress: ?*const u8, source: *const u8, which: i32) -> i32 {
  let mut groupStorage: [u64; 4] = [0; 4]
  let mut sourceStorage: [u64; 4] = [0; 4]
