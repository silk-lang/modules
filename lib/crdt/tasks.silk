import silk.cli.command { Command, CommandLine }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }

union Tasks {
  Check,
  Test,
  Ci,
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("crdt", "Check, test, and build the CRDT packages")
      |> Command.variant("Check", "Check all CRDT packages")
      |> Command.variant("Test", "Run all CRDT package tests")
      |> Command.variant("Ci", "Run check, test, and build for all CRDT packages")
  }
}

effect fn checkAll() -> ()
  ! TaskError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let packages = [
    "crdt-btree",
    "crdt-core",
    "crdt-sync",
    "crdt-store-sqlite",
    "crdt-server",
    "crdt-bench",
  ]
  let mut i = usize.ZERO
  while i < packages.length {
    run Task.silk(&["check", "--package", packages[i]])
    i = i + usize.ONE
  }
}

effect fn testAll() -> ()
  ! TaskError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let manifests = [
    "modules/btree/silk.toml",
    "modules/core/silk.toml",
    "modules/sync/silk.toml",
    "modules/store-sqlite/silk.toml",
  ]
  let mut i = usize.ZERO
  while i < manifests.length {
    run Task.silk(&["test", "--manifest-path", manifests[i], "--root", "src/tests.silk"])
    i = i + usize.ONE
  }
}

effect fn buildAll() -> ()
  ! TaskError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let packages = ["crdt-server", "crdt-bench"]
  let mut i = usize.ZERO
  while i < packages.length {
    run Task.silk(&["build", "--package", packages[i]])
    i = i + usize.ONE
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Check => run checkAll()
      Tasks.Test => run testAll()
      Tasks.Ci => {
        run checkAll()
        run testAll()
        run buildAll()
      }
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
