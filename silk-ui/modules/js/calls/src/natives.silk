//! Silk functions an application exports to its JavaScript: `import { add } from
//! "../silk/native.silk"` in the app, `__ui.native(id, ...args)` underneath. silkui generates a
//! dispatcher for the project's exported modules ([`Exports`], [`serve`]) into the host, which
//! hands it to the bridge as [`Natives`]. The calls are engine-neutral: arguments arrive as
//! [`Arg`] values and the answer leaves as a [`Reply`].
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.text.string { String }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.num.i64
import silk.num.u64
import silk.num.u8
import lib { Arg }
import silk.concurrency.thread { Transferable }

/// What a Silk function gave back to JavaScript.
pub union Reply {
  Nothing,
  Number { pub value: f64 },
  Flag { pub value: bool },
  Text { pub value: String },
  /// The arguments did not fit the function: JavaScript gets a `TypeError` with `message`.
  TypeError { pub message: String },
  /// The function failed: JavaScript gets an `Error` with `message`.
  Failed { pub message: String },
  OutOfMemory,
}

/// One call of an exported function: its id (`@silkui/vite` hashes `module.name`), its
/// arguments, and once it ran, its reply.
pub struct NativeCall {
  pub id: u32,
  pub args: List<Arg>,
  pub reply: Reply,
}

// A call owns its arguments and reply, so a background thread can run it.
impl Transferable for NativeCall {}

/// The generated dispatcher: runs function `id` with `args` and writes what it gave back.
pub interface Exports {
  effect fn dispatch(self: &Self, id: u32, args: &[Arg], reply: &mut Reply) -> ()
    ! OutOfMemoryError
    ? &mut Allocator
}

/// Where the bridge finds an application's exported functions: off in an app without any.
pub struct Natives {
  active: bool,
  callback: extern "C" fn(?*mut u8) -> (),
}

impl Copy for Natives {}

impl Transferable for Natives {}

export "C" fn noNatives(call: ?*mut u8) -> () as "ui_js_calls_no_natives" {
  drop call
}

impl Natives {
  pub fn off() -> Natives {
    return Natives { active: false, callback: noNatives }
  }

  /// The dispatcher `callback`: an `export "C"` function that passes its argument to [`serve`].
  pub unsafe fn fromCallback(callback: extern "C" fn(?*mut u8) -> ()) -> Natives {
    return Natives { active: true, callback: callback }
  }

  pub fn enabled(self: &Self) -> bool {
    return self.active
  }

  /// Runs `call`, from any thread: the dispatcher shares nothing between calls.
  pub effect fn call(self: &Self, call: &mut NativeCall) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.active {
      call.reply = Reply.TypeError {
        message: run String.copy("this app exports no Silk functions"),
      }
      return ()
    }
    let raw = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(
      unsafe Intrinsic.pointerReinterpret<*mut NativeCall, *mut u8>(
        Pointer.fromMutRef<NativeCall>(&mut call.*),
      ),
    )
    unsafe self.callback(raw)
  }
}

/// Runs the call at `raw` (a [`NativeCall`]) through `exports`. Only a [`Natives`] callback
/// calls this, with the pointer it was given.
pub unsafe fn serve<E: Exports>(exports: &E, raw: ?*mut u8) -> () {
  let mut anchor: u8 = 0
  let call = unsafe Pointer.borrowMut<u8, NativeCall>(
    &mut anchor,
    unsafe Intrinsic.pointerReinterpret<*mut u8, *mut NativeCall>(
      unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(raw),
    ),
  )
  let args = Intrinsic.replace(call.args, List<Arg>.make())
  let mut reply = Reply.Nothing
  let mut allocator = Allocator.systemAllocatorProvider()
  let ran = run Effect.result(exports.dispatch(call.id, args.asSlice(), &mut reply))
    |> Effect.provideMut<Allocator>(&mut allocator)
  call.reply = match move ran {
    Result<(), OutOfMemoryError>.Success { .. } => move reply
    Result<(), OutOfMemoryError>.Failure { .. } => Reply.OutOfMemory
  }
  call.args = move args
}

/// Whether `args` fit `kinds`, one letter per parameter: `n` a number, `b` a boolean, `s` a
/// string. Missing arguments do not fit; extra ones are ignored, as JavaScript does.
pub fn accepts(args: &[Arg], kinds: string) -> bool {
  let letters = String.utf8Bytes(kinds)
  if args.length < letters.length {
    return false
  }
  let mut at: usize = 0
  while at < letters.length {
    let fits = match &args[at] {
      Arg.Number { .. } => letters[at] == 110
      Arg.Flag { .. } => letters[at] == 98
      Arg.Text { .. } => letters[at] == 115
      Arg.Nothing => false
    }
    if !fits {
      return false
    }
    at = at + 1
  }
  return true
}

/// Argument `at` as a number; 0 for anything else.
pub fn number(args: &[Arg], at: usize) -> f64 {
  return args[at].number()
}

/// Argument `at` as a boolean.
pub fn flag(args: &[Arg], at: usize) -> bool {
  return args[at].truthy()
}

/// Argument `at` as text; empty for anything else.
pub fn text<'a>(args: &'a [Arg], at: usize) -> string<'a> {
  return match &args[at] {
    Arg.Text { value } => String.view(&value)
    _ => ""
  }
}

/// Argument `at`, decimal text the importing module made from a `bigint`, as an `i64`.
pub fn signed(args: &[Arg], at: usize) -> i64 {
  let digits = String.utf8Bytes(text(args, at))
  let negative = digits.length > 0 && digits[0] == 45
  let mut value: i64 = 0
  let mut i: usize = if negative {
    1
  } else {
    0
  }
  while i < digits.length {
    value = value * 10 - u8.toI64(digits[i] - 48)
    i = i + 1
  }
  return if negative {
    value
  } else {
    0 - value
  }
}

/// Argument `at`, decimal text the importing module made from a `bigint`, as a `u64`.
pub fn unsigned(args: &[Arg], at: usize) -> u64 {
  let digits = String.utf8Bytes(text(args, at))
  let mut value: u64 = 0
  let mut i: usize = 0
  while i < digits.length {
    value = value * 10 + u8.toU64(digits[i] - 48)
    i = i + 1
  }
  return value
}

/// A reply with `value`'s decimal text, which the importing module turns into a `bigint`.
pub effect fn fromSigned(value: i64) -> Reply
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 0 {
    return run fromUnsigned(i64.toU64(value))
  }

  // The magnitude of the most negative value does not fit an i64.
  let magnitude = i64.toU64(0 - (value + 1)) + 1
  let mut out = run String.copy("-")
  run String.appendOwned(&mut out, run decimal(magnitude))
  return Reply.Text { value: move out }
}

pub effect fn fromUnsigned(value: u64) -> Reply
  ! OutOfMemoryError
  ? &mut Allocator {
  return Reply.Text { value: run decimal(value) }
}

effect fn decimal(value: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20]
  let mut count: usize = 0
  let mut rest = value
  while count == 0 || rest > 0 {
    digits[19 - count] = u64.toU8(rest % 10) + 48
    rest = rest / 10
    count = count + 1
  }
  let mut out = String.make()
  run String.append(
    &mut out,
    unsafe String.fromUtf8Unchecked(Slice.view<u8>(&digits, 20 - count, count)),
  )
  return move out
}

/// A `TypeError` reply naming the parameters the function takes: `add(a: number, b: number)`.
pub effect fn wrongArguments(signature: string) -> Reply
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut message = run String.copy("expected ")
  run String.append(&mut message, signature)
  return Reply.TypeError { message: move message }
}

/// A `Failed` reply for function `name`, which failed with `error`, an error named `kind`.
pub effect fn failed<E>(name: string, kind: string, error: E) -> Reply
  ! OutOfMemoryError
  ? &mut Allocator {
  drop error
  let mut message = run String.copy(name)
  run String.append(&mut message, " failed: ")
  run String.append(&mut message, kind)
  return Reply.Failed { message: move message }
}

/// A text reply with a copy of `value`.
pub effect fn copied(value: string) -> Reply
  ! OutOfMemoryError
  ? &mut Allocator {
  return Reply.Text { value: run String.copy(value) }
}
