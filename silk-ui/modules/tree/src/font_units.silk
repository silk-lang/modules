//! Font bases shared by the typed length converter and parsed paint grammars.
import engine { UiTree }
import engine
import node { NONE }
import mutation { NodeKind, StyleState }
import style_sheets
import style_inherit
import font_features
import properties.catalog { Property }
import properties.values { Declaration }
import properties.keywords { Keyword }
import properties.convert
import silk.mem.allocator { Allocator, OutOfMemoryError }
import style { Computed, TextStyle }
import style
import paint_css { Basis }
import properties.convert { Context, FontMetrics }
import layout.lib { FontRequest, LineHeight }
import silk.core.option { Option }

fn metrics(tree: &UiTree<'_>, text: TextStyle, key: usize) -> FontMetrics {
  let measured = tree.provider.text.font(FontRequest { key: key,
    writingMode: text.writingMode, textOrientation: text.textOrientation, direction: text.direction })
  let mut result = FontMetrics.fallback(text.size)
  if measured.fontSize > 0.0 {
    result.xHeight = measured.xHeight
    result.capHeight = measured.capHeight
    result.zeroAdvance = measured.zeroAdvance
  }
  result.lineHeight = match text.lineHeight {
    LineHeight.Number { value } => text.size * value
    LineHeight.Length { value } => value
    LineHeight.Normal => if measured.fontSize > 0.0 { measured.ascent + measured.descent + measured.lineGap } else { text.size }
  }
  return result
}

/// Call after registering the final font key. The root's own declarations use
/// its new font bases without waiting for its Computed record to be installed.
fn zoomedMetrics(m: FontMetrics, ratio: f32) -> FontMetrics {
  return FontMetrics { xHeight: m.xHeight * ratio, capHeight: m.capHeight * ratio, zeroAdvance: m.zeroAdvance * ratio,
    ideographAdvance: m.ideographAdvance * ratio, lineHeight: m.lineHeight * ratio }
}

/// Moves `units` to an effective zoom of `zoom`: font-relative bases scale with it, and
/// absolute units multiply by it.
pub fn rezoom(units: &mut Context, zoom: f32) -> () {
  if units.zoom == zoom || units.zoom <= 0.0 { return () }
  let ratio = zoom / units.zoom
  units.zoom = zoom
  units.fontSize = units.fontSize * ratio
  units.rootFontSize = units.rootFontSize * ratio
  if let Option.Some { value } = units.fontMetrics { units.fontMetrics = Option<FontMetrics>.some(zoomedMetrics(value, ratio)) }
  if let Option.Some { value } = units.rootFontMetrics { units.rootFontMetrics = Option<FontMetrics>.some(zoomedMetrics(value, ratio)) }
}

// The root's font bases, measured at the root's zoom, for an element at `zoom`.
fn rootBases(tree: &UiTree<'_>, result: &mut Context, zoom: f32) -> () {
  let root = tree.node(tree.root)
  let ratio: f32 = if root.computed().text.zoom > 0.0 { zoom / root.computed().text.zoom } else { 1.0 }
  result.rootFontSize = root.computed().text.size * ratio
  let measured = metrics(tree, root.computed().text, root.fontKey)
  result.rootFontMetrics = Option<FontMetrics>.some(if ratio == 1.0 { measured } else { zoomedMetrics(measured, ratio) })
}

pub fn context(tree: &UiTree<'_>, slot: u32, computed: &Computed, key: usize) -> Context {
  if slot != tree.root { return descendantContext(tree, computed, key) }
  let mut result = computed.unitContext()
  result.fontMetrics = Option<FontMetrics>.some(metrics(tree, computed.text, key))
  result.rootFontSize = computed.text.size
  result.rootFontMetrics = result.fontMetrics
  return result
}

/// A rich run is a descendant even when its input owns the root slot.
pub fn descendantContext(tree: &UiTree<'_>, computed: &Computed, key: usize) -> Context {
  let mut result = computed.unitContext()
  result.fontMetrics = Option<FontMetrics>.some(metrics(tree, computed.text, key))
  rootBases(tree, &mut result, computed.text.zoom)
  return result
}

pub fn paintBasis(tree: &UiTree<'_>, slot: u32, computed: &Computed, key: usize) -> Basis {
  return Basis { units: context(tree, slot, computed, key), color: computed.text.color }
}


pub fn phase(property: Property) -> u32 {
  return match property {
    Property.WritingMode | Property.Direction | Property.TextOrientation | Property.Zoom => 1
    Property.FontSize | Property.FontFamily | Property.FontStyle | Property.FontWeight
      | Property.FontWidth | Property.FontStretch | Property.FontVariant
      | Property.FontVariantLigatures | Property.FontVariantCaps | Property.FontVariantNumeric
      | Property.FontVariantPosition | Property.FontKerning | Property.FontFeatureSettings | Property.FontVariationSettings
      | Property.FontPalette | Property.FontVariantAlternates | Property.FontSizeAdjust | Property.FontSmooth => 2
    Property.LineHeight => 3
    _ => 0
  }
}

pub effect fn declarations(computed: &mut Computed, items: &[Declaration], parent: &Computed,
  units: &Context, pass: u32) ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < items.length {
    let declaration = &items[i]
    if phase(declaration.property) == pass {
      if declaration.property == Property.Zoom {
        // `inherit` would need the parent's own zoom, which no style keeps; it reads as 1.
        let own = if convert.isKeyword(&declaration.value, Keyword.Initial) || convert.isKeyword(&declaration.value, Keyword.Inherit) {
          Option<f32>.some(1.0)
        } else { style.zoomOf(&declaration.value) }
        if let Option.Some { value } = own { computed.setZoom(value, parent.text.zoom) }
      } else if convert.isKeyword(&declaration.value, Keyword.Initial) {
        run engine.applyInitial(&mut computed.*, declaration.property)
      } else if convert.isKeyword(&declaration.value, Keyword.Inherit) {
        drop style_inherit.apply(&mut computed.*, parent, declaration.property)
      } else if !run font_features.apply(&mut computed.text, declaration) {
        computed.applyIn(declaration, units)
      }
    }
    i = i + 1
  }
}

pub enum Source { Node, Overrides, Starting }

effect fn nodePass(tree: &UiTree<'_>, slot: u32, computed: &mut Computed, parent: &Computed,
  units: &Context, pass: u32, source: Source) ! OutOfMemoryError ? &mut Allocator {
  let node = tree.node(slot)
  if source == Source.Starting {
    if let Option.Some { value } = node.sheetStyle() {
      if let Option.Some { value: start } = &value.starting {
        run declarations(&mut computed.*, start.asSlice(), parent, units, pass)
        return ()
      }
    }
    run declarations(&mut computed.*, node.starting(), parent, units, pass)
    return ()
  }
  if let Option.Some { value } = node.sheetStyle() {
    if source != Source.Overrides { run declarations(&mut computed.*, value.declarations.asSlice(), parent, units, pass) }
    run declarations(&mut computed.*, value.overrides.asSlice(), parent, units, pass)
    return ()
  }
  if node.kind == NodeKind.Text { return () }
  let states = [StyleState.Base, StyleState.Hover, StyleState.Active, StyleState.Focus, StyleState.FocusVisible]
  let mut i: usize = 0
  if source != Source.Overrides {
    while i < states.length {
      let state = states[i]
      if style_sheets.active(tree, slot, state) {
        let replace = match tree.overrideOf(node.id, state) { Option.Some { value } => value.replace _ => false }
        if !replace {
          let client = match state {
            StyleState.Hover => node.hover()
            StyleState.Active => node.active()
            StyleState.Focus => node.focus()
            StyleState.FocusVisible => node.focusVisible()
            _ => node.base.asSlice()
          }
          run declarations(&mut computed.*, client, parent, units, pass)
        }
      }
      i = i + 1
    }
  }
  if tree.styleOverrides().length == 0 { return () }
  i = 0
  while i < states.length {
    if style_sheets.active(tree, slot, states[i]) {
      if let Option.Some { value } = tree.overrideOf(node.id, states[i]) {
        run declarations(&mut computed.*, value.declarations.asSlice(), parent, units, pass)
      }
    }
    i = i + 1
  }
}

pub effect fn inherited(tree: &mut UiTree<'_>, slot: u32, computed: &Computed) -> Context
  ! OutOfMemoryError ? &mut Allocator {
  let parentSlot = tree.node(slot).parent
  let parent = if parentSlot == NONE { tree.rootParent() } else { tree.node(parentSlot).computed().* }
  let parentKey = if parentSlot == NONE { run tree.fontKeyOf(parent.text) } else { tree.node(parentSlot).fontKey }
  let mut inherited = computed.unitContext()
  inherited.zoom = parent.text.zoom
  inherited.fontSize = parent.text.size
  inherited.fontMetrics = Option<FontMetrics>.some(metrics(&tree.*, parent.text, parentKey))
  if slot == tree.root {
    inherited.rootFontSize = parent.text.size
    inherited.rootFontMetrics = inherited.fontMetrics
  } else {
    rootBases(&tree.*, &mut inherited, parent.text.zoom)
  }
  // The element's own zoom, when it has one, is applied in the first pass: see `prepare`.
  rezoom(&mut inherited, computed.text.zoom)
  return inherited
}

/// Font-size uses parent metrics; lh in font-size and line-height uses parent line height.
pub effect fn prepare(tree: &mut UiTree<'_>, slot: u32, computed: &mut Computed, source: Source) -> Context
  ! OutOfMemoryError ? &mut Allocator {
  if tree.node(slot).kind == NodeKind.Text { return computed.unitContext() }
  let parent = style_sheets.parentStyle(&tree.*, slot)
  let mut inherited = run inherited(&mut tree.*, slot, &computed.*)
  run nodePass(&tree.*, slot, &mut computed.*, &parent, &inherited, 1, source)
  inherited.vertical = computed.unitContext().vertical
  rezoom(&mut inherited, computed.text.zoom)
  run nodePass(&tree.*, slot, &mut computed.*, &parent, &inherited, 2, source)
  return run finish(&mut tree.*, slot, &mut computed.*, &parent, &inherited, source)
}

pub effect fn refresh(tree: &mut UiTree<'_>, slot: u32, computed: &mut Computed) -> Context
  ! OutOfMemoryError ? &mut Allocator {
  let parent = style_sheets.parentStyle(&tree.*, slot)
  let inherited = run inherited(&mut tree.*, slot, &computed.*)
  return run finish(&mut tree.*, slot, &mut computed.*, &parent, &inherited, Source.Node)
}

effect fn finish(tree: &mut UiTree<'_>, slot: u32, computed: &mut Computed, parent: &Computed,
  inherited: &Context, source: Source) -> Context ! OutOfMemoryError ? &mut Allocator {
  let key = run tree.fontKeyOf(computed.text)
  let mut line = context(&tree.*, slot, &computed.*, key)
  let mut lineMetrics = line.metrics()
  lineMetrics.lineHeight = inherited.metrics().lineHeight
  line.fontMetrics = Option<FontMetrics>.some(lineMetrics)
  if slot == tree.root {
    let mut rootMetrics = line.rootMetrics()
    rootMetrics.lineHeight = inherited.rootMetrics().lineHeight
    line.rootFontMetrics = Option<FontMetrics>.some(rootMetrics)
  }
  if source == Source.Starting { run nodePass(&tree.*, slot, &mut computed.*, parent, &line, 3, Source.Node) }
  run nodePass(&tree.*, slot, &mut computed.*, parent, &line, 3, source)
  return context(&tree.*, slot, &computed.*, key)
}
