//! What the generated host's WebGPU exports call. A wasm program exports only from its own
//! package, so the host defines the exports and reaches the GPU packages through here.
static if Intrinsic.targetArchitecture() == "wasm32" {
  pub import webgpu_sys.generated_webgpu {
    WGPUAdapter,
    WGPUCompilationInfo,
    WGPUCompilationInfoRequestStatus,
    WGPUComputePipeline,
    WGPUCreatePipelineAsyncStatus,
    WGPUDevice,
    WGPUDeviceLostReason,
    WGPUErrorType,
    WGPUMapAsyncStatus,
    WGPUPopErrorScopeStatus,
    WGPUQueueWorkDoneStatus,
    WGPURenderPipeline,
    WGPURequestAdapterStatus,
    WGPURequestDeviceStatus,
  }
  pub import webgpu.runtime {
    wasmAdapter,
    wasmCompilation,
    wasmComputePipeline,
    wasmDevice,
    wasmError,
    wasmLost,
    wasmMap,
    wasmQueue,
    wasmRenderPipeline,
    wasmScope,
  }
  pub import webgpu.host_memory { hostAllocate, release }
}
