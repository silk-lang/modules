//! `matches`, `closest`, `querySelector` and `querySelectorAll` on the retained tree, with the
//! selector matcher stylesheets use, so a query agrees with CSS: the same pseudo-classes,
//! live states and `:has()`. `:scope` is the element the query starts from.
import engine { UiTree }
import selector_tree { SelectorTree }
import node { NONE }
import mutation { NodeKind }
import svg_css.selectors { SelectorList, Specificity }
import svg_css.selectors
import svg_css.lexer
import svg_css.tokens { CssError, Limits, TokenBuffer }
import svg_css.element { ElementTree, MatchContext, NO_ELEMENT }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize

/// A selector list parsed once for a query.
pub struct Query {
  buffer: TokenBuffer,
  list: SelectorList,
}

impl Query {
  /// `selector` parsed, or none when it is not a valid selector list (the web's SyntaxError).
  pub effect fn parse(selector: &[u8]) -> Option<Query> ! OutOfMemoryError ? &mut Allocator {
    let limits = Limits.make()
    let tokens = run Effect.result(lexer.tokenize(selector, &limits))
    let buffer = match move tokens {
      Result<TokenBuffer, CssError | OutOfMemoryError>.Success { value } => move value
      Result<TokenBuffer, CssError | OutOfMemoryError>.Failure { error: OutOfMemoryError {} } => { fail OutOfMemoryError {} }
      _ => { return Option<Query>.None }
    }
    let parsed = run Effect.result(selectors.parse(&buffer, buffer.all(), &[], &limits))
    return match move parsed {
      Result<Option<SelectorList>, CssError | OutOfMemoryError>.Success { value: Option<SelectorList>.Some { value } } =>
        Option<Query>.some(Query { buffer: move buffer, list: move value })
      Result<Option<SelectorList>, CssError | OutOfMemoryError>.Failure { error: OutOfMemoryError {} } => { fail OutOfMemoryError {} }
      _ => Option<Query>.None
    }
  }

  /// Whether the element in `slot` matches, with `scope` as `:scope`. A match that runs out of
  /// its work budget does not match.
  effect fn matchesSlot(self: &Self, adapter: &SelectorTree<'_, '_>, slot: usize, scope: usize) -> bool {
    let mut context = MatchContext.make(scope, NO_ELEMENT)
    let result = run Effect.result(selectors.matchElement(&self.list, &self.buffer, adapter, slot, &mut context))
    return match &result {
      Result<Option<Specificity>, CssError>.Success { value: Option<Specificity>.Some { .. } } => true
      _ => false
    }
  }

  /// `element.matches(selector)` for node `id`; false for a node that is gone or is text.
  pub effect fn matches(self: &Self, tree: &UiTree<'_>, id: u32) -> bool {
    let slot = element(tree, id)
    if slot == NO_ELEMENT { return false }
    let adapter = SelectorTree { tree: tree }
    return run self.matchesSlot(&adapter, slot, slot)
  }

  /// `element.closest(selector)`: node `id` or its nearest ancestor that matches, or 0.
  pub effect fn closest(self: &Self, tree: &UiTree<'_>, id: u32) -> u32 {
    let start = element(tree, id)
    if start == NO_ELEMENT { return 0 }
    let adapter = SelectorTree { tree: tree }
    let mut at = start
    while at != NO_ELEMENT {
      if run self.matchesSlot(&adapter, at, start) { return tree.node(usize.toU32(at)).id }
      at = ElementTree.parent(&adapter, at)
    }
    return 0
  }

  /// The descendants of node `id` that match, in tree order: the first only, or all of them
  /// when `all`.
  pub effect fn select(self: &Self, tree: &UiTree<'_>, id: u32, all: bool, out: &mut List<u32>) -> () ! OutOfMemoryError ? &mut Allocator {
    let scope = element(tree, id)
    if scope == NO_ELEMENT { return () }
    let adapter = SelectorTree { tree: tree }
    let mut at = ElementTree.firstChild(&adapter, scope)
    while at != NO_ELEMENT {
      if run self.matchesSlot(&adapter, at, scope) {
        run out.append(tree.node(usize.toU32(at)).id)
        if !all { return () }
      }
      // Next in tree order: the first child, else the next sibling of the nearest ancestor
      // below the scope that has one.
      let child = ElementTree.firstChild(&adapter, at)
      if child != NO_ELEMENT {
        at = child
      } else {
        while at != NO_ELEMENT && at != scope {
          let next = ElementTree.nextSibling(&adapter, at)
          if next != NO_ELEMENT {
            at = next
            break
          }
          at = ElementTree.parent(&adapter, at)
        }
        if at == scope { at = NO_ELEMENT }
      }
    }
  }
}

/// The slot of element `id`, or NO_ELEMENT for a node that is gone or is text.
fn element(tree: &UiTree<'_>, id: u32) -> usize {
  let slot = tree.slotOf(id)
  if slot == NONE { return NO_ELEMENT }
  if tree.node(slot).kind == NodeKind.Text { return NO_ELEMENT }
  return u32.toUsize(slot)
}
