effect fn checkGlobal<'a, 'b, H: HeapHooks + CoercionHooks>(hooks: &mut H, realm: Realm<'a>, regexpValue: ValueRef<'b>) -> () ! JsException ? &mut Allocator {
  let isRegExp = run regexp.isRegExp(&mut hooks, realm, regexpValue.borrow())
  if !isRegExp { return () }
  let flags = run shared.get(&mut hooks, realm, regexpValue, atoms.JS_ATOM_flags)
  run support.check(&mut hooks, realm, flags.borrow())
  let text = run shared.string(&mut hooks, realm, flags.borrow())
  drop flags
  let contains = support.contains(text.view(), 103)
  drop text
  if !contains { return run ops.error(&mut hooks,realm, b"regexp must have the 'g' flag") }
}
effect fn matchBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, search: ValueRef<'b>, method: u32) -> ValueBits ! JsException ? &mut Allocator { let _context = realm.context()
  run support.check(&mut hooks, realm, receiver)
  let mut symbol = atoms.JS_ATOM_Symbol_match
  if method == ids.MATCH_ALL { symbol = atoms.JS_ATOM_Symbol_matchAll }
  if method == ids.SEARCH { symbol = atoms.JS_ATOM_Symbol_search }
  if search.view().isObject() {
    let matcher = run shared.get(&mut hooks, realm, search, symbol)
    // Pinned source fetches @@matchAll BEFORE checking @@match and flags.
    if method == ids.MATCH_ALL { run checkGlobal(&mut hooks, realm, search) }
    if matcher.view().tag() != 2 && matcher.view().tag() != 3 {
      if method == ids.MATCH && symbols.builtinSymbol(matcher.borrow(), regexp.MATCH) {
        return run symbols.matchString(&mut hooks, memory, realm, search, receiver)
      }
      if method == ids.SEARCH && symbols.builtinSymbol(matcher.borrow(), regexp.SEARCH) {
        return run symbols.search(&mut hooks, memory, realm, search, receiver)
      }
      let mut argument = receiver.view() let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
      return (run support.call(&mut hooks, realm, matcher.borrow(), search, unsafe lendArguments(&argv))).intoBits()
    }
  }
  let text = run shared.string(&mut hooks, realm, receiver)
  let mut count: usize = 1
  let mut flags = Value.immediate(ValueBits.Undefined)
  if method == ids.MATCH_ALL { flags = run shared.text(&mut hooks, realm, b"g") count = 2 }
  let constructor = realm.regexpConstructor()
  let mut arguments = [search.view(), flags.view()]
  let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: count }
  let constructed = run Effect.result(hooks.construct(realm, constructor, constructor, unsafe lendArguments(&argv)))
  let created = match move constructed {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
  let pattern = unsafe Value.adoptBits(created)
  drop flags
  let matcher = run shared.get(&mut hooks, realm, pattern.borrow(), symbol)
  let mut argument = text.view()
  let callArguments = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut argument), count: 1 }
  return (run support.call(&mut hooks, realm, matcher.borrow(), pattern.borrow(), unsafe lendArguments(&callArguments))).intoBits()
}
effect fn replaceBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, search: ValueRef<'b>, replacement: ValueRef<'b>, all: bool) -> ValueBits ! JsException ? &mut Allocator {
  run support.check(&mut hooks, realm, receiver)
  if search.view().isObject() {
    if all { run checkGlobal(&mut hooks, realm, search) }
    let replacer = run shared.get(&mut hooks, realm, search, atoms.JS_ATOM_Symbol_replace)
    if replacer.view().tag() != 2 && replacer.view().tag() != 3 {
      // The builtin RegExp.prototype[Symbol.replace] runs directly, without the
      // generic native call layers.
      if symbols.builtinSymbol(replacer.borrow(), regexp.REPLACE) {
        return run symbols.replace(&mut hooks, memory, realm, search, receiver, replacement)
      }
      let mut arguments = [receiver.view(), replacement.view()]
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 2 }
      return (run support.call(&mut hooks, realm, replacer.borrow(), search, unsafe lendArguments(&argv))).intoBits()
    }
  }
  let mut builder = ReplacementBuffer.make()
  let textOwned = run shared.string(&mut hooks, realm, receiver)
  let needleOwned = run shared.string(&mut hooks, realm, search)
  let functional = hooks.isCallable(realm, replacement)
  let mut replaceText = Value.immediate(ValueBits.Undefined)
  if !functional { replaceText = run shared.string(&mut hooks, realm, replacement) }
  let text = textOwned.view() let needle = needleOwned.view()
  let length = Strings.length(text) let searchLength = Strings.length(needle)
  // Room for the text plus one plain replacement up front, so a single
  // replace grows nothing.
  let mut room = length let mut wide = Strings.isWide(text)
  if !functional { room = room + Strings.length(replaceText.view()) if Strings.isWide(replaceText.view()) { wide = true } }
  let mut end: usize = 0 let mut first = true
  while true {
    let mut position: i32 = -1
    if searchLength == 0 {
      if first { position = 0 }
      else if end < length { position = usize.toI32(end + 1) }
    } else { position = support.find(text, needle, end) }
    if position < 0 {
      if first { return textOwned.intoBits() }
      break
    }
    if first { let _initialized = run builder.reserve(&mut hooks, realm, room, wide) }
    let _prefix = run builder.appendRange(&mut hooks, realm, textOwned.borrow(), usize.toI64(end), i32.toI64(position))
    if functional {
      let mut arguments = [needle, ValueBits.Int { value: position }, text]
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 3 }
      let result = run support.call(&mut hooks, realm, replacement, immediateRef(ValueBits.Undefined), unsafe lendArguments(&argv))
      let replaced = run support.stringFree(&mut hooks, realm, move result)
      let _ignored = run builder.append(&mut hooks, realm, replaced.borrow())
    } else {
      run symbols.getSubstitution(&mut hooks, realm, &mut builder, needleOwned.borrow(), textOwned.borrow(), i32.toI64(position), immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined), replaceText.borrow(), &[])
    }
    end = i32.toUsize(position) + searchLength first = false
    if !all { break }
  }
  let _tail = run builder.appendRange(&mut hooks, realm, textOwned.borrow(), usize.toI64(end), usize.toI64(length))
  drop needleOwned drop replaceText drop textOwned
  return run builder.finish(&mut hooks, realm)
}
/// A piece of a split: single units and short Latin-1 pieces come from the
/// runtime's unit and recent-substring tables (header and path tokens repeat).
effect fn splitPiece<'a, 'b, H: CoercionHooks>(hooks: &mut H, realm: Realm<'a>, text: ValueRef<'b>, start: usize, end: usize) -> ValueBits ! JsException ? &mut Allocator {
  let made = run Effect.result(unitStrings.substring(realm, text, start, end))
  return match move made {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
}
/// split of flat Latin-1 text by a one-byte separator with no limit: one scan
/// counts the pieces, the result is made with room for all of them, and each
/// piece is cut from the text's bytes straight into it.
effect fn splitLatin1<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, text: ValueRef<'b>, separator: u8) -> ValueBits ! JsException ? &mut Allocator {
  let value = text.view()
  // The storage may hold more bytes than the text (a terminator): its length bounds the scan.
  let bytes = Slice.view(unsafe latin1Bytes(&value, stringReference(value)), 0, Strings.length(value))
  let base = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(bytes))
  let pattern = u64.wrappingMultiply(u8.toU64(separator), BYTE_ONES)
  // Both passes test eight bytes a word; only the last few go byte by byte.
  let mut pieces: usize = 1
  let mut at: usize = 0
  while at + 8 <= bytes.length { pieces = pieces + u32.toUsize(u64.countOnes(bytesEqual(unsafe wordAt(base, at), pattern))) at = at + 8 }
  while at < bytes.length { if bytes[at] == separator { pieces = pieces + 1 } at = at + 1 }
  let made = run Effect.result(allocate.arrayWithCapacity(&mut hooks, memory, realm, pieces))
  let array = match move made {
    Result<ValueBits, OutOfMemoryError>.Success { value: bits } => unsafe Value.adoptBits(bits)
    Result<ValueBits, OutOfMemoryError>.Failure { .. } => { return run hooks.throwOutOfMemory(realm) }
  }
  let mut start: usize = 0
  let mut output: u32 = 0
  at = 0
  while at + 8 <= bytes.length {
    let mut marks = bytesEqual(unsafe wordAt(base, at), pattern)
    while marks != 0 {
      let position = at + u32.toUsize(u32.shiftRight(u64.trailingZeros(marks), 3))
      run splitPart(&mut hooks, realm, &array, bytes, start, position, output)
      output = output + 1 start = position + 1
      marks = u64.bitAnd(marks, marks - 1)
    }
    at = at + 8
  }
  while at < bytes.length {
    if bytes[at] == separator {
      run splitPart(&mut hooks, realm, &array, bytes, start, at, output)
      output = output + 1 start = at + 1
    }
    at = at + 1
  }
  run splitPart(&mut hooks, realm, &array, bytes, start, bytes.length, output)
  return array.intoBits()
}
/// text.split(separator) with no limit, for the VM's frameless call: flat
/// Latin-1 text split by a one-unit Latin-1 string. No code can run (a
/// primitive separator has no @@split lookup). Uninitialized, having done
/// nothing, otherwise.
pub effect fn quickSplit<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, text: ValueBits, separator: ValueBits) -> ValueBits ! JsException ? &mut Allocator {
  if text.tag() != -7 || Strings.isWide(text) || Strings.length(text) == 0 { return ValueBits.Uninitialized }
  let needle = Strings.flatView(separator)
  if needle.tag() != -7 || Strings.length(needle) != 1 { return ValueBits.Uninitialized }
  let unit = Strings.codeUnit(needle, 0)
  if unit > 255 { return ValueBits.Uninitialized }
  return run splitCached(&mut hooks, memory, realm, unsafe lendBits(&text, text), u16.toU8(unit))
}
/// The longest text whose split pieces RuntimeState.splitCache keeps.
const SPLIT_CACHE_LENGTH: usize = 4096
/// splitLatin1 through RuntimeState.splitCache: strings have no identity, so the
/// same text split by the same unit gives the same pieces, and a text split
/// again gets a copy of the private pieces array kept the second time.
effect fn splitCached<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, text: ValueRef<'b>, separator: u8) -> ValueBits ! JsException ? &mut Allocator {
  let value = text.view()
  if Strings.length(value) > SPLIT_CACHE_LENGTH { return run splitLatin1(&mut hooks, memory, realm, text, separator) }
  let anchor = () let state = realm.runtimeState(&anchor)
  let seen = state.splitSeparator == u8.toU32(separator) && sameText(state.splitCache[0], value)
  let kept = state.splitCache[1]
  drop state
  if seen && kept.isObject() {
    // Held across the copy: its allocation may collect, which empties the cache.
    let pieces = unsafe Value.adoptBits(unsafe kept.retained())
    return run construction.copyFastRange(&mut hooks, memory, realm, pieces.borrow(), 0, fastCount(pieces.view()))
  }
  let made = run splitLatin1(&mut hooks, memory, realm, text, separator)
  let mut private = ValueBits.Undefined
  if seen && fastCount(made) != 0 {
    let copied = run Effect.result(construction.copyFastRange(&mut hooks, memory, realm, unsafe lendBits(&made, made), 0, fastCount(made)))
    match move copied {
      Result<ValueBits, JsException>.Success { value: bits } => { private = bits }
      Result<ValueBits, JsException>.Failure { .. } => { let _pending = realm.takeException() }
    }
  }
  let mut stateAnchor = () let note = realm.runtimeStateMut(&mut stateAnchor)
  let old = note.splitCache
  note.splitCache = [unsafe value.retained(), private]
  note.splitSeparator = u8.toU32(separator)
  drop note
  unsafe gc.release(&mut hooks, realm.runtime(), old[0])
  unsafe gc.release(&mut hooks, realm.runtime(), old[1])
  return made
}
fn sameText(cached: ValueBits, text: ValueBits) -> bool {
  return match cached {
    ValueBits.String { reference: first } => match text {
      ValueBits.String { reference: second } => Pointer.address<HeapHeader>(first) == Pointer.address<HeapHeader>(second)
      _ => false
    }
    _ => false
  }
}
/// The element count of a fast Array (0 for anything else).
fn fastCount(array: ValueBits) -> usize {
  let node = match array { ValueBits.Object { reference } => reference _ => { return 0 } }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  return match &data.payload { ObjectPayload.FastArray { array: values } => values.values().length() _ => 0 }
}
/// splitLatin1's piece [start, end) of bytes as element output of array, which
/// was made with room for every piece.
@inlineAlways
effect fn splitPart<'a, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks>(hooks: &mut H, realm: Realm<'a>,
  array: &Value, bytes: &[u8], start: usize, end: usize, output: u32) -> () ! JsException ? &mut Allocator {
  let piece = run Effect.result(unitStrings.latin1Substring(realm, Slice.view(bytes, start, end - start)))
  let part = match move piece {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: bits } => bits
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => run shared.materialize(&mut hooks, realm, move error)
  }
  let node = match array.view() { ValueBits.Object { reference } => reference _ => invariant() }
  if !unsafe storage.appendReserved(node, part) {
    run shared.pushIndex(&mut hooks, realm, array.borrow(), u32.toI64(output), unsafe Value.adoptBits(part))
  }
}
const BYTE_ONES: u64 = 0x0101010101010101
const BYTE_LOW: u64 = 0x7f7f7f7f7f7f7f7f
const BYTE_HIGH: u64 = 0x8080808080808080
/// The high bit of each byte of word equal to the byte pattern repeats.
@inlineAlways
fn bytesEqual(word: u64, pattern: u64) -> u64 {
  let other = u64.bitXor(word, pattern)
  return u64.bitAnd(u64.bitNot(u64.bitOr(u64.wrappingAdd(u64.bitAnd(other, BYTE_LOW), BYTE_LOW), other)), BYTE_HIGH)
}
@inlineAlways
unsafe fn wordAt(bytes: [*]const u8, index: usize) -> u64 {
  return unsafe Pointer.readUnaligned<u64>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(unsafe Pointer.at<u8>(bytes, index)))
}
effect fn splitBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, separator: ValueRef<'b>, limit: ValueRef<'b>) -> ValueBits ! JsException ? &mut Allocator {
  run support.check(&mut hooks, realm, receiver)
  if separator.view().isObject() {
    let splitter = run shared.get(&mut hooks, realm, separator, atoms.JS_ATOM_Symbol_split)
    if splitter.view().tag() != 2 && splitter.view().tag() != 3 {
      if symbols.builtinSymbol(splitter.borrow(), regexp.SPLIT) {
        return run symbols.split(&mut hooks, memory, realm, separator, receiver, limit)
      }
      let mut arguments = [receiver.view(), limit.view()]
      let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut arguments[0]), count: 2 }
      return (run support.call(&mut hooks, realm, splitter.borrow(), separator, unsafe lendArguments(&argv))).intoBits()
    }
  }
  let textOwned = run shared.string(&mut hooks, realm, receiver)
  let mut maximum: u32 = 0xffffffff
  if limit.view().tag() != 3 { maximum = run shared.uint32(&mut hooks, realm, limit) }
  // Separator ToString is required even when limit is zero or separator undefined.
  let needleOwned = run shared.string(&mut hooks, realm, separator)
  let text = textOwned.view() let needle = needleOwned.view()
  let length = Strings.length(text) let count = Strings.length(needle)
  // The one-byte split makes its own array of the right size; no code observes the
  // general path's ArrayCreate, so it is made only past this point.
  if count == 1 && maximum == 0xffffffff && separator.view().tag() != 3 && text.tag() == -7 && !Strings.isWide(text) && length != 0 {
    let unit = Strings.codeUnit(needle, 0)
    if unit <= 255 { return run splitCached(&mut hooks, memory, realm, textOwned.borrow(), u16.toU8(unit)) }
  }
  let array = run shared.array(&mut hooks, memory, realm)
  if maximum == 0 || (length == 0 && count == 0 && separator.view().tag() != 3) { return array.intoBits() }
  let mut start: usize = 0 let mut output: u32 = 0
  if separator.view().tag() != 3 && length != 0 {
    let mut cursor: usize = 0
    while true {
      if count == 0 { cursor = cursor + 1 }
      if count > length || cursor > length - count || (count == 0 && cursor == length) { break }
      let position = support.find(text, needle, cursor)
      if position < 0 { break }
      let part = run splitPiece(&mut hooks, realm, textOwned.borrow(), start, i32.toUsize(position))
      run shared.pushIndex(&mut hooks, realm, array.borrow(), u32.toI64(output), unsafe Value.adoptBits(part))
      output = output + 1
      if output == maximum { return array.intoBits() }
      start = i32.toUsize(position) + count cursor = start
    }
  }
  let part = run splitPiece(&mut hooks, realm, textOwned.borrow(), start, length)
  run shared.pushIndex(&mut hooks, realm, array.borrow(), u32.toI64(output), unsafe Value.adoptBits(part))
  return array.intoBits()
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + CallHooks + InterruptHooks>(hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>, args: Arguments<'a>, method: u32) -> ValueBits ! JsException ? &mut Allocator {
  let _first = args.get(0).view() let _second = args.get(1).view()
  let result = match method {
    _ if method == ids.SPLIT => run Effect.result(splitBody(&mut hooks, memory, realm, receiver, args.get(0), args.get(1)))
    _ if method == ids.REPLACE || method == ids.REPLACE_ALL => run Effect.result(replaceBody(&mut hooks, memory, realm, receiver, args.get(0), args.get(1), method == ids.REPLACE_ALL))
    _ => run Effect.result(matchBody(&mut hooks, memory, realm, receiver, args.get(0), method))
  }
  return match move result { Result<ValueBits, JsException>.Success { value } => value Result<ValueBits, JsException>.Failure { error } => { fail move error } }
}
