//! A Loom app in a window: what the host silkui generates for a Loom app runs. The app's
//! model `P` is a `Program<M, C>`; its commands may ask the window's [`Shell`] for things.
//!
//! The commands run on worker threads, so the window stays live while one is slow. A message
//! and a command own what they hold, and a command that must stay on the UI thread says so
//! with `onUiThread`.
//!
//! ```silk,ignore
//! import project.app { Model, Message }
//! import silkui_window_loom.app { Settings, TitleBar, main as loom }
//!
//! pub fn main() -> i32 {
//!   return loom<Model, Message>(Settings { title: "My app", width: 900.0, height: 600.0, titleBar: TitleBar.Standard, titleBarHeight: 0.0, controlsLeft: 0.0, controlsTop: 0.0, inspect: true })
//! }
//! ```
import loom_window.program { StylesheetCompiler as Compiler, runtimeStylesheets }
import loom.app { NoCommand }
import loom.program { Program, CommandSet }
import loom.shell { Shell }
import loom_window.program { Launched, Window, StyleAssets, SheetWatch, launch, show, showWithWorkers, systemFonts, failed }
import silk.concurrency.thread { Transferable }
pub import loom_window.program { TitleBar }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The window an app opens, and whether a debug build serves the inspector when
/// `SILK_UI_INSPECT` is set (the development host) or never does (the release host).
/// `titleBar` and `titleBarHeight` are `Window.withTitleBar`'s, `controlsLeft` and
/// `controlsTop` `Window.withControls`'s.
pub struct Settings {
  pub title: string<'static>,
  pub width: f64,
  pub height: f64,
  pub titleBar: TitleBar,
  pub titleBarHeight: f64,
  pub controlsLeft: f64,
  pub controlsTop: f64,
  pub inspect: bool,
}

impl Copy for Settings {}

effect fn window(settings: Settings, sheets: StyleAssets, updates: SheetWatch, compiler: Compiler) -> Window ! OutOfMemoryError ? &mut Allocator {
  let mut window = run Window.make(settings.title, settings.width, settings.height)
  window.withTitleBar(settings.titleBar, settings.titleBarHeight)
  window.withControls(settings.controlsLeft, settings.controlsTop)
  window.withStylesheetCompiler(compiler)
  window.withStyleSheets(move sheets)
  window.withStyleSheetUpdates(move updates)
  if !settings.inspect { window.uninspected() }
  return move window
}

effect fn opened<P: Program<M, NoCommand>, M>(settings: Settings, platform: Option<Launched>, sheets: StyleAssets, updates: SheetWatch, compiler: Compiler) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let fonts = run systemFonts()
  return run show<P, M, NoCommand, never>(run window(settings, move sheets, move updates, compiler), &fonts, move platform)
}

effect fn openedWithCommands<P: Program<M, C>, M: 'static + Transferable, C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>>(settings: Settings, platform: Option<Launched>, sheets: StyleAssets, updates: SheetWatch, compiler: Compiler) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let window = run window(settings, move sheets, move updates, compiler)
  let mut shell = window.shell()
  let fonts = run systemFonts()
  return run showWithWorkers<P, M, C>(move window, &fonts, move platform)
    |> Effect.provideMut<Shell>(&mut shell)
}

fn app<P: Program<M, NoCommand>, M>(settings: Settings, platform: Option<Launched>, sheets: StyleAssets, updates: SheetWatch, compiler: Compiler) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(opened<P, M>(settings, move platform, move sheets, move updates, compiler), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

fn appWithCommands<P: Program<M, C>, M: 'static + Transferable, C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>>(settings: Settings, platform: Option<Launched>, sheets: StyleAssets, updates: SheetWatch, compiler: Compiler) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(openedWithCommands<P, M, C>(settings, move platform, move sheets, move updates, compiler), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

/// The host's main for an app without commands.
pub fn main<P: Program<M, NoCommand>, M>(settings: Settings) -> i32 {
  return mainWithSheets<P, M>(settings, &[])
}

/// Starts with build-compiled application sheets, in adoption order.
pub fn mainWithSheets<P: Program<M, NoCommand>, M>(settings: Settings, sources: &[&[u8]]) -> i32 {
  return mainWithSheetUpdates<P, M>(settings, sources, "")
}

pub fn mainWithSheetUpdates<P: Program<M, NoCommand>, M>(settings: Settings, sources: &[&[u8]], updatePath: string) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(launchSheets<P, M>(settings, sources, updatePath, Compiler.off()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn launchSheets<P: Program<M, NoCommand>, M>(settings: Settings, sources: &[&[u8]], updatePath: string, compiler: Compiler) -> i32
  ! FileError | OutOfMemoryError ? &mut Allocator {
  let sheets = run StyleAssets.from(sources)
  let updates = run SheetWatch.from(updatePath)
  // Copy borrowed source bytes before transferring them to the app thread.
  return launch(|platform: Option<Launched>| -> i32 {
    return app<P, M>(settings, move platform, move sheets, move updates, compiler)
  })
}

/// Main for an app whose commands may ask the window's Shell for things.
pub fn withCommands<P: Program<M, C>, M: 'static + Transferable, C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>>(settings: Settings) -> i32 {
  return withCommandsAndSheets<P, M, C>(settings, &[])
}

pub fn withCommandsAndSheets<P: Program<M, C>, M: 'static + Transferable, C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>>(
  settings: Settings, sources: &[&[u8]],
) -> i32 {
  return withCommandsAndSheetUpdates<P, M, C>(settings, sources, "")
}

pub fn withCommandsAndSheetUpdates<P: Program<M, C>, M: 'static + Transferable, C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>>(
  settings: Settings, sources: &[&[u8]], updatePath: string,
) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(launchCommandsAndSheets<P, M, C>(settings, sources, updatePath, Compiler.off()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn launchCommandsAndSheets<P: Program<M, C>, M: 'static + Transferable, C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>>(
  settings: Settings, sources: &[&[u8]], updatePath: string, compiler: Compiler,
) -> i32 ! FileError | OutOfMemoryError ? &mut Allocator {
  let sheets = run StyleAssets.from(sources)
  let updates = run SheetWatch.from(updatePath)
  return launch(|platform: Option<Launched>| -> i32 {
    return appWithCommands<P, M, C>(settings, move platform, move sheets, move updates, compiler)
  })
}

pub fn mainWithRuntimeSheets<P: Program<M, NoCommand>, M>(settings: Settings, sources: &[&[u8]], updatePath: string) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(launchSheets<P, M>(settings, sources, updatePath, runtimeStylesheets()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn withCommandsAndRuntimeSheets<P: Program<M, C>, M: 'static + Transferable, C: 'static + Transferable + CommandSet<M, &mut Shell | &mut Allocator>>(
  settings: Settings, sources: &[&[u8]], updatePath: string,
) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(launchCommandsAndSheets<P, M, C>(settings, sources, updatePath, runtimeStylesheets()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
