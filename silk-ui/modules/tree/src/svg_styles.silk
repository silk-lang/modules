//! Resolves page CSS stylesheet rules against inline `<svg>` descendants — both live SVGs
//! (`LiveSvg`, painted via `PathCache`) and markup SVGs (painted via `lib-svg`).
//!
//! HTML/CSS rules such as `.mo-flow-edges path`, `.dg-bay [data-source="mic"] { --dg-cable: ... }`,
//! `.dg-plug circle:first-child`, `.st-map-land`, or `.st-map-label { font: ... var(--serif) }`
//! match across the HTML-to-SVG boundary by extending `SelectorTree` with the SVG's element tree
//! and chaining CSS variable scopes down from the `<svg>` node's `sheetScope()`.
import engine { UiTree }
import mutation { NodeKind }
import selector_tree { SelectorTree }
import style_sheets
import style_sheets { RootSheets }
import live_svg
import live_svg { LiveSvg, Props, NO_ELEMENT as NO_SVG_ELEMENT }
import resources { StyledIconMarkup }
import transform
import transform { Transform, Units }
import vector.geometry { Affine }
import properties.catalog { Property }
import properties.catalog
import properties.values
import properties.convert
import properties.convert { Context as LengthContext }
import properties.keywords { Keyword }
import svg_css.adopted { StyleSheets, Source }
import svg_css.sheet { Declaration as SheetDeclaration }
import svg_css.cascade { Priority }
import svg_css.cascade
import svg_css.element { ElementTree, MatchContext, PseudoTarget, StateBits, AttributeText, NO_ELEMENT }
import svg_css.ancestor_filter { AncestorFilter }
import svg_css.media_features { Environment }
import svg_css.variables { ScopeId, RegistrationError }
import svg_css.resolver { ResolverError }
import svg_css.tokens { Limits, CssError }
import svg_css.tokens as css_tokens
import svg_css.lexer
import svg_css.input { Input }
import svg_css.value_cursor { Cursor }
import svg_css.colors { ColorProgram, Color, Context as ColorContext }
import svg_css.colors
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.collections.hash { Hash }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

fn absent<'a>() -> AttributeText<'a> {
  return AttributeText<'a> { namespace: b"", name: b"", value: b"" }
}

fn isSpace(c: u8) -> bool {
  return c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

fn hasClassInList(classes: &[u8], name: &[u8]) -> bool {
  if name.length == 0 || classes.length == 0 { return false }
  let mut i: usize = 0
  while i < classes.length {
    while i < classes.length && isSpace(classes[i]) { i = i + 1 }
    let start = i
    while i < classes.length && !isSpace(classes[i]) { i = i + 1 }
    if i - start == name.length && Slice.view<u8>(classes, start, i - start) == name {
      return true
    }
  }
  return false
}

fn colorToRgba(c: Color) -> Rgba<f32> {
  let srgb = colors.toSrgb(c)
  return Rgba<f32> {
    r: f64.toF32(srgb.r),
    g: f64.toF32(srgb.g),
    b: f64.toF32(srgb.b),
    a: f64.toF32(srgb.a),
  }
}

fn rgbaToColor(c: Rgba<f32>) -> Color {
  return Color.srgb(f32.toF64(c.r), f32.toF64(c.g), f32.toF64(c.b), f32.toF64(c.a))
}

// ============================================================================
// LiveSvg selector adapter
// ============================================================================

struct LiveSelectorTree<'tree, 'fonts, 'svg> {
  html: SelectorTree<'tree, 'fonts>,
  svgSlot: usize,
  base: usize,
  svg: &'svg LiveSvg,
}

impl<'tree, 'fonts, 'svg> LiveSelectorTree<'tree, 'fonts, 'svg> {
  fn attrAt<'a>(self: &'a Self, elem: u32, index: usize) -> AttributeText<'a> {
    let e = self.svg.at(elem)
    let mut i = index
    if e.idText.length() != 0 {
      if i == 0 { return AttributeText<'a> { namespace: b"", name: b"id", value: e.idText.asSlice() } }
      i = i - 1
    }
    if e.classes.length() != 0 {
      if i == 0 { return AttributeText<'a> { namespace: b"", name: b"class", value: e.classes.asSlice() } }
      i = i - 1
    }
    let attrs = e.attrs.asSlice()
    if i < attrs.length {
      return AttributeText<'a> { namespace: b"", name: attrs[i].name.asSlice(), value: attrs[i].value.asSlice() }
    }
    return absent<'a>()
  }
}

impl<'tree, 'fonts, 'svg> ElementTree for LiveSelectorTree<'tree, 'fonts, 'svg> {
  fn container(self: &Self, node: usize, name: &[u8], axes: u32, pseudo: PseudoTarget) -> Option<Environment> {
    let target = if node >= self.base { self.svgSlot } else { node }
    return self.html.container(target, name, axes, pseudo)
  }
  fn styleContainer(self: &Self, node: usize, name: &[u8], pseudo: PseudoTarget) -> Option<ScopeId> {
    let target = if node >= self.base { self.svgSlot } else { node }
    return self.html.styleContainer(target, name, pseudo)
  }
  fn ancestorFilter(self: &Self, node: usize) -> Option<&AncestorFilter> {
    drop node
    return Option<&AncestorFilter>.None
  }
  fn hasClass(self: &Self, node: usize, name: &[u8]) -> Option<bool> {
    if node < self.base { return self.html.hasClass(node, name) }
    let elem = usize.toU32(node - self.base)
    return Option<bool>.some(hasClassInList(self.svg.at(elem).classes.asSlice(), name))
  }
  fn siblingIndex(self: &Self, node: usize, reverse: bool) -> Option<usize> {
    if node < self.base { return self.html.siblingIndex(node, reverse) }
    return Option<usize>.None
  }
  fn parent(self: &Self, node: usize) -> usize {
    if node < self.base { return self.html.parent(node) }
    let p = self.svg.at(usize.toU32(node - self.base)).parent
    if p == NO_SVG_ELEMENT { return NO_ELEMENT }
    if p == 0 { return self.svgSlot }
    return self.base + u32.toUsize(p)
  }
  fn containingHost(self: &Self, node: usize) -> usize {
    drop node
    return NO_ELEMENT
  }
  fn firstChild(self: &Self, node: usize) -> usize {
    if node == self.svgSlot {
      let first = self.svg.at(0).first
      return if first == NO_SVG_ELEMENT { NO_ELEMENT } else { self.base + u32.toUsize(first) }
    }
    if node < self.base { return self.html.firstChild(node) }
    let first = self.svg.at(usize.toU32(node - self.base)).first
    return if first == NO_SVG_ELEMENT { NO_ELEMENT } else { self.base + u32.toUsize(first) }
  }
  fn nextSibling(self: &Self, node: usize) -> usize {
    if node < self.base { return self.html.nextSibling(node) }
    let next = self.svg.at(usize.toU32(node - self.base)).next
    return if next == NO_SVG_ELEMENT { NO_ELEMENT } else { self.base + u32.toUsize(next) }
  }
  fn previousSibling(self: &Self, node: usize) -> usize {
    if node < self.base { return self.html.previousSibling(node) }
    let prev = self.svg.at(usize.toU32(node - self.base)).previous
    return if prev == NO_SVG_ELEMENT { NO_ELEMENT } else { self.base + u32.toUsize(prev) }
  }
  fn localName(self: &Self, node: usize) -> &[u8] {
    if node < self.base { return self.html.localName(node) }
    return live_svg.tagName(self.svg.at(usize.toU32(node - self.base)).tag)
  }
  fn namespaceUri(self: &Self, node: usize) -> &[u8] {
    if node < self.base { return self.html.namespaceUri(node) }
    return b"http://www.w3.org/2000/svg"
  }
  fn attributeCount(self: &Self, node: usize) -> usize {
    if node < self.base { return self.html.attributeCount(node) }
    let e = self.svg.at(usize.toU32(node - self.base))
    let mut count = e.attrs.length()
    if e.idText.length() != 0 { count = count + 1 }
    if e.classes.length() != 0 { count = count + 1 }
    return count
  }
  fn attribute<'a>(self: &'a Self, node: usize, attribute: usize) -> AttributeText<'a> {
    if node < self.base { return self.html.attribute(node, attribute) }
    return self.attrAt(usize.toU32(node - self.base), attribute)
  }
  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] {
    if node < self.base { return self.html.attributeName(node, attribute) }
    return self.attrAt(usize.toU32(node - self.base), attribute).name
  }
  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] {
    drop node
    drop attribute
    return b""
  }
  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] {
    if node < self.base { return self.html.attributeValue(node, attribute) }
    return self.attrAt(usize.toU32(node - self.base), attribute).value
  }
  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool {
    return css_tokens.equal(self.attributeName(node, attribute), b"id")
  }
  fn language(self: &Self, node: usize) -> &[u8] {
    let target = if node >= self.base { self.svgSlot } else { node }
    return self.html.language(target)
  }
  fn isRoot(self: &Self, node: usize) -> bool {
    if node < self.base { return self.html.isRoot(node) }
    return false
  }
  fn isEmpty(self: &Self, node: usize) -> bool {
    if node < self.base { return self.html.isEmpty(node) }
    return self.svg.at(usize.toU32(node - self.base)).first == NO_SVG_ELEMENT
  }
  fn isLink(self: &Self, node: usize) -> bool {
    if node < self.base { return self.html.isLink(node) }
    return false
  }
  fn state(self: &Self, node: usize) -> StateBits {
    if node < self.base { return self.html.state(node) }
    return StateBits { bits: 0 }
  }
}

// ============================================================================
// Lightweight XML scanner + selector adapter for markup SVGs (`lib-svg`)
// ============================================================================

struct XmlAttr {
  nameStart: usize,
  nameEnd: usize,
  valStart: usize,
  valEnd: usize,
}
impl Copy for XmlAttr {}

struct XmlElem {
  tagStart: usize,
  tagEnd: usize,
  parent: usize,
  firstChild: usize,
  lastChild: usize,
  nextSibling: usize,
  prevSibling: usize,
  idStart: usize,
  idEnd: usize,
  classStart: usize,
  classEnd: usize,
  attrStart: usize,
  attrEnd: usize,
  /// Byte offset in raw markup where injected CSS goes.
  insertPos: usize,
  /// True when the element already has a `style="..."` / `style='...'` attribute.
  hasStyle: bool,
  /// Quote byte (`"` or `'`) of the style attribute.
  styleQuote: u8,
}
impl Copy for XmlElem {}

struct XmlDoc {
  elems: List<XmlElem>,
  attrs: List<XmlAttr>,
}

fn isTagChar(c: u8) -> bool {
  return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)
    || c == 45 || c == 95 || c == 58 || c == 46
}

fn bytesEqual(data: &[u8], start: usize, end: usize, target: &[u8]) -> bool {
  return end - start == target.length && Slice.view<u8>(data, start, end - start) == target
}

effect fn parseXml(data: &[u8]) -> XmlDoc ! OutOfMemoryError ? &mut Allocator {
  let mut elems = List<XmlElem>.make()
  let mut attrs = List<XmlAttr>.make()
  let mut stack = List<usize>.make()
  let mut i: usize = 0
  let len = data.length
  while i < len {
    if data[i] != 60 {
      i = i + 1
      continue
    }
    if i + 1 >= len { break }
    let next = data[i + 1]
    // Comment `<!-- ... -->`
    if next == 33 && i + 3 < len && data[i + 2] == 45 && data[i + 3] == 45 {
      i = i + 4
      while i + 2 < len && !(data[i] == 45 && data[i + 1] == 45 && data[i + 2] == 62) { i = i + 1 }
      i = if i + 2 < len { i + 3 } else { len }
      continue
    }
    // CDATA `<![CDATA[ ... ]]>`
    if next == 33 && i + 8 < len && Slice.view<u8>(data, i, 9) == b"<![CDATA[" {
      i = i + 9
      while i + 2 < len && !(data[i] == 93 && data[i + 1] == 93 && data[i + 2] == 62) { i = i + 1 }
      i = if i + 2 < len { i + 3 } else { len }
      continue
    }
    // Processing instruction `<? ... ?>` or declaration `<! ... >`
    if next == 63 || next == 33 {
      i = i + 2
      while i < len && data[i] != 62 { i = i + 1 }
      if i < len { i = i + 1 }
      continue
    }
    // Closing tag `</...>`
    if next == 47 {
      i = i + 2
      let nameStart = i
      while i < len && isTagChar(data[i]) { i = i + 1 }
      let nameEnd = i
      while i < len && data[i] != 62 { i = i + 1 }
      if i < len { i = i + 1 }
      // Pop matching open element (tolerating minor mismatches).
      let mut s = stack.length()
      while s > 0 {
        s = s - 1
        let open = elems.asSlice()[stack.asSlice()[s]]
        if open.tagEnd - open.tagStart == nameEnd - nameStart
          && Slice.view<u8>(data, open.tagStart, open.tagEnd - open.tagStart) == Slice.view<u8>(data, nameStart, nameEnd - nameStart) {
          stack.truncate(s)
          break
        }
      }
      continue
    }
    // Opening tag `<tag ...>`
    i = i + 1
    let tagStart = i
    while i < len && isTagChar(data[i]) { i = i + 1 }
    let tagEnd = i
    if tagEnd == tagStart { continue }
    let afterTag = tagEnd
    let attrStart = attrs.length()
    let mut idStart: usize = 0
    let mut idEnd: usize = 0
    let mut classStart: usize = 0
    let mut classEnd: usize = 0
    let mut insertPos = afterTag
    let mut hasStyle = false
    let mut styleQuote: u8 = 34
    let mut selfClosing = false
    while i < len {
      while i < len && isSpace(data[i]) { i = i + 1 }
      if i >= len { break }
      if data[i] == 62 {
        i = i + 1
        break
      }
      if data[i] == 47 && i + 1 < len && data[i + 1] == 62 {
        selfClosing = true
        i = i + 2
        break
      }
      let aNameStart = i
      while i < len && !isSpace(data[i]) && data[i] != 61 && data[i] != 62 && data[i] != 47 { i = i + 1 }
      let aNameEnd = i
      if aNameEnd == aNameStart {
        i = i + 1
        continue
      }
      while i < len && isSpace(data[i]) { i = i + 1 }
      let mut aValStart = i
      let mut aValEnd = i
      let mut q: u8 = 34
      if i < len && data[i] == 61 {
        i = i + 1
        while i < len && isSpace(data[i]) { i = i + 1 }
        if i < len && (data[i] == 34 || data[i] == 39) {
          q = data[i]
          i = i + 1
          aValStart = i
          while i < len && data[i] != q { i = i + 1 }
          aValEnd = i
          if i < len { i = i + 1 }
        } else {
          aValStart = i
          while i < len && !isSpace(data[i]) && data[i] != 62 && data[i] != 47 { i = i + 1 }
          aValEnd = i
        }
      }
      if bytesEqual(data, aNameStart, aNameEnd, b"id") {
        idStart = aValStart
        idEnd = aValEnd
      } else if bytesEqual(data, aNameStart, aNameEnd, b"class") {
        classStart = aValStart
        classEnd = aValEnd
      } else if bytesEqual(data, aNameStart, aNameEnd, b"style") {
        hasStyle = true
        insertPos = aValStart
        styleQuote = q
      }
      run attrs.append(XmlAttr { nameStart: aNameStart, nameEnd: aNameEnd, valStart: aValStart, valEnd: aValEnd })
    }
    let attrEnd = attrs.length()
    let idx = elems.length()
    let parent = if stack.length() != 0 { stack.asSlice()[stack.length() - 1] } else { NO_ELEMENT }
    let mut prev = NO_ELEMENT
    if parent != NO_ELEMENT {
      prev = elems.asSlice()[parent].lastChild
    }
    run elems.append(XmlElem {
      tagStart: tagStart,
      tagEnd: tagEnd,
      parent: parent,
      firstChild: NO_ELEMENT,
      lastChild: NO_ELEMENT,
      nextSibling: NO_ELEMENT,
      prevSibling: prev,
      idStart: idStart,
      idEnd: idEnd,
      classStart: classStart,
      classEnd: classEnd,
      attrStart: attrStart,
      attrEnd: attrEnd,
      insertPos: insertPos,
      hasStyle: hasStyle,
      styleQuote: styleQuote,
    })
    if parent != NO_ELEMENT {
      let mut slice = elems.asMutSlice()
      if slice[parent].firstChild == NO_ELEMENT {
        slice[parent].firstChild = idx
      }
      if prev != NO_ELEMENT {
        slice[prev].nextSibling = idx
      }
      slice[parent].lastChild = idx
    }
    // Skip raw `<style>...</style>` body so CSS inside SVG isn't misparsed as XML tags.
    if !selfClosing && bytesEqual(data, tagStart, tagEnd, b"style") {
      while i + 8 <= len {
        if data[i] == 60 && data[i + 1] == 47 && css_tokens.insensitive(Slice.view<u8>(data, i + 2, 5), b"style") {
          while i < len && data[i] != 62 { i = i + 1 }
          if i < len { i = i + 1 }
          break
        }
        i = i + 1
      }
    } else if !selfClosing {
      run stack.append(idx)
    }
  }
  return XmlDoc { elems: move elems, attrs: move attrs }
}

struct MarkupSelectorTree<'tree, 'fonts, 'doc, 'raw> {
  html: SelectorTree<'tree, 'fonts>,
  svgSlot: usize,
  base: usize,
  doc: &'doc XmlDoc,
  raw: &'raw [u8],
}

impl<'tree, 'fonts, 'doc, 'raw> MarkupSelectorTree<'tree, 'fonts, 'doc, 'raw> {
  fn slice(self: &Self, start: usize, end: usize) -> &'raw [u8] {
    if end <= start || end > self.raw.length { return b"" }
    return Slice.view<u8>(self.raw, start, end - start)
  }

  fn attrAt(self: &Self, idx: usize, index: usize) -> AttributeText<'raw> {
    let e = self.doc.elems.asSlice()[idx]
    let at = e.attrStart + index
    if at < e.attrEnd {
      let a = self.doc.attrs.asSlice()[at]
      return AttributeText<'raw> {
        namespace: b"",
        name: self.slice(a.nameStart, a.nameEnd),
        value: self.slice(a.valStart, a.valEnd),
      }
    }
    return absent<'raw>()
  }
}

impl<'tree, 'fonts, 'doc, 'raw> ElementTree for MarkupSelectorTree<'tree, 'fonts, 'doc, 'raw> {
  fn container(self: &Self, node: usize, name: &[u8], axes: u32, pseudo: PseudoTarget) -> Option<Environment> {
    let target = if node >= self.base { self.svgSlot } else { node }
    return self.html.container(target, name, axes, pseudo)
  }
  fn styleContainer(self: &Self, node: usize, name: &[u8], pseudo: PseudoTarget) -> Option<ScopeId> {
    let target = if node >= self.base { self.svgSlot } else { node }
    return self.html.styleContainer(target, name, pseudo)
  }
  fn ancestorFilter(self: &Self, node: usize) -> Option<&AncestorFilter> {
    drop node
    return Option<&AncestorFilter>.None
  }
  fn hasClass(self: &Self, node: usize, name: &[u8]) -> Option<bool> {
    if node < self.base { return self.html.hasClass(node, name) }
    let e = self.doc.elems.asSlice()[node - self.base]
    return Option<bool>.some(hasClassInList(self.slice(e.classStart, e.classEnd), name))
  }
  fn siblingIndex(self: &Self, node: usize, reverse: bool) -> Option<usize> {
    if node < self.base { return self.html.siblingIndex(node, reverse) }
    return Option<usize>.None
  }
  fn parent(self: &Self, node: usize) -> usize {
    if node < self.base { return self.html.parent(node) }
    let p = self.doc.elems.asSlice()[node - self.base].parent
    if p == NO_ELEMENT { return NO_ELEMENT }
    if p == 0 { return self.svgSlot }
    return self.base + p
  }
  fn containingHost(self: &Self, node: usize) -> usize {
    drop node
    return NO_ELEMENT
  }
  fn firstChild(self: &Self, node: usize) -> usize {
    if node == self.svgSlot {
      if self.doc.elems.length() == 0 { return NO_ELEMENT }
      let first = self.doc.elems.asSlice()[0].firstChild
      return if first == NO_ELEMENT { NO_ELEMENT } else { self.base + first }
    }
    if node < self.base { return self.html.firstChild(node) }
    let first = self.doc.elems.asSlice()[node - self.base].firstChild
    return if first == NO_ELEMENT { NO_ELEMENT } else { self.base + first }
  }
  fn nextSibling(self: &Self, node: usize) -> usize {
    if node < self.base { return self.html.nextSibling(node) }
    let next = self.doc.elems.asSlice()[node - self.base].nextSibling
    return if next == NO_ELEMENT { NO_ELEMENT } else { self.base + next }
  }
  fn previousSibling(self: &Self, node: usize) -> usize {
    if node < self.base { return self.html.previousSibling(node) }
    let prev = self.doc.elems.asSlice()[node - self.base].prevSibling
    return if prev == NO_ELEMENT { NO_ELEMENT } else { self.base + prev }
  }
  fn localName(self: &Self, node: usize) -> &[u8] {
    if node < self.base { return self.html.localName(node) }
    let e = self.doc.elems.asSlice()[node - self.base]
    return self.slice(e.tagStart, e.tagEnd)
  }
  fn namespaceUri(self: &Self, node: usize) -> &[u8] {
    if node < self.base { return self.html.namespaceUri(node) }
    return b"http://www.w3.org/2000/svg"
  }
  fn attributeCount(self: &Self, node: usize) -> usize {
    if node < self.base { return self.html.attributeCount(node) }
    let e = self.doc.elems.asSlice()[node - self.base]
    return e.attrEnd - e.attrStart
  }
  fn attribute<'a>(self: &'a Self, node: usize, attribute: usize) -> AttributeText<'a> {
    if node < self.base { return self.html.attribute(node, attribute) }
    return self.attrAt(node - self.base, attribute)
  }
  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] {
    if node < self.base { return self.html.attributeName(node, attribute) }
    return self.attrAt(node - self.base, attribute).name
  }
  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] {
    drop node
    drop attribute
    return b""
  }
  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] {
    if node < self.base { return self.html.attributeValue(node, attribute) }
    return self.attrAt(node - self.base, attribute).value
  }
  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool {
    return css_tokens.equal(self.attributeName(node, attribute), b"id")
  }
  fn language(self: &Self, node: usize) -> &[u8] {
    let target = if node >= self.base { self.svgSlot } else { node }
    return self.html.language(target)
  }
  fn isRoot(self: &Self, node: usize) -> bool {
    if node < self.base { return self.html.isRoot(node) }
    return false
  }
  fn isEmpty(self: &Self, node: usize) -> bool {
    if node < self.base { return self.html.isEmpty(node) }
    return self.doc.elems.asSlice()[node - self.base].firstChild == NO_ELEMENT
  }
  fn isLink(self: &Self, node: usize) -> bool {
    if node < self.base { return self.html.isLink(node) }
    return false
  }
  fn state(self: &Self, node: usize) -> StateBits {
    if node < self.base { return self.html.state(node) }
    return StateBits { bits: 0 }
  }
}

// ============================================================================
// Winning declaration selection & value evaluation
// ============================================================================

struct Winner {
  property: Property,
  sheet: usize,
  declaration: usize,
  priority: Priority,
}
impl Copy for Winner {}

fn isLiveSvgProperty(p: Property) -> bool {
  return match p {
    Property.Fill | Property.Stroke | Property.FillOpacity | Property.StrokeOpacity
    | Property.StrokeWidth | Property.StrokeLinecap | Property.StrokeLinejoin
    | Property.StrokeMiterlimit | Property.StrokeDasharray | Property.StrokeDashoffset
    | Property.FillRule | Property.Opacity | Property.Display | Property.Visibility
    | Property.Color | Property.StopColor | Property.StopOpacity | Property.ClipPath
    | Property.PointerEvents | Property.Transform | Property.Translate | Property.Scale
    | Property.Rotate | Property.TransformOrigin => true
    _ => false
  }
}

fn isColorProperty(p: Property) -> bool {
  return match p {
    Property.Fill | Property.Stroke | Property.Color | Property.StopColor => true
    _ => false
  }
}

fn isMarkupSvgProperty(p: Property) -> bool {
  if isLiveSvgProperty(p) { return true }
  return match p {
    Property.Font | Property.FontFamily | Property.FontSize | Property.FontStyle
    | Property.FontWeight | Property.FontVariant | Property.FontStretch
    | Property.LetterSpacing | Property.WordSpacing | Property.TextDecoration
    | Property.Direction | Property.UnicodeBidi | Property.WritingMode
    | Property.Filter | Property.MixBlendMode | Property.Isolation
    | Property.Mask | Property.ClipRule | Property.ColorInterpolation
    | Property.ColorInterpolationFilters | Property.FloodColor | Property.FloodOpacity
    | Property.LightingColor | Property.PaintOrder | Property.ShapeRendering
    | Property.TextAnchor | Property.DominantBaseline | Property.AlignmentBaseline
    | Property.BaselineShift | Property.VectorEffect | Property.MarkerStart
    | Property.MarkerMid | Property.MarkerEnd | Property.Marker => true
    _ => false
  }
}

fn declarationProperty(decl: &SheetDeclaration) -> Option<Property> {
  return match &decl.* {
    SheetDeclaration.Typed { property, .. } => Option<Property>.some(property)
    SheetDeclaration.Pending { property, .. } => Option<Property>.some(property)
    SheetDeclaration.ColorExpression { property, .. } => Option<Property>.some(property)
    SheetDeclaration.Custom { .. } => Option<Property>.None
  }
}

effect fn collectWinners(sheets: &StyleSheets, forMarkup: bool, out: &mut List<Winner>) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  out.clear()
  let candidates = sheets.candidates()
  let mut i: usize = 0
  while i < candidates.length {
    if let Source.Sheet { sheet, declaration } = candidates[i].source {
      let decl = &sheets.sheets()[sheet].sheet.declarations.asSlice()[declaration]
      if let Option<Property>.Some { value: prop } = declarationProperty(decl) {
        let wanted = if forMarkup { isMarkupSvgProperty(prop) } else { isLiveSvgProperty(prop) }
        if wanted {
          let prio = candidates[i].priority
          let mut found = false
          let mut j: usize = 0
          let existing = out.asMutSlice()
          while j < existing.length {
            if existing[j].property == prop {
              found = true
              if cascade.compare(prio, existing[j].priority) >= 0 {
                existing[j] = Winner { property: prop, sheet: sheet, declaration: declaration, priority: prio }
              }
              break
            }
            j = j + 1
          }
          if !found {
            run out.append(Winner { property: prop, sheet: sheet, declaration: declaration, priority: prio })
          }
        }
      }
    }
    i = i + 1
  }
}

union EvalValue {
  None,
  Color { color: Rgba<f32> },
  Text { text: Bytes },
}

effect fn parseColorProgramText(text: &[u8], current: Color, system: [Color; 19]) -> Option<Rgba<f32>>
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let buffer = run lexer.tokenize(text, &Limits.make())
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&input)
  let parsed = run colors.parseProgram(&input, &mut cursor)
  if !cursor.done(&input) { return Option<Rgba<f32>>.None }
  return match move parsed {
    Option<ColorProgram>.Some { value: program } => {
      let ctx = ColorContext.make(current, system)
      match program.evaluate(&ctx) {
        Option<Color>.Some { value } => Option<Rgba<f32>>.some(colorToRgba(value))
        _ => Option<Rgba<f32>>.None
      }
    }
    _ => Option<Rgba<f32>>.None
  }
}

effect fn noColorErr(error: CssError) -> Option<Rgba<f32>> {
  drop error
  return Option<Rgba<f32>>.None
}

effect fn noSubstituteErr(error: CssError) -> Option<Bytes> {
  drop error
  return Option<Bytes>.None
}

effect fn evaluateWinner(
  sheets: &StyleSheets,
  scope: ScopeId,
  winner: Winner,
  current: Color,
  system: [Color; 19],
) -> EvalValue ! OutOfMemoryError ? &mut Allocator {
  let decl = &sheets.sheets()[winner.sheet].sheet.declarations.asSlice()[winner.declaration]
  match &decl.* {
    SheetDeclaration.ColorExpression { program, .. } => {
      let ctx = ColorContext.make(current, system)
      if let Option<Color>.Some { value } = program.evaluate(&ctx) {
        return EvalValue.Color { color: colorToRgba(value) }
      }
      return EvalValue.None
    }
    SheetDeclaration.Typed { property, value, .. } => {
      if isColorProperty(property) {
        if convert.isKeyword(&value, Keyword.Currentcolor) {
          return EvalValue.Color { color: colorToRgba(current) }
        }
        if let Option<Rgba<f32>>.Some { value: rgba } = convert.color(&value) {
          return EvalValue.Color { color: rgba }
        }
      }
      let text = run values.cssText(&value)
      return EvalValue.Text { text: move text }
    }
    SheetDeclaration.Pending { property, .. } => {
      let inputs = sheets.variableInputs()
      if inputs.length == 0 { return EvalValue.None }
      let expanded = run Effect.catch<CssError>(
        inputs[0].substitute(scope, winner.sheet, winner.declaration, &Limits.make()),
        noSubstituteErr,
      )
      if let Option<Bytes>.Some { value: raw } = move expanded {
        if isColorProperty(property) {
          let trimmed = trimBytes(raw.asSlice())
          if css_tokens.insensitive(trimmed, b"currentcolor") {
            return EvalValue.Color { color: colorToRgba(current) }
          }
          let parsed = run Effect.catch<CssError>(parseColorProgramText(trimmed, current, system), noColorErr)
          if let Option<Rgba<f32>>.Some { value: rgba } = parsed {
            return EvalValue.Color { color: rgba }
          }
        }
        return EvalValue.Text { text: move raw }
      }
      return EvalValue.None
    }
    SheetDeclaration.Custom { .. } => {
      return EvalValue.None
    }
  }
}

fn trimBytes(data: &[u8]) -> &[u8] {
  let mut start: usize = 0
  let mut end = data.length
  while start < end && isSpace(data[start]) { start = start + 1 }
  while end > start && isSpace(data[end - 1]) { end = end - 1 }
  return Slice.view<u8>(data, start, end - start)
}

// ============================================================================
// LiveSvg styling pass
// ============================================================================

struct LiveResult {
  element: u32,
  props: Props,
  transform: Option<Affine>,
}

effect fn applyTransformWinner(
  t: &mut Transform,
  prop: Property,
  text: &[u8],
  units: &Units,
) -> bool {
  if prop == Property.Transform {
    transform.declare(&mut t.*, transform.TRANSFORM_LIST, text, units)
    return true
  }
  if prop == Property.Translate {
    transform.declare(&mut t.*, transform.TRANSLATE_PROPERTY, text, units)
    return true
  }
  if prop == Property.Scale {
    transform.declare(&mut t.*, transform.SCALE_PROPERTY, text, units)
    return true
  }
  if prop == Property.Rotate {
    transform.declare(&mut t.*, transform.ROTATE_PROPERTY, text, units)
    return true
  }
  if prop == Property.TransformOrigin {
    transform.declare(&mut t.*, transform.ORIGIN_PROPERTY, text, units)
    return true
  }
  return false
}

fn toAffine(t: &Transform) -> Option<Affine> {
  if !t.any() { return Option<Affine>.None }
  let m = transform.flatten(transform.matrix(t, Rect<f32>.new(0.0, 0.0, 0.0, 0.0)))
  return Option<Affine>.some(Affine {
    xx: f32.toF64(m.values[0]),
    yx: f32.toF64(m.values[1]),
    xy: f32.toF64(m.values[3]),
    yy: f32.toF64(m.values[4]),
    dx: f32.toF64(m.values[6]),
    dy: f32.toF64(m.values[7]),
  })
}

effect fn resolveLiveSvg(
  sheets: &mut StyleSheets,
  system: [Color; 19],
  tree: &UiTree<'_>,
  svgSlot: u32,
  svg: &LiveSvg,
) -> List<LiveResult> ! ResolverError | RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
  let count = svg.elements.length()
  let mut results = List<LiveResult>.make()
  if count == 0 { return move results }
  let adapter = LiveSelectorTree {
    html: SelectorTree { tree: tree },
    svgSlot: u32.toUsize(svgSlot),
    base: tree.nodes.length(),
    svg: svg,
  }
  let limits = Limits.make()
  let units = Units { context: LengthContext.make() }
  let mut scopes = List<Option<ScopeId>>.make()
  let mut elemColors = List<Color>.make()
  let mut k: usize = 0
  let rootScope = tree.node(svgSlot).sheetScope()
  let rootColor = rgbaToColor(tree.node(svgSlot).computed().text.color)
  while k < count {
    run scopes.append(rootScope)
    run elemColors.append(rootColor)
    k = k + 1
  }
  // DFS pre-order stack starting at element 0 so parents always resolve before children.
  let mut stack = List<u32>.make()
  run stack.append(0)
  let mut winners = List<Winner>.make()
  let mut children = List<u32>.make()
  while stack.length() != 0 {
    let last = stack.length() - 1
    let elem = stack.asSlice()[last]
    stack.truncate(last)
    let e = svg.at(elem)
    if !e.used { continue }
    let elemIdx = u32.toUsize(elem)
    let parentIdx = if elem == 0 || e.parent == NO_SVG_ELEMENT { 0 } else { u32.toUsize(e.parent) }
    let parentScope = scopes.asSlice()[parentIdx]
    let mut current = elemColors.asSlice()[parentIdx]
    let targetNode = if elem == 0 { u32.toUsize(svgSlot) } else { adapter.base + elemIdx }
    let mut context = MatchContext.make(u32.toUsize(tree.root), NO_ELEMENT)
    run sheets.resolveWith(&adapter, targetNode, &[], &mut context, false)
    let scope = if elem == 0 && rootScope.isSome() {
      match rootScope { Option<ScopeId>.Some { value } => value _ => run sheets.variableScopeWith(parentScope, &[], &limits) }
    } else {
      run sheets.variableScopeWith(parentScope, &[], &limits)
    }
    let scopeSlice = scopes.asMutSlice()
    scopeSlice[elemIdx] = Option<ScopeId>.some(scope)
    run collectWinners(&sheets.*, false, &mut winners)
    let mut props = Props.make()
    let mut cssTransform = Transform.initial()
    let mut hasTransform = false
    // Evaluate `color` first so `currentColor` on `fill`/`stroke` sees this element's color.
    let mut wi: usize = 0
    while wi < winners.length() {
      let w = winners.asSlice()[wi]
      if w.property == Property.Color {
        let evaluated = run evaluateWinner(&sheets.*, scope, w, current, system)
        match move evaluated {
          EvalValue.Color { color } => {
            current = rgbaToColor(color)
            LiveSvg.applyCssColor(&mut props, b"color", color)
          }
          EvalValue.Text { text } => {
            run LiveSvg.applyCssProperty(&mut props, b"color", text.asSlice())
            if props.set & 16384 != 0 { current = rgbaToColor(props.color) }
          }
          EvalValue.None => {}
        }
      }
      wi = wi + 1
    }
    let colorSlice = elemColors.asMutSlice()
    colorSlice[elemIdx] = current
    wi = 0
    while wi < winners.length() {
      let w = winners.asSlice()[wi]
      if w.property != Property.Color {
        let evaluated = run evaluateWinner(&sheets.*, scope, w, current, system)
        let name = catalog.name(w.property)
        match move evaluated {
          EvalValue.Color { color } => {
            LiveSvg.applyCssColor(&mut props, name, color)
          }
          EvalValue.Text { text } => {
            if elem != 0 && run applyTransformWinner(&mut cssTransform, w.property, text.asSlice(), &units) {
              hasTransform = true
            } else {
              run LiveSvg.applyCssProperty(&mut props, name, text.asSlice())
            }
          }
          EvalValue.None => {}
        }
      }
      wi = wi + 1
    }
    let finalTransform = if hasTransform { toAffine(&cssTransform) } else { Option<Affine>.None }
    run results.append(LiveResult { element: elem, props: move props, transform: finalTransform })
    // Push children in reverse order so DFS visits them in document order.
    children.clear()
    let mut child = e.first
    while child != NO_SVG_ELEMENT {
      run children.append(child)
      child = svg.at(child).next
    }
    let mut ci = children.length()
    while ci > 0 {
      ci = ci - 1
      run stack.append(children.asSlice()[ci])
    }
  }
  return move results
}

// ============================================================================
// Markup SVG styling pass (`lib-svg`, e.g. MapArt with <pattern>/<text>)
// ============================================================================

struct Injection {
  pos: usize,
  hasStyle: bool,
  quote: u8,
  css: List<u8>,
}

effect fn appendU32(out: &mut List<u8>, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut buf: [u8; 16] = [0; 16]
  let mut n = value
  let mut len: usize = 0
  if n == 0 {
    run out.append(48)
    return ()
  }
  while n > 0 {
    buf[len] = u32.toU8(n % 10) + 48
    n = n / 10
    len = len + 1
  }
  while len > 0 {
    len = len - 1
    run out.append(buf[len])
  }
}

effect fn appendRgbaCss(out: &mut List<u8>, c: Rgba<f32>) -> () ! OutOfMemoryError ? &mut Allocator {
  let r = f32.toU32(f32.floor(f32.max(0.0, f32.min(1.0, c.r)) * 255.0 + 0.5))
  let g = f32.toU32(f32.floor(f32.max(0.0, f32.min(1.0, c.g)) * 255.0 + 0.5))
  let b = f32.toU32(f32.floor(f32.max(0.0, f32.min(1.0, c.b)) * 255.0 + 0.5))
  let a = f32.max(0.0, f32.min(1.0, c.a))
  if a >= 0.9999 {
    run out.appendSlice(b"rgb(")
    run appendU32(&mut out.*, r)
    run out.append(44)
    run appendU32(&mut out.*, g)
    run out.append(44)
    run appendU32(&mut out.*, b)
    run out.append(41)
  } else {
    run out.appendSlice(b"rgba(")
    run appendU32(&mut out.*, r)
    run out.append(44)
    run appendU32(&mut out.*, g)
    run out.append(44)
    run appendU32(&mut out.*, b)
    run out.append(44)
    let milli = f32.toU32(f32.floor(a * 1000.0 + 0.5))
    run out.appendSlice(b"0.")
    run out.append(u32.toU8((milli / 100) % 10) + 48)
    run out.append(u32.toU8((milli / 10) % 10) + 48)
    run out.append(u32.toU8(milli % 10) + 48)
    run out.append(41)
  }
}

effect fn appendXmlEscaped(out: &mut List<u8>, text: &[u8], quote: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < text.length {
    let c = text[i]
    if c == 38 {
      run out.appendSlice(b"&amp;")
    } else if c == 60 {
      run out.appendSlice(b"&lt;")
    } else if c == 62 {
      run out.appendSlice(b"&gt;")
    } else if c == quote {
      // Replace conflicting quote inside font-family strings with the opposite quote so XML & CSS both parse cleanly.
      run out.append(if quote == 34 { 39 } else { 34 })
    } else {
      run out.append(c)
    }
    i = i + 1
  }
}

fn isBareNumber(text: &[u8]) -> bool {
  if text.length == 0 { return false }
  let mut i: usize = 0
  if text[0] == 43 || text[0] == 45 { i = 1 }
  let mut digits = false
  let mut dot = false
  while i < text.length {
    let c = text[i]
    if c >= 48 && c <= 57 {
      digits = true
    } else if c == 46 && !dot {
      dot = true
    } else {
      return false
    }
    i = i + 1
  }
  return digits
}

fn needsPxUnit(p: Property) -> bool {
  return p == Property.StrokeWidth || p == Property.StrokeDashoffset
}

effect fn resolveMarkupSvg(
  sheets: &mut StyleSheets,
  system: [Color; 19],
  tree: &UiTree<'_>,
  svgSlot: u32,
  raw: &[u8],
) -> List<u8> ! ResolverError | RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
  let doc = run parseXml(raw)
  let count = doc.elems.length()
  if count <= 1 { return List<u8>.make() }
  let adapter = MarkupSelectorTree {
    html: SelectorTree { tree: tree },
    svgSlot: u32.toUsize(svgSlot),
    base: tree.nodes.length(),
    doc: &doc,
    raw: raw,
  }
  let limits = Limits.make()
  let rootScope = tree.node(svgSlot).sheetScope()
  let rootColor = rgbaToColor(tree.node(svgSlot).computed().text.color)
  let mut scopes = List<Option<ScopeId>>.make()
  let mut elemColors = List<Color>.make()
  run scopes.append(rootScope)
  run elemColors.append(rootColor)
  let mut injections = List<Injection>.make()
  let mut winners = List<Winner>.make()
  let mut i: usize = 1
  while i < count {
    let e = doc.elems.asSlice()[i]
    let parentIdx = if e.parent == NO_ELEMENT { 0 } else { e.parent }
    let parentScope = scopes.asSlice()[parentIdx]
    let mut current = elemColors.asSlice()[parentIdx]
    let mut context = MatchContext.make(u32.toUsize(tree.root), NO_ELEMENT)
    run sheets.resolveWith(&adapter, adapter.base + i, &[], &mut context, false)
    let scope = run sheets.variableScopeWith(parentScope, &[], &limits)
    run scopes.append(Option<ScopeId>.some(scope))
    run collectWinners(&sheets.*, true, &mut winners)
    let mut css = List<u8>.make()
    // Resolve `color` first for `currentColor`.
    let mut wi: usize = 0
    while wi < winners.length() {
      let w = winners.asSlice()[wi]
      if w.property == Property.Color {
        let evaluated = run evaluateWinner(&sheets.*, scope, w, current, system)
        match move evaluated {
          EvalValue.Color { color } => {
            current = rgbaToColor(color)
            run css.appendSlice(b"color:")
            run appendRgbaCss(&mut css, color)
            run css.append(59)
          }
          EvalValue.Text { text } => {
            run css.appendSlice(b"color:")
            run appendXmlEscaped(&mut css, text.asSlice(), e.styleQuote)
            run css.append(59)
          }
          EvalValue.None => {}
        }
      }
      wi = wi + 1
    }
    run elemColors.append(current)
    wi = 0
    while wi < winners.length() {
      let w = winners.asSlice()[wi]
      if w.property != Property.Color {
        let evaluated = run evaluateWinner(&sheets.*, scope, w, current, system)
        let name = catalog.name(w.property)
        match move evaluated {
          EvalValue.Color { color } => {
            run css.appendSlice(name)
            run css.append(58)
            run appendRgbaCss(&mut css, color)
            run css.append(59)
          }
          EvalValue.Text { text } => {
            let trimmed = trimBytes(text.asSlice())
            if trimmed.length != 0 {
              run css.appendSlice(name)
              run css.append(58)
              run appendXmlEscaped(&mut css, trimmed, e.styleQuote)
              if needsPxUnit(w.property) && isBareNumber(trimmed) {
                run css.appendSlice(b"px")
              }
              run css.append(59)
            }
          }
          EvalValue.None => {}
        }
      }
      wi = wi + 1
    }
    if css.length() != 0 {
      run injections.append(Injection { pos: e.insertPos, hasStyle: e.hasStyle, quote: e.styleQuote, css: move css })
    }
    i = i + 1
  }
  if injections.length() == 0 { return List<u8>.make() }
  // Splice all injections in ascending source order.
  let mut out = List<u8>.make()
  let mut cursor: usize = 0
  let mut j: usize = 0
  while j < injections.length() {
    let inj = &injections.asSlice()[j]
    if inj.pos > cursor && inj.pos <= raw.length {
      run out.appendSlice(Slice.view<u8>(raw, cursor, inj.pos - cursor))
      cursor = inj.pos
    }
    if inj.hasStyle {
      run out.appendSlice(inj.css.asSlice())
    } else {
      run out.appendSlice(b" style=\"")
      run out.appendSlice(inj.css.asSlice())
      run out.append(34)
    }
    j = j + 1
  }
  if cursor < raw.length {
    run out.appendSlice(Slice.view<u8>(raw, cursor, raw.length - cursor))
  }
  return move out
}

fn hashBytes(data: &[u8]) -> u64 {
  let mut key: u64 = 14695981039346656037
  let mut i: usize = 0
  while i < data.length {
    key = Hash.combine(key, u8.toU64(data[i]))
    i = i + 1
  }
  return if key == 0 { 1 } else { key }
}

// ============================================================================
// Entry point called from `UiTree.paintFrame` / `UiTree.paintSubtree`
// ============================================================================

/// Resolves page CSS rules onto every visible live SVG and markup SVG icon node in the current root.
/// Skips unchanged and unrendered (`display: none`) SVGs using `UiTree.svgStylesPending`,
/// `UiTree.svgStyleRevision`, `StyledIconMarkup.revision`, and `LiveSvg.styleDirty`.
pub effect fn sync(tree: &mut UiTree<'_>) -> () ! OutOfMemoryError ? &mut Allocator {
  if !tree.svgStylesPending { return () }
  let at = style_sheets.index(tree.styleSheets.asSlice(), tree.current)
  if at == usize.MAX {
    tree.svgStylesPending = false
    return ()
  }
  if tree.styleSheets.asSlice()[at].sheets.length() == 0 && !tree.styleSheets.asSlice()[at].inlineVariables {
    tree.svgStylesPending = false
    return ()
  }
  tree.svgStylesPending = false
  let rev = tree.svgStyleRevision
  let count = tree.nodes.length()
  // Quick check: does any rendered live Icon node actually need work?
  let mut anyWork = false
  let mut slot: usize = 0
  while slot < count {
    let n = &tree.nodes.asSlice()[slot]
    if n.live && n.rendered && n.kind == NodeKind.Icon {
      if let Option<&LiveSvg>.Some { value: svg } = n.svg.get() {
        if svg.styleDirty || svg.styleRevision != rev {
          anyWork = true
          break
        }
      } else if n.resource != 0 && tree.resources.styledIconRevision(usize.toU32(slot), n.resource) != rev {
        anyWork = true
        break
      }
    }
    slot = slot + 1
  }
  if !anyWork {
    return ()
  }
  let oldStyled = Intrinsic.replace(tree.resources.styledIcons, List<StyledIconMarkup>.make())
  let mut roots = Intrinsic.replace(tree.styleSheets, List<RootSheets>.make())
  let mut nextStyled = List<StyledIconMarkup>.make()
  let mut oldCursor: usize = 0
  slot = 0
  while slot < count {
    let isIcon = tree.nodes.asSlice()[slot].live && tree.nodes.asSlice()[slot].kind == NodeKind.Icon
    if !isIcon {
      slot = slot + 1
      continue
    }
    let rendered = tree.nodes.asSlice()[slot].rendered
    let hasLiveSvg = tree.nodes.asSlice()[slot].svg.isSome()
    if hasLiveSvg {
      if rendered {
        let needs = match tree.nodes.asSlice()[slot].svg.get() {
          Option<&LiveSvg>.Some { value: svg } => svg.styleDirty || svg.styleRevision != rev
          _ => false
        }
        if needs {
          let entries = roots.asMutSlice()
          let resolved = match tree.nodes.asSlice()[slot].svg.get() {
            Option<&LiveSvg>.Some { value: svg } => run Effect.result(
              resolveLiveSvg(&mut entries[at].sheets, entries[at].systemColors, &tree.*, usize.toU32(slot), svg),
            )
            _ => Result<List<LiveResult>, ResolverError | RegistrationError | CssError | OutOfMemoryError>.Success { value: List<LiveResult>.make() }
          }
          match move resolved {
            Result<List<LiveResult>, ResolverError | RegistrationError | CssError | OutOfMemoryError>.Success { value: items } => {
              let mut list = move items
              let mut changed = false
              let svgMut = tree.nodeMut(usize.toU32(slot)).svg.expectMut()
              let mut ri: usize = 0
              while ri < list.length() {
                let item = Intrinsic.replace(
                  list.asMutSlice()[ri],
                  LiveResult { element: NO_SVG_ELEMENT, props: Props.make(), transform: Option<Affine>.None },
                )
                if svgMut.setSheetResult(item.element, move item.props, item.transform) {
                  changed = true
                }
                ri = ri + 1
              }
              svgMut.styleDirty = false
              svgMut.styleRevision = rev
              if changed {
                let target = tree.nodeMut(usize.toU32(slot))
                target.paintHash = Hash.combine(target.paintHash, 0x53564753)
                run tree.repair.nodes.append(usize.toU32(slot))
                tree.repair.pending = true
              }
            }
            Result<List<LiveResult>, ResolverError | RegistrationError | CssError | OutOfMemoryError>.Failure { error } => {
              tree.styleSheets = move roots
              tree.resources.styledIcons = move nextStyled
              match move error {
                OutOfMemoryError oom => { fail move oom }
                _ => { return () }
              }
            }
          }
        }
      }
    } else {
      let resource = tree.nodes.asSlice()[slot].resource
      if resource != 0 {
        let slotU32 = usize.toU32(slot)
        // Advance monotonic cursor in `oldStyled` (entries are in ascending slot order).
        while oldCursor < oldStyled.length() && oldStyled.asSlice()[oldCursor].slot < slotU32 {
          oldCursor = oldCursor + 1
        }
        let mut cachedIndex = usize.MAX
        if oldCursor < oldStyled.length() {
          let entry = &oldStyled.asSlice()[oldCursor]
          if entry.slot == slotU32 && entry.resource == resource {
            cachedIndex = oldCursor
          }
        }
        let currentHash = tree.nodes.asSlice()[slot].paintHash
        let mut base = currentHash
        // Unrendered icons keep their cached entry (if any) without resolving until visible.
        if !rendered {
          if cachedIndex != usize.MAX {
            let prev = &oldStyled.asSlice()[cachedIndex]
            let mut keptMarkup = List<u8>.make()
            run keptMarkup.appendSlice(prev.markup.asSlice())
            run nextStyled.append(StyledIconMarkup {
              slot: slotU32,
              resource: resource,
              revision: prev.revision,
              key: prev.key,
              markup: move keptMarkup,
              base: prev.base,
              mixed: prev.mixed,
            })
          }
          slot = slot + 1
          continue
        }
        if cachedIndex != usize.MAX {
          let prev = &oldStyled.asSlice()[cachedIndex]
          if prev.mixed == currentHash { base = prev.base }
          if prev.revision == rev {
            let mut keptMarkup = List<u8>.make()
            run keptMarkup.appendSlice(prev.markup.asSlice())
            let mixed = if keptMarkup.length() == 0 { base } else { Hash.combine(base, prev.key) }
            if mixed != currentHash {
              let target = tree.nodeMut(slotU32)
              target.paintHash = mixed
              run tree.repair.nodes.append(slotU32)
              tree.repair.pending = true
            }
            run nextStyled.append(StyledIconMarkup {
              slot: slotU32,
              resource: resource,
              revision: rev,
              key: prev.key,
              markup: move keptMarkup,
              base: base,
              mixed: mixed,
            })
            slot = slot + 1
            continue
          }
        }
        let raw = tree.resources.rawMarkup(resource)
        if raw.length != 0 {
          let entries = roots.asMutSlice()
          let resolved = run Effect.result(
            resolveMarkupSvg(&mut entries[at].sheets, entries[at].systemColors, &tree.*, slotU32, raw),
          )
          match move resolved {
            Result<List<u8>, ResolverError | RegistrationError | CssError | OutOfMemoryError>.Success { value: styled } => {
              let key = if styled.length() == 0 { 0 } else { hashBytes(styled.asSlice()) }
              let mixed = if styled.length() == 0 { base } else { Hash.combine(base, key) }
              if mixed != currentHash {
                let target = tree.nodeMut(slotU32)
                target.paintHash = mixed
                run tree.repair.nodes.append(slotU32)
                tree.repair.pending = true
              }
              run nextStyled.append(StyledIconMarkup {
                slot: slotU32,
                resource: resource,
                revision: rev,
                key: key,
                markup: move styled,
                base: base,
                mixed: mixed,
              })
            }
            Result<List<u8>, ResolverError | RegistrationError | CssError | OutOfMemoryError>.Failure { error } => {
              tree.styleSheets = move roots
              tree.resources.styledIcons = move nextStyled
              match move error {
                OutOfMemoryError oom => { fail move oom }
                _ => { return () }
              }
            }
          }
        }
      }
    }
    slot = slot + 1
  }
  tree.styleSheets = move roots
  tree.resources.styledIcons = move nextStyled
}
