    return Answer { support: "y", note: "" }
  }
  if id == "sharedarraybuffer" {
    return Answer { support: "a", note: "`SharedArrayBuffer` and `Atomics` work, but the default runtime has no workers to share a buffer with, and there `Atomics.wait` throws on the UI thread, as on a browser's main thread. With `App.runtime(Runtime.node())` it can wait." }
