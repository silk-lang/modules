//! Children (started by ext/spawn_sync, their exits watched on the runtime's reactor), synchronous
//! children without an event loop (ext/spawn_sync), IPC descriptors polled on the reactor, and
//! signals: one `silk.system.signal_watch` on the reactor, and SIGINT through ext/vm_interrupt's
//! broker. No handle is libuv's (the loop plan, step 7, in docs/composable-runtime.md).
//! Stdio ownership transfers to JS only after spawn succeeds. Teardown never kills children.
//! Host operations:
//! spawn/spawnSync(file, argvNul, envNul or null for the thread's process.env, cwd or null for this one's, fds, flags, uid, gid, callback/input, timeout, maxBuffer, killSignal).
//! Async returns [id,pid,...ownedParentFds], or a negative uv error; exit callback(code,signal).
//! Sync returns [uvError,pid,exitCode,signal,...capturedArrayBuffers], or a negative spawn error.
//! fds use -1 for socketpair pipes, -2 for ignore, and nonnegative inherited descriptors.
//! kill(id,signal), ref(id), unref(id); signalStart(signal,callback)->id, signalStop(id).
//! ipcOpen(fd,callback)->id takes ownership on success; callback(events,fd), events use UV_READABLE/WRITABLE.
//! ipcRead(fd)->[ArrayBuffer,receivedFd] or negative uv error; ipcWrite(fd,buffer,offset,length,sendFd)->bytes/error.
//! ipcEvents(id,events), ipcClose(id), closeFd(fd), errorName(status). IPC sendFd is borrowed.
import ext.system_errors as systemErrors
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value,  lendFor }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.concurrency.sync { Arc }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.isize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { NativeErrorKind }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import libs.core.owners { Scope }
import libs.core.owners as owners
import silkjs.js_std_support as host
import libs.core.common as common
import silkjs.js_promise as promise
import silkjs.js_buffer_storage as buffers
import silkjs.js_libc_platform as platform
import ext.os_abi as mem
import ext.process_abi as abi
import ext.fs_native { equal }
import ext.vm_interrupt { Observer, Service }
import ext.vm_interrupt
import ext.worker_native
import ext.sigint_trace
import silkjs.js_runtime as runtime
import ext.spawn_sync
import ext.fs_async
import silk.io.reactor { Interest, ReadyEvent }
import silk.system.signal_watch { SignalError, SignalWatch }
import silk.system.subprocess { ExitStatus, ExitWatch, SubprocessError }
@foreign(noCapture: .("status"))
unsafe extern "C" fn waitpid(pid:i32,status:*mut i32,options:i32)->i32
unsafe extern "C" fn kill(pid:i32,signal:i32)->i32
unsafe extern "C" fn raise(signal:i32)->i32
unsafe extern "C" fn fcntl(fd:i32,command:i32,...)->i32
// `watch` holds the signals that process.on listeners (signal handles) and the inspector's SIGUSR1
// activation take, as a reactor descriptor (signalfd or kqueue), opened at the first; `watchers`
// counts the open signal handles of each signal number. `debugCallback` is the activation,
// retained, which a SIGUSR1 listener pauses; `debugFired` says the last wait took a SIGUSR1 for it.
pub struct State { io:*mut fs_async.State, first:?*mut Handle, next:i32, polling:bool, closing:bool, workers:*mut worker_native.State, watchdog:Option<Arc<Service>>, trace:?*mut Handle, watch:Option<SignalWatch>, watchers:[u32;65], debugCallback:ValueBits, debugPaused:bool, debugFired:bool, sequence:u64 }
// The reactor token of the signal watch's descriptor; tokens below fs_async.DESCRIPTOR_TOKENS are fixed.
const SIGNAL_TOKEN:u64=2
// The reactor tokens of the handles' descriptors (a child's exit watch, an IPC descriptor): this
// base plus the handle id. Below fs_async.NET_TOKENS, above DNS's descriptor tokens.
const HANDLE_TOKENS:u64=2305843009213693952
// Handle kinds, as libuv's: a child (10) and an IPC descriptor (8) on the reactor, a signal (16) in
// the signal watch or, for SIGINT, an observer of the broker, as is the trace observer (17).
const CHILD:i32=10
const IPC:i32=8
const SIGNAL:i32=16
const TRACE:i32=17
// `fd` is the descriptor a child or IPC handle has in the reactor (-1 when none), `referenced` its
// ref state (as a libuv handle's), `exit` a child's exit watch, `pid` its process. A SIGINT handle
// and the trace observer are the broker's `observer`, whose wake is the loop's waker. `sequence`
// orders the handles with events by their arrival (0 for none), as libuv runs their callbacks.
struct Handle { sequence:u64, next:?*mut Handle, callback:ValueBits, id:i32, kind:i32, pending:i32, code:i64, signal:i32, closed:bool, delivered:bool, closing:bool, observer:Observer, fd:i32, referenced:bool, holding:bool, exit:Option<ExitWatch>, pid:i32 }
unsafe fn nn<T>(p:?*mut T)->*mut T { return unsafe Intrinsic.pointerRequalify<?*mut T,*mut T>(p) }
unsafe fn bytes<T>(p:*mut T)->*mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T,*mut u8>(p) }
fn undefined(v:ValueBits)->bool { return match v { ValueBits.Undefined=>true _=>false } }
fn number(v:ValueBits)->i32 { if v.isNumber() { return f64.toI32(v.numericValue()) } return 0 }
pub effect fn make(io:*mut fs_async.State,workers:*mut worker_native.State)->*mut State !OutOfMemoryError { let raw=unsafe mem.calloc(1,Layout.of<State>().bytes) if Pointer.isNull<u8>(raw) { fail OutOfMemoryError {} } let p=unsafe Intrinsic.pointerReinterpret<*mut u8,*mut State>(unsafe nn(raw)) unsafe Pointer.put<State>(p,State { io:io,first:Pointer.null<Handle>(),next:1,polling:false,closing:false,workers:workers,watchdog:Option<Arc<Service>>.none(),trace:Pointer.null<Handle>(),watch:Option<SignalWatch>.none(),watchers:[0;65],debugCallback:ValueBits.Undefined,debugPaused:false,debugFired:false,sequence:0 }) return p }
unsafe effect fn create(state:*mut State,kind:i32,callback:ValueBits)->*mut Handle !OutOfMemoryError {
  let allocation=unsafe mem.calloc(1,Layout.of<Handle>().bytes) if Pointer.isNull<u8>(allocation) { fail OutOfMemoryError {} }
  let raw=unsafe nn(allocation)
  let p=unsafe Intrinsic.pointerReinterpret<*mut u8,*mut Handle>(raw) let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state) let id=s.next s.next=id+1
  let wake=unsafe fs_async.wakerAddress(s.io)
  unsafe Pointer.put<Handle>(p,Handle { sequence:0,next:s.first,callback:unsafe callback.retained(),id:id,kind:kind,pending:0,code:0,signal:0,closed:false,delivered:false,closing:false,observer:Observer.make(wake),fd:-1,referenced:true,holding:false,exit:Option<ExitWatch>.none(),pid:0 }) s.first=p
  return p
}
// The next arrival number.
unsafe fn stamp(state:*mut State)->u64 { let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state) s.sequence=s.sequence+1 return s.sequence }
unsafe fn lookup(state:*mut State,id:i32)->?*mut Handle { let a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let mut p=s.first drop s while !Pointer.isNull<Handle>(p) { let h=unsafe Pointer.borrow<(),Handle>(&a,unsafe nn(p)) if h.id==id { return p } p=h.next } return Pointer.null<Handle>() }
unsafe effect fn vector(text:&List<u8>)->List<?*const u8> !OutOfMemoryError ?&mut Allocator { let mut result=List<?*const u8>.make() let data=text.asSlice() let mut i:usize=0 while i+1<data.length { run result.append(Pointer.fromRef<u8>(&data[i])) while i<data.length && data[i]!=0 { i=i+1 } i=i+1 } run result.append(Pointer.null<u8>()) return move result }
unsafe effect fn push<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:u32,value:ValueBits)->() !JsException ?&mut Allocator { run unsafe common.defineIndex(&mut engine,context,array,index,value) }
unsafe effect fn packed<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,value:ValueBits)->List<u8> !OutOfMemoryError|JsException ?&mut Allocator { let mut text=run host.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(value)) run text.append(0) return move text }
// null stands for the thread's own process.env, read natively instead of key by key in JavaScript.
unsafe effect fn environmentText<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,value:ValueBits)->List<u8> !OutOfMemoryError|JsException ?&mut Allocator {
  match value { ValueBits.Null=>{} _=>{ return run unsafe packed(&mut engine,context,value) } }
  let a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let workers=s.workers drop s
  let mut text=List<u8>.make() run unsafe worker_native.environmentEntries(workers,&mut text) return move text
}
// child_process.spawn: ext/spawn_sync starts the child (PATH search, posix_spawn, a fork for a user
// or group change, a new session when detached), and its exit descriptor (a pidfd on Linux, a
// kqueue on Darwin) joins the runtime's reactor, as libuv's process handle does with SIGCHLD.
unsafe effect fn spawn<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,args:&Scope,result:ValueBits)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let file=run host.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(args.values[0]))
  let arguments=run unsafe packed(&mut engine,context,args.values[1])
  let environment=run unsafe environmentText(&mut engine,context,state,args.values[2])
  let mut directory=List<u8>.make()
  match args.values[3] { ValueBits.Null=>{} _=>{ directory=run host.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(args.values[3])) if directory.length()==0 { return ValueBits.Int { value:-2 } } } }
  let countValue=run unsafe common.get(&mut engine,context,args.values[4],b"length") let count=number(countValue) unsafe owners.release(&mut engine,context,countValue)
  let mut slots=List<i32>.make()
  let mut i:i32=0 while i<count { let descriptor=run unsafe owners.getIndex(&mut engine,context,args.values[4],i32.toU32(i)) run slots.append(number(descriptor)) unsafe owners.release(&mut engine,context,descriptor) i=i+1 }
  let flags=number(args.values[5])
  let request=spawn_sync.Request { file:move file,arguments:move arguments,environment:move environment,directory:move directory,slots:move slots,
    detached:(flags&8)!=0,hasUser:(flags&1)!=0,user:f64.toU32(args.values[6].numericValue()),hasGroup:(flags&2)!=0,group:f64.toU32(args.values[7].numericValue()),
    input:List<u8>.make(),timeout:0.0,maximum:0.0,killSignal:0 }
  let mut parents=List<i32>.make()
  let pid=run unsafe spawn_sync.launch(&request,&mut parents)
  if pid<0 { return ValueBits.Int { value:pid } }
  let watched=run Effect.result(ExitWatch.open(pid))
  let watch=match move watched {
    Result<ExitWatch,SubprocessError>.Success { value }=>move value
    Result<ExitWatch,SubprocessError>.Failure { error }=>{
      // No exit descriptor (a kernel without pidfds): the child cannot be watched, so it ends now.
      let _killed=unsafe kill(pid,9) let mut status:i32=0 let _reaped=unsafe waitpid(pid,Pointer.fromMutRef<i32>(&mut status),0)
      let fds=parents.asSlice() let mut k:usize=0 while k<fds.length { if fds[k]>=0 { let _closed=unsafe abi.close(fds[k]) } k=k+1 }
      return ValueBits.Int { value:0-error.code }
    }
  }
  let hptr=run unsafe create(state,CHILD,args.values[8])
  let mut a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let io=s.io drop s
  let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,hptr) let id=h.id let fd=watch.descriptor() h.pid=pid h.fd=fd h.exit=Option<ExitWatch>.some(move watch) drop h
  let registered=unsafe fs_async.watchDescriptor(io,fd,HANDLE_TOKENS+i32.toU64(id),Interest.readOnly())
  if registered!=0 { Intrinsic.trap("a child's exit descriptor cannot join the runtime reactor") }
  unsafe holdFor(state,hptr)
  run unsafe push(&mut engine,context,result,0,ValueBits.Int { value:id }) run unsafe push(&mut engine,context,result,1,ValueBits.Int { value:pid })
  let fds=parents.asSlice()
  i=0 while i<count { run unsafe push(&mut engine,context,result,i32.toU32(i+2),ValueBits.Int { value:fds[i32.toUsize(i)] }) i=i+1 }
  return unsafe result.retained()
}
// A referenced child or IPC handle keeps the loop's reactor waiting, as a referenced libuv handle
// kept libuv's loop alive: it holds fs_async's loop while it is referenced and open.
unsafe fn holdFor(state:*mut State,p:*mut Handle)->() {
  let mut a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let io=s.io drop s
  let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,p)
  let want=h.referenced && !h.closing
  if want==h.holding { return () }
  h.holding=want drop h
  if want { unsafe fs_async.hold(io) } else { unsafe fs_async.unhold(io) }
}
// The events a ready IPC descriptor has, as libuv's poll reports them: UV_READABLE 1, UV_WRITABLE 2.
fn pollEvents(event:&ReadyEvent)->i64 {
  let mut events:i64=0
  if event.readable || event.hangup || event.error { events=events|1 }
  if event.writable { events=events|2 }
  return events
}
fn interestOf(events:i32)->Interest { return Interest { readable:(events&1)!=0, writable:(events&2)!=0 } }
// Takes the reactor's events for the children and IPC descriptors: a child that ended is
// collected (its exit reported once, as libuv's exit callback is), an IPC descriptor's events
// wait for JavaScript.
unsafe effect fn collectReady(state:*mut State)->() ?&mut Allocator {
  let mut a=() let s=unsafe Pointer.borrow<(),State>(&a,state) let io=s.io drop s
  let count=unsafe fs_async.readyCount(io) let mut index:usize=0
  while index<count {
    let event=unsafe fs_async.readyAt(io,index) index=index+1
    if event.token==SIGNAL_TOKEN { unsafe takeSignals(state) continue }
    if event.token<HANDLE_TOKENS || event.token>=fs_async.NET_TOKENS { continue }
    let p=unsafe lookup(state,u64.toI32(event.token-HANDLE_TOKENS)) if Pointer.isNull<Handle>(p) { continue }
    let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,unsafe nn(p))
    if h.closing || h.closed { continue }
    if h.kind==IPC { h.code=pollEvents(&event) h.pending=1 if h.sequence==0 { h.sequence=unsafe stamp(state) } continue }
    if h.kind!=CHILD { continue }
    let fd=h.fd h.fd=-1
    unsafe fs_async.forgetDescriptor(io,fd)
    h.code=0 h.signal=0
    if let Option<ExitWatch>.Some { value }=&h.exit {
      let collected=run Effect.result(value.collect())
      // libuv's exit callback: the exit code, or 0 and the signal that ended the child.
      if let Result<ExitStatus,SubprocessError>.Success { value:status }=move collected { if status.signaled { h.signal=status.signal } else { h.code=i32.toI64(status.code) } }
    }
    h.exit=Option<ExitWatch>.none()
    h.pending=1 h.closing=true h.closed=true if h.sequence==0 { h.sequence=unsafe stamp(state) } drop h
    unsafe holdFor(state,unsafe nn(p))
  }
  // The SIGINTs the broker counted, after the signals of the watch: a process that signals itself
  // flushes the broker after kill, so they arrived last.
  let first=unsafe Pointer.borrow<(),State>(&a,state) let mut observed=first.first drop first
  while !Pointer.isNull<Handle>(observed) {
    let h=unsafe Pointer.borrow<(),Handle>(&a,unsafe nn(observed)) let next=h.next let kind=h.kind drop h
    if kind==SIGNAL || kind==TRACE { unsafe takeObserved(state,unsafe nn(observed)) }
    observed=next
  }
}
// Reads the signals that arrived from the watch: each open handle of one counts it, as libuv's
// signal handle did, and a SIGUSR1 for the inspector's activation is noted for its drain.
unsafe fn takeSignals(state:*mut State)->() {
  let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
  let mut received:[i32;64]=[0;64] let mut count:usize=0
  if let Option<SignalWatch>.Some { value:watch }=&mut s.watch {
    let read=run Effect.result(watch.read(&mut received))
    if let Result<usize,SignalError>.Success { value }=move read { count=value }
  }
  let debug=!undefined(s.debugCallback) && !s.debugPaused
  let mut p=s.first drop s
  let mut i:usize=0
  while i<count {
    let signal=received[i] i=i+1
    if signal==SignalWatch.userOne() && debug { let d=unsafe Pointer.borrowMut<(),State>(&mut a,state) d.debugFired=true drop d }
    let mut cursor=p
    while !Pointer.isNull<Handle>(cursor) {
      let h=unsafe Pointer.borrowMut<(),Handle>(&mut a,unsafe nn(cursor))
      if h.kind==SIGNAL && h.signal==signal && h.signal!=2 && !h.closing { h.pending=h.pending+1 if h.sequence==0 { h.sequence=unsafe stamp(state) } }
      cursor=h.next drop h
    }
  }
  drop p
}
// spawnSync runs without libuv: see ext/spawn_sync.
unsafe effect fn spawnSync<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,args:&Scope,result:ValueBits)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let file=run host.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(args.values[0]))
  let arguments=run unsafe packed(&mut engine,context,args.values[1])
  let environment=run unsafe environmentText(&mut engine,context,state,args.values[2])
  let mut directory=List<u8>.make()
  match args.values[3] { ValueBits.Null=>{} _=>{ directory=run host.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(args.values[3])) if directory.length()==0 { return ValueBits.Int { value:-2 } } } }
  let countValue=run unsafe common.get(&mut engine,context,args.values[4],b"length") let count=number(countValue) unsafe owners.release(&mut engine,context,countValue)
  let mut slots=List<i32>.make()
  let mut i:i32=0 while i<count { let descriptor=run unsafe owners.getIndex(&mut engine,context,args.values[4],i32.toU32(i)) run slots.append(number(descriptor)) unsafe owners.release(&mut engine,context,descriptor) i=i+1 }
  let flags=number(args.values[5])
  let buffer=run buffers.getArrayBuffer(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(args.values[8]))
  let mut input=List<u8>.make()
  if buffer.byteLength>0 { run input.reserveExact(u64.toUsize(buffer.byteLength)) let mut at:u64=0 while at<buffer.byteLength { run input.append(u64.toU8(unsafe buffers.loadScalar(buffer,at,0))) at=at+1 } }
  let request=spawn_sync.Request { file:move file,arguments:move arguments,environment:move environment,directory:move directory,slots:move slots,
    detached:(flags&8)!=0,hasUser:(flags&1)!=0,user:f64.toU32(args.values[6].numericValue()),hasGroup:(flags&2)!=0,group:f64.toU32(args.values[7].numericValue()),
    input:move input,timeout:args.values[9].numericValue(),maximum:args.values[10].numericValue(),killSignal:number(args.values[11]) }
  let outcome=run unsafe spawn_sync.execute(&request)
  if outcome.pid<0 { return ValueBits.Int { value:outcome.pid } }
  run unsafe push(&mut engine,context,result,0,ValueBits.Int { value:outcome.error }) run unsafe push(&mut engine,context,result,1,ValueBits.Int { value:outcome.pid })
  run unsafe push(&mut engine,context,result,2,ValueBits.number(i32.toF64(outcome.status.code))) run unsafe push(&mut engine,context,result,3,ValueBits.Int { value:outcome.status.signal })
  let outputs=outcome.outputs.asSlice()
  let mut slot:usize=0
  while slot<outputs.length {
    let output=outputs[slot].asSlice()
    let mut data:?*const u8=Pointer.null<u8>()
    if output.length>0 { data=Pointer.fromRef<u8>(&output[0]) }
    let memory=engine.memory
    let value=run unsafe buffers.newArrayBufferCopy(&mut engine,memory,unsafe lendRealm(&context, context),data,usize.toU64(output.length))
    run unsafe push(&mut engine,context,result,usize.toU32(slot+4),value)
    slot=slot+1
  }
  return unsafe result.retained()
}
// The process state owns the broker lease. Its borrowed worker state outlives
// process.close; no cross-isolate JavaScript value enters the native broker.
unsafe effect fn acquireSignalService(state:*mut State)->i32 !OutOfMemoryError {
  let mut anchor=() let current=unsafe Pointer.borrow<(),State>(&anchor,state)
  if let Option<Arc<Service>>.Some { .. }=&current.watchdog { return 0 }
  let workers=current.workers drop current
  let acquired=run Effect.result(unsafe worker_native.vmWatchdog(workers))
  return match move acquired {
    Result<Arc<Service>,OutOfMemoryError|vm_interrupt.StartError>.Success { value }=>{
      let current=unsafe Pointer.borrowMut<(),State>(&mut anchor,state)
      current.watchdog=Option<Arc<Service>>.some(move value)
      0
    }
    Result<Arc<Service>,OutOfMemoryError|vm_interrupt.StartError>.Failure { error }=>match move error {
      OutOfMemoryError {}=>{ fail OutOfMemoryError {} }
      vm_interrupt.StartError { code }=>if code<0 { code } else { 0-code }
    }
  }
}
unsafe fn signalObserver(state:*mut State,pointer:*mut Handle,active:bool)->i32 {
  let ownerAnchor=() let mut anchor=() let current=unsafe Pointer.borrow<(),State>(&ownerAnchor,state)
  let watcher=match &current.watchdog {
    Option<Arc<Service>>.Some { value }=>value.get()
    _=>{ Intrinsic.trap("SIGINT observer has no service owner") }
  }
  let handle=unsafe Pointer.borrowMut<(),Handle>(&mut anchor,pointer)
  let observer=Pointer.fromMutRef<Observer>(&mut handle.observer)
  drop handle
  if active { return unsafe vm_interrupt.observe(watcher,observer) }
  unsafe vm_interrupt.unobserve(watcher,observer)
  return 0
}
// Takes the SIGINTs the broker counted for an observer since the last poll, as libuv's async
// callback did: a trace observer notes that one arrived while the loop was idle.
unsafe fn takeObserved(state:*mut State,pointer:*mut Handle)->() {
  let mut anchor=() let handle=unsafe Pointer.borrowMut<(),Handle>(&mut anchor,pointer)
  if handle.closing || !handle.observer.linked { return () }
  let pending=vm_interrupt.takePending(&mut handle.observer)
  handle.pending=i32.wrappingAdd(handle.pending,u32.toI32(pending))
  if pending!=0 && handle.sequence==0 { handle.sequence=unsafe stamp(state) }
  if handle.kind==TRACE && pending!=0 { handle.code=1 }
}
// Opens the signal watch and adds its descriptor to the reactor, at the first signal: 0, or a
// negative errno.
unsafe fn openWatch(state:*mut State)->i32 {
  let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
  if s.watch.isSome() { return 0 }
  let opened=run Effect.result(SignalWatch.open())
  let watch=match move opened { Result<SignalWatch,SignalError>.Success { value }=>move value Result<SignalWatch,SignalError>.Failure { error }=>{ return signalCode(move error) } }
  let registered=unsafe fs_async.watchDescriptor(s.io,watch.descriptor(),SIGNAL_TOKEN,Interest.readOnly())
  if registered!=0 { return -registered }
  s.watch=Option<SignalWatch>.some(move watch)
  return 0
}
// Puts `signal` in the watch while a handle of it is open, or (SIGUSR1) while the inspector's
// activation is started and not paused, and takes it out otherwise: 0, or a negative errno.
unsafe fn settle(state:*mut State,signal:i32)->i32 {
  let opened=unsafe openWatch(state) if opened!=0 { return opened }
  let mut a=() let s=unsafe Pointer.borrowMut<(),State>(&mut a,state)
  let debug=signal==SignalWatch.userOne() && !undefined(s.debugCallback) && !s.debugPaused
  let wanted=s.watchers[i32.toUsize(signal)]>0 || debug
  if let Option<SignalWatch>.Some { value:watch }=&mut s.watch {
    if wanted==watch.contains(signal) { return 0 }
    let changed=if wanted { run Effect.result(watch.add(signal)) } else { run Effect.result(watch.remove(signal)) }
    if let Result<(),SignalError>.Failure { error }=move changed { return signalCode(move error) }
  }
  return 0
}
unsafe fn stopSignal(state:*mut State,pointer:*mut Handle)->i32 {
  let anchor=() let handle=unsafe Pointer.borrow<(),Handle>(&anchor,pointer)
  let broker=handle.signal==2 || handle.kind==TRACE let signal=handle.signal drop handle
  if broker { return unsafe signalObserver(state,pointer,false) }
  let mut held=() let s=unsafe Pointer.borrowMut<(),State>(&mut held,state)
  let index=i32.toUsize(signal) if s.watchers[index]>0 { s.watchers[index]=s.watchers[index]-1 } drop s
  return unsafe settle(state,signal)
}
// The trace observer uses the same broker as VM guards and process listeners.
// Its stable unreferenced async handle persists across enable/disable cycles.
unsafe effect fn traceEnable(state:*mut State,enable:bool)->i32 !OutOfMemoryError {
  let mut anchor=() let current=unsafe Pointer.borrow<(),State>(&anchor,state)
  let mut pointer=current.trace drop current
