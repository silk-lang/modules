//! [`Backend`]: what a client such as Loom needs from the thing that shows its UI: it takes
//! mutation batches and gives event records back. ui-tree is one; a browser document is another.
import mutation { Mutation }
import record { Event }
import root { RootEvent, RootSupport }
import options { VirtualRange }
import error { TreeError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Where a node is and what the pointer and focus do to it, for `ui.anchorRect`.
pub struct Measured {
  pub bounds: Rect<f32>,
  pub pressed: bool,
  pub hovered: bool,
  pub focused: bool,
}

impl Copy for Measured {}

/// Shows the UI: takes mutation batches, gives event records back.
pub interface Backend {
  /// Applies one render's mutations, in order.
  effect fn mutate(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator

  /// Offered the mutations of a render made so far when there are many, so that a large
  /// render does not hold them all at once. A backend that copies what it needs out of a
  /// batch (`copiesBatches`) may take them, in order, and leave `batch` empty: the rest come
  /// in later calls and in `mutate`, which ends the render. The default takes nothing.
  effect fn mutateEarly(self: &mut Self, batch: &mut List<Mutation>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return ()
  }

  /// Moves the event records that wait into `out`, oldest first.
  effect fn events(self: &mut Self, out: &mut List<Event>) -> () ! OutOfMemoryError ? &mut Allocator

  /// Moves the root events that wait into `out`, oldest first. A backend that reports none
  /// has nothing to move.
  effect fn rootEvents(self: &mut Self, out: &mut List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return ()
  }

  /// The viewport of root `root`, in CSS pixels.
  fn viewport(self: &Self, root: u32) -> Rect<f32>

  /// How many roots the backend shows and what a root past the first becomes. One it cannot
  /// show gets a `Failed` root event when it is opened.
  fn roots(self: &Self) -> RootSupport

  /// The layout box of node `id`, if it has one.
  effect fn measure(self: &Self, id: u32) -> Option<Measured> ! OutOfMemoryError ? &mut Allocator

  /// The item range virtual list `id` wants. A backend without virtual lists has none.
  fn range(self: &Self, id: u32) -> Option<VirtualRange> {
    return Option<VirtualRange>.None
  }

  /// The sorted item indices virtual list `id` wants mounted, written to `out` (cleared
  /// first): the range around the viewport and any retained focus, active-descendant or
  /// browse-cursor rows. False for no list. The default reads `range`.
  effect fn indices(self: &Self, id: u32, out: &mut List<usize>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    return match self.range(id) {
      Option<VirtualRange>.Some { value } => {
        let mut i = value.first
        if value.pinned < value.first && value.pinned < value.count {
          run out.append(value.pinned)
        }
        while i < value.end {
          run out.append(i)
          i = i + 1
        }
        if value.pinned >= value.end && value.pinned < value.count {
          run out.append(value.pinned)
        }
        true
      }
      Option<VirtualRange>.None => false
    }
  }

  /// Whether `mutate` copies what it needs out of a batch and keeps none of its values, as a
  /// backend that encodes batches for another process does. The runtime then makes the text
  /// of a batch in a scratch allocator it resets every render, which is cheaper than the heap.
  /// A backend that keeps strings or lists of a batch (as ui-tree does) says no.
  fn copiesBatches(self: &Self) -> bool {
    return false
  }

  /// The app followed a link to `path`. A backend with an address bar shows it there.
  fn navigate(self: &mut Self, path: string) -> () {
    return ()
  }
}
