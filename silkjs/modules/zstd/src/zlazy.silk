@inlineNever
pub unsafe fn compressBlockLazy2DictMatchState(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  return unsafe lazyDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, SEARCH_HC, 2)
}
