//! TypeScript stripping with amaro: the runtime's real `TypeStripping` capability.
//!
//! A program that provides `Amaro` depends on this package, and so embeds amaro's JavaScript
//! (amaro_sources.c); a program that provides `EmptyTypeStripping` holds none of it.
import silk.core.ownership { Copy }
import silkjsruntime.libs.core.capabilities { TypeStripping }

unsafe extern "C" fn silk_type_stripping_sources_linked() -> i32

/// amaro, which runs on WebAssembly.
pub struct Amaro {}
impl Copy for Amaro {}

impl TypeStripping for Amaro {
  static fn present() -> bool { return true }
  fn link(self: &Self) -> () {
    // The call is what links amaro_sources.c, which installs amaro's sources in the core's table.
    let _linked = unsafe silk_type_stripping_sources_linked()
  }
}
