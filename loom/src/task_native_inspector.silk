import silk.build.graph { BuildError }

static if Intrinsic.targetOperatingSystem() == "darwin"
  || Intrinsic.targetOperatingSystem() == "linux" {
  import silk.cli.task { Task, TaskError }
  import silk.collections.bytes { Bytes }
  import silk.collections.list { List }
  import silk.core.effect { Effect }
  import silk.core.option { Option }
  import silk.core.result { Result }
  import silk.io.writer { Writer, WriterError }
  import silk.io.writer_native { StdoutWriter }
  import silk.json.scanner { JsonError }
  import silk.json.value { Json, Value }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.system.child_process { ChildProcess, ProcessError }
  import silk.system.filesystem { FileError, FileSystem, Path }
  import silk.system.host_input { HostInput, HostInputError }
  import silk.text.string { String, InvalidUtf8 }
  import silk.num.i32
  import src.task_support { build, silkuiPackage, rootPath, pathText, require }
  import src.task_native_process {
    Process,
    Output,
    start,
    finish,
    poll,
    pause,
    milliseconds,
    execute,
    removeSocket
  }
  import src.task_native_display { Display, openDisplay, closeDisplay, joined, decimal, views }

  pub struct App {
    pub child: Process,
    pub socket: Path
  }

  pub effect fn say(message: string) -> ()
    ! WriterError {
    let mut writer = StdoutWriter.make()
    run Writer.writeString(message) |> Effect.provideMut<Writer>(&mut writer)
    run Writer.writeString("\n") |> Effect.provideMut<Writer>(&mut writer)
  }

  pub effect fn expect(condition: bool, message: string) -> ()
    ! TaskError | OutOfMemoryError | WriterError
    ? &mut Allocator {
    run require(condition, message)
    let mut writer = StdoutWriter.make()
    run Writer.writeString("ok: ") |> Effect.provideMut<Writer>(&mut writer)
    run Writer.writeString(message) |> Effect.provideMut<Writer>(&mut writer)
    run Writer.writeString("\n") |> Effect.provideMut<Writer>(&mut writer)
  }

  pub effect fn utf8(bytes: &[u8]) -> string
    ! TaskError | OutOfMemoryError
    ? &mut Allocator {
    return match String.fromUtf8(bytes) {
      Result<string, InvalidUtf8>.Success { value } => value
      Result<string, InvalidUtf8>.Failure { .. } => run Task.abort("Inspector output is not UTF-8")
    }
  }

  pub effect fn json(bytes: &[u8]) -> Value
    ! TaskError | OutOfMemoryError
    ? &mut Allocator {
    return match move run Effect.result(Json.parse(bytes)) {
      Result<Value, JsonError | OutOfMemoryError>.Success { value } => move value
      Result<Value, JsonError | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError failure => {
          fail move failure
        }
        JsonError _error => run Task.abort("Invalid inspector JSON")
      }
    }
  }

  pub effect fn field<'a>(value: &'a Value, name: string) -> &'a Value
    ! TaskError | OutOfMemoryError
    ? &mut Allocator {
    return match Json.field(value, name) {
      Option<&Value>.Some { value: found } => found
      Option<&Value>.None => run Task.abort("Missing inspector JSON field")
    }
  }

  pub effect fn array(value: &Value) -> &[Value]
    ! TaskError | OutOfMemoryError
    ? &mut Allocator {
    return match &value.* {
      Value.Array { values } => values.asSlice()
      _ => run Task.abort("Expected inspector JSON array")
    }
  }

  pub fn number(value: &Value, name: string) -> i32 {
    return Json.field(value, name)
      |> Json.asI32
      |> Option<i32>.unwrapOr(-1)
  }

  pub fn stringField<'a>(value: &'a Value, name: string) -> string<'a> {
    return Json.field(value, name)
      |> Json.asString
      |> Option<string<'a>>.unwrapOr("")
  }

  pub fn truth(value: &Value, name: string) -> bool {
    return match Json.field(value, name) {
      Option<&Value>.Some { value: found } => match &found.* {
        Value.Bool { value: flag } => flag
        _ => false
      }
      Option<&Value>.None => false
    }
  }

  pub fn png(bytes: &[u8]) -> bool {
    let signature: [u8; 8] = [137, 80, 78, 71, 13, 10, 26, 10]
    if bytes.length < 8 {
      return false
    }
    let mut at: usize = 0
    while at < 8 {
      if bytes[at] != signature[at] {
        return false
      }
      at = at + 1
    }
    return true
  }

  pub effect fn picture(path: &Path) -> ()
    ! TaskError | FileError | OutOfMemoryError | WriterError
    ? &mut Allocator | &mut FileSystem {
    let bytes = run FileSystem.readFile(path)
    run expect(png(Bytes.asSlice(&bytes)), "PNG screenshot")
  }

  pub effect fn command(cli: string, socket: &Path, args: &[string], env: &[string]) -> Output
    ! TaskError | FileError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let mut arguments = List<string>.make()
    run arguments.append("--connect")
    run arguments.append(pathText(socket))
    let mut at: usize = 0
    while at < args.length {
      run arguments.append(args[at])
      at = at + 1
    }
    let mut child = run start(cli, arguments.asSlice(), env, true, false, true)
    return run finish(&mut child, 60000)
  }

  pub effect fn commandJson(cli: string, app: &App, args: &[string], env: &[string]) -> Value
    ! TaskError | FileError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let output = run command(cli, &app.socket, args, env)
    if output.code != 0 {
      let error = run utf8(Bytes.asSlice(&output.errors))
      if error != "" {
        run Task.abort(error)
      }
      run Task.abort("Inspector command failed")
    }
    return run json(Bytes.asSlice(&output.output))
  }

  pub effect fn program(
    name: string,
    binary: string,
    args: &[string],
    env: &[string],
    cli: string,
  ) -> App
    ! TaskError | FileError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let work = run rootPath(".cache/ui-inspect")
    run FileSystem.createDirectoriesRecursively(&work)
    let filename = run joined(name, ".sock")
    let socket = run Path.join(&work, String.view(&filename))
    run removeSocket(&socket)
    let assignment = run joined("SILK_UI_INSPECT=", pathText(&socket))
    let mut environment = List<string>.make()
    let mut at: usize = 0
    while at < env.length {
      run environment.append(env[at])
      at = at + 1
    }
    run environment.append(String.view(&assignment))
    let mut child = run start(binary, args, environment.asSlice(), false, false, true)
    let deadline = milliseconds() + 120000
    while true {
      let hello = run command(cli, &socket, &["hello"], env)
      if hello.code == 0 {
        break
      }
      if run poll(&mut child) {
        run Task.abort("Application exited before inspector became ready")
      }
      if milliseconds() >= deadline {
        run Task.abort("Timed out waiting for application inspector")
      }
      pause()
    }
    return App { child: move child, socket: move socket }
  }

  /// The todo demo with the devtools in its own process: the socket inspector still sees the app
  /// alone, with the devtools' root hidden, in a window of their own and docked.
  effect fn embeddedWith(binary: string, cli: string, display: &Display) -> ()
    ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let environment = run views(&display.environment)
    let mut windowed = List<string>.make()
    let mut docked = List<string>.make()
    let mut at: usize = 0
    while at < environment.length() {
      run windowed.append(environment.get(at))
      run docked.append(environment.get(at))
      at = at + 1
    }
    run windowed.append("SILK_UI_DEVTOOLS=window")
    run docked.append("SILK_UI_DEVTOOLS=dock")
    let env = environment.asSlice()
    let app = run program("embedded", binary, &[], windowed.asSlice(), cli)
    let hello = run commandJson(cli, &app, &["hello"], env)
    let roots = run array(run field(&hello, "roots"))
    run expect(roots.length == 1, "embedded devtools: the app's root alone is listed")
    let hidden = run array(run field(&hello, "hidden"))
    run expect(hidden.length == 1, "embedded devtools: their root is open and hidden")
    let snapshot = run command(cli, &app.socket, &["snapshot"], env)
    let text = run utf8(Bytes.asSlice(&snapshot.output))
    run expect(
      String.contains(text, "role=button label=\"Add\"") || String.contains(text, "\"Add\""),
      "embedded devtools: the app's tree is the todo",
    )
    run expect(
      !String.contains(text, "Silk devtools") && !String.contains(text, "element-"),
      "embedded devtools: none of their nodes",
    )
    let rows = run commandJson(cli, &app, &["query", "--test-id", "element-1"], env)
    run expect(number(&rows, "count") == 0, "embedded devtools: no query finds their rows")
    let add = run command(
      cli,
      &app.socket,
      &["click", "--role", "button", "--name", "Add", "--exact"],
      env,
    )
    run expect(add.code == 0, "embedded devtools: click Add in todo")
    let task = run command(
      cli,
      &app.socket,
      &["wait", "--text", "Task 4", "--timeout", "10000"],
      env,
    )
    run expect(task.code == 0, "embedded devtools: todo displays the new task")
    run waitMilliseconds(500)
    let quiet = run commandJson(cli, &app, &["hello"], env)
    run waitMilliseconds(1000)
    let later = run commandJson(cli, &app, &["hello"], env)
    run expect(
      number(&quiet, "frame") == number(&later, "frame"),
      "embedded devtools: an idle app draws no frames",
    )
    drop app
    let dock = run program("embedded-dock", binary, &[], docked.asSlice(), cli)

    // The first frame can be laid out before the dock takes its share of the window.
    let mut narrow = run commandJson(cli, &dock, &["hello"], env)
    let settle = milliseconds() + 10000
    while !(number(&narrow, "height") > 0 && number(&narrow, "height") < 300)
      && milliseconds() < settle {
      pause()
      narrow = run commandJson(cli, &dock, &["hello"], env)
    }
    run expect(
      number(&narrow, "height") > 0 && number(&narrow, "height") < 300,
      "docked devtools: the app lays out above the dock",
    )
    let aside = run array(run field(&narrow, "hidden"))
    run expect(aside.length == 1, "docked devtools: their root is hidden")
    let shot = run rootPath(".cache/ui-inspect/embedded-dock.png")
    let image = run command(cli, &dock.socket, &["screenshot", pathText(&shot)], env)
    run expect(image.code == 0, "docked devtools: the app's screenshot")
    run picture(&shot)
  }

  effect fn waitMilliseconds(span: i64) -> () {
    let start = milliseconds()
    while milliseconds() - start < span {
      pause()
    }
  }

  /// How many times `needle` is in `text`.
  fn occurrences(text: string, needle: string) -> usize {
    let bytes = String.utf8Bytes(text)
    let wanted = String.utf8Bytes(needle)
    let mut count: usize = 0
    let mut at: usize = 0
    while at + wanted.length <= bytes.length {
      let mut same = true
      let mut i: usize = 0
      while i < wanted.length {
        if bytes[at + i] != wanted[i] {
          same = false
          break
        }
        i = i + 1
      }
      if same {
        count = count + 1
        at = at + wanted.length
      } else {
        at = at + 1
      }
    }
    return count
  }

  /// The reader on a stack of screens, in a real window: a click shows the next screen before
  /// its two second loader ran, back works while it loads and drops the load, and the feed
  /// keeps its scroll under the article.
  effect fn navigationWith(binary: string, cli: string, display: &Display) -> ()
    ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let environment = run views(&display.environment)
    let env = environment.asSlice()
    let app = run program("navigation", binary, &[], env, cli)
    let feed = run command(cli, &app.socket, &["wait", "--role", "button", "--name", "Article 12", "--timeout", "10000"], env)
    run expect(feed.code == 0, "navigation: the feed loads on a worker")
    let scrolled = run command(cli, &app.socket, &["scroll", "--test-id", "feed", "--dy", "400"], env)
    run expect(scrolled.code == 0, "navigation: the feed scrolls")

    // The click's own reply comes after the update and its render, and before the loader.
    let began = milliseconds()
    let open = run command(
      cli,
      &app.socket,
      &["click", "--role", "button", "--name", "Article 12", "--exact"],
      env,
    )
    run expect(open.code == 0, "navigation: click an article")
    let shell = run command(cli, &app.socket, &["snapshot"], env)
    let took = milliseconds() - began
    let shown = run utf8(Bytes.asSlice(&shell.output))
    run expect(
      String.contains(shown, "Loading the article") && !String.contains(shown, "testId=\"title\""),
      "navigation: the article's shell shows before its loader ran",
    )
    run expect(took < 1000, "navigation: and long before the two seconds the loader takes")

    // Back while it loads, once the screen slid in and its button can be reached.
    run waitMilliseconds(500)
    let back = run command(cli, &app.socket, &["click", "--test-id", "back"], env)
    run expect(back.code == 0, "navigation: back answers while the article loads")
    run waitMilliseconds(2600)
    let after = run command(cli, &app.socket, &["snapshot"], env)
    let feedAgain = run utf8(Bytes.asSlice(&after.output))
    run expect(
      !String.contains(feedAgain, "Loading the article") && !String.contains(feedAgain, "testId=\"title\""),
      "navigation: the article left",
    )
    run expect(String.contains(feedAgain, "scroll=0,400"), "navigation: the feed kept its scroll")
    let steps = run command(cli, &app.socket, &["silk-ui.messages", "--since", "0"], env)
    let journal = run utf8(Bytes.asSlice(&steps.output))
    run expect(
      occurrences(journal, "message: Loaded") == 1,
      "navigation: the load of the screen that left was dropped",
    )

    // An article that loads, and a sheet over it.
    let again = run command(
      cli,
      &app.socket,
      &["click", "--role", "button", "--name", "Article 12", "--exact"],
      env,
    )
    run expect(again.code == 0, "navigation: open the article again")
    // The inspector lists the load while it runs, under the screen that owns it.
    let busy = run command(cli, &app.socket, &["silk-ui.program"], env)
    let program = run utf8(Bytes.asSlice(&busy.output))
    run expect(
      String.contains(program, "\"work\":[\"running ") && String.contains(program, " for 1:"),
      "navigation: the running load is listed with its screen",
    )
    let loaded = run command(cli, &app.socket, &["wait", "--test-id", "title", "--timeout", "10000"], env)
    run expect(loaded.code == 0, "navigation: the article loads")
    let share = run command(cli, &app.socket, &["click", "--test-id", "share"], env)
    run expect(share.code == 0, "navigation: open the share sheet")
    run waitMilliseconds(600)
    let sheet = run command(cli, &app.socket, &["snapshot"], env)
    let over = run utf8(Bytes.asSlice(&sheet.output))
    run expect(
      String.contains(over, "Copy the link") && String.contains(over, "testId=\"title\""),
      "navigation: the article stays under the sheet",
    )
    let shot = run rootPath(".cache/ui-inspect/navigation.png")
    let image = run command(cli, &app.socket, &["screenshot", pathText(&shot)], env)
    run expect(image.code == 0, "navigation: the sheet's screenshot")
    run picture(&shot)
    let copy = run command(cli, &app.socket, &["click", "--test-id", "copy"], env)
    run expect(copy.code == 0, "navigation: a command on a worker asks the shell")
    let copied = run command(cli, &app.socket, &["wait", "--text", "Link copied", "--timeout", "10000"], env)
    run expect(copied.code == 0, "navigation: and the window does it")
    let done = run command(cli, &app.socket, &["click", "--test-id", "done"], env)
    run expect(done.code == 0, "navigation: close the sheet")
    run waitMilliseconds(600)
    let closed = run command(cli, &app.socket, &["snapshot"], env)
    let under = run utf8(Bytes.asSlice(&closed.output))
    run expect(
      !String.contains(under, "Copy the link") && String.contains(under, "testId=\"title\""),
      "navigation: the sheet left and the article is on top",
    )

    // The keyboard: Escape is a close request and closes the sheet only; the back key is a
    // navigate request and pops the article. Both come from the tree, not from key handlers.
    let shareAgain = run command(cli, &app.socket, &["click", "--test-id", "share"], env)
    run expect(shareAgain.code == 0, "navigation: open the sheet again")
    let reopened = run command(cli, &app.socket, &["wait", "--test-id", "copy", "--timeout", "10000"], env)
    run expect(reopened.code == 0, "navigation: the sheet is back")
    run waitMilliseconds(500)
    let escape = run command(cli, &app.socket, &["press", "Escape"], env)
    run expect(escape.code == 0, "navigation: press Escape")
    run waitMilliseconds(600)
    let afterEscape = run command(cli, &app.socket, &["snapshot"], env)
    let kept = run utf8(Bytes.asSlice(&afterEscape.output))
    run expect(
      !String.contains(kept, "Copy the link") && String.contains(kept, "testId=\"title\""),
      "navigation: Escape closes the sheet and leaves the article",
    )
    // A link pushes the screen its path names: one back then leaves the first article on top.
    let link = run command(cli, &app.socket, &["click", "--test-id", "related"], env)
    run expect(link.code == 0, "navigation: click the link to a related article")
    run waitMilliseconds(1200)
    let afterPush = run command(cli, &app.socket, &["snapshot"], env)
    let pushed = run utf8(Bytes.asSlice(&afterPush.output))
    run expect(String.contains(pushed, "testId=\"loading\""), "navigation: the link pushed an article")
    let linkBack = run command(cli, &app.socket, &["press", "BrowserBack"], env)
    run expect(linkBack.code == 0, "navigation: back from the linked article")
    run waitMilliseconds(1200)
    let afterLink = run command(cli, &app.socket, &["snapshot"], env)
    let linked = run utf8(Bytes.asSlice(&afterLink.output))
    run expect(
      String.contains(linked, "testId=\"title\"") && !String.contains(linked, "testId=\"loading\""),
      "navigation: back popped it and left the first article on top",
    )
    let key = run command(cli, &app.socket, &["press", "BrowserBack"], env)
    run expect(key.code == 0, "navigation: press the back key")
    run waitMilliseconds(1200)
    let afterBack = run command(cli, &app.socket, &["snapshot"], env)
    let list = run utf8(Bytes.asSlice(&afterBack.output))
    run expect(
      !String.contains(list, "testId=\"title\"") && String.contains(list, "testId=\"feed\""),
      "navigation: the back key pops the article",
    )

    // The heavy article keeps the UI thread busy for 1.2 seconds as it opens.
    let down = run command(cli, &app.socket, &["scroll", "--test-id", "feed", "--dy", "3000"], env)
    run expect(down.code == 0, "navigation: scroll to the end of the feed")
    run waitMilliseconds(1200)
    let heavy = run command(
      cli,
      &app.socket,
      &["click", "--role", "button", "--name", "Article 31", "--exact"],
      env,
    )
    run expect(heavy.code == 0, "navigation: open the article that stalls the window")
    run waitMilliseconds(3500)
    let opened = run command(cli, &app.socket, &["snapshot"], env)
    let settled = run utf8(Bytes.asSlice(&opened.output))
    run expect(String.contains(settled, "testId=\"title\""), "navigation: it opened")
  }

  pub effect fn navigation() -> ()
    ! BuildError
      | TaskError
      | ProcessError
      | FileError
      | HostInputError
      | OutOfMemoryError
      | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let binary = run build("modules/loom-navigation/demo", false, false)
    let cli = run silkuiPackage("modules/inspect/cli")
    let display = run openDisplay("x11")
    let result = run Effect.result(navigationWith(String.view(&binary), String.view(&cli), &display))
    run closeDisplay(move display)
    if let Result<
      (),
      TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
    >.Failure {
      error
    } = move result {
      fail move error
    }
  }

  pub effect fn embedded() -> ()
    ! BuildError
      | TaskError
      | ProcessError
      | FileError
      | HostInputError
      | OutOfMemoryError
      | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let binary = run build("modules/loom/demo", false, false)
    let cli = run silkuiPackage("modules/inspect/cli")
    let display = run openDisplay("x11")
    let result = run Effect.result(embeddedWith(String.view(&binary), String.view(&cli), &display))
    run closeDisplay(move display)
    if let Result<
      (),
      TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
    >.Failure {
      error
    } = move result {
      fail move error
    }
  }

  effect fn devtoolsCheck(app: &App, tools: &App, cli: string, env: &[string]) -> ()
    ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let query = run commandJson(
      cli,
      app,
      &["query", "--role", "button", "--name", "Add", "--exact"],
      env,
    )
    let nodes = run array(run field(&query, "nodes"))
    run expect(nodes.length == 1, "todo has one Add button")
    let button = number(&nodes[0], "id")
    run require(button >= 0, "Add button has invalid id")
    let id = run decimal(i32.toUsize(button))
    let row = run joined("element-", String.view(&id))
    let listed = run command(
      cli,
      &tools.socket,
      &["wait", "--test-id", String.view(&row), "--timeout", "20000"],
      env,
    )
    run expect(listed.code == 0, "devtools lists Add element")
    let snapshot = run command(cli, &tools.socket, &["snapshot"], env)
    let snapshotText = run utf8(Bytes.asSlice(&snapshot.output))
    run expect(
      String.contains(snapshotText, "label=\"button \\\"Add\\\"\"")
        && !String.contains(snapshotText, "cannot reach"),
      "devtools labels role/name and has no connection error",
    )
    let selected = run command(cli, &tools.socket, &["click", "--test-id", String.view(&row)], env)
    run expect(selected.code == 0, "select Add row")
    let deadline = milliseconds() + 15000
    while true {
      let hello = run commandJson(cli, app, &["hello"], env)
      let ringed = run array(run field(&hello, "selected"))
      if ringed.length == 1
        && (Json.asI32(Option<&Value>.some(&ringed[0])) |> Option<i32>.unwrapOr(-1)) == button {
        break
      }
      if milliseconds() >= deadline {
        run Task.abort("Timed out: selected node is ringed in todo")
      }
      pause()
    }
    let title = run command(
      cli,
      &tools.socket,
      &["wait", "--test-id", "detail-title", "--timeout", "10000"],
      env,
    )
    run expect(title.code == 0, "the inspector names the selection")
    let titleJson = run json(Bytes.asSlice(&title.output))
    let node = run field(&titleJson, "node")
    let titleId = number(node, "id")
    run require(titleId >= 0, "Invalid detail-title node id")
    let titleNumber = run decimal(i32.toUsize(titleId))
    let styles = run command(
      cli,
      &tools.socket,
      &["snapshot", "--node", String.view(&titleNumber)],
      env,
    )
    run expect(
      String.contains(run utf8(Bytes.asSlice(&styles.output)), "\\\"Add\\\""),
      "the inspector's title names Add",
    )
    let design = run command(
      cli,
      &tools.socket,
      &["wait", "--test-id", "field-padding", "--timeout", "10000"],
      env,
    )
    run expect(design.code == 0, "the Design segment shows the padding field")
    let segment = run command(
      cli,
      &tools.socket,
      &["click", "--role", "button", "--name", "Declarations", "--exact"],
      env,
    )
    run expect(segment.code == 0, "open the Declarations segment")
    let declared = run command(
      cli,
      &tools.socket,
      &["wait", "--test-id", "declarations", "--timeout", "10000"],
      env,
    )
    run expect(declared.code == 0, "the declarations appear")
    let panel = run command(cli, &tools.socket, &["snapshot", "--test-id", "declarations"], env)
    let panelText = run utf8(Bytes.asSlice(&panel.output))
    run expect(
      String.contains(panelText, "\"  padding-left\"") && String.contains(panelText, ": 10px;"),
      "declarations include todo button padding",
    )
    let content = run command(
      cli,
      &tools.socket,
      &["wait", "--test-id", "content", "--timeout", "10000"],
      env,
    )
    run expect(content.code == 0, "content box is drawn")
    let boxes = run command(cli, &tools.socket, &["snapshot", "--test-id", "box-model"], env)
    let boxesText = run utf8(Bytes.asSlice(&boxes.output))
    run expect(
      String.contains(boxesText, "testId=\"padding\"") && String.contains(boxesText, "\"10\""),
      "box model displays padding widths",
    )
    let add = run command(
      cli,
      &app.socket,
      &["click", "--role", "button", "--name", "Add", "--exact"],
      env,
    )
    run expect(add.code == 0, "click Add in todo")
    let events = run command(
      cli,
      &tools.socket,
      &["click", "--role", "button", "--name", "Events", "--exact"],
      env,
    )
    run expect(events.code == 0, "open events")
    let eventLog = run command(
      cli,
      &tools.socket,
      &["wait", "--test-id", "event-log", "--timeout", "10000"],
      env,
    )
    run expect(eventLog.code == 0, "event log appears")
    let logDeadline = milliseconds() + 15000
    while true {
      let log = run command(cli, &tools.socket, &["snapshot", "--test-id", "event-log"], env)
      let logText = run utf8(Bytes.asSlice(&log.output))
      if String.contains(logText, "\"click\"") && String.contains(logText, "button \\\"Add\\\"") {
        break
      }
      if milliseconds() >= logDeadline {
        run Task.abort("Timed out: event log records Add click")
      }
      pause()
    }
    let refreshed = run command(
      cli,
      &tools.socket,
      &["wait", "--text", "Task 4", "--timeout", "10000"],
      env,
    )
    run expect(refreshed.code == 0, "devtools tree refreshes with new todo")
    let task = run command(
      cli,
      &app.socket,
      &["wait", "--text", "Task 4", "--timeout", "10000"],
      env,
    )
    run expect(task.code == 0, "todo displays new task")

    // silk-ui's extension: listed by hello, its commands served by name, its Program panel a
    // view the app renders and the devtools replay, over the socket.
    let hello = run commandJson(cli, app, &["hello"], env)
    let extensions = run array(run field(&hello, "extensions"))
    let mut silkUiListed = false
    let mut index: usize = 0
    while index < extensions.length {
      if stringField(&extensions[index], "id") == "silk-ui" {
        silkUiListed = true
      }
      index = index + 1
    }
    run expect(silkUiListed, "hello lists the silk-ui extension")
    let messages = run commandJson(cli, app, &["silk-ui.messages", "--since", "0"], env)
    let steps = run array(run field(&messages, "messages"))
    run expect(
      steps.length >= 2 && truth(&messages, "attached"),
      "silk-ui.messages lists the todo's messages",
    )
    let programTab = run command(
      cli,
      &tools.socket,
      &["click", "--role", "button", "--name", "Program", "--exact"],
      env,
    )
    run expect(programTab.code == 0, "open the Program panel")
    let replayed = run command(
      cli,
      &tools.socket,
      &["wait", "--test-id", "messages", "--timeout", "10000"],
      env,
    )
    run expect(replayed.code == 0, "the app's Program panel is replayed in the devtools")
    let message = run command(
      cli,
      &tools.socket,
      &["click", "--role", "listitem", "--name", "Add", "--exact"],
      env,
    )
    run expect(message.code == 0, "click a message in the replayed panel")
    let diff = run command(
      cli,
      &tools.socket,
      &["wait", "--test-id", "model", "--timeout", "10000"],
      env,
    )
    run expect(diff.code == 0, "the app answers the click with the model diff")
    let toolsShot = run rootPath(".cache/ui-inspect/devtools.png")
    let toolsImage = run command(cli, &tools.socket, &["screenshot", pathText(&toolsShot)], env)
    run expect(toolsImage.code == 0, "devtools screenshot")
    run picture(&toolsShot)
    let appShot = run rootPath(".cache/ui-inspect/todo.png")
    let appImage = run command(cli, &app.socket, &["screenshot", pathText(&appShot)], env)
    run expect(appImage.code == 0, "todo screenshot")
    run picture(&appShot)
  }

  effect fn launchDevtools(
    toolsBinary: string,
    appBinary: string,
    args: &[string],
    cli: string,
    env: &[string],
    check: bool,
  ) -> ()
    ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let absolute = run rootPath(appBinary)
    let app = run program("todo", pathText(&absolute), args, env, cli)
    if !check {
      return run execute(toolsBinary, &["--connect", pathText(&app.socket)], env, 2147483647)
    }
    let tools = run program(
      "devtools",
      toolsBinary,
      &["--connect", pathText(&app.socket)],
      env,
      cli,
    )
    run devtoolsCheck(&app, &tools, cli, env)
  }

  pub effect fn devtools(
    mode: string,
    connect: string,
    appBinary: string,
    appArgs: &[string],
    buildOnly: bool,
    debug: bool,
  ) -> ()
    ! BuildError
      | TaskError
      | ProcessError
      | FileError
      | HostInputError
      | OutOfMemoryError
      | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    run require(
      mode == "run" || mode == "todo" || mode == "external" || mode == "check"
        || mode == "embedded",
      "Unknown devtools mode",
    )
    if mode == "embedded" {
      return run embedded()
    }

    // The devtools are optimized unless asked otherwise (`--debug`) or the check drives them: a
    // debug build's own inspector is what the check talks to, but an unoptimized one redraws too
    // slowly to follow a busy app.
    let tools = run build("modules/devtools/app", !debug && mode != "check", false)
    if buildOnly {
      return run say(String.view(&tools))
    }
    if mode == "run" {
      if connect == "" {
        return run execute(String.view(&tools), &[], &[], 2147483647)
      }
      return run execute(String.view(&tools), &["--connect", connect], &[], 2147483647)
    }
    let app = if mode == "external" {
      run String.copy(appBinary)
    } else {
      run build("modules/loom/demo", false, false)
    }
    run require(String.view(&app) != "", "external requires --app-binary PATH")
    let cli = run silkuiPackage("modules/inspect/cli")
    if mode != "check" {
      return run launchDevtools(
        String.view(&tools),
        String.view(&app),
        appArgs,
        String.view(&cli),
        &[],
        false,
      )
    }
    let display = run openDisplay("x11")
    let env = run views(&display.environment)
    let result = run Effect.result(
      launchDevtools(
        String.view(&tools),
        String.view(&app),
        appArgs,
        String.view(&cli),
        env.asSlice(),
        true,
      ),
    )
    drop env
    run closeDisplay(move display)
    if let Result<
      (),
      TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
    >.Failure {
      error
    } = move result {
      fail move error
    }
  }
}
