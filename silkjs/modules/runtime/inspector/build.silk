import silk.build.plan { Library, Plan }
import silk.build.step { sourcePath }

static fn sources0(start: Plan) -> Plan {
  let files: [string; 1] = [
    "src/ext/inspector_transport.c",
  ]
  let mut plan = start
  let mut at: usize = 0
  while at < files.length {
    plan = plan |> Plan.compileNative("c", sourcePath(files[at]), &[
      "-std=gnu11",
      "-O2",
      "-w",
    ], &[
    ])
    at = at + 1
  }
  return plan
}

const STEP_0: Plan = sources0(Plan.empty())

static fn plan() -> Plan {
  let mut plan = STEP_0
  if Intrinsic.targetOperatingSystem() == "linux" { plan = plan |> Plan.linkLibrary("pthread", Library.dynamicSearch()) }
  return plan
}

pub const PLAN: Plan = plan()
