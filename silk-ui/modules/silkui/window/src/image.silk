//! The build step that compiles an app's JavaScript bundle into a bytecode image, so a
//! release host starts from compiled code and parses nothing at launch.
//!
//! silkui builds a small program around [`write`] beside the host, from the same manifest
//! and so with the same engine package, and runs it on the bundle: `<writer> app.js
//! app.bin core.bin`. The host embeds both next to the bundle's text (`js.Bundle`):
//! `app.bin` is the bundle, `core.bin` the `@silkui/core` module it imports. An image
//! only loads in the engine build that wrote it, which is why the app's own build writes
//! it and nothing else does: move the engine pin and the next build writes a new one. A
//! host that still finds another build's image says so and runs the text.
//!
//! The image is compiled in a realm like the one the window opens (`@silkui/core` is
//! defined, so the bundle's imports resolve), and the bundle is not run.
import ui_js.lib { JsHost, JsError, uiPackage, engineBuild }
import ui_tree_window.console { StderrWriter }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.runtime_memory { RuntimeAllocator }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }

/// The name the window gives the bundle (`js.programWithImage`): an image is of a module
/// with this name, which stack traces show.
pub const ENTRY: &'static [u8] = b"app.js"

/// What a build writes: the bundle's image and the image of `@silkui/core`, which the
/// bundle imports and every host defines.
pub struct Images {
  pub bundle: List<u8>,
  pub library: List<u8>,
}

effect fn both(host: &mut JsHost<'_>, source: &[u8]) -> Images ! OutOfMemoryError | JsError ? &mut Allocator {
  let library = run host.writeImage(uiPackage(), b"@silkui/core")
  let bundle = run host.writeImage(source, ENTRY)
  return Images { bundle: move bundle, library: move library }
}

/// The bundle `source` and `@silkui/core` as bytecode images of the engine linked into this
/// program.
pub effect fn compiled(source: &[u8]) -> Images
  ! OutOfMemoryError | JsError | SynchronizationError
  ? &mut Allocator {
  let domain = run WaiterDomain.make()
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut host = run JsHost.open(&memory, domain.handle()) |> Effect.provideMut<Allocator>(&mut allocator)
  run host.define(b"@silkui/core", uiPackage()) |> Effect.provideMut<Allocator>(&mut allocator)
  let written = run Effect.result(both(&mut host, source)) |> Effect.provideMut<Allocator>(&mut allocator)
  run host.close() |> Effect.provideMut<Allocator>(&mut allocator)
  return match move written {
    Result<Images, OutOfMemoryError | JsError>.Success { value } => move value
    Result<Images, OutOfMemoryError | JsError>.Failure { error } => { fail move error }
  }
}

effect fn argument(index: usize) -> Bytes ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  return match move run HostInput.argument(index) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => Bytes.make()
  }
}

effect fn written() -> i32
  ! HostInputError | FileError | OutOfMemoryError | JsError | SynchronizationError
  ? &mut HostInput | &mut Allocator {
  let from = run argument(1)
  let to = run argument(2)
  let library = run argument(3)
  if Bytes.asSlice(&from).length == 0 || Bytes.asSlice(&to).length == 0 || Bytes.asSlice(&library).length == 0 {
    StderrWriter.print("silkui image: give the bundle's path, its image's and the library image's\n", &())
    return 2
  }
  let mut files = run MachineFileSystem.make()
  let source = run FileSystem.readFile(&run Path.fromBytes(Bytes.asSlice(&from))) |> Effect.provideMut<FileSystem>(&mut files)
  let images = run compiled(source.asSlice())
  run FileSystem.writeFile(&run Path.fromBytes(Bytes.asSlice(&to)), images.bundle.asSlice()) |> Effect.provideMut<FileSystem>(&mut files)
  run FileSystem.writeFile(&run Path.fromBytes(Bytes.asSlice(&library)), images.library.asSlice()) |> Effect.provideMut<FileSystem>(&mut files)
  StderrWriter.print(
    "silkui image: {} bytes of JavaScript compiled into a {} byte bytecode image, @silkui/core into {} bytes (engine build {})\n",
    &(source.length(), images.bundle.length(), images.library.length(), engineBuild()),
  )
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("silkui image: the bundle could not be compiled into a bytecode image\n", &())
  return 1
}

/// The writer's `main`: `<writer> <bundle.js> <image> <library image>`.
pub effect fn write() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(written(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
