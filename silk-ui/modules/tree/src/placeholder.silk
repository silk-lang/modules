//! The placeholder has its own private block style; the input keeps its value and identity.
import engine { UiTree, TreeError, applyUsing }
import node { Node, NO_INDEX }
import mutation { NodeKind }
import style { Computed }
import style
import font_units
import style_sheets
import containers
import container_watch
import timing { EasingStops }
import svg_css.adopted { StyleSheets }
import svg_css.element { PseudoTarget, StateBits }
import properties.values { Declaration }
import properties.values
import properties.catalog { Property }
import properties.computed { Display, DisplayOutside, DisplayInside }
import layout.lib { NodeId, Style as CssStyle, LineHeight }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.box { Box }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize

pub struct Placeholder { pub css: usize, pub computed: Computed }

pub fn of(node: &Node) -> Option<&Placeholder> {
  if node.kind == NodeKind.Input {
    if let Option.Some { value } = &node.edit().placeholderStyle { return Option<&Placeholder>.some(&value.get()[0]) }
  }
  return Option<&Placeholder>.None
}

pub fn usesViewport(node: &Node) -> bool {
  return match of(node) { Option.Some { value } => value.computed.usesViewport _ => false }
}

pub fn present(sheets: &StyleSheets) -> bool {
  let mut i: usize = 0
  while i < sheets.sheets().length {
    let rules = sheets.sheets()[i].sheet.resolver.rules()
    let mut j: usize = 0
    while j < rules.length {
      if rules[j].selectors.hasPseudoTarget(PseudoTarget.Placeholder) { return true }
      j = j + 1
    }
    i = i + 1
  }
  return false
}

effect fn ignore<E>(error: E) { drop error }

effect fn dropStyle(tree: &mut UiTree<'_>, slot: u32) ! OutOfMemoryError ? &mut Allocator {
  let css = match of(tree.node(slot)) { Option.Some { value } => value.css _ => NO_INDEX }
  if css != NO_INDEX {
    let parent = NodeId { index: tree.node(slot).css }
    let inner = NodeId { index: tree.node(slot).inner }
    let wrapper = NodeId { index: css }
    if tree.layout.contains(wrapper) {
      run Effect.catchAll(tree.layout.insertBefore(parent, inner, Option<NodeId>.some(wrapper)), ignore)
      run Effect.catchAll(tree.layout.destroy(wrapper), ignore)
    }
    let node = tree.nodeMut(slot)
    let edit = node.editMut()
    edit.placeholderStyle = Option<Box<Placeholder>>.None
    node.content = node.content + 1
    tree.paintDirty = true
  }
}

pub effect fn clear(tree: &mut UiTree<'_>, slot: u32) ! OutOfMemoryError ? &mut Allocator {
  run dropStyle(&mut tree, slot)
  run container_watch.record(&mut tree, slot, PseudoTarget.Placeholder, &[])
  run container_watch.partUnits(&mut tree, slot, PseudoTarget.Placeholder, false, Option<f32>.None, Option<f32>.None)
}

fn applies(property: Property) -> bool {
  return font_units.phase(property) == 2 || match property {
    Property.Color | Property.BackgroundColor | Property.Opacity | Property.Visibility
    | Property.LetterSpacing | Property.WordSpacing | Property.TextDecorationLine
    | Property.TextDecorationColor | Property.TextDecorationStyle | Property.TextDecorationThickness
    | Property.TextUnderlineOffset | Property.TextDecorationSkipInk => true
    _ => false
  }
}

pub effect fn resolve(tree: &mut UiTree<'_>, slot: u32) ! TreeError | OutOfMemoryError ? &mut Allocator {
  let at = style_sheets.index(tree.styleSheets.asSlice(), tree.current)
  let enabled = at != usize.MAX && tree.styleSheets.asSlice()[at].sheets.length() != 0 && tree.styleSheets.asSlice()[at].hasPlaceholder
  if !enabled || !tree.node(slot).edit().showsPlaceholder { run clear(&mut tree, slot) return () }
  let resolved = run tree.resolveGeneratedStyle(slot, PseudoTarget.Placeholder, StateBits.empty(), true)
  let mut declarations = List<Declaration>.make()
  let mut i: usize = 0
  while i < resolved.declarations.length() {
    let declaration = &resolved.declarations.asSlice()[i]
    if applies(declaration.property) { run declarations.append(run values.cloneDeclaration(declaration)) }
    i = i + 1
  }
  // Keep condition dependencies even when their declarations currently do not match.
  if declarations.length() == 0 {
    run dropStyle(&mut tree, slot)
    run container_watch.partUnits(&mut tree, slot, PseudoTarget.Placeholder, false, Option<f32>.None, Option<f32>.None)
    return ()
  }
  if let Option.Some { value } = move run tree.namedFamilies(declarations.asSlice()) { declarations = move value }
  let parent = tree.node(slot).computed().*
  let mut computed = Computed.inViewport(parent.text, parent.viewportWidth, parent.viewportHeight)
  computed.layout.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
  computed.text.color = parent.text.placeholder()
  computed.text.lineHeight = LineHeight.Normal
  i = 0
  while i < declarations.length() {
    if style.containerDependent(&declarations.asSlice()[i]) { computed.usesContainer = true computed.usesViewport = true }
    i = i + 1
  }
  if computed.usesContainer {
    computed.containerWidth = containers.physicalUnitFor(&tree, slot, PseudoTarget.Placeholder, true)
    computed.containerHeight = containers.physicalUnitFor(&tree, slot, PseudoTarget.Placeholder, false)
  }
  let mut parentUnits = font_units.context(&tree, slot, &parent, tree.node(slot).fontKey)
  let partUnits = computed.unitContext()
  parentUnits.containerWidth = partUnits.containerWidth
  parentUnits.containerHeight = partUnits.containerHeight
  parentUnits.containerInlineSize = partUnits.containerInlineSize
  parentUnits.containerBlockSize = partUnits.containerBlockSize
  run font_units.declarations(&mut computed, declarations.asSlice(), &parent, &parentUnits, 2)
  let fontKey = run tree.fontKeyOf(computed.text)
  let units = font_units.descendantContext(&tree, &computed, fontKey)
  let mut stops = EasingStops.make()
  run applyUsing(&mut computed, declarations.asSlice(), &parent, &mut stops, &units)
  computed.finish(fontKey)
  let mut css = match of(tree.node(slot)) { Option.Some { value } => value.css _ => NO_INDEX }
  if css == NO_INDEX {
    let wrapper = run tree.layout.create(CssStyle.make())
    let parent = NodeId { index: tree.node(slot).css }
    let inner = NodeId { index: tree.node(slot).inner }
    run Effect.catchAll(tree.layout.insertBefore(parent, wrapper, Option<NodeId>.some(inner)), ignore)
    run Effect.catchAll(tree.layout.insertBefore(wrapper, inner, Option<NodeId>.None), ignore)
    run tree.forgetCss(wrapper.index)
    css = wrapper.index
  }
  run Effect.catchAll(tree.layout.setStyle(NodeId { index: css }, computed.layout), ignore)
  run container_watch.partUnits(&mut tree, slot, PseudoTarget.Placeholder, computed.usesContainer, computed.containerWidth, computed.containerHeight)
  let node = tree.nodeMut(slot)
  let edit = node.editMut()
  let part = Placeholder { css: css, computed: computed }
  match &mut edit.placeholderStyle {
    Option.Some { value } => { let entries = value.getMut() entries[0] = move part }
    _ => { edit.placeholderStyle = Option<Box<Placeholder>>.some(run Box<Placeholder>.make(move part)) }
  }
  node.content = node.content + 1
  tree.paintDirty = true
}
