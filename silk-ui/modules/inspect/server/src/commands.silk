//! The commands of `ui-inspect-cli` as words: what the CLI parses from its arguments, and what a
//! headless run reads from each line of its script (see ui-tree-window's `headless.silk`). A
//! command becomes one protocol request line.
import reply { writeString }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.encoding.base64 { Base64, Base64Error }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.text.format { Format, ParseError }
import silk.text.string { String, InvalidUtf8 }

/// The parsed command line.
pub struct Command {
  pub connect: String,
  pub cmd: String,
  /// Positional arguments after the command.
  pub positional: List<String>,
  /// The request members built from the options, each starting with a comma.
  pub members: String,
  /// For `screenshot`, and `snapshot` to a file.
  pub file: String,
  pub timeout: u64,
  /// For `raw`: the request as given.
  pub raw: String,
  /// Print the reply line where a command would print for people.
  pub json: bool,
}

/// Options that take a text value, and the request member they become.
pub fn textOption(flag: string) -> string<'static> {
  if flag == "--phase" {
    return "phase"
  }
  if flag == "--key" {
    return "key"
  }
  if flag == "--role" {
    return "role"
  }
  if flag == "--name" {
    return "name"
  }
  if flag == "--label" {
    return "label"
  }
  if flag == "--text" {
    return "text"
  }
  if flag == "--test-id" {
    return "testId"
  }
  if flag == "--code" {
    return "code"
  }
  if flag == "--state" {
    return "state"
  }
  if flag == "--status" {
    return "status"
  }
  if flag == "--kind" {
    return "kind"
  }
  if flag == "--property" {
    return "property"
  }
  if flag == "--author" {
    return "author"
  }
  return ""
}

/// Options that take a number, and their request member.
pub fn numberOption(flag: string) -> string<'static> {
  if flag == "--interval" {
    return "intervalMs"
  }
  if flag == "--columns" {
    return "columns"
  }
  if flag == "--tile-width" {
    return "tileWidth"
  }
  if flag == "--button" {
    return "button"
  }
  if flag == "--node" {
    return "node"
  }
  if flag == "--within" {
    return "within"
  }
  if flag == "--dx" {
    return "dx"
  }
  if flag == "--dy" {
    return "dy"
  }
  if flag == "--count" {
    return "count"
  }
  if flag == "--limit" {
    return "limit"
  }
  if flag == "--x" {
    return "x"
  }
  if flag == "--y" {
    return "y"
  }
  if flag == "--since" {
    return "since"
  }
  if flag == "--seq" {
    return "seq"
  }
  if flag == "--reply" {
    return "reply"
  }
  return ""
}

pub effect fn appendInt(out: &mut String, value: u64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20]
  let mut n = value
  let mut at: usize = 20
  while true {
    at = at - 1
    digits[at] = u64.toU8(n % 10) + 48
    n = n / 10
    if n == 0 {
      break
    }
  }
  run out.append(unsafe String.fromUtf8Unchecked(Slice.view(&digits, at, 20 - at)))
}

pub fn isNumber(value: string) -> bool {
  let bytes = String.utf8Bytes(value)
  if bytes.length == 0 {
    return false
  }
  let mut i: usize = 0
  while i < bytes.length {
    let b = bytes[i]
    if !(b >= 48 && b <= 57 || b == 46 || b == 45 && i == 0) {
      return false
    }
    i = i + 1
  }
  return true
}

/// Parses a command and its options, as `ui-inspect-cli` takes them after its own name; None
/// when they are wrong, with why in `problem` (empty when there is no command at all).
pub effect fn parseCommand(words: &[String], problem: &mut String) -> Option<Command>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut c = Command {
    connect: String.make(),
    cmd: String.make(),
    positional: List<String>.make(),
    members: String.make(),
    file: String.make(),
    timeout: 5000,
    raw: String.make(),
    json: false,
  }
  let list = words
  let mut modifiers = String.make()
  let mut i: usize = 0
  while i < list.length {
    let a = String.view(&list[i])
    let next = if i + 1 < list.length {
      String.view(&list[i + 1])
    } else {
      ""
    }
    let hasNext = i + 1 < list.length
    if a == "--connect" && hasNext {
      c.connect = run String.copy(next)
      i = i + 2
    } else if textOption(a) != "" && hasNext {
      run c.members.append(",\"")
      run c.members.append(textOption(a))
      run c.members.append("\":")
      run writeString(&mut c.members, next)
      i = i + 2
    } else if numberOption(a) != "" && hasNext {
      if !isNumber(next) {
        run problem.append(a)
        run problem.append(" needs a number")
        return Option<Command>.None
      }
      run c.members.append(",\"")
      run c.members.append(numberOption(a))
      run c.members.append("\":")
      run c.members.append(next)
      i = i + 2
    } else if a == "--timeout" && hasNext {
      c.timeout = match move Format.u64Value(next) {
        Result<u64, ParseError>.Success { value } => value
        Result<u64, ParseError>.Failure { error: _ } => 5000
      }
      i = i + 2
    } else if a == "--modifiers" && hasNext {
      modifiers = run String.copy(next)
      i = i + 2
    } else if a == "--json" {
      c.json = true
      i = i + 1
    } else if a == "--exact" || a == "--hidden" || a == "--gone" || a == "--styles"
      || a == "--replace"
      || a == "--reopen" {
      run c.members.append(",\"")
      run c.members.append(String.slice(a, 2, String.byteLength(a) - 2))
      run c.members.append("\":true")
      i = i + 1
    } else if String.startsWith(a, "--") && hasNext && extensionCommand(String.view(&c.cmd)) {
      // An extension's own option: `--flavor nvda` is the member "flavor": "nvda", and
      // `true`, `false` and numbers go as JSON values.
      run c.members.append(",\"")
      run c.members.append(String.slice(a, 2, String.byteLength(a) - 2))
      run c.members.append("\":")
      if next == "true" || next == "false" || isNumber(next) {
        run c.members.append(next)
      } else {
        run writeString(&mut c.members, next)
      }
      i = i + 2
    } else if String.startsWith(a, "--") {
      run problem.append("unknown option ")
      run problem.append(a)
      return Option<Command>.None
    } else if c.cmd.ownedByteLength() == 0 {
      c.cmd = run String.copy(a)
      i = i + 1
    } else {
      run c.positional.append(run String.copy(a))
      i = i + 1
    }
  }
  if modifiers.ownedByteLength() != 0 {
    run c.members.append(",\"modifiers\":[")
    let mut parts = String.split(String.view(&modifiers), ",")
    let mut first = true
    while true {
      match parts.next() {
        Option<string>.Some { value } => {
          if !first {
            run c.members.append(",")
          }
          run writeString(&mut c.members, value)
          first = false
        }
        Option<string>.None => {
          break
        }
      }
    }
    run c.members.append("]")
  }
  if c.cmd.ownedByteLength() == 0 {
    return Option<Command>.None
  }
  return Option<Command>.Some { value: move c }
}

/// The protocol's name of a command the CLI spells with dashes.
pub fn wireName(cmd: string) -> string {
  if cmd == "set-style" {
    return "setStyle"
  }
  if cmd == "reset-styles" {
    return "resetStyles"
  }
  if cmd == "pick-mode" {
    return "pickMode"
  }
  if cmd == "extensions" {
    return "hello"
  }
  return cmd
}

/// The request line for `c` (without the newline), or false with why in `problem`.
pub effect fn requestLine(c: &mut Command, line: &mut String, problem: &mut String) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let cmd = String.view(&c.cmd)
  let pos = c.positional.asSlice()
  if cmd == "raw" {
    if pos.length != 1 {
      run problem.append("raw takes one JSON request")
      return false
    }
    run line.append(String.view(&pos[0]))
    return true
  }
  run line.append("{\"id\":1,\"cmd\":")
  run writeString(&mut line, wireName(cmd))
  if cmd == "set-style" {
    if pos.length != 1 {
      run problem.append("set-style takes the declarations, as in \"width: 10px; color: red\"")
      return false
    }
    run line.append(",\"style\":")
    run writeString(&mut line, String.view(&pos[0]))
  } else if cmd == "comment" {
    if pos.length != 1 {
      run problem.append("comment takes its text")
      return false
    }
    run line.append(",\"text\":")
    run writeString(&mut line, String.view(&pos[0]))
  } else if cmd == "resolve" {
    if pos.length == 0 {
      run problem.append("resolve takes the ids of edits and comments")
      return false
    }
    run line.append(",\"entries\":[")
    let mut k: usize = 0
    while k < pos.length {
      if !isNumber(String.view(&pos[k])) {
        run problem.append("resolve takes ids")
        return false
      }
      if k > 0 {
        run line.append(",")
      }
      run line.append(String.view(&pos[k]))
      k = k + 1
    }
    run line.append("]")
  } else if cmd == "pick-mode" {
    if pos.length > 1
      || (pos.length == 1 && String.view(&pos[0]) != "on" && String.view(&pos[0]) != "off") {
      run problem.append("pick-mode takes on or off, or nothing to ask")
      return false
    }
    if pos.length == 1 {
      run line.append(
        if String.view(&pos[0]) == "on" {
          ",\"on\":true"
        } else {
          ",\"on\":false"
        },
      )
    }
  } else if cmd == "pick" {
    if pos.length != 2 || !isNumber(String.view(&pos[0])) || !isNumber(String.view(&pos[1])) {
      run problem.append("pick takes X Y")
      return false
    }
    run line.append(",\"x\":")
    run line.append(String.view(&pos[0]))
    run line.append(",\"y\":")
    run line.append(String.view(&pos[1]))
  } else if cmd == "highlight" {
    run line.append(",\"nodes\":[")
    let mut k: usize = 0
    while k < pos.length {
      if !isNumber(String.view(&pos[k])) {
        run problem.append("highlight takes node ids")
        return false
      }
      if k > 0 {
        run line.append(",")
      }
      run line.append(String.view(&pos[k]))
      k = k + 1
    }
    run line.append("]")
    if pos.length == 0 && c.members.ownedByteLength() != 0 {
      // A query instead of ids.
      line.clear()
      run line.append("{\"id\":1,\"cmd\":\"highlight\"")
    }
  } else if cmd == "screenshot" || cmd == "capture" {
    if pos.length != 1 {
      run problem.append("screenshot takes the PNG file to write")
      return false
    }
    c.file = run String.copy(String.view(&pos[0]))
  } else if cmd == "press" || cmd == "key" {
    if pos.length != 1 {
      run problem.append("press takes a key (UI Events key value, such as Enter or a)")
      return false
    }
    run line.append(",\"key\":")
    run writeString(&mut line, String.view(&pos[0]))
  } else if cmd == "type" {
    if pos.length != 1 {
      run problem.append("type takes the text to type")
      return false
    }
    run line.append(",\"text\":")
    run writeString(&mut line, String.view(&pos[0]))
  } else if cmd == "snapshot" && pos.length == 1 {
    // The text goes to this file instead of the output.
    c.file = run String.copy(String.view(&pos[0]))
  } else if pos.length != 0 {
    run problem.append("unexpected argument ")
    run problem.append(String.view(&pos[0]))
    return false
  }
  if cmd == "wait" {
    run line.append(",\"timeout\":")
    run appendInt(&mut line, c.timeout)
  }
  run line.append(String.view(&c.members))
  run line.append("}")
  return true
}

/// The PNG in a `screenshot` reply, or None when it has none.
pub effect fn replyPng(document: &Value) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = match Json.asString(Json.field(document, "png")) {
    Option<string>.Some { value } => value
    Option<string>.None => {
      return Option<Bytes>.None
    }
  }
  let encoded = String.utf8Bytes(text)
  let length = match Base64.decodedLength(encoded) {
    Result<usize, Base64Error>.Success { value } => value
    Result<usize, Base64Error>.Failure { error: _ } => {
      return Option<Bytes>.None
    }
  }
  let mut png = run Bytes.zeroed(length)
  match Base64.decodeInto(png.asMutSlice(), encoded) {
    Result<usize, Base64Error>.Success { value: _ } => {}
    Result<usize, Base64Error>.Failure { error: _ } => {
      return Option<Bytes>.None
    }
  }
  return Option<Bytes>.Some { value: move png }
}

/// Splits `line` into words as a shell would for these commands: spaces separate words, and
/// double or single quotes keep spaces in one word (inside double quotes a backslash escapes
/// the next character). A `#` that starts a word comments out the rest of the line. False when
/// a quote is not closed.
pub effect fn splitWords(line: string, out: &mut List<String>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(line)
  let mut word = List<u8>.make()
  let mut inWord = false
  let mut quote: u8 = 0
  let mut i: usize = 0
  while i < bytes.length {
    let b = bytes[i]
    if quote != 0 {
      if b == quote {
        quote = 0
      } else if quote == 34 && b == 92 && i + 1 < bytes.length {
        i = i + 1
        run word.append(bytes[i])
      } else {
        run word.append(b)
      }
    } else if b == 32 || b == 9 || b == 13 || b == 10 {
      if inWord {
        run out.append(run wordText(&word))
        word.clear()
        inWord = false
      }
    } else if b == 35 && !inWord {
      break
    } else if b == 34 || b == 39 {
      quote = b
      inWord = true
    } else {
      run word.append(b)
      inWord = true
    }
    i = i + 1
  }
  if quote != 0 {
    return false
  }
  if inWord {
    run out.append(run wordText(&word))
  }
  return true
}

effect fn wordText(word: &List<u8>) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  return match String.fromUtf8(word.asSlice()) {
    Result<string, InvalidUtf8>.Success { value } => run String.copy(value)
    Result<string, InvalidUtf8>.Failure { error: _ } => String.make()
  }
}

/// Whether `cmd` is an extension's command (`<id>.<command>`).
fn extensionCommand(cmd: string) -> bool {
  let bytes = String.utf8Bytes(cmd)
  let mut i: usize = 0
  while i < bytes.length {
    if bytes[i] == 46 {
      return true
    }
    i = i + 1
  }
  return false
}
