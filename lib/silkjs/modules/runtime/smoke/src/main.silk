//! The embedding smoke test (the core's src/embed_smoke.silk) without WebAssembly. This package
//! depends on the core alone, so the program has no WAMR in it: tests/embed-smoke.py checks that
//! `typeof WebAssembly` is 'undefined' and that no WAMR symbol is linked. It has no file system,
//! compression, HTTP/2, crypto or TLS either.
import silk.system.host_input { HostInput }
import silkjsruntime.embed_smoke
import silkjsruntime.libs.core.capabilities { EmptyWasm }

pub effect fn main() -> i32 ? &mut HostInput { return run embed_smoke.reportWithoutFiles(EmptyWasm {}) }
