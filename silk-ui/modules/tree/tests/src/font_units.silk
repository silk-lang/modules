import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, StyleState, Keyframe, MarkSpan, Atom }
import ui_tree.inspect
import ui_fixtures.fixtures as fixtures
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.written
import svg_css.tokens { CssError }
import svg_css.effect_values { Filter, Size as LayerSize }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.num.f32
import silk.num.usize

fn close(a: f32, b: f32) -> bool { return f32.abs(a - b) < 0.02 }

effect fn tracks(tree: &UiTree<'_>, expected: &[f32]) ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let computed = tree.node(tree.slotOf(3)).computed().*
  run Testing.expect(close(computed.layout.height.value, 2.0 * expected[8])
    && close(computed.layout.padding.top.value, expected[4]) && close(computed.layout.padding.right.value, expected[2])
    && close(computed.layout.padding.bottom.value, expected[6]) && close(computed.layout.padding.left.value, expected[3])
    && close(computed.layout.margin.top.value, expected[1]) && close(computed.layout.margin.bottom.value, expected[9]), "ordinary lengths use the same measured element and root bases as grid tracks")
  run Testing.expect(computed.transform.list.count == 1 && close(computed.transform.list.op(0).x, expected[2])
    && close(computed.transform.list.op(0).y, expected[8]) && close(computed.transform.translate.x, expected[7])
    && close(computed.transform.translate.y, expected[9]) && close(computed.transform.perspective, 2.0 * expected[6]), "transforms resolve font and root metric units through the shared length converter")
  let mut i: usize = 0
  while i < expected.length {
    let bounds = run inspect.infoSlot(tree, tree.slotOf(usize.toU32(i) + 4))
    run Testing.expect(match bounds { Option.Some { value } => close(value.bounds.width(), expected[i]) _ => false }, "grid geometry uses the font file's measured element and root unit bases")
    i = i + 1
  }
}

effect fn paint(tree: &UiTree<'_>, id: u32, ch: f32, lh: f32, cap: f32, rootCap: f32, rootLh: f32) ! AssertionError<'static> {
  if let Option.Some { value } = tree.node(tree.slotOf(id)).paintEffects() {
    run Testing.expect(value.filters.length() == 1 && match &value.filters.asSlice()[0] {
      Filter.Function { amount, .. } => close(value.number(amount), cap)
      _ => false
    }, "filter lengths use measured cap height")
    run Testing.expect(value.shadows.length() == 1, "font-relative text shadow is retained")
    let shadow = value.shadows.asSlice()[0]
    run Testing.expect(close(shadow.x, ch) && close(shadow.y, lh) && close(shadow.blur, rootCap), "paint uses measured character advances, line height and root cap height")
    let sized = match value.backgrounds.size(0) {
      LayerSize.Explicit { x, y } => match x {
        Option.Some { value: horizontal } => match y {
          Option.Some { value: vertical } => close(value.pixels(horizontal, 200.0), 50.0) && close(value.pixels(vertical, 200.0), rootLh)
          _ => false
        }
        _ => false
      }
      _ => false
    }
    run Testing.expect(sized, "background sizing retains percentages alongside root line-height lengths")
  } else { run Testing.expect(false, "font-relative paint effects are installed") }
}

effect fn measuredUnits(sheet: bool) ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("grid") })
  let root = run written.declarations(b"font-family:'Noto Sans';font-size:30px;line-height:42px;padding-bottom:1rlh;min-width:1rem;text-shadow:1rem 1rlh red")
  let barrier = run written.declarations(b"font-size:10px;line-height:20px")
  run batch.style(1, root.asSlice())
  run batch.style(2, barrier.asSlice())
  if sheet {
    let compiled = run compile.compile(b".grid{display:grid;width:1000px;font-size:2em;line-height:28px;height:2lh;padding:1ex 1ch 1cap 1rch;margin-top:1rem;margin-bottom:1rlh;transform:translate(1ch,1lh);translate:1rcap 1rlh;perspective:2cap;grid-template-columns:1em 1rem 1ch 1rch 1ex 1rex 1cap 1rcap 1lh 1rlh 1ic 1ric;filter:blur(1cap);text-shadow:1ch 1lh 1rcap red;background-size:25% 1rlh}", &Options.make())
    let bytes = run compiled.encode()
    run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  } else {
    let style = run written.declarations(b"display:grid;width:1000px;font-size:2em;line-height:28px;height:2lh;padding:1ex 1ch 1cap 1rch;margin-top:1rem;margin-bottom:1rlh;transform:translate(1ch,1lh);translate:1rcap 1rlh;perspective:2cap;grid-template-columns:1em 1rem 1ch 1rch 1ex 1rex 1cap 1rcap 1lh 1rlh 1ic 1ric;filter:blur(1cap);text-shadow:1ch 1lh 1rcap red;background-size:25% 1rlh")
    run batch.style(3, style.asSlice())
  }
  let mut id: u32 = 4
  while id < 16 { run batch.create(id, NodeKind.Box) run batch.append(3, id) id = id + 1 }
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 1200.0, height: 600.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  // Noto Sans fixture: UPEM 1000, zero advance 572, x-height 536, cap height 714.
  run tracks(&tree, &[20.0, 30.0, 11.44, 17.16, 10.72, 16.08, 14.28, 21.42, 28.0, 42.0, 20.0, 30.0])
  run paint(&tree, 3, 11.44, 28.0, 14.28, 21.42, 42.0)
  if let Option.Some { value } = tree.node(tree.slotOf(1)).paintEffects() {
    run Testing.expect(value.shadows.length() == 1 && close(value.shadows.asSlice()[0].x, 30.0)
      && close(value.shadows.asSlice()[0].y, 42.0), "root paint uses its newly computed root font and line height on the first frame")
  } else { run Testing.expect(false, "root shadow is present") }
  let rootComputed = tree.node(tree.slotOf(1)).computed().*
  run Testing.expect(close(rootComputed.layout.minWidth.value, 30.0) && close(rootComputed.layout.padding.bottom.value, 42.0), "root lengths use its new font and line height on the first frame")
  let previousHash = tree.node(tree.slotOf(3)).computed().effects.hash
  let largerRoot = run written.declarations(b"font-size:40px;line-height:50px")
  run batch.style(1, largerRoot.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run tracks(&tree, &[20.0, 40.0, 11.44, 22.88, 10.72, 21.44, 14.28, 28.56, 28.0, 50.0, 20.0, 40.0])
  run paint(&tree, 3, 11.44, 28.0, 14.28, 28.56, 50.0)
  run Testing.expect(tree.node(tree.slotOf(3)).computed().effects.hash != previousHash, "root metric changes invalidate paint through a fixed-font ancestor")
  let changedFont = run written.declarations(b"font-family:'Geist Mono';line-height:normal")
  run batch.style(3, changedFont.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  // Geist Mono fixture: zero 600, x-height 530, cap 710; rounded normal line box 18+4+2.
  run tracks(&tree, &[20.0, 40.0, 12.0, 22.88, 10.6, 21.44, 14.2, 28.56, 24.0, 50.0, 20.0, 40.0])
  run paint(&tree, 3, 12.0, 24.0, 14.2, 28.56, 50.0)
  if !sheet { run Testing.expect(tree.node(tree.slotOf(3)).sheetStyle().isNone(), "plain font-relative paint and grid values use the direct style-object path") }
  let rootLine = run written.declarations(b"line-height:70px")
  run batch.style(1, rootLine.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run tracks(&tree, &[20.0, 40.0, 12.0, 22.88, 10.6, 21.44, 14.2, 28.56, 24.0, 70.0, 20.0, 40.0])
  run paint(&tree, 3, 12.0, 24.0, 14.2, 28.56, 70.0)
  let rootFamily = run written.declarations(b"font-family:'Geist Mono'")
  run batch.style(1, rootFamily.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run tracks(&tree, &[20.0, 40.0, 12.0, 24.0, 10.6, 21.2, 14.2, 28.4, 24.0, 70.0, 20.0, 40.0])
  run paint(&tree, 3, 12.0, 24.0, 14.2, 28.4, 70.0)
  run batch.create(20, NodeKind.Box)
  run batch.append(3, 20)
  let inherited = run written.declarations(b"font-size:7px;line-height:9px;filter:inherit;text-shadow:inherit;background-size:inherit")
  run batch.style(20, inherited.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run paint(&tree, 20, 12.0, 24.0, 14.2, 28.4, 70.0)
  let hover = run written.declarations(b"font-size:3em;line-height:2lh")
  run batch.styleFor(3, StyleState.Hover, hover.asSlice())
  run tree.apply(run batch.take())
  let subject = tree.slotOf(3)
  let subjectNode = tree.nodeMut(subject)
  subjectNode.hovered = true
  tree.restyleLocal(subject)
  run tree.frame(frame)
  run Testing.expect(close(tree.node(subject).computed().text.size, 30.0), "relative font-size in a state look uses the parent instead of multiplying the base look")
  run tracks(&tree, &[30.0, 40.0, 18.0, 24.0, 15.9, 21.2, 21.3, 28.4, 40.0, 70.0, 30.0, 40.0])
  run batch.create(21, NodeKind.Box)
  run batch.append(3, 21)
  let ownFont = run written.declarations(b"font-family:'Noto Sans';font-size:2ch;line-height:1lh;width:1em;height:1lh;padding-right:1ch")
  run batch.style(21, ownFont.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  let child = tree.node(tree.slotOf(21)).computed().*
  run Testing.expect(close(child.text.size, 36.0) && close(child.layout.width.value, 36.0)
    && close(child.layout.height.value, 40.0) && close(child.layout.padding.right.value, 20.592), "font-size uses parent metrics while ordinary lengths use the newly selected own font")
  let rootRelative = run written.declarations(b"font-size:2rem")
  run batch.style(1, rootRelative.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame)
  let resizedRoot = tree.node(tree.slotOf(1)).computed().*
  run Testing.expect(close(resizedRoot.text.size, 32.0) && close(resizedRoot.layout.minWidth.value, 32.0), "root font-size rem uses the initial root size, then root lengths use the resulting size")
}

test effect fn fontMetricsDriveLengthsTransformsGridAndPaintThroughRootChanges() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run measuredUnits(false) |> Effect.provideMut<Allocator>(&mut allocator)
  run measuredUnits(true) |> Effect.provideMut<Allocator>(&mut allocator)
}


fn fontMoment(time: f64) -> FrameInput {
  return FrameInput { width: 500.0, height: 400.0, scale: 1.0, time: time }
}

effect fn defineFontFrames(batch: &mut Batch, name: string, from: &[u8], to: &[u8])
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let mut frames = List<Keyframe>.make()
  run frames.append(Keyframe { offset: 0.0, declarations: run written.declarations(from) })
  run frames.append(Keyframe { offset: 1.0, declarations: run written.declarations(to) })
  run batch.keyframes(name, move frames)
}

effect fn animatedUnits(sheet: bool) ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"font-family:'Noto Sans';font-size:10px;line-height:20px")
  run batch.style(1, root.asSlice())
  let names = ["sample both", "sample font", "sample relative", "sample metric", "sample stacked"]
  let animations = [b"animation:grow 1s linear forwards", b"animation:font 1s linear forwards", b"animation:relative 1s linear forwards", b"animation:metric 1s linear forwards", b"animation:grow 1s linear forwards,overlay 1s linear forwards"]
  let common = run written.declarations(b"font-size:20px;line-height:2em;width:2em;height:1lh;padding-right:1ch")
  let mut i: usize = 0
  while i < 5 {
    let id = usize.toU32(i) + 2
    run batch.create(id, NodeKind.Box)
    run batch.append(1, id)
    run batch.attribute(id, Attribute.ClassName { value: run String.copy(names[i]) })
    if !sheet {
      run batch.style(id, common.asSlice())
      let animated = run written.declarations(animations[i])
      run batch.style(id, animated.asSlice())
    }
    i = i + 1
  }
  if sheet {
    let compiled = run compile.compile(b".sample{font-size:20px;line-height:2em;width:2em;height:1lh;padding-right:1ch}.both{animation:grow 1s linear forwards}.font{animation:font 1s linear forwards}.relative{animation:relative 1s linear forwards}.metric{animation:metric 1s linear forwards}.stacked{animation:grow 1s linear forwards,overlay 1s linear forwards}@keyframes grow{from{font-size:10px;width:1em;translate:1em 0px;opacity:0}to{font-size:20px;width:2em;translate:2em 0px;opacity:1}}@keyframes font{from{font-size:10px}to{font-size:20px}}@keyframes relative{from{font-size:2em}to{font-size:3em}}@keyframes metric{from{width:1ch}to{width:2ch}}@keyframes overlay{to{font-size:40px;width:4em;opacity:.8}}", &Options.make())
    let bytes = run compiled.encode()
    run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  } else {
    run defineFontFrames(&mut batch, "grow", b"font-size:10px;width:1em;translate:1em 0px;opacity:0", b"font-size:20px;width:2em;translate:2em 0px;opacity:1")
    run defineFontFrames(&mut batch, "font", b"font-size:10px", b"font-size:20px")
    run defineFontFrames(&mut batch, "relative", b"font-size:2em", b"font-size:3em")
    run defineFontFrames(&mut batch, "metric", b"width:1ch", b"width:2ch")
    run defineFontFrames(&mut batch, "overlay", b"", b"font-size:40px;width:4em;opacity:.8")
  }
  run tree.apply(run batch.take())
  run tree.frame(fontMoment(0.0))
  run tree.frame(fontMoment(0.5))
  let both = tree.node(tree.slotOf(2)).computed().*
  let font = tree.node(tree.slotOf(3)).computed().*
  let relative = tree.node(tree.slotOf(4)).computed().*
  let metric = tree.node(tree.slotOf(5)).computed().*
  run Testing.expect(close(both.text.size, 15.0) && close(both.layout.width.value, 22.5)
    && close(both.transform.translate.x, 22.5) && close(both.paint.opacity, 0.5), "keyframe lengths use the current animated font before interpolation without resetting other animations")
  run Testing.expect(close(font.text.size, 15.0) && close(font.layout.width.value, 30.0)
    && close(font.layout.height.value, 30.0) && close(font.layout.padding.right.value, 8.58), "unanimated lengths and line height track the current animated font")
  run Testing.expect(close(relative.text.size, 25.0) && close(relative.layout.width.value, 50.0), "relative font-size keyframes resolve against the parent font")
  run Testing.expect(close(metric.layout.width.value, 17.16), "keyframes without font-size animation still use measured font units")
  let stacked = tree.node(tree.slotOf(6)).computed().*
  run Testing.expect(close(stacked.text.size, 27.5) && close(stacked.layout.width.value, 75.625)
    && close(stacked.paint.opacity, 0.65), "implicit keyframe endpoints use earlier animations as their underlying values")
  let resized = run written.declarations(b"font-size:20px")
  run batch.style(1, resized.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(fontMoment(0.5))
  let enlarged = tree.node(tree.slotOf(4)).computed().*
  run Testing.expect(close(enlarged.text.size, 50.0) && close(enlarged.layout.width.value, 100.0), "parent font changes recompute keyframe endpoints without restarting the animation")
  let family = run written.declarations(b"font-family:'Geist Mono'")
  run batch.style(1, family.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(fontMoment(0.5))
  run Testing.expect(close(tree.node(tree.slotOf(5)).computed().layout.width.value, 18.0)
    && close(tree.node(tree.slotOf(3)).computed().layout.padding.right.value, 9.0), "font replacement updates both animated and unanimated metric lengths at the same animation time")
}

effect fn startingFontUnits(sheet: bool) ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"font-family:'Noto Sans';font-size:10px;line-height:20px")
  run batch.style(1, root.asSlice())
  let base = run written.declarations(b"font-size:20px;line-height:2em;width:2ch;height:1lh;padding-right:1ch;transition:font-size 1s linear,width 1s linear")
  let start = run written.declarations(b"font-size:1em;font-family:'Geist Mono'")
  let mut id: u32 = 2
  while id < 4 {
    run batch.create(id, NodeKind.Box)
    run batch.append(1, id)
    run batch.attribute(id, Attribute.ClassName { value: run String.copy(if id == 2 { "sample" } else { "sample only-font" }) })
    if !sheet {
      run batch.style(id, base.asSlice())
      run batch.styleFor(id, StyleState.Starting, start.asSlice())
      if id == 3 {
        let onlyFont = run written.declarations(b"transition:font-size 1s linear")
        run batch.style(id, onlyFont.asSlice())
      }
    }
    id = id + 1
  }
  if sheet {
    let compiled = run compile.compile(b".sample{font-size:20px;line-height:2em;width:2ch;height:1lh;padding-right:1ch;transition:font-size 1s linear,width 1s linear}.only-font{transition:font-size 1s linear}@starting-style{.sample{font-size:1em;font-family:'Geist Mono'}}", &Options.make())
    let bytes = run compiled.encode()
    run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  }
  run tree.apply(run batch.take())
  run tree.frame(fontMoment(0.0))
  let first = tree.node(tree.slotOf(2)).computed().*
  run Testing.expect(close(first.text.size, 10.0) && close(first.layout.width.value, 12.0), "starting styles compute their own font family and parent-relative size before transition endpoints")
  run tree.frame(fontMoment(0.5))
  let both = tree.node(tree.slotOf(2)).computed().*
  let font = tree.node(tree.slotOf(3)).computed().*
  run Testing.expect(close(both.text.size, 15.0) && close(both.layout.width.value, 17.44)
    && close(both.layout.height.value, 30.0), "font-dependent recomputation preserves independently transitioning lengths")
  run Testing.expect(close(font.text.size, 15.0) && close(font.layout.width.value, 17.16)
    && close(font.layout.height.value, 30.0) && close(font.layout.padding.right.value, 8.58), "unanimated lengths follow a font-size transition using the target font family")
}

test effect fn animatedFontSizeControlsKeyframeAndUnderlyingLengths() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run animatedUnits(false) |> Effect.provideMut<Allocator>(&mut allocator)
  run animatedUnits(true) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn startingFontsResolveBeforeTransitionEndpoints() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run startingFontUnits(false) |> Effect.provideMut<Allocator>(&mut allocator)
  run startingFontUnits(true) |> Effect.provideMut<Allocator>(&mut allocator)
}


effect fn richMetrics(tree: &UiTree<'_>, input: u32, size: f32, line: f32, root: f32) ! AssertionError<'static> {
  let runs = tree.node(tree.slotOf(input)).edit().runs.asSlice()
  let mut found: u32 = 0
  let mut i: usize = 0
  while i < runs.length {
    let r = runs[i]
    let c = r.computed
    if r.atom {
      let own = size * 0.572 * 2.0
      run Testing.expect(close(c.text.size, own) && close(c.layout.width.value, own)
        && close(c.layout.height.value, line) && close(c.layout.padding.right.value, own * 0.6)
        && close(c.layout.margin.left.value, root), "rich atoms use parent font-size metrics, their selected own font, and the actual root")
      found = found + 1
    } else if !r.filler && r.start < 2 {
      let multiple: f32 = if r.start == 0 { 2.0 } else { 3.0 }
      let own = size * multiple
      let ch: f32 = if r.start == 0 { 0.572 } else { 0.6 }
      let lineMultiple: f32 = if r.start == 0 { 1.0 } else { 2.0 }
      let height = line * lineMultiple
      run Testing.expect(close(c.text.size, own) && close(c.layout.padding.right.value, own * ch)
        && close(c.layout.height.value, height) && close(c.layout.width.value, root)
        && close(c.layout.margin.left.value, root * 0.572), "overlapping rich marks resolve against the input instead of multiplying each other, while root units keep the real root font")
      found = found + 1
    }
    i = i + 1
  }
  run Testing.expect(found == 3, "both marked spans and the styled atom are present")
}

effect fn richFontUnits(rootInput: bool) ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, if rootInput { NodeKind.Input } else { NodeKind.Box })
  run batch.root(1)
  let root = run written.declarations(b"font-family:'Noto Sans';font-size:30px;line-height:42px;width:500px")
  run batch.style(1, root.asSlice())
  let input: u32 = if rootInput { 1 } else { 2 }
  if !rootInput { run batch.create(2, NodeKind.Input) run batch.append(1, 2) }
  let base = run written.declarations(b"font-size:20px;line-height:30px;width:300px;height:100px")
  run batch.style(input, base.asSlice())
  let first = run written.declarations(b"font-size:2em;line-height:1lh;padding-right:1ch;margin-left:1rch;width:1rem;height:1lh")
  let second = run written.declarations(b"font-size:3em;font-family:'Geist Mono';line-height:2lh")
  let atomStyle = run written.declarations(b"font-size:2ch;font-family:'Geist Mono';line-height:1lh;width:1em;height:1lh;padding-right:1ch;margin-left:1rem")
  run batch.defineMark(input, 0, first.asSlice())
  run batch.defineMark(input, 1, second.asSlice())
  run batch.defineAtom(input, 0, atomStyle.asSlice())
  let atom = Atom { kind: 0, label: run String.copy("A"), data: run String.copy("unit-test") }
  run batch.richText(input, "ab\u{fffc}", &[MarkSpan { start: 0, end: 1, marks: 1 }, MarkSpan { start: 1, end: 2, marks: 3 }], &[move atom])
  run tree.apply(run batch.take())
  run tree.frame(fontMoment(0.0))
  run richMetrics(&tree, input, 20.0, 30.0, if rootInput { 20.0 } else { 30.0 })
  let larger = run written.declarations(b"font-size:25px;line-height:40px")
  run batch.style(input, larger.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(fontMoment(0.0))
  run richMetrics(&tree, input, 25.0, 40.0, if rootInput { 25.0 } else { 30.0 })
}

test effect fn richRunsResolveParentElementAndRootFontMetrics() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run richFontUnits(false) |> Effect.provideMut<Allocator>(&mut allocator)
  run richFontUnits(true) |> Effect.provideMut<Allocator>(&mut allocator)
}
