//! Stage 5 Loom split tests: `SnapshotBackend` (no `UiTree`), `FrameSnapshot` queries,
//! declarative `PreventDefaultRules` / `DragRegion` / `EditMode` diff emission, and `Reply.Stop`.
import loom.app { NoCommand }
import loom.backend { Backend, TreeError }
import loom.lib { Document, Node }
import loom.program { NoOutput, Program, Update }
import loom.program as program
import loom.runtime { pump }
import loom.snapshot_backend { SnapshotBackend }
import loom.ui { PREVENT_FOCUS, PreventDefaultRules, Reply }
import ui_protocol.editing { EditConfig }
import ui_protocol.mutation { Attribute, FIRST_ROOT, Mutation }
import ui_protocol.options { VirtualRange }
import ui_protocol.record { EventKind }
import ui_protocol.root { RootSupport }
import ui_protocol.snapshot { FrameSnapshot, InputRevision, NodeGeometry, RootSnapshot, VirtualListSnapshot }
import ui_tree.legacy { FrameInput, Input, UiTree }
import ui_fixtures.fixtures as fixtures
import loom_tree.harness { locate }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

struct MiniApp {
  val: String,
  clicks: i64,
}

union MiniMsg {
  Clicked,
  Typed { text: String },
}

type MiniNext = Update<MiniApp, NoCommand, NoOutput>

impl Program<MiniMsg, NoCommand> for MiniApp {
  effect fn init() -> MiniNext
    ! OutOfMemoryError
    ? &mut Allocator {
    return MiniNext.of(MiniApp { val: run String.copy("init"), clicks: 0 })
  }

  effect fn update(mut model: MiniApp, message: MiniMsg) -> MiniNext
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      MiniMsg.Clicked => { model.clicks = model.clicks + 1 }
      MiniMsg.Typed { text } => { model.val = move text }
    }
    return MiniNext.of(move model)
  }

  fn view(model: &MiniApp, h: &Document<MiniMsg>) -> Node {
    let rules = PreventDefaultRules.fromActions(PREVENT_FOCUS)
    return h.column(
      &[h.dragRegion(true), h.subscribeGeometry()],
      &[
        h.button(&[h.onClick(MiniMsg.Clicked), h.preventRules(move rules)], &[h.text("Hit")]),
        h.input(String.view(&model.val), &[h.editMode(EditConfig.engineOwned())]),
      ],
    )
  }
}

effect fn buildSampleSnapshot(groupId: u32, seq: u64) -> FrameSnapshot
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut roots = List<RootSnapshot>.make()
  run roots.append(RootSnapshot { root: FIRST_ROOT, generation: 1, viewport: Rect<f32>.new(0.0, 0.0, 500.0, 400.0) })
  let mut nodes = List<NodeGeometry>.make()
  run nodes.append(
    NodeGeometry {
      id: 42,
      generation: 3,
      bounds: Rect<f32>.new(10.0, 20.0, 120.0, 48.0),
      scrollX: 0.0,
      scrollY: 15.0,
      scrollWidth: 110.0,
      scrollHeight: 300.0,
      pressed: false,
      hovered: true,
      focused: false,
    },
  )
  let mut vIndices = List<usize>.make()
  run vIndices.append(4)
  run vIndices.append(5)
  let mut virtualLists = List<VirtualListSnapshot>.make()
  run virtualLists.append(
    VirtualListSnapshot {
      port: 77,
      generation: 1,
      range: VirtualRange { first: 4, end: 6, count: 20, pinned: 0, pinnedId: 0 },
      indices: move vIndices,
    },
  )
  let mut revs = List<InputRevision>.make()
  run revs.append(InputRevision { id: 88, revision: seq + 2 })
  return FrameSnapshot {
    windowGroupId: groupId,
    appliedSeq: seq,
    rootGeneration: 1,
    roots: move roots,
    nodes: move nodes,
    virtualLists: move virtualLists,
    inputRevisions: move revs,
    focusedNode: 88,
  }
}

effect fn snapshotBackendBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut backend = SnapshotBackend.make(1, RootSupport.single(), Rect<f32>.new(0.0, 0.0, 800.0, 600.0))
  run Testing.expect(!Backend.copiesBatches(&backend), "SnapshotBackend copiesBatches() is false for cross-thread outbox ownership")
  let snap10 = run buildSampleSnapshot(1, 10)
  backend.applySnapshot(move snap10)
  let snapStale = run buildSampleSnapshot(1, 5)
  backend.applySnapshot(move snapStale)
  run Testing.expect(backend.appliedSeq() == 10, "SnapshotBackend rejects older FrameSnapshot appliedSeq")

  let m = run Backend.measure(&backend, 42)
  run Testing.expect(m.isSome(), "SnapshotBackend serves subscribed NodeGeometry")
  if let Option.Some { value } = m {
    run Testing.expect(value.bounds.xMin == 10.0 && value.hovered, "NodeGeometry bounds and flags match snapshot")
  }
  run Testing.expect(Backend.range(&backend, 77).isSome(), "SnapshotBackend serves virtual range")
  let mut outIdx = List<usize>.make()
  let okIndices = run Backend.indices(&backend, 77, &mut outIdx)
  run Testing.expect(okIndices && outIdx.length() == 2, "SnapshotBackend serves virtual indices")
  let rev = match backend.inputRevision(88) {
    Option<u64>.Some { value } => value
    Option<u64>.None => 0
  }
  run Testing.expect(rev == 12, "SnapshotBackend tracks input revision from snapshot")

  // Drive Loom Runtime purely against SnapshotBackend with zero UiTree.
  let mut app = run program.make<MiniApp, MiniMsg, NoCommand>()
  run app.start(&mut backend, 0.0)
  let batch = backend.takeMutations()
  let slice = batch.asSlice()
  let mut sawSub = false
  let mut sawDrag = false
  let mut sawPreventRules = false
  let mut sawEditMode = false
  let mut i: usize = 0
  while i < slice.length {
    match &slice[i] {
      Mutation.SubscribeGeometry { .. } => { sawSub = true }
      Mutation.SetAttribute { attribute, .. } => match &attribute {
        Attribute.DragRegion { value } => {
          if value {
            sawDrag = true
          }
        }
        Attribute.PreventRules { .. } => { sawPreventRules = true }
        Attribute.EditMode { .. } => { sawEditMode = true }
        _ => {}
      }
      _ => {}
    }
    i = i + 1
  }
  run Testing.expect(sawSub && sawDrag && sawPreventRules && sawEditMode, "diff emits SubscribeGeometry, DragRegion, PreventRules, and EditMode")
}

test effect fn stage5SnapshotBackendServesSnapshotAndQueuesMutations() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run snapshotBackendBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

struct LinkApp {
  route: String,
  stopped: bool,
}

union LinkMsg {
  ToggleStop,
  Go { stopNow: bool },
}

impl Program<LinkMsg, NoCommand> for LinkApp {
  effect fn init() -> Update<LinkApp, NoCommand, NoOutput>
    ! OutOfMemoryError
    ? &mut Allocator {
    return Update<LinkApp, NoCommand, NoOutput>.of(LinkApp { route: String.make(), stopped: true })
  }

  effect fn update(mut model: LinkApp, message: LinkMsg) -> Update<LinkApp, NoCommand, NoOutput>
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      LinkMsg.ToggleStop => { model.stopped = !model.stopped }
      LinkMsg.Go { stopNow: _ } => {}
    }
    return Update<LinkApp, NoCommand, NoOutput>.of(move model)
  }

  fn view(model: &LinkApp, h: &Document<LinkMsg>) -> Node {
    let rules = PreventDefaultRules.empty()
    let clickAttr = if model.stopped {
      h.on(EventKind.Click, |_ev| Reply<LinkMsg>.Stop)
    } else {
      h.on(EventKind.Click, |_ev| Reply<LinkMsg>.Pass)
    }
    return h.row(
      &[],
      &[
        h.text(String.view(&model.route)),
        h.button(
          &[h.href("/next"), h.preventRules(move rules), clickAttr],
          &[h.text("Next")],
        ),
      ],
    )
  }
}

effect fn replyStopBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut app = run program.make<LinkApp, LinkMsg, NoCommand>()
  let viewport = FrameInput { width: 320.0, height: 240.0, scale: 1.0, time: 0.0 }
  run app.start(&mut tree, 0.0)
  let mut located = false
  if let Option.Some { value: info } = run locate(&mut tree, viewport, "Next") {
    located = true
    let x = (info.bounds.xMin + info.bounds.xMax) * 0.5
    let y = (info.bounds.yMin + info.bounds.yMax) * 0.5
    run tree.dispatch(Input.PointerDown { x: x, y: y, button: 1, modifiers: 0, clickCount: 1 })
    run tree.dispatch(Input.PointerUp { x: x, y: y, button: 1, modifiers: 0 })
    drop run pump(&mut app, &mut tree)
    run Testing.expect(app.location() != "/next", "Reply.Stop cancels internal href navigation without Reply.Prevent")
  }
  run Testing.expect(located, "located Next button in stage5 Reply.Stop test")
}

test effect fn stage5ReplyStopCancelsInternalLinkFollow() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run replyStopBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
