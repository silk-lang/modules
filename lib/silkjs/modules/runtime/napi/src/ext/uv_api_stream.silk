    while i < count {
      r = unsafe sendOne(fd, unsafe nn(unsafe pointerAt(bufs, i)), unsafe countAt(counts, i), unsafe pointerAt(addresses, i))
      if r != 0 { break }
      i = i + 1 sent = sent + 1
    }
  }
  if sent > 0 { return sent }
  if r < 0 {
    let code = unsafe errno()
    if code == EAGAIN || code == ENOBUFS { return -EAGAIN }
    return -code
  }
