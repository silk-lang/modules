//! Extension interface for Engine-thread shell integration alongside Loom's split host.
import protocol { EngineToApp, ShellCommand }
import ui_transport.channel { UnboundedSender }
import ui_tree.legacy { UiTree, TreeError }
import ui_tree_window.loader { Loader }
import ui_tree_window.platform_thread { HostPlatform }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import window.event { Event as WindowEvent }
import window.types { WindowError, WindowId, WindowOptions }
import silk.concurrency.thread { Transferable }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Engine-side lifecycle and shell hooks run on the `UiTree` / `HostPlatform` thread.
pub interface EngineExtension {
  effect fn files(self: &mut Self, loader: &mut Loader) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {}

  fn configure(self: &Self, options: &mut WindowOptions<'_>) -> () {}

  effect fn opened(
    self: &mut Self,
    platform: &mut HostPlatform,
    window: WindowId,
    appTx: &UnboundedSender<EngineToApp>,
  ) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    drop platform
    drop window
    drop appTx
  }

  effect fn event(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    event: &WindowEvent,
    appTx: &UnboundedSender<EngineToApp>,
  ) -> bool
    ! WindowError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    drop tree
    drop event
    drop appTx
    return false
  }

  effect fn update(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    platform: &mut HostPlatform,
    window: WindowId,
    appTx: &UnboundedSender<EngineToApp>,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    drop tree
    drop platform
    drop window
    drop appTx
    return false
  }

  effect fn onShellCommand(
    self: &mut Self,
    command: ShellCommand,
    platform: &mut HostPlatform,
    window: WindowId,
    appTx: &UnboundedSender<EngineToApp>,
  ) -> bool
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    drop command
    drop platform
    drop window
    drop appTx
    return false
  }

  effect fn afterLayout(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    appTx: &UnboundedSender<EngineToApp>,
  ) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    drop tree
    drop appTx
    return false
  }

  effect fn poll(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    time: f64,
    appTx: &UnboundedSender<EngineToApp>,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    drop tree
    drop time
    drop appTx
    return false
  }

  fn wakeAfter(self: &Self) -> Option<f64> {
    return Option<f64>.None
  }

  fn profile(self: &Self) -> bool {
    return false
  }
}

/// Default no-op extension for plain `runWindow` / `runWindowWith` hosts.
pub struct NoExtension {}

impl Transferable for NoExtension {}

impl EngineExtension for NoExtension {}
