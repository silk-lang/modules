//! A virtual list in a browser page: 100,000 messages of varied lengths, and only the rows
//! near the viewport (and one that holds focus) in the document. `build.sh serve` builds and
//! serves it; `check.mjs` drives it in Chromium.
import loom.lib { Heap, Document, Node, NoCommand, NoOutput, Program, Update, VirtualOptions }
import loom.css
import loom.css { px, percent, Keyword, Align, FlexWrap }
import loom_dom.page
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.usize

const FEED: u64 = 1

const WORDS: [string; 8] = ["silk", "loom", "thread", "weave", "spool", "shuttle", "warp", "weft"]

pub struct Feed {
  /// Item ids, top to bottom. An id also picks the message's length.
  items: List<u64>,
  next: u64,
}

pub union Message {
  Prepend,
}

type Next = Update<Feed, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Feed {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut items = List<u64>.make()
    run items.reserve(100000)
    let mut i: u64 = 0
    while i < 100000 {
      run items.append(i)
      i = i + 1
    }
    return Next.of(Feed { items: move items, next: 100000 })
  }

  effect fn update(mut model: Feed, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.Prepend => {
        let id = model.next
        model.next = id + 1
        run model.items.insert(0, id)
      }
    }
    return Next.of(move model)
  }

  fn view(model: &Feed, h: &Document<Message>) -> Node {
    let count = model.items.length()
    return h.column(
      &[h.style(&[css.height(percent(100.0)), css.fontSize(px(14.0)), css.color(gray(0.1))])],
      &[
        h.row(
          &[h.style(&[css.gap(px(12.0)), css.padding(px(12.0)), css.alignItems(Align.Center)])],
          &[
            h.button(&[h.testId("prepend"), h.onClick(Message.Prepend)], &[h.text("Add one at the top")]),
            h.span(&[], &[h.number(usize.toI64(count)), h.text(" messages")]),
          ],
        ),
        h.virtualList(
          FEED,
          count,
          VirtualOptions { estimatedHeight: 56.0, overscan: 200.0, gap: 4.0, revision: 0 },
          &[h.testId("feed"), h.label("Messages"), h.style(&[css.flexGrow(1.0), css.minHeight(px(0.0))])],
          |i| model.items.get(i),
          |i| row(model.items.get(i), h),
        ),
      ],
    )
  }
}

fn row(id: u64, h: &Document<Message>) -> Node {
  // Between one and twelve words a line, a line to six: rows of different heights.
  let lines = u64.toUsize(id % 6) + 1
  let mut heap = Heap.make()
  let mut texts = List<Node>.make()
  heap.alloc(texts.append(h.button(&[h.testId("open"), h.label("Open")], &[h.number(u64.toI64(id))])))
  let mut l: usize = 0
  while l < lines {
    let words = u64.toUsize((id + usize.toU64(l) * 7) % 12) + 1
    let mut w: usize = 0
    while w < words {
      heap.alloc(texts.append(h.span(&[], &[h.text(WORDS[u64.toUsize((id + usize.toU64(w)) % 8)])])))
      w = w + 1
    }
    l = l + 1
  }
  return h.box(
    &[h.style(&[css.padding(px(8.0)), css.backgroundColor(gray(0.95)), css.display(Keyword.Flex), css.gap(px(6.0)), css.flexWrap(FlexWrap.Wrap)])],
    texts.asSlice(),
  )
}

fn gray(level: f32) -> Rgba<f32> {
  return Rgba<f32> { r: level, g: level, b: level, a: 1.0 }
}

static if Intrinsic.targetArchitecture() == "wasm32" {
  export "C" fn open() -> ?*mut u8 as "silk_ui_open" {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(page.open<Feed, Message, NoCommand>(), page.unopened)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }

  export "C" fn call(token: ?*mut u8, op: u32, a: f64, b: f64, c: f64) -> f64 as "silk_ui_call" {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(page.call<Feed, Message, NoCommand>(token, op, a, b, c), page.failed)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
}

pub fn main() -> i32 {
  return 0
}
