import engine { UiTree }
import node { NONE }
import layout.lib { SizeContainment }
import containers
import selector_tree { SelectorTree }
import style_sheets
import svg_css.element { ContainerDependency, PseudoTarget }
import svg_css.tokens { CssError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize

struct Read {
  dependency: ContainerDependency,
  pseudo: PseudoTarget,
}
impl Copy for Read {}

struct PartUnits { pseudo: PseudoTarget, width: Option<f32>, height: Option<f32> }
impl Copy for PartUnits {}

pub struct Watch {
  slot: u32,
  id: u32,
  queries: List<Read>,
  parts: List<PartUnits>,
}

fn index(tree: &UiTree<'_>, slot: u32) -> usize {
  let node = tree.node(slot)
  let at = u32.toUsize(node.containerWatch)
  if at < tree.containerWatches.length() {
    let watch = &tree.containerWatches.asSlice()[at]
    if watch.slot == slot && watch.id == node.id { return at }
  }
  return usize.MAX
}

effect fn ensure(tree: &mut UiTree<'_>, slot: u32) -> usize ! OutOfMemoryError ? &mut Allocator {
  let found = index(&tree, slot)
  if found != usize.MAX { return found }
  let at = tree.containerWatches.length()
  let id = tree.node(slot).id
  run tree.containerWatches.append(Watch { slot: slot, id: id, queries: List<Read>.make(), parts: List<PartUnits>.make() })
  let node = tree.nodeMut(slot)
  node.containerWatch = usize.toU32(at)
  return at
}

pub effect fn record(tree: &mut UiTree<'_>, slot: u32, pseudo: PseudoTarget, dependencies: &[ContainerDependency])
  ! OutOfMemoryError ? &mut Allocator {
  if dependencies.length == 0 && index(&tree, slot) == usize.MAX { return () }
  let at = run ensure(&mut tree, slot)
  let watches = tree.containerWatches.asMutSlice()
  let reads = &mut watches[at].queries
  let mut i: usize = 0
  let mut kept: usize = 0
  while i < reads.length() {
    let read = reads.get(i)
    if read.pseudo != pseudo { reads.set(kept, read) kept = kept + 1 }
    i = i + 1
  }
  reads.truncate(kept)
  i = 0
  while i < dependencies.length {
    run reads.append(Read { dependency: dependencies[i], pseudo: pseudo })
    i = i + 1
  }
}

pub effect fn units(tree: &mut UiTree<'_>, slot: u32) ! OutOfMemoryError ? &mut Allocator {
  if tree.node(slot).computed().usesContainer { drop run ensure(&mut tree, slot) }
}

/// Virtual parts select unit containers from their origin, independently of its own lengths.
pub effect fn partUnits(tree: &mut UiTree<'_>, slot: u32, pseudo: PseudoTarget, used: bool, width: Option<f32>, height: Option<f32>)
  ! OutOfMemoryError ? &mut Allocator {
  if !used && index(&tree, slot) == usize.MAX { return () }
  let at = run ensure(&mut tree, slot)
  let watches = tree.containerWatches.asMutSlice()
  let parts = &mut watches[at].parts
  let mut i: usize = 0
  while i < parts.length() {
    if parts.get(i).pseudo == pseudo { drop parts.remove(i) break }
    i = i + 1
  }
  if used { run parts.append(PartUnits { pseudo: pseudo, width: width, height: height }) }
}

fn same(left: Option<f32>, right: Option<f32>) -> bool {
  if let Option.Some { value } = left {
    if let Option.Some { value: other } = right { return value == other }
    return false
  }
  return right.isNone()
}

fn current(tree: &UiTree<'_>, watch: &Watch, at: usize) -> bool {
  if u32.toUsize(watch.slot) >= tree.nodes.length() { return false }
  let node = tree.node(watch.slot)
  if !node.live || node.id != watch.id || u32.toUsize(node.containerWatch) != at { return false }
  let mut top = watch.slot
  while tree.node(top).parent != NONE { top = tree.node(top).parent }
  return top == tree.root
}

pub effect fn changed(tree: &UiTree<'_>) -> List<u32> ! CssError | OutOfMemoryError ? &mut Allocator {
  let mut result = List<u32>.make()
  let sheet = style_sheets.index(tree.styleSheets.asSlice(), tree.current)
  let adapter = SelectorTree { tree: tree }
  let mut i: usize = 0
  while i < tree.containerWatches.length() {
    let watch = &tree.containerWatches.asSlice()[i]
    if current(tree, watch, i) {
      let computed = &tree.node(watch.slot).computed().*
      let mut changed = computed.usesContainer && (
        !same(computed.containerWidth, containers.physicalUnit(tree, watch.slot, true))
        || !same(computed.containerHeight, containers.physicalUnit(tree, watch.slot, false)))
      let mut part: usize = 0
      while !changed && part < watch.parts.length() {
        let units = watch.parts.get(part)
        changed = !same(units.width, containers.physicalUnitFor(tree, watch.slot, units.pseudo, true))
          || !same(units.height, containers.physicalUnitFor(tree, watch.slot, units.pseudo, false))
        part = part + 1
      }
      let mut query: usize = 0
      while !changed && query < watch.queries.length() {
        let read = watch.queries.get(query)
        changed = sheet == usize.MAX || (run tree.styleSheets.asSlice()[sheet].sheets.containersChanged(
          &[read.dependency], &adapter, u32.toUsize(watch.slot), read.pseudo))
        query = query + 1
      }
      if changed { run result.append(watch.slot) }
    }
    i = i + 1
  }
  return move result
}


pub fn queries(tree: &UiTree<'_>, slot: u32) -> bool {
  let at = index(tree, slot)
  return at != usize.MAX && (tree.containerWatches.asSlice()[at].queries.length() != 0 || tree.containerWatches.asSlice()[at].parts.length() != 0)
}

pub fn depth(tree: &UiTree<'_>) -> usize {
  let mut maximum: usize = 0
  let mut i: usize = 0
  while i < tree.containerWatches.length() {
    let watch = &tree.containerWatches.asSlice()[i]
    if current(tree, watch, i) {
      let mut slot = watch.slot
      let mut count: usize = 0
      while slot != NONE {
        let node = tree.node(slot)
        if node.computed().contain.query() != SizeContainment.None { count = count + 1 }
        slot = node.parent
      }
      if count > maximum { maximum = count }
    }
    i = i + 1
  }
  return maximum + 2
}
