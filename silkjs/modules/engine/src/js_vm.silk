      } // OP_get_var
      57 => { unsafe refresh(&machine, &mut m) let done = unsafe globals.storeInitialized(&mut hooks, &mut m) if !done { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_put_var
      58 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_put_var_init
      113 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_with_get_var
      114 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_with_put_var
      115 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_with_delete_var
      116 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_with_make_ref
      117 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_with_get_ref
      118 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_make_loc_ref
      119 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_make_arg_ref
      120 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_make_var_ref_ref
      121 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_make_var_ref
      151 => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_delete_var
      5 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_private_symbol
      45 => { unsafe sync(&m, &mut machine) unsafe operators.typeofTest(&mut hooks, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_typeof_is
      46 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_add_brand
      53 => { unsafe sync(&m, &mut machine) if !unsafe objects.quickSuper(&mut hooks, &mut machine) { drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) } // OP_get_super
      64 => { unsafe sync(&m, &mut machine) if !unsafe objects.quickPrivateField(&mut hooks, &mut machine) { drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) } // OP_get_private_field
      65 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_put_private_field
      66 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_private_field
      73 => { // OP_define_field
        unsafe refresh(&machine, &mut m)
        unsafe sync(&m, &mut machine) let defined = run unsafe objects.defineFieldOperand(&mut hooks, &mut machine) unsafe sync(&machine, &mut m)
        if !defined { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
      }
      74 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_set_name
      75 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_set_name_computed
      76 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_set_proto
      77 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_set_home_object
      78 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_array_el
      80 => { unsafe sync(&m, &mut machine) if !run unsafe objects.spreadOperand(&mut hooks, &mut machine) { drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) } // OP_copy_data_properties
      81 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_method
      82 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_method_computed
      83 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_class
      84 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_define_class_computed
      165 => { // OP_instanceof
        unsafe refresh(&machine, &mut m)
        let left = unsafe m.top(2) let right = unsafe m.top(1)
        let answer = unsafe objects.quickInstanceOf(machine.runtime, left, right)
        if answer >= 0 {
          unsafe operators.finishBinary(&mut m, ValueBits.Bool { value: answer == 1 })
          unsafe locals.releaseIn(&mut hooks, &machine, left) unsafe locals.releaseIn(&mut hooks, &machine, right)
        } else { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
      }
      166 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_in
      175 => { unsafe sync(&m, &mut machine) drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_private_in

      // Object and function factories, and explicit resource management.
      3 => { unsafe sync(&m, &mut machine) run unsafe factories.pushClosure(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_fclosure
      8 => { // OP_push_this: an object receiver needs no mode check or conversion
        unsafe refresh(&machine, &mut m)
        let receiver = machine.thisValue
        if receiver.isObject() { unsafe m.push(unsafe receiver.retained()) }
        else { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
      }
      11 => { // OP_object
        unsafe refresh(&machine, &mut m)
        unsafe sync(&m, &mut machine) let pushed = run unsafe objects.pushLiteral(&mut hooks, memory, &mut machine) unsafe sync(&machine, &mut m)
        if !pushed { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
      }
      12 => { // OP_special_object
        // A lazy arguments slot starts as Uninitialized, with no step to set up.
        if unsafe m.peekU8(0) == SPECIAL_LAZY_ARGUMENTS { unsafe refresh(&machine, &mut m) unsafe m.skip(1) unsafe m.push(ValueBits.Uninitialized) }
        else { unsafe sync(&m, &mut machine) if !unsafe factories.pushSpecial(&mut machine) { drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) }
      }
      13 => { unsafe sync(&m, &mut machine) drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_rest
      38 => { unsafe sync(&m, &mut machine) drop run unsafe factories.arrayFrom(&mut hooks, memory, &mut machine) unsafe sync(&machine, &mut m) } // OP_array_from
      52 => { unsafe sync(&m, &mut machine) if !run unsafe literalCall(&mut hooks, memory, &mut machine) { drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) } // OP_regexp
      196 => { unsafe sync(&m, &mut machine) run unsafe factories.pushClosure(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_fclosure8
      178 => { unsafe sync(&m, &mut machine) drop run unsafe disposal.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_using_dispose
      179 => { unsafe sync(&m, &mut machine) drop run unsafe disposal.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_using_dispose_async
      182 => { unsafe sync(&m, &mut machine) drop run unsafe disposal.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } // OP_using_check

      // Calls and completion.
      33 => { unsafe sync(&m, &mut machine) if unsafe constructsBytecode(&machine) { let mut done = false let mut skipRecipe = false let form = unsafe plannedForm(&machine) if form == CONSTRUCT_STORES { done = run unsafe constructStores(&mut hooks, memory, &mut machine) } else if form != 0 { let status = run unsafe constructRecipeFast(&mut hooks, memory, &mut machine, form) done = status == 1 skipRecipe = status == 2 } if done { unsafe sync(&machine, &mut m) } else { current = run unsafe constructInline(&mut hooks, memory, &mut machine, skipRecipe) unsafe reloadFrom(current, &mut m) } } else { match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } } // OP_call_constructor
      34 => { unsafe sync(&m, &mut machine) if unsafe callsBytecode(&machine, opcode) { match Pointer.nonNullMut<Machine>(unsafe enterCall(&mut hooks, &mut machine, opcode)) { Option<*mut Machine>.Some { value } => { current = value } Option<*mut Machine>.None => { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) } } unsafe reloadFrom(current, &mut m) } else if unsafe boundCallee(&machine, unsafe callCount(&machine, opcode)) { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) unsafe reloadFrom(current, &mut m) } else if run unsafe quickInline(&mut hooks, memory, &mut machine, opcode) { unsafe sync(&machine, &mut m) } else { match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } } // OP_call
      35 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } // OP_tail_call
      36 => { unsafe sync(&m, &mut machine) let count = u16.toUsize(unsafe machine.peekU16()) if unsafe calleeIsBytecode(&machine, count) { match Pointer.nonNullMut<Machine>(unsafe enterMethodCall(&mut hooks, &mut machine, count)) { Option<*mut Machine>.Some { value } => { current = value } Option<*mut Machine>.None => { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) } } unsafe reloadFrom(current, &mut m) } else if count == 1 && unsafe unitInline(&mut hooks, &mut machine) { unsafe sync(&machine, &mut m) } else if unsafe appliesInline(&machine) { match Pointer.nonNullMut<Machine>(unsafe enterApplyInline(&mut hooks, &mut machine, count)) { Option<*mut Machine>.Some { value } => { current = value } Option<*mut Machine>.None => { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) } } unsafe reloadFrom(current, &mut m) } else { let pushed = unsafe pushInline(&mut hooks, &mut machine) if pushed == PUSH_ANSWERED { unsafe sync(&machine, &mut m) } else if pushed == PUSH_NUMBER && run unsafe numberInline(&mut hooks, &mut machine) { unsafe sync(&machine, &mut m) } else if pushed == PUSH_COLLECTION && run unsafe collectionInline(&mut hooks, &mut machine) { unsafe sync(&machine, &mut m) } else if pushed == PUSH_CLOCK && run unsafe clockInline(&mut hooks, &mut machine) { unsafe sync(&machine, &mut m) } else if pushed == PUSH_LEAN && run unsafe leanMethod(&mut hooks, memory, &mut machine, count) { unsafe sync(&machine, &mut m) } else if run unsafe quickInline(&mut hooks, memory, &mut machine, opcode) { unsafe sync(&machine, &mut m) } else { match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } } } // OP_call_method
      37 => { unsafe sync(&m, &mut machine) match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } // OP_tail_call_method
      // call0..call3 name their count as a constant in each arm: the callee test
      // and the entry then share one operand address instead of decoding it twice.
      242 => { unsafe sync(&m, &mut machine) if unsafe calleeIsBytecode(&machine, 0) { match Pointer.nonNullMut<Machine>(unsafe enterCallWith(&mut hooks, &mut machine, op.OP_call0, 0, 0, true)) { Option<*mut Machine>.Some { value } => { current = value } Option<*mut Machine>.None => { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) } } unsafe reloadFrom(current, &mut m)  } else if unsafe boundCallee(&machine, 0) { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) unsafe reloadFrom(current, &mut m)} else if run unsafe quickInline(&mut hooks, memory, &mut machine, opcode) { unsafe sync(&machine, &mut m) } else { match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } } // OP_call0
      243 => { unsafe sync(&m, &mut machine) if unsafe calleeIsBytecode(&machine, 1) { match Pointer.nonNullMut<Machine>(unsafe enterCallWith(&mut hooks, &mut machine, op.OP_call0, 1, 0, true)) { Option<*mut Machine>.Some { value } => { current = value } Option<*mut Machine>.None => { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) } } unsafe reloadFrom(current, &mut m)  } else if unsafe boundCallee(&machine, 1) { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) unsafe reloadFrom(current, &mut m)} else if unsafe operators.intTop(&machine) && run unsafe stringOfIntSite(&mut hooks, &machine) { unsafe m.discard(1) } else if (unsafe m.top(1)).isNumber() && unsafe parseIntSite(&mut hooks, &machine) { unsafe m.discard(1) } else if run unsafe quickInline(&mut hooks, memory, &mut machine, opcode) { unsafe sync(&machine, &mut m) } else { match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } } // OP_call1
      244 => { unsafe sync(&m, &mut machine) if unsafe calleeIsBytecode(&machine, 2) { match Pointer.nonNullMut<Machine>(unsafe enterCallWith(&mut hooks, &mut machine, op.OP_call0, 2, 0, true)) { Option<*mut Machine>.Some { value } => { current = value } Option<*mut Machine>.None => { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) } } unsafe reloadFrom(current, &mut m)  } else if unsafe boundCallee(&machine, 2) { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) unsafe reloadFrom(current, &mut m)} else if run unsafe quickInline(&mut hooks, memory, &mut machine, opcode) { unsafe sync(&machine, &mut m) } else { match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } } // OP_call2
      245 => { unsafe sync(&m, &mut machine) if unsafe calleeIsBytecode(&machine, 3) { match Pointer.nonNullMut<Machine>(unsafe enterCallWith(&mut hooks, &mut machine, op.OP_call0, 3, 0, true)) { Option<*mut Machine>.Some { value } => { current = value } Option<*mut Machine>.None => { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) } } unsafe reloadFrom(current, &mut m)  } else if unsafe boundCallee(&machine, 3) { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) unsafe reloadFrom(current, &mut m)} else if unsafe reflectAppliesInline(&machine) { current = run unsafe callInline(&mut hooks, memory, &mut machine, opcode) unsafe reloadFrom(current, &mut m) } else if run unsafe quickInline(&mut hooks, memory, &mut machine, opcode) { unsafe sync(&machine, &mut m) } else { match move run unsafe callOperation(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } } // OP_call3
      40 => { // OP_return
