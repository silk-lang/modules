    let operation = if flush == 2 { BrotliFlush.End } else if flush == 0 { BrotliFlush.Continue } else { BrotliFlush.Flush }
    let mut a = () let e = unsafe Pointer.borrowMut<(), BrotliEncoder>(&mut a, unsafe nonnull(h.brotliEncoder))
