/// The index of the command named `name`, or [`NAMED`].
pub fn commandIndex(name: string) -> usize {
  let mut i: usize = 0
  while i < NAMED {
    if commandName(i) == name {
      return i
    }
    i = i + 1
  }
  return NAMED
}
