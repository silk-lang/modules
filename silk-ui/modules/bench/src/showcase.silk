//! The CSS showcase app (react-demo): Tailwind, @keyframes on transforms, gradients, blur and
//! masks, at 1040 x 720 on a 2x display. Each body is one animation frame.
import harness { Bench }
import walls { Fixture }
import showcase_tree
import ui_tree.lib { TreeError, ProtocolError, Viewport }
import ui_tree.batch { Batch }
import ui_tree.css
import ui_tree.css { px }
import silk.build.source { Source }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn protocol(error: ProtocolError) -> never ! TreeError { fail error.error }

pub struct Showcase<'a> {
  fixture: Fixture<'a>,
  built: bool,
}

impl<'a> Showcase<'a> {
  pub effect fn make(mut fixture: Fixture<'a>) -> Showcase<'a> ! TreeError | OutOfMemoryError ? &mut Allocator {
    run fixture.tree.setStyle(fixture.root, &[css.width(px(1040.0)), css.height(px(720.0))])
    let mut batch = Batch.make()
    run batch.adoptStyleSheet(0, 1, Source.read("fixtures/showcase.sheet"))
    run Effect.catch<ProtocolError>(fixture.tree.apply(run batch.take()), protocol)
    return Showcase { fixture: move fixture, built: false }
  }

  effect fn frame(self: &mut Self) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    self.fixture.time = self.fixture.time + 1.0 / 60.0
    drop run self.fixture.tree.frame(Viewport { width: 1040.0, height: 720.0, scale: 2.0 }, self.fixture.time)
    self.fixture.tree.clearUploads()
  }
}

impl<'a> Bench for Showcase<'a> {
  effect fn prepare(self: &mut Self) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    if !self.built {
      drop run showcase_tree.build(&mut self.fixture.tree, self.fixture.root)
      self.built = true
      run self.frame()
    }
  }

  effect fn body(self: &mut Self) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    run self.frame()
  }
}
