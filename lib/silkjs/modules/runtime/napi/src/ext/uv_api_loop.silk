  let count = unsafe readInt(raw, 44)
  // uv_stdio_container_t: flags at 0, the stream or descriptor at 8; 16 bytes each.
  let containers = unsafe addressPointer(unsafe readWord(raw, 48))
  let slots = i32.toUsize(if count > 0 { count } else { 1 })
  let translated = unsafe calloc(slots, 16)
  let pairs = unsafe calloc(slots * 2, 4)
  if Pointer.isNull<u8>(translated) || Pointer.isNull<u8>(pairs) { unsafe free(translated) unsafe free(pairs) return -12 }
  let entries = unsafe nn(translated)
  let fds = unsafe Pointer.assumeManyMut<i32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut i32>(unsafe nn(pairs)))
  let mut index: i32 = 0
  while index < count * 2 { unsafe Pointer.write<i32>(unsafe Pointer.atMut<i32>(fds, i32.toUsize(index)), -1) index = index + 1 }
  let mut failure: i32 = 0
  index = 0
  while index < count {
    let offset = i32.toUsize(index) * 16
    let flags = unsafe readInt(unsafe nn(containers), offset)
    let data = unsafe readWord(unsafe nn(containers), offset + 8)
    let mode = flags & (UV_IGNORE | UV_CREATE_PIPE | UV_INHERIT_FD | UV_INHERIT_STREAM)
    let mut entryFlags: i32 = UV_IGNORE
    let mut entryData: usize = 0
    if mode == UV_CREATE_PIPE {
      let target = unsafe addressPointer(data)
      if Pointer.isNull<u8>(target) || unsafe kindOf(unsafe nn(target)) != abi.UV_NAMED_PIPE { failure = -22 break }
      let pair = unsafe Pointer.atMut<i32>(fds, i32.toUsize(index * 2))
