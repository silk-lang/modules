    let mut d = () let it2 = unsafe itm(&mut d, item) let payload = it2.payload.view() let length = it2.payload.length drop it2
    if !unsafe frameStart(sp, length, ORIGIN, 0, 0) { return ERR_NOMEM }
    let s = unsafe ses(&mut a, sp) let ok = unsafe s.frameBuf.append(payload, length) drop s
    if !ok || !unsafe chunkEnd(sp) { return ERR_NOMEM }
    return 0
  }
  return ERR_INVALID_ARGUMENT
}
unsafe fn responsePredicate(sp: *mut Session, stream: ?*mut Stream) -> i32 {
  let rv = unsafe predicateForStreamSend(sp, stream)
  if rv != 0 { return rv }
  if !unsafe isServer(sp) { return ERR_PROTO }
  let p = unsafe nonnull(stream)
  if unsafe isMyStream(sp, unsafe idOf(p)) { return ERR_INVALID_STREAM_ID }
  let state = unsafe stateOf(p)
  if state == S_OPENING { return 0 }
  if state == S_CLOSING { return ERR_STREAM_CLOSING }
  return ERR_INVALID_STREAM_STATE
}
// nghttp2_session_pack_data.
unsafe fn packData(sp: *mut Session, item: *mut Item, p: *mut Stream, datamax: usize) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let me = s.me let user = s.user
  // Room for the frame header, the pad length and the data; padding is appended after.
  let ok = unsafe s.frameBuf.reserve(10 + datamax) drop s
  if !ok { return ERR_NOMEM }
  let mut b = () let it = unsafe itm(&mut b, item) let provider = it.provider let id = it.stream let endFlag = it.dataFlags drop it
  let mut dataFlags: u32 = 0
  let s2 = unsafe ses(&mut a, sp) let dest = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe at(s2.frameBuf.data, 10)) drop s2
  let read = provider.read
  let mut source = provider.source
  let payload = unsafe read(me, id, dest, datamax, Pointer.fromMutRef<u32>(&mut dataFlags), unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut ?*mut u8, *mut u8>(Pointer.fromMutRef<?*mut u8>(&mut source))), user)
  if payload == i32.toI64(ERR_DEFERRED) || payload == i32.toI64(ERR_TEMPORAL_CALLBACK_FAILURE) || payload == i32.toI64(ERR_PAUSE) {
    let rv = i64.toI32(payload)
    if rv == ERR_DEFERRED {
      unsafe deferItem(p, SF_DEFERRED_USER)
      let s3 = unsafe ses(&mut a, sp) s3.aob = nullItem() drop s3
      return ERR_DEFERRED
    }
    if rv == ERR_TEMPORAL_CALLBACK_FAILURE {
      unsafe detachItem(p)
      let rv2 = unsafe addRst(sp, id, INTERNAL_ERROR, true)
      if isFatal(rv2) { return rv2 }
      return ERR_TEMPORAL_CALLBACK_FAILURE
    }
    return rv
  }
  if payload < 0 || usize.toI64(datamax) < payload { unsafe detachItem(p) return ERR_CALLBACK_FAILURE }
  let length = i64.toUsize(payload)
  let mut flags: u8 = 0
  let mut d = () let it2 = unsafe itm(&mut d, item)
  if u32.bitAnd(dataFlags, 1) != 0 {
    it2.eof = true
    if u8.bitAnd(endFlag, F_END_STREAM) != 0 && u32.bitAnd(dataFlags, 2) == 0 { flags = F_END_STREAM }
  }
  drop it2
  let mut hd = Headers { hd: Frame { length: length, stream: id, kind: DATA, flags: flags, reserved: 0 }, padding: 0, priority: Priority { stream: 0, weight: 0, exclusive: 0 }, entries: nil(), count: 0, category: 0 }
  let maxPayload = if datamax < length + MAX_PADLEN { datamax } else { length + MAX_PADLEN }
  let padded = unsafe selectPadding(sp, unsafe Intrinsic.pointerReinterpret<*mut Headers, *mut Frame>(Pointer.fromMutRef<Headers>(&mut hd)), maxPayload)
  if isFatal(i64.toI32(padded)) { unsafe detachItem(p) return i64.toI32(padded) }
  let padlen = i64.toUsize(padded) - length
  // Lay out: header, optional pad length, data (already at offset 10 or moved to 9), padding.
  let s4 = unsafe ses(&mut a, sp)
  let base = s4.frameBuf.data
  let frameFlags = if padlen > 0 { u8.bitOr(flags, F_PADDED) } else { flags }
  let total = length + padlen
  unsafe setByte(base, 0, u32.wrappingToU8(u32.shiftRight(usize.toU32(total), 16)))
  unsafe setByte(base, 1, u32.wrappingToU8(u32.shiftRight(usize.toU32(total), 8)))
  unsafe setByte(base, 2, u32.wrappingToU8(usize.toU32(total)))
  unsafe setByte(base, 3, DATA)
  unsafe setByte(base, 4, frameFlags)
  unsafe setByte(base, 5, i32.wrappingToU8(i32.shiftRight(id, 24)))
  unsafe setByte(base, 6, i32.wrappingToU8(i32.shiftRight(id, 16)))
  unsafe setByte(base, 7, i32.wrappingToU8(i32.shiftRight(id, 8)))
  unsafe setByte(base, 8, i32.wrappingToU8(id))
  if padlen > 0 {
    unsafe setByte(base, 9, usize.toU8(padlen - 1))
    s4.frameBuf.length = 10 + length
    let mut z: usize = 1
    while z < padlen { let _ok = unsafe s4.frameBuf.push(0) z = z + 1 }
  } else {
    unsafe moveBytes(unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe at(base, 9)), unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe atConst(unsafe constant(base), 10)), length)
    s4.frameBuf.length = 9 + length
  }
  drop s4
  if !unsafe chunkEnd(sp) { return ERR_NOMEM }
  let mut e = () let it3 = unsafe itm(&mut e, item) it3.length = total it3.padlen = padlen it3.flags = flags drop it3
  if length == 0 && u32.bitAnd(dataFlags, 1) != 0 && u32.bitAnd(dataFlags, 2) != 0 { unsafe detachItem(p) return ERR_CANCEL }
  return 0
}
unsafe fn submitDataShared(sp: *mut Session, flags: u8, id: i32, provider: Provider) -> i32 {
  if id == 0 { return ERR_INVALID_ARGUMENT }
  let p = unsafe newItem(DATA, id)
  if Pointer.isNull<Item>(p) { return ERR_NOMEM }
  let mut b = () let it = unsafe itm(&mut b, unsafe nonnull(p)) it.provider = provider it.hasProvider = true it.dataFlags = u8.bitAnd(flags, F_END_STREAM) drop it
  let rv = unsafe addItem(sp, unsafe nonnull(p))
  if rv != 0 { unsafe freeItem(p) }
  return rv
}
// The frame just sent as nghttp2_frame structures.
unsafe fn sentFrame(item: *mut Item, frame: &mut Headers, push: &mut Push, goaway: &mut Goaway) -> *mut Frame {
  let mut b = () let it = unsafe itm(&mut b, item)
  let hd = Frame { length: it.length, stream: it.stream, kind: it.kind, flags: it.flags, reserved: 0 }
  frame.hd = hd frame.padding = it.padlen frame.category = it.category
  if it.kind == PUSH_PROMISE { push.hd = hd push.padding = it.padlen push.promised = it.promised return unsafe Intrinsic.pointerReinterpret<*mut Push, *mut Frame>(Pointer.fromMutRef<Push>(&mut push.*)) }
  if it.kind == GOAWAY { goaway.hd = hd goaway.last = it.last goaway.error = it.errorCode goaway.data = it.payload.data goaway.length = it.payload.length return unsafe Intrinsic.pointerReinterpret<*mut Goaway, *mut Frame>(Pointer.fromMutRef<Goaway>(&mut goaway.*)) }
  return unsafe Intrinsic.pointerReinterpret<*mut Headers, *mut Frame>(Pointer.fromMutRef<Headers>(&mut frame.*))
}
fn blankHeaders() -> Headers { return Headers { hd: Frame { length: 0, stream: 0, kind: 0, flags: 0, reserved: 0 }, padding: 0, priority: Priority { stream: 0, weight: 16, exclusive: 0 }, entries: nil(), count: 0, category: 0 } }
fn blankPush() -> Push { return Push { hd: Frame { length: 0, stream: 0, kind: 0, flags: 0, reserved: 0 }, padding: 0, entries: nil(), count: 0, promised: 0, reserved: 0 } }
fn blankGoaway() -> Goaway { return Goaway { hd: Frame { length: 0, stream: 0, kind: 0, flags: 0, reserved: 0 }, last: 0, error: 0, data: nil(), length: 0, reserved: 0 } }
unsafe fn frameSent(sp: *mut Session, frame: *mut Frame) -> i32 {
  if unsafe callFrame(sp, CB_FRAME_SEND, frame) != 0 { return ERR_CALLBACK_FAILURE }
  return 0
}
// session_after_frame_sent1.
unsafe fn afterFrameSent1(sp: *mut Session) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let item = unsafe nonnull(s.aob) drop s
  let mut headers = blankHeaders() let mut push = blankPush() let mut goaway = blankGoaway()
  let frame = unsafe sentFrame(item, &mut headers, &mut push, &mut goaway)
  let mut b = () let it = unsafe itm(&mut b, item) let kind = it.kind let id = it.stream let length = it.length let flags = it.flags let eof = it.eof let category = it.category drop it
  if kind == DATA {
    let found = unsafe findStream(sp, id)
    let s2 = unsafe ses(&mut a, sp) s2.remoteWindow = s2.remoteWindow - usize.toI32(length) drop s2
    if !Pointer.isNull<Stream>(found) { let mut c = () let t = unsafe str(&mut c, unsafe nonnull(found)) t.remoteWindow = t.remoteWindow - usize.toI32(length) }
    if !Pointer.isNull<Stream>(found) && eof {
      unsafe detachItem(unsafe nonnull(found))
      let rv = unsafe frameSent(sp, frame)
      if isFatal(rv) { return rv }
      if u8.bitAnd(flags, F_END_STREAM) != 0 {
        let again = unsafe findStream(sp, id)
        if !Pointer.isNull<Stream>(again) {
          unsafe shutdown(unsafe nonnull(again), SHUT_WR)
          let rv2 = unsafe closeIfShutRdwr(sp, unsafe nonnull(again))
          if isFatal(rv2) { return rv2 }
        }
      }
      return 0
    }
    let rv3 = unsafe frameSent(sp, frame)
    if isFatal(rv3) { return rv3 }
    return 0
  }
  let rv = unsafe frameSent(sp, frame)
  if isFatal(rv) { return rv }
  if kind == HEADERS {
    let found = unsafe findStream(sp, id)
    if Pointer.isNull<Stream>(found) { return 0 }
    let p = unsafe nonnull(found)
    if category == HCAT_REQUEST {
      let mut c = () let t = unsafe str(&mut c, p) t.state = S_OPENING drop t
    } else if category == HCAT_PUSH_RESPONSE {
      let mut c = () let t = unsafe str(&mut c, p) t.flags = u8.bitAnd(t.flags, u8.bitNot(SF_PUSH)) t.state = S_OPENED drop t
      let s3 = unsafe ses(&mut a, sp) s3.numOutgoing = s3.numOutgoing + 1 drop s3
    } else if category == HCAT_RESPONSE {
      let mut c = () let t = unsafe str(&mut c, p) t.state = S_OPENED drop t
    }
    if u8.bitAnd(flags, F_END_STREAM) != 0 { unsafe shutdown(p, SHUT_WR) }
    let rv2 = unsafe closeIfShutRdwr(sp, p)
    if isFatal(rv2) { return rv2 }
    let mut d = () let it2 = unsafe itm(&mut d, item) let has = it2.hasProvider let provider = it2.provider drop it2
    if has {
      let rv3 = unsafe submitDataShared(sp, F_END_STREAM, id, provider)
      if isFatal(rv3) { return rv3 }
    }
    return 0
  }
  if kind == RST_STREAM {
    let mut d = () let it2 = unsafe itm(&mut d, item) let code = it2.errorCode drop it2
    let rv2 = unsafe closeStream(sp, id, code)
    if isFatal(rv2) { return rv2 }
    return 0
  }
  if kind == GOAWAY {
    let mut d = () let it2 = unsafe itm(&mut d, item) let aux = it2.aux let last = it2.last drop it2
    let s4 = unsafe ses(&mut a, sp)
    if u8.bitAnd(aux, GA_TERM_ON_SEND) != 0 { s4.goawayFlags = u8.bitOr(s4.goawayFlags, G_TERM_SENT) }
    s4.goawayFlags = u8.bitOr(s4.goawayFlags, G_SENT) drop s4
    let rv2 = unsafe closeStreamsOnGoaway(sp, last, true)
    if isFatal(rv2) { return rv2 }
    return 0
  }
  if kind == WINDOW_UPDATE {
    if id == 0 {
      let s5 = unsafe ses(&mut a, sp) s5.windowUpdateQueued = false let noAuto = s5.options.noAutoWindowUpdate drop s5
      let rv2 = if noAuto { unsafe updateConsumed(sp, nullStream(), 0) } else { unsafe updateRecvConnectionWindow(sp, 0) }
      if isFatal(rv2) { return rv2 }
      return 0
    }
    let found = unsafe findStream(sp, id)
    if Pointer.isNull<Stream>(found) { return 0 }
    let p = unsafe nonnull(found)
    let mut c = () let t = unsafe str(&mut c, p) t.windowUpdateQueued = false let shut = t.shut drop t
    if u8.bitAnd(shut, SHUT_RD) != 0 { return 0 }
    let rv2 = if unsafe noAutoWindow(sp) { unsafe updateConsumed(sp, found, 0) } else { unsafe updateRecvStreamWindow(sp, p, 0, true) }
    if isFatal(rv2) { return rv2 }
    return 0
  }
  return 0
}
// session_after_frame_sent2 and active_outbound_item_reset.
unsafe fn afterFrameSent2(sp: *mut Session) -> () {
  let mut a = () let s = unsafe ses(&mut a, sp) let p = s.aob s.aob = nullItem() s.obState = OB_POP_ITEM drop s
  unsafe resetOutput(sp)
  if Pointer.isNull<Item>(p) { return () }
  let item = unsafe nonnull(p)
  let mut b = () let it = unsafe itm(&mut b, item) let kind = it.kind let eof = it.eof let id = it.stream drop it
  if kind != DATA || eof { unsafe freeItem(p) return () }
  let found = unsafe findStream(sp, id)
  if unsafe predicateDataSend(sp, found) != 0 {
    if !Pointer.isNull<Stream>(found) { unsafe detachItem(unsafe nonnull(found)) }
    unsafe freeItem(p)
  }
}
unsafe fn notSentItem(sp: *mut Session, item: *mut Item, rv: i32) -> i32 {
  let mut b = () let it = unsafe itm(&mut b, item) let kind = it.kind let category = it.category let canceled = it.canceled let canceledCode = it.errorCode let promised = it.promised let id = it.stream drop it
  if kind != DATA && isNonFatal(rv) && kind != WINDOW_UPDATE {
    let mut headers = blankHeaders() let mut push = blankPush() let mut goaway = blankGoaway()
    let frame = unsafe sentFrame(item, &mut headers, &mut push, &mut goaway)
    if unsafe callNotSent(sp, CB_FRAME_NOT_SEND, frame, rv) != 0 { unsafe freeItem(unsafe Intrinsic.pointerRequalify<*mut Item, ?*mut Item>(item)) return ERR_CALLBACK_FAILURE }
  }
  let mut opened: i32 = 0 let mut code = INTERNAL_ERROR
  if kind == HEADERS && category == HCAT_REQUEST { opened = id code = if canceled { canceledCode } else { REFUSED_STREAM } }
  if kind == PUSH_PROMISE { opened = promised }
  let mut rv2: i32 = 0
  if opened != 0 { rv2 = unsafe closeStream(sp, opened, code) }
  unsafe freeItem(unsafe Intrinsic.pointerRequalify<*mut Item, ?*mut Item>(item))
  let mut a = () let s = unsafe ses(&mut a, sp) s.aob = nullItem() s.obState = OB_POP_ITEM drop s
  unsafe resetOutput(sp)
  if isFatal(rv2) { return rv2 }
  if rv == ERR_HEADER_COMP {
    let rv3 = unsafe terminateSession(sp, INTERNAL_ERROR, b"")
    if isFatal(rv3) { return rv3 }
  }
  if isFatal(rv) { return rv }
  return 0
}
pub unsafe fn nghttp2_session_mem_send(session: ?*mut u8, out: *mut ?*mut u8) -> i64 {
  let sp = unsafe sessionOf(session)
  let mut a = ()
  while true {
    let s = unsafe ses(&mut a, sp) let st = s.obState drop s
    if st == OB_SEND_CLIENT_MAGIC {
      let s2 = unsafe ses(&mut a, sp)
      if !s2.magicSent { s2.magicSent = true unsafe Pointer.put<?*mut u8>(out, cText(MAGIC)) return 24 }
      s2.obState = OB_POP_ITEM
      continue
    }
    if st == OB_SEND_DATA {
      let s2 = unsafe ses(&mut a, sp)
      let chunks = s2.chunkEnds.length / 4
      if s2.chunkIndex < chunks {
        let start = if s2.chunkIndex == 0 { 0 } else { u32.toUsize(getU32(s2.chunkEnds.view(), (s2.chunkIndex - 1) * 4)) }
        let endAt = u32.toUsize(getU32(s2.chunkEnds.view(), s2.chunkIndex * 4))
        s2.chunkIndex = s2.chunkIndex + 1
        let last = s2.chunkIndex == chunks
        unsafe Pointer.put<?*mut u8>(out, unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe at(s2.frameBuf.data, start)))
        drop s2
        if last {
          let rv = unsafe afterFrameSent1(sp)
          if rv < 0 { return i32.toI64(rv) }
        }
        return usize.toI64(endAt - start)
      }
      drop s2
      unsafe afterFrameSent2(sp)
      continue
    }
    let next = unsafe popNext(sp)
    if Pointer.isNull<Item>(next) { return 0 }
    let item = unsafe nonnull(next)
    let rv = unsafe prepFrame(sp, item)
    if rv == ERR_DEFERRED { unsafe resetOutput(sp) continue }
    if rv < 0 {
      let rv2 = unsafe notSentItem(sp, item, rv)
      if rv2 < 0 { return i32.toI64(rv2) }
      continue
    }
    let s3 = unsafe ses(&mut a, sp) s3.aob = next s3.obState = OB_SEND_DATA s3.chunkIndex = 0 let firstEnd = u32.toUsize(getU32(s3.chunkEnds.view(), 0)) drop s3
    // The payload length the callbacks see; DATA and header blocks set theirs when packed.
    let mut b = () let it = unsafe itm(&mut b, item)
    if it.kind != DATA && it.kind != HEADERS && it.kind != PUSH_PROMISE { it.length = firstEnd - 9 }
  }
  return 0
}

// Creation and options.
pub unsafe fn nghttp2_session_callbacks_new(out: *mut ?*mut u8) -> i32 {
  let p = unsafe calloc(1, Layout.of<Callbacks>().bytes)
  if Pointer.isNull<u8>(p) { return ERR_NOMEM }
  unsafe Pointer.put<Callbacks>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Callbacks>(unsafe nonnull(p)), noCallbacks())
  unsafe Pointer.put<?*mut u8>(out, p)
  return 0
}
pub unsafe fn nghttp2_session_callbacks_del(cb: ?*mut u8) -> () { unsafe free(cb) }
unsafe fn callbacksOf<'a>(anchor: &'a mut (), cb: ?*mut u8) -> &'a mut Callbacks { return unsafe Pointer.borrowMut<(), Callbacks>(move anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Callbacks>(unsafe nonnull(cb))) }
pub unsafe fn nghttp2_session_callbacks_set_on_frame_recv_callback(cb: ?*mut u8, callback: FrameCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.frameRecv = callback c.set = u32.bitOr(c.set, CB_FRAME_RECV) }
pub unsafe fn nghttp2_session_callbacks_set_on_frame_send_callback(cb: ?*mut u8, callback: FrameCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.frameSend = callback c.set = u32.bitOr(c.set, CB_FRAME_SEND) }
pub unsafe fn nghttp2_session_callbacks_set_on_header_callback(cb: ?*mut u8, callback: HeaderCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.header = callback c.set = u32.bitOr(c.set, CB_HEADER) }
pub unsafe fn nghttp2_session_callbacks_set_on_data_chunk_recv_callback(cb: ?*mut u8, callback: DataCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.dataChunk = callback c.set = u32.bitOr(c.set, CB_DATA) }
pub unsafe fn nghttp2_session_callbacks_set_on_stream_close_callback(cb: ?*mut u8, callback: CloseCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.streamClose = callback c.set = u32.bitOr(c.set, CB_STREAM_CLOSE) }
pub unsafe fn nghttp2_session_callbacks_set_on_frame_not_send_callback(cb: ?*mut u8, callback: NotSentCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.frameNotSend = callback c.set = u32.bitOr(c.set, CB_FRAME_NOT_SEND) }
pub unsafe fn nghttp2_session_callbacks_set_on_begin_headers_callback(cb: ?*mut u8, callback: FrameCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.beginHeaders = callback c.set = u32.bitOr(c.set, CB_BEGIN_HEADERS) }
pub unsafe fn nghttp2_session_callbacks_set_on_invalid_frame_recv_callback(cb: ?*mut u8, callback: NotSentCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.invalidFrame = callback c.set = u32.bitOr(c.set, CB_INVALID_FRAME) }
pub unsafe fn nghttp2_session_callbacks_set_select_padding_callback(cb: ?*mut u8, callback: PaddingCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.padding = callback c.set = u32.bitOr(c.set, CB_PADDING) }
pub unsafe fn nghttp2_session_callbacks_set_error_callback2(cb: ?*mut u8, callback: ErrorCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.error = callback c.set = u32.bitOr(c.set, CB_ERROR) }
pub unsafe fn nghttp2_session_callbacks_set_on_invalid_header_callback(cb: ?*mut u8, callback: HeaderCallback) -> () { let mut a = () let c = unsafe callbacksOf(&mut a, cb) c.invalidHeader = callback c.set = u32.bitOr(c.set, CB_INVALID_HEADER) }

pub unsafe fn nghttp2_option_new(out: *mut ?*mut u8) -> i32 {
  let p = unsafe calloc(1, Layout.of<Options>().bytes)
  if Pointer.isNull<u8>(p) { return ERR_NOMEM }
  unsafe Pointer.put<Options>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Options>(unsafe nonnull(p)), defaultOptions())
  unsafe Pointer.put<?*mut u8>(out, p)
  return 0
}
pub unsafe fn nghttp2_option_del(options: ?*mut u8) -> () { unsafe free(options) }
unsafe fn optionsOf<'a>(anchor: &'a mut (), options: ?*mut u8) -> &'a mut Options { return unsafe Pointer.borrowMut<(), Options>(move anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Options>(unsafe nonnull(options))) }
pub unsafe fn nghttp2_option_set_no_auto_window_update(options: ?*mut u8, value: i32) -> () { let mut a = () let o = unsafe optionsOf(&mut a, options) o.noAutoWindowUpdate = value != 0 }
pub unsafe fn nghttp2_option_set_max_deflate_dynamic_table_size(options: ?*mut u8, value: usize) -> () { let mut a = () let o = unsafe optionsOf(&mut a, options) o.maxDeflate = value }
pub unsafe fn nghttp2_option_set_max_reserved_remote_streams(options: ?*mut u8, value: u32) -> () { let mut a = () let o = unsafe optionsOf(&mut a, options) o.maxReserved = value }
pub unsafe fn nghttp2_option_set_max_send_header_block_length(options: ?*mut u8, value: usize) -> () { let mut a = () let o = unsafe optionsOf(&mut a, options) o.maxSendHeaderBlock = value }
pub unsafe fn nghttp2_option_set_peer_max_concurrent_streams(options: ?*mut u8, value: u32) -> () { let mut a = () let o = unsafe optionsOf(&mut a, options) o.peerMaxConcurrent = value o.peerMaxSet = true }
pub unsafe fn nghttp2_option_set_max_settings(options: ?*mut u8, value: usize) -> () { let mut a = () let o = unsafe optionsOf(&mut a, options) if value != 0 { o.maxSettings = value } }
pub unsafe fn nghttp2_option_set_no_closed_streams(options: ?*mut u8, value: i32) -> () { }
pub unsafe fn nghttp2_option_set_no_rfc9113_leading_and_trailing_ws_validation(options: ?*mut u8, value: i32) -> () { let mut a = () let o = unsafe optionsOf(&mut a, options) o.noWs = value != 0 }
pub unsafe fn nghttp2_option_set_stream_reset_rate_limit(options: ?*mut u8, burst: u64, rate: u64) -> () { let mut a = () let o = unsafe optionsOf(&mut a, options) o.resetBurst = burst o.resetRate = rate }
pub unsafe fn nghttp2_option_set_builtin_recv_extension_type(options: ?*mut u8, kind: u8) -> () {
  let mut a = () let o = unsafe optionsOf(&mut a, options)
  if kind == ALTSVC { o.builtin = u32.bitOr(o.builtin, 1024) }
  if kind == ORIGIN { o.builtin = u32.bitOr(o.builtin, 4096) }
}

unsafe fn sessionNew(out: *mut ?*mut u8, cb: ?*mut u8, user: ?*mut u8, options: ?*mut u8, server: bool) -> i32 {
  let raw = unsafe calloc(1, Layout.of<Session>().bytes)
  if Pointer.isNull<u8>(raw) { return ERR_NOMEM }
  let sp = unsafe sessionOf(raw)
  let mut a = ()
  let callbacks = if Pointer.isNull<u8>(cb) { noCallbacks() } else { let c = unsafe callbacksOf(&mut a, cb) let copied = Callbacks { set: c.set, beginHeaders: c.beginHeaders, invalidFrame: c.invalidFrame, invalidHeader: c.invalidHeader, error: c.error,
    padding: c.padding, header: c.header, frameRecv: c.frameRecv, frameSend: c.frameSend, frameNotSend: c.frameNotSend, dataChunk: c.dataChunk, streamClose: c.streamClose } copied }
  let mut b = ()
