//! [`Showcase`]: an app that shows components alone, one exhibit at a time, so a component can be
//! looked at, driven and captured without the app around it. An exhibit draws a component as it
//! should look in one case ("Button / Disabled"); an [`Exhibits`] value names and draws them by
//! index. The showcase lists them, draws the chosen one on a stage at a width (fit, 360, 768 or 1200 points) and in the
//! light or dark theme, and says the last thing an exhibit reported (`Shown.Acted`).
//!
//! ```silk
//! const TITLES: [string<'static>; 2] = ["Button / Primary", "Button / Disabled"]
//!
//! struct Buttons {}
//!
//! impl Exhibits for Buttons {
//!   fn count(self: &Self) -> usize { return TITLES.length }
//!   fn title(self: &Self, index: usize) -> string { return TITLES[index] }
//!   fn draw(self: &Self, index: usize, ui: &mut Ui<Shown>, theme: &Theme) -> () {
//!     buttonWith(&mut ui, &theme, Tone.Primary, index == 1, "Save", || Shown.Acted { what: "Save pressed" })
//!   }
//! }
//!
//! let app = run Showcase<Buttons>.make(Buttons {}, SANS)
//! ```
//!
//! Exhibits keep no state: a case worth seeing is an exhibit of its own. Everything in the
//! showcase has a role and a name, so a headless script or an agent picks an exhibit the way a
//! person would (`click --role option --name "Button / Primary"`), then takes a screenshot of
//! `--test-id stage`.
import theme { Theme, surface, border }
import layout { heading, caption, spacer }
import button { Tone, buttonWith }
import list { selectList }
import loom.app { App, Context, NoCommand }
import loom.font { Font, Fonts }
import loom.ui { Ui, textKey }
import ui_protocol.css
import ui_protocol.css { px, percent }
import ui_protocol.mutation { Align, Overflow, BorderStyle, BoxSizing }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.usize
import silk.text.string { String }

/// The stage widths, in points; 0 fits the stage to the window.
pub const WIDTHS: [f32; 4] = [0.0, 360.0, 768.0, 1200.0]

const WIDTH_NAMES: [string<'static>; 4] = ["Fit", "360", "768", "1200"]

/// The exhibits of a showcase, by index from 0.
pub interface Exhibits {
  fn count(self: &Self) -> usize

  /// What the list calls exhibit `index`: its component, then its case ("Button / Primary").
  fn title(self: &Self, index: usize) -> string

  /// Draws exhibit `index` with the showcase's theme.
  fn draw(self: &Self, index: usize, ui: &mut Ui<Shown>, theme: &Theme) -> ()
}

pub union Shown {
  Pick { pub index: usize },
  Width { pub index: usize },
  Dark { pub on: bool },
  /// What an exhibit's callback reports, such as "Save pressed".
  Acted { pub what: string<'static> },
}

pub struct Showcase<E> {
  pub exhibits: E,
  pub chosen: usize,
  pub width: usize,
  pub dark: bool,
  /// The last thing an exhibit reported, and how many times in a row.
  pub acted: string<'static>,
  pub times: usize,
  /// Each exhibit's title, in order: the list shows these.
  titles: List<String>,
  font: Font,
}

impl<E: Exhibits> Showcase<E> {
  /// A showcase of `exhibits`, set in `font` (which `fonts` names to the runtime).
  pub effect fn make(exhibits: E, font: Font) -> Showcase<E>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut titles = List<String>.make()
    let mut i: usize = 0
    while i < exhibits.count() {
      run titles.append(run String.copy(exhibits.title(i)))
      i = i + 1
    }
    return Showcase<E> {
      exhibits: move exhibits,
      chosen: 0,
      width: 0,
      dark: false,
      acted: "",
      times: 0,
      titles: move titles,
      font: font,
    }
  }

  /// The exhibit titled `title`, or `usize.MAX`.
  pub fn find(self: &Self, title: string) -> usize {
    let all = self.titles.asSlice()
    let mut i: usize = 0
    while i < all.length {
      if String.view(&all[i]) == title {
        return i
      }
      i = i + 1
    }
    return usize.MAX
  }

  fn theme(self: &Self) -> Theme {
    return if self.dark { Theme.dark(self.font) } else { Theme.light(self.font) }
  }
}

fn titleKey(title: &String) -> u64 {
  return textKey(String.view(title))
}

impl<E: Exhibits> App<Shown, NoCommand> for Showcase<E> {
  fn view(self: &Self, ui: &mut Ui<Shown>) -> () {
    let theme = self.theme()
    let chosen = self.chosen
    surface(&mut ui, &theme)
    ui.row(
      |ui| {
        ui.grow(1.0)
        ui.style(&[css.alignItems(Align.Stretch), css.minHeight(px(0.0))])
        ui.column(
          |ui| {
            ui.testId("exhibits")
            ui.style(&[css.width(px(240.0)), css.flexShrink(0.0), css.overflowY(Overflow.Auto)])
            ui.padding(12.0)
            ui.gap(8.0)
            heading(&mut ui, &theme, 2, "Showcase")
            selectList(
              &mut ui,
              &theme,
              "Exhibits",
              self.titles.asSlice(),
              titleKey,
              chosen,
              |index| Shown.Pick { index: index },
              |ui, title, picked| {
                ui.text(String.view(title))
              },
            )
          },
        )
        ui.column(
          |ui| {
            ui.grow(1.0)
            ui.style(&[css.minWidth(px(0.0))])
            ui.padding(12.0)
            ui.gap(12.0)
            self.toolbar(&mut ui, &theme)
            self.stage(&mut ui, &theme)
            ui.box(
              |ui| {
                ui.testId("acted")
                ui.color(theme.mutedText)
                if self.times == 0 {
                  ui.text("Nothing reported yet")
                } else {
                  ui.text(self.acted)
                  if self.times > 1 {
                    ui.text(" ×")
                    ui.number(usize.toI64(self.times))
                  }
                }
              },
            )
          },
        )
      },
    )
  }

  fn update(self: &mut Self, message: Shown, cx: &mut Context<NoCommand>) -> () {
    match move message {
      Shown.Pick { index } => {
        if index < self.titles.length() {
          self.chosen = index
          self.times = 0
        }
      }
      Shown.Width { index } => {
        if index < WIDTHS.length {
          self.width = index
        }
      }
      Shown.Dark { on } => {
        self.dark = on
      }
      Shown.Acted { what } => {
        self.times = if what == self.acted { self.times + 1 } else { 1 }
        self.acted = what
      }
    }
  }

  fn fonts(self: &Self, fonts: &mut Fonts) -> () {
    fonts.family(self.font)
  }
}

impl<E: Exhibits> Showcase<E> {
  fn toolbar(self: &Self, ui: &mut Ui<Shown>, theme: &Theme) -> () {
    let width = self.width
    let dark = self.dark
    ui.row(
      |ui| {
        ui.gap(6.0)
        ui.style(&[css.alignItems(Align.Center)])
        ui.box(
          |ui| {
            ui.testId("title")
            ui.fontSize(theme.headingSize)
            if self.chosen < self.titles.length() {
              ui.text(String.view(&self.titles.asSlice()[self.chosen]))
            } else {
              ui.text("No exhibits")
            }
          },
        )
        spacer(&mut ui)
        caption(&mut ui, &theme, "Width")
        ui.row(
          |ui| {
            ui.label("Width")
            ui.gap(4.0)
            ui.enumerate(
              &WIDTH_NAMES,
              |name| textKey(name.*),
              |ui, index, name| {
                buttonWith(
                  &mut ui,
                  &theme,
                  if index == width { Tone.Primary } else { Tone.Ghost },
                  false,
                  name.*,
                  || Shown.Width { index: index },
                )
              },
            )
          },
        )
        buttonWith(
          &mut ui,
          &theme,
          Tone.Secondary,
          false,
          if dark { "Light" } else { "Dark" },
          || Shown.Dark { on: !dark },
        )
      },
    )
  }

  fn stage(self: &Self, ui: &mut Ui<Shown>, theme: &Theme) -> () {
    let points = WIDTHS[self.width]
    ui.column(
      |ui| {
        ui.grow(1.0)
        ui.style(&[css.overflowY(Overflow.Auto), css.alignItems(Align.Center), css.minHeight(px(0.0))])
        ui.background(theme.background)
        border(&mut ui, 1.0, theme.border, theme.radius)
        ui.padding(24.0)
        ui.column(
          |ui| {
            ui.testId("stage")
            ui.gap(8.0)
            ui.style(&[if points > 0.0 { css.width(px(points)) } else { css.width(percent(100.0)) }, css.flexShrink(0.0)])
            if points > 0.0 {
              // The width's edges, so a component that overflows them shows it.
              ui.style(
                &[
                  css.borderWidth(px(1.0)),
                  css.borderStyle(BorderStyle.Dashed),
                  css.borderColor(theme.strongBorder),
                  css.boxSizing(BoxSizing.BorderBox),
                ],
              )
              ui.padding(12.0)
            }
            if self.chosen < self.titles.length() {
              self.exhibits.draw(self.chosen, &mut ui, &theme)
            }
          },
        )
      },
    )
  }
}
