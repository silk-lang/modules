//! Conventions of the modules that export libuv's C API to Node-API addons (ext.uv_api_*).
//!
//! An addon allocates libuv's records itself, with the sizes of libuv's headers, and reads their
//! public fields. A handle record (`uv_handle_t` and every handle type) therefore keeps libuv's
//! public head, written here: `data` (offset 0, the addon's), `loop` (8), `type` (16) and
//! `close_cb` (24). The modules keep their own words in libuv's private part of the head (offsets
//! 32 to 79): `inner` (32) is the loop's handle that does the work for the record (an
//! ext.uv_loop handle marked as the addon's, so uv_walk reports the record), and `finish` (72) is
//! called in the closing phase, before the addon's close callback, for a module's own cleanup.
//! Words 40 to 64 belong to the module of the record's type. Bytes past the head are each
//! type's own: libuv's public fields there (stream's write_queue_size, timer's repeat...) are kept
//! current by the owning module where addons may read them.
import silk.mem.pointer { Pointer }
import ext.uv_loop as uvl

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()

// libuv's uv_handle_type and uv_req_type values.
pub const UV_UNKNOWN_HANDLE: i32 = 0
pub const UV_ASYNC: i32 = 1
pub const UV_CHECK: i32 = 2
pub const UV_FS_EVENT: i32 = 3
pub const UV_FS_POLL: i32 = 4
pub const UV_HANDLE: i32 = 5
pub const UV_IDLE: i32 = 6
pub const UV_NAMED_PIPE: i32 = 7
pub const UV_POLL: i32 = 8
pub const UV_PREPARE: i32 = 9
pub const UV_PROCESS: i32 = 10
pub const UV_STREAM: i32 = 11
pub const UV_TCP: i32 = 12
pub const UV_TIMER: i32 = 13
pub const UV_TTY: i32 = 14
pub const UV_UDP: i32 = 15
pub const UV_SIGNAL: i32 = 16
pub const UV_FILE: i32 = 17
pub const UV_UNKNOWN_REQ: i32 = 0
pub const UV_REQ: i32 = 1
pub const UV_CONNECT: i32 = 2
pub const UV_WRITE: i32 = 3
pub const UV_SHUTDOWN: i32 = 4
pub const UV_UDP_SEND: i32 = 5
pub const UV_FS: i32 = 6
pub const UV_WORK: i32 = 7
pub const UV_GETADDRINFO: i32 = 8
pub const UV_GETNAMEINFO: i32 = 9
pub const UV_RANDOM: i32 = 10

/// libuv's uv_handle_t, 96 bytes on both targets, with the modules' words in its private part.
pub extern "C" struct Head {
  pub data: ?*mut u8, pub loop: ?*mut u8, pub kind: i32, pub padding: i32, pub closed: ?extern "C" fn(*mut u8) -> (),
  pub inner: ?*mut u8, pub word1: usize, pub word2: usize, pub word3: usize, pub word4: usize,
  pub finish: ?extern "C" fn(*mut u8) -> (), pub nextClosing: ?*mut u8, pub flags: u32, pub reserved: u32
}
/// libuv's uv_req_t head: `data` (0), `type` (8), and six private words (16 to 63), which the
/// request's module uses.
pub extern "C" struct RequestHead { pub data: ?*mut u8, pub kind: i32, pub padding: i32, pub words: [usize; 6] }

unsafe fn nn(pointer: ?*mut u8) -> *mut u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer) }
pub unsafe fn head(outer: *mut u8) -> *mut Head { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Head>(outer) }
pub unsafe fn requestHead(outer: *mut u8) -> *mut RequestHead { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut RequestHead>(outer) }
/// The loop handle that works for an addon's record.
pub unsafe fn innerOf(outer: *const u8) -> *mut u8 {
  let anchor = () let h = unsafe Pointer.borrow<(), Head>(&anchor, unsafe Intrinsic.pointerReinterpret<*const u8, *const Head>(outer))
  return unsafe nn(h.inner)
}
/// The inner handle of a record, or null when the record was never initialized or is closed.
pub unsafe fn liveInner(outer: *const u8) -> ?*mut u8 {
  let anchor = () let h = unsafe Pointer.borrow<(), Head>(&anchor, unsafe Intrinsic.pointerReinterpret<*const u8, *const Head>(outer))
  return h.inner
}
// Head.flags is libuv's uv_handle_t.flags: the record's own closing state (libuv's
// UV_HANDLE_CLOSING and UV_HANDLE_CLOSED), which outlives its inner handle, and the other
// UV_HANDLE_* bits the type's module keeps there (ext.uv_api_stream), which closing keeps.
pub const RECORD_CLOSING: u32 = 1
pub const RECORD_CLOSED: u32 = 2
/// libuv's uv_is_closing of a record without an inner handle: closing or closed.
pub unsafe fn recordFlags(outer: *const u8) -> u32 {
  let anchor = () let h = unsafe Pointer.borrow<(), Head>(&anchor, unsafe Intrinsic.pointerReinterpret<*const u8, *const Head>(outer))
  return h.flags
}
/// The addon's record of a loop handle that works for one.
pub unsafe fn outerOf(inner: *const u8) -> *mut u8 { return unsafe nn(unsafe uvl.uv_handle_get_data(inner)) }
/// Writes libuv's public head of `outer` (keeping `data`, as libuv does) and allocates its inner
/// handle, which the caller initializes with the loop's function for the type and then passes to
/// `bind`. Null when out of memory.
pub unsafe fn prepare(loop: *mut u8, outer: *mut u8, kind: i32) -> ?*mut u8 {
  let inner = unsafe calloc(1, unsafe uvl.uv_handle_size(kind))
  if Pointer.isNull<u8>(inner) { return inner }
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Head>(&mut anchor, unsafe head(outer))
  h.loop = loop h.kind = kind h.padding = 0 h.closed = Intrinsic.pointerNullFunction<?extern "C" fn(*mut u8) -> ()>()
  h.inner = inner h.word1 = 0 h.word2 = 0 h.word3 = 0 h.word4 = 0
  h.finish = Intrinsic.pointerNullFunction<?extern "C" fn(*mut u8) -> ()>() h.nextClosing = Pointer.null<u8>() h.flags = 0 h.reserved = 0
  return inner
}
/// Ties an initialized inner handle to its record.
pub unsafe fn bind(outer: *mut u8, inner: *mut u8) -> () { unsafe uvl.markAddon(inner, outer) }
/// Frees an inner handle that `prepare` made but no loop function initialized.
pub unsafe fn discard(outer: *mut u8) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Head>(&mut anchor, unsafe head(outer))
  unsafe free(h.inner) h.inner = Pointer.null<u8>()
}
/// The closing phase of an inner handle: the module's `finish`, the inner handle's memory, then the
/// addon's close callback.
export "C" fn silkUvApiInnerClosed(inner: *mut u8) -> () {
  let outer = unsafe outerOf(inner)
  let anchor = () let h = unsafe Pointer.borrow<(), Head>(&anchor, unsafe head(outer))
  let finish = h.finish let closed = h.closed drop h
  if !Intrinsic.pointerIsNull<?extern "C" fn(*mut u8) -> ()>(finish) { let present = unsafe Intrinsic.pointerRequalify<?extern "C" fn(*mut u8) -> (), extern "C" fn(*mut u8) -> ()>(finish) unsafe present(outer) }
  // The record outlives its inner handle: later uv_is_closing and friends read its own flags.
  let mut second = () let g = unsafe Pointer.borrowMut<(), Head>(&mut second, unsafe head(outer))
  g.inner = Pointer.null<u8>() g.flags = g.flags | RECORD_CLOSING | RECORD_CLOSED drop g
  unsafe free(inner)
  if !Intrinsic.pointerIsNull<?extern "C" fn(*mut u8) -> ()>(closed) { let present = unsafe Intrinsic.pointerRequalify<?extern "C" fn(*mut u8) -> (), extern "C" fn(*mut u8) -> ()>(closed) unsafe present(outer) }
}
/// libuv's uv_close for a record: records the addon's callback and closes the inner handle. A
/// module's own closing steps (stopping reads, closing a descriptor) come before this call.
pub unsafe fn closeRecord(outer: *mut u8, callback: ?extern "C" fn(*mut u8) -> ()) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Head>(&mut anchor, unsafe head(outer))
  if Pointer.isNull<u8>(h.inner) { return }
  h.closed = callback h.flags = h.flags | RECORD_CLOSING let inner = unsafe nn(h.inner) drop h
  unsafe uvl.uv_close(inner, silkUvApiInnerClosed)
}

// Generated by tools/keep_exports.py; do not edit below.
/// Takes each C export as a value, so that Silk emits it (see tools/keep_exports.py).
pub fn keepExports() -> () {
  let _silkUvApiInnerClosed: extern "C" fn(*mut u8) -> () = silkUvApiInnerClosed
}
