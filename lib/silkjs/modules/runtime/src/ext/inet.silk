//! Socket addresses to and from text, as libuv's uv_ip4_addr, uv_ip6_addr, uv_ip4_name and
//! uv_ip6_name make them (the loop plan's step 3, docs/composable-runtime.md): parsing through
//! `silk.net.address`, and IPv6 text with libuv's inet_ntop6 rules, which write an IPv4-mapped or
//! IPv4-compatible address with its last 32 bits dotted (`::ffff:1.2.3.4`). The sockaddr layouts are
//! the LP64 Darwin and Linux ones: Darwin's start with a length byte.
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.net.address { AddressError, Ipv4Address, Ipv6Address }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.i32
import silk.num.usize

@foreign(noCapture: .("name"))
unsafe extern "C" fn if_nametoindex(name: *const u8) -> u32

// libuv's UV_EINVAL.
const EINVAL: i32 = -22

fn familyInet6() -> u8 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return 30 }
  return 10
}
unsafe fn put(address: *mut u8, index: usize, value: u8) -> () {
  unsafe Pointer.put<u8>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(address), index), value)
}
unsafe fn get(address: *const u8, index: usize) -> u8 {
  return unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(address), index))
}
// The family and port fields, and zeros for the rest of `size` bytes.
unsafe fn header(address: *mut u8, size: usize, family: u8, port: i32) -> () {
  let mut i: usize = 0
  while i < size { unsafe put(address, i, 0) i = i + 1 }
  static if Intrinsic.targetOperatingSystem() == "darwin" { unsafe put(address, 0, usize.toU8(size)) unsafe put(address, 1, family) }
  else { unsafe put(address, 0, family) }
  let p = i32.toU32(port) & 65535
  unsafe put(address, 2, u32.toU8(p / 256)) unsafe put(address, 3, u32.toU8(p % 256))
}

/// uv_ip4_addr: writes a sockaddr_in for the dotted address `text` and `port` to `address` (16
/// bytes); 0, or UV_EINVAL when `text` is not an IPv4 address.
pub unsafe fn ip4Sockaddr(text: &[u8], port: i32, address: *mut u8) -> i32 {
  let parsed = match Ipv4Address.parseBytes(text) { Result<Ipv4Address, AddressError>.Success { value } => value Result<Ipv4Address, AddressError>.Failure { .. } => { return EINVAL } }
  unsafe header(address, 16, 2, port)
  let octets = parsed.octets()
  let mut i: usize = 0
  while i < 4 { unsafe put(address, 4 + i, octets[i]) i = i + 1 }
  return 0
}

/// uv_ip6_addr: writes a sockaddr_in6 for `text` (with an optional `%zone`, whose interface index
/// becomes the scope id) and `port` to `address` (28 bytes); 0, or UV_EINVAL.
pub unsafe fn ip6Sockaddr(text: &[u8], port: i32, address: *mut u8) -> i32 {
  let mut cut = text.length
  let mut i: usize = 0
  while i < text.length { if text[i] == 37 { cut = i break } i = i + 1 }
  let parsed = match Ipv6Address.parseBytes(Slice.view<u8>(text, 0, cut)) { Result<Ipv6Address, AddressError>.Success { value } => value Result<Ipv6Address, AddressError>.Failure { .. } => { return EINVAL } }
  unsafe header(address, 28, familyInet6(), port)
  let octets = parsed.octets()
  i = 0
  while i < 16 { unsafe put(address, 8 + i, octets[i]) i = i + 1 }
  if cut < text.length {
    let mut zone: [u8; 64] = [0; 64]
    let mut n: usize = 0
    while cut + 1 + n < text.length && n < 63 { zone[n] = text[cut + 1 + n] n = n + 1 }
    let scope = unsafe if_nametoindex(Pointer.fromRef<u8>(&zone[0]))
    unsafe put(address, 24, u32.toU8(scope % 256)) unsafe put(address, 25, u32.toU8(scope / 256 % 256))
    unsafe put(address, 26, u32.toU8(scope / 65536 % 256)) unsafe put(address, 27, u32.toU8(scope / 16777216))
  }
  return 0
}

fn writeDecimal(value: u8, out: &mut [u8; 64], at: usize) -> usize {
  let mut cursor = at
  if value >= 100 { out[cursor] = 48 + value / 100 cursor = cursor + 1 }
  if value >= 10 { out[cursor] = 48 + value / 10 % 10 cursor = cursor + 1 }
  out[cursor] = 48 + value % 10
  return cursor + 1
}
fn writeHex(value: u16, out: &mut [u8; 64], at: usize) -> usize {
  let digits = b"0123456789abcdef"
  let mut cursor = at
  let mut shift: u16 = 4096
  let mut started = false
  while shift > 0 {
    let digit = value / shift % 16
    if digit != 0 || started || shift == 1 { out[cursor] = digits[u16.toUsize(digit)] cursor = cursor + 1 started = true }
    shift = shift / 16
  }
  return cursor
}

/// An IPv4 address as text, as uv_ip4_name writes it; the length (at most 15) written to `out`.
pub fn ip4Text(octets: &[u8], out: &mut [u8; 64]) -> usize {
  let mut cursor: usize = 0
  let mut i: usize = 0
  while i < 4 { if i > 0 { out[cursor] = 46 cursor = cursor + 1 } cursor = writeDecimal(octets[i], &mut out.*, cursor) i = i + 1 }
  return cursor
}

/// An IPv6 address as text, as libuv's inet_ntop6 writes it: the longest run of two or more zero
/// groups (the first, when two are as long) as `::`, lowercase hex, and an IPv4-mapped
/// (`::ffff:a.b.c.d`) or IPv4-compatible (`::a.b.c.d`) address with dotted IPv4; the length (at
/// most 45) written to `out`.
pub fn ip6Text(octets: &[u8], out: &mut [u8; 64]) -> usize {
  let mut words: [u16; 8] = [0; 8]
  let mut i: usize = 0
  while i < 8 { words[i] = u8.toU16(octets[i * 2]) * 256 + u8.toU16(octets[i * 2 + 1]) i = i + 1 }
  let mut bestBase: usize = 8
  let mut bestLength: usize = 0
  i = 0
  while i < 8 {
    if words[i] == 0 {
      let start = i
      while i < 8 && words[i] == 0 { i = i + 1 }
      if i - start >= 2 && i - start > bestLength { bestBase = start bestLength = i - start }
    } else { i = i + 1 }
  }
  let mut cursor: usize = 0
  i = 0
  while i < 8 {
    if bestLength > 0 && i == bestBase {
      out[cursor] = 58 cursor = cursor + 1
      i = i + bestLength
      if i == 8 { out[cursor] = 58 cursor = cursor + 1 }
      continue
    }
    if i != 0 { out[cursor] = 58 cursor = cursor + 1 }
    // The embedded IPv4 address of a compatible (::a.b.c.d) or mapped (::ffff:a.b.c.d) one.
    if i == 6 && bestBase == 0 && (bestLength == 6 || bestLength == 5 && words[5] == 65535) {
      let mut dotted: [u8; 64] = [0; 64]
      let n = ip4Text(Slice.view<u8>(octets, 12, 4), &mut dotted)
      let mut k: usize = 0
      while k < n { out[cursor + k] = dotted[k] k = k + 1 }
      return cursor + n
    }
    cursor = writeHex(words[i], &mut out.*, cursor)
    i = i + 1
  }
  return cursor
}

/// uv_ip4_name and uv_ip6_name for the sockaddr at `address`: the text of its address, NUL-ended, in
/// `out`; its length, or -1 for a family that is neither.
pub unsafe fn sockaddrText(address: *const u8, out: &mut [u8; 64]) -> i32 {
  let mut family: u8 = 0
  static if Intrinsic.targetOperatingSystem() == "darwin" { family = unsafe get(address, 1) } else { family = unsafe get(address, 0) }
  let mut octets: [u8; 16] = [0; 16]
  let mut n: usize = 0
  if family == 2 {
    let mut i: usize = 0
    while i < 4 { octets[i] = unsafe get(address, 4 + i) i = i + 1 }
    n = ip4Text(Slice.view<u8>(&octets, 0, 4), &mut out.*)
  } else if family == familyInet6() {
    let mut i: usize = 0
    while i < 16 { octets[i] = unsafe get(address, 8 + i) i = i + 1 }
    n = ip6Text(&octets, &mut out.*)
  } else { return -1 }
  out[n] = 0
  return usize.toI32(n)
}
