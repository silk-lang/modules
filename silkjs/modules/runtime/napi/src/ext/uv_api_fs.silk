unsafe extern "C" fn readdir(stream: *mut u8) -> ?*const u8
unsafe extern "C" fn closedir(stream: *mut u8) -> i32
@callbacks("filter", "compare")
unsafe extern "C" fn scandir(path: *const u8, entries: *mut ?*mut ?*mut u8, filter: extern "C" fn(*const u8) -> i32, compare: extern "C" fn(*const ?*const u8, *const ?*const u8) -> i32) -> i32
unsafe extern "C" fn getaddrinfo(node: ?*const u8, serviceText: ?*const u8, hints: ?*const u8, result: *mut ?*mut u8) -> i32
unsafe extern "C" fn freeaddrinfo(result: *mut u8) -> ()
unsafe extern "C" fn getnameinfo(address: *const u8, length: u32, host: *mut u8, hostLength: u32, serviceText: *mut u8, serviceLength: u32, flags: i32) -> i32

static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn __error() -> *mut i32
  unsafe fn errnoSlot() -> *mut i32 { return unsafe __error() }
  const EAGAIN: i32 = 35
  const EINPROGRESS: i32 = 36
  const ENOTSOCK: i32 = 38
  const ENOTSUP: i32 = 45
  const ENOSYS: i32 = 78
  const ECANCELED: i32 = 89
  const EOPNOTSUPP: i32 = 102
  const O_CREAT: i32 = 512
  const O_EXCL: i32 = 2048
  const O_CLOEXEC: i32 = 16777216
  const AT_FDCWD: i32 = -2
  const AT_SYMLINK_NOFOLLOW: i32 = 32
  const PC_PATH_MAX: i32 = 5
  const PATH_MAX: i64 = 1024
  const UTIME_NOW: i64 = -1
  const UTIME_OMIT: i64 = -2
  const D_TYPE: usize = 20
  const D_NAME: usize = 21
  const AF_INET6: u32 = 30
  // EAI_* of netdb.h.
  const EAI_ADDRFAMILY: i32 = 1
  const EAI_AGAIN: i32 = 2
  const EAI_BADFLAGS: i32 = 3
  const EAI_FAIL: i32 = 4
  const EAI_FAMILY: i32 = 5
  const EAI_MEMORY: i32 = 6
  const EAI_NODATA: i32 = 7
  const EAI_NONAME: i32 = 8
  const EAI_SERVICE: i32 = 9
  const EAI_SOCKTYPE: i32 = 10
  const EAI_SYSTEM: i32 = 11
  const EAI_BADHINTS: i32 = 12
  const EAI_PROTOCOL: i32 = 13
  const EAI_OVERFLOW: i32 = 14
  unsafe extern "C" fn mkdir(path: ?[*]const u8, mode: u16) -> i32
  // mode_t is 16 bits on Darwin; declared as the standard library does, with the conversion here.
  unsafe extern "C" fn fchmod(fd: i32, mode: u32) -> i32
  unsafe extern "C" fn darwinPoll(fds: [*]mut PollFd, count: u32, timeout: i32) -> i32 as "poll"
  unsafe fn pollOne(fds: *mut PollFd) -> i32 { return unsafe darwinPoll(unsafe Pointer.assumeManyMut<PollFd>(fds), 1, -1) }
  unsafe extern "C" fn closeNocancel(fd: i32) -> i32 as "close$NOCANCEL"
  @foreign(noCapture: .("length"))
  unsafe extern "C" fn darwinSendfile(fd: i32, socket: i32, offset: i64, length: *mut i64, headers: ?*mut u8, flags: i32) -> i32 as "sendfile"
  unsafe extern "C" fn statfs(path: *const u8, buffer: *mut [u64; 271]) -> i32
  // mode_t is 16 bits: libuv's req->mode keeps the low half of what the caller passed.
  fn modeOf(mode: i32) -> u32 { return i32.wrappingToU32(mode) & 65535 }
  unsafe fn makeDirectory(path: ?[*]const u8, mode: u32) -> i32 { return unsafe mkdir(path, u32.wrappingToU16(mode)) }
  unsafe fn changeMode(fd: i32, mode: u32) -> i32 { return unsafe fchmod(fd, mode & 65535) }
  // The address family of a sockaddr (sa_len comes first).
  unsafe fn familyOf(address: *const u8) -> u32 { return u8.toU32(unsafe Pointer.read<u8>(unsafe constAt(address, 1))) }
  // The kernel's `struct stat` (64-bit inodes), which stat, lstat and fstat fill.
  extern "C" struct NativeStat {
    dev: i32, mode: u16, nlink: u16, ino: u64, uid: u32, gid: u32, rdev: i32,
    atime: Timespec, mtime: Timespec, ctime: Timespec, birthtime: Timespec,
    size: i64, blocks: i64, blksize: i32, flags: u32, gen: u32, spare: i32, reserved: [i64; 2]
  }
  unsafe extern "C" fn stat(path: ?[*]const u8, value: *mut NativeStat) -> i32
  unsafe extern "C" fn lstat(path: ?[*]const u8, value: *mut NativeStat) -> i32
  unsafe extern "C" fn fstat(fd: i32, value: *mut NativeStat) -> i32
  fn uvTime(value: Timespec) -> UvTimespec { return UvTimespec { tv_sec: i64.toIsize(value.seconds), tv_nsec: i64.toIsize(value.nanoseconds) } }
  // libuv's uv__stat, uv__lstat or uv__fstat (`kind` 0, 1, 2) and uv__to_stat. 0 or -1 with errno.
  unsafe fn systemStat(kind: i32, fd: i32, path: ?*const u8, out: *mut UvStat) -> i32 {
    unsafe {
      let zero = Timespec { seconds: 0, nanoseconds: 0 }
      let mut s = NativeStat { dev: 0, mode: 0, nlink: 0, ino: 0, uid: 0, gid: 0, rdev: 0, atime: zero, mtime: zero, ctime: zero, birthtime: zero, size: 0, blocks: 0, blksize: 0, flags: 0, gen: 0, spare: 0, reserved: [0; 2] }
      let name = Pointer.assumeMany<u8>(nn(path))
      let rc = if kind == 2 { fstat(fd, Pointer.fromMutRef<NativeStat>(&mut s)) } else { if kind == 1 { lstat(name, Pointer.fromMutRef<NativeStat>(&mut s)) } else { stat(name, Pointer.fromMutRef<NativeStat>(&mut s)) } }
      if rc != 0 { return -1 }
      Pointer.write<UvStat>(out, UvStat {
        st_dev: i64.wrappingToU64(i32.toI64(s.dev)), st_mode: u16.toU64(s.mode), st_nlink: u16.toU64(s.nlink), st_uid: u32.toU64(s.uid), st_gid: u32.toU64(s.gid),
        st_rdev: i64.wrappingToU64(i32.toI64(s.rdev)), st_ino: s.ino, st_size: i64.wrappingToU64(s.size), st_blksize: i64.wrappingToU64(i32.toI64(s.blksize)), st_blocks: i64.wrappingToU64(s.blocks),
        st_flags: u32.toU64(s.flags), st_gen: u32.toU64(s.gen),
        st_atim: uvTime(s.atime), st_mtim: uvTime(s.mtime), st_ctim: uvTime(s.ctime), st_birthtim: uvTime(s.birthtime)
      })
      return 0
    }
  }
  // Darwin has no statx: libuv's uv__fs_statx answers UV_ENOSYS.
  unsafe fn statxStat(fd: i32, path: ?*const u8, isFstat: bool, isLstat: bool, out: *mut UvStat) -> i32 { return -ENOSYS }
  // libuv's uv__fs_statfs: struct statfs of sys/mount.h (f_bsize u32 at 0, the counts from 8, f_type
  // u32 at 60). Darwin's statfs has no f_frsize: libuv 1.52 reports f_bsize.
  unsafe fn statfsOf(path: *const u8, out: *mut UvStatfsRecord) -> i32 {
    unsafe {
      let mut buffer: [u64; 271] = [0; 271]
      if statfs(path, Pointer.fromMutRef<[u64; 271]>(&mut buffer)) != 0 { return -1 }
      let bsize = u64.toU64(buffer[0] & 4294967295)
      let kind = u64.shiftRight(buffer[7], 32)
      Pointer.write<UvStatfsRecord>(out, UvStatfsRecord { f_type: kind, f_bsize: bsize, f_blocks: buffer[1], f_bfree: buffer[2], f_bavail: buffer[3], f_files: buffer[4], f_ffree: buffer[5], f_frsize: bsize, f_spare: [0; 3] })
      return 0
    }
  }
  // libuv's uv__fs_fsync on Darwin: F_FULLFSYNC, else F_BARRIERFSYNC, else fsync.
  unsafe fn fullSync(fd: i32) -> isize {
    unsafe {
      let mut r = fcntl(fd, 51)
      if r != 0 { r = fcntl(fd, 85) }
      if r != 0 { r = fsync(fd) }
      return i32.toIsize(r)
    }
  }
  unsafe fn dataSync(fd: i32) -> isize { return unsafe fullSync(fd) }
  // libuv's uv__fs_sendfile on Darwin: sendfile(2), which only writes to sockets, else the emulation.
  unsafe fn sendfileCall(r: *mut FsReq) -> isize {
    unsafe {
      let mut anchor = () let q = Pointer.borrowMut<(), FsReq>(&mut anchor, r)
      let input = q.flags let output = q.file let offset = q.off
      let mut length = u64.wrappingToI64(usize.toU64(q.bufsml[0].len))
      drop q
      let rc = darwinSendfile(input, output, offset, Pointer.fromMutRef<i64>(&mut length), Pointer.null<u8>(), 0)
      let code = errno()
      if rc == 0 || ((code == EAGAIN || code == EINTR) && length != 0) {
        let q2 = Pointer.borrowMut<(), FsReq>(&mut anchor, r) q2.off = q2.off + length
        return i64.toIsize(length)
      }
      if code == EINVAL || code == EIO || code == ENOTSOCK || code == EXDEV { setErrno(0) return sendfileEmulation(r) }
      return -1
    }
  }
  // Without FICLONE, UV_FS_COPYFILE_FICLONE falls back to copying and FICLONE_FORCE is UV_ENOSYS.
  // 1 when the clone was made, 0 to copy, or a negative error.
  unsafe fn cloneFile(flags: i32, destination: i32, source: i32) -> i32 {
    if (flags & COPYFILE_FICLONE_FORCE) != 0 { return -ENOSYS }
    return 0
  }
  unsafe fn isCifsOrSmb(fd: i32) -> bool { return false }
} else {
  unsafe extern "C" fn __errno_location() -> *mut i32
  unsafe fn errnoSlot() -> *mut i32 { return unsafe __errno_location() }
  const EAGAIN: i32 = 11
  const ENOSYS: i32 = 38
  const ENOTSOCK: i32 = 88
  const EOPNOTSUPP: i32 = 95
  const ENOTSUP: i32 = 95
  const EINPROGRESS: i32 = 115
  const ECANCELED: i32 = 125
  const O_CREAT: i32 = 64
  const O_EXCL: i32 = 128
  const O_CLOEXEC: i32 = 524288
  const AT_FDCWD: i32 = -100
  const AT_SYMLINK_NOFOLLOW: i32 = 256
  const AT_EMPTY_PATH: i32 = 4096
  const PC_PATH_MAX: i32 = 4
  const PATH_MAX: i64 = 4096
  const UTIME_NOW: i64 = 1073741823
  const UTIME_OMIT: i64 = 1073741822
