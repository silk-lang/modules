//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The answers of docs/caniuse/support/css-layout.json.
import caniuse_data { Answer }

pub fn answer(id: string) -> Answer {
  if id == "css-anchor-positioning" {
    return Answer { support: "a", note: "`anchor-name`, `position-anchor`, `anchor()` in the insets (also in `calc(anchor(...) ± px)`), `position-area`, `anchor-size()` as `width` or `height`, and the `flip-block` and `flip-inline` fallbacks of `position-try-fallbacks` work. Missing: `@position-try` rules, `position-try-order`, `position-visibility`, `anchor-scope`, `anchor-center`, the `anchor()` fallback, `anchor-size()` inside `calc()` or in margins and min/max sizes, and the `position-try` shorthand. An element only uses its first anchor name. `Tree.anchor` in the Silk tree API is built on it: it gives a popup `position: fixed`, its anchor node as the implicit anchor, `position-area: bottom span-right` and `flip-block`." }
  }
  if id == "css-boxdecorationbreak" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-container-queries" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-container-queries-style" {
    return Answer { support: "a", note: "`@container style(--x: value)` and `style(--x)` match against the nearest container's custom properties, with `not`/`and`/`or`, and a container name picks a named ancestor. Missing: one query that mixes `style()` with size features, and style queries on standard properties (custom properties only)." }
  }
  if id == "css-container-query-units" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-containment" {
    return Answer { support: "y", note: "Every value works: `size`, `inline-size`, `layout`, `paint`, `style`, `strict` and `content`. A layout- or paint-contained box is an independent formatting context, a stacking context, and the containing block of its absolutely and fixed positioned descendants; style containment keeps counter changes inside the box. A change inside a box with `contain: strict` (or layout containment and a fixed size) lays out that box again, not the page around it." }
  }
  if id == "css-content-visibility" {
    return Answer { support: "a", note: "`hidden` works: the box keeps its own size and paint, and its contents are skipped as with `display: none`. `auto` draws everything, as `visible` does, and skips no work off screen." }
  }
  if id == "css-deviceadaptation" {
    return Answer { support: "x", note: "`@viewport` resized a web page's viewport on phones. An app's window is its viewport." }
  }
  if id == "css-display-contents" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-exclusions" {
    return Answer { support: "a", note: "An absolutely or fixed positioned box with `wrap-flow` (`both`, `start`, `end`, `minimum`, `maximum`, `clear`) pushes the text of its containing block aside, on both sides with `both`. `wrap-through: none` keeps a block's text out of it. Not yet: in-flow, flex and grid items as exclusions, text inside nested formatting contexts (a flow root, a flex or grid item) wrapping around them, `shape-outside` on an exclusion, and vertical writing modes." }
  }
  if id == "css-fixed" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-grid" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-grid-lanes" {
    return Answer { support: "a", note: "`display: grid-lanes`, `inline-grid-lanes` and the older `grid-template-rows: masonry` (or `grid-template-columns: masonry`) work: lanes are columns or rows, items go to the shortest lane in order, spans, explicit lanes and intrinsic lane sizes work, checked against Chromium. Missing: the `flow-tolerance` property (ties are always within 1em), `dense` back-filling, subgrids inside lanes, and lanes split across pages or columns." }
  }
  if id == "css-logical-props" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-overflow" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-overflow-anchor" {
    return Answer { support: "a", note: "A scrolled container keeps its anchor box still when content above it changes size, as in Chromium: block axis only, nothing anchors at offset zero, `overflow-anchor: none` opts a container or a subtree out, and a layout change to the anchor or its ancestors suppresses the adjustment. Missing: anchoring in vertical writing modes, and the focused element as the preferred anchor. Virtual lists keep their own first visible item instead." }
  }
  if id == "css-overflow-overlay" {
    return Answer { support: "y", note: "`overlay` computes to `auto`, as in browsers." }
  }
  if id == "css-overscroll-behavior" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-page-break" {
    return Answer { support: "x", note: "`page-break-*` breaks printed pages. An app is not paginated." }
  }
  if id == "css-regions" {
    return Answer { support: "n", note: "`flow-into` and `flow-from` are not read. No browser ships CSS Regions any more." }
  }
  if id == "css-scroll-behavior" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-scrollbar" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-shapes" {
    return Answer { support: "a", note: "`shape-outside` with `circle()`, `ellipse()`, `inset()`, `polygon()`, a box, a raster `url()` image or a gradient, plus `shape-margin` and `shape-image-threshold`, wrap lines around a float's shape. SVG images are not read, image shapes work in horizontal writing modes only, and a gradient on a float without a definite width and height is sampled over a square." }
  }
  if id == "css-snappoints" {
    return Answer { support: "y", note: "Snap containers settle on the nearest `scroll-snap-align` area (with `scroll-margin` and `scroll-padding`) once a user scroll stops, script scrolls land on one, and mandatory containers stay on one through layout. A fling is aimed at the snap position where it would come to rest, and a scroll never passes an area with `scroll-snap-stop: always`. Hosts send no gesture phases, so a fling is recognised from a slowing stream of wheel events." }
  }
  if id == "css-sticky" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-subgrid" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-table" {
    return Answer { support: "a", note: "Rows, row and column groups, captions, `border-spacing`, `table-layout: fixed`, `vertical-align` in cells and `colspan`, `rowspan` and `span` attributes all work. Percentage widths on cells and columns, `empty-cells` and `visibility: collapse` on rows and columns follow Chromium. `border-collapse: collapse` resolves conflicts between borders (`hidden` wins, then the widest, then solid before dashed, then the cell before its row, group, column and table). Tables split across pages and multi-column columns as CSS Tables 3 says: short rows move whole, while rows taller than half the page, rows a `rowspan` joins and rows that cannot fit split, their cells continuing on the next page. Header and footer groups repeat on each page when they are at most a quarter of it tall, with the table's top border above the repeated header, as in Chromium. Chromium also splits short rows that cross the break. Each box draws one border style and color on all its sides." }
  }
  if id == "css3-boxsizing" {
    return Answer { support: "y", note: "" }
  }
  if id == "flexbox" {
    return Answer { support: "y", note: "" }
  }
  if id == "flexbox-gap" {
    return Answer { support: "y", note: "" }
  }
  if id == "flow-root" {
    return Answer { support: "y", note: "" }
  }
  if id == "fullscreen" {
    return Answer { support: "n", note: "There is no `requestFullscreen()` and no `:fullscreen` selector." }
  }
  if id == "inline-block" {
    return Answer { support: "y", note: "" }
  }
  if id == "intrinsic-width" {
    return Answer { support: "y", note: "" }
  }
  if id == "justify-content-space-evenly" {
    return Answer { support: "y", note: "" }
  }
  if id == "minmaxwh" {
    return Answer { support: "y", note: "" }
  }
  if id == "multicolumn" {
    return Answer { support: "a", note: "`columns`, `column-count`, `column-width`, `column-gap`, `column-rule`, `column-fill` and `column-span: all` work, with balanced columns and `break-before`/`break-after: column`, in vertical writing modes too. A spanner deeper in the flow splits the blocks around it. A multicol container inside another one, or inside printed pages, splits into its own columns but stays whole in one outer column or page instead of continuing into the next." }
  }
  if id == "run-in" {
    return Answer { support: "n", note: "`display: run-in` is ignored. No browser ships it." }
  }
  if id == "viewport-unit-variants" {
    return Answer { support: "y", note: "" }
  }
  if id == "viewport-units" {
    return Answer { support: "y", note: "" }
  }
  return Answer { support: "u", note: "" }
}
