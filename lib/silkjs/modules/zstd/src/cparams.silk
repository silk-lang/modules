//! Compression parameters of the compressor: a port of the parameter half of
//! `lib/compress/zstd_compress.c` and of `lib/compress/clevels.h` of Zstandard 1.5.7.
//!
//! It holds `ZSTD_compressionParameters`, `ZSTD_CCtx_params`, the bounds and validation of each
//! `ZSTD_cParameter`, the level tables, and the `ZSTD_resolve*` and `ZSTD_adjustCParams` rules.
import mem
import errors
import silk.core.ownership { Copy }
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.usize

// ---- `ZSTD_cParameter`. ----
pub const C_COMPRESSION_LEVEL: i32 = 100
pub const C_WINDOW_LOG: i32 = 101
pub const C_HASH_LOG: i32 = 102
pub const C_CHAIN_LOG: i32 = 103
pub const C_SEARCH_LOG: i32 = 104
pub const C_MIN_MATCH: i32 = 105
pub const C_TARGET_LENGTH: i32 = 106
pub const C_STRATEGY: i32 = 107
pub const C_TARGET_CBLOCK_SIZE: i32 = 130
pub const C_ENABLE_LDM: i32 = 160
pub const C_LDM_HASH_LOG: i32 = 161
pub const C_LDM_MIN_MATCH: i32 = 162
pub const C_LDM_BUCKET_SIZE_LOG: i32 = 163
pub const C_LDM_HASH_RATE_LOG: i32 = 164
pub const C_CONTENT_SIZE_FLAG: i32 = 200
pub const C_CHECKSUM_FLAG: i32 = 201
pub const C_DICT_ID_FLAG: i32 = 202
pub const C_NB_WORKERS: i32 = 400
pub const C_JOB_SIZE: i32 = 401
pub const C_OVERLAP_LOG: i32 = 402
pub const C_RSYNCABLE: i32 = 500
pub const C_FORMAT: i32 = 10
pub const C_FORCE_MAX_WINDOW: i32 = 1000
pub const C_FORCE_ATTACH_DICT: i32 = 1001
pub const C_LITERAL_COMPRESSION_MODE: i32 = 1002
pub const C_SRC_SIZE_HINT: i32 = 1004
pub const C_ENABLE_DEDICATED_DICT_SEARCH: i32 = 1005
pub const C_STABLE_IN_BUFFER: i32 = 1006
pub const C_STABLE_OUT_BUFFER: i32 = 1007
pub const C_BLOCK_DELIMITERS: i32 = 1008
pub const C_VALIDATE_SEQUENCES: i32 = 1009
pub const C_SPLIT_AFTER_SEQUENCES: i32 = 1010
pub const C_USE_ROW_MATCH_FINDER: i32 = 1011
pub const C_DETERMINISTIC_REF_PREFIX: i32 = 1012
pub const C_PREFETCH_CDICT_TABLES: i32 = 1013
pub const C_ENABLE_SEQ_PRODUCER_FALLBACK: i32 = 1014
pub const C_MAX_BLOCK_SIZE: i32 = 1015
pub const C_REPCODE_RESOLUTION: i32 = 1016
pub const C_BLOCK_SPLITTER_LEVEL: i32 = 1017

// ---- `ZSTD_strategy`. ----
pub const FAST: u32 = 1
pub const DFAST: u32 = 2
pub const GREEDY: u32 = 3
pub const LAZY: u32 = 4
pub const LAZY2: u32 = 5
pub const BTLAZY2: u32 = 6
pub const BTOPT: u32 = 7
pub const BTULTRA: u32 = 8
pub const BTULTRA2: u32 = 9

// ---- `ZSTD_ParamSwitch_e`. ----
pub const PS_AUTO: u32 = 0
pub const PS_ENABLE: u32 = 1
pub const PS_DISABLE: u32 = 2

// ---- `ZSTD_CParamMode_e`. ----
pub const CPM_NO_ATTACH_DICT: u32 = 0
pub const CPM_ATTACH_DICT: u32 = 1
pub const CPM_CREATE_CDICT: u32 = 2
pub const CPM_UNKNOWN: u32 = 3

pub const CLEVEL_DEFAULT: i32 = 3
pub const MAX_CLEVEL: i32 = 22
/// `ZSTD_minCLevel()`.
pub const MIN_CLEVEL: i32 = -131072
pub const WINDOWLOG_MAX: u32 = 31
pub const WINDOWLOG_MIN: u32 = 10
pub const WINDOWLOG_ABSOLUTEMIN: u32 = 10
pub const HASHLOG_MAX: u32 = 30
pub const HASHLOG_MIN: u32 = 6
pub const CHAINLOG_MAX: u32 = 30
pub const BLOCKSIZE_MAX: usize = 131072
pub const CONTENTSIZE_UNKNOWN: u64 = 0xFFFFFFFFFFFFFFFF
pub const LDM_DEFAULT_WINDOW_LOG: u32 = 27
/// `ZSTDMT_JOBSIZE_MIN`.
pub const JOBSIZE_MIN: i32 = 524288
/// `ZSTDMT_JOBSIZE_MAX`.
pub const JOBSIZE_MAX: i32 = 1073741824
/// `ZSTDMT_NBWORKERS_MAX`.
pub const NBWORKERS_MAX: i32 = 256

/// `ZSTD_compressionParameters`.
pub struct CParams {
  pub windowLog: u32,
  pub chainLog: u32,
  pub hashLog: u32,
  pub searchLog: u32,
  pub minMatch: u32,
  pub targetLength: u32,
  pub strategy: u32,
}
impl Copy for CParams {}

/// `ldmParams_t`.
pub struct LdmParams {
  pub enableLdm: u32,
  pub hashLog: u32,
  pub bucketSizeLog: u32,
  pub minMatchLength: u32,
  pub hashRateLog: u32,
  pub windowLog: u32,
}
impl Copy for LdmParams {}

/// `ZSTD_CCtx_params`, without the custom allocator and the external sequence producer.
pub struct Params {
  pub format: u32,
  pub cParams: CParams,
  pub contentSizeFlag: u32,
  pub checksumFlag: u32,
  pub noDictIDFlag: u32,
  pub compressionLevel: i32,
  pub forceWindow: u32,
  pub targetCBlockSize: usize,
  pub srcSizeHint: i32,
  pub attachDictPref: u32,
  pub literalCompressionMode: u32,
  pub nbWorkers: i32,
  pub jobSize: usize,
  pub overlapLog: i32,
  pub rsyncable: i32,
  pub ldmParams: LdmParams,
  pub enableDedicatedDictSearch: u32,
  pub inBufferMode: u32,
  pub outBufferMode: u32,
  pub blockDelimiters: u32,
  pub validateSequences: u32,
  pub postBlockSplitter: u32,
  pub preBlockSplitterLevel: i32,
  pub maxBlockSize: usize,
  pub useRowMatchFinder: u32,
  pub deterministicRefPrefix: u32,
  pub prefetchCDictTables: u32,
  pub enableMatchFinderFallback: u32,
  pub searchForExternalRepcodes: u32,
}
impl Copy for Params {}

/// `ZSTD_CCtxParams_init`: all zero, with the level and `contentSizeFlag = 1`.
pub fn paramsInit(compressionLevel: i32) -> Params {
  return Params {
    format: 0,
    cParams: CParams { windowLog: 0, chainLog: 0, hashLog: 0, searchLog: 0, minMatch: 0, targetLength: 0, strategy: 0 },
    contentSizeFlag: 1,
    checksumFlag: 0,
    noDictIDFlag: 0,
    compressionLevel: compressionLevel,
    forceWindow: 0,
    targetCBlockSize: 0,
    srcSizeHint: 0,
    attachDictPref: 0,
    literalCompressionMode: 0,
    nbWorkers: 0,
    jobSize: 0,
    overlapLog: 0,
    rsyncable: 0,
    ldmParams: LdmParams { enableLdm: 0, hashLog: 0, bucketSizeLog: 0, minMatchLength: 0, hashRateLog: 0, windowLog: 0 },
    enableDedicatedDictSearch: 0,
    inBufferMode: 0,
    outBufferMode: 0,
    blockDelimiters: 0,
    validateSequences: 0,
    postBlockSplitter: 0,
    preBlockSplitterLevel: 0,
    maxBlockSize: 0,
    useRowMatchFinder: 0,
    deterministicRefPrefix: 0,
    prefetchCDictTables: 0,
    enableMatchFinderFallback: 0,
    searchForExternalRepcodes: 0,
  }
}

/// `ZSTD_bounds`.
pub struct Bounds {
  pub error: usize,
  pub lowerBound: i32,
  pub upperBound: i32,
}
impl Copy for Bounds {}

fn bounds(lower: i32, upper: i32) -> Bounds { return Bounds { error: 0, lowerBound: lower, upperBound: upper } }

/// `ZSTD_cParam_getBounds`, of the build with `ZSTD_MULTITHREAD` on a 64-bit target.
pub fn getBounds(pid: i32) -> Bounds {
  if pid == C_COMPRESSION_LEVEL { return bounds(MIN_CLEVEL, MAX_CLEVEL) }
  if pid == C_WINDOW_LOG { return bounds(10, 31) }
  if pid == C_HASH_LOG { return bounds(6, 30) }
  if pid == C_CHAIN_LOG { return bounds(6, 30) }
  if pid == C_SEARCH_LOG { return bounds(1, 30) }
  if pid == C_MIN_MATCH { return bounds(3, 7) }
  if pid == C_TARGET_LENGTH { return bounds(0, 131072) }
  if pid == C_STRATEGY { return bounds(1, 9) }
  if pid == C_CONTENT_SIZE_FLAG { return bounds(0, 1) }
  if pid == C_CHECKSUM_FLAG { return bounds(0, 1) }
  if pid == C_DICT_ID_FLAG { return bounds(0, 1) }
  if pid == C_NB_WORKERS { return bounds(0, NBWORKERS_MAX) }
  if pid == C_JOB_SIZE { return bounds(0, JOBSIZE_MAX) }
  if pid == C_OVERLAP_LOG { return bounds(0, 9) }
  if pid == C_ENABLE_DEDICATED_DICT_SEARCH { return bounds(0, 1) }
  if pid == C_ENABLE_LDM { return bounds(0, 2) }
  if pid == C_LDM_HASH_LOG { return bounds(6, 30) }
  if pid == C_LDM_MIN_MATCH { return bounds(4, 4096) }
  if pid == C_LDM_BUCKET_SIZE_LOG { return bounds(1, 8) }
  if pid == C_LDM_HASH_RATE_LOG { return bounds(0, 25) }
  if pid == C_RSYNCABLE { return bounds(0, 1) }
  if pid == C_FORCE_MAX_WINDOW { return bounds(0, 1) }
  if pid == C_FORMAT { return bounds(0, 1) }
  if pid == C_FORCE_ATTACH_DICT { return bounds(0, 3) }
  if pid == C_LITERAL_COMPRESSION_MODE { return bounds(0, 2) }
  if pid == C_TARGET_CBLOCK_SIZE { return bounds(1340, 131072) }
  if pid == C_SRC_SIZE_HINT { return bounds(0, 2147483647) }
  if pid == C_STABLE_IN_BUFFER || pid == C_STABLE_OUT_BUFFER { return bounds(0, 1) }
  if pid == C_BLOCK_DELIMITERS { return bounds(0, 1) }
  if pid == C_VALIDATE_SEQUENCES { return bounds(0, 1) }
  if pid == C_SPLIT_AFTER_SEQUENCES { return bounds(0, 2) }
  if pid == C_BLOCK_SPLITTER_LEVEL { return bounds(0, 6) }
  if pid == C_USE_ROW_MATCH_FINDER { return bounds(0, 2) }
  if pid == C_DETERMINISTIC_REF_PREFIX { return bounds(0, 1) }
  if pid == C_PREFETCH_CDICT_TABLES { return bounds(0, 2) }
  if pid == C_ENABLE_SEQ_PRODUCER_FALLBACK { return bounds(0, 1) }
  if pid == C_MAX_BLOCK_SIZE { return bounds(1024, 131072) }
  if pid == C_REPCODE_RESOLUTION { return bounds(0, 2) }
  return Bounds { error: errors.err(errors.E_PARAMETER_UNSUPPORTED), lowerBound: 0, upperBound: 0 }
}

/// `ZSTD_cParam_withinBounds`.
pub fn withinBounds(pid: i32, value: i32) -> bool {
  let b = getBounds(pid)
  if errors.isError(b.error) { return false }
  if value < b.lowerBound { return false }
  if value > b.upperBound { return false }
  return true
}

fn clamp(pid: i32, value: i32) -> i32 {
  let b = getBounds(pid)
  if value < b.lowerBound { return b.lowerBound }
  if value > b.upperBound { return b.upperBound }
  return value
}

/// `ZSTD_isUpdateAuthorized`: whether `pid` can change while a frame is being compressed.
pub fn isUpdateAuthorized(pid: i32) -> bool {
  return pid == C_COMPRESSION_LEVEL || pid == C_HASH_LOG || pid == C_CHAIN_LOG || pid == C_SEARCH_LOG
    || pid == C_MIN_MATCH || pid == C_TARGET_LENGTH || pid == C_STRATEGY || pid == C_BLOCK_SPLITTER_LEVEL
}

fn outOfBound() -> usize { return errors.err(errors.E_PARAMETER_OUTOFBOUND) }

/// `ZSTD_CCtxParams_setParameter`. Returns the value that was set, or an error.
pub fn setParameter(p: &mut Params, pid: i32, value0: i32) -> usize {
  let mut value = value0
  if pid == C_FORMAT {
    if !withinBounds(pid, value) { return outOfBound() }
    p.format = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_COMPRESSION_LEVEL {
    value = clamp(pid, value)
    if value == 0 { p.compressionLevel = CLEVEL_DEFAULT } else { p.compressionLevel = value }
    if p.compressionLevel >= 0 { return i32.toUsize(p.compressionLevel) }
    return 0
  }
  if pid == C_WINDOW_LOG {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.cParams.windowLog = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_HASH_LOG {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.cParams.hashLog = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_CHAIN_LOG {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.cParams.chainLog = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_SEARCH_LOG {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.cParams.searchLog = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_MIN_MATCH {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.cParams.minMatch = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_TARGET_LENGTH {
    if !withinBounds(pid, value) { return outOfBound() }
    p.cParams.targetLength = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_STRATEGY {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.cParams.strategy = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_CONTENT_SIZE_FLAG {
    p.contentSizeFlag = if value != 0 { 1 } else { 0 }
    return mem.z(p.contentSizeFlag)
  }
  if pid == C_CHECKSUM_FLAG {
    p.checksumFlag = if value != 0 { 1 } else { 0 }
    return mem.z(p.checksumFlag)
  }
  if pid == C_DICT_ID_FLAG {
    p.noDictIDFlag = if value != 0 { 0 } else { 1 }
    return mem.z(1 - p.noDictIDFlag)
  }
  if pid == C_FORCE_MAX_WINDOW {
    p.forceWindow = if value != 0 { 1 } else { 0 }
    return mem.z(p.forceWindow)
  }
  if pid == C_FORCE_ATTACH_DICT {
    if !withinBounds(pid, value) { return outOfBound() }
    p.attachDictPref = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_LITERAL_COMPRESSION_MODE {
    if !withinBounds(pid, value) { return outOfBound() }
    p.literalCompressionMode = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_NB_WORKERS {
    value = clamp(pid, value)
    p.nbWorkers = value
    return i32.toUsize(value)
  }
  if pid == C_JOB_SIZE {
    if value != 0 && value < JOBSIZE_MIN { value = JOBSIZE_MIN }
    value = clamp(pid, value)
    p.jobSize = i32.toUsize(value)
    return p.jobSize
  }
  if pid == C_OVERLAP_LOG {
    value = clamp(C_OVERLAP_LOG, value)
    p.overlapLog = value
    return i32.toUsize(value)
  }
  if pid == C_RSYNCABLE {
    // The reference clamps with the bounds of `ZSTD_c_overlapLog`.
    value = clamp(C_OVERLAP_LOG, value)
    p.rsyncable = value
    return i32.toUsize(value)
  }
  if pid == C_ENABLE_DEDICATED_DICT_SEARCH {
    p.enableDedicatedDictSearch = if value != 0 { 1 } else { 0 }
    return mem.z(p.enableDedicatedDictSearch)
  }
  if pid == C_ENABLE_LDM {
    if !withinBounds(pid, value) { return outOfBound() }
    p.ldmParams.enableLdm = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_LDM_HASH_LOG {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.ldmParams.hashLog = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_LDM_MIN_MATCH {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.ldmParams.minMatchLength = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_LDM_BUCKET_SIZE_LOG {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.ldmParams.bucketSizeLog = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_LDM_HASH_RATE_LOG {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.ldmParams.hashRateLog = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_TARGET_CBLOCK_SIZE {
    if value != 0 {
      if value < 1340 { value = 1340 }
      if !withinBounds(pid, value) { return outOfBound() }
    }
    p.targetCBlockSize = i32.toUsize(value)
    return p.targetCBlockSize
  }
  if pid == C_SRC_SIZE_HINT {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.srcSizeHint = value
    return i32.toUsize(value)
  }
  if pid == C_STABLE_IN_BUFFER {
    if !withinBounds(pid, value) { return outOfBound() }
    p.inBufferMode = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_STABLE_OUT_BUFFER {
    if !withinBounds(pid, value) { return outOfBound() }
    p.outBufferMode = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_BLOCK_DELIMITERS {
    if !withinBounds(pid, value) { return outOfBound() }
    p.blockDelimiters = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_VALIDATE_SEQUENCES {
    if !withinBounds(pid, value) { return outOfBound() }
    p.validateSequences = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_SPLIT_AFTER_SEQUENCES {
    if !withinBounds(pid, value) { return outOfBound() }
    p.postBlockSplitter = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_BLOCK_SPLITTER_LEVEL {
    if !withinBounds(pid, value) { return outOfBound() }
    p.preBlockSplitterLevel = value
    return i32.toUsize(value)
  }
  if pid == C_USE_ROW_MATCH_FINDER {
    if !withinBounds(pid, value) { return outOfBound() }
    p.useRowMatchFinder = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_DETERMINISTIC_REF_PREFIX {
    if !withinBounds(pid, value) { return outOfBound() }
    p.deterministicRefPrefix = if value != 0 { 1 } else { 0 }
    return mem.z(p.deterministicRefPrefix)
  }
  if pid == C_PREFETCH_CDICT_TABLES {
    if !withinBounds(pid, value) { return outOfBound() }
    p.prefetchCDictTables = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_ENABLE_SEQ_PRODUCER_FALLBACK {
    if !withinBounds(pid, value) { return outOfBound() }
    p.enableMatchFinderFallback = i32.toU32(value)
    return i32.toUsize(value)
  }
  if pid == C_MAX_BLOCK_SIZE {
    if value != 0 && !withinBounds(pid, value) { return outOfBound() }
    p.maxBlockSize = i32.toUsize(value)
    return p.maxBlockSize
  }
  if pid == C_REPCODE_RESOLUTION {
    if !withinBounds(pid, value) { return outOfBound() }
    p.searchForExternalRepcodes = i32.toU32(value)
    return i32.toUsize(value)
  }
  return errors.err(errors.E_PARAMETER_UNSUPPORTED)
}

// ---- `ZSTD_resolve*`. ----

/// `ZSTD_rowMatchFinderSupported`.
pub fn rowMatchFinderSupported(strategy: u32) -> bool { return strategy >= GREEDY && strategy <= LAZY2 }
/// `ZSTD_rowMatchFinderUsed`.
pub fn rowMatchFinderUsed(strategy: u32, mode: u32) -> bool { return rowMatchFinderSupported(strategy) && mode == PS_ENABLE }

/// `ZSTD_resolveRowMatchFinderMode`.
pub fn resolveRowMatchFinderMode(mode: u32, cParams: &CParams) -> u32 {
  if mode != PS_AUTO { return mode }
  if !rowMatchFinderSupported(cParams.strategy) { return PS_DISABLE }
  if cParams.windowLog > 14 { return PS_ENABLE }
  return PS_DISABLE
}

/// `ZSTD_resolveBlockSplitterMode`.
pub fn resolveBlockSplitterMode(mode: u32, cParams: &CParams) -> u32 {
  if mode != PS_AUTO { return mode }
  if cParams.strategy >= BTOPT && cParams.windowLog >= 17 { return PS_ENABLE }
  return PS_DISABLE
}

/// `ZSTD_allocateChainTable`.
pub fn allocateChainTable(strategy: u32, useRowMatchFinder: u32, forDDSDict: bool) -> bool {
  return forDDSDict || (strategy != FAST && !rowMatchFinderUsed(strategy, useRowMatchFinder))
}

/// `ZSTD_resolveEnableLdm`.
pub fn resolveEnableLdm(mode: u32, cParams: &CParams) -> u32 {
  if mode != PS_AUTO { return mode }
  if cParams.strategy >= BTOPT && cParams.windowLog >= 27 { return PS_ENABLE }
  return PS_DISABLE
}

/// `ZSTD_resolveMaxBlockSize`.
pub fn resolveMaxBlockSize(maxBlockSize: usize) -> usize {
  if maxBlockSize == 0 { return BLOCKSIZE_MAX }
  return maxBlockSize
}

/// `ZSTD_resolveExternalRepcodeSearch`.
pub fn resolveExternalRepcodeSearch(value: u32, cLevel: i32) -> u32 {
  if value != PS_AUTO { return value }
  if cLevel < 10 { return PS_DISABLE }
  return PS_ENABLE
}

/// `ZSTD_literalsCompressionIsDisabled`.
pub fn literalsCompressionIsDisabled(p: &Params) -> bool {
  if p.literalCompressionMode == PS_ENABLE { return false }
  if p.literalCompressionMode == PS_DISABLE { return true }
  return p.cParams.strategy == FAST && p.cParams.targetLength > 0
}

/// `ZSTD_ldm_adjustParameters`.
pub fn ldmAdjustParameters(params: &mut LdmParams, cParams: &CParams) -> () {
  params.windowLog = cParams.windowLog
  if params.hashRateLog == 0 {
    if params.hashLog > 0 {
      if params.windowLog > params.hashLog { params.hashRateLog = params.windowLog - params.hashLog }
    } else {
      params.hashRateLog = 7 - (cParams.strategy / 3)
    }
  }
  if params.hashLog == 0 {
    let mut v = mem.s32(params.windowLog, params.hashRateLog)
    if v > HASHLOG_MAX { v = HASHLOG_MAX }
    if v < HASHLOG_MIN { v = HASHLOG_MIN }
    params.hashLog = v
  }
  if params.minMatchLength == 0 {
    params.minMatchLength = 64
    if cParams.strategy >= BTULTRA { params.minMatchLength = 32 }
  }
  if params.bucketSizeLog == 0 {
    let mut v = cParams.strategy
    if v > 8 { v = 8 }
    if v < 4 { v = 4 }
    params.bucketSizeLog = v
  }
  if params.bucketSizeLog > params.hashLog { params.bucketSizeLog = params.hashLog }
}

// ---- Level tables (`ZSTD_defaultCParameters`): windowLog, chainLog, hashLog, searchLog,
// minMatch, targetLength, strategy; 23 rows for each of the 4 size classes. ----
const LEVELS: [u32; 644] = [
  // table 0
  19, 12, 13, 1, 6, 1, 1,
  19, 13, 14, 1, 7, 0, 1,
  20, 15, 16, 1, 6, 0, 1,
  21, 16, 17, 1, 5, 0, 2,
  21, 18, 18, 1, 5, 0, 2,
  21, 18, 19, 3, 5, 2, 3,
  21, 18, 19, 3, 5, 4, 4,
  21, 19, 20, 4, 5, 8, 4,
  21, 19, 20, 4, 5, 16, 5,
  22, 20, 21, 4, 5, 16, 5,
  22, 21, 22, 5, 5, 16, 5,
  22, 21, 22, 6, 5, 16, 5,
  22, 22, 23, 6, 5, 32, 5,
  22, 22, 22, 4, 5, 32, 6,
  22, 22, 23, 5, 5, 32, 6,
  22, 23, 23, 6, 5, 32, 6,
  22, 22, 22, 5, 5, 48, 7,
  23, 23, 22, 5, 4, 64, 7,
  23, 23, 22, 6, 3, 64, 8,
  23, 24, 22, 7, 3, 256, 9,
  25, 25, 23, 7, 3, 256, 9,
  26, 26, 24, 7, 3, 512, 9,
  27, 27, 25, 9, 3, 999, 9,
  // table 1
