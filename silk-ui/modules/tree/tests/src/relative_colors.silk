//! Relative colors from an origin known only when styles resolve: currentcolor.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput }
import ui_tree.style { Fill }
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.written
import svg_css.tokens { CssError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.num.f32
import ui_fixtures.fixtures as fixtures

fn near(a: f32, b: f32) -> bool {
  return f32.abs(a - b) < 0.01
}

fn background(tree: &UiTree<'_>, id: u32, r: f32, g: f32, b: f32, a: f32) -> bool {
  return match tree.node(tree.slotOf(id)).computed().paint.background {
    Fill.Solid { color } => near(color.r, r) && near(color.g, g) && near(color.b, b) && near(color.a, a)
    _ => false
  }
}

effect fn body() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("red") })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("a") })
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  let inline = run written.declarations(b"display:block;height:5px;background-color:hsl(from currentcolor calc(h + 120) s l)")
  run batch.style(3, inline.asSlice())
  let sheet = run compile.compile(b".red{color:red}.blue{color:blue}.a{display:block;height:5px;background-color:rgb(from currentcolor r g b / 50%)}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 300.0, height: 200.0, scale: 1.0, time: 0.0 })
  run Testing.expect(background(&tree, 2, 1.0, 0.0, 0.0, 0.5), "a sheet's rgb(from currentcolor ...) takes the element's color")
  run Testing.expect(background(&tree, 3, 0.0, 1.0, 0.0, 1.0), "an inline hsl(from currentcolor ...) turns its hue")
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("blue") })
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 300.0, height: 200.0, scale: 1.0, time: 1.0 })
  run Testing.expect(background(&tree, 2, 0.0, 0.0, 1.0, 0.5), "it follows a new color")
  run Testing.expect(background(&tree, 3, 1.0, 0.0, 0.0, 1.0), "and so does the inline one")
}

test effect fn relativeColorsFromCurrentcolorResolveWithStyles() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}
