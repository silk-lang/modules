import silk.build.graph { Compilation, Deferred, Options }
import silk.build.options { Optimize }
import silk.build.tasks { StandardError }
import silk.cli.command { Command, CommandLine }
import silk.cli.task { Task, TaskSet }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator }
import silk.num.usize
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { FileSystem, Path }
import silk.system.host_input { HostInput }
import silk.text.string { String }

union Tasks {
  BuildWeb,
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("loom-dom-demo", "Build the Loom DOM browser demo")
      |> Command.variant("BuildWeb", "Build wasm32 demo and assemble dist/")
  }
}

effect fn copyFile(src: &Path, dst: &Path) -> ()
  ! StandardError
  ? &mut Allocator | &mut FileSystem {
  let bytes = run FileSystem.readFile(src)
  return run FileSystem.writeFile(dst, Bytes.asSlice(&bytes))
}

effect fn buildWeb() -> ()
  ! StandardError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let options = Options.make()
  let base = run Compilation.fromPackage(&options)
  let targeted = run base.target(
    run Deferred<String>.value(run String.copy("wasm32-unknown-unknown")),
  )
  let optimized = run targeted.optimize(run Deferred<Optimize>.value(Optimize.Size))
  let stripped = run optimized.debug(run Deferred<bool>.value(false))
  let built = run stripped.build()
  let artifacts = built.artifacts.asSlice()
  if artifacts.length == usize.ZERO {
    run Task.abort("loom-dom-demo produced no wasm artifact")
  }
  let here = run Task.root()
  let dist = run Path.join(&here, "dist")
  run FileSystem.createDirectoriesRecursively(&dist)
  let wasmDst = run Path.join(&dist, "demo.wasm")
  run copyFile(&artifacts[0].path, &wasmDst)

  let domDir = match move run Path.parent(&here) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort("loom/dom/demo has no parent directory")
  }
  let domJs = run Path.join(&domDir, "js/silk-ui-dom.js")
  let domDst = run Path.join(&dist, "silk-ui-dom.js")
  run copyFile(&domJs, &domDst)

  let indexSrc = run Path.join(&here, "web/index.html")
  let indexDst = run Path.join(&dist, "index.html")
  return run copyFile(&indexSrc, &indexDst)
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! StandardError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.BuildWeb => run buildWeb()
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
