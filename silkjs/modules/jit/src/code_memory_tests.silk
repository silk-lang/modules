import code_memory { CodeMemory, CodeBlock, CodeWriter, MemoryError, OUT_OF_MEMORY, INVALID_ARGUMENT, NO_SPACE }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.isize
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }

unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32
unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize
unsafe extern "C" fn close(fd: i32) -> i32
unsafe extern "C" fn mincore(address: *const u8, size: usize, residency: *mut u8) -> i32

const READ: u8 = 1
const WRITE: u8 = 2
const EXECUTE: u8 = 4
/// What `protectionAt` reports for an address inside no mapping.
const UNMAPPED: u8 = 0x80
/// What `protectionAt` reports when /proc/self/maps cannot be read whole.
const UNREADABLE: u8 = 0xFF

fn hexDigit(byte: u8) -> usize {
  if byte >= 48 && byte <= 57 { return u8.toUsize(byte - 48) }
  if byte >= 97 && byte <= 102 { return u8.toUsize(byte - 87) }
  return usize.MAX
}

/// The kernel's protection of the page holding `address`, as a mask of READ, WRITE and EXECUTE,
/// read from /proc/self/maps. This is the only view that shows executability without executing.
fn protectionAt(address: usize) -> u8 {
  let mut text: [u8; 262144] = [0; 262144]
  let fd = unsafe open(Pointer.fromSlice<u8>(b"/proc/self/maps\x00"), 0)
  if fd < 0 { return UNREADABLE }
  let mut length: usize = 0
  while length < 262144 {
    let got = unsafe read(fd, Pointer.fromMutSlice<u8>(Slice.viewMut<u8>(&mut text, length, 262144 - length)), 262144 - length)
    if got <= 0 { break }
    length = length + isize.toUsize(got)
  }
  drop unsafe close(fd)
  if length == 262144 { return UNREADABLE }
  let mut at: usize = 0
  while at < length {
    // "start-end rwxp ...\n"
    let mut start: usize = 0
    while at < length && hexDigit(text[at]) != usize.MAX { start = start * 16 + hexDigit(text[at]) at = at + 1 }
    at = at + 1
    let mut end: usize = 0
    while at < length && hexDigit(text[at]) != usize.MAX { end = end * 16 + hexDigit(text[at]) at = at + 1 }
    at = at + 1
    if address >= start && address < end && at + 3 <= length {
      let mut mask: u8 = 0
      if text[at] == 114 { mask = mask + READ }
      if text[at + 1] == 119 { mask = mask + WRITE }
      if text[at + 2] == 120 { mask = mask + EXECUTE }
      return mask
    }
    while at < length && text[at] != 10 { at = at + 1 }
    at = at + 1
  }
  return UNMAPPED
}

/// Whether the page at `address` currently has physical memory behind it. `mincore` answers for
/// any mapped page whatever its protection.
fn isResident(address: *const u8) -> bool {
  let mut residency: u8 = 0
  if unsafe mincore(address, 1, Pointer.fromMutRef(&mut residency)) != 0 { return false }
  return u8.bitAnd(residency, 1) == 1
}

/// `mov rax, value; ret`: a C function of no arguments returning `value`.
effect fn appendConstant(writer: &mut CodeWriter, value: u64) -> () ! MemoryError {
  let mut code: [u8; 11] = [0x48, 0xb8, 0, 0, 0, 0, 0, 0, 0, 0, 0xc3]
  let mut index: usize = 0
  while index < 8 {
    code[2 + index] = u64.wrappingToU8(u64.shiftRight(value, usize.toU64(index * 8)))
    index = index + 1
  }
  run writer.append(&code)
}

effect fn constantBlock(memory: &mut CodeMemory, value: u64) -> CodeBlock ! MemoryError {
  let mut writer = run memory.allocate(11)
  run appendConstant(&mut writer, value)
  return run writer.finish()
}

unsafe fn call(block: &CodeBlock) -> u64 {
  let address = block.entry()
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn() -> u64>(Pointer.fromRef(&address))
  let function = unsafe Pointer.read<extern "C" fn() -> u64>(slot)
  return unsafe function()
}

/// Whether an allocation failed with exactly `code`.
fn failedWith(result: &Result<CodeWriter, MemoryError>, code: i32) -> bool {
  return match &result.* {
    Result<CodeWriter, MemoryError>.Success { .. } => false
    Result<CodeWriter, MemoryError>.Failure { error } => error.code == code
  }
}

test effect fn generatedConstantUsesDirectCFunctionPointer() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(65536)
  let block = run constantBlock(&mut memory, 42)
  run Testing.expect(unsafe call(&block) == 42, "Silk calls an RX buffer directly")
}

test effect fn pagesAreNeverWritableAndExecutableAtOnce() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(65536)
  let mut writer = run memory.allocate(11)
  let address = writer.address()
  let page = memory.pageSize()
  run Testing.expect(protectionAt(address) == READ + WRITE, "a writer's page is read-write, not executable")
  run Testing.expect(protectionAt(address + page) == 0, "the page after a writer stays inaccessible")
  run appendConstant(&mut writer, 7)
  let block = run writer.finish()
  run Testing.expect(Pointer.address<u8>(block.entry()) == address, "publishing keeps the address")
  run Testing.expect(protectionAt(address) == READ + EXECUTE, "a block's page is read-execute, not writable")
  let second = run memory.allocate(11)
  run Testing.expect(second.address() == address + page, "the next writer takes the next page")
  run Testing.expect(protectionAt(address) == READ + EXECUTE, "a new writer leaves the block executable")
  run Testing.expect(protectionAt(address + page) == READ + WRITE, "the block leaves the new writer non-executable")
  drop second
  run Testing.expect(protectionAt(address + page) == 0, "dropping a writer revokes its page")
  drop block
  run Testing.expect(protectionAt(address) == 0, "dropping a block revokes its page")
  run Testing.expect(memory.usedPages() == 0, "both pages are free again")
}

test effect fn publishingTrimsUnusedPagesAndTrapsTheTail() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(65536)
  let page = memory.pageSize()
  let mut writer = run memory.allocate(3 * page)
  let address = writer.address()
  run Testing.expect(memory.usedPages() == 3, "the writer owns its whole capacity")
  run appendConstant(&mut writer, 9)
  let block = run writer.finish()
  run Testing.expect(block.pages() == 1 && memory.usedPages() == 1, "pages the code did not reach are returned")
  run Testing.expect(protectionAt(address + page) == 0, "a returned page is inaccessible")
  let anchor = ()
  let bytes = unsafe Pointer.borrowMany(&anchor, unsafe Pointer.assumeMany<u8>(block.entry()), page)
  run Testing.expect(bytes[10] == 0xc3 && bytes[11] == 0xcc && bytes[page - 1] == 0xcc, "the rest of the page traps")
}

test effect fn freedPagesReturnTheirMemoryAndAreReused() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(65536)
  let first = run constantBlock(&mut memory, 1)
  let address = Pointer.address<u8>(first.entry())
  run Testing.expect(isResident(first.entry()), "a published page holds physical memory")
  let entry = first.entry()
  drop first
  run Testing.expect(!isResident(entry), "a freed page gives its physical memory back")
  let writer = run memory.allocate(11)
  run Testing.expect(writer.address() == address, "the freed page is the first fit")
}

test effect fn exhaustionFailsCleanlyAndRecovers() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(1)
  let page = memory.pageSize()
  run Testing.expect(memory.pageCount() == 1, "a reservation rounds up to whole pages")
  let zero = run Effect.result(memory.allocate(0))
  run Testing.expect(failedWith(&zero, INVALID_ARGUMENT), "a zero-byte allocation is invalid")
  let huge = run Effect.result(memory.allocate(page + 1))
  run Testing.expect(failedWith(&huge, INVALID_ARGUMENT), "an allocation larger than the region is invalid")
  let block = run constantBlock(&mut memory, 5)
  let full = run Effect.result(memory.allocate(1))
  run Testing.expect(failedWith(&full, OUT_OF_MEMORY), "a full region reports exhaustion")
  run Testing.expect(unsafe call(&block) == 5, "exhaustion leaves the published block callable")
  drop block
  let again = run constantBlock(&mut memory, 6)
  run Testing.expect(unsafe call(&again) == 6, "the page is usable after its block drops")
}

test effect fn fragmentedRegionFindsOnlyLongEnoughRuns() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(1)
  let page = memory.pageSize()
  drop memory
  let mut region = run CodeMemory.reserve(4 * page)
  let a = run constantBlock(&mut region, 1)
  let b = run constantBlock(&mut region, 2)
  let c = run constantBlock(&mut region, 3)
  let d = run constantBlock(&mut region, 4)
  let base = Pointer.address<u8>(a.entry())
  drop a
  drop c
  let two = run Effect.result(region.allocate(page + 1))
  run Testing.expect(failedWith(&two, OUT_OF_MEMORY), "two free pages that are not adjacent do not hold two pages")
  drop b
  let wide = run region.allocate(3 * page)
  run Testing.expect(wide.address() == base, "three adjacent free pages are found")
  run Testing.expect(unsafe call(&d) == 4, "the neighbouring block is untouched")
}

test effect fn writerRejectsOverflowAndEmptyPublication() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(65536)
  let mut writer = run memory.allocate(4)
  run writer.append(b"\x90\x90\x90")
  let overflow = run Effect.result(writer.append(b"\x90\xc3"))
  match move overflow {
    Result<(), MemoryError>.Success { .. } => { run Testing.expect(false, "appending past the capacity fails") }
    Result<(), MemoryError>.Failure { error } => { run Testing.expect(error.code == NO_SPACE, "appending past the capacity reports NO_SPACE") }
  }
  run Testing.expect(writer.length() == 3, "a rejected append writes nothing")
  run writer.append(b"\xc3")
  run Testing.expect(writer.length() == writer.capacity(), "the capacity can be filled exactly")
  let empty = run memory.allocate(16)
  let published = run Effect.result(empty.finish())
  match move published {
    Result<CodeBlock, MemoryError>.Success { .. } => { run Testing.expect(false, "an empty writer cannot be published") }
    Result<CodeBlock, MemoryError>.Failure { error } => { run Testing.expect(error.code == INVALID_ARGUMENT, "an empty writer reports INVALID_ARGUMENT") }
  }
  drop writer
  run Testing.expect(memory.usedPages() == 0, "failed publication and a dropped writer free their pages")
}

test effect fn manyBlocksKeepDistinctCodeAcrossChurn() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(64 * 4096)
  let mut round: u64 = 0
  while round < 8 {
    // Each round holds two generations of blocks at once and frees the older one.
    let a = run constantBlock(&mut memory, round * 4 + 1)
    let b = run constantBlock(&mut memory, round * 4 + 2)
    let c = run constantBlock(&mut memory, round * 4 + 3)
    run Testing.expect(unsafe call(&a) == round * 4 + 1, "first block")
    drop a
    let d = run constantBlock(&mut memory, round * 4 + 4)
    run Testing.expect(unsafe call(&b) == round * 4 + 2, "second block survives its neighbour's reuse")
    run Testing.expect(unsafe call(&c) == round * 4 + 3, "third block")
    run Testing.expect(unsafe call(&d) == round * 4 + 4, "the block in the reused page")
    round = round + 1
  }
  run Testing.expect(memory.usedPages() == 0, "every block was returned")
}

test effect fn blockOutlivesItsRegionOwner() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(65536)
  let block = run constantBlock(&mut memory, 99)
  let address = Pointer.address<u8>(block.entry())
  drop memory
  run Testing.expect(protectionAt(address) == READ + EXECUTE, "the block keeps its region mapped")
  run Testing.expect(unsafe call(&block) == 99, "the block is callable after its CodeMemory dropped")
  drop block
  run Testing.expect(protectionAt(address) == UNMAPPED, "the last owner unmaps the region")
}

effect fn packedBlock(memory: &mut CodeMemory, value: u64) -> CodeBlock ! MemoryError {
  let mut writer = run memory.allocatePacked(11)
  run appendConstant(&mut writer, value)
  return run writer.finish()
}

test effect fn packedBlocksShareAPageAndStayExecutable() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(65536)
  let page = memory.pageSize()
  let first = run packedBlock(&mut memory, 1)
  let second = run packedBlock(&mut memory, 2)
  let a = Pointer.address<u8>(first.entry())
  let b = Pointer.address<u8>(second.entry())
  run Testing.expect(b == a + 64, "the next packed block starts at the next cache line after the last")
  run Testing.expect(memory.usedPages() == 1, "both blocks are on one page")
  run Testing.expect(protectionAt(a) == READ + EXECUTE, "the shared page is read-execute")
  run Testing.expect(unsafe call(&first) == 1 && unsafe call(&second) == 2, "both blocks run")
  let mut writer = run memory.allocatePacked(11)
  run Testing.expect(writer.address() == b + 64, "a packed writer goes after the last block")
  run Testing.expect(protectionAt(a) == READ + WRITE, "the blocks on a page a packed writer writes are not executable")
  run appendConstant(&mut writer, 3)
  let third = run writer.finish()
  run Testing.expect(protectionAt(a) == READ + EXECUTE, "publishing makes the shared page executable again")
  run Testing.expect(unsafe call(&first) == 1 && unsafe call(&third) == 3, "the blocks before and the new one run")
  drop second
  run Testing.expect(protectionAt(a) == READ + EXECUTE && unsafe call(&first) == 1, "dropping one block keeps the page for the others")
  drop first
  drop third
  run Testing.expect(protectionAt(a) == 0 && memory.usedPages() == 0, "the page goes with its last block")
  run Testing.expect(page >= 4096, "a page is at least 4 KiB")
}

test effect fn droppedPackedWriterGivesTheSharedPageBack() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(65536)
  let page = memory.pageSize()
  let block = run packedBlock(&mut memory, 5)
  let a = Pointer.address<u8>(block.entry())
  let mut writer = run memory.allocatePacked(page)
  run Testing.expect(writer.address() == a + 64, "a writer that does not fit the page's rest spans the next page too")
  run Testing.expect(memory.usedPages() == 2, "it owns the next page as well")
  let other = run memory.allocatePacked(11)
  run Testing.expect(other.address() % page == 0 && other.address() != a + 64 + page, "a second packed writer gets pages of its own")
  drop other
  run appendConstant(&mut writer, 6)
  drop writer
  run Testing.expect(protectionAt(a) == READ + EXECUTE && unsafe call(&block) == 5, "the block's page is executable again")
  run Testing.expect(memory.usedPages() == 1, "the writer's own page is free again")
  let next = run packedBlock(&mut memory, 7)
  run Testing.expect(Pointer.address<u8>(next.entry()) == a + 64 + page || memory.usedPages() >= 1, "packing goes on after a dropped writer")
  run Testing.expect(unsafe call(&next) == 7 && unsafe call(&block) == 5, "both run")
}

test effect fn packedBlockLargerThanAPagePublishesItsTail() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(65536)
  let page = memory.pageSize()
  let small = run packedBlock(&mut memory, 1)
  let mut writer = run memory.allocatePacked(2 * page)
  let address = writer.address()
  run appendConstant(&mut writer, 8)
  let block = run writer.finish()
  run Testing.expect(memory.usedPages() == 1, "pages the packed code did not reach are returned")
  let anchor = ()
  let bytes = unsafe Pointer.borrowMany(&anchor, unsafe Pointer.assumeMany<u8>(block.entry()), 12)
  run Testing.expect(bytes[10] == 0xc3 && bytes[11] == 0xcc, "the rest after a packed block traps")
  run Testing.expect(unsafe call(&block) == 8 && unsafe call(&small) == 1 && address == Pointer.address<u8>(small.entry()) + 64, "both run, side by side")
}
