//! The runtime benchmarks against Bun with its JIT off: the benchmarks Bun advertises (serve,
//! node:http, Express over HTTPS, WebSocket chat, Postgres, SQLite, spawnSync, cat, setImmediate),
//! peak memory of the non-server ones, and cold start.
//!
//! What is easy to get wrong is fixed here. `BUN_OPTIONS` and `NODE_OPTIONS` are dropped: a cloud
//! container exports `BUN_OPTIONS=--smol`, which makes Bun about 25% slower, and only the
//! `bun_nojit_smol` column sets it, on purpose. silkjs runs with `SILKJS_PREPARSE_THREADS=0` and
//! Bun with `BUN_JSC_useJIT=0`. Servers run on CPU 0, wrk and the clients on CPUs 2 and 3. Each
//! round runs every benchmark and runtime pair once in a shuffled order, so host noise falls on
//! all runtimes alike. Nothing is measured while a build runs.

import kit as Kit
import kit { Captured, Ended, Job, Shuffler, Stream, Table }
import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.core.option { Option }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.usize

/// What a task of the runtime benchmarks was asked.
pub struct Asked {
  /// The runtime module's directory, `modules/runtime`.
  pub root: Bytes,
  /// The work directory; empty means `build/bench` under `root`.
  pub work: Bytes,
  /// The results directory; empty means `results/<UTC time>` under the work directory.
  pub out: Bytes,
  /// The runtime executable; empty means `build/silkjs` under `root`.
  pub runtime: Bytes,
  /// Comma-separated columns; empty means `silkjs,bun_nojit,bun_nojit_smol`.
  pub runtimes: Bytes,
  /// Rounds; 0 means the task's default.
  pub rounds: u32,
  /// Whether to measure although a build runs.
  pub force: bool,
  /// Groups, cases or setup steps.
  pub names: List<Bytes>,
}

struct Places {
  root: Bytes,
  work: Bytes,
  out: Bytes,
  // Bun's bench folder in the work directory.
  bench: Bytes,
  runtime: Bytes,
  bun: Bytes,
  columns: List<Bytes>,
}

effect fn under(base: &Bytes, rest: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  return run Kit.cat(Bytes.asSlice(base), rest)
}

effect fn workOf(asked: &Asked) -> Bytes
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let root = Bytes.asSlice(&asked.root)
  let work = if Bytes.length(&asked.work) > 0 { run Kit.absolute(root, Bytes.asSlice(&asked.work)) } else { run Kit.cat(root, b"/build/bench") }
  run Kit.makeDirectories(Bytes.asSlice(&work))
  return move work
}

fn hasBun(columns: &List<Bytes>) -> bool {
  let names = List<Bytes>.asSlice(columns)
  let mut at: usize = 0
  while at < names.length {
    if Kit.startsWith(Bytes.asSlice(&names[at]), b"bun") { return true }
    at = at + 1
  }
  return false
}

// Where things are for a measuring task. `withJit` allows the `bun` column (JIT on), which only
// the cold start table has.
effect fn places(asked: &Asked, withJit: bool) -> Places
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let root = Bytes.asSlice(&asked.root)
  let work = run workOf(asked)
  let columns = run Kit.split(if Bytes.length(&asked.runtimes) > 0 { Bytes.asSlice(&asked.runtimes) } else { b"silkjs,bun_nojit,bun_nojit_smol" }, 44)
  if withJit {
    run Kit.checkNames(&columns, &[b"silkjs", b"bun_nojit", b"bun_nojit_smol", b"bun"], b"runtime")
  } else {
    run Kit.checkNames(&columns, &[b"silkjs", b"bun_nojit", b"bun_nojit_smol"], b"runtime")
  }
  let mut runtime = Bytes.make()
  if Kit.listed(&columns, b"silkjs") {
    runtime = run Kit.absolute(root, if Bytes.length(&asked.runtime) > 0 { Bytes.asSlice(&asked.runtime) } else { b"build/silkjs" })
    let size = run Kit.fileSize(Bytes.asSlice(&runtime))
    if size < 0 {
      run Kit.abort(Bytes.asSlice(&runtime), b" is not there: build the runtime with `silk task build --release`, or pass --runtime / set SILKJS_RUNTIME")
    }
  }
  let mut bun = Bytes.make()
  if hasBun(&columns) {
    let named = run Kit.variable(b"BUN")
    bun = run Kit.locate(if Bytes.length(&named) > 0 { Bytes.asSlice(&named) } else { b"bun" }, root)
    if Bytes.length(&bun) == 0 { run Kit.abort(b"bun is missing: install Bun (https://bun.sh) or set BUN", b"") }
    // Bun must start without --smol once BUN_OPTIONS is dropped.
    let seen = run Kit.firstLine(&[Bytes.asSlice(&bun), b"-e", b"console.log(JSON.stringify(process.execArgv))"], Bytes.asSlice(&work))
    if Kit.contains(Bytes.asSlice(&seen), b"smol") || Bytes.length(&seen) == 0 {
      run Kit.abort(b"bun still starts with --smol after BUN_OPTIONS was dropped (check bunfig.toml), or does not start: ", Bytes.asSlice(&seen))
    }
  }
  let out = if Bytes.length(&asked.out) > 0 {
    run Kit.absolute(root, Bytes.asSlice(&asked.out))
  } else {
    let stamp = run Kit.firstLine(&[b"date", b"-u", b"+%Y%m%d-%H%M%S"], Bytes.asSlice(&work))
    run Kit.cat3(Bytes.asSlice(&work), b"/results/", Bytes.asSlice(&stamp))
  }
  run Kit.makeDirectories(Bytes.asSlice(&out))
  let bench = run Kit.cat(Bytes.asSlice(&work), b"/bunrepo/bench")
  return Places { root: run Bytes.copy(root), work: move work, out: move out, bench: move bench, runtime: move runtime, bun: move bun, columns: move columns }
}

effect fn announce(at: &Places, title: &[u8]) -> () ! HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator {
  run Kit.say2(b"== ", title)
  if Bytes.length(&at.runtime) > 0 { run Kit.note(b"silkjs", Bytes.asSlice(&at.runtime)) }
  if Bytes.length(&at.bun) > 0 { run Kit.note(b"bun", Bytes.asSlice(&at.bun)) }
  run Kit.note(b"runtimes", Bytes.asSlice(&(run Kit.join(&at.columns, b","))))
  run Kit.note(b"work", Bytes.asSlice(&at.work))
  run Kit.note(b"out", Bytes.asSlice(&at.out))
  run Kit.noteDropped()
}

// A job that runs `script` under the runtime column `column`. The harness's own scripts are in
// bench/scripts; the others are Bun's, named relative to the folder the job starts in.
effect fn runtimeJob(at: &Places, column: &[u8], script: &[u8], prefix: &[&[u8]]) -> Job
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut job = Job.make()
  let mut p: usize = 0
  while p < prefix.length {
    run Job.word(&mut job, prefix[p])
    p = p + 1
  }
  if Kit.same(column, b"silkjs") {
    run Job.word(&mut job, Bytes.asSlice(&at.runtime))
    run Job.set(&mut job, b"SILKJS_PREPARSE_THREADS", b"0")
  } else {
    run Job.word(&mut job, Bytes.asSlice(&at.bun))
    if !Kit.same(column, b"bun") { run Job.set(&mut job, b"BUN_JSC_useJIT", b"0") }
    // Only this column gets --smol, to show what baselines that inherited it measured.
    if Kit.same(column, b"bun_nojit_smol") { run Job.set(&mut job, b"BUN_OPTIONS", b"--smol") }
  }
  let own = run Kit.cat3(Bytes.asSlice(&at.root), b"/bench/scripts/", script)
  let absolute = script.length > 0 && script[0] == 47
  let size: i64 = if absolute { 0 - 1 } else { run Kit.fileSize(Bytes.asSlice(&own)) }
  if size >= 0 { run Job.word(&mut job, Bytes.asSlice(&own)) } else { run Job.word(&mut job, script) }
  run database(&mut job)
  return move job
}

// The Postgres the benchmark connects to: postgres:postgres on localhost, as bench-setup leaves it.
effect fn database(job: &mut Job) -> () ! OutOfMemoryError ? &mut Allocator {
  run Job.set(&mut job.*, b"PGUSER", b"postgres")
  run Job.set(&mut job.*, b"PGPASSWORD", b"postgres")
  run Job.set(&mut job.*, b"PGHOST", b"localhost")
  run Job.set(&mut job.*, b"PGDATABASE", b"postgres")
  run Job.set(&mut job.*, b"DATABASE_URL", b"postgres://postgres:postgres@localhost:5432/postgres")
}

// ---------------------------------------------------------------- one sample

/// One result of one benchmark under one runtime.
struct Sample {
  // The main value; with `failed` set it means nothing.
  value: f64,
  failed: bool,
  // Why it failed.
  error: Bytes,
  // Peak RSS of a server in MB, user and system CPU microseconds per request; negative means none.
  rssMb: f64,
  userUs: f64,
  systemUs: f64,
  // Further `"key": number` pairs for the JSON line, each starting with `, `.
  extra: Bytes,
}

effect fn failure(why: &[u8]) -> Sample ! OutOfMemoryError ? &mut Allocator {
  return Sample { value: 0.0, failed: true, error: run Bytes.copy(why), rssMb: 0.0 - 1.0, userUs: 0.0 - 1.0, systemUs: 0.0 - 1.0, extra: Bytes.make() }
}

fn measured(value: f64) -> Sample {
  return Sample { value: value, failed: false, error: Bytes.make(), rssMb: 0.0 - 1.0, userUs: 0.0 - 1.0, systemUs: 0.0 - 1.0, extra: Bytes.make() }
}

// User and system CPU seconds of the process `pid`, from /proc.
effect fn processCpu(pid: i32, user: &mut f64, system: &mut f64) -> () ! TaskError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut file = run Bytes.copy(b"/proc/")
  run Kit.appendInteger(&mut file, i32.toI64(pid))
  run Bytes.append(&mut file, b"/stat")
  let text = run Kit.readOrEmpty(Bytes.asSlice(&file))
  let line = Bytes.asSlice(&text)
  // The fields after the program name, which ends at the last `)`.
  let mut close: usize = 0
  let mut at: usize = 0
  while at < line.length {
    if line[at] == 41 { close = at }
    at = at + 1
  }
  let fields = run Kit.split(Kit.part(line, if close + 1 < line.length { close + 1 } else { line.length }, line.length), 32)
  let values = List<Bytes>.asSlice(&fields)
  if values.length > 12 {
    user.* = Kit.number(Bytes.asSlice(&values[11])) / 100.0
    system.* = Kit.number(Bytes.asSlice(&values[12])) / 100.0
  }
}

// The peak resident set size of the process `pid` in MB, from /proc.
effect fn peakRss(pid: i32) -> f64 ! TaskError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut file = run Bytes.copy(b"/proc/")
  run Kit.appendInteger(&mut file, i32.toI64(pid))
  run Bytes.append(&mut file, b"/status")
  let text = run Kit.readOrEmpty(Bytes.asSlice(&file))
  return match move Kit.numberAfter(Bytes.asSlice(&text), b"VmHWM:") {
    Option<f64>.Some { value } => value / 1024.0
    Option<f64>.None => 0.0 - 1.0
  }
}

// Waits until `url` answers: up to 100 tries, 0.1 s apart.
effect fn waitForUrl(url: &[u8]) -> bool
  ! TaskError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut tries: u32 = 0
  while tries < 100 {
    if run Kit.succeeds(&[b"curl", b"-skf", b"-o", b"/dev/null", b"--max-time", b"0.5", url], b"") { return true }
    Kit.sleep(100)
    tries = tries + 1
  }
  return false
}

// A server benchmark: the server on CPU 0, wrk on CPUs 2 and 3; 2 s of warm-up, then 5 s measured.
effect fn http(at: &Places, column: &[u8], script: &[u8], url: &[u8], port: &[u8], directory: &[u8]) -> Sample
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut server = run runtimeJob(at, column, script, &[b"taskset", b"-c", b"0"])
  run Job.set(&mut server, b"PORT", port)
  run Job.within(&mut server, directory)
  let running = run Kit.start(&server)
  if !run waitForUrl(url) {
    let _stopped = Kit.stop(&running)
    return run failure(b"no response")
  }
  let _warm = run Kit.succeeds(&[b"taskset", b"-c", b"2,3", b"wrk", b"-t2", b"-c50", b"-d2s", url], b"")
  let mut user0: f64 = 0.0
  let mut system0: f64 = 0.0
  run processCpu(running.pid, &mut user0, &mut system0)
  let mut load = Job.make()
  let words: [&[u8]; 10] = [b"taskset", b"-c", b"2,3", b"wrk", b"-t2", b"-c50", b"-d5s", b"-H", b"Accept-Encoding: identity", url]
  let mut w: usize = 0
  while w < words.length {
    run Job.word(&mut load, words[w])
    w = w + 1
  }
  let captured = run Kit.capture(&mut load, Bytes.asSlice(&at.work))
  let mut user1: f64 = 0.0
  let mut system1: f64 = 0.0
  run processCpu(running.pid, &mut user1, &mut system1)
  let rss = run peakRss(running.pid)
  let _stopped = Kit.stop(&running)
  let text = Bytes.asSlice(&captured.text)
  let mut sample = measured(match move Kit.numberAfter(text, b"Requests/sec:") {
    Option<f64>.Some { value } => value
    Option<f64>.None => 0.0
  })
  sample.rssMb = rss
  let requests = match move Kit.numberBefore(text, b" requests in") {
    Option<f64>.Some { value } => value
    Option<f64>.None => 0.0
  }
  if requests > 0.0 {
    sample.userUs = (user1 - user0) * 1000000.0 / requests
    sample.systemUs = (system1 - system0) * 1000000.0 / requests
  }
  if let Option<f64>.Some { value } = move Kit.numberAfter(text, b"Non-2xx or 3xx responses:") {
    run Bytes.append(&mut sample.extra, b", \"non2xx\": ")
    run Kit.appendFixed(&mut sample.extra, value, 0)
  }
  return move sample
}

// The WebSocket chat: the server on CPU 0, Bun's chat client on CPUs 2 and 3. The value is the
// median of the client's rounds, in messages per second.
effect fn chat(at: &Places, column: &[u8], script: &[u8]) -> Sample
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let folder = run under(&at.bench, b"/websocket-server")
  let mut server = run runtimeJob(at, column, script, &[b"taskset", b"-c", b"0"])
  run Job.set(&mut server, b"PORT", b"4001")
  run Job.within(&mut server, Bytes.asSlice(&folder))
  let running = run Kit.start(&server)
  Kit.sleep(1500)
  let mut client = Job.make()
  let words: [&[u8]; 7] = [b"timeout", b"30", b"taskset", b"-c", b"2,3", Bytes.asSlice(&at.bun), b"chat-client.mjs"]
  let mut w: usize = 0
  while w < words.length {
    run Job.word(&mut client, words[w])
    w = w + 1
  }
  run Job.set(&mut client, b"PORT", b"4001")
  run database(&mut client)
  run Job.within(&mut client, Bytes.asSlice(&folder))
  let captured = run Kit.capture(&mut client, Bytes.asSlice(&at.work))
  let rss = run peakRss(running.pid)
  let _stopped = Kit.stop(&running)
  let text = Bytes.asSlice(&captured.text)
  let mut rates = List<f64>.make()
  let mut from: usize = 0
  while from < text.length {
    let found = Kit.find(text, b" messages per second", from)
    if found == text.length { break }
    let start = Kit.numberStartBefore(text, found)
    if start < found { run List<f64>.append(&mut rates, Kit.number(Kit.part(text, start, Kit.numberEnd(text, start)))) }
    from = found + 1
  }
  if List<f64>.length(&rates) == 0 {
    let mut none = run failure(b"no rounds")
    none.rssMb = rss
    return move none
  }
  let ordered = run Kit.sorted(List<f64>.asSlice(&rates))
  let values = List<f64>.asSlice(&ordered)
  let mut sample = measured(values[values.length / 2])
  sample.rssMb = rss
  run Bytes.append(&mut sample.extra, b", \"max\": ")
  run Kit.appendFixed(&mut sample.extra, values[values.length - 1], 1)
  run Bytes.append(&mut sample.extra, b", \"n\": ")
  run Kit.appendInteger(&mut sample.extra, usize.toI64(values.length))
  return move sample
}

// Runs a script to its end under `timeout`, with its output collected; `text` gets the output.
effect fn timed(at: &Places, column: &[u8], script: &[u8], directory: &[u8], limit: &[u8], argument: &[u8], discard: bool, text: &mut Bytes) -> Ended
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut job = run runtimeJob(at, column, script, &[b"timeout", limit])
  if argument.length > 0 { run Job.word(&mut job, argument) }
  run Job.within(&mut job, directory)
  if discard {
    // The benchmark writes a gigabyte to standard output: /dev/null, as `cat file > /dev/null`.
    job.errors = Stream.shared()
    return run Kit.runJob(&job)
  }
  let captured = run Kit.capture(&mut job, Bytes.asSlice(&at.work))
  let Captured { ended, text: output } = move captured
  text.* = move output
  return move ended
}

effect fn failedRun(ended: &Ended, text: &[u8]) -> Sample ! OutOfMemoryError ? &mut Allocator {
  if ended.status == 124 { return run failure(b"timeout") }
  let mut why = run Bytes.copy(b"exit ")
  run Kit.appendInteger(&mut why, i32.toI64(ended.status))
  run Bytes.append(&mut why, b": ")
  run Bytes.append(&mut why, Kit.part(text, if text.length > 300 { text.length - 300 } else { 0 }, text.length))
  return run failure(Bytes.asSlice(&why))
}

fn wordByte(value: u8) -> bool {
  return (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95
}

// The time Bun's Postgres benchmark printed, in milliseconds: `M:SS.mmm (m:ss.mmm)`, or else the
// last `N ms` or `N s` of the output. Negative when there is none.
fn postgresTime(text: &[u8]) -> f64 {
  let marker = Kit.find(text, b" (m:ss", 0)
  if marker < text.length {
    let secondsStart = Kit.numberStartBefore(text, marker)
    if secondsStart < marker && secondsStart > 1 && text[secondsStart - 1] == 58 {
      let minutesStart = Kit.numberStartBefore(text, secondsStart - 1)
      if minutesStart < secondsStart - 1 {
        return (Kit.number(Kit.part(text, minutesStart, secondsStart - 1)) * 60.0 + Kit.number(Kit.part(text, secondsStart, marker))) * 1000.0
      }
    }
  }
  let mut found: f64 = 0.0 - 1.0
  let mut at: usize = 0
  while at < text.length {
    let end = Kit.numberEnd(text, at)
    if end == at {
      at = at + 1
    } else {
      let mut unit = end
      while unit < text.length && (text[unit] == 32 || text[unit] == 9) { unit = unit + 1 }
      let value = Kit.number(Kit.part(text, at, end))
      if unit + 1 < text.length && text[unit] == 109 && text[unit + 1] == 115 && (unit + 2 == text.length || !wordByte(text[unit + 2])) {
        found = value
      } else if unit < text.length && text[unit] == 115 && (unit + 1 == text.length || !wordByte(text[unit + 1])) {
        found = value * 1000.0
      }
      at = end
    }
  }
  return found
}

// The id report tables use for a line of the SQLite benchmark; empty for the lines not reported.
fn sqliteId(name: &[u8]) -> &'static [u8] {
  if Kit.same(name, b"SELECT * FROM \"Order\"") { return b"sqlite_order" }
  if Kit.same(name, b"SELECT * FROM \"Product\"") { return b"sqlite_product" }
  if Kit.same(name, b"SELECT * FROM \"OrderDetail\"") { return b"sqlite_orderdetail" }
  if Kit.same(name, b"db.exec(sql): 1000 statements") { return b"sqlite_exec1000" }
  if Kit.same(name, b"db.exec(sql): 2000 statements") { return b"sqlite_exec2000" }
  if Kit.same(name, b"db.exec(sql): 4000 statements") { return b"sqlite_exec4000" }
  if Kit.same(name, b"db.exec(sql): 8000 statements") { return b"sqlite_exec8000" }
  return b""
}

// ---------------------------------------------------------------- the benchmark run

// One benchmark under one runtime.
struct Entry {
  group: Bytes,
  bench: Bytes,
  column: Bytes,
  // 0 http on port 3000, 1 Express over HTTPS, 2 WebSocket chat, 3 Postgres, 4 SQLite,
  // 5 microseconds per iteration, 6 wall time of cat, 7 setImmediate turns.
  kind: u8,
  script: Bytes,
}

effect fn entry(entries: &mut List<Entry>, group: &[u8], bench: &[u8], column: &[u8], kind: u8, script: &[u8]) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run List<Entry>.append(&mut entries.*, Entry {
    group: run Bytes.copy(group), bench: run Bytes.copy(bench), column: run Bytes.copy(column), kind: kind, script: run Bytes.copy(script),
  })
}

// Every benchmark and runtime pair, Bun-only APIs under the Bun columns only.
effect fn entriesFor(at: &Places) -> List<Entry> ! OutOfMemoryError ? &mut Allocator {
  let mut entries = List<Entry>.make()
  let columns = List<Bytes>.asSlice(&at.columns)
  let mut c: usize = 0
  while c < columns.length {
    let column = Bytes.asSlice(&columns[c])
    let bun = Kit.startsWith(column, b"bun")
    run entry(&mut entries, b"http", b"serve", column, 0, if bun { b"bun-serve.js" } else { b"silk-serve.js" })
    run entry(&mut entries, b"http", b"node_http", column, 0, b"node-http.cjs")
    run entry(&mut entries, b"http", b"express_https", column, 1, b"express-tls.mjs")
    if bun { run entry(&mut entries, b"ws", b"ws_bun_publish", column, 2, b"chat-server.bun.js") }
    run entry(&mut entries, b"ws", b"ws_api", column, 2, b"chat-server.node.mjs")
    run entry(&mut entries, b"pg", b"postgres", column, 3, b"index.mjs")
    run entry(&mut entries, b"sqlite", b"sqlite", column, 4, b"q.mjs")
    run entry(&mut entries, b"spawn", b"spawnSync_node_api", column, 5, b"spawn.mjs")
    if bun { run entry(&mut entries, b"spawn", b"spawnSync_bun", column, 5, b"spawn.bun.mjs") }
    run entry(&mut entries, b"cat", b"cat_streams", column, 6, b"cat.cjs")
    if bun { run entry(&mut entries, b"cat", b"cat_bun_write", column, 6, b"bun.js") }
    run entry(&mut entries, b"imm", b"setImmediate", column, 7, b"imm.js")
    c = c + 1
  }
  return move entries
}

// The samples of a run, for the report.
struct Results {
  values: Table,
  rss: Table,
  user: Table,
  system: Table,
  // One `bench runtime: why` line per failed sample.
  errors: Bytes,
  // The JSON object of each sample.
  lines: List<Bytes>,
}

effect fn perform(at: &Places, item: &Entry, results: &mut Results) -> Sample
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let column = Bytes.asSlice(&item.column)
  let script = Bytes.asSlice(&item.script)
  let work = Bytes.asSlice(&at.work)
  if item.kind == 0 { return run http(at, column, script, b"http://localhost:3000/", b"3000", work) }
  if item.kind == 1 { return run http(at, column, script, b"https://localhost:3443/", b"3443", Bytes.asSlice(&(run under(&at.bench, b"/express")))) }
  if item.kind == 2 { return run chat(at, column, script) }
  let mut text = Bytes.make()
  if item.kind == 3 {
    let ended = run timed(at, column, script, Bytes.asSlice(&(run under(&at.bench, b"/postgres"))), b"150", b"", false, &mut text)
    let time = postgresTime(Bytes.asSlice(&text))
    if time < 0.0 { return run failedRun(&ended, Bytes.asSlice(&text)) }
    let mut sample = measured(time)
    run Bytes.append(&mut sample.extra, b", \"queries\": 100000")
    return move sample
  }
  if item.kind == 4 {
    let ended = run timed(at, column, script, Bytes.asSlice(&(run under(&at.bench, b"/sqlite"))), b"300", b"", false, &mut text)
    let output = Bytes.asSlice(&text)
    let mut sample = measured(0.0)
    let mut found: usize = 0
    let mut start: usize = 0
    while start < output.length {
      let end = Kit.find(output, b"\n", start)
      let line = Kit.part(output, start, end)
      let tab = Kit.find(line, b"\t", 0)
      let id = sqliteId(Kit.part(line, 0, tab))
      if tab < line.length && id.length > 0 {
        let value = Kit.number(Kit.part(line, tab + 1, Kit.numberEnd(line, tab + 1)))
        run Table.add(&mut results.values, id, column, value)
        run Bytes.append(&mut sample.extra, b", \"")
        run Bytes.append(&mut sample.extra, id)
        run Bytes.append(&mut sample.extra, b"\": ")
        run Kit.appendFixed(&mut sample.extra, value, 3)
        found = found + 1
      }
      start = end + 1
    }
    if found == 0 { return run failedRun(&ended, output) }
    return move sample
  }
  if item.kind == 6 {
    let big = run under(&at.work, b"/1g.bin")
    let program = if Kit.same(script, b"bun.js") { run under(&at.bench, b"/cat/bun.js") } else { run Bytes.copy(script) }
    let ended = run timed(at, column, Bytes.asSlice(&program), work, b"120", Bytes.asSlice(&big), true, &mut text)
    if !ended.ok { return run failedRun(&ended, b"") }
    return measured(ended.wallMs)
  }
  let ended = run timed(at, column, script, work, b"180", b"", false, &mut text)
  let found = if item.kind == 5 { Kit.numberBefore(Bytes.asSlice(&text), b" us/iter") } else { Kit.numberBefore(Bytes.asSlice(&text), b" turns/s") }
  return match move found {
    Option<f64>.Some { value } => measured(value)
    Option<f64>.None => run failedRun(&ended, Bytes.asSlice(&text))
  }
}

// `text` with what a JSON string cannot hold replaced.
effect fn plain(text: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut clean = Bytes.make()
  let mut at: usize = 0
  while at < text.length {
    let value = [if text[at] == 34 { 39 } else if text[at] == 92 || text[at] < 32 { 32 } else { text[at] }]
    run Bytes.append(&mut clean, &value)
    at = at + 1
  }
  return move clean
}

effect fn record(item: &Entry, round: u32, when: i64, sample: &Sample, results: &mut Results) -> ()
  ! OutOfMemoryError | WriterError ? &mut Allocator {
  let bench = Bytes.asSlice(&item.bench)
  let column = Bytes.asSlice(&item.column)
  let mut line = run Bytes.copy(b"{\"bench\": \"")
  run Bytes.append(&mut line, bench)
  run Bytes.append(&mut line, b"\", \"runtime\": \"")
  run Bytes.append(&mut line, column)
  run Bytes.append(&mut line, b"\", \"round\": ")
  run Kit.appendInteger(&mut line, u32.toI64(round))
  run Bytes.append(&mut line, b", \"at\": ")
  run Kit.appendInteger(&mut line, when)
  if sample.failed {
    let why = run plain(Bytes.asSlice(&sample.error))
    run Bytes.append(&mut line, b", \"error\": \"")
    run Bytes.append(&mut line, Bytes.asSlice(&why))
    run Bytes.append(&mut line, b"\"")
    run Bytes.append(&mut results.errors, b"ERR ")
    run Bytes.append(&mut results.errors, bench)
    run Bytes.append(&mut results.errors, b" ")
    run Bytes.append(&mut results.errors, column)
    run Bytes.append(&mut results.errors, b": ")
    run Bytes.append(&mut results.errors, Bytes.asSlice(&why))
    run Bytes.append(&mut results.errors, b"\n")
  } else if item.kind != 4 {
    run Bytes.append(&mut line, b", \"value\": ")
    run Kit.appendFixed(&mut line, sample.value, 3)
    run Table.add(&mut results.values, bench, column, sample.value)
  }
  if sample.rssMb >= 0.0 {
    run Bytes.append(&mut line, b", \"rss_mb\": ")
    run Kit.appendFixed(&mut line, sample.rssMb, 2)
    if !sample.failed { run Table.add(&mut results.rss, bench, column, sample.rssMb) }
  }
  if sample.userUs >= 0.0 {
    run Bytes.append(&mut line, b", \"user_us\": ")
    run Kit.appendFixed(&mut line, sample.userUs, 3)
    run Bytes.append(&mut line, b", \"sys_us\": ")
    run Kit.appendFixed(&mut line, sample.systemUs, 3)
    run Table.add(&mut results.user, bench, column, sample.userUs)
    run Table.add(&mut results.system, bench, column, sample.systemUs)
  }
  run Bytes.append(&mut line, Bytes.asSlice(&sample.extra))
  run Bytes.append(&mut line, b"}")
  run Kit.say(Bytes.asSlice(&line))
  run List<Bytes>.append(&mut results.lines, move line)
}

// id|label|section|unit|better|silkjs on 2026-11-11 (the start of the Bun comparison)
const META: &[u8] = b"serve|HTTP hello, native serve (Bun.serve / silk:serve)|HTTP|req/s|higher|\nnode_http|HTTP hello, node:http|HTTP|req/s|higher|2350\nexpress_https|Express hello over HTTPS|HTTP|req/s|higher|950\nws_bun_publish|WebSocket chat, Bun publish API|WebSocket|msg/s|higher|\nws_api|WebSocket chat, ws package API|WebSocket|msg/s|higher|0\npostgres|Postgres, 100k x SELECT 100 rows|Database|ms|lower|\nsqlite_order|SQLite SELECT * FROM \"Order\" (16,818 rows)|Database|ms|lower|218.9\nsqlite_product|SQLite SELECT * FROM \"Product\" (77 rows)|Database|ms|lower|0.671\nsqlite_orderdetail|SQLite SELECT * FROM \"OrderDetail\" (621,883 rows)|Database|ms|lower|18931\nsqlite_exec8000|SQLite db.exec, 8000 statements|Database|ms|lower|5.7\nspawnSync_node_api|spawnSync(\"echo\", [\"hi\"]), node API|Process and I/O|us|lower|3211\nspawnSync_bun|Bun.spawnSync echo hi|Process and I/O|us|lower|\ncat_streams|cat 1 GB file to /dev/null, fs streams|Process and I/O|ms|lower|7175\ncat_bun_write|cat 1 GB file to /dev/null, Bun.write|Process and I/O|ms|lower|\nsetImmediate|setImmediate turns per second|Process and I/O|turns/s|higher|24000"

// A CSV field: quoted when it holds a comma or a quote.
effect fn csv(line: &mut Bytes, field: &[u8], last: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if Kit.contains(field, b",") || Kit.contains(field, b"\"") {
    run Bytes.append(&mut line.*, b"\"")
    let mut at: usize = 0
    while at < field.length {
      if field[at] == 34 { run Bytes.append(&mut line.*, b"\"") }
      run Bytes.append(&mut line.*, Kit.part(field, at, at + 1))
      at = at + 1
    }
    run Bytes.append(&mut line.*, b"\"")
  } else {
    run Bytes.append(&mut line.*, field)
  }
  run Bytes.append(&mut line.*, if last { b"\n" } else { b"," })
}

effect fn medianOf(table: &Table, row: &[u8], column: &[u8], decimals: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let found = run Table.values(table, row, column)
  if List<f64>.length(&found) == 0 { return Bytes.make() }
  return run Kit.fixed(run Kit.median(List<f64>.asSlice(&found)), decimals)
}

// Writes results.csv (one row per benchmark and runtime: median, min and max of the rounds, the
// server's CPU per request and peak RSS) and prints the medians.
effect fn report(at: &Places, results: &Results) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut table = run Bytes.copy(b"order,benchmark,label,section,unit,better,runtime,median,min,max,samples,user_us,sys_us,rss_mb,silkjs_2026_11_11\n")
  let mut summary = Bytes.make()
  let metas = run Kit.split(META, 10)
  let lines = List<Bytes>.asSlice(&metas)
  let runtimes = run Kit.split(b"silkjs,bun_nojit,bun_nojit_smol", 44)
  let names = List<Bytes>.asSlice(&runtimes)
  let mut order: usize = 0
  while order < lines.length {
    let meta = Bytes.asSlice(&lines[order])
    let mut fields = List<Bytes>.make()
    let mut start: usize = 0
    while start <= meta.length {
      let end = Kit.find(meta, b"|", start)
      run List<Bytes>.append(&mut fields, run Bytes.copy(Kit.part(meta, start, end)))
      start = end + 1
    }
    let field = List<Bytes>.asSlice(&fields)
    let id = Bytes.asSlice(&field[0])
    let mut shown = run Bytes.copy(id)
    let mut n: usize = 0
    while n < names.length {
      let name = Bytes.asSlice(&names[n])
      let found = run Table.values(&results.values, id, name)
      let values = List<f64>.asSlice(&found)
      if values.length > 0 {
        let median = run Kit.fixed(run Kit.median(values), 3)
        run csv(&mut table, Bytes.asSlice(&(run Kit.integer(usize.toI64(order)))), false)
        run csv(&mut table, id, false)
        run csv(&mut table, Bytes.asSlice(&field[1]), false)
        run csv(&mut table, Bytes.asSlice(&field[2]), false)
        run csv(&mut table, Bytes.asSlice(&field[3]), false)
        run csv(&mut table, Bytes.asSlice(&field[4]), false)
        run csv(&mut table, name, false)
        run csv(&mut table, Bytes.asSlice(&median), false)
        run csv(&mut table, Bytes.asSlice(&(run Kit.fixed(Kit.least(values), 3))), false)
        run csv(&mut table, Bytes.asSlice(&(run Kit.fixed(Kit.most(values), 3))), false)
        run csv(&mut table, Bytes.asSlice(&(run Kit.integer(usize.toI64(values.length)))), false)
        run csv(&mut table, Bytes.asSlice(&(run medianOf(&results.user, id, name, 2))), false)
        run csv(&mut table, Bytes.asSlice(&(run medianOf(&results.system, id, name, 2))), false)
        run csv(&mut table, Bytes.asSlice(&(run medianOf(&results.rss, id, name, 2))), false)
        run csv(&mut table, if Kit.same(name, b"silkjs") { Bytes.asSlice(&field[5]) } else { b"" }, true)
        run Bytes.append(&mut shown, b" ")
        run Bytes.append(&mut shown, name)
        run Bytes.append(&mut shown, b"=")
        run Bytes.append(&mut shown, Bytes.asSlice(&median))
        run Bytes.append(&mut shown, b"(")
        run Kit.appendInteger(&mut shown, usize.toI64(values.length))
        run Bytes.append(&mut shown, b")")
      }
      n = n + 1
    }
    run Bytes.append(&mut summary, Bytes.asSlice(&shown))
    run Bytes.append(&mut summary, b"\n")
    order = order + 1
  }
  run Bytes.append(&mut summary, Bytes.asSlice(&results.errors))
  run Kit.print(Bytes.asSlice(&summary))
  run Kit.write(Bytes.asSlice(&(run under(&at.out, b"/results.csv"))), Bytes.asSlice(&table))
  run Kit.write(Bytes.asSlice(&(run under(&at.out, b"/report.txt"))), Bytes.asSlice(&summary))
  run Kit.say2(b"medians: ", Bytes.asSlice(&(run under(&at.out, b"/results.csv"))))
}

effect fn writeLines(file: &[u8], lines: &List<Bytes>) -> ()
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut text = run Bytes.copy(b"[\n")
  run Bytes.append(&mut text, Bytes.asSlice(&(run Kit.join(lines, b",\n"))))
  run Bytes.append(&mut text, b"\n]\n")
  run Kit.write(file, Bytes.asSlice(&text))
}

// Fails the task unless what `bench-setup` makes is there for the chosen groups.
effect fn requireSetup(at: &Places, groups: &List<Bytes>) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut missing = Bytes.make()
  let http = Kit.wanted(groups, b"http") || Kit.listed(groups, b"serve") || Kit.listed(groups, b"node_http") || Kit.listed(groups, b"express_https")
  let ws = Kit.wanted(groups, b"ws") || Kit.listed(groups, b"ws_api") || Kit.listed(groups, b"ws_bun_publish")
  if http {
    let wrk = run Kit.locate(b"wrk", Bytes.asSlice(&at.work))
    if Bytes.length(&wrk) == 0 { run Bytes.append(&mut missing, b" wrk") }
    if !run Kit.exists(Bytes.asSlice(&(run under(&at.bench, b"/express/cert.pem")))) { run Bytes.append(&mut missing, b" cert") }
  }
  if http || ws { run Kit.requirePinning() }
  if http || ws || Kit.wanted(groups, b"pg") || Kit.listed(groups, b"postgres") {
    if !run Kit.exists(Bytes.asSlice(&(run under(&at.bench, b"/express/node_modules")))) { run Bytes.append(&mut missing, b" bunrepo install") }
  }
  if Kit.wanted(groups, b"pg") || Kit.listed(groups, b"postgres") {
    if !run Kit.succeeds(&[b"pg_isready", b"-q", b"-h", b"localhost"], b"") { run Bytes.append(&mut missing, b" postgres") }
  }
  if Kit.wanted(groups, b"sqlite") {
    if !run Kit.exists(Bytes.asSlice(&(run under(&at.bench, b"/sqlite/src/northwind.sqlite")))) { run Bytes.append(&mut missing, b" northwind") }
  }
  if Kit.wanted(groups, b"cat") || Kit.listed(groups, b"cat_streams") || Kit.listed(groups, b"cat_bun_write") {
    if !run Kit.exists(Bytes.asSlice(&(run under(&at.work, b"/1g.bin")))) { run Bytes.append(&mut missing, b" bigfile") }
  }
  if Bytes.length(&missing) > 0 {
    run Kit.abort(b"the work directory is not set up. Run: silk task bench-setup", Bytes.asSlice(&missing))
  }
}

effect fn benchAt(asked: &Asked, at: &Places, groups: &List<Bytes>) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let rounds: u32 = if asked.rounds == 0 { 6 } else { asked.rounds }
  run Kit.checkRounds(rounds, 3)
  run requireSetup(at, groups)
  run announce(at, b"runtime benchmarks: servers on CPU 0, wrk and clients on CPUs 2,3")
  run Kit.refuseWhileBuilding(asked.force)
  let all = run entriesFor(at)
  let entries = List<Entry>.asSlice(&all)
  let mut chosen = List<usize>.make()
  let mut e: usize = 0
  while e < entries.length {
    if Kit.wanted(groups, Bytes.asSlice(&entries[e].group)) || Kit.listed(groups, Bytes.asSlice(&entries[e].bench)) {
      run List<usize>.append(&mut chosen, e)
    }
    e = e + 1
  }
  let picked = List<usize>.asSlice(&chosen)
  if picked.length == 0 { run Kit.abort(b"no benchmark matches; the groups are http ws pg sqlite spawn cat imm", b"") }
  let mut results = Results { values: Table.make(), rss: Table.make(), user: Table.make(), system: Table.make(), errors: Bytes.make(), lines: List<Bytes>.make() }
  let mut shuffler = Shuffler.make()
  let samples = run under(&at.out, b"/res.json")
  let mut round: u32 = 0
  while round < rounds {
    let order = run Shuffler.order(&mut shuffler, picked.length)
    let turns = List<usize>.asSlice(&order)
    let mut t: usize = 0
    while t < turns.length {
      let item = &entries[picked[turns[t]]]
      let when = Kit.wallClock()
      let sample = run perform(at, item, &mut results)
      run record(item, round, when, &sample, &mut results)
      run writeLines(Bytes.asSlice(&samples), &results.lines)
      t = t + 1
    }
    round = round + 1
  }
  run report(at, &results)
  run Kit.say2(b"samples: ", Bytes.asSlice(&samples))
}

/// The benchmarks, `rounds` interleaved rounds (default 6); writes `res.json`, `results.csv` and
/// `report.txt`. `asked.names` selects groups (http ws pg sqlite spawn cat imm) or benchmarks.
pub effect fn bench(asked: &Asked) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let at = run places(asked, false)
  run benchAt(asked, &at, &asked.names)
}

// ---------------------------------------------------------------- peak memory

effect fn memAt(asked: &Asked, at: &Places, rounds: u32) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  run Kit.checkRounds(rounds, 3)
  let needed = run Kit.split(b"pg,sqlite,cat", 44)
  run requireSetup(at, &needed)
  run announce(at, b"peak RSS of the non-server benchmarks")
  run Kit.refuseWhileBuilding(asked.force)
  let cases: [&[u8]; 5] = [b"postgres", b"sqlite", b"cat_streams", b"spawnSync_node_api", b"setImmediate"]
  let scripts: [&[u8]; 5] = [b"index.mjs", b"q.mjs", b"cat.cjs", b"spawn.mjs", b"imm.js"]
  let columns = List<Bytes>.asSlice(&at.columns)
  let big = run under(&at.work, b"/1g.bin")
  let mut lines = List<Bytes>.make()
  let mut shuffler = Shuffler.make()
  let mut round: u32 = 0
  while round < rounds {
    let order = run Shuffler.order(&mut shuffler, cases.length * columns.length)
    let turns = List<usize>.asSlice(&order)
    let mut t: usize = 0
    while t < turns.length {
      let which = turns[t] / columns.length
      let column = Bytes.asSlice(&columns[turns[t] % columns.length])
      let mut job = run runtimeJob(at, column, scripts[which], &[])
      if which == 2 { run Job.word(&mut job, Bytes.asSlice(&big)) }
      let folder = if which == 0 { run under(&at.bench, b"/postgres") } else if which == 1 { run under(&at.bench, b"/sqlite") } else { run Bytes.copy(Bytes.asSlice(&at.work)) }
      run Job.within(&mut job, Bytes.asSlice(&folder))
      let ended = run Kit.runJob(&job)
      let mut line = run Bytes.copy(b"{\"bench\": \"")
      run Bytes.append(&mut line, cases[which])
      run Bytes.append(&mut line, b"\", \"runtime\": \"")
      run Bytes.append(&mut line, column)
      run Bytes.append(&mut line, b"\", \"round\": ")
      run Kit.appendInteger(&mut line, u32.toI64(round))
      run Bytes.append(&mut line, b", \"rss_mb\": ")
      run Kit.appendFixed(&mut line, ended.rssMb, 2)
      run Bytes.append(&mut line, if ended.ok { b", \"ok\": true}" } else { b", \"ok\": false}" })
      run Kit.say(Bytes.asSlice(&line))
      run List<Bytes>.append(&mut lines, move line)
      t = t + 1
    }
    round = round + 1
  }
  let file = run under(&at.out, b"/mem.json")
  run writeLines(Bytes.asSlice(&file), &lines)
  run Kit.say2(b"samples: ", Bytes.asSlice(&file))
}

/// Peak RSS of the non-server benchmarks, `rounds` interleaved rounds (default 3); writes `mem.json`.
pub effect fn mem(asked: &Asked) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let at = run places(asked, false)
  run memAt(asked, &at, if asked.rounds == 0 { 3 } else { asked.rounds })
}

// ---------------------------------------------------------------- cold start

effect fn coldAt(asked: &Asked, at: &Places, runs: u32, only: &List<Bytes>) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  run Kit.checkRounds(runs, 10)
  run announce(at, b"cold start: wall time, CPU time, peak RSS and page faults per process start")
  run Kit.refuseWhileBuilding(asked.force)
  let folder = run under(&at.root, b"/bench/coldstart/cases")
  let found = run Kit.entries(Bytes.asSlice(&folder))
  let files = List<Bytes>.asSlice(&found)
  let columns = List<Bytes>.asSlice(&at.columns)
  let metrics: [&[u8]; 4] = [b"wall ms (median)", b"user+sys ms", b"peak RSS MB", b"page faults"]
  let mut tables = [Table.make(), Table.make(), Table.make(), Table.make()]
  let mut json = run Bytes.copy(b"{")
  let mut cases: usize = 0
  let mut f: usize = 0
  while f < files.length {
    let file = Bytes.asSlice(&files[f])
    let isCase = Kit.endsWith(file, b".js") || Kit.endsWith(file, b".mjs") || Kit.endsWith(file, b".cjs")
    let label = Kit.part(file, 0, Kit.find(file, b".", 0))
    if isCase && Kit.wanted(only, label) {
      let mut wall = Table.make()
      let mut cpu = Table.make()
      let mut rss = Table.make()
      let mut faults = Table.make()
      let mut failed = List<Bytes>.make()
      // One warm-up run per runtime pulls the binary into the page cache; then interleaved runs.
      let mut turn: u32 = 0
      while turn <= runs {
        let mut c: usize = 0
        while c < columns.length {
          let column = Bytes.asSlice(&columns[c])
          // Through /usr/bin/env, as every recorded table was measured.
          let mut job = Job.make()
          run Job.word(&mut job, b"/usr/bin/env")
          if Kit.same(column, b"silkjs") {
            run Job.word(&mut job, b"SILKJS_PREPARSE_THREADS=0")
            run Job.word(&mut job, Bytes.asSlice(&at.runtime))
          } else {
            if !Kit.same(column, b"bun") { run Job.word(&mut job, b"BUN_JSC_useJIT=0") }
            if Kit.same(column, b"bun_nojit_smol") { run Job.word(&mut job, b"BUN_OPTIONS=--smol") }
            run Job.word(&mut job, Bytes.asSlice(&at.bun))
          }
          run Job.word(&mut job, file)
          run Job.within(&mut job, Bytes.asSlice(&folder))
          let ended = run Kit.runJob(&job)
          if turn > 0 {
            run Table.add(&mut wall, label, column, ended.wallMs)
            run Table.add(&mut cpu, label, column, ended.userMs + ended.systemMs)
            run Table.add(&mut rss, label, column, ended.rssMb)
            run Table.add(&mut faults, label, column, i64.toF64(ended.faults))
            if !ended.ok && !Kit.listed(&failed, column) { run List<Bytes>.append(&mut failed, run Bytes.copy(column)) }
          }
          c = c + 1
        }
        turn = turn + 1
      }
      run Bytes.append(&mut json, if cases > 0 { b",\n \"" } else { b"\n \"" })
      run Bytes.append(&mut json, label)
      run Bytes.append(&mut json, b"\": {")
      let mut c: usize = 0
      while c < columns.length {
        let column = Bytes.asSlice(&columns[c])
        let walls = run Table.values(&wall, label, column)
        let cpus = run Table.values(&cpu, label, column)
        let sizes = run Table.values(&rss, label, column)
        let counts = run Table.values(&faults, label, column)
        let ok = !Kit.listed(&failed, column)
        let medians = [run Kit.median(List<f64>.asSlice(&walls)), run Kit.median(List<f64>.asSlice(&cpus)), run Kit.median(List<f64>.asSlice(&sizes)), f64.floor(run Kit.median(List<f64>.asSlice(&counts)))]
        run Bytes.append(&mut json, if c > 0 { b",\n  \"" } else { b"\n  \"" })
        run Bytes.append(&mut json, column)
        run Bytes.append(&mut json, if ok { b"\": {\"ok\": true, \"wall_ms\": " } else { b"\": {\"ok\": false, \"wall_ms\": " })
        run Kit.appendFixed(&mut json, medians[0], 2)
        run Bytes.append(&mut json, b", \"wall_min_ms\": ")
        run Kit.appendFixed(&mut json, Kit.least(List<f64>.asSlice(&walls)), 2)
        run Bytes.append(&mut json, b", \"cpu_ms\": ")
        run Kit.appendFixed(&mut json, medians[1], 2)
        run Bytes.append(&mut json, b", \"rss_mb\": ")
        run Kit.appendFixed(&mut json, medians[2], 1)
        run Bytes.append(&mut json, b", \"faults\": ")
        run Kit.appendFixed(&mut json, medians[3], 0)
        run Bytes.append(&mut json, b"}")
        let mut m: usize = 0
        while m < 4 {
          // A failed run is marked in the table: a negative value prints with `!`.
          run Table.add(&mut tables[m], label, column, if ok { medians[m] } else { 0.0 - medians[m] - 0.001 })
          m = m + 1
        }
        c = c + 1
      }
      run Bytes.append(&mut json, b"\n }")
      cases = cases + 1
    }
    f = f + 1
  }
  if cases == 0 { run Kit.abort(b"no cold start case matches; the cases are the files of bench/coldstart/cases", b"") }
  run Bytes.append(&mut json, b"\n}\n")
  let mut text = Bytes.make()
  let mut m: usize = 0
  while m < 4 {
    run Bytes.append(&mut text, b"\n")
    run Bytes.append(&mut text, metrics[m])
    run Bytes.append(&mut text, b"\n")
    run Kit.appendLeft(&mut text, b"case", 10)
    let mut c: usize = 0
    while c < columns.length {
      run Kit.appendPadded(&mut text, Bytes.asSlice(&columns[c]), 16)
      c = c + 1
    }
    run Bytes.append(&mut text, b"\n")
    let rows = run Table.rows(&tables[m])
    let labels = List<Bytes>.asSlice(&rows)
    let mut r: usize = 0
    while r < labels.length {
      run Kit.appendLeft(&mut text, Bytes.asSlice(&labels[r]), 10)
      c = 0
      while c < columns.length {
        let values = run Table.values(&tables[m], Bytes.asSlice(&labels[r]), Bytes.asSlice(&columns[c]))
        let value = List<f64>.asSlice(&values)[0]
        let mut cell = run Kit.fixed(f64.abs(value), if m == 3 { 0 } else { 1 })
        if value < 0.0 { run Bytes.append(&mut cell, b"!") }
        run Kit.appendPadded(&mut text, Bytes.asSlice(&cell), 16)
        c = c + 1
      }
      run Bytes.append(&mut text, b"\n")
      r = r + 1
    }
    m = m + 1
  }
  run Kit.print(Bytes.asSlice(&text))
  run Kit.write(Bytes.asSlice(&(run under(&at.out, b"/cold.json"))), Bytes.asSlice(&json))
  run Kit.write(Bytes.asSlice(&(run under(&at.out, b"/cold.txt"))), Bytes.asSlice(&text))
  run Kit.say2(b"table: ", Bytes.asSlice(&(run under(&at.out, b"/cold.txt"))))
}

/// Cold start of each case of `bench/coldstart/cases`, `rounds` runs per case (default 30),
/// interleaved; writes `cold.json` and `cold.txt`. `asked.names` selects cases.
pub effect fn cold(asked: &Asked) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let at = run places(asked, true)
  run coldAt(asked, &at, if asked.rounds == 0 { 30 } else { asked.rounds }, &asked.names)
}

/// The benchmarks, peak memory and cold start into one results directory.
pub effect fn all(asked: &Asked, memRounds: u32, coldRuns: u32) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let at = run places(asked, false)
  let every = List<Bytes>.make()
  run benchAt(asked, &at, &every)
  run memAt(asked, &at, if memRounds == 0 { 3 } else { memRounds })
  run coldAt(asked, &at, if coldRuns == 0 { 30 } else { coldRuns }, &every)
  run Kit.say2(b"all results: ", Bytes.asSlice(&at.out))
}

// ---------------------------------------------------------------- setup

/// Prepares the work directory. Steps: wrk postgres bunrepo install northwind cert bigfile;
/// `asked.names` selects some of them. Each step is skipped when its result is there.
pub effect fn setup(asked: &Asked) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  run Kit.checkNames(&asked.names, &[b"wrk", b"postgres", b"bunrepo", b"install", b"northwind", b"cert", b"bigfile"], b"setup step")
  let workBytes = run workOf(asked)
  let work = Bytes.asSlice(&workBytes)
  let repository = run Kit.cat(work, b"/bunrepo")
  let bench = run Kit.cat(work, b"/bunrepo/bench")
  if Kit.wanted(&asked.names, b"wrk") {
    run Kit.say(b"-- wrk")
    let found = run Kit.locate(b"wrk", work)
    if Bytes.length(&found) == 0 {
      let installed = run Kit.aptInstall(&[b"wrk"])
      if !installed { run Kit.abort(b"apt-get could not install wrk; install it (https://github.com/wg/wrk) and rerun", b"") }
    }
  }
  if Kit.wanted(&asked.names, b"postgres") {
    run Kit.say(b"-- postgres")
    let found = run Kit.locate(b"psql", work)
    if Bytes.length(&found) == 0 {
      let _installed = run Kit.aptInstall(&[b"postgresql"])
    }
    let ready = run Kit.succeeds(&[b"pg_isready", b"-q", b"-h", b"localhost"], b"")
    if !ready { run Kit.sh(&[b"service", b"postgresql", b"start"], b"") }
    // The benchmark connects as postgres:postgres on localhost.
    run Kit.sh(&[b"su", b"postgres", b"-c", b"psql -c \"ALTER USER postgres PASSWORD 'postgres';\""], b"")
  }
  if Kit.wanted(&asked.names, b"bunrepo") {
    run Kit.say(b"-- bunrepo")
    let cloned = run Kit.exists(Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&repository), b"/.git"))))
    if !cloned {
      run Kit.sh(&[b"git", b"clone", b"-q", b"--depth", b"1", b"--filter=blob:none", b"--sparse", b"https://github.com/oven-sh/bun", Bytes.asSlice(&repository)], b"")
    }
    run Kit.sh(&[b"git", b"-C", Bytes.asSlice(&repository), b"sparse-checkout", b"set", b"bench/express", b"bench/websocket-server", b"bench/postgres", b"bench/sqlite", b"bench/cat"], b"")
    let revision = run Kit.firstLine(&[b"git", b"-C", Bytes.asSlice(&repository), b"rev-parse", b"HEAD"], work)
    run Kit.note(b"oven-sh/bun", Bytes.asSlice(&revision))
  }
  if Kit.wanted(&asked.names, b"install") {
    run Kit.say(b"-- install")
    let named = run Kit.variable(b"BUN")
    let bun = run Kit.locate(if Bytes.length(&named) > 0 { Bytes.asSlice(&named) } else { b"bun" }, work)
    if Bytes.length(&bun) == 0 { run Kit.abort(b"bun is missing: install Bun (https://bun.sh) or set BUN", b"") }
    let folders: [&[u8]; 3] = [b"/express", b"/websocket-server", b"/postgres"]
    let mut f: usize = 0
    while f < folders.length {
      run Kit.sh(&[Bytes.asSlice(&bun), b"install"], Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&bench), folders[f]))))
      f = f + 1
    }
    // bench/sqlite needs no install: its only package, better-sqlite3, has no binary for Bun, and
    // the benchmark uses bun:sqlite and node:sqlite.
  }
  if Kit.wanted(&asked.names, b"northwind") {
    run Kit.say(b"-- northwind")
    let database = run Kit.cat(Bytes.asSlice(&bench), b"/sqlite/src/northwind.sqlite")
    let size = run Kit.fileSize(Bytes.asSlice(&database))
    if size < 1048576 {
      let downloads = run Kit.cat(work, b"/downloads")
      run Kit.makeDirectories(Bytes.asSlice(&downloads))
      let archive = run Kit.cat(Bytes.asSlice(&downloads), b"/northwind.zip")
      run Kit.download(b"https://raw.githubusercontent.com/jpwhite3/northwind-SQLite3/46d5f8a64f396f87cd374d1600dbf521523980e8/Northwind_large.sqlite.zip", Bytes.asSlice(&archive))
      run Kit.sh(&[b"unzip", b"-oq", Bytes.asSlice(&archive), b"-d", Bytes.asSlice(&downloads)], b"")
      run Kit.makeDirectories(Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&bench), b"/sqlite/src"))))
      run Kit.sh(&[b"mv", Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&downloads), b"/Northwind_large.sqlite"))), Bytes.asSlice(&database)], b"")
    }
  }
  if Kit.wanted(&asked.names, b"cert") {
    run Kit.say(b"-- cert")
    let express = run Kit.cat(Bytes.asSlice(&bench), b"/express")
    let valid = run Kit.succeeds(&[b"openssl", b"x509", b"-checkend", b"86400", b"-noout", b"-in", b"cert.pem"], Bytes.asSlice(&express))
    if !valid {
      let mut job = Job.make()
      let words: [&[u8]; 14] = [b"openssl", b"req", b"-x509", b"-newkey", b"rsa:2048", b"-nodes", b"-keyout", b"key.pem", b"-out", b"cert.pem", b"-days", b"30", b"-subj", b"/CN=localhost"]
      let mut w: usize = 0
      while w < words.length {
        run Job.word(&mut job, words[w])
        w = w + 1
      }
      run Job.within(&mut job, Bytes.asSlice(&express))
      run Kit.say(b"   $ openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 30 -subj /CN=localhost")
      run Kit.must(&job)
    }
  }
  if Kit.wanted(&asked.names, b"bigfile") {
    run Kit.say(b"-- bigfile")
    let big = run Kit.cat(work, b"/1g.bin")
    let size = run Kit.fileSize(Bytes.asSlice(&big))
    if size != 1073741824 {
      let mut job = Job.make()
      run Job.word(&mut job, b"head")
      run Job.word(&mut job, b"-c")
      run Job.word(&mut job, b"1073741824")
      run Job.word(&mut job, b"/dev/urandom")
      job.output = run Stream.toFile(Bytes.asSlice(&big))
      run Kit.say(b"   $ head -c 1073741824 /dev/urandom > 1g.bin")
      run Kit.must(&job)
    }
  }
  run Kit.say2(b"ready: ", work)
}

// ---------------------------------------------------------------- offline dependencies

// The newest file of `folder` whose name ends with `name`; fails the task when there is none.
effect fn archive(folder: &[u8], name: &[u8]) -> Bytes
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let found = run Kit.entries(folder)
  let files = List<Bytes>.asSlice(&found)
  let mut at = files.length
  while at > 0 {
    at = at - 1
    if Kit.endsWith(Bytes.asSlice(&files[at]), name) { return run Kit.cat3(folder, b"/", Bytes.asSlice(&files[at])) }
  }
  run Kit.abort(name, Bytes.asSlice(&(run Kit.cat(b" is missing from ", folder))))
}

// The text between `before` and `after` on the `url = ` line of the manifest at `manifest`.
effect fn pinned(manifest: &[u8], before: &[u8], after: &[u8]) -> Bytes
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let text = run Kit.readOrEmpty(manifest)
  let source = Bytes.asSlice(&text)
  let start = Kit.find(source, before, 0)
  if start == source.length { run Kit.abort(b"cannot find the pinned archive in ", manifest) }
  let from = start + before.length
  let end = Kit.find(source, after, from)
  return run Bytes.copy(Kit.part(source, from, end))
}

effect fn checkout(folder: &[u8], url: &[u8], revision: &[u8]) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  run Kit.makeDirectories(folder)
  let cloned = run Kit.exists(Bytes.asSlice(&(run Kit.cat(folder, b"/.git"))))
  if !cloned { run Kit.sh(&[b"git", b"init", b"-q", folder], b"") }
  run Kit.sh(&[b"git", b"-C", folder, b"fetch", b"-q", b"--depth", b"1", url, revision], b"")
  run Kit.sh(&[b"git", b"-C", folder, b"checkout", b"-q", b"FETCH_HEAD"], b"")
}

/// Unpacks prepared copies of what the build downloads, for a network that blocks
/// codeload.github.com and sqlite.org, and points Silk at them through
/// `native-overrides.toml` in the Silk home. `from` is the folder with the four archives.
pub effect fn offlineDeps(asked: &Asked, from: &[u8]) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  if from.length == 0 {
    run Kit.abort(b"say where the prepared archives are: --from DIR or SILKJS_OFFLINE_DEPS=DIR. It must hold runtime-native-prefix.tgz, runtime-sqlite-amalgamation.tgz, runtime-zstd-nghttp2-system.tgz and runtime-build-deps.tgz. ", b"On an open network this task is not needed: `silk task build` downloads everything.")
  }
  let root = Bytes.asSlice(&asked.root)
  let invoked = run Kit.variable(b"SILK_INVOCATION_DIRECTORY")
  let folderBytes = run Kit.absolute(if Bytes.length(&invoked) > 0 { Bytes.asSlice(&invoked) } else { root }, from)
  let folder = Bytes.asSlice(&folderBytes)
  let prefixArchive = run archive(folder, b"runtime-native-prefix.tgz")
  let sqliteArchive = run archive(folder, b"runtime-sqlite-amalgamation.tgz")
  let systemArchive = run archive(folder, b"runtime-zstd-nghttp2-system.tgz")
  let buildArchive = run archive(folder, b"runtime-build-deps.tgz")
  let workBytes = run workOf(asked)
  let local = run Kit.cat(Bytes.asSlice(&workBytes), b"/deps")
  let buildDeps = run Kit.cat(root, b"/build/deps")
  run Kit.makeDirectories(Bytes.asSlice(&local))
  run Kit.makeDirectories(Bytes.asSlice(&buildDeps))
  run Kit.sh(&[b"tar", b"xzf", Bytes.asSlice(&prefixArchive), b"-C", Bytes.asSlice(&local)], b"")
  run Kit.sh(&[b"tar", b"xzf", Bytes.asSlice(&sqliteArchive), b"-C", Bytes.asSlice(&local)], b"")
  run Kit.sh(&[b"tar", b"xzf", Bytes.asSlice(&buildArchive), b"-C", Bytes.asSlice(&buildDeps)], b"")
  // Static zstd, nghttp2 and Brotli where the linker looks. This one writes under /usr, as root.
  run Kit.sh(&[b"tar", b"xzf", Bytes.asSlice(&systemArchive), b"-C", b"/"], b"")
  let machine = run Kit.firstLine(&[b"uname", b"-m"], Bytes.asSlice(&workBytes))
  let multiarch = run Kit.cat3(b"/usr/lib/", Bytes.asSlice(&machine), b"-linux-gnu")
  let libraries = run Kit.entries(Bytes.asSlice(&multiarch))
  let names = List<Bytes>.asSlice(&libraries)
  let mut at: usize = 0
  while at < names.length {
    let name = Bytes.asSlice(&names[at])
    if Kit.endsWith(name, b".a") && (Kit.startsWith(name, b"libzstd") || Kit.startsWith(name, b"libnghttp2") || Kit.startsWith(name, b"libbrotli")) {
      run Kit.sh(&[b"ln", b"-sf", Bytes.asSlice(&(run Kit.cat3(Bytes.asSlice(&multiarch), b"/", name))), b"/usr/lib/"], b"")
    }
    at = at + 1
  }
  // Brotli at the revision its manifest pins, fetched with git (the runtime has no libuv to fetch).
  let brotli = run pinned(Bytes.asSlice(&(run Kit.cat(root, b"/../native/brotli/silk.toml"))), b"codeload.github.com/google/brotli/tar.gz/", b"\"")
  let brotliFolder = run Kit.cat(Bytes.asSlice(&local), b"/src/brotli")
  run checkout(Bytes.asSlice(&brotliFolder), b"https://github.com/google/brotli", Bytes.asSlice(&brotli))
  // The build's own archive cache holds simde as a tarball; an override wants the unpacked source.
  let simdeRevision = run pinned(Bytes.asSlice(&(run Kit.cat(root, b"/silk.toml"))), b"codeload.github.com/simd-everywhere/simde/tar.gz/", b"\"")
  let simde = run Kit.cat3(Bytes.asSlice(&buildDeps), b"/simde-", Bytes.asSlice(&simdeRevision))
  let simdeArchive = run Kit.cat(Bytes.asSlice(&simde), b".tar.gz")
  let packed = run Kit.fileSize(Bytes.asSlice(&simdeArchive))
  if packed < 0 { run Kit.abort(Bytes.asSlice(&simdeArchive), b" is not in runtime-build-deps.tgz: the manifest pins another simde revision than the archive holds") }
  let unpacked = run Kit.exists(Bytes.asSlice(&(run Kit.cat(Bytes.asSlice(&simde), b"/simde"))))
  if !unpacked {
    run Kit.makeDirectories(Bytes.asSlice(&simde))
    run Kit.sh(&[b"tar", b"xzf", Bytes.asSlice(&simdeArchive), b"-C", Bytes.asSlice(&simde), b"--strip-components", b"1"], b"")
  }
  let mut overrides = run Bytes.copy(b"[native.override.sqlite]\npath = \"")
  run Bytes.append(&mut overrides, Bytes.asSlice(&local))
  run Bytes.append(&mut overrides, b"/bsq/package/deps/sqlite3\"\n[native.override.silkjs-simde]\npath = \"")
  run Bytes.append(&mut overrides, Bytes.asSlice(&simde))
  run Bytes.append(&mut overrides, b"\"\n[native.override.silkjs-brotli]\npath = \"")
  run Bytes.append(&mut overrides, Bytes.asSlice(&brotliFolder))
  run Bytes.append(&mut overrides, b"\"\n")
  let silkHome = run Kit.variable(b"SILK_HOME")
  let home = run Kit.variable(b"HOME")
  let target = if Bytes.length(&silkHome) > 0 { run Kit.cat(Bytes.asSlice(&silkHome), b"/native-overrides.toml") } else { run Kit.cat(Bytes.asSlice(&home), b"/.silk/native-overrides.toml") }
  let previous = run Kit.readOrEmpty(Bytes.asSlice(&target))
  if Bytes.length(&previous) > 0 && !Kit.same(Bytes.asSlice(&previous), Bytes.asSlice(&overrides)) {
    let kept = run Kit.cat(Bytes.asSlice(&target), b".before-offline-deps")
    run Kit.write(Bytes.asSlice(&kept), Bytes.asSlice(&previous))
    run Kit.say2(b"kept the previous overrides as ", Bytes.asSlice(&kept))
  }
  run Kit.write(Bytes.asSlice(&target), Bytes.asSlice(&overrides))
  run Kit.say2(b"wrote ", Bytes.asSlice(&target))
  run Kit.print(Bytes.asSlice(&overrides))
  run Kit.say(b"Now build, and check that the log says \"Embedded ... bytes of built-in bytecode\" and \"Embedded a heap image\":")
  run Kit.say(Bytes.asSlice(&(run Kit.cat3(b"  PKG_CONFIG_PATH=", Bytes.asSlice(&local), b"/prefix/lib/pkgconfig silk task build --release"))))
}
