//! Whether text cut right after a glyph, a space, shapes on either side as it does in the
//! whole: which of a plan's lookups can match across the glyph, and which glyphs they take as
//! input, so that a cut far enough from those can be trusted.
//!
//! Text shaped as a whole tells where it may be cut (`GlyphInfo.unsafeToBreak`). Text that
//! grows at its end does not: words added after it can complete a match that reaches back over
//! a cut the shorter text had as safe. Inter's `calt`, for one, gives a closing bracket the
//! case form of its opening bracket across the spaces and capitals between them, and turns
//! `- : + =` between capitals into their case forms with spaces on either side. A cut right
//! after a space can only be crossed by a lookup whose matches can go on past a space, so when
//! the plan has none, every such cut stays safe; when it has some, a cut stays safe unless one
//! of their inputs is within their reach of it ([`Separation.separates`]).
import view { View }
import plan { CHECK_FRACTION }
import feature { Feature }
import font_types.lib { Tag }
import font { ShaperData }
import shape_plan { ShapePlan }
import unicode
import normalize
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.utf8_scan
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// A set of glyph ids, or of lookup indices, one bit each.
pub struct GlyphSet {
  words: List<u64>,
}

impl GlyphSet {
  pub fn make() -> GlyphSet {
    return GlyphSet { words: List<u64>.make() }
  }

  pub fn has(self: &Self, glyph: u32) -> bool {
    let word = u32.toUsize(glyph) / 64
    if word >= self.words.length() {
      return false
    }
    return (self.words.get(word) & u64.shiftLeft(1, usize.toU64(u32.toUsize(glyph) % 64))) != 0
  }

  /// Adds `glyph`; whether it was not in the set.
  pub effect fn add(self: &mut Self, glyph: u32) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let word = u32.toUsize(glyph) / 64
    while self.words.length() <= word {
      run self.words.append(0)
    }
    let bit = u64.shiftLeft(1, usize.toU64(u32.toUsize(glyph) % 64))
    let old = self.words.get(word)
    if (old & bit) != 0 {
      return false
    }
    self.words.set(word, old | bit)
    return true
  }

  pub effect fn include(self: &mut Self, other: &GlyphSet) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while self.words.length() < other.words.length() {
      run self.words.append(0)
    }
    let mut index: usize = 0
    while index < other.words.length() {
      let value = self.words.get(index) | other.words.get(index)
      self.words.set(index, value)
      index = index + 1
    }
  }

  pub fn clear(self: &mut Self) -> () {
    self.words.clear()
  }

  pub fn isEmpty(self: &Self) -> bool {
    let mut index: usize = 0
    while index < self.words.length() {
      if self.words.get(index) != 0 {
        return false
      }
      index = index + 1
    }
    return true
  }
}

/// What a plan's lookups do across one glyph: see [`separation`].
pub struct Separation {
  /// The glyph, 0 when the face has none for the character asked about.
  pub glyph: u32,
  /// No cut after the glyph can be trusted: a lookup positions or substitutes across it
  /// whatever comes near (it kerns or attaches from it, or skips it), or a table is in a form
  /// this does not read. Apple's tables are not read: their state machines and kerning are
  /// left to the shaper's flags.
  pub never: bool,
  /// How many characters on each side of a cut right after the glyph a match across the cut
  /// can reach, at most: the longest match of the lookups in `lookups`, less one, times the
  /// most characters one glyph of the plan stands for (its longest ligature). 0 when no
  /// lookup matches across the glyph.
  pub reach: usize,
  /// The glyphs those lookups take as input, with every glyph a substitution of the plan can
  /// turn into one of them, and the glyphs they skip.
  pub triggers: GlyphSet,
  /// The lookups whose matches can go on past the glyph: their index, plus 0x10000 for one in
  /// GPOS.
  pub lookups: List<u32>,
  /// Whether the plan has fraction lookups, which this leaves out: they apply only to the
  /// digits around a fraction slash (U+2044), so a cut with such digits near it is not
  /// trusted.
  pub fractions: bool,
  /// Whether the plan's shaper may decompose characters the font has.
  pub decomposes: bool,
}

impl Separation {
  pub fn make() -> Separation {
    return Separation {
      glyph: 0,
      never: true,
      reach: 0,
      triggers: GlyphSet.make(),
      lookups: List<u32>.make(),
      fractions: false,
      decomposes: true,
    }
  }

  /// Whether the text `bytes[start..end)`, shaped as one, cut at byte `cut` right after the
  /// character this separation is of, shapes as `bytes[start..cut)` and `bytes[cut..end)` do
  /// apart, given that a text the cut came from (which goes on from `bytes[start..cut)`) had
  /// no glyph unsafe to break there. False when that cannot be shown.
  pub fn separates(
    self: &Self,
    data: &ShaperData<'_>,
    bytes: &[u8],
    start: usize,
    cut: usize,
    end: usize,
  ) -> bool {
    if self.never || cut <= start || cut > end || end > bytes.length {
      return false
    }
    if self.reach == 0 {
      return true
    }
    if data.nominalGlyph(utf8_scan.decode(bytes, previousStart(bytes, cut)).scalar) != self.glyph {
      return false
    }

    // Each glyph of the plan stands for at most `reach / (longest match - 1)` characters, so
    // the characters within `reach` of the cut hold every glyph a match across it can use, as
    // long as none of them is skipped while matching. A match uses one of its lookup's inputs.
    let mut at = cut
    let mut count: usize = 0
    while at > start && count < self.reach {
      at = previousStart(bytes, at)
      if !Separation.plain(self, data, utf8_scan.decode(bytes, at).scalar)
        || (self.fractions && inFraction(bytes, at)) {
        return false
      }
      count = count + 1
    }
    at = cut
    count = 0
    while at < end && count < self.reach {
      let decoded = utf8_scan.decode(bytes, at)
      if !Separation.plain(self, data, decoded.scalar)
        || (self.fractions && inFraction(bytes, at)) {
        return false
      }
      at = decoded.next
      count = count + 1
    }
    return true
  }

  // Whether character `scalar` becomes one glyph of its own that no lookup crossing the glyph
  // takes as input or skips: not a mark or default ignorable (which matching skips, and which
  // normalization may compose with the character before), not a conjoining jamo, and not
  // decomposed. A character the font lacks gets the glyph normalization gives it.
  fn plain(self: &Self, data: &ShaperData<'_>, scalar: u32) -> bool {
    if scalar >= 0x300
      && (unicode.isMark(scalar) || unicode.isDefaultIgnorable(scalar)
        || (scalar >= 0x1100 && scalar <= 0x11ff)
        || (scalar >= 0xa960 && scalar <= 0xa97f)
        || (scalar >= 0xd7b0 && scalar <= 0xd7ff)) {
      return false
    }
    if scalar == 0xad {
      return false
    }
    let mut glyph = data.nominalGlyph(scalar)
    if glyph == 0 || self.decomposes {
      if unicode.decomposeRaw(scalar).first != 0 {
        return false
      }
    }
    if glyph == 0 {
      if scalar == 0x2011 {
        glyph = data.nominalGlyph(0x2010)
      } else if normalize.spaceType(scalar) != 0 {
        glyph = data.nominalGlyph(32)
      }
    }
    return !self.triggers.has(glyph)
  }
}

// Whether the character at byte `at` is a fraction slash or a digit of the digits next to one,
// which the shaper marks for the fraction features.
fn inFraction(bytes: &[u8], at: usize) -> bool {
  let scalar = utf8_scan.decode(bytes, at).scalar
  if scalar == 0x2044 {
    return true
  }
  if unicode.generalCategory(scalar) != 13 {
    return false
  }
  let mut low = at
  while low > 0 {
    let before = previousStart(bytes, low)
    let value = utf8_scan.decode(bytes, before).scalar
    if value == 0x2044 {
      return true
    }
    if unicode.generalCategory(value) != 13 {
      break
    }
    low = before
  }
  let mut high = utf8_scan.decode(bytes, at).next
  while high < bytes.length {
    let decoded = utf8_scan.decode(bytes, high)
    if decoded.scalar == 0x2044 {
      return true
    }
    if unicode.generalCategory(decoded.scalar) != 13 {
      break
    }
    high = decoded.next
  }
  return false
}

// Whether `features` sets feature `tag` anywhere.
fn named(features: &List<Feature>, tag: u32) -> bool {
  let mut index: usize = 0
  while index < features.length() {
    if Tag.toU32(features.get(index).tag) == tag {
      return true
    }
    index = index + 1
  }
  return false
}

fn previousStart(bytes: &[u8], at: usize) -> usize {
  let mut start = at
  while start > 0 {
    start = start - 1
    if (bytes[start] & 0xc0) != 0x80 {
      break
    }
  }
  return start
}

/// What the lookups of `plan`, shaping with `data`, do across glyph `glyph`.
pub effect fn separation<'a>(data: &ShaperData<'a>, plan: &ShapePlan<'a>, glyph: u32) -> Separation
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = Separation.make()
  result.glyph = glyph
  result.decomposes = plan.shaper != 0
  if glyph == 0 {
    return move result
  }

  // Apple's tables (morx, kerx, kern) are left to font-shape's flags, which mark every
  // cluster their state machines carry something across, and to `Buffer.leansOnBefore`.
  let gdefClasses = View.gdefList(&data.gdef, 0)
  let glyphClass = View.class(&gdefClasses, glyph)
  if glyphClass == 2 || glyphClass == 3 {
    return move result
  }
  let mut scan = Scan {
    glyph: glyph,
    never: false,
    joined: false,
    wild: false,
    skips: false,
    longest: 0,
    inputs: GlyphSet.make(),
    added: GlyphSet.make(),
    work: List<u32>.make(),
  }
  let mut triggers = GlyphSet.make()
  let mut longest: usize = 0
  let mut skips = false
  let mut visited = GlyphSet.make()

  // Each table is read twice: from the steps that can run anywhere, and from the fraction
  // steps, whose lookups (and the ones they nest) take as input only digits around a fraction
  // slash, never characters `separates` lets near a cut. Those count only for the reach.
  let mut pass: usize = 0
  while pass < 4 {
    let positioning = pass >= 2
    let masked = pass % 2 == 1
    pass = pass + 1
    let otPlan = if positioning {
      &plan.positions
    } else {
      &plan.substitutions
    }
    let layout = otPlan.table
    let list = View.layoutList(&layout, 2)
    let width: usize = 2
    if View.u16(&layout, 0) == 1 && View.u16(&layout, 2) >= 2 && View.u32(&layout, 22) != 0 {
      // 32-bit lookup lists, whose subtables this does not read.
      scan.never = true
      break
    }
    let lookupCount = u16.toU32(View.u16(&list, 0))
    scan.work.clear()
    let mut step: usize = 0
    while step < otPlan.steps.length() {
      let at = otPlan.steps.get(step)
      step = step + 1

      // A step no feature turns on runs only where another step of its lookup does; the
      // fraction features run only on the digits around a fraction slash, never on a space.
      let fraction = !at.required && !named(&plan.features, at.tag)
        && (at.checks & CHECK_FRACTION) != 0
      if fraction {
        result.fractions = true
      }
      if fraction != masked || (!at.required && at.value == 0 && !named(&plan.features, at.tag)) {
        continue
      }
      run scan.work.append(u16.toU32(at.index))
    }
    let mut lookups = GlyphSet.make()
    while scan.work.length() > 0 && !scan.never {
      let index = scan.work.get(scan.work.length() - 1)
      let remaining = scan.work.length() - 1
      scan.work.truncate(remaining)
      if index >= lookupCount || !run lookups.add(index) {
        continue
      }
      let lookup = View.offset(&list, 2 + u32.toUsize(index) * width, width)
      let kind = View.u16(&lookup, 0)
      let flags = View.u16(&lookup, 2)
      if (flags & 2) != 0 {
        // Base glyphs, the separator among them, are skipped.
        scan.never = true
        break
      }
      scan.joined = false
      scan.wild = false
      scan.longest = 0
      scan.inputs.clear()
      let subtables = u16.toUsize(View.u16(&lookup, 4))
      let mut sub: usize = 0
      while sub < subtables && !scan.never {
        run subtable(&mut scan, View.offset16(&lookup, 6 + sub * 2), kind, positioning, 0)
        sub = sub + 1
      }
      if scan.joined && !scan.never {
        if scan.wild && !masked {
          scan.never = true
          break
        }
        let mut listed = index
        if positioning {
          listed = index + 0x10000
        }
        run result.lookups.append(listed)
        if !masked {
          run triggers.include(&scan.inputs)
        }
        if scan.longest > longest {
          longest = scan.longest
        }
        if (flags & 0xff1c) != 0 {
          skips = true
        }
      }
    }
    if !positioning && !masked {
      run visited.include(&lookups)
    }
  }
  if scan.never {
    return move result
  }
  if scan.skips || skips {
    // A mark or ligature next to the cut could be skipped by a lookup that matches across it.
    let ligatures = run addClass(&mut triggers, gdefClasses, 2)
    let marks = run addClass(&mut triggers, gdefClasses, 3)
    if !ligatures || !marks {
      return move result
    }
  }

  // The glyphs substitutions can turn into triggers are triggers too; the plan's ligatures
  // give the most characters a glyph stands for.
  let layout = plan.substitutions.table
  let list = View.layoutList(&layout, 2)
  let width: usize = 2
  let mut widest: usize = 1
  let mut changed = true
  while changed {
    changed = false
    let mut index: u32 = 0
    let lookupCount = u16.toU32(View.u16(&list, 0))
    while index < lookupCount {
      if visited.has(index) {
        let lookup = View.offset(&list, 2 + u32.toUsize(index) * width, width)
        let kind = View.u16(&lookup, 0)
        let subtables = u16.toUsize(View.u16(&lookup, 4))
        let mut sub: usize = 0
        while sub < subtables {
          let found = run edges(&mut triggers, View.offset16(&lookup, 6 + sub * 2), kind, 0)
          if found.broken {
            return move result
          }
          if found.changed {
            changed = true
          }
          if found.widest > widest {
            widest = found.widest
          }
          sub = sub + 1
        }
      }
      index = index + 1
    }
  }
  if triggers.has(glyph) {
    return move result
  }
  result.never = false
  if result.lookups.length() > 0 {
    result.reach = usize.saturatingMultiply(longest - 1, widest)
    if longest < 2 {
      result.reach = widest
    }
  }
  result.triggers = move triggers
  return move result
}

// The state of `separation` while it reads one lookup.
struct Scan {
  glyph: u32,
  never: bool,
  // Whether the lookup has a match that can go on past the glyph.
  joined: bool,
  // Whether an input of the lookup is every glyph a class definition leaves out.
  wild: bool,
  // Whether a mark attachment can attach to the glyph.
  skips: bool,
  // The lookup's longest match, in glyphs.
  longest: usize,
  inputs: GlyphSet,
  // The classes of the subtable being read whose glyphs are in `inputs`.
  added: GlyphSet,
  // Lookups still to read, nested ones among them.
  work: List<u32>,
}

fn covers(coverage: View<'_>, glyph: u32) -> bool {
  if let Option<u32>.Some { value: _ } = View.coverage(&coverage, glyph) {
    return true
  }
  return false
}

// The glyphs of a coverage table in coverage order, with their coverage indices.
struct CoverageWalk<'a> {
  table: View<'a>,
  format: u16,
  count: usize,
  // The next glyph (format 1) or range (format 2).
  at: usize,
  glyph: u32,
  last: u32,
  index: u32,
  started: bool,
}

impl<'a> CoverageWalk<'a> {
  fn make(table: View<'a>) -> CoverageWalk<'a> {
    return CoverageWalk {
      table: table,
      format: View.u16(&table, 0),
      count: u16.toUsize(View.u16(&table, 2)),
      at: 0,
      glyph: 0,
      last: 0,
      index: 0,
      started: false,
    }
  }

  // Whether this walk can read the table: formats 1 and 2, or an empty table.
  fn readable(self: &Self) -> bool {
    return View.len(&self.table) == 0 || self.format == 1 || self.format == 2
  }

  fn next(self: &mut Self) -> bool {
    if self.format == 1 {
      if self.at >= self.count {
        return false
      }
      self.glyph = u16.toU32(View.u16(&self.table, 4 + self.at * 2))
      self.index = usize.toU32(self.at)
      self.at = self.at + 1
      return true
    }
    if self.format != 2 {
      return false
    }
    if self.started && self.glyph < self.last {
      self.glyph = self.glyph + 1
      self.index = self.index + 1
      return true
    }
    while self.at < self.count {
      let record = 4 + self.at * 6
      self.at = self.at + 1
      let first = u16.toU32(View.u16(&self.table, record))
      let last = u16.toU32(View.u16(&self.table, record + 2))
      if last < first {
        continue
      }
      self.glyph = first
      self.last = last
      self.index = u16.toU32(View.u16(&self.table, record + 4))
      self.started = true
      return true
    }
    return false
  }
}

// Adds the glyphs of `coverage` to `set`; false when the table is in a form this does not read.
effect fn addCoverage(set: &mut GlyphSet, coverage: View<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut walk = CoverageWalk.make(coverage)
  if !walk.readable() {
    return false
  }
  while walk.next() {
    drop run set.add(walk.glyph)
  }
  return true
}

// Adds the glyphs class definition `classes` puts in class `class` (not 0); false when the
// table is in a form this does not read.
effect fn addClass(set: &mut GlyphSet, classes: View<'_>, class: u32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if View.len(&classes) == 0 {
    return true
  }
  let format = View.u16(&classes, 0)
  if format == 1 {
    let first = u16.toU32(View.u16(&classes, 2))
    let count = u16.toUsize(View.u16(&classes, 4))
    let mut index: usize = 0
    while index < count {
      if u16.toU32(View.u16(&classes, 6 + index * 2)) == class {
        drop run set.add(first + usize.toU32(index))
      }
      index = index + 1
    }
    return true
  }
  if format == 2 {
    let count = u16.toUsize(View.u16(&classes, 2))
    let mut index: usize = 0
    while index < count {
      let record = 4 + index * 6
      if u16.toU32(View.u16(&classes, record + 4)) == class {
        let mut glyph = u16.toU32(View.u16(&classes, record))
        let last = u16.toU32(View.u16(&classes, record + 2))
        while glyph <= last {
          drop run set.add(glyph)
          glyph = glyph + 1
        }
      }
      index = index + 1
    }
    return true
  }
  return false
}

// Reads one subtable of a lookup of type `kind` into `scan`.
effect fn subtable(
  scan: &mut Scan,
  table: View<'_>,
  kind: u16,
  positioning: bool,
  depth: usize,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let format = View.u16(&table, 0)
  if View.len(&table) == 0 {
    return
  }
  if (!positioning && kind == 7) || (positioning && kind == 9) {
    if format != 1 || depth > 0 {
      scan.never = true
      return
    }
    run subtable(&mut scan, View.offset32(&table, 4), View.u16(&table, 2), positioning, depth + 1)
    return
  }
  if !positioning {
    if kind == 1 || kind == 2 || kind == 3 {
      // One glyph in, so no match across anything; `edges` reads them.
      return
    }
    if kind == 4 {
      run ligatures(&mut scan, table)
      return
    }
    if kind == 5 || kind == 6 {
      run contextual(&mut scan, table, kind == 6)
      return
    }
    if kind == 8 {
      run reverse(&mut scan, table)
      return
    }
    scan.never = true
    return
  }
  if kind == 1 {
    return
  }
  if kind == 2 || kind == 3 {
    // A pair adjustment or a cursive attachment from the separator reaches past it.
    if (format != 1 && (kind == 3 || format != 2)) || covers(View.offset16(&table, 2), scan.glyph) {
      scan.never = true
    }
    return
  }
  if kind == 4 || kind == 5 || kind == 6 {
    if format != 1 {
      scan.never = true
      return
    }
    if covers(View.offset16(&table, 4), scan.glyph) {
      scan.skips = true
    }
    return
  }
  if kind == 7 || kind == 8 {
    run contextual(&mut scan, table, kind == 8)
    return
  }
  scan.never = true
}

effect fn ligatures(scan: &mut Scan, table: View<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if View.u16(&table, 0) != 1 {
    scan.never = true
    return
  }
  let sets = u16.toU32(View.u16(&table, 4))
  let mut walk = CoverageWalk.make(View.offset16(&table, 2))
  if !walk.readable() {
    scan.never = true
    return
  }
  while walk.next() {
    if walk.index >= sets {
      continue
    }
    let set = View.offset16(&table, 6 + u32.toUsize(walk.index) * 2)
    let count = u16.toUsize(View.u16(&set, 0))
    let mut index: usize = 0
    while index < count {
      let ligature = View.offset16(&set, 2 + index * 2)
      let components = u16.toUsize(View.u16(&ligature, 2))
      index = index + 1
      if components < 2 {
        continue
      }
      drop run scan.inputs.add(walk.glyph)
      if walk.glyph == scan.glyph {
        scan.joined = true
      }
      let mut component: usize = 1
      while component < components {
        let value = u16.toU32(View.u16(&ligature, 4 + (component - 1) * 2))
        drop run scan.inputs.add(value)
        if value == scan.glyph && component + 1 < components {
          scan.joined = true
        }
        component = component + 1
      }
      if components > scan.longest {
        scan.longest = components
      }
    }
  }
}

effect fn reverse(scan: &mut Scan, table: View<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if View.u16(&table, 0) != 1 {
    scan.never = true
    return
  }
  let coverage = View.offset16(&table, 2)
  let back = u16.toUsize(View.u16(&table, 4))
  let aheadAt = 6 + back * 2
  let ahead = u16.toUsize(View.u16(&table, aheadAt))
  let mut index: usize = 0
  while index < back {
    if covers(View.offset16(&table, 6 + index * 2), scan.glyph) {
      scan.joined = true
    }
    index = index + 1
  }
  if covers(coverage, scan.glyph) && ahead > 0 {
    scan.joined = true
  }
  index = 0
  while index + 1 < ahead {
    if covers(View.offset16(&table, aheadAt + 2 + index * 2), scan.glyph) {
      scan.joined = true
    }
    index = index + 1
  }
  if !run addCoverage(&mut scan.inputs, coverage) {
    scan.never = true
  }
  if back + 1 + ahead > scan.longest {
    scan.longest = back + 1 + ahead
  }
}

effect fn nested(scan: &mut Scan, records: View<'_>, count: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut index: usize = 0
  while index < count {
    run scan.work.append(u16.toU32(View.u16(&records, index * 4 + 2)))
    index = index + 1
  }
}

// A contextual (`chained` false) or chained contextual subtable, of GSUB or GPOS.
effect fn contextual(scan: &mut Scan, table: View<'_>, chained: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let format = View.u16(&table, 0)
  if format == 3 {
    run coverageRule(&mut scan, table, chained)
    return
  }
  if format != 1 && format != 2 {
    scan.never = true
    return
  }
  let classes = format == 2
  let coverage = View.offset16(&table, 2)

  // Empty views with the table's lifetime; View.empty() would be inferred as 'static here.
  let mut backDef = View.tail(&table, View.len(&table))
  let mut inputDef = backDef
  let mut aheadDef = backDef
  let mut setsAt: usize = 6
  if classes {
    if chained {
      backDef = View.offset16(&table, 4)
      inputDef = View.offset16(&table, 6)
      aheadDef = View.offset16(&table, 8)
      setsAt = 12
    } else {
      inputDef = View.offset16(&table, 4)
      setsAt = 8
    }
  }
  let sets = u16.toUsize(View.u16(&table, setsAt - 2))

  // The separator's value in each sequence: its glyph, or its backtrack, input and lookahead
  // classes.
  let mut own: [u32; 3] = [scan.glyph, scan.glyph, scan.glyph]
  if classes {
    own = [
      View.class(&backDef, scan.glyph),
      View.class(&inputDef, scan.glyph),
      View.class(&aheadDef, scan.glyph),
    ]
    if !chained {
      own[0] = own[1]
      own[2] = own[1]
    }
  }
  scan.added.clear()
  let mut walk = CoverageWalk.make(coverage)
  if !walk.readable() {
    scan.never = true
    return
  }
  if !classes {
    // Rule set `index` is the covered glyph of that index's.
    let mut first = GlyphSet.make()
    while walk.next() {
      let index = u32.toUsize(walk.index)
      if index >= sets {
        continue
      }
      let ruleSet = View.offset16(&table, setsAt + index * 2)
      let rules = u16.toUsize(View.u16(&ruleSet, 0))
      first.clear()
      drop run first.add(walk.glyph)
      let mut rule: usize = 0
      while rule < rules {
        let firstIsOwn = walk.glyph == scan.glyph
        if run classRule(
          &mut scan,
          View.offset16(&ruleSet, 2 + rule * 2),
          chained,
          false,
          firstIsOwn,
          own,
          inputDef,
        ) {
          run scan.inputs.include(&first)
        }
        rule = rule + 1
      }
    }
    return
  }
  let mut set: usize = 0
  while set < sets {
    // The first glyph of a rule of set `set`: the covered glyph of that index, or the covered
    // glyphs of that input class.
    let ruleSet = View.offset16(&table, setsAt + set * 2)
    if View.len(&ruleSet) == 0 {
      set = set + 1
      continue
    }
    let mut first = GlyphSet.make()
    walk = CoverageWalk.make(coverage)
    while walk.next() {
      if View.class(&inputDef, walk.glyph) == usize.toU32(set) {
        drop run first.add(walk.glyph)
      }
    }
    let firstIsOwn = first.has(scan.glyph)
    let rules = u16.toUsize(View.u16(&ruleSet, 0))
    let mut index: usize = 0
    while index < rules {
      let ruleInputs = run classRule(
        &mut scan,
        View.offset16(&ruleSet, 2 + index * 2),
        chained,
        true,
        firstIsOwn,
        own,
        inputDef,
      )
      if ruleInputs {
        run scan.inputs.include(&first)
      }
      index = index + 1
    }
    set = set + 1
  }
}

// Reads a rule of a format 1 or 2 contextual subtable whose first input can be the separator
// when `firstIsOwn`; `own` is the separator's value in each sequence. Returns whether the rule
// has an input at all (the first input's glyphs are the caller's to add).
effect fn classRule(
  scan: &mut Scan,
  rule: View<'_>,
  chained: bool,
  classes: bool,
  firstIsOwn: bool,
  own: [u32; 3],
  inputDef: View<'_>,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut back: usize = 0
  let mut inputAt: usize = 0
  if chained {
    back = u16.toUsize(View.u16(&rule, 0))
    inputAt = 2 + back * 2
  }
  let inputs = u16.toUsize(View.u16(&rule, inputAt))
  if inputs == 0 {
    return false
  }
  let mut ahead: usize = 0
  let mut aheadAt: usize = 0
  let mut records: usize = 0
  let mut recordsAt: usize = 0
  if chained {
    aheadAt = inputAt + 2 + (inputs - 1) * 2
    ahead = u16.toUsize(View.u16(&rule, aheadAt))
    records = u16.toUsize(View.u16(&rule, aheadAt + 2 + ahead * 2))
    recordsAt = aheadAt + 4 + ahead * 2
  } else {
    records = u16.toUsize(View.u16(&rule, 2))
    recordsAt = 4 + (inputs - 1) * 2
  }
  let mut index: usize = 0
  while index < back {
    if u16.toU32(View.u16(&rule, 2 + index * 2)) == own[0] {
      scan.joined = true
    }
    index = index + 1
  }
  if firstIsOwn && (inputs > 1 || ahead > 0) {
    scan.joined = true
  }
  let valuesAt = if chained {
    inputAt + 2
  } else {
    4
  }
  index = 1
  while index < inputs {
    let value = u16.toU32(View.u16(&rule, valuesAt + (index - 1) * 2))
    if value == own[1] && (index + 1 < inputs || ahead > 0) {
      scan.joined = true
    }
    if !classes {
      drop run scan.inputs.add(value)
    } else if value == 0 {
      scan.wild = true
    } else if run scan.added.add(value) {
      if !run addClass(&mut scan.inputs, inputDef, value) {
        scan.never = true
      }
    }
    index = index + 1
  }
  index = 0
  while index + 1 < ahead {
    if u16.toU32(View.u16(&rule, aheadAt + 2 + index * 2)) == own[2] {
      scan.joined = true
    }
    index = index + 1
  }
  if back + inputs + ahead > scan.longest {
    scan.longest = back + inputs + ahead
  }
  run nested(&mut scan, View.tail(&rule, recordsAt), records)
  return true
}

// A format 3 contextual or chained contextual subtable: one rule of coverages.
effect fn coverageRule(scan: &mut Scan, table: View<'_>, chained: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut back: usize = 0
  let mut inputs: usize = 0
  let mut inputAt: usize = 0
  let mut ahead: usize = 0
  let mut aheadAt: usize = 0
  let mut records: usize = 0
  let mut recordsAt: usize = 0
  if chained {
    back = u16.toUsize(View.u16(&table, 2))
    inputAt = 4 + back * 2
    inputs = u16.toUsize(View.u16(&table, inputAt))
    aheadAt = inputAt + 2 + inputs * 2
    ahead = u16.toUsize(View.u16(&table, aheadAt))
    records = u16.toUsize(View.u16(&table, aheadAt + 2 + ahead * 2))
    recordsAt = aheadAt + 4 + ahead * 2
    inputAt = inputAt + 2
  } else {
    inputs = u16.toUsize(View.u16(&table, 2))
    records = u16.toUsize(View.u16(&table, 4))
    inputAt = 6
    recordsAt = 6 + inputs * 2
  }
  if inputs == 0 {
    return
  }
  let mut index: usize = 0
  while index < back {
    if covers(View.offset16(&table, 4 + index * 2), scan.glyph) {
      scan.joined = true
    }
    index = index + 1
  }
  index = 0
  while index < inputs {
    let coverage = View.offset16(&table, inputAt + index * 2)
    if covers(coverage, scan.glyph) && (index + 1 < inputs || ahead > 0) {
      scan.joined = true
    }
    if !run addCoverage(&mut scan.inputs, coverage) {
      scan.never = true
    }
    index = index + 1
  }
  index = 0
  while index + 1 < ahead {
    if covers(View.offset16(&table, aheadAt + 2 + index * 2), scan.glyph) {
      scan.joined = true
    }
    index = index + 1
  }
  if back + inputs + ahead > scan.longest {
    scan.longest = back + inputs + ahead
  }
  run nested(&mut scan, View.tail(&table, recordsAt), records)
}

// What one pass over a substitution subtable found.
struct Edges {
  changed: bool,
  broken: bool,
  // The most characters one output glyph stands for.
  widest: usize,
}

impl Copy for Edges {}

// Adds to `triggers` the glyphs a substitution subtable turns into one of them.
effect fn edges(triggers: &mut GlyphSet, table: View<'_>, kind: u16, depth: usize) -> Edges
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = Edges { changed: false, broken: false, widest: 1 }
  let format = View.u16(&table, 0)
  if View.len(&table) == 0 {
    return found
  }
  if kind == 7 {
    if format != 1 || depth > 0 {
      found.broken = true
      return found
    }
    return run edges(&mut triggers, View.offset32(&table, 4), View.u16(&table, 2), depth + 1)
  }
  if kind != 1 && kind != 2 && kind != 3 && kind != 4 && kind != 8 {
    return found
  }
  let mut walk = CoverageWalk.make(View.offset16(&table, 2))
  if !walk.readable() || (kind != 1 && format != 1) || (kind == 1 && format != 1 && format != 2) {
    found.broken = true
    return found
  }
  let mut substitutesAt: usize = 6
  if kind == 8 {
    let back = u16.toUsize(View.u16(&table, 4))
    let ahead = u16.toUsize(View.u16(&table, 6 + back * 2))
    substitutesAt = 6 + back * 2 + 2 + ahead * 2 + 2
  }
  while walk.next() {
    let index = u32.toUsize(walk.index)
    let glyph = walk.glyph
    let mut into = false
    if kind == 1 && format == 1 {
      // The delta is added modulo 65536.
      into = triggers.has((glyph + u16.toU32(View.u16(&table, 4))) & 0xffff)
    } else if kind == 1 || kind == 8 {
      let count = u16.toUsize(
        View.u16(
          &table,
          if kind == 1 {
            4
          } else {
            substitutesAt - 2
          },
        ),
      )
      if index < count {
        into = triggers.has(u16.toU32(View.u16(&table, substitutesAt + index * 2)))
      }
    } else if kind == 2 || kind == 3 {
      if index < u16.toUsize(View.u16(&table, 4)) {
        let sequence = View.offset16(&table, 6 + index * 2)
        let count = u16.toUsize(View.u16(&sequence, 0))
        if kind == 2 && count == 0 {
          // A glyph deleted: the glyphs around it meet, however many characters apart.
          found.broken = true
          return found
        }
        let mut at: usize = 0
        while at < count {
          if triggers.has(u16.toU32(View.u16(&sequence, 2 + at * 2))) {
            into = true
          }
          at = at + 1
        }
      }
    } else if index < u16.toUsize(View.u16(&table, 4)) {
      let set = View.offset16(&table, 6 + index * 2)
      let count = u16.toUsize(View.u16(&set, 0))
      let mut at: usize = 0
      while at < count {
        let ligature = View.offset16(&set, 2 + at * 2)
        let components = u16.toUsize(View.u16(&ligature, 2))
        if components > found.widest {
          found.widest = components
        }
        if triggers.has(u16.toU32(View.u16(&ligature, 0))) {
          // Every component becomes the ligature.
          if run triggers.add(glyph) {
            found.changed = true
          }
          let mut component: usize = 1
          while component < components {
            if run triggers.add(u16.toU32(View.u16(&ligature, 4 + (component - 1) * 2))) {
              found.changed = true
            }
            component = component + 1
          }
        }
        at = at + 1
      }
    }
    if into && run triggers.add(glyph) {
      found.changed = true
    }
  }
  return found
}
