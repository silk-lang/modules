//! CSS selectors borrow the retained tree's element links, identity and live interaction state.
import svg_css.ancestor_filter { AncestorFilter }
import engine { UiTree }
import containers
import svg_css.media_features { Environment }
import svg_css.element { PseudoTarget }
import svg_css.variables { ScopeId }
import node { Node, Semantics, NONE, NO_INDEX }
import mutation { NodeKind, Role }
import style_identity { NodeIdentity }
import svg_css.element { ElementTree, StateBits, AttributeText, NO_ELEMENT }
import svg_css.element
import svg_css.tokens { equal }
import silk.core.option { Option }
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

pub struct SelectorTree<'tree, 'fonts> { pub tree: &'tree UiTree<'fonts> }

fn absent<'a>() -> AttributeText<'a> { return AttributeText<'a> { namespace: b"", name: b"", value: b"" } }

impl<'tree, 'fonts> SelectorTree<'tree, 'fonts> {
  fn record(self: &Self, node: usize) -> &Node { return &self.tree.nodes.asSlice()[node] }

  /// Whether a radio among the element siblings of `node` is checked: its group.
  fn groupChecked(self: &Self, node: usize) -> bool {
    let parent = ElementTree.parent(self, node)
    let mut at = if parent == NO_ELEMENT { node } else { ElementTree.firstChild(self, parent) }
    while at != NO_ELEMENT {
      let other = self.record(at)
      if other.accessRole == Role.Radio && other.checked { return true }
      at = ElementTree.nextSibling(self, at)
    }
    return false
  }

  fn elementAt(self: &Self, first: usize, backwards: bool) -> usize {
    let mut at = first
    while at != NO_INDEX {
      let slot = self.tree.slotOfCssNode(at)
      if slot != NONE && self.tree.node(slot).live && self.tree.node(slot).kind != NodeKind.Text && !self.tree.node(slot).isGenerated() { return u32.toUsize(slot) }
      at = if backwards { self.tree.layout.previousSibling(at) } else { self.tree.layout.nextSibling(at) }
    }
    return NO_ELEMENT
  }

  fn namedAttribute<'a>(self: &'a Self, node: usize, name: &[u8]) -> Option<&'a [u8]> {
    if let Option<&NodeIdentity>.Some { value } = self.record(node).identity() {
      let mut i: usize = 0
      while i < value.attributes().length {
        let attribute = &value.attributes()[i]
        if equal(String.utf8Bytes(String.view(&attribute.name)), name) {
          return Option<&[u8]>.some(String.utf8Bytes(String.view(&attribute.value)))
        }
        i = i + 1
      }
    }
    return Option<&[u8]>.None
  }
}

impl<'tree, 'fonts> ElementTree for SelectorTree<'tree, 'fonts> {
  fn container(self: &Self, node: usize, name: &[u8], axes: u32, pseudo: PseudoTarget) -> Option<Environment> {
    return containers.query(self.tree, usize.toU32(node), name, axes, pseudo)
  }
  fn styleContainer(self: &Self, node: usize, name: &[u8], pseudo: PseudoTarget) -> Option<ScopeId> {
    if let Option<u32>.Some { value: slot } = containers.select(self.tree, usize.toU32(node), pseudo, name, 0) {
      return self.tree.node(slot).sheetScope()
    }
    return Option<ScopeId>.None
  }
  /// The tree's filter while a style pass holds exactly the ancestors of `node` in it.
  fn ancestorFilter(self: &Self, node: usize) -> Option<&AncestorFilter> {
    if !self.tree.filterOn { return Option<&AncestorFilter>.None }
    let parent = self.record(node).parent
    let path = self.tree.filterPath.asSlice()
    let holds = if parent == NONE { path.length == 0 } else { path.length != 0 && path[path.length - 1] == parent }
    return if holds { Option<&AncestorFilter>.some(&self.tree.ancestorFilter) } else { Option<&AncestorFilter>.None }
  }
  /// From the element's sorted class atoms: no scan of the class text, which a utility-class
  /// element makes hundreds of bytes long.
  fn hasClass(self: &Self, node: usize, name: &[u8]) -> Option<bool> {
    let atoms = match self.record(node).identity() { Option<&NodeIdentity>.Some { value } => value.classAtoms() _ => &[] }
    if atoms.length == 0 { return Option<bool>.some(false) }
    let atom = self.tree.styleAtoms.find(name)
    if atom == usize.MAX { return Option<bool>.some(false) }
    let mut low: usize = 0
    let mut high = atoms.length
    while low < high {
      let middle = low + (high - low) / 2
      if atoms[middle] < atom { low = middle + 1 } else { high = middle }
    }
    return Option<bool>.some(low < atoms.length && atoms[low] == atom)
  }
  /// 1-based element index among siblings, recorded top-down during `resolveStyles`.
  fn siblingIndex(self: &Self, node: usize, reverse: bool) -> Option<usize> {
    if !self.tree.siblingOn { return Option<usize>.None }
    let parent = self.record(node).parent
    if parent == NONE { return Option<usize>.some(1) }
    let parentIndex = u32.toUsize(parent)
    if parentIndex >= self.tree.siblingStamp.length() || node >= self.tree.siblingIndex.length() {
      return Option<usize>.None
    }
    if self.tree.siblingStamp.asSlice()[parentIndex] != self.tree.siblingPass {
      return Option<usize>.None
    }
    let index = self.tree.siblingIndex.asSlice()[node]
    if index == 0 { return Option<usize>.None }
    if !reverse { return Option<usize>.some(u32.toUsize(index)) }
    let total = self.tree.siblingCount.asSlice()[parentIndex]
    if index > total { return Option<usize>.None }
    return Option<usize>.some(u32.toUsize(total - index + 1))
  }
  fn parent(self: &Self, node: usize) -> usize {
    let parent = self.record(node).parent
    return if parent == NONE { NO_ELEMENT } else { u32.toUsize(parent) }
  }
  fn containingHost(self: &Self, node: usize) -> usize { return NO_ELEMENT }
  fn firstChild(self: &Self, node: usize) -> usize {
    return self.elementAt(self.tree.layout.firstChild(self.record(node).css), false)
  }
  fn nextSibling(self: &Self, node: usize) -> usize {
    return self.elementAt(self.tree.layout.nextSibling(self.record(node).css), false)
  }
  fn previousSibling(self: &Self, node: usize) -> usize {
    return self.elementAt(self.tree.layout.previousSibling(self.record(node).css), true)
  }
  fn localName(self: &Self, node: usize) -> &[u8] {
    if let Option<&NodeIdentity>.Some { value } = self.record(node).identity() {
      if String.utf8Bytes(value.tag()).length != 0 { return String.utf8Bytes(value.tag()) }
    }
    return match self.record(node).kind {
      NodeKind.Input => b"input"
      NodeKind.Image => b"img"
      NodeKind.Icon => b"span"
      NodeKind.Canvas => b"canvas"
      _ => b"div"
    }
  }
  fn namespaceUri(self: &Self, node: usize) -> &[u8] { return b"http://www.w3.org/1999/xhtml" }
  fn attributeCount(self: &Self, node: usize) -> usize {
    if let Option<&NodeIdentity>.Some { value } = self.record(node).identity() {
      let mut count = value.attributes().length
      if value.hasId { count = count + 1 }
      if value.hasClasses { count = count + 1 }
      return count
    }
    return 0
  }
  fn attribute<'a>(self: &'a Self, node: usize, attribute: usize) -> AttributeText<'a> {
    if let Option<&NodeIdentity>.Some { value } = self.record(node).identity() {
      let mut index = attribute
      if value.hasId {
        if index == 0 { return AttributeText<'a> { namespace: b"", name: b"id", value: String.utf8Bytes(value.id()) } }
        index = index - 1
      }
      if value.hasClasses {
        if index == 0 { return AttributeText<'a> { namespace: b"", name: b"class", value: String.utf8Bytes(value.classes()) } }
        index = index - 1
      }
      if index < value.attributes().length {
        let item = &value.attributes()[index]
        return AttributeText<'a> { namespace: b"", name: String.utf8Bytes(String.view(&item.name)), value: String.utf8Bytes(String.view(&item.value)) }
      }
    }
    return absent<'a>()
  }
  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] { return self.attribute(node, attribute).name }
  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] { return b"" }
  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] { return self.attribute(node, attribute).value }
  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool { return equal(self.attributeName(node, attribute), b"id") }
  fn language(self: &Self, node: usize) -> &[u8] {
    let mut at = node
    while at != NO_ELEMENT {
      if let Option<&[u8]>.Some { value } = self.namedAttribute(at, b"lang") { return value }
      at = self.parent(at)
    }
    return b""
  }
  fn isRoot(self: &Self, node: usize) -> bool { return self.tree.isRootNode(usize.toU32(node)) }
  fn isEmpty(self: &Self, node: usize) -> bool {
    let mut at = self.tree.layout.firstChild(self.record(node).css)
    while at != NO_INDEX {
      let slot = self.tree.slotOfCssNode(at)
      if slot != NONE {
        let child = self.tree.node(slot)
        if child.live && !child.isGenerated() && (child.kind != NodeKind.Text || child.text.ownedByteLength() != 0) { return false }
      }
      at = self.tree.layout.nextSibling(at)
    }
    return true
  }
  fn isLink(self: &Self, node: usize) -> bool {
    let name = self.localName(node)
    return (equal(name, b"a") || equal(name, b"area")) && self.namedAttribute(node, b"href").isSome()
  }
  fn state(self: &Self, node: usize) -> StateBits {
    let record = self.record(node)
    let mut bits: u32 = 0
    if record.hovered { bits = bits | element.HOVER }
    if record.pressed { bits = bits | element.ACTIVE }
    if self.tree.focused == usize.toU32(node) {
      bits = bits | element.FOCUS
      if self.tree.focusVisible || record.kind == NodeKind.Input { bits = bits | element.FOCUS_VISIBLE }
    }
    let mut focused = self.tree.focused
    while focused != NONE {
      if focused == usize.toU32(node) { bits = bits | element.FOCUS_WITHIN
        break
      }
      focused = self.tree.node(focused).parent
    }
    let tag = self.localName(node)
    let form = record.kind == NodeKind.Input || equal(tag, b"input") || equal(tag, b"button")
      || equal(tag, b"select") || equal(tag, b"textarea") || equal(tag, b"fieldset")
      || equal(tag, b"option") || equal(tag, b"optgroup")
    // HTML §4.10.18.5 & §4.10.16: a form control is actually disabled if it has `disabled`,
    // or is a descendant of a disabled `<fieldset>` outside that fieldset's first `<legend>` child,
    // or is an `<option>` inside a disabled `<optgroup>`.
    let mut actuallyDisabled = record.disabled
    if !actuallyDisabled && form {
      if equal(tag, b"option") {
        let p = self.parent(node)
        if p != NO_ELEMENT && equal(self.localName(p), b"optgroup") && self.record(p).disabled {
          actuallyDisabled = true
        }
      }
      if !actuallyDisabled && !equal(tag, b"option") && !equal(tag, b"optgroup") {
        let mut child = node
        let mut anc = self.parent(node)
        while anc != NO_ELEMENT {
          let ancTag = self.localName(anc)
          if equal(ancTag, b"fieldset") && self.record(anc).disabled {
            // Check whether `child` is the fieldset's first `<legend>` element child.
            let mut firstLegend = NO_ELEMENT
            let mut c = self.firstChild(anc)
            while c != NO_ELEMENT {
              if equal(self.localName(c), b"legend") {
                firstLegend = c
                break
              }
              c = self.nextSibling(c)
            }
            if child != firstLegend {
              actuallyDisabled = true
              break
            }
          }
          child = anc
          anc = self.parent(anc)
        }
      }
    }
    if actuallyDisabled { bits = bits | element.DISABLED }
    else if form { bits = bits | element.ENABLED }
    if record.checked || (equal(tag, b"option") && record.selected) { bits = bits | element.CHECKED }
    let required = match &record.semanticsOf() { Option<&Semantics>.Some { value } => value.required _ => false }
    if let Option<&Semantics>.Some { value } = record.semanticsOf() {
      if value.indeterminate { bits = bits | element.INDETERMINATE }
    }
    // A progress bar with no value, and a radio whose group has nothing checked.
    if record.accessRole == Role.ProgressBar && !record.hasValueRange() { bits = bits | element.INDETERMINATE }
    if record.accessRole == Role.Radio && !record.checked && !self.groupChecked(node) { bits = bits | element.INDETERMINATE }
    if record.hasValueRange() && record.valueMin() <= record.valueMax() {
      bits = bits | (if record.valueNow() >= record.valueMin() && record.valueNow() <= record.valueMax() { element.IN_RANGE } else { element.OUT_OF_RANGE })
    }
    if form { bits = bits | (if required { element.REQUIRED } else { element.OPTIONAL }) }
    if record.kind == NodeKind.Input && record.hasEdit() && !record.edit().readOnly && !actuallyDisabled { bits = bits | element.READ_WRITE }
    else { bits = bits | element.READ_ONLY }
    if record.kind == NodeKind.Input && record.hasEdit() && record.text.ownedByteLength() == 0 && record.edit().placeholder.ownedByteLength() != 0 {
      bits = bits | element.PLACEHOLDER_SHOWN
    }
    if self.namedAttribute(node, b"open").isSome() { bits = bits | element.OPEN }
    if let Option<&[u8]>.Some { value: v } = self.namedAttribute(node, b"-silk-valid") {
      if equal(v, b"1") { bits = bits | element.VALID }
      else if equal(v, b"0") { bits = bits | element.INVALID }
    } else if form || equal(tag, b"form") {
      let inv = match &record.semanticsOf() { Option<&Semantics>.Some { value } => value.invalid _ => false }
      if inv { bits = bits | element.INVALID }
      else if form && !equal(tag, b"option") && !equal(tag, b"optgroup") { bits = bits | element.VALID }
    }
    if let Option<&[u8]>.Some { value: uv } = self.namedAttribute(node, b"-silk-user-valid") {
      if equal(uv, b"1") { bits = bits | element.USER_VALID }
      else if equal(uv, b"0") { bits = bits | element.USER_INVALID }
    }
    if let Option<&[u8]>.Some { value: def } = self.namedAttribute(node, b"-silk-default") {
      if equal(def, b"1") { bits = bits | element.DEFAULT }
    }
    return StateBits { bits: bits }
  }
}
