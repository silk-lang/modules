//! Collapsed table borders (CSS 2 §17.6.2). css-layout resolves each grid line segment's
//! width and gives every cell half of it; the table paints the segments, over its cells'
//! backgrounds, with the style and color of the border that wins each one (§17.6.2.1):
//! `hidden` suppresses the others, then the widest, then solid before dashed, then a cell
//! before its row, row group, column, column group and the table, then the left or top one.
import mutation { BorderStyle as StyleBorder }
import style { Computed }
import node { NONE, NO_INDEX, Node }
import layout.lib { LayoutTree, Fragment, FragmentKind, DisplayInside, BorderCollapse }
import ui_scene.primitives { Background, BorderStyle, ContentMask, Quad }
import ui_scene.scene { Scene }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.ownership { Copy }
import silk.geometry.insets { Insets }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.u8
import silk.num.usize

const TOP: u8 = 1
const RIGHT: u8 = 2
const BOTTOM: u8 = 4
const LEFT: u8 = 8
const CELL: u8 = 6
const ROW: u8 = 5
const GROUP: u8 = 4
const COLUMN: u8 = 3
const COLUMN_GROUP: u8 = 2
const TABLE: u8 = 1

/// A box with a border on the grid: its slot, origin rank, and the grid lines it spans.
struct Part { slot: u32, rank: u8, first: usize, end: usize }
impl Copy for Part {}
struct Placed { slot: u32, rank: u8, rect: Rect<f32>, edges: u8 }
impl Copy for Placed {}
struct Cell { slot: u32, row: usize, rowEnd: usize, column: usize, columnEnd: usize, edges: u8 }
impl Copy for Cell {}

/// One candidate or winner: `style` is 0 none, 1 dashed, 2 solid.
struct Border { width: f32, style: u8, rank: u8, hidden: bool, color: Rgba<f32> }
impl Copy for Border {}
impl Border {
  fn none() -> Border { return Border { width: 0.0, style: 0, rank: 0, hidden: false, color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 } } }
}

fn computedOf<'n>(nodes: &'n List<Node>, slot: u32) -> &'n Computed {
  return &nodes.asSlice()[u32.toUsize(slot)].computed().*
}

fn sideOf(c: &Computed, bit: u8, rank: u8) -> Border {
  let mut width = c.paint.border.left
  if bit == TOP { width = c.paint.border.top }
  if bit == RIGHT { width = c.paint.border.right }
  if bit == BOTTOM { width = c.paint.border.bottom }
  let mut style: u8 = 2
  if c.paint.borderStyle == StyleBorder.Dashed { style = 1 }
  if c.paint.borderStyle == StyleBorder.None {
    style = 0
    width = 0.0
  }
  return Border { width: width, style: style, rank: rank, hidden: c.layout.borderHidden & bit != 0, color: c.paint.borderColor }
}

/// Whether `next` wins over `best`, which came first and so wins ties.
fn beats(best: &Border, next: &Border) -> bool {
  if best.hidden { return false }
  if next.hidden { return true }
  if next.width != best.width { return next.width > best.width }
  if next.style != best.style { return next.style > best.style }
  return next.rank > best.rank
}

fn consider(best: &mut Border, nodes: &List<Node>, slot: u32, bit: u8, rank: u8) {
  if slot == NONE { return }
  let next = sideOf(computedOf(nodes, slot), bit, rank)
  if beats(&best.*, &next) { best.* = next }
}

/// Inserts `value` into the ascending, distinct `lines`, unless one lies within 1/100 px.
effect fn addLine(lines: &mut List<f32>, value: f32) ! OutOfMemoryError ? &mut Allocator {
  let at = lineAt(&lines.*, value)
  if at < lines.length() && f32.abs(lines.get(at) - value) < 0.01 { return }
  if at > 0 && f32.abs(lines.get(at - 1) - value) < 0.01 { return }
  run lines.append(value)
  let mut index = lines.length() - 1
  while index > at {
    let previous = lines.get(index - 1)
    lines.set(index, previous)
    index = index - 1
  }
  lines.set(at, value)
}

/// The first line at or after `value`, less 1/100 px.
fn lineAt(lines: &List<f32>, value: f32) -> usize {
  let mut low: usize = 0
  let mut high = lines.length()
  while low < high {
    let middle = (low + high) / 2
    if lines.get(middle) < value - 0.01 { low = middle + 1 } else { high = middle }
  }
  return low
}

fn insideOf(nodes: &List<Node>, slot: u32, inside: DisplayInside) -> bool {
  return computedOf(nodes, slot).layout.display.insideIs(inside)
}

fn slotOf(slots: &List<u32>, f: &Fragment) -> u32 {
  if f.kind != FragmentKind.Box || f.source >= slots.length() { return NONE }
  return slots.get(f.source)
}

fn rectOf(f: &Fragment) -> Rect<f32> {
  return Rect<f32>.new(f.worldLocation.x, f.worldLocation.y, f.worldLocation.x + f.size.width, f.worldLocation.y + f.size.height)
}

/// The table's parts below fragment `index`: cells in `cells`, rows, row groups, columns and
/// column groups in `parts` (with their rectangles until the grid lines are known).
effect fn gather(output: &LayoutTree, slots: &List<u32>, nodes: &List<Node>, index: usize, depth: usize, cells: &mut List<Placed>, parts: &mut List<Placed>) ! OutOfMemoryError ? &mut Allocator {
  let fragments = output.fragments.values.asSlice()
  let mut child = fragments[index].firstChild
  while child != NO_INDEX {
    let f = fragments[child]
    let slot = slotOf(slots, &f)
    if slot != NONE {
      if insideOf(nodes, slot, DisplayInside.TableCell) {
        run cells.append(Placed { slot: slot, rank: CELL, rect: rectOf(&f), edges: f.decorationEdges })
      } else if depth < 2 && insideOf(nodes, slot, DisplayInside.TableRow) {
        run parts.append(Placed { slot: slot, rank: ROW, rect: rectOf(&f), edges: f.decorationEdges })
        run gather(output, slots, nodes, child, 2, &mut cells, &mut parts)
      } else if depth == 0 && (insideOf(nodes, slot, DisplayInside.TableRowGroup) || insideOf(nodes, slot, DisplayInside.TableHeaderGroup) || insideOf(nodes, slot, DisplayInside.TableFooterGroup)) {
        run parts.append(Placed { slot: slot, rank: GROUP, rect: rectOf(&f), edges: f.decorationEdges })
        run gather(output, slots, nodes, child, 1, &mut cells, &mut parts)
      } else if depth == 0 && insideOf(nodes, slot, DisplayInside.TableColumnGroup) {
        run parts.append(Placed { slot: slot, rank: COLUMN_GROUP, rect: rectOf(&f), edges: f.decorationEdges })
        run gather(output, slots, nodes, child, 1, &mut cells, &mut parts)
      } else if depth <= 1 && insideOf(nodes, slot, DisplayInside.TableColumn) {
        run parts.append(Placed { slot: slot, rank: COLUMN, rect: rectOf(&f), edges: f.decorationEdges })
      }
    }
    child = f.nextSibling
  }
}

/// A band of the grid in device pixels: `center` across the line, from `start` to `end`
/// along it, `width` wide, vertical when `vertical`.
effect fn band(scene: &mut Scene, mask: ContentMask, border: &Border, center: f32, start: f32, end: f32, width: f32, vertical: bool) ! OutOfMemoryError ? &mut Allocator {
  if width <= 0.0 || end <= start || border.color.a <= 0.0 { return }
  let low = f32.round(center - width / 2.0)
  let from = f32.round(start)
  let to = f32.round(end)
  let mut bounds = Rect<f32>.new(from, low, to, low + width)
  if vertical { bounds = Rect<f32>.new(low, from, low + width, to) }
  if border.style == 2 {
    drop run scene.quad(Quad.fill(bounds, mask, Background.solid(border.color)))
    return
  }
  let mut quad = Quad.fill(bounds, mask, Background.solid(Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }))
  let mut widths = Insets<f32>.zero()
  if vertical { widths.left = width } else { widths.top = width }
  quad.borderWidths = widths
  quad.borderColor = border.color
  quad.borderStyle = BorderStyle.Dashed
  drop run scene.quad(quad)
}

/// A border width in whole device pixels, at least one when it is not zero, as boxes paint theirs.
fn deviceWidth(width: f32, scale: f32) -> f32 {
  let scaled = width * scale
  if scaled > 0.0 && scaled < 1.0 { return 1.0 }
  return f32.floor(scaled)
}

/// Paints the collapsed borders of the table whose fragment is `index` and style slot `table`.
pub effect fn paint(scene: &mut Scene, output: &LayoutTree, slots: &List<u32>, nodes: &List<Node>, index: usize, table: u32, scale: f32, mask: ContentMask) ! OutOfMemoryError ? &mut Allocator {
  let mut placedCells = List<Placed>.make()
  let mut placedParts = List<Placed>.make()
  run gather(output, slots, nodes, index, 0, &mut placedCells, &mut placedParts)
  let edges = output.fragments.values.asSlice()[index].decorationEdges
  if placedCells.length() == 0 { return }
  // Cells meet on the grid lines: their border boxes run from line to line.
  let mut xs = List<f32>.make()
  let mut ys = List<f32>.make()
  let mut at: usize = 0
  while at < placedCells.length() {
    let rect = placedCells.get(at).rect
    run addLine(&mut xs, rect.xMin)
    run addLine(&mut xs, rect.xMax)
    run addLine(&mut ys, rect.yMin)
    run addLine(&mut ys, rect.yMax)
    at = at + 1
  }
  let columns = xs.length() - 1
  let rows = ys.length() - 1
  if columns == 0 || rows == 0 { return }
  let mut cells = List<Cell>.make()
  let mut occupied = List<usize>.make()
  run occupied.appendRepeated(NO_INDEX, rows * columns)
  at = 0
  while at < placedCells.length() {
    let placed = placedCells.get(at)
    let cell = Cell { slot: placed.slot, column: lineAt(&xs, placed.rect.xMin), columnEnd: lineAt(&xs, placed.rect.xMax), row: lineAt(&ys, placed.rect.yMin), rowEnd: lineAt(&ys, placed.rect.yMax), edges: placed.edges }
    let mut row = cell.row
    while row < cell.rowEnd && row < rows {
      let mut column = cell.column
      while column < cell.columnEnd && column < columns {
        occupied.set(row * columns + column, cells.length())
        column = column + 1
      }
      row = row + 1
    }
    run cells.append(cell)
    at = at + 1
  }
  // Rows and row groups span grid rows; columns and column groups grid columns.
  let mut across = List<Part>.make()
  let mut down = List<Part>.make()
  at = 0
  while at < placedParts.length() {
    let placed = placedParts.get(at)
    if placed.rank == ROW || placed.rank == GROUP {
      let first = lineAt(&ys, placed.rect.yMin)
      let end = lineAt(&ys, placed.rect.yMax)
      if end > first { run across.append(Part { slot: placed.slot, rank: placed.rank, first: first, end: end }) }
    } else {
      let first = lineAt(&xs, placed.rect.xMin)
      let end = lineAt(&xs, placed.rect.xMax)
      if end > first { run down.append(Part { slot: placed.slot, rank: placed.rank, first: first, end: end }) }
    }
    at = at + 1
  }
  // Horizontal segments first: the vertical ones reach over their joints.
  let mut horizontal = List<Border>.make()
  run horizontal.appendRepeated(Border.none(), (rows + 1) * columns)
  let mut line: usize = 0
  while line <= rows {
    let mut column: usize = 0
    while column < columns {
      let mut above = NO_INDEX
      let mut below = NO_INDEX
      if line > 0 { above = occupied.get((line - 1) * columns + column) }
      if line < rows { below = occupied.get(line * columns + column) }
      // A cell split by a page or column break has no border on the break.
      let split = (above != NO_INDEX && cells.get(above).edges & BOTTOM == 0) || (below != NO_INDEX && cells.get(below).edges & TOP == 0)
      if (above == NO_INDEX || above != below) && !split {
        let mut best = Border.none()
        if above != NO_INDEX { consider(&mut best, nodes, cells.get(above).slot, BOTTOM, CELL) }
        if below != NO_INDEX { consider(&mut best, nodes, cells.get(below).slot, TOP, CELL) }
        at = 0
        while at < across.length() {
          let part = across.get(at)
          if part.end == line && part.first < line { consider(&mut best, nodes, part.slot, BOTTOM, part.rank) }
          if part.first == line && part.end > line { consider(&mut best, nodes, part.slot, TOP, part.rank) }
          at = at + 1
        }
        if line == 0 || line == rows {
          let bit = if line == 0 { TOP } else { BOTTOM }
          at = 0
          while at < down.length() {
            let part = down.get(at)
            if part.first <= column && column < part.end { consider(&mut best, nodes, part.slot, bit, part.rank) }
            at = at + 1
          }
          // A fragment the table continues past (or from) has no table edge there.
          if edges & bit != 0 { consider(&mut best, nodes, table, bit, TABLE) }
        }
        if !best.hidden { horizontal.set(line * columns + column, best) }
      }
      column = column + 1
    }
    line = line + 1
  }
  line = 0
  while line <= columns {
    let mut row: usize = 0
    while row < rows {
      let mut before = NO_INDEX
      let mut after = NO_INDEX
      if line > 0 { before = occupied.get(row * columns + line - 1) }
      if line < columns { after = occupied.get(row * columns + line) }
      if before == NO_INDEX || before != after {
        let mut best = Border.none()
        if before != NO_INDEX { consider(&mut best, nodes, cells.get(before).slot, RIGHT, CELL) }
        if after != NO_INDEX { consider(&mut best, nodes, cells.get(after).slot, LEFT, CELL) }
        if line == 0 || line == columns {
          let bit = if line == 0 { LEFT } else { RIGHT }
          at = 0
          while at < across.length() {
            let part = across.get(at)
            if part.first <= row && row < part.end { consider(&mut best, nodes, part.slot, bit, part.rank) }
            at = at + 1
          }
        }
        at = 0
        while at < down.length() {
          let part = down.get(at)
          if part.end == line { consider(&mut best, nodes, part.slot, RIGHT, part.rank) }
          if part.first == line { consider(&mut best, nodes, part.slot, LEFT, part.rank) }
          at = at + 1
        }
        if line == 0 { consider(&mut best, nodes, table, LEFT, TABLE) }
        if line == columns { consider(&mut best, nodes, table, RIGHT, TABLE) }
        if !best.hidden {
          let width = deviceWidth(best.width, scale)
          // Over the joints, as far as the widest horizontal segment there reaches.
          let mut top: f32 = 0.0
          let mut bottom: f32 = 0.0
          if line > 0 {
            top = f32.max(top, horizontal.get(row * columns + line - 1).width)
            bottom = f32.max(bottom, horizontal.get((row + 1) * columns + line - 1).width)
          }
          if line < columns {
            top = f32.max(top, horizontal.get(row * columns + line).width)
            bottom = f32.max(bottom, horizontal.get((row + 1) * columns + line).width)
          }
          let start = ys.get(row) * scale - deviceWidth(top, scale) / 2.0
          let end = ys.get(row + 1) * scale + deviceWidth(bottom, scale) / 2.0
          run band(&mut scene, mask, &best, xs.get(line) * scale, start, end, width, true)
        }
      }
      row = row + 1
    }
    line = line + 1
  }
  line = 0
  while line <= rows {
    let mut column: usize = 0
    while column < columns {
      let border = horizontal.get(line * columns + column)
      if border.width > 0.0 {
        run band(&mut scene, mask, &border, ys.get(line) * scale, xs.get(column) * scale, xs.get(column + 1) * scale, deviceWidth(border.width, scale), false)
      }
      column = column + 1
    }
    line = line + 1
  }
}

/// Whether a box with computed style `c` leaves its border to its table's collapsed borders.
pub fn collapsedPart(c: &Computed) -> bool {
  if c.layout.borderCollapse != BorderCollapse.Collapse { return false }
  let display = c.layout.display
  return display.insideIs(DisplayInside.Table) || display.insideIs(DisplayInside.TableCell) || display.insideIs(DisplayInside.TableRow)
    || display.insideIs(DisplayInside.TableRowGroup) || display.insideIs(DisplayInside.TableHeaderGroup) || display.insideIs(DisplayInside.TableFooterGroup)
    || display.insideIs(DisplayInside.TableColumn) || display.insideIs(DisplayInside.TableColumnGroup)
}
