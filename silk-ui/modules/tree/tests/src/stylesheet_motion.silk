import ui_fixtures.fixtures as fixtures
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, Event, EventKind, LISTEN_ALL }
import ui_tree.lib { RootOptions }
import font_collection.lib { FontCollection }
import svg_css.compile { Options, CompileError }
import svg_css.compile
import svg_css.tokens { CssError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import svg_css.effect_values { Filter, FilterKind }
import silk.core.option { Option }
import silk.num.f32
import silk.num.f64
import silk.num.i64

fn at(time: f64) -> FrameInput { return FrameInput { width: 800.0, height: 300.0, scale: 1.0, time: time } }
fn near(a: f32, b: f32) -> bool { return a - b < 0.001 && b - a < 0.001 }
fn opacity(tree: &UiTree<'_>, id: u32) -> f32 { return tree.node(tree.slotOf(id)).computed().paint.opacity }
fn width(tree: &UiTree<'_>, id: u32) -> f32 { return tree.node(tree.slotOf(id)).computed().layout.width.value }
fn height(tree: &UiTree<'_>, id: u32) -> f32 { return tree.node(tree.slotOf(id)).computed().layout.height.value }

effect fn sheet(source: &[u8]) -> Bytes
  ! CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let compiled = run compile.compile(source, &Options.make())
  return run compiled.encode()
}

effect fn nodes(batch: &mut Batch) -> () ! OutOfMemoryError ? &mut Allocator {
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("subject") })
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("subject second important") })
}

effect fn variablesAndReplacement() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run nodes(&mut batch)
  run batch.listen(2, LISTEN_ALL)
  let bytes = run sheet(b".subject{--from:.2;--to:.8;animation:fade 1s linear forwards}.second{--from:.1;--to:.5}.changed{--to:.4}@keyframes fade{from{opacity:var(--from)}to{opacity:var(--to)}}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  run Testing.expect(near(opacity(&tree, 2), 0.2) && near(opacity(&tree, 3), 0.1), "each node resolves keyframe variables in its own scope")
  run tree.frame(at(0.5))
  run Testing.expect(near(opacity(&tree, 2), 0.5) && near(opacity(&tree, 3), 0.3), "compiled keyframes interpolate with the shared frame clock")
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("subject changed") })
  run tree.apply(run batch.take())
  run tree.frame(at(0.75))
  run Testing.expect(near(opacity(&tree, 2), 0.35), "variable changes update keyframes without restarting their timeline")
  let replacement = run sheet(b".subject{--to:.8;animation:fade 1s linear forwards}.second{--to:.5}.changed{--to:.4}@keyframes fade{from{opacity:0}to{opacity:var(--to)}}")
  run batch.replaceStyleSheet(0, 1, replacement.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(at(0.75))
  run Testing.expect(near(opacity(&tree, 2), 0.3), "replacing a sheet uses its new frames at the existing animation time")
  let mut events = List<Event>.make()
  run tree.takeEvents(&mut events)
  events.clear()
  run batch.removeStyleSheet(0, 1)
  run tree.apply(run batch.take())
  run tree.frame(at(0.8))
  run Testing.expect(near(opacity(&tree, 2), 1.0), "removing the sheet restores the underlying style")
  run tree.takeEvents(&mut events)
  let mut cancelled = false
  let mut i: usize = 0
  while i < events.length() {
    let event = &events.asSlice()[i]
    if event.kind == EventKind.AnimationCancel && String.view(&event.name) == "fade" { cancelled = true }
    i = i + 1
  }
  run Testing.expect(cancelled, "animation cancellation retains the name after its stylesheet definition is removed")
}

test effect fn stylesheetKeyframesSubstitutePerNodeAndSurviveReplacement() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run variablesAndReplacement() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn roots() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.openRoot(1, 2, RootOptions.default())
  let first = run sheet(b"div{animation:fade 1s linear forwards}@keyframes fade{from{opacity:0}to{opacity:1}}")
  let second = run sheet(b"div{animation:fade 1s linear forwards}@keyframes fade{from{opacity:.2}to{opacity:.4}}")
  run batch.adoptStyleSheet(0, 1, first.asSlice())
  run batch.adoptStyleSheet(1, 1, second.asSlice())
  run tree.apply(run batch.take())
  run tree.frameRoot(0, at(0.0))
  run tree.frameRoot(1, at(0.0))
  run tree.frameRoot(0, at(0.5))
  run tree.frameRoot(1, at(0.5))
  run Testing.expect(near(opacity(&tree, 1), 0.5) && near(opacity(&tree, 2), 0.3), "equal keyframe names and sheet ids remain scoped to their roots")
}

test effect fn stylesheetKeyframesAreRootScoped() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run roots() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cascadeAndOffsets() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run nodes(&mut batch)
  let bytes = run sheet(b"@layer early,late;@layer early{@keyframes move{from{width:10px}to{width:210px}}}@layer late{@keyframes move{from{width:10px;opacity:0;animation-timing-function:steps(2,end)}from{height:10px;opacity:.2}to{width:210px}to{width:110px;height:50px;opacity:1}}}.subject{height:1px;animation:move 1s linear forwards}.important{width:80px!important;opacity:.7!important}@media(width>1000px){@keyframes move{from{width:30px}to{width:130px}}}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  run tree.frame(at(0.25))
  run Testing.expect(near(width(&tree, 2), 10.0) && near(height(&tree, 2), 20.0) && near(opacity(&tree, 2), 0.4), "duplicate offsets keep the easing of the block that last declares each property")
  run tree.frame(at(0.5))
  run Testing.expect(near(width(&tree, 2), 60.0) && near(height(&tree, 2), 30.0) && near(opacity(&tree, 2), 0.6), "the winning layer provides the complete merged keyframes")
  run Testing.expect(near(width(&tree, 3), 80.0) && near(opacity(&tree, 3), 0.7) && near(height(&tree, 3), 30.0), "important declarations override animation values without suppressing other fields")
  run tree.frame(FrameInput { width: 1200.0, height: 300.0, scale: 1.0, time: 0.5 })
  run Testing.expect(near(width(&tree, 2), 80.0), "a newly eligible unlayered definition replaces the layered frames without restarting")
}

test effect fn stylesheetKeyframesFollowLayersMediaDuplicateOffsetsAndImportance() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cascadeAndOffsets() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn names() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run nodes(&mut batch)
  let bytes = run sheet(b".subject{animation:\"fade,one\" 1s linear forwards,f\\61 de 1s linear forwards}@keyframes \"fade,one\"{from{opacity:0}to{opacity:1}}@keyframes f\\61 de{from{width:10px}to{width:110px}}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  run tree.frame(at(0.5))
  run Testing.expect(near(opacity(&tree, 2), 0.5) && near(width(&tree, 2), 60.0), "quoted commas and CSS escapes name independent animations")
}

test effect fn stylesheetKeyframesAcceptQuotedAndEscapedNames() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run names() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.css
import ui_tree.css { Property, px }
import ui_tree.legacy { StyleState, Input }

effect fn longTransitions(repeated: bool) -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run nodes(&mut batch)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("parent") })
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("inline") })
  let properties = b"width, color, background-color, border-color, outline-color, text-decoration-color, box-shadow, fill, stroke, opacity, width, height"
  let durations = if repeated { b"1s, 2s" } else { b"9s, 9s, 9s, 9s, 9s, 9s, 9s, 9s, 9s, 1s, 2s, 4s" }
  let mut source = String.make()
  run source.append(".parent{transition-property:")
  run source.append(unsafe String.fromUtf8Unchecked(properties))
  run source.append(";transition-duration:")
  run source.append(unsafe String.fromUtf8Unchecked(durations))
  run source.append(";transition-timing-function:linear}.subject{width:10px;height:10px;opacity:1;transition-property:inherit;transition-duration:inherit;transition-timing-function:inherit}.changed{width:110px;height:110px;opacity:0}")
  let bytes = run sheet(source.ownedUtf8Bytes())
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run batch.style(3, &[
    css.width(px(10.0)), css.height(px(10.0)), css.opacity(1.0),
    css.declare(Property.TransitionProperty, run css.text(properties)),
    css.declare(Property.TransitionDuration, run css.text(durations)),
    css.declare(Property.TransitionTimingFunction, run css.text(b"linear")),
  ])
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("subject changed") })
  run batch.style(3, &[css.width(px(110.0)), css.height(px(110.0)), css.opacity(0.0)])
  run tree.apply(run batch.take())
  run tree.frame(at(10.0))
  run tree.frame(at(10.5))
  let mut id: u32 = 2
  while id <= 3 {
    run Testing.expect(near(width(&tree, id), if repeated { 60.0 } else { 35.0 }), "the final property match beyond eight entries selects its duration in sheets, inheritance and inline styles")
    run Testing.expect(near(height(&tree, id), if repeated { 35.0 } else { 22.5 }), "long duration lists retain their last entries and short lists repeat")
    run Testing.expect(near(opacity(&tree, id), if repeated { 0.75 } else { 0.5 }), "opacity late in a utility transition list still transitions")
    id = id + 1
  }
}

test effect fn stylesheetTransitionListsKeepAllEntriesAndRepeatShortLists() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run longTransitions(false) |> Effect.provideMut<Allocator>(&mut allocator)
  run longTransitions(true) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn invalidTransitionTail() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.box(1, 2, &[
    css.width(px(100.0)), css.height(px(100.0)), css.opacity(1.0),
    css.declare(Property.Transition, run css.text(b"color 1s,background-color 1s,border-color 1s,outline-color 1s,text-decoration-color 1s,box-shadow 1s,fill 1s,stroke 1s,opacity 2s linear")),
  ])
  run batch.styleFor(2, StyleState.Hover, &[
    css.opacity(0.0),
    css.declare(Property.TransitionDuration, run css.text(b"1s,1s,1s,1s,1s,1s,1s,1s,-1s")),
  ])
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  run tree.dispatch(Input.PointerMove { x: 10.0, y: 10.0, modifiers: 0 })
  run tree.frame(at(1.0))
  run tree.frame(at(1.5))
  run Testing.expect(near(opacity(&tree, 2), 0.75), "a long shorthand reaches opacity, and an invalid trailing duration does not replace the valid base list")
}

test effect fn stylesheetTransitionListsRejectInvalidTrailingEntries() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run invalidTransitionTail() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn longAnimations() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run nodes(&mut batch)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("parent") })
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("inline") })
  let bytes = run sheet(b".parent{animation-name:a,b,c,d,e,f,g,h,fade,grow;animation-duration:9s,9s,9s,9s,9s,9s,9s,9s,1s,2s;animation-timing-function:linear;animation-fill-mode:forwards}.subject{animation-name:inherit;animation-duration:inherit;animation-timing-function:inherit;animation-fill-mode:inherit}@keyframes fade{from{opacity:0}to{opacity:1}}@keyframes grow{from{width:10px}to{width:110px}}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run batch.style(3, &[
    css.declare(Property.Animation, run css.text(b"a 9s,b 9s,c 9s,d 9s,e 9s,f 9s,g 9s,h 9s,fade 1s linear forwards,grow 2s linear forwards")),
  ])
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  run tree.frame(at(0.5))
  let mut id: u32 = 1
  while id <= 3 {
    run Testing.expect(near(width(&tree, id), 35.0) && near(opacity(&tree, id), 0.5), "animation names and durations beyond eight entries work through sheets, inheritance, and inline shorthand")
    id = id + 1
  }
}

test effect fn stylesheetAnimationListsKeepAllEntries() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run longAnimations() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.legacy { BUTTON_PRIMARY, Mutation }

effect fn pointerSheetStates() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("parent") })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("subject") })
  run batch.attribute(2, Attribute.TabIndex { value: 0 })
  let bytes = run sheet(b".parent{width:200px;height:200px}.subject{width:100px;height:100px}.subject:hover{opacity:.5}.parent:hover{width:150px}.subject:active{width:80px}.parent:active{height:150px}.subject:focus{height:80px}.parent:focus-within{opacity:.8}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  run tree.dispatch(Input.PointerMove { x: 20.0, y: 20.0, modifiers: 0 })
  run Testing.expect(tree.needsFrame(), "stylesheet-only hover requests a frame without an inline hover look")
  run tree.frame(at(0.1))
  run Testing.expect(near(opacity(&tree, 2), 0.5) && near(width(&tree, 1), 150.0), "pointer hover updates the target and its ancestors")
  run tree.dispatch(Input.PointerDown { x: 20.0, y: 20.0, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 })
  run tree.frame(at(0.2))
  run Testing.expect(near(width(&tree, 2), 80.0) && near(height(&tree, 1), 150.0), "pointer press applies stylesheet-only active rules throughout the press chain")
  run Testing.expect(near(height(&tree, 2), 80.0) && near(opacity(&tree, 1), 0.8), "pointer focus updates focus and focus-within selectors")
  run tree.dispatch(Input.PointerUp { x: 20.0, y: 20.0, button: BUTTON_PRIMARY, modifiers: 0 })
  run tree.frame(at(0.3))
  run Testing.expect(near(width(&tree, 2), 100.0) && near(height(&tree, 1), 200.0), "release removes active rules without requiring an inline active look")
  run tree.dispatch(Input.PointerLeave)
  run tree.frame(at(0.4))
  run Testing.expect(near(opacity(&tree, 2), 1.0) && near(width(&tree, 1), 200.0), "pointer leave removes stylesheet-only hover rules")
}

effect fn pointerReach() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("page") })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("group") })
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("tip") })
  run batch.create(4, NodeKind.Box)
  run batch.append(1, 4)
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("card") })
  let mut leaf: u32 = 10
  while leaf < 30 {
    run batch.create(leaf, NodeKind.Box)
    run batch.append(4, leaf)
    run batch.attribute(leaf, Attribute.ClassName { value: run String.copy("leaf") })
    leaf = leaf + 1
  }
  let bytes = run sheet(b".page{width:400px;height:300px}.group{height:100px}.tip{height:10px}.group:hover .tip{opacity:.5}.card{height:100px}.leaf{height:5px}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  let before = tree.work.resolves
  run tree.dispatch(Input.PointerMove { x: 20.0, y: 150.0, modifiers: 0 })
  run tree.dispatch(Input.PointerDown { x: 20.0, y: 150.0, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 })
  run tree.frame(at(0.1))
  run tree.dispatch(Input.PointerUp { x: 20.0, y: 150.0, button: BUTTON_PRIMARY, modifiers: 0 })
  run tree.frame(at(0.2))
  run Testing.expect(tree.work.resolves - before <= 6, "hover and a press on a leaf restyle only the press chain, not the page under it")
  let unhovered = tree.work.resolves
  run tree.dispatch(Input.PointerMove { x: 20.0, y: 50.0, modifiers: 0 })
  run tree.frame(at(0.3))
  run Testing.expect(near(opacity(&tree, 3), 0.5), "an ancestor whose hover a rule asks about restyles the subjects of that rule below it")
  run Testing.expect(tree.work.resolves - unhovered == 2, "and no other descendant: the leaf beside the subject keeps its style")
  let hovered = tree.work.resolves
  run tree.dispatch(Input.PointerLeave)
  run tree.frame(at(0.4))
  run Testing.expect(near(opacity(&tree, 3), 1.0), "and again when the hover ends")
  run Testing.expect(tree.work.resolves - hovered == 2, "with the subject and itself alone")
}

effect fn hasAnchorReach() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("page") })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("group") })
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("tip") })
  run batch.create(5, NodeKind.Box)
  run batch.append(2, 5)
  run batch.attribute(5, Attribute.ClassName { value: run String.copy("leaf") })
  run batch.create(4, NodeKind.Box)
  run batch.append(1, 4)
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("card") })
  let mut leaf: u32 = 10
  while leaf < 30 {
    run batch.create(leaf, NodeKind.Box)
    run batch.append(4, leaf)
    run batch.attribute(leaf, Attribute.ClassName { value: run String.copy("leaf") })
    leaf = leaf + 1
  }
  let bytes = run sheet(b".page{width:400px;height:300px}.card{height:100px}.card:has(.on){opacity:.5}.group:has(.on) .tip{opacity:.25}.leaf{height:2px}.tip{height:2px}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  let before = tree.work.resolves
  let mut on = Batch.make()
  run on.attribute(12, Attribute.ClassName { value: run String.copy("leaf on") })
  run tree.apply(run on.take())
  run tree.frame(at(0.1))
  run Testing.expect(near(opacity(&tree, 4), 0.5), "the card's :has() sees the class")
  run Testing.expect(tree.work.resolves - before <= 4, "a :has() anchor only its own match asked restyles itself, not its subtree")
  let mut grouped = Batch.make()
  run grouped.attribute(5, Attribute.ClassName { value: run String.copy("leaf on") })
  run tree.apply(run grouped.take())
  run tree.frame(at(0.2))
  run Testing.expect(near(opacity(&tree, 3), 0.25), "an anchor another match asked restyles what reads it")
  let mut more = Batch.make()
  let mut extra: u32 = 40
  while extra < 50 {
    run more.create(extra, NodeKind.Box)
    run more.append(2, extra)
    run more.attribute(extra, Attribute.ClassName { value: run String.copy("leaf") })
    extra = extra + 1
  }
  run tree.apply(run more.take())
  run tree.frame(at(0.3))
  let crowded = tree.work.resolves
  let mut off = Batch.make()
  run off.attribute(5, Attribute.ClassName { value: run String.copy("leaf") })
  run tree.apply(run off.take())
  run tree.frame(at(0.4))
  run Testing.expect(near(opacity(&tree, 3), 1.0), "and again when its :has() stops matching")
  run Testing.expect(tree.work.resolves - crowded <= 3, "that is the anchor, the changed node and the node whose match read the anchor, not the leaves beside it")
}

/// A blinking caret repaints when its phase changes, not on every frame between.
effect fn caretFrames() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Input)
  run batch.append(1, 2)
  run batch.push(Mutation.Focus { id: 2 })
  run tree.apply(run batch.take())
  run tree.frame(at(0.0))
  run tree.frame(at(0.05))
  let kept = tree.paintsKept
  run tree.frame(at(0.1))
  run tree.frame(at(0.2))
  run tree.frame(at(0.4))
  run Testing.expect(tree.paintsKept == kept + 3, "frames within one blink phase of the caret keep the last scene")
  run tree.frame(at(0.6))
  run Testing.expect(tree.paintsKept == kept + 3, "the frame where the caret goes off paints")
  run tree.frame(at(0.7))
  run tree.frame(at(0.9))
  run Testing.expect(tree.paintsKept == kept + 5, "and the frames after it keep that scene")
  run tree.frame(at(1.1))
  run Testing.expect(tree.paintsKept == kept + 5, "until the caret comes on again")
}

