@deferredCallbacks("cb")
pub unsafe export "C" fn uv_fs_scandir(loop: ?*mut u8, req: ?*mut u8, path: ?*const u8, flags: i32, cb: FsCallback) -> i32 {
  unsafe {
    let status = pathRequest(loop, req, FS_SCANDIR, path, cb)
    if status != 0 { return status }
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, setFields(req)) r.flags = flags drop r
    return post(loop, req, cb)
  }
}
// uv_fs_readdir and uv_fs_closedir work on the caller's uv_dir_t, kept in `ptr`.
@deferredCallbacks("cb")
pub unsafe export "C" fn uv_fs_readdir(loop: ?*mut u8, req: ?*mut u8, dir: ?*mut u8, cb: FsCallback) -> i32 {
  unsafe {
    if !initRequest(loop, req, FS_READDIR, cb) { return -EINVAL }
    if Pointer.isNull<u8>(dir) { return -EINVAL }
    let anchor = () let d = Pointer.borrow<(), Dir>(&anchor, dirOf(dir))
    let usable = !Pointer.isNull<u8>(d.dir) && !Pointer.isNull<Dirent>(d.dirents)
    drop d
    if !usable { return -EINVAL }
    let mut second = () let r = Pointer.borrowMut<(), FsReq>(&mut second, setFields(req)) r.ptr = dir drop r
    return post(loop, req, cb)
  }
}
@deferredCallbacks("cb")
pub unsafe export "C" fn uv_fs_closedir(loop: ?*mut u8, req: ?*mut u8, dir: ?*mut u8, cb: FsCallback) -> i32 {
  unsafe {
    if !initRequest(loop, req, FS_CLOSEDIR, cb) { return -EINVAL }
    if Pointer.isNull<u8>(dir) { return -EINVAL }
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, setFields(req)) r.ptr = dir drop r
    return post(loop, req, cb)
  }
}
@deferredCallbacks("cb")
pub unsafe export "C" fn uv_fs_sendfile(loop: ?*mut u8, req: ?*mut u8, outFd: i32, inFd: i32, off: i64, length: usize, cb: FsCallback) -> i32 {
  return unsafe fsSendfile(loop, req, outFd, inFd, off, length, cb)
}

// uv__fs_scandir_cleanup: the entries not yet handed out, then the array (both from scandir(3)).
unsafe fn scandirCleanup(q: *mut FsReq) -> () {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let entries = r.ptr
    if r.result >= 0 {
      let list = Pointer.assumeManyMut<?*mut u8>(Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(nnMut<u8>(entries)))
      let mut index: u32 = 0
      if r.nbufs > 0 { index = r.nbufs - 1 }
      let count = isize.wrappingToU32(r.result)
      while index < count { free(Pointer.read<?*mut u8>(Pointer.atMut<?*mut u8>(list, u32.toUsize(index)))) index = index + 1 }
    }
    free(entries)
    r.ptr = Pointer.null<u8>()
  }
}
// uv__fs_readdir_cleanup: the names that readdir copied.
unsafe fn readdirCleanup(q: *mut FsReq) -> () {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    if Pointer.isNull<u8>(r.ptr) { return }
    let dir = dirOf(r.ptr)
    r.ptr = Pointer.null<u8>()
    let count = r.result
    drop r
    let second = () let d = Pointer.borrow<(), Dir>(&second, dir)
    let dirents = d.dirents
    drop d
    if Pointer.isNull<Dirent>(dirents) { return }
    let entries = Pointer.assumeManyMut<Dirent>(nnMut<Dirent>(dirents))
    let mut index: isize = 0
    while index < count {
      let slot = Pointer.atMut<Dirent>(entries, isize.toUsize(index))
      let entry = Pointer.read<Dirent>(slot)
      release(Intrinsic.pointerRequalify<?*const u8, ?*mut u8>(entry.name))
      Pointer.write<Dirent>(slot, Dirent { name: Pointer.null<u8>(), kind: entry.kind, padding: entry.padding })
      index = index + 1
    }
  }
}
/// libuv's uv_fs_req_cleanup: frees what the request owns (the copied paths, the bufs copy, scandir's
/// entries, readdir's names, and the result in `ptr` except opendir's uv_dir_t and `statbuf`).
pub export "C" fn uv_fs_req_cleanup(req: ?*mut u8) -> () {
  unsafe {
    if Pointer.isNull<u8>(req) { return }
    let q = fsOf(nnMut<u8>(req))
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    // A synchronous request's paths are the caller's, except mkdtemp's and mkstemp's.
    if !Pointer.isNull<u8>(r.path) && (isAsync(r.cb) || r.fsType == FS_MKDTEMP || r.fsType == FS_MKSTEMP) {
      release(Intrinsic.pointerRequalify<?*const u8, ?*mut u8>(r.path))
    }
    r.path = Pointer.null<u8>() r.newPath = Pointer.null<u8>()
    let kind = r.fsType let hasPtr = !Pointer.isNull<u8>(r.ptr)
    drop r
    if kind == FS_READDIR && hasPtr { readdirCleanup(q) }
    let r1 = Pointer.borrowMut<(), FsReq>(&mut anchor, q) let hasPtr2 = !Pointer.isNull<u8>(r1.ptr) drop r1
    if kind == FS_SCANDIR && hasPtr2 { scandirCleanup(q) }
    let r2 = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let small = Pointer.fromMutRef<Buf>(&mut r2.bufsml[0])
    if Pointer.address<Buf>(r2.bufs) != Pointer.address<Buf>(small) {
      release(Intrinsic.pointerReinterpret<?*mut Buf, ?*mut u8>(r2.bufs))
    }
    r2.bufs = Pointer.null<Buf>()
    let statbuf = Pointer.address<UvStat>(Pointer.fromMutRef<UvStat>(&mut r2.statbuf))
    if kind != FS_OPENDIR && Pointer.address<u8>(r2.ptr) != statbuf { release(r2.ptr) }
    r2.ptr = Pointer.null<u8>()
  }
}
/// libuv's uv_fs_scandir_next: the next entry of a scandir request, then UV_EOF.
pub export "C" fn uv_fs_scandir_next(req: *mut u8, ent: *mut u8) -> i32 {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, fsOf(req))
    if r.result < 0 { return isize.wrappingToI32(r.result) }
    // Null when the request was cancelled or found nothing.
    if Pointer.isNull<u8>(r.ptr) { return UV_EOF }
    let list = Pointer.assumeManyMut<?*mut u8>(Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(nnMut<u8>(r.ptr)))
    if r.nbufs > 0 { free(Pointer.read<?*mut u8>(Pointer.atMut<?*mut u8>(list, u32.toUsize(r.nbufs - 1)))) }
    if r.nbufs == isize.wrappingToU32(r.result) {
      free(r.ptr)
      r.ptr = Pointer.null<u8>()
      return UV_EOF
    }
    let entry = nn<u8>(Pointer.read<?*mut u8>(Pointer.atMut<?*mut u8>(list, u32.toUsize(r.nbufs))))
    r.nbufs = r.nbufs + 1
    drop r
    Pointer.write<Dirent>(Intrinsic.pointerReinterpret<*mut u8, *mut Dirent>(ent), Dirent { name: constAt(entry, D_NAME), kind: direntType(entry), padding: 0 })
    return 0
  }
}
// The accessors of uv-data-getter-setters.c.
pub export "C" fn uv_fs_get_type(req: *const u8) -> i32 {
  let anchor = () let r = unsafe Pointer.borrow<(), FsReq>(&anchor, unsafe Intrinsic.pointerReinterpret<*const u8, *const FsReq>(req))
  return r.fsType
}
pub export "C" fn uv_fs_get_result(req: *const u8) -> isize {
  let anchor = () let r = unsafe Pointer.borrow<(), FsReq>(&anchor, unsafe Intrinsic.pointerReinterpret<*const u8, *const FsReq>(req))
  return r.result
}
pub export "C" fn uv_fs_get_ptr(req: *const u8) -> ?*mut u8 {
  let anchor = () let r = unsafe Pointer.borrow<(), FsReq>(&anchor, unsafe Intrinsic.pointerReinterpret<*const u8, *const FsReq>(req))
  return r.ptr
}
pub export "C" fn uv_fs_get_path(req: *const u8) -> ?*const u8 {
  let anchor = () let r = unsafe Pointer.borrow<(), FsReq>(&anchor, unsafe Intrinsic.pointerReinterpret<*const u8, *const FsReq>(req))
  return r.path
}
pub export "C" fn uv_fs_get_statbuf(req: *mut u8) -> *mut u8 {
  let mut anchor = () let r = unsafe Pointer.borrowMut<(), FsReq>(&mut anchor, unsafe fsOf(req))
  return unsafe Intrinsic.pointerReinterpret<*mut UvStat, *mut u8>(Pointer.fromMutRef<UvStat>(&mut r.statbuf))
}
/// libuv's uv_fs_get_system_error on Unix: the errno of a failed request.
pub export "C" fn uv_fs_get_system_error(req: *const u8) -> i32 {
  let anchor = () let r = unsafe Pointer.borrow<(), FsReq>(&anchor, unsafe Intrinsic.pointerReinterpret<*const u8, *const FsReq>(req))
  return isize.wrappingToI32(isize.wrappingNegate(r.result))
}

// ---- uv_queue_work and uv_cancel --------------------------------------------------------------
export "C" fn silkUvApiQueueWork(unit: *mut Work) -> () {
  unsafe {
    let bytes = containerOf(unit, WORK_WORK)
    let anchor = () let r = Pointer.borrow<(), WorkReq>(&anchor, Intrinsic.pointerReinterpret<*mut u8, *mut WorkReq>(bytes))
    let callback = Intrinsic.pointerRequalify<WorkCallback, extern "C" fn(*mut u8) -> ()>(r.workCb)
    drop r
    callback(bytes)
  }
}
export "C" fn silkUvApiQueueDone(unit: *mut Work, status: i32) -> () {
  unsafe {
    let bytes = containerOf(unit, WORK_WORK)
    let anchor = () let r = Pointer.borrow<(), WorkReq>(&anchor, Intrinsic.pointerReinterpret<*mut u8, *mut WorkReq>(bytes))
    uvl.requestFinished(loopMemory(r.loop))
    let callback = r.afterWorkCb
    drop r
    if Intrinsic.pointerIsNull<AfterWorkCallback>(callback) { return }
    let present = Intrinsic.pointerRequalify<AfterWorkCallback, extern "C" fn(*mut u8, i32) -> ()>(callback)
    present(bytes, status)
  }
}
/// libuv's uv_queue_work: `work_cb(req)` on the pool as CPU work, then `after_work_cb(req, status)`
/// on the loop's thread.
@threadCallbacks("workCb")
@deferredCallbacks("afterWorkCb")
pub unsafe export "C" fn uv_queue_work(loop: ?*mut u8, req: *mut u8, workCb: WorkCallback, afterWorkCb: AfterWorkCallback) -> i32 {
  unsafe {
    if Intrinsic.pointerIsNull<WorkCallback>(workCb) { return -EINVAL }
    let memory = loopMemory(loop)
    let mut anchor = () let r = Pointer.borrowMut<(), WorkReq>(&mut anchor, Intrinsic.pointerReinterpret<*mut u8, *mut WorkReq>(req))
    r.kind = UV_WORK
    uvl.requestStarted(memory)
    r.loop = loop r.workCb = workCb r.afterWorkCb = afterWorkCb
    let unit = Pointer.fromMutRef<Work>(&mut r.work)
    drop r
    uvl.workSubmit(memory, unit, uvl.WORK_CPU, silkUvApiQueueWork, silkUvApiQueueDone)
    return 0
  }
}
/// libuv's uv_cancel: a thread-pool request that has not started finishes with UV_ECANCELED;
/// UV_EBUSY once it runs or ran, UV_EINVAL for other request types.
pub export "C" fn uv_cancel(req: *mut u8) -> i32 {
  unsafe {
    let kind = Pointer.read<i32>(Intrinsic.pointerReinterpret<*mut u8, *mut i32>(byteAt(req, 8)))
    let mut loopOffset: usize = 64
    let mut workOffset: usize = 0
    if kind == UV_FS { loopOffset = 72 workOffset = FS_WORK }
    else { if kind == UV_GETADDRINFO { workOffset = ADDRINFO_WORK }
    else { if kind == UV_GETNAMEINFO { workOffset = NAMEINFO_WORK }
    else { if kind == UV_RANDOM { workOffset = RANDOM_WORK }
    else { if kind == UV_WORK { workOffset = WORK_WORK }
    else { return -EINVAL } } } } }
    let loop = Pointer.read<?*mut u8>(Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(byteAt(req, loopOffset)))
    let unit = Intrinsic.pointerReinterpret<*mut u8, *mut Work>(byteAt(req, workOffset))
    return uvl.workCancel(loopMemory(loop), unit)
  }
}

// ---- uv_random --------------------------------------------------------------------------------
// libuv's uv__random: nothing to fill succeeds without touching `buffer`, which may then be null.
unsafe fn randomFill(buffer: ?*mut u8, length: usize) -> i32 {
  if length == 0 { return 0 }
  return unsafe sys.randomFill(unsafe nnMut<u8>(buffer), length)
}
export "C" fn silkUvApiRandomWork(unit: *mut Work) -> () {
  unsafe {
    let bytes = containerOf(unit, RANDOM_WORK)
    let mut anchor = () let r = Pointer.borrowMut<(), RandomReq>(&mut anchor, Intrinsic.pointerReinterpret<*mut u8, *mut RandomReq>(bytes))
    let buffer = r.buf let length = r.buflen
    drop r
    let status = randomFill(buffer, length)
    let r2 = Pointer.borrowMut<(), RandomReq>(&mut anchor, Intrinsic.pointerReinterpret<*mut u8, *mut RandomReq>(bytes))
    r2.status = status
  }
}
export "C" fn silkUvApiRandomDone(unit: *mut Work, status: i32) -> () {
  unsafe {
    let bytes = containerOf(unit, RANDOM_WORK)
    let anchor = () let r = Pointer.borrow<(), RandomReq>(&anchor, Intrinsic.pointerReinterpret<*mut u8, *mut RandomReq>(bytes))
    uvl.requestFinished(loopMemory(r.loop))
    let mut result = status
    if result == 0 { result = r.status }
    let callback = Intrinsic.pointerRequalify<RandomCallback, extern "C" fn(*mut u8, i32, ?*mut u8, usize) -> ()>(r.cb)
    let buffer = r.buf let length = r.buflen
    drop r
    callback(bytes, result, buffer, length)
  }
}
/// libuv's uv_random: `buflen` random bytes, synchronously without a callback, else as CPU work.
@deferredCallbacks("cb")
pub unsafe export "C" fn uv_random(loop: ?*mut u8, req: ?*mut u8, buf: ?*mut u8, buflen: usize, flags: u32, cb: RandomCallback) -> i32 {
  unsafe {
    if buflen > 2147483647 { return -E2BIG }
    if flags != 0 { return -EINVAL }
    if Intrinsic.pointerIsNull<RandomCallback>(cb) { return randomFill(buf, buflen) }
    let memory = loopMemory(loop)
    let mut anchor = () let r = Pointer.borrowMut<(), RandomReq>(&mut anchor, Intrinsic.pointerReinterpret<*mut u8, *mut RandomReq>(nnMut<u8>(req)))
    r.kind = UV_RANDOM
    uvl.requestStarted(memory)
    r.loop = loop r.status = 0 r.cb = cb r.buf = buf r.buflen = buflen
    let unit = Pointer.fromMutRef<Work>(&mut r.work)
    drop r
    uvl.workSubmit(memory, unit, uvl.WORK_CPU, silkUvApiRandomWork, silkUvApiRandomDone)
    return 0
  }
}

// ---- uv_getaddrinfo and uv_getnameinfo --------------------------------------------------------
// libuv's uv__getaddrinfo_translate_error; an unknown code aborts.
unsafe fn translateAddrinfoError(code: i32) -> i32 {
  if code == 0 { return 0 }
  if code == EAI_ADDRFAMILY { return UV_EAI_ADDRFAMILY }
  if code == EAI_AGAIN { return UV_EAI_AGAIN }
  if code == EAI_BADFLAGS { return UV_EAI_BADFLAGS }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    if code == EAI_BADHINTS { return UV_EAI_BADHINTS }
    if code == EAI_PROTOCOL { return UV_EAI_PROTOCOL }
  } else {
    if code == EAI_CANCELED { return UV_EAI_CANCELED }
  }
  if code == EAI_FAIL { return UV_EAI_FAIL }
  if code == EAI_FAMILY { return UV_EAI_FAMILY }
  if code == EAI_MEMORY { return UV_EAI_MEMORY }
  if code == EAI_NODATA { return UV_EAI_NODATA }
  if code == EAI_NONAME { return UV_EAI_NONAME }
  if code == EAI_OVERFLOW { return UV_EAI_OVERFLOW }
  if code == EAI_SERVICE { return UV_EAI_SERVICE }
  if code == EAI_SOCKTYPE { return UV_EAI_SOCKTYPE }
  if code == EAI_SYSTEM { return -(unsafe errno()) }
  unsafe abort()
  return 0
}
unsafe fn addrinfoOf(bytes: *mut u8) -> *mut AddrinfoReq { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut AddrinfoReq>(bytes) }
unsafe fn addrinfoWork(bytes: *mut u8) -> () {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), AddrinfoReq>(&mut anchor, addrinfoOf(bytes))
    let code = getaddrinfo(r.hostname, r.serviceText, r.hints, Pointer.fromMutRef<?*mut u8>(&mut r.addrinfo))
    r.retcode = translateAddrinfoError(code)
  }
}
unsafe fn addrinfoDone(bytes: *mut u8, status: i32) -> () {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), AddrinfoReq>(&mut anchor, addrinfoOf(bytes))
    uvl.requestFinished(loopMemory(r.loop))
    // The arguments' copy is one allocation, which starts at the first of them (uv_getaddrinfo).
    if !Pointer.isNull<u8>(r.hints) { release(r.hints) }
    else { if !Pointer.isNull<u8>(r.serviceText) { release(r.serviceText) } else { if !Pointer.isNull<u8>(r.hostname) { release(r.hostname) } } }
    r.hints = Pointer.null<u8>() r.serviceText = Pointer.null<u8>() r.hostname = Pointer.null<u8>()
    if status == -ECANCELED { r.retcode = UV_EAI_CANCELED }
    let callback = r.cb let retcode = r.retcode let result = r.addrinfo
    drop r
    if !Intrinsic.pointerIsNull<AddrinfoCallback>(callback) {
      let present = Intrinsic.pointerRequalify<AddrinfoCallback, extern "C" fn(*mut u8, i32, ?*mut u8) -> ()>(callback)
      present(bytes, retcode, result)
    }
  }
}
export "C" fn silkUvApiAddrinfoWork(unit: *mut Work) -> () { unsafe addrinfoWork(unsafe containerOf(unit, ADDRINFO_WORK)) }
export "C" fn silkUvApiAddrinfoDone(unit: *mut Work, status: i32) -> () { unsafe addrinfoDone(unsafe containerOf(unit, ADDRINFO_WORK), status) }
/// libuv's uv_getaddrinfo: the hostname goes through IDNA (uv__idna_toascii) into 256 bytes, the
/// arguments are copied, and getaddrinfo(3) runs as slow I/O work (or here without a callback).
@deferredCallbacks("cb")
pub unsafe export "C" fn uv_getaddrinfo(loop: ?*mut u8, req: ?*mut u8, cb: AddrinfoCallback, hostname: ?*const u8, serviceText: ?*const u8, hints: ?*const u8) -> i32 {
  unsafe {
    if Pointer.isNull<u8>(req) || (Pointer.isNull<u8>(hostname) && Pointer.isNull<u8>(serviceText)) { return -EINVAL }
    let mut ascii: [u8; 256] = [0; 256]
    let mut host = hostname
    if !Pointer.isNull<u8>(hostname) {
      let source = nn<u8>(hostname)
      let rc = idnaToAscii(Pointer.assumeMany<u8>(source), strlen(source), Pointer.assumeManyMut<u8>(Pointer.fromMutRef<u8>(&mut ascii[0])), 256)
      if rc < 0 { return isize.wrappingToI32(rc) }
      host = Pointer.fromRef<u8>(&ascii[0])
    }
    let hostLength: usize = if Pointer.isNull<u8>(host) { 0 } else { strlen(nn<u8>(host)) + 1 }
    let serviceLength: usize = if Pointer.isNull<u8>(serviceText) { 0 } else { strlen(nn<u8>(serviceText)) + 1 }
    let hintsLength: usize = if Pointer.isNull<u8>(hints) { 0 } else { 48 }
    let buffer = allocate(hostLength + serviceLength + hintsLength)
    if Pointer.isNull<u8>(buffer) { return -ENOMEM }
    let bytes = nnMut<u8>(req)
    let memory = loopMemory(loop)
    let mut anchor = () let r = Pointer.borrowMut<(), AddrinfoReq>(&mut anchor, addrinfoOf(bytes))
    r.kind = UV_GETADDRINFO
    uvl.requestStarted(memory)
    r.loop = loop r.cb = cb r.addrinfo = Pointer.null<u8>() r.hints = Pointer.null<u8>() r.serviceText = Pointer.null<u8>() r.hostname = Pointer.null<u8>() r.retcode = 0
    // In this order: addrinfoDone frees the first.
    let start = nnMut<u8>(buffer)
    let mut length: usize = 0
    if !Pointer.isNull<u8>(hints) { let _a = memcpy(start, nn<u8>(hints), 48) r.hints = buffer length = 48 }
    if !Pointer.isNull<u8>(serviceText) { let at = byteAt(start, length) let _b = memcpy(at, nn<u8>(serviceText), serviceLength) r.serviceText = at length = length + serviceLength }
    if !Pointer.isNull<u8>(host) { let at = byteAt(start, length) let _c = memcpy(at, nn<u8>(host), hostLength) r.hostname = at }
    let unit = Pointer.fromMutRef<Work>(&mut r.work)
    drop r
    if !Intrinsic.pointerIsNull<AddrinfoCallback>(cb) {
      uvl.workSubmit(memory, unit, uvl.WORK_SLOW_IO, silkUvApiAddrinfoWork, silkUvApiAddrinfoDone)
      return 0
    }
    addrinfoWork(bytes)
    addrinfoDone(bytes, 0)
    let second = () let r2 = Pointer.borrow<(), AddrinfoReq>(&second, addrinfoOf(bytes))
    return r2.retcode
  }
}
/// libuv's uv_freeaddrinfo.
pub export "C" fn uv_freeaddrinfo(ai: ?*mut u8) -> () {
  if !Pointer.isNull<u8>(ai) { unsafe freeaddrinfo(unsafe nnMut<u8>(ai)) }
}
unsafe fn nameinfoOf(bytes: *mut u8) -> *mut NameinfoReq { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut NameinfoReq>(bytes) }
unsafe fn nameinfoWork(bytes: *mut u8) -> () {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), NameinfoReq>(&mut anchor, nameinfoOf(bytes))
    let address = Intrinsic.pointerReinterpret<*const u64, *const u8>(Pointer.fromRef<u64>(&r.storage[0]))
    let family = familyOf(address)
    let mut length: u32 = 0
    if family == AF_INET { length = 16 } else { if family == AF_INET6 { length = 28 } else { abort() } }
    let code = getnameinfo(address, length, Pointer.fromMutRef<u8>(&mut r.host[0]), 1025, Pointer.fromMutRef<u8>(&mut r.serviceText[0]), 32, r.flags)
    r.retcode = translateAddrinfoError(code)
  }
}
unsafe fn nameinfoDone(bytes: *mut u8, status: i32) -> () {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), NameinfoReq>(&mut anchor, nameinfoOf(bytes))
    uvl.requestFinished(loopMemory(r.loop))
    let mut host: ?*const u8 = Pointer.null<u8>()
    let mut serviceText: ?*const u8 = Pointer.null<u8>()
    if status == -ECANCELED { r.retcode = UV_EAI_CANCELED }
    else { if r.retcode == 0 { host = Pointer.fromRef<u8>(&r.host[0]) serviceText = Pointer.fromRef<u8>(&r.serviceText[0]) } }
    let callback = r.cb let retcode = r.retcode
    drop r
    if !Intrinsic.pointerIsNull<NameinfoCallback>(callback) {
      let present = Intrinsic.pointerRequalify<NameinfoCallback, extern "C" fn(*mut u8, i32, ?*const u8, ?*const u8) -> ()>(callback)
      present(bytes, retcode, host, serviceText)
    }
  }
}
export "C" fn silkUvApiNameinfoWork(unit: *mut Work) -> () { unsafe nameinfoWork(unsafe containerOf(unit, NAMEINFO_WORK)) }
export "C" fn silkUvApiNameinfoDone(unit: *mut Work, status: i32) -> () { unsafe nameinfoDone(unsafe containerOf(unit, NAMEINFO_WORK), status) }
/// libuv's uv_getnameinfo: an IPv4 or IPv6 address is copied and getnameinfo(3) runs as slow I/O
/// work (or here without a callback).
@deferredCallbacks("cb")
pub unsafe export "C" fn uv_getnameinfo(loop: ?*mut u8, req: ?*mut u8, cb: NameinfoCallback, addr: ?*const u8, flags: i32) -> i32 {
  unsafe {
    if Pointer.isNull<u8>(req) || Pointer.isNull<u8>(addr) { return -EINVAL }
    let bytes = nnMut<u8>(req)
    let family = familyOf(nn<u8>(addr))
    let mut length: usize = 0
    if family == AF_INET { length = 16 } else { if family == AF_INET6 { length = 28 } else { return -EINVAL } }
    let mut anchor = () let r = Pointer.borrowMut<(), NameinfoReq>(&mut anchor, nameinfoOf(bytes))
    let _copied = memcpy(Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef<u64>(&mut r.storage[0])), nn<u8>(addr), length)
    let memory = loopMemory(loop)
    r.kind = UV_GETNAMEINFO
    uvl.requestStarted(memory)
    r.cb = cb r.flags = flags r.loop = loop r.retcode = 0
    let unit = Pointer.fromMutRef<Work>(&mut r.work)
    drop r
    if !Intrinsic.pointerIsNull<NameinfoCallback>(cb) {
      uvl.workSubmit(memory, unit, uvl.WORK_SLOW_IO, silkUvApiNameinfoWork, silkUvApiNameinfoDone)
      return 0
    }
    nameinfoWork(bytes)
    nameinfoDone(bytes, 0)
    let second = () let r2 = Pointer.borrow<(), NameinfoReq>(&second, nameinfoOf(bytes))
    return r2.retcode
  }
}

// ---- IDNA (libuv's src/idna.c) ----------------------------------------------------------------
const INVALID: u32 = 4294967295
// uv__utf8_decode1_slow: a two- to four-byte sequence whose first byte `first` was read.
unsafe fn utf8DecodeSlow(input: [*]const u8, position: &mut usize, end: usize, first: u32) -> u32 {
  unsafe {
    let mut a = first
    if a > 247 { return INVALID }
    let remaining = end - position.*
    let mut min: u32 = 0 let mut b: u32 = 0 let mut c: u32 = 0 let mut d: u32 = 0
    if remaining >= 3 && a > 239 {
      min = 65536 a = a & 7
      b = u8.toU32(Pointer.read<u8>(Pointer.at<u8>(input, position.*))) c = u8.toU32(Pointer.read<u8>(Pointer.at<u8>(input, position.* + 1))) d = u8.toU32(Pointer.read<u8>(Pointer.at<u8>(input, position.* + 2)))
      position.* = position.* + 3
    } else { if remaining >= 2 && a > 223 {
      min = 2048 b = 128 | (a & 15)
      c = u8.toU32(Pointer.read<u8>(Pointer.at<u8>(input, position.*))) d = u8.toU32(Pointer.read<u8>(Pointer.at<u8>(input, position.* + 1)))
      position.* = position.* + 2
      a = 0
    } else { if remaining >= 1 && a > 191 {
      min = 128 b = 128 c = 128 | (a & 31)
      d = u8.toU32(Pointer.read<u8>(Pointer.at<u8>(input, position.*)))
      position.* = position.* + 1
      a = 0
    } else { return INVALID } } }
    if 128 != (192 & (b ^ c ^ d)) { return INVALID }
    b = b & 63 c = c & 63 d = d & 63
    a = u32.shiftLeft(a, 18) | u32.shiftLeft(b, 12) | u32.shiftLeft(c, 6) | d
    if a < min { return INVALID }
    if a > 1114111 { return INVALID }
    if a >= 55296 && a <= 57343 { return INVALID }
    return a
  }
}
/// libuv's uv__utf8_decode1: the code point at `position` (which it advances), or 0xFFFFFFFF.
pub unsafe fn utf8Decode1(input: [*]const u8, position: &mut usize, end: usize) -> u32 {
  let a = u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(input, position.*)))
  position.* = position.* + 1
  if a < 128 { return a }
  return unsafe utf8DecodeSlow(input, &mut position, end, a)
}
// uv__idna_toascii_label: one label, Punycode-encoded behind "xn--" when it is not all ASCII.
unsafe fn idnaLabel(input: [*]const u8, start: usize, end: usize, output: [*]mut u8, d: &mut usize, de: usize) -> i32 {
  unsafe {
    let alphabet = b"abcdefghijklmnopqrstuvwxyz0123456789"
    let mut h: u32 = 0
    let mut todo: u32 = 0
    let mut s = start
    while s < end {
      let c = utf8Decode1(input, &mut s, end)
      if c == INVALID { return -EINVAL }
      if c < 128 { h = h + 1 } else { todo = todo + 1 }
    }
    if todo > 0 {
      let prefix = b"xn--"
      let mut index: usize = 0
      while index < 4 { if d.* < de { Pointer.write<u8>(Pointer.atMut<u8>(output, d.*), prefix[index]) d.* = d.* + 1 } index = index + 1 }
    }
    let mut x: u32 = 0
    s = start
    while s < end {
      let c = utf8Decode1(input, &mut s, end)
      if c > 127 { continue }
      if d.* < de { Pointer.write<u8>(Pointer.atMut<u8>(output, d.*), u32.wrappingToU8(c)) d.* = d.* + 1 }
      x = x + 1
      if x == h { break }
    }
    if todo == 0 { return u32.wrappingToI32(h) }
    if h > 0 { if d.* < de { Pointer.write<u8>(Pointer.atMut<u8>(output, d.*), 45) d.* = d.* + 1 } }
    let mut n: u32 = 128
    let mut bias: u32 = 72
    let mut delta: u32 = 0
    let mut first = true
    while todo > 0 {
      let mut m: u32 = INVALID
      s = start
      while s < end {
        let c = utf8Decode1(input, &mut s, end)
        if c >= n { if c < m { m = c } }
      }
      x = m - n
      let mut y = h + 1
      if x > (~delta) / y { return -E2BIG }
      delta = delta + x * y
      n = m
      s = start
      while s < end {
        let c = utf8Decode1(input, &mut s, end)
        if c < n { delta = u32.wrappingAdd(delta, 1) if delta == 0 { return -E2BIG } }
        if c != n { continue }
        let mut k: u32 = 36
        let mut q = delta
        while true {
          let mut t: u32 = 1
          if k > bias { t = k - bias }
          if t > 26 { t = 26 }
          if q < t { break }
          x = q - t
          y = 36 - t
          q = x / y
          t = t + x % y
          if d.* < de { Pointer.write<u8>(Pointer.atMut<u8>(output, d.*), alphabet[u32.toUsize(t)]) d.* = d.* + 1 }
          k = k + 36
        }
        if d.* < de { Pointer.write<u8>(Pointer.atMut<u8>(output, d.*), alphabet[u32.toUsize(q)]) d.* = d.* + 1 }
        delta = delta / 2
        if first { delta = delta / 350 first = false }
        h = h + 1
        delta = delta + delta / h
        bias = 0
        while delta > 455 { delta = delta / 35 bias = bias + 36 }
        bias = bias + 36 * delta / (delta + 38)
        delta = 0
        todo = todo - 1
      }
      delta = u32.wrappingAdd(delta, 1)
      n = n + 1
    }
    return 0
  }
}
/// libuv's uv__idna_toascii: `length` bytes of UTF-8 at `input` to at most `capacity` bytes at
/// `output`, NUL included; the count written, or UV_EINVAL / UV_E2BIG.
pub unsafe fn idnaToAscii(input: [*]const u8, length: usize, output: [*]mut u8, capacity: usize) -> isize {
  unsafe {
    if length == 0 { return i32.toIsize(-EINVAL) }
    let mut d: usize = 0
    let mut s: usize = 0
    let mut si: usize = 0
    while si < length {
      let st = si
      let c = utf8Decode1(input, &mut si, length)
      if c == INVALID { return i32.toIsize(-EINVAL) }
      // ".", and the ideographic, fullwidth and halfwidth full stops.
      if c != 46 && c != 12290 && c != 65294 && c != 65377 { continue }
      let rc = idnaLabel(input, s, st, output, &mut d, capacity)
      if rc < 0 { return i32.toIsize(rc) }
      if d < capacity { Pointer.write<u8>(Pointer.atMut<u8>(output, d), 46) d = d + 1 }
      s = si
    }
    if s < length {
      let rc = idnaLabel(input, s, length, output, &mut d, capacity)
      if rc < 0 { return i32.toIsize(rc) }
    }
    if d >= capacity { return i32.toIsize(-EINVAL) }
    Pointer.write<u8>(Pointer.atMut<u8>(output, d), 0)
    d = d + 1
    return usize.toIsize(d)
  }
}

