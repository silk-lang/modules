//! The pre-block splitter: a port of `lib/compress/zstd_preSplit.c` of Zstandard 1.5.7.
//!
//! It looks at a full block of input before compression and proposes a place to end the block
//! early, where the statistics of the content change. A fingerprint is a table of 1024 `u32`
//! event counts followed by a `usize` number of events (`Fingerprint`, 4104 bytes).
import mem
import hist
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.i64
import silk.num.usize

/// `ZSTD_SLIPBLOCK_WORKSPACESIZE`: the bytes of workspace that [`splitBlock`] needs.
pub const WORKSPACE_SIZE: usize = 8208

const FP_SIZE: usize = 4104
const FP_NB_EVENTS: usize = 4096
const THRESHOLD_PENALTY_RATE: u64 = 16
const THRESHOLD_BASE: u64 = 14
const THRESHOLD_PENALTY: u32 = 3
const KNUTH: u32 = 0x9e3779b9
const CHUNKSIZE: usize = 8192
const SEGMENT_SIZE: usize = 512

@inlineAlways
unsafe fn hash2(p: [*]const u8, at: usize, hashLog: u32) -> usize {
  if hashLog == 8 { return u8.toUsize(unsafe mem.r8(p, at)) }
  return mem.z(mem.shr32(mem.m32(u16.toU32(unsafe mem.r16(p, at)), KNUTH), 32 - hashLog))
}

// `recordFingerprint_generic`.
@inlineAlways
unsafe fn recordFingerprint(fp: [*]mut u8, src: [*]const u8, srcSize: usize, samplingRate: usize, hashLog: u32) -> () {
  let _m = unsafe mem.memset(fp, 0, mem.shlz(4, hashLog))
  let limit = srcSize - 2 + 1
  let mut n: usize = 0
  while n < limit {
    let at = unsafe hash2(src, n, hashLog) * 4
    unsafe mem.w32(fp, at, u32.wrappingAdd(unsafe mem.r32(unsafe mem.ro(fp), at), 1))
    n = n + samplingRate
  }
  unsafe mem.w64(fp, FP_NB_EVENTS, usize.toU64(limit / samplingRate))
}

@inlineNever
unsafe fn record43(fp: [*]mut u8, src: [*]const u8, srcSize: usize) -> () { unsafe recordFingerprint(fp, src, srcSize, 43, 8) }
@inlineNever
unsafe fn record11(fp: [*]mut u8, src: [*]const u8, srcSize: usize) -> () { unsafe recordFingerprint(fp, src, srcSize, 11, 9) }
@inlineNever
unsafe fn record5(fp: [*]mut u8, src: [*]const u8, srcSize: usize) -> () { unsafe recordFingerprint(fp, src, srcSize, 5, 10) }
@inlineNever
unsafe fn record1(fp: [*]mut u8, src: [*]const u8, srcSize: usize) -> () { unsafe recordFingerprint(fp, src, srcSize, 1, 10) }

unsafe fn record(level: u32, fp: [*]mut u8, src: [*]const u8, srcSize: usize) -> () {
  if level == 0 { unsafe record43(fp, src, srcSize) }
  else if level == 1 { unsafe record11(fp, src, srcSize) }
  else if level == 2 { unsafe record5(fp, src, srcSize) }
  else { unsafe record1(fp, src, srcSize) }
}

unsafe fn nbEvents(fp: [*]const u8) -> i64 { return u64.wrappingToI64(unsafe mem.r64(fp, FP_NB_EVENTS)) }

// `fpDistance`.
unsafe fn fpDistance(fp1: [*]const u8, fp2: [*]const u8, hashLog: u32) -> u64 {
  let mut distance: u64 = 0
  let n1 = unsafe nbEvents(fp1)
  let n2 = unsafe nbEvents(fp2)
  let size = mem.shlz(1, hashLog)
  let mut n: usize = 0
  while n < size {
    let a = i64.wrappingMultiply(u32.toI64(unsafe mem.r32(fp1, n * 4)), n2)
    let b = i64.wrappingMultiply(u32.toI64(unsafe mem.r32(fp2, n * 4)), n1)
    let d = i64.wrappingSubtract(a, b)
    distance = u64.wrappingAdd(distance, i64.wrappingToU64(if d < 0 { i64.wrappingSubtract(0, d) } else { d }))
    n = n + 1
  }
  return distance
}

// `compareFingerprints`: whether the two fingerprints are too different.
unsafe fn compareFingerprints(reference: [*]const u8, newfp: [*]const u8, penalty: u32, hashLog: u32) -> bool {
  let p50 = u64.wrappingMultiply(unsafe mem.r64(reference, FP_NB_EVENTS), unsafe mem.r64(newfp, FP_NB_EVENTS))
  let deviation = unsafe fpDistance(reference, newfp, hashLog)
  let threshold = u64.wrappingMultiply(p50, THRESHOLD_BASE + u32.toU64(penalty)) / THRESHOLD_PENALTY_RATE
  return deviation >= threshold
}

// `mergeEvents`.
unsafe fn mergeEvents(acc: [*]mut u8, newfp: [*]const u8) -> () {
  let mut n: usize = 0
  while n < 1024 {
    unsafe mem.w32(acc, n * 4, u32.wrappingAdd(unsafe mem.r32(unsafe mem.ro(acc), n * 4), unsafe mem.r32(newfp, n * 4)))
    n = n + 1
  }
  unsafe mem.w64(acc, FP_NB_EVENTS, u64.wrappingAdd(unsafe mem.r64(unsafe mem.ro(acc), FP_NB_EVENTS), unsafe mem.r64(newfp, FP_NB_EVENTS)))
}

const HASH_PARAMS: [u32; 4] = [8, 9, 10, 10]

// `ZSTD_splitBlock_byChunks`.
unsafe fn splitBlockByChunks(blockStart: [*]const u8, blockSize: usize, level: u32, workspace: [*]mut u8) -> usize {
  let pastEvents = workspace
  let newEvents = unsafe mem.add(workspace, FP_SIZE)
  let mut penalty = THRESHOLD_PENALTY
  let _m = unsafe mem.memset(workspace, 0, 2 * FP_SIZE)
  unsafe record(level, pastEvents, blockStart, CHUNKSIZE)
  let mut pos: usize = CHUNKSIZE
  while pos <= blockSize - CHUNKSIZE {
    unsafe record(level, newEvents, unsafe mem.addc(blockStart, pos), CHUNKSIZE)
    if unsafe compareFingerprints(unsafe mem.ro(pastEvents), unsafe mem.ro(newEvents), penalty, HASH_PARAMS[mem.z(level) & 3]) {
      return pos
    }
    unsafe mergeEvents(pastEvents, unsafe mem.ro(newEvents))
    if penalty > 0 { penalty = penalty - 1 }
    pos = pos + CHUNKSIZE
  }
  return blockSize
}

// `ZSTD_splitBlock_fromBorders`: compares the start and the end of the block, and proposes a
// split at one of three places.
unsafe fn splitBlockFromBorders(blockStart: [*]const u8, blockSize: usize, workspace: [*]mut u8) -> usize {
  let pastEvents = workspace
  let newEvents = unsafe mem.add(workspace, FP_SIZE)
  let middleEvents = unsafe mem.add(workspace, 512 * 4)
  let _m = unsafe mem.memset(workspace, 0, 2 * FP_SIZE)
  unsafe hist.add(pastEvents, blockStart, SEGMENT_SIZE)
  unsafe hist.add(newEvents, unsafe mem.addc(blockStart, blockSize - SEGMENT_SIZE), SEGMENT_SIZE)
  unsafe mem.w64(pastEvents, FP_NB_EVENTS, 512)
  unsafe mem.w64(newEvents, FP_NB_EVENTS, 512)
  if !unsafe compareFingerprints(unsafe mem.ro(pastEvents), unsafe mem.ro(newEvents), 0, 8) { return blockSize }
  unsafe hist.add(middleEvents, unsafe mem.addc(blockStart, blockSize / 2 - SEGMENT_SIZE / 2), SEGMENT_SIZE)
  unsafe mem.w64(middleEvents, FP_NB_EVENTS, 512)
  let distFromBegin = unsafe fpDistance(unsafe mem.ro(pastEvents), unsafe mem.ro(middleEvents), 8)
  let distFromEnd = unsafe fpDistance(unsafe mem.ro(newEvents), unsafe mem.ro(middleEvents), 8)
  let minDistance: u64 = 512 * 512 / 3
  let d = i64.wrappingSubtract(u64.wrappingToI64(distFromBegin), u64.wrappingToI64(distFromEnd))
  let ad = i64.wrappingToU64(if d < 0 { i64.wrappingSubtract(0, d) } else { d })
  if ad < minDistance { return 65536 }
  if distFromBegin > distFromEnd { return 32768 }
  return 98304
}

/// `ZSTD_splitBlock`: returns where to end the block that starts at `blockStart`, at most
/// `blockSize`, which must be 128 KiB. `level` is 0 (fastest: looks at the borders only) to 4.
/// `workspace` has [`WORKSPACE_SIZE`] bytes, aligned to 8.
pub unsafe fn splitBlock(blockStart: [*]const u8, blockSize: usize, level: u32, workspace: [*]mut u8) -> usize {
  if level == 0 { return unsafe splitBlockFromBorders(blockStart, blockSize, workspace) }
  // The level is used as the index of a sampling rate.
  return unsafe splitBlockByChunks(blockStart, blockSize, level - 1, workspace)
}
