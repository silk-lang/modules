import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, FrameInput, Mutation, info }
import ui_tree.lib { RootOptions, StyleSource }
import ui_fixtures.fixtures as fixtures
import ui_assets.assets as assets
import font_collection.lib { FontCollection, Generic }
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.written
import svg_css.tokens { CssError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.num.f32

fn frame(width: f32) -> FrameInput { return FrameInput { width: width, height: 100.0, scale: 1.0, time: 0.0 } }
fn close(a: f32,b: f32) -> bool { return f32.abs(a-b) < 0.01 }

effect fn width(tree: &UiTree<'_>, id: u32) -> f32 ! OutOfMemoryError ? &mut Allocator {
  return match run info(tree,id) { Option.Some { value } => value.bounds.width() _ => 0.0 }
}

effect fn base(batch: &mut Batch, root: u32, box: u32, text: u32) ! CssError | OutOfMemoryError ? &mut Allocator {
  run batch.create(root,NodeKind.Box)
  run batch.create(box,NodeKind.Box)
  run batch.append(root,box)
  run batch.create(text,NodeKind.Text)
  run batch.append(box,text)
  run batch.setText(text,"iiiiiiiiii")
  let style = run written.declarations(b"display:inline-block;font-family:'Brand','Noto Sans';font-size:16px")
  run batch.style(box,style.asSlice())
}

effect fn sheet(batch: &mut Batch, root: u32, id: u32, source: &[u8], replace: bool) ! CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let compiled = run compile.compile(source,&Options.make())
  let bytes = run compiled.encode()
  if replace { run batch.replaceStyleSheet(root,id,bytes.asSlice()) }
  else { run batch.adoptStyleSheet(root,id,bytes.asSlice()) }
}

effect fn loading() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch,1,2,3)
  run batch.root(1)
  run sheet(&mut batch,0,1,b"@font-face{font-family:Brand;src:url(bad.ttf),url(brand.ttf);unicode-range:U+0-2FF;font-display:swap}@font-face{font-family:Brand;src:url(greek.ttf);unicode-range:U+370-3FF}",false)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  let fallback = run width(&tree,2)
  let loads = run tree.takeLoads()
  run Testing.expect(loads.length() == 1, "only the font subset required by text is requested")
  let id = match &loads.asSlice()[0] {
    Mutation.LoadFontFace { face, url } => { run Testing.expect(String.view(&url) == "bad.ttf", "the first usable source is requested") face }
    _ => { run Testing.expect(false,"font load request") 0 }
  }
  tree.failFontFace(id)
  let retry = run tree.takeLoads()
  run Testing.expect(retry.length() == 1 && match &retry.asSlice()[0] { Mutation.LoadFontFace { face, url } => face == id && String.view(&url) == "brand.ttf" _ => false }, "a failed source retries the next URL under the same face identity")
  run Testing.expect(run tree.loadFontFace(id,run Bytes.copy(assets.geistMonoFont()),0), "the requested file loads")
  run tree.frame(frame(400.0))
  let loaded = run width(&tree,2)
  run Testing.expect(loaded > fallback * 1.5, "loading a sheet font reshapes existing text")
  run Testing.expect((run tree.takeLoads()).length() == 0, "loaded faces do not request again")
  run batch.removeStyleSheet(0,1)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  run Testing.expect(close(run width(&tree,2),fallback), "removing the sheet restores fallback matching")
  run sheet(&mut batch,0,1,b"@font-face{font-family:Brand;src:url(bad.ttf),url(brand.ttf);unicode-range:U+0-2FF;font-display:swap}",false)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  run Testing.expect(close(run width(&tree,2),loaded) && (run tree.takeLoads()).length() == 0, "readoption reuses unchanged loaded face data")
  run sheet(&mut batch,0,1,b"@font-face{font-family:Brand;src:url(replacement.ttf)}",true)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  run Testing.expect(close(run width(&tree,2),fallback), "replacement disables the old font while its new source loads")
  let replaced = run tree.takeLoads()
  run Testing.expect(replaced.length() == 1 && match &replaced.asSlice()[0] { Mutation.LoadFontFace { face, url } => face != id && String.view(&url) == "replacement.ttf" _ => false }, "a changed source has a new load identity")
  run Testing.expect(tree.sheetFaces.entries.length() == 3, "unchanged rules reuse registry entries across replacement and readoption")
}

test effect fn stylesheetFontFacesLoadSwapRetryRemoveAndReuse() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run loading() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rootsAndMedia() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch,1,2,3)
  run base(&mut batch,11,12,13)
  run batch.root(1)
  run batch.openRoot(1,11,RootOptions.default())
  run sheet(&mut batch,0,1,b"@media(width>300px){@font-face{font-family:Brand;src:url(root-zero.ttf)}}",false)
  run sheet(&mut batch,1,1,b"@font-face{font-family:Brand;src:url(root-one.ttf)}",false)
  run tree.apply(run batch.take())
  run tree.frameRoot(0,frame(200.0))
  run Testing.expect((run tree.takeLoads()).length() == 0, "a false font-face media condition initiates no load")
  let fallback = run width(&tree,2)
  run tree.frameRoot(1,frame(400.0))
  let first = run tree.takeLoads()
  run Testing.expect(first.length() == 1, "the second root requests its own face")
  let otherId = match &first.asSlice()[0] { Mutation.LoadFontFace { face, .. } => face _ => 0 }
  run Testing.expect(run tree.loadFontFace(otherId,run Bytes.copy(assets.regularFont()),0), "second root face loads")
  run tree.frameRoot(1,frame(400.0))
  let otherWidth = run width(&tree,12)
  run tree.frameRoot(0,frame(400.0))
  let second = run tree.takeLoads()
  run Testing.expect(second.length() == 1, "matching media activates the first root's separate face")
  let id = match &second.asSlice()[0] { Mutation.LoadFontFace { face, .. } => face _ => 0 }
  run Testing.expect(id != otherId && run tree.loadFontFace(id,run Bytes.copy(assets.geistMonoFont()),0), "same-named faces in different roots have separate identities")
  run tree.frameRoot(0,frame(400.0))
  let wide = run width(&tree,2)
  run Testing.expect(wide > fallback * 1.5, "first root uses its loaded face")
  run tree.frameRoot(1,frame(400.0))
  run Testing.expect(close(run width(&tree,12),otherWidth), "loading another root's family does not change this root's text")
  run tree.frameRoot(0,frame(200.0))
  run Testing.expect(close(run width(&tree,2),fallback), "turning off media deactivates an already loaded face")
  run tree.frameRoot(0,frame(400.0))
  run Testing.expect(close(run width(&tree,2),wide) && (run tree.takeLoads()).length() == 0, "turning media back on reuses the loaded face")
  run batch.closeRoot(1)
  run tree.apply(run batch.take())
  run Testing.expect(!tree.sheetFaces.aliases.asSlice()[0].active || !tree.sheetFaces.aliases.asSlice()[1].active, "closing a root deactivates its font aliases")
}

test effect fn stylesheetFontFacesRespectRootScopeAndMediaChanges() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rootsAndMedia() |> Effect.provideMut<Allocator>(&mut allocator)
}


effect fn relativeUrls() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch,1,2,3)
  run batch.root(1)
  run tree.apply(run batch.take())
  let sheetId = run tree.loadStyleSheet(0,run StyleSource.url("https://cdn.example/themes/dark/main.css"))
  let requests = tree.takeStyleLoads()
  let compiled = run compile.compile(b"@font-face{font-family:Brand;src:url('../fonts/brand face.ttf?v=1'),url('https://fonts.example/fallback.ttf')}",&Options.make())
  let encoded = run compiled.encode()
  run Testing.expect(run tree.settleStyleSheet(requests.asSlice()[0].ticket,Option<Bytes>.some(move encoded)), "runtime stylesheet settles")
  run tree.frame(frame(400.0))
  let loads = run tree.takeLoads()
  run Testing.expect(loads.length() == 1 && match &loads.asSlice()[0] { Mutation.LoadFontFace { url, .. } => String.view(&url) == "https://cdn.example/themes/fonts/brand%20face.ttf?v=1" _ => false }, "font URLs resolve relative to their stylesheet URL")
  let face = match &loads.asSlice()[0] { Mutation.LoadFontFace { face, .. } => face _ => 0 }
  tree.failFontFace(face)
  let retry = run tree.takeLoads()
  run Testing.expect(retry.length() == 1 && match &retry.asSlice()[0] { Mutation.LoadFontFace { url, .. } => String.view(&url) == "https://fonts.example/fallback.ttf" _ => false }, "absolute font alternatives retain their own origin")
  run batch.removeStyleSheet(0,sheetId)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  tree.failFontFace(face)
  run Testing.expect((run tree.takeLoads()).length() == 0, "removed font rules stop trying alternative sources")
  drop run tree.loadStyleSheet(0,run StyleSource.url("styles/main.css?folder=wrong/place"))
  let relativeRequests = tree.takeStyleLoads()
  let relative = run compile.compile(b"@font-face{font-family:Brand;src:url('../fonts/brand face.ttf')}",&Options.make())
  drop run tree.settleStyleSheet(relativeRequests.asSlice()[0].ticket,Option<Bytes>.some(run relative.encode()))
  run tree.frame(frame(400.0))
  let relativeLoads = run tree.takeLoads()
  run Testing.expect(relativeLoads.length() == 1 && match &relativeLoads.asSlice()[0] { Mutation.LoadFontFace { url, .. } => String.view(&url) == "styles/../fonts/brand%20face.ttf" _ => false }, "relative sheet paths exclude query text and retain escaped filenames")
}

test effect fn stylesheetFontFacesResolveUrlsAgainstTheirLoadedSheet() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run relativeUrls() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn localAndOrder() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch,1,2,3)
  run batch.root(1)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  let fallback = run width(&tree,2)
  run sheet(&mut batch,0,1,b"@layer low,high;@layer high{@font-face{font-family:Brand;src:local('Missing Face'),local('GeistMono-Regular'),url(unused.ttf)}}",false)
  run sheet(&mut batch,0,2,b"@layer low{@font-face{font-family:Brand;src:local('Noto Sans Regular')}}",false)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  let wide = run width(&tree,2)
  run Testing.expect(wide > fallback * 1.5 && (run tree.takeLoads()).length() == 0, "full and PostScript local names load without network and higher layers win equal descriptors")
  run batch.removeStyleSheet(0,1)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  run Testing.expect(close(run width(&tree,2),fallback), "removing the higher layer restores the lower local face")
  run sheet(&mut batch,0,3,b"@font-face{font-family:Brand;src:local('Geist Mono')}",false)
  run sheet(&mut batch,0,4,b"@font-face{font-family:Brand;src:local('NotoSans-Regular')}",false)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  run Testing.expect(close(run width(&tree,2),fallback), "later adoption wins equal-layer font faces")
  run batch.styleSheetOrder(0,&[2,4,3])
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  run Testing.expect(close(run width(&tree,2),wide), "reordering existing sheets changes font precedence without reloading")
  run sheet(&mut batch,0,3,b"@font-face{font-family:Brand;src:url(failed.ttf),local('missing'),local('GeistMono-Regular'),url(unused.ttf)}",true)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  let loads = run tree.takeLoads()
  run Testing.expect(loads.length() == 1, "a URL before local sources is tried first")
  let id = match &loads.asSlice()[0] { Mutation.LoadFontFace { face, .. } => face _ => 0 }
  tree.failFontFace(id)
  run Testing.expect((run tree.takeLoads()).length() == 0, "a local alternative after a failed URL prevents later network requests")
  run tree.frame(frame(400.0))
  run Testing.expect(close(run width(&tree,2),wide), "the local fallback reshapes text under the same face rule")
}

test effect fn stylesheetFontFacesHonorLocalSourcesLayersAndSheetOrder() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run localAndOrder() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn familyWidth(fonts: &FontCollection, family: &[u8]) -> f32 ! TreeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut tree = run UiTree.make(fonts)
  let mut batch = Batch.make()
  run batch.create(1,NodeKind.Box)
  run batch.create(2,NodeKind.Box)
  run batch.append(1,2)
  run batch.create(3,NodeKind.Text)
  run batch.append(2,3)
  run batch.setText(3,"iiiiiiiiii")
  let mut css = run Bytes.copy(b"display:inline-block;font-size:16px;font-family:")
  run Bytes.append(&mut css, family)
  let style = run written.declarations(Bytes.asSlice(&css))
  run batch.style(2,style.asSlice())
  run batch.root(1)
  run tree.apply(run batch.take())
  run tree.frame(frame(400.0))
  return run width(&tree,2)
}

effect fn uiGenerics() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut fonts = run fixtures.fonts()
  run fonts.addGeneric(Generic.Monospace, b"Geist Mono")
  run fonts.addGeneric(Generic.Serif, b"Geist")
  run fonts.addGeneric(Generic.SystemUi, b"Noto Sans")
  run fonts.addGeneric(Generic.UiRounded, b"Geist")
  let mono = run familyWidth(&fonts, b"'Geist Mono'")
  let geist = run familyWidth(&fonts, b"Geist")
  let noto = run familyWidth(&fonts, b"'Noto Sans'")
  run Testing.expect(!close(mono, noto) && !close(geist, noto), "the families draw at different widths")
  run Testing.expect(close(run familyWidth(&fonts, b"ui-monospace, 'Noto Sans'"), mono), "ui-monospace is monospace")
  run Testing.expect(close(run familyWidth(&fonts, b"UI-Serif, 'Noto Sans'"), geist), "ui-serif is serif, in any case")
  run Testing.expect(close(run familyWidth(&fonts, b"ui-sans-serif, Geist"), noto), "ui-sans-serif is system-ui")
  run Testing.expect(close(run familyWidth(&fonts, b"ui-rounded, 'Noto Sans'"), geist), "the host's own ui-rounded family comes first")
  run Testing.expect(close(run familyWidth(&fonts, b"'ui-monospace', Geist"), geist), "a quoted ui-monospace is a family name")
}

test effect fn uiFontFamiliesAliasTheGenerics() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run uiGenerics() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn variations() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let plain = run familyWidth(&fonts, b"Geist")
  let heavy = run familyWidth(&fonts, b"Geist;font-variation-settings:'wght' 800")
  let bold = run familyWidth(&fonts, b"Geist;font-weight:800")
  run Testing.expect(heavy > plain + 1.0, "a wght setting draws Geist heavier")
  run Testing.expect(close(heavy, bold), "wght 800 draws as font-weight 800")
  run Testing.expect(close(run familyWidth(&fonts, b"Geist;font-weight:800;font-variation-settings:\"wght\" 400"), plain), "the setting wins over font-weight")
  run Testing.expect(close(run familyWidth(&fonts, b"Geist;font-variation-settings:'wght' 800, 'wght' 400"), plain), "a repeated axis takes its last value")
  run Testing.expect(close(run familyWidth(&fonts, b"Geist;font-variation-settings:normal"), plain), "normal sets no axis")
  run Testing.expect(close(run familyWidth(&fonts, b"Geist;font-variation-settings:'wght'"), plain), "an axis without a value is dropped")
}

test effect fn fontVariationSettingsSetAxes() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run variations() |> Effect.provideMut<Allocator>(&mut allocator)
}
