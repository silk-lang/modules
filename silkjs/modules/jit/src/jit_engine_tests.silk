// The JIT inside the engine: scripts whose hot functions are compiled through
// jit_runtime and x64_backend, run against the interpreter's answers, with the
// deoptimization paths exercised and counted (docs/jit/compiled-entry.md).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.i32
import silk.num.i64
import silk.testing.testing { Testing, AssertionError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapCell, HeapHeader }
import silkjs.js_object_ref { ObjectRef }
import silkjs.js_value { ValueBits }
import silkjs.js_owned_value { Value, ValueRef }
import silkjs.js_realm { Realm, lendRealm }
import silkjs.js_core_types { HostHook, NativeFunctionId, FunctionBytecode }
import silkjs.js_exceptions { JsException }
import silkjs.js_runtime as runtime
import silkjs.js_vm as vm
import silkjs.cli_io as io
import silk.num.u8
import silk.num.u32
import silkjs.js_gc as gc
import silkjs.js_eval as eval
import silkjs.js_intrinsic_install as intrinsics
import silkjs.native_stack as stack
import silkjs.js_compiled_objects as objects
import code_memory { MemoryError }
import asm_x64 { Code, LinkError, Relocation, UnboundLabelError }
import x64_lower { Lowered }
import x64_lower as lower
import jit_runtime { Jit, Options }
import jit_runtime as jitRuntime

const HANDLER: u32 = 11

pub struct Compiling { pub jit: Jit, pub failures: usize }
impl EngineServices for Compiling {
  effect fn initializeShadowRealm<'r, 's, 'm>(engine: &mut Engine<'m, Self>, caller: Realm<'r>, created: Realm<'s>) -> () ! JsException ? &mut Allocator {}
  effect fn dynamicImportStarted<'r, 'v, 'w, 'x, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>, specifier: ValueRef<'v>, referrer: ValueRef<'w>, promise: ValueRef<'x>) -> ValueBits ! JsException ? &mut Allocator {
    return promise.dup().intoBits()
  }
  unsafe effect fn hotFunction<'m>(engine: &mut Engine<'m, Self>, rt: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, function: ValueBits) -> () ? &mut Allocator {
    let bytecode = match function { ValueBits.FunctionBytecode { reference } => reference _ => { return () } }
    let compiled = run Effect.result(unsafe jitRuntime.compileHot(&mut engine.services.jit, bytecode))
    match move compiled {
      Result<(), OutOfMemoryError | MemoryError | LinkError>.Success { .. } => ()
      Result<(), OutOfMemoryError | MemoryError | LinkError>.Failure { .. } => { engine.services.failures = engine.services.failures + 1 }
    }
  }
}
/// Evaluates source; the completion value's bits (an Int or Float64 is all these scripts make).
unsafe effect fn evaluate<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader, source: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let memory = engine.memory
  let result = run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"jit.js", 0)
  let bits = Value.intoBits(move result)
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), bits)
  return bits
}
fn isInt(bits: ValueBits, expected: i32) -> bool { return match bits { ValueBits.Int { value } => value == expected _ => false } }
fn isNumber(bits: ValueBits, expected: f64) -> bool {
  return match bits { ValueBits.Float64 { value } => value == expected ValueBits.Int { value } => i32.toF64(value) == expected _ => false }
}
/// What sum(n) below returns, as the interpreter computes it (int32 while it fits, then a double).
fn sumOf(n: i64) -> f64 {
  if n <= 0 { return 0.0 }
  return i64.toF64(n * (n - 1) / 2)
}

const SUM: &[u8] = b"function sum(n){let s=0;for(let i=0;i<n;i++)s=s+i;return s}"

unsafe effect fn exercise<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, SUM)
  // Before the function is hot nothing is compiled; after its 20th entry it is.
  let early = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<10;k++)t=t+sum(k);t")
  run Testing.expect(isInt(early, 120) && engine.services.jit.compiledFunctions == 0, "cold: interpreted, nothing compiled")
  let hot = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<300;k++)t=t+sum(k);t")
  let mut expected: i64 = 0 let mut k: i64 = 0
  while k < 300 { expected = expected + k * (k - 1) / 2 k = k + 1 }
  run Testing.expect(isNumber(hot, i64.toF64(expected)), "hot: compiled results equal the interpreter's over n = 0..299")
  run Testing.expect(engine.services.jit.compiledFunctions == 1, "sum is compiled once it is hot")
  engine.services.jit.collect()
  let runs = engine.services.jit.runs
  run Testing.expect(runs >= 250, "and its calls run the compiled code (fails if compilation silently stops)")
  run Testing.expect(engine.services.jit.deopts == 0, "int32 arguments that do not overflow never deopt")
  // The interrupt counter is shared with the interpreter, so 45,000 back edges above polled.
  run Testing.expect(engine.services.jit.polls >= 3, "compiled loops reach the interrupt poll")
  let polled = engine.services.jit.polls
  // A long loop: the back edge's poll falls due (the interrupt counter runs at most 10000 back
  // edges) before s overflows at i = 65536, so the interpreter takes over at the loop header and
  // makes the double. The overflow guard itself is run in x64_backend_tests.
  // There the interpreter polls at its next back edge and enters the loop header's
  // on-stack-replacement code (docs/jit/osr.md), which polls every 10000 back edges without
  // leaving for good and deopts at the overflow.
  let wide = run unsafe evaluate(&mut engine, context, b"sum(70000)")
  run Testing.expect(isNumber(wide, sumOf(70000)), "a loop past the poll leaves at the loop header and the interpreter finishes it")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.deopts == 0 && engine.services.jit.polls >= polled + 6, "the poll exits are not deopts")
  run Testing.expect(engine.services.jit.osrRuns >= 6 && engine.services.jit.osrDeopts == 1, "the loop is re-entered after each poll; the overflow is its one deopt")
  // Not an int: the entry guard deopts before anything ran.
  let half = run unsafe evaluate(&mut engine, context, b"sum(3.5)")
  run Testing.expect(isInt(half, 6), "a double argument deopts at entry")
  let text = run unsafe evaluate(&mut engine, context, b"sum('5')")
  run Testing.expect(isInt(text, 10), "a string argument deopts at entry")
  let missing = run unsafe evaluate(&mut engine, context, b"sum()")
  run Testing.expect(isInt(missing, 0), "a missing argument (undefined) deopts at entry")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.deopts == 3, "each guard failure is one deopt")
  // Still linked: int calls keep running compiled code.
  let again = run unsafe evaluate(&mut engine, context, b"sum(100)")
  engine.services.jit.collect()
  run Testing.expect(isInt(again, 4950) && engine.services.jit.runs == runs + 5, "after deopts below the limit the code stays in use")
  // Past the deopt limit (8) the engine unlinks the function and interprets it.
  let many = run unsafe evaluate(&mut engine, context, b"var t=0;for(var k=0;k<10;k++)t=t+sum(0.5+k);t")
  engine.services.jit.collect()
  run Testing.expect(isInt(many, 165) && engine.services.jit.unlinked == 1 && engine.services.jit.deopts == 8,
    "the 8th deopt unlinks the function; later calls are interpreted")
  // A leaf (no calls, no loop) runs frameless, and leaf runs are not counted (tier-seam.md),
  // so it never gets hot: it stays interpreted.
  let leaf = run unsafe evaluate(&mut engine, context, b"function add(a,b){return a+b};var u=0;for(var k=0;k<100;k++)u=add(u,k);u")
  engine.services.jit.collect()
  run Testing.expect(isInt(leaf, 4950) && engine.services.jit.compiledFunctions == 1, "a leaf function stays interpreted")
  // On-stack replacement (docs/jit/osr.md). Called once, so never hot by entries: the back-edge
  // poll reports it. The closure made before the loop is outside the subset, so only the loop
  // compiles (OSR only), and the object kept in a local across the loop comes back intact.
  let before = engine.services.jit.osrRuns
  let looped = run unsafe evaluate(&mut engine, context,
    b"function once(n){let g=function*(){};let o={k:7};let s=o.k;for(let i=0;i<n;i++){s=s+3;if(s>9000)s=s-9000}return s+o.k};once(200000)")
  engine.services.jit.collect()
  run Testing.expect(isInt(looped, 6014), "a loop entered by on-stack replacement returns the interpreter's answer")
  run Testing.expect(engine.services.jit.osrOnly == 1 && engine.services.jit.osrRuns >= before + 15,
    "the loop runs compiled from its first poll on, re-entered after every poll")
  // In an inline frame (once called from another function's loop), and leaving at a side exit
  // (the property write) on the last iteration.
  let nested = run unsafe evaluate(&mut engine, context,
    b"function inner(n,o){let s=0;for(let i=0;i<n;i++){s=s+1;if(i===n-1)o.last=s}return s};function outer(){let o={};let t=0;for(let k=0;k<3;k++)t=t+inner(30000,o);return t+o.last};outer()")
  engine.services.jit.collect()
  run Testing.expect(isInt(nested, 120000), "on-stack replacement in an inline frame, with a side exit")
  // An OSR-only loop whose int add overflows deopts at every poll; at the deopt limit the function
  // is unlinked and reported again, and its next compilation (jit_recompile) widens that add.
  let recompiles = engine.services.jit.recompiled
  let deoptsBefore = engine.services.jit.osrDeopts
  let grown = run unsafe evaluate(&mut engine, context,
    b"function grow(n){let g=function*(){};let o={k:1};let s=o.k;for(let i=0;i<n;i++){s=s+100000}return s+o.k};grow(300000)")
  engine.services.jit.collect()
  run Testing.expect(isNumber(grown, 30000000002.0), "a recompiled OSR loop returns the interpreter's answer")
  run Testing.expect(engine.services.jit.recompiled == recompiles + 1 && engine.services.jit.osrDeopts <= deoptsBefore + 10,
    "OSR deopts feed the recompile path, and the widened loop stops deopting")
  // A double from a non-int argument in an OSR-only loop, widened at recompilation.
  let infinite = run unsafe evaluate(&mut engine, context,
    b"function long0(a,n){var t=1;var o={x:1};for(var i=0;i<n;i++){t=t-a;if(t>100000||t<-100000)t=0;if(i===n-2)o=[t]}return t+o.length};long0(Infinity,250000)")
  run Testing.expect(isInt(infinite, 1), "a loop widened to doubles after OSR deopts")
  // An OSR-only function (a generator closure keeps its normal entry out) called afterwards
  // through the interpreter's linked call site, spread, apply and call: each call interprets
  // it (OSR_ONLY_CALL_WORDS) and its long loops still enter the OSR code.
  engine.services.jit.collect()
  let onlyBefore = engine.services.jit.osrOnly
  let runsBefore = engine.services.jit.osrRuns
  let hop = run unsafe evaluate(&mut engine, context,
    b"function hop(n){let g=function*(){};let o={k:2};let s=o.k;for(let i=0;i<n;i++){s=s+1}return s};var r=hop(30000);var t=0;for(var k=0;k<50;k++)t=t+hop(k);t=t+hop(...[25000])+hop.apply(null,[25000])+hop.call(null,3);r+t")
  engine.services.jit.collect()
  run Testing.expect(isInt(hop, 81336), "an OSR-only function returns the interpreter's answers through every call path")
  run Testing.expect(engine.services.jit.osrOnly == onlyBefore + 1 && engine.services.jit.osrRuns >= runsBefore + 4,
    "it is linked once, and loops reached by spread and apply calls enter its OSR code")
  // Each loop gets OSR code when a poll lands at its header, and the code covers that loop
  // only: leaving it is the loop finishing, not a deopt.
  let compiledBefore = engine.services.jit.osrCompiled
  let deoptsTwo = engine.services.jit.osrDeopts
  let two = run unsafe evaluate(&mut engine, context,
    b"function two(n){let o={k:1};let s=o.k;for(let i=0;i<n;i++){s=s+1}for(let j=0;j<n;j++){s=s+2}return s+o.k};two(100000)")
  engine.services.jit.collect()
  run Testing.expect(isInt(two, 300002), "two loops entered by on-stack replacement return the interpreter's answer")
  run Testing.expect(engine.services.jit.osrCompiled == compiledBefore + 2 && engine.services.jit.osrDeopts == deoptsTwo,
    "each loop header compiles once, on its first poll, and finishing a loop is no deopt")
  // A linked function's OSR code that keeps deopting (its add overflows) is entered again only
  // after 1, 3, 7, ... polls, and never after ENTRY_DEOPTS deopts.
  drop run unsafe evaluate(&mut engine, context, b"function big(n){let s=0;for(let i=0;i<n;i++)s=s+100000;return s};for(var k=0;k<30;k++)big(1)")
  let deoptsBig = engine.services.jit.osrDeopts
  let big = run unsafe evaluate(&mut engine, context, b"big(600000)")
  engine.services.jit.collect()
  run Testing.expect(isNumber(big, 60000000000.0), "a backed-off OSR loop returns the interpreter's answer")
  run Testing.expect(engine.services.jit.osrDeopts > deoptsBig && engine.services.jit.osrDeopts <= deoptsBig + 6,
    "a deopting OSR entry backs off and stops being entered")
  // for-of (docs/jit/osr.md): a stand-in record over a fast Array (js_iterators.forOfStart) steps
  // in OSR code; its end, and every other iterable, is the interpreter's. Answers are node's.
  let ofRuns = engine.services.jit.osrRuns
  let ofDeopts = engine.services.jit.osrDeopts
  let ofArray = run unsafe evaluate(&mut engine, context, b"function fsum(a){let s=0;for(const x of a){s=s+x}return s};var fa=[];for(var k=0;k<40000;k++)fa.push(k&255);fsum(fa)")
  engine.services.jit.collect()
  run Testing.expect(isInt(ofArray, 5093856), "for-of over a fast Array")
  run Testing.expect(engine.services.jit.osrRuns >= ofRuns + 3 && engine.services.jit.osrDeopts == ofDeopts,
    "the for-of loop runs as OSR code, and its end is no deopt")
  let of1 = run unsafe evaluate(&mut engine, context, b"function fhole(a){let s=0;for(const x of a){s=s+(x===undefined?7:x)}return s};var fh=[];for(var k=0;k<30000;k++)fh.push(k&15);delete fh[5];fh[30005]=1;fhole(fh)")
  run Testing.expect(isNumber(of1, 225038.0), "for-of over an Array with holes")
  let of2 = run unsafe evaluate(&mut engine, context, b"function fpush(a){let s=0;for(const x of a){s=s+x;if(a.length<45000)a.push(3)}return s};var fp=[];for(var k=0;k<30000;k++)fp.push(k&7);fpush(fp)")
  run Testing.expect(isNumber(of2, 150000.0), "for-of over an Array pushed to while it is stepped")
  let of3 = run unsafe evaluate(&mut engine, context, b"function fpop(a){let s=0;for(const x of a){s=s+x;if(s>20000)a.pop()}return s+a.length};var fo=[];for(var k=0;k<40000;k++)fo.push(k&3);fpop(fo)")
  run Testing.expect(isNumber(of3, 66666.0), "for-of over an Array popped while it is stepped")
  let of4 = run unsafe evaluate(&mut engine, context, b"function fcut(a){let s=0;for(const x of a){s=s+x;if(s>50000)a.length=0}return s};var fc=[];for(var k=0;k<40000;k++)fc.push(k&15);fcut(fc)")
  run Testing.expect(isNumber(of4, 50011.0), "for-of over an Array emptied by length=0 while it is stepped")
  let of5 = run unsafe evaluate(&mut engine, context, b"function fset(c){let s=0;for(const x of c){s=s+x}return s};var st=new Set();for(var k=0;k<30000;k++)st.add(k*3);fset(st)")
  run Testing.expect(isNumber(of5, 1349955000.0), "for-of over a Set")
  let of6 = run unsafe evaluate(&mut engine, context, b"function fmap(c){let s=0;for(const e of c){s=s+e[0]-e[1]}return s};var mp=new Map();for(var k=0;k<30000;k++)mp.set(k,k&7);fmap(mp)")
  run Testing.expect(isNumber(of6, 449880000.0), "for-of over a Map")
  let of7 = run unsafe evaluate(&mut engine, context, b"function fstr(t){let s=0;for(const ch of t){s=s+ch.charCodeAt(0)}return s};fstr('abcdefghij'.repeat(3000))")
  run Testing.expect(isNumber(of7, 3045000.0), "for-of over a string")
  let of8 = run unsafe evaluate(&mut engine, context, b"function* gen(n){for(let i=0;i<n;i++)yield i&31};function fgen(n){let s=0;for(const x of gen(n)){s=s+x}return s};fgen(30000)")
  run Testing.expect(isNumber(of8, 464872.0), "for-of over a generator")
  let of9 = run unsafe evaluate(&mut engine, context, b"function fthrow(){let it={i:0,next(){this.i++;if(this.i>25000)throw 77;return {value:this.i&3,done:false}},[Symbol.iterator](){return this}};let s=0;try{for(const x of it){s=s+x}}catch(e){s=s+e}return s};fthrow()")
  run Testing.expect(isNumber(of9, 37577.0), "for-of over an iterator whose next throws")
  let of10 = run unsafe evaluate(&mut engine, context, b"function fret(){let closed=0;let it={i:0,next(){this.i++;return {value:this.i&7,done:false}},return(){closed=closed+1000;return {}},[Symbol.iterator](){return this}};let s=0;for(const x of it){s=s+x;if(s>60000)break}return s+closed};fret()")
  run Testing.expect(isNumber(of10, 61004.0), "for-of over an iterator whose return a break calls")
  let of11 = run unsafe evaluate(&mut engine, context, b"function farrbreak(a){let s=0;for(const x of a){s=s+x;if(s>30000)break}return s};var fb=[];for(var k=0;k<40000;k++)fb.push(k&7);farrbreak(fb)")
  run Testing.expect(isNumber(of11, 30003.0), "for-of over an Array loop left by break")
  let of12 = run unsafe evaluate(&mut engine, context, b"function fdbl(a){let s=0;for(const x of a){s=s+x}return s};var fd=[];for(var k=0;k<30000;k++)fd.push(k===20000?0.5:1);fdbl(fd)")
  run Testing.expect(isNumber(of12, 29999.5), "for-of over an Array whose element turns into a double")
  let of13 = run unsafe evaluate(&mut engine, context, b"function fin(o){let s=0;for(const k in o){s=s+o[k];if(k==='k5')delete o.k9;if(k==='k6')o.extra=1000}return s};var fi=Object.create({inherited:5});for(var k=0;k<20000;k++)fi['k'+k]=k&3;fin(fi)")
  run Testing.expect(isNumber(of13, 30004.0), "for-in over deleted, added and prototype keys")
  engine.services.jit.collect()
  // for-in and for-of in hot functions (not OSR): generic exits with several results
  // (call.result). Answers are node's.
  engine.services.jit.collect()
  let iterSites = engine.services.jit.genericSites
  let hot1 = run unsafe evaluate(&mut engine, context, b"function h1(a){let s=0;for(const x of a){s=s+x}return s};var a1=[1,2,3,4,5];var t=0;for(var k=0;k<3000;k++)t=t+h1(a1);t")
  run Testing.expect(isNumber(hot1, 45000.0), "hot for-of over a fast Array")
  let hot2 = run unsafe evaluate(&mut engine, context, b"function h2(o){let s=0;for(const k in o){s=s+o[k]}return s};var o2={a:1,b:2,c:3};var t=0;for(var k=0;k<3000;k++)t=t+h2(o2);t")
  run Testing.expect(isNumber(hot2, 18000.0), "for-in over own keys")
  let hot3 = run unsafe evaluate(&mut engine, context, b"function h3(c){let s=0;for(const x of c){s=s+x}return s};var c3=new Set([1,2,3,4]);var t=0;for(var k=0;k<3000;k++)t=t+h3(c3);t")
  run Testing.expect(isNumber(hot3, 30000.0), "hot for-of over a Set")
  let hot4 = run unsafe evaluate(&mut engine, context, b"function h4(m){let s=0;for(const e of m){s=s+e[0]*e[1]}return s};var m4=new Map([[1,2],[3,4]]);var t=0;for(var k=0;k<3000;k++)t=t+h4(m4);t")
  run Testing.expect(isNumber(hot4, 42000.0), "hot for-of over a Map")
  let hot5 = run unsafe evaluate(&mut engine, context, b"function h5(t){let s=0;for(const ch of t){s=s+ch.length}return s};var t=0;for(var k=0;k<3000;k++)t=t+h5('abcd');t")
  run Testing.expect(isNumber(hot5, 12000.0), "hot for-of over a string")
  let hot6 = run unsafe evaluate(&mut engine, context, b"function* g6(n){for(let i=0;i<n;i++)yield i};function h6(n){let s=0;for(const x of g6(n)){s=s+x}return s};var t=0;for(var k=0;k<3000;k++)t=t+h6(5);t")
  run Testing.expect(isNumber(hot6, 30000.0), "hot for-of over a generator")
  let hot7 = run unsafe evaluate(&mut engine, context, b"function h7(a){let s=0;for(const x of a){s=s+x;if(s>6)break}return s};var a7=[1,2,3,4,5];var t=0;for(var k=0;k<3000;k++)t=t+h7(a7);t")
  run Testing.expect(isNumber(hot7, 30000.0), "hot for-of over an Array left by break")
  let hot8 = run unsafe evaluate(&mut engine, context, b"function mk(n,b){let i=0;return {next(){i++;if(b&&i===3)throw 9;return {value:i,done:i>n}},return(){c8=c8+1;return {}},[Symbol.iterator](){return this}}};var c8=0;function h8(k){let s=0;try{for(const x of mk(4,k%7===0)){s=s+x;if(k%5===0&&x===2)break}}catch(e){s=s+e*100}return s};var t=0;for(var k=0;k<3000;k++)t=t+h8(k);t*10000+c8")
  run Testing.expect(isNumber(hot8, 3320990600.0), "hot for-of over iterators whose next throws and whose return a break calls")
  let hot9 = run unsafe evaluate(&mut engine, context, b"function h9(o){let s=0;for(const k in o){s=s+k.length;if(k==='b')delete o.c;if(k==='a')o.z=1}return s};var t=0;for(var k=0;k<3000;k++)t=t+h9(Object.create({p:1},{a:{value:1,enumerable:true,configurable:true,writable:true},b:{value:2,enumerable:true,configurable:true},c:{value:3,enumerable:true,configurable:true}}));t")
  run Testing.expect(isNumber(hot9, 9000.0), "for-in with deleted, added and prototype keys")
  let hot10 = run unsafe evaluate(&mut engine, context, b"function h10(a){let s=0;for(const x of a){s=s+x;if(a.length<8)a.push(1)}return s};var t=0;for(var k=0;k<3000;k++)t=t+h10([1,2,3]);t")
  run Testing.expect(isNumber(hot10, 33000.0), "hot for-of over an Array pushed to while it is stepped")
  let hot11 = run unsafe evaluate(&mut engine, context, b"function h11(a){let s=0;for(const x of a){s=s+(x===undefined?100:x)}return s};var t=0;for(var k=0;k<3000;k++)t=t+h11([1,,3]);t")
  run Testing.expect(isNumber(hot11, 312000.0), "hot for-of over an Array with a hole")
  let hot12 = run unsafe evaluate(&mut engine, context, b"function h12(a){let s=0;for(const x of a){for(const y of a){s=s+x*y}}return s};var t=0;for(var k=0;k<3000;k++)t=t+h12([1,2,3]);t")
  run Testing.expect(isNumber(hot12, 108000.0), "hot for-of over nested for-of over one Array")
  let hot13 = run unsafe evaluate(&mut engine, context, b"function h13(a){let s=0;for(const x of a){s=s+x}return s};var t=0;for(var k=0;k<3000;k++)t=t+h13(k<1500?[1,2]:new Set([5]));t")
  run Testing.expect(isNumber(hot13, 12000.0), "hot for-of over an Array, then a Set at the same site")
  // Destructuring into member targets: for_of_next with an offset, inside try regions.
  let hot15 = run unsafe evaluate(&mut engine, context, b"function h15(s){const o={};try{[o.a,o.b]=new Set([s,s+1])}catch(e){}let r=0;for(const [x,y] of [[o.a,o.b]]){try{r=x+y}catch(e){}}return r};var t=0;for(var k=0;k<3000;k++)t=t+h15(1);t")
  run Testing.expect(isNumber(hot15, 9000.0), "hot destructuring of a Set into member targets")
  // A stand-in record steps a fast Array in compiled code: one generic step per call, the last.
  let stepsBefore = engine.services.jit.env.get(0).genericRuns
  let stepCompiled = engine.services.jit.compiledFunctions
  let hot16 = run unsafe evaluate(&mut engine, context, b"function h16(a){let s=0;for(const x of a){s=s+x}return s};var b=[];for(var i=0;i<100;i++)b.push(i);var t=0;for(var k=0;k<3000;k++)t=t+h16(b);t")
  run Testing.expect(isNumber(hot16, 14850000.0) && engine.services.jit.compiledFunctions > stepCompiled
    && engine.services.jit.env.get(0).genericRuns - stepsBefore < 3 * 3000, "a hot for-of over a fast Array steps it in compiled code")
  // array_from pops its count: a loop header reached by falling in takes its depth from the back edge.
  let literalBefore = engine.services.jit.compiledFunctions
  let hot14 = run unsafe evaluate(&mut engine, context, b"function h14(n){var x=null;var i=0;while(i<n){x=[i,x];i=i+1}return x[0]};var t=0;for(var k=0;k<3000;k++)t=t+h14(5);t")
  run Testing.expect(isNumber(hot14, 12000.0) && engine.services.jit.compiledFunctions > literalBefore, "a hot loop building an array literal compiles")
  engine.services.jit.collect()
  run Testing.expect(engine.services.jit.genericSites > iterSites, "the iteration instructions compile as generic sites")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}
test effect fn hotFunctionsRunCompiledCodeAndDeopt() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut options = Options.make()
  options.enabled = true options.threshold = 20
  let jit = run Jit.make(move options) |> Effect.provideMut<Allocator>(&mut system)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: Compiling { jit: move jit, failures: 0 } }
  unsafe jitRuntime.attach(&mut engine.services.jit, rt)
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: HANDLER }), opaque: Pointer.null<u8>() })
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = run Effect.result(unsafe exercise(&mut engine, context)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), JsException | AssertionError<'static>>.Success { value: _ } => ()
    Result<(), JsException | AssertionError<'static>>.Failure { error } => { fail move error }
  }
}

const BRANCHES: &[u8] = b"function br(x,y){var c=0;if(x<y)c=c+1;if(x<=y)c=c+2;if(x>y)c=c+4;if(x>=y)c=c+8;if(x==y)c=c+16;if(x!=y)c=c+32;if(!(x<y))c=c+64;if(!(x>=y))c=c+128;return c}function lp(x,y){var n=0;for(var d=x;d<y;d=d+1){n=n+1;if(n>5)break}var m=0;for(var e=y;!(e<=x);e=e-1){m=m+1;if(m>5)break}return n*8+m}var I=[1,2,2,1,1,1,-5,3,3,-5,0,0,-2147483648,2147483647,7,-7];var D=[1.5,2,NaN,1,1,NaN,NaN,NaN,0,-0,-0,0,Infinity,1,-Infinity,Infinity,Infinity,Infinity,0.5,0.5,-Infinity,NaN];function phase(P,rounds){var t=0;for(var r=0;r<rounds;r++)for(var p=0;p<P.length;p=p+2)t=(t*31+br(P[p],P[p+1])*7+lp(P[p],P[p+1]))%1000003;return t}"

/// Every branch form on compares, first with int32 operands (fused compare and branch), then,
/// recompiled, with doubles: NaN, -0 and the infinities. Checksums are node's.
unsafe effect fn exerciseBranches<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, BRANCHES)
  let ints = run unsafe evaluate(&mut engine, context, b"phase(I,40)")
  run Testing.expect(isNumber(ints, 685411.0), "int32 compares branch as the interpreter does")
  let doubles = run unsafe evaluate(&mut engine, context, b"phase(D,40)")
  run Testing.expect(isNumber(doubles, 547601.0), "double compares branch false at NaN, and -0 equals 0")
  let again = run unsafe evaluate(&mut engine, context, b"phase(I,5)")
  run Testing.expect(isNumber(again, 552975.0), "ints again, after the double recompile")
  run Testing.expect(engine.services.jit.compiledFunctions >= 2 && engine.services.jit.recompiled >= 1, "br and lp compiled, then recompiled for doubles")
  run Testing.expect(engine.services.failures == 0, "no compile failed")
}
