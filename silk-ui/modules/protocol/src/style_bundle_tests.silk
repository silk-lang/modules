import style_bundle as bundle
import style_bundle { DecodeError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn rejected(bytes: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(bundle.decode(bytes)) {
    Result<List<Bytes>, DecodeError | OutOfMemoryError>.Success { value } => { drop value
      false }
    Result<List<Bytes>, DecodeError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      DecodeError invalid => { drop invalid
        true }
    }
  }
}

effect fn body() -> () ! DecodeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut sources = List<Bytes>.make()
  run sources.append(run Bytes.copy(b"first"))
  run sources.append(run Bytes.copy(b"second"))
  let encoded = run bundle.encode(sources.asSlice())
  let decoded = run bundle.decode(encoded.asSlice())
  run Testing.expect(decoded.length() == 2 && bundle.same(decoded.asSlice()[0].asSlice(), b"first") && bundle.same(decoded.asSlice()[1].asSlice(), b"second"), "bundle preserves payloads and order")
  run Testing.expect(run rejected(Slice.view<u8>(encoded.asSlice(), 0, encoded.length() - 1)), "truncated last payload is rejected")
  let mut trailing = run Bytes.copy(encoded.asSlice())
  run trailing.append(b"x")
  run Testing.expect(run rejected(trailing.asSlice()), "trailing bytes are rejected")
  let mut version = run Bytes.copy(encoded.asSlice())
  let versionBytes = version.asMutSlice()
  versionBytes[8] = 2
  run Testing.expect(run rejected(version.asSlice()), "unknown envelope versions are rejected")
  run Testing.expect(run rejected(b"SILKUIST\x01\x00\x00\x00\xff\xff\xff\xff"), "an unbounded count is rejected before allocation")
  run Testing.expect(run rejected(b"not a stylesheet bundle"), "unrelated data is rejected")
}

test effect fn orderedBundleRejectsIncompleteOrUnboundedInput() -> ()
  ! DecodeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}
