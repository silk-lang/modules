    CipherState.Done => { return unsafe failWith(&mut c.*, b"") }
    _ => ()
  }
  return true
}
fn halvesEqual(key: &[u8]) -> bool {
  let half = key.length / 2
  let mut i: usize = 0
  while i < half { if key[i] != key[half + i] { return false } i = i + 1 }
  return true
}
unsafe fn cipherCreate(c: &mut Call, name: &[u8], key: &[u8], iv: &[u8], encrypt: bool, authTagLength: usize, ctsMode: &[u8]) -> bool {
  let info = cipherByName(name)
  if info.kind == 0 { return unsafe failWith(&mut c.*, b"error:0308010C:digital envelope routines::unsupported") }
  if i32.toUsize(info.keyLength) != key.length { return unsafe refuse(&mut c.*, b"ERR_CRYPTO_INVALID_KEYLEN: Invalid key length") }
  // OpenSSL's XTS init refuses equal key halves for encryption.
  if info.kind == C_XTS && encrypt && halvesEqual(key) { return unsafe failWith(&mut c.*, b"error:1C800095:Provider routines::xts duplicated keys") }
  let p = unsafe calloc(1, Layout.of<CipherContext>().bytes)
  if Pointer.isNull<u8>(p) { return false }
  let ivCopy = if iv.length > 0 { unsafe calloc(1, iv.length) } else { nil() }
  let mut keyBytes: [u8; 64] = [0; 64]
  let family = blocks.blockByName(name).family
  let variant = if same(ctsMode, b"cs3") { 3 } else if same(ctsMode, b"cs2") { 2 } else { 1 }
  let mut i: usize = 0
  while i < key.length { keyBytes[i] = key[i] i = i + 1 }
  i = 0
  while i < iv.length { unsafe Pointer.put<u8>(unsafe at(ivCopy, i), iv[i]) i = i + 1 }
  unsafe Pointer.put<CipherContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut CipherContext>(unsafe nonnull(p)), CipherContext {
    kind: info.kind, family: family, variant: variant, processed: 0, encrypt: encrypt, padding: true, key: keyBytes, keyLength: key.length, iv: ivCopy, ivLength: iv.length,
    aad: nil(), aadLength: 0, tag: [0; 16], tagLength: 0, authTagLength: if authTagLength > 16 { 16 } else { authTagLength }, state: CipherState.Pending })
  c.created = p c.createdKind = 3 c.resultKind = 2
  return true
}
unsafe fn context<'a>(anchor: &'a mut (), p: ?*mut u8) -> &'a mut CipherContext {
  return unsafe Pointer.borrowMut<(), CipherContext>(move anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut CipherContext>(unsafe nonnull(p)))
}

/// Frees a handle the bridge created (kind 1 a hash, 2 an HMAC, 3 a cipher).
pub unsafe fn releaseContext(kind: i32, p: ?*mut u8) -> () {
  if Pointer.isNull<u8>(p) { return () }
  if kind == 1 { let owned = unsafe Pointer.take<HashContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HashContext>(unsafe nonnull(p))) drop owned }
  if kind == 2 { let owned = unsafe Pointer.take<HmacContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HmacContext>(unsafe nonnull(p))) drop owned }
  if kind == 3 {
    let owned = unsafe Pointer.take<CipherContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut CipherContext>(unsafe nonnull(p)))
    unsafe cleanse(owned.iv, owned.ivLength) unsafe free(owned.iv) unsafe free(owned.aad)
    drop owned
  }
  unsafe cleanse(p, 32)
  unsafe free(p)
}
unsafe fn newHash(c: &mut Call, code: i32) -> bool {
  let p = unsafe calloc(1, Layout.of<HashContext>().bytes)
  if Pointer.isNull<u8>(p) { return false }
  unsafe Pointer.put<HashContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HashContext>(unsafe nonnull(p)), HashContext { code: code, state: hashMake(code) })
  c.created = p c.createdKind = 1 c.resultKind = 2
  return true
}
// The lists Node shows (crypto.getHashes, getCiphers): OpenSSL's names, sorted.
const HASH_NAMES: &[u8] = b"RSA-MD5\nRSA-RIPEMD160\nRSA-SHA1\nRSA-SHA1-2\nRSA-SHA224\nRSA-SHA256\nRSA-SHA3-224\nRSA-SHA3-256\nRSA-SHA3-384\nRSA-SHA3-512\nRSA-SHA384\nRSA-SHA512\nRSA-SHA512/224\nRSA-SHA512/256\nRSA-SM3\nblake2b-512\nblake2b512\nblake2s-256\nblake2s256\nid-rsassa-pkcs1-v1_5-with-sha3-224\nid-rsassa-pkcs1-v1_5-with-sha3-256\nid-rsassa-pkcs1-v1_5-with-sha3-384\nid-rsassa-pkcs1-v1_5-with-sha3-512\nmd5\nmd5-sha1\nmd5WithRSAEncryption\nripemd\nripemd-160\nripemd160\nripemd160WithRSA\nrmd160\nsha-1\nsha-224\nsha-256\nsha-384\nsha-512\nsha-512/224\nsha-512/256\nsha1\nsha1WithRSAEncryption\nsha2-224\nsha2-256\nsha2-384\nsha2-512\nsha2-512/224\nsha2-512/256\nsha224\nsha224WithRSAEncryption\nsha256\nsha256WithRSAEncryption\nsha3-224\nsha3-256\nsha3-384\nsha3-512\nsha384\nsha384WithRSAEncryption\nsha512\nsha512-224\nsha512-224WithRSAEncryption\nsha512-256\nsha512-256WithRSAEncryption\nsha512WithRSAEncryption\nshake128\nshake256\nsm3\nsm3WithRSAEncryption\nssl3-md5\nssl3-sha1\n"
const CIPHER_NAMES: &[u8] = b"aes-128-cbc\naes-128-cbc-cts\naes-128-ccm\naes-128-cfb\naes-128-cfb1\naes-128-cfb8\naes-128-ctr\naes-128-ecb\naes-128-gcm\naes-128-ocb\naes-128-ofb\naes-128-wrap\naes-128-wrap-pad\naes-128-xts\naes-192-cbc\naes-192-cbc-cts\naes-192-ccm\naes-192-cfb\naes-192-cfb1\naes-192-cfb8\naes-192-ctr\naes-192-ecb\naes-192-gcm\naes-192-ocb\naes-192-ofb\naes-192-wrap\naes-192-wrap-pad\naes-256-cbc\naes-256-cbc-cts\naes-256-ccm\naes-256-cfb\naes-256-cfb1\naes-256-cfb8\naes-256-ctr\naes-256-ecb\naes-256-gcm\naes-256-ocb\naes-256-ofb\naes-256-wrap\naes-256-wrap-pad\naes-256-xts\naes128\naes128-wrap\naes128-wrap-pad\naes192\naes192-wrap\naes192-wrap-pad\naes256\naes256-wrap\naes256-wrap-pad\naria-128-cbc\naria-128-cfb\naria-128-cfb1\naria-128-cfb8\naria-128-ctr\naria-128-ecb\naria-128-ofb\naria-192-cbc\naria-192-cfb\naria-192-cfb1\naria-192-cfb8\naria-192-ctr\naria-192-ecb\naria-192-ofb\naria-256-cbc\naria-256-cfb\naria-256-cfb1\naria-256-cfb8\naria-256-ctr\naria-256-ecb\naria-256-ofb\naria128\naria192\naria256\ncamellia-128-cbc\ncamellia-128-cbc-cts\ncamellia-128-cfb\ncamellia-128-cfb1\ncamellia-128-cfb8\ncamellia-128-ctr\ncamellia-128-ecb\ncamellia-128-ofb\ncamellia-192-cbc\ncamellia-192-cbc-cts\ncamellia-192-cfb\ncamellia-192-cfb1\ncamellia-192-cfb8\ncamellia-192-ctr\ncamellia-192-ecb\ncamellia-192-ofb\ncamellia-256-cbc\ncamellia-256-cbc-cts\ncamellia-256-cfb\ncamellia-256-cfb1\ncamellia-256-cfb8\ncamellia-256-ctr\ncamellia-256-ecb\ncamellia-256-ofb\ncamellia128\ncamellia192\ncamellia256\nchacha20\nchacha20-poly1305\ndes-ede\ndes-ede-cbc\ndes-ede-cfb\ndes-ede-ecb\ndes-ede-ofb\ndes-ede3\ndes-ede3-cbc\ndes-ede3-cfb\ndes-ede3-cfb1\ndes-ede3-cfb8\ndes-ede3-ofb\ndes3\ndes3-wrap\nid-aes128-ccm\nid-aes128-gcm\nid-aes128-wrap\nid-aes128-wrap-pad\nid-aes192-ccm\nid-aes192-gcm\nid-aes192-wrap\nid-aes192-wrap-pad\nid-aes256-ccm\nid-aes256-gcm\nid-aes256-wrap\nid-aes256-wrap-pad\nid-smime-alg-cms3deswrap\nsm4\nsm4-cbc\nsm4-cfb\nsm4-cfb128\nsm4-ctr\nsm4-ecb\nsm4-ofb\nsm4-ofb128\n"
/// A text result, for the other files.
pub unsafe fn emitText(c: &mut Call, value: &[u8]) -> bool { return unsafe text(&mut c.*, value) }
unsafe fn text(c: &mut Call, value: &[u8]) -> bool {
  c.resultKind = 3
  if !unsafe reserve(&mut c.*, value.length) { return false }
  let mut anchor = ()
  let out = unsafe outputSlice(&mut anchor, &c.*)
  let mut i: usize = 0
  while i < value.length { out[i] = value[i] i = i + 1 }
  return true
}
unsafe fn word(c: &mut Call, offset: usize, value: i32) -> () {
  let bits = i32.wrappingToU32(value)
  let mut i: usize = 0
  while i < 4 { unsafe Pointer.put<u8>(unsafe at(c.output, offset + i), u32.wrappingToU8(u32.shiftRight(bits, usize.toU32(i * 8)))) i = i + 1 }
}

/// Runs operation `c.op`; false on failure (with the error left in `c.error`).
pub unsafe fn execute(c: &mut Call) -> bool {
  let op = c.op
  let anchor = ()
  if op == 1 {
    let size = i64.toUsize(c.numbers[0])
    if !unsafe reserve(&mut c.*, size) { return false }
    if c.length > 0 {
      let mut a = ()
      let out = unsafe writable(&mut a, c.output, c.length)
      let mut random = OsRandom.make()
      run Random.fillBytes(move out) |> Effect.provideMut<Random>(&mut random)
    }
    return true
  }
  if op == 2 {
    c.resultKind = 1 c.result = 0
    if c.lengths[0] != c.lengths[1] { return false }
    let x = unsafe arg(&anchor, &c.*, 0) let y = unsafe arg(&anchor, &c.*, 1)
    let mut difference: u8 = 0
    let mut i: usize = 0
    while i < x.length { difference = difference | (x[i] ^ y[i]) i = i + 1 }
    if difference == 0 { c.result = 1 }
    return true
  }
  if op == 3 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 4))
    if code == 0 || isXof(code) { return unsafe failWith(&mut c.*, b"") }
    let length = i64.toUsize(c.numbers[3])
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut a = ()
    let out = unsafe writable(&mut a, c.output, c.capacity)
    let output = Slice.viewMut<u8>(move out, 0, c.length)
    return pbkdf2With(code, unsafe arg(&anchor, &c.*, 0), unsafe arg(&anchor, &c.*, 1), i64.toU32(c.numbers[2]), move output)
  }
  if op == 4 {
    let length = i64.toUsize(c.numbers[2])
    let cost = i64.toU64(c.numbers[3]) let blockSize = i64.toU32(c.numbers[4]) let parallelism = i64.toU32(c.numbers[5])
    let limit = i64.toU64(c.numbers[6])
    let memory = Scrypt.memoryLength(cost, blockSize, parallelism)
    let fits = match move memory { Option<u64>.Some { value } => limit == 0 || value <= limit Option<u64>.None => false }
    if !fits { return unsafe failWith(&mut c.*, b"error:030000AC:digital envelope routines::memory limit exceeded") }
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut a = ()
    let out = unsafe writable(&mut a, c.output, c.capacity)
    let output = Slice.viewMut<u8>(move out, 0, length)
    let mut allocator = Allocator.systemAllocatorProvider()
    let derived = run Effect.result(Scrypt.derive(unsafe arg(&anchor, &c.*, 0), unsafe arg(&anchor, &c.*, 1), cost, blockSize, parallelism, move output)) |> Effect.provideMut<Allocator>(&mut allocator)
    return match move derived { Result<(), OutOfMemoryError | ScryptError>.Success { .. } => true Result<(), OutOfMemoryError | ScryptError>.Failure { .. } => unsafe failWith(&mut c.*, b"") }
  }
  if op == 5 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 || isXof(code) { return unsafe failWith(&mut c.*, b"") }
    let length = i64.toUsize(c.numbers[4])
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut a = ()
    let out = unsafe writable(&mut a, c.output, c.capacity)
    return hkdfWith(code, unsafe arg(&anchor, &c.*, 2), unsafe arg(&anchor, &c.*, 1), unsafe arg(&anchor, &c.*, 3), Slice.viewMut<u8>(move out, 0, length))
  }
  if op == 6 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 { return unsafe failWith(&mut c.*, b"") }
    let length = if c.numbers[3] == 1 { i64.toUsize(c.numbers[2]) } else { digestSize(code) }
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut state = hashMake(code)
    hashUpdate(&mut state, unsafe arg(&anchor, &c.*, 1))
    let mut a = ()
    let out = unsafe writable(&mut a, c.output, c.capacity)
    hashFinish(move state, Slice.viewMut<u8>(move out, 0, length))
    return true
  }
  if op == 8 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 || isXof(code) { return unsafe failWith(&mut c.*, b"") }
    let length = digestSize(code)
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut state = hmacMake(code, unsafe arg(&anchor, &c.*, 1))
    hmacUpdate(&mut state, unsafe arg(&anchor, &c.*, 2))
    let mut a = ()
    let out = unsafe writable(&mut a, c.output, c.capacity)
    hmacFinish(move state, Slice.viewMut<u8>(move out, 0, length))
    return true
  }
  if op == 9 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 { return false }
    c.resultKind = 1 c.result = usize.toI64(digestSize(code))
    return true
  }
  if op == 10 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 { return unsafe failWith(&mut c.*, b"") }
    return unsafe newHash(&mut c.*, code)
  }
  if op == 11 || op == 12 || op == 13 {
    let mut a = ()
    let h = unsafe Pointer.borrowMut<(), HashContext>(&mut a, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HashContext>(unsafe nonnull(c.handle)))
    if op == 11 { hashUpdate(&mut h.state, unsafe arg(&anchor, &c.*, 1)) c.resultKind = 4 return true }
    if op == 13 {
      let copied = hashCopy(&h.state) let code = h.code drop h
      let p = unsafe calloc(1, Layout.of<HashContext>().bytes)
      if Pointer.isNull<u8>(p) { return false }
      unsafe Pointer.put<HashContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HashContext>(unsafe nonnull(p)), HashContext { code: code, state: move copied })
      c.created = p c.createdKind = 1 c.resultKind = 2
      return true
    }
    // hashFinal: the state is consumed, so a copy finishes and the handle keeps its state.
    let code = h.code
    if c.numbers[1] >= 0 && !isXof(code) && i64.toUsize(c.numbers[1]) != digestSize(code) { return unsafe failWith(&mut c.*, b"error:1C80008B:Provider routines::xof is not supported") }
    let length = if c.numbers[1] >= 0 { i64.toUsize(c.numbers[1]) } else { digestSize(code) }
    let copied = hashCopy(&h.state) drop h
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut b = ()
    let out = unsafe writable(&mut b, c.output, c.capacity)
    hashFinish(move copied, Slice.viewMut<u8>(move out, 0, length))
    return true
  }
  if op == 14 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 || isXof(code) { return unsafe failWith(&mut c.*, b"") }
    let p = unsafe calloc(1, Layout.of<HmacContext>().bytes)
    if Pointer.isNull<u8>(p) { return false }
    unsafe Pointer.put<HmacContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HmacContext>(unsafe nonnull(p)), HmacContext { code: code, state: hmacMake(code, unsafe arg(&anchor, &c.*, 1)) })
    c.created = p c.createdKind = 2 c.resultKind = 2
    return true
  }
  if op == 15 {
    let mut a = ()
    let h = unsafe Pointer.borrowMut<(), HmacContext>(&mut a, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HmacContext>(unsafe nonnull(c.handle)))
    hmacUpdate(&mut h.state, unsafe arg(&anchor, &c.*, 1))
    c.resultKind = 4
    return true
  }
  if op == 16 {
    // HMAC_Final once: the state goes and an empty one (the same key's) is left in its place.
    let target = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HmacContext>(unsafe nonnull(c.handle))
    let owned = unsafe Pointer.take<HmacContext>(target)
    let code = owned.code
    unsafe Pointer.put<HmacContext>(target, HmacContext { code: code, state: hmacMake(code, Slice.view<u8>(&EMPTY, 0, 0)) })
    let length = digestSize(code)
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut b = ()
    let out = unsafe writable(&mut b, c.output, c.capacity)
    hmacFinish(move owned.state, Slice.viewMut<u8>(move out, 0, length))
    return true
  }
  if op == 20 {
    let name = unsafe arg(&anchor, &c.*, 0) let key = unsafe arg(&anchor, &c.*, 1) let iv = unsafe arg(&anchor, &c.*, 2)
    let encrypt = c.numbers[3] == 1 let tagLength = i64.toUsize(c.numbers[4])
    let ctsMode = unsafe arg(&anchor, &c.*, 6)
    return unsafe cipherCreate(&mut c.*, name, key, iv, encrypt, tagLength, Slice.view<u8>(ctsMode, 0, endsWithNull(ctsMode)))
  }
  if op >= 21 && op <= 26 {
    let mut a = ()
    let x = unsafe context(&mut a, c.handle)
    if op == 21 { let input = unsafe arg(&anchor, &c.*, 1) return unsafe cipherUpdate(&mut c.*, &mut x.*, input) }
    if op == 22 { return unsafe cipherFinal(&mut c.*, &mut x.*) }
    c.resultKind = 4
    if op == 23 {
      // Additional data: only before the first update, and only for the AEAD ciphers.
      match &x.state { CipherState.Pending => () _ => { return false } }
      if x.kind != C_GCM && x.kind != C_CHACHA_POLY && x.kind != C_CCM && x.kind != C_OCB { return false }
      let aad = unsafe arg(&anchor, &c.*, 1)
      let grown = unsafe realloc(x.aad, x.aadLength + aad.length + 1)
      if Pointer.isNull<u8>(grown) { return false }
      x.aad = grown
      let mut i: usize = 0
      while i < aad.length { unsafe Pointer.put<u8>(unsafe at(x.aad, x.aadLength + i), aad[i]) i = i + 1 }
      x.aadLength = x.aadLength + aad.length
      return true
    }
    if op == 24 {
      let tag = unsafe arg(&anchor, &c.*, 1)
      if x.encrypt || tag.length > 16 || tag.length == 0 { return false }
      let mut i: usize = 0
      while i < tag.length { x.tag[i] = tag[i] i = i + 1 }
      x.tagLength = tag.length
      return true
    }
    if op == 25 {
      let length = i64.toUsize(c.numbers[1])
      if !x.encrypt || length > x.tagLength { return false }
      let tag = x.tag
      drop x
      c.resultKind = 0
      if !unsafe reserve(&mut c.*, length) { return false }
      let mut i: usize = 0
      while i < length { unsafe Pointer.put<u8>(unsafe at(c.output, i), tag[i]) i = i + 1 }
      return true
    }
    // cipherPadding: only for the block modes, and before the first update.
    match &x.state { CipherState.Pending => () _ => { return false } }
    x.padding = c.numbers[1] != 0
    return true
  }
  if op == 7 {
    // cipherOnce: name, key, iv, input, encrypt, aad, tag (to open), tag length (to seal).
    let encrypt = c.numbers[4] == 1
    let name = unsafe arg(&anchor, &c.*, 0) let key = unsafe arg(&anchor, &c.*, 1) let iv = unsafe arg(&anchor, &c.*, 2)
    let sealTag = i64.toUsize(c.numbers[7])
    if !unsafe cipherCreate(&mut c.*, name, key, iv, encrypt, sealTag, Slice.view<u8>(&EMPTY, 0, 0)) { return false }
    let p = c.created c.created = nil() c.createdKind = 0 c.resultKind = 0
    let mut a = ()
    let x = unsafe context(&mut a, p)
    let info = cipherByName(unsafe arg(&anchor, &c.*, 0))
    if !encrypt && (x.kind == C_GCM || x.kind == C_CHACHA_POLY || x.kind == C_CCM || x.kind == C_OCB) {
      let tag = unsafe arg(&anchor, &c.*, 6)
      let mut i: usize = 0
      while i < tag.length && i < 16 { x.tag[i] = tag[i] i = i + 1 }
      x.tagLength = tag.length
    }
    let aad = unsafe arg(&anchor, &c.*, 5)
    if aad.length > 0 {
      x.aad = unsafe calloc(1, aad.length)
      let mut i: usize = 0
      while i < aad.length { unsafe Pointer.put<u8>(unsafe at(x.aad, i), aad[i]) i = i + 1 }
      x.aadLength = aad.length
    }
    let _unused = info
    let input = unsafe arg(&anchor, &c.*, 3)
    let mut ok = unsafe cipherUpdate(&mut c.*, &mut x.*, input)
    let first = c.output let firstLength = c.length
    c.output = nil() c.capacity = 0
    ok = ok && unsafe cipherFinal(&mut c.*, &mut x.*)
    let tagLength = if encrypt && (x.kind == C_GCM || x.kind == C_CHACHA_POLY || x.kind == C_CCM || x.kind == C_OCB) { x.tagLength } else { 0 }
    let tag = x.tag
    drop x
    if ok {
      let second = c.output let secondLength = c.length
      c.output = nil()
      if unsafe reserve(&mut c.*, firstLength + secondLength + tagLength) {
        let mut i: usize = 0
        while i < firstLength { unsafe Pointer.put<u8>(unsafe at(c.output, i), unsafe Pointer.read<u8>(unsafe at(first, i))) i = i + 1 }
        i = 0
        while i < secondLength { unsafe Pointer.put<u8>(unsafe at(c.output, firstLength + i), unsafe Pointer.read<u8>(unsafe at(second, i))) i = i + 1 }
        i = 0
        while i < tagLength { unsafe Pointer.put<u8>(unsafe at(c.output, firstLength + secondLength + i), tag[i]) i = i + 1 }
      } else { ok = false }
      unsafe free(second)
    }
    unsafe free(first)
    unsafe releaseContext(3, p)
    return ok
  }
  if op == 60 { return unsafe text(&mut c.*, HASH_NAMES) }
  if op == 61 { return unsafe text(&mut c.*, CIPHER_NAMES) }
  if op == 63 || op == 79 || op == 84 || op == 71 || op == 77 || op == 72 { c.resultKind = 1 c.result = 0 return true }
  // setFips: accepted; without a FIPS provider nothing changes, as getFips keeps reporting.
  if op == 64 { c.resultKind = 4 return true }
  if op == 78 { c.resultKind = 1 c.result = 1 return true }
  if op == 83 { c.resultKind = 1 c.result = 1 return true }
  if op == 82 || op == 85 { c.resultKind = 4 return true }
  if op == 68 {
    c.resultKind = 4
    let info = if c.numbers[3] != 0 { cipherByNid(i64.toI32(c.numbers[0])) } else { cipherByName(unsafe arg(&anchor, &c.*, 0)) }
    if info.kind == 0 { return true }
    let mut keyLength = info.keyLength let mut ivLength = info.ivLength
    if c.numbers[4] != 0 { if i64.toI32(c.numbers[1]) != info.keyLength { return true } keyLength = i64.toI32(c.numbers[1]) }
    if c.numbers[5] != 0 {
      let wanted = i64.toI32(c.numbers[2])
      if info.kind == C_GCM { if wanted < 1 { return true } }
      else if info.kind == C_CHACHA_POLY { if wanted < 1 || wanted > 12 { return true } }
      else if info.kind == C_CCM { if wanted < 7 || wanted > 13 { return true } }
      else if info.kind == C_OCB { if wanted < 1 || wanted > 15 { return true } }
      else if wanted != info.ivLength { return true }
      ivLength = wanted
    }
    c.resultKind = 0
    if !unsafe reserve(&mut c.*, 20 + info.name.length) { return false }
    unsafe word(&mut c.*, 0, info.mode) unsafe word(&mut c.*, 4, info.nid) unsafe word(&mut c.*, 8, info.blockSize)
    unsafe word(&mut c.*, 12, keyLength) unsafe word(&mut c.*, 16, ivLength)
    let mut i: usize = 0
    while i < info.name.length { unsafe Pointer.put<u8>(unsafe at(c.output, 20 + i), info.name[i]) i = i + 1 }
    return true
  }
  return unsafe refuse(&mut c.*, b"ERR_CRYPTO_UNSUPPORTED_OPERATION: this operation is not available with SilkCrypto")
}

// For ext/crypto_keys: digests by code, and wiping.
pub fn digestLength(code: i32) -> usize { return digestSize(code) }
pub struct Digester { state: HashState }
pub fn newDigest(code: i32) -> Digester { return Digester { state: hashMake(code) } }
pub fn digestUpdate(d: &mut Digester, bytes: &[u8]) -> () { hashUpdate(&mut d.state, bytes) }
pub fn digestFinish(d: Digester, output: &mut [u8]) -> () { hashFinish(move d.state, move output) }
/// Zeroes a buffer that held key material.
pub fn wipe(bytes: &mut [u8]) -> () { let mut i: usize = 0 while i < bytes.length { bytes[i] = 0 i = i + 1 } }
