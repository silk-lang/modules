//! Window events to tree input. Positions and point deltas are logical points, which are CSS
//! pixels; wheel notches become [`LINE_PIXELS`] each. modules/platform/window's scroll deltas are
//! positive when content moves down, the tree's when it scrolls down, so the sign flips.
import accessibility
import accessibility { Bridge, Publisher }
import platform_thread { AccessLink, HostPlatform }
import silk.core.effect { Effect }
import keys { codeName, keyName }
import window.event { Event, Key, MouseButton, Phase, ScrollDelta, Modifiers, EditCommand as WindowEditCommand }
import window.menu { MenuBar, Shortcut }
import ui_tree.input { EditCommand }
import window.types { Wait }
import silk.geometry.vector { Vector2 }
import window.types { Cursor as WindowCursor, CursorImage as WindowCursorImage, ImeState, WindowId, Appearance }
import window.platform { Platform }
import ui_tree.legacy { UiTree, Input, Cursor, HostRequest, ImeArea, NodeInfo }
import ui_tree.lib { RootEventKind }
import ui_tree.css_cursor { CursorImage }
import ui_tree.resources { CursorPixels }
import ui_tree.mutation { FIRST_ROOT }
import ui_tree.inspect
import ui_tree.mutation { LISTEN_WHEEL, NodeKind }
import ui_tree.scrollbar { usedOverflow, userScrolls }
import render_thread { FastScroll, ScrollerAxes }
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.core.result { Result }
import silk.text.string { InvalidUtf8 }
import window.clipboard { ClipboardEntry }
import silk.collections.slice { Slice }
import silk.geometry.rect { Rect }
import silk.num.f32
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.usize
import silk.num.u32
import silk.text.string { String }

/// CSS pixels per wheel notch, as browsers scroll.
pub const LINE_PIXELS: f32 = 40.0

/// The DOM button number of a window mouse button.
pub fn buttonOf(button: MouseButton) -> u32 {
  return match button {
    MouseButton.Left => 0
    MouseButton.Middle => 1
    MouseButton.Right => 2
    MouseButton.Back => 3
    MouseButton.Forward => 4
    MouseButton.Other => 5
  }
}

/// The tree's `MOD_*` bits: shift, control, alt and meta, as modules/platform/window packs them.
pub fn modifierBits(modifiers: Modifiers) -> u32 {
  return u32.bitAnd(modifiers.bits(), 15)
}

fn f(value: f64) -> f32 {
  return f64.toF32(value)
}

effect fn keyText(key: &Key) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &key.* {
    Key.Character { text } => run String.copy(String.view(&text))
    Key.Named { key: named } => run String.copy(keyName(named))
  }
}

/// Tells the tree what happened to the window, which shows the first root: its size, scale,
/// focus and appearance, and a request to close it. The client hears these as root events.
pub effect fn reportWindow(tree: &mut UiTree<'_>, event: &Event) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run reportWindowOf(&mut tree, FIRST_ROOT, event)
}

/// [`reportWindow`] for the window that shows root `root`.
pub effect fn reportWindowOf(tree: &mut UiTree<'_>, root: u32, event: &Event) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &event.* {
    Event.Resized { size, .. } => {
      run tree.reportRoot(
        root,
        RootEventKind.Resized { width: f(size.width), height: f(size.height) },
      )
    }
    Event.ScaleFactorChanged { scaleFactor, .. } => {
      run tree.reportRoot(root, RootEventKind.ScaleChanged { scale: f(scaleFactor) })
    }
    Event.Focused { focused, .. } => {
      run tree.reportRoot(
        root,
        if focused {
          RootEventKind.Focused
        } else {
          RootEventKind.Blurred
        },
      )
    }
    Event.AppearanceChanged { appearance } => {
      let dark = match appearance {
        Appearance.Dark => true
        _ => false
      }
      run tree.reportRoot(root, RootEventKind.AppearanceChanged { dark: dark })
    }
    Event.CloseRequested { .. } => {
      run tree.reportRoot(root, RootEventKind.CloseRequested)
    }
    _ => {}
  }
}

/// The tree input for a window event, or None for events the tree does not take (frames and
/// window state). Keys the input method handled stay with it. Touches are stamped with time 0;
/// hosts with a clock use [`toInputAt`], so a flick knows its speed.
pub effect fn toInput(event: &Event) -> Option<Input>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run toInputAt(event, 0.0)
}

/// [`toInput`] with `time`, the host's monotonic clock in seconds, on touch input.
pub effect fn toInputAt(event: &Event, time: f64) -> Option<Input>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &event.* {
    Event.Touch { id, position, phase, modifiers, .. } => {
      let x = f(position.x)
      let y = f(position.y)
      let bits = modifierBits(modifiers)
      return match phase {
        Phase.Began => Option<Input>.Some { value: Input.TouchStart { id: id, x: x, y: y, modifiers: bits, time: time } }
        Phase.Changed => Option<Input>.Some { value: Input.TouchMove { id: id, x: x, y: y, modifiers: bits, time: time } }
        Phase.Ended => Option<Input>.Some { value: Input.TouchEnd { id: id, x: x, y: y, modifiers: bits, time: time } }
        Phase.Cancelled => Option<Input>.Some { value: Input.TouchCancel { id: id } }
        _ => Option<Input>.None
      }
    }
    Event.Pinch { position, delta, .. } => Option<Input>.Some {
      value: Input.Pinch { x: f(position.x), y: f(position.y), delta: f(delta), modifiers: 0 },
    }
    Event.MouseMoved { position, modifiers, .. } => Option<Input>.Some {
      value: Input.PointerMove {
        x: f(position.x),
        y: f(position.y),
        modifiers: modifierBits(modifiers),
      },
    }
    Event.MouseDown { button, position, modifiers, clickCount, .. } => Option<Input>.Some {
      value: Input.PointerDown {
        x: f(position.x),
        y: f(position.y),
        button: buttonOf(button),
        modifiers: modifierBits(modifiers),
        clickCount: clickCount,
      },
    }
    Event.MouseUp { button, position, modifiers, .. } => Option<Input>.Some {
      value: Input.PointerUp {
        x: f(position.x),
        y: f(position.y),
        button: buttonOf(button),
        modifiers: modifierBits(modifiers),
      },
    }
    Event.MouseExited { .. } => Option<Input>.Some { value: Input.PointerLeave }
    Event.Focused { focused, .. } => if focused {
      Option<Input>.None
    } else {
      Option<Input>.Some { value: Input.PointerCancel }
    }
    Event.Scroll { position, delta, modifiers, .. } => {
      let mut dx: f32 = 0.0
      let mut dy: f32 = 0.0
      match delta {
        ScrollDelta.Lines { delta: lines } => {
          dx = -f(lines.x) * LINE_PIXELS
          dy = -f(lines.y) * LINE_PIXELS
        }
        ScrollDelta.Points { delta: points } => {
          dx = -f(points.x)
          dy = -f(points.y)
        }
      }
      return Option<Input>.Some {
        value: Input.Wheel {
          x: f(position.x),
          y: f(position.y),
          deltaX: dx,
          deltaY: dy,
          modifiers: modifierBits(modifiers),
        },
      }
    }
    Event.KeyDown { key, code, modifiers, repeat, imeHandled, .. } => if imeHandled {
      Option<Input>.None
    } else {
      Option<Input>.Some {
        value: Input.KeyDown {
          key: run keyText(&key),
          code: run String.copy(codeName(code)),
          modifiers: modifierBits(modifiers),
          repeat: repeat,
        },
      }
    }
    Event.KeyUp { key, code, modifiers, .. } => Option<Input>.Some {
      value: Input.KeyUp {
        key: run keyText(&key),
        code: run String.copy(codeName(code)),
        modifiers: modifierBits(modifiers),
      },
    }
    Event.TextInput { text, .. } => Option<Input>.Some {
      value: Input.TextInput { text: run String.copy(String.view(&text)) },
    }
    Event.ImePreedit { text, selectionStart, selectionEnd, .. } => Option<Input>.Some {
      value: Input.ImePreedit {
        text: run String.copy(String.view(&text)),
        selectionStart: selectionStart,
        selectionEnd: selectionEnd,
      },
    }
    Event.EditCommand { command, .. } => Option<Input>.Some {
      value: Input.Command { command: editCommand(command) },
    }
    _ => Option<Input>.None
  }
}

fn editCommand(command: WindowEditCommand) -> EditCommand {
  return match command {
    WindowEditCommand.Undo => EditCommand.Undo
    WindowEditCommand.Redo => EditCommand.Redo
    WindowEditCommand.Cut => EditCommand.Cut
    WindowEditCommand.Copy => EditCommand.Copy
    WindowEditCommand.Paste => EditCommand.Paste
    WindowEditCommand.SelectAll => EditCommand.SelectAll
  }
}

/// The first action of the edit menu `serve` opens for `HostRequest.ShowEditMenu`: each item
/// comes back as `Event.MenuAction` with this plus its `EditCommand` index (undo 0 to select
/// all 5), which `editMenuEvent` turns into the `Event.EditCommand` it stands for.
pub const EDIT_MENU_ACTION: u32 = 4293918720

/// `event` as the host should handle it: an item of the edit menu becomes the edit command of
/// `window`, the one whose input opened it; every other event stays as it is.
pub fn editMenuEvent(event: Event, window: WindowId) -> Event {
  if let Event.MenuAction { action } = &event {
    if action >= EDIT_MENU_ACTION && action <= EDIT_MENU_ACTION + 5 {
      let index = action - EDIT_MENU_ACTION
      let command = if index == 0 {
        WindowEditCommand.Undo
      } else if index == 1 {
        WindowEditCommand.Redo
      } else if index == 2 {
        WindowEditCommand.Cut
      } else if index == 3 {
        WindowEditCommand.Copy
      } else if index == 4 {
        WindowEditCommand.Paste
      } else {
        WindowEditCommand.SelectAll
      }
      return Event.EditCommand { window: window, command: command }
    }
  }
  return move event
}

/// Dispatches `event` to `tree` when it is input. Returns whether it was.
pub effect fn feed(tree: &mut UiTree<'_>, event: &Event) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  match run toInput(event) {
    Option<Input>.Some { value } => {
      run tree.dispatch(move value)
      return true
    }
    Option<Input>.None => {
      return false
    }
  }
}

/// What the host last told the platform about the tree, so [`serve`] only calls it on a
/// change.
pub struct HostState {
  pub ime: ImeArea,
  pub imeSet: bool,
  /// What the window's assistive technology was last sent.
  publisher: Publisher,
  /// The window's accessibility adapter, when this thread runs the platform.
  bridge: Bridge,
  /// The platform thread's accessibility link, when the platform runs on its own thread.
  access: Option<AccessLink>,
}

impl HostState {
  pub fn make() -> HostState {
    return HostState {
      ime: ImeArea.none(),
      imeSet: false,
      publisher: Publisher.make(),
      bridge: Bridge.make(),
      access: Option<AccessLink>.None,
    }
  }

  /// The state for a host whose platform is `platform`.
  pub fn of(platform: &HostPlatform) -> HostState {
    let mut state = HostState.make()
    state.access = platform.accessLink()
    return move state
  }
}

/// Answers the tree's requests through `platform` for `window`: clipboard writes, clipboard
/// reads (pasted back with `Input.Paste`), and the input method's state and caret rectangle,
/// set when they change. Call it after dispatching input and after each frame.
pub effect fn serve<P: Platform>(
  platform: &mut P,
  window: WindowId,
  tree: &mut UiTree<'_>,
  state: &mut HostState,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &state.access {
    Option<AccessLink>.Some { value } => {
      // The platform thread talks to the OS; this side sends updates and answers actions.
      let mut requests = run value.take(window)
      run accessibility.apply(&mut tree, &mut requests)
      match run state.publisher.next(&tree.*, value.wanted(window)) {
        Option.Some { value: update } => run value.publish(window, move update)
        Option.None => {}
      }
    }
    Option<AccessLink>.None => {
      state.bridge.attach(window, platform.rawSurface(window))
      let mut requests = run state.bridge.takeRequests()
      run accessibility.apply(&mut tree, &mut requests)
      match run state.publisher.next(&tree.*, state.bridge.wanted()) {
        Option.Some { value: update } => run state.bridge.update(move update, true)
        Option.None => {}
      }
    }
  }
  run serveInput(&mut platform, window, &mut tree, &mut state)
}

/// Runs the input the tree queued for itself (`UiTree.takeFollowUp`) for a host whose client
/// has no say in defaults, serving what each asks. Hosts that decide per event run them
/// through `begin` and `finish` instead, as `runWindow` does.
pub effect fn runFollowUps<P: Platform>(
  platform: &mut P,
  window: WindowId,
  tree: &mut UiTree<'_>,
  state: &mut HostState,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  while true {
    match tree.takeFollowUp() {
      Option<Input>.Some { value: next } => {
        run tree.dispatch(move next)
        run serve(&mut platform, window, &mut tree, &mut state)
      }
      Option<Input>.None => {
        break
      }
    }
  }
}

/// What the clipboard holds, as the `Input.Paste` for `target`: its plain text, its HTML, and
/// a PNG image, each empty when it has none.
pub effect fn readPaste<P: Platform>(platform: &mut P, target: u32) -> Input
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = match run platform.readClipboard() {
    Option<String>.Some { value } => move value
    Option<String>.None => String.make()
  }
  let types = run platform.clipboardTypes()
  let mut html = String.make()
  let mut image = List<u8>.make()
  let mut t: usize = 0
  while t < types.length() {
    let mime = types.asSlice()[t].view()
    if mime == "text/html" {
      if let Option<Bytes>.Some { value } = run platform.readClipboardType(mime) {
        if let Result<string, InvalidUtf8>.Success { value: markup } = String.fromUtf8(value.asSlice()) {
          html = run String.copy(markup)
        }
      }
    } else if mime == "image/png" {
      if let Option<Bytes>.Some { value } = run platform.readClipboardType(mime) {
        run image.appendSlice(value.asSlice())
      }
    }
    t = t + 1
  }
  return Input.Paste { target: target, text: move text, html: move html, image: move image }
}

/// What `serve` does but accessibility: the clipboard and the input method, for a window
/// whose root is current.
pub effect fn serveInput<P: Platform>(
  platform: &mut P,
  window: WindowId,
  tree: &mut UiTree<'_>,
  state: &mut HostState,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut requests = List<HostRequest>.make()
  run tree.takeRequests(&mut requests)
  let values = requests.asSlice()
  let mut i: usize = 0
  while i < values.length {
    match &values[i] {
      HostRequest.WriteClipboard { text } => {
        run platform.writeClipboard(String.view(&text))
      }
      HostRequest.WriteClipboardItem { text, html } => {
        let mut entries = List<ClipboardEntry>.make()
        run entries.append(ClipboardEntry {
          mime: run String.copy("text/plain"),
          data: run Bytes.copy(String.utf8Bytes(String.view(&text))),
        })
        if String.byteLength(String.view(&html)) > 0 {
          run entries.append(ClipboardEntry {
            mime: run String.copy("text/html"),
            data: run Bytes.copy(String.utf8Bytes(String.view(&html))),
          })
        }
        run platform.writeClipboardItem(entries.asSlice())
      }
      HostRequest.ShowEditMenu { x, y, cut, copy, paste } => {
        let mut menu = MenuBar.make()
        run menu.item("Cut", EDIT_MENU_ACTION + 2, Option<Shortcut>.None, cut, false)
        run menu.item("Copy", EDIT_MENU_ACTION + 3, Option<Shortcut>.None, copy, false)
        run menu.item("Paste", EDIT_MENU_ACTION + 4, Option<Shortcut>.None, paste, false)
        run menu.separator()
        run menu.item("Select All", EDIT_MENU_ACTION + 5, Option<Shortcut>.None, true, false)
        drop run platform.showContextMenu(window, f32.toF64(x), f32.toF64(y), &menu)
      }
      HostRequest.ReadClipboard { target } => {
        let paste = run readPaste(&mut platform, target)
        run tree.queueFollowUp(move paste)
      }
      HostRequest.LoadFontFace { .. } => {
        // This host has no font loader yet: the face stays loading and its text keeps the
        // fallback.
      }
    }
    i = i + 1
  }
  let ime = run tree.imeArea()
  if !state.imeSet || !ime.same(&state.ime) {
    state.ime = ime
    state.imeSet = true
    if ime.enabled {
      platform.setIme(
        window,
        ImeState.at(
          Rect<f64>.new(
            f32.toF64(ime.rect.xMin),
            f32.toF64(ime.rect.yMin),
            f32.toF64(ime.rect.xMax),
            f32.toF64(ime.rect.yMax),
          ),
        ),
      )
    } else {
      platform.setIme(window, ImeState.disabled())
    }
  }
}

/// Shows the hovered node's cursor in `window`, `scale` pixels per point: the image its CSS
/// `cursor` lists once one has loaded and the platform draws images, else its keyword. An image
/// is made again only when it changes.
pub effect fn showCursor<P: Platform>(platform: &mut P, window: WindowId, tree: &mut UiTree<'_>, scale: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match run tree.cursorImage() {
    Option<CursorImage>.Some { value } => {
      let mix = u32.toU64(f32.toBits(value.hotX)) * 31 + u32.toU64(f32.toBits(value.hotY)) * 7
        + u32.toU64(f32.toBits(f64.toF32(scale))) + u32.toU64(window.value) * 131
      let key = u32.toU64(value.resource) * 4294967296 + mix % 4294967295 + 1
      if key == tree.cursorShown {
        return ()
      }
      if let Option<CursorPixels>.Some { value: pixels } = run tree.cursorPixels(value, f64.toF32(scale)) {
        let ratio = f32.toF64(pixels.scale)
        let hotX = if value.hot { f64.toU32(f64.max(0.0, f32.toF64(value.hotX) * ratio)) } else { 0 }
        let hotY = if value.hot { f64.toU32(f64.max(0.0, f32.toF64(value.hotY) * ratio)) } else { 0 }
        let image = WindowCursorImage {
          width: pixels.width,
          height: pixels.height,
          pixels: pixels.pixels.asSlice(),
          hotX: if hotX >= pixels.width { pixels.width - 1 } else { hotX },
          hotY: if hotY >= pixels.height { pixels.height - 1 } else { hotY },
          scale: ratio,
        }
        if run platform.setCursorImage(window, &image) {
          tree.cursorShown = key
          return ()
        }
      }
    }
    Option<CursorImage>.None => {}
  }
  tree.cursorShown = 0
  platform.setCursor(window, windowCursor(tree.cursor()))
}

/// The window cursor for a tree cursor.
pub fn windowCursor(cursor: Cursor) -> WindowCursor {
  return match cursor {
    Cursor.Default => WindowCursor.Arrow
    Cursor.Pointer => WindowCursor.PointingHand
    Cursor.Text => WindowCursor.IBeam
    Cursor.Move => WindowCursor.Move
    Cursor.Grab => WindowCursor.OpenHand
    Cursor.Grabbing => WindowCursor.ClosedHand
    Cursor.NotAllowed => WindowCursor.NotAllowed
    Cursor.ResizeHorizontal => WindowCursor.ResizeLeftRight
    Cursor.ResizeVertical => WindowCursor.ResizeUpDown
    Cursor.ResizeNorthWestSouthEast => WindowCursor.ResizeNorthWestSouthEast
    Cursor.ResizeNorthEastSouthWest => WindowCursor.ResizeNorthEastSouthWest
    Cursor.Crosshair => WindowCursor.Crosshair
    Cursor.None => WindowCursor.None
    Cursor.ContextMenu => WindowCursor.ContextualMenu
    Cursor.Copy => WindowCursor.DragCopy
    Cursor.Alias => WindowCursor.DragLink
    Cursor.VerticalText => WindowCursor.IBeamVertical
    Cursor.ColumnResize => WindowCursor.ResizeColumn
    Cursor.RowResize => WindowCursor.ResizeRow
    Cursor.Wait => WindowCursor.Wait
    Cursor.Progress => WindowCursor.Progress
    Cursor.Help => WindowCursor.Help
    Cursor.ZoomIn => WindowCursor.ZoomIn
    Cursor.ZoomOut => WindowCursor.ZoomOut
    Cursor.Cell => WindowCursor.Cell
    Cursor.NoDrop => WindowCursor.NoDrop
    Cursor.AllScroll => WindowCursor.AllScroll
    Cursor.ResizeNorth => WindowCursor.ResizeUp
    Cursor.ResizeEast => WindowCursor.ResizeRight
    Cursor.ResizeSouth => WindowCursor.ResizeDown
    Cursor.ResizeWest => WindowCursor.ResizeLeft
    Cursor.ResizeNorthEast => WindowCursor.ResizeUpRight
    Cursor.ResizeNorthWest => WindowCursor.ResizeUpLeft
    Cursor.ResizeSouthEast => WindowCursor.ResizeDownRight
    Cursor.ResizeSouthWest => WindowCursor.ResizeDownLeft
  }
}

/// Whether `phase` belongs to the middle of a scroll gesture, where deltas can be summed.
fn mergeablePhase(phase: Phase) -> bool {
  return match phase {
    Phase.None => true
    Phase.Changed => true
    Phase.Momentum => true
    _ => false
  }
}

/// How many queued events one pass takes from the platform to fold.
const BACKLOG_LIMIT: usize = 1024

/// 1 for a pointer move, 2 for a frame request, 3 for a resize, 4 for a window move, 0 for
/// the rest: the kinds of which only the last one a window has queued matters.
fn pacedKind(event: &Event) -> u32 {
  return match &event.* {
    Event.MouseMoved { .. } => 1
    Event.RequestFrame { .. } => 2
    Event.Resized { .. } => 3
    Event.Moved { .. } => 4
    _ => 0
  }
}

fn pacedWindow(event: &Event) -> u32 {
  return match &event.* {
    Event.MouseMoved { window, .. } => window.value
    Event.RequestFrame { window, .. } => window.value
    Event.Resized { window, .. } => window.value
    Event.Moved { window, .. } => window.value
    _ => 0
  }
}

/// Whether one of `later` supersedes `event` for its window. A queued frame request is also
/// superseded by a later resize of the same window, which updates the size and asks for a
/// fresh frame so intermediate sizes are not laid out and painted.
fn superseded(event: &Event, later: &[Event]) -> bool {
  let kind = pacedKind(event)
  let window = pacedWindow(event)
  let mut i: usize = 0
  while i < later.length {
    let next = pacedKind(&later[i])
    if pacedWindow(&later[i]) == window && (next == kind || (kind == 2 && next == 3)) {
      return true
    }
    i = i + 1
  }
  return false
}

/// `current` and `following` as one scroll, when they are two of one window, phase and unit.
fn mergedScroll(current: &Event, following: &Event) -> Option<Event> {
  return match &current.* {
    Event.Scroll { window, delta, phase, modifiers, .. } => match &following.* {
      Event.Scroll { window: next, position: at, delta: more, phase: stage, modifiers: keys } => {
        let sameKeys = keys.bits() == modifiers.bits()
        if mergeablePhase(phase) && next.value == window.value && stage == phase && sameKeys {
          match sum(delta, more) {
            Option<ScrollDelta>.Some { value } => Option<Event>.some(
              Event.Scroll {
                window: next,
                position: at,
                delta: value,
                phase: stage,
                modifiers: keys,
              },
            )
            Option<ScrollDelta>.None => Option<Event>.None
          }
        } else {
          Option<Event>.None
        }
      }
      _ => Option<Event>.None
    }
    _ => Option<Event>.None
  }
}

/// Folds the events already queued behind `first`, so a slow frame does not leave a backlog
/// that runs the client once per event. What the platform has queued moves to `backlog`, for
/// the next passes to take from its front. Of a run of pointer moves and frame requests, only
/// the last move and the last request of each window stay: moves that came while frames were
/// drawn are not replayed one frame each after the pointer stopped. Consecutive scrolls of one
/// kind and phase sum their deltas. Returns the event to handle now.
pub effect fn coalesce<P: Platform>(platform: &mut P, first: Event, backlog: &mut List<Event>)
  -> Event
  ! OutOfMemoryError
  ? &mut Allocator {
  while backlog.length() < BACKLOG_LIMIT {
    match run platform.nextEvent(Wait.Poll) {
      Option<Event>.Some { value } => run backlog.append(move value)
      Option<Event>.None => {
        break
      }
    }
  }
  let mut current = move first
  if pacedKind(&current) == 0 {
    while backlog.length() != 0 {
      match mergedScroll(&current, &backlog.asSlice()[0]) {
        Option<Event>.Some { value } => {
          drop backlog.remove(0)
          current = move value
        }
        Option<Event>.None => {
          break
        }
      }
    }
    return move current
  }

  // The run of moves and frame requests at the front, each kept only if it is its window's
  // last of its kind.
  let mut end: usize = 0
  while end < backlog.length() && pacedKind(&backlog.asSlice()[end]) != 0 {
    end = end + 1
  }
  let mut i: usize = 0
  while i < end {
    let queued = backlog.asSlice()
    if superseded(&queued[i], Slice.view(queued, i + 1, end - i - 1)) {
      drop backlog.remove(i)
      end = end - 1
    } else {
      i = i + 1
    }
  }
  if superseded(&current, Slice.view(backlog.asSlice(), 0, end)) {
    drop current
    return backlog.remove(0)
  }
  return move current
}

/// The sum of two scroll deltas of the same unit, or None when the units differ.
fn sum(left: ScrollDelta, right: ScrollDelta) -> Option<ScrollDelta> {
  return match left {
    ScrollDelta.Lines { delta } => match right {
      ScrollDelta.Lines { delta: more } => Option<ScrollDelta>.some(
        ScrollDelta.Lines { delta: Vector2<f64>.new(delta.x + more.x, delta.y + more.y) },
      )
      _ => Option<ScrollDelta>.None
    }
    ScrollDelta.Points { delta } => match right {
      ScrollDelta.Points { delta: more } => Option<ScrollDelta>.some(
        ScrollDelta.Points { delta: Vector2<f64>.new(delta.x + more.x, delta.y + more.y) },
      )
      _ => Option<ScrollDelta>.None
    }
  }
}

/// What the compositor needs to scroll `tree`'s frame on its own, at `scale` device pixels per
/// CSS pixel: the scroll containers the user can scroll, and the bounds of nodes that listen for
/// wheel events (a wheel there goes to the app first). Allocated with the system allocator, to
/// cross to the render thread.
pub effect fn fastScrollOf(tree: &UiTree<'_>, scale: f32) -> FastScroll
  ! OutOfMemoryError {
  let mut heap = Allocator.systemAllocatorProvider()
  let mut fast = FastScroll.make()
  let count = tree.nodes.length()
  let mut slot: usize = 0
  while slot < count {
    let node = tree.node(usize.toU32(slot))
    slot = slot + 1
    if !node.live || node.kind == NodeKind.Text {
      continue
    }
    let x = userScrolls(usedOverflow(&node.computed().*, true))
    let y = userScrolls(usedOverflow(&node.computed().*, false))
    if x || y {
      let at = slot - 1
      let order = if at < tree.paintIndexOf.length() { tree.paintIndexOf.get(at) } else { u32.MAX }
      run fast.scrollers.append(ScrollerAxes { node: node.id, x: x, y: y, order: order })
        |> Effect.provideMut<Allocator>(&mut heap)
    }
    if (node.listeners & LISTEN_WHEEL) != 0 {
      let found = run inspect.info(tree, node.id) |> Effect.provideMut<Allocator>(&mut heap)
      if let Option<NodeInfo>.Some { value } = found {
        let b = value.bounds
        run fast.blocked.append(
          Rect<f32>.new(b.xMin * scale, b.yMin * scale, b.xMax * scale, b.yMax * scale),
        )
          |> Effect.provideMut<Allocator>(&mut heap)
      }
    }
  }
  let moves = tree.moves.asSlice()
  let mut m: usize = 0
  while m < moves.length {
    let mut slide = moves[m]
    slide.fromX = slide.fromX * scale
    slide.fromY = slide.fromY * scale
    slide.toX = slide.toX * scale
    slide.toY = slide.toY * scale
    run fast.moves.append(slide) |> Effect.provideMut<Allocator>(&mut heap)
    m = m + 1
  }
  return move fast
}
