pub const AWAIT: i32 = 0
pub const YIELD: i32 = 1
pub const YIELD_STAR: i32 = 2
pub const INITIAL_YIELD: i32 = 3
union Step { Continue, Done { value: ValueBits } }
fn invariant() -> never { return Intrinsic.trap("QuickJS invariant violated") }
effect fn ignoreClose(error: JsException) -> () { drop error }
unsafe fn previous(runtime: *mut HeapHeader) -> ?*mut StackFrame {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return state.currentStackFrame
}
unsafe fn classId(value: ValueBits) -> u32 {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(value))
  return object.classId()
}
unsafe fn classCallback(runtime: *mut HeapHeader, id: u32) -> Option<NativeFunctionId> {
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return match &state.classes.asSlice()[u32.toUsize(id)].call {
    Option<NativeFunctionId>.Some { value } => Option<NativeFunctionId>.some(value)
    Option<NativeFunctionId>.None => Option<NativeFunctionId>.none()
  }
}
/// V8's TypeError for calling function, which is not callable: the callee as
/// the caller's source spells it, or the value when there is no source.
@cold
unsafe effect fn throwNotCallable<H: CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, function: ValueBits) -> never
  ! JsException ? &mut Allocator {
  let mut message = DiagnosticMessage.make()
  if !unsafe callPrinter.appendCallee(unsafe runtime.contextRuntime(context), &mut message) {
    message.append(match function {
      ValueBits.Undefined => b"undefined"
      ValueBits.Null => b"null"
      ValueBits.Bool { value } => if value { b"true" } else { b"false" }
      _ => if function.isNumber() { b"number" } else if function.isString() { b"string" } else if function.isObject() { b"object" } else { b"value" }
    })
  }
  message.append(b" is not a function")
  return run core.error(&mut hooks, unsafe lendRealm(&context, context), message.bytes())
}
unsafe effect fn callClass<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  let class = unsafe classId(function)
  // Native builtins skip the class-callback hook chain; their callback is fixed.
  if class == classes.JS_CLASS_C_FUNCTION || class == classes.JS_CLASS_C_FUNCTION_DATA {
    // Hot builtins that cannot throw answer before the native frame is built;
    // Uninitialized declines.
    if class == classes.JS_CLASS_C_FUNCTION {
      if let Option<nativeFunctions.QuickTarget>.Some { value: target } = unsafe nativeFunctions.quickTarget(function) {
        let quick = nativeFunctions.quick(&mut hooks, unsafe lendRealm(&context, context), &target, unsafe lendBits(&receiver, receiver), argv.*)
        match quick { ValueBits.Uninitialized => () _ => { return quick } }
        if (flags & JS_CALL_FLAG_CONSTRUCTOR) == 0 {
          let written = run unsafe nativeFunctions.quickWrite(&mut hooks, &target, receiver, argv)
          if let Option<ValueBits>.Some { value } = move written { return value }
        }
      }
    }
  }
  return run unsafe callClassSlow(&mut hooks, memory, context, function, receiver, argv, flags)
}
/// callClassSlow for a JS_CLASS_C_FUNCTION called (not constructed), as quickInline
/// and nativeInline have checked: callPlain directly, skipping callClassSlow's
/// layer (about 70 Ir a native call); callClassSlow only when it declines.
@inlineAlways
unsafe effect fn callNativePlain<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  let plain = run nativeFunctions.callPlain(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv))
  if let Option<ValueBits>.Some { value } = move plain {
    if value.isException() { fail JsException {} }
    return value
  }
  return run unsafe callClassSlow(&mut hooks, memory, context, function, receiver, argv, 0)
}
/// callClass past the quick paths, for callers that already tried them (quickInline).
unsafe effect fn callClassSlow<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  let class = unsafe classId(function)
  if class == classes.JS_CLASS_C_FUNCTION || class == classes.JS_CLASS_C_FUNCTION_DATA {
    if class == classes.JS_CLASS_C_FUNCTION && (flags & JS_CALL_FLAG_CONSTRUCTOR) == 0 {
      let plain = run nativeFunctions.callPlain(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv))
      if let Option<ValueBits>.Some { value } = move plain {
        if value.isException() { fail JsException {} }
        return value
      }
    }
    let value = run nativeFunctions.call(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendArguments(argv), u32.toI32(flags))
    if value.isException() { fail JsException {} }
    return value
  }
  let rt = unsafe runtime.contextRuntime(context)
  let id = match move unsafe classCallback(rt, class) {
    Option<NativeFunctionId>.Some { value } => value
    Option<NativeFunctionId>.None => { return run unsafe throwNotCallable(&mut hooks, context, function) }
  }
  let invoked = run Effect.result(hooks.nativeFlags(id, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), usize.toI32(argv.length()), unsafe lendArguments(argv), u32.toI32(flags)))
  return match move invoked {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => {
      if value.isException() { fail JsException {} }
      return value
    }
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => run core.materialize(&mut hooks, unsafe lendRealm(&context, context), move error)
  }
}
/// Inputs are borrowed roots. COPY_ARGUMENTS is mandatory for a public call;
/// callInternal(flags=0) additionally requires exclusive access to argv cells.
pub unsafe effect fn call<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  return run unsafe callInternal(&mut hooks, memory, context, function, receiver, ValueBits.Undefined, argv, activation.COPY_ARGUMENTS)
}
/// Stack a deferred body's read may use: enough for deeply nested functions.
const DEFERRED_READ_HEADROOM: usize = 262144
/// A first call of a function whose compile was deferred: finish it first.
@inlineNever
unsafe effect fn finishStub<H: HeapHooks + CoercionHooks + EvalHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, node: *mut HeapHeader) -> ()
  ! JsException ? &mut Allocator {
  if unsafe compilerFinish.deferredStub(node) {
    // Reading the body recurses through its nested functions and cannot stop half way,
    // so near the stack limit the call fails with its own RangeError before it starts.
    if unsafe runtime.checkStackOverflow(unsafe runtime.contextRuntime(context), currentFrameAddress(), DEFERRED_READ_HEADROOM, true) {
      return run unsafe stackOverflow(&mut hooks, memory, context)
    }
    run unsafe hooks.finishDeferred(node) return ()
  }
  if unsafe compilerFinish.lazyStub(node) {
    match move run Effect.result(unsafe compilerLazy.finishLazy(&mut hooks, memory, node)) {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { error } => { run core.materialize(&mut hooks, unsafe lendRealm(&context, context), move error) }
    }
    return ()
  }
  match move run Effect.result(unsafe compilerFinish.finish(&mut hooks, node)) {
    Result<(), OutOfMemoryError>.Success { .. } => ()
    Result<(), OutOfMemoryError>.Failure { error } => { run core.materialize(&mut hooks, unsafe lendRealm(&context, context), move error) }
  }
}
/// Kept out of line so the hot call path does not build the realm handle.
@inlineNever
unsafe effect fn stackOverflow<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> never
  ! JsException ? &mut Allocator {
  let anchor = () return run errors.throwStackOverflow(&mut hooks, memory, unsafe lendRealm(&anchor, context))
}
@inlineAlways
pub unsafe effect fn callInternal<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, newTarget: ValueBits,
  argv: &FrameSlots, flags: u32) -> ValueBits ! JsException ? &mut Allocator {
  return run unsafe callResuming(&mut hooks, memory, context, function, receiver, newTarget, argv, flags, compiled.fresh())
}
/// callInternal; a resume with a state continues a deoptimized compiled run
/// (callCompiled) in the new frame instead of starting the function.
@inlineAlways
unsafe effect fn callResuming<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, newTarget: ValueBits,
  argv: &FrameSlots, flags: u32, resume: compiled.Resume) -> ValueBits ! JsException ? &mut Allocator {
  run unsafe restricted.call(unsafe lendRealm(&context, context), function, receiver)
  // Raw stack storage: the entry's frame slots are all Borrowed, so it needs no drop glue.
  // Allocated first, at a fixed size, so it is a frame slot rather than part of
  // the dynamic allocation below.
  let entrySlot = unsafe Intrinsic.pointerRequalify<[*]mut Entry, *mut Entry>(unsafe Intrinsic.stackAllocate<Entry>(1))
  if interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
  if !function.isObject() { return run unsafe throwNotCallable(&mut hooks, context, function) }
  if unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION {
    return run unsafe callClass(&mut hooks, memory, context, function, receiver, argv, flags)
  }
  let rt = unsafe runtime.contextRuntime(context)
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  match Pointer.nonNullMut<HeapHeader>(unsafe activation.pendingBytecode(function)) {
    Option<*mut HeapHeader>.Some { value } => { run unsafe finishStub(&mut hooks, memory, context, value) }
    Option<*mut HeapHeader>.None => ()
  }
  let description = unsafe activation.describe(function, empty, emptyRefs, argv.length(), flags, true)
  // Baseline code builds its own frame (js_baseline), a construct frame for a `new` of the
  // function itself; any other new.target stays here.
  if description.baseline != 0 && Pointer.isNull<u64>(resume.state) && unsafe baselineOpen(rt) {
    let constructs = unsafe sameValueBits(newTarget, function)
    if constructs || match newTarget { ValueBits.Undefined => true _ => false } {
      let mut value = ValueBits.Undefined
      let host = unsafe Intrinsic.pointerReinterpret<*mut H, *mut u8>(Pointer.fromMutRef<H>(&mut hooks))
      if unsafe enterBaseline(rt, host, function, receiver, FrameSlots { data: argv.data, count: argv.count }, Pointer.fromMutRef<ValueBits>(&mut value), description.baseline, constructs) != 0 { fail JsException {} }
      return value
    }
  }
  if unsafe runtime.checkStackOverflow(rt, currentFrameAddress(), description.bytes, true) {
    return run unsafe stackOverflow(&mut hooks, memory, context)
  }
  let storage = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(description.allocationSlots))
  // A scope function's scope, allocated before the frame holds anything to release.
  let scopeSlots = unsafe activation.scopeSlotsOf(&description)
  let mut ownScope: ?*mut HeapHeader = Pointer.null<HeapHeader>()
  if scopeSlots != 0 {
    let allocated = run Effect.result(unsafe scopes.allocateScope(&mut hooks, memory, rt, scopeSlots))
    match move allocated {
      Result<*mut HeapHeader, OutOfMemoryError>.Success { value } => { ownScope = value }
      Result<*mut HeapHeader, OutOfMemoryError>.Failure { error } => {
        let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&context, context), move error), core.exceptionValue)
        fail JsException {}
      }
    }
  }
  let prior = unsafe previous(rt)
  unsafe Pointer.put<Entry>(entrySlot, unsafe activation.enter(&description, storage, function, argv, prior, rt, context, receiver, newTarget, empty))
  let mut entryAnchor = () let entry = unsafe Pointer.borrowMut<(), Entry>(&mut entryAnchor, entrySlot)
  let framePointer = Pointer.fromMutRef<StackFrame>(&mut entry.frame)
  entry.machine.frame = framePointer
  if scopeSlots != 0 {
    let scope = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(ownScope)
    let parent = entry.machine.scope
    match Pointer.nonNullMut<HeapHeader>(parent) { Option<*mut HeapHeader>.Some { value } => { unsafe HeapCell.retain(value) } _ => () }
    unsafe scopes.beginScope(scope, parent, description.bytecode, &entry.frame.arguments)
    entry.machine.scope = ownScope
  }
  let machine = &mut entry.machine
  unsafe activation.publish(rt, framePointer)
  let mut observation = unsafe debugger.enter(&machine)
  unsafe debugger.publish(rt, Pointer.fromMutRef<DebugActivation>(&mut observation))
  // dispatch, inlined: failures are caught once per run of execute and unwound here.
  let mut completed = false
  let mut abandoned = false
  let mut value = ValueBits.Undefined
  match Pointer.nonNullMut<u64>(resume.state) {
    Option<*mut u64>.Some { value: state } => {
      if resume.exit == compiled.EXIT_INLINED {
        // An activation optimized code had inlined: the frame takes its state, and the call
        // it was in the middle of, if any, is made first.
        if run unsafe resumeInlined(&mut hooks, memory, &mut machine, unsafe Intrinsic.pointerReinterpret<*mut u64, *mut baseline.Inlined>(state)) {
          abandoned = !run unsafe compiledThrew(&mut hooks, memory, &mut machine)
        }
      } else {
        unsafe compiled.restore(&mut machine, resume.index, resume.exit, state)
        // An activation's code left at a call that threw (runActivations): unwind from there.
        if resume.exit == compiled.EXIT_THROW { abandoned = !run unsafe compiledThrew(&mut hooks, memory, &mut machine) }
      }
    }
    Option<*mut u64>.None => {
      if description.compiled != 0 {
        let how = run unsafe enterBase(&mut hooks, memory, &mut machine, description.compiled, &mut value)
        completed = how == compiled.ENTER_RETURNED
        if how == compiled.ENTER_THREW { abandoned = !run unsafe compiledThrew(&mut hooks, memory, &mut machine) }
      }
    }
  }
  while !completed && !abandoned {
    let executed = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(
      unsafe execute(&mut hooks, memory, &mut machine), failed)
    match move executed {
      ValueBits returned => { value = returned completed = true break }
      Failed { error } => {
        if !unsafe restricted.rejected(machine.runtime) {
          let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
          run unsafe exceptionBoundary(&mut hooks, memory, &mut machine)
        } else { drop error }
        if !run unsafe unwindFrames(&mut hooks, memory, &mut machine) { break }
      }
    }
  }
  unsafe debugger.leave(rt, &observation)
  unsafe activation.release(&mut hooks, &description, &machine)
  if scopeSlots != 0 { unsafe scopes.releaseScope(&mut hooks, rt, unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(ownScope)) }
  unsafe activation.publish(rt, prior)
  if !completed { fail JsException {} }
  return value
}
/// callInternal for a known local function (js_compiler_known) called from
/// caller when no inline frame fits: a base frame whose scope, if it has one,
/// lives on this native stack under the caller's scope at the function's
/// creation level, borrowed, as an inline frame's does. A known function never
/// lets its scope reach the heap.
@inlineNever
unsafe effect fn callKnown<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, caller: &Machine, function: ValueBits, argv: &FrameSlots, resume: compiled.Resume) -> ValueBits ! JsException ? &mut Allocator {
  let context = caller.context
  let entrySlot = unsafe Intrinsic.pointerRequalify<[*]mut Entry, *mut Entry>(unsafe Intrinsic.stackAllocate<Entry>(1))
  let bytecode = match function { ValueBits.FunctionBytecode { reference } => reference _ => invariant() }
  let rt = unsafe runtime.contextRuntime(context)
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  let pendingAnchor = ()
  let pending = (unsafe HeapCell.payload<FunctionBytecode, ()>(&pendingAnchor, bytecode)).pending.isSome()
  if pending { run unsafe finishStub(&mut hooks, memory, context, bytecode) }
  let known = unsafe activation.knownContext(bytecode, Pointer.fromRef<Machine>(&caller), unsafe Intrinsic.pointerRequalify<*mut ?*mut HeapHeader, *const ?*mut HeapHeader>(emptyRefs))
  let description = unsafe activation.describeKnown(bytecode, known, empty, argv.length(), 0, true)
  if unsafe runtime.checkStackOverflow(rt, currentFrameAddress(), description.bytes, true) {
    return run unsafe stackOverflow(&mut hooks, memory, context)
  }
  let storage = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(description.allocationSlots))
  let scopeSlots = unsafe activation.scopeSlotsOf(&description)
  let scopeStorage = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(scopes.frameCells(scopeSlots)))
  let prior = unsafe previous(rt)
  unsafe Pointer.put<Entry>(entrySlot, unsafe activation.enter(&description, storage, function, argv, prior, rt, context, ValueBits.Undefined, ValueBits.Undefined, empty))
  let mut entryAnchor = () let entry = unsafe Pointer.borrowMut<(), Entry>(&mut entryAnchor, entrySlot)
  let framePointer = Pointer.fromMutRef<StackFrame>(&mut entry.frame)
  entry.machine.frame = framePointer
  let mut own: ?*mut HeapHeader = Pointer.null<HeapHeader>()
  if scopeSlots != 0 {
    let placed = unsafe scopes.placeFrameScope(scopeStorage, scopeSlots)
    unsafe scopes.beginScope(placed, entry.machine.scope, description.bytecode, &entry.frame.arguments)
    entry.machine.scope = placed own = placed
  }
  let machine = &mut entry.machine
  unsafe activation.publish(rt, framePointer)
  let mut observation = unsafe debugger.enter(&machine)
  unsafe debugger.publish(rt, Pointer.fromMutRef<DebugActivation>(&mut observation))
  let mut completed = false
  let mut abandoned = false
  let mut value = ValueBits.Undefined
  match Pointer.nonNullMut<u64>(resume.state) {
    Option<*mut u64>.Some { value: state } => {
      unsafe compiled.restore(&mut machine, resume.index, resume.exit, state)
      // An activation's code left at a call that threw (runActivations): unwind from there.
      if resume.exit == compiled.EXIT_THROW { abandoned = !run unsafe compiledThrew(&mut hooks, memory, &mut machine) }
    }
    Option<*mut u64>.None => {
      if description.compiled != 0 {
        let how = run unsafe enterBase(&mut hooks, memory, &mut machine, description.compiled, &mut value)
        completed = how == compiled.ENTER_RETURNED
        if how == compiled.ENTER_THREW { abandoned = !run unsafe compiledThrew(&mut hooks, memory, &mut machine) }
      }
    }
  }
  while !completed && !abandoned {
    let executed = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(
      unsafe execute(&mut hooks, memory, &mut machine), failed)
    match move executed {
      ValueBits returned => { value = returned completed = true break }
      Failed { error } => {
        if !unsafe restricted.rejected(machine.runtime) {
          let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
          run unsafe exceptionBoundary(&mut hooks, memory, &mut machine)
        } else { drop error }
        if !run unsafe unwindFrames(&mut hooks, memory, &mut machine) { break }
      }
    }
  }
  unsafe debugger.leave(rt, &observation)
  unsafe activation.release(&mut hooks, &description, &machine)
  match Pointer.nonNullMut<HeapHeader>(own) {
    Option<*mut HeapHeader>.Some { value: placed } => {
      if !unsafe scopes.inFrame(placed) { Intrinsic.trap("known function scope left its frame") }
      unsafe scopes.releaseFrameScope(&mut hooks, rt, placed)
    }
    Option<*mut HeapHeader>.None => ()
  }
  unsafe activation.publish(rt, prior)
  if !completed { fail JsException {} }
  return value
}
pub unsafe effect fn construct<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, newTarget: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  return run unsafe constructInternal(&mut hooks, memory, context, function, newTarget, argv, activation.COPY_ARGUMENTS)
}
// Catches a constructor body's throw without Effect.result's Result wrapping.
struct FailedConstruct { error: JsException }
effect fn failedConstruct(error: JsException) -> FailedConstruct { return FailedConstruct { error: move error } }
pub unsafe effect fn constructInternal<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, newTarget: ValueBits, argv: &FrameSlots, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  run unsafe restricted.call(unsafe lendRealm(&context, context), function, ValueBits.Undefined)
  run interrupts.poll(&mut hooks, memory, unsafe lendRealm(&context, context))
  if !boxing.isConstructor(unsafe lendBits(&function, function)) { return run core.throwNotConstructor(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&function, function)) }
  let constructorFlags = flags | JS_CALL_FLAG_CONSTRUCTOR
  if unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION {
    return run unsafe callClass(&mut hooks, memory, context, function, newTarget, argv, constructorFlags)
  }
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function))
  let bytecode = match &object.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => invariant() }
  drop object
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let realm = code.realm
  let derived = code.isDerivedClassConstructor drop code
  if derived { return run unsafe callInternal(&mut hooks, memory, context, function, ValueBits.Undefined, newTarget, argv, constructorFlags) }
  let receiver = run unsafe constructors.createReceiver(&mut hooks, memory, unsafe lendRealm(&realm, realm), newTarget)
  return run unsafe constructWith(&mut hooks, memory, context, function, receiver, newTarget, argv, constructorFlags)
}
/// Runs base-class constructor function on receiver, owned here, and applies
/// [[Construct]]'s result rule.
unsafe effect fn constructWith<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, newTarget: ValueBits,
  argv: &FrameSlots, constructorFlags: u32) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Intrinsic.catchFailure<JsException>(unsafe callInternal(&mut hooks, memory, context, function, receiver, newTarget, argv, constructorFlags), failedConstruct)
  let rt = unsafe runtime.contextRuntime(context)
  return match move called {
    ValueBits value => {
      if value.isObject() { unsafe gc.release(&mut hooks, rt, receiver) return value }
      unsafe gc.release(&mut hooks, rt, value) return receiver
    }
    FailedConstruct { error } => { unsafe gc.release(&mut hooks, rt, receiver) fail move error }
  }
}
/// state is a rooted, suspended HeapKind.AsyncFunction. The family caller owns
/// completion and VarRef detachment; this function only executes and saves PC/SP.
pub unsafe effect fn resume<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, state: *mut HeapHeader) -> ValueBits ! JsException ? &mut Allocator {
  run restricted.deny(unsafe lendRealm(&context, context))
  run interrupts.poll(&mut hooks, memory, unsafe lendRealm(&context, context))
  let rt = unsafe runtime.contextRuntime(context)
  let prior = unsafe previous(rt)
  let mut anchor = () let suspended = unsafe HeapCell.payloadMut<AsyncFrame, ()>(&mut anchor, state)
  let receiver = suspended.thisValue let count = i32.toUsize(suspended.argumentCount)
  let throwing = suspended.throwFlag let framePointer = suspended.frame.address() drop suspended
  let frame = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, framePointer)
  let pc = frame.currentPc if pc == NO_PC { invariant() }
  let sp = frame.stackPointer if sp == NO_SP { invariant() }
  let function = frame.currentFunction
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  let argv = FrameSlots { data: unsafe activation.data(&frame.arguments, empty), count: count }
  frame.stackPointer = NO_SP frame.previous = prior drop frame
  let description = unsafe activation.describe(function, empty, emptyRefs, 0, 0, false)
  let mut machine = unsafe activation.machine(&description, rt, context, framePointer, &argv, receiver, ValueBits.Undefined, empty, pc, sp)
  unsafe activation.publish(rt, framePointer)
  let result = run Effect.result(unsafe dispatch(&mut hooks, memory, &mut machine, throwing))
  let saved = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, framePointer)
  saved.currentPc = machine.pc() saved.stackPointer = machine.sp() drop saved
  unsafe activation.publish(rt, prior)
  return match move result {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
/// An exception a native threw (no OP_throw recorded it) takes the first
/// bytecode frame it reaches as its throw site, as V8's message location is the
/// top JavaScript frame when Isolate::Throw runs.
@inlineNever
unsafe fn noteFirstFrame<H: HeapHooks>(hooks: &mut H, machine: &Machine, error: ValueBits) -> bool {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, machine.runtime)
  if unsafe equal(state.thrownValue, error, EqualityMode.Strict) { return false }
  let previousValue = Intrinsic.replace(state.thrownValue, unsafe error.retained())
  let previousCode = Intrinsic.replace(state.thrownCode, unsafe (ValueBits.FunctionBytecode { reference: machine.bytecode }).retained())
  state.thrownPc = usize.toU32(machine.pc()) state.thrownNative = true
  state.thrownLine = 0
  drop state
  unsafe gc.release(&mut hooks, machine.runtime, previousValue)
  unsafe gc.release(&mut hooks, machine.runtime, previousCode)
  return true
}
unsafe effect fn unwind<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> bool ? &mut Allocator {
  if unsafe restricted.rejected(machine.runtime) { return false }
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  let mut error = state.currentException drop state
  if unsafe backtrace.isNeeded(error) {
    unsafe machine.publishPc()
    // A stack that fails to build (out of memory) replaces the pending exception,
    // releasing this one: it is held while its stack is built, and the exception
    // unwound is the pending one afterwards, as in QuickJS.
    let held = unsafe error.retained()
    run errors.buildBacktrace(&mut hooks, memory, unsafe lendRealm(&anchor, machine.context), unsafe lendBits(&anchor, held), Option<ValueBits>.none(), 0, 0, backtrace.LAZY_STACK)
    unsafe gc.release(&mut hooks, machine.runtime, held)
    let after = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
    error = after.currentException drop after
  }
  if unsafe noteFirstFrame(&mut hooks, &machine, error) && unsafe throwTrace.wanted(machine.runtime) {
    run unsafe throwTrace.note(&mut hooks, machine.runtime, error, false)
  }
  let current = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  let uncatchable = current.currentExceptionIsUncatchable drop current
  if uncatchable { return false }
  while machine.sp() != 0 {
    let value = unsafe machine.pop()
    unsafe gc.release(&mut hooks, machine.runtime, value)
    match value {
      ValueBits.CatchOffset { offset } => {
        if offset == 0 {
          let method = unsafe machine.pop()
          unsafe gc.release(&mut hooks, machine.runtime, method)
          let position = iterators.standInIndex(method)
          if position >= 0 {
            let iterator = unsafe machine.top(1)
            if !core.undefined(iterator) {
              let _closed = run Effect.catch<JsException>(iterators.closeStandIn(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(iterator), position, true), ignoreClose)
            }
          } else {
            let _closed = run Effect.catch<JsException>(iterators.close(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(1)), true), ignoreClose)
          }
        } else {
          let pending = unsafe exceptions.take(machine.runtime)
          let mut entered = ()
          let handler = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut entered, machine.runtime)
          handler.handlerCode = Pointer.address<HeapHeader>(machine.bytecode)
          handler.handlerPc = i32.toU32(offset)
          drop handler
          // A frame with linked code: poll at the next backward jump, so a loop whose body
          // threw re-enters its OSR code there instead of after a full counter period.
          if (unsafe HeapCell.payload<FunctionBytecode, ()>(&entered, machine.bytecode)).compiled != 0 {
            let mut contextAnchor = () let context = unsafe HeapCell.payloadMut<ContextState, ()>(&mut contextAnchor, machine.context)
            context.interruptCounter = 1
            drop context
          }
          unsafe machine.push(pending) unsafe machine.setPc(i32.toUsize(offset)) return true
        }
      }
      _ => ()
    }
  }
  return false
}
// Failures are caught once per run of execute, not once per instruction: execute
// leaves pc/sp at the failing instruction, unwind finds the handler, and the
// loop resumes there.
unsafe effect fn dispatch<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, throwing: bool) -> ValueBits ! JsException ? &mut Allocator {
  let mut observation = unsafe debugger.enter(&machine)
  unsafe debugger.publish(machine.runtime, Pointer.fromMutRef<DebugActivation>(&mut observation))
  let result = run Effect.result(unsafe dispatchBody(&mut hooks, memory, &mut machine, throwing))
  unsafe debugger.leave(machine.runtime, &observation)
  return match move result {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error } => { fail move error }
  }
}
unsafe effect fn dispatchBody<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, throwing: bool) -> ValueBits ! JsException ? &mut Allocator {
  if throwing { run unsafe debugger.boundary(&mut hooks, memory, &machine, machine.pc(), true) }
  if throwing && !run unsafe unwind(&mut hooks, memory, &mut machine) { fail JsException {} }
  while true {
    let executed = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(
      unsafe execute(&mut hooks, memory, &mut machine), failed)
    match move executed {
      ValueBits value => { return value }
      Failed { error } => {
        if !unsafe restricted.rejected(machine.runtime) {
          let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
          run unsafe exceptionBoundary(&mut hooks, memory, &mut machine)
        } else { drop error }
        if !run unsafe unwindFrames(&mut hooks, memory, &mut machine) { fail JsException {} }
      }
    }
  }
}
/// Whether baseline code (js_baseline) may be entered: not while the debugger, coverage or
/// the profiler see every instruction.
@inlineAlways
unsafe fn baselineOpen(runtime: *mut HeapHeader) -> bool {
  let anchor = () return !(unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).observeInstructions
}
unsafe fn baselineIndex(bytecode: *mut HeapHeader) -> u32 {
  let anchor = () return (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)).baseline
}
/// Runs the baseline code function's bytecode is linked to (index, its
/// FunctionBytecode.baseline, nonzero) on argv, borrowed, with receiver as `this`, as a
/// construct call with the function as new.target when constructs: 0 with the owned result in out, or 1
/// when it threw, the exception pending. hooks is the caller's hooks object: what the code
/// asks the engine for meanwhile runs on it (CompiledTable.serviceHooks), as the hooks of
/// an outer entry do again once this one returns.
@inlineNever
unsafe fn enterBaseline(runtime: *mut HeapHeader, hooks: *mut u8, function: ValueBits, receiver: ValueBits, argv: FrameSlots, out: *mut ValueBits,
  index: u32, constructs: bool) -> u32 {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let enter = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(state.compiled.baselineEnter)
  let env = state.compiled.baselineEnv
  let outer = state.compiled.serviceHooks
  state.compiled.serviceHooks = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(hooks)
  drop state
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const baseline.Enter>(Pointer.fromRef<*const u8>(&enter))
  let code = unsafe Pointer.read<baseline.Enter>(slot)
  let status = unsafe code(env, unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(core.reference(function)), argv.data, argv.count, Pointer.fromRef<ValueBits>(&receiver), out,
    unsafe baseline.entryOf(runtime, index, constructs), (unsafe activation.calleeOf(function)).bytecode)
  let mut afterAnchor = ()
  let after = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut afterAnchor, runtime)
  after.compiled.serviceHooks = outer
  return status
}
/// enterBaseline for a known local function, its bytecode linked as index, in scope (what
/// js_vm_activation.knownContext gives for the caller): it has no receiver.
@inlineNever
unsafe fn enterBaselineKnown(runtime: *mut HeapHeader, hooks: *mut u8, bytecode: *mut HeapHeader, scope: ?*mut HeapHeader, argv: FrameSlots, out: *mut ValueBits,
  index: u32) -> u32 {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let enter = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(state.compiled.baselineEnter)
  let env = state.compiled.baselineEnv
  let outer = state.compiled.serviceHooks
  state.compiled.serviceHooks = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(hooks)
  drop state
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const baseline.Enter>(Pointer.fromRef<*const u8>(&enter))
  let code = unsafe Pointer.read<baseline.Enter>(slot)
  let receiver = ValueBits.Undefined
  let status = unsafe code(env, scope, argv.data, argv.count, Pointer.fromRef<ValueBits>(&receiver), out, unsafe baseline.entryOf(runtime, index, false), bytecode)
  let mut afterAnchor = ()
  let after = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut afterAnchor, runtime)
  after.compiled.serviceHooks = outer
  return status
}
/// Baseline code takes over the activation machine runs, at the back edge it just took
/// (docs/jit/baseline.md, entering a running loop): when its function is linked and has a
/// resume entry, the code builds its frame, moves the locals and operands into it
/// (SERVICE_RESUME) and runs the function to its return. The activation is then left with
/// the result, about to return it. False, with nothing changed, when the activation stays
/// in the interpreter; an exception the code let out is raised with the operand stack empty,
/// so no handler of the activation sees it twice.
@inlineNever
unsafe effect fn baselineLoop<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool ! JsException {
  let index = unsafe baselineIndex(machine.bytecode)
  if index == 0 || !unsafe baselineOpen(machine.runtime) { return false }
  // A plain call's frame only: no construction, no setter's discarded result.
  if activation.flagged(&machine) || !core.undefined(unsafe activation.newTargetOf(&machine)) { return false }
  let rt = machine.runtime
  let entry = match Pointer.nonNull<u8>(unsafe baseline.resumeOf(rt, index)) { Option<*const u8>.Some { value } => value Option<*const u8>.None => { return false } }
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, machine.bytecode)
  let cells = u16.toUsize(code.argumentCount) + u16.toUsize(code.variableCount) + u16.toUsize(code.stackSize)
  drop code
  if unsafe runtime.checkStackOverflow(rt, currentFrameAddress(), cells * Layout.of<ValueBits>().bytes + baseline.recordBytes() + 4096, true) { return false }
  let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, unsafe Intrinsic.pointerRequalify<*mut StackFrame, *const StackFrame>(machine.frame))
  let function = frame.currentFunction
  let outer = frame.previous
  drop frame
  let arguments = unsafe activation.frameArguments(unsafe Intrinsic.pointerRequalify<*mut StackFrame, *const StackFrame>(machine.frame))
  let mut from = baseline.Resume { arguments: arguments.data, count: arguments.count, locals: machine.locals, stack: machine.stack, sp: machine.sp(), pc: machine.pc(),
    returnPc: 0, returnsValue: false, taken: false }
  // A known local function's frame names its bytecode and runs in the scope its caller passed.
  let target = match function {
    ValueBits.Object { reference } => unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(reference)
    ValueBits.FunctionBytecode { reference: _ } => machine.scope
    _ => { return false }
  }
  let mut stateAnchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, rt)
  let enter = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(state.compiled.baselineEnter)
  let env = state.compiled.baselineEnv
  let servicing = state.compiled.serviceHooks
  state.compiled.serviceHooks = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut H, *mut u8>(Pointer.fromMutRef<H>(&mut hooks)))
  // The code's frame stands in the chain where the activation's did.
  state.currentStackFrame = outer
  drop state
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const baseline.Enter>(Pointer.fromRef<*const u8>(&enter))
  let stub = unsafe Pointer.read<baseline.Enter>(slot)
  let receiver = machine.thisValue
  let mut value = ValueBits.Undefined
  let status = unsafe stub(env, target, unsafe Intrinsic.pointerReinterpret<*mut baseline.Resume, *mut ValueBits>(Pointer.fromMutRef<baseline.Resume>(&mut from)), 0,
    Pointer.fromRef<ValueBits>(&receiver), Pointer.fromMutRef<ValueBits>(&mut value), entry, machine.bytecode)
  let mut afterAnchor = ()
  let after = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut afterAnchor, rt)
  after.compiled.serviceHooks = servicing
  after.currentStackFrame = unsafe Intrinsic.pointerRequalify<*mut StackFrame, ?*mut StackFrame>(machine.frame)
  drop after
  if from.taken { unsafe machine.setSp(0) }
  if status != 0 { fail JsException {} }
  if !from.taken { Intrinsic.trap("baseline resume invariant violated") }
  unsafe machine.setPc(from.returnPc)
  if from.returnsValue { unsafe machine.push(value) } else { unsafe gc.release(&mut hooks, rt, value) }
  return true
}
/// callResuming's EXIT_INLINED: machine is the fresh frame of an activation that optimized
/// code had inlined and left part way through (js_baseline.Inlined). Its locals and
/// operands move into the frame. When the code left inside a function inlined into this one
/// in turn, the frame is at that call, which is made here with the inner activation's
/// state; its result then stands where the call's operands were, as after the call
/// instruction. True when that call threw, or when the code left because a call of the
/// activation's own threw (Inlined.threw): the exception is pending with machine at the
/// call, its operands on the stack. The interpreter goes on from machine otherwise.
@inlineNever
unsafe effect fn resumeInlined<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, state: *mut baseline.Inlined) -> bool ? &mut Allocator {
  let mut anchor = ()
  let from = unsafe Pointer.borrowMut<(), baseline.Inlined>(&mut anchor, state)
  let codeAnchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&codeAnchor, machine.bytecode)
  if from.count != u16.toUsize(code.variableCount) || from.sp > u16.toUsize(code.stackSize) { invariant() }
  drop code
  let locals = unsafe Pointer.assumeManyMut<ValueBits>(from.locals)
  let mut index: usize = 0
  while index < from.count {
    unsafe Pointer.write<ValueBits>(unsafe machine.localCell(index), unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(locals, index)))
    index = index + 1
  }
  let operands = unsafe Pointer.assumeManyMut<ValueBits>(from.stack)
  index = 0
  while index < from.sp { unsafe machine.push(unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(operands, index))) index = index + 1 }
  from.taken = true
  let pc = from.pc
  let inner = from.inner
  let threw = from.threw
  drop from
  unsafe machine.setPc(pc)
  // Past the opcode of the call that threw, as the frame of a call that fails stands.
  if threw { unsafe machine.setPc(pc + 1) unsafe machine.publishPc() return true }
  let next = match Pointer.nonNullMut<baseline.Inlined>(inner) { Option<*mut baseline.Inlined>.Some { value } => value Option<*mut baseline.Inlined>.None => { return false } }
  let call = unsafe Pointer.borrow<(), baseline.Inlined>(&anchor, unsafe Intrinsic.pointerRequalify<*mut baseline.Inlined, *const baseline.Inlined>(next))
  let argc = call.argc
  let method = call.method
  let after = call.after
  drop call
  let mut extra: usize = 1
  if method { extra = 2 }
  if machine.sp() < argc + extra { invariant() }
  // As the call instruction leaves the frame for whoever reads the frame chain.
  unsafe machine.setPc(after)
  unsafe machine.publishPc()
  let data = unsafe operandCell(machine.stackTop, argc)
  let function = unsafe machine.top(argc + 1)
  let mut receiver = ValueBits.Undefined
  if method { receiver = unsafe machine.top(argc + 2) }
  let argv = FrameSlots { data: data, count: argc }
  let called = run Effect.result(unsafe callInlined(&mut hooks, memory, machine.context, function, receiver, &argv, next))
  match move called {
    Result<ValueBits, JsException>.Success { value } => {
      unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
      unsafe machine.push(value)
      return false
    }
    Result<ValueBits, JsException>.Failure { .. } => { return true }
  }
}
/// The call of function that began the inlined activation of state (js_baseline.Inlined):
/// callInternal with a frame that goes on from that state. What no frame took (the call
/// failed before it had one) is released here, so the state holds nothing afterwards.
@inlineNever
unsafe effect fn callInlined<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots,
  state: *mut baseline.Inlined) -> ValueBits ! JsException ? &mut Allocator {
  let resume = compiled.Resume { state: unsafe Intrinsic.pointerRequalify<*mut u64, ?*mut u64>(unsafe Intrinsic.pointerReinterpret<*mut baseline.Inlined, *mut u64>(state)),
    exit: compiled.EXIT_INLINED, index: 0 }
  let called = run Effect.result(unsafe callResuming(&mut hooks, memory, context, function, receiver, ValueBits.Undefined, argv, activation.COPY_ARGUMENTS, resume))
  let rt = unsafe runtime.contextRuntime(context)
  let mut left: ?*mut baseline.Inlined = unsafe Intrinsic.pointerRequalify<*mut baseline.Inlined, ?*mut baseline.Inlined>(state)
  while true {
    let at = match Pointer.nonNullMut<baseline.Inlined>(left) { Option<*mut baseline.Inlined>.Some { value } => value Option<*mut baseline.Inlined>.None => { break } }
    let mut anchor = ()
    let record = unsafe Pointer.borrowMut<(), baseline.Inlined>(&mut anchor, at)
    left = record.inner
    if record.taken { continue }
    record.taken = true
    let locals = unsafe Pointer.assumeManyMut<ValueBits>(record.locals)
    let mut index: usize = 0
    while index < record.count { unsafe gc.release(&mut hooks, rt, unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(locals, index))) index = index + 1 }
    let operands = unsafe Pointer.assumeManyMut<ValueBits>(record.stack)
    index = 0
    while index < record.sp { unsafe gc.release(&mut hooks, rt, unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(operands, index))) index = index + 1 }
  }
  match move called {
    Result<ValueBits, JsException>.Success { value } => { return value }
    Result<ValueBits, JsException>.Failure { .. } => { fail JsException {} }
  }
}
/// SERVICE_INLINED: the frame of record, built, is at the call of a function that optimized
/// code had inlined, with depth operands on its stack and its pc past the call's opcode;
/// state is the callee's activation. Makes the call with a frame that goes on from that
/// state (callInlined). js_baseline.moved to the instruction after the call, the result in
/// place of the call's operands; 1 when it threw, the operands still in their cells.
@inlineNever
unsafe effect fn baselineInlined<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, record: *mut baseline.BaselineFrame, state: *mut baseline.Inlined, depth: usize) -> u64 ? &mut Allocator {
  let anchor = ()
  let call = unsafe Pointer.borrow<(), baseline.Inlined>(&anchor, unsafe Intrinsic.pointerRequalify<*mut baseline.Inlined, *const baseline.Inlined>(state))
  let argc = call.argc
  let method = call.method
  let after = call.after
  drop call
  let mut operands = argc + 1
  if method { operands = operands + 1 }
  let frame = unsafe baseline.cellsOf(record)
  if depth < operands || depth > frame.stack { invariant() }
  let stack = unsafe Pointer.assumeManyMut<ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(frame.cells), frame.arguments + frame.locals))
  let first = depth - operands
  let function = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(stack, depth - argc - 1))
  let mut receiver = ValueBits.Undefined
  if method { receiver = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(stack, first)) }
  let argv = FrameSlots { data: unsafe Pointer.atMut<ValueBits>(stack, depth - argc), count: argc }
  let called = run Effect.result(unsafe callInlined(&mut hooks, memory, context, function, receiver, &argv, state))
  match move called {
    Result<ValueBits, JsException>.Success { value } => {
      let rt = unsafe runtime.contextRuntime(context)
      let mut index = first
      while index < depth { unsafe gc.release(&mut hooks, rt, unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(stack, index))) index = index + 1 }
      unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(stack, first), value)
      return baseline.moved(after, first + 1)
    }
    Result<ValueBits, JsException>.Failure { .. } => { return 1 }
  }
}
/// The Description of the activation in record, a baseline frame: its closure's, or a known
/// local function's with the scope its caller passed. The empty tables are the caller's
/// (stack allocated there).
@inlineAlways
unsafe fn baselineDescribe(record: *mut baseline.BaselineFrame, empty: *mut ValueBits, emptyRefs: *mut ?*mut HeapHeader) -> activation.Description {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), baseline.BaselineFrame>(&anchor, unsafe Intrinsic.pointerRequalify<*mut baseline.BaselineFrame, *const baseline.BaselineFrame>(record))
  let function = running.frame.currentFunction
  let argc = running.argc
  let scope = running.scope
  drop running
  match function {
    ValueBits.FunctionBytecode { reference } => {
      let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, reference)
      let mut references = unsafe Intrinsic.pointerRequalify<*mut ?*mut HeapHeader, *const ?*mut HeapHeader>(emptyRefs)
      if code.known.refs.length() != 0 { references = Pointer.fromRef<?*mut HeapHeader>(&code.known.refs.asSlice()[0]) }
      drop code
      return unsafe activation.describeKnown(reference, activation.KnownContext { references: references, scope: scope }, empty, argc, activation.COPY_ARGUMENTS, false)
    }
    _ => { return unsafe activation.describe(function, empty, emptyRefs, argc, activation.COPY_ARGUMENTS, false) }
  }
}
/// What baseline code asks the engine for through its host (js_baseline.ServiceEntry), on the
/// hooks of the dispatch that entered it. record is the running baseline frame; request a
/// SERVICE_* with its flags. 0, or 1 when the request threw (the exception is pending).
pub unsafe effect fn baselineService<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, record: *mut baseline.BaselineFrame, request: u64, base: *mut ValueBits, count: usize) -> u64 ? &mut Allocator {
  let kind = request & 0xff
  // What only allocates reads no frame: it leaves the code's bare frames bare, and stays
  // out of the frame the other requests need.
  if kind >= baseline.SERVICE_QUICK && kind != baseline.SERVICE_INLINED {
    if kind == baseline.SERVICE_RESUME { return unsafe baseline.resume(record, request, count) }
    return run unsafe baselineLight(&mut hooks, memory, record, request, base, count)
  }
  if (request & (0xff | baseline.CALL_NATIVE)) == (baseline.SERVICE_CALL | baseline.CALL_NATIVE) {
    return run unsafe baselineCallNative(&mut hooks, memory, record, request, base, count)
  }
  return run unsafe baselineHeavy(&mut hooks, memory, record, request, base, count)
}
/// baselineService's SERVICE_QUICK and SERVICE_CONCAT.
@inlineNever
unsafe effect fn baselineLight<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + PrototypeHooks>(hooks: &mut H, memory: &AllocationObserver, record: *mut baseline.BaselineFrame,
  request: u64, base: *mut ValueBits, count: usize) -> u64 ? &mut Allocator {
  let anchor = ()
  let running = unsafe Pointer.borrow<(), baseline.BaselineFrame>(&anchor, unsafe Intrinsic.pointerRequalify<*mut baseline.BaselineFrame, *const baseline.BaselineFrame>(record))
  let function = running.frame.currentFunction
  drop running
  let bytecode = match function { ValueBits.FunctionBytecode { reference } => reference _ => (unsafe activation.calleeOf(function)).bytecode }
  let context = (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)).realm
  // An allocation profile attributes what is made now to the frame chain.
  if memory.profiling() { unsafe baseline.build(unsafe runtime.contextRuntime(context), record) }
  if (request & 0xff) == baseline.SERVICE_ARRAY {
    let receiver = unsafe Pointer.read<ValueBits>(unsafe operandCell(base, 1))
    if (request & baseline.ARRAY_GROW) != 0 {
      let low = usize.toI64(usize.shiftRight(count, 32))
      let high = usize.toI64(usize.bitAnd(count, 4294967295))
      if run unsafe nativeFunctions.quickGrow(&mut hooks, unsafe lendRealm(&context, context), receiver, low, high) { return 0 }
      return 2
    }
    let mut answer = Option<ValueBits>.none()
    if (request & baseline.ARRAY_POP) != 0 { answer = unsafe nativeFunctions.quickPop(receiver) }
    else {
      let argv = FrameSlots { data: unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(base), 1), count: count }
      answer = run unsafe nativeFunctions.quickPush(&mut hooks, unsafe lendRealm(&context, context), receiver, &argv)
    }
    match move answer {
      Option<ValueBits>.Some { value } => {
        let mut answered = ()
        let after = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut answered, record)
        after.result = value
        return 0
      }
      Option<ValueBits>.None => { return 2 }
    }
  }
  if (request & 0xff) == baseline.SERVICE_NEW { return run unsafe baselineNew(&mut hooks, memory, context, record, base, count) }
  if (request & 0xff) == baseline.SERVICE_QUICK { return run unsafe baselineQuick(&mut hooks, memory, context, record, bytecode, u64.toUsize(u64.shiftRight(request, 8)), base) }
  if (request & 0xff) == baseline.SERVICE_SCOPE {
    let own = (unsafe Pointer.borrow<(), baseline.BaselineFrame>(&anchor, unsafe Intrinsic.pointerRequalify<*mut baseline.BaselineFrame, *const baseline.BaselineFrame>(record))).scope
    unsafe baselineScopeEnd(&mut hooks, unsafe runtime.contextRuntime(context), own)
    return 0
  }
  return run unsafe baselineConcat(&mut hooks, context, record, bytecode, base, count, request)
}
/// SERVICE_NEW (js_baseline): the object of `new Array()`, or the receiver of a base
/// constructor that has baseline code and no plan (what baselineConstruct runs through
/// constructWith), for the code to run on it.
@inlineNever
unsafe effect fn baselineNew<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  record: *mut baseline.BaselineFrame, base: *mut ValueBits, count: usize) -> u64 ? &mut Allocator {
  let function = unsafe Pointer.read<ValueBits>(base)
  let newTarget = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(base), 1))
  let callee = match function { ValueBits.Object { reference } => reference _ => { return 2 } }
  if !unsafe sameValueBits(function, newTarget) { return 2 }
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, callee)
  let mut made = ValueBits.Uninitialized
  let mut answer: u64 = 0
  if object.classId() == classes.JS_CLASS_BYTECODE_FUNCTION {
    let bytecode = match &object.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { return 2 } }
    drop object
    if !boxing.isConstructor(unsafe lendBits(&function, function)) { return 2 }
    let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
    if code.baseline == 0 || code.isDerivedClassConstructor || code.constructForm != CONSTRUCT_GENERIC { return 2 }
    let realm = code.realm
    drop code
    let created = run Effect.result(unsafe constructors.createReceiver(&mut hooks, memory, unsafe lendRealm(&realm, realm), newTarget))
    match move created {
      Result<ValueBits, JsException>.Success { value } => { made = value answer = baseline.NEW_RECEIVER }
      Result<ValueBits, JsException>.Failure { .. } => {
        // The error's stack names the code's frames.
        unsafe baseline.build(unsafe runtime.contextRuntime(context), record)
        return 1
      }
    }
  } else {
    drop object
    if count != 0 { return 2 }
    match run arraySupport.constructEmpty(&mut hooks, memory, unsafe lendRealm(&context, context), function) {
      Option<ValueBits>.Some { value } => { made = value }
      Option<ValueBits>.None => { return 2 }
    }
  }
  let mut answered = ()
  let after = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut answered, record)
  after.result = made
  return answer
}
/// Drops what the frame of an activation that ends holds of own, its scope: the slots of
/// one still in the frame, or the count of one a closure moved to the heap.
@inlineNever
unsafe fn baselineScopeEnd<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, own: ?*mut HeapHeader) -> () {
  match Pointer.nonNullMut<HeapHeader>(own) {
    Option<*mut HeapHeader>.Some { value } => {
      if unsafe scopes.inFrame(value) { unsafe scopes.releaseFrameScope(&mut hooks, runtime, value) } else { unsafe scopes.releaseScope(&mut hooks, runtime, value) }
    }
    _ => ()
  }
}
/// The scope the interpreter left record's activation with: a closure it made may have
/// moved the frame's own to the heap. A frame that reads no scope from its record ignores it.
@inlineAlways
unsafe fn baselineKeepScope(record: *mut baseline.BaselineFrame, machine: &Machine) -> () {
  let mut anchor = ()
  let running = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut anchor, record)
  running.scope = machine.scope
}
/// baselineService's other requests.
@inlineNever
unsafe effect fn baselineHeavy<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, record: *mut baseline.BaselineFrame, request: u64, base: *mut ValueBits, count: usize) -> u64 ? &mut Allocator {
  let kind = request & 0xff
  if kind == baseline.SERVICE_OVERFLOW {
    // base is the entered function's bytecode (it has no frame to name it).
    let enteredAnchor = ()
    let home = (unsafe HeapCell.payload<FunctionBytecode, ()>(&enteredAnchor, unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut HeapHeader>(base))).realm
    // The error's stack names the callers: their frames first.
    unsafe baseline.build(unsafe runtime.contextRuntime(home), record)
    drop run Effect.result(unsafe stackOverflowValue(&mut hooks, memory, home))
    return 1
  }
  let mut anchor = ()
  let running = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut anchor, record)
  let function = running.frame.currentFunction
  drop running
  // A known local function's frame names its bytecode; any other its closure object.
  let bytecode = match function { ValueBits.FunctionBytecode { reference } => reference _ => (unsafe activation.calleeOf(function)).bytecode }
  let codeAnchor = ()
  let context = (unsafe HeapCell.payload<FunctionBytecode, ()>(&codeAnchor, bytecode)).realm
  // Whatever runs now may read the frame chain: complete the code's bare frames.
  unsafe baseline.build(unsafe runtime.contextRuntime(context), record)
  if kind == baseline.SERVICE_FINISH { return run unsafe baselineFinish(&mut hooks, memory, record, (request & baseline.FINISH_THROWING) != 0, count) }
  if kind == baseline.SERVICE_INLINED {
    return run unsafe baselineInlined(&mut hooks, memory, context, record, unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut baseline.Inlined>(base), count)
  }
  if kind == baseline.SERVICE_STEP { return run unsafe baselineStep(&mut hooks, memory, record, u64.toUsize(u64.shiftRight(request, 8)), Pointer.address<ValueBits>(base), count) }
  if kind == baseline.SERVICE_POLL {
    let polled = run Effect.result(interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)))
    return match move polled {
      Result<(), JsException>.Success { .. } => 0
      Result<(), JsException>.Failure { .. } => 1
    }
  }
  let target = unsafe Pointer.read<ValueBits>(base)
  if kind == baseline.SERVICE_CONSTRUCT {
    let newTarget = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(base), 1))
    let operands = FrameSlots { data: unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(base), 2), count: count }
    let made = run Effect.result(unsafe baselineConstruct(&mut hooks, memory, context, target, newTarget, &operands))
    match move made {
      Result<ValueBits, JsException>.Success { value } => {
        let mut madeAnchor = ()
        let after = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut madeAnchor, record)
        after.result = value
        return 0
      }
      Result<ValueBits, JsException>.Failure { .. } => { return 1 }
    }
  }
  let mut receiver = ValueBits.Undefined
  if (request & baseline.CALL_METHOD) != 0 { receiver = unsafe Pointer.read<ValueBits>(unsafe operandCell(base, 1)) }
  let argv = FrameSlots { data: unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(base), 1), count: count }
  let called = run Effect.result(unsafe callInternal(&mut hooks, memory, context, target, receiver, ValueBits.Undefined, &argv, activation.COPY_ARGUMENTS))
  match move called {
    Result<ValueBits, JsException>.Success { value } => {
      let mut resultAnchor = ()
      let after = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut resultAnchor, record)
      after.result = value
      return 0
    }
    Result<ValueBits, JsException>.Failure { .. } => { return 1 }
  }
}
/// SERVICE_CALL with CALL_NATIVE, on a path of its own short of baselineHeavy's: the callee
/// at base is most often a native function, which baselineNative calls once the code's bare
/// frames are complete. Anything else, and a native whose poll is due, is baselineHeavy's
/// call, the flag cleared. 0 with the result in the record, 1 when the call threw, or
/// CALL_RETARGET with nothing changed.
@inlineNever
unsafe effect fn baselineCallNative<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, record: *mut baseline.BaselineFrame, request: u64, base: *mut ValueBits, count: usize) -> u64 ? &mut Allocator {
  let target = unsafe Pointer.read<ValueBits>(base)
  if target.isObject() && unsafe classId(target) == classes.JS_CLASS_C_FUNCTION {
    let anchor = ()
    // `f.call(x, ...)` with f a function that has code: the code calls f (CALL_RETARGET).
    if (request & baseline.CALL_METHOD) != 0 && count != 0 && unsafe invoke.isCall(target) {
      let called = unsafe Pointer.read<ValueBits>(unsafe operandCell(base, 1))
      if called.isObject() && unsafe classId(called) == classes.JS_CLASS_BYTECODE_FUNCTION
        && (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, (unsafe activation.calleeOf(called)).bytecode)).baseline != 0 { return baseline.CALL_RETARGET }
    }
    let running = unsafe Pointer.borrow<(), baseline.BaselineFrame>(&anchor, unsafe Intrinsic.pointerRequalify<*mut baseline.BaselineFrame, *const baseline.BaselineFrame>(record))
    let function = running.frame.currentFunction
    let bare = baseline.bare(running.state)
    drop running
    let bytecode = match function { ValueBits.FunctionBytecode { reference } => reference _ => (unsafe activation.calleeOf(function)).bytecode }
    let context = (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)).realm
    // The native may read the frame chain, and its own frame goes on top of it.
    if bare { unsafe baseline.build(unsafe runtime.contextRuntime(context), record) }
    let method = (request & baseline.CALL_METHOD) != 0
    let mut receiver = ValueBits.Undefined
    if method { receiver = unsafe Pointer.read<ValueBits>(unsafe operandCell(base, 1)) }
    let argv = FrameSlots { data: unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(base), 1), count: count }
    let called = run Effect.result(unsafe baselineNative(&mut hooks, memory, context, target, receiver, &argv, method))
    match move called {
      Result<ValueBits, JsException>.Success { value } => {
        if !match value { ValueBits.Uninitialized => true _ => false } {
          let mut resultAnchor = ()
          let after = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut resultAnchor, record)
          after.result = value
          return 0
        }
      }
      Result<ValueBits, JsException>.Failure { .. } => { return 1 }
    }
  }
  return run unsafe baselineHeavy(&mut hooks, memory, record, request ^ baseline.CALL_NATIVE, base, count)
}
/// A call of function, a native, from baseline code (baselineCallNative): the
/// native call the interpreter's call instruction makes with no frames of its own around it
/// (quickInline, nativeInline, stringInline), charging the poll as they do, and with their
/// answers that need no Machine: RegExp.prototype.exec through quickExec,
/// String.prototype.replace through quickReplace, String(n) of an Int, a string method's
/// primitive entry. The operands stay the caller's. Uninitialized, with nothing changed,
/// when the poll is due: the full call handles it.
@inlineAlways
unsafe effect fn baselineNative<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots, method: bool) -> ValueBits
  ! JsException ? &mut Allocator {
  let counter = unsafe interrupts.counter(context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return ValueBits.Uninitialized }
  unsafe Pointer.write<i32>(counter, left - 1)
  let kind = unsafe nativeFunctions.callKind(function)
  if kind == nativeFunctions.CALL_KIND_STRING && method && receiver.isString() {
    if let Option<ValueBits>.Some { value } = move run unsafe nativeFunctions.stringCall(&mut hooks, function, receiver, argv) { return value }
  }
  if kind == nativeFunctions.OBJECT_METHOD_MATH {
    let answer = unsafe nativeFunctions.mathCall(function, argv.*)
    match answer { ValueBits.Uninitialized => () _ => { return answer } }
  }
  if kind == nativeFunctions.CALL_KIND_ANSWER {
    let ctxAnchor = ()
    let runtime = (unsafe HeapCell.payload<ContextState, ()>(&ctxAnchor, context)).runtime
    let answer = unsafe nativeFunctions.leanAnswer(runtime, function, receiver, argv)
    match answer { ValueBits.Uninitialized => () _ => { return answer } }
  }
  if kind < nativeFunctions.CALL_KIND_LEAN {
    if let Option<nativeFunctions.QuickTarget>.Some { value: target } = unsafe nativeFunctions.quickTarget(function) {
      if argv.count == 1 {
        if let Option<ValueBits>.Some { value } = move run nativeFunctions.stringOfInteger(&target, argv) { return value }
      }
      if method && argv.count == 2 {
        if let Option<*mut HeapHeader>.Some { value: home } = Pointer.nonNullMut<HeapHeader>(nativeFunctions.stringReplaceRealm(&target)) {
          let quick = run regexpSymbols.quickReplace(&mut hooks, memory, unsafe lendRealm(&home, home), receiver, unsafe argv.get(0), unsafe argv.get(1))
          if let Option<ValueBits>.Some { value } = move quick { return value }
        }
      }
      // callClass's answers: the reads that cannot throw, then push, pop and the like.
      let quick = nativeFunctions.quick(&mut hooks, unsafe lendRealm(&context, context), &target, unsafe lendBits(&receiver, receiver), argv.*)
      match quick { ValueBits.Uninitialized => () _ => { return quick } }
      let written = run unsafe nativeFunctions.quickWrite(&mut hooks, &target, receiver, argv)
      if let Option<ValueBits>.Some { value } = move written { return value }
    } else if method && argv.count != 0 {
      let mut test = false
      if let Option<*mut HeapHeader>.Some { value: home } = Pointer.nonNullMut<HeapHeader>(unsafe nativeFunctions.regexpExecRealm(function, &mut test)) {
        if !test {
          let quick = run regexpExec.quickExec(&mut hooks, memory, unsafe lendRealm(&home, home), receiver, unsafe argv.get(0), false)
          if let Option<ValueBits>.Some { value } = move quick { return value }
        }
      }
    }
  }
  return run unsafe callNativePlain(&mut hooks, memory, context, function, receiver, argv)
}
/// SERVICE_QUICK (js_baseline): the allocating instruction at offset pc of bytecode's code,
/// with top the cell above the frame's operand stack.
unsafe effect fn baselineQuick<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + PrototypeHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader, record: *mut baseline.BaselineFrame,
  bytecode: *mut HeapHeader, pc: usize, top: *mut ValueBits) -> u64 ? &mut Allocator {
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let bytes = unsafe function.code.asSlice()
  drop function
  // Every instruction here has an operand byte or an instruction after it.
  if pc + 2 > bytes.length { return 2 }
  let opcode = bytes[pc]
  // The address of the instruction's operand, as the interpreter's caches key it.
  let site = Pointer.address<u8>(Pointer.fromRef<u8>(&bytes[pc])) + 1
  let rt = unsafe runtime.contextRuntime(context)
  if opcode == op.OP_object {
    // {...source} of a local or argument starts with a read of it (object_ops.spreadSourceWidth).
    let next = bytes[pc + 1]
    let mut width: usize = 0
    if (next >= op.OP_get_loc0 && next <= op.OP_get_loc0 + 3) || (next >= op.OP_get_arg0 && next <= op.OP_get_arg0 + 3) { width = 1 }
    else if next == op.OP_get_loc8 { width = 2 }
    else if next == op.OP_get_loc || next == op.OP_get_arg || next == op.OP_get_loc_check { width = 3 }
    let after = pc + 1 + width
    let spreads = width != 0 && after + 5 <= bytes.length && bytes[after] == op.OP_null && bytes[after + 1] == op.OP_copy_data_properties
      && bytes[after + 2] == 6 && bytes[after + 3] == op.OP_drop && bytes[after + 4] == op.OP_drop
    if run unsafe objects.literalAt(&mut hooks, memory, rt, context, site, !spreads, top) { return 0 }
    return 2
  }
  if opcode == op.OP_set_proto {
    // { __proto__: value } on the literal under the value: an object or null becomes its
    // prototype, anything else is dropped. What the engine refuses (nothing on a literal
    // just made) the interpreter throws.
    let object = unsafe Pointer.read<ValueBits>(unsafe operandCell(top, 2))
    let prototype = unsafe Pointer.read<ValueBits>(unsafe operandCell(top, 1))
    if !object.isObject() || unsafe classId(object) != classes.JS_CLASS_OBJECT { return 2 }
    if prototype.isObject() || match prototype { ValueBits.Null => true _ => false } {
      let result = run Effect.result(unsafe prototypes.setPrototypeInternal(&mut hooks, unsafe lendRealm(&context, context), unsafe lendBits(&object, object), prototype, true))
      match move result {
        Result<bool, OutOfMemoryError | JsException | PrototypeError>.Success { .. } => ()
        Result<bool, OutOfMemoryError | JsException | PrototypeError>.Failure { error } => { drop error return 2 }
      }
    }
    unsafe gc.release(&mut hooks, rt, prototype)
    return 0
  }
  if opcode == op.OP_put_field {
    // Past the code's key and its helper: the store that allocates (a slot list that grows,
    // a shape not made yet) and an Array's new length, as the interpreter's put_field makes
    // them before it steps.
    if pc + 13 > bytes.length { return 2 }
    let object = unsafe Pointer.read<ValueBits>(unsafe operandCell(top, 2))
    if !run unsafe properties.putFieldAt(&mut hooks, rt, context, Pointer.fromRef<u8>(&bytes[pc + 1]), object, unsafe operandCell(top, 1)) { return 2 }
    unsafe gc.release(&mut hooks, rt, object)
    return 0
  }
  if opcode == op.OP_define_field {
    if pc + 5 > bytes.length { return 2 }
    let atom = u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8) | u32.shiftLeft(u8.toU32(bytes[pc + 3]), 16) | u32.shiftLeft(u8.toU32(bytes[pc + 4]), 24)
    let object = unsafe Pointer.read<ValueBits>(unsafe operandCell(top, 2))
    let value = unsafe Pointer.read<ValueBits>(unsafe operandCell(top, 1))
    if run unsafe objects.defineFieldAt(&mut hooks, rt, object, atom, value, site) { return 0 }
    return 2
  }
  if opcode == op.OP_fclosure8 || opcode == op.OP_fclosure {
    // The closure of a constant, in the scope the frame runs in: its own (the record's, as
    // a known local function's is) or the one its closure captured. A set_name after it
    // names the closure, and the code goes on after both.
    let mut index = u8.toUsize(bytes[pc + 1])
    let mut size: usize = 2
    if opcode == op.OP_fclosure {
      if pc + 5 > bytes.length { return 2 }
      index = u32.toUsize(u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8) | u32.shiftLeft(u8.toU32(bytes[pc + 3]), 16) | u32.shiftLeft(u8.toU32(bytes[pc + 4]), 24))
      size = 5
    }
    let mut name: u32 = 0
    if pc + size + 5 <= bytes.length && bytes[pc + size] == op.OP_set_name {
      name = u8.toU32(bytes[pc + size + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + size + 2]), 8) | u32.shiftLeft(u8.toU32(bytes[pc + size + 3]), 16) | u32.shiftLeft(u8.toU32(bytes[pc + size + 4]), 24)
    }
    let codeAnchor = ()
    let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&codeAnchor, bytecode)
    if index >= code.constants.length() { return 2 }
    let constant = code.constants.asSlice()[index]
    let own = code.scopeSlots != 0
    drop code
    let mut frameAnchor = ()
    let running = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut frameAnchor, record)
    let function = running.frame.currentFunction
    let recorded = own || match function { ValueBits.FunctionBytecode { reference: _ } => true _ => false }
    let mut scope = running.scope
    if !recorded { scope = (unsafe activation.closureCaptures(function, Pointer.fromRef<?*mut HeapHeader>(&scope))).scope }
    drop running
    let answer = run unsafe factories.closureAt(&mut hooks, memory, rt, context, function, &mut scope, constant, name, top)
    if recorded {
      let mut keepAnchor = ()
      let kept = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut keepAnchor, record)
      kept.scope = scope
    }
    return answer
  }
  if pc + 3 > bytes.length { return 2 }
  if opcode == op.OP_rest {
    // The arguments past the named ones, as the caller passed them (the record's, which a
    // bare frame has too).
    let frameAnchor = ()
    let running = unsafe Pointer.borrow<(), baseline.BaselineFrame>(&frameAnchor, unsafe Intrinsic.pointerRequalify<*mut baseline.BaselineFrame, *const baseline.BaselineFrame>(record))
    let argv = running.argv
    let argc = running.argc
    drop running
    let mut first = u8.toUsize(bytes[pc + 1]) | usize.shiftLeft(u8.toUsize(bytes[pc + 2]), 8)
    if first > argc { first = argc }
    let from = unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(argv), first))
    if run unsafe objects.restAt(&mut hooks, memory, context, from, argc - first, top) { return 0 }
    return 2
  }
  if opcode == op.OP_array_from {
    let count = u8.toUsize(bytes[pc + 1]) | usize.shiftLeft(u8.toUsize(bytes[pc + 2]), 8)
    if count > 16 { return 2 }
    let first = unsafe operandCell(top, count)
    if run unsafe objects.arrayAt(&mut hooks, memory, context, first, count) { return 0 }
    return 2
  }
  return 2
}
/// SERVICE_CONCAT (js_baseline): the + of the values in left and the cell at address right.
unsafe effect fn baselineConcat<H: HeapHooks + CoercionHooks>(hooks: &mut H, context: *mut HeapHeader, record: *mut baseline.BaselineFrame, bytecode: *mut HeapHeader,
  left: *mut ValueBits, right: usize, request: u64) -> u64 ? &mut Allocator {
  let borrowed = (request & baseline.CONCAT_BORROWED) != 0
  // left + (right - left), so the pointer keeps left's provenance.
  let bytes = unsafe Pointer.assumeManyMut<u8>(unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut u8>(left))
  let other = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ValueBits>(unsafe Pointer.atMut<u8>(bytes, usize.wrappingSubtract(right, Pointer.address<ValueBits>(left))))
  let a = unsafe Pointer.read<ValueBits>(left)
  let mut b = unsafe Pointer.read<ValueBits>(other)
  if !a.isString() && !b.isString() { return 2 }
  let rt = unsafe runtime.contextRuntime(context)
  if borrowed { b = unsafe b.retained() }
  if (request & baseline.CONCAT_STACK) != 0 && a.isString() && b.isString() {
    // `a + b + 'c'`, as the interpreter's add joins it (js_vm_operators addThree): the
    // literal's push and the add after it are done with this one.
    let anchor = ()
    let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
    let code = unsafe function.code.asSlice()
    let stack = u16.toUsize(function.stackSize)
    drop function
    let pc = u64.toUsize(u64.shiftRight(request, 16))
    if pc < code.length {
      let after = pc + u8.toUsize(op.opcodeInfo(code[pc], true).size)
      if after + 6 <= code.length && code[after] == op.OP_push_atom_value && code[after + 5] == op.OP_add {
        let atom = u8.toU32(code[after + 1]) | u32.shiftLeft(u8.toU32(code[after + 2]), 8) | u32.shiftLeft(u8.toU32(code[after + 3]), 16) | u32.shiftLeft(u8.toU32(code[after + 4]), 24)
        let three = run Effect.result(unsafe operators.joinThree(rt, a, b, atom))
        match move three {
          Result<ValueBits, OutOfMemoryError>.Success { value } => {
            match value {
              ValueBits.Uninitialized => ()
              _ => {
                unsafe Pointer.write<ValueBits>(left, value)
                // The operand stack ends where the record starts: left's index, plus the result.
                let below = (Pointer.address<baseline.BaselineFrame>(unsafe Intrinsic.pointerRequalify<*mut baseline.BaselineFrame, *const baseline.BaselineFrame>(record)) - Pointer.address<ValueBits>(unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(left))) / Layout.of<ValueBits>().bytes
                return baseline.moved(after + 6, stack - below + 1)
              }
            }
          }
          // Nothing was consumed: the two-part join below reports what fails.
          Result<ValueBits, OutOfMemoryError>.Failure { .. } => ()
        }
      }
    }
  }
  let joined = run Effect.result(operators.joinValues(a, b))
  match move joined {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => {
      match value {
        ValueBits.Uninitialized => { if borrowed { unsafe gc.release(&mut hooks, rt, b) } return 2 }
        _ => ()
      }
      unsafe Pointer.write<ValueBits>(left, value)
      return 0
    }
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => {
      // The concatenation consumed its string operands.
      unsafe Pointer.write<ValueBits>(left, ValueBits.Undefined)
      if !borrowed { unsafe Pointer.write<ValueBits>(other, ValueBits.Undefined) }
      // The error's stack names the code's frames.
      unsafe baseline.build(rt, record)
      let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&context, context), move error), core.exceptionValue)
      return 1
    }
  }
}
/// SERVICE_CONSTRUCT: `new` of function with newTarget on argv, borrowed, as constructInline
/// does it for the interpreter: from the constructor's plan or recipe where it has one,
/// through the function a forwarding wrapper calls, or by running it. Arguments a plan moved
/// into the object are left Undefined in argv.
@inlineNever
unsafe effect fn baselineConstruct<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, newTarget: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  if !function.isObject() || unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION || !boxing.isConstructor(unsafe lendBits(&function, function)) {
    return run unsafe constructInternal(&mut hooks, memory, context, function, newTarget, argv, activation.COPY_ARGUMENTS)
  }
  let mut realm = context
  if unsafe isDerivedConstructor(function, &mut realm) {
    return run unsafe constructInternal(&mut hooks, memory, context, function, newTarget, argv, activation.COPY_ARGUMENTS)
  }
  let rt = unsafe runtime.contextRuntime(context)
  let form = unsafe constructors.formOf(function)
  let same = unsafe sameValueBits(function, newTarget)
  let mut polled = false
  if same && form != CONSTRUCT_GENERIC {
    let mut planned = ValueBits.Uninitialized
    let mut consumed = false
    if form == CONSTRUCT_STORES { planned = run unsafe constructPlanned(&mut hooks, memory, realm, function, argv, &mut consumed) }
    else {
      if interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
      polled = true
      planned = run unsafe constructRecipe(&mut hooks, memory, realm, rt, function, form, argv)
    }
    match planned {
      ValueBits.Object { reference } => {
        if form != CONSTRUCT_STORES { unsafe gc.pinConstructed(&mut hooks, rt, reference) }
        if consumed {
          // Moved into the object bitwise: the code's releases find nothing.
          let mut index: usize = 0
          while index < argv.count {
            unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(argv.data), index), ValueBits.Undefined)
            index = index + 1
          }
        }
        return planned
      }
      _ => ()
    }
  }
  if !polled && interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
  let receiver = run unsafe constructors.createReceiver(&mut hooks, memory, unsafe lendRealm(&realm, realm), newTarget)
  if form == CONSTRUCT_STORES && unsafe constructors.simpleConstruct(&mut hooks, rt, function, receiver, argv) {
    match receiver { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, rt, reference) } _ => () }
    return receiver
  }
  if form == CONSTRUCT_EVAL && run unsafe evaluation.constructGrowing(&mut hooks, rt, core.reference(newTarget), function, receiver, argv, same) {
    match receiver { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, rt, reference) } _ => () }
    return receiver
  }
  if form == CONSTRUCT_FORWARD {
    // new W(...) for a wrapper W whose body is this[name].apply(this, arguments): the
    // function it names runs on the receiver, and its result is the wrapper's to drop.
    let target = unsafe forwardedTarget(rt, function, receiver, unsafe constructors.forwardedAtom(function))
    if target.isObject() {
      if unsafe constructors.formOf(target) == CONSTRUCT_EVAL && run unsafe evaluation.constructGrowing(&mut hooks, rt, core.reference(newTarget), target, receiver, argv, true) {
        match receiver { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, rt, reference) } _ => () }
        return receiver
      }
      let called = run Intrinsic.catchFailure<JsException>(unsafe callInternal(&mut hooks, memory, context, target, receiver, ValueBits.Undefined, argv, activation.COPY_ARGUMENTS), failedConstruct)
      return match move called {
        ValueBits value => { unsafe gc.release(&mut hooks, rt, value) receiver }
        FailedConstruct { error } => { unsafe gc.release(&mut hooks, rt, receiver) fail move error }
      }
    }
  }
  return run unsafe constructWith(&mut hooks, memory, context, function, receiver, newTarget, argv, JS_CALL_FLAG_CONSTRUCTOR | activation.COPY_ARGUMENTS)
}
unsafe effect fn stackOverflowValue<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader) -> ValueBits
  ! JsException ? &mut Allocator {
  return run unsafe stackOverflow(&mut hooks, memory, context)
}
/// SERVICE_FINISH: the interpreter takes over the activation of record, a built baseline frame
/// whose StackFrame holds the bytecode offset to continue at, with sp operands on its
/// stack, runs it to its return and releases its cells, as callResuming does for a frame it
/// built: 0 with the result in the record, or 1 when it threw. The frame stays published; the
/// code unlinks it. When throwing, the pending exception is unwound instead: 1 when the frame
/// has no handler for it (the cells are released), or js_baseline.moved to the handler, where
/// the code goes on.
unsafe effect fn baselineFinish<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, record: *mut baseline.BaselineFrame, throwing: bool, sp: usize) -> u64 ? &mut Allocator {
  let mut anchor = ()
  let running = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut anchor, record)
  let framePointer = Pointer.fromMutRef<StackFrame>(&mut running.frame)
  let argv = FrameSlots { data: running.argv, count: running.argc }
  let pc = running.frame.currentPc if pc == NO_PC { invariant() }
  let receiver = running.frame.thisValue
  let newTarget = running.frame.newTarget
  let own = running.scope
  drop running
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  let description = unsafe baselineDescribe(record, empty, emptyRefs)
  let rt = unsafe runtime.contextRuntime(description.realm)
  let mut machine = unsafe activation.machine(&description, rt, description.realm, framePointer, &argv, receiver, newTarget, empty, pc, sp)
  // A function with a scope of its own runs in the one its prologue began (js_baseline.beginScope).
  let scoped = unsafe activation.scopeSlotsOf(&description) != 0
  if scoped { machine.scope = own }
  if throwing {
    // A handler of the frame's own takes the exception: the code goes on there.
    let noted = run Effect.result(unsafe debugger.boundary(&mut hooks, memory, &machine, machine.pc(), true))
    let stands = match move noted { Result<(), JsException>.Success { .. } => true Result<(), JsException>.Failure { .. } => false }
    if stands && run unsafe unwind(&mut hooks, memory, &mut machine) { unsafe baselineKeepScope(record, &machine) return baseline.moved(machine.pc(), machine.sp()) }
    unsafe activation.release(&mut hooks, &description, &machine)
    if scoped { unsafe baselineScopeEnd(&mut hooks, rt, machine.scope) }
    return 1
  }
  let result = run Effect.result(unsafe dispatch(&mut hooks, memory, &mut machine, false))
  unsafe activation.release(&mut hooks, &description, &machine)
  if scoped { unsafe baselineScopeEnd(&mut hooks, rt, machine.scope) }
  match move result {
    Result<ValueBits, JsException>.Success { value } => {
      let mut resultAnchor = ()
      let after = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut resultAnchor, record)
      after.result = value
      return 0
    }
    Result<ValueBits, JsException>.Failure { .. } => { return 1 }
  }
}
/// SERVICE_STEP: the interpreter runs the one instruction at the frame's bytecode offset on
/// the cells of record, a built baseline frame with sp operands on its stack. 0 when the
/// frame is then at next, the offset of the instruction after it, with after operands, as
/// the code expects: the code goes on there.
/// js_baseline.moved when the frame is at another instruction (a branch, instructions the
/// interpreter runs as one, a handler that took what the instruction threw): the code goes on
/// there if it has code for it. Otherwise the interpreter ran the activation to its end, as
/// baselineFinish does (the instruction returned, or threw with no handler in the frame): 1
/// with the result in the record, or 2 when it threw.
unsafe effect fn baselineStep<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, record: *mut baseline.BaselineFrame, next: usize, after: usize, sp: usize) -> u64 ? &mut Allocator {
  let mut anchor = ()
  let running = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut anchor, record)
  let framePointer = Pointer.fromMutRef<StackFrame>(&mut running.frame)
  let argv = FrameSlots { data: running.argv, count: running.argc }
  let pc = running.frame.currentPc if pc == NO_PC { invariant() }
  let receiver = running.frame.thisValue
  let newTarget = running.frame.newTarget
  let own = running.scope
  drop running
  let empty = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(0))
  let emptyRefs = unsafe Intrinsic.pointerRequalify<[*]mut ?*mut HeapHeader, *mut ?*mut HeapHeader>(unsafe Intrinsic.stackAllocate<?*mut HeapHeader>(0))
  let description = unsafe baselineDescribe(record, empty, emptyRefs)
  let rt = unsafe runtime.contextRuntime(description.realm)
  let mut machine = unsafe activation.machine(&description, rt, description.realm, framePointer, &argv, receiver, newTarget, empty, pc, sp)
  let scoped = unsafe activation.scopeSlotsOf(&description) != 0
  if scoped { machine.scope = own }
  let mut handoff = false
  let mut result: Result<ValueBits, JsException> = Result<ValueBits, JsException>.Success { value: ValueBits.Undefined }
  let executed = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(
    unsafe executeSingle(&mut hooks, memory, &mut machine, &mut handoff), failed)
  match move executed {
    ValueBits value => {
      if handoff {
        // The frame itself at the next instruction: an inline callee's frame above it is a
        // run the plain loop handed to the observed one.
        if Pointer.address<Machine>(unsafe activation.innermost(&mut machine)) == Pointer.address<Machine>(Pointer.fromMutRef<Machine>(&mut machine)) {
          unsafe baselineKeepScope(record, &machine)
          if machine.pc() == next && machine.sp() == after { return 0 }
          // An instruction the interpreter ran together with those after it, or a branch.
          return baseline.moved(machine.pc(), machine.sp())
        }
        result = run Effect.result(unsafe dispatch(&mut hooks, memory, &mut machine, false))
      } else { result = Result<ValueBits, JsException>.Success { value: value } }
    }
    Failed { error } => {
      if !unsafe restricted.rejected(machine.runtime) {
        let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
        run unsafe exceptionBoundary(&mut hooks, memory, &mut machine)
      } else { drop error }
      // A handler of the frame's own: the code goes on there.
      if run unsafe unwindFrames(&mut hooks, memory, &mut machine) { unsafe baselineKeepScope(record, &machine) return baseline.moved(machine.pc(), machine.sp()) }
      result = Result<ValueBits, JsException>.Failure { error: JsException {} }
    }
  }
  unsafe activation.release(&mut hooks, &description, &machine)
  if scoped { unsafe baselineScopeEnd(&mut hooks, rt, machine.scope) }
  match move result {
    Result<ValueBits, JsException>.Success { value } => {
      let mut resultAnchor = ()
      let after = unsafe Pointer.borrowMut<(), baseline.BaselineFrame>(&mut resultAnchor, record)
      after.result = value
      return 1
    }
    Result<ValueBits, JsException>.Failure { .. } => { return 2 }
  }
}
/// Runs the compiled code linked as index (FunctionBytecode.compiled, nonzero) for machine, a
/// freshly entered base frame that has not executed anything, making the calls it asks for
/// (compiled.EXIT_CALL). compiled.ENTER_RETURNED with the result in value; ENTER_INTERPRET
/// when it left at a bytecode boundary, after which machine holds the interpreter state there
/// (or is untouched when compiled code is skipped) and execute continues; ENTER_THREW when a
/// call it made threw, with machine holding the state at that call.
@inlineNever
unsafe effect fn enterBase<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, index: u32, value: &mut ValueBits) -> u32 ? &mut Allocator {
  let anchor = ()
  // The debugger, coverage and profiler see every instruction: interpret.
  if (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)).observeInstructions { return compiled.ENTER_INTERPRET }
  let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, machine.bytecode)
  let words = compiled.stateWords(u16.toUsize(bytecode.variableCount) + compiled.argumentRoom(bytecode.argumentCount, bytecode.borrowsArguments), u16.toUsize(bytecode.stackSize))
  let parameters = u16.toUsize(bytecode.argumentCount)
  drop bytecode
  let state = unsafe Intrinsic.pointerRequalify<[*]mut u64, *mut u64>(unsafe Intrinsic.stackAllocate<u64>(words))
  let callWords = unsafe compiled.callWords(machine.runtime, index)
  // Linked for on-stack replacement only (js_runtime.linkOsr): interpret.
  if callWords == u32.toUsize(OSR_ONLY_CALL_WORDS) { return compiled.ENTER_INTERPRET }
  let mut room: usize = 1
  if callWords > room { room = callWords }
  let block = unsafe Intrinsic.pointerRequalify<[*]mut u64, *mut u64>(unsafe Intrinsic.stackAllocate<u64>(room))
  let mut frame = CompiledFrame.of(&machine)
  if callWords != 0 {
    unsafe Pointer.write<u64>(block, 0)
    unsafe Pointer.write<u64>(unsafe Pointer.atMut<u64>(unsafe Pointer.assumeManyMut<u64>(block), compiled.CALL_CALLEE_EXIT), 0)
    frame.calls = unsafe Intrinsic.pointerRequalify<*mut u64, ?*mut u64>(block)
  }
  let mut exit = unsafe compiled.runCode(index, &frame, machine.arguments, parameters, state)
  while exit == compiled.EXIT_CALL {
    let how = run unsafe compiledCall(&mut hooks, memory, &mut machine, block)
    unsafe Pointer.write<u64>(block, unsafe Pointer.read<u64>(block) | how)
    exit = unsafe compiled.runCode(index, &frame, machine.arguments, parameters, state)
  }
  if exit == compiled.EXIT_RETURNED {
    value.* = unsafe compiled.result(state)
    return compiled.ENTER_RETURNED
  }
  unsafe compiled.restore(&mut machine, index, exit, state)
  if exit == compiled.EXIT_THROW { return compiled.ENTER_THREW }
  return compiled.ENTER_INTERPRET
}
/// A call on borrowed argument cells (compiledCall, callLinked, activationCall): a linked
/// callee that makes no calls runs its code at once, without a frame (as callCompiled does for
/// the interpreter), and one that makes calls runs on the activation stack (runActivations);
/// anything else goes through callForCompiled. context is the caller's realm.
@inlineAlways
unsafe effect fn callFromCompiled<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, runtime: *mut HeapHeader, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  if function.isObject() && unsafe classId(function) == classes.JS_CLASS_BYTECODE_FUNCTION {
    let callee = unsafe activation.calleeOf(function)
    let index = unsafe compiledIndex(callee.bytecode)
    let anchor = ()
    let observed = (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).observeInstructions
    if index != 0 && !observed {
      if unsafe compiled.callWords(runtime, index) != 0 {
        let root = unsafe pushClosure(runtime, unsafe compiled.entryAt(runtime, index), function, callee.bytecode, index, receiver, argv, activation.COPY_ARGUMENTS, Pointer.null<Activation>())
        if !Pointer.isNull<Activation>(root) {
          return run unsafe runActivations(&mut hooks, memory, Pointer.null<Machine>(), context, unsafe Intrinsic.pointerRequalify<?*mut Activation, *mut Activation>(root))
        }
      } else {
        let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, callee.bytecode)
        let words = compiled.stateWords(u16.toUsize(code.variableCount) + compiled.argumentRoom(code.argumentCount, code.borrowsArguments), u16.toUsize(code.stackSize))
        let realm = code.realm
        let start = unsafe code.code.start()
        drop code
        let state = unsafe Intrinsic.pointerRequalify<[*]mut u64, *mut u64>(unsafe Intrinsic.stackAllocate<u64>(words))
        // A closure's captures come from its object; the caller pointer is only a non-null filler.
        let filler = unsafe Intrinsic.pointerReinterpret<*const ValueBits, *const Machine>(Pointer.fromRef<ValueBits>(&receiver))
        let captures = unsafe activation.capturesOf(function, callee.bytecode, filler, false)
        let frame = compiled.CompiledFrame { thisValue: Pointer.fromRef<ValueBits>(&receiver), bytecode: callee.bytecode, context: realm,
          runtime: runtime, closureReferences: captures.references, scope: captures.scope, calls: Pointer.null<u64>(), code: start, activation: Pointer.null<u8>() }
        let exit = unsafe compiled.runCode(index, &frame, argv.data, argv.count, state)
        if exit == compiled.EXIT_RETURNED { return unsafe compiled.result(state) }
        let resume = compiled.Resume { state: state, exit: exit, index: index }
        return run unsafe callResuming(&mut hooks, memory, context, function, receiver, ValueBits.Undefined, &argv, activation.COPY_ARGUMENTS, resume)
      }
    }
  }
  return run unsafe callForCompiled(&mut hooks, memory, context, function, receiver, &argv)
}
/// The call compiled code running for machine left to make (the call block at block): how it
/// went, as compiled.CALL_RETURNED (the owned result in the block), CALL_THREW (the exception
/// pending) or CALL_DEOPT (nothing called).
@inlineNever
unsafe effect fn compiledCall<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, block: *mut u64) -> u64 ? &mut Allocator {
  let words = unsafe Pointer.assumeManyMut<u64>(block)
  let site = unsafe Pointer.read<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_SITE))
  let pc = u64.toUsize(site & 0xffffffff)
  let count = compiled.siteCount(site)
  let kind = compiled.siteKind(site)
  if kind == compiled.SITE_PUT_FIELD || kind == compiled.SITE_EQUAL {
    unsafe machine.setPc(pc + 1)
    unsafe machine.publishPc()
    return run unsafe compiledStep(&mut hooks, machine.runtime, machine.context, machine.bytecode, block, pc)
  }
  let area = unsafe Pointer.assumeManyMut<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_AREA)))
  if (site & compiled.SITE_GENERIC) != 0 {
    let mut scratch = machine.*
    return run unsafe compiledOp(&mut hooks, memory, &mut scratch, block)
  }
  let function = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 0))
  match Pointer.nonNullMut<Activation>(unsafe pushedCallee(block)) {
    Option<*mut Activation>.Some { value: root } => {
      let size = u8.toUsize(op.opcodeInfo(unsafe machine.byteAt(pc), true).size)
      unsafe machine.setPc(pc + size)
      unsafe machine.publishPc()
      let ran = run Intrinsic.catchFailure<JsException>(unsafe runActivations(&mut hooks, memory, Pointer.null<Machine>(), machine.context, root), failedJs)
      match move ran {
        ValueBits result => {
          unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_RESULT)), result)
          return compiled.CALL_RETURNED
        }
        FailedJs { .. } => { return compiled.CALL_THREW }
      }
    }
    Option<*mut Activation>.None => ()
  }
  // A known local function's value needs the caller's frame: the interpreter makes that call.
  if let ValueBits.FunctionBytecode { .. } = function { return compiled.CALL_DEOPT }
  if (site & compiled.SITE_LAZY_ARGUMENTS) != 0 {
    if !unsafe lazyApplies(machine.runtime, area, site) { return compiled.CALL_DEOPT }
    let own = unsafe Pointer.read<FrameSlots>(unsafe activation.originalArgumentsOf(&machine))
    let size = u8.toUsize(op.opcodeInfo(unsafe machine.byteAt(pc), true).size)
    unsafe machine.setPc(pc + size)
    unsafe machine.publishPc()
    let applied = run Intrinsic.catchFailure<JsException>(unsafe callFromCompiled(&mut hooks, memory, machine.runtime, machine.context,
      unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 1)), unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 2)), own), failedJs)
    return unsafe answerCall(words, move applied)
  }
  // So does a bytecode callee the JIT refused for good (leavesForCallee): the interpreter's
  // inline call costs less than a base frame, and enough of these deopts unlink a caller whose
  // calls stay interpreted. One not yet hot, or waiting to compile, is called here.
  if function.isObject() && unsafe classId(function) == classes.JS_CLASS_BYTECODE_FUNCTION
    && unsafe Pointer.read<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_CALLEE_EXIT)) == 0
    && unsafe leavesForCallee(machine.runtime, (unsafe activation.calleeOf(function)).bytecode, site) {
    return compiled.CALL_DEOPT
  }
  let receiver = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 1))
  let argv = FrameSlots { data: unsafe Pointer.atMut<ValueBits>(area, 2), count: count }
  // Backtraces name the call as the interpreter's would: the offset just past it.
  let size = u8.toUsize(op.opcodeInfo(unsafe machine.byteAt(pc), true).size)
  unsafe machine.setPc(pc + size)
  unsafe machine.publishPc()
  let calleeExit = unsafe Pointer.read<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_CALLEE_EXIT))
  if calleeExit != 0 {
    // The code ran a compiled callee directly and it left: finish it interpreted.
    unsafe Pointer.write<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_CALLEE_EXIT), 0)
    let resume = compiled.Resume { state: unsafe Pointer.atMut<u64>(words, compiled.CALL_STATE), exit: u64.wrappingToU32(calleeExit),
      index: u64.wrappingToU32(u64.shiftRight(calleeExit, 32)) }
    let resumed = run Intrinsic.catchFailure<JsException>(unsafe callResuming(&mut hooks, memory, machine.context, function, receiver,
      ValueBits.Undefined, &argv, activation.COPY_ARGUMENTS, resume), failedJs)
    match move resumed {
      ValueBits result => {
        unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_RESULT)), result)
        return compiled.CALL_RETURNED
      }
      FailedJs { .. } => { return compiled.CALL_THREW }
    }
  }
  if (site & compiled.SITE_CONSTRUCT) != 0 {
    let constructed = run Intrinsic.catchFailure<JsException>(unsafe constructInternal(&mut hooks, memory, machine.context, function, receiver, &argv,
      activation.COPY_ARGUMENTS), failedJs)
    return unsafe answerCall(words, move constructed)
  }
  let called = run Intrinsic.catchFailure<JsException>(unsafe callFromCompiled(&mut hooks, memory, machine.runtime, machine.context, function, receiver, argv), failedJs)
  match move called {
    ValueBits result => {
      unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_RESULT)), result)
      return compiled.CALL_RETURNED
    }
    FailedJs { .. } => { return compiled.CALL_THREW }
  }
}
/// The instruction compiled code left to run generically at a site it widened (the call
/// block at block, compiled.SITE_PUT_FIELD or SITE_EQUAL): the put_field (or eq or neq) at
/// pc of bytecode on the area's two values, both borrowed. compiled.CALL_RETURNED (Undefined,
/// or the Bool, in the block) or CALL_THREW with the exception pending.
@inlineNever
unsafe effect fn compiledStep<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks>(hooks: &mut H,
  runtime: *mut HeapHeader, context: *mut HeapHeader, bytecode: *mut HeapHeader, block: *mut u64, pc: usize) -> u64 ? &mut Allocator {
  let words = unsafe Pointer.assumeManyMut<u64>(block)
  let area = unsafe Pointer.assumeManyMut<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_AREA)))
  let object = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 0))
  let value = unsafe (unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 1))).retained()
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let opcode = unsafe Pointer.read<u8>(unsafe code.code.pointerAt(pc))
  if opcode == op.OP_eq || opcode == op.OP_neq {
    drop code
    let left = unsafe object.retained()
    let compared = run Intrinsic.catchFailure<JsException>(unsafe properties.equalGeneric(&mut hooks, context, left, value, opcode == op.OP_neq), failedJs)
    match move compared {
      ValueBits answer => {
        unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_RESULT)), answer)
        return compiled.CALL_RETURNED
      }
      FailedJs { .. } => { return compiled.CALL_THREW }
    }
  }
  let atom = unsafe properties.fieldAtomAt(unsafe code.code.pointerAt(pc + 1))
  drop code
  let stored = run Intrinsic.catchFailure<JsException>(unsafe properties.putFieldGeneric(&mut hooks, runtime, context, object, atom, value), failedJs)
  match move stored {
    FailedJs { .. } => { return compiled.CALL_THREW }
    _ => ()
  }
  unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_RESULT)), ValueBits.Undefined)
  return compiled.CALL_RETURNED
}
/// Whether compiled code calling bytecode at site leaves for the interpreter (CALL_DEOPT):
/// js_hotness reported bytecode and refused it for good (count parked at REPORTED_FLOOR or
/// above and not pending, or loop code only), so its calls stay interpreted, where the inline
/// call costs less than a base frame. A callee that waits to compile (pending, or a recompile
/// put off by jit_recompile.backoff) is called: compiled-entry.md 7.9.
unsafe fn leavesForCallee(runtime: *mut HeapHeader, bytecode: *mut HeapHeader, site: u64) -> bool {
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let mut refused = false
  if code.compiled != 0 {
    let index = code.compiled
    drop code
    refused = unsafe compiled.callWords(runtime, index) == u32.toUsize(OSR_ONLY_CALL_WORDS)
  } else {
    let left = code.hotness
    drop code
    let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
    let pending = match state.hotPending { ValueBits.FunctionBytecode { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(bytecode) _ => false }
    refused = left >= hotness.REPORTED_FLOOR && !pending
  }
  // The policy for refused callees: CALL_ALWAYS_REFUSED makes SITE_CALL_ALWAYS sites call them.
  return refused && !(CALL_ALWAYS_REFUSED && (site & compiled.SITE_CALL_ALWAYS) != 0)
}
/// Whether a call site that deoptimized before (SITE_CALL_ALWAYS) calls a callee refused for
/// good. Off while a call from compiled code into the interpreter costs more than the
/// interpreter's inline call (raytrace, earley-boyer: compiled-entry.md 7.9).
const CALL_ALWAYS_REFUSED: bool = false
/// Whether the engine runs a compiled.SITE_LAZY_ARGUMENTS call (area: the intrinsic apply,
/// its target, thisArg, the stand-in) as target(thisArg, ...the frame's own arguments): the
/// interpreter's OP_call_method runs the same calls inline. Otherwise compiled code leaves
/// (CALL_DEOPT) and the interpreter builds the arguments object.
unsafe fn lazyApplies(runtime: *mut HeapHeader, area: [*]mut ValueBits, site: u64) -> bool {
  let method = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 0))
  let target = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 1))
  if !unsafe invoke.isApply(method) || !target.isObject() || unsafe classId(target) != classes.JS_CLASS_BYTECODE_FUNCTION { return false }
  return !unsafe leavesForCallee(runtime, (unsafe activation.calleeOf(target)).bytecode, site)
}
/// The direct call compiled code makes through the CALL_FAST helper, from the call block at
/// block (site and area as for EXIT_CALL): a linked bytecode closure whose code makes no calls
/// runs at once on the area's cells, while instructions are not observed. Returns a
/// compiled.FAST_* status. Needs no hooks: only machine code runs.
pub unsafe fn fastCall(frame: &compiled.CompiledFrame, block: *mut u64) -> u32 {
  let words = unsafe Pointer.assumeManyMut<u64>(block)
  let area = unsafe Pointer.assumeManyMut<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_AREA)))
  let function = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 0))
  if !function.isObject() || unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION { return compiled.FAST_GENERIC }
  let callee = unsafe activation.calleeOf(function)
  let index = unsafe compiledIndex(callee.bytecode)
  if index == 0 { return compiled.FAST_GENERIC }
  let runtime = frame.runtime
  let anchor = ()
  if (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).observeInstructions { return compiled.FAST_GENERIC }
  let slot = unsafe compiled.entryAt(runtime, index)
  if (unsafe Pointer.borrow<(), CompiledEntry>(&anchor, slot)).callWords != 0 {
    // A callee that makes calls gets an activation; the runner of the caller's runs it
    // (runActivations, compiledCall) once the caller leaves to make the call.
    let site = unsafe Pointer.read<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_SITE))
    let argv = FrameSlots { data: unsafe Pointer.atMut<ValueBits>(area, 2), count: compiled.siteCount(site) }
    let mut parent = Pointer.null<Activation>()
    if let Option<*mut u8>.Some { value } = Pointer.nonNullMut<u8>(frame.activation) {
      parent = unsafe Intrinsic.pointerRequalify<*mut Activation, ?*mut Activation>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Activation>(value))
    }
    let pushed = unsafe pushClosure(runtime, slot, function, callee.bytecode, index, unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 1)),
      argv, activation.COPY_ARGUMENTS, parent)
    let child = match Pointer.nonNullMut<Activation>(pushed) { Option<*mut Activation>.Some { value } => value _ => { return compiled.FAST_GENERIC } }
    let mut readyAnchor = () let ready = unsafe Pointer.borrowMut<(), CompiledEntry>(&mut readyAnchor, slot)
    if ready.directArity == compiled.DIRECT_NOT_READY {
      // Machine code may push its activation and call it directly from now on (DIRECT_ACT_*).
      let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, callee.bytecode)
      ready.directRealm = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(code.realm)
      ready.directCode = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe code.code.start())
      ready.directArity = u16.toU32(code.argumentCount)
      drop code
    }
    drop ready
    let mut tableAnchor = () let table = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut tableAnchor, runtime)
    let depth = table.compiled.nativeDepth
    if depth < NATIVE_NESTING {
      // Run it here, nested: it returns to the caller's code without either leaving.
      table.compiled.nativeDepth = depth + 1
      drop table
      let exit = unsafe runActivation(child)
      let mut afterAnchor = () let after = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut afterAnchor, runtime)
      after.compiled.nativeDepth = depth
      drop after
      let mut childAnchor = () let ran = unsafe Pointer.borrowMut<(), Activation>(&mut childAnchor, child)
      if exit == compiled.EXIT_RETURNED {
        unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_RESULT)), unsafe compiled.result(ran.state))
        unsafe popActivation(runtime, &ran)
        return compiled.FAST_RETURNED
      }
      // It left to call through the engine, or at a deopt: the runner continues it.
      ran.exit = exit
    } else { drop table }
    unsafe Pointer.write<?*mut Activation>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ?*mut Activation>(unsafe Pointer.atMut<u64>(words, compiled.CALL_STATE)), pushed)
    unsafe Pointer.write<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_CALLEE_EXIT), compiled.CALLEE_PUSHED)
    return compiled.FAST_EXITED
  }
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, callee.bytecode)
  let parameters = u16.toUsize(code.argumentCount)
  let realm = code.realm
  let start = unsafe code.code.start()
  let site = unsafe Pointer.read<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_SITE))
  let count = compiled.siteCount(site)
  // A leaf's entry keeps its exit state size (activationWords) and its realm's interrupt
  // counter after the first direct call.
  let mut entryAnchor = () let entry = unsafe Pointer.borrowMut<(), CompiledEntry>(&mut entryAnchor, slot)
  if entry.activationWords == 0 {
    entry.activationWords = usize.toU32(compiled.stateWords(u16.toUsize(code.variableCount) + compiled.argumentRoom(code.argumentCount, code.borrowsArguments), u16.toUsize(code.stackSize)))
    let mut contextAnchor = () let context = unsafe HeapCell.payloadMut<ContextState, ()>(&mut contextAnchor, realm)
    entry.counter = Pointer.fromMutRef<i32>(&mut context.interruptCounter)
    if u32.toUsize(entry.activationWords) <= compiled.CALL_STATE_WORDS {
      // Machine code may call it directly from now on (DIRECT_*).
      entry.directRealm = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(realm)
      entry.directCode = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(start)
      entry.directArity = usize.toU32(parameters)
    }
  }
  drop code
  if u32.toUsize(entry.activationWords) > compiled.CALL_STATE_WORDS { return compiled.FAST_GENERIC }
  // A closure's captures come from its object; the caller pointer is only a non-null filler.
  let filler = unsafe Intrinsic.pointerReinterpret<*const compiled.CompiledFrame, *const Machine>(Pointer.fromRef<compiled.CompiledFrame>(&frame))
  let captures = unsafe activation.closureCaptures(function, unsafe Intrinsic.pointerReinterpret<*const Machine, *const ?*mut HeapHeader>(filler))
  let receiver = unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 1))
  let calleeFrame = compiled.CompiledFrame { thisValue: receiver, bytecode: callee.bytecode, context: realm, runtime: runtime,
    closureReferences: captures.references, scope: captures.scope, calls: Pointer.null<u64>(), code: start, activation: Pointer.null<u8>() }
  let state = unsafe Pointer.atMut<u64>(words, compiled.CALL_STATE)
  let cells = unsafe Pointer.atMut<ValueBits>(area, 2)
  let mut exit: u32 = 0
  if count >= parameters {
    entry.runs = entry.runs + 1
    let codeAddress = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(entry.code)
    let machineCode = unsafe Pointer.read<compiled.CompiledCode>(unsafe Intrinsic.pointerReinterpret<*const *const u8, *const compiled.CompiledCode>(Pointer.fromRef<*const u8>(&codeAddress)))
    let counter = unsafe Intrinsic.pointerRequalify<?*mut i32, *mut i32>(entry.counter)
    let data = entry.data
    let env = entry.env
    drop entry
    exit = unsafe machineCode(unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(cells), state, counter, data, env, Pointer.fromRef<compiled.CompiledFrame>(&calleeFrame))
    if exit > compiled.EXIT_CALL { return Intrinsic.trap("compiled code left with an unknown exit") }
  } else {
    drop entry
    exit = unsafe compiled.runCode(index, &calleeFrame, cells, count, state)
  }
  if exit == compiled.EXIT_RETURNED {
    unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_RESULT)), unsafe compiled.result(state))
    return compiled.FAST_RETURNED
  }
  unsafe Pointer.write<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_CALLEE_EXIT), u64.bitOr(u32.toU64(exit), u64.shiftLeft(u32.toU64(index), 32)))
  return compiled.FAST_EXITED
}
/// The generic instruction exit compiled code left to make (the call block at block, its site
/// SITE_GENERIC), run on machine, a scratch copy of the running frame's: the instruction at
/// the site's pc runs as the interpreter runs it, with its operands (retained here, so the
/// code keeps its own) as the operand stack. CALL_RETURNED with its result at CALL_AREA + 2,
/// or CALL_THREW with what it left on the stack released and the exception pending.
@inlineNever
unsafe effect fn compiledOp<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, block: *mut u64) -> u64 ? &mut Allocator {
  let words = unsafe Pointer.assumeManyMut<u64>(block)
  let site = unsafe Pointer.read<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_SITE))
  let pc = u64.toUsize(site & 0xffffffff)
  let count = compiled.siteCount(site)
  let cells = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_AREA))), 2)
  let stack = unsafe Pointer.assumeManyMut<ValueBits>(cells)
  let mut i: usize = 0
  while i < count {
    let bits = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(stack, i))
    unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(stack, i), unsafe bits.retained())
    i = i + 1
  }
  machine.stack = cells
  machine.stackTop = unsafe Pointer.atMut<ValueBits>(stack, count)
  let opcode = unsafe machine.byteAt(pc)
  let info = op.opcodeInfo(opcode, true)
  let mut size = u8.toUsize(info.size)
  if (opcode == op.OP_get_length || opcode == op.OP_get_array_el) && (unsafe Pointer.read<ValueBits>(cells)).tag() == 4 {
    // A lazy arguments object's stand-in (ssa_translate lazyUse): answered from the frame's
    // own arguments, or the interpreter builds the object (the copy has no locals to keep it).
    if unsafe factories.lazyArgumentsAnswer(&mut machine, opcode) { return compiled.CALL_RETURNED }
    while machine.sp() != 0 { let left = unsafe machine.pop() unsafe locals.releaseIn(&mut hooks, &machine, left) }
    return compiled.CALL_DEOPT
  }
  // fclosure runs a set_name right after it as part of the creation (factories.allocate).
  if (opcode == op.OP_fclosure || opcode == op.OP_fclosure8) && unsafe machine.byteAt(pc + size) == op.OP_set_name { size = size + 5 }
  let scope = machine.scope
  unsafe machine.setPc(pc + 1)
  // Backtraces name the instruction as the interpreter's would.
  unsafe machine.publishPc()
  let ran = run Intrinsic.catchFailure<OutOfMemoryError | StringLengthError | BigIntError | JsException>(unsafe genericStep(&mut hooks, memory, &mut machine, opcode), failed)
  match move ran {
    bool _ => {
      if machine.pc() != pc + size { return Intrinsic.trap("a generic instruction moved control") }
      // CompiledFrame.scope is the code's for the whole run (ssa_translate.frameAllowed).
      if Pointer.address<HeapHeader>(machine.scope) != Pointer.address<HeapHeader>(scope) { return Intrinsic.trap("a generic instruction moved the scope") }
      // Several values (calls.RESULTS_SHIFT): the kept cells are the code's operands as they
      // were, so their copies go; the others stay in the area, owned, for call.result.
      let results = compiled.siteResults(site)
      if results != 0 {
        if machine.sp() != results { return Intrinsic.trap("a generic instruction left another stack") }
        let keptCells = compiled.siteKept(site)
        let mut c: usize = 0
        while c < results {
          if (u64.shiftRight(keptCells, usize.toU64(c)) & 1) != 0 {
            let left = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(stack, c)) unsafe locals.releaseIn(&mut hooks, &machine, left)
            unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(stack, c), ValueBits.Undefined)
          }
          c = c + 1
        }
        return compiled.CALL_RETURNED
      }
      if machine.sp() == 0 { unsafe Pointer.write<ValueBits>(cells, ValueBits.Undefined) }
      return compiled.CALL_RETURNED
    }
    Failed { error } => {
      if !unsafe restricted.rejected(machine.runtime) {
        let _pending = run Effect.catch<JsException>(core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error), core.exceptionValue)
      } else { drop error }
      while machine.sp() != 0 { let left = unsafe machine.pop() unsafe locals.releaseIn(&mut hooks, &machine, left) }
      return compiled.CALL_THREW
    }
  }
}
/// The opcodes a generic instruction exit runs (ssa_translate.genericOpcode), each through the
/// interpreter's general implementation: never a fused or quick path, which may read the
/// instructions after it.
unsafe effect fn genericStep<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if opcode == op.OP_typeof { run unsafe operators.typeofValue(&mut hooks, &mut machine) return true }
  if opcode == op.OP_delete { drop run unsafe properties.deleteOperation(&mut hooks, memory, &mut machine) return true }
  if opcode == op.OP_pow || opcode == op.OP_to_object || opcode == op.OP_to_propkey { drop run unsafe operators.step(&mut hooks, memory, &mut machine, opcode) return true }
  if opcode == op.OP_object || opcode == op.OP_regexp { drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) return true }
  if opcode == op.OP_array_from { drop run unsafe factories.arrayFrom(&mut hooks, memory, &mut machine) return true }
  if opcode == op.OP_push_bigint_i32 || opcode == op.OP_push_const || opcode == op.OP_push_const8 { drop run unsafe values.step(&mut hooks, &mut machine, opcode) return true }
  // Stream P's frame instructions (ssa_translate.frameGeneric).
  if opcode == op.OP_special_object || opcode == op.OP_rest || opcode == op.OP_fclosure || opcode == op.OP_fclosure8 {
    drop run unsafe factories.step(&mut hooks, memory, &mut machine, opcode) return true
  }
  if opcode == op.OP_get_scope0_el {
    // The fused get_scope0_check slot; get_array_el, through each one's general path.
    drop run unsafe locals.step(&mut hooks, &mut machine, op.OP_get_scope0_check)
    drop run unsafe properties.step(&mut hooks, memory, &mut machine, op.OP_get_array_el)
    return true
  }
  if opcode == op.OP_check_ctor || opcode == op.OP_check_ctor_return || opcode == op.OP_init_ctor || opcode == op.OP_apply || opcode == op.OP_append {
    drop run unsafe instruction(&mut hooks, memory, &mut machine, opcode) return true
  }
  // Stream Q's iteration instructions (ssa_translate.iterationOpcode), as the interpreter's
  // dispatch runs them; for_in_next without its quick path.
  if opcode == op.OP_for_of_start { drop run unsafe controlInstructions.forOfStart(&mut hooks, memory, &mut machine, false) return true }
  if opcode == op.OP_for_of_next { drop run unsafe controlInstructions.forOfNext(&mut hooks, &mut machine) return true }
  if opcode == op.OP_iterator_close { drop run unsafe controlInstructions.iteratorClose(&mut hooks, memory, &mut machine) return true }
  if opcode == op.OP_for_in_start || opcode == op.OP_for_in_next { drop run unsafe controlInstructions.step(&mut hooks, memory, &mut machine, opcode) return true }
  drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode)
  return true
}
/// A Machine for the instruction an activation's code left to run (compiledOp): its frame's
/// function, receiver, arguments and published stack frame, no locals.
unsafe fn activationMachine(entry: *mut Activation) -> Machine {
  let mut anchor = () let running = unsafe Pointer.borrowMut<(), Activation>(&mut anchor, entry)
  let codeAnchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&codeAnchor, running.frame.bytecode)
  let empty = unsafe Intrinsic.pointerReinterpret<*mut Activation, *mut ValueBits>(entry)
  let mut constants = unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(empty)
  if code.constants.length() != 0 { constants = Pointer.fromRef<ValueBits>(&code.constants.asSlice()[0]) }
  drop code
  let cells = unsafe Intrinsic.pointerRequalify<*const ValueBits, *mut ValueBits>(running.cells)
  return Machine { context: running.frame.context, callerContext: running.frame.context, runtime: running.frame.runtime,
    bytecode: running.frame.bytecode, frame: running.stackFrame, code: running.frame.code, constants: constants,
    closureReferences: running.frame.closureReferences, originalArguments: Pointer.fromRef<FrameSlots>(&running.argv),
    arguments: cells, locals: empty, stack: empty, thisValue: running.receiver, newTarget: ValueBits.Undefined,
    argumentCount: running.argv.count, ip: running.frame.code, stackTop: empty, record: Pointer.null<u8>(), scope: running.frame.scope }
}
/// Writes how a call through the engine went to the call block at words: CALL_RETURNED with
/// the owned result, or CALL_THREW.
unsafe fn answerCall(words: [*]mut u64, called: ValueBits | FailedJs) -> u64 {
  match move called {
    ValueBits result => {
      unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_RESULT)), result)
      return compiled.CALL_RETURNED
    }
    FailedJs { .. } => { return compiled.CALL_THREW }
  }
}
// ---- compiled code that makes calls, on the activation stack (docs/jit/compiled-entry.md 7.6) ----

/// A run of compiled code that makes calls, on the runtime's activation stack
/// (CompiledTable.activations), followed there by room for its stack frame, its padded
/// arguments, call block and exit state. Its stack frame is published only once something
/// can see it: a call it makes through the engine, or the interpreter frame a deopt builds
/// (publishActivations). The frame has no locals or operand stack of its own: the code keeps
/// its values in the call block, counted.
struct Activation {
  frame: CompiledFrame,
  prepared: compiled.Prepared,
  /// The argument cells the code reads: argv, or a copy padded with undefined.
  cells: *const ValueBits,
  state: *mut u64,
  stackFrame: *mut StackFrame,
  /// The offset past the start of the call being made (backtraces read currentPc - 1).
  pc: usize,
  published: bool,
  mode: u8,
  function: ValueBits,
  receiver: ValueBits,
  argv: FrameSlots,
  /// The activation whose call this is, or null for the one runActivations started with.
  parent: ?*mut Activation,
  /// CompiledTable.activationTop before this activation.
  mark: usize,
  index: u32,
  /// callResuming's flags for a deopt: activation.COPY_ARGUMENTS when argv is borrowed.
  flags: u32,
  /// How its code last left (compiled.EXIT_*), or EXIT_FRESH before it runs.
  exit: u32,
  known: bool
}
/// Activations fastCall runs nested on the native stack before it leaves the rest to the
/// runner (each level costs the helper's, fastCall's and the code's native frames).
const NATIVE_NESTING: u32 = compiled.DIRECT_NESTING
/// Pushes an activation of function (its bytecode linked as index, whose table entry is at
/// slot, to code that makes calls), with captures, on borrowed cells argv. Null, with nothing
/// changed, when the stack has no room (the call then takes callInternal's native frame,
/// which checks for stack overflow).
@inlineAlways
unsafe fn pushActivation(runtime: *mut HeapHeader, slot: *mut CompiledEntry, function: ValueBits, bytecode: *mut HeapHeader, index: u32,
  receiver: ValueBits, argv: FrameSlots, captures: activation.KnownContext, flags: u32, parent: ?*mut Activation, known: bool) -> ?*mut Activation {
  let mut anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let parameters = u16.toUsize(code.argumentCount)
  let realm = code.realm
  let mode = code.mode
  let start = unsafe code.code.start()
  let header = (Layout.of<Activation>().bytes + 7) / 8 + (Layout.of<StackFrame>().bytes + 7) / 8
  let mut entryAnchor = () let entry = unsafe Pointer.borrowMut<(), CompiledEntry>(&mut entryAnchor, slot)
  // OSR-only code has no normal entry: every call interprets it.
  if entry.callWords == OSR_ONLY_CALL_WORDS { return Pointer.null<Activation>() }
  if entry.activationWords == 0 {
    entry.activationWords = usize.toU32(header + u32.toUsize(entry.callWords) + compiled.stateWords(u16.toUsize(code.variableCount) + compiled.argumentRoom(code.argumentCount, code.borrowsArguments), u16.toUsize(code.stackSize)))
    let mut contextAnchor = () let context = unsafe HeapCell.payloadMut<ContextState, ()>(&mut contextAnchor, realm)
    entry.counter = Pointer.fromMutRef<i32>(&mut context.interruptCounter)
  }
  drop code
  let callWords = u32.toUsize(entry.callWords)
  let mut words = u32.toUsize(entry.activationWords)
  let mut padding: usize = 0
  if argv.count < parameters { padding = parameters * 2 words = words + padding }
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  let top = state.compiled.activationTop
  if words > state.compiled.activationWords - top { return Pointer.null<Activation>() }
  let base = unsafe Pointer.assumeManyMut<u64>(unsafe Intrinsic.pointerRequalify<?*mut u64, *mut u64>(state.compiled.activations))
  state.compiled.activationTop = top + words
  drop state
  entry.runs = entry.runs + 1
  let prepared = compiled.Prepared { code: unsafe Pointer.read<compiled.CompiledCode>(unsafe Intrinsic.pointerReinterpret<*const ?*const u8, *const compiled.CompiledCode>(Pointer.fromRef<?*const u8>(&entry.code))),
    data: entry.data, env: entry.env, counter: unsafe Intrinsic.pointerRequalify<?*mut i32, *mut i32>(entry.counter) }
  drop entry
  let record = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut Activation>(unsafe Pointer.atMut<u64>(base, top))
  let stackFrame = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut StackFrame>(unsafe Pointer.atMut<u64>(base, top + (Layout.of<Activation>().bytes + 7) / 8))
  let mut cells = unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(argv.data)
  if padding != 0 {
    // Missing parameters read as undefined: the code sees a padded copy (bits, borrowed).
    let padded = unsafe Pointer.assumeManyMut<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(base, top + header)))
    let given = unsafe Pointer.assumeManyMut<ValueBits>(argv.data)
    let mut position: usize = 0
    while position < parameters {
      let mut bits = ValueBits.Undefined
      if position < argv.count { bits = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(given, position)) }
      unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(padded, position), bits)
      position = position + 1
    }
    cells = unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(unsafe Pointer.atMut<ValueBits>(padded, 0))
  }
  let block = unsafe Pointer.atMut<u64>(base, top + header + padding)
  unsafe Pointer.write<u64>(block, 0)
  unsafe Pointer.write<u64>(unsafe Pointer.atMut<u64>(unsafe Pointer.assumeManyMut<u64>(block), compiled.CALL_CALLEE_EXIT), 0)
  unsafe Pointer.put<Activation>(record, Activation {
    frame: compiled.CompiledFrame { thisValue: Pointer.fromRef<ValueBits>(&receiver), bytecode: bytecode, context: realm, runtime: runtime,
      closureReferences: captures.references, scope: captures.scope, calls: unsafe Intrinsic.pointerRequalify<*mut u64, ?*mut u64>(block), code: start,
      activation: unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut Activation, *mut u8>(record)) },
    prepared: move prepared, cells: cells, state: unsafe Pointer.atMut<u64>(base, top + header + padding + callWords), stackFrame: stackFrame,
    pc: NO_PC, published: false, mode: mode, function: function, receiver: receiver, argv: argv, parent: parent, mark: top, index: index,
    flags: flags, exit: compiled.EXIT_FRESH, known: known })
  let mut recordAnchor = () let pushed = unsafe Pointer.borrowMut<(), Activation>(&mut recordAnchor, record)
  pushed.frame.thisValue = Pointer.fromRef<ValueBits>(&pushed.receiver)
  return record
}
/// Publishes the stack frames of entry and of the activations it was called from that are not
/// published yet, outermost first, each at the call it is making: they then show in
/// backtraces and as the active function, as interpreter frames would.
unsafe fn publishActivations(runtime: *mut HeapHeader, entry: *mut Activation) -> () {
  let mut anchor = () let first = unsafe Pointer.borrowMut<(), Activation>(&mut anchor, entry)
  if first.published { return () }
  let parent = first.parent
  drop first
  match Pointer.nonNullMut<Activation>(parent) { Option<*mut Activation>.Some { value } => { unsafe publishActivations(runtime, value) } _ => () }
  let mut linkAnchor = () let running = unsafe Pointer.borrowMut<(), Activation>(&mut linkAnchor, entry)
  let empty = unsafe Intrinsic.pointerReinterpret<*mut StackFrame, *mut ValueBits>(running.stackFrame)
  let emptyRefs = unsafe Intrinsic.pointerReinterpret<*mut StackFrame, *mut ?*mut HeapHeader>(running.stackFrame)
  unsafe Pointer.put<StackFrame>(running.stackFrame, StackFrame { previous: unsafe previous(runtime), asyncOwner: Pointer.null<HeapHeader>(),
    currentFunction: running.function, debuggerId: 0, thisValue: running.receiver, newTarget: ValueBits.Undefined, arguments: running.argv,
    locals: FrameSlots { data: empty, count: 0 }, stack: FrameSlots { data: empty, count: 0 }, varRefs: FrameReferences { data: emptyRefs, count: 0 },
    currentPc: running.pc, argumentCount: usize.toI32(running.argv.count), mode: u8.toU32(running.mode), stackPointer: NO_SP })
  running.published = true
  let frame = running.stackFrame
  drop running
  unsafe activation.publish(runtime, frame)
}
/// Notes the call entry is making at site (its call block's CALL_SITE word).
@inlineAlways
unsafe fn noteCall(entry: &mut Activation, site: u64) -> () {
  entry.pc = u64.toUsize(site & 0xffffffff) + 1
  if entry.published {
    let mut anchor = () let frame = unsafe Pointer.borrowMut<(), StackFrame>(&mut anchor, entry.stackFrame)
    frame.currentPc = entry.pc
  }
}
/// pushActivation for a bytecode closure, whose captures come from its object.
@inlineAlways
unsafe fn pushClosure(runtime: *mut HeapHeader, slot: *mut CompiledEntry, function: ValueBits, bytecode: *mut HeapHeader, index: u32, receiver: ValueBits,
  argv: FrameSlots, flags: u32, parent: ?*mut Activation) -> ?*mut Activation {
  // The caller pointer is only a non-null filler for a closure.
  let filler = unsafe Intrinsic.pointerReinterpret<*const ValueBits, *const Machine>(Pointer.fromRef<ValueBits>(&receiver))
  let captures = unsafe activation.capturesOf(function, bytecode, filler, false)
  return unsafe pushActivation(runtime, slot, function, bytecode, index, receiver, argv, captures, flags, parent, false)
}
/// Takes entry and everything above it off the activation stack and unpublishes its frame.
@inlineAlways
unsafe fn popActivation(runtime: *mut HeapHeader, entry: &Activation) -> () {
  let mut anchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut anchor, runtime)
  state.compiled.activationTop = entry.mark
  if entry.published {
    drop state
    let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, entry.stackFrame)
    let previous = frame.previous
    drop frame
    unsafe activation.publish(runtime, previous)
  }
}
/// Pops the activation at record, which machine code pushed and ran to its return
/// (DIRECT_ACT_*), when its frame was published meanwhile.
pub unsafe fn popDirect(record: *mut u8) -> () {
  let entry = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Activation>(record)
  let anchor = () let ran = unsafe Pointer.borrow<(), Activation>(&anchor, entry)
  unsafe popActivation(ran.frame.runtime, &ran)
}
@inlineAlways
unsafe fn runActivation(entry: *mut Activation) -> u32 {
  let anchor = () let running = unsafe Pointer.borrow<(), Activation>(&anchor, entry)
  return unsafe compiled.runPrepared(&running.prepared, &running.frame, running.cells, running.state)
}
/// The activation CALL_FAST pushed for the call the code at block left to make, if it did
/// (compiled.CALLEE_PUSHED), with the block's callee exit cleared.
@inlineAlways
unsafe fn pushedCallee(block: *mut u64) -> ?*mut Activation {
  let words = unsafe Pointer.assumeManyMut<u64>(block)
  let calleeExit = unsafe Pointer.atMut<u64>(words, compiled.CALL_CALLEE_EXIT)
  if unsafe Pointer.read<u64>(calleeExit) != compiled.CALLEE_PUSHED { return Pointer.null<Activation>() }
  unsafe Pointer.write<u64>(calleeExit, 0)
  return unsafe Pointer.read<?*mut Activation>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ?*mut Activation>(unsafe Pointer.atMut<u64>(words, compiled.CALL_STATE)))
}
/// Runs root, an activation that has not run, and every activation its calls push, until root
/// returns (its owned result) or throws. A call to code that makes calls pushes an activation
/// (CALL_FAST, js_vm.fastCall) that runs here, so compiled callers keep no native frame per
/// level; other calls are made by activationCall. An activation that deoptimizes, polls or
/// throws is finished in an interpreter frame from its exit state (callResuming; callKnown for
/// a known root, whose caller is the interpreter frame at caller). context is the realm
/// root's caller runs in.
@inlineNever
unsafe effect fn runActivations<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, caller: ?*mut Machine, context: *mut HeapHeader, root: *mut Activation) -> ValueBits ! JsException ? &mut Allocator {
  let mut current = root
  let mut anchor = ()
  let runtime = (unsafe Pointer.borrow<(), Activation>(&anchor, root)).frame.runtime
  let mut exit = (unsafe Pointer.borrow<(), Activation>(&anchor, root)).exit
  if exit == compiled.EXIT_FRESH { exit = unsafe runActivation(current) }
  while true {
    if exit == compiled.EXIT_CALL {
      let mut entryAnchor = () let running = unsafe Pointer.borrowMut<(), Activation>(&mut entryAnchor, current)
      let block = unsafe Intrinsic.pointerRequalify<?*mut u64, *mut u64>(running.frame.calls)
      match Pointer.nonNullMut<Activation>(unsafe pushedCallee(block)) {
        Option<*mut Activation>.Some { value: child } => {
          unsafe noteCall(&mut running, unsafe Pointer.read<u64>(unsafe Pointer.atMut<u64>(unsafe Pointer.assumeManyMut<u64>(block), compiled.CALL_SITE)))
          drop running
          let mut childAnchor = () let callee = unsafe Pointer.borrowMut<(), Activation>(&mut childAnchor, child)
          callee.parent = unsafe Intrinsic.pointerRequalify<*mut Activation, ?*mut Activation>(current)
          let left = callee.exit
          drop callee
          current = child
          // A callee fastCall ran nested continues from where it left.
          if left != compiled.EXIT_FRESH { exit = left continue }
        }
        Option<*mut Activation>.None => {
          drop running
          let how = run unsafe activationCall(&mut hooks, memory, current)
          unsafe Pointer.write<u64>(block, unsafe Pointer.read<u64>(block) | how)
        }
      }
      exit = unsafe runActivation(current)
      continue
    }
    let mut how = compiled.CALL_RETURNED
    let mut value = ValueBits.Undefined
    let entry = unsafe Pointer.borrow<(), Activation>(&anchor, current)
    let parent = entry.parent
    if exit == compiled.EXIT_RETURNED {
      value = unsafe compiled.result(entry.state)
      unsafe popActivation(runtime, &entry)
    } else {
      // The frame callResuming builds takes this activation's place, below its callers'.
      let published = entry.published
      if published {
        let frame = unsafe Pointer.borrow<(), StackFrame>(&anchor, entry.stackFrame)
        let previous = frame.previous
        drop frame
        unsafe activation.publish(runtime, previous)
      } else {
        match Pointer.nonNullMut<Activation>(parent) { Option<*mut Activation>.Some { value: above } => { unsafe publishActivations(runtime, above) } _ => () }
      }
      let resume = compiled.Resume { state: entry.state, exit: exit, index: entry.index }
      let function = entry.function let receiver = entry.receiver let argv = entry.argv let flags = entry.flags
      let mut realm = context
      if let Option<*mut Activation>.Some { value: above } = Pointer.nonNullMut<Activation>(parent) {
        realm = (unsafe Pointer.borrow<(), Activation>(&anchor, above)).frame.context
      }
      let known = entry.known
      drop entry
      let finished = match Pointer.nonNullMut<Machine>(caller) {
        Option<*mut Machine>.Some { value: interpreter } if known => {
          let frame = unsafe Pointer.borrow<(), Machine>(&anchor, interpreter)
          run Intrinsic.catchFailure<JsException>(unsafe callKnown(&mut hooks, memory, &frame, function, &argv, resume), failedJs)
        }
        _ => run Intrinsic.catchFailure<JsException>(unsafe callResuming(&mut hooks, memory, realm, function, receiver, ValueBits.Undefined,
          &argv, flags, resume), failedJs)
      }
      let mut doneAnchor = () let done = unsafe Pointer.borrowMut<(), Activation>(&mut doneAnchor, current)
      done.published = false
      unsafe popActivation(runtime, &done)
      drop done
      match move finished {
        ValueBits result => { value = result }
        FailedJs { .. } => { how = compiled.CALL_THREW }
      }
    }
    match Pointer.nonNullMut<Activation>(parent) {
      Option<*mut Activation>.None => {
        if how == compiled.CALL_THREW { fail JsException {} }
        return value
      }
      Option<*mut Activation>.Some { value: above } => {
        let block = (unsafe Pointer.borrow<(), Activation>(&anchor, above)).frame.calls
        let words = unsafe Intrinsic.pointerRequalify<?*mut u64, *mut u64>(block)
        if how == compiled.CALL_RETURNED {
          unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(unsafe Pointer.assumeManyMut<u64>(words), compiled.CALL_RESULT)), value)
        }
        unsafe Pointer.write<u64>(words, unsafe Pointer.read<u64>(words) | how)
        current = above
        exit = unsafe runActivation(current)
      }
    }
  }
  return invariant()
}
/// compiledCall for the activation at entry (its call block in its frame): how the call
/// went, as a compiled.CALL_* code.
@inlineNever
unsafe effect fn activationCall<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, entry: *mut Activation) -> u64 ? &mut Allocator {
  let mut anchor = () let running = unsafe Pointer.borrowMut<(), Activation>(&mut anchor, entry)
  let block = unsafe Intrinsic.pointerRequalify<?*mut u64, *mut u64>(running.frame.calls)
  let runtime = running.frame.runtime
  let context = running.frame.context
  let words = unsafe Pointer.assumeManyMut<u64>(block)
  let site = unsafe Pointer.read<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_SITE))
  let count = compiled.siteCount(site)
  let kind = compiled.siteKind(site)
  if kind == compiled.SITE_PUT_FIELD || kind == compiled.SITE_EQUAL {
    let bytecode = running.frame.bytecode
    unsafe noteCall(&mut running, site)
    drop running
    unsafe publishActivations(runtime, entry)
    return run unsafe compiledStep(&mut hooks, runtime, context, bytecode, block, u64.toUsize(site & 0xffffffff))
  }
  let area = unsafe Pointer.assumeManyMut<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_AREA)))
  if (site & compiled.SITE_GENERIC) != 0 {
    unsafe noteCall(&mut running, site)
    drop running
    unsafe publishActivations(runtime, entry)
    let mut scratch = unsafe activationMachine(entry)
    return run unsafe compiledOp(&mut hooks, memory, &mut scratch, block)
  }
  let function = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 0))
  if let ValueBits.FunctionBytecode { .. } = function { return compiled.CALL_DEOPT }
  if (site & compiled.SITE_LAZY_ARGUMENTS) != 0 {
    if !unsafe lazyApplies(runtime, area, site) { return compiled.CALL_DEOPT }
    let own = FrameSlots { data: running.argv.data, count: running.argv.count }
    unsafe noteCall(&mut running, site)
    drop running
    unsafe publishActivations(runtime, entry)
    let applied = run Intrinsic.catchFailure<JsException>(unsafe callFromCompiled(&mut hooks, memory, runtime, context,
      unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 1)), unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 2)), own), failedJs)
    return unsafe answerCall(words, move applied)
  }
  let calleeExit = unsafe Pointer.read<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_CALLEE_EXIT))
  if function.isObject() && unsafe classId(function) == classes.JS_CLASS_BYTECODE_FUNCTION && calleeExit == 0
    && unsafe leavesForCallee(runtime, (unsafe activation.calleeOf(function)).bytecode, site) {
    return compiled.CALL_DEOPT
  }
  unsafe noteCall(&mut running, site)
  drop running
  unsafe publishActivations(runtime, entry)
  let receiver = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(area, 1))
  let argv = FrameSlots { data: unsafe Pointer.atMut<ValueBits>(area, 2), count: count }
  if calleeExit != 0 {
    unsafe Pointer.write<u64>(unsafe Pointer.atMut<u64>(words, compiled.CALL_CALLEE_EXIT), 0)
    let resume = compiled.Resume { state: unsafe Pointer.atMut<u64>(words, compiled.CALL_STATE), exit: u64.wrappingToU32(calleeExit),
      index: u64.wrappingToU32(u64.shiftRight(calleeExit, 32)) }
    let resumed = run Intrinsic.catchFailure<JsException>(unsafe callResuming(&mut hooks, memory, context, function, receiver,
      ValueBits.Undefined, &argv, activation.COPY_ARGUMENTS, resume), failedJs)
    match move resumed {
      ValueBits result => {
        unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_RESULT)), result)
        return compiled.CALL_RETURNED
      }
      FailedJs { .. } => { return compiled.CALL_THREW }
    }
  }
  if (site & compiled.SITE_CONSTRUCT) != 0 {
    let constructed = run Intrinsic.catchFailure<JsException>(unsafe constructInternal(&mut hooks, memory, context, function, receiver, &argv,
      activation.COPY_ARGUMENTS), failedJs)
    return unsafe answerCall(words, move constructed)
  }
  let called = run Intrinsic.catchFailure<JsException>(unsafe callFromCompiled(&mut hooks, memory, runtime, context, function, receiver, argv), failedJs)
  match move called {
    ValueBits result => {
      unsafe Pointer.write<ValueBits>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut ValueBits>(unsafe Pointer.atMut<u64>(words, compiled.CALL_RESULT)), result)
      return compiled.CALL_RETURNED
    }
    FailedJs { .. } => { return compiled.CALL_THREW }
  }
}
/// A call made by compiled code threw (compiled.ENTER_THREW): machine holds the state at
/// that call and the exception is pending, as when execute fails there. Unwinds as the
/// callInternal loop does; false when nothing in this run catches it.
@inlineNever
unsafe effect fn compiledThrew<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + ErrorHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> bool ? &mut Allocator {
  if !unsafe restricted.rejected(machine.runtime) { run unsafe exceptionBoundary(&mut hooks, memory, &mut machine) }
  return run unsafe unwindFrames(&mut hooks, memory, &mut machine)
}
unsafe effect fn exceptionBoundary<H: HeapHooks + CoercionHooks + ErrorHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine) -> () ? &mut Allocator {
  let current = unsafe activation.innermost(&mut base)
  let anchor = () let machine = unsafe Pointer.borrow<(), Machine>(&anchor, current)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)
  let active = state.debugger.active drop state
  let mut pc = machine.pc()
  if let Option<*mut DebugActivation>.Some { value } = Pointer.nonNullMut<DebugActivation>(active) {
    let snapshot = unsafe Pointer.borrow<(), DebugActivation>(&anchor, value)
    pc = snapshot.pc
  }
  run Effect.catch<JsException>(unsafe debugger.boundary(&mut hooks, memory, &machine, pc, true), ignoreClose)
}
/// Copies the registers that dispatch changes (pc and sp) between the shared
/// machine and execute's local copy.
@inlineAlways
unsafe fn sync(from: &Machine, to: &mut Machine) -> () { to.ip = from.ip to.stackTop = from.stackTop }
// Reloads everything but the registers from the shared machine. Arms that read
// frame fields call it first, so no frame field stays live across dispatch and
// execute's entry loads only ip and stackTop instead of spilling the whole frame.
/// refresh and sync from the machine at from, after dispatch switched frames.
@inlineAlways
unsafe fn reloadFrom(from: *mut Machine, to: &mut Machine) -> () {
  let anchor = () let machine = unsafe Pointer.borrow<(), Machine>(&anchor, from)
  unsafe refresh(&machine, &mut to) unsafe sync(&machine, &mut to)
}
@inlineAlways
unsafe fn refresh(from: &Machine, to: &mut Machine) -> () {
  // Field by field: a whole-struct copy can lower to a memcpy that keeps m in memory.
  to.context = from.context
  to.callerContext = from.callerContext
  to.runtime = from.runtime
  to.bytecode = from.bytecode
  to.frame = from.frame
  to.code = from.code
  to.constants = from.constants
  to.closureReferences = from.closureReferences
  to.originalArguments = from.originalArguments
  to.arguments = from.arguments
  to.locals = from.locals
  to.stack = from.stack
  to.thisValue = from.thisValue
  to.newTarget = from.newTarget
  to.argumentCount = from.argumentCount
}
unsafe fn observationFlag(runtime: *mut HeapHeader) -> *const bool {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  return Pointer.fromRef<bool>(&state.observeInstructions)
}
/// The debugger, coverage and CPU profile boundary before the instruction at
/// machine's pc; run only while RuntimeState.observeInstructions is set.
/// Returns whether the instruction must also pass the restricted-evaluation check.
@inlineNever
unsafe effect fn observeInstruction<H: HeapHooks + CoercionHooks + ErrorHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &Machine) -> bool ! JsException ? &mut Allocator {
  let stateAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&stateAnchor, machine.runtime)
  let observing = state.debugger.enabled || state.coverage.enabled || state.cpuProfile.enabled
  let restricting = state.debugger.restricted
  let recording = state.feedback.recording != 0
  drop state
  if recording { unsafe feedback.observe(&machine) }
  if !observing || unsafe debugger.quietBoundary(&machine, machine.pc()) { return restricting }
  run unsafe debugger.boundary(&mut hooks, memory, &machine, machine.pc(), false)
  let after = unsafe HeapCell.payload<RuntimeState, ()>(&stateAnchor, machine.runtime)
  let restricted = after.debugger.restricted drop after
  return restricted
}
/// Counts the coverage counter just passed (the nop before machine's pc), as the
/// observed loop would have before it.
@inlineNever
unsafe fn countPassed(machine: &Machine) -> () {
  unsafe coverage.record(machine.runtime, machine.bytecode, machine.pc() - 1, coverage.NO_PC)
}
/// The restricted-evaluation check of opcode, whose operands follow machine's pc.
@inlineNever
unsafe effect fn restrictInstruction(machine: &Machine, opcode: u8) -> () ! JsException {
  let stateAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&stateAnchor, machine.runtime)
  let restricting = state.debugger.restricted drop state
  if restricting { run unsafe restricted.instruction(&machine, opcode) }
}
// One match routes every opcode. Patterns must be integer literals, so each arm
// names its opcode in a trailing comment; scripts/check_opcode_dispatch.py checks
// them against js_opcode_data. Hot opcodes run inline; the rest go straight to
// the family that implements them.
/// OP_get_scope0_el past the plain-array and symbol-key paths: the key is pushed,
/// so this is get_array_el's slow path, kept out of line so executeLoop's frame does
/// not grow by a second copy of it.
@inlineNever
unsafe effect fn scopeElementSlow<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  // text[i] of a Latin-1 code unit: the runtime's unit string.
  if !(unsafe machine.top(2)).isString() || !run unsafe stringElementAnswer(&mut hooks, &mut machine) {
  // arguments[i] on a lazy arguments slot's stand-in answers from the frame.
  if !((unsafe machine.top(2)).tag() == 4 && run unsafe factories.lazyArgumentsRead(&mut hooks, memory, &mut machine, op.OP_get_array_el)) {
    let other = unsafe properties.readStringElementOperand(&mut hooks, &mut machine)
    match Pointer.nonNullMut<HeapHeader>(other) {
      Option<*mut HeapHeader>.Some { value } => { unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, value) }
      Option<*mut HeapHeader>.None => { drop run unsafe properties.step(&mut hooks, memory, &mut machine, op.OP_get_array_el) }
    }
  }
  }
}
/// OP_extended: an opcode no hot code runs, written behind the prefix in final
/// code because its primary number holds a fusion; its own number follows.
@inlineNever
unsafe effect fn extendedStep<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> ()
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let opcode = unsafe machine.readU8()
  if opcode == op.OP_check_brand { drop run unsafe objects.step(&mut hooks, memory, &mut machine, opcode) return }
  if opcode == op.OP_get_super_value || opcode == op.OP_put_super_value { drop run unsafe properties.step(&mut hooks, memory, &mut machine, opcode) return }
  if opcode == op.OP_using_dispose_init || opcode == op.OP_using_dispose_merge || opcode == op.OP_using_dispose_end {
    drop run unsafe disposal.step(&mut hooks, memory, &mut machine, opcode) return
  }
  drop run unsafe values.step(&mut hooks, &mut machine, opcode)
}

@inlineAlways
unsafe effect fn execute<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  // Two copies of the loop: the plain one tests nothing per instruction, the
  // observed one runs the debugger, coverage, profiler and restricted checks
  // before each. A run moves between them when RuntimeState.observeInstructions
  // changes: the observed loop sees it at its next instruction, the plain one
  // at its next interrupt poll (js_debugger.configure forces one).
  while true {
    let mut handoff = false
    let flagAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&flagAnchor, base.runtime)
    let observed = state.observeInstructions drop state
    let mut result = ValueBits.Undefined
    if observed {
      // Frames entered unobserved have no debugger activation yet.
      unsafe activation.adoptFrames(base.runtime)
      result = run unsafe executeObserved(&mut hooks, memory, &mut base, &mut handoff)
    }
    else {
      // Counted so interrupt polls keep handing plain runs off once observation
      // turns on (js_interrupts.handle).
      let mut countAnchor = ()
      let counting = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut countAnchor, base.runtime)
      counting.plainRuns = counting.plainRuns + 1 drop counting
      let outcome = run Effect.result(unsafe executePlain(&mut hooks, memory, &mut base, &mut handoff))
      let counted = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut countAnchor, base.runtime)
      counted.plainRuns = counted.plainRuns - 1 drop counted
      result = match move outcome {
        Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
        Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => { fail move error }
      }
    }
    if !handoff { return result }
  }
  return ValueBits.Undefined
}
@inlineNever
unsafe effect fn executePlain<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine, handoff: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mode = PlainRun { unused: 0 }
  return run unsafe executeLoop(&mut hooks, memory, &mut base, &mode, &mut handoff)
}
@inlineNever
unsafe effect fn executeObserved<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine, handoff: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mode = ObservedRun { unused: 0 }
  return run unsafe executeLoop(&mut hooks, memory, &mut base, &mode, &mut handoff)
}
@inlineNever
unsafe effect fn executeSingle<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine, handoff: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let mode = SingleRun { unused: 0 }
  return run unsafe executeLoop(&mut hooks, memory, &mut base, &mode, &mut handoff)
}
/// The interrupt poll of a backward jump that fell due, out of line so the dispatch loop
/// carries one call: handles the interrupt, then reports whether a plain run must hand off
/// to the observed loop, else lets compiled loop code take the frame (js_compiled_osr).
@inlineNever
unsafe effect fn backEdgePoll<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine, observe: bool) -> bool
  ! JsException ? &mut Allocator {
  run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context))
  if observe { return false }
  if unsafe Pointer.read<bool>(unsafe observationFlag(machine.runtime)) { return true }
  if run unsafe baselineLoop(&mut hooks, &mut machine) { return false }
  run unsafe osrAtPoll(&mut hooks, memory, &mut machine)
  return false
}
/// On-stack replacement at a back-edge poll (docs/jit/osr.md, js_compiled_osr): runs the
/// running frame's OSR code, making the calls it leaves to make (compiledCall, as enterBase
/// does), handling poll exits with the frame whole and entering again; a call that threw is
/// raised at the call once the frame holds the state there.
@inlineNever
unsafe effect fn osrAtPoll<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine) -> ()
  ! JsException ? &mut Allocator {
  let first = unsafe osr.target(&machine)
  if Pointer.isNull<u8>(first.code) { return () }
  let inputs = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(first.inputs))
  let state = unsafe Intrinsic.pointerRequalify<[*]mut u64, *mut u64>(unsafe Intrinsic.stackAllocate<u64>(first.stateWords))
  let block = unsafe Intrinsic.pointerRequalify<[*]mut u64, *mut u64>(unsafe Intrinsic.stackAllocate<u64>(first.blockWords))
  let mut target = first
  while true {
    let mut exit = unsafe osr.start(&machine, &target, inputs, state, block)
    while exit == compiled.EXIT_CALL {
      let how = run unsafe compiledCall(&mut hooks, memory, &mut machine, block)
      unsafe Pointer.write<u64>(block, unsafe Pointer.read<u64>(block) | how)
      exit = unsafe osr.again(&machine, &target, inputs, state, block)
    }
    unsafe osr.finish(&mut hooks, &mut machine, &target, exit, state)
    if exit == compiled.EXIT_THROW { fail JsException {} }
    if exit != compiled.EXIT_POLL { return () }
    unsafe osr.resetCounter(&machine)
    // The frame is whole again: the handler may run the debugger or compile and link.
    run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context))
    target = unsafe osr.target(&machine)
    // Relinked with code that needs larger buffers: the next poll enters it.
    if Pointer.isNull<u8>(target.code) || target.blockWords > first.blockWords { return () }
  }
}
/// Which copy of the dispatch loop a run is in: a type, so each copy is its
/// own instance with the answer constant.
interface Observation { fn observes(self: &Self) -> bool fn single(self: &Self) -> bool }
struct PlainRun { unused: u8 }
impl Observation for PlainRun {
  @inlineAlways fn observes(self: &Self) -> bool { return false }
  @inlineAlways fn single(self: &Self) -> bool { return false }
}
struct ObservedRun { unused: u8 }
impl Observation for ObservedRun {
  @inlineAlways fn observes(self: &Self) -> bool { return true }
  @inlineAlways fn single(self: &Self) -> bool { return false }
}
/// The plain loop for one instruction of the frame it starts in (baselineStep): it stops,
/// with handoff set, before that frame's next instruction.
struct SingleRun { unused: u8 }
impl Observation for SingleRun {
  @inlineAlways fn observes(self: &Self) -> bool { return false }
  @inlineAlways fn single(self: &Self) -> bool { return true }
}
/// The dispatch loop. Returns with handoff set (and the frames' state written
/// back) when the run must continue in the other copy.
unsafe effect fn executeLoop<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks, O: Observation>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine, mode: &O, handoff: &mut bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let observe = mode.observes()
  // The running frame's machine: base or an inline call frame above it.
  let mut current = unsafe activation.innermost(&mut base)
  // Registers: pc and sp live in a local copy, written back around calls out.
  let mut m = unsafe Pointer.read<Machine>(current)
  // Jumps poll through this pointer. Inline callees may run in another realm;
  // polling the first frame's counter still bounds the time between polls.
  let interruptCounter = unsafe interrupts.counter(m.context)
  // One runtime serves every frame, so the flag's address holds for the whole run.
  let observeInstructions = unsafe observationFlag(m.runtime)
  let mut restricting = false
  let single = mode.single()
  let start = Pointer.address<Machine>(current)
  let mut stepped = false
  while true {
    let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, current)
    if single {
      if stepped && Pointer.address<Machine>(current) == start { unsafe sync(&m, &mut machine) handoff.* = true return ValueBits.Undefined }
      stepped = true
    }
    if observe {
      unsafe sync(&m, &mut machine)
      if !unsafe Pointer.read<bool>(observeInstructions) { handoff.* = true return ValueBits.Undefined }
      restricting = run unsafe observeInstruction(&mut hooks, memory, &machine)
      unsafe sync(&machine, &mut m)
    }
    let opcode = unsafe m.readU8()
    if observe && restricting {
      // The restricted check reads the operands after the opcode.
      unsafe sync(&m, &mut machine)
      run unsafe restrictInstruction(&machine, opcode)
    }
    match opcode {
      // Literals and stack shuffles.
      1 => { unsafe refresh(&machine, &mut m) let n = unsafe m.readI32() unsafe m.push(ValueBits.Int { value: n }) } // OP_push_i32
      6 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Undefined) } // OP_undefined
      7 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Null) } // OP_null
      9 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Bool { value: false }) } // OP_push_false
      10 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Bool { value: true }) } // OP_push_true
      14 => { unsafe refresh(&machine, &mut m) let value = unsafe m.pop() unsafe locals.releaseIn(&mut hooks, &machine, value) } // OP_drop
      17 => { unsafe refresh(&machine, &mut m) let cell = unsafe m.topCell(1) unsafe m.pushCopy(cell) } // OP_dup
      // The fusion prefix: it answers the instructions it covers and skips
      // them, or does nothing and lets them run (always, under observation).
      // The first covered opcode tells which fusion it is, or the last
      // operand byte (128 and up) for a comparison and its branch.
      184 => { // OP_fuse_prefix
        unsafe refresh(&machine, &mut m)
        let mut advance: usize = 4
        let mut answered = Pointer.null<HeapHeader>()
        let mut backward = false
        let word = unsafe m.peekU64At(0)
        if !observe {
          if u64.wrappingToU8(u64.shiftRight(word, 32)) == op.OP_dup { advance = unsafe operators.fusedCaseAtom(&m, word) }
          // Heap reads next: compiled C makes one every few instructions.
          else if (word & 0x80000000) == 0 {
            if (word & 0x40000000) != 0 {
              // The array is a captured variable or a global: read where it is
              // held, when the capture became a get_scope0 (the compiler writes
              // the prefix before it knows).
              let tail = unsafe m.peekU64At(4)
              let head = u64.wrappingToU8(tail)
              let slot = u64.toUsize(u64.shiftRight(tail, 8) & 0xffff)
              // found with held, rather than a null held: each branch then goes
              // straight on or straight out, with no test in between.
              let mut held = m.bytecode let mut found = false
              if head == op.OP_get_scope0 {
                match unsafe Pointer.read<ValueBits>(unsafe scopeSlot(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(machine.scope), slot)) {
                  ValueBits.Object { reference } => { held = reference found = true } _ => {}
                }
              } else if head == op.OP_get_var {
                unsafe refresh(&machine, &mut m)
                match unsafe globals.peekAt(&m, slot) { ValueBits.Object { reference } => { held = reference found = true } _ => {} }
              }
              if found { unsafe properties.fusedHeldElement(&mut m, held, word, tail, &mut advance) }
            }
            else { answered = unsafe properties.fusedAddressElement(&mut m, word, &mut advance) }
          }
          else if u64.wrappingToU32(word) >= 0x90000000 {
            // A loop's test on a local or an argument, with its step and its
            // short if_true8 back edge (the last operand byte is the way
            // back): taken, it polls interrupts below, as if_true8 does.
            let answer = unsafe operators.fusedSlotCompare(&m, word)
            if answer == 1 { advance = i64.wrappingToUsize(i32.toI64(unsafe m.peekI8At(3))) backward = true }
            else if answer == 0 {
              let first = unsafe m.peekU8(4)
              advance = 2 + unsafe operators.slotCompareEnd(first, unsafe m.peekU8(4 + u8.toUsize(op.opcodeInfo(first, true).size)))
            }
          }
          else if u64.wrappingToU32(word) >= 0x89000000 {
            // `a[i] = v` on slots and small constants (0x89, plus 1 for an
            // argument array and 2 for an argument value): operand bytes the
            // array, the index (bit 7: a local, else the constant itself),
            // the value (bits 6-7: 0 a local, 2 a constant). Stored from the
            // slots, with nothing pushed; the covered reads and put_array_el
            // are skipped. One copy per shape, each moving on by its own
            // constant: a count read from the prefix would chain every
            // store's ip through a bytecode load.
            let shape = u64.shiftRight(word, 24) & 0xff
            let a = u64.toUsize(word & 0x7f) let i = u64.toUsize(u64.shiftRight(word, 8) & 0x7f) let v = u64.toUsize(u64.shiftRight(word, 16) & 0x3f)
            let mut at = usize.toI32(i)
            if (word & 0x8000) != 0 { at = match unsafe m.local(i) { ValueBits.Int { value } => value _ => -1 } }
            if at >= 0 {
              if shape == 0x89 {
                match unsafe m.local(a) { ValueBits.Object { reference } => {
                  if (word & 0x800000) != 0 { if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, ValueBits.Int { value: usize.toI32(v) }) { advance = 11 } }
                  else if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, unsafe m.local(v)) { advance = 11 }
                } _ => {} }
              } else if shape == 0x8a {
                match unsafe m.argument(a) { ValueBits.Object { reference } => {
                  if (word & 0x800000) != 0 { if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, ValueBits.Int { value: usize.toI32(v) }) { advance = 10 } }
                  else if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, unsafe m.local(v)) { advance = 10 }
                } _ => {} }
              } else if shape == 0x8b {
                match unsafe m.local(a) { ValueBits.Object { reference } => { if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, unsafe m.argument(v)) { advance = 10 } } _ => {} }
              } else {
                match unsafe m.argument(a) { ValueBits.Object { reference } => { if unsafe properties.storeElementAt(&mut hooks, m.runtime, reference, at, unsafe m.argument(v)) { advance = 9 } } _ => {} }
              }
            }
          }
          // 0x88: a loop's test whose back edge came out long; its instructions run.
          // Or, over a get_var_ref_check, a class constructor's field initializer call.
          else if u64.wrappingToU32(word) >= 0x88000000 {
            if u64.wrappingToU8(u64.shiftRight(word, 32)) == op.OP_get_var_ref_check {
              unsafe sync(&m, &mut machine) advance = run unsafe fieldsPrefix(&mut hooks, &mut machine) unsafe sync(&machine, &mut m)
            }
          }
          else { advance = unsafe operators.fusedCompare(&m, word) }
        }
        unsafe m.skip(advance)
        match Pointer.nonNullMut<HeapHeader>(answered) {
          Option<*mut HeapHeader>.Some { value } => { unsafe gc.releaseObjectHeader(&mut hooks, m.runtime, value) }
          Option<*mut HeapHeader>.None => {}
        }
        if backward && unsafe interrupts.dueAt(interruptCounter) { unsafe sync(&m, &mut machine) if run unsafe backEdgePoll(&mut hooks, memory, &mut machine, observe) { handoff.* = true return ValueBits.Undefined } unsafe sync(&machine, &mut m) }
      }
      185 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 0 }) } // OP_push_0
      186 => { unsafe refresh(&machine, &mut m) unsafe m.push(ValueBits.Int { value: 1 }) } // OP_push_1
      // add, sub and mul with local operands read in place (no retain, no
      // stack round trip): numbers answer here; anything else pushes the
      // locals and takes the operator's own slow path.
      187 => { // OP_add_loc_loc8: get_loc8 a, get_loc8 b, then add
        unsafe refresh(&machine, &mut m)
        let left = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        let right = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(1)))
        unsafe m.skip(2)
        if unsafe operators.cellArithmetic(left, right, m.stackTop, op.OP_add) { unsafe m.advance(1) }
        else {
          unsafe m.pushCopy(left) unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_add)) {
            if !(unsafe operators.hasStoredTarget(machine.ip) && unsafe operators.addStoredShort(&mut machine)) && !run unsafe operators.addTextEntry(&mut machine) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_add) }
          }
          unsafe sync(&machine, &mut m)
        }
      }
      188 => { // OP_sub_loc_loc8: get_loc8 a, get_loc8 b, then sub
        unsafe refresh(&machine, &mut m)
        let left = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        let right = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(1)))
        unsafe m.skip(2)
        if unsafe operators.cellArithmetic(left, right, m.stackTop, op.OP_sub) { unsafe m.advance(1) }
        else {
          unsafe m.pushCopy(left) unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_sub)) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_sub) }
          unsafe sync(&machine, &mut m)
        }
      }
      189 => { // OP_mul_loc_loc8: get_loc8 a, get_loc8 b, then mul
        unsafe refresh(&machine, &mut m)
        let left = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        let right = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(1)))
        unsafe m.skip(2)
        if unsafe operators.cellArithmetic(left, right, m.stackTop, op.OP_mul) { unsafe m.advance(1) }
        else {
          unsafe m.pushCopy(left) unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_mul)) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_mul) }
          unsafe sync(&machine, &mut m)
        }
      }
      190 => { // OP_add_top_loc8: get_loc8 b, then add
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.readU8())
        let right = unsafe m.localCell(index)
        let left = unsafe m.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_add) {
          unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_add)) {
            if !(unsafe operators.hasStoredTarget(machine.ip) && unsafe operators.addStoredShort(&mut machine)) && !run unsafe operators.addTextEntry(&mut machine) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_add) }
          }
          unsafe sync(&machine, &mut m)
        }
      }
      191 => { // OP_sub_top_loc8: get_loc8 b, then sub
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.readU8())
        let right = unsafe m.localCell(index)
        let left = unsafe m.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_sub) {
          unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
          if !(unsafe operators.bigIntOperands(&machine) && run unsafe operators.bigOperands(&mut hooks, &mut machine, op.OP_sub)) { drop run unsafe operators.step(&mut hooks, memory, &mut machine, op.OP_sub) }
          unsafe sync(&machine, &mut m)
        }
      }
      192 => { // OP_mul_top_loc8: get_loc8 b, then mul
        unsafe refresh(&machine, &mut m)
        let index = u8.toUsize(unsafe m.readU8())
        let right = unsafe m.localCell(index)
        let left = unsafe m.topCell(1)
        if !unsafe operators.cellArithmetic(left, right, left, op.OP_mul) {
          unsafe m.pushCopy(right)
          unsafe sync(&m, &mut machine)
