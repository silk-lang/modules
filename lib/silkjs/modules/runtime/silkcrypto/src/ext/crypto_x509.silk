//! X509Certificate and Certificate (SPKAC) over silk.tls: the certificate operations 100-124.
//!
//! A certificate handle (kind 7) holds the DER that silk.tls.certificate accepted. The fields are
//! read from it with the small DER reader of ext/crypto_keys, the texts written as OpenSSL writes
//! them with silk.tls.certificate_text, and the keys and signatures go through ext/crypto_keys.
//! The JavaScript (internal/crypto_certificates) decodes the extensions it shows itself.

import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u64
import silk.num.u32
import silk.num.i64
import silk.num.usize
import silk.encoding.pem { Pem, PemSection, PemError }
import silk.encoding.base64 { Base64, Base64Error }
import silk.tls.certificate { Certificate, DecodeError, DecodeLimits }
import silk.time.instant { Instant }
import silk.tls.certificate_text { CertificateText, CertificateTextError, NameTextFormat, ObjectName }
import ext.crypto_algorithms as algorithms
import ext.crypto_algorithms { Call }
import ext.crypto_keys as keys
import ext.crypto_keys { Tlv }

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()

fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
unsafe fn nonnull<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn at(p: ?*mut u8, index: usize) -> *mut u8 { return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(p)), index) }
const EMPTY: [u8; 1] = [0]
fn none() -> &'static [u8] { return Slice.view<u8>(&EMPTY, 0, 0) }
fn readTlv(der: &[u8], offset: usize) -> Tlv { return keys.readTlv(der, offset) }
fn contents(der: &[u8], t: Tlv) -> &[u8] { return keys.contents(der, t) }
fn same(a: &[u8], b: &[u8]) -> bool { return keys.same(a, b) }

// Output and failures, as the other files report them.
unsafe fn reserve(c: &mut Call, n: usize) -> bool {
  unsafe free(c.output)
  c.output = unsafe calloc(1, if n == 0 { 1 } else { n }) c.capacity = if n == 0 { 1 } else { n } c.length = n
  return !Pointer.isNull<u8>(c.output)
}
unsafe fn output<'a>(anchor: &'a mut (), c: &Call) -> &'a mut [u8] {
  return unsafe Pointer.borrowManyMut<(), u8>(move anchor, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(c.output)), c.length)
}
unsafe fn emit(c: &mut Call, bytes: &[u8]) -> bool {
  if !unsafe reserve(&mut c.*, bytes.length) { return false }
  let mut i: usize = 0
  while i < bytes.length { unsafe Pointer.put<u8>(unsafe at(c.output, i), bytes[i]) i = i + 1 }
  return true
}
unsafe fn text(c: &mut Call, bytes: &[u8]) -> bool { c.resultKind = 3 return unsafe emit(&mut c.*, bytes) }
unsafe fn failWith(c: &mut Call, message: &[u8]) -> bool {
  let n = if message.length > 255 { 255 } else { message.length }
  let mut i: usize = 0
  while i < n { unsafe Pointer.put<u8>(unsafe at(c.error, i), message[i]) i = i + 1 }
  unsafe Pointer.put<u8>(unsafe at(c.error, n), 0)
  return false
}
unsafe fn absent(c: &mut Call) -> bool { c.resultKind = 4 return true }
unsafe fn answer(c: &mut Call, yes: bool) -> bool { c.resultKind = 1 c.result = if yes { 1 } else { 0 } return true }
unsafe fn arg<'a>(anchor: &'a (), c: &Call, i: usize) -> &'a [u8] {
  if c.lengths[i] == 0 || Pointer.isNull<u8>(c.data[i]) { return none() }
  return unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(c.data[i])), c.lengths[i])
}

// The handle: the certificate's DER.
struct X509 { der: ?*mut u8, length: usize }
unsafe fn derOf<'a>(anchor: &'a (), p: ?*mut u8) -> &'a [u8] {
  let x = unsafe Pointer.borrow<(), X509>(anchor, unsafe Intrinsic.pointerRequalify<*mut X509, *const X509>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut X509>(unsafe nonnull(p))))
  return unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(x.der)), x.length)
}
/// Frees a certificate handle (kind 7).
pub unsafe fn release(p: ?*mut u8) -> () {
  if Pointer.isNull<u8>(p) { return () }
  let owned = unsafe Pointer.take<X509>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut X509>(unsafe nonnull(p)))
  unsafe free(owned.der)
  unsafe free(p)
}

// Decoding: the first CERTIFICATE of PEM text, else DER. The DER length, or -1 for no PEM and
// DER that is not a certificate, -2 for PEM that is not one.
fn hasBegin(input: &[u8]) -> bool {
  let mark = b"-----BEGIN"
  if input.length < mark.length { return false }
  let mut i: usize = 0
  while i + mark.length <= input.length { if same(Slice.view<u8>(input, i, mark.length), mark) { return true } i = i + 1 }
  return false
}
fn copyInto(bytes: &[u8], out: &mut [u8]) -> i64 {
  if bytes.length > out.length { return -1 }
  let mut i: usize = 0
  while i < bytes.length { out[i] = bytes[i] i = i + 1 }
  return usize.toI64(bytes.length)
}
// A certificate that silk.tls's profile rejects (such as a name in a string type OpenSSL still
// reads) is kept when it has a certificate's shape: SEQUENCE { SEQUENCE, SEQUENCE, BIT STRING }.
fn certificateShape(der: &[u8]) -> bool {
  let outer = readTlv(der, 0)
  if outer.tag != 48 || outer.end != der.length { return false }
  let b = contents(der, outer)
  let first = readTlv(b, 0)
  if first.tag != 48 { return false }
  let second = readTlv(b, first.end)
  if second.tag != 48 { return false }
  let third = readTlv(b, second.end)
  return third.tag == 3 && third.end == b.length
}
fn lenient(input: &[u8], out: &mut [u8], pem: bool) -> i64 {
  if !pem { return if certificateShape(input) { copyInto(input, move out) } else { -1 } }
  let mut offset: usize = 0
  while true {
    let section = match move Pem.find(input, offset) { Result<PemSection, PemError>.Success { value } => move value Result<PemSection, PemError>.Failure { .. } => { return -2 } }
    offset = section.end
    let label = Pem.label(input, &section)
    if !same(label, b"CERTIFICATE") && !same(label, b"X509 CERTIFICATE") && !same(label, b"TRUSTED CERTIFICATE") { continue }
    let n = match move Pem.decode(input, &section, &mut out) { Result<usize, PemError>.Success { value } => value Result<usize, PemError>.Failure { .. } => { return -2 } }
    return if certificateShape(Slice.view<u8>(&out, 0, n)) { usize.toI64(n) } else { -2 }
  }
  return -2
}
effect fn decoded(input: &[u8], out: &mut [u8]) -> i64 ! OutOfMemoryError ? &mut Allocator {
  if hasBegin(input) {
    let strict = match run Certificate.decodePem(input, DecodeLimits.defaults()) {
      Result<Certificate, DecodeError>.Success { value } => copyInto(value.der(), &mut out)
      Result<Certificate, DecodeError>.Failure { .. } => -2
    }
    return if strict > 0 { strict } else { lenient(input, move out, true) }
  }
  let strict = match run Certificate.decodeDer(input, DecodeLimits.defaults()) {
    Result<Certificate, DecodeError>.Success { value } => copyInto(value.der(), &mut out)
    Result<Certificate, DecodeError>.Failure { .. } => -1
  }
  return if strict > 0 { strict } else { lenient(input, move out, false) }
}
unsafe fn create(c: &mut Call) -> bool {
  let anchor = ()
  let input = unsafe arg(&anchor, &c.*, 0)
  let buffer = unsafe calloc(1, input.length + 1)
  if Pointer.isNull<u8>(buffer) { return false }
  let mut a = ()
  let out = unsafe Pointer.borrowManyMut<(), u8>(&mut a, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(buffer)), input.length)
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(decoded(input, move out)) |> Effect.provideMut<Allocator>(&mut allocator)
  let length = match move result { Result<i64, OutOfMemoryError>.Success { value } => value Result<i64, OutOfMemoryError>.Failure { .. } => -1 }
  if length <= 0 {
    unsafe free(buffer)
    return unsafe failWith(&mut c.*, if length == -2 { b"error:068000A8:asn1 encoding routines::wrong tag" } else { b"error:0480006C:PEM routines::no start line" })
  }
  let p = unsafe calloc(1, Layout.of<X509>().bytes)
  if Pointer.isNull<u8>(p) { unsafe free(buffer) return false }
  unsafe Pointer.put<X509>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut X509>(unsafe nonnull(p)), X509 { der: buffer, length: i64.toUsize(length) })
  c.created = p c.createdKind = 7 c.resultKind = 2
  return true
}

// Fields of the DER: the offset of the `n`th element of `bytes`, and an element whole.
fn childOffset(bytes: &[u8], n: usize) -> usize {
  let mut offset: usize = 0
  let mut i: usize = 0
  while i < n && offset < bytes.length { let t = readTlv(bytes, offset) if t.tag == 0 { return bytes.length } offset = t.end i = i + 1 }
  return offset
}
fn child(bytes: &[u8], n: usize) -> Tlv { let offset = childOffset(bytes, n) return if offset >= bytes.length { Tlv { tag: 0, start: 0, length: 0, end: 0 } } else { readTlv(bytes, offset) } }
fn whole(bytes: &[u8], n: usize) -> &[u8] {
  let offset = childOffset(bytes, n)
  if offset >= bytes.length { return none() }
  let t = readTlv(bytes, offset)
  return Slice.view<u8>(bytes, offset, t.end - offset)
}
fn body(der: &[u8]) -> &[u8] { return contents(der, readTlv(der, 0)) }
fn tbs(der: &[u8]) -> &[u8] { let b = body(der) return contents(b, child(b, 0)) }
fn tbsWhole(der: &[u8]) -> &[u8] { return whole(body(der), 0) }
fn base(der: &[u8]) -> usize { return if child(tbs(der), 0).tag == 160 { 1 } else { 0 } }
fn tbsField(der: &[u8], n: usize) -> &[u8] { return whole(tbs(der), base(der) + n) }
fn serial(der: &[u8]) -> &[u8] { let t = tbs(der) return contents(t, child(t, base(der))) }
fn issuer(der: &[u8]) -> &[u8] { return tbsField(der, 2) }
fn subject(der: &[u8]) -> &[u8] { return tbsField(der, 4) }
fn spki(der: &[u8]) -> &[u8] { return tbsField(der, 5) }
fn signatureAlgorithm(der: &[u8]) -> &[u8] { return whole(body(der), 1) }
fn bitString(bytes: &[u8]) -> &[u8] { if bytes.length == 0 { return bytes } return Slice.view<u8>(bytes, 1, bytes.length - 1) }
fn signature(der: &[u8]) -> &[u8] { let b = body(der) return bitString(contents(b, child(b, 2))) }
fn version(der: &[u8]) -> u8 {
  if base(der) == 0 { return 0 }
  let t = tbs(der)
  let explicit = contents(t, child(t, 0))
  let value = contents(explicit, readTlv(explicit, 0))
  return if value.length == 0 { 0 } else { value[value.length - 1] }
}
// The value (the OCTET STRING's content) of the extension with the OID `id`, or empty.
fn extensionValue<'a>(der: &'a [u8], id: &[u8], found: &mut bool) -> &'a [u8] {
  found.* = false
  let t = tbs(der)
  let mut offset: usize = 0
  while offset < t.length {
    let e = readTlv(t, offset)
    if e.tag == 0 { break }
    if e.tag == 163 {
      let list = contents(t, e)
      let items = contents(list, readTlv(list, 0))
      let mut i: usize = 0
      while i < items.length {
        let item = readTlv(items, i)
        if item.tag == 0 { break }
        let fields = contents(items, item)
        let oid = readTlv(fields, 0)
        if same(contents(fields, oid), id) {
          let mut v = readTlv(fields, oid.end)
          if v.tag == 1 { v = readTlv(fields, v.end) }
          found.* = v.tag == 4
          return contents(fields, v)
        }
        i = item.end
      }
    }
    offset = e.end
  }
  return none()
}
const OID_BASIC_CONSTRAINTS: &[u8] = b"\x55\x1d\x13"
const OID_KEY_USAGE: &[u8] = b"\x55\x1d\x0f"
const OID_SAN: &[u8] = b"\x55\x1d\x11"
const OID_SKID: &[u8] = b"\x55\x1d\x0e"
const OID_AKID: &[u8] = b"\x55\x1d\x23"
const OID_CN: &[u8] = b"\x55\x04\x03"
const OID_EMAIL: &[u8] = b"\x2a\x86\x48\x86\xf7\x0d\x01\x09\x01"

// basicConstraints cA; keyUsage keyCertSign (bit 5).
fn isCa(der: &[u8], present: &mut bool) -> bool {
  let value = extensionValue(der, OID_BASIC_CONSTRAINTS, &mut present.*)
  if !present.* { return false }
  let fields = contents(value, readTlv(value, 0))
  let first = readTlv(fields, 0)
  return first.tag == 1 && first.length == 1 && fields[first.start] != 0
}
fn allowsCertSign(der: &[u8]) -> bool {
  let mut present = false
  let value = extensionValue(der, OID_KEY_USAGE, &mut present)
  if !present { return true }
  let bits = contents(value, readTlv(value, 0))
  return bits.length >= 2 && u8.bitAnd(bits[1], 4) != 0
}
fn selfIssued(der: &[u8]) -> bool { return same(issuer(der), subject(der)) }
// X509_check_ca(...) == 1, as Node reads it: basicConstraints with cA, and a key usage, if any,
// with keyCertSign.
fn checkCa(der: &[u8]) -> bool {
  let mut constraints = false
  let ca = isCa(der, &mut constraints)
  return constraints && ca && allowsCertSign(der)
}
// X509_check_issued(issuer, subject): names, key identifiers, and the issuer's key usage.
fn issuedBy(subjectDer: &[u8], issuerDer: &[u8]) -> bool {
  if !same(issuer(subjectDer), subject(issuerDer)) { return false }
  let mut hasAkid = false
  let akid = extensionValue(subjectDer, OID_AKID, &mut hasAkid)
  let mut hasSkid = false
  let skid = extensionValue(issuerDer, OID_SKID, &mut hasSkid)
  if hasAkid && hasSkid {
    let fields = contents(akid, readTlv(akid, 0))
    let first = readTlv(fields, 0)
    if first.tag == 128 && !same(contents(fields, first), contents(skid, readTlv(skid, 0))) { return false }
  }
  return allowsCertSign(issuerDer)
}

// Times: UTCTime and GeneralizedTime, as ASN1_TIME_print writes them.
fn digits(bytes: &[u8], at: usize, count: usize, ok: &mut bool) -> u32 {
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < count {
    if at + i >= bytes.length || bytes[at + i] < 48 || bytes[at + i] > 57 { ok.* = false return 0 }
    value = value * 10 + u8.toU32(bytes[at + i] - 48)
    i = i + 1
  }
  return value
}
fn timeOf(element: &[u8], time: &mut Instant) -> bool {
  let t = readTlv(element, 0)
  let v = contents(element, t)
  let mut ok = true
  let mut at: usize = 0
  let mut year: u32 = 0
  if t.tag == 23 && v.length == 13 { year = digits(v, 0, 2, &mut ok) year = if year < 50 { 2000 + year } else { 1900 + year } at = 2 }
  else if t.tag == 24 && v.length == 15 { year = digits(v, 0, 4, &mut ok) at = 4 }
  else { return false }
  if v[v.length - 1] != 90 { return false }
  let month = digits(v, at, 2, &mut ok) let day = digits(v, at + 2, 2, &mut ok)
  let hour = digits(v, at + 4, 2, &mut ok) let minute = digits(v, at + 6, 2, &mut ok) let second = digits(v, at + 8, 2, &mut ok)
  if !ok || month < 1 || month > 12 || day < 1 || day > 31 || hour > 23 || minute > 59 || second > 59 { return false }
  match Instant.fromUtcFields(u32.toI32(year), u32.toU8(month), u32.toU8(day), u32.toU8(hour), u32.toU8(minute), u32.toU8(second)) {
    Option<Instant>.Some { value } => { time.* = value }
    Option<Instant>.None => { return false }
  }
  return true
}

// Object identifiers: dotted text to DER content, and back through the object table.
fn dottedToDer(textInput: &[u8], out: &mut [u8; 64]) -> usize {
  let mut arcs: [u64; 32] = [0; 32]
  let mut count: usize = 0
  let mut current: u64 = 0
  let mut digitsSeen = false
  let mut i: usize = 0
  while i <= textInput.length {
    if i == textInput.length || textInput[i] == 46 {
      if !digitsSeen || count == 32 { return 0 }
      arcs[count] = current count = count + 1 current = 0 digitsSeen = false
    } else if textInput[i] >= 48 && textInput[i] <= 57 {
      current = current * 10 + u8.toU64(textInput[i] - 48) digitsSeen = true
    } else { return 0 }
    i = i + 1
  }
  if count < 2 || arcs[0] > 2 || arcs[0] < 2 && arcs[1] > 39 { return 0 }
  let mut length: usize = 0
  let mut index: usize = 1
  while index < count {
    let value = if index == 1 { arcs[0] * 40 + arcs[1] } else { arcs[index] }
    // Base 128, most significant group first.
    let mut groups: [u8; 10] = [0; 10]
    let mut n: usize = 0
    let mut rest = value
    while true { groups[n] = u64.toU8(rest % 128) n = n + 1 rest = rest / 128 if rest == 0 { break } }
    if length + n > 64 { return 0 }
    while n > 0 { n = n - 1 out[length] = if n > 0 { groups[n] + 128 } else { groups[n] } length = length + 1 }
    index = index + 1
  }
  return length
}
unsafe fn objectText(c: &mut Call, identifier: &[u8]) -> bool {
  let length = match move CertificateText.objectIdentifierLength(identifier) { Result<usize, CertificateTextError>.Success { value } => value Result<usize, CertificateTextError>.Failure { .. } => { return unsafe absent(&mut c.*) } }
  c.resultKind = 3
  if !unsafe reserve(&mut c.*, length) { return false }
  let mut a = ()
  return match move CertificateText.writeObjectIdentifier(identifier, unsafe output(&mut a, &c.*)) { Result<usize, CertificateTextError>.Success { .. } => true Result<usize, CertificateTextError>.Failure { .. } => false }
}
fn algorithmOid(algorithm: &[u8]) -> &[u8] { let inner = body(algorithm) return contents(inner, readTlv(inner, 0)) }
unsafe fn nameText(c: &mut Call, name: &[u8], format: NameTextFormat) -> bool {
  let length = match move CertificateText.nameLength(name, format) { Result<usize, CertificateTextError>.Success { value } => value Result<usize, CertificateTextError>.Failure { .. } => { return false } }
  c.resultKind = 3
  if !unsafe reserve(&mut c.*, length) { return false }
  let mut a = ()
  return match move CertificateText.writeName(name, format, unsafe output(&mut a, &c.*)) { Result<usize, CertificateTextError>.Success { .. } => true Result<usize, CertificateTextError>.Failure { .. } => false }
}

// Signatures: the digest and padding an AlgorithmIdentifier names.
const OID_RSA_PREFIX: &[u8] = b"\x2a\x86\x48\x86\xf7\x0d\x01\x01"
const OID_ECDSA_SHA1: &[u8] = b"\x2a\x86\x48\xce\x3d\x04\x01"
const OID_ECDSA_SHA2: &[u8] = b"\x2a\x86\x48\xce\x3d\x04\x03"
const OID_DSA_SHA1: &[u8] = b"\x2a\x86\x48\xce\x38\x04\x03"
const OID_NIST_SIGNATURE: &[u8] = b"\x60\x86\x48\x01\x65\x03\x04\x03"
const OID_NIST_HASH: &[u8] = b"\x60\x86\x48\x01\x65\x03\x04\x02"
fn startsWith(bytes: &[u8], prefix: &[u8]) -> bool { return bytes.length == prefix.length + 1 && same(Slice.view<u8>(bytes, 0, prefix.length), prefix) }
fn sha2Name(arc: u8) -> &'static [u8] {
  return if arc == 1 { b"sha256" } else if arc == 2 { b"sha384" } else if arc == 3 { b"sha512" } else if arc == 4 { b"sha224" }
    else if arc == 5 { b"sha512-224" } else if arc == 6 { b"sha512-256" } else if arc == 7 { b"sha3-224" } else if arc == 8 { b"sha3-256" }
    else if arc == 9 { b"sha3-384" } else if arc == 10 { b"sha3-512" } else { b"" }
}
// The scheme: digest name, padding (1 PKCS #1, 6 PSS, 0 other); false if unknown.
fn scheme(algorithm: &[u8], digest: &mut &'static [u8], padding: &mut i64) -> bool {
  let oid = algorithmOid(algorithm)
  padding.* = 0
  if same(oid, b"\x2b\x65\x70") || same(oid, b"\x2b\x65\x71") { digest.* = b"" return true }
  if same(oid, OID_ECDSA_SHA1) || same(oid, OID_DSA_SHA1) { digest.* = b"sha1" return true }
  if startsWith(oid, OID_ECDSA_SHA2) {
    let arc = oid[oid.length - 1]
    digest.* = if arc == 1 { b"sha224" } else if arc == 2 { b"sha256" } else if arc == 3 { b"sha384" } else { b"sha512" }
    return arc >= 1 && arc <= 4
  }
  if startsWith(oid, OID_NIST_SIGNATURE) {
    // DSA with SHA-224/256 (1, 2), ECDSA with SHA-3 (9-12), RSA with SHA-3 (13-16).
    let arc = oid[oid.length - 1]
    if arc == 1 { digest.* = b"sha224" return true } if arc == 2 { digest.* = b"sha256" return true }
    if arc >= 9 && arc <= 12 { digest.* = sha2Name(arc - 2) return true }
    if arc >= 13 && arc <= 16 { digest.* = sha2Name(arc - 6) padding.* = 1 return true }
    return false
  }
  if startsWith(oid, OID_RSA_PREFIX) {
    let arc = oid[oid.length - 1]
    padding.* = 1
    if arc == 4 { digest.* = b"md5" return true } if arc == 5 { digest.* = b"sha1" return true }
    if arc == 11 { digest.* = b"sha256" return true } if arc == 12 { digest.* = b"sha384" return true }
    if arc == 13 { digest.* = b"sha512" return true } if arc == 14 { digest.* = b"sha224" return true }
    if arc == 15 { digest.* = b"sha512-224" return true } if arc == 16 { digest.* = b"sha512-256" return true }
    if arc == 10 {
      // RSASSA-PSS: the hash of the parameters, SHA-1 when absent.
      padding.* = 6
      digest.* = b"sha1"
      let inner = body(algorithm)
      let parameters = readTlv(inner, readTlv(inner, 0).end)
      if parameters.tag == 48 {
        let fields = contents(inner, parameters)
        let first = readTlv(fields, 0)
        if first.tag == 160 {
          let hash = contents(fields, first)
          let id = algorithmOid(hash)
          if startsWith(id, OID_NIST_HASH) { digest.* = sha2Name(id[id.length - 1]) }
        }
      }
      return digest.length > 0
    }
  }
  return false
}
unsafe fn verifySigned(c: &Call, key: ?*mut u8, algorithm: &[u8], message: &[u8], signatureBytes: &[u8]) -> bool {
  let mut digest: &'static [u8] = b""
  let mut padding: i64 = 0
  if !scheme(algorithm, &mut digest, &mut padding) { return false }
  return unsafe keys.verifyWith(&c.*, key, digest, message, signatureBytes, padding)
}

// Identities: X509_check_host, X509_check_email, X509_check_ip_asc.
const ALWAYS_CHECK_SUBJECT: i64 = 1
const NO_WILDCARDS: i64 = 2
const NO_PARTIAL_WILDCARDS: i64 = 4
const MULTI_LABEL_WILDCARDS: i64 = 8
const NEVER_CHECK_SUBJECT: i64 = 32
fn lowerByte(b: u8) -> u8 { return if b >= 65 && b <= 90 { b + 32 } else { b } }
fn equalNoCase(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { if lowerByte(a[i]) != lowerByte(b[i]) { return false } i = i + 1 }
  return true
}
fn flagSet(flags: i64, flag: i64) -> bool { return i64.bitAnd(flags, flag) != 0 }
// A pattern with one `*` in its first label, at least two labels after it, and no partial
// wildcard when not allowed or in an IDNA label.
fn wildcardMatch(pattern: &[u8], host: &[u8], flags: i64) -> bool {
  if flagSet(flags, NO_WILDCARDS) { return false }
  let mut star: usize = pattern.length
  let mut firstDot: usize = pattern.length
  let mut dots: usize = 0
  let mut i: usize = 0
  while i < pattern.length {
    if pattern[i] == 42 { if star != pattern.length || firstDot != pattern.length { return false } star = i }
    if pattern[i] == 46 { if firstDot == pattern.length { firstDot = i } dots = dots + 1 }
    i = i + 1
  }
  if star == pattern.length || firstDot == pattern.length || dots < 2 { return false }
  let partial = star != 0 || star + 1 != firstDot
  if partial && flagSet(flags, NO_PARTIAL_WILDCARDS) { return false }
  if partial && firstDot >= 4 && equalNoCase(Slice.view<u8>(pattern, 0, 4), b"xn--") { return false }
  let prefix = Slice.view<u8>(pattern, 0, star)
  let suffix = Slice.view<u8>(pattern, star + 1, pattern.length - star - 1)
  if host.length < prefix.length + suffix.length { return false }
  if !equalNoCase(Slice.view<u8>(host, 0, prefix.length), prefix) || !equalNoCase(Slice.view<u8>(host, host.length - suffix.length, suffix.length), suffix) { return false }
  let middle = Slice.view<u8>(host, prefix.length, host.length - prefix.length - suffix.length)
  if !partial && middle.length == 0 { return false }
  let mut j: usize = 0
  while j < middle.length { if middle[j] == 46 && !flagSet(flags, MULTI_LABEL_WILDCARDS) { return false } j = j + 1 }
  return true
}
fn hostMatches(pattern: &[u8], host: &[u8], flags: i64) -> bool { return equalNoCase(pattern, host) || wildcardMatch(pattern, host, flags) }
fn emailMatches(pattern: &[u8], email: &[u8]) -> bool {
  if pattern.length != email.length { return false }
  let mut at: usize = email.length
  let mut i: usize = 0
  while i < email.length { if email[i] == 64 { at = i } i = i + 1 }
  i = 0
  while i < email.length { if i > at { if lowerByte(pattern[i]) != lowerByte(email[i]) { return false } } else if pattern[i] != email[i] { return false } i = i + 1 }
  return true
}
// Parses a textual IPv4 or IPv6 address; its length (4 or 16), or 0.
fn parseIp(textInput: &[u8], out: &mut [u8; 16]) -> usize {
  let mut colon = false
  let mut i: usize = 0
  while i < textInput.length { if textInput[i] == 58 { colon = true } i = i + 1 }
  if !colon {
    let mut part: u32 = 0 let mut count: usize = 0 let mut seen = false
    i = 0
    while i <= textInput.length {
      if i == textInput.length || textInput[i] == 46 {
        if !seen || count == 4 || part > 255 { return 0 }
        out[count] = u32.toU8(part) count = count + 1 part = 0 seen = false
      } else if textInput[i] >= 48 && textInput[i] <= 57 { part = part * 10 + u8.toU32(textInput[i] - 48) seen = true if part > 255 { return 0 } }
      else { return 0 }
      i = i + 1
    }
    return if count == 4 { 4 } else { 0 }
  }
  // IPv6: groups of hex digits, at most one `::`.
  let mut groups: [u32; 8] = [0; 8]
  let mut count: usize = 0
  let mut gap: usize = 9
  i = 0
  if textInput.length >= 2 && textInput[0] == 58 && textInput[1] == 58 { gap = 0 i = 2 }
  else if textInput.length > 0 && textInput[0] == 58 { return 0 }
  while i < textInput.length {
    let mut value: u32 = 0 let mut n: usize = 0
    while i < textInput.length && textInput[i] != 58 {
      let b = lowerByte(textInput[i])
      let digit = if b >= 48 && b <= 57 { u8.toU32(b - 48) } else if b >= 97 && b <= 102 { u8.toU32(b - 87) } else { return 0 }
      value = value * 16 + digit n = n + 1 i = i + 1
      if n > 4 { return 0 }
    }
    if n == 0 || count == 8 { return 0 }
    groups[count] = value count = count + 1
    if i < textInput.length {
      i = i + 1
      if i < textInput.length && textInput[i] == 58 { if gap != 9 { return 0 } gap = count i = i + 1 }
      else if i == textInput.length { return 0 }
    }
  }
  if gap == 9 && count != 8 || gap != 9 && count > 7 { return 0 }
  let mut full: [u32; 8] = [0; 8]
  let missing = 8 - count
  let mut g: usize = 0
  while g < count { let index = if gap != 9 && g >= gap { g + missing } else { g } full[index] = groups[g] g = g + 1 }
  g = 0
  while g < 8 { out[g * 2] = u32.toU8(full[g] / 256) out[g * 2 + 1] = u32.toU8(full[g] % 256) g = g + 1 }
  return 16
}
// Walks the subject alternative names of `kind` (1 email, 2 DNS, 7 IP): whether there are any,
// and the first one that matches.
fn sanMatch<'a>(der: &'a [u8], kind: u8, value: &[u8], flags: i64, any: &mut bool) -> &'a [u8] {
  any.* = false
  let mut present = false
  let san = extensionValue(der, OID_SAN, &mut present)
  if !present { return none() }
  let names = contents(san, readTlv(san, 0))
  let mut offset: usize = 0
  while offset < names.length {
    let n = readTlv(names, offset)
    if n.tag == 0 { break }
    if u8.bitAnd(n.tag, 31) == kind {
      any.* = true
      let candidate = contents(names, n)
      let matched = if kind == 2 { hostMatches(candidate, value, flags) } else if kind == 1 { emailMatches(candidate, value) } else { same(candidate, value) }
      if matched { return candidate }
    }
    offset = n.end
  }
  return none()
}
// The subject's attributes of type `id` that match.
fn subjectMatch<'a>(der: &'a [u8], id: &[u8], value: &[u8], flags: i64, email: bool) -> &'a [u8] {
  let name = body(subject(der))
  let mut offset: usize = 0
  while offset < name.length {
    let rdn = readTlv(name, offset)
    if rdn.tag == 0 { break }
    let set = contents(name, rdn)
    let mut i: usize = 0
    while i < set.length {
      let attribute = readTlv(set, i)
      if attribute.tag == 0 { break }
      let pair = contents(set, attribute)
      let oid = readTlv(pair, 0)
      if same(contents(pair, oid), id) {
        let candidate = contents(pair, readTlv(pair, oid.end))
        if if email { emailMatches(candidate, value) } else { hostMatches(candidate, value, flags) } { return candidate }
      }
      i = attribute.end
    }
    offset = rdn.end
  }
  return none()
}
unsafe fn checkIdentity(c: &mut Call, der: &[u8]) -> bool {
  let anchor = ()
  let value = keys.trimNull(unsafe arg(&anchor, &c.*, 1))
  let flags = c.numbers[2]
  let mut any = false
  if c.op == 113 {
    let mut address: [u8; 16] = [0; 16]
    let length = parseIp(value, &mut address)
    if length == 0 { c.resultKind = 1 c.result = -2 return true }
    let matched = sanMatch(der, 7, Slice.view<u8>(&address, 0, length), flags, &mut any)
    return if matched.length > 0 { unsafe text(&mut c.*, value) } else { unsafe absent(&mut c.*) }
  }
  let email = c.op == 112
  if value.length == 0 { c.resultKind = 1 c.result = -2 return true }
  let matched = sanMatch(der, if email { 1 } else { 2 }, value, flags, &mut any)
  if matched.length > 0 { return unsafe text(&mut c.*, if email { value } else { matched }) }
  if flagSet(flags, NEVER_CHECK_SUBJECT) || any && !flagSet(flags, ALWAYS_CHECK_SUBJECT) { return unsafe absent(&mut c.*) }
  let fromSubject = subjectMatch(der, if email { OID_EMAIL } else { OID_CN }, value, flags, email)
  if fromSubject.length > 0 { return unsafe text(&mut c.*, if email { value } else { fromSubject }) }
  return unsafe absent(&mut c.*)
}

// EC keys in a certificate: the point, and the curve's names.
fn curveNames(oid: &[u8], nist: bool) -> &'static [u8] {
  if same(oid, b"\x2a\x86\x48\xce\x3d\x03\x01\x07") { return if nist { b"P-256" } else { b"prime256v1" } }
  if same(oid, b"\x2b\x81\x04\x00\x22") { return if nist { b"P-384" } else { b"secp384r1" } }
  if same(oid, b"\x2b\x81\x04\x00\x23") { return if nist { b"P-521" } else { b"secp521r1" } }
  if same(oid, b"\x2b\x81\x04\x00\x21") { return if nist { b"P-224" } else { b"secp224r1" } }
  if same(oid, b"\x2a\x86\x48\xce\x3d\x03\x01\x01") { return if nist { b"P-192" } else { b"prime192v1" } }
  if same(oid, b"\x2b\x81\x04\x00\x0a") { return if nist { b"" } else { b"secp256k1" } }
  return b""
}

// SPKAC: base64 of SignedPublicKeyAndChallenge { PublicKeyAndChallenge { spki, challenge },
// algorithm, signature }.
unsafe fn spkac(c: &mut Call) -> bool {
  let anchor = ()
  let input = unsafe arg(&anchor, &c.*, 0)
  let compact = unsafe calloc(1, input.length + 1)
  let decoded = unsafe calloc(1, input.length + 1)
  if Pointer.isNull<u8>(compact) || Pointer.isNull<u8>(decoded) { unsafe free(compact) unsafe free(decoded) return false }
  let mut n: usize = 0
  let mut i: usize = 0
  while i < input.length { let b = input[i] if b != 32 && b != 10 && b != 13 && b != 9 { unsafe Pointer.put<u8>(unsafe at(compact, n), b) n = n + 1 } i = i + 1 }
  let mut a = () let mut b = ()
  let text64 = unsafe Pointer.borrowMany<(), u8>(&a, unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(compact)), n)
  let out = unsafe Pointer.borrowManyMut<(), u8>(&mut b, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(decoded)), input.length)
  let length = match move Base64.decodeInto(move out, text64) { Result<usize, Base64Error>.Success { value } => value Result<usize, Base64Error>.Failure { .. } => 0 }
  let der = unsafe Pointer.borrowMany<(), u8>(&anchor, unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(decoded)), length)
  let outer = readTlv(der, 0)
  let ok = if outer.tag != 48 || outer.end != der.length { if c.op == 117 { unsafe answer(&mut c.*, false) } else { unsafe absent(&mut c.*) } } else {
    let fields = contents(der, outer)
    let signed = whole(fields, 0)
    let algorithm = whole(fields, 1)
    let signatureBytes = bitString(contents(fields, child(fields, 2)))
    let inner = body(signed)
    let key = whole(inner, 0)
    if c.op == 119 {
      let challenge = child(inner, 1)
      if challenge.tag == 22 || challenge.tag == 12 || challenge.tag == 19 { unsafe text(&mut c.*, contents(inner, challenge)) } else { unsafe absent(&mut c.*) }
    } else {
      let handle = unsafe keys.publicFromSpki(key)
      let result = if Pointer.isNull<u8>(handle) { if c.op == 117 { unsafe answer(&mut c.*, false) } else { unsafe absent(&mut c.*) } }
        else if c.op == 117 { let valid = unsafe verifySigned(&c.*, handle, algorithm, signed, signatureBytes) unsafe answer(&mut c.*, valid) }
        else { unsafe pemOut(&mut c.*, b"PUBLIC KEY", key) }
      unsafe keys.release(handle)
      result
    }
  }
  unsafe free(compact) unsafe free(decoded)
  return ok
}
unsafe fn pemOut(c: &mut Call, label: &[u8], der: &[u8]) -> bool {
  let size = Pem.encodedLength(label.length, 0, der.length)
  c.resultKind = 3
  if !unsafe reserve(&mut c.*, size) { return false }
  let mut a = ()
  return match move Pem.encode(label, none(), der, unsafe output(&mut a, &c.*)) { Result<usize, PemError>.Success { value } => { c.length = value true } Result<usize, PemError>.Failure { .. } => false }
}

/// The certificate operations (100-124).
pub unsafe fn execute(c: &mut Call) -> bool {
  let op = c.op
  let anchor = ()
  if op == 100 { return unsafe create(&mut c.*) }
  if op >= 117 && op <= 119 { return unsafe spkac(&mut c.*) }
  if op == 120 { return unsafe failWith(&mut c.*, b"error:0308010C:digital envelope routines::unsupported") }
  if op == 121 {
    let name = keys.trimNull(unsafe arg(&anchor, &c.*, 0))
    let mut encoded: [u8; 64] = [0; 64]
    let length = dottedToDer(name, &mut encoded)
    let short = c.numbers[1] != 0
    let found = if length > 0 { CertificateText.objectName(Slice.view<u8>(&encoded, 0, length)) } else { CertificateText.namedObject(name) }
    return match move found {
      Option<ObjectName>.Some { value } => unsafe text(&mut c.*, if short { value.shortName } else { value.longName })
      Option<ObjectName>.None => unsafe text(&mut c.*, name)
    }
  }
  if op == 122 { let name = unsafe arg(&anchor, &c.*, 0) return unsafe nameText(&mut c.*, name, NameTextFormat.Rfc2253) }
  let second = c.numbers[1] != 0
  let other = c.other
  let der = unsafe derOf(&anchor, c.handle)
  if op == 101 { return unsafe emit(&mut c.*, der) }
  if op == 102 { return unsafe pemOut(&mut c.*, b"CERTIFICATE", der) }
  if op == 103 { return unsafe nameText(&mut c.*, if second { issuer(der) } else { subject(der) }, NameTextFormat.Multiline) }
  if op == 104 {
    let validity = body(tbsField(der, 3))
    let element = whole(validity, if second { 1 } else { 0 })
    let mut time = Instant.epoch()
    if !timeOf(element, &mut time) { return unsafe text(&mut c.*, b"Bad time value") }
    let mut out: [u8; 24] = [0; 24]
    let n = CertificateText.writeTime(time, &mut out)
    return unsafe text(&mut c.*, Slice.view<u8>(&out, 0, n))
  }
  if op == 105 {
    let code = algorithms.digestCode(unsafe arg(&anchor, &c.*, 1))
    if code == 0 { return false }
    let length = algorithms.digestLength(code)
    let mut state = algorithms.newDigest(code)
    algorithms.digestUpdate(&mut state, der)
    let mut out: [u8; 64] = [0; 64]
    algorithms.digestFinish(move state, Slice.viewMut<u8>(&mut out, 0, length))
    return unsafe emit(&mut c.*, Slice.view<u8>(&out, 0, length))
  }
  if op == 106 {
    let value = serial(der)
    let length = match move CertificateText.serialLength(value) { Result<usize, CertificateTextError>.Success { value: n } => n Result<usize, CertificateTextError>.Failure { .. } => { return false } }
    c.resultKind = 3
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut a = ()
    return match move CertificateText.writeSerial(value, unsafe output(&mut a, &c.*)) { Result<usize, CertificateTextError>.Success { .. } => true Result<usize, CertificateTextError>.Failure { .. } => false }
  }
  if op == 107 {
    let p = unsafe keys.publicFromSpki(spki(der))
    // X509_get_pubkey's failure.
    if Pointer.isNull<u8>(p) { return unsafe failWith(&mut c.*, b"error:03000072:digital envelope routines::decode error") }
    c.created = p c.createdKind = 4 c.resultKind = 2
    return true
  }
  if op == 108 { return unsafe answer(&mut c.*, checkCa(der)) }
  if op == 110 {
    let id = algorithmOid(signatureAlgorithm(der))
    if second { return unsafe objectText(&mut c.*, id) }
    return match move CertificateText.objectName(id) { Option<ObjectName>.Some { value } => unsafe text(&mut c.*, value.longName) Option<ObjectName>.None => unsafe absent(&mut c.*) }
  }
  if op >= 111 && op <= 113 { return unsafe checkIdentity(&mut c.*, der) }
  if op == 114 { return unsafe answer(&mut c.*, issuedBy(der, unsafe derOf(&anchor, other))) }
  if op == 115 {
    let mut out: [u8; 8192] = [0; 8192]
    let n = unsafe keys.spkiOfHandle(other, &mut out)
    return unsafe answer(&mut c.*, n > 0 && same(Slice.view<u8>(&out, 0, n), spki(der)))
  }
  if op == 116 {
    let valid = unsafe verifySigned(&c.*, other, signatureAlgorithm(der), tbsWhole(der), signature(der))
    return unsafe answer(&mut c.*, valid)
  }
  if op == 123 || op == 124 {
    let fields = body(spki(der))
    let algorithm = body(whole(fields, 0))
    let curve = contents(algorithm, child(algorithm, 1))
    if op == 123 { return unsafe emit(&mut c.*, bitString(contents(fields, child(fields, 1)))) }
    let name = curveNames(curve, second)
    return if name.length == 0 { unsafe absent(&mut c.*) } else { unsafe text(&mut c.*, name) }
  }
  return unsafe failWith(&mut c.*, b"")
}
