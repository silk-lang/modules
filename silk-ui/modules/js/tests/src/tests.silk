effect fn computedStyles(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  host.setStylesheetCompiler(runtimeStylesheets())
  let package = run platform.readFile(b"modules/js/packages/core/src/index.js")
  run host.define(b"@silkui/core", package.asSlice())
  run host.evaluate(b"if (__ui.computed(1, 'width') !== undefined) throw new Error('a host with no tree answered')", b"test")
  // Canvas fillStyle colors the 2D API cannot read itself, as getComputedStyle hands out themes.
  run host.evaluate(b"const g = () => [0, 1, 2, 3].map((i) => Math.round(__ui.geometry(i) * 255)).join(); if (__ui.canvas2dColor('oklch(97% 0 0)') !== 4 || g() !== '245,245,245,255') throw new Error('oklch: ' + g()); if (__ui.canvas2dColor('color-mix(in srgb, red 50%, blue)') !== 4 || g() !== '128,0,128,255') throw new Error('color-mix: ' + g()); if (__ui.canvas2dColor('var(--x)') !== 0) throw new Error('var() is not a color')", b"test")
  host.attach(tree.engineMut())
  let source = run platform.readFile(b"modules/js/tests/fixtures/computed-style.js")
  run host.module(source.asSlice(), b"computed-style.js")
  run host.evaluate(b"if (!globalThis.computedStyleChecked) throw new Error('the checks did not run')", b"test")
  let selectors = run platform.readFile(b"modules/js/tests/fixtures/selectors.js")
  run host.module(selectors.asSlice(), b"selectors.js")
  run host.evaluate(b"if (!globalThis.selectorsChecked) throw new Error('the selector checks did not run')", b"test")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
}

effect fn geometryReads(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let package = run platform.readFile(b"modules/js/packages/core/src/index.js")
  run host.define(b"@silkui/core", package.asSlice())
  host.attach(tree.engineMut())
  let source = run platform.readFile(b"modules/js/tests/fixtures/geometry.js")
  run host.module(source.asSlice(), b"geometry.js")
  let steps = [b"geometryAfterFrame(0)", b"geometryAfterFrame(1)", b"geometryAfterFrame(2)"]
  let mut i: usize = 0
  while i < 3 {
    run host.flush(&mut tree)
    drop run tree.frame(viewport(), usize.toF64(i))
    run host.observe(tree.engineMut())
    run host.evaluate(steps[i], b"test")
    i = i + 1
  }
  run host.evaluate(b"if (!globalThis.geometryChecked) throw new Error('the checks did not run')", b"test")
}

/// HTML elements from `@silkui/core` with @silkui/react's default stylesheet: inline
/// formatting from tags, and HTML attributes in selectors.
effect fn htmlElements(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  host.setStylesheetCompiler(runtimeStylesheets())
  let package = run platform.readFile(b"modules/js/packages/core/src/index.js")
  run host.define(b"@silkui/core", package.asSlice())
  let css = run platform.readFile(b"modules/js/packages/react/src/html.css")
  let mut module = List<u8>.make()
  run module.appendSlice(b"export default String.raw`")
  run module.appendSlice(css.asSlice())
  run module.appendSlice(b"`;")
  run host.define(b"html-css", module.asSlice())
  host.attach(tree.engineMut())
  let source = run platform.readFile(b"modules/js/tests/fixtures/html.js")
  run host.module(source.asSlice(), b"html.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run host.observe(tree.engineMut())
  run host.evaluate(b"htmlAfterFrame()", b"test")
  run host.evaluate(b"if (!globalThis.htmlChecked) throw new Error('the checks did not run')", b"test")
}

