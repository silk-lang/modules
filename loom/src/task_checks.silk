import silk.build.graph { BuildError }
import silk.cli.task { Task, TaskError }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import silk.num.usize
import src.task_support { build, pathText, rootPath }

pub effect fn packages() -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  run Task.silk(
    &[
      "check",
      "--no-server",
      "-p",
      "loom",
      "-p",
      "loom-demo",
      "-p",
      "loom-dom",
      "-p",
      "loom-dom-demo",
      "-p",
      "loom-examples",
      "-p",
      "loom-inspect",
      "-p",
      "loom-mirror",
      "-p",
      "loom-notes",
      "-p",
      "loom-tests",
      "-p",
      "loom-tree",
      "-p",
      "loom-window",
      "-p",
      "loom-window-tests",
      "-p",
      "loom-navigation",
      "-p",
      "loom-navigation-demo",
      "-p",
      "loom-components",
      "-p",
      "loom-components-demo",
      "-p",
      "loom-components-gallery",
      "-p",
      "loom-components-tests",
      "-p",
      "ui-inspect-devtools",
      "-p",
      "ui-devtools",
      "-p",
      "ui-inspect-devtools-tests",
      "-p",
      "silkui-window-loom",
      "-p",
      "silkui-web-canvas",
      "-p",
      "silkui-web-dom",
    ],
  )
  let portable = [
    "modules/loom",
    "modules/loom/examples",
    "modules/loom-navigation",
    "modules/loom-components",
    "modules/loom-components/gallery",
    "modules/devtools",
  ]
  let mut at: usize = 0
  while at < portable.length {
    let directory = run rootPath(portable[at])
    let manifest = run Path.join(&directory, "silk.toml")
    run Task.silk(
      &[
        "check",
        "--no-server",
        "--manifest-path",
        pathText(&manifest),
        "--target",
        "wasm32-unknown-unknown",
      ],
    )
    at = at + 1
  }
}

pub effect fn unitTests() -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let members = [
    "modules/loom/tests",
    "modules/loom/window/tests",
    "modules/loom-components/tests",
    "modules/loom-navigation/tests",
    "modules/devtools/tests",
  ]
  let mut at: usize = 0
  while at < members.length {
    let directory = run rootPath(members[at])
    let manifest = run Path.join(&directory, "silk.toml")
    run Task.silk(&["test", "--manifest-path", pathText(&manifest), "--root", "src/tests.silk"])
    at = at + 1
  }
}

pub effect fn goldens() -> ()
  ! BuildError
    | TaskError
    | ProcessError
    | FileError
    | HostInputError
    | OutOfMemoryError
    | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let members = ["modules/loom/tests", "modules/loom-components/tests", "modules/devtools/tests"]
  let mut at: usize = 0
  while at < members.length {
    let binary = run build(members[at], false, false)
    let directory = run rootPath(members[at])
    let golden = run Path.join(&directory, "goldens")
    run Task.exec(String.view(&binary), &[pathText(&golden)])
    at = at + 1
  }
}
