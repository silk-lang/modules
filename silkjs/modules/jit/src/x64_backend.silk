/// Bytes per SSA value slot and per ValueBits.
pub const SLOT_BYTES: u32 = 16
/// js_compiled.EXIT_*.
/// How many instructions after a method read the callee test that names its target is
/// looked for (knownRead): it follows the read at once unless the read was hoisted.
const EXIT_RETURNED: u32 = 0
const EXIT_DEOPT: u32 = 1
const EXIT_POLL: u32 = 2
const EXIT_THROW: u32 = 3
/// A block whose ways in leave R11 differently (Emitter.entrySlots).
const SLOTS_MIXED: u32 = 4294967294
const EXIT_CALL: u32 = 4
/// js_compiled.CompiledFrame.calls's offset (its seventh pointer).
const FRAME_CALLS: i32 = 48
/// CompiledFrame.code's offset (its eighth pointer).
const FRAME_CODE: i32 = 56
/// CompiledFrame.runtime's offset (its fourth pointer).
const FRAME_RUNTIME: i32 = 24
/// Frame words of one inlined callee: its CompiledFrame.
const INLINE_FRAME_WORDS: u32 = 9
/// More values than this would make the frame larger than is sensible for a first tier.
const MAX_VALUES: u32 = 65536
/// The typed array classes whose Int store typedStore makes before its integer views.
fn isFloatClass(classId: u32) -> bool {
  return classId == classes.JS_CLASS_FLOAT64_ARRAY || classId == classes.JS_CLASS_FLOAT32_ARRAY || classId == classes.JS_CLASS_UINT8C_ARRAY
}

/// Why a function was not lowered.
pub struct Unsupported { pub why: &'static [u8] }
/// Code: construct is the offset of frame mode's construct entry (x64_backend.construct), 0
/// for code of no frame; split carries the hot/cold boundary and cross-region relocations.
pub union Lowering { Code { pub value: Code, pub construct: u32, pub split: SplitInfo }, Unsupported { pub reason: Unsupported } }

/// Options of one lowering.
pub struct Settings {
  /// Every guard first counts down the i32 at `data` and fails when it reaches zero,
  /// resetting it to stress (the deopt-stress configuration). 0: off.
  pub stress: u32,
  /// Where the engine keeps a ValueBits' tag and payload.
  pub layout: ValueLayout,
  /// Print where each instruction's code starts ("jit: optimized map", the offsets in the
  /// order the SSA text lists the instructions), for joining samples with instructions.
  pub map: bool
}

/// The baseline frame that frame mode's code runs on.
pub struct FramePlan {
  pub f: BaselineLayout,
  /// baseline.extent: the record and the first cell from rbp, the frame's bytes below rbp.
  pub record: i32, pub cells: i32, pub below: i32,
  pub arguments: u32, pub locals: u32,
  /// Shape.copies, known, scoped, scopeSlots, scopeAt, codeWord, codeDelta, and constants layout.
  pub copies: bool, pub known: bool, pub scoped: bool, pub scopeSlots: u32, pub scopeAt: i32,
  pub codeWord: u32, pub codeDelta: u32,
  pub constantsWord: u32, pub constantsDelta: i32, pub constants: u32
}
impl Copy for FramePlan {}
fn signed(value: u32) -> i32 { return u32.wrappingToI32(value) }
impl FramePlan {
  pub fn of(base: BaselineLayout, shape: &Shape) -> FramePlan {
    let at = stubs.extent(&base, &shape)
    return FramePlan { f: base, record: at.record, cells: at.cells, below: at.below, arguments: shape.arguments, locals: shape.locals,
      copies: shape.copies, known: shape.known, scoped: shape.scoped, scopeSlots: shape.scopeSlots, scopeAt: 0 - at.below,
      codeWord: shape.codeWord, codeDelta: shape.codeDelta,
      constantsWord: shape.constantsWord, constantsDelta: signed(shape.constantsDelta), constants: shape.constants }
  }
  /// The plan of code for the compiled-entry ABI: no frame.
  fn none() -> FramePlan {
    return FramePlan { f: frames.layout(), record: 0, cells: 0, below: 0, arguments: 0, locals: 0, copies: false, known: false, scoped: false, scopeSlots: 0, scopeAt: 0, codeWord: 0, codeDelta: 0,
      constantsWord: u32.MAX, constantsDelta: 0, constants: 0 }
  }
  /// A field of the record, and of its StackFrame.
  pub fn rec(self: &Self, offset: u32) -> Mem { return Mem.at(Reg.Rbp, self.record + signed(offset)) }
  pub fn sf(self: &Self, offset: u32) -> Mem { return Mem.at(Reg.Rbp, self.record + signed(self.f.frame + offset)) }
  /// The rbp displacement of the frame's own argument cell, local and operand cell index.
  pub fn argumentAt(self: &Self, index: u32) -> i32 { return self.cells + signed(index * 16) }
  pub fn localAt(self: &Self, index: u32) -> i32 { return self.cells + signed((self.arguments + index) * 16) }
  pub fn operandAt(self: &Self, depth: u32) -> i32 { return self.cells + signed((self.arguments + self.locals + depth) * 16) }
}
/// A poll's slow path in frame mode: the engine's poll with the frame at pc, then back, or
/// to the exit when it threw or turned instruction observation on.
struct PollSlow { slow: Label, back: Label, exit: u32, pc: u32 }
impl Copy for PollSlow {}
/// Cold slow paths for an inline Op.CheckConstruct: epoch revalidation (coldSlow) and
/// interrupt polling (pollSlow), both preserving fragile GPRs and live XMM registers.
struct CheckConstructSlow { coldSlow: Label, pollSlow: Label, back: Label, sym: u32, exit: u32, pc: u32 }
impl Copy for CheckConstructSlow {}
/// Code kept out of the way of what usually runs (Emitter.outs), placed after the blocks:
/// it starts at `entry` and jumps `back`. `frame` is the Inst.frame it runs for.
struct Out { kind: u32, entry: Label, back: Label, frame: u32, inst: u32, base: Reg, at: i32, flags: u32 }
impl Copy for Out {}
/// An addInPlace's way for another shape (addHashed): where it starts, the add's end and
/// miss, the value added and the atom.
struct AddHash { entry: Label, back: Label, miss: Label, value: u32, atom: u32 }
impl Copy for AddHash {}
/// The last count of the ValueBits at `at` from `base`: R9 is its payload, whose count the
/// code already dropped. The release helper takes it from there.
const OUT_RELEASE: u32 = 1
/// The variable read of instruction `inst` through its helper.
const OUT_GET_VAR: u32 = 2
/// A keyed store that displaces the last count of the old value (put.field): `at` is the
/// slot's offset from R11, flags the PUT_* of the store.
const OUT_PUT_LAST: u32 = 3
/// The new value is in RAX and R9; the value's own count goes to the field.
const PUT_HELD: u32 = 1
const PUT_MOVED: u32 = 2

/// A deferred cold branch edge emitted after `markCold()` so a straight-line true fall-through
/// stays hot even when the false edge carries parallel moves.
struct ColdEdge { entry: Label, edge: u32 }
impl Copy for ColdEdge {}

/// Return codes of `equalsFast`: whether the comparison needs no cold slow path, a direct
/// `helpers.EQUALS` slow path (no tag-dispatch preamble), or the full generic `STEP_EQUALS_SLOW`.
const EQUALS_NO_SLOW: u32 = 0
const EQUALS_DIRECT_SLOW: u32 = 1
const EQUALS_GENERIC_SLOW: u32 = 2

/// Where the element a lowered access addresses is: at `base` (its address), or, for an
/// access that reads its Array's elements as a value (Op.Elements), at `base + r11 * 8`,
/// where `base` holds the elements and R11 twice the index.
struct Element { base: Reg, doubled: bool, disp: i32 }
impl Copy for Element {}
impl Element {
  /// The memory `d` bytes into the element.
  fn at(self: Self, d: i32) -> Mem {
    if self.doubled { return Mem.indexed(self.base, Reg.R11, Scale.Eight, d + self.disp) }
    return Mem.at(self.base, d + self.disp)
  }
}
/// An element whose address is in R11.
fn addressed() -> Element { return Element { base: Reg.R11, doubled: false, disp: 0 } }
/// An element `disp` bytes past R11.
fn addressedAt(disp: i32) -> Element { return Element { base: Reg.R11, doubled: false, disp: disp } }

/// A deferred slow path emitted after `markCold()` in frame mode: runs the helper / typed
/// fallback / getter / setter / quick-step / `stepOnFrame` sequence and jumps back to `back`.
struct StepSlow { entry: Label, auxLabel: Label, back: Label, inst: Inst, step: u32, shape: u32, out: u32, extra: u32, kind: u8 }
impl Copy for StepSlow {}
const STEP_PLAIN: u8 = 0
const STEP_GETTER: u8 = 1
const STEP_SETTER: u8 = 2
const STEP_SETTER_QUICK: u8 = 3
const STEP_PUT_FIELD_SLOW: u8 = 4
const STEP_SITE_PUT_FIELD: u8 = 5
const STEP_GET_FIELD_SLOW: u8 = 6
const STEP_GET_KEY_SLOW: u8 = 7
const STEP_PUT_KEY_SLOW: u8 = 8
const STEP_GET_LENGTH_SLOW: u8 = 9
const STEP_ELEM_SLOW: u8 = 10
const STEP_TRUTHY_SLOW: u8 = 11
const STEP_MATH_SLOW: u8 = 12
const STEP_EQUALS_SLOW: u8 = 13
const STEP_HELPER_SLOW: u8 = 14
const STEP_ADD_SLOW: u8 = 15
const STEP_GENERIC_DECLINED: u8 = 16
const STEP_CONSTRUCT_THREW: u8 = 17
const STEP_ARRAY_SLOW: u8 = 18
/// A method call with one argument whose callee is a String builtin: the engine answers
/// charCodeAt and charAt with no call (helpers.STRING_UNIT), else the call is made.
const STEP_UNIT_SLOW: u8 = 19

pub struct Emitter {
  pub a: Assembler,
  pub blockLabels: List<Label>,
  /// By block: past the `check.shape` that begins it, where the shape dispatch that proved
  /// the shape goes (armEntry).
  pub armLabels: List<Label>,
  pub exitLabels: List<Label>,
  /// Where each call resumes, in instruction order (resume point k + 1 is call k).
  pub resumeLabels: List<Label>,
  /// What each call saves in its call block (ssa_liveness.savedAcross): call k's values are
  /// savedValues[savedStart[k] .. savedStart[k + 1]].
  pub savedValues: List<u32>,
  pub savedStart: List<u32>,
  /// Bytes of the frame below the return address: values, then the edge scratch area.
  pub frame: i32,
  pub scratch: i32,
  /// The frame slots holding the six ABI inputs, from rsp.
  pub inputs: i32,
  pub settings: Settings,
  /// Where each value lives (x64_regalloc).
  pub places: Allocation,
  /// Where an object keeps its shape and slots (inline field access).
  fields: FieldLayout,
  /// Probed ConstructDesc/RuntimeState, Math native, and BytecodeClosure.homeObject offsets.
  construct: helpers.ConstructLayout,
  math: helpers.MathLayout,
  closureHome: u32,
  /// Bitmask of used allocatable XMM registers (bits 0..13 -> xmm2..xmm15).
  usedXmm: u32,
  /// Per value: its reads (operands, edge arguments, exit slots; an over-count only costs
  /// speed), the reads that take it as an immediate, and the instruction defining it or NONE.
  uses: List<u32>,
  /// What is lowered with no register for a value (regalloc.shortcuts), and whether a plain
  /// store found its element's address or its Int gone when it was lowered: the code is
  /// then not used.
  cuts: regalloc.Shortcuts,
  fault: bool,
  /// The number the instruction at `memFor` takes from the element at `memAt` (a folded
  /// unbox, regalloc.foldedUnbox), or NONE.
  memValue: u32,
  memFor: u32,
  memAt: Element,
  /// Where such an operation overflows: the piece that writes the number to its slot,
  /// undoes the operation when it ran in place (memUndo), and leaves.
  memLabels: List<Label>,
  memInsts: List<Inst>,
  memElements: List<Element>,
  memUndo: List<bool>,
  immediateUses: List<u32>,
  defs: List<u32>,
  /// Per value: its constant when a `const.i32` defines it.
  pub constants: List<Option<i32>>,
  /// The block being lowered: a jump to the next one falls through.
  current: u32,
  /// The instruction being lowered, and the one a label is bound after (NONE: none): where
  /// a get.elem that loaded its number itself skips its unbox (fusedUnbox).
  cursor: u32,
  skipAt: u32,
  skipLabel: Label,
  /// The code up to skipLabel is an outlined stretch (Assembler.beginOutlined), ended there.
  skipOut: bool,
  /// The instruction that emits nothing: a release whose count a store took (movedInto).
  dropAt: u32,
  /// By value: 1 + the inline target whose one closure the value is known to be, or 0
  /// (presets); and the exit of the callee test that proves it.
  preset: List<u32>,
  presetGuard: List<u32>,
  /// By value: the method a shape dispatch reads (bareDispatch), which takes no count.
  bare: List<bool>,
  /// By value: a method read whose shape dispatch (knownArms) writes nothing to its slot
  /// (armReads); by inline target: the slot past the scratch slots that holds the target's
  /// one closure from where the function begins, or NONE; and the exits that name an
  /// armed value inside an arm, with the arm's target (armExit).
  armed: List<bool>,
  armSlot: List<u32>,
  armSlots: u32,
  armX: List<u32>,
  armV: List<u32>,
  armK: List<u32>,
  /// `add.i32`/`sub.i32` done in place (result and first operand in one register): on
  /// overflow each jumps to its label here, where the operation is undone before the exit
  /// reads the operand.
  undoLabels: List<Label>,
  undoInsts: List<Inst>,
  /// mul.i32's tests for -0, out of line: where a zero product goes, where it comes back.
  zeroLabels: List<Label>,
  zeroBacks: List<Label>,
  zeroInsts: List<Inst>,
  /// Slow paths placed after the blocks (coldPieces): where each starts and goes back to,
  /// the instruction, and COLD_READ's unbox exit or COLD_STORE's box (NONE for none).
  coldLabels: List<Label>,
  coldBacks: List<Label>,
  coldInsts: List<Inst>,
  coldAux: List<u32>,
  /// Where the element a cold read reads is (a field read's slot is at its address).
  coldElements: List<Element>,
  /// Where the element of the access being lowered is (trustedSlot).
  element: Element,
  /// The index R11 holds twice of, for accesses through an Array's elements (Element.doubled),
  /// or NONE: kept over the instructions that leave R11 alone (r11Kept) and those accesses.
  scaled: u32,
  /// An instruction another one lowered already (a trusted read's unbox), or NONE.
  omitAt: u32,
  /// The `equals` (its instruction) that reads the variable cell at symbol `cellSymbol`
  /// where it is, instead of from the slot of the read before it (fusedEqualsVar), or NONE.
  cellFor: u32,
  cellSymbol: u32,
  /// The last trusted element read (its instruction, the object's storage and the index):
  /// where its element is (elementEl) holds after it, until something touches R11
  /// (reusesElement), or R9 too when that is the base.
  elementAt: u32,
  elementObject: u32,
  elementIndex: u32,
  /// Whether that read went on only with a number in the element (it was fused with its
  /// unbox, and anything else left): a store to the same element then replaces nothing
  /// counted (trustedStore).
  elementNumber: bool,
  /// Whether that number was an Int for certain (the unbox was of an Int): a store of an Int
  /// to the same element then leaves its tag as it is.
  elementInt: bool,
  elementEl: Element,
  /// Frame mode: last trusted fast-array value whose elements pointer is live in R9 and
  /// elementCount in EAX (NONE when invalid). Reset at every block and non-whitelisted inst.
  cachedArr: u32,
  /// Whether EAX holds cachedArr's count: an access proven in bounds loads the elements alone.
  cachedCount: bool,
  /// Frame mode: the value (by storage) whose own slots R11 holds, as a field read of it left
  /// them (NONE: none). It holds over the instructions that keep R11 and touch no object
  /// (keepsSlots) and over any that emits nothing, and into a block every way in leaves it
  /// (entrySlots). slotsHeld: what it was before the instruction being lowered.
  slotsValue: u32,
  slotsHeld: u32,
  /// The ways of the adds in place for other shapes (addHashed), after the blocks.
  addHashes: List<AddHash>,
  /// The slotsValue the known way of a method read kept, which its outlined read reloads
  /// before it joins at skipLabel (NONE: none).
  skipSlots: u32,
  /// Per block: the slotsValue its ways in agree on (SLOTS_MIXED when they do not), how many
  /// of its edges arrived so, and how many it has.
  entrySlots: List<u32>,
  slotArrivals: List<u32>,
  slotPreds: List<u32>,
  /// Indexes a trusted access of this block bounded (below an Array's count, so at most
  /// 2^31 - 2): adding 1 to one cannot overflow. Cleared at each block.
  bounded: List<u32>,
  boundedBlock: u32,
  /// The value the last operation left in RAX as it stored it to its slot, and the code
  /// offset just after: RAX still holds it while nothing more was emitted (raxHolds).
  raxValue: u32,
  /// The register that is: RAX, or R8 (an add next to counted element accesses).
  raxIn: Reg,
  raxOffset: usize,
  raxBlock: u32,
  /// The value whose i32 the flags describe as a compare with 0 would (an add, a sub or a
  /// bitwise operation that did not overflow), and the code offset after it (flagsHold).
  flagsValue: u32,
  flagsOffset: usize,
  flagsBlock: u32,
  /// Where the inlined callees' CompiledFrames start, from rsp: INLINE_FRAME_WORDS words each.
  inlineFrames: i32,
  /// The closure value each inlined callee's `inline.frame` names, by frame number less one.
  inlineClosures: List<u32>,
  /// Whether inline target k is a known local FunctionBytecode (ssa.TARGET_KNOWN_FN).
  knownFns: List<bool>,
  /// Whether inline target k's body reads the scope it runs under (ssa.Function.inlineScoped):
  /// the scope of its level on the frame's own chain.
  scopedFns: List<bool>,
  /// Inst.frame of the instruction being lowered: whose frame, code and closure it runs for.
  frameOf: u32,
  /// Frame mode, and the frame.
  pub on: bool,
  pub plan: FramePlan,
  /// Frame mode: the pcs of the method calls (OP_call_method), whose receiver is an operand.
  methods: List<u32>,
  /// Frame mode: the constant keys of field sites and what is known of their objects.
  shapes: Shapes,
  polls: List<PollSlow>,
  checkConstructSlows: List<CheckConstructSlow>,
  outs: List<Out>,
  stepSlows: List<StepSlow>,
  coldEdges: List<ColdEdge>,
  /// Frame mode: where the prologue goes when the native stack has no room.
  overflow: Label,
  /// Frame mode: the construct entry's offset before placing (frameTails), and where it
  /// joins the prologue (enter).
  constructAt: u32,
  entered: Label,
  /// Frame mode: the prologue's out-of-line arguments copy (fewer passed than declared), and
  /// where it rejoins the prologue.
  copying: Label,
  prologued: Label,
  /// Frame mode: a return's out-of-line ends, for a frame that copied its arguments and for
  /// one whose StackFrame was linked (built) while it ran.
  leaveOwn: Label,
  leaveBuilt: Label,
  /// Frame mode: each exit's stub past the instruction that says it is a plain deopt; a call
  /// or a poll jumps here with how it left in ecx (x64_frame_exit.HOW_*).
  pub exitWith: List<Label>,
  /// Each exit's record among the tables (x64_exits binds them).
  pub records: List<Label>,
  /// Frame mode, by instruction: baseline.stepAlone of the bytecode instruction the
  /// interpreter may run for it on the frame (stepOnFrame), or 0.
  steps: List<u32>,
  /// Frame mode: the slot of the function's realm, from rsp (kept for the polls).
  realmAt: i32,
  /// Frame mode: where the area for exits that leave inlined bodies part way through starts,
  /// from rsp, and its bytes (0: the function has no such exit).
  pub leaveAt: i32,
  pub leaveBytes: u32,
  /// Frame mode: where the operand cells of a call inside an inlined body are, from rsp
  /// (the receiver's, the function's, then the arguments'), and where the records of the
  /// bodies around such a call start, outermost first: each the baseline record's bytes,
  /// then its frame pointer word and a word of padding.
  callAt: u32,
  bodyAt: u32,
  /// Frame mode, by value: the value whose slot holds its bits. A copy (`retain`, a read
  /// ssa_shapes found to repeat an earlier one) has no slot of its own: its source's def
  /// dominates it and a slot is written only where its value is defined, so the source's
  /// slot holds the copy's bits wherever the copy is read. What the copy owns stays its own.
  pub stored: List<u32>,
  /// Frame mode, by value: whether another value aliases this value's slot via `stored`.
  aliased: List<bool>,
  /// Frame mode, by value: whether only the exits of the instructions right after its maker
  /// read its slot (lazyStores). Its maker leaves it in RAX and R9 only (storeFresh) and
  /// those exits' stubs store it from there.
  lazy: List<bool>,
  /// By exit: the lazy value its stub stores from RAX and R9 before anything else, or NONE.
  pub lazyExits: List<u32>,
  /// The lazy value whose maker left its slot alone (storeFresh), or NONE.
  unstored: u32,
  /// Frame mode: the value whose first word is in RAX and payload in R9 at code offset
  /// freshAt with freshBinds labels bound (setFresh), for the next instruction to read
  /// there instead of the slot (isFresh).
  fresh: u32,
  freshAt: usize,
  freshBinds: usize,
  /// The register a `check.shape` that tested its object's shape left the object in, for a
  /// `check.watched` of it right after.
  checkedIn: Reg,
  /// The `cmp` whose flags are still those of its compare at code offset condAt with
  /// condBinds labels bound (a bool the setcc made for its other readers): a branch on it
  /// jumps on them.
  condValue: u32,
  condAt: usize,
  condBinds: usize,
  /// The variable cells read by address (Function.ownedCells): entry n's symbol follows the
  /// inline targets' symbols.
  ownedCells: List<u32>,
  /// The atoms whose string cells frame mode's code links (Function.linkedAtoms).
  atoms: List<u32>,
}

pub fn slotOf(v: u32) -> Mem { return Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES)) }
/// The second word of a value's slot: a ValueBits' payload.
pub fn payloadOf(v: u32) -> Mem { return Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES + 8)) }
pub fn word(base: Reg, offset: u32) -> Mem { return Mem.at(base, u32.wrappingToI32(offset)) }

/// Lowers function, which must be compacted and verified.
/// The most slots armReads can give inline targets' closures: one per target an
/// inlined frame of a field read's value is for.
fn dominatesBlock(idom: &List<u32>, a: u32, b: u32) -> bool {
  let mut x = b
  let mut n: u32 = 0
  while x > a && x != NONE && u32.toUsize(x) < idom.length() && n < 100000 { let up = idom.get(u32.toUsize(x)) if up == x { return false } x = up n = n + 1 }
  return x == a
}
fn armSlotsOf(function: &Function) -> u32 {
  let mut count: u32 = 0
  let targets = function.inlineTargets.length()
  let mut k: usize = 0
  while k < targets {
    let mut i: usize = 0
    let mut found = false
    while !found && i < function.insts.length() {
      let inst = function.insts.get(i)
      if inst.op == Op.InlineFrame && i32.toUsize(inst.k) == k && inst.a < function.valueCount() {
        let def = function.value(inst.a).def
        if def != NONE && function.inst(def).op == Op.GetField { found = true }
      }
      i = i + 1
    }
    if found { count = count + 1 }
    k = k + 1
  }
  return count
}
pub effect fn lower(function: &Function, settings: Settings) -> Lowering ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  return run lowerIn(&function, move settings, false, FramePlan.none(), List<u32>.make(), Shapes.none(), List<u32>.make())
}
/// lower in frame mode: for the baseline frame of plan. code is the function's bytecode. The
/// code's symbols: 0 to STUB_COUNT - 1 the shared stubs, then the `moved` and `finish` tails,
/// the entry of the function's baseline code, its `stepEnded` tail and its construct entry,
/// then the inline targets (FRAME_SYMBOLS on). The code has a construct entry of its own
/// (Lowering.Code.construct).
/// Whether inst reads its second operand, when that is a constant, as an immediate.
fn immediateOperand(function: &Function, inst: Inst) -> bool {
  let op = inst.op
  if op == Op.Add || op == Op.Sub || op == Op.Cmp || op == Op.BitAnd || op == Op.BitOr || op == Op.BitXor
    || op == Op.Shl || op == Op.Sar || op == Op.Shr { return true }
  if op == Op.Mul {
    let def = function.value(inst.b).def
    return def != NONE && function.inst(def).op == Op.ConstI32 && function.inst(def).k > 0
  }
  return false
}
/// The constant when it is positive, else 0.
fn positiveConstant(constant: Option<i32>) -> i32 {
  return match constant { Option<i32>.Some { value } => if value > 0 { value } else { 0 } Option<i32>.None => 0 }
}
/// By instruction: for an `equals` one of whose operands an unbox that dominates it proved an
/// Int, that unbox's number (NONE for any other instruction; empty when there is none). The
/// operand is the unboxed value or shares its slot (a copy, or a read of the same field that
/// ssa_shapes found it still holds): `this.state & HELD` and then `this.state == RUNNABLE`.
/// The test then compares the number with the other operand's when that is an Int too, before
/// anything else (equalsFlags); the number is read there, so `uses` counts it once more and
/// the allocation keeps it (Shortcuts.keeps).
effect fn knownInts(function: &Function, shapes: &Shapes, uses: &mut List<u32>) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut keeps = List<u32>.make()
  let mut any = false
  let mut numbers = false
  let mut i: usize = 0
  while i < function.insts.length() {
    let op = function.insts.get(i).op
    if op == Op.Equals { any = true } else if op == Op.Unbox { numbers = true }
    i = i + 1
  }
  if !any || !numbers { return move keeps }
  let values = function.valueCount()
  // As Emitter.stored: the value whose slot holds each value's bits.
  let mut stored = List<u32>.make()
  let mut v: u32 = 0
  while v < values { run stored.append(v) v = v + 1 }
  // The first plain unbox of what each slot holds: its instruction, or NONE.
  let mut unboxAt = List<u32>.make()
  run unboxAt.appendRepeated(NONE, u32.toUsize(values))
  i = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    let mut from = NONE
    if inst.op == Op.Retain { from = inst.a }
    else if inst.op == Op.GetField { from = shapes.sameAs(usize.toU32(i)) }
    if from != NONE && from < values && inst.result != NONE && inst.result < values {
      let source = stored.get(u32.toUsize(from))
      stored.set(u32.toUsize(inst.result), source)
    }
    if inst.op == Op.Unbox && inst.k == 0 && inst.result != NONE && inst.a < values {
      let held = u32.toUsize(stored.get(u32.toUsize(inst.a)))
      if unboxAt.get(held) == NONE { unboxAt.set(held, usize.toU32(i)) }
    }
    i = i + 1
  }
  let mut idom = List<u32>.make()
  i = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    i = i + 1
    if inst.op != Op.Equals || inst.result == NONE || inst.a >= values || inst.b >= values { continue }
    let mut at = unboxAt.get(u32.toUsize(stored.get(u32.toUsize(inst.a))))
    if at == NONE { at = unboxAt.get(u32.toUsize(stored.get(u32.toUsize(inst.b)))) }
    if at == NONE || u32.toUsize(at) >= i - 1 { continue }
    let unbox = function.inst(at)
    if unbox.block != inst.block {
      if idom.length() == 0 { idom = run dominators(&function) }
      let mut x = inst.block
      while x != NONE && x > unbox.block { x = idom.get(u32.toUsize(x)) }
      if x != unbox.block { continue }
    }
    if keeps.length() == 0 { run keeps.appendRepeated(NONE, function.insts.length()) }
    keeps.set(i - 1, unbox.result)
    let before = uses.get(u32.toUsize(unbox.result))
    uses.set(u32.toUsize(unbox.result), before + 1)
  }
  return move keeps
}
pub effect fn lowerOnFrame(function: &Function, settings: Settings, plan: FramePlan, code: &[u8], shapes: Shapes) -> Lowering ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut methods = List<u32>.make()
  let mut i: usize = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    if inst.op == Op.Call && inst.frame == 0 && u32.toUsize(inst.pc) < code.length && code[u32.toUsize(inst.pc)] == opcodes.OP_call_method { run methods.append(inst.pc) }
    i = i + 1
  }
  // What the interpreter may run on the frame for the code: an instruction without a
  // template (a generic call) and a site that left compiled code before.
  let closureHome = baseline_env.closureHomeOffset()
  let mut steps = List<u32>.make()
  run steps.appendRepeated(0, function.insts.length())
  i = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    let mut wanted = false
    if inst.frame == 0 && inst.exit != NONE {
      if inst.op == Op.GetField || inst.op == Op.GetLength { wanted = (inst.k & FIELD_STEPS) != 0 }
      else if inst.op == Op.GetElem || inst.op == Op.GetKey { wanted = inst.k == ELEM_STEPS }
      else if inst.op == Op.PutField || inst.op == Op.PutKey { wanted = true }
      else if inst.op == Op.Call {
        wanted = (inst.k & calls.GENERIC) != 0 || calls.kindOf(inst) != compiled.SITE_CALL
        // A concatenation into a local (add_loc) leaves when it declines.
        if calls.kindOf(inst) == compiled.SITE_ADD && u32.toUsize(inst.pc) < code.length && code[u32.toUsize(inst.pc)] == opcodes.OP_add_loc { wanted = false }
      }
    }
    if wanted { steps.set(i, stepFor(&function, inst, code, plan.known, closureHome)) }
    i = i + 1
  }
  return run lowerIn(&function, move settings, true, plan, move methods, move shapes, move steps)
}
/// baseline.stepAlone of the bytecode instruction of inst, when the code can have it stepped
/// on its frame: the depths fit a step's shape, and a generic call's values are where the
/// instruction leaves them. 0 otherwise.
/// In a step entry (Emitter.steps): the engine may make the instruction without the
/// interpreter (js_baseline.SERVICE_QUICK), on its operand cells alone.
const STEP_QUICK: u32 = 0x80000000
const STEP_GET_PRIVATE: u32 = 0x40000000
const STEP_PUT_PRIVATE: u32 = 0x20000000
const STEP_HOME_OBJECT: u32 = 0x10000000
fn stepFor(function: &Function, inst: Inst, code: &[u8], known: bool, closureHome: u32) -> u32 {
  let mut step = stubs.stepAlone(code, u32.toUsize(inst.pc))
  if step == 0 { return 0 }
  let opcode = code[u32.toUsize(inst.pc)]
  if inst.op == Op.Call && (inst.k & calls.GENERIC) != 0 {
    if opcode == opcodes.OP_object || opcode == opcodes.OP_define_field || opcode == opcodes.OP_set_proto
      || opcode == opcodes.OP_array_from || opcode == opcodes.OP_rest || opcode == opcodes.OP_regexp
      || opcode == opcodes.OP_fclosure8 || opcode == opcodes.OP_fclosure { step = step | STEP_QUICK }
    else if opcode == opcodes.OP_get_private_field { step = step | STEP_GET_PRIVATE }
    else if opcode == opcodes.OP_put_private_field { step = step | STEP_PUT_PRIVATE }
    else if opcode == opcodes.OP_special_object && (step & 65535) == 2 && u32.toUsize(inst.pc) + 1 < code.length && code[u32.toUsize(inst.pc) + 1] == 4 && !known && closureHome != u32.MAX {
      step = step | STEP_HOME_OBJECT
    }
  }
  if (inst.op == Op.PutField || (inst.op == Op.Call && calls.kindOf(inst) == compiled.SITE_PUT_FIELD)) && opcode == opcodes.OP_put_field { step = step | STEP_QUICK }
  if inst.op == Op.PutKey && opcode == opcodes.OP_put_array_el { step = step | STEP_QUICK }
  let before = function.exit(inst.exit).stackDepth
  let after = u32.wrappingToI32(before) + u32.wrappingToI32(u32.shiftRight(step, 16) & 255) - 128
  if before > 255 || after < 0 || after > 255 || inst.pc + (step & 65535) >= 16777216 { return 0 }
  if inst.op == Op.Call && (inst.k & calls.GENERIC) != 0 {
    let count = u32.wrappingToI32(calls.countOf(inst))
    let base = u32.wrappingToI32(before) - count
    let results = calls.resultCount(inst.k)
    if base < 0 || after < base { return 0 }
    if results == 0 { if after - base > 1 { return 0 } }
    else if after - base != results { return 0 }
  }
  return step
}
/// The symbols of frame mode's code after the shared stubs: the baseline code's `moved` tail
/// (MARK_MOVED), its `finish` tail (MARK_FINISH) and its entry; the inline targets follow.
pub const SYMBOL_MOVED: u32 = stubs.STUB_COUNT
pub const SYMBOL_FINISH: u32 = stubs.STUB_COUNT + 1
pub const SYMBOL_BASELINE: u32 = stubs.STUB_COUNT + 2
/// Where its steps' nonzero answers go (MARK_STEP_ENDED).
pub const SYMBOL_STEP_ENDED: u32 = stubs.STUB_COUNT + 3
/// The baseline code's construct entry (MARK_CONSTRUCT).
pub const SYMBOL_BASELINE_CONSTRUCT: u32 = stubs.STUB_COUNT + 4
pub const FRAME_SYMBOLS: u32 = stubs.STUB_COUNT + 5

