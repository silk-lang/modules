      if self.isPreset(inst.a) || self.isBare(inst.a) { return () }
      let heap = (self.shapes.fact(self.cursor) & FACT_OBJECT) != 0
      run self.releaseAt(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES), heap)
      return ()
    }
    if op == Op.UnboxF64 {
      // A Float64 is its payload bits (tested first, loaded straight to XMM when possible);
      // an Int converts exactly (cvtsi2sd of the signed i32).
      run self.stressGuard(inst.exit)
      let layout = self.settings.layout
      let notFloat = run self.a.label()
      let done = run self.a.label()
      let place = self.at(inst.result)
      if layout.tagWidth == 1 {
        run self.a.cmp8MemImm(Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)), u32.wrappingToU8(layout.float64()))
        run self.a.jcc(Cond.NotEqual, notFloat)
      } else {
        run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)))
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
        run self.a.jcc(Cond.NotEqual, notFloat)
      }
      if place.kind == XMM {
        run self.a.loadDouble(place.xmm, payloadOf(inst.a))
      } else {
        run self.a.load(Width.W64, Reg.Rax, payloadOf(inst.a))
        run putBits(&mut self.a, place, Reg.Rax)
      }
      run self.a.jmp(done)
      self.a.bind(notFloat)
      if layout.tagWidth == 1 {
        run self.a.cmp8MemImm(Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)), u32.wrappingToU8(layout.int()))
        run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
      } else {
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
        run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
      }
      run self.a.load(Width.W32, Reg.Rax, payloadOf(inst.a))
      if place.kind == XMM {
        run self.a.intToDouble(Width.W32, place.xmm, Reg.Rax)
      } else {
        run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
        run putF64(&mut self.a, place, Xmm.Xmm0)
      }
      self.a.bind(done)
      return ()
    }
    if op == Op.BoxF64 {
      // The trusted store right after it boxes into the element itself (storedBox).
      if self.storedBox(&function, self.cursor) { return () }
      let place9 = self.at(inst.a) run getBits(&mut self.a, Reg.Rax, place9)
      run self.boxDoubleInto(Reg.Rax, Reg.Rsp, inst.result * SLOT_BYTES)
      return ()
    }
    if (op == Op.BitAnd || op == Op.BitOr || op == Op.BitXor || op == Op.Shl || op == Op.Sar || op == Op.Shr) && inst.b != NONE {
      if let Option<i32>.Some { value } = self.constants.get(u32.toUsize(inst.b)) { run self.withImmediate(inst, value) return () }
    }
    if op == Op.ModF64 {
      let left = self.at(inst.a) let right = self.at(inst.b) let out = self.at(inst.result)
      run getBits(&mut self.a, Reg.Rsi, left)
      run getBits(&mut self.a, Reg.Rdx, right)
      run self.callHelper(helpers.MOD_F64)
      run putBits(&mut self.a, out, Reg.Rax)
      return ()
    }
    // An ordered double compare whose only reader is the branch right after it is that
    // branch's flags.
    if op == Op.CmpF64 && self.fusedCompare(&function, inst) { return () }
    if op == Op.ToInt32 {
      // The conversion of a double outside int64 is out of line (zeroInsts).
      let slow = run self.a.label()
      let back = run self.a.label()
      let left = self.at(inst.a) let out = self.at(inst.result)
      run float.toInt32Fast(&mut self.a, left, out, slow, back)
      run self.zeroLabels.append(slow) run self.zeroBacks.append(back) run self.zeroInsts.append(inst)
      return ()
    }
    if isNumberOp(op) || op == Op.ConstF64 {
      let mut exit = self.blockLabels.get(0)
      if inst.exit != NONE { run self.stressGuard(inst.exit) exit = self.exitLabels.get(u32.toUsize(inst.exit)) }
      let mut right = regalloc.spilled(slotOf(0)) let mut out = regalloc.spilled(slotOf(0)) let mut left = regalloc.spilled(slotOf(0))
      if inst.b != NONE && numberOpReadsB(inst.op) { right = self.at(inst.b) }
      if inst.a != NONE && inst.op != Op.ConstF64 { left = self.at(inst.a) }
      if inst.result != NONE { out = self.at(inst.result) }
      run float.lowerNumber(&mut self.a, &function, inst, left, right, out, exit)
      return ()
    }
    if op == Op.Poll && self.on {
      // The realm's interrupt counter, as baseline code's back edges charge it; the engine's
      // poll when it runs out (frameTails).
      let p = self.plan
      let slow = run self.a.label()
      let back = run self.a.label()
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsp, self.realmAt))
      run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rax, signed(p.f.interruptCounter)), 1)
      run self.a.jcc(Cond.LessOrEqual, slow)
      self.a.bind(back)
      run self.polls.append(PollSlow { slow: slow, back: back, exit: inst.exit, pc: function.exit(inst.exit).pc })
      return ()
    }
    if op == Op.Poll {
      run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rdx, 0), 1)
      run self.a.jcc(Cond.LessOrEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
      return ()
    }
    if op == Op.Jump {
      let slots = self.slotsValue
      self.slotsEdge(&function, inst.edge, slots)
      run self.edge(&function, inst.edge)
      return ()
    }
    if op == Op.Branch {
      // taken: the condition under which the first (true) edge is followed.
      let mut taken = Cond.NotEqual
      let mut untaken = Cond.Equal
      let def = self.defs.get(u32.toUsize(inst.a))
      if def != NONE && self.fusedCompare(&function, function.inst(def)) {
        let compared = function.inst(def)
        if compared.op == Op.CmpF64 {
          let left = self.at(compared.a) let right = self.at(compared.b)
          taken = run float.compareDoublesFlags(&mut self.a, compared.k, left, right)
          // Below and BelowOrEqual hold for an unordered result: NaN takes the false edge.
          untaken = Cond.BelowOrEqual
          if taken == Cond.AboveOrEqual { untaken = Cond.Below }
        } else {
          run self.compare(&function, compared)
          taken = condition(compared.k) untaken = condition(opposite(compared.k))
        }
      } else if def != NONE && self.fusedEquals(&function, function.inst(def)) {
        run self.equalsFlags(&function, function.inst(def))
        taken = Cond.Equal untaken = Cond.NotEqual
        self.slotsValue = NONE
      } else if def != NONE && self.fusedCallee(&function, function.inst(def)) {
        let mut test = function.inst(def)
        test.a = self.storage(test.a)
        run self.calleeFlags(&function, test)
        taken = Cond.Equal untaken = Cond.NotEqual
        self.slotsValue = NONE
      } else if def != NONE && self.fusedTag(&function, function.inst(def)) {
        let test = function.inst(def)
        let layout = self.settings.layout
        let at = Mem.at(Reg.Rsp, u32.wrappingToI32(self.storage(test.a) * SLOT_BYTES + layout.tagOffset))
        let fresh = layout.tagWidth == 1 && layout.tagOffset == 0 && self.isFresh(self.storage(test.a))
        if (test.k & 7) == 3 {
          // Undefined and null are neighbours: one unsigned compare of the tag less the lower.
          let mut low = layout.null()
          if layout.undefined() < low { low = layout.undefined() }
          if fresh {
            // The tag is RAX's low byte: the difference's low byte is the tags' difference.
            run self.a.lea(Width.W32, Reg.R8, Mem.at(Reg.Rax, 0 - u32.wrappingToI32(low)))
            run self.a.cmp8Imm(Reg.R8, 1)
          } else {
            run self.loadTag(Reg.R8, at)
            run self.a.aluImm(Alu.Sub, Width.W32, Reg.R8, u32.wrappingToI32(low))
            run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, 1)
          }
          taken = Cond.BelowOrEqual untaken = Cond.Above
        } else {
          let mut tag = layout.undefined()
          if (test.k & 7) == 2 { tag = layout.null() }
          if (test.k & 7) == 4 { tag = layout.uninitialized() }
          if fresh && tag < 256 { run self.a.cmp8Imm(Reg.Rax, u32.wrappingToU8(tag)) }
          else if layout.tagWidth == 1 && tag < 256 { run self.a.cmp8MemImm(at, u32.wrappingToU8(tag)) }
          else { run self.loadTag(Reg.R8, at) run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(tag)) }
          taken = Cond.Equal untaken = Cond.NotEqual
        }
      } else if self.on && def != NONE && self.condValue == inst.a && self.a.offset() == self.condAt && self.a.bound() == self.condBinds {
        // The compare's flags, as it left them (condValue).
        let compared = function.inst(def)
        taken = condition(compared.k) untaken = condition(opposite(compared.k))
      } else {
        let place = self.at(inst.a)
        if place.kind == GPR { run self.a.test(Width.W32, place.gpr, place.gpr) }
        else { run self.a.load(Width.W32, Reg.Rax, slotOf(inst.a)) run self.a.test(Width.W32, Reg.Rax, Reg.Rax) }
      }
      // Both ways in leave R11 as the condition did (moves aside: slotsEdge).
      let mut slots = self.slotsValue
      if !self.moves(&function, inst.edge) && function.edge(inst.edge).target == self.current + 1 {
        // The latch's moves may run before the jumps (below): with a cycle, they take R11.
        let latch = self.through(&function, self.current + 1)
        if latch != NONE && self.movingArgs(&function, latch) > 1 { slots = NONE }
      }
      self.slotsEdge(&function, inst.edge, slots)
      self.slotsEdge(&function, inst.edge + 1, slots)
      // An edge without moves is a conditional jump straight to its block; when the true edge
      // falls through to the next block, jump on the false one instead (deferring its moves
      // out of line so the hot loop stays straight-line).
      if !self.moves(&function, inst.edge) && function.edge(inst.edge).target == self.current + 1 {
        let past = self.through(&function, self.current + 1)
        if past != NONE && (!self.moves(&function, past) || self.movesAbove(&function, past, inst.a)) {
          // A way into the latch's target that no edge counts, past the latch's moves.
          self.slotsArrive(function.edge(past).target, SLOTS_MIXED)
          // The next block only jumps on (a latch without a poll): one jump a turn, after
          // the latch's moves, which keep the flags and take nothing the other edge reads.
          run self.edgeMoves(&function, past)
          run self.a.jcc(taken, self.blockLabels.get(u32.toUsize(function.edge(past).target)))
          run self.edge(&function, inst.edge + 1)
          return ()
        }
        if !self.moves(&function, inst.edge + 1) {
          run self.a.jcc(untaken, self.blockLabels.get(u32.toUsize(function.edge(inst.edge + 1).target)))
        } else {
          let coldFalse = run self.a.label()
          run self.a.jcc(untaken, coldFalse)
          run self.coldEdges.append(ColdEdge { entry: coldFalse, edge: inst.edge + 1 })
        }
        return ()
      }
      if !self.moves(&function, inst.edge) {
        run self.a.jcc(taken, self.blockLabels.get(u32.toUsize(function.edge(inst.edge).target)))
        run self.edge(&function, inst.edge + 1)
        return ()
      }
      if !self.moves(&function, inst.edge + 1) {
        run self.a.jcc(untaken, self.blockLabels.get(u32.toUsize(function.edge(inst.edge + 1).target)))
        run self.edge(&function, inst.edge)
        return ()
      }
      let otherwise = run self.a.label()
      run self.a.jcc(untaken, otherwise)
      run self.edgeThen(&function, inst.edge, false)
      self.a.bind(otherwise)
      run self.edge(&function, inst.edge + 1)
      return ()
    }
    if op == Op.Return && self.on {
      // The owned result in rax:rdx. The local cells were never written; a frame that
      // copied its arguments drops them in STUB_LEAVE (leaveOwn). Otherwise it unlinks
      // here, as STUB_LEAVE does (baseline unlink), the built frame's end out of line.
      let p = self.plan
      run self.resultInto(&function, inst.a)
      if p.copies || p.scoped { run self.a.jmp(self.leaveOwn) return () }
      if p.arguments != 0 {
        run self.a.lea(Width.W64, Reg.R14, Mem.at(Reg.Rbp, p.argumentAt(0)))
        run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R14, p.sf(p.f.argumentsData))
        run self.a.jcc(Cond.Equal, self.leaveOwn)
      }
      run self.a.aluStoreImm(Alu.Cmp, Width.W64, p.rec(p.f.state), u64.wrappingToI32(frames.FRAME_BARE_CONSTRUCT))
      run self.a.jcc(Cond.Above, self.leaveBuilt)
      run self.a.load(Width.W64, Reg.Rbx, p.rec(p.f.spare))
      run self.a.mov(Width.W64, Reg.Rsp, Reg.Rbp)
      run self.a.pop(Reg.Rbp)
      run self.a.ret()
      return ()
    }
    if op == Op.Return {
      // state[0..1]: the owned result; state[2]: the bytecode offset of the return.
      run self.valueInto(&function, inst.a, SlotMode.Move, Reg.Rsi, 0)
      run self.a.movImm32(Reg.Rax, inst.pc)
      run self.a.store(Width.W64, Mem.at(Reg.Rsi, 16), Reg.Rax)
      run self.leave(EXIT_RETURNED)
      return ()
    }
    if op == Op.This {
      // The receiver cell named by CompiledFrame.thisValue (offset 0), copied (borrowed); in
      // frame mode the frame's own (StackFrame.thisValue, as passed).
      if self.on {
        let p = self.plan
        run self.a.lea(Width.W64, Reg.R8, p.sf(p.f.thisValue))
      } else {
        let at = self.input(INPUT_FRAME)
        run self.a.load(Width.W64, Reg.R8, at)
        run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R8, 0))
      }
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R8, 0))
      run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      return ()
    }
    if op == Op.TagIn {
      // r9 = whether the tag field is one of k's tags (compares, at most a few).
      let layout = self.settings.layout
      run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)))
      run self.a.movImm32(Reg.R9, 0)
      let yes = run self.a.label()
      let done = run self.a.label()
      let mut tag: i32 = -9
      while tag <= 8 {
        let field = layout.tagOf(tag)
        if u32.bitAnd(u32.shiftRight(i32.wrappingToU32(inst.k), i32.wrappingToU32(tag + 9)), 1) != 0 && field != u32.MAX {
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(field))
          run self.a.jcc(Cond.Equal, yes)
        }
        tag = tag + 1
      }
      run self.a.jmp(done)
      self.a.bind(yes)
      run self.a.movImm32(Reg.R9, 1)
      self.a.bind(done)
      let out = self.at(inst.result) run putI32(&mut self.a, out, Reg.R9)
      return ()
    }
    if op == Op.Truthy {
      // ToBoolean from the tag: Bool, Int, Object (non-falsy), FlatString (len != 0),
      // Null/Undefined (false), Float64 (unless +-0 or NaN) inline; Symbol/Rope/BigInt/falsy
      // object through STEP_TRUTHY_SLOW / TRUTHY helper. No exit.
      let layout = self.settings.layout
      let fields = self.fields
      let done = run self.a.label()
      let notBool = run self.a.label()
      let notInt = run self.a.label()
      let notObj = run self.a.label()
      let notStr = run self.a.label()
      let slow = run self.a.label()
      run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.boolean()))
      run self.a.jcc(Cond.NotEqual, notBool)
      run self.a.loadZero8(Reg.R9, payloadOf(inst.a))
      run self.a.aluImm(Alu.And, Width.W32, Reg.R9, 1)
      run self.a.jmp(done)
      self.a.bind(notBool)
      run self.a.movImm32(Reg.R9, 0)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
      run self.a.jcc(Cond.NotEqual, notInt)
      run self.a.aluStoreImm(Alu.Cmp, Width.W32, payloadOf(inst.a), 0)
      run self.a.setcc(Cond.NotEqual, Reg.R9)
      run self.a.jmp(done)
      self.a.bind(notInt)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.null()))
      run self.a.jcc(Cond.Equal, done)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.undefined()))
      run self.a.jcc(Cond.Equal, done)
      // Object: truthy unless marked falsy (htmlDda).
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
      run self.a.jcc(Cond.NotEqual, notObj)
      run self.a.load(Width.W64, Reg.R11, payloadOf(inst.a))
      run self.a.test8MemImm(Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)), u32.wrappingToU8(fields.falsy))
      run self.a.jcc(Cond.NotEqual, slow)
      run self.a.movImm32(Reg.R9, 1)
      run self.a.jmp(done)
      // FlatString (-7, never Rope -6): truthy iff low 31 bits of length word != 0.
      self.a.bind(notObj)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.tagOf(-7)))
      run self.a.jcc(Cond.NotEqual, notStr)
      run self.a.load(Width.W64, Reg.R11, payloadOf(inst.a))
      run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R11, signed(self.plan.f.stringLength)))
      run self.a.testImm(Width.W32, Reg.Rax, 0x7fffffff)
      run self.a.setcc(Cond.NotEqual, Reg.R9)
      run self.a.jmp(done)
      // Float64: bits << 1 drops the sign: 0 is +-0, above 0xFFE0000000000000 is NaN.
      self.a.bind(notStr)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
      run self.a.jcc(Cond.NotEqual, slow)
      run self.a.load(Width.W64, Reg.Rax, payloadOf(inst.a))
      run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rax, 1)
      run self.a.jcc(Cond.Equal, done)
      run self.a.movImm64(Reg.R10, 18437736874454810624)
      run self.a.alu(Alu.Cmp, Width.W64, Reg.Rax, Reg.R10)
      run self.a.jcc(Cond.Above, done)
      run self.a.movImm32(Reg.R9, 1)
      if self.on {
        run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: done, inst: inst, step: 0, shape: 0, out: NONE, extra: 0, kind: STEP_TRUTHY_SLOW })
      } else {
        run self.a.jmp(done)
        self.a.bind(slow)
        let symbol = layout.tagOf(-8)
        let heap = run self.a.label()
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(symbol))
        run self.a.jcc(Cond.NotEqual, heap)
        run self.a.movImm32(Reg.R9, 1)
        run self.a.jmp(done)
        self.a.bind(heap)
        run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
        run self.callHelper(helpers.TRUTHY)
        run self.a.mov(Width.W32, Reg.R9, Reg.Rax)
      }
      self.a.bind(done)
      let out = self.at(inst.result) run putI32(&mut self.a, out, Reg.R9)
      return ()
    }
    if op == Op.CheckShape {
      run self.stressGuard(inst.exit)
      self.lazyAt(inst.a, inst.exit)
      let fresh = self.isFresh(inst.a)
      let fact = self.shapes.fact(self.cursor)
      if (fact & FACT_SHAPE) == 0 {
        let layout = self.settings.layout
        let fields = self.fields
        let miss = self.exitLabels.get(u32.toUsize(inst.exit))
        if (fact & FACT_OBJECT) == 0 { run self.unlessTag(inst.a, layout.object(), miss) }
        let object = run self.objectIn(inst.a)
        // The shape in R8: RAX and R9 keep a fresh object for what follows and its exit.
        run self.a.load(Width.W64, Reg.R8, Mem.at(object, u32.wrappingToI32(fields.objectShape)))
        run self.a.aluStoreImm(Alu.Cmp, Width.W64, Mem.at(Reg.R8, u32.wrappingToI32(fields.shapeVersion)), inst.k)
        run self.a.jcc(Cond.NotEqual, miss)
        self.checkedIn = object
      }
      let arm = self.shapes.armAt(self.cursor)
      if fresh && arm == 0 && armShapeAt(&function, inst.block) != self.cursor { self.setFresh(inst.a) }
      if arm != 0 {
        // An arm's way in from anywhere but its dispatch: the dispatch's tests (that the
        // object is not exotic and the method's watched objects are), or the exit, so that
        // the arm has them either way (ssa_shapes.armTargets).
        let miss = self.exitLabels.get(u32.toUsize(inst.exit))
        let tested = self.shapes.testedAt(self.cursor)
        if (tested & TESTED_PLAIN) == 0 {
          let fields = self.fields
          run self.payloadInto(Reg.R11, inst.a)
          run self.a.test8MemImm(Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)), u32.wrappingToU8(fields.exotic))
          run self.a.jcc(Cond.NotEqual, miss)
          self.checkedIn = Reg.R11
        }
        run self.knownShapes(&function, arm - 1, i32.wrappingToU64(inst.k), testedWatched(tested), NONE, miss)
      }
      if armShapeAt(&function, inst.block) == self.cursor { self.a.bind(self.armLabels.get(u32.toUsize(inst.block))) }
      return ()
    }
    if op == Op.CheckChain {
      // The watched objects of one known shape, past those tested before (watchedAt).
      run self.stressGuard(inst.exit)
      let fields = self.fields
      let k = i32.wrappingToU32(inst.k) / 4
      let pair = i32.wrappingToU32(inst.k) % 4
      let known = function.inlineShapes.get(u32.toUsize(k))
      let mut j = self.shapes.watchedAt(self.cursor, u32.toU64(known.shapes[u32.toUsize(pair)]))
      while j < u8.toU32(known.lengths[u32.toUsize(pair)]) {
        let watched = self.chainSymbol(&function, k, pair, j)
        run self.a.movSymbol(Reg.R10, watched)
        run self.a.test8MemImm(Mem.at(Reg.R10, u32.wrappingToI32(fields.objectRoles)), u32.wrappingToU8(fields.watched))
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        j = j + 1
      }
      return ()
    }
    if op == Op.CheckWatched {
      // The check.shape before it proved the operand an object.
      run self.stressGuard(inst.exit)
      let fields = self.fields
      // Right after the check.shape of the same value that tested it (not proved by a fact,
      // nor an arm a dispatch enters past it): the object is still where it left it.
      let block = function.blocks.get(u32.toUsize(inst.block))
      let mut loaded = false
      if self.settings.stress == 0 && self.cursor > block.firstInst {
        let before = function.inst(self.cursor - 1)
        loaded = before.op == Op.CheckShape && before.a == inst.a && (self.shapes.fact(self.cursor - 1) & FACT_SHAPE) == 0 && armShapeAt(&function, inst.block) != self.cursor - 1
      }
      self.lazyAt(inst.a, inst.exit)
      let fresh = self.isFresh(inst.a)
      let mut object = self.checkedIn
      if !loaded { object = run self.objectIn(inst.a) }
      run self.a.test8MemImm(Mem.at(object, u32.wrappingToI32(fields.objectRoles)), u32.wrappingToU8(fields.watched))
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      if fresh { self.setFresh(inst.a) }
      return ()
    }
    if op == Op.CheckArray {
      // The front block of a loop around this one checks the Array (ssa_opt_hoist).
      if inst.proven { return () }
      run self.stressGuard(inst.exit)
      let miss = self.exitLabels.get(u32.toUsize(inst.exit))
      run self.arrayGuard(inst.a, miss)
      return ()
    }
    if op == Op.Elements {
      // The object is a fast Array (the `check.array` before it).
      let fields = self.fields
      let mut arr = inst.a
      if self.on { arr = self.storage(inst.a) }
      let out = self.at(inst.result)
      run self.a.load(Width.W64, Reg.R9, payloadOf(arr))
      if out.kind == GPR { run self.a.load(Width.W64, out.gpr, Mem.at(Reg.R9, u32.wrappingToI32(fields.elements))) }
      else {
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R9, u32.wrappingToI32(fields.elements)))
        run self.a.store(Width.W64, out.mem, Reg.R9)
