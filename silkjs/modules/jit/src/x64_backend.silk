        run self.unlessTag(inst.b, layout.object(), miss)
        run self.payloadInto(Reg.R8, inst.b)
        run self.a.alu(Alu.Cmp, Width.W64, Reg.R8, Reg.R9)
        run self.a.jcc(Cond.NotEqual, miss)
      }
      run self.a.aluStoreImm(Alu.Cmp, Width.W64, Mem.at(Reg.R11, signed(c.descFinalShapePtr)), 0)
      run self.a.jcc(Cond.Equal, miss)
      run self.constructChecks(miss, Option<Label>.none(), general, pollSlow, pass)
      self.a.bind(pass)
      run self.a.movSymbol(Reg.Rsi, sym)
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.result))
      run self.callHelper(helpers.ALLOC_OBJECT)
      self.a.bind(status)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 1)
      run self.a.jcc(Cond.Equal, done)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 3)
      run self.a.jcc(Cond.Equal, done)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
      run self.a.jcc(Cond.NotEqual, miss)
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsp, self.realmAt))
      run self.a.jmp(pollSlow)
      self.a.bind(general)
      run self.a.movSymbol(Reg.Rsi, sym)
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.result))
      run self.callHelper(helpers.NEW_OBJECT)
      run self.a.jmp(status)
      self.a.bind(done)
      run self.polls.append(PollSlow { slow: pollSlow, back: retry, exit: inst.exit, pc: function.exit(inst.exit).pc })
      return ()
    }
    if op == Op.CheckConstruct {
      run self.stressGuard(inst.exit)
      let layout = self.settings.layout
      let c = self.construct
      let miss = self.exitLabels.get(u32.toUsize(inst.exit))
      let coldSlow = run self.a.label()
      let pollSlow = run self.a.label()
      let done = run self.a.label()
      let sym = self.constructSymbol(&function, i32.wrappingToU32(inst.k))
      // Inline validation using ONLY always-free scratch GPRs (rax, r8, r9, r11) + r13 (rt)
      // so fragile GPRs and live F64 XMM registers survive across Op.CheckConstruct.
      run self.unlessTag(inst.a, layout.object(), miss)
      run self.payloadInto(Reg.R8, inst.a)
      run self.a.movSymbol(Reg.R11, sym)
      run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(c.descCtor)))
      run self.a.alu(Alu.Cmp, Width.W64, Reg.R8, Reg.R9)
      run self.a.jcc(Cond.NotEqual, miss)
      if inst.b != inst.a {
        run self.unlessTag(inst.b, layout.object(), miss)
        run self.payloadInto(Reg.R8, inst.b)
        run self.a.alu(Alu.Cmp, Width.W64, Reg.R8, Reg.R9)
        run self.a.jcc(Cond.NotEqual, miss)
      }
      run self.constructChecks(miss, Option<Label>.some(coldSlow), coldSlow, pollSlow, done)
      self.a.bind(done)
      run self.checkConstructSlows.append(CheckConstructSlow { coldSlow: coldSlow, pollSlow: pollSlow, back: done, sym: sym, exit: inst.exit, pc: function.exit(inst.exit).pc })
      return ()
    }
    if op == Op.KnownMethod {
      run self.stressGuard(inst.exit)
      let layout = self.settings.layout
      let fields = self.fields
      let target = i32.wrappingToU32(inst.k & 0xffffff)
      let pair = i32.toUsize(i32.shiftRight(inst.k, 24) & 3)
      let known = function.inlineShapes.get(u32.toUsize(target))
      let miss = self.exitLabels.get(u32.toUsize(inst.exit))
      let mut j: u32 = 0
      while j < u8.toU32(known.lengths[pair]) {
        let watched = self.chainSymbol(&function, target, usize.toU32(pair), j)
        run self.a.movSymbol(Reg.R10, watched)
        run self.a.test8MemImm(Mem.at(Reg.R10, u32.wrappingToI32(fields.objectRoles)), u32.wrappingToU8(fields.watched))
        run self.a.jcc(Cond.Equal, miss)
        j = j + 1
      }
      if !self.isPreset(inst.result) {
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.object()))
        let closure = self.symbol(target * 3 + 2)
        run self.a.movSymbol(Reg.R9, closure)
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        if function.value(inst.result).own != Own.Borrowed { run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R9, 0), 1) }
      }
      if self.calleeNext(&function, inst.block, inst.result, target) {
        self.omitAt = self.cursor + 1
      }
      return ()
    }
    if op == Op.InitSlot {
      run self.payloadInto(Reg.R11, inst.a)
      run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(self.fields.objectSlots)))
      let off = i32.wrappingToU32(inst.k) * 16
      let info = function.value(given.b)
      if info.ty == Type.I32 || info.ty == Type.Bool {
        match self.constants.get(u32.toUsize(inst.b)) {
          Option<i32>.Some { value } => { run self.a.movImm32(Reg.Rax, i32.wrappingToU32(value)) }
          Option<i32>.None => { let p = self.at(inst.b) run getI32(&mut self.a, Reg.Rax, p) }
        }
        run self.boxInto(info.ty == Type.Bool, Reg.Rax, Reg.R11, off)
      } else if info.ty == Type.F64 {
        let p = self.at(inst.b)
        run getBits(&mut self.a, Reg.Rax, p)
        run self.boxDoubleInto(Reg.Rax, Reg.R11, off)
      } else {
        run self.a.load(Width.W64, Reg.Rax, slotOf(inst.b))
        run self.a.load(Width.W64, Reg.R9, payloadOf(inst.b))
        run self.a.store(Width.W64, word(Reg.R11, off), Reg.Rax)
        run self.a.store(Width.W64, word(Reg.R11, off + 8), Reg.R9)
        if info.own != Own.Imm { run self.retainBits(Reg.Rax, Reg.R9) }
      }
      return ()
    }
    if op == Op.CallArg && self.on {
      // Borrowed into the operand cell the interpreter would have it in; an i32 or bool is
      // boxed there.
      let call = self.callOf(&function)
      // A stepped instruction's operands come with the rest of its state (stepOnFrame).
      if (call.k & calls.GENERIC) != 0 { return () }
      if function.exit(call.exit).frames != 0 {
        // A call inside an inlined body has cells of its own (callInBody).
        let cell = self.callAt + (2 + i32.wrappingToU32(inst.k)) * SLOT_BYTES
        run self.valueInto(&function, inst.a, SlotMode.Imm, Reg.Rsp, cell)
        if (call.k & calls.CONSTRUCT) != 0 {
          run self.a.load(Width.W64, Reg.Rax, word(Reg.Rsp, cell))
          run self.a.load(Width.W64, Reg.R9, word(Reg.Rsp, cell + 8))
          run self.retainBits(Reg.Rax, Reg.R9)
        }
        return ()
      }
      let depth = function.exit(call.exit).stackDepth
      let at = self.plan.operandAt(depth - calls.countOf(call) + i32.wrappingToU32(inst.k))
      run self.valueInto(&function, inst.a, SlotMode.Imm, Reg.Rbp, i32.wrappingToU32(at))
      if (call.k & calls.CONSTRUCT) != 0 {
        // A constructor's plan moves its arguments into the object (js_vm.baselineConstruct):
        // the cell owns a count, which callOnFrame drops from the cells the call left full.
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rbp, at))
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rbp, at + 8))
        run self.retainBits(Reg.Rax, Reg.R9)
      }
      return ()
    }
    if op == Op.Call && calls.quietCall(inst) { run self.quietPop(&function, inst) return () }
    if op == Op.Call && self.on { run self.callOnFrame(&function, inst) return () }
    if op == Op.CallArg {
      // Borrowed into the call area; an i32 or bool is boxed there.
      run self.callBlock(Reg.R11)
      let at = u32.wrappingMultiply(usize.toU32(compiled.CALL_AREA), 8) + (2 + i32.wrappingToU32(inst.k)) * SLOT_BYTES
      run self.valueInto(&function, inst.a, SlotMode.Imm, Reg.R11, at)
      return ()
    }
    if op == Op.Call {
      // The result slot holds the exit status until the call answers (stress exits deopt).
      run self.a.storeImm(Width.W64, slotOf(inst.result), u32.wrappingToI32(EXIT_DEOPT))
      run self.stressGuard(inst.exit)
      let area = u32.wrappingMultiply(usize.toU32(compiled.CALL_AREA), 8)
      run self.callBlock(Reg.R11)
      run self.valueInto(&function, inst.a, SlotMode.Imm, Reg.R11, area)
      run self.valueInto(&function, inst.b, SlotMode.Imm, Reg.R11, area + SLOT_BYTES)
      let point = self.resumeIndex(&function, inst)
      run self.a.movImm64(Reg.Rax, u64.bitOr(u32.toU64(inst.pc), u64.shiftLeft(u32.toU64(i32.wrappingToU32(inst.k)), 32)))
      run self.a.store(Width.W64, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_SITE), 8)), Reg.Rax)
      let generic = run self.a.label()
      let done = run self.a.label()
      if calls.kindOf(inst) == compiled.SITE_PUT_FIELD {
        let frameAt = self.input(INPUT_FRAME) run self.a.load(Width.W64, Reg.Rsi, frameAt)
        // A generic store tries put_field's helper on the area's cells first (1 when stored);
        // only what it cannot do leaves.
        run self.a.movImm32(Reg.Rdx, inst.pc)
        run self.a.lea(Width.W64, Reg.Rcx, word(Reg.R11, area))
        run self.a.lea(Width.W64, Reg.R8, word(Reg.R11, area + SLOT_BYTES))
        run self.callHelper(helpers.PUT_FIELD)
        run self.callBlock(Reg.R11)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 1)
        run self.a.jcc(Cond.NotEqual, generic)
        let layout = self.settings.layout
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.undefined()))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.storeImm(Width.W64, payloadOf(inst.result), 0)
        run self.a.jmp(done)
      } else if calls.kindOf(inst) == compiled.SITE_EQUAL {
        // A generic == or != tries the equals helper first (2 where it would coerce).
        run self.a.lea(Width.W64, Reg.Rsi, word(Reg.R11, area))
        run self.a.lea(Width.W64, Reg.Rdx, word(Reg.R11, area + SLOT_BYTES))
        run self.a.movImm32(Reg.Rcx, 0)
        run self.callHelper(helpers.EQUALS)
        run self.callBlock(Reg.R11)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
        run self.a.jcc(Cond.Equal, generic)
        if calls.notEqualOf(inst) { run self.a.aluImm(Alu.Xor, Width.W32, Reg.Rax, 1) }
        let layout = self.settings.layout
        run self.a.movImm64(Reg.R9, layout.tagWord(layout.boolean()))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.R9)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rax)
        run self.a.jmp(done)
      } else if (inst.k & (calls.CONSTRUCT | calls.GENERIC | calls.LAZY_ARGUMENTS)) == 0 {
        let helper = run self.a.label()
        let count = i32.wrappingToU32(calls.argumentCount(inst.k))
        if count == 1 || count == 2 {
          // A native callee may be one of Math's own functions on Numbers: computed at once.
          let layout = self.settings.layout
          let fields = self.fields
          let notMath = run self.a.label()
          run self.loadTag(Reg.R8, word(Reg.R11, area + layout.tagOffset))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
          run self.a.jcc(Cond.NotEqual, notMath)
          run self.a.load(Width.W64, Reg.R9, word(Reg.R11, area + 8))
          run self.a.loadZero16(Reg.R8, Mem.at(Reg.R9, u32.wrappingToI32(fields.objectClass)))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(classes.JS_CLASS_C_FUNCTION))
          run self.a.jcc(Cond.NotEqual, notMath)
          let math = self.math
          if math.fnTagAt != u32.MAX && math.familyAt != u32.MAX {
            run self.a.cmp8MemImm(Mem.at(Reg.R9, signed(math.fnTagAt)), math.builtinTag)
            run self.a.jcc(Cond.NotEqual, notMath)
            run self.a.cmp8MemImm(Mem.at(Reg.R9, signed(math.familyAt)), math.mathFamily)
            run self.a.jcc(Cond.NotEqual, notMath)
          }
          let mathResult = u32.wrappingMultiply(usize.toU32(compiled.CALL_RESULT), 8)
          run self.a.lea(Width.W64, Reg.Rsi, word(Reg.R11, area))
          run self.a.movImm32(Reg.Rdx, count)
          run self.a.lea(Width.W64, Reg.Rcx, word(Reg.R11, mathResult))
          run self.callHelper(helpers.MATH)
          run self.callBlock(Reg.R11)
          run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
          run self.a.jcc(Cond.Equal, notMath)
          run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, mathResult))
          run self.a.load(Width.W64, Reg.R9, word(Reg.R11, mathResult + 8))
          run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
          run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
          run self.a.jmp(done)
          self.a.bind(notMath)
        }
        run self.directCall(i32.wrappingToU32(calls.argumentCount(inst.k)), helper, generic)
        let directResult = u32.wrappingMultiply(usize.toU32(compiled.CALL_STATE), 8)
        run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, directResult))
        run self.a.load(Width.W64, Reg.R9, word(Reg.R11, directResult + 8))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        run self.a.jmp(done)
        self.a.bind(helper)
        let atF = self.input(INPUT_FRAME) run self.a.load(Width.W64, Reg.Rsi, atF)
        run self.a.mov(Width.W64, Reg.Rdx, Reg.R11)
        run self.callHelper(helpers.CALL_FAST)
        run self.callBlock(Reg.R11)
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.NotEqual, generic)
        let fastResult = u32.wrappingMultiply(usize.toU32(compiled.CALL_RESULT), 8)
        run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, fastResult))
        run self.a.load(Width.W64, Reg.R9, word(Reg.R11, fastResult + 8))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        run self.a.jmp(done)
      }
      // Otherwise leave with EXIT_CALL: the resume point and the saved values go to the block.
      self.a.bind(generic)
      if (inst.k & calls.GENERIC) != 0 {
        let atE = self.input(INPUT_ENV) run self.a.load(Width.W64, Reg.Rax, atE)
        run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.Rax, helpers.GENERIC_RUNS_OFFSET), 1)
      }
      run self.a.movImm32(Reg.Rax, u32.shiftLeft(point + 1, 2))
      run self.a.store(Width.W64, word(Reg.R11, 0), Reg.Rax)
      run self.keep(point, true)
      run self.leave(EXIT_CALL)
      // Resumed (see resume) with the block's word 0 in RAX and the block in R11.
      self.a.bind(self.resumeLabels.get(u32.toUsize(point)))
      run self.keep(point, false)
      let returned = run self.a.label()
      run self.a.aluImm(Alu.And, Width.W32, Reg.Rax, 3)
      run self.a.jcc(Cond.Equal, returned)
      // Threw (1) or not called (2): the throw exit with that status, the state before the call.
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 1)
      run self.a.storeImm(Width.W64, slotOf(inst.result), u32.wrappingToI32(EXIT_DEOPT))
      run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
      run self.a.storeImm(Width.W64, slotOf(inst.result), u32.wrappingToI32(EXIT_THROW))
      run self.a.jmp(self.exitLabels.get(u32.toUsize(inst.exit)))
      self.a.bind(returned)
      // A generic instruction's result is where its operands were (js_vm.compiledOp).
      let mut result = u32.wrappingMultiply(usize.toU32(compiled.CALL_RESULT), 8)
      if (inst.k & calls.GENERIC) != 0 { result = area + 2 * SLOT_BYTES }
      run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, result))
      run self.a.load(Width.W64, Reg.R9, word(Reg.R11, result + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      self.a.bind(done)
      return ()
    }
    if op == Op.CallResult && self.on {
      // Another value the stepped instruction left, owned, in the operand cell it is in
      // (x64_frame_exit.stepShape).
      let call = function.inst(function.value(inst.a).def)
      let depth = function.exit(call.exit).stackDepth
      let at = self.plan.operandAt(depth - calls.countOf(call) + i32.wrappingToU32(inst.k))
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rbp, at))
      run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rbp, at + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      return ()
    }
    if op == Op.CallResult {
      // Another value the generic call left in its area (js_vm.compiledOp), owned.
      let area = u32.wrappingMultiply(usize.toU32(compiled.CALL_AREA), 8)
      let at = area + (2 + i32.wrappingToU32(inst.k)) * SLOT_BYTES
      run self.callBlock(Reg.R11)
      run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, at))
      run self.a.load(Width.W64, Reg.R9, word(Reg.R11, at + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      return ()
    }
    Intrinsic.trap("x64_backend: unlowered SSA operation")
  }
  /// Moves an edge's arguments into its target's parameters, then jumps there.
  effect fn edge(self: &mut Self, function: &Function, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.edgeThen(&function, index, true)
  }
  /// edge, where last says whether its code ends the block (so a jump to the next block falls through).
  effect fn edgeThen(self: &mut Self, function: &Function, index: u32, last: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.edgeMoves(&function, index)
    let edge = function.edge(index)
    if !last || edge.target != self.current + 1 { run self.a.jmp(self.blockLabels.get(u32.toUsize(edge.target))) }
  }
  /// Moves an edge's arguments into its target's parameters. The moves leave the flags alone.
  effect fn edgeMoves(self: &mut Self, function: &Function, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let edge = function.edge(index)
    let target = function.blocks.get(u32.toUsize(edge.target))
    // A parallel move: emit any move whose destination no pending move still reads; when
    // only cycles are left, park one source in the scratch place and go on.
    let mut from = List<u32>.make()
    let mut to = List<u32>.make()
    let mut i: u32 = 0
    while i < edge.argCount {
      let source = function.edgeArg(edge, i)
      let into = function.paramAt(target, i)
      if self.key(source) != self.key(into) { run from.append(source) run to.append(into) }
      i = i + 1
    }
    let mut parked = NONE
    let mut done = List<bool>.make()
    run done.appendRepeated(false, from.length())
    let mut left = from.length()
    while left > 0 {
      let mut progress = false
      let mut m: usize = 0
      while m < from.length() {
        if !done.get(m) {
          let blocked = self.readByPending(&from, &done, m, self.key(to.get(m)), parked)
          if !blocked {
            run self.moveValue(&function, from.get(m), to.get(m), from.get(m) == parked)
            done.set(m, true) left = left - 1 progress = true
            if from.get(m) == parked { parked = NONE }
          }
        }
        m = m + 1
      }
      if !progress {
        // Every pending move is in a cycle: park the first one's source.
        let mut first: usize = 0
        while done.get(first) { first = first + 1 }
        parked = from.get(first)
        run self.park(&function, parked)
      }
    }
  }
  /// Sizes the per-block states of slotsValue and counts each block's edges in.
  effect fn slotsSetup(self: &mut Self, function: &Function) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = u32.toUsize(function.blockCount())
    run self.entrySlots.appendRepeated(NONE, count)
    run self.slotArrivals.appendRepeated(0, count)
    run self.slotPreds.appendRepeated(0, count)
    let mut b: usize = 0
    while b < count {
      let block = function.blocks.get(b)
      if block.instCount != 0 {
        let last = function.inst(block.firstInst + block.instCount - 1)
        let mut e: u32 = 0
        while e < ssa.edgeCount(last.op) {
          let target = u32.toUsize(function.edge(last.edge + e).target)
          let had = self.slotPreds.get(target)
          self.slotPreds.set(target, had + 1)
          e = e + 1
        }
      }
      b = b + 1
    }
  }
  /// One way into block, with R11 the slots of `slots` (a slotsValue; NONE or SLOTS_MIXED
  /// for none).
  fn slotsArrive(self: &mut Self, block: u32, slots: u32) -> () {
    let b = u32.toUsize(block)
    if b >= self.entrySlots.length() { return () }
    let arrived = self.slotArrivals.get(b)
    let mut state = slots
    if state == NONE || (arrived != 0 && self.entrySlots.get(b) != state) { state = SLOTS_MIXED }
    self.entrySlots.set(b, state)
    self.slotArrivals.set(b, arrived + 1)
  }
  /// Edge `index` is followed with R11 the slots of `slots`. Its moves take R11 only to park
  /// a value of a cycle (edgeMoves), which takes two moves at least.
  fn slotsEdge(self: &mut Self, function: &Function, index: u32, slots: u32) -> () {
    let mut state = slots
    if self.movingArgs(function, index) > 1 { state = SLOTS_MIXED }
    self.slotsArrive(function.edge(index).target, state)
  }
  /// How many of edge `index`'s arguments move.
  fn movingArgs(self: &Self, function: &Function, index: u32) -> u32 {
    let edge = function.edge(index)
    let target = function.blocks.get(u32.toUsize(edge.target))
    let mut moving: u32 = 0
    let mut i: u32 = 0
    while i < edge.argCount {
      if self.key(function.edgeArg(edge, i)) != self.key(function.paramAt(target, i)) { moving = moving + 1 }
      i = i + 1
    }
    return moving
  }
  /// Whether lowering `given` keeps R11 and changes no object's slots: the instructions
  /// r11Kept names, a compare, the terminators (they hand slotsValue on: slotsEdge), and a
  /// field read, which sets slotsValue itself.
  fn keepsSlots(self: &Self, function: &Function, given: Inst) -> bool {
    let op = given.op
    if op == Op.Jump || op == Op.Branch || op == Op.Cmp || op == Op.InlineFrame { return true }
    return r11Kept(function, given)
  }
  /// The edge block `target` jumps on by when all it holds is that jump (after an inlined
  /// body's `inline.frame`, which emits nothing) and it takes no parameter: a counted
  /// loop's latch, whose poll ssa_opt_bounds took in front of the loop. NONE for any other
  /// block.
  fn through(self: &Self, function: &Function, target: u32) -> u32 {
    let block = function.blocks.get(u32.toUsize(target))
    if block.instCount == 0 || block.paramCount != 0 { return NONE }
    let mut i: u32 = 0
    while i + 1 < block.instCount {
      if function.inst(block.firstInst + i).op != Op.InlineFrame { return NONE }
      i = i + 1
    }
    let only = function.inst(block.firstInst + block.instCount - 1)
    if only.op != Op.Jump || function.edge(only.edge).target == target { return NONE }
    return only.edge
  }
  /// Whether the moves of edge `index` (a latch's jump back, see `through`) may run in front
  /// of the branch being lowered, which reaches the latch: no move writes where a value
  /// that lives past this block is, so the branch's other edge finds everything it reads.
  /// The branch has read its own operand by then.
  fn movesAbove(self: &Self, function: &Function, index: u32, operand: u32) -> bool {
    let edge = function.edge(index)
    let target = function.blocks.get(u32.toUsize(edge.target))
    // Where the allocator has this block's end (x64_regalloc: an instruction's reads).
    let end = self.cursor * 2 + 2
    let values = function.valueCount()
    let mut i: u32 = 0
    while i < edge.argCount {
      let into = function.paramAt(target, i)
      let key = self.key(into)
      if self.key(function.edgeArg(edge, i)) != key {
        let mut v: u32 = 0
        while v < values {
          if v != operand && self.places.starts.get(u32.toUsize(v)) <= end && self.places.ends.get(u32.toUsize(v)) >= end
            && self.places.starts.get(u32.toUsize(v)) != NONE && self.key(v) == key { return false }
          v = v + 1
        }
      }
      i = i + 1
    }
    return true
  }
  /// Whether following edge index moves any value.
  fn moves(self: &Self, function: &Function, index: u32) -> bool {
    let edge = function.edge(index)
    let target = function.blocks.get(u32.toUsize(edge.target))
    let mut i: u32 = 0
    while i < edge.argCount {
      if self.key(function.edgeArg(edge, i)) != self.key(function.paramAt(target, i)) { return true }
      i = i + 1
    }
    return false
  }
  /// The inline target whose method the get.field at `index` reads when that method is known
  /// (ssa.TARGET_KNOWN) and the read is one the known path serves, or NONE. The site is
  /// cached, never left before, and the target is that of the first `check.callee` of its
  /// result in the instructions that follow, with no `is.callee` of it before, when the read
  /// is the site the embedder marked it for. The target's shapes (Function.inlineShapes) say which receivers the known
  /// path serves; the others take the read.
  fn knownRead(self: &Self, function: &Function, index: u32) -> u32 {
    let read = function.inst(index)
    if !self.on || read.op != Op.GetField || read.result == NONE { return NONE }
    if self.shapes.sameAs(index) != NONE || self.shapes.key(index) != 0 || (read.k & 1) != 1 { return NONE }
    if (self.shapes.fact(index) & FACT_HEDGED) != 0 { return NONE }
    // Tests of several targets: their shape dispatch serves the read (shapeArms), and a
    // check.callee after them is the last one's, for receivers the tests did not take.
    return knownTarget(function, index)
  }
  /// The arms of a shape dispatch at the cached read at `index` (pairs: an inline target, the
  /// block its body begins in), in the order the code tests the callee. The read's block has
  /// nothing after the read that is code but the test of what it read against a target and
  /// the branch on it (a copy that borrows and the frames' names are none), and so has each
  /// block the tests go on in; an arm is a test whose target's method is known for one
  /// shape (ssa.TARGET_KNOWN, Function.inlineShapes) and whose edge passes nothing. The arms
  /// end at the first block that does more.
  effect fn shapeArms(self: &Self, function: &Function, index: u32, arms: &mut List<u32>) -> () ! OutOfMemoryError ? &mut Allocator {
    let read = function.inst(index)
    if !self.on || read.op != Op.GetField || read.result == NONE || function.inlineShapes.length() == 0 { return () }
    let mut block = read.block
    let mut at = index + 1
    let mut hops: u32 = 0
    while hops < 4 {
      let here = function.blocks.get(u32.toUsize(block))
      if here.instCount == 0 { return () }
      let last = here.firstInst + here.instCount - 1
      let mut test = NONE
      while at < last {
        let inst = function.inst(at)
        if inst.op == Op.IsCallee && inst.a == read.result && test == NONE && self.fusedCallee(function, inst) { test = at }
        else if inst.op == Op.InlineFrame || inst.op == Op.Removed {}
        else if inst.op == Op.Retain && inst.result != NONE && function.value(inst.result).own == Own.Borrowed && self.storage(inst.result) != inst.result {}
        else { return () }
        at = at + 1
      }
      if test == NONE { return () }
      let tested = function.inst(test)
      let branch = function.inst(last)
      if branch.op != Op.Branch || branch.a != tested.result { return () }
      let hit = function.edge(branch.edge)
      let miss = function.edge(branch.edge + 1)
      let k = i32.wrappingToU32(tested.k)
      if hit.argCount == 0 && tested.frame == read.frame && u32.toUsize(k) < function.inlineShapes.length() && function.inlineShapes.get(u32.toUsize(k)).shapes[0] != 0
        && function.inlineSites.get(u32.toUsize(k)) == read.pc && self.known(function, k) && self.exact(function, k) {
        run arms.append(k)
        run arms.append(hit.target)
      }
      if miss.argCount != 0 { return () }
      block = miss.target
      at = function.blocks.get(u32.toUsize(block)).firstInst
      hops = hops + 1
    }
  }
  /// Whether value v is known to be the one closure of an inline target from its callee
  /// test on, in every exit but that test's own (`exit`): see presets.
  pub fn presetAt(self: &Self, v: u32, exit: u32) -> bool {
    return u32.toUsize(v) < self.preset.length() && self.preset.get(u32.toUsize(v)) != 0 && self.presetGuard.get(u32.toUsize(v)) != exit
  }
  fn isPreset(self: &Self, v: u32) -> bool { return u32.toUsize(v) < self.preset.length() && self.preset.get(u32.toUsize(v)) != 0 }
  /// Finds the known methods whose value needs no read at all (Emitter.preset). The result
  /// of a known read (knownRead) with its callee test right after it is, past that test, the
  /// target's one closure: the known path proved it without the test, and the general path
  /// by the test. When nothing reads the value but the test, the frames of the inlined body,
  /// exits and its release, its slot is written once, where the function begins (enter),
  /// the known path writes nothing and holds no count, and the general path gives back the
  /// count its read took once the test passed. An exit after the test then adds the count
  /// the interpreter's cell owns (x64_exits), and the release is no code. The test's own
  /// exit is the general path's alone: there the slot holds what was read, with its count.
  effect fn presets(self: &mut Self, function: &Function) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = u32.toUsize(function.valueCount())
    run self.preset.appendRepeated(0, count)
    run self.presetGuard.appendRepeated(NONE, count)
    run self.bare.appendRepeated(false, count)
    if !self.on || function.inlineTargets.length() == 0 { return () }
    let mut quiet = List<u32>.make()
    run quiet.appendRepeated(0, count)
    let mut guards = List<u32>.make()
    run guards.appendRepeated(0, function.exits.length())
    let mut i: usize = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      if (inst.op == Op.CheckCallee || inst.op == Op.InlineFrame || inst.op == Op.Release) && u32.toUsize(inst.a) < count {
        let before = quiet.get(u32.toUsize(inst.a))
        quiet.set(u32.toUsize(inst.a), before + 1)
      }
      if inst.op != Op.Removed && inst.exit != NONE && u32.toUsize(inst.exit) < guards.length() {
        let before = guards.get(u32.toUsize(inst.exit))
        guards.set(u32.toUsize(inst.exit), before + 1)
      }
      i = i + 1
    }
    i = 0
    while i < function.slots.length() {
      let slot = function.slots.get(i)
      if slot.mode != SlotMode.Virtual {
        let v = slot.value
        if v != NONE && u32.toUsize(v) < count { let before = quiet.get(u32.toUsize(v)) quiet.set(u32.toUsize(v), before + 1) }
      }
      i = i + 1
    }
    i = 0
    while i < function.insts.length() {
      let index = usize.toU32(i)
      i = i + 1
      let read = function.inst(index)
      let target = if read.op == Op.KnownMethod { i32.wrappingToU32(read.k & 0xffffff) } else { self.knownRead(function, index) }
      if target == NONE || read.result == NONE { continue }
      let v = read.result
      let block = function.blocks.get(u32.toUsize(read.block))
      if index + 1 >= block.firstInst + block.instCount { continue }
      let test = function.inst(index + 1)
      if test.op != Op.CheckCallee || test.a != v || i32.wrappingToU32(test.k) != target || test.exit == NONE { continue }
      if guards.get(u32.toUsize(test.exit)) != 1 || self.storage(v) != v { continue }
      if self.uses.get(u32.toUsize(v)) != quiet.get(u32.toUsize(v)) { continue }
      let own = function.value(v).own
      if own != Own.Owned && own != Own.Borrowed { continue }
      self.preset.set(u32.toUsize(v), target + 1)
      self.presetGuard.set(u32.toUsize(v), test.exit)
    }
    // The methods shape dispatches read: what is read but the tests, the frames of the
    // inlined bodies, exits and releases.
    i = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      if inst.op == Op.IsCallee && u32.toUsize(inst.a) < count { let before = quiet.get(u32.toUsize(inst.a)) quiet.set(u32.toUsize(inst.a), before + 1) }
      i = i + 1
    }
    i = 0
    while i < function.insts.length() {
      let index = usize.toU32(i)
      i = i + 1
      let read = function.inst(index)
      if read.op != Op.GetField || read.result == NONE || u32.toUsize(read.result) >= count || (read.k & FIELD_STEPS) != 0 { continue }
      let v = read.result
      if function.value(v).own != Own.Owned || self.isPreset(v) || self.storage(v) != v { continue }
      if self.uses.get(u32.toUsize(v)) != quiet.get(u32.toUsize(v)) { continue }
      if self.bareDispatch(function, index) { self.bare.set(u32.toUsize(v), true) }
    }
    run self.armReads(function, &quiet)
  }
  /// The method reads a shape dispatch serves (knownArms) that its arms need not write:
  /// nothing reads the value but the tests, the frames of the inlined bodies, exits and
  /// releases (a borrow or a bare read: no count). Inside the arm for inline target k (a
  /// block the arm's first block dominates) the value is k's one closure, which a slot of
  /// its own holds from where the function begins (armSlot, written by enter): the frames
  /// and the exits there read it from that slot. Anywhere else an exit names it, the
  /// general read wrote it: the blocks of the dispatch's chain of tests and those its last
  /// one dominates. A read with an exit that names it elsewhere keeps its stores.
  effect fn armReads(self: &mut Self, function: &Function, quiet: &List<u32>) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = u32.toUsize(function.valueCount())
    run self.armed.appendRepeated(false, count)
    run self.armSlot.appendRepeated(NONE, function.inlineTargets.length())
    if !self.on || self.armSlots == 0 || self.settings.stress != 0 { return () }
    let idom = run dominators(function)
    // The block of each exit's one instruction (MULTI when several blocks use it).
    let multi = NONE - 1
    let mut exitBlocks = List<u32>.make()
    run exitBlocks.appendRepeated(NONE, function.exits.length())
    let mut i: usize = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      if inst.op != Op.Removed && inst.exit != NONE && u32.toUsize(inst.exit) < exitBlocks.length() {
        let before = exitBlocks.get(u32.toUsize(inst.exit))
        if before == NONE { exitBlocks.set(u32.toUsize(inst.exit), inst.block) }
        else if before != inst.block { exitBlocks.set(u32.toUsize(inst.exit), multi) }
      }
      i = i + 1
    }
    let mut used: u32 = 0
    i = 0
    while i < function.insts.length() {
      let index = usize.toU32(i)
      i = i + 1
      let read = function.inst(index)
      if read.op != Op.GetField || read.result == NONE || u32.toUsize(read.result) >= count || (read.k & FIELD_STEPS) != 0 { continue }
      let v = read.result
      if (function.value(v).own != Own.Borrowed && !self.isBare(v)) || self.isPreset(v) || self.storage(v) != v || self.aliased.get(u32.toUsize(v)) { continue }
      if self.uses.get(u32.toUsize(v)) != quiet.get(u32.toUsize(v)) { continue }
      let mut arms = List<u32>.make()
      run self.shapeArms(function, index, &mut arms)
      if arms.length() == 0 { continue }
      let mut chain = List<u32>.make()
      run self.dispatchChain(function, index, &mut chain)
      let last = chain.get(chain.length() - 1)
      let mut ok = true
      let mut xs = List<u32>.make()
      let mut ks = List<u32>.make()
      let mut x: usize = 0
      while ok && x < function.exits.length() {
        let exit = function.exits.get(x)
        let mut names = false
        let mut s: u32 = 0
        while s < function.slotCount(exit) {
          let slot = function.slot(exit, s)
          if slot.mode != SlotMode.Virtual && slot.value == v { names = true }
          s = s + 1
        }
        if names {
          let b = exitBlocks.get(x)
          if b == NONE || b == multi { ok = false }
          else {
            let mut k = NONE
            let mut a: usize = 0
            while a < arms.length() { if dominatesBlock(&idom, arms.get(a + 1), b) { k = arms.get(a) } a = a + 2 }
            if k != NONE { run xs.append(usize.toU32(x)) run ks.append(k) }
            else {
              let mut inChain = false
              let mut c: usize = 0
              while c < chain.length() { if chain.get(c) == b { inChain = true } c = c + 1 }
              if !inChain && !dominatesBlock(&idom, last, b) { ok = false }
            }
          }
        }
        x = x + 1
      }
      if !ok { continue }
      // Every arm's target needs its slot.
      let mut need: u32 = 0
      let mut a: usize = 0
      while a < arms.length() { if self.armSlot.get(u32.toUsize(arms.get(a))) == NONE { need = need + 1 } a = a + 2 }
      if used + need > self.armSlots { continue }
      a = 0
      while a < arms.length() {
        let k = u32.toUsize(arms.get(a))
        if self.armSlot.get(k) == NONE { self.armSlot.set(k, u32.wrappingAdd(i32.wrappingToU32(self.scratch) / SLOT_BYTES, 3 + used)) used = used + 1 }
        a = a + 2
      }
      self.armed.set(u32.toUsize(v), true)
      let mut n: usize = 0
      while n < xs.length() { run self.armX.append(xs.get(n)) run self.armV.append(v) run self.armK.append(ks.get(n)) n = n + 1 }
    }
  }
  /// The blocks of the chain of callee tests after the read at `index` (shapeArms' walk):
  /// the read's own, then each miss on.
  effect fn dispatchChain(self: &Self, function: &Function, index: u32, chain: &mut List<u32>) -> () ! OutOfMemoryError ? &mut Allocator {
    let read = function.inst(index)
    let mut block = read.block
    run chain.append(block)
    let mut hops: u32 = 0
    while hops < 4 {
      let here = function.blocks.get(u32.toUsize(block))
      if here.instCount == 0 { return () }
      let branch = function.inst(here.firstInst + here.instCount - 1)
      if branch.op != Op.Branch { return () }
      let test = self.defs.get(u32.toUsize(branch.a))
      if test == NONE || function.inst(test).op != Op.IsCallee || function.inst(test).a != read.result { return () }
      let miss = function.edge(branch.edge + 1)
      if miss.argCount != 0 { return () }
      block = miss.target
      run chain.append(block)
      hops = hops + 1
    }
  }
  /// The slot that holds the closure of inline target k's frame, whose closure is value v
  /// (in slot `held`): armSlot when v is armed.
  fn closureSlot(self: &Self, held: u32, k: u32) -> u32 {
    if u32.toUsize(held) < self.armed.length() && self.armed.get(u32.toUsize(held)) && u32.toUsize(k) < self.armSlot.length() && self.armSlot.get(u32.toUsize(k)) != NONE { return self.armSlot.get(u32.toUsize(k)) }
    return held
  }
  /// The slot an exit's entry for value v reads: the arm's closure slot when the exit is
  /// inside an arm of v's dispatch (armReads), else v's storage.
  pub fn exitSlotOf(self: &Self, exit: u32, v: u32) -> u32 {
    if u32.toUsize(v) < self.armed.length() && self.armed.get(u32.toUsize(v)) {
      let mut n: usize = 0
      while n < self.armX.length() {
        if self.armX.get(n) == exit && self.armV.get(n) == v { return self.armSlot.get(u32.toUsize(self.armK.get(n))) }
        n = n + 1
      }
    }
    return self.storage(v)
  }
  pub fn isArmed(self: &Self, v: u32) -> bool { return u32.toUsize(v) < self.armed.length() && self.armed.get(u32.toUsize(v)) }
  /// Whether the method the field read at `index` reads is tested at once by a shape
  /// dispatch on exact targets (shapeArms' chain of `is.callee`s, nothing between but
  /// borrowed copies and frames) that ends in a `check.callee` of one: past the read, the
  /// value is the one closure of an exact target, which the code keeps, or the last test
  /// leaves. It then needs no count (bare): the read takes none, its releases are no code,
  /// and an exit adds the count its cell owns (x64_exits). The read's value lives until
  /// the tests: nothing between them can replace the property.
  fn bareDispatch(self: &Self, function: &Function, index: u32) -> bool {
    let read = function.inst(index)
    let v = read.result
    let mut block = read.block
    let mut at = index + 1
    let mut hops: u32 = 0
    while hops < 6 {
      let here = function.blocks.get(u32.toUsize(block))
      if here.instCount == 0 { return false }
      let last = here.firstInst + here.instCount - 1
      let mut test = NONE
      while at < last {
        let inst = function.inst(at)
        if inst.op == Op.IsCallee && inst.a == v && test == NONE {
          if !self.exactTarget(function, inst.k) { return false }
          test = at
        }
        else if inst.op == Op.CheckCallee && inst.a == v { return test == NONE && hops > 0 && self.exactTarget(function, inst.k) }
        else if inst.op == Op.InlineFrame || inst.op == Op.Removed {}
        else if inst.op == Op.Retain && inst.result != NONE && function.value(inst.result).own == Own.Borrowed && self.storage(inst.result) != inst.result {}
        else { return false }
        at = at + 1
      }
      if test == NONE { return false }
      let branch = function.inst(last)
      if branch.op != Op.Branch || branch.a != function.inst(test).result { return false }
      let miss = function.edge(branch.edge + 1)
      if miss.argCount != 0 { return false }
      block = miss.target
      at = function.blocks.get(u32.toUsize(block)).firstInst
      hops = hops + 1
    }
    return false
  }
  fn exactTarget(self: &Self, function: &Function, k: i32) -> bool {
    return k >= 0 && u32.toUsize(i32.wrappingToU32(k)) < function.inlineTargets.length() && self.exact(function, i32.wrappingToU32(k))
  }
  pub fn isBare(self: &Self, v: u32) -> bool { return u32.toUsize(v) < self.bare.length() && self.bare.get(u32.toUsize(v)) }
  /// Whether the instruction after the current one is the `check.callee` of v for target k.
  fn calleeNext(self: &Self, function: &Function, block: u32, v: u32, k: u32) -> bool {
    let inside = function.blocks.get(u32.toUsize(block))
    if self.cursor + 1 >= inside.firstInst + inside.instCount { return false }
    let next = function.inst(self.cursor + 1)
    return next.op == Op.CheckCallee && next.a == v && i32.wrappingToU32(next.k) == k
  }
  /// Whether the instruction after the store at `index` releases the stored value: the store
  /// then takes over the value's count in place of a count of its own and that release.
  fn movedInto(self: &Self, function: &Function, index: u32) -> bool {
    let store = function.inst(index)
    let block = function.blocks.get(u32.toUsize(store.block))
    if !self.on || index + 1 >= block.firstInst + block.instCount { return false }
    let next = function.inst(index + 1)
    return next.op == Op.Release && next.a == store.b && function.value(store.b).own == Own.Owned
  }
  /// Whether `read` (a get.elem) is followed in its block by the unbox of its result, the
  /// only reader of that result but for the unbox's own exit.
  /// Whether instruction `at` is a box.i32, box.bool, or box.f64 whose one reader is the
  /// trusted put.elem right after it, as its value: the store writes the tag and the number
  /// into the element, and boxes into the value's slot only on the way to its helper.
  fn storedBox(self: &Self, function: &Function, at: u32) -> bool {
    let box = function.inst(at)
    if (box.op != Op.BoxI32 && box.op != Op.BoxBool && box.op != Op.BoxF64) || box.result == NONE { return false }
    let block = function.blocks.get(u32.toUsize(box.block))
    if at + 1 >= block.firstInst + block.instCount { return false }
    let store = function.inst(at + 1)
    return store.op == Op.PutElem && store.trusted && store.b == box.result && self.uses.get(u32.toUsize(box.result)) == 1
  }
  fn fusedUnbox(self: &Self, function: &Function, read: Inst) -> bool {
    let block = function.blocks.get(u32.toUsize(read.block))
    if self.cursor + 1 >= block.firstInst + block.instCount { return false }
    let unbox = function.inst(self.cursor + 1)
    if unbox.op != Op.Unbox || unbox.a != read.result || unbox.result == NONE || unbox.exit == NONE { return false }
    let exit = function.exit(unbox.exit)
    let mut readers: u32 = 1
    let mut s: u32 = 0
    while s < function.slotCount(exit) {
      let slot = function.slot(exit, s)
      if slot.mode != SlotMode.Virtual && slot.value == read.result { readers = readers + 1 }
      s = s + 1
    }
    return self.uses.get(u32.toUsize(read.result)) == readers
  }
  /// Where the unbox fusedUnboxI32 folds into `read` is: the next instruction, or the first
  /// past integer constants that make no code there (an immediate, or a slot written where
  /// the function begins), which an exit taken early still finds. NONE past the block's end.
  fn unboxAt(self: &Self, function: &Function, read: Inst) -> u32 {
    let block = function.blocks.get(u32.toUsize(read.block))
    let end = block.firstInst + block.instCount
    let mut at = self.cursor + 1
    while at < end {
      let inst = function.inst(at)
      if inst.op != Op.ConstI32 || inst.result == NONE { return at }
      if !self.onlyImmediate(inst.result) && (!self.on || self.at(inst.result).kind == GPR) { return at }
      at = at + 1
    }
    return NONE
  }
  /// Whether the next instruction (unboxAt) is the plain unbox of `read`'s value (a keyed field or an
  /// owned variable cell, with a slot of its own) and nothing else reads it but that unbox's
  /// exit: the number loads from where the value is, and the value is copied to its slot
  /// only on the way to that exit (coldPieces).
  fn fusedUnboxI32(self: &Self, function: &Function, read: Inst) -> bool {
    if read.result == NONE || function.value(read.result).own != Own.Borrowed || self.settings.stress != 0 { return false }
    let at = self.unboxAt(function, read)
    if at == NONE { return false }
    let unbox = function.inst(at)
    if unbox.op != Op.Unbox || unbox.k != 0 || unbox.a != read.result || unbox.result == NONE || unbox.exit == NONE { return false }
    let layout = self.settings.layout
    if layout.tagWidth != 1 || layout.int() >= 256 { return false }
    if self.storage(read.result) != read.result { return false }
    if u32.toUsize(read.result) < self.aliased.length() && self.aliased.get(u32.toUsize(read.result)) { return false }
    let exit = function.exit(unbox.exit)
    let mut readers: u32 = 1
    let mut s: u32 = 0
    while s < function.slotCount(exit) {
      let slot = function.slot(exit, s)
      if slot.mode == SlotMode.Virtual {
        let vo = function.virtualObjs.get(u32.toUsize(slot.value))
        let mut fk: u32 = 0
        while fk < vo.slotCount {
          if vo.fields[u32.toUsize(fk)] == read.result { return false }
          fk = fk + 1
        }
      } else if slot.value == read.result { readers = readers + 1 }
      s = s + 1
    }
    return self.uses.get(u32.toUsize(read.result)) == readers
  }
  /// The number at `at` from `base` (a ValueBits) into the place of `unbox`'s result when it
  /// is an Int; anything else goes to `cold`.
  effect fn loadInt(self: &mut Self, unbox: Inst, base: Reg, at: i32, cold: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    run self.a.cmp8MemImm(Mem.at(base, at + u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.int()))
    run self.a.jcc(Cond.NotEqual, cold)
    let out = self.at(unbox.result)
    if out.kind == GPR { run self.a.load(Width.W32, out.gpr, Mem.at(base, at + 8)) }
    else { run self.a.load(Width.W32, Reg.R8, Mem.at(base, at + 8)) run putI32(&mut self.a, out, Reg.R8) }
  }
  fn fusedUnboxF64(self: &Self, function: &Function, read: Inst) -> bool {
    let block = function.blocks.get(u32.toUsize(read.block))
    if self.cursor + 1 >= block.firstInst + block.instCount { return false }
    let unbox = function.inst(self.cursor + 1)
    if unbox.op != Op.UnboxF64 || unbox.a != read.result || unbox.result == NONE || unbox.exit == NONE { return false }
    if self.storage(read.result) != read.result { return false }
    if u32.toUsize(read.result) < self.aliased.length() && self.aliased.get(u32.toUsize(read.result)) { return false }
    let exit = function.exit(unbox.exit)
    let mut readers: u32 = 1
    let mut s: u32 = 0
    while s < function.slotCount(exit) {
      let slot = function.slot(exit, s)
      if slot.mode == SlotMode.Virtual {
        let vo = function.virtualObjs.get(u32.toUsize(slot.value))
        let mut fk: u32 = 0
        while fk < vo.slotCount {
          if vo.fields[u32.toUsize(fk)] == read.result { readers = readers + 1 }
          fk = fk + 1
        }
      } else if slot.value == read.result { readers = readers + 1 }
      s = s + 1
    }
    return self.uses.get(u32.toUsize(read.result)) == readers
  }
  effect fn countUses(self: &mut Self, function: &Function) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = u32.toUsize(function.valueCount())
    run self.immediateUses.appendRepeated(0, count)
    run self.defs.appendRepeated(NONE, count)
    run self.constants.appendRepeated(Option<i32>.none(), count)
    let mut i: usize = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      if inst.result != NONE && inst.result < function.valueCount() {
        self.defs.set(u32.toUsize(inst.result), usize.toU32(i))
        if inst.op == Op.ConstI32 { self.constants.set(u32.toUsize(inst.result), Option<i32>.some(inst.k)) }
      }
      i = i + 1
    }
    i = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      if inst.b != NONE && inst.b < function.valueCount() {
        if immediateOperand(&function, inst) && self.constant(&function, inst.b) {
          let at = u32.toUsize(inst.b)
          let before = self.immediateUses.get(at)
          self.immediateUses.set(at, before + 1)
        }
      }
      i = i + 1
    }
    // A constant boxed into the element a trusted store writes (storedBox, which asks for
    // the uses counted above) is written from its immediate, there and on the store's way
    // to its helper.
    i = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      if inst.op == Op.BoxI32 && inst.a != NONE && inst.a < function.valueCount() && self.constant(&function, inst.a) && self.storedBox(&function, usize.toU32(i)) {
        let at = u32.toUsize(inst.a)
        let before = self.immediateUses.get(at)
        self.immediateUses.set(at, before + 1)
      }
      i = i + 1
    }
    i = 0
    while i < function.slots.length() {
      let slot = function.slots.get(i)
      if slot.mode == SlotMode.Virtual {
        let vo = function.virtualObjs.get(u32.toUsize(slot.value))
        let mut fk: u32 = 0
        while fk < vo.slotCount {
          let fv = vo.fields[u32.toUsize(fk)]
          if fv != NONE && fv < function.valueCount() && self.constant(&function, fv) {
            let at = u32.toUsize(fv)
            let before = self.immediateUses.get(at)
            self.immediateUses.set(at, before + 1)
          }
          fk = fk + 1
        }
      } else {
        let v = slot.value
        // An exit writes a constant from its immediate (valueInto), so it needs no register.
        if v != NONE && v < function.valueCount() && self.constant(&function, v) {
          let at = u32.toUsize(v)
          let before = self.immediateUses.get(at)
          self.immediateUses.set(at, before + 1)
        }
      }
      i = i + 1
    }
  }
  fn constant(self: &Self, function: &Function, v: u32) -> bool {
    return self.constants.get(u32.toUsize(v)).isSome()
  }
  fn onlyImmediate(self: &Self, v: u32) -> bool {
    return self.uses.get(u32.toUsize(v)) == self.immediateUses.get(u32.toUsize(v))
  }
  /// Stores the value read into RAX and R9 to v's slot, unless the one reader of v is the
  /// jump right after it with v its edge's only argument and nothing shares v's slot: that
  /// edge's move stores it from RAX and R9 (moveValue on a fresh value) into the parameter's.
  /// The caller marks v fresh after this, with no jump target bound before the jump.
  effect fn storeFresh(self: &mut Self, function: &Function, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.lazy.get(u32.toUsize(v)) { self.unstored = v return () }
    if !self.edgeOnly(function, v) {
      run self.a.store(Width.W64, slotOf(v), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(v), Reg.R9)
    }
  }
  /// Marks the values whose slot only exits read (lazy): the instructions right after the
  /// one that makes v, in its block, read v from RAX and R9 and keep the two up to each of
  /// their jumps to their exits, and no other instruction, edge or exit reads v. Those
  /// readers are a check.shape of v outside a shape dispatch, a check.watched of v, a
  /// get.field of v at the slot its key names, and a put.field of v to the slot its key names
  /// in another object (lazyReader). Frame mode.
  effect fn lazyStores(self: &mut Self, function: &Function) -> () ! OutOfMemoryError ? &mut Allocator {
    let values = function.valueCount()
    run self.lazy.appendRepeated(false, u32.toUsize(values))
    run self.lazyExits.appendRepeated(NONE, function.exits.length())
    if !self.on || self.settings.stress != 0 || self.settings.layout.tagWidth != 1 { return () }
    // How many instructions leave by each exit: a lazy value's must have one.
    let mut owners = List<u32>.make()
    run owners.appendRepeated(0, function.exits.length())
    let mut i: usize = 0
    while i < function.insts.length() {
      let x = function.insts.get(i).exit
      if x != NONE && u32.toUsize(x) < owners.length() { let before = owners.get(u32.toUsize(x)) owners.set(u32.toUsize(x), before + 1) }
      i = i + 1
    }
    i = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      let v = inst.result
      if v != NONE && v < values && function.value(v).ty == Type.Value && self.storage(v) == v && !self.aliased.get(u32.toUsize(v)) && !self.isPreset(v) {
        let block = function.blocks.get(u32.toUsize(inst.block))
        let end = block.firstInst + block.instCount
        let first = usize.toU32(i) + 1
        let mut j = first
        let mut reads: u32 = 0
        while j < end && self.lazyStep(function, j, v, &owners) {
          if function.inst(j).op != Op.InlineFrame { reads = reads + 1 + exitReads(function, function.inst(j).exit, v) }
          j = j + 1
        }
        if reads != 0 && reads == self.uses.get(u32.toUsize(v)) { self.lazy.set(u32.toUsize(v), true) }
      }
      i = i + 1
    }
    // A block's one parameter, when every way in is a jump that moves a value to it: each
    // leaves it in RAX and R9 (moveValue), and the block begins with it fresh.
    let blocks = function.blockCount()
    let mut entered = List<bool>.make()
    run entered.appendRepeated(true, u32.toUsize(blocks))
    let mut b: u32 = 0
    while b < blocks {
      let block = function.blocks.get(u32.toUsize(b))
      if block.instCount != 0 {
        let term = function.terminator(block)
        let mut e: u32 = 0
        while e < ssa.edgeCount(term.op) {
          let edge = function.edge(term.edge + e)
          let target = function.blocks.get(u32.toUsize(edge.target))
          if term.op != Op.Jump || self.through(function, b) != NONE || edge.argCount != 1 || target.paramCount != 1 || self.key(function.edgeArg(edge, 0)) == self.key(function.paramAt(target, 0)) { entered.set(u32.toUsize(edge.target), false) }
          e = e + 1
        }
      }
      b = b + 1
    }
    b = 1
    while b < blocks {
      let block = function.blocks.get(u32.toUsize(b))
      if block.paramCount == 1 && entered.get(u32.toUsize(b)) && armShapeAt(function, b) == NONE {
        let v = function.paramAt(block, 0)
        if function.value(v).ty == Type.Value && self.storage(v) == v && !self.aliased.get(u32.toUsize(v)) && !self.isPreset(v) {
          let end = block.firstInst + block.instCount
          let mut j = block.firstInst
          let mut reads: u32 = 0
          while j < end && self.lazyStep(function, j, v, &owners) {
            if function.inst(j).op != Op.InlineFrame { reads = reads + 1 + exitReads(function, function.inst(j).exit, v) }
            j = j + 1
          }
          if reads != 0 && reads == self.uses.get(u32.toUsize(v)) { self.lazy.set(u32.toUsize(v), true) }
        }
      }
      b = b + 1
    }
  }
  /// Whether instruction j is a lazy reader of v (lazyReader) or an `inline.frame` of
  /// another value, which makes no code.
  fn lazyStep(self: &Self, function: &Function, j: u32, v: u32, owners: &List<u32>) -> bool {
    let inst = function.inst(j)
    if inst.op == Op.InlineFrame { return inst.a != v }
    return self.lazyReader(function, j, v, owners)
  }
  /// Whether instruction j reads v once, from RAX and R9 when v is fresh, keeping the two
  /// up to each jump to its exit, which only it leaves by (lazyStores).
  fn lazyReader(self: &Self, function: &Function, j: u32, v: u32, owners: &List<u32>) -> bool {
    let inst = function.inst(j)
    if inst.exit == NONE || u32.toUsize(inst.exit) >= owners.length() || owners.get(u32.toUsize(inst.exit)) != 1 { return false }
    if inst.op == Op.CheckShape { return inst.a == v && self.shapes.armAt(j) == 0 && armShapeAt(function, inst.block) != j }
    if inst.op == Op.CheckWatched { return inst.a == v }
    if inst.op == Op.GetField { return inst.a == v && self.shapes.sameAs(j) == NONE && self.shapes.key(j) != 0 }
    if inst.op == Op.PutField { return inst.b == v && inst.a != v && self.shapes.key(j) != 0 }
    return false
  }
  /// At a lazy reader of v (lazyReader) that finds v fresh: its exit's stub stores v from
  /// RAX and R9. One that does not, after storeFresh left v's slot alone, cannot be lowered.
  fn lazyAt(self: &mut Self, v: u32, exit: u32) -> () {
    if v == NONE || u32.toUsize(v) >= self.lazy.length() || !self.lazy.get(u32.toUsize(v)) { return () }
    if !self.isFresh(v) { if self.unstored == v { self.fault = true } return () }
    self.lazyExits.set(u32.toUsize(exit), v)
  }
  fn edgeOnly(self: &Self, function: &Function, v: u32) -> bool {
    if !self.on || self.settings.stress != 0 || self.uses.get(u32.toUsize(v)) != 1 || self.storage(v) != v || self.aliased.get(u32.toUsize(v)) || self.isPreset(v) { return false }
    let next = self.cursor + 1
    if u32.toUsize(next) >= function.insts.length() { return false }
    let jump = function.inst(next)
    if jump.op != Op.Jump || jump.block != function.inst(self.cursor).block { return false }
    let edge = function.edge(jump.edge)
    if edge.argCount != 1 || function.edgeArg(edge, 0) != v { return false }
    let into = function.paramAt(function.blocks.get(u32.toUsize(edge.target)), 0)
    return self.key(into) != self.key(v) && function.value(into).ty == Type.Value
  }
  /// The value whose slot holds v's bits (stored).
  pub fn storage(self: &Self, v: u32) -> u32 {
    if u32.toUsize(v) < self.stored.length() { return self.stored.get(u32.toUsize(v)) }
    return v
  }
  /// One more count for the value in v's slot, when it is a heap reference (known to be one
  /// when object). Clobbers RAX and R9.
  effect fn count(self: &mut Self, v: u32, object: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let fresh = self.isFresh(v)
    if !fresh { run self.a.load(Width.W64, Reg.R9, payloadOf(v)) }
    if object { run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R9, 0), 1) return () }
    if !fresh { run self.a.load(Width.W64, Reg.Rax, slotOf(v)) }
    run self.retainBits(Reg.Rax, Reg.R9)
    self.setFresh(v)
  }
  /// Whether compare's only reader is its block's terminator, a branch, with no code between.
  fn fusedCompare(self: &Self, function: &Function, compare: Inst) -> bool {
    if !(compare.op == Op.Cmp || (compare.op == Op.CmpF64 && float.ordered(compare.k))) || self.uses.get(u32.toUsize(compare.result)) != 1 { return false }
    let block = function.blocks.get(u32.toUsize(compare.block))
    let last = block.firstInst + block.instCount - 1
    let branch = function.inst(last)
    if branch.op != Op.Branch || branch.a != compare.result { return false }
    // Find compare, then only code-free instructions until the branch.
    let mut i = block.firstInst
    while i < last && function.inst(i).result != compare.result { i = i + 1 }
    i = i + 1
    while i < last { if function.inst(i).op != Op.Release { return false } i = i + 1 }
    return true
  }
  /// Whether a tag test's only reader is its block's branch, with nothing but releases
  /// between, and one compare tells its tags: the branch then tests the tag itself (a slot
  /// keeps its bits after a release). Frame mode.
  fn fusedTag(self: &Self, function: &Function, test: Inst) -> bool {
    if !self.on || test.op != Op.TagIs || test.result == NONE || self.uses.get(u32.toUsize(test.result)) != 1 { return false }
    let layout = self.settings.layout
    let k = test.k & 7
    let neighbours = layout.undefined() == layout.null() + 1 || layout.null() == layout.undefined() + 1
    if k != 1 && k != 2 && k != 4 && !(k == 3 && neighbours) { return false }
    let block = function.blocks.get(u32.toUsize(test.block))
    let last = block.firstInst + block.instCount - 1
    let branch = function.inst(last)
    if branch.op != Op.Branch || branch.a != test.result { return false }
    let mut i = block.firstInst
    while i < last && function.inst(i).result != test.result { i = i + 1 }
    i = i + 1
    while i < last { if function.inst(i).op != Op.Release { return false } i = i + 1 }
    return true
  }
  /// Whether an `equals` is its block's last instruction before the branch that is its only
  /// reader (frame mode): the branch tests the answer's flags (equalsFlags).
  fn fusedEquals(self: &Self, function: &Function, test: Inst) -> bool {
    if !self.on || test.op != Op.Equals || test.result == NONE || self.uses.get(u32.toUsize(test.result)) != 1 { return false }
    let block = function.blocks.get(u32.toUsize(test.block))
    if block.instCount < 2 { return false }
    let last = block.firstInst + block.instCount - 1
    let branch = function.inst(last)
    return branch.op == Op.Branch && branch.a == test.result && function.inst(last - 1).result == test.result
  }
  /// The `equals` test (fusedEquals) as flags: Equal when it holds. Fast cases run inline;
  /// anything else runs in STEP_EQUALS_SLOW.
  effect fn equalsFlags(self: &mut Self, function: &Function, given: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut inst = given
    inst.a = self.storage(inst.a)
    inst.b = self.storage(inst.b)
    run self.stressGuard(inst.exit)
    let slow = run self.a.label()
    let decided = run self.a.label()
    // The test is lowered at its branch: what it keeps is under its own index.
    let number = self.cuts.kept(self.defs.get(u32.toUsize(given.result)))
    let layout = self.settings.layout
    // In frame mode the general test is out of line, and the numbers' compare runs on.
    let outlined = self.on && number != NONE && layout.tagWidth == 1 && layout.int() < 256
    if number != NONE && layout.tagWidth == 1 && layout.int() < 256 {
      // One operand is an Int whose number an unbox before this made (knownInts): when the
      // other is an Int too, the numbers answer.
      let other = self.otherOf(&function, inst, number)
      let general = run self.a.label()
      let place = self.at(number)
      let mut left = Reg.R8
      if place.kind == GPR { left = place.gpr }
      if self.cellFor == self.defs.get(u32.toUsize(given.result)) {
        // The other operand is a variable cell's value, not read yet (fusedEqualsVar): an
        // Int there is compared in the cell, anything else goes to its slot first.
        self.cellFor = NONE
        let f = self.plan.f
        run self.a.movSymbol(Reg.Rax, self.cellSymbol)
        run self.a.cmp8MemImm(Mem.at(Reg.Rax, signed(f.refValue) + u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.int()))
        run self.a.jcc(Cond.NotEqual, general)
        if place.kind != GPR { run getI32(&mut self.a, Reg.R8, place) }
        run self.a.aluLoad(Alu.Cmp, Width.W32, left, Mem.at(Reg.Rax, signed(f.refValue + 8)))
        if outlined { run self.a.beginOutlined() } else { run self.a.jmp(decided) }
        self.a.bind(general)
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rax, signed(f.refValue + 8)))
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.refValue)))
        run self.a.store(Width.W64, slotOf(other), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(other), Reg.R9)
      } else {
        run self.a.cmp8MemImm(Mem.at(Reg.Rsp, u32.wrappingToI32(other * SLOT_BYTES + layout.tagOffset)), u32.wrappingToU8(layout.int()))
        run self.a.jcc(Cond.NotEqual, general)
        if place.kind != GPR { run getI32(&mut self.a, Reg.R8, place) }
        run self.a.aluLoad(Alu.Cmp, Width.W32, left, payloadOf(other))
        if outlined { run self.a.beginOutlined() } else { run self.a.jmp(decided) }
        self.a.bind(general)
      }
    }
    let mode = run self.equalsFast(&function, inst.a, inst.b, inst.k != 0, slow, decided, true, decided)
    if outlined { run self.a.jmp(decided) run self.a.endOutlined() }
    self.a.bind(decided)
    if mode != EQUALS_NO_SLOW {
      let mut extra = u32.bitOr(i32.wrappingToU32(inst.k), 2)
      if mode == EQUALS_DIRECT_SLOW { extra = extra | 8 }
      run self.stepSlows.append(StepSlow { entry: slow, auxLabel: decided, back: decided, inst: inst, step: 0, shape: 0, out: NONE, extra: extra, kind: STEP_EQUALS_SLOW })
    }
  }
  /// Of the operands' slots of the `equals` test (storage applied) that keeps `number`
  /// (knownInts): the one that is not the number's value.
  fn otherOf(self: &Self, function: &Function, test: Inst, number: u32) -> u32 {
    if self.storage(function.inst(self.defs.get(u32.toUsize(number))).a) == self.storage(test.b) { return self.storage(test.a) }
    return self.storage(test.b)
  }
  /// Whether the instruction after `read` (an owned variable cell's, borrowed, with a slot of
  /// its own) is an `equals` lowered at its branch (fusedEquals) that keeps the number of its
  /// other operand (knownInts), and nothing reads the variable's value but that test and its
  /// exit: the test compares in the cell, and the value goes to its slot only where the cell
  /// holds no Int (equalsFlags).
  fn fusedEqualsVar(self: &Self, function: &Function, read: Inst) -> bool {
    if read.result == NONE || function.value(read.result).own != Own.Borrowed || self.settings.stress != 0 { return false }
    let block = function.blocks.get(u32.toUsize(read.block))
    if self.cursor + 1 >= block.firstInst + block.instCount { return false }
    let test = function.inst(self.cursor + 1)
    if test.op != Op.Equals || test.frame != read.frame || test.exit == NONE || !self.fusedEquals(function, test) { return false }
    let number = self.cuts.kept(self.cursor + 1)
    let layout = self.settings.layout
    if number == NONE || layout.tagWidth != 1 || layout.int() >= 256 { return false }
    if self.storage(read.result) != read.result || self.otherOf(function, test, number) != read.result { return false }
    if u32.toUsize(read.result) < self.aliased.length() && self.aliased.get(u32.toUsize(read.result)) { return false }
    let exit = function.exit(test.exit)
    let mut readers: u32 = 1
    let mut s: u32 = 0
    while s < function.slotCount(exit) {
      let slot = function.slot(exit, s)
      if slot.mode == SlotMode.Virtual {
        let vo = function.virtualObjs.get(u32.toUsize(slot.value))
        let mut fk: u32 = 0
        while fk < vo.slotCount {
          if vo.fields[u32.toUsize(fk)] == read.result { return false }
          fk = fk + 1
        }
      } else if slot.value == read.result { readers = readers + 1 }
      s = s + 1
    }
    return self.uses.get(u32.toUsize(read.result)) == readers
  }
  /// fusedTag for `is.callee`.
  fn fusedCallee(self: &Self, function: &Function, test: Inst) -> bool {
    if !self.on || test.op != Op.IsCallee || test.result == NONE || self.uses.get(u32.toUsize(test.result)) != 1 { return false }
    let block = function.blocks.get(u32.toUsize(test.block))
    let last = block.firstInst + block.instCount - 1
    let branch = function.inst(last)
    if branch.op != Op.Branch || branch.a != test.result { return false }
    let mut i = block.firstInst
    while i < last && function.inst(i).result != test.result { i = i + 1 }
    i = i + 1
    while i < last { if function.inst(i).op != Op.Release { return false } i = i + 1 }
    return true
  }
  /// Whether inline target k's method is known while a watched object stays watched
  /// (ssa.TARGET_KNOWN), and the relocation symbol of that object.
  fn known(self: &Self, function: &Function, k: u32) -> bool {
    return u32.bitAnd(function.inlineTargets.get(u32.toUsize(k)), ssa.TARGET_KNOWN) != 0
  }
  /// The relocation symbol of watched object j of the chain inline target k's method is
  /// read through for its known shape `pair`.
  fn chainSymbol(self: &Self, function: &Function, k: u32, pair: u32, j: u32) -> u32 {
    return self.symbol(usize.toU32(function.inlineTargets.length()) * 3 + usize.toU32(self.ownedCells.length()) + k * ssa.KNOWN_SYMBOLS + pair * ssa.KNOWN_CHAIN + j)
  }
  /// The relocation symbol of string cell n of the code's linked atoms (Function.linkedAtoms),
  /// after the array natives'.
  fn atomSymbol(self: &Self, function: &Function, n: u32) -> u32 { return self.arraySymbol(function, 3) + n }
  /// The relocation symbol of the realm's String.prototype (0 when it has none), after the
  /// array natives'.
  fn stringSymbol(self: &Self, function: &Function) -> u32 { return self.arraySymbol(function, 2) }
  /// stringSymbol when the cached read `inst` of a string may be served from String.prototype
  /// as js_compiled_objects.readField serves it (frame mode; any name but `length` and an
  /// index, which a string has of its own), else NONE.
  fn stringRead(self: &Self, function: &Function, inst: Inst) -> u32 {
    if !self.on { return NONE }
    let atom = function.fieldAtom(inst)
    if atom == 0 || atom == atomData.JS_ATOM_length || atom >= 0x80000000 { return NONE }
    return self.stringSymbol(function)
  }
  /// The relocation symbol of construct descriptor k (Function.constructTargets), after the
  /// linked atoms'.
  pub fn constructSymbol(self: &Self, function: &Function, k: u32) -> u32 { return self.atomSymbol(function, usize.toU32(self.atoms.length())) + k }
  /// The relocation symbol of the realm's Array.prototype push (which 0) or pop (1), a
  /// native function object, or of nothing when the realm has none.
  fn arraySymbol(self: &Self, function: &Function, which: u32) -> u32 {
    let targets = usize.toU32(function.inlineTargets.length())
    return self.symbol(targets * 3 + usize.toU32(self.ownedCells.length()) + targets * ssa.KNOWN_SYMBOLS + which)
  }
  /// Before a method call under the name of Array.prototype's push or pop
  /// (calls.nativeOf): when the callee in the cell at base + callee is that native, a helper
  /// does the operation on a fast Array that needs no more room (helpers.ARRAY_PUSH,
  /// ARRAY_POP), else the engine does it with no call (frames.SERVICE_ARRAY), and the owned
  /// result is the call's; that goes to `done`. Any other callee, and an array the engine
  /// declines, falls through to the call. The receiver is in the cell before the callee's
  /// and the arguments in the cells after it; pc is where the function's own frame is.
  effect fn arrayCall(self: &mut Self, function: &Function, inst: Inst, base: Reg, callee: i32, pc: u32, done: Label, early: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let native = calls.nativeOf(inst)
    if native == 0 { return () }
    let general = run self.a.label()
    let slow = run self.a.label()
    let mut which: u32 = 0
    if calls.isPop(native) { which = 1 }
    let object = self.arraySymbol(function, which)
    run self.a.movSymbol(Reg.R10, object)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R10, Mem.at(base, callee + 8))
    run self.a.jcc(Cond.NotEqual, general)
    let baseBit: u32 = if base == Reg.Rbp { 0 } else { 1 }
    let mut inlined = false
    if native == calls.NATIVE_PUSH && !early { inlined = run self.pushInPlace(function, base, callee - 16, base, callee + 16, inst.result, done, slow) }
    if !inlined {
      // A fast Array that needs no more room: the helper's, with no service.
      run self.a.lea(Width.W64, Reg.Rsi, Mem.at(base, callee - 16))
      if calls.isPop(native) {
        run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.result))
        run self.callHelper(helpers.ARRAY_POP)
      } else {
        run self.a.lea(Width.W64, Reg.Rdx, Mem.at(base, callee + 16))
        run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
        run self.callHelper(helpers.ARRAY_PUSH)
      }
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, slow)
      run self.a.jmp(done)
    }
    let extra = if inlined { u32.bitOr(baseBit, 2) } else { baseBit }
    run self.stepSlows.append(StepSlow { entry: slow, auxLabel: general, back: done, inst: inst, step: pc, shape: i32.wrappingToU32(callee), out: i32.wrappingToU32(native), extra: extra, kind: STEP_ARRAY_SLOW })
    self.a.bind(general)
  }
  /// A pop that runs no JavaScript (calls.NATIVE_POP_QUIET): the helper pops the receiver's
  /// last element when the callee is Array.prototype.pop and the receiver a fast Array it
  /// pops (helpers.ARRAY_POP), and the owned element is the result. Anything else leaves by
  /// the call's exit, the state before the call, as a guard that failed.
  effect fn quietPop(self: &mut Self, function: &Function, inst: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let exit = self.exitLabels.get(u32.toUsize(inst.exit))
    let receiver = function.value(inst.b).ty
    if function.value(inst.a).ty != Type.Value || receiver != Type.Value { run self.a.jmp(exit) return () }
    run self.stressGuard(inst.exit)
    let object = self.arraySymbol(function, 1)
    let callee = self.storage(inst.a)
    let held = self.storage(inst.b)
    run self.a.movSymbol(Reg.R10, object)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R10, payloadOf(callee))
    run self.a.jcc(Cond.NotEqual, exit)
    run self.a.lea(Width.W64, Reg.Rsi, slotOf(held))
    run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.result))
    run self.callHelper(helpers.ARRAY_POP)
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, exit)
  }
  /// Whether v's one reader is a release later in the block of the instruction being lowered,
  /// with only other releases between.
  fn releasedOnly(self: &Self, function: &Function, v: u32) -> bool {
    if self.storage(v) != v { return false }
    let block = function.inst(self.cursor).block
    let mut i = self.cursor + 1
    while u32.toUsize(i) < function.insts.length() {
      let next = function.inst(i)
      if next.block != block || next.op != Op.Release { return false }
      if next.a == v { return true }
      i = i + 1
    }
    return false
  }
  /// Whether pushInPlace can be emitted for this code (a fresh array's shape is known).
  fn pushInline(self: &Self, function: &Function) -> bool {
    let fields = self.fields
    return function.arrayShape != 0 && fields.objectClass == fields.objectFlags + 2 && fields.arrayClass < 65536 && fields.fastArray < 256 && fields.extensibleFlag < 256
  }
  /// pushInPlace before the call's callee and receiver are copied to its cells: they are
  /// read where the code keeps them, the argument from its cell at base + argument (placed
  /// by its call.arg). Anything else goes on to the copies and the call (arrayCall then
  /// skips the push in place). Returns whether emitted.
  effect fn pushEarly(self: &mut Self, function: &Function, inst: Inst, base: Reg, argument: i32, done: Label) -> bool ! OutOfMemoryError ? &mut Allocator {
    if calls.nativeOf(inst) != calls.NATIVE_PUSH || !self.pushInline(function) || self.settings.stress != 0 { return false }
    if function.value(inst.a).ty != Type.Value || function.value(inst.b).ty != Type.Value { return false }
    let fill = run self.a.label()
    let object = self.arraySymbol(function, 0)
    let callee = self.storage(inst.a)
    let held = self.storage(inst.b)
    run self.a.movSymbol(Reg.R10, object)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R10, payloadOf(callee))
    run self.a.jcc(Cond.NotEqual, fill)
    drop run self.pushInPlace(function, Reg.Rsp, u32.wrappingToI32(held * SLOT_BYTES), base, argument, inst.result, done, fill)
    self.a.bind(fill)
    return true
  }
  /// `push` of the one argument after the callee's cell at base + callee onto the receiver
  /// in the cell before it, in place, as arraySupport.pushInto does it: when the receiver is
  /// a fast Array that is extensible and not watched, of a fresh array's shape
  /// (Function.arrayShape: `length` is its writable slot 0, of the realm's prototype), whose
  /// prototype leaves element reads to arrays' own elements, whose length is its element
  /// count and whose elements have room for one more. The element takes a count of its own
  /// (the cell keeps the code's), a heap value clears the plain flag, and the new length is
  /// the result, then `done`. Anything else jumps to `slow`. Returns whether emitted.
  effect fn pushInPlace(self: &mut Self, function: &Function, held: Reg, receiver: i32, base: Reg, argument: i32, result: u32, done: Label, slow: Label) -> bool ! OutOfMemoryError ? &mut Allocator {
    let fields = self.fields
    let layout = self.settings.layout
    if !self.pushInline(function) { return false }
    let plainKept = run self.a.label()
    run self.loadTag(Reg.R8, Mem.at(held, receiver + u32.wrappingToI32(layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.load(Width.W64, Reg.R11, Mem.at(held, receiver + 8))
    // Class Array with the fast-array and extensible flags: the flags byte and the 16-bit
    // class share one 32-bit word (as elementSlot tests them).
    let flags = u32.bitOr(fields.fastArray, fields.extensibleFlag)
    run self.a.load(Width.W32, Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)))
    run self.a.aluImm(Alu.And, Width.W32, Reg.R8, u32.wrappingToI32(u32.bitOr(0xffff0000, flags)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(u32.bitOr(u32.shiftLeft(fields.arrayClass, 16), flags)))
    run self.a.jcc(Cond.NotEqual, slow)
    // Writing slot 0 ends a watch (setSlot): a watched array is the helper's.
    run self.a.test8MemImm(Mem.at(Reg.R11, u32.wrappingToI32(fields.objectRoles)), u32.wrappingToU8(fields.watched))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.load(Width.W64, Reg.R10, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectShape)))
    run self.a.aluStoreImm(Alu.Cmp, Width.W64, Mem.at(Reg.R10, u32.wrappingToI32(fields.shapeVersion)), u32.wrappingToI32(function.arrayShape))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.load(Width.W64, Reg.R10, Mem.at(Reg.R10, u32.wrappingToI32(fields.shapePrototype)))
    run self.a.test(Width.W64, Reg.R10, Reg.R10)
    run self.a.jcc(Cond.Equal, slow)
    run self.a.test8MemImm(Mem.at(Reg.R10, u32.wrappingToI32(fields.objectFlags)), u32.wrappingToU8(fields.standardPrototype))
    run self.a.jcc(Cond.Equal, slow)
    // The length, an Int in slot 0, is the element count, and there is room for one more.
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectSlots)))
    run self.loadTag(Reg.R8, Mem.at(Reg.R9, u32.wrappingToI32(layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R9, 8))
    run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.Rax, Mem.at(Reg.R11, u32.wrappingToI32(fields.elementCount)))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.load(Width.W32, Reg.Rcx, Mem.at(Reg.R11, u32.wrappingToI32(fields.elementMeta)))
    run self.a.aluImm(Alu.And, Width.W32, Reg.Rcx, u32.wrappingToI32(fields.capacityMask))
    run self.a.alu(Alu.Cmp, Width.W32, Reg.Rax, Reg.Rcx)
    run self.a.jcc(Cond.AboveOrEqual, slow)
    // The element's own count; a heap value makes the elements not plain (noteStored).
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(base, argument))
    run self.a.load(Width.W64, Reg.Rsi, Mem.at(base, argument + 8))
    run self.heapTest(Reg.Rdx, plainKept)
    run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.Rsi, 0), 1)
    run self.a.alu(Alu.Xor, Width.W32, Reg.Rcx, Reg.Rcx)
    run self.a.store8(Mem.at(Reg.R11, u32.wrappingToI32(fields.elementPlain)), Reg.Rcx)
    self.a.bind(plainKept)
    // The element at 16 times the count (below the capacity, so twice it fits 32 bits).
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.elements)))
    run self.a.lea(Width.W32, Reg.Rcx, Mem.indexed(Reg.Rax, Reg.Rax, Scale.One, 0))
    run self.a.store(Width.W64, Mem.indexed(Reg.R8, Reg.Rcx, Scale.Eight, 0), Reg.Rdx)
    run self.a.store(Width.W64, Mem.indexed(Reg.R8, Reg.Rcx, Scale.Eight, 8), Reg.Rsi)
    run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R11, u32.wrappingToI32(fields.elementCount)), 1)
    run self.a.aluImm(Alu.Add, Width.W32, Reg.Rax, 1)
    run self.a.store(Width.W64, Mem.at(Reg.R9, 8), Reg.Rax)
    // A length only a release reads: the release reads its tag alone (an Int's is no count).
    let tagWord = layout.tagWord(layout.int())
    if self.uses.get(u32.toUsize(result)) == 1 && self.releasedOnly(function, result) && tagWord <= 0x7fffffff { run self.a.storeImm(Width.W64, slotOf(result), u64.wrappingToI32(tagWord)) }
    else { run self.boxInto(false, Reg.Rax, Reg.Rsp, result * SLOT_BYTES) }
    run self.a.jmp(done)
    return true
  }
  /// The tests of a known method's shapes for inline target k, with the shape's version in
  /// R8 (or proved to be `proven`, when not 0): falls through when the object has one of
  /// the target's shapes and every object its read goes through is still watched, else
  /// `general`. An object of such a shape that is not exotic then reads the target's
  /// closure (ssa.TARGET_KNOWN).
  /// `at`, the read (or NONE), tells how many of each shape's watched objects were tested
  /// before it with nothing since that could end a watch (ssa_shapes.Shapes.watchedAt).
  effect fn knownShapes(self: &mut Self, function: &Function, k: u32, proven: u64, skip: u32, at: u32, general: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let fields = self.fields
    let known = function.inlineShapes.get(u32.toUsize(k))
    let hit = run self.a.label()
    let mut pair: usize = 0
    while pair < 4 && known.shapes[pair] != 0 {
      let last = pair == 3 || known.shapes[pair + 1] == 0
      let mut next = general
      if !last { next = run self.a.label() }
      if proven == 0 {
        run self.a.aluImm(Alu.Cmp, Width.W64, Reg.R8, u32.wrappingToI32(known.shapes[pair]))
        run self.a.jcc(Cond.NotEqual, next)
      }
      if proven == 0 || proven == u32.toU64(known.shapes[pair]) {
        // Of a proven shape, the first `skip` were tested before (ssa_shapes.testedWatched).
        let mut j: u32 = 0
        if proven != 0 { j = skip }
        let before = self.shapes.watchedAt(at, u32.toU64(known.shapes[pair]))
        if before > j { j = before }
        while j < u8.toU32(known.lengths[pair]) {
          let watched = self.chainSymbol(function, k, usize.toU32(pair), j)
          run self.a.movSymbol(Reg.R10, watched)
          run self.a.test8MemImm(Mem.at(Reg.R10, u32.wrappingToI32(fields.objectRoles)), u32.wrappingToU8(fields.watched))
          run self.a.jcc(Cond.Equal, general)
          j = j + 1
        }
        if !last { run self.a.jmp(hit) }
      }
      if !last { self.a.bind(next) }
      pair = pair + 1
    }
    self.a.bind(hit)
  }
  /// The shape dispatch of a cached read followed by nothing but the tests of what it read
  /// (shapeArms): the receiver's shape tells the callee. An object of one of an arm's
  /// shapes that is not exotic, while the prototypes the method is read through are
  /// watched, has the arm's closure as its method: that goes to the read's slot, with its
  /// count, and the code goes on in the arm's body. Any other receiver goes to `general`.
  effect fn knownArms(self: &mut Self, function: &Function, inst: Inst, arms: &List<u32>, object: bool, borrowed: bool, general: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    if !object { run self.unlessTag(inst.a, layout.object(), general) }
    let held = run self.objectIn(inst.a)
    run self.a.test8MemImm(Mem.at(held, u32.wrappingToI32(fields.objectFlags)), u32.wrappingToU8(fields.exotic))
    run self.a.jcc(Cond.NotEqual, general)
    run self.a.load(Width.W64, Reg.R8, Mem.at(held, u32.wrappingToI32(fields.objectShape)))
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R8, u32.wrappingToI32(fields.shapeVersion)))
    let mut arm: usize = 0
    while arm < arms.length() {
      let k = arms.get(arm)
      let mut next = general
      if arm + 2 < arms.length() { next = run self.a.label() }
      let at = self.cursor
      run self.knownShapes(function, k, 0, 0, at, next)
      if !self.isArmed(inst.result) {
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.object()))
        let closure = self.symbol(k * 3 + 2)
        run self.a.movSymbol(Reg.R9, closure)
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        if !borrowed { run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R9, 0), 1) }
      }
      let block = arms.get(arm + 1)
      if self.armEntry(function, block, inst.a, k) { run self.a.jmp(self.armLabels.get(u32.toUsize(block))) }
      else { self.slotsArrive(block, SLOTS_MIXED) run self.a.jmp(self.blockLabels.get(u32.toUsize(block))) }
      if arm + 2 < arms.length() { self.a.bind(next) }
      arm = arm + 2
    }
  }
  /// Whether `block`, an arm of a shape dispatch for inline target k (knownArms) on the
  /// object in `object`'s storage, begins with the `check.shape` of that object for k's one
  /// shape (after `inline.frame`s, which make no code): the dispatch proved it, and goes
  /// past it (armLabels).
  fn armEntry(self: &Self, function: &Function, block: u32, object: u32, k: u32) -> bool {
    let at = armShapeAt(function, block)
    if at == NONE { return false }
    let first = function.inst(at)
    if first.op != Op.CheckShape || self.storage(first.a) != object { return false }
    let shapes = function.inlineShapes.get(u32.toUsize(k)).shapes
    return shapes[1] == 0 && u32.wrappingToI32(shapes[0]) == first.k
  }
  /// The known path of a cached read whose method is inline target `target`'s
  /// (knownRead): an object of one of the target's shapes that is not exotic reads the
  /// target's closure while the prototypes it is read through are watched. The read is
  /// then these tests and the closure as a constant, in the read's slot with its count (a
  /// preset value's slot holds it already); any other case goes to `general`. `proven` is
  /// the version the facts proved of the object's shape, or 0.
  effect fn knownOne(self: &mut Self, function: &Function, inst: Inst, target: u32, object: bool, proven: u64, tested: u8, borrowed: bool, general: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    if !object { run self.unlessTag(inst.a, layout.object(), general) }
    // What earlier tests proved (ssa_shapes.Shapes.tested): the object not exotic, and the
    // first watched objects of its proven shape.
    let mut held = Reg.R11
    if (tested & TESTED_PLAIN) == 0 || proven == 0 {
      held = run self.objectIn(inst.a)
      if (tested & TESTED_PLAIN) == 0 {
        run self.a.test8MemImm(Mem.at(held, u32.wrappingToI32(fields.objectFlags)), u32.wrappingToU8(fields.exotic))
        run self.a.jcc(Cond.NotEqual, general)
      }
    }
    if proven == 0 {
      run self.a.load(Width.W64, Reg.R8, Mem.at(held, u32.wrappingToI32(fields.objectShape)))
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R8, u32.wrappingToI32(fields.shapeVersion)))
    }
    let at = self.cursor
    run self.knownShapes(function, target, proven, testedWatched(tested), at, general)
    if !self.isPreset(inst.result) {
      run self.a.movImm64(Reg.Rax, layout.tagWord(layout.object()))
      let closure = self.symbol(target * 3 + 2)
      run self.a.movSymbol(Reg.R9, closure)
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      // An owned result takes its count of the closure, an object.
      if !borrowed { run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R9, 0), 1) }
    }
  }
  /// Whether inline target k is tested by its one closure (ssa.TARGET_EXACT).
  fn exact(self: &Self, function: &Function, k: u32) -> bool {
    return u32.bitAnd(function.inlineTargets.get(u32.toUsize(k)), ssa.TARGET_EXACT) != 0
  }
  /// Equal when the value in slot test.a is a bytecode closure (tag, class) whose
  /// FunctionBytecode cell is inline target test.k's, or that target's one closure when it
  /// is exact. Clobbers RAX, R8, R11.
  effect fn calleeFlags(self: &mut Self, function: &Function, test: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let other = run self.a.label()
    if self.knownFn(i32.wrappingToU32(test.k)) {
      run self.unlessTag(test.a, layout.tagOf(-2), other)
      let target = self.symbol(i32.wrappingToU32(test.k) * 3)
      let fresh = self.isFresh(test.a)
      run self.a.movSymbol(Reg.Rax, target)
      if fresh { run self.a.alu(Alu.Cmp, Width.W64, Reg.Rax, Reg.R9) } else { run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, payloadOf(test.a)) }
      self.a.bind(other)
      return ()
    }
    run self.unlessTag(test.a, layout.object(), other)
    if self.exact(&function, i32.wrappingToU32(test.k)) {
      let closure = self.symbol(i32.wrappingToU32(test.k) * 3 + 2)
      let fresh = self.isFresh(test.a)
      run self.a.movSymbol(Reg.Rax, closure)
      if fresh { run self.a.alu(Alu.Cmp, Width.W64, Reg.Rax, Reg.R9) } else { run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, payloadOf(test.a)) }
      self.a.bind(other)
      return ()
    }
    run self.payloadInto(Reg.R11, test.a)
    run self.a.loadZero16(Reg.Rax, Mem.at(Reg.R11, compiled.DIRECT_OBJECT_CLASS))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_BYTECODE_CLASS))
    run self.a.jcc(Cond.NotEqual, other)
    let target = self.symbol(i32.wrappingToU32(test.k) * 3)
    run self.a.movSymbol(Reg.Rax, target)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, Mem.at(Reg.R11, compiled.DIRECT_CLOSURE_BYTECODE))
    self.a.bind(other)
  }
  /// The flags of compare's operands (it stores nothing).
  effect fn compare(self: &mut Self, function: &Function, compare: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    // With 0, of the value the operation just before set the flags by: they are the ones.
    if self.flagsHold(function, compare.a) {
      match self.constants.get(u32.toUsize(compare.b)) {
        Option<i32>.Some { value } => { if value == 0 { return () } }
        Option<i32>.None => ()
      }
    }
    let left = self.at(compare.a)
    let mut dst = Reg.Rax
    if left.kind == GPR { dst = left.gpr } else if !self.raxHolds(function, compare.a) { run getI32(&mut self.a, Reg.Rax, left) }
    run self.operate(Alu.Cmp, dst, compare.b)
  }
  /// dst = dst op b, with b an immediate when it is a constant.
  /// A bitwise operation or a shift of inst.a by the constant value: an immediate operand,
  /// or a count of its own (JavaScript takes it modulo 32).
  effect fn withImmediate(self: &mut Self, inst: Inst, value: i32) -> () ! OutOfMemoryError ? &mut Allocator {
    let op = inst.op
    // In the result's register when it has one: the operand there, if any, dies here, and
    // the one exit (`>>> 0`) changes nothing before it leaves.
    let out = self.at(inst.result)
    let mut work = Reg.Rax
    if out.kind == GPR { work = out.gpr }
    let place = self.at(inst.a) run getI32(&mut self.a, work, place)
    if op == Op.BitAnd { run self.a.aluImm(Alu.And, Width.W32, work, value) }
    else if op == Op.BitOr { run self.a.aluImm(Alu.Or, Width.W32, work, value) }
    else if op == Op.BitXor { run self.a.aluImm(Alu.Xor, Width.W32, work, value) }
    else {
      let count = i32.wrappingToU8(value & 31)
      let mut shift = Shift.Shl
      if op == Op.Sar { shift = Shift.Sar } else if op == Op.Shr { shift = Shift.Shr }
      if count != 0 { run self.a.shiftImm(shift, Width.W32, work, count) }
      else if op == Op.Shr {
        // `x >>> 0` of a negative x is past the int32 maximum: a double in the interpreter.
        // A nonzero count leaves the sign bit clear.
        run self.stressGuard(inst.exit)
        run self.a.test(Width.W32, work, work)
        run self.a.jcc(Cond.Sign, self.exitLabels.get(u32.toUsize(inst.exit)))
      }
    }
    run putI32(&mut self.a, out, work)
  }
  effect fn operate(self: &mut Self, alu: Alu, dst: Reg, b: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.memFor == self.cursor && b == self.memValue {
      let el = self.memAt
      run self.a.aluLoad(alu, Width.W32, dst, el.at(8))
      return ()
    }
    match self.constants.get(u32.toUsize(b)) {
      Option<i32>.Some { value } => { run self.a.aluImm(alu, Width.W32, dst, value) return () }
      Option<i32>.None => ()
    }
    let place = self.at(b) run aluWith(&mut self.a, alu, dst, place)
  }
  /// What v's place is, as a number: equal numbers are the same storage.
  fn key(self: &Self, v: u32) -> u32 {
    let kind = self.places.kind(v)
    if kind == GPR { return 1000000 + u8.toU32(self.places.register(v)) }
    if kind == XMM { return 2000000 + u8.toU32(self.places.register(v)) }
    return self.storage(v)
  }
  fn readByPending(self: &Self, from: &List<u32>, done: &List<bool>, except: usize, key: u32, parked: u32) -> bool {
    let mut n: usize = 0
    while n < from.length() {
      // A parked source is read from the scratch place, not its own.
      if n != except && !done.get(n) && from.get(n) != parked && self.key(from.get(n)) == key { return true }
      n = n + 1
    }
    return false
  }
  /// Copies v's place to the scratch place (rax, xmm0 or the scratch slot).
  effect fn park(self: &mut Self, function: &Function, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let ty = function.value(v).ty
    if ty == Type.F64 { let place10 = self.at(v) run getF64(&mut self.a, Xmm.Xmm0, place10) return () }
    if ty == Type.I32 || ty == Type.Bool { let place11 = self.at(v) run getI32(&mut self.a, Reg.R11, place11) return () }
    let held = self.storage(v)
    run self.a.load(Width.W64, Reg.Rax, slotOf(held))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, self.scratch), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, payloadOf(held))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, self.scratch + 8), Reg.Rax)
  }
  /// Copies value from's place (or the scratch place, when parked) into value into's.
  effect fn moveValue(self: &mut Self, function: &Function, from: u32, into: u32, parked: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let ty = function.value(into).ty
    let target = self.at(into)
    if ty == Type.F64 {
      if parked { run putF64(&mut self.a, target, Xmm.Xmm0) return () }
      let source = self.at(from)
      if target.kind == XMM { run getF64(&mut self.a, target.xmm, source) return () }
      if source.kind == XMM { run putF64(&mut self.a, target, source.xmm) return () }
      run self.a.load(Width.W64, Reg.Rax, source.mem)
      run self.a.store(Width.W64, target.mem, Reg.Rax)
      return ()
    }
    if ty == Type.I32 || ty == Type.Bool {
      if parked { run putI32(&mut self.a, target, Reg.R11) return () }
      let source = self.at(from)
      if target.kind == GPR { run getI32(&mut self.a, target.gpr, source) return () }
      if source.kind == GPR { run putI32(&mut self.a, target, source.gpr) return () }
      run self.a.load(Width.W64, Reg.Rax, source.mem)
      run self.a.store(Width.W64, target.mem, Reg.Rax)
      return ()
    }
    let held = self.storage(from)
    if !parked && self.lazy.get(u32.toUsize(into)) {
      // A lazy parameter (lazyStores) arrives in RAX and R9.
      if !self.isFresh(held) {
        run self.a.load(Width.W64, Reg.Rax, slotOf(held))
        run self.a.load(Width.W64, Reg.R9, payloadOf(held))
      }
      return ()
    }
    if !parked && self.isFresh(held) {
      // The code just before left the value in RAX and R9 (setFresh): stored from there.
      run self.a.store(Width.W64, slotOf(into), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(into), Reg.R9)
      return ()
    }
    let mut tagAt = slotOf(held)
    let mut payloadAt = payloadOf(held)
    if parked { tagAt = Mem.at(Reg.Rsp, self.scratch) payloadAt = Mem.at(Reg.Rsp, self.scratch + 8) }
    run self.a.load(Width.W64, Reg.Rax, tagAt)
    run self.a.store(Width.W64, slotOf(into), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, payloadAt)
    run self.a.store(Width.W64, payloadOf(into), Reg.Rax)
  }
  /// Exits unless value v's tag field is tag.
  effect fn tagGuard(self: &mut Self, v: u32, tag: u32, exit: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let to = self.exitLabels.get(u32.toUsize(exit))
    run self.unlessTag(v, tag, to)
  }
  /// Jumps to `to` unless value v's tag field is tag. Clobbers R8 when the tag is wider
  /// than a byte.
  /// The checks of a planned construct's descriptor after its callee test (Op.CheckConstruct,
  /// Op.NewObject), with r11 the descriptor and r9 its constructor, in rax, r8, r9 and r11
  /// only: fresh-object observation, the epoch, the constructor's version and prototype, a
  /// forwarded construct's chain, and the interrupt tick. A failed check goes to miss, a
  /// nested descriptor to nestedSlow when given, an epoch change to epochSlow, a tick that
  /// reaches zero to pollSlow with the realm in rax; a construct with no tick jumps to pass,
  /// and one with a tick falls through.
  effect fn constructChecks(self: &mut Self, miss: Label, nestedSlow: Option<Label>, epochSlow: Label, pollSlow: Label, pass: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    let c = self.construct
    let p = self.plan
    // Fresh-object observation disables escape-eliminated constructs.
    run self.a.cmp8MemImm(Mem.at(Reg.R13, signed(c.rtObserveFresh)), 0)
    run self.a.jcc(Cond.NotEqual, miss)
    // Nested pre-initialized constructs validate outer + inner descriptors in nestedSlow.
    if let Option<Label>.Some { value: nested } = nestedSlow {
      run self.a.cmp8MemImm(Mem.at(Reg.R11, signed(c.descNestedKind)), 0)
      run self.a.jcc(Cond.NotEqual, nested)
    }
    // An epoch change goes to epochSlow, a helper that revalidates the prototype chain.
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R13, signed(fields.shapeEpoch)))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, Mem.at(Reg.R11, signed(c.descShapeEpoch)))
    run self.a.jcc(Cond.NotEqual, epochSlow)
    // ctor.shape.version == desc.ctorVersion && ctor.slots[protoSlot] == Object(desc.proto).
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R9, signed(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(fields.shapeVersion)))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, Mem.at(Reg.R11, signed(c.descCtorVersion)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R9, signed(fields.objectSlots)))
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(c.descProtoSlot)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 4)
    run self.a.alu(Alu.Add, Width.W64, Reg.Rax, Reg.R9)
    if layout.tagWidth == 1 && layout.object() < 256 {
      run self.a.cmp8MemImm(Mem.at(Reg.Rax, signed(layout.tagOffset)), u32.wrappingToU8(layout.object()))
    } else {
      run self.loadTag(Reg.R9, Mem.at(Reg.Rax, signed(layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R9, signed(layout.object()))
    }
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rax, 8))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R11, signed(c.descProto)))
    run self.a.jcc(Cond.NotEqual, miss)
    // Forwarded construct (Prototype.js Class.create -> proto.initialize.apply(this, arguments)).
    let noForward = run self.a.label()
    run self.a.cmp8MemImm(Mem.at(Reg.R11, signed(c.descForward)), 0)
    run self.a.jcc(Cond.Equal, noForward)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R9, signed(fields.objectSlots)))
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(c.descHolderSlot)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 4)
    run self.a.alu(Alu.Add, Width.W64, Reg.Rax, Reg.R9)
    if layout.tagWidth == 1 && layout.object() < 256 {
      run self.a.cmp8MemImm(Mem.at(Reg.Rax, signed(layout.tagOffset)), u32.wrappingToU8(layout.object()))
    } else {
      run self.loadTag(Reg.R9, Mem.at(Reg.Rax, signed(layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R9, signed(layout.object()))
    }
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rax, 8))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R11, signed(c.descTarget)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R9, signed(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(fields.shapeVersion)))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, Mem.at(Reg.R11, signed(c.descTargetVersion)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(c.descFnProto)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R9, signed(fields.objectSlots)))
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(c.descApplySlot)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 4)
    run self.a.alu(Alu.Add, Width.W64, Reg.Rax, Reg.R9)
    if layout.tagWidth == 1 && layout.object() < 256 {
      run self.a.cmp8MemImm(Mem.at(Reg.Rax, signed(layout.tagOffset)), u32.wrappingToU8(layout.object()))
    } else {
      run self.loadTag(Reg.R9, Mem.at(Reg.Rax, signed(layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R9, signed(layout.object()))
    }
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rax, 8))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R11, signed(c.descApplyFn)))
    run self.a.jcc(Cond.NotEqual, miss)
    self.a.bind(noForward)
    // Tick realm interrupt counter if required (leave desc.realm in rax for pollSlow).
    run self.a.cmp8MemImm(Mem.at(Reg.R11, signed(c.descCheckInterrupt)), 0)
    run self.a.jcc(Cond.Equal, pass)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, signed(c.descRealm)))
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rax, signed(p.f.interruptCounter)), 1)
    run self.a.jcc(Cond.LessOrEqual, pollSlow)
  }
  effect fn unlessTag(self: &mut Self, v: u32, tag: u32, to: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let at = Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES + self.settings.layout.tagOffset))
    if self.settings.layout.tagWidth == 1 && tag < 256 {
      if self.settings.layout.tagOffset == 0 && self.isFresh(v) {
        // A compare and a jump: the registers still hold the value after them.
        run self.a.cmp8Imm(Reg.Rax, u32.wrappingToU8(tag))
        run self.a.jcc(Cond.NotEqual, to)
        self.setFresh(v)
        return ()
      }
      run self.a.cmp8MemImm(at, u32.wrappingToU8(tag))
    } else {
      run self.loadTag(Reg.R8, at)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(tag))
    }
    run self.a.jcc(Cond.NotEqual, to)
  }
  /// The code just emitted left value v's first word in RAX and its payload in R9 on every
  /// way to this point: the instruction that follows may read them there (isFresh). A read
  /// from the slot right after its store waits for the store; this one does not.
  fn setFresh(self: &mut Self, v: u32) -> () {
    self.fresh = v
    self.freshAt = self.a.offset()
    self.freshBinds = self.a.bound()
  }
  /// Whether value v's words are in RAX and R9: setFresh named it, and no code and no jump
  /// target came since.
  fn isFresh(self: &Self, v: u32) -> bool {
    return self.on && v != NONE && self.fresh == v && self.a.offset() == self.freshAt && self.a.bound() == self.freshBinds
  }
  /// The register holding the payload of value v, an object: R9 when v is fresh, with no
  /// code, else R11 loaded from v's slot.
  effect fn objectIn(self: &mut Self, v: u32) -> Reg ! OutOfMemoryError ? &mut Allocator {
    if self.isFresh(v) { return Reg.R9 }
    run self.a.load(Width.W64, Reg.R11, payloadOf(v))
    return Reg.R11
  }
  /// dst = the payload of value v. Not for RAX or R9 as dst.
  effect fn payloadInto(self: &mut Self, dst: Reg, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.isFresh(v) { run self.a.mov(Width.W64, dst, Reg.R9) return () }
    run self.a.load(Width.W64, dst, payloadOf(v))
  }
  /// Loads the tag field at mem, zero-extended, into dst.
  effect fn loadTag(self: &mut Self, dst: Reg, mem: Mem) -> () ! OutOfMemoryError ? &mut Allocator {
    let width = self.settings.layout.tagWidth
    if width == 1 { run self.a.loadZero8(dst, mem) }
    else if width == 2 { run self.a.loadZero16(dst, mem) }
    else { run self.a.load(Width.W32, dst, mem) }
  }
  /// Writes the i32 (or, when boolean, the bool) in the low half of payload as a ValueBits at
  /// base + offset. Clobbers R8.
  effect fn boxInto(self: &mut Self, boolean: bool, payload: Reg, base: Reg, offset: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let mut tag = layout.int()
    if boolean { tag = layout.boolean() }
    run self.a.mov(Width.W32, payload, payload)
    run self.a.movImm64(Reg.R8, layout.tagWord(tag))
    run self.a.store(Width.W64, word(base, offset), Reg.R8)
    run self.a.store(Width.W64, word(base, offset + 8), payload)
  }
  /// Writes the double whose bits are in bits as a Float64 ValueBits at base + offset. An
  /// integral double stays a Float64, as the interpreter's own arithmetic leaves it
  /// (docs/jit/doubles.md). Clobbers R8.
  effect fn boxDoubleInto(self: &mut Self, bits: Reg, base: Reg, offset: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    run self.a.movImm64(Reg.R8, layout.tagWord(layout.float64()))
    run self.a.store(Width.W64, word(base, offset), Reg.R8)
    run self.a.store(Width.W64, word(base, offset + 8), bits)
  }
  /// Writes value v as a ValueBits at base + offset for the engine to take over, as an exit
  /// slot of mode writes it: an i32 or bool boxed, an `imm` as it is, an owned value or a
  /// borrow (`move`, `dup`) with one count added. Clobbers RAX, R8, R9, R10.
  effect fn valueInto(self: &mut Self, function: &Function, v: u32, mode: SlotMode, base: Reg, offset: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let info = function.value(v)
    if info.ty == Type.I32 || info.ty == Type.Bool {
      match self.constants.get(u32.toUsize(v)) {
        Option<i32>.Some { value } => { run self.a.movImm32(Reg.Rax, i32.wrappingToU32(value)) }
        Option<i32>.None => { let place12 = self.at(v) run getI32(&mut self.a, Reg.Rax, place12) }
      }
      run self.boxInto(info.ty == Type.Bool, Reg.Rax, base, offset)
      return ()
    }
    if info.ty == Type.F64 {
      let place13 = self.at(v) run getBits(&mut self.a, Reg.Rax, place13)
      run self.boxDoubleInto(Reg.Rax, base, offset)
      return ()
    }
    let held = self.storage(v)
    run self.a.load(Width.W64, Reg.Rax, slotOf(held))
    run self.a.load(Width.W64, Reg.R9, payloadOf(held))
    run self.a.store(Width.W64, word(base, offset), Reg.Rax)
    run self.a.store(Width.W64, word(base, offset + 8), Reg.R9)
    // A move hands its count over; a dup (a borrow) adds the slot's own.
    if info.own == Own.Imm || mode == SlotMode.Imm || info.own == Own.Owned { return () }
    run self.retainBits(Reg.Rax, Reg.R9)
  }
  /// Drops the count the owned value v holds. Only a heap reference has one. A count above
  /// one drops here; the last goes to the engine's deferred release.
  effect fn releaseValue(self: &mut Self, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.releaseAt(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES), false)
  }
  /// releaseValue for the frame cell at `at` from rbp.
  effect fn releaseCell(self: &mut Self, at: i32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.releaseAt(Reg.Rbp, at, false)
  }
  /// Drops the count the ValueBits at `at` from `base` holds; `heap` when it is known to be a
  /// heap reference. The count drops first; for the last one, code out of line puts it back
  /// and calls the release helper. Clobbers RAX, R9, R10 (and what a C call loses, then).
  effect fn releaseAt(self: &mut Self, base: Reg, at: i32, heap: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let skip = run self.a.label()
    let last = run self.a.label()
    let layout = self.settings.layout
    if !heap {
      if layout.tagWidth == 1 && layout.heapLowest == 0 {
        run self.a.cmp8MemImm(Mem.at(base, at + u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.heapHighest))
        run self.a.jcc(Cond.Above, skip)
      } else {
        run self.a.load(Width.W64, Reg.Rax, Mem.at(base, at))
        run self.heapTest(Reg.Rax, skip)
      }
    }
    run self.a.load(Width.W64, Reg.R9, Mem.at(base, at + 8))
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R9, 0), 1)
    run self.a.jcc(Cond.LessOrEqual, last)
    self.a.bind(skip)
    run self.outs.append(Out { kind: OUT_RELEASE, entry: last, back: skip, frame: self.frameOf, inst: self.cursor, base: base, at: at, flags: 0 })
  }
  /// The code of `out`, after the blocks.
  effect fn out(self: &mut Self, function: &Function, out: Out) -> () ! OutOfMemoryError ? &mut Allocator {
    self.a.bind(out.entry)
    self.frameOf = out.frame
    if out.kind == OUT_RELEASE {
      run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R9, 0), 1)
      run self.a.lea(Width.W64, Reg.Rsi, Mem.at(out.base, out.at))
      if self.on { run self.keepXmm() }
      run self.callHelper(helpers.RELEASE)
      if self.on { run self.restoreXmm() }
      run self.a.jmp(out.back)
      return ()
    }
    let inst = function.inst(out.inst)
    if out.kind == OUT_PUT_LAST {
      // R11: the object's slots; R8 and R10: the displaced value, whose last count this is.
      // It goes through the release helper once the new value is in place.
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, self.scratch), Reg.R8)
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, self.scratch + 8), Reg.R10)
      if (out.flags & PUT_HELD) == 0 {
        // The slot the value is in: a copy has none of its own (storage).
        let from = self.storage(inst.b)
        run self.a.load(Width.W64, Reg.Rax, slotOf(from))
        run self.a.load(Width.W64, Reg.R9, payloadOf(from))
      }
      run self.a.store(Width.W64, Mem.at(Reg.R11, out.at), Reg.Rax)
      run self.a.store(Width.W64, Mem.at(Reg.R11, out.at + 8), Reg.R9)
      if (out.flags & PUT_MOVED) == 0 { run self.retainBits(Reg.Rax, Reg.R9) }
      run self.a.lea(Width.W64, Reg.Rsi, Mem.at(Reg.Rsp, self.scratch))
      if self.on { run self.keepXmm() }
      run self.callHelper(helpers.RELEASE)
      if self.on { run self.restoreXmm() }
      run self.a.jmp(out.back)
      return ()
    }
    // get_var(env, frame, index, out) -> 1 when done.
    run self.coldFrameInto(Reg.Rsi, out.frame, out.flags)
    let mut index = i32.wrappingToU32(inst.k & (ssa.VAR_OWNED - 1))
    // A borrowed result (ssa_opt_borrow) takes no count: bit 31.
    if function.value(inst.result).own == Own.Borrowed { index = u32.bitOr(index, 0x80000000) }
    run self.a.movImm32(Reg.Rdx, index)
    run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
    if self.on { run self.keepXmm() }
    run self.callHelper(helpers.GET_VAR)
    if self.on { run self.restoreXmm() }
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
    // As the inline read leaves them (setFresh).
    run self.a.load(Width.W64, Reg.Rax, slotOf(inst.result))
    run self.a.load(Width.W64, Reg.R9, payloadOf(inst.result))
    run self.a.jmp(out.back)
  }
  /// Adds one count to the ValueBits whose first word is in tagWord and payload in payload,
  /// when it is a heap reference (HeapCell.retain). Clobbers R10.
  effect fn retainBits(self: &mut Self, tagWord: Reg, payload: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let skip = run self.a.label()
    run self.heapTest(tagWord, skip)
    run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(payload, 0), 1)
    self.a.bind(skip)
  }
  /// R11 = the slots of the object in value's slot, or a jump to miss: value is not an
  /// object, or its shape's version is not key's (key >> 16). fact tells which of the two
  /// tests earlier code already made (ssa_shapes). Clobbers RAX, R8 and R11.
  effect fn shapedSlots(self: &mut Self, value: u32, key: u64, fact: u8, miss: Label, via: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    if (fact & FACT_OBJECT) == 0 { run self.unlessTag(value, layout.object(), miss) }
    let held = run self.objectIn(value)
    if (fact & FACT_SHAPE) == 0 {
      run self.a.load(Width.W64, via, Mem.at(held, u32.wrappingToI32(fields.objectShape)))
      run self.a.aluStoreImm(Alu.Cmp, Width.W64, Mem.at(via, u32.wrappingToI32(fields.shapeVersion)), u64.wrappingToI32(u64.shiftRight(key, 16)))
      run self.a.jcc(Cond.NotEqual, miss)
    }
    run self.a.load(Width.W64, Reg.R11, Mem.at(held, u32.wrappingToI32(fields.objectSlots)))
  }
  /// R11 = the address of the slot a cached field site reads in the object in value's slot,
  /// by the shapes the site was seen with (site: ssa_translate.SiteShape), or a jump to miss:
  /// value is not an object, its shape is none of them, the prototype's shape is not the one
  /// seen with it, or it is exotic and not a fast Array (js_vm_property_ops.readFieldCachedAt
  /// answers a prototype entry under the same tests). fact: what earlier code proved
  /// (ssa_shapes). Clobbers RAX, R8 to R11.
  effect fn siteSlot(self: &mut Self, value: u32, site: &SiteShape, fact: u8, miss: Label) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    let found = run self.a.label()
    if (fact & FACT_OBJECT) == 0 { run self.unlessTag(value, layout.object(), miss) }
    let held = run self.objectIn(value)
    // 1 + the pair the object is known to have the shape of, or 0.
    let known = u8.toU32(u8.shiftRight(fact, FACT_PAIR))
    // One way to the slot: R11 is the slots and the slot is at the displacement returned.
    let single = known != 0 || site.count == 1
    let mut disp: i32 = 0
    // The shape, for its version or its prototype.
    if known == 0 || site.protoKeys[u32.toUsize(known - 1)] != 0 { run self.a.load(Width.W64, Reg.Rax, Mem.at(held, u32.wrappingToI32(fields.objectShape))) }
    let mut i: u32 = 0
    while i < site.count {
      if known != 0 && known - 1 != i { i = i + 1 continue }
      let key = site.keys[u32.toUsize(i)]
      let protoKey = site.protoKeys[u32.toUsize(i)]
      let firstKey = site.firstKeys[u32.toUsize(i)]
      let last = known != 0 || i + 1 == site.count
      let mut next = miss
      if !last { next = run self.a.label() }
      if known == 0 {
        run self.a.aluStoreImm(Alu.Cmp, Width.W64, Mem.at(Reg.Rax, u32.wrappingToI32(fields.shapeVersion)), u64.wrappingToI32(versionOf(key)))
        run self.a.jcc(Cond.NotEqual, next)
      }
      if protoKey != 0 {
        let plain = run self.a.label()
        run self.a.loadZero8(Reg.R10, Mem.at(held, u32.wrappingToI32(fields.objectFlags)))
        run self.a.testImm(Width.W32, Reg.R10, u32.wrappingToI32(fields.exotic))
        run self.a.jcc(Cond.Equal, plain)
        run self.a.testImm(Width.W32, Reg.R10, u32.wrappingToI32(fields.fastArray))
        run self.a.jcc(Cond.Equal, miss)
        run self.a.loadZero16(Reg.R10, Mem.at(held, u32.wrappingToI32(fields.objectClass)))
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(fields.arrayClass))
        run self.a.jcc(Cond.NotEqual, miss)
        self.a.bind(plain)
        // The version fixes the prototype; its shape's version fixes the slot. A holder one
        // further up: the prototype's version (it lacks the name) fixes the holder.
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rax, u32.wrappingToI32(fields.shapePrototype)))
        if firstKey != 0 {
          run self.a.load(Width.W64, Reg.R10, Mem.at(Reg.R9, u32.wrappingToI32(fields.objectShape)))
          run self.a.aluStoreImm(Alu.Cmp, Width.W64, Mem.at(Reg.R10, u32.wrappingToI32(fields.shapeVersion)), u64.wrappingToI32(firstKey))
          run self.a.jcc(Cond.NotEqual, miss)
          run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R10, u32.wrappingToI32(fields.shapePrototype)))
        }
        run self.a.load(Width.W64, Reg.R10, Mem.at(Reg.R9, u32.wrappingToI32(fields.objectShape)))
        run self.a.aluStoreImm(Alu.Cmp, Width.W64, Mem.at(Reg.R10, u32.wrappingToI32(fields.shapeVersion)), u64.wrappingToI32(u64.shiftRight(protoKey, 16)))
        run self.a.jcc(Cond.NotEqual, miss)
        if single {
          run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R9, u32.wrappingToI32(fields.objectSlots)))
          disp = u64.wrappingToI32(u64.bitAnd(protoKey, 65535)) * 16
        } else {
          run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R9, u32.wrappingToI32(fields.objectSlots)))
          run self.a.lea(Width.W64, Reg.R11, Mem.at(Reg.R9, u64.wrappingToI32(u64.bitAnd(protoKey, 65535)) * 16))
        }
      } else if single {
        run self.a.load(Width.W64, Reg.R11, Mem.at(held, u32.wrappingToI32(fields.objectSlots)))
        disp = u64.wrappingToI32(u64.bitAnd(key, 65535)) * 16
      } else {
        run self.a.load(Width.W64, Reg.R9, Mem.at(held, u32.wrappingToI32(fields.objectSlots)))
        run self.a.lea(Width.W64, Reg.R11, Mem.at(Reg.R9, u64.wrappingToI32(u64.bitAnd(key, 65535)) * 16))
      }
      if !last { run self.a.jmp(found) self.a.bind(next) }
      i = i + 1
    }
    self.a.bind(found)
    return disp
  }
  /// R11 = the address of the slot that the inline key of the field site at pc names in
  /// the object in value's slot, or a jump to miss: value is not an object, or the key's
  /// shape version (key >> 16, slot index in the low 16 bits, at code + pc + 5 as
  /// js_vm_property_ops.fieldKeyAt reads it) is not its shape's. Clobbers RAX, R8 to R11.
  /// put.field inst as an add along memo entry `memo` of atom (js_vm_property_ops.siteAdd
  /// when swapAdd makes it): the object adds in place, the entry is still that add from the
  /// object's shape with its prototype chain unchanged since it held (the epoch test of
  /// shapes.chainHolds), the slots have room, and the old shape keeps another owner while the
  /// target has one. Then the target takes a count from the old shape, the value is the new
  /// last slot and RAX:R9 its bits (the caller retains them unless the store takes the
  /// value's own count). Anything else jumps to miss with nothing changed. Frame mode: R13 is
  /// the runtime. Clobbers RAX, RCX, RDX, R8 to R11.
  effect fn addInPlace(self: &mut Self, inst: Inst, memo: u32, atom: u32, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let f = self.fields
    if u8.bitAnd(self.shapes.fact(self.cursor), FACT_OBJECT) == 0 { run self.unlessTag(inst.a, layout.object(), miss) }
    run self.payloadInto(Reg.R11, inst.a)
    if f.objectRoles == f.objectFlags + 1 && f.objectClass == f.objectFlags + 2 && f.plainClass < 65536 && f.addFlags < 256 && f.extensibleFlag < 256 && f.prototypeRole < 256 {
      // The flags byte, the roles byte and the 16-bit class share one 32-bit word: one test
      // for the plain class, the add flags and the prototype role.
      run self.a.load(Width.W32, Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(f.objectFlags)))
      run self.a.aluImm(Alu.And, Width.W32, Reg.R8, u32.wrappingToI32(u32.bitOr(0xffff0000, u32.bitOr(u32.shiftLeft(f.prototypeRole, 8), f.addFlags))))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(u32.bitOr(u32.shiftLeft(f.plainClass, 16), f.extensibleFlag)))
      run self.a.jcc(Cond.NotEqual, miss)
    } else {
      run self.a.loadZero16(Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(f.objectClass)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(f.plainClass))
      run self.a.jcc(Cond.NotEqual, miss)
      run self.a.loadZero8(Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(f.objectFlags)))
      run self.a.aluImm(Alu.And, Width.W32, Reg.R8, u32.wrappingToI32(f.addFlags))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(f.extensibleFlag))
      run self.a.jcc(Cond.NotEqual, miss)
      run self.a.test8MemImm(Mem.at(Reg.R11, u32.wrappingToI32(f.objectRoles)), u32.wrappingToU8(f.prototypeRole))
      run self.a.jcc(Cond.NotEqual, miss)
    }
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, u32.wrappingToI32(f.objectShape)))
    let entry = u32.wrappingToI32(f.transitions + memo * f.transitionStride)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.Rax, u32.wrappingToI32(f.shapeVersion)))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R8, Mem.at(Reg.R13, entry + u32.wrappingToI32(f.transitionVersion)))
    // Another shape (a constructor's object of another class) finds its entry in its own set
    // of the memo, out of line (addHashed).
    let hashed = run self.a.label()
    run self.a.jcc(Cond.NotEqual, hashed)
    run self.addTail(Reg.R13, entry, atom, true, inst.b, miss)
    let back = run self.a.label()
    self.a.bind(back)
    run self.addHashes.append(AddHash { entry: hashed, back: back, miss: miss, value: inst.b, atom: atom })
  }
  /// The rest of addInPlace from the memo entry at `entry` from `base`, whose base version is
  /// the object's shape's (R11 the object, RAX its shape): its atom and flags (unless they
  /// were tested: `named` false), its verified chain and target, the object's room, and the
  /// add with `value`. Clobbers RAX, RCX, RDX, R8 to R10 (base may be RCX).
  effect fn addTail(self: &mut Self, base: Reg, entry: i32, atom: u32, named: bool, value: u32, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.fields
    if named {
      run self.a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(base, entry + u32.wrappingToI32(f.transitionAtom)), u32.wrappingToI32(atom))
      run self.a.jcc(Cond.NotEqual, miss)
      run self.a.cmp8MemImm(Mem.at(base, entry + u32.wrappingToI32(f.transitionFlags)), u32.wrappingToU8(f.plainAdd))
      run self.a.jcc(Cond.NotEqual, miss)
    }
    run self.a.cmp8MemImm(Mem.at(base, entry + u32.wrappingToI32(f.transitionDepth)), u32.wrappingToU8(f.maxChainDepth))
    run self.a.jcc(Cond.Above, miss)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R13, u32.wrappingToI32(f.shapeEpoch)))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R8, Mem.at(base, entry + u32.wrappingToI32(f.transitionEpoch)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R10, Mem.at(base, entry + u32.wrappingToI32(f.transitionTarget)))
    run self.a.test(Width.W64, Reg.R10, Reg.R10)
    run self.a.jcc(Cond.Equal, miss)
    run self.a.load(Width.W32, Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(f.slotCount)))
    run self.a.load(Width.W32, Reg.R9, Mem.at(Reg.R11, u32.wrappingToI32(f.slotMeta)))
    run self.a.aluImm(Alu.And, Width.W32, Reg.R9, u32.wrappingToI32(f.capacityMask))
    run self.a.alu(Alu.Cmp, Width.W32, Reg.R8, Reg.R9)
    run self.a.jcc(Cond.AboveOrEqual, miss)
    let count = u32.wrappingToI32(f.referenceCount)
    run self.a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.Rax, count), 1)
    run self.a.jcc(Cond.LessOrEqual, miss)
    run self.a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.R10, count), 0)
    run self.a.jcc(Cond.Equal, miss)
    run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R10, count), 1)
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rax, count), 1)
    run self.a.store(Width.W64, Mem.at(Reg.R11, u32.wrappingToI32(f.objectShape)), Reg.R10)
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R11, u32.wrappingToI32(f.objectSlots)))
    run self.a.lea(Width.W32, Reg.Rdx, Mem.at(Reg.R8, 1))
    run self.a.store(Width.W32, Mem.at(Reg.R11, u32.wrappingToI32(f.slotCount)), Reg.Rdx)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R8, 4)
    run self.a.alu(Alu.Add, Width.W64, Reg.Rcx, Reg.R8)
    run self.a.load(Width.W64, Reg.Rax, slotOf(value))
    run self.a.load(Width.W64, Reg.R9, payloadOf(value))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 0), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 8), Reg.R9)
  }
  /// The way of an addInPlace whose object's shape is not its entry's base: the entry of the
  /// memo set the shape and atom hash to (js_shapes.memoSet, FieldLayout.memoMix) whose base
  /// version, atom and flags are the add's, then addTail, back to the add's end. RAX is the
  /// shape, R8 its version and R11 the object; no such entry goes to the add's miss.
  effect fn addHashed(self: &mut Self, item: AddHash) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.fields
    self.a.bind(item.entry)
    run self.a.mov(Width.W64, Reg.R9, Reg.Rax)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R9, 4)
    run self.a.movImm64(Reg.R10, u64.bitXor(u64.shiftLeft(u32.toU64(item.atom), 24), u32.toU64(f.plainAdd)))
    run self.a.alu(Alu.Xor, Width.W64, Reg.R9, Reg.R10)
    run self.a.movImm64(Reg.R10, f.memoMix)
    run self.a.imul(Width.W64, Reg.R9, Reg.R10)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R9, u32.wrappingToU8(f.memoShift))
    run self.a.imulImm(Width.W64, Reg.R9, Reg.R9, u32.wrappingToI32(f.memoWays * f.transitionStride))
    run self.a.lea(Width.W64, Reg.Rcx, Mem.indexed(Reg.R13, Reg.R9, Scale.One, u32.wrappingToI32(f.transitions)))
    let found = run self.a.label()
    let mut way: u32 = 0
    while way < f.memoWays {
      let next = run self.a.label()
      let at = u32.wrappingToI32(way * f.transitionStride)
      run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R8, Mem.at(Reg.Rcx, at + u32.wrappingToI32(f.transitionVersion)))
      run self.a.jcc(Cond.NotEqual, next)
      run self.a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.Rcx, at + u32.wrappingToI32(f.transitionAtom)), u32.wrappingToI32(item.atom))
      run self.a.jcc(Cond.NotEqual, next)
      run self.a.cmp8MemImm(Mem.at(Reg.Rcx, at + u32.wrappingToI32(f.transitionFlags)), u32.wrappingToU8(f.plainAdd))
      run self.a.jcc(Cond.NotEqual, next)
      if at != 0 { run self.a.lea(Width.W64, Reg.Rcx, Mem.at(Reg.Rcx, at)) }
      run self.a.jmp(found)
      self.a.bind(next)
      way = way + 1
    }
    run self.a.jmp(item.miss)
    self.a.bind(found)
    run self.addTail(Reg.Rcx, 0, item.atom, false, item.value, item.miss)
    run self.a.jmp(item.back)
  }
  effect fn fieldSlot(self: &mut Self, value: u32, pc: u32, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(value * SLOT_BYTES + layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R11, payloadOf(value))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, u32.wrappingToI32(fields.shapeVersion)))
    run self.codeInto(Reg.R10)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R10, u32.wrappingToI32(pc + 5)))
    run self.a.mov(Width.W64, Reg.R8, Reg.R9)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R8, 16)
    run self.a.alu(Alu.Cmp, Width.W64, Reg.R8, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R9, 65535)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R9)
  }
  /// R11 = the address of element `index` (an i32 value) of the fast Array in value's slot,
  /// or a jump to miss: not a fast Array, or the index is negative or past its elements.
  /// Clobbers R8 and R11.
  effect fn elementSlot(self: &mut Self, value: u32, index: u32, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let place = self.at(index)
    run self.elementSlotAt(value, place, miss)
  }
  /// elementSlot with the index's i32 at place.
  effect fn elementSlotAt(self: &mut Self, value: u32, place: Place, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.arrayGuard(value, miss)
    run self.elementOf(place, miss)
  }
  /// elementSlot for an access whose object a `check.array` proved a fast Array (Inst.trusted):
  /// the count test alone. In frame mode, caches `(cachedArr, r9 = elements, eax = count)`
  /// across consecutive trusted accesses on the same array.
  /// `proven`: the index is below the count (Inst.proven), so nothing is tested and the count
  /// stays unread; the cache then holds the elements alone (cachedCount).
  /// Where the element is goes to `self.element`: its address in R11, or, when `value` is
  /// the Array's elements (Op.Elements), those and twice the index.
  effect fn trustedSlot(self: &mut Self, function: &Function, value: u32, index: u32, miss: Label, proven: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let place = self.at(index)
    if function.isElements(value) {
      // The elements are a value (Op.Elements), in its register or loaded to R9, and the
      // element is at 16 times the index from them: R11 takes twice the index, which fits
      // 32 bits (a `check.bound` took the index's ends for below 2^31), unless the access
      // before left it there.
      let held = self.at(value)
      let mut base = Reg.R9
      if held.kind == GPR { base = held.gpr }
      else if self.cachedArr != value {
        run self.a.load(Width.W64, Reg.R9, held.mem)
        self.cachedArr = value
        self.cachedCount = false
      }
      if self.scaled != index {
        if place.kind == GPR { run self.a.lea(Width.W32, Reg.R11, Mem.indexed(place.gpr, place.gpr, Scale.One, 0)) }
        else {
          run self.a.load(Width.W32, Reg.R11, place.mem)
          run self.a.alu(Alu.Add, Width.W32, Reg.R11, Reg.R11)
        }
        self.scaled = index
      }
      self.element = Element { base: base, doubled: true, disp: 0 }
      return ()
    }
    self.element = addressed()
    if self.on {
      let arr = self.storage(value)
      let fields = self.fields
      // The index the add just before left in a scratch register is taken from there.
      let mut have = self.r8Holds(function, index)
      if !have && place.kind != GPR && self.raxHolds(function, index) {
        run self.a.mov(Width.W32, Reg.R8, Reg.Rax)
        have = true
      }
      if self.cachedArr != arr || (!proven && !self.cachedCount) {
        run self.a.load(Width.W64, Reg.R9, payloadOf(arr))
        if !proven { run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R9, u32.wrappingToI32(fields.elementCount))) }
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R9, u32.wrappingToI32(fields.elements)))
        self.cachedArr = arr
        self.cachedCount = !proven
      }
      // The element is at the elements in R9 and 16 times the index: R11 takes twice the
      // index, which fits 32 bits (a `check.bound` took both its ends for indexes that are
      // not negative as i32, and a count test below a count leaves it below 2^31).
      self.element = Element { base: Reg.R9, doubled: true, disp: 0 }
      if proven && place.kind == GPR {
        run self.a.lea(Width.W32, Reg.R11, Mem.indexed(place.gpr, place.gpr, Scale.One, 0))
        return ()
      }
      if !have { run getI32(&mut self.a, Reg.R8, place) }
      if !proven {
        run self.a.alu(Alu.Cmp, Width.W32, Reg.R8, Reg.Rax)
        run self.a.jcc(Cond.AboveOrEqual, miss)
      }
      run self.a.lea(Width.W32, Reg.R11, Mem.indexed(Reg.R8, Reg.R8, Scale.One, 0))
      return ()
    }
    run self.a.load(Width.W64, Reg.R11, payloadOf(value))
    run self.elementOf(place, miss)
  }
  /// To `miss` unless value is a fast Array, whose object is then in R11. Clobbers R8.
  effect fn arrayGuard(self: &mut Self, value: u32, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(value * SLOT_BYTES + layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R11, payloadOf(value))
    if fields.objectClass == fields.objectFlags + 2 && fields.arrayClass < 65536 && fields.fastArray < 256 {
      // The flags byte and the 16-bit class share one 32-bit word: one test for both.
      run self.a.load(Width.W32, Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)))
      run self.a.aluImm(Alu.And, Width.W32, Reg.R8, u32.wrappingToI32(u32.bitOr(0xffff0000, fields.fastArray)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(u32.bitOr(u32.shiftLeft(fields.arrayClass, 16), fields.fastArray)))
      run self.a.jcc(Cond.NotEqual, miss)
    } else {
      run self.a.loadZero16(Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectClass)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(fields.arrayClass))
      run self.a.jcc(Cond.NotEqual, miss)
      run self.a.loadZero8(Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)))
      run self.a.testImm(Width.W32, Reg.R8, u32.wrappingToI32(fields.fastArray))
      run self.a.jcc(Cond.Equal, miss)
    }
  }
  /// R11 from the fast Array in R11 to its element at the index's i32 at place, or to `miss`
  /// where the index is not below the count. Clobbers R8.
  effect fn elementOf(self: &mut Self, place: Place, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let fields = self.fields
    run getI32(&mut self.a, Reg.R8, place)
    run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.elementCount)))
    run self.a.jcc(Cond.AboveOrEqual, miss)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.elements)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R8, 4)
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R8)
  }
  /// The typed array arm of get.elem and put.elem, guarding what the interpreter's fast arms
  /// guard (js_typed_array_read.quickRead: "if index >= array.count || array.shared { return
  /// none }", then a jump on the class; js_typed_array_write.quickWriteInt and quickWrite):
  /// an object of a class Uint8C..Float64 whose payload is a TypedArray, not shared, the
  /// index below the element count (detaching or shrinking the buffer sets count to 0). Reads
  /// box what quickRead returns (Uint32 above the int32 range as a Float64). Stores take an
  /// Int or a Float64; a double goes to an integer array through cvttsd2si when it is in the
  /// int32 range (ToInt32 is then a truncation). Float16 and BigInt views, a double into
  /// Uint8C (round half to even), and a double out of range, NaN or an infinity go to `slow`.
  /// The count and the data pointer are invariant in a loop with no call and no generic
  /// instruction. Clobbers RAX, R8 to R11, XMM0.
  effect fn typedElement(self: &mut Self, put: bool, object: u32, index: u32, value: u32, result: u32, only: u32, done: Label, slow: Label)
    -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    run self.typedBounds(object, index, only, slow)
    if put {
      // A number stored outside the view (or into a detached one) is dropped: ToNumber has
      // nothing to run and the index is not valid (TypedArraySetElement). Others are slow.
      let inside = run self.a.label()
      run self.a.jcc(Cond.Below, inside)
      // A BigInt array's ToBigInt throws on a number.
      if only == 0 || only == classes.JS_CLASS_BIG_INT64_ARRAY || only == classes.JS_CLASS_BIG_UINT64_ARRAY {
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(classes.JS_CLASS_BIG_INT64_ARRAY))
        run self.a.jcc(Cond.Equal, slow)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(classes.JS_CLASS_BIG_UINT64_ARRAY))
        run self.a.jcc(Cond.Equal, slow)
      }
      run self.loadTag(Reg.R10, Mem.at(Reg.Rsp, u32.wrappingToI32(value * SLOT_BYTES + layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(layout.float64()))
      run self.a.jcc(Cond.Equal, done)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(layout.int()))
      run self.a.jcc(Cond.Equal, done)
      run self.a.jmp(slow)
      self.a.bind(inside)
    } else {
      // An integer index outside a typed array (or a detached one) reads undefined, with no
      // prototype lookup (IntegerIndexedElementGet).
      let inside = run self.a.label()
      run self.a.jcc(Cond.Below, inside)
      run self.a.movImm64(Reg.Rax, layout.tagWord(layout.undefined()))
      run self.a.store(Width.W64, slotOf(result), Reg.Rax)
      run self.a.storeImm(Width.W64, payloadOf(result), 0)
      run self.a.jmp(done)
      self.a.bind(inside)
    }
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.typedData)))
    if put { run self.typedStore(value, only, done, slow) } else { run self.typedLoad(result, only, done, slow) }
  }
  /// Guard the view and compare signed index R9 to its count as unsigned. On success,
  /// R11 holds the object and R8 its class. The caller handles the bounds flags.
  effect fn typedBounds(self: &mut Self, object: u32, index: u32, only: u32, slow: Label)
    -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    if fields.typedTagAt == u32.MAX { run self.a.jmp(slow) return () }
    run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(object * SLOT_BYTES + layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.load(Width.W64, Reg.R11, payloadOf(object))
    run self.a.loadZero16(Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectClass)))
    if only != 0 { run self.unlessClass(only, slow) } else {
      run self.a.mov(Width.W32, Reg.R10, Reg.R8)
      run self.a.aluImm(Alu.Sub, Width.W32, Reg.R10, u32.wrappingToI32(fields.typedFirst))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(fields.typedLast - fields.typedFirst))
      run self.a.jcc(Cond.Above, slow)
    }
    run self.a.loadZero8(Reg.R10, Mem.at(Reg.R11, u32.wrappingToI32(fields.typedTagAt)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(fields.typedTag))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.loadZero8(Reg.R10, Mem.at(Reg.R11, u32.wrappingToI32(fields.typedShared)))
    run self.a.test(Width.W32, Reg.R10, Reg.R10)
    run self.a.jcc(Cond.NotEqual, slow)
    let place = self.at(index)
    run getI32(&mut self.a, Reg.R9, place)
    // Sign-extended, a negative index is above any count.
    run self.a.signExtend32(Reg.R9, Reg.R9)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R11, u32.wrappingToI32(fields.typedCount)))
  }
  /// Jumps to `next` unless the class in R8 is `classId`.
  effect fn unlessClass(self: &mut Self, classId: u32, next: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(classId))
    run self.a.jcc(Cond.NotEqual, next)
  }
  /// typedElement's read: element R9 of the data at R11, class in R8 (or `only`), boxed into
  /// `result`.
  effect fn typedLoad(self: &mut Self, result: u32, only: u32, done: Label, slow: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    if only != 0 { run self.loadAs(only, result, done, slow) return () }
    let order = [classes.JS_CLASS_FLOAT64_ARRAY, classes.JS_CLASS_FLOAT32_ARRAY, classes.JS_CLASS_INT32_ARRAY, classes.JS_CLASS_UINT8_ARRAY,
      classes.JS_CLASS_UINT8C_ARRAY, classes.JS_CLASS_INT8_ARRAY, classes.JS_CLASS_INT16_ARRAY, classes.JS_CLASS_UINT16_ARRAY]
    let mut i: usize = 0
    while i < 8 {
      let next = run self.a.label()
      run self.unlessClass(order[i], next)
      run self.loadAs(order[i], result, done, slow)
      self.a.bind(next)
      i = i + 1
    }
    run self.unlessClass(classes.JS_CLASS_UINT32_ARRAY, slow)
    run self.loadAs(classes.JS_CLASS_UINT32_ARRAY, result, done, slow)
  }
  /// Element R9 of a typed array of class classId with its data at R11, boxed into `result`.
  effect fn loadAs(self: &mut Self, classId: u32, result: u32, done: Label, slow: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let at = result * SLOT_BYTES
    if classId == classes.JS_CLASS_FLOAT64_ARRAY {
      run self.a.load(Width.W64, Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.Eight, 0))
      run self.boxDoubleInto(Reg.Rax, Reg.Rsp, at) run self.a.jmp(done) return ()
    }
    if classId == classes.JS_CLASS_FLOAT32_ARRAY {
      run self.a.loadFloat(Xmm.Xmm0, Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0))
      run self.a.doubleToBits(Reg.Rax, Xmm.Xmm0)
      run self.boxDoubleInto(Reg.Rax, Reg.Rsp, at) run self.a.jmp(done) return ()
    }
    if classId == classes.JS_CLASS_UINT32_ARRAY {
      // An Int when it fits (ValueBits.number), else a Float64.
      let wide = run self.a.label()
      run self.a.load(Width.W32, Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0))
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Sign, wide)
      run self.boxInto(false, Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
      self.a.bind(wide)
      run self.a.intToDouble(Width.W64, Xmm.Xmm0, Reg.Rax)
      run self.a.doubleToBits(Reg.Rax, Xmm.Xmm0)
      run self.boxDoubleInto(Reg.Rax, Reg.Rsp, at) run self.a.jmp(done) return ()
    }
    if classId == classes.JS_CLASS_INT32_ARRAY { run self.a.load(Width.W32, Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0)) }
    else if classId == classes.JS_CLASS_UINT8_ARRAY || classId == classes.JS_CLASS_UINT8C_ARRAY { run self.a.loadZero8(Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.One, 0)) }
    else if classId == classes.JS_CLASS_INT8_ARRAY { run self.a.loadSigned8(Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.One, 0)) }
    else if classId == classes.JS_CLASS_INT16_ARRAY { run self.a.loadSigned16(Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.Two, 0)) }
    else if classId == classes.JS_CLASS_UINT16_ARRAY { run self.a.loadZero16(Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.Two, 0)) }
    else { run self.a.jmp(slow) return () }
    run self.boxInto(false, Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
  }
  /// typedElement's store of `value` (borrowed: numbers carry no count) at element R9 of the
  /// data at R11, class in R8 (or `only`).
  effect fn typedStore(self: &mut Self, value: u32, only: u32, done: Label, slow: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let double = run self.a.label()
    let integer = run self.a.label()
    run self.loadTag(Reg.R10, Mem.at(Reg.Rsp, u32.wrappingToI32(value * SLOT_BYTES + layout.tagOffset)))
    run self.a.load(Width.W64, Reg.Rax, payloadOf(value))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(layout.float64()))
    run self.a.jcc(Cond.Equal, double)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(layout.int()))
    run self.a.jcc(Cond.NotEqual, slow)
    // An Int in EAX.
    let floats = [classes.JS_CLASS_FLOAT64_ARRAY, classes.JS_CLASS_FLOAT32_ARRAY, classes.JS_CLASS_UINT8C_ARRAY]
    let mut i: usize = 0
    while i < 3 {
      if only == 0 || only == floats[i] {
        let next = run self.a.label()
        if only == 0 { run self.unlessClass(floats[i], next) }
        run self.storeIntAs(floats[i], done, slow)
        self.a.bind(next)
      }
      i = i + 1
    }
    if only == 0 || !isFloatClass(only) { run self.a.jmp(integer) }
    // A Float64: bits in RAX.
    self.a.bind(double)
    if only == 0 || only == classes.JS_CLASS_FLOAT64_ARRAY {
      let next = run self.a.label()
      if only == 0 { run self.unlessClass(classes.JS_CLASS_FLOAT64_ARRAY, next) }
      run self.a.store(Width.W64, Mem.indexed(Reg.R11, Reg.R9, Scale.Eight, 0), Reg.Rax) run self.a.jmp(done)
      self.a.bind(next)
    }
    if only == classes.JS_CLASS_FLOAT64_ARRAY { return () }
    run self.a.bitsToDouble(Xmm.Xmm0, Reg.Rax)
    if only == 0 || only == classes.JS_CLASS_FLOAT32_ARRAY {
      let next = run self.a.label()
      if only == 0 { run self.unlessClass(classes.JS_CLASS_FLOAT32_ARRAY, next) }
      run self.a.doubleToFloat(Xmm.Xmm0, Xmm.Xmm0)
      run self.a.storeFloat(Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0), Xmm.Xmm0) run self.a.jmp(done)
      self.a.bind(next)
    }
    if only == classes.JS_CLASS_FLOAT32_ARRAY { return () }
    if only == classes.JS_CLASS_UINT8C_ARRAY { run self.a.jmp(slow) return () }
    if only == 0 {
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(classes.JS_CLASS_UINT8C_ARRAY))
      run self.a.jcc(Cond.Equal, slow)
    }
    // ToInt32 of a double in the int32 range is its truncation; cvttsd2si gives 0x80000000 for
    // everything else (and for -2^31 itself, which the helper stores just as well).
    run self.a.doubleToInt(Width.W32, Reg.Rax, Xmm.Xmm0)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, -0x80000000)
    run self.a.jcc(Cond.Equal, slow)
    // Integer views, with the Int or the truncated double in EAX.
    self.a.bind(integer)
    if only != 0 { run self.storeIntAs(only, done, slow) return () }
    let views = [classes.JS_CLASS_INT32_ARRAY, classes.JS_CLASS_UINT32_ARRAY, classes.JS_CLASS_UINT8_ARRAY, classes.JS_CLASS_INT8_ARRAY, classes.JS_CLASS_INT16_ARRAY]
    i = 0
    while i < 5 {
      let next = run self.a.label()
      run self.unlessClass(views[i], next)
      run self.storeIntAs(views[i], done, slow)
      self.a.bind(next)
      i = i + 1
    }
    run self.unlessClass(classes.JS_CLASS_UINT16_ARRAY, slow)
    run self.storeIntAs(classes.JS_CLASS_UINT16_ARRAY, done, slow)
  }
  /// The Int in EAX stored at element R9 of a typed array of class classId with its data at R11.
  effect fn storeIntAs(self: &mut Self, classId: u32, done: Label, slow: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    if classId == classes.JS_CLASS_FLOAT64_ARRAY {
      run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
      run self.a.storeDouble(Mem.indexed(Reg.R11, Reg.R9, Scale.Eight, 0), Xmm.Xmm0)
    } else if classId == classes.JS_CLASS_FLOAT32_ARRAY {
      run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
      run self.a.doubleToFloat(Xmm.Xmm0, Xmm.Xmm0)
      run self.a.storeFloat(Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0), Xmm.Xmm0)
    } else if classId == classes.JS_CLASS_UINT8C_ARRAY {
      let clamped = run self.a.label()
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 255)
      run self.a.jcc(Cond.BelowOrEqual, clamped)
      // Out of 0..255: 0 below (sign set), 255 above.
      run self.a.mov(Width.W32, Reg.R10, Reg.Rax)
      run self.a.shiftImm(Shift.Sar, Width.W32, Reg.R10, 31)
      run self.a.movImm32(Reg.Rax, 255)
      run self.a.unary(Unary.Not, Width.W32, Reg.R10)
      run self.a.alu(Alu.And, Width.W32, Reg.Rax, Reg.R10)
      self.a.bind(clamped)
      run self.a.store8(Mem.indexed(Reg.R11, Reg.R9, Scale.One, 0), Reg.Rax)
    } else if classId == classes.JS_CLASS_INT32_ARRAY || classId == classes.JS_CLASS_UINT32_ARRAY {
      run self.a.store(Width.W32, Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0), Reg.Rax)
    } else if classId == classes.JS_CLASS_UINT8_ARRAY || classId == classes.JS_CLASS_INT8_ARRAY {
      run self.a.store8(Mem.indexed(Reg.R11, Reg.R9, Scale.One, 0), Reg.Rax)
    } else if classId == classes.JS_CLASS_INT16_ARRAY || classId == classes.JS_CLASS_UINT16_ARRAY {
      run self.a.store16(Mem.indexed(Reg.R11, Reg.R9, Scale.Two, 0), Reg.Rax)
    } else { run self.a.jmp(slow) return () }
    run self.a.jmp(done)
  }
  /// fieldSlot by the site cache entry (js_vm_property_ops.readFieldCachedAt): an own entry of
  /// the object's shape version, or a prototype entry for it while RuntimeState.shapeEpoch is
  /// the entry's (then the slot is in the entry's holder). An exotic object misses. A flat
  /// string reads from the realm's String.prototype, relocation symbol `strings`, when that
  /// is not NONE (stringRead): the entry is then the one a read of that object would use.
  effect fn cachedFieldSlot(self: &mut Self, value: u32, pc: u32, miss: Label, strings: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    let entries = u32.wrappingToI32(fields.fieldCache)
    let proto = run self.a.label()
    let found = run self.a.label()
    run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(value * SLOT_BYTES + layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
    if strings == NONE {
      run self.a.jcc(Cond.NotEqual, miss)
      run self.a.load(Width.W64, Reg.R11, payloadOf(value))
    } else {
      let object = run self.a.label()
      let start = run self.a.label()
      run self.a.jcc(Cond.Equal, object)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.tagOf(0 - 7)))
      run self.a.jcc(Cond.NotEqual, miss)
      run self.a.movSymbol(Reg.R11, strings)
      run self.a.test(Width.W64, Reg.R11, Reg.R11)
      run self.a.jcc(Cond.Equal, miss)
      run self.a.jmp(start)
      self.a.bind(object)
      run self.a.load(Width.W64, Reg.R11, payloadOf(value))
      self.a.bind(start)
    }
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, u32.wrappingToI32(fields.shapeVersion)))
    // R9 = the site (the operand's address), R8 = its entry less the cache's offset.
    run self.codeInto(Reg.R9)
    run self.a.lea(Width.W64, Reg.R9, Mem.at(Reg.R9, u32.wrappingToI32(pc + 1)))
    run self.runtimeInto(Reg.R10)
    run self.a.mov(Width.W64, Reg.R8, Reg.R9)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R8, 4095)
    run self.a.imulImm(Width.W64, Reg.R8, Reg.R8, u32.wrappingToI32(fields.entryStride))
    run self.a.alu(Alu.Add, Width.W64, Reg.R8, Reg.R10)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R8, entries + u32.wrappingToI32(fields.entrySite)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, entries + u32.wrappingToI32(fields.entryKey)))
    run self.a.mov(Width.W64, Reg.R10, Reg.R9)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R9, 16)
    run self.a.alu(Alu.Cmp, Width.W64, Reg.R9, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, proto)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R10, 65535)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R10, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R10)
    run self.a.jmp(found)
    self.a.bind(proto)
    run self.a.loadZero8(Reg.R10, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)))
    run self.a.testImm(Width.W32, Reg.R10, u32.wrappingToI32(fields.exotic))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.movImm64(Reg.R10, fields.protoKey)
    run self.a.alu(Alu.Or, Width.W64, Reg.Rax, Reg.R10)
    run self.a.alu(Alu.Cmp, Width.W64, Reg.R9, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, miss)
    run self.runtimeInto(Reg.R10)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, entries + u32.wrappingToI32(fields.entryEpoch)))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R10, u32.wrappingToI32(fields.shapeEpoch)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R8, entries + u32.wrappingToI32(fields.entryHolder)))
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, entries + u32.wrappingToI32(fields.entryHolderIndex)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R9)
    self.a.bind(found)
  }
  /// Jumps to notHeap unless the ValueBits whose first word is in tagWord is a heap
  /// reference. Clobbers R10.
  pub effect fn heapTest(self: &mut Self, tagWord: Reg, notHeap: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.heapTestWith(tagWord, Reg.R10, notHeap)
  }
  /// heapTest with `scratch` for the layouts that need a register (it clobbers that).
  pub effect fn heapTestWith(self: &mut Self, tagWord: Reg, scratch: Reg, notHeap: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    if layout.tagOffset == 0 && layout.tagWidth == 1 && layout.heapLowest == 0 {
      // The heap variants' tags start at 0: one byte compare tells.
      run self.a.cmp8Imm(tagWord, u32.wrappingToU8(layout.heapHighest))
      run self.a.jcc(Cond.Above, notHeap)
      return ()
    }
    run self.a.mov(Width.W64, scratch, tagWord)
    if layout.tagOffset != 0 { run self.a.shiftImm(Shift.Shr, Width.W64, scratch, u32.wrappingToU8(layout.tagOffset * 8)) }
    if layout.tagWidth == 1 { run self.a.aluImm(Alu.And, Width.W32, scratch, 255) }
    else if layout.tagWidth == 2 { run self.a.aluImm(Alu.And, Width.W32, scratch, 65535) }
    run self.a.aluImm(Alu.Sub, Width.W32, scratch, u32.wrappingToI32(layout.heapLowest))
    run self.a.aluImm(Alu.Cmp, Width.W32, scratch, u32.wrappingToI32(layout.heapHighest - layout.heapLowest))
    run self.a.jcc(Cond.Above, notHeap)
  }
  /// The frame slot of ABI input k.
  pub fn input(self: &Self, k: u32) -> Mem { return Mem.at(Reg.Rsp, self.inputs + u32.wrappingToI32(k * 8)) }
  /// Load the lexical scope at `depth` hops into R11, jumping to `exit` if any link is null.
  effect fn loadScopeAt(self: &mut Self, depth: u32, exit: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.frameOf == 0 && self.on {
      run self.ownScopeInto(Reg.R11)
    } else if self.on && self.frameOf != 0 && self.scopedFn(self.frameOf - 1) {
      // A known local function has no closure: it runs under the scope of its level on the
      // chain of the code that calls it (js_scopes.atLevel), which for a body that reads
      // its scope is the frame's own chain (ssa_translate's ownChain).
      let closure = self.inlineClosures.get(u32.toUsize(self.frameOf - 1))
      run self.a.load(Width.W64, Reg.R8, payloadOf(closure))
      run self.a.load(Width.W32, Reg.R8, Mem.at(Reg.R8, signed(self.plan.f.knownLevel)))
      run self.a.test(Width.W32, Reg.R8, Reg.R8)
      run self.a.jcc(Cond.Equal, exit)
      run self.ownScopeInto(Reg.R11)
      run self.levelScope(Reg.R11, Reg.R8, exit)
    } else if self.frameOf == 0 {
      let frame = self.input(INPUT_FRAME)
      run self.a.load(Width.W64, Reg.R11, frame)
      run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(self.fields.frameScope)))
    } else {
      let closure = self.inlineClosures.get(u32.toUsize(self.frameOf - 1))
      run self.a.load(Width.W64, Reg.R11, payloadOf(closure))
      run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, compiled.DIRECT_CLOSURE_SCOPE))
    }
    let mut hop: u32 = 0
    run self.a.test(Width.W64, Reg.R11, Reg.R11)
    run self.a.jcc(Cond.Equal, exit)
    while hop < depth {
      run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(self.fields.scopeParent)))
      run self.a.test(Width.W64, Reg.R11, Reg.R11)
      run self.a.jcc(Cond.Equal, exit)
      hop = hop + 1
    }
  }
  /// reg = the scope the frame's own code runs under (frame mode): the activation's own or
  /// the one its caller passed (a known local function's), else the closure's.
  effect fn ownScopeInto(self: &mut Self, reg: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let p = self.plan
    if p.known || p.scoped {
      run self.a.load(Width.W64, reg, p.rec(p.f.scope))
    } else {
      run self.a.load(Width.W64, reg, p.sf(p.f.currentFunction + 8))
      run self.a.load(Width.W64, reg, Mem.at(reg, compiled.DIRECT_CLOSURE_SCOPE))
    }
  }
  /// Walks scope from itself up its parents to the scope whose level is the 32-bit value in
  /// level (js_scopes.atLevel); jumps to none when the chain ends first, scope null.
  effect fn levelScope(self: &mut Self, scope: Reg, level: Reg, none: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let walk = run self.a.label()
    let found = run self.a.label()
    self.a.bind(walk)
    run self.a.test(Width.W64, scope, scope)
    run self.a.jcc(Cond.Equal, none)
    run self.a.aluLoad(Alu.Cmp, Width.W32, level, Mem.at(scope, signed(self.plan.f.scopeLevel)))
    run self.a.jcc(Cond.Equal, found)
    run self.a.load(Width.W64, scope, Mem.at(scope, u32.wrappingToI32(self.fields.scopeParent)))
    run self.a.jmp(walk)
    self.a.bind(found)
  }
  /// Read the lexical slot addressed by the bytecode. Inlined callees use the scope
  /// captured by their closure, the same pointer frameInto would put in their frame.
  effect fn readScope(self: &mut Self, inst: &Inst, depth: u32, slot: u32, checked: bool, own: Own) -> () ! OutOfMemoryError ? &mut Allocator {
    let exit = self.exitLabels.get(u32.toUsize(inst.exit))
    run self.loadScopeAt(depth, exit)
    let offset = u32.wrappingToI32(self.fields.scopeSlots + slot * SLOT_BYTES)
    if checked {
      let layout = self.settings.layout
      run self.loadTag(Reg.R8, Mem.at(Reg.R11, offset + u32.wrappingToI32(layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.uninitialized()))
      run self.a.jcc(Cond.Equal, exit)
    }
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, offset))
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, offset + 8))
    run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
    run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
    if own != Own.Borrowed { run self.retainBits(Reg.Rax, Reg.R9) }
  }
  /// Write `inst.a` into the lexical slot addressed by the bytecode, deferring a count-1
  /// displaced heap value through OUT_PUT_LAST.
  /// Takes one count from the cell R10 points at, unless it is the last: then `last` runs
  /// with the count as it was. The subtraction tests it, and an outlined piece puts the count
  /// back on the way to `last`.
  effect fn dropCount(self: &mut Self, last: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let undo = run self.a.label()
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R10, 0), 1)
    run self.a.jcc(Cond.LessOrEqual, undo)
    run self.a.beginOutlined()
    self.a.bind(undo)
    run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R10, 0), 1)
    run self.a.jmp(last)
    run self.a.endOutlined()
  }
  effect fn writeScope(self: &mut Self, inst: &Inst, depth: u32, slot: u32, checked: bool, imm: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let exit = self.exitLabels.get(u32.toUsize(inst.exit))
    run self.loadScopeAt(depth, exit)
    let offset = u32.wrappingToI32(self.fields.scopeSlots + slot * SLOT_BYTES)
    if checked {
      let layout = self.settings.layout
      run self.loadTag(Reg.R8, Mem.at(Reg.R11, offset + u32.wrappingToI32(layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.uninitialized()))
      run self.a.jcc(Cond.Equal, exit)
    }
    let kept = run self.a.label()
    let last = run self.a.label()
    let done = run self.a.label()
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R11, offset))
    run self.a.load(Width.W64, Reg.Rax, slotOf(inst.a))
    run self.a.load(Width.W64, Reg.R9, payloadOf(inst.a))
    run self.heapTest(Reg.R8, kept)
    run self.a.load(Width.W64, Reg.R10, Mem.at(Reg.R11, offset + 8))
    run self.dropCount(last)
    self.a.bind(kept)
    run self.a.store(Width.W64, Mem.at(Reg.R11, offset), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.R11, offset + 8), Reg.R9)
    if !imm { run self.retainBits(Reg.Rax, Reg.R9) }
    self.a.bind(done)
    let mut flags = PUT_HELD
    if imm { flags = u32.bitOr(flags, PUT_MOVED) }
    run self.outs.append(Out { kind: OUT_PUT_LAST, entry: last, back: done, frame: self.frameOf, inst: self.cursor, base: Reg.R11, at: offset, flags: flags })
  }
  /// dst = the CompiledFrame the instruction being lowered runs for, to pass to a helper: the
  /// function's own, or an inlined callee's (Inst.frame), which is built here, on the slow
  /// path, as a direct call builds one (directCall): the closure's bytecode, captured cells and
  /// scope, the function's realm and runtime (the target's realm was checked when it was
  /// chosen), the target's code. The receiver cell is never read: an inlined body takes
  /// `this` as a value. Clobbers RAX and R8 to R10.
  effect fn frameInto(self: &mut Self, dst: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.frameOf == 0 { run self.ownFrame(dst) return () }
    let own = self.input(INPUT_FRAME)
    let k = self.frameOf - 1
    let closure = self.inlineClosures.get(u32.toUsize(k))
    let f = self.inlineFrames + u32.wrappingToI32(k * INLINE_FRAME_WORDS * 8)
    run self.a.load(Width.W64, Reg.R10, payloadOf(closure))
    run self.a.lea(Width.W64, Reg.Rax, slotOf(closure))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f), Reg.Rax)
    let knownTarget = self.knownFn(k)
    if knownTarget {
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 8), Reg.R10)
    } else {
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_BYTECODE))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 8), Reg.R8)
    }
    if self.on {
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.Rsp, self.realmAt))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 16), Reg.R8)
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 24), Reg.R13)
    } else {
      run self.a.load(Width.W64, Reg.R9, own)
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R9, 16))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 16), Reg.R8)
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R9, FRAME_RUNTIME))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 24), Reg.R8)
    }
    if knownTarget {
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, signed(self.plan.f.knownRefs)))
    } else {
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_REFERENCES))
    }
    run self.a.lea(Width.W64, Reg.Rax, Mem.at(Reg.R8, compiled.DIRECT_BOX_DATA))
    run self.a.test(Width.W64, Reg.R8, Reg.R8)
    run self.a.cmov(Cond.Equal, Width.W64, Reg.Rax, Reg.Rsp)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 32), Reg.Rax)
    if knownTarget && !self.scopedFn(k) {
      // It reads no scope.
      run self.a.storeImm(Width.W64, Mem.at(Reg.Rsp, f + 40), 0)
    } else if knownTarget {
      // The scope of its level on the frame's own chain (loadScopeAt), or none.
      let none = run self.a.label()
      run self.a.load(Width.W32, Reg.R8, Mem.at(Reg.R10, signed(self.plan.f.knownLevel)))
      run self.a.movImm32(Reg.Rax, 0)
      run self.a.test(Width.W32, Reg.R8, Reg.R8)
      run self.a.jcc(Cond.Equal, none)
      run self.ownScopeInto(Reg.Rax)
      run self.levelScope(Reg.Rax, Reg.R8, none)
      self.a.bind(none)
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 40), Reg.Rax)
    } else {
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_SCOPE))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 40), Reg.R8)
    }
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rsp, f + 48), 0)
    let source = self.symbol(k * 3 + 1)
    run self.a.movSymbol(Reg.Rax, source)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 56), Reg.Rax)
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rsp, f + 64), 0)
    run self.a.lea(Width.W64, dst, Mem.at(Reg.Rsp, f))
  }
  /// Calls `frameInto(dst)` from a deferred cold path, temporarily restoring the inlined
  /// callee's closure captured when the instruction was lowered.
  effect fn coldFrameInto(self: &mut Self, dst: Reg, frame: u32, closure: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if frame != 0 {
      let k = u32.toUsize(frame - 1)
      let prev = self.inlineClosures.get(k)
      self.inlineClosures.set(k, closure)
      run self.frameInto(dst)
      self.inlineClosures.set(k, prev)
    } else {
      run self.ownFrame(dst)
    }
  }
  /// dst = the function's own CompiledFrame. In frame mode it is built here, on the slow
  /// path that needs it, from the baseline frame: the receiver's cell, the closure's
  /// bytecode, captured cells and scope, the realm and runtime, the code the record names.
  /// Clobbers RAX, R8 and R10 there.
  effect fn ownFrame(self: &mut Self, dst: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    if !self.on {
      let own = self.input(INPUT_FRAME)
      run self.a.load(Width.W64, dst, own)
      return ()
    }
    let p = self.plan
    let f = self.inputs
    run self.a.lea(Width.W64, Reg.Rax, p.sf(p.f.thisValue))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f), Reg.Rax)
    run self.a.load(Width.W64, Reg.R10, p.sf(p.f.currentFunction + 8))
    if p.known {
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 8), Reg.R10)
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, signed(p.f.bytecodeRealm)))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 16), Reg.R8)
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 24), Reg.R13)
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, signed(p.f.knownRefs)))
      run self.a.lea(Width.W64, Reg.Rax, Mem.at(Reg.R8, compiled.DIRECT_BOX_DATA))
      run self.a.test(Width.W64, Reg.R8, Reg.R8)
      run self.a.cmov(Cond.Equal, Width.W64, Reg.Rax, Reg.Rsp)
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 32), Reg.Rax)
      run self.a.load(Width.W64, Reg.R8, p.rec(p.f.scope))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 40), Reg.R8)
    } else {
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_BYTECODE))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 8), Reg.R8)
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R8, signed(p.f.bytecodeRealm)))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 16), Reg.R8)
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 24), Reg.R13)
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_REFERENCES))
      run self.a.lea(Width.W64, Reg.Rax, Mem.at(Reg.R8, compiled.DIRECT_BOX_DATA))
      run self.a.test(Width.W64, Reg.R8, Reg.R8)
      run self.a.cmov(Cond.Equal, Width.W64, Reg.Rax, Reg.Rsp)
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 32), Reg.Rax)
      if p.scoped { run self.a.load(Width.W64, Reg.R8, p.rec(p.f.scope)) }
      else { run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_SCOPE)) }
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 40), Reg.R8)
    }
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rsp, f + 48), 0)
    run self.a.load(Width.W64, Reg.Rax, p.rec(p.f.code))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 56), Reg.Rax)
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rsp, f + 64), 0)
    run self.a.lea(Width.W64, dst, Mem.at(Reg.Rsp, f))
  }
  /// The symbol of inline target word n (2k: target k's FunctionBytecode cell, 2k + 1: the
  /// first byte of its code): frame mode's code names the stubs and its baseline code first.
  fn symbol(self: &Self, n: u32) -> u32 { if self.on { return FRAME_SYMBOLS + n } return n }
  /// dst = the first byte of the code the instruction being lowered belongs to
  /// (CompiledFrame.code): an inlined callee's is a link-time constant.
  effect fn codeInto(self: &mut Self, dst: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.frameOf != 0 { let source = self.symbol((self.frameOf - 1) * 3 + 1) run self.a.movSymbol(dst, source) return () }
    if self.on { let p = self.plan run self.a.load(Width.W64, dst, p.rec(p.f.code)) return () }
    let own = self.input(INPUT_FRAME)
    run self.a.load(Width.W64, dst, own)
    run self.a.load(Width.W64, dst, Mem.at(dst, FRAME_CODE))
  }
  /// dst = the runtime (CompiledFrame.runtime), which every frame of the function shares.
  effect fn runtimeInto(self: &mut Self, dst: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.on { run self.a.mov(Width.W64, dst, Reg.R13) return () }
    let own = self.input(INPUT_FRAME)
    run self.a.load(Width.W64, dst, own)
    run self.a.load(Width.W64, dst, Mem.at(dst, FRAME_RUNTIME))
  }
  /// dst = the call block (CompiledFrame.calls).
  effect fn callBlock(self: &mut Self, dst: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let frame = self.input(INPUT_FRAME)
    run self.a.load(Width.W64, dst, frame)
    run self.a.load(Width.W64, dst, Mem.at(dst, FRAME_CALLS))
  }
  /// Which resume point call is (its index among the function's calls).
  fn resumeIndex(self: &Self, function: &Function, call: Inst) -> u32 {
    let mut point: u32 = 0
    let mut i: usize = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      if inst.op == Op.Call {
        if inst.pc == call.pc && inst.result == call.result { return point }
        point = point + 1
      }
      i = i + 1
    }
    return Intrinsic.trap("x64_backend: a call without a resume point")
  }
  /// Saves (out) or restores the values call point keeps, between the frame and the call block
  /// in R11, at block word CALL_SAVED + 2 * value. Clobbers R9.
  effect fn keep(self: &mut Self, point: u32, out: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let base = u32.wrappingMultiply(usize.toU32(compiled.CALL_SAVED), 8)
    let mut i = u32.toUsize(self.savedStart.get(u32.toUsize(point)))
    let end = u32.toUsize(self.savedStart.get(u32.toUsize(point) + 1))
    while i < end {
      let v = self.savedValues.get(i)
      let mut w: u32 = 0
      while w < 2 {
        let frame = Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES + w * 8))
        let block = word(Reg.R11, base + v * SLOT_BYTES + w * 8)
        if out { run self.a.load(Width.W64, Reg.R9, frame) run self.a.store(Width.W64, block, Reg.R9) }
        else { run self.a.load(Width.W64, Reg.R9, block) run self.a.store(Width.W64, frame, Reg.R9) }
        w = w + 1
      }
      i = i + 1
    }
  }
  /// The entry of code that makes calls: a run after EXIT_CALL (the call block's word 0 is
  /// nonzero) jumps to its resume point with word 0 in RAX and the block in R11.
  effect fn resume(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let fresh = run self.a.label()
    run self.callBlock(Reg.R11)
    run self.a.test(Width.W64, Reg.R11, Reg.R11)
    run self.a.jcc(Cond.Equal, fresh)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
    run self.a.test(Width.W64, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, fresh)
    run self.a.mov(Width.W64, Reg.R8, Reg.Rax)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R8, 2)
    let mut point: u32 = 0
    while point < usize.toU32(self.resumeLabels.length()) {
      run self.a.aluImm(Alu.Cmp, Width.W64, Reg.R8, u32.wrappingToI32(point + 1))
      run self.a.jcc(Cond.Equal, self.resumeLabels.get(u32.toUsize(point)))
      point = point + 1
    }
    run self.a.ud2()
    self.a.bind(fresh)
  }
  /// Calls helper index with env as its first argument (the caller has set the others from
  /// RSI on), then reloads the inputs the code keeps in registers. The result is in RAX.
  pub effect fn callHelper(self: &mut Self, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.on {
      // The CompiledEnv is the BaselineEnv's (r12); nothing is kept in a register a C call loses.
      run self.a.load(Width.W64, Reg.Rdi, Mem.at(Reg.R12, baseline_env.COMPILED_OFFSET))
      run self.a.callMem(Mem.at(Reg.Rdi, helpers.helperOffset(index)))
      return ()
    }
    let atE = self.input(INPUT_ENV) run self.a.load(Width.W64, Reg.Rdi, atE)
    run self.a.callMem(Mem.at(Reg.Rdi, helpers.helperOffset(index)))
    run self.reloadInputs()
  }
  /// Reloads the ABI inputs the code keeps in registers (RDI to RCX) after a C call.
  effect fn reloadInputs(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let at0 = self.input(0) run self.a.load(Width.W64, Reg.Rdi, at0)
    let at1 = self.input(1) run self.a.load(Width.W64, Reg.Rsi, at1)
    let at2 = self.input(2) run self.a.load(Width.W64, Reg.Rdx, at2)
    let at3 = self.input(3) run self.a.load(Width.W64, Reg.Rcx, at3)
  }
  /// The stress configuration: every guard also fails on every Nth check.
  effect fn stressGuard(self: &mut Self, exit: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.settings.stress == 0 { return () }
    let pass = run self.a.label()
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rcx, 0), 1)
    run self.a.jcc(Cond.Greater, pass)
    run self.a.storeImm(Width.W32, Mem.at(Reg.Rcx, 0), u32.wrappingToI32(self.settings.stress))
    run self.a.jmp(self.exitLabels.get(u32.toUsize(exit)))
    self.a.bind(pass)
  }
  /// A direct call from machine code (docs/jit/compiled-entry.md 7.7), with the call area
  /// and site written and the block in R11: a bytecode closure linked to code that makes no
  /// calls and that a direct call through CALL_FAST has prepared (CompiledEntry.directArity
  /// at most count) runs at once, through the runtime's entry table, on a frame built at
  /// CALL_FRAME. Falls through with the block in R11 when it returned (its result at
  /// CALL_STATE); goes to left, with CALL_CALLEE_EXIT set, when it left at a deopt or poll;
  /// goes to helper for anything else, nothing written.
  effect fn directCall(self: &mut Self, count: u32, helper: Label, left: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let area = u32.wrappingMultiply(usize.toU32(compiled.CALL_AREA), 8)
    let f = u32.wrappingMultiply(usize.toU32(compiled.CALL_FRAME), 8)
    run self.a.loadZero8(Reg.Rax, word(Reg.R11, area))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_OBJECT_TAG))
    run self.a.jcc(Cond.NotEqual, helper)
    run self.a.load(Width.W64, Reg.R10, word(Reg.R11, area + 8))
    run self.a.loadZero16(Reg.Rax, Mem.at(Reg.R10, compiled.DIRECT_OBJECT_CLASS))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_BYTECODE_CLASS))
    run self.a.jcc(Cond.NotEqual, helper)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_BYTECODE))
    run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R8, compiled.DIRECT_BYTECODE_INDEX))
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, helper)
    let atF = self.input(INPUT_FRAME) run self.a.load(Width.W64, Reg.Rsi, atF)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rsi, FRAME_RUNTIME))
    run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.Rax, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_COUNT))
    run self.a.jcc(Cond.Above, helper)
    run self.a.loadZero8(Reg.Rcx, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_OBSERVE))
    run self.a.testImm(Width.W32, Reg.Rcx, 1)
    run self.a.jcc(Cond.NotEqual, helper)
    run self.a.store(Width.W64, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_INDEX), 8)), Reg.Rax)
    // The entry: entries + (index - 1) * its size.
    run self.a.aluImm(Alu.Sub, Width.W32, Reg.Rax, 1)
    run self.a.imulImm(Width.W64, Reg.Rax, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_ENTRY_BYTES))
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_ENTRIES))
    run self.a.alu(Alu.Add, Width.W64, Reg.Rdx, Reg.Rax)
    run self.a.load(Width.W32, Reg.Rcx, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_ARITY))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rcx, u32.wrappingToI32(count))
    run self.a.jcc(Cond.Above, helper)
    let nested = run self.a.label()
    let counted = run self.a.label()
    run self.a.load(Width.W32, Reg.Rcx, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_CALL_WORDS))
    run self.a.test(Width.W32, Reg.Rcx, Reg.Rcx)
    run self.a.jcc(Cond.NotEqual, nested)
    // The callee's frame (js_compiled.CompiledFrame): receiver cell, bytecode, realm, runtime,
    // captured cells (a non-null filler when none), scope, no call block, code, no activation.
    run self.a.lea(Width.W64, Reg.Rcx, word(Reg.R11, area + SLOT_BYTES))
    run self.a.store(Width.W64, word(Reg.R11, f), Reg.Rcx)
    run self.a.store(Width.W64, word(Reg.R11, f + 8), Reg.R8)
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_REALM))
    run self.a.store(Width.W64, word(Reg.R11, f + 16), Reg.Rcx)
    run self.a.store(Width.W64, word(Reg.R11, f + 24), Reg.R9)
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_REFERENCES))
    run self.a.lea(Width.W64, Reg.Rax, Mem.at(Reg.Rcx, compiled.DIRECT_BOX_DATA))
    run self.a.test(Width.W64, Reg.Rcx, Reg.Rcx)
    run self.a.cmov(Cond.Equal, Width.W64, Reg.Rax, Reg.R11)
    run self.a.store(Width.W64, word(Reg.R11, f + 32), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_SCOPE))
    run self.a.store(Width.W64, word(Reg.R11, f + 40), Reg.Rcx)
    run self.a.storeImm(Width.W64, word(Reg.R11, f + 48), 0)
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_SOURCE))
    run self.a.store(Width.W64, word(Reg.R11, f + 56), Reg.Rcx)
    run self.a.storeImm(Width.W64, word(Reg.R11, f + 64), 0)
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_RUNS), 1)
    // The compiled-entry ABI: cells, state, counter, data, env, frame.
    run self.a.mov(Width.W64, Reg.R10, Reg.Rdx)
    run self.a.lea(Width.W64, Reg.Rdi, word(Reg.R11, area + 2 * SLOT_BYTES))
    run self.a.lea(Width.W64, Reg.Rsi, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_STATE), 8)))
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_COUNTER))
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_DATA))
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_ENV))
    run self.a.lea(Width.W64, Reg.R9, word(Reg.R11, f))
    run self.a.callMem(Mem.at(Reg.R10, compiled.DIRECT_ENTRY_CODE))
    run self.reloadInputs()
    run self.callBlock(Reg.R11)
    let returned = run self.a.label()
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, returned)
    // Left: the exit code and the callee's index, for compiledCall to finish it interpreted.
    run self.a.mov(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.load(Width.W64, Reg.Rcx, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_INDEX), 8)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rcx, 32)
    run self.a.alu(Alu.Or, Width.W64, Reg.Rax, Reg.Rcx)
    run self.a.store(Width.W64, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_CALLEE_EXIT), 8)), Reg.Rax)
    run self.a.jmp(left)
    self.a.bind(returned)
    run self.a.jmp(counted)
    self.a.bind(nested)
    run self.nestedCall(count, helper, left, counted)
    self.a.bind(counted)
    let atE = self.input(INPUT_ENV) run self.a.load(Width.W64, Reg.R10, atE)
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R10, helpers.DIRECT_CALLS_OFFSET), 1)
  }
  /// directCall for a callee whose code makes calls, with R10 its closure, R8 its bytecode,
  /// R9 the runtime, RDX its entry and RSI the caller's frame: pushes its activation
  /// (js_vm.Activation, DIRECT_ACT_*) as js_vm.fastCall would and runs it nested. Goes to
  /// returned with the result at CALL_STATE and the activation popped; to left with the block
  /// CALLEE_PUSHED (the runner continues it); to helper, nothing changed, when it is too deep
  /// or the stack has no room.
  effect fn nestedCall(self: &mut Self, count: u32, helper: Label, left: Label, returned: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let area = u32.wrappingMultiply(usize.toU32(compiled.CALL_AREA), 8)
    let f = u32.wrappingMultiply(usize.toU32(compiled.CALL_FRAME), 8)
    let header = compiled.DIRECT_ACTIVATION_HEADER * 8
    run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_DEPTH))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_NESTING))
    run self.a.jcc(Cond.AboveOrEqual, helper)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_CAPACITY))
    run self.a.aluLoad(Alu.Sub, Width.W64, Reg.Rax, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_TOP))
    run self.a.load(Width.W32, Reg.Rcx, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_WORDS))
    run self.a.alu(Alu.Cmp, Width.W64, Reg.Rcx, Reg.Rax)
    run self.a.jcc(Cond.Above, helper)
    // Push: the record at activations + top words, the new top past its words.
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_TOP))
    run self.a.alu(Alu.Add, Width.W64, Reg.Rcx, Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_TOP), Reg.Rcx)
    run self.a.mov(Width.W64, Reg.Rcx, Reg.Rax)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rcx, 3)
    run self.a.aluLoad(Alu.Add, Width.W64, Reg.Rcx, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_ACTIVATIONS))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_MARK), Reg.Rax)
    run self.a.store(Width.W64, word(Reg.R11, f), Reg.Rcx)
    run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_DEPTH), 1)
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_RUNS), 1)
    // Its CompiledFrame: receiver cell, bytecode, realm, runtime, captured cells (the record
    // as a non-null filler when none), scope, its call block, code, itself.
    run self.a.lea(Width.W64, Reg.Rax, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_RECEIVER))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 0), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 8), Reg.R8)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_REALM))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 16), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 24), Reg.R9)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_REFERENCES))
    run self.a.lea(Width.W64, Reg.Rdi, Mem.at(Reg.Rax, compiled.DIRECT_BOX_DATA))
    run self.a.test(Width.W64, Reg.Rax, Reg.Rax)
    run self.a.cmov(Cond.Equal, Width.W64, Reg.Rdi, Reg.Rcx)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 32), Reg.Rdi)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_SCOPE))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 40), Reg.Rax)
    run self.a.lea(Width.W64, Reg.Rdi, Mem.at(Reg.Rcx, header))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 48), Reg.Rdi)
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rdi, 0), 0)
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rdi, u32.wrappingToI32(u32.wrappingMultiply(usize.toU32(compiled.CALL_CALLEE_EXIT), 8))), 0)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_SOURCE))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 56), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.FRAME_ACTIVATION), Reg.Rcx)
    // Its exit state after the block, then Prepared, cells, stack frame and the rest.
    run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_CALL_WORDS))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rax, 3)
    run self.a.alu(Alu.Add, Width.W64, Reg.Rax, Reg.Rdi)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_STATE), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_CODE))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PREPARED), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_DATA))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PREPARED + 8), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_ENV))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PREPARED + 16), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_COUNTER))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PREPARED + 24), Reg.Rax)
    run self.a.lea(Width.W64, Reg.Rax, word(Reg.R11, area + 2 * SLOT_BYTES))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_CELLS), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_ARGV), Reg.Rax)
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_ARGV + 8), u32.wrappingToI32(count))
    run self.a.lea(Width.W64, Reg.Rax, Mem.at(Reg.Rcx, compiled.DIRECT_ACTIVATION_WORDS * 8))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_STACK_FRAME), Reg.Rax)
    // No pc yet (NO_PC), not published, the bytecode's mode.
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PC), -1)
    run self.a.loadZero8(Reg.Rax, Mem.at(Reg.R8, compiled.DIRECT_BYTECODE_MODE))
    run self.a.shiftImm(Shift.Shl, Width.W32, Reg.Rax, 8)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PUBLISHED), Reg.Rax)
    // The function and receiver, borrowed from the area.
    run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, area))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_FUNCTION), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, area + 8))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_FUNCTION + 8), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, area + SLOT_BYTES))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_RECEIVER), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, area + SLOT_BYTES + 8))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_RECEIVER + 8), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsi, compiled.FRAME_ACTIVATION))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PARENT), Reg.Rax)
    run self.a.load(Width.W32, Reg.Rax, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_INDEX), 8)))
    run self.a.store(Width.W32, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_INDEX), Reg.Rax)
    run self.a.storeImm(Width.W32, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_INDEX + 4), u32.wrappingToI32(compiled.DIRECT_COPY_ARGUMENTS))
    // Fresh (EXIT_FRESH), not known.
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_EXIT), u32.wrappingToI32(compiled.EXIT_FRESH))
    // The compiled-entry ABI: cells, state, counter, data, env, its frame (the record).
    run self.a.mov(Width.W64, Reg.R10, Reg.Rdx)
    run self.a.mov(Width.W64, Reg.R9, Reg.Rcx)
    run self.a.lea(Width.W64, Reg.Rdi, word(Reg.R11, area + 2 * SLOT_BYTES))
    run self.a.load(Width.W64, Reg.Rsi, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_STATE))
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_COUNTER))
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_DATA))
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_ENV))
    run self.a.callMem(Mem.at(Reg.R10, compiled.DIRECT_ENTRY_CODE))
    run self.reloadInputs()
    run self.callBlock(Reg.R11)
    // Back: one level shallower. Only RAX and R8-R10 are free (the inputs are reloaded).
    run self.a.load(Width.W64, Reg.R10, word(Reg.R11, f))
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R10, 24))
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_DEPTH), 1)
    let exited = run self.a.label()
    let published = run self.a.label()
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, exited)
    // Returned: the owned result to CALL_STATE, then pop.
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_ACT_STATE))
    let into = u32.wrappingMultiply(usize.toU32(compiled.CALL_STATE), 8)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R8, 0))
    run self.a.store(Width.W64, word(Reg.R11, into), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R8, 8))
    run self.a.store(Width.W64, word(Reg.R11, into + 8), Reg.Rax)
    run self.a.loadZero8(Reg.Rax, Mem.at(Reg.R10, compiled.DIRECT_ACT_PUBLISHED))
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, published)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R10, compiled.DIRECT_ACT_MARK))
    run self.a.store(Width.W64, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_TOP), Reg.Rax)
    run self.a.jmp(returned)
    self.a.bind(published)
    run self.a.mov(Width.W64, Reg.Rsi, Reg.R10)
    run self.callHelper(helpers.CALL_POP)
    run self.callBlock(Reg.R11)
    run self.a.jmp(returned)
    // Left: the runner continues it from its recorded exit (CALLEE_PUSHED, the record at
    // CALL_STATE), as for CALL_FAST.
    self.a.bind(exited)
    run self.a.store(Width.W32, Mem.at(Reg.R10, compiled.DIRECT_ACT_EXIT), Reg.Rax)
    run self.a.store(Width.W64, word(Reg.R11, into), Reg.R10)
    run self.a.storeImm(Width.W64, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_CALLEE_EXIT), 8)), -1)
    run self.a.jmp(left)
  }
  // ---- Frame mode ---------------------------------------------------------------------

  /// Frame mode's prologue: baseline code's (baseline.prologue), with the spill area taken
  /// below the frame. It fills the record, takes the arguments and leaves the locals
  /// undefined; they stay so until an exit writes them. That is STUB_PROLOGUE's work done
  /// inline with the counts known, less the hotness count (an optimized function's is
  /// PARKED); a frame that copies its arguments (p.copies, or fewer passed than declared)
  /// takes the stub out of line.
  effect fn enter(self: &mut Self, function: &Function) -> () ! OutOfMemoryError ? &mut Allocator {
    let p = self.plan
    run self.a.push(Reg.Rbp)
    run self.a.mov(Width.W64, Reg.Rbp, Reg.Rsp)
    run self.a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, self.frame)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rsp, Mem.at(Reg.R13, signed(p.f.stackLimit)))
    run self.a.jcc(Cond.Below, self.overflow)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(p.codeWord)))
    if p.codeDelta != 0 { run self.a.lea(Width.W64, Reg.R9, Mem.at(Reg.R9, signed(p.codeDelta))) }
    run self.a.movImm32(Reg.Rax, u64.wrappingToU32(frames.FRAME_BARE))
    self.a.bind(self.entered)
    if p.copies { run self.a.jmp(self.copying) }
    else {
      let f = p.f
      let layout = self.settings.layout
      run self.a.store(Width.W64, p.rec(f.code), Reg.R9)
      run self.a.store(Width.W64, p.rec(f.state), Reg.Rax)
      if p.known {
        // No closure object: the frame names the bytecode, rdi is the scope, `this` undefined.
        run self.a.storeImm(Width.W64, p.sf(f.currentFunction), u64.wrappingToI32(layout.tagWord(layout.tagOf(-2))))
        run self.a.store(Width.W64, p.sf(f.currentFunction + 8), Reg.R11)
        run self.a.store(Width.W64, p.rec(f.scope), Reg.Rdi)
        run self.a.storeImm(Width.W64, p.sf(f.thisValue), u64.wrappingToI32(layout.tagWord(layout.undefined())))
        run self.a.storeImm(Width.W64, p.sf(f.thisValue + 8), 0)
      } else {
        run self.a.storeImm(Width.W64, p.sf(f.currentFunction), u32.wrappingToI32(layout.object()))
        run self.a.store(Width.W64, p.sf(f.currentFunction + 8), Reg.Rdi)
        run self.a.store(Width.W64, p.sf(f.thisValue), Reg.Rcx)
        run self.a.store(Width.W64, p.sf(f.thisValue + 8), Reg.R8)
      }
      run self.a.store(Width.W64, p.rec(f.argv), Reg.Rsi)
      run self.a.store(Width.W64, p.rec(f.argc), Reg.Rdx)
      if p.arguments != 0 {
        run self.a.aluImm(Alu.Cmp, Width.W64, Reg.Rdx, u32.wrappingToI32(p.arguments))
        run self.a.jcc(Cond.Below, self.copying)
      }
      // The caller's cells: the frame's own argument cells stay unused. rbx is the frame's
      // cell base from here to its end; the caller's waits in the record.
      run self.a.store(Width.W64, p.sf(f.argumentsData), Reg.Rsi)
      run self.a.store(Width.W64, p.rec(f.spare), Reg.Rbx)
      run self.a.lea(Width.W64, Reg.Rbx, Mem.at(Reg.Rbp, p.localAt(0) + 128))
      if p.locals <= 8 {
        let mut l: u32 = 0
        while l < p.locals { run self.a.storeImm(Width.W64, Mem.at(Reg.Rbp, p.localAt(l)), u32.wrappingToI32(layout.undefined())) l = l + 1 }
      } else {
        let more = run self.a.label()
        run self.a.lea(Width.W64, Reg.Rdi, Mem.at(Reg.Rbp, p.localAt(0)))
        run self.a.movImm32(Reg.Rcx, p.locals)
        self.a.bind(more)
        run self.a.storeImm(Width.W64, Mem.at(Reg.Rdi, 0), u32.wrappingToI32(layout.undefined()))
        run self.a.aluImm(Alu.Add, Width.W64, Reg.Rdi, 16)
        run self.a.aluImm(Alu.Sub, Width.W32, Reg.Rcx, 1)
        run self.a.jcc(Cond.NotEqual, more)
      }
      if needsRealm(&function) {
        // r11 still holds bytecode on the fast non-copy path: read realm directly.
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, signed(p.f.bytecodeRealm)))
        run self.a.store(Width.W64, Mem.at(Reg.Rsp, self.realmAt), Reg.Rax)
      }
    }
    self.a.bind(self.prologued)
    if p.scoped {
      // The activation's own scope, in the frame's scope cells, once arguments are in place.
      run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
      run self.a.lea(Width.W64, Reg.Rsi, p.rec(0))
      run self.a.lea(Width.W64, Reg.Rdx, Mem.at(Reg.Rbp, p.scopeAt))
      run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.SCOPE)))
    }
    // The slots of the values that are a known closure whenever they are read (presets).
    let mut first = true
    let mut v: usize = 0
    while v < self.preset.length() {
      let k = self.preset.get(v)
      if k != 0 {
        if first { let layout = self.settings.layout run self.a.movImm64(Reg.Rax, layout.tagWord(layout.object())) first = false }
        let closure = self.symbol((k - 1) * 3 + 2)
        run self.a.movSymbol(Reg.R9, closure)
        run self.a.store(Width.W64, slotOf(usize.toU32(v)), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(usize.toU32(v)), Reg.R9)
      }
      v = v + 1
    }
    // The closures of the targets the arms of armed reads go to (armReads).
    let mut t: usize = 0
    while t < self.armSlot.length() {
      let at = self.armSlot.get(t)
      if at != NONE {
        let layout = self.settings.layout
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.object()))
        let closure = self.symbol(usize.toU32(t) * 3 + 2)
        run self.a.movSymbol(Reg.R9, closure)
        run self.a.store(Width.W64, slotOf(at), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(at), Reg.R9)
      }
      t = t + 1
    }
    // The slots of integer constants that live in no register: a constant's slot holds it
    // from here on, and its definition makes no code (a store each time it ran, in a loop).
    let mut c: usize = 0
    while c < function.insts.length() {
      let inst = function.insts.get(c)
      c = c + 1
      if inst.op != Op.ConstI32 || inst.result == NONE || self.onlyImmediate(inst.result) { continue }
      if self.at(inst.result).kind == GPR { continue }
      run self.a.movImm32(Reg.Rax, i32.wrappingToU32(inst.k))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
    }
  }
  /// Frame mode's out-of-line code: the prologue's overflow and the polls' slow paths.
  effect fn frameTails(self: &mut Self, function: &Function) -> () ! OutOfMemoryError ? &mut Allocator {
    let p = self.plan
    // No room for the spill area: the baseline code takes the call (its frame is smaller,
    // and it reports the overflow when that does not fit either). Everything the call
    // passed is still in its registers.
    self.a.bind(self.overflow)
    run self.a.mov(Width.W64, Reg.Rsp, Reg.Rbp)
    run self.a.pop(Reg.Rbp)
    run self.a.jmpSymbol(SYMBOL_BASELINE)
    // The prologue of a frame that copies its arguments: the shared stub, which does all of
    // the prologue's work again (everything it was given is still in its registers).
    self.a.bind(self.copying)
    let mut counts = p.arguments | u32.shiftLeft(p.locals, 13)
    if p.copies { counts = counts | 0x80000000 }
    run self.a.lea(Width.W64, Reg.R14, Mem.at(Reg.Rbp, p.argumentAt(0)))
    run self.a.movImm32(Reg.R10, counts)
    if p.known { run self.a.callSymbol(stubs.STUB_PROLOGUE_KNOWN) } else { run self.a.callSymbol(stubs.STUB_PROLOGUE) }
    if needsRealm(&function) {
      run self.a.load(Width.W64, Reg.Rax, p.sf(p.f.currentFunction + 8))
      if !p.known { run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, compiled.DIRECT_CLOSURE_BYTECODE)) }
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(p.f.bytecodeRealm)))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, self.realmAt), Reg.Rax)
    }
    run self.a.jmp(self.prologued)
    // A return's ends (Op.Return): the result in rax:rdx.
    self.a.bind(self.leaveOwn)
    if !p.scoped {
      run self.a.lea(Width.W64, Reg.R14, Mem.at(Reg.Rbp, p.argumentAt(0)))
      run self.a.movImm32(Reg.Rcx, p.arguments)
      run self.a.jmpSymbol(stubs.STUB_LEAVE)
    } else {
      if p.arguments != 0 {
        run self.a.lea(Width.W64, Reg.R14, Mem.at(Reg.Rbp, p.argumentAt(0)))
        run self.a.movImm32(Reg.Rcx, p.arguments)
        run self.a.callSymbol(stubs.STUB_LEAVE_CELLS)
      }
      let ended = run self.a.label()
      if !p.known {
        let inFrame = run self.a.label()
        run self.a.lea(Width.W64, Reg.Rcx, Mem.at(Reg.Rbp, p.scopeAt))
        run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rcx, p.rec(p.f.scope))
        run self.a.jcc(Cond.Equal, inFrame)
        run self.a.store(Width.W64, p.rec(p.f.result), Reg.Rax)
        run self.a.store(Width.W64, p.rec(p.f.result + 8), Reg.Rdx)
        run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(frames.SERVICE_SCOPE))
        run self.a.movImm32(Reg.R8, 0)
        run self.a.movImm32(Reg.R9, 0)
        run self.engineCall()
        run self.a.load(Width.W64, Reg.Rax, p.rec(p.f.result))
        run self.a.load(Width.W64, Reg.Rdx, p.rec(p.f.result + 8))
        run self.a.jmp(ended)
        self.a.bind(inFrame)
      }
      if p.scopeSlots != 0 {
        let more = run self.a.label()
        let next = run self.a.label()
        let layout = self.settings.layout
        run self.a.lea(Width.W64, Reg.Rdi, Mem.at(Reg.Rbp, p.scopeAt + signed(p.f.scopeSlots)))
        run self.a.movImm32(Reg.Rcx, p.scopeSlots)
        self.a.bind(more)
        if layout.tagWidth == 1 && layout.heapLowest == 0 {
          run self.a.cmp8MemImm(Mem.at(Reg.Rdi, u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.heapHighest))
          run self.a.jcc(Cond.Above, next)
        } else {
          run self.a.load(Width.W64, Reg.R10, Mem.at(Reg.Rdi, 0))
          run self.heapTestWith(Reg.R10, Reg.R11, next)
        }
        run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rdi, 8))
        run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R11, 0), 1)
        run self.a.jcc(Cond.Greater, next)
        run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R11, 0), 1)
        run self.a.load(Width.W64, Reg.R10, Mem.at(Reg.Rdi, 0))
        run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.RELEASE_STUB)))
        self.a.bind(next)
        run self.a.aluImm(Alu.Add, Width.W64, Reg.Rdi, 16)
        run self.a.aluImm(Alu.Sub, Width.W32, Reg.Rcx, 1)
        run self.a.jcc(Cond.NotEqual, more)
      }
      self.a.bind(ended)
      run self.a.aluStoreImm(Alu.Cmp, Width.W64, p.rec(p.f.state), u64.wrappingToI32(frames.FRAME_BARE_CONSTRUCT))
      run self.a.jcc(Cond.Above, self.leaveBuilt)
      run self.a.load(Width.W64, Reg.Rbx, p.rec(p.f.spare))
      run self.a.mov(Width.W64, Reg.Rsp, Reg.Rbp)
      run self.a.pop(Reg.Rbp)
      run self.a.ret()
    }
    self.a.bind(self.leaveBuilt)
    run self.a.load(Width.W64, Reg.Rcx, p.sf(p.f.previous))
    run self.a.store(Width.W64, Mem.at(Reg.R13, signed(p.f.currentStackFrame)), Reg.Rcx)
    run self.a.load(Width.W64, Reg.Rbx, p.rec(p.f.spare))
    run self.a.mov(Width.W64, Reg.Rsp, Reg.Rbp)
    run self.a.pop(Reg.Rbp)
    run self.a.ret()
    // The construct entry (js_baseline.relink): the prologue's head with the frame in the
    // construct state, as the baseline code's (baseline.tails); its overflow goes to the
    // baseline code's construct entry.
    let overflow = run self.a.label()
    self.constructAt = usize.toU32(self.a.offset())
    run self.a.push(Reg.Rbp)
    run self.a.mov(Width.W64, Reg.Rbp, Reg.Rsp)
    run self.a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, self.frame)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rsp, Mem.at(Reg.R13, signed(p.f.stackLimit)))
    run self.a.jcc(Cond.Below, overflow)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(p.codeWord)))
    if p.codeDelta != 0 { run self.a.lea(Width.W64, Reg.R9, Mem.at(Reg.R9, signed(p.codeDelta))) }
    run self.a.movImm32(Reg.Rax, u64.wrappingToU32(frames.FRAME_BARE_CONSTRUCT))
    run self.a.jmp(self.entered)
    self.a.bind(overflow)
    run self.a.mov(Width.W64, Reg.Rsp, Reg.Rbp)
    run self.a.pop(Reg.Rbp)
    run self.a.jmpSymbol(SYMBOL_BASELINE_CONSTRUCT)
    let mut i: usize = 0
    while i < self.polls.length() {
      let poll = self.polls.get(i)
      self.a.bind(poll.slow)
      run self.a.storeImm(Width.W32, Mem.at(Reg.Rax, signed(p.f.interruptCounter)), signed(p.f.interruptPeriod))
      run self.keepFragile()
      let state = function.exit(poll.exit)
      if state.frames != 0 {
        // A loop of an inlined body: the poll runs on the body's record, as a call the body
        // makes does (callInBody), at the loop's target.
        let last = run self.bodyRecords(&function, state, function.exitFrame(state, state.frames - 1).pc)
        run self.a.lea(Width.W64, Reg.Rbp, word(Reg.Rsp, last))
        run self.keepXmm()
        run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(frames.SERVICE_POLL))
        run self.a.movImm32(Reg.R8, 0)
        run self.a.movImm32(Reg.R9, 0)
        run self.engineCall()
        run self.restoreXmm()
        run self.bodyRecordsOff(last)
      } else {
        run self.a.storeImm(Width.W64, p.sf(p.f.currentPc), signed(poll.pc))
        run self.keepXmm()
        run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(frames.SERVICE_POLL))
        run self.a.movImm32(Reg.R8, 0)
        run self.a.movImm32(Reg.R9, 0)
        run self.engineCall()
        run self.restoreXmm()
      }
      run self.restoreFragile()
      // Nonzero: it threw. Then the interpreter takes the frame when the poll turned
      // instruction observation on.
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.movImm32(Reg.R8, leaving.HOW_POLL_THREW)
      run self.a.jcc(Cond.NotEqual, self.exitWith.get(u32.toUsize(poll.exit)))
      run self.a.loadZero8(Reg.Rax, Mem.at(Reg.R13, signed(p.f.observe)))
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.movImm32(Reg.R8, leaving.HOW_OBSERVED)
      run self.a.jcc(Cond.NotEqual, self.exitWith.get(u32.toUsize(poll.exit)))
      run self.a.jmp(poll.back)
      i = i + 1
    }
    let mut cc: usize = 0
    while cc < self.checkConstructSlows.length() {
      let item = self.checkConstructSlows.get(cc)
      let pollBody = run self.a.label()
      // Epoch change or post-poll revalidation: call helpers.CHECK_CONSTRUCT with fragile
      // GPRs and live XMM registers preserved across the C call.
      self.a.bind(item.coldSlow)
      run self.keepFragile()
      run self.keepXmm()
      run self.a.movSymbol(Reg.Rsi, item.sym)
      run self.callHelper(helpers.CHECK_CONSTRUCT)
      run self.restoreXmm()
      run self.restoreFragile()
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 1)
      run self.a.jcc(Cond.Equal, item.back)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
      run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(item.exit)))
      run self.a.jmp(pollBody)
      // Inline interrupt counter hit <= 0 (rax holds desc.realm): reset counter and poll.
      self.a.bind(item.pollSlow)
      run self.a.storeImm(Width.W32, Mem.at(Reg.Rax, signed(p.f.interruptCounter)), signed(p.f.interruptPeriod))
      self.a.bind(pollBody)
      run self.keepFragile()
      let state = function.exit(item.exit)
      if state.frames != 0 {
        let last = run self.bodyRecords(&function, state, function.exitFrame(state, state.frames - 1).pc)
        run self.a.lea(Width.W64, Reg.Rbp, word(Reg.Rsp, last))
        run self.keepXmm()
        run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(frames.SERVICE_POLL))
        run self.a.movImm32(Reg.R8, 0)
        run self.a.movImm32(Reg.R9, 0)
        run self.engineCall()
        run self.restoreXmm()
        run self.bodyRecordsOff(last)
      } else {
        run self.a.storeImm(Width.W64, p.sf(p.f.currentPc), signed(item.pc))
        run self.keepXmm()
        run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(frames.SERVICE_POLL))
        run self.a.movImm32(Reg.R8, 0)
        run self.a.movImm32(Reg.R9, 0)
        run self.engineCall()
        run self.restoreXmm()
      }
      run self.restoreFragile()
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.movImm32(Reg.R8, leaving.HOW_POLL_THREW)
      run self.a.jcc(Cond.NotEqual, self.exitWith.get(u32.toUsize(item.exit)))
      run self.a.loadZero8(Reg.Rax, Mem.at(Reg.R13, signed(p.f.observe)))
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.movImm32(Reg.R8, leaving.HOW_OBSERVED)
      run self.a.jcc(Cond.NotEqual, self.exitWith.get(u32.toUsize(item.exit)))
      run self.a.jmp(item.coldSlow)
      cc = cc + 1
    }
  }
  /// A put.elem a check.array proved (Inst.trusted): the index against the count, then the
  /// value into the element when neither it nor the one there is counted; a counted one
  /// goes out of line to the helper (coldPieces), which keeps the fragile registers over
  /// its call. `fused`: the value is the box right before (storedBox), made here.
  effect fn trustedStore(self: &mut Self, function: &Function, inst: Inst, fused: bool, done: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let miss = self.exitLabels.get(u32.toUsize(inst.exit))
    // The element a trusted read of the same index found just before is the one (R11).
    // An element through R9 needs the elements still there.
    let same = self.reusesElement(function, inst) && (!self.elementEl.doubled || self.cachedArr == self.storage(inst.a))
    // A number is there when that read went on with one (elementNumber): nothing since
    // stored to an Array or called, so the store has no old value to let go.
    let plain = same && self.elementNumber
    // A store the register allocator took for plain (regalloc.plainStore) has its index and
    // its exit's values no longer where they were: it must find R11 holding its index twice
    // and write a number it made, or the code is not used.
    if u32.toUsize(self.cursor) < self.cuts.plain.length() && self.cuts.plain.get(u32.toUsize(self.cursor)) && !(plain && fused && self.scaled == i32.wrappingToU32(inst.k)) { self.fault = true }
    if function.isElements(inst.a) || !same { run self.trustedSlot(function, inst.a, i32.wrappingToU32(inst.k), miss, inst.proven) }
    else { self.element = self.elementEl }
    let el = self.element
    // The Int that read found is still the element's tag.
    let tagged = plain && self.elementInt
    self.elementAt = NONE
    run self.bound(function, i32.wrappingToU32(inst.k))
    let cold = run self.a.label()
    let mut leaves = !plain
    if !plain && layout.tagOffset == 0 && layout.tagWidth == 1 && layout.heapLowest == 0 {
      // The heap variants' tags start at 0: one byte compare in memory tells.
      run self.a.cmp8MemImm(el.at(0), u32.wrappingToU8(layout.heapHighest))
      run self.a.jcc(Cond.BelowOrEqual, cold)
    } else if !plain {
      run self.a.load(Width.W64, Reg.Rax, el.at(0))
      // r8, not r10: values live in r10 through a trusted store (keepsFragile).
      run self.heapJump(Reg.Rax, Reg.R8, cold)
    }
    let mut box = NONE
    if fused {
      box = self.cursor - 1
      let made = function.inst(box)
      if made.op == Op.BoxF64 {
        let tagWord = layout.tagWord(layout.float64())
        if tagWord <= 0x7fffffff {
          run self.a.storeImm(Width.W64, el.at(0), u64.wrappingToI32(tagWord))
        } else {
          run self.a.movImm64(Reg.R8, tagWord)
          run self.a.store(Width.W64, el.at(0), Reg.R8)
        }
        let number = self.at(made.a)
        if number.kind == XMM { run self.a.storeDouble(el.at(8), number.xmm) }
        else { run getBits(&mut self.a, Reg.Rax, number) run self.a.store(Width.W64, el.at(8), Reg.Rax) self.cachedCount = false }
      } else {
        let mut tag = layout.int()
        if made.op == Op.BoxBool { tag = layout.boolean() }
        if !(tagged && made.op == Op.BoxI32) { run self.a.storeImm(Width.W64, el.at(0), u64.wrappingToI32(layout.tagWord(tag))) }
        // A number's register holds it zero-extended, as the payload word wants it; so does
        // the immediate of a constant that is not negative.
        let number = self.at(made.a)
        let mut known: Option<i32> = Option<i32>.none()
        if made.op == Op.BoxI32 { known = self.constants.get(u32.toUsize(made.a)) }
        match known {
          Option<i32>.Some { value } => {
            if value >= 0 { run self.a.storeImm(Width.W64, el.at(8), value) }
            else { run self.a.movImm32(Reg.Rax, i32.wrappingToU32(value)) run self.a.store(Width.W64, el.at(8), Reg.Rax) self.cachedCount = false }
          }
          Option<i32>.None => {
            if number.kind == GPR { run self.a.store(Width.W64, el.at(8), number.gpr) }
            else { run getI32(&mut self.a, Reg.Rax, number) run self.a.store(Width.W64, el.at(8), Reg.Rax) self.cachedCount = false }
          }
        }
      }
    } else {
      // RAX no longer holds the count a frame-mode access cached.
      self.cachedCount = false
      run self.a.load(Width.W64, Reg.Rax, slotOf(inst.b))
      // An immediate (a boxed number, undefined, a boolean) is never on the heap.
      if function.value(inst.b).own != Own.Imm { run self.heapJump(Reg.Rax, Reg.R8, cold) leaves = true }
      run self.a.store(Width.W64, el.at(0), Reg.Rax)
      run self.a.load(Width.W64, Reg.Rax, payloadOf(inst.b))
      run self.a.store(Width.W64, el.at(8), Reg.Rax)
    }
    self.a.bind(done)
    // The cold piece's call leaves neither the elements in R9 nor the index in R11.
    if !leaves { return () }
    self.cachedArr = NONE
    self.scaled = NONE
    run self.coldLabels.append(cold) run self.coldBacks.append(done) run self.coldInsts.append(inst) run self.coldAux.append(box) run self.coldElements.append(el)
  }
  /// Notes that `index` passed a trusted access's count test in the block being lowered.
  effect fn bound(self: &mut Self, function: &Function, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let block = function.inst(self.cursor).block
    if block != self.boundedBlock { self.bounded.clear() self.boundedBlock = block }
    run self.bounded.append(index)
  }
  /// Whether `add.i32 x, 1` cannot overflow: x is an index a trusted access earlier in the
  /// block bounded (bound), below a count of elements, which is far below 2^31.
  fn cannotOverflow(self: &Self, function: &Function, inst: Inst) -> bool {
    if inst.proven || addSubRangeSafe(&function, inst) { return true }
    if inst.op != Op.Add || inst.b == NONE || function.inst(self.cursor).block != self.boundedBlock { return false }
    match self.constants.get(u32.toUsize(inst.b)) {
      Option<i32>.Some { value } => { if value != 1 { return false } }
      Option<i32>.None => { return false }
    }
    let mut i: usize = 0
    while i < self.bounded.length() { if self.bounded.get(i) == inst.a { return true } i = i + 1 }
    return false
  }
  /// After an add or a sub that leaves its result's flags (no overflow: jo was not taken or
  /// cannot be): the flags are those of a compare of the result with 0, for the signed
  /// conditions and equality (the carry is the only one that differs).
  fn flagsAfter(self: &mut Self, inst: Inst) -> () { self.flagsValue = inst.result self.flagsOffset = self.a.offset() self.flagsBlock = inst.block }
  /// Whether the flags describe v (flagsAfter) with nothing emitted since, in this block.
  fn flagsHold(self: &Self, function: &Function, v: u32) -> bool {
    return v == self.flagsValue && self.a.offset() == self.flagsOffset && function.inst(self.cursor).block == self.flagsBlock
  }
  /// Whether RAX holds v: the last operation of this block stored it from RAX to its slot
  /// and nothing was emitted after (raxValue), so no other way reaches here.
  fn raxHolds(self: &Self, function: &Function, v: u32) -> bool { return self.raxIn == Reg.Rax && self.workHolds(function, v) }
  /// raxHolds for R8.
  fn r8Holds(self: &Self, function: &Function, v: u32) -> bool { return self.raxIn == Reg.R8 && self.workHolds(function, v) }
  fn workHolds(self: &Self, function: &Function, v: u32) -> bool {
    return v == self.raxValue && self.a.offset() == self.raxOffset && function.inst(self.cursor).block == self.raxBlock
  }
  /// Whether R11 still holds the address of the element the trusted store `inst` stores
  /// to: the last trusted read (elementAt) was of the same object and the same index, in
  /// the same block, and nothing between touches R11 or the Array (r11Kept). The Array's
  /// elements stay where they are: nothing between stores to it or calls.
  fn reusesElement(self: &Self, function: &Function, inst: Inst) -> bool {
    if self.elementAt == NONE || self.elementAt >= self.cursor { return false }
    if self.storage(inst.a) != self.elementObject || i32.wrappingToU32(inst.k) != self.elementIndex { return false }
    if function.inst(self.elementAt).block != inst.block { return false }
    let mut c = self.elementAt + 1
    while c < self.cursor { if !r11Kept(function, function.inst(c)) { return false } c = c + 1 }
    return true
  }
  /// The slow paths placed after the blocks. A trusted read fused with its unbox
  /// (coldAux: the unbox's exit) converts an Int to F64 (for UnboxF64) and returns to
  /// `coldBacks`, or copies a non-matching element/field/variable to its slot and leaves at
  /// the unbox's exit. A trusted store (coldAux: its box, or NONE) boxes its value into
  /// its slot if it made it, and has the helper store it, with the fragile registers kept
  /// over the call and the index read before rsi is written.
  effect fn coldPieces(self: &mut Self, function: &Function) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut c: usize = 0
    while c < self.coldInsts.length() {
      let inst = self.coldInsts.get(c)
      let aux = self.coldAux.get(c)
      let el = self.coldElements.get(c)
      self.a.bind(self.coldLabels.get(c))
      if inst.op == Op.GetVar {
        // No Int in the cell (RAX still holds its address): the value to its slot, borrowed,
        // for the unbox's exit.
        let f = self.plan.f
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rax, signed(f.refValue + 8)))
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.refValue)))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        run self.a.jmp(self.exitLabels.get(u32.toUsize(aux)))
      } else if inst.op == Op.GetElem || inst.op == Op.GetField {
        let defAt = self.defs.get(u32.toUsize(inst.result))
        let unbox = function.inst(defAt + 1)
        let mut at: i32 = 0
        if inst.op == Op.GetField {
          let key = self.shapes.key(defAt)
          at = u64.wrappingToI32(u64.bitAnd(key, 65535)) * 16
        }
        if unbox.op == Op.UnboxF64 {
          // Non-Float64 tag on a fused F64 read: convert Int -> F64 in R8 (preserving RAX/R9
          // for the trusted fast-array cache) and jump back to `done`.
          let layout = self.settings.layout
          let notInt = run self.a.label()
          let byteTag = layout.tagWidth == 1 && layout.float64() < 256 && layout.int() < 256
          if byteTag {
            run self.a.cmp8MemImm(el.at(at + u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.int()))
          } else {
            run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
          }
          run self.a.jcc(Cond.NotEqual, notInt)
          let out = self.at(unbox.result)
          run self.a.load(Width.W32, Reg.R8, el.at(at + 8))
          if out.kind == XMM {
            run self.a.intToDouble(Width.W32, out.xmm, Reg.R8)
          } else {
            run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.R8)
            run putF64(&mut self.a, out, Xmm.Xmm0)
          }
          run self.a.jmp(self.coldBacks.get(c))
          self.a.bind(notInt)
        }
        run self.a.load(Width.W64, Reg.Rax, el.at(at))
        run self.a.load(Width.W64, Reg.R9, el.at(at + 8))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        if function.value(inst.result).own != Own.Borrowed {
          let skip = run self.a.label()
          run self.heapTestWith(Reg.Rax, Reg.R8, skip)
          run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R9, 0), 1)
          self.a.bind(skip)
        }
        run self.a.jmp(self.exitLabels.get(u32.toUsize(aux)))
      } else {
        if aux != NONE {
          let made = function.inst(aux)
          if made.op == Op.BoxF64 {
            let number = self.at(made.a) run getBits(&mut self.a, Reg.Rax, number)
            run self.boxDoubleInto(Reg.Rax, Reg.Rsp, inst.b * SLOT_BYTES)
          } else {
            let mut known: Option<i32> = Option<i32>.none()
            if made.op == Op.BoxI32 { known = self.constants.get(u32.toUsize(made.a)) }
            match known {
              Option<i32>.Some { value } => { run self.a.movImm32(Reg.Rax, i32.wrappingToU32(value)) }
              Option<i32>.None => { let number = self.at(made.a) run getI32(&mut self.a, Reg.Rax, number) }
            }
            run self.boxInto(made.op == Op.BoxBool, Reg.Rax, Reg.Rsp, inst.b * SLOT_BYTES)
          }
        }
        run self.keepFragile()
        let index = self.at(i32.wrappingToU32(inst.k)) run getI32(&mut self.a, Reg.Rdx, index)
        // The Array itself, where the store read its elements as a value.
        let array = self.storage(function.arrayOf(inst.a))
        run self.a.lea(Width.W64, Reg.Rsi, slotOf(array))
        run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.b))
        if self.on { run self.keepXmm() }
        run self.callHelper(helpers.PUT_ELEM)
        if self.on { run self.restoreXmm() }
        run self.restoreFragile()
        // In the count, on a fast Array, the helper stores; a refusal leaves all the same.
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(self.coldBacks.get(c))
      }
      c = c + 1
    }
  }
  /// To `heap` when tagWord's value is counted (the opposite of heapTest), with `scratch`
  /// for the layouts that need a register.
  effect fn heapJump(self: &mut Self, tagWord: Reg, scratch: Reg, heap: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let plain = run self.a.label()
    let layout = self.settings.layout
    if layout.tagOffset == 0 && layout.tagWidth == 1 && layout.heapLowest == 0 {
      run self.a.cmp8Imm(tagWord, u32.wrappingToU8(layout.heapHighest))
      run self.a.jcc(Cond.BelowOrEqual, heap)
      return ()
    }
    run self.heapTestWith(tagWord, scratch, plain)
    run self.a.jmp(heap)
    self.a.bind(plain)
  }
  /// Before a call a trusted element store or a poll makes on its slow path (x64_regalloc
  /// keepsFragile): the fragile pool registers the code uses (rsi, rdi, rdx, r10, rcx) go to the
  /// scratch slots, which only the moves at a block's end use otherwise. After it: back.
  effect fn keepFragile(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut at = self.scratch
    let mut r: usize = 0
    while r < gprCount() {
      if u32.bitAnd(u32.shiftRight(self.places.pool.fragile, usize.toU32(r)), 1) != 0 && self.saves(r) {
        run self.a.store(Width.W64, Mem.at(Reg.Rsp, at), self.places.pool.registers[r])
        at = at + 8
      }
      r = r + 1
    }
  }
  effect fn restoreFragile(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut at = self.scratch
    let mut r: usize = 0
    while r < gprCount() {
      if u32.bitAnd(u32.shiftRight(self.places.pool.fragile, usize.toU32(r)), 1) != 0 && self.saves(r) {
        run self.a.load(Width.W64, self.places.pool.registers[r], Mem.at(Reg.Rsp, at))
        at = at + 8
      }
      r = r + 1
    }
  }
  /// Saves and restores every allocated XMM register (xmm2..xmm15) below rsp across a cold C
  /// call, preserving 16-byte stack alignment (14 * 8 = 112 bytes). Must wrap only the C call
  /// itself so rsp-relative accesses (keepFragile, bodyRecords, bodyRecordsOff) see the normal rsp.
  effect fn keepXmm(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.usedXmm == 0 { return () }
    run self.a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, 112)
    let mut d: u32 = 0
    while d < 14 {
      if u32.bitAnd(u32.shiftRight(self.usedXmm, d), 1) != 0 {
        run self.a.storeDouble(Mem.at(Reg.Rsp, u32.wrappingToI32(d * 8)), regalloc.xmmAt(u32.toUsize(d)))
      }
      d = d + 1
    }
  }
  effect fn restoreXmm(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.usedXmm == 0 { return () }
    let mut d: u32 = 0
    while d < 14 {
      if u32.bitAnd(u32.shiftRight(self.usedXmm, d), 1) != 0 {
        run self.a.loadDouble(regalloc.xmmAt(u32.toUsize(d)), Mem.at(Reg.Rsp, u32.wrappingToI32(d * 8)))
      }
      d = d + 1
    }
    run self.a.aluImm(Alu.Add, Width.W64, Reg.Rsp, 112)
  }
  /// The engine's service on this frame (baseline.engineCall): request in ecx, r8 and r9.
  pub effect fn engineCall(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let p = self.plan
    run self.a.load(Width.W64, Reg.Rdi, Mem.at(Reg.R13, signed(p.f.serviceHooks)))
    run self.a.load(Width.W64, Reg.Rsi, Mem.at(Reg.R13, signed(p.f.serviceAllocator)))
    run self.a.lea(Width.W64, Reg.Rdx, p.rec(0))
    run self.a.callMem(Mem.at(Reg.R13, signed(p.f.serviceEntry)))
  }
  /// rax:rdx = value v as the ValueBits a return hands over: an i32, bool or double boxed, a
  /// borrow with one count added. Clobbers R10.
  effect fn resultInto(self: &mut Self, function: &Function, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let info = function.value(v)
    if info.ty == Type.I32 || info.ty == Type.Bool {
      match self.constants.get(u32.toUsize(v)) {
        Option<i32>.Some { value } => { run self.a.movImm32(Reg.Rdx, i32.wrappingToU32(value)) }
        Option<i32>.None => { let place = self.at(v) run getI32(&mut self.a, Reg.Rdx, place) run self.a.mov(Width.W32, Reg.Rdx, Reg.Rdx) }
      }
      let mut tag = layout.int()
      if info.ty == Type.Bool { tag = layout.boolean() }
      run self.a.movImm64(Reg.Rax, layout.tagWord(tag))
      return ()
    }
    if info.ty == Type.F64 {
      let place = self.at(v) run getBits(&mut self.a, Reg.Rdx, place)
      run self.a.movImm64(Reg.Rax, layout.tagWord(layout.float64()))
      return ()
    }
    let held = self.storage(v)
    run self.a.load(Width.W64, Reg.Rax, slotOf(held))
    run self.a.load(Width.W64, Reg.Rdx, payloadOf(held))
    if info.own == Own.Imm || info.own == Own.Owned { return () }
    run self.retainBits(Reg.Rax, Reg.Rdx)
  }
  /// Frame mode: hot fast path for `a == b` / `a === b`. Specializes comparisons against
  /// constant `Null`/`Undefined`/`False`/`True`/`AtomValue` into compact inline checks;
  /// otherwise handles same-tag int32, object, flat-string pointer equality, bool, null, and
  /// undefined inline, plus strict different-tag mismatches and loose null/undefined inline.
  /// Returns `EQUALS_NO_SLOW` if `slow` is never targeted, `EQUALS_DIRECT_SLOW` if `slow`
  /// may jump directly to `helpers.EQUALS` (without needing RAX/R8 tags), or
  /// `EQUALS_GENERIC_SLOW` if `slow` expects tag(a) in RAX and tag(b) in R8. When `fused`,
  /// reaches `decided` with ZF=1 iff equal; otherwise reaches `answered` with EAX = 0 or 1.
  effect fn equalsFast(self: &mut Self, function: &Function, a: u32, b: u32, strict: bool, slow: Label, answered: Label, fused: bool, decided: Label) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    // Constant-specialized compact fast paths: Null/Undefined (strict & loose),
    // False/True (strict), and AtomValue string (strict).
    let defA = self.defs.get(u32.toUsize(a))
    let defB = self.defs.get(u32.toUsize(b))
    let mut immK: i32 = -1
    let mut other: u32 = a
    if defB != NONE && function.inst(defB).op == Op.Imm {
      let k = function.inst(defB).k
      if k >= 0 && k <= 3 { immK = k other = a }
    } else if defA != NONE && function.inst(defA).op == Op.Imm {
      let k = function.inst(defA).k
      if k >= 0 && k <= 3 { immK = k other = b }
    }
    if immK == 0 || immK == 1 {
      let tagMem = Mem.at(Reg.Rsp, u32.wrappingToI32(other * SLOT_BYTES + layout.tagOffset))
      if strict {
        let targetTag = if immK == 0 { layout.undefined() } else { layout.null() }
        if fused {
          if layout.tagWidth == 1 && targetTag < 256 {
            run self.a.cmp8MemImm(tagMem, u32.wrappingToU8(targetTag))
          } else {
            run self.loadTag(Reg.Rax, tagMem)
            run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(targetTag))
          }
        } else {
          run self.a.movImm32(Reg.Rax, 0)
          if layout.tagWidth == 1 && targetTag < 256 {
            run self.a.cmp8MemImm(tagMem, u32.wrappingToU8(targetTag))
          } else {
            run self.loadTag(Reg.R8, tagMem)
            run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(targetTag))
          }
          run self.a.setcc(Cond.Equal, Reg.Rax)
        }
        return EQUALS_NO_SLOW
      }
      // Loose compare against Null or Undefined: null/undefined -> equal; falsy object -> slow; else not equal.
      let isNeq = run self.a.label()
      let mut eqTarget = decided
      if !fused { eqTarget = run self.a.label() }
      run self.loadTag(Reg.Rax, tagMem)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.null()))
      run self.a.jcc(Cond.Equal, eqTarget)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.undefined()))
      run self.a.jcc(Cond.Equal, eqTarget)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.object()))
      run self.a.jcc(Cond.NotEqual, isNeq)
      run self.a.load(Width.W64, Reg.R11, payloadOf(other))
      run self.a.test8MemImm(Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)), u32.wrappingToU8(fields.falsy))
      run self.a.jcc(Cond.NotEqual, slow)
      self.a.bind(isNeq)
      if fused {
        run self.a.aluImm(Alu.Or, Width.W32, Reg.Rax, 1)
      } else {
        run self.a.movImm32(Reg.Rax, 0)
        run self.a.jmp(answered)
        self.a.bind(eqTarget)
        run self.a.movImm32(Reg.Rax, 1)
      }
      return EQUALS_DIRECT_SLOW
    }
    if strict && (immK == 2 || immK == 3) {
      let tagMem = Mem.at(Reg.Rsp, u32.wrappingToI32(other * SLOT_BYTES + layout.tagOffset))
      let want: u8 = if immK == 3 { 1 } else { 0 }
      if fused {
        if layout.tagWidth == 1 && layout.boolean() < 256 {
          run self.a.cmp8MemImm(tagMem, u32.wrappingToU8(layout.boolean()))
        } else {
          run self.loadTag(Reg.Rax, tagMem)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.boolean()))
        }
        run self.a.jcc(Cond.NotEqual, decided)
        run self.a.cmp8MemImm(payloadOf(other), want)
      } else {
        run self.a.movImm32(Reg.Rax, 0)
        if layout.tagWidth == 1 && layout.boolean() < 256 {
          run self.a.cmp8MemImm(tagMem, u32.wrappingToU8(layout.boolean()))
        } else {
          run self.loadTag(Reg.R8, tagMem)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.boolean()))
        }
        run self.a.jcc(Cond.NotEqual, answered)
        run self.a.cmp8MemImm(payloadOf(other), want)
        run self.a.setcc(Cond.Equal, Reg.Rax)
      }
      return EQUALS_NO_SLOW
    }
    if strict {
      let mut strConst: u32 = NONE
      if defB != NONE && function.inst(defB).op == Op.AtomValue { strConst = b other = a }
      else if defA != NONE && function.inst(defA).op == Op.AtomValue { strConst = a other = b }
      if strConst != NONE {
        let notFlat = run self.a.label()
        run self.loadTag(Reg.Rax, Mem.at(Reg.Rsp, u32.wrappingToI32(other * SLOT_BYTES + layout.tagOffset)))
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.tagOf(-7)))
        run self.a.jcc(Cond.NotEqual, notFlat)
        run self.a.load(Width.W64, Reg.R11, payloadOf(other))
        run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R11, payloadOf(strConst))
        run self.a.jcc(Cond.NotEqual, slow)
        if fused {
          run self.a.jmp(decided)
          self.a.bind(notFlat)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.tagOf(-6)))
          run self.a.jcc(Cond.Equal, slow)
        } else {
          run self.a.movImm32(Reg.Rax, 1)
          run self.a.jmp(answered)
          self.a.bind(notFlat)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.tagOf(-6)))
          run self.a.jcc(Cond.Equal, slow)
          run self.a.movImm32(Reg.Rax, 0)
        }
        return EQUALS_DIRECT_SLOW
      }
    }
    let diffTag = run self.a.label()
    let notInt = run self.a.label()
    let notObj = run self.a.label()
    let notStr = run self.a.label()
    let notBool = run self.a.label()
    let isNeq = run self.a.label()
    let mut eqTarget = decided
    if !fused { eqTarget = run self.a.label() }
    run self.loadTag(Reg.Rax, Mem.at(Reg.Rsp, u32.wrappingToI32(a * SLOT_BYTES + layout.tagOffset)))
    run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(b * SLOT_BYTES + layout.tagOffset)))
    run self.a.alu(Alu.Cmp, Width.W32, Reg.Rax, Reg.R8)
    run self.a.jcc(Cond.NotEqual, diffTag)
    // Same tag: Int -> 32-bit payload cmp.
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.int()))
    run self.a.jcc(Cond.NotEqual, notInt)
    run self.a.load(Width.W32, Reg.R11, payloadOf(a))
    if fused {
      run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.R11, payloadOf(b))
      run self.a.jmp(decided)
    } else {
      run self.a.movImm32(Reg.Rax, 0)
      run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.R11, payloadOf(b))
      run self.a.setcc(Cond.Equal, Reg.Rax)
      run self.a.jmp(answered)
    }
    // Same tag: Object -> 64-bit pointer cmp.
    self.a.bind(notInt)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.object()))
    run self.a.jcc(Cond.NotEqual, notObj)
    run self.a.load(Width.W64, Reg.R11, payloadOf(a))
    if fused {
      run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R11, payloadOf(b))
      run self.a.jmp(decided)
    } else {
      run self.a.movImm32(Reg.Rax, 0)
      run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R11, payloadOf(b))
      run self.a.setcc(Cond.Equal, Reg.Rax)
      run self.a.jmp(answered)
    }
    // Same tag: FlatString (-7) -> 64-bit pointer equality fast path; distinct pointers go slow.
    self.a.bind(notObj)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.tagOf(-7)))
    run self.a.jcc(Cond.NotEqual, notStr)
    run self.a.load(Width.W64, Reg.R11, payloadOf(a))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R11, payloadOf(b))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.jmp(eqTarget)
    // Same tag: Bool -> low-byte payload cmp.
    self.a.bind(notStr)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.boolean()))
    run self.a.jcc(Cond.NotEqual, notBool)
    run self.a.loadZero8(Reg.R11, payloadOf(a))
    run self.a.loadZero8(Reg.R9, payloadOf(b))
    if fused {
      run self.a.alu(Alu.Cmp, Width.W32, Reg.R11, Reg.R9)
      run self.a.jmp(decided)
    } else {
      run self.a.movImm32(Reg.Rax, 0)
      run self.a.alu(Alu.Cmp, Width.W32, Reg.R11, Reg.R9)
      run self.a.setcc(Cond.Equal, Reg.Rax)
      run self.a.jmp(answered)
    }
    // Same tag: Null or Undefined -> equal; Float64/Rope/BigInt/Symbol -> slow.
    self.a.bind(notBool)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.null()))
    run self.a.jcc(Cond.Equal, eqTarget)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.undefined()))
    run self.a.jcc(Cond.Equal, eqTarget)
    run self.a.jmp(slow)
    // Different tags (RAX != R8).
    self.a.bind(diffTag)
    if strict {
      // Under ===, only (Int, Float64), (String, Rope), or (BigInt, ShortBigInt) can match.
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.float64()))
      run self.a.jcc(Cond.Equal, slow)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
      run self.a.jcc(Cond.Equal, slow)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.tagOf(-6)))
      run self.a.jcc(Cond.Equal, slow)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.tagOf(-6)))
      run self.a.jcc(Cond.Equal, slow)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.tagOf(-9)))
      run self.a.jcc(Cond.Equal, slow)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.tagOf(-9)))
      run self.a.jcc(Cond.Equal, slow)
    } else {
      // Under ==, settle all comparisons involving null or undefined inline (except htmlDda objects).
      let aNullish = run self.a.label()
      let bNullish = run self.a.label()
      let checkObj = run self.a.label()
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.null()))
      run self.a.jcc(Cond.Equal, aNullish)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.undefined()))
      run self.a.jcc(Cond.Equal, aNullish)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.null()))
      run self.a.jcc(Cond.Equal, bNullish)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.undefined()))
      run self.a.jcc(Cond.NotEqual, slow)
      self.a.bind(bNullish)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.object()))
      run self.a.jcc(Cond.NotEqual, isNeq)
      run self.a.load(Width.W64, Reg.R11, payloadOf(a))
      run self.a.jmp(checkObj)
      self.a.bind(aNullish)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.null()))
      run self.a.jcc(Cond.Equal, eqTarget)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.undefined()))
      run self.a.jcc(Cond.Equal, eqTarget)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
      run self.a.jcc(Cond.NotEqual, isNeq)
      run self.a.load(Width.W64, Reg.R11, payloadOf(b))
      self.a.bind(checkObj)
      run self.a.test8MemImm(Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)), u32.wrappingToU8(fields.falsy))
      run self.a.jcc(Cond.NotEqual, slow)
    }
    self.a.bind(isNeq)
    if fused {
      // Clear ZF (bit 0 set -> nonzero result) so `decided` observes NotEqual.
      run self.a.aluImm(Alu.Or, Width.W32, Reg.Rax, 1)
    } else {
      run self.a.movImm32(Reg.Rax, 0)
      run self.a.jmp(answered)
      self.a.bind(eqTarget)
      run self.a.movImm32(Reg.Rax, 1)
    }
    return EQUALS_GENERIC_SLOW
  }
  /// The `call` the `call.arg` being lowered belongs to: the next one in its block.
  fn callOf(self: &Self, function: &Function) -> Inst {
    let mut at = self.cursor + 1
    while function.inst(at).op != Op.Call { at = at + 1 }
    return function.inst(at)
  }
  /// A call in frame mode. The callee, the receiver of a method call and the arguments are
  /// lent to the operand cells the interpreter would have them in (the exit's depth), and
  /// the baseline call stub that leaves those cells alone makes the call (STUB_CALL_KEEP):
  /// the owned result comes back in rax:rdx. A call the stub declines, or one that threw,
  /// leaves through the call's exit, which is the state before the call.
  /// An equality or a store that left compiled code before (SITE_EQUAL, SITE_PUT_FIELD)
  /// tries its helper and leaves for the baseline code's instruction when that declines.
  effect fn callOnFrame(self: &mut Self, function: &Function, inst: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let p = self.plan
    let layout = self.settings.layout
    if calls.kindOf(inst) == compiled.SITE_PUT_FIELD {
      let done = run self.a.label()
      let slow = run self.a.label()
      let add = self.shapes.add(self.cursor)
      if add != 0 && u64.wrappingToU32(u64.shiftRight(add, 32)) == self.fields.addKey {
        // The add its inline key names goes in place first (addInPlace); the slot takes a
        // count of its own, for the code still owns the value.
        let memo = u64.wrappingToU32(add) & (self.fields.memoEntries - 1)
        let atom = self.shapes.atom(self.cursor)
        run self.addInPlace(inst, memo, atom, slow)
        run self.retainBits(Reg.Rax, Reg.R9)
      } else {
        run self.a.jmp(slow)
      }
      let step = self.stepAt()
      let mut shape: u32 = 0
      if step != 0 {
        let after = self.depthAfter(&function, inst, step)
        shape = leaving.stepShape(0, 0, 0, after)
      }
      run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: done, inst: inst, step: step, shape: shape, out: NONE, extra: 0, kind: STEP_SITE_PUT_FIELD })
      self.a.bind(done)
      // The store's undefined, dropped by the release right after: neither is written.
      if self.uses.get(u32.toUsize(inst.result)) == 1 && self.storage(inst.result) == inst.result && u32.toUsize(self.cursor + 1) < function.insts.length() {
        let next = function.inst(self.cursor + 1)
        if next.op == Op.Release && next.a == inst.result && next.block == inst.block { self.dropAt = self.cursor + 1 return () }
      }
      run self.a.movImm64(Reg.Rax, layout.tagWord(layout.undefined()))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.storeImm(Width.W64, payloadOf(inst.result), 0)
      return ()
    }
    if calls.kindOf(inst) == compiled.SITE_ADD {
      // The engine joins a string and a string or number (SERVICE_CONCAT): the left cell is
      // the record's result, which takes a count of a of its own and is replaced by the
      // text; b is lent. When it threw, the copy is consumed and the code leaves as a call
      // that threw. When neither is a string, the copy's count goes again (a still holds
      // one) and the interpreter adds on the frame.
      run self.a.load(Width.W64, Reg.Rax, slotOf(inst.a))
      run self.a.load(Width.W64, Reg.Rdx, payloadOf(inst.a))
      run self.a.store(Width.W64, p.rec(p.f.result), Reg.Rax)
      run self.a.store(Width.W64, p.rec(p.f.result + 8), Reg.Rdx)
      run self.retainBits(Reg.Rax, Reg.Rdx)
      run self.a.storeImm(Width.W64, p.sf(p.f.currentPc), u32.wrappingToI32(inst.pc))
      run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(u64.bitOr(frames.SERVICE_CONCAT, frames.CONCAT_BORROWED)))
      run self.a.lea(Width.W64, Reg.R8, p.rec(p.f.result))
      run self.a.lea(Width.W64, Reg.R9, slotOf(inst.b))
      run self.engineCall()
      let slow = run self.a.label()
      let done = run self.a.label()
      run self.a.test(Width.W64, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, slow)
      run self.a.load(Width.W64, Reg.Rax, p.rec(p.f.result))
      run self.a.load(Width.W64, Reg.Rdx, p.rec(p.f.result + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rdx)
      let step = self.stepAt()
      let mut shape: u32 = 0
      if step != 0 {
        let after = self.depthAfter(&function, inst, step)
        shape = leaving.stepShape(after - 1, 1, 0, after)
      }
      run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: done, inst: inst, step: step, shape: shape, out: NONE, extra: 0, kind: STEP_ADD_SLOW })
      self.a.bind(done)
      return ()
    }
    if calls.kindOf(inst) == compiled.SITE_EQUAL {
      let inPlace = run self.a.label()
      let slow = run self.a.label()
      let done = run self.a.label()
      let mode = run self.equalsFast(&function, inst.a, inst.b, false, slow, inPlace, false, inPlace)
      self.a.bind(inPlace)
      if calls.notEqualOf(inst) { run self.a.aluImm(Alu.Xor, Width.W32, Reg.Rax, 1) }
      run self.a.movImm64(Reg.R9, layout.tagWord(layout.boolean()))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.R9)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rax)
      if mode != EQUALS_NO_SLOW {
        let step = self.stepAt()
        let mut shape: u32 = 0
        if step != 0 {
          let after = self.depthAfter(&function, inst, step)
          shape = leaving.stepShape(after - 1, 1, 0, after)
        }
        let mut extra: u32 = 4
        if mode == EQUALS_DIRECT_SLOW { extra = extra | 8 }
        run self.stepSlows.append(StepSlow { entry: slow, auxLabel: done, back: inPlace, inst: inst, step: step, shape: shape, out: NONE, extra: extra, kind: STEP_EQUALS_SLOW })
      }
      self.a.bind(done)
      return ()
    }
    let count = calls.countOf(inst)
    let depth = function.exit(inst.exit).stackDepth
    if function.exit(inst.exit).frames != 0 { run self.callInBody(&function, inst) return () }
    if (inst.k & calls.GENERIC) != 0 {
      // An instruction without a template: the interpreter runs it on the frame. Its values
      // are the operand cells from its first operand's up.
      let step = self.stepAt()
      let after = self.depthAfter(&function, inst, step)
      let base = depth - count
      let mut results = i32.wrappingToU32(calls.resultCount(inst.k))
      if results == 0 { results = after - base }
      let first = results != 0 && !calls.kept(inst.k, 0)
      let mut out = NONE
      if first { out = inst.result }
      let stepped = run self.a.label()
      if (step & STEP_QUICK) != 0 && first && after == base + 1 && calls.keptCells(inst.k) == 0 && self.operandsOf(&function, count) {
        // An instruction the engine makes without the interpreter (SERVICE_QUICK, as
        // baseline code asks for it): a literal, its fields and prototype, an array of
        // the operands, the rest parameters, a regular expression literal. The operand cells get the operands, each with
        // a count of its own the instruction consumes, and the one value it leaves in the
        // first cell is the code's. What the engine declines changes nothing: the counts
        // go again and the interpreter steps it.
        let declined = run self.a.label()
        let p = self.plan
        let mut i: u32 = 0
        while i < count {
          let arg = function.inst(self.cursor - count + i)
          let at = i32.wrappingToU32(p.operandAt(base + i))
          run self.valueInto(&function, arg.a, SlotMode.Imm, Reg.Rbp, at)
          run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rbp, p.operandAt(base + i)))
          run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rbp, p.operandAt(base + i) + 8))
          run self.retainBits(Reg.Rax, Reg.Rdx)
          i = i + 1
        }
        run self.a.movImm32(Reg.Rcx, u32.bitOr(u64.wrappingToU32(frames.SERVICE_QUICK), u32.shiftLeft(inst.pc, 8)))
        run self.a.lea(Width.W64, Reg.R8, Mem.at(Reg.Rbp, p.operandAt(base + count)))
        run self.a.movImm32(Reg.R9, 0)
        run self.engineCall()
        run self.a.test(Width.W64, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.NotEqual, declined)
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rbp, p.operandAt(base)))
        run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rbp, p.operandAt(base) + 8))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rdx)
        let shape = leaving.stepShape(base, results, i32.wrappingToU32(calls.keptCells(inst.k)), after)
        run self.stepSlows.append(StepSlow { entry: declined, auxLabel: declined, back: stepped, inst: inst, step: step, shape: shape, out: out, extra: base, kind: STEP_GENERIC_DECLINED })
        self.a.bind(stepped)
        return ()
      }
      if (step & STEP_GET_PRIVATE) != 0 && count == 2 && first && after == base + 1 && calls.keptCells(inst.k) == 0 && self.operandsOf(&function, count) {
        // OP_get_private_field fast path via baseline_env.GET_PRIVATE: consumes the two
        // operand counts and writes the owned field value into cell[base] on 1; leaves
        // everything untouched on 0 so STEP_GENERIC_DECLINED releases and steps on frame.
        let declined = run self.a.label()
        let p = self.plan
        let mut i: u32 = 0
        while i < count {
          let arg = function.inst(self.cursor - count + i)
          let at = i32.wrappingToU32(p.operandAt(base + i))
          run self.valueInto(&function, arg.a, SlotMode.Imm, Reg.Rbp, at)
          run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rbp, p.operandAt(base + i)))
          run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rbp, p.operandAt(base + i) + 8))
          run self.retainBits(Reg.Rax, Reg.Rdx)
          i = i + 1
        }
        run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
        run self.a.lea(Width.W64, Reg.Rsi, Mem.at(Reg.Rbp, p.operandAt(base)))
        run self.keepXmm()
        run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.GET_PRIVATE)))
        run self.restoreXmm()
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Equal, declined)
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rbp, p.operandAt(base)))
        run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rbp, p.operandAt(base) + 8))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rdx)
        let shape = leaving.stepShape(base, results, i32.wrappingToU32(calls.keptCells(inst.k)), after)
        run self.stepSlows.append(StepSlow { entry: declined, auxLabel: declined, back: stepped, inst: inst, step: step, shape: shape, out: out, extra: base, kind: STEP_GENERIC_DECLINED })
        self.a.bind(stepped)
        return ()
      }
      if (step & STEP_PUT_PRIVATE) != 0 && count == 3 && !first && after == base && calls.keptCells(inst.k) == 0 && self.operandsOf(&function, count) {
        // OP_put_private_field fast path via baseline_env.PUT_PRIVATE: consumes the three
        // operand counts on 1; leaves everything untouched on 0 so STEP_GENERIC_DECLINED
        // releases them and steps on frame.
        let declined = run self.a.label()
        let p = self.plan
        let mut i: u32 = 0
        while i < count {
          let arg = function.inst(self.cursor - count + i)
          let at = i32.wrappingToU32(p.operandAt(base + i))
          run self.valueInto(&function, arg.a, SlotMode.Imm, Reg.Rbp, at)
          run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rbp, p.operandAt(base + i)))
          run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rbp, p.operandAt(base + i) + 8))
          run self.retainBits(Reg.Rax, Reg.Rdx)
          i = i + 1
        }
        run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
        run self.a.lea(Width.W64, Reg.Rsi, Mem.at(Reg.Rbp, p.operandAt(base)))
        run self.keepXmm()
        run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.PUT_PRIVATE)))
        run self.restoreXmm()
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Equal, declined)
        let shape = leaving.stepShape(base, results, i32.wrappingToU32(calls.keptCells(inst.k)), after)
        run self.stepSlows.append(StepSlow { entry: declined, auxLabel: declined, back: stepped, inst: inst, step: step, shape: shape, out: out, extra: base, kind: STEP_GENERIC_DECLINED })
        self.a.bind(stepped)
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.undefined()))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.storeImm(Width.W64, payloadOf(inst.result), 0)
        return ()
      }
      if (step & STEP_HOME_OBJECT) != 0 && inst.frame == 0 && count == 0 && first && after == base + 1 && calls.keptCells(inst.k) == 0 && inst.result != NONE && self.closureHome != u32.MAX {
        // OP_special_object kind=4 (HOME_OBJECT): loads currentFunction's homeObject
        // (or undefined if null), retained into inst.result; falls back to stepOnFrame if
        // currentFunction is not an object.
        let p = self.plan
        let shape = leaving.stepShape(base, results, i32.wrappingToU32(calls.keptCells(inst.k)), after)
        let cold = run self.deferStep(inst, step, shape, out, stepped, STEP_PLAIN)
        let isNull = run self.a.label()
        if layout.tagWidth == 1 && layout.object() < 256 {
          run self.a.cmp8MemImm(p.sf(p.f.currentFunction + layout.tagOffset), u32.wrappingToU8(layout.object()))
        } else {
          run self.loadTag(Reg.Rax, p.sf(p.f.currentFunction + layout.tagOffset))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.object()))
        }
        run self.a.jcc(Cond.NotEqual, cold)
        run self.a.load(Width.W64, Reg.R9, p.sf(p.f.currentFunction + 8))
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R9, signed(self.closureHome)))
        run self.a.test(Width.W64, Reg.R9, Reg.R9)
        run self.a.jcc(Cond.Equal, isNull)
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.object()))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R9, 0), 1)
        run self.a.jmp(stepped)
        self.a.bind(isNull)
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.undefined()))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.storeImm(Width.W64, payloadOf(inst.result), 0)
        self.a.bind(stepped)
        return ()
      }
      let cold = run self.deferStep(inst, step, leaving.stepShape(base, results, i32.wrappingToU32(calls.keptCells(inst.k)), after), out, stepped, STEP_PLAIN)
      run self.a.jmp(cold)
      self.a.bind(stepped)
      if !first {
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.undefined()))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.storeImm(Width.W64, payloadOf(inst.result), 0)
      }
      return ()
    }
    if (inst.k & calls.CONSTRUCT) != 0 {
      // As the baseline code constructs (STUB_CONSTRUCT): the function and new.target are
      // lent to their operand cells, the arguments are there with a count each (CallArg),
      // and the owned result comes back in rax:rdx. The engine leaves undefined in the cell
      // of an argument it moved into the object; the others' counts are dropped here.
      let function0 = p.operandAt(depth - count - 2)
      run self.valueInto(&function, inst.a, SlotMode.Imm, Reg.Rbp, i32.wrappingToU32(function0))
      run self.valueInto(&function, inst.b, SlotMode.Imm, Reg.Rbp, i32.wrappingToU32(function0 + 16))
      run self.a.lea(Width.W64, Reg.R14, Mem.at(Reg.Rbp, function0))
      run self.a.movImm32(Reg.Rdx, count)
      run self.a.movImm32(Reg.Rax, inst.pc + 1)
      run self.a.callSymbol(stubs.STUB_CONSTRUCT)
      let threw = run self.a.label()
      run self.a.test(Width.W32, Reg.Rcx, Reg.Rcx)
      run self.a.jcc(Cond.NotEqual, threw)
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rdx)
      let mut k: u32 = 0
      while k < count { run self.releaseCell(p.operandAt(depth - count + k)) k = k + 1 }
      run self.stepSlows.append(StepSlow { entry: threw, auxLabel: threw, back: threw, inst: inst, step: 0, shape: i32.wrappingToU32(p.operandAt(depth - count)), out: NONE, extra: 0, kind: STEP_CONSTRUCT_THREW })
      return ()
    }
    let mut method = false
    let mut m: usize = 0
    while m < self.methods.length() { if self.methods.get(m) == inst.pc { method = true } m = m + 1 }
    let callee = p.operandAt(depth - count - 1)
    let answered = run self.a.label()
    let early = method && run self.pushEarly(&function, inst, Reg.Rbp, callee + 16, answered)
    run self.valueInto(&function, inst.a, SlotMode.Imm, Reg.Rbp, i32.wrappingToU32(callee))
    if method { run self.valueInto(&function, inst.b, SlotMode.Imm, Reg.Rbp, i32.wrappingToU32(callee - 16)) }
    if method {
      run self.arrayCall(&function, inst, Reg.Rbp, callee, inst.pc + 1, answered, early)
      run self.mathCallOnFrame(inst, Reg.Rbp, callee, answered)
    }
    // The stub's site: r14 the callee's cell, edx the count (with bit 31 set for a known
    // local function so STUB_CALL_KEEP passes p.rec(f.scope) to sibling known callees), eax
    // the pc a frame the callee publishes is at (past the call).
    run self.a.lea(Width.W64, Reg.R14, Mem.at(Reg.Rbp, callee))
    let mut callCount = count
    if !method && (self.plan.known || self.plan.scoped) { callCount = callCount | 0x80000000 }
    run self.a.movImm32(Reg.Rdx, callCount)
    run self.a.movImm32(Reg.Rax, inst.pc + 1)
    if method { run self.a.callSymbol(stubs.STUB_CALL_METHOD_KEEP) } else { run self.a.callSymbol(stubs.STUB_CALL_KEEP) }
    // ecx: 0 returned, HOW_DECLINED, HOW_CALL_THREW.
    // An exit takes how it left in r8d (x64_exits).
    run self.a.mov(Width.W32, Reg.R8, Reg.Rcx)
    run self.a.test(Width.W32, Reg.Rcx, Reg.Rcx)
    run self.a.jcc(Cond.NotEqual, self.exitWith.get(u32.toUsize(inst.exit)))
    run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
    run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rdx)
    self.a.bind(answered)
  }

  /// Fast path for 1- or 2-argument Math.* native calls on frame-mode operands where
  /// `[base + callee]` is the callee and `[base + callee + 16..]` are the arguments.
  /// Filters to `BuiltinFamily.Math` inline so non-Math C functions never jump to `PACK_COLD`.
  /// A callee of `BuiltinFamily.String` with one argument goes to STEP_UNIT_SLOW the same
  /// way (the receiver is in the cell before the callee's): charCodeAt and charAt.
  effect fn mathCallOnFrame(self: &mut Self, inst: Inst, base: Reg, callee: i32, done: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = calls.countOf(inst)
    if (count != 1 && count != 2) || (inst.k & (calls.CONSTRUCT | calls.GENERIC | calls.LAZY_ARGUMENTS)) != 0 { return () }
    let layout = self.settings.layout
    let fields = self.fields
    let math = self.math
    let notMath = run self.a.label()
    let coldMath = run self.a.label()
    if layout.tagWidth == 1 && layout.object() < 256 {
      run self.a.cmp8MemImm(Mem.at(base, callee + u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.object()))
    } else {
      run self.loadTag(Reg.R8, Mem.at(base, callee + u32.wrappingToI32(layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
    }
    run self.a.jcc(Cond.NotEqual, notMath)
    run self.a.load(Width.W64, Reg.R9, Mem.at(base, callee + 8))
    run self.a.loadZero16(Reg.R8, Mem.at(Reg.R9, u32.wrappingToI32(fields.objectClass)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(classes.JS_CLASS_C_FUNCTION))
    run self.a.jcc(Cond.NotEqual, notMath)
    if math.fnTagAt != u32.MAX && math.familyAt != u32.MAX {
      run self.a.cmp8MemImm(Mem.at(Reg.R9, signed(math.fnTagAt)), math.builtinTag)
      run self.a.jcc(Cond.NotEqual, notMath)
      run self.a.cmp8MemImm(Mem.at(Reg.R9, signed(math.familyAt)), math.mathFamily)
      run self.a.jcc(Cond.Equal, coldMath)
      if count == 1 && math.stringFamily != math.mathFamily {
        let coldUnit = run self.a.label()
        run self.a.cmp8MemImm(Mem.at(Reg.R9, signed(math.familyAt)), math.stringFamily)
        run self.a.jcc(Cond.Equal, coldUnit)
        let unitBase: u32 = if base == Reg.Rbp { 0 } else { 1 }
        run self.stepSlows.append(StepSlow { entry: coldUnit, auxLabel: notMath, back: done, inst: inst, step: 0, shape: i32.wrappingToU32(callee), out: NONE, extra: unitBase, kind: STEP_UNIT_SLOW })
      }
    } else {
      run self.a.jmp(coldMath)
    }
    self.a.bind(notMath)
    let baseKind: u32 = if base == Reg.Rbp { 0 } else { 1 }
    run self.stepSlows.append(StepSlow { entry: coldMath, auxLabel: notMath, back: done, inst: inst, step: 0, shape: i32.wrappingToU32(callee), out: NONE, extra: baseKind, kind: STEP_MATH_SLOW })
  }

  /// A call that an inlined body makes, in frame mode. The frame chain must show the body's
  /// activation between the callee's and the function's own, so each body around the call
  /// gets a record in this frame (js_baseline.FRAME_BARE_INLINED: its function, receiver
  /// and where it is in its code) whose frame pointer word leads to the record around it,
  /// and the call is made with rbp at the innermost: the baseline call stub and the callee
  /// then see a baseline frame that is the body's. The operands are lent to cells of the
  /// call's own. Afterwards rbp is the frame's again, and records the engine completed
  /// (it does when something reads the chain) are taken off the chain. The call's exit
  /// names the bodies' frames (ssa.Exit.frames): where it leaves when the stub declines
  /// or the callee threw.
  effect fn callInBody(self: &mut Self, function: &Function, inst: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let exit = function.exit(inst.exit)
    let count = calls.countOf(inst)
    if (inst.k & calls.CONSTRUCT) != 0 {
      let base = self.callAt
      run self.valueInto(&function, inst.a, SlotMode.Imm, Reg.Rsp, base)
      run self.valueInto(&function, inst.b, SlotMode.Imm, Reg.Rsp, base + SLOT_BYTES)
      let last = run self.bodyRecords(&function, exit, NONE)
      run self.a.lea(Width.W64, Reg.R14, word(Reg.Rsp, base))
      run self.a.movImm32(Reg.Rdx, count)
      run self.a.movImm32(Reg.Rax, inst.pc + 1)
      run self.a.lea(Width.W64, Reg.Rbp, word(Reg.Rsp, last))
      run self.a.callSymbol(stubs.STUB_CONSTRUCT)
      run self.bodyRecordsOff(last)
      let threw = run self.a.label()
      run self.a.test(Width.W32, Reg.Rcx, Reg.Rcx)
      run self.a.jcc(Cond.NotEqual, threw)
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rdx)
      let mut k: u32 = 0
      while k < count { run self.releaseAt(Reg.Rsp, u32.wrappingToI32(base + (2 + k) * SLOT_BYTES), false) k = k + 1 }
      run self.stepSlows.append(StepSlow { entry: threw, auxLabel: threw, back: threw, inst: inst, step: 0, shape: base + 2 * SLOT_BYTES, out: NONE, extra: 1, kind: STEP_CONSTRUCT_THREW })
      return ()
    }
    let method = (inst.k & calls.METHOD) != 0
    let callee = self.callAt + SLOT_BYTES
    let answered = run self.a.label()
    let early = method && run self.pushEarly(&function, inst, Reg.Rsp, u32.wrappingToI32(callee + SLOT_BYTES), answered)
    run self.valueInto(&function, inst.a, SlotMode.Imm, Reg.Rsp, callee)
    if method { run self.valueInto(&function, inst.b, SlotMode.Imm, Reg.Rsp, callee - SLOT_BYTES) }
    if method {
      run self.arrayCall(&function, inst, Reg.Rsp, u32.wrappingToI32(callee), exit.pc + 1, answered, early)
      run self.mathCallOnFrame(inst, Reg.Rsp, u32.wrappingToI32(callee), answered)
    }
    let last = run self.bodyRecords(&function, exit, NONE)
    let mut callCount = count
    if !method && inst.frame != 0 && self.scopedFn(inst.frame - 1) {
      // The body runs under the scope of its level on the frame's own chain (loadScopeAt),
      // and a known local function it calls under one further up: the stub walks there
      // from the record's scope word (bit 31 of the count, as callOnFrame's).
      let p = self.plan
      let none = run self.a.label()
      let closure = self.inlineClosures.get(u32.toUsize(inst.frame - 1))
      run self.a.load(Width.W64, Reg.R8, payloadOf(closure))
      run self.a.load(Width.W32, Reg.R8, Mem.at(Reg.R8, signed(p.f.knownLevel)))
      run self.ownScopeInto(Reg.R11)
      run self.levelScope(Reg.R11, Reg.R8, none)
      self.a.bind(none)
      run self.a.store(Width.W64, word(Reg.Rsp, last - i32.wrappingToU32(0 - p.record) + p.f.scope), Reg.R11)
      callCount = callCount | 0x80000000
    }
    // The stub's site, as callOnFrame's, on the innermost body's record.
    run self.a.lea(Width.W64, Reg.R14, word(Reg.Rsp, callee))
    run self.a.movImm32(Reg.Rdx, callCount)
    run self.a.movImm32(Reg.Rax, inst.pc + 1)
    run self.a.lea(Width.W64, Reg.Rbp, word(Reg.Rsp, last))
    if method { run self.a.callSymbol(stubs.STUB_CALL_METHOD_KEEP) } else { run self.a.callSymbol(stubs.STUB_CALL_KEEP) }
    run self.bodyRecordsOff(last)
    // ecx: 0 returned, HOW_DECLINED, HOW_CALL_THREW.
    // An exit takes how it left in r8d (x64_exits).
    run self.a.mov(Width.W32, Reg.R8, Reg.Rcx)
    run self.a.test(Width.W32, Reg.Rcx, Reg.Rcx)
    run self.a.jcc(Cond.NotEqual, self.exitWith.get(u32.toUsize(inst.exit)))
    run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
    run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rdx)
    self.a.bind(answered)
  }

  /// Writes the records of the bodies around a call or poll whose exit is `exit` (callInBody)
  /// and answers where the innermost one's frame pointer word is from rsp: rbp for what
  /// runs on the chain. `at` is the innermost body's position, or NONE when what is called
  /// stores it. Clobbers RAX, R9.
  effect fn bodyRecords(self: &mut Self, function: &Function, exit: ssa.Exit, at: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let p = self.plan
    let layout = self.settings.layout
    let recordBytes = i32.wrappingToU32(0 - p.record)
    // The function's own frame is at the outermost inlined call.
    run self.a.storeImm(Width.W64, p.sf(p.f.currentPc), u32.wrappingToI32(exit.pc + 1))
    // Each body's function and receiver are operands of the call that began it, on the stack
    // of the frame around it: the function's own first, then each body's in turn.
    let mut stackAt = function.localCount
    let mut depth = exit.stackDepth
    let mut inner = function.exitSlots(exit)
    let mut n: u32 = 0
    while n < exit.frames {
      let frame = function.exitFrame(exit, n)
      let pointer = self.bodyAt + n * (recordBytes + 16) + recordBytes
      let stack = pointer - recordBytes + p.f.frame
      let closure = function.slot(exit, stackAt + depth - frame.argc - 1).value
      run self.valueInto(&function, closure, SlotMode.Imm, Reg.Rsp, stack + p.f.currentFunction)
      let mut hasReceiver = false
      let mut receiver: u32 = 0
      if frame.method {
        let rslot = function.slot(exit, stackAt + depth - frame.argc - 2)
        if rslot.mode != SlotMode.Virtual { hasReceiver = true receiver = rslot.value }
      }
      if hasReceiver {
        run self.valueInto(&function, receiver, SlotMode.Imm, Reg.Rsp, stack + p.f.thisValue)
      } else {
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.undefined()))
        run self.a.store(Width.W64, word(Reg.Rsp, stack + p.f.thisValue), Reg.Rax)
        run self.a.storeImm(Width.W64, word(Reg.Rsp, stack + p.f.thisValue + 8), 0)
      }
      run self.a.storeImm(Width.W64, word(Reg.Rsp, pointer - recordBytes + p.f.state), u64.wrappingToI32(frames.FRAME_BARE_INLINED))
      if n + 1 < exit.frames { run self.a.storeImm(Width.W64, word(Reg.Rsp, stack + p.f.currentPc), u32.wrappingToI32(frame.pc + 1)) }
      else if at != NONE { run self.a.storeImm(Width.W64, word(Reg.Rsp, stack + p.f.currentPc), u32.wrappingToI32(at)) }
      if n == 0 { run self.a.store(Width.W64, word(Reg.Rsp, pointer), Reg.Rbp) }
      else {
        run self.a.lea(Width.W64, Reg.Rax, word(Reg.Rsp, pointer - recordBytes - 16))
        run self.a.store(Width.W64, word(Reg.Rsp, pointer), Reg.Rax)
      }
      stackAt = inner + frame.locals
      depth = frame.depth
      inner = inner + frame.locals + frame.depth
      n = n + 1
    }
    return self.bodyAt + (exit.frames - 1) * (recordBytes + 16) + recordBytes
  }
  /// After what ran on bodyRecords' chain (`last` is its answer): rbp is the frame's again.
  /// The engine completed the records when something read the frame chain meanwhile (all
  /// of them: it completes outwards); the chain is then back at what was around the
  /// outermost. Keeps every register but RBP and R10.
  effect fn bodyRecordsOff(self: &mut Self, last: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let p = self.plan
    let recordBytes = i32.wrappingToU32(0 - p.record)
    run self.a.lea(Width.W64, Reg.Rbp, Mem.at(Reg.Rsp, self.frame))
    let bare = run self.a.label()
    run self.a.aluStoreImm(Alu.Cmp, Width.W64, word(Reg.Rsp, last - recordBytes + p.f.state), u64.wrappingToI32(frames.FRAME_BUILT_INLINED))
    run self.a.jcc(Cond.NotEqual, bare)
    run self.a.load(Width.W64, Reg.R10, word(Reg.Rsp, self.bodyAt + p.f.frame + p.f.previous))
    run self.a.store(Width.W64, Mem.at(Reg.R13, signed(p.f.currentStackFrame)), Reg.R10)
    self.a.bind(bare)
  }

  /// r9 = the site address of the element instruction being lowered (its operand's address,
  /// js_baseline.ElementSite.site), r8 = its element site cache entry for the shape version
  /// in rax (js_baseline.elementIndex) as an offset from r12. Clobbers rax.
  effect fn elementEntry(self: &mut Self, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.codeInto(Reg.R9)
    run self.a.lea(Width.W64, Reg.R9, Mem.at(Reg.R9, u32.wrappingToI32(pc + 1)))
    run self.a.lea(Width.W64, Reg.R8, Mem.indexed(Reg.R9, Reg.Rax, Scale.Eight, 0))
    run self.a.aluImm(Alu.And, Width.W32, Reg.R8, baseline_env.ELEMENT_MASK)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R8, baseline_env.ELEMENT_SHIFT)
  }
  /// get.key (frame mode): an own plain data property under a Symbol key the site's element
  /// site cache entry names for the object's shape version is read inline, and so are, under
  /// an Int key, an element of a fast Array and an own plain data property the entry of the
  /// site, the version and the index names (js_baseline.indexEntry: a table kept in a shape).
  /// Anything else is the engine's read on the same cache (baseline_env.ELEMENT_OF), which
  /// leaves where user code would run (a getter, a proxy).
  effect fn getKey(self: &mut Self, function: &Function, inst: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    let done = run self.a.label()
    let slow = run self.a.label()
    let ints = run self.a.label()
    let sparse = run self.a.label()
    let probe = run self.a.label()
    let loaded = run self.a.label()
    run self.unlessTag(inst.a, layout.object(), slow)
    run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.b * SLOT_BYTES + layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
    run self.a.jcc(Cond.Equal, ints)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.tagOf(0 - 8)))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.load(Width.W64, Reg.Rsi, payloadOf(inst.a))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsi, u32.wrappingToI32(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, u32.wrappingToI32(fields.shapeVersion)))
    run self.elementEntry(inst.pc)
    run self.a.load(Width.W64, Reg.R10, payloadOf(inst.b))
    run self.a.jmp(probe)
    self.a.bind(ints)
    run self.arrayGuard(inst.a, sparse)
    run self.elementOf(regalloc.spilled(payloadOf(inst.b)), slow)
    run self.a.jmp(loaded)
    // Not a fast Array: r8 = the entry of the site, the version and the index, r10 = the
    // word such an entry holds for the index (js_baseline.indexWord). A negative index's
    // word is above any entry's.
    self.a.bind(sparse)
    run self.a.load(Width.W64, Reg.Rsi, payloadOf(inst.a))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsi, u32.wrappingToI32(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, u32.wrappingToI32(fields.shapeVersion)))
    run self.a.load(Width.W32, Reg.R10, payloadOf(inst.b))
    run self.codeInto(Reg.R9)
    run self.a.lea(Width.W64, Reg.R9, Mem.at(Reg.R9, u32.wrappingToI32(inst.pc + 1)))
    run self.a.lea(Width.W64, Reg.R8, Mem.indexed(Reg.R9, Reg.Rax, Scale.Eight, 0))
    run self.a.alu(Alu.Add, Width.W64, Reg.R8, Reg.R10)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R8, baseline_env.ELEMENT_MASK)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R8, baseline_env.ELEMENT_SHIFT)
    run self.a.lea(Width.W64, Reg.R10, Mem.indexed(Reg.R10, Reg.R10, Scale.One, 1))
    self.a.bind(probe)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.indexed(Reg.R12, Reg.R8, Scale.One, baseline_env.ELEMENTS_OFFSET + baseline_env.ELEMENT_SITE))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R10, Mem.indexed(Reg.R12, Reg.R8, Scale.One, baseline_env.ELEMENTS_OFFSET + baseline_env.ELEMENT_SYMBOL))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rax, 16)
    run self.a.aluLoad(Alu.Xor, Width.W64, Reg.Rax, Mem.indexed(Reg.R12, Reg.R8, Scale.One, baseline_env.ELEMENTS_OFFSET + baseline_env.ELEMENT_KEY))
    run self.a.aluImm(Alu.Cmp, Width.W64, Reg.Rax, 65535)
    run self.a.jcc(Cond.Above, slow)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rax, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rsi, u32.wrappingToI32(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.Rax)
    self.a.bind(loaded)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, 8))
    run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
    run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
    run self.retainBits(Reg.Rax, Reg.R9)
    let step = self.stepAt()
    let mut shape: u32 = 0
    if step != 0 {
      let after = self.depthAfter(&function, inst, step)
      shape = leaving.stepShape(after - 1, 1, 0, after)
    }
    run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: done, inst: inst, step: step, shape: shape, out: NONE, extra: 0, kind: STEP_GET_KEY_SLOW })
    self.a.bind(done)
  }
  /// put.key (frame mode): an Int key over an element of a fast Array as put.elem stores
  /// it, and a Symbol key the site's element site cache entry names for an own
  /// writable slot of the object's shape version, in an object without a [[Set]] of its own,
  /// is stored inline (the displaced value drops its count, never its last here). Anything
  /// else goes to the engine's store (baseline_env.STORE_ELEMENT), and what that declines is
  /// stepped on the frame, or leaves where the instruction cannot step.
  effect fn putKey(self: &mut Self, function: &Function, inst: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    let key = i32.wrappingToU32(inst.k)
    let done = run self.a.label()
    let slow = run self.a.label()
    let kept = run self.a.label()
    let symbolic = run self.a.label()
    let oldPlain = run self.a.label()
    let newPlain = run self.a.label()
    // An Int key: an element of a fast Array below its length, a value that is no heap
    // reference over one that is none (as put.elem stores it).
    run self.unlessTag(key, layout.int(), symbolic)
    run self.elementSlotAt(inst.a, regalloc.spilled(payloadOf(key)), slow)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
    run self.heapTest(Reg.Rax, oldPlain)
    run self.a.jmp(slow)
    self.a.bind(oldPlain)
    run self.a.load(Width.W64, Reg.Rax, slotOf(inst.b))
    run self.heapTest(Reg.Rax, newPlain)
    run self.a.jmp(slow)
    self.a.bind(newPlain)
    run self.a.load(Width.W64, Reg.R9, payloadOf(inst.b))
    run self.a.store(Width.W64, Mem.at(Reg.R11, 0), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.R11, 8), Reg.R9)
    run self.a.jmp(done)
    self.a.bind(symbolic)
    run self.unlessTag(inst.a, layout.object(), slow)
    run self.unlessTag(key, layout.tagOf(0 - 8), slow)
    run self.a.load(Width.W64, Reg.Rsi, payloadOf(inst.a))
    run self.a.test8MemImm(Mem.at(Reg.Rsi, u32.wrappingToI32(fields.objectFlags)), u32.wrappingToU8(fields.exotic))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsi, u32.wrappingToI32(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, u32.wrappingToI32(fields.shapeVersion)))
    run self.elementEntry(inst.pc)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.indexed(Reg.R12, Reg.R8, Scale.One, baseline_env.ELEMENTS_OFFSET + baseline_env.ELEMENT_SITE))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.load(Width.W64, Reg.R10, payloadOf(key))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R10, Mem.indexed(Reg.R12, Reg.R8, Scale.One, baseline_env.ELEMENTS_OFFSET + baseline_env.ELEMENT_SYMBOL))
    run self.a.jcc(Cond.NotEqual, slow)
    // The slot index is left, or more when the versions differ (0 when not writable).
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rax, 16)
    run self.a.aluLoad(Alu.Xor, Width.W64, Reg.Rax, Mem.indexed(Reg.R12, Reg.R8, Scale.One, baseline_env.ELEMENTS_OFFSET + baseline_env.ELEMENT_STORE))
    run self.a.aluImm(Alu.Cmp, Width.W64, Reg.Rax, 65535)
    run self.a.jcc(Cond.Above, slow)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rax, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rsi, u32.wrappingToI32(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
    run self.heapTest(Reg.Rax, kept)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, 8))
    run self.a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.R9, 0), 1)
    run self.a.jcc(Cond.LessOrEqual, slow)
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R9, 0), 1)
    self.a.bind(kept)
    run self.a.load(Width.W64, Reg.Rax, slotOf(inst.b))
    run self.a.load(Width.W64, Reg.R9, payloadOf(inst.b))
    run self.a.store(Width.W64, Mem.at(Reg.R11, 0), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.R11, 8), Reg.R9)
    run self.retainBits(Reg.Rax, Reg.R9)
    let step = self.stepAt()
    let mut shape: u32 = 0
    if step != 0 {
      let after = self.depthAfter(&function, inst, step)
      shape = leaving.stepShape(0, 0, 0, after)
    }
    run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: done, inst: inst, step: step, shape: shape, out: NONE, extra: 0, kind: STEP_PUT_KEY_SLOW })
    self.a.bind(done)
  }
  /// get.field past its helper, at a site that left before (frame mode, the function's own
  /// code): the function getter the read finds (baseline_env.GETTER, as baseline code asks
  /// for it) is called as a method of the object with no arguments, through the baseline
  /// call stub, in the call area's cells (the receiver lent, the getter with its count), and
  /// its result is the read's; then on to done. Where there is no such getter it falls
  /// through. A call the stub declines or that threw leaves at the read's exit, as a call
  /// does (the baseline code then reads, or the engine unwinds). Clobbers every register a
  /// call does.
  effect fn getterCall(self: &mut Self, function: &Function, inst: Inst, done: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let none = run self.a.label()
    let left = run self.a.label()
    let callee = self.callAt + SLOT_BYTES
    // getter(env, ip, object cell, out) -> 1 with the function in out.
    run self.codeInto(Reg.Rsi)
    run self.a.lea(Width.W64, Reg.Rsi, Mem.at(Reg.Rsi, u32.wrappingToI32(inst.pc + 1)))
    run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
    run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.a))
    run self.a.lea(Width.W64, Reg.Rcx, word(Reg.Rsp, callee))
    run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.GETTER)))
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, none)
    run self.valueInto(&function, inst.a, SlotMode.Imm, Reg.Rsp, callee - SLOT_BYTES)
    // The stub's site, as callOnFrame's: r14 the callee's cell, edx the count, eax the pc a
    // frame the callee publishes is at.
    run self.a.lea(Width.W64, Reg.R14, word(Reg.Rsp, callee))
    run self.a.movImm32(Reg.Rdx, 0)
    run self.a.movImm32(Reg.Rax, inst.pc + 1)
    run self.a.callSymbol(stubs.STUB_CALL_METHOD_KEEP)
    // ecx: 0 returned, HOW_DECLINED, HOW_CALL_THREW.
    run self.a.test(Width.W32, Reg.Rcx, Reg.Rcx)
    run self.a.jcc(Cond.NotEqual, left)
    run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
    run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rdx)
    run self.releaseAt(Reg.Rsp, u32.wrappingToI32(callee), true)
    run self.a.jmp(done)
    self.a.bind(left)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, self.scratch), Reg.Rcx)
    run self.releaseAt(Reg.Rsp, u32.wrappingToI32(callee), true)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.Rsp, self.scratch))
    run self.a.jmp(self.exitWith.get(u32.toUsize(inst.exit)))
    self.a.bind(none)
  }
  /// The store of a SITE_PUT_FIELD call past its helper (frame mode, the function's own
  /// code), as getterCall: the function setter the store finds (baseline_env.SETTER) is
  /// called as a method of the object with the value as its argument, and its result is
  /// dropped; then on to done. Falls through where there is no such setter.
  effect fn setterCall(self: &mut Self, function: &Function, inst: Inst, done: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let none = run self.a.label()
    let left = run self.a.label()
    let callee = self.callAt + SLOT_BYTES
    // setter(env, ip, object cell, out) -> 1 with the function in out.
    run self.codeInto(Reg.Rsi)
    run self.a.lea(Width.W64, Reg.Rsi, Mem.at(Reg.Rsi, u32.wrappingToI32(inst.pc + 1)))
    run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
    run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.a))
    run self.a.lea(Width.W64, Reg.Rcx, word(Reg.Rsp, callee))
    run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.SETTER)))
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, none)
    run self.valueInto(&function, inst.a, SlotMode.Imm, Reg.Rsp, callee - SLOT_BYTES)
    run self.valueInto(&function, inst.b, SlotMode.Imm, Reg.Rsp, callee + SLOT_BYTES)
    run self.a.lea(Width.W64, Reg.R14, word(Reg.Rsp, callee))
    run self.a.movImm32(Reg.Rdx, 1)
    run self.a.movImm32(Reg.Rax, inst.pc + 1)
    run self.a.callSymbol(stubs.STUB_CALL_METHOD_KEEP)
    run self.a.test(Width.W32, Reg.Rcx, Reg.Rcx)
    run self.a.jcc(Cond.NotEqual, left)
    // The setter's result goes.
    let scratch = self.scratch
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch + 8), Reg.Rdx)
    run self.releaseAt(Reg.Rsp, scratch, false)
    run self.releaseAt(Reg.Rsp, u32.wrappingToI32(callee), true)
    run self.a.jmp(done)
    self.a.bind(left)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, self.scratch), Reg.Rcx)
    run self.releaseAt(Reg.Rsp, u32.wrappingToI32(callee), true)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.Rsp, self.scratch))
    run self.a.jmp(self.exitWith.get(u32.toUsize(inst.exit)))
    self.a.bind(none)
  }
  /// Whether the `count` instructions before the one being lowered are its call.args, in
  /// order.
  fn operandsOf(self: &Self, function: &Function, count: u32) -> bool {
    if self.cursor < count { return false }
    let mut i: u32 = 0
    while i < count {
      let arg = function.inst(self.cursor - count + i)
      if arg.op != Op.CallArg || arg.k != u32.wrappingToI32(i) { return false }
      i = i + 1
    }
    return true
  }
  /// The step entry of the instruction being lowered (Emitter.steps), or 0.
  fn stepAt(self: &Self) -> u32 { if u32.toUsize(self.cursor) < self.steps.length() { return self.steps.get(u32.toUsize(self.cursor)) } return 0 }
  /// The operands on the stack after the step `step` of inst's bytecode instruction.
  fn depthAfter(self: &Self, function: &Function, inst: Inst, step: u32) -> u32 {
    return i32.wrappingToU32(u32.wrappingToI32(function.exit(inst.exit).stackDepth) + u32.wrappingToI32(u32.shiftRight(step, 16) & 255) - 128)
  }
  /// Schedules a deferred slow path in the cold section (`stepSlows`).
  effect fn deferStep(self: &mut Self, inst: Inst, step: u32, shape: u32, out: u32, back: Label, kind: u8) -> Label ! OutOfMemoryError ? &mut Allocator {
    let entry = run self.a.label()
    run self.stepSlows.append(StepSlow { entry: entry, auxLabel: entry, back: back, inst: inst, step: step, shape: shape, out: out, extra: 0, kind: kind })
    return entry
  }
  /// Tries `SERVICE_QUICK` for `OP_put_field` (allocating stores, new shapes, Array.length):
  /// copies object (`inst.a`) and value (`inst.b`) into scratch slots with counts of their own;
  /// on 0 both counts were consumed and control jumps to `stored`; on 2 both counts are
  /// dropped (the slots still hold theirs) and control falls through to `stepOnFrame`.
  effect fn putFieldQuick(self: &mut Self, inst: Inst, stored: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let scratch = self.scratch
    run self.a.load(Width.W64, Reg.Rax, slotOf(inst.a))
    run self.a.load(Width.W64, Reg.Rdx, payloadOf(inst.a))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch + 8), Reg.Rdx)
    run self.retainBits(Reg.Rax, Reg.Rdx)
    run self.a.load(Width.W64, Reg.Rax, slotOf(inst.b))
    run self.a.load(Width.W64, Reg.Rdx, payloadOf(inst.b))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch + 16), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch + 24), Reg.Rdx)
    run self.retainBits(Reg.Rax, Reg.Rdx)
    run self.a.movImm32(Reg.Rcx, u32.bitOr(u64.wrappingToU32(frames.SERVICE_QUICK), u32.shiftLeft(inst.pc, 8)))
    run self.a.lea(Width.W64, Reg.R8, Mem.at(Reg.Rsp, scratch + 32))
    run self.a.movImm32(Reg.R9, 0)
    run self.keepXmm()
    run self.engineCall()
    run self.restoreXmm()
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, stored)
    let skipA = run self.a.label()
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsp, scratch))
    run self.heapTest(Reg.Rax, skipA)
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rsp, scratch + 8))
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rdx, 0), 1)
    self.a.bind(skipA)
    let skipB = run self.a.label()
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsp, scratch + 16))
    run self.heapTest(Reg.Rax, skipB)
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rsp, scratch + 24))
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rdx, 0), 1)
    self.a.bind(skipB)
  }
  /// Tries `SERVICE_QUICK` for `OP_put_array_el` (the element an Array gains past its
  /// length's room or above a gap): object (`inst.a`), key (`inst.k`) and value (`inst.b`)
  /// go to the three scratch slots as the instruction's operand cells, object and value
  /// with counts of their own (the key is an Int where the engine takes it). On 0 both
  /// counts were consumed and control jumps to `stored`; on 2 both are dropped (the slots
  /// still hold theirs) and control falls through to `stepOnFrame`. No double is in a
  /// register over a put.key (x64_regalloc.callsOut).
  effect fn putKeyQuick(self: &mut Self, inst: Inst, stored: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let scratch = self.scratch
    let key = i32.wrappingToU32(inst.k)
    run self.a.load(Width.W64, Reg.Rax, slotOf(inst.a))
    run self.a.load(Width.W64, Reg.Rdx, payloadOf(inst.a))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch + 8), Reg.Rdx)
    run self.retainBits(Reg.Rax, Reg.Rdx)
    run self.a.load(Width.W64, Reg.Rax, slotOf(key))
    run self.a.load(Width.W64, Reg.Rdx, payloadOf(key))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch + 16), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch + 24), Reg.Rdx)
    run self.a.load(Width.W64, Reg.Rax, slotOf(inst.b))
    run self.a.load(Width.W64, Reg.Rdx, payloadOf(inst.b))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch + 32), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, scratch + 40), Reg.Rdx)
    run self.retainBits(Reg.Rax, Reg.Rdx)
    run self.a.movImm32(Reg.Rcx, u32.bitOr(u64.wrappingToU32(frames.SERVICE_QUICK), u32.shiftLeft(inst.pc, 8)))
    run self.a.lea(Width.W64, Reg.R8, Mem.at(Reg.Rsp, scratch + 48))
    run self.a.movImm32(Reg.R9, 0)
    run self.engineCall()
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, stored)
    let skipA = run self.a.label()
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsp, scratch))
    run self.heapTest(Reg.Rax, skipA)
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rsp, scratch + 8))
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rdx, 0), 1)
    self.a.bind(skipA)
    let skipB = run self.a.label()
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsp, scratch + 32))
    run self.heapTest(Reg.Rax, skipB)
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rsp, scratch + 40))
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rdx, 0), 1)
    self.a.bind(skipB)
  }
  /// Emits one deferred cold slow path after `markCold()`.
  effect fn emitStepSlow(self: &mut Self, function: &Function, item: StepSlow) -> () ! OutOfMemoryError ? &mut Allocator {
    let inst = item.inst
    self.frameOf = inst.frame
    if item.kind == STEP_ELEM_SLOW {
      let borrowed = item.extra != 0
      let only = item.out
      let mut index = inst.b
      if inst.op == Op.PutElem { index = i32.wrappingToU32(inst.k) }
      if only == 0 {
        self.a.bind(item.auxLabel)
        run self.typedElement(inst.op == Op.PutElem, inst.a, index, inst.b, inst.result, 0, item.back, item.entry)
      }
      self.a.bind(item.entry)
      run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
      if inst.op == Op.GetElem {
        let idx = self.at(inst.b) run getI32(&mut self.a, Reg.Rdx, idx)
        run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
        run self.keepXmm()
        if borrowed { run self.callHelper(helpers.GET_ELEM_BORROWED) } else { run self.callHelper(helpers.GET_ELEM) }
        run self.restoreXmm()
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        if item.step != 0 && !borrowed {
          run self.a.jcc(Cond.NotEqual, item.back)
          run self.stepOnFrame(&function, inst, item.step, item.shape, inst.result)
          run self.a.jmp(item.back)
        } else {
          run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
          run self.a.jmp(item.back)
        }
      } else {
        let idx = self.at(i32.wrappingToU32(inst.k)) run getI32(&mut self.a, Reg.Rdx, idx)
        run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.b))
        run self.keepXmm()
        run self.callHelper(helpers.PUT_ELEM)
        run self.restoreXmm()
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(item.back)
      }
      return ()
    }
    self.a.bind(item.entry)
    if item.kind == STEP_TRUTHY_SLOW {
      let layout = self.settings.layout
      let symbol = layout.tagOf(-8)
      let heap = run self.a.label()
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(symbol))
      run self.a.jcc(Cond.NotEqual, heap)
      run self.a.movImm32(Reg.R9, 1)
      run self.a.jmp(item.back)
      self.a.bind(heap)
      run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
      run self.callHelper(helpers.TRUTHY)
      run self.a.mov(Width.W32, Reg.R9, Reg.Rax)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == STEP_PUT_FIELD_SLOW {
      run self.coldFrameInto(Reg.Rsi, inst.frame, item.out)
      if inst.k == 0 { run self.a.movImm32(Reg.Rdx, inst.pc) }
      else { run self.a.movImm64(Reg.Rdx, u64.bitOr(u32.toU64(inst.pc), helpers.PUT_FIELD_RELEASE_LAST)) }
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.R8, slotOf(inst.b))
      run self.keepXmm()
      run self.callHelper(helpers.PUT_FIELD)
      run self.restoreXmm()
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 1)
      if item.step != 0 {
        run self.a.jcc(Cond.Equal, item.back)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(objects.WRITE_NEEDS_ROOM))
        run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
        if (item.step & STEP_QUICK) != 0 { run self.putFieldQuick(inst, item.back) }
        run self.stepOnFrame(&function, inst, item.step, item.shape, NONE)
        run self.a.jmp(item.back)
      } else {
        run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(item.back)
      }
      return ()
    }
    if item.kind == STEP_SITE_PUT_FIELD {
      run self.ownFrame(Reg.Rsi)
      run self.a.movImm32(Reg.Rdx, inst.pc)
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.R8, slotOf(inst.b))
      run self.callHelper(helpers.PUT_FIELD)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 1)
      if item.step != 0 {
        run self.a.jcc(Cond.Equal, item.back)
        if inst.frame == 0 { run self.setterCall(&function, inst, item.back) }
        if (item.step & STEP_QUICK) != 0 { run self.putFieldQuick(inst, item.back) }
        run self.stepOnFrame(&function, inst, item.step, item.shape, NONE)
        run self.a.jmp(item.back)
      } else {
        run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(item.back)
      }
      return ()
    }
    if item.kind == STEP_GET_FIELD_SLOW {
      let how = item.extra & 1
      let borrowed = (item.extra & 2) != 0
      run self.coldFrameInto(Reg.Rsi, inst.frame, item.out)
      let mut site = u32.bitOr(inst.pc, u32.shiftLeft(how, 31))
      if borrowed { site = u32.bitOr(site, 0x40000000) }
      run self.a.movImm32(Reg.Rdx, site)
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.R8, slotOf(inst.result))
      run self.keepXmm()
      run self.callHelper(helpers.GET_FIELD)
      run self.restoreXmm()
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      if item.step != 0 && !borrowed {
        run self.a.jcc(Cond.NotEqual, item.back)
        if self.on && inst.frame == 0 { run self.getterCall(&function, inst, item.back) }
        run self.stepOnFrame(&function, inst, item.step, item.shape, inst.result)
        run self.a.jmp(item.back)
      } else {
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(item.back)
      }
      return ()
    }
    if item.kind == STEP_GET_KEY_SLOW {
      // element_of(env, object, key, out, ip).
      run self.codeInto(Reg.R8)
      run self.a.lea(Width.W64, Reg.R8, Mem.at(Reg.R8, u32.wrappingToI32(inst.pc + 1)))
      run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
      run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.b))
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
      run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.ELEMENT_OF)))
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      if item.step != 0 {
        run self.a.jcc(Cond.NotEqual, item.back)
        run self.stepOnFrame(&function, inst, item.step, item.shape, inst.result)
        run self.a.jmp(item.back)
      } else {
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(item.back)
      }
      return ()
    }
    if item.kind == STEP_PUT_KEY_SLOW {
      // store_element(env, object, key, value, ip).
      let key = i32.wrappingToU32(inst.k)
      run self.codeInto(Reg.R8)
      run self.a.lea(Width.W64, Reg.R8, Mem.at(Reg.R8, u32.wrappingToI32(inst.pc + 1)))
      run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
      run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(key))
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.b))
      run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.STORE_ELEMENT)))
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      if item.step != 0 {
        run self.a.jcc(Cond.NotEqual, item.back)
        if (item.step & STEP_QUICK) != 0 { run self.putKeyQuick(inst, item.back) }
        run self.stepOnFrame(&function, inst, item.step, item.shape, NONE)
        run self.a.jmp(item.back)
      } else {
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(item.back)
      }
      return ()
    }
    if item.kind == STEP_GET_LENGTH_SLOW {
      // A flat string's length is read here (the low 31 bits of its length word), as
      // baseline code reads it.
      let layout = self.settings.layout
      let notFlat = run self.a.label()
      run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.tagOf(-7)))
      run self.a.jcc(Cond.NotEqual, notFlat)
      run self.a.load(Width.W64, Reg.R11, payloadOf(inst.a))
      run self.a.load(Width.W32, Reg.R9, Mem.at(Reg.R11, signed(self.plan.f.stringLength)))
      run self.a.aluImm(Alu.And, Width.W32, Reg.R9, 0x7fffffff)
      run self.a.movImm64(Reg.Rax, layout.tagWord(layout.int()))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      run self.a.jmp(item.back)
      self.a.bind(notFlat)
      // length(env, source, out): owned; a borrowed result gives its count back.
      let borrowed = item.extra != 0
      run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
      run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.result))
      run self.keepXmm()
      run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.LENGTH)))
      run self.restoreXmm()
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      if item.step != 0 {
        let ok = run self.a.label()
        run self.a.jcc(Cond.NotEqual, ok)
        run self.stepOnFrame(&function, inst, item.step, item.shape, inst.result)
        run self.a.jmp(item.back)
        self.a.bind(ok)
      } else {
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      }
      if borrowed {
        run self.a.load(Width.W64, Reg.Rax, slotOf(inst.result))
        run self.heapTest(Reg.Rax, item.back)
        run self.a.load(Width.W64, Reg.Rdx, payloadOf(inst.result))
        run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rdx, 0), 1)
      }
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == STEP_MATH_SLOW {
      let base = if item.extra == 0 { Reg.Rbp } else { Reg.Rsp }
      let callee = u32.wrappingToI32(item.shape)
      let count = calls.countOf(inst)
      let layout = self.settings.layout
      let math = self.math
      if math.fnTagAt != u32.MAX && math.familyAt != u32.MAX && math.methodAt != u32.MAX && (count == 1 || count == 2) {
        let slowMath = run self.a.label()
        run self.a.load(Width.W64, Reg.R9, Mem.at(base, callee + 8))
        run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R9, signed(math.methodAt)))
        if count == 1 {
          let doSqrt = run self.a.label()
          let sqrtNotF64 = run self.a.label()
          let sqrtRun = run self.a.label()
          let doAbs = run self.a.label()
          let absNotF64 = run self.a.label()
          let doFloor = run self.a.label()
          let floorNotInt = run self.a.label()
          let floorExact = run self.a.label()
          let storeInt = run self.a.label()
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 6)
          run self.a.jcc(Cond.Equal, doSqrt)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
          run self.a.jcc(Cond.Equal, doAbs)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 3)
          run self.a.jcc(Cond.Equal, doFloor)
          run self.a.jmp(slowMath)
          // Math.sqrt(x): sqrtsd handles -0, NaN, +/-Infinity, and negatives per IEEE-754.
          self.a.bind(doSqrt)
          run self.loadTag(Reg.R8, Mem.at(base, callee + 16 + signed(layout.tagOffset)))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
          run self.a.jcc(Cond.NotEqual, sqrtNotF64)
          run self.a.loadDouble(Xmm.Xmm0, Mem.at(base, callee + 24))
          run self.a.jmp(sqrtRun)
          self.a.bind(sqrtNotF64)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
          run self.a.jcc(Cond.NotEqual, slowMath)
          run self.a.load(Width.W32, Reg.Rax, Mem.at(base, callee + 24))
          run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
          self.a.bind(sqrtRun)
          run self.a.scalar(ScalarOp.Sqrt, Xmm.Xmm0, Xmm.Xmm0)
          run self.a.movImm64(Reg.R8, layout.tagWord(layout.float64()))
          run self.a.store(Width.W64, slotOf(inst.result), Reg.R8)
          run self.a.storeDouble(payloadOf(inst.result), Xmm.Xmm0)
          run self.a.jmp(item.back)
          // Math.abs(x): clear sign bit for Float64 (handles -0, -NaN, -Inf); negate Int32 unless INT32_MIN.
          self.a.bind(doAbs)
          run self.loadTag(Reg.R8, Mem.at(base, callee + 16 + signed(layout.tagOffset)))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
          run self.a.jcc(Cond.NotEqual, absNotF64)
          run self.a.load(Width.W64, Reg.Rax, Mem.at(base, callee + 24))
          run self.a.movImm64(Reg.R11, 0x7fffffffffffffff)
          run self.a.alu(Alu.And, Width.W64, Reg.Rax, Reg.R11)
          run self.boxDoubleInto(Reg.Rax, Reg.Rsp, inst.result * SLOT_BYTES)
          run self.a.jmp(item.back)
          self.a.bind(absNotF64)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
          run self.a.jcc(Cond.NotEqual, slowMath)
          run self.a.load(Width.W32, Reg.Rax, Mem.at(base, callee + 24))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(0x80000000))
          run self.a.jcc(Cond.Equal, slowMath)
          run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
          run self.a.jcc(Cond.GreaterOrEqual, storeInt)
          run self.a.unary(Unary.Neg, Width.W32, Reg.Rax)
          run self.a.jmp(storeInt)
          // Math.floor(x): Int32 stays Int32; finite Float64 in (-2^31, 2^31) truncates and steps down on negative fraction, falling back to slowMath on -0 / NaN / Inf / large values.
          self.a.bind(doFloor)
          run self.loadTag(Reg.R8, Mem.at(base, callee + 16 + signed(layout.tagOffset)))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
          run self.a.jcc(Cond.NotEqual, floorNotInt)
          run self.a.load(Width.W32, Reg.Rax, Mem.at(base, callee + 24))
          run self.a.jmp(storeInt)
          self.a.bind(floorNotInt)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
          run self.a.jcc(Cond.NotEqual, slowMath)
          run self.a.loadDouble(Xmm.Xmm0, Mem.at(base, callee + 24))
          run self.a.doubleToInt(Width.W32, Reg.Rax, Xmm.Xmm0)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(0x80000000))
          run self.a.jcc(Cond.Equal, slowMath)
          run self.a.intToDouble(Width.W32, Xmm.Xmm1, Reg.Rax)
          run self.a.packed(PackedOp.Ucomisd, Xmm.Xmm1, Xmm.Xmm0)
          run self.a.jcc(Cond.BelowOrEqual, floorExact)
          run self.a.aluImm(Alu.Sub, Width.W32, Reg.Rax, 1)
          run self.a.jmp(storeInt)
          self.a.bind(floorExact)
          run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
          run self.a.jcc(Cond.NotEqual, storeInt)
          run self.a.load(Width.W64, Reg.R9, Mem.at(base, callee + 24))
          run self.a.test(Width.W64, Reg.R9, Reg.R9)
          run self.a.jcc(Cond.Sign, slowMath)
          self.a.bind(storeInt)
          run self.boxInto(false, Reg.Rax, Reg.Rsp, inst.result * SLOT_BYTES)
          run self.a.jmp(item.back)
        } else {
          // Math.min (0) / Math.max (1) on two Numbers; NaN or equal (including +/-0) falls back to slowMath.
          let a0NotF64 = run self.a.label()
          let a0Done = run self.a.label()
          let a1NotF64 = run self.a.label()
          let a1Done = run self.a.label()
          let isLess = run self.a.label()
          let storeXmm1 = run self.a.label()
          let storeXmm0 = run self.a.label()
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 1)
          run self.a.jcc(Cond.Above, slowMath)
          run self.loadTag(Reg.R8, Mem.at(base, callee + 16 + signed(layout.tagOffset)))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
          run self.a.jcc(Cond.NotEqual, a0NotF64)
          run self.a.loadDouble(Xmm.Xmm0, Mem.at(base, callee + 24))
          run self.a.jmp(a0Done)
          self.a.bind(a0NotF64)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
          run self.a.jcc(Cond.NotEqual, slowMath)
          run self.a.load(Width.W32, Reg.R9, Mem.at(base, callee + 24))
          run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.R9)
          self.a.bind(a0Done)
          run self.loadTag(Reg.R8, Mem.at(base, callee + 32 + signed(layout.tagOffset)))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
          run self.a.jcc(Cond.NotEqual, a1NotF64)
          run self.a.loadDouble(Xmm.Xmm1, Mem.at(base, callee + 40))
          run self.a.jmp(a1Done)
          self.a.bind(a1NotF64)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
          run self.a.jcc(Cond.NotEqual, slowMath)
          run self.a.load(Width.W32, Reg.R9, Mem.at(base, callee + 40))
          run self.a.intToDouble(Width.W32, Xmm.Xmm1, Reg.R9)
          self.a.bind(a1Done)
          run self.a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1)
          run self.a.jcc(Cond.Parity, slowMath)
          run self.a.jcc(Cond.Equal, slowMath)
          run self.a.jcc(Cond.Below, isLess)
          run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
          run self.a.jcc(Cond.NotEqual, storeXmm0)
          run self.a.jmp(storeXmm1)
          self.a.bind(isLess)
          run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
          run self.a.jcc(Cond.Equal, storeXmm0)
          self.a.bind(storeXmm1)
          run self.a.load(Width.W64, Reg.R8, Mem.at(base, callee + 32))
          run self.a.load(Width.W64, Reg.R9, Mem.at(base, callee + 40))
          run self.a.store(Width.W64, slotOf(inst.result), Reg.R8)
          run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
          run self.a.jmp(item.back)
          self.a.bind(storeXmm0)
          run self.a.load(Width.W64, Reg.R8, Mem.at(base, callee + 16))
          run self.a.load(Width.W64, Reg.R9, Mem.at(base, callee + 24))
          run self.a.store(Width.W64, slotOf(inst.result), Reg.R8)
          run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
          run self.a.jmp(item.back)
        }
        self.a.bind(slowMath)
      }
      run self.a.lea(Width.W64, Reg.Rsi, Mem.at(base, callee))
      run self.a.movImm32(Reg.Rdx, count)
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
      run self.callHelper(helpers.MATH_FRAME)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, item.back)
      run self.a.jmp(item.auxLabel)
      return ()
    }
    if item.kind == STEP_UNIT_SLOW {
      let base = if item.extra == 0 { Reg.Rbp } else { Reg.Rsp }
      let callee = u32.wrappingToI32(item.shape)
      run self.a.lea(Width.W64, Reg.Rsi, Mem.at(base, callee - 16))
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.result))
      run self.callHelper(helpers.STRING_UNIT)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, item.back)
      run self.a.jmp(item.auxLabel)
      return ()
    }
    if item.kind == STEP_EQUALS_SLOW {
      let strict = (item.extra & 1) != 0
      let fused = (item.extra & 2) != 0
      let siteEqual = (item.extra & 4) != 0
      let directHelper = (item.extra & 8) != 0
      let layout = self.settings.layout
      let fields = self.fields
      let helper = run self.a.label()
      let answered = run self.a.label()
      if !directHelper {
        let unlike = run self.a.label()
        let other = run self.a.label()
        let neither = run self.a.label()
        let payloads = run self.a.label()
        let yes = run self.a.label()
        let no = run self.a.label()
        // Left is object (right is not object, since (obj, obj) was handled in the hot path).
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.object()))
        run self.a.jcc(Cond.NotEqual, unlike)
        run self.a.load(Width.W64, Reg.R11, payloadOf(inst.a))
        run self.a.jmp(other)
        // Left is not object; check whether right is object.
        self.a.bind(unlike)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
        run self.a.jcc(Cond.NotEqual, neither)
        run self.a.load(Width.W64, Reg.R11, payloadOf(inst.b))
        run self.a.mov(Width.W32, Reg.R8, Reg.Rax)
        // An object in R11 and the tag of what is none in R8.
        self.a.bind(other)
        if strict { run self.a.jmp(no) }
        else {
          let nullish = run self.a.label()
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.null()))
          run self.a.jcc(Cond.Equal, nullish)
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.undefined()))
          run self.a.jcc(Cond.NotEqual, helper)
          self.a.bind(nullish)
          run self.a.test8MemImm(Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)), u32.wrappingToU8(fields.falsy))
          run self.a.jcc(Cond.NotEqual, helper)
          run self.a.jmp(no)
        }
        // Neither is an object (and not both int32): same tag handles bool, null, undefined.
        self.a.bind(neither)
        run self.a.alu(Alu.Cmp, Width.W32, Reg.Rax, Reg.R8)
        run self.a.jcc(Cond.NotEqual, helper)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.boolean()))
        run self.a.jcc(Cond.Equal, payloads)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.null()))
        run self.a.jcc(Cond.Equal, yes)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(layout.undefined()))
        run self.a.jcc(Cond.NotEqual, helper)
        self.a.bind(yes)
        run self.a.movImm32(Reg.Rax, 1)
        run self.a.jmp(answered)
        self.a.bind(payloads)
        run self.a.load(Width.W32, Reg.R11, payloadOf(inst.a))
        run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.R11, payloadOf(inst.b))
        run self.a.jcc(Cond.Equal, yes)
        self.a.bind(no)
        run self.a.movImm32(Reg.Rax, 0)
        run self.a.jmp(answered)
      }
      self.a.bind(helper)
      run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.b))
      let strictFlag: u32 = if strict { 1 } else { 0 }
      run self.a.movImm32(Reg.Rcx, strictFlag)
      run self.callHelper(helpers.EQUALS)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
      if siteEqual && item.step != 0 {
        let ok = run self.a.label()
        run self.a.jcc(Cond.NotEqual, ok)
        run self.stepOnFrame(&function, inst, item.step, item.shape, inst.result)
        run self.a.jmp(item.auxLabel)
        self.a.bind(ok)
      } else {
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      }
      self.a.bind(answered)
      if fused { run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 1) }
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == STEP_HELPER_SLOW {
      let op = inst.op
      if op == Op.TypeofAtom {
        run self.ownFrame(Reg.Rsi)
        run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.a))
        run self.callHelper(helpers.TYPEOF)
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(item.back)
        return ()
      }
      if op == Op.Typeof {
        run self.ownFrame(Reg.Rsi)
        run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.a))
        run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
        run self.callHelper(helpers.TYPEOF_STR)
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(item.back)
        return ()
      }
      if op == Op.InstanceOf {
        run self.ownFrame(Reg.Rsi)
        run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.a))
        run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.b))
        run self.callHelper(helpers.INSTANCEOF)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.Rax)
        run self.a.jmp(item.back)
        return ()
      }
      if op == Op.GetScope || op == Op.PutScope {
        run self.coldFrameInto(Reg.Rsi, inst.frame, item.out)
        run self.a.movImm32(Reg.Rdx, item.extra)
        if op == Op.GetScope {
          run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
          run self.keepXmm()
          run self.callHelper(helpers.GET_SCOPE)
          run self.restoreXmm()
        } else {
          run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.a))
          run self.callHelper(helpers.PUT_SCOPE)
        }
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(item.back)
        return ()
      }
      if op == Op.GetVar || op == Op.PutVar {
        run self.coldFrameInto(Reg.Rsi, inst.frame, item.out)
        run self.a.movImm32(Reg.Rdx, item.extra)
        if op == Op.GetVar {
          run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
          run self.keepXmm()
          run self.callHelper(helpers.GET_VAR)
          run self.restoreXmm()
        } else {
          run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.a))
          run self.callHelper(helpers.PUT_VAR)
        }
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
        run self.a.jmp(item.back)
        return ()
      }
      // Op.AtomValue fallback.
      run self.coldFrameInto(Reg.Rsi, inst.frame, item.out)
      run self.a.movImm32(Reg.Rdx, item.extra)
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
      run self.callHelper(helpers.ATOM_VALUE)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == STEP_ADD_SLOW {
      let p = self.plan
      let declined = run self.a.label()
      run self.a.cmp8Imm(Reg.Rax, 1)
      run self.a.jcc(Cond.NotEqual, declined)
      run self.a.movImm32(Reg.R8, leaving.HOW_CALL_THREW)
      run self.a.jmp(self.exitWith.get(u32.toUsize(inst.exit)))
      self.a.bind(declined)
      run self.a.load(Width.W64, Reg.Rax, p.rec(p.f.result))
      run self.a.load(Width.W64, Reg.Rdx, p.rec(p.f.result + 8))
      let skip = run self.a.label()
      run self.heapTest(Reg.Rax, skip)
      run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rdx, 0), 1)
      self.a.bind(skip)
      if item.step != 0 {
        run self.stepOnFrame(&function, inst, item.step, item.shape, inst.result)
        run self.a.jmp(item.back)
      } else {
        run self.a.jmp(self.exitLabels.get(u32.toUsize(inst.exit)))
      }
      return ()
    }
    if item.kind == STEP_GENERIC_DECLINED {
      let p = self.plan
      let base = item.extra
      let count = calls.countOf(inst)
      let mut i: u32 = 0
      while i < count { run self.releaseCell(p.operandAt(base + i)) i = i + 1 }
      run self.stepOnFrame(&function, inst, item.step, item.shape, item.out)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == STEP_CONSTRUCT_THREW {
      let baseReg = if item.extra == 0 { Reg.Rbp } else { Reg.Rsp }
      let firstAt = u32.wrappingToI32(item.shape)
      let count = calls.countOf(inst)
      let mut k: u32 = 0
      while k < count { run self.releaseAt(baseReg, firstAt + u32.wrappingToI32(k * SLOT_BYTES), false) k = k + 1 }
      run self.a.movImm32(Reg.R8, leaving.HOW_CALL_THREW)
      run self.a.jmp(self.exitWith.get(u32.toUsize(inst.exit)))
      return ()
    }
    if item.kind == STEP_ARRAY_SLOW {
      let p = self.plan
      let base = if (item.extra & 1) == 0 { Reg.Rbp } else { Reg.Rsp }
      let tryHelper = (item.extra & 2) != 0
      let native = u32.wrappingToI32(item.out)
      let callee = u32.wrappingToI32(item.shape)
      let pc = item.step
      if tryHelper {
        run self.a.lea(Width.W64, Reg.Rsi, Mem.at(base, callee - 16))
        if calls.isPop(native) {
          run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.result))
          run self.callHelper(helpers.ARRAY_POP)
        } else {
          run self.a.lea(Width.W64, Reg.Rdx, Mem.at(base, callee + 16))
          run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
          run self.callHelper(helpers.ARRAY_PUSH)
        }
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.NotEqual, item.back)
      }
      let mut request = frames.SERVICE_ARRAY
      if calls.isPop(native) { request = u64.bitOr(frames.SERVICE_ARRAY, frames.ARRAY_POP) }
      run self.a.storeImm(Width.W64, p.sf(p.f.currentPc), u32.wrappingToI32(pc))
      run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(request))
      run self.a.lea(Width.W64, Reg.R8, Mem.at(base, callee))
      run self.a.movImm32(Reg.R9, calls.countOf(inst))
      run self.engineCall()
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, item.auxLabel)
      run self.a.load(Width.W64, Reg.Rax, p.rec(p.f.result))
      run self.a.load(Width.W64, Reg.Rdx, p.rec(p.f.result + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rdx)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == STEP_GETTER {
      run self.getterCall(&function, inst, item.back)
    } else if item.kind == STEP_SETTER || item.kind == STEP_SETTER_QUICK {
      if inst.frame == 0 { run self.setterCall(&function, inst, item.back) }
      if item.kind == STEP_SETTER_QUICK { run self.putFieldQuick(inst, item.back) }
    }
    run self.stepOnFrame(&function, inst, item.step, item.shape, item.out)
    run self.a.jmp(item.back)
  }
  /// Frame mode: the interpreter runs the bytecode instruction of inst on the frame and the
  /// code goes on after it. The state of inst's exit goes into the frame's cells, each value
  /// with a count of the cells' own (HOW_STEP); the baseline step stub runs the instruction;
  /// then the cells give back what the step left (HOW_STEPPED, with its shape) and the
  /// instruction's first value goes to the slot of `out` (NONE: nowhere). A step that ended
  /// the activation, or moved the frame to a handler of its own, leaves for the baseline
  /// code's tail (SYMBOL_STEP_ENDED) once the code's own counts are dropped (HOW_STEP_LEFT).
  effect fn stepOnFrame(self: &mut Self, function: &Function, inst: Inst, step: u32, shape: u32, out: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let p = self.plan
    let record = self.records.get(u32.toUsize(inst.exit))
    let before = function.exit(inst.exit).stackDepth
    let after = self.depthAfter(&function, inst, step)
    let went = run self.a.label()
    // The registers an exit's record may name, where the helper reads them. Keep DUMP_BYTES
    // live across STUB_STEP so allocated XMM registers are both dumped for FRAME_EXIT and
    // restored on return.
    run self.a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, state.DUMP_BYTES)
    let mut r: usize = 0
    while r < gprCount() {
      if self.saves(r) { run self.a.store(Width.W64, Mem.at(Reg.Rsp, usize.toI32(r) * 8), self.places.pool.registers[r]) }
      r = r + 1
    }
    if self.usedXmm != 0 {
      let mut d: u32 = 0
      while d < state.DUMP_DOUBLES {
        if u32.bitAnd(u32.shiftRight(self.usedXmm, d), 1) != 0 {
          run self.a.storeDouble(Mem.at(Reg.Rsp, u32.wrappingToI32((state.DUMP_INTEGERS + d) * 8)), regalloc.xmmAt(u32.toUsize(d)))
        }
        d = d + 1
      }
    }
    run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
    run self.a.lea(Width.W64, Reg.Rsi, p.rec(0))
    run self.a.lea(Width.W64, Reg.Rdx, Mem.at(Reg.Rsp, state.DUMP_BYTES))
    run self.a.leaLabel(Reg.Rcx, record)
    run self.a.mov(Width.W64, Reg.R8, Reg.Rsp)
    run self.a.movImm32(Reg.R9, leaving.HOW_STEP)
    run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.FRAME_EXIT)))
    run self.a.movImm32(Reg.Rax, inst.pc)
    run self.a.movImm32(Reg.Rcx, u32.bitOr(u64.wrappingToU32(frames.SERVICE_STEP), u32.shiftLeft(inst.pc + (step & 65535), 8)))
    run self.a.movImm32(Reg.Rdx, u32.bitOr(after, u32.shiftLeft(before, 16)))
    run self.a.callSymbol(stubs.STUB_STEP)
    run self.a.jcc(Cond.Equal, went)
    // It left: the answer goes to the baseline code's tail, on the baseline frame.
    run self.a.mov(Width.W64, Reg.Rbx, Reg.Rax)
    run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
    run self.a.lea(Width.W64, Reg.Rsi, p.rec(0))
    run self.a.lea(Width.W64, Reg.Rdx, Mem.at(Reg.Rsp, state.DUMP_BYTES))
    run self.a.leaLabel(Reg.Rcx, record)
    run self.a.movImm32(Reg.R8, 0)
    run self.a.movImm32(Reg.R9, leaving.HOW_STEP_LEFT)
    run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.FRAME_EXIT)))
    run self.a.mov(Width.W64, Reg.Rax, Reg.Rbx)
    run self.a.lea(Width.W64, Reg.Rbx, Mem.at(Reg.Rbp, p.localAt(0) + 128))
    run self.a.lea(Width.W64, Reg.Rsp, Mem.at(Reg.Rbp, 0 - p.below))
    run self.a.jmpSymbol(SYMBOL_STEP_ENDED)
    self.a.bind(went)
    run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
    run self.a.lea(Width.W64, Reg.Rsi, p.rec(0))
    if out == NONE { run self.a.movImm32(Reg.Rdx, 0) } else { run self.a.lea(Width.W64, Reg.Rdx, Mem.at(Reg.Rsp, state.DUMP_BYTES + u32.wrappingToI32(out * SLOT_BYTES))) }
    run self.a.leaLabel(Reg.Rcx, record)
    run self.a.movImm32(Reg.R8, shape)
    run self.a.movImm32(Reg.R9, leaving.HOW_STEPPED)
    run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.FRAME_EXIT)))
    if self.usedXmm != 0 {
      let mut d: u32 = 0
      while d < state.DUMP_DOUBLES {
        if u32.bitAnd(u32.shiftRight(self.usedXmm, d), 1) != 0 {
          run self.a.loadDouble(regalloc.xmmAt(u32.toUsize(d)), Mem.at(Reg.Rsp, u32.wrappingToI32((state.DUMP_INTEGERS + d) * 8)))
        }
        d = d + 1
      }
    }
    run self.a.aluImm(Alu.Add, Width.W64, Reg.Rsp, state.DUMP_BYTES)
  }

  /// Restores the stack and returns code.
  effect fn leave(self: &mut Self, code: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.unwind()
    run self.a.movImm32(Reg.Rax, code)
    run self.a.ret()
  }
  /// Frees the frame and pops the saved registers (the prologue in reverse). Keeps RAX.
  pub effect fn unwind(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.frame != 0 { run self.a.aluImm(Alu.Add, Width.W64, Reg.Rsp, self.frame) }
    let mut r = gprCount()
    while r > 0 { r = r - 1 if self.saves(r) { run self.a.pop(gprAt(r)) } }
  }
  effect fn exitStub(self: &mut Self, function: &Function, index: u32, owner: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let exit = function.exit(index)
    self.a.bind(self.exitLabels.get(u32.toUsize(index)))
    run self.a.movImm32(Reg.Rax, exit.pc)
    run self.a.store(Width.W64, Mem.at(Reg.Rsi, 0), Reg.Rax)
    run self.a.movImm32(Reg.Rax, exit.stackDepth)
    run self.a.store(Width.W64, Mem.at(Reg.Rsi, 8), Reg.Rax)
    // One ValueBits per local and stack slot, each owning what the interpreter's would.
    let count = function.exitSlots(exit)
    let mut i: u32 = 0
    while i < count {
      let slot = function.slot(exit, i)
      run self.valueInto(&function, slot.value, slot.mode, Reg.Rsi, 16 + i * SLOT_BYTES)
      i = i + 1
    }
    // A poll's exit is the loop target after a back edge: interrupt, not deopt. A call's
    // returns the status its result slot holds.
    if owner.op == Op.Call {
      run self.a.load(Width.W32, Reg.Rax, slotOf(owner.result))
      run self.unwind()
      run self.a.ret()
      return ()
    }
    let mut code = EXIT_DEOPT
    if owner.op == Op.Poll { code = EXIT_POLL }
    run self.leave(code)
  }
}

/// The tag field and payload of an `Imm` constant.
/// Whether inline target k's method is known for the shape of version `version`
/// (Function.inlineShapes).
fn knownFor(function: &Function, k: u32, version: u64) -> bool {
  let known = function.inlineShapes.get(u32.toUsize(k))
  let mut n: usize = 0
  while n < 4 && known.shapes[n] != 0 {
    if u32.toU64(known.shapes[n]) == version { return true }
    n = n + 1
  }
  return false
}
/// How many times exit x's slots read v (an object it rebuilds: each of its fields).
fn exitReads(function: &Function, x: u32, v: u32) -> u32 {
  let exit = function.exit(x)
  let mut n: u32 = 0
  let mut s: u32 = 0
  while s < function.slotCount(exit) {
    let slot = function.slot(exit, s)
    if slot.mode == SlotMode.Virtual {
      let vo = function.virtualObjs.get(u32.toUsize(slot.value))
      let mut fk: u32 = 0
      while fk < vo.slotCount { if vo.fields[u32.toUsize(fk)] == v { n = n + 1 } fk = fk + 1 }
    } else if slot.value == v { n = n + 1 }
    s = s + 1
  }
  return n
}
fn immTag(layout: &ValueLayout, k: i32) -> u32 {
  if k >= ssa.IMM_CATCH { return layout.catchOffset() }
  if k == 0 { return layout.undefined() }
  if k == 1 { return layout.null() }
  if k == 2 || k == 3 { return layout.boolean() }
  return layout.uninitialized()
}
fn immPayload(k: i32) -> i32 { if k >= ssa.IMM_CATCH { return k - ssa.IMM_CATCH } if k == 3 { return 1 } return 0 }
/// The comparison k's negation, for i32 operands (there is no NaN).
fn opposite(k: i32) -> i32 {
  if k == 0 { return 3 }
  if k == 1 { return 2 }
  if k == 2 { return 1 }
  if k == 3 { return 0 }
  if k == 4 { return 5 }
  return 4
}
fn condition(k: i32) -> Cond {
  if k == 0 { return Cond.Less }
  if k == 1 { return Cond.LessOrEqual }
  if k == 2 { return Cond.Greater }
  if k == 3 { return Cond.GreaterOrEqual }
  if k == 4 { return Cond.Equal }
  return Cond.NotEqual
}

/// The first instruction of block b that is not an `inline.frame` (which makes no code), when
/// it is a `check.shape`: where a shape dispatch's arm starts (Emitter.armEntry). NONE else.
fn armShapeAt(function: &Function, b: u32) -> u32 {
  let block = function.blocks.get(u32.toUsize(b))
  let mut i = block.firstInst
  while i < block.firstInst + block.instCount && function.inst(i).op == Op.InlineFrame { i = i + 1 }
  if i < block.firstInst + block.instCount && function.inst(i).op == Op.CheckShape { return i }
  return NONE
}
