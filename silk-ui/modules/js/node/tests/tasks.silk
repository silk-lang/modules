import silk.build.graph { Compilation, Options }
import silk.build.tasks { StandardError }
import silk.cli.command { Command, CommandLine }
import silk.cli.task { Task, TaskSet }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { FileSystem, Path }
import silk.system.host_input { HostInput }
import silk.system.subprocess { ExitWatch, SpawnOptions, Stdio, Subprocess, SubprocessError }
import silk.text.string { InvalidUtf8, String }

@foreign(noCapture: .("buffer"))
unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize

union Tasks {
  Check,
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("ui-js-node-check", "Build and run ui-js-node checks")
      |> Command.variant("Check", "Run network and Can I use checks against fixtures/server.mjs")
  }
}

effect fn pathText<'a>(path: &'a Path) -> string<'a>
  ! StandardError
  ? &mut Allocator {
  return match Path.view(path) {
    Option<string>.Some { value } => value
    Option<string>.None => run Task.abort("Path must be UTF-8")
  }
}

effect fn readLine(fd: i32) -> String
  ! StandardError
  ? &mut Allocator {
  let mut bytes = Bytes.make()
  let mut buf: [u8; 1] = [0]
  while true {
    let n = unsafe read(fd, Pointer.fromMutSlice(&mut buf), usize.ONE)
    if n <= 0 {
      break
    }
    if buf[0] == 10 {
      break
    }
    if buf[0] != 13 {
      run Bytes.append(&mut bytes, &buf)
    }
  }
  return match String.fromUtf8(Bytes.asSlice(&bytes)) {
    Result<string, InvalidUtf8>.Success { value } => run String.copy(String.trim(value))
    Result<string, InvalidUtf8>.Failure { .. } => run Task.abort("Server port was not UTF-8")
  }
}

fn bytesEqual(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i = usize.ZERO
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + usize.ONE
  }
  return true
}

effect fn runCheck() -> ()
  ! StandardError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let options = Options.make()
  let base = run Compilation.fromPackage(&options)
  let built = run base.build()
  let artifacts = built.artifacts.asSlice()
  if artifacts.length == usize.ZERO {
    run Task.abort("ui-js-node-check produced no binary")
  }
  let binary = &artifacts[0].path

  let testsDir = run Task.root()
  let serverScript = run Path.join(&testsDir, "fixtures/server.mjs")
  let netScript = run Path.join(&testsDir, "fixtures/net.js")

  let mut serverReq = run ChildProcess.request(&run Path.make("node"))
  run ChildProcess.addArgument(&mut serverReq, run pathText(&serverScript))
  run Subprocess.inheritEnvironment(&mut serverReq)
  let mut spawnOpts = SpawnOptions.make()
  run spawnOpts.setStdio(usize.ZERO, Stdio.pipe())
  run spawnOpts.setStdio(usize.ONE, Stdio.pipe())
  let mut server = match move run Effect.result(Subprocess.spawn(&serverReq, &spawnOpts)) {
    Result<Subprocess, SubprocessError | OutOfMemoryError>.Success { value } => move value
    Result<Subprocess, SubprocessError | OutOfMemoryError>.Failure { error } => match move error {
      SubprocessError _ => run Task.abort("Failed to start fixtures/server.mjs")
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let stdinFd = server.takePipe(usize.ZERO).unwrapOr(-1)
  let stdoutFd = server.takePipe(usize.ONE).unwrapOr(-1)
  let port = run readLine(stdoutFd)
  if stdoutFd >= 0 {
    Subprocess.closeDescriptor(stdoutFd)
  }
  if port.view() == "" {
    if stdinFd >= 0 {
      Subprocess.closeDescriptor(stdinFd)
    }
    run Task.abort("fixtures/server.mjs did not print a port")
  }

  let mut netReq = run ChildProcess.request(binary)
  run ChildProcess.addArgument(&mut netReq, run pathText(&netScript))
  run Subprocess.inheritEnvironment(&mut netReq)
  run ChildProcess.setVariable(&mut netReq, "SILK_TEST_PORT", port.view())
  let netOutcome = run ChildProcess.submit(&netReq)
  if stdinFd >= 0 {
    Subprocess.closeDescriptor(stdinFd)
  }
  let watch = run Effect.result(ExitWatch.open(server.pid()))
  drop watch
  if ChildProcess.exitCode(&netOutcome).unwrapOr(-1) != 0 {
    run Task.abort("ui-js-node network check failed")
  }

  let nodeDir = match move run Path.parent(&testsDir) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort("node/tests has no parent directory")
  }
  let jsDir = match move run Path.parent(&nodeDir) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort("node has no js parent directory")
  }
  let caniuse = run Path.join(&jsDir, "tests/fixtures/caniuse.js")

  let mut ciReq = run ChildProcess.request(binary)
  run ChildProcess.addArgument(&mut ciReq, run pathText(&caniuse))
  run Subprocess.inheritEnvironment(&mut ciReq)
  let ciOutcome = run ChildProcess.submit(&ciReq)
  if ChildProcess.exitCode(&ciOutcome).unwrapOr(-1) != 0 {
    run Task.abort("ui-js-node Can I use checks failed")
  }

  let tempDir = run Path.join(&testsDir, ".tmp-image")
  run FileSystem.createDirectoriesRecursively(&tempDir)
  let imagePath = run Path.join(&tempDir, "app.image")
  let mut imgReq = run ChildProcess.request(binary)
  run ChildProcess.addArgument(&mut imgReq, run pathText(&caniuse))
  run ChildProcess.addArgument(&mut imgReq, run pathText(&imagePath))
  run Subprocess.inheritEnvironment(&mut imgReq)
  let imgOutcome = run ChildProcess.submit(&imgReq)
  run FileSystem.removeDirectoryRecursively(&tempDir)
  if ChildProcess.exitCode(&imgOutcome).unwrapOr(-1) != 0
    || !bytesEqual(ChildProcess.outputBytes(&imgOutcome), ChildProcess.outputBytes(&ciOutcome)) {
    run Task.abort("ui-js-node bytecode image checks failed")
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! StandardError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Check => run runCheck()
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
