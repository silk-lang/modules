unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn realloc(pointer: ?*mut u8, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
unsafe effect fn throwPlainError<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, message: &[u8]) -> ValueBits ! JsException ? &mut Allocator {
  let memory = engine.memory
  let error = run errors.newError(&mut engine, memory, unsafe lendRealm(&context, context))
  let created = run Effect.result(unsafe host.string(&mut engine, context, message))
  let value = match move created {
    Result<ValueBits, JsException>.Success { value } => value
    Result<ValueBits, JsException>.Failure { error: failure } => { unsafe owners.release(&mut engine, context, error) fail move failure }
  }
  let defined = run Effect.result(unsafe common.define(&mut engine, context, error, b"message", value, 7))
  match move defined { Result<(), JsException>.Success { .. } => () Result<(), JsException>.Failure { error: failure } => { unsafe owners.release(&mut engine, context, error) fail move failure } }
  let rt = unsafe runtime.contextRuntime(context)
  return run unsafe exceptions.throwValue<ValueBits, Engine<'m, S>>(&mut engine, rt, error)
}
pub struct State { first: ?*mut Handle, jobs: ?*mut Job, next: i32, closing: bool, main: bool, configured: bool }
struct Handle { next: ?*mut Handle, id: i32, kind: i32, pointer: ?*mut u8 }
struct Job {
  next: ?*mut Job, work: pool.Job, callback: ValueBits, done: bool,
  op: i32, data: [?*mut u8; 8], lengths: [usize; 8], numbers: [i64; 8],
  handle: ?*mut u8, other: ?*mut u8, retained: bool,
  output: ?*mut u8, length: usize, capacity: usize, result: i64, resultKind: i32,
  created: ?*mut u8, createdKind: i32, status: i32, error: ?*mut u8, codedError: bool
}
unsafe fn nonnull<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
unsafe fn raw<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
unsafe fn textLength(p: ?*mut u8) -> usize {
  if Pointer.isNull<u8>(p) { return 0 }
  let bytes = unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(p)) let mut n: usize = 0
  while unsafe Pointer.read<u8>(unsafe Pointer.atMut<u8>(bytes, n)) != 0 { n = n + 1 }
  return n
}
fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false } let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true
}
fn operation(name: &[u8]) -> i32 {
  if equal(name, b"random") { return 1 } if equal(name, b"equal") { return 2 }
  if equal(name, b"pbkdf2") { return 3 } if equal(name, b"scrypt") { return 4 } if equal(name, b"hkdf") { return 5 }
  if equal(name, b"hashCreate") { return 10 } if equal(name, b"hashUpdate") { return 11 } if equal(name, b"hashFinal") { return 12 } if equal(name, b"hashCopy") { return 13 }
  if equal(name, b"hmacCreate") { return 14 } if equal(name, b"hmacUpdate") { return 15 } if equal(name, b"hmacFinal") { return 16 }
  if equal(name, b"cipherCreate") { return 20 } if equal(name, b"cipherUpdate") { return 21 } if equal(name, b"cipherFinal") { return 22 } if equal(name, b"cipherAAD") { return 23 } if equal(name, b"cipherTag") { return 24 } if equal(name, b"cipherGetTag") { return 25 } if equal(name, b"cipherPadding") { return 26 }
  if equal(name, b"keyImport") { return 30 } if equal(name, b"keyExport") { return 31 } if equal(name, b"keyGenerate") { return 32 } if equal(name, b"sign") { return 33 } if equal(name, b"verify") { return 34 } if equal(name, b"derive") { return 35 } if equal(name, b"keyType") { return 36 } if equal(name, b"keyBits") { return 37 } if equal(name, b"encrypt") { return 38 } if equal(name, b"decrypt") { return 39 }
  if equal(name, b"ecCreate") { return 40 } if equal(name, b"ecGenerate") { return 41 } if equal(name, b"ecPublic") { return 42 } if equal(name, b"ecPrivate") { return 43 } if equal(name, b"ecSetPrivate") { return 44 } if equal(name, b"ecSetPublic") { return 45 } if equal(name, b"ecSecret") { return 46 }
  if equal(name, b"dhCreate") { return 50 } if equal(name, b"dhGenerate") { return 51 } if equal(name, b"dhPublic") { return 52 } if equal(name, b"dhPrivate") { return 53 } if equal(name, b"dhSetPublic") { return 54 } if equal(name, b"dhSetPrivate") { return 55 } if equal(name, b"dhSecret") { return 56 } if equal(name, b"dhPrime") { return 57 } if equal(name, b"dhGenerator") { return 58 } if equal(name, b"dhCheck") { return 59 }
  if equal(name, b"digest") { return 6 } if equal(name, b"cipherOnce") { return 7 } if equal(name, b"hmac") { return 8 }
  if equal(name, b"hashSize") { return 9 }
  if equal(name, b"hashes") { return 60 } if equal(name, b"ciphers") { return 61 } if equal(name, b"curves") { return 62 } if equal(name, b"getFips") { return 63 } if equal(name, b"setFips") { return 64 }
  if equal(name, b"keyQBits") { return 65 }
  if equal(name, b"checkPrime") { return 66 } if equal(name, b"generatePrime") { return 67 } if equal(name, b"cipherInfo") { return 68 }
  if equal(name, b"privateEncrypt") { return 69 } if equal(name, b"publicDecrypt") { return 70 }
  if equal(name, b"secureHeapUsed") { return 71 } if equal(name, b"setEngine") { return 72 } if equal(name, b"keyParam") { return 73 } if equal(name, b"keyPublic") { return 74 } if equal(name, b"keyCheck") { return 75 } if equal(name, b"turboshake") { return 76 } if equal(name, b"secureHeapInit") { return 77 } if equal(name, b"secLevel") { return 78 } if equal(name, b"fipsAvailable") { return 79 } if equal(name, b"rsaPubkey") { return 80 } if equal(name, b"storeLoad") { return 81 } if equal(name, b"opensslInit") { return 82 } if equal(name, b"csprngCheck") { return 83 } if equal(name, b"fipsGeneration") { return 84 } if equal(name, b"opensslInitText") { return 85 }
  if equal(name, b"x509Create") { return 100 } if equal(name, b"x509Raw") { return 101 } if equal(name, b"x509PEM") { return 102 }
  if equal(name, b"x509Name") { return 103 } if equal(name, b"x509Time") { return 104 } if equal(name, b"x509Fingerprint") { return 105 }
  if equal(name, b"x509Serial") { return 106 } if equal(name, b"x509PublicKey") { return 107 } if equal(name, b"x509CA") { return 108 }
  if equal(name, b"x509Signature") { return 110 } if equal(name, b"x509Host") { return 111 } if equal(name, b"x509Email") { return 112 }
  if equal(name, b"x509IP") { return 113 } if equal(name, b"x509Issued") { return 114 } if equal(name, b"x509Private") { return 115 }
  if equal(name, b"x509Verify") { return 116 } if equal(name, b"spkacVerify") { return 117 } if equal(name, b"spkacPublic") { return 118 }
  if equal(name, b"spkacChallenge") { return 119 } if equal(name, b"pkcs12Parse") { return 120 } if equal(name, b"x509OID") { return 121 } if equal(name, b"x509NameDER") { return 122 }
  if equal(name, b"x509ECPublic") { return 123 } if equal(name, b"x509ECCurve") { return 124 }
  if equal(name, b"argon2") { return 140 } if equal(name, b"macCreate") { return 141 } if equal(name, b"macUpdate") { return 142 }
  if equal(name, b"macFinal") { return 143 } if equal(name, b"macs") { return 144 } if equal(name, b"encapsulate") { return 145 } if equal(name, b"decapsulate") { return 146 }
  if equal(name, b"kmac") { return 147 }
  if equal(name, b"providerRawImport") { return 148 } if equal(name, b"providerRawExport") { return 149 }
  if equal(name, b"providerAvailable") { return 150 }
  if equal(name, b"release") { return 99 } return 0
}
unsafe fn freeHandle(kind: i32, p: ?*mut u8) -> () { if kind == 8 { unsafe mac.release(p) } else if kind == 7 { unsafe x509.release(p) } else if kind == 6 { unsafe keys.releaseDh(p) } else if kind == 4 || kind == 5 { unsafe keys.release(p) } else { unsafe algorithms.releaseContext(kind, p) } }
unsafe fn destroyJob(job: *mut Job) -> () {
  let j = unsafe Pointer.take<Job>(job) let mut i: usize = 0
  while i < 8 { unsafe algorithms.cleanse(j.data[i], j.lengths[i]) unsafe free(j.data[i]) i = i + 1 }
  unsafe freeHandle(j.createdKind, j.created)
  unsafe algorithms.cleanse(j.output, j.capacity)
  unsafe free(j.output) unsafe free(j.error)
  unsafe free(unsafe raw(job))
}
/// main is true on the main thread only.
pub effect fn open(main: bool) -> *mut State ! OutOfMemoryError {
  let p = unsafe calloc(1, Layout.of<State>().bytes)
  if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} }
  let state = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(unsafe nonnull(p))
  unsafe Pointer.put<State>(state, State { first: Pointer.null<Handle>(), jobs: Pointer.null<Job>(), next: 1, closing: false, main: main, configured: false })
  return state
}
unsafe fn configureFor(state: *mut State, op: i32) -> () { if op != 82 && op != 85 { unsafe configure(state) } }
/// Configures the providers on the main thread, the first time it is called there.
/// Worker threads start only after the main thread called this, so it is done for them.
pub unsafe fn configure(state: *mut State) -> () {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  if !s.main || s.configured { return () }
  s.configured = true drop s
}
pub unsafe effect fn appendResources<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,array:ValueBits,index:&mut u32)->() !JsException ?&mut Allocator {
  let anchor=() let owner=unsafe Pointer.borrow<(),State>(&anchor,state) let mut cursor=owner.jobs drop owner
  while !Pointer.isNull<Job>(cursor) {
    let request=unsafe raw(unsafe nonnull(cursor))
    let job=unsafe Pointer.borrow<(),Job>(&anchor,unsafe nonnull(cursor))
    // Only immutable owner-thread fields: worker output/status is never inspected.
    cursor=job.next drop job
    run unsafe resources.appendRequest(&mut engine,context,array,&mut index,request,b"work",b"")
  }
}
unsafe fn locate(state: *mut State, id: i32, kind: i32) -> ?*mut u8 {
  let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let mut cursor = s.first drop s
  while !Pointer.isNull<Handle>(cursor) {
    let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nonnull(cursor))
    if h.id == id && h.kind == kind { return h.pointer } cursor = h.next
  }
  return nil()
}
unsafe fn releaseHandle(state: *mut State, id: i32) -> () {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let mut link = Pointer.fromMutRef<?*mut Handle>(&mut s.first) drop s
  while !Pointer.isNull<Handle>(unsafe Pointer.read<?*mut Handle>(link)) {
    let p = unsafe nonnull(unsafe Pointer.read<?*mut Handle>(link))
    let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, p)
    if h.id == id { unsafe Pointer.put<?*mut Handle>(link, h.next) let kind = h.kind let pointer = h.pointer drop h unsafe freeHandle(kind, pointer) unsafe free(unsafe raw(p)) return () }
    link = Pointer.fromMutRef<?*mut Handle>(&mut h.next) drop h
  }
}
unsafe fn reserve(j: &mut Job, n: usize) -> bool {
  let mut capacity = n if capacity == 0 { capacity = 1 }
  j.output = unsafe calloc(1, capacity) j.capacity = capacity j.length = n
  return !Pointer.isNull<u8>(j.output)
}
/// Fills `count` bytes at `output` from the system's secure random source.
unsafe fn randomFill(output: ?*mut u8, count: usize) -> () {
  if count == 0 { return () }
  let mut a = ()
  let bytes = unsafe Pointer.borrowManyMut<(), u8>(&mut a, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull<u8>(output)), count)
  let mut random = OsRandom.make()
  run Random.fillBytes(move bytes) |> Effect.provideMut<Random>(&mut random)
}
/// Compares `count` bytes in time that depends only on `count`, as timingSafeEqual must.
unsafe fn sameBytes(left: ?*mut u8, right: ?*mut u8, count: usize) -> bool {
  if count == 0 { return true }
  let a = ()
  let x = unsafe Pointer.borrowMany<(), u8>(&a, unsafe Pointer.assumeMany<u8>(unsafe nonnull<u8>(left)), count)
  let y = unsafe Pointer.borrowMany<(), u8>(&a, unsafe Pointer.assumeMany<u8>(unsafe nonnull<u8>(right)), count)
  let mut difference: u8 = 0
  let mut i: usize = 0
  while i < count { difference = difference | (x[i] ^ y[i]) i = i + 1 }
  return difference == 0
}
unsafe fn recordError(j: &mut Job) -> () { j.status = -1 }
unsafe effect fn prepareArgument<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, j: &mut Job, i: usize, value: ValueBits) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  if value.isNumber() {
    let number = value.numericValue()
    if !f64.isFinite(number) || number < -2147483648.0 || number > 9007199254740991.0 || f64.trunc(number) != number {
      let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"ERR_OUT_OF_RANGE: invalid native crypto integer") return ()
    }
    j.numbers[i] = f64.toI64(number) return ()
  }
  match value { ValueBits.Undefined => { return () } ValueBits.Null => { return () } _ => () }
  if value.isString() {
    let bytes = run unsafe host.text(&mut engine, context, value)
    let length = bytes.length()
    if length > 2147483647 { let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"ERR_OUT_OF_RANGE: crypto input exceeds INT_MAX") return () }
    j.lengths[i] = length
    j.data[i] = unsafe calloc(1, length + 1)
    if Pointer.isNull<u8>(j.data[i]) { fail OutOfMemoryError {} }
    let mut n: usize = 0 while n < length { unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.data[i], usize.toU64(n)), bytes.asSlice()[n]) n = n + 1 }
    return ()
  }
  let backing = run buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value))
  if backing.byteLength > 2147483647 { let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"ERR_OUT_OF_RANGE: crypto input exceeds INT_MAX") return () }
  j.lengths[i] = u64.toUsize(backing.byteLength)
  j.data[i] = unsafe calloc(1, j.lengths[i] + 1)
  if Pointer.isNull<u8>(j.data[i]) { fail OutOfMemoryError {} }
  let mut n: u64 = 0
  while n < backing.byteLength { unsafe Pointer.put<u8>(unsafe buffers.dataAt(j.data[i], n), u64.toU8(unsafe buffers.loadScalar(backing, n, 0))) n = n + 1 }
}
fn handleKind(op: i32) -> i32 {
  if op >= 11 && op <= 13 { return 1 } if op == 15 || op == 16 { return 2 }
  if op >= 21 && op <= 26 { return 3 }
  if op == 31 || op >= 33 && op <= 39 || op == 65 || op == 69 || op == 70 || op == 73 || op == 74 || op == 75 || op == 80 || op == 145 || op == 146 || op == 149 { return 4 }
  if op >= 101 && op <= 108 || op >= 110 && op <= 116 || op == 123 || op == 124 { return 7 }
  if op == 142 || op == 143 { return 8 }
  if op >= 41 && op <= 46 { return 5 } if op >= 51 && op <= 59 { return 6 } return 0
}
unsafe effect fn prepare<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, j: &mut Job, argv: &FrameSlots, asynchronous: bool) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let name = run unsafe host.text(&mut engine, context, unsafe common.argument(argv, 0))
  j.op = operation(name.asSlice())
  if j.op == 0 { let _ignored = run unsafe throwPlainError(&mut engine, context, b"ERR_CRYPTO_UNSUPPORTED_OPERATION: unknown crypto operation") return () }
  if asynchronous && !(j.op == 1 || j.op >= 3 && j.op <= 8 || j.op >= 30 && j.op <= 39 || j.op == 66 || j.op == 67 || j.op == 76 || j.op == 140 || j.op >= 145 && j.op <= 147) {
    let _ignored = run unsafe throwPlainError(&mut engine, context, b"ERR_CRYPTO_UNSUPPORTED_OPERATION: operation is not a worker job") return ()
  }
  let args = unsafe common.argument(argv, 1) let mut i: u32 = 0
  while i < 8 {
    let value = run unsafe owners.getIndex(&mut engine, context, args, i)
    let converted = run Effect.result(unsafe prepareArgument(&mut engine, context, &mut j, u32.toUsize(i), value))
    unsafe owners.release(&mut engine, context, value)
    match move converted { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
    i = i + 1
  }
  let kind = handleKind(j.op)
  if kind != 0 {
    j.handle = unsafe locate(state, i64.toI32(j.numbers[0]), kind)
    if Pointer.isNull<u8>(j.handle) { let _ignored = run unsafe throwPlainError(&mut engine, context, b"ERR_CRYPTO_INVALID_STATE: disposed or incompatible crypto handle") return () }
  }
  if j.op == 35 || j.op >= 114 && j.op <= 116 {
    let mut otherKind: i32 = 4 if j.op == 114 { otherKind = 7 }
    j.other = unsafe locate(state, i64.toI32(j.numbers[1]), otherKind)
    if Pointer.isNull<u8>(j.other) { let _ignored = run unsafe throwPlainError(&mut engine, context, b"ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE: invalid peer key") return () }
  }
}
effect fn newJob() -> *mut Job ! OutOfMemoryError {
  let p = unsafe calloc(1, Layout.of<Job>().bytes)
  if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} }
  let j = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(p))
  unsafe Pointer.put<Job>(j, Job { next: Pointer.null<Job>(), work: pool.job(silkSilkCryptoWork, silkSilkCryptoAfterWork, unsafe raw(j), pool.KIND_CRYPTO), callback: ValueBits.Undefined, done: false, op: 0, data: [nil(); 8], lengths: [0; 8], numbers: [0; 8], handle: nil(), other: nil(), retained: false, output: nil(), length: 0, capacity: 0, result: 0, resultKind: 0, created: nil(), createdKind: 0, status: 0, error: nil(), codedError: false })
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Job>(&mut anchor, j)
  entry.error = unsafe calloc(1, 256) let failed = Pointer.isNull<u8>(entry.error) drop entry
  if failed { unsafe destroyJob(j) fail OutOfMemoryError {} }
  return j
}
unsafe effect fn errorText(j: &Job) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = List<u8>.make()
  let mut i: usize = 0
  if !j.codedError {
    let prefix = b"ERR_OSSL_CRYPTO_OPERATION_FAILED: "
    while i < prefix.length { run bytes.append(prefix[i]) i = i + 1 }
  }
  let n = unsafe textLength(j.error)
  if n == 0 { let text = b"Invalid crypto parameters or unsupported algorithm" i = 0 while i < text.length { run bytes.append(text[i]) i = i + 1 } }
  else { i = 0 while i < n { run bytes.append(unsafe Pointer.read<u8>(unsafe buffers.dataAt(j.error, usize.toU64(i)))) i = i + 1 } }
  return move bytes
}
unsafe effect fn finish<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, j: &mut Job) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  if j.status != 0 { let message = run unsafe errorText(&j.*) return run unsafe throwPlainError(&mut engine, context, message.asSlice()) }
  if j.resultKind == 4 { return ValueBits.Undefined }
  if j.resultKind == 1 { return ValueBits.Float64 { value: i64.toF64(j.result) } }
  if j.resultKind == 2 {
    let p = unsafe calloc(1, Layout.of<Handle>().bytes) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} }
    let handle = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Handle>(unsafe nonnull(p))
    let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
    if s.next == 2147483647 { drop s unsafe free(p) return run unsafe throwPlainError(&mut engine, context, b"ERR_CRYPTO_INVALID_STATE: crypto handle identifier space exhausted") }
    let id = s.next s.next = s.next + 1
    unsafe Pointer.put<Handle>(handle, Handle { next: s.first, id: id, kind: j.createdKind, pointer: j.created })
    s.first = handle j.created = nil() return ValueBits.Int { value: id }
  }
  if j.resultKind == 3 {
    let mut bytes = List<u8>.make() let mut i: usize = 0
    while i < j.length { run bytes.append(unsafe Pointer.read<u8>(unsafe buffers.dataAt(j.output, usize.toU64(i)))) i = i + 1 }
    return run unsafe host.string(&mut engine, context, bytes.asSlice())
  }
  let memory = engine.memory
  return run unsafe buffers.newArrayBufferCopy(&mut engine, memory, unsafe lendRealm(&context, context), j.output, usize.toU64(j.length))
}
// Runs before a worker thread starts (library_hooks.ThreadSetup): see configure.
pub export "C" fn silkSilkCryptoThreadSetup(data: ?*mut u8) -> () {
  if !Pointer.isNull<u8>(data) { unsafe configure(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(unsafe nonnull(data))) }
}
pub unsafe effect fn dispatch<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  // A call with no arguments asks for the version, for process.versions.openssl.
  if argc == 0 {
    // The OpenSSL release whose behaviour (error strings, defaults) this follows, marked as not OpenSSL.
    return (run text.string(&mut engine, unsafe lendRealm(&context, context), b"3.5.4+silk")).intoBits()
  }
  let j = run newJob() let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Job>(&mut anchor, j)
  let prepared = run Effect.result(unsafe prepare(&mut engine, context, state, &mut entry, argv, false)) drop entry
  match move prepared { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe destroyJob(j) fail move error } }
  let entry2 = unsafe Pointer.borrowMut<(), Job>(&mut anchor, j)
  if entry2.op == 99 { unsafe releaseHandle(state, i64.toI32(entry2.numbers[0])) entry2.resultKind = 4 }
  else { unsafe configureFor(state, entry2.op) if !unsafe execute(&mut entry2) { unsafe recordError(&mut entry2) } }
  let converted = run Effect.result(unsafe finish(&mut engine, context, state, &mut entry2)) drop entry2
  unsafe destroyJob(j)
  return match move converted { Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
}
// Runs on a blocking worker.
export "C" fn silkSilkCryptoWork(p: ?*mut u8) -> () {
  let j = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(p))
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Job>(&mut anchor, j)
  if !unsafe execute(&mut entry) { unsafe recordError(&mut entry) }
}
export "C" fn silkSilkCryptoAfterWork(p: ?*mut u8) -> () {
  let j = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Job>(unsafe nonnull(p))
  let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Job>(&mut anchor, j)
  entry.done = true
}
pub unsafe effect fn submit<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, io: *mut fs_async.State, argc: i32, argv: &FrameSlots) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
  let anchor = () let s = unsafe Pointer.borrow<(), State>(&anchor, state) let closing = s.closing drop s
  if closing { return run unsafe throwPlainError(&mut engine, context, b"ERR_CRYPTO_INVALID_STATE: crypto executor is closed") }
  let j = run newJob() let mut mutable = () let entry = unsafe Pointer.borrowMut<(), Job>(&mut mutable, j)
  let prepared = run Effect.result(unsafe prepare(&mut engine, context, state, &mut entry, argv, true)) drop entry
  match move prepared { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { unsafe destroyJob(j) fail move error } }
  let entry2 = unsafe Pointer.borrowMut<(), Job>(&mut mutable, j)
  unsafe configureFor(state, entry2.op)
  entry2.callback = unsafe (unsafe common.argument(argv, 2)).retained()
  let mut stateAnchor = () let s2 = unsafe Pointer.borrowMut<(), State>(&mut stateAnchor, state)
  entry2.next = s2.jobs s2.jobs = j drop s2
  let job = Pointer.fromMutRef<pool.Job>(&mut entry2.work) drop entry2
  let status = run unsafe fs_async.queueWork(io, job)
  if status < 0 { let entry3 = unsafe Pointer.borrowMut<(), Job>(&mut mutable, j) entry3.status = status entry3.done = true }
  return ValueBits.Undefined
}
unsafe fn takeCompleted(state: *mut State) -> ?*mut Job {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let mut link = Pointer.fromMutRef<?*mut Job>(&mut s.jobs) drop s
  while !Pointer.isNull<Job>(unsafe Pointer.read<?*mut Job>(link)) {
    let p = unsafe nonnull(unsafe Pointer.read<?*mut Job>(link)) let j = unsafe Pointer.borrowMut<(), Job>(&mut anchor, p)
    if j.done { unsafe Pointer.put<?*mut Job>(link, j.next) return p }
    link = Pointer.fromMutRef<?*mut Job>(&mut j.next) drop j
  }
  return Pointer.null<Job>()
}
unsafe effect fn deliver<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, j: &mut Job) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let mut error = ValueBits.Null let mut value = ValueBits.Undefined
  if j.status != 0 { let text = run unsafe errorText(&j) error = run unsafe host.string(&mut engine, context, text.asSlice()) }
  else { value = run unsafe finish(&mut engine, context, state, &mut j) }
  let called = run Effect.result(promise.call(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(j.callback), unsafe lendFor(ValueBits.Undefined), &[error, value]))
  unsafe owners.release(&mut engine, context, error) unsafe owners.release(&mut engine, context, value)
  match move called { Result<Value, JsException>.Success { value: returned } => { unsafe owners.release(&mut engine, context, returned.intoBits()) } Result<Value, JsException>.Failure { error: failure } => { fail move failure } }
}
pub unsafe effect fn poll<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  // Whether a completion's callback ran.
  let mut ran = false
  while true {
    let optional = unsafe takeCompleted(state) if Pointer.isNull<Job>(optional) { return ran }
    let j = unsafe nonnull(optional) let mut anchor = () let entry = unsafe Pointer.borrowMut<(), Job>(&mut anchor, j)
    ran = true
    let delivered = run Effect.result(unsafe deliver(&mut engine, context, state, &mut entry)) let callback = entry.callback drop entry
    unsafe owners.release(&mut engine, context, callback) unsafe destroyJob(j)
    match move delivered { Result<(), OutOfMemoryError | JsException>.Success { .. } => () Result<(), OutOfMemoryError | JsException>.Failure { error } => { fail move error } }
  }
}
pub unsafe fn close<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, io: *mut fs_async.State) -> () {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state) s.closing = true drop s
  while true {
    let s2 = unsafe Pointer.borrow<(), State>(&anchor, state) let empty = Pointer.isNull<Job>(s2.jobs) drop s2
    if empty { break }
    run unsafe fs_async.waitWork(io)
    while true {
      let optional = unsafe takeCompleted(state) if Pointer.isNull<Job>(optional) { break }
      let j = unsafe nonnull(optional) let entry = unsafe Pointer.borrow<(), Job>(&anchor, j) let callback = entry.callback drop entry
      unsafe owners.release(&mut engine, context, callback) unsafe destroyJob(j)
    }
  }
  let owned = unsafe Pointer.take<State>(state) let mut cursor = owned.first
  while !Pointer.isNull<Handle>(cursor) { let p = unsafe nonnull(cursor) let h = unsafe Pointer.take<Handle>(p) cursor = h.next unsafe freeHandle(h.kind, h.pointer) unsafe free(unsafe raw(p)) }
  unsafe free(unsafe raw(state))
}
pub unsafe fn openHandles(state: *mut State) -> usize {
  let mut anchor = () let s = unsafe Pointer.borrowMut<(), State>(&mut anchor, state)
  let mut cursor = s.first drop s
  let mut count: usize = 0
  while !Pointer.isNull<Handle>(cursor) {
    let mut held = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut held, unsafe Intrinsic.pointerRequalify<?*mut Handle, *mut Handle>(cursor))
    if true { count = count + 1 }
    cursor = h.next drop h
  }
  return count
}

// The work itself: ext/crypto_algorithms, over silk.crypto.
unsafe fn execute(j: &mut Job) -> bool {
  let mut call = algorithms.Call { op: j.op, data: j.data, lengths: j.lengths, numbers: j.numbers, handle: j.handle, output: j.output, length: j.length, capacity: j.capacity,
    result: 0, resultKind: 0, created: nil(), createdKind: 0, error: j.error, codedError: false, other: j.other }
  let op = j.op
  let ok = if op >= 141 && op <= 144 { unsafe mac.execute(&mut call) } else if op == 76 || op == 147 || op == 6 && unsafe keccak.isKeccakKmac(&call) { unsafe keccak.execute(&mut call) } else if op == 140 { unsafe argon2.execute(&mut call) } else if op >= 100 && op <= 124 { unsafe x509.execute(&mut call) } else if op == 145 || op == 146 || op == 150 { unsafe keys.executeProvider(&mut call) } else if op == 66 || op == 67 { unsafe keys.executePrime(&mut call) } else if op >= 50 && op <= 59 { unsafe keys.executeDh(&mut call) } else if op >= 40 && op <= 46 { unsafe keys.executeEcdh(&mut call) } else if op >= 30 && op <= 39 || op == 62 || op == 65 || op == 80 || op == 69 || op == 70 || op >= 73 && op <= 75 || op == 148 || op == 149 { unsafe keys.execute(&mut call) } else { unsafe algorithms.execute(&mut call) }
  j.output = call.output j.length = call.length j.capacity = call.capacity j.result = call.result j.resultKind = call.resultKind
  j.created = call.created j.createdKind = call.createdKind j.codedError = call.codedError
  return ok
}

/// Takes each C export as a value, so that Silk emits it.
pub fn keepExports() -> () {
  let _work: extern "C" fn(?*mut u8) -> () = silkSilkCryptoWork
  let _after: extern "C" fn(?*mut u8) -> () = silkSilkCryptoAfterWork
}
