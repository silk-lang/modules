{
  "name": "@silkui/react",
  "version": "0.1.15",
  "description": "A React renderer for the Silk UI tree, for applications that run on the embedded SilkJS engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silk-lang/SilkUI.git",
    "directory": "modules/js/packages/react"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.d.ts",
      "default": "./src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-runtime.d.ts",
      "default": "./src/jsx-dev-runtime.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./dom": {
      "types": "./src/dom.d.ts",
      "default": "./src/dom.js"
    },
    "./html.css": "./src/html.css"
  },
  "files": [
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@silkui/core": "0.1.15",
    "react-reconciler": "^0.34.0",
    "react-refresh": "^0.18.0"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.3.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3",
    "@silkui/vite": "0.1.15"
  }
}
