//! Crypto in Silk (ext/crypto_algorithms over silk.crypto, behind ../openssl's bridge): an
//! implementation of the runtime's `Crypto` capability with no C library (docs/composable-runtime.md,
//! step 8). Hashes, HMAC, key derivation, random bytes and the AES and ChaCha20 ciphers are here;
//! keys, signatures, key agreement and certificates are not yet, and fail with
//! ERR_CRYPTO_UNSUPPORTED_OPERATION.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjsruntime.ext.fs_async as fs_async
import silkjsruntime.ext.library_hooks { ThreadSetup }
import silkjsruntime.libs.core.capabilities { Crypto, Composition }
import silkjsruntime.libs.core.host { Services }
import ext.crypto_silk

/// silk.crypto behind `node:crypto` and `globalThis.crypto` (ext/crypto_silk, ext/crypto_algorithms).
pub struct SilkCrypto {
  state: ?*mut crypto_silk.State,
}
impl Copy for SilkCrypto {}

impl SilkCrypto {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> SilkCrypto { return SilkCrypto { state: Pointer.null<crypto_silk.State>() } }
  unsafe fn opened(self: &Self) -> *mut crypto_silk.State {
    if Pointer.isNull<crypto_silk.State>(self.state) { Intrinsic.trap("crypto executor is not initialized") }
    return unsafe Intrinsic.pointerRequalify<?*mut crypto_silk.State, *mut crypto_silk.State>(self.state)
  }
}

impl Crypto for SilkCrypto {
  static fn present() -> bool { return true }
  fn forWorker(self: &Self) -> Self { return SilkCrypto.make() }
  effect fn open(self: &mut Self, main: bool) -> () ! OutOfMemoryError {
    // The C entry points the blocking pool calls are emitted only when something takes them.
    crypto_silk.keepExports()
    self.state = run crypto_silk.open(main)
  }
  unsafe fn threadSetup(self: &Self) -> ThreadSetup {
    return ThreadSetup { data: unsafe Intrinsic.pointerReinterpret<?*mut crypto_silk.State, ?*mut u8>(self.state), prepare: crypto_silk.silkSilkCryptoThreadSetup }
  }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, id: u32, io: *mut fs_async.State, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if id == 2100 { return run unsafe crypto_silk.dispatch(&mut engine, context, unsafe self.opened(), argc, argv) }
    return run unsafe crypto_silk.submit(&mut engine, context, unsafe self.opened(), io, argc, argv)
  }
  unsafe effect fn poll<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe crypto_silk.poll(&mut engine, context, unsafe self.opened())
  }
  unsafe effect fn appendResources<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, array: ValueBits, index: &mut u32) -> ()
    ! JsException ? &mut Allocator {
    run unsafe crypto_silk.appendResources(&mut engine, context, unsafe self.opened(), array, &mut index)
  }
  unsafe fn openHandles(self: &Self) -> usize {
    return match Pointer.nonNullMut<crypto_silk.State>(self.state) {
      Option<*mut crypto_silk.State>.Some { value } => unsafe crypto_silk.openHandles(value)
      Option<*mut crypto_silk.State>.None => 0
    }
  }
  unsafe fn close<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, io: *mut fs_async.State) -> () {
    match Pointer.nonNullMut<crypto_silk.State>(self.state) {
      Option<*mut crypto_silk.State>.Some { value } => {
        unsafe crypto_silk.close(&mut engine, context, value, io)
        self.state = Pointer.null<crypto_silk.State>()
      }
      Option<*mut crypto_silk.State>.None => ()
    }
  }
}

