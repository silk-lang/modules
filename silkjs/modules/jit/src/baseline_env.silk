pub const HELPER_COUNT: usize = 32
/// Machine code, not a C function: drops the count of the heap value whose tag word is in
/// r10 and payload in r11, and preserves every register (baseline.releaseStub).
pub const RELEASE_STUB: u32 = 0
/// release(env, value: *const ValueBits): drops the count the value owns.
pub const RELEASE: u32 = 1
/// get_field(env, ip, cell, out) -> u32: js_baseline.readField.
pub const GET_FIELD: u32 = 2
/// get_field_top(env, ip, cell) -> u32: js_baseline.readFieldTop.
pub const GET_FIELD_TOP: u32 = 3
/// get_field2(env, ip, cell, out) -> u32: js_baseline.readFieldCached.
pub const GET_FIELD2: u32 = 4
/// put_field(env, ip, target, source, pops) -> u32: js_baseline.writeField.
pub const PUT_FIELD: u32 = 5
/// get_var(env, function, index, out) -> u32: js_baseline.readVariable.
pub const GET_VAR: u32 = 6
/// equal(env, left, right, how) -> u32: js_baseline.equal; how is 1 to negate plus 2 for the
/// strict comparison.
pub const EQUAL: u32 = 7
/// truthy(env, cell) -> u32: js_baseline.truthy.
pub const TRUTHY: u32 = 8
/// get_element(env, ip, cell, unused, mode) -> u32: js_baseline.readElement, with the entry
/// of BaselineEnv.elements that ip names.
pub const GET_ELEMENT: u32 = 9
/// put_element(env, ip, cell) -> u32: js_baseline.storeElement, with ip's entry.
pub const PUT_ELEMENT: u32 = 10
/// arithmetic(env, left, right, opcode, out) -> u32: js_baseline.arithmetic.
pub const ARITHMETIC: u32 = 11
/// not(env, cell) -> u32: js_baseline.logicalNot.
pub const NOT: u32 = 12
/// atom_value(env, atom, out) -> u32: js_baseline.atomValue.
pub const ATOM_VALUE: u32 = 13
/// truth(env, cell) -> u32: js_baseline.truth.
pub const TRUTH: u32 = 14
/// unary(env, cell, opcode) -> u32: js_baseline.unary.
pub const UNARY: u32 = 15
/// put_var(env, function, index, cell) -> u32: js_baseline.writeVariable.
pub const PUT_VAR: u32 = 16
/// instance_of(env, cell, 0) -> u32: js_baseline.instanceOf.
pub const INSTANCE_OF: u32 = 17
/// typeof_is(env, cell, how) -> u32: js_baseline.typeofIs; how is the opcode (typeof or one
/// of its tests) plus its operand shifted left 8.
pub const TYPEOF_IS: u32 = 18
/// (env, source cell, out cell) -> 1 when source held a string and out now holds its length.
pub const LENGTH: u32 = 19
/// element_of(env, object, key, out, ip) -> u32: js_baseline.elementOf, on the site cache.
pub const ELEMENT_OF: u32 = 20
/// getter(env, ip, cell, out) -> u32: js_baseline.getterOf.
pub const GETTER: u32 = 21
/// scope(env, record, storage): js_baseline.beginScope.
pub const SCOPE: u32 = 22
/// hot(env, bytecode): js_baseline.countLeaf.
pub const HOT: u32 = 23
/// setter(env, ip, cell, out) -> u32: js_baseline.setterOf.
pub const SETTER: u32 = 24
/// tier(env, bytecode): the shared prologue's count of the function ran out
/// (jit_runtime.jitTierUp); installed by the embedder that has an optimizer.
pub const TIER: u32 = 25
/// frame_exit(env, record, slots, exit, dump, how) -> u64: optimized code hands its frame to
/// baseline code (x64_frame_exit.jitFrameExit).
pub const FRAME_EXIT: u32 = 26
/// store_element(env, object, key, value, ip) -> u32: js_baseline.storeElementOf, on the
/// site cache (optimized code's keyed stores).
pub const STORE_ELEMENT: u32 = 27
/// construct_fast(env, base, count, out) -> u32: planned spare-cell construction for
/// CONSTRUCT_STORES and CONSTRUCT_GENERIC, and the receiver of a CONSTRUCT_FORWARD wrapper
/// without a plan. Returns 1 on success (owned object in out), 3 for a receiver and the
/// function to run on it, 4 for a receiver to run the constructor on, 2 to skip SERVICE_NEW
/// for SERVICE_CONSTRUCT (which makes recipes as the interpreter does), 0 to try SERVICE_NEW.
pub const CONSTRUCT_FAST: u32 = 28
/// get_private(env, cell) -> u32: OP_get_private_field of the object at cell and private
/// symbol after it; replaces object with the retained value and drops both operands.
pub const GET_PRIVATE: u32 = 29
/// put_private(env, cell) -> u32: OP_put_private_field of the object at cell, value after
/// it, and private symbol third; moves value into the own private data slot and drops the
/// displaced value, symbol, and object.
pub const PUT_PRIVATE: u32 = 30
/// concat_prim(env, left, right, out, flags) -> u32: joins a String/Rope and a Bool, Null,
/// or Undefined in either order; writes the owned result into out, releasing left when
/// (flags & 1) != 0 and right when (flags & 2) != 0. Returns 1 on success, 0 unchanged.
pub const CONCAT_PRIM: u32 = 31

/// The layout baseline code reads: the offsets below are part of its ABI.
pub struct BaselineEnv {
  /// The runtime the code runs in (offset 0).
  pub runtime: ?*mut HeapHeader,
  /// Helper entry points, at offset 8 + 8 * index.
  pub helpers: [?*const u8; 32],
  /// Activations the interpreter finished (SERVICE_FINISH requests), at DEPARTURES_OFFSET.
  pub departures: u64,
  /// Calls made through the engine's service (SERVICE_CALL), at SERVICE_CALLS_OFFSET.
  pub serviceCalls: u64,
  /// Calls made from baseline code straight into baseline code, at DIRECT_CALLS_OFFSET.
  pub directCalls: u64,
  /// Instructions the interpreter ran one at a time for the code (SERVICE_STEP), at STEPS_OFFSET.
  pub steps: u64,
  /// The steps by opcode, at STEP_COUNTS_OFFSET + 8 * opcode: what a template would pay for.
  pub stepCounts: [u64; 256],
  /// Departures by the opcode of the instruction the interpreter took over at, at
  /// EXIT_COUNTS_OFFSET + 8 * opcode, and the steps that ended their activation, at
  /// STEPS_ENDED_OFFSET (departures too).
  pub exitCounts: [u64; 256],
  pub stepsEnded: u64,
  /// Times the code went on where a service left the frame (baseline.MARK_TABLE), at
  /// RESUMES_OFFSET.
  pub resumes: u64,
  /// What the element instructions found under Symbol keys, at ELEMENTS_OFFSET + 32 * (the
  /// low bits of the instruction's operand address): js_baseline.ElementSite, whose fields
  /// are at ELEMENT_SITE, ELEMENT_SYMBOL, ELEMENT_KEY and ELEMENT_STORE.
  pub elements: [engine.ElementSite; engine.ELEMENT_SITES],
  /// The embedder's own word (jit_runtime's Jit), for the helpers it installs.
  pub owner: ?*mut u8,
  /// Exits optimized code took (frame_exit), at FRAME_EXITS_OFFSET.
  pub frameExits: u64,
  /// The jit_helpers.CompiledEnv whose helpers optimized code calls for what it has no
  /// stub for, at COMPILED_OFFSET (x64_backend.callHelper).
  pub compiled: ?*mut u8,
  /// Of frameExits, those that left inlined bodies part way through (js_baseline.Inlined).
  pub inlinedExits: u64,
  /// Element instructions whose helper ran where optimized code's inline read or store
  /// would miss too (js_baseline.elementMissNoted), and field reads and stores that met an
  /// accessor or something else the engine's field helpers decline (the getter and setter
  /// helpers run there), field stores that turn (noteTurn), and adds that joined a string
  /// (baseline.noteSite), by their operand's address, one per missIndex, at MISSES_OFFSET:
  /// what the optimizer compiles for the helper and a step from the start
  /// (jit_runtime.missedSites).
  pub misses: [usize; MISSES]
}
/// Entries of BaselineEnv.misses: enough that a note lives until its function is optimized,
/// which in a server can be thousands of requests later, with every getter the runtime's
/// streams read noted meanwhile.
pub const MISSES: usize = 4096
/// log2 of MISSES, the shift of missIndex.
pub const MISS_SHIFT: usize = 12
/// Top bit of a BaselineEnv.misses entry: set when an add site joined a string, cleared
/// when it only saw non-Int numbers (so the optimizer widens it to doubles without turning
/// it into string concatenation).
pub const MISS_CONCAT: usize = 0x8000000000000000
/// A bit of a BaselineEnv.misses entry: a field store that turned once between adding its
/// property and storing to it where it is (noteTurn). No note yet; the second turn is one.
pub const MISS_ONCE: usize = 0x4000000000000000
/// The entry of BaselineEnv.misses for the instruction whose operand is at site.
pub fn missIndex(site: usize) -> usize { return (site ^ usize.shiftRight(site, MISS_SHIFT)) & (MISSES - 1) }
/// Notes in env that the element instruction at ip took its helper on the object and key in
/// the cells, when optimized code would miss there too.
unsafe fn noteMiss(env: *mut BaselineEnv, ip: *const u8, objectCell: *const ValueBits, keyCell: *const ValueBits) -> () {
  if !unsafe engine.elementMissNoted(objectCell, keyCell) { return () }
  unsafe noteSite(env, ip)
}
/// Notes in env the instruction whose operand is at ip (BaselineEnv.misses).
unsafe fn noteSite(env: *mut BaselineEnv, ip: *const u8) -> () {
  let mut anchor = ()
  let state = unsafe Pointer.borrowMut<(), BaselineEnv>(&mut anchor, env)
  let site = Pointer.address<u8>(ip)
  state.misses[missIndex(site)] = site
}
/// Notes in env the field store whose operand is at ip the second time it turns: a store to
/// the property where it is at a site whose last store added it, or an add at a site whose
/// last store found it. The optimizer's store tests one shape (the site's inline key when
/// it compiles) and leaves on the other, so a site that keeps turning is compiled general
/// from the start. One turn is an object's first store among later ones, and no note.
unsafe fn noteTurn(env: *mut BaselineEnv, ip: *const u8) -> () {
  let mut anchor = ()
  let state = unsafe Pointer.borrowMut<(), BaselineEnv>(&mut anchor, env)
  let site = Pointer.address<u8>(ip)
  let index = missIndex(site)
  let entry = state.misses[index]
  if entry == site { return () }
  if entry == (site | MISS_ONCE) { state.misses[index] = site } else { state.misses[index] = site | MISS_ONCE }
}
pub const OWNER_OFFSET: i32 = ELEMENTS_OFFSET + 32 * 2048 // engine.ELEMENT_SITES
pub const FRAME_EXITS_OFFSET: i32 = OWNER_OFFSET + 8
pub const COMPILED_OFFSET: i32 = FRAME_EXITS_OFFSET + 8
pub const INLINED_EXITS_OFFSET: i32 = COMPILED_OFFSET + 8
pub const MISSES_OFFSET: i32 = INLINED_EXITS_OFFSET + 8
pub const DEPARTURES_OFFSET: i32 = 8 + 8 * 32
pub const SERVICE_CALLS_OFFSET: i32 = DEPARTURES_OFFSET + 8
pub const DIRECT_CALLS_OFFSET: i32 = SERVICE_CALLS_OFFSET + 8
pub const STEPS_OFFSET: i32 = DIRECT_CALLS_OFFSET + 8
pub const STEP_COUNTS_OFFSET: i32 = STEPS_OFFSET + 8
pub const EXIT_COUNTS_OFFSET: i32 = STEP_COUNTS_OFFSET + 8 * 256
pub const STEPS_ENDED_OFFSET: i32 = EXIT_COUNTS_OFFSET + 8 * 256
pub const RESUMES_OFFSET: i32 = STEPS_ENDED_OFFSET + 8
pub const ELEMENTS_OFFSET: i32 = RESUMES_OFFSET + 8
pub const ELEMENT_SITE: i32 = 0
pub const ELEMENT_SYMBOL: i32 = 8
pub const ELEMENT_KEY: i32 = 16
pub const ELEMENT_STORE: i32 = 24
/// The mask of an operand address that picks its entry, and log2 of an entry's bytes.
pub const ELEMENT_MASK: i32 = 2047 // engine.ELEMENT_SITES - 1
pub const ELEMENT_SHIFT: u8 = 5
impl Copy for BaselineEnv {}

/// The byte offset of helper `index` in a BaselineEnv.
pub fn helperOffset(index: u32) -> i32 { return u32.wrappingToI32(8 + index * 8) }

fn address4(function: extern "C" fn(*mut BaselineEnv, *const u8, *const ValueBits, *mut ValueBits) -> u32) -> ?*const u8 {
  return unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *const ValueBits, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&function)))
}

impl BaselineEnv {
  /// An environment with every C helper installed; the caller adds RELEASE_STUB.
  pub fn make() -> BaselineEnv {
    let mut env = BaselineEnv { runtime: Pointer.null<HeapHeader>(), helpers: [Pointer.null<u8>(); 32], departures: 0, serviceCalls: 0, directCalls: 0, steps: 0, stepCounts: [0; 256], exitCounts: [0; 256], stepsEnded: 0, resumes: 0,
      elements: [engine.ElementSite { site: 0, symbol: 0, key: 0, store: 0 }; engine.ELEMENT_SITES], owner: Pointer.null<u8>(), frameExits: 0, compiled: Pointer.null<u8>(), inlinedExits: 0, misses: [0; MISSES] }
    let release: extern "C" fn(*mut BaselineEnv, *const ValueBits) -> () = baselineRelease
    env.helpers[u32.toUsize(RELEASE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits) -> (), *const ?*const u8>(Pointer.fromRef(&release)))
    env.helpers[u32.toUsize(GET_FIELD)] = address4(baselineGetField)
    let getFieldTop: extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits) -> u32 = baselineGetFieldTop
    env.helpers[u32.toUsize(GET_FIELD_TOP)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getFieldTop)))
    let getField2: extern "C" fn(*mut BaselineEnv, *const u8, *const ValueBits, *mut ValueBits, *mut HeapHeader) -> u32 = baselineGetField2
    env.helpers[u32.toUsize(GET_FIELD2)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *const ValueBits, *mut ValueBits, *mut HeapHeader) -> u32, *const ?*const u8>(Pointer.fromRef(&getField2)))
    let length: extern "C" fn(*mut BaselineEnv, *const ValueBits, *mut ValueBits) -> u32 = baselineLength
    env.helpers[u32.toUsize(LENGTH)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&length)))
    let putField: extern "C" fn(*mut BaselineEnv, *const u8, *const ValueBits, *mut ValueBits, u32) -> u32 = baselinePutField
    env.helpers[u32.toUsize(PUT_FIELD)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *const ValueBits, *mut ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&putField)))
    let getVar: extern "C" fn(*mut BaselineEnv, *mut HeapHeader, u32, *mut ValueBits) -> u32 = baselineGetVar
    env.helpers[u32.toUsize(GET_VAR)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut HeapHeader, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getVar)))
    let equal: extern "C" fn(*mut BaselineEnv, *mut ValueBits, *const ValueBits, u32) -> u32 = baselineEqual
    env.helpers[u32.toUsize(EQUAL)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits, *const ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&equal)))
    let truthy: extern "C" fn(*mut BaselineEnv, *const ValueBits) -> u32 = baselineTruthy
    env.helpers[u32.toUsize(TRUTHY)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&truthy)))
    let getElement: extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits, *mut ValueBits, u32) -> u32 = baselineGetElement
    env.helpers[u32.toUsize(GET_ELEMENT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits, *mut ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&getElement)))
    let putElement: extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits) -> u32 = baselinePutElement
    env.helpers[u32.toUsize(PUT_ELEMENT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&putElement)))
    let arithmetic: extern "C" fn(*mut BaselineEnv, *const ValueBits, *const ValueBits, u32, *mut ValueBits) -> u32 = baselineArithmetic
    env.helpers[u32.toUsize(ARITHMETIC)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits, *const ValueBits, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&arithmetic)))
    let not: extern "C" fn(*mut BaselineEnv, *mut ValueBits) -> u32 = baselineNot
    env.helpers[u32.toUsize(NOT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&not)))
    let atomValue: extern "C" fn(*mut BaselineEnv, u32, *mut ValueBits) -> u32 = baselineAtomValue
    env.helpers[u32.toUsize(ATOM_VALUE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&atomValue)))
    let truth: extern "C" fn(*mut BaselineEnv, *const ValueBits) -> u32 = baselineTruth
    env.helpers[u32.toUsize(TRUTH)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&truth)))
    let instanceOf: extern "C" fn(*mut BaselineEnv, *mut ValueBits, u32) -> u32 = baselineInstanceOf
    env.helpers[u32.toUsize(INSTANCE_OF)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&instanceOf)))
    let typeofIs: extern "C" fn(*mut BaselineEnv, *mut ValueBits, u32) -> u32 = baselineTypeofIs
    env.helpers[u32.toUsize(TYPEOF_IS)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&typeofIs)))
    let unary: extern "C" fn(*mut BaselineEnv, *mut ValueBits, u32) -> u32 = baselineUnary
    env.helpers[u32.toUsize(UNARY)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&unary)))
    let elementOf: extern "C" fn(*mut BaselineEnv, *const ValueBits, *const ValueBits, *mut ValueBits, *const u8) -> u32 = baselineElementOf
    env.helpers[u32.toUsize(ELEMENT_OF)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits, *const ValueBits, *mut ValueBits, *const u8) -> u32, *const ?*const u8>(Pointer.fromRef(&elementOf)))
    let storeElement: extern "C" fn(*mut BaselineEnv, *const ValueBits, *const ValueBits, *const ValueBits, *const u8) -> u32 = baselineStoreElement
    env.helpers[u32.toUsize(STORE_ELEMENT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits, *const ValueBits, *const ValueBits, *const u8) -> u32, *const ?*const u8>(Pointer.fromRef(&storeElement)))
    env.helpers[u32.toUsize(GETTER)] = address4(baselineGetter)
    env.helpers[u32.toUsize(SETTER)] = address4(baselineSetter)
    let putVar: extern "C" fn(*mut BaselineEnv, *mut HeapHeader, u32, *const ValueBits) -> u32 = baselinePutVar
    env.helpers[u32.toUsize(PUT_VAR)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut HeapHeader, u32, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&putVar)))
    let hot: extern "C" fn(*mut BaselineEnv, *mut HeapHeader) -> () = baselineHot
    env.helpers[u32.toUsize(HOT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut HeapHeader) -> (), *const ?*const u8>(Pointer.fromRef(&hot)))
    let scope: extern "C" fn(*mut BaselineEnv, *mut engine.BaselineFrame, *mut ValueBits) -> () = baselineScope
    env.helpers[u32.toUsize(SCOPE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut engine.BaselineFrame, *mut ValueBits) -> (), *const ?*const u8>(Pointer.fromRef(&scope)))
    let constructFast: extern "C" fn(*mut BaselineEnv, *mut ValueBits, u32, *mut ValueBits) -> u32 = baselineConstructFast
    env.helpers[u32.toUsize(CONSTRUCT_FAST)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&constructFast)))
    let getPrivate: extern "C" fn(*mut BaselineEnv, *mut ValueBits) -> u32 = baselineGetPrivate
    env.helpers[u32.toUsize(GET_PRIVATE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getPrivate)))
    let putPrivate: extern "C" fn(*mut BaselineEnv, *mut ValueBits) -> u32 = baselinePutPrivate
    env.helpers[u32.toUsize(PUT_PRIVATE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&putPrivate)))
    let concatPrim: extern "C" fn(*mut BaselineEnv, *const ValueBits, *const ValueBits, *mut ValueBits, u32) -> u32 = baselineConcatPrim
    env.helpers[u32.toUsize(CONCAT_PRIM)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits, *const ValueBits, *mut ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&concatPrim)))
    return env
  }
}

/// env's element site cache (engine.elementIndex picks the entry).
unsafe fn sitesOf(env: *mut BaselineEnv) -> *mut engine.ElementSite {
  let mut anchor = ()
  let state = unsafe Pointer.borrowMut<(), BaselineEnv>(&mut anchor, env)
  return Pointer.fromMutRef<engine.ElementSite>(&mut state.elements[0])
}
unsafe fn runtimeOf(env: *mut BaselineEnv) -> *mut HeapHeader {
  let anchor = ()
  let state = unsafe Pointer.borrow<(), BaselineEnv>(&anchor, env)
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(state.runtime)
}

export "C" fn baselineHot(env: *mut BaselineEnv, bytecode: *mut HeapHeader) -> () {
  unsafe engine.countLeaf(bytecode)
}
export "C" fn baselineScope(env: *mut BaselineEnv, record: *mut engine.BaselineFrame, storage: *mut ValueBits) -> () {
  unsafe engine.beginScope(record, storage)
}
export "C" fn baselineRelease(env: *mut BaselineEnv, value: *const ValueBits) -> () {
  unsafe engine.release(unsafe Pointer.read<ValueBits>(value))
}
struct PendingSiteShape {
  valid: bool,
  key: u64,
  protoKey: u64,
  holder: ?*mut HeapHeader,
  first: ?*mut HeapHeader,
  epoch: u64,
}
impl Copy for PendingSiteShape {}

unsafe fn probeBaselineFieldShape(rt: *mut HeapHeader, ip: *const u8, receiver: ValueBits, isWrite: bool, checkRc: bool) -> PendingSiteShape {
  let empty = PendingSiteShape { valid: false, key: 0, protoKey: 0, holder: Pointer.null<HeapHeader>(), first: Pointer.null<HeapHeader>(), epoch: 0 }
  let object = match receiver {
    ValueBits.Object { reference } => reference
    _ => { return empty }
  }
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  if Pointer.isNull<census.SiteShapes>(state.compiled.siteShapes) { return empty }
  let epoch = state.shapeEpoch
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let shape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)
  let version = shape.version
  if version == 0 || version >= 2147483648 { return empty }
  let atom = unsafe Pointer.readUnaligned<u32>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u32>(ip))
  let poly = &state.polyFields[census.polyFieldIndex(version, atom)]
  if poly.version != version || poly.atom != atom { return empty }
  let kind = poly.kind
  let exotic = data.isExotic()
  let valid = if exotic {
    u32.shiftRight(kind, 8) == data.classId() && (data.classId() != classes.JS_CLASS_ARRAY || data.fastArray())
  } else { kind <= 0xff }
  if !valid { return empty }
  let answer = kind & 0x7f
  let index = u64.toUsize(poly.stamp & 0xffff)
  if answer == census.POLY_OWN {
    if isWrite {
      if !shape.isHashed || (kind & census.POLY_WRITABLE) == 0 { return empty }
      let inlineKey = unsafe Pointer.readUnaligned<u64>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(ip), 4)))
      if inlineKey != (u64.shiftLeft(version, 16) | usize.toU64(index)) { return empty }
    }
    return PendingSiteShape {
      valid: true,
      key: u64.shiftLeft(version, 16) | usize.toU64(index),
      protoKey: 0,
      holder: Pointer.null<HeapHeader>(),
      first: Pointer.null<HeapHeader>(),
      epoch: 0,
    }
  }
  if !isWrite && answer == census.POLY_PROTO && u64.shiftRight(poly.stamp, 16) == epoch {
    let holder = match Pointer.nonNullMut<HeapHeader>(poly.holder) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return empty }
    }
    if checkRc {
      let holderHeader = unsafe Pointer.borrow<(), HeapHeader>(&anchor, holder)
      if holderHeader.referenceCount <= 1 { return empty }
    }
    let holderData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, holder)
    let holderShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, holderData.shape)
    let holderVersion = holderShape.version
    if holderVersion == 0 || holderVersion >= 2147483648 { return empty }
    let key = u64.shiftLeft(version, 16) | census.FIELD_PROTO_KEY
    let protoKey = u64.shiftLeft(holderVersion, 16) | usize.toU64(index)
    if Pointer.address<HeapHeader>(shape.prototype) == Pointer.address<HeapHeader>(holder) {
      return PendingSiteShape {
        valid: true,
        key: key,
        protoKey: protoKey,
        holder: poly.holder,
        first: Pointer.null<HeapHeader>(),
        epoch: epoch,
      }
    }
    if let Option<*mut HeapHeader>.Some { value: first } = Pointer.nonNullMut<HeapHeader>(shape.prototype) {
      if checkRc {
        let firstHeader = unsafe Pointer.borrow<(), HeapHeader>(&anchor, first)
        if firstHeader.referenceCount <= 1 { return empty }
      }
      let firstData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, first)
      let firstShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, firstData.shape)
      if Pointer.address<HeapHeader>(firstShape.prototype) == Pointer.address<HeapHeader>(holder) {
        return PendingSiteShape {
          valid: true,
          key: key,
          protoKey: protoKey,
          holder: poly.holder,
          first: shape.prototype,
          epoch: epoch,
        }
      }
    }
  }
  return empty
}

unsafe fn commitBaselineFieldShape(rt: *mut HeapHeader, ip: *const u8, pending: PendingSiteShape) -> () {
  if !pending.valid { return () }
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let table = match Pointer.nonNullMut<census.SiteShapes>(state.compiled.siteShapes) {
    Option<*mut census.SiteShapes>.Some { value } => value
    Option<*mut census.SiteShapes>.None => { return () }
  }
  if pending.epoch != 0 && state.shapeEpoch != pending.epoch { return () }
  let mask = state.compiled.siteShapeMask
  drop state
  unsafe census.noteSiteShape(table, mask, Pointer.address<u8>(ip), pending.key, pending.protoKey, pending.holder, pending.first, pending.epoch)
}

unsafe fn objectShapeVersion(value: ValueBits) -> u64 {
  let object = match value {
    ValueBits.Object { reference } => reference
    _ => { return 0 }
  }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).version
}

export "C" fn baselineGetField(env: *mut BaselineEnv, ip: *const u8, cell: *const ValueBits, out: *mut ValueBits) -> u32 {
  let rt = unsafe runtimeOf(env)
  if unsafe engine.readField(rt, ip, cell, out) {
    let pending = unsafe probeBaselineFieldShape(rt, ip, unsafe Pointer.read<ValueBits>(cell), false, false)
    unsafe commitBaselineFieldShape(rt, ip, pending)
    return 1
  }
  return 0
}
export "C" fn baselineGetFieldTop(env: *mut BaselineEnv, ip: *const u8, cell: *mut ValueBits) -> u32 {
  let rt = unsafe runtimeOf(env)
  let pending = unsafe probeBaselineFieldShape(rt, ip, unsafe Pointer.read<ValueBits>(cell), false, true)
  if unsafe engine.readFieldTop(rt, ip, cell) {
    unsafe commitBaselineFieldShape(rt, ip, pending)
    return 1
  }
  return 0
}
export "C" fn baselineGetField2(env: *mut BaselineEnv, ip: *const u8, cell: *const ValueBits, out: *mut ValueBits, bytecode: *mut HeapHeader) -> u32 {
  let rt = unsafe runtimeOf(env)
  if unsafe engine.readFieldCached(rt, ip, cell, out, bytecode) {
    let pending = unsafe probeBaselineFieldShape(rt, ip, unsafe Pointer.read<ValueBits>(cell), false, false)
    unsafe commitBaselineFieldShape(rt, ip, pending)
    return 1
  }
  return 0
}
export "C" fn baselineLength(env: *mut BaselineEnv, source: *const ValueBits, out: *mut ValueBits) -> u32 {
  if unsafe engine.lengthOf(unsafe runtimeOf(env), source, out) { return 1 }
  return 0
}
export "C" fn baselinePutField(env: *mut BaselineEnv, ip: *const u8, target: *const ValueBits, source: *mut ValueBits, pops: u32) -> u32 {
  let rt = unsafe runtimeOf(env)
  let receiver = unsafe Pointer.read<ValueBits>(target)
  let beforeVersion = unsafe objectShapeVersion(receiver)
  // The site's inline key as the last store left it: an add's, a store's, or none.
  let last = unsafe engine.fieldSiteKind(ip)
  if unsafe engine.writeField(rt, ip, target, source, pops != 0) {
    if beforeVersion != 0 && unsafe objectShapeVersion(receiver) == beforeVersion {
      let pending = unsafe probeBaselineFieldShape(rt, ip, receiver, true, false)
      unsafe commitBaselineFieldShape(rt, ip, pending)
      if last == engine.FIELD_SITE_ADD { unsafe noteTurn(env, ip) }
    } else if beforeVersion != 0 && last == engine.FIELD_SITE_STORE { unsafe noteTurn(env, ip) }
    return 1
  }
  return 0
}
export "C" fn baselineGetVar(env: *mut BaselineEnv, function: *mut HeapHeader, index: u32, out: *mut ValueBits) -> u32 {
  if unsafe engine.readVariable(function, index, out) { return 1 }
  return 0
}
export "C" fn baselineEqual(env: *mut BaselineEnv, left: *mut ValueBits, right: *const ValueBits, how: u32) -> u32 {
  if unsafe engine.equal(left, right, (how & 1) != 0, (how & 2) != 0) { return 1 }
  return 0
}
export "C" fn baselineTruthy(env: *mut BaselineEnv, cell: *const ValueBits) -> u32 {
  if unsafe engine.truthy(cell) { return 1 }
  return 0
}
/// mode is one of the engine's ELEMENT_* or 0; unused is whatever the fourth register held.
export "C" fn baselineGetElement(env: *mut BaselineEnv, ip: *const u8, cell: *mut ValueBits, unused: *mut ValueBits, mode: u32) -> u32 {
  unsafe noteMiss(env, ip, cell, unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(cell), 1))
  if unsafe engine.readElement(unsafe runtimeOf(env), cell, mode, Pointer.address<u8>(ip), unsafe sitesOf(env)) { return 1 }
  return 0
}
export "C" fn baselineElementOf(env: *mut BaselineEnv, object: *const ValueBits, key: *const ValueBits, out: *mut ValueBits, ip: *const u8) -> u32 {
  unsafe noteMiss(env, ip, object, key)
  if unsafe engine.elementOf(unsafe runtimeOf(env), object, key, out, Pointer.address<u8>(ip), unsafe sitesOf(env)) { return 1 }
  return 0
}
export "C" fn baselineGetter(env: *mut BaselineEnv, ip: *const u8, cell: *const ValueBits, out: *mut ValueBits) -> u32 {
  unsafe noteSite(env, ip)
  if unsafe engine.getterOf(unsafe runtimeOf(env), ip, cell, out) { return 1 }
  return 0
}
export "C" fn baselineSetter(env: *mut BaselineEnv, ip: *const u8, cell: *const ValueBits, out: *mut ValueBits) -> u32 {
