//! Tests of the number part of the SSA form (docs/jit/doubles.md): golden IR of functions with
//! doubles and the int32 operators, with and without double sites from an earlier deopt.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.io.writer_native { StderrWriter }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.js_engine { Engine }
import silkjs.js_engine_no_host { NoHostServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_owned_value { Value }
import silkjs.js_realm { lendRealm }
import silkjs.js_object_ref { ObjectRef }
import silkjs.js_exceptions { JsException }
import silkjs.js_runtime as runtime
import silkjs.js_gc as gc
import silkjs.js_eval as eval
import silkjs.js_intrinsic_install as intrinsics
import silkjs.native_stack as stack
import ssa_input { inputOf }
import ssa_translate { translate, Refusal }
import ssa_verify { verify, VerifyError }
import ssa_ownership

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 }
  return true
}
effect fn say(out: &mut List<u8>, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator { run out.appendSlice(bytes) }

unsafe effect fn describe<'m>(engine: &mut Engine<'m, NoHostServices>, context: *mut HeapHeader, source: &[u8], sites: &[u32], out: &mut List<u8>) -> ()
  ! JsException | OutOfMemoryError ? &mut Allocator {
  let memory = engine.memory
  let result = run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"ssa.js", 0)
  match ObjectRef.of(result.borrow()).functionCode() {
    Option.Some { value: cell } => {
      let anchor = ()
      let mut input = run inputOf(cell.get(&anchor))
      run input.doubleSites.appendSlice(sites)
      match move run Effect.result(translate(&input)) {
        Result.Success { value: translated } => {
          let mut f = move translated
          run ssa_ownership.optimize(&mut f)
          match move run Effect.result(verify(&f)) {
            Result.Success { .. } => { run f.print(&mut out) }
            Result.Failure { error } => {
              match move error {
                VerifyError { reason, .. } => { run say(&mut out, b"verify: ") run say(&mut out, reason) run f.print(&mut out) }
                OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
              }
            }
          }
        }
        Result.Failure { error } => {
          match move error {
            Refusal { reason, .. } => { run say(&mut out, b"refused: ") run say(&mut out, reason) }
            OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
          }
        }
      }
    }
    Option.None => { run say(&mut out, b"not a function") }
  }
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), Value.intoBits(move result))
}

/// The optimized, verified SSA text of the function `source` evaluates to, translated with
/// `sites` as double sites.
pub effect fn numberSsaOf(source: &[u8], sites: &[u32]) -> List<u8> ! OutOfMemoryError | SynchronizationError | JsException {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: NoHostServices {} }
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut out = List<u8>.make()
  let checked = run Effect.result(unsafe describe(&mut engine, context, source, sites, &mut out)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), JsException | OutOfMemoryError>.Success { value: _ } => ()
    Result<(), JsException | OutOfMemoryError>.Failure { error } => { fail move error }
  }
  return move out
}

/// Whether the IR of `source` is `expected`; prints both when not.
effect fn matches(source: &[u8], sites: &[u32], expected: &[u8]) -> bool ! OutOfMemoryError | SynchronizationError | JsException {
  let got = run numberSsaOf(source, sites)
  if !same(got.asSlice(), expected) {
    StderrWriter.print("{}\n--- got:\n{}\n--- expected:\n{}\n", &.(unsafe String.fromUtf8Unchecked(source),
      unsafe String.fromUtf8Unchecked(got.asSlice()), unsafe String.fromUtf8Unchecked(expected)))
    return false
  }
  return true
}

const NUMBERS_0: &[u8] = b"""b0:
  v0: value borrowed(arg 0) = arg 0   @0
  v1: f64 = const.f64 #0   @12
  jump b1()   @0
b1:
  v2: i32 = const.i32 0   @0
  v3: i32 = unbox.i32 v0 exit e0   @11
  v4: bool = lt.i32 v2, v3   @11
  branch v4, b2(v1, v2), b4(v1)   @12
b2(v5: f64, v6: i32):
  v7: f64 = f64 v6   @15
  v8: f64 = add.f64 v5, v7   @15
  v9: i32 = const.i32 1   @22
  v10: i32 = add.i32 v6, v9 exit e1   @22
  v11: bool = lt.i32 v10, v3   @26
  branch v11, b3(), b4(v8)   @27
b3:
  poll exit e2   @27
  jump b2(v8, v10)   @27
b4(v12: f64):
  v13: value imm = box.f64 v12   @29
  return v13   @30
e0: pc 11 locals [int v2, int v2] stack [int v2, dup v0 (arg 0)]
e1: pc 22 locals [f64 v8, int v6] stack []
e2: pc 14 locals [f64 v8, int v10] stack []
"""
const NUMBERS_1: &[u8] = b"""b0:
  v0: value borrowed(arg 0) = arg 0   @0
  v1: f64 = const.f64 #1   @12
  v2: f64 = const.f64 #0   @16
  jump b1()   @0
b1:
  v3: i32 = const.i32 0   @0
  v4: i32 = unbox.i32 v0 exit e0   @11
  v5: bool = lt.i32 v3, v4   @11
  branch v5, b2(v1, v3), b4(v1)   @12
b2(v6: f64, v7: i32):
  v8: f64 = f64 v7   @18
  v9: f64 = mul.f64 v8, v2   @18
  v10: f64 = add.f64 v6, v9   @19
  v11: i32 = const.i32 1   @26
  v12: i32 = add.i32 v7, v11 exit e1   @26
  v13: bool = lt.i32 v12, v4   @30
  branch v13, b3(), b4(v10)   @31
b3:
  poll exit e2   @31
  jump b2(v10, v12)   @31
b4(v14: f64):
  v15: value imm = box.f64 v14   @33
  return v15   @34
e0: pc 11 locals [int v3, int v3] stack [int v3, dup v0 (arg 0)]
e1: pc 26 locals [f64 v10, int v7] stack []
e2: pc 14 locals [f64 v10, int v12] stack []
"""
const NUMBERS_2: &[u8] = b"""b0:
  v0: value borrowed(arg 0) = arg 0   @0
  v1: value borrowed(arg 1) = arg 1   @0
  jump b1()   @0
b1:
  v2: f64 = unbox.f64 v0 exit e0   @2
  v3: f64 = unbox.f64 v1 exit e1   @2
  v4: f64 = div.f64 v2, v3   @2
  v5: value imm = box.f64 v4   @3
  return v5   @3
e0: pc 2 locals [] stack [dup v0 (arg 0), dup v1 (arg 1)]
e1: pc 2 locals [] stack [dup v0 (arg 0), dup v1 (arg 1)]
"""
const NUMBERS_3: &[u8] = b"""b0:
  v0: value borrowed(arg 0) = arg 0   @0
  v1: value borrowed(arg 1) = arg 1   @0
  jump b1()   @0
b1:
  v2: i32 = unbox.i32 v0 exit e0   @2
  v3: i32 = unbox.i32 v1 exit e1   @2
  v4: i32 = and.i32 v2, v3   @2
  v5: i32 = xor.i32 v2, v3   @5
  v6: i32 = or.i32 v4, v5   @6
  v7: i32 = const.i32 3   @8
  v8: i32 = shl.i32 v2, v7   @8
  v9: i32 = add.i32 v6, v8 exit e2   @11
  v10: i32 = const.i32 1   @13
  v11: i32 = sar.i32 v2, v10   @13
  v12: i32 = add.i32 v9, v11 exit e3   @16
  v13: i32 = const.i32 2   @18
  v14: i32 = shr.i32 v2, v13 exit e4   @20
  v15: i32 = add.i32 v12, v14 exit e5   @21
  v16: i32 = const.i32 7   @23
  v17: i32 = mod.i32 v2, v16 exit e6   @25
  v18: i32 = add.i32 v15, v17 exit e7   @26
  v19: i32 = not.i32 v2   @28
  v20: i32 = add.i32 v18, v19 exit e8   @29
  v21: value imm = box.i32 v20   @30
  return v21   @30
e0: pc 2 locals [] stack [dup v0 (arg 0), dup v1 (arg 1)]
e1: pc 2 locals [] stack [dup v0 (arg 0), dup v1 (arg 1)]
e2: pc 11 locals [] stack [int v6, int v8]
e3: pc 16 locals [] stack [int v9, int v11]
e4: pc 20 locals [] stack [int v12, dup v0 (arg 0), int v13]
e5: pc 21 locals [] stack [int v12, int v14]
e6: pc 25 locals [] stack [int v15, dup v0 (arg 0), int v16]
e7: pc 26 locals [] stack [int v15, int v17]
e8: pc 29 locals [] stack [int v18, int v19]
"""
const NUMBERS_4: &[u8] = b"""b0:
  v0: value borrowed(arg 0) = arg 0   @0
  jump b1()   @0
b1:
  v1: bool = truthy v0   @1
  branch v1, b3(), b2()   @1
b2:
  v2: i32 = unbox.i32 v0 exit e0   @4
  v3: i32 = neg.i32 v2 exit e1   @4
  v4: value imm = box.i32 v3   @5
  return v4   @5
b3:
  v5: i32 = unbox.i32 v0 exit e2   @7
  v6: value imm = box.i32 v5   @8
  return v6   @8
e0: pc 4 locals [] stack [dup v0 (arg 0)]
e1: pc 4 locals [] stack [dup v0 (arg 0)]
e2: pc 7 locals [] stack [dup v0 (arg 0)]
"""
const NUMBERS_5: &[u8] = b"""b0:
  v0: value borrowed(arg 0) = arg 0   @0
  jump b1()   @0
b1:
  v1: i32 = unbox.i32 v0 exit e0   @1
  v2: i32 = const.i32 3   @1
  v3: bool = eq.i32 v1, v2   @1
  branch v3, b3(), b2()   @3
b2:
  v4: i32 = const.i32 0   @7
  v5: value imm = box.i32 v4   @8
  return v5   @8
b3:
  v6: i32 = const.i32 1   @5
  v7: value imm = box.i32 v6   @6
  return v7   @6
e0: pc 1 locals [] stack [dup v0 (arg 0)]
"""
const NUMBERS_7: &[u8] = b"""b0:
  v0: value borrowed(arg 0) = arg 0   @0
  jump b1()   @0
b1:
  v1: i32 = const.i32 0   @0
  v2: i32 = unbox.i32 v0 exit e0   @6
  v3: bool = lt.i32 v1, v2   @6
  branch v3, b2(v1, v1), b6(v1)   @7
b2(v4: i32, v5: i32):
  v6: i32 = const.i32 10   @15
  v7: bool = gt.i32 v5, v6   @17
  branch v7, b3(), b4(v4)   @18
b3:
  v8: i32 = const.i32 1   @20
  v9: i32 = add.i32 v4, v8 exit e1   @21
  jump b4(v9)   @21
b4(v10: i32):
  v11: i32 = const.i32 1   @28
  v12: i32 = add.i32 v5, v11 exit e2   @28
  v13: bool = lt.i32 v12, v2   @32
  branch v13, b5(), b6(v10)   @33
b5:
  poll exit e3   @33
  jump b2(v10, v12)   @33
b6(v14: i32):
  v15: value imm = box.i32 v14   @35
  return v15   @36
e0: pc 6 locals [int v1, int v1] stack [int v1, dup v0 (arg 0)]
e1: pc 21 locals [int v4, int v5] stack [int v8]
e2: pc 28 locals [int v10, int v5] stack []
e3: pc 9 locals [int v10, int v12] stack []
"""
const NUMBERS_6: &[u8] = b"""b0:
  v0: value borrowed(arg 0) = arg 0   @0
  jump b1()   @0
b1:
  v1: value owned = retain v0   @0
  v2: bool = truthy v1   @1
  branch v2, b4(v1), b2()   @1
b2:
  release v1   @1
  jump b3()   @1
b3:
  v3: i32 = const.i32 5   @5
  v4: value imm = box.i32 v3   @5
  jump b4(v4)   @5
b4(v5: value owned):
  return v5   @7
"""

const NUMBERS_8: &[u8] = b"""b0:
  v0: f64 = const.f64 #0   @0
  jump b1()   @0
b1:
  v1: f64 = neg.f64 v0   @2
  v2: value imm = box.f64 v1   @3
  return v2   @3
"""

const NONE_SITES: [u32; 1] = [4294967295]
/// The add of s and i in sum (offset 15).
const SUM_SITES: [u32; 1] = [15]

test effect fn goldenNumbers() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut ok = true
  ok = (run matches(b"function h(n){var s=0;for(var i=0;i<n;i++)s+=i*0.5;return s} h(3); h", &NONE_SITES, NUMBERS_1)) && ok
  ok = (run matches(b"function q(a,b){return a/b} q(1,2); q", &NONE_SITES, NUMBERS_2)) && ok
  ok = (run matches(b"function b(x,y){return ((x&y)|(x^y))+(x<<3)+(x>>1)+(x>>>2)+(x%7)+(~x)} b(1,2); b", &NONE_SITES, NUMBERS_3)) && ok
  ok = (run matches(b"function z(x){if(!x)return -x;return +x} z(1); z", &NONE_SITES, NUMBERS_4)) && ok
  ok = (run matches(b"function t(x){return x===3?1:0} t(1); t", &NONE_SITES, NUMBERS_5)) && ok
  ok = (run matches(b"function o(x){return x||5} o(1); o", &NONE_SITES, NUMBERS_6)) && ok
  // A counter updated on one branch only: its header and merge parameters unbox together.
  ok = (run matches(b"function w(n){var c=0;for(var i=0;i<n;i++){if(i>10)c=c+1}return c} w(3); w", &NONE_SITES, NUMBERS_7)) && ok
  // A double constant in a function whose entry block is only a jump (it moves there).
  ok = (run matches(b"function m(a,b){return -2147483648} m(1,2); m", &NONE_SITES, NUMBERS_8)) && ok
  run Testing.expect(ok, "golden number IR")
}

test effect fn goldenDoubleSites() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut ok = true
  ok = (run matches(b"function sum(n){var s=0;for(var i=0;i<n;i++)s+=i;return s} sum(3); sum", &SUM_SITES, NUMBERS_0)) && ok
  run Testing.expect(ok, "golden IR with double sites")
}
