//! The web targets' pages: [`site`] puts a page, its program and the scripts that load it into
//! one folder that any static file server can serve, and [`Server`] serves that folder while
//! `dev` runs.
import stylesheets
import manifest { Project }
import silk.num.u32
import silk.build.graph { Build, BuildError, Package, Deferred, Step, Key, Make }
import silk.build.step { StepFailure, StepError }
import silk.build.publish as Publish
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput }
import silk.text.string { String, InvalidUtf8 }
import silk.num.usize

effect fn joined(base: string, child: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = run String.copy(base)
  if !String.endsWith(base, "/") {
    run String.append(&mut out, "/")
  }
  run String.append(&mut out, child)
  return move out
}

/// `text` with every `from` replaced by `to`.
effect fn replaced(text: string, from: string, to: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = String.make()
  let mut rest = text
  while true {
    match String.find(rest, from) {
      Option<usize>.Some { value: at } => {
        run String.append(&mut out, String.slice(rest, 0, at))
        run String.append(&mut out, to)
        let skip = at + String.utf8Bytes(from).length
        rest = String.slice(rest, skip, String.utf8Bytes(rest).length - skip)
      }
      Option<usize>.None => {
        break
      }
    }
  }
  run String.append(&mut out, rest)
  return move out
}

struct Asset {
  name: String,
  input: Deferred<Path>,
  scripts: bool
}

struct PageFiles {
  assets: List<Asset>
}

impl Step for PageFiles {
  effect fn key(self: &Self, key: &mut Key) -> ()
    ! StepFailure
    ? &mut Allocator {
    let assets = self.assets.asSlice()
    let mut at: usize = 0
    while at < assets.length {
      run key.text(assets[at].name.view())
      run key.bytes(
        if assets[at].scripts {
          b"rewrite-typescript"
        } else {
          b"copy"
        },
      )
      run key.file(&assets[at].input)
      at = at + 1
    }
  }

  effect fn make(self: &Self, make: &mut Make) -> ()
    ! StepFailure
    ? &mut Allocator {
    let assets = self.assets.asSlice()
    let mut at: usize = 0
    while at < assets.length {
      let asset = &assets[at]
      let bytes = run make.read(&asset.input)
      let output = run joined("site", asset.name.view())
      if asset.scripts {
        let text = match move String.fromUtf8(bytes.asSlice()) {
          Result<string, InvalidUtf8>.Success { value } => value
          Result<string, InvalidUtf8>.Failure { .. } => {
            fail StepError { message: run String.copy("a browser script must contain valid UTF-8") }
          }
        }
        let first = run replaced(text, "/host.ts'", "/host.js'")
        let fixed = run replaced(first.view(), "/generated_schema.ts'", "/generated_schema.js'")
        run make.write(output.view(), String.ownedUtf8Bytes(&fixed))
      } else {
        run make.write(output.view(), bytes.asSlice())
      }
      at = at + 1
    }
  }
}

effect fn asset(
  files: &mut List<Asset>,
  alias: string,
  source: string,
  destination: string,
  scripts: bool,
) -> ()
  ! StepFailure
  ? &mut Allocator | &mut FileSystem | &mut HostInput {
  return run files.append(
    Asset {
      name: run String.copy(destination),
      input: run Package.path(alias, source),
      scripts: scripts,
    },
  )
}

/// Assembles a page from the program and explicitly declared package resources.
/// Every script is a deferred `Package.path` input, so only required packages are fetched.
/// `host` holds the page and the compiled stylesheets: a web-dom page links its `sheetCount`
/// CSS files, and a development canvas page fetches its stylesheet updates.
pub effect fn site(
  project: &Project,
  target: string,
  host: string,
  wasm: string,
  dir: string,
  sheetCount: usize,
  dev: bool,
) -> ()
  ! BuildError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let _project = project
  let mut assets = List<Asset>.make()
  let html = run joined(host, "index.html")
  run assets.append(
    Asset {
      name: run String.copy("index.html"),
      input: run Deferred<Path>.external(html.view()),
      scripts: false,
    },
  )
  run assets.append(
    Asset {
      name: run String.copy("app.wasm"),
      input: run Deferred<Path>.external(wasm),
      scripts: false,
    },
  )
  if target == "web-dom" {
    let mut sheet: usize = 0
    while sheet < sheetCount {
      let name = run stylesheets.name(sheet, true)
      let file = run joined(host, name.view())
      run assets.append(
        Asset { name: move name, input: run Deferred<Path>.external(file.view()), scripts: false },
      )
      sheet = sheet + 1
    }
    run asset(&mut assets, "loom_dom", "js/silk-ui-dom.js", "silk-ui-dom.js", false)
  } else {
    if dev && sheetCount != 0 {
      let update = run joined(host, "styles.update")
      run assets.append(
        Asset {
          name: run String.copy("styles.update"),
          input: run Deferred<Path>.external(update.view()),
          scripts: false,
        },
      )
      run asset(
        &mut assets,
        "ui_tree_window",
        "browser/style-updates.mjs",
        "ui/tree/window/browser/style-updates.mjs",
        false,
      )
    }
    run asset(
      &mut assets,
      "ui_tree_window",
      "browser/media.mjs",
      "ui/tree/window/browser/media.mjs",
      false,
    )
    run asset(
      &mut assets,
      "ui_tree_window",
      "browser/sheet-fetch.mjs",
      "ui/tree/window/browser/sheet-fetch.mjs",
      false,
    )
    run asset(
      &mut assets,
      "ui_tree_window",
      "browser/app-host.js",
      "ui/tree/window/browser/app-host.js",
      true,
    )
    run asset(
      &mut assets,
      "ui_tree_window",
      "browser/access-mirror.js",
      "ui/tree/window/browser/access-mirror.js",
      false,
    )
    let names = ["window-host.js", "imports.js", "keys.js"]
    let mut at: usize = 0
    while at < names.length {
      let source = run joined("browser", names[at])
      let destination = run joined("native/platform/window/browser", names[at])
      run asset(&mut assets, "platform_window", source.view(), destination.view(), false)
      at = at + 1
    }
    run asset(&mut assets, "webgpu", "browser/host.ts", "native/gpu/webgpu/browser/host.js", true)
    run asset(
      &mut assets,
      "webgpu",
      "browser/generated_schema.ts",
      "native/gpu/webgpu/browser/generated_schema.js",
      false,
    )
  }
  let step = run Step.register(PageFiles { assets: move assets })
  let graph = run (run Build.make()).addStep(move step, "site")
  let built = run graph.compile()
  return run Publish.copy(&built.artifacts.asSlice()[0].path, &run Path.make(dir))
}

static if Intrinsic.targetOperatingSystem() == "darwin"
  || Intrinsic.targetOperatingSystem() == "linux" {
  import silk.net.address { Endpoint, IpAddress, Ipv4Address, Port }
  import silk.net.socket_native {
    Accepted,
    BoundAddress,
    Connection,
    Incoming,
    Listener,
    ListenOptions,
    NativeSocketError,
    Received,
    Sent,
    listen
  }
  import silk.num.i32
  import silk.num.u8
  import silk.num.u16
  import silk.num.u64
  import silk.system.monotonic_clock { MonotonicClock, ReadyWatch }
  import silk.system.monotonic_clock_native { OsMonotonicClock }
  import silk.time.mark { Mark }

  struct Client {
    socket: Connection,
    request: Bytes,
    header: Bytes,
    body: Bytes,
    sent: usize,
    ready: bool
  }

  /// A static file server for one folder, on the loopback address. `/__silkui/build` answers
  /// the build number, which a `Mode.Dev` page polls to reload after a rebuild.
  pub struct Server {
    listener: Listener,
    clients: List<Client>,
    root: String,
    pub build: u64,
    pub styles: u64,
  }

  effect fn socketFailure(error: NativeSocketError) -> never
    ! TaskError | OutOfMemoryError
    ? &mut Allocator {
    drop error
    run Task.abort("silkui: the page server's socket failed")
  }

  effect fn noListener(error: NativeSocketError) -> Option<Listener> {
    drop error
    return Option<Listener>.None
  }

  effect fn bound(port: u16) -> Option<Listener>
    ! NativeSocketError {
    let endpoint = Endpoint.make(
      IpAddress.V4 { value: Ipv4Address.fromOctets([127, 0, 0, 1]) },
      Port.fromU16(port),
    )
    return Option<Listener>.Some { value: run listen(endpoint, ListenOptions.defaults()) }
  }

  effect fn decimal(value: u64) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut digits = String.make()
    let mut rest = value
    if rest == 0 {
      run String.append(&mut digits, "0")
    }
    while rest > 0 {
      let mut one = run String.copy(String.slice("0123456789", u64.toUsize(rest % 10), 1))
      run String.append(&mut one, String.view(&digits))
      digits = move one
      rest = rest / 10
    }
    return move digits
  }

  impl Server {
    /// Serves `root` on port `port`, or on a port the system picks when that one is taken.
    pub effect fn open(root: string, port: u16) -> Server
      ! TaskError | OutOfMemoryError
      ? &mut Allocator {
      let mut listener = match move run Effect.catch(bound(port), noListener) {
        Option<Listener>.Some { value } => move value
        Option<Listener>.None => match move run Effect.catch(bound(0), noListener) {
          Option<Listener>.Some { value } => move value
          Option<Listener>.None => run Task.abort(
            "silkui: the page server could not listen on the loopback address",
          )
        }
      }
      let actual = match Listener.boundAddress(&listener) {
        BoundAddress.Tcp { endpoint } => Port.value(&Endpoint.port(&endpoint))
        _ => port
      }
      StderrWriter.print("silkui: serving the page on http://127.0.0.1:{}/\n", &.(actual))
      return Server {
        listener: move listener,
        clients: List<Client>.make(),
        root: run String.copy(root),
        build: 1,
        styles: 1,
      }
    }

    /// Answers requests for about `milliseconds`.
    pub effect fn serveFor(self: &mut Self, milliseconds: u64) -> ()
      ! TaskError | FileError | OutOfMemoryError
      ? &mut Allocator | &mut FileSystem {
      let mut clock = OsMonotonicClock.make()
      run Effect.catch(self.loop(milliseconds), socketFailure)
        |> Effect.provideMut<MonotonicClock>(&mut clock)
    }

    effect fn loop(self: &mut Self, milliseconds: u64) -> ()
      ! NativeSocketError | TaskError | FileError | OutOfMemoryError
      ? &mut Allocator | &mut FileSystem | &mut MonotonicClock {
      let start = run MonotonicClock.now()
      let until = Mark.make(
        start.seconds(),
        u32.toI64(start.subsecondNanoseconds()) + u64.toI64(milliseconds) * 1000000,
      )
      let mut watches = List<ReadyWatch>.make()
      while true {
        while true {
          match move (run self.listener.tryAccept()) {
            Incoming.WouldBlock => {
              break
            }
            Incoming.Client { accepted } => run self.clients.append(
              Client {
                socket: Accepted.intoConnection(move accepted),
                request: Bytes.make(),
                header: Bytes.make(),
                body: Bytes.make(),
                sent: 0,
                ready: false,
              },
            )
          }
        }
        let mut index: usize = 0
        while index < self.clients.length() {
          let finished = run Effect.catch(self.step(index), dropped)
          if finished {
            drop self.clients.remove(index)
          } else {
            index = index + 1
          }
        }
        watches.clear()
        run watches.append(ReadyWatch.forRead(i32.toUsize(self.listener.rawDescriptor())))
        let clients = self.clients.asSlice()
        index = 0
        while index < clients.length {
          let handle = i32.toUsize(clients[index].socket.rawDescriptor())
          run watches.append(
            if clients[index].ready {
              ReadyWatch.forWrite(handle)
            } else {
              ReadyWatch.forRead(handle)
            },
          )
          index = index + 1
        }
        let now = run MonotonicClock.now()
        let seconds = now.seconds()
        let ends = until.seconds()
        if seconds > ends
          || (seconds == ends && u32.toI64(now.subsecondNanoseconds()) >= u32.toI64(until.subsecondNanoseconds())) {
          return ()
        }
        drop run MonotonicClock.waitReady(
          watches.asMutSlice(),
          Option<Mark>.some(Mark.make(ends, u32.toI64(until.subsecondNanoseconds()))),
        )
      }
    }

    effect fn step(self: &mut Self, index: usize) -> bool
      ! NativeSocketError | TaskError | FileError | OutOfMemoryError
      ? &mut Allocator | &mut FileSystem {
      let root = String.view(&self.root)
      let build = self.build
      let styles = self.styles
      let client = &mut self.clients.asMutSlice()[index]
      if !client.ready {
        let mut buffer: [u8; 8192] = [0; 8192]
        match move (run client.socket.tryRead(&mut buffer)) {
          Received.End => {
            return true
          }
          Received.WouldBlock => {
            return false
          }
          Received.Data { count } => run client.request.append(Slice.view<u8>(&buffer, 0, count))
        }
        let request = match String.fromUtf8(client.request.asSlice()) {
          Result.Success { value } => run String.copy(value)
          Result.Failure { .. } => {
            return true
          }
        }
        if !String.contains(String.view(&request), "\r\n\r\n") {
          return client.request.length() > 65536
        }
        run answer(&mut client, String.view(&request), root, build, styles)
      }
      let headLength = client.header.length()
      let bodyLength = client.body.length()
      let data = if client.sent < headLength {
        Slice.view<u8>(client.header.asSlice(), client.sent, headLength - client.sent)
      } else {
        Slice.view<u8>(
          client.body.asSlice(),
          client.sent - headLength,
          bodyLength - (client.sent - headLength),
        )
      }
      match move (run client.socket.tryWrite(data)) {
        Sent.Count { count } => {
          client.sent = client.sent + count
        }
        Sent.WouldBlock => {}
      }
      return client.sent == headLength + bodyLength
    }
  }

  effect fn dropped(error: NativeSocketError) -> bool {
    // A page that navigates away cancels its requests; that ends only its connection.
    drop error
    return true
  }

  fn mime(path: string) -> string<'static> {
    if String.endsWith(path, ".html") {
      return "text/html; charset=utf-8"
    }
    if String.endsWith(path, ".js") || String.endsWith(path, ".mjs") {
      return "text/javascript"
    }
    if String.endsWith(path, ".wasm") {
      return "application/wasm"
    }
    if String.endsWith(path, ".css") {
      return "text/css"
    }
    if String.endsWith(path, ".json") {
      return "application/json"
    }
    if String.endsWith(path, ".svg") {
      return "image/svg+xml"
    }
    if String.endsWith(path, ".png") {
      return "image/png"
    }
    if String.endsWith(path, ".ttf") {
      return "font/ttf"
    }
    if String.endsWith(path, ".woff2") {
      return "font/woff2"
    }
    return "application/octet-stream"
  }

  effect fn answer(client: &mut Client, request: string, root: string, build: u64, styles: u64) -> ()
    ! TaskError | FileError | OutOfMemoryError
    ? &mut Allocator | &mut FileSystem {
    if !String.startsWith(request, "GET ") {
      run respond(&mut client, "405 Method Not Allowed", "text/plain", Bytes.make())
      return ()
    }
    let bytes = String.utf8Bytes(request)
    let mut end: usize = 4
    while end < bytes.length && bytes[end] != 32 && bytes[end] != 63 {
      end = end + 1
    }
    let path = String.slice(request, 4, end - 4)
    if path == "/__silkui/build" || path == "/__silkui/styles" {
      let number = run decimal(if path == "/__silkui/build" {
        build
      } else {
        styles
      })
      run respond(
        &mut client,
        "200 OK",
        "text/plain",
        run Bytes.copy(String.utf8Bytes(String.view(&number))),
      )
      return ()
    }

    // Paths are the page's own; anything that could leave the folder is not found.
    if !String.startsWith(path, "/") || String.contains(path, "..") || String.contains(path, "\\")
      || String.contains(path, "%") {
      run respond(&mut client, "404 Not Found", "text/plain", Bytes.make())
      return ()
    }
    let mut file = run String.copy(root)
    run String.append(&mut file, path)
    if String.endsWith(path, "/") {
      run String.append(&mut file, "index.html")
    }
    let found = run Path.make(String.view(&file))
    if !run FileSystem.exists(&found) {
      run respond(&mut client, "404 Not Found", "text/plain", Bytes.make())
      return ()
    }
    let body = run FileSystem.readFile(&found)
    if String.endsWith(String.view(&file), "/index.html") {
      // A dev page polls for a build number other than the one it was served with.
      if let Result.Success { value: text } = String.fromUtf8(body.asSlice()) {
        let number = run decimal(build)
        let numbered = run replaced(text, "__SILKUI_BUILD__", String.view(&number))
        let styleNumber = run decimal(styles)
        let page = run replaced(String.view(&numbered), "__SILKUI_STYLES__", String.view(&styleNumber))
        run respond(
          &mut client,
          "200 OK",
          "text/html; charset=utf-8",
          run Bytes.copy(String.utf8Bytes(String.view(&page))),
        )
        return ()
      }
    }
    run respond(&mut client, "200 OK", mime(String.view(&file)), move body)
  }

  effect fn respond(client: &mut Client, status: string, kind: string, body: Bytes) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let length = run decimal(usize.toU64(body.length()))
    run client.header.append(b"HTTP/1.1 ")
    run client.header.append(String.utf8Bytes(status))
    run client.header.append(b"\r\nContent-Type: ")
    run client.header.append(String.utf8Bytes(kind))
    run client.header.append(b"\r\nContent-Length: ")
    run client.header.append(String.utf8Bytes(String.view(&length)))
    run client.header.append(b"\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
    client.body = move body
    client.ready = true
  }
} else {
  /// Serving pages needs sockets Silk has on macOS and Linux only here.
  pub struct Server {
    pub build: u64,
    pub styles: u64,
  }

  impl Server {
    pub effect fn open(root: string, port: u16) -> Server
      ! TaskError | OutOfMemoryError
      ? &mut Allocator {
      run Task.abort("silkui: serving the page needs macOS or Linux")
    }

    pub effect fn serveFor(self: &mut Self, milliseconds: u64) -> ()
      ! TaskError | FileError | OutOfMemoryError
      ? &mut Allocator | &mut FileSystem {}
  }
}
