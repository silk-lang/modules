//! Synchronous system/process boundary. Results are copied before native owners drop. The facts
//! about the computer and the process (`os` and parts of `process`) come from
//! `silk.system.system_info`, with libuv's semantics, and no longer from libuv.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots, NativeErrorKind }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import libs.core.owners { Scope }
import libs.core.owners as owners
import libs.core.common as common
import silkjs.js_proxy_core as core
import silkjs.js_std_support as text
import silkjs.js_libc_platform as platform
import silkjs.js_exceptions as exceptions
import silkjs.js_runtime as runtime
import ext.fs_native as fs
import ext.os_abi as abi
import silkjs.js_std_native as stdnative
import silkjs.js_os_platform as osplatform
import silk.num.isize
import silk.net.address { IpAddress }
import ext.inet as inet
import silk.system.system_info { SystemInfo, SystemInfoError, MemoryInfo, MemoryLimit, UserInfo, UsageScope }
import silk.system.system_info_native { OsSystemInfo }
import ext.dns_abi as readiness

@foreign(noCapture: .("data"))
unsafe extern "C" fn writeDescriptor(fd: i32, data: *const u8, length: usize) -> i64 as "write"
// Complete synchronous diagnostic output without changing a shared descriptor's
// nonblocking flags. Readiness waits own no JS borrows and never enter the loop.
unsafe fn writeAllDescriptor(fd: i32, bytes: &[u8]) -> i32 {
  let mut offset: usize = 0
  let mut again: i32 = 11
  static if Intrinsic.targetOperatingSystem() == "darwin" { again = 35 }
  while offset < bytes.length {
    let count = unsafe writeDescriptor(fd, Pointer.fromRef<u8>(&bytes[offset]), bytes.length - offset)
    if count > 0 { offset = offset + i64.toUsize(count) continue }
    if count == 0 { return 5 }
    let error = unsafe platform.errno()
    if error == 4 { continue }
    if error != again { return error }
    let mut pending = readiness.PollFd { fd: fd, events: 4, revents: 0 }
    while unsafe readiness.systemPoll(Pointer.fromMutRef<readiness.PollFd>(&mut pending), 1, -1) < 0 {
      let failed = unsafe platform.errno()
      if failed != 4 { return failed }
    }
  }
  return 0
}

unsafe effect fn checked<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,code:i32,operation:&[u8])->() !OutOfMemoryError|JsException ?&mut Allocator {
  if code>=0 { return () }
  let error=run unsafe fs.error(&mut engine,context,code,operation,ValueBits.Undefined,ValueBits.Undefined)
  return run unsafe exceptions.throwValue<(),Engine<'m,S>>(&mut engine,unsafe runtime.contextRuntime(context),error)
}
unsafe effect fn posix<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,code:i32,operation:&[u8])->() !OutOfMemoryError|JsException ?&mut Allocator {
  // libuv's error code for an errno (uv_translate_sys_error on POSIX): its negation.
  if code<0 { run unsafe checked(&mut engine,context,0-unsafe platform.errno(),operation) }
}
// A SystemInfo failure, thrown as libuv's error for the operation libuv named it by.
unsafe effect fn failed<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,error:SystemInfoError,operation:&[u8])->() !OutOfMemoryError|JsException ?&mut Allocator {
  let code=if error.code>0 { 0-error.code } else if error.code<0 { error.code } else { -5 }
  run unsafe checked(&mut engine,context,code,operation)
}
// `bytes` with a NUL after them, for the C-string helpers.
effect fn terminated(bytes:&[u8])->List<u8> !OutOfMemoryError ?&mut Allocator {
  let mut out=List<u8>.make() let mut i:usize=0
  while i<bytes.length { run out.append(bytes[i]) i=i+1 }
  run out.append(0) return move out
}
unsafe effect fn pushSlice<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,bytes:&[u8])->() !OutOfMemoryError|JsException ?&mut Allocator {
  let owned=run terminated(bytes)
  run unsafe pushText(&mut engine,context,array,&mut index,text.pointer(&owned))
}
unsafe effect fn pushSliceBytes<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,bytes:&[u8])->() !OutOfMemoryError|JsException ?&mut Allocator {
  let owned=run terminated(bytes)
  run unsafe pushBytes(&mut engine,context,array,&mut index,text.pointer(&owned))
}
// An environment variable that is set and not empty (libuv's uv_os_getenv use in homedir and tmpdir).
unsafe effect fn environment(name:&[u8],into:&mut List<u8>)->bool !OutOfMemoryError ?&mut Allocator {
  let owned=run terminated(name)
  let found=unsafe stdnative.getenv(text.pointer(&owned))
  if Pointer.isNull<u8>(found) { return false }
  let many=unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*const u8,*const u8>(found)) let mut i:usize=0
  while true { let byte=unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(many,i)) if byte==0 { break } run into.append(byte) i=i+1 }
  return into.length()>0
}
unsafe effect fn number<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,value:ValueBits,min:f64,max:f64)->f64 !JsException ?&mut Allocator {
  if !value.isNumber() { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"argument must be a number") }
  let n=value.numericValue()
  if !f64.isFinite(n) || n!=f64.floor(n) || n<min || n>max { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Range,b"integer argument out of range") }
  return n
}
unsafe effect fn ctext<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,value:ValueBits)->List<u8> !OutOfMemoryError|JsException ?&mut Allocator {
  if !value.isString() { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"argument must be a string") }
  let mut bytes=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(value))
  let mut i:usize=0 while i<bytes.length() { if bytes.asSlice()[i]==0 { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"argument contains a null byte") } i=i+1 }
  run bytes.append(0) return move bytes
}
unsafe effect fn push<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,value:ValueBits)->() !JsException ?&mut Allocator {
  run unsafe common.defineIndex(&mut engine,context,array,index.*,value) index.*=index.*+1
}
unsafe effect fn pushText<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,p:*const u8)->() !JsException ?&mut Allocator {
  let value=run text.cstring(&mut engine,unsafe lendRealm(&context, context),p)
  run unsafe push(&mut engine,context,array,&mut index,value.intoBits())
}
unsafe effect fn byteBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,p:*const u8)->() !JsException ?&mut Allocator {
  let bytes=unsafe Pointer.assumeMany<u8>(p) let mut index:u32=0
  while true {
    let byte=unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes,u32.toUsize(index)))
    if byte==0 { return () }
    run unsafe push(&mut engine,context,array,&mut index,ValueBits.Int { value:u8.toI32(byte) })
  }
}
unsafe effect fn pushBytes<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,index:&mut u32,p:*const u8)->() !JsException ?&mut Allocator {
  let memory=engine.memory let value=run unsafe common.array(&mut engine,memory,context)
  let outcome=run Effect.result(unsafe byteBody(&mut engine,context,value,p))
  match move outcome {
    Result<(),JsException>.Success { .. }=>{ run unsafe push(&mut engine,context,array,&mut index,value) }
    Result<(),JsException>.Failure { error }=>{ unsafe owners.release(&mut engine,context,value) fail move error }
  }
}
// The strings of a JS array, each NUL-terminated for a C vector.
unsafe effect fn textList<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,scope:&mut Scope)->List<List<u8>> !OutOfMemoryError|JsException ?&mut Allocator {
  scope.values[4]=run unsafe common.get(&mut engine,context,array,b"length")
  let count=f64.toI32(run unsafe number(&mut engine,context,scope.values[4],0.0,2147483647.0))
  unsafe owners.release(&mut engine,context,scope.take(4))
  let mut result=List<List<u8>>.make() let mut i:i32=0
  while i<count {
    scope.values[5]=run unsafe owners.getIndex(&mut engine,context,array,i32.toU32(i))
    let entry=run unsafe ctext(&mut engine,context,scope.values[5])
    unsafe owners.release(&mut engine,context,scope.take(5))
    run result.append(move entry) i=i+1
  }
  return move result
}
// Pointers to each entry of texts, then a null pointer, for execve.
effect fn cVector(texts:&List<List<u8>>)->List<?[*]const u8> !OutOfMemoryError ?&mut Allocator {
  let mut result=List<?[*]const u8>.make() let mut i:usize=0
  while i<texts.length() { run result.append(Pointer.fromSlice<u8>(texts.asSlice()[i].asSlice())) i=i+1 }
  unsafe { run result.append(Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(Pointer.null<u8>())) }
  return move result
}
// os.hostname, os.homedir, os.tmpdir and process.execPath, as libuv answers them: homedir is
// HOME when it is set, else the user's home; tmpdir is TMPDIR, TMP, TEMP or TEMPDIR, else /tmp,
// without a trailing slash.
unsafe effect fn stringResult<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,op:&[u8])->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let mut info=OsSystemInfo.make()
  let mut out=List<u8>.make()
  if fs.equal(op,b"tmpdir") {
    let mut found=run unsafe environment(b"TMPDIR",&mut out)
    if !found { out.clear() found=run unsafe environment(b"TMP",&mut out) }
    if !found { out.clear() found=run unsafe environment(b"TEMP",&mut out) }
    if !found { out.clear() found=run unsafe environment(b"TEMPDIR",&mut out) }
    if !found { out.clear() run out.append(47) run out.append(116) run out.append(109) run out.append(112) }
    if out.length()>1 && out.asSlice()[out.length()-1]==47 { let _last=out.pop() }
  } else if fs.equal(op,b"homedir") {
    if !run unsafe environment(b"HOME",&mut out) {
      out.clear()
      let got=run Effect.result(SystemInfo.currentUser()) |> Effect.provideMut<SystemInfo>(&mut info)
      match move got {
        Result.Success { value }=>{ let home=value.home.asSlice() let mut i:usize=0 while i<home.length { run out.append(home[i]) i=i+1 } }
        Result.Failure { error }=>match move error {
          SystemInfoError e=>{ run unsafe failed(&mut engine,context,e,op) return ValueBits.Undefined }
          OutOfMemoryError e=>{ fail move e }
        }
      }
    }
  } else {
    let hostname=fs.equal(op,b"hostname")
    let got=if hostname { run Effect.result(SystemInfo.hostName()) |> Effect.provideMut<SystemInfo>(&mut info) } else { run Effect.result(SystemInfo.executablePath()) |> Effect.provideMut<SystemInfo>(&mut info) }
    match move got {
      Result.Success { value }=>{ let bytes=value.asSlice() let mut i:usize=0 while i<bytes.length { run out.append(bytes[i]) i=i+1 } }
      Result.Failure { error }=>match move error {
        SystemInfoError e=>{ run unsafe failed(&mut engine,context,e,op) return ValueBits.Undefined }
        OutOfMemoryError e=>{ fail move e }
      }
    }
  }
  run out.append(0)
  return (run text.cstring(&mut engine,unsafe lendRealm(&context, context),text.pointer(&out))).intoBits()
}
unsafe effect fn resolveId<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,value:ValueBits,group:bool)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  if value.isNumber() { return ValueBits.number(run unsafe number(&mut engine,context,value,0.0,4294967295.0)) }
  let bytes=run unsafe ctext(&mut engine,context,value)
  if group {
    let p=unsafe abi.getgrnam(text.pointer(&bytes)) if Pointer.isNull<abi.NativeGroup>(p) { return ValueBits.Int { value:-1 } }
    let anchor=() let entry=unsafe Pointer.borrow<(),abi.NativeGroup>(&anchor,unsafe Intrinsic.pointerRequalify<?*mut abi.NativeGroup,*mut abi.NativeGroup>(p))
    return ValueBits.number(u32.toF64(entry.gid))
  }
  let p=unsafe abi.getpwnam(text.pointer(&bytes)) if Pointer.isNull<abi.NativePasswd>(p) { return ValueBits.Int { value:-1 } }
  let anchor=() let entry=unsafe Pointer.borrow<(),abi.NativePasswd>(&anchor,unsafe Intrinsic.pointerRequalify<?*mut abi.NativePasswd,*mut abi.NativePasswd>(p))
  return ValueBits.number(u32.toF64(entry.uid))
}
unsafe effect fn passwdResult<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,array:ValueBits,info:&UserInfo)->() !OutOfMemoryError|JsException ?&mut Allocator {
  let mut index:u32=0
  run unsafe push(&mut engine,context,array,&mut index,ValueBits.number(u32.toF64(info.uid)))
  run unsafe push(&mut engine,context,array,&mut index,ValueBits.number(u32.toF64(info.gid)))
  run unsafe pushSliceBytes(&mut engine,context,array,&mut index,info.name.asSlice())
  run unsafe pushSliceBytes(&mut engine,context,array,&mut index,info.home.asSlice())
  run unsafe pushSliceBytes(&mut engine,context,array,&mut index,info.shell.asSlice())
}
// Up to 1023 bytes of a small system file, such as /proc/uptime: the count, or 0.
unsafe fn slurp(path:&[u8],buffer:&mut [u8;1024])->usize {
  let fd=unsafe osplatform.open(Pointer.fromRef<u8>(&path[0]),0) if fd<0 { return 0 }
  let mut total:usize=0
  while total<1023 { let n=unsafe osplatform.read(fd,Pointer.fromMutRef<u8>(&mut buffer[total]),1023-total) if n<=0 { break } total=total+isize.toUsize(n) }
  let _closed=unsafe osplatform.close(fd) return total
}
// The decimal number at the start of `text` (digits, then a fraction), as sscanf("%lf") reads it.
fn leadingNumber(text:&[u8],length:usize,value:&mut f64)->bool {
  let mut i:usize=0 let mut whole:f64=0.0 let mut digits=false
  while i<length && text[i]>=48 && text[i]<=57 { whole=whole*10.0+u8.toF64(text[i]-48) digits=true i=i+1 }
  if i<length && text[i]==46 {
    i=i+1 let mut scale:f64=0.1
    while i<length && text[i]>=48 && text[i]<=57 { whole=whole+u8.toF64(text[i]-48)*scale scale=scale/10.0 digits=true i=i+1 }
  }
  value.*=whole return digits
}
// libuv's uv_uptime on Linux: /proc/uptime, with its fraction.
unsafe fn procUptime(value:&mut f64)->bool {
  let mut buffer:[u8;1024]=[0;1024]
  let n=unsafe slurp(b"/proc/uptime\0",&mut buffer)
  return n>0 && leadingNumber(&buffer,n,&mut value)
}
// libuv's cgroup memory use (uv__get_cgroup{1,2}_current_memory): memory.current of the cgroup v2
// path in /proc/self/cgroup, or memory.usage_in_bytes of the cgroup v1 memory controller's.
unsafe effect fn cgroupCurrent()->u64 !OutOfMemoryError ?&mut Allocator {
  let mut groups:[u8;1024]=[0;1024]
  let n=unsafe slurp(b"/proc/self/cgroup\0",&mut groups)
  let mut file=List<u8>.make()
  let mut start:usize=0 let mut found=false
  while start<n && !found {
    let mut end=start while end<n && groups[end]!=10 { end=end+1 }
    let mut colon=start while colon<end && groups[colon]!=58 { colon=colon+1 }
    let mut second=colon+1 while second<end && groups[second]!=58 { second=second+1 }
    let controllers=if colon+1<=second && second<=end { second-colon-1 } else { 0 }
    let v2=colon==start+1 && groups[start]==48 && controllers==0
    let v1=controllers>=6 && groups[colon+1]==109 && groups[colon+2]==101 && groups[colon+3]==109 && groups[colon+4]==111 && groups[colon+5]==114 && groups[colon+6]==121
    if second<end && (v2 || v1) {
      let root:&[u8]=if v2 { b"/sys/fs/cgroup" } else { b"/sys/fs/cgroup/memory" }
      let leaf:&[u8]=if v2 { b"/memory.current" } else { b"/memory.usage_in_bytes" }
      let mut i:usize=0 while i<root.length { run file.append(root[i]) i=i+1 }
      i=second+1 while i<end { run file.append(groups[i]) i=i+1 }
      i=0 while i<leaf.length { run file.append(leaf[i]) i=i+1 }
      run file.append(0) found=true
    }
    start=end+1
  }
  if !found { return 0 }
  let mut buffer:[u8;1024]=[0;1024]
  let read=unsafe slurp(file.asSlice(),&mut buffer)
  let mut value:f64=0.0
  if read==0 || !leadingNumber(&buffer,read,&mut value) { return 0 }
  return f64.toU64(value)
}
// The memory of the computer, or a thrown error.
unsafe effect fn memoryInfo<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,op:&[u8])->MemoryInfo !OutOfMemoryError|JsException ?&mut Allocator {
  let mut info=OsSystemInfo.make()
  let got=run Effect.result(SystemInfo.memory()) |> Effect.provideMut<SystemInfo>(&mut info)
  return match move got {
    Result.Success { value }=>value
    Result.Failure { error }=>{ run unsafe failed(&mut engine,context,error,op) MemoryInfo { total:0,free:0,available:0,limit:Option<MemoryLimit>.none() } }
  }
}
// An address as libuv's uv_ip4_name and uv_ip6_name write it (ext/inet).
effect fn addressText(address:&IpAddress)->List<u8> !OutOfMemoryError ?&mut Allocator {
  let mut buffer:[u8;64]=[0;64]
  let n=match address.* {
    IpAddress.V4 { value }=>{ let octets=value.octets() inet.ip4Text(&octets,&mut buffer) }
    IpAddress.V6 { value }=>{ let octets=value.octets() inet.ip6Text(&octets,&mut buffer) }
  }
  let mut out=List<u8>.make() let mut i:usize=0
  while i<n { run out.append(buffer[i]) i=i+1 }
  return move out
}
unsafe effect fn dispatchBody<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,op:&[u8],argv:&FrameSlots,scope:&mut Scope)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  let input=unsafe common.argument(argv,1)
  scope.values[1]=run unsafe owners.getIndex(&mut engine,context,input,0)
  scope.values[2]=run unsafe owners.getIndex(&mut engine,context,input,1)
  let first=scope.values[1] let second=scope.values[2]
  if fs.equal(op,b"reportWrite") {
    let fd=f64.toI32(run unsafe number(&mut engine,context,first,0.0,2147483647.0))
    let bytes=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(second))
    let status=unsafe writeAllDescriptor(fd,bytes.asSlice())
    if status!=0 { run unsafe checked(&mut engine,context,0-status,b"write") }
    return ValueBits.Undefined
  }
  let mut info=OsSystemInfo.make()
  if fs.equal(op,b"ppid") { let ppid=run SystemInfo.parentProcessId() |> Effect.provideMut<SystemInfo>(&mut info) return ValueBits.Int { value:ppid } }
  if fs.equal(op,b"availableParallelism") {
    let got=run Effect.result(SystemInfo.availableParallelism()) |> Effect.provideMut<SystemInfo>(&mut info)
    let count=match move got { Result.Success { value }=>value Result.Failure { .. }=>1 }
    return ValueBits.number(usize.toF64(count))
  }
  // libuv's free memory is what a new allocation can get (MemAvailable); its constrained memory
  // is the control group's limit or 0; its available memory is what is left under that limit.
  if fs.equal(op,b"freemem") { let memory=run unsafe memoryInfo(&mut engine,context,op) return ValueBits.number(u64.toF64(memory.available)) }
  if fs.equal(op,b"totalmem") { let memory=run unsafe memoryInfo(&mut engine,context,op) return ValueBits.number(u64.toF64(memory.total)) }
  if fs.equal(op,b"constrainedMemory") {
    let memory=run unsafe memoryInfo(&mut engine,context,op)
    return match memory.limit { Option<MemoryLimit>.Some { value }=>ValueBits.number(u64.toF64(value.bytes)) Option<MemoryLimit>.None=>ValueBits.Int { value:0 } }
  }
  // libuv's uv_get_available_memory: the free memory, or with a limit no larger than the
  // memory, the limit less the cgroup's whole use (its file cache too), and 0 past the limit.
  if fs.equal(op,b"availableMemory") {
    let memory=run unsafe memoryInfo(&mut engine,context,op)
    let limit=match memory.limit { Option<MemoryLimit>.Some { value }=>value.bytes Option<MemoryLimit>.None=>0 }
    if limit==0 || limit>memory.total { return ValueBits.number(u64.toF64(memory.available)) }
    let current=run unsafe cgroupCurrent()
    return ValueBits.number(u64.toF64(if limit<current { 0 } else { limit-current }))
  }
  if fs.equal(op,b"getuid") { return ValueBits.number(u32.toF64(unsafe abi.getuid())) }
  if fs.equal(op,b"geteuid") { return ValueBits.number(u32.toF64(unsafe abi.geteuid())) }
  if fs.equal(op,b"getgid") { return ValueBits.number(u32.toF64(unsafe abi.getgid())) }
  if fs.equal(op,b"getegid") { return ValueBits.number(u32.toF64(unsafe abi.getegid())) }
  if fs.equal(op,b"resolveUser") || fs.equal(op,b"resolveGroup") { return run unsafe resolveId(&mut engine,context,first,fs.equal(op,b"resolveGroup")) }
  if fs.equal(op,b"setuid") || fs.equal(op,b"seteuid") || fs.equal(op,b"setgid") || fs.equal(op,b"setegid") {
    let id=f64.toU32(run unsafe number(&mut engine,context,first,0.0,4294967295.0)) let mut code:i32=0
    if fs.equal(op,b"setuid") { code=unsafe abi.setuid(id) } else if fs.equal(op,b"seteuid") { code=unsafe abi.seteuid(id) } else if fs.equal(op,b"setgid") { code=unsafe abi.setgid(id) } else { code=unsafe abi.setegid(id) }
    run unsafe posix(&mut engine,context,code,op) return ValueBits.Undefined
  }
  if fs.equal(op,b"umask") {
    let mut mask:u32=0 if !core.undefined(first) { mask=f64.toU32(run unsafe number(&mut engine,context,first,0.0,4294967295.0)) }
    let mut previous:u32=0
    static if Intrinsic.targetOperatingSystem()=="darwin" { previous=u16.toU32(unsafe abi.umask(u32.toU16(mask & 65535))) if core.undefined(first) { let _ignored=unsafe abi.umask(u32.toU16(previous)) } }
    else { previous=unsafe abi.umask(mask) if core.undefined(first) { let _ignored=unsafe abi.umask(previous) } }
    return ValueBits.number(u32.toF64(previous))
  }
  if fs.equal(op,b"abort") { unsafe abi.abort() return ValueBits.Undefined }
  // Node's Execve (node_process_methods.cc): stdio is inherited by the new image, then
  // execve replaces the process. Returns the errno only when execve fails.
  if fs.equal(op,b"execve") {
    let path=run unsafe ctext(&mut engine,context,first)
    let arguments=run unsafe textList(&mut engine,context,second,&mut scope)
    scope.values[3]=run unsafe owners.getIndex(&mut engine,context,input,2)
    let environment=run unsafe textList(&mut engine,context,scope.values[3],&mut scope)
    let argv=run cVector(&arguments) let envp=run cVector(&environment)
    let mut fd:i32=0 while fd<3 { let _ignored=unsafe abi.fcntl(fd,2,0) fd=fd+1 }
    let _replaced=unsafe abi.execve(Pointer.fromSlice<u8>(path.asSlice()),Pointer.fromSlice<?[*]const u8>(argv.asSlice()),Pointer.fromSlice<?[*]const u8>(envp.asSlice()))
    return ValueBits.Int { value:unsafe platform.errno() }
  }
  if fs.equal(op,b"hostname") || fs.equal(op,b"homedir") || fs.equal(op,b"tmpdir") || fs.equal(op,b"execPath") { return run unsafe stringResult(&mut engine,context,op) }
  if fs.equal(op,b"uptime") {
    static if Intrinsic.targetOperatingSystem()=="linux" { let mut seconds:f64=0.0 if unsafe procUptime(&mut seconds) { return ValueBits.number(seconds) } }
    let got=run Effect.result(SystemInfo.uptime()) |> Effect.provideMut<SystemInfo>(&mut info)
    return match move got { Result.Success { value }=>ValueBits.number(u64.toF64(value)) Result.Failure { error }=>{ run unsafe failed(&mut engine,context,error,op) ValueBits.Undefined } }
  }
  if fs.equal(op,b"rss") {
    let got=run Effect.result(SystemInfo.residentSetSize()) |> Effect.provideMut<SystemInfo>(&mut info)
    return match move got { Result.Success { value }=>ValueBits.number(u64.toF64(value)) Result.Failure { error }=>{ run unsafe failed(&mut engine,context,error,op) ValueBits.Undefined } }
  }
  if fs.equal(op,b"getPriority") || fs.equal(op,b"setPriority") {
    let pid=f64.toI32(run unsafe number(&mut engine,context,first,-2147483648.0,2147483647.0))
    if fs.equal(op,b"getPriority") {
      let got=run Effect.result(SystemInfo.priority(pid)) |> Effect.provideMut<SystemInfo>(&mut info)
      return match move got { Result.Success { value }=>ValueBits.Int { value:value } Result.Failure { error }=>{ run unsafe failed(&mut engine,context,error,b"uv_os_getpriority") ValueBits.Undefined } }
    }
    let priority=f64.toI32(run unsafe number(&mut engine,context,second,-20.0,19.0))
    let set=run Effect.result(SystemInfo.setPriority(pid,priority)) |> Effect.provideMut<SystemInfo>(&mut info)
    match move set { Result.Success { .. }=>() Result.Failure { error }=>{ run unsafe failed(&mut engine,context,error,b"uv_os_setpriority") } }
    return ValueBits.Undefined
  }
  if fs.equal(op,b"initgroups") {
    let group=f64.toU32(run unsafe number(&mut engine,context,second,0.0,4294967295.0))
    if first.isString() { let name=run unsafe ctext(&mut engine,context,first) run unsafe posix(&mut engine,context,unsafe abi.initgroups(text.pointer(&name),group),op) return ValueBits.Undefined }
    let uid=f64.toU32(run unsafe number(&mut engine,context,first,0.0,4294967295.0))
    let got=run Effect.result(SystemInfo.user(uid)) |> Effect.provideMut<SystemInfo>(&mut info)
    let user=match move got {
      Result.Success { value }=>move value
      Result.Failure { error }=>match move error {
        SystemInfoError e=>{ run unsafe failed(&mut engine,context,e,b"uv_os_get_passwd2") return ValueBits.Undefined }
        OutOfMemoryError e=>{ fail move e }
      }
    }
    let name=run terminated(user.name.asSlice())
    let code=unsafe abi.initgroups(text.pointer(&name),group) let error=unsafe platform.errno()
    if code<0 { run unsafe checked(&mut engine,context,0-error,op) } return ValueBits.Undefined
  }
  if fs.equal(op,b"setgroups") {
    scope.values[3]=run unsafe common.get(&mut engine,context,first,b"length")
    let count=f64.toI32(run unsafe number(&mut engine,context,scope.values[3],0.0,2147483647.0))
    let mut storage=List<u32>.make() let mut i:i32=0
    while i<count { scope.values[4]=run unsafe owners.getIndex(&mut engine,context,first,i32.toU32(i)) let id=f64.toU32(run unsafe number(&mut engine,context,scope.values[4],0.0,4294967295.0)) unsafe owners.release(&mut engine,context,scope.take(4)) run storage.append(id) i=i+1 }
    let mut pointer:?*const u32=Pointer.null<u32>() if count>0 { pointer=Pointer.fromRef<u32>(&storage.asSlice()[0]) }
    let mut code:i32=0
    code=unsafe abi.setgroups(i32.toUsize(count),pointer)
    run unsafe posix(&mut engine,context,code,op) return ValueBits.Undefined
  }
  if fs.equal(op,b"nativeStack") {
    let mut frames:[?*mut u8;64]=[Pointer.null<u8>();64]
    let count=unsafe abi.backtrace(Pointer.fromMutRef<?*mut u8>(&mut frames[0]),64)
    let symbols=unsafe abi.backtrace_symbols(Pointer.fromRef<?*mut u8>(&frames[0]),count)
    if Pointer.isNull<*const u8>(symbols) { fail OutOfMemoryError {} }
    let _allocation=abi.Allocation { pointer:unsafe Intrinsic.pointerReinterpret<*mut *const u8,*mut u8>(unsafe Intrinsic.pointerRequalify<?*mut *const u8,*mut *const u8>(symbols)) }
    let many=unsafe Pointer.assumeMany<*const u8>(unsafe Intrinsic.pointerRequalify<?*mut *const u8,*mut *const u8>(symbols))
    let memory=engine.memory scope.values[0]=run unsafe common.array(&mut engine,memory,context)
    let mut index:u32=0
    while index<i32.toU32(count) {
      let symbol=unsafe Pointer.read<*const u8>(unsafe Pointer.at<*const u8>(many,u32.toUsize(index)))
      run unsafe pushText(&mut engine,context,scope.values[0],&mut index,symbol)
    }
    return scope.take(0)
  }
  let memory=engine.memory scope.values[0]=run unsafe common.array(&mut engine,memory,context) let output=scope.values[0] let mut index:u32=0
  if fs.equal(op,b"userLimits") {
    let mut ids:[i32;10]=[4,2,1,6,5,8,3,0,7,5]
    static if Intrinsic.targetOperatingSystem()!="darwin" { ids=[4,2,1,8,5,7,3,0,6,9] }
    let mut i:usize=0
    while i<10 {
      let mut limit:[u64;2]=[0;2]
      run unsafe posix(&mut engine,context,unsafe abi.getrlimit(ids[i],Pointer.fromMutRef<[u64;2]>(&mut limit)),b"getrlimit")
      let mut infinity:u64=18446744073709551615
      static if Intrinsic.targetOperatingSystem()=="darwin" { infinity=9223372036854775807 }
      let mut soft=ValueBits.number(u64.toF64(limit[0])) let mut hard=ValueBits.number(u64.toF64(limit[1]))
      if limit[0]==infinity { soft=ValueBits.Null } if limit[1]==infinity { hard=ValueBits.Null }
      run unsafe push(&mut engine,context,output,&mut index,soft)
      run unsafe push(&mut engine,context,output,&mut index,hard)
      i=i+1
    }
  } else if fs.equal(op,b"sharedObjects") {
    static if Intrinsic.targetOperatingSystem()=="darwin" {
      let count=unsafe abi._dyld_image_count() let mut i:u32=0
      while i<count {
        let name=unsafe abi._dyld_get_image_name(i)
        if !Pointer.isNull<u8>(name) { run unsafe pushText(&mut engine,context,output,&mut index,unsafe Intrinsic.pointerRequalify<?*const u8,*const u8>(name)) }
        i=i+1
      }
    } else {
      let images=run abi.loadedImages() let mut cursor=images.first
      while !Pointer.isNull<abi.Image>(cursor) {
        let anchor=() let image=unsafe Pointer.borrow<(),abi.Image>(&anchor,unsafe Intrinsic.pointerRequalify<?*mut abi.Image,*mut abi.Image>(cursor))
        cursor=image.next let name=image.name drop image
        run unsafe pushText(&mut engine,context,output,&mut index,name)
      }
    }
  } else if fs.equal(op,b"componentVersions") {
    // process.versions.uv: the libuv of the Node release the runtime follows, whose loop semantics
    // the runtime keeps without libuv (the loop plan); each library capability answers for its own.
    run unsafe pushText(&mut engine,context,output,&mut index,Pointer.fromRef<u8>(&b"1.51.0\0"[0]))
  } else if fs.equal(op,b"uname") {
    let got=run Effect.result(SystemInfo.kernel()) |> Effect.provideMut<SystemInfo>(&mut info)
    let kernel=match move got {
      Result.Success { value }=>move value
      Result.Failure { error }=>match move error {
        SystemInfoError e=>{ run unsafe failed(&mut engine,context,e,b"uv_os_uname") return scope.take(0) }
        OutOfMemoryError e=>{ fail move e }
      }
    }
    run unsafe pushSlice(&mut engine,context,output,&mut index,kernel.name.asSlice())
    run unsafe pushSlice(&mut engine,context,output,&mut index,kernel.release.asSlice())
    run unsafe pushSlice(&mut engine,context,output,&mut index,kernel.version.asSlice())
    run unsafe pushSlice(&mut engine,context,output,&mut index,kernel.machine.asSlice())
  } else if fs.equal(op,b"loadavg") {
    let got=run Effect.result(SystemInfo.loadAverage()) |> Effect.provideMut<SystemInfo>(&mut info)
    let values:[f64;3]=match move got { Result.Success { value }=>value Result.Failure { .. }=>[0.0;3] }
    while index<3 { let value=values[u32.toUsize(index)] run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(value)) }
  } else if fs.equal(op,b"userInfo") {
    let got=run Effect.result(SystemInfo.currentUser()) |> Effect.provideMut<SystemInfo>(&mut info)
    let user=match move got {
      Result.Success { value }=>move value
      Result.Failure { error }=>match move error {
        SystemInfoError e=>{ run unsafe failed(&mut engine,context,e,b"uv_os_get_passwd") return scope.take(0) }
        OutOfMemoryError e=>{ fail move e }
      }
    }
    run unsafe passwdResult(&mut engine,context,output,&user)
  } else if fs.equal(op,b"getgroups") {
    let count=unsafe abi.getgroups(0,Pointer.null<u32>()) run unsafe posix(&mut engine,context,count,op)
    let allocation=run abi.allocate((i32.toUsize(count)+1)*4) let p=unsafe Intrinsic.pointerReinterpret<*mut u8,*mut u32>(allocation.pointer)
    let actual=unsafe abi.getgroups(count,p) run unsafe posix(&mut engine,context,actual,op)
    let many=unsafe Pointer.assumeMany<u32>(p) let effective=unsafe abi.getegid() let mut found=false let mut i:i32=0
    while i<actual { let id=unsafe Pointer.read<u32>(unsafe Pointer.at<u32>(many,i32.toUsize(i))) if id==effective { found=true } run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u32.toF64(id))) i=i+1 }
    if !found { run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u32.toF64(effective))) }
  } else if fs.equal(op,b"cpuUsage") || fs.equal(op,b"threadCpuUsage") || fs.equal(op,b"resourceUsage") || fs.equal(op,b"threadResourceUsage") {
    let thread=fs.equal(op,b"threadCpuUsage") || fs.equal(op,b"threadResourceUsage")
    let got=if thread { run Effect.result(SystemInfo.resourceUsage(UsageScope.Thread)) |> Effect.provideMut<SystemInfo>(&mut info) } else { run Effect.result(SystemInfo.resourceUsage(UsageScope.Process)) |> Effect.provideMut<SystemInfo>(&mut info) }
    let usage=match move got { Result.Success { value }=>value Result.Failure { error }=>{ run unsafe failed(&mut engine,context,error,op) return scope.take(0) } }
    run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(usage.userMicroseconds)))
    run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(usage.systemMicroseconds)))
    if fs.equal(op,b"resourceUsage") || fs.equal(op,b"threadResourceUsage") {
      // uv_rusage_t's fields after the times, in its order; maxRSS in kilobytes, as Node reports it.
      let counters:[u64;14]=[usage.maxResidentBytes/1024,usage.sharedMemory,usage.unsharedData,usage.unsharedStack,usage.minorFaults,usage.majorFaults,usage.swaps,usage.blockInputs,usage.blockOutputs,usage.messagesSent,usage.messagesReceived,usage.signals,usage.voluntaryContextSwitches,usage.involuntaryContextSwitches]
      let mut i:usize=0 while i<14 { run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(counters[i]))) i=i+1 }
    }
  } else if fs.equal(op,b"cpus") {
    let got=run Effect.result(SystemInfo.processors()) |> Effect.provideMut<SystemInfo>(&mut info)
    let processors=match move got {
      Result.Success { value }=>move value
      Result.Failure { error }=>match move error {
        SystemInfoError e=>{ run unsafe failed(&mut engine,context,e,b"uv_cpu_info") return scope.take(0) }
        OutOfMemoryError e=>{ fail move e }
      }
    }
    let all=processors.asSlice() let mut i:usize=0
    while i<all.length {
      let cpu=&all[i]
      run unsafe pushSlice(&mut engine,context,output,&mut index,cpu.model.asSlice())
      run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u32.toF64(cpu.speed)))
      run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(cpu.times.user)))
      run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(cpu.times.nice)))
      run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(cpu.times.system)))
      run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(cpu.times.idle)))
      run unsafe push(&mut engine,context,output,&mut index,ValueBits.number(u64.toF64(cpu.times.interrupt))) i=i+1
    }
  } else if fs.equal(op,b"networkInterfaces") {
    let got=run Effect.result(SystemInfo.networkInterfaces()) |> Effect.provideMut<SystemInfo>(&mut info)
    let interfaces=match move got {
      Result.Success { value }=>move value
      Result.Failure { error }=>match move error {
        SystemInfoError e=>{ run unsafe failed(&mut engine,context,e,b"uv_interface_addresses") return scope.take(0) }
        OutOfMemoryError e=>{ fail move e }
      }
    }
    let all=interfaces.asSlice() let mut i:usize=0
    while i<all.length {
      let entry=&all[i]
      let ipv4=entry.address.isV4()
      let addressBytes=run addressText(&entry.address) let maskBytes=run addressText(&entry.netmask)
      run unsafe pushSlice(&mut engine,context,output,&mut index,entry.name.asSlice())
      run unsafe pushSlice(&mut engine,context,output,&mut index,addressBytes.asSlice())
      run unsafe pushSlice(&mut engine,context,output,&mut index,maskBytes.asSlice())
      let mut familyValue:i32=6 if ipv4 { familyValue=4 }
      run unsafe push(&mut engine,context,output,&mut index,ValueBits.Int { value:familyValue })
      let mut mac:[u8;17]=[0;17] let hex=b"0123456789abcdef" let mut n:usize=0
      while n<6 { mac[n*3]=hex[u8.toUsize(entry.mac[n]/16)] mac[n*3+1]=hex[u8.toUsize(entry.mac[n]%16)] if n<5 { mac[n*3+2]=58 } n=n+1 }
      run unsafe pushSlice(&mut engine,context,output,&mut index,&mac)
      run unsafe push(&mut engine,context,output,&mut index,ValueBits.Bool { value:entry.internal })
      let mut scopeid=ValueBits.Int { value:-1 } if !ipv4 { scopeid=ValueBits.number(u32.toF64(entry.scopeId)) }
      run unsafe push(&mut engine,context,output,&mut index,scopeid) i=i+1
    }
  } else { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"unknown native OS operation") }
  return scope.take(0)
}
pub unsafe effect fn dispatch<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,argc:i32,argv:&FrameSlots)->ValueBits !OutOfMemoryError|JsException ?&mut Allocator {
  if argc<2 { return run engine.throwError(unsafe lendRealm(&context, context),NativeErrorKind.Type,b"osNative requires operation and argument array") }
  let operation=run text.text(&mut engine,unsafe lendRealm(&context, context),unsafe lendFor(unsafe common.argument(argv,0))) let mut scope=Scope.make()
  let outcome=run Effect.result(unsafe dispatchBody(&mut engine,context,operation.asSlice(),argv,&mut scope))
  unsafe owners.cleanup(&mut engine,context,move scope)
  return match move outcome { Result<ValueBits,OutOfMemoryError|JsException>.Success { value }=>value Result<ValueBits,OutOfMemoryError|JsException>.Failure { error }=>{ fail move error } }
}
