//! The verifier of the SSA form (docs/jit/ssa.md, "The verifier"). It reads a compacted
//! function and fails with the first rule it finds broken.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u32
import silk.num.usize
import ssa { Function, Inst, Edge, Exit, Type, Own, RootKind, Op, SlotMode, NONE, isTerminator, edgeCount, isNumberOp, numberOpReadsB, numberOpHasExit, readsK }
import ssa
import ssa_calls as calls

/// A broken rule: where (block, instruction index or NONE, value or NONE) and which.
pub struct VerifyError { pub block: u32, pub inst: u32, pub value: u32, pub reason: &'static [u8] }

fn broken(block: u32, inst: u32, value: u32, reason: &'static [u8]) -> VerifyError {
  return VerifyError { block: block, inst: inst, value: value, reason: reason }
}

/// Whether `op` reads operand `a` / `b` as a value.
pub fn readsA(op: Op) -> bool {
  return op == Op.Unbox || op == Op.UnboxBool || op == Op.BoxI32 || op == Op.BoxBool || op == Op.Add || op == Op.Sub
    || op == Op.Mul || op == Op.Cmp || op == Op.Retain || op == Op.Release || op == Op.Branch || op == Op.Return
    || op == Op.CheckTag || op == Op.CheckArray || op == Op.CheckBound || op == Op.GrowBound || op == Op.Elements || op == Op.GetField || op == Op.PutField || op == Op.PutVar || op == Op.PutScope
    || op == Op.GetKey || op == Op.GetElem || op == Op.GetElemF64 || op == Op.PutElemF64 || op == Op.PutElem || op == Op.PutKey || op == Op.GetLength || op == Op.Truthy || op == Op.TagIs || op == Op.TypeofAtom || op == Op.Typeof || op == Op.InstanceOf || op == Op.Equals || op == Op.CallArg || op == Op.Call
    || op == Op.CheckCallee || op == Op.CheckShape || op == Op.CheckWatched || op == Op.IsCallee || op == Op.InlineFrame || op == Op.NewObject || op == Op.InitSlot || op == Op.CheckConstruct || isNumberOp(op)
}
pub fn readsB(op: Op) -> bool { return op == Op.Add || op == Op.Sub || op == Op.Mul || op == Op.Cmp || op == Op.CheckBound || op == Op.GrowBound || op == Op.PutField || op == Op.GetKey || op == Op.GetElem || op == Op.GetElemF64 || op == Op.PutElemF64 || op == Op.PutElem || op == Op.PutKey || op == Op.InstanceOf || op == Op.Equals || op == Op.Call || op == Op.NewObject || op == Op.InitSlot || op == Op.CheckConstruct || numberOpReadsB(op) }
/// Whether `op` must, and alone may, carry a deoptimization exit.
pub fn hasExit(op: Op) -> bool {
  return op == Op.Unbox || op == Op.UnboxBool || op == Op.Add || op == Op.Sub || op == Op.Mul || op == Op.Poll
    || op == Op.CheckTag || op == Op.CheckArray || op == Op.CheckBound || op == Op.GrowBound || op == Op.GetField || op == Op.PutField || op == Op.AtomValue
    || op == Op.GetVar || op == Op.PutVar || op == Op.GetScope || op == Op.PutScope
    || op == Op.GetKey || op == Op.GetElem || op == Op.GetElemF64 || op == Op.PutElemF64 || op == Op.PutElem || op == Op.PutKey || op == Op.GetLength || op == Op.TypeofAtom || op == Op.Typeof || op == Op.InstanceOf || op == Op.Equals || op == Op.Call || op == Op.CheckCallee || op == Op.CheckShape || op == Op.CheckWatched || op == Op.NewObject || op == Op.CheckConstruct || op == Op.KnownMethod || numberOpHasExit(op)
}

fn isOwned(f: &Function, v: u32) -> bool { let info = f.value(v) return info.ty == Type.Value && info.own == Own.Owned }

/// The immediate dominators of a compacted function (blocks in reverse postorder).
pub effect fn dominators(f: &Function) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let count = f.blockCount()
  let mut idom = List<u32>.make()
  run idom.appendRepeated(NONE, u32.toUsize(count))
  if count == 0 { return move idom }
  idom.set(0, 0)
  // The block each edge leaves (sourceOf), and the edges into each block:
  // into[first[b] .. first[b + 1]].
  let edges = f.edges.length()
  let mut source = List<u32>.make()
  run source.appendRepeated(NONE, edges)
  let mut b: u32 = 0
  while b < count {
    let term = f.terminator(f.blocks.get(u32.toUsize(b)))
    if term.edge != NONE {
      let mut k: u32 = 0
      while k < edgeCount(term.op) {
        let e = u32.toUsize(term.edge + k)
        if e < edges && source.get(e) == NONE { source.set(e, b) }
        k = k + 1
      }
    }
    b = b + 1
  }
  let mut first = List<u32>.make()
  run first.appendRepeated(0, u32.toUsize(count) + 1)
  let mut e: usize = 0
  while e < edges {
    let t = u32.toUsize(f.edges.get(e).target)
    if t < u32.toUsize(count) { let c = first.get(t + 1) + 1 first.set(t + 1, c) }
    e = e + 1
  }
  let mut i: usize = 0
  while i < u32.toUsize(count) { let c = first.get(i + 1) + first.get(i) first.set(i + 1, c) i = i + 1 }
  let mut next = List<u32>.make()
  run next.appendSlice(first.asSlice())
  let mut into = List<u32>.make()
  run into.appendRepeated(0, edges)
  e = 0
  while e < edges {
    let t = u32.toUsize(f.edges.get(e).target)
    if t < u32.toUsize(count) { let at = next.get(t) into.set(u32.toUsize(at), usize.toU32(e)) next.set(t, at + 1) }
    e = e + 1
  }
  let mut changed = true
  while changed {
    changed = false
    b = 1
    while b < count {
      let mut chosen = NONE
      let mut k = first.get(u32.toUsize(b))
      while k < first.get(u32.toUsize(b) + 1) {
        let pred = source.get(u32.toUsize(into.get(u32.toUsize(k))))
        if pred != NONE && idom.get(u32.toUsize(pred)) != NONE {
          if chosen == NONE { chosen = pred } else { chosen = intersect(&idom, chosen, pred) }
        }
        k = k + 1
      }
      if chosen != idom.get(u32.toUsize(b)) { idom.set(u32.toUsize(b), chosen) changed = true }
      b = b + 1
    }
  }
  return move idom
}

fn intersect(idom: &List<u32>, a: u32, b: u32) -> u32 {
  let mut x = a let mut y = b
  while x != y {
    while x > y { x = idom.get(u32.toUsize(x)) }
    while y > x { y = idom.get(u32.toUsize(y)) }
  }
  return x
}

/// The block whose terminator owns edge `e`.
pub fn sourceOf(f: &Function, e: u32) -> u32 {
  let mut b: u32 = 0
  while b < f.blockCount() {
    let block = f.blocks.get(u32.toUsize(b))
    let term = f.terminator(block)
    if term.edge != NONE && e >= term.edge && e < term.edge + edgeCount(term.op) { return b }
    b = b + 1
  }
  return NONE
}

fn dominates(idom: &List<u32>, a: u32, b: u32) -> bool {
  let mut x = b
  while true {
    if x == a { return true }
    if x == 0 || x == NONE { return false }
    x = idom.get(u32.toUsize(x))
  }
  return false
}

/// Checks that `v` is defined where the instruction at `index` in block `b` can use it.
fn defined(f: &Function, idom: &List<u32>, v: u32, b: u32, index: u32) -> bool {
  if v >= f.valueCount() { return false }
  let info = f.value(v)
  if info.block == b { return info.def == NONE || info.def < index }
  return dominates(idom, info.block, b)
}

/// Verifies `f`. It must be compacted.
pub effect fn verify(f: &Function) -> () ! VerifyError | OutOfMemoryError ? &mut Allocator {
  run structure(f)
  let idom = run dominators(f)
  run uses(f, &idom)
  run ownership(f)
}

effect fn structure(f: &Function) -> () ! VerifyError {
  // Definitions: each parameter belongs to its block; each result to its instruction.
  let mut b: u32 = 0
  while b < f.blockCount() {
    let block = f.blocks.get(u32.toUsize(b))
    if block.instCount == 0 { fail broken(b, NONE, NONE, b"a block without a terminator") }
    let mut p: u32 = 0
    while p < block.paramCount {
      let v = f.paramAt(block, p)
      let info = f.value(v)
      if info.block != b || info.def != NONE { fail broken(b, NONE, v, b"a parameter defined twice or elsewhere") }
      p = p + 1
    }
    let mut i: u32 = 0
    while i < block.instCount {
      let index = block.firstInst + i
      let inst = f.inst(index)
      if inst.block != b { fail broken(b, index, NONE, b"an instruction outside its block's range") }
      let last = i + 1 == block.instCount
      if isTerminator(inst.op) != last { fail broken(b, index, NONE, b"the terminator is not the last instruction") }
      if inst.op == Op.Removed { fail broken(b, index, NONE, b"a removed instruction") }
      if inst.result != NONE {
        let info = f.value(inst.result)
        if info.def != index || info.block != b { fail broken(b, index, inst.result, b"a result defined twice or elsewhere") }
      }
      if hasExit(inst.op) != (inst.exit != NONE) { fail broken(b, index, NONE, b"an exit on an instruction that cannot leave, or a guard without one") }
      run types(f, b, index, inst)
      if inst.exit != NONE { run exitTypes(f, b, index, f.exit(inst.exit)) }
      if inst.edge != NONE {
        let mut e: u32 = 0
        while e < edgeCount(inst.op) { run edgeTypes(f, b, index, f.edge(inst.edge + e)) e = e + 1 }
      }
      i = i + 1
    }
    b = b + 1
  }
}

fn resultIs(f: &Function, inst: Inst, ty: Type, own: Own) -> bool {
  if inst.result == NONE { return false }
  let info = f.value(inst.result)
  return info.ty == ty && info.own == own
}
fn typeOf(f: &Function, v: u32) -> Type { return f.value(v).ty }
/// Whether the first operand of element access `inst` is a value, or the elements of an
/// Array, which only a proven access reads.
fn arrayIs(f: &Function, inst: Inst) -> bool {
  if typeOf(f, inst.a) == Type.Value { return true }
  return inst.trusted && inst.proven && f.isElements(inst.a)
}

effect fn types(f: &Function, b: u32, index: u32, inst: Inst) -> () ! VerifyError {
  let op = inst.op
  let n = f.valueCount()
  if readsA(op) && inst.a >= n { fail broken(b, index, inst.a, b"an operand that is not a value") }
  if readsB(op) && inst.b >= n { fail broken(b, index, inst.b, b"an operand that is not a value") }
  if readsK(op) && (inst.k < 0 || i32.wrappingToU32(inst.k) >= n) { fail broken(b, index, NONE, b"an operand that is not a value") }
  let mut ok = true
  if op == Op.Arg {
    ok = resultIs(f, inst, Type.Value, Own.Borrowed) && inst.k >= 0 && u32.toI64(f.argumentCount) > i32.toI64(inst.k)
    if ok { let info = f.value(inst.result) ok = info.rootKind == RootKind.Argument && i32.toI64(inst.k) == u32.toI64(info.root) }
  }
  else if op == Op.ConstI32 { ok = resultIs(f, inst, Type.I32, Own.Unboxed) }
  else if op == Op.Imm { ok = resultIs(f, inst, Type.Value, Own.Imm) && ((inst.k >= 0 && inst.k <= 4) || inst.k >= ssa.IMM_CATCH) }
  else if op == Op.Unbox { ok = typeOf(f, inst.a) == Type.Value && resultIs(f, inst, Type.I32, Own.Unboxed) }
  else if op == Op.UnboxBool { ok = typeOf(f, inst.a) == Type.Value && resultIs(f, inst, Type.Bool, Own.Unboxed) }
  else if op == Op.BoxI32 { ok = typeOf(f, inst.a) == Type.I32 && resultIs(f, inst, Type.Value, Own.Imm) }
  else if op == Op.BoxBool { ok = typeOf(f, inst.a) == Type.Bool && resultIs(f, inst, Type.Value, Own.Imm) }
  else if op == Op.Add || op == Op.Sub || op == Op.Mul { ok = typeOf(f, inst.a) == Type.I32 && typeOf(f, inst.b) == Type.I32 && resultIs(f, inst, Type.I32, Own.Unboxed) }
  else if op == Op.Cmp { ok = typeOf(f, inst.a) == Type.I32 && typeOf(f, inst.b) == Type.I32 && resultIs(f, inst, Type.Bool, Own.Unboxed) && inst.k >= 0 && inst.k <= 5 }
  // A borrowed result (ssa_ownership.borrowFields) is a copy that takes no count.
  else if op == Op.Retain { ok = typeOf(f, inst.a) == Type.Value && (resultIs(f, inst, Type.Value, Own.Owned) || resultIs(f, inst, Type.Value, Own.Borrowed)) }
  else if op == Op.Release { ok = isOwned(f, inst.a) && inst.result == NONE }
  else if op == Op.Poll || op == Op.Jump { ok = inst.result == NONE }
  else if op == Op.This {
    ok = resultIs(f, inst, Type.Value, Own.Borrowed)
    if ok { let info = f.value(inst.result) ok = info.rootKind == RootKind.Argument && info.root == f.argumentCount }
  }
  else if op == Op.CheckTag || op == Op.CheckArray || op == Op.CheckShape || op == Op.CheckWatched { ok = typeOf(f, inst.a) == Type.Value && inst.result == NONE }
  else if op == Op.CheckBound { ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.I32 && inst.result == NONE }
  else if op == Op.GrowBound { ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.I32 && typeOf(f, i32.wrappingToU32(inst.k)) == Type.I32 && inst.result == NONE }
  else if op == Op.TagIn { ok = typeOf(f, inst.a) == Type.Value && resultIs(f, inst, Type.Bool, Own.Unboxed) }
  else if op == Op.GetField { ok = typeOf(f, inst.a) == Type.Value && (resultIs(f, inst, Type.Value, Own.Owned) || resultIs(f, inst, Type.Value, Own.Borrowed)) }
  else if op == Op.GetKey { ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.Value && resultIs(f, inst, Type.Value, Own.Owned) }
  else if op == Op.Elements { ok = typeOf(f, inst.a) == Type.Value && resultIs(f, inst, Type.Raw, Own.Unboxed) }
  else if op == Op.GetElem { ok = arrayIs(f, inst) && typeOf(f, inst.b) == Type.I32 && (resultIs(f, inst, Type.Value, Own.Owned) || resultIs(f, inst, Type.Value, Own.Borrowed)) }
  else if op == Op.GetElemF64 { ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.I32 && resultIs(f, inst, Type.F64, Own.Unboxed) }
  else if op == Op.PutKey { ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.Value && typeOf(f, i32.wrappingToU32(inst.k)) == Type.Value && inst.result == NONE }
  else if op == Op.PutElemF64 { ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.F64 && typeOf(f, i32.wrappingToU32(inst.k)) == Type.I32 && inst.result == NONE }
  else if op == Op.PutElem { ok = arrayIs(f, inst) && typeOf(f, inst.b) == Type.Value && typeOf(f, i32.wrappingToU32(inst.k)) == Type.I32 && inst.result == NONE }
  else if op == Op.GetLength { ok = typeOf(f, inst.a) == Type.Value && (resultIs(f, inst, Type.Value, Own.Owned) || resultIs(f, inst, Type.Value, Own.Borrowed)) }
  else if op == Op.Truthy { ok = typeOf(f, inst.a) == Type.Value && resultIs(f, inst, Type.Bool, Own.Unboxed) }
  else if op == Op.TagIs { ok = typeOf(f, inst.a) == Type.Value && resultIs(f, inst, Type.Bool, Own.Unboxed) && inst.k >= 1 && inst.k <= 7 }
  else if op == Op.Equals { ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.Value && resultIs(f, inst, Type.Bool, Own.Unboxed) && (inst.k == 0 || inst.k == 1) }
  else if op == Op.InstanceOf { ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.Value && resultIs(f, inst, Type.Bool, Own.Unboxed) }
  else if op == Op.TypeofAtom { ok = typeOf(f, inst.a) == Type.Value && resultIs(f, inst, Type.I32, Own.Unboxed) }
  else if op == Op.Typeof { ok = typeOf(f, inst.a) == Type.Value && resultIs(f, inst, Type.Value, Own.Owned) }
  else if op == Op.GetScope { ok = resultIs(f, inst, Type.Value, Own.Owned) || resultIs(f, inst, Type.Value, Own.Borrowed) }
  else if op == Op.PutScope { ok = typeOf(f, inst.a) == Type.Value && inst.result == NONE }
  else if op == Op.GetVar { ok = resultIs(f, inst, Type.Value, Own.Owned) || resultIs(f, inst, Type.Value, Own.Borrowed) }
  else if op == Op.PutVar { ok = typeOf(f, inst.a) == Type.Value && inst.result == NONE }
  else if op == Op.AtomValue { ok = resultIs(f, inst, Type.Value, Own.Owned) }
  else if op == Op.ConstVal { ok = (resultIs(f, inst, Type.Value, Own.Owned) || resultIs(f, inst, Type.Value, Own.Borrowed)) && inst.k >= 0 }
  else if op == Op.PutField { ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.Value && inst.result == NONE && (inst.k == 0 || inst.k == 1) }
  else if op == Op.CallArg || op == Op.Call { ok = calls.wellFormed(f, b, index, inst) }
  else if op == Op.CallResult { ok = calls.resultWellFormed(f, b, index, inst) }
  else if op == Op.CheckCallee || op == Op.InlineFrame {
    ok = typeOf(f, inst.a) == Type.Value && inst.result == NONE && inst.k >= 0 && i32.toI64(inst.k) < usize.toI64(f.inlineTargets.length())
  }
  else if op == Op.IsCallee {
    ok = typeOf(f, inst.a) == Type.Value && resultIs(f, inst, Type.Bool, Own.Unboxed) && inst.k >= 0 && i32.toI64(inst.k) < usize.toI64(f.inlineTargets.length())
  }
  else if op == Op.NewObject {
    ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.Value && resultIs(f, inst, Type.Value, Own.Owned) && inst.k >= 0 && i32.toI64(inst.k) < usize.toI64(f.constructTargets.length())
  }
  else if op == Op.InitSlot {
    ok = typeOf(f, inst.a) == Type.Value && inst.result == NONE && inst.k >= 0 && inst.k < 8
  }
  else if op == Op.CheckConstruct {
    ok = typeOf(f, inst.a) == Type.Value && typeOf(f, inst.b) == Type.Value && inst.result == NONE && inst.k >= 0 && i32.toI64(inst.k) < usize.toI64(f.constructTargets.length())
  }
  else if op == Op.KnownMethod {
    ok = inst.a == NONE && inst.b == NONE && (resultIs(f, inst, Type.Value, Own.Owned) || resultIs(f, inst, Type.Value, Own.Borrowed))
      && inst.k >= 0 && i32.toI64(inst.k & 0xffffff) < usize.toI64(f.inlineTargets.length())
      && i32.shiftRight(inst.k, 24) >= 0 && i32.shiftRight(inst.k, 24) < 4
  }
  else if op == Op.Branch { ok = typeOf(f, inst.a) == Type.Bool && inst.result == NONE }
  else if op == Op.Return {
    let info = f.value(inst.a)
    ok = info.ty == Type.Value && (info.own == Own.Owned || info.own == Own.Imm) && inst.result == NONE
  }
  else if op == Op.ConstF64 { ok = resultIs(f, inst, Type.F64, Own.Unboxed) && inst.k >= 0 && i32.toI64(inst.k) < usize.toI64(f.numbers.length()) }
  else if isNumberOp(op) { ok = numberTypes(f, inst) }
  if !ok { fail broken(b, index, inst.result, b"operand or result types do not fit the instruction") }
  if (op == Op.Jump || op == Op.Branch) != (inst.edge != NONE) { fail broken(b, index, NONE, b"a terminator without its edges") }
  if inst.edge != NONE && inst.edge + edgeCount(op) > usize.toU32(f.edges.length()) { fail broken(b, index, NONE, b"an edge index out of range") }
}

effect fn edgeTypes(f: &Function, b: u32, index: u32, edge: Edge) -> () ! VerifyError {
  if edge.target >= f.blockCount() { fail broken(b, index, NONE, b"an edge to no block") }
  let target = f.blocks.get(u32.toUsize(edge.target))
  if edge.argCount != target.paramCount { fail broken(b, index, NONE, b"edge arguments do not match the target's parameters") }
  let mut g: u32 = 0
  while g < edge.argCount {
    let arg = f.edgeArg(edge, g)
    if arg >= f.valueCount() { fail broken(b, index, arg, b"an edge argument that is not a value") }
    let a = f.value(arg)
    let p = f.value(f.paramAt(target, g))
    if a.ty != p.ty { fail broken(b, index, arg, b"an edge argument of the wrong type") }
    if a.ty == Type.Value {
      let fits = a.own == Own.Imm || a.own == p.own
      if !fits { fail broken(b, index, arg, b"an edge argument whose ownership the parameter cannot take") }
    }
    g = g + 1
  }
}

effect fn exitTypes(f: &Function, b: u32, index: u32, exit: Exit) -> () ! VerifyError {
  if exit.firstSlot + f.slotCount(exit) > usize.toU32(f.slots.length()) { fail broken(b, index, NONE, b"an exit's slots out of range") }
  let mut s: u32 = 0
  while s < f.slotCount(exit) {
    let slot = f.slot(exit, s)
    if slot.mode == SlotMode.Virtual {
      if u32.toUsize(slot.value) >= f.virtualObjs.length() || slot.root != NONE {
        fail broken(b, index, slot.value, b"a virtual exit slot out of range or with a root")
      }
      let vo = f.virtualObjs.get(u32.toUsize(slot.value))
      if u32.toUsize(vo.constructSite) >= f.constructTargets.length() || vo.slotCount == 0 || vo.slotCount > 8 {
        fail broken(b, index, slot.value, b"a virtual object with invalid construct site or slot count")
      }
      let mut fk: u32 = 0
      while fk < vo.slotCount {
        if vo.fields[u32.toUsize(fk)] >= f.valueCount() {
          fail broken(b, index, vo.fields[u32.toUsize(fk)], b"a virtual object field that is not a value")
        }
        fk = fk + 1
      }
      s = s + 1
      continue
    }
    if slot.value >= f.valueCount() { fail broken(b, index, slot.value, b"an exit slot that is not a value") }
    let info = f.value(slot.value)
    let mut ok = false
    if slot.mode == SlotMode.Int { ok = info.ty == Type.I32 }
    else if slot.mode == SlotMode.Bool { ok = info.ty == Type.Bool }
    else if slot.mode == SlotMode.F64 { ok = info.ty == Type.F64 }
    else if slot.mode == SlotMode.Imm { ok = info.ty == Type.Value && info.own == Own.Imm }
    else if slot.mode == SlotMode.Move { ok = info.ty == Type.Value && info.own == Own.Owned }
    else { ok = info.ty == Type.Value && info.own == Own.Borrowed && (info.rootKind != RootKind.Argument || slot.root == info.root) }
    if !ok { fail broken(b, index, slot.value, b"an exit slot's mode does not fit its value") }
    if slot.mode != SlotMode.Dup && slot.root != NONE { fail broken(b, index, slot.value, b"a root on a slot that is not dup") }
    s = s + 1
  }
}

/// Every operand, edge argument and exit slot is defined where it is used.
effect fn uses(f: &Function, idom: &List<u32>) -> () ! VerifyError {
  let mut b: u32 = 0
  while b < f.blockCount() {
    let block = f.blocks.get(u32.toUsize(b))
    let mut i: u32 = 0
    while i < block.instCount {
      let index = block.firstInst + i
      let inst = f.inst(index)
      if readsA(inst.op) && !defined(f, idom, inst.a, b, index) { fail broken(b, index, inst.a, b"an operand used where its definition does not dominate") }
      if readsB(inst.op) && !defined(f, idom, inst.b, b, index) { fail broken(b, index, inst.b, b"an operand used where its definition does not dominate") }
      if readsK(inst.op) && !defined(f, idom, i32.wrappingToU32(inst.k), b, index) { fail broken(b, index, i32.wrappingToU32(inst.k), b"an operand used where its definition does not dominate") }
      if inst.edge != NONE {
        let mut e: u32 = 0
        while e < edgeCount(inst.op) {
          let edge = f.edge(inst.edge + e)
          let mut g: u32 = 0
          while g < edge.argCount {
            let arg = f.edgeArg(edge, g)
            if !defined(f, idom, arg, b, index) { fail broken(b, index, arg, b"an edge argument whose definition does not dominate") }
            g = g + 1
          }
          e = e + 1
        }
      }
      if inst.exit != NONE {
        let exit = f.exit(inst.exit)
        let mut s: u32 = 0
        while s < f.slotCount(exit) {
          let slot = f.slot(exit, s)
          if slot.mode == SlotMode.Virtual {
            let vo = f.virtualObjs.get(u32.toUsize(slot.value))
            let mut fk: u32 = 0
            while fk < vo.slotCount {
              let fv = vo.fields[u32.toUsize(fk)]
              if !defined(f, idom, fv, b, index) { fail broken(b, index, fv, b"a virtual object field whose definition does not dominate") }
              fk = fk + 1
            }
          } else {
            let v = slot.value
            if !defined(f, idom, v, b, index) { fail broken(b, index, v, b"an exit slot whose definition does not dominate") }
          }
          s = s + 1
        }
      }
      let root = rootOf(f, inst)
      if root != NONE && !defined(f, idom, root, b, index) { fail broken(b, index, root, b"a borrow whose root does not dominate") }
      i = i + 1
    }
    b = b + 1
  }
}

/// The owned root of a borrowed operand of `inst`, or NONE.
fn rootOf(f: &Function, inst: Inst) -> u32 {
  if !readsA(inst.op) { return NONE }
  let info = f.value(inst.a)
  if info.own == Own.Borrowed && info.rootKind == RootKind.Value { return info.root }
  return NONE
}

/// Owned values: consumed exactly once on every path, never used after, predecessors agree,
/// exits move every outstanding value exactly once.
effect fn ownership(f: &Function) -> () ! VerifyError | OutOfMemoryError ? &mut Allocator {
  let n = u32.toUsize(f.valueCount())
  let blocks = u32.toUsize(f.blockCount())
  let mut known = List<bool>.make() run known.appendRepeated(false, blocks)
  let mut entry = List<bool>.make() run entry.appendRepeated(false, blocks * n)
  if blocks > 0 { known.set(0, true) }
  let mut state = List<bool>.make() run state.appendRepeated(false, n)
  let mut scratch = List<bool>.make() run scratch.appendRepeated(false, n)
  let mut moved = List<u32>.make() run moved.appendRepeated(0, n)
  // Per value: the last exit (by serial) that moved it. With `outstanding`, the number of true
  // entries of state, an exit is checked in time linear in its slots; the scan over every
  // value below only runs to name the value when that check fails.
  let mut stamp = List<u32>.make() run stamp.appendRepeated(0, n)
  let mut serial: u32 = 0
  let mut outstanding: u32 = 0
  let mut b: u32 = 0
  while b < f.blockCount() {
    let base = u32.toUsize(b) * n
    if !known.get(u32.toUsize(b)) { fail broken(b, NONE, NONE, b"a block reached by no forward edge") }
    let mut v: usize = 0
    outstanding = 0
    while v < n { let held = entry.get(base + v) state.set(v, held) if held { outstanding = outstanding + 1 } v = v + 1 }
    let block = f.blocks.get(u32.toUsize(b))
    let mut p: u32 = 0
    while p < block.paramCount {
      let pv = f.paramAt(block, p)
      if isOwned(f, pv) { if !state.get(u32.toUsize(pv)) { outstanding = outstanding + 1 } state.set(u32.toUsize(pv), true) }
      p = p + 1
    }
    let mut i: u32 = 0
    while i < block.instCount {
      let index = block.firstInst + i
      let inst = f.inst(index)
      // Uses read live values only.
      if readsA(inst.op) { run live(f, &state, b, index, inst.a) }
      if readsB(inst.op) { run live(f, &state, b, index, inst.b) }
      if inst.exit != NONE {
        let exit = f.exit(inst.exit)
        // Each outstanding value in exactly one move slot, and nothing else moved: every move
        // is of a distinct outstanding value, and there are as many as outstanding values.
        serial = serial + 1
        let mut distinct: u32 = 0
        let mut wrong = false
        let mut s: u32 = 0
        while s < f.slotCount(exit) {
          let slot = f.slot(exit, s)
          if slot.mode == SlotMode.Virtual {
            let vo = f.virtualObjs.get(u32.toUsize(slot.value))
            let mut fk: u32 = 0
            while fk < vo.slotCount {
              run live(f, &state, b, index, vo.fields[u32.toUsize(fk)])
              fk = fk + 1
            }
          } else {
            run live(f, &state, b, index, slot.value)
            if slot.mode == SlotMode.Move {
              let at = u32.toUsize(slot.value)
              if stamp.get(at) == serial || !state.get(at) { wrong = true } else { stamp.set(at, serial) distinct = distinct + 1 }
            }
          }
          s = s + 1
        }
        if wrong || distinct != outstanding {
          s = 0
          while s < f.exitSlots(exit) {
            let slot = f.slot(exit, s)
            if slot.mode == SlotMode.Move { let before = moved.get(u32.toUsize(slot.value)) moved.set(u32.toUsize(slot.value), before + 1) }
            s = s + 1
          }
          v = 0
          while v < n {
            let count = moved.get(v)
            if state.get(v) && count != 1 { fail broken(b, index, usize.toU32(v), b"an exit does not move an outstanding owned value exactly once") }
            if !state.get(v) && count != 0 { fail broken(b, index, usize.toU32(v), b"an exit moves a value that is not outstanding") }
            moved.set(v, 0)
            v = v + 1
          }
          fail broken(b, index, NONE, b"an exit does not move an outstanding owned value exactly once")
        }
      }
      if inst.op == Op.Release { if state.get(u32.toUsize(inst.a)) { outstanding = outstanding - 1 } state.set(u32.toUsize(inst.a), false) }
      if inst.result != NONE && isOwned(f, inst.result) { if !state.get(u32.toUsize(inst.result)) { outstanding = outstanding + 1 } state.set(u32.toUsize(inst.result), true) }
      if inst.op == Op.Return {
        if isOwned(f, inst.a) { if state.get(u32.toUsize(inst.a)) { outstanding = outstanding - 1 } state.set(u32.toUsize(inst.a), false) }
        v = 0
        while v < n { if state.get(v) { fail broken(b, index, usize.toU32(v), b"an owned value outstanding at return (a leak)") } v = v + 1 }
      }
      if inst.edge != NONE {
        let mut e: u32 = 0
        while e < edgeCount(inst.op) {
          let edge = f.edge(inst.edge + e)
          v = 0
          while v < n { scratch.set(v, state.get(v)) v = v + 1 }
          let target = f.blocks.get(u32.toUsize(edge.target))
          let mut g: u32 = 0
          while g < edge.argCount {
            let arg = f.edgeArg(edge, g)
            run live(f, &state, b, index, arg)
            if isOwned(f, arg) && isOwned(f, f.paramAt(target, g)) {
              if !scratch.get(u32.toUsize(arg)) { fail broken(b, index, arg, b"an owned value passed twice on one edge") }
              scratch.set(u32.toUsize(arg), false)
            }
            g = g + 1
          }
          let tbase = u32.toUsize(edge.target) * n
          if known.get(u32.toUsize(edge.target)) {
            v = 0
            while v < n {
              if entry.get(tbase + v) != scratch.get(v) { fail broken(b, index, usize.toU32(v), b"predecessors disagree on the outstanding owned values of a block") }
              v = v + 1
            }
          } else {
            v = 0
            while v < n { entry.set(tbase + v, scratch.get(v)) v = v + 1 }
            known.set(u32.toUsize(edge.target), true)
          }
          e = e + 1
        }
      }
      i = i + 1
    }
    b = b + 1
  }
}

/// `v` may be read here: an owned value not yet consumed, a borrow whose owned root is live.
effect fn live(f: &Function, state: &List<bool>, b: u32, index: u32, v: u32) -> () ! VerifyError {
  let info = f.value(v)
  if info.ty != Type.Value { return () }
  if info.own == Own.Owned && !state.get(u32.toUsize(v)) { fail broken(b, index, v, b"an owned value used after it was consumed") }
  if info.own == Own.Borrowed && info.rootKind == RootKind.Value && !state.get(u32.toUsize(info.root)) { fail broken(b, index, v, b"a borrow used after its root was consumed") }
}

/// Operand and result types of the K operations (docs/jit/doubles.md).
fn numberTypes(f: &Function, inst: Inst) -> bool {
  let op = inst.op
  if op == Op.UnboxF64 { return typeOf(f, inst.a) == Type.Value && resultIs(f, inst, Type.F64, Own.Unboxed) }
  if op == Op.BoxF64 { return typeOf(f, inst.a) == Type.F64 && resultIs(f, inst, Type.Value, Own.Imm) }
  if op == Op.ToF64 { return typeOf(f, inst.a) == Type.I32 && resultIs(f, inst, Type.F64, Own.Unboxed) }
  if op == Op.AddF64 || op == Op.SubF64 || op == Op.MulF64 || op == Op.DivF64 || op == Op.ModF64 {
    return typeOf(f, inst.a) == Type.F64 && typeOf(f, inst.b) == Type.F64 && resultIs(f, inst, Type.F64, Own.Unboxed)
  }
  if op == Op.CmpF64 {
    return typeOf(f, inst.a) == Type.F64 && typeOf(f, inst.b) == Type.F64 && resultIs(f, inst, Type.Bool, Own.Unboxed) && inst.k >= 0 && inst.k <= 5
  }
  if op == Op.NegF64 || op == Op.SqrtF64 || op == Op.AbsF64 || op == Op.FloorF64 { return typeOf(f, inst.a) == Type.F64 && resultIs(f, inst, Type.F64, Own.Unboxed) }
  if op == Op.ToInt32 || op == Op.ExactI32 { return typeOf(f, inst.a) == Type.F64 && resultIs(f, inst, Type.I32, Own.Unboxed) }
  if op == Op.NotBool { return typeOf(f, inst.a) == Type.Bool && resultIs(f, inst, Type.Bool, Own.Unboxed) }
  if op == Op.Neg || op == Op.BitNot { return typeOf(f, inst.a) == Type.I32 && resultIs(f, inst, Type.I32, Own.Unboxed) }
  return typeOf(f, inst.a) == Type.I32 && typeOf(f, inst.b) == Type.I32 && resultIs(f, inst, Type.I32, Own.Unboxed)
}
