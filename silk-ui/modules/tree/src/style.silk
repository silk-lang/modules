            let items = values.asSlice()
            if items.length == 2 {
              let x = spacingOf(&items[0], &context)
              let y = spacingOf(&items[1], &context)
              if x >= 0.0 && y >= 0.0 {
                self.layout.borderSpacingX = x
                self.layout.borderSpacingY = y
              }
            }
          }
          _ => {
            let both = spacingOf(value, &context)
            if both >= 0.0 {
              self.layout.borderSpacingX = both
              self.layout.borderSpacingY = both
