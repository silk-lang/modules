//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The answer to a feature, from its area's module.
import caniuse_data { Answer, Feature }
import caniuse_css_cascade
import caniuse_css_layout
import caniuse_css_text
import caniuse_css_paint
import caniuse_svg
import caniuse_javascript
import caniuse_javascript_apis

pub fn answer(feature: Feature) -> Answer {
  if feature.area == "css-cascade" {
    return caniuse_css_cascade.answer(feature.id)
  }
  if feature.area == "css-layout" {
    return caniuse_css_layout.answer(feature.id)
  }
  if feature.area == "css-text" {
    return caniuse_css_text.answer(feature.id)
  }
  if feature.area == "css-paint" {
    return caniuse_css_paint.answer(feature.id)
  }
  if feature.area == "svg" {
    return caniuse_svg.answer(feature.id)
  }
  if feature.area == "javascript" {
    return caniuse_javascript.answer(feature.id)
  }
  if feature.area == "javascript-apis" {
    return caniuse_javascript_apis.answer(feature.id)
  }
  return Answer { support: "u", note: "" }
}
