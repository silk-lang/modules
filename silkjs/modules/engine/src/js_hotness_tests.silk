// Hot function reports (js_hotness): each way into a function body that counts
// reports its function once, through the embedder's handler, and only while one is set.
// Frameless leaf runs do not count.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.testing.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_engine { Engine }
import js_engine_host { EngineServices }
import js_heap { HeapHeader }
import js_value { ValueBits }
import js_owned_value { Value, ValueRef }
import js_realm { Realm, lendRealm }
import js_core_types { HostHook, NativeFunctionId, HOT_ENTRY_BUDGET }
import js_exceptions { JsException }
import js_runtime as runtime
import js_gc as gc
import js_eval as eval
import js_intrinsic_install as intrinsics
import native_stack as stack

const HANDLER: u32 = 7

pub struct Reports { pub count: usize, pub wrongCallback: usize, pub notBytecode: usize }
impl EngineServices for Reports {
  effect fn initializeShadowRealm<'r, 's, 'm>(engine: &mut Engine<'m, Self>, caller: Realm<'r>, created: Realm<'s>) -> () ! JsException ? &mut Allocator {}
  effect fn dynamicImportStarted<'r, 'v, 'w, 'x, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>, specifier: ValueRef<'v>, referrer: ValueRef<'w>, promise: ValueRef<'x>) -> ValueBits ! JsException ? &mut Allocator {
    return promise.dup().intoBits()
  }
  unsafe effect fn hotFunction<'m>(engine: &mut Engine<'m, Self>, rt: *mut HeapHeader,
    callback: NativeFunctionId, opaque: ?*mut u8, function: ValueBits) -> () ? &mut Allocator {
    engine.services.count = engine.services.count + 1
    match callback { NativeFunctionId.Host { id } => { if id != HANDLER { engine.services.wrongCallback = engine.services.wrongCallback + 1 } } _ => { engine.services.wrongCallback = engine.services.wrongCallback + 1 } }
    match function { ValueBits.FunctionBytecode { .. } => () _ => { engine.services.notBytecode = engine.services.notBytecode + 1 } }
  }
}
unsafe effect fn run_<'m>(engine: &mut Engine<'m, Reports>, context: *mut HeapHeader, source: &[u8]) -> () ! JsException ? &mut Allocator {
  let memory = engine.memory
  let result = run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"hotness.js", 0)
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), Value.intoBits(move result))
}
/// Runs source, which makes exactly hot functions hot by entries, and expects one report for
/// each. The script's own top-level loop may be reported once more, when an interrupt poll
/// lands on its back edge (loop hotness, js_hotness.loopPoll).
unsafe effect fn expectReports<'m>(engine: &mut Engine<'m, Reports>, context: *mut HeapHeader, hot: usize, source: &[u8], message: string<'static>) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  let before = engine.services.count
  run unsafe run_(&mut engine, context, source)
  run Testing.expect(engine.services.count == before + hot || engine.services.count == before + hot + 1, message)
}
unsafe effect fn exercise<'m>(engine: &mut Engine<'m, Reports>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  let rt = unsafe runtime.contextRuntime(context)
  run Testing.expect(HOT_ENTRY_BUDGET == 1000, "the scripts below call each function three budgets' worth")
  // No handler: budgets run out and re-arm, nothing is reported.
  run unsafe run_(&mut engine, context, b"function quiet(n){var t=0;for(var j=0;j<n;j++)t+=j;return t}for(var i=0;i<5000;i++)quiet(2)")
  run Testing.expect(engine.services.count == 0, "no handler, no report")
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: HANDLER }), opaque: Pointer.null<u8>() })
  run unsafe expectReports(&mut engine, context, 1,
    b"function framed(n){var t=0;for(var j=0;j<n;j++)t+=j;return t}for(var i=0;i<3000;i++)framed(2)",
    "an inline frame's function is reported once")
  // Frameless leaf runs (js_vm_leaf) are not counted: a tier would inline them into their hot caller.
  run unsafe expectReports(&mut engine, context, 0,
    b"function leaf(x){return x+1}var s=0;for(var i=0;i<3000;i++)s=leaf(s)",
    "a frameless leaf is not counted")
  run unsafe expectReports(&mut engine, context, 1,
    b"var a=[];for(var i=0;i<1500;i++)a.push((i*7919)%1500);a.sort(function cmp(p,q){if(p<q)return -1;if(p>q)return 1;return 0})",
    "a callback a native calls is reported once")
  run unsafe expectReports(&mut engine, context, 1,
    b"function* gen(){yield 1}for(var i=0;i<3000;i++)gen().next()",
    "a generator is reported once")
  run unsafe expectReports(&mut engine, context, 2,
    b"function deep(n){var t=0;for(var j=0;j<n;j++)t+=j;return t}function outer(n){return deep(n)}for(var i=0;i<3000;i++)outer(1)",
    "two hot functions are both reported")
  // Entered once, so never hot by entries: a poll on its back edge reports it.
  let looping = engine.services.count
  run unsafe run_(&mut engine, context, b"function long(n){var t=0;for(var j=0;j<n;j++)t=(t+j)|0;return t}long(50000)")
  run Testing.expect(engine.services.count == looping + 1, "a function that loops long is reported at a back-edge poll")
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.none(), opaque: Pointer.null<u8>() })
  let after = engine.services.count
  run unsafe run_(&mut engine, context, b"function late(n){var t=0;for(var j=0;j<n;j++)t+=j;return t}for(var i=0;i<5000;i++)late(2)")
  run Testing.expect(engine.services.count == after, "clearing the handler stops reports")
  run Testing.expect(engine.services.wrongCallback == 0 && engine.services.notBytecode == 0, "reports carry the handler and a FunctionBytecode")
}
test effect fn hotFunctionsAreReportedOnce() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: Reports { count: 0, wrongCallback: 0, notBytecode: 0 } }
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = run Effect.result(unsafe exercise(&mut engine, context)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), JsException | AssertionError<'static>>.Success { value: _ } => ()
    Result<(), JsException | AssertionError<'static>>.Failure { error } => { fail move error }
  }
  run Testing.expect(memory.stats().allocationCount == 0 && memory.stats().usedBytes == 0, "hot reports release everything they hold")
}
