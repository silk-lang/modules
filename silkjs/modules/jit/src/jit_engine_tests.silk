/// Fused argument/argument and local/argument indexed loads, including the event table's
/// null-prototype missing-name case. Changing a descriptor must immediately change the read.
unsafe effect fn exerciseKeys<'m>(engine: &mut Engine<'m, Compiling>, context: *mut HeapHeader) -> ()
  ! JsException | AssertionError<'static> ? &mut Allocator {
  drop run unsafe evaluate(&mut engine, context, b"function pick(table,key){var out;for(var j=0;j<1;j++)out=table[key];return out}function fromBus(bus,key){var table=bus.listeners,out;for(var j=0;j<1;j++)out=table[key];return out}var parent={inherited:9},rich=Object.create(parent),bare=Object.create(null);var sym=Symbol('same'),absent=Symbol('same');rich.a=3;rich[2]=11;parent[sym]=13;bare.a=5;var bus={listeners:bare};for(var i=0;i<320;i++){pick(rich,i%2?sym:2);fromBus(bus,'a')}")
  engine.services.jit.collect()
  let runs = engine.services.jit.runs
  let deopts = engine.services.jit.deopts
  let fast = run unsafe evaluate(&mut engine, context, b"var total=0;for(var i=0;i<96;i++){total+=pick(rich,i%2?'a':'inherited');total+=fromBus(bus,i%2?'a':'missing')||0;total+=pick(rich,i%2?sym:2);total+=pick(rich,absent)||0}total")
  engine.services.jit.collect()
  run Testing.expect(isInt(fast, 1968), "named reads return own or inherited values and undefined for an absent event")
  run Testing.expect(engine.services.jit.runs >= runs + 384 && engine.services.jit.deopts == deopts, "both keyed loads run compiled on hits and misses")
  let changed = run unsafe evaluate(&mut engine, context, b"var hits=0;rich.held={x:13};var saved=pick(rich,'held');delete rich.held;Object.setPrototypeOf(rich,{inherited:31});var sum=saved.x+pick(rich,'inherited');Object.defineProperty(rich,'a',{get(){hits++;return 7}});sum+=pick(rich,'a');var px=new Proxy({},{get(t,k){hits++;return 11}});sum+=pick(px,'key');sum+=pick(Object.create(px),sym);rich[-1]=17;sum+=pick(rich,-1);var key={toString(){hits++;return 'a'}};sum+=fromBus(bus,key);var thrown=0;Object.defineProperty(bare,'bad',{get(){hits++;throw 19}});try{fromBus(bus,'bad')}catch(e){thrown=e}sum+hits*100+thrown")
  run Testing.expect(isInt(changed, 614), "new prototypes are visible, returned objects stay owned, and getter, proxy, coercion and throw run once")
  run Testing.expect(engine.services.failures == 0, "the keyed reads compiled successfully")
}

