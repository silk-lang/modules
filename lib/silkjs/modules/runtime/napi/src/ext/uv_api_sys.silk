}

// --- Raw memory --------------------------------------------------------------------------------

unsafe fn errno() -> i32 { return unsafe Pointer.read<i32>(unsafe errorSlot()) }
unsafe fn setErrno(value: i32) -> () { unsafe Pointer.write<i32>(unsafe errorSlot(), value) }
// UV__ERR(errno).
unsafe fn failure() -> i32 { return 0 - unsafe errno() }
// A text literal that ends with a zero byte, as a C string.
fn cstr(text: &[u8]) -> *const u8 { return Pointer.fromRef<u8>(&text[0]) }
unsafe fn present(pointer: ?*const u8) -> *const u8 { return unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(pointer) }
unsafe fn presentMut(pointer: ?*mut u8) -> *mut u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer) }
unsafe fn offset(base: *const u8, index: usize) -> *const u8 { return unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(base), index) }
unsafe fn offsetMut(base: *mut u8, index: usize) -> *mut u8 { return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), index) }
unsafe fn byteAt(base: *const u8, index: usize) -> u8 { return unsafe Pointer.read<u8>(unsafe offset(base, index)) }
unsafe fn setByte(base: *mut u8, index: usize, value: u8) -> () { unsafe Pointer.write<u8>(unsafe offsetMut(base, index), value) }
unsafe fn bytes<T>(value: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(value) }
unsafe fn constBytes<T>(value: *const T) -> *const u8 { return unsafe Intrinsic.pointerReinterpret<*const T, *const u8>(value) }
unsafe fn copyBytes(dest: *mut u8, source: *const u8, count: usize) -> () {
  if count == 0 { return () }
  let _dest = unsafe memcpy(dest, source, count)
}
unsafe fn fill(dest: *mut u8, value: u8, count: usize) -> () {
  let mut n: usize = 0
  while n < count { unsafe setByte(dest, n, value) n = n + 1 }
}
// A pointer to the bytes of a word from Atomic: the inverse of Pointer.address.
unsafe fn addressPointer(address: u64) -> ?*mut u8 {
  let word = u64.toUsize(address)
  return unsafe Pointer.read<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*const usize, *const ?*mut u8>(Pointer.fromRef<usize>(&word)))
}
// A C function whose address is `address` (from dlsym or a bundle).
unsafe fn functionAt<F: Copy>(address: *mut u8) -> F {
  let word = Pointer.address<u8>(address)
  return unsafe Pointer.read<F>(unsafe Intrinsic.pointerReinterpret<*const usize, *const F>(Pointer.fromRef<usize>(&word)))
}
// strncpy(dest, source, count): the text, then zero bytes to `count`.
unsafe fn copyPadded(dest: *mut u8, source: *const u8, count: usize) -> () {
  let mut n: usize = 0
  let mut ended = false
  while n < count {
    let mut ch: u8 = 0
    if !ended { ch = unsafe byteAt(source, n) if ch == 0 { ended = true } }
    unsafe setByte(dest, n, ch)
    n = n + 1
  }
}
// uv__strscpy and snprintf("%s"): at most `size` - 1 bytes of `text` and a zero byte; nothing when
// `size` is 0.
unsafe fn copyCut(dest: *mut u8, text: *const u8, length: usize, size: usize) -> () {
  if size == 0 { return () }
  let mut count = length
  if count > size - 1 { count = size - 1 }
  unsafe copyBytes(dest, text, count)
  unsafe setByte(dest, count, 0)
}
// The `%d` of an int.
fn decimal(value: i32, out: &mut [u8; 12]) -> usize {
  let mut digits: [u8; 12] = [0; 12]
  let mut wide = i32.toI64(value)
  let mut n: usize = 0
  if wide < 0 { out[0] = 45 n = 1 wide = 0 - wide }
  let mut used: usize = 0
  while true {
    digits[used] = i64.toU8(48 + wide % 10)
    used = used + 1
    wide = wide / 10
    if wide == 0 { break }
  }
  while used > 0 { used = used - 1 out[n] = digits[used] n = n + 1 }
  return n
}
// "Unknown system error %d" with its zero byte, and its length.
fn unknownText(code: i32, out: &mut [u8; 40]) -> usize {
  let prefix = b"Unknown system error "
  let mut n: usize = 0
  while n < prefix.length { out[n] = prefix[n] n = n + 1 }
  let mut digits: [u8; 12] = [0; 12]
  let count = decimal(code, &mut digits)
  let mut k: usize = 0
  while k < count { out[n] = digits[k] n = n + 1 k = k + 1 }
  out[n] = 0
  return n
}
// uv__close: close, keeping errno; EINTR and EINPROGRESS count as closed.
unsafe fn closeKeeping(fd: i32) -> i32 {
  let saved = unsafe errno()
  let mut status = unsafe close(fd)
  if status == -1 {
    status = unsafe failure()
    if status == 0 - EINTR || status == 0 - EINPROGRESS { status = 0 }
    unsafe setErrno(saved)
  }
  return status
}
// uv__cloexec(fd, 1).
unsafe fn setCloexec(fd: i32) -> i32 {
  let mut status: i32 = -1
  while true {
    status = unsafe fcntl(fd, F_SETFD, FD_CLOEXEC)
    if status != -1 || unsafe errno() != EINTR { break }
  }
  if status != 0 { return unsafe failure() }
  return 0
}
// uv__nonblock(fd, 1): FIONBIO on Linux, fcntl on Darwin.
unsafe fn setNonblock(fd: i32) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    let mut flags: i32 = -1
    while true {
      flags = unsafe fcntl(fd, F_GETFL)
      if flags != -1 || unsafe errno() != EINTR { break }
    }
    if flags == -1 { return unsafe failure() }
    if (flags & O_NONBLOCK) != 0 { return 0 }
    let mut status: i32 = -1
    while true {
      status = unsafe fcntl(fd, F_SETFL, flags | O_NONBLOCK)
      if status != -1 || unsafe errno() != EINTR { break }
    }
    if status != 0 { return unsafe failure() }
    return 0
  } else {
    let mut set: i32 = 1
    let mut status: i32 = -1
    while true {
      status = unsafe ioctl(fd, FIONBIO, Pointer.fromMutRef<i32>(&mut set))
      if status != -1 || unsafe errno() != EINTR { break }
    }
    if status != 0 { return unsafe failure() }
    return 0
  }
}
// fstat into a buffer larger than `struct stat` on every target (144 bytes on Linux x86_64 and on
// Darwin, 128 on Linux aarch64).
@foreign(noCapture: .("value"))
unsafe extern "C" fn fstat(fd: i32, value: *mut [u64; 32]) -> i32
unsafe fn statusOf(fd: i32, status: &mut [u64; 32]) -> i32 { return unsafe fstat(fd, Pointer.fromMutRef<[u64; 32]>(&mut status)) }
// The S_IFMT bits of st_mode: a 32-bit field at offset 24 (Linux x86_64) or 16 (Linux aarch64), a
// 16-bit field at offset 4 (Darwin).
fn fileKind(status: &[u64; 32]) -> u32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return u64.wrappingToU32(u64.shiftRight(status[0], 32)) & 61440
  } else {
    static if Intrinsic.targetArchitecture() == "aarch64" { return u64.wrappingToU32(status[2]) & 61440 } else { return u64.wrappingToU32(status[3]) & 61440 }
  }
}
// sa_family of a `struct sockaddr`. Darwin keeps a length byte first.
unsafe fn addressFamily(address: *const u8) -> u32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return u8.toU32(unsafe byteAt(address, 1))
  } else {
    return u8.toU32(unsafe byteAt(address, 0)) | u32.shiftLeft(u8.toU32(unsafe byteAt(address, 1)), 8)
  }
}
// Whether `size` is a null pointer or holds 0: the check of libuv's buffer functions.
unsafe fn noCapacity(size: ?*mut usize) -> bool {
  if Pointer.isNull<usize>(size) { return true }
  return unsafe Pointer.read<usize>(unsafe Intrinsic.pointerRequalify<?*mut usize, *mut usize>(size)) == 0
}
unsafe fn sizeOf(size: ?*mut usize) -> *mut usize { return unsafe Intrinsic.pointerRequalify<?*mut usize, *mut usize>(size) }

// --- Threads -----------------------------------------------------------------------------------

/// The entry of a thread: `void (*)(void*)`.
pub type ThreadEntry = extern "C" fn(?*mut u8) -> ()
struct Start { entry: ThreadEntry, argument: ?*mut u8 }

// The start routine of every thread: moves the start record out and calls the caller's entry.
export "C" fn silkUvApiThreadStart(raw: ?*mut u8) -> ?*mut u8 {
  let start = unsafe Pointer.take<Start>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Start>(unsafe presentMut(raw)))
  unsafe free(raw)
  let entry = start.entry
  unsafe entry(start.argument)
  return Pointer.null<u8>()
}

// uv__min_stack_size: 8 KB, or PTHREAD_STACK_MIN when that is larger.
unsafe fn minimumStack() -> usize {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return 16384
  } else {
    // glibc's PTHREAD_STACK_MIN is sysconf(_SC_THREAD_STACK_MIN), converted to size_t.
    let least = i64.wrappingToUsize(unsafe sysconf(SC_THREAD_STACK_MIN))
    if 8192 < least { return i64.wrappingToUsize(unsafe sysconf(SC_THREAD_STACK_MIN)) }
    return 8192
  }
}
// uv__default_stack_size: glibc's 2 MB on Linux, the system's default (0) elsewhere.
fn defaultStack() -> usize {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return 0 } else { return 2097152 }
}
// uv__thread_stack_size: RLIMIT_STACK rounded down to the page size, if at least the minimum.
unsafe fn threadStackSize() -> usize {
  let mut limit: [u64; 2] = [0; 2]
  if unsafe getrlimit(RLIMIT_STACK, Pointer.fromMutRef<[u64; 2]>(&mut limit)) != 0 { return defaultStack() }
  if limit[0] == NO_LIMIT { return defaultStack() }
  let page = i64.wrappingToU64(i32.toI64(unsafe getpagesize()))
  let current = limit[0] - limit[0] % page
  if u64.toUsize(current) >= unsafe minimumStack() { return u64.toUsize(current) }
  return defaultStack()
}

/// uv_thread_create_ex: a joinable thread that runs `entry(argument)`, with the stack size of
/// `params` (rounded up to a page, at least the minimum) or else RLIMIT_STACK.
@threadCallbacks("entry")
pub unsafe export "C" fn uv_thread_create_ex(tid: *mut usize, params: *const ThreadOptions, entry: ThreadEntry, argument: ?*mut u8) -> i32 {
  let options = unsafe Pointer.read<ThreadOptions>(params)
  let mut stackSize: usize = 0
  if (options.flags & UV_THREAD_HAS_STACK_SIZE) != 0 { stackSize = options.stackSize }
  if stackSize == 0 {
    stackSize = unsafe threadStackSize()
  } else {
    let page = i32.toUsize(unsafe getpagesize())
    stackSize = usize.wrappingAdd(stackSize, page - 1) & usize.bitNot(page - 1)
    let least = unsafe minimumStack()
    if stackSize < least { stackSize = least }
  }
  let memory = unsafe calloc(1, Layout.of<Start>().bytes)
  if Pointer.isNull<u8>(memory) { return 0 - ENOMEM }
  unsafe Pointer.put<Start>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Start>(unsafe presentMut(memory)), Start { entry: entry, argument: argument })
  // pthread_attr_t is 56 bytes on Linux and 64 on Darwin.
  let mut storage: [u64; 8] = [0; 8]
  let attributes = unsafe bytes<u64>(Pointer.fromMutRef<u64>(&mut storage[0]))
  let mut given: ?*const u8 = Pointer.null<u8>()
  if stackSize > 0 {
    if unsafe pthread_attr_init(attributes) != 0 { unsafe abort() }
    if unsafe pthread_attr_setstacksize(attributes, stackSize) != 0 { unsafe abort() }
    given = attributes
  }
  let status = unsafe pthread_create(tid, given, silkUvApiThreadStart, memory)
  if stackSize > 0 { let _destroyed = unsafe pthread_attr_destroy(attributes) }
  if status != 0 { unsafe free(memory) }
  return 0 - status
}

/// uv_thread_create: uv_thread_create_ex without options.
@threadCallbacks("entry")
pub unsafe export "C" fn uv_thread_create(tid: *mut usize, entry: ThreadEntry, argument: ?*mut u8) -> i32 {
  let options = ThreadOptions { flags: 0, stackSize: 0 }
  return unsafe uv_thread_create_ex(tid, Pointer.fromRef<ThreadOptions>(&options), entry, argument)
}

pub export "C" fn uv_thread_detach(tid: *mut usize) -> i32 { return 0 - unsafe pthread_detach(unsafe Pointer.read<usize>(tid)) }
pub export "C" fn uv_thread_join(tid: *mut usize) -> i32 { return 0 - unsafe pthread_join(unsafe Pointer.read<usize>(tid), Pointer.null<?*mut u8>()) }
pub export "C" fn uv_thread_self() -> usize { return unsafe pthread_self() }
pub export "C" fn uv_thread_equal(first: *const usize, second: *const usize) -> i32 {
  return unsafe pthread_equal(unsafe Pointer.read<usize>(first), unsafe Pointer.read<usize>(second))
}

/// uv_thread_setname: names the calling thread, cut to 15 bytes on Linux and 63 on Darwin.
pub export "C" fn uv_thread_setname(name: ?*const u8) -> i32 {
  if Pointer.isNull<u8>(name) { return 0 - EINVAL }
  return unsafe os.uv_thread_setname(unsafe present(name))
}

/// uv_thread_getname: the name of `tid`, cut to `size` - 1 bytes and padded with zero bytes.
pub export "C" fn uv_thread_getname(tid: *mut usize, name: ?*mut u8, size: usize) -> i32 {
  if Pointer.isNull<u8>(name) || size == 0 { return 0 - EINVAL }
  let mut buffer: [u8; 64] = [0; 64]
  let status = unsafe pthread_getname_np(unsafe Pointer.read<usize>(tid), Pointer.fromMutRef<u8>(&mut buffer[0]), THREAD_NAME)
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    if status != 0 { return unsafe failure() }
  } else {
    if status != 0 { return 0 - status }
  }
  let out = unsafe presentMut(name)
  unsafe copyPadded(out, Pointer.fromRef<u8>(&buffer[0]), size - 1)
  unsafe setByte(out, size - 1, 0)
  return 0
}

/// uv_cpumask_size: CPU_SETSIZE on Linux, UV_ENOTSUP on Darwin.
pub export "C" fn uv_cpumask_size() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return 0 - ENOTSUP } else { return usize.toI32(CPU_SETSIZE) }
}

/// uv_thread_getaffinity: one byte per processor (1 when `tid` may run on it). Linux only.
pub export "C" fn uv_thread_getaffinity(tid: *mut usize, mask: *mut u8, size: usize) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return 0 - ENOTSUP
  } else {
    if size < CPU_SETSIZE { return 0 - EINVAL }
    let mut set: [u64; 16] = [0; 16]
    let status = unsafe pthread_getaffinity_np(unsafe Pointer.read<usize>(tid), 128, Pointer.fromMutRef<[u64; 16]>(&mut set))
    if status != 0 { return 0 - status }
    let mut n: usize = 0
    while n < CPU_SETSIZE {
      let mut bit: u8 = 0
      if (u64.shiftRight(set[n / 64], usize.toU64(n % 64)) & 1) != 0 { bit = 1 }
      unsafe setByte(mask, n, bit)
      n = n + 1
    }
    return 0
  }
}

/// uv_thread_setaffinity: lets `tid` run on the processors whose byte in `mask` is not zero, after
/// storing the previous mask in `previous` when that is not null. Linux only.
pub export "C" fn uv_thread_setaffinity(tid: *mut usize, mask: *mut u8, previous: ?*mut u8, size: usize) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return 0 - ENOTSUP
  } else {
    if size < CPU_SETSIZE { return 0 - EINVAL }
    if !Pointer.isNull<u8>(previous) {
      let status = unsafe uv_thread_getaffinity(tid, unsafe presentMut(previous), size)
      if status < 0 { return status }
    }
    let mut set: [u64; 16] = [0; 16]
    let mut n: usize = 0
    while n < CPU_SETSIZE {
      if unsafe byteAt(mask, n) != 0 { set[n / 64] = set[n / 64] | u64.shiftLeft(1, usize.toU64(n % 64)) }
      n = n + 1
    }
    return 0 - unsafe pthread_setaffinity_np(unsafe Pointer.read<usize>(tid), 128, Pointer.fromRef<[u64; 16]>(&set))
  }
}

/// uv_thread_getcpu: the processor the calling thread runs on. Linux only.
pub export "C" fn uv_thread_getcpu() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return 0 - ENOTSUP
  } else {
    let cpu = unsafe sched_getcpu()
    if cpu < 0 { return unsafe failure() }
    return cpu
  }
}

/// uv_thread_getpriority: the scheduling priority of `tid`; on Linux, the nice value of the calling
/// thread when it is `tid` and has the default policy.
pub export "C" fn uv_thread_getpriority(tid: usize, priority: ?*mut i32) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "linux" { let _id = unsafe gettid() }
  if Pointer.isNull<i32>(priority) { return 0 - EINVAL }
  let out = unsafe Intrinsic.pointerRequalify<?*mut i32, *mut i32>(priority)
  let mut policy: i32 = 0
  let mut parameter: [i32; 2] = [0; 2]
  if unsafe pthread_getschedparam(tid, Pointer.fromMutRef<i32>(&mut policy), Pointer.fromMutRef<[i32; 2]>(&mut parameter)) != 0 { return unsafe failure() }
  static if Intrinsic.targetOperatingSystem() == "linux" {
    if policy == SCHED_OTHER && unsafe pthread_equal(tid, unsafe pthread_self()) != 0 {
      unsafe setErrno(0)
      let value = unsafe getpriority(0, i32.wrappingToU32(unsafe gettid()))
      if value == -1 && unsafe errno() != 0 { return unsafe failure() }
      unsafe Pointer.write<i32>(out, value)
      return 0
    }
  }
  unsafe Pointer.write<i32>(out, parameter[0])
  return 0
}

/// uv_thread_setpriority: one of the five UV_THREAD_PRIORITY_* levels, mapped onto the range of the
/// thread's policy; on Linux, the nice value of the calling thread under the default policy.
pub export "C" fn uv_thread_setpriority(tid: usize, priority: i32) -> i32 {
  if priority < -2 || priority > 2 { return 0 - EINVAL }
  let mut policy: i32 = 0
  let mut parameter: [i32; 2] = [0; 2]
  if unsafe pthread_getschedparam(tid, Pointer.fromMutRef<i32>(&mut policy), Pointer.fromMutRef<[i32; 2]>(&mut parameter)) != 0 { return unsafe failure() }
  static if Intrinsic.targetOperatingSystem() == "linux" {
    if policy == SCHED_OTHER && unsafe pthread_equal(tid, unsafe pthread_self()) != 0 {
      let id = unsafe gettid()
      if unsafe setpriority(0, i32.wrappingToU32(id), 0 - priority * 2) != 0 { return unsafe failure() }
      return 0
    }
  }
  let least = unsafe sched_get_priority_min(policy)
  let most = unsafe sched_get_priority_max(policy)
  if least == -1 || most == -1 { return unsafe failure() }
  let range = most - least
  let mut wanted = least
  if priority == 2 { wanted = most }
  else if priority == 1 { wanted = least + range * 3 / 4 }
  else if priority == 0 { wanted = least + range / 2 }
  else if priority == -1 { wanted = least + range / 4 }
  if parameter[0] != wanted {
    parameter[0] = wanted
    if unsafe pthread_setschedparam(tid, policy, Pointer.fromRef<[i32; 2]>(&parameter)) != 0 { return unsafe failure() }
  }
  return 0
}

// --- Mutexes and read-write locks --------------------------------------------------------------

pub export "C" fn uv_mutex_init(mutex: *mut u8) -> i32 { return 0 - unsafe pthread_mutex_init(mutex, Pointer.null<u8>()) }

pub export "C" fn uv_mutex_init_recursive(mutex: *mut u8) -> i32 {
  // pthread_mutexattr_t is 4 bytes on Linux and 16 on Darwin.
  let mut storage: [u64; 2] = [0; 2]
  let attributes = unsafe bytes<u64>(Pointer.fromMutRef<u64>(&mut storage[0]))
  if unsafe pthread_mutexattr_init(attributes) != 0 { unsafe abort() }
  if unsafe pthread_mutexattr_settype(attributes, PTHREAD_MUTEX_RECURSIVE) != 0 { unsafe abort() }
  let status = unsafe pthread_mutex_init(mutex, attributes)
  if unsafe pthread_mutexattr_destroy(attributes) != 0 { unsafe abort() }
  return 0 - status
}

pub export "C" fn uv_mutex_destroy(mutex: *mut u8) -> () { if unsafe pthread_mutex_destroy(mutex) != 0 { unsafe abort() } }
pub export "C" fn uv_mutex_lock(mutex: *mut u8) -> () { if unsafe pthread_mutex_lock(mutex) != 0 { unsafe abort() } }
pub export "C" fn uv_mutex_unlock(mutex: *mut u8) -> () { if unsafe pthread_mutex_unlock(mutex) != 0 { unsafe abort() } }
// A try operation's status: UV_EBUSY when it would block, abort() on any other failure.
fn busy(status: i32) -> i32 {
  if status == 0 { return 0 }
  if status != EBUSY && status != EAGAIN { unsafe abort() }
  return 0 - EBUSY
}
pub export "C" fn uv_mutex_trylock(mutex: *mut u8) -> i32 { return busy(unsafe pthread_mutex_trylock(mutex)) }

pub export "C" fn uv_rwlock_init(lock: *mut u8) -> i32 { return 0 - unsafe pthread_rwlock_init(lock, Pointer.null<u8>()) }
pub export "C" fn uv_rwlock_destroy(lock: *mut u8) -> () { if unsafe pthread_rwlock_destroy(lock) != 0 { unsafe abort() } }
pub export "C" fn uv_rwlock_rdlock(lock: *mut u8) -> () { if unsafe pthread_rwlock_rdlock(lock) != 0 { unsafe abort() } }
pub export "C" fn uv_rwlock_tryrdlock(lock: *mut u8) -> i32 { return busy(unsafe pthread_rwlock_tryrdlock(lock)) }
pub export "C" fn uv_rwlock_rdunlock(lock: *mut u8) -> () { if unsafe pthread_rwlock_unlock(lock) != 0 { unsafe abort() } }
pub export "C" fn uv_rwlock_wrlock(lock: *mut u8) -> () { if unsafe pthread_rwlock_wrlock(lock) != 0 { unsafe abort() } }
pub export "C" fn uv_rwlock_trywrlock(lock: *mut u8) -> i32 { return busy(unsafe pthread_rwlock_trywrlock(lock)) }
pub export "C" fn uv_rwlock_wrunlock(lock: *mut u8) -> () { if unsafe pthread_rwlock_unlock(lock) != 0 { unsafe abort() } }

/// uv_once: runs `callback` once per `guard` (a pthread_once_t).
@callbacks("callback")
pub unsafe export "C" fn uv_once(guard: *mut u8, callback: extern "C" fn() -> ()) -> () {
  if unsafe pthread_once(guard, callback) != 0 { unsafe abort() }
}

// --- Semaphores --------------------------------------------------------------------------------

static if Intrinsic.targetOperatingSystem() == "darwin" {
  // uv_sem_t is a Mach semaphore_t.
  unsafe fn port(semaphore: *mut u8) -> u32 { return unsafe Pointer.read<u32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u32>(semaphore)) }
  unsafe fn semInit(semaphore: *mut u8, value: u32) -> i32 {
    let status = unsafe semaphore_create(taskSelf(), unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u32>(semaphore), 0, u32.wrappingToI32(value))
    if status == KERN_SUCCESS { return 0 }
    if status == KERN_INVALID_ARGUMENT { return 0 - EINVAL }
    if status == KERN_RESOURCE_SHORTAGE { return 0 - ENOMEM }
    unsafe abort()
    return 0 - EINVAL
  }
  unsafe fn semDestroy(semaphore: *mut u8) -> () { if unsafe semaphore_destroy(taskSelf(), unsafe port(semaphore)) != 0 { unsafe abort() } }
  unsafe fn semPost(semaphore: *mut u8) -> () { if unsafe semaphore_signal(unsafe port(semaphore)) != 0 { unsafe abort() } }
  unsafe fn semWait(semaphore: *mut u8) -> () {
    let mut status = KERN_ABORTED
    while status == KERN_ABORTED { status = unsafe semaphore_wait(unsafe port(semaphore)) }
    if status != KERN_SUCCESS { unsafe abort() }
  }
  unsafe fn semTrywait(semaphore: *mut u8) -> i32 {
    let status = unsafe semaphore_timedwait(unsafe port(semaphore), MachTimespec { seconds: 0, nanoseconds: 0 })
    if status == KERN_SUCCESS { return 0 }
    if status == KERN_OPERATION_TIMED_OUT { return 0 - EAGAIN }
    unsafe abort()
    return 0 - EINVAL
  }
} else {
  unsafe fn semInit(semaphore: *mut u8, value: u32) -> i32 {
    if unsafe sem_init(semaphore, 0, value) != 0 { return unsafe failure() }
    return 0
  }
  unsafe fn semDestroy(semaphore: *mut u8) -> () { if unsafe sem_destroy(semaphore) != 0 { unsafe abort() } }
  unsafe fn semPost(semaphore: *mut u8) -> () { if unsafe sem_post(semaphore) != 0 { unsafe abort() } }
  unsafe fn semWait(semaphore: *mut u8) -> () {
    let mut status: i32 = -1
    while true {
      status = unsafe sem_wait(semaphore)
      if status != -1 || unsafe errno() != EINTR { break }
    }
    if status != 0 { unsafe abort() }
  }
  unsafe fn semTrywait(semaphore: *mut u8) -> i32 {
    let mut status: i32 = -1
    while true {
      status = unsafe sem_trywait(semaphore)
      if status != -1 || unsafe errno() != EINTR { break }
    }
    if status != 0 {
      if unsafe errno() == EAGAIN { return 0 - EAGAIN }
      unsafe abort()
    }
    return 0
  }
}

// --- Condition variables -----------------------------------------------------------------------

static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe fn condInit(condition: *mut u8) -> i32 { return 0 - unsafe pthread_cond_init(condition, Pointer.null<u8>()) }
  unsafe fn condDestroy(condition: *mut u8) -> () {
    // libuv waits on the condition for a nanosecond first: destroying one that was signalled but
    // never waited on is reported to crash.
    let mut storage: [u64; 8] = [0; 8]
    let mutex = unsafe bytes<u64>(Pointer.fromMutRef<u64>(&mut storage[0]))
    if unsafe pthread_mutex_init(mutex, Pointer.null<u8>()) != 0 { unsafe abort() }
    if unsafe pthread_mutex_lock(mutex) != 0 { unsafe abort() }
    let wait = Timespec { seconds: 0, nanoseconds: 1 }
    let status = unsafe pthread_cond_timedwait_relative_np(condition, mutex, Pointer.fromRef<Timespec>(&wait))
    if status != 0 && status != ETIMEDOUT { unsafe abort() }
    if unsafe pthread_mutex_unlock(mutex) != 0 { unsafe abort() }
    if unsafe pthread_mutex_destroy(mutex) != 0 { unsafe abort() }
    if unsafe pthread_cond_destroy(condition) != 0 { unsafe abort() }
  }
  unsafe fn condWait(condition: *mut u8, mutex: *mut u8) -> () {
    unsafe setErrno(0)
    let status = unsafe pthread_cond_wait(condition, mutex)
    // macOS through 13.6 can fail a wait with EINVAL and errno EBUSY (libuv issue 4165).
    if status == EINVAL && unsafe errno() == EBUSY { return () }
    if status != 0 { unsafe abort() }
  }
  unsafe fn condTimedwait(condition: *mut u8, mutex: *mut u8, timeout: u64) -> i32 {
    let wait = Timespec { seconds: u64.wrappingToI64(timeout / NANOSEC), nanoseconds: u64.wrappingToI64(timeout % NANOSEC) }
    let status = unsafe pthread_cond_timedwait_relative_np(condition, mutex, Pointer.fromRef<Timespec>(&wait))
    if status == 0 { return 0 }
    if status == ETIMEDOUT { return 0 - ETIMEDOUT }
    unsafe abort()
    return 0 - EINVAL
  }
} else {
  unsafe fn condInit(condition: *mut u8) -> i32 {
    // pthread_condattr_t is 4 bytes.
    let mut storage: [u64; 1] = [0; 1]
    let attributes = unsafe bytes<u64>(Pointer.fromMutRef<u64>(&mut storage[0]))
    let mut status = unsafe pthread_condattr_init(attributes)
    if status != 0 { return 0 - status }
    status = unsafe pthread_condattr_setclock(attributes, CLOCK_MONOTONIC)
    if status == 0 {
      status = unsafe pthread_cond_init(condition, attributes)
      if status == 0 {
        status = unsafe pthread_condattr_destroy(attributes)
        if status == 0 { return 0 }
        let _destroyed = unsafe pthread_cond_destroy(condition)
      }
    }
    let _released = unsafe pthread_condattr_destroy(attributes)
    return 0 - status
  }
  unsafe fn condDestroy(condition: *mut u8) -> () { if unsafe pthread_cond_destroy(condition) != 0 { unsafe abort() } }
  unsafe fn condWait(condition: *mut u8, mutex: *mut u8) -> () { if unsafe pthread_cond_wait(condition, mutex) != 0 { unsafe abort() } }
  unsafe fn condTimedwait(condition: *mut u8, mutex: *mut u8, timeout: u64) -> i32 {
    // The deadline is on the monotonic clock that uv_cond_init selected.
    let deadline = u64.wrappingAdd(timeout, unsafe os.uv_hrtime())
    let at = Timespec { seconds: u64.wrappingToI64(deadline / NANOSEC), nanoseconds: u64.wrappingToI64(deadline % NANOSEC) }
    let status = unsafe pthread_cond_timedwait(condition, mutex, Pointer.fromRef<Timespec>(&at))
    if status == 0 { return 0 }
    if status == ETIMEDOUT { return 0 - ETIMEDOUT }
    unsafe abort()
    return 0 - EINVAL
  }
}
pub export "C" fn uv_cond_signal(condition: *mut u8) -> () { if unsafe pthread_cond_signal(condition) != 0 { unsafe abort() } }
pub export "C" fn uv_cond_broadcast(condition: *mut u8) -> () { if unsafe pthread_cond_broadcast(condition) != 0 { unsafe abort() } }

// --- Barriers ----------------------------------------------------------------------------------

static if Intrinsic.targetOperatingSystem() == "darwin" {
  // Darwin has no pthread barrier: uv_barrier_t holds a pointer to libuv's own, a mutex, a
  // condition and three counts (src/thread-common.c).
  unsafe fn barrierOf(barrier: *mut u8) -> ?*mut Barrier { return unsafe Pointer.read<?*mut Barrier>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut Barrier>(barrier)) }
  unsafe fn barrierInit(barrier: ?*mut u8, count: u32) -> i32 {
    if Pointer.isNull<u8>(barrier) || count == 0 { return 0 - EINVAL }
    let memory = unsafe os.uvMalloc(Layout.of<Barrier>().bytes)
    if Pointer.isNull<u8>(memory) { return 0 - ENOMEM }
    let made = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Barrier>(unsafe presentMut(memory))
    unsafe Pointer.put<Barrier>(made, Barrier { mutex: [0; 8], condition: [0; 6], threshold: count, entered: 0, leaving: 0 })
    let mut anchor = ()
    let b = unsafe Pointer.borrowMut<(), Barrier>(&mut anchor, made)
    let mut status = unsafe uv_mutex_init(unsafe bytes<u64>(Pointer.fromMutRef<u64>(&mut b.mutex[0])))
    if status == 0 {
      status = unsafe uv_cond_init(unsafe bytes<u64>(Pointer.fromMutRef<u64>(&mut b.condition[0])))
      if status == 0 {
        unsafe Pointer.write<?*mut Barrier>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut Barrier>(unsafe presentMut(barrier)), made)
        return 0
      }
      unsafe uv_mutex_destroy(unsafe bytes<u64>(Pointer.fromMutRef<u64>(&mut b.mutex[0])))
    }
    unsafe os.uvFree(memory)
    return status
  }
  // Raw pointers to the fields of a barrier: other threads change the counts under its mutex, so
  // no reference to the record is held across a wait.
  struct BarrierFields { mutex: *mut u8, condition: *mut u8, threshold: *mut u32, entered: *mut u32, leaving: *mut u32 }
  unsafe fn fieldsOf(made: *mut Barrier) -> BarrierFields {
    let mut anchor = ()
    let b = unsafe Pointer.borrowMut<(), Barrier>(&mut anchor, made)
    return BarrierFields {
      mutex: unsafe bytes<u64>(Pointer.fromMutRef<u64>(&mut b.mutex[0])), condition: unsafe bytes<u64>(Pointer.fromMutRef<u64>(&mut b.condition[0])),
      threshold: Pointer.fromMutRef<u32>(&mut b.threshold), entered: Pointer.fromMutRef<u32>(&mut b.entered), leaving: Pointer.fromMutRef<u32>(&mut b.leaving),
    }
  }
  unsafe fn barrierWait(barrier: ?*mut u8) -> i32 {
    if Pointer.isNull<u8>(barrier) { return 0 - EINVAL }
    let found = unsafe barrierOf(unsafe presentMut(barrier))
    if Pointer.isNull<Barrier>(found) { return 0 - EINVAL }
    let f = unsafe fieldsOf(unsafe Intrinsic.pointerRequalify<?*mut Barrier, *mut Barrier>(found))
    unsafe uv_mutex_lock(f.mutex)
    while unsafe Pointer.read<u32>(f.leaving) != 0 { unsafe uv_cond_wait(f.condition, f.mutex) }
    let entered = u32.wrappingAdd(unsafe Pointer.read<u32>(f.entered), 1)
    unsafe Pointer.write<u32>(f.entered, entered)
    if entered == unsafe Pointer.read<u32>(f.threshold) {
      unsafe Pointer.write<u32>(f.entered, 0)
      unsafe Pointer.write<u32>(f.leaving, unsafe Pointer.read<u32>(f.threshold))
      unsafe uv_cond_broadcast(f.condition)
    } else {
      while true {
        unsafe uv_cond_wait(f.condition, f.mutex)
        if unsafe Pointer.read<u32>(f.entered) == 0 { break }
      }
    }
    let leaving = u32.wrappingSubtract(unsafe Pointer.read<u32>(f.leaving), 1)
    unsafe Pointer.write<u32>(f.leaving, leaving)
    let mut last: i32 = 0
    if leaving == 0 { last = 1 unsafe uv_cond_broadcast(f.condition) }
    unsafe uv_mutex_unlock(f.mutex)
    return last
  }
  unsafe fn barrierDestroy(barrier: *mut u8) -> () {
    let made = unsafe Intrinsic.pointerRequalify<?*mut Barrier, *mut Barrier>(unsafe barrierOf(barrier))
    let f = unsafe fieldsOf(made)
    unsafe uv_mutex_lock(f.mutex)
    while unsafe Pointer.read<u32>(f.leaving) != 0 { unsafe uv_cond_wait(f.condition, f.mutex) }
    if unsafe Pointer.read<u32>(f.entered) != 0 { unsafe abort() }
    unsafe uv_mutex_unlock(f.mutex)
    unsafe uv_mutex_destroy(f.mutex)
    unsafe uv_cond_destroy(f.condition)
    unsafe os.uvFree(unsafe bytes<Barrier>(made))
    unsafe Pointer.write<?*mut Barrier>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut Barrier>(barrier), Pointer.null<Barrier>())
  }
} else {
  unsafe fn barrierInit(barrier: ?*mut u8, count: u32) -> i32 { return 0 - unsafe pthread_barrier_init(unsafe presentMut(barrier), Pointer.null<u8>(), count) }
  unsafe fn barrierWait(barrier: ?*mut u8) -> i32 {
    let status = unsafe pthread_barrier_wait(unsafe presentMut(barrier))
    if status != 0 && status != PTHREAD_BARRIER_SERIAL_THREAD { unsafe abort() }
    if status == PTHREAD_BARRIER_SERIAL_THREAD { return 1 }
    return 0
  }
  unsafe fn barrierDestroy(barrier: *mut u8) -> () { if unsafe pthread_barrier_destroy(barrier) != 0 { unsafe abort() } }
}

// The exports of the three sections above; their bodies are the platform's.
pub export "C" fn uv_sem_init(semaphore: *mut u8, value: u32) -> i32 { return unsafe semInit(semaphore, value) }
pub export "C" fn uv_sem_destroy(semaphore: *mut u8) -> () { unsafe semDestroy(semaphore) }
pub export "C" fn uv_sem_post(semaphore: *mut u8) -> () { unsafe semPost(semaphore) }
pub export "C" fn uv_sem_wait(semaphore: *mut u8) -> () { unsafe semWait(semaphore) }
pub export "C" fn uv_sem_trywait(semaphore: *mut u8) -> i32 { return unsafe semTrywait(semaphore) }
pub export "C" fn uv_cond_init(condition: *mut u8) -> i32 { return unsafe condInit(condition) }
pub export "C" fn uv_cond_destroy(condition: *mut u8) -> () { unsafe condDestroy(condition) }
pub export "C" fn uv_cond_wait(condition: *mut u8, mutex: *mut u8) -> () { unsafe condWait(condition, mutex) }
pub export "C" fn uv_cond_timedwait(condition: *mut u8, mutex: *mut u8, timeout: u64) -> i32 { return unsafe condTimedwait(condition, mutex, timeout) }
pub export "C" fn uv_barrier_init(barrier: ?*mut u8, count: u32) -> i32 { return unsafe barrierInit(barrier, count) }
pub export "C" fn uv_barrier_wait(barrier: ?*mut u8) -> i32 { return unsafe barrierWait(barrier) }
pub export "C" fn uv_barrier_destroy(barrier: *mut u8) -> () { unsafe barrierDestroy(barrier) }

// --- Thread-local keys -------------------------------------------------------------------------

pub export "C" fn uv_key_create(key: *mut Key) -> i32 { return 0 - unsafe pthread_key_create(key, 0) }
pub export "C" fn uv_key_delete(key: *mut Key) -> () { if unsafe pthread_key_delete(unsafe Pointer.read<Key>(key)) != 0 { unsafe abort() } }
pub export "C" fn uv_key_get(key: *mut Key) -> ?*mut u8 { return unsafe pthread_getspecific(unsafe Pointer.read<Key>(key)) }
pub export "C" fn uv_key_set(key: *mut Key, value: ?*mut u8) -> () {
  if unsafe pthread_setspecific(unsafe Pointer.read<Key>(key), value) != 0 { unsafe abort() }
}

// --- Errors and versions -----------------------------------------------------------------------

// uv__unknown_err_code: "Unknown system error N" in a new allocation that is never freed, or the
// static text without the number when there is no memory. libuv formats it into 32 bytes, which
// cuts the text of INT_MIN to "Unknown system error -214748364".
unsafe fn unknownCode(code: i32) -> *const u8 {
  let mut text: [u8; 40] = [0; 40]
  let _length = unknownText(code, &mut text)
  text[31] = 0
  let copy = unsafe os.uvStrdup(Pointer.fromRef<u8>(&text[0]))
  if Pointer.isNull<u8>(copy) { return cstr(b"Unknown system error\0") }
  return unsafe presentMut(copy)
}
// uv_err_name_r and uv_strerror_r: the text of `code`, cut to fit `size` with its zero byte.
unsafe fn errorText(code: i32, buffer: *mut u8, size: usize, names: bool) -> *mut u8 {
  let index = errors.indexOf(code)
  if index < errors.count() {
    let mut text = errors.messageText(index)
    if names { text = errors.nameText(index) }
    unsafe copyCut(buffer, Pointer.fromRef<u8>(&text[0]), text.length - 1, size)
  } else {
    let mut text: [u8; 40] = [0; 40]
    let length = unknownText(code, &mut text)
    unsafe copyCut(buffer, Pointer.fromRef<u8>(&text[0]), length, size)
  }
  return buffer
}

/// uv_err_name: the name of a libuv status, as "EINVAL"; for an unknown status, a new text that is
/// never released, as libuv does.
pub export "C" fn uv_err_name(code: i32) -> *const u8 {
  let index = errors.indexOf(code)
  if index < errors.count() { let text = errors.nameText(index) return Pointer.fromRef<u8>(&text[0]) }
  return unsafe unknownCode(code)
}
pub export "C" fn uv_err_name_r(code: i32, buffer: *mut u8, size: usize) -> *mut u8 { return unsafe errorText(code, buffer, size, true) }
/// uv_strerror: the message of a libuv status; for an unknown status, a new text that is never
/// released, as libuv does.
pub export "C" fn uv_strerror(code: i32) -> *const u8 {
  let index = errors.indexOf(code)
  if index < errors.count() { let text = errors.messageText(index) return Pointer.fromRef<u8>(&text[0]) }
  return unsafe unknownCode(code)
}
pub export "C" fn uv_strerror_r(code: i32, buffer: *mut u8, size: usize) -> *mut u8 { return unsafe errorText(code, buffer, size, false) }
pub export "C" fn uv_translate_sys_error(code: i32) -> i32 { return unsafe os.uv_translate_sys_error(code) }
pub export "C" fn uv_version() -> u32 { return VERSION_HEX }
pub export "C" fn uv_version_string() -> *const u8 { return unsafe os.uv_version_string() }
pub export "C" fn uv_buf_init(base: ?*mut u8, length: u32) -> UvBuf { return UvBuf { base: base, len: u32.toUsize(length) } }

// --- Shared libraries --------------------------------------------------------------------------

// uv__dlerror: replaces the library's message with dlerror()'s; -1 when there was one.
unsafe fn saveError(library: *mut Lib) -> i32 {
  let mut anchor = ()
  let lib = unsafe Pointer.borrowMut<(), Lib>(&mut anchor, library)
  unsafe os.uvFree(lib.errmsg)
  let message = unsafe dlerror()
  if Pointer.isNull<u8>(message) { lib.errmsg = Pointer.null<u8>() return 0 }
  lib.errmsg = unsafe os.uvStrdup(unsafe present(message))
  return -1
}
pub export "C" fn uv_dlopen(filename: ?*const u8, library: *mut Lib) -> i32 {
  let _cleared = unsafe dlerror()
  let handle = unsafe dlopen(filename, RTLD_LAZY)
  unsafe Pointer.put<Lib>(library, Lib { handle: handle, errmsg: Pointer.null<u8>() })
  if !Pointer.isNull<u8>(handle) { return 0 }
  return unsafe saveError(library)
}
pub export "C" fn uv_dlclose(library: *mut Lib) -> () {
  let mut anchor = ()
  let lib = unsafe Pointer.borrowMut<(), Lib>(&mut anchor, library)
  unsafe os.uvFree(lib.errmsg)
  lib.errmsg = Pointer.null<u8>()
  if !Pointer.isNull<u8>(lib.handle) {
    let _ignored = unsafe dlclose(unsafe presentMut(lib.handle))
    lib.handle = Pointer.null<u8>()
  }
}
pub export "C" fn uv_dlsym(library: *mut Lib, name: *const u8, symbol: *mut ?*mut u8) -> i32 {
  let _cleared = unsafe dlerror()
  let lib = unsafe Pointer.read<Lib>(library)
  let handle = lib.handle
  let found = unsafe dlsym(handle, name)
  unsafe Pointer.write<?*mut u8>(symbol, found)
  if !Pointer.isNull<u8>(found) { return 0 }
  return unsafe saveError(library)
}
pub export "C" fn uv_dlerror(library: *const Lib) -> *const u8 {
  let lib = unsafe Pointer.read<Lib>(library)
  let message = lib.errmsg
  if Pointer.isNull<u8>(message) { return cstr(b"no error\0") }
  return unsafe presentMut(message)
}

// --- Allocator and shutdown --------------------------------------------------------------------

// What a caller of uv_replace_allocator passes: each may be null.
type GivenMalloc = ?extern "C" fn(usize) -> ?*mut u8
type GivenRealloc = ?extern "C" fn(?*mut u8, usize) -> ?*mut u8
type GivenCalloc = ?extern "C" fn(usize, usize) -> ?*mut u8
type GivenFree = ?extern "C" fn(?*mut u8) -> ()
/// uv_replace_allocator: UV_EINVAL unless all four functions are given.
@threadCallbacks("mallocFunction", "reallocFunction", "callocFunction", "freeFunction")
pub unsafe export "C" fn uv_replace_allocator(mallocFunction: GivenMalloc, reallocFunction: GivenRealloc, callocFunction: GivenCalloc, freeFunction: GivenFree) -> i32 {
  if Intrinsic.pointerIsNull<GivenMalloc>(mallocFunction) || Intrinsic.pointerIsNull<GivenRealloc>(reallocFunction) || Intrinsic.pointerIsNull<GivenCalloc>(callocFunction) || Intrinsic.pointerIsNull<GivenFree>(freeFunction) { return 0 - EINVAL }
  unsafe os.replaceAllocator(
    unsafe Intrinsic.pointerRequalify<GivenMalloc, MallocFunction>(mallocFunction),
    unsafe Intrinsic.pointerRequalify<GivenRealloc, ReallocFunction>(reallocFunction),
    unsafe Intrinsic.pointerRequalify<GivenCalloc, CallocFunction>(callocFunction),
    unsafe Intrinsic.pointerRequalify<GivenFree, FreeFunction>(freeFunction))
  return 0
}

fn shutdownWord() -> *mut u64 { return Intrinsic.processWord() }
/// uv_library_shutdown: once per process, releases the copy of the arguments that uv_setup_args
/// made, after which the process title functions answer UV_ENOBUFS again.
pub export "C" fn uv_library_shutdown() -> () {
  if unsafe Atomic.swap<u64>(shutdownWord(), 1, MemoryOrder.Relaxed) != 0 { return () }
  let state = unsafe titleState()
  let mut anchor = ()
  let t = unsafe Pointer.borrowMut<(), Title>(&mut anchor, state)
  unsafe os.uvFree(t.arguments)
  t.arguments = Pointer.null<u8>()
}

// --- Descriptors -------------------------------------------------------------------------------

pub export "C" fn uv_guess_handle(fd: i32) -> i32 {
  if fd < 0 { return UV_UNKNOWN_HANDLE }
  if unsafe isatty(fd) != 0 { return UV_TTY }
  let mut status: [u64; 32] = [0; 32]
  if unsafe statusOf(fd, &mut status) != 0 { return UV_UNKNOWN_HANDLE }
  let kind = fileKind(&status)
  // S_IFREG, S_IFCHR, S_IFIFO, S_IFSOCK.
  if kind == 32768 || kind == 8192 { return UV_FILE }
  if kind == 4096 { return UV_NAMED_PIPE }
  if kind != 49152 { return UV_UNKNOWN_HANDLE }
  let mut address: [u64; 16] = [0; 16]
  let mut length: u32 = 128
  if unsafe getsockname(fd, unsafe bytes<u64>(Pointer.fromMutRef<u64>(&mut address[0])), Pointer.fromMutRef<u32>(&mut length)) != 0 { return UV_UNKNOWN_HANDLE }
  let mut socketKind: i32 = 0
  let mut size: u32 = 4
  if unsafe getsockopt(fd, SOL_SOCKET, SO_TYPE, unsafe bytes<i32>(Pointer.fromMutRef<i32>(&mut socketKind)), Pointer.fromMutRef<u32>(&mut size)) != 0 { return UV_UNKNOWN_HANDLE }
  let family = unsafe addressFamily(unsafe constBytes<u64>(Pointer.fromRef<u64>(&address[0])))
  if socketKind == SOCK_DGRAM && (family == AF_INET || family == AF_INET6) { return UV_UDP }
  if socketKind == SOCK_STREAM {
    if family == AF_INET || family == AF_INET6 { return UV_TCP }
    if family == AF_UNIX_FAMILY { return UV_NAMED_PIPE }
  }
  return UV_UNKNOWN_HANDLE
}

// The two descriptors of a new pipe or socket pair, with non-blocking mode for each one that asks
// for it; both are closed when that fails.
unsafe fn finishPair(fds: *mut i32, pair: &[i32; 2], first: i32, second: i32) -> i32 {
  let mut status: i32 = 0
  if (first & UV_NONBLOCK_PIPE) != 0 { status = unsafe setNonblock(pair[0]) }
  if status == 0 && (second & UV_NONBLOCK_PIPE) != 0 { status = unsafe setNonblock(pair[1]) }
  if status != 0 {
    let _first = unsafe closeKeeping(pair[0])
    let _second = unsafe closeKeeping(pair[1])
    return status
  }
  unsafe Pointer.write<i32>(fds, pair[0])
  unsafe Pointer.write<i32>(unsafe Pointer.atMut<i32>(unsafe Pointer.assumeManyMut<i32>(fds), 1), pair[1])
  return 0
}

/// uv_socketpair: a connected pair of AF_UNIX sockets of `kind`, close-on-exec.
pub export "C" fn uv_socketpair(kind: i32, protocol: i32, fds: *mut i32, first: i32, second: i32) -> i32 {
  let mut pair: [i32; 2] = [0; 2]
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    if unsafe socketpair(AF_UNIX, kind, protocol, Pointer.fromMutRef<i32>(&mut pair[0])) != 0 { return unsafe failure() }
    let mut status = unsafe setCloexec(pair[0])
    if status == 0 { status = unsafe setCloexec(pair[1]) }
    if status != 0 {
      let _first = unsafe closeKeeping(pair[0])
      let _second = unsafe closeKeeping(pair[1])
      return status
    }
  } else {
    let mut flags = kind | SOCK_CLOEXEC
    if (first & UV_NONBLOCK_PIPE) != 0 && (second & UV_NONBLOCK_PIPE) != 0 { flags = flags | SOCK_NONBLOCK }
    if unsafe socketpair(AF_UNIX, flags, protocol, Pointer.fromMutRef<i32>(&mut pair[0])) != 0 { return unsafe failure() }
    if (flags & O_NONBLOCK) != 0 { return unsafe finishPair(fds, &pair, 0, 0) }
  }
  return unsafe finishPair(fds, &pair, first, second)
}

/// uv_pipe: a pipe, close-on-exec, with each end non-blocking when its flags ask for it.
pub export "C" fn uv_pipe(fds: *mut i32, readFlags: i32, writeFlags: i32) -> i32 {
  let mut pair: [i32; 2] = [0; 2]
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    if unsafe pipe(Pointer.fromMutRef<i32>(&mut pair[0])) != 0 { return unsafe failure() }
    let mut status = unsafe setCloexec(pair[0])
    if status == 0 { status = unsafe setCloexec(pair[1]) }
    if status != 0 {
      let _first = unsafe closeKeeping(pair[0])
      let _second = unsafe closeKeeping(pair[1])
      return status
    }
  } else {
    let mut flags = O_CLOEXEC
    if (readFlags & UV_NONBLOCK_PIPE) != 0 && (writeFlags & UV_NONBLOCK_PIPE) != 0 { flags = flags | O_NONBLOCK }
    if unsafe pipe2(Pointer.fromMutRef<i32>(&mut pair[0]), flags) != 0 { return unsafe failure() }
    if (flags & O_NONBLOCK) != 0 { return unsafe finishPair(fds, &pair, 0, 0) }
  }
  return unsafe finishPair(fds, &pair, readFlags, writeFlags)
}

pub export "C" fn uv_open_osfhandle(fd: i32) -> i32 { return fd }
pub export "C" fn uv_get_osfhandle(fd: i32) -> i32 { return fd }

/// uv_disable_stdio_inheritance: close-on-exec on every open descriptor; the first sixteen are
/// always tried, then the first failure ends it.
pub export "C" fn uv_disable_stdio_inheritance() -> () {
  let mut fd: i32 = 0
  while true {
    if unsafe setCloexec(fd) != 0 && fd > 15 { break }
    fd = fd + 1
  }
}

// --- UTF-16 and WTF-8 (src/idna.c) -------------------------------------------------------------

// uv__wtf8_decode1: the code point at `text`[`pos.*`], leaving `pos` at its last byte; -1 when the
// bytes are not WTF-8 (overlong three-byte forms and surrogates are accepted, as in libuv).
unsafe fn decodeWtf8(text: *const u8, pos: &mut usize) -> i32 {
  let b1 = u8.toU32(unsafe byteAt(text, pos.*))
  if b1 <= 127 { return u32.toI32(b1) }
  if b1 < 194 { return -1 }
  let mut point = b1
  pos.* = pos.* + 1
  let b2 = u8.toU32(unsafe byteAt(text, pos.*))
  if (b2 & 192) != 128 { return -1 }
  point = u32.shiftLeft(point, 6) | (b2 & 63)
  if b1 <= 223 { return u32.toI32(point & 2047) }
  pos.* = pos.* + 1
  let b3 = u8.toU32(unsafe byteAt(text, pos.*))
  if (b3 & 192) != 128 { return -1 }
  point = u32.shiftLeft(point, 6) | (b3 & 63)
  if b1 <= 239 { return u32.toI32(point & 65535) }
  pos.* = pos.* + 1
  let b4 = u8.toU32(unsafe byteAt(text, pos.*))
  if (b4 & 192) != 128 { return -1 }
  point = u32.shiftLeft(point, 6) | (b4 & 63)
  if b1 <= 244 {
    point = point & 2097151
    if point <= 1114111 { return u32.toI32(point) }
  }
  return -1
}

/// uv_wtf8_length_as_utf16: the UTF-16 units of `text` with its terminating zero, or -1.
pub export "C" fn uv_wtf8_length_as_utf16(text: *const u8) -> isize {
  let mut length: isize = 0
  let mut pos: usize = 0
  while true {
    let point = unsafe decodeWtf8(text, &mut pos)
    if point < 0 { return -1 }
    if point > 65535 { length = length + 1 }
    length = length + 1
    let last = unsafe byteAt(text, pos)
    pos = pos + 1
    if last == 0 { break }
  }
  return length
}

/// uv_wtf8_to_utf16: writes `text` and its terminating zero as UTF-16; the caller has checked it
/// with uv_wtf8_length_as_utf16.
pub export "C" fn uv_wtf8_to_utf16(text: *const u8, target: *mut u16, length: usize) -> () {
  let out = unsafe Pointer.assumeManyMut<u16>(target)
  let mut at: usize = 0
  let mut pos: usize = 0
  while true {
    let point = unsafe decodeWtf8(text, &mut pos)
    if point > 65535 {
      let rest = i32.wrappingToU32(point - 65536)
      unsafe Pointer.write<u16>(unsafe Pointer.atMut<u16>(out, at), u32.wrappingToU16(u32.shiftRight(rest, 10) + 55296))
      unsafe Pointer.write<u16>(unsafe Pointer.atMut<u16>(out, at + 1), u32.wrappingToU16((rest & 1023) + 56320))
      at = at + 2
    } else {
      unsafe Pointer.write<u16>(unsafe Pointer.atMut<u16>(out, at), i32.wrappingToU16(point))
      at = at + 1
    }
    let last = unsafe byteAt(text, pos)
    pos = pos + 1
    if last == 0 { break }
  }
}

// uv__get_surrogate_value: the code point at `source`[`at`], joining a surrogate pair unless only
// one unit is left.
unsafe fn surrogateValue(source: *const u16, at: usize, remaining: isize) -> u32 {
  let units = unsafe Pointer.assumeMany<u16>(source)
  let unit = u16.toU32(unsafe Pointer.read<u16>(unsafe Pointer.at<u16>(units, at)))
  if unit >= 55296 && unit <= 56319 && remaining != 1 {
    let next = u16.toU32(unsafe Pointer.read<u16>(unsafe Pointer.at<u16>(units, at + 1)))
    if next >= 56320 && next <= 57343 { return 65536 + u32.shiftLeft(unit - 55296, 10) + (next - 56320) }
  }
  return unit
}

// The WTF-8 bytes of the units of `source` from `at`: `remaining` of them, or up to a zero unit
// when it is negative.
unsafe fn utf16Length(source: *const u16, start: usize, count: isize) -> usize {
  let mut length: usize = 0
  let mut at = start
  let mut remaining = count
  while remaining != 0 {
    let point = unsafe surrogateValue(source, at, remaining)
    if remaining < 0 && point == 0 { break }
    if point < 128 { length = length + 1 }
    else if point < 2048 { length = length + 2 }
    else if point < 65536 { length = length + 3 }
    else {
      length = length + 4
      at = at + 1
      if remaining > 0 { remaining = remaining - 1 }
    }
    at = at + 1
    if remaining > 0 { remaining = remaining - 1 }
  }
  return length
}

/// uv_utf16_length_as_wtf8: the WTF-8 bytes of `length` units of `source` (up to a zero unit when
/// `length` is negative), without a terminating zero.
pub export "C" fn uv_utf16_length_as_wtf8(source: *const u16, length: isize) -> usize { return unsafe utf16Length(source, 0, length) }

/// uv_utf16_to_wtf8: converts `length` units of `source` (up to a zero unit when negative) into
/// `*target`, which holds `*targetLength` bytes and a zero byte, or into a new allocation when
/// `*target` is null. UV_ENOBUFS, with the needed length stored, when the text is cut.
pub export "C" fn uv_utf16_to_wtf8(source: *const u16, length: isize, target: ?*mut ?*mut u8, targetLength: ?*mut usize) -> i32 {
  let mut capacity: usize = 0
  let mut given: ?*mut u8 = Pointer.null<u8>()
  if !Pointer.isNull<?*mut u8>(target) { given = unsafe Pointer.read<?*mut u8>(unsafe Intrinsic.pointerRequalify<?*mut ?*mut u8, *mut ?*mut u8>(target)) }
  if Pointer.isNull<?*mut u8>(target) || Pointer.isNull<u8>(given) {
    capacity = unsafe utf16Length(source, 0, length)
    if !Pointer.isNull<usize>(targetLength) { unsafe Pointer.write<usize>(unsafe sizeOf(targetLength), capacity) }
  } else {
    capacity = unsafe Pointer.read<usize>(unsafe sizeOf(targetLength))
  }
  if Pointer.isNull<?*mut u8>(target) { return 0 }
  let slot = unsafe Intrinsic.pointerRequalify<?*mut ?*mut u8, *mut ?*mut u8>(target)
  if Pointer.isNull<u8>(given) {
    let made = unsafe os.uvMalloc(capacity + 1)
    if Pointer.isNull<u8>(made) { return 0 - ENOMEM }
    unsafe Pointer.write<?*mut u8>(slot, made)
    given = made
  }
  let base = unsafe presentMut(given)
  let units = unsafe Pointer.assumeMany<u16>(source)
  let mut out: usize = 0
  let mut at: usize = 0
  let mut remaining = length
  // `written` is libuv's target_len: the bytes of the characters that were written whole.
  let mut written = capacity
  while out != capacity && remaining != 0 {
    let point = unsafe surrogateValue(source, at, remaining)
    if remaining < 0 && point == 0 { remaining = 0 break }
    let mut cut = false
    if point < 128 {
      unsafe setByte(base, out, u32.toU8(point)) out = out + 1
    } else if point < 2048 {
      unsafe setByte(base, out, u32.toU8(192 | u32.shiftRight(point, 6))) out = out + 1
      if out == capacity { cut = true } else { unsafe setByte(base, out, u32.toU8(128 | (point & 63))) out = out + 1 }
    } else if point < 65536 {
      unsafe setByte(base, out, u32.toU8(224 | u32.shiftRight(point, 12))) out = out + 1
      if out == capacity { cut = true }
      else {
        unsafe setByte(base, out, u32.toU8(128 | (u32.shiftRight(point, 6) & 63))) out = out + 1
        if out == capacity { cut = true } else { unsafe setByte(base, out, u32.toU8(128 | (point & 63))) out = out + 1 }
      }
    } else {
      unsafe setByte(base, out, u32.toU8(240 | u32.shiftRight(point, 18))) out = out + 1
      if out == capacity { cut = true }
      else {
        unsafe setByte(base, out, u32.toU8(128 | (u32.shiftRight(point, 12) & 63))) out = out + 1
        if out == capacity { cut = true }
        else {
          unsafe setByte(base, out, u32.toU8(128 | (u32.shiftRight(point, 6) & 63))) out = out + 1
          if out == capacity { cut = true }
          else {
            unsafe setByte(base, out, u32.toU8(128 | (point & 63))) out = out + 1
            // The pair took two units.
            at = at + 1
            if remaining > 0 { remaining = remaining - 1 }
          }
        }
      }
    }
    if cut { break }
    written = out
    at = at + 1
    if remaining > 0 { remaining = remaining - 1 }
  }
  if out != capacity && !Pointer.isNull<usize>(targetLength) { unsafe Pointer.write<usize>(unsafe sizeOf(targetLength), out) }
  // Exactly filled: a zero unit next ends a negative-length text.
  if remaining < 0 && out == capacity && unsafe Pointer.read<u16>(unsafe Pointer.at<u16>(units, at)) == 0 { remaining = 0 }
  unsafe setByte(base, out, 0)
  if remaining != 0 {
    if !Pointer.isNull<usize>(targetLength) { unsafe Pointer.write<usize>(unsafe sizeOf(targetLength), written + unsafe utf16Length(source, at, remaining)) }
    return 0 - ENOBUFS
  }
  return 0
}

// --- Process title (src/unix/proctitle.c) ------------------------------------------------------

// libuv's static process_title and args_mem, kept in one record that a process word points to.
struct Title { lock: u32, text: ?*mut u8, length: usize, capacity: usize, arguments: ?*mut u8 }
impl Copy for Title {}
fn titleWord() -> *mut u64 { return Intrinsic.processWord() }
unsafe fn titleState() -> *mut Title {
  let word = titleWord()
  let current = unsafe Atomic.load<u64>(word, MemoryOrder.Acquire)
  if current != 0 { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Title>(unsafe presentMut(unsafe addressPointer(current))) }
  let made = unsafe calloc(1, Layout.of<Title>().bytes)
  if Pointer.isNull<u8>(made) { unsafe abort() }
  let raced = unsafe Atomic.compareExchange<u64>(word, 0, usize.toU64(Pointer.address<u8>(made)), MemoryOrder.AcquireRelease, MemoryOrder.Acquire)
  match move raced {
    CompareExchange<u64>.Exchanged => { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Title>(unsafe presentMut(made)) }
    CompareExchange<u64>.Observed { value } => { unsafe free(made) return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Title>(unsafe presentMut(unsafe addressPointer(value))) }
  }
}
unsafe fn lockTitle(state: *mut Title) -> () {
  let mut anchor = ()
  let t = unsafe Pointer.borrowMut<(), Title>(&mut anchor, state)
  while unsafe Atomic.swap<u32>(Pointer.fromMutRef<u32>(&mut t.lock), 1, MemoryOrder.Acquire) != 0 {}
}
unsafe fn unlockTitle(state: *mut Title) -> () {
  let mut anchor = ()
  let t = unsafe Pointer.borrowMut<(), Title>(&mut anchor, state)
  unsafe Atomic.store<u32>(Pointer.fromMutRef<u32>(&mut t.lock), 0, MemoryOrder.Release)
}
unsafe fn argumentAt(argv: *mut ?*mut u8, index: usize) -> *mut u8 {
  return unsafe presentMut(unsafe Pointer.read<?*mut u8>(unsafe Pointer.at<?*mut u8>(unsafe Pointer.assumeMany<?*mut u8>(argv), index)))
}

/// uv_setup_args: copies `argv` into one new allocation and returns the copy; the original
/// memory, from `argv[0]` to the end of the last argument, becomes the process title's.
pub export "C" fn uv_setup_args(argc: i32, argv: ?*mut ?*mut u8) -> ?*mut ?*mut u8 {
  if argc <= 0 { return argv }
  let table = unsafe Intrinsic.pointerRequalify<?*mut ?*mut u8, *mut ?*mut u8>(argv)
  let count = i32.toUsize(argc)
  let first = unsafe argumentAt(table, 0)
  let firstLength = unsafe strlen(first)
  let mut size = firstLength + 1
  let mut index: usize = 1
  while index < count { size = size + unsafe strlen(unsafe argumentAt(table, index)) + 1 index = index + 1 }
  size = size + (count + 1) * 8
  let memory = unsafe os.uvMalloc(size)
  if Pointer.isNull<u8>(memory) { return argv }
  let base = unsafe presentMut(memory)
  let copies = unsafe Pointer.assumeManyMut<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(base))
  let mut at = (count + 1) * 8
  let mut last: usize = firstLength + 1
  index = 0
  while index < count {
    let argument = unsafe argumentAt(table, index)
    if index > 0 { last = unsafe strlen(argument) + 1 }
    unsafe copyBytes(unsafe offsetMut(base, at), argument, last)
    unsafe Pointer.write<?*mut u8>(unsafe Pointer.atMut<?*mut u8>(copies, index), unsafe offsetMut(base, at))
    at = at + last
    index = index + 1
  }
  unsafe Pointer.write<?*mut u8>(unsafe Pointer.atMut<?*mut u8>(copies, count), Pointer.null<u8>())
  let capacity = usize.wrappingSubtract(Pointer.address<u8>(unsafe argumentAt(table, count - 1)) + last, Pointer.address<u8>(first))
  let state = unsafe titleState()
  let mut anchor = ()
  let t = unsafe Pointer.borrowMut<(), Title>(&mut anchor, state)
  t.arguments = memory
  t.text = first
  t.length = firstLength
  t.capacity = capacity
  return unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut ?*mut u8>(memory)
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  type StringCreate = extern "C" fn(?*mut u8, *const u8, u32) -> ?*mut u8
  type BundleByIdentifier = extern "C" fn(?*mut u8) -> ?*mut u8
  type BundleLookup = extern "C" fn(?*mut u8, ?*mut u8) -> ?*mut u8
  type CurrentApplication = extern "C" fn() -> ?*mut u8
  type SetInformationItem = extern "C" fn(i32, ?*mut u8, ?*mut u8, ?*mut u8, ?*mut u8) -> i32
  type InfoDictionary = extern "C" fn(?*mut u8) -> ?*mut u8
  type MainBundle = extern "C" fn() -> ?*mut u8
  type CheckIn = extern "C" fn(i32, ?*mut u8) -> ?*mut u8
  type ConnectionStatus = extern "C" fn(u64, ?*mut u8) -> ()
  const UTF8: u32 = 134217984
  // The function at `name` in `library`, or null.
  unsafe fn symbolOf(library: *mut u8, name: &[u8]) -> ?*mut u8 { return unsafe dlsym(library, cstr(name)) }
  // A CFString of the C string `text`.
  unsafe fn cfString(create: StringCreate, text: *const u8) -> ?*mut u8 { return unsafe create(Pointer.null<u8>(), text, UTF8) }
  // uv__set_process_title for macOS: the LaunchServices display name, through private functions
  // that libuv finds at run time, then the thread name. Its status is not used.
  unsafe fn titleSteps(services: *mut u8, foundation: *mut u8, title: *const u8) -> i32 {
    let create = unsafe symbolOf(foundation, b"CFStringCreateWithCString\0")
    let byIdentifier = unsafe symbolOf(foundation, b"CFBundleGetBundleWithIdentifier\0")
    let dataPointer = unsafe symbolOf(foundation, b"CFBundleGetDataPointerForName\0")
    let functionPointer = unsafe symbolOf(foundation, b"CFBundleGetFunctionPointerForName\0")
    if Pointer.isNull<u8>(create) || Pointer.isNull<u8>(byIdentifier) || Pointer.isNull<u8>(dataPointer) || Pointer.isNull<u8>(functionPointer) { return 0 - ENOENT }
    let s = unsafe functionAt<StringCreate>(unsafe presentMut(create))
    let bundleFor = unsafe functionAt<BundleByIdentifier>(unsafe presentMut(byIdentifier))
    let dataFor = unsafe functionAt<BundleLookup>(unsafe presentMut(dataPointer))
    let functionFor = unsafe functionAt<BundleLookup>(unsafe presentMut(functionPointer))
    let launchServices = unsafe bundleFor(unsafe cfString(s, cstr(b"com.apple.LaunchServices\0")))
    if Pointer.isNull<u8>(launchServices) { return 0 - ENOENT }
    let current = unsafe functionFor(launchServices, unsafe cfString(s, cstr(b"_LSGetCurrentApplicationASN\0")))
    if Pointer.isNull<u8>(current) { return 0 - ENOENT }
    let setItem = unsafe functionFor(launchServices, unsafe cfString(s, cstr(b"_LSSetApplicationInformationItem\0")))
    if Pointer.isNull<u8>(setItem) { return 0 - ENOENT }
    let displayKey = unsafe dataFor(launchServices, unsafe cfString(s, cstr(b"_kLSDisplayNameKey\0")))
    if Pointer.isNull<u8>(displayKey) { return 0 - ENOENT }
    let key = unsafe Pointer.read<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(unsafe presentMut(displayKey)))
    if Pointer.isNull<u8>(key) { return 0 - ENOENT }
    let infoDictionary = unsafe symbolOf(foundation, b"CFBundleGetInfoDictionary\0")
    let mainBundle = unsafe symbolOf(foundation, b"CFBundleGetMainBundle\0")
    if Pointer.isNull<u8>(infoDictionary) || Pointer.isNull<u8>(mainBundle) { return 0 - ENOENT }
    let checkIn = unsafe functionFor(launchServices, unsafe cfString(s, cstr(b"_LSApplicationCheckIn\0")))
    if Pointer.isNull<u8>(checkIn) { return 0 - ENOENT }
    let connection = unsafe functionFor(launchServices, unsafe cfString(s, cstr(b"_LSSetApplicationLaunchServicesServerConnectionStatus\0")))
    if Pointer.isNull<u8>(connection) { return 0 - ENOENT }
    let setStatus = unsafe functionAt<ConnectionStatus>(unsafe presentMut(connection))
    unsafe setStatus(0, Pointer.null<u8>())
    let info = unsafe functionAt<InfoDictionary>(unsafe presentMut(infoDictionary))
    let main = unsafe functionAt<MainBundle>(unsafe presentMut(mainBundle))
    let check = unsafe functionAt<CheckIn>(unsafe presentMut(checkIn))
    let _checked = unsafe check(-2, unsafe info(unsafe main()))
    let application = unsafe functionAt<CurrentApplication>(unsafe presentMut(current))
    let asn = unsafe application()
    if Pointer.isNull<u8>(asn) { return 0 - EBUSY }
    let set = unsafe functionAt<SetInformationItem>(unsafe presentMut(setItem))
    if unsafe set(-2, asn, key, unsafe cfString(s, title), Pointer.null<u8>()) != 0 { return 0 - EINVAL }
    let _named = unsafe os.uv_thread_setname(title)
    return 0
  }
  unsafe fn platformTitle(title: *const u8) -> () {
    // RTLD_LAZY | RTLD_LOCAL.
    let services = unsafe dlopen(cstr(b"/System/Library/Frameworks/ApplicationServices.framework/Versions/A/ApplicationServices\0"), 5)
    let foundation = unsafe dlopen(cstr(b"/System/Library/Frameworks/CoreFoundation.framework/Versions/A/CoreFoundation\0"), 5)
    if !Pointer.isNull<u8>(services) && !Pointer.isNull<u8>(foundation) { let _status = unsafe titleSteps(unsafe presentMut(services), unsafe presentMut(foundation), title) }
    if !Pointer.isNull<u8>(foundation) { let _closed = unsafe dlclose(unsafe presentMut(foundation)) }
    if !Pointer.isNull<u8>(services) { let _closed = unsafe dlclose(unsafe presentMut(services)) }
  }
} else {
  // prctl(PR_SET_NAME): the kernel keeps the first 15 bytes as the thread's name.
  unsafe fn platformTitle(title: *const u8) -> () { let _status = unsafe prctl(PR_SET_NAME, title) }
}

/// uv_set_process_title: UV_ENOBUFS unless uv_setup_args was called; otherwise writes `title`, cut
/// to the capacity of the original arguments and padded with zero bytes, over them.
pub export "C" fn uv_set_process_title(title: *const u8) -> i32 {
  let state = unsafe titleState()
  let current = unsafe Pointer.read<Title>(state)
  if Pointer.isNull<u8>(current.arguments) { return 0 - ENOBUFS }
  let mut length = unsafe strlen(title)
  unsafe lockTitle(state)
  let mut anchor = ()
  let t = unsafe Pointer.borrowMut<(), Title>(&mut anchor, state)
  if length >= t.capacity {
    length = 0
    if t.capacity > 0 { length = t.capacity - 1 }
  }
  let text = unsafe presentMut(t.text)
  unsafe copyBytes(text, title, length)
  unsafe fill(unsafe offsetMut(text, length), 0, t.capacity - length)
  t.length = length
  drop t
  unsafe platformTitle(text)
  unsafe unlockTitle(state)
  return 0
}

/// uv_get_process_title: the title, UV_ENOBUFS unless uv_setup_args was called or when `size` is
/// not more than its length.
pub export "C" fn uv_get_process_title(buffer: ?*mut u8, size: usize) -> i32 {
  if Pointer.isNull<u8>(buffer) || size == 0 { return 0 - EINVAL }
  let state = unsafe titleState()
  let current = unsafe Pointer.read<Title>(state)
  if Pointer.isNull<u8>(current.arguments) { return 0 - ENOBUFS }
  unsafe lockTitle(state)
  let t = unsafe Pointer.read<Title>(state)
  if size <= t.length { unsafe unlockTitle(state) return 0 - ENOBUFS }
  let out = unsafe presentMut(buffer)
  if t.length != 0 { unsafe copyBytes(out, unsafe presentMut(t.text), t.length + 1) }
  unsafe setByte(out, t.length, 0)
  unsafe unlockTitle(state)
  return 0
}

// --- Processes and time ------------------------------------------------------------------------

pub export "C" fn uv_kill(pid: i32, signal: i32) -> i32 {
  if unsafe kill(pid, signal) != 0 { return unsafe failure() }
  return 0
}

pub export "C" fn uv_sleep(milliseconds: u32) -> () {
  let mut wait = Timespec { seconds: u32.toI64(milliseconds / 1000), nanoseconds: u32.toI64(milliseconds % 1000) * 1000000 }
  while true {
    let status = unsafe nanosleep(Pointer.fromRef<Timespec>(&wait), Pointer.fromMutRef<Timespec>(&mut wait))
    if status != -1 || unsafe errno() != EINTR { break }
  }
}

// Writes the two fields of a uv_timespec64_t or uv_timeval64_t, leaving its padding as it was.
unsafe fn putTime64(out: *mut Time64, seconds: i64, fraction: i64) -> () {
  let mut anchor = ()
  let t = unsafe Pointer.borrowMut<(), Time64>(&mut anchor, out)
  t.seconds = seconds
  t.fraction = i64.wrappingToI32(fraction)
}

/// uv_clock_gettime: UV_CLOCK_MONOTONIC (0) or UV_CLOCK_REALTIME (1). UV_EFAULT for a null result.
pub export "C" fn uv_clock_gettime(clock: i32, time: ?*mut Time64) -> i32 {
  if Pointer.isNull<Time64>(time) { return 0 - EFAULT }
  let mut id = CLOCK_MONOTONIC
  if clock == 1 { id = CLOCK_REALTIME } else if clock != 0 { return 0 - EINVAL }
  let mut now = Timespec { seconds: 0, nanoseconds: 0 }
  if unsafe clock_gettime(id, Pointer.fromMutRef<Timespec>(&mut now)) != 0 { return unsafe failure() }
  unsafe putTime64(unsafe Intrinsic.pointerRequalify<?*mut Time64, *mut Time64>(time), now.seconds, now.nanoseconds)
  return 0
}

/// uv_gettimeofday. UV_EINVAL for a null result.
pub export "C" fn uv_gettimeofday(time: ?*mut Time64) -> i32 {
  if Pointer.isNull<Time64>(time) { return 0 - EINVAL }
  // struct timeval: tv_usec is a long on Linux and a 32-bit int on Darwin.
  let mut now = Timespec { seconds: 0, nanoseconds: 0 }
  if unsafe gettimeofday(Pointer.fromMutRef<Timespec>(&mut now), Pointer.null<u8>()) != 0 { return unsafe failure() }
  static if Intrinsic.targetOperatingSystem() == "darwin" { now.nanoseconds = i32.toI64(i64.wrappingToI32(now.nanoseconds)) }
  unsafe putTime64(unsafe Intrinsic.pointerRequalify<?*mut Time64, *mut Time64>(time), now.seconds, now.nanoseconds)
  return 0
}

pub export "C" fn uv_hrtime() -> u64 { return unsafe os.uv_hrtime() }

// --- The operating system ----------------------------------------------------------------------

pub export "C" fn uv_available_parallelism() -> u32 { return unsafe os.uv_available_parallelism() }

pub export "C" fn uv_chdir(directory: *const u8) -> i32 {
  if unsafe chdir(directory) != 0 { return unsafe failure() }
  return 0
}

/// uv_cwd: the working directory without a trailing slash (unless it is "/"). UV_ENOBUFS, with the
/// needed capacity stored, when it does not fit.
pub export "C" fn uv_cwd(buffer: ?*mut u8, size: ?*mut usize) -> i32 {
  if Pointer.isNull<u8>(buffer) || unsafe noCapacity(size) { return 0 - EINVAL }
  let out = unsafe presentMut(buffer)
  let capacity = unsafe sizeOf(size)
  let mut scratch: [u8; 4097] = [0; 4097]
  let mut text = out
  if Pointer.isNull<u8>(unsafe getcwd(out, unsafe Pointer.read<usize>(capacity))) {
    if unsafe errno() != ERANGE { return unsafe failure() }
    if Pointer.isNull<u8>(unsafe getcwd(Pointer.fromMutRef<u8>(&mut scratch[0]), PATH_MAX + 1)) { return unsafe failure() }
    text = Pointer.fromMutRef<u8>(&mut scratch[0])
  }
  let mut length = unsafe strlen(text)
  if length > 1 && unsafe byteAt(text, length - 1) == 47 {
    length = length - 1
    unsafe setByte(text, length, 0)
  }
  if Pointer.address<u8>(text) != Pointer.address<u8>(out) {
    unsafe Pointer.write<usize>(capacity, length + 1)
    return 0 - ENOBUFS
  }
  unsafe Pointer.write<usize>(capacity, length)
  return 0
}

pub export "C" fn uv_cpu_info(cpus: *mut ?*mut Cpu, count: *mut i32) -> i32 { return unsafe os.uv_cpu_info(cpus, count) }
pub export "C" fn uv_free_cpu_info(cpus: ?*mut Cpu, count: i32) -> () { unsafe os.uv_free_cpu_info(cpus, count) }

pub export "C" fn uv_exepath(buffer: ?*mut u8, size: ?*mut usize) -> i32 {
  if Pointer.isNull<u8>(buffer) || unsafe noCapacity(size) { return 0 - EINVAL }
  return unsafe os.uv_exepath(unsafe presentMut(buffer), unsafe sizeOf(size))
}

pub export "C" fn uv_interface_addresses(addresses: *mut ?*mut Interface, count: *mut i32) -> i32 { return unsafe os.uv_interface_addresses(addresses, count) }
pub export "C" fn uv_free_interface_addresses(addresses: ?*mut Interface, count: i32) -> () { unsafe os.uv_free_interface_addresses(addresses, count) }
pub export "C" fn uv_get_available_memory() -> u64 { return unsafe os.uv_get_available_memory() }
pub export "C" fn uv_get_constrained_memory() -> u64 { return unsafe os.uv_get_constrained_memory() }
pub export "C" fn uv_get_free_memory() -> u64 { return unsafe os.uv_get_free_memory() }
pub export "C" fn uv_get_total_memory() -> u64 { return unsafe os.uv_get_total_memory() }
pub export "C" fn uv_getrusage(usage: *mut Usage) -> i32 { return unsafe os.uv_getrusage(usage) }
pub export "C" fn uv_getrusage_thread(usage: *mut Usage) -> i32 { return unsafe os.uv_getrusage_thread(usage) }
pub export "C" fn uv_loadavg(average: *mut f64) -> () { unsafe os.uv_loadavg(average) }
pub export "C" fn uv_resident_set_memory(rss: *mut usize) -> i32 { return unsafe os.uv_resident_set_memory(rss) }
pub export "C" fn uv_uptime(seconds: *mut f64) -> i32 { return unsafe os.uv_uptime(seconds) }

pub export "C" fn uv_os_environ(items: *mut ?*mut EnvItem, count: *mut i32) -> i32 { return unsafe os.uv_os_environ(items, count) }
pub export "C" fn uv_os_free_environ(items: ?*mut EnvItem, count: i32) -> () { unsafe os.uv_os_free_environ(items, count) }

/// uv_os_getenv: the value of `name`. UV_ENOENT when it is not set; UV_ENOBUFS, with the needed
/// capacity stored, when it does not fit.
pub export "C" fn uv_os_getenv(name: ?*const u8, buffer: ?*mut u8, size: ?*mut usize) -> i32 {
  if Pointer.isNull<u8>(name) || Pointer.isNull<u8>(buffer) || unsafe noCapacity(size) { return 0 - EINVAL }
  let value = unsafe getenv(unsafe present(name))
  if Pointer.isNull<u8>(value) { return 0 - ENOENT }
  let text = unsafe present(value)
  let length = unsafe strlen(text)
  let capacity = unsafe sizeOf(size)
  if length >= unsafe Pointer.read<usize>(capacity) {
    unsafe Pointer.write<usize>(capacity, length + 1)
    return 0 - ENOBUFS
  }
  unsafe copyBytes(unsafe presentMut(buffer), text, length + 1)
  unsafe Pointer.write<usize>(capacity, length)
  return 0
}
pub export "C" fn uv_os_setenv(name: ?*const u8, value: ?*const u8) -> i32 {
  if Pointer.isNull<u8>(name) || Pointer.isNull<u8>(value) { return 0 - EINVAL }
  if unsafe setenv(unsafe present(name), unsafe present(value), 1) != 0 { return unsafe failure() }
  return 0
}
pub export "C" fn uv_os_unsetenv(name: ?*const u8) -> i32 {
  if Pointer.isNull<u8>(name) { return 0 - EINVAL }
  if unsafe unsetenv(unsafe present(name)) != 0 { return unsafe failure() }
  return 0
}

pub export "C" fn uv_os_gethostname(buffer: ?*mut u8, size: ?*mut usize) -> i32 {
  if Pointer.isNull<u8>(buffer) || unsafe noCapacity(size) { return 0 - EINVAL }
  return unsafe os.uv_os_gethostname(unsafe presentMut(buffer), unsafe sizeOf(size))
}
