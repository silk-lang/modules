effect fn contentEditable(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let package = run platform.readFile(b"modules/js/packages/core/src/index.js")
  run host.define(b"@silkui/core", package.asSlice())
  host.attach(tree.engineMut())
  let source = run platform.readFile(b"modules/js/tests/fixtures/editing.js")
  run host.module(source.asSlice(), b"editing.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run host.input(&mut tree, Input.press(10.0, 12.0))
  run host.input(&mut tree, Input.release(10.0, 12.0))
  run host.evaluate(b"afterPress()", b"test")
  run host.flush(&mut tree)
  run host.input(&mut tree, run Input.text("!"))
  run host.evaluate(b"afterTyping()", b"test")
  run host.input(&mut tree, Input.ImePreedit { text: run String.copy("ka"), selectionStart: 2, selectionEnd: 2 })
  run host.evaluate(b"afterPreedit()", b"test")
  run host.input(&mut tree, run Input.text("か"))
  run host.evaluate(b"afterComposing()", b"test")
  run host.input(&mut tree, run Input.key("Backspace"))
  run host.evaluate(b"afterBackspace()", b"test")
  run host.input(&mut tree, run Input.key("Enter"))
  run host.evaluate(b"afterEnter()", b"test")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.1)
  run host.input(&mut tree, run Input.key("ArrowDown"))
  run host.evaluate(b"afterArrow()", b"test")
  run host.evaluate(b"if (!globalThis.editingChecked) throw new Error('the checks did not run')", b"test")
}

/// contenteditable hosts on the real tree: focus and caret from a press, typing, the input
/// method, Backspace, Enter and arrows, each changing the host's nodes from script.
test effect fn contentEditableHostsEditTheirNodes() -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run withHost(12) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn selections(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let package = run platform.readFile(b"modules/js/packages/core/src/index.js")
  run host.define(b"@silkui/core", package.asSlice())
  host.attach(tree.engineMut())
  let source = run platform.readFile(b"modules/js/tests/fixtures/selection.js")
  run host.module(source.asSlice(), b"selection.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run host.input(&mut tree, Input.press(1.0, 12.0))
  run host.input(&mut tree, Input.moveTo(390.0, 12.0))
  run host.input(&mut tree, Input.release(390.0, 12.0))
  run host.evaluate(b"selectionAfterDrag()", b"test")
  run host.input(&mut tree, Input.press(1.0, 12.0))
  run host.input(&mut tree, Input.moveTo(390.0, 12.0))
  run host.input(&mut tree, Input.release(390.0, 12.0))
  run host.evaluate(b"selectionAfterPreventedPress()", b"test")
  run host.evaluate(b"if (!globalThis.selectionChecked) throw new Error('the checks did not run')", b"test")
}

effect fn terminalInput(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let package = run platform.readFile(b"modules/js/packages/core/src/index.js")
  run host.define(b"@silkui/core", package.asSlice())
  host.attach(tree.engineMut())
  let source = run platform.readFile(b"modules/js/tests/fixtures/terminal-input.js")
  run host.module(source.asSlice(), b"terminal-input.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run host.input(&mut tree, Input.press(100.0, 100.0))
  run host.input(&mut tree, Input.release(100.0, 100.0))
  run host.evaluate(b"afterPress()", b"test")
  run host.input(&mut tree, run Input.key("Enter"))
  run host.input(&mut tree, Input.KeyUp { key: run String.copy("Enter"), code: run String.copy("Enter"), modifiers: Modifiers.none() })
  run host.input(&mut tree, run Input.text("echo hi"))
  run host.flush(&mut tree)
  run host.evaluate(b"afterTyping()", b"test")
  run host.evaluate(b"if (!globalThis.terminalChecked) throw new Error('the checks did not run')", b"test")
}

