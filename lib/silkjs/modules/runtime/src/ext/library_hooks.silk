//! What the core calls into a library capability's package through, where a core service (not
//! the capability's own natives) needs it: C function tables, filled by the implementation, so
//! the core names no symbol of the library.
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }

/// The operations the network's native TLS sockets (`net_native.secure`, 2405) run on a session
/// of `Tls`. A session is opaque here; `attach` takes `Tls`'s sessions and a session id.
pub struct SecureOps {
  pub attach: extern "C" fn(?*mut u8, i32) -> ?*mut u8,
  pub detach: extern "C" fn(*mut u8) -> (),
  /// 1 when nothing happened that JavaScript must handle.
  pub quiet: extern "C" fn(*mut u8) -> i32,
  /// 1 when the session took all of the ciphertext.
  pub feed: extern "C" fn(*mut u8, *mut u8, usize) -> i32,
  pub read: extern "C" fn(*mut u8, *mut u8, usize) -> i32,
  /// 1 when the session took all of the plaintext.
  pub write: extern "C" fn(*mut u8, *mut u8, usize) -> i32,
  pub pending: extern "C" fn(*mut u8) -> usize,
  pub take: extern "C" fn(*mut u8, *mut u8, usize) -> usize,
}
impl Copy for SecureOps {}

export "C" fn silkNoSecureAttach(sessions: ?*mut u8, id: i32) -> ?*mut u8 { return Pointer.null<u8>() }
export "C" fn silkNoSecureDetach(session: *mut u8) -> () {}
export "C" fn silkNoSecureCount(session: *mut u8) -> i32 { return 0 }
export "C" fn silkNoSecureMove(session: *mut u8, data: *mut u8, count: usize) -> i32 { return 0 }
export "C" fn silkNoSecureSize(session: *mut u8) -> usize { return 0 }
export "C" fn silkNoSecureTake(session: *mut u8, out: *mut u8, room: usize) -> usize { return 0 }

impl SecureOps {
  /// No TLS: no session attaches, so no other operation runs.
  pub fn none() -> SecureOps {
    return SecureOps { attach: silkNoSecureAttach, detach: silkNoSecureDetach, quiet: silkNoSecureCount, feed: silkNoSecureMove,
      read: silkNoSecureMove, write: silkNoSecureMove, pending: silkNoSecureSize, take: silkNoSecureTake }
  }
}

/// What a worker thread's start runs first on the thread that starts it: `Crypto`'s provider
/// setup, which must happen before a second thread uses OpenSSL.
pub struct ThreadSetup {
  pub data: ?*mut u8,
  pub prepare: extern "C" fn(?*mut u8) -> (),
}
impl Copy for ThreadSetup {}

export "C" fn silkNoThreadSetup(data: ?*mut u8) -> () {}

impl ThreadSetup {
  /// Nothing to set up.
  pub fn none() -> ThreadSetup { return ThreadSetup { data: Pointer.null<u8>(), prepare: silkNoThreadSetup } }
}
