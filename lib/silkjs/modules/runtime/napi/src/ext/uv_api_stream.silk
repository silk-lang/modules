/// libuv's uv_udp_try_send2: `count` datagrams at once; the count sent, or a negative errno.
pub export "C" fn uv_udp_try_send2(udp: *mut u8, count: u32, bufs: *mut ?*mut u8, counts: *mut u32, addresses: *mut ?*mut u8, flags: u32) -> i32 {
  if count < 1 { return -EINVAL }
  if flags != 0 { return -EINVAL }
  if unsafe get<usize>(udp, U_SEND_QUEUE_COUNT) > 0 { return -EAGAIN }
  let fd = unsafe fdOf(udp)
  if fd == -1 { return -EINVAL }
  return unsafe sendMany(fd, count, bufs, counts, addresses)
