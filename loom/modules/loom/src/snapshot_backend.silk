//! [`SnapshotBackend`]: an in-memory [`Backend`] for the split Loom App thread.
//!
//! It never holds a `UiTree` or acquires a tree lock. Geometry (`measure`, `viewport`),
//! virtual-list indices, and input revisions are served purely from the newest immutable
//! [`FrameSnapshot`] received in-band from the Engine thread, while emitted mutations queue in
//! an outbox flushed as `AppToEngine.Commit` batches.
import ui_protocol.backend { Backend, Measured }
import ui_protocol.error { TreeError }
import ui_protocol.mutation { Mutation, FIRST_ROOT }
import ui_protocol.options { VirtualRange }
import ui_protocol.record { Event }
import ui_protocol.root { RootEvent, RootSupport }
import ui_protocol.snapshot { FrameSnapshot }
import heap { Heap }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// Split-thread Loom backend backed solely by immutable [`FrameSnapshot`]s and outbox batches.
pub struct SnapshotBackend {
  heap: Heap,
  frameSnapshot: FrameSnapshot,
  support: RootSupport,
  initialViewport: Rect<f32>,
  pendingEvents: List<Event>,
  pendingRootEvents: List<RootEvent>,
  outbox: List<Mutation>,
  navigated: Option<String>,
}

impl SnapshotBackend {
  pub fn make(windowGroupId: u32, support: RootSupport, viewport: Rect<f32>) -> SnapshotBackend {
    return SnapshotBackend {
      heap: Heap.make(),
      frameSnapshot: FrameSnapshot.empty(windowGroupId),
      support: support,
      initialViewport: viewport,
      pendingEvents: List<Event>.make(),
      pendingRootEvents: List<RootEvent>.make(),
      outbox: List<Mutation>.make(),
      navigated: Option<String>.None,
    }
  }

  /// Replaces the held snapshot with `snapshot` when its `appliedSeq` is newer or equal.
  pub fn applySnapshot(self: &mut Self, next: FrameSnapshot) -> () {
    if next.appliedSeq >= self.frameSnapshot.appliedSeq {
      self.frameSnapshot = move next
    } else {
      drop next
    }
  }

  /// Borrows the current [`FrameSnapshot`].
  pub fn snapshot(self: &Self) -> &FrameSnapshot {
    return &self.frameSnapshot
  }

  /// Highest `Commit.seq` reflected in the current snapshot.
  pub fn appliedSeq(self: &Self) -> u64 {
    return self.frameSnapshot.appliedSeq
  }

  /// Latest authoritative input revision known for node `id` in the current snapshot.
  pub fn inputRevision(self: &Self, id: u32) -> Option<u64> {
    return self.frameSnapshot.inputRevision(id)
  }

  /// Enqueues event records delivered by the Engine thread for the next `pump`.
  pub effect fn pushEvents(self: &mut Self, events: List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut incoming = move events
    while incoming.length() != 0 {
      run self.pendingEvents.append(incoming.remove(0))
    }
  }

  /// Enqueues root events delivered by the Engine thread for the next `pump`.
  pub effect fn pushRootEvents(self: &mut Self, events: List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut incoming = move events
    while incoming.length() != 0 {
      run self.pendingRootEvents.append(incoming.remove(0))
    }
  }

  /// Updates the initial fallback viewport used before the first snapshot arrives.
  pub fn setViewport(self: &mut Self, viewport: Rect<f32>) -> () {
    self.initialViewport = viewport
  }

  /// Whether any mutations are queued in the outbox.
  pub fn hasPendingMutations(self: &Self) -> bool {
    return self.outbox.length() != 0
  }

  /// Moves queued mutations out as one batch to send via `AppToEngine.Commit`.
  pub fn takeMutations(self: &mut Self) -> List<Mutation> {
    return Intrinsic.replace(self.outbox, List<Mutation>.make())
  }

  /// Returns and clears the last internal navigation path recorded by `Backend.navigate`.
  pub fn takeNavigated(self: &mut Self) -> Option<String> {
    return Intrinsic.replace(self.navigated, Option<String>.None)
  }
}

impl Backend for SnapshotBackend {
  effect fn mutate(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut incoming = move batch
    while incoming.length() != 0 {
      run self.outbox.append(incoming.remove(0))
    }
  }

  effect fn events(self: &mut Self, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while self.pendingEvents.length() != 0 {
      run out.append(self.pendingEvents.remove(0))
    }
  }

  effect fn rootEvents(self: &mut Self, out: &mut List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while self.pendingRootEvents.length() != 0 {
      run out.append(self.pendingRootEvents.remove(0))
    }
  }

  fn viewport(self: &Self, root: u32) -> Rect<f32> {
    let roots = self.frameSnapshot.roots.asSlice()
    let mut i: usize = 0
    while i < roots.length {
      if roots[i].root == root {
        return roots[i].viewport
      }
      i = i + 1
    }
    if root == FIRST_ROOT {
      return self.initialViewport
    }
    return Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
  }

  fn roots(self: &Self) -> RootSupport {
    return self.support
  }

  effect fn measure(self: &Self, id: u32) -> Option<Measured>
    ! OutOfMemoryError
    ? &mut Allocator {
    return match self.frameSnapshot.nodeGeometry(id) {
      Option.Some { value } => Option<Measured>.Some {
        value: Measured {
          bounds: value.bounds,
          pressed: value.pressed,
          hovered: value.hovered,
          focused: value.focused,
        },
      }
      Option.None => Option<Measured>.None
    }
  }

  fn range(self: &Self, id: u32) -> Option<VirtualRange> {
    return self.frameSnapshot.virtualRange(id)
  }

  effect fn indices(self: &Self, id: u32, out: &mut List<usize>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.frameSnapshot.virtualIndices(id, &mut out)
  }

  fn copiesBatches(self: &Self) -> bool {
    return false
  }

  fn inputRevision(self: &Self, id: u32) -> Option<u64> {
    return self.frameSnapshot.inputRevision(id)
  }

  fn navigate(self: &mut Self, path: string) -> () {
    let copy = self.heap.alloc(String.copy(path))
    self.navigated = Option<String>.Some { value: move copy }
  }
}
