//! Places absolutely positioned boxes against their CSS anchors (CSS Anchor Positioning 1).
//!
//! After a layout, `settle` finds each anchored box's anchor (`anchor-name`, the last one in
//! tree order) and containing block, and works out the insets `anchor()` and `position-area`
//! ask for, the sizes `anchor-size()` asks for, and the first `position-try-fallbacks` flip
//! that keeps the box inside its containing block. When that changes, styles resolve again,
//! and `apply` writes it into the box's computed style. `Tree.anchor` popups come through
//! here too: their anchor is the node `anchoring` names, with the extras of `AnchorOptions`.
import engine { UiTree }
import anchoring
import mutation { Position }
import layout.lib { Display as CssDisplay }
import node { NONE, NO_INDEX }
import paint { borderBox, paddingBox }
import anchor_style {
  AnchorStyle, SIDE_NONE, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM, SIDE_LEFT, SIDE_CENTER, SIDE_START,
  SIDE_END, SIDE_INSIDE, SIDE_OUTSIDE, SIDE_PERCENT, TRACK_START, TRACK_CENTER, TRACK_END,
  TRACKS_ALL, SIZE_WIDTH, SIZE_HEIGHT, TRY_FLIP_BLOCK, TRY_FLIP_INLINE,
}
import style { Computed }
import layout.lib { Dimension, SizeValue, DimensionKind }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u8
import silk.num.u32

/// Where `settle` put one anchored box.
pub struct Placement {
  pub slot: u32,
  pub id: u32,
  /// The anchor was found and laid out.
  pub found: bool,
  /// Insets with a value (bit per edge, top, right, bottom, left) and insets made `auto`.
  pub set: u8,
  pub cleared: u8,
  /// The inset each `set` edge gets, before the length an `anchor()` calc adds.
  pub insets: [f32; 4],
  /// `anchor-size()` sizes and the `position-area` cell's size, or -1.
  pub width: f32,
  pub height: f32,
  pub maxWidth: f32,
  pub maxHeight: f32,
  /// The `position-try-fallbacks` flips in use (`TRY_*`).
  pub flip: u8,
  /// A `Tree.anchor` popup, and the anchor width it matches (or -1).
  pub popup: bool,
  pub minWidth: f32,
}

impl Copy for Placement {}

fn same(a: &Placement, b: &Placement) -> bool {
  return a.slot == b.slot && a.id == b.id && a.found == b.found && a.set == b.set && a.cleared == b.cleared
    && close(a.insets[0], b.insets[0]) && close(a.insets[1], b.insets[1])
    && close(a.insets[2], b.insets[2]) && close(a.insets[3], b.insets[3])
    && close(a.width, b.width) && close(a.height, b.height)
    && close(a.maxWidth, b.maxWidth) && close(a.maxHeight, b.maxHeight) && a.flip == b.flip
    && a.popup == b.popup && close(a.minWidth, b.minWidth)
}

fn close(a: f32, b: f32) -> bool {
  return f32.abs(a - b) < 0.01
}

struct Named {
  name: u32,
  slot: u32,
}

impl Copy for Named {}

/// Recomputes every anchored box's placement; returns whether one changed, which marks
/// styles dirty.
pub effect fn settle(tree: &mut UiTree<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !tree.cssAnchorUsed || tree.root == NONE {
    return false
  }
  // Names and anchored boxes, in tree order.
  let mut names = List<Named>.make()
  let mut boxes = List<u32>.make()
  let mut stack = List<u32>.make()
  let mut children = List<u32>.make()
  run stack.append(tree.root)
  while stack.length() != 0 {
    let last = stack.length() - 1
    let slot = stack.get(last)
    stack.truncate(last)
    let node = tree.node(slot)
    if !node.live { continue }
    let a = node.computed().anchor
    if a.name != 0 && fragmentOf(&tree.*, slot) != NO_INDEX {
      run names.append(Named { name: a.name, slot: slot })
    }
    let position = node.computed().layout.position
    if a.anchored() && (position == Position.Absolute || position == Position.Fixed) {
      run boxes.append(slot)
    }
    run tree.childSlots(slot, &mut children)
    let mut i = children.length()
    while i > 0 {
      i = i - 1
      run stack.append(children.get(i))
    }
  }
  let mut next = List<Placement>.make()
  let mut i: usize = 0
  while i < boxes.length() {
    run next.append(place(&tree.*, boxes.get(i), &names))
    i = i + 1
  }
  // A box in another root keeps its placement until that root is laid out.
  let mut k: usize = 0
  while k < tree.cssPlacements.length() {
    let old = tree.cssPlacements.asSlice()[k]
    if tree.node(old.slot).live && tree.node(old.slot).id == old.id && tree.inParkedRoot(old.slot) {
      run next.append(old)
    }
    k = k + 1
  }
  let mut changed = next.length() != tree.cssPlacements.length()
  if !changed {
    let mut k: usize = 0
    while k < next.length() {
      if !same(&next.asSlice()[k], &tree.cssPlacements.asSlice()[k]) {
        changed = true
        break
      }
      k = k + 1
    }
  }
  if changed {
    tree.cssPlacements = move next
    tree.markStylesDirty(2)
  }
  return changed
}

/// Whether `slot` is `ancestor` or inside it.
fn within(tree: &UiTree<'_>, slot: u32, ancestor: u32) -> bool {
  let mut at = slot
  while at != NONE {
    if at == ancestor { return true }
    at = tree.node(at).parent
  }
  return false
}

fn place(tree: &UiTree<'_>, slot: u32, names: &List<Named>) -> Placement {
  let node = tree.node(slot)
  let style = node.computed().anchor
  let mut out = Placement {
    slot: slot, id: node.id, found: false, set: 0, cleared: 0, insets: [0.0; 4],
    width: -1.0, height: -1.0, maxWidth: -1.0, maxHeight: -1.0, flip: 0, popup: false, minWidth: -1.0,
  }
  let wanted = style.anchor()
  let mut anchor = NONE
  let popup = if node.isGenerated() { NO_INDEX } else { anchoring.find(tree, node.id) }
  if popup != NO_INDEX {
    out.popup = true
    let target = tree.slotOf(tree.anchors.asSlice()[popup].target)
    if target != NONE && fragmentOf(tree, target) != NO_INDEX {
      anchor = target
    }
  }
  let mut i = names.length()
  while i > 0 && wanted != 0 {
    i = i - 1
    let entry = names.asSlice()[i]
    if entry.name == wanted && !within(tree, entry.slot, slot) {
      anchor = entry.slot
      break
    }
  }
  let own = fragmentOf(tree, slot)
  if anchor == NONE || (own == NO_INDEX && !out.popup) {
    return out
  }
  out.found = true
  // The containing block, in the box's inset coordinates: its padding box, scrolled.
  let fixed = node.computed().layout.position == Position.Fixed
  let mut cb = Rect<f32>.new(0.0, 0.0, tree.input.width, tree.input.height)
  let mut shiftX: f32 = 0.0
  let mut shiftY: f32 = 0.0
  let mut parent = node.parent
  while !fixed && parent != NONE {
    let p = tree.node(parent)
    if p.computed().layout.position != Position.Static {
      let at = fragmentOf(tree, parent)
      if at != NO_INDEX {
        cb = paddingBox(&tree.visualFragment(at))
        shiftX = p.scrollX()
        shiftY = p.scrollY()
      }
      break
    }
    parent = p.parent
  }
  let ab = borderBox(&tree.visualFragment(fragmentOf(tree, anchor)))
  let a = Rect<f32>.new(ab.xMin - cb.xMin + shiftX, ab.yMin - cb.yMin + shiftY, ab.xMax - cb.xMin + shiftX, ab.yMax - cb.yMin + shiftY)
  let w = cb.width()
  let h = cb.height()
  if out.popup {
    return placePopup(&style, tree.anchors.asSlice()[popup].options, a, w, h, &out)
  }
  let ownBox = borderBox(&tree.visualFragment(own))
  let bw = ownBox.width()
  let bh = ownBox.height()
  if style.widthSize() != 0 { out.width = if style.widthSize() == SIZE_WIDTH { a.width() } else { a.height() } }
  if style.heightSize() != 0 { out.height = if style.heightSize() == SIZE_HEIGHT { a.height() } else { a.width() } }
  let sizedW = if out.width >= 0.0 { out.width } else { bw }
  let sizedH = if out.height >= 0.0 { out.height } else { bh }
  let first = resolve(&style, 0, a, w, h, sizedW, sizedH, &out)
  if style.tries == 0 || fits(&first, w, h, sizedW, sizedH, ownBox, cb) {
    return first
  }
  let mut index: u8 = 0
  while index < 3 {
    let option = style.tryAt(index)
    if option == 0 { break }
    let flipped = resolve(&style, option, a, w, h, sizedW, sizedH, &out)
    if fits(&flipped, w, h, sizedW, sizedH, ownBox, cb) {
      return flipped
    }
    index = index + 1
  }
  return first
}

/// A `Tree.anchor` popup: below the anchor unless it would get less than the preferred
/// height there and more above, against its left edge (its right edge with `alignEnd`, or
/// when it starts past the middle), `gap` away and 4px inside the viewport.
fn placePopup(style: &AnchorStyle, options: anchoring.AnchorOptions, a: Rect<f32>, w: f32, h: f32, base: &Placement) -> Placement {
  let above = f32.max(0.0, a.yMin - options.gap - 4.0)
  let below = f32.max(0.0, h - a.yMax - options.gap - 4.0)
  let up = below < options.preferredHeight && above > below
  let left = f32.max(4.0, f32.min(w - 4.0, a.xMin))
  let right = f32.max(4.0, f32.min(w - 4.0, w - a.xMax))
  let end = options.alignEnd || left > w * 0.5
  let mut flip: u8 = if up { TRY_FLIP_BLOCK } else { 0 }
  // The columns `anchoring` set are span-right; past the middle they flip to span-left.
  if end && !options.alignEnd { flip = u8.bitOr(flip, TRY_FLIP_INLINE) }
  let mut out = resolve(style, flip, a, w, h, 0.0, 0.0, base)
  if up {
    out.insets[2] = f32.max(4.0, h - a.yMin + options.gap)
    out.maxHeight = above
  } else {
    out.insets[0] = f32.max(4.0, a.yMax + options.gap)
    out.maxHeight = below
  }
  let x = if end { right } else { left }
  if end { out.insets[1] = x } else { out.insets[3] = x }
  out.maxWidth = f32.max(0.0, w - x - 4.0)
  if options.matchWidth { out.minWidth = f32.min(out.maxWidth, a.width()) }
  return out
}

/// The placement for `style` flipped by `flip`.
fn resolve(style: &AnchorStyle, flip: u8, a: Rect<f32>, w: f32, h: f32, bw: f32, bh: f32, base: &Placement) -> Placement {
  let mut out = base.*
  out.flip = flip
  let block = u8.bitAnd(flip, TRY_FLIP_BLOCK) != 0
  let inline = u8.bitAnd(flip, TRY_FLIP_INLINE) != 0
  let mut edges = style.edges
  if block {
    edges = [flipSide(edges[2]), edges[1], flipSide(edges[0]), edges[3]]
  }
  if inline {
    edges = [edges[0], flipSide(edges[3]), edges[2], flipSide(edges[1])]
  }
  let mut e: usize = 0
  while e < 4 {
    if edges[e] != SIDE_NONE {
      let at = sideAt(edges[e], e, a)
      if at == at {
        let bit = bitOf(e)
        out.set = u8.bitOr(out.set, bit)
        out.insets[e] = if e == 0 || e == 3 { at } else if e == 1 { w - at } else { h - at }
      }
    }
    e = e + 1
  }
  if style.area != 0 {
    let mut rows = style.rows()
    let mut columns = style.columns()
    if block { rows = flipTracks(rows) }
    if inline { columns = flipTracks(columns) }
    area(&mut out, rows, a.yMin, a.yMax, h, bh, 0, 2)
    area(&mut out, columns, a.xMin, a.xMax, w, bw, 3, 1)
  }
  return out
}

/// One axis of `position-area`: `startEdge` and `endEdge` are the inset indices.
fn area(out: &mut Placement, tracks: u8, aMin: f32, aMax: f32, size: f32, box: f32, startEdge: usize, endEdge: usize) -> () {
  let cellMin: f32 = if u8.bitAnd(tracks, TRACK_START) != 0 { 0.0 } else if u8.bitAnd(tracks, TRACK_CENTER) != 0 { aMin } else { aMax }
  let cellMax: f32 = if u8.bitAnd(tracks, TRACK_END) != 0 { size } else if u8.bitAnd(tracks, TRACK_CENTER) != 0 { aMax } else { aMin }
  let startBit = bitOf(startEdge)
  let endBit = bitOf(endEdge)
  // The box sits against the anchor: at the cell's end above or left of it, at its start
  // below or right, centred in the anchor's own track, and centred on the anchor when the
  // area spans all three.
  if tracks == TRACK_START || tracks == u8.bitOr(TRACK_START, TRACK_CENTER) {
    out.set = u8.bitOr(out.set, endBit)
    out.cleared = u8.bitOr(out.cleared, startBit)
    out.insets[endEdge] = size - cellMax
  } else {
    // Centred on the anchor, it still stays inside the containing block when it can.
    let start: f32 = if tracks == TRACK_CENTER { cellMin + (cellMax - cellMin - box) * 0.5 }
      else if tracks == TRACKS_ALL { f32.max(cellMin, f32.min((aMin + aMax) * 0.5 - box * 0.5, cellMax - box)) } else { cellMin }
    out.set = u8.bitOr(out.set, startBit)
    out.cleared = u8.bitOr(out.cleared, endBit)
    out.insets[startEdge] = start
  }
  if startEdge == 0 { out.maxHeight = cellMax - cellMin } else { out.maxWidth = cellMax - cellMin }
}

fn flipTracks(tracks: u8) -> u8 {
  let start = u8.bitAnd(tracks, TRACK_START) != 0
  let end = u8.bitAnd(tracks, TRACK_END) != 0
  let mut out = u8.bitAnd(tracks, TRACK_CENTER)
  if start { out = u8.bitOr(out, TRACK_END) }
  if end { out = u8.bitOr(out, TRACK_START) }
  return out
}

fn flipSide(side: u8) -> u8 {
  if side == SIDE_TOP { return SIDE_BOTTOM }
  if side == SIDE_BOTTOM { return SIDE_TOP }
  if side == SIDE_LEFT { return SIDE_RIGHT }
  if side == SIDE_RIGHT { return SIDE_LEFT }
  if side == SIDE_START { return SIDE_END }
  if side == SIDE_END { return SIDE_START }
  if side >= SIDE_PERCENT { return SIDE_PERCENT + (100 - (side - SIDE_PERCENT)) }
  return side
}

/// The position of the anchor `side` along the axis of inset `edge`, or NaN.
fn sideAt(side: u8, edge: usize, a: Rect<f32>) -> f32 {
  let vertical = edge == 0 || edge == 2
  let min = if vertical { a.yMin } else { a.xMin }
  let max = if vertical { a.yMax } else { a.xMax }
  // The inset's own side of the anchor: its top for `top`, its right for `right`.
  let near = if edge == 0 || edge == 3 { min } else { max }
  let far = if edge == 0 || edge == 3 { max } else { min }
  if side == SIDE_TOP || side == SIDE_LEFT || side == SIDE_START { return min }
  if side == SIDE_BOTTOM || side == SIDE_RIGHT || side == SIDE_END { return max }
  if side == SIDE_CENTER { return (min + max) * 0.5 }
  if side == SIDE_INSIDE { return near }
  if side == SIDE_OUTSIDE { return far }
  if side >= SIDE_PERCENT { return min + (max - min) * u8.toF32(side - SIDE_PERCENT) / 100.0 }
  return f32.NAN
}

/// Whether the box `placement` gives stays inside its `w` by `h` containing block.
fn fits(placement: &Placement, w: f32, h: f32, bw: f32, bh: f32, now: Rect<f32>, cb: Rect<f32>) -> bool {
  let x = span(placement, 3, 1, w, bw, now.xMin - cb.xMin)
  let y = span(placement, 0, 2, h, bh, now.yMin - cb.yMin)
  return x[0] >= -0.5 && x[1] <= w + 0.5 && y[0] >= -0.5 && y[1] <= h + 0.5
}

fn span(placement: &Placement, startEdge: usize, endEdge: usize, size: f32, box: f32, current: f32) -> [f32; 2] {
  let start = u8.bitAnd(placement.set, bitOf(startEdge)) != 0
  let end = u8.bitAnd(placement.set, bitOf(endEdge)) != 0
  if start && end { return [placement.insets[startEdge], size - placement.insets[endEdge]] }
  if start { return [placement.insets[startEdge], placement.insets[startEdge] + box] }
  if end { return [size - placement.insets[endEdge] - box, size - placement.insets[endEdge]] }
  return [current, current + box]
}

fn find(tree: &UiTree<'_>, slot: u32, id: u32) -> usize {
  let mut i: usize = 0
  while i < tree.cssPlacements.length() {
    let p = &tree.cssPlacements.asSlice()[i]
    if p.slot == slot && p.id == id { return i }
    i = i + 1
  }
  return NO_INDEX
}

/// Writes the placement of `slot` into its resolved style. It only overwrites what anchor
/// positioning owns, so applying it again (to a style lent by a sibling) changes nothing.
/// An anchored box with no placement or no anchor keeps `auto` in its `anchor()` insets.
pub fn apply(tree: &UiTree<'_>, slot: u32, id: u32, computed: &mut Computed) -> () {
  let style = computed.anchor
  if !style.anchored() {
    return ()
  }
  let position = computed.layout.position
  if position != Position.Absolute && position != Position.Fixed {
    return ()
  }
  let at = find(tree, slot, id)
  let mut written = [computed.layout.inset.top, computed.layout.inset.right, computed.layout.inset.bottom, computed.layout.inset.left]
  if at == NO_INDEX || !tree.cssPlacements.asSlice()[at].found {
    // A popup waits, hidden, for an anchor that is laid out.
    if !tree.node(slot).isGenerated() && anchoring.find(tree, id) != NO_INDEX { computed.layout.display = CssDisplay.None }
    return ()
  }
  let p = tree.cssPlacements.asSlice()[at]
  // Which declared inset each edge takes its `anchor()` from, after the flips.
  let mut from: [usize; 4] = [0, 1, 2, 3]
  if u8.bitAnd(p.flip, TRY_FLIP_BLOCK) != 0 { from = [from[2], from[1], from[0], from[3]] }
  if u8.bitAnd(p.flip, TRY_FLIP_INLINE) != 0 { from = [from[0], from[3], from[2], from[1]] }
  let mut e: usize = 0
  while e < 4 {
    let bit = bitOf(e)
    let source = from[e]
    if u8.bitAnd(p.set, bit) != 0 {
      let offset: f32 = if style.edges[source] != SIDE_NONE { style.offset(source) } else { 0.0 }
      written[e] = Dimension.px(p.insets[e] + offset)
    } else if u8.bitAnd(p.cleared, bit) != 0 || style.edges[source] != SIDE_NONE || style.edges[e] != SIDE_NONE {
      written[e] = Dimension.auto()
    }
    e = e + 1
  }
  if p.width >= 0.0 { computed.layout.width = SizeValue.px(p.width) }
  if p.height >= 0.0 { computed.layout.height = SizeValue.px(p.height) }
  // The `position-area` cell bounds an auto size.
  if p.maxWidth >= 0.0 && (p.popup || computed.layout.width.kind == DimensionKind.Auto) { computed.layout.maxWidth = SizeValue.px(f32.max(p.maxWidth, 0.0)) }
  if p.maxHeight >= 0.0 && (p.popup || computed.layout.height.kind == DimensionKind.Auto) { computed.layout.maxHeight = SizeValue.px(f32.max(p.maxHeight, 0.0)) }
  if p.minWidth >= 0.0 { computed.layout.minWidth = SizeValue.px(p.minWidth) }
  computed.layout.inset.top = written[0]
  computed.layout.inset.right = written[1]
  computed.layout.inset.bottom = written[2]
  computed.layout.inset.left = written[3]
}

fn bitOf(edge: usize) -> u8 {
  return if edge == 0 { 1 } else if edge == 1 { 2 } else if edge == 2 { 4 } else { 8 }
}

fn fragmentOf(tree: &UiTree<'_>, slot: u32) -> usize {
  let node = tree.node(slot)
  if !node.live {
    return NO_INDEX
  }
  return if node.css < tree.fragmentOf.length() { tree.fragmentOf.get(node.css) } else { NO_INDEX }
}
