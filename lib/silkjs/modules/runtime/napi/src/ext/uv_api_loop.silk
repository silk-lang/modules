    let offset = i32.toUsize(index) * 16
    let flags = unsafe readInt(unsafe nn(containers), offset)
    let data = unsafe readWord(unsafe nn(containers), offset + 8)
    let parent = unsafe Pointer.read<i32>(unsafe Pointer.atMut<i32>(fds, i32.toUsize(index * 2)))
    let child = unsafe Pointer.read<i32>(unsafe Pointer.atMut<i32>(fds, i32.toUsize(index * 2 + 1)))
