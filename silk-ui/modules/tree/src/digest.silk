//! What a layout put where, listed in a form that does not depend on how css-layout stores it:
//! every box, and every piece of text with the line it sits on, in paint order. The windowless
//! bench hashes these lists (`SILK_UI_BENCH_DIGEST`) to prove that two builds of the engine
//! place every box and every glyph alike.
import engine { UiTree }
import node { NO_INDEX }
import layout.lib { FragmentKind, TextFragmentKind, TEXT_LINE }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.usize

/// A box or inline box of the layout, in CSS pixels of the viewport.
pub struct DigestBox {
  pub inline: bool,
  pub source: usize,
  pub x: f32,
  pub y: f32,
  pub width: f32,
  pub height: f32,
  pub overflowWidth: f32,
  pub overflowHeight: f32,
}

impl Copy for DigestBox {}

/// One run of text on a line, in CSS pixels of the viewport.
pub struct DigestText {
  pub source: usize,
  pub start: usize,
  pub end: usize,
  pub fontKey: usize,
  pub shapeKey: usize,
  /// 0 a glyph run, 1 a tab, 2 a preserved line break.
  pub kind: usize,
  pub bidiLevel: usize,
  pub x: f32,
  pub y: f32,
  pub width: f32,
  pub height: f32,
  /// The alphabetic baseline, from the run's top.
  pub baseline: f32,
  /// The line box the run sits on.
  pub lineTop: f32,
  pub lineHeight: f32,
}

impl Copy for DigestText {}

/// How the layout output is made up.
pub struct DigestCounts {
  pub fragments: usize,
  pub boxes: usize,
  pub inlines: usize,
  /// Line boxes stored as fragments, and of those the ones with nothing in them.
  pub lines: usize,
  pub emptyLines: usize,
  /// Runs of text, and of those the ones stored as fragments.
  pub texts: usize,
  pub textFragments: usize,
  /// Line fragments that hold nothing but runs of text, and those runs.
  pub plainLines: usize,
  pub plainTexts: usize,
  /// Line fragments that hold exactly one run of text and nothing else.
  pub singleLines: usize,
  /// Line boxes that are records of text fragments (css-layout's `TEXT_LINE`): lines of text
  /// alone, which have no fragment. With `lines`, every line box of the layout.
  pub lineRecords: usize,
  /// Records of text fragments in all: runs, line boxes, and what goes with a line box.
  pub records: usize,
}

impl Copy for DigestCounts {}

/// Lists the layout's boxes in fragment order and its runs of text in paint order.
pub effect fn digestLayout(tree: &UiTree<'_>, boxes: &mut List<DigestBox>, texts: &mut List<DigestText>) -> DigestCounts
  ! OutOfMemoryError
  ? &mut Allocator {
  boxes.clear()
  texts.clear()
  let values = tree.output.fragments.values.asSlice()
  let mut counts = DigestCounts {
    fragments: values.length, boxes: 0, inlines: 0, lines: 0, emptyLines: 0,
    texts: 0, textFragments: 0, plainLines: 0, plainTexts: 0, singleLines: 0, lineRecords: 0,
    records: tree.output.fragments.texts.length(),
  }
  let records = tree.output.fragments.texts.asSlice()
  let mut record: usize = 0
  while record < records.length {
    if records[record].part == TEXT_LINE { counts.lineRecords = counts.lineRecords + 1 }
    record = record + 1
  }
  let mut index: usize = 0
  while index < values.length {
    let f = &values[index]
    if f.kind == FragmentKind.Box || f.kind == FragmentKind.Inline {
      if f.kind == FragmentKind.Box { counts.boxes = counts.boxes + 1 } else { counts.inlines = counts.inlines + 1 }
      run boxes.append(
        DigestBox {
          inline: f.kind == FragmentKind.Inline,
          source: f.source,
          x: f.worldLocation.x,
          y: f.worldLocation.y,
          width: f.size.width,
          height: f.size.height,
          overflowWidth: f.scrollableOverflow.width,
          overflowHeight: f.scrollableOverflow.height,
        },
      )
    } else if f.kind == FragmentKind.Line {
      counts.lines = counts.lines + 1
      let mut plain = true
      let mut held: usize = 0
      let mut child = f.firstChild
      while child != NO_INDEX {
        if values[child].kind != FragmentKind.Text || values[child].firstChild != NO_INDEX { plain = false }
        held = held + 1
        child = values[child].nextSibling
      }
      if held == 0 { counts.emptyLines = counts.emptyLines + 1 }
      if plain && held != 0 {
        counts.plainLines = counts.plainLines + 1
        counts.plainTexts = counts.plainTexts + held
        if held == 1 { counts.singleLines = counts.singleLines + 1 }
      }
    } else if f.textData != NO_INDEX {
      counts.textFragments = counts.textFragments + 1
      let mut runs = tree.output.fragments.textRuns(index)
      while runs.next() {
        let placed = runs.current
        counts.texts = counts.texts + 1
        run texts.append(
          DigestText {
            source: f.source,
            start: placed.sourceStart,
            end: placed.sourceEnd,
            fontKey: placed.fontKey,
            shapeKey: placed.shapeKey,
            kind: match placed.kind {
              TextFragmentKind.Glyphs => 0
              TextFragmentKind.Tab => 1
              TextFragmentKind.SegmentBreak => 2
            },
            bidiLevel: u8.toUsize(placed.bidiLevel),
            x: placed.location.x,
            y: placed.location.y,
            width: placed.size.width,
            height: placed.size.height,
            baseline: f.firstBaselines.alphabetic,
            lineTop: placed.lineLocation.y,
            lineHeight: placed.lineSize.height,
          },
        )
      }
    }
    index = index + 1
  }
  return counts
}
