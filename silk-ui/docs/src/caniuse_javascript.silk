    return Answer { support: "y", note: "An app is an ES module, bundled by Vite; there is no `<script type=\"module\">`." }
  }
  if id == "es6-module-dynamic-import" {
    return Answer { support: "y", note: "`import()` loads the modules the host knows: those in the bundle, or by path with `App.runtime(Runtime.node())`." }
  }
  if id == "es6-number" {
    return Answer { support: "y", note: "" }
