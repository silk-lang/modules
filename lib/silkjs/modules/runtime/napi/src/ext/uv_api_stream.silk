  if isNull(address) { return 0 }
  let family = familyOf(unsafe nn(address))
  if family == AF_INET { unsafe set<u32>(header, 8, 16) return 0 }
  if family == AF_INET6 { unsafe set<u32>(header, 8, 28) return 0 }
  if family == AF_UNIX { unsafe set<u32>(header, 8, SOCKADDR_UN_BYTES) return 0 }
  if family == AF_UNSPEC { unsafe setPtr(header, 0, none()) return 0 }
  return -EINVAL
}
unsafe fn sendHeader(fd: i32, header: *mut u8) -> isize {
  return unsafe sendmsg(fd, unsafe Intrinsic.pointerRequalify<*mut Message, *const Message>(unsafe cell<Message>(header, 0)), 0)
}
// libuv's uv__udp_sendmsg1: 1 when sent, or a negative errno.
unsafe fn sendOne(fd: i32, bufs: *mut u8, count: u32, address: ?*mut u8) -> i32 {
