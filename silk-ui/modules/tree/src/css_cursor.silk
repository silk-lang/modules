//! CSS `cursor` with images: `url(hand.png) 4 2, url(hand.svg), pointer`. Style keeps only the
//! closing keyword and whether images come first (`Computed.cursor`, `Computed.cursorUrl`); the
//! images are read back from the node's declaration when the pointer is over it.
import mutation { Cursor }
import silk.collections.slice { Slice }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u8

/// The cursor image to show: a loaded stylesheet image resource and the hot spot the list
/// gives, in CSS pixels (`hot` false: none given, the top left).
pub struct CursorImage {
  pub resource: u32,
  pub hotX: f32,
  pub hotY: f32,
  pub hot: bool,
}

impl Copy for CursorImage {}

/// One image of a cursor list, with its hot spot in image pixels when the list gives one.
pub struct CursorUrl {
  pub url: Bytes,
  pub hotX: f32,
  pub hotY: f32,
  pub hot: bool,
}

/// The parts of `css` between top-level commas, as start and end offsets.
fn nextPart(css: &[u8], start: usize) -> usize {
  let mut depth: usize = 0
  let mut quote: u8 = 0
  let mut i = start
  while i < css.length {
    let byte = css[i]
    if quote != 0 {
      if byte == 92 {
        i = i + 1
      } else if byte == quote {
        quote = 0
      }
    } else if byte == 34 || byte == 39 {
      quote = byte
    } else if byte == 40 {
      depth = depth + 1
    } else if byte == 41 && depth > 0 {
      depth = depth - 1
    } else if byte == 44 && depth == 0 {
      return i
    }
    i = i + 1
  }
  return css.length
}

fn space(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 12
}

fn trimmed(css: &[u8], start: usize, end: usize) -> &[u8] {
  let mut a = start
  let mut b = end
  while a < b && space(css[a]) {
    a = a + 1
  }
  while b > a && space(css[b - 1]) {
    b = b - 1
  }
  return Slice.view(css, a, b - a)
}

fn named(name: &[u8], word: &[u8]) -> bool {
  if name.length != word.length {
    return false
  }
  let mut i: usize = 0
  while i < name.length {
    if lower(name[i]) != word[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// The tree's cursor for a CSS `cursor` keyword; None for `auto`, the arrow for an unknown
/// word.
pub fn cursorOf(name: &[u8]) -> Option<Cursor> {
  if named(name, b"auto") { return Option<Cursor>.None }
  if named(name, b"pointer") { return Option<Cursor>.Some { value: Cursor.Pointer } }
  if named(name, b"text") { return Option<Cursor>.Some { value: Cursor.Text } }
  if named(name, b"none") { return Option<Cursor>.Some { value: Cursor.None } }
  if named(name, b"wait") { return Option<Cursor>.Some { value: Cursor.Wait } }
  if named(name, b"progress") { return Option<Cursor>.Some { value: Cursor.Progress } }
  if named(name, b"help") { return Option<Cursor>.Some { value: Cursor.Help } }
  if named(name, b"context-menu") { return Option<Cursor>.Some { value: Cursor.ContextMenu } }
  if named(name, b"copy") { return Option<Cursor>.Some { value: Cursor.Copy } }
  if named(name, b"alias") { return Option<Cursor>.Some { value: Cursor.Alias } }
  if named(name, b"vertical-text") { return Option<Cursor>.Some { value: Cursor.VerticalText } }
  if named(name, b"col-resize") { return Option<Cursor>.Some { value: Cursor.ColumnResize } }
  if named(name, b"row-resize") { return Option<Cursor>.Some { value: Cursor.RowResize } }
  if named(name, b"zoom-in") { return Option<Cursor>.Some { value: Cursor.ZoomIn } }
  if named(name, b"zoom-out") { return Option<Cursor>.Some { value: Cursor.ZoomOut } }
  if named(name, b"move") { return Option<Cursor>.Some { value: Cursor.Move } }
  if named(name, b"grab") { return Option<Cursor>.Some { value: Cursor.Grab } }
  if named(name, b"grabbing") { return Option<Cursor>.Some { value: Cursor.Grabbing } }
  if named(name, b"not-allowed") { return Option<Cursor>.Some { value: Cursor.NotAllowed } }
  if named(name, b"ew-resize") { return Option<Cursor>.Some { value: Cursor.ResizeHorizontal } }
  if named(name, b"ns-resize") { return Option<Cursor>.Some { value: Cursor.ResizeVertical } }
  if named(name, b"nwse-resize") { return Option<Cursor>.Some { value: Cursor.ResizeNorthWestSouthEast } }
  if named(name, b"nesw-resize") { return Option<Cursor>.Some { value: Cursor.ResizeNorthEastSouthWest } }
  if named(name, b"crosshair") { return Option<Cursor>.Some { value: Cursor.Crosshair } }
  if named(name, b"cell") { return Option<Cursor>.Some { value: Cursor.Cell } }
  if named(name, b"no-drop") { return Option<Cursor>.Some { value: Cursor.NoDrop } }
  if named(name, b"all-scroll") { return Option<Cursor>.Some { value: Cursor.AllScroll } }
  if named(name, b"n-resize") { return Option<Cursor>.Some { value: Cursor.ResizeNorth } }
  if named(name, b"e-resize") { return Option<Cursor>.Some { value: Cursor.ResizeEast } }
  if named(name, b"s-resize") { return Option<Cursor>.Some { value: Cursor.ResizeSouth } }
  if named(name, b"w-resize") { return Option<Cursor>.Some { value: Cursor.ResizeWest } }
  if named(name, b"ne-resize") { return Option<Cursor>.Some { value: Cursor.ResizeNorthEast } }
  if named(name, b"nw-resize") { return Option<Cursor>.Some { value: Cursor.ResizeNorthWest } }
  if named(name, b"se-resize") { return Option<Cursor>.Some { value: Cursor.ResizeSouthEast } }
  if named(name, b"sw-resize") { return Option<Cursor>.Some { value: Cursor.ResizeSouthWest } }
  return Option<Cursor>.Some { value: Cursor.Default }
}

fn lower(byte: u8) -> u8 {
  return if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

/// Whether `part` opens with `url(`.
fn urlPart(part: &[u8]) -> bool {
  if part.length < 4 {
    return false
  }
  return lower(part[0]) == 117 && lower(part[1]) == 114 && lower(part[2]) == 108 && part[3] == 40
}

/// The keyword that closes `css` (None for `auto`), and whether images come before it.
pub fn textCursor(css: &[u8]) -> Option<Cursor> {
  let mut start: usize = 0
  let mut last = Slice.view(css, 0, 0)
  while start <= css.length {
    let end = nextPart(css, start)
    last = trimmed(css, start, end)
    start = end + 1
  }
  if urlPart(last) {
    return Option<Cursor>.Some { value: Cursor.Default }
  }
  return cursorOf(last)
}

/// Whether `css` names a cursor image.
pub fn textHasUrl(css: &[u8]) -> bool {
  let part = trimmed(css, 0, nextPart(css, 0))
  return urlPart(part)
}

/// The number at the start of `text`, and how many bytes it took; None without one.
fn number(text: &[u8], at: usize) -> Option<f32> {
  let mut i = at
  let mut value: f32 = 0.0
  let mut digits = false
  while i < text.length && text[i] >= 48 && text[i] <= 57 {
    value = value * 10.0 + u8.toF32(text[i] - 48)
    digits = true
    i = i + 1
  }
  if i < text.length && text[i] == 46 {
    i = i + 1
    let mut scale: f32 = 0.1
    while i < text.length && text[i] >= 48 && text[i] <= 57 {
      value = value + u8.toF32(text[i] - 48) * scale
      scale = scale * 0.1
      digits = true
      i = i + 1
    }
  }
  if !digits {
    return Option<f32>.None
  }
  return Option<f32>.Some { value: value }
}

/// The images `css` lists, in order, each with its hot spot when given.
pub effect fn urlsOf(css: &[u8]) -> List<CursorUrl>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<CursorUrl>.make()
  let mut start: usize = 0
  while start < css.length {
    let end = nextPart(css, start)
    let part = trimmed(css, start, end)
    start = end + 1
    if !urlPart(part) {
      continue
    }
    // The address: quoted or bare, up to the matching `)`.
    let mut i: usize = 4
    while i < part.length && space(part[i]) {
      i = i + 1
    }
    let mut url = Bytes.make()
    if i < part.length && (part[i] == 34 || part[i] == 39) {
      let quote = part[i]
      i = i + 1
      while i < part.length && part[i] != quote {
        if part[i] == 92 && i + 1 < part.length {
          i = i + 1
        }
        run url.append(Slice.view(part, i, 1))
        i = i + 1
      }
      i = i + 1
      while i < part.length && part[i] != 41 {
        i = i + 1
      }
    } else {
      while i < part.length && part[i] != 41 && !space(part[i]) {
        run url.append(Slice.view(part, i, 1))
        i = i + 1
      }
      while i < part.length && part[i] != 41 {
        i = i + 1
      }
    }
    i = i + 1
    // An optional `x y` hot spot.
    while i < part.length && space(part[i]) {
      i = i + 1
    }
    let mut hotX: f32 = 0.0
    let mut hotY: f32 = 0.0
    let mut hot = false
    if let Option.Some { value: x } = number(part, i) {
      while i < part.length && !space(part[i]) {
        i = i + 1
      }
      while i < part.length && space(part[i]) {
        i = i + 1
      }
      if let Option.Some { value: y } = number(part, i) {
        hotX = x
        hotY = y
        hot = true
      }
    }
    if url.length() > 0 {
      run out.append(CursorUrl { url: move url, hotX: hotX, hotY: hotY, hot: hot })
    }
  }
  return move out
}
