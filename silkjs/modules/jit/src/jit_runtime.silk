import silkjs.js_core_types { HOT_ENTRY_BUDGET, FunctionBytecode, CompiledEntry, OsrEntry, OSR_ONLY_CALL_WORDS, HostHook, NativeFunctionId, BuiltinFamily, SiteShapes, noteSiteShape, fieldCacheIndex, fieldSpareIndex, FIELD_PROTO_KEY, ObjectData, ObjectPayload, RuntimeState, ShapeData, ScopeData, VarRef, VarRefState, scopeSlot, SCOPE_OPERAND, SCOPE_DEPTH_SHIFT, SCOPE_SLOT_MASK, JS_PROP_TMASK, JS_PROP_WRITABLE }
