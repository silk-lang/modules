          let rv2 = unsafe terminateSession(sp, PROTOCOL_ERROR, b"SETTINGS expected")
          if isFatal(rv2) { return i32.toI64(rv2) }
          return inlen
        }
        unsafe setState(sp, IB_READ_HEAD)
      }
