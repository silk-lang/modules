// --- Addresses ---------------------------------------------------------------------------------

pub export "C" fn uv_ip4_addr(text: *const u8, port: i32, address: *mut u8) -> i32 { return unsafe inet.uv_ip4_addr(text, port, address) }
pub export "C" fn uv_ip6_addr(text: *const u8, port: i32, address: *mut u8) -> i32 { return unsafe inet.uv_ip6_addr(text, port, address) }
pub export "C" fn uv_ip4_name(address: *const u8, text: *mut u8, size: usize) -> i32 { return unsafe inet.uv_ip4_name(address, text, size) }
pub export "C" fn uv_ip6_name(address: *const u8, text: *mut u8, size: usize) -> i32 { return unsafe inet.uv_ip6_name(address, text, size) }
/// uv_ip_name: the text form of a `struct sockaddr_in` or `struct sockaddr_in6`; UV_EAFNOSUPPORT
/// for another family.
pub export "C" fn uv_ip_name(address: *const u8, text: *mut u8, size: usize) -> i32 {
  let family = unsafe addressFamily(address)
  if family == AF_INET { return unsafe inet.uv_ip4_name(address, text, size) }
  if family == AF_INET6 { return unsafe inet.uv_ip6_name(address, text, size) }
  return 0 - EAFNOSUPPORT
}
pub export "C" fn uv_inet_ntop(af: i32, source: *const u8, text: *mut u8, size: usize) -> i32 { return unsafe inet.uv_inet_ntop(af, source, text, size) }
pub export "C" fn uv_inet_pton(af: i32, text: ?*const u8, destination: ?*mut u8) -> i32 { return unsafe inet.uv_inet_pton(af, text, destination) }

/// uv_if_indextoname: the name of interface `index`. UV_ENOBUFS, with the needed capacity stored,
/// when it does not fit.
pub export "C" fn uv_if_indextoname(index: u32, buffer: ?*mut u8, size: ?*mut usize) -> i32 {
  if Pointer.isNull<u8>(buffer) || unsafe noCapacity(size) { return 0 - EINVAL }
  let mut name: [u8; 17] = [0; 17]
  if Pointer.isNull<u8>(unsafe if_indextoname(index, Pointer.fromMutRef<u8>(&mut name[0]))) { return unsafe failure() }
  let mut length: usize = 0
  while length < IF_NAMESIZE && name[length] != 0 { length = length + 1 }
  let capacity = unsafe sizeOf(size)
  if unsafe Pointer.read<usize>(capacity) <= length {
    unsafe Pointer.write<usize>(capacity, length + 1)
    return 0 - ENOBUFS
  }
  let out = unsafe presentMut(buffer)
  unsafe copyBytes(out, Pointer.fromRef<u8>(&name[0]), length)
  unsafe setByte(out, length, 0)
  unsafe Pointer.write<usize>(capacity, length)
  return 0
}
/// uv_if_indextoiid: on Unix, the interface's name, as uv_if_indextoname.
pub export "C" fn uv_if_indextoiid(index: u32, buffer: ?*mut u8, size: ?*mut usize) -> i32 { return unsafe uv_if_indextoname(index, buffer, size) }

// --- Random bytes (src/random.c, src/unix/random-*.c) ------------------------------------------

// uv__random_readpath: fills the buffer from the character device at `path`.
unsafe fn readDevice(path: *const u8, buffer: *mut u8, length: usize) -> i32 {
  let fd = unsafe open(path, O_CLOEXEC)
  if fd == -1 { return unsafe failure() }
  let mut status: [u64; 32] = [0; 32]
  if unsafe statusOf(fd, &mut status) != 0 {
    let failed = unsafe failure()
    let _closed = unsafe closeKeeping(fd)
    return failed
  }
  // S_ISCHR.
  if fileKind(&status) != 8192 { let _closed = unsafe closeKeeping(fd) return 0 - EIO }
  let mut at: usize = 0
  while at != length {
    let mut n: isize = -1
    while true {
      n = unsafe read(fd, unsafe offsetMut(buffer, at), length - at)
      if n != -1 || unsafe errno() != EINTR { break }
    }
    if n == -1 {
      let failed = unsafe failure()
      let _closed = unsafe closeKeeping(fd)
      return failed
    }
    if n == 0 { let _closed = unsafe closeKeeping(fd) return 0 - EIO }
    at = at + isize.toUsize(n)
  }
  let _closed = unsafe closeKeeping(fd)
  return 0
}

fn seededWord() -> *mut u64 { return Intrinsic.processWord() }
// uv__random_devurandom: one byte of /dev/random first, once per process (its status is kept),
// then /dev/urandom.
unsafe fn devurandom(buffer: *mut u8, length: usize) -> i32 {
  // The word is 0 before the first read, 1 while it runs, and 2 with the status above bit 32 after.
  let word = seededWord()
  while true {
    let current = unsafe Atomic.load<u64>(word, MemoryOrder.Acquire)
    if (current & 3) == 2 { break }
    if current == 0 {
      let raced = unsafe Atomic.compareExchange<u64>(word, 0, 1, MemoryOrder.AcquireRelease, MemoryOrder.Acquire)
      match move raced {
        CompareExchange<u64>.Exchanged => {
          let mut byte: u8 = 0
          let status = unsafe readDevice(cstr(b"/dev/random\0"), Pointer.fromMutRef<u8>(&mut byte), 1)
          unsafe Atomic.store<u64>(word, u64.shiftLeft(u32.toU64(i32.wrappingToU32(status)), 32) | 2, MemoryOrder.Release)
        }
        CompareExchange<u64>.Observed { value } => { let _seen = value }
      }
    }
  }
  let status = u32.wrappingToI32(u64.wrappingToU32(u64.shiftRight(unsafe Atomic.load<u64>(word, MemoryOrder.Acquire), 32)))
  if status != 0 { return status }
  return unsafe readDevice(cstr(b"/dev/urandom\0"), buffer, length)
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  // uv__random_getentropy: at most 256 bytes a call.
  unsafe fn systemRandom(buffer: *mut u8, length: usize) -> i32 {
    let base = unsafe Pointer.assumeManyMut<u8>(buffer)
    let mut at: usize = 0
    while at + 256 < length {
      if unsafe getentropy(unsafe Pointer.assumeManyMut<u8>(unsafe Pointer.atMut<u8>(base, at)), 256) != 0 { return unsafe failure() }
      at = at + 256
    }
    if unsafe getentropy(unsafe Pointer.assumeManyMut<u8>(unsafe Pointer.atMut<u8>(base, at)), length - at) != 0 { return unsafe failure() }
    return 0
  }
} else {
  // uv__random_getrandom: at most 256 bytes a call, retried on EINTR.
  unsafe fn systemRandom(buffer: *mut u8, length: usize) -> i32 {
    let base = unsafe Pointer.assumeManyMut<u8>(buffer)
    let mut at: usize = 0
    while at != length {
      let mut n: isize = -1
      while true {
        let mut chunk = length - at
        if chunk > 256 { chunk = 256 }
        n = unsafe getrandom(unsafe Pointer.assumeManyMut<u8>(unsafe Pointer.atMut<u8>(base, at)), chunk, 0)
        if n != -1 || unsafe errno() != EINTR { break }
      }
      if n == -1 { return unsafe failure() }
      if n == 0 { return 0 - EIO }
      at = at + isize.toUsize(n)
    }
    return 0
  }
  // `struct __sysctl_args` for the _sysctl system call.
  extern "C" struct SysctlArgs { name: *const i32, count: i32, value: *mut u8, length: *mut usize, replacement: ?*mut u8, replacementLength: usize, unused: [u64; 4] }
  // uv__random_sysctl: kernel.random.uuid, 14 bytes of each UUID; UV_ENOSYS where the system call
  // does not exist (aarch64) or the kernel was built without it.
  unsafe fn sysctlRandom(buffer: *mut u8, length: usize) -> i32 {
    static if Intrinsic.targetArchitecture() == "x86_64" {
      let name: [i32; 3] = [1, 40, 6]
      let mut at: usize = 0
      while at < length {
        let mut uuid: [u8; 16] = [0; 16]
        let mut size: usize = 16
        let mut args = SysctlArgs { name: Pointer.fromRef<i32>(&name[0]), count: 3, value: Pointer.fromMutRef<u8>(&mut uuid[0]), length: Pointer.fromMutRef<usize>(&mut size), replacement: Pointer.null<u8>(), replacementLength: 0, unused: [0; 4] }
        let number: i64 = 156
        if unsafe syscall(number, Pointer.fromMutRef<SysctlArgs>(&mut args)) == -1 { return unsafe failure() }
        if size != 16 { return 0 - EIO }
        uuid[6] = uuid[14]
        uuid[8] = uuid[15]
        let mut n = length - at
        if n > 14 { n = 14 }
        unsafe copyBytes(unsafe offsetMut(buffer, at), Pointer.fromRef<u8>(&uuid[0]), n)
        at = at + n
      }
      return 0
    } else {
      return 0 - ENOSYS
    }
  }
}

/// libuv's uv__random: fills `length` bytes at `buffer` from the system's generator. Linux:
/// getrandom, then /dev/urandom where it is missing, then the _sysctl UUID source when the devices
/// cannot be read. Darwin: getentropy. Returns 0 or a negative errno. It blocks until the system's
/// generator is seeded; call it off the loop thread.
pub unsafe fn randomFill(buffer: *mut u8, length: usize) -> i32 {
  let mut status = unsafe systemRandom(buffer, length)
  if status == 0 - ENOSYS { status = unsafe devurandom(buffer, length) }
  static if Intrinsic.targetOperatingSystem() == "linux" {
    if status == 0 - EACCES || status == 0 - EIO || status == 0 - ELOOP || status == 0 - EMFILE || status == 0 - ENFILE || status == 0 - ENOENT || status == 0 - EPERM {
      status = unsafe sysctlRandom(buffer, length)
    }
  }
  return status
}

