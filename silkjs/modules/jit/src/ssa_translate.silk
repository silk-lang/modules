//! Engine bytecode to the SSA form, for the first subset (docs/jit/ssa.md, "The translator").
//!
//! The output models the interpreter's counts literally: a pushed local or argument is a
//! `retain`, a dropped operand a `release`, a local written over releases its old value, a
//! return releases every local and leftover operand. `ssa_ownership` removes what it can prove
//! redundant. Anything outside the subset fails with `Refusal`; nothing is guessed.
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.i8
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silkjs.js_feedback as feedback
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silkjs.js_opcode_data as op
import silkjs.js_atom_data as atoms
import ssa { Function, Type, Own, RootKind, Op, Cmp, Imm, SlotMode, InlineMiss, KnownShapes, NONE, ELEM_STEP, ELEM_TRY, ELEM_STEPS, ELEM_ARGUMENTS, LENGTH_ARGUMENTS, FIELD_STEPS, FIELD_LEARN, TARGET_KNOWN_FN, SITE_ARRAY, SITE_BOUND }
import ssa_calls as calls
import silkjs.js_compiled as compiled
import silkjs.js_compiled_objects as objects
import silkjs.js_compiled_inline as inline
import ssa

/// What the translator reads about a function: plain numbers and the code bytes, nothing that
/// points into a runtime, so it can be serialized (ahead-of-time compilation).
pub struct FunctionInput {
  /// The final bytecode (`FunctionBytecode.code`).
  pub code: List<u8>,
  /// Argument cells the frame has (`argumentCount`).
  pub argumentCount: u32,
  /// Locals (`variableCount`).
  pub localCount: u32,
  /// Closure variables (`varRefCount`) and own scope slots (`scopeSlots`): refused when nonzero.
  pub closureVars: u32,
  pub scopeSlots: u32,
  /// A plain function (not a generator or async).
  pub normal: bool,
  /// The function's constants as numbers, by constant index (docs/jit/doubles.md).
  pub numberConstants: List<NumberConstant>,
  /// Bytecode offsets of arithmetic and comparison sites to compile as numbers (f64) rather
  /// than int32: sites that deoptimized in an earlier compilation of the same code.
  pub doubleSites: List<u32>,
  /// How many of doubleSites, at its end, baseline code noted (jit_runtime.missedSites); the
  /// ones before them are where optimized code left.
  pub notedSites: usize,
  /// Some local is captured by a closure (VarDef.isCaptured): a callee could read or write
  /// its frame cell, so on-stack-replacement code that holds it must not make calls.
  pub capturedLocals: bool,
  /// Per constant: CLOSURE_NONE (not a function's bytecode), CLOSURE_SAFE (a closure of it
  /// captures nothing from the creating frame's slots) or CLOSURE_FRAME.
  pub closures: List<u8>,
  /// Strict mode code (FunctionBytecode.mode).
  pub strict: bool,
  /// Call sites that may be inlined (docs/jit/inlining.md): what the embedder saw each one
  /// call when it compiled. A hint: the code guards the callee's identity where it is used.
  pub targets: List<CallTarget>,
  /// Element sites the embedder saw with one kind of receiver: pc << 8 | js_feedback element
  /// kind. A hint: the code still handles every receiver.
  pub elementKinds: List<u32>,
  /// What the function's cached field sites (get_field2) read from, as far as the embedder
  /// knows (js_compiled_inline.siteShapes). A hint: the code tests each shape it uses. An
  /// entry with no shapes marks a site that had not run (unseenRead).
  pub siteShapes: List<SiteShape>,
  /// Whether an exit inside an inlined body may leave the body part way through, for the
  /// engine to go on with in a frame of its own (ssa.Exit.frames): code on a baseline frame
  /// can. Without it a guard after an effect in a body fails the inlining.
  pub leavesBodies: bool,
  /// The atoms Array.prototype's own push and pop are under in the function's realm
  /// (js_compiled_inline.arrayNative), or 0: a method call under one of these names asks
  /// for the array operation first (calls.NATIVE_PUSH). Read from the function's own input.
  pub arrayPush: u32,
  pub arrayPop: u32,
  /// The version of a fresh array's shape in the function's realm
  /// (js_compiled_inline.arrayShapeVersion) when it fits 31 bits, else 0 (Function.arrayShape).
  pub arrayShape: u32,
  /// The slots of watched records (js_compiled_inline.cellRecord) the code may read as
  /// constants, for the function and every body inlined into it.
  pub records: List<RecordSlot>,
  /// Planned constructor sites (`new C(...)`) the embedder resolved to a fixed shape and
  /// store/recipe plan (frame mode only).
  pub constructs: List<ConstructTarget>,
}

pub const CONSTRUCT_PLAN_STORES: u8 = 1
pub const CONSTRUCT_PLAN_RECIPE: u8 = 2
pub const CONSTRUCT_PLAN_PREINIT: u8 = 3
pub const RCONST_UNDEF: u8 = 0
pub const RCONST_NULL: u8 = 1
pub const RCONST_FALSE: u8 = 2
pub const RCONST_TRUE: u8 = 3
pub const RCONST_INT: u8 = 4
pub const RCONST_F64: u8 = 5
pub const RECIPE_CONST: u32 = 0
pub const RECIPE_ARG: u32 = 1
pub const RECIPE_RECEIVER: u32 = 2
pub const RECIPE_NOT: u32 = 3
pub const RECIPE_SELECT: u32 = 4

/// Planned constructor target for `new C(...)` where the constructor function was read at `pc`
/// (`get_field` or `get_var`). Plain serializable data (no heap pointers).
pub struct ConstructTarget {
  pub pc: u32,
  pub id: u32,
  pub shapeVersion: u32,
  pub kind: u8,
  pub stores: u8,
  pub nodeCount: u8,
  pub sources: [u8; 8],
  pub roots: [u8; 8],
  pub nodes: [u32; 32],
  pub constKinds: [u8; 16],
  pub constBits: [u64; 16],
}
impl Copy for ConstructTarget {}
/// Slot `slot` of a watched record whose shape's version is `version` (`before`: what it
/// was before the watch, as inline keys filled earlier hold it) holds a constant of `kind`
/// (js_compiled_inline.RECORD_INT and the others) and `value`.
pub struct RecordSlot { pub before: u32, pub version: u32, pub slot: u32, pub kind: u8, pub value: i32 }
impl Copy for RecordSlot {}
/// The `count` (1 to 4) shapes the cached field site at `pc` read a data property from:
/// keys[i] is the shape's version << 16 with the slot (an own property) or
/// js_core_types.FIELD_PROTO_KEY (one of the direct prototype, whose shape version << 16 |
/// slot is protoKeys[i]). firstKeys[i] is not 0 when that holder is the prototype's
/// prototype: the version of the prototype's shape then, which proves it lacks the name and
/// fixes the holder.
pub struct SiteShape { pub pc: u32, pub count: u32, pub keys: [u64; 4], pub protoKeys: [u64; 4], pub firstKeys: [u64; 4] }
impl Copy for SiteShape {}

/// Whether the `get_field2` at `pc` of `input` had not run when it was compiled: its entry in
/// siteShapes has no shapes (the embedder's mark for a site nothing recorded) and no method
/// is known for it (FIELD_LEARN).
fn unseenRead(input: &FunctionInput, pc: u32) -> bool {
  let mut unseen = false
  let mut i: usize = 0
  while i < input.siteShapes.length() {
    let site = &input.siteShapes.asSlice()[i]
    if site.pc == pc { unseen = site.count == 0 }
    i = i + 1
  }
  if !unseen { return false }
  i = 0
  while i < input.targets.length() {
    if input.targets.asSlice()[i].pc == pc { return false }
    i = i + 1
  }
  return true
}
/// The function the call that follows the `get_field2` at `pc` called last, or the only one
/// the call at `pc` was recorded calling: `input` describes
/// it and `id` names it to the embedder (`Function.inlineTargets`).
/// The most blocks (past its first) an inlined body may have.
const INLINE_BLOCKS: usize = 24

pub struct CallTarget { pub pc: u32, pub id: u32, pub input: FunctionInput,
  /// `pc` is the call's own (a recorded call target, any call) rather than its `get_field2`'s.
  pub atCall: bool,
  /// The site calls other functions too (the embedder knows several, or not all): its
  /// targets are tested in turn and a call is made when none is the callee
  /// (Translator.callChain), where a single target is guarded with an exit.
  pub chained: bool,
  /// Bit i: the target is exact (ssa.TARGET_EXACT) and variable cell i of its closure owns
  /// an initialized value, which the body reads without a test (ssa.VAR_OWNED).
  pub owned: u64,
  /// The address of each cell `owned` marks, at its index (0 for the others).
  pub cells: List<usize>,
  /// The receivers' shapes the target's method is known for (ssa.TARGET_KNOWN); none
  /// otherwise.
  pub known: KnownShapes }

/// The call that began an inlined body: at `pc` of its caller's code with `argc` arguments,
/// the instruction after it at `after`; the caller's `locals` locals and `stack` operands at
/// the call (the call's among them) are in the translator's held values from `start`.
struct InlineCall { pc: u32, after: u32, argc: u32, method: bool, start: usize, locals: usize, stack: usize }
impl Copy for InlineCall {}

/// Inlined bodies nest at most this deep, and are at most this many bytes of code each.
const MAX_INLINE_DEPTH: u32 = 7
const MAX_INLINE_BYTES: usize = 460
/// Inlined call sites one function may have (each takes a frame record on the native stack).
const MAX_INLINE_SITES: usize = 64
/// Inlining at a call that is in no loop (of the function, or of a body around the call)
/// saves one call a run of the function, so it is kept cheap: the bodies inlined at such
/// calls come to at most MAX_INLINED_BYTES bytes of code in one function, and a body with a
/// loop of its own is inlined there only for a literal argument (the body is then compiled
/// for it); that body runs in its own optimized code otherwise, where its loop's calls are
/// inlined. A body of at most INLINE_SMALL bytes goes in wherever it is called. Without
/// this a short function at the top of a call tree is compiled as the whole tree (Crypto's
/// `decrypt`: 92 bytes of code, 3,294 instructions), as is each function between it and the
/// loop the time is spent in.
const MAX_INLINED_BYTES: usize = 920
const INLINE_SMALL: usize = 96

/// What an inlined body may be made of, opcode by opcode: straight-line code over constants,
/// unchecked locals, arguments, numbers, tests, property and element access, globals, calls
/// and a return. A list of its own, so an opcode a later change makes `supported` is not
/// inlinable until it is put here (its handler may read a table of the function's own, by pc).
fn inlinable(opcode: u8) -> bool {
  if !supported(opcode) { return false }
  return opcode == op.OP_push_i32 || opcode == op.OP_push_i8 || opcode == op.OP_push_i16
    || opcode == op.OP_push_0 || opcode == op.OP_push_1 || opcode == op.OP_undefined || opcode == op.OP_null
    || opcode == op.OP_push_true || opcode == op.OP_push_false
    || opcode == op.OP_drop || opcode == op.OP_dup || opcode == op.OP_nip || opcode == op.OP_swap || shuffleOf(opcode).length != 0
    || opcode == op.OP_get_loc || opcode == op.OP_put_loc || opcode == op.OP_set_loc
    || opcode == op.OP_get_loc8 || opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8
    || (opcode >= op.OP_get_loc0 && opcode <= op.OP_put_loc3)
    || opcode == op.OP_get_arg || (opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3)
    || opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_mul || opcode == op.OP_add_imm
    || opcode == op.OP_inc || opcode == op.OP_dec || opcode == op.OP_inc_loc || opcode == op.OP_dec_loc
    || opcode == op.OP_add_loc || opcode == op.OP_step_loc8
    || (opcode >= op.OP_add_loc_loc8 && opcode <= op.OP_mul_top_loc8)
    || (opcode >= op.OP_add_top_arg8 && opcode <= op.OP_mul_top_arg8)
    || opcode == op.OP_lt || opcode == op.OP_lte || opcode == op.OP_gt || opcode == op.OP_gte
    || opcode == op.OP_eq || opcode == op.OP_neq || opcode == op.OP_strict_eq || opcode == op.OP_strict_neq
    || opcode == op.OP_return || opcode == op.OP_return_undef || opcode == op.OP_fuse_prefix
    || isBranch(opcode) || isGoto(opcode)
    || opcode == op.OP_push_this || opcode == op.OP_get_field || opcode == op.OP_get_field2
    || opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8
    || opcode == op.OP_put_field || opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8
    || opcode == op.OP_push_atom_value || opcode == op.OP_push_empty_string
    || opcode == op.OP_get_var || opcode == op.OP_get_var_undef || opcode == op.OP_put_var
    || opcode == op.OP_get_array_el || opcode == op.OP_get_array_el2 || opcode == op.OP_get_array_el3
    || opcode == op.OP_put_array_el || opcode == op.OP_get_length
    || opcode == op.OP_put_arg || opcode == op.OP_set_arg || opcode == op.OP_step_arg8
    || opcode == op.OP_get_loc_length8 || opcode == op.OP_get_arg_length8 || opcode == op.OP_get_loc_el8
    || opcode == op.OP_get_arg_el8 || opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8
    || (opcode >= op.OP_call0 && opcode <= op.OP_call3) || opcode == op.OP_call || opcode == op.OP_call_method || opcode == op.OP_call_constructor
    || opcode == op.OP_throw || opcode == op.OP_throw_error
    || opcode == op.OP_div || opcode == op.OP_mod || opcode == op.OP_shl || opcode == op.OP_sar || opcode == op.OP_shr
    || opcode == op.OP_and || opcode == op.OP_xor || opcode == op.OP_or || opcode == op.OP_shl_imm || opcode == op.OP_sar_imm
    || opcode == op.OP_and_imm || opcode == op.OP_or_imm || opcode == op.OP_neg || opcode == op.OP_plus || opcode == op.OP_not
    || opcode == op.OP_lnot || opcode == op.OP_post_inc || opcode == op.OP_post_dec || opcode == op.OP_push_const
    || opcode == op.OP_push_const8 || opcode == op.OP_strict_eq_imm8 || opcode == op.OP_strict_neq_imm8
    || opcode == op.OP_is_undefined || opcode == op.OP_is_null || opcode == op.OP_is_undefined_or_null
    || opcode == op.OP_typeof_is_undefined || opcode == op.OP_typeof_is_function || opcode == op.OP_typeof_is
    || opcode == op.OP_typeof || opcode == op.OP_to_object || opcode == op.OP_instanceof
}

/// Whether the code of `input` reads the scope it runs under (`get_scope0`).
pub fn readsScope(input: &FunctionInput) -> bool {
  let mut at: usize = 0
  while at < input.code.length() {
    let opcode = byteAt(input, at)
    if opcode == op.OP_get_scope0 || opcode == op.OP_get_scope0_check { return true }
    at = at + sizeAt(input, at)
  }
  return false
}

/// Whether `operation` changes nothing a later exit to the state before the call would have
/// to undo (counts aside: the exit drops what the body owns). Anything not listed is an
/// effect, so an operation added later is one until it is put here.
fn withoutEffect(operation: Op) -> bool {
  return operation == Op.Arg || operation == Op.ConstI32 || operation == Op.Imm || operation == Op.Unbox || operation == Op.UnboxBool
    || operation == Op.BoxI32 || operation == Op.BoxBool || operation == Op.Add || operation == Op.Sub || operation == Op.Mul
    || operation == Op.Cmp || operation == Op.Retain || operation == Op.Release || operation == Op.CheckTag
    || operation == Op.GetField || operation == Op.AtomValue || operation == Op.GetVar || operation == Op.GetScope
    || operation == Op.GetElem || operation == Op.GetLength || operation == Op.Truthy || operation == Op.TagIs || operation == Op.TypeofAtom || operation == Op.Typeof || operation == Op.InstanceOf
    || operation == Op.CheckCallee || operation == Op.CheckShape || operation == Op.CheckWatched || operation == Op.IsCallee || operation == Op.InlineFrame || operation == Op.Jump || operation == Op.Branch
    || operation == Op.ConstF64 || ssa.isNumberOp(operation)
}
pub const CLOSURE_NONE: u8 = 0
pub const CLOSURE_SAFE: u8 = 1
pub const CLOSURE_FRAME: u8 = 2

/// Constant kinds of `NumberConstant`.
pub const CONSTANT_OTHER: u8 = 0
pub const CONSTANT_INT: u8 = 1
pub const CONSTANT_DOUBLE: u8 = 2
/// A constant of the function: an Int (`bits` its i32 bits), a Float64 (`bits` its f64 bits)
/// or something else.
pub struct NumberConstant { pub kind: u8, pub bits: u64 }
impl Copy for NumberConstant {}

/// Why a function was not translated. `pc` and `opcode` name the instruction, when one is to
/// blame (else `pc` is NONE).
pub struct Refusal { pub pc: u32, pub opcode: u8, pub reason: &'static [u8] }

fn refuse(pc: u32, opcode: u8, reason: &'static [u8]) -> Refusal { return Refusal { pc: pc, opcode: opcode, reason: reason } }

/// The opcodes the first subset translates.
pub fn supported(opcode: u8) -> bool {
  return opcode == op.OP_push_i32 || opcode == op.OP_push_i8 || opcode == op.OP_push_i16
    || opcode == op.OP_push_0 || opcode == op.OP_push_1 || opcode == op.OP_undefined || opcode == op.OP_null
    || opcode == op.OP_push_true || opcode == op.OP_push_false
    || opcode == op.OP_drop || opcode == op.OP_dup || opcode == op.OP_nip || opcode == op.OP_swap || shuffleOf(opcode).length != 0
    || opcode == op.OP_get_loc || opcode == op.OP_put_loc || opcode == op.OP_set_loc
    || opcode == op.OP_get_loc8 || opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8
    || (opcode >= op.OP_get_loc0 && opcode <= op.OP_put_loc3)
    || opcode == op.OP_get_arg || (opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3)
    || opcode == op.OP_set_loc_uninitialized || opcode == op.OP_get_loc_check || opcode == op.OP_get_loc_checkthis
    || opcode == op.OP_put_loc_check || opcode == op.OP_put_loc_check_init
    || opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_mul || opcode == op.OP_add_imm
    || opcode == op.OP_inc || opcode == op.OP_dec || opcode == op.OP_inc_loc || opcode == op.OP_dec_loc
    || opcode == op.OP_add_loc || opcode == op.OP_step_loc8
    || (opcode >= op.OP_add_loc_loc8 && opcode <= op.OP_mul_top_loc8)
    || (opcode >= op.OP_add_top_arg8 && opcode <= op.OP_mul_top_arg8)
    || opcode == op.OP_lt || opcode == op.OP_lte || opcode == op.OP_gt || opcode == op.OP_gte
    || opcode == op.OP_eq || opcode == op.OP_neq || opcode == op.OP_strict_eq || opcode == op.OP_strict_neq
    || opcode == op.OP_if_false || opcode == op.OP_if_true || opcode == op.OP_if_false8 || opcode == op.OP_if_true8
    || opcode == op.OP_goto || opcode == op.OP_goto8 || opcode == op.OP_goto16
    || opcode == op.OP_return || opcode == op.OP_return_undef || opcode == op.OP_fuse_prefix
    || opcode == op.OP_for_of_next
    || objectOpcode(opcode) || callOpcode(opcode) || numberOpcode(opcode) || keepBranch(opcode) || testOpcode(opcode) || genericOpcode(opcode)
    || exceptionOpcode(opcode)
    || opcode == op.OP_instanceof || opcode == op.OP_put_arg || opcode == op.OP_set_arg || opcode == op.OP_step_arg8
}

/// Stream P's opcodes (docs/jit/compiled-entry.md 3.1): `throw` and `throw_error` leave
/// through a cold exit at the instruction itself.
pub fn exceptionOpcode(opcode: u8) -> bool {
  return isThrow(opcode) || opcode == op.OP_catch || opcode == op.OP_nip_catch || opcode == op.OP_gosub || opcode == op.OP_ret
}
fn isThrow(opcode: u8) -> bool { return opcode == op.OP_throw || opcode == op.OP_throw_error }

/// Where on-stack-replacement code leaves for the interpreter: outside the subset, or a call
/// (OSR code runs on a live, possibly inline frame with no call block; docs/jit/osr.md).
fn osrExit(opcode: u8, calls: bool) -> bool {
  if opcode == op.OP_for_of_next { return false }
  return !supported(opcode) || (!calls && callOpcode(opcode)) || genericOpcode(opcode)
}
/// Whether OSR code for input may make calls: asked for, no captured local, and no
/// arguments object or direct eval that could alias the frame's cells.
fn osrMayCall(input: &FunctionInput, allowCalls: bool) -> bool {
  if !allowCalls || input.capturedLocals { return false }
  let mut pc: usize = 0
  while pc < input.code.length() {
    let opcode = byteAt(input, pc)
    if opcode == op.OP_special_object || opcode == op.OP_eval || opcode == op.OP_apply_eval { return false }
    let size = sizeAt(input, pc)
    if size == 0 { return false }
    pc = pc + size
  }
  return true
}

/// Stream N's generic instruction exits, group 1: plain stack-effect opcodes with no slot
/// operand and no control flow, pushing at most one value (js_vm.genericStep runs them).
pub fn genericOpcode(opcode: u8) -> bool {
  return opcode == op.OP_typeof || opcode == op.OP_in || opcode == op.OP_delete
    || opcode == op.OP_pow || opcode == op.OP_to_object || opcode == op.OP_to_propkey || opcode == op.OP_object
    || opcode == op.OP_array_from || opcode == op.OP_regexp || opcode == op.OP_define_field || opcode == op.OP_set_name
    || opcode == op.OP_set_proto || opcode == op.OP_define_method || opcode == op.OP_define_method_computed
    || opcode == op.OP_get_super || opcode == op.OP_get_private_field || opcode == op.OP_put_private_field
    || opcode == op.OP_define_private_field || opcode == op.OP_private_in || opcode == op.OP_add_brand
    || opcode == op.OP_push_bigint_i32 || opcode == op.OP_private_symbol
    || frameGeneric(opcode) || iterationOpcode(opcode)
}

/// Stream P's part of generic exits (group 3): instructions that read the frame (its
/// function, receiver, new.target, arguments or scope), run on js_vm.compiledOp's copy of the
/// running frame. Those that would read or change the frame's own slots are refused in
/// Translator.generic. They stay out of OSR code (osrExit), whose frame is only partly live.
pub fn frameGeneric(opcode: u8) -> bool {
  return opcode == op.OP_special_object || opcode == op.OP_rest || opcode == op.OP_fclosure || opcode == op.OP_fclosure8
    || opcode == op.OP_get_scope0_el || opcode == op.OP_check_ctor || opcode == op.OP_check_ctor_return
    || opcode == op.OP_init_ctor || opcode == op.OP_apply || opcode == op.OP_define_array_el || opcode == op.OP_append
}
/// Stream Q's for-in and for-of instructions, generic exits outside OSR code (OSR code steps a
/// stand-in record itself, and leaves at the others).
pub fn iterationOpcode(opcode: u8) -> bool {
  return opcode == op.OP_for_in_start || opcode == op.OP_for_in_next || opcode == op.OP_for_of_start
    || opcode == op.OP_for_of_next || opcode == op.OP_iterator_close
}
/// Refuses the frame instructions (frameGeneric) compiled code cannot run on a copy of the
/// frame: a mapped arguments object aliases the frame's argument cells; a lazy one is a
/// stand-in in a local that the interpreter fills; a closure may take cells of the frame's
/// slots, or promote the function's own scope, which CompiledFrame.scope holds unpromoted
/// (and which compiled calls do not create: they run on the closure's scope).
/// Arithmetic that reads its operands (the stack's top, locals, arguments) and pushes one
/// result, with no other effect on the frame.
/// The `+` of stackArithmetic, which a site that left even as doubles asks the engine's
/// concatenation for (Translator.concatenation).
fn addition(opcode: u8) -> bool {
  return opcode == op.OP_add || opcode == op.OP_add_loc_loc8 || opcode == op.OP_add_top_loc8 || opcode == op.OP_add_top_arg8
}
fn stackArithmetic(opcode: u8) -> bool {
  return opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_mul
    || (opcode >= op.OP_add_loc_loc8 && opcode <= op.OP_mul_top_loc8) || (opcode >= op.OP_add_top_arg8 && opcode <= op.OP_mul_top_arg8)
}
effect fn frameAllowed(input: &FunctionInput, pc: usize) -> () ! Refusal {
  let opcode = byteAt(input, pc)
  let at = usize.toU32(pc)
  if opcode == op.OP_special_object {
    let kind = byteAt(input, pc + 1)
    if kind == 1 { fail refuse(at, opcode, b"a mapped arguments object") }
    if kind == 7 { fail refuse(at, opcode, b"a lazy arguments object") }
    if kind > 5 { fail refuse(at, opcode, b"import.meta or a source phase import") }
  }
  if opcode == op.OP_fclosure || opcode == op.OP_fclosure8 {
    if input.scopeSlots != 0 && !input.leavesBodies { fail refuse(at, opcode, b"a closure in a function with its own scope") }
    let mut index: usize = 0
    if opcode == op.OP_fclosure { index = u32.toUsize(i32.wrappingToU32(i32At(input, pc + 1))) } else { index = u8.toUsize(byteAt(input, pc + 1)) }
    if index >= input.closures.length() || input.closures.get(index) != CLOSURE_SAFE { fail refuse(at, opcode, b"a closure that captures the frame's slots") }
  }
}
/// The values a generic instruction at pc leaves on the engine's stack when more than one
/// (calls.RESULTS_SHIFT; js_vm.compiledOp checks it), or 0 for one at most.
pub fn genericResults(input: &FunctionInput, pc: usize) -> usize {
  let opcode = byteAt(input, pc)
  if opcode == op.OP_for_of_start || opcode == op.OP_for_in_next { return 3 }
  if opcode == op.OP_for_of_next { return 5 + u8.toUsize(byteAt(input, pc + 1)) }
  if opcode == op.OP_define_array_el || opcode == op.OP_append || opcode == op.OP_check_ctor_return || opcode == op.OP_get_array_el2 { return 2 }
  if opcode == op.OP_get_array_el3 { return 3 }
  return 0
}
/// The operand cells of such an instruction it leaves as they were (calls.KEPT_SHIFT, bit c:
/// cell c): the code keeps its own values for them. for_of_next writes only its record's
/// array and position (js_vm_control.forOfNext), not the marker or the values above it.
pub fn genericKeptCells(input: &FunctionInput, pc: usize) -> i32 {
  let opcode = byteAt(input, pc)
  if opcode == op.OP_define_array_el || opcode == op.OP_get_array_el3 { return 3 }
  if opcode == op.OP_append || opcode == op.OP_check_ctor_return || opcode == op.OP_get_array_el2 { return 1 }
  if opcode == op.OP_for_of_next { return i32.shiftLeft(i32.shiftLeft(1, u8.toI32(byteAt(input, pc + 1)) + 1) - 1, 2) }
  return 0
}


/// input.argumentCount when the code writes a parameter, else 0 (Translator.argSlots). 0 too
/// when an arguments object or direct eval could read the frame's cells, which compiled code
/// leaves stale; put_arg is then refused. (Frame references refuse the whole function.)
fn argumentSlots(input: &FunctionInput) -> u32 {
  let mut writes = false
  let mut pc: usize = 0
  while pc < input.code.length() {
    let o = byteAt(input, pc)
    if o == op.OP_put_arg || o == op.OP_set_arg || o == op.OP_step_arg8 { writes = true }
    if o == op.OP_special_object || o == op.OP_eval || o == op.OP_apply_eval { return 0 }
    let size = sizeAt(input, pc)
    if size == 0 { return 0 }
    pc = pc + size
  }
  if writes { return input.argumentCount }
  return 0
}
/// Whether one of input's widened sites is an equality.
fn wideEquality(input: &FunctionInput) -> bool {
  let mut i: usize = 0
  while i < input.doubleSites.length() {
    let pc = u32.toUsize(input.doubleSites.get(i))
    if pc < input.code.length() {
      let o = byteAt(input, pc)
      if equality(o) || o == op.OP_strict_eq_imm8 || o == op.OP_strict_neq_imm8 { return true }
    }
    i = i + 1
  }
  return false
}
fn equality(opcode: u8) -> bool {
  return opcode == op.OP_eq || opcode == op.OP_neq || opcode == op.OP_strict_eq || opcode == op.OP_strict_neq
}

/// Workstream H's calls: `call0`..`call3`, `call`, `call_method` and `call_constructor`.
pub fn callOpcode(opcode: u8) -> bool {
  return (opcode >= op.OP_call0 && opcode <= op.OP_call3) || opcode == op.OP_call || opcode == op.OP_call_method || opcode == op.OP_call_constructor
}

/// Workstream J's opcodes (`this`, properties, globals, scopes, elements) translated below.
pub fn objectOpcode(opcode: u8) -> bool {
  return opcode == op.OP_push_this || opcode == op.OP_get_field || opcode == op.OP_get_field2
    || opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8
    || opcode == op.OP_put_field || opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8
    || opcode == op.OP_push_atom_value || opcode == op.OP_push_empty_string
    || opcode == op.OP_get_var || opcode == op.OP_get_var_undef || opcode == op.OP_put_var
    || opcode == op.OP_get_scope0 || opcode == op.OP_get_scope0_check || opcode == op.OP_put_scope0
    || opcode == op.OP_put_scope0_check || opcode == op.OP_set_scope0
    || opcode == op.OP_get_var_ref || opcode == op.OP_get_var_ref_check || opcode == op.OP_put_var_ref
    || opcode == op.OP_put_var_ref_check || opcode == op.OP_set_var_ref
    || opcode == op.OP_get_array_el || opcode == op.OP_get_array_el2 || opcode == op.OP_get_array_el3
    || opcode == op.OP_put_array_el || opcode == op.OP_get_length
    || opcode == op.OP_get_loc_length8 || opcode == op.OP_get_arg_length8 || opcode == op.OP_get_loc_el8
    || opcode == op.OP_get_arg_el8 || opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8
}
/// GetField's `k`: which engine read serves the site.
pub const FIELD_KEYED: i32 = 0
pub const FIELD_CACHED: i32 = 1

/// The opcodes the number and operator part translates (docs/jit/doubles.md).
pub fn numberOpcode(opcode: u8) -> bool {
  return opcode == op.OP_div || opcode == op.OP_mod || opcode == op.OP_shl || opcode == op.OP_sar || opcode == op.OP_shr
    || opcode == op.OP_and || opcode == op.OP_xor || opcode == op.OP_or || opcode == op.OP_shl_imm || opcode == op.OP_sar_imm
    || opcode == op.OP_and_imm || opcode == op.OP_or_imm || opcode == op.OP_neg || opcode == op.OP_plus || opcode == op.OP_not
    || opcode == op.OP_lnot || opcode == op.OP_post_inc || opcode == op.OP_post_dec || opcode == op.OP_push_const
    || opcode == op.OP_push_const8 || opcode == op.OP_strict_eq_imm8 || opcode == op.OP_strict_neq_imm8
}
/// `if_true_keep8`/`if_false_keep8`: a branch whose taken edge keeps the tested value.
fn keepBranch(opcode: u8) -> bool { return opcode == op.OP_if_true_keep8 || opcode == op.OP_if_false_keep8 || opcode == op.OP_if_not_nullish_keep8 }
/// The undefined/null tests and typeof tests (no exit but typeof's proxy), and the branches
/// on them.
fn testOpcode(opcode: u8) -> bool {
  return opcode == op.OP_is_undefined || opcode == op.OP_is_null || opcode == op.OP_is_undefined_or_null
    || opcode == op.OP_typeof_is_undefined || opcode == op.OP_typeof_is_function || opcode == op.OP_typeof_is
    || nullMask(opcode) != 0
}
/// The stack shuffles (js_vm_values.step): the window's size in operands, then for each
/// result operand, bottom to top, the window position (bottom 0) it copies, all as ASCII
/// digits. A position used twice is retained once more; one never used is released. Empty
/// for any other opcode. dup3, perm5, swap2, rot4l and rot5l are absent: final code writes
/// them behind OP_extended (js_opcode_data.movedToExtended), and their bytes mean other opcodes.
pub fn shuffleOf(opcode: u8) -> &'static [u8] {
  if opcode == op.OP_nip1 { return b"312" }
  if opcode == op.OP_dup1 { return b"2001" }
  if opcode == op.OP_dup2 { return b"20101" }
  if opcode == op.OP_insert2 { return b"2101" }
  if opcode == op.OP_insert3 { return b"32012" }
  if opcode == op.OP_insert4 { return b"430123" }
  if opcode == op.OP_perm3 { return b"3102" }
  if opcode == op.OP_perm4 { return b"42013" }
  if opcode == op.OP_rot3l { return b"3120" }
  if opcode == op.OP_rot3r { return b"3201" }
  return b""
}
/// tag.is's mask (1 undefined, 2 null) for a test or a branch on one; 0 for anything else.
fn nullMask(opcode: u8) -> i32 {
  if opcode == op.OP_is_undefined { return 1 }
  if opcode == op.OP_is_null || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8 { return 2 }
  if opcode == op.OP_is_undefined_or_null || opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8
    || opcode == op.OP_if_not_nullish_keep8 { return 3 }
  return 0
}
/// typeof_is's operand as the type name's atom (js_bytecode.typeofIsAtom).
fn typeofIsAtom(index: u8) -> u32 {
  if index == 0 { return atoms.JS_ATOM_string }
  if index == 1 { return atoms.JS_ATOM_number }
  if index == 2 { return atoms.JS_ATOM_object }
  if index == 3 { return atoms.JS_ATOM_boolean }
  if index == 4 { return atoms.JS_ATOM_symbol }
  if index == 5 { return atoms.JS_ATOM_bigint }
  if index == 6 { return atoms.JS_ATOM_undefined }
  if index == 7 { return atoms.JS_ATOM_function }
  return atoms.JS_ATOM_unknown
}
/// The branches on a nullish or null test: a padding byte, then the displacement.
fn nullBranch(opcode: u8) -> bool {
  return opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8
}

fn isBranch(opcode: u8) -> bool {
  return opcode == op.OP_if_false || opcode == op.OP_if_true || opcode == op.OP_if_false8 || opcode == op.OP_if_true8
    || keepBranch(opcode) || nullBranch(opcode)
}
/// The double operation of an int32 one (`add`, `sub`, `mul`).
fn doubleOf(operation: Op) -> Op {
  if operation == Op.Sub { return Op.SubF64 }
  if operation == Op.Mul { return Op.MulF64 }
  return Op.AddF64
}
fn isGoto(opcode: u8) -> bool { return opcode == op.OP_goto || opcode == op.OP_goto8 || opcode == op.OP_goto16 }
fn isReturn(opcode: u8) -> bool { return opcode == op.OP_return || opcode == op.OP_return_undef }

fn byteAt(input: &FunctionInput, at: usize) -> u8 { return input.code.get(at) }
fn u16At(input: &FunctionInput, at: usize) -> u16 { return u8.toU16(byteAt(input, at)) | u16.shiftLeft(u8.toU16(byteAt(input, at + 1)), 8) }
/// The little-endian u32 operand at `at` (an atom).
fn u32At4(input: &FunctionInput, at: usize) -> u32 {
  return u16.toU32(u16At(input, at)) | u32.shiftLeft(u16.toU32(u16At(input, at + 2)), 16)
}
fn i32At(input: &FunctionInput, at: usize) -> i32 {
  let bits = u8.toU32(byteAt(input, at)) | u32.shiftLeft(u8.toU32(byteAt(input, at + 1)), 8)
    | u32.shiftLeft(u8.toU32(byteAt(input, at + 2)), 16) | u32.shiftLeft(u8.toU32(byteAt(input, at + 3)), 24)
  return u32.wrappingToI32(bits)
}
fn i8At(input: &FunctionInput, at: usize) -> i32 { return i8.toI32(u8.wrappingToI8(byteAt(input, at))) }
fn i16At(input: &FunctionInput, at: usize) -> i32 { return i16.toI32(u16.wrappingToI16(u16At(input, at))) }

/// The size of the instruction at `pc`, from the engine's table.
fn sizeAt(input: &FunctionInput, pc: usize) -> usize { return u8.toUsize(op.opcodeInfo(byteAt(input, pc), true).size) }
/// OP_special_object's kind for a lazy arguments object (js_bytecode.SPECIAL_LAZY_ARGUMENTS).
const SPECIAL_LAZY_ARGUMENTS: u8 = 7
/// The one local the code copies its lazy arguments object in `slot` to, or usize.MAX
/// (js_bytecode.lazyArgumentsAlias checked there is at most one, before any branch).
fn lazyArgumentsCopy(input: &FunctionInput, slot: usize) -> usize {
  let length = input.code.length()
  let mut pc: usize = 0
  while pc < length {
    let next = pc + sizeAt(input, pc)
    if next <= pc || next >= length { return usize.MAX }
    if localRead(input, pc) == slot {
      let target = localStore(input, next)
      if target != usize.MAX && target != slot { return target }
    }
    pc = next
  }
  return usize.MAX
}
/// The local a get_loc or set_loc at `pc` reads (set_loc leaves the value), or usize.MAX.
fn localRead(input: &FunctionInput, pc: usize) -> usize {
  let opcode = byteAt(input, pc)
  if opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3 { return u8.toUsize(opcode - op.OP_get_loc0) }
  if opcode == op.OP_get_loc8 || opcode == op.OP_set_loc8 { return u8.toUsize(byteAt(input, pc + 1)) }
  if opcode == op.OP_get_loc || opcode == op.OP_set_loc { return u16.toUsize(u16At(input, pc + 1)) }
  return usize.MAX
}
/// The local a put_loc or set_loc at `pc` stores to, or usize.MAX.
fn localStore(input: &FunctionInput, pc: usize) -> usize {
  let opcode = byteAt(input, pc)
  if opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3 { return u8.toUsize(opcode - op.OP_put_loc0) }
  if opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8 { return u8.toUsize(byteAt(input, pc + 1)) }
  if opcode == op.OP_put_loc || opcode == op.OP_set_loc { return u16.toUsize(u16At(input, pc + 1)) }
  return usize.MAX
}
/// The local the code's lazy arguments object (special_object SPECIAL_LAZY_ARGUMENTS, the
/// store right after it) lives in, or usize.MAX (js_vm_factories.lazyArgumentsSlot).
fn lazyArgumentsLocal(input: &FunctionInput) -> usize {
  let length = input.code.length()
  let mut pc: usize = 0
  while pc + 1 < length {
    let opcode = byteAt(input, pc)
    let next = pc + sizeAt(input, pc)
    if opcode == op.OP_special_object && byteAt(input, pc + 1) == SPECIAL_LAZY_ARGUMENTS {
      if next + 3 > length { return usize.MAX }
      let store = byteAt(input, next)
      if store >= op.OP_put_loc0 && store <= op.OP_put_loc3 { return u8.toUsize(store - op.OP_put_loc0) }
      if store == op.OP_put_loc8 || store == op.OP_set_loc8 { return u8.toUsize(byteAt(input, next + 1)) }
      if store == op.OP_put_loc || store == op.OP_set_loc { return u16.toUsize(u16At(input, next + 1)) }
      return usize.MAX
    }
    if next <= pc { return usize.MAX }
    pc = next
  }
  return usize.MAX
}

/// The target of the branch or goto at `pc`: displacements count from the first operand byte
/// (`Machine.jump`).
fn targetOf(input: &FunctionInput, pc: usize) -> i64 {
  let opcode = byteAt(input, pc)
  let mut displacement: i32 = 0
  if opcode == op.OP_if_false || opcode == op.OP_if_true || opcode == op.OP_goto { displacement = i32At(input, pc + 1) }
  else if opcode == op.OP_goto16 { displacement = i16At(input, pc + 1) }
  else if opcode == op.OP_if_not_nullish_keep8 {
    // dup, if_not_nullish8, drop: its displacement is the fourth byte and counts from itself.
    return usize.toI64(pc + 3) + i32.toI64(i8At(input, pc + 3))
  }
  else if keepBranch(opcode) || nullBranch(opcode) {
    // dup, if_*8, drop in one: the displacement counts from its own byte, the second.
    return usize.toI64(pc + 2) + i32.toI64(i8At(input, pc + 2))
  }
  else { displacement = i8At(input, pc + 1) }
  return usize.toI64(pc + 1) + i32.toI64(displacement)
}

/// Pass A: every reachable instruction start, every block leader and the operand stack depth
/// at each leader, from the engine's pops and pushes. Fails on code outside the subset.
///
/// Try regions (stream P): `catch` pushes a marker the interpreter's unwinder looks for. The
/// handler is not followed (only the unwinder reaches it, in the interpreter). `catchTop` is
/// the pc of the innermost `catch` whose marker is on the stack before each instruction (-1:
/// none); `catchLevel` and `catchParent`, indexed by a `catch`'s pc, are the stack slot of its
/// marker and the enclosing `catch`. `gosub` (finally) jumps to its target with its return
/// offset pushed, and `ret` returns to the instruction after one of `returns`.
struct Shape { leader: List<bool>, depth: List<i32>, start: List<bool>, catchTop: List<i32>, catchLevel: List<i32>,
  catchParent: List<i32>, returns: List<u32> }

effect fn shape(input: &FunctionInput) -> Shape ! Refusal | OutOfMemoryError ? &mut Allocator {
  let none = List<u32>.make()
  return run shapeAt(input, 0, false, true, 0, u32.MAX, &none)
}

/// osrMarkers' slot kinds besides a catch's pc: a value the frame passes in (an OSR input),
/// a for-of record's marker (CatchOffset 0), and a layout this cannot tell (no OSR entry).
pub const SLOT_VALUE: u32 = 4294967295
pub const SLOT_FOR_OF: u32 = 4294967294
pub const SLOT_UNKNOWN: u32 = 4294967293

/// The operand stack under loop header pc, bottom first, from the constructs that enclose it:
/// a try body's catch marker (the catch's pc), and a for-of loop's record (its iterable or
/// iterator, its next method or index, its marker) with the element on top at its body's first
/// instruction. js_compiled_osr enters only a frame with exactly this many operands; another
/// construct that leaves operands (for-in) makes the count differ.
pub effect fn osrMarkers(input: &FunctionInput, header: u32) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u32>.make()
  let length = input.code.length()
  let at = u32.toUsize(header)
  let mut pc: usize = 0
  while pc < length && pc < at {
    let opcode = byteAt(input, pc)
    let size = sizeAt(input, pc)
    if size == 0 || pc + size > length { return move out }
    if opcode == op.OP_catch {
      let handler = usize.toI64(pc + 1) + i32.toI64(i32At(input, pc + 1))
      if handler > usize.toI64(at) { run out.append(usize.toU32(pc)) }
    }
    if opcode == op.OP_for_of_start {
      // for_of_start; goto next; body: ...; next: for_of_next 0; if_false body (the parser's
      // for-of): the record is live from the body to the branch.
      let jump = pc + size
      let mut open = false
      let mut known = false
      if jump < length && isGoto(byteAt(input, jump)) {
        let next = targetOf(input, jump)
        if next > usize.toI64(jump) && next + 2 < usize.toI64(length) {
          let step = i64.toUsize(next)
          let branch = step + 2
          if byteAt(input, step) == op.OP_for_of_next && byteAt(input, step + 1) == 0 && isBranch(byteAt(input, branch)) {
            let body = targetOf(input, branch)
            let bodyStart = jump + sizeAt(input, jump)
            if body == usize.toI64(bodyStart) {
              known = true
              open = bodyStart <= at && at <= branch
              if open {
                run out.append(SLOT_VALUE) run out.append(SLOT_VALUE) run out.append(SLOT_FOR_OF)
                if at == bodyStart { run out.append(SLOT_VALUE) }
              }
            }
          }
        }
      }
      if !known { run out.append(SLOT_UNKNOWN) }
    }
    pc = pc + size
  }
  return move out
}

/// Whether input passes the translator's first walk: every reachable opcode is in the subset
/// (and none is a call unless allowCalls). A cheap test before work that only pays for a
/// function that can be compiled, such as recording its feedback.
pub effect fn admits(input: &FunctionInput, allowCalls: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let walked = run Effect.result(shape(input))
  let found = match move walked {
    Result<Shape, Refusal | OutOfMemoryError>.Success { value } => move value
    Result<Shape, Refusal | OutOfMemoryError>.Failure { error } => {
      match move error {
        Refusal { .. } => { return false }
        OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
      }
    }
  }
  if allowCalls { return true }
  let mut pc: usize = 0
  while pc < found.start.length() {
    if found.start.get(pc) && callOpcode(byteAt(input, pc)) { return false }
    pc = pc + 1
  }
  return true
}

/// shape walking from the instruction at `begin` (stack empty there). With `sideExits`, an
/// opcode outside the subset, or an instruction outside [low, high], ends its block (the
/// translator exits there) instead of refusing.
effect fn shapeAt(input: &FunctionInput, begin: usize, sideExits: bool, calls: bool, low: u32, high: u32, markers: &List<u32>) -> Shape ! Refusal | OutOfMemoryError ? &mut Allocator {
  let length = input.code.length()
  let mut leader = List<bool>.make() run leader.appendRepeated(false, length + 1)
  let mut start = List<bool>.make() run start.appendRepeated(false, length + 1)
  let mut depth = List<i32>.make() run depth.appendRepeated(-1, length + 1)
  let mut catchTop = List<i32>.make() run catchTop.appendRepeated(-1, length + 1)
  let mut catchLevel = List<i32>.make() run catchLevel.appendRepeated(-1, length + 1)
  let mut catchParent = List<i32>.make() run catchParent.appendRepeated(-1, length + 1)
  let mut returns = List<u32>.make()
  let mut work = List<usize>.make()
  let mut workDepth = List<i32>.make()
  let mut workCatch = List<i32>.make()
  if begin >= length { fail refuse(usize.toU32(begin), 0, b"control falls off the end of the code") }
  // The markers under an OSR header, each a try region with the one before as its parent.
  let mut c0: i32 = -1
  let mut m: usize = 0
  while m < markers.length() {
    let kind = markers.get(m)
    if kind < SLOT_UNKNOWN {
      let at = u32.toUsize(kind)
      catchLevel.set(at, usize.toI32(m)) catchParent.set(at, c0)
      c0 = u32.wrappingToI32(kind)
    }
    m = m + 1
  }
  let d0 = usize.toI32(markers.length())
  leader.set(begin, true) depth.set(begin, d0)
  run work.append(begin) run workDepth.append(d0) run workCatch.append(c0)
  while work.length() > 0 {
    let mut pc = work.pop().unwrapOr(0)
    let mut d = workDepth.pop().unwrapOr(0)
    let mut c = workCatch.pop().unwrapOr(-1)
    let mut going = true
    while going {
      if pc >= length { fail refuse(usize.toU32(pc), 0, b"control falls off the end of the code") }
      if start.get(pc) { going = false }
      else {
        start.set(pc, true)
        catchTop.set(pc, c)
        let opcode = byteAt(input, pc)
        if !supported(opcode) && !sideExits { fail refuse(usize.toU32(pc), opcode, b"opcode outside the subset") }
        // A side exit: the state before it is the block's, nothing after it is reached.
        if sideExits && (osrExit(opcode, calls) || outside(pc, low, high)) { going = false continue }
        let info = op.opcodeInfo(opcode, true)
        let size = u8.toUsize(info.size)
        if size == 0 || pc + size > length { fail refuse(usize.toU32(pc), opcode, b"truncated instruction") }
        let before = d
        let mut popped = u8.toI32(info.pops)
        // A call's table entry counts only its fixed operands; the argument count is in the code.
        if opcode == op.OP_call || opcode == op.OP_call_method || opcode == op.OP_call_constructor { popped = popped + u16.toI32(u16At(input, pc + 1)) }
        if opcode >= op.OP_call0 && opcode <= op.OP_call3 { popped = popped + u8.toI32(opcode - op.OP_call0) }
        if opcode == op.OP_array_from { popped = popped + u16.toI32(u16At(input, pc + 1)) }
        d = d - popped + u8.toI32(info.pushes)
        if opcode == op.OP_nip_catch {
          // The result replaces the innermost marker; everything above it goes.
          if c < 0 { fail refuse(usize.toU32(pc), opcode, b"nip_catch outside a try region") }
          d = catchLevel.get(i32.toUsize(c)) + 1
          c = catchParent.get(i32.toUsize(c))
        } else if opcode == op.OP_gosub { d = before + 1 }
        if d < 0 { fail refuse(usize.toU32(pc), opcode, b"operand stack underflow") }
        if opcode == op.OP_catch {
          catchLevel.set(pc, before) catchParent.set(pc, c)
          c = usize.toI32(pc)
        } else if c >= 0 && opcode != op.OP_nip_catch && before - popped <= catchLevel.get(i32.toUsize(c)) {
          // Only drop and nip remove a marker; anything else that reads one is not translated.
          let level = catchLevel.get(i32.toUsize(c))
          if opcode == op.OP_drop && d == level { c = catchParent.get(i32.toUsize(c)) }
          else if opcode == op.OP_nip && before - 2 == level { c = catchParent.get(i32.toUsize(c)) }
          else if !isReturn(opcode) && !isThrow(opcode) && !(opcode == op.OP_nip && before - 2 > level) {
            fail refuse(usize.toU32(pc), opcode, b"an instruction that reads a catch offset")
          }
        }
        if isReturn(opcode) || isThrow(opcode) || opcode == op.OP_ret { going = false }
        else if opcode == op.OP_gosub {
          // The finally block runs with the return offset pushed; ret comes back after the gosub.
          let target = usize.toI64(pc + 1) + i32.toI64(i32At(input, pc + 1))
          if target < 0 || target >= usize.toI64(length) || pc + 5 >= length { fail refuse(usize.toU32(pc), opcode, b"jump outside the code") }
          run mark(&mut leader, &mut depth, &mut catchTop, &mut work, &mut workDepth, &mut workCatch, i64.toUsize(target), d, c, pc, opcode)
          run mark(&mut leader, &mut depth, &mut catchTop, &mut work, &mut workDepth, &mut workCatch, pc + 5, before, c, pc, opcode)
          run returns.append(usize.toU32(pc + 5))
          going = false
        }
        else if isBranch(opcode) || isGoto(opcode) {
          let target = targetOf(input, pc)
          if target < 0 || target >= usize.toI64(length) { fail refuse(usize.toU32(pc), opcode, b"jump outside the code") }
          let t = i64.toUsize(target)
          // The taken edge of a keep branch still has the tested value.
          let mut taken = d
          if keepBranch(opcode) { taken = d + 1 }
          run mark(&mut leader, &mut depth, &mut catchTop, &mut work, &mut workDepth, &mut workCatch, t, taken, c, pc, opcode)
          if isBranch(opcode) { run mark(&mut leader, &mut depth, &mut catchTop, &mut work, &mut workDepth, &mut workCatch, pc + size, d, c, pc, opcode) }
          going = false
        } else {
          pc = pc + size
          if leader.get(pc) {
            run mark(&mut leader, &mut depth, &mut catchTop, &mut work, &mut workDepth, &mut workCatch, pc, d, c, pc, opcode)
            going = false
          }
        }
      }
    }
  }
  return Shape { leader: move leader, depth: move depth, start: move start, catchTop: move catchTop, catchLevel: move catchLevel,
    catchParent: move catchParent, returns: move returns }
}

effect fn mark(leader: &mut List<bool>, depth: &mut List<i32>, catchTop: &mut List<i32>, work: &mut List<usize>, workDepth: &mut List<i32>,
  workCatch: &mut List<i32>, pc: usize, d: i32, c: i32, from: usize, opcode: u8) -> () ! Refusal | OutOfMemoryError ? &mut Allocator {
  leader.set(pc, true)
  let known = depth.get(pc)
  if known >= 0 {
    if known != d {
      if opcode == op.OP_gosub { fail refuse(usize.toU32(from), opcode, b"a finally block entered at different stack depths") }
      fail refuse(usize.toU32(from), opcode, b"operand stack depths disagree at a join")
    }
    if catchTop.get(pc) != c { fail refuse(usize.toU32(from), opcode, b"try regions disagree at a join") }
    return ()
  }
  depth.set(pc, d)
  catchTop.set(pc, c)
  run work.append(pc) run workDepth.append(d) run workCatch.append(c)
}

/// The interpreter state the translator tracks: one SSA value per local and operand.
struct State { locals: List<u32>, stack: List<u32> }

effect fn copyList(from: &List<u32>) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u32>.make()
  run out.appendSlice(from.asSlice())
  return move out
}

struct Translator {
  f: Function,
  /// SSA block of each leader pc, or NONE.
  blockAt: List<u32>,
  /// For a block of the function's own code: the pc whose state its parameters are (its
  /// leader's, a latch's loop target), or NONE (edgeTo).
  leaderPc: List<u32>,
  /// The block being filled.
  current: u32,
  locals: List<u32>,
  stack: List<u32>,
  /// FunctionInput.doubleSites, copied.
  doubleSites: List<u32>,
  /// Whether a widened store may leave through a call exit (not in OSR code, which makes no calls).
  exits: bool,
  /// Shape.catchTop, catchLevel, depth and returns, copied (try regions and finally blocks).
  catchTop: List<i32>,
  catchLevel: List<i32>,
  depthAt: List<i32>,
  returns: List<u32>,
  /// Which lexical locals may be uninitialized at each block leader (`Tdz`), and which block
  /// parameters (by value) are proven initialized.
  tdz: Tdz,
  initialized: List<bool>,
  /// The upper half of a store's inline key for an add (FieldLayout.addKey).
  addKey: u32,
  /// FunctionInput.records of the function being compiled.
  records: List<RecordSlot>,
  /// The locals still to be read at each instruction of the code being translated, the
  /// function's own or an inlined body's (Liveness).
  liveness: Liveness,
  /// The entry block's undefined, which an exit names for a dead local (deadLocal); NONE in
  /// a translation that tracks no liveness.
  undef: u32,
  /// The bytes of code of the bodies inlined so far outside every loop (MAX_INLINED_BYTES),
  /// and whether the body being translated is at a call in a loop, or inside such a body.
  inlinedBytes: usize,
  turning: bool,
  // ---- inlining (docs/jit/inlining.md): the state of the inlined body being translated.
  /// How many inlined bodies deep the translator is; 0 in the function's own code.
  depth: u32,
  /// The outermost inlined call: its pc, how many operands the function had before it and
  /// the first instruction of the attempt.
  rootPc: u32,
  rootDepth: usize,
  rootInst: usize,
  /// The locals and operands of every frame around the current body, outermost first: the
  /// function's own before the outermost inlined call (the state every exit inside leaves
  /// to), then each inlined body's around the current one. A block of a body takes them as
  /// its first parameters, so the entries are the values of the block being filled.
  held: List<u32>,
  /// The current body's arguments and receiver (the caller's operands), as places in held
  /// (the receiver's is usize.MAX in a plain call), and its parameter count.
  argsBase: usize,
  argCount: usize,
  receiverAt: usize,
  formals: u32,
  /// The inlined bodies around the code being translated, the current one last: each its
  /// target number and its closure's place in held.
  frames: List<usize>,
  /// The calls that began the bodies around the code being translated, the current body's
  /// last (depth of them).
  calls: List<InlineCall>,
  /// FunctionInput.leavesBodies.
  leaves: bool,
  /// FunctionInput.arrayPush and arrayPop of the function being compiled.
  arrayPush: u32,
  arrayPop: u32,
  /// How many of the inlined bodies being translated, the current one and those around it,
  /// have a loop.
  bodyLoops: u32,
  /// The code being translated runs under a scope on the frame's own chain: the function's
  /// own code, or the body of a known local function (ssa.TARGET_KNOWN_FN) inlined into
  /// such code, whose scope is the one of its level there (js_scopes.atLevel). Only such a
  /// body reads its scope: the backend finds it from the frame's.
  ownChain: bool,
  /// CallTarget.owned of the body being translated; 0 in the function's own code.
  ownedCells: u64,
  /// A guard came after an effect: the attempt fails.
  broken: bool,
  /// A body of the attempt wrote one of its parameters (the caller's operand in held): every
  /// exit after leaves with the bodies' frames, whose call operands carry the new value;
  /// an exit that ran the call again would run it on that value.
  paramWrites: bool,
  /// Why inlineTarget found none.
  missed: &'static [u8],
  /// On-stack replacement: argument n's number, guarded once at entry, or NONE (or empty).
  /// The pc of a set_name that the closure created just before it already ran: js_vm's
  /// fclosure folds a following set_name into the creation (factories.allocate).
  namedClosure: usize,
  /// The local a lazy arguments object lives in (js_bytecode.lazyArgumentsSite) and its one
  /// copy, or usize.MAX: their reads push the stand-in (Uninitialized) the interpreter keeps
  /// there, and its uses go to the engine (lazyUse, calls.LAZY_ARGUMENTS).
  lazySlot: usize,
  lazyAlias: usize,
  argNumbers: List<u32>,
  /// Whether an equality site of the function deoptimized: then every equality of a boxed
  /// operand goes through Equals (sites of one function tend to meet the same values).
  wideEquality: bool,
  /// Translating OSR code (translateOsrWith).
  osr: bool,
  /// How edgeTo lets go of a dead local's count (EDGE_ARM, EDGE_ALONE, EDGE_CARRY).
  edgeMode: u8,
  /// The blocks edgeTo put on the arms of the branch being made (EDGE_ARM), which `settle`
  /// ends: per block its number, the block it jumps to, the pc, the argument count and the
  /// arguments.
  mids: List<u32>,

  /// The parameters as mutable slots, in a function that writes one (put_arg, set_arg):
  /// argumentCount, and `locals` holds them after the real locals; else 0 and parameters are
  /// read from their argument cells.
  argSlots: u32,
}

/// Lexical locals that may be uninitialized (still in their TDZ) on entry to each leader, from a
/// forward dataflow over the edges the translator follows. A try region's handler is not one of
/// them, so a local the handler path leaves in any state is still known on the translated paths.
/// `tracked` is false when the code has no `set_loc_uninitialized`: nothing is ever uninitialized.
struct Tdz { tracked: bool, locals: usize, slot: List<u32>, maybe: List<bool> }

/// Which locals the code may still read, at each instruction start (docs/jit/optimizer.md,
/// "Dead stores"). `live` holds a bit per local at each pc: set when some path from the
/// instruction there reads the local before it writes it. A store to a local that is not
/// live after it stores undefined. Untracked (every local live everywhere) for more than 64
/// locals and for code with try regions, finally blocks or references to locals. `kill` holds
/// at each instruction start the locals the instruction writes without reading.
struct Liveness { tracked: bool, all: u64, live: List<u64>, kill: List<u64> }

/// Translator.edgeMode. The edge is an arm of a branch: a count that ends on it is released
/// in a block of the edge's own.
const EDGE_ARM: u8 = 0
/// The edge is its block's only way out: the release goes in front of the jump.
const EDGE_ALONE: u8 = 1
/// A latch's edge to its loop: a dead local keeps its count (Translator.destination).
const EDGE_CARRY: u8 = 2

/// The locals the instruction at pc reads (`gen`) and writes without reading (`kill`), as
/// bits under all. An opcode not known here reads every local.
fn localEffect(input: &FunctionInput, pc: usize, all: u64) -> LocalEffect {
  let opcode = byteAt(input, pc)
  let mut gen: u64 = 0
  let mut kill: u64 = 0
  if opcode == op.OP_get_loc || opcode == op.OP_get_loc_check || opcode == op.OP_get_loc_checkthis || opcode == op.OP_put_loc_check
    || opcode == op.OP_put_loc_check_init { gen = localBit(u16.toUsize(u16At(input, pc + 1))) }
  else if opcode == op.OP_put_loc || opcode == op.OP_set_loc || opcode == op.OP_set_loc_uninitialized { kill = localBit(u16.toUsize(u16At(input, pc + 1))) }
  else if opcode == op.OP_get_loc8 || opcode == op.OP_inc_loc || opcode == op.OP_dec_loc || opcode == op.OP_add_loc || opcode == op.OP_step_loc8
    || (opcode >= op.OP_add_top_loc8 && opcode <= op.OP_mul_top_loc8) || opcode == op.OP_get_loc_length8 || opcode == op.OP_get_loc_el_arg8 {
    gen = localBit(u8.toUsize(byteAt(input, pc + 1)))
  }
  else if opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8 { kill = localBit(u8.toUsize(byteAt(input, pc + 1))) }
  else if opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3 { gen = localBit(u8.toUsize(opcode - op.OP_get_loc0)) }
  else if opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3 { kill = localBit(u8.toUsize(opcode - op.OP_put_loc0)) }
  else if (opcode >= op.OP_add_loc_loc8 && opcode <= op.OP_mul_loc_loc8) || opcode == op.OP_get_loc_el8 {
    gen = localBit(u8.toUsize(byteAt(input, pc + 1))) | localBit(u8.toUsize(byteAt(input, pc + 2)))
  }
  else if opcode == op.OP_get_arg_el8 { gen = localBit(u8.toUsize(byteAt(input, pc + 2))) }
  else if opcode == op.OP_get_loc_field8 || opcode == op.OP_put_loc_field_arg8 { gen = localBit(u8.toUsize(byteAt(input, pc + 13))) }
  else if opcode == op.OP_put_loc_field_loc8 { gen = localBit(u8.toUsize(byteAt(input, pc + 13))) | localBit(u8.toUsize(byteAt(input, pc + 14))) }
  else if !supported(opcode) || localOpcode(opcode) { gen = all }
  // A local past the tracked ones is an argument slot (or out of range, which the
  // translator refuses).
  return LocalEffect { gen: gen & all, kill: kill & all }
}
struct LocalEffect { gen: u64, kill: u64 }
impl Copy for LocalEffect {}
fn localBit(index: usize) -> u64 { if index >= 64 { return 0 } return u64.shiftLeft(1, usize.toU64(index)) }
/// The opcodes besides those localEffect decodes that name a local: they read all of them.
fn localOpcode(opcode: u8) -> bool { return opcode == op.OP_close_loc || opcode == op.OP_make_loc_ref }

effect fn livenessOf(input: &FunctionInput) -> Liveness ! OutOfMemoryError ? &mut Allocator {
  let length = input.code.length()
  let locals = u32.toUsize(input.localCount)
  let mut out = Liveness { tracked: false, all: 0, live: List<u64>.make(), kill: List<u64>.make() }
  if locals == 0 || locals > 64 { return move out }
  let mut all: u64 = u64.MAX
  if locals < 64 { all = u64.shiftLeft(1, usize.toU64(locals)) - 1 }
  // Instruction starts, in order; code that the walk cannot decode, or whose control flow
  // this does not follow, keeps every local live.
  let mut starts = List<u32>.make()
  let mut pc: usize = 0
  while pc < length {
    let opcode = byteAt(input, pc)
    let size = sizeAt(input, pc)
    if size == 0 || pc + size > length { return move out }
    if opcode == op.OP_catch || opcode == op.OP_gosub || opcode == op.OP_ret || localOpcode(opcode) { return move out }
    run starts.append(usize.toU32(pc))
    pc = pc + size
  }
  // An offset that starts no instruction keeps every local live: nothing asks about one.
  run out.live.appendRepeated(all, length + 1)
  run out.kill.appendRepeated(0, length + 1)
  let mut s: usize = 0
  while s < starts.length() { let at = u32.toUsize(starts.get(s)) out.live.set(at, 0) out.kill.set(at, localEffect(input, at, all).kill) s = s + 1 }
  let mut changed = true
  while changed {
    changed = false
    let mut n = starts.length()
    while n > 0 {
      n = n - 1
      let at = u32.toUsize(starts.get(n))
      let opcode = byteAt(input, at)
      let next = at + sizeAt(input, at)
      let mut after: u64 = 0
      if isReturn(opcode) || isThrow(opcode) { after = 0 }
      else if isBranch(opcode) || isGoto(opcode) {
        let target = targetOf(input, at)
        if target < 0 || target >= usize.toI64(length) { after = all }
        else { after = out.live.get(i64.toUsize(target)) }
        if isBranch(opcode) { after = after | out.live.get(next) }
      } else if next >= length { after = all }
      else { after = out.live.get(next) }
      let touched = localEffect(input, at, all)
      let before = touched.gen | (after & u64.bitNot(touched.kill))
      if before != out.live.get(at) { out.live.set(at, before) changed = true }
    }
  }
  out.tracked = true
  out.all = all
  return move out
}

/// Whether baseline code noted a field store of `callee` (a setter, or a store that keeps
/// turning between adding its property and finding it: jit_runtime.calleeDoubleSites).
fn storeNoted(callee: &FunctionInput) -> bool {
  let mut i: usize = 0
  while i < callee.doubleSites.length() {
    let pc = u32.toUsize(callee.doubleSites.get(i))
    if pc < callee.code.length() {
      let o = byteAt(callee, pc)
      if o == op.OP_put_field || o == op.OP_put_loc_field_loc8 || o == op.OP_put_loc_field_arg8 { return true }
    }
    i = i + 1
  }
  return false
}
/// Whether the field store at pc holds an add key (FieldLayout.addKey in its upper half):
/// its last run added the property.
fn addSite(input: &FunctionInput, pc: u32, addKey: u32) -> bool {
  return u64.wrappingToU32(u64.shiftRight(inlineKey(input, pc), 32)) == addKey
}
/// The inline field-cache key of the field instruction at pc: 8 bytes after its atom, low
/// byte first (all ones past the code, as an empty key).
fn inlineKey(input: &FunctionInput, pc: u32) -> u64 {
  let at = u32.toUsize(pc) + 5
  if at + 8 > input.code.length() { return u64.MAX }
  let mut key: u64 = 0
  let mut b: usize = 8
  while b != 0 { b = b - 1 key = u64.bitOr(u64.shiftLeft(key, 8), u8.toU64(byteAt(input, at + b))) }
  return key
}
effect fn copyRecords(from: &List<RecordSlot>) -> List<RecordSlot> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<RecordSlot>.make()
  run out.appendSlice(from.asSlice())
  return move out
}

/// The local an instruction writes (`written`) or marks uninitialized, or usize.MAX.
fn tdzLocal(input: &FunctionInput, pc: usize, opcode: u8) -> usize {
  if opcode == op.OP_set_loc_uninitialized || opcode == op.OP_put_loc || opcode == op.OP_set_loc || opcode == op.OP_get_loc_check
    || opcode == op.OP_get_loc_checkthis || opcode == op.OP_put_loc_check || opcode == op.OP_put_loc_check_init { return u16.toUsize(u16At(input, pc + 1)) }
  if opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8 { return u8.toUsize(byteAt(input, pc + 1)) }
  if opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3 { return u8.toUsize(opcode - op.OP_put_loc0) }
  return usize.MAX
}

effect fn tdzMerge(tdz: &mut Tdz, seen: &mut List<bool>, work: &mut List<usize>, current: &List<bool>, pc: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let index = tdz.slot.get(pc)
  if index == NONE { return () }
  let base = u32.toUsize(index) * tdz.locals
  let mut changed = !seen.get(u32.toUsize(index))
  seen.set(u32.toUsize(index), true)
  let mut i: usize = 0
  while i < tdz.locals {
    if current.get(i) && !tdz.maybe.get(base + i) { tdz.maybe.set(base + i, true) changed = true }
    i = i + 1
  }
  if changed { run work.append(pc) }
}

/// The Tdz of `input`, whose shape is `shapeOf`, entered at `begin` (an OSR entry: every lexical
/// local may be uninitialized there).
effect fn tdzOf(input: &FunctionInput, shapeOf: &Shape, begin: usize, sideExits: bool, calls: bool, low: u32, high: u32) -> Tdz ! OutOfMemoryError ? &mut Allocator {
  let length = input.code.length()
  let locals = u32.toUsize(input.localCount)
  let mut tdz = Tdz { tracked: false, locals: locals, slot: List<u32>.make(), maybe: List<bool>.make() }
  let mut leaders: u32 = 0
  // Every instruction, not only those the shape reached: an OSR entry starts after the
  // set_loc_uninitialized that opened a lexical slot's TDZ.
  let mut pc: usize = 0
  while pc < length {
    if byteAt(input, pc) == op.OP_set_loc_uninitialized { tdz.tracked = true }
    let size = sizeAt(input, pc)
    if size == 0 { pc = length } else { pc = pc + size }
  }
  if !tdz.tracked || locals == 0 { return move tdz }
  run tdz.slot.appendRepeated(NONE, length + 1)
  pc = 0
  while pc < length {
    if shapeOf.leader.get(pc) && shapeOf.start.get(pc) { tdz.slot.set(pc, leaders) leaders = leaders + 1 }
    pc = pc + 1
  }
  run tdz.maybe.appendRepeated(false, u32.toUsize(leaders) * locals)
  let mut seen = List<bool>.make() run seen.appendRepeated(false, u32.toUsize(leaders))
  let mut work = List<usize>.make()
  let mut current = List<bool>.make() run current.appendRepeated(sideExits, locals)
  run tdzMerge(&mut tdz, &mut seen, &mut work, &current, begin)
  while work.length() > 0 {
    let leader = work.pop().unwrapOr(0)
    let base = u32.toUsize(tdz.slot.get(leader)) * locals
    let mut i: usize = 0
    while i < locals { current.set(i, tdz.maybe.get(base + i)) i = i + 1 }
    let mut at = leader
    let mut going = true
    while going && at < length {
      let opcode = byteAt(input, at)
      if sideExits && (osrExit(opcode, calls) || outside(at, low, high)) { going = false continue }
      let size = sizeAt(input, at)
      let local = tdzLocal(input, at, opcode)
      if local < locals { current.set(local, opcode == op.OP_set_loc_uninitialized) }
      if isReturn(opcode) || isThrow(opcode) { going = false }
      else if opcode == op.OP_ret {
        let mut r: usize = 0
        while r < shapeOf.returns.length() { run tdzMerge(&mut tdz, &mut seen, &mut work, &current, u32.toUsize(shapeOf.returns.get(r))) r = r + 1 }
        going = false
      } else if opcode == op.OP_gosub {
        run tdzMerge(&mut tdz, &mut seen, &mut work, &current, i64.toUsize(usize.toI64(at + 1) + i32.toI64(i32At(input, at + 1))))
        run tdzMerge(&mut tdz, &mut seen, &mut work, &current, at + 5)
        going = false
      } else if isBranch(opcode) || isGoto(opcode) {
        run tdzMerge(&mut tdz, &mut seen, &mut work, &current, i64.toUsize(targetOf(input, at)))
        if isBranch(opcode) { run tdzMerge(&mut tdz, &mut seen, &mut work, &current, at + size) }
        going = false
      } else {
        at = at + size
        if at < length && shapeOf.leader.get(at) { run tdzMerge(&mut tdz, &mut seen, &mut work, &current, at) going = false }
      }
    }
  }
  return move tdz
}

effect fn copyI32(from: &List<i32>) -> List<i32> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<i32>.make()
  run out.appendSlice(from.asSlice())
  return move out
}

impl Translator {
  fn isOwned(self: &Self, v: u32) -> bool { let info = self.f.value(v) return info.ty == Type.Value && info.own == Own.Owned }

  effect fn release(self: &mut Self, v: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.isOwned(v) { drop run self.f.emit(self.current, Op.Release, false, Type.I32, Own.Unboxed, v, NONE, 0, pc) }
  }
  /// A second owner of `v` for a new slot: a retain when `v` holds a count.
  effect fn share(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    if self.isOwned(v) { return run self.f.emit(self.current, Op.Retain, true, Type.Value, Own.Owned, v, NONE, 0, pc) }
    return v
  }
  effect fn push(self: &mut Self, v: u32) -> () ! OutOfMemoryError ? &mut Allocator { run self.stack.append(v) }
  fn pop(self: &mut Self) -> u32 { return self.stack.pop().unwrapOr(NONE) }
  fn top(self: &Self, depth: usize) -> u32 { return self.stack.get(self.stack.length() - depth) }

  /// The parameters of the code being translated: the function's, or an inlined body's.
  fn argumentLimit(self: &Self) -> usize { if self.depth != 0 { return u32.toUsize(self.formals) } return u32.toUsize(self.f.argumentCount) }

  /// The exit of a guard inside an inlined body, at `pc` of the body's code: the function's
  /// state before the outermost inlined call. While the bodies have had no effect the
  /// interpreter makes that call itself, and what the bodies own is dropped (Exit.drops).
  /// After an effect the call cannot be made again: the exit names every body's frame
  /// (Exit.frames), each at the call that began the next and the innermost at `pc`, for the
  /// engine to go on with (FunctionInput.leavesBodies; the inlining fails without it).
  effect fn inlineExit(self: &mut Self, inst: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut before = self.rootInst
    // A call's exit is also where it leaves when it threw: the body's frame takes that.
    // So does a body with a loop around: what ran in an earlier turn is not in front of
    // the instruction.
    let mut effects = self.f.insts.get(u32.toUsize(inst)).op == Op.Call || self.bodyLoops != 0 || self.paramWrites
    while before < u32.toUsize(inst) { if !withoutEffect(self.f.insts.get(before).op) { effects = true } before = before + 1 }
    if effects && !self.leaves { self.broken = true }
    drop run self.f.exitFor(inst, self.rootPc, usize.toU32(self.rootDepth))
    let real = u32.toUsize(self.f.localCount)
    let savedLocals = real + u32.toUsize(self.argSlots)
    let root = savedLocals + self.rootDepth
    let mut i: usize = 0
    // Exit slots restore real locals, operands, then writable parameters.
    while i < real { let v = self.held.get(i) run self.slot(v) i = i + 1 }
    i = savedLocals
    while i < root { let v = self.held.get(i) run self.slot(v) i = i + 1 }
    i = real
    while i < savedLocals { let v = self.held.get(i) run self.slot(v) i = i + 1 }
    if effects && self.leaves {
      let depth = u32.toUsize(self.depth)
      let mut n: usize = 0
      while n < depth {
        let call = self.calls.get(n)
        if n + 1 < depth {
          // A body around the current one: its state at the call that began the next.
          let next = self.calls.get(n + 1)
          run self.f.frameAt(ssa.ExitFrame { after: call.after, argc: call.argc, method: call.method, locals: usize.toU32(next.locals), depth: usize.toU32(next.stack), pc: next.pc })
          i = next.start
          while i < next.start + next.locals + next.stack { let v = self.held.get(i) run self.innerSlot(v) i = i + 1 }
        } else {
          run self.f.frameAt(ssa.ExitFrame { after: call.after, argc: call.argc, method: call.method, locals: usize.toU32(self.locals.length()), depth: usize.toU32(self.stack.length()), pc: pc })
          i = 0
          while i < self.locals.length() {
            let v = self.locals.get(i)
            if self.deadLocal(i, v, pc) { run self.f.innerAt(self.undef, SlotMode.Imm, NONE) } else { run self.innerSlot(v) }
            i = i + 1
          }
          i = 0
          while i < self.stack.length() { let v = self.stack.get(i) run self.innerSlot(v) i = i + 1 }
        }
        n = n + 1
      }
      return ()
    }
    i = root
    while i < self.held.length() { let v = self.held.get(i) if self.isOwned(v) { run self.f.dropAt(v, SlotMode.Move) } i = i + 1 }
    i = 0
    while i < self.locals.length() { let v = self.locals.get(i) if self.isOwned(v) { run self.f.dropAt(v, SlotMode.Move) } i = i + 1 }
    i = 0
    while i < self.stack.length() { let v = self.stack.get(i) if self.isOwned(v) { run self.f.dropAt(v, SlotMode.Move) } i = i + 1 }
  }

  /// Gives instruction `inst` an exit at `pc` with the current state.
  effect fn exitHere(self: &mut Self, inst: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.depth != 0 { run self.inlineExit(inst, pc) return () }
    drop run self.f.exitFor(inst, pc, usize.toU32(self.stack.length()))
    // Locals, the stack, then the parameter slots (ssa.Exit).
    let real = u32.toUsize(self.f.localCount)
    let mut i: usize = 0
    while i < real {
      let v = self.locals.get(i)
      if self.deadLocal(i, v, pc) { run self.f.slotAt(self.undef, SlotMode.Imm, NONE) } else { run self.slot(v) }
      i = i + 1
    }
    i = 0
    while i < self.stack.length() { let v = self.stack.get(i) run self.slot(v) i = i + 1 }
    i = real
    while i < self.locals.length() { let v = self.locals.get(i) run self.slot(v) i = i + 1 }
  }
  /// Whether an exit at `pc` names undefined for local `index`, which holds `v`: no path from
  /// `pc` reads the local before writing it (Liveness) and `v` holds no count. The value then
  /// lives no longer than its last reader, where it would have kept a register to the last
  /// exit before the local's next store (a temporary of a loop: to the end of the turn).
  fn deadLocal(self: &Self, index: usize, v: u32, pc: u32) -> bool {
    if self.undef == NONE || self.lazyLocal(index) { return false }
    let own = self.f.value(v).own
    return (own == Own.Unboxed || own == Own.Imm || own == Own.Borrowed) && self.deadAt(index, u32.toUsize(pc))
  }
  effect fn slot(self: &mut Self, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let info = self.f.value(v)
    if info.ty == Type.I32 { run self.f.slotAt(v, SlotMode.Int, NONE) }
    else if info.ty == Type.Bool { run self.f.slotAt(v, SlotMode.Bool, NONE) }
    else if info.ty == Type.F64 { run self.f.slotAt(v, SlotMode.F64, NONE) }
    else if info.own == Own.Owned { run self.f.slotAt(v, SlotMode.Move, NONE) }
    else if info.own == Own.Imm { run self.f.slotAt(v, SlotMode.Imm, NONE) }
    else {
      let mut root = NONE
      if info.rootKind == RootKind.Argument { root = info.root }
      run self.f.slotAt(v, SlotMode.Dup, root)
    }
  }
  /// `slot` for a slot of an inlined frame (Function.innerAt).
  effect fn innerSlot(self: &mut Self, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let info = self.f.value(v)
    if info.ty == Type.I32 { run self.f.innerAt(v, SlotMode.Int, NONE) }
    else if info.ty == Type.Bool { run self.f.innerAt(v, SlotMode.Bool, NONE) }
    else if info.ty == Type.F64 { run self.f.innerAt(v, SlotMode.F64, NONE) }
    else if info.own == Own.Owned { run self.f.innerAt(v, SlotMode.Move, NONE) }
    else if info.own == Own.Imm { run self.f.innerAt(v, SlotMode.Imm, NONE) }
    else {
      let mut root = NONE
      if info.rootKind == RootKind.Argument { root = info.root }
      run self.f.innerAt(v, SlotMode.Dup, root)
    }
  }

  /// `v` as an i32: itself, or unboxed with a guard that exits at `pc`.
  effect fn int(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ty = self.f.value(v).ty
    if ty == Type.I32 { return v }
    if ty == Type.Bool { return NONE }
    if ty == Type.F64 {
      let exact = run self.f.emit(self.current, Op.ExactI32, true, Type.I32, Own.Unboxed, v, NONE, 0, pc)
      let at = self.f.lastInst() run self.exitHere(at, pc)
      return exact
    }
    let r = run self.f.emit(self.current, Op.Unbox, true, Type.I32, Own.Unboxed, v, NONE, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  /// A guarded `add`, `sub` or `mul` of two i32 values.
  effect fn arith(self: &mut Self, operation: Op, x: u32, y: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let r = run self.f.emit(self.current, operation, true, Type.I32, Own.Unboxed, x, y, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  effect fn constant(self: &mut Self, k: i32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    return run self.f.emit(self.current, Op.ConstI32, true, Type.I32, Own.Unboxed, NONE, NONE, k, pc)
  }
  effect fn imm(self: &mut Self, k: Imm, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    return run self.f.emit(self.current, Op.Imm, true, Type.Value, Own.Imm, NONE, NONE, u8.toI32(Imm.value(k)), pc)
  }
  /// 1 or 0 when `v` is the immediate true or false, else -1.
  fn knownBool(self: &Self, v: u32) -> i32 {
    let info = self.f.value(v)
    if info.def == NONE { return -1 }
    let inst = self.f.inst(info.def)
    if inst.op != Op.Imm { return -1 }
    if inst.k == u8.toI32(Imm.value(Imm.True)) { return 1 }
    if inst.k == u8.toI32(Imm.value(Imm.False)) { return 0 }
    return -1
  }
  /// Argument `n`'s bits, borrowed from its cell.
  effect fn argument(self: &mut Self, n: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    // In an inlined body: the caller's operand as it is (possibly unboxed), or undefined.
    if self.depth != 0 {
      if u32.toUsize(n) < self.argCount { return self.held.get(self.argsBase + u32.toUsize(n)) }
      return run self.imm(Imm.Undefined, pc)
    }
    if u32.toUsize(n) < self.argNumbers.length() && self.argNumbers.get(u32.toUsize(n)) != NONE { return self.argNumbers.get(u32.toUsize(n)) }
    let v = run self.f.emit(self.current, Op.Arg, true, Type.Value, Own.Borrowed, NONE, NONE, u32.wrappingToI32(n), pc)
    self.f.setOwnership(v, Own.Borrowed, RootKind.Argument, n)
    return v
  }
  /// Parameter `n`'s current value: its slot when the function writes parameters, else its
  /// argument cell (borrowed).
  effect fn parameterValue(self: &mut Self, n: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    if self.argSlots != 0 && self.depth == 0 { let slotIndex = u32.toUsize(self.f.localCount + n) return self.locals.get(slotIndex) }
    return run self.argument(n, pc)
  }
  /// `v` boxed, for a block parameter or a return.
  effect fn boxed(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ty = self.f.value(v).ty
    if ty == Type.I32 { return run self.f.emit(self.current, Op.BoxI32, true, Type.Value, Own.Imm, v, NONE, 0, pc) }
    if ty == Type.Bool { return run self.f.emit(self.current, Op.BoxBool, true, Type.Value, Own.Imm, v, NONE, 0, pc) }
    if ty == Type.F64 { return run self.f.emit(self.current, Op.BoxF64, true, Type.Value, Own.Imm, v, NONE, 0, pc) }
    return v
  }

  /// Inside an inlined body, the frames around it, boxed: what its blocks take first.
  effect fn heldBoxed(self: &mut Self, pc: u32) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
    let mut out = List<u32>.make()
    if self.depth == 0 { return move out }
    let mut i: usize = 0
    while i < self.held.length() { let v = self.held.get(i) let b = run self.boxed(v, pc) run out.append(b) i = i + 1 }
    return move out
  }
  /// How many parameters a block of the code being translated has before its locals.
  fn outerCount(self: &Self) -> usize { if self.depth == 0 { return 0 } return self.held.length() }
  /// Starts filling `block`, whose parameters are the state: inside an inlined body the frames
  /// around it first, then the locals (as many as now) and the operands. Every instruction
  /// of a body needs its closure in this block (x64_backend.frameInto): `inline.frame` again
  /// for each body around, but the last `skip`.
  effect fn adopt(self: &mut Self, block: u32, skip: usize, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    self.current = block
    let params = run self.f.paramsOf(block)
    let outer = self.outerCount()
    let mut local = u32.toUsize(self.f.localCount + self.argSlots)
    if self.depth != 0 { local = self.locals.length() }
    self.locals.clear() self.stack.clear()
    let mut i: usize = 0
    while i < params.length() {
      if i < outer { self.held.set(i, params.get(i)) }
      else if i < outer + local { run self.locals.append(params.get(i)) }
      else { run self.stack.append(params.get(i)) }
      i = i + 1
    }
    if self.depth == 0 { return () }
    let mut n: usize = 0
    while n + 2 * skip < self.frames.length() {
      let closure = self.held.get(self.frames.get(n + 1))
      drop run self.f.emit(self.current, Op.InlineFrame, false, Type.I32, Own.Unboxed, closure, NONE, usize.toI32(self.frames.get(n)), pc)
      n = n + 2
    }
  }

  /// Records that block's parameters are the state at pc (leaderPc).
  effect fn setLeader(self: &mut Self, block: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    while self.leaderPc.length() <= u32.toUsize(block) { run self.leaderPc.append(NONE) }
    self.leaderPc.set(u32.toUsize(block), pc)
  }
  /// An edge from the current block to `target` carrying the whole state. A local no path
  /// from the target's pc reads before writing it (Liveness) goes as undefined: a number or
  /// an immediate, which a loop would otherwise carry boxed around for its exits alone (a
  /// temporary written at the top of each turn), and a value that holds a count, which is
  /// released on the edge. The target's parameter for the local then takes undefined from
  /// every edge and goes, where it would have carried the value on to the local's next
  /// store, boxed again at each block that knows it as a number. The release is in front of
  /// the jump when the edge is the block's only way out (EDGE_ALONE) and otherwise in a
  /// block of the edge's own, which `settle` ends once the branch has its two edges. An
  /// edge to a latch or from one carries the count: the latch decides (destination).
  effect fn edgeTo(self: &mut Self, target: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    // Boxes first: they are instructions of the current block.
    let mut args = run self.heldBoxed(pc)
    let mut at = NONE
    // A block's pc is in the code being translated (an inlined body's own, there), whose
    // liveness self.liveness is.
    if u32.toUsize(target) < self.leaderPc.length() { at = self.leaderPc.get(u32.toUsize(target)) }
    let carry = self.edgeMode == EDGE_CARRY || (at != NONE && self.blockAt.get(u32.toUsize(at)) != target)
    let mut parting = List<u32>.make()
    let mut gone = NONE
    let mut i: usize = 0
    while i < self.locals.length() {
      let v = self.locals.get(i)
      let own = self.f.value(v).own
      if at != NONE && (own != Own.Owned || !carry) && !self.lazyLocal(i) && self.deadAt(i, u32.toUsize(at)) {
        if own == Own.Owned { run parting.append(v) }
        if gone == NONE { gone = run self.imm(Imm.Undefined, pc) }
        run args.append(gone)
      } else { let b = run self.boxed(v, pc) run args.append(b) }
      i = i + 1
    }
    i = 0
    while i < self.stack.length() { let v = self.stack.get(i) let b = run self.boxed(v, pc) run args.append(b) i = i + 1 }
    let mut to = target
    if parting.length() != 0 {
      let mut block = self.current
      if self.edgeMode != EDGE_ALONE {
        block = run self.f.block()
        run self.framesInto(block, pc)
        to = block
        run self.mids.append(block) run self.mids.append(target) run self.mids.append(pc) run self.mids.append(usize.toU32(args.length()))
        i = 0
        while i < args.length() { run self.mids.append(args.get(i)) i = i + 1 }
      }
      i = 0
      while i < parting.length() { drop run self.f.emit(block, Op.Release, false, Type.I32, Own.Unboxed, parting.get(i), NONE, 0, pc) i = i + 1 }
      if to != target { return run self.f.newEdge(to) }
    }
    let edge = run self.f.newEdge(target)
    i = 0
    while i < args.length() { run self.f.edgeArgument(args.get(i)) i = i + 1 }
    return edge
  }
  /// Ends the blocks edgeTo put on the arms of the branch just made, each with its jump on
  /// to the arm's target (a branch's two edges are numbered one after the other, so these
  /// edges wait for it).
  effect fn settle(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut n: usize = 0
    while n < self.mids.length() {
      let count = u32.toUsize(self.mids.get(n + 3))
      let edge = run self.f.newEdge(self.mids.get(n + 1))
      let mut i: usize = 0
      while i < count { run self.f.edgeArgument(self.mids.get(n + 4 + i)) i = i + 1 }
      run self.f.terminate(self.mids.get(n), Op.Jump, NONE, edge, self.mids.get(n + 2))
      n = n + 4 + count
    }
    self.mids.clear()
  }
  /// Ends the current block with `branch c` to `whenTrue` and `whenFalse`, each taking the
  /// whole state.
  effect fn branchTo(self: &mut Self, c: u32, whenTrue: u32, whenFalse: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let first = run self.edgeTo(whenTrue, pc)
    drop run self.edgeTo(whenFalse, pc)
    run self.f.terminate(self.current, Op.Branch, c, first, pc)
    run self.settle()
  }
  /// Ends the current block with a jump to `target`, which takes the whole state.
  effect fn jumpOn(self: &mut Self, target: u32, pc: u32, mode: u8) -> () ! OutOfMemoryError ? &mut Allocator {
    self.edgeMode = mode
    let edge = run self.edgeTo(target, pc)
    self.edgeMode = EDGE_ARM
    run self.f.terminate(self.current, Op.Jump, NONE, edge, pc)
  }
  /// The `inline.frame` instructions a block of the code being translated starts with
  /// (adopt), into `block`.
  effect fn framesInto(self: &mut Self, block: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.depth == 0 { return () }
    let mut n: usize = 0
    while n < self.frames.length() {
      let closure = self.held.get(self.frames.get(n + 1))
      drop run self.f.emit(block, Op.InlineFrame, false, Type.I32, Own.Unboxed, closure, NONE, usize.toI32(self.frames.get(n)), pc)
      n = n + 2
    }
  }

  /// The block a jump from the instruction at `pc` to `targetPc` goes to: the target's block,
  /// or for a back edge a new latch block that polls and then jumps there.
  effect fn destination(self: &mut Self, targetPc: usize, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let target = self.blockAt.get(targetPc)
    if usize.toU32(targetPc) > pc { return target }
    let latch = run self.f.block()
    let saved = self.current
    let savedLocals = run copyList(&self.locals)
    let savedStack = run copyList(&self.stack)
    let savedHeld = run copyList(&self.held)
    // The latch's parameters mirror the state (in an inlined body the frames around it
    // first, as every block of a body has them); its poll exits at the loop target.
    self.current = latch
    let mut i: usize = 0
    if self.depth != 0 {
      let count = self.held.length() + self.locals.length() + self.stack.length()
      while i < count { drop run self.f.addParam(latch, Type.Value, Own.Owned) i = i + 1 }
      run self.adopt(latch, 0, pc)
    } else {
      while i < self.locals.length() { let p = run self.f.addParam(latch, Type.Value, Own.Owned) self.locals.set(i, p) i = i + 1 }
      i = 0
      while i < self.stack.length() { let p = run self.f.addParam(latch, Type.Value, Own.Owned) self.stack.set(i, p) i = i + 1 }
    }
    run self.setLeader(latch, usize.toU32(targetPc))
    // A local the loop writes before it reads it (Liveness) is dead at the target: the latch
    // lets its value go and the loop takes undefined, so no turn carries a temporary around
    // boxed for the exits alone. The latch's parameters hold a count, which edgeTo keeps. A
    // dead local the loop never writes stays: it is the same value on every turn, and a
    // release here would be the only thing that makes the loop carry it.
    let written = self.writtenBetween(targetPc, u32.toUsize(pc))
    let mut dead: usize = 0
    while dead < self.locals.length() {
      if dead < 64 && (u64.shiftRight(written, usize.toU64(dead)) & 1) != 0 && !self.lazyLocal(dead) && self.deadAt(dead, targetPc) {
        let u = run self.imm(Imm.Undefined, pc)
        run self.store(dead, u, pc)
      }
      dead = dead + 1
    }
    drop run self.f.emit(latch, Op.Poll, false, Type.I32, Own.Unboxed, NONE, NONE, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, usize.toU32(targetPc))
    run self.jumpOn(target, pc, EDGE_CARRY)
    self.current = saved
    self.locals = move savedLocals
    self.stack = move savedStack
    self.held = move savedHeld
    return latch
  }

  /// Ends the current block with a jump to the block of `targetPc`.
  effect fn jumpTo(self: &mut Self, targetPc: usize, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let dest = run self.destination(targetPc, pc)
    run self.jumpOn(dest, pc, EDGE_ALONE)
  }

  /// Starts filling the block of leader `pc`: its parameters are the state.
  effect fn enter(self: &mut Self, pc: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let block = self.blockAt.get(pc)
    run self.adopt(block, 0, usize.toU32(pc))
    if self.depth == 0 && self.tdz.tracked {
      let index = self.tdz.slot.get(pc)
      let params = run self.f.paramsOf(block)
      let local = u32.toUsize(self.f.localCount)
      let mut i: usize = 0
      while index != NONE && i < local && i < params.length() {
        if !self.tdz.maybe.get(u32.toUsize(index) * self.tdz.locals + i) { run self.markInitialized(params.get(i)) }
        i = i + 1
      }
    }
  }
  /// Whether no path from `next` in the code being translated (the function's own, or an
  /// inlined body's) reads local `index` before writing it (Liveness): the local is dead
  /// there.
  fn deadAt(self: &Self, index: usize, next: usize) -> bool {
    if !self.liveness.tracked || index >= 64 || next >= self.liveness.live.length() { return false }
    if (u64.shiftRight(self.liveness.all, usize.toU64(index)) & 1) == 0 { return false }
    return (u64.shiftRight(self.liveness.live.get(next), usize.toU64(index)) & 1) == 0
  }
  /// The locals some instruction from `first` to `last` writes without reading (Liveness).
  fn writtenBetween(self: &Self, first: usize, last: usize) -> u64 {
    if !self.liveness.tracked { return 0 }
    let mut out: u64 = 0
    let mut at = first
    while at <= last && at < self.liveness.kill.length() { out = out | self.liveness.kill.get(at) at = at + 1 }
    return out
  }
  /// Records that value `v` (a block parameter) is proven not to be Uninitialized.
  effect fn markInitialized(self: &mut Self, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let at = u32.toUsize(v)
    let have = self.initialized.length()
    if have <= at { run self.initialized.appendRepeated(false, at + 1 - have) }
    self.initialized.set(at, true)
  }
  /// Whether local `index` of the function's own frame is its lazy arguments object or the copy.
  fn lazyLocal(self: &Self, index: usize) -> bool {
    return self.depth == 0 && self.lazySlot != usize.MAX && (index == self.lazySlot || index == self.lazyAlias)
  }
  /// Whether `v` is a lazy arguments object's stand-in (a read of lazyLocal). The engine's
  /// grammar (js_bytecode.lazyArgumentsSite) puts one only under its use, in the same block.
  fn standIn(self: &Self, v: u32) -> bool {
    if self.depth != 0 || self.lazySlot == usize.MAX { return false }
    let info = self.f.value(v)
    if info.def == NONE { return false }
    let def = self.f.inst(info.def)
    return def.op == Op.Imm && def.k == u8.toI32(Imm.value(Imm.Uninitialized))
  }
  /// Whether `opcode` reads the length or an element of a stand-in: a generic exit, which the
  /// engine answers from the frame's own arguments, or leaves (CALL_DEOPT) when the
  /// interpreter would build the object (js_vm.compiledOp).
  fn lazyUse(self: &Self, opcode: u8) -> bool {
    if opcode == op.OP_get_length { return self.stack.length() >= 1 && self.standIn(self.top(1)) }
    if opcode == op.OP_get_array_el { return self.stack.length() >= 2 && self.standIn(self.top(2)) }
    return false
  }
  /// Whether a call is `f.apply(x, arguments)` on a stand-in (calls.LAZY_ARGUMENTS).
  fn lazyApply(self: &Self, method: bool, count: usize) -> bool {
    return method && count == 2 && self.stack.length() >= 4 && self.standIn(self.top(1))
  }
  /// Whether `v` holds an Uninitialized marker: 0 no, 1 yes, -1 not known.
  fn uninitializedState(self: &Self, v: u32) -> i32 {
    let info = self.f.value(v)
    if info.ty != Type.Value { return 0 }
    if info.def != NONE {
      let def = self.f.inst(info.def)
      if def.op == Op.Imm && def.k == u8.toI32(Imm.value(Imm.Uninitialized)) { return 1 }
      return 0
    }
    if !self.tdz.tracked { return 0 }
    if u32.toUsize(v) < self.initialized.length() && self.initialized.get(u32.toUsize(v)) { return 0 }
    return -1
  }

  /// Releases every local and operand, for a return.
  effect fn releaseAll(self: &mut Self, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    while i < self.locals.length() { let v = self.locals.get(i) run self.release(v, pc) i = i + 1 }
    i = 0
    while i < self.stack.length() { let v = self.stack.get(i) run self.release(v, pc) i = i + 1 }
  }

  /// Writes `v` to local `index`, releasing what it held.
  effect fn store(self: &mut Self, index: usize, v: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let old = self.locals.get(index)
    self.locals.set(index, v)
    run self.release(old, pc)
  }
  /// In an inlined body, the slot index (past the locals) that stands for parameter n, the
  /// caller's operand in held; refused for a parameter the call passed no argument for,
  /// which has no operand to carry it.
  effect fn heldParameter(self: &mut Self, n: usize, pc: u32, opcode: u8) -> usize ! Refusal {
    if n >= self.argCount { fail refuse(pc, opcode, b"a write of a parameter the call passed no argument for") }
    return self.locals.length() + n
  }
  /// Local `index`, or past the locals an inlined body's parameter (heldParameter).
  fn slotGet(self: &Self, index: usize) -> u32 {
    if index < self.locals.length() { return self.locals.get(index) }
    return self.held.get(self.argsBase + index - self.locals.length())
  }
  /// `store` for slotGet's slots: a parameter of an inlined body is the caller's operand,
  /// which the call then consumes as it is (paramWrites).
  effect fn slotStore(self: &mut Self, index: usize, v: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if index < self.locals.length() { run self.store(index, v, pc) return () }
    let at = self.argsBase + index - self.locals.length()
    let old = self.held.get(at)
    self.held.set(at, v)
    self.paramWrites = true
    run self.release(old, pc)
  }

  /// `add`/`sub`/`mul` or a comparison of the two top operands.
  effect fn binary(self: &mut Self, opcode: u8, pc: u32) -> () ! Refusal | OutOfMemoryError ? &mut Allocator {
    let a = self.top(2) let b = self.top(1)
    if equality(opcode) && self.wideEquality && (self.f.value(a).ty == Type.Value || self.f.value(b).ty == Type.Value) {
      // A site that deoptimized: equality of any two values through the interpreter's
      // identity tests. Outside OSR, == goes through a call that runs any coercion in place.
      let strict = opcode == op.OP_strict_eq || opcode == op.OP_strict_neq
      let negate = opcode == op.OP_neq || opcode == op.OP_strict_neq
      let mut r = NONE
      if !strict && self.exits && self.depth == 0 {
        let x = run self.boxed(a, pc) let y = run self.boxed(b, pc)
        let mut how = calls.kAt(0, compiled.SITE_EQUAL)
        if negate { how = how | calls.NOT_EQUAL }
        r = run self.f.emit(self.current, Op.Call, true, Type.Value, Own.Owned, x, y, how, pc)
        let last = self.f.lastInst() run self.exitHere(last, pc)
      } else { r = run self.equals(a, b, strict, negate, pc) }
      drop self.pop() drop self.pop()
      run self.release(a, pc) run self.release(b, pc)
      run self.push(r)
      return ()
    }
    if equality(opcode) && self.f.value(a).ty == Type.Value && self.f.value(b).ty == Type.Value {
      // Two values of kinds nothing here tells: the identity test answers in place for
      // objects, null and undefined as well as int32s, where a guard that both are int32s
      // would leave at the first object.
      let r = run self.equals(a, b, opcode == op.OP_strict_eq || opcode == op.OP_strict_neq, opcode == op.OP_neq || opcode == op.OP_strict_neq, pc)
      drop self.pop() drop self.pop()
      run self.release(a, pc) run self.release(b, pc)
      run self.push(r)
      return ()
    }
    if (opcode == op.OP_strict_eq || opcode == op.OP_strict_neq) && (self.f.value(a).ty == Type.Bool || self.f.value(b).ty == Type.Bool) {
      let negate = opcode == op.OP_strict_neq
      let aTy = self.f.value(a).ty
      let bTy = self.f.value(b).ty
      let mut r = NONE
      if aTy == Type.I32 || aTy == Type.F64 || bTy == Type.I32 || bTy == Type.F64 {
        r = run self.constBool(negate, pc)
      } else if aTy == Type.Bool && bTy == Type.Value {
        let bDef = self.f.value(b).def
        if bDef != NONE && self.f.inst(bDef).op == Op.Imm {
          let bk = self.f.inst(bDef).k
          if bk == u8.toI32(Imm.value(Imm.False)) || bk == u8.toI32(Imm.value(Imm.True)) {
            let isFalse = bk == u8.toI32(Imm.value(Imm.False))
            if isFalse != negate { r = run self.f.emit(self.current, Op.NotBool, true, Type.Bool, Own.Unboxed, a, NONE, 0, pc) }
            else { r = a }
          } else if bk == u8.toI32(Imm.value(Imm.Null)) || bk == u8.toI32(Imm.value(Imm.Undefined)) {
            r = run self.constBool(negate, pc)
          }
        }
        if r == NONE { r = run self.equals(a, b, true, negate, pc) }
      } else if bTy == Type.Bool && aTy == Type.Value {
        let aDef = self.f.value(a).def
        if aDef != NONE && self.f.inst(aDef).op == Op.Imm {
          let ak = self.f.inst(aDef).k
          if ak == u8.toI32(Imm.value(Imm.False)) || ak == u8.toI32(Imm.value(Imm.True)) {
            let isFalse = ak == u8.toI32(Imm.value(Imm.False))
            if isFalse != negate { r = run self.f.emit(self.current, Op.NotBool, true, Type.Bool, Own.Unboxed, b, NONE, 0, pc) }
            else { r = b }
          } else if ak == u8.toI32(Imm.value(Imm.Null)) || ak == u8.toI32(Imm.value(Imm.Undefined)) {
            r = run self.constBool(negate, pc)
          }
        }
        if r == NONE { r = run self.equals(a, b, true, negate, pc) }
      } else {
        r = run self.equals(a, b, true, negate, pc)
      }
      drop self.pop() drop self.pop()
      run self.release(a, pc) run self.release(b, pc)
      run self.push(r)
      return ()
    }
    if opcode == op.OP_add && self.concatenates(pc, a, b) {
      let r = run self.concatenation(a, b, pc)
      drop self.pop() drop self.pop()
      run self.release(a, pc) run self.release(b, pc)
      run self.push(r)
      return ()
    }
    if self.numberSite(pc, a, b) { run self.numberBinary(opcode, pc) return () }
    let x = run self.int(a, pc) let y = run self.int(b, pc)
    if x == NONE || y == NONE { fail refuse(pc, opcode, b"a boolean operand of arithmetic") }
    let mut r = NONE
    if opcode == op.OP_add { r = run self.arith(Op.Add, x, y, pc) }
    else if opcode == op.OP_sub { r = run self.arith(Op.Sub, x, y, pc) }
    else if opcode == op.OP_mul { r = run self.arith(Op.Mul, x, y, pc) }
    else {
      let mut kind = Cmp.Lt
      if opcode == op.OP_lte { kind = Cmp.Le }
      else if opcode == op.OP_gt { kind = Cmp.Gt }
      else if opcode == op.OP_gte { kind = Cmp.Ge }
      else if opcode == op.OP_eq || opcode == op.OP_strict_eq { kind = Cmp.Eq }
      else if opcode == op.OP_neq || opcode == op.OP_strict_neq { kind = Cmp.Ne }
      r = run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, x, y, u8.toI32(Cmp.value(kind)), pc)
    }
    drop self.pop() drop self.pop()
    run self.release(a, pc) run self.release(b, pc)
    run self.push(r)
  }

  /// `a === b` (strict) or `a == b` of any two operands, negated for `!==` and `!=`: an Equals
  /// helper call with an exit for the cases that coerce.
  effect fn equals(self: &mut Self, a: u32, b: u32, strict: bool, negate: bool, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let x = run self.boxed(a, pc) let y = run self.boxed(b, pc)
    let mut k: i32 = 0
    if strict { k = 1 }
    let r = run self.f.emit(self.current, Op.Equals, true, Type.Bool, Own.Unboxed, x, y, k, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    if negate { return run self.f.emit(self.current, Op.NotBool, true, Type.Bool, Own.Unboxed, r, NONE, 0, pc) }
    return r
  }

  /// Whether the `+` at `pc` of `a` and `b` goes through the engine's concatenation, on the
  /// function's own baseline frame: it left even as doubles (stepped), or an operand is text,
  /// which no number guard would let through.
  fn concatenates(self: &Self, pc: u32, a: u32, b: u32) -> bool {
    return self.exits && self.leaves && self.depth == 0 && (self.stepped(pc) || self.text(a) || self.text(b))
  }
  /// Whether `v` is a string constant (push_atom_value, push_empty_string) or what a
  /// concatenation made (a string but where neither operand was one).
  fn text(self: &Self, v: u32) -> bool {
    let def = self.f.value(v).def
    if def == NONE { return false }
    let inst = self.f.inst(def)
    return inst.op == Op.AtomValue || (inst.op == Op.Call && calls.kindOf(inst) == compiled.SITE_ADD)
  }
  /// `a + b` where a string took part (concatenates): a call the backend makes through the
  /// engine's concatenation, stepping the instruction on the frame for other operands
  /// (js_compiled.SITE_ADD). Its result is owned.
  effect fn concatenation(self: &mut Self, a: u32, b: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let x = run self.boxed(a, pc) let y = run self.boxed(b, pc)
    let r = run self.f.emit(self.current, Op.Call, true, Type.Value, Own.Owned, x, y, calls.kAt(0, compiled.SITE_ADD), pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }

  /// The truth of `v` for a branch: a bool as it is, an i32 compared with 0, a boxed value
  /// through ToBoolean.
  effect fn condition(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ty = self.f.value(v).ty
    if ty == Type.Bool { return v }
    if ty == Type.I32 {
      let zero = run self.constant(0, pc)
      return run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, v, zero, u8.toI32(Cmp.value(Cmp.Ne)), pc)
    }
    if ty == Type.F64 {
      // A double is false at 0, -0 and NaN: |x| > 0 (x != 0 would be true at NaN).
      let zero = run self.doubleConstant(0.0, pc)
      let magnitude = run self.f.emit(self.current, Op.AbsF64, true, Type.F64, Own.Unboxed, v, NONE, 0, pc)
      return run self.f.emit(self.current, Op.CmpF64, true, Type.Bool, Own.Unboxed, magnitude, zero, u8.toI32(Cmp.value(Cmp.Gt)), pc)
    }
    // A boxed value: ToBoolean, with no exit. Guessing a Bool costs a recompile for each
    // condition on an object or undefined (`options || {}`), one site at a time.
    return run self.f.emit(self.current, Op.Truthy, true, Type.Bool, Own.Unboxed, v, NONE, 0, pc)
  }
  /// The condition a branch tests: undefined/null for the nullish branches, else ToBoolean.
  effect fn branchTest(self: &mut Self, opcode: u8, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let mask = nullMask(opcode)
    if mask != 0 { return run self.nullTest(v, mask, pc) }
    return run self.condition(v, pc)
  }
  /// Whether v is undefined (mask bit 0) or null (bit 1): false for an unboxed number or bool.
  effect fn nullTest(self: &mut Self, v: u32, mask: i32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    if self.f.value(v).ty != Type.Value { return run self.constBool(false, pc) }
    return run self.f.emit(self.current, Op.TagIs, true, Type.Bool, Own.Unboxed, v, NONE, mask, pc)
  }
  effect fn constBool(self: &mut Self, value: bool, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let zero = run self.constant(0, pc)
    let mut k: i32 = 0
    if value { k = 1 }
    let x = run self.constant(k, pc)
    return run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, x, zero, u8.toI32(Cmp.value(Cmp.Ne)), pc)
  }

  // ---- numbers and the remaining operators (docs/jit/doubles.md) ----

  /// Whether the arithmetic or comparison at `pc` on `a` and `b` runs on doubles: an operand is
  /// one already, or the site deoptimized as int32 in an earlier compilation.
  fn numberSite(self: &Self, pc: u32, a: u32, b: u32) -> bool {
    if self.f.value(a).ty == Type.F64 || self.f.value(b).ty == Type.F64 { return true }
    return self.widened(pc)
  }
  /// Whether the instruction at `pc` deoptimized in an earlier compilation (a double site for
  /// arithmetic; a generic one for equality, stores and calls).
  fn widened(self: &Self, pc: u32) -> bool {
    let mut i: usize = 0
    while i < self.doubleSites.length() { if self.doubleSites.get(i) == pc { return true } i = i + 1 }
    return false
  }
  /// Whether the store at `pc` of `input`, at the index `index`, stays an element store
  /// though baseline code noted that it missed there: the loop around it may be a fill that
  /// grows the Array in front (ssa_opt_bounds, grow.bound), where a store by key would step
  /// for every element past the end. So when optimized code has not left at the store, the
  /// index is a local as it stands (an index made by an addition leaves a gap below it), and
  /// the innermost loop around the store has no other element store, no call, no field store
  /// and no loop of its own, and none of its checks in front failed before (ssa.SITE_ARRAY,
  /// ssa.SITE_BOUND). A loop that is no fill after all leaves at the store once, and the next
  /// compile stores by key.
  fn fillStore(self: &Self, input: &FunctionInput, pc: u32, index: u32) -> bool {
    let sites = &self.doubleSites
    if input.notedSites > sites.length() { return false }
    let mut s: usize = 0
    while s < sites.length() - input.notedSites { if sites.get(s) == pc { return false } s = s + 1 }
    let mut local = index
    let made = self.f.value(index).def
    if made != NONE && self.f.inst(made).op == Op.Retain { local = self.f.inst(made).a }
    let mut held = false
    let mut l: usize = 0
    while l < self.locals.length() { if self.locals.get(l) == local { held = true } l = l + 1 }
    if !held { return false }
    // The innermost loop around the store: the shortest backward jump over it.
    let length = input.code.length()
    let mut start = usize.MAX
    let mut end: usize = 0
    let mut at: usize = 0
    while at < length {
      let opcode = byteAt(input, at)
      let size = sizeAt(input, at)
      if size == 0 || at + size > length { return false }
      if (isBranch(opcode) || isGoto(opcode)) && at >= u32.toUsize(pc) {
        let target = targetOf(input, at)
        if target >= 0 && target <= u32.toI64(pc) && (start == usize.MAX || at - i64.toUsize(target) < end - start) { start = i64.toUsize(target) end = at }
      }
      at = at + size
    }
    if start == usize.MAX { return false }
    at = start
    while at <= end {
      let opcode = byteAt(input, at)
      if at != u32.toUsize(pc) && opcode == op.OP_put_array_el { return false }
      if callOpcode(opcode) || genericOpcode(opcode) || isReturn(opcode) || !supported(opcode)
        || opcode == op.OP_put_field || opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8 { return false }
      if at != end && (isBranch(opcode) || isGoto(opcode)) && targetOf(input, at) <= usize.toI64(at) { return false }
      at = at + sizeAt(input, at)
    }
    s = 0
    while s < sites.length() {
      let site = sites.get(s)
      let where = u32.bitAnd(site, u32.bitXor(u32.bitOr(SITE_ARRAY, SITE_BOUND), u32.MAX))
      if site != where && u32.toUsize(where) >= start && u32.toUsize(where) <= end { return false }
      s = s + 1
    }
    return true
  }
  /// Whether the instruction at `pc` left code that had it widened too (named twice in the
  /// sites, jit_runtime.LEFT_AGAIN): arithmetic there is the engine's, a step on the frame.
  fn stepped(self: &Self, pc: u32) -> bool {
    let mut n: u32 = 0
    let mut i: usize = 0
    while i < self.doubleSites.length() { if self.doubleSites.get(i) == pc { n = n + 1 } i = i + 1 }
    return n >= 2
  }
  /// `v` as a double: itself, converted from an i32, or unboxed with a number guard at `pc`.
  /// NONE for a bool (refused by the caller).
  effect fn number(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ty = self.f.value(v).ty
    if ty == Type.F64 { return v }
    if ty == Type.I32 { return run self.f.emit(self.current, Op.ToF64, true, Type.F64, Own.Unboxed, v, NONE, 0, pc) }
    if ty == Type.Bool { return NONE }
    let r = run self.f.emit(self.current, Op.UnboxF64, true, Type.F64, Own.Unboxed, v, NONE, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  /// `v` as ToInt32 would make it, for a bitwise operator: an i32 as it is, a double through
  /// ToInt32, a boxed value guarded as an Int (as a number on a double site). NONE for a bool.
  effect fn int32(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ty = self.f.value(v).ty
    if ty == Type.I32 { return v }
    if ty == Type.Bool { return NONE }
    let mut x = v
    if ty == Type.Value {
      if !self.numberSite(pc, v, v) { return run self.int(v, pc) }
      x = run self.number(v, pc)
    }
    return run self.f.emit(self.current, Op.ToInt32, true, Type.I32, Own.Unboxed, x, NONE, 0, pc)
  }
  effect fn doubleConstant(self: &mut Self, value: f64, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let bits = f64.toBits(value)
    let mut index: usize = 0
    while index < self.f.numbers.length() && self.f.numbers.get(index) != bits { index = index + 1 }
    if index == self.f.numbers.length() { run self.f.numbers.append(bits) }
    return run self.f.emit(self.current, Op.ConstF64, true, Type.F64, Own.Unboxed, NONE, NONE, usize.toI32(index), pc)
  }
  /// `add`/`sub`/`mul`/`div` or a comparison of the two top operands, on doubles.
  effect fn numberBinary(self: &mut Self, opcode: u8, pc: u32) -> () ! Refusal | OutOfMemoryError ? &mut Allocator {
    let a = self.top(2) let b = self.top(1)
    let x = run self.number(a, pc) let y = run self.number(b, pc)
    if x == NONE || y == NONE { fail refuse(pc, opcode, b"a boolean operand of arithmetic") }
    let mut r = NONE
    if opcode == op.OP_add { r = run self.f.emit(self.current, Op.AddF64, true, Type.F64, Own.Unboxed, x, y, 0, pc) }
    else if opcode == op.OP_sub { r = run self.f.emit(self.current, Op.SubF64, true, Type.F64, Own.Unboxed, x, y, 0, pc) }
    else if opcode == op.OP_mul { r = run self.f.emit(self.current, Op.MulF64, true, Type.F64, Own.Unboxed, x, y, 0, pc) }
    else if opcode == op.OP_div { r = run self.f.emit(self.current, Op.DivF64, true, Type.F64, Own.Unboxed, x, y, 0, pc) }
    else {
      let mut kind = Cmp.Lt
      if opcode == op.OP_lte { kind = Cmp.Le }
      else if opcode == op.OP_gt { kind = Cmp.Gt }
      else if opcode == op.OP_gte { kind = Cmp.Ge }
      else if opcode == op.OP_eq || opcode == op.OP_strict_eq { kind = Cmp.Eq }
      else if opcode == op.OP_neq || opcode == op.OP_strict_neq { kind = Cmp.Ne }
      r = run self.f.emit(self.current, Op.CmpF64, true, Type.Bool, Own.Unboxed, x, y, u8.toI32(Cmp.value(kind)), pc)
    }
    drop self.pop() drop self.pop()
    run self.release(a, pc) run self.release(b, pc)
    run self.push(r)
  }
  /// A guarded or plain int32 operation of `x` and `y` (both i32).
  effect fn intOperation(self: &mut Self, operation: Op, x: u32, y: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let r = run self.f.emit(self.current, operation, true, Type.I32, Own.Unboxed, x, y, 0, pc)
    if ssa.numberOpHasExit(operation) { let last = self.f.lastInst() run self.exitHere(last, pc) }
    return r
  }
  /// The opcodes of `numberOpcode`.
  effect fn numberInstruction(self: &mut Self, input: &FunctionInput, pc: usize) -> bool ! Refusal | OutOfMemoryError ? &mut Allocator {
    let opcode = byteAt(input, pc)
    let at = usize.toU32(pc)
    if opcode == op.OP_push_const || opcode == op.OP_push_const8 {
      let mut index: usize = 0
      if opcode == op.OP_push_const8 { index = u8.toUsize(byteAt(input, pc + 1)) } else { index = u32.toUsize(i32.wrappingToU32(i32At(input, pc + 1))) }
      if index >= input.numberConstants.length() { fail refuse(at, opcode, b"a constant index out of range") }
      let constant = input.numberConstants.get(index)
      if constant.kind == CONSTANT_INT { let c = run self.constant(u32.wrappingToI32(u64.wrappingToU32(constant.bits)), at) run self.push(c) return true }
      if constant.kind == CONSTANT_DOUBLE { let c = run self.doubleConstant(f64.fromBits(constant.bits), at) run self.push(c) return true }
      // A string, regexp source or other constant: load inline from bytecode.constants in frame mode.
      if self.leaves && self.depth == 0 && index < 65536 {
        let c = run self.f.emit(self.current, Op.ConstVal, true, Type.Value, Own.Owned, NONE, NONE, usize.toI32(index), at)
        run self.push(c)
        return true
      }
      return run self.generic(input, pc)
    }
    if opcode == op.OP_div { run self.numberBinary(opcode, at) return true }
    if opcode == op.OP_strict_eq_imm8 || opcode == op.OP_strict_neq_imm8 {
      let a = self.top(1)
      let k = i8At(input, pc + 1)
      let mut kind = Cmp.Eq
      if opcode == op.OP_strict_neq_imm8 { kind = Cmp.Ne }
      let mut r = NONE
      if self.f.value(a).ty == Type.Bool { r = run self.constBool(opcode == op.OP_strict_neq_imm8, at) }
      else if self.f.value(a).ty == Type.Value && self.wideEquality {
        let c = run self.constant(k, at)
        r = run self.equals(a, c, true, opcode == op.OP_strict_neq_imm8, at)
      } else if self.numberSite(at, a, a) {
        let x = run self.number(a, at)
        if x == NONE { fail refuse(at, opcode, b"a boolean compared with a number") }
        let c = run self.doubleConstant(i32.toF64(k), at)
        r = run self.f.emit(self.current, Op.CmpF64, true, Type.Bool, Own.Unboxed, x, c, u8.toI32(Cmp.value(kind)), at)
      } else {
        // A bool is never strictly equal to a number; anything else is speculated an Int.
        if self.f.value(a).ty == Type.Bool { fail refuse(at, opcode, b"a boolean compared with a number") }
        let x = run self.int(a, at)
        let c = run self.constant(k, at)
        r = run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, x, c, u8.toI32(Cmp.value(kind)), at)
      }
      drop self.pop() run self.release(a, at) run self.push(r)
      return true
    }
    if opcode == op.OP_lnot {
      let a = self.top(1)
      let c = run self.condition(a, at)
      let r = run self.f.emit(self.current, Op.NotBool, true, Type.Bool, Own.Unboxed, c, NONE, 0, at)
      drop self.pop() run self.release(a, at) run self.push(r)
      return true
    }
    if opcode == op.OP_neg || opcode == op.OP_plus || opcode == op.OP_post_inc || opcode == op.OP_post_dec {
      let a = self.top(1)
      if self.numberSite(at, a, a) {
        let x = run self.number(a, at)
        if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        drop self.pop() run self.release(a, at)
        if opcode == op.OP_neg { let r = run self.f.emit(self.current, Op.NegF64, true, Type.F64, Own.Unboxed, x, NONE, 0, at) run self.push(r) }
        else if opcode == op.OP_plus { run self.push(x) }
        else {
          let mut k: f64 = 1.0
          if opcode == op.OP_post_dec { k = -1.0 }
          let c = run self.doubleConstant(k, at)
          let r = run self.f.emit(self.current, Op.AddF64, true, Type.F64, Own.Unboxed, x, c, 0, at)
          run self.push(x) run self.push(r)
        }
        return true
      }
      let x = run self.int(a, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      if opcode == op.OP_neg {
        let r = run self.f.emit(self.current, Op.Neg, true, Type.I32, Own.Unboxed, x, NONE, 0, at)
        let last = self.f.lastInst() run self.exitHere(last, at)
        drop self.pop() run self.release(a, at) run self.push(r)
      } else if opcode == op.OP_plus {
        drop self.pop() run self.release(a, at) run self.push(x)
      } else {
        let one = run self.constant(1, at)
        let mut operation = Op.Add
        if opcode == op.OP_post_dec { operation = Op.Sub }
        let r = run self.arith(operation, x, one, at)
        drop self.pop() run self.release(a, at) run self.push(x) run self.push(r)
      }
      return true
    }
    if opcode == op.OP_not {
      let a = self.top(1)
      let x = run self.int32(a, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean operand of a bitwise operator") }
      let r = run self.f.emit(self.current, Op.BitNot, true, Type.I32, Own.Unboxed, x, NONE, 0, at)
      drop self.pop() run self.release(a, at) run self.push(r)
      return true
    }
    if opcode == op.OP_shl_imm || opcode == op.OP_sar_imm || opcode == op.OP_and_imm || opcode == op.OP_or_imm {
      let a = self.top(1)
      let x = run self.int32(a, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean operand of a bitwise operator") }
      let k = run self.constant(i16At(input, pc + 1), at)
      let mut operation = Op.Shl
      if opcode == op.OP_sar_imm { operation = Op.Sar }
      else if opcode == op.OP_and_imm { operation = Op.BitAnd }
      else if opcode == op.OP_or_imm { operation = Op.BitOr }
      let r = run self.intOperation(operation, x, k, at)
      drop self.pop() run self.release(a, at) run self.push(r)
      return true
    }
    // The two-operand bitwise operators and %.
    let a = self.top(2) let b = self.top(1)
    if opcode == op.OP_mod {
      if self.numberSite(at, a, b) {
        let x = run self.number(a, at) let y = run self.number(b, at)
        if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        let r = run self.f.emit(self.current, Op.ModF64, true, Type.F64, Own.Unboxed, x, y, 0, at)
        drop self.pop() drop self.pop() run self.release(a, at) run self.release(b, at) run self.push(r)
        return true
      }
      let x = run self.int(a, at) let y = run self.int(b, at)
      if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      let r = run self.intOperation(Op.Mod, x, y, at)
      drop self.pop() drop self.pop() run self.release(a, at) run self.release(b, at) run self.push(r)
      return true
    }
    let x = run self.int32(a, at) let y = run self.int32(b, at)
    if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of a bitwise operator") }
    let mut operation = Op.BitAnd
    if opcode == op.OP_or { operation = Op.BitOr }
    else if opcode == op.OP_xor { operation = Op.BitXor }
    else if opcode == op.OP_shl { operation = Op.Shl }
    else if opcode == op.OP_sar { operation = Op.Sar }
    else if opcode == op.OP_shr { operation = Op.Shr }
    let r = run self.intOperation(operation, x, y, at)
    drop self.pop() drop self.pop() run self.release(a, at) run self.release(b, at) run self.push(r)
    return true
  }

  /// Translates the instruction at `pc` (not a terminator of control flow unless it is one).
  /// Returns false when it ended the block.
  effect fn instruction(self: &mut Self, input: &FunctionInput, pc: usize) -> bool ! Refusal | OutOfMemoryError ? &mut Allocator {
    let opcode = byteAt(input, pc)
    let at = usize.toU32(pc)
    let size = sizeAt(input, pc)
    if opcode == op.OP_fuse_prefix { return true }
    // Arithmetic that left even as doubles (a string concatenation): the engine's, on the
    // frame. Only what reads its operands and pushes its result; a store to a local would
    // leave the translation's local stale.
    if self.exits && self.leaves && self.depth == 0 && stackArithmetic(opcode) && !addition(opcode) && self.stepped(at) { return run self.generic(input, pc) }
    if opcode == op.OP_push_i32 { let c = run self.constant(i32At(input, pc + 1), at) run self.push(c) return true }
    if opcode == op.OP_push_i8 { let c = run self.constant(i8At(input, pc + 1), at) run self.push(c) return true }
    if opcode == op.OP_push_i16 { let c = run self.constant(i16At(input, pc + 1), at) run self.push(c) return true }
    if opcode == op.OP_push_0 { let c = run self.constant(0, at) run self.push(c) return true }
    if opcode == op.OP_push_1 { let c = run self.constant(1, at) run self.push(c) return true }
    if opcode == op.OP_undefined { let c = run self.imm(Imm.Undefined, at) run self.push(c) return true }
    if opcode == op.OP_null { let c = run self.imm(Imm.Null, at) run self.push(c) return true }
    if opcode == op.OP_push_true { let c = run self.imm(Imm.True, at) run self.push(c) return true }
    if opcode == op.OP_push_false { let c = run self.imm(Imm.False, at) run self.push(c) return true }
    if opcode == op.OP_drop { let v = self.pop() run self.release(v, at) return true }
    if opcode == op.OP_dup { let t = self.top(1) let v = run self.share(t, at) run self.push(v) return true }
    if opcode == op.OP_nip { let b = self.pop() let a = self.pop() run self.push(b) run self.release(a, at) return true }
    if opcode == op.OP_swap { let b = self.pop() let a = self.pop() run self.push(b) run self.push(a) return true }
    let shuffle = shuffleOf(opcode)
    if shuffle.length != 0 {
      let n = u8.toUsize(shuffle[0] - 48)
      let mut window = List<u32>.make()
      let mut used = List<bool>.make()
      let mut i: usize = 0
      while i < n { run window.append(self.top(n - i)) run used.append(false) i = i + 1 }
      i = 0
      while i < n { drop self.pop() i = i + 1 }
      i = 1
      while i < shuffle.length {
        let from = u8.toUsize(shuffle[i] - 48)
        let v = window.get(from)
        if used.get(from) { let copy = run self.share(v, at) run self.push(copy) } else { used.set(from, true) run self.push(v) }
        i = i + 1
      }
      i = 0
      while i < n { if !used.get(i) { run self.release(window.get(i), at) } i = i + 1 }
      return true
    }

    // A lazy arguments object's stand-in (js_vm_factories.lazyArgumentsSlot).
    if opcode == op.OP_special_object && byteAt(input, pc + 1) == SPECIAL_LAZY_ARGUMENTS && self.depth == 0 {
      let u = run self.imm(Imm.Uninitialized, at) run self.push(u) return true
    }
    // Locals and arguments.
    let mut index: usize = usize.MAX
    if opcode == op.OP_get_loc || opcode == op.OP_put_loc || opcode == op.OP_set_loc || opcode == op.OP_get_arg
      || opcode == op.OP_get_loc_check || opcode == op.OP_put_loc_check || opcode == op.OP_put_loc_check_init
      || opcode == op.OP_set_loc_uninitialized || opcode == op.OP_get_loc_checkthis { index = u16.toUsize(u16At(input, pc + 1)) }
    else if opcode == op.OP_get_loc8 || opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8 || opcode == op.OP_inc_loc
      || opcode == op.OP_dec_loc || opcode == op.OP_add_loc || opcode == op.OP_step_loc8 { index = u8.toUsize(byteAt(input, pc + 1)) }
    else if opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3 { index = u8.toUsize(opcode - op.OP_get_loc0) }
    else if opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3 { index = u8.toUsize(opcode - op.OP_put_loc0) }
    else if opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3 { index = u8.toUsize(opcode - op.OP_get_arg0) }
    else if opcode == op.OP_step_arg8 {
      // step_loc8 on the parameter's slot (argSlots is set: the scan saw this instruction),
      // or in an inlined body on the caller's operand that is the argument (heldParameter).
      let n = u8.toU32(byteAt(input, pc + 1))
      if self.depth != 0 { index = run self.heldParameter(u32.toUsize(n), at, opcode) }
      else {
        if n >= self.argSlots { fail refuse(at, opcode, b"argument index out of range") }
        index = u32.toUsize(self.f.localCount + n)
      }
    }
    let isArgument = opcode == op.OP_get_arg || (opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3)
    if index != usize.MAX {
      if isArgument { if index >= self.argumentLimit() { fail refuse(at, opcode, b"argument index out of range") } }
      else if index >= self.locals.length() && !(opcode == op.OP_step_arg8 && self.depth != 0) { fail refuse(at, opcode, b"local index out of range") }
    }
    if isArgument && self.argSlots != 0 && self.depth == 0 {
      let slotIndex = u32.toUsize(self.f.localCount) + index
      let l = self.locals.get(slotIndex) let v = run self.share(l, at) run self.push(v) return true
    }
    if isArgument {
      let a = run self.argument(usize.toU32(index), at)
      if self.depth != 0 { let shared = run self.share(a, at) run self.push(shared) return true }
      let r = run self.f.emit(self.current, Op.Retain, true, Type.Value, Own.Owned, a, NONE, 0, at)
      run self.push(r) return true
    }
    if opcode == op.OP_put_arg || opcode == op.OP_set_arg {
      // A parameter slot (argSlots is set: the scan saw this instruction), or in an inlined
      // body the caller's operand that is the argument (heldParameter).
      let n = u16.toUsize(u16At(input, pc + 1))
      let mut slotIndex = usize.MAX
      if self.depth != 0 { slotIndex = run self.heldParameter(n, at, opcode) }
      else {
        if n >= u32.toUsize(self.argSlots) { fail refuse(at, opcode, b"argument index out of range") }
        slotIndex = u32.toUsize(self.f.localCount) + n
      }
      let mut v = NONE
      if opcode == op.OP_put_arg { v = self.pop() } else { let kept = self.top(1) v = run self.share(kept, at) }
      run self.slotStore(slotIndex, v, at)
      return true
    }
    if opcode == op.OP_get_loc || opcode == op.OP_get_loc8 || (opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3) {
      // The lazy arguments local holds its stand-in for the whole run: compiled code never
      // builds the object (its uses that would leave to the interpreter).
      if self.lazyLocal(index) { let u = run self.imm(Imm.Uninitialized, at) run self.push(u) return true }
      let l = self.locals.get(index) let v = run self.share(l, at) run self.push(v) return true
    }
    let writes = opcode == op.OP_put_loc || opcode == op.OP_put_loc8 || (opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3)
      || opcode == op.OP_set_loc || opcode == op.OP_set_loc8
    if writes && !self.lazyLocal(index) && self.deadAt(index, pc + sizeAt(input, pc)) {
      // A store no path reads (Liveness): the local holds undefined, the value keeps no
      // second count (set_loc) or goes now (put_loc).
      if opcode != op.OP_set_loc && opcode != op.OP_set_loc8 { let v = self.pop() run self.release(v, at) }
      let u = run self.imm(Imm.Undefined, at)
      run self.store(index, u, at) return true
    }
    if opcode == op.OP_put_loc || opcode == op.OP_put_loc8 || (opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3) {
      let v = self.pop() run self.store(index, v, at) return true
    }
    if opcode == op.OP_set_loc || opcode == op.OP_set_loc8 {
      let t = self.top(1) let v = run self.share(t, at) run self.store(index, v, at) return true
    }
    if opcode == op.OP_set_loc_uninitialized { let u = run self.imm(Imm.Uninitialized, at) run self.store(index, u, at) return true }
    // get_loc_checkthis is a derived constructor's get_loc_check of `this` (another message).
    if opcode == op.OP_get_loc_check || opcode == op.OP_get_loc_checkthis || opcode == op.OP_put_loc_check || opcode == op.OP_put_loc_check_init {
      // Only when the slot's state is known here: an Uninitialized constant, or a value that
      // is not one (an i32 or bool, or an instruction other than that constant).
      let current = self.locals.get(index)
      let state = self.uninitializedState(current)
      let uninitialized = state == 1
      if state < 0 { fail refuse(at, opcode, b"cannot prove whether a lexical slot is initialized") }
      if opcode == op.OP_put_loc_check_init {
        if !uninitialized { fail refuse(at, opcode, b"initializing a slot that may be initialized") }
        let v = self.pop() run self.store(index, v, at) return true
      }
      if uninitialized { fail refuse(at, opcode, b"reads or writes a lexical slot before its initialization (throws)") }
      if opcode == op.OP_get_loc_check || opcode == op.OP_get_loc_checkthis { let v = run self.share(current, at) run self.push(v) return true }
      let v = self.pop() run self.store(index, v, at) return true
    }

    // Arithmetic and comparisons.
    if opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_mul || opcode == op.OP_lt || opcode == op.OP_lte
      || opcode == op.OP_gt || opcode == op.OP_gte || opcode == op.OP_eq || opcode == op.OP_neq
      || opcode == op.OP_strict_eq || opcode == op.OP_strict_neq {
      run self.binary(opcode, at) return true
    }
    if opcode == op.OP_add_imm || opcode == op.OP_inc || opcode == op.OP_dec {
      let a = self.top(1)
      if self.numberSite(at, a, a) {
        let mut k: i32 = 1
        if opcode == op.OP_add_imm { k = i16At(input, pc + 1) }
        if opcode == op.OP_dec { k = -1 }
        let x = run self.number(a, at)
        if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        let c = run self.doubleConstant(i32.toF64(k), at)
        let r = run self.f.emit(self.current, Op.AddF64, true, Type.F64, Own.Unboxed, x, c, 0, at)
        drop self.pop() run self.release(a, at) run self.push(r)
        return true
      }
      let x = run self.int(a, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      let mut k: i32 = 1
      if opcode == op.OP_add_imm { k = i16At(input, pc + 1) }
      let c = run self.constant(k, at)
      let mut operation = Op.Add
      if opcode == op.OP_dec { operation = Op.Sub }
      let r = run self.arith(operation, x, c, at)
      drop self.pop() run self.release(a, at) run self.push(r)
      return true
    }
    if opcode == op.OP_inc_loc || opcode == op.OP_dec_loc || opcode == op.OP_step_loc8 || opcode == op.OP_step_arg8 {
      let stepping = opcode == op.OP_step_loc8 || opcode == op.OP_step_arg8
      let v = self.slotGet(index)
      if self.numberSite(at, v, v) {
        let mut k: f64 = 1.0
        let mut mode: u8 = 1
        if stepping { mode = byteAt(input, pc + 2) if (mode & 2) != 0 { k = -1.0 } }
        else if opcode == op.OP_dec_loc { k = -1.0 }
        let x = run self.number(v, at)
        if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        let c = run self.doubleConstant(k, at)
        let r = run self.f.emit(self.current, Op.AddF64, true, Type.F64, Own.Unboxed, x, c, 0, at)
        run self.slotStore(index, r, at)
        if stepping { if (mode & 1) != 0 { run self.push(r) } else { run self.push(x) } }
        return true
      }
      let x = run self.int(v, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      let one = run self.constant(1, at)
      let mut operation = Op.Add
      let mut mode: u8 = 0
      if stepping { mode = byteAt(input, pc + 2) if (mode & 2) != 0 { operation = Op.Sub } }
      else if opcode == op.OP_dec_loc { operation = Op.Sub }
      let r = run self.arith(operation, x, one, at)
      run self.slotStore(index, r, at)
      // step_loc8 pushes the old value (mode bit 0 clear) or the new one.
      if stepping { if (mode & 1) != 0 { run self.push(r) } else { run self.push(x) } }
      return true
    }
    if opcode == op.OP_add_loc {
      let b = self.top(1) let v = self.locals.get(index)
      // `s += text`: the engine's concatenation into the local; when neither is a string the
      // code leaves (no step, which would store into the frame's local behind the code's).
      if self.concatenates(at, v, b) {
        let r = run self.concatenation(v, b, at)
        drop self.pop() run self.release(b, at)
        run self.store(index, r, at)
        return true
      }
      if self.numberSite(at, v, b) {
        let x = run self.number(v, at) let y = run self.number(b, at)
        if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        let r = run self.f.emit(self.current, Op.AddF64, true, Type.F64, Own.Unboxed, x, y, 0, at)
        drop self.pop() run self.release(b, at)
        run self.store(index, r, at)
        return true
      }
      let x = run self.int(v, at) let y = run self.int(b, at)
      if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      let r = run self.arith(Op.Add, x, y, at)
      drop self.pop() run self.release(b, at)
      run self.store(index, r, at)
      return true
    }
    if (opcode >= op.OP_add_loc_loc8 && opcode <= op.OP_mul_top_loc8) || (opcode >= op.OP_add_top_arg8 && opcode <= op.OP_mul_top_arg8) {
      let mut operation = Op.Add
      if opcode == op.OP_sub_loc_loc8 || opcode == op.OP_sub_top_loc8 || opcode == op.OP_sub_top_arg8 { operation = Op.Sub }
      if opcode == op.OP_mul_loc_loc8 || opcode == op.OP_mul_top_loc8 || opcode == op.OP_mul_top_arg8 { operation = Op.Mul }
      let twoLocals = opcode <= op.OP_mul_loc_loc8
      let mut left = NONE
      let first = u8.toUsize(byteAt(input, pc + 1))
      let mut rightIndex = first
      if twoLocals {
        rightIndex = u8.toUsize(byteAt(input, pc + 2))
        if first >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
        left = self.locals.get(first)
      } else { left = self.top(1) }
      let mut right = NONE
      if opcode >= op.OP_add_top_arg8 {
        if rightIndex >= self.argumentLimit() { fail refuse(at, opcode, b"argument index out of range") }
        right = run self.parameterValue(usize.toU32(rightIndex), at)
      } else {
        if rightIndex >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
        right = self.locals.get(rightIndex)
      }
      if operation == Op.Add && self.concatenates(at, left, right) {
        let r = run self.concatenation(left, right, at)
        if !twoLocals { drop self.pop() run self.release(left, at) }
        run self.push(r)
        return true
      }
      if self.numberSite(at, left, right) {
        let x = run self.number(left, at) let y = run self.number(right, at)
        if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        let r = run self.f.emit(self.current, doubleOf(operation), true, Type.F64, Own.Unboxed, x, y, 0, at)
        if !twoLocals { drop self.pop() run self.release(left, at) }
        run self.push(r)
        return true
      }
      let x = run self.int(left, at) let y = run self.int(right, at)
      if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      let r = run self.arith(operation, x, y, at)
      if !twoLocals { drop self.pop() run self.release(left, at) }
      run self.push(r)
      return true
    }

    // Control.
    if keepBranch(opcode) {
      // Taken keeps the tested value on the stack; the fall-through drops it, in a block of
      // its own that receives the whole state and releases the value.
      let v = self.top(1)
      let c = run self.branchTest(opcode, v, at)
      let taken = run self.destination(i64.toUsize(targetOf(input, pc)), at)
      let dropBlock = run self.f.block()
      let mut i: usize = 0
      while i < self.outerCount() + self.locals.length() + self.stack.length() { drop run self.f.addParam(dropBlock, Type.Value, Own.Owned) i = i + 1 }
      if opcode == op.OP_if_true_keep8 { run self.branchTo(c, taken, dropBlock, at) } else { run self.branchTo(c, dropBlock, taken, at) }
      run self.adopt(dropBlock, 0, at)
      let dropped = self.pop() run self.release(dropped, at)
      run self.jumpTo(pc + size, at)
      return false
    }
    if isBranch(opcode) {
      let v = self.top(1)
      // A boolean the translation made itself (for_of_next's done on its fast step): the
      // branch is decided here.
      let known = self.knownBool(v)
      if known >= 0 && (opcode == op.OP_if_false || opcode == op.OP_if_false8 || opcode == op.OP_if_true || opcode == op.OP_if_true8) {
        drop self.pop()
        let jumps = (known == 1) == (opcode == op.OP_if_true || opcode == op.OP_if_true8)
        if jumps { run self.jumpTo(i64.toUsize(targetOf(input, pc)), at) } else { run self.jumpTo(pc + size, at) }
        return false
      }
      let c = run self.branchTest(opcode, v, at)
      drop self.pop() run self.release(v, at)
      let target = i64.toUsize(targetOf(input, pc))
      let fall = pc + size
      let taken = run self.destination(target, at)
      let next = run self.destination(fall, at)
      let mut whenTrue = taken let mut whenFalse = next
      if opcode == op.OP_if_false || opcode == op.OP_if_false8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_not_null8 { whenTrue = next whenFalse = taken }
      run self.branchTo(c, whenTrue, whenFalse, at)
      return false
    }
    if isGoto(opcode) { run self.jumpTo(i64.toUsize(targetOf(input, pc)), at) return false }
    if opcode == op.OP_return {
      let v = self.pop()
      run self.releaseAll(at)
      let r = run self.boxed(v, at)
      run self.f.terminate(self.current, Op.Return, r, NONE, at)
      return false
    }
    if opcode == op.OP_return_undef {
      run self.releaseAll(at)
      let u = run self.imm(Imm.Undefined, at)
      run self.f.terminate(self.current, Op.Return, u, NONE, at)
      return false
    }
    if opcode == op.OP_catch {
      // The marker the interpreter's unwinder finds in the exit state when anything in the
      // region throws; the handler itself only ever runs in the interpreter.
      let handler = usize.toI64(pc + 1) + i32.toI64(i32At(input, pc + 1))
      if handler <= 0 || handler >= usize.toI64(input.code.length()) || handler > 2147483647 - 8 { fail refuse(at, opcode, b"a catch handler outside the code") }
      let marker = run self.f.emit(self.current, Op.Imm, true, Type.Value, Own.Imm, NONE, NONE, ssa.IMM_CATCH + i64.wrappingToI32(handler), at)
      run self.push(marker)
      return true
    }
    if opcode == op.OP_nip_catch {
      // The result replaces the innermost marker; what is above it is released.
      let c = self.catchTop.get(pc)
      if c < 0 { fail refuse(at, opcode, b"nip_catch outside a try region") }
      let level = i32.toUsize(self.catchLevel.get(i32.toUsize(c)))
      if self.stack.length() < level + 2 { fail refuse(at, opcode, b"operand stack underflow") }
      let result = self.pop()
      while self.stack.length() > level { let v = self.pop() run self.release(v, at) }
      run self.push(result)
      return true
    }
    if opcode == op.OP_gosub {
      // The interpreter pushes the return offset as an Int: a constant per gosub site.
      let back = run self.constant(usize.toI32(pc + 5), at)
      run self.push(back)
      run self.jumpTo(i64.toUsize(usize.toI64(pc + 1) + i32.toI64(i32At(input, pc + 1))), at)
      return false
    }
    if opcode == op.OP_ret { run self.ret(at) return false }
    if isThrow(opcode) {
      // The interpreter re-executes the throw from the exit state (the operand on the stack);
      // the engine does not count an exit at a throw as a deopt (js_compiled.coldExit).
      run sideExit(&mut self, at)
      return false
    }
    if testOpcode(opcode) {
      let v = self.top(1)
      let mut r = NONE
      if nullMask(opcode) != 0 { r = run self.nullTest(v, nullMask(opcode), at) }
      else {
        let mut wanted = atoms.JS_ATOM_function
        if opcode == op.OP_typeof_is_undefined { wanted = atoms.JS_ATOM_undefined }
        else if opcode == op.OP_typeof_is { wanted = typeofIsAtom(byteAt(input, pc + 1)) }
        let ty = self.f.value(v).ty
        if ty == Type.I32 || ty == Type.F64 { r = run self.constBool(wanted == atoms.JS_ATOM_number, at) }
        else if ty == Type.Bool { r = run self.constBool(wanted == atoms.JS_ATOM_boolean, at) }
        else {
          let t = run self.f.emit(self.current, Op.TypeofAtom, true, Type.I32, Own.Unboxed, v, NONE, 0, at)
          let last = self.f.lastInst() run self.exitHere(last, at)
          let k = run self.constant(u32.wrappingToI32(wanted), at)
          r = run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, t, k, u8.toI32(Cmp.value(Cmp.Eq)), at)
        }
      }
      drop self.pop() run self.release(v, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_typeof && !self.widened(at) {
      let v = self.top(1)
      let b = run self.boxed(v, at)
      let r = run self.f.emit(self.current, Op.Typeof, true, Type.Value, Own.Owned, b, NONE, 0, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      drop self.pop() run self.release(v, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_instanceof {
      // The interpreter's arm: quickInstanceOf, both operands released; otherwise the full
      // operator (js_vm OP_instanceof), which this exit hands the instruction to.
      let a = self.top(2) let b = self.top(1)
      let left = run self.boxed(a, at)
      let right = run self.boxed(b, at)
      let r = run self.f.emit(self.current, Op.InstanceOf, true, Type.Bool, Own.Unboxed, left, right, 0, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      drop self.pop() drop self.pop()
      run self.release(b, at) run self.release(a, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_to_object && !self.widened(at) {
      let v = self.top(1)
      if self.f.value(v).ty == Type.Value {
        drop run self.f.emit(self.current, Op.CheckTag, false, Type.I32, Own.Unboxed, v, NONE, -1, at)
        let last = self.f.lastInst() run self.exitHere(last, at)
        return true
      }
    }
    if self.lazyUse(opcode) {
      if self.leaves && self.depth == 0 {
        if opcode == op.OP_get_length {
          let o = self.top(1)
          let r = run self.f.emit(self.current, Op.GetLength, true, Type.Value, Own.Owned, o, NONE, LENGTH_ARGUMENTS, at)
          let last = self.f.lastInst() run self.exitHere(last, at)
          drop self.pop() run self.release(o, at)
          run self.push(r)
          return true
        }
        if opcode == op.OP_get_array_el {
          let i = self.top(1)
          let o = self.top(2)
          let x = run self.int(i, at)
          if x != NONE {
            let r = run self.f.emit(self.current, Op.GetElem, true, Type.Value, Own.Owned, o, x, ELEM_ARGUMENTS, at)
            let last = self.f.lastInst() run self.exitHere(last, at)
            drop self.pop() drop self.pop()
            run self.release(i, at) run self.release(o, at)
            run self.push(r)
            return true
          }
        }
      }
      return run self.generic(input, pc)
    }
    if (opcode == op.OP_get_loc_length8 || opcode == op.OP_get_loc_el8) && self.lazyLocal(u8.toUsize(byteAt(input, pc + 1))) {
      if self.leaves && self.depth == 0 {
        if opcode == op.OP_get_loc_length8 {
          let o = run self.imm(Imm.Uninitialized, at)
          let r = run self.f.emit(self.current, Op.GetLength, true, Type.Value, Own.Owned, o, NONE, LENGTH_ARGUMENTS, at)
          let last = self.f.lastInst() run self.exitHere(last, at)
          run self.push(r)
          return true
        }
        let b = u8.toUsize(byteAt(input, pc + 2))
        if self.lazyLocal(b) { fail refuse(at, opcode, b"a fused read of a lazy arguments object") }
        let i = run self.slotValue(false, b, at, opcode)
        let x = run self.int(i, at)
        if x == NONE { fail refuse(at, opcode, b"a boolean index") }
        let o = run self.imm(Imm.Uninitialized, at)
        let r = run self.f.emit(self.current, Op.GetElem, true, Type.Value, Own.Owned, o, x, ELEM_ARGUMENTS, at)
        let last = self.f.lastInst() run self.exitHere(last, at)
        run self.push(r)
        return true
      }
      fail refuse(at, opcode, b"a fused read of a lazy arguments object")
    }
    if opcode == op.OP_for_of_next && self.osr {
      // A stand-in record (js_iterators.forOfStart: the array, then its next index as an Int)
      // steps a fast Array's element here; anything else exits, and the interpreter steps.
      let offset = u8.toUsize(byteAt(input, pc + 1))
      if self.stack.length() < 3 + offset { fail refuse(at, opcode, b"iterator record missing") }
      let method = self.top(2 + offset)
      let array = self.top(3 + offset)
      if self.f.value(array).ty != Type.Value { fail refuse(at, opcode, b"an iterator record of an unboxed number") }
      let position = run self.int(method, at)
      if position == NONE { fail refuse(at, opcode, b"an iterator record of a boolean") }
      let one = run self.constant(1, at)
      let next = run self.arith(Op.Add, position, one, at)
      let element = run self.f.emit(self.current, Op.GetElem, true, Type.Value, Own.Owned, array, position, ELEM_STEP, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      run self.release(method, at)
      let methodAt = self.stack.length() - 2 - offset
      self.stack.set(methodAt, next)
      run self.push(element)
      let done = run self.imm(Imm.False, at)
      run self.push(done)
      return true
    }
    if opcode == op.OP_for_of_next && !self.osr && self.depth == 0 && !self.widened(at) && run self.standInStep(input, pc) { return true }
    if opcode == op.OP_get_scope0_el && self.leaves && self.exits && self.depth == 0 && !self.stepped(at) {
      // this[kState]: the key from the function's own scope (get_scope0_check), then a read
      // by key on the element site cache (get.key). Both leave before the instruction, with
      // the object still on the stack; one that left twice is the interpreter's.
      let o = self.top(1)
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"an element of an unboxed number") }
      let k = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8)) | 0x10000
      let key = run self.f.emit(self.current, Op.GetScope, true, Type.Value, Own.Owned, NONE, NONE, k, at)
      let read = self.f.lastInst() run self.exitHere(read, at)
      let r = run self.f.emit(self.current, Op.GetKey, true, Type.Value, Own.Owned, o, key, 0, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      run self.release(key, at)
      drop self.pop() run self.release(o, at) run self.push(r)
      return true
    }
    if objectOpcode(opcode) { return run self.object(input, pc) }
    if callOpcode(opcode) { return run self.call(input, pc) }
    if numberOpcode(opcode) { return run self.numberInstruction(input, pc) }
    if genericOpcode(opcode) { return run self.generic(input, pc) }
    fail refuse(at, opcode, b"opcode outside the subset")
  }

  /// The parser's `for_of_next 0; if_false body` outside OSR code, for a stand-in record: an
  /// element of the fast Array steps straight to the body; anything else (past its length, a
  /// hole) is the generic exit, and translation goes on there. A real iterator's record deoptimizes at the
  /// position's unbox once; the recompiled site is widened and only takes the generic exit.
  effect fn standInStep(self: &mut Self, input: &FunctionInput, pc: usize) -> bool ! Refusal | OutOfMemoryError ? &mut Allocator {
    let at = usize.toU32(pc)
    let branch = pc + 2
    if byteAt(input, pc + 1) != 0 || branch >= input.code.length() || self.stack.length() < 3 { return false }
    let test = byteAt(input, branch)
    if (test != op.OP_if_false && test != op.OP_if_false8) || self.blockAt.get(branch) != NONE { return false }
    let body = targetOf(input, branch)
    if body < 0 || body >= usize.toI64(pc) { return false }
    let method = self.top(2)
    let array = self.top(3)
    if self.f.value(array).ty != Type.Value || self.f.value(method).ty != Type.Value { return false }
    let position = run self.int(method, at)
    let one = run self.constant(1, at)
    let next = run self.arith(Op.Add, position, one, at)
    let element = run self.f.emit(self.current, Op.GetElem, true, Type.Value, Own.Owned, array, position, ELEM_TRY, at)
    let read = self.f.lastInst() run self.exitHere(read, at)
    // Both ways carry the element (Uninitialized past the end, a hole, or not a fast Array).
    run self.push(element)
    let missed = run self.f.emit(self.current, Op.TagIs, true, Type.Bool, Own.Unboxed, element, NONE, 4, at)
    let width = self.outerCount() + self.locals.length() + self.stack.length()
    let step = run self.f.block()
    let end = run self.f.block()
    let mut i: usize = 0
    while i < width { drop run self.f.addParam(step, Type.Value, Own.Owned) drop run self.f.addParam(end, Type.Value, Own.Owned) i = i + 1 }
    run self.branchTo(missed, end, step, at)
    // The next position in the record, and on to the body with the element (done is false).
    run self.adopt(step, 0, at)
    let old = self.top(3)
    run self.release(old, at)
    let methodAt = self.stack.length() - 3
    self.stack.set(methodAt, next)
    run self.jumpTo(i64.toUsize(body), at)
    // Anything else is the engine's step.
    run self.adopt(end, 0, at)
    let gone = self.pop()
    run self.release(gone, at)
    return run self.generic(input, pc)
  }

  // ---- finally blocks (stream P) ----

  /// A block whose parameters are the current state (one owned value per local and operand,
  /// after those of the frames around an inlined body).
  effect fn stateBlock(self: &mut Self) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let block = run self.f.block()
    let mut i: usize = 0
    while i < self.outerCount() + self.locals.length() + self.stack.length() { drop run self.f.addParam(block, Type.Value, Own.Owned) i = i + 1 }
    return block
  }
  /// Continues in `block`, made by stateBlock: its parameters become the state.
  effect fn enterState(self: &mut Self, block: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    self.current = block
    let params = run self.f.paramsOf(block)
    let local = self.locals.length()
    let mut i: usize = 0
    while i < local && i < params.length() {
      if self.uninitializedState(self.locals.get(i)) == 0 { run self.markInitialized(params.get(i)) }
      i = i + 1
    }
    self.locals.clear() self.stack.clear()
    i = 0
    while i < params.length() {
      if i < local { run self.locals.append(params.get(i)) } else { run self.stack.append(params.get(i)) }
      i = i + 1
    }
  }
  /// `ret` at `pc`: the return offset on top is one of the gosub sites whose return point has
  /// this stack depth and try region; compare it with each and jump there. Any other value
  /// (none reaches here in compiled code) exits, and the interpreter runs the ret.
  effect fn ret(self: &mut Self, pc: u32) -> () ! Refusal | OutOfMemoryError ? &mut Allocator {
    if self.stack.length() == 0 { fail refuse(pc, op.OP_ret, b"operand stack underflow") }
    let after = usize.toI32(self.stack.length() - 1)
    let region = self.catchTop.get(u32.toUsize(pc))
    let mut i: usize = 0
    while i < self.returns.length() {
      let back = u32.toUsize(self.returns.get(i))
      i = i + 1
      if self.depthAt.get(back) != after || self.catchTop.get(back) != region || self.blockAt.get(back) == NONE { continue }
      let offsetValue = self.top(1)
      let x = run self.int(offsetValue, pc)
      if x == NONE { fail refuse(pc, op.OP_ret, b"a boolean return offset") }
      let k = run self.constant(usize.toI32(back), pc)
      let same = run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, x, k, u8.toI32(Cmp.value(Cmp.Eq)), pc)
      let matched = run self.stateBlock()
      let next = run self.stateBlock()
      run self.branchTo(same, matched, next, pc)
      run self.enterState(matched)
      let offset = self.pop() run self.release(offset, pc)
      let target = self.blockAt.get(back)
      run self.jumpOn(target, pc, EDGE_ALONE)
      run self.enterState(next)
    }
    run sideExit(&mut self, pc)
  }

  // ---- generic instruction exits (stream N) ----

  /// An instruction the engine runs as the interpreter does (docs/jit/compiled-entry.md 7.8):
  /// a `call` flagged calls.GENERIC whose arguments are the instruction's operands, bottom
  /// first, and whose result is what it pushes (undefined, released, when it pushes none).
  /// The exit before it holds the operands, so a throw is the interpreter's to unwind.
  effect fn generic(self: &mut Self, input: &FunctionInput, pc: usize) -> bool ! Refusal | OutOfMemoryError ? &mut Allocator {
    let opcode = byteAt(input, pc)
    let at = usize.toU32(pc)
    if opcode == op.OP_set_name && pc == self.namedClosure { return true }
    // Inside an inlined body the site pc is the callee's, but the engine runs the caller's frame.
    if self.depth != 0 { fail refuse(at, opcode, b"generic instruction inside an inlined body") }
    let info = op.opcodeInfo(opcode, true)
    let mut count = u8.toUsize(info.pops)
    if opcode == op.OP_array_from { count = u16.toUsize(u16At(input, pc + 1)) }
    run frameAllowed(input, pc)
    // for_of_next reads its record under `offset` values and leaves them all, with the step's
    // value and done above.
    if opcode == op.OP_for_of_next { count = 3 + u8.toUsize(byteAt(input, pc + 1)) }
    let results = genericResults(input, pc)
    let keptCells = genericKeptCells(input, pc)
    if results > i32.toUsize(calls.MAX_RESULTS) || i32.shiftRight(keptCells, usize.toI32(count)) != 0 { fail refuse(at, opcode, b"too many results for a generic instruction") }
    if count > u32.toUsize(calls.MAX_COMPILED_ARGUMENTS) { fail refuse(at, opcode, b"too many operands for a generic instruction") }
    if self.stack.length() < count { fail refuse(at, opcode, b"generic instruction operands missing") }
    // Boxes come before the call.arg run, which must stay contiguous.
    let mut operands = List<u32>.make()
    let mut i: usize = 0
    while i < count { let given = self.top(count - i) let boxed = run self.boxed(given, at) run operands.append(boxed) i = i + 1 }
    let none = run self.imm(Imm.Undefined, at)
    i = 0
    while i < count {
      drop run self.f.emit(self.current, Op.CallArg, false, Type.I32, Own.Unboxed, operands.get(i), NONE, usize.toI32(i), at)
      i = i + 1
    }
    let k = usize.toI32(count) | calls.GENERIC | i32.shiftLeft(usize.toI32(results), calls.RESULTS_SHIFT) | i32.shiftLeft(keptCells, calls.KEPT_SHIFT)
    let r = run self.f.emit(self.current, Op.Call, true, Type.Value, Own.Owned, none, none, k, at)
    let last = self.f.lastInst() run self.exitHere(last, at)
    if results != 0 {
      // Every value it left, read before anything else runs: a kept cell is the operand as it
      // was, the others the call's and call.result's. A for-of record's new marker (cell 2:
      // CatchOffset 0, no count) is the immediate the translation pushes for it.
      let mut values = List<u32>.make()
      let mut c: usize = 0
      while c < results {
        if calls.kept(k, usize.toI32(c)) { run values.append(self.top(count - c)) }
        else if c == 0 { run values.append(r) }
        else if c == 2 && opcode == op.OP_for_of_start { let marker = run self.f.emit(self.current, Op.Imm, true, Type.Value, Own.Imm, NONE, NONE, ssa.IMM_CATCH, at) run values.append(marker) }
        else { let v = run self.f.emit(self.current, Op.CallResult, true, Type.Value, Own.Owned, r, NONE, usize.toI32(c), at) run values.append(v) }
        c = c + 1
      }
      if calls.kept(k, 0) { run self.release(r, at) }
      // The operands it replaced go; the kept ones move to their cells.
      i = 0
      while i < count { let v = self.pop() if !calls.kept(k, usize.toI32(count - 1 - i)) { run self.release(v, at) } i = i + 1 }
      i = 0
      while i < values.length() { run self.push(values.get(i)) i = i + 1 }
      return true
    }
    i = 0
    while i < count { let v = self.pop() run self.release(v, at) i = i + 1 }
    if info.pushes == 0 { run self.release(r, at) } else { run self.push(r) }
    let next = pc + u8.toUsize(info.size)
    if (opcode == op.OP_fclosure || opcode == op.OP_fclosure8) && next < input.code.length() && byteAt(input, next) == op.OP_set_name
      && self.blockAt.get(next) == NONE { self.namedClosure = next }
    return true
  }

  // ---- calls (workstream H) ----

  /// A call through the engine's call entry: the callee, its receiver (undefined unless a
  /// method call) and arguments stay on the stack for the throw exit, then become the result.
  effect fn call(self: &mut Self, input: &FunctionInput, pc: usize) -> bool ! Refusal | OutOfMemoryError ? &mut Allocator {
    let opcode = byteAt(input, pc)
    let at = usize.toU32(pc)
    let mut count: usize = 0
    if opcode >= op.OP_call0 && opcode <= op.OP_call3 { count = u8.toUsize(opcode - op.OP_call0) }
    else { count = u16.toUsize(u16At(input, pc + 1)) }
    let maxArgs = if self.leaves { calls.MAX_ARGUMENTS } else { calls.MAX_COMPILED_ARGUMENTS }
    if count > u32.toUsize(maxArgs) { fail refuse(at, opcode, b"too many call arguments") }
    let method = opcode == op.OP_call_method
    // `new`: the function, then new.target in the receiver's place, then the arguments.
    let construct = opcode == op.OP_call_constructor
    let mut depth = count + 1
    if method || construct { depth = depth + 1 }
    if self.stack.length() < depth { fail refuse(at, opcode, b"call operands missing") }
    let mut function = self.top(count + 1)
    if construct { function = self.top(count + 2) }
    if self.f.value(function).ty != Type.Value { fail refuse(at, opcode, b"calling an unboxed number") }
    // Boxes come before the call.arg run, which must stay contiguous.
    let mut receiver = NONE
    if method { let given = self.top(count + 2) receiver = run self.boxed(given, at) }
    else if construct { let given = self.top(count + 1) receiver = run self.boxed(given, at) }
    else { receiver = run self.imm(Imm.Undefined, at) }
    if !construct && run self.inlined(input, function, receiver, method, count, at) { return true }
    if construct && run self.inlineConstruct(input, function, receiver, count, at) { return true }
    // A body's own call: code that can leave the body part way through makes it (its exit
    // names the body's frame, ssa.Exit.frames).
    if self.depth != 0 && (!self.leaves || self.lazyApply(method, count)) { fail refuse(at, opcode, b"a call inside an inlined body") }
    // `x.push(v)` and `x.pop()` by name: the array operation when the callee is the native.
    let mut native: i32 = 0
    let readPc = self.readOf(function)
    if method && self.leaves && readPc != NONE && u32.toUsize(readPc) + 5 <= input.code.length() {
      let at1 = u32.toUsize(readPc) + 1
      let atom = u8.toU32(byteAt(input, at1)) | u32.shiftLeft(u8.toU32(byteAt(input, at1 + 1)), 8) | u32.shiftLeft(u8.toU32(byteAt(input, at1 + 2)), 16) | u32.shiftLeft(u8.toU32(byteAt(input, at1 + 3)), 24)
      if atom != 0 && atom == self.arrayPush && count == 1 { native = calls.NATIVE_PUSH }
      else if atom != 0 && atom == self.arrayPop && count == 0 {
        // One that left before (at the function's own code; an inlined body that left is
        // not inlined again) is a plain one.
        native = if self.exits && (self.depth != 0 || !self.widened(at)) { calls.NATIVE_POP_QUIET } else { calls.NATIVE_POP }
      }
    }
    run self.plainCall(function, receiver, method, construct, count, at, native)
    return true
  }
  /// The pc of the `get.field` or `get.var` of this frame that produced constructor `function`,
  /// looking through `Retain` copies and single-source block parameters, or NONE.
  fn ctorReadOf(self: &Self, function: u32) -> u32 {
    let mut v = function
    let mut steps: u32 = 0
    while steps < 8 {
      let mut budget: u32 = 256
      v = self.sourceOf(v, 16, &mut budget)
      let info = self.f.value(v)
      if info.def == NONE { return NONE }
      let inst = self.f.inst(info.def)
      if inst.op == Op.Retain { v = inst.a steps = steps + 1 continue }
      if (inst.op == Op.GetField || inst.op == Op.GetVar) && inst.frame == self.f.frame { return inst.pc }
      return NONE
    }
    return NONE
  }
  /// Static truthiness of SSA value `v`: 0 (always falsy), 1 (always truthy), -1 (unknown).
  fn constTruth(self: &Self, v: u32) -> i32 {
    let info = self.f.value(v)
    if info.def == NONE { return -1 }
    let inst = self.f.inst(info.def)
    if inst.op == Op.ConstI32 { return if inst.k == 0 { 0 } else { 1 } }
    if inst.op == Op.ConstF64 && inst.k >= 0 && i32.toUsize(inst.k) < self.f.numbers.length() {
      let x = f64.fromBits(self.f.numbers.get(i32.toUsize(inst.k)))
      return if x == x && x != 0.0 { 1 } else { 0 }
    }
    if inst.op == Op.Imm {
      if inst.k == u8.toI32(Imm.value(Imm.True)) { return 1 }
      if inst.k == u8.toI32(Imm.value(Imm.False)) || inst.k == u8.toI32(Imm.value(Imm.Undefined)) || inst.k == u8.toI32(Imm.value(Imm.Null)) { return 0 }
    }
    if inst.op == Op.Cmp && inst.k == u8.toI32(Cmp.value(Cmp.Ne)) {
      let da = self.f.value(inst.a).def
      let db = self.f.value(inst.b).def
      if da != NONE && db != NONE && self.f.inst(da).op == Op.ConstI32 && self.f.inst(db).op == Op.ConstI32 {
        return if self.f.inst(da).k != self.f.inst(db).k { 1 } else { 0 }
      }
    }
    return -1
  }
  /// Whether a `CONSTRUCT_PLAN_RECIPE` references `this` (`RECIPE_RECEIVER` or node slot 0).
  fn recipeUsesReceiver(self: &Self, t: ConstructTarget, stores: usize) -> bool {
    let nodeCount = u8.toUsize(t.nodeCount)
    let mut i: usize = 2
    while i < nodeCount && i < 32 {
      let word = t.nodes[i]
      let kind = word & 255
      if kind == RECIPE_RECEIVER { return true }
      let a = u32.toUsize(u32.shiftRight(word, 8) & 255) & 31
      if kind == RECIPE_NOT && a == 0 { return true }
      if kind >= RECIPE_SELECT {
        let b = u32.toUsize(u32.shiftRight(word, 16) & 255) & 31
        let c = u32.toUsize(u32.shiftRight(word, 24)) & 31
        if a == 0 || b == 0 || c == 0 { return true }
      }
      i = i + 1
    }
    let mut s: usize = 0
    while s < stores {
      if (u8.toUsize(t.roots[s]) & 31) == 0 { return true }
      s = s + 1
    }
    return false
  }
  /// Evaluates `condVal ? tVal : fVal` into a single merged value at `joinB`, keeping unboxed
  /// `I32`/`Bool`/`F64` (promoting mixed `I32`/`F64` via `Op.ToF64`) or boxing to `Type.Value`
  /// and appending any `Own.Owned` merge param to `temps`.
  effect fn recipeSelect(self: &mut Self, condVal: u32, tVal: u32, fVal: u32, at: u32, temps: &mut List<u32>) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ct = self.constTruth(condVal)
    if ct == 1 { return tVal }
    if ct == 0 { return fVal }
    let cond = run self.condition(condVal, at)
    let thenB = run self.f.block()
    let elseB = run self.f.block()
    let joinB = run self.f.block()
    let tTy = self.f.value(tVal).ty
    let fTy = self.f.value(fVal).ty
    let sameUnboxed = tTy == fTy && tTy != Type.Value
    let f64Mixed = (tTy == Type.F64 && fTy == Type.I32) || (tTy == Type.I32 && fTy == Type.F64)
    let bothImm = tTy == Type.Value && fTy == Type.Value && self.f.value(tVal).own == Own.Imm && self.f.value(fVal).own == Own.Imm
    let joinTy = if sameUnboxed { tTy } else if f64Mixed { Type.F64 } else { Type.Value }
    let joinOwn = if sameUnboxed || f64Mixed { Own.Unboxed } else if bothImm { Own.Imm } else { Own.Owned }
    let merged = run self.f.addParam(joinB, joinTy, joinOwn)
    let e1 = run self.f.newEdge(thenB)
    drop run self.f.newEdge(elseB)
    run self.f.terminate(self.current, Op.Branch, cond, e1, at)
    self.current = thenB
    let mut tArg = tVal
    if f64Mixed {
      if tTy == Type.I32 { tArg = run self.f.emit(self.current, Op.ToF64, true, Type.F64, Own.Unboxed, tArg, NONE, 0, at) }
    } else if !sameUnboxed && !bothImm {
      tArg = run self.boxed(tArg, at)
      if self.f.value(tArg).own != Own.Imm { tArg = run self.f.emit(self.current, Op.Retain, true, Type.Value, Own.Owned, tArg, NONE, 0, at) }
    }
    let jt = run self.f.newEdge(joinB)
    run self.f.edgeArgument(tArg)
    run self.f.terminate(thenB, Op.Jump, NONE, jt, at)
    self.current = elseB
    let mut fArg = fVal
    if f64Mixed {
      if fTy == Type.I32 { fArg = run self.f.emit(self.current, Op.ToF64, true, Type.F64, Own.Unboxed, fArg, NONE, 0, at) }
    } else if !sameUnboxed && !bothImm {
      fArg = run self.boxed(fArg, at)
      if self.f.value(fArg).own != Own.Imm { fArg = run self.f.emit(self.current, Op.Retain, true, Type.Value, Own.Owned, fArg, NONE, 0, at) }
    }
    let je = run self.f.newEdge(joinB)
    run self.f.edgeArgument(fArg)
    run self.f.terminate(elseB, Op.Jump, NONE, je, at)
    self.current = joinB
    if joinOwn == Own.Owned { run temps.append(merged) }
    return merged
  }
  /// Evaluates a `CONSTRUCT_PLAN_RECIPE` into `slotVals[0..stores]`, recording any `Own.Owned`
  /// intermediate merge parameters in `temps`.
  effect fn evalRecipe(self: &mut Self, t: ConstructTarget, obj: u32, count: usize, stores: usize, at: u32, temps: &mut List<u32>, slotVals: &mut List<u32>) -> () ! OutOfMemoryError ? &mut Allocator {
    let nodeCount = u8.toUsize(t.nodeCount)
    let mut usedInner: [bool; 32] = [false; 32]
    let mut i: usize = 2
    while i < nodeCount && i < 32 {
      let word = t.nodes[i]
      let kind = word & 255
      let a = u32.toUsize(u32.shiftRight(word, 8) & 255) & 31
      if kind == RECIPE_NOT { usedInner[a] = true }
      else if kind >= RECIPE_SELECT {
        let b = u32.toUsize(u32.shiftRight(word, 16) & 255) & 31
        let c = u32.toUsize(u32.shiftRight(word, 24)) & 31
        usedInner[a] = true usedInner[b] = true usedInner[c] = true
      }
      i = i + 1
    }
    let mut nodeVals: [u32; 32] = [NONE; 32]
    nodeVals[0] = obj
    nodeVals[1] = run self.imm(Imm.Undefined, at)
    i = 2
    while i < nodeCount && i < 32 {
      let word = t.nodes[i]
      let kind = word & 255
      let a = u32.toUsize(u32.shiftRight(word, 8) & 255) & 31
      if kind == RECIPE_ARG {
        nodeVals[i] = if a < count { self.top(count - a) } else { nodeVals[1] }
      } else if kind == RECIPE_CONST {
        let ck = t.constKinds[a & 15]
        let cb = t.constBits[a & 15]
        if ck == RCONST_UNDEF { nodeVals[i] = nodeVals[1] }
        else if ck == RCONST_NULL { nodeVals[i] = run self.imm(Imm.Null, at) }
        else if ck == RCONST_FALSE { nodeVals[i] = run self.constBool(false, at) }
        else if ck == RCONST_TRUE { nodeVals[i] = run self.constBool(true, at) }
        else if ck == RCONST_INT { nodeVals[i] = run self.constant(u32.wrappingToI32(u64.wrappingToU32(cb)), at) }
        else { nodeVals[i] = run self.doubleConstant(f64.fromBits(cb), at) }
      } else if kind == RECIPE_RECEIVER {
        nodeVals[i] = obj
      } else if kind == RECIPE_NOT {
        let ct = self.constTruth(nodeVals[a & 31])
        if ct >= 0 { nodeVals[i] = run self.constBool(ct == 0, at) }
        else {
          let cond = run self.condition(nodeVals[a & 31], at)
          nodeVals[i] = run self.f.emit(self.current, Op.NotBool, true, Type.Bool, Own.Unboxed, cond, NONE, 0, at)
        }
      } else if usedInner[i] {
        let tVal = nodeVals[u32.toUsize(u32.shiftRight(word, 16) & 255) & 31]
        let fVal = nodeVals[u32.toUsize(u32.shiftRight(word, 24)) & 31]
        nodeVals[i] = run self.recipeSelect(nodeVals[a & 31], tVal, fVal, at, &mut temps)
      }
      i = i + 1
    }
    let mut s: usize = 0
    while s < stores {
      let r = u8.toUsize(t.roots[s]) & 31
      if r < nodeCount && (t.nodes[r] & 255) >= RECIPE_SELECT && nodeVals[r] == NONE {
        let word = t.nodes[r]
        let condNode = u32.toUsize(u32.shiftRight(word, 8) & 255) & 31
        let tNode = u32.toUsize(u32.shiftRight(word, 16) & 255) & 31
        let fNode = u32.toUsize(u32.shiftRight(word, 24)) & 31
        nodeVals[r] = run self.recipeSelect(nodeVals[condNode], nodeVals[tNode], nodeVals[fNode], at, &mut temps)
      }
      run slotVals.append(nodeVals[r])
      s = s + 1
    }
  }
  /// Inlines a planned `new C(...)` site as `Op.NewObject` (the sole exit, at `at`) followed
  /// by unconditional `Op.InitSlot` instructions (with zero exits). Returns true when handled.
  effect fn inlineConstruct(self: &mut Self, input: &FunctionInput, function: u32, receiver: u32, count: usize, at: u32) -> bool ! OutOfMemoryError ? &mut Allocator {
    if !self.leaves || input.constructs.length() == 0 || count > u32.toUsize(calls.MAX_COMPILED_ARGUMENTS) { return false }
    if self.depth == 0 {
      let mut s: usize = 0
      while s < self.doubleSites.length() { if self.doubleSites.get(s) == at { return false } s = s + 1 }
    }
    let readPc = self.ctorReadOf(function)
    if readPc == NONE { return false }
    let mut found = usize.MAX
    let mut idx: usize = 0
    while idx < input.constructs.length() {
      if input.constructs.get(idx).pc == readPc { found = idx break }
      idx = idx + 1
    }
    if found == usize.MAX { return false }
    let t = input.constructs.get(found)
    let stores = u8.toUsize(t.stores)
    if stores == 0 || stores > 8 { return false }
    run self.f.constructTargets.append(t.id)
    run self.f.constructShapes.append(t.shapeVersion)
    let siteIdx = usize.toI32(self.f.constructTargets.length() - 1)
    let obj = run self.f.emit(self.current, Op.NewObject, true, Type.Value, Own.Owned, function, receiver, siteIdx, at)
    let last = self.f.lastInst()
    run self.exitHere(last, at)
    // Evaluate receiver-free recipes before branching to slowBlock/initBlock so every slot
    // value dominates joinBlock (enabling own-slot field forwarding after joinBlock).
    let mut preTemps = List<u32>.make()
    let mut slotVals = List<u32>.make()
    let preEval = t.kind == CONSTRUCT_PLAN_RECIPE && !self.recipeUsesReceiver(t, stores)
    if preEval {
      run self.evalRecipe(t, obj, count, stores, at, &mut preTemps, &mut slotVals)
    }
    // Op.NewObject returns Undefined (code 3) when guards passed but no spare/recyclable
    // cell was ready: take slowBlock (SERVICE_CONSTRUCT via calls.PLANNED) without deopting.
    let isUndef = run self.f.emit(self.current, Op.TagIs, true, Type.Bool, Own.Unboxed, obj, NONE, 1, at)
    let slowBlock = run self.f.block()
    let initBlock = run self.f.block()
    let joinBlock = run self.f.block()
    let joined = run self.f.addParam(joinBlock, Type.Value, Own.Owned)
    let brEdge = run self.f.newEdge(slowBlock)
    drop run self.f.newEdge(initBlock)
    run self.f.terminate(self.current, Op.Branch, isUndef, brEdge, at)
    self.current = initBlock
    let mut initTemps = List<u32>.make()
    if t.kind == CONSTRUCT_PLAN_STORES {
      let mut s: usize = 0
      while s < stores {
        let src = u8.toUsize(t.sources[s])
        let val = if src < count { self.top(count - src) } else { run self.imm(Imm.Undefined, at) }
        drop run self.f.emit(self.current, Op.InitSlot, false, Type.I32, Own.Unboxed, obj, val, usize.toI32(s), at)
        s = s + 1
      }
    } else if preEval {
      let mut s: usize = 0
      while s < stores {
        drop run self.f.emit(self.current, Op.InitSlot, false, Type.I32, Own.Unboxed, obj, slotVals.get(s), usize.toI32(s), at)
        s = s + 1
      }
    } else if t.kind == CONSTRUCT_PLAN_RECIPE {
      run self.evalRecipe(t, obj, count, stores, at, &mut initTemps, &mut slotVals)
      let mut s: usize = 0
      while s < stores {
        drop run self.f.emit(self.current, Op.InitSlot, false, Type.I32, Own.Unboxed, obj, slotVals.get(s), usize.toI32(s), at)
        s = s + 1
      }
    }
    let mut tm: usize = 0
    while tm < preTemps.length() { run self.release(preTemps.get(tm), at) tm = tm + 1 }
    tm = 0
    while tm < initTemps.length() { run self.release(initTemps.get(tm), at) tm = tm + 1 }
    let jFast = run self.f.newEdge(joinBlock)
    run self.f.edgeArgument(obj)
    run self.f.terminate(self.current, Op.Jump, NONE, jFast, at)
    self.current = slowBlock
    run self.release(obj, at)
    tm = 0
    while tm < preTemps.length() { run self.release(preTemps.get(tm), at) tm = tm + 1 }
    let mut ci: usize = 0
    while ci < count {
      let argument = self.top(count - ci)
      drop run self.f.emit(self.current, Op.CallArg, false, Type.I32, Own.Unboxed, argument, NONE, usize.toI32(ci), at)
      ci = ci + 1
    }
    let slowObj = run self.f.emit(self.current, Op.Call, true, Type.Value, Own.Owned, function, receiver, usize.toI32(count) | calls.CONSTRUCT | calls.PLANNED, at)
    let slowLast = self.f.lastInst()
    run self.exitHere(slowLast, at)
    let jSlow = run self.f.newEdge(joinBlock)
    run self.f.edgeArgument(slowObj)
    run self.f.terminate(self.current, Op.Jump, NONE, jSlow, at)
    self.current = joinBlock
    let depth = count + 2
    let mut p: usize = 0
    while p < depth { let v = self.pop() run self.release(v, at) p = p + 1 }
    run self.push(joined)
    return true
  }
  /// The call at `pc` of `function` with the `count` operands on the stack as arguments (and
  /// `receiver`, or new.target for a `new`): the operands go, the result takes their place.
  effect fn plainCall(self: &mut Self, function: u32, receiver: u32, method: bool, construct: bool, count: usize, at: u32, native: i32) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut depth = count + 1
    if method || construct { depth = depth + 1 }
    let mut i: usize = 0
    while i < count {
      let argument = self.top(count - i)
      drop run self.f.emit(self.current, Op.CallArg, false, Type.I32, Own.Unboxed, argument, NONE, usize.toI32(i), at)
      i = i + 1
    }
    let mut k = usize.toI32(count)
    if construct { k = k | calls.CONSTRUCT }
    if self.depth == 0 && self.widened(at) { k = k | calls.ALWAYS }
    if self.depth != 0 && method { k = k | calls.METHOD }
    if self.lazyApply(method, count) { k = k | calls.LAZY_ARGUMENTS }
    else { k = k | i32.shiftLeft(native, calls.NATIVE_SHIFT) }
    let r = run self.f.emit(self.current, Op.Call, true, Type.Value, Own.Owned, function, receiver, k, at)
    let last = self.f.lastInst() run self.exitHere(last, at)
    i = 0
    while i < depth { let v = self.pop() run self.release(v, at) i = i + 1 }
    run self.push(r)
  }

  // ---- inlining (docs/jit/inlining.md) ----

  /// The pc of the cached field read of this code that made `function`, or NONE.
  fn readOf(self: &Self, function: u32) -> u32 {
    let mut budget: u32 = 256
    let info = self.f.value(self.sourceOf(function, 16, &mut budget))
    if info.def != NONE {
      let read = self.f.inst(info.def)
      if read.op == Op.GetField && (read.k & 1) == FIELD_CACHED && read.frame == self.f.frame { return read.pc }
    }
    return NONE
  }
  /// `v`, or the value every edge into it passes when it is a block parameter that only
  /// carries one value on (the state of an inlined call's arms where they meet keeps the
  /// operands below the call as they were, through the blocks of each arm's body), as far
  /// as `depth` more parameters and `budget` parameters looked at in all.
  fn sourceOf(self: &Self, v: u32, depth: u32, budget: &mut u32) -> u32 {
    let info = self.f.value(v)
    if info.def != NONE || depth == 0 || budget.* == 0 { return v }
    budget.* = budget.* - 1
    let block = self.f.blocks.get(u32.toUsize(info.block))
    let mut g: u32 = 0
    while g < block.paramCount && self.f.paramAt(block, g) != v { g = g + 1 }
    if g == block.paramCount { return v }
    let mut only = NONE
    let mut e: usize = 0
    while e < self.f.edges.length() {
      let edge = self.f.edges.get(e)
      e = e + 1
      if edge.target != info.block || g >= edge.argCount { continue }
      let arg = self.f.edgeArg(edge, g)
      if arg == v { continue }
      let from = self.sourceOf(arg, depth - 1, &mut budget)
      if only == NONE { only = from } else if only != from { return v }
    }
    if only == NONE { return v }
    return only
  }
  /// The index in `input.targets` of what the method call of `function` (the value a cached
  /// field read of this code made) may inline, or usize.MAX.
  fn inlineTarget(self: &mut Self, input: &FunctionInput, function: u32, pc: u32, count: usize) -> usize {
    self.missed = b"the inlining limits"
    if self.depth >= MAX_INLINE_DEPTH || self.f.inlineTargets.length() >= MAX_INLINE_SITES { return usize.MAX }
    // A call that left compiled code before (a deopt recorded at its pc) is not inlined
    // again, unless its targets are chained: a callee none of them is is then called, not
    // left for.
    let mut left = false
    if self.depth == 0 {
      let mut s: usize = 0
      while s < self.doubleSites.length() { if self.doubleSites.get(s) == pc { left = true } s = s + 1 }
    }
    // The recorded target of this call, else what the site cache of its get_field2 names.
    let readPc = self.readOf(function)
    let mut pass: u32 = 0
    let mut t: usize = 0
    while pass < 2 {
     t = 0
     while t < input.targets.length() {
      let target = &input.targets.asSlice()[t]
      if (pass == 0 && target.atCall && target.pc == pc) || (pass == 1 && !target.atCall && readPc != NONE && target.pc == readPc) {
        let callee = &target.input
        self.missed = b"a deopt at this call before"
        if left && !target.chained { return usize.MAX }
        self.missed = b"the target captures variables or has a scope"
        if !callee.normal || callee.closureVars != 0 || callee.scopeSlots != 0 { return usize.MAX }
        self.missed = b"the target is too long"
        if callee.code.length() == 0 || callee.code.length() > MAX_INLINE_BYTES { return usize.MAX }
        // An inlined store tests the one shape its site last met and leaves on another:
        // the call is made, and the target's own code stores the general way.
        self.missed = b"a field store of the target is noted"
        if storeNoted(callee) { return usize.MAX }
        if !self.affords(input, pc, callee, count) { return usize.MAX }
        return t
      }
      t = t + 1
     }
     pass = pass + 1
    }
    self.missed = b"no target known for the site"
    return usize.MAX
  }

  /// Whether `callee` may be inlined at the call at `pc` of `input`, whose `count` arguments
  /// are on the stack (MAX_INLINED_BYTES); sets `missed` when not.
  fn affords(self: &mut Self, input: &FunctionInput, pc: u32, callee: &FunctionInput, count: usize) -> bool {
    let bytes = callee.code.length()
    if bytes <= INLINE_SMALL || self.turning || insideLoop(input, pc) { return true }
    self.missed = b"the function's inlined bodies are at their limit"
    if self.inlinedBytes + bytes > MAX_INLINED_BYTES { return false }
    if !loops(callee) { return true }
    self.missed = b"the target loops and the call is in no loop"
    let mut n: usize = 1
    while n <= count && n <= self.stack.length() {
      let info = self.f.value(self.top(n))
      if info.def != NONE {
        let made = self.f.inst(info.def).op
        if made == Op.ConstI32 || made == Op.ConstF64 || made == Op.Imm { return true }
      }
      n = n + 1
    }
    return false
  }

  /// Translates the method call at `pc` of `function` with `count` arguments as the body of
  /// the function its site last called, guarded by that function's identity, when it can:
  /// true, with the operands replaced by the result. False with nothing changed otherwise.
  effect fn inlined(self: &mut Self, input: &FunctionInput, function: u32, receiver: u32, method: bool, count: usize, pc: u32) -> bool ! OutOfMemoryError ? &mut Allocator {
    // The engine applies f to the frame's own arguments (calls.LAZY_ARGUMENTS).
    if self.lazyApply(method, count) { return false }
    // receiver is the boxed operand; the body reads the operand itself.
    if method && receiver == NONE { return false }
    let t = self.inlineTarget(input, function, pc, count)
    if t == usize.MAX { run self.f.inlineMisses.append(InlineMiss { pc: pc, depth: self.depth, opcode: 0, why: self.missed }) return false }
    if input.targets.asSlice()[t].chained { return run self.callChain(input, method, count, pc) }
    return run self.inlineOne(input, t, function, receiver, method, count, pc, true)
  }

  /// A call whose site calls several functions (CallTarget.chained), with the operands on the
  /// stack: each known target that can be inlined gets a test of the callee's identity and
  /// its body in a block of its own, and the call itself is made when the callee is none
  /// of them; the results meet in a new block. False with nothing changed when no target's
  /// body could be inlined.
  effect fn callChain(self: &mut Self, input: &FunctionInput, method: bool, count: usize, pc: u32) -> bool ! OutOfMemoryError ? &mut Allocator {
    // The call that is the last arm leaves a body with its frames.
    if !self.leaves { return false }
    let readPc = self.readOf(self.top(count + 1))
    let mut join = NONE
    let mut lastK: i32 = 0
    let mut t: usize = 0
    while t < input.targets.length() {
      let target = &input.targets.asSlice()[t]
      let here = t
      t = t + 1
      if target.atCall || !target.chained || target.pc != readPc { continue }
      if self.depth >= MAX_INLINE_DEPTH || self.f.inlineTargets.length() >= MAX_INLINE_SITES { break }
      let callee = &target.input
      if !callee.normal || callee.closureVars != 0 || callee.scopeSlots != 0 || callee.code.length() == 0 || callee.code.length() > MAX_INLINE_BYTES { continue }
      if !self.affords(input, pc, callee, count) { continue }
      let mark = self.f.mark()
      let savedCurrent = self.current
      let savedLocals = run copyList(&self.locals)
      let savedStack = run copyList(&self.stack)
      let savedHeld = run copyList(&self.held)
      let k = usize.toI32(self.f.inlineTargets.length())
      // Boxes first: only the test's flags are between it and the branch then.
      run self.boxState(pc)
      let tested = self.top(count + 1)
      let test = run self.f.emit(self.current, Op.IsCallee, true, Type.Bool, Own.Unboxed, tested, NONE, k, pc)
      let hit = run self.stateBlock()
      let miss = run self.stateBlock()
      run self.branchTo(test, hit, miss, pc)
      run self.adoptState(hit, pc)
      let function = self.top(count + 1)
      let mut receiver = NONE
      if method { receiver = self.top(count + 2) } else { receiver = run self.imm(Imm.Undefined, pc) }
      // A method known for one receiver shape: the arm is for that shape, which the shape
      // dispatch of the read proved already (x64_backend.knownArms) and the test proves on
      // the general path; the body's reads of the receiver then know it (ssa_shapes).
      let known = target.known
      if method && self.exits && known.shapes[0] != 0 && known.shapes[1] == 0 && known.shapes[0] < 2147483648 {
        drop run self.f.emit(self.current, Op.CheckShape, false, Type.I32, Own.Unboxed, receiver, NONE, u32.wrappingToI32(known.shapes[0]), pc)
        let guarded = self.f.lastInst() run self.exitHere(guarded, pc)
      }
      if run self.inlineOne(input, here, function, receiver, method, count, pc, false) {
        lastK = k
        if join == NONE { join = run self.stateBlock() }
        run self.jumpInto(join, pc)
        run self.adoptState(miss, pc)
      } else {
        self.f.rollback(mark)
        self.current = savedCurrent
        self.locals = move savedLocals
        self.stack = move savedStack
        self.held = move savedHeld
      }
    }
    if join == NONE { return false }
    let function = self.top(count + 1)
    if self.exits && (self.depth != 0 || !self.widened(pc)) && insideLoop(input, pc) {
      // No other callee was seen here, so in a loop another one leaves (the last target's
      // test fails again): the code is compiled again with the call (widened; in an inlined
      // body's loop, with the outermost call not inlined, as after any exit there), and
      // until then the loop holds no call (ssa_opt_hoist).
      drop run self.f.emit(self.current, Op.CheckCallee, false, Type.I32, Own.Unboxed, function, NONE, lastK, pc)
      let guarded = self.f.lastInst() run self.exitHere(guarded, pc)
      // Not reached: the operands go and the state the join takes is made up.
      let mut depth = count + 1
      if method { depth = depth + 1 }
      let mut i: usize = 0
      while i < depth { let v = self.pop() run self.release(v, pc) i = i + 1 }
      let none = run self.imm(Imm.Undefined, pc)
      run self.push(none)
      run self.jumpInto(join, pc)
      run self.adoptState(join, pc)
      return true
    }
    let mut receiver = NONE
    if method { receiver = self.top(count + 2) } else { receiver = run self.imm(Imm.Undefined, pc) }
    run self.plainCall(function, receiver, method, false, count, pc, 0)
    run self.jumpInto(join, pc)
    run self.adoptState(join, pc)
    return true
  }
  /// Boxes the state where it is: what an edge would do (edgeTo), ahead of it.
  effect fn boxState(self: &mut Self, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    if self.depth != 0 { while i < self.held.length() { let v = self.held.get(i) let b = run self.boxed(v, pc) self.held.set(i, b) i = i + 1 } }
    i = 0
    while i < self.locals.length() { let v = self.locals.get(i) let b = run self.boxed(v, pc) self.locals.set(i, b) i = i + 1 }
    i = 0
    while i < self.stack.length() { let v = self.stack.get(i) let b = run self.boxed(v, pc) self.stack.set(i, b) i = i + 1 }
  }
  /// Ends the current block with a jump to `block`, which takes the whole state (stateBlock).
  effect fn jumpInto(self: &mut Self, block: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.jumpOn(block, pc, EDGE_ALONE)
  }
  /// Starts filling `block`, which the current block's state is passed to as it is (stateBlock):
  /// a local that was proven initialized still is.
  effect fn adoptState(self: &mut Self, block: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut proven = List<bool>.make()
    let mut i: usize = 0
    while i < self.locals.length() {
      let v = u32.toUsize(self.locals.get(i))
      run proven.append(v < self.initialized.length() && self.initialized.get(v))
      i = i + 1
    }
    run self.adopt(block, 0, pc)
    i = 0
    while i < self.locals.length() && i < proven.length() { if proven.get(i) { let v = self.locals.get(i) run self.markInitialized(v) } i = i + 1 }
  }

  /// inlined for target `t` of `input.targets`. `guard`: the callee's identity is tested here,
  /// with an exit; otherwise the block is one only that function's calls reach.
  effect fn inlineOne(self: &mut Self, input: &FunctionInput, t: usize, function: u32, receiver: u32, method: bool, count: usize, pc: u32, guard: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
    let target = &input.targets.asSlice()[t]
    let mark = self.f.mark()
    let outer = self.depth
    // A body at a call in a loop, and the bodies inside it, count nothing (MAX_INLINED_BYTES).
    let spent = self.inlinedBytes
    let turning = self.turning
    self.turning = turning || insideLoop(input, pc)
    if !self.turning { self.inlinedBytes = spent + target.input.code.length() }
    let savedCurrent = self.current
    let savedLocals = run copyList(&self.locals)
    let savedStack = run copyList(&self.stack)
    let savedHeld = run copyList(&self.held)
    let savedWrites = self.paramWrites
    if outer == 0 {
      self.held.clear()
      self.rootPc = pc
      self.rootDepth = self.stack.length()
      self.rootInst = self.f.insts.length()
      self.broken = false
      self.paramWrites = false
    }
    // A local of the calling code that is dead at the call (Liveness) and holds no count
    // (a number, a borrow) is undefined from here on: its value would otherwise live
    // through the body for the body's exits alone, which write the caller's frame as it is
    // at the call, and keep a register from the body's own loop. A value that holds a
    // count stays: a copy of it among the call's operands borrows from the local while the
    // local lives (ssa_ownership.borrowFields) and would be a count of its own from here,
    // which cost Richards 8% of its compiled code's instructions. A failed attempt gets
    // the saved locals.
    let mut dying: usize = 0
    let mut gone = NONE
    while dying < self.locals.length() {
      let own = self.f.value(self.locals.get(dying)).own
      if !self.lazyLocal(dying) && (own == Own.Unboxed || own == Own.Borrowed) && self.deadAt(dying, u32.toUsize(pc)) {
        if gone == NONE { gone = run self.imm(Imm.Undefined, pc) }
        self.locals.set(dying, gone)
      }
      dying = dying + 1
    }
    // The guard and the frame run for the caller: its exit is the caller's.
    let k = usize.toI32(self.f.inlineTargets.length())
    run self.f.inlineTargets.append(target.id)
    let mut readAt = NONE
    if !target.atCall { readAt = target.pc }
    run self.f.inlineSites.append(readAt)
    // A known local function called from code on the frame's own chain runs on that chain
    // too; its body may read its scope when the callee test here vouches for it.
    let chained = guard && self.ownChain && u32.bitAnd(target.id, TARGET_KNOWN_FN) != 0
    run self.f.inlineScoped.append(chained && readsScope(&target.input))
    run self.f.inlineShapes.append(target.known)
    if guard {
      drop run self.f.emit(self.current, Op.CheckCallee, false, Type.I32, Own.Unboxed, function, NONE, k, pc)
      let guarded = self.f.lastInst() run self.exitHere(guarded, pc)
    }
    drop run self.f.emit(self.current, Op.InlineFrame, false, Type.I32, Own.Unboxed, function, NONE, k, pc)
    // Into the body: the caller's state is held, its operands are the arguments.
    let heldBefore = self.held.length()
    run self.held.appendSlice(self.locals.asSlice()) run self.held.appendSlice(savedStack.asSlice())
    let outerBase = self.argsBase
    let outerCount = self.argCount
    let outerReceiver = self.receiverAt
    let outerFormals = self.formals
    let outerFrame = self.f.frame
    let outerSites = Intrinsic.replace(self.doubleSites, run copyList(&target.input.doubleSites))
    let outerBlocks = Intrinsic.replace(self.blockAt, List<u32>.make())
    self.argsBase = self.held.length() - count
    self.argCount = count
    self.receiverAt = usize.MAX
    if method { self.receiverAt = self.held.length() - count - 2 }
    run self.frames.append(i32.toUsize(k)) run self.frames.append(self.held.length() - count - 1)
    run self.calls.append(InlineCall { pc: pc, after: pc + usize.toU32(sizeAt(input, u32.toUsize(pc))), argc: usize.toU32(count), method: method,
      start: heldBefore, locals: savedLocals.length(), stack: savedStack.length() })
    self.formals = target.input.argumentCount
    self.f.frame = i32.wrappingToU32(k) + 1
    self.depth = outer + 1
    self.locals.clear() self.stack.clear()
    let outerLoops = self.bodyLoops
    let outerChain = self.ownChain
    self.ownChain = chained
    let outerOwned = self.ownedCells
    self.ownedCells = target.owned
    let mut cell: usize = 0
    while cell < target.cells.length() {
      if target.cells.get(cell) != 0 {
        run self.f.cellCodes.append(u32.bitOr(u32.shiftLeft(self.f.frame, 16), usize.toU32(cell)))
        run self.f.cellAddresses.append(target.cells.get(cell))
      }
      cell = cell + 1
    }
    let bodyLiveness = run livenessOf(&target.input)
    let outerLiveness = Intrinsic.replace(self.liveness, move bodyLiveness)
    let outcome = run Effect.result(self.inlineBody(&target.input, pc))
    self.turning = turning
    self.liveness = move outerLiveness
    self.ownedCells = outerOwned
    self.bodyLoops = outerLoops
    self.ownChain = outerChain
    self.depth = outer
    self.f.frame = outerFrame
    self.argsBase = outerBase
    self.argCount = outerCount
    self.receiverAt = outerReceiver
    self.formals = outerFormals
    self.doubleSites = move outerSites
    self.blockAt = move outerBlocks
    let frameCount = self.frames.length() - 2
    self.frames.truncate(frameCount)
    self.calls.truncate(u32.toUsize(outer))
    let mut why: &'static [u8] = b"a guard after an effect in the body"
    let mut stopped: u8 = 0
    let result = match move outcome {
      Result<u32, Refusal | OutOfMemoryError>.Success { value } => value
      Result<u32, Refusal | OutOfMemoryError>.Failure { error } => {
        match move error {
          Refusal { reason, opcode, .. } => { why = reason stopped = opcode NONE }
          OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
        }
      }
    }
    if result == NONE || self.broken {
      // Nothing of the attempt stays; an attempt around this one fails with it.
      self.f.rollback(mark)
      self.current = savedCurrent
      self.locals = move savedLocals
      self.stack = move savedStack
      self.held = move savedHeld
      self.paramWrites = savedWrites
      self.inlinedBytes = spent
      run self.f.inlineMisses.append(InlineMiss { pc: pc, depth: self.depth, opcode: stopped, why: why })
      return false
    }
    // The caller's state as the block the body ended in has it.
    self.locals.clear() self.stack.clear()
    let mut i: usize = 0
    while i < savedLocals.length() { run self.locals.append(self.held.get(heldBefore + i)) i = i + 1 }
    i = 0
    while i < savedStack.length() { run self.stack.append(self.held.get(heldBefore + savedLocals.length() + i)) i = i + 1 }
    self.held.truncate(heldBefore)
    // The call's operands (function, a method's receiver, arguments) go, the result takes
    // their place.
    let mut operands = count + 1
    if method { operands = operands + 1 }
    i = 0
    while i < operands { let v = self.pop() run self.release(v, pc) i = i + 1 }
    run self.push(result)
    return true
  }

  /// The body of an inlined function, up to its return, whose value this returns (owned by
  /// the caller from here, or unboxed). Straight-line code stays in the caller's block. Code
  /// with forward branches gets a block per leader and one where its returns meet, each
  /// taking the frames around the body before its own state; the returned value is that
  /// block's last parameter.
  effect fn inlineBody(self: &mut Self, callee: &FunctionInput, callPc: u32) -> u32 ! Refusal | OutOfMemoryError ? &mut Allocator {
    // Validates the code as the function's own is: sizes, operand stack depths.
    let shapeOf = run shape(callee)
    let undefined = run self.imm(Imm.Undefined, callPc)
    let mut l: u32 = 0
    while l < callee.localCount { run self.locals.append(undefined) l = l + 1 }
    let length = callee.code.length()
    run self.blockAt.appendRepeated(NONE, length + 1)
    let mut leaders: usize = 0
    let mut looped = false
    let mut jumpToZero = false
    let mut pc: usize = 0
    while pc < length {
      if shapeOf.start.get(pc) {
        let opcode = byteAt(callee, pc)
        if isBranch(opcode) || isGoto(opcode) {
          let tgt = targetOf(callee, pc)
          if tgt == 0 { jumpToZero = true }
          if tgt <= usize.toI64(pc) {
            // A loop's poll and every guard in a body with one leave with the bodies' frames.
            if !self.leaves { fail refuse(usize.toU32(pc), opcode, b"a loop in an inlined body") }
            looped = true
          }
        }
        if pc != 0 && shapeOf.leader.get(pc) { leaders = leaders + 1 }
      }
      pc = pc + 1
    }
    if jumpToZero { leaders = leaders + 1 }
    if leaders > INLINE_BLOCKS { fail refuse(0, 0, b"too many branches in an inlined body") }
    if looped { self.bodyLoops = self.bodyLoops + 1 }
    let mut meet = NONE
    if leaders != 0 {
      if jumpToZero {
        let b0 = run self.f.block()
        self.blockAt.set(0, b0)
        run self.setLeader(b0, 0)
        let count0 = self.held.length() + u32.toUsize(callee.localCount) + i32.toUsize(shapeOf.depth.get(0))
        let mut i0: usize = 0
        while i0 < count0 { drop run self.f.addParam(b0, Type.Value, Own.Owned) i0 = i0 + 1 }
      }
      pc = 1
      while pc < length {
        if shapeOf.leader.get(pc) && shapeOf.start.get(pc) {
          let b = run self.f.block()
          self.blockAt.set(pc, b)
          run self.setLeader(b, usize.toU32(pc))
          let count = self.held.length() + u32.toUsize(callee.localCount) + i32.toUsize(shapeOf.depth.get(pc))
          let mut i: usize = 0
          while i < count { drop run self.f.addParam(b, Type.Value, Own.Owned) i = i + 1 }
        }
        pc = pc + 1
      }
      meet = run self.f.block()
      let mut i: usize = 0
      while i < self.held.length() + 1 { drop run self.f.addParam(meet, Type.Value, Own.Owned) i = i + 1 }
      if jumpToZero {
        let entryBlock = self.blockAt.get(0)
        run self.jumpOn(entryBlock, callPc, EDGE_ALONE)
        run self.enter(0)
      }
    }
    let mut at: usize = 0
    let mut previous: usize = 0
    let mut open = true
    let mut met = false
    while at < length {
      if at != 0 && shapeOf.leader.get(at) && shapeOf.start.get(at) {
        // Falling through into the next block, from the instruction before it.
        if open { run self.jumpTo(at, usize.toU32(previous)) }
        run self.enter(at)
        open = true
      }
      // Code nothing reaches, up to the next leader.
      if !open { at = at + 1 continue }
      let opcode = byteAt(callee, at)
      let here = usize.toU32(at)
      let scopeRead = opcode == op.OP_get_scope0 || opcode == op.OP_get_scope0_check
      if !inlinable(opcode) && !(scopeRead && self.ownChain) { fail refuse(here, opcode, b"an opcode an inlined body cannot have") }
      if isReturn(opcode) {
        let mut v = NONE
        if opcode == op.OP_return { v = self.pop() }
        run self.releaseAll(here)
        if opcode == op.OP_return_undef { v = run self.imm(Imm.Undefined, here) }
        if meet == NONE { return v }
        let result = run self.boxed(v, here)
        let around = run self.heldBoxed(here)
        let edge = run self.f.newEdge(meet)
        let mut i: usize = 0
        while i < around.length() { run self.f.edgeArgument(around.get(i)) i = i + 1 }
        run self.f.edgeArgument(result)
        run self.f.terminate(self.current, Op.Jump, NONE, edge, here)
        met = true
        open = false
      } else if isThrow(opcode) {
        if !self.leaves { fail refuse(here, opcode, b"throw in an inlined body") }
        let u = run self.imm(Imm.Undefined, here)
        drop run self.f.emit(self.current, Op.Unbox, true, Type.I32, Own.Unboxed, u, NONE, 0, here)
        let last = self.f.lastInst() run self.exitHere(last, here)
        run self.releaseAll(here)
        let undef = run self.imm(Imm.Undefined, here)
        if meet == NONE { return undef }
        // Op.Unbox(Undefined) exits unconditionally; end this unreachable block with
        // Op.Return(undef) instead of a fake edge into `meet` so single-return callees
        // keep direct dominance and known shapes into the caller.
        let mut i: usize = 0
        while i < self.held.length() { let v = self.held.get(i) run self.release(v, here) i = i + 1 }
        run self.f.terminate(self.current, Op.Return, undef, NONE, here)
        open = false
      } else {
        open = run self.instruction(callee, at)
      }
      if self.broken { fail refuse(here, opcode, b"a guard after an effect in an inlined body") }
      previous = at
      at = at + sizeAt(callee, at)
    }
    if open || meet == NONE || !met { fail refuse(usize.toU32(length), 0, b"control falls off the end of the code") }
    // Where the returns meet: the frames around, then the value. The body's own frame is over.
    self.locals.clear()
    run self.adopt(meet, 1, callPc)
    return self.pop()
  }

  // ---- objects (workstream J) ----

  /// A guard that `v` has engine tag `tag`, exiting at `pc` with the current state.
  effect fn checkTag(self: &mut Self, v: u32, tag: i32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    drop run self.f.emit(self.current, Op.CheckTag, false, Type.I32, Own.Unboxed, v, NONE, tag, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
  }
  /// The constant a watched record holds where the keyed read at `pc` of `input` reads
  /// `object`: the site's key names an own slot of a shape a record has or had (RecordSlot),
  /// and guards that `object` is of the record's shape now (its own, so it is the record)
  /// and still watched come first. NONE when no record slot is named.
  effect fn recordConstant(self: &mut Self, input: &FunctionInput, object: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    if !self.exits || self.records.length() == 0 { return NONE }
    let key = inlineKey(input, pc)
    // An own key: the shape's version above the slot, nothing in the top bit.
    let version = u64.shiftRight(key, 16)
    if version == 0 || version >= 2147483648 { return NONE }
    let slot = u64.wrappingToU32(key & 65535)
    let mut i: usize = 0
    while i < self.records.length() {
      let r = self.records.get(i)
      i = i + 1
      if r.slot != slot || (u32.toU64(r.before) != version && u32.toU64(r.version) != version) { continue }
      drop run self.f.emit(self.current, Op.CheckShape, false, Type.I32, Own.Unboxed, object, NONE, u32.wrappingToI32(r.version), pc)
      let shaped = self.f.lastInst() run self.exitHere(shaped, pc)
      drop run self.f.emit(self.current, Op.CheckWatched, false, Type.I32, Own.Unboxed, object, NONE, 0, pc)
      let watched = self.f.lastInst() run self.exitHere(watched, pc)
      if r.kind == inline.RECORD_INT { return run self.constant(r.value, pc) }
      if r.kind == inline.RECORD_BOOL { return run self.constBool(r.value != 0, pc) }
      if r.kind == inline.RECORD_NULL { return run self.imm(Imm.Null, pc) }
      return run self.imm(Imm.Undefined, pc)
    }
    return NONE
  }
  /// The named property the instruction at `pc` reads from `object`, owned.
  effect fn getField(self: &mut Self, input: &FunctionInput, object: u32, how: i32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let mut k = how
    run self.f.nameField(pc, u32At4(input, u32.toUsize(pc) + 1))
    // It left compiled code before: whatever the helper declines is stepped (FIELD_STEPS).
    if self.exits && self.depth == 0 && self.widened(pc) { k = k | FIELD_STEPS }
    else if how == FIELD_CACHED && self.leaves && self.exits && self.depth == 0 && unseenRead(input, pc) { k = k | FIELD_LEARN }
    let r = run self.f.emit(self.current, Op.GetField, true, Type.Value, Own.Owned, object, NONE, k, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  /// The named property store of the instruction at `pc` of `value` into `object`.
  effect fn putField(self: &mut Self, input: &FunctionInput, object: u32, value: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let bits = run self.boxed(value, pc)
    if self.exits && self.depth == 0 && (self.widened(pc) || addSite(input, pc, self.addKey)) {
      // It deoptimized before (an add, a setter), or it adds: a call exit runs what the
      // helper cannot. An add the site's memo does not cover (another starting shape, as
      // a constructor run for several subclasses meets) is stepped instead of leaving.
      let r = run self.f.emit(self.current, Op.Call, true, Type.Value, Own.Owned, object, bits, calls.kAt(0, compiled.SITE_PUT_FIELD), pc)
      let last = self.f.lastInst() run self.exitHere(last, pc)
      run self.release(r, pc)
      return ()
    }
    run self.f.nameField(pc, u32At4(input, u32.toUsize(pc) + 1))
    drop run self.f.emit(self.current, Op.PutField, false, Type.I32, Own.Unboxed, object, bits, 1, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
  }
  /// Whether the element read at `pc` left code that read it by key too (named twice in the
  /// sites): on a baseline frame the interpreter runs it from then on.
  fn keyedStep(self: &Self, pc: u32) -> bool { return self.leaves && self.exits && self.depth == 0 && self.stepped(pc) }
  /// Element `index` of `object` for the instruction at `pc`, owned; refuses a boolean index.
  effect fn getElem(self: &mut Self, object: u32, index: u32, pc: u32, opcode: u8) -> u32 ! Refusal | OutOfMemoryError ? &mut Allocator {
    if self.f.value(object).ty != Type.Value { fail refuse(pc, opcode, b"an element of an unboxed number") }
    if self.depth == 0 && (self.f.elementKindAt(pc) == u8.toU32(feedback.ELEMENT_ORDINARY)
      || (self.f.value(index).ty == Type.Value && self.widened(pc))) {
      let key = run self.boxed(index, pc)
      // It left before: on a baseline frame what the engine declines is stepped.
      let mut k: i32 = 0
      if self.leaves && self.exits && self.widened(pc) { k = ELEM_STEPS }
      let result = run self.f.emit(self.current, Op.GetKey, true, Type.Value, Own.Owned, object, key, k, pc)
      let at = self.f.lastInst() run self.exitHere(at, pc)
      return result
    }
    // An inlined body's read that baseline code noted in the callee (a slow Array, an
    // ordinary object: jit_runtime.calleeDoubleSites): by key through the engine's read,
    // which leaves the code where it declines, instead of an index guess that leaves on
    // every call.
    if self.depth != 0 && self.leaves && self.exits && self.widened(pc) {
      let key = run self.boxed(index, pc)
      let result = run self.f.emit(self.current, Op.GetKey, true, Type.Value, Own.Owned, object, key, 0, pc)
      let at = self.f.lastInst() run self.exitHere(at, pc)
      return result
    }
    let x = run self.int(index, pc)
    if x == NONE { fail refuse(pc, opcode, b"a boolean index") }
    // It left before: on a baseline frame what the inline read and the helper decline is
    // stepped (ELEM_STEPS).
    let mut k: i32 = 0
    if self.leaves && self.exits && self.depth == 0 && self.widened(pc) { k = ELEM_STEPS }
    let r = run self.f.emit(self.current, Op.GetElem, true, Type.Value, Own.Owned, object, x, k, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  effect fn getLength(self: &mut Self, object: u32, pc: u32, opcode: u8) -> u32 ! Refusal | OutOfMemoryError ? &mut Allocator {
    if self.f.value(object).ty != Type.Value { fail refuse(pc, opcode, b"the length of an unboxed number") }
    // It left compiled code before: on a baseline frame what the helpers decline (a getter,
    // a proxy) is stepped (FIELD_STEPS).
    let mut k: i32 = 0
    if self.leaves && self.exits && self.depth == 0 && self.widened(pc) { k = FIELD_STEPS }
    let r = run self.f.emit(self.current, Op.GetLength, true, Type.Value, Own.Owned, object, NONE, k, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  /// Local `index` or argument `index` (the fused element forms' operands).
  effect fn slotValue(self: &mut Self, argument: bool, index: usize, pc: u32, opcode: u8) -> u32 ! Refusal | OutOfMemoryError ? &mut Allocator {
    if argument {
      if index >= self.argumentLimit() { fail refuse(pc, opcode, b"argument index out of range") }
      return run self.parameterValue(usize.toU32(index), pc)
    }
    if index >= self.locals.length() { fail refuse(pc, opcode, b"local index out of range") }
    return self.locals.get(index)
  }
  effect fn object(self: &mut Self, input: &FunctionInput, pc: usize) -> bool ! Refusal | OutOfMemoryError ? &mut Allocator {
    let opcode = byteAt(input, pc)
    let at = usize.toU32(pc)
    if opcode == op.OP_push_this && self.depth != 0 {
      // The call's receiver operand, an object as below. A plain call's `this` depends on
      // the callee's mode: left to the interpreter.
      if self.receiverAt == usize.MAX { fail refuse(at, opcode, b"this in an inlined plain call") }
      let receiver = self.held.get(self.receiverAt)
      if self.f.value(receiver).ty != Type.Value { fail refuse(at, opcode, b"this is an unboxed number in an inlined call") }
      run self.checkTag(receiver, -1, at)
      let r = run self.share(receiver, at)
      run self.push(r) return true
    }
    if opcode == op.OP_push_this {
      // Only an object receiver: anything else needs the interpreter's mode checks. Strict
      // code takes the receiver as it is, so once something else made it leave there (a
      // plain call, `undefined` as this) it is not tested again.
      let t = run self.f.emit(self.current, Op.This, true, Type.Value, Own.Borrowed, NONE, NONE, 0, at)
      let receiver = self.f.argumentCount
      self.f.setOwnership(t, Own.Borrowed, RootKind.Argument, receiver)
      if !(input.strict && self.widened(at)) { run self.checkTag(t, -1, at) }
      let r = run self.f.emit(self.current, Op.Retain, true, Type.Value, Own.Owned, t, NONE, 0, at)
      run self.push(r) return true
    }
    if opcode == op.OP_get_field {
      let o = self.top(1)
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"a property of an unboxed number") }
      let mut r = run self.recordConstant(input, o, at)
      if r == NONE { r = run self.getField(input, o, FIELD_KEYED, at) }
      drop self.pop() run self.release(o, at) run self.push(r)
      return true
    }
    if opcode == op.OP_get_field2 {
      let o = self.top(1)
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"a property of an unboxed number") }
      let r = run self.getField(input, o, FIELD_CACHED, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8 {
      let index = u8.toUsize(byteAt(input, pc + 13))
      let mut o = NONE
      if opcode == op.OP_get_loc_field8 {
        if index >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
        o = self.locals.get(index)
      } else {
        if index >= self.argumentLimit() { fail refuse(at, opcode, b"argument index out of range") }
        o = run self.parameterValue(usize.toU32(index), at)
      }
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"a property of an unboxed number") }
      let mut r = run self.recordConstant(input, o, at)
      if r == NONE { r = run self.getField(input, o, FIELD_KEYED, at) }
      run self.push(r)
      return true
    }
    if opcode == op.OP_get_array_el {
      if self.keyedStep(at) { return run self.generic(input, pc) }
      let i = self.top(1)
      let o = self.top(2)
      let r = run self.getElem(o, i, at, opcode)
      drop self.pop() drop self.pop()
      run self.release(i, at) run self.release(o, at)
      run self.push(r)
      return true
    }
    // get_array_el2 keeps the object below the element (a[i] op= ...), get_array_el3 the
    // object and the key (a[i]++).
    if opcode == op.OP_get_array_el2 || opcode == op.OP_get_array_el3 {
      if self.keyedStep(at) { return run self.generic(input, pc) }
      let i = self.top(1)
      let o = self.top(2)
      let r = run self.getElem(o, i, at, opcode)
      if opcode == op.OP_get_array_el2 { drop self.pop() run self.release(i, at) }
      run self.push(r)
      return true
    }
    if opcode == op.OP_get_loc_el8 || opcode == op.OP_get_arg_el8 || opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8 {
      if self.keyedStep(at) { return run self.generic(input, pc) }
      let o = run self.slotValue(opcode == op.OP_get_arg_el8 || opcode == op.OP_get_arg_el_arg8, u8.toUsize(byteAt(input, pc + 1)), at, opcode)
      let i = run self.slotValue(opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8, u8.toUsize(byteAt(input, pc + 2)), at, opcode)
      let r = run self.getElem(o, i, at, opcode)
      run self.push(r)
      return true
    }
    if opcode == op.OP_get_length {
      let o = self.top(1)
      let r = run self.getLength(o, at, opcode)
      drop self.pop() run self.release(o, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_get_loc_length8 || opcode == op.OP_get_arg_length8 {
      let o = run self.slotValue(opcode == op.OP_get_arg_length8, u8.toUsize(byteAt(input, pc + 1)), at, opcode)
      let r = run self.getLength(o, at, opcode)
      run self.push(r)
      return true
    }
    if opcode == op.OP_put_array_el {
      let v = self.top(1)
      let i = self.top(2)
      let o = self.top(3)
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"an element of an unboxed number") }
      if self.leaves && self.exits && self.depth == 0 && (self.f.elementKindAt(at) == u8.toU32(feedback.ELEMENT_ORDINARY) || (self.widened(at) && !self.fillStore(input, at, i))) {
        // A key that is not an index (this[kState] = v), as baseline code met at the site, or
        // a store that made the code leave there before (past the end, another kind of
        // object): stored by key, with a step behind it. Not the one store of a loop that
        // may fill its Array, which baseline code noted past the end (fillStore).
        if self.stepped(at) { return run self.generic(input, pc) }
        let key = run self.boxed(i, at)
        let bits = run self.boxed(v, at)
        drop run self.f.emit(self.current, Op.PutKey, false, Type.I32, Own.Unboxed, o, bits, u32.wrappingToI32(key), at)
      } else {
        let x = run self.int(i, at)
        if x == NONE { fail refuse(at, opcode, b"a boolean index") }
        let bits = run self.boxed(v, at)
        drop run self.f.emit(self.current, Op.PutElem, false, Type.I32, Own.Unboxed, o, bits, u32.wrappingToI32(x), at)
      }
      let last = self.f.lastInst() run self.exitHere(last, at)
      drop self.pop() drop self.pop() drop self.pop()
      run self.release(v, at) run self.release(i, at) run self.release(o, at)
      return true
    }
    if opcode == op.OP_get_scope0 || opcode == op.OP_get_scope0_check {
      let mut k = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8))
      if opcode == op.OP_get_scope0_check { k = k | 0x10000 }
      let r = run self.f.emit(self.current, Op.GetScope, true, Type.Value, Own.Owned, NONE, NONE, k, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_put_scope0 || opcode == op.OP_put_scope0_check || opcode == op.OP_set_scope0 {
      let mut k = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8))
      if opcode == op.OP_put_scope0_check { k = k | 0x10000 }
      let v = self.top(1)
      let bits = run self.boxed(v, at)
      drop run self.f.emit(self.current, Op.PutScope, false, Type.I32, Own.Unboxed, bits, NONE, k, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      // set_scope0 leaves the value on the stack.
      if opcode != op.OP_set_scope0 { drop self.pop() run self.release(v, at) }
      return true
    }
    if opcode == op.OP_get_var_ref || opcode == op.OP_get_var_ref_check {
      let k = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8)) | 0x20000
      let r = run self.f.emit(self.current, Op.GetScope, true, Type.Value, Own.Owned, NONE, NONE, k, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_put_var_ref || opcode == op.OP_put_var_ref_check || opcode == op.OP_set_var_ref {
      let k = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8)) | 0x20000
      let v = self.top(1)
      let bits = run self.boxed(v, at)
      drop run self.f.emit(self.current, Op.PutScope, false, Type.I32, Own.Unboxed, bits, NONE, k, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      // set_var_ref leaves the value on the stack.
      if opcode != op.OP_set_var_ref { drop self.pop() run self.release(v, at) }
      return true
    }
    if opcode == op.OP_get_var || opcode == op.OP_get_var_undef {
      let mut index = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8))
      if self.depth != 0 && index < 64 && u64.bitAnd(u64.shiftRight(self.ownedCells, u32.toU64(i32.wrappingToU32(index))), 1) != 0 { index = index | ssa.VAR_OWNED }
      let r = run self.f.emit(self.current, Op.GetVar, true, Type.Value, Own.Owned, NONE, NONE, index, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_put_var {
      let index = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8))
      let v = self.top(1)
      let bits = run self.boxed(v, at)
      drop run self.f.emit(self.current, Op.PutVar, false, Type.I32, Own.Unboxed, bits, NONE, index, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      drop self.pop() run self.release(v, at)
      return true
    }
    if opcode == op.OP_push_atom_value || opcode == op.OP_push_empty_string {
      let mut k = 1
      if opcode == op.OP_push_atom_value {
        // A string atom below 2^30 is named for its cell to be linked (ssa.Op.AtomValue).
        let atom = u32At4(input, pc + 1)
        k = 0
        if atom < 0x40000000 { k = i32.shiftLeft(u32.wrappingToI32(atom), 1) }
      }
      let r = run self.f.emit(self.current, Op.AtomValue, true, Type.Value, Own.Owned, NONE, NONE, k, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_put_field {
      let v = self.top(1)
      let o = self.top(2)
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"a property of an unboxed number") }
      run self.putField(input, o, v, at)
      drop self.pop() drop self.pop()
      run self.release(v, at) run self.release(o, at)
      return true
    }
    if opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8 {
      let target = u8.toUsize(byteAt(input, pc + 13))
      let source = u8.toUsize(byteAt(input, pc + 14))
      if target >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
      let o = self.locals.get(target)
      let mut v = NONE
      if opcode == op.OP_put_loc_field_loc8 {
        if source >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
        v = self.locals.get(source)
      } else {
        if source >= self.argumentLimit() { fail refuse(at, opcode, b"argument index out of range") }
        v = run self.parameterValue(usize.toU32(source), at)
      }
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"a property of an unboxed number") }
      run self.putField(input, o, v, at)
      return true
    }
    fail refuse(at, opcode, b"opcode outside the subset")
  }
}

/// Translates `input`, or refuses. The result is compacted but not yet simplified or
/// ownership-optimized (see `ssa_ownership.optimize`).
pub effect fn translate(input: &FunctionInput) -> Function ! Refusal | OutOfMemoryError ? &mut Allocator {
  if !input.normal { fail refuse(NONE, 0, b"generator or async function") }
  if input.closureVars != 0 { fail refuse(NONE, 0, b"closure variables") }
  if input.code.length() == 0 { fail refuse(NONE, 0, b"no code") }
  if op.opcodeInfo(op.OP_fuse_prefix, true).size != 5 { fail refuse(NONE, op.OP_fuse_prefix, b"fusion prefix size changed") }
  let shapeOf = run shape(input)
  let length = input.code.length()
  let mut t = Translator { f: Function.make(input.argumentCount, input.localCount), blockAt: List<u32>.make(), leaderPc: List<u32>.make(), current: 0,
    locals: List<u32>.make(), stack: List<u32>.make(), doubleSites: run copyList(&input.doubleSites),
    catchTop: run copyI32(&shapeOf.catchTop), catchLevel: run copyI32(&shapeOf.catchLevel), depthAt: run copyI32(&shapeOf.depth),
    returns: run copyList(&shapeOf.returns),
    tdz: run tdzOf(input, &shapeOf, 0, false, false, 0, u32.MAX), initialized: List<bool>.make(), liveness: run livenessOf(input), undef: NONE, inlinedBytes: 0, turning: false, addKey: objects.fieldLayout().addKey, records: run copyRecords(&input.records), argNumbers: List<u32>.make(), namedClosure: usize.MAX, lazySlot: usize.MAX, lazyAlias: usize.MAX,
    depth: 0, rootPc: 0, rootDepth: 0, rootInst: 0, held: List<u32>.make(), frames: List<usize>.make(),
    argsBase: 0, argCount: 0, receiverAt: usize.MAX, formals: 0, calls: List<InlineCall>.make(), leaves: input.leavesBodies, arrayPush: input.arrayPush, arrayPop: input.arrayPop, bodyLoops: 0, ownChain: true, ownedCells: 0, broken: false, paramWrites: false, missed: b"", wideEquality: wideEquality(input), osr: false, edgeMode: EDGE_ARM, mids: List<u32>.make(), exits: true, argSlots: argumentSlots(input) }
  t.lazySlot = lazyArgumentsLocal(input)
  t.f.arrayShape = input.arrayShape
  if t.lazySlot != usize.MAX { t.lazyAlias = lazyArgumentsCopy(input, t.lazySlot) }
  run t.blockAt.appendRepeated(NONE, length + 1)
  run t.f.elementKinds.appendSlice(input.elementKinds.asSlice())
  let entry = run t.f.block()
  // A block per leader, with one parameter per local and per operand at that point.
  let mut pc: usize = 0
  while pc < length {
    if shapeOf.leader.get(pc) && shapeOf.start.get(pc) {
      let b = run t.f.block()
      t.blockAt.set(pc, b)
      run t.setLeader(b, usize.toU32(pc))
      let count = input.localCount + t.argSlots + i32.wrappingToU32(shapeOf.depth.get(pc))
      let mut i: u32 = 0
      while i < count { drop run t.f.addParam(b, Type.Value, Own.Owned) i = i + 1 }
    }
    pc = pc + 1
  }
  // The entry: locals start undefined, then the code's first block.
  t.current = entry
  let undefined = run t.imm(Imm.Undefined, 0)
  t.undef = undefined
  let mut i: u32 = 0
  while i < input.localCount { run t.locals.append(undefined) i = i + 1 }
  t.f.argumentSlots = t.argSlots
  i = 0
  while i < t.argSlots { let a = run t.argument(i, 0) let r = run t.f.emit(t.current, Op.Retain, true, Type.Value, Own.Owned, a, NONE, 0, 0) run t.locals.append(r) i = i + 1 }
  // Not a back edge, though its target is offset 0.
  let first = t.blockAt.get(0)
  let edge = run t.edgeTo(first, 0)
  run t.f.terminate(entry, Op.Jump, NONE, edge, 0)
  // Each block in code order.
  pc = 0
  while pc < length {
    if shapeOf.leader.get(pc) && shapeOf.start.get(pc) {
      run t.enter(pc)
      let mut at = pc
      let mut previous = pc
      let mut open = true
      while open {
        if at != pc && shapeOf.leader.get(at) {
          // Falling through into the next block, from the instruction before it.
          run t.jumpTo(at, usize.toU32(previous))
          open = false
        } else {
          open = run t.instruction(input, at)
          previous = at
          at = at + sizeAt(input, at)
        }
      }
    }
    pc = pc + 1
  }
  run t.f.compact()
  return move t.f
}

/// An exit at `pc` that is always taken (a guard on a constant that never holds), ending the
/// block: how on-stack-replacement code leaves at an instruction outside the subset.
effect fn sideExit(t: &mut Translator, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let u = run t.imm(Imm.Undefined, pc)
  drop run t.f.emit(t.current, Op.Unbox, true, Type.I32, Own.Unboxed, u, NONE, 0, pc)
  let last = t.f.lastInst() run t.exitHere(last, pc)
  // Never reached; it ends the block with every owned value consumed.
  run t.releaseAll(pc)
  let r = run t.imm(Imm.Undefined, pc)
  run t.f.terminate(t.current, Op.Return, r, NONE, pc)
}

/// On-stack replacement (docs/jit/osr.md): translates `input` for an entry at the loop header
/// `header`, reached with an empty operand stack. The function takes `argumentCount +
/// localCount` arguments: the frame's arguments, then its locals (local `i` is argument
/// `argumentCount + i`). Only code reachable from the header is translated, and an
/// instruction outside the subset becomes an exit to the interpreter instead of a refusal.
pub effect fn translateOsr(input: &FunctionInput, header: u32, allowCalls: bool) -> Function ! Refusal | OutOfMemoryError ? &mut Allocator {
  // Its stand-in's uses run on the frame's arguments through the call block (lazyUse).
  if lazyArgumentsLocal(input) != usize.MAX { fail refuse(header, op.OP_special_object, b"a lazy arguments object in on-stack-replacement code") }
  let calls = osrMayCall(input, allowCalls)
  let none = List<u8>.make()
  let plain = run translateOsrWith(input, header, calls, &none, &none)
  // Locals the loop only ever makes numbers of enter as numbers: guarded once at entry, so
  // the loop's own unboxing (ssa_ownership) keeps them in registers.
  // So do the frame's operands under the header (a for-of record's index): header parameters
  // after the locals, in stack order.
  let markers = run osrMarkers(input, header)
  let speculation = run osrSpeculation(&plain, input.localCount + usize.toU32(markers.length()), header, &input.doubleSites)
  // Arguments the loop only unboxes are guarded once at entry too (loop-invariant guards).
  let arguments = run osrArgumentSpeculation(&plain, input.argumentCount)
  let mut any = false
  let mut i: usize = 0
  while i < speculation.length() { if speculation.get(i) != SPECULATE_NONE { any = true } i = i + 1 }
  i = 0
  while i < arguments.length() { if arguments.get(i) != SPECULATE_NONE { any = true } i = i + 1 }
  if !any { return move plain }
  return run translateOsrWith(input, header, calls, &speculation, &arguments)
}

const SPECULATE_NONE: u8 = 0
const SPECULATE_INT: u8 = 1
const SPECULATE_NUMBER: u8 = 2

/// For each local of `f` (a translateOsr artefact): SPECULATE_INT when every value entering
/// its loop-header web from inside the loop is a boxed i32, SPECULATE_NUMBER when they are
/// boxed i32 or f64 (or the header deoptimized before, `doubleSites`), else SPECULATE_NONE.
effect fn osrSpeculation(f: &Function, localCount: u32, header: u32, doubleSites: &List<u32>) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  run out.appendRepeated(SPECULATE_NONE, u32.toUsize(localCount))
  if f.blockCount() == 0 { return move out }
  let entry = f.blocks.get(0)
  if entry.instCount == 0 { return move out }
  let jump = f.inst(entry.firstInst + entry.instCount - 1)
  if jump.edge == NONE { return move out }
  let edge = f.edges.get(u32.toUsize(jump.edge))
  let target = f.blocks.get(u32.toUsize(edge.target))
  let mut widened = false
  let mut k: usize = 0
  while k < doubleSites.length() { if doubleSites.get(k) == header { widened = true } k = k + 1 }
  let mut g: u32 = 0
  while g < localCount && g < edge.argCount && g < target.paramCount {
    let entering = f.edgeArg(edge, g)
    // The web of header parameters this local's value flows around the loop in.
    let mut members = List<u32>.make()
    run members.append(f.paramAt(target, g))
    let mut ints = false let mut doubles = false let mut other = false
    let mut m: usize = 0
    while m < members.length() {
      let q = members.get(m)
      let info = f.value(q)
      let home = f.blocks.get(u32.toUsize(info.block))
      let mut position: u32 = 0
      while position < home.paramCount && f.paramAt(home, position) != q { position = position + 1 }
      let mut e: usize = 0
      while e < f.edges.length() {
        let into = f.edges.get(e)
        if into.target == info.block && position < into.argCount {
          let a = f.edgeArg(into, position)
          let ai = f.value(a)
          if a == entering || listHas(&members, a) { }
          else if ai.def == NONE && ai.ty == Type.Value { run members.append(a) }
          else if ai.def != NONE && f.inst(ai.def).op == Op.BoxI32 { ints = true }
          else if ai.def != NONE && f.inst(ai.def).op == Op.BoxF64 { doubles = true }
          else { other = true }
        }
        e = e + 1
      }
      m = m + 1
    }
    if !other && (ints || doubles) {
      if doubles || widened { out.set(u32.toUsize(g), SPECULATE_NUMBER) } else { out.set(u32.toUsize(g), SPECULATE_INT) }
    }
    g = g + 1
  }
  return move out
}
/// For each argument of `f` (a translateOsr artefact): SPECULATE_INT when every use of it is
/// an i32 unbox, SPECULATE_NUMBER when they are i32 or f64 unboxes with at least one f64,
/// else SPECULATE_NONE.
effect fn osrArgumentSpeculation(f: &Function, argumentCount: u32) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  let mut ints = List<bool>.make() let mut doubles = List<bool>.make() let mut other = List<bool>.make()
  run out.appendRepeated(SPECULATE_NONE, u32.toUsize(argumentCount))
  run ints.appendRepeated(false, u32.toUsize(argumentCount))
  run doubles.appendRepeated(false, u32.toUsize(argumentCount))
  run other.appendRepeated(false, u32.toUsize(argumentCount))
  // Which argument each value is, if it is an Arg.
  let mut which = List<u32>.make()
  run which.appendRepeated(NONE, f.values.length())
  let mut i: usize = 0
  while i < f.insts.length() {
    let inst = f.insts.get(i)
    if inst.op == Op.Arg && inst.result != NONE && inst.k >= 0 && i32.wrappingToU32(inst.k) < argumentCount { which.set(u32.toUsize(inst.result), i32.wrappingToU32(inst.k)) }
    i = i + 1
  }
  // get_arg makes an owned copy: a retain of the argument is the argument too.
  let mut changed = true
  while changed {
    changed = false
    i = 0
    while i < f.insts.length() {
      let inst = f.insts.get(i)
      if inst.op == Op.Retain && inst.result != NONE && inst.a != NONE && u32.toUsize(inst.a) < which.length()
        && which.get(u32.toUsize(inst.a)) != NONE && which.get(u32.toUsize(inst.result)) == NONE {
        let n = which.get(u32.toUsize(inst.a))
        which.set(u32.toUsize(inst.result), n) changed = true
      }
      i = i + 1
    }
  }
  i = 0
  while i < f.insts.length() {
    let inst = f.insts.get(i)
    if inst.op != Op.Arg && inst.op != Op.Retain && inst.op != Op.Release {
      if inst.a != NONE && u32.toUsize(inst.a) < which.length() && which.get(u32.toUsize(inst.a)) != NONE {
        let n = u32.toUsize(which.get(u32.toUsize(inst.a)))
        if inst.op == Op.Unbox && f.value(inst.result).ty == Type.I32 { ints.set(n, true) }
        else if inst.op == Op.UnboxF64 { doubles.set(n, true) }
        else { other.set(n, true) }
      }
      if inst.b != NONE && u32.toUsize(inst.b) < which.length() && which.get(u32.toUsize(inst.b)) != NONE { other.set(u32.toUsize(which.get(u32.toUsize(inst.b))), true) }
    }
    i = i + 1
  }
  i = 0
  while i < f.edgeArgs.length() {
    let a = f.edgeArgs.get(i)
    if a != NONE && u32.toUsize(a) < which.length() && which.get(u32.toUsize(a)) != NONE { other.set(u32.toUsize(which.get(u32.toUsize(a))), true) }
    i = i + 1
  }
  i = 0
  while i < u32.toUsize(argumentCount) {
    if !other.get(i) && doubles.get(i) { out.set(i, SPECULATE_NUMBER) }
    else if !other.get(i) && ints.get(i) { out.set(i, SPECULATE_INT) }
    i = i + 1
  }
  return move out
}
fn listHas(list: &List<u32>, v: u32) -> bool {
  let mut i: usize = 0
  while i < list.length() { if list.get(i) == v { return true } i = i + 1 }
  return false
}

effect fn translateOsrWith(input: &FunctionInput, header: u32, calls: bool, speculation: &List<u8>, argumentSpeculation: &List<u8>) -> Function ! Refusal | OutOfMemoryError ? &mut Allocator {
  if !input.normal { fail refuse(NONE, 0, b"generator or async function") }
  if input.closureVars != 0 { fail refuse(NONE, 0, b"closure variables") }
  if input.scopeSlots != 0 { fail refuse(NONE, 0, b"a function scope") }
  if input.code.length() == 0 { fail refuse(NONE, 0, b"no code") }
  if op.opcodeInfo(op.OP_fuse_prefix, true).size != 5 { fail refuse(NONE, op.OP_fuse_prefix, b"fusion prefix size changed") }
  let begin = u32.toUsize(header)
  let region = run loopRegion(input, header)
  let markers = run osrMarkers(input, header)
  let mut u: usize = 0
  while u < markers.length() {
    if markers.get(u) == SLOT_UNKNOWN { fail refuse(header, op.OP_for_of_start, b"a for-of loop of an unknown layout before the header") }
    u = u + 1
  }
  let shapeOf = run shapeAt(input, begin, true, calls, region.start, region.end, &markers)
  let back = run loopsBack(input, begin, calls, &region)
  if !back { fail refuse(header, byteAt(input, begin), b"every path around the loop leaves through an exit") }
  let length = input.code.length()
  let mut t = Translator { f: Function.make(input.argumentCount + input.localCount + usize.toU32(markers.length()), input.localCount), blockAt: List<u32>.make(), leaderPc: List<u32>.make(), current: 0,
    locals: List<u32>.make(), stack: List<u32>.make(), doubleSites: run copyList(&input.doubleSites),
    catchTop: run copyI32(&shapeOf.catchTop), catchLevel: run copyI32(&shapeOf.catchLevel), depthAt: run copyI32(&shapeOf.depth),
    returns: run copyList(&shapeOf.returns),
    tdz: run tdzOf(input, &shapeOf, begin, true, calls, region.start, region.end), initialized: List<bool>.make(), liveness: Liveness { tracked: false, all: 0, live: List<u64>.make(), kill: List<u64>.make() }, undef: NONE, inlinedBytes: 0, turning: false, addKey: objects.fieldLayout().addKey, records: run copyRecords(&input.records), argNumbers: List<u32>.make(), namedClosure: usize.MAX, lazySlot: usize.MAX, lazyAlias: usize.MAX,
    depth: 0, rootPc: 0, rootDepth: 0, rootInst: 0, held: List<u32>.make(), frames: List<usize>.make(),
    argsBase: 0, argCount: 0, receiverAt: usize.MAX, formals: 0, calls: List<InlineCall>.make(), leaves: input.leavesBodies, arrayPush: input.arrayPush, arrayPop: input.arrayPop, bodyLoops: 0, ownChain: true, ownedCells: 0, broken: false, paramWrites: false, missed: b"", wideEquality: wideEquality(input), osr: true, edgeMode: EDGE_ARM, mids: List<u32>.make(), exits: false, argSlots: argumentSlots(input) }
  run t.blockAt.appendRepeated(NONE, length + 1)
  let entry = run t.f.block()
  let mut pc: usize = 0
  while pc < length {
    if shapeOf.leader.get(pc) && shapeOf.start.get(pc) {
      let b = run t.f.block()
      t.blockAt.set(pc, b)
      run t.setLeader(b, usize.toU32(pc))
      let count = input.localCount + t.argSlots + i32.wrappingToU32(shapeOf.depth.get(pc))
      let mut i: u32 = 0
      while i < count { drop run t.f.addParam(b, Type.Value, Own.Owned) i = i + 1 }
    }
    pc = pc + 1
  }
  // The entry: each local is an owner of the frame's value, as get_arg makes one.
  t.current = entry
  let mut i: u32 = 0
  while i < input.localCount {
    let a = run t.argument(input.argumentCount + i, header)
    let r = run t.f.emit(t.current, Op.Retain, true, Type.Value, Own.Owned, a, NONE, 0, header)
    run t.locals.append(r)
    i = i + 1
  }
  // Written parameters: slots after the locals, each a counted copy of the frame's argument.
  t.f.argumentSlots = t.argSlots
  i = 0
  while i < t.argSlots { let a = run t.argument(i, header) let r = run t.f.emit(t.current, Op.Retain, true, Type.Value, Own.Owned, a, NONE, 0, header) run t.locals.append(r) i = i + 1 }
  // The operands under the header: catch and for-of markers as their instructions pushed them,
  // and the frame's values (inputs after the locals), owned as locals are.
  let mut m: usize = 0
  while m < markers.length() {
    let kind = markers.get(m)
    if kind == SLOT_VALUE {
      let a = run t.argument(input.argumentCount + input.localCount + usize.toU32(m), header)
      let r = run t.f.emit(t.current, Op.Retain, true, Type.Value, Own.Owned, a, NONE, 0, header)
      run t.stack.append(r)
      m = m + 1
      continue
    }
    if kind == SLOT_FOR_OF {
      let mark = run t.f.emit(t.current, Op.Imm, true, Type.Value, Own.Imm, NONE, NONE, ssa.IMM_CATCH, header)
      run t.stack.append(mark)
      m = m + 1
      continue
    }
    let at = u32.toUsize(kind)
    let handler = usize.toI64(at + 1) + i32.toI64(i32At(input, at + 1))
    if handler > 2147483647 - 8 { fail refuse(header, op.OP_catch, b"a catch handler outside the code") }
    let marker = run t.f.emit(t.current, Op.Imm, true, Type.Value, Own.Imm, NONE, NONE, ssa.IMM_CATCH + i64.wrappingToI32(handler), header)
    run t.stack.append(marker)
    m = m + 1
  }
  // Speculated locals: one guard each (an exit at the header with every local as it came),
  // then the local is the boxed number, its frame value released.
  i = 0
  while i < input.localCount && u32.toUsize(i) < speculation.length() {
    let kind = speculation.get(u32.toUsize(i))
    if kind != SPECULATE_NONE {
      let r = t.locals.get(u32.toUsize(i))
      let mut unboxed = NONE
      if kind == SPECULATE_INT { unboxed = run t.f.emit(t.current, Op.Unbox, true, Type.I32, Own.Unboxed, r, NONE, 0, header) }
      else { unboxed = run t.f.emit(t.current, Op.UnboxF64, true, Type.F64, Own.Unboxed, r, NONE, 0, header) }
      let guard = t.f.lastInst() run t.exitHere(guard, header)
      drop run t.f.emit(t.current, Op.Release, false, Type.I32, Own.Unboxed, r, NONE, 0, header)
      let number = run t.boxed(unboxed, header)
      t.locals.set(u32.toUsize(i), number)
    }
    i = i + 1
  }
  // Speculated operands (a for-of index): the same guard, after every operand is in place.
  m = 0
  while m < markers.length() {
    let at = u32.toUsize(input.localCount) + m
    if markers.get(m) == SLOT_VALUE && at < speculation.length() && speculation.get(at) == SPECULATE_INT {
      let r = t.stack.get(m)
      let unboxed = run t.f.emit(t.current, Op.Unbox, true, Type.I32, Own.Unboxed, r, NONE, 0, header)
      let guard = t.f.lastInst() run t.exitHere(guard, header)
      drop run t.f.emit(t.current, Op.Release, false, Type.I32, Own.Unboxed, r, NONE, 0, header)
      let number = run t.boxed(unboxed, header)
      t.stack.set(m, number)
    }
    m = m + 1
  }
  if argumentSpeculation.length() > 0 && t.argSlots == 0 {
    run t.argNumbers.appendRepeated(NONE, u32.toUsize(input.argumentCount))
    i = 0
    while i < input.argumentCount && u32.toUsize(i) < argumentSpeculation.length() {
      let kind = argumentSpeculation.get(u32.toUsize(i))
      if kind != SPECULATE_NONE {
        let a = run t.argument(i, header)
        let mut unboxed = NONE
        if kind == SPECULATE_INT { unboxed = run t.f.emit(t.current, Op.Unbox, true, Type.I32, Own.Unboxed, a, NONE, 0, header) }
        else { unboxed = run t.f.emit(t.current, Op.UnboxF64, true, Type.F64, Own.Unboxed, a, NONE, 0, header) }
        let guard = t.f.lastInst() run t.exitHere(guard, header)
        let number = run t.boxed(unboxed, header)
        t.argNumbers.set(u32.toUsize(i), number)
      }
      i = i + 1
    }
  }
  let headerBlock = t.blockAt.get(begin)
  let edge = run t.edgeTo(headerBlock, header)
  run t.f.terminate(entry, Op.Jump, NONE, edge, header)
  pc = 0
  while pc < length {
    if shapeOf.leader.get(pc) && shapeOf.start.get(pc) {
      run t.enter(pc)
      let mut at = pc
      let mut previous = pc
      let mut open = true
      while open {
        if at != pc && shapeOf.leader.get(at) {
          run t.jumpTo(at, usize.toU32(previous))
          open = false
        } else if osrExit(byteAt(input, at), calls) || outside(at, region.start, region.end) {
          run sideExit(&mut t, usize.toU32(at))
          open = false
        } else {
          open = run t.instruction(input, at)
          previous = at
          at = at + sizeAt(input, at)
        }
      }
    }
    pc = pc + 1
  }
  run t.f.compact()
  return move t.f
}

/// Whether some path from the loop header `begin` comes back to it without an exit (an opcode
/// osrExit names, or leaving the region): OSR code with none would deopt on every entry.
effect fn loopsBack(input: &FunctionInput, begin: usize, calls: bool, region: &LoopRegion) -> bool ! OutOfMemoryError ? &mut Allocator {
  let length = input.code.length()
  let mut seen = List<bool>.make() run seen.appendRepeated(false, length + 1)
  let mut work = List<usize>.make()
  run work.append(begin)
  while work.length() > 0 {
    let mut pc = work.pop().unwrapOr(0)
    let mut going = true
    while going {
      if pc >= length || seen.get(pc) || outside(pc, region.start, region.end) { going = false continue }
      seen.set(pc, true)
      let opcode = byteAt(input, pc)
      let size = sizeAt(input, pc)
      if osrExit(opcode, calls) || isReturn(opcode) || size == 0 { going = false continue }
      if isBranch(opcode) || isGoto(opcode) {
        let target = targetOf(input, pc)
        if target == usize.toI64(begin) { return true }
        if target >= 0 { run work.append(i64.toUsize(target)) }
        if isBranch(opcode) { run work.append(pc + size) }
        going = false
      } else {
        pc = pc + size
        if pc == begin { return true }
      }
    }
  }
  return false
}

fn outside(pc: usize, low: u32, high: u32) -> bool { return pc < u32.toUsize(low) || pc > u32.toUsize(high) }

/// The bytecode range of a loop: from its header to its last back edge, inclusive.
pub struct LoopRegion { pub start: u32, pub end: u32 }

/// The outermost loop around `header`: the ranges [target, jump] of backward jumps that
/// overlap header's, merged until none overlaps more. On-stack-replacement code covers only
/// this range, so a huge function's code after the loop is not translated for each header,
/// and an exit outside it is the loop finishing (OsrEntry.start, end).
pub effect fn loopRegion(input: &FunctionInput, header: u32) -> LoopRegion ! OutOfMemoryError ? &mut Allocator {
  let length = input.code.length()
  let mut targets = List<u32>.make()
  let mut jumps = List<u32>.make()
  let mut pc: usize = 0
  while pc < length {
    let opcode = byteAt(input, pc)
    let size = sizeAt(input, pc)
    if size == 0 || pc + size > length { break }
    if isBranch(opcode) || isGoto(opcode) {
      let target = targetOf(input, pc)
      if target >= 0 && target <= usize.toI64(pc) { run targets.append(usize.toU32(i64.toUsize(target))) run jumps.append(usize.toU32(pc)) }
    }
    pc = pc + size
  }
  let mut start = header
  let mut end = header
  let mut changed = true
  while changed {
    changed = false
    let mut i: usize = 0
    while i < targets.length() {
      let low = targets.get(i)
      let high = jumps.get(i)
      if low <= end && high >= start && (low < start || high > end) {
        if low < start { start = low }
        if high > end { end = high }
        changed = true
      }
      i = i + 1
    }
  }
  return LoopRegion { start: start, end: end }
}

/// Whether `pc` is inside a loop of `input`: between the target of a backward jump and it.
/// Whether `input`'s code jumps backward anywhere.
fn loops(input: &FunctionInput) -> bool {
  let length = input.code.length()
  let mut at: usize = 0
  while at < length {
    let opcode = byteAt(input, at)
    let size = sizeAt(input, at)
    if size == 0 || at + size > length { return false }
    if isBranch(opcode) || isGoto(opcode) {
      let target = targetOf(input, at)
      if target >= 0 && target <= usize.toI64(at) { return true }
    }
    at = at + size
  }
  return false
}
fn insideLoop(input: &FunctionInput, pc: u32) -> bool {
  let length = input.code.length()
  let mut at: usize = 0
  while at < length {
    let opcode = byteAt(input, at)
    let size = sizeAt(input, at)
    if size == 0 || at + size > length { return false }
    if (isBranch(opcode) || isGoto(opcode)) && at >= u32.toUsize(pc) {
      let target = targetOf(input, at)
      if target >= 0 && target <= u32.toI64(pc) { return true }
    }
    at = at + size
  }
  return false
}

/// The targets of backward jumps in `input`, each once, in code order: where on-stack
/// replacement can enter. Read by decoding the code linearly.
pub effect fn loopHeaders(input: &FunctionInput) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let length = input.code.length()
  let mut marked = List<bool>.make() run marked.appendRepeated(false, length + 1)
  let mut pc: usize = 0
  while pc < length {
    let opcode = byteAt(input, pc)
    let size = sizeAt(input, pc)
    if size == 0 || pc + size > length { break }
    if isBranch(opcode) || isGoto(opcode) {
      let target = targetOf(input, pc)
      if target >= 0 && target <= usize.toI64(pc) { marked.set(i64.toUsize(target), true) }
    }
    pc = pc + size
  }
  let mut headers = List<u32>.make()
  pc = 0
  while pc < length { if marked.get(pc) { run headers.append(usize.toU32(pc)) } pc = pc + 1 }
  return move headers
}
