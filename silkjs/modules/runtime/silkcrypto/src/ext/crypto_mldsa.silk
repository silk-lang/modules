//! The public key of an ML-DSA private key given only in its expanded form (FIPS 204): OpenSSL
//! accepts such keys (`priv_only` PKCS #8), and silk.crypto.ml_dsa computes keys from seeds only.
//! The key's rho and s1 give t = NTT^-1(A * NTT(s1)) + s2, its t0 gives t1 = (t - t0) / 2^13, and
//! the public key is rho || t1; tr = SHAKE256(pk) must be the key's, or the key is refused.

import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u32
import silk.num.i64
import silk.num.usize
import ext.crypto_keccak as keccak

const Q: i64 = 8380417
const N: usize = 256
fn reduce(value: i64) -> i64 { let r = value % Q return if r < 0 { r + Q } else { r } }
fn power(base: i64, exponent: usize) -> i64 {
  let mut result: i64 = 1
  let mut b = reduce(base)
  let mut e = exponent
  while e > 0 { if e % 2 == 1 { result = reduce(result * b) } b = reduce(b * b) e = e / 2 }
  return result
}
fn reverse8(k: usize) -> usize {
  let mut r: usize = 0
  let mut divisor: usize = 1
  while divisor < 256 { r = r * 2 + (k / divisor) % 2 divisor = divisor * 2 }
  return r
}
fn zetas() -> [i64; 256] {
  let mut z: [i64; 256] = [0; 256]
  let mut k: usize = 0
  while k < 256 { z[k] = power(1753, reverse8(k)) k = k + 1 }
  return z
}
fn ntt(w: &mut [i64; 256], z: &[i64; 256]) -> () {
  let mut m: usize = 0
  let mut length: usize = 128
  while length >= 1 {
    let mut start: usize = 0
    while start < N {
      m = m + 1
      let zeta = z[m]
      let mut j = start
      while j < start + length { let t = reduce(zeta * w[j + length]) w[j + length] = reduce(w[j] - t) w[j] = reduce(w[j] + t) j = j + 1 }
      start = start + 2 * length
    }
    length = length / 2
  }
}
fn inverseNtt(w: &mut [i64; 256], z: &[i64; 256]) -> () {
  let mut m: usize = 256
  let mut length: usize = 1
  while length < N {
    let mut start: usize = 0
    while start < N {
      m = m - 1
      let zeta = reduce(0 - z[m])
      let mut j = start
      while j < start + length { let t = w[j] w[j] = reduce(t + w[j + length]) w[j + length] = reduce(zeta * reduce(t - w[j + length])) j = j + 1 }
      start = start + 2 * length
    }
    length = length * 2
  }
  let mut j: usize = 0
  while j < N { w[j] = reduce(w[j] * 8347681) j = j + 1 }
}
// Bits `bits` wide, little-endian, starting at bit `index * bits` of `bytes`.
fn field(bytes: &[u8], index: usize, bits: usize) -> u32 {
  let mut value: u32 = 0
  let mut b: usize = 0
  while b < bits {
    let position = index * bits + b
    let bit = u8.toU32(u8.bitAnd(u8.shiftRight(bytes[position / 8], usize.toU8(position % 8)), 1))
    value = u32.bitOr(value, u32.shiftLeft(bit, usize.toU32(b)))
    b = b + 1
  }
  return value
}
// Element (r, s) of A, sampled in the NTT domain from SHAKE128(rho || s || r).
fn expandA(rho: &[u8], r: usize, s: usize, out: &mut [i64; 256]) -> bool {
  let suffix: [u8; 2] = [usize.toU8(s), usize.toU8(r)]
  let mut stream: [u8; 1344] = [0; 1344]
  keccak.shake(168, rho, &suffix, &mut stream)
  let mut count: usize = 0
  let mut offset: usize = 0
  while count < N {
    if offset + 3 > stream.length { return false }
    let value = u32.bitOr(u32.bitOr(u8.toU32(stream[offset]), u32.shiftLeft(u8.toU32(stream[offset + 1]), 8)), u32.shiftLeft(u8.toU32(u8.bitAnd(stream[offset + 2], 127)), 16))
    offset = offset + 3
    if u32.toI64(value) < Q { out[count] = u32.toI64(value) count = count + 1 }
  }
  return true
}
/// Writes the public key of the expanded ML-DSA private key `secret` (parameter set 0, 1, 2 for
/// ML-DSA-44, -65, -87) into `out`; false if the key is malformed or its tr is not its key's.
pub fn publicKeyOf(set: i32, secret: &[u8], out: &mut [u8]) -> bool {
  let k: usize = if set == 0 { 4 } else if set == 1 { 6 } else { 8 }
  let l: usize = if set == 0 { 4 } else if set == 1 { 5 } else { 7 }
  let eta: u32 = if set == 1 { 4 } else { 2 }
  let etaBits: usize = if eta == 4 { 4 } else { 3 }
  let polyS = 32 * etaBits
  if secret.length != 128 + (l + k) * polyS + k * 416 || out.length != 32 + k * 320 { return false }
  let rho = Slice.view<u8>(secret, 0, 32)
  let tr = Slice.view<u8>(secret, 64, 64)
  let z = zetas()
  // s1 in the NTT domain.
  let mut s1: [[i64; 256]; 7] = [[0; 256]; 7]
  let mut i: usize = 0
  while i < l {
    let packed = Slice.view<u8>(secret, 128 + i * polyS, polyS)
    let mut j: usize = 0
    while j < N { s1[i][j] = reduce(u32.toI64(eta) - u32.toI64(field(packed, j, etaBits))) j = j + 1 }
    ntt(&mut s1[i], &z)
    i = i + 1
  }
  let mut o: usize = 0
  while o < 32 { out[o] = rho[o] o = o + 1 }
  let s2Start = 128 + l * polyS
  let t0Start = s2Start + k * polyS
  let mut row: usize = 0
  while row < k {
    let mut t: [i64; 256] = [0; 256]
    let mut column: usize = 0
    while column < l {
      let mut a: [i64; 256] = [0; 256]
      if !expandA(rho, row, column, &mut a) { return false }
      let mut j: usize = 0
      while j < N { t[j] = reduce(t[j] + a[j] * s1[column][j]) j = j + 1 }
      column = column + 1
    }
    inverseNtt(&mut t, &z)
    let s2 = Slice.view<u8>(secret, s2Start + row * polyS, polyS)
    let t0 = Slice.view<u8>(secret, t0Start + row * 416, 416)
    let mut j: usize = 0
    while j < N {
      let full = reduce(t[j] + u32.toI64(eta) - u32.toI64(field(s2, j, etaBits)))
      let low = 4096 - u32.toI64(field(t0, j, 13))
      let high = reduce(full - low)
      if high % 8192 != 0 { return false }
      let t1 = high / 8192
      if t1 >= 1024 { return false }
      // Ten bits per coefficient.
      let mut b: usize = 0
      while b < 10 {
        let position = j * 10 + b
        let index = 32 + row * 320 + position / 8
        if i64.bitAnd(i64.shiftRight(t1, usize.toI64(b)), 1) == 1 { out[index] = u8.bitOr(out[index], u8.shiftLeft(1, usize.toU8(position % 8))) }
        b = b + 1
      }
      j = j + 1
    }
    row = row + 1
  }
  let mut digest: [u8; 64] = [0; 64]
  keccak.shake(136, Slice.view<u8>(&out, 0, out.length), Slice.view<u8>(&EMPTY, 0, 0), &mut digest)
  let mut same = true
  i = 0
  while i < 64 { if digest[i] != tr[i] { same = false } i = i + 1 }
  return same
}
const EMPTY: [u8; 1] = [0]
