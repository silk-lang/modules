// nghttp2_increase_local_window_size and nghttp2_adjust_local_window_size on (local, recv, reduction).
fn increaseLocal(local: &mut i32, recv: &mut i32, reduction: &mut i32, delta: &mut i32) -> i32 {
  let d = delta.*
  if local.* > MAX_WINDOW - d { return ERR_FLOW_CONTROL }
  local.* = local.* + d
  let rd = minI32(reduction.*, d)
  reduction.* = reduction.* - rd
  recv.* = recv.* + rd
  delta.* = delta.* - rd
  return 0
}
fn adjustLocal(local: &mut i32, recv: &mut i32, reduction: &mut i32, delta: &mut i32) -> i32 {
  if delta.* > 0 {
    let newRecv = maxI32(0, recv.*) - delta.*
    if newRecv >= 0 { recv.* = newRecv return 0 }
    let d = -newRecv
    if local.* > MAX_WINDOW - d { return ERR_FLOW_CONTROL }
    local.* = local.* + d
    let rd = minI32(reduction.*, d)
    reduction.* = reduction.* - rd
    if recv.* < 0 { recv.* = recv.* + rd } else { recv.* = rd }
    delta.* = delta.* - rd
    return 0
  }
  if i32.toI64(local.*) + i32.toI64(delta.*) < 0 || i32.toI64(recv.*) < -2147483648 - i32.toI64(delta.*) || i32.toI64(reduction.*) > 2147483647 + i32.toI64(delta.*) { return ERR_FLOW_CONTROL }
  local.* = local.* + delta.*
  recv.* = recv.* + delta.*
  reduction.* = reduction.* - delta.*
  delta.* = 0
  return 0
}
pub unsafe fn nghttp2_session_set_local_window_size(session: ?*mut u8, flags: u8, stream: i32, size: i32) -> i32 {
  let sp = unsafe sessionOf(session)
  if size < 0 { return ERR_INVALID_ARGUMENT }
  let mut a = ()
  if stream == 0 {
    let s = unsafe ses(&mut a, sp)
    let mut delta = size - s.localWindow
    if delta == 0 { return 0 }
    if delta < 0 { return adjustLocal(&mut s.localWindow, &mut s.recvWindow, &mut s.recvReduction, &mut delta) }
    let rv = increaseLocal(&mut s.localWindow, &mut s.recvWindow, &mut s.recvReduction, &mut delta) drop s
    if rv != 0 { return rv }
    if delta > 0 { return unsafe addWindowUpdate(sp, 0, delta) }
    return unsafe updateRecvConnectionWindow(sp, 0)
  }
  let found = unsafe findStream(sp, stream)
  if Pointer.isNull<Stream>(found) { return 0 }
  let p = unsafe nonnull(found)
  let t = unsafe str(&mut a, p)
  let mut delta = size - t.localWindow
  if delta == 0 { return 0 }
  if delta < 0 { return adjustLocal(&mut t.localWindow, &mut t.recvWindow, &mut t.recvReduction, &mut delta) }
  let rv = increaseLocal(&mut t.localWindow, &mut t.recvWindow, &mut t.recvReduction, &mut delta) drop t
  if rv != 0 { return rv }
  if delta > 0 { return unsafe addWindowUpdate(sp, stream, delta) }
  return unsafe updateRecvStreamWindow(sp, p, 0, true)
}

// Queries.
fn settingOf(settings: &LocalSettings, id: i32) -> u32 {
  if id == 1 { return settings.headerTableSize }
  if id == 2 { return settings.enablePush }
  if id == 3 { return settings.maxConcurrentStreams }
  if id == 4 { return settings.initialWindowSize }
  if id == 5 { return settings.maxFrameSize }
  if id == 6 { return settings.maxHeaderListSize }
  if id == 8 { return settings.enableConnectProtocol }
  if id == 9 { return settings.noRfc7540Priorities }
  return 0
}
pub unsafe fn nghttp2_session_get_remote_settings(session: ?*mut u8, id: i32) -> u32 { let mut a = () let s = unsafe ses(&mut a, unsafe sessionOf(session)) return settingOf(&s.remote, id) }
pub unsafe fn nghttp2_session_get_local_settings(session: ?*mut u8, id: i32) -> u32 { let mut a = () let s = unsafe ses(&mut a, unsafe sessionOf(session)) return settingOf(&s.local, id) }
pub unsafe fn nghttp2_session_get_stream_local_window_size(session: ?*mut u8, stream: i32) -> i32 {
  let found = unsafe findStream(unsafe sessionOf(session), stream)
  if Pointer.isNull<Stream>(found) { return -1 }
  let mut b = () let t = unsafe str(&mut b, unsafe nonnull(found))
  return maxI32(0, t.localWindow - t.recvWindow)
}
pub unsafe fn nghttp2_session_get_stream_remote_window_size(session: ?*mut u8, stream: i32) -> i32 {
