export "C" fn baselineAtomValue(env: *mut BaselineEnv, atom: u32, out: *mut ValueBits) -> u32 {
  if unsafe engine.atomValue(unsafe runtimeOf(env), atom, out) { return 1 }
  return 0
}
export "C" fn baselineTruth(env: *mut BaselineEnv, cell: *const ValueBits) -> u32 {
  if unsafe engine.truth(cell) { return 1 }
  return 0
}

@inlineAlways
unsafe fn dropCount(value: ValueBits) -> () {
  let cell = match value {
    ValueBits.Object { reference } => reference
    ValueBits.String { reference } => reference
    ValueBits.Symbol { reference } => reference
    ValueBits.Int { .. } => { return () }
    ValueBits.Float64 { .. } => { return () }
    ValueBits.Bool { .. } => { return () }
    ValueBits.Undefined => { return () }
    ValueBits.Null => { return () }
    _ => { unsafe gc.releaseDeferred(value) return () }
  }
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, cell)
  if header.referenceCount > 1 { header.referenceCount = header.referenceCount - 1 return () }
  drop header
  unsafe gc.releaseDeferred(value)
}

export "C" fn baselineGetPrivate(env: *mut BaselineEnv, cell: *mut ValueBits) -> u32 {
  let rt = unsafe runtimeOf(env)
  let cells = unsafe Pointer.assumeManyMut<ValueBits>(cell)
  let object = unsafe Pointer.read<ValueBits>(cell)
  let name = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(cells, 1))
  let reference = match object { ValueBits.Object { reference } => reference _ => { return 0 } }
  match name { ValueBits.Symbol { .. } => () _ => { return 0 } }
  let anchor = ()
  let atom = (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)).atoms.borrowedSymbolAtom(name)
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  let index = match unsafe shapes.lookup(data.shape, atom) { Option<usize>.Some { value } => value Option<usize>.None => { return 0 } }
  let found = match data.slot(index).view(unsafe shapes.slotFlags(data.shape, index)) {
    PropertySlot.Value { value } => value
    _ => { return 0 }
  }
  drop data
  if match found { ValueBits.Uninitialized => true _ => false } { return 0 }
  let owned = unsafe found.retained()
  unsafe Pointer.write<ValueBits>(cell, owned)
  unsafe dropCount(name)
  unsafe dropCount(object)
  return 1
}

export "C" fn baselinePutPrivate(env: *mut BaselineEnv, cell: *mut ValueBits) -> u32 {
  let rt = unsafe runtimeOf(env)
  let cells = unsafe Pointer.assumeManyMut<ValueBits>(cell)
  let object = unsafe Pointer.read<ValueBits>(cell)
  let value = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(cells, 1))
  let name = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(cells, 2))
  let reference = match object { ValueBits.Object { reference } => reference _ => { return 0 } }
  match name { ValueBits.Symbol { .. } => () _ => { return 0 } }
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  if state.debugger.restricted { return 0 }
  let atom = state.atoms.borrowedSymbolAtom(name)
  drop state
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  let index = match unsafe shapes.lookup(data.shape, atom) { Option<usize>.Some { value: found } => found Option<usize>.None => { return 0 } }
  let previous = match data.slot(index).view(unsafe shapes.slotFlags(data.shape, index)) {
    PropertySlot.Value { value: old } => old
    _ => { return 0 }
  }
  drop data
  let mut writeAnchor = ()
  let mutable = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut writeAnchor, reference)
  mutable.setSlot(index, SlotBits.value(value))
  drop mutable
  unsafe dropCount(previous)
  unsafe dropCount(name)
  unsafe dropCount(object)
  return 1
}

/// Function.prototype.call's method number in BuiltinFamily.Function (js_function_invoke.CALL_METHOD).
pub const CALL_METHOD: u32 = 2

/// Byte offsets (from an ObjectData cell header) and discriminant bytes that identify a
/// JS_CLASS_C_FUNCTION whose payload is ObjectPayload.NativeFunction with
/// NativeFunctionId.Builtin { family: BuiltinFamily.Function, method: CALL_METHOD } and
/// magicBits == 0 (intrinsic Function.prototype.call across all realms).
/// `payloadTagAt` is `u32.MAX` if probing could not uniquely identify every field.
pub struct CallLayout {
  pub cFunctionClass: u16,
  pub payloadTagAt: u32,
  pub nativePayloadTag: u8,
  pub fnTagAt: u32,
  pub builtinTag: u8,
  pub familyAt: u32,
  pub functionFamily: u8,
  pub methodAt: u32,
  pub magicAt: u32
}
impl Copy for CallLayout {}

fn sampleCallPayload(id: NativeFunctionId, magicBits: u16) -> ObjectPayload {
  return ObjectPayload.NativeFunction {
    function: NativeFunctionData {
      context: Pointer.null<HeapHeader>(),
      function: id,
      magicBits: magicBits,
      length: 0,
      protocol: NativeCallProtocol.Generic,
      callKind: 0
    }
  }
}

fn callPayloadBytes(p: ObjectPayload, fill: u8) -> [u8; 64] {
  let mut bytes: [u8; 64] = [fill; 64]
  let dst = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ObjectPayload>(Pointer.fromMutRef<u8>(&mut bytes[0]))
  unsafe Pointer.put<ObjectPayload>(dst, move p)
  return bytes
}

fn invalidCallLayout() -> CallLayout {
  return CallLayout {
    cFunctionClass: u32.wrappingToU16(classes.JS_CLASS_C_FUNCTION),
    payloadTagAt: u32.MAX,
    nativePayloadTag: 0,
    fnTagAt: u32.MAX,
    builtinTag: 0,
    familyAt: u32.MAX,
    functionFamily: 0,
    methodAt: u32.MAX,
    magicAt: u32.MAX
  }
}

/// Probes the exact byte offsets and discriminant bytes of ObjectPayload.NativeFunction
/// and NativeFunctionId.Builtin { family: BuiltinFamily.Function, method } inside an
/// ObjectData cell so STUB_CALL_METHOD / STUB_CALL_METHOD_KEEP can fast-path
/// `Function.prototype.call` retargeting without a C round-trip.
pub fn functionCallLayout() -> CallLayout {
  let payloadSize = Layout.of<ObjectPayload>().bytes
  if payloadSize > 64 || payloadSize < 4 { return invalidCallLayout() }
  let mut cell: [u64; 64] = [0; 64]
  let header = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut HeapHeader>(Pointer.fromMutRef<u64>(&mut cell[0]))
  let base = Pointer.address<HeapHeader>(header)
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, header)
  let payloadOff = Pointer.address<ObjectPayload>(Pointer.fromRef<ObjectPayload>(&data.payload)) - base
  let f0_0 = callPayloadBytes(sampleCallPayload(NativeFunctionId.Builtin { family: BuiltinFamily.Function, method: 0 }, 0), 0)
  let f0_f = callPayloadBytes(sampleCallPayload(NativeFunctionId.Builtin { family: BuiltinFamily.Function, method: 0 }, 0), 255)
  let f1_0 = callPayloadBytes(sampleCallPayload(NativeFunctionId.Builtin { family: BuiltinFamily.Function, method: 0x01020304 }, 0), 0)
  let f2_0 = callPayloadBytes(sampleCallPayload(NativeFunctionId.Builtin { family: BuiltinFamily.Function, method: 0x11223344 }, 0), 0)
  let fm1 = callPayloadBytes(sampleCallPayload(NativeFunctionId.Builtin { family: BuiltinFamily.Function, method: 0 }, 0x0506), 0)
  let fm2 = callPayloadBytes(sampleCallPayload(NativeFunctionId.Builtin { family: BuiltinFamily.Function, method: 0 }, 0x1516), 0)
  let j0_0 = callPayloadBytes(sampleCallPayload(NativeFunctionId.Builtin { family: BuiltinFamily.Json, method: 0 }, 0), 0)
  let s0_0 = callPayloadBytes(sampleCallPayload(NativeFunctionId.Builtin { family: BuiltinFamily.String, method: 0 }, 0), 0)
  let h0_0 = callPayloadBytes(sampleCallPayload(NativeFunctionId.Host { id: 0 }, 0), 0)
  let h0_f = callPayloadBytes(sampleCallPayload(NativeFunctionId.Host { id: 0 }, 0), 255)
  let h1_0 = callPayloadBytes(sampleCallPayload(NativeFunctionId.Host { id: 0x01020304 }, 0), 0)
  let e0_0 = callPayloadBytes(ObjectPayload.Empty, 0)
  let e0_f = callPayloadBytes(ObjectPayload.Empty, 255)
  let b0_0 = callPayloadBytes(ObjectPayload.Boxed { value: ValueBits.Undefined }, 0)
  let b0_f = callPayloadBytes(ObjectPayload.Boxed { value: ValueBits.Undefined }, 255)
  let mut payloadTagAt = u32.MAX
  let mut payloadTagCount: u32 = 0
  let mut nativePayloadTag: u8 = 0
  let mut fnTagAt = u32.MAX
  let mut fnTagCount: u32 = 0
  let mut builtinTag: u8 = 0
  let mut famAt = u32.MAX
  let mut famCount: u32 = 0
  let mut functionFamily: u8 = 0
  let mut methodAt = u32.MAX
  let mut methodCount: u32 = 0
  let mut magicAt = u32.MAX
  let mut magicCount: u32 = 0
  let mut b: usize = 0
  while b < payloadSize {
    if f0_0[b] == f0_f[b] && f0_0[b] == f1_0[b] {
      if e0_0[b] == e0_f[b] && b0_0[b] == b0_f[b] && f0_0[b] == h0_0[b] && f0_0[b] == j0_0[b] && f0_0[b] == fm1[b]
        && f0_0[b] != e0_0[b] && f0_0[b] != b0_0[b] && e0_0[b] != b0_0[b] {
        payloadTagAt = usize.toU32(payloadOff + b)
        nativePayloadTag = f0_0[b]
        payloadTagCount = payloadTagCount + 1
      }
      if f0_0[b] == j0_0[b] && f0_0[b] == s0_0[b] && h0_0[b] == h0_f[b] && h0_0[b] == h1_0[b] && f0_0[b] != h0_0[b] {
        fnTagAt = usize.toU32(payloadOff + b)
        builtinTag = f0_0[b]
        fnTagCount = fnTagCount + 1
      }
      if f0_0[b] != j0_0[b] && f0_0[b] != s0_0[b] && j0_0[b] != s0_0[b] {
        famAt = usize.toU32(payloadOff + b)
        functionFamily = f0_0[b]
        famCount = famCount + 1
      }
    }
    if b + 4 <= payloadSize
      && f0_0[b] == 0 && f0_0[b + 1] == 0 && f0_0[b + 2] == 0 && f0_0[b + 3] == 0
      && f0_f[b] == 0 && f0_f[b + 1] == 0 && f0_f[b + 2] == 0 && f0_f[b + 3] == 0
      && f1_0[b] == 4 && f1_0[b + 1] == 3 && f1_0[b + 2] == 2 && f1_0[b + 3] == 1
      && f2_0[b] == 0x44 && f2_0[b + 1] == 0x33 && f2_0[b + 2] == 0x22 && f2_0[b + 3] == 0x11 {
      methodAt = usize.toU32(payloadOff + b)
      methodCount = methodCount + 1
    }
    if b + 2 <= payloadSize
      && f0_0[b] == 0 && f0_0[b + 1] == 0
      && f0_f[b] == 0 && f0_f[b + 1] == 0
      && fm1[b] == 6 && fm1[b + 1] == 5
      && fm2[b] == 0x16 && fm2[b + 1] == 0x15 {
      magicAt = usize.toU32(payloadOff + b)
      magicCount = magicCount + 1
    }
    b = b + 1
  }
  if payloadTagCount != 1 || fnTagCount != 1 || famCount != 1 || methodCount != 1 || magicCount != 1 {
    return invalidCallLayout()
  }
  return CallLayout {
    cFunctionClass: u32.wrappingToU16(classes.JS_CLASS_C_FUNCTION),
    payloadTagAt: payloadTagAt,
    nativePayloadTag: nativePayloadTag,
    fnTagAt: fnTagAt,
    builtinTag: builtinTag,
    familyAt: famAt,
    functionFamily: functionFamily,
    methodAt: methodAt,
    magicAt: magicAt
  }
}

/// Byte offset of BytecodeClosure.homeObject from a bytecode closure ObjectData cell header,
/// or u32.MAX if probing fails.
pub fn closureHomeOffset() -> u32 {
  let mut cell: [u64; 64] = [0; 64]
  let header = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut HeapHeader>(Pointer.fromMutRef<u64>(&mut cell[0]))
  let base = Pointer.address<HeapHeader>(header)
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, header)
  let payload = Pointer.address<ObjectPayload>(Pointer.fromRef<ObjectPayload>(&object.payload)) - base
  let sample = ObjectPayload.BytecodeFunction { function: BytecodeClosure { bytecode: header, varRefs: BoxList<?*mut HeapHeader>.make(),
    homeObject: Pointer.null<HeapHeader>(), scope: Pointer.null<HeapHeader>() } }
  let mut within: usize = 0
  let mut found = false
  match &sample {
    ObjectPayload.BytecodeFunction { function: closure } => {
      within = Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&closure.homeObject)) - Pointer.address<ObjectPayload>(Pointer.fromRef<ObjectPayload>(&sample))
      found = true
    }
    _ => ()
  }
  if !found { return u32.MAX }
  return usize.toU32(payload + within)
}

const CONSTRUCT_GENERIC: u8 = 0
const CONSTRUCT_STORES: u8 = 1
const CONSTRUCT_FORWARD: u8 = 2
const CONSTRUCT_EVAL: u8 = 3
const PLAN_SOURCE: u8 = 0x3F
const PLAN_SHARED: u8 = 0x80
const PAYLOAD_TAG_BYTES: usize = 8
const APPLY_METHOD: u32 = 3

@inlineAlways
unsafe fn isApplyFunction(function: ValueBits) -> bool {
  let reference = match function { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, reference)
  if object.classId() != classes.JS_CLASS_C_FUNCTION { return false }
  return match &object.payload {
    ObjectPayload.NativeFunction { function: native } => if native.magicBits != 0 { false } else { match native.function {
      NativeFunctionId.Builtin { family, method } => family == BuiltinFamily.Function && method == APPLY_METHOD
      _ => false
    } }
    _ => false
  }
}

@inlineAlways
unsafe fn dropShapeRef(shape: *mut HeapHeader) -> () {
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, shape)
  header.referenceCount = i32.wrappingSubtract(header.referenceCount, 1)
}

@inlineAlways
unsafe fn nonnullHeader(p: ?*mut HeapHeader) -> *mut HeapHeader {
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(p)
}

/// Tries to recycle a dead young plain inline object of capacity `tail` directly off
/// `RuntimeState.zeroStack`, preferring one that already holds `final` shape.
/// Consumes the caller's +1 reference on `final` on success (releasing it when `sameShape`,
/// or transferring it to the recycled object and dropping `oldShape` otherwise).
/// Returns an already-published live object (`rc == 1`, `mark == 0`) with `stores` slots
/// ready to be written, or null (leaving `final`'s reference untouched).
@inlineAlways
unsafe fn tryRecycleZero(rt: *mut HeapHeader, final: *mut HeapHeader, stores: usize, tail: usize) -> ?*mut HeapHeader {
  let anchor = ()
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let depth = u16.toUsize(state.zeroStackCount)
  if depth == 0 || state.gcPhase != GcPhase.None { return Pointer.null<HeapHeader>() }
  let finalAddr = Pointer.address<HeapHeader>(final)
  let mut bestIdx = usize.MAX
  let mut sameShape = false
  let limit = if depth < 6 { depth } else { 6 }
  let mut scan: usize = 0
  while scan < limit {
    let idx = depth - 1 - scan
    let candOpt = state.zeroStack[idx]
    if !Pointer.isNull<HeapHeader>(candOpt) {
      let cand = unsafe nonnullHeader(candOpt)
      let hdr = unsafe Pointer.borrow<(), HeapHeader>(&anchor, cand)
      if hdr.kind == HeapKind.Object {
        let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, cand)
        // The class first: what most often fails is a dead Array (an object's elements die
        // after it, on top of it).
        if data.classId() == classes.JS_CLASS_OBJECT && hdr.young == 1 && hdr.referenceCount == 0 && hdr.mark == 1 && data.pristineFunction(false) && data.slotsInCell() && data.slotCapacity() == tail && data.slotCount() <= 8 {
          let emptyPayload = match &data.payload { ObjectPayload.Empty => true _ => false }
          if emptyPayload {
            let oldShape = data.shape
            if Pointer.address<HeapHeader>(oldShape) == finalAddr { bestIdx = idx sameShape = true break }
            if bestIdx == usize.MAX && (unsafe Pointer.borrow<(), HeapHeader>(&anchor, oldShape)).referenceCount > 1 && unsafe shapes.plainRecords(oldShape) { bestIdx = idx }
          }
        }
      }
    }
    scan = scan + 1
  }
  drop state
  if bestIdx == usize.MAX { return Pointer.null<HeapHeader>() }
  let mut stateAnchor = ()
  let stateMut = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, rt)
  let topIdx = u16.toUsize(stateMut.zeroStackCount) - 1
  let chosen = unsafe nonnullHeader(stateMut.zeroStack[bestIdx])
  if bestIdx != topIdx { stateMut.zeroStack[bestIdx] = stateMut.zeroStack[topIdx] }
  stateMut.zeroStackCount = usize.toU16(topIdx)
  drop stateMut
  let mut hdrAnchor = ()
  let hdr = unsafe Pointer.borrowMut<(), HeapHeader>(&mut hdrAnchor, chosen)
  hdr.referenceCount = 1
  hdr.mark = 0
  drop hdr
  let mut oldVals: [ValueBits; 8] = [ValueBits.Undefined; 8]
  let mut anyHeap = false
  let mut oldShape = final
  let mut dataAnchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut dataAnchor, chosen)
  let oldCount = data.slotCount()
  let mut i: usize = 0
  while i < oldCount {
    let v = (unsafe data.slotUnchecked(i)).valueBits()
    if v.tag() < 0 { anyHeap = true }
    oldVals[i] = v
    i = i + 1
  }
  if oldCount != stores {
    let mut s = data.takeSlots()
    s.truncate(0)
    unsafe s.extendFilled(stores)
    data.setSlotsFresh(move s)
  }
  if !sameShape {
    oldShape = data.shape
    data.shape = final
  }
  drop data
  if sameShape {
    unsafe dropShapeRef(final)
  } else {
    unsafe dropShapeRef(oldShape)
  }
  if anyHeap {
    i = 0
    while i < oldCount {
      if oldVals[i].tag() < 0 { unsafe gc.releaseDeferred(oldVals[i]) }
      i = i + 1
    }
  }
  unsafe census.censusBump(rt, census.CENSUS_OBJECTS_ALLOCATED, 1)
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(chosen)
}

/// Allocates a published plain inline object (recycling from zeroStack first, then from
/// spare cells) with final shape, `stores` uninitialized slot entries ready to be written
/// by the caller, and explicit inline slot capacity `tail` (INLINE_SLOTS or PAIR_SLOTS).
/// Consumes caller's +1 reference on `final` on success; returns null with `final` untouched.
@inlineAlways
unsafe fn allocSpareTail(env: *mut BaselineEnv, rt: *mut HeapHeader, final: *mut HeapHeader, stores: usize, tail: usize) -> ?*mut HeapHeader {
  if tail != shapes.INLINE_SLOTS && tail != shapes.PAIR_SLOTS { return Pointer.null<HeapHeader>() }
  if stores > tail { return Pointer.null<HeapHeader>() }
  if let Option<*mut HeapHeader>.Some { value: recycled } = Pointer.nonNullMut<HeapHeader>(unsafe tryRecycleZero(rt, final, stores, tail)) {
    return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(recycled)
  }
  let mut node = Pointer.null<HeapHeader>()
  if let Option<*mut HeapHeader>.Some { value: spare } = Pointer.nonNullMut<HeapHeader>(unsafe gc.takeSpareCell(rt, tail, true)) {
    node = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(unsafe HeapCell.reviveUninit<ObjectData>(HeapKind.Object, spare))
  } else {
    let zAnchor = ()
    let zeroCount = (unsafe HeapCell.payload<RuntimeState, ()>(&zAnchor, rt)).zeroStackCount
    if zeroCount < 240 {
      let cOpt = (unsafe Pointer.borrow<(), BaselineEnv>(&zAnchor, env)).compiled
      if let Option<*mut u8>.Some { value: cPtr } = Pointer.nonNullMut<u8>(cOpt) {
        let cEnv = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut CompiledEnv>(cPtr)
        node = unsafe compiledHelpers.takePooledCell(cEnv, rt, tail)
      }
    }
  }
  let live = match Pointer.nonNullMut<HeapHeader>(node) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  unsafe census.censusBump(rt, census.CENSUS_OBJECTS_ALLOCATED, 1)
  let mut anchor = ()
  let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut anchor, live)
  let payload = Pointer.fromMutRef<ObjectPayload>(&mut data.payload)
  unsafe Pointer.put<ObjectPayload>(payload, ObjectPayload.Empty)
  let slotPtr = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut SlotBits>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(
    unsafe Intrinsic.pointerReinterpret<*mut ObjectPayload, *mut u8>(payload)), PAYLOAD_TAG_BYTES))
  let mut slots = unsafe ThinList<SlotBits>.borrowing(slotPtr, tail)
  unsafe slots.extendFilled(stores)
  unsafe data.putSlots(move slots)
  data.setIsStandardArrayPrototype(false)
  data.setExtensible(true)
  data.setFreeMark(false)
  data.setIsExotic(false)
  data.setFastArray(false)
  data.setIsConstructor(false)
  data.setHasImmutablePrototype(false)
  data.setIsHtmlDda(false)
  data.clearRoles()
  data.setClassId(classes.JS_CLASS_OBJECT)
  data.weakRefCount = 0
  data.shape = final
  drop data
  unsafe gc.publishObject(rt, live)
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(live)
}

/// Allocates a published plain inline object with final shape and `stores` uninitialized
/// slot entries ready to be written by the caller. Returns null if no cell fits or is available.
@inlineAlways
unsafe fn allocSparePlanned(env: *mut BaselineEnv, rt: *mut HeapHeader, final: *mut HeapHeader, empty: *mut HeapHeader, stores: usize) -> ?*mut HeapHeader {
  let mut tail = unsafe shapes.planInline(empty, stores)
  if tail != 0 && tail < stores { tail = shapes.INLINE_SLOTS }
  return unsafe allocSpareTail(env, rt, final, stores, tail)
}

/// Looks up callee's cached empty receiver shape in RuntimeState.receiverCache without
/// allocating or mutating the cache. Retains the returned shape and writes its prototype
/// to protoOut; returns null on any miss.
@inlineAlways
unsafe fn receiverEmptyShape(rt: *mut HeapHeader, callee: *mut HeapHeader, protoOut: &mut ?*mut HeapHeader) -> ?*mut HeapHeader {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, callee)
  if data.isExotic() { return Pointer.null<HeapHeader>() }
  let version = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).version
  let address = Pointer.address<HeapHeader>(callee)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let set = u64.toUsize(u64.shiftRight(u64.wrappingMultiply(usize.toU64(address / 16), 0x9e3779b97f4a7c15), 60))
  let first = set * 4
  let mut slot = first
  let mut hit = false
  let mut way: usize = 0
  while way < 4 {
    if state.receiverFunctions[first + way] == address { slot = first + way hit = true break }
    way = way + 1
  }
  if !hit { return Pointer.null<HeapHeader>() }
  let entry = state.receiverCache[slot]
  drop state
  if entry.version != version { return Pointer.null<HeapHeader>() }
  let empty = match Pointer.nonNullMut<HeapHeader>(entry.empty) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  let prototype = (unsafe data.slotUnchecked(entry.index)).valueBits()
  drop data
  let held = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, empty)).prototype
  let protoRef = match Pointer.nonNullMut<HeapHeader>(held) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  match prototype {
    ValueBits.Object { reference } => {
      if Pointer.address<HeapHeader>(reference) != Pointer.address<HeapHeader>(protoRef) { return Pointer.null<HeapHeader>() }
    }
    _ => { return Pointer.null<HeapHeader>() }
  }
  let mut headerAnchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut headerAnchor, empty)
  if header.referenceCount <= 0 { return Pointer.null<HeapHeader>() }
  header.referenceCount = i32.wrappingAdd(header.referenceCount, 1)
  drop header
  protoOut.* = held
  return unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(empty)
}

/// `new Array()` of the Array of realm (a native function's context, which is a realm's
/// for an ordinary one): the empty Array its constructor makes
/// (js_array_intrinsics_support.constructEmpty: room for values in its own cell, as an array
/// literal's, js_object_allocate.literalArrayFast) into out (1), in a spare cell or one of
/// compiled code's. 0 for any other function, or with no cell.
@inlineNever
unsafe fn emptyArray(env: *mut BaselineEnv, rt: *mut HeapHeader, callee: *mut HeapHeader, out: *mut ValueBits) -> u32 {
  let shape = match Pointer.nonNullMut<HeapHeader>(unsafe compiledHelpers.realmArrayShape(callee)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return 0 }
  }
  let anchor = ()
  let mut compiled = Pointer.null<CompiledEnv>()
  if let Option<*mut u8>.Some { value } = Pointer.nonNullMut<u8>((unsafe Pointer.borrow<(), BaselineEnv>(&anchor, env)).compiled) {
    compiled = unsafe Intrinsic.pointerRequalify<*mut CompiledEnv, ?*mut CompiledEnv>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut CompiledEnv>(value))
  }
  let array = match Pointer.nonNullMut<HeapHeader>(unsafe compiledHelpers.emptyArrayCell(compiled, rt, shape)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return 0 }
  }
  unsafe Pointer.write<ValueBits>(out, ValueBits.Object { reference: array })
  return 1
}

export "C" fn baselineConstructFast(env: *mut BaselineEnv, base: *mut ValueBits, count: u32, out: *mut ValueBits) -> u32 {
  let rt = unsafe runtimeOf(env)
  if unsafe gc.observesFresh(rt) { return 0 }
  let cells = unsafe Pointer.assumeManyMut<ValueBits>(base)
  let function = unsafe Pointer.read<ValueBits>(base)
  let newTarget = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(cells, 1))
  let callee = match function { ValueBits.Object { reference } => reference _ => { return 0 } }
  let targetRef = match newTarget { ValueBits.Object { reference } => reference _ => { return 0 } }
  if Pointer.address<HeapHeader>(callee) != Pointer.address<HeapHeader>(targetRef) { return 0 }
  let anchor = ()
  let obj = unsafe HeapCell.payload<ObjectData, ()>(&anchor, callee)
  if let ObjectPayload.NativeFunction { .. } = &obj.payload {
    drop obj
    if count != 0 { return 0 }
    return unsafe emptyArray(env, rt, callee, out)
  }
  if obj.classId() != classes.JS_CLASS_BYTECODE_FUNCTION || obj.isExotic() || !obj.isConstructor() { return 0 }
  let bytecode = match &obj.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { return 0 } }
  drop obj
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let form = code.constructForm
  let derived = code.isDerivedClassConstructor
  let compiled = code.baseline
  let realm = code.realm
  drop code
  if derived { return 2 }
  if form == CONSTRUCT_GENERIC {
    if compiled == 0 { return 0 }
    let mut proto = Pointer.null<HeapHeader>()
    let empty = match Pointer.nonNullMut<HeapHeader>(unsafe receiverEmptyShape(rt, callee, &mut proto)) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return 0 }
    }
    let node = match Pointer.nonNullMut<HeapHeader>(unsafe allocSparePlanned(env, rt, empty, empty, 0)) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { unsafe dropShapeRef(empty) return 0 }
    }
    unsafe Pointer.write<ValueBits>(out, ValueBits.Object { reference: node })
    return 4
  }
  let argc = u32.toUsize(count)
  if form == CONSTRUCT_STORES {
    let plan = unsafe gc.plannedShape(rt, callee, Pointer.address<HeapHeader>(bytecode))
    let final = match Pointer.nonNullMut<HeapHeader>(plan.final) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return 2 }
    }
    let empty = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(plan.empty)
    let stores = plan.stores
    if stores > 8 { unsafe dropShapeRef(final) return 2 }
    let node = match Pointer.nonNullMut<HeapHeader>(unsafe allocSparePlanned(env, rt, final, empty, stores)) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { unsafe dropShapeRef(final) return 2 }
    }
    let mut nodeAnchor = ()
    let data = unsafe HeapCell.payloadMut<ObjectData, ()>(&mut nodeAnchor, node)
    let mut index: usize = 0
    while index < stores {
      let raw = plan.sources[index]
      let src = u8.toUsize(raw & PLAN_SOURCE)
      let mut val = ValueBits.Undefined
      if src < argc {
        let argCell = unsafe Pointer.atMut<ValueBits>(cells, 2 + src)
        let lent = unsafe Pointer.read<ValueBits>(argCell)
        if (raw & PLAN_SHARED) == 0 {
          unsafe Pointer.write<ValueBits>(argCell, ValueBits.Undefined)
          val = lent
        } else {
          val = unsafe lent.retained()
        }
      }
      unsafe data.setSlotFreshUnchecked(index, SlotBits.value(val))
      index = index + 1
    }
    drop data
    unsafe Pointer.write<ValueBits>(out, ValueBits.Object { reference: node })
    return 1
  }
  if form != CONSTRUCT_FORWARD && form != CONSTRUCT_EVAL { return 2 }
  // Honor the interrupt counter as a call does, falling back to SERVICE_CONSTRUCT when a
  // poll is due.
  let counter = unsafe interrupts.counter(realm)
  let next = i32.wrappingSubtract(unsafe Pointer.read<i32>(counter), 1)
  if next <= 0 { return 2 }
  unsafe Pointer.write<i32>(counter, next)
  // A recipe (CONSTRUCT_EVAL, or a forwarding wrapper with a plan) as the interpreter makes
  // it (vm.constructRecipeFast), in a cell of compiled code's; SERVICE_CONSTRUCT without one.
  if form == CONSTRUCT_EVAL || !Pointer.isNull<HeapHeader>(unsafe gc.planPrototype(rt, callee)) {
    let isForward = form == CONSTRUCT_FORWARD
    let mut parent: usize = 0
    let plan = unsafe evaluation.recipeTarget(rt, callee, form, &mut parent)
    let final = match Pointer.nonNullMut<HeapHeader>(plan.final) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return 2 }
    }
    if isForward && !unsafe isApplyFunction(plan.method) { return 2 }
    let empty = unsafe nonnullHeader(plan.empty)
    let mut address: usize = 0
    let way = unsafe evaluation.plannedRecipeWay(rt, final, empty, unsafe nonnullHeader(plan.bytecode), parent, plan.stores, plan.recipeSlot, plan.cacheSlot, &mut address)
    if way == usize.MAX { return 2 }
    // allocSparePlanned takes a count of the shape.
    unsafe HeapCell.retain(final)
    let node = match Pointer.nonNullMut<HeapHeader>(unsafe allocSparePlanned(env, rt, final, empty, plan.stores)) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { unsafe dropShapeRef(final) return 2 }
    }
    let argv = FrameSlots { data: unsafe Pointer.atMut<ValueBits>(cells, 2), count: argc }
    let mut moved: u32 = 0
    let made = unsafe evaluation.plannedFill(rt, node, way, plan.stores, &argv, &mut moved)
    // Moved into the object bitwise: the code's releases find nothing.
    let mut index: usize = 0
    while index < argc && index < 4 {
      if (moved & u32.shiftLeft(1, usize.toU32(index))) != 0 { unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(cells, 2 + index), ValueBits.Undefined) }
      index = index + 1
    }
    unsafe Pointer.write<ValueBits>(out, made)
    return 1
  }
  // A forwarding wrapper without a plan calls the function it names directly (3).
  // No construct plan (e.g. initialize calls `new` or uses CONSTRUCT_STORES): allocate
  // the receiver from a recycled/spare cell and call compiled `initialize` directly (return 3).
  let mut proto = Pointer.null<HeapHeader>()
  let empty = match Pointer.nonNullMut<HeapHeader>(unsafe receiverEmptyShape(rt, callee, &mut proto)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return 2 }
  }
  let cached = unsafe constructors.cachedForwardFrom(rt, callee, proto, unsafe constructors.forwardedAtom(function))
  let targetObj = match cached.target { ValueBits.Object { reference } => reference _ => { unsafe dropShapeRef(empty) return 2 } }
  if !unsafe isApplyFunction(cached.method) { unsafe dropShapeRef(empty) return 2 }
  let targetData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, targetObj)
  if targetData.classId() != classes.JS_CLASS_BYTECODE_FUNCTION { drop targetData unsafe dropShapeRef(empty) return 2 }
  let initCodeCell = match &targetData.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { drop targetData unsafe dropShapeRef(empty) return 2 } }
  drop targetData
  let initCode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, initCodeCell)
  let initBaseline = initCode.baseline
  let initDerived = initCode.isDerivedClassConstructor
  drop initCode
  if initBaseline == 0 || initDerived { unsafe dropShapeRef(empty) return 2 }
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe allocSpareTail(env, rt, empty, 0, shapes.INLINE_SLOTS)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { unsafe dropShapeRef(empty) return 2 }
  }
  unsafe HeapCell.retain(targetObj)
  let outs = unsafe Pointer.assumeManyMut<ValueBits>(out)
  unsafe Pointer.write<ValueBits>(out, ValueBits.Object { reference: node })
  unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(outs, 1), ValueBits.Object { reference: targetObj })
  return 3
}
