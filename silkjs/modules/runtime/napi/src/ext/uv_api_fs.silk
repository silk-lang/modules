const FS_MKSTEMP: i32 = 35
const FS_LUTIME: i32 = 36
const COPYFILE_EXCL: i32 = 1
const COPYFILE_FICLONE: i32 = 2
const COPYFILE_FICLONE_FORCE: i32 = 4
// uv_dirent_type_t.
const DIRENT_UNKNOWN: i32 = 0
const DIRENT_FILE: i32 = 1
const DIRENT_DIR: i32 = 2
const DIRENT_LINK: i32 = 3
const DIRENT_FIFO: i32 = 4
const DIRENT_SOCKET: i32 = 5
const DIRENT_CHAR: i32 = 6
const DIRENT_BLOCK: i32 = 7
const UV_EOF: i32 = -4095
// uv_getaddrinfo's errors.
const UV_EAI_ADDRFAMILY: i32 = -3000
const UV_EAI_AGAIN: i32 = -3001
const UV_EAI_BADFLAGS: i32 = -3002
const UV_EAI_CANCELED: i32 = -3003
