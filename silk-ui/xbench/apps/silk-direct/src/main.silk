const WIDTH: f64 = 1040.0
const HEIGHT: f64 = 720.0

fn text(bytes: &[u8]) -> string {
  return String.fromUtf8(bytes) |> Result<string, InvalidUtf8>.unwrapOr("")
}

fn corpus() -> string<'static> {
  return String.fromUtf8(Source.read("assets/corpus.txt")) |> Result<string<'static>, InvalidUtf8>.unwrapOr("")
}

fn picture(index: u32) -> string<'static> {
  let bytes = if index == 0 {
    Source.read("assets/picture-0.dataurl")
  } else if index == 1 {
    Source.read("assets/picture-1.dataurl")
  } else if index == 2 {
    Source.read("assets/picture-2.dataurl")
  } else {
    Source.read("assets/picture-3.dataurl")
  }
  return String.fromUtf8(bytes) |> Result<string<'static>, InvalidUtf8>.unwrapOr("")
}

/// Writes one protocol line.
fn say(line: string) -> () {
  StderrWriter.print("XB {}\n", &.(line))
}

fn say2(word: string, name: string) -> () {
  StderrWriter.print("XB {} {}\n", &(word, name))
}

// ---------- the corpus ----------

/// Where each item's lines start in the corpus.
struct Corpus {
  source: string<'static>,
  starts: List<usize>,
}

impl Corpus {
  effect fn make() -> Corpus ! OutOfMemoryError ? &mut Allocator {
    let source = corpus()
    let bytes = String.utf8Bytes(source)
    let mut starts = List<usize>.make()
    let mut at: usize = 0
    while at < bytes.length {
      if bytes[at] == 35 {
        run starts.append(at)
      }
      while at < bytes.length && bytes[at] != 10 {
        at = at + 1
      }
      at = at + 1
    }
    return Corpus { source: source, starts: move starts }
  }

  fn count(self: &Self) -> usize {
    return self.starts.length()
  }

  /// The lines of item `index`, as one string (newline separated).
  fn item(self: &Self, index: usize) -> string<'static> {
    let starts = self.starts.asSlice()
    let start = starts[index]
    let end = if index + 1 < starts.length { starts[index + 1] } else { String.byteLength(self.source) }
    return String.slice(self.source, start, end - start)
  }
}

/// The `n`th field of `line` split at `|`.
fn field(line: string<'static>, n: usize) -> string<'static> {
  let bytes = String.utf8Bytes(line)
  let mut at: usize = 0
  let mut k: usize = 0
  let mut start: usize = 0
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 124 {
      if k == n {
        return String.slice(line, start, at - start)
      }
      k = k + 1
      start = at + 1
    }
    at = at + 1
  }
  return ""
}

fn hash(value: string) -> u32 {
  let bytes = String.utf8Bytes(value)
  let mut h: u32 = 0
  let mut i: usize = 0
  while i < bytes.length {
    h = u32.wrappingAdd(u32.wrappingMultiply(h, 31), u8.toU32(bytes[i]))
    i = i + 1
  }
  return h
}

fn number(value: string) -> u32 {
  let bytes = String.utf8Bytes(value)
  let mut n: u32 = 0
  let mut i: usize = 0
  while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 {
    n = n * 10 + u8.toU32(bytes[i] - 48)
    i = i + 1
  }
  return n
}

effect fn appendNumber(out: &mut String, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 {
    run appendNumber(&mut out, value / 10)
  }
  run out.append(String.slice("0123456789", u32.toUsize(value % 10), 1))
}

// ---------- making nodes ----------

/// Makes nodes, applying each mutation as it is made; a node joins its parent once its own
/// subtree is complete (one insert per subtree, as a framework's diff does).
struct Build {
  next: u32,
  pictures: [u32; 4],
}

impl Build {
  effect fn emit(self: &mut Self, tree: &mut UiTree<'_>, mutation: Mutation) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    run tree.applyOne(0, move mutation)
  }

  effect fn open(self: &mut Self, tree: &mut UiTree<'_>, kind: NodeKind, class: string) -> u32 ! TreeError | OutOfMemoryError ? &mut Allocator {
    let id = self.next
    self.next = id + 1
    run self.emit(&mut tree, Mutation.Create { id: id, kind: kind })
    if String.byteLength(class) != 0 {
      run self.emit(&mut tree, Mutation.SetAttribute { id: id, attribute: Attribute.ClassName { value: run String.copy(class) } })
    }
    return id
  }

  effect fn close(self: &mut Self, tree: &mut UiTree<'_>, parent: u32, id: u32) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    run self.emit(&mut tree, Mutation.InsertBefore { parent: parent, child: id, before: Option<u32>.None })
  }

  effect fn text(self: &mut Self, tree: &mut UiTree<'_>, parent: u32, value: string) -> u32 ! TreeError | OutOfMemoryError ? &mut Allocator {
    let id = self.next
    self.next = id + 1
    run self.emit(&mut tree, Mutation.Create { id: id, kind: NodeKind.Text })
    run self.emit(&mut tree, Mutation.SetText { id: id, value: run String.copy(value) })
    run self.close(&mut tree, parent, id)
    return id
  }

  /// A box with `class` holding text `value`, last in `parent`. Returns the text node.
  effect fn label(self: &mut Self, tree: &mut UiTree<'_>, parent: u32, class: string, value: string) -> u32 ! TreeError | OutOfMemoryError ? &mut Allocator {
    let box = run self.open(&mut tree, NodeKind.Box, class)
    let t = run self.text(&mut tree, box, value)
    run self.close(&mut tree, parent, box)
    return t
  }

  /// Inline text with its marks (*bold*, _italic_, `code`, [link]) into `parent`.
  effect fn inline(self: &mut Self, tree: &mut UiTree<'_>, parent: u32, value: string) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let bytes = String.utf8Bytes(value)
    let mut plain: usize = 0
    let mut at: usize = 0
    while at < bytes.length {
      let c = bytes[at]
      let close: u8 = if c == 42 { 42 } else if c == 95 { 95 } else if c == 96 { 96 } else if c == 91 { 93 } else { 0 }
      let mut end: usize = 0
      if close != 0 {
        let mut j = at + 1
        while j < bytes.length && bytes[j] != close {
          j = j + 1
        }
        if j < bytes.length && j > at + 1 {
          end = j
        }
      }
      if end != 0 {
        if at > plain {
          drop run self.text(&mut tree, parent, String.slice(value, plain, at - plain))
        }
        let class = if c == 42 { "b" } else if c == 95 { "i" } else if c == 96 { "k" } else { "a" }
        drop run self.label(&mut tree, parent, class, String.slice(value, at + 1, end - at - 1))
        at = end + 1
        plain = at
      } else {
        at = at + 1
      }
    }
    if bytes.length > plain {
      drop run self.text(&mut tree, parent, String.slice(value, plain, bytes.length - plain))
    }
  }

  /// A picture node, its resource loaded the first time any node shows it.
  effect fn picture(self: &mut Self, tree: &mut UiTree<'_>, parent: u32, index: u32, w: u32, h: u32) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let at = u32.toUsize(index % 4)
    let resource = 1000000 + index
    if self.pictures[at] == 0 {
      self.pictures[at] = resource
      run self.emit(&mut tree, Mutation.LoadImage { resource: resource, url: run String.copy(picture(index)) })
    }
    let node = run self.open(&mut tree, NodeKind.Image, "img")
    let mut style = List<Declaration>.make()
    run style.append(css.width(css.px(u32.toF32(w))))
    run style.append(css.height(css.px(u32.toF32(h))))
    run self.emit(&mut tree, Mutation.SetStyle { id: node, state: StyleState.Base, declarations: move style })
    run self.emit(&mut tree, Mutation.SetSource { id: node, resource: resource })
    run self.close(&mut tree, parent, node)
  }

  /// An item's header row from its `#` line, last in `item`.
  effect fn head(self: &mut Self, tree: &mut UiTree<'_>, item: u32, line: string<'static>) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let head = run self.open(&mut tree, NodeKind.Box, "head")
    let author = field(String.slice(line, 1, String.byteLength(line) - 1), 1)
    let mut avatar = run String.copy("avatar c")
    run appendNumber(&mut avatar, hash(author) % 8)
    let mut initials = String.make()
    let a = String.utf8Bytes(author)
    run initials.append(String.slice(author, 0, 1))
    let mut s = a.length
    while s > 0 && a[s - 1] != 32 {
      s = s - 1
    }
    run initials.append(String.slice(author, s, 1))
    drop run self.label(&mut tree, head, String.view(&avatar), String.view(&initials))
    let who = run self.open(&mut tree, NodeKind.Box, "who")
    drop run self.label(&mut tree, who, "name", author)
    drop run self.label(&mut tree, who, "time", field(line, 2))
    run self.close(&mut tree, head, who)
    let tags = run self.open(&mut tree, NodeKind.Box, "tags")
    let mut each = String.split(field(line, 3), ",")
    while true {
      match each.next() {
        Option.Some { value } => { drop run self.label(&mut tree, tags, "tag", value) }
        Option.None => { break }
      }
    }
    run self.close(&mut tree, head, tags)
    run self.close(&mut tree, item, head)
  }

  /// An item's footer from its counts (`replies,likes`), last in `item`. Returns its box.
  effect fn foot(self: &mut Self, tree: &mut UiTree<'_>, item: u32, counts: string) -> u32 ! TreeError | OutOfMemoryError ? &mut Allocator {
    let row = run self.open(&mut tree, NodeKind.Box, "foot")
    let mut split = String.split(counts, ",")
    let mut reply = run String.copy("Reply ")
    run reply.append(split.next() |> Option<string>.unwrapOr("0"))
    let mut like = run String.copy("Like ")
    run like.append(split.next() |> Option<string>.unwrapOr("0"))
    drop run self.label(&mut tree, row, "act", String.view(&reply))
    drop run self.label(&mut tree, row, "act", String.view(&like))
    drop run self.label(&mut tree, row, "act", "Share")
    run self.close(&mut tree, item, row)
    return row
  }

  /// Item `lines` (one item of the corpus) as the scenes show it, last in `parent`. Returns the
  /// item's box and its last paragraph's box.
  effect fn item(self: &mut Self, tree: &mut UiTree<'_>, parent: u32, lines: string<'static>) -> u32 ! TreeError | OutOfMemoryError ? &mut Allocator {
    let item = run self.open(&mut tree, NodeKind.Box, "item")
    let mut split = String.split(lines, "\n")
    let mut list: u32 = 0
    let mut pre: u32 = 0
    let mut table: u32 = 0
    let mut header = true
    let mut foot = String.make()
    while true {
      let line = match split.next() {
        Option.Some { value } => value
        Option.None => { break }
      }
      let bytes = String.utf8Bytes(line)
      if bytes.length == 0 {
        continue
      }
      let kind = bytes[0]
      // A run of list items, code lines or table rows ends at the first other line.
      if list != 0 && kind != 76 {
        run self.close(&mut tree, item, list)
        list = 0
      }
      if pre != 0 && kind != 67 {
        run self.close(&mut tree, item, pre)
        pre = 0
      }
      if table != 0 && kind != 84 {
        run self.close(&mut tree, item, table)
        table = 0
      }
      if kind == 35 {
        run self.head(&mut tree, item, line)
        run foot.append(field(line, 4))
        continue
      }
      let rest = String.slice(line, 2, bytes.length - 2)
      if kind == 80 || kind == 81 {
        let p = run self.open(&mut tree, NodeKind.Box, if kind == 80 { "p" } else { "q" })
        run self.inline(&mut tree, p, rest)
        run self.close(&mut tree, item, p)
      } else if kind == 72 {
        let h = run self.open(&mut tree, NodeKind.Box, "h")
        run self.inline(&mut tree, h, rest)
        run self.close(&mut tree, item, h)
      } else if kind == 76 {
        if list == 0 {
          list = run self.open(&mut tree, NodeKind.Box, "ul")
        }
        let li = run self.open(&mut tree, NodeKind.Box, "li")
        let dot = run self.open(&mut tree, NodeKind.Box, "dot")
        run self.close(&mut tree, li, dot)
        let lt = run self.open(&mut tree, NodeKind.Box, "lt")
        run self.inline(&mut tree, lt, rest)
        run self.close(&mut tree, li, lt)
        run self.close(&mut tree, list, li)
      } else if kind == 67 {
        if pre == 0 {
          pre = run self.open(&mut tree, NodeKind.Box, "pre")
        }
        drop run self.label(&mut tree, pre, "cl", rest)
      } else if kind == 84 {
        if table == 0 {
          let cells = String.utf8Bytes(rest)
          let mut columns: usize = 1
          let mut c: usize = 0
          while c < cells.length {
            if cells[c] == 124 { columns = columns + 1 }
            c = c + 1
          }
          table = run self.open(&mut tree, NodeKind.Box, if columns == 3 { "t3" } else { "t4" })
          header = true
        }
        let mut cells = String.split(rest, "|")
        while true {
          match cells.next() {
            Option.Some { value } => { drop run self.label(&mut tree, table, if header { "th" } else { "td" }, value) }
            Option.None => { break }
          }
        }
        header = false
      } else if kind == 73 {
        let mut parts = String.split(rest, " ")
        let p = number(parts.next() |> Option<string<'static>>.unwrapOr("0"))
        let w = number(parts.next() |> Option<string<'static>>.unwrapOr("0"))
        let h = number(parts.next() |> Option<string<'static>>.unwrapOr("0"))
        let caption = parts.remainder() |> Option<string<'static>>.unwrapOr("")
        let fig = run self.open(&mut tree, NodeKind.Box, "fig")
        run self.picture(&mut tree, fig, p, w, h)
        drop run self.label(&mut tree, fig, "cap", caption)
        run self.close(&mut tree, item, fig)
      }
    }
    if list != 0 {
      run self.close(&mut tree, item, list)
    }
    if pre != 0 {
      run self.close(&mut tree, item, pre)
    }
    if table != 0 {
      run self.close(&mut tree, item, table)
    }
    drop run self.foot(&mut tree, item, String.view(&foot))
    run self.close(&mut tree, parent, item)
    return item
  }
}

// ---------- scenes ----------

enum Kind { Feed, Wall, Stream, Churn }

const COLUMNS: u32 = 16
const ROWS: u32 = 34
const CELLS: u32 = 544
const NOTES: usize = 24

/// The scene: its nodes and the script's position.
struct Scene {
  kind: Kind,
  size: usize,
  corpus: Corpus,
  build: Build,
  scroller: u32,
  content: u32,
  viewHeight: f64,
  contentHeight: f64,
  // wall: the value text node of each cell, its box, and the values.
  cellBoxes: List<u32>,
  cellTexts: List<u32>,
  // stream
  words: List<string<'static>>,
  nextWord: usize,
  written: u32,
  made: usize,
  paragraph: String,
  body: u32,
  writing: u32,
  footer: u32,
  // churn: the items now in the feed
  shown: List<u32>,
  // the script
  step: usize,
  stepFrame: u32,
  stepStart: f64,
  frames: u32,
  lastTime: f64,
  top: f64,
  swept: bool,
  times: List<f64>,
  started: bool,
  painted: bool,
  windowless: bool,
  done: bool,
}

/// One step of a scene's script.
enum Op { Idle, Mark, Drive, Done }

struct Step {
  op: Op,
  name: string<'static>,
  /// Idle: milliseconds. Drive: frames (0 = until the driver says it is done).
  amount: u32,
}

fn sizeOf(name: string) -> usize {
  let bytes = String.utf8Bytes(name)
  let mut at: usize = 0
  while at < bytes.length && bytes[at] != 45 {
    at = at + 1
  }
  if at >= bytes.length {
    return 0
  }
  return u32.toUsize(number(String.slice(name, at + 1, bytes.length - at - 1)))
}

fn kindOf(name: string) -> Kind {
  if String.startsWith(name, "wall") { return Kind.Wall }
  if String.startsWith(name, "stream") { return Kind.Stream }
  if String.startsWith(name, "churn") { return Kind.Churn }
  return Kind.Feed
}

fn script(kind: Kind, size: usize, at: usize) -> Step {
  if kind == Kind.Feed {
    if at == 0 { return Step { op: Op.Idle, name: "loaded", amount: 3000 } }
    if at == 1 { return Step { op: Op.Mark, name: "loaded", amount: 0 } }
    if at == 2 { return Step { op: Op.Drive, name: "scroll", amount: 600 } }
    if at == 3 { return Step { op: Op.Drive, name: "sweep", amount: 0 } }
    if at == 4 { return Step { op: Op.Idle, name: "swept", amount: 3000 } }
    if at == 5 { return Step { op: Op.Mark, name: "swept", amount: 0 } }
  } else if kind == Kind.Wall {
    if at == 0 { return Step { op: Op.Idle, name: "loaded", amount: 3000 } }
    if at == 1 { return Step { op: Op.Mark, name: "loaded", amount: 0 } }
    if at == 2 { return Step { op: Op.Drive, name: "update", amount: 600 } }
    if at == 3 { return Step { op: Op.Drive, name: "pan", amount: 600 } }
    if at == 4 { return Step { op: Op.Mark, name: "end", amount: 0 } }
  } else if kind == Kind.Stream {
    if at == 0 { return Step { op: Op.Idle, name: "loaded", amount: 3000 } }
    if at == 1 { return Step { op: Op.Mark, name: "loaded", amount: 0 } }
    if at == 2 { return Step { op: Op.Drive, name: "stream", amount: 900 } }
    if at == 3 { return Step { op: Op.Idle, name: "streamed", amount: 3000 } }
    if at == 4 { return Step { op: Op.Mark, name: "streamed", amount: 0 } }
  } else {
    let grow = usize.toU32((size + 24) / 25)
    if at == 0 { return Step { op: Op.Idle, name: "base", amount: 1000 } }
    if at == 1 { return Step { op: Op.Mark, name: "base", amount: 0 } }
    if at == 2 { return Step { op: Op.Drive, name: "grow-1", amount: grow } }
    if at == 3 { return Step { op: Op.Idle, name: "full-1", amount: 1000 } }
    if at == 4 { return Step { op: Op.Mark, name: "full-1", amount: 0 } }
    if at == 5 { return Step { op: Op.Drive, name: "clear-1", amount: 1 } }
    if at == 6 { return Step { op: Op.Idle, name: "empty-1", amount: 1500 } }
    if at == 7 { return Step { op: Op.Mark, name: "empty-1", amount: 0 } }
    if at == 8 { return Step { op: Op.Drive, name: "grow-2", amount: grow } }
    if at == 9 { return Step { op: Op.Idle, name: "full-2", amount: 1000 } }
    if at == 10 { return Step { op: Op.Mark, name: "full-2", amount: 0 } }
    if at == 11 { return Step { op: Op.Drive, name: "clear-2", amount: 1 } }
    if at == 12 { return Step { op: Op.Idle, name: "empty-2", amount: 1500 } }
    if at == 13 { return Step { op: Op.Mark, name: "empty-2", amount: 0 } }
    if at == 14 { return Step { op: Op.Drive, name: "grow-3", amount: grow } }
    if at == 15 { return Step { op: Op.Idle, name: "full-3", amount: 1000 } }
    if at == 16 { return Step { op: Op.Mark, name: "full-3", amount: 0 } }
    if at == 17 { return Step { op: Op.Drive, name: "clear-3", amount: 1 } }
    if at == 18 { return Step { op: Op.Idle, name: "empty-3", amount: 1500 } }
    if at == 19 { return Step { op: Op.Mark, name: "empty-3", amount: 0 } }
  }
  return Step { op: Op.Done, name: "", amount: 0 }
}

impl Scene {
  effect fn make(name: string, windowless: bool) -> Scene ! OutOfMemoryError ? &mut Allocator {
    let kind = kindOf(name)
    let asked = sizeOf(name)
    let size: usize = if asked != 0 { asked } else if kind == Kind.Feed { 1000 } else if kind == Kind.Stream { 300 } else if kind == Kind.Churn { 1000 } else { 0 }
    return Scene {
      kind: kind, size: size, corpus: run Corpus.make(), build: Build { next: 1, pictures: [0; 4] },
      scroller: 0, content: 0, viewHeight: 0.0, contentHeight: 0.0,
      cellBoxes: List<u32>.make(), cellTexts: List<u32>.make(),
      words: List<string<'static>>.make(), nextWord: 0, written: 0, made: 0, paragraph: String.make(), body: 0, writing: 0, footer: 0,
      shown: List<u32>.make(),
      step: 0, stepFrame: 0, stepStart: 0.0, frames: 0, lastTime: -1.0, top: 0.0, swept: false, times: List<f64>.make(),
      started: false, painted: false, windowless: windowless, done: false,
    }
  }

  /// The window: a bar and a scroller, the scene's content in it.
  effect fn start(self: &mut Self, tree: &mut UiTree<'_>) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let b = &mut self.build
    let root = b.next
    b.next = root + 1
    let mut style = List<Declaration>.make()
    run style.append(css.display(Keyword.Flex))
    run style.append(css.flexDirection(FlexDirection.Column))
    run style.append(css.width(css.percent(100.0)))
    run style.append(css.height(css.percent(100.0)))
    run style.append(css.boxSizing(BoxSizing.BorderBox))
    run b.emit(&mut tree, Mutation.Create { id: root, kind: NodeKind.Box })
    run b.emit(&mut tree, Mutation.SetStyle { id: root, state: StyleState.Base, declarations: move style })
    run b.emit(&mut tree, Mutation.OpenRoot { root: FIRST_ROOT, node: root, options: RootOptions.default() })
    let app = run b.open(&mut tree, NodeKind.Box, "app")
    let mut title = run String.copy("xbench ")
    if self.kind == Kind.Feed { run title.append("feed-") } else if self.kind == Kind.Stream { run title.append("stream-") } else if self.kind == Kind.Churn { run title.append("churn-") } else { run title.append("wall") }
    if self.kind != Kind.Wall { run appendNumber(&mut title, usize.toU32(self.size)) }
    drop run b.label(&mut tree, app, "bar", String.view(&title))
    let scroller = run b.open(&mut tree, NodeKind.Box, "scroll")
    run b.emit(&mut tree, Mutation.SetListeners { id: scroller, flags: LISTEN_LAYOUT })
    self.scroller = scroller
    if self.kind == Kind.Wall {
      let wall = run b.open(&mut tree, NodeKind.Box, "wall")
      let cells = run b.open(&mut tree, NodeKind.Box, "cells")
      let mut i: u32 = 0
      let mut label = String.make()
      while i < CELLS {
        let value = (i * 7919) % 10000
        label.clear()
        run label.append("cell cl")
        run appendNumber(&mut label, value % 8)
        let cell = run b.open(&mut tree, NodeKind.Box, String.view(&label))
        label.clear()
        run label.append("cell ")
        run appendNumber(&mut label, i)
        drop run b.label(&mut tree, cell, "cn", String.view(&label))
        label.clear()
        run appendNumber(&mut label, value)
        let t = run b.label(&mut tree, cell, "cv", String.view(&label))
        run b.close(&mut tree, cells, cell)
        run self.cellBoxes.append(cell)
        run self.cellTexts.append(t)
        i = i + 1
      }
      run b.close(&mut tree, wall, cells)
      let notes = run b.open(&mut tree, NodeKind.Box, "notes")
      let mut n: usize = 0
      while n < NOTES {
        let lines = self.corpus.item(n)
        let mut split = String.split(lines, "\n")
        while true {
          match split.next() {
            Option.Some { value } => {
              if String.startsWith(value, "P ") {
                let note = run b.open(&mut tree, NodeKind.Box, "note")
                run b.inline(&mut tree, note, String.slice(value, 2, String.byteLength(value) - 2))
                run b.close(&mut tree, notes, note)
                break
              }
            }
            Option.None => { break }
          }
        }
        n = n + 1
      }
      run b.close(&mut tree, wall, notes)
      run b.close(&mut tree, scroller, wall)
    } else {
      // `XB_CONTENT_VISIBILITY=1`: items get `content-visibility: auto` (style/bench.css).
      let lazy = (run environmentVariable("XB_CONTENT_VISIBILITY")).isSome()
      let feed = run b.open(&mut tree, NodeKind.Box, if lazy { "feed lazy" } else { "feed" })
      run b.emit(&mut tree, Mutation.SetListeners { id: feed, flags: LISTEN_LAYOUT })
      self.content = feed
      if self.kind != Kind.Churn {
        let mut i: usize = 0
        while i < self.size {
          drop run b.item(&mut tree, feed, self.corpus.item(i))
          i = i + 1
        }
      }
      run b.close(&mut tree, scroller, feed)
    }
    run b.close(&mut tree, app, scroller)
    run b.close(&mut tree, root, app)
    if self.kind == Kind.Stream {
      run b.emit(&mut tree, Mutation.ScrollTo { id: scroller, x: 0.0, y: 100000000.0 })
      // The words the stream writes: the paragraphs of the items after the transcript.
      let mut i = self.size
      while i < self.size + 200 && i < self.corpus.count() {
        let mut split = String.split(self.corpus.item(i), "\n")
        while true {
          match split.next() {
            Option.Some { value } => {
              if String.startsWith(value, "P ") {
                let mut words = String.split(String.slice(value, 2, String.byteLength(value) - 2), " ")
                while true {
                  match words.next() {
                    Option.Some { value: w } => { if String.byteLength(w) != 0 { run self.words.append(w) } }
                    Option.None => { break }
                  }
                }
              }
            }
            Option.None => { break }
          }
        }
        i = i + 1
      }
    }
  }

  fn hear(self: &mut Self, events: &[Event]) -> () {
    let mut e: usize = 0
    while e < events.length {
      let event = &events[e]
      if event.kind == EventKind.Layout {
        let height = f32.toF64(event.bounds.yMax - event.bounds.yMin)
        if event.target == self.scroller {
          self.viewHeight = height
        } else if event.target == self.content {
          self.contentHeight = height
        }
      }
      e = e + 1
    }
  }

  fn maxScroll(self: &Self) -> f64 {
    return f64.max(self.contentHeight - self.viewHeight, 0.0)
  }

  /// One frame of driver `name`, the `f`th. False when the driver is done before its count.
  effect fn drive(self: &mut Self, tree: &mut UiTree<'_>, name: string, f: u32) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    if name == "scroll" {
      self.top = self.top + 24.0
      run self.build.emit(&mut tree, Mutation.ScrollTo { id: self.scroller, x: 0.0, y: f64.toF32(self.top) })
    } else if name == "sweep" {
      if self.swept {
        return false
      }
      self.top = self.top + 720.0
      if self.top >= self.maxScroll() {
        self.top = 0.0
        self.swept = true
      }
      run self.build.emit(&mut tree, Mutation.ScrollTo { id: self.scroller, x: 0.0, y: f64.toF32(self.top) })
    } else if name == "update" {
      let mut label = String.make()
      let mut k: u32 = 0
      while k < 32 {
        let i = ((f * 32 + k) * 37) % CELLS
        let value = (f * 31 + k * 7 + i) % 10000
        label.clear()
        run appendNumber(&mut label, value)
        run self.build.emit(&mut tree, Mutation.SetText { id: self.cellTexts.asSlice()[u32.toUsize(i)], value: run String.copy(String.view(&label)) })
        label.clear()
        run label.append("cell cl")
        run appendNumber(&mut label, value % 8)
        run self.build.emit(&mut tree, Mutation.SetAttribute { id: self.cellBoxes.asSlice()[u32.toUsize(i)], attribute: Attribute.ClassName { value: run String.copy(String.view(&label)) } })
        k = k + 1
      }
    } else if name == "pan" {
      let y = if f < 300 { u32.toF64(f + 1) } else { u32.toF64(599 - f) }
      run self.build.emit(&mut tree, Mutation.ScrollTo { id: self.scroller, x: 0.0, y: f64.toF32(y) })
    } else if name == "stream" {
      run self.stream(&mut tree)
    } else if String.startsWith(name, "grow-") {
      let cycle = u32.toUsize(number(String.slice(name, 5, 1))) - 1
      let mut i: usize = 0
      while i < 25 && self.shown.length() < self.size {
        let n = cycle * 1000 + self.shown.length()
        let made = run self.build.item(&mut tree, self.content, self.corpus.item(n % self.corpus.count()))
        run self.shown.append(made)
        i = i + 1
      }
    } else if String.startsWith(name, "clear-") {
      let shown = self.shown.asSlice()
      let mut i: usize = 0
      while i < shown.length {
        run self.build.emit(&mut tree, Mutation.Destroy { id: shown[i] })
        i = i + 1
      }
      self.shown.clear()
    }
    return true
  }

  /// One frame of the stream: three more words; a new paragraph every 60, a new item every 240.
  /// The paragraph being written is made again each frame with its marks (as React renders
  /// `spans(paragraph)`), before the item's footer.
  effect fn stream(self: &mut Self, tree: &mut UiTree<'_>) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let b = &mut self.build
    if self.written % 240 == 0 {
      // A new item: the next author's header and footer, no blocks yet.
      let header = match String.split(self.corpus.item(self.size + self.made % 50), "\n").next() { Option.Some { value } => value Option.None => "" }
      let item = run b.open(&mut tree, NodeKind.Box, "item")
      run b.head(&mut tree, item, header)
      self.footer = run b.foot(&mut tree, item, field(header, 4))
      run b.close(&mut tree, self.content, item)
      self.body = item
      self.made = self.made + 1
    }
    if self.written % 60 == 0 {
      self.paragraph.clear()
      self.writing = 0
    }
    let mut k: u32 = 0
    while k < 3 {
      if self.paragraph.ownedByteLength() != 0 {
        run self.paragraph.append(" ")
      }
      let words = self.words.asSlice()
      run self.paragraph.append(words[self.nextWord % words.length])
      self.nextWord = self.nextWord + 1
      k = k + 1
    }
    self.written = self.written + 3
    if self.writing != 0 {
      run b.emit(&mut tree, Mutation.Destroy { id: self.writing })
    }
    let p = run b.open(&mut tree, NodeKind.Box, "p")
    run b.inline(&mut tree, p, String.view(&self.paragraph))
    run b.emit(&mut tree, Mutation.InsertBefore { parent: self.body, child: p, before: Option<u32>.Some { value: self.footer } })
    self.writing = p
    run b.emit(&mut tree, Mutation.ScrollTo { id: self.scroller, x: 0.0, y: 100000000.0 })
  }

  /// A frame at `time` seconds: the script's next move.
  effect fn frame(self: &mut Self, tree: &mut UiTree<'_>, time: f64) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    if time == self.lastTime || self.done {
      return ()
    }
    self.lastTime = time
    let now = time * 1000.0
    self.frames = self.frames + 1
    if !self.painted {
      // Windowless: the frame after the first one, whose layout and paint are done. In a
      // window, `presented` says when the first frame reached the screen.
      if self.windowless && self.frames >= 2 {
        self.painted = true
        say("first-paint")
        self.stepStart = now
      }
      return ()
    }
    let step = script(self.kind, self.size, self.step)
    if step.op == Op.Done {
      say("done")
      self.done = true
      return ()
    }
    if step.op == Op.Idle {
      if self.stepFrame == 0 {
        say2("idle-begin", step.name)
        self.stepStart = now
        self.stepFrame = 1
      } else if now - self.stepStart >= u32.toF64(step.amount) {
        say2("idle-end", step.name)
        self.next(now)
      }
      return ()
    }
    if step.op == Op.Mark {
      if self.stepFrame == 0 {
        say2("mark", step.name)
        self.stepStart = now
        self.stepFrame = 1
      } else if now - self.stepStart >= 400.0 {
        self.next(now)
      }
      return ()
    }
    // A driver: the first frame says begin; each later frame records its time and moves.
    if self.stepFrame == 0 {
      say2("begin", step.name)
      self.times.clear()
      self.stepFrame = 1
      return ()
    }
    run self.times.append(now)
    let f = self.stepFrame - 1
    let more = if step.amount != 0 && f >= step.amount { false } else { run self.drive(&mut tree, step.name, f) }
    if !more {
      StderrWriter.print("XB end {} {}\n", &(step.name, f))
      let mut gaps = String.make()
      let times = self.times.asSlice()
      let mut i: usize = 1
      while i < times.length {
        if i > 1 { run gaps.append(",") }
        let ms = times[i] - times[i - 1]
        run appendNumber(&mut gaps, f64.toU32(ms))
        run gaps.append(".")
        let frac = f64.toU32((ms - f64.floor(ms)) * 1000.0)
        if frac < 100 { run gaps.append("0") }
        if frac < 10 { run gaps.append("0") }
        run appendNumber(&mut gaps, frac)
        i = i + 1
      }
      StderrWriter.print("XB frames {} {}\n", &(step.name, String.view(&gaps)))
      self.next(now)
      return ()
    }
    self.stepFrame = self.stepFrame + 1
  }

  fn next(self: &mut Self, now: f64) -> () {
    self.step = self.step + 1
    self.stepFrame = 0
    self.stepStart = now
  }

  /// Whether the script wants frames: not while it idles or holds after a mark.
  fn wantsFrames(self: &Self) -> bool {
    if !self.painted || self.done {
      return !self.done
    }
    let step = script(self.kind, self.size, self.step)
    return step.op == Op.Drive || self.stepFrame == 0
  }

  fn deadline(self: &Self) -> Option<f64> {
    let step = script(self.kind, self.size, self.step)
    if step.op == Op.Idle {
      return Option<f64>.Some { value: (self.stepStart + u32.toF64(step.amount)) / 1000.0 }
    }
    if step.op == Op.Mark {
      return Option<f64>.Some { value: (self.stepStart + 400.0) / 1000.0 }
    }
    return Option<f64>.None
  }
}

// ---------- the host ----------

struct Client {
  loader: Loader,
  sheets: StyleAssets,
  events: List<Event>,
}

impl Client {
  effect fn hear(self: &mut Self, state: &mut Scene, tree: &mut UiTree<'_>) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    self.events.clear()
    run tree.takeEvents(&mut self.events)
    if self.events.length() != 0 {
      state.hear(self.events.asSlice())
    }
  }
}

impl WindowClient<Scene, never, never> for Client {
  fn configure(self: &Self, state: &Scene, options: &mut WindowOptions<'_>) -> () {
    options.titleBar = TitleBar.Transparent
    options.titleBarHeight = 40.0
    options.controlsLeft = 14.0
    options.controlsTop = 12.0
  }

  effect fn start(self: &mut Self, state: &mut Scene, tree: &mut UiTree<'_>) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    run state.start(&mut tree)
    drop run self.loader.serve(&mut tree)
  }

  effect fn pump(self: &mut Self, state: &mut Scene, tree: &mut UiTree<'_>) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    run self.hear(&mut state, &mut tree)
  }

  // Every poll: the loads the last layout asked for (the sheet's @font-face files) are only in
  // the tree's records, so `loader.pending()` is false until they are taken. Loom's host serves
  // the loader on every poll too.
  effect fn poll(self: &mut Self, state: &mut Scene, tree: &mut UiTree<'_>, time: f64) -> bool ! WindowError | TreeError | OutOfMemoryError ? &mut Allocator {
    return run self.loader.serve(&mut tree)
  }

  // While loads run, wake about once a frame to collect them (as Loom's host does).
  fn wakeAfter(self: &Self, state: &Scene) -> Option<f64> {
    if self.loader.pending() {
      return Option<f64>.some(0.016)
    }
    return Option<f64>.None
  }

  effect fn tick(self: &mut Self, state: &mut Scene, tree: &mut UiTree<'_>, time: f64, animation: bool) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    run state.frame(&mut tree, time)
  }

  effect fn layout(self: &mut Self, state: &mut Scene, tree: &mut UiTree<'_>, input: FrameInput) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let root = tree.current
    drop run self.sheets.serve(&mut tree, root)
    let mut pass: usize = 0
    while pass < 8 {
      run tree.frameRoot(FIRST_ROOT, input)
      run self.hear(&mut state, &mut tree)
      if !tree.needsFrameOf(FIRST_ROOT) {
        return ()
      }
      pass = pass + 1
    }
  }

  effect fn presented(self: &mut Self, state: &mut Scene, intervals: &[f64], dropped: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    if !state.painted {
      state.painted = true
      say("first-paint")
    }
  }

  fn wantsFrames(self: &Self, state: &Scene) -> bool {
    return state.wantsFrames()
  }

  fn nextDeadline(self: &Self, state: &Scene) -> Option<f64> {
    return state.deadline()
  }

  fn quitting(self: &Self, state: &Scene) -> bool {
    return false
  }

  fn servesInspector(self: &Self) -> bool {
    return false
  }
}

effect fn noFonts(error: HostInputError) -> () {
  drop error
}

effect fn loadFonts(collection: &mut FontCollection) -> () ! HostInputError | OutOfMemoryError ? &mut Allocator {
  let snapshot = run unsafe NativeHostInput.environmentSnapshot()
  let mut inputs = OsHostInput.make(move snapshot)
  drop run fontFiles.load(&mut collection, FontOptions.defaults())
    |> Effect.provideMut<HostInput>(&mut inputs)
}

/// The installed fonts, for fallback only: the scenes' own faces come from the sheet.
effect fn systemFonts() -> FontCollection ! OutOfMemoryError ? &mut Allocator {
  let mut collection = FontCollection.make()
  run Effect.catch<HostInputError>(loadFonts(&mut collection), noFonts)
  return move collection
}

effect fn launch(name: String, windowless: bool) -> i32
  ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run systemFonts()
  let mut state = run Scene.make(String.view(&name), windowless)
  let mut client = Client {
    loader: Loader.make(),
    sheets: run StyleAssets.from(&[Source.read("assets/app.sheet")]),
    events: List<Event>.make(),
  }
  let options = RunOptions {
    title: "xbench",
    width: WIDTH,
    height: HEIGHT,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: Option<Launched>.None,
    gpu: Option<StartedGpu>.None,
  }
  return run runWindow(&mut state, &fonts, List<Mutation>.make(), move options, Inspector.off(), &mut client)
}

effect fn sceneAsked() -> String ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  if (run HostInput.argumentCount()) > 1 {
    if let Option<Bytes>.Some { value } = run HostInput.argument(1) {
      return run String.copy(text(Bytes.asSlice(&value)))
    }
  }
  return run String.copy("feed")
}

effect fn feedDefault<E>(error: E) -> String {
  drop error
  return String.make()
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("silk-direct: failed (tree, window, atlas, geometry or allocation)\n", &())
  return 2
}

effect fn unset<E>(error: E) -> bool {
  drop error
  return false
}

effect fn benchAsked() -> bool ! OutOfMemoryError ? &mut Allocator {
  return (run environmentVariable("SILK_UI_BENCH")).isSome()
}

effect fn noScene(error: OutOfMemoryError) -> String {
  drop error
  return String.make()
}

pub effect fn main() -> i32 ? &mut HostInput {
  // Freed pages go back to the system on macOS; it may restart the process, so it comes first.
  process_memory.useSpaceEfficientMalloc()
  let mut allocator = Allocator.systemAllocatorProvider()
  let scene = run Effect.catchAll(sceneAsked(), feedDefault)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let windowless = run Effect.catchAll(benchAsked(), unset)
    |> Effect.provideMut<Allocator>(&mut allocator)
  return run Effect.catchAll(launch(move scene, windowless), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
