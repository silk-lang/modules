//! Where the loader reads modules from: the [`ModuleResolver`] implementations the core ships.
//! `NodeResolution` reads the files of the operating system, as Node does; `MemoryModules`
//! serves a module graph the embedder bundled into the program, with no file system at all.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.num.i64
import silk.num.isize
import silk.num.usize
import silkjs.js_os_platform as os
import libs.core.capabilities { ModuleResolver, MODULE_FILE, MODULE_DIRECTORY }

const ENOENT: i32 = 2
const EINTR: i32 = 4
const EISDIR: i32 = 21

/// `path` followed by a NUL, for libc.
effect fn terminated(path: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = List<u8>.make()
  run bytes.reserveExact(path.length + 1)
  run bytes.appendBytes(path)
  run bytes.append(0)
  return move bytes
}

/// The operating system's files: Node's module resolution reads them directly.
pub struct NodeResolution {}
impl Copy for NodeResolution {}
impl ModuleResolver for NodeResolution {
  fn forWorker(self: &Self) -> Self { return NodeResolution {} }
  effect fn kind(self: &Self, path: &[u8], follow: bool) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let name = run terminated(path)
    let mut stat = os.Stat { fields: [0; 12] }
    let status = unsafe os.stat(Pointer.fromRef<u8>(&name.asSlice()[0]), !follow, &mut stat)
    if status < 0 { return status }
    return i64.toI32(stat.fields[2] & 0o170000)
  }
  effect fn realpath(self: &Self, path: &[u8], into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let name = run terminated(path)
    let mut buffer = List<u8>.make()
    run buffer.appendRepeated(0, os.pathMax() + 1)
    let data = Pointer.fromMutRef<u8>(&mut buffer.asMutSlice()[0])
    if Pointer.isNull<u8>(unsafe os.realpath(Pointer.fromRef<u8>(&name.asSlice()[0]), data)) { return -os.errno() }
    let length = unsafe os.length(data)
    run into.appendBytes(Slice.view(buffer.asSlice(), 0, length))
    return 0
  }
  effect fn read(self: &Self, path: &[u8], into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let name = run terminated(path)
    let fd = unsafe os.open(Pointer.fromRef<u8>(&name.asSlice()[0]), 0)
    if fd < 0 { return -os.errno() }
    let mut chunk: [u8; 65536] = [0; 65536]
    while true {
      let count = unsafe os.read(fd, Pointer.fromMutRef<u8>(&mut chunk[0]), 65536)
      if count < 0 {
        let error = os.errno()
        if error == EINTR { continue }
        let _closed = unsafe os.close(fd)
        return -error
      }
      if count == 0 { break }
      run into.appendBytes(Slice.view(&chunk, 0, isize.toUsize(count)))
    }
    let _closed = unsafe os.close(fd)
    return 0
  }
}

/// One module of a bundled graph: its absolute path and its source.
pub struct MemoryModule { pub path: &'static [u8], pub source: &'static [u8] }
impl Copy for MemoryModule {}

/// A module graph bundled into the program. Each module is a file at its path, every prefix of
/// a path that ends before a `/` is a directory, and there are no links; nothing else is there.
/// `require` and `import` resolve as Node's do, against these paths.
pub struct MemoryModules { modules: &'static [MemoryModule] }
impl Copy for MemoryModules {}
impl MemoryModules {
  pub fn make(modules: &'static [MemoryModule]) -> Self { return MemoryModules { modules: modules } }
  fn find(self: &Self, path: &[u8]) -> i32 {
    let mut index: usize = 0
    while index < self.modules.length {
      let candidate = self.modules[index].path
      if same(candidate, path) { return MODULE_FILE }
      if candidate.length > path.length && startsWith(candidate, path) && (path.length == 0 || path[path.length - 1] == 47 || candidate[path.length] == 47) { return MODULE_DIRECTORY }
      index = index + 1
    }
    return -ENOENT
  }
}
fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  if text.length < prefix.length { return false }
  let mut at: usize = 0
  while at < prefix.length { if text[at] != prefix[at] { return false } at = at + 1 }
  return true
}
fn same(a: &[u8], b: &[u8]) -> bool { return a.length == b.length && startsWith(a, b) }
impl ModuleResolver for MemoryModules {
  fn forWorker(self: &Self) -> Self { return MemoryModules { modules: self.modules } }
  effect fn kind(self: &Self, path: &[u8], follow: bool) -> i32 ! OutOfMemoryError ? &mut Allocator { return self.find(path) }
  effect fn realpath(self: &Self, path: &[u8], into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let kind = self.find(path)
    if kind < 0 { return kind }
    run into.appendBytes(path)
    return 0
  }
  effect fn read(self: &Self, path: &[u8], into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let mut index: usize = 0
    while index < self.modules.length {
      let module = self.modules[index]
      if same(module.path, path) {
        run into.appendBytes(module.source)
        return 0
      }
      index = index + 1
    }
    let kind = self.find(path)
    if kind == MODULE_DIRECTORY { return -EISDIR }
    return -ENOENT
  }
}
