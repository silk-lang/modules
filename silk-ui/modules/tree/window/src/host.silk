//! Native GPU window lifecycle for any retained-tree client.
//! Implement WindowClient to handle events and supply mutations. The host owns the window,
//! GPU surface, input integration, accessibility publication, inspection, and frame scheduling.
//!
//! The first root is the window `runWindow` opens. Every other root the client opens gets an
//! OS window of its own, drawn by the same render thread on a surface of its own: the host
//! opens it when the root opens, applies the title and size of an `UpdateRoot`, and closes it
//! when the root closes. Its events reach its root (`beginAt`, `reportRoot`); a request to
//! close it is only a `CloseRequested` root event, which the client answers or not. Such a
//! window is framed only when its root needs a frame (`needsFrameOf`), has no compositor
//! scrolling and publishes no accessibility tree.
//!
//! `runWindowWith` also runs a [`Companion`] beside the client, in the same tree, on roots of
//! its own: the host hands it the input, records and frames of those roots, every key first,
//! and the inspector. Its root shows in a window of its own, or docked in the first window, the
//! client's first root then laid out in the rest (see `companion.silk`).
import ui_scene.scene { Scene }
import ui_tree.inspect { findAll }
import ui_tree.legacy { UiTree, TreeError, FrameInput, CpuSnapshot, Mutation }
import lib { toInputAt, showCursor, HostState, serve, coalesce, editMenuEvent }
import adapter { fastScrollOf, reportWindow, reportWindowOf }
import browser { stylePreferences }
import ui_tree.style_media { Preferences }
import window.types { Appearance }
import ui_tree.lib { RootSupport, RootEventKind, ExtraRoot, RootOptions }
import ui_tree.mutation { FIRST_ROOT }
import ui_tree.process_memory
import render_thread { FastScroll, FastScrolled, Grab, RenderSettings }
import canvas_frames { CanvasPresenter }
import canvas_bitmaps { CanvasRasterizer, presentCanvasBitmaps }
import ui_scene.primitives { SURFACE_TEXTURE_BASE, surfaceOfTexture }
import companion { Companion, Dock, NoCompanion, Paired, dockTarget, pointed }
import screen_reader { ScreenReader, VARIABLE as SCREEN_READER_VARIABLE }
import silk.trace { Trace as Prof }

static if Intrinsic.targetArchitecture() == "wasm32" {
  // No threads in the browser: frames are drawn on this thread (render_inline.silk).
  import render_inline { InlineRenderer as RenderThread }

  /// What the renderer needs once the window exists; in the browser nothing starts before.
  struct EarlyRenderer {
    settings: RenderSettings,
    /// GPU canvas frames: nothing shows them in the browser yet.
    canvases: CanvasPresenter,
  }

  impl EarlyRenderer {
    fn canvasPresenter(self: &Self) -> CanvasPresenter {
      return self.canvases.clone()
    }
  }

  effect fn prepareRenderer(settings: RenderSettings, cache: String) -> EarlyRenderer
    ! GpuError | OutOfMemoryError {
    drop cache
    let mut heap = Allocator.systemAllocatorProvider()
    let canvases = run CanvasPresenter.detached()
      |> Effect.provideMut<Allocator>(&mut heap)
    return EarlyRenderer { settings: settings, canvases: move canvases }
  }

  effect fn attachRenderer(early: EarlyRenderer, raw: RawSurface, window: WindowId) -> RenderThread
    ! GpuError | OutOfMemoryError {
    return run RenderThread.start(raw, window, early.settings)
  }

  /// A window's GPU started before [`runWindow`], with [`startGpu`]. In the browser it holds
  /// only the settings, since there the device is made with the canvas.
  pub struct StartedGpu {
    early: Option<EarlyRenderer>,
  }

  impl StartedGpu {
    effect fn started(check: bool) -> StartedGpu
      ! GpuError | OutOfMemoryError
      ? &mut Allocator {
      return StartedGpu { early: Option<EarlyRenderer>.some(run prepareGpu(check)) }
    }

    fn none() -> StartedGpu {
      return StartedGpu { early: Option<EarlyRenderer>.None }
    }
  }

  effect fn prepareGpu(check: bool) -> EarlyRenderer
    ! GpuError | OutOfMemoryError {
    return run prepareRenderer(RenderSettings { check: check }, String.make())
  }
} else {
  import render_thread { RenderThread }

  /// Starts the render thread, which makes the GPU device and pipelines while the window opens
  /// and the client builds its first frame.
  effect fn prepareRenderer(settings: RenderSettings, cache: String) -> RenderThread
    ! GpuError | OutOfMemoryError {
    return run RenderThread.prepare(settings, move cache)
  }

  effect fn attachRenderer(early: RenderThread, raw: RawSurface, window: WindowId) -> RenderThread
    ! GpuError | OutOfMemoryError {
    let mut thread = move early
    run thread.attach(raw, window)
    return move thread
  }

  /// A window's GPU started before [`runWindow`], with [`startGpu`]: its render thread, making
  /// the device and pipelines.
  pub struct StartedGpu {
    early: Option<RenderThread>,
  }

  impl StartedGpu {
    effect fn started(check: bool) -> StartedGpu
      ! GpuError | OutOfMemoryError
      ? &mut Allocator {
      return StartedGpu { early: Option<RenderThread>.some(run prepareGpu(check)) }
    }

    fn none() -> StartedGpu {
      return StartedGpu { early: Option<RenderThread>.None }
    }
  }

  effect fn prepareGpu(check: bool) -> RenderThread
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    let cache = if check {
      String.make()
    } else {
      run gpuCacheDirectory()
    }
    return run prepareRenderer(RenderSettings { check: check }, move cache)
  }
}

/// Starts a window's GPU (the device and the renderer's pipelines, on the render thread) before
/// [`runWindow`], for [`RunOptions.gpu`]. Most of a window's startup is the GPU, so an app that
/// calls this first, before it loads fonts or a script, has its first frame sooner. `check`
/// must be the `RunOptions.check` it runs with.
pub effect fn startGpu(check: bool) -> StartedGpu
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  // A headless run draws on the CPU: no GPU starts.
  if !check && run headlessRequested() {
    return StartedGpu.none()
  }
  return run StartedGpu.started(check)
}

/// Whether this process was asked for a headless run or the windowless bench (see
/// `headless.windowless`): neither starts a window system or a GPU.
pub effect fn headlessRequested() -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    return false
  } else {
    return run headless.windowless()
  }
}


