import silk.text.string { String }

// Slots and ids.

/// A (slot, id) pair, so a reference survives the slot being reused by another node.
pub fn pair(slot: u32, id: u32) -> u64 {
  return u64.shiftLeft(u32.toU64(slot), 32) + u32.toU64(id)
}

fn pairSlot(value: u64) -> u32 {
  return u64.toU32(u64.shiftRight(value, 32))
}

fn pairId(value: u64) -> u32 {
  return u64.toU32(u64.bitAnd(value, 0xffffffff))
}

/// Whether `slot` still holds the live node `id`.
fn alive(tree: &UiTree<'_>, slot: u32, id: u32) -> bool {
  if slot == NONE || u32.toUsize(slot) >= tree.nodes.length() {
    return false
  }
  let node = tree.node(slot)
  return node.live && node.id == id
}

/// Whether `slot` is in the tree under the root.
/// The slot of node `id` while it is alive and in the tree, or NONE.
fn liveSlot(tree: &UiTree<'_>, id: u32) -> u32 {
  let slot = tree.slotOf(id)
  if slot == NONE || !tree.node(slot).live || !attached(tree, slot) {
    return NONE
  }
  return slot
}

fn attached(tree: &UiTree<'_>, slot: u32) -> bool {
  let mut at = slot
  while at != NONE {
    if at == tree.root {
      return true
    }
    at = tree.node(at).parent
  }
  return false
}

fn slotIn(slots: &List<u32>, index: usize) -> u32 {
  if index < slots.length() {
    return slots.get(index)
  }
  return NONE
}

/// The first fragment of node `slot` in the last layout, or NO_INDEX.
fn fragmentIndex(tree: &UiTree<'_>, slot: u32) -> usize {
  let css = tree.node(slot).css
  if css < tree.fragmentOf.length() {
    return tree.fragmentOf.get(css)
  }
  return NO_INDEX
}

fn inside(rect: Rect<f32>, x: f32, y: f32) -> bool {
  return x >= rect.xMin && x < rect.xMax && y >= rect.yMin && y < rect.yMax
}

// Hit testing.

/// (`x`, `y`), in the layout space around fragment `index`, in the fragment's own layout space:
/// through the inverse of its transform. None where the fragment cannot be hit there: its
/// transform flattens it, the point maps behind the viewer, or it shows a hidden back face.
fn intoLocal(tree: &UiTree<'_>, index: usize, x: f32, y: f32) -> Option<Point2<f32>> {
  let point = Point2<f32> { x: x, y: y }
  if layers.hiddenBack(&tree.output, &tree.slotOfCss, &tree.nodes, index) {
    return Option<Point2<f32>>.None
  }
  match layers.flatOf(&tree.output, &tree.slotOfCss, &tree.nodes, index) {
    Option.Some { value } => {
      return match value.inverse() {
        Option.Some { value: inverse } => transform.map(&inverse, x, y)
        Option.None => Option<Point2<f32>>.None
      }
    }
    Option.None => {
      return Option<Point2<f32>>.some(point)
    }
  }
}

/// Whether node `slot` can be the target of pointer input.
fn targetable(tree: &UiTree<'_>, slot: u32) -> bool {
  let c = &tree.node(slot).computed().*
  return c.text.visible && c.paint.pointerEvents && !inertAt(tree, slot)
}

/// Whether node `slot` or an ancestor is inert.
pub fn inertAt(tree: &UiTree<'_>, slot: u32) -> bool {
  if tree.inerts == 0 {
    return false
  }
  let mut at = slot
  while at != NONE {
    if tree.node(at).inert {
      return true
    }
    at = tree.node(at).parent
  }
  return false
}

/// Whether (`x`, `y`) lies in the box of one of the runs of text fragment `index`.
fn insideText(tree: &UiTree<'_>, index: usize, x: f32, y: f32) -> bool {
  let mut runs = tree.output.fragments.textRuns(index)
  while runs.next() {
    let left = runs.current.location.x
    let top = runs.current.location.y
    if x >= left && x < left + runs.current.size.width && y >= top && y < top + runs.current.size.height {
      return true
    }
  }
  return false
}

/// The topmost target under (`x`, `y`) in fragment `index` and its descendants, or NONE. The
/// point is in the fragment's layout coordinates: where it is against the fragment as laid out,
/// with the scroll and sticky offsets above already taken off. The walk is paint order
/// reversed (see `stacking`): what paints last is on top.
fn hitFragment(tree: &UiTree<'_>, index: usize, px: f32, py: f32, pruned: bool, landing: &mut Landing) -> u32 {
  if pruned && !inside(tree.fragmentInk.get(index), px, py) {
    return NONE
  }
  // A plane of a 3D rendering context is hit through the context's root, by depth.
  if tree.preserveUsed {
    if layers.planeParent(&tree.output, &tree.slotOfCss, &tree.nodes, index) != NO_INDEX {
      return NONE
    }
    if layers.establishes(&tree.output, &tree.slotOfCss, &tree.nodes, index) {
      return hitContext(tree, index, px, py, &mut landing.*)
    }
  }
  let local = intoLocal(tree, index, px, py)
  if local.isNone() {
    return NONE
  }
  let point = local.unwrapOr(Point2<f32> { x: 0.0, y: 0.0 })
  return hitPlane(tree, index, point.x, point.y, pruned, &mut landing.*)
}

/// The frontmost target under (`px`, `py`), in the space around fragment `root`, among the
/// planes of the 3D rendering context `root` establishes: each plane's own content is hit
/// where the point meets it, and the nearest plane hit wins (the later one in tree order
/// between coplanar ones), as in Chromium.
fn hitContext(tree: &UiTree<'_>, root: usize, px: f32, py: f32, landing: &mut Landing) -> u32 {
  let values = tree.output.fragments.values.asSlice()
  let mut best = NONE
  let mut bestDepth: f32 = 0.0
  let end = values[root].nextSibling
  let mut at = root
  while at != NO_INDEX && at != end {
    if layers.contextOf(&tree.output, &tree.slotOfCss, &tree.nodes, at) == root
      && !layers.hiddenBack(&tree.output, &tree.slotOfCss, &tree.nodes, at) {
      let m = layers.accumulated(&tree.output, &tree.slotOfCss, &tree.nodes, at)
      if let Option.Some { value: inverse } = transform.flatten(m).inverse() {
        if let Option.Some { value: local } = transform.map(&inverse, px, py) {
          let h = m.transformHomogeneous(Point3<f32> { x: local.x, y: local.y, z: 0.0 })
          let depth: f32 = if h[3] != 0.0 { h[2] / h[3] } else { 0.0 }
          if best == NONE || depth >= bestDepth - 0.05 {
            let mut planeLanding = Landing { fragment: NO_INDEX, x: 0.0, y: 0.0 }
            let found = hitPlane(tree, at, local.x, local.y, false, &mut planeLanding)
            if found != NONE {
              best = found
              landing.* = planeLanding
              bestDepth = depth
            }
          }
        }
      }
    }
    at = layers.nextInTree(&tree.output, at, root)
  }
  return best
}

/// The topmost target under (`x`, `y`), in fragment `index`'s own layout space, in it and its
/// descendants.
fn hitPlane(tree: &UiTree<'_>, index: usize, x: f32, y: f32, pruned: bool, landing: &mut Landing) -> u32 {
  let f = tree.output.fragments.values.asSlice()[index]
  if f.positioningShell || f.kind == FragmentKind.Line {
    return hitInside(tree, index, x, y, pruned, &mut landing.*)
  }
  if f.kind == FragmentKind.Text {
    if !insideText(tree, index, x, y) {
      return NONE
    }

    // Text is never a target itself; its element is, as in the DOM.
    let slot = styleSlot(&tree.slotOfCss, &tree.layout, &tree.nodes, f.source)
    if slot != NONE && targetable(tree, slot) {
      return slot
    }
    return NONE
  }
  let slot = slotIn(&tree.slotOfCss, f.source)
  if slot == NONE {
    return hitInside(tree, index, x, y, pruned, &mut landing.*)
  }
  let clips = f.kind == FragmentKind.Box && tree.node(slot).computed().clips()
  if !clips || insideClip(tree, slot, &f, x, y) {
    let below = hitInside(tree, index, x, y, pruned, &mut landing.*)
    if below != NONE {
      return below
    }
  }
  if insideBorder(tree, slot, &f, x, y) && targetable(tree, slot) {
    landing.fragment = index
    landing.x = x
    landing.y = y
    return slot
  }
  return NONE
}

/// Whether (`x`, `y`) is inside box fragment `f` of node `slot`, whose rounded corners cut
/// what is hit as they cut what is painted.
fn insideBorder(tree: &UiTree<'_>, slot: u32, f: &Fragment, x: f32, y: f32) -> bool {
  let border = borderBox(f)
  let c = &tree.node(slot).computed().*
  if !rounds(c) {
    return inside(border, x, y)
  }
  return insideRounded(border, nodeRadii(tree.node(slot), c, f.size.width, f.size.height), x, y)
}

/// Whether (`x`, `y`) is inside the overflow clip of box fragment `f` of node `slot`: its
/// padding box's rounded corners clip when both axes clip, as paint's `clipMask` does.
fn insideClip(tree: &UiTree<'_>, slot: u32, f: &Fragment, x: f32, y: f32) -> bool {
  let c = &tree.node(slot).computed().*
  let clip = overflowClip(c, f)
  let both = usedOverflow(c, true) != Overflow.Visible && usedOverflow(c, false) != Overflow.Visible
  if !rounds(c) || !(both || c.contain.paint()) {
    return inside(clip, x, y)
  }
  let radii = nodeRadii(tree.node(slot), c, f.size.width, f.size.height).insetTo(borderBox(f), clip)
  return insideRounded(clip, radii, x, y)
}

/// Whether the stacking flags describe the last layout.
fn layered(tree: &UiTree<'_>) -> bool {
  return tree.fragmentStacking.covers(tree.output.fragments.values.length())
}

fn ownShiftOf(tree: &UiTree<'_>, index: usize) -> Vector2<f32> {
  return layers.ownShift(
    &tree.output,
    &tree.slotOfCss,
    &tree.layout,
    &tree.nodes,
    index,
    tree.input.width,
    tree.input.height,
  )
}

/// What is inside fragment `index`, topmost first: a stacking context's lists in reverse paint
/// order, else its children. A root element's box is hit where it sits in flow, as the body's
/// is in a browser, though its background paints first (see `stacking.ROOT`).
fn hitInside(tree: &UiTree<'_>, index: usize, x: f32, y: f32, pruned: bool, landing: &mut Landing) -> u32 {
  if !layered(tree) || !tree.fragmentStacking.stacks(index) {
    return hitChildren(tree, index, x, y, pruned, &mut landing.*)
  }
  let steps = tree.fragmentStacking.steps(index)
  let mut k: usize = 0
  while k < steps {
    let step = tree.fragmentStacking.step(index, k, true)
    k = k + 1
    let found = if step == IN_FLOW {
      hitChildren(tree, index, x, y, pruned, &mut landing.*)
    } else {
      hitHoisted(tree, index, step, x, y, pruned, &mut landing.*)
    }
    if found != NONE {
      return found
    }
  }
  return NONE
}

/// Whether box fragment `at` clips what is below it.
fn clipsAt(tree: &UiTree<'_>, at: usize) -> bool {
  let f = &tree.output.fragments.values.asSlice()[at]
  if f.kind != FragmentKind.Box || f.positioningShell {
    return false
  }
  let slot = slotIn(&tree.slotOfCss, f.source)
  return slot != NONE && tree.node(slot).kind != NodeKind.Text && tree.node(slot).computed().clips()
}

/// How far the boxes between stacking context `root` and its entry `entry` move it.
fn shiftBetween(tree: &UiTree<'_>, root: usize, entry: usize) -> Vector2<f32> {
  let values = tree.output.fragments.values.asSlice()
  let mut total = Vector2<f32> { x: 0.0, y: 0.0 }
  let mut at = values[entry].parent
  while at != root && at != NO_INDEX {
    let own = ownShiftOf(tree, at)
    total = Vector2<f32> { x: total.x + own.x, y: total.y + own.y }
    at = values[at].parent
  }
  return total
}

/// Whether (`x`, `y`) in `root`'s coordinates is inside the clips between stacking context
/// `root` and its entry `entry`. `total` is [`shiftBetween`].
fn insideBetween(
  tree: &UiTree<'_>,
  root: usize,
  entry: usize,
  x: f32,
  y: f32,
  total: Vector2<f32>,
) -> bool {
  let values = tree.output.fragments.values.asSlice()
  // The shift of the boxes below the one at hand: the point there is `total` less that.
  let mut below = Vector2<f32> { x: 0.0, y: 0.0 }
  let mut at = values[entry].parent
  while at != root && at != NO_INDEX {
    let own = ownShiftOf(tree, at)
    if clipsAt(tree, at) {
      let f = values[at]
      let slot = slotIn(&tree.slotOfCss, f.source)
      if !insideClip(tree, slot, &f, x - (total.x - below.x), y - (total.y - below.y)) {
        return false
      }
    }
    below = Vector2<f32> { x: below.x + own.x, y: below.y + own.y }
    at = values[at].parent
  }
  return true
}

/// Hit tests `entry` of stacking context `root`'s lists, where it sits in the tree.
fn hitHoisted(tree: &UiTree<'_>, root: usize, entry: usize, x: f32, y: f32, pruned: bool, landing: &mut Landing) -> u32 {
  let total = shiftBetween(tree, root, entry)
  if !insideBetween(tree, root, entry, x, y, total) {
    return NONE
  }
  let own = ownShiftOf(tree, entry)
  return hitFragment(tree, entry, x - total.x - own.x, y - total.y - own.y, pruned, &mut landing.*)
}

fn hitChildren(tree: &UiTree<'_>, index: usize, x: f32, y: f32, pruned: bool, landing: &mut Landing) -> u32 {
  let values = tree.output.fragments.values.asSlice()
  let skips = layered(tree)
  let mut child = values[index].lastChild
  while child != NO_INDEX {
    if !skips || !tree.fragmentStacking.hoisted(child) {
      let own = ownShiftOf(tree, child)
      let found = hitFragment(tree, child, x - own.x, y - own.y, pruned, &mut landing.*)
      if found != NONE {
        return found
      }
    }
    child = values[child].previousSibling
  }
  return NONE
}

fn eventSlot(tree: &UiTree<'_>, slot: u32) -> u32 {
  if slot == NONE { return NONE }
  let origin = tree.node(slot).generatedOrigin()
  return if origin == NONE { slot } else { origin }
}

/// Public pointer targets retarget generated boxes to their originating element.
pub fn hitSlot(tree: &UiTree<'_>, x: f32, y: f32) -> u32 {
  return eventSlot(tree, hitLayoutSlot(tree, x, y))
}

/// The node under (`x`, `y`) as layout sees it, generated boxes included: where scrolling
/// starts from.
pub fn layoutHit(tree: &UiTree<'_>, x: f32, y: f32) -> u32 {
  return hitLayoutSlot(tree, x, y)
}

/// Where a hit test landed: the target's fragment and the point in its coordinates.
pub struct Landing {
  pub fragment: usize,
  pub x: f32,
  pub y: f32,
}

impl Copy for Landing {}

fn hitLayoutSlot(tree: &UiTree<'_>, x: f32, y: f32) -> u32 {
  let mut landing = Landing { fragment: NO_INDEX, x: 0.0, y: 0.0 }
  return hitLanding(tree, x, y, &mut landing)
}

fn hitLanding(tree: &UiTree<'_>, x: f32, y: f32, landing: &mut Landing) -> u32 {
  if layered(tree) {
    // Stacking lists the roots: a long page has few among very many fragments.
    let roots = tree.fragmentStacking.roots.asSlice()
    let mut at = roots.length
    while at > 0 {
      at = at - 1
      if !tree.fragmentStacking.hoisted(roots[at]) {
        let found = hitRoot(tree, roots[at], x, y, &mut landing.*)
        if found != NONE {
          return found
        }
      }
    }
    return NONE
  }
  let values = tree.output.fragments.values.asSlice()
  let mut index = values.length
  while index > 0 {
    index = index - 1
    if values[index].parent == NO_INDEX {
      let found = hitRoot(tree, index, x, y, &mut landing.*)
      if found != NONE {
        return found
      }
    }
  }
  return NONE
}

/// The topmost target under (`x`, `y`) in the fragment tree of root `index`, or NONE.
fn hitRoot(tree: &UiTree<'_>, index: usize, x: f32, y: f32, landing: &mut Landing) -> u32 {
  let own = layers.ownShift(
    &tree.output,
    &tree.slotOfCss,
    &tree.layout,
    &tree.nodes,
    index,
    tree.input.width,
    tree.input.height,
  )
  return hitFragment(tree, index, x - own.x, y - own.y, tree.inkCurrent(), &mut landing.*)
}

/// All pointer targets in front-to-back paint order, with duplicate element slots removed.
/// This deliberately uses the same fragment clipping, targetability and layer shifts as
/// hitSlot, rather than testing inspection bounding rectangles.
pub effect fn hitSlots(tree: &UiTree<'_>, x: f32, y: f32, out: &mut List<u32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let values = tree.output.fragments.values.asSlice()
  let mut index = values.length
  while index > 0 {
    index = index - 1
    if values[index].parent == NO_INDEX && !(layered(tree) && tree.fragmentStacking.hoisted(index)) {
      let own = layers.ownShift(
        &tree.output,
        &tree.slotOfCss,
        &tree.layout,
        &tree.nodes,
        index,
        tree.input.width,
        tree.input.height,
      )
      run hitsFragment(tree, index, x - own.x, y - own.y, tree.inkCurrent(), &mut out.*)
    }
  }
}

effect fn appendHit(out: &mut List<u32>, slot: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut index: usize = 0
  while index < out.length() {
    if out.get(index) == slot {
      return ()
    }
    index = index + 1
  }
  run out.append(slot)
}

effect fn hitsFragment(
  tree: &UiTree<'_>,
  index: usize,
  px: f32,
  py: f32,
  pruned: bool,
  out: &mut List<u32>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if pruned && !inside(tree.fragmentInk.get(index), px, py) {
    return ()
  }
  let local = intoLocal(tree, index, px, py)
  if local.isNone() {
    return ()
  }
  let point = local.unwrapOr(Point2<f32> { x: 0.0, y: 0.0 })
  let x = point.x
  let y = point.y
  let values = tree.output.fragments.values.asSlice()
  let fragment = values[index]
  if fragment.kind == FragmentKind.Text {
    let textSlot = styleSlot(&tree.slotOfCss, &tree.layout, &tree.nodes, fragment.source)
    if textSlot != NONE && targetable(tree, textSlot) && insideText(tree, index, x, y) {
      run appendHit(&mut out.*, eventSlot(tree, textSlot))
    }
    return ()
  }
  let shell = fragment.positioningShell || fragment.kind == FragmentKind.Line
  let slot = if shell {
    NONE
  } else {
    slotIn(&tree.slotOfCss, fragment.source)
  }
  let clips = slot != NONE && fragment.kind == FragmentKind.Box && tree.node(slot).computed().clips()
  if !clips || inside(overflowClip(&tree.node(slot).computed().*, &fragment), x, y) {
    run hitsInside(tree, index, x, y, pruned, &mut out.*)
  }
  if slot != NONE && targetable(tree, slot) && inside(borderBox(&fragment), x, y) {
    run appendHit(&mut out.*, eventSlot(tree, slot))
  }
}

effect fn hitsInside(
  tree: &UiTree<'_>,
  index: usize,
  x: f32,
  y: f32,
  pruned: bool,
  out: &mut List<u32>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !layered(tree) || !tree.fragmentStacking.stacks(index) {
    run hitsChildren(tree, index, x, y, pruned, &mut out.*)
    return ()
  }
  let steps = tree.fragmentStacking.steps(index)
  let mut k: usize = 0
  while k < steps {
    let step = tree.fragmentStacking.step(index, k, true)
    k = k + 1
    if step == IN_FLOW {
      run hitsChildren(tree, index, x, y, pruned, &mut out.*)
    } else {
      let total = shiftBetween(tree, index, step)
      if insideBetween(tree, index, step, x, y, total) {
        let own = ownShiftOf(tree, step)
        run hitsFragment(tree, step, x - total.x - own.x, y - total.y - own.y, pruned, &mut out.*)
      }
    }
  }
}

effect fn hitsChildren(
  tree: &UiTree<'_>,
  index: usize,
  x: f32,
  y: f32,
  pruned: bool,
  out: &mut List<u32>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let values = tree.output.fragments.values.asSlice()
  let skips = layered(tree)
  let mut child = values[index].lastChild
  while child != NO_INDEX {
    if !skips || !tree.fragmentStacking.hoisted(child) {
      let own = ownShiftOf(tree, child)
      run hitsFragment(tree, child, x - own.x, y - own.y, pruned, &mut out.*)
    }
    child = values[child].previousSibling
  }
}

/// The cursor of the hovered node.
pub fn cursorOf(tree: &UiTree<'_>) -> Cursor {
  return cursorFrom(tree).cursor
}

/// What decides the hovered node's cursor: the cursor, and the slot whose CSS `cursor` lists
/// images first (NONE when none does).
pub struct CursorFrom {
  pub cursor: Cursor,
  pub images: u32,
}

impl Copy for CursorFrom {}

pub fn cursorFrom(tree: &UiTree<'_>) -> CursorFrom {
  let chain = tree.hoverChain.asSlice()
  let mut i: usize = 0
  while i < chain.length {
    let slot = pairSlot(chain[i])
    if alive(tree, slot, pairId(chain[i])) {
      let node = tree.node(slot)
      if node.cursor != Cursor.Default {
        return CursorFrom { cursor: node.cursor, images: NONE }
      }
      match node.computed().cursor {
        Option.Some { value } => {
          return CursorFrom { cursor: value, images: if node.computed().cursorUrl { slot } else { NONE } }
        }
        Option.None => {}
      }
      if node.kind == NodeKind.Input {
        return CursorFrom { cursor: Cursor.Text, images: NONE }
      }
    }
    i = i + 1
  }
  return CursorFrom { cursor: Cursor.Default, images: NONE }
}

// Records.

/// Whether `slot` or a node above it listens for `flag`.
fn pathListens(tree: &UiTree<'_>, slot: u32, flag: u32) -> bool {
  let mut at = slot
  while at != NONE {
    if u32.bitAnd(tree.node(at).listeners, flag) != 0 {
      return true
    }
    at = tree.node(at).parent
  }
  return false
}

fn listens(tree: &UiTree<'_>, slot: u32, flag: u32) -> bool {
  return u32.bitAnd(tree.node(slot).listeners, flag) != 0
}

/// A record of `kind` for `slot` with its path filled in.
effect fn record(tree: &UiTree<'_>, kind: EventKind, slot: u32) -> Event
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut path = List<u32>.make()
  run tree.pathTo(slot, &mut path)
  return Event.make(kind, tree.node(slot).id, move path)
}

/// Queues a pointer record for `slot` at the current pointer position.
effect fn pointerRecord(
  tree: &mut UiTree<'_>,
  kind: EventKind,
  slot: u32,
  modifiers: u32,
  button: u32,
  detail: u32,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut event = run record(&tree.*, kind, slot)
  event.x = tree.pointerX
  event.y = tree.pointerY
  event.modifiers = modifiers
  event.button = button
  event.detail = detail
  event.pointerId = tree.pointerId
  event.pointerType = tree.pointerType
  event.primary = tree.pointerPrimary
  if tree.node(slot).svg.isSome() {
    event.element = run svgElementAt(&tree.*, slot, tree.pointerX, tree.pointerY)
  }
  run tree.queueEvent(move event)
}

/// The element of live svg node `slot` under the pointer at (`x`, `y`), 0 when the pointer is
/// over none of its shapes or not over the node.
effect fn svgElementAt(tree: &UiTree<'_>, slot: u32, x: f32, y: f32) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut landing = Landing { fragment: NO_INDEX, x: 0.0, y: 0.0 }
  if eventSlot(tree, hitLanding(tree, x, y, &mut landing)) != slot || landing.fragment == NO_INDEX {
    return 0
  }
  let f = tree.output.fragments.values.asSlice()[landing.fragment]
  let node = tree.node(slot)
  return match node.svg.get() {
    Option.Some { value: svg } => run live_svg.hit(svg, contentBox(&f), landing.x, landing.y, node.computed().text.color, node.computed().clips())
    _ => 0
  }
}

/// `pointerRecord` for the touch module.
pub effect fn queuePointer(
  tree: &mut UiTree<'_>,
  kind: EventKind,
  slot: u32,
  modifiers: u32,
  button: u32,
  detail: u32,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pointerRecord(&mut tree, kind, slot, modifiers, button, detail)
}

/// Whether `slot` or a node above it listens for `flag`.
pub fn listensOnPath(tree: &UiTree<'_>, slot: u32, flag: u32) -> bool {
  return pathListens(tree, slot, flag)
}

// Hover.

/// Makes `target` and its ancestors the hovered nodes, queueing leave records (deepest first)
/// and enter records (outermost first) for listeners.
effect fn updateHover(tree: &mut UiTree<'_>, target: u32, modifiers: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut chain = List<u32>.make()
  let mut at = target
  while at != NONE {
    run chain.append(at)
    at = tree.node(at).parent
  }
  // The deepest node hovered before: the target of `pointerout`, as `target` is of `pointerover`.
  let mut before = NONE
  if tree.hoverChain.length() != 0 {
    let deepest = tree.hoverChain.get(0)
    if alive(&tree.*, pairSlot(deepest), pairId(deepest)) && attached(&tree.*, pairSlot(deepest)) {
      before = pairSlot(deepest)
    }
  }
  if before != target && before != NONE && pathListens(&tree.*, before, LISTEN_POINTER_OUT) {
    run pointerRecord(&mut tree, EventKind.PointerOut, before, modifiers, 0, 0)
  }
  let old = tree.hoverChain.asSlice()
  let mut i: usize = 0
  let mut leaving = List<u64>.make()
  while i < old.length {
    run leaving.append(old[i])
    i = i + 1
  }
  i = 0
  while i < leaving.length() {
    let slot = pairSlot(leaving.get(i))
    if alive(&tree.*, slot, pairId(leaving.get(i))) && tree.node(slot).hovered
      && !contains(&chain, slot) {
      run setHovered(&mut tree, slot, false)
      if listens(&tree.*, slot, LISTEN_POINTER_LEAVE) && attached(&tree.*, slot) {
        run pointerRecord(&mut tree, EventKind.PointerLeave, slot, modifiers, 0, 0)
      }
    }
    i = i + 1
  }
  tree.hoverChain.clear()
  if before != target && target != NONE && pathListens(&tree.*, target, LISTEN_POINTER_OVER) {
    run pointerRecord(&mut tree, EventKind.PointerOver, target, modifiers, 0, 0)
  }
  let mut j = chain.length()
  while j > 0 {
    j = j - 1
    let slot = chain.get(j)
    if !tree.node(slot).hovered {
      run setHovered(&mut tree, slot, true)
      if listens(&tree.*, slot, LISTEN_POINTER_ENTER) {
        run pointerRecord(&mut tree, EventKind.PointerEnter, slot, modifiers, 0, 0)
      }
    }
  }
  i = 0
  while i < chain.length() {
    let slot = chain.get(i)
    let id = tree.node(slot).id
    run tree.hoverChain.append(pair(slot, id))
    i = i + 1
  }
}

fn contains(list: &List<u32>, value: u32) -> bool {
  let values = list.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i] == value {
      return true
    }
    i = i + 1
  }
  return false
}

effect fn setHovered(tree: &mut UiTree<'_>, slot: u32, value: bool) -> () {
  let overridden = tree.overridden(tree.node(slot).id, StyleState.Hover)
  let node = &mut tree.nodes.asMutSlice()[u32.toUsize(slot)]
  node.hovered = value
  let inline = node.hover().length != 0 || overridden
  tree.pointerStyleChanged(slot, StyleState.Hover, inline)
}

/// Hit tests the pointer again after a layout moved content under it.
pub effect fn refreshHover(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !tree.pointerInside {
    return ()
  }
  tree.work.hoverRefreshes = tree.work.hoverRefreshes + 1
  let target = hitSlot(&tree.*, tree.pointerX, tree.pointerY)
  run updateHover(&mut tree, target, 0)
}

// Active state and capture.

effect fn setPressed(tree: &mut UiTree<'_>, target: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = target
  while at != NONE {
    let overridden = tree.overridden(tree.node(at).id, StyleState.Active)
    let node = &mut tree.nodes.asMutSlice()[u32.toUsize(at)]
    node.pressed = true
    let inline = node.active().length != 0 || overridden
    let id = node.id
    tree.pointerStyleChanged(at, StyleState.Active, inline)
    run tree.pressChain.append(pair(at, id))
    at = tree.node(at).parent
  }
  tree.capture = target
  tree.captureId = tree.node(target).id
}

fn clearPress(tree: &mut UiTree<'_>) -> () {
  let mut i: usize = 0
  while i < tree.pressChain.length() {
    let entry = tree.pressChain.get(i)
    let slot = pairSlot(entry)
    if alive(&tree.*, slot, pairId(entry)) {
      let overridden = tree.overridden(tree.node(slot).id, StyleState.Active)
      let node = &mut tree.nodes.asMutSlice()[u32.toUsize(slot)]
      node.pressed = false
      let inline = node.active().length != 0 || overridden
      tree.pointerStyleChanged(slot, StyleState.Active, inline)
    }
    i = i + 1
  }
  tree.pressChain.clear()
  tree.capture = NONE
  tree.captureId = NONE
  tree.captureMode = CAPTURE_IMPLICIT
  tree.captureTo = NONE
  tree.captureToId = NONE
  tree.thumbSlot = NONE
}

pub const CAPTURE_IMPLICIT: u32 = 0

pub const CAPTURE_EXPLICIT: u32 = 1

pub const CAPTURE_RELEASED: u32 = 2

/// The node the press sends its pointer records to, or NONE for the node under the pointer.
fn captureTarget(tree: &UiTree<'_>) -> u32 {
  if captured(tree) == NONE || tree.captureMode == CAPTURE_RELEASED {
    return NONE
  }
  if tree.captureMode == CAPTURE_EXPLICIT {
    if alive(tree, tree.captureTo, tree.captureToId) && attached(tree, tree.captureTo) {
      return tree.captureTo
    }
    return NONE
  }
  return tree.capture
}

/// `Mutation.SetPointerCapture`: `slot` takes the pointer records of the press under way.
/// Returns false when no button is down.
pub effect fn setCapture(tree: &mut UiTree<'_>, slot: u32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if captured(&tree.*) == NONE {
    return false
  }
  let before = explicitHolder(&tree.*)
  if before == slot {
    return true
  }
  run captureRecord(&mut tree, EventKind.LostPointerCapture, LISTEN_LOST_POINTER_CAPTURE, before)
  tree.captureMode = CAPTURE_EXPLICIT
  tree.captureTo = slot
  tree.captureToId = tree.node(slot).id
  run captureRecord(&mut tree, EventKind.GotPointerCapture, LISTEN_GOT_POINTER_CAPTURE, slot)
  return true
}

/// `Mutation.ReleasePointerCapture`.
pub effect fn releaseCapture(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if captured(&tree.*) != NONE {
    let before = explicitHolder(&tree.*)
    tree.captureMode = CAPTURE_RELEASED
    tree.captureTo = NONE
    tree.captureToId = NONE
    run captureRecord(&mut tree, EventKind.LostPointerCapture, LISTEN_LOST_POINTER_CAPTURE, before)
  }
}

/// The node that took the capture with `SetPointerCapture` and still holds it, or NONE. The
/// implicit capture of a press has no holder in this sense, as a mouse press has none in the
/// DOM, so it gets no got and lost records.
fn explicitHolder(tree: &UiTree<'_>) -> u32 {
  if tree.captureMode != CAPTURE_EXPLICIT {
    return NONE
  }
  return captureTarget(tree)
}

/// Queues a got or lost capture record for `slot` when it or a node on its path listens.
effect fn captureRecord(tree: &mut UiTree<'_>, kind: EventKind, flag: u32, slot: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if slot == NONE || !pathListens(&tree.*, slot, flag) {
    return ()
  }
  let mut event = run record(&tree.*, kind, slot)
  event.pointerId = tree.pointerId
  event.pointerType = tree.pointerType
  event.primary = tree.pointerPrimary
  run tree.queueEvent(move event)
}

/// The node holding the capture of the press, or NONE.
pub fn captureHolder(tree: &UiTree<'_>) -> u32 {
  return captureTarget(tree)
}

/// The node holding the pointer capture, or NONE when it is gone.
fn captured(tree: &UiTree<'_>) -> u32 {
  if alive(tree, tree.capture, tree.captureId) && attached(tree, tree.capture) {
    return tree.capture
  }
  return NONE
}

/// Whether `slot` or a node above it is disabled.
fn disabledAt(tree: &UiTree<'_>, slot: u32) -> bool {
  let mut at = slot
  while at != NONE {
    if tree.node(at).disabled {
      return true
    }
    at = tree.node(at).parent
  }
  return false
}

/// The nearest node that is `a` or above it and is also `b` or above it.
fn commonAncestor(tree: &UiTree<'_>, a: u32, b: u32) -> u32 {
  let mut at = a
  while at != NONE {
    let mut other = b
    while other != NONE {
      if other == at {
        return at
      }
      other = tree.node(other).parent
    }
    at = tree.node(at).parent
  }
  return NONE
}

// Focus.

/// Whether node `slot` takes focus from the pointer: it has a tab index, is laid out and
/// visible, and nothing above it is disabled.
fn focusable(tree: &UiTree<'_>, slot: u32) -> bool {
  let node = tree.node(slot)
  return node.tabIndex != NOT_FOCUSABLE && node.computed().text.visible
    && fragmentIndex(tree, slot) != NO_INDEX
    && !disabledAt(tree, slot)
    && !inertAt(tree, slot)
}

/// Focuses the nearest focusable node at or above `slot`, or blurs when there is none, as a
/// click does.
effect fn focusFrom(tree: &mut UiTree<'_>, slot: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = slot
  while at != NONE {
    if focusable(&tree.*, at) {
      run tree.focusSlot(at)
      return ()
    }
    at = tree.node(at).parent
  }
  run tree.focusSlot(NONE)
}

struct TabEntry {
  slot: u32,
  /// The tab index group: positive indices first, then 0 (as `i64.MAX`).
  group: i64,
  order: usize,
}

impl Copy for TabEntry {}

/// Moves focus to the next (or previous) tabbable node, cycling inside the nearest focus trap
/// around the focused node, and scrolls it into view.
effect fn moveFocus(tree: &mut UiTree<'_>, forward: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if tree.root == NONE {
    return ()
  }
  let focused = tree.focused
  let mut scope = tree.root
  if focused != NONE && tree.node(focused).live && attached(&tree.*, focused) {
    let mut at = focused
    while at != NONE {
      if tree.node(at).focusTrap {
        scope = at
        break
      }
      at = tree.node(at).parent
    }
  }

  // Tree order inside the scope, and the tabbable nodes in it.
  let mut entries = List<TabEntry>.make()
  let mut focusedOrder = usize.MAX
  let mut stack = List<u32>.make()
  let mut children = List<u32>.make()
  run stack.append(scope)
  let mut order: usize = 0
  while stack.length() != 0 {
    let last = stack.length() - 1
    let slot = stack.get(last)
    stack.truncate(last)
    if slot == focused {
      focusedOrder = order
    }
    let tabIndex = tree.node(slot).tabIndex
    if tabIndex >= 0 && focusable(&tree.*, slot) {
      let group = if tabIndex > 0 {
        i32.toI64(tabIndex)
      } else {
        i64.MAX
      }
      run entries.append(TabEntry { slot: slot, group: group, order: order })
    }
    order = order + 1
    run tree.childSlots(slot, &mut children)
    let mut i = children.length()
    while i > 0 {
      i = i - 1
      run stack.append(children.get(i))
    }
  }
  let count = entries.length()
  if count == 0 {
    return ()
  }

  // Stable insertion sort by group; tree order breaks ties.
  let values = entries.asMutSlice()
  let mut i: usize = 1
  while i < count {
    let entry = values[i]
    let mut j = i
    while j > 0 && values[j - 1].group > entry.group {
      values[j] = values[j - 1]
      j = j - 1
    }
    values[j] = entry
    i = i + 1
  }

  let mut next = NONE
  let mut k: usize = 0
  while k < count {
    if values[k].slot == focused {
      next = if forward {
        values[(k + 1) % count].slot
      } else {
        values[(k + count - 1) % count].slot
      }
      break
    }
    k = k + 1
  }
  if next == NONE {
    // The focused node is not tabbable: continue from where it is in tree order.
    if forward {
      next = values[0].slot
      if focusedOrder != usize.MAX {
        k = 0
        while k < count {
          if values[k].group == i64.MAX && values[k].order > focusedOrder {
            next = values[k].slot
            break
          }
          k = k + 1
        }
      }
    } else {
      next = values[count - 1].slot
      if focusedOrder != usize.MAX {
        k = count
        while k > 0 {
          k = k - 1
          if values[k].group == i64.MAX && values[k].order < focusedOrder {
            next = values[k].slot
            break
          }
        }
      }
    }
  }
  if !tree.focusVisible && tree.focused != NONE {
    let focusedSlot = tree.focused
    // `:focus-visible` turns on: only what its rules reach from the focused node restyles.
    tree.focusStyleChanged(focusedSlot)
  }
  tree.focusVisible = true
  if next == focused {
    return ()
  }
  run tree.focusSlot(next)
  if tree.node(next).kind == NodeKind.Input {
    // Tabbing into a text field selects its text, as browsers do.
    run edit.selectAll(&mut tree, next)
  }
  let id = tree.node(next).id
  run tree.reveal.append(pair(next, id))
}

/// The composite widget whose items arrow keys move focus among, as the WAI-ARIA Authoring
/// Practices describe, for item `slot`: its nearest ancestor with a composite widget, when
/// `slot` has that composite's item widget. NONE otherwise.
fn compositeOf(tree: &UiTree<'_>, slot: u32) -> u32 {
  let mut at = tree.node(slot).parent
  while at != NONE {
    let widget = tree.node(at).accessRole
    if composite(widget) {
      return if itemOf(widget, tree.node(slot).accessRole) { at } else { NONE }
    }
    at = tree.node(at).parent
  }
  return NONE
}

fn composite(widget: Role) -> bool {
  return widget == Role.TabList || widget == Role.Menu || widget == Role.MenuBar || widget == Role.ListBox
    || widget == Role.RadioGroup || widget == Role.Toolbar || widget == Role.Tree
}

fn itemOf(container: Role, item: Role) -> bool {
  return match container {
    Role.TabList => item == Role.Tab
    Role.Menu => item == Role.MenuItem || item == Role.MenuItemCheckbox || item == Role.MenuItemRadio
    Role.MenuBar => item == Role.MenuItem || item == Role.MenuItemCheckbox || item == Role.MenuItemRadio
    Role.ListBox => item == Role.Option
    Role.RadioGroup => item == Role.Radio
    Role.Tree => item == Role.TreeItem
    // A toolbar's controls are whatever focusable nodes it holds.
    Role.Toolbar => true
    _ => false
  }
}

/// Whether `container`'s items run top to bottom: its `aria-orientation`, else the widget's
/// default (tab lists, toolbars and menu bars run sideways).
fn vertical(tree: &UiTree<'_>, container: u32) -> bool {
  let node = tree.node(container)
  let set = match node.semanticsOf() {
    Option.Some { value } => value.orientation
    Option.None => Orientation.Unset
  }
  if set != Orientation.Unset {
    return set == Orientation.Vertical
  }
  return node.accessRole != Role.TabList && node.accessRole != Role.Toolbar && node.accessRole != Role.MenuBar
}

/// Moves focus among the items of the composite widget around the focused item `slot` on an
/// arrow key, Home or End, or a printable character (typeahead, in lists, menus and trees).
/// Returns whether it handled the key.
effect fn rove(tree: &mut UiTree<'_>, slot: u32, key: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let container = compositeOf(&tree.*, slot)
  if container == NONE {
    return false
  }
  let widget = tree.node(container).accessRole
  let down = vertical(&tree.*, container)
  let next = same(key, if down { b"ArrowDown" } else { b"ArrowRight" })
  let previous = same(key, if down { b"ArrowUp" } else { b"ArrowLeft" })
  let home = same(key, b"Home")
  let end = same(key, b"End")
  let typed = key.length == 1 && key[0] > 32 && key[0] < 127 && widget != Role.TabList && widget != Role.Toolbar
    && widget != Role.RadioGroup
  if !next && !previous && !home && !end && !typed {
    return false
  }

  // The focusable items in tree order, leaving out those of composites nested inside.
  let mut items = List<u32>.make()
  let mut stack = List<u32>.make()
  let mut children = List<u32>.make()
  run tree.childSlots(container, &mut children)
  let mut i = children.length()
  while i > 0 {
    i = i - 1
    run stack.append(children.get(i))
  }
  while stack.length() != 0 {
    let last = stack.length() - 1
    let at = stack.get(last)
    stack.truncate(last)
    let atRole = tree.node(at).accessRole
    if itemOf(widget, atRole) && focusable(&tree.*, at) {
      run items.append(at)
      if widget == Role.Toolbar {
        continue
      }
    }
    if composite(atRole) && !(widget == Role.Tree && atRole == Role.Tree) {
      continue
    }
    run tree.childSlots(at, &mut children)
    let mut k = children.length()
    while k > 0 {
      k = k - 1
      run stack.append(children.get(k))
    }
  }
  let count = items.length()
  let mut index: usize = 0
  while index < count && items.get(index) != slot {
    index = index + 1
  }
  if index == count {
    return false
  }
  // Lists and trees stop at their ends; tabs, menus, radios and toolbars wrap around.
  let wraps = widget != Role.ListBox && widget != Role.Tree
  let mut target = NONE
  if home {
    target = items.get(0)
  } else if end {
    target = items.get(count - 1)
  } else if next {
    target = if index + 1 < count { items.get(index + 1) } else if wraps { items.get(0) } else { slot }
  } else if previous {
    target = if index > 0 { items.get(index - 1) } else if wraps { items.get(count - 1) } else { slot }
  } else {
    // The next item after this one whose name starts with the character typed.
    let mut step: usize = 1
    while step <= count {
      let at = items.get((index + step) % count)
      if run startsWith(&tree.*, at, key[0]) {
        target = at
        break
      }
      step = step + 1
    }
    if target == NONE {
      return true
    }
  }
  tree.focusVisible = true
  if target != slot {
    run tree.focusSlot(target)
    let id = tree.node(target).id
    run tree.reveal.append(pair(target, id))
  }
  return true
}

/// Whether node `slot`'s name (its label, else its text) starts with ASCII `letter`, ignoring
/// case.
effect fn startsWith(tree: &UiTree<'_>, slot: u32, letter: u8) -> bool ! OutOfMemoryError ? &mut Allocator {
  let label = String.utf8Bytes(tree.node(slot).label())
  if label.length != 0 {
    return lower(label[0]) == lower(letter)
  }
  let mut stack = List<u32>.make()
  let mut children = List<u32>.make()
  run stack.append(slot)
  while stack.length() != 0 {
    let last = stack.length() - 1
    let at = stack.get(last)
    stack.truncate(last)
    let node = tree.node(at)
    if node.kind == NodeKind.Text {
      let text = node.text.ownedUtf8Bytes()
      let mut j: usize = 0
      while j < text.length && text[j] <= 32 {
        j = j + 1
      }
      if j < text.length {
        return lower(text[j]) == lower(letter)
      }
    }
    run tree.childSlots(at, &mut children)
    let mut k = children.length()
    while k > 0 {
      k = k - 1
      run stack.append(children.get(k))
    }
  }
  return false
}

fn lower(byte: u8) -> u8 {
  return if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

// Ctrl (Cmd on macOS) with `=` or `+` zooms in a step, with `-` out, with `0` back to 100%, in
// the steps browsers take.
fn zoomKey(tree: &mut UiTree<'_>, key: &[u8], modifiers: u32) -> bool {
  let primary = if tree.keymap == Keymap.Mac { MOD_META } else { MOD_CONTROL }
  if u32.bitAnd(modifiers, MOD_CONTROL + MOD_ALT + MOD_META) != primary || key.length != 1 { return false }
  let steps: [f32; 17] = [0.25, 0.33, 0.5, 0.67, 0.75, 0.8, 0.9, 1.0, 1.1, 1.25, 1.5, 1.75, 2.0, 2.5, 3.0, 4.0, 5.0]
  let now = tree.pageZoom()
  let mut next = now
  if key[0] == 48 {
    next = 1.0
  } else if key[0] == 61 || key[0] == 43 {
    let mut i: usize = 0
    while i < steps.length && steps[i] <= now + 0.001 { i = i + 1 }
    if i < steps.length { next = steps[i] }
  } else if key[0] == 45 {
    let mut i: usize = steps.length
    while i > 0 && steps[i - 1] >= now - 0.001 { i = i - 1 }
    if i > 0 { next = steps[i - 1] }
  } else {
    return false
  }
  drop tree.setPageZoom(next)
  return true
}

fn enterClicks(kind: Role) -> bool {
  return kind == Role.Button || kind == Role.Link || kind == Role.MenuItem || kind == Role.Tab
    || kind == Role.Option
}

fn spaceClicks(kind: Role) -> bool {
  return kind == Role.Button || kind == Role.Checkbox || kind == Role.Radio || kind == Role.MenuItem
    || kind == Role.Tab
    || kind == Role.Switch
    || kind == Role.Option
}

/// The node keys go to: the focused node, or the root.
fn keyTarget(tree: &UiTree<'_>) -> u32 {
  if tree.focused != NONE && tree.node(tree.focused).live && attached(tree, tree.focused) {
    return tree.focused
  }
  return tree.root
}

effect fn keyRecord(
  tree: &mut UiTree<'_>,
  kind: EventKind,
  slot: u32,
  key: &String,
  code: &String,
  modifiers: u32,
  repeat: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut event = run record(&tree.*, kind, slot)
  event.key = run String.copy(String.view(key))
  event.code = run String.copy(String.view(code))
  event.modifiers = modifiers
  event.repeat = repeat
  run tree.queueEvent(move event)
}

/// Queues the click a key press makes on a focused control.
effect fn keyboardClick(tree: &mut UiTree<'_>, slot: u32, modifiers: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if disabledAt(&tree.*, slot) || !pathListens(&tree.*, slot, LISTEN_CLICK) {
    return ()
  }
  let mut event = run record(&tree.*, EventKind.Click, slot)
  event.modifiers = modifiers
  run tree.queueEvent(move event)
}

// Scrolling.

/// The scroll range of node `slot` after the last layout.
fn rangeAt(tree: &UiTree<'_>, slot: u32) -> ScrollRange {
  let index = fragmentIndex(tree, slot)
  if index == NO_INDEX {
    return ScrollRange.none()
  }
  let f = tree.output.fragments.values.asSlice()[index]
  return rangeOf(&tree.node(slot).computed().*, &f)
}

effect fn ignoreInvalid(error: InvalidNode) -> () {
  drop error
}

/// Sets the scroll offset of `slot` as is and hands it to css-layout. Returns whether it
/// changed.
effect fn setOffset(tree: &mut UiTree<'_>, slot: u32, x: f32, y: f32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !run writeOffset(&mut tree, slot, x, y) {
    return false
  }
  run scroll_anchor.scrolled(&mut tree, slot)
  return true
}

/// A scroll anchoring adjustment of `slot` (see `scroll_anchor`): a scroll that keeps the anchor.
pub effect fn anchorScroll(tree: &mut UiTree<'_>, slot: u32, x: f32, y: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if run writeOffset(&mut tree, slot, x, y) {
    run scrollRecord(&mut tree, slot)
  }
}

effect fn writeOffset(tree: &mut UiTree<'_>, slot: u32, x: f32, y: f32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = &mut tree.nodes.asMutSlice()[u32.toUsize(slot)]
  if node.scrollX() == x && node.scrollY() == y {
    return false
  }
  let listed = node.scrollX() != 0.0 || node.scrollY() != 0.0
  let travel = f32.abs(x - node.scrollX()) + f32.abs(y - node.scrollY())
  run node.setScroll(x, y)
  if node.isGenerated() { tree.paintDirty = true }
  drop node
  if !listed {
    // `settleScrolls` clamps the nodes listed here.
    run tree.scrolledSlots.append(slot)
  }

  // Layout never sees scroll offsets: paint and the geometry queries apply them (see `layers`).
  tree.scrolled = true
  tree.skipTravel = tree.skipTravel + travel
  tree.offsets = true
  tree.layoutObserversDirty = true
  return true
}

/// The `ScrollTo` mutation: the offset is clamped once the next layout knows the range.
pub effect fn scrollTo(tree: &mut UiTree<'_>, slot: u32, x: f32, y: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let c = &tree.node(slot).computed().*
  let sx: f32 = if scrolls(usedOverflow(c, true)) {
    x
  } else {
    0.0
  }
  let sy: f32 = if scrolls(usedOverflow(c, false)) {
    y
  } else {
    0.0
  }
  drop run setOffset(&mut tree, slot, sx, sy)
}

/// Takes the scroll offset (`x`, `y`) that something outside the tree already showed, such as
/// a compositor that scrolled the last frame on its own: like a wheel scroll, it notifies
/// scroll listeners.
pub effect fn scrolledElsewhere(tree: &mut UiTree<'_>, slot: u32, x: f32, y: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if run setOffset(&mut tree, slot, x, y) {
    run scrollRecord(&mut tree, slot)
  }
}

effect fn scrollRecord(tree: &mut UiTree<'_>, slot: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  // A scroll event does not bubble, but the listeners above its target still hear it in the
  // capture phase (DOM, dispatch): a listener anywhere on the path asks for the record.
  if !pathListens(&tree.*, slot, LISTEN_SCROLL) {
    return ()
  }
  let mut event = run record(&tree.*, EventKind.Scroll, slot)
  event.x = tree.node(slot).scrollX()
  event.y = tree.node(slot).scrollY()
  run tree.queueEvent(move event)
}

/// [`scrollChain`] for a finger pan or a flick. Returns whether anything scrolled.
pub effect fn panChain(tree: &mut UiTree<'_>, slot: u32, dx: f32, dy: f32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return run scrollChain(&mut tree, slot, dx, dy)
}

/// Scrolls by (`dx`, `dy`) from `slot` outwards: each axis scrolls the nearest container that
/// can still move that way, and what it cannot take goes to the containers around it. Returns
/// whether any container moved.
pub effect fn scrollChain(tree: &mut UiTree<'_>, slot: u32, dx: f32, dy: f32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut moved = false
  let mut restX = dx
  let mut restY = dy
  let mut at = slot
  while at != NONE && (restX != 0.0 || restY != 0.0) {
    let c = tree.node(at).computed().*
    let canX = userScrolls(usedOverflow(&c, true))
    let canY = userScrolls(usedOverflow(&c, false))
    if (canX || canY) && fragmentIndex(&tree.*, at) != NO_INDEX && scroll_snap.absorbs(&mut tree.*, at, restX, restY) {
      // The rest of a fling aimed at a snap position.
      restX = 0.0
      restY = 0.0
    } else if (canX || canY) && fragmentIndex(&tree.*, at) != NO_INDEX {
      let range = rangeAt(&tree.*, at)
      let x = tree.node(at).scrollX()
      let y = tree.node(at).scrollY()
      let nx = if canX {
        range.clampX(x + restX)
      } else {
        x
      }
      let ny = if canY {
        range.clampY(y + restY)
      } else {
        y
      }
      restX = settle(restX - (nx - x))
      restY = settle(restY - (ny - y))
      if run setOffset(&mut tree, at, nx, ny) {
        moved = true
        run scrollRecord(&mut tree, at)
        run scroll_snap.userScrolled(&mut tree, at, x, y, true)
      }
      // `overscroll-behavior` other than auto keeps the rest from the containers outside.
      if c.scroll.overscrollX != Overscroll.Auto {
        restX = 0.0
      }
      if c.scroll.overscrollY != Overscroll.Auto {
        restY = 0.0
      }
    }
    at = tree.node(at).parent
  }
  return moved
}

fn settle(value: f32) -> f32 {
  if f32.abs(value) < 0.01 {
    return 0.0
  }
  return value
}

/// Scrolls the containers around `slot` the least that shows its border box.
effect fn revealSlot(tree: &mut UiTree<'_>, slot: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let index = fragmentIndex(&tree.*, slot)
  if index == NO_INDEX {
    return ()
  }
  let mut rect = tree.node(slot).computed().scroll.target(borderBox(&tree.visualFragment(index)))
  let mut at = tree.node(slot).parent
  while at != NONE {
    let c = tree.node(at).computed().*
    let containerIndex = fragmentIndex(&tree.*, at)
    if (scrolls(usedOverflow(&c, true)) || scrolls(usedOverflow(&c, false)))
      && containerIndex != NO_INDEX {
      let f = tree.visualFragment(containerIndex)
      let port = c.scroll.port(paddingBox(&f))
      let range = rangeOf(&c, &f)
      let x = tree.node(at).scrollX()
      let y = tree.node(at).scrollY()
      let nx = range.clampX(x + nearest(rect.xMin, rect.xMax, port.xMin, port.xMax))
      let ny = range.clampY(y + nearest(rect.yMin, rect.yMax, port.yMin, port.yMax))
      if run setOffset(&mut tree, at, nx, ny) {
        run scrollRecord(&mut tree, at)
      }
      rect = Rect<f32>.new(
        rect.xMin - (nx - x),
        rect.yMin - (ny - y),
        rect.xMax - (nx - x),
        rect.yMax - (ny - y),
      )
    }
    at = tree.node(at).parent
  }
}

/// CSSOM View nearest alignment: a target covering both scrollport edges stays put.
fn nearest(min: f32, max: f32, portMin: f32, portMax: f32) -> f32 {
  if min < portMin && max > portMax {
    return 0.0
  }
  let smaller = max - min < portMax - portMin
  if (min < portMin && smaller) || (max > portMax && !smaller) {
    return min - portMin
  }
  if (min < portMin && !smaller) || (max > portMax && smaller) {
    return max - portMax
  }
  return 0.0
}

/// After a layout: scrolls the nodes waiting to be revealed and clamps every offset to its
/// container's new range. Returns whether an offset changed, so the caller lays out again.
pub effect fn settleScrolls(tree: &mut UiTree<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if tree.stats.layoutSkipped && tree.reveal.length() == 0 && !tree.scrolled {
    return false
  }
  let mut changed = false
  let mut waiting = List<u64>.make()
  while tree.reveal.length() != 0 {
    let last = tree.reveal.length() - 1
    run waiting.append(tree.reveal.get(last))
    tree.reveal.truncate(last)
  }
  let mut i = waiting.length()
  while i > 0 {
    i = i - 1
    let entry = waiting.get(i)
    let slot = pairSlot(entry)
    if alive(&tree.*, slot, pairId(entry)) && attached(&tree.*, slot) {
      run revealSlot(&mut tree, slot)
    }
  }
  // No node holds an offset to clamp.
  if !tree.offsets {
    return changed
  }
  // Only the nodes `setOffset` listed can hold one: a long page is not walked for them.
  let mut kept: usize = 0
  let mut at: usize = 0
  while at < tree.scrolledSlots.length() {
    let slot = tree.scrolledSlots.get(at)
    at = at + 1
    if u32.toUsize(slot) >= tree.nodes.length() {
      continue
    }
    let live = tree.node(slot).live
    let scrollX = tree.node(slot).scrollX()
    let scrollY = tree.node(slot).scrollY()
    if !live || (scrollX == 0.0 && scrollY == 0.0) {
      continue
    }
    let mut listed = false
    let mut before: usize = 0
    while before < kept {
      if tree.scrolledSlots.get(before) == slot {
        listed = true
      }
      before = before + 1
    }
    if listed {
      continue
    }
    tree.scrolledSlots.set(kept, slot)
    kept = kept + 1

    // Another root's layout is not this one: its offsets wait for its own frame.
    if !tree.inParkedRoot(slot) {
      let range = rangeAt(&tree.*, slot)
      let x = range.clampX(scrollX)
      let y = range.clampY(scrollY)
      if run setOffset(&mut tree, slot, x, y) {
        run scrollRecord(&mut tree, slot)
        changed = true
      }
    }
  }
  tree.scrolledSlots.truncate(kept)
  tree.offsets = kept != 0
  return changed
}

// Scrollbar thumbs.

/// Starts dragging a scrollbar thumb under (`x`, `y`) in a container at or above `slot`.
fn startThumb(tree: &mut UiTree<'_>, slot: u32, x: f32, y: f32) -> bool {
  let mut at = slot
  while at != NONE {
    let index = fragmentIndex(&tree.*, at)
    if index != NO_INDEX && tree.node(at).computed().clips() {
      let f = tree.visualFragment(index)
      let vertical = thumbOfNode(tree.node(at), &f, tree.node(at).scrollY(), true)
      if vertical.visible && inside(vertical.rect, x, y) {
        tree.thumbSlot = at
        tree.thumbVertical = true
        tree.thumbStart = y
        tree.thumbOffset = tree.node(at).scrollY()
        return true
      }
      let horizontal = thumbOfNode(tree.node(at), &f, tree.node(at).scrollX(), false)
      if horizontal.visible && inside(horizontal.rect, x, y) {
        tree.thumbSlot = at
        tree.thumbVertical = false
        tree.thumbStart = x
        tree.thumbOffset = tree.node(at).scrollX()
        return true
      }
    }
    at = tree.node(at).parent
  }
  return false
}

effect fn dragThumb(tree: &mut UiTree<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let slot = tree.thumbSlot
  if slot == NONE || !tree.node(slot).live {
    return ()
  }
  let index = fragmentIndex(&tree.*, slot)
  if index == NO_INDEX {
    return ()
  }
  let f = tree.output.fragments.values.asSlice()[index]
  let c = tree.node(slot).computed().*
  let range = rangeOf(&c, &f)
  let thumb = thumbOfNode(tree.node(slot), &f, tree.thumbOffset, tree.thumbVertical)
  let x = tree.node(slot).scrollX()
  let y = tree.node(slot).scrollY()
  let moved = if tree.thumbVertical {
    tree.pointerY - tree.thumbStart
  } else {
    tree.pointerX - tree.thumbStart
  }
  let target = tree.thumbOffset + moved * thumb.ratio
  let changed = if tree.thumbVertical {
    run setOffset(&mut tree, slot, x, range.clampY(target))
  } else {
    run setOffset(&mut tree, slot, range.clampX(target), y)
  }
  if changed {
    run scrollRecord(&mut tree, slot)
    run scroll_snap.userScrolled(&mut tree, slot, x, y, false)
  }
}

// Dispatch.

/// Feeds one input record to the tree.
pub effect fn dispatch(tree: &mut UiTree<'_>, input: Input) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run begin(&mut tree, &input)
  run finish(&mut tree, move input, false)
}

/// Whether `slot` or a node above it prevents default action `flag` (`Attribute.Prevent`).
fn pathPrevents(tree: &UiTree<'_>, slot: u32, flag: u32) -> bool {
  let mut at = slot
  while at != NONE {
    if u32.bitAnd(tree.node(at).prevents, flag) != 0 {
      return true
    }
    at = tree.node(at).parent
  }
  return false
}

/// The first half of a dispatch: where the pointer is, hover, and the record of the input
/// itself. Nothing a client could prevent happens here.
/// Remembers `slot` as the target of the input under way.
fn remember(tree: &mut UiTree<'_>, slot: u32) -> () {
  tree.pendingTarget = slot
  tree.pendingTargetId = if slot == NONE {
    NONE
  } else {
    tree.node(slot).id
  }
}

/// The target `begin` remembered, or NONE when it is gone or out of the tree.
fn remembered(tree: &UiTree<'_>) -> u32 {
  if alive(tree, tree.pendingTarget, tree.pendingTargetId) && attached(tree, tree.pendingTarget) {
    return tree.pendingTarget
  }
  return NONE
}

pub effect fn begin(tree: &mut UiTree<'_>, input: &Input) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let fromTouch = match &input.* {
    Input.TouchStart { .. } => true
    Input.TouchMove { .. } => true
    Input.TouchEnd { .. } => true
    Input.TouchCancel { .. } => true
    Input.Pinch { .. } => true
    _ => false
  }
  if fromTouch {
    tree.pendingTarget = NONE
    tree.pendingTargetId = NONE
    run touch.begin(&mut tree, input)
    return ()
  }
  match &input.* {
    Input.PointerMove { .. } => touch.speakAsMouse(&mut tree)
    Input.PointerDown { .. } => {
      touch.speakAsMouse(&mut tree)
      touch.stopFling(&mut tree)
    }
    Input.PointerUp { .. } => touch.speakAsMouse(&mut tree)
    Input.PointerLeave => touch.speakAsMouse(&mut tree)
    Input.Wheel { .. } => {
      touch.speakAsMouse(&mut tree)
      touch.stopFling(&mut tree)
    }
    _ => {}
  }
  run beginInput(&mut tree, input)
}

/// `begin` for pointer, wheel and key input, the pointer records speaking for the pointer
/// `UiTree.pointerId` names.
pub effect fn beginInput(tree: &mut UiTree<'_>, input: &Input) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  tree.pendingTarget = NONE
  tree.pendingTargetId = NONE
  match &input.* {
    Input.PointerMove { x, y, modifiers } => {
      let hit = run movedStill(&mut tree, x, y, modifiers)
      if tree.thumbSlot != NONE {
        run dragThumb(&mut tree)
        return ()
      }
      let target = captureTarget(&tree.*)
      let to = if target != NONE {
        target
      } else {
        hit
      }
      if to != NONE && pathListens(&tree.*, to, LISTEN_POINTER_MOVE) {
        run pointerRecord(&mut tree, EventKind.PointerMove, to, modifiers, 0, 0)
      }
    }
    Input.PointerDown { x, y, button, modifiers, clickCount } => {
      let hit = run moved(&mut tree, x, y, modifiers)
      if button == BUTTON_PRIMARY {
        // A press that never saw its release ends here. A scrollbar thumb belongs to the
        // tree, so a press on one is no pointer down for the client.
        clearPress(&mut tree)
        // A finger pans over a scrollbar as over the content: thumbs are for the mouse.
        let layoutHit = hitLayoutSlot(&tree.*, x, y)
        if layoutHit != NONE && tree.pointerType != POINTER_TOUCH && startThumb(&mut tree, layoutHit, x, y) {
          return ()
        }
      }
      remember(&mut tree, hit)
      tree.pressed = hit
      tree.pressedId = tree.pendingTargetId
      if hit == NONE || disabledAt(&tree.*, hit) {
        return ()
      }
      if button == BUTTON_PRIMARY {
        // The active state and the capture start with the press, so a client handling the
        // pointer down can already call `SetPointerCapture`.
        run setPressed(&mut tree, hit)
        tree.pressCount = clickCount
      }
      if pathListens(&tree.*, hit, LISTEN_POINTER_DOWN) {
        run pointerRecord(&mut tree, EventKind.PointerDown, hit, modifiers, button, clickCount)
      }
    }
    Input.PointerUp { x, y, button, modifiers } => {
      let hit = run moved(&mut tree, x, y, modifiers)
      if button == BUTTON_PRIMARY && tree.thumbSlot != NONE {
        return ()
      }
      let holder = captureTarget(&tree.*)
      let target = if button == BUTTON_PRIMARY && holder != NONE {
        holder
      } else {
        hit
      }
      if target != NONE && !disabledAt(&tree.*, target)
        && pathListens(&tree.*, target, LISTEN_POINTER_UP) {
        run pointerRecord(&mut tree, EventKind.PointerUp, target, modifiers, button, 0)
      }
    }
    Input.PointerLeave => {
      tree.pointerInside = false
      run updateHover(&mut tree, NONE, 0)
    }
    Input.PointerCancel => {
      // The record goes where the press was sending its records.
      let mut target = captureTarget(&tree.*)
      if target == NONE {
        target = captured(&tree.*)
      }
      if target != NONE && tree.thumbSlot == NONE
        && pathListens(&tree.*, target, LISTEN_POINTER_CANCEL) {
        run pointerRecord(&mut tree, EventKind.PointerCancel, target, 0, BUTTON_PRIMARY, 0)
      }
    }
    Input.Wheel { x, y, deltaX, deltaY, modifiers } => {
      let hit = run movedStill(&mut tree, x, y, modifiers)
      remember(&mut tree, hit)
      if hit != NONE && pathListens(&tree.*, hit, LISTEN_WHEEL) {
        let mut event = run record(&tree.*, EventKind.Wheel, hit)
        event.x = x
        event.y = y
        event.modifiers = modifiers
        event.deltaX = deltaX
        event.deltaY = deltaY
        run tree.queueEvent(move event)
      }
    }
    Input.KeyDown { key, code, modifiers, repeat } => {
      let target = keyTarget(&tree.*)
      remember(&mut tree, target)
      if target != NONE && pathListens(&tree.*, target, LISTEN_KEY_DOWN) {
        run keyRecord(&mut tree, EventKind.KeyDown, target, &key, &code, modifiers, repeat)
      }
    }
    Input.KeyUp { key, code, modifiers } => {
      let target = keyTarget(&tree.*)
      remember(&mut tree, target)
      if target != NONE && pathListens(&tree.*, target, LISTEN_KEY_UP) {
        run keyRecord(&mut tree, EventKind.KeyUp, target, &key, &code, modifiers, false)
      }
    }
    Input.TextInput { .. } => {}
    Input.ImePreedit { .. } => {}
    Input.Command { command } => {
      let from = keyTarget(&tree.*)
      let target = run clipboard.target(&mut tree, from)
      remember(&mut tree, target)
      run clipboard.beginCommand(&mut tree, target, command)
    }
    Input.Paste { target, text, html, image } => {
      let slot = liveSlot(&tree.*, target)
      remember(&mut tree, slot)
      run clipboard.beginPaste(&mut tree, slot, &text, &html, &image)
    }
    Input.Edit { target, inputType, text } => {
      let slot = liveSlot(&tree.*, target)
      remember(&mut tree, slot)
      run clipboard.beginEdit(&mut tree, slot, &inputType, &text)
    }
    Input.Request { request, target } => {
      let slot = run requestTarget(&tree.*, target)
      remember(&mut tree, slot)
      if slot != NONE {
        let kind = if request == Request.Close { EventKind.CloseRequest } else { EventKind.Navigate }
        let mut event = run record(&tree.*, kind, slot)
        event.detail = if request == Request.Forward { 1 } else { 0 }
        run tree.queueEvent(move event)
      }
    }
    Input.TouchStart { .. } => {}
    Input.TouchMove { .. } => {}
    Input.TouchEnd { .. } => {}
    Input.TouchCancel { .. } => {}
    Input.Pinch { .. } => {}
  }
}

/// Whether a request can start at `slot`: it is in the tree, not inert, and it or a node
/// above it listens for requests.
fn hearsRequest(tree: &UiTree<'_>, slot: u32) -> bool {
  return slot != NONE && tree.node(slot).live && attached(tree, slot) && !inertAt(tree, slot)
    && pathListens(tree, slot, LISTEN_REQUEST)
}

/// The node a request starts at (see `Input.Request`), or NONE when no node would hear it:
/// node `target` if it names one, else the focused node, else the node last pressed, each
/// only if a listener is on its path; otherwise the last node in tree order that listens and
/// is not inert, which is the one on top.
effect fn requestTarget(tree: &UiTree<'_>, target: u32) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  if target != REQUEST_ANYWHERE {
    let named = tree.slotOf(target)
    if hearsRequest(tree, named) {
      return named
    }
  }
  if hearsRequest(tree, tree.focused) {
    return tree.focused
  }
  if alive(tree, tree.pressed, tree.pressedId) && hearsRequest(tree, tree.pressed) {
    return tree.pressed
  }
  return run lastListener(tree)
}

/// The last node in tree order that listens for requests and is not inert, or NONE.
effect fn lastListener(tree: &UiTree<'_>) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = NONE
  if tree.root == NONE {
    return found
  }
  let mut stack = List<u32>.make()
  let mut children = List<u32>.make()
  run stack.append(tree.root)
  while stack.length() != 0 {
    let last = stack.length() - 1
    let slot = stack.get(last)
    stack.truncate(last)
    if !tree.node(slot).inert {
      if listens(tree, slot, LISTEN_REQUEST) {
        found = slot
      }
      run tree.childSlots(slot, &mut children)
      let mut i = children.length()
      while i > 0 {
        i = i - 1
        run stack.append(children.get(i))
      }
    }
  }
  return found
}

/// The request key down `key` raises when nothing else took it: Escape closes, and the
/// platform's back and forward keys navigate (Alt with the left and right arrows, Cmd with
/// the brackets on a Mac, and the browser keys of a keyboard).
fn requestOf(tree: &UiTree<'_>, key: string, modifiers: u32) -> Option<Request> {
  let held = u32.bitAnd(modifiers, MOD_SHIFT + MOD_CONTROL + MOD_ALT + MOD_META)
  if held == 0 {
    if key == "Escape" { return Option<Request>.some(Request.Close) }
    if key == "BrowserBack" { return Option<Request>.some(Request.Back) }
    if key == "BrowserForward" { return Option<Request>.some(Request.Forward) }
    return Option<Request>.None
  }
  if tree.keymap == Keymap.Mac {
    if held == MOD_META && key == "[" { return Option<Request>.some(Request.Back) }
    if held == MOD_META && key == "]" { return Option<Request>.some(Request.Forward) }
    return Option<Request>.None
  }
  if held == MOD_ALT && key == "ArrowLeft" { return Option<Request>.some(Request.Back) }
  if held == MOD_ALT && key == "ArrowRight" { return Option<Request>.some(Request.Forward) }
  return Option<Request>.None
}

/// The second half of a dispatch: the default action of `input` and the records that follow
/// from it. With `prevented`, or under a node whose `Attribute.Prevent` names the action, the
/// default is skipped: a press takes no focus and starts no selection, a wheel does not
/// scroll, and a key does not move focus, click or edit. Hover, the active state, capture and
/// the click of a press are not default actions and happen either way, as in the DOM.
pub effect fn finish(tree: &mut UiTree<'_>, input: Input, prevented: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let fromTouch = match &input {
    Input.TouchStart { .. } => true
    Input.TouchMove { .. } => true
    Input.TouchEnd { .. } => true
    Input.TouchCancel { .. } => true
    Input.Pinch { .. } => true
    _ => false
  }
  if fromTouch {
    run touch.finish(&mut tree, move input, prevented)
    return ()
  }
  run finishInput(&mut tree, move input, prevented)
}

/// Ctrl with letter `lower` (Cmd with the Mac keymap), either case.
fn commandKey(tree: &UiTree<'_>, key: string, modifiers: u32, lower: string) -> bool {
  let primary = if tree.keymap == Keymap.Mac { MOD_META } else { MOD_CONTROL }
  let held = u32.bitAnd(modifiers, MOD_CONTROL + MOD_ALT + MOD_META)
  if held != primary { return false }
  let a = String.utf8Bytes(key)
  let b = String.utf8Bytes(lower)
  return a.length == 1 && (a[0] == b[0] || a[0] + 32 == b[0])
}

/// `finish` for pointer, wheel and key input.
pub effect fn finishInput(tree: &mut UiTree<'_>, input: Input, prevented: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match move input {
    Input.PointerMove { x, y, .. } => {
      if tree.thumbSlot != NONE {
        return ()
      }
      let origin = captured(&tree.*)
      if origin != NONE && origin == tree.focused && tree.node(origin).kind == NodeKind.Input {
        run edit.pointerDrag(&mut tree, origin, x, y)
      } else if tree.textSelection.unit != text_selection.UNIT_NONE {
        run text_selection.pointerDrag(&mut tree, x, y)
      }
    }
    Input.PointerDown { x, y, button, modifiers, clickCount } => {
      if button == BUTTON_SECONDARY && !prevented && tree.thumbSlot == NONE {
        // A secondary press on an input focuses it and opens its edit menu, as a browser's
        // context menu does; a listener that prevents the press keeps the menu closed.
        let hit = remembered(&tree.*)
        if hit != NONE && tree.node(hit).kind == NodeKind.Input && !disabledAt(&tree.*, hit) {
          if tree.focused != hit && !pathPrevents(&tree.*, hit, PREVENT_FOCUS) {
            run focusFrom(&mut tree, hit)
          }
          if tree.focused == hit {
            run clipboard.editMenu(&mut tree, hit, x, y)
          }
        }
        return ()
      }
      if button != BUTTON_PRIMARY || tree.thumbSlot != NONE {
        return ()
      }
      if tree.pendingTarget == NONE {
        // The press landed on nothing.
        if !prevented {
          run tree.focusSlot(NONE)
          run text_selection.clear(&mut tree)
        }
        return ()
      }
      let hit = remembered(&tree.*)
      if hit == NONE {
        // The pressed node went away while the press was handled: nothing takes focus.
        return ()
      }
      let keepFocus = prevented || pathPrevents(&tree.*, hit, PREVENT_FOCUS)
      if tree.focusVisible && tree.focused != NONE {
        let focusedSlot = tree.focused
        // `:focus-visible` turns off: only what its rules reach from the focused node restyles.
        tree.focusStyleChanged(focusedSlot)
      }
      tree.focusVisible = false
      if disabledAt(&tree.*, hit) {
        if !keepFocus {
          run focusFrom(&mut tree, NONE)
        }
        return ()
      }
      if !keepFocus {
        run focusFrom(&mut tree, hit)
        if tree.focused == hit && tree.node(hit).kind == NodeKind.Input {
          run edit.pointerDown(&mut tree, hit, x, y, clickCount, modifiers)
        }
      }
      if !prevented {
        // A press in an input selects there; anywhere else it selects document text.
        if tree.node(hit).kind == NodeKind.Input {
          run text_selection.clear(&mut tree)
        } else {
          run text_selection.pointerDown(&mut tree, hit, x, y, clickCount, u32.bitAnd(modifiers, MOD_SHIFT) != 0)
        }
      }
    }
    Input.PointerUp { x, y, button, modifiers } => {
      if button == BUTTON_BACK || button == BUTTON_FORWARD {
        // The back and forward buttons of a mouse ask to navigate from the node under the
        // pointer, unless a listener prevented the release.
        let hit = hitSlot(&tree.*, x, y)
        let from = if hit == NONE { REQUEST_ANYWHERE } else { tree.node(hit).id }
        if !prevented {
          run tree.queueFollowUp(
            Input.Request {
              request: if button == BUTTON_BACK { Request.Back } else { Request.Forward },
              target: from,
            },
          )
        }
        return ()
      }
      if button != BUTTON_PRIMARY {
        return ()
      }
      if tree.thumbSlot != NONE {
        clearPress(&mut tree)
        return ()
      }
      let origin = captured(&tree.*)
      if origin != NONE && tree.node(origin).kind == NodeKind.Input {
        edit.pointerUp(&mut tree, origin)
      }
      text_selection.pointerUp(&mut tree)
      let hit = hitSlot(&tree.*, x, y)
      let mut clicked = NONE
      if tree.captureMode == CAPTURE_EXPLICIT {
        // A captured press clicks its holder wherever the button comes up.
        clicked = captureTarget(&tree.*)
      } else if origin != NONE && hit != NONE {
        clicked = commonAncestor(&tree.*, origin, hit)
      }

      // The capture ends with the press, before the click, as in the DOM.
      let holder = explicitHolder(&tree.*)
      run captureRecord(
        &mut tree,
        EventKind.LostPointerCapture,
        LISTEN_LOST_POINTER_CAPTURE,
        holder,
      )
      if clicked != NONE && !disabledAt(&tree.*, clicked)
        && pathListens(&tree.*, clicked, LISTEN_CLICK) {
        let count = tree.pressCount
        run pointerRecord(&mut tree, EventKind.Click, clicked, modifiers, button, count)
      }
      clearPress(&mut tree)
    }
    Input.PointerLeave => {}
    Input.PointerCancel => {
      let origin = captured(&tree.*)
      if origin != NONE && tree.node(origin).kind == NodeKind.Input {
        edit.pointerUp(&mut tree, origin)
      }
      text_selection.pointerUp(&mut tree)
      let holder = explicitHolder(&tree.*)
      run captureRecord(
        &mut tree,
        EventKind.LostPointerCapture,
        LISTEN_LOST_POINTER_CAPTURE,
        holder,
      )
      clearPress(&mut tree)
    }
    Input.Wheel { x, y, deltaX, deltaY, .. } => {
      let mut hit = remembered(&tree.*)
      if hit == NONE {
        hit = hitSlot(&tree.*, x, y)
      }
      if hit == NONE || prevented || pathPrevents(&tree.*, hit, PREVENT_SCROLL) {
        return ()
      }
      let layoutHit = hitLayoutSlot(&tree.*, x, y)
      drop run scrollChain(&mut tree, if layoutHit != NONE { layoutHit } else { hit }, deltaX, deltaY)
    }
    Input.KeyDown { key, modifiers, repeat, .. } => {
      if tree.zoomKeys && !prevented && zoomKey(&mut tree, String.utf8Bytes(String.view(&key)), modifiers) { return () }
      let target = keyTarget(&tree.*)
      if target == NONE {
        tree.suppressText = false
        return ()
      }
      if prevented || pathPrevents(&tree.*, target, PREVENT_KEYS) {
        tree.suppressText = true
        return ()
      }
      tree.suppressText = false

      // Editing and keyboard clicks belong to the node the key went to. When a handler moved
      // focus or removed that node, they do not fall on whatever has focus now.
      let same = target == remembered(&tree.*)
      if same {
        if let Option<EditCommand>.Some { value: command } = clipboard.shortcut(tree.keymap, String.view(&key), modifiers) {
          if command == EditCommand.Paste {
            run clipboard.requestPaste(&mut tree, target)
          } else if run clipboard.matters(&mut tree, target) {
            run tree.queueFollowUp(Input.Command { command: command })
          }
          return ()
        }
      }
      if same && target == tree.focused && tree.node(target).kind == NodeKind.Input
        && run edit.keyDown(&mut tree, target, &key, modifiers) {
        return ()
      }
      let plain = u32.bitAnd(modifiers, MOD_CONTROL + MOD_ALT + MOD_META) == 0
      let editing = tree.focused != NONE && tree.node(tree.focused).kind == NodeKind.Input
      if same && !editing && commandKey(&tree.*, String.view(&key), modifiers, "a") && run text_selection.hostSelectAll(&mut tree) {
        return ()
      }
      if same && !editing && commandKey(&tree.*, String.view(&key), modifiers, "a") && run text_selection.selectAll(&mut tree) {
        return ()
      }
      if same && !editing && target == tree.focused && run text_selection.hostKey(&mut tree, String.view(&key), modifiers) {
        return ()
      }
      if same && !editing && run text_selection.extend(&mut tree, String.view(&key), modifiers) {
        return ()
      }
      if !repeat {
        if let Option<Request>.Some { value: request } = requestOf(&tree.*, String.view(&key), modifiers) {
          // The request starts at the node the key went to, when that is a real node.
          let from = if target == tree.root { REQUEST_ANYWHERE } else { tree.node(target).id }
          run tree.queueFollowUp(Input.Request { request: request, target: from })
          return ()
        }
      }
      if plain && String.view(&key) == "Tab" {
        run moveFocus(&mut tree, u32.bitAnd(modifiers, MOD_SHIFT) == 0)
      } else if same && plain && target == tree.focused && run rove(&mut tree, target, String.utf8Bytes(String.view(&key))) {
        return ()
      } else if same && plain && !repeat && String.view(&key) == "Enter" && target == tree.focused
        && enterClicks(tree.node(target).accessRole) {
        run keyboardClick(&mut tree, target, modifiers)
      }
    }
    Input.KeyUp { key, modifiers, .. } => {
      // A prevented key drops only the text it types itself, which comes before it is up.
      tree.suppressText = false
      let target = keyTarget(&tree.*)
      if target == NONE || prevented || pathPrevents(&tree.*, target, PREVENT_KEYS) {
        return ()
      }
      let plain = u32.bitAnd(modifiers, MOD_CONTROL + MOD_ALT + MOD_META) == 0
      if plain && String.view(&key) == " " && target == remembered(&tree.*)
        && target == tree.focused
        && spaceClicks(tree.node(target).accessRole) {
        run keyboardClick(&mut tree, target, modifiers)
      }
    }
    Input.TextInput { text } => {
      if tree.suppressText {
        return ()
      }
      if run text_selection.hostText(&mut tree, String.view(&text), false) {
        return ()
      }
      run edit.textInput(&mut tree, move text)
    }
    Input.ImePreedit { text, selectionStart, selectionEnd } => {
      if run text_selection.hostText(&mut tree, String.view(&text), true) {
        return ()
      }
      run edit.preedit(&mut tree, move text, selectionStart, selectionEnd)
    }
    Input.Command { command } => {
      let slot = remembered(&tree.*)
      run clipboard.finishCommand(&mut tree, slot, command, prevented)
    }
    Input.Paste { text, .. } => {
      let slot = remembered(&tree.*)
      run clipboard.finishPaste(&mut tree, slot, move text, prevented)
    }
    Input.Edit { inputType, text, .. } => {
      let slot = remembered(&tree.*)
      if !prevented && slot != NONE {
        run edit.applyEdit(&mut tree, slot, String.view(&inputType), String.view(&text))
      }
    }
    // A request has no default in the tree: the client that hears it acts.
    Input.Request { .. } => {}
    Input.TouchStart { .. } => {}
    Input.TouchMove { .. } => {}
    Input.TouchEnd { .. } => {}
    Input.TouchCancel { .. } => {}
    Input.Pinch { .. } => {}
  }
}

/// `moved` for a pointer move or a wheel: one at the pointer's current position while content
/// scrolled under it keeps hover where it is until the scroll settles (`UiTree.followHover`), as
/// browsers hold hover during a scroll. The wheel's own target is still hit tested.
effect fn movedStill(tree: &mut UiTree<'_>, x: f32, y: f32, modifiers: u32) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  if tree.pointerInside && tree.pointerX == x && tree.pointerY == y && tree.hoverHeld() {
    return hitSlot(&tree.*, x, y)
  }
  return run moved(&mut tree, x, y, modifiers)
}

/// Records the pointer at (`x`, `y`) and updates hover. Returns the hit node.
effect fn moved(tree: &mut UiTree<'_>, x: f32, y: f32, modifiers: u32) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  tree.pointerX = x
  tree.pointerY = y
  tree.pointerInside = true
  let hit = hitSlot(&tree.*, x, y)
  run updateHover(&mut tree, hit, modifiers)
  return hit
}
