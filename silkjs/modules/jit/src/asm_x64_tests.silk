// Runs assembled code, and checks labels, relocations and constant selection: the parts of the
// encoder that asm_x64_fixtures cannot compare with llvm-mc one instruction at a time.
import asm_x64 { Alu, Assembler, Code, Cond, LinkError, Mem, PackedOp, Reg, RelocationKind, Scale, ScalarOp, Unary, UnboundLabelError, Width, Xmm, argument, isCalleeSaved }
import code_memory { CodeBlock, CodeMemory, MemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.testing.testing { AssertionError, Testing }

const NO_SYMBOLS: [usize; 1] = [0]

/// Links `code` for the address it will run at and publishes it.
effect fn publish(memory: &mut CodeMemory, code: &mut Code, symbols: &[usize]) -> CodeBlock ! MemoryError | LinkError {
  let mut writer = run memory.allocate(code.bytes.length())
  run code.link(writer.address(), symbols)
  run writer.append(code.bytes.asSlice())
  return run writer.finish()
}

unsafe fn call1(block: &CodeBlock, a: u64) -> u64 {
  let address = block.entry()
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn(u64) -> u64>(Pointer.fromRef(&address))
  let function = unsafe Pointer.read<extern "C" fn(u64) -> u64>(slot)
  return unsafe function(a)
}
unsafe fn call2(block: &CodeBlock, a: i64, b: i64) -> i64 {
  let address = block.entry()
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn(i64, i64) -> i64>(Pointer.fromRef(&address))
  let function = unsafe Pointer.read<extern "C" fn(i64, i64) -> i64>(slot)
  return unsafe function(a, b)
}
unsafe fn callDoubles(block: &CodeBlock, a: f64, b: f64) -> f64 {
  let address = block.entry()
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn(f64, f64) -> f64>(Pointer.fromRef(&address))
  let function = unsafe Pointer.read<extern "C" fn(f64, f64) -> f64>(slot)
  return unsafe function(a, b)
}
unsafe fn callDoubleToInt(block: &CodeBlock, a: f64) -> u64 {
  let address = block.entry()
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn(f64) -> u64>(Pointer.fromRef(&address))
  let function = unsafe Pointer.read<extern "C" fn(f64) -> u64>(slot)
  return unsafe function(a)
}
unsafe fn callSlots(block: &CodeBlock, slots: *mut u64, index: u64) -> u64 {
  let address = block.entry()
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn(*mut u64, u64) -> u64>(Pointer.fromRef(&address))
  let function = unsafe Pointer.read<extern "C" fn(*mut u64, u64) -> u64>(slot)
  return unsafe function(slots, index)
}

/// A Silk function that generated code calls back through the C ABI.
export "C" fn tripled(value: u64) -> u64 { return value * 3 }

fn addressOfTripled() -> usize {
  let function: extern "C" fn(u64) -> u64 = tripled
  let slot = unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(u64) -> u64, *const usize>(Pointer.fromRef(&function))
  return unsafe Pointer.read<usize>(slot)
}

fn same(actual: &[u8], expected: &[u8]) -> bool {
  if actual.length != expected.length { return false }
  let mut index: usize = 0
  while index < expected.length {
    if actual[index] != expected[index] { return false }
    index = index + 1
  }
  return true
}

effect fn labelBytes() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  let top = run a.label()
  let end = run a.label()
  a.bind(top)
  run a.jcc(Cond.Equal, end)
  run a.jmp(top)
  run a.call(end)
  run a.leaLabel(Reg.R9, top)
  a.bind(end)
  run a.ret()
  return run a.finish()
}

test effect fn labelsResolveForwardAndBackward() -> () ! OutOfMemoryError | UnboundLabelError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let code = run labelBytes() |> Effect.provideMut<Allocator>(&mut allocator)
  // je +14 (to offset 16) and jmp -4 (to 0) take their 2-byte forms; call +7 (to 16) and
  // lea r9, [rip - 16] (to 0) keep 32-bit fields; ret.
  run Testing.expect(same(code.bytes.asSlice(),
    b"\x74\x0e\xeb\xfc\xe8\x07\x00\x00\x00\x4c\x8d\x0d\xf0\xff\xff\xff\xc3"),
    "each displacement is measured from the end of its instruction")
  run Testing.expect(code.relocations.length() == 0, "label references leave no relocation")
}

effect fn unboundJump() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  let bound = run a.label()
  let missing = run a.label()
  a.bind(bound)
  run a.jmp(bound)
  run a.jmp(missing)
  return run a.finish()
}

test effect fn unboundLabelFailsFinish() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(unboundJump()) |> Effect.provideMut<Allocator>(&mut allocator)
  match move result {
    Result<Code, OutOfMemoryError | UnboundLabelError>.Success { .. } => { run Testing.expect(false, "finish must reject an unbound label") }
    Result<Code, OutOfMemoryError | UnboundLabelError>.Failure { error } => {
      match move error {
        UnboundLabelError { label } => { run Testing.expect(label == 1, "the error names the second label") }
        OutOfMemoryError { .. } => { run Testing.expect(false, "not an allocation failure") }
      }
    }
  }
}

effect fn constants() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  run a.loadConstant(Reg.Rax, 0)
  run a.loadConstant(Reg.Rax, 4294967295)
  run a.loadConstant(Reg.Rax, 18446744073709551615)
  run a.loadConstant(Reg.Rax, 18446744071562067968)
  run a.loadConstant(Reg.Rax, 4294967296)
  run a.loadConstant(Reg.Rax, 18446744071562067967)
  return run a.finish()
}

test effect fn loadConstantPicksTheShortestForm() -> () ! OutOfMemoryError | UnboundLabelError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let code = run constants() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(same(code.bytes.asSlice(),
    b"\xb8\x00\x00\x00\x00\xb8\xff\xff\xff\xff\x48\xc7\xc0\xff\xff\xff\xff\x48\xc7\xc0\x00\x00\x00\x80\x48\xb8\x00\x00\x00\x00\x01\x00\x00\x00\x48\xb8\xff\xff\xff\x7f\xff\xff\xff\xff"),
    "5 bytes below 2^32, 7 when sign-extension reaches it, 10 otherwise")
}

effect fn sumTo() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  let again = run a.label()
  let done = run a.label()
  run a.alu(Alu.Xor, Width.W32, Reg.Rax, Reg.Rax)
  run a.test(Width.W64, Reg.Rdi, Reg.Rdi)
  run a.jcc(Cond.Equal, done)
  a.bind(again)
  run a.alu(Alu.Add, Width.W64, Reg.Rax, Reg.Rdi)
  run a.aluImm(Alu.Sub, Width.W64, Reg.Rdi, 1)
  run a.jcc(Cond.NotEqual, again)
  a.bind(done)
  run a.ret()
  return run a.finish()
}

test effect fn loopWithLabelsRuns() -> () ! OutOfMemoryError | UnboundLabelError | MemoryError | LinkError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut code = run sumTo() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut memory = run CodeMemory.reserve(65536)
  let block = run publish(&mut memory, &mut code, Slice.view<usize>(&NO_SYMBOLS, 0, 0))
  run Testing.expect(unsafe call1(&block, 0) == 0, "the forward branch skips the loop")
  run Testing.expect(unsafe call1(&block, 10) == 55, "the backward branch repeats it")
  run Testing.expect(unsafe call1(&block, 100000) == 5000050000, "64-bit accumulation")
}

effect fn callsBack() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  // Entry has rsp 8 past a 16-byte boundary; one push realigns it and saves rbx.
  run a.push(Reg.Rbx)
  run a.mov(Width.W64, Reg.Rbx, argument(0))
  run a.movSymbol(Reg.Rax, 0)
  run a.callReg(Reg.Rax)
  run a.alu(Alu.Add, Width.W64, Reg.Rax, Reg.Rbx)
  run a.pop(Reg.Rbx)
  run a.ret()
  return run a.finish()
}

test effect fn generatedCodeCallsSilkThroughAnAbsoluteRelocation() -> () ! OutOfMemoryError | UnboundLabelError | MemoryError | LinkError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut code = run callsBack() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(code.relocations.length() == 1, "movSymbol records one relocation")
  let record = code.relocations.get(0)
  run Testing.expect(record.offset == 6 && record.kind == RelocationKind.Absolute64 && record.symbol == 0,
    "the record points at the 8 constant bytes")
  run Testing.expect(isCalleeSaved(Reg.Rbx) && !isCalleeSaved(Reg.Rax), "rbx survives the call, rax does not")
  let mut memory = run CodeMemory.reserve(65536)
  let symbols: [usize; 1] = [addressOfTripled()]
  let block = run publish(&mut memory, &mut code, &symbols)
  run Testing.expect(unsafe call1(&block, 7) == 28, "x + tripled(x), with x kept in rbx across the call")
}

effect fn relativeCall() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  // Offset 0: the callee, add 1.
  run a.lea(Width.W64, Reg.Rax, Mem.at(Reg.Rdi, 1))
  run a.ret()
  // Offset 5: the entry, which calls offset 0 through a relocation and doubles the result.
  run a.callSymbol(0)
  run a.alu(Alu.Add, Width.W64, Reg.Rax, Reg.Rax)
  run a.ret()
  return run a.finish()
}

unsafe fn call1At(block: &CodeBlock, offset: usize, a: u64) -> u64 {
  let address = unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(block.entry()), offset)
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn(u64) -> u64>(Pointer.fromRef(&address))
  let function = unsafe Pointer.read<extern "C" fn(u64) -> u64>(slot)
  return unsafe function(a)
}

test effect fn relativeRelocationLinksNearAndRejectsFar() -> () ! OutOfMemoryError | UnboundLabelError | MemoryError | LinkError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut code = run relativeCall() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut memory = run CodeMemory.reserve(65536)
  let mut writer = run memory.allocate(code.bytes.length())
  let base = writer.address()
  let far: [usize; 1] = [addressOfTripled()]
  let rejected = run Effect.result(code.link(base, &far))
  match move rejected {
    Result<(), LinkError>.Success { .. } => { run Testing.expect(false, "the test binary is not within 2 GiB of the code region") }
    Result<(), LinkError>.Failure { error } => { run Testing.expect(error.relocation == 0 && !error.unknownSymbol, "a far target is a range error") }
  }
  let missing = run Effect.result(code.link(base, Slice.view<usize>(&far, 0, 0)))
  match move missing {
    Result<(), LinkError>.Success { .. } => { run Testing.expect(false, "symbol 0 is not in an empty table") }
    Result<(), LinkError>.Failure { error } => { run Testing.expect(error.unknownSymbol, "a missing symbol is reported as such") }
  }
  let near: [usize; 1] = [base]
  run code.link(base, &near)
  run writer.append(code.bytes.asSlice())
  let block = run writer.finish()
  run Testing.expect(unsafe call1At(&block, 5, 20) == 42, "the relinked call reaches offset 0")
}

effect fn hypotenuse() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  run a.scalar(ScalarOp.Mul, Xmm.Xmm0, Xmm.Xmm0)
  run a.scalar(ScalarOp.Mul, Xmm.Xmm1, Xmm.Xmm1)
  run a.scalar(ScalarOp.Add, Xmm.Xmm0, Xmm.Xmm1)
  run a.scalar(ScalarOp.Sqrt, Xmm.Xmm0, Xmm.Xmm0)
  run a.ret()
  return run a.finish()
}

effect fn truncate() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  // Returns the truncated integer, or the raw bits when the double is NaN.
  let unordered = run a.label()
  run a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm0)
  run a.jcc(Cond.Parity, unordered)
  run a.doubleToInt(Width.W64, Reg.Rax, Xmm.Xmm0)
  run a.ret()
  a.bind(unordered)
  run a.doubleToBits(Reg.Rax, Xmm.Xmm0)
  run a.ret()
  return run a.finish()
}

test effect fn doubleCodeRuns() -> () ! OutOfMemoryError | UnboundLabelError | MemoryError | LinkError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut memory = run CodeMemory.reserve(65536)
  let mut code = run hypotenuse() |> Effect.provideMut<Allocator>(&mut allocator)
  let block = run publish(&mut memory, &mut code, Slice.view<usize>(&NO_SYMBOLS, 0, 0))
  run Testing.expect(unsafe callDoubles(&block, 3.0, 4.0) == 5.0, "sqrt(a*a + b*b)")
  let mut second = run truncate() |> Effect.provideMut<Allocator>(&mut allocator)
  let truncating = run publish(&mut memory, &mut second, Slice.view<usize>(&NO_SYMBOLS, 0, 0))
  run Testing.expect(unsafe callDoubleToInt(&truncating, 41.9) == 41, "cvttsd2si truncates toward zero")
  run Testing.expect(unsafe callDoubleToInt(&truncating, 0.0 / 0.0) > 9218868437227405312, "a NaN takes the parity branch and returns its bits")
}

effect fn slotUpdate() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  // rax = slots[index]; slots[index + 1] += rax.
  run a.load(Width.W64, Reg.Rax, Mem.indexed(Reg.Rdi, Reg.Rsi, Scale.Eight, 0))
  run a.aluStore(Alu.Add, Width.W64, Mem.indexed(Reg.Rdi, Reg.Rsi, Scale.Eight, 8), Reg.Rax)
  run a.ret()
  return run a.finish()
}

test effect fn indexedMemoryOperandsRun() -> () ! OutOfMemoryError | UnboundLabelError | MemoryError | LinkError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut memory = run CodeMemory.reserve(65536)
  let mut code = run slotUpdate() |> Effect.provideMut<Allocator>(&mut allocator)
  let block = run publish(&mut memory, &mut code, Slice.view<usize>(&NO_SYMBOLS, 0, 0))
  let mut slots: [u64; 3] = [10, 20, 30]
  let result = unsafe callSlots(&block, Pointer.fromMutRef(&mut slots[0]), 1)
  run Testing.expect(result == 20 && slots[0] == 10 && slots[1] == 20 && slots[2] == 50, "load slots[1], add it into slots[2]")
}

effect fn signedQuotientPlusMax() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  // rax = a / b (signed); rcx = max(a, b); return rax + rcx.
  run a.mov(Width.W64, Reg.Rax, Reg.Rdi)
  run a.signExtendAccumulator(Width.W64)
  run a.unary(Unary.Idiv, Width.W64, Reg.Rsi)
  run a.mov(Width.W64, Reg.Rcx, Reg.Rdi)
  run a.alu(Alu.Cmp, Width.W64, Reg.Rdi, Reg.Rsi)
  run a.cmov(Cond.Less, Width.W64, Reg.Rcx, Reg.Rsi)
  run a.alu(Alu.Add, Width.W64, Reg.Rax, Reg.Rcx)
  run a.ret()
  return run a.finish()
}

test effect fn signedDivisionAndConditionalMoveRun() -> () ! OutOfMemoryError | UnboundLabelError | MemoryError | LinkError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut memory = run CodeMemory.reserve(65536)
  let mut code = run signedQuotientPlusMax() |> Effect.provideMut<Allocator>(&mut allocator)
  let block = run publish(&mut memory, &mut code, Slice.view<usize>(&NO_SYMBOLS, 0, 0))
  run Testing.expect(unsafe call2(&block, -100, 7) == -7, "-100 / 7 is -14, max is 7")
  run Testing.expect(unsafe call2(&block, 100, -7) == 86, "100 / -7 is -14, max is 100")
}
