//! A command line for the compressor of `modules/zstd`, for tests and benchmarks.
//!
//! It reads its arguments from the environment:
//! - `ZIN`, `ZOUT`: the input file and the output file.
//! - `ZPARAMS`: integers separated by spaces, as pairs of a `ZSTD_cParameter` and a value, set
//!   in order with `ZSTD_CCtx_setParameter`.
//! - `ZPLEDGE`: if set, the size given to `ZSTD_CCtx_setPledgedSrcSize`.
//! - `ZICHUNK`: 0 or unset for one-shot mode: `compressStream2(e_end)` on the whole input until
//!   it returns 0. Else the size of an input chunk: each chunk is given with `e_continue`, or
//!   with `e_flush` for each `ZFLUSH`-th chunk, until it is consumed (and flushed); then
//!   `e_end` with no input until it returns 0.
//! - `ZOCHUNK`: the size of the output buffer of each call (default 16384).
//! - `ZTRACE`: if set, a file that gets one line per API call: `P id value result` for a
//!   parameter, `S result` for the pledge, `C endOp result srcPos dstPos` for a compression call.
//! - `ZLOOPS`: in streaming mode, how many times the input is fed into each frame (default 1).
//! - `ZREPEAT`: how many frames to compress in a row with the same context (default 1); each
//!   frame is written to the output.
//! - `ZDICT`: if set, a dictionary file given to `ZSTD_CCtx_loadDictionary` after the parameters
//!   (trace line `D result`).
//! - `ZRESET`: if 1, `ZSTD_CCtx_reset(ZSTD_reset_session_only)` before each frame after the first
//!   (trace line `R result`).
//! - `ZDROP`: if set to `k`, `ZSTD_CCtx_loadDictionary(NULL, 0)` before frame `k` (from 0).
//! - `ZMIDLOAD`: if 1, in streaming mode, `ZSTD_CCtx_loadDictionary` again after the first chunk of
//!   the first frame, while the frame is in progress (trace line `D result`).
//! It prints the sizes and the CPU time, and exits with 1 after an error of the library.
import zstd.compress
import zstd.errors
import zstd.mem
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.i32
import silk.num.i64
import silk.num.usize

unsafe extern "C" fn getenv(name: ?[*]const u8) -> ?[*]mut u8
unsafe extern "C" fn fopen(path: ?[*]const u8, mode: ?[*]const u8) -> ?*mut u8
unsafe extern "C" fn fread(data: ?[*]mut u8, size: usize, count: usize, file: ?*mut u8) -> usize
unsafe extern "C" fn fwrite(data: ?[*]const u8, size: usize, count: usize, file: ?*mut u8) -> usize
unsafe extern "C" fn fclose(file: ?*mut u8) -> i32
unsafe extern "C" fn fseek(file: ?*mut u8, offset: i64, whence: i32) -> i32
unsafe extern "C" fn ftell(file: ?*mut u8) -> i64
unsafe extern "C" fn malloc(size: usize) -> ?[*]mut u8
unsafe extern "C" fn clock() -> i64
unsafe extern "C" fn printf(format: ?[*]const u8, a: i64, b: i64, c: i64) -> i32
unsafe extern "C" fn fprintf(file: ?*mut u8, format: ?[*]const u8, a: i64, b: i64, c: i64, d: i64) -> i32

unsafe fn env(name: &[u8]) -> ?[*]mut u8 { return unsafe getenv(Pointer.fromSlice<u8>(name)) }

// Parses the integers of the NUL-terminated `text` into `out`, and returns how many there are.
unsafe fn parseInts(text: ?[*]mut u8, out: &mut [i64; 128]) -> usize {
  if Pointer.isNullMany<u8>(text) { return 0 }
  let p = unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]const u8>(text)
  let mut n: usize = 0
  let mut i: usize = 0
  while n < 128 {
    let mut ch = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(p, i))
    while ch == 32 || ch == 44 { i = i + 1 ch = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(p, i)) }
    if ch == 0 { break }
    let mut negative = false
    if ch == 45 { negative = true i = i + 1 ch = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(p, i)) }
    let mut value: i64 = 0
    while ch >= 48 && ch <= 57 {
      value = value * 10 + u8.toI64(ch - 48)
      i = i + 1
      ch = unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(p, i))
    }
    if ch != 0 && ch != 32 && ch != 44 { break }
    out[n] = if negative { 0 - value } else { value }
    n = n + 1
  }
  return n
}

unsafe fn envInt(name: &[u8], fallback: i64) -> i64 {
  let mut values: [i64; 128] = [0; 128]
  if unsafe parseInts(unsafe env(name), &mut values) == 0 { return fallback }
  return values[0]
}

pub fn main() -> i32 {
  unsafe {
    let inFile = fopen(env(b"ZIN\0"), Pointer.fromSlice<u8>(b"rb\0"))
    if Pointer.isNull<u8>(inFile) { let _p = printf(Pointer.fromSlice<u8>(b"cannot open ZIN\n\0"), 0, 0, 0) return 2 }
    let _s = fseek(inFile, 0, 2)
    let length = i64.toUsize(ftell(inFile))
    let _s2 = fseek(inFile, 0, 0)
    let inRaw = malloc(length + 64)
    let got = fread(inRaw, 1, length, inFile)
    let _c = fclose(inFile)
    if got != length { return 2 }
    let input = Intrinsic.pointerRequalify<?[*]mut u8, [*]const u8>(inRaw)
    let outFile = fopen(env(b"ZOUT\0"), Pointer.fromSlice<u8>(b"wb\0"))
    if Pointer.isNull<u8>(outFile) { let _p = printf(Pointer.fromSlice<u8>(b"cannot open ZOUT\n\0"), 0, 0, 0) return 2 }
    let tracePath = env(b"ZTRACE\0")
    let mut trace = Pointer.null<u8>()
    if !Pointer.isNullMany<u8>(tracePath) { trace = fopen(tracePath, Pointer.fromSlice<u8>(b"wb\0")) }
    let tracing = !Pointer.isNull<u8>(trace)
    let ichunk = i64.toUsize(envInt(b"ZICHUNK\0", 0))
    let ochunk = i64.toUsize(envInt(b"ZOCHUNK\0", 16384))
    let flushEvery = i64.toUsize(envInt(b"ZFLUSH\0", 0))
    let pledge = envInt(b"ZPLEDGE\0", -1)
    let repeat = envInt(b"ZREPEAT\0", 1)
    let loops = envInt(b"ZLOOPS\0", 1)
    let outBuffer = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(malloc(ochunk + 64))
    let mut params: [i64; 128] = [0; 128]
    let nbParams = parseInts(env(b"ZPARAMS\0"), &mut params)
    let c = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(compress.createCCtx())
    let mut failed = false
    let mut k: usize = 0
    while k + 1 < nbParams {
      let r = compress.cctxSetParameter(c, i64.toI32(params[k]), i64.toI32(params[k + 1]))
      if tracing { let _t = fprintf(trace, Pointer.fromSlice<u8>(b"P %ld %ld %ld\n\0"), params[k], params[k + 1], usize.wrappingToI64(r), 0) }
      if errors.isError(r) { failed = true }
      k = k + 2
    }
    // The dictionary.
    let dictPath = env(b"ZDICT\0")
    let mut dictLength: usize = 0
    let mut dictRaw = malloc(64)
    let hasDict = !Pointer.isNullMany<u8>(dictPath)
    if hasDict {
      let dictFile = fopen(dictPath, Pointer.fromSlice<u8>(b"rb\0"))
      if Pointer.isNull<u8>(dictFile) { let _p = printf(Pointer.fromSlice<u8>(b"cannot open ZDICT\n\0"), 0, 0, 0) return 2 }
      let _s3 = fseek(dictFile, 0, 2)
      dictLength = i64.toUsize(ftell(dictFile))
      let _s4 = fseek(dictFile, 0, 0)
      dictRaw = malloc(dictLength + 64)
      let gotDict = fread(dictRaw, 1, dictLength, dictFile)
      let _c2 = fclose(dictFile)
      if gotDict != dictLength { return 2 }
      if !failed {
        let r = compress.cctxLoadDictionary(c, Intrinsic.pointerRequalify<?[*]mut u8, ?[*]const u8>(dictRaw), dictLength)
        if tracing { let _t = fprintf(trace, Pointer.fromSlice<u8>(b"D %ld\n\0"), usize.wrappingToI64(r), 0, 0, 0) }
        if errors.isError(r) { failed = true }
      }
    }
    let resetEach = envInt(b"ZRESET\0", 0)
    let dropAt = envInt(b"ZDROP\0", -1)
    let midLoad = envInt(b"ZMIDLOAD\0", 0)
    let start = clock()
    let mut total: usize = 0
    let mut frame: i64 = 0
    while frame < repeat && !failed {
      if frame > 0 && resetEach == 1 {
        let r = compress.cctxReset(c, 1)
        if tracing { let _t = fprintf(trace, Pointer.fromSlice<u8>(b"R %ld\n\0"), usize.wrappingToI64(r), 0, 0, 0) }
        if errors.isError(r) { failed = true }
      }
      if frame == dropAt {
        let r = compress.cctxLoadDictionary(c, Intrinsic.pointerRequalify<?[*]mut u8, ?[*]const u8>(mem.nullp()), 0)
        if tracing { let _t = fprintf(trace, Pointer.fromSlice<u8>(b"D %ld\n\0"), usize.wrappingToI64(r), 0, 0, 0) }
        if errors.isError(r) { failed = true }
      }
      if pledge >= 0 {
        let r = compress.cctxSetPledgedSrcSize(c, i64.toU64(pledge))
        if tracing { let _t = fprintf(trace, Pointer.fromSlice<u8>(b"S %ld\n\0"), usize.wrappingToI64(r), 0, 0, 0) }
        if errors.isError(r) { failed = true }
      }
      if ichunk == 0 {
        let mut srcPos: usize = 0
        while !failed {
          let mut dstPos: usize = 0
          let r = compress.compressStream2(c, outBuffer, ochunk, &mut dstPos, input, length, &mut srcPos, 2)
          if tracing { let _t = fprintf(trace, Pointer.fromSlice<u8>(b"C %ld %ld %ld %ld\n\0"), 2, usize.wrappingToI64(r), usize.wrappingToI64(srcPos), usize.wrappingToI64(dstPos)) }
          let _w = fwrite(Intrinsic.pointerRequalify<[*]mut u8, ?[*]const u8>(outBuffer), 1, dstPos, outFile)
          total = total + dstPos
          if errors.isError(r) { failed = true }
          if r == 0 { break }
        }
      } else {
        let mut offset: usize = 0
        let mut index: usize = 0
        let mut loopsLeft = loops
        while !failed {
          if offset >= length {
            loopsLeft = loopsLeft - 1
            if loopsLeft <= 0 || length == 0 { break }
            offset = 0
          }
          let size = if length - offset < ichunk { length - offset } else { ichunk }
          index = index + 1
          let endOp: i32 = if flushEvery != 0 && index % flushEvery == 0 { 1 } else { 0 }
          let chunk = Intrinsic.pointerRequalify<*const u8, [*]const u8>(Pointer.at<u8>(input, offset))
          let mut srcPos: usize = 0
          while !failed {
            let mut dstPos: usize = 0
            let r = compress.compressStream2(c, outBuffer, ochunk, &mut dstPos, chunk, size, &mut srcPos, endOp)
            if tracing { let _t = fprintf(trace, Pointer.fromSlice<u8>(b"C %ld %ld %ld %ld\n\0"), i32.toI64(endOp), usize.wrappingToI64(r), usize.wrappingToI64(srcPos), usize.wrappingToI64(dstPos)) }
            let _w = fwrite(Intrinsic.pointerRequalify<[*]mut u8, ?[*]const u8>(outBuffer), 1, dstPos, outFile)
            total = total + dstPos
            if errors.isError(r) { failed = true }
            if srcPos == size && (endOp == 0 || r == 0) { break }
          }
          if midLoad == 1 && frame == 0 && index == 1 && hasDict {
            let r = compress.cctxLoadDictionary(c, Intrinsic.pointerRequalify<?[*]mut u8, ?[*]const u8>(dictRaw), dictLength)
            if tracing { let _t = fprintf(trace, Pointer.fromSlice<u8>(b"D %ld\n\0"), usize.wrappingToI64(r), 0, 0, 0) }
          }
          offset = offset + size
        }
        while !failed {
          let mut dstPos: usize = 0
          let mut srcPos: usize = 0
          let r = compress.compressStream2(c, outBuffer, ochunk, &mut dstPos, input, 0, &mut srcPos, 2)
          if tracing { let _t = fprintf(trace, Pointer.fromSlice<u8>(b"C %ld %ld %ld %ld\n\0"), 2, usize.wrappingToI64(r), usize.wrappingToI64(srcPos), usize.wrappingToI64(dstPos)) }
          let _w = fwrite(Intrinsic.pointerRequalify<[*]mut u8, ?[*]const u8>(outBuffer), 1, dstPos, outFile)
          total = total + dstPos
          if errors.isError(r) { failed = true }
          if r == 0 { break }
        }
      }
      frame = frame + 1
    }
    let elapsed = clock() - start
    compress.freeCCtx(c)
    let _d = fclose(outFile)
    if tracing { let _d2 = fclose(trace) }
    let _p = printf(Pointer.fromSlice<u8>(b"in %ld out %ld usec %ld\n\0"), usize.toI64(length), usize.toI64(total), elapsed)
    if failed { return 1 }
    return 0
  }
}
