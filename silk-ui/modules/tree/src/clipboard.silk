//! Copy, cut and paste as the W3C Clipboard API and events have them. The shortcut, the Edit
//! menu and the context menu all go through `Input.Command`: `copy` or `cut` fires at the
//! focused node, and unless a listener prevents it the selection goes to the clipboard (and a
//! cut queues its `deleteByCut` edit). A paste reads the clipboard first, then `paste` fires
//! with what it holds, and unless prevented an editable target gets an `insertFromPaste`
//! edit. Edits fire `beforeinput` before they change anything. Each step is its own input
//! (`UiTree.takeFollowUp`), so the client decides on each as a browser's handlers do.
import engine { UiTree }
import edit
import edit { HostRequest, Keymap }
import input { Input, EditCommand, MOD_SHIFT, MOD_CONTROL, MOD_ALT, MOD_META }
import mutation { LISTEN_CLIPBOARD, LISTEN_BEFORE_INPUT, NodeKind }
import node { NONE, Event, EventKind }
import text_selection
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.text.string { String }

/// The clipboard command a key down with `modifiers` asks for: Command or Control with C, X
/// or V, and elsewhere than macOS also Control+Insert, Shift+Insert and Shift+Delete.
pub fn shortcut(keymap: Keymap, key: string, modifiers: u32) -> Option<EditCommand> {
  let shift = u32.bitAnd(modifiers, MOD_SHIFT) != 0
  let control = u32.bitAnd(modifiers, MOD_CONTROL) != 0
  let alt = u32.bitAnd(modifiers, MOD_ALT) != 0
  let meta = u32.bitAnd(modifiers, MOD_META) != 0
  let mac = keymap == Keymap.Mac
  let primary = if mac {
    meta && !control
  } else {
    control && !meta
  }
  if primary && !alt {
    if edit.letter(key, "c") {
      return Option<EditCommand>.some(EditCommand.Copy)
    }
    if edit.letter(key, "x") {
      return Option<EditCommand>.some(EditCommand.Cut)
    }
    if edit.letter(key, "v") {
      return Option<EditCommand>.some(EditCommand.Paste)
    }
  }
  if !mac && !alt && !meta {
    if key == "Insert" && control && !shift {
      return Option<EditCommand>.some(EditCommand.Copy)
    }
    if key == "Insert" && shift && !control {
      return Option<EditCommand>.some(EditCommand.Paste)
    }
    if key == "Delete" && shift && !control {
      return Option<EditCommand>.some(EditCommand.Cut)
    }
  }
  return Option<EditCommand>.None
}

/// Whether `slot` or a node above it listens for `flag`.
fn pathListens(tree: &UiTree<'_>, slot: u32, flag: u32) -> bool {
  let mut at = slot
  while at != NONE {
    if u32.bitAnd(tree.node(at).listeners, flag) != 0 {
      return true
    }
    at = tree.node(at).parent
  }
  return false
}

/// Where a clipboard command goes: `keyTarget` (the focused node, or the root) while something
/// has focus, else the element holding the selection's focus, as the spec has it.
pub effect fn target(tree: &mut UiTree<'_>, keyTarget: u32) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  if tree.focused != NONE && keyTarget == tree.focused {
    return keyTarget
  }
  run text_selection.refresh(&mut tree)
  if !tree.textSelection.ranged() {
    return keyTarget
  }
  let slot = tree.textSelection.focus.slot
  if tree.node(slot).kind == NodeKind.Text && tree.node(slot).parent != NONE {
    return tree.node(slot).parent
  }
  return slot
}

/// Whether a clipboard command from `keyTarget` would do anything: an input has focus, text is
/// selected, or a listener on the way hears the event.
pub effect fn matters(tree: &mut UiTree<'_>, keyTarget: u32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let slot = run target(&mut tree, keyTarget)
  return slot != NONE && (edit.focusedInput(&tree.*) != NONE || text_selection.focusedHost(&tree.*) != NONE
    || tree.textSelection.ranged() || pathListens(&tree.*, slot, LISTEN_CLIPBOARD))
}

effect fn record(tree: &UiTree<'_>, kind: EventKind, slot: u32) -> Event
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut path = List<u32>.make()
  run tree.pathTo(slot, &mut path)
  return Event.make(kind, tree.node(slot).id, move path)
}

/// The `copy` or `cut` record of `command` at `slot`, when something on its path listens.
pub effect fn beginCommand(tree: &mut UiTree<'_>, slot: u32, command: EditCommand) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if slot == NONE || !pathListens(&tree.*, slot, LISTEN_CLIPBOARD) {
    return ()
  }
  let kind = if command == EditCommand.Copy {
    EventKind.Copy
  } else if command == EditCommand.Cut {
    EventKind.Cut
  } else {
    return ()
  }
  let event = run record(&tree.*, kind, slot)
  run tree.queueEvent(move event)
}

/// The default of `command` aimed at `slot` (the focused node), unless `prevented`.
pub effect fn finishCommand(tree: &mut UiTree<'_>, slot: u32, command: EditCommand, prevented: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if prevented {
    return ()
  }
  let input = edit.focusedInput(&tree.*)
  match command {
    EditCommand.Copy => {
      if input != NONE {
        drop run edit.copySelection(&mut tree, input)
      } else {
        drop run text_selection.copy(&mut tree)
      }
    }
    EditCommand.Cut => {
      if input == NONE && run text_selection.hostCut(&mut tree) {
        return ()
      }
      if input != NONE && run edit.cutSelection(&mut tree, input) {
        let id = tree.node(input).id
        run tree.queueFollowUp(Input.Edit {
          target: id,
          inputType: run String.copy("deleteByCut"),
          text: String.make(),
        })
      }
    }
    EditCommand.Paste => run requestPaste(&mut tree, slot)
    EditCommand.SelectAll => {
      if input != NONE {
        run edit.selectEverything(&mut tree, input)
      } else {
        drop run text_selection.hostSelectAll(&mut tree)
      }
    }
    EditCommand.Undo => {
      if input != NONE {
        run edit.undo(&mut tree, input, false)
      } else {
        drop run text_selection.hostHistory(&mut tree, false)
      }
    }
    EditCommand.Redo => {
      if input != NONE {
        run edit.undo(&mut tree, input, true)
      } else {
        drop run text_selection.hostHistory(&mut tree, true)
      }
    }
  }
}

/// Asks the host for the clipboard on behalf of `slot`, when a paste there would do anything:
/// it is an input that takes text, or a listener on the way hears `paste`.
pub effect fn requestPaste(tree: &mut UiTree<'_>, slot: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if slot == NONE {
    return ()
  }
  if edit.editable(&tree.*, slot) || pathListens(&tree.*, slot, LISTEN_CLIPBOARD) {
    let id = tree.node(slot).id
    run tree.requests.append(HostRequest.ReadClipboard { target: id })
  }
}

/// The `paste` record at `slot`, with what the clipboard held.
pub effect fn beginPaste(tree: &mut UiTree<'_>, slot: u32, text: &String, html: &String, image: &List<u8>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if slot == NONE || !pathListens(&tree.*, slot, LISTEN_CLIPBOARD) {
    return ()
  }
  let mut event = run record(&tree.*, EventKind.Paste, slot)
  event.value = run String.copy(String.view(text))
  event.html = run String.copy(String.view(html))
  run event.image.appendSlice(image.asSlice())
  run tree.queueEvent(move event)
}

/// The default of a paste at `slot`, unless `prevented`: an editable focused input gets the
/// text through an `insertFromPaste` edit.
pub effect fn finishPaste(tree: &mut UiTree<'_>, slot: u32, text: String, prevented: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !prevented && run text_selection.hostPaste(&mut tree, slot, String.view(&text)) {
    return ()
  }
  if prevented || slot == NONE || slot != edit.focusedInput(&tree.*) || !edit.editable(&tree.*, slot) {
    return ()
  }
  if String.byteLength(String.view(&text)) == 0 {
    return ()
  }
  let id = tree.node(slot).id
  run tree.queueFollowUp(Input.Edit {
    target: id,
    inputType: run String.copy("insertFromPaste"),
    text: move text,
  })
}

/// The `beforeinput` record of an edit of `slot`.
pub effect fn beginEdit(tree: &mut UiTree<'_>, slot: u32, inputType: &String, text: &String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if slot == NONE || !pathListens(&tree.*, slot, LISTEN_BEFORE_INPUT) {
    return ()
  }
  let mut event = run record(&tree.*, EventKind.BeforeInput, slot)
  event.inputType = run String.copy(String.view(inputType))
  event.value = run String.copy(String.view(text))
  run tree.queueEvent(move event)
}

/// Asks the host for the edit menu of the focused input `slot` at (`x`, `y`).
pub effect fn editMenu(tree: &mut UiTree<'_>, slot: u32, x: f32, y: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let selected = edit.hasSelection(&tree.*, slot)
  let editable = edit.editable(&tree.*, slot)
  run tree.requests.append(HostRequest.ShowEditMenu {
    x: x,
    y: y,
    cut: selected && editable,
    copy: selected,
    paste: editable,
  })
}
