//! A GPU canvas in a window: the app draws a triangle with WebGPU on a device of its own and
//! a canvas node shows it. A click draws it again on another background. Pass --check for a
//! GPU smoke test that compares the window with the frame the app presented.
import ui_tree.css
import ui_tree.css { px }
import ui_tree.legacy { UiTree, TreeError, Batch, Mutation, NodeKind, Attribute }
import ui_tree.mutation { Role, LISTEN_CLICK }
import ui_tree.node { Event, EventKind }
import ui_tree_window.host { WindowClient, RunOptions, runWindow, StartedGpu }
import ui_tree_window.platform_thread { Launched, launch }
import ui_tree_window.canvas_frames { CanvasPresenter }
import ui_tree_window.gpu_canvas { CanvasGpu, GpuCanvas, CANVAS_FORMAT_BGRA }
import ui_tree_window.console { StderrWriter }
import ui_fixtures.fixtures as fixtures
import ui_inspect_server.lib { Inspector }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import webgpu.resources as gpu
import webgpu.resources { RenderPipeline }
import webgpu.descriptors {
  Color,
  ColorTargetState,
  FragmentState,
  MultisampleState,
  PrimitiveState,
  RenderPassColorAttachment,
  RenderPassDescriptor,
  RenderPipelineDescriptor,
  TextureViewDescriptor,
  VertexState
}
import webgpu_sys.generated_webgpu as flags
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput }
import silk.text.string { String }

const WIDTH: u32 = 240

const HEIGHT: u32 = 160

const SHADER: &'static [u8] = b"@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {\n  var p = array<vec2f, 3>(vec2f(-0.75, -0.75), vec2f(0.75, -0.75), vec2f(0.0, 0.75));\n  return vec4f(p[i], 0.0, 1.0);\n}\n@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0, 0.8, 0.2, 1.0); }\n"

/// What the app made on its own device.
struct Drawing {
  gpu: CanvasGpu,
  canvas: GpuCanvas,
  pipeline: RenderPipeline,
}

struct App {
  presenter: Option<CanvasPresenter>,
  drawing: Option<Drawing>,
  clicks: u32,
}

struct Client {}

effect fn pipelineOf(gpuDevice: &CanvasGpu) -> RenderPipeline
  ! GpuError {
  let shader = run gpu.createShaderModule(&gpuDevice.device, b"gpu canvas triangle", SHADER)
  let vertex = VertexState.default().withModule(&shader).withEntryPoint(b"vs")
  let mut target: ColorTargetState = ColorTargetState.default()
  target.setFormat(CANVAS_FORMAT_BGRA)
  target.setWriteMask(flags.WGPUColorWriteMask_All)
  let targets = [target]
  let fragment = FragmentState.default().withModule(&shader).withEntryPoint(b"fs").withTargets(&targets)
  let mut primitive: PrimitiveState = PrimitiveState.default()
  primitive.setTopology(flags.WGPUPrimitiveTopology_TriangleList)
  let mut multisample: MultisampleState = MultisampleState.default()
  multisample.setCount(1)
  let mut descriptor = RenderPipelineDescriptor.default().withVertex(vertex).withFragment(&fragment)
  descriptor.setPrimitive(primitive)
  descriptor.setMultisample(multisample)
  return run gpu.createRenderPipeline(&gpuDevice.device, &descriptor)
}

/// Draws the triangle over a background that depends on `clicks`, and presents it.
effect fn draw(drawing: &mut Drawing, clicks: u32) -> ()
  ! GpuError | OutOfMemoryError {
  let view = run drawing.canvas.texture().createView(&TextureViewDescriptor.default())
  let mut clear = Color.default()
  if clicks % 2 == 0 {
    clear.setR(0.1)
    clear.setG(0.2)
    clear.setB(0.6)
  } else {
    clear.setR(0.1)
    clear.setG(0.5)
    clear.setB(0.3)
  }
  clear.setA(1.0)
  let mut attachment = RenderPassColorAttachment.default().withView(&view)
  attachment.setClearValue(clear)
  attachment.setLoadOp(flags.WGPULoadOp_Clear)
  attachment.setStoreOp(flags.WGPUStoreOp_Store)
  let attachments = [attachment]
  let descriptor = RenderPassDescriptor.default().withColorAttachments(&attachments)
  let mut encoder = run gpu.createCommandEncoder(&drawing.gpu.device, b"gpu canvas frame")
  let mut pass = run encoder.beginRenderPass(&descriptor)
  pass.setPipeline(&drawing.pipeline)
  pass.draw(3, 1, 0, 0)
  pass.end()
  let commands = run encoder.finish(b"gpu canvas frame")
  drawing.gpu.queue.submit(&[commands.reference()])
  run drawing.canvas.present(&drawing.gpu)
}

effect fn open(presenter: &CanvasPresenter) -> Drawing
  ! GpuError | OutOfMemoryError {
  let device = run CanvasGpu.open()
  // BGRA: the format whose frames reach the window without a copy where the GPUs share images.
  let canvas = run GpuCanvas.makeIn(&device, presenter, WIDTH, HEIGHT, CANVAS_FORMAT_BGRA)
  let pipeline = run pipelineOf(&device)
  return Drawing { gpu: move device, canvas: move canvas, pipeline: move pipeline }
}

effect fn noDrawing(error: GpuError | OutOfMemoryError) -> Option<Drawing> {
  drop error
  StderrWriter.print("gpu canvas: the app's GPU device could not be made\n", &())
  return Option<Drawing>.None
}

effect fn opened(presenter: &CanvasPresenter) -> Option<Drawing>
  ! GpuError | OutOfMemoryError {
  return Option<Drawing>.some(run open(presenter))
}

effect fn drawFailed(error: GpuError | OutOfMemoryError) -> () {
  drop error
  StderrWriter.print("gpu canvas: drawing failed\n", &())
}

impl WindowClient<App, never, never> for Client {
  effect fn canvases(self: &mut Self, state: &mut App, presenter: CanvasPresenter) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    state.presenter = Option<CanvasPresenter>.some(move presenter)
  }

  effect fn start(self: &mut Self, state: &mut App, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut batch = Batch.make()
    run batch.create(1, NodeKind.Box)
    run batch.root(1)
    run batch.box(1, 2, &[css.width(px(180.0)), css.height(px(40.0)), css.fontSize(px(20.0))])
    run batch.attribute(2, Attribute.TestId { value: run String.copy("draw") })
    run batch.attribute(2, Attribute.Role { value: Role.Button })
    run batch.attribute(2, Attribute.TabIndex { value: 0 })
    run batch.push(Mutation.SetListeners { id: 2, flags: LISTEN_CLICK })
    run batch.text(2, 3, "Draw again")
    run batch.create(4, NodeKind.Canvas)
    run batch.push(Mutation.InsertBefore { parent: 1, child: 4, before: Option<u32>.None })
    if let Option<CanvasPresenter>.Some { value: presenter } = &state.presenter {
      state.drawing = run Effect.catchAll(opened(&presenter), noDrawing)
    }
    if let Option<Drawing>.Some { value: drawing } = &mut state.drawing {
      run Effect.catchAll(draw(&mut drawing, 0), drawFailed)
      run batch.canvasSurface(4, drawing.canvas.surface(), WIDTH, HEIGHT, true)
    }
    run tree.apply(run batch.take())
  }

  effect fn pump(self: &mut Self, state: &mut App, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut events = List<Event>.make()
    run tree.takeEvents(&mut events)
    let values = events.asSlice()
    let mut i: usize = 0
    while i < values.length {
      if values[i].kind == EventKind.Click && values[i].target == 2 {
        state.clicks = state.clicks + 1
        if let Option<Drawing>.Some { value: drawing } = &mut state.drawing {
          run Effect.catchAll(draw(&mut drawing, state.clicks), drawFailed)
        }
        let mut batch = Batch.make()
        run batch.setText(3, "Drawn")
        run tree.apply(run batch.take())
      }
      i = i + 1
    }
  }
}

effect fn program(check: bool, platform: Option<Launched>) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut state = App {
    presenter: Option<CanvasPresenter>.None,
    drawing: Option<Drawing>.None,
    clicks: 0,
  }
  let mut client = Client {}
  let options = RunOptions {
    title: "GPU canvas",
    width: 400.0,
    height: 300.0,
    check: check,
    checkClick: "draw",
    checkExpect: "Drawn",
    lowestLatency: false,
    platform: move platform,
    gpu: Option<StartedGpu>.None,
  }
  return run runWindow(
    &mut state,
    &fonts,
    List<Mutation>.make(),
    move options,
    Inspector.off(),
    &mut client,
  )
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("GPU canvas example failed\n", &())
  return 2
}

fn runApp(check: bool, platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(check, move platform), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Opens the example, or verifies its GPU output with --check.
pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let count = run Effect.catchAll(HostInput.argumentCount(), noArguments)
  let check = count > 1
  // The main thread keeps the OS event loop; the app runs on its own thread.
  return run Effect.catchAll(
    launch(
      |platform: Option<Launched>| -> i32 {
        return runApp(check, move platform)
      },
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn noArguments<E>(error: E) -> usize {
  drop error
  return 0
}
