        let r = AesCcm.seal(Slice.view<u8>(&x.key, 0, x.keyLength), unsafe ctxIv(&anchor, &x.*), unsafe ctxAad(&anchor, &x.*), none(), Slice.viewMut<u8>(&mut nothing, 0, 0), Slice.viewMut<u8>(&mut x.tag, 0, length))
        match move r { Result<(), AesCcmError>.Success { .. } => { x.tagLength = length } Result<(), AesCcmError>.Failure { .. } => { return unsafe failWith(&mut c.*, b"") } }
      } else if x.kind != C_WRAP && x.kind != C_WRAP_PAD && x.kind != C_CCM && x.kind != C_CTS && x.kind != C_XTS && x.kind != C_DES3_WRAP { return unsafe failWith(&mut c.*, b"") }
