//! What the decoder's entropy stages share: the backward bit reader, the reader of FSE
//! distributions, and the reader of Huffman weights (`bitstream.h`, `entropy_common.c` and
//! `fse_decompress.c` of the reference).
import mem
import errors
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i32
import silk.num.usize

/// `BIT_DStream_unfinished`: the container was refilled and more input remains.
pub const UNFINISHED: u32 = 0
/// `BIT_DStream_endOfBuffer`: the container holds the last bits of the stream.
pub const END_OF_BUFFER: u32 = 1
/// `BIT_DStream_completed`: every bit was read.
pub const COMPLETED: u32 = 2
/// `BIT_DStream_overflow`: more bits were read than the stream holds.
pub const OVERFLOW: u32 = 3

const NO_POINTER: usize = 0xFFFFFFFFFFFFFFFF

/// A reader of a bitstream from its end to its start (`BIT_DStream_t`). `ptr`, `start` and `limit`
/// are offsets from `base`.
pub struct DStream {
  pub container: u64,
  pub consumed: u32,
  pub ptr: usize,
  pub start: usize,
  pub limit: usize,
  pub base: [*]const u8,
}

/// Returns a reader that is not started, over `base`.
pub fn emptyDStream(base: [*]const u8) -> DStream {
  return DStream { container: 0, consumed: 0, ptr: 0, start: 0, limit: 0, base: base }
}

/// Starts `bits` on the `size` bytes at `base[at..]` (`BIT_initDStream`). Returns `size`, or an
/// error if the stream is empty or has no end mark.
pub unsafe fn initDStream(bits: &mut DStream, base: [*]const u8, at: usize, size: usize) -> usize {
  bits.base = base
  if size < 1 {
    bits.container = 0 bits.consumed = 0 bits.ptr = at bits.start = at bits.limit = at
    return errors.err(errors.E_SRCSIZE_WRONG)
  }
  bits.start = at
  bits.limit = at + 8
  let lastByte = unsafe mem.r8(base, at + size - 1)
  if size >= 8 {
    bits.ptr = at + size - 8
    bits.container = unsafe mem.r64(base, bits.ptr)
    if lastByte == 0 { bits.consumed = 0 return errors.err(errors.E_GENERIC) }
    bits.consumed = 8 - mem.highbit32(u8.toU32(lastByte))
  } else {
    bits.ptr = at
    let mut container: u64 = 0
    let mut index: usize = 0
    while index < size {
      container = container | u64.shiftLeft(u8.toU64(unsafe mem.r8(base, at + index)), usize.toU64(index * 8))
      index = index + 1
    }
    bits.container = container
    if lastByte == 0 { bits.consumed = 0 return errors.err(errors.E_CORRUPTION_DETECTED) }
    bits.consumed = 8 - mem.highbit32(u8.toU32(lastByte)) + usize.toU32(8 - size) * 8
  }
  return size
}

/// Returns the next `count` bits without consuming them (`BIT_lookBits`). `count` is under 32.
@inlineAlways
pub fn lookBits(bits: &DStream, count: u32) -> u64 {
  let start = u32.wrappingSubtract(u32.wrappingSubtract(64, bits.consumed), count) & 63
  return u64.shiftRight(bits.container, u32.toU64(start)) & u64.wrappingSubtract(u64.shiftLeft(1, u32.toU64(count & 63)), 1)
}

/// Returns the next `count` bits without consuming them, for `count` of at least 1
/// (`BIT_lookBitsFast`).
@inlineAlways
pub fn lookBitsFast(bits: &DStream, count: u32) -> u64 {
  return u64.shiftRight(u64.shiftLeft(bits.container, u32.toU64(bits.consumed & 63)), u32.toU64(u32.wrappingSubtract(64, count) & 63))
}

/// Consumes `count` bits.
@inlineAlways
pub fn skipBits(bits: &mut DStream, count: u32) -> () { bits.consumed = u32.wrappingAdd(bits.consumed, count) }

/// Reads `count` bits (`BIT_readBits`).
@inlineAlways
pub fn readBits(bits: &mut DStream, count: u32) -> u64 {
  let value = lookBits(&bits, count)
  bits.consumed = u32.wrappingAdd(bits.consumed, count)
  return value
}

/// Reads `count` bits, for `count` of at least 1 (`BIT_readBitsFast`).
@inlineAlways
pub fn readBitsFast(bits: &mut DStream, count: u32) -> u64 {
  let value = lookBitsFast(&bits, count)
  bits.consumed = u32.wrappingAdd(bits.consumed, count)
  return value
}

/// Refills the container (`BIT_reloadDStream`) and returns the state of the stream.
@inlineAlways
pub unsafe fn reload(bits: &mut DStream) -> u32 {
  if bits.consumed > 64 {
    bits.ptr = NO_POINTER
    return OVERFLOW
  }
  if bits.ptr >= bits.limit {
    bits.ptr = usize.wrappingSubtract(bits.ptr, u32.toUsize(u32.shiftRight(bits.consumed, 3)))
    bits.consumed = bits.consumed & 7
    bits.container = unsafe mem.r64(bits.base, bits.ptr)
    return UNFINISHED
  }
  return unsafe reloadSlow(&mut bits)
}

@inlineNever
unsafe fn reloadSlow(bits: &mut DStream) -> u32 {
  if bits.ptr == bits.start {
    if bits.consumed < 64 { return END_OF_BUFFER }
    return COMPLETED
  }
  let mut count = u32.toUsize(u32.shiftRight(bits.consumed, 3))
  let mut result = UNFINISHED
  if bits.ptr - bits.start < count {
    count = bits.ptr - bits.start
    result = END_OF_BUFFER
  }
  bits.ptr = bits.ptr - count
  bits.consumed = bits.consumed - usize.toU32(count) * 8
  bits.container = unsafe mem.r64(bits.base, bits.ptr)
  return result
}

/// Returns whether every bit of the stream was read, and no more (`BIT_endOfDStream`).
@inlineAlways
pub fn endOfDStream(bits: &DStream) -> bool { return bits.ptr == bits.start && bits.consumed == 64 }

@inlineAlways
fn ctz32(value: u32) -> u32 { return u32.trailingZeros(value) }

/// Reads an FSE distribution from the `size` bytes at `src[at..]` (`FSE_readNCount`).
///
/// `maxSymbol` holds the largest symbol the caller accepts and receives the largest symbol read.
/// Returns the number of bytes read, or an error.
pub unsafe fn readNCount(norm: &mut [i32; 256], maxSymbol: &mut u32, tableLog: &mut u32, src: [*]const u8, at: usize, size: usize) -> usize {
  if size < 8 {
    let mut buffer: [u8; 8] = [0; 8]
    let mut index: usize = 0
    while index < size { buffer[index] = unsafe mem.r8(src, at + index) index = index + 1 }
    let copy = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(&buffer))
    let countSize = unsafe readNCount(&mut norm, &mut maxSymbol, &mut tableLog, copy, 0, 8)
    if errors.isError(countSize) { return countSize }
    if countSize > size { return errors.err(errors.E_CORRUPTION_DETECTED) }
    return countSize
  }
  let iend = at + size
  let mut ip = at
  let maxSV1 = maxSymbol.* + 1
  let mut charnum: u32 = 0
  let mut previous0 = false
  let mut index: u32 = 0
  while index < maxSV1 { norm[u32.toUsize(index)] = 0 index = index + 1 }
  let mut bitStream = unsafe mem.r32(src, ip)
  let mut nbBits: i32 = u32.toI32(bitStream & 15) + 5
  if nbBits > 15 { return errors.err(errors.E_TABLELOG_TOOLARGE) }
  bitStream = u32.shiftRight(bitStream, 4)
  let mut bitCount: i32 = 4
  tableLog.* = i32.toU32(nbBits)
  let mut remaining: i32 = i32.shiftLeft(1, nbBits) + 1
  let mut threshold: i32 = i32.shiftLeft(1, nbBits)
  nbBits = nbBits + 1
  while true {
    if previous0 {
      let mut repeats = u32.shiftRight(ctz32(u32.bitNot(bitStream) | 0x80000000), 1)
      while repeats >= 12 {
        charnum = charnum + 36
        if ip + 7 <= iend {
          ip = ip + 3
        } else {
          bitCount = bitCount - 8 * (usize.toI32(iend - 7) - usize.toI32(ip))
          bitCount = bitCount & 31
          ip = iend - 4
        }
        bitStream = u32.shiftRight(unsafe mem.r32(src, ip), i32.toU32(bitCount & 31))
        repeats = u32.shiftRight(ctz32(u32.bitNot(bitStream) | 0x80000000), 1)
      }
      charnum = charnum + 3 * repeats
      bitStream = u32.shiftRight(bitStream, 2 * repeats)
      bitCount = bitCount + u32.toI32(2 * repeats)
      charnum = charnum + (bitStream & 3)
      bitCount = bitCount + 2
      if charnum >= maxSV1 { break }
      if ip + 7 <= iend || ip + i32.toUsize(i32.shiftRight(bitCount, 3)) + 4 <= iend {
        ip = ip + i32.toUsize(i32.shiftRight(bitCount, 3))
        bitCount = bitCount & 7
      } else {
        bitCount = bitCount - 8 * (usize.toI32(iend - 4) - usize.toI32(ip))
        bitCount = bitCount & 31
        ip = iend - 4
      }
      bitStream = u32.shiftRight(unsafe mem.r32(src, ip), i32.toU32(bitCount & 31))
    }
    let max: i32 = (2 * threshold - 1) - remaining
    let mut count: i32 = 0
    if u32.toI32(bitStream & i32.toU32(threshold - 1)) < max {
      count = u32.toI32(bitStream & i32.toU32(threshold - 1))
      bitCount = bitCount + nbBits - 1
    } else {
      count = u32.toI32(bitStream & i32.toU32(2 * threshold - 1))
      if count >= threshold { count = count - max }
      bitCount = bitCount + nbBits
    }
    count = count - 1
    if count >= 0 { remaining = remaining - count } else { remaining = remaining + count }
    norm[u32.toUsize(charnum)] = count
    charnum = charnum + 1
    previous0 = count == 0
    if remaining < threshold {
      if remaining <= 1 { break }
      nbBits = u32.toI32(mem.highbit32(i32.toU32(remaining))) + 1
      threshold = i32.shiftLeft(1, nbBits - 1)
    }
    if charnum >= maxSV1 { break }
    if ip + 7 <= iend || ip + i32.toUsize(i32.shiftRight(bitCount, 3)) + 4 <= iend {
      ip = ip + i32.toUsize(i32.shiftRight(bitCount, 3))
      bitCount = bitCount & 7
    } else {
      bitCount = bitCount - 8 * (usize.toI32(iend - 4) - usize.toI32(ip))
      bitCount = bitCount & 31
      ip = iend - 4
    }
    bitStream = u32.shiftRight(unsafe mem.r32(src, ip), i32.toU32(bitCount & 31))
  }
  if remaining != 1 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  if charnum > maxSV1 { return errors.err(errors.E_MAXSYMBOLVALUE_TOOSMALL) }
  if bitCount > 32 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  maxSymbol.* = charnum - 1
  ip = ip + i32.toUsize(i32.shiftRight(bitCount + 7, 3))
  return ip - at
}

/// Returns the step of the FSE symbol spread for a table of `tableSize` cells (`FSE_TABLESTEP`).
@inlineAlways
pub fn tableStep(tableSize: u32) -> u32 { return u32.shiftRight(tableSize, 1) + u32.shiftRight(tableSize, 3) + 3 }

// Decodes the FSE-compressed Huffman weights at `src[at..at+size]` into `weights`, at most
// `capacity` of them (`FSE_decompress_wksp` with a table log of at most 6). Returns their count.
unsafe fn decodeWeights(weights: &mut [u8; 256], capacity: usize, src: [*]const u8, at: usize, size: usize) -> usize {
  let mut norm: [i32; 256] = [0; 256]
  let mut maxSymbol: u32 = 255
  let mut tableLog: u32 = 0
  let headerSize = unsafe readNCount(&mut norm, &mut maxSymbol, &mut tableLog, src, at, size)
  if errors.isError(headerSize) { return headerSize }
  if tableLog > 6 { return errors.err(errors.E_TABLELOG_TOOLARGE) }
  // The decoding table: cell = newState | symbol << 16 | nbBits << 24.
  let mut table: [u32; 64] = [0; 64]
  let mut symbolNext: [u32; 256] = [0; 256]
  let tableSize = u32.shiftLeft(1, tableLog)
  let mut highThreshold = tableSize - 1
  let largeLimit: i32 = u32.toI32(u32.shiftLeft(1, tableLog - 1))
  let mut fast = true
  let mut symbol: u32 = 0
  while symbol <= maxSymbol {
    let count = norm[u32.toUsize(symbol)]
    if count == -1 {
      table[u32.toUsize(highThreshold)] = u32.shiftLeft(symbol, 16)
      highThreshold = u32.wrappingSubtract(highThreshold, 1)
      symbolNext[u32.toUsize(symbol)] = 1
    } else {
      if count >= largeLimit { fast = false }
      symbolNext[u32.toUsize(symbol)] = i32.toU32(count)
    }
    symbol = symbol + 1
  }
  let tableMask = tableSize - 1
  let step = tableStep(tableSize)
  let mut position: u32 = 0
  symbol = 0
  while symbol <= maxSymbol {
    let count = norm[u32.toUsize(symbol)]
    let mut placed: i32 = 0
    while placed < count {
      table[u32.toUsize(position)] = u32.shiftLeft(symbol, 16)
      position = (position + step) & tableMask
      while position > highThreshold { position = (position + step) & tableMask }
      placed = placed + 1
    }
    symbol = symbol + 1
  }
  if position != 0 { return errors.err(errors.E_GENERIC) }
  let mut cell: u32 = 0
  while cell < tableSize {
    let cellSymbol = u32.shiftRight(table[u32.toUsize(cell)], 16)
    let nextState = symbolNext[u32.toUsize(cellSymbol)]
    symbolNext[u32.toUsize(cellSymbol)] = nextState + 1
    let nbBits = tableLog - mem.highbit32(nextState)
    let newState = u32.shiftLeft(nextState, nbBits) - tableSize
    table[u32.toUsize(cell)] = newState | u32.shiftLeft(cellSymbol, 16) | u32.shiftLeft(nbBits, 24)
    cell = cell + 1
  }
  // FSE_decompress_usingDTable_generic, with two states.
  let mut bits = emptyDStream(src)
  let initResult = unsafe initDStream(&mut bits, src, at + headerSize, size - headerSize)
  if errors.isError(initResult) { return initResult }
  let mut state1 = u64.toU32(readBits(&mut bits, tableLog))
  let _r1 = unsafe reload(&mut bits)
  let mut state2 = u64.toU32(readBits(&mut bits, tableLog))
  let _r2 = unsafe reload(&mut bits)
  if unsafe reload(&mut bits) == OVERFLOW { return errors.err(errors.E_CORRUPTION_DETECTED) }
  let mut op: usize = 0
  // The reference decodes four symbols a pass while the stream is unfinished; one state step a
  // pass reads the same bits in the same order, so the result is the same.
  while capacity >= 3 && op < capacity - 3 && unsafe reload(&mut bits) == UNFINISHED {
    let mut pass: u32 = 0
    while pass < 2 {
      let cell1 = table[u32.toUsize(state1)]
      weights[op] = u32.wrappingToU8(u32.shiftRight(cell1, 16))
      state1 = (cell1 & 0xFFFF) + u64.toU32(decodeBits(&mut bits, u32.shiftRight(cell1, 24), fast))
      let cell2 = table[u32.toUsize(state2)]
      weights[op + 1] = u32.wrappingToU8(u32.shiftRight(cell2, 16))
      state2 = (cell2 & 0xFFFF) + u64.toU32(decodeBits(&mut bits, u32.shiftRight(cell2, 24), fast))
      op = op + 2
      pass = pass + 1
    }
  }
  while true {
    if op + 2 > capacity { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
    let cell1 = table[u32.toUsize(state1)]
    weights[op] = u32.wrappingToU8(u32.shiftRight(cell1, 16))
    state1 = (cell1 & 0xFFFF) + u64.toU32(decodeBits(&mut bits, u32.shiftRight(cell1, 24), fast))
    op = op + 1
    if unsafe reload(&mut bits) == OVERFLOW {
      weights[op] = u32.wrappingToU8(u32.shiftRight(table[u32.toUsize(state2)], 16))
      op = op + 1
      break
    }
    if op + 2 > capacity { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
    let cell2 = table[u32.toUsize(state2)]
    weights[op] = u32.wrappingToU8(u32.shiftRight(cell2, 16))
    state2 = (cell2 & 0xFFFF) + u64.toU32(decodeBits(&mut bits, u32.shiftRight(cell2, 24), fast))
    op = op + 1
    if unsafe reload(&mut bits) == OVERFLOW {
      weights[op] = u32.wrappingToU8(u32.shiftRight(table[u32.toUsize(state1)], 16))
      op = op + 1
      break
    }
  }
  return op
}

@inlineAlways
fn decodeBits(bits: &mut DStream, count: u32, fast: bool) -> u64 {
  if fast { return readBitsFast(&mut bits, count) }
  return readBits(&mut bits, count)
}

/// Reads the Huffman weights of a table description at `src[at..at+size]` (`HUF_readStats`).
///
/// Fills `weights` (one per symbol) and `rankStats` (the number of symbols of each weight), and
/// sets the number of symbols and the table log. Returns the number of bytes read, or an error.
pub unsafe fn readStats(weights: &mut [u8; 256], rankStats: &mut [u32; 16], symbolCount: &mut u32, tableLog: &mut u32, src: [*]const u8, at: usize, size: usize) -> usize {
  if size == 0 { return errors.err(errors.E_SRCSIZE_WRONG) }
  let mut iSize = u8.toUsize(unsafe mem.r8(src, at))
  let mut oSize: usize = 0
  if iSize >= 128 {
    oSize = iSize - 127
    iSize = (oSize + 1) / 2
    if iSize + 1 > size { return errors.err(errors.E_SRCSIZE_WRONG) }
    if oSize >= 256 { return errors.err(errors.E_CORRUPTION_DETECTED) }
    let mut n: usize = 0
    while n < oSize {
      let byte = unsafe mem.r8(src, at + 1 + n / 2)
      weights[n] = u8.shiftRight(byte, 4)
      if n + 1 < 256 { weights[n + 1] = byte & 15 }
      n = n + 2
    }
  } else {
    if iSize + 1 > size { return errors.err(errors.E_SRCSIZE_WRONG) }
    oSize = unsafe decodeWeights(&mut weights, 255, src, at + 1, iSize)
    if errors.isError(oSize) { return oSize }
  }
  let mut rank: usize = 0
  while rank < 16 { rankStats[rank] = 0 rank = rank + 1 }
  let mut weightTotal: u32 = 0
  let mut n: usize = 0
  while n < oSize {
    let weight = u8.toU32(weights[n])
    if weight > 12 { return errors.err(errors.E_CORRUPTION_DETECTED) }
    rankStats[u32.toUsize(weight)] = rankStats[u32.toUsize(weight)] + 1
    weightTotal = weightTotal + u32.shiftRight(u32.shiftLeft(1, weight), 1)
    n = n + 1
  }
  if weightTotal == 0 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  let log = mem.highbit32(weightTotal) + 1
  if log > 12 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  tableLog.* = log
  let total = u32.shiftLeft(1, log)
  let rest = total - weightTotal
  let verif = u32.shiftLeft(1, mem.highbit32(rest))
  let lastWeight = mem.highbit32(rest) + 1
  if verif != rest { return errors.err(errors.E_CORRUPTION_DETECTED) }
  weights[oSize] = u32.wrappingToU8(lastWeight)
  rankStats[u32.toUsize(lastWeight)] = rankStats[u32.toUsize(lastWeight)] + 1
  if rankStats[1] < 2 || (rankStats[1] & 1) != 0 { return errors.err(errors.E_CORRUPTION_DETECTED) }
  symbolCount.* = usize.toU32(oSize + 1)
  return iSize + 1
}
