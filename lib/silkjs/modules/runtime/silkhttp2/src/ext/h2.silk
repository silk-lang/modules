//! An HTTP/2 session in Silk with the part of nghttp2 1.66's interface the runtime's bridge
//! (ext/http2_native) uses: the same functions, structures, callbacks and their order, error
//! codes and texts, and nghttp2's session rules (session.c, stream.c, http.c, submit.c and
//! helper.c ported): stream states and limits, flow control with application-driven window
//! updates, the outbound queues and their order, SETTINGS and their acknowledgement, PING and
//! SETTINGS ACK floods, GOAWAY, RST_STREAM rate limiting, HTTP messaging checks, padding,
//! CONTINUATION, ALTSVC and ORIGIN. Not here, as the bridge does not use them: the RFC 7540
//! priority tree (nghttp2 1.66 dropped it too), RFC 9218 urgencies, user extension frames,
//! upgrade from HTTP/1 and no-copy DATA. Header blocks are decoded whole when they end.
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i32
import silk.num.i64
import silk.num.usize
import ext.h2_mem { Buf, moveBytes, emptyBuf, nil, nonnull, constant, at, atConst, byte, setByte, equals, cText, textPointer, getU16, getU32 }
import ext.h2_hpack { releaseCodes, Inflater, Deflater, inflater, deflater, changeInflateSize, changeDeflateSize, inflate, deflateField, deflateStart, releaseTable }

pub unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
pub unsafe extern "C" fn realloc(ptr: ?*mut u8, size: usize) -> ?*mut u8
pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
pub unsafe extern "C" fn free(ptr: ?*mut u8) -> ()
@foreign(noCapture: .("dest", "source"))
pub unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, count: usize) -> *mut u8

// nghttp2's public structures (64-bit), as ext/http2_abi has them.
pub extern "C" struct Frame { pub length: usize, pub stream: i32, pub kind: u8, pub flags: u8, pub reserved: u8 }
pub extern "C" struct Priority { pub stream: i32, pub weight: i32, pub exclusive: u8 }
pub extern "C" struct Headers { pub hd: Frame, pub padding: usize, pub priority: Priority, pub entries: ?*mut u8, pub count: usize, pub category: i32 }
pub extern "C" struct Push { pub hd: Frame, pub padding: usize, pub entries: ?*mut u8, pub count: usize, pub promised: i32, pub reserved: u8 }
pub extern "C" struct Goaway { pub hd: Frame, pub last: i32, pub error: u32, pub data: ?*mut u8, pub length: usize, pub reserved: u8 }
pub extern "C" struct NV { pub name: ?*mut u8, pub value: ?*mut u8, pub nameLength: usize, pub valueLength: usize, pub flags: u8 }
pub extern "C" struct Setting { pub id: i32, pub value: u32 }
pub extern "C" struct Settings { pub hd: Frame, pub count: usize, pub entries: ?*mut Setting }
pub extern "C" struct Extension { pub hd: Frame, pub payload: ?*mut u8 }
pub extern "C" struct AltSvc { pub origin: ?*mut u8, pub originLength: usize, pub value: ?*mut u8, pub valueLength: usize }
pub extern "C" struct OriginEntry { pub origin: ?*mut u8, pub length: usize }
pub extern "C" struct Origin { pub count: usize, pub entries: ?*mut OriginEntry }
pub type PaddingCallback = extern "C" fn(?*mut u8, *mut Frame, usize, ?*mut u8) -> i64
pub type FrameCallback = extern "C" fn(?*mut u8, *mut Frame, ?*mut u8) -> i32
pub type HeaderCallback = extern "C" fn(?*mut u8, *mut Frame, ?*mut u8, usize, ?*mut u8, usize, u8, ?*mut u8) -> i32
pub type DataCallback = extern "C" fn(?*mut u8, u8, i32, ?*mut u8, usize, ?*mut u8) -> i32
pub type CloseCallback = extern "C" fn(?*mut u8, i32, u32, ?*mut u8) -> i32
pub type ReadCallback = extern "C" fn(?*mut u8, i32, ?*mut u8, usize, *mut u32, ?*mut u8, ?*mut u8) -> i64
pub extern "C" struct Provider { pub source: ?*mut u8, pub read: ReadCallback }
pub type AllocCallback = extern "C" fn(usize, ?*mut u8) -> ?*mut u8
pub type FreeCallback = extern "C" fn(?*mut u8, ?*mut u8) -> ()
pub type CallocCallback = extern "C" fn(usize, usize, ?*mut u8) -> ?*mut u8
pub type ReallocCallback = extern "C" fn(?*mut u8, usize, ?*mut u8) -> ?*mut u8
pub extern "C" struct Memory { pub user: ?*mut u8, pub alloc: AllocCallback, pub release: FreeCallback, pub zero: CallocCallback, pub resize: ReallocCallback }
pub type NotSentCallback = extern "C" fn(?*mut u8, *mut Frame, i32, ?*mut u8) -> i32
pub type ErrorCallback = extern "C" fn(?*mut u8, i32, ?*mut u8, usize, ?*mut u8) -> i32
impl Copy for Frame {}
impl Copy for Priority {}
impl Copy for Setting {}
impl Copy for Provider {}
impl Copy for NV {}
impl Copy for OriginEntry {}
extern "C" struct PingFrame { hd: Frame, data: [u8; 8] }
extern "C" struct PriorityFrame { hd: Frame, priority: Priority }

// Frame types and flags.
const DATA: u8 = 0
const HEADERS: u8 = 1
const PRIORITY: u8 = 2
const RST_STREAM: u8 = 3
const SETTINGS: u8 = 4
const PUSH_PROMISE: u8 = 5
const PING: u8 = 6
const GOAWAY: u8 = 7
const WINDOW_UPDATE: u8 = 8
const CONTINUATION: u8 = 9
const ALTSVC: u8 = 10
const ORIGIN: u8 = 12
const F_END_STREAM: u8 = 1
const F_ACK: u8 = 1
const F_END_HEADERS: u8 = 4
const F_PADDED: u8 = 8
const F_PRIORITY: u8 = 32
// Library errors.
const ERR_INVALID_ARGUMENT: i32 = -501
const ERR_PROTO: i32 = -505
const ERR_DEFERRED: i32 = -508
const ERR_STREAM_ID_NOT_AVAILABLE: i32 = -509
const ERR_STREAM_CLOSED: i32 = -510
const ERR_STREAM_CLOSING: i32 = -511
const ERR_STREAM_SHUT_WR: i32 = -512
const ERR_INVALID_STREAM_ID: i32 = -513
const ERR_INVALID_STREAM_STATE: i32 = -514
const ERR_START_STREAM_NOT_ALLOWED: i32 = -516
const ERR_INVALID_STATE: i32 = -519
const ERR_TEMPORAL_CALLBACK_FAILURE: i32 = -521
const ERR_FRAME_SIZE_ERROR: i32 = -522
const ERR_HEADER_COMP: i32 = -523
const ERR_FLOW_CONTROL: i32 = -524
const ERR_PAUSE: i32 = -526
const ERR_PUSH_DISABLED: i32 = -528
const ERR_DATA_EXIST: i32 = -529
const ERR_SESSION_CLOSING: i32 = -530
const ERR_HTTP_HEADER: i32 = -531
const ERR_HTTP_MESSAGING: i32 = -532
const ERR_REFUSED_STREAM: i32 = -533
const ERR_INTERNAL: i32 = -534
const ERR_CANCEL: i32 = -535
const ERR_SETTINGS_EXPECTED: i32 = -536
const ERR_FATAL: i32 = -900
const ERR_NOMEM: i32 = -901
const ERR_CALLBACK_FAILURE: i32 = -902
const ERR_BAD_CLIENT_MAGIC: i32 = -903
const ERR_FLOODED: i32 = -904
const ERR_TOO_MANY_CONTINUATIONS: i32 = -905
const ERR_IGN_HEADER_BLOCK: i32 = -103
const ERR_IGN_PAYLOAD: i32 = -104
const ERR_IGN_HTTP_HEADER: i32 = -105
const ERR_REMOVE_HTTP_HEADER: i32 = -106
// HTTP/2 error codes.
const NO_ERROR: u32 = 0
const PROTOCOL_ERROR: u32 = 1
const INTERNAL_ERROR: u32 = 2
const FLOW_CONTROL_ERROR: u32 = 3
const STREAM_CLOSED: u32 = 5
const FRAME_SIZE_ERROR: u32 = 6
const REFUSED_STREAM: u32 = 7
const CANCEL: u32 = 8
const COMPRESSION_ERROR: u32 = 9
const ENHANCE_YOUR_CALM: u32 = 11
// Stream states (nghttp2_stream_state) and flags.
const S_INITIAL: i32 = 1
const S_OPENING: i32 = 2
const S_OPENED: i32 = 3
const S_RESERVED: i32 = 4
const S_CLOSING: i32 = 6
const SF_PUSH: u8 = 1
const SF_DEFERRED_FLOW_CONTROL: u8 = 4
const SF_DEFERRED_USER: u8 = 8
const SF_DEFERRED_ALL: u8 = 12
const SHUT_RD: u8 = 1
const SHUT_WR: u8 = 2
const SHUT_RDWR: u8 = 3
// GOAWAY flags.
const G_TERM_ON_SEND: u8 = 1
const G_TERM_SENT: u8 = 2
const G_SENT: u8 = 4
const G_RECV: u8 = 8
const G_SUBMITTED: u8 = 16
const GA_TERM_ON_SEND: u8 = 1
// Header categories.
const HCAT_REQUEST: i32 = 0
const HCAT_RESPONSE: i32 = 1
const HCAT_PUSH_RESPONSE: i32 = 2
const HCAT_HEADERS: i32 = 3
// HTTP messaging flags (nghttp2_http_flag).
const H_AUTHORITY: u32 = 1
const H_PATH: u32 = 2
const H_METHOD: u32 = 4
const H_SCHEME: u32 = 8
const H_HOST: u32 = 16
const H_STATUS: u32 = 32
const H_REQ_HEADERS: u32 = 14
const H_PSEUDO_DISALLOWED: u32 = 64
const H_METH_CONNECT: u32 = 128
const H_METH_HEAD: u32 = 256
const H_METH_OPTIONS: u32 = 512
const H_METH_UPGRADE_WORKAROUND: u32 = 1024
const H_METH_ALL: u32 = 1920
const H_PATH_REGULAR: u32 = 2048
const H_PATH_ASTERISK: u32 = 4096
const H_SCHEME_HTTP: u32 = 8192
const H_EXPECT_FINAL_RESPONSE: u32 = 16384
const H_PROTOCOL: u32 = 32768
// Inbound states.
const IB_READ_CLIENT_MAGIC: i32 = 0
const IB_READ_FIRST_SETTINGS: i32 = 1
const IB_READ_HEAD: i32 = 2
const IB_READ_NBYTE: i32 = 3
const IB_READ_HEADER_BLOCK: i32 = 4
const IB_IGN_HEADER_BLOCK: i32 = 5
const IB_IGN_PAYLOAD: i32 = 6
const IB_FRAME_SIZE_ERROR: i32 = 7
const IB_READ_SETTINGS: i32 = 8
const IB_READ_GOAWAY_DEBUG: i32 = 9
const IB_EXPECT_CONTINUATION: i32 = 10
const IB_IGN_CONTINUATION: i32 = 11
const IB_READ_PAD_DATA: i32 = 12
const IB_READ_DATA: i32 = 13
const IB_IGN_DATA: i32 = 14
const IB_IGN_ALL: i32 = 15
const IB_READ_ALTSVC_PAYLOAD: i32 = 16
const IB_READ_ORIGIN_PAYLOAD: i32 = 17
// Outbound states.
const OB_POP_ITEM: i32 = 0
const OB_SEND_DATA: i32 = 1
const OB_SEND_CLIENT_MAGIC: i32 = 2
// Limits.
const MAX_WINDOW: i32 = 2147483647
const INITIAL_WINDOW: u32 = 65535
const MAX_FRAME_SIZE_MIN: u32 = 16384
const MAX_FRAME_SIZE_MAX: u32 = 16777215
const MAX_PAYLOADLEN: usize = 16384
const MAX_PADLEN: usize = 256
const MAGIC: &[u8] = b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
const VERSION: &[u8] = b"1.66.0\0"

// Callback bits.
const CB_BEGIN_HEADERS: u32 = 1
const CB_INVALID_FRAME: u32 = 2
const CB_INVALID_HEADER: u32 = 4
const CB_ERROR: u32 = 8
const CB_PADDING: u32 = 16
const CB_HEADER: u32 = 32
const CB_FRAME_RECV: u32 = 64
const CB_FRAME_SEND: u32 = 128
const CB_FRAME_NOT_SEND: u32 = 256
const CB_DATA: u32 = 512
const CB_STREAM_CLOSE: u32 = 1024

export "C" fn silkH2NoFrame(session: ?*mut u8, frame: *mut Frame, user: ?*mut u8) -> i32 { return 0 }
export "C" fn silkH2NoNotSent(session: ?*mut u8, frame: *mut Frame, code: i32, user: ?*mut u8) -> i32 { return 0 }
export "C" fn silkH2NoHeader(session: ?*mut u8, frame: *mut Frame, name: ?*mut u8, nn: usize, value: ?*mut u8, vn: usize, flags: u8, user: ?*mut u8) -> i32 { return 0 }
export "C" fn silkH2NoError(session: ?*mut u8, code: i32, message: ?*mut u8, n: usize, user: ?*mut u8) -> i32 { return 0 }
export "C" fn silkH2NoPadding(session: ?*mut u8, frame: *mut Frame, maximum: usize, user: ?*mut u8) -> i64 { return 0 }
export "C" fn silkH2NoData(session: ?*mut u8, flags: u8, id: i32, data: ?*mut u8, n: usize, user: ?*mut u8) -> i32 { return 0 }
export "C" fn silkH2NoClose(session: ?*mut u8, id: i32, code: u32, user: ?*mut u8) -> i32 { return 0 }
export "C" fn silkH2NoRead(session: ?*mut u8, id: i32, dest: ?*mut u8, n: usize, flags: *mut u32, source: ?*mut u8, user: ?*mut u8) -> i64 { return 0 }

pub struct Callbacks {
  set: u32, beginHeaders: FrameCallback, invalidFrame: NotSentCallback, invalidHeader: HeaderCallback, error: ErrorCallback,
  padding: PaddingCallback, header: HeaderCallback, frameRecv: FrameCallback, frameSend: FrameCallback, frameNotSend: NotSentCallback,
  dataChunk: DataCallback, streamClose: CloseCallback,
}
impl Copy for Callbacks {}
impl Copy for Options {}
impl Copy for LocalSettings {}
fn noCallbacks() -> Callbacks {
  return Callbacks { set: 0, beginHeaders: silkH2NoFrame, invalidFrame: silkH2NoNotSent, invalidHeader: silkH2NoHeader, error: silkH2NoError,
    padding: silkH2NoPadding, header: silkH2NoHeader, frameRecv: silkH2NoFrame, frameSend: silkH2NoFrame, frameNotSend: silkH2NoNotSent,
    dataChunk: silkH2NoData, streamClose: silkH2NoClose }
}
pub struct Options {
  noAutoWindowUpdate: bool, maxDeflate: usize, maxReserved: u32, maxSendHeaderBlock: usize, peerMaxConcurrent: u32, peerMaxSet: bool,
  maxSettings: usize, noWs: bool, resetBurst: u64, resetRate: u64, builtin: u32,
}
fn defaultOptions() -> Options {
  return Options { noAutoWindowUpdate: false, maxDeflate: 4096, maxReserved: 200, maxSendHeaderBlock: 65536, peerMaxConcurrent: 100,
    peerMaxSet: false, maxSettings: 32, noWs: false, resetBurst: 1000, resetRate: 33, builtin: 0 }
}

struct Stream {
  next: ?*mut Stream, id: i32, flags: u8, state: i32, shut: u8, remoteWindow: i32, localWindow: i32, recvWindow: i32,
  consumed: i32, recvReduction: i32, windowUpdateQueued: bool, httpFlags: u32, contentLength: i64, recvContentLength: i64,
  status: i32, item: ?*mut Item, queued: bool, seq: u64,
}
struct Item {
  next: ?*mut Item, kind: u8, flags: u8, stream: i32, category: i32, nva: Buf, count: usize, provider: Provider,
  hasProvider: bool, canceled: bool, errorCode: u32, promised: i32, last: i32, increment: i32, payload: Buf, aux: u8,
  settings: Buf, eof: bool, dataFlags: u8, origin: Buf, queued: bool, padlen: usize, length: usize,
}
struct Queue { head: ?*mut Item, tail: ?*mut Item, size: usize }
struct LocalSettings {
  headerTableSize: u32, enablePush: u32, maxConcurrentStreams: u32, initialWindowSize: u32, maxFrameSize: u32,
  maxHeaderListSize: u32, enableConnectProtocol: u32, noRfc7540Priorities: u32,
}
fn initialSettings() -> LocalSettings {
  return LocalSettings { headerTableSize: 4096, enablePush: 1, maxConcurrentStreams: 4294967295, initialWindowSize: INITIAL_WINDOW,
    maxFrameSize: MAX_FRAME_SIZE_MIN, maxHeaderListSize: 4294967295, enableConnectProtocol: 0, noRfc7540Priorities: 4294967295 }
}
struct Inflight { next: ?*mut Inflight, entries: Buf }

pub struct Session {
  me: ?*mut u8, user: ?*mut u8, server: bool, callbacks: Callbacks, options: Options,
  streams: ?*mut Stream, streamSeq: u64, numOutgoing: usize, numIncoming: usize, numIncomingReserved: usize,
  urgent: Queue, regular: Queue, syn: Queue,
  remoteWindow: i32, recvWindow: i32, consumed: i32, recvReduction: i32, localWindow: i32, windowUpdateQueued: bool,
  goawayFlags: u8, localLastStream: i32, remoteLastStream: i32, lastRecvStream: i32, lastProcStream: i32, lastSentStream: i32,
  nextStreamId: u32, pendingMaxConcurrent: u32, pendingEnablePush: bool, pendingConnectProtocol: bool, pendingNoRfc7540: u8,
  remote: LocalSettings, local: LocalSettings, remoteSettingsReceived: bool, inflight: ?*mut Inflight,
  floodCounter: usize, maxOutboundAck: usize, numContinuations: usize, maxContinuations: usize,
  resetTokens: u64, resetStamp: u64,
  hdInflate: Inflater, hdDeflate: Deflater,
  // The outbound item being sent, its serialized frames and where each ends.
  obState: i32, aob: ?*mut Item, frameBuf: Buf, chunkEnds: Buf, chunkIndex: usize, magicSent: bool,
  // The inbound frame.
  ib: i32, hdLength: usize, hdStream: i32, hdKind: u8, hdFlags: u8, payloadLeft: usize, padlen: usize,
  sbuf: [u8; 32], sbufLength: usize, sbufMark: usize, lbuf: Buf, block: Buf, decoded: Buf, iv: Buf, niv: usize, maxNiv: usize,
  category: i32, promised: i32, headerStream: i32, minHeaderTable: u32,
}

// Access.
unsafe fn ses<'a>(anchor: &'a mut (), sp: *mut Session) -> &'a mut Session { return unsafe Pointer.borrowMut<(), Session>(move anchor, sp) }
unsafe fn str<'a>(anchor: &'a mut (), p: *mut Stream) -> &'a mut Stream { return unsafe Pointer.borrowMut<(), Stream>(move anchor, p) }
unsafe fn itm<'a>(anchor: &'a mut (), p: *mut Item) -> &'a mut Item { return unsafe Pointer.borrowMut<(), Item>(move anchor, p) }
unsafe fn sessionOf(p: ?*mut u8) -> *mut Session { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Session>(unsafe nonnull(p)) }
fn nullStream() -> ?*mut Stream { return Pointer.null<Stream>() }
fn nullItem() -> ?*mut Item { return Pointer.null<Item>() }
fn isFatal(code: i32) -> bool { return code < ERR_FATAL }
fn isNonFatal(code: i32) -> bool { return code < 0 && code > ERR_FATAL }
fn minI32(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }
fn maxI32(a: i32, b: i32) -> i32 { return if a > b { a } else { b } }

unsafe fn isMyStream(sp: *mut Session, id: i32) -> bool {
  if id == 0 { return false }
  let mut a = () let s = unsafe ses(&mut a, sp)
  let odd = i32.bitAnd(id, 1) == 1
  return if s.server { !odd } else { odd }
}
unsafe fn findStream(sp: *mut Session, id: i32) -> ?*mut Stream {
  let mut a = () let s = unsafe ses(&mut a, sp) let mut p = s.streams drop s
  while !Pointer.isNull<Stream>(p) {
    let mut b = () let t = unsafe str(&mut b, unsafe nonnull(p))
    if t.id == id { return p }
    p = t.next
  }
  return nullStream()
}
unsafe fn streamField<T: Copy>(p: ?*mut Stream, read: fn(&Stream) -> T) -> T { let mut b = () let t = unsafe str(&mut b, unsafe nonnull(p)) return read(&t.*) }
unsafe fn stateOf(p: *mut Stream) -> i32 { let mut b = () let t = unsafe str(&mut b, p) return t.state }
unsafe fn shutOf(p: *mut Stream) -> u8 { let mut b = () let t = unsafe str(&mut b, p) return t.shut }
unsafe fn idOf(p: *mut Stream) -> i32 { let mut b = () let t = unsafe str(&mut b, p) return t.id }
unsafe fn shutdown(p: *mut Stream, flag: u8) -> () { let mut b = () let t = unsafe str(&mut b, p) t.shut = u8.bitOr(t.shut, flag) }
unsafe fn goawayFlags(sp: *mut Session) -> u8 { let mut a = () let s = unsafe ses(&mut a, sp) return s.goawayFlags }
unsafe fn isServer(sp: *mut Session) -> bool { let mut a = () let s = unsafe ses(&mut a, sp) return s.server }
unsafe fn noAutoWindow(sp: *mut Session) -> bool { let mut a = () let s = unsafe ses(&mut a, sp) return s.options.noAutoWindowUpdate }

// Items.
unsafe fn newItem(kind: u8, stream: i32) -> ?*mut Item {
  let p = unsafe calloc(1, Layout.of<Item>().bytes)
  if Pointer.isNull<u8>(p) { return nullItem() }
  let item = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Item>(unsafe nonnull(p))
  unsafe Pointer.put<Item>(item, Item { next: nullItem(), kind: kind, flags: 0, stream: stream, category: HCAT_HEADERS, nva: emptyBuf(), count: 0,
    provider: Provider { source: nil(), read: silkH2NoRead }, hasProvider: false, canceled: false, errorCode: 0, promised: 0, last: 0,
    increment: 0, payload: emptyBuf(), aux: 0, settings: emptyBuf(), eof: false, dataFlags: 0, origin: emptyBuf(), queued: false, padlen: 0, length: 0 })
  return unsafe Intrinsic.pointerRequalify<*mut Item, ?*mut Item>(item)
}
unsafe fn freeItem(p: ?*mut Item) -> () {
  if Pointer.isNull<Item>(p) { return () }
  let mut item = unsafe Pointer.take<Item>(unsafe nonnull(p))
  unsafe item.nva.release() unsafe item.payload.release() unsafe item.settings.release() unsafe item.origin.release()
  unsafe free(unsafe Intrinsic.pointerReinterpret<?*mut Item, ?*mut u8>(p))
}
fn queuePush(q: &mut Queue, p: *mut Item) -> () {
  let mut b = () let item = unsafe itm(&mut b, p) item.next = nullItem() drop item
  let pointer = unsafe Intrinsic.pointerRequalify<*mut Item, ?*mut Item>(p)
  if Pointer.isNull<Item>(q.tail) { q.head = pointer } else { let mut c = () let last = unsafe itm(&mut c, unsafe nonnull(q.tail)) last.next = pointer }
  q.tail = pointer
  q.size = q.size + 1
}
fn queuePop(q: &mut Queue) -> ?*mut Item {
  let p = q.head
  if Pointer.isNull<Item>(p) { return p }
  let mut b = () let item = unsafe itm(&mut b, unsafe nonnull(p))
  q.head = item.next item.next = nullItem()
  if Pointer.isNull<Item>(q.head) { q.tail = nullItem() }
  q.size = q.size - 1
  return p
}
unsafe fn freeQueue(q: &mut Queue) -> () { while !Pointer.isNull<Item>(q.head) { let p = queuePop(&mut q.*) unsafe freeItem(p) } }

// Streams.
unsafe fn openStream(sp: *mut Session, id: i32, initial: i32) -> ?*mut Stream {
  let p = unsafe calloc(1, Layout.of<Stream>().bytes)
  if Pointer.isNull<u8>(p) { return nullStream() }
  let stream = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Stream>(unsafe nonnull(p))
  let mine = unsafe isMyStream(sp, id)
  let mut a = () let s = unsafe ses(&mut a, sp)
  let flags: u8 = if initial == S_RESERVED { SF_PUSH } else { 0 }
  unsafe Pointer.put<Stream>(stream, Stream { next: s.streams, id: id, flags: flags, state: initial, shut: 0,
    remoteWindow: u32.wrappingToI32(s.remote.initialWindowSize), localWindow: u32.wrappingToI32(s.local.initialWindowSize), recvWindow: 0,
    consumed: 0, recvReduction: 0, windowUpdateQueued: false, httpFlags: 0, contentLength: -1, recvContentLength: 0, status: -1,
    item: nullItem(), queued: false, seq: s.streamSeq })
  s.streamSeq = s.streamSeq + 1
  s.streams = unsafe Intrinsic.pointerRequalify<*mut Stream, ?*mut Stream>(stream)
  if initial == S_RESERVED {
    if mine { unsafe shutdown(stream, SHUT_RD) } else { unsafe shutdown(stream, SHUT_WR) s.numIncomingReserved = s.numIncomingReserved + 1 }
  } else {
    if mine { s.numOutgoing = s.numOutgoing + 1 } else { s.numIncoming = s.numIncoming + 1 }
  }
  return unsafe Intrinsic.pointerRequalify<*mut Stream, ?*mut Stream>(stream)
}
unsafe fn unlinkStream(sp: *mut Session, p: *mut Stream) -> () {
  let mut a = () let s = unsafe ses(&mut a, sp)
  let target = unsafe Intrinsic.pointerRequalify<*mut Stream, ?*mut Stream>(p)
  let mut b = () let t = unsafe str(&mut b, p) let after = t.next drop t
  if Pointer.address<Stream>(unsafe Intrinsic.pointerRequalify<?*mut Stream, ?*const Stream>(s.streams)) == Pointer.address<Stream>(unsafe Intrinsic.pointerRequalify<?*mut Stream, ?*const Stream>(target)) { s.streams = after return () }
  let mut cursor = s.streams drop s
  while !Pointer.isNull<Stream>(cursor) {
    let mut c = () let t2 = unsafe str(&mut c, unsafe nonnull(cursor))
    if Pointer.address<Stream>(unsafe Intrinsic.pointerRequalify<?*mut Stream, ?*const Stream>(t2.next)) == Pointer.address<Stream>(unsafe Intrinsic.pointerRequalify<?*mut Stream, ?*const Stream>(target)) { t2.next = after return () }
    cursor = t2.next
  }
}
unsafe fn detachItem(p: *mut Stream) -> () {
  let mut b = () let t = unsafe str(&mut b, p)
  t.item = nullItem() t.flags = u8.bitAnd(t.flags, u8.bitNot(SF_DEFERRED_ALL)) t.queued = false
}
unsafe fn deferItem(p: *mut Stream, flags: u8) -> () {
  let mut b = () let t = unsafe str(&mut b, p) t.flags = u8.bitOr(t.flags, flags) t.queued = false
}
unsafe fn resumeDeferred(p: *mut Stream, flags: u8) -> () {
  let mut b = () let t = unsafe str(&mut b, p)
  t.flags = u8.bitAnd(t.flags, u8.bitNot(flags))
  if u8.bitAnd(t.flags, SF_DEFERRED_ALL) != 0 { return () }
  t.queued = true
}
unsafe fn checkDeferred(p: *mut Stream) -> bool { let mut b = () let t = unsafe str(&mut b, p) return !Pointer.isNull<Item>(t.item) && u8.bitAnd(t.flags, SF_DEFERRED_ALL) != 0 }
unsafe fn deferredByFlowControl(p: *mut Stream) -> bool { let mut b = () let t = unsafe str(&mut b, p) return !Pointer.isNull<Item>(t.item) && u8.bitAnd(t.flags, SF_DEFERRED_FLOW_CONTROL) != 0 }

unsafe fn closeStream(sp: *mut Session, id: i32, code: u32) -> i32 {
  let found = unsafe findStream(sp, id)
  if Pointer.isNull<Stream>(found) { return ERR_INVALID_ARGUMENT }
  let p = unsafe nonnull(found)
  let mut a = () let s = unsafe ses(&mut a, sp)
  let set = u32.bitAnd(s.callbacks.set, CB_STREAM_CLOSE) != 0 let callback = s.callbacks.streamClose let me = s.me let user = s.user let aob = s.aob drop s
  if set && unsafe callback(me, id, code, user) != 0 { return ERR_CALLBACK_FAILURE }
  let mut b = () let t = unsafe str(&mut b, p) let item = t.item let flags = t.flags drop t
  if !Pointer.isNull<Item>(item) {
    unsafe detachItem(p)
    let mut c = () let it = unsafe itm(&mut c, unsafe nonnull(item)) let queued = it.queued drop it
    if !queued && Pointer.address<Item>(unsafe Intrinsic.pointerRequalify<?*mut Item, ?*const Item>(item)) != Pointer.address<Item>(unsafe Intrinsic.pointerRequalify<?*mut Item, ?*const Item>(aob)) { unsafe freeItem(item) }
  }
  let mine = unsafe isMyStream(sp, id)
  let s2 = unsafe ses(&mut a, sp)
  if u8.bitAnd(flags, SF_PUSH) != 0 { if !mine { s2.numIncomingReserved = s2.numIncomingReserved - 1 } }
  else { if mine { s2.numOutgoing = s2.numOutgoing - 1 } else { s2.numIncoming = s2.numIncoming - 1 } }
  drop s2
  unsafe unlinkStream(sp, p)
  unsafe free(unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut Stream, *mut u8>(p)))
  return 0
}
unsafe fn closeIfShutRdwr(sp: *mut Session, p: *mut Stream) -> i32 {
  if u8.bitAnd(unsafe shutOf(p), SHUT_RDWR) == SHUT_RDWR { return unsafe closeStream(sp, unsafe idOf(p), NO_ERROR) }
  return 0
}
unsafe fn activeStreams(sp: *mut Session) -> usize {
  let mut a = () let s = unsafe ses(&mut a, sp) let mut p = s.streams drop s let mut n: usize = 0
  while !Pointer.isNull<Stream>(p) { n = n + 1 let mut b = () let t = unsafe str(&mut b, unsafe nonnull(p)) p = t.next }
  return n
}
unsafe fn schedEmpty(sp: *mut Session) -> bool {
  let mut a = () let s = unsafe ses(&mut a, sp) let mut p = s.streams drop s
  while !Pointer.isNull<Stream>(p) { let mut b = () let t = unsafe str(&mut b, unsafe nonnull(p)) if t.queued { return false } p = t.next }
  return true
}
// The queued stream created first.
unsafe fn schedNext(sp: *mut Session) -> ?*mut Stream {
  let mut a = () let s = unsafe ses(&mut a, sp) let mut p = s.streams drop s
  let mut best = nullStream() let mut seq: u64 = u64.MAX
  while !Pointer.isNull<Stream>(p) {
    let mut b = () let t = unsafe str(&mut b, unsafe nonnull(p))
    if t.queued && t.seq < seq { best = p seq = t.seq }
    p = t.next
  }
  return best
}

pub unsafe fn nghttp2_session_want_read(session: ?*mut u8) -> i32 {
  let sp = unsafe sessionOf(session)
  let flags = unsafe goawayFlags(sp)
  if u8.bitAnd(flags, G_TERM_SENT) != 0 { return 0 }
  if unsafe activeStreams(sp) > 0 { return 1 }
  return if u8.bitAnd(flags, u8.bitOr(G_SENT, G_RECV)) == 0 { 1 } else { 0 }
}
unsafe fn outgoingMax(sp: *mut Session) -> bool { let mut a = () let s = unsafe ses(&mut a, sp) return u32.toUsize(s.remote.maxConcurrentStreams) <= s.numOutgoing }
pub unsafe fn nghttp2_session_want_write(session: ?*mut u8) -> i32 {
  let sp = unsafe sessionOf(session)
  let mut a = () let s = unsafe ses(&mut a, sp)
  if u8.bitAnd(s.goawayFlags, G_TERM_SENT) != 0 { return 0 }
  let busy = !Pointer.isNull<Item>(s.aob) || !Pointer.isNull<Item>(s.urgent.head) || !Pointer.isNull<Item>(s.regular.head)
  let window = s.remoteWindow > 0 let syn = !Pointer.isNull<Item>(s.syn.head) drop s
  if busy { return 1 }
  if window && !unsafe schedEmpty(sp) { return 1 }
  if syn && !unsafe outgoingMax(sp) { return 1 }
  return 0
}
unsafe fn isClosing(sp: *mut Session) -> bool {
  if u8.bitAnd(unsafe goawayFlags(sp), G_TERM_ON_SEND) != 0 { return true }
  let me = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut Session, *mut u8>(sp))
  return unsafe nghttp2_session_want_read(me) == 0 && unsafe nghttp2_session_want_write(me) == 0
}

// Adding outbound items.
unsafe fn addItem(sp: *mut Session, p: *mut Item) -> i32 {
  let mut b = () let item = unsafe itm(&mut b, p) let kind = item.kind let id = item.stream let category = item.category drop item
  let found = unsafe findStream(sp, id)
  let mut a = ()
  if kind == DATA {
    if Pointer.isNull<Stream>(found) { return ERR_STREAM_CLOSED }
    let mut c = () let t = unsafe str(&mut c, unsafe nonnull(found))
    if !Pointer.isNull<Item>(t.item) { return ERR_DATA_EXIST }
    t.item = unsafe Intrinsic.pointerRequalify<*mut Item, ?*mut Item>(p) t.queued = true
    return 0
  }
  let s = unsafe ses(&mut a, sp)
  if kind == HEADERS {
    let reserved = !Pointer.isNull<Stream>(found) && unsafe stateOf(unsafe nonnull(found)) == S_RESERVED
    if category == HCAT_REQUEST || reserved { queuePush(&mut s.syn, p) } else { queuePush(&mut s.regular, p) }
  } else if kind == SETTINGS || kind == PING {
    queuePush(&mut s.urgent, p)
  } else if kind == RST_STREAM {
    if !Pointer.isNull<Stream>(found) { let mut c = () let t = unsafe str(&mut c, unsafe nonnull(found)) t.state = S_CLOSING }
    queuePush(&mut s.regular, p)
  } else if kind == PUSH_PROMISE {
    drop s
    if Pointer.isNull<Stream>(found) { return ERR_STREAM_CLOSED }
    let mut c = () let item2 = unsafe itm(&mut c, p) let promised = item2.promised drop item2
    if Pointer.isNull<Stream>(unsafe openStream(sp, promised, S_RESERVED)) { return ERR_NOMEM }
    let s2 = unsafe ses(&mut a, sp) queuePush(&mut s2.regular, p)
  } else if kind == WINDOW_UPDATE {
    if !Pointer.isNull<Stream>(found) { let mut c = () let t = unsafe str(&mut c, unsafe nonnull(found)) t.windowUpdateQueued = true }
    else if id == 0 { s.windowUpdateQueued = true }
    queuePush(&mut s.regular, p)
  } else {
    queuePush(&mut s.regular, p)
  }
  let mut d = () let item3 = unsafe itm(&mut d, p) item3.queued = true
  return 0
}
unsafe fn addRst(sp: *mut Session, id: i32, code: u32, withoutStream: bool) -> i32 {
  let found = unsafe findStream(sp, id)
  if !Pointer.isNull<Stream>(found) && unsafe stateOf(unsafe nonnull(found)) == S_CLOSING { return 0 }
  let mine = unsafe isMyStream(sp, id)
  let mut a = () let s = unsafe ses(&mut a, sp)
  if mine { if i32.wrappingToU32(id) >= s.nextStreamId { return 0 } } else if s.lastRecvStream < id { return 0 }
  // A request not sent yet is canceled instead.
  if !s.server && mine && !Pointer.isNull<Item>(s.syn.head) {
    let mut cursor = s.syn.head drop s
    let mut first = true
    while !Pointer.isNull<Item>(cursor) {
      let mut b = () let item = unsafe itm(&mut b, unsafe nonnull(cursor))
      if first && item.stream > id { break }
      first = false
      if item.stream < id { cursor = item.next continue }
      if item.stream > id || item.canceled { break }
      item.errorCode = code item.canceled = true
      return 0
    }
  } else { drop s }
  if !withoutStream && Pointer.isNull<Stream>(found) { return 0 }
  let p = unsafe newItem(RST_STREAM, id)
  if Pointer.isNull<Item>(p) { return ERR_NOMEM }
  let mut b2 = () let item2 = unsafe itm(&mut b2, unsafe nonnull(p)) item2.errorCode = code drop item2
  return unsafe addItem(sp, unsafe nonnull(p))
}
unsafe fn addPing(sp: *mut Session, flags: u8, data: ?*const u8) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp)
  if u8.bitAnd(flags, F_ACK) != 0 && s.floodCounter >= s.maxOutboundAck { return ERR_FLOODED }
  drop s
  let p = unsafe newItem(PING, 0)
  if Pointer.isNull<Item>(p) { return ERR_NOMEM }
  let mut b = () let item = unsafe itm(&mut b, unsafe nonnull(p)) item.flags = flags
  let ok = if Pointer.isNull<u8>(unsafe Intrinsic.pointerRequalify<?*const u8, ?*mut u8>(data)) { unsafe item.payload.append(textPointer(b"\0\0\0\0\0\0\0\0"), 8) } else { unsafe item.payload.append(data, 8) }
  drop item
  if !ok { unsafe freeItem(p) return ERR_NOMEM }
  let rv = unsafe addItem(sp, unsafe nonnull(p))
  if rv != 0 { unsafe freeItem(p) return rv }
  if u8.bitAnd(flags, F_ACK) != 0 { let s2 = unsafe ses(&mut a, sp) s2.floodCounter = s2.floodCounter + 1 }
  return 0
}
unsafe fn addGoaway(sp: *mut Session, last: i32, code: u32, data: ?*const u8, length: usize, aux: u8) -> i32 {
  if unsafe isMyStream(sp, last) { return ERR_INVALID_ARGUMENT }
  if length > 0 && length + 8 > MAX_PAYLOADLEN { return ERR_INVALID_ARGUMENT }
  let p = unsafe newItem(GOAWAY, 0)
  if Pointer.isNull<Item>(p) { return ERR_NOMEM }
  let mut a = () let s = unsafe ses(&mut a, sp) let local = s.localLastStream drop s
  let mut b = () let item = unsafe itm(&mut b, unsafe nonnull(p))
  item.last = minI32(last, local) item.errorCode = code item.aux = aux
  let ok = unsafe item.payload.append(data, length) drop item
  if !ok { unsafe freeItem(p) return ERR_NOMEM }
  let rv = unsafe addItem(sp, unsafe nonnull(p))
  if rv != 0 { unsafe freeItem(p) return rv }
  let s2 = unsafe ses(&mut a, sp) s2.goawayFlags = u8.bitOr(s2.goawayFlags, G_SUBMITTED)
  return 0
}
unsafe fn addWindowUpdate(sp: *mut Session, id: i32, increment: i32) -> i32 {
  let p = unsafe newItem(WINDOW_UPDATE, id)
  if Pointer.isNull<Item>(p) { return ERR_NOMEM }
  let mut b = () let item = unsafe itm(&mut b, unsafe nonnull(p)) item.increment = increment drop item
  let rv = unsafe addItem(sp, unsafe nonnull(p))
  if rv != 0 { unsafe freeItem(p) }
  return rv
}
fn settingsValid(id: i32, value: u32) -> bool {
  if id == 2 || id == 8 || id == 9 { return value == 0 || value == 1 }
  if id == 4 { return value <= 2147483647 }
  if id == 5 { return value >= MAX_FRAME_SIZE_MIN && value <= MAX_FRAME_SIZE_MAX }
  return true
}
unsafe fn settingAt(entries: ?*const u8, i: usize) -> Setting {
  return unsafe Pointer.read<Setting>(unsafe Intrinsic.pointerReinterpret<*const u8, *const Setting>(unsafe atConst(entries, i * 8)))
}
unsafe fn addSettings(sp: *mut Session, flags: u8, entries: ?*const u8, count: usize) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp)
  if u8.bitAnd(flags, F_ACK) != 0 {
    if count != 0 { return ERR_INVALID_ARGUMENT }
    if s.floodCounter >= s.maxOutboundAck { return ERR_FLOODED }
  }
  let mut noPri = s.pendingNoRfc7540 drop s
  let mut i: usize = 0
  while i < count {
    let e = unsafe settingAt(entries, i)
    if !settingsValid(e.id, e.value) { return ERR_INVALID_ARGUMENT }
    if e.id == 9 { if noPri == 255 { noPri = u32.wrappingToU8(e.value) } else if e.value != u8.toU32(noPri) { return ERR_INVALID_ARGUMENT } }
    i = i + 1
  }
  let p = unsafe newItem(SETTINGS, 0)
  if Pointer.isNull<Item>(p) { return ERR_NOMEM }
  let mut b = () let item = unsafe itm(&mut b, unsafe nonnull(p)) item.flags = flags
  let ok = unsafe item.settings.append(entries, count * 8) drop item
  if !ok { unsafe freeItem(p) return ERR_NOMEM }
  let mut inflight = Pointer.null<Inflight>()
  if u8.bitAnd(flags, F_ACK) == 0 {
    let raw = unsafe calloc(1, Layout.of<Inflight>().bytes)
    if Pointer.isNull<u8>(raw) { unsafe freeItem(p) return ERR_NOMEM }
    let f = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Inflight>(unsafe nonnull(raw))
    let mut copied = emptyBuf()
    if !unsafe copied.append(entries, count * 8) { unsafe free(raw) unsafe freeItem(p) return ERR_NOMEM }
    unsafe Pointer.put<Inflight>(f, Inflight { next: Pointer.null<Inflight>(), entries: move copied })
    inflight = unsafe Intrinsic.pointerRequalify<*mut Inflight, ?*mut Inflight>(f)
  }
  let rv = unsafe addItem(sp, unsafe nonnull(p))
  if rv != 0 { unsafe freeItem(p) return rv }
  let s2 = unsafe ses(&mut a, sp)
  if u8.bitAnd(flags, F_ACK) != 0 { s2.floodCounter = s2.floodCounter + 1 }
  else {
    if Pointer.isNull<Inflight>(s2.inflight) { s2.inflight = inflight }
    else {
      let mut cursor = unsafe nonnull(s2.inflight)
      while true {
        let mut c = () let f2 = unsafe Pointer.borrowMut<(), Inflight>(&mut c, cursor)
        if Pointer.isNull<Inflight>(f2.next) { f2.next = inflight break }
        cursor = unsafe nonnull(f2.next)
      }
    }
  }
  let mut j = count
  while j > 0 { let e = unsafe settingAt(entries, j - 1) if e.id == 3 { s2.pendingMaxConcurrent = e.value break } j = j - 1 }
  j = count
  while j > 0 { let e = unsafe settingAt(entries, j - 1) if e.id == 2 { s2.pendingEnablePush = e.value != 0 break } j = j - 1 }
  j = count
  while j > 0 { let e = unsafe settingAt(entries, j - 1) if e.id == 8 { s2.pendingConnectProtocol = e.value != 0 break } j = j - 1 }
  s2.pendingNoRfc7540 = if noPri == 255 { 0 } else { noPri }
  return 0
}
unsafe fn terminate(sp: *mut Session, last: i32, code: u32, reason: &[u8]) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp)
  if u8.bitAnd(s.goawayFlags, G_TERM_ON_SEND) != 0 { return 0 }
  s.ib = IB_IGN_ALL drop s
  let rv = unsafe addGoaway(sp, last, code, textPointer(reason), reason.length, GA_TERM_ON_SEND)
  if rv != 0 { return rv }
  let s2 = unsafe ses(&mut a, sp) s2.goawayFlags = u8.bitOr(s2.goawayFlags, G_TERM_ON_SEND)
  return 0
}
unsafe fn terminateSession(sp: *mut Session, code: u32, reason: &[u8]) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let last = s.lastProcStream drop s
  return unsafe terminate(sp, last, code, reason)
}

// Callbacks.
unsafe fn frameHeader(length: usize, stream: i32, kind: u8, flags: u8) -> Frame { return Frame { length: length, stream: stream, kind: kind, flags: flags, reserved: 0 } }
unsafe fn callFrame(sp: *mut Session, bit: u32, frame: *mut Frame) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp)
  if u32.bitAnd(s.callbacks.set, bit) == 0 { return 0 }
  let callback = if bit == CB_FRAME_RECV { s.callbacks.frameRecv } else if bit == CB_FRAME_SEND { s.callbacks.frameSend } else { s.callbacks.beginHeaders }
  let me = s.me let user = s.user drop s
  return unsafe callback(me, frame, user)
}
unsafe fn callNotSent(sp: *mut Session, bit: u32, frame: *mut Frame, code: i32) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp)
  if u32.bitAnd(s.callbacks.set, bit) == 0 { return 0 }
  let callback = if bit == CB_INVALID_FRAME { s.callbacks.invalidFrame } else { s.callbacks.frameNotSend }
  let me = s.me let user = s.user drop s
  return unsafe callback(me, frame, code, user)
}
unsafe fn callError(sp: *mut Session, code: i32, message: &[u8]) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp)
  if u32.bitAnd(s.callbacks.set, CB_ERROR) == 0 { return 0 }
  let callback = s.callbacks.error let me = s.me let user = s.user drop s
  let text = unsafe Intrinsic.pointerRequalify<?*const u8, ?*mut u8>(textPointer(message))
  if unsafe callback(me, code, text, message.length, user) != 0 { return ERR_CALLBACK_FAILURE }
  return 0
}
unsafe fn frameReceived(sp: *mut Session, frame: *mut Frame) -> i32 {
  if unsafe callFrame(sp, CB_FRAME_RECV, frame) != 0 { return ERR_CALLBACK_FAILURE }
  return 0
}
unsafe fn invalidFrame(sp: *mut Session, frame: *mut Frame, code: i32) -> i32 {
  if unsafe callNotSent(sp, CB_INVALID_FRAME, frame, code) != 0 { return ERR_CALLBACK_FAILURE }
  return 0
}
fn errorCodeOf(code: i32) -> u32 {
  if code == ERR_STREAM_CLOSED { return STREAM_CLOSED }
  if code == ERR_HEADER_COMP { return COMPRESSION_ERROR }
  if code == ERR_FRAME_SIZE_ERROR { return FRAME_SIZE_ERROR }
  if code == ERR_FLOW_CONTROL { return FLOW_CONTROL_ERROR }
  if code == ERR_REFUSED_STREAM { return REFUSED_STREAM }
  if code == ERR_PROTO || code == ERR_HTTP_HEADER || code == ERR_HTTP_MESSAGING { return PROTOCOL_ERROR }
  return INTERNAL_ERROR
}
unsafe fn invalidStream(sp: *mut Session, id: i32, frame: *mut Frame, code: i32) -> i32 {
  let rv = unsafe addRst(sp, id, errorCodeOf(code), true)
  if rv != 0 { return rv }
  return unsafe invalidFrame(sp, frame, code)
}
unsafe fn invalidConnection(sp: *mut Session, frame: *mut Frame, code: i32, reason: &[u8]) -> i32 {
  if unsafe invalidFrame(sp, frame, code) != 0 { return ERR_CALLBACK_FAILURE }
  return unsafe terminateSession(sp, errorCodeOf(code), reason)
}
unsafe fn inflateInvalidConnection(sp: *mut Session, frame: *mut Frame, code: i32, reason: &[u8]) -> i32 {
  let rv = unsafe invalidConnection(sp, frame, code, reason)
  if isFatal(rv) { return rv }
  return ERR_IGN_HEADER_BLOCK
}
unsafe fn inflateInvalidStream(sp: *mut Session, id: i32, frame: *mut Frame, code: i32) -> i32 {
  let rv = unsafe invalidStream(sp, id, frame, code)
  if isFatal(rv) { return rv }
  return ERR_IGN_HEADER_BLOCK
}

// Flow control.
unsafe fn shouldSendWindowUpdate(local: i32, recv: i32) -> bool { return recv > 0 && recv >= local / 2 }
unsafe fn updateConsumed(sp: *mut Session, stream: ?*mut Stream, delta: usize) -> i32 {
  let mut a = ()
  let mut consumed: i32 = 0 let mut recv: i32 = 0 let mut queued = false let mut local: i32 = 0 let mut id: i32 = 0
  if Pointer.isNull<Stream>(stream) {
    let s = unsafe ses(&mut a, sp) consumed = s.consumed recv = s.recvWindow queued = s.windowUpdateQueued local = s.localWindow
  } else {
    let t = unsafe str(&mut a, unsafe nonnull(stream)) consumed = t.consumed recv = t.recvWindow queued = t.windowUpdateQueued local = t.localWindow id = t.id
  }
  if i32.toUsize(maxI32(consumed, 0)) > i32.toUsize(MAX_WINDOW) - delta { return unsafe terminateSession(sp, FLOW_CONTROL_ERROR, b"") }
  consumed = consumed + usize.toI32(delta)
  if !queued {
    let size = minI32(consumed, recv)
    if unsafe shouldSendWindowUpdate(local, size) {
      let rv = unsafe addWindowUpdate(sp, id, size)
      if rv != 0 { return rv }
      recv = recv - size consumed = consumed - size
    }
  }
  if Pointer.isNull<Stream>(stream) { let s2 = unsafe ses(&mut a, sp) s2.consumed = consumed s2.recvWindow = recv }
  else { let t2 = unsafe str(&mut a, unsafe nonnull(stream)) t2.consumed = consumed t2.recvWindow = recv }
  return 0
}
unsafe fn adjustRecvWindow(recv: &mut i32, delta: usize, local: i32) -> bool {
  let d = usize.toI32(delta)
  if recv.* > local - d || recv.* > MAX_WINDOW - d { return false }
  recv.* = recv.* + d
  return true
}
unsafe fn updateRecvStreamWindow(sp: *mut Session, p: *mut Stream, delta: usize, sendUpdate: bool) -> i32 {
  let mut b = () let t = unsafe str(&mut b, p)
  let mut recv = t.recvWindow let local = t.localWindow let id = t.id let queued = t.windowUpdateQueued drop t
  if !unsafe adjustRecvWindow(&mut recv, delta, local) { return unsafe addRst(sp, id, FLOW_CONTROL_ERROR, true) }
  let t2 = unsafe str(&mut b, p) t2.recvWindow = recv drop t2
  if sendUpdate && !unsafe noAutoWindow(sp) && !queued && unsafe shouldSendWindowUpdate(local, recv) {
    let rv = unsafe addWindowUpdate(sp, id, recv)
    if rv != 0 { return rv }
    let t3 = unsafe str(&mut b, p) t3.recvWindow = 0
  }
  return 0
}
unsafe fn updateRecvConnectionWindow(sp: *mut Session, delta: usize) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp)
  let mut recv = s.recvWindow let local = s.localWindow let queued = s.windowUpdateQueued let auto = !s.options.noAutoWindowUpdate drop s
  if !unsafe adjustRecvWindow(&mut recv, delta, local) { return unsafe terminateSession(sp, FLOW_CONTROL_ERROR, b"") }
  let s2 = unsafe ses(&mut a, sp) s2.recvWindow = recv drop s2
  if auto && !queued && unsafe shouldSendWindowUpdate(local, recv) {
    let rv = unsafe addWindowUpdate(sp, 0, recv)
    if rv != 0 { return rv }
    let s3 = unsafe ses(&mut a, sp) s3.recvWindow = 0
  }
  return 0
}
unsafe fn consumeInternal(sp: *mut Session, id: i32, size: usize) -> i32 {
  if id == 0 { return ERR_INVALID_ARGUMENT }
  if !unsafe noAutoWindow(sp) { return ERR_INVALID_STATE }
  let rv = unsafe updateConsumed(sp, nullStream(), size)
  if isFatal(rv) { return rv }
  let stream = unsafe findStream(sp, id)
  if Pointer.isNull<Stream>(stream) { return 0 }
  let rv2 = unsafe updateConsumed(sp, stream, size)
  if isFatal(rv2) { return rv2 }
  return 0
}

// HTTP messaging (http.c).
fn inRanges(c: u8, table: u32) -> bool {
  // 0: header name, 1: header value, 2: method, 3: path, 4: authority (http.c).
  let x = u8.toU32(c)
  if table == 0 { return x == 33 || x >= 35 && x <= 39 || x == 42 || x == 43 || x == 45 || x == 46 || x >= 48 && x <= 57 || x >= 94 && x <= 122 || x == 124 || x == 126 }
  if table == 1 { return x == 9 || x >= 32 && x <= 126 || x >= 128 }
  if table == 2 { return x == 33 || x >= 35 && x <= 39 || x == 42 || x == 43 || x == 45 || x == 46 || x >= 48 && x <= 57 || x >= 65 && x <= 90 || x >= 94 && x <= 122 || x == 124 || x == 126 }
  if table == 3 { return x >= 33 && x <= 126 || x >= 128 }
  return x == 33 || x >= 36 && x <= 46 || x >= 48 && x <= 59 || x == 61 || x >= 65 && x <= 91 || x == 93 || x == 95 || x >= 97 && x <= 122 || x == 126
}
fn allIn(p: ?*const u8, n: usize, table: u32) -> bool {
  let mut i: usize = 0
  while i < n { if !inRanges(unsafe byte(p, i), table) { return false } i = i + 1 }
  return true
}
fn checkName(p: ?*const u8, n: usize) -> bool {
  if n == 0 { return false }
  if unsafe byte(p, 0) == 58 {
    if n == 1 { return false }
    let mut i: usize = 1
    while i < n { if !inRanges(unsafe byte(p, i), 0) { return false } i = i + 1 }
    return true
  }
  return allIn(p, n, 0)
}
fn checkValue9113(p: ?*const u8, n: usize) -> bool {
  if n == 0 { return true }
  let first = unsafe byte(p, 0) let last = unsafe byte(p, n - 1)
  if first == 32 || first == 9 || last == 32 || last == 9 { return false }
  return allIn(p, n, 1)
}
fn checkScheme(p: ?*const u8, n: usize) -> bool {
  if n == 0 { return false }
  let first = unsafe byte(p, 0)
  if !(first >= 65 && first <= 90 || first >= 97 && first <= 122) { return false }
  let mut i: usize = 1
  while i < n {
    let c = unsafe byte(p, i)
    if !(c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 43 || c == 45 || c == 46) { return false }
    i = i + 1
  }
  return true
}
fn lowerEquals(p: ?*const u8, n: usize, text: &[u8]) -> bool {
  if n != text.length { return false }
  let mut i: usize = 0
  while i < n { let c = unsafe byte(p, i) let lower = if c >= 65 && c <= 90 { c + 32 } else { c } if lower != text[i] { return false } i = i + 1 }
  return true
}
fn parseUint(p: ?*const u8, n: usize) -> i64 {
  if n == 0 { return -1 }
  let mut value: i64 = 0
  let mut i: usize = 0
  while i < n {
    let c = unsafe byte(p, i)
    if c < 48 || c > 57 { return -1 }
    if value > 922337203685477580 { return -1 }
    value = value * 10 + u8.toI64(c - 48)
    i = i + 1
  }
  return value
}
// check_pseudo_header: a first, nonempty occurrence.
fn checkPseudo(t: &mut Stream, valueLength: usize, flag: u32) -> bool {
  if u32.bitAnd(t.httpFlags, flag) != 0 || valueLength == 0 { return false }
  t.httpFlags = u32.bitOr(t.httpFlags, flag)
  return true
}
fn forbiddenConnectionHeader(name: ?*const u8, n: usize) -> bool {
  return unsafe equals(name, n, b"connection") || unsafe equals(name, n, b"keep-alive") || unsafe equals(name, n, b"proxy-connection")
    || unsafe equals(name, n, b"transfer-encoding") || unsafe equals(name, n, b"upgrade")
}
fn requestOnHeader(t: &mut Stream, name: ?*const u8, nn: usize, value: ?*const u8, vn: usize, trailer: bool, connectProtocol: bool) -> i32 {
  let pseudo = unsafe byte(name, 0) == 58
  if pseudo && (trailer || u32.bitAnd(t.httpFlags, H_PSEUDO_DISALLOWED) != 0) { return ERR_HTTP_HEADER }
  if unsafe equals(name, nn, b":authority") { if !checkPseudo(&mut t.*, vn, H_AUTHORITY) { return ERR_HTTP_HEADER } }
  else if unsafe equals(name, nn, b":method") {
    if !checkPseudo(&mut t.*, vn, H_METHOD) { return ERR_HTTP_HEADER }
    if unsafe equals(value, vn, b"HEAD") { t.httpFlags = u32.bitOr(t.httpFlags, H_METH_HEAD) }
    else if unsafe equals(value, vn, b"CONNECT") { if i32.remainder(t.id, 2) == 0 { return ERR_HTTP_HEADER } t.httpFlags = u32.bitOr(t.httpFlags, H_METH_CONNECT) }
    else if unsafe equals(value, vn, b"OPTIONS") { t.httpFlags = u32.bitOr(t.httpFlags, H_METH_OPTIONS) }
  } else if unsafe equals(name, nn, b":path") {
    if !checkPseudo(&mut t.*, vn, H_PATH) { return ERR_HTTP_HEADER }
    if unsafe byte(value, 0) == 47 { t.httpFlags = u32.bitOr(t.httpFlags, H_PATH_REGULAR) }
    else if vn == 1 && unsafe byte(value, 0) == 42 { t.httpFlags = u32.bitOr(t.httpFlags, H_PATH_ASTERISK) }
  } else if unsafe equals(name, nn, b":scheme") {
    if !checkPseudo(&mut t.*, vn, H_SCHEME) { return ERR_HTTP_HEADER }
    if lowerEquals(value, vn, b"http") || lowerEquals(value, vn, b"https") { t.httpFlags = u32.bitOr(t.httpFlags, H_SCHEME_HTTP) }
  } else if unsafe equals(name, nn, b":protocol") {
    if !connectProtocol { return ERR_HTTP_HEADER }
    if !checkPseudo(&mut t.*, vn, H_PROTOCOL) { return ERR_HTTP_HEADER }
  } else if unsafe equals(name, nn, b"host") {
    if !checkPseudo(&mut t.*, vn, H_HOST) { return ERR_HTTP_HEADER }
  } else if unsafe equals(name, nn, b"content-length") {
    if t.contentLength != -1 { return ERR_HTTP_HEADER }
    t.contentLength = parseUint(value, vn)
    if t.contentLength == -1 { return ERR_HTTP_HEADER }
  } else if forbiddenConnectionHeader(name, nn) { return ERR_HTTP_HEADER }
  else if unsafe equals(name, nn, b"te") { if !lowerEquals(value, vn, b"trailers") { return ERR_HTTP_HEADER } }
  else if unsafe equals(name, nn, b"priority") { }
  else if pseudo { return ERR_HTTP_HEADER }
  if !pseudo { t.httpFlags = u32.bitOr(t.httpFlags, H_PSEUDO_DISALLOWED) }
  return 0
}
fn responseOnHeader(t: &mut Stream, name: ?*const u8, nn: usize, value: ?*const u8, vn: usize, trailer: bool) -> i32 {
  let pseudo = unsafe byte(name, 0) == 58
  if pseudo && (trailer || u32.bitAnd(t.httpFlags, H_PSEUDO_DISALLOWED) != 0) { return ERR_HTTP_HEADER }
  if unsafe equals(name, nn, b":status") {
    if !checkPseudo(&mut t.*, vn, H_STATUS) { return ERR_HTTP_HEADER }
    if vn != 3 { return ERR_HTTP_HEADER }
    t.status = i64.toI32(parseUint(value, vn))
    if t.status == -1 || t.status == 101 { return ERR_HTTP_HEADER }
  } else if unsafe equals(name, nn, b"content-length") {
    if t.status == 204 {
      if t.contentLength != -1 { return ERR_HTTP_HEADER }
      if !unsafe equals(value, vn, b"0") { return ERR_HTTP_HEADER }
      t.contentLength = 0
      return ERR_REMOVE_HTTP_HEADER
    }
    if t.status / 100 == 1 { return ERR_HTTP_HEADER }
    if t.status / 100 == 2 && u32.bitAnd(t.httpFlags, H_METH_CONNECT) != 0 { return ERR_REMOVE_HTTP_HEADER }
    if t.contentLength != -1 { return ERR_HTTP_HEADER }
    t.contentLength = parseUint(value, vn)
    if t.contentLength == -1 { return ERR_HTTP_HEADER }
  } else if forbiddenConnectionHeader(name, nn) { return ERR_HTTP_HEADER }
  else if unsafe equals(name, nn, b"te") { if !lowerEquals(value, vn, b"trailers") { return ERR_HTTP_HEADER } }
  else if pseudo { return ERR_HTTP_HEADER }
  if !pseudo { t.httpFlags = u32.bitOr(t.httpFlags, H_PSEUDO_DISALLOWED) }
  return 0
}
unsafe fn httpOnHeader(sp: *mut Session, p: *mut Stream, push: bool, name: ?*const u8, nn: usize, value: ?*const u8, vn: usize, trailer: bool) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let server = s.server let noWs = s.options.noWs let connect = s.server && s.pendingConnectProtocol drop s
  let mut b = () let t = unsafe str(&mut b, p)
  if !checkName(name, nn) {
    if nn > 0 && unsafe byte(name, 0) == 58 { return ERR_HTTP_HEADER }
    let mut i: usize = 0
    while i < nn { let c = unsafe byte(name, i) if c >= 65 && c <= 90 { return ERR_HTTP_HEADER } i = i + 1 }
    t.httpFlags = u32.bitOr(t.httpFlags, H_PSEUDO_DISALLOWED)
    return ERR_IGN_HTTP_HEADER
  }
  let mut ok = true
  if unsafe equals(name, nn, b":method") { ok = vn > 0 && allIn(value, vn, 2) }
  else if unsafe equals(name, nn, b":path") { ok = allIn(value, vn, 3) }
  else if unsafe equals(name, nn, b":authority") || unsafe equals(name, nn, b"host") {
    if server || push { ok = allIn(value, vn, 4) } else if noWs { ok = allIn(value, vn, 1) } else { ok = checkValue9113(value, vn) }
  } else if unsafe equals(name, nn, b":scheme") { ok = checkScheme(value, vn) }
  else if noWs { ok = allIn(value, vn, 1) } else { ok = checkValue9113(value, vn) }
  if !ok {
    if unsafe byte(name, 0) == 58 { return ERR_HTTP_HEADER }
    t.httpFlags = u32.bitOr(t.httpFlags, H_PSEUDO_DISALLOWED)
    return ERR_IGN_HTTP_HEADER
  }
  if server || push { return requestOnHeader(&mut t.*, name, nn, value, vn, trailer, connect) }
  return responseOnHeader(&mut t.*, name, nn, value, vn, trailer)
}
fn checkPath(t: &Stream) -> bool {
  return u32.bitAnd(t.httpFlags, H_SCHEME_HTTP) == 0 || u32.bitAnd(t.httpFlags, H_PATH_REGULAR) != 0
    || (u32.bitAnd(t.httpFlags, H_METH_OPTIONS) != 0 && u32.bitAnd(t.httpFlags, H_PATH_ASTERISK) != 0)
}
fn onRequestHeaders(t: &mut Stream, push: bool) -> i32 {
  if u32.bitAnd(t.httpFlags, H_PROTOCOL) == 0 && u32.bitAnd(t.httpFlags, H_METH_CONNECT) != 0 {
    if u32.bitAnd(t.httpFlags, u32.bitOr(H_SCHEME, H_PATH)) != 0 || u32.bitAnd(t.httpFlags, H_AUTHORITY) == 0 { return -1 }
    t.contentLength = -1
  } else {
    if u32.bitAnd(t.httpFlags, H_REQ_HEADERS) != H_REQ_HEADERS || u32.bitAnd(t.httpFlags, u32.bitOr(H_AUTHORITY, H_HOST)) == 0 { return -1 }
    if u32.bitAnd(t.httpFlags, H_PROTOCOL) != 0 && (u32.bitAnd(t.httpFlags, H_METH_CONNECT) == 0 || u32.bitAnd(t.httpFlags, H_AUTHORITY) == 0) { return -1 }
    if !checkPath(&t.*) { return -1 }
  }
  if push { t.httpFlags = u32.bitAnd(t.httpFlags, H_METH_ALL) t.contentLength = -1 }
  return 0
}
fn onResponseHeaders(t: &mut Stream) -> i32 {
  if u32.bitAnd(t.httpFlags, H_STATUS) == 0 { return -1 }
  if t.status / 100 == 1 {
    t.httpFlags = u32.bitOr(u32.bitAnd(t.httpFlags, H_METH_ALL), H_EXPECT_FINAL_RESPONSE)
    t.contentLength = -1 t.status = -1
    return 0
  }
  t.httpFlags = u32.bitAnd(t.httpFlags, u32.bitNot(H_EXPECT_FINAL_RESPONSE))
  let expectBody = u32.bitAnd(t.httpFlags, H_METH_HEAD) == 0 && t.status / 100 != 1 && t.status != 304 && t.status != 204
  if !expectBody { t.contentLength = 0 }
  else if u32.bitAnd(t.httpFlags, u32.bitOr(H_METH_CONNECT, H_METH_UPGRADE_WORKAROUND)) != 0 { t.contentLength = -1 }
  return 0
}
fn onRemoteEndStream(t: &Stream) -> i32 {
  if u32.bitAnd(t.httpFlags, H_EXPECT_FINAL_RESPONSE) != 0 { return -1 }
  if t.contentLength != -1 && t.contentLength != t.recvContentLength { return -1 }
  return 0
}
fn onDataChunk(t: &mut Stream, n: usize) -> i32 {
  t.recvContentLength = t.recvContentLength + usize.toI64(n)
  if u32.bitAnd(t.httpFlags, H_EXPECT_FINAL_RESPONSE) != 0 || (t.contentLength != -1 && t.recvContentLength > t.contentLength) { return -1 }
  return 0
}
unsafe fn recordRequestMethod(p: *mut Stream, item: *mut Item) -> () {
  let mut b = () let it = unsafe itm(&mut b, item)
  let data = it.nva.view() let length = it.nva.length
  let mut offset: usize = 0
  while offset + 9 <= length {
    let nn = u32.toUsize(getU32(data, offset)) let vn = u32.toUsize(getU32(data, offset + 4))
    let name = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe atConst(data, offset + 9))
    let value = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe atConst(data, offset + 9 + nn))
    if unsafe equals(name, nn, b":method") {
      let mut c = () let t = unsafe str(&mut c, p)
      if unsafe equals(value, vn, b"CONNECT") { t.httpFlags = u32.bitOr(t.httpFlags, H_METH_CONNECT) }
      else if unsafe equals(value, vn, b"HEAD") { t.httpFlags = u32.bitOr(t.httpFlags, H_METH_HEAD) }
      return ()
    }
    offset = offset + 9 + nn + vn
  }
}

// Receiving.
unsafe fn ibReset(sp: *mut Session) -> () {
  let mut a = () let s = unsafe ses(&mut a, sp)
  s.ib = IB_READ_HEAD s.hdLength = 0 s.hdStream = 0 s.hdKind = 0 s.hdFlags = 0
  s.sbufLength = 0 s.sbufMark = 9 unsafe s.lbuf.release() s.payloadLeft = 0 s.padlen = 0
  s.block.clear() s.iv.clear() s.niv = 0 s.maxNiv = 0 s.category = 0 s.promised = 0
}
unsafe fn setMark(sp: *mut Session, left: usize) -> () { let mut a = () let s = unsafe ses(&mut a, sp) s.sbufLength = 0 s.sbufMark = left }
unsafe fn markAvail(sp: *mut Session) -> usize { let mut a = () let s = unsafe ses(&mut a, sp) return s.sbufMark - s.sbufLength }
// Reads into sbuf up to its mark.
unsafe fn bufRead(sp: *mut Session, input: ?*const u8, at: usize, end: usize) -> usize {
  let mut a = () let s = unsafe ses(&mut a, sp)
  let mut n = end - at
  if n > s.sbufMark - s.sbufLength { n = s.sbufMark - s.sbufLength }
  let mut i: usize = 0
  while i < n { s.sbuf[s.sbufLength + i] = unsafe byte(input, at + i) i = i + 1 }
  s.sbufLength = s.sbufLength + n
  return n
}
unsafe fn sb(sp: *mut Session, i: usize) -> u8 { let mut a = () let s = unsafe ses(&mut a, sp) return s.sbuf[i] }
unsafe fn sbU32(sp: *mut Session, i: usize) -> u32 {
  return u32.bitOr(u32.bitOr(u32.shiftLeft(u8.toU32(unsafe sb(sp, i)), 24), u32.shiftLeft(u8.toU32(unsafe sb(sp, i + 1)), 16)),
    u32.bitOr(u32.shiftLeft(u8.toU32(unsafe sb(sp, i + 2)), 8), u8.toU32(unsafe sb(sp, i + 3))))
}
unsafe fn payloadReadLen(sp: *mut Session, at: usize, end: usize) -> usize {
  let mut a = () let s = unsafe ses(&mut a, sp)
  return if end - at < s.payloadLeft { end - at } else { s.payloadLeft }
}
unsafe fn handlePad(sp: *mut Session) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp)
  if u8.bitAnd(s.hdFlags, F_PADDED) != 0 {
    if s.hdLength < 1 { return -1 }
    s.sbufLength = 0 s.sbufMark = 1
    return 1
  }
  return 0
}
unsafe fn computePad(sp: *mut Session) -> i64 {
  let mut a = () let s = unsafe ses(&mut a, sp)
  let padlen = u8.toUsize(s.sbuf[0]) + 1
  if padlen - 1 > s.payloadLeft { return -1 }
  s.padlen = padlen
  return usize.toI64(padlen)
}
// The trailing padding of the frame being read.
unsafe fn trailPadlen(sp: *mut Session) -> usize { let mut a = () let s = unsafe ses(&mut a, sp) return if s.padlen > 0 { s.padlen - 1 } else { 0 } }
unsafe fn effectiveReadlen(sp: *mut Session, payloadLeft: usize, readlen: usize) -> i64 {
  let trail = unsafe trailPadlen(sp)
  if trail > payloadLeft {
    let padlen = trail - payloadLeft
    if readlen < padlen { return -1 }
    return usize.toI64(readlen - padlen)
  }
  return usize.toI64(readlen)
}
fn priorityLen(flags: u8) -> usize { return if u8.bitAnd(flags, F_PRIORITY) != 0 { 5 } else { 0 } }

// The frame being read as nghttp2_frame structures for the callbacks.
struct RecvFrames { headers: Headers, push: Push, plain: Frame }
unsafe fn recvFrames(sp: *mut Session) -> RecvFrames {
  let mut a = () let s = unsafe ses(&mut a, sp)
  let hd = Frame { length: s.hdLength, stream: s.hdStream, kind: s.hdKind, flags: s.hdFlags, reserved: 0 }
  return RecvFrames {
    headers: Headers { hd: hd, padding: s.padlen, priority: Priority { stream: 0, weight: 16, exclusive: 0 }, entries: nil(), count: 0, category: s.category },
    push: Push { hd: hd, padding: s.padlen, entries: nil(), count: 0, promised: s.promised, reserved: 0 },
    plain: hd,
  }
}
unsafe fn headersFramePointer(frames: &mut RecvFrames, kind: u8) -> *mut Frame {
  if kind == PUSH_PROMISE { return unsafe Intrinsic.pointerReinterpret<*mut Push, *mut Frame>(Pointer.fromMutRef<Push>(&mut frames.push)) }
  if kind == HEADERS { return unsafe Intrinsic.pointerReinterpret<*mut Headers, *mut Frame>(Pointer.fromMutRef<Headers>(&mut frames.headers)) }
  return Pointer.fromMutRef<Frame>(&mut frames.plain)
}
unsafe fn beginHeaders(sp: *mut Session, frame: *mut Frame) -> i32 {
  let rv = unsafe callFrame(sp, CB_BEGIN_HEADERS, frame)
  if rv == ERR_TEMPORAL_CALLBACK_FAILURE { return rv }
  if rv != 0 { return ERR_CALLBACK_FAILURE }
  return 0
}
unsafe fn isNewPeerStream(sp: *mut Session, id: i32) -> bool {
  if id == 0 || unsafe isMyStream(sp, id) { return false }
  let mut a = () let s = unsafe ses(&mut a, sp) return s.lastRecvStream < id
}
unsafe fn detectIdleStream(sp: *mut Session, id: i32) -> bool {
  if unsafe isMyStream(sp, id) { let mut a = () let s = unsafe ses(&mut a, sp) return s.lastSentStream < id }
  return unsafe isNewPeerStream(sp, id)
}
unsafe fn allowIncomingNewStream(sp: *mut Session) -> bool { return u8.bitAnd(unsafe goawayFlags(sp), u8.bitOr(G_TERM_ON_SEND, G_SENT)) == 0 }
unsafe fn setCategory(sp: *mut Session, category: i32) -> () { let mut a = () let s = unsafe ses(&mut a, sp) s.category = category }
unsafe fn processHeadersFrame(sp: *mut Session) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let id = s.hdStream drop s
  let found = unsafe findStream(sp, id)
  if Pointer.isNull<Stream>(found) {
    unsafe setCategory(sp, HCAT_REQUEST)
    let mut frames = unsafe recvFrames(sp) let frame = unsafe headersFramePointer(&mut frames, HEADERS)
    if id == 0 { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"request HEADERS: stream_id == 0") }
    if !unsafe isServer(sp) {
      if unsafe detectIdleStream(sp, id) { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"request HEADERS: client received request") }
      return ERR_IGN_HEADER_BLOCK
    }
    if !unsafe isNewPeerStream(sp, id) {
      if unsafe isMyStream(sp, id) { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"request HEADERS: invalid stream_id") }
      return ERR_IGN_HEADER_BLOCK
    }
    let s2 = unsafe ses(&mut a, sp) s2.lastRecvStream = id
    let incomingMax = u32.toUsize(s2.local.maxConcurrentStreams) <= s2.numIncoming
    let pendingMax = u32.toUsize(s2.pendingMaxConcurrent) <= s2.numIncoming drop s2
    if incomingMax { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"request HEADERS: max concurrent streams exceeded") }
    if !unsafe allowIncomingNewStream(sp) { return ERR_IGN_HEADER_BLOCK }
    if pendingMax { return unsafe inflateInvalidStream(sp, id, frame, ERR_REFUSED_STREAM) }
    if Pointer.isNull<Stream>(unsafe openStream(sp, id, S_OPENING)) { return ERR_NOMEM }
    let s3 = unsafe ses(&mut a, sp) s3.lastProcStream = s3.lastRecvStream drop s3
    return unsafe beginHeaders(sp, frame)
  }
  let p = unsafe nonnull(found)
  let state = unsafe stateOf(p)
  if state == S_RESERVED {
    unsafe setCategory(sp, HCAT_PUSH_RESPONSE)
    let mut frames = unsafe recvFrames(sp) let frame = unsafe headersFramePointer(&mut frames, HEADERS)
    if unsafe isServer(sp) { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"HEADERS: no HEADERS allowed from client in reserved state") }
    let s2 = unsafe ses(&mut a, sp)
    let incomingMax = u32.toUsize(s2.local.maxConcurrentStreams) <= s2.numIncoming
    let pendingMax = u32.toUsize(s2.pendingMaxConcurrent) <= s2.numIncoming drop s2
    if incomingMax { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"push response HEADERS: max concurrent streams exceeded") }
    if !unsafe allowIncomingNewStream(sp) { return ERR_IGN_HEADER_BLOCK }
    if pendingMax { return unsafe inflateInvalidStream(sp, id, frame, ERR_REFUSED_STREAM) }
    let mut b = () let t = unsafe str(&mut b, p) t.state = S_OPENED t.flags = u8.bitAnd(t.flags, u8.bitNot(SF_PUSH)) drop t
    let mine = unsafe isMyStream(sp, id)
    let s3 = unsafe ses(&mut a, sp)
    if !mine { s3.numIncomingReserved = s3.numIncomingReserved - 1 }
    s3.numIncoming = s3.numIncoming + 1 drop s3
    return unsafe beginHeaders(sp, frame)
  }
  if state == S_OPENING && unsafe isMyStream(sp, id) {
    unsafe setCategory(sp, HCAT_RESPONSE)
    let mut frames = unsafe recvFrames(sp) let frame = unsafe headersFramePointer(&mut frames, HEADERS)
    if u8.bitAnd(unsafe shutOf(p), SHUT_RD) != 0 { return unsafe inflateInvalidConnection(sp, frame, ERR_STREAM_CLOSED, b"HEADERS: stream closed") }
    let mut b = () let t = unsafe str(&mut b, p) t.state = S_OPENED drop t
    return unsafe beginHeaders(sp, frame)
  }
  unsafe setCategory(sp, HCAT_HEADERS)
  let mut frames = unsafe recvFrames(sp) let frame = unsafe headersFramePointer(&mut frames, HEADERS)
  if u8.bitAnd(unsafe shutOf(p), SHUT_RD) != 0 { return unsafe inflateInvalidConnection(sp, frame, ERR_STREAM_CLOSED, b"HEADERS: stream closed") }
  if unsafe isMyStream(sp, id) {
    if state == S_OPENED { return unsafe beginHeaders(sp, frame) }
    return ERR_IGN_HEADER_BLOCK
  }
  if state != S_CLOSING { return unsafe beginHeaders(sp, frame) }
  return ERR_IGN_HEADER_BLOCK
}
unsafe fn processPushPromiseFrame(sp: *mut Session) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let id = s.hdStream let promised = u32.wrappingToI32(u32.bitAnd(unsafe sbU32Raw(&s.*), 2147483647)) s.promised = promised drop s
  let mut frames = unsafe recvFrames(sp) let frame = unsafe headersFramePointer(&mut frames, PUSH_PROMISE)
  if id == 0 { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"PUSH_PROMISE: stream_id == 0") }
  let s2 = unsafe ses(&mut a, sp) let refused = s2.server || s2.local.enablePush == 0 drop s2
  if refused { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"PUSH_PROMISE: push disabled") }
  if !unsafe isMyStream(sp, id) { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"PUSH_PROMISE: invalid stream_id") }
  if !unsafe allowIncomingNewStream(sp) { return ERR_IGN_HEADER_BLOCK }
  if !unsafe isNewPeerStream(sp, promised) { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"PUSH_PROMISE: invalid promised_stream_id") }
  if unsafe detectIdleStream(sp, id) { return unsafe inflateInvalidConnection(sp, frame, ERR_PROTO, b"PUSH_PROMISE: stream in idle") }
  let s3 = unsafe ses(&mut a, sp) s3.lastRecvStream = promised
  let pendingPush = s3.pendingEnablePush let tooMany = s3.numIncomingReserved >= u32.toUsize(s3.options.maxReserved) drop s3
  let found = unsafe findStream(sp, id)
  if Pointer.isNull<Stream>(found) || unsafe stateOf(unsafe nonnull(found)) == S_CLOSING || !pendingPush || tooMany {
    let rv = unsafe addRst(sp, promised, CANCEL, true)
    if rv != 0 { return rv }
    return ERR_IGN_HEADER_BLOCK
  }
  if u8.bitAnd(unsafe shutOf(unsafe nonnull(found)), SHUT_RD) != 0 { return unsafe inflateInvalidConnection(sp, frame, ERR_STREAM_CLOSED, b"PUSH_PROMISE: stream closed") }
  if Pointer.isNull<Stream>(unsafe openStream(sp, promised, S_RESERVED)) { return ERR_NOMEM }
  let s4 = unsafe ses(&mut a, sp) s4.lastProcStream = s4.lastRecvStream drop s4
  return unsafe beginHeaders(sp, frame)
}
unsafe fn sbU32Raw(s: &Session) -> u32 {
  return u32.bitOr(u32.bitOr(u32.shiftLeft(u8.toU32(s.sbuf[0]), 24), u32.shiftLeft(u8.toU32(s.sbuf[1]), 16)), u32.bitOr(u32.shiftLeft(u8.toU32(s.sbuf[2]), 8), u8.toU32(s.sbuf[3])))
}
// session_trailer_headers.
unsafe fn trailerHeaders(sp: *mut Session, stream: ?*mut Stream, kind: u8, category: i32) -> bool {
  if Pointer.isNull<Stream>(stream) || kind != HEADERS { return false }
  if unsafe isServer(sp) { return category == HCAT_HEADERS }
