//! Tests for the examples that take their styles from a stylesheet. Each compiles the CSS file
//! the docs show, adopts it on a real tree, and reads the styles the tree computed.
import examples.core.inbox_tailwind as inbox
import examples.core.plans_css as plans_css
import examples.core.plans_sheet as by_sheet
import examples.core.plans_tailwind as by_tailwind
import loom_tree.harness { clickRole, hover, locate, locateRole }
import loom.lib { drain, NoCommand, Role, TreeError }
import loom.program as program
import svg_css.compile { Options, CompileError }
import svg_css.compile
import svg_css.tokens { CssError }
import ui_fixtures.fixtures as fixtures
import ui_tree.legacy { Batch, FrameInput, UiTree }
import ui_tree.style { Fill }
import ui_tree.style_media { Preferences }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

type Failure = AssertionError<'static> | TreeError | CompileError | CssError | OutOfMemoryError

const VIEWPORT: FrameInput = FrameInput { width: 640.0, height: 240.0, scale: 1.0, time: 0.0 }

/// The same window a while later, when the cards' color transitions have ended.
const LATER: FrameInput = FrameInput { width: 640.0, height: 240.0, scale: 1.0, time: 5000.0 }

/// Compiles `css` as a build does and adopts it on the tree's root.
effect fn adopt(tree: &mut UiTree<'_>, css: string) -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let sheet = run compile.compile(String.utf8Bytes(css), &Options.make())
  let bytes = run sheet.encode()
  let mut batch = Batch.make()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
}

/// What the tree computed for a plan card.
struct Card {
  white: bool,
  padding: f32,
}

/// The computed look of the plan card named `name`.
effect fn card(tree: &mut UiTree<'_>, at: FrameInput, name: string) -> Card
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let found = run locateRole(&mut tree, at, Role.Radio, name)
  run Testing.expect(found.isSome(), "the plan card is there")
  let id = match found {
    Option.Some { value } => value.id
    Option.None => 0
  }
  let node = tree.node(tree.slotOf(id))
  let white = match node.computed().paint.background {
    Fill.Solid { color } => color.r == 1.0 && color.g == 1.0 && color.b == 1.0
    _ => false
  }
  return Card { white: white, padding: node.computed().layout.padding.left.value }
}

effect fn sheetBody() -> () ! Failure ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut app = run program.make<by_sheet.Plans, by_sheet.Message, NoCommand>()
  run app.start(&mut tree, 0.0)
  run drain(&mut app, &mut tree)
  run adopt(&mut tree, plans_css.PLAIN)

  let team = run card(&mut tree, VIEWPORT, "Team")
  let solo = run card(&mut tree, VIEWPORT, "Solo")
  run Testing.expect(team.padding == 14.0 && solo.padding == 14.0, "the sheet's padding reaches every card")
  run Testing.expect(!team.white && solo.white, "the chosen card takes the color the sheet mixes")
  let left = run locateRole(&mut tree, VIEWPORT, Role.Radio, "Solo")
  let right = run locateRole(&mut tree, VIEWPORT, Role.Radio, "Team")
  if let Option.Some { value: one } = left {
    if let Option.Some { value: other } = right {
      run Testing.expect(one.bounds.yMin == other.bounds.yMin && other.bounds.xMin >= one.bounds.xMax + 12.0, "display: flex puts the cards side by side, a gap apart")
    }
  }

  run Testing.expect(run clickRole(&mut app, &mut tree, VIEWPORT, Role.Radio, "Solo"), "a card can be clicked")
  let teamAfter = run card(&mut tree, LATER, "Team")
  let soloAfter = run card(&mut tree, LATER, "Solo")
  run Testing.expect(app.model.value.chosen == 0, "the click reaches the model")
  run Testing.expect(teamAfter.white && !soloAfter.white, "and the chosen class moves with it")
}

test effect fn aStylesheetStylesThePlanPicker() -> () ! Failure {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sheetBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn tailwindBody() -> () ! Failure ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut app = run program.make<by_tailwind.Plans, by_tailwind.Message, NoCommand>()
  run app.start(&mut tree, 0.0)
  run drain(&mut app, &mut tree)
  run adopt(&mut tree, plans_css.TAILWIND)

  let team = run card(&mut tree, VIEWPORT, "Team")
  let solo = run card(&mut tree, VIEWPORT, "Solo")
  run Testing.expect(team.padding == 14.0 && solo.padding == 14.0, "p-3.5 is 14px on every card")
  run Testing.expect(!team.white && solo.white, "bg-teal-50 on the chosen card, bg-white on the others")

  run Testing.expect(run clickRole(&mut app, &mut tree, VIEWPORT, Role.Radio, "Solo"), "a card can be clicked")
  let teamAfter = run card(&mut tree, LATER, "Team")
  let soloAfter = run card(&mut tree, LATER, "Solo")
  run Testing.expect(teamAfter.white && !soloAfter.white, "the classes follow the model")
}

test effect fn tailwindClassesStyleThePlanPicker() -> () ! Failure {
  let mut allocator = Allocator.systemAllocatorProvider()
  run tailwindBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// The same window, tall enough for the inbox.
const TALL: FrameInput = FrameInput { width: 640.0, height: 400.0, scale: 1.0, time: 0.0 }

fn tallAt(time: f64) -> FrameInput { return FrameInput { width: 640.0, height: 400.0, scale: 1.0, time: time } }

/// The slot of the first node showing `text`, or of the button around it when `button` is set.
effect fn slotOf(tree: &mut UiTree<'_>, at: FrameInput, text: string, button: bool) -> u32
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let found = if button { run locateRole(&mut tree, at, Role.Button, text) } else { run locate(&mut tree, at, text) }
  run Testing.expect(found.isSome(), "the node is there")
  return match found {
    Option.Some { value } => tree.slotOf(value.id)
    Option.None => 0
  }
}

fn filled(tree: &UiTree<'_>, slot: u32) -> bool {
  return match tree.node(slot).computed().paint.background {
    Fill.Solid { color } => color.a > 0.0
    _ => false
  }
}

fn dark(tree: &UiTree<'_>, slot: u32) -> bool {
  return match tree.node(slot).computed().paint.background {
    Fill.Solid { color } => color.a > 0.0 && color.r < 0.3 && color.g < 0.3 && color.b < 0.4
    _ => false
  }
}

/// The opacity of the box around the first node showing `text`.
effect fn opacityAround(tree: &mut UiTree<'_>, at: FrameInput, text: string) -> f32
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let slot = run slotOf(&mut tree, at, text, false)
  let node = tree.node(slot)
  if node.computed().paint.opacity < 1.0 { return node.computed().paint.opacity }
  return tree.node(node.parent).computed().paint.opacity
}

effect fn inboxBody() -> () ! Failure ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut app = run program.make<inbox.Inbox, inbox.Message, NoCommand>()
  run app.start(&mut tree, 0.0)
  run drain(&mut app, &mut tree)
  // A desktop window: a mouse that can hover, which Tailwind's hover variants ask for.
  drop tree.setStylePreferences(Preferences.desktop(false))
  run adopt(&mut tree, plans_css.INBOX)

  let first = run slotOf(&mut tree, TALL, "Welcome to Silk", true)
  let second = run slotOf(&mut tree, TALL, "Your build passed", true)
  let third = run slotOf(&mut tree, TALL, "Review the release notes", true)
  run Testing.expect(tree.node(first).computed().layout.border.bottom.value == 1.0 && tree.node(second).computed().layout.border.bottom.value == 1.0
    && tree.node(third).computed().layout.border.bottom.value == 0.0, "divide-y draws a line under every row but the last")
  run Testing.expect(filled(&tree, first) && !filled(&tree, second) && filled(&tree, third), "odd: colors the first and third rows")
  run Testing.expect(tree.node(first).computed().text.weight == 600.0 && tree.node(second).computed().text.weight == 400.0, "has-[.dot]: makes unread rows semibold")
  let unreadText = run slotOf(&mut tree, TALL, "Welcome to Silk", false)
  let readText = run slotOf(&mut tree, TALL, "Your build passed", false)
  run Testing.expect(tree.node(unreadText).computed().text.color.r < tree.node(readText).computed().text.color.r, "group-data-[state=read]: greys the subject of a read row")
  let action = run slotOf(&mut tree, TALL, "Mark read", false)
  run Testing.expect(tree.node(action).computed().text.size == 12.0, "text-[12px] is an arbitrary value")

  run Testing.expect((run opacityAround(&mut tree, TALL, "Mark unread")) == 0.0 && (run opacityAround(&mut tree, TALL, "Switches the theme")) == 0.0, "the row action and the hint start hidden")
  run Testing.expect(run hover(&mut app, &mut tree, TALL, "Your build passed"), "a row can be hovered")
  run Testing.expect((run opacityAround(&mut tree, tallAt(5000.0), "Mark unread")) == 1.0, "group-hover: shows the action of the hovered row")
  run Testing.expect((run opacityAround(&mut tree, tallAt(5000.0), "Mark read")) == 0.0, "and leaves the other rows alone")
  run Testing.expect(run hover(&mut app, &mut tree, tallAt(5000.0), "Dark"), "the theme button can be hovered")
  run Testing.expect((run opacityAround(&mut tree, tallAt(10000.0), "Switches the theme")) == 1.0, "peer-hover: shows the hint after the hovered button")

  run Testing.expect(!dark(&tree, first), "rows start light")
  run Testing.expect(run clickRole(&mut app, &mut tree, tallAt(10000.0), Role.Button, "Dark"), "the theme button can be clicked")
  run tree.frame(tallAt(15000.0))
  let firstDark = run slotOf(&mut tree, tallAt(15000.0), "Welcome to Silk", true)
  let secondDark = run slotOf(&mut tree, tallAt(15000.0), "Your build passed", true)
  run Testing.expect(dark(&tree, firstDark) && !filled(&tree, secondDark), "dark:odd: follows the dark class on the root")

  run Testing.expect(run clickRole(&mut app, &mut tree, tallAt(15000.0), Role.Button, "Welcome to Silk"), "a row can be clicked")
  run tree.frame(tallAt(20000.0))
  let firstRead = run slotOf(&mut tree, tallAt(20000.0), "Welcome to Silk", true)
  run Testing.expect(app.model.value.read[0] && tree.node(firstRead).computed().text.weight == 400.0, "a row without its dot is no longer semibold")
}

test effect fn tailwindVariantsStyleTheInbox() -> () ! Failure {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inboxBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
