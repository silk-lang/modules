//! Interaction: hit testing over the last frame's fragments, hover and active states, pointer
//! capture, clicks, focus and tab order, keyboard clicks, and nested scrolling. Everything a
//! client hears about comes out as `Event` records; nothing calls back into it.
import engine { UiTree }
import input { Input, EditCommand, Request, REQUEST_ANYWHERE, MOD_SHIFT, MOD_CONTROL, MOD_ALT, MOD_META, BUTTON_PRIMARY, BUTTON_SECONDARY, BUTTON_BACK, BUTTON_FORWARD, POINTER_TOUCH }
import mutation { Overflow }
import mutation {
  NodeKind,
  StyleState,
  Role,
  Orientation,
  Cursor,
  NOT_FOCUSABLE,
  PREVENT_FOCUS,
  PREVENT_SCROLL,
  PREVENT_KEYS,
  LISTEN_POINTER_DOWN,
  LISTEN_POINTER_UP,
  LISTEN_CLICK,
  LISTEN_POINTER_MOVE,
  LISTEN_POINTER_ENTER,
  LISTEN_POINTER_LEAVE,
  LISTEN_WHEEL,
  LISTEN_KEY_DOWN,
  LISTEN_KEY_UP,
  LISTEN_SCROLL,
  LISTEN_POINTER_CANCEL,
  LISTEN_REQUEST,
  LISTEN_GOT_POINTER_CAPTURE,
  LISTEN_LOST_POINTER_CAPTURE,
  LISTEN_POINTER_OVER,
  LISTEN_POINTER_OUT
}
import node { NONE, NO_INDEX, Event, EventKind }
import edit
import clipboard
import edit { Keymap }
import text_selection
import scroll_snap
import touch
import scroll_anchor
import paint { styleSlot, borderBox, paddingBox, overflowClip, nodeRadii, insideRounded, rounds, contentBox }
import live_svg
import scrollbar { ScrollRange, rangeOf, scrolls, userScrolls, usedOverflow, thumbOfNode }
import style { Overscroll }
import layout.lib { Fragment, FragmentKind, InvalidNode }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.point { Point2, Point3 }
import transform
import silk.geometry.rect { Rect }
import layers
import stacking { IN_FLOW }
import silk.geometry.vector { Vector2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
