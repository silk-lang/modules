// The register allocator's intervals and assignment (x64_regalloc), checked on the hand-built
// sum loop of x64_backend_tests; the backend tests run the code it leads to.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.u32
import silk.num.u8
import silk.num.usize
import silk.testing.testing { AssertionError, Testing }
import ssa { Function, Op, Type, Own, RootKind, SlotMode, NONE }
import x64_regalloc { Allocation, GPR, SPILL }
import x64_regalloc as regalloc
import x64_backend_tests { sumFunction }

/// Whether no two values with overlapping intervals share a register of the same pool.
fn disjoint(f: &Function, places: &Allocation) -> bool {
  let mut v: u32 = 0
  while v < f.valueCount() {
    let mut w: u32 = v + 1
    while w < f.valueCount() {
      let kind = places.kind(v)
      if kind != SPILL && kind == places.kind(w) && places.register(v) == places.register(w) {
        let overlap = places.starts.get(u32.toUsize(v)) <= places.ends.get(u32.toUsize(w)) && places.starts.get(u32.toUsize(w)) <= places.ends.get(u32.toUsize(v))
        if overlap { return false }
      }
      w = w + 1
    }
    v = v + 1
  }
  return true
}

test effect fn sumLoopLivesInRegisters() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let f = run sumFunction() |> Effect.provideMut<Allocator>(&mut allocator)
  let places = run regalloc.allocate(&f) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(disjoint(&f, &places), "values live at once never share a register")
  let mut spilled: u32 = 0
  let mut v: u32 = 0
  while v < f.valueCount() {
    let ty = f.value(v).ty
    // A constant takes no register: its readers take it as an immediate.
    let def = f.value(v).def
    let constant = def != NONE && f.inst(def).op == Op.ConstI32
    if (ty == Type.I32 || ty == Type.Bool) && !constant && places.kind(v) == SPILL { spilled = spilled + 1 }
    v = v + 1
  }
  run Testing.expect(spilled == 0, "the loop's integers all get registers")
  run Testing.expect(places.savedMask != 0, "and the prologue saves the callee-saved ones it uses")
}

test effect fn frameLoopTakesFragileRegisters() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let f = run sumFunction() |> Effect.provideMut<Allocator>(&mut allocator)
  let pool = regalloc.framePool()
  let cuts = regalloc.noShortcuts()
  let places = run regalloc.allocateIn(&f, pool, &cuts) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(disjoint(&f, &places), "values live at once never share a register")
  // Every instruction of the sum loop keeps the fragile registers (x64_regalloc
  // keepsFragile: arithmetic, compares, the poll, whose slow path keeps them): its values
  // all get registers, some of them fragile ones.
  let mut fragile: u32 = 0
  let mut spilled: u32 = 0
  let mut v: u32 = 0
  while v < f.valueCount() {
    let ty = f.value(v).ty
    let def = f.value(v).def
    let constant = def != NONE && f.inst(def).op == Op.ConstI32
    if (ty == Type.I32 || ty == Type.Bool) && !constant && places.kind(v) == SPILL { spilled = spilled + 1 }
    if places.kind(v) == GPR && u32.bitAnd(u32.shiftRight(pool.fragile, u8.toU32(places.register(v))), 1) != 0 { fragile = fragile + 1 }
    v = v + 1
  }
  run Testing.expect(spilled == 0, "the loop's integers all get registers")
  run Testing.expect(fragile != 0, "and some take fragile ones")
}

/// `w[j] = (c + w[j]) | ...; return j + 1` as one block, the way the optimizer leaves the
/// body of a carry loop: a trusted read of an element, its unbox, an add that takes the
/// number, the index counted up, and a trusted store of the boxed sum to the same element.
/// `trusted` says whether the accesses are; the store is the instruction before last but
/// one, the unbox the third after the `elements`.
effect fn carryBlock(trusted: bool) -> Function ! OutOfMemoryError ? &mut Allocator {
  let mut f = Function.make(3, 0)
  let b = run f.block()
  let array = run f.emit(b, Op.Arg, true, Type.Value, Own.Borrowed, NONE, NONE, 0, 0)
  f.setOwnership(array, Own.Borrowed, RootKind.Argument, 0)
  let boxedIndex = run f.emit(b, Op.Arg, true, Type.Value, Own.Borrowed, NONE, NONE, 1, 0)
  f.setOwnership(boxedIndex, Own.Borrowed, RootKind.Argument, 1)
  let boxedCarry = run f.emit(b, Op.Arg, true, Type.Value, Own.Borrowed, NONE, NONE, 2, 0)
  f.setOwnership(boxedCarry, Own.Borrowed, RootKind.Argument, 2)
  let j = run f.emit(b, Op.Unbox, true, Type.I32, Own.Unboxed, boxedIndex, NONE, 0, 0)
  let at1 = f.lastInst() drop run f.exitFor(at1, 0, 0)
  let c = run f.emit(b, Op.Unbox, true, Type.I32, Own.Unboxed, boxedCarry, NONE, 0, 0)
  let at2 = f.lastInst() drop run f.exitFor(at2, 0, 0)
  let elements = run f.emit(b, Op.Elements, true, Type.Raw, Own.Unboxed, array, NONE, 0, 0)
  let element = run f.emit(b, Op.GetElem, true, Type.Value, Own.Borrowed, elements, j, 0, 4)
  f.setOwnership(element, Own.Borrowed, RootKind.Value, array)
  let read = f.lastInst() drop run f.exitFor(read, 4, 2)
  run f.slotAt(array, SlotMode.Imm, NONE) run f.slotAt(j, SlotMode.Int, NONE)
  let number = run f.emit(b, Op.Unbox, true, Type.I32, Own.Unboxed, element, NONE, 0, 5)
  let unbox = f.lastInst() drop run f.exitFor(unbox, 5, 1)
  run f.slotAt(element, SlotMode.Imm, NONE)
  let sum = run f.emit(b, Op.Add, true, Type.I32, Own.Unboxed, c, number, 0, 6)
  let add = f.lastInst() drop run f.exitFor(add, 6, 2)
  run f.slotAt(c, SlotMode.Int, NONE) run f.slotAt(number, SlotMode.Int, NONE)
  let one = run f.emit(b, Op.ConstI32, true, Type.I32, Own.Unboxed, NONE, NONE, 1, 7)
  let next = run f.emit(b, Op.Add, true, Type.I32, Own.Unboxed, j, one, 0, 7)
  let count = f.lastInst() drop run f.exitFor(count, 7, 2)
  run f.slotAt(j, SlotMode.Int, NONE) run f.slotAt(one, SlotMode.Int, NONE)
  let boxed = run f.emit(b, Op.BoxI32, true, Type.Value, Own.Imm, sum, NONE, 0, 8)
  drop run f.emit(b, Op.PutElem, false, Type.I32, Own.Unboxed, elements, boxed, u32.wrappingToI32(j), 8)
  let store = f.lastInst() drop run f.exitFor(store, 8, 3)
  run f.slotAt(array, SlotMode.Imm, NONE) run f.slotAt(j, SlotMode.Int, NONE) run f.slotAt(sum, SlotMode.Int, NONE)
  if trusted {
    let mut get = f.inst(read) get.trusted = true f.setInst(read, get)
    let mut put = f.inst(store) put.trusted = true f.setInst(store, put)
  }
  let result = run f.emit(b, Op.BoxI32, true, Type.Value, Own.Imm, next, NONE, 0, 9)
  run f.terminate(b, Op.Return, result, NONE, 9)
  run f.compact()
  return move f
}

test effect fn shortcutsNeedNoRegister() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let f = run carryBlock(true) |> Effect.provideMut<Allocator>(&mut allocator)
  let uses = run regalloc.useCounts(&f) |> Effect.provideMut<Allocator>(&mut allocator)
  let cuts = run regalloc.shortcuts(&f, &uses) |> Effect.provideMut<Allocator>(&mut allocator)
  // Instructions 0 to 5 are the arguments, their unboxes and the `elements`.
  let read: usize = 6
  let unbox: usize = 7
  let count: usize = 10
  let store: usize = 12
  run Testing.expect(f.insts.get(read).op == Op.GetElem && f.insts.get(unbox).op == Op.Unbox && f.insts.get(store).op == Op.PutElem, "the block is laid out as built")
  run Testing.expect(cuts.folds.get(unbox), "the add takes the element's number where it is")
  run Testing.expect(cuts.plain.get(store), "the store writes where the read found the element")
  let mut folds: u32 = 0
  let mut plain: u32 = 0
  let mut i: usize = 0
  while i < f.insts.length() {
    if cuts.folds.get(i) { folds = folds + 1 }
    if cuts.plain.get(i) { plain = plain + 1 }
    i = i + 1
  }
  run Testing.expect(folds == 1 && plain == 1, "and nothing else is a shortcut")
  let places = run regalloc.allocateIn(&f, regalloc.framePool(), &cuts) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(disjoint(&f, &places), "values live at once never share a register")
  run Testing.expect(places.kind(f.insts.get(unbox).result) == SPILL, "the folded number takes no register")
  // The index ends where it is counted up, before the store that no longer reads it, and
  // the sum takes its register.
  let j = f.insts.get(read).b
  run Testing.expect(places.ends.get(u32.toUsize(j)) == usize.toU32(count) * 2 + 2, "the index ends at its add")
  run Testing.expect(places.kind(j) == GPR && places.kind(f.insts.get(count).result) == GPR && places.register(j) == places.register(f.insts.get(count).result), "which runs in its register")
  let none = regalloc.noShortcuts()
  let kept = run regalloc.allocateIn(&f, regalloc.framePool(), &none) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(kept.ends.get(u32.toUsize(j)) == usize.toU32(store) * 2 + 2, "without the shortcut the store reads the index")
  // Accesses that test the count each time may leave: no shortcut.
  let g = run carryBlock(false) |> Effect.provideMut<Allocator>(&mut allocator)
  let gUses = run regalloc.useCounts(&g) |> Effect.provideMut<Allocator>(&mut allocator)
  let gCuts = run regalloc.shortcuts(&g, &gUses) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!gCuts.folds.get(unbox) && !gCuts.plain.get(store), "an access that is not trusted takes none")
}
