//! View bookkeeping for virtual items. Geometry and virtualization policy belong to ui-tree.
pub import ui_protocol.options { VirtualItem, VirtualOptions }
import heap { Heap }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.num.usize

/// One keyed item emitted by the view.
pub struct VirtualRow {
  /// Logical item index.
  pub index: usize,
  /// The item's key.
  pub key: u64,
  /// Entry in the view arena, resolved to a client node ID by the backend adapter.
  pub entry: u32,
}

impl Copy for VirtualRow {}

/// The rows a view plays into a virtual list: logical index and key, in ascending order.
pub struct VirtualSlot {
  pub index: usize,
  pub key: u64,
}

impl Copy for VirtualSlot {}

/// A view's identity and the indices the backend last requested, with no layout geometry.
pub struct VirtualList {
  /// Stable view identity.
  pub key: u64,
  /// Configuration forwarded to the backend.
  pub options: VirtualOptions,
  /// Logical item count.
  pub count: usize,
  /// Current view items.
  pub rows: List<VirtualRow>,
  /// Arena entry of the scroll container.
  pub port: u32,
  /// Sorted indices the backend wants mounted: the range around the viewport and any rows it
  /// retains for focus, an active descendant or a screen reader's browse cursor.
  pub indices: List<usize>,
  /// Whether this render visited the list.
  pub seen: bool,
  /// Last backend port id, count, options and bound items emitted so unchanged lists send no
  /// redundant `SetVirtualList` / `SetVirtualItems` mutations.
  pub sentPort: u32,
  pub sentCount: usize,
  pub sentOptions: VirtualOptions,
  pub sentItems: List<VirtualItem>,
}

impl VirtualList {
  /// Creates empty view bookkeeping. The backend requests the initial indices.
  pub fn make(key: u64, options: VirtualOptions) -> VirtualList {
    return VirtualList {
      key: key,
      options: options,
      count: 0,
      rows: List<VirtualRow>.make(),
      port: 0,
      indices: List<usize>.make(),
      seen: true,
      sentPort: 0,
      sentCount: 0,
      sentOptions: options,
      sentItems: List<VirtualItem>.make(),
    }
  }

  /// The sorted indices to mount for `count` items: the requested ones, or, when the count or
  /// revision changed, where the last render's rows moved to by key, so a retained row (and
  /// its focus) stays mounted while the backend catches up. Rows whose key is gone are dropped.
  pub fn wanted(
    self: &Self,
    heap: &mut Heap,
    out: &mut List<usize>,
    count: usize,
    options: VirtualOptions,
    key: fn(usize) -> u64,
  ) -> () {
    out.clear()
    if (count == self.count && options.revision == self.options.revision) || self.rows.length() == 0 {
      let mut i: usize = 0
      while i < self.indices.length() {
        let index = self.indices.get(i)
        if index < count {
          heap.alloc(out.append(index))
        }
        i = i + 1
      }
      return ()
    }
    let mut r: usize = 0
    while r < self.rows.length() {
      let row = self.rows.get(r)
      r = r + 1
      let found = locate(row.key, row.index, count, key)
      if found == usize.MAX {
        continue
      }
      // Sorted insert; rows are few, so this stays cheap.
      let mut at = out.length()
      while at > 0 && out.get(at - 1) > found {
        at = at - 1
      }
      if at > 0 && out.get(at - 1) == found {
        continue
      }
      heap.alloc(out.insert(at, found))
    }
  }
}

/// The index of the item keyed `wanted` among `count`, searching outward from `near`, or
/// `usize.MAX`. An insertion or removal near the row finds it in a few steps.
fn locate(wanted: u64, near: usize, count: usize, key: fn(usize) -> u64) -> usize {
  if count == 0 {
    return usize.MAX
  }
  let start = if near < count { near } else { count - 1 }
  let mut distance: usize = 0
  while distance <= start || start + distance < count {
    if distance <= start && key(start - distance) == wanted {
      return start - distance
    }
    if distance != 0 && start + distance < count && key(start + distance) == wanted {
      return start + distance
    }
    distance = distance + 1
  }
  return usize.MAX
}
