import silk.build.plan { Framework, Plan }
import silk.build.step { sourcePath }

// The battery from IOKit's power sources (native/battery.c). Other platforms compile nothing here.
static fn plan() -> Plan {
  let mut plan = Plan.empty()
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan
      |> Plan.compileNative("c", sourcePath("native/battery.c"), &["-O2", "-Wall", "-Wextra", "-Werror", "-mmacosx-version-min=11.0"], &[])
    plan = plan |> Plan.linkFramework("IOKit", Framework.make())
    plan = plan |> Plan.linkFramework("CoreFoundation", Framework.make())
  }
  return plan
}

pub const PLAN: Plan = plan()
