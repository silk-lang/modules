import silk.build.graph { BuildError }

static if Intrinsic.targetOperatingSystem() == "darwin"
  || Intrinsic.targetOperatingSystem() == "linux" {
  import silk.cli.task { Task, TaskError }
  import silk.collections.bytes { Bytes }
  import silk.collections.list { List }
  import silk.core.effect { Effect }
  import silk.core.option { Option }
  import silk.core.result { Result }
  import silk.io.writer { Writer, WriterError }
  import silk.io.writer_native { StdoutWriter }
  import silk.json.scanner { JsonError }
  import silk.json.value { Json, Value }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.system.child_process { ChildProcess, ProcessError }
  import silk.system.filesystem { FileError, FileSystem, Path }
  import silk.system.host_input { HostInput, HostInputError }
  import silk.text.string { String, InvalidUtf8 }
  import silk.num.i32
  import src.task_support { build, rootPath, pathText, require }
  import src.task_native_process {
    Process,
    Output,
    start,
    finish,
    poll,
    pause,
    milliseconds,
    removeSocket
  }
  import src.task_native_display { Display, openDisplay, closeDisplay, joined, decimal, views }

  pub struct App {
    pub child: Process,
    pub socket: Path
  }

  pub effect fn say(message: string) -> ()
    ! WriterError {
    let mut writer = StdoutWriter.make()
    run Writer.writeString(message) |> Effect.provideMut<Writer>(&mut writer)
    run Writer.writeString("\n") |> Effect.provideMut<Writer>(&mut writer)
  }

  pub effect fn expect(condition: bool, message: string) -> ()
    ! TaskError | OutOfMemoryError | WriterError
    ? &mut Allocator {
    run require(condition, message)
    let mut writer = StdoutWriter.make()
    run Writer.writeString("ok: ") |> Effect.provideMut<Writer>(&mut writer)
    run Writer.writeString(message) |> Effect.provideMut<Writer>(&mut writer)
    run Writer.writeString("\n") |> Effect.provideMut<Writer>(&mut writer)
  }

  pub effect fn utf8(bytes: &[u8]) -> string
    ! TaskError | OutOfMemoryError
    ? &mut Allocator {
    return match String.fromUtf8(bytes) {
      Result<string, InvalidUtf8>.Success { value } => value
      Result<string, InvalidUtf8>.Failure { .. } => run Task.abort("Inspector output is not UTF-8")
    }
  }

  pub effect fn json(bytes: &[u8]) -> Value
    ! TaskError | OutOfMemoryError
    ? &mut Allocator {
    return match move run Effect.result(Json.parse(bytes)) {
      Result<Value, JsonError | OutOfMemoryError>.Success { value } => move value
      Result<Value, JsonError | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError failure => {
          fail move failure
        }
        JsonError _error => run Task.abort("Invalid inspector JSON")
      }
    }
  }

  pub effect fn field<'a>(value: &'a Value, name: string) -> &'a Value
    ! TaskError | OutOfMemoryError
    ? &mut Allocator {
    return match Json.field(value, name) {
      Option<&Value>.Some { value: found } => found
      Option<&Value>.None => run Task.abort("Missing inspector JSON field")
    }
  }

  pub effect fn array(value: &Value) -> &[Value]
    ! TaskError | OutOfMemoryError
    ? &mut Allocator {
    return match &value.* {
      Value.Array { values } => values.asSlice()
      _ => run Task.abort("Expected inspector JSON array")
    }
  }

  pub fn number(value: &Value, name: string) -> i32 {
    return Json.field(value, name)
      |> Json.asI32
      |> Option<i32>.unwrapOr(-1)
  }

  pub fn stringField<'a>(value: &'a Value, name: string) -> string<'a> {
    return Json.field(value, name)
      |> Json.asString
      |> Option<string<'a>>.unwrapOr("")
  }

  pub fn truth(value: &Value, name: string) -> bool {
    return match Json.field(value, name) {
      Option<&Value>.Some { value: found } => match &found.* {
        Value.Bool { value: flag } => flag
        _ => false
      }
      Option<&Value>.None => false
    }
  }

  pub fn png(bytes: &[u8]) -> bool {
    let signature: [u8; 8] = [137, 80, 78, 71, 13, 10, 26, 10]
    if bytes.length < 8 {
      return false
    }
    let mut at: usize = 0
    while at < 8 {
      if bytes[at] != signature[at] {
        return false
      }
      at = at + 1
    }
    return true
  }

  pub effect fn picture(path: &Path) -> ()
    ! TaskError | FileError | OutOfMemoryError | WriterError
    ? &mut Allocator | &mut FileSystem {
    let bytes = run FileSystem.readFile(path)
    run expect(png(Bytes.asSlice(&bytes)), "PNG screenshot")
  }

  pub effect fn command(cli: string, socket: &Path, args: &[string], env: &[string]) -> Output
    ! TaskError | FileError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let mut arguments = List<string>.make()
    run arguments.append("--connect")
    run arguments.append(pathText(socket))
    let mut at: usize = 0
    while at < args.length {
      run arguments.append(args[at])
      at = at + 1
    }
    let mut child = run start(cli, arguments.asSlice(), env, true, false, true)
    return run finish(&mut child, 60000)
  }

  pub effect fn commandJson(cli: string, app: &App, args: &[string], env: &[string]) -> Value
    ! TaskError | FileError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let output = run command(cli, &app.socket, args, env)
    if output.code != 0 {
      let error = run utf8(Bytes.asSlice(&output.errors))
      if error != "" {
        run Task.abort(error)
      }
      run Task.abort("Inspector command failed")
    }
    return run json(Bytes.asSlice(&output.output))
  }

  pub effect fn program(
    name: string,
    binary: string,
    args: &[string],
    env: &[string],
    cli: string,
  ) -> App
    ! TaskError | FileError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let work = run rootPath(".cache/ui-inspect")
    run FileSystem.createDirectoriesRecursively(&work)
    let filename = run joined(name, ".sock")
    let socket = run Path.join(&work, String.view(&filename))
    run removeSocket(&socket)
    let assignment = run joined("SILK_UI_INSPECT=", pathText(&socket))
    let mut environment = List<string>.make()
    let mut at: usize = 0
    while at < env.length {
      run environment.append(env[at])
      at = at + 1
    }
    run environment.append(String.view(&assignment))
    let mut child = run start(binary, args, environment.asSlice(), false, false, true)
    let deadline = milliseconds() + 120000
    while true {
      let hello = run command(cli, &socket, &["hello"], env)
      if hello.code == 0 {
        break
      }
      if run poll(&mut child) {
        run Task.abort("Application exited before inspector became ready")
      }
      if milliseconds() >= deadline {
        run Task.abort("Timed out waiting for application inspector")
      }
      pause()
    }
    return App { child: move child, socket: move socket }
  }

  effect fn inspectWith(binary: string, cli: string, display: &Display) -> ()
    ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let environment = run views(&display.environment)
    let env = environment.asSlice()
    let app = run program("inbox", binary, &[], env, cli)
    let before = run command(cli, &app.socket, &["snapshot"], env)
    let beforeText = run utf8(Bytes.asSlice(&before.output))
    run expect(
      before.code == 0 && String.contains(beforeText, "role=button label=\"New\""),
      "snapshot lists New button",
    )
    run expect(!String.contains(beforeText, "A new message"), "no new row before click")
    let clicked = run commandJson(cli, &app, &["click", "--role", "button", "--name", "New"], env)
    run expect(number(&clicked, "node") == 10, "click New by role and name")
    let waited = run command(
      cli,
      &app.socket,
      &["wait", "--text", "A new message", "--timeout", "10000"],
      env,
    )
    run expect(waited.code == 0, "click creates row")
    let snapshot = run command(cli, &app.socket, &["snapshot"], env)
    run expect(
      String.contains(run utf8(Bytes.asSlice(&snapshot.output)), "\"A new message\""),
      "snapshot contains row",
    )
    let highlighted = run commandJson(
      cli,
      &app,
      &["highlight", "--role", "button", "--name", "Archive"],
      env,
    )
    let nodes = run array(run field(&highlighted, "nodes"))
    run expect(
      nodes.length == 1
        && (Json.asI32(Option<&Value>.some(&nodes[0])) |> Option<i32>.unwrapOr(-1)) == 20,
      "highlight Archive",
    )
    let inspected = run command(
      cli,
      &app.socket,
      &["inspect", "--role", "button", "--name", "Archive"],
      env,
    )
    run expect(
      inspected.code == 0
        && String.startsWith(run utf8(Bytes.asSlice(&inspected.output)), "box #20"),
      "inspect Archive",
    )
    let shot = run rootPath(".cache/ui-inspect/inspect.png")
    if run FileSystem.exists(&shot) {
      run FileSystem.removeFile(&shot)
    }
    let screenshot = run command(cli, &app.socket, &["screenshot", pathText(&shot)], env)
    run expect(screenshot.code == 0, "capture inspector screenshot")
    run picture(&shot)
    let stats = run command(cli, &app.socket, &["stats"], env)
    run expect(String.contains(run utf8(Bytes.asSlice(&stats.output)), "\"nodes\":"), "stats")
    let missing = run command(cli, &app.socket, &["click", "--name", "no such button"], env)
    run expect(
      missing.code == 1
        && String.contains(run utf8(Bytes.asSlice(&missing.errors)), "no node matches"),
      "missing node is an error",
    )
    run editRoundTrip(cli, &app, env)
  }

  /// A style edit outlasts the app restyling the node (the demo restyles Archive when New adds a
  /// row), shows in the edit log, and goes once resolved.
  effect fn editRoundTrip(cli: string, app: &App, env: &[string]) -> ()
    ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let set = run commandJson(
      cli,
      app,
      &["set-style", "padding-left: 30px", "--role", "button", "--name", "Archive"],
      env,
    )
    run expect((run array(run field(&set, "edits"))).length == 1, "set-style records an edit")
    let added = run commandJson(cli, app, &["click", "--role", "button", "--name", "New"], env)
    run expect(number(&added, "node") == 10, "New restyles Archive in the app")
    let styled = run commandJson(
      cli,
      app,
      &["styles", "--role", "button", "--name", "Archive"],
      env,
    )
    let edited = run array(run field(run field(&styled, "overrides"), "base"))
    let client = run array(run field(run field(&styled, "client"), "base"))
    let mut kept = false
    let mut at: usize = 0
    while at < client.length {
      if (Json.asString(Option<&Value>.some(&client[at])) |> Option<string>.unwrapOr(""))
        == "padding-left: 12px" {
        kept = true
      }
      at = at + 1
    }
    run expect(
      edited.length == 1
        && (Json.asString(Option<&Value>.some(&edited[0])) |> Option<string>.unwrapOr(""))
          == "padding-left: 30px"
        && kept,
      "the edit outlasts the app's restyle, over the app's own value",
    )
    let listed = run commandJson(cli, app, &["edits", "--status", "open", "--json"], env)
    let open = run array(run field(&listed, "edits"))
    run expect(
      open.length == 1 && stringField(&open[0], "after") == "30px" && truth(&open[0], "applied"),
      "edits lists the open edit",
    )
    let id = run decimal(i32.toUsize(number(&open[0], "id")))
    let resolved = run commandJson(cli, app, &["resolve", String.view(&id)], env)
    let entries = run array(run field(&resolved, "entries"))
    run expect(
      entries.length == 1 && stringField(&entries[0], "status") == "resolved",
      "resolve marks it done",
    )
    let after = run commandJson(cli, app, &["styles", "--role", "button", "--name", "Archive"], env)
    let gone = match Json.field(&after, "overrides") {
      Option<&Value>.Some { .. } => false
      Option<&Value>.None => true
    }
    run expect(gone, "and the override is gone")
  }

  pub effect fn inspect() -> ()
    ! BuildError
      | TaskError
      | ProcessError
      | FileError
      | HostInputError
      | OutOfMemoryError
      | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let binary = run build("modules/tree/demo", false, false)
    let cli = run build("modules/inspect/cli", false, false)
    let display = run openDisplay("x11")
    let result = run Effect.result(inspectWith(String.view(&binary), String.view(&cli), &display))
    run closeDisplay(move display)
    if let Result<
      (),
      TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
    >.Failure {
      error
    } = move result {
      fail move error
    }
  }
}
