import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.testing.testing { Testing, AssertionError }
import runtime_memory { RuntimeAllocator }
import js_engine { Engine }
import js_atomics_native { WaiterDomain, SynchronizationError }
import js_heap { HeapHeader }
import js_exceptions { JsException }
import js_value { ValueBits }
import js_owned_value { Value }
import js_realm { lendRealm }
import js_runtime as runtime
import js_gc as gc
import js_intrinsic_install as intrinsics
import native_stack as stack
import js_eval as eval
import js_eval_compile as flags
import js_bytecode_image as image
import js_census as census
import js_census { Rows }
import js_debugger_execution_consumer { Services }

// An image written under one file name runs under another (loadNamed): the functions
// read from its bytes at their first call report the new name too.
test effect fn imageRunsUnderAnotherName() -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: Services.make() }
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  // The image's bytes outlive the runtime that reads them.
  let mut bytes = List<u8>.make()
  let checked = run Effect.result(unsafe exercise(&mut engine, context, &mut bytes)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  drop bytes
  match move checked {
    Result<(), OutOfMemoryError | JsException | AssertionError<'static>>.Success { value: _ } => ()
    Result<(), OutOfMemoryError | JsException | AssertionError<'static>>.Failure { error } => { fail move error }
  }
}

unsafe effect fn number<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, source: &[u8]) -> i32
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory
  let bits = Value.intoBits(run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"check.js", flags.TYPE_GLOBAL))
  return match bits { ValueBits.Int { value } => value _ => -1 }
}

/// The entries of the census row called name; 0 when there is none.
fn row(rows: &Rows, name: string<'static>) -> usize {
  let mut at: usize = 0
  while at < rows.names.length() {
    if rows.names.get(at) == name { return rows.values.get(at * 4 + 1) }
    at = at + 1
  }
  return 0
}

unsafe effect fn exercise<'m>(engine: &mut Engine<'m, Services>, context: *mut HeapHeader, bytes: &mut List<u8>) -> ()
  ! OutOfMemoryError | JsException | AssertionError<'static> ? &mut Allocator {
  let memory = engine.memory
  let written = run image.write(&mut engine, memory, unsafe lendRealm(&context, context),
    b"function where() { function deep() { function deeper() { return new Error('x').stack } return deeper() } return deep() } function lost() { var o = {}; return o.absent(1) } function texts() { return ['a long Latin-1 literal read from the image', '\\u4e2d\\u6587 a wide literal read from the image'] }\nfunction second(n) {\n  return n ? second(n - 1) :\n    new Error('l').stack\n}\nvar top = new Error('t').stack; 5",
    b"/built/app.js", flags.TYPE_GLOBAL)
  bytes.* = move written
  run Testing.expect(image.loadable(bytes.asSlice()), "the engine loads the image it wrote")
  let compiled = run unsafe image.loadNamed(&mut engine, unsafe lendRealm(&context, context), Pointer.fromRef<u8>(&bytes.asSlice()[0]), bytes.length(), b"/installed/app.js")
  let ran = Value.intoBits(run eval.evaluateFunction(&mut engine, memory, unsafe lendRealm(&context, context), move compiled))
  run Testing.expect(match ran { ValueBits.Int { value } => value == 5 _ => false }, "the image ran")
  let top = run unsafe number(&mut engine, context, b"(top.indexOf('/installed/app.js') >= 0 ? 1 : 0) + (top.indexOf('/built/') >= 0 ? 10 : 0)")
  run Testing.expect(top == 1, "the top level reports the name it was loaded under")
  let deep = run unsafe number(&mut engine, context, b"var s = where(); (s.split('/installed/app.js').length - 1) + (s.indexOf('/built/') >= 0 ? 100 : 0)")
  run Testing.expect(deep == 3, "functions read at their first call report it too")
  // The image lends its source text (SourceText.Lent): what reads a function's text
  // reads it from the image's bytes.
  let text = run unsafe number(&mut engine, context, b"var t = where.toString(); (t.indexOf('function where() { function deep()') == 0 ? 1 : 0) + (t.lastIndexOf('return deep() }') == t.length - 15 ? 10 : 0)")
  run Testing.expect(text == 11, "a function's text is read from the image")
  let site = run unsafe number(&mut engine, context, b"function miss() { var o = {}; return o.absent.call() } var m = ''; try { miss() } catch (e) { m = String(e.message) } m.length > 0 ? 1 : 0")
  run Testing.expect(site == 1, "an error in a check script still reports")
  let named = run unsafe number(&mut engine, context, b"var n = ''; try { lost() } catch (e) { n = String(e.message) } n.indexOf('o.absent is not a function') >= 0 ? 1 : 0")
  run Testing.expect(named == 1, "an error names its call site from the image's text")
  // A function whose body waited in the image boxes its line tables only with
  // that body: its first call's frames already name their lines and columns.
  let lines = run unsafe number(&mut engine, context, b"var q = second(2); (q.split('/installed/app.js:4:14)').length - 1) + 10 * (q.split('/installed/app.js:3:20)').length - 1)")
  run Testing.expect(lines == 21, "a deferred function's frames read their lines")
  let again = run unsafe number(&mut engine, context, b"var q = second(2); (q.split('/installed/app.js:4:14)').length - 1) + 10 * (q.split('/installed/app.js:3:20)').length - 1)")
  run Testing.expect(again == 21, "and later calls' frames read the same")
  // The image lends its long atoms' text too (Strings.lend): they read, compare,
  // join and key properties as any other string does.
  let latin1 = run unsafe number(&mut engine, context, b"var x = texts()[0]; var o = {}; o[x] = 7; (x === 'a long Latin-1 literal ' + 'read from the image' ? 1 : 0) + (x.charCodeAt(2) == 108 ? 10 : 0) + (o['a long Latin-1 literal read from the image'] == 7 ? 100 : 0) + (x.slice(7, 14) == 'Latin-1' ? 1000 : 0)")
  run Testing.expect(latin1 == 1111, "a lent Latin-1 atom reads as its text")
  let wide = run unsafe number(&mut engine, context, b"var y = texts()[1]; (y.charCodeAt(0) == 0x4e2d ? 1 : 0) + (y.length == 37 ? 10 : 0) + (y === '\\u4e2d\\u6587 a wide literal ' + 'read from the image' ? 100 : 0)")
  run Testing.expect(wide == 111, "a wide atom from the image reads as its text")
  // The census tells the lent text from the strings the heap holds.
  let kept = run unsafe number(&mut engine, context, b"globalThis.kept = ['census', new Array(2000).join('ab')].join(' '); globalThis.big = new ArrayBuffer(70000); globalThis.list = new Array(500).fill(1); globalThis.map = new Map([[1, 2]]); kept.length")
  run Testing.expect(kept == 4005, "a string above the pool's blocks is held")
  let mut rows = Rows.make()
  let realm = unsafe lendRealm(&context, context)
  run unsafe census.collect(realm.runtime(), memory, &mut rows)
  run Testing.expect(row(&rows, "js.functions.source-text.lent-spans-bytes") > 0, "the census counts the image's lent text")
  run Testing.expect(row(&rows, "js.atoms.lent") >= 1, "the census counts the image's lent atoms")
  run Testing.expect(row(&rows, "js.atoms.lent-text-bytes") >= 42, "the census counts their text")
  run Testing.expect(row(&rows, "js.strings.over-1-kb") >= 1, "the census counts the large string")
  run Testing.expect(row(&rows, "js.strings.over-1-kb.bytes") >= 4005, "the census counts its bytes")
  run Testing.expect(row(&rows, "js.array-buffers.bytes") >= 70000, "the census counts ArrayBuffer bytes")
  run Testing.expect(row(&rows, "js.large.array-elements") >= 1, "the census counts a big array's elements")
  run Testing.expect(row(&rows, "js.opaque-cells") >= 2, "the census counts the buffer's and the map's cells")
  run Testing.expect(row(&rows, "js.large.up-to-4-kb") + row(&rows, "js.large.up-to-16-kb") + row(&rows, "js.large.up-to-64-kb")
    + row(&rows, "js.large.up-to-256-kb") + row(&rows, "js.large.up-to-1-mb") + row(&rows, "js.large.over-1-mb") == row(&rows, "js.large-allocations"),
    "the size buckets add up to the large allocations")
  run Testing.expect(row(&rows, "js.large.largest-01") >= row(&rows, "js.large.largest-02") && row(&rows, "js.large.largest-02") > 0,
    "the largest large allocations come largest first")
  run Testing.expect(row(&rows, "js.runtime.shape-hash") > 0, "the census counts the runtime's shape hash")
}
