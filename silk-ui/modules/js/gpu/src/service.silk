//! Runs the WebGPU commands of a ui-js realm (see [`wire`](wire)) on GPU devices that belong
//! to the application, apart from the device that draws the window, and shows what a canvas
//! context drew in its canvas node.
//!
//! [`GpuService.run`] takes the bytes JavaScript wrote in a turn. Every object JavaScript
//! made is in a table under the number JavaScript gave it. A command that fails (a missing
//! object, a refusal by the GPU library) is dropped alone and reported as an uncaptured error
//! of its device, or as the failure of its promise. After the commands, each canvas a context
//! asked the texture of is presented, and what the promises wait for is in
//! [`GpuService.takeReplies`].
//!
//! Commands that the web API answers later (mapping a buffer, waiting for the queue, popping
//! an error scope) wait for the GPU here, inside `run`.
import wire
import wire { Reader }
import ui_js_calls.gpu { GpuReply }
import ui_tree.legacy { Batch }
import ui_tree.mutation { NO_SURFACE }
import ui_tree_window.canvas_frames { CanvasPresenter }
import ui_tree_window.gpu_canvas { CanvasGpu, GpuCanvas, sharingFeatures }
import webgpu.runtime { Adapter, Device, GpuError, Instance, MappedBuffer, RequestAdapterOptions }
import webgpu.runtime as runtime
import webgpu.resources as gpu
import webgpu.resources {
  BindGroup,
  BindGroupLayout,
  BindGroupLayoutRef,
  Buffer,
  CommandBuffer,
  CommandBufferRef,
  CommandEncoder,
  ComputePipeline,
  PipelineLayout,
  RenderPipeline,
  Sampler,
  ShaderModule,
  Texture,
  TextureView
}
import webgpu.descriptors {
  BindGroupDescriptor,
  BindGroupEntry,
  BindGroupLayoutDescriptor,
  BindGroupLayoutEntry,
  BlendComponent,
  BlendState,
  BufferBindingLayout,
  BufferDescriptor,
  Color,
  ColorTargetState,
  ComputePassDescriptor,
  ComputePipelineDescriptor,
  ComputeState,
  ConstantEntry,
  DepthStencilState,
  DeviceDescriptor,
  Extent3D,
  FragmentState,
  Limits,
  MultisampleState,
  Origin3D,
  PipelineLayoutDescriptor,
  PrimitiveState,
  RenderPassColorAttachment,
  RenderPassDepthStencilAttachment,
  RenderPassDescriptor,
  RenderPipelineDescriptor,
  SamplerBindingLayout,
  SamplerDescriptor,
  StencilFaceState,
  StorageTextureBindingLayout,
  TexelCopyBufferInfo,
  TexelCopyBufferLayout,
  TexelCopyTextureInfo,
  TextureBindingLayout,
  TextureDescriptor,
  TextureViewDescriptor,
  VertexAttribute,
  VertexBufferLayout,
  VertexState
}
import webgpu_sys.generated_webgpu as flags
import silk.collections.list { List }
import silk.core.effect { Effect }
