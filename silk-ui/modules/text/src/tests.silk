// Optical sizing changes glyph outlines and advances at the same nominal em size.
// Reusing the default-axis instance made small native UI labels noticeably too narrow.
effect fn opticalSizingBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let mut collection = run fonts()
  drop run collection.add(run readFile("modules/text/tests/fonts/RobotoFlex.subset.ttf"))
  let mut system = TextSystem.make(&collection)
  let mut keys = List<usize>.make()
  let sizes: [f32; 3] = [12.0, 72.0, 12.0]
  let mut i: usize = 0
  while i < sizes.length {
    let mut families = List<Family>.make()
    run families.append(run Family.named(String.utf8Bytes("Roboto Flex")))
    let key = run system.addStyle(TextStyle.make(move families, sizes[i]))
    run keys.append(key)
    i = i + 1
  }
  run Testing.expect(system.keyInfo(keys.get(0)).face == 3, "variable face selected")
  run Testing.expect(
    system.fonts.instanceOf(keys.get(0)) != system.fonts.instanceOf(keys.get(1)),
    "optical sizes use distinct outlines",
  )
  run Testing.expect(
    system.fonts.instanceOf(keys.get(0)) == system.fonts.instanceOf(keys.get(2)),
    "same optical size reuses its outline instance",
  )
  let mut advances = List<f32>.make()
  i = 0
  while i < 2 {
    let output = run layout(&mut system, keys.get(i), 2000.0, "Hamburgefonts")
    let mut found = List<PlacedText>.make()
    let mut ys = List<f32>.make()
    run texts(&output, &mut found, &mut ys)
    let advance = system.glyphRun(found.get(0).shapeKey).advance / sizes[i]
    run advances.append(advance)
    i = i + 1
  }
  run Testing.expect(
    f32.abs(advances.get(0) - advances.get(1)) > 0.01,
    "optical sizing changes normalized advances",
  )
  // font-variation-settings sets axes, and wins over font-weight for its axis.
  let mut flexAdvances = List<f32>.make()
  i = 0
  while i < 4 {
    let mut families = List<Family>.make()
    run families.append(run Family.named(String.utf8Bytes("Roboto Flex")))
    let mut style = TextStyle.make(move families, 20.0)
    if i == 1 || i == 3 {
      style.variations.tags[0] = 0x77676874
      style.variations.values[0] = 800.0
      style.variations.count = 1
    }
    if i == 2 {
      style.request.weight = 800.0
    }
    if i == 3 {
      style.request.weight = 200.0
    }
    let key = run system.addStyle(move style)
    let output = run layout(&mut system, key, 2000.0, "Hamburgefonts")
    let mut found = List<PlacedText>.make()
    let mut ys = List<f32>.make()
    run texts(&output, &mut found, &mut ys)
    run flexAdvances.append(system.glyphRun(found.get(0).shapeKey).advance)
    i = i + 1
  }
  run Testing.expect(f32.abs(flexAdvances.get(0) - flexAdvances.get(1)) > 0.5, "a wght setting changes the outlines")
  run Testing.expect(f32.abs(flexAdvances.get(1) - flexAdvances.get(2)) < 0.01, "wght 800 draws as font-weight 800")
  run Testing.expect(f32.abs(flexAdvances.get(1) - flexAdvances.get(3)) < 0.01, "the setting wins over font-weight")
  let small = run system.addStyle(run sans(12.0))
  let large = run system.addStyle(run sans(72.0))
  run Testing.expect(
    system.fonts.instanceOf(small) == system.fonts.instanceOf(large),
    "static fonts share outlines across sizes",
  )
}

test effect fn opticalSizingUsesTheRequestedTextSize() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run opticalSizingBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Faces added at run time.

effect fn families(names: &[string], size: f32) -> TextStyle
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut list = List<Family>.make()
  let mut i: usize = 0
  while i < names.length {
    run list.append(run Family.named(String.utf8Bytes(names[i])))
    i = i + 1
  }
  return TextStyle.make(move list, size)
}

/// The faces of the glyph runs `output` draws with, in order.
effect fn runFaces(system: &TextSystem<'_>, output: &LayoutTree, out: &mut List<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = List<PlacedText>.make()
  let mut ys = List<f32>.make()
  run texts(&output, &mut found, &mut ys)
  let mut i: usize = 0
  while i < found.length() {
    run out.append(system.glyphRun(found.get(i).shapeKey).face)
    i = i + 1
  }
}

effect fn addedFontsJoinAfterStartBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let collection = run fonts()
  let mut system = TextSystem.make(&collection)
  let before = run system.addStyle(run families(&["Noto Serif", "Noto Sans"], 16.0))
  run Testing.expect(system.keyInfo(before).face == 0, "without Noto Serif, Noto Sans draws")
  let generation = system.fonts.set.generation
  let added = run system.fonts.set.addFont(run readFile(SERIF))
  run Testing.expect(added == 1, "the file has one face")
  run Testing.expect(system.fonts.set.generation != generation, "adding a face is a change")
  run Testing.expect(system.fonts.set.faceCount() == 4, "the added face follows the installed ones")
  let after = run system.addStyle(run families(&["Noto Serif", "Noto Sans"], 16.0))
  run Testing.expect(system.keyInfo(after).face == 3, "a style made after the add uses it")
  let output = run layout(&mut system, after, 1000.0, "Hello")
  let mut faces = List<usize>.make()
  run runFaces(&system, &output, &mut faces)
  run Testing.expect(faces.length() > 0 && faces.get(0) == 3, "its glyphs come from the added face")
}

test effect fn addedFontsJoinAfterStart() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run addedFontsJoinAfterStartBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn declaredFacesLoadWhenTextNeedsThemBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let collection = run fonts()
  let mut system = TextSystem.make(&collection)
  let mut latin = run FaceRule.make(String.utf8Bytes("Brand"), Range.point(400.0))
  run latin.ranges.append(UnicodeRange { first: 0x20, last: 0x7E })
  let declared = run system.fonts.set.declare(move latin)
  let mut arabic = run FaceRule.make(String.utf8Bytes("Brand"), Range.point(400.0))
  run arabic.ranges.append(UnicodeRange { first: 0x600, last: 0x6FF })
  let unused = run system.fonts.set.declare(move arabic)
  let style = run system.addStyle(run families(&["Brand", "Noto Sans"], 16.0))
  run Testing.expect(system.keyInfo(style).face == 0, "while Brand loads, Noto Sans stands in")
  let mut wanted = List<usize>.make()
  run system.fonts.set.takeWanted(&mut wanted)
  run Testing.expect(wanted.length() == 0, "making a style loads nothing")

  let output = run layout(&mut system, style, 1000.0, "Hello")
  let mut faces = List<usize>.make()
  run runFaces(&system, &output, &mut faces)
  run Testing.expect(faces.length() > 0 && faces.get(0) == 0, "the fallback draws meanwhile")
  run system.fonts.set.takeWanted(&mut wanted)
  run Testing.expect(wanted.length() == 1 && wanted.get(0) == declared, "Latin text asks for the Latin face only")
  run Testing.expect(system.fonts.set.state(declared) == FaceState.Loading, "the face is loading")
  run Testing.expect(system.fonts.set.state(unused) == FaceState.Unloaded, "the Arabic face is not asked for")
  wanted.clear()
  drop run layout(&mut system, style, 1000.0, "Hello again")
  run system.fonts.set.takeWanted(&mut wanted)
  run Testing.expect(wanted.length() == 0, "a face is asked for once")

  run Testing.expect(run system.fonts.set.load(declared, run readFile(SERIF), 0), "the file reads")
  run Testing.expect(system.fonts.set.state(declared) == FaceState.Ready, "the face is ready")
  let swapped = run system.addStyle(run families(&["Brand", "Noto Sans"], 16.0))
  run Testing.expect(system.keyInfo(swapped).face == 3, "laid out again, text uses the loaded face")
  let again = run layout(&mut system, swapped, 1000.0, "Hello")
  faces.clear()
  run runFaces(&system, &again, &mut faces)
  run Testing.expect(faces.length() > 0 && faces.get(0) == 3, "its glyphs come from the loaded face")
}

test effect fn declaredFacesLoadWhenTextNeedsThem() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run declaredFacesLoadWhenTextNeedsThemBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unicodeRangeSplitsAFamilyBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let collection = run fonts()
  let mut system = TextSystem.make(&collection)
  // Both subsets of one family: capitals from Noto Serif, the rest from Noto Sans Bold.
  let mut capitals = run FaceRule.make(String.utf8Bytes("Split"), Range.point(400.0))
  run capitals.ranges.append(UnicodeRange { first: 0x41, last: 0x5A })
  let upper = run system.fonts.set.declare(move capitals)
  let mut rest = run FaceRule.make(String.utf8Bytes("Split"), Range.point(400.0))
  run rest.ranges.append(UnicodeRange { first: 0x20, last: 0x40 })
  run rest.ranges.append(UnicodeRange { first: 0x5B, last: 0x7E })
  let lower = run system.fonts.set.declare(move rest)
  run Testing.expect(run system.fonts.set.load(upper, run readFile(SERIF), 0), "capitals load")
  run Testing.expect(run system.fonts.set.load(lower, run readFile(BOLD), 0), "the rest loads")
  let style = run system.addStyle(run families(&["Split", "Noto Sans"], 16.0))
  run Testing.expect(system.keyInfo(style).face == 4, "the face that covers a space is the first available font")
  let output = run layout(&mut system, style, 1000.0, "Ab")
  let mut faces = List<usize>.make()
  run runFaces(&system, &output, &mut faces)
  let mut serif = false
  let mut bold = false
  let mut i: usize = 0
  while i < faces.length() {
    serif = serif || faces.get(i) == 3
    bold = bold || faces.get(i) == 4
    i = i + 1
  }
  run Testing.expect(serif && bold, "each character uses the subset whose range covers it")
  run Testing.expect(system.fonts.set.faceCount() == 5, "both subsets are in the set")
  run Testing.expect(!system.fonts.set.hasWanted(), "nothing else is asked for")
}

test effect fn unicodeRangeSplitsAFamily() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run unicodeRangeSplitsAFamilyBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The width of `output`'s text (the sum of its runs) and its line count.
effect fn extent(system: &TextSystem<'_>, output: &LayoutTree, lines: &mut usize) -> f32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = List<PlacedText>.make()
  let mut ys = List<f32>.make()
  run texts(&output, &mut found, &mut ys)
  let mut total: f32 = 0.0
  lines.* = 0
  let mut index: usize = 0
  while index < found.length() {
    total = total + system.glyphRun(found.get(index).shapeKey).advance
    if index == 0 || ys.get(index) > ys.get(index - 1) {
      lines.* = lines.* + 1
    }
    index = index + 1
  }
  return total
}

effect fn measure(system: &mut TextSystem<'_>, key: usize, width: f32, text: string, lines: &mut usize) -> f32
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError
  ? &mut Allocator {
  let output = run layout(&mut system, key, width, text)
  return run extent(&system, &output, &mut lines)
}

effect fn treated(treatment: Treatment) -> TextStyle
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut style = run sans(16.0)
  style.treatment = treatment
  return move style
}

effect fn textTreatmentsBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let collection = run fonts()
  let mut system = TextSystem.make(&collection)
  let plain = run system.addStyle(run sans(16.0))
  let mut spacing = Treatment.normal()
  spacing.letterSpacing = 2.0
  let lettered = run system.addStyle(run treated(spacing))
  spacing = Treatment.normal()
  spacing.wordSpacing = 10.0
  let worded = run system.addStyle(run treated(spacing))
  let mut lines: usize = 0
  let base = run measure(&mut system, plain, 1000.0, "ab cd", &mut lines)
  let wide = run measure(&mut system, lettered, 1000.0, "ab cd", &mut lines)
  run Testing.expect(near(wide, base + 10.0), "letter-spacing follows each of the five characters")
  let apart = run measure(&mut system, worded, 1000.0, "ab cd", &mut lines)
  run Testing.expect(near(apart, base + 10.0), "word-spacing widens the one space")

  spacing = Treatment.normal()
  spacing.transform = TextTransform.Uppercase
  let upper = run system.addStyle(run treated(spacing))
  let shouted = run measure(&mut system, upper, 1000.0, "abc", &mut lines)
  let capitals = run measure(&mut system, plain, 1000.0, "ABC", &mut lines)
  run Testing.expect(near(shouted, capitals), "uppercase shapes capitals")
  spacing.transform = TextTransform.Capitalize
  let titled = run system.addStyle(run treated(spacing))
  let capitalized = run measure(&mut system, titled, 1000.0, "ab cd", &mut lines)
  let written = run measure(&mut system, plain, 1000.0, "Ab Cd", &mut lines)
  run Testing.expect(near(capitalized, written), "capitalize raises the first letter of each word")

  // One long word in a narrow block.
  let word = "abcdefghijklmnopqrstuvwxyz"
  drop run measure(&mut system, plain, 60.0, word, &mut lines)
  run Testing.expect(lines == 1, "a word without break opportunities overflows")
  spacing = Treatment.normal()
  spacing.wordBreak = WordBreak.BreakAll
  let breakAll = run system.addStyle(run treated(spacing))
  drop run measure(&mut system, breakAll, 60.0, word, &mut lines)
  run Testing.expect(lines > 3, "break-all breaks between letters")
  spacing = Treatment.normal()
  spacing.overflowWrap = OverflowWrap.BreakWord
  let wrapping = run system.addStyle(run treated(spacing))
  drop run measure(&mut system, wrapping, 60.0, word, &mut lines)
  run Testing.expect(lines > 3, "overflow-wrap breaks the word that does not fit")
  drop run measure(&mut system, wrapping, 60.0, "ab cd ef", &mut lines)
  run Testing.expect(lines == 1, "and leaves words that fit alone")
}

test effect fn textTreatmentsSpaceTransformAndBreak() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run textTreatmentsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn activatedFacesBody() ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError ? &mut Allocator {
  let collection = run fonts()
  let mut system = TextSystem.make(&collection)
  let first = run system.fonts.set.declare(run FaceRule.make(String.utf8Bytes("Brand"), Range.point(400.0)))
  let second = run system.fonts.set.declare(run FaceRule.make(String.utf8Bytes("Brand"), Range.point(400.0)))
  run Testing.expect(run system.fonts.set.load(first, run readFile(SERIF),0), "first face loads")
  run Testing.expect(run system.fonts.set.load(second, run readFile(BOLD),0), "second face loads")
  let normal = run system.addStyle(run families(&["Brand", "Noto Sans"],16.0))
  run Testing.expect(system.keyInfo(normal).face == 4, "later face wins equal descriptors by default")
  drop system.fonts.set.setActive(second,false,1)
  let removed = run system.addStyle(run families(&["Brand", "Noto Sans"],16.0))
  run Testing.expect(system.keyInfo(removed).face == 3, "deactivating a rule reveals the earlier face")
  drop system.fonts.set.setActive(second,true,1)
  drop system.fonts.set.setActive(first,true,100)
  let reordered = run system.addStyle(run families(&["Brand", "Noto Sans"],16.0))
  run Testing.expect(system.keyInfo(reordered).face == 3, "explicit cascade order takes precedence over insertion order")
  let generation = system.fonts.set.generation
  run Testing.expect(!system.fonts.set.setActive(first,true,100) && system.fonts.set.generation == generation, "unchanged eligibility does not invalidate font matching")
  drop system.fonts.set.setActive(first,false,100)
  drop system.fonts.set.setActive(second,false,1)
  let fallback = run system.addStyle(run families(&["Brand", "Noto Sans"],16.0))
  run Testing.expect(!system.fonts.set.hasFamily(String.utf8Bytes("Brand")) && system.keyInfo(fallback).face == 0, "removing all faces restores the fallback family")
  drop system.fonts.set.setActive(first,true,100)
  let restored = run system.addStyle(run families(&["Brand", "Noto Sans"],16.0))
  run Testing.expect(system.keyInfo(restored).face == 3 && system.fonts.set.faceCount() == 5 && !system.fonts.set.hasWanted(), "reactivation reuses loaded bytes without another request")
  let pending = run system.fonts.set.declare(run FaceRule.make(String.utf8Bytes("Pending"), Range.point(400.0)))
  system.fonts.set.markFailed(pending)
  run Testing.expect(system.fonts.set.retry(pending) && system.fonts.set.state(pending) == FaceState.Loading, "an alternative source can retry a failed face")
  system.fonts.set.markFailed(pending)
  drop system.fonts.set.setActive(pending,false,0)
  run Testing.expect(!system.fonts.set.retry(pending), "inactive rules do not retry their sources")
}

test effect fn declaredFacesCanDeactivateReorderAndReuseLoadedData() ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run activatedFacesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Whether two layouts have the same text fragments with the same glyphs.
effect fn sameShaping(
  left: &TextSystem<'_>,
  leftOutput: &LayoutTree,
  right: &TextSystem<'_>,
  rightOutput: &LayoutTree,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut a = List<PlacedText>.make()
  let mut b = List<PlacedText>.make()
  let mut ys = List<f32>.make()
  let mut otherYs = List<f32>.make()
  run texts(leftOutput, &mut a, &mut ys)
  run texts(rightOutput, &mut b, &mut otherYs)
  if a.length() != b.length() || a.length() == 0 {
    return false
  }
  let mut index: usize = 0
  while index < a.length() {
    let one = a.get(index)
    let other = b.get(index)
    if one.sourceStart != other.sourceStart || one.sourceEnd != other.sourceEnd
      || ys.get(index) != otherYs.get(index) {
      return false
    }
    let glyphs = left.runGlyphs(one.shapeKey)
    let others = right.runGlyphs(other.shapeKey)
    if glyphs.length != others.length
      || left.glyphRun(one.shapeKey).face != right.glyphRun(other.shapeKey).face {
      return false
    }
    let mut at: usize = 0
    while at < glyphs.length {
      if glyphs[at].glyph != others[at].glyph || glyphs[at].cluster != others[at].cluster
        || glyphs[at].x != others[at].x
        || glyphs[at].y != others[at].y
        || glyphs[at].advance != others[at].advance {
        return false
      }
      at = at + 1
    }
    index = index + 1
  }
  return true
}

effect fn linesTakeTheGlyphsOfTheirParagraphBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let collection = run fonts()
  let mut taking = TextSystem.make(&collection)
  let mut shaping = TextSystem.make(&collection)
  shaping.shaping.reuse = false
  let key = run taking.addStyle(run sans(16.0))
  drop run shaping.addStyle(run sans(16.0))

  // Kerned pairs and ligatures across the line breaks, fallback faces, and a joining script.
  let paragraphs: [string; 4] = [
    "AVATAR Wave To: Yo. office affluent Tea, We AVA. Wave fjord Ty. AVATAR Wave To: Yo. office affluent Tea",
    "The quick brown fox \u{65e5}\u{672c}\u{8a9e}\u{306e}\u{6587}\u{7ae0} jumps over \u{0627}\u{0644}\u{0639}\u{0631}\u{0628}\u{064a}\u{0629} the lazy dog again and again",
    "\u{0647}\u{0630}\u{0627} \u{0646}\u{0635} \u{0639}\u{0631}\u{0628}\u{064a} \u{0637}\u{0648}\u{064a}\u{0644} \u{064a}\u{0644}\u{062a}\u{0641} \u{0639}\u{0644}\u{0649} \u{0639}\u{062f}\u{0629} \u{0623}\u{0633}\u{0637}\u{0631} \u{0641}\u{064a} \u{0627}\u{0644}\u{0635}\u{0641}\u{062d}\u{0629}",
    "\u{65e5}\u{672c}\u{8a9e}\u{306e}\u{6587}\u{7ae0}\u{306f}\u{5358}\u{8a9e}\u{306e}\u{9593}\u{306b}\u{7a7a}\u{767d}\u{304c}\u{306a}\u{304f}\u{3066}\u{3082}\u{6539}\u{884c}\u{3067}\u{304d}\u{307e}\u{3059}\u{3002}\u{65e5}\u{672c}\u{8a9e}\u{306e}\u{6587}\u{7ae0}",
  ]
  let mut index: usize = 0
  while index < paragraphs.length {
    let one = run layout(&mut taking, key, 150.0, paragraphs[index])
    let other = run layout(&mut shaping, key, 150.0, paragraphs[index])
    run Testing.expect(
      run sameShaping(&taking, &one, &shaping, &other),
      "lines cut from a shaped paragraph have the glyphs shaping them gives",
    )
    index = index + 1
  }
  run Testing.expect(taking.shaping.taken > 0, "lines took glyphs from their paragraph")
  run Testing.expect(
    taking.fonts.shaperCalls < shaping.fonts.shaperCalls,
    "taking glyphs saves shaper calls",
  )

  // Text that grows a word at a time, as a streamed answer does.
  let words: [string; 8] = ["Wave", "To:", "AVATAR", "office", "Yo.", "affluent", "Tea,", "fjord"]
  let mut text = String.make()
  let mut word: usize = 0
  while word < 40 {
    if word > 0 {
      run text.append(" ")
    }
    run text.append(words[(word * 5 + word / 3) % words.length])
    let one = run layout(&mut taking, key, 150.0, text.view())
    let other = run layout(&mut shaping, key, 150.0, text.view())
    run Testing.expect(
      run sameShaping(&taking, &one, &shaping, &other),
      "text that grew has the glyphs shaping all of it gives",
    )
    word = word + 1
  }
  run Testing.expect(taking.shaping.continued > 0, "appended text shaped only its end")
}

test effect fn linesTakeTheGlyphsOfTheirParagraph() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run linesTakeTheGlyphsOfTheirParagraphBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  /// Reads a font that macOS installs.
  effect fn systemFont(name: string) -> Bytes
    ! FileError | OutOfMemoryError
    ? &mut Allocator {
    let path = run Path.fromBytes(String.utf8Bytes(name))
    let mut files = run MachineFileSystem.make()
    return run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
  }

  // Faces shaped with Apple's tables (morx ligatures, kern pairs, a contextual subtable that
  // runs against the text in Geneva): lines and appended text take glyphs as other faces do.
  effect fn appleFacesTakeTheGlyphsOfTheirParagraphBody() -> ()
    ! AssertionError<'static>
      | FileError
      | HostInputError
      | OutOfMemoryError
      | InvalidNode
      | TextError
      | FragmentationError
    ? &mut Allocator {
    let mut collection = FontCollection.make()
    drop run collection.add(run systemFont("/System/Library/Fonts/Helvetica.ttc"))
    drop run collection.add(run systemFont("/System/Library/Fonts/Menlo.ttc"))
    drop run collection.add(run systemFont("/System/Library/Fonts/Geneva.ttf"))
    let names: [string; 3] = ["Helvetica", "Menlo", "Geneva"]
    let paragraphs: [string; 2] = [
      "AVATAR Wave To: Yo. office affluent Tea, We AVA. Wave fjord Ty. AVATAR Wave To: Yo. office affluent Tea",
      "The office staff shuffled offline files: fifty-five fluffy waffles, a baffling affidavit and an efficient coffee filter (v1.17.1).",
    ]
    let words: [string; 8] = ["Wave", "To:", "AVATAR", "office", "Yo.", "affluent", "Tea,", "fjord"]
    let mut name: usize = 0
    while name < names.length {
      let mut taking = TextSystem.make(&collection)
      let mut shaping = TextSystem.make(&collection)
      shaping.shaping.reuse = false
      let mut families = List<Family>.make()
      run families.append(run Family.named(String.utf8Bytes(names[name])))
      let key = run taking.addStyle(TextStyle.make(move families, 16.0))
      let mut others = List<Family>.make()
      run others.append(run Family.named(String.utf8Bytes(names[name])))
      drop run shaping.addStyle(TextStyle.make(move others, 16.0))
      let mut index: usize = 0
      while index < paragraphs.length {
        let one = run layout(&mut taking, key, 150.0, paragraphs[index])
        let other = run layout(&mut shaping, key, 150.0, paragraphs[index])
        run Testing.expect(
          run sameShaping(&taking, &one, &shaping, &other),
          "lines cut from a paragraph in an Apple face have the glyphs shaping them gives",
        )
        index = index + 1
      }
      run Testing.expect(taking.shaping.taken > 0, "lines in an Apple face took glyphs from their paragraph")
      run Testing.expect(
        taking.fonts.shaperCalls < shaping.fonts.shaperCalls,
        "taking glyphs saves shaper calls in an Apple face",
      )
      let mut text = String.make()
      let mut word: usize = 0
      while word < 40 {
        if word > 0 {
          run text.append(" ")
        }
        run text.append(words[(word * 5 + word / 3) % words.length])
        let one = run layout(&mut taking, key, 150.0, text.view())
        let other = run layout(&mut shaping, key, 150.0, text.view())
        run Testing.expect(
          run sameShaping(&taking, &one, &shaping, &other),
          "text that grew in an Apple face has the glyphs shaping all of it gives",
        )
        word = word + 1
      }
      // Geneva's backwards subtable makes every text lean on what follows its start, so its
      // appended text is shaped whole.
      if name < 2 {
        run Testing.expect(taking.shaping.continued > 0, "appended text in an Apple face shaped only its end")
      }
      name = name + 1
    }
  }

  test effect fn appleFacesTakeTheGlyphsOfTheirParagraph() -> ()
    ! AssertionError<'static>
      | FileError
      | HostInputError
      | OutOfMemoryError
      | InvalidNode
      | TextError
      | FragmentationError {
    let mut allocator = Allocator.systemAllocatorProvider()
    run appleFacesTakeTheGlyphsOfTheirParagraphBody() |> Effect.provideMut<Allocator>(&mut allocator)
  }
}
