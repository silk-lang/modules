/// libuv's uv_udp_bind.
pub export "C" fn uv_udp_bind(udp: *mut u8, address: *const u8, flags: u32) -> i32 {
  if unsafe kindOf(udp) != UV_UDP { return -EINVAL }
  let length = unsafe inetLength(address)
