import silk.num.u32

effect fn matches(tree: &UiTree<'_>, id: u32, selector: &[u8]) -> bool
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let buffer = run lexer.tokenize(selector, &Limits.make())
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &Limits.make())
  if let Option<SelectorList>.Some { value } = move parsed {
    let mut context = MatchContext.make(u32.toUsize(tree.root), NO_ELEMENT)
    let adapter = SelectorTree { tree: tree }
    return (run selectors.matchElement(&value, &buffer, &adapter, u32.toUsize(tree.slotOf(id)), &mut context)).isSome()
  }
  return false
}

effect fn identityAndLinks() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.text(1, 3, "  \n")
  run batch.create(4, NodeKind.Box)
  run batch.append(1, 4)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("group dark") })
  run batch.attribute(2, Attribute.Element { name: run String.copy("button") })
  run batch.attribute(2, Attribute.ElementId { value: run String.copy("save") })
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("button\tprimary button") })
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("primary button") })
  run tree.apply(run batch.take())
  run Testing.expect(run matches(&tree, 2, b".dark > button#save.button.primary:first-child"), "native tag, class and id participate in selectors")
  run Testing.expect(run matches(&tree, 4, b"#save + .button:nth-child(2):last-child"), "element sibling links skip text nodes")
  run Testing.expect(run matches(&tree, 1, b":root:has(> #save)"), "root and relational selectors see retained element links")
  run Testing.expect(run matches(&tree, 2, b"[id=save][class~=primary]:empty"), "identity is also exposed as attributes")
  let first = tree.node(tree.slotOf(2)).identity()
  let second = tree.node(tree.slotOf(4)).identity()
  if let Option<&NodeIdentity>.Some { value: a } = first {
    if let Option<&NodeIdentity>.Some { value: b } = second {
      run Testing.expect(a.classAtoms().length == 2 && b.classAtoms().length == 2
        && a.classAtoms()[0] == b.classAtoms()[0] && a.classAtoms()[1] == b.classAtoms()[1], "class atoms ignore ordering and duplicate tokens")
    }
  }
  let savedSlot = tree.slotOf(2)
  let saved = tree.nodeMut(savedSlot)
  saved.styleDirty = false
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("changed") })
  run tree.apply(run batch.take())
  let oldClass = run matches(&tree, 2, b".primary")
  let newClass = run matches(&tree, 2, b".changed")
  run Testing.expect(!oldClass && newClass, "class replacement does not keep stale tokens")
  run Testing.expect(tree.node(tree.slotOf(2)).styleDirty, "identity mutation marks node for restyling")
  run batch.text(2, 5, " ")
  run tree.apply(run batch.take())
  run Testing.expect(!(run matches(&tree, 2, b":empty")), "whitespace text prevents :empty, matching Chromium")
}

test effect fn selectorIdentityAndElementLinks() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run identityAndLinks() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stateChanges() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Input)
  run batch.append(1, 2)
  // Input kind supplies the default tag without an explicit Element mutation.
  run batch.attribute(2, Attribute.Placeholder { value: run String.copy("Name") })
  run batch.attribute(2, Attribute.Required { value: true })
  run batch.attribute(2, Attribute.Checked { value: true })
  run batch.attribute(2, Attribute.Indeterminate { value: true })
  run tree.apply(run batch.take())
  let slot = tree.slotOf(2)
  tree.focused = slot
  tree.focusVisible = true
  let input = tree.nodeMut(slot)
  input.hovered = true
  input.pressed = true
  run Testing.expect(run matches(&tree, 2, b"input:hover:active:focus:focus-visible:enabled:required:checked:indeterminate:placeholder-shown:read-write"), "selectors read live input and interaction state")
  run Testing.expect(run matches(&tree, 1, b":focus-within"), "focus-within follows ancestors")
  run batch.attribute(2, Attribute.Disabled { value: true })
  run batch.attribute(2, Attribute.ReadOnly { value: true })
  run tree.apply(run batch.take())
  run Testing.expect(run matches(&tree, 2, b":disabled:read-only:not(:enabled):not(:read-write)"), "state changes do not require reparsing selectors")
}

test effect fn selectorStateTracksNativeInput() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run stateChanges() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn attributes() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(1, Attribute.Named { name: run String.copy("lang"), value: Option<String>.some(run String.copy("fr-CA")) })
  run batch.attribute(2, Attribute.Named { name: run String.copy("data-state"), value: Option<String>.some(run String.copy("open")) })
  run batch.attribute(2, Attribute.Named { name: run String.copy("data-empty"), value: Option<String>.some(String.make()) })
  run batch.attribute(2, Attribute.Named { name: run String.copy("aria-expanded"), value: Option<String>.some(run String.copy("false")) })
  run batch.attribute(2, Attribute.Named { name: run String.copy("aria-checked"), value: Option<String>.some(run String.copy("mixed")) })
  run tree.apply(run batch.take())
  run Testing.expect(run matches(&tree, 2, b"[data-state=open][data-empty=''][aria-expanded=false][aria-checked=mixed]:lang(fr)"), "literal data and aria attributes, including empty and false, participate in selectors")
  run Testing.expect(run matches(&tree, 2, b":indeterminate:not(:checked)"), "literal ARIA checked updates native accessibility state")
  run batch.attribute(2, Attribute.Named { name: run String.copy("data-state"), value: Option<String>.some(run String.copy("closed")) })
  run batch.attribute(2, Attribute.Named { name: run String.copy("data-empty"), value: Option<String>.None })
  run batch.attribute(2, Attribute.Named { name: run String.copy("aria-checked"), value: Option<String>.None })
  run batch.attribute(2, Attribute.Named { name: run String.copy("class"), value: Option<String>.some(run String.copy("temporary")) })
  run batch.attribute(2, Attribute.Named { name: run String.copy("class"), value: Option<String>.None })
  run batch.attribute(2, Attribute.Named { name: run String.copy("id"), value: Option<String>.some(String.make()) })
  run batch.attribute(2, Attribute.Named { name: run String.copy("id"), value: Option<String>.None })
  run batch.attribute(2, Attribute.Expanded { value: true })
  run batch.attribute(2, Attribute.Required { value: false })
  run batch.attribute(2, Attribute.Element { name: run String.copy("a") })
  run batch.attribute(2, Attribute.Href { value: run String.copy("/guide") })
  run tree.apply(run batch.take())
  run Testing.expect(run matches(&tree, 2, b"[data-state=closed]:not([class]):not([id]):not([data-empty]):not([aria-checked]):not(:indeterminate)[aria-expanded=true][aria-required=false]:link"), "replacement, removal and typed attributes stay synchronized")
}

test effect fn selectorsReadNamedAndTypedAttributes() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run attributes() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.legacy { FrameInput }
import svg_css.compile { Options, CompileError }
import svg_css.compile
import svg_css.written
import ui_tree.style { Fill }
import silk.collections.bytes { Bytes }

effect fn sheetBytes(source: &[u8]) -> Bytes
  ! CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let sheet = run compile.compile(source, &Options.make())
  return run sheet.encode()
}

effect fn nativeCascade() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("parent") })
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("button") })
  let inline = run written.declarations(b"width:50px;height:40px;margin-right:calc(var(--gap) * 2);color:blue")
  run batch.style(2, inline.asSlice())
  let initial = run sheetBytes(b"@layer base, utilities; .parent{--gap:8px} .button{background-color:color-mix(in srgb,currentcolor 50%,transparent)} @layer base {.button {width:10px!important}} @layer utilities {.button {width:20px!important;height:30px;margin-left:var(--gap)}} @media(width >= 600px){.button{height:60px!important}}")
  run batch.adoptStyleSheet(0, 7, initial.asSlice())
  run tree.apply(run batch.take())
  let narrow = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(narrow)
  let child = tree.slotOf(2)
  run Testing.expect(tree.node(child).computed().layout.width.value == 10.0, "important first layer beats inline width")
  run Testing.expect(tree.node(child).computed().layout.height.value == 40.0, "inline height beats normal sheet declarations")
  run Testing.expect(tree.node(child).computed().layout.margin.left.value == 8.0, "inherited variables reach native computed lengths")
  run Testing.expect(tree.node(child).computed().layout.margin.right.value == 16.0, "inline calc reads a custom property inherited from a sheet")
  run Testing.expect(match tree.node(child).computed().paint.background {
    Fill.Solid { color } => color.b == 1.0 && color.r == 0.0 && color.a == 0.5
    _ => false
  }, "compiled color-mix sees the final inline foreground")
  run tree.frame(FrameInput { width: 800.0, height: 300.0, scale: 1.0, time: 1.0 })
  run Testing.expect(tree.node(child).computed().layout.height.value == 60.0, "media eligibility responds to the root viewport")
  let replacement = run sheetBytes(b".button{width:25px!important;height:70px!important}")
  run batch.replaceStyleSheet(0, 7, replacement.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(narrow)
  run Testing.expect(tree.node(child).computed().layout.width.value == 25.0 && tree.node(child).computed().layout.height.value == 70.0, "replacement changes computed values on the next frame")
  run batch.removeStyleSheet(0, 7)
  run tree.apply(run batch.take())
  run tree.frame(narrow)
  run Testing.expect(tree.node(child).computed().layout.width.value == 50.0 && tree.node(child).computed().layout.height.value == 40.0, "removal restores inline values and clears the sheet cache")
}

test effect fn compiledSheetsDriveNativeCascadeVariablesAndMedia() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nativeCascade() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.lib { RootOptions }
import silk.core.result { Result }

effect fn sheetsAreRootScoped() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.openRoot(1, 2, RootOptions.default())
  let first = run sheetBytes(b"div{height:25px}")
  let second = run sheetBytes(b"div{height:75px}")
  run batch.adoptStyleSheet(0, 1, first.asSlice())
  run batch.adoptStyleSheet(1, 1, second.asSlice())
  run tree.apply(run batch.take())
  let viewport = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frameRoot(0, viewport)
  run tree.frameRoot(1, viewport)
  run Testing.expect(tree.node(tree.slotOf(1)).computed().layout.height.value == 25.0 && tree.node(tree.slotOf(2)).computed().layout.height.value == 75.0, "sheet ids and rules are isolated per root")
  run batch.replaceStyleSheet(1, 1, b"not a compiled stylesheet")
  let rejected = run Effect.result(tree.apply(run batch.take()))
  run Testing.expect(match &rejected {
    Result<(), TreeError | OutOfMemoryError>.Failure { error: why } => match &why { TreeError.StyleSheet { root, sheet, .. } => root == 1 && sheet == 1 _ => false }
    _ => false
  }, "invalid compiled bytes report the root and sheet")
  run tree.frameRoot(1, viewport)
  run Testing.expect(tree.node(tree.slotOf(2)).computed().layout.height.value == 75.0, "failed replacement preserves the existing sheet")
  run batch.closeRoot(1)
  run tree.apply(run batch.take())
  run Testing.expect(tree.styleSheets.length() == 1 && tree.styleSheets.asSlice()[0].root == 0, "closing a root releases only its sheets")
}

test effect fn compiledSheetsAreIsolatedAndInvalidReplacementPreservesStyle() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sheetsAreRootScoped() |> Effect.provideMut<Allocator>(&mut allocator)
}

import svg_css.media_features { Environment, ColorScheme, Pointer }
import svg_css.colors { Color, SystemColor, systemIndex }

effect fn environmentAndInvalidation() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  let bytes = run sheetBytes(b"div{height:10px;width:10px} :root:has(>.active){height:90px} .active+div{width:33px} @media(prefers-color-scheme:dark) and (hover:hover){.active{color:color-mix(in srgb,CanvasText 50%,transparent)}}")
  run batch.adoptStyleSheet(0, 2, bytes.asSlice())
  run tree.apply(run batch.take())
  let viewport = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(viewport)
  let mut environment = Environment.headless(400.0, 300.0)
  environment.colorScheme = ColorScheme.Dark
  environment.pointer = Pointer.Fine
  environment.hover = true
  let mut palette = [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]
  palette[systemIndex(SystemColor.CanvasText)] = Color.srgb(1.0, 0.0, 0.0, 1.0)
  run tree.setStyleEnvironment(0, environment, palette)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("active") })
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  run Testing.expect(tree.node(tree.slotOf(1)).computed().layout.height.value == 90.0, "class changes invalidate ancestors for :has")
  run Testing.expect(tree.node(tree.slotOf(3)).computed().layout.width.value == 33.0, "class changes invalidate following siblings")
  let foreground = tree.node(tree.slotOf(2)).computed().text.color
  run Testing.expect(foreground.r == 1.0 && foreground.g == 0.0 && foreground.a == 0.5, "host media preferences and system colors reach the value pipeline")
  run batch.attribute(2, Attribute.ClassName { value: String.make() })
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  run Testing.expect(tree.node(tree.slotOf(1)).computed().layout.height.value == 10.0 && tree.node(tree.slotOf(3)).computed().layout.width.value == 10.0, "removing a matching class clears ancestor and sibling styles")
}

test effect fn compiledSheetsUseHostEnvironmentAndRelationalInvalidation() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run environmentAndInvalidation() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.mutation { StyleState }

effect fn nativeInlineVariables() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("parent") })
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("child") })
  run batch.customProperty(1, StyleState.Base, "--gap", Option<string>.some("5px"), false)
  let inline = run written.declarations(b"width:var(--gap,3px)")
  run batch.style(2, inline.asSlice())
  run tree.apply(run batch.take())
  let viewport = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(viewport)
  run Testing.expect(tree.node(tree.slotOf(2)).computed().layout.width.value == 5.0, "style-object variables work without an adopted sheet")
  let first = run sheetBytes(b".parent{--gap:8px!important}.child{height:calc(var(--gap)*2)}")
  run batch.adoptStyleSheet(0, 1, first.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  run Testing.expect(tree.node(tree.slotOf(2)).computed().layout.width.value == 8.0 && tree.node(tree.slotOf(2)).computed().layout.height.value == 16.0, "inline and sheet values read one inherited scope")
  run batch.customProperty(1, StyleState.Base, "--gap", Option<string>.some("12px"), true)
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  run Testing.expect(tree.node(tree.slotOf(2)).computed().layout.width.value == 12.0 && tree.node(tree.slotOf(2)).computed().layout.height.value == 24.0, "important inline custom properties beat sheet declarations")
  run batch.customProperty(1, StyleState.Base, "--gap", Option<string>.some("4px; color:red"), true)
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  run Testing.expect(tree.node(tree.slotOf(2)).computed().layout.width.value == 12.0, "invalid custom-property syntax preserves the previous declaration")
  let second = run sheetBytes(b".child{height:40px}")
  run batch.adoptStyleSheet(0, 2, second.asSlice())
  run batch.styleSheetOrder(0, &[2, 1])
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  run Testing.expect(tree.node(tree.slotOf(2)).computed().layout.height.value == 24.0, "protocol reordering changes the winning sheet")
  run batch.removeStyleSheet(0, 1)
  run batch.removeStyleSheet(0, 2)
  run batch.customProperty(1, StyleState.Base, "--gap", Option<string<'static>>.None, false)
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  run Testing.expect(tree.node(tree.slotOf(2)).computed().layout.width.value == 3.0, "removing an inline custom property exposes the var fallback")
}

test effect fn inlineCustomPropertiesAndSheetsUseOneNativeScope() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nativeInlineVariables() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nativeWideCascade() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("parent") })
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("child") })
  let bytes = run sheetBytes(b"@layer base, utilities; .parent{font-size:20px;width:2em;margin-left:12px;color:red;translate:2em;filter:blur(2em);border:color-mix(in srgb,red 50%,blue)} @layer base{.child{height:17px;padding:3px 4px}} @layer utilities{.child{height:30px;height:revert-layer;padding:8px;padding-left:revert-layer}} .child{font-size:10px;width:inherit;margin:9px;margin:var(--missing);margin-left:inherit;color:initial;background-color:currentcolor;translate:inherit;filter:inherit}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let viewport = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(viewport)
  run Testing.expect(tree.node(tree.slotOf(1)).computed().paint.border.left == 3.0, "color-expression projection leaves the border width component intact")
  let c = &tree.node(tree.slotOf(2)).computed().*
  run Testing.expect(c.layout.width.value == 40.0 && c.text.size == 10.0, "inherit copies the computed parent width without re-evaluating em in the child")
  run Testing.expect(c.transform.translate.x == 40.0, "transform inheritance copies resolved lengths")
  let filter = match &tree.node(tree.slotOf(2)).paintEffects() {
    Option<&Effects>.Some { value } => {
      value.filters.length() == 1 && match &value.filters.asSlice()[0] {
        Filter.Function { amount, .. } => value.number(amount) == 40.0
        _ => false
      }
    }
    _ => false
  }
  run Testing.expect(filter, "effect inheritance freezes relative lengths against the defining parent")
  run Testing.expect(c.layout.height.value == 17.0, "native revert-layer reveals the earlier layer")
  run Testing.expect(c.layout.padding.left.value == 4.0 && c.layout.padding.top.value == 8.0, "a longhand rollback excludes its layer's shorthand component only")
  run Testing.expect(c.layout.margin.top.value == 0.0 && c.layout.margin.left.value == 12.0, "invalid variable shorthand unsets all longhands without reviving earlier values")
  run Testing.expect(c.text.color.r == 0.0 && c.text.color.b == 0.0, "initial color overrides inherited red")
  run Testing.expect(match c.paint.background { Fill.Solid { color } => color.r == 0.0 && color.b == 0.0 _ => false }, "currentColor observes the final defaulted foreground")
  let inline = run written.declarations(b"height:revert-layer!important;color:unset;border:inherit;font:initial")
  run batch.style(2, inline.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  let updated = &tree.node(tree.slotOf(2)).computed().*
  run Testing.expect(updated.layout.height.value == 17.0, "inline rollback leaves stylesheet rules available")
  run Testing.expect(updated.text.color.r == 1.0 && updated.text.color.b == 0.0, "unset inherits inherited properties")
  run Testing.expect(updated.text.size == 16.0, "style-object wide font shorthand survives preparation and resets every longhand")
}

test effect fn nativeWideValuesRespectLonghandWinnersAndComputedInheritance() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nativeWideCascade() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.paint_css { Effects }
import svg_css.effect_values { Filter }

effect fn inlineWideWithoutSheets() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  let parent = run written.declarations(b"font-size:20px;width:2em;color:red;vertical-align:middle;direction:rtl;margin-right:7px")
  let child = run written.declarations(b"font:initial;width:inherit;color:unset;padding:9px;padding:unset;vertical-align:inherit;direction:ltr;margin-inline-start:inherit")
  run batch.style(1, parent.asSlice())
  run batch.style(2, child.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 })
  let c = &tree.node(tree.slotOf(2)).computed().*
  run Testing.expect(c.layout.width.value == 40.0 && c.text.size == 16.0 && c.text.color.r == 1.0 && c.layout.padding.top.value == 0.0, "style-object wide values use the same defaults and computed inheritance without sheets")
  run Testing.expect(c.layout.verticalAlign.kind == VerticalAlignKind.Middle && c.layout.margin.left.value == 7.0, "compound and logical inheritance read the parent in its own writing direction")
  run batch.customProperty(1, StyleState.Base, "--font", Option<string>.some("italic 22px serif"), false)
  let variable = run written.declarations(b"font:var(--font);border-color:initial;color:blue")
  run batch.style(2, variable.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 })
  run Testing.expect(tree.node(tree.slotOf(2)).computed().text.size == 22.0, "deferred font shorthand survives style-object preparation before substitution")
  run Testing.expect(tree.node(tree.slotOf(2)).computed().paint.borderColor.b == 1.0 && tree.node(tree.slotOf(2)).computed().paint.borderColor.r == 0.0, "initial currentColor paint sees a foreground declared later")
}

test effect fn styleObjectWideValuesUseTheCascadeWithoutSheets() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inlineWideWithoutSheets() |> Effect.provideMut<Allocator>(&mut allocator)
}

import properties.computed { VerticalAlignKind }

effect fn inlineCurrentColor() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  let styles = run written.declarations(b"background-color:currentcolor;border:2px solid currentcolor;color:red")
  run batch.style(1, styles.asSlice())
  let inherited = run written.declarations(b"background-color:currentcolor")
  run batch.style(2, inherited.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 })
  let first = &tree.node(tree.slotOf(1)).computed().*
  run Testing.expect(first.paint.borderColor.r == 1.0 && first.paint.borderColor.b == 0.0,
    "a style-object border shorthand resolves currentColor without an adopted sheet")
  run Testing.expect(match first.paint.background { Fill.Solid { color } => color.r == 1.0 && color.b == 0.0 _ => false },
    "currentColor sees a foreground written later in the same style object")
  let update = run written.declarations(b"color:blue")
  run batch.style(1, update.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 })
  let second = &tree.node(tree.slotOf(2)).computed().*
  run Testing.expect(match second.paint.background { Fill.Solid { color } => color.r == 0.0 && color.b == 1.0 _ => false },
    "inherited foreground changes invalidate a child's currentColor paint")
  let mut implicitTree = run UiTree.make(&fonts)
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let implicit = run written.declarations(b"border:2px solid;color:blue")
  run batch.style(1, implicit.asSlice())
  run implicitTree.apply(run batch.take())
  run implicitTree.frame(FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 })
  run Testing.expect(implicitTree.node(implicitTree.slotOf(1)).computed().paint.borderColor.b == 1.0,
    "an omitted shorthand border color also resolves against the foreground")
}

test effect fn styleObjectCurrentColorUsesComputedForegroundWithoutSheets() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inlineCurrentColor() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.style_assets { StyleAssets }
import ui_tree.style_media { Preferences }

effect fn hostMediaPreferences() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  drop tree.setStylePreferences(Preferences.desktop(true))
  run Testing.expect(tree.styleSheets.length() == 0, "host preferences allocate no stylesheet state in an unstyled app")
  let source = run sheetBytes(b"div{width:10px;height:10px}@media(hover:hover) and (pointer:fine){div{width:20px}}@media(prefers-color-scheme:dark){div{height:30px}}@media(prefers-reduced-motion:reduce){div{padding:7px}}@media(any-pointer:coarse){div{margin:5px}}@media(forced-colors:active){div{height:60px}}")
  let fixed = run sheetBytes(b"div{width:33px;height:12px}")
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.openRoot(1, 2, RootOptions.default())
  run batch.adoptStyleSheet(0, 1, source.asSlice())
  run batch.adoptStyleSheet(1, 1, fixed.asSlice())
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frameRoot(0, frame)
  run tree.frameRoot(1, frame)
  let initial = &tree.node(tree.slotOf(1)).computed().*
  run Testing.expect(initial.layout.width.value == 20.0 && initial.layout.height.value == 30.0,
    "the first adopted sheet sees the host's hover, pointer and dark appearance")
  run Testing.expect(!tree.setStylePreferences(Preferences.desktop(true)), "identical host preferences do not request a frame")
  run tree.frameRoot(0, frame)
  run Testing.expect(tree.stats.layoutSkipped, "unchanged media preferences retain cached layout")
  drop tree.setStylePreferences(Preferences.fromBits(299))
  run tree.frameRoot(0, frame)
  let changed = &tree.node(tree.slotOf(1)).computed().*
  run Testing.expect(changed.layout.width.value == 10.0 && changed.layout.padding.top.value == 7.0
    && changed.layout.margin.left.value == 5.0 && changed.layout.height.value == 60.0, "coarse pointer, reduced motion and forced colors replace the active media rules")
  run tree.frameRoot(1, frame)
  run Testing.expect(tree.stats.layoutSkipped, "a root without changed conditions is not restyled")
  run batch.create(3, NodeKind.Box)
  run batch.openRoot(2, 3, RootOptions.default())
  run batch.adoptStyleSheet(2, 1, source.asSlice())
  run tree.apply(run batch.take())
  run tree.frameRoot(2, frame)
  run Testing.expect(tree.node(tree.slotOf(3)).computed().layout.padding.top.value == 7.0,
    "roots opened after a preference change inherit current host media inputs")
}

test effect fn stylesheetMediaTracksHostPreferencesAcrossRoots() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hostMediaPreferences() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn compiledAssetsBeforeLayout() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let first = run sheetBytes(b"div{width:10px}")
  let second = run sheetBytes(b"div{width:20px}")
  let mut assets = run StyleAssets.from(&[first.asSlice(), second.asSlice()])
  run Testing.expect(!run assets.serve(&mut tree, 0), "compiled assets wait until the application opens its root")
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.openRoot(1, 2, RootOptions.default())
  run tree.apply(run batch.take())
  run Testing.expect(run assets.serve(&mut tree, 0), "the first client layout adopts its sheets")
  run Testing.expect(tree.styleSheets.length() == 1, "adoption does not affect another client's root")
  let viewport = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frameRoot(0, viewport)
  run Testing.expect(tree.node(tree.slotOf(1)).computed().layout.width.value == 20.0, "the first frame sees application sheets in declared order")
  run Testing.expect(!run assets.serve(&mut tree, 0), "unchanged assets do not readopt")
  let constructed = run sheetBytes(b"div{width:40px}")
  run batch.adoptStyleSheet(1, 55, constructed.asSlice())
  run tree.apply(run batch.take())
  drop run assets.serve(&mut tree, 1)
  run tree.frameRoot(1, viewport)
  run Testing.expect(tree.node(tree.slotOf(2)).computed().layout.width.value == 40.0, "build assets precede sheets adopted by the application before its first layout")
  let replacement = run sheetBytes(b"div{width:30px}")
  drop run assets.replace(1, replacement.asSlice())
  drop run assets.serve(&mut tree, 0)
  run tree.frameRoot(0, viewport)
  run Testing.expect(tree.node(tree.slotOf(1)).computed().layout.width.value == 30.0, "asset replacement uses the existing sheet position")
  run batch.closeRoot(1)
  run batch.create(3, NodeKind.Box)
  run batch.openRoot(1, 3, RootOptions.default())
  run tree.apply(run batch.take())
  drop run assets.serve(&mut tree, 1)
  run tree.frameRoot(1, viewport)
  run Testing.expect(tree.node(tree.slotOf(3)).computed().layout.width.value == 30.0, "closing and reopening a root in one batch installs fresh assets")
}

test effect fn compiledAssetsAdoptBeforeFirstFrameAndRemainRootScoped() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run compiledAssetsBeforeLayout() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn motionFrame(time: f64) -> FrameInput {
  return FrameInput { width: 800.0, height: 300.0, scale: 1.0, time: time }
}

fn closeTo(a: f32, b: f32) -> bool { return a - b < 0.001 && b - a < 0.001 }

effect fn sheetStartingStyles() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("parent") })
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("child") })
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("inherited") })
  let bytes = run sheetBytes(b".parent{--size:100px;--entry-color:red;color:blue}.child{width:var(--size);height:10px;opacity:1;transition:opacity 1s linear,width 1s linear,color 1s linear}.inherited{width:var(--size);transition:width 1s linear,color 1s linear}@media(width>600px){@starting-style{.parent{--size:20px;--entry-color:green;color:red}.child{opacity:0;width:calc(var(--size)/5);color:var(--entry-color)}}}.hidden{display:none}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(0.0))
  let child = tree.slotOf(2)
  run Testing.expect(closeTo(tree.node(tree.slotOf(3)).computed().layout.width.value, 100.0)
    && closeTo(tree.node(tree.slotOf(3)).computed().text.color.b, 1.0), "children inherit after-change values, not their parent's starting values")
  run Testing.expect(closeTo(tree.node(child).computed().paint.opacity, 0.0), "a compiled starting rule begins the first visible transition")
  run Testing.expect(closeTo(tree.node(child).computed().layout.width.value, 20.0), "starting values use variables from the parent's after-change scope")
  run Testing.expect(closeTo(tree.node(child).computed().text.color.r, 1.0), "starting colors use variables from the parent's after-change scope")
  run tree.frame(motionFrame(0.5))
  run Testing.expect(closeTo(tree.node(child).computed().paint.opacity, 0.5) && closeTo(tree.node(child).computed().layout.width.value, 60.0), "starting values interpolate toward the normal cascade")
  run tree.frame(motionFrame(1.0))
  run Testing.expect(closeTo(tree.node(child).computed().paint.opacity, 1.0) && closeTo(tree.node(child).computed().layout.width.value, 100.0), "starting variables do not leak into the normal cascade")
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("child changed") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(2.0))
  run Testing.expect(closeTo(tree.node(child).computed().paint.opacity, 1.0), "restyling a visible node does not replay its starting style")
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("child hidden") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(3.0))
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("child") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(4.0))
  run Testing.expect(closeTo(tree.node(child).computed().paint.opacity, 0.0), "showing a hidden node uses its starting style again")
  run Testing.expect(closeTo(tree.node(child).computed().layout.width.value, 20.0), "a newly shown child resolves its starting width against the parent's after-change scope")
}

test effect fn compiledStartingStylesUseTheCascadeAndAfterChangeInheritance() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sheetStartingStyles() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn startingPriority() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  let inline = run written.declarations(b"opacity:.8")
  run batch.style(2, inline.asSlice())
  let bytes = run sheetBytes(b"div{transition:opacity 1s linear}@starting-style{div{opacity:0}}@media(width<600px){@starting-style{div{opacity:.5!important}}}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(0.0))
  run Testing.expect(closeTo(tree.node(tree.slotOf(2)).computed().paint.opacity, 0.8), "normal inline declarations beat sheet starting declarations")
  run Testing.expect(closeTo(tree.node(tree.slotOf(3)).computed().paint.opacity, 0.0), "a false media condition does not contribute to starting styles")
}

test effect fn compiledStartingStylesRespectInlinePriorityAndMedia() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run startingPriority() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn repeatedCascadeInputs() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  let blue = run written.declarations(b"color:blue")
  let red = run written.declarations(b"color:red")
  run batch.style(2, blue.asSlice())
  run batch.style(3, red.asSlice())
  let mut id: u32 = 4
  while id < 22 {
    run batch.create(id, NodeKind.Box)
    run batch.append(if id == 21 { 3 } else { 2 }, id)
    run batch.attribute(id, Attribute.ClassName { value: run String.copy("row override") })
    id = id + 1
  }
  run batch.attribute(4, Attribute.ElementId { value: run String.copy("strong") })
  let forty = run written.declarations(b"width:40px")
  let fifty = run written.declarations(b"width:50px")
  run batch.style(5, forty.asSlice())
  run batch.style(6, fifty.asSlice())
  run batch.style(7, forty.asSlice())
  let source = b"@property --unit{syntax:'<length>';inherits:false;initial-value:10px}.row{--unit:10px}:root{--height:12px}:root.theme{--height:24px}#strong,.row{width:var(--unit);height:var(--height);background:currentColor}.override{width:30px}"
  let bytes = run sheetBytes(source)
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(0.0))
  let mut shared = false
  if let Option.Some { value: first } = tree.node(tree.slotOf(5)).sheetStyle() {
    if let Option.Some { value: second } = tree.node(tree.slotOf(7)).sheetStyle() { shared = first.scope.index == second.scope.index }
  }
  run Testing.expect(shared, "registered custom-property scopes are shared by repeated sibling inputs")
  id = 4
  while id < 22 {
    let expected: f32 = if id == 4 { 10.0 } else if id == 5 || id == 7 { 40.0 } else if id == 6 { 50.0 } else { 30.0 }
    let node = tree.node(tree.slotOf(id))
    run Testing.expect(node.computed().layout.width.value == expected, "repeated rule lists retain selector-list specificity and distinct inline values")
    run Testing.expect(node.computed().layout.height.value == 12.0, "repeated rows share their parent's variable values")
    let background: f32 = match node.computed().paint.background { Fill.Solid { color } => color.r _ => -1.0 }
    let expectedColor: f32 = if id == 21 { 1.0 } else { 0.0 }
    run Testing.expect(background == expectedColor, "currentColor comes from the matching parent")
    id = id + 1
  }
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("theme") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(1.0))
  run Testing.expect(tree.node(tree.slotOf(8)).computed().layout.height.value == 24.0, "a new pass cannot reuse results from a previous variable scope generation")
  let replacement = run sheetBytes(b":root{--height:13px}#strong,.row{width:11px;height:var(--height);background:currentColor}.override{width:31px}")
  run batch.replaceStyleSheet(0, 1, replacement.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(2.0))
  run Testing.expect(tree.node(tree.slotOf(8)).computed().layout.height.value == 13.0
    && tree.node(tree.slotOf(8)).computed().layout.width.value == 31.0, "sheet replacement invalidates results even when rule indices are reused")
}

test effect fn stylesheetSharingPreservesCascadeInputsAndInvalidatesAcrossPasses() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run repeatedCascadeInputs() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn blurAmount(tree: &UiTree<'_>, id: u32) -> f32 {
  if let Option.Some { value } = tree.node(tree.slotOf(id)).paintEffects() {
    if value.filters.length() == 1 {
      if let Filter.Function { amount, .. } = &value.filters.asSlice()[0] { return value.number(amount) }
    }
  }
  return 0.0
}

fn redShadow(tree: &UiTree<'_>, id: u32, offset: f32) -> bool {
  if let Option.Some { value } = tree.node(tree.slotOf(id)).paintEffects() {
    if value.shadows.length() == 1 {
      let shadow = value.shadows.asSlice()[0]
      return shadow.x == offset && shadow.color.r == 1.0 && shadow.color.b == 0.0
    }
  }
  return false
}

effect fn paintOverrideParity(sheet: bool, inherited: bool) -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  if sheet {
    let bytes = run sheetBytes(b":root{font-size:20px;color:red;filter:blur(1em);text-shadow:1em 0 currentColor}")
    run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  } else {
    let base = run written.declarations(if inherited { b"font-size:20px;color:red;filter:blur(1em);text-shadow:1em 0 currentColor" } else { b"font-size:20px;color:red;filter:blur(1em);text-shadow:1em 0 red" })
    run batch.style(1, base.asSlice())
  }
  let hover = run written.declarations(if inherited { b"filter:blur(2em);text-shadow:2em 0 currentColor" } else { b"filter:blur(2em);text-shadow:2em 0 red" })
  run batch.styleFor(1, StyleState.Hover, hover.asSlice())
  let child = run written.declarations(if inherited { b"font-size:10px;color:blue;filter:inherit;text-shadow:inherit" } else { b"font-size:10px;color:blue" })
  run batch.style(2, child.asSlice())
  run tree.apply(run batch.take())
  let slot = tree.slotOf(1)
  let node = tree.nodeMut(slot)
  node.hovered = true
  let frame = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  run Testing.expect(blurAmount(&tree, 1) == 40.0 && (!inherited || blurAmount(&tree, 2) == 40.0 && redShadow(&tree, 2, 40.0)), "inherited effects use the active ancestor look and freeze its font and currentColor")
  let override = run written.declarations(if inherited { b"filter:blur(3em);text-shadow:3em 0 currentColor" } else { b"filter:blur(3em);text-shadow:3em 0 red" })
  drop run tree.setOverride(1, StyleState.Base, move override, false)
  run tree.frame(frame)
  run Testing.expect(blurAmount(&tree, 1) == 60.0 && (!inherited || blurAmount(&tree, 2) == 60.0 && redShadow(&tree, 2, 60.0)), "base inspector effects beat hover and reach inheriting descendants")
  drop tree.clearOverride(1, StyleState.Base)
  let replacement = run written.declarations(b"opacity:.5")
  drop run tree.setOverride(1, StyleState.Hover, move replacement, true)
  run tree.frame(frame)
  run Testing.expect(blurAmount(&tree, 1) == 20.0 && (!inherited || blurAmount(&tree, 2) == 20.0 && redShadow(&tree, 2, 20.0)), "replacing a look removes its effects from both paint and inheritance")
  drop tree.clearOverride(1, StyleState.Hover)
  run tree.frame(frame)
  run Testing.expect(blurAmount(&tree, 1) == 40.0 && (!inherited || blurAmount(&tree, 2) == 40.0), "clearing an inspector replacement restores the active effects")
  if !sheet && !inherited {
    run Testing.expect(tree.node(slot).sheetStyle().isNone(), "ordinary style objects exercise the direct effects path")
  }
  let beforeReset = tree.node(slot).computed().effects.hash
  let reset = run written.declarations(b"filter:inherit;text-shadow:initial")
  drop run tree.setOverride(1, StyleState.Base, move reset, false)
  run tree.frame(frame)
  run Testing.expect(tree.node(slot).computed().effects.hash != beforeReset, "effect resets invalidate retained paint")
  run Testing.expect(blurAmount(&tree, 1) == 0.0 && blurAmount(&tree, 2) == 0.0 && !redShadow(&tree, 1, 40.0) && !redShadow(&tree, 2, 40.0), "root inheritance and initial replace earlier effects without leaking them to descendants")
}

test effect fn paintEffectsHonorInspectorAndInheritedWinners() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run paintOverrideParity(false, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run paintOverrideParity(true, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run paintOverrideParity(false, true) |> Effect.provideMut<Allocator>(&mut allocator)
  run paintOverrideParity(true, true) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn namedRange(batch: &mut Batch, id: u32, name: string, text: Option<string>) ! OutOfMemoryError ? &mut Allocator {
  let value = match text { Option.Some { value } => Option<String>.some(run String.copy(value)) _ => Option<String>.None }
  run batch.attribute(id, Attribute.Named { name: run String.copy(name), value: move value })
}

effect fn rangeAttributes() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ValueRange { min: -10.0, max: 100.0, value: 2.5 })
  run batch.attribute(2, Attribute.Role { value: Role.Slider })
  run batch.attribute(2, Attribute.TabIndex { value: -1 })
  run batch.create(3, NodeKind.Input)
  run batch.append(1, 3)
  run batch.create(4, NodeKind.Box)
  run batch.append(1, 4)
  run batch.attribute(4, Attribute.Element { name: run String.copy("button") })
  run batch.attribute(2, Attribute.Level { value: 2 })
  run batch.attribute(2, Attribute.PosInSet { value: 3 })
  run batch.attribute(2, Attribute.SetSize { value: -1 })
  let bytes = run sheetBytes(b"[aria-valuenow='2.5']{width:25px}[aria-valuenow='2.00']{width:20px}[aria-valuenow='2.00'][aria-valuemax='50.00']{width:50px}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  let slot = tree.slotOf(2)
  run Testing.expect(run matches(&tree, 2, b"[role='slider'][tabindex='-1'][aria-valuemin='-10'][aria-valuemax='100'][aria-valuenow='2.5'][aria-level='2'][aria-posinset='3'][aria-setsize='-1']"), "native numeric accessibility attributes have selector-visible spellings")
  run Testing.expect(tree.node(tree.slotOf(3)).tabIndex == 0 && (run matches(&tree, 3, b"input:not([tabindex]):not([role])"))
    && (run matches(&tree, 4, b"button:not([role])")), "implicit focus and role defaults do not synthesize selector attributes")
  run Testing.expect(tree.node(slot).computed().layout.width.value == 25.0, "range selectors participate in the stylesheet cascade")
  run batch.attribute(2, Attribute.Role { value: Role.None })
  run batch.attribute(2, Attribute.TabIndex { value: NOT_FOCUSABLE })
  run batch.attribute(2, Attribute.ClearValueRange)
  run batch.attribute(2, Attribute.Level { value: 0 })
  run batch.attribute(2, Attribute.PosInSet { value: 0 })
  run batch.attribute(2, Attribute.SetSize { value: 0 })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(!tree.node(slot).hasValueRange() && run matches(&tree, 2, b":not([role]):not([tabindex]):not([aria-valuenow]):not([aria-valuemin]):not([aria-valuemax]):not([aria-level]):not([aria-posinset]):not([aria-setsize])"), "clearing native numeric state removes its reflected attributes")
  run namedRange(&mut batch, 2, "aria-valuenow", Option<string>.some("2.00"))
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(tree.node(slot).hasValueRange() && tree.node(slot).valueNow() == 2.0 && tree.node(slot).valueMin() == 0.0 && tree.node(slot).valueMax() == 100.0, "literal numeric ARIA drives native range semantics with default bounds")
  run Testing.expect(run matches(&tree, 2, b"[aria-valuenow='2.00']:not([aria-valuemin]):not([aria-valuemax])"), "semantic defaults do not synthesize absent literal bounds or normalize selector text")
  run Testing.expect(tree.node(slot).computed().layout.width.value == 20.0, "literal spelling selects its own rule")
  run namedRange(&mut batch, 2, "aria-valuemin", Option<string>.some("-2.50e1"))
  run namedRange(&mut batch, 2, "aria-valuemax", Option<string>.some("50.00"))
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(tree.node(slot).valueMin() == -25.0 && tree.node(slot).valueMax() == 50.0 && tree.node(slot).valueNow() == 2.0, "independent named bounds update the existing native range")
  run Testing.expect(tree.node(slot).computed().layout.width.value == 50.0 && run matches(&tree, 2, b"[aria-valuemin='-2.50e1'][aria-valuemax='50.00'][aria-valuenow='2.00']"), "a bound update retains all literal spellings and invalidates attribute selectors")
  run namedRange(&mut batch, 2, "aria-valuenow", Option<string>.some("Infinity"))
  run tree.apply(run batch.take())
  run Testing.expect(!tree.node(slot).hasValueRange() && run matches(&tree, 2, b"[aria-valuenow='Infinity']"), "invalid numeric text remains selectable but does not expose a nonfinite accessible value")
  run namedRange(&mut batch, 2, "aria-valuenow", Option<string>.some(""))
  run tree.apply(run batch.take())
  run Testing.expect(!tree.node(slot).hasValueRange() && run matches(&tree, 2, b"[aria-valuenow='']"), "an empty literal stays present without a numeric range")
  run namedRange(&mut batch, 2, "aria-valuenow", Option<string<'static>>.None)
  run tree.apply(run batch.take())
  run Testing.expect(!tree.node(slot).hasValueRange() && run matches(&tree, 2, b":not([aria-valuenow])[aria-valuemin='-2.50e1'][aria-valuemax='50.00']"), "removing the value clears semantics while preserving independently declared bounds")
  run batch.attribute(2, Attribute.ValueRange { min: 0.0, max: 1.0, value: -0.0 })
  run tree.apply(run batch.take())
  run Testing.expect(run matches(&tree, 2, b"[aria-valuenow='0']"), "typed negative zero has the DOM's zero spelling")
  run batch.attribute(2, Attribute.ValueRange { min: 0.0, max: 1.0, value: 0.00000001 })
  run tree.apply(run batch.take())
  run Testing.expect(!(run matches(&tree, 2, b"[aria-valuenow='0']")), "typed small values are not rounded to zero in selector text")
  run namedRange(&mut batch, 2, "aria-valuemax", Option<string>.some("2"))
  run tree.apply(run batch.take())
  run Testing.expect(tree.node(slot).hasValueRange() && tree.node(slot).valueNow() == 0.00000001 && tree.node(slot).valueMax() == 2.0, "typed and literal mutations share a round-tripping numeric range")
}

test effect fn numericAriaAttributesShareSelectorsAndAccessibility() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rangeAttributes() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn opacityPercentages() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let declarations = [b"opacity:50%", b"opacity:0%", b"opacity:100%", b"opacity:150%", b"opacity:-30%", b"opacity:calc(10% + 20%)", b"opacity:clamp(10%,60%,80%)", b"--fade:25%;opacity:var(--fade)", b"opacity:2", b"opacity:-1"]
  let expected: [f32; 10] = [0.5, 0.0, 1.0, 1.0, 0.0, 0.3, 0.6, 0.25, 1.0, 0.0]
  let mut i: usize = 0
  while i < declarations.length {
    let mut mode: usize = 0
    while mode < 2 {
      let fonts = FontCollection.make()
      let mut tree = run UiTree.make(&fonts)
      let mut batch = Batch.make()
      run batch.create(1, NodeKind.Box)
      run batch.root(1)
      if mode == 0 {
        if i == 7 { run batch.customProperty(1, StyleState.Base, "--fade", Option<string>.some("25%"), false) }
        let inline = run written.declarations(declarations[i])
        run batch.style(1, inline.asSlice())
      } else {
        let mut source = Bytes.make()
        run source.append(b"div{")
        run source.append(declarations[i])
        run source.append(b"}")
        let sheet = run sheetBytes(source.asSlice())
        run batch.adoptStyleSheet(0, 1, sheet.asSlice())
      }
      run tree.apply(run batch.take())
      run tree.frame(FrameInput { width: 100.0, height: 100.0, scale: 1.0, time: 0.0 })
      let actual = tree.node(tree.slotOf(1)).computed().paint.opacity
      if !closeTo(actual, expected[i]) { StderrWriter.print("opacity case {} mode {}: {} vs {}\n", &.(i,mode,actual,expected[i])) }
      run Testing.expect(closeTo(actual, expected[i]), "inline and compiled opacity accept percentage math and clamp the result")
      mode = mode + 1
    }
    i = i + 1
  }
}

test effect fn opacityPercentagesMatchNumbersAndClamp() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run opacityPercentages() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pixelAndRelativeStates() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let base = run written.declarations(b"font-size:16px;padding:8px")
  let hover = run written.declarations(b"font-size:20px")
  run batch.style(1, base.asSlice())
  run batch.styleFor(1, StyleState.Hover, hover.asSlice())
  run tree.apply(run batch.take())
  let slot = tree.slotOf(1)
  let hoveredNode = tree.nodeMut(slot)
  hoveredNode.hovered = true
  let viewport = FrameInput { width: 200.0, height: 100.0, scale: 1.0, time: 0.0 }
  run tree.frame(viewport)
  run Testing.expect(tree.node(slot).computed().text.size == 20.0 && tree.node(slot).computed().layout.padding.left.value == 8.0, "pixel styles compose active font states")
  let relative = run written.declarations(b"padding:1em")
  run batch.style(1, relative.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  run Testing.expect(tree.node(slot).computed().layout.padding.left.value == 20.0, "adding relative units uses the final active font")
  run batch.push(Mutation.ClearStyle { id: 1, state: StyleState.Base })
  run batch.style(1, base.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  run Testing.expect(tree.node(slot).computed().text.size == 20.0 && tree.node(slot).computed().layout.padding.left.value == 8.0, "clearing relative styles restores pixel values without losing the active font")
  let logical = run written.declarations(b"inline-size:40px;padding-inline-start:12px")
  let axes = run written.declarations(b"writing-mode:vertical-rl;direction:rtl")
  run batch.style(1, logical.asSlice())
  run batch.styleFor(1, StyleState.Hover, axes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(viewport)
  run Testing.expect(tree.node(slot).computed().layout.height.value == 40.0 && tree.node(slot).computed().layout.padding.bottom.value == 12.0, "logical pixel values use writing mode and direction from every active state")
}

test effect fn pixelStylesTrackRelativeAndLogicalStateChanges() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pixelAndRelativeStates() |> Effect.provideMut<Allocator>(&mut allocator)
}

import silk.collections.list { List }

fn sameStyle(tree: &UiTree<'_>, first: u32, second: u32) -> bool {
  if let Option.Some { value: one } = &tree.node(tree.slotOf(first)).resolvedSheet {
    if let Option.Some { value: other } = &tree.node(tree.slotOf(second)).resolvedSheet { return one.address() == other.address() }
  }
  return false
}

/// Whether one took the other's matched style without matching selectors itself.
fn sameClass(tree: &UiTree<'_>, first: u32, second: u32) -> bool {
  let one = tree.node(tree.slotOf(first)).styleClass
  return one != 0 && one == tree.node(tree.slotOf(second)).styleClass
}

effect fn rowsTree(tree: &mut UiTree<'_>, rule: &[u8]) -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("stack") })
  let mut id: u32 = 2
  while id < 7 {
    run batch.create(id, NodeKind.Box)
    run batch.append(1, id)
    run batch.attribute(id, Attribute.ClassName { value: run String.copy("row") })
    id = id + 1
  }
  run batch.create(10, NodeKind.Box)
  run batch.append(4, 10)
  run batch.attribute(10, Attribute.ClassName { value: run String.copy("x") })
  let mut source = List<u8>.make()
  run source.appendSlice(b".row{width:20px;height:5px;color:red;background:currentColor}.on{width:40px}")
  run source.appendSlice(rule)
  run source.appendSlice(b"{width:25px}")
  let bytes = run sheetBytes(source.asSlice())
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(0.0))
}

effect fn rowsShare(rule: &[u8]) -> bool
  ! TreeError | CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  run rowsTree(&mut tree, rule)
  return sameStyle(&tree, 2, 3) && sameStyle(&tree, 5, 6)
}

fn rowWidth(tree: &UiTree<'_>, id: u32) -> f32 { return tree.node(tree.slotOf(id)).computed().layout.width.value }

/// Whether rows 2 to 6 are 25px wide exactly where `wide` has a set bit, and 20px elsewhere.
effect fn rowsMatch(rule: &[u8], wide: [bool; 5]) -> bool
  ! TreeError | CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  run rowsTree(&mut tree, rule)
  let mut i: u32 = 0
  while i < 5 {
    let expected: f32 = if wide[u32.toUsize(i)] { 25.0 } else { 20.0 }
    if rowWidth(&tree, i + 2) != expected { return false }
    i = i + 1
  }
  return true
}

effect fn equalSiblings() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run Testing.expect(run rowsShare(b".absent"), "equal siblings hold one matched style")
  run Testing.expect(run rowsShare(b".absent .row"), "rules that read only ancestors keep sibling sharing")
  run Testing.expect(run rowsShare(b".row:hover"), "state rules keep sibling sharing while states agree")
  let message = "rules that read position, siblings or descendants are matched for each sibling"
  run Testing.expect(run rowsMatch(b".row:last-child", [false, false, false, false, true]), message)
  run Testing.expect(run rowsMatch(b".row+.row", [false, true, true, true, true]), message)
  run Testing.expect(run rowsMatch(b".row~.row", [false, true, true, true, true]), message)
  run Testing.expect(run rowsMatch(b".row:has(.x)", [false, false, true, false, false]), message)
  run Testing.expect(run rowsMatch(b".row:empty", [true, true, false, true, true]), message)
  run Testing.expect(run rowsMatch(b".row:nth-child(2)", [false, true, false, false, false]), message)
  run Testing.expect(run rowsMatch(b".row:not(:last-child)", [true, true, true, true, false]), message)
  run Testing.expect(run rowsMatch(b".row:is(:first-child)", [true, false, false, false, false]), message)
  run Testing.expect(run rowsMatch(b".row:where(.stack>:not(:first-child))", [false, true, true, true, true]), message)
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  run rowsTree(&mut tree, b".absent .row")
  let mut batch = Batch.make()
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("row on") })
  let wide = run written.declarations(b"width:50px")
  run batch.style(6, wide.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(1.0))
  run Testing.expect(rowWidth(&tree, 3) == 20.0 && rowWidth(&tree, 4) == 40.0 && rowWidth(&tree, 5) == 20.0 && rowWidth(&tree, 6) == 50.0,
    "a changed class or style object leaves the sibling's shared style")
  run Testing.expect(!sameStyle(&tree, 3, 4) && !sameStyle(&tree, 4, 5) && !sameStyle(&tree, 5, 6) && sameStyle(&tree, 2, 3), "only equal inputs share")
  batch = Batch.make()
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("row") })
  run batch.attribute(5, Attribute.ElementId { value: run String.copy("named") })
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("stack absent") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(2.0))
  run Testing.expect(rowWidth(&tree, 3) == 25.0 && rowWidth(&tree, 4) == 25.0 && rowWidth(&tree, 5) == 25.0 && rowWidth(&tree, 6) == 50.0,
    "an ancestor change reaches every sharer")
  run Testing.expect(sameStyle(&tree, 3, 4), "restored inputs share again")
}

test effect fn equalSiblingsShareOneMatchedStyle() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run equalSiblings() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_tree.legacy { Input }

effect fn nestedRow(batch: &mut Batch, id: u32, class: string) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run batch.create(id, NodeKind.Box)
  run batch.append(1, id)
  run batch.attribute(id, Attribute.ClassName { value: run String.copy(class) })
  run batch.create(id + 1, NodeKind.Box)
  run batch.append(id, id + 1)
  run batch.attribute(id + 1, Attribute.ClassName { value: run String.copy("cell") })
  let mut child: u32 = 2
  while child < 5 {
    run batch.create(id + child, NodeKind.Box)
    run batch.append(id + 1, id + child)
    run batch.attribute(id + child, Attribute.ClassName { value: run String.copy(if child == 2 { "icon" } else { "label" }) })
    child = child + 1
  }
}

effect fn equalCousins() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let mut row: u32 = 10
  while row < 60 {
    run nestedRow(&mut batch, row, "row")
    row = row + 10
  }
  let bytes = run sheetBytes(b".row{height:20px}.cell{height:10px}.icon{width:8px}.label{width:20px}.on .label{width:40px}.row:hover .icon{width:9px}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(0.0))
  run Testing.expect(sameStyle(&tree, 10, 20) && sameStyle(&tree, 11, 21) && sameStyle(&tree, 12, 22) && sameStyle(&tree, 13, 23) && sameStyle(&tree, 13, 54) && !sameStyle(&tree, 12, 13),
    "the children of equal rows share their matched styles")
  run batch.attribute(30, Attribute.ClassName { value: run String.copy("row on") })
  run batch.attribute(33, Attribute.ClassName { value: run String.copy("label wide") })
  run batch.attribute(43, Attribute.ClassName { value: run String.copy("label wide") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(1.0))
  run Testing.expect(rowWidth(&tree, 23) == 20.0 && rowWidth(&tree, 33) == 40.0 && rowWidth(&tree, 34) == 40.0 && rowWidth(&tree, 43) == 20.0 && rowWidth(&tree, 32) == 8.0,
    "a row with other inputs matches its own descendants")
  run Testing.expect(!sameStyle(&tree, 23, 33) && !sameStyle(&tree, 33, 43) && sameStyle(&tree, 13, 23), "its descendants leave the shared styles")
  run batch.attribute(40, Attribute.ClassName { value: run String.copy("row on") })
  run batch.attribute(30, Attribute.ClassName { value: run String.copy("row") })
  run batch.attribute(33, Attribute.ClassName { value: run String.copy("label") })
  run batch.attribute(43, Attribute.ClassName { value: run String.copy("label") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(2.0))
  run Testing.expect(rowWidth(&tree, 33) == 20.0 && rowWidth(&tree, 43) == 40.0 && rowWidth(&tree, 44) == 40.0 && rowWidth(&tree, 53) == 20.0,
    "stale twins never lend a style")
  // Descendants a restyle does not reach keep their values and give up their share classes.
  run Testing.expect(!sameStyle(&tree, 43, 33), "a row with other inputs still matches its own")
  run tree.dispatch(Input.PointerMove { x: 2.0, y: 25.0, modifiers: 0 })
  run tree.frame(motionFrame(3.0))
  run Testing.expect(rowWidth(&tree, 22) == 9.0 && rowWidth(&tree, 12) == 8.0 && rowWidth(&tree, 32) == 8.0, "a hovered row's descendants match on their own")
  run batch.attribute(52, Attribute.ClassName { value: run String.copy("label") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(4.0))
  run Testing.expect(rowWidth(&tree, 52) == 20.0 && rowWidth(&tree, 53) == 20.0 && rowWidth(&tree, 32) == 8.0, "a changed child matches again while its siblings keep their styles")
}

/// A changed class or attribute restyles the element, and below it only the subjects of the
/// rules that test it in an ancestor compound, and the children whose inherited values change.
effect fn scopedRestyles() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let mut row: u32 = 10
  while row < 60 {
    run nestedRow(&mut batch, row, "row")
    row = row + 10
  }
  let bytes = run sheetBytes(b".row{height:20px}.cell{height:10px;color:red}.icon{width:8px}.label{width:20px}.on .label{width:40px}.row[data-pick]{height:30px}.pick .cell{color:blue}.lead{--w:30px}.lead .icon{width:var(--w)}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(0.0))
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("on") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(1.0))
  run Testing.expect(rowWidth(&tree, 13) == 40.0 && rowWidth(&tree, 54) == 40.0 && rowWidth(&tree, 12) == 8.0, "a class an ancestor compound tests reaches its subjects")
  run Testing.expect(tree.stats.styledNodes == 11, "it restyles the element and those subjects alone")
  run batch.attribute(30, Attribute.Named { name: run String.copy("data-pick"), value: Option<String>.some(String.make()) })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(2.0))
  run Testing.expect(tree.node(tree.slotOf(30)).computed().layout.height.value == 30.0 && tree.stats.styledNodes == 1, "an attribute only the subject tests restyles that element")
  run batch.attribute(20, Attribute.ClassName { value: run String.copy("row pick") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(3.0))
  run Testing.expect(tree.stats.styledNodes == 5, "a changed inherited value reaches the children")
  run batch.attribute(40, Attribute.ClassName { value: run String.copy("row lead") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(4.0))
  run Testing.expect(rowWidth(&tree, 42) == 30.0 && rowWidth(&tree, 32) == 8.0, "a new variable scope reaches the subtree")
}

/// A match that watches more `:has()` anchors than a match context holds flags them all, so a
/// later change below them restyles the anchors instead of the whole page.
effect fn manyAnchors() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let mut id: u32 = 2
  while id < 14 {
    run batch.create(id, NodeKind.Box)
    run batch.append(id - 1, id)
    run batch.attribute(id, Attribute.ClassName { value: run String.copy("group") })
    id = id + 1
  }
  run batch.create(20, NodeKind.Box)
  run batch.append(13, 20)
  run batch.attribute(20, Attribute.ClassName { value: run String.copy("t") })
  run batch.create(21, NodeKind.Box)
  run batch.append(2, 21)
  let bytes = run sheetBytes(b".t{width:8px}.group:has(.on) .t{width:9px}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(0.0))
  run Testing.expect(rowWidth(&tree, 20) == 8.0 && tree.work.watchOverflows != 0, "no anchor holds the class yet, and the match watched more than it names")
  let full = tree.work.fullStylePasses
  run batch.attribute(21, Attribute.ClassName { value: run String.copy("on") })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(1.0))
  run Testing.expect(rowWidth(&tree, 20) == 9.0, "an anchor beyond what a match context names still restyles")
  run Testing.expect(tree.work.fullStylePasses == full, "without a full pass")
}

test effect fn manyWatchedAnchorsStayLocal() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run manyAnchors() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// A style object or custom property changes no selector input: the node is restyled, and below
/// it only the children whose inherited values or variables change. Before, every descendant was
/// matched again: a scroll container's fade variables restyled its whole list on every scroll.
effect fn styleObjectRestyles() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let mut row: u32 = 10
  while row < 60 {
    run nestedRow(&mut batch, row, "row")
    row = row + 10
  }
  let bytes = run sheetBytes(b".row{height:20px}.cell{height:10px}.icon{width:var(--icon,8px)}.label{width:20px}")
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(0.0))
  let moved = run written.declarations(b"position:relative;top:4px;transform:translate(0,3px)")
  run batch.style(30, moved.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(1.0))
  run Testing.expect(tree.node(tree.slotOf(30)).computed().layout.inset.top.value == 4.0 && tree.stats.styledNodes == 1,
    "a style object of values that do not inherit restyles its node alone")
  let colored = run written.declarations(b"color:blue")
  run batch.style(20, colored.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(2.0))
  run Testing.expect(tree.stats.styledNodes == 5, "an inherited value reaches the children")
  run batch.customProperty(40, StyleState.Base, "--icon", Option<string>.some("12px"), false)
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(3.0))
  run Testing.expect(rowWidth(&tree, 42) == 12.0 && rowWidth(&tree, 32) == 8.0, "a custom property reaches the subtree that reads it")
  run batch.push(Mutation.ClearStyle { id: 30, state: StyleState.Base })
  run tree.apply(run batch.take())
  run tree.frame(motionFrame(4.0))
  run Testing.expect(tree.node(tree.slotOf(30)).computed().layout.inset.top.value != 4.0 && tree.stats.styledNodes == 1, "a cleared style object restyles its node alone")
}

test effect fn styleObjectsRestyleOnlyWhatInherits() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run styleObjectRestyles() |> Effect.provideMut<Allocator>(&mut allocator)
}

