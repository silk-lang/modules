//! An owned value on the heap, or nothing, in one pointer.
//!
//! `Option<Box<T>>` is 48 bytes: the box keeps its buffer's capacity and allocator beside the
//! pointer, and the option its tag. A node holds many parts most nodes never get, so it holds
//! them as [`Thin`], which is 8: a null pointer is the empty value, and the storage keeps its own
//! box (as `silk.mem.frozen` does) so the handle needs nothing else to free it.
import silk.core.option { Option }
import silk.core.ownership { Drop }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.mem.pointer { Pointer }

struct Unrooted {}
struct Root<T> { storage: Box<Pinned<T>> }
struct Pinned<T> {
  value: T,
  root: Unrooted | Root<T>,
}

fn release<T>(storage: Box<Pinned<T>>) -> () { return () }

/// One owned `T` on the heap, or none. Not `Copy`; dropping it drops the value.
pub struct Thin<T> {
  cell: ?*mut Pinned<T>,
}

impl<T> Thin<T> {
  /// No value. It does not allocate.
  pub fn none() -> Thin<T> {
    return Thin<T> { cell: Pointer.null<Pinned<T>>() }
  }

  /// Moves `value` to the heap.
  pub effect<'env> fn make<'env>(value: T) -> Thin<T> ! OutOfMemoryError ? &mut Allocator {
    let mut storage = run Box<Pinned<T>>.make(Pinned<T> { value: move value, root: Unrooted {} })
    let pinned = Pointer.fromMutRef(&mut storage.getMut()[0])
    let mut anchor = ()
    unsafe {
      let fresh = Pointer.borrowMut(&mut anchor, pinned)
      fresh.root = Root<T> { storage: move storage }
    }
    return Thin<T> { cell: pinned }
  }

  pub fn isNone(self: &Self) -> bool { return Pointer.isNull<Pinned<T>>(self.cell) }

  pub fn isSome(self: &Self) -> bool { return !Pointer.isNull<Pinned<T>>(self.cell) }

  /// The value, when there is one.
  pub fn get<'a>(self: &'a Self) -> Option<&'a T> {
    return match Pointer.nonNullMut<Pinned<T>>(self.cell) {
      Option<*mut Pinned<T>>.Some { value } => {
        // The handle owns the storage, so the value lives as long as the handle is borrowed.
        let pinned = unsafe Pointer.borrow(self, value)
        Option<&'a T>.Some { value: &pinned.value }
      }
      Option<*mut Pinned<T>>.None => Option<&'a T>.None
    }
  }

  /// The value to change, when there is one.
  pub fn getMut<'a>(self: &'a mut Self) -> Option<&'a mut T> {
    return match Pointer.nonNullMut<Pinned<T>>(self.cell) {
      Option<*mut Pinned<T>>.Some { value } => {
        let pinned = unsafe Pointer.borrowMut(&mut self, value)
        Option<&'a mut T>.Some { value: &mut pinned.value }
      }
      Option<*mut Pinned<T>>.None => Option<&'a mut T>.None
    }
  }

  /// The value; there must be one.
  pub fn expect<'a>(self: &'a Self) -> &'a T {
    return match self.get() {
      Option.Some { value } => value
      Option.None => Intrinsic.trap("ui-tree: the part is not there")
    }
  }

  /// The value to change; there must be one.
  pub fn expectMut<'a>(self: &'a mut Self) -> &'a mut T {
    return match self.getMut() {
      Option.Some { value } => &mut value
      Option.None => Intrinsic.trap("ui-tree: the part is not there")
    }
  }

  /// The value to change, made with `fresh` when there is none.
  pub effect fn getOrMake<'a>(self: &'a mut Self, fresh: once fn() -> T) -> &'a mut T ! OutOfMemoryError ? &mut Allocator {
    if self.isNone() {
      self.set(run Thin<T>.make(fresh()))
    }
    return self.expectMut()
  }

  /// Replaces the value with `other`'s, dropping the old one.
  pub fn set(self: &mut Self, other: Thin<T>) -> () {
    let old = Intrinsic.replace(self.*, move other)
    drop move old
  }

  /// Drops the value, if any.
  pub fn clear(self: &mut Self) -> () {
    self.set(Thin<T>.none())
  }
}

impl<T> Drop for Thin<T> {
  fn drop(self: &mut Thin<T>) -> () {
    match Pointer.nonNullMut<Pinned<T>>(self.cell) {
      Option<*mut Pinned<T>>.Some { value } => {
        let mut anchor = ()
        let held = unsafe Pointer.borrowMut(&mut anchor, value)
        let root = Intrinsic.replace(held.root, Unrooted {})
        match move root {
          Root<T> { storage } => release<T>(move storage)
          Unrooted _nothing => ()
        }
      }
      Option<*mut Pinned<T>>.None => ()
    }
    return ()
  }
}
