//! HTTP/2 in Silk (ext/h2, with nghttp2's interface): an implementation of the runtime's `Http2`
//! capability with no C library (docs/composable-runtime.md, step 8).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjsruntime.libs.core.capabilities { Http2, Composition }
import silkjsruntime.libs.core.host { Services }
import ext.http2_native

/// ext/h2 behind `node:http2`.
pub struct SilkHttp2 {
  state: ?*mut http2_native.State,
}
impl Copy for SilkHttp2 {}

impl SilkHttp2 {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> SilkHttp2 { return SilkHttp2 { state: Pointer.null<http2_native.State>() } }
}

impl Http2 for SilkHttp2 {
  static fn present() -> bool { return true }
  fn forWorker(self: &Self) -> Self { return SilkHttp2.make() }
  effect fn open(self: &mut Self) -> () ! OutOfMemoryError {
    // The C entry points ext/h2 calls back are emitted only when something takes them.
    http2_native.keepExports()
    self.state = run http2_native.open()
  }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if Pointer.isNull<http2_native.State>(self.state) { Intrinsic.trap("HTTP/2 provider is not initialized") }
    let state = unsafe Intrinsic.pointerRequalify<?*mut http2_native.State, *mut http2_native.State>(self.state)
    return run unsafe http2_native.dispatch(&mut engine, context, state, argc, argv)
  }
  unsafe fn openHandles(self: &Self) -> usize {
    return match Pointer.nonNullMut<http2_native.State>(self.state) {
      Option<*mut http2_native.State>.Some { value } => unsafe http2_native.openHandles(value)
      Option<*mut http2_native.State>.None => 0
    }
  }
  unsafe fn close(self: &mut Self) -> () {
    match Pointer.nonNullMut<http2_native.State>(self.state) {
      Option<*mut http2_native.State>.Some { value } => {
        unsafe http2_native.close(value)
        self.state = Pointer.null<http2_native.State>()
      }
      Option<*mut http2_native.State>.None => ()
    }
  }
}
