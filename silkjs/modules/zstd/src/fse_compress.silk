//! FSE table building and encoding: a port of `lib/compress/fse_compress.c` and of the encoder
//! parts of `lib/common/fse.h` and `lib/common/bitstream.h` of Zstandard 1.5.7.
//!
//! An `FSE_CTable` is an array of `u32` behind a byte pointer, with the layout of the reference:
//! `u16 tableLog`, `u16 maxSymbolValue`, the `u16` state table, then one
//! `{ i32 deltaFindState, u32 deltaNbBits }` per symbol. A normalized count is an array of `i16`
//! behind a byte pointer. Every function is `unsafe`: the caller proves the sizes.
import mem
import errors
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u16
import silk.num.i16
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.usize

pub const MAX_TABLELOG: u32 = 12
pub const MIN_TABLELOG: u32 = 5
pub const DEFAULT_TABLELOG: u32 = 11
/// `FSE_NCOUNTBOUND`.
pub const NCOUNTBOUND: usize = 512

/// `FSE_CTABLE_SIZE_U32(maxTableLog, maxSymbolValue)`, in bytes.
pub fn ctableSize(maxTableLog: u32, maxSymbolValue: u32) -> usize {
  return mem.z(1 + mem.shl32(1, maxTableLog - 1) + (maxSymbolValue + 1) * 2) * 4
}

/// `FSE_BUILD_CTABLE_WORKSPACE_SIZE(maxSymbolValue, tableLog)`, in bytes.
pub fn buildCTableWkspSize(maxSymbolValue: u32, tableLog: u32) -> usize {
  return (mem.z((maxSymbolValue + 2) + mem.shl32(1, tableLog)) / 2 + 2) * 4
}

/// Returns the normalized count of symbol `s`.
@inlineAlways
pub unsafe fn norm(table: [*]const u8, s: usize) -> i32 {
  return i16.toI32(u16.wrappingToI16(unsafe mem.r16(table, usize.wrappingMultiply(s, 2))))
}

@inlineAlways
unsafe fn setNorm(table: [*]mut u8, s: usize, v: i32) -> () {
  unsafe mem.w16(table, usize.wrappingMultiply(s, 2), i32.wrappingToU16(v))
}

@inlineAlways
unsafe fn cnt(count: [*]const u8, s: usize) -> u32 { return unsafe mem.r32(count, usize.wrappingMultiply(s, 4)) }

/// The offset in bytes of the symbol transform table inside a CTable of `tableLog`.
@inlineAlways
pub fn symbolTTOffset(tableLog: u32) -> usize {
  if tableLog == 0 { return 8 }
  return mem.z(1 + mem.shl32(1, tableLog - 1)) * 4
}

/// `FSE_buildCTable_wksp`.
pub unsafe fn buildCTable(ct: [*]mut u8, normalizedCounter: [*]const u8, maxSymbolValue: u32, tableLog: u32, workSpace: [*]mut u8, wkspSize: usize) -> usize {
  let tableSize = mem.shl32(1, tableLog)
  let tableMask = tableSize - 1
  let tt = unsafe mem.add(ct, symbolTTOffset(tableLog))
  let step = u32.shiftRight(tableSize, 1) + u32.shiftRight(tableSize, 3) + 3
  let maxSV1 = maxSymbolValue + 1
  let cumul = workSpace
  let tableSymbol = unsafe mem.add(workSpace, mem.z(maxSV1 + 1) * 2)
  let mut highThreshold = tableSize - 1
  if buildCTableWkspSize(maxSymbolValue, tableLog) > wkspSize { return errors.err(errors.E_TABLELOG_TOOLARGE) }
  unsafe mem.w16(ct, 0, u32.wrappingToU16(tableLog))
  unsafe mem.w16(ct, 2, u32.wrappingToU16(maxSymbolValue))
  // Symbol start positions.
  unsafe mem.w16(cumul, 0, 0)
  let mut u: u32 = 1
  while u <= maxSV1 {
    let n = unsafe norm(normalizedCounter, mem.z(u - 1))
    let prev = unsafe mem.r16(unsafe mem.ro(cumul), mem.z(u - 1) * 2)
    if n == -1 {
      unsafe mem.w16(cumul, mem.z(u) * 2, u16.wrappingAdd(prev, 1))
      unsafe mem.w8(tableSymbol, mem.z(highThreshold), u32.wrappingToU8(u - 1))
      highThreshold = mem.s32(highThreshold, 1)
    } else {
      unsafe mem.w16(cumul, mem.z(u) * 2, u16.wrappingAdd(prev, i32.wrappingToU16(n)))
    }
    u = u + 1
  }
  unsafe mem.w16(cumul, mem.z(maxSV1) * 2, u32.wrappingToU16(tableSize + 1))
  // Spread symbols.
  if highThreshold == tableSize - 1 {
    // No low-probability symbol: lay the symbols down in order, then spread them.
    let spread = unsafe mem.add(tableSymbol, mem.z(tableSize))
    let mut pos: usize = 0
    let mut sv: u64 = 0
    let mut s: u32 = 0
    while s < maxSV1 {
      let n = unsafe norm(normalizedCounter, mem.z(s))
      unsafe mem.w64(spread, pos, sv)
      let mut i: i32 = 8
      while i < n {
        unsafe mem.w64(spread, mem.ua(pos, i32.toUsize(i)), sv)
        i = i + 8
      }
      pos = mem.ua(pos, i32.wrappingToUsize(n))
      s = s + 1
      sv = u64.wrappingAdd(sv, 0x0101010101010101)
    }
    let mut position: usize = 0
    let mut t: usize = 0
    let size = mem.z(tableSize)
    let mask = mem.z(tableMask)
    let stepz = mem.z(step)
    while t < size {
      unsafe mem.w8(tableSymbol, position & mask, unsafe mem.r8(unsafe mem.ro(spread), t))
      unsafe mem.w8(tableSymbol, mem.ua(position, stepz) & mask, unsafe mem.r8(unsafe mem.ro(spread), t + 1))
      position = mem.ua(position, 2 * stepz) & mask
      t = t + 2
    }
  } else {
    let mut position: u32 = 0
    let mut symbol: u32 = 0
    while symbol < maxSV1 {
      let freq = unsafe norm(normalizedCounter, mem.z(symbol))
      let mut nbOccurrences: i32 = 0
      while nbOccurrences < freq {
        unsafe mem.w8(tableSymbol, mem.z(position), u32.wrappingToU8(symbol))
        position = (position + step) & tableMask
        while position > highThreshold { position = (position + step) & tableMask }
        nbOccurrences = nbOccurrences + 1
      }
      symbol = symbol + 1
    }
  }
  // Build the state table.
  let mut v: u32 = 0
  while v < tableSize {
    let s = u8.toUsize(unsafe mem.r8(unsafe mem.ro(tableSymbol), mem.z(v)))
    let c = unsafe mem.r16(unsafe mem.ro(cumul), s * 2)
    unsafe mem.w16(cumul, s * 2, u16.wrappingAdd(c, 1))
    unsafe mem.w16(ct, 4 + u16.toUsize(c) * 2, u32.wrappingToU16(tableSize + v))
    v = v + 1
  }
  // Build the symbol transformation table.
  let mut total: u32 = 0
  let mut s: u32 = 0
  while s <= maxSymbolValue {
    let n = unsafe norm(normalizedCounter, mem.z(s))
    let at = mem.z(s) * 8
    if n == 0 {
      // Filled all the same, so that a symbol that is not present costs tableLog+1 bits.
      unsafe mem.w32(tt, at + 4, mem.s32(mem.shl32(tableLog + 1, 16), tableSize))
    } else if n == -1 || n == 1 {
      unsafe mem.w32(tt, at + 4, mem.s32(mem.shl32(tableLog, 16), tableSize))
      unsafe mem.w32(tt, at, mem.s32(total, 1))
      total = total + 1
    } else {
      let nu = i32.wrappingToU32(n)
      let maxBitsOut = tableLog - mem.highbit32(nu - 1)
      let minStatePlus = mem.shl32(nu, maxBitsOut)
      unsafe mem.w32(tt, at + 4, mem.s32(mem.shl32(maxBitsOut, 16), minStatePlus))
      unsafe mem.w32(tt, at, mem.s32(total, nu))
      total = mem.a32(total, nu)
    }
    s = s + 1
  }
  return 0
}

/// `FSE_NCountWriteBound`.
pub fn ncountWriteBound(maxSymbolValue: u32, tableLog: u32) -> usize {
  let maxHeaderSize = mem.z(((maxSymbolValue + 1) * tableLog + 4 + 2) / 8 + 1 + 2)
  if maxSymbolValue != 0 { return maxHeaderSize }
  return NCOUNTBOUND
}

unsafe fn writeNCountGeneric(header: [*]mut u8, headerBufferSize: usize, normalizedCounter: [*]const u8, maxSymbolValue: u32, tableLog: u32, writeIsSafe: bool) -> usize {
  let mut out: usize = 0
  let oend = headerBufferSize
  let tableSize: i32 = u32.toI32(mem.shl32(1, tableLog))
  let mut bitStream: u32 = 0
  let mut bitCount: u32 = 0
  let mut symbol: u32 = 0
  let alphabetSize = maxSymbolValue + 1
  let mut previousIs0 = false
  // Table size.
  bitStream = mem.a32(bitStream, mem.shl32(tableLog - MIN_TABLELOG, bitCount))
  bitCount = bitCount + 4
  // Init.
  let mut remaining: i32 = tableSize + 1
  let mut threshold: i32 = tableSize
  let mut nbBits: u32 = tableLog + 1
  while symbol < alphabetSize && remaining > 1 {
    if previousIs0 {
      let mut start = symbol
      while symbol < alphabetSize && unsafe norm(normalizedCounter, mem.z(symbol)) == 0 { symbol = symbol + 1 }
      if symbol == alphabetSize { break }
      while symbol >= start + 24 {
        start = start + 24
        bitStream = mem.a32(bitStream, mem.shl32(0xFFFF, bitCount))
        if !writeIsSafe && mem.ua(out, 2) > oend { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
        unsafe mem.w16(header, out, u32.wrappingToU16(bitStream))
        out = out + 2
        bitStream = u32.shiftRight(bitStream, 16)
      }
      while symbol >= start + 3 {
        start = start + 3
        bitStream = mem.a32(bitStream, mem.shl32(3, bitCount))
        bitCount = bitCount + 2
      }
      bitStream = mem.a32(bitStream, mem.shl32(symbol - start, bitCount))
      bitCount = bitCount + 2
      if bitCount > 16 {
        if !writeIsSafe && mem.ua(out, 2) > oend { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
        unsafe mem.w16(header, out, u32.wrappingToU16(bitStream))
        out = out + 2
        bitStream = u32.shiftRight(bitStream, 16)
        bitCount = bitCount - 16
      }
    }
    let mut count = unsafe norm(normalizedCounter, mem.z(symbol))
    symbol = symbol + 1
    let max = (2 * threshold - 1) - remaining
    if count < 0 { remaining = remaining + count } else { remaining = remaining - count }
    count = count + 1
    if count >= threshold { count = count + max }
    bitStream = mem.a32(bitStream, mem.shl32(i32.wrappingToU32(count), bitCount))
    bitCount = bitCount + nbBits
    if count < max { bitCount = bitCount - 1 }
    previousIs0 = count == 1
    if remaining < 1 { return errors.err(errors.E_GENERIC) }
    while remaining < threshold { nbBits = nbBits - 1 threshold = threshold / 2 }
    if bitCount > 16 {
      if !writeIsSafe && mem.ua(out, 2) > oend { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
      unsafe mem.w16(header, out, u32.wrappingToU16(bitStream))
      out = out + 2
      bitStream = u32.shiftRight(bitStream, 16)
      bitCount = bitCount - 16
    }
  }
  if remaining != 1 { return errors.err(errors.E_GENERIC) }
  // Flush the remaining bits.
  if !writeIsSafe && mem.ua(out, 2) > oend { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
  unsafe mem.w16(header, out, u32.wrappingToU16(bitStream))
  out = out + mem.z((bitCount + 7) / 8)
  return out
}

/// `FSE_writeNCount`.
pub unsafe fn writeNCount(buffer: [*]mut u8, bufferSize: usize, normalizedCounter: [*]const u8, maxSymbolValue: u32, tableLog: u32) -> usize {
  if tableLog > MAX_TABLELOG { return errors.err(errors.E_TABLELOG_TOOLARGE) }
  if tableLog < MIN_TABLELOG { return errors.err(errors.E_GENERIC) }
  if bufferSize < ncountWriteBound(maxSymbolValue, tableLog) {
    return unsafe writeNCountGeneric(buffer, bufferSize, normalizedCounter, maxSymbolValue, tableLog, false)
  }
  return unsafe writeNCountGeneric(buffer, bufferSize, normalizedCounter, maxSymbolValue, tableLog, true)
}

fn minTableLog(srcSize: usize, maxSymbolValue: u32) -> u32 {
  let minBitsSrc = mem.highbit32(mem.t32(srcSize)) + 1
  let minBitsSymbols = mem.highbit32(maxSymbolValue) + 2
  if minBitsSrc < minBitsSymbols { return minBitsSrc }
  return minBitsSymbols
}

/// `FSE_optimalTableLog_internal`.
pub fn optimalTableLogInternal(maxTableLog: u32, srcSize: usize, maxSymbolValue: u32, minus: u32) -> u32 {
  let maxBitsSrc = mem.s32(mem.highbit32(mem.t32(mem.us(srcSize, 1))), minus)
  let mut tableLog = maxTableLog
  let minBits = minTableLog(srcSize, maxSymbolValue)
  if tableLog == 0 { tableLog = DEFAULT_TABLELOG }
  if maxBitsSrc < tableLog { tableLog = maxBitsSrc }
  if minBits > tableLog { tableLog = minBits }
  if tableLog < MIN_TABLELOG { tableLog = MIN_TABLELOG }
  if tableLog > MAX_TABLELOG { tableLog = MAX_TABLELOG }
  return tableLog
}

/// `FSE_optimalTableLog`.
pub fn optimalTableLog(maxTableLog: u32, srcSize: usize, maxSymbolValue: u32) -> u32 {
  return optimalTableLogInternal(maxTableLog, srcSize, maxSymbolValue, 2)
}

const NOT_YET_ASSIGNED: i32 = -2

// `FSE_normalizeM2`: the secondary normalization method, for distributions the first one cannot do.
unsafe fn normalizeM2(nrm: [*]mut u8, tableLog: u32, count: [*]const u8, total0: usize, maxSymbolValue: u32, lowProbCount: i32) -> usize {
  let mut total = total0
  let mut s: u32 = 0
  let mut distributed: u32 = 0
  let lowThreshold = mem.t32(mem.shrz(total, tableLog))
  let mut lowOne = mem.t32(mem.shrz(usize.wrappingMultiply(total, 3), tableLog + 1))
  while s <= maxSymbolValue {
    let c = unsafe cnt(count, mem.z(s))
    if c == 0 {
      unsafe setNorm(nrm, mem.z(s), 0)
    } else if c <= lowThreshold {
      unsafe setNorm(nrm, mem.z(s), lowProbCount)
      distributed = distributed + 1
      total = mem.us(total, mem.z(c))
    } else if c <= lowOne {
      unsafe setNorm(nrm, mem.z(s), 1)
      distributed = distributed + 1
      total = mem.us(total, mem.z(c))
    } else {
      unsafe setNorm(nrm, mem.z(s), NOT_YET_ASSIGNED)
    }
    s = s + 1
  }
  let mut toDistribute = mem.s32(mem.shl32(1, tableLog), distributed)
  if toDistribute == 0 { return 0 }
  if (total / mem.z(toDistribute)) > mem.z(lowOne) {
    // Risk of rounding to zero.
    lowOne = mem.t32(usize.wrappingMultiply(total, 3) / mem.z(mem.m32(toDistribute, 2)))
    s = 0
    while s <= maxSymbolValue {
      let c = unsafe cnt(count, mem.z(s))
      if unsafe norm(unsafe mem.ro(nrm), mem.z(s)) == NOT_YET_ASSIGNED && c <= lowOne {
        unsafe setNorm(nrm, mem.z(s), 1)
        distributed = distributed + 1
        total = mem.us(total, mem.z(c))
      }
      s = s + 1
    }
    toDistribute = mem.s32(mem.shl32(1, tableLog), distributed)
  }
  if distributed == maxSymbolValue + 1 {
    // All values are pretty poor: give all the remaining points to the largest.
    let mut maxV: u32 = 0
    let mut maxC: u32 = 0
    s = 0
    while s <= maxSymbolValue {
      let c = unsafe cnt(count, mem.z(s))
      if c > maxC { maxV = s maxC = c }
      s = s + 1
    }
    unsafe setNorm(nrm, mem.z(maxV), i32.wrappingAdd(unsafe norm(unsafe mem.ro(nrm), mem.z(maxV)), u32.wrappingToI32(toDistribute & 0xFFFF)))
    return 0
  }
  if total == 0 {
    // All of the symbols were low enough for the lowOne or lowThreshold.
    s = 0
    while toDistribute > 0 {
      let n = unsafe norm(unsafe mem.ro(nrm), mem.z(s))
      if n > 0 { toDistribute = toDistribute - 1 unsafe setNorm(nrm, mem.z(s), n + 1) }
      s = (s + 1) % (maxSymbolValue + 1)
    }
    return 0
  }
  let vStepLog: u32 = 62 - tableLog
  let mid: u64 = u64.wrappingSubtract(mem.shl64(1, vStepLog - 1), 1)
  let rStep: u64 = u64.wrappingAdd(u64.wrappingMultiply(mem.shl64(1, vStepLog), u32.toU64(toDistribute)), mid) / u32.toU64(mem.t32(total))
  let mut tmpTotal: u64 = mid
  s = 0
  while s <= maxSymbolValue {
    if unsafe norm(unsafe mem.ro(nrm), mem.z(s)) == NOT_YET_ASSIGNED {
      let end = u64.wrappingAdd(tmpTotal, u64.wrappingMultiply(u32.toU64(unsafe cnt(count, mem.z(s))), rStep))
      let sStart = u64.wrappingToU32(mem.shr64(tmpTotal, vStepLog))
      let sEnd = u64.wrappingToU32(mem.shr64(end, vStepLog))
      let weight = mem.s32(sEnd, sStart)
      if weight < 1 { return errors.err(errors.E_GENERIC) }
      unsafe setNorm(nrm, mem.z(s), u32.wrappingToI32(weight & 0xFFFF))
      tmpTotal = end
    }
    s = s + 1
  }
  return 0
}

const RTB_TABLE: [u32; 8] = [0, 473195, 504333, 520860, 550000, 700000, 750000, 830000]

/// `FSE_normalizeCount`. Returns `tableLog`, or an error.
pub unsafe fn normalizeCount(normalizedCounter: [*]mut u8, tableLog0: u32, count: [*]const u8, total: usize, maxSymbolValue: u32, useLowProbCount: bool) -> usize {
  let mut tableLog = tableLog0
  if tableLog == 0 { tableLog = DEFAULT_TABLELOG }
  if tableLog < MIN_TABLELOG { return errors.err(errors.E_GENERIC) }
  if tableLog > MAX_TABLELOG { return errors.err(errors.E_TABLELOG_TOOLARGE) }
  if tableLog < minTableLog(total, maxSymbolValue) { return errors.err(errors.E_GENERIC) }
  let lowProbCount: i32 = if useLowProbCount { -1 } else { 1 }
  let scale: u32 = 62 - tableLog
  let step: u64 = 0x4000000000000000 / u32.toU64(mem.t32(total))
  let vStep: u64 = mem.shl64(1, scale - 20)
  let mut stillToDistribute: i32 = u32.toI32(mem.shl32(1, tableLog))
  let mut s: u32 = 0
  let mut largest: u32 = 0
  let mut largestP: i32 = 0
  let lowThreshold = mem.t32(mem.shrz(total, tableLog))
  while s <= maxSymbolValue {
    let c = unsafe cnt(count, mem.z(s))
    if mem.z(c) == total { return 0 }
    if c == 0 {
      unsafe setNorm(normalizedCounter, mem.z(s), 0)
    } else if c <= lowThreshold {
      unsafe setNorm(normalizedCounter, mem.z(s), lowProbCount)
      stillToDistribute = stillToDistribute - 1
    } else {
      let scaled = u64.wrappingMultiply(u32.toU64(c), step)
      let mut proba: i32 = i16.toI32(u64.wrappingToI16(mem.shr64(scaled, scale)))
      if proba < 8 {
        let restToBeat = u64.wrappingMultiply(vStep, u32.toU64(RTB_TABLE[i32.wrappingToUsize(proba) & 7]))
        if u64.wrappingSubtract(scaled, mem.shl64(i32.wrappingToU64(proba), scale)) > restToBeat { proba = proba + 1 }
      }
      if proba > largestP { largestP = proba largest = s }
      unsafe setNorm(normalizedCounter, mem.z(s), proba)
      stillToDistribute = stillToDistribute - proba
    }
    s = s + 1
  }
  let largestNorm = unsafe norm(unsafe mem.ro(normalizedCounter), mem.z(largest))
  if (0 - stillToDistribute) >= i32.shiftRight(largestNorm, 1) {
    // Corner case: need another normalization method.
    let errorCode = unsafe normalizeM2(normalizedCounter, tableLog, count, total, maxSymbolValue, lowProbCount)
    if errors.isError(errorCode) { return errorCode }
  } else {
    unsafe setNorm(normalizedCounter, mem.z(largest), largestNorm + stillToDistribute)
  }
  return mem.z(tableLog)
}

/// `FSE_buildCTable_rle`: a table for a source of one symbol.
pub unsafe fn buildCTableRle(ct: [*]mut u8, symbolValue: u8) -> usize {
  unsafe mem.w16(ct, 0, 0)
  unsafe mem.w16(ct, 2, u8.toU16(symbolValue))
  unsafe mem.w16(ct, 4, 0)
  unsafe mem.w16(ct, 6, 0)
  let at = 8 + u8.toUsize(symbolValue) * 8
  unsafe mem.w32(ct, at + 4, 0)
  unsafe mem.w32(ct, at, 0)
  return 0
}

// ---- Bitstream writer (`BIT_CStream_t`). ----

/// A forward bitstream writer, as `BIT_CStream_t`. `ptr` and `endPtr` are offsets from `start`.
pub struct BitC {
  pub container: u64,
  pub bitPos: u32,
  pub start: [*]mut u8,
  pub ptr: usize,
  pub endPtr: usize,
}
impl Copy for BitC {}

/// `BIT_initCStream`. Returns false if `dstCapacity` is too small; the stream must not be used.
@inlineAlways
pub fn bitInit(start: [*]mut u8, dstCapacity: usize) -> BitC {
  return BitC { container: 0, bitPos: 0, start: start, ptr: 0, endPtr: mem.us(dstCapacity, 8) }
}

/// `BIT_addBits`: adds the low `nbBits` (at most 31) bits of `value`.
@inlineAlways
pub fn bitAdd(b: &mut BitC, value: u64, nbBits: u32) -> () {
  let masked = value & u64.wrappingSubtract(mem.shl64(1, nbBits), 1)
  b.container = b.container | mem.shl64(masked, b.bitPos)
  b.bitPos = u32.wrappingAdd(b.bitPos, nbBits)
}

/// `BIT_addBitsFast`: as [`bitAdd`], for a value that has no bit above `nbBits`.
@inlineAlways
pub fn bitAddFast(b: &mut BitC, value: u64, nbBits: u32) -> () {
  b.container = b.container | mem.shl64(value, b.bitPos)
  b.bitPos = u32.wrappingAdd(b.bitPos, nbBits)
}

/// `BIT_flushBitsFast`: writes whole bytes; the caller proves that there is room.
@inlineAlways
pub unsafe fn bitFlushFast(b: &mut BitC) -> () {
  let nbBytes = u32.shiftRight(b.bitPos, 3)
  unsafe mem.w64(b.start, b.ptr, b.container)
  b.ptr = mem.ua(b.ptr, mem.z(nbBytes))
  b.bitPos = b.bitPos & 7
  b.container = mem.shr64(b.container, u32.wrappingMultiply(nbBytes, 8))
}

/// `BIT_flushBits`: writes whole bytes and does not go past `endPtr`.
@inlineAlways
pub unsafe fn bitFlush(b: &mut BitC) -> () {
  let nbBytes = u32.shiftRight(b.bitPos, 3)
  unsafe mem.w64(b.start, b.ptr, b.container)
  b.ptr = mem.ua(b.ptr, mem.z(nbBytes))
  if b.ptr > b.endPtr { b.ptr = b.endPtr }
  b.bitPos = b.bitPos & 7
  b.container = mem.shr64(b.container, u32.wrappingMultiply(nbBytes, 8))
}

/// `BIT_closeCStream`: returns the size of the stream, or 0 if it did not fit.
@inlineAlways
pub unsafe fn bitClose(b: &mut BitC) -> usize {
  bitAddFast(&mut b, 1, 1)
  unsafe bitFlush(&mut b)
  if b.ptr >= b.endPtr { return 0 }
  if b.bitPos > 0 { return b.ptr + 1 }
  return b.ptr
}

// ---- FSE encoder state (`FSE_CState_t`). ----

/// The state of one FSE encoder, as `FSE_CState_t`.
pub struct CState {
  pub value: usize,
  pub stateTable: [*]const u8,
  pub symbolTT: [*]const u8,
  pub stateLog: u32,
}
impl Copy for CState {}

/// `FSE_initCState`.
@inlineAlways
pub unsafe fn initCState(ct: [*]const u8) -> CState {
  let tableLog = u16.toU32(unsafe mem.r16(ct, 0))
  return CState {
    value: mem.shlz(1, tableLog),
    stateTable: unsafe mem.addc(ct, 4),
    symbolTT: unsafe mem.addc(ct, symbolTTOffset(tableLog)),
    stateLog: tableLog,
  }
}

/// `FSE_initCState2`: starts the state with `symbol`, which costs no bit.
@inlineAlways
pub unsafe fn initCState2(ct: [*]const u8, symbol: u32) -> CState {
  let mut state = unsafe initCState(ct)
  let at = usize.wrappingMultiply(mem.z(symbol), 8)
  let deltaFindState = unsafe mem.r32(state.symbolTT, at)
  let deltaNbBits = unsafe mem.r32(state.symbolTT, at + 4)
  let nbBitsOut = u32.shiftRight(mem.a32(deltaNbBits, 32768), 16)
  let value = mem.s32(mem.shl32(nbBitsOut, 16), deltaNbBits)
  let index = mem.ua(mem.z(mem.shr32(value, nbBitsOut)), i32.wrappingToUsize(u32.wrappingToI32(deltaFindState)))
  state.value = u16.toUsize(unsafe mem.r16(state.stateTable, usize.wrappingMultiply(index, 2)))
  return state
}

/// `FSE_encodeSymbol`.
@inlineAlways
pub unsafe fn encodeSymbol(b: &mut BitC, state: &mut CState, symbol: u32) -> () {
  let at = usize.wrappingMultiply(mem.z(symbol), 8)
  let deltaFindState = unsafe mem.r32(state.symbolTT, at)
  let deltaNbBits = unsafe mem.r32(state.symbolTT, at + 4)
  let nbBitsOut = mem.t32(usize.shiftRight(mem.ua(state.value, mem.z(deltaNbBits)), 16))
  bitAdd(&mut b, usize.toU64(state.value), nbBitsOut)
  let index = mem.ua(mem.shrz(state.value, nbBitsOut), i32.wrappingToUsize(u32.wrappingToI32(deltaFindState)))
  state.value = u16.toUsize(unsafe mem.r16(state.stateTable, usize.wrappingMultiply(index, 2)))
}

/// `FSE_flushCState`.
@inlineAlways
pub unsafe fn flushCState(b: &mut BitC, state: &CState) -> () {
  bitAdd(&mut b, usize.toU64(state.value), state.stateLog)
  unsafe bitFlush(&mut b)
}

/// `FSE_bitCost`: the cost of `symbolValue` in bits, scaled by `1 << accuracyLog`.
@inlineAlways
pub unsafe fn bitCost(symbolTT: [*]const u8, tableLog: u32, symbolValue: u32, accuracyLog: u32) -> u32 {
  let deltaNbBits = unsafe mem.r32(symbolTT, mem.z(symbolValue) * 8 + 4)
  let minNbBits = u32.shiftRight(deltaNbBits, 16)
  let threshold = mem.shl32(minNbBits + 1, 16)
  let tableSize = mem.shl32(1, tableLog)
  let deltaFromThreshold = mem.s32(threshold, mem.a32(deltaNbBits, tableSize))
  let normalizedDeltaFromThreshold = mem.shr32(mem.shl32(deltaFromThreshold, accuracyLog), tableLog)
  let bitMultiplier = mem.shl32(1, accuracyLog)
  return mem.s32(mem.m32(minNbBits + 1, bitMultiplier), normalizedDeltaFromThreshold)
}

// `FSE_compress_usingCTable_generic`.
unsafe fn compressGeneric(dst: [*]mut u8, dstSize: usize, src: [*]const u8, srcSize0: usize, ct: [*]const u8, fast: bool) -> usize {
  let mut srcSize = srcSize0
  let mut ip = srcSize
  if srcSize <= 2 { return 0 }
  if dstSize <= 8 { return 0 }
  let mut bitC = bitInit(dst, dstSize)
  let mut s1 = unsafe initCState(ct)
  let mut s2 = unsafe initCState(ct)
  if (srcSize & 1) != 0 {
    ip = ip - 1 s1 = unsafe initCState2(ct, u8.toU32(unsafe mem.r8(src, ip)))
    ip = ip - 1 s2 = unsafe initCState2(ct, u8.toU32(unsafe mem.r8(src, ip)))
    ip = ip - 1 unsafe encodeSymbol(&mut bitC, &mut s1, u8.toU32(unsafe mem.r8(src, ip)))
    if fast { unsafe bitFlushFast(&mut bitC) } else { unsafe bitFlush(&mut bitC) }
  } else {
    ip = ip - 1 s2 = unsafe initCState2(ct, u8.toU32(unsafe mem.r8(src, ip)))
    ip = ip - 1 s1 = unsafe initCState2(ct, u8.toU32(unsafe mem.r8(src, ip)))
  }
  // Join to mod 4.
  srcSize = srcSize - 2
  if (srcSize & 2) != 0 {
    ip = ip - 1 unsafe encodeSymbol(&mut bitC, &mut s2, u8.toU32(unsafe mem.r8(src, ip)))
    ip = ip - 1 unsafe encodeSymbol(&mut bitC, &mut s1, u8.toU32(unsafe mem.r8(src, ip)))
    if fast { unsafe bitFlushFast(&mut bitC) } else { unsafe bitFlush(&mut bitC) }
  }
  // 2 or 4 encodings per loop.
  while ip > 0 {
    ip = ip - 1 unsafe encodeSymbol(&mut bitC, &mut s2, u8.toU32(unsafe mem.r8(src, ip)))
    ip = ip - 1 unsafe encodeSymbol(&mut bitC, &mut s1, u8.toU32(unsafe mem.r8(src, ip)))
    ip = ip - 1 unsafe encodeSymbol(&mut bitC, &mut s2, u8.toU32(unsafe mem.r8(src, ip)))
    ip = ip - 1 unsafe encodeSymbol(&mut bitC, &mut s1, u8.toU32(unsafe mem.r8(src, ip)))
    if fast { unsafe bitFlushFast(&mut bitC) } else { unsafe bitFlush(&mut bitC) }
  }
  unsafe flushCState(&mut bitC, &s2)
  unsafe flushCState(&mut bitC, &s1)
  return unsafe bitClose(&mut bitC)
}

/// `FSE_compress_usingCTable`: returns the compressed size, or 0 if `dst` is too small.
pub unsafe fn compressUsingCTable(dst: [*]mut u8, dstSize: usize, src: [*]const u8, srcSize: usize, ct: [*]const u8) -> usize {
  let fast = dstSize >= srcSize + usize.shiftRight(srcSize, 7) + 4 + 8
  return unsafe compressGeneric(dst, dstSize, src, srcSize, ct, fast)
}
