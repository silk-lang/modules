//! The WebGPU commands of a ui-js realm as bytes: what `webgpu.js` writes and
//! [`service`](service) runs.
//!
//! The stream is a run of commands, each a length in bytes and then that many bytes: the
//! command's number and its fields. Fields are little-endian: 32-bit words, 64-bit floats
//! (sizes and offsets are floats, -1 for "the rest"), and strings and byte runs with their
//! length before them. An object is the number JavaScript gave it; 0 is no object.
import silk.collections.slice { Slice }
import silk.num.f64
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

pub const REQUEST_ADAPTER: u32 = 1
pub const REQUEST_DEVICE: u32 = 2
pub const DESTROY_DEVICE: u32 = 3
pub const DROP: u32 = 4
pub const CREATE_BUFFER: u32 = 10
pub const BUFFER_WRITE_MAPPED: u32 = 11
pub const BUFFER_UNMAP: u32 = 12
pub const BUFFER_MAP: u32 = 13
pub const BUFFER_DESTROY: u32 = 14
pub const CREATE_TEXTURE: u32 = 20
pub const CREATE_VIEW: u32 = 21
pub const TEXTURE_DESTROY: u32 = 22
pub const CREATE_SAMPLER: u32 = 23
pub const CREATE_BIND_GROUP_LAYOUT: u32 = 24
pub const CREATE_PIPELINE_LAYOUT: u32 = 25
pub const CREATE_BIND_GROUP: u32 = 26
pub const CREATE_SHADER_MODULE: u32 = 27
pub const CREATE_RENDER_PIPELINE: u32 = 28
pub const CREATE_COMPUTE_PIPELINE: u32 = 29
pub const PIPELINE_LAYOUT_OF: u32 = 30
pub const ENCODE: u32 = 31
pub const SUBMIT: u32 = 32
pub const WRITE_BUFFER: u32 = 33
pub const WRITE_TEXTURE: u32 = 34
pub const WORK_DONE: u32 = 35
pub const PUSH_ERROR_SCOPE: u32 = 36
pub const POP_ERROR_SCOPE: u32 = 37
pub const COMPILATION_INFO: u32 = 38
pub const CONFIGURE: u32 = 40
pub const UNCONFIGURE: u32 = 41
pub const CANVAS_TEXTURE: u32 = 42

/// Inside [`ENCODE`]: what an encoder did, up to [`END`].
pub const END: u32 = 0
pub const RENDER_PASS: u32 = 1
pub const COMPUTE_PASS: u32 = 2
pub const COPY_BUFFER: u32 = 3
pub const COPY_BUFFER_TO_TEXTURE: u32 = 4
pub const COPY_TEXTURE_TO_BUFFER: u32 = 5
pub const COPY_TEXTURE: u32 = 6
pub const CLEAR_BUFFER: u32 = 7

/// Inside a pass, up to [`END`].
pub const SET_PIPELINE: u32 = 1
pub const SET_BIND_GROUP: u32 = 2
pub const SET_VERTEX_BUFFER: u32 = 3
pub const SET_INDEX_BUFFER: u32 = 4
pub const DRAW: u32 = 5
pub const DRAW_INDEXED: u32 = 6
pub const SET_VIEWPORT: u32 = 7
pub const SET_SCISSOR: u32 = 8
pub const SET_BLEND_CONSTANT: u32 = 9
pub const SET_STENCIL_REFERENCE: u32 = 10
pub const DRAW_INDIRECT: u32 = 11
pub const DRAW_INDEXED_INDIRECT: u32 = 12
pub const DISPATCH: u32 = 13
pub const DISPATCH_INDIRECT: u32 = 14

/// The statuses of a reply with token 0: an error no error scope caught (its text is the
/// message and its one byte the kind: 1 validation, 2 out of memory, 3 internal), and a lost
/// device.
pub const EVENT_ERROR: u32 = 1
pub const EVENT_LOST: u32 = 2

/// A count or stride JavaScript left undefined.
pub const UNDEFINED: u32 = 0xffffffff

/// Reads the fields of commands. Past the end every field reads as zero or empty and
/// [`Reader.short`] says so.
pub struct Reader<'a> {
  bytes: &'a [u8],
  at: usize,
  missed: bool,
}

impl<'a> Reader<'a> {
  pub fn make(bytes: &'a [u8]) -> Reader<'a> {
    return Reader<'a> { bytes: bytes, at: 0, missed: false }
  }

  /// Whether nothing is left to read.
  pub fn done(self: &Self) -> bool {
    return self.missed || self.at >= self.bytes.length
  }

  /// Whether a field was read past the end.
  pub fn short(self: &Self) -> bool {
    return self.missed
  }

  fn take(self: &mut Self, count: usize) -> &'a [u8] {
    if count > self.bytes.length - self.at {
      self.missed = true
      self.at = self.bytes.length
      return Slice.view<u8>(self.bytes, 0, 0)
    }
    let taken = Slice.view<u8>(self.bytes, self.at, count)
    self.at = self.at + count
    return taken
  }

  pub fn word(self: &mut Self) -> u32 {
    let b = self.take(4)
    if b.length < 4 {
      return 0
    }
    return u8.toU32(b[0]) + u8.toU32(b[1]) * 256 + u8.toU32(b[2]) * 65536 + u8.toU32(b[3]) * 16777216
  }

  pub fn int(self: &mut Self) -> i32 {
    return u32.toI32(self.word())
  }

  pub fn flag(self: &mut Self) -> bool {
    return self.word() != 0
  }

  pub fn number(self: &mut Self) -> f64 {
    let low = u32.toU64(self.word())
    let high = u32.toU64(self.word())
    return f64.fromBits(low + high * 4294967296)
  }

  /// A size or offset: a float on the wire, where a negative one means "the rest".
  pub fn size(self: &mut Self) -> u64 {
    let value = self.number()
    if value < 0.0 {
      return u64.MAX
    }
    return f64.toU64(value)
  }

  /// A float narrowed to a count of bytes in this process.
  pub fn offset(self: &mut Self) -> usize {
    let value = self.number()
    if value < 0.0 {
      return 0
    }
    return f64.toUsize(value)
  }

  /// A string or a run of bytes, with its length before it.
  pub fn blob(self: &mut Self) -> &'a [u8] {
    let length = u32.toUsize(self.word())
    return self.take(length)
  }

  /// The next command: its bytes without their length. Empty at the end.
  pub fn command(self: &mut Self) -> Reader<'a> {
    return Reader<'a>.make(self.blob())
  }
}
