# Template: tools/silk-native-build.sh writes silk.toml with the Loom checkout (LOOM) and the
# library revisions the Silk UI checkout under test pins. Loom pins Silk UI by revision; the
# Silk home maps that revision to the checkout under test (README.md).
[package]
name = "silk-loom"
version = "0.1.0"
silk-version = "@SILK_VERSION@"

[dependencies]
loom = { path = "@LOOM@/modules/loom", package = "loom" }
loom_tree = { path = "@LOOM@/modules/loom/tree", package = "loom-tree" }
loom_window = { path = "@LOOM@/modules/loom/window", package = "loom-window" }
ui_tree = { git = "https://github.com/silk-lang/silkui.git", rev = "@LOOM_SILKUI@", path = "modules/tree", package = "ui-tree" }
ui_tree_window = { git = "https://github.com/silk-lang/silkui.git", rev = "@LOOM_SILKUI@", path = "modules/tree/window", package = "ui-tree-window" }
ui_inspect_server = { git = "https://github.com/silk-lang/silkui.git", rev = "@LOOM_SILKUI@", path = "modules/inspect/server", package = "ui-inspect-server" }
atlas = { git = "https://github.com/silk-lang/lib-graphics.git", rev = "@LIB_GRAPHICS@", path = "modules/atlas", package = "graphics-atlas" }
vector = { git = "https://github.com/silk-lang/lib-graphics.git", rev = "@LIB_GRAPHICS@", path = "modules/vector", package = "graphics-vector" }
window = { git = "https://github.com/silk-lang/lib-native.git", rev = "@LIB_NATIVE_WINDOW@", path = "modules/platform/window", package = "platform-window" }
webgpu = { git = "https://github.com/silk-lang/lib-native.git", rev = "@LIB_NATIVE_GPU@", path = "modules/gpu/webgpu", package = "gpu-webgpu" }
