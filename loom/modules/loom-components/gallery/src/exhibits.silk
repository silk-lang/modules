//! The loom-components components as showcase exhibits (`loom_components.showcase`), one case
//! each. `modules/loom-components/demo --showcase` shows them in a window.
import gallery { FRUITS }
import loom_components.lib {
  Theme,
  Tone,
  SliderRange,
  Exhibits,
  Shown,
  buttonWith,
  checkboxWith,
  switch,
  slider,
  textField,
  list,
  selectList,
  tabs,
  paragraph
}
import loom.ui { Ui, textKey }

pub const TITLES: [string<'static>; 15] = [
  "Button / Primary",
  "Button / Secondary",
  "Button / Ghost",
  "Button / Danger",
  "Button / Disabled",
  "Checkbox / Off",
  "Checkbox / On",
  "Checkbox / Disabled",
  "Switch / On",
  "Slider / Volume",
  "Text field / Empty",
  "Text field / Filled",
  "List / Fruits",
  "Select list / Cherry",
  "Tabs / Second",
]

const TABS: [string<'static>; 3] = ["General", "Sharing", "Advanced"]

fn fruitKey(name: &string) -> u64 {
  return textKey(name.*)
}

/// Every component of loom-components, case by case.
pub struct ComponentExhibits {}

impl Exhibits for ComponentExhibits {
  fn count(self: &Self) -> usize {
    return TITLES.length
  }

  fn title(self: &Self, index: usize) -> string {
    return TITLES[index]
  }

  fn draw(self: &Self, index: usize, ui: &mut Ui<Shown>, theme: &Theme) -> () {
    if index <= 4 {
      let tone = if index == 0 {
        Tone.Primary
      } else if index == 2 {
        Tone.Ghost
      } else if index == 3 {
        Tone.Danger
      } else {
        Tone.Secondary
      }
      ui.row(
        |ui| {
          buttonWith(&mut ui, &theme, tone, index == 4, "Save", || Shown.Acted { what: "Save pressed" })
        },
      )
    } else if index <= 7 {
      checkboxWith(
        &mut ui,
        &theme,
        "Email me about replies",
        index == 6,
        index == 7,
        |value| Shown.Acted { what: if value { "Checked" } else { "Unchecked" } },
      )
    } else if index == 8 {
      switch(&mut ui, &theme, "Notifications", true, |value| Shown.Acted { what: if value { "Switched on" } else { "Switched off" } })
    } else if index == 9 {
      slider(
        &mut ui,
        &theme,
        1,
        "Volume",
        40.0,
        SliderRange { min: 0.0, max: 100.0, step: 1.0, places: 0 },
        |value| Shown.Acted { what: "Volume changed" },
      )
    } else if index <= 11 {
      textField(
        &mut ui,
        &theme,
        "Name",
        "Ada Lovelace",
        if index == 11 { "Grace Hopper" } else { "" },
        |text| Shown.Acted { what: "Typed" },
        |ui| {},
      )
    } else if index == 12 {
      list(&mut ui, &theme, "Fruits", &FRUITS, fruitKey, |ui, name| { ui.text(name.*) })
    } else if index == 13 {
      selectList(
        &mut ui,
        &theme,
        "Pick a fruit",
        &FRUITS,
        fruitKey,
        2,
        |index| Shown.Acted { what: "Fruit picked" },
        |ui, name, chosen| { ui.text(name.*) },
      )
    } else {
      tabs(
        &mut ui,
        &theme,
        "Settings",
        &TABS,
        1,
        |index| Shown.Acted { what: "Tab picked" },
        |ui, index| { paragraph(&mut ui, "Who can see your notes, and who can change them.") },
      )
    }
  }
}
