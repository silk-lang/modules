fn corner(mode: WritingMode, direction: Direction, blockEnd: bool, inlineEnd: bool) -> usize {
  let block = physicalSide(mode, direction, true, blockEnd)
  let inline = physicalSide(mode, direction, false, inlineEnd)
  let top = block == 0 || inline == 0
  let left = block == 3 || inline == 3
  return if top { if left { 0 } else { 1 } } else { if left { 3 } else { 2 } }
}

fn inheritField(target: u32, parent: u32, shift: u32) -> u32 {
  return fonts.withExtrasField(target, shift, fonts.extrasField(parent, shift))
}
