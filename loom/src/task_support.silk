import silk.build.graph { BuildError }
import silk.build.graph { Build, Compilation }
import silk.build.definition {
  Definition as CompilationDefinition,
  Settings as CompilationSettings,
  Package as PackageSettings
}
import silk.build.context as BuildContext
import silk.schema.schema { Dictionary }
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.platform.windows.path { WindowsPath }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { InvalidUtf8, String }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, TomlChild, Value }
import silk.num.u8
import silk.num.usize

const HOST_OS: string = Intrinsic.targetOperatingSystem()

const HOST_ARCH: string = Intrinsic.targetArchitecture()

// The host's spelling: on Windows a portable `/C:/...` path loses its leading `/`, as git and
// other programs need.
pub fn pathText(path: &Path) -> string {
  let value = Path.view(path) |> Option<string>.unwrapOr("")
  static if HOST_OS == "windows" {
    if String.byteLength(value) >= 3 && String.utf8Bytes(value)[2] == 58 {
      return String.slice(value, 1, String.byteLength(value) - 1)
    }
  }
  return value
}

pub effect fn require(condition: bool, message: string) -> ()
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  if !condition {
    run Task.abort(message)
  }
}

// Absolute paths name themselves; relative ones resolve from the project root.
pub effect fn rootPath(value: string) -> Path
  ! TaskError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  if String.startsWith(value, "/") {
    return run Path.make(value)
  }
  let root = run Task.root()
  return run Path.resolve(&root, value)
}

pub effect fn readToml(path: &Path) -> Value
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let bytes = run FileSystem.readFile(path)
  return match move run Effect.result(Toml.parse(Bytes.asSlice(&bytes))) {
    Result<Value, TomlError | OutOfMemoryError>.Success { value } => move value
    Result<Value, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError failure => {
        fail move failure
      }
      TomlError failure => {
        drop failure
        run Task.abort("Invalid TOML manifest")
      }
    }
  }
}

pub effect fn text(bytes: &[u8]) -> String
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  return match String.fromUtf8(bytes) {
    Result<string, InvalidUtf8>.Success { value } => run String.copy(value)
    Result<string, InvalidUtf8>.Failure { .. } => run Task.abort("Expected UTF-8 text")
  }
}

pub effect fn environment(name: string) -> String
  ! TaskError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  return match move run HostInput.variableNamed(name) {
    Option<Bytes>.Some { value } => run text(Bytes.asSlice(&value))
    Option<Bytes>.None => run String.copy("")
  }
}

pub effect fn hostPath(value: string) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return run WindowsPath.fromNative(value)
  } else {
    return run Path.make(value)
  }
}

// Match every dependency declaration, including target/profile-specific tables. A non-empty
// `package` narrows the match to that package of the repository.
effect fn revisions(value: &Value, url: string, package: string, revision: &mut String) -> ()
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let git = Toml.field(value, "git")
    |> Toml.asString
    |> Option<string>.unwrapOr("")
  let named = Toml.field(value, "package")
    |> Toml.asString
    |> Option<string>.unwrapOr("")
  if git == url && (package == "" || named == package) {
    let pin = Toml.field(value, "rev")
      |> Toml.asString
      |> Option<string>.unwrapOr("")
    let bytes = String.utf8Bytes(pin)
    run require(bytes.length == 40, "Dependency must have an exact 40-character Git revision")
    let mut at: usize = 0
    while at < bytes.length {
      let ch = bytes[at]
      run require((ch >= 48 && ch <= 57) || (ch >= 97 && ch <= 102), "Invalid Git revision")
      at = at + 1
    }
    run require(
      String.view(&revision) == "" || String.view(&revision) == pin,
      "Conflicting dependency Git revisions",
    )
    if String.view(&revision) == "" {
      revision.* = run String.copy(pin)
    }
  }
  match &value.* {
    Value.Table { entries, kind: _ } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      let children = List<TomlChild>.asSlice(&boxed[0])
      let mut at: usize = 0
      while at < children.length {
        match &children[at] {
          TomlChild.Member { entry } => run revisions(&entry.value, url, package, &mut revision)
          _ => {}
        }
        at = at + 1
      }
    }
    Value.Array { values, tables: _ } => {
      let boxed = Box<List<TomlChild>>.get(&values)
      let children = List<TomlChild>.asSlice(&boxed[0])
      let mut at: usize = 0
      while at < children.length {
        match &children[at] {
          TomlChild.Item { value: child } => run revisions(&child, url, package, &mut revision)
          _ => {}
        }
        at = at + 1
      }
    }
    _ => {}
  }
}

effect fn scanManifests(directory: &Path, url: string, package: string, revision: &mut String) -> ()
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let entries = run FileSystem.listDirectory(directory)
  let items = List<DirectoryEntry>.asSlice(&entries)
  let mut at: usize = 0
  while at < items.length {
    let item = &items[at]
    let name = Path.name(&item.path) |> Option<string>.unwrapOr("")
    if item.kind.code == 1 && name != "build" && name != ".cache" && name != ".git" {
      run scanManifests(&item.path, url, package, &mut revision)
    } else if item.kind.code == 0 && name == "silk.toml" {
      let document = run readToml(&item.path)
      run revisions(&document, url, package, &mut revision)
    }
    at = at + 1
  }
}

pub effect fn repositoryRoot(name: string) -> Path
  ! TaskError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let loom = run Task.root()
  let repoRoot = match move run Path.parent(&loom) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort("loom has no monorepo parent directory")
  }
  let mut relative = String.make()
  if name == "silkui" {
    relative = run String.copy("silk-ui")
  } else if name == "loom" {
    relative = run String.copy("loom")
  } else if String.startsWith(name, "lib-") {
    relative = run String.copy(String.slice(name, 4, String.utf8Bytes(name).length - 4))
  } else {
    run Task.abort("Expected a silk-lang dependency")
  }
  let target = if name == "silkui" || name == "loom" {
    run Path.join(&repoRoot, relative.view())
  } else {
    let libDir = run Path.join(&repoRoot, "lib")
    run Path.join(&libDir, relative.view())
  }
  let manifest = run Path.join(&target, "silk.toml")
  run require(run FileSystem.exists(&manifest), "Missing local monorepo dependency directory")
  return move target
}

pub effect fn build(packagePath: string, release: bool, wasm: bool) -> String
  ! BuildError
    | TaskError
    | ProcessError
    | FileError
    | HostInputError
    | OutOfMemoryError
    | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let root = run Task.root()
  let written = if String.startsWith(packagePath, "/") {
    run Path.make(packagePath)
  } else {
    run Path.resolve(&root, packagePath)
  }
  let manifest = if String.endsWith(packagePath, ".toml") {
    run Path.fromBytes(Path.rawBytes(&written))
  } else {
    run Path.join(&written, "silk.toml")
  }
  static if Intrinsic.targetOperatingSystem() == "windows" {
    if !wasm {
      run Task.silk(&["check", "--no-server", "--manifest-path", pathText(&manifest)])
      run nativeTask(&["prepare-windows"])
    }
  }
  let mut settings = CompilationSettings.make()
  settings.profile.optimization = Option<String>.some(
    run String.copy(
      if release {
        "speed"
      } else {
        "none"
      },
    ),
  )
  settings.profile.debug = Option<bool>.some(!release)
  if wasm {
    settings.profile.target = Option<String>.some(run String.copy("wasm32-unknown-unknown"))
    settings.profile.stackSize = Option<u64>.some(8388608)
  }
  let definition = CompilationDefinition {
    manifest: run String.copy(pathText(&manifest)),
    name: Option<String>.none(),
    artifact: Option<String>.none(),
    stdlib: run BuildContext.standardLibrary(),
    settings: move settings,
    packages: Dictionary<PackageSettings>.make(),
  }
  let compilation = run Compilation.fromDefinition(move definition, run BuildContext.compiler())
  let graph = run (run Build.make()).add(move compilation)
  let built = run graph.compile()
  let binary = &built.artifacts.asSlice()[0].path
  static if Intrinsic.targetOperatingSystem() == "windows" {
    if !wasm {
      if let Option<Path>.Some { value: directory } = move run Path.parent(binary) {
        run nativeTask(&["prepare-windows", "--runtime-directory", pathText(&directory)])
      }
    }
  }
  return run String.copy(pathText(binary))
}

/// Builds the package at `packagePath` in the pinned silkui checkout (a debug build), such as
/// the inspector CLI the native checks drive.
pub effect fn silkuiPackage(packagePath: string) -> String
  ! BuildError
    | TaskError
    | ProcessError
    | FileError
    | HostInputError
    | OutOfMemoryError
    | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let checkout = run repositoryRoot("silkui")
  let package = run Path.join(&checkout, packagePath)
  return run build(pathText(&package), false, false)
}

pub effect fn nativeTask(arguments: &[string]) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let native = run repositoryRoot("lib-native")
  let manifest = run Path.join(&native, "silk.toml")
  let mut words = List<string>.make()
  run List<string>.appendSlice(&mut words, &["task", "--manifest-path", pathText(&manifest)])
  run List<string>.appendSlice(&mut words, arguments)
  run Task.silk(List<string>.asSlice(&words))
}

pub effect fn setupCi(browser: bool, linuxGpu: bool) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  run Task.silk(&["check", "--no-server", "--manifest-path", "modules/loom/window/silk.toml"])
  let mut words = List<string>.make()
  run List<string>.append(&mut words, "setup-ci")
  if browser {
    run List<string>.append(&mut words, "--browser")
  }
  if linuxGpu {
    run List<string>.append(&mut words, "--linux-gpu")
  }
  run nativeTask(List<string>.asSlice(&words))
}
