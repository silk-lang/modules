/// No node, in slots and css-layout indices.
pub const NONE: u32 = 4294967295

pub const NO_INDEX: usize = usize.MAX

/// What a frame is drawn at: the viewport in CSS pixels, device pixels per CSS pixel, and the
/// time in seconds (for animated icons).
pub struct FrameInput {
  pub width: f32,
  pub height: f32,
  pub scale: f32,
  pub time: f64,
}

impl Copy for FrameInput {}

/// What the last frame did, for tests, benchmarks and inspectors.
pub struct FrameStats {
  pub frame: u64,
  /// css-layout's counters for the frame's layout (zero when layout was skipped).
  pub layout: LayoutStats,
  pub layoutSkipped: bool,
  /// Nodes whose style was computed again.
  pub styledNodes: usize,
  /// Subtrees copied from the previous scene, and subtrees painted again.
  pub replayedSubtrees: usize,
  pub repaintedSubtrees: usize,
  /// Paint operations copied by replay.
  pub replayedOperations: usize,
  /// Box, inline and text fragments visited by paint (replayed ones excluded).
  pub paintedFragments: usize,
  /// Subtrees paint skipped because their ink lies outside the clip.
  pub culledSubtrees: usize,
  pub glyphs: usize,
  pub primitives: usize,
  pub nodes: usize,
  pub fragments: usize,
}

impl Copy for FrameStats {}

impl FrameStats {
  pub fn zero() -> FrameStats {
    return FrameStats {
      frame: 0,
      layout: LayoutStats.zero(),
      layoutSkipped: true,
      styledNodes: 0,
      replayedSubtrees: 0,
      repaintedSubtrees: 0,
      replayedOperations: 0,
      paintedFragments: 0,
      culledSubtrees: 0,
      glyphs: 0,
      primitives: 0,
      nodes: 0,
      fragments: 0,
    }
  }
}

/// Work the tree did since it was made, for the bench census (`UiTree.census`).
pub struct Work {
  pub mutations: usize,
  pub creates: usize,
  pub inserts: usize,
  pub setStyles: usize,
  pub styleDeclarations: usize,
  pub setTexts: usize,
  pub textBytes: usize,
  pub attributes: usize,
  pub listens: usize,
  pub batches: usize,
  /// `resolve` calls, and those that were a tick of the clock.
  pub resolves: usize,
  /// Nodes that kept their style under a changed variable scope (`UiTree.moveScope`).
  pub scopeMoves: usize,
  pub ticks: usize,
  /// `resolveSheet`: text nodes and sheetless trees skipped, records taken from a twin,
  /// matches run, and of those the ones the record cache answered.
  pub sheetSkips: usize,
  pub sheetTwins: usize,
  pub sheetMatches: usize,
  pub sheetCacheHits: usize,
  /// Computed values copied from a lender instead of built.
  pub lenders: usize,
  /// Lent nodes that took their lender's whole result: its style, font and paint keys and its
  /// layout style, with nothing built or keyed again.
  pub sharedResults: usize,
  /// Text nodes that took the style an equal parent's text child already had.
  pub textInherits: usize,
  pub styleShares: usize,
  pub frames: usize,
  pub styleFrames: usize,
  pub layoutFrames: usize,
  pub paintFrames: usize,
  pub hoverRefreshes: usize,
  pub paintedFragments: usize,
  pub culledSubtrees: usize,
  pub replayedSubtrees: usize,
  pub repaintedSubtrees: usize,
  pub replayedOperations: usize,
  pub paintedGlyphs: usize,
  /// css-layout's counters summed over every compute, and the passes that only moved scroll offsets.
  pub layoutPasses: usize,
  pub layoutFull: usize,
  pub layoutProbes: usize,
  pub layoutCacheHits: usize,
  pub layoutReused: usize,
  pub layoutMoves: usize,
  pub fragmentsResolved: usize,
  pub inlineLayouts: usize,
  pub plainLines: usize,
  pub linesEmitted: usize,
  pub attributeBytes: usize,
  /// `resolveStyles` calls, those that went past the early return, and the media conditions
  /// evaluated and rules walked by the environment update each call makes first.
  pub styleCalls: usize,
  pub stylePasses: usize,
  /// Passes that matched every node again, and the `restyle` calls that asked for one.
  pub fullStylePasses: usize,
  pub rootRestyles: usize,
  /// Matches that watched more elements than a match context holds, and the last such node.
  pub watchOverflows: usize,
  pub lastOverflow: usize,
  /// By the place that asked: requests for a full pass that found none due.
  pub dirtyCauses: [usize; 32],
  /// Why each node of a style pass resolved (`UiTree.resolveCause`).
  pub resolveCauses: [usize; 12],
  pub conditionsEvaluated: usize,
  pub conditionRulesWalked: usize,
  /// Calls JavaScript made into the host bindings, as the JS host last reported them.
  pub bridgeCalls: usize,
}

impl Work {
  pub fn zero() -> Work {
    return Work {
      mutations: 0, creates: 0, inserts: 0, setStyles: 0, styleDeclarations: 0, setTexts: 0, textBytes: 0, attributes: 0, listens: 0, batches: 0,
      resolves: 0, scopeMoves: 0, ticks: 0, sheetSkips: 0, sheetTwins: 0, sheetMatches: 0, sheetCacheHits: 0, lenders: 0, sharedResults: 0, textInherits: 0, styleShares: 0,
      frames: 0, styleFrames: 0, layoutFrames: 0, paintFrames: 0, hoverRefreshes: 0,
      paintedFragments: 0, culledSubtrees: 0, replayedSubtrees: 0, repaintedSubtrees: 0, replayedOperations: 0, paintedGlyphs: 0,
      layoutPasses: 0, layoutFull: 0, layoutProbes: 0, layoutCacheHits: 0, layoutReused: 0, layoutMoves: 0, fragmentsResolved: 0, inlineLayouts: 0, plainLines: 0, linesEmitted: 0, attributeBytes: 0, bridgeCalls: 0, styleCalls: 0, stylePasses: 0, fullStylePasses: 0, rootRestyles: 0, dirtyCauses: [0; 32], resolveCauses: [0; 12], watchOverflows: 0, lastOverflow: 0, conditionsEvaluated: 0, conditionRulesWalked: 0,
    }
  }
}

/// The paint cache of a node: the operations its subtree added to the scene of frame `frame`.
pub struct PaintCache {
  pub hash: u64,
  pub start: usize,
  pub end: usize,
  pub frame: u64,
  pub mask: Rect<f32>,
  pub scale: f32,
  /// The paint cull the subtree was painted under (see `Painter.cull`).
  pub cull: Rect<f32>,
}

impl Copy for PaintCache {}

impl PaintCache {
  pub fn empty() -> PaintCache {
    return PaintCache {
      hash: 0,
      start: 0,
      end: 0,
      frame: 0,
      mask: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
      scale: 0.0,
      cull: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
    }
  }
}

/// The paint caches of the nodes that painted a box, apart from the nodes: text nodes and nodes
/// never painted (most of a long document) hold none.
pub struct PaintCaches {
  entries: List<PaintCache>,
  free: List<u32>,
}

impl PaintCaches {
  pub fn make() -> PaintCaches {
    return PaintCaches { entries: List<PaintCache>.make(), free: List<u32>.make() }
  }

  /// The cache at `index`, or the empty one for NONE.
  pub fn get(self: &Self, index: u32) -> PaintCache {
    if index == NONE { return PaintCache.empty() }
    return self.entries.asSlice()[u32.toUsize(index)]
  }

  /// Writes `cache` at `index`, or into a new entry for NONE; returns the index.
  pub effect fn put(self: &mut Self, index: u32, cache: PaintCache) -> u32 ! OutOfMemoryError ? &mut Allocator {
    if index != NONE {
      let entries = self.entries.asMutSlice()
      entries[u32.toUsize(index)] = cache
      return index
    }
    if self.free.length() != 0 {
      let last = self.free.length() - 1
      let at = self.free.get(last)
      drop self.free.remove(last)
      let entries = self.entries.asMutSlice()
      entries[u32.toUsize(at)] = cache
      return at
    }
    let at = usize.toU32(self.entries.length())
    run self.entries.append(cache)
    return at
  }

  /// The entry at `index` to change in place; it must exist.
  pub fn at(self: &mut Self, index: u32) -> &mut PaintCache {
    return &mut self.entries.asMutSlice()[u32.toUsize(index)]
  }

  /// Gives `index` back, when it is one.
  pub effect fn release(self: &mut Self, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if index == NONE { return () }
    let entries = self.entries.asMutSlice()
    entries[u32.toUsize(index)] = PaintCache.empty()
    run self.free.append(index)
  }

  /// Drops every entry; the nodes' indices must be reset with it.
  pub fn clearAndFree(self: &mut Self) -> () {
    self.entries.clearAndFree()
    self.free.clearAndFree()
  }
}

/// See `Node.styleWatch`.
pub const WATCH_OUTSIDE: u32 = 8
/// See `Node.styleWatch`: another node's match evaluated a `:has()` anchored here, so a change
/// below can change styles below this node as well as its own.
pub const WATCH_HAS_FOR_OTHERS: u32 = 32768
/// See `Node.styleWatch`: a node that is not within 16 levels below this one asked its pointer
/// state: a sibling, a node under one, a `:has()` anchor above, a far descendant. Those say
/// `WATCH_OUTSIDE` themselves; without this bit only descendants that name the ancestor asked.
pub const WATCH_POINTER_FAR: u32 = 16384
/// See `Node.styleWatch`: the match of one of the node's pseudo-elements read the place of an
/// element among its siblings (`READS_INDEX`, `READS_SIBLINGS`, of the node or of an ancestor).
/// The node's own record says that of its own match (`Resolved.reads`).
pub const WATCH_PSEUDO_PLACE: u32 = 64
/// The bits other nodes' matches set on a node, which its own restyle keeps.
pub const WATCH_KEPT: u32 = 49207
/// Bit `16 + d - 1` of `Node.styleWatch`: the node's own match asked a pointer state of its
/// ancestor `d` levels up, for `d` up to 16. A twin taking its record asks the same of its own.
pub const ASKED_UP_SHIFT: u32 = 16

pub struct Node {
  pub id: u32,
  pub kind: NodeKind,
  pub live: bool,
  /// How many entries in `UiTree.transitions` belong to this node's current id.
  pub activeTransitions: u8,
  /// Whether `effects` holds declared paint effects rather than the tree's shared empty one.
  pub hasEffectsFlag: bool,
  /// The css-layout node.
  pub css: usize,
  /// An input's text node in css-layout.
  pub inner: usize,
  /// The parent slot, or NONE.
  pub parent: u32,
  pub base: List<Declaration>,
  /// The other looks, the transition text, the test id and the canvas commands: what most
  /// nodes leave empty, on the heap (see `NodeExtras`).
  pub extras: Thin<NodeExtras>,
  /// The computed style, shared with every node whose values are the same (see `style_pool`).
  /// Read it with [`Node.computed`]; `UiTree.setComputed` replaces it.
  pub styled: Frozen<Computed>,
  /// The computed style of a node an animation or a transition is moving, in place of
  /// `styled`: it changes every frame and no other node has it, so the node holds it alone
  /// and each frame writes it where it is (`UiTree.setMovingComputed`).
  pub moving: Thin<Computed>,
  pub fontKey: usize,
  pub paintHash: u64,
  pub text: String,
  pub accessRole: Role,
  pub tabIndex: i32,
  pub cursor: Cursor,
  pub disabled: bool,
  pub focusTrap: bool,
  /// `Attribute.Inert`: the node and its subtree take no focus or pointer input.
  pub inert: bool,
  /// `Attribute.Prevent`: the `PREVENT_*` flags.
  pub prevents: u32,
  /// `Attribute.Checked`, `Selected` and `Expanded`.
  pub checked: bool,
  pub selected: bool,
  pub expanded: bool,
  /// None of the node's parts (`::before`, `::selection`, scrollbar parts, ...) read a
  /// variable or declare one in the node's last resolve. What the node's own style reads is in
  /// its record (`Resolved.variables`).
  pub variableFree: bool,
  pub listeners: u32,
  pub hovered: bool,
  pub pressed: bool,
  /// The node's own style inputs changed since it was last resolved.
  pub styleDirty: bool,
  /// `styleDirty` only because an animation or transition moved on: the node's rules, state
  /// and variables are the ones its last resolve saw, so its match is still good.
  pub styleTick: bool,
  pub gridDeclared: bool,
  pub gridStyled: bool,
  pub styleNeedsContext: bool,
  /// A [`Move`] of this frame names the node: it paints as a group the renderer moves.
  pub sliding: bool,
  pub containerWatch: u32,
  pub styleChange: u32,
  pub generatedSuppressed: bool,
  /// A node under this one has `styleDirty`.
  pub subtreeDirty: bool,
  /// The node and its ancestors were displayed at its last style resolve: it has a
  /// before-change style for transitions.
  pub rendered: bool,
  /// What changed can reach the node's descendants through selectors (`UiTree.restyleLocal`):
  /// its whole subtree resolves again, not only the children whose inherited values change.
  pub styleSubtree: bool,
  pub resource: u32,
  /// An icon node's live svg (`Mutation.SvgInsert`), on the heap: drawn instead of its resource.
  pub svg: Thin<LiveSvg>,
  /// Bumped when the text, source or canvas changes, and for inputs when the caret, the
  /// selection or the composition does.
  pub content: u64,
  /// An input's editing state, on the heap: inputs get one when they are made, other nodes
  /// only when given an editing attribute (`Multiline`, `ReadOnly`, `Placeholder`).
  pub editing: Thin<EditState>,
  /// The paint effects the node declares (`filter`, `mask`, background layers...), shared
  /// across twins when identical; holds the tree's empty sentinel when `hasEffectsFlag` is false.
  pub effects: Frozen<Effects>,
  /// The ARIA states and properties most nodes do not have, on the heap: a node gets them
  /// with the first such attribute.
  pub semantics: Thin<Semantics>,
  /// The label, the value range, the scroll offset and the other state few nodes have (see
  /// `NodeRare`); read them through the node (`Node.label`, `Node.scrollX`, ...).
  pub rare: Thin<NodeRare>,
  pub resolvedSheet: Option<Frozen<Resolved>>,
  /// Nodes with one class hold one record and had equal selector inputs and ancestors when they
  /// took it; zero is no class. See `style_share`.
  pub styleClass: u32,
  /// The node this one took its record from, or NONE.
  pub styleTwin: u32,
  /// `svg_css.element.WATCH_*`: what selector matching asked of this node since the last root
  /// restyle, for its own style or another node's. With `WATCH_OUTSIDE`, the node's own match
  /// asked it of another node, so no twin may take its record without matching.
  pub styleWatch: u32,
  /// Names the computed values the node holds: a fresh number each time they are computed, the
  /// lender's when they are copied. Zero is none yet.
  pub computedStamp: u32,
  pub selectorIdentity: Thin<NodeIdentity>,
  /// The node's entry in the tree's `PaintCaches`, or NONE: only boxes paint get one.
  pub paintCache: u32,
  /// The variable scope the node holds in place of its record's, or NONE: an ancestor's
  /// variables changed and the node reads none of those that did, so it kept its record and
  /// moved under the new scope (`UiTree.moveScope`). Read the scope through `sheetScope`.
  pub movedScope: u32,
}

/// What a node may hold and most do not: a node gets one with the first of these it is given.
/// Each is a list or a text, whose header alone is 64 bytes, and a long document has tens of
/// thousands of nodes; in the node they were half of it. Read them through the node
/// (`Node.hover`, `Node.transition`, ...), which gives the empty value for a node without them.
pub struct NodeExtras {
  pub hover: List<Declaration>,
  pub active: List<Declaration>,
  pub focus: List<Declaration>,
  pub focusVisible: List<Declaration>,
  /// The `@starting-style` look (see `StyleState.Starting`).
  pub starting: List<Declaration>,
  /// `Attribute.Transition`: CSS `transition` text applied under the base declarations.
  pub transition: String,
  pub testId: String,
  pub canvas: List<CanvasCommand>,
  /// The GPU surface a canvas node shows (`Mutation.SetCanvasSurface`), or `NO_SURFACE`.
  pub surface: CanvasSurface,
  /// The bitmap a large canvas's commands were drawn into once (see `canvas_raster`).
  pub raster: CanvasRaster,
}

/// The GPU surface of a canvas node: the host's number for it, its natural size in CSS pixels
/// and whether it is opaque.
pub struct CanvasSurface {
  pub id: u32,
  pub width: u32,
  pub height: u32,
  pub opaque: bool,
}

impl Copy for CanvasSurface {}

impl CanvasSurface {
  pub fn none() -> CanvasSurface {
    return CanvasSurface { id: NO_SURFACE, width: 0, height: 0, opaque: false }
  }

  pub fn isSome(self: Self) -> bool {
    return self.id != NO_SURFACE
  }
}

/// A canvas node's commands drawn once into a bitmap the window shows through surface
/// `surface`, painted as one sprite while its key holds (see `canvas_raster`).
pub struct CanvasRaster {
  pub surface: u32,
  /// The `canvas_raster.key` of the bitmap shown, and where it is: in device pixels from the
  /// device pixel at or above and left of the content box's corner.
  pub key: u64,
  pub x: i32,
  pub y: i32,
  pub width: u32,
  pub height: u32,
  /// Counts the bitmaps shown: part of the node's paint hash, so that a subtree paint replays
  /// paints again when one is ready.
  pub stamp: u32,
  /// A key whose bitmap would be too large to draw: paint draws the commands.
  pub refused: u64,
}

impl Copy for CanvasRaster {}

impl CanvasRaster {
  pub fn none() -> CanvasRaster {
    return CanvasRaster { surface: NO_SURFACE, key: 0, x: 0, y: 0, width: 0, height: 0, stamp: 0, refused: 0 }
  }
}

impl NodeExtras {
  pub fn make() -> NodeExtras {
    return NodeExtras {
      hover: List<Declaration>.make(),
      active: List<Declaration>.make(),
      focus: List<Declaration>.make(),
      focusVisible: List<Declaration>.make(),
      starting: List<Declaration>.make(),
      transition: String.make(),
      testId: String.make(),
      canvas: List<CanvasCommand>.make(),
      surface: CanvasSurface.none(),
      raster: CanvasRaster.none(),
    }
  }
}

/// What only some nodes have, on the heap: a node gets one with the first of these it is given.
pub struct NodeRare {
  pub label: String,
  pub hasValueRange: bool,
  pub valueMin: f32,
  pub valueMax: f32,
  pub valueNow: f32,
  /// The scroll offset of a scroll container, clamped to its range at the last frame.
  pub scrollX: f32,
  pub scrollY: f32,
  /// The bounds the last `layout` event reported, once one was.
  pub layoutReported: bool,
  pub reportedBounds: Rect<f32>,
  /// Where the node's `offset-path` puts it, from the last layout (see `offset_path.settle`).
  pub offsetPlaced: Option<Placement>,
}

impl NodeRare {
  pub fn make() -> NodeRare {
    return NodeRare {
      label: String.make(),
      hasValueRange: false,
      valueMin: 0.0,
      valueMax: 0.0,
      valueNow: 0.0,
      scrollX: 0.0,
      scrollY: 0.0,
      layoutReported: false,
      reportedBounds: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
      offsetPlaced: Option<Placement>.None,
    }
  }
}

/// A node's rarer accessibility attributes, named and valued as their `Attribute`s.
pub struct Semantics {
  pub level: i32,
  pub description: String,
  pub roleDescription: String,
  pub valueText: String,
  pub hidden: bool,
  pub live: Live,
  pub atomic: bool,
  pub busy: bool,
  pub pressed: TriState,
  pub indeterminate: bool,
  pub required: bool,
  pub invalid: bool,
  pub multiSelectable: bool,
  pub orientation: Orientation,
  pub posInSet: i32,
  pub setSize: i32,
  pub modal: bool,
  /// Client ids, as the relation attributes carry them.
  pub literalRelations: u32,
  pub labelledBy: List<u32>,
  pub describedBy: List<u32>,
  pub controls: List<u32>,
  pub activeDescendant: List<u32>,
}

impl Semantics {
  pub fn make() -> Semantics {
    return Semantics {
      level: 0,
      description: String.make(),
      roleDescription: String.make(),
      valueText: String.make(),
      hidden: false,
      live: Live.Off,
      atomic: false,
      busy: false,
      pressed: TriState.Unset,
      indeterminate: false,
      required: false,
      invalid: false,
      multiSelectable: false,
      orientation: Orientation.Unset,
      posInSet: 0,
      setSize: 0,
      modal: false,
      literalRelations: 0,
      labelledBy: List<u32>.make(),
      describedBy: List<u32>.make(),
      controls: List<u32>.make(),
      activeDescendant: List<u32>.make(),
    }
  }
}

impl Node {
  /// The node's computed style.
  @inlineAlways
  pub fn computed(self: &Self) -> &Computed {
    return match self.moving.get() {
      Option<&Computed>.Some { value } => value
      Option<&Computed>.None => self.styled.get()
    }
  }

  /// The node's rarer parts, when it was given any (see `NodeExtras`).
  pub fn extrasOf(self: &Self) -> Option<&NodeExtras> {
    return self.extras.get()
  }

  /// The node's rarer parts to change, made on first use.
  pub effect fn extrasMut(self: &mut Self) -> &mut NodeExtras ! OutOfMemoryError ? &mut Allocator {
    return run self.extras.getOrMake(NodeExtras.make)
  }

  /// The node's rarer parts to change, when it has them.
  pub fn extrasHeld(self: &mut Self) -> Option<&mut NodeExtras> {
    return self.extras.getMut()
  }

  /// The `:hover` look.
  pub fn hover(self: &Self) -> &[Declaration] {
    return match self.extrasOf() { Option.Some { value } => value.hover.asSlice() _ => &[] }
  }

  /// The `:active` look.
  pub fn active(self: &Self) -> &[Declaration] {
    return match self.extrasOf() { Option.Some { value } => value.active.asSlice() _ => &[] }
  }

  /// The `:focus` look.
  pub fn focus(self: &Self) -> &[Declaration] {
    return match self.extrasOf() { Option.Some { value } => value.focus.asSlice() _ => &[] }
  }

  /// The `:focus-visible` look.
  pub fn focusVisible(self: &Self) -> &[Declaration] {
    return match self.extrasOf() { Option.Some { value } => value.focusVisible.asSlice() _ => &[] }
  }

  /// The `@starting-style` look (see `StyleState.Starting`).
  pub fn starting(self: &Self) -> &[Declaration] {
    return match self.extrasOf() { Option.Some { value } => value.starting.asSlice() _ => &[] }
  }

  /// `Attribute.Transition`: CSS `transition` text applied under the base declarations.
  pub fn transition(self: &Self) -> string {
    return match self.extrasOf() { Option.Some { value } => String.view(&value.transition) _ => "" }
  }

  pub fn hasTransition(self: &Self) -> bool {
    return match self.extrasOf() { Option.Some { value } => value.transition.ownedByteLength() != 0 _ => false }
  }

  pub fn testId(self: &Self) -> string {
    return match self.extrasOf() { Option.Some { value } => String.view(&value.testId) _ => "" }
  }

  /// The drawing commands of a canvas node.
  pub fn canvas(self: &Self) -> &[CanvasCommand] {
    return match self.extrasOf() { Option.Some { value } => value.canvas.asSlice() _ => &[] }
  }

  /// The GPU surface of a canvas node, `CanvasSurface.none()` without one.
  pub fn surface(self: &Self) -> CanvasSurface {
    return match self.extrasOf() { Option.Some { value } => value.surface _ => CanvasSurface.none() }
  }

  /// The cached bitmap of a canvas node's commands, `CanvasRaster.none()` without one.
  pub fn raster(self: &Self) -> CanvasRaster {
    return match self.extrasOf() { Option.Some { value } => value.raster _ => CanvasRaster.none() }
  }

  pub fn generatedOrigin(self: &Self) -> u32 {
    return match self.identity() { Option.Some { value } => value.generatedOrigin _ => NONE }
  }

  pub fn pseudoElement(self: &Self) -> string<'static> {
    return match self.identity() {
      Option.Some { value } => match value.generatedTarget {
        PseudoTarget.Before => "::before"
        PseudoTarget.After => "::after"
        PseudoTarget.Marker => "::marker"
        _ => ""
      }
      _ => ""
    }
  }
  pub fn isGenerated(self: &Self) -> bool { return self.generatedOrigin() != NONE }

  pub fn sheetStyle(self: &Self) -> Option<&Resolved> {
    return match &self.resolvedSheet {
      Option<Frozen<Resolved>>.Some { value } => Option<&Resolved>.some(value.get())
      _ => Option<&Resolved>.None
    }
  }

  pub fn sheetScope(self: &Self) -> Option<ScopeId> {
    if self.movedScope != NONE && self.resolvedSheet.isSome() { return Option<ScopeId>.some(ScopeId { index: u32.toUsize(self.movedScope) }) }
    return match &self.resolvedSheet {
      Option<Frozen<Resolved>>.Some { value } => Option<ScopeId>.some(value.get().scope)
      _ => Option<ScopeId>.None
    }
  }

  pub fn identity(self: &Self) -> Option<&NodeIdentity> {
    return self.selectorIdentity.get()
  }

  pub effect fn identityMut(self: &mut Self) -> &mut NodeIdentity ! OutOfMemoryError ? &mut Allocator {
    return run self.selectorIdentity.getOrMake(NodeIdentity.make)
  }

  /// The node's live svg, made empty on first use.
  pub effect fn liveSvg(self: &mut Self) -> &mut LiveSvg ! OutOfMemoryError ? &mut Allocator {
    if self.svg.isNone() {
      self.svg.set(run Thin<LiveSvg>.make(run LiveSvg.make()))
    }
    return self.svg.expectMut()
  }

  /// Whether the node declares paint effects.
  pub fn hasEffects(self: &Self) -> bool {
    return self.hasEffectsFlag
  }

  /// The node's paint effects, when it declares any.
  pub fn paintEffects(self: &Self) -> Option<&Effects> {
    return if self.hasEffectsFlag { Option<&Effects>.some(self.effects.get()) } else { Option<&Effects>.None }
  }

  /// Whether the node has editing state: every input does.
  pub fn hasEdit(self: &Self) -> bool {
    return self.editing.isSome()
  }

  /// The editing state; the node must have one (`hasEdit`), as inputs do.
  pub fn edit(self: &Self) -> &EditState {
    return self.editing.expect()
  }

  /// The editing state to change; the node must have one (`hasEdit`), as inputs do.
  pub fn editMut(self: &mut Self) -> &mut EditState {
    return self.editing.expectMut()
  }

  /// The node's rarer accessibility attributes, when it was given any.
  pub fn semanticsOf(self: &Self) -> Option<&Semantics> {
    return self.semantics.get()
  }

  /// The node's rarer accessibility attributes to change, made on first use.
  pub effect fn semanticsMut(self: &mut Self) -> &mut Semantics ! OutOfMemoryError ? &mut Allocator {
    return run self.semantics.getOrMake(Semantics.make)
  }

  /// The label (`Attribute.Label`).
  pub fn label(self: &Self) -> string {
    return match self.rare.get() { Option.Some { value } => String.view(&value.label) _ => "" }
  }

  pub fn hasLabel(self: &Self) -> bool {
    return match self.rare.get() { Option.Some { value } => value.label.ownedByteLength() != 0 _ => false }
  }

  /// Whether the node has a value range (`Attribute.ValueRange` or numeric ARIA).
  pub fn hasValueRange(self: &Self) -> bool {
    return match self.rare.get() { Option.Some { value } => value.hasValueRange _ => false }
  }

  pub fn valueMin(self: &Self) -> f32 {
    return match self.rare.get() { Option.Some { value } => value.valueMin _ => 0.0 }
  }

  pub fn valueMax(self: &Self) -> f32 {
    return match self.rare.get() { Option.Some { value } => value.valueMax _ => 0.0 }
  }

  pub fn valueNow(self: &Self) -> f32 {
    return match self.rare.get() { Option.Some { value } => value.valueNow _ => 0.0 }
  }

  /// The scroll offset of a scroll container, clamped to its range at the last frame.
  pub fn scrollX(self: &Self) -> f32 {
    return match self.rare.get() { Option.Some { value } => value.scrollX _ => 0.0 }
  }

  pub fn scrollY(self: &Self) -> f32 {
    return match self.rare.get() { Option.Some { value } => value.scrollY _ => 0.0 }
  }

  /// Where the node's `offset-path` puts it, from the last layout.
  pub fn offsetPlaced(self: &Self) -> Option<Placement> {
    return match self.rare.get() { Option.Some { value } => value.offsetPlaced _ => Option<Placement>.None }
  }

  /// The rarer state to change, made on first use.
  pub effect fn rareMut(self: &mut Self) -> &mut NodeRare ! OutOfMemoryError ? &mut Allocator {
    return run self.rare.getOrMake(NodeRare.make)
  }

  /// Sets the scroll offset; a node that never scrolled gets no record for a zero offset.
  pub effect fn setScroll(self: &mut Self, x: f32, y: f32) -> () ! OutOfMemoryError ? &mut Allocator {
    if x == 0.0 && y == 0.0 && self.rare.isNone() { return () }
    let rare = run self.rareMut()
    rare.scrollX = x
    rare.scrollY = y
  }

  /// Gives the node editing state when it has none.
  pub effect fn ensureEdit(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if !self.hasEdit() {
      self.editing.set(run Thin<EditState>.make(EditState.make()))
    }
  }
}

/// A raster face per font key, loaded on first use.
pub struct FaceSlot<'a> {
  pub loaded: bool,
  pub face: Thin<FontFace<'a>>,
}

/// A tile's pixels: `length` bytes at `offset` in [`Pending.bytes`], rows tightly packed.
pub struct Upload {
  pub tile: AtlasTile,
  pub offset: usize,
  pub length: usize,
}

impl Copy for Upload {}

/// The tiles a frame allocated in the atlas, gathered from the glyph cache, the icon cache and
/// the image store so a renderer copies them in one loop.
pub struct Pending {
  list: List<Upload>,
  data: List<u8>,
}

impl Pending {
  pub fn make() -> Pending {
    return Pending { list: List<Upload>.make(), data: List<u8>.make() }
  }

  /// Queues `tile` with `bytesPerRow`-byte rows starting at `offset` in `source`.
  pub effect fn push(
    self: &mut Self,
    tile: AtlasTile,
    source: &[u8],
    offset: usize,
    bytesPerRow: u32,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let rows = tile.bounds.yMax - tile.bounds.yMin
    let length = u32.toUsize(bytesPerRow) * u32.toUsize(rows)
    let at = self.data.length()
    run self.data.appendSlice(Slice.view(source, offset, length))
    run self.list.append(Upload { tile: tile, offset: at, length: length })
  }

  pub fn entries(self: &Self) -> &[Upload] {
    return self.list.asSlice()
  }

  /// Queues every upload of `other` after this one's, in order, for a renderer that takes a
  /// copy of a frame's uploads to another thread.
  pub effect fn appendAll(self: &mut Self, other: &Pending) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let base = self.data.length()
    run self.data.appendSlice(other.data.asSlice())
    let list = other.list.asSlice()
    let mut i: usize = 0
    while i < list.length {
      run self.list.append(
        Upload { tile: list[i].tile, offset: base + list[i].offset, length: list[i].length },
      )
      i = i + 1
    }
  }

  /// The pixels of `upload`.
  pub fn pixels(self: &Self, upload: Upload) -> &[u8] {
    return Slice.view(self.data.asSlice(), upload.offset, upload.length)
  }

  pub fn clear(self: &mut Self) -> () {
    self.list.clear()
    self.data.clear()
  }
}

/// The bit that marks the scroll link of a [`Move`]: the node's id with it set, so it never
/// meets the id of a scroll container.
pub const MOVE_LINK: u32 = 2147483648

/// How many points of a [`Move`]'s easing are kept.
pub const MOVE_CURVE: usize = 17

/// A `translate` transition a renderer can run by itself: the node paints as a scroll group
/// that follows link `node`, whose position is the node's translation, and the renderer puts
/// it where the transition is at each frame it draws, new frame from the tree or not. So a
/// screen keeps sliding while the thread that owns the tree is busy.
pub struct Move {
  /// The scroll link and position this move drives: [`MOVE_LINK`] with the node's id.
  pub node: u32,
  pub slot: u32,
  /// The translation the transition starts at and ends at, in CSS pixels.
  pub fromX: f32,
  pub fromY: f32,
  pub toX: f32,
  pub toY: f32,
  /// When the active phase starts, on the tree's frame clock: it names the transition, the
  /// same from frame to frame.
  pub began: f64,
  /// Seconds of the active phase run when the frame was painted: negative during the delay.
  pub elapsed: f64,
  pub duration: f64,
  /// The easing's output at [`MOVE_CURVE`] evenly spaced inputs from 0 to 1.
  pub curve: [f32; 17],
}

impl Copy for Move {}

impl Move {
  /// The eased progress after `seconds` of the active phase.
  pub fn eased(self: &Self, seconds: f64) -> f32 {
    if seconds <= 0.0 {
      return self.curve[0]
    }
    if self.duration <= 0.0 || seconds >= self.duration {
      return self.curve[MOVE_CURVE - 1]
    }
    let at = f64.toF32(seconds / self.duration) * 16.0
    let low = f32.floor(at)
    let index = f32.toUsize(low)
    if index + 1 >= MOVE_CURVE {
      return self.curve[MOVE_CURVE - 1]
    }
    let part = at - low
    return self.curve[index] + (self.curve[index + 1] - self.curve[index]) * part
  }

  /// Whether the transition is over after `seconds` of the active phase.
  pub fn over(self: &Self, seconds: f64) -> bool {
    return seconds >= self.duration
  }
}
