/// Conservative local device-pixel ink bounds of a horizontal raster glyph run.
/// Bounds contain no atlas references and remain useful when tiles are evicted.
pub struct TextInk {
  pub valid: bool,
  pub present: bool,
  pub font: u32,
  pub shape: u64,
  pub scale: f32,
  pub bounds: Rect<f32>,
}

impl Copy for TextInk {}

impl TextInk {
  pub fn empty() -> TextInk {
    return TextInk {
      valid: false,
      present: false,
      font: 0,
      shape: 0,
      scale: 0.0,
      bounds: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
    }
  }
}

/// Everything a frame's paint reads and writes, borrowed from the tree.
pub struct Painter<'p, 'a> {
  pub nodes: &'p mut List<Node>,
  pub caches: &'p mut PaintCaches,
  pub slotOfCss: &'p List<u32>,
  pub css: &'p LayoutTable,
  pub output: &'p LayoutTree,
  pub text: &'p TextSystem<'a>,
  pub faces: &'p List<FaceSlot<'a>>,
  pub fontRules: &'p FontRules,
  pub sheetFaces: &'p SheetFaces,
  /// The root being painted.
  pub root: u32,
  pub atlas: &'p mut Atlas,
  pub glyphs: &'p mut GlyphCache,
  pub textInk: &'p mut List<TextInk>,
  /// The first line boxes with a `::first-line` style (see `firstLineOver`).
  pub firstLines: &'p List<first_letter.FirstLine>,
  pub resources: &'p mut Resources<'a>,
  pub paths: &'p mut PathCache,
  /// Bitmaps of large canvases: paint asks for them and shows the ready ones (`canvas_raster`).
  pub rasters: &'p mut CanvasRasters,
  pub scene: &'p mut Scene,
  pub previous: &'p Scene,
  pub replayable: bool,
  /// Whether no scroll offset changed since the previous frame: then subtrees holding scroll
  /// containers can be replayed too.
  pub scrollsStill: bool,
  /// Scroll offsets each scroll container in `previous` was actually painted (culled) at.
  pub paintedScrolls: &'p [ScrollPosition],
  pub hashes: &'p List<u64>,
  /// Per fragment: the bounds of its subtree's ink, from [`inkFragments`].
  pub ink: &'p List<Rect<f32>>,
  /// Per fragment: whether its subtree holds a scroll container, which paint never replays.
  pub scrollers: &'p List<bool>,
  /// Per fragment: where stacking paints it, from `stacking.stackFragments`.
  pub stacking: &'p Stacking,
  /// What paint keeps, in device pixels of the current scroll group: subtrees whose ink misses it
  /// are skipped. Inside a scroll container it reaches `lead` past the scrollport, so a renderer
  /// that scrolls on its own has content to show.
  pub cull: Rect<f32>,
  pub lead: f32,
  /// The viewport in CSS pixels, for sticky boxes without a scroll container.
  pub width: f32,
  pub height: f32,
  pub stats: &'p mut FrameStats,
  pub order: &'p mut List<u32>,
  /// What the document's text selection covers (`text_selection.Selected`, by slot).
  pub selected: &'p List<Selected>,
  /// The caret of the focused editing host (`text_selection.TextSelection.caret`): a text
  /// node and byte offset, or an element and child index; NONE when no caret shows.
  pub caretSlot: u32,
  pub caretOffset: usize,
  /// Per css-layout node: its first fragment (`UiTree.fragmentOf`).
  pub firstOf: &'p List<usize>,
  pub frame: u64,
  /// The `translate` transitions the renderer runs (`UiTree.moves`).
  pub moves: &'p List<Move>,
  /// The frame the previous scene was painted at. Frames are numbered across the tree's roots,
  /// so a subtree cached then was cached by this root.
  pub previousFrame: u64,
  pub scale: f32,
  pub time: f64,
  pub seed: HashSeed,
  /// When set, only the subtree of this slot is painted and nothing is cached.
  pub only: u32,
  pub inside: bool,
  /// Whether any style preserves 3D (`UiTree.preserveUsed`).
  pub planes: bool,
}

fn slotIn(slots: &List<u32>, index: usize) -> u32 {
  if index < slots.length() {
    return slots.get(index)
  }
  return NONE
}

/// The slot of the element whose style a fragment of css-layout node `source` paints with: the
/// node itself, or for text, the nearest element above it.
pub fn styleSlot(slots: &List<u32>, css: &LayoutTable, nodes: &List<Node>, source: usize) -> u32 {
  let mut at = source
  while at != NO_INDEX && at < css.nodeCount() {
    let slot = slotIn(slots, at)
    if slot != NONE && nodes.asSlice()[u32.toUsize(slot)].kind != NodeKind.Text {
      return slot
    }
    at = css.parent(at)
  }
  return NONE
}

pub fn device(rect: Rect<f32>, scale: f32) -> Rect<f32> {
  return Rect<f32>.new(rect.xMin * scale, rect.yMin * scale, rect.xMax * scale, rect.yMax * scale)
}

/// `rect` with its edges on whole device pixels, as browsers paint box decorations: a
/// one-pixel border at y = 10.5 stays one crisp pixel instead of two half-covered ones.
pub fn snapped(rect: Rect<f32>) -> Rect<f32> {
  return Rect<f32>.new(
    f32.round(rect.xMin),
    f32.round(rect.yMin),
    f32.round(rect.xMax),
    f32.round(rect.yMax),
  )
}

/// A border width in whole device pixels, at least one when it is not zero (CSS Values 4
/// snaps used border widths this way).
fn borderWidth(width: f32) -> f32 {
  if width > 0.0 && width < 1.0 {
    return 1.0
  }
  return f32.floor(width)
}

/// The border box of fragment `f` in CSS pixels of the viewport.
pub fn borderBox(f: &Fragment) -> Rect<f32> {
  return Rect<f32>.new(
    f.worldLocation.x,
    f.worldLocation.y,
    f.worldLocation.x + f.size.width,
    f.worldLocation.y + f.size.height,
  )
}

pub fn paddingBox(f: &Fragment) -> Rect<f32> {
  let x = f.worldLocation.x + f.paddingRect.x
  let y = f.worldLocation.y + f.paddingRect.y
  return Rect<f32>.new(x, y, x + f.paddingRect.width, y + f.paddingRect.height)
}

/// The actual per-axis overflow clip, shared by paint, ink pruning and pointer traversal.
/// A visible axis remains unbounded (not the other axis's padding extent).
pub fn overflowClip(c: &Computed, f: &Fragment) -> Rect<f32> {
  let padding = paddingBox(f)
  let clipX = usedOverflow(c, true) != Overflow.Visible || c.contain.paint()
  let clipY = usedOverflow(c, false) != Overflow.Visible || c.contain.paint()
  return Rect<f32>.new(
    if clipX {
      padding.xMin
    } else {
      -UNBOUNDED_INK
    },
    if clipY {
      padding.yMin
    } else {
      -UNBOUNDED_INK
    },
    if clipX {
      padding.xMax
    } else {
      UNBOUNDED_INK
    },
    if clipY {
      padding.yMax
    } else {
      UNBOUNDED_INK
    },
  )
}

/// The overflow clip of fragment `f` (node `slot`, style `c`) as a device-pixel mask. When both
/// axes clip, the padding box's rounded corners clip too.
fn clipMask(p: &Painter<'_, '_>, slot: u32, c: &Computed, f: &Fragment) -> ContentMask {
  let clip = device(overflowClip(c, f), p.scale)
  let both = usedOverflow(c, true) != Overflow.Visible && usedOverflow(c, false) != Overflow.Visible
  if !(both || c.contain.paint()) {
    return ContentMask.new(clip)
  }
  let r = radiiOf(p, slot, c, f)
  if !r.isRounded() {
    return ContentMask.new(clip)
  }
  return ContentMask.rounded(clip, r.scaled(p.scale).insetTo(device(borderBox(f), p.scale), clip))
}

pub fn contentBox(f: &Fragment) -> Rect<f32> {
  let x = f.worldLocation.x + f.contentRect.x
  let y = f.worldLocation.y + f.contentRect.y
  return Rect<f32>.new(x, y, x + f.contentRect.width, y + f.contentRect.height)
}

/// The corner radii of fragment `f`'s border box with style `c`, in CSS pixels, as CSS resolves
/// them: horizontal percentages of the width, vertical ones of the height, all shrunk together
/// when they overlap.
pub fn radiiOf(p: &Painter<'_, '_>, slot: u32, c: &Computed, f: &Fragment) -> Radii {
  return radiiIn(p, slot, c, f.size.width, f.size.height)
}

/// Whether style `c` rounds any corner.
pub fn rounds(c: &Computed) -> bool {
  let r = c.paint.radii
  return c.effects.radiusShare || r.topLeft > 0.0 || r.topRight > 0.0 || r.bottomRight > 0.0 || r.bottomLeft > 0.0
}

/// The corner radii of node `slot` with style `c` over a `width` by `height` border box.
pub fn radiiIn(p: &Painter<'_, '_>, slot: u32, c: &Computed, width: f32, height: f32) -> Radii {
  let r = c.paint.radii
  if !c.effects.radiusShare || slot == NONE {
    if r.topLeft <= 0.0 && r.topRight <= 0.0 && r.bottomRight <= 0.0 && r.bottomLeft <= 0.0 {
      return Radii.zero()
    }
    return Radii.circular(r).fitted(width, height)
  }
  return nodeRadii(&p.nodes.asSlice()[u32.toUsize(slot)], c, width, height)
}

/// The corner radii of `node` with style `c` over a `width` by `height` border box.
pub fn nodeRadii(node: &Node, c: &Computed, width: f32, height: f32) -> Radii {
  let r = c.paint.radii
  if c.effects.radiusShare {
    match node.paintEffects() {
      Option<&Effects>.Some { value } => {
        return resolvedRadii(r, value, width, height)
      }
      Option<&Effects>.None => {}
    }
  }
  if r.topLeft <= 0.0 && r.topRight <= 0.0 && r.bottomRight <= 0.0 && r.bottomLeft <= 0.0 {
    return Radii.zero()
  }
  return Radii.circular(r).fitted(width, height)
}

/// Whether (`x`, `y`) lies inside `rect` with corners `radii`, as hit testing follows them.
pub fn insideRounded(rect: Rect<f32>, radii: Radii, x: f32, y: f32) -> bool {
  if x < rect.xMin || y < rect.yMin || x >= rect.xMax || y >= rect.yMax {
    return false
  }
  if !radii.isRounded() {
    return true
  }
  let left = x < (rect.xMin + rect.xMax) * 0.5
  let up = y < (rect.yMin + rect.yMax) * 0.5
  let ex = cornerOf(radii.x, left, up)
  let ey = cornerOf(radii.y, left, up)
  if ex <= 0.0 || ey <= 0.0 {
    return true
  }
  let dx = if left { rect.xMin + ex - x } else { x - (rect.xMax - ex) }
  let dy = if up { rect.yMin + ey - y } else { y - (rect.yMax - ey) }
  if dx <= 0.0 || dy <= 0.0 {
    return true
  }
  let nx = dx / ex
  let ny = dy / ey
  return nx * nx + ny * ny <= 1.0
}

/// Radii with horizontal lengths `r` and the rest from `effects`, over a `width` by `height` box.
pub fn resolvedRadii(r: Corners<f32>, effects: &Effects, width: f32, height: f32) -> Radii {
  let w = f32.max(0.0, width)
  let h = f32.max(0.0, height)
  let px = effects.radii
  let py = effects.radiiY
  let ly = effects.lengthsY
  return Radii.new(
    Corners<f32>.new(r.topLeft + px.topLeft * w, r.topRight + px.topRight * w, r.bottomRight + px.bottomRight * w, r.bottomLeft + px.bottomLeft * w),
    Corners<f32>.new(ly.topLeft + py.topLeft * h, ly.topRight + py.topRight * h, ly.bottomRight + py.bottomRight * h, ly.bottomLeft + py.bottomLeft * h),
  ).fitted(width, height)
}

fn backgroundOf(fill: Fill) -> Background {
  return match fill {
    Fill.None => Background.solid(Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 })
    Fill.Solid { color } => Background.solid(color)
    Fill.Gradient { angle, from, to } => Background.linear(angle, from, to)
  }
}

/// `empty-cells: hide` on a cell with nothing in flow, in a table with separate borders.
fn emptyHidden(c: &Computed, f: &Fragment) -> bool {
  return c.emptyCellsHide && f.firstChild == NO_INDEX && c.layout.borderCollapse == BorderCollapse.Separate
    && c.layout.display.insideIs(DisplayInside.TableCell)
}

fn hasEdge(edges: u8, bit: u8) -> bool {
  return u8.bitAnd(edges, bit) != 0
}

/// `r` with the corners on the sides `edges` leaves out (a box split across lines) square.
fn cutCorners(r: Corners<f32>, edges: u8) -> Corners<f32> {
  let mut c = r
  if !hasEdge(edges, 1) {
    c.topLeft = 0.0
    c.topRight = 0.0
  }
  if !hasEdge(edges, 2) {
    c.topRight = 0.0
    c.bottomRight = 0.0
  }
  if !hasEdge(edges, 4) {
    c.bottomRight = 0.0
    c.bottomLeft = 0.0
  }
  if !hasEdge(edges, 8) {
    c.topLeft = 0.0
    c.bottomLeft = 0.0
  }
  return c
}

/// Draws the shadow, background and border of a box with computed style `c` over `rect`
/// (CSS pixels). `edges` says which edges are drawn (bits top 1, right 2, bottom 4, left 8),
/// as a span split across lines draws only some.
/// Whether node `slot` has background image layers to paint.
fn hasBackgrounds(p: &Painter<'_, '_>, slot: u32) -> bool {
  if slot == NONE {
    return false
  }
  return match p.nodes.asSlice()[u32.toUsize(slot)].paintEffects() {
    Option<&Effects>.Some { value } => value.backgrounds.painted()
    Option<&Effects>.None => false
  }
}

/// Whether node `slot` draws a `border-image`.
fn hasBorderImage(p: &Painter<'_, '_>, slot: u32) -> bool {
  if slot == NONE {
    return false
  }
  return match p.nodes.asSlice()[u32.toUsize(slot)].paintEffects() {
    Option<&Effects>.Some { value } => value.borderImageDrawn()
    Option<&Effects>.None => false
  }
}

/// The border widths of a box with computed style `c`, zero under `border-style: none`.
pub fn usedBorder(c: &Computed) -> Insets<f32> {
  if c.paint.borderStyle == StyleBorder.None { return Insets<f32>.zero() }
  return c.paint.border
}

/// Whether node `slot` has a `background-blend-mode` layer.
fn blendsBackgrounds(p: &Painter<'_, '_>, slot: u32) -> bool {
  return match p.nodes.asSlice()[u32.toUsize(slot)].paintEffects() {
    Option<&Effects>.Some { value } => value.backgrounds.blended()
    Option<&Effects>.None => false
  }
}

/// The `background-clip` of node `slot`'s background color.
fn colorClipOf(p: &Painter<'_, '_>, slot: u32) -> Clip {
  if slot == NONE {
    return Clip.Border
  }
  return match p.nodes.asSlice()[u32.toUsize(slot)].paintEffects() {
    Option<&Effects>.Some { value } => value.backgrounds.colorClip()
    Option<&Effects>.None => Clip.Border
  }
}

/// Whether node `slot` paints some of its background into its text (`background-clip: text`).
fn textClipped(p: &Painter<'_, '_>, slot: u32) -> bool {
  if slot == NONE {
    return false
  }
  return match p.nodes.asSlice()[u32.toUsize(slot)].paintEffects() {
    Option<&Effects>.Some { value } => value.backgrounds.textClipped()
    Option<&Effects>.None => false
  }
}

/// Paints the `background-clip: text` part of box `index`'s background (node `slot`, style
/// `c`): the color and layers over the border box, masked by the glyphs of the text inside.
effect fn paintTextClip(
  p: &mut Painter<'_, '_>,
  index: usize,
  slot: u32,
  c: &Computed,
  f: &Fragment,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = p.scale
  let bounds = snapped(device(borderBox(f), s))
  // The layer is the box, not everything its mask lets through: the background reaches no
  // further, and a layer's texture is as large as its bounds.
  drop run p.scene.pushEffectLayer(
    bounds,
    mask,
    Isolation { opacity: 1.0, blend: 0 },
    LayerEffects.none(),
  )
  drop run p.scene.pushMaskLayer()
  run paintGlyphMask(&mut p, index, mask)
  run p.scene.popLayer()
  let background = backgroundOf(c.paint.background)
  let radii = radiiOf(&p.*, slot, c, f).scaled(s)
  if colorClipOf(&p.*, slot) == Clip.Text && !background.isTransparent() {
    let mut quad = Quad.fill(bounds, mask, background)
    quad.cornerRadii = radii
    drop run p.scene.quad(quad)
  }
  let held = paint_effects.cloneEffects(&p.*, slot)
  match &held {
    Option<Frozen<Effects>>.Some { value } => {
      let effects = value.get()
      run paint_effects.paintLayers(&mut p, effects, &effects.backgrounds, f, radii, mask, GeometryBox.Padding, true, c.nearest, backgroundScope(c), Rect<f32>.new(0.0, 0.0, 0.0, 0.0))
    }
    Option<Frozen<Effects>>.None => {}
  }
  run p.scene.popLayer()
}

/// The glyphs of the text inside fragment `index`, opaque, for a mask.
effect fn paintGlyphMask(p: &mut Painter<'_, '_>, index: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let opaque = Option<Rgba<f32>>.some(Rgba<f32>.new(0.0, 0.0, 0.0, 1.0))
  let mut child = p.output.fragments.values.asSlice()[index].firstChild
  while child != NO_INDEX {
    let f = p.output.fragments.values.asSlice()[child]
    if f.kind == FragmentKind.Text {
      let slot = styleSlot(&p.slotOfCss.*, &p.css.*, &p.nodes.*, f.source)
      let output = p.output
      let mut runs = output.fragments.textRuns(child)
      while runs.next() {
        let placed = runs.current
        run paintTextAs(&mut p, child, slot, runFragment(&f, &placed), placed, mask, opaque, Option<Rgba<f32>>.None)
      }
    } else {
      run paintGlyphMask(&mut p, child, mask)
    }
    child = f.nextSibling
  }
}

/// Which background layers a box paints with its border: a scroll container leaves its `local`
/// ones to [`paintLocalBackgrounds`].
fn backgroundScope(c: &Computed) -> u8 {
  return if layers.scroller(c) { paint_effects.SCOPE_OUTER } else { paint_effects.SCOPE_ALL }
}

/// The `background-attachment: local` layers of scroll container `slot`, in its scroll group
/// under its content, placed on its padding box grown to all it scrolls over.
effect fn paintLocalBackgrounds(p: &mut Painter<'_, '_>, slot: u32, c: &Computed, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !hasBackgrounds(&p.*, slot) { return }
  let held = paint_effects.cloneEffects(&p.*, slot)
  match &held {
    Option<Frozen<Effects>>.Some { value } => {
      let effects = value.get()
      if effects.backgrounds.attached(paint_css.ATTACH_LOCAL) {
        let port = paddingBox(f)
        let over = f.scrollableOverflow
        let ox = f.worldLocation.x + over.x
        let oy = f.worldLocation.y + over.y
        let local = Rect<f32>.new(
          f32.min(port.xMin, ox),
          f32.min(port.yMin, oy),
          f32.max(port.xMax, ox + over.width),
          f32.max(port.yMax, oy + over.height),
        )
        let radii = Radii.zero()
        run paint_effects.paintLayers(&mut p, effects, &effects.backgrounds, f, radii, mask, GeometryBox.Padding, false, c.nearest, paint_effects.SCOPE_LOCAL, local)
      }
    }
    Option<Frozen<Effects>>.None => {}
  }
}

effect fn decorate(
  p: &mut Painter<'_, '_>,
  slot: u32,
  c: &Computed,
  f: &Fragment,
  edges: u8,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = p.scale
  let bounds = snapped(device(borderBox(f), s))
  let mut radii = radiiOf(&p.*, slot, c, f).scaled(s)
  if edges != 15 {
    radii = Radii.new(cutCorners(radii.x, edges), cutCorners(radii.y, edges))
  }
  let background = backgroundOf(c.paint.background)
  let images = hasBackgrounds(&p.*, slot)
  let colorClip = if c.effects.declared {
    colorClipOf(&p.*, slot)
  } else {
    Clip.Border
  }
  // The color shares the border's quad only when it fills the border box under no image.
  let joined = !images && colorClip == Clip.Border
  let opaqueFill = joined && match c.paint.background {
    Fill.Solid { color } => color.a >= 1.0
    Fill.Gradient { from, to, .. } => from.a >= 1.0 && to.a >= 1.0
    Fill.None => false
  }
  if c.paint.hasShadow && !c.paint.shadow.inset && c.paint.shadow.color.a > 0.0 {
    drop run p.scene.shadow(
      Shadow {
        bounds: bounds,
        mask: mask,
        cornerRadii: radii,
        color: c.paint.shadow.color,
        blurRadius: c.paint.shadow.blur * s,
        offset: Vector2<f32> { x: c.paint.shadow.offsetX * s, y: c.paint.shadow.offsetY * s },
        spread: c.paint.shadow.spread * s,
        inset: false,
        cutout: !opaqueFill,
      },
    )
  }
  let mut widths = Insets<f32>.zero()
  // A collapsed table's borders are painted by the table (table_borders).
  if c.paint.borderStyle != StyleBorder.None && !table_borders.collapsedPart(c) {
    if hasEdge(edges, 1) {
      widths.top = borderWidth(c.paint.border.top * s)
    }
    if hasEdge(edges, 2) {
      widths.right = borderWidth(c.paint.border.right * s)
    }
    if hasEdge(edges, 4) {
      widths.bottom = borderWidth(c.paint.border.bottom * s)
    }
    if hasEdge(edges, 8) {
      widths.left = borderWidth(c.paint.border.left * s)
    }
  }
  let imageBorder = hasBorderImage(&p.*, slot)
  let bordered = !imageBorder && (widths.top > 0.0 || widths.right > 0.0 || widths.bottom > 0.0
    || widths.left > 0.0)
    && c.paint.borderColor.a > 0.0
  let blended = images && blendsBackgrounds(&p.*, slot)
  if blended {
    drop run p.scene.pushEffectLayer(mask.bounds, mask, Isolation { opacity: 1.0, blend: 0 }, LayerEffects.none())
  }
  if !joined && !background.isTransparent() && colorClip != Clip.Text {
    let area = paint_effects.clipBox(f, colorClip)
    let mut quad = Quad.fill(
      if colorClip == Clip.Border {
        bounds
      } else {
        snapped(device(area, s))
      },
      mask,
      background,
    )
    quad.cornerRadii = radii.insetTo(device(borderBox(f), s), device(area, s))
    drop run p.scene.quad(quad)
  }
  if images {
    let held = paint_effects.cloneEffects(&p.*, slot)
    match &held {
      Option<Frozen<Effects>>.Some { value } => {
        let effects = value.get()
        run paint_effects.paintLayers(&mut p, effects, &effects.backgrounds, f, radii, mask, GeometryBox.Padding, false, c.nearest, backgroundScope(c), Rect<f32>.new(0.0, 0.0, 0.0, 0.0))
      }
      Option<Frozen<Effects>>.None => {}
    }
  }
  if blended {
    run p.scene.popLayer()
  }
  if (joined && !background.isTransparent()) || bordered {
    let mut quad = Quad.fill(
      bounds,
      mask,
      if !joined {
        Background.solid(Rgba<f32>.new(0.0, 0.0, 0.0, 0.0))
      } else {
        background
      },
    )
    quad.cornerRadii = radii
    if bordered {
      quad.borderWidths = widths
      quad.borderColor = c.paint.borderColor
      quad.borderStyle = if c.paint.borderStyle == StyleBorder.Dashed {
        BorderStyle.Dashed
      } else {
        BorderStyle.Solid
      }
    }
    drop run p.scene.quad(quad)
  }
  if imageBorder {
    // In place of the border's style, over the backgrounds; the widths stay as laid out.
    let held = paint_effects.cloneEffects(&p.*, slot)
    match &held {
      Option<Frozen<Effects>>.Some { value } => {
        let effects = value.get()
        if let Option.Some { value: bi } = effects.borderImage.get() {
          run paint_effects.paintImageBorder(&mut p, effects, bi, f, usedBorder(c), mask, c.nearest)
        }
      }
      Option<Frozen<Effects>>.None => {}
    }
  }
  if c.paint.hasShadow && c.paint.shadow.inset && c.paint.shadow.color.a > 0.0 {
    // An inset shadow lies inside the padding box, with its radii.
    let inside = Rect<f32>.new(bounds.xMin + widths.left, bounds.yMin + widths.top, bounds.xMax - widths.right, bounds.yMax - widths.bottom)
    drop run p.scene.shadow(
      Shadow {
        bounds: inside,
        mask: mask,
        cornerRadii: radii.insetTo(bounds, inside),
        color: c.paint.shadow.color,
        blurRadius: c.paint.shadow.blur * s,
        offset: Vector2<f32> { x: c.paint.shadow.offsetX * s, y: c.paint.shadow.offsetY * s },
        spread: c.paint.shadow.spread * s,
        inset: true,
        cutout: false,
      },
    )
  }
}

/// Paints a native `<input type="range">` slider: background track, accent-colored progress
/// fill, and circular thumb.
effect fn paintRange(
  p: &mut Painter<'_, '_>,
  slot: u32,
  c: &Computed,
  f: &Fragment,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let s = p.scale
  let box = contentBox(f)
  let w = box.xMax - box.xMin
  let h = box.yMax - box.yMin
  if w <= 0.0 || h <= 0.0 {
    return ()
  }
  let minVal = node.valueMin()
  let maxVal = node.valueMax()
  let nowVal = node.valueNow()
  let ratio: f32 = if maxVal > minVal {
    f32.min(1.0, f32.max(0.0, (nowVal - minVal) / (maxVal - minVal)))
  } else {
    0.0
  }
  let mut accent = if c.hasAccentColor {
    c.accentColor
  } else {
    Rgba<f32> { r: 0.0, g: 0.459, b: 1.0, a: 1.0 }
  }
  let mut trackColor = Rgba<f32> { r: 0.55, g: 0.55, b: 0.55, a: 0.35 }
  if node.disabled {
    accent.a = accent.a * 0.45
    trackColor.a = trackColor.a * 0.45
  }
  let thumbDiameter = f32.min(16.0, f32.max(10.0, h))
  let thumbR = thumbDiameter * 0.5
  let trackH = f32.min(4.0, f32.max(2.0, thumbDiameter * 0.28))
  let centerY = (box.yMin + box.yMax) * 0.5
  let trackLeft = box.xMin
  let trackRight = box.xMax
  let travelLeft = f32.min(box.xMax, box.xMin + thumbR)
  let travelRight = f32.max(travelLeft, box.xMax - thumbR)
  let thumbX = travelLeft + (travelRight - travelLeft) * ratio

  let trackRect = snapped(device(
    Rect<f32>.new(trackLeft, centerY - trackH * 0.5, trackRight, centerY + trackH * 0.5),
    s,
  ))
  let trackRadius = (trackH * 0.5) * s
  let mut trackQuad = Quad.fill(trackRect, mask, Background.solid(trackColor))
  trackQuad.cornerRadii = Radii.uniform(trackRadius)
  drop run p.scene.quad(trackQuad)

  if thumbX > trackLeft {
    let fillRect = snapped(device(
      Rect<f32>.new(trackLeft, centerY - trackH * 0.5, thumbX, centerY + trackH * 0.5),
      s,
    ))
    let mut fillQuad = Quad.fill(fillRect, mask, Background.solid(accent))
    fillQuad.cornerRadii = Radii.uniform(trackRadius)
    drop run p.scene.quad(fillQuad)
  }

  let thumbRect = snapped(device(
    Rect<f32>.new(thumbX - thumbR, centerY - thumbR, thumbX + thumbR, centerY + thumbR),
    s,
  ))
  let thumbRadii = Radii.uniform(thumbR * s)
  if !node.disabled {
    drop run p.scene.shadow(
      Shadow {
        bounds: thumbRect,
        mask: mask,
        cornerRadii: thumbRadii,
        color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.25 },
        blurRadius: 2.0 * s,
        offset: Vector2<f32> { x: 0.0, y: 1.0 * s },
        spread: 0.0,
        inset: false,
        cutout: false,
      },
    )
  }
  let mut thumbQuad = Quad.fill(thumbRect, mask, Background.solid(accent))
  thumbQuad.cornerRadii = thumbRadii
  let bw = f32.max(1.0, 1.0 * s)
  thumbQuad.borderWidths = Insets<f32> { top: bw, right: bw, bottom: bw, left: bw }
  thumbQuad.borderColor = Rgba<f32> { r: 1.0, g: 1.0, b: 1.0, a: if node.disabled { 0.35 } else { 0.85 } }
  thumbQuad.borderStyle = BorderStyle.Solid
  drop run p.scene.quad(thumbQuad)
}

fn nodeNamedAttr<'a>(node: &'a Node, name: string) -> Option<&'a [u8]> {
  if let Option.Some { value: id } = node.identity() {
    let attrs = id.attributes()
    let mut i: usize = 0
    while i < attrs.length {
      if String.view(&attrs[i].name) == name {
        return Option<&'a [u8]>.some(String.utf8Bytes(String.view(&attrs[i].value)))
      }
      i = i + 1
    }
  }
  return Option<&'a [u8]>.None
}

fn nodeTagBytes<'a>(node: &'a Node) -> &'a [u8] {
  return match node.identity() {
    Option.Some { value: id } => String.utf8Bytes(id.tag())
    _ => b""
  }
}

fn bytesEq(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  return true
}

fn hexNibble(c: u8) -> i32 {
  if c >= 48 && c <= 57 { return u8.toI32(c - 48) }
  if c >= 65 && c <= 70 { return u8.toI32(c - 55) }
  if c >= 97 && c <= 102 { return u8.toI32(c - 87) }
  return -1
}

fn parseHexColor(bytes: &[u8]) -> Option<Rgba<f32>> {
  if bytes.length != 7 || bytes[0] != 35 { return Option<Rgba<f32>>.None }
  let r0 = hexNibble(bytes[1])
  let r1 = hexNibble(bytes[2])
  let g0 = hexNibble(bytes[3])
  let g1 = hexNibble(bytes[4])
  let b0 = hexNibble(bytes[5])
  let b1 = hexNibble(bytes[6])
  if r0 < 0 || r1 < 0 || g0 < 0 || g1 < 0 || b0 < 0 || b1 < 0 { return Option<Rgba<f32>>.None }
  return Option<Rgba<f32>>.some(Rgba<f32> {
    r: i32.toF32(r0 * 16 + r1) / 255.0,
    g: i32.toF32(g0 * 16 + g1) / 255.0,
    b: i32.toF32(b0 * 16 + b1) / 255.0,
    a: 1.0,
  })
}

fn controlAccent(c: &Computed, disabled: bool) -> Rgba<f32> {
  let mut accent = if c.hasAccentColor {
    c.accentColor
  } else {
    Rgba<f32> { r: 0.0, g: 0.459, b: 1.0, a: 1.0 }
  }
  if disabled { accent.a = accent.a * 0.45 }
  return accent
}

/// Paints native `<input type="checkbox">` check / indeterminate glyph over the box.
effect fn paintCheckbox(p: &mut Painter<'_, '_>, slot: u32, c: &Computed, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let indeterminate = match node.semanticsOf() { Option.Some { value } => value.indeterminate _ => false }
  if !node.checked && !indeterminate { return () }
  let s = p.scale
  let box = borderBox(f)
  let w = box.xMax - box.xMin
  let h = box.yMax - box.yMin
  if w <= 2.0 || h <= 2.0 { return () }
  let accent = controlAccent(c, node.disabled)
  let rect = snapped(device(box, s))
  let mut fillQuad = Quad.fill(rect, mask, Background.solid(accent))
  let radius = f32.min(3.0, f32.min(w, h) * 0.2) * s
  fillQuad.cornerRadii = Radii.uniform(radius)
  drop run p.scene.quad(fillQuad)
  let markColor = Rgba<f32> { r: 1.0, g: 1.0, b: 1.0, a: if node.disabled { 0.65 } else { 1.0 } }
  let mut path = VectorPath.make()
  if indeterminate {
    run path.moveTo(0.22, 0.5)
    run path.lineTo(0.78, 0.5)
  } else {
    run path.moveTo(0.22, 0.52)
    run path.lineTo(0.42, 0.72)
    run path.lineTo(0.78, 0.28)
  }
  let transform = Affine.new(f32.toF64(w * s), 0.0, 0.0, f32.toF64(h * s), f32.toF64(box.xMin * s), f32.toF64(box.yMin * s))
  let stroke = Stroke.make(0.15)
  drop run Effect.catchAll(p.paths.stroke(&mut p.scene, 0, &path, &stroke, &transform, Background.solid(markColor), mask), noPath)
}

/// Paints native `<input type="radio">` accent ring and crisp inner dot when checked.
effect fn paintRadio(p: &mut Painter<'_, '_>, slot: u32, c: &Computed, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  if !node.checked { return () }
  let s = p.scale
  let box = borderBox(f)
  let w = box.xMax - box.xMin
  let h = box.yMax - box.yMin
  if w <= 2.0 || h <= 2.0 { return () }
  let accent = controlAccent(c, node.disabled)
  let outerRect = snapped(device(box, s))
  let mut outer = Quad.fill(outerRect, mask, Background.solid(accent))
  outer.cornerRadii = Radii.uniform(f32.min(w, h) * 0.5 * s)
  drop run p.scene.quad(outer)
  let inset = f32.min(w, h) * 0.28
  let innerRect = snapped(device(Rect<f32>.new(box.xMin + inset, box.yMin + inset, box.xMax - inset, box.yMax - inset), s))
  let dotColor = Rgba<f32> { r: 1.0, g: 1.0, b: 1.0, a: if node.disabled { 0.65 } else { 1.0 } }
  let mut dot = Quad.fill(innerRect, mask, Background.solid(dotColor))
  dot.cornerRadii = Radii.uniform(f32.max(1.0, (f32.min(w, h) - inset * 2.0) * 0.5 * s))
  drop run p.scene.quad(dot)
}

/// Paints native `<progress>` track and determinate/indeterminate fill bar.
effect fn paintProgress(p: &mut Painter<'_, '_>, slot: u32, c: &Computed, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let s = p.scale
  let box = contentBox(f)
  let w = box.xMax - box.xMin
  let h = box.yMax - box.yMin
  if w <= 0.0 || h <= 0.0 { return () }
  let barH = f32.min(h, f32.max(6.0, h * 0.5))
  let cy = (box.yMin + box.yMax) * 0.5
  let radius = (barH * 0.5) * s
  let trackRect = snapped(device(Rect<f32>.new(box.xMin, cy - barH * 0.5, box.xMax, cy + barH * 0.5), s))
  let mut track = Quad.fill(trackRect, mask, Background.solid(Rgba<f32> { r: 0.55, g: 0.55, b: 0.55, a: 0.28 }))
  track.cornerRadii = Radii.uniform(radius)
  drop run p.scene.quad(track)
  let accent = controlAccent(c, node.disabled)
  if node.hasValueRange() {
    let minVal = node.valueMin()
    let maxVal = node.valueMax()
    let nowVal = node.valueNow()
    let ratio: f32 = if maxVal > minVal { f32.min(1.0, f32.max(0.0, (nowVal - minVal) / (maxVal - minVal))) } else { 0.0 }
    if ratio > 0.0 {
      let fillRect = snapped(device(Rect<f32>.new(box.xMin, cy - barH * 0.5, box.xMin + w * ratio, cy + barH * 0.5), s))
      let mut fill = Quad.fill(fillRect, mask, Background.solid(accent))
      fill.cornerRadii = Radii.uniform(radius)
      drop run p.scene.quad(fill)
    }
  } else {
    // Indeterminate progress bar: centered 30% bar.
    let segW = w * 0.3
    let x0 = box.xMin + (w - segW) * 0.5
    let fillRect = snapped(device(Rect<f32>.new(x0, cy - barH * 0.5, x0 + segW, cy + barH * 0.5), s))
    let mut fill = Quad.fill(fillRect, mask, Background.solid(accent))
    fill.cornerRadii = Radii.uniform(radius)
    drop run p.scene.quad(fill)
  }
}

/// Paints native `<meter>` gauge bar colored by optimum / suboptimum / even-less-good region.
effect fn paintMeter(p: &mut Painter<'_, '_>, slot: u32, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let s = p.scale
  let box = contentBox(f)
  let w = box.xMax - box.xMin
  let h = box.yMax - box.yMin
  if w <= 0.0 || h <= 0.0 { return () }
  let barH = f32.min(h, f32.max(8.0, h * 0.7))
  let cy = (box.yMin + box.yMax) * 0.5
  let radius = (barH * 0.35) * s
  let trackRect = snapped(device(Rect<f32>.new(box.xMin, cy - barH * 0.5, box.xMax, cy + barH * 0.5), s))
  let mut track = Quad.fill(trackRect, mask, Background.solid(Rgba<f32> { r: 0.55, g: 0.55, b: 0.55, a: 0.25 }))
  track.cornerRadii = Radii.uniform(radius)
  drop run p.scene.quad(track)
  let ratio: f32 = if node.hasValueRange() && node.valueMax() > node.valueMin() {
    f32.min(1.0, f32.max(0.0, (node.valueNow() - node.valueMin()) / (node.valueMax() - node.valueMin())))
  } else { 0.0 }
  if ratio > 0.0 {
    let mut color = Rgba<f32> { r: 0.133, g: 0.647, b: 0.349, a: 1.0 }
    if let Option.Some { value: state } = nodeNamedAttr(node, "-silk-meter-state") {
      if bytesEq(state, b"suboptimum") {
        color = Rgba<f32> { r: 0.898, g: 0.604, b: 0.086, a: 1.0 }
      } else if bytesEq(state, b"even-less-good") {
        color = Rgba<f32> { r: 0.863, g: 0.208, b: 0.271, a: 1.0 }
      }
    }
    let fillRect = snapped(device(Rect<f32>.new(box.xMin, cy - barH * 0.5, box.xMin + w * ratio, cy + barH * 0.5), s))
    let mut fill = Quad.fill(fillRect, mask, Background.solid(color))
    fill.cornerRadii = Radii.uniform(radius)
    drop run p.scene.quad(fill)
  }
}

/// Paints native `<input type="color">` inset color swatch.
effect fn paintColorSwatch(p: &mut Painter<'_, '_>, slot: u32, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let s = p.scale
  let box = contentBox(f)
  if box.xMax <= box.xMin || box.yMax <= box.yMin { return () }
  let swatch = match nodeNamedAttr(node, "-silk-color") {
    Option.Some { value } => match parseHexColor(value) {
      Option.Some { value: rgba } => rgba
      _ => Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
    }
    _ => Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  }
  let mut quad = Quad.fill(snapped(device(box, s)), mask, Background.solid(swatch))
  quad.cornerRadii = Radii.uniform(2.0 * s)
  drop run p.scene.quad(quad)
}

/// Paints native `<select>` dropdown chevron on the trailing edge of a single-select box.
effect fn paintSelectChrome(p: &mut Painter<'_, '_>, slot: u32, c: &Computed, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  if nodeNamedAttr(node, "multiple").isSome() { return () }
  let s = p.scale
  let box = paddingBox(f)
  let w = box.xMax - box.xMin
  let h = box.yMax - box.yMin
  if w < 14.0 || h < 8.0 { return () }
  let chevSize = f32.min(8.0, h * 0.35)
  let cx = box.xMax - 11.0
  let cy = (box.yMin + box.yMax) * 0.5
  let mut color = c.text.color
  if node.disabled { color.a = color.a * 0.45 }
  let mut path = VectorPath.make()
  run path.moveTo(-0.5, -0.22)
  run path.lineTo(0.0, 0.28)
  run path.lineTo(0.5, -0.22)
  let transform = Affine.new(f32.toF64(chevSize * s), 0.0, 0.0, f32.toF64(chevSize * s), f32.toF64(cx * s), f32.toF64(cy * s))
  let stroke = Stroke.make(0.18)
  drop run Effect.catchAll(p.paths.stroke(&mut p.scene, 0, &path, &stroke, &transform, Background.solid(color), mask), noPath)
}

/// The color of an `outline: auto` focus ring whose color is `auto`.
const FOCUS_RING: Rgba<f32> = Rgba<f32> { r: 0.0, g: 0.373, b: 0.8, a: 1.0 }

/// Draws the outline of a box with computed style `c` around `rect`, its border box (CSS
/// pixels), over what the box painted. It follows the border radii, grown by its distance.
effect fn paintOutline(
  p: &mut Painter<'_, '_>,
  slot: u32,
  c: &Computed,
  rect: Rect<f32>,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let o = c.outline
  if !o.drawn() {
    return ()
  }
  let color = if !o.colorAuto {
    o.color
  } else if o.auto {
    FOCUS_RING
  } else {
    c.text.color
  }
  if color.a <= 0.0 {
    return ()
  }
  let s = p.scale
  let reach = o.offset + o.width
  let outer = grow(rect, reach)
  if outer.xMax <= outer.xMin || outer.yMax <= outer.yMin {
    return ()
  }
  let mut quad = Quad.fill(device(outer, s), mask, Background.solid(Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }))
  if rounds(c) {
    quad.cornerRadii = radiiIn(&p.*, slot, c, rect.xMax - rect.xMin, rect.yMax - rect.yMin).spread(reach).scaled(s)
  }
  let w = o.width * s
  quad.borderWidths = Insets<f32> { top: w, right: w, bottom: w, left: w }
  quad.borderColor = color
  quad.borderStyle = if !o.auto && o.style == StyleBorder.Dashed {
    BorderStyle.Dashed
  } else {
    BorderStyle.Solid
  }
  drop run p.scene.quad(quad)
}

/// Draws the column rules of a multi-column container (fragment `index`, style `c`): one in
/// the middle of each gap between two columns with content, as tall as the columns, over the
/// container's background and under its content (Multicol 1 §4).
effect fn paintColumnRules(
  p: &mut Painter<'_, '_>,
  index: usize,
  c: &Computed,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let rule = c.columnRule
  let color = if rule.current {
    c.text.color
  } else {
    rule.color
  }
  if color.a <= 0.0 {
    return ()
  }
  let s = p.scale
  let values = p.output.fragments.values.asSlice()
  let boxes = p.output.boxNodes.asSlice()
  let mut set = values[index].firstChild
  while set != NO_INDEX {
    let setBox = values[set].box
    if values[set].kind == FragmentKind.Box && setBox != NO_INDEX && setBox < boxes.length
      && boxes[setBox].columnSet {
      let mut column = values[set].firstChild
      let mut previous = NO_INDEX
      while column != NO_INDEX {
        if values[column].kind == FragmentKind.Box {
          if previous != NO_INDEX {
            let a = borderBox(&values[previous])
            let b = borderBox(&values[column])
            let half = rule.width * 0.5
            // Columns of a vertical writing mode follow each other downwards:
            // their rule runs across, between them.
            let across = b.xMin < a.xMax && a.xMin < b.xMax
            let mut rect = Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
            if across {
              let upper = if b.yMin >= a.yMax { a.yMax } else { b.yMax }
              let lower = if b.yMin >= a.yMax { b.yMin } else { a.yMin }
              let middle = (upper + lower) * 0.5
              // A vertical-rl column flow's own box starts at the column's right
              // edge, so the rule spans the column set's width instead.
              let setRect = borderBox(&values[set])
              rect = Rect<f32>.new(setRect.xMin, middle - half, setRect.xMax, middle + half)
            } else {
              let left = if b.xMin >= a.xMax { a.xMax } else { b.xMax }
              let right = if b.xMin >= a.xMax { b.xMin } else { a.xMin }
              let middle = (left + right) * 0.5
              rect = Rect<f32>.new(middle - half, f32.min(a.yMin, b.yMin), middle + half, f32.max(a.yMax, b.yMax))
            }
            let line = snapped(device(rect, s))
            let w = f32.max(1.0, line.xMax - line.xMin)
            let h = f32.max(1.0, line.yMax - line.yMin)
            let mut bounds = Rect<f32>.new(line.xMin, line.yMin, line.xMin + w, line.yMax)
            if across { bounds = Rect<f32>.new(line.xMin, line.yMin, line.xMax, line.yMin + h) }
            if rule.style == StyleBorder.Dashed {
              let mut quad = Quad.fill(
                bounds,
                mask,
                Background.solid(Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }),
              )
              quad.borderWidths = Insets<f32> { top: 0.0, right: 0.0, bottom: 0.0, left: w }
              if across { quad.borderWidths = Insets<f32> { top: h, right: 0.0, bottom: 0.0, left: 0.0 } }
              quad.borderColor = color
              quad.borderStyle = BorderStyle.Dashed
              drop run p.scene.quad(quad)
            } else {
              drop run p.scene.quad(Quad.fill(bounds, mask, Background.solid(color)))
            }
          }
          previous = column
        }
        column = values[column].nextSibling
      }
    }
    set = values[set].nextSibling
  }
}

effect fn noGlyph<E>(error: E) -> Option<RasterGlyph> {
  drop error
  return Option<RasterGlyph>.None
}

effect fn noPath<E>(error: E) -> u32 {
  drop error
  return 0
}

/// Text fragment `f` as it would be were run `placed` its only one: where the run is, and its
/// size. The fragment's baselines are every run's.
fn runFragment(f: &Fragment, placed: &PlacedText) -> Fragment {
  let mut one = f.*
  one.worldLocation = placed.location
  one.size = placed.size
  return one
}

/// How far past its box a run of text of height `height` may put ink, with the style of node
/// `slot` (see [`ownInk`]).
fn textReach(slot: u32, nodes: &List<Node>, height: f32) -> f32 {
  let mut reach = f32.max(height, 16.0)
  if slot != NONE {
    let from = nodes.asSlice()[u32.toUsize(slot)].computed().effects.shadowFrom
    if from != NONE && u32.toUsize(from) < nodes.length() {
      if let Option<&Effects>.Some { value } = nodes.asSlice()[u32.toUsize(from)].paintEffects() {
        reach = reach + paint_effects.shadowReach(value.shadows.asSlice())
      }
    }
  }
  return reach
}

/// Paints the runs of text fragment `index` (a word, a space: one line of a paragraph holds
/// many, and the fragment may hold every line), each with its text shadows. A run whose ink
/// misses the clip is skipped, as a fragment's subtree is.
effect fn paintText(p: &mut Painter<'_, '_>, index: usize, f: Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let slot = styleSlot(&p.slotOfCss.*, &p.css.*, &p.nodes.*, f.source)
  let s = p.scale
  let cull = ContentMask.new(p.cull).intersect(mask).bounds
  let mut first = true
  let output = p.output
  let mut runs = output.fragments.textRuns(index)
  while runs.next() {
    let placed = runs.current
    let x = placed.location.x
    let y = placed.location.y
    let reach = textReach(slot, &p.nodes.*, placed.size.height)
    let visible = (x - reach) * s < cull.xMax && (x + placed.size.width + reach) * s > cull.xMin
      && (y - reach) * s < cull.yMax && (y + placed.size.height + reach) * s > cull.yMin
    if first {
      // The text's node takes its place in the paint order where its first run paints.
      first = false
      if visible { run noteOrder(&mut p, index, &f) }
    }
    if visible {
      run paintTextRun(&mut p, index, slot, runFragment(&f, &placed), placed, mask)
      if p.caretSlot != NONE && slotIn(p.slotOfCss, f.source) == p.caretSlot {
        run paintTextCaret(&mut p, index, slot, placed, mask)
      }
    }
  }
}

/// The editing host's caret, where it is in run `placed` of text fragment `index`: at a run's
/// start or inside it, or at its end when the text ends there.
effect fn paintTextCaret(p: &mut Painter<'_, '_>, index: usize, slot: u32, placed: PlacedText, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let piece = caret.pieceOf(p.text, index, &placed)
  let offset = p.caretOffset
  let length = String.byteLength(String.view(&p.nodes.asSlice()[u32.toUsize(p.caretSlot)].text))
  if offset < piece.start || offset > piece.end || (offset == piece.end && offset != length) {
    return ()
  }
  let x = caret.caretX(p.text, &piece, offset)
  run paintCaretAt(&mut p, slot, Rect<f32>.new(x, piece.top, x, piece.bottom), mask)
}

/// A caret one device pixel wide at the left of `rect` (CSS pixels), in `slot`'s caret color.
effect fn paintCaretAt(p: &mut Painter<'_, '_>, slot: u32, rect: Rect<f32>, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if rect.yMax <= rect.yMin || slot == NONE { return () }
  let s = p.scale
  let width = f32.max(1.0, f32.round(s))
  let x = f32.floor(rect.xMin * s)
  let color = p.nodes.asSlice()[u32.toUsize(slot)].computed().text.caret()
  drop run p.scene.quad(Quad.fill(Rect<f32>.new(x, f32.floor(rect.yMin * s), x + width, f32.ceil(rect.yMax * s)), mask, Background.solid(color)))
}

/// Paints one run of a text fragment (`f` is the run's box, see [`runFragment`]): its text
/// shadows, then the run.
effect fn paintTextRun(p: &mut Painter<'_, '_>, index: usize, slot: u32, f: Fragment, placed: PlacedText, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if slot != NONE && p.nodes.asSlice()[u32.toUsize(slot)].kind == NodeKind.Input {
    let node = &p.nodes.asSlice()[u32.toUsize(slot)]
    let e = node.edit()
    if e.focused && !e.composing && !e.showsPlaceholder && e.anchor != e.focus {
      if selection.styled(node) {
        let foreground = selection.foreground(node)
        let mut piece = caret.pieceOf(p.text, index, &placed)
        let r = rich.runOf(&e.runs, f.source)
        if e.hasRuns() && r != NO_INDEX {
          let found = e.runs.get(r)
          piece.start = piece.start + found.start
          piece.end = piece.end + found.start
          piece.base = found.start
        }
        let span = caret.spanX(p.text, &piece, e.toDisplay(e.low()), e.toDisplay(e.high()))
        if span.xMin < span.xMax {
          let selected = ContentMask.new(device(span, p.scale)).intersect(mask)
          let b = mask.bounds
          let s = selected.bounds
          if s.xMin < s.xMax && s.yMin < s.yMax {
            // Paint disjoint regions so alpha and partial ligatures replace the
            // selected ink rather than compositing another glyph on top of it.
            let outside = [
              Rect<f32>.new(b.xMin, b.yMin, b.xMax, s.yMin),
              Rect<f32>.new(b.xMin, s.yMax, b.xMax, b.yMax),
              Rect<f32>.new(b.xMin, s.yMin, s.xMin, s.yMax),
              Rect<f32>.new(s.xMax, s.yMin, b.xMax, s.yMax),
            ]
            let mut i: usize = 0
            while i < outside.length {
              let rect = outside[i]
              if rect.xMin < rect.xMax && rect.yMin < rect.yMax {
                run paintTextNormally(&mut p, index, slot, f, placed, ContentMask.new(rect))
              }
              i = i + 1
            }
            run paintTextAs(&mut p, index, slot, f, placed, selected, Option<Rgba<f32>>.None, foreground)
            return ()
          }
        }
      }
    }
  } else if p.selected.length() != 0 && f.textData != NO_INDEX {
    let textSlot = slotIn(p.slotOfCss, f.source)
    let k = if textSlot == NONE { NO_INDEX } else { text_selection.find(p.selected, textSlot) }
    if k != NO_INDEX {
      let covered = p.selected.get(k)
      let span = run paintDocumentSelection(&mut p, index, slot, textSlot, covered, placed, mask)
      if span.xMin < span.xMax && slot != NONE && selection.styled(&p.nodes.asSlice()[u32.toUsize(slot)]) {
        let foreground = selection.foreground(&p.nodes.asSlice()[u32.toUsize(slot)])
        let selected = ContentMask.new(device(span, p.scale)).intersect(mask)
        let b = mask.bounds
        let r = selected.bounds
        if r.xMin < r.xMax && r.yMin < r.yMax {
          let outside = [Rect<f32>.new(b.xMin, b.yMin, b.xMax, r.yMin),
            Rect<f32>.new(b.xMin, r.yMax, b.xMax, b.yMax),
            Rect<f32>.new(b.xMin, r.yMin, r.xMin, r.yMax),
            Rect<f32>.new(r.xMax, r.yMin, b.xMax, r.yMax)]
          let mut i: usize = 0
          while i < outside.length {
            let rect = outside[i]
            if rect.xMin < rect.xMax && rect.yMin < rect.yMax {
              run paintTextNormally(&mut p, index, slot, f, placed, ContentMask.new(rect).intersect(mask))
            }
            i = i + 1
          }
          run paintTextAs(&mut p, index, slot, f, placed, selected, Option<Rgba<f32>>.None, foreground)
          return ()
        }
      }
    }
  }
  run paintTextNormally(&mut p, index, slot, f, placed, mask)
}

/// Whether run `t` of text fragment `index` ends its line: nothing follows it in the line box.
fn endsLine(output: &LayoutTree, index: usize, t: &PlacedText) -> bool {
  let values = output.fragments.values.asSlice()
  let texts = output.fragments.texts.asSlice()
  let value = &values[index]
  if t.record != NO_INDEX && value.textData != NO_INDEX {
    // A later run of the fragment before the next line record is on the same line.
    let end = value.textData + u32.toUsize(value.textCount)
    let mut at = t.record + 1
    while at < end {
      let part = texts[at].part
      if part == TEXT_RUN { return false }
      if part == TEXT_LINE || part == TEXT_LINE_CONTINUED { return true }
      at = at + 1
    }
  }
  if t.line != NO_INDEX && t.line >= LINE_RECORD {
    // A line kept as records: the text fragment after this one goes on with it when it
    // opens with the same line box again.
    let next = value.nextSibling
    if next != NO_INDEX && values[next].textData != NO_INDEX && values[next].textCount != 0 {
      return texts[values[next].textData].part != TEXT_LINE_CONTINUED
    }
    return true
  }
  let mut at = index
  while at != NO_INDEX {
    if values[at].nextSibling != NO_INDEX { return false }
    let parent = values[at].parent
    if parent == NO_INDEX || values[parent].kind == FragmentKind.Line { return true }
    at = parent
  }
  return true
}

/// Paints the document selection's highlight under run `placed` of text fragment `index` of text node
/// `textSlot` (styled by element `slot`), at the height of its line box. A selected line end
/// shows as a sliver after the line's last run. Returns what it covered, in CSS pixels.
effect fn paintDocumentSelection(
  p: &mut Painter<'_, '_>,
  index: usize,
  slot: u32,
  textSlot: u32,
  covered: Selected,
  placed: PlacedText,
  mask: ContentMask,
) -> Rect<f32>
  ! OutOfMemoryError
  ? &mut Allocator {
  let piece = caret.pieceOf(p.text, index, &placed)
  let mut span = caret.spanX(p.text, &piece, covered.start, covered.end)
  let pastEnd = covered.end > piece.end || covered.through && covered.end >= piece.end
  if (pastEnd || piece.lineBreak) && covered.start <= piece.end && endsLine(p.output, index, &placed) {
    let size = p.nodes.asSlice()[u32.toUsize(textSlot)].computed().text.size
    let sliver = f32.max(4.0, size * 0.25)
    if span.xMin > span.xMax {
      let x = caret.caretX(p.text, &piece, piece.end)
      span = Rect<f32>.new(x, piece.lineTop, x + sliver, piece.lineBottom)
    } else if piece.lineBreak {
      span = Rect<f32>.new(span.xMin, span.yMin, span.xMin + f32.max(sliver, span.xMax - span.xMin), span.yMax)
    } else {
      span = Rect<f32>.new(span.xMin, span.yMin, span.xMax + sliver, span.yMax)
    }
  }
  if span.xMin >= span.xMax {
    return span
  }
  let color = if slot != NONE {
    selection.background(&p.nodes.asSlice()[u32.toUsize(slot)])
  } else {
    p.nodes.asSlice()[u32.toUsize(textSlot)].computed().text.selectionColor
  }
  if color.a > 0.0 {
    drop run p.scene.quad(Quad.fill(device(span, p.scale), mask, Background.solid(color)))
  }
  return span
}

effect fn paintTextNormally(p: &mut Painter<'_, '_>, index: usize, slot: u32, f: Fragment, t: PlacedText, mask: ContentMask) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  if slot != NONE {
    if p.nodes.asSlice()[u32.toUsize(slot)].computed().effects.shadowFrom != NONE {
      let c = p.nodes.asSlice()[u32.toUsize(slot)].computed().*
      let mut shadows = List<TextShadow>.make()
      run paint_effects.shadowsOf(&p.*, &c, &mut shadows)
      let mut k = shadows.length()
      while k > 0 {
        k = k - 1
        let shadow = shadows.get(k)
        if shadow.color.a <= 0.0 {
          continue
        }
        let mut shifted = f
        shifted.worldLocation.x = f.worldLocation.x + shadow.x
        shifted.worldLocation.y = f.worldLocation.y + shadow.y
        let blurred = shadow.blur > 0.0
        if blurred {
          let mut effects = LayerEffects.none()
          effects.blur = shadow.blur * 0.5 * p.scale
          drop run p.scene.pushEffectLayer(
            mask.bounds,
            mask,
            Isolation { opacity: 1.0, blend: 0 },
            effects,
          )
        }
        run paintTextAs(&mut p, index, slot, shifted, t, mask, Option<Rgba<f32>>.some(shadow.color), Option<Rgba<f32>>.None)
        if blurred {
          run p.scene.popLayer()
        }
      }
    }
  }
  run paintTextAs(&mut p, index, slot, f, t, mask, Option<Rgba<f32>>.None, Option<Rgba<f32>>.None)
}

/// The `::first-line` values over run `t` of `slot` when it lies on a first line box with one.
/// They pass to the text through the elements on the line, so a value its element changes from
/// the block's stays (CSS Pseudo 4 §2.4); only paint values apply.
fn firstLineOver(p: &Painter<'_, '_>, t: &PlacedText, slot: u32, c: &mut Computed, color: &mut Rgba<f32>) -> () {
  if t.line == NO_INDEX { return () }
  let lines = p.firstLines.asSlice()
  let mut i: usize = 0
  while i < lines.length {
    if lines[i].line == t.line {
      let nodes = p.nodes.asSlice()
      let line = &nodes[u32.toUsize(lines[i].slot)].computed().text
      let block = &nodes[u32.toUsize(lines[i].origin)].computed().text
      if &c.text.color == &block.color { c.text.color = line.color }
      if c.text.fillColor == block.fillColor { c.text.fillColor = line.fillColor }
      if sameLines(c.text.decoration, block.decoration) && &c.text.decorationColor == &block.decorationColor && c.text.wavy == block.wavy {
        c.text.decoration = line.decoration
        c.text.decorationColor = line.decorationColor
        c.text.hasDecorationColor = line.hasDecorationColor
        c.text.wavy = line.wavy
      }
      color.* = c.text.fill()
      return ()
    }
    i = i + 1
  }
}

fn sameLines(a: DecorationLine, b: DecorationLine) -> bool {
  return a.underline == b.underline && a.overline == b.overline && a.lineThrough == b.lineThrough
}

/// Paints a text fragment: its glyph run, as shaped during layout, and its decorations, all in
/// `shadow` when set (a text shadow's pass).
/// Paints run `t` of a text fragment (`f` is the run's box, see [`runFragment`]): its glyph
/// run, as shaped during layout, and its decorations, all in `shadow` when set (a text
/// shadow's pass).
effect fn paintTextAs(
  p: &mut Painter<'_, '_>,
  index: usize,
  slot: u32,
  f: Fragment,
  t: PlacedText,
  mask: ContentMask,
  shadow: Option<Rgba<f32>>,
  foreground: Option<Rgba<f32>>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if t.kind != TextFragmentKind.Glyphs {
    return ()
  }
  if p.text.fonts.blocked(t.fontKey) {
    // font-display: its face is loading in the block period.
    return ()
  }
  if slot == NONE {
    return ()
  }
  let mut c = p.nodes.asSlice()[u32.toUsize(slot)].computed().*
  let mut color = c.text.fill()

  // An input's text ends where its value does: a filler after it has nothing to draw.
  let mut limit = usize.MAX
  if p.nodes.asSlice()[u32.toUsize(slot)].kind == NodeKind.Input {
    let e = p.nodes.asSlice()[u32.toUsize(slot)].edit()
    if e.showsPlaceholder {
      if let Option.Some { value } = placeholder.of(&p.nodes.asSlice()[u32.toUsize(slot)]) {
        c = value.computed
        color = c.text.fill()
      } else { color = c.text.placeholder() }
    }
    let r = rich.runOf(&e.runs, f.source)
    if e.hasRuns() && r != NO_INDEX {
      let found = e.runs.get(r)
      c = found.computed
      color = c.text.fill()
      if found.filler {
        limit = found.end - found.start - 3
      }
    } else if e.filler {
      limit = String.byteLength(String.view(&e.display)) - 3
    }
  }
  if p.firstLines.length() != 0 { firstLineOver(&p.*, &t, slot, &mut c, &mut color) }
  if let Option.Some { value } = foreground {
    color = value
    c.text.color = value
  }
  let mut shadowed = false
  if let Option<Rgba<f32>>.Some { value } = shadow {
    color = value
    shadowed = true
  }
  if !c.text.visible || color.a <= 0.0 && !c.text.decoration.underline {
    return ()
  }
  let s = p.scale
  let baseline = f.worldLocation.y + f.firstBaselines.alphabetic
  let mode = c.text.writingMode
  let vertical = mode != WritingMode.HorizontalTb
  let reverse = mode == WritingMode.SidewaysLr
  let baselineX = f.worldLocation.x
    + (if mode == WritingMode.VerticalLr || reverse {
      f.firstBaselines.alphabetic
    } else {
      f.size.width - f.firstBaselines.alphabetic
    })
  let shaped = p.text.glyphRun(t.shapeKey)
  if t.fontKey < p.faces.length() {
    if let Option<&FontFace>.Some { value: face } = p.faces.asSlice()[t.fontKey].face.get() {
      let extras = c.text.features.extras
      let aliased = text_fonts.extrasField(extras, text_fonts.EXTRAS_SMOOTH) == 1
      let paletteHandle = text_fonts.extrasField(extras, text_fonts.EXTRAS_PALETTE)
      let mut palette: u32 = 0
      if paletteHandle != 0 && face.colorTables().any() {
        let family = font_rules.familyName(p.sheetFaces, p.text.fonts.keyFamily(t.fontKey))
        let choice = run p.fontRules.palette(p.root, paletteHandle, family)
        palette = run p.glyphs.palette(move choice)
      }
      let cacheable = !vertical && shaped.size * s < 256.0
        && p.nodes.asSlice()[u32.toUsize(slot)].kind != NodeKind.Input
      let mut hidden = false
      let mut ink = TextInk.empty()
      ink.font = face.id
      ink.shape = shaped.fingerprint()
      ink.scale = s
      ink.valid = cacheable
      if cacheable && t.shapeKey < p.textInk.length() {
        let cached = p.textInk.get(t.shapeKey)
        if cached.valid && cached.font == ink.font && cached.shape == ink.shape
          && cached.scale == s {
          let x = f.worldLocation.x * s
          let y = baseline * s

          // Cover raster phase changes and rounding at very large document offsets.
          let pad = 2.0 + (f32.abs(x) + f32.abs(y)) * 0.00000024
          hidden = !cached.present || x + cached.bounds.xMax + pad < mask.bounds.xMin
            || x + cached.bounds.xMin - pad > mask.bounds.xMax
            || y + cached.bounds.yMax + pad < mask.bounds.yMin
            || y + cached.bounds.yMin - pad > mask.bounds.yMax
        }
      }
      if !hidden {
        let glyphs = p.text.runGlyphs(t.shapeKey)
        let mut outline = GlyphRasterizer.make()
        let mut i: usize = 0
        while i < glyphs.length {
          let g = glyphs[i]
          if limit != usize.MAX && t.sourceStart + u32.toUsize(g.cluster) >= limit {
            i = i + 1
            continue
          }
          let turn: u32 = if !vertical || g.upright {
            0
          } else if reverse {
            3
          } else {
            1
          }
          let originX = if !vertical {
            f.worldLocation.x + g.x
          } else if g.upright {
            f.worldLocation.x + f.size.width * 0.5 + g.y
          } else if reverse {
            baselineX + g.y
          } else {
            baselineX - g.y
          }
          let originY = if !vertical {
            baseline + g.y
          } else if reverse {
            f.worldLocation.y + f.size.height - g.x
          } else {
            f.worldLocation.y + g.x
          }
          let pen = PenPosition.of(f32.toF64(originX * s), f32.toF64(originY * s))

          // Large monochrome glyphs use clipped vector coverage. This avoids both oversized
          // atlas allocations and magnifying a capped bitmap at editor-style zoom levels.
          if (vertical || shaped.size * s >= 256.0) && !face.colorTables().any() {
            let drawn = run outline.outlinePath(
              &face,
              g.glyph,
              f32.toF64(shaped.size * s),
              0.0,
              0.0,
            )
            if drawn {
              let transform = Affine.new(
                if turn == 0 {
                  1.0
                } else {
                  0.0
                },
                if turn == 1 {
                  1.0
                } else if turn == 3 {
                  -1.0
                } else {
                  0.0
                },
                if turn == 1 {
                  -1.0
                } else if turn == 3 {
                  1.0
                } else {
                  0.0
                },
                if turn == 0 {
                  1.0
                } else {
                  0.0
                },
                f32.toF64(originX * s),
                f32.toF64(originY * s),
              )
              drop run Effect.catchAll(
                p.paths.fill(
                  &mut p.scene,
                  0,
                  outline.lastPath(),
                  &transform,
                  NONZERO,
                  Background.solid(color),
                  mask,
                ),
                noPath,
              )
              p.stats.glyphs = p.stats.glyphs + 1
              i = i + 1
              continue
            }
          }
          let key = GlyphKey {
            font: face.id,
            glyph: g.glyph,
            size: shaped.size,
            scale: s,
            subpixel: pen.subpixel,
            color: true,
            palette: palette,
            aliased: aliased,
          }
          let found = run Effect.catchAll(p.glyphs.glyph(&mut p.atlas, &face, key), noGlyph)
          if let Option<RasterGlyph>.Some { value } = found {
            let left = i32.toF32(value.left)
            let top = i32.toF32(value.top)
            let w = u32.toF32(value.width())
            let h = u32.toF32(value.height())
            if cacheable {
              let local = Rect<f32>.new(
                g.x * s + left,
                g.y * s + top,
                g.x * s + left + w,
                g.y * s + top + h,
              )
              if ink.present {
                ink.bounds = Rect<f32>.new(
                  f32.min(ink.bounds.xMin, local.xMin),
                  f32.min(ink.bounds.yMin, local.yMin),
                  f32.max(ink.bounds.xMax, local.xMax),
                  f32.max(ink.bounds.yMax, local.yMax),
                )
              } else {
                ink.bounds = local
              }
              ink.present = true
            }
            let px = i32.toF32(pen.x)
            let py = i32.toF32(pen.y)
            let bounds = if turn == 1 {
              Rect<f32>.new(px - top - h, py + left, px - top, py + left + w)
            } else if turn == 3 {
              Rect<f32>.new(px + top, py - left - w, px + top + h, py - left)
            } else {
              Rect<f32>.new(px + left, py + top, px + left + w, py + top + h)
            }
            if shadowed && &value.kind == &Kind.Polychrome {} else if &value.kind
              == &Kind.Polychrome {
              drop run p.scene.image(
                ImageSprite {
                  quarterTurns: turn,
                  clipBounds: bounds,
                  bounds: bounds,
                  mask: mask,
                  tile: value.tile,
                  opacity: color.a,
                  cornerRadii: Radii.zero(),
                  grayscale: false,
                  nearest: false,
                },
              )
            } else {
              drop run p.scene.glyph(
                GlyphSprite { bounds: bounds, mask: mask, tile: value.tile, color: color },
              )
            }
            p.stats.glyphs = p.stats.glyphs + 1
          } else {
            ink.valid = false
          }
          i = i + 1
        }
        if cacheable && !shadowed {
          while p.textInk.length() <= t.shapeKey {
            run p.textInk.append(TextInk.empty())
          }
          p.textInk.set(t.shapeKey, ink)
        }
      }
    }
  }
  if c.text.emphasis.mark != 0 && p.nodes.asSlice()[u32.toUsize(slot)].kind != NodeKind.Input {
    let markColor = if shadowed || c.text.emphasis.color == 0 { color } else { unpackColor(c.text.emphasis.color) }
    run paintEmphasis(&mut p, slot, &f, t.shapeKey, t.fontKey, &c, markColor, mask)
  }
  let line = c.text.decoration
  if line.underline || line.overline || line.lineThrough {
    let size = shaped.size
    let thickness = f32.max(1.0, size / 16.0 * s)
    let x0 = f.worldLocation.x * s
    let x1 = (f.worldLocation.x + f.size.width) * s
    let color = if shadowed {
      color
    } else {
      c.text.lineColor()
    }
    if vertical {
      let y0 = f.worldLocation.y * s
      let y1 = (f.worldLocation.y + f.size.height) * s
      if line.underline {
        run verticalLine(
          &mut p,
          (f.worldLocation.x + size * 0.1) * s,
          y0,
          y1,
          thickness,
          color,
          c.text.wavy,
          mask,
        )
      }
      if line.overline {
        run verticalLine(
          &mut p,
          (f.worldLocation.x + f.size.width - size * 0.1) * s,
          y0,
          y1,
          thickness,
          color,
          c.text.wavy,
          mask,
        )
      }
      if line.lineThrough {
        run verticalLine(
          &mut p,
          (f.worldLocation.x + f.size.width * 0.5) * s,
          y0,
          y1,
          thickness,
          color,
          c.text.wavy,
          mask,
        )
      }
      return ()
    }
    if line.underline {
      run underline(
        &mut p,
        x0,
        x1,
        (baseline + size * 0.1) * s,
        thickness,
        color,
        c.text.wavy,
        mask,
      )
    }
    if line.overline {
      run underline(
        &mut p,
        x0,
        x1,
        (baseline - size * 0.9) * s,
        thickness,
        color,
        c.text.wavy,
        mask,
      )
    }
    if line.lineThrough {
      run underline(
        &mut p,
        x0,
        x1,
        (baseline - size * 0.3) * s,
        thickness,
        color,
        c.text.wavy,
        mask,
      )
    }
  }
}

fn unpackColor(word: u32) -> Rgba<f32> {
  return Rgba<f32> {
    r: u32.toF32(word & 255) / 255.0,
    g: u32.toF32((word / 256) & 255) / 255.0,
    b: u32.toF32((word / 65536) & 255) / 255.0,
    a: u32.toF32(word / 16777216) / 255.0,
  }
}

/// `text-emphasis` marks (CSS Text Decoration 3 §3): one per typographic character of the
/// fragment, none on spaces, controls and punctuation, centered on the character's advance, half
/// the font size, beyond the text's over or under edge. Keyword marks are drawn as shapes; a
/// string's first character from the text's own face when it has the glyph.
effect fn paintEmphasis(p: &mut Painter<'_, '_>, slot: u32, f: &Fragment, shapeKey: usize, fontKey: usize,
  c: &Computed, color: Rgba<f32>, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let emphasis = c.text.emphasis
  let mode = c.text.writingMode
  let vertical = mode != WritingMode.HorizontalTb
  let reverse = mode == WritingMode.SidewaysLr
  let s = p.scale
  let size = p.text.glyphRun(shapeKey).size
  let m = size * 0.5
  let under = if vertical { emphasis.left } else { emphasis.under }
  let mut mark = emphasis.mark
  if mark < computed_values.EMPHASIS_KEYWORD + 16 && mark >= computed_values.EMPHASIS_KEYWORD && mark % 8 == 0 {
    // `filled` or `open` alone: circles across, sesame down.
    let shape: u32 = if vertical { 5 } else { 2 }
    mark = mark + shape
  }
  let mut custom: u32 = 0
  if mark >= 32 && fontKey < p.faces.length() {
    if let Option<&FontFace>.Some { value: face } = p.faces.asSlice()[fontKey].face.get() {
      let map = Charmap.new(&face.font)
      if let Option.Some { value: glyph } = map.mapUnicode(mark) { custom = glyph.toU32() }
    }
    if custom == 0 { return () }
  }
  // Centers first: the glyphs and the text are borrowed from the painter that draws.
  let mut centers = List<f32>.make()
  let glyphs = p.text.runGlyphs(shapeKey)
  // The fragment's own text node: `slot` is the element that styles it.
  let own = slotIn(&p.slotOfCss.*, f.source)
  if own == NONE { return () }
  let text = String.utf8Bytes(String.view(&p.nodes.asSlice()[u32.toUsize(own)].text))
  let mut i: usize = 0
  while i < glyphs.length {
    let cluster = u32.toUsize(glyphs[i].cluster)
    // An upright glyph's pen sits at the end of its advance in the line direction.
    let back: f32 = if vertical && glyphs[i].upright { glyphs[i].advance } else { 0.0 }
    let mut low = glyphs[i].x - back
    let mut high = glyphs[i].x - back + glyphs[i].advance
    let mut j = i + 1
    while j < glyphs.length && u32.toUsize(glyphs[j].cluster) == cluster {
      let shift: f32 = if glyphs[j].upright { glyphs[j].advance } else { 0.0 }
      low = f32.min(low, glyphs[j].x - shift)
      high = f32.max(high, glyphs[j].x - shift + glyphs[j].advance)
      j = j + 1
    }
    i = j
    if cluster >= text.length || !first_letter.emphasized(first_letter.decodeAt(text, cluster)) { continue }
    let along = (low + high) * 0.5
    if !vertical {
      run centers.append(f.worldLocation.x + along)
      run centers.append(if under { f.worldLocation.y + f.size.height + m * 0.5 } else { f.worldLocation.y - m * 0.5 })
    } else {
      // Beside the em box, centered in the line: the half-leading does not push marks away.
      let middle = f.worldLocation.x + f.size.width * 0.5
      run centers.append(if under { middle - (size + m) * 0.5 } else { middle + (size + m) * 0.5 })
      run centers.append(if reverse { f.worldLocation.y + f.size.height - along } else { f.worldLocation.y + along })
    }
  }
  let mut k: usize = 0
  while k + 1 < centers.length() {
    let cx = centers.get(k)
    let cy = centers.get(k + 1)
    k = k + 2
    if custom != 0 {
      if let Option<&FontFace>.Some { value: face } = p.faces.asSlice()[fontKey].face.get() {
        let mut outline = GlyphRasterizer.make()
        if run outline.outlinePath(&face, custom, f32.toF64(m * s), 0.0, 0.0) {
          // The mark's em box is centered: its baseline sits 0.35 em below the center.
          let transform = Affine.new(1.0, 0.0, 0.0, 1.0, f32.toF64((cx - m * 0.5) * s), f32.toF64((cy + m * 0.35) * s))
          drop run Effect.catchAll(p.paths.fill(&mut p.scene, 0, outline.lastPath(), &transform, NONZERO, Background.solid(color), mask), noPath)
        }
      }
      continue
    }
    run emphasisShape(&mut p, mark - computed_values.EMPHASIS_KEYWORD, cx * s, cy * s, m * s, color, mask)
  }
}

/// Keyword mark `code` (shape plus 8 when open) centered at (`x`, `y`), in an `em` box, device
/// pixels.
effect fn emphasisShape(p: &mut Painter<'_, '_>, code: u32, x: f32, y: f32, em: f32, color: Rgba<f32>, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let open = code >= 8
  let shape = code % 8
  let transform = Affine.new(f32.toF64(em), 0.0, 0.0, f32.toF64(em), f32.toF64(x), f32.toF64(y))
  let line = Stroke.make(0.08)
  let mut path = VectorPath.make()
  let mut inner = VectorPath.make()
  if shape == 1 { run path.circle(0.0, 0.0, 0.17) }
  else if shape == 2 { run path.circle(0.0, 0.0, 0.4) }
  else if shape == 3 {
    run path.circle(0.0, 0.0, 0.4)
    run inner.circle(0.0, 0.0, 0.2)
  } else if shape == 4 {
    run path.moveTo(0.0, -0.4)
    run path.lineTo(0.42, 0.32)
    run path.lineTo(-0.42, 0.32)
    run path.close()
  } else if shape == 5 {
    // A sesame dot (U+FE45): a teardrop, its tail up and to the left.
    run path.moveTo(-0.17, -0.36)
    run path.cubicTo(0.05, -0.22, 0.3, -0.05, 0.25, 0.15)
    run path.cubicTo(0.22, 0.35, -0.05, 0.38, -0.08, 0.18)
    run path.cubicTo(-0.1, 0.0, -0.12, -0.2, -0.17, -0.36)
    run path.close()
  } else {
    return ()
  }
  if open {
    drop run Effect.catchAll(p.paths.stroke(&mut p.scene, 0, &path, &line, &transform, Background.solid(color), mask), noPath)
    if shape == 3 { drop run Effect.catchAll(p.paths.stroke(&mut p.scene, 0, &inner, &line, &transform, Background.solid(color), mask), noPath) }
  } else if shape == 3 {
    // ◉: a ring around a dot.
    drop run Effect.catchAll(p.paths.stroke(&mut p.scene, 0, &path, &line, &transform, Background.solid(color), mask), noPath)
    drop run Effect.catchAll(p.paths.fill(&mut p.scene, 0, &inner, &transform, NONZERO, Background.solid(color), mask), noPath)
  } else {
    drop run Effect.catchAll(p.paths.fill(&mut p.scene, 0, &path, &transform, NONZERO, Background.solid(color), mask), noPath)
  }
}

effect fn verticalLine(
  p: &mut Painter<'_, '_>,
  x: f32,
  y0: f32,
  y1: f32,
  thickness: f32,
  color: Rgba<f32>,
  wavy: bool,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut y = y0
  while y < y1 {
    let end = if wavy {
      f32.min(y1, y + thickness)
    } else {
      y1
    }
    let offset: f32 = if wavy {
      f32.sin((y - y0) / thickness * 1.5707963) * thickness
    } else {
      0.0
    }
    drop run p.scene.quad(
      Quad.fill(
        Rect<f32>.new(x + offset, y, x + offset + thickness, end),
        mask,
        Background.solid(color),
      ),
    )
    y = end
  }
}

effect fn underline(
  p: &mut Painter<'_, '_>,
  x0: f32,
  x1: f32,
  y: f32,
  thickness: f32,
  color: Rgba<f32>,
  wavy: bool,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let height = if wavy {
    thickness * 3.0
  } else {
    thickness
  }
  drop run p.scene.underline(
    Underline {
      bounds: Rect<f32>.new(x0, y, x1, y + height),
      mask: mask,
      color: color,
      thickness: thickness,
      wavy: wavy,
    },
  )
}

/// Paints the content of an image, icon or canvas node over its content box.
effect fn paintContent(p: &mut Painter<'_, '_>, slot: u32, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let kind = node.kind
  let c = node.computed().*
  let resource = node.resource
  let live = node.svg.isSome()
  let s = p.scale
  let content = device(contentBox(f), s)
  let corners = radiiOf(&p.*, slot, &c, f).scaled(s).insetTo(device(borderBox(f), s), content)
  // An image showing an SVG file draws it as an icon.
  let bitmap = match p.resources.get(resource) {
    Option<Resource>.Some { value } => match value {
      Resource.Image { .. } => true
      Resource.Icon { .. } => false
    }
    Option<Resource>.None => true
  }
  if kind == NodeKind.Image && bitmap {
    if let Option<Resource>.Some { value } = p.resources.get(resource) {
      if let Resource.Image { image, width, height } = value {
        let tile = run p.resources.imageTile(&mut p.atlas, image)
        if let Option<AtlasTile>.Some { value: placed } = tile {
          drop run p.scene.image(
            ImageSprite {
              quarterTurns: 0,
              clipBounds: content,
              bounds: fittedImage(
                content,
                u32.toF32(width) * s,
                u32.toF32(height) * s,
                c.paint.objectFit,
                c.paint.objectX,
                c.paint.objectY,
                s,
              ),
              // clipBounds already clips content; a second mask would apply edge coverage twice.
              mask: mask,
              tile: placed,
              opacity: 1.0,
              cornerRadii: corners,
              grayscale: false,
              nearest: c.nearest,
            },
          )
        }
      }
    }
  } else if kind == NodeKind.Icon && live {
    run paintLiveSvg(&mut p, slot, content, mask)
  } else if kind == NodeKind.Icon || kind == NodeKind.Image {
    if let Option<Resource>.Some { value } = p.resources.get(resource) {
      if let Resource.Icon { icon: own } = value {
        let mut icon = own
        let mut viewportWidth: f64 = 0.0
        let mut viewportHeight: f64 = 0.0
        if kind == NodeKind.Icon {
          // Page CSS on the root, custom properties, and any page CSS rules matched on inner SVG elements.
          let mut css = run c.svg.css()
          let mut key = c.svg.key()
          if let Option.Some { value: variables } = p.resources.iconVariables(slot) {
            run css.appendSlice(variables.css.asSlice())
            key = Hash.combine(key, variables.key)
          }
          let mut styledKey: u64 = 0
          let mut styledMarkup = List<u8>.make()
          if let Option.Some { value: styled } = p.resources.styledIcon(slot, resource) {
            styledKey = Hash.combine(key, styled.key)
            run styledMarkup.appendSlice(styled.markup.asSlice())
          }
          if styledMarkup.length() != 0 {
            if let Option.Some { value: painted } = run p.resources.paintedIconFromMarkup(&mut p.atlas, resource, styledKey, styledMarkup.asSlice(), css.asSlice()) {
              icon = painted
            }
          } else if css.length() != 0 {
            if let Option.Some { value: painted } = run p.resources.paintedIcon(&mut p.atlas, resource, key, css.asSlice()) { icon = painted }
          }
          // An inline svg's viewport is its CSS box, which overrides the root's own size. In a
          // box of another shape than the svg's (or when the root gave no pixel size), its
          // preserveAspectRatio places it there without re-parsing the markup.
          let ownRatio = f64.toF32(p.resources.iconRatio(icon))
          let width = content.width() / p.scale
          let height = content.height() / p.scale
          let missingSize = p.resources.iconWidth(icon) <= 0.0 || p.resources.iconHeight(icon) <= 0.0
          if width > 0.0 && height > 0.0
            && (missingSize || (ownRatio > 0.0 && f32.isFinite(ownRatio) && f32.abs(width / height - ownRatio) > ownRatio * 0.001)) {
            viewportWidth = f32.toF64(width)
            viewportHeight = f32.toF64(height)
          }
        }
        // An svg keeps its aspect in a box of another shape (xMidYMid meet); an inline one sized
        // to its box above uses the box directly.
        let mut boxWidth = content.width()
        let mut boxHeight = content.height()
        if viewportWidth == 0.0 {
          let ratio = f64.toF32(p.resources.iconRatio(icon))
          if ratio > 0.0 && f32.isFinite(ratio) {
            if boxWidth > boxHeight * ratio {
              boxWidth = boxHeight * ratio
            } else {
              boxHeight = boxWidth / ratio
            }
          }
        }
        let w = f32.floor(boxWidth + 0.5)
        let h = f32.floor(boxHeight + 0.5)
        let x = f32.floor(content.xMin + (content.width() - w) / 2.0 + 0.5)
        let y = f32.floor(content.yMin + (content.height() - h) / 2.0 + 0.5)
        if w >= 1.0 && h >= 1.0 {
          let tinted = p.resources.tinted(icon)
          let mut renderW = w
          let mut renderViewportW = viewportWidth
          if kind == NodeKind.Icon && viewportWidth > 0.0 && !tinted && p.resources.iconXMinSlice(icon) {
            let ownRatio = f64.toF32(p.resources.iconRatio(icon))
            if ownRatio > 0.0 && f32.isFinite(ownRatio) && w < h * ownRatio {
              let maxSliceW = f32.floor(h * ownRatio)
              let mut bucket = f32.ceil(w / 256.0) * 256.0
              if bucket > maxSliceW {
                bucket = maxSliceW
              }
              if bucket > w && bucket <= 2048.0 {
                renderW = bucket
                renderViewportW = f32.toF64(bucket / p.scale)
              }
            }
          }
          // Cap rasterization size to 4096px per side so huge SVGs (e.g. map canvases) still fit
          // in the atlas and render cleanly without hitting texture or pixel budgets.
          let maxSide: f32 = 4096.0
          let mut texW = renderW
          let mut texH = h
          if texW > maxSide || texH > maxSide {
            let shrink = f32.min(maxSide / texW, maxSide / texH)
            texW = f32.max(1.0, f32.floor(texW * shrink + 0.5))
            texH = f32.max(1.0, f32.floor(texH * shrink + 0.5))
          }
          let tile = run p.resources.iconTileInViewport(
            &mut p.atlas,
            icon,
            f32.toU32(texW),
            f32.toU32(texH),
            renderViewportW,
            viewportHeight,
            p.time,
            c.text.color,
          )
          if let Option<AtlasTile>.Some { value: placed } = tile {
            let clipBounds = Rect<f32>.new(x, y, x + w, y + h)
            let bounds = Rect<f32>.new(x, y, x + renderW, y + h)
            if tinted {
              drop run p.scene.glyph(
                GlyphSprite { bounds: clipBounds, mask: mask, tile: placed, color: c.text.color },
              )
            } else {
              drop run p.scene.image(
                ImageSprite {
                  quarterTurns: 0,
                  clipBounds: clipBounds,
                  bounds: bounds,
                  mask: mask,
                  tile: placed,
                  opacity: 1.0,
                  cornerRadii: Radii.zero(),
                  grayscale: false,
                  nearest: false,
                },
              )
            }
          }
        }
      }
    }
  } else if kind == NodeKind.Canvas {
    let surface = p.nodes.asSlice()[u32.toUsize(slot)].surface()
    if surface.isSome() {
      // The host shows whatever size the client last presented, so the sprite samples the
      // whole texture; `object-fit` places it as it places an image of the natural size.
      let mut sprite = SurfaceSprite.whole(
        fittedImage(
          content,
          u32.toF32(surface.width) * s,
          u32.toF32(surface.height) * s,
          c.paint.objectFit,
          c.paint.objectX,
          c.paint.objectY,
          s,
        ),
        mask,
        surface.id,
      )
      sprite.clipBounds = content
      sprite.cornerRadii = corners
      sprite.nearest = c.nearest
      drop run p.scene.surface(sprite)
    } else {
      run paintCanvas(&mut p, slot, contentBox(f), mask)
    }
  }
}

fn channelOf(color: u32, shift: u32) -> f32 { return u32.toF32(u32.bitAnd(u32.shiftRight(color, shift), 255)) / 255.0 }

fn livePaint(kind: u8, color: u32) -> Option<LivePaint> {
  if kind == PAINT_NONE { return Option<LivePaint>.some(LivePaint.None) }
  if kind == PAINT_CURRENT { return Option<LivePaint>.some(LivePaint.Current) }
  if kind != PAINT_COLOR { return Option<LivePaint>.None }
  return Option<LivePaint>.some(LivePaint.Color { color: Rgba<f32> { r: channelOf(color, 24), g: channelOf(color, 16), b: channelOf(color, 8), a: channelOf(color, 0) } })
}

/// Appends `value` CSS pixels to `out` as `<number>px;`, to a thousandth.
effect fn appendPixels(out: &mut List<u8>, value: f32) -> () ! OutOfMemoryError ? &mut Allocator {
  let thousandths = f32.toU64(f32.min(f32.max(value, 0.0), 1000000.0) * 1000.0 + 0.5)
  let mut digits: [u8; 20] = [0; 20]
  let mut count: usize = 0
  let mut whole = thousandths / 1000
  while whole > 0 || count == 0 {
    digits[count] = u64.toU8(48 + whole % 10)
    count = count + 1
    whole = whole / 10
  }
  while count > 0 {
    count = count - 1
    run out.append(digits[count])
  }
  let fraction = thousandths % 1000
  run out.append(46)
  run out.append(u64.toU8(48 + fraction / 100))
  run out.append(u64.toU8(48 + (fraction / 10) % 10))
  run out.append(u64.toU8(48 + fraction % 10))
  run out.appendSlice(b"px;")
}

effect fn copyList(bytes: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  run out.appendSlice(bytes)
  return move out
}

/// Paints the live svg of icon node `slot` over `content`, its content box in device pixels.
effect fn paintLiveSvg(p: &mut Painter<'_, '_>, slot: u32, content: Rect<f32>, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let index = u32.toUsize(slot)
  let c = p.nodes.asSlice()[index].computed().*
  let color = c.text.color
  let clipToViewport = c.clips()
  let seed = Hash.mix(&p.seed, u32.toU64(p.nodes.asSlice()[index].id) + 0x5356470000000000)
  let taken = Intrinsic.replace(p.nodes.asMutSlice()[index].svg, Thin<LiveSvg>.none())
  if let Option<&LiveSvg>.Some { value } = taken.get() {
    let css = c.svg
    let root = RootPaint { fill: livePaint(css.fillKind, css.fill), stroke: livePaint(css.strokeKind, css.stroke), strokeWidth: css.strokeWidth }
    let mut canvas = LiveCanvas { scene: &mut p.scene.*, paths: &mut p.paths.*, seed: seed, color: color, root: root }
    run live_svg.paint(value, &mut canvas, content, p.scale, clipToViewport, mask)
  }
  let nodes = p.nodes.asMutSlice()
  nodes[index].svg = move taken
}

effect fn paintCanvas(
  p: &mut Painter<'_, '_>,
  slot: u32,
  origin: Rect<f32>,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let _span = Prof.span("ui_tree.paintCanvas")
  let s = p.scale
  let transform = Affine.new(
    f32.toF64(s),
    0.0,
    0.0,
    f32.toF64(s),
    f32.toF64(origin.xMin * s),
    f32.toF64(origin.yMin * s),
  )
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let count = node.canvas().length
  let content = node.content
  Prof.set("commands", &count)
  if count >= canvas_raster.MIN_COMMANDS {
    let ox = origin.xMin * s
    let oy = origin.yMin * s
    let bx = f32.floor(ox)
    let by = f32.floor(oy)
    let key = canvas_raster.key(&p.seed, content, s, ox - bx, oy - by)
    let raster = node.raster()
    if raster.key == key && raster.surface != NO_SURFACE {
      let bounds = Rect<f32>.new(
        bx + i32.toF32(raster.x),
        by + i32.toF32(raster.y),
        bx + i32.toF32(raster.x) + u32.toF32(raster.width),
        by + i32.toF32(raster.y) + u32.toF32(raster.height),
      )
      drop run p.scene.surface(SurfaceSprite.whole(bounds, mask, raster.surface))
      return ()
    }
    if raster.refused != key {
      let want = RasterWant { node: node.id, key: key, content: content, scale: s, fx: ox - bx, fy: oy - by }
      run p.rasters.wants.append(want)
    }
  }
  let mut path = VectorPath.make()
  let commands = p.nodes.asSlice()[u32.toUsize(slot)].canvas()
  let mut i: usize = 0
  while i < count {
    let command = commands[i]
    match command {
      CanvasCommand.FillRect { x, y, width, height, radius, color } => {
        let bounds = Rect<f32>.new(
          (origin.xMin + x) * s,
          (origin.yMin + y) * s,
          (origin.xMin + x + width) * s,
          (origin.yMin + y + height) * s,
        )
        let mut quad = Quad.fill(bounds, mask, Background.solid(color))
        quad.cornerRadii = Radii.uniform(radius * s)
        drop run p.scene.quad(quad)
      }
      CanvasCommand.MoveTo { x, y } => {
        run path.moveTo(f32.toF64(x), f32.toF64(y))
      }
      CanvasCommand.LineTo { x, y } => {
        run path.lineTo(f32.toF64(x), f32.toF64(y))
      }
      CanvasCommand.QuadTo { x1, y1, x, y } => {
        run path.quadTo(f32.toF64(x1), f32.toF64(y1), f32.toF64(x), f32.toF64(y))
      }
      CanvasCommand.CubicTo { x1, y1, x2, y2, x, y } => {
        run path.cubicTo(
          f32.toF64(x1),
          f32.toF64(y1),
          f32.toF64(x2),
          f32.toF64(y2),
          f32.toF64(x),
          f32.toF64(y),
        )
      }
      CanvasCommand.Close => {
        run path.close()
      }
      CanvasCommand.Fill { color } => {
        let _fill = Prof.span("ui_tree.canvas.fill")
        let id = canvasKey(&p.*, slot, content, i, origin)
        drop run Effect.catchAll(
          p.paths.fill(&mut p.scene, id, &path, &transform, NONZERO, Background.solid(color), mask),
          noPath,
        )
        path.clear()
      }
      CanvasCommand.Stroke { color, width } => {
        let _stroke = Prof.span("ui_tree.canvas.stroke")
        let id = canvasKey(&p.*, slot, content, i, origin)
        let stroke = Stroke.make(f32.toF64(width))
        drop run Effect.catchAll(
          p.paths.stroke(
            &mut p.scene,
            id,
            &path,
            &stroke,
            &transform,
            Background.solid(color),
            mask,
          ),
          noPath,
        )
        path.clear()
      }
    }
    i = i + 1
  }
}

fn canvasKey(
  p: &Painter<'_, '_>,
  slot: u32,
  content: u64,
  command: usize,
  origin: Rect<f32>,
) -> u64 {
  let mut h = Hash.mix(&p.seed, u32.toU64(slot))
  h = Hash.combine(h, content)
  h = Hash.combine(h, usize.toU64(command))
  h = Hash.combine(h, u32.toU64(f32.toBits(p.scale)))
  h = Hash.combine(h, u32.toU64(f32.toBits(origin.xMin)))
  h = Hash.combine(h, u32.toU64(f32.toBits(origin.yMin)))
  return h
}

effect fn paintChildren(p: &mut Painter<'_, '_>, index: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  // A zero-area inherited clip cannot expose any descendant, including overflow
  // or positioned content. Skip the subtree before glyph processing and decoration.
  if empty(mask) {
    return ()
  }

  // Positioned children and child stacking contexts paint from their context's lists
  // (`paintStack`), except in a snapshot of one node.
  let walking = p.only != NONE
  let mut child = p.output.fragments.values.asSlice()[index].firstChild
  while child != NO_INDEX {
    if walking || !p.stacking.hoisted(child) {
      run paintFragment(&mut p, child, mask)
    }
    child = p.output.fragments.values.asSlice()[child].nextSibling
  }
}

fn empty(mask: ContentMask) -> bool {
  return mask.bounds.xMax <= mask.bounds.xMin || mask.bounds.yMax <= mask.bounds.yMin
}

/// Paints what is inside fragment `index`: in CSS 2 Appendix E order when it makes a stacking
/// context, else its children in tree order. A snapshot of one node paints in tree order.
effect fn paintStack(p: &mut Painter<'_, '_>, index: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if p.only == NONE && p.output.fragments.values.asSlice()[index].parent == NO_INDEX {
    run paintRootElements(&mut p, index, mask)
  }
  if p.only != NONE || !p.stacking.stacks(index) || empty(mask) {
    run paintChildren(&mut p, index, mask)
    return ()
  }
  let steps = p.stacking.steps(index)
  let mut k: usize = 0
  while k < steps {
    let step = p.stacking.step(index, k, false)
    if step == IN_FLOW {
      run paintChildren(&mut p, index, mask)
    } else {
      run paintHoisted(&mut p, index, step, mask)
    }
    k = k + 1
  }
}

struct HeldComputed {
  value: Computed,
}

/// Pins a node's `Computed` while `Painter` is mutated: clones the 8-byte `Frozen` handle
/// for static nodes instead of copying 2 KB of `Computed`, copying only for moving nodes.
union StylePin {
  Shared { style: Frozen<Computed> },
  Owned { style: HeldComputed },
}

impl StylePin {
  fn of(node: &Node) -> StylePin {
    return if node.moving.isNone() {
      StylePin.Shared { style: node.styled.clone() }
    } else {
      StylePin.Owned { style: HeldComputed { value: node.computed().* } }
    }
  }

  @inlineAlways
  fn get(self: &Self) -> &Computed {
    return match &self.* {
      StylePin.Shared { style } => style.get()
      StylePin.Owned { style } => &style.value
    }
  }
}

/// Paints the background and border of the root elements below fragment root `root`, which
/// their own paint leaves out (see `stacking.ROOT`).
effect fn paintRootElements(p: &mut Painter<'_, '_>, root: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let output = p.output
  let mut i: usize = 0
  while i < p.stacking.elements.length() {
    let index = p.stacking.elements.get(i)
    i = i + 1
    if stacking.rootOf(output, index) != root {
      continue
    }
    let f = &output.fragments.values.asSlice()[index]
    let slot = slotIn(p.slotOfCss, f.source)
    let pin = StylePin.of(&p.nodes.asSlice()[u32.toUsize(slot)])
    let c = pin.get()
    if c.paint.opacity > 0.0 && c.text.visible && !f.nonpainting
      && (c.decorated() || hasBackgrounds(&p.*, slot)) {
      run decorate(&mut p, slot, c, f, f.decorationEdges, mask)
    }
  }
}

/// Whether box fragment `at` between a stacking context and one of its entries changes what
/// the entry paints into: a clip, or a scroll group. Nothing else can sit there: a box with
/// opacity, or sticky, makes a context of its own.
fn clipsBelow(p: &Painter<'_, '_>, at: usize) -> bool {
  let f = &p.output.fragments.values.asSlice()[at]
  if f.kind != FragmentKind.Box || f.positioningShell {
    return false
  }
  let slot = slotIn(p.slotOfCss, f.source)
  if slot == NONE {
    return false
  }
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  return node.kind != NodeKind.Text && node.computed().clips()
}

/// Paints `entry` of the lists of stacking context `root` inside the clips and scroll groups
/// of the boxes between them, as if it painted where it sits in the tree.
effect fn paintHoisted(p: &mut Painter<'_, '_>, root: usize, entry: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let values = p.output.fragments.values.asSlice()
  let mut clips: [usize; 16] = [0; 16]
  let mut count: usize = 0
  let mut overflow = List<usize>.make()
  let mut hasScroller = false
  let mut at = values[entry].parent
  while at != root && at != NO_INDEX {
    if clipsBelow(&p.*, at) {
      let slot = slotIn(p.slotOfCss, values[at].source)
      if !hasScroller && slot != NONE && layers.scroller(&p.nodes.asSlice()[u32.toUsize(slot)].computed().*) {
        hasScroller = true
      }
      if count < 16 {
        clips[count] = at
        count = count + 1
      } else {
        if overflow.length() == 0 {
          run overflow.appendSlice(Slice.view(&clips, 0, 16))
        }
        run overflow.append(at)
      }
    }
    at = values[at].parent
  }
  if !hasScroller && !inkVisible(&p.*, entry, mask) {
    p.stats.culledSubtrees = p.stats.culledSubtrees + 1
    return ()
  }
  if count == 0 {
    run paintFragment(&mut p, entry, mask)
    return ()
  }
  if overflow.length() != 0 {
    run paintThrough(&mut p, overflow.asSlice(), overflow.length(), entry, mask)
  } else {
    run paintThrough(&mut p, Slice.view(&clips, 0, count), count, entry, mask)
  }
}

/// Opens the clip and scroll group of `path[count - 1]` (the path runs bottom up), then the
/// rest of the path, then paints `entry`.
effect fn paintThrough(
  p: &mut Painter<'_, '_>,
  path: &[usize],
  count: usize,
  entry: usize,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if count == 0 {
    run paintFragment(&mut p, entry, mask)
    return ()
  }
  let at = path[count - 1]
  let output = p.output
  let f = &output.fragments.values.asSlice()[at]
  let slot = slotIn(p.slotOfCss, f.source)
  let c = p.nodes.asSlice()[u32.toUsize(slot)].computed()
  let mut inner = mask.intersect(clipMask(&p.*, slot, c, f))
  if empty(inner)
    || inner.bounds.xMax <= p.cull.xMin
    || inner.bounds.xMin >= p.cull.xMax
    || inner.bounds.yMax <= p.cull.yMin
    || inner.bounds.yMin >= p.cull.yMax {
    p.stats.culledSubtrees = p.stats.culledSubtrees + 1
    return ()
  }
  let saved = p.cull
  let scrolled = layers.scroller(c)
  if scrolled {
    inner = run openScrollerAt(&mut p, slot, at, mask, inner)
  }
  run paintThrough(&mut p, path, count - 1, entry, inner)
  if scrolled {
    p.cull = saved
    run p.scene.popScrollGroup()
  }
}

/// `mask` cut by the clips between stacking context `root` and its entry `entry`, matching
/// `paintThrough` (top-down, expanding to a scroller's scrollable extent when passing through
/// a scroll container).
effect fn hoistedMask(p: &Painter<'_, '_>, root: usize, entry: usize, mask: ContentMask) -> ContentMask
  ! OutOfMemoryError
  ? &mut Allocator {
  let values = p.output.fragments.values.asSlice()
  let mut clips: [usize; 16] = [0; 16]
  let mut count: usize = 0
  let mut overflow = List<usize>.make()
  let mut at = values[entry].parent
  while at != root && at != NO_INDEX {
    if clipsBelow(p, at) {
      if count < 16 {
        clips[count] = at
        count = count + 1
      } else {
        if overflow.length() == 0 {
          run overflow.appendSlice(Slice.view(&clips, 0, 16))
        }
        run overflow.append(at)
      }
    }
    at = values[at].parent
  }
  let mut inner = mask
  let mut idx = if overflow.length() != 0 { overflow.length() } else { count }
  while idx > 0 {
    idx = idx - 1
    let cur = if overflow.length() != 0 { overflow.get(idx) } else { clips[idx] }
    let f = &values[cur]
    let slot = slotIn(p.slotOfCss, f.source)
    let c = &p.nodes.asSlice()[u32.toUsize(slot)].computed().*
    inner = inner.intersect(clipMask(p, slot, c, f))
    if empty(inner) {
      return inner
    }
    if layers.scroller(c) {
      inner = scrollerExtent(f, p.scale)
    }
  }
  return inner
}

effect fn noteOrder(p: &mut Painter<'_, '_>, index: usize, f: &Fragment) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  // The first fragment of a node. A text fragment is its text node's first when the index by
  // source says so: css-layout chains the text fragments that hold their own lines by their
  // inline formatting box, where `first` means the first of that box.
  let first = if f.kind == FragmentKind.Text {
    f.source < p.firstOf.length() && p.firstOf.get(f.source) == index
  } else {
    f.first
  }
  if !first {
    return ()
  }
  let slot = slotIn(p.slotOfCss, f.source)
  if slot != NONE && !p.nodes.asSlice()[u32.toUsize(slot)].isGenerated() {
    run p.order.append(p.nodes.asSlice()[u32.toUsize(slot)].id)
  }
}

/// Fragments whose ink cannot be bounded: canvas commands draw against the parent's mask.
const UNBOUNDED_INK: f32 = 1.0e30

fn unboundedInk() -> Rect<f32> {
  return Rect<f32>.new(-UNBOUNDED_INK, -UNBOUNDED_INK, UNBOUNDED_INK, UNBOUNDED_INK)
}

fn grow(rect: Rect<f32>, by: f32) -> Rect<f32> {
  return Rect<f32>.new(rect.xMin - by, rect.yMin - by, rect.xMax + by, rect.yMax + by)
}

fn unite(a: Rect<f32>, b: Rect<f32>) -> Rect<f32> {
  return Rect<f32>.new(
    f32.min(a.xMin, b.xMin),
    f32.min(a.yMin, b.yMin),
    f32.max(a.xMax, b.xMax),
    f32.max(a.yMax, b.yMax),
  )
}

/// Where fragment `index` itself may put ink, in CSS pixels of the viewport, not counting its
/// descendants. Generous on purpose: text gets its line height again on every side for
/// overhanging glyphs, and a shadow its offset, spread and twice its blur.
fn ownInk(
  output: &LayoutTree,
  slot: u32,
  nodes: &List<Node>,
  index: usize,
) -> Rect<f32> {
  let f = output.fragments.values.asSlice()[index]
  if f.kind == FragmentKind.Text {
    // Every run's box, grown by its reach. No run: nothing.
    let mut total = Rect<f32>.new(UNBOUNDED_INK, UNBOUNDED_INK, -UNBOUNDED_INK, -UNBOUNDED_INK)
    let mut shadow: f32 = 0.0
    if slot != NONE {
      let from = nodes.asSlice()[u32.toUsize(slot)].computed().effects.shadowFrom
      if from != NONE && u32.toUsize(from) < nodes.length() {
        if let Option<&Effects>.Some { value } = nodes.asSlice()[u32.toUsize(from)].paintEffects() {
          shadow = paint_effects.shadowReach(value.shadows.asSlice())
        }
      }
    }
    let mut runs = output.fragments.textRuns(index)
    while runs.next() {
      let x = runs.current.location.x
      let y = runs.current.location.y
      let reach = f32.max(runs.current.size.height, 16.0) + shadow
      total = unite(total, Rect<f32>.new(x - reach, y - reach, x + runs.current.size.width + reach, y + runs.current.size.height + reach))
    }
    return total
  }
  let box = borderBox(&f)
  if slot == NONE {
    return grow(box, 2.0)
  }
  let node = &nodes.asSlice()[u32.toUsize(slot)]
  if node.kind == NodeKind.Canvas {
    return unboundedInk()
  }
  let c = &node.computed().*
  // An inline `<svg>` with `overflow: visible` (e.g. a 1x1 edge overlay) can draw anywhere.
  if node.kind == NodeKind.Icon && !c.clips() {
    return unboundedInk()
  }
  let mut reach: f32 = if c.clips() && !c.decorated() && !c.effects.declared
    && !c.paint.hasShadow && !c.outline.drawn() {
    0.0
  } else {
    2.0
  }
  if c.paint.hasShadow && !c.paint.shadow.inset {
    let offset = f32.max(f32.abs(c.paint.shadow.offsetX), f32.abs(c.paint.shadow.offsetY))
    reach = reach + offset + f32.max(c.paint.shadow.spread, 0.0) + 2.0 * c.paint.shadow.blur
  }
  if c.outline.drawn() {
    reach = f32.max(reach, 2.0 + c.outline.offset + c.outline.width)
  }
  if let Option<&Effects>.Some { value } = node.paintEffects() {
    let widths = usedBorder(&c)
    if let Option.Some { value: bi } = value.borderImage.get() {
      reach = f32.max(reach, 2.0 + paint_effects.borderImageReach(value, bi, widths))
    }
    if let Option.Some { value: mb } = value.maskBorder.get() {
      reach = f32.max(reach, 2.0 + paint_effects.borderImageReach(value, mb, widths))
    }
  }
  return grow(box, reach)
}

/// Bounds every fragment's ink together with its descendants', children before parents, in CSS
/// pixels of the viewport. Child ink is intersected with per-axis overflow clips.
/// [`paintFragment`] skips a subtree whose bounds miss the current clip.
///
/// A sticky box's bounds cover everywhere it can move. `scrollers` gets, per fragment, whether its
/// subtree holds a scroll container. Ink is in layout coordinates: it does not change as
/// anything scrolls.
pub effect fn inkFragments(
  output: &LayoutTree,
  slots: &List<u32>,
  css: &LayoutTable,
  nodes: &List<Node>,
  width: f32,
  height: f32,
  out: &mut List<Rect<f32>>,
  scrollers: &mut List<bool>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = output.fragments.values.length()
  out.clear()
  scrollers.clear()
  let empty = Rect<f32>.new(UNBOUNDED_INK, UNBOUNDED_INK, -UNBOUNDED_INK, -UNBOUNDED_INK)
  run out.appendRepeated(empty, count)
  run scrollers.appendRepeated(false, count)
  let mut index = count
  while index > 0 {
    index = index - 1
    let owner = styleSlot(slots, css, nodes, output.fragments.values.asSlice()[index].source)
    drop foldInkAt(output, slots, css, nodes, width, height, &mut out, &mut scrollers, index, owner)
  }
}

fn foldInkAt(
  output: &LayoutTree, slots: &List<u32>, css: &LayoutTable, nodes: &List<Node>, width: f32, height: f32,
  out: &mut List<Rect<f32>>, scrollers: &mut List<bool>, index: usize, owner: u32,
) -> u8 {
  let fragile = settleInkAt(output, slots, css, nodes, width, height, &mut out, &mut scrollers, index, owner)
  let parent = output.fragments.values.asSlice()[index].parent
  if parent != NO_INDEX {
    let above = out.get(parent)
    let total = out.get(index)
    out.set(parent, unite(above, total))
    if scrollers.get(index) {
      scrollers.set(parent, true)
    }
  }
  return fragile
}

/// Turns `out[index]` and `scrollers[index]`, which hold the fold of the fragment's children,
/// into the fragment's own. Returns its fragility flags (`FRAGILE_SELF` / `FRAGILE_SUBTREE`).
fn settleInkAt(
  output: &LayoutTree, slots: &List<u32>, css: &LayoutTable, nodes: &List<Node>, width: f32, height: f32,
  out: &mut List<Rect<f32>>, scrollers: &mut List<bool>, index: usize, owner: u32,
) -> u8 {
  let f = &output.fragments.values.asSlice()[index]
  let own = ownInk(output, owner, nodes, index)
  let below = out.get(index)
  let mut clips = false
  let mut clippedBelow = below
  let mut sticky = false
  let mut fragile: u8 = if f.positioningShell { FRAGILE_SELF } else { FRAGILE_NONE }
  if (f.kind == FragmentKind.Box || f.kind == FragmentKind.Inline) && !f.positioningShell {
    let slot = slotIn(slots, f.source)
    if slot != NONE {
      let c = &nodes.asSlice()[u32.toUsize(slot)].computed().*
      // Its children's transforms read its perspective and its 3D rendering context sorts planes
      // across fragments (`FRAGILE_SUBTREE`); a motion path places it against its containing
      // block after layout (`FRAGILE_SELF`).
      if c.transform.deep() || c.transform.preserve3d { fragile = u8.bitOr(fragile, FRAGILE_SUBTREE) }
      if c.transform.offset.path != transform.PATH_NONE { fragile = u8.bitOr(fragile, FRAGILE_SELF) }
      clips = f.kind == FragmentKind.Box && c.clips()
      if clips {
        let clip = overflowClip(c, f)
        clippedBelow = Rect<f32>.new(
          f32.max(below.xMin, clip.xMin),
          f32.max(below.yMin, clip.yMin),
          f32.min(below.xMax, clip.xMax),
          f32.min(below.yMax, clip.yMax),
        )
      }
      sticky = c.layout.position == Position.Sticky
      if sticky { fragile = u8.bitOr(fragile, FRAGILE_SELF) }
      if f.kind == FragmentKind.Box && layers.scroller(c) {
        scrollers.set(index, true)
      }
    }
  }
  let mut total = if clippedBelow.xMax > clippedBelow.xMin
    && clippedBelow.yMax > clippedBelow.yMin {
    unite(own, clippedBelow)
  } else {
    own
  }
  match layers.flatOf(output, slots, nodes, index) {
    Option.Some { value } => {
      total = transform.mapRect(&value, total)
    }
    Option.None => {}
  }
  if sticky {
    if let Option<Sticky>.Some { value } = layers.stickyOf(
      output,
      slots,
      css,
      nodes,
      index,
      width,
      height,
    ) {
      let reach = value.reach()
      total = Rect<f32>.new(
        total.xMin + reach.xMin,
        total.yMin + reach.yMin,
        total.xMax + reach.xMax,
        total.yMax + reach.yMax,
      )
    }
  }
  if (f.kind == FragmentKind.Box || f.kind == FragmentKind.Inline) && !f.positioningShell {
    let slot = slotIn(slots, f.source)
    if slot != NONE {
      if let Option<&Effects>.Some { value } = nodes.asSlice()[u32.toUsize(slot)].paintEffects() {
        if value.filters.length() != 0 {
          total = grow(total, paint_effects.filterReach(value))
        }
      }
    }
  }
  out.set(index, total)
  return fragile
}

/// Adds each fixed box's root to the hashes, ink and scrollers of the roots that paint it
/// (see [`Stacking.rootContext`]), so their caches and culls cover it.
pub effect fn foldLiftedRoots(
  stacking: &Stacking,
  hashes: &mut List<u64>,
  ink: &mut List<Rect<f32>>,
  scrollers: &mut List<bool>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = hashes.length()
  let lifted = stacking.lifted.asSlice()
  if lifted.length == 0 {
    return ()
  }

  // Read every subtree before folding any, since lifted roots can nest.
  let mut ownHashes = List<u64>.make()
  let mut ownInks = List<Rect<f32>>.make()
  let mut i: usize = 0
  while i < lifted.length {
    run ownHashes.append(hashes.get(lifted[i].fragment))
    run ownInks.append(ink.get(lifted[i].fragment))
    i = i + 1
  }
  i = 0
  while i < lifted.length {
    let root = lifted[i].fragment
    let mut at = lifted[i].context
    let mut steps: usize = 0
    while at != NO_INDEX && at < count && steps < count {
      let hash = Hash.combine(hashes.get(at), ownHashes.get(i))
      hashes.set(at, hash)
      let bounds = unite(ink.get(at), ownInks.get(i))
      ink.set(at, bounds)
      if scrollers.get(root) {
        scrollers.set(at, true)
      }
      at = stacking.rootContext(at)
      steps = steps + 1
    }
    i = i + 1
  }
}

/// Whether the subtree of fragment `index` can show inside `mask`.
fn inkVisible(p: &Painter<'_, '_>, index: usize, mask: ContentMask) -> bool {
  if index >= p.ink.length() {
    return true
  }
  let ink = p.ink.get(index)
  let s = p.scale
  let cull = ContentMask.new(p.cull).intersect(mask).bounds
  if cull.xMin >= cull.xMax || cull.yMin >= cull.yMax {
    return false
  }
  return ink.xMin * s < cull.xMax && ink.xMax * s > cull.xMin && ink.yMin * s < cull.yMax
    && ink.yMax * s > cull.yMin
}

/// Whether the ink of fragment `index` lies inside `area` (device pixels).
fn inkInside(p: &Painter<'_, '_>, index: usize, area: Rect<f32>) -> bool {
  if index >= p.ink.length() {
    return false
  }
  let ink = p.ink.get(index)
  let s = p.scale
  return ink.xMin * s >= area.xMin && ink.xMax * s <= area.xMax && ink.yMin * s >= area.yMin
    && ink.yMax * s <= area.yMax
}

fn everywhere() -> Rect<f32> {
  return Rect<f32>.new(-UNBOUNDED_INK, -UNBOUNDED_INK, UNBOUNDED_INK, UNBOUNDED_INK)
}

/// The id a scroll group links to for slot `slot`, NONE for the unscrolled viewport.
fn linkNode(p: &Painter<'_, '_>, slot: u32) -> u32 {
  if slot == NONE {
    return NONE
  }
  return p.nodes.asSlice()[u32.toUsize(slot)].id
}

/// Paints fragment `index` and its descendants.
pub effect fn paintFragment(p: &mut Painter<'_, '_>, index: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  // A plane of a 3D rendering context paints from the context's root, in depth order.
  if p.planes && p.only == NONE && layers.planeParent(p.output, p.slotOfCss, &p.nodes.*, index) != NO_INDEX {
    return ()
  }
  if !inkVisible(&p.*, index, mask) {
    p.stats.culledSubtrees = p.stats.culledSubtrees + 1
    return ()
  }
  let sticky = layers.stickyOf(p.output, p.slotOfCss, p.css, &p.nodes.*, index, p.width, p.height)
  if let Option<Sticky>.Some { value } = sticky {
    // A sticky box draws in a group that follows its scrollport, over everywhere it can go.
    let s = p.scale
    let ink = if index < p.ink.length() {
      device(p.ink.get(index), s)
    } else {
      everywhere()
    }
    let link = ScrollLink {
      node: linkNode(&p.*, value.port),
      x: value.x.inDevice(s),
      y: value.y.inDevice(s),
    }
    drop run p.scene.pushScrollGroup(link, everywhere(), ink)
    let saved = p.cull
    p.cull = everywhere()
    run paintTransformed(&mut p, index, mask)
    p.cull = saved
    run p.scene.popScrollGroup()
    return ()
  }
  run paintTransformed(&mut p, index, mask)
}

/// The ink of fragment `index` and its descendants in its own layout space, before its
/// transform: `p.ink` holds it mapped.
fn localInk(p: &Painter<'_, '_>, index: usize) -> Rect<f32> {
  let values = p.output.fragments.values.asSlice()
  let owner = styleSlot(p.slotOfCss, p.css, &p.nodes.*, values[index].source)
  let mut total = ownInk(p.output, owner, &p.nodes.*, index)
  let mut below = Rect<f32>.new(UNBOUNDED_INK, UNBOUNDED_INK, -UNBOUNDED_INK, -UNBOUNDED_INK)
  let mut child = values[index].firstChild
  while child != NO_INDEX {
    if child < p.ink.length() {
      below = unite(below, p.ink.get(child))
    }
    child = values[child].nextSibling
  }
  let slot = slotIn(p.slotOfCss, values[index].source)
  if slot != NONE {
    let c = &p.nodes.asSlice()[u32.toUsize(slot)].computed().*
    if c.clips() {
      let clip = overflowClip(c, &values[index])
      below = Rect<f32>.new(
        f32.max(below.xMin, clip.xMin),
        f32.max(below.yMin, clip.yMin),
        f32.min(below.xMax, clip.xMax),
        f32.min(below.yMax, clip.yMax),
      )
    }
  }
  if below.xMax > below.xMin && below.yMax > below.yMin {
    total = unite(total, below)
  }
  return total
}

/// Paints fragment `index` as the group of its node's [`Move`], if it has one: a scroll group
/// whose position is the translation now, which the renderer moves along the transition by
/// itself. Paint keeps what shows at either end, so a renderer that runs the whole move alone
/// has the content. False, painting nothing, when the node has no move.
effect fn paintMove(p: &mut Painter<'_, '_>, index: usize, found: Option<Matrix3<f32>>, mask: ContentMask) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let f = &p.output.fragments.values.asSlice()[index]
  if f.kind != FragmentKind.Box || !f.first || !f.last {
    return false
  }
  let slot = slotIn(p.slotOfCss, f.source)
  if slot == NONE || !p.nodes.asSlice()[u32.toUsize(slot)].sliding {
    return false
  }
  let flat = found.unwrapOr(Matrix3<f32>.identity())
  if !transform.translation(&flat) {
    return false
  }
  let moves = p.moves.asSlice()
  let mut at: usize = 0
  while at < moves.length && moves[at].slot != slot {
    at = at + 1
  }
  if at == moves.length {
    return false
  }
  let slide = moves[at]
  let s = p.scale
  let dx = flat.values[6] * s
  let dy = flat.values[7] * s
  let follows = ScrollAxis { factor: 1.0, base: 0.0, low: -UNBOUNDED_INK, high: UNBOUNDED_INK }
  run p.scene.setScroll(
    ScrollPosition {
      node: slide.node,
      x: dx,
      y: dy,
      minX: -UNBOUNDED_INK,
      maxX: UNBOUNDED_INK,
      minY: -UNBOUNDED_INK,
      maxY: UNBOUNDED_INK,
    },
  )
  drop run p.scene.pushRoundedScrollGroup(ScrollLink { node: slide.node, x: follows, y: follows }, mask, mask.bounds)
  let saved = p.cull
  let now = Rect<f32>.new(saved.xMin - dx, saved.yMin - dy, saved.xMax - dx, saved.yMax - dy)
  let first = Rect<f32>.new(
    saved.xMin - slide.fromX * s, saved.yMin - slide.fromY * s, saved.xMax - slide.fromX * s, saved.yMax - slide.fromY * s)
  let last = Rect<f32>.new(
    saved.xMin - slide.toX * s, saved.yMin - slide.toY * s, saved.xMax - slide.toX * s, saved.yMax - slide.toY * s)
  p.cull = unite(now, unite(first, last))
  run paintFragmentIn(&mut p, index, ContentMask.new(everywhere()))
  p.cull = saved
  run p.scene.popScrollGroup()
  return true
}

/// Paints fragment `index` through its transform, if it has one: a plain move is a scroll group
/// with a fixed offset, anything else a layer drawn through the matrix. Inside, the subtree
/// paints in its own layout space with an unbounded mask, so its cached paint replays however
/// the transform moves; `mask` clips where it lands.
effect fn paintTransformed(p: &mut Painter<'_, '_>, index: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if p.planes && p.only == NONE && layers.establishes(p.output, p.slotOfCss, &p.nodes.*, index) {
    run paintContext(&mut p, index, mask)
    return ()
  }
  let found = layers.flatOf(p.output, p.slotOfCss, &p.nodes.*, index)
  if p.moves.length() != 0 && run paintMove(&mut p, index, found, mask) {
    return ()
  }
  if found.isNone() {
    run paintFragmentIn(&mut p, index, mask)
    return ()
  }
  if layers.hiddenBack(p.output, p.slotOfCss, &p.nodes.*, index) {
    return ()
  }
  let flat = found.unwrapOr(Matrix3<f32>.identity())
  let s = p.scale
  let saved = p.cull
  if transform.translation(&flat) {
    let dx = flat.values[6] * s
    let dy = flat.values[7] * s
    let fixed = ScrollAxis { factor: 0.0, base: 0.0, low: -UNBOUNDED_INK, high: UNBOUNDED_INK }
    let mut x = fixed
    x.base = dx
    let mut y = fixed
    y.base = dy
    let ink = if index < p.ink.length() {
      device(p.ink.get(index), s)
    } else {
      everywhere()
    }
    drop run p.scene.pushRoundedScrollGroup(ScrollLink { node: NONE, x: x, y: y }, mask, ink)
    p.cull = Rect<f32>.new(saved.xMin - dx, saved.yMin - dy, saved.xMax - dx, saved.yMax - dy)
    run paintFragmentIn(&mut p, index, ContentMask.new(everywhere()))
    p.cull = saved
    run p.scene.popScrollGroup()
    return ()
  }
  let ink = localInk(&p.*, index)
  run paintLayer(&mut p, index, flat, ink, mask, Option<Polygon>.None)
  p.cull = saved
}

/// A plane of a 3D rendering context: fragment `index`, `matrix` from its layout space into
/// the context's, and `ink` its own content's bounds there.
struct Plane {
  index: usize,
  matrix: Matrix4<f32>,
  ink: Rect<f32>,
}

impl Copy for Plane {}

/// Paints the 3D rendering context fragment `root` establishes: each plane (a box of the
/// context with what flattens into it) is a layer drawn through its accumulated matrix, the
/// planes back to front, split where they cross (see `depth_sort`). A plane showing a hidden
/// back face draws nothing; the planes in front of it still do.
effect fn paintContext(p: &mut Painter<'_, '_>, root: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut planes = List<Plane>.make()
  let mut quads = List<Polygon>.make()
  let mut at = root
  while at != NO_INDEX {
    if layers.contextOf(p.output, p.slotOfCss, &p.nodes.*, at) == root
      && !layers.hiddenBack(p.output, p.slotOfCss, &p.nodes.*, at) {
      let m = layers.accumulated(p.output, p.slotOfCss, &p.nodes.*, at)
      let ink = planeInk(&p.*, at)
      if ink.xMax > ink.xMin && ink.yMax > ink.yMin {
        if let Option.Some { value } = depth_sort.ofRect(usize.toU32(planes.length()), &m, ink) {
          run planes.append(Plane { index: at, matrix: m, ink: ink })
          run quads.append(value)
        }
      }
    }
    at = layers.nextInTree(p.output, at, root)
  }
  let mut order = List<Polygon>.make()
  run depth_sort.sort(&quads, &mut order)
  let saved = p.cull
  let mut i: usize = 0
  while i < order.length() {
    let piece = order.get(i)
    i = i + 1
    let plane = planes.get(u32.toUsize(piece.plane))
    let clip = if piece.whole { Option<Polygon>.None } else { Option<Polygon>.some(piece) }
    run paintLayer(&mut p, plane.index, transform.flatten(plane.matrix), plane.ink, mask, clip)
  }
  p.cull = saved
}

/// The ink of fragment `index` with what paints into its plane: its descendants but the
/// planes of its 3D rendering context, in its own layout space.
fn planeInk(p: &Painter<'_, '_>, index: usize) -> Rect<f32> {
  let values = p.output.fragments.values.asSlice()
  // The plane is sorted by these bounds: the margin `ownInk` keeps around a plain box would
  // make planes that meet at an edge, a cube's faces, cut one another.
  let slot = slotIn(p.slotOfCss, values[index].source)
  let c = &p.nodes.asSlice()[u32.toUsize(slot)].computed().*
  // A box that draws nothing of its own (a cube's container) is no plane: it would cut
  // everything it passes through.
  let mut total = if c.paint.hasShadow || c.outline.drawn() {
    ownInk(p.output, styleSlot(p.slotOfCss, p.css, &p.nodes.*, values[index].source), &p.nodes.*, index)
  } else if c.decorated() || hasBackgrounds(p, slot) || p.nodes.asSlice()[u32.toUsize(slot)].kind != NodeKind.Box {
    borderBox(&values[index])
  } else {
    Rect<f32>.new(UNBOUNDED_INK, UNBOUNDED_INK, -UNBOUNDED_INK, -UNBOUNDED_INK)
  }
  let mut child = values[index].firstChild
  while child != NO_INDEX {
    if child < p.ink.length() && layers.planeParent(p.output, p.slotOfCss, &p.nodes.*, child) == NO_INDEX {
      total = unite(total, p.ink.get(child))
    }
    child = values[child].nextSibling
  }
  return total
}

/// Paints fragment `index` in a layer drawn through `flat` (CSS pixels of its layout space to
/// those of the current layer), `bounds` holding its ink. `clip`, when set, is the convex
/// piece of a 3D rendering context's plane to draw, in the context's space: the layer draws
/// only that part of itself.
effect fn paintLayer(
  p: &mut Painter<'_, '_>,
  index: usize,
  flat: Matrix3<f32>,
  ink: Rect<f32>,
  mask: ContentMask,
  clip: Option<Polygon>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = p.scale
  let saved = p.cull
  // The matrix in device pixels: scale, map, then scale back.
  let a = flat.values
  let onDevice = Matrix3<f32>.new([a[0], a[1], a[2] / s, a[3], a[4], a[5] / s, a[6] * s, a[7] * s, a[8]])
  let bounds = device(ink, s)
  drop run p.scene.pushTransformLayer(
    bounds,
    mask,
    Isolation { opacity: 1.0, blend: 0 },
    onDevice,
  )
  p.cull = everywhere()
  let cut = run cutTo(&mut p, flat, bounds, clip)
  run paintFragmentIn(&mut p, index, ContentMask.new(everywhere()))
  if cut {
    run p.scene.popLayer()
  }
  p.cull = saved
  run p.scene.popLayer()
}

/// The unit normal of the edge from (`ax`, `ay`) to (`bx`, `by`), to its right in y-down
/// coordinates: outward for a polygon wound with positive area.
fn outward(ax: f32, ay: f32, bx: f32, by: f32) -> [f32; 2] {
  let dx = bx - ax
  let dy = by - ay
  let length = f32.sqrt(dx * dx + dy * dy)
  if length < 0.000001 {
    return [0.0, 0.0]
  }
  return [dy / length, -dx / length]
}

/// Opens a layer masked to the piece `clip` of a plane drawn through `flat`, in the plane's
/// own space; false, and nothing opened, without one.
effect fn cutTo(p: &mut Painter<'_, '_>, flat: Matrix3<f32>, bounds: Rect<f32>, clip: Option<Polygon>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let piece = match clip {
    Option.Some { value } => value
    Option.None => {
      return false
    }
  }
  let found = flat.inverse()
  if found.isNone() {
    return false
  }
  let inverse = found.unwrapOr(Matrix3<f32>.identity())
  let s = p.scale
  let count = u32.toUsize(piece.count)
  let mut xs: [f32; 16] = [0.0; 16]
  let mut ys: [f32; 16] = [0.0; 16]
  let mut area: f32 = 0.0
  let mut i: usize = 0
  while i < count {
    let local = transform.map(&inverse, piece.x[i], piece.y[i]).unwrapOr(Point2<f32> { x: 0.0, y: 0.0 })
    xs[i] = local.x * s
    ys[i] = local.y * s
    i = i + 1
  }
  i = 0
  while i < count {
    let j = (i + 1) % count
    area = area + xs[i] * ys[j] - xs[j] * ys[i]
    i = i + 1
  }
  // Pieces of one plane meet along their cut, where both edges are antialiased: grown by half
  // a pixel they overlap there instead of letting the background show through as a seam.
  let grow: f32 = if area > 0.0 { 0.5 } else { -0.5 }
  let mut path = VectorPath.make()
  i = 0
  while i < count {
    let before = (i + count - 1) % count
    let after = (i + 1) % count
    let n1 = outward(xs[before], ys[before], xs[i], ys[i])
    let n2 = outward(xs[i], ys[i], xs[after], ys[after])
    let dot = n1[0] * n2[0] + n1[1] * n2[1]
    let k = grow / f32.max(1.0 + dot, 0.2)
    let x = f32.toF64(xs[i] + (n1[0] + n2[0]) * k)
    let y = f32.toF64(ys[i] + (n1[1] + n2[1]) * k)
    if i == 0 {
      run path.moveTo(x, y)
    } else {
      run path.lineTo(x, y)
    }
    i = i + 1
  }
  run path.close()
  let everything = ContentMask.new(everywhere())
  drop run p.scene.pushEffectLayer(bounds, everything, Isolation { opacity: 1.0, blend: 0 }, LayerEffects.none())
  drop run p.scene.pushMaskLayer()
  run paint_effects.fillShape(&mut p, &path, everything)
  run p.scene.popLayer()
  return true
}

effect fn paintFragmentIn(p: &mut Painter<'_, '_>, index: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let output = p.output
  let f = &output.fragments.values.asSlice()[index]
  if f.positioningShell {
    run paintChildren(&mut p, index, mask)
    return ()
  }
  if p.only != NONE && !p.inside {
    let slot = slotIn(p.slotOfCss, f.source)
    if slot == p.only {
      p.inside = true
      run paintFragmentIn(&mut p, index, mask)
      p.inside = false
      return ()
    }

    // Scroll containers above the subtree still move it.
    if slot != NONE && f.kind == FragmentKind.Box
      && p.nodes.asSlice()[u32.toUsize(slot)].kind != NodeKind.Text {
      let scrolled = layers.scroller(p.nodes.asSlice()[u32.toUsize(slot)].computed())
      if scrolled {
        let inner = mask.intersect(clipMask(&p.*, slot, p.nodes.asSlice()[u32.toUsize(slot)].computed(), f))
        let saved = p.cull
        let content = run openScrollerAt(&mut p, slot, index, mask, inner)
        run paintChildren(&mut p, index, content)
        p.cull = saved
        run p.scene.popScrollGroup()
        return ()
      }
    }
    run paintChildren(&mut p, index, mask)
    return ()
  }
  p.stats.paintedFragments = p.stats.paintedFragments + 1
  match f.kind {
    FragmentKind.Line => {
      run paintChildren(&mut p, index, mask)
    }
    FragmentKind.Text => {
      run paintText(&mut p, index, f.*, mask)
    }
    FragmentKind.Inline => {
      run noteOrder(&mut p, index, f)
      let slot = slotIn(p.slotOfCss, f.source)
      if slot != NONE && !f.nonpainting {
        let pin = StylePin.of(&p.nodes.asSlice()[u32.toUsize(slot)])
        let c = pin.get()
        if c.text.visible && c.decorated() {
          run decorate(&mut p, slot, c, f, f.decorationEdges, mask)
        }
      } else if slot == NONE && !f.nonpainting {
        run decorateRun(&mut p, f, mask)
      }
      run paintChildren(&mut p, index, mask)
      if slot != NONE && !f.nonpainting {
        let pin = StylePin.of(&p.nodes.asSlice()[u32.toUsize(slot)])
        let c = pin.get()
        if c.text.visible {
          if c.outline.drawn() {
            run paintOutline(&mut p, slot, c, borderBox(f), mask)
          }
        }
      }
    }
    FragmentKind.Box => {
      run paintBox(&mut p, index, f, mask)
    }
  }
}

fn sameRect(a: Rect<f32>, b: Rect<f32>) -> bool {
  return a.xMin == b.xMin && a.yMin == b.yMin && a.xMax == b.xMax && a.yMax == b.yMax
}

/// Moves the cache ranges of the nodes inside a replayed subtree to where the replay put them,
/// and records their paint order.
effect fn shiftCaches(
  p: &mut Painter<'_, '_>,
  index: usize,
  from: usize,
  to: usize,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let output = p.output
  let parent = &output.fragments.values.asSlice()[index]
  let parentSlot = slotIn(p.slotOfCss, parent.source)
  let mut inner = mask
  if parent.kind == FragmentKind.Box && !parent.positioningShell && parentSlot != NONE {
    let c = p.nodes.asSlice()[u32.toUsize(parentSlot)].computed()
    if c.paint.opacity <= 0.0 {
      return ()
    }
    if c.clips() {
      inner = mask.intersect(clipMask(&p.*, parentSlot, c, parent))
    }
    // Replay must expose the same paint order as the original clipped traversal.
    if empty(inner) {
      return ()
    }
    if layers.scroller(c) {
      inner = scrollerExtent(parent, p.scale)
    }
  } else if empty(inner) {
    return ()
  }
  if !p.stacking.stacks(index) {
    run shiftChildren(&mut p, index, from, to, inner)
    return ()
  }
  let steps = p.stacking.steps(index)
  let mut k: usize = 0
  while k < steps {
    let step = p.stacking.step(index, k, false)
    if step == IN_FLOW {
      run shiftChildren(&mut p, index, from, to, inner)
    } else {
      let entryMask = run hoistedMask(&p.*, index, step, inner)
      run shiftOne(&mut p, step, from, to, entryMask)
    }
    k = k + 1
  }
}

effect fn shiftChildren(
  p: &mut Painter<'_, '_>,
  index: usize,
  from: usize,
  to: usize,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut child = p.output.fragments.values.asSlice()[index].firstChild
  while child != NO_INDEX {
    if !p.stacking.hoisted(child) {
      run shiftOne(&mut p, child, from, to, mask)
    }
    child = p.output.fragments.values.asSlice()[child].nextSibling
  }
}

// Writes the paint cache of `slot`, giving it an entry on its first.
effect fn putCache(p: &mut Painter<'_, '_>, slot: u32, cache: PaintCache) -> () ! OutOfMemoryError ? &mut Allocator {
  let index = p.nodes.asSlice()[u32.toUsize(slot)].paintCache
  let at = run p.caches.put(index, cache)
  if at != index {
    let nodes = p.nodes.asMutSlice()
    nodes[u32.toUsize(slot)].paintCache = at
  }
}

effect fn shiftOne(
  p: &mut Painter<'_, '_>,
  child: usize,
  from: usize,
  to: usize,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let output = p.output
  let f = &output.fragments.values.asSlice()[child]
  run noteOrder(&mut p, child, f)
  let slot = slotIn(p.slotOfCss, f.source)
  if slot != NONE && f.kind == FragmentKind.Box {
    let cacheIndex = p.nodes.asSlice()[u32.toUsize(slot)].paintCache
    if cacheIndex != NONE {
      let cache = p.caches.at(cacheIndex)
      if cache.frame == p.previousFrame && cache.start >= from {
        cache.start = cache.start - from + to
        cache.end = cache.end - from + to
        cache.frame = p.frame
      }
    }
  }
  let childMask = if layers.flatOf(p.output, p.slotOfCss, &p.nodes.*, child).isSome() {
    ContentMask.new(everywhere())
  } else {
    mask
  }
  run shiftCaches(&mut p, child, from, to, childMask)
}

/// The background and border of a rich input's run (a marked span or an atom), which has no
/// slot of its own.
effect fn decorateRun(p: &mut Painter<'_, '_>, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let owner = styleSlot(&p.slotOfCss.*, &p.css.*, &p.nodes.*, f.source)
  if owner == NONE || p.nodes.asSlice()[u32.toUsize(owner)].kind != NodeKind.Input {
    return ()
  }
  if let Option.Some { value } = placeholder.of(&p.nodes.asSlice()[u32.toUsize(owner)]) {
    if value.css == f.source {
      let c = value.computed
      if c.text.visible && c.decorated() {
        run decorate(&mut p, NONE, &c, f, f.decorationEdges, mask)
      }
      return ()
    }
  }
  let e = p.nodes.asSlice()[u32.toUsize(owner)].edit()
  let r = rich.runOf(&e.runs, f.source)
  if r == NO_INDEX || e.runs.get(r).css != f.source {
    return ()
  }
  let c = e.runs.get(r).computed
  if c.text.visible && c.decorated() {
    run decorate(&mut p, NONE, &c, f, f.decorationEdges, mask)
  }
}

effect fn paintBox(p: &mut Painter<'_, '_>, index: usize, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let slot = slotIn(p.slotOfCss, f.source)
  if slot == NONE {
    let owner = styleSlot(&p.slotOfCss.*, &p.css.*, &p.nodes.*, f.source)
    let mut partOpacity: f32 = 1.0
    if owner != NONE {
      if let Option.Some { value } = placeholder.of(&p.nodes.asSlice()[u32.toUsize(owner)]) {
        if value.css == f.source {
          partOpacity = value.computed.paint.opacity
        }
      }
    }
    if partOpacity < 1.0 {
      drop run p.scene.pushEffectLayer(
        mask.bounds,
        mask,
        Isolation { opacity: partOpacity, blend: 0 },
        LayerEffects.none(),
      )
    }
    if !f.nonpainting {
      run decorateRun(&mut p, f, mask)
    }
    run paintStack(&mut p, index, mask)
    if partOpacity < 1.0 {
      run p.scene.popLayer()
    }
    return ()
  }
  let holdsScroller = index < p.scrollers.length() && p.scrollers.get(index)
  let cacheable = p.only == NONE && f.first && f.last && !f.repeated
    && (!holdsScroller || p.scrollsStill)
  let hash = if index < p.hashes.length() {
    p.hashes.get(index)
  } else {
    0
  }
  if cacheable && p.replayable {
    let cache = p.caches.get(p.nodes.asSlice()[u32.toUsize(slot)].paintCache)
    let culledAlike = sameRect(cache.cull, p.cull)
      || (inkInside(&p.*, index, cache.cull) && inkInside(&p.*, index, p.cull))
    if cache.frame == p.previousFrame && cache.hash == hash && sameRect(cache.mask, mask.bounds)
      && cache.scale == p.scale
      && culledAlike {
      let start = p.scene.operationCount()
      run p.scene.replay(p.previous, cache.start, cache.end)
      let end = p.scene.operationCount()
      run noteOrder(&mut p, index, f)
      run shiftCaches(&mut p, index, cache.start, start, mask)
      let replayed = PaintCache {
        hash: hash,
        start: start,
        end: end,
        frame: p.frame,
        mask: mask.bounds,
        scale: p.scale,
        cull: p.cull,
      }
      run putCache(&mut p, slot, replayed)
      p.stats.replayedSubtrees = p.stats.replayedSubtrees + 1
      p.stats.replayedOperations = p.stats.replayedOperations + (end - start)
      return ()
    }
  }
  run noteOrder(&mut p, index, f)
  let start = p.scene.operationCount()
  let pin = StylePin.of(&p.nodes.asSlice()[u32.toUsize(slot)])
  let c = pin.get()
  let kind = p.nodes.asSlice()[u32.toUsize(slot)].kind
  if c.paint.opacity > 0.0 {
    let opened = run paint_effects.pushEffects(&mut p, index, slot, c, f, mask.bounds, mask)
    if c.text.visible && !f.nonpainting {
      let rootPaints = p.only == NONE && p.stacking.rootElement(index)
      if (c.decorated() || hasBackgrounds(&p.*, slot)) && !rootPaints && !emptyHidden(c, f) {
        run decorate(&mut p, slot, c, f, f.decorationEdges, mask)
        if c.effects.declared && textClipped(&p.*, slot) {
          run paintTextClip(&mut p, index, slot, c, f, mask)
        }
      }
      if c.columnRule.drawn() {
        run paintColumnRules(&mut p, index, c, mask)
      }
      if kind == NodeKind.Image || kind == NodeKind.Icon || kind == NodeKind.Canvas {
        run paintContent(&mut p, slot, f, mask)
        if p.selected.length() != 0 && text_selection.find(p.selected, slot) != NO_INDEX {
          // A selected image is tinted with the selection color, as Chromium does.
          let mut tint = selection.background(&p.nodes.asSlice()[u32.toUsize(slot)])
          tint.a = tint.a * 0.5
          drop run p.scene.quad(Quad.fill(device(borderBox(f), p.scale), mask, Background.solid(tint)))
        }
      } else if !c.appearanceNone {
        let ctrlNode = &p.nodes.asSlice()[u32.toUsize(slot)]
        let ctrlTag = nodeTagBytes(ctrlNode)
        if ctrlNode.accessRole == Role.Slider && ctrlNode.hasValueRange() {
          run paintRange(&mut p, slot, c, f, mask)
        } else if ctrlNode.accessRole == Role.Checkbox && bytesEq(ctrlTag, b"input") {
          run paintCheckbox(&mut p, slot, c, f, mask)
        } else if ctrlNode.accessRole == Role.Radio && bytesEq(ctrlTag, b"input") {
          run paintRadio(&mut p, slot, c, f, mask)
        } else if bytesEq(ctrlTag, b"progress") {
          run paintProgress(&mut p, slot, c, f, mask)
        } else if bytesEq(ctrlTag, b"meter") {
          run paintMeter(&mut p, slot, f, mask)
        } else if bytesEq(ctrlTag, b"input") && match nodeNamedAttr(ctrlNode, "type") { Option.Some { value } => bytesEq(value, b"color") _ => false } {
          run paintColorSwatch(&mut p, slot, f, mask)
        } else if bytesEq(ctrlTag, b"select") {
          run paintSelectChrome(&mut p, slot, c, f, mask)
        }
      }
    }
    let mut inner = mask
    if c.clips() {
      inner = mask.intersect(clipMask(&p.*, slot, c, f))
    }
    let input = kind == NodeKind.Input && c.text.visible
    let scrolled = layers.scroller(c)
    let open = inner.bounds.xMax > inner.bounds.xMin && inner.bounds.yMax > inner.bounds.yMin
    let saved = p.cull
    if scrolled && open {
      inner = run openScroller(&mut p, slot, c, f, inner)
      if c.text.visible && !f.nonpainting { run paintLocalBackgrounds(&mut p, slot, c, f, inner) }
    }
    if !scrolled || open {
      if input {
        run edit.paintSelection(&mut p, slot, index, inner)
      }
      run paintStack(&mut p, index, inner)
      if input {
        run edit.paintCaret(&mut p, slot, index, inner)
      }
      if slot == p.caretSlot && kind != NodeKind.Text {
        // A caret in an element with no text to stand on (an empty paragraph): at its start.
        let content = contentBox(f)
        let size = c.text.size
        run paintCaretAt(&mut p, slot, Rect<f32>.new(content.xMin, content.yMin, content.xMin, content.yMin + size * 1.2), inner)
      }
    }
    if scrolled && open {
      p.cull = saved
      run p.scene.popScrollGroup()
    }
    if c.text.visible && !f.nonpainting && c.layout.borderCollapse == BorderCollapse.Collapse
      && c.layout.display.insideIs(DisplayInside.Table) {
      run table_borders.paint(&mut p.scene, &p.output.*, &p.slotOfCss.*, &p.nodes.*, index, slot, p.scale, mask)
    }
    if c.clips() && c.text.visible {
      run paintThumbs(&mut p, slot, c, f, mask)
    }
    if c.text.visible && !f.nonpainting {
      if c.outline.drawn() {
        run paintOutline(&mut p, slot, c, borderBox(f), mask)
      }
    }
    run paint_effects.popEffects(&mut p, opened)
  }
  let end = p.scene.operationCount()
  if cacheable {
    let painted = PaintCache {
      hash: hash,
      start: start,
      end: end,
      frame: p.frame,
      mask: mask.bounds,
      scale: p.scale,
      cull: p.cull,
    }
    run putCache(&mut p, slot, painted)
    p.stats.repaintedSubtrees = p.stats.repaintedSubtrees + 1
  }
}

/// Draws the overlay scrollbar thumbs of a scroll container over its content.
effect fn paintThumbs(
  p: &mut Painter<'_, '_>,
  slot: u32,
  c: &Computed,
  f: &Fragment,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let range = rangeOf(c, f)
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let generated = node.isGenerated()
  let vertical = geometryOf(
    node,
    f,
    if generated {
      node.scrollY()
    } else {
      range.minY
    },
    true,
  )
  let horizontal = geometryOf(
    node,
    f,
    if generated {
      node.scrollX()
    } else {
      range.minX
    },
    false,
  )
  let id = node.id
  let parts = match scrollbar_parts.of(node) {
    Option.Some { value } => Option<Scrollbars>.some(value.*)
    _ => Option<Scrollbars>.None
  }
  let mut thumbStyle = Option<Part>.None
  let thumbColor = c.scroll.colors.thumb()
  let trackColor = c.scroll.colors.track()
  if !c.scroll.colors.auto() && trackColor.a > 0.0 {
    if vertical.thumb.visible {
      run paintTrack(&mut p, vertical.track, trackColor, mask)
    }
    if horizontal.thumb.visible {
      run paintTrack(&mut p, horizontal.track, trackColor, mask)
    }
  }
  if let Option.Some { value } = parts {
    thumbStyle = Option<Part>.some(value.thumb)
    if vertical.thumb.visible {
      run paintScrollbarPart(&mut p, vertical.track, value.bar, mask)
      run paintScrollbarPart(&mut p, vertical.track, value.track, mask)
    }
    if horizontal.thumb.visible {
      run paintScrollbarPart(&mut p, horizontal.track, value.bar, mask)
      run paintScrollbarPart(&mut p, horizontal.track, value.track, mask)
    }
  }
  if generated {
    run paintThumb(&mut p, vertical.thumb, thumbStyle, thumbColor, mask)
    run paintThumb(&mut p, horizontal.thumb, thumbStyle, thumbColor, mask)
    return ()
  }
  let port = device(paddingBox(f), p.scale)
  run paintThumbIn(&mut p, id, vertical.thumb, thumbStyle, thumbColor, range.minY, port, true, mask)
  run paintThumbIn(
    &mut p,
    id,
    horizontal.thumb,
    thumbStyle,
    thumbColor,
    range.minX,
    port,
    false,
    mask,
  )
}

/// The `scrollbar-color` track under a thumb, the full length of its scrollport edge.
effect fn paintTrack(
  p: &mut Painter<'_, '_>,
  rect: Rect<f32>,
  color: Rgba<f32>,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut quad = Quad.fill(device(rect, p.scale), mask, Background.solid(color))
  quad.cornerRadii = Radii.uniform(3.0 * p.scale)
  drop run p.scene.quad(quad)
}

fn findScrollPosition(list: &[ScrollPosition], id: u32) -> Option<ScrollPosition> {
  let mut i: usize = 0
  while i < list.length {
    if list[i].node == id {
      return Option<ScrollPosition>.some(list[i])
    }
    i = i + 1
  }
  return Option<ScrollPosition>.None
}

/// Whether `paintBox` will replay fragment `index` from `previous` under `mask` and `p.cull`.
fn canReplayBox(p: &Painter<'_, '_>, index: usize, slot: u32, f: &Fragment, mask: ContentMask) -> bool {
  let holdsScroller = index < p.scrollers.length() && p.scrollers.get(index)
  let cacheable = p.only == NONE && f.first && f.last && !f.repeated
    && (!holdsScroller || p.scrollsStill)
  if !cacheable || !p.replayable {
    return false
  }
  let hash = if index < p.hashes.length() { p.hashes.get(index) } else { 0 }
  let cache = p.caches.get(p.nodes.asSlice()[u32.toUsize(slot)].paintCache)
  let culledAlike = sameRect(cache.cull, p.cull)
    || (inkInside(p, index, cache.cull) && inkInside(p, index, p.cull))
  return cache.frame == p.previousFrame && cache.hash == hash && sameRect(cache.mask, mask.bounds)
    && cache.scale == p.scale && culledAlike
}

/// The content extent mask of scroll container fragment `f` in device pixels, matching
/// [`openScroller`].
fn scrollerExtent(f: &Fragment, scale: f32) -> ContentMask {
  let box = borderBox(f)
  let o = f.scrollableOverflow
  let extent = Rect<f32>.new(
    f32.min(box.xMin, box.xMin + o.x) - 1.0,
    f32.min(box.yMin, box.yMin + o.y) - 1.0,
    f32.max(box.xMax, box.xMin + o.x + o.width) + 1.0,
    f32.max(box.yMax, box.yMin + o.y + o.height) + 1.0,
  )
  return ContentMask.new(device(extent, scale))
}

/// Opens the scroll group of scroll container `slot` at fragment `at` (for hoisted descendants
/// or subtree snapshots), without copying `Computed` or `Fragment`. When `slot` itself is being
/// replayed from an earlier paint's cull offset, matches that offset so `scene.scrolls()` and
/// `p.cull` stay consistent with the replayed in-flow content.
effect fn openScrollerAt(
  p: &mut Painter<'_, '_>,
  slot: u32,
  at: usize,
  outerMask: ContentMask,
  inner: ContentMask,
) -> ContentMask
  ! OutOfMemoryError
  ? &mut Allocator {
  let output = p.output
  let f = &output.fragments.values.asSlice()[at]
  let pin = StylePin.of(&p.nodes.asSlice()[u32.toUsize(slot)])
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let s = p.scale
  let mut sx: f32 = node.scrollX() * s
  let mut sy: f32 = node.scrollY() * s
  if !node.isGenerated() && p.only == NONE && p.scrollsStill && p.replayable {
    let id = node.id
    if let Option<ScrollPosition>.Some { value } = findScrollPosition(p.scene.scrolls(), id) {
      sx = value.x
      sy = value.y
    } else if canReplayBox(&p.*, at, slot, f, outerMask) {
      if let Option<ScrollPosition>.Some { value } = findScrollPosition(p.paintedScrolls, id) {
        sx = value.x
        sy = value.y
      }
    }
  }
  return run openScrollerAtOffset(&mut p, slot, pin.get(), f, inner, sx, sy)
}

/// Opens the scroll group of the content of scroll container `slot` (fragment `f`), cut to
/// `inner`, records its scroll, and narrows the cull to its scrollport plus the lead. Returns the
/// content mask inside: the content's extent, which does not move as it scrolls.
effect fn openScroller(
  p: &mut Painter<'_, '_>,
  slot: u32,
  c: &Computed,
  f: &Fragment,
  inner: ContentMask,
) -> ContentMask
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = p.scale
  let sx: f32 = p.nodes.asSlice()[u32.toUsize(slot)].scrollX() * s
  let sy: f32 = p.nodes.asSlice()[u32.toUsize(slot)].scrollY() * s
  return run openScrollerAtOffset(&mut p, slot, c, f, inner, sx, sy)
}

effect fn openScrollerAtOffset(
  p: &mut Painter<'_, '_>,
  slot: u32,
  c: &Computed,
  f: &Fragment,
  inner: ContentMask,
  sx: f32,
  sy: f32,
) -> ContentMask
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = p.scale
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let id = node.id
  let range = rangeOf(c, f)
  if node.isGenerated() {
    // Private boxes have no compositor-facing client id. Their offsets are baked into
    // paint and its cache key, preserving the origin's independent scroll record.
    let mut x = ScrollAxis.fixed()
    let mut y = ScrollAxis.fixed()
    x.base = -sx
    y.base = -sy
    drop run p.scene.pushRoundedScrollGroup(ScrollLink { node: NONE, x: x, y: y }, inner, inner.bounds)
  } else {
  run p.scene.setScroll(
    ScrollPosition {
      node: id,
      x: sx,
      y: sy,
      minX: range.minX * s,
      maxX: range.maxX * s,
      minY: range.minY * s,
      maxY: range.maxY * s,
    },
  )
  drop run p.scene.pushRoundedScrollGroup(
    ScrollLink { node: id, x: ScrollAxis.content(), y: ScrollAxis.content() },
    inner,
    inner.bounds,
  )
  }
  let seen = ContentMask.new(p.cull).intersect(inner).bounds
  let lead: f32 = p.lead
  let leadX: f32 = if scrolls(usedOverflow(c, true)) {
    lead
  } else {
    0.0
  }
  let leadY: f32 = if scrolls(usedOverflow(c, false)) {
    lead
  } else {
    0.0
  }
  p.cull = Rect<f32>.new(
    seen.xMin + sx - leadX,
    seen.yMin + sy - leadY,
    seen.xMax + sx + leadX,
    seen.yMax + sy + leadY,
  )
  return scrollerExtent(f, s)
}

/// Paints `thumb` (laid out at scroll `start`, the start of its range) in a group that follows
/// the scroll of node `id` along the thumb's axis.
effect fn paintThumbIn(
  p: &mut Painter<'_, '_>,
  id: u32,
  thumb: Thumb,
  style: Option<Part>,
  color: Rgba<f32>,
  start: f32,
  port: Rect<f32>,
  vertical: bool,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !thumb.visible {
    return ()
  }
  let s = p.scale
  let mut axis = ScrollAxis.fixed()
  if thumb.ratio > 0.0 {
    let rate = 1.0 / thumb.ratio
    let travel = if vertical {
      port.height() / s
    } else {
      port.width() / s
    }
    axis = ScrollAxis { factor: rate, base: -start * s * rate, low: 0.0, high: travel * s }
  }
  let link = if vertical {
    ScrollLink { node: id, x: ScrollAxis.fixed(), y: axis }
  } else {
    ScrollLink { node: id, x: axis, y: ScrollAxis.fixed() }
  }
  drop run p.scene.pushScrollGroup(link, mask.bounds, port)
  run paintThumb(&mut p, thumb, style, color, mask)
  run p.scene.popScrollGroup()
}

effect fn paintThumb(
  p: &mut Painter<'_, '_>,
  thumb: Thumb,
  style: Option<Part>,
  color: Rgba<f32>,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !thumb.visible {
    return ()
  }
  if let Option.Some { value } = style {
    run paintScrollbarPart(&mut p, thumb.rect, value, mask)
    return ()
  }
  let mut quad = Quad.fill(device(thumb.rect, p.scale), mask, Background.solid(color))
  quad.cornerRadii = Radii.uniform(3.0 * p.scale)
  drop run p.scene.quad(quad)
}

/// Scrollbar parts use the same solid/gradient fill, border, and corner primitives as boxes.
effect fn paintScrollbarPart(
  p: &mut Painter<'_, '_>,
  rect: Rect<f32>,
  part: Part,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if part.hidden {
    return ()
  }
  let paint = part.paint
  let background = backgroundOf(paint.background)
  let bordered = paint.borderStyle != StyleBorder.None && paint.borderColor.a > 0.0
  if background.isTransparent() && !bordered {
    return ()
  }
  let scale = p.scale
  let mut quad = Quad.fill(device(rect, scale), mask, background)
  quad.cornerRadii = Radii.circular(paint.radii).scaled(scale)
  if bordered {
    quad.borderWidths = Insets<f32> {
      top: borderWidth(paint.border.top * scale),
      right: borderWidth(paint.border.right * scale),
      bottom: borderWidth(paint.border.bottom * scale),
      left: borderWidth(paint.border.left * scale),
    }
    quad.borderColor = paint.borderColor
    quad.borderStyle = if paint.borderStyle == StyleBorder.Dashed {
      BorderStyle.Dashed
    } else {
      BorderStyle.Solid
    }
  }
  drop run p.scene.quad(quad)
}

/// Paints every root fragment (the viewport and anything outside it) into `p.scene`.
pub effect fn paintRoots(p: &mut Painter<'_, '_>, window: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  // The stacking index lists the roots: a long page has few among very many fragments.
  let count = p.stacking.roots.length()
  let mut at: usize = 0
  while at < count {
    let index = p.stacking.roots.get(at)
    // A fixed box's root paints from the lists of the root context it stacks in.
    if p.only != NONE || !p.stacking.hoisted(index) {
      run paintFragment(&mut p, index, window)
    }
    at = at + 1
  }
}

fn floatHash(h: u64, value: f32) -> u64 {
  return Hash.combine(h, u32.toU64(f32.toBits(value)))
}

fn kindIndex(kind: FragmentKind) -> u64 {
  return match kind {
    FragmentKind.Box => 1
    FragmentKind.Inline => 2
    FragmentKind.Text => 3
    FragmentKind.Line => 4
  }
}

/// The hash of everything fragment `index` paints from, not counting its descendants.
fn ownHash(
  seed: &HashSeed,
  output: &LayoutTree,
  slots: &List<u32>,
  slot: u32,
  nodes: &List<Node>,
  index: usize,
) -> u64 {
  let f = output.fragments.values.asSlice()[index]
  let mut h = Hash.mix(seed, kindIndex(f.kind))
  h = Hash.combine(h, usize.toU64(f.source))
  if f.kind == FragmentKind.Text {
    // Every run: where it is and what it draws. The font and the baseline are the fragment's.
    h = floatHash(h, f.firstBaselines.alphabetic)
    h = Hash.combine(h, u32.toU64(f.fontKey))
    let mut runs = output.fragments.textRuns(index)
    while runs.next() {
      let t = &runs.current
      h = floatHash(h, t.location.x)
      h = floatHash(h, t.location.y)
      h = floatHash(h, t.size.width)
      h = floatHash(h, t.size.height)
      h = Hash.combine(h, usize.toU64(t.shapeKey))
      h = Hash.combine(h, usize.toU64(t.sourceStart))
      h = Hash.combine(h, usize.toU64(t.sourceEnd))
      h = Hash.combine(h, u8.toU64(t.bidiLevel))
    }
    if slot != NONE {
      let node = &nodes.asSlice()[u32.toUsize(slot)]
      h = selection.hash(node, Hash.combine(h, node.paintHash))
      if node.isGenerated() { h = floatHash(h, node.scrollX()) h = floatHash(h, node.scrollY()) }
    }
    // The text node's own content: what the document selection covers of it, say.
    let own = slotIn(slots, f.source)
    if own != NONE {
      h = Hash.combine(h, nodes.asSlice()[u32.toUsize(own)].content)
    }
    return h
  }
  h = floatHash(h, f.worldLocation.x)
  h = floatHash(h, f.worldLocation.y)
  h = floatHash(h, f.size.width)
  h = floatHash(h, f.size.height)
  h = floatHash(h, f.paddingRect.x)
  h = floatHash(h, f.paddingRect.y)
  h = floatHash(h, f.paddingRect.width)
  h = floatHash(h, f.paddingRect.height)
  h = floatHash(h, f.contentRect.x)
  h = floatHash(h, f.contentRect.y)
  h = floatHash(h, f.contentRect.width)
  h = floatHash(h, f.contentRect.height)
  h = floatHash(h, f.scrollableOverflow.x)
  h = floatHash(h, f.scrollableOverflow.y)
  h = floatHash(h, f.scrollableOverflow.width)
  h = floatHash(h, f.scrollableOverflow.height)
  h = floatHash(h, f.firstBaselines.alphabetic)
  h = Hash.combine(h, u8.toU64(f.decorationEdges))
  let mut flags: u64 = 0
  if f.first {
    flags = flags + 1
  }
  if f.last {
    flags = flags + 2
  }
  if f.nonpainting {
    flags = flags + 4
  }
  h = Hash.combine(h, flags)
  if slot != NONE {
    let node = &nodes.asSlice()[u32.toUsize(slot)]
    h = selection.hash(node, Hash.combine(h, node.paintHash))
    if node.isGenerated() {
      h = floatHash(h, node.scrollX())
      h = floatHash(h, node.scrollY())
    }
    if f.kind == FragmentKind.Box {
      h = transform.perspectiveHash(&node.computed().transform, h)
      if node.computed().transform.preserve3d { h = Hash.combine(h, 3) }
      h = Hash.combine(h, node.content)
      h = Hash.combine(h, u32.toU64(node.resource))
      if node.hasValueRange() {
        h = floatHash(floatHash(floatHash(Hash.combine(h, if node.disabled { 2 } else { 1 }), node.valueMin()), node.valueMax()), node.valueNow())
      }
      if node.kind == NodeKind.Canvas { h = Hash.combine(h, u32.toU64(node.raster().stamp)) }
    }
  }
  return h
}

/// Hashes every fragment's paint inputs together with its descendants', children before
/// parents (css-layout stores parents before their children).
pub effect fn hashFragments(
  seed: &HashSeed,
  output: &LayoutTree,
  slots: &List<u32>,
  css: &LayoutTable,
  nodes: &List<Node>,
  out: &mut List<u64>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = output.fragments.values.length()
  out.clear()
  run out.appendRepeated(0, count)
  let mut index = count
  while index > 0 {
    index = index - 1
    let owner = styleSlot(slots, css, nodes, output.fragments.values.asSlice()[index].source)
    foldHashAt(seed, output, slots, nodes, &mut out, index, owner)
  }
}

/// What the parent of fragment `index` folds into its hash for it: the fragment's own
/// `combined` hash, placed by its transform.
fn placedHash(output: &LayoutTree, slots: &List<u32>, nodes: &List<Node>, index: usize, combined: u64) -> u64 {
  let f = &output.fragments.values.asSlice()[index]
  if f.kind == FragmentKind.Box {
    let slot = slotIn(slots, f.source)
    if slot != NONE && nodes.asSlice()[u32.toUsize(slot)].sliding {
      // A move paints through a group of its own, wherever its translation is now.
      return Hash.combine(combined, 1397508421)
    }
    if slot != NONE && nodes.asSlice()[u32.toUsize(slot)].computed().transform.any() {
      let mut placed = transform.placementHash(&nodes.asSlice()[u32.toUsize(slot)].computed().transform, combined)
      if let Option<transform.Placement>.Some { value: at } = nodes.asSlice()[u32.toUsize(slot)].offsetPlaced() {
        placed = Hash.combine(Hash.combine(Hash.combine(placed, u32.toU64(f32.toBits(at.x))), u32.toU64(f32.toBits(at.y))), u32.toU64(f32.toBits(at.angle)))
      }
      return placed
    }
  }
  return combined
}

fn foldHashAt(
  seed: &HashSeed, output: &LayoutTree, slots: &List<u32>, nodes: &List<Node>,
  out: &mut List<u64>, index: usize, owner: u32,
) -> () {
  let own = ownHash(seed, output, slots, owner, nodes, index)
  let below = out.get(index)
  let combined = Hash.combine(own, below)
  out.set(index, combined)
  let placed = placedHash(output, slots, nodes, index, combined)
  let parent = output.fragments.values.asSlice()[index].parent
  if parent != NO_INDEX {
    let previous = out.get(parent)
    out.set(parent, Hash.combine(previous, placed))
  }
}

/// Hashes and bounds every fragment (see [`hashFragments`] and [`inkFragments`]). Records
/// fragile fragments in `fragiles`; returns true when there were more than `MAX_TRACKED_FRAGILE`
/// (see `Repair.fragile`).
pub effect fn cacheFragments(
  seed: &HashSeed, output: &LayoutTree, slots: &List<u32>, css: &LayoutTable, nodes: &List<Node>,
  width: f32, height: f32, hashes: &mut List<u64>, ink: &mut List<Rect<f32>>, scrollers: &mut List<bool>,
  fragiles: &mut List<FragileEntry>,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = output.fragments.values.length()
  hashes.clear()
  ink.clear()
  scrollers.clear()
  fragiles.clear()
  run hashes.appendRepeated(0, count)
  run ink.appendRepeated(Rect<f32>.new(UNBOUNDED_INK, UNBOUNDED_INK, -UNBOUNDED_INK, -UNBOUNDED_INK), count)
  run scrollers.appendRepeated(false, count)
  let mut overflow = false
  let mut index = count
  while index > 0 {
    index = index - 1
    let owner = styleSlot(slots, css, nodes, output.fragments.values.asSlice()[index].source)
    foldHashAt(seed, output, slots, nodes, &mut hashes, index, owner)
    let kind = foldInkAt(output, slots, css, nodes, width, height, &mut ink, &mut scrollers, index, owner)
    if kind != FRAGILE_NONE {
      if fragiles.length() < MAX_TRACKED_FRAGILE {
        run fragiles.append(FragileEntry { fragment: index, kind: kind })
      } else {
        overflow = true
      }
    }
  }
  return overflow
}

/// [`cacheFragments`] for the fragments of `dirty` alone (ascending, each with every fragment
/// above it): each one's hash, ink and scroller flag from its own inputs and its children's
/// entries, which stand. Appends any fragile fragments seen to `found`; `ordered` is cleared
/// when some fragment's children are not in arena order, which the fold of a full pass assumes.
pub effect fn repairFragments(
  seed: &HashSeed, output: &LayoutTree, slots: &List<u32>, css: &LayoutTable, nodes: &List<Node>,
  width: f32, height: f32, hashes: &mut List<u64>, ink: &mut List<Rect<f32>>, scrollers: &mut List<bool>,
  dirty: &[usize], found: &mut List<FragileEntry>, ordered: &mut bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let values = output.fragments.values.asSlice()
  found.clear()
  let mut at = dirty.length
  while at > 0 {
    at = at - 1
    let index = dirty[at]
    // A full pass folds children into their parent last child first.
    let mut hash: u64 = 0
    let mut bounds = Rect<f32>.new(UNBOUNDED_INK, UNBOUNDED_INK, -UNBOUNDED_INK, -UNBOUNDED_INK)
    let mut scrolls = false
    let mut above = usize.MAX
    let mut child = values[index].lastChild
    while child != NO_INDEX {
      if child >= above || child <= index { ordered.* = false }
      above = child
      hash = Hash.combine(hash, placedHash(output, slots, nodes, child, hashes.get(child)))
      bounds = unite(bounds, ink.get(child))
      if scrollers.get(child) { scrolls = true }
      child = values[child].previousSibling
    }
    let owner = styleSlot(slots, css, nodes, values[index].source)
    hashes.set(index, Hash.combine(ownHash(seed, output, slots, owner, nodes, index), hash))
    ink.set(index, bounds)
    scrollers.set(index, scrolls)
    let kind = settleInkAt(output, slots, css, nodes, width, height, &mut ink, &mut scrollers, index, owner)
    if kind != FRAGILE_NONE {
      run found.append(FragileEntry { fragment: index, kind: kind })
    }
  }
}

/// The sampling rectangle; clipping remains on the content box, including its radii.
fn fittedImage(
  box: Rect<f32>,
  width: f32,
  height: f32,
  fit: ObjectFit,
  x: Dimension,
  y: Dimension,
  scale: f32,
) -> Rect<f32> {
  if fit == ObjectFit.Fill || width <= 0.0 || height <= 0.0 {
    return box
  }
  let contain = f32.min(box.width() / width, box.height() / height)
  let ratio: f32 = match fit {
    ObjectFit.Fill => 1.0
    ObjectFit.Contain => contain
    ObjectFit.Cover => f32.max(box.width() / width, box.height() / height)
    ObjectFit.None => 1.0
    ObjectFit.ScaleDown => f32.min(1.0, contain)
  }
  let w = width * ratio
  let h = height * ratio
  let left = box.xMin + objectOffset(x, box.width() - w, scale)
  let top = box.yMin + objectOffset(y, box.height() - h, scale)
  return Rect<f32>.new(left, top, left + w, top + h)
}

fn objectOffset(value: Dimension, space: f32, scale: f32) -> f32 {
  return match value.kind {
    DimensionKind.Length => value.value * scale
    DimensionKind.Percent => space * value.percent
    DimensionKind.Calc => value.value * scale + space * value.percent
    _ => space * 0.5
  }
}
