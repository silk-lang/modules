  run a.load(Width.W64, Reg.Rax, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Two, -129))
  run Testing.expect(emitted(&a, &mut at, b"\x4a\x8b\x84\x4d\x7f\xff\xff\xff"), "mov rax, qword ptr [rbp + r9*2 - 129]")
  run a.load(Width.W64, Reg.Rdi, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Four, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4a\x8b\x7c\x8d\x00"), "mov rdi, qword ptr [rbp + r9*4]")
  run a.load(Width.W64, Reg.R14, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16))
  run Testing.expect(emitted(&a, &mut at, b"\x4e\x8b\x74\xcd\x10"), "mov r14, qword ptr [rbp + r9*8 + 16]")
  run a.load(Width.W32, Reg.Rbx, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x8b\x18"), "mov ebx, dword ptr [rax]")
  run a.load(Width.W32, Reg.R10, Mem.at(Reg.Rsp, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x8b\x54\x24\x08"), "mov r10d, dword ptr [rsp + 8]")
  run a.load(Width.W32, Reg.Rcx, Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x8b\x4d\x00"), "mov ecx, dword ptr [rbp]")
  run a.load(Width.W32, Reg.R8, Mem.at(Reg.R8, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x45\x8b\x40\x08"), "mov r8d, dword ptr [r8 + 8]")
  run a.load(Width.W32, Reg.R15, Mem.at(Reg.R12, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x45\x8b\x3c\x24"), "mov r15d, dword ptr [r12]")
  run a.load(Width.W32, Reg.Rsi, Mem.at(Reg.R13, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x41\x8b\x75\x08"), "mov esi, dword ptr [r13 + 8]")
  run a.load(Width.W32, Reg.R13, Mem.at(Reg.Rax, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x8b\x68\x7f"), "mov r13d, dword ptr [rax + 127]")
  run a.load(Width.W32, Reg.Rsp, Mem.at(Reg.Rax, -129))
  run Testing.expect(emitted(&a, &mut at, b"\x8b\xa0\x7f\xff\xff\xff"), "mov esp, dword ptr [rax - 129]")
  run a.load(Width.W32, Reg.R11, Mem.at(Reg.Rsp, 128))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x8b\x9c\x24\x80\x00\x00\x00"), "mov r11d, dword ptr [rsp + 128]")
  run a.load(Width.W32, Reg.Rdx, Mem.at(Reg.Rbp, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x8b\x55\x7f"), "mov edx, dword ptr [rbp + 127]")
  run a.load(Width.W32, Reg.R9, Mem.at(Reg.R12, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x45\x8b\x4c\x24\x7f"), "mov r9d, dword ptr [r12 + 127]")
  run a.load(Width.W32, Reg.Rax, Mem.at(Reg.R12, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\x41\x8b\x84\x24\x00\x00\x00\x80"), "mov eax, dword ptr [r12 - 2147483648]")
  run a.load(Width.W32, Reg.Rdi, Mem.at(Reg.R13, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\x41\x8b\xbd\x00\x00\x00\x80"), "mov edi, dword ptr [r13 - 2147483648]")
  run a.load(Width.W32, Reg.R14, Mem.indexed(Reg.Rax, Reg.Rcx, Scale.One, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x8b\x34\x08"), "mov r14d, dword ptr [rax + rcx*1]")
  run a.load(Width.W32, Reg.Rbp, Mem.indexed(Reg.Rsp, Reg.Rax, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x8b\x2c\x44"), "mov ebp, dword ptr [rsp + rax*2]")
  run a.load(Width.W32, Reg.R12, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x8b\x64\xad\x00"), "mov r12d, dword ptr [rbp + rbp*4]")
  run a.load(Width.W32, Reg.Rbx, Mem.indexed(Reg.R12, Reg.R13, Scale.Eight, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x43\x8b\x1c\xec"), "mov ebx, dword ptr [r12 + r13*8]")
  run a.load(Width.W32, Reg.R10, Mem.indexed(Reg.R15, Reg.R8, Scale.One, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x47\x8b\x14\x07"), "mov r10d, dword ptr [r15 + r8*1]")
  run a.load(Width.W32, Reg.Rcx, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x42\x8b\x0c\x7f"), "mov ecx, dword ptr [rdi + r15*2]")
  run a.load(Width.W32, Reg.R8, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16))
  run Testing.expect(emitted(&a, &mut at, b"\x46\x8b\x44\xcd\x10"), "mov r8d, dword ptr [rbp + r9*8 + 16]")
}

test effect fn loadsMatchLlvm() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut a = Assembler.make()
  run loadsCases(&mut a) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn storesCases(a: &mut Assembler) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut at: usize = 0
  run a.store(Width.W64, Mem.at(Reg.Rax, 0), Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x89\x08"), "mov qword ptr [rax], rcx")
  run a.storeImm(Width.W64, Mem.at(Reg.Rax, 0), 0)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc7\x00\x00\x00\x00\x00"), "mov qword ptr [rax], 0")
  run a.store(Width.W64, Mem.at(Reg.Rsp, 8), Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x89\x74\x24\x08"), "mov qword ptr [rsp + 8], rsi")
  run a.storeImm(Width.W64, Mem.at(Reg.Rsp, 8), 1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc7\x44\x24\x08\x01\x00\x00\x00"), "mov qword ptr [rsp + 8], 1")
  run a.store(Width.W64, Mem.at(Reg.Rbp, 0), Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x89\x5d\x00"), "mov qword ptr [rbp], r11")
  run a.storeImm(Width.W64, Mem.at(Reg.Rbp, 0), -1)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc7\x45\x00\xff\xff\xff\xff"), "mov qword ptr [rbp], -1")
  run a.store(Width.W64, Mem.at(Reg.R8, 8), Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x89\x40\x08"), "mov qword ptr [r8 + 8], rax")
  run a.storeImm(Width.W64, Mem.at(Reg.R8, 8), 127)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc7\x40\x08\x7f\x00\x00\x00"), "mov qword ptr [r8 + 8], 127")
  run a.store(Width.W64, Mem.at(Reg.R12, 0), Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x89\x2c\x24"), "mov qword ptr [r12], rbp")
  run a.storeImm(Width.W64, Mem.at(Reg.R12, 0), 128)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc7\x04\x24\x80\x00\x00\x00"), "mov qword ptr [r12], 128")
  run a.store(Width.W64, Mem.at(Reg.R13, 8), Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x89\x55\x08"), "mov qword ptr [r13 + 8], r10")
  run a.storeImm(Width.W64, Mem.at(Reg.R13, 8), -128)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc7\x45\x08\x80\xff\xff\xff"), "mov qword ptr [r13 + 8], -128")
  run a.store(Width.W64, Mem.at(Reg.Rax, 127), Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x89\x78\x7f"), "mov qword ptr [rax + 127], r15")
  run a.storeImm(Width.W64, Mem.at(Reg.Rax, 127), -129)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc7\x40\x7f\x7f\xff\xff\xff"), "mov qword ptr [rax + 127], -129")
  run a.store(Width.W64, Mem.at(Reg.Rax, -129), Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x89\xa0\x7f\xff\xff\xff"), "mov qword ptr [rax - 129], rsp")
  run a.storeImm(Width.W64, Mem.at(Reg.Rax, -129), 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc7\x80\x7f\xff\xff\xff\x78\x56\x34\x12"), "mov qword ptr [rax - 129], 305419896")
  run a.store(Width.W64, Mem.at(Reg.Rsp, 128), Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x89\x8c\x24\x80\x00\x00\x00"), "mov qword ptr [rsp + 128], r9")
  run a.storeImm(Width.W64, Mem.at(Reg.Rsp, 128), 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc7\x84\x24\x80\x00\x00\x00\xff\xff\xff\x7f"), "mov qword ptr [rsp + 128], 2147483647")
  run a.store(Width.W64, Mem.at(Reg.Rbp, 127), Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x89\x75\x7f"), "mov qword ptr [rbp + 127], r14")
  run a.storeImm(Width.W64, Mem.at(Reg.Rbp, 127), -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc7\x45\x7f\x00\x00\x00\x80"), "mov qword ptr [rbp + 127], -2147483648")
  run a.store(Width.W64, Mem.at(Reg.R12, 127), Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x49\x89\x5c\x24\x7f"), "mov qword ptr [r12 + 127], rbx")
  run a.storeImm(Width.W64, Mem.at(Reg.R12, 127), 0)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc7\x44\x24\x7f\x00\x00\x00\x00"), "mov qword ptr [r12 + 127], 0")
  run a.store(Width.W64, Mem.at(Reg.R12, -2147483648), Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x89\x84\x24\x00\x00\x00\x80"), "mov qword ptr [r12 - 2147483648], r8")
  run a.storeImm(Width.W64, Mem.at(Reg.R12, -2147483648), 1)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc7\x84\x24\x00\x00\x00\x80\x01\x00\x00\x00"), "mov qword ptr [r12 - 2147483648], 1")
  run a.store(Width.W64, Mem.at(Reg.R13, -2147483648), Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x89\xad\x00\x00\x00\x80"), "mov qword ptr [r13 - 2147483648], r13")
  run a.storeImm(Width.W64, Mem.at(Reg.R13, -2147483648), -1)
  run Testing.expect(emitted(&a, &mut at, b"\x49\xc7\x85\x00\x00\x00\x80\xff\xff\xff\xff"), "mov qword ptr [r13 - 2147483648], -1")
  run a.store(Width.W64, Mem.indexed(Reg.Rax, Reg.Rcx, Scale.One, 0), Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x89\x14\x08"), "mov qword ptr [rax + rcx*1], rdx")
  run a.storeImm(Width.W64, Mem.indexed(Reg.Rax, Reg.Rcx, Scale.One, 0), 127)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc7\x04\x08\x7f\x00\x00\x00"), "mov qword ptr [rax + rcx*1], 127")
  run a.store(Width.W64, Mem.indexed(Reg.Rsp, Reg.Rax, Scale.Two, 0), Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x48\x89\x3c\x44"), "mov qword ptr [rsp + rax*2], rdi")
  run a.storeImm(Width.W64, Mem.indexed(Reg.Rsp, Reg.Rax, Scale.Two, 0), 128)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc7\x04\x44\x80\x00\x00\x00"), "mov qword ptr [rsp + rax*2], 128")
  run a.store(Width.W64, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), Reg.R12)
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x89\x64\xad\x00"), "mov qword ptr [rbp + rbp*4], r12")
  run a.storeImm(Width.W64, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), -128)
  run Testing.expect(emitted(&a, &mut at, b"\x48\xc7\x44\xad\x00\x80\xff\xff\xff"), "mov qword ptr [rbp + rbp*4], -128")
  run a.store(Width.W64, Mem.indexed(Reg.R12, Reg.R13, Scale.Eight, 0), Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x4b\x89\x0c\xec"), "mov qword ptr [r12 + r13*8], rcx")
  run a.storeImm(Width.W64, Mem.indexed(Reg.R12, Reg.R13, Scale.Eight, 0), -129)
  run Testing.expect(emitted(&a, &mut at, b"\x4b\xc7\x04\xec\x7f\xff\xff\xff"), "mov qword ptr [r12 + r13*8], -129")
  run a.store(Width.W64, Mem.indexed(Reg.R15, Reg.R8, Scale.One, 0), Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x4b\x89\x34\x07"), "mov qword ptr [r15 + r8*1], rsi")
  run a.storeImm(Width.W64, Mem.indexed(Reg.R15, Reg.R8, Scale.One, 0), 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x4b\xc7\x04\x07\x78\x56\x34\x12"), "mov qword ptr [r15 + r8*1], 305419896")
  run a.store(Width.W64, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x4e\x89\x1c\x7f"), "mov qword ptr [rdi + r15*2], r11")
  run a.storeImm(Width.W64, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\x4a\xc7\x04\x7f\xff\xff\xff\x7f"), "mov qword ptr [rdi + r15*2], 2147483647")
  run a.store(Width.W64, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16), Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x4a\x89\x44\xcd\x10"), "mov qword ptr [rbp + r9*8 + 16], rax")
  run a.storeImm(Width.W64, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16), -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x4a\xc7\x44\xcd\x10\x00\x00\x00\x80"), "mov qword ptr [rbp + r9*8 + 16], -2147483648")
  run a.store(Width.W32, Mem.at(Reg.Rax, 0), Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x89\x08"), "mov dword ptr [rax], ecx")
  run a.storeImm(Width.W32, Mem.at(Reg.Rax, 0), 0)
  run Testing.expect(emitted(&a, &mut at, b"\xc7\x00\x00\x00\x00\x00"), "mov dword ptr [rax], 0")
  run a.store(Width.W32, Mem.at(Reg.Rsp, 8), Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x89\x74\x24\x08"), "mov dword ptr [rsp + 8], esi")
  run a.storeImm(Width.W32, Mem.at(Reg.Rsp, 8), 1)
  run Testing.expect(emitted(&a, &mut at, b"\xc7\x44\x24\x08\x01\x00\x00\x00"), "mov dword ptr [rsp + 8], 1")
  run a.store(Width.W32, Mem.at(Reg.Rbp, 0), Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x89\x5d\x00"), "mov dword ptr [rbp], r11d")
  run a.storeImm(Width.W32, Mem.at(Reg.Rbp, 0), -1)
  run Testing.expect(emitted(&a, &mut at, b"\xc7\x45\x00\xff\xff\xff\xff"), "mov dword ptr [rbp], -1")
  run a.store(Width.W32, Mem.at(Reg.R8, 8), Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x89\x40\x08"), "mov dword ptr [r8 + 8], eax")
  run a.storeImm(Width.W32, Mem.at(Reg.R8, 8), 127)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xc7\x40\x08\x7f\x00\x00\x00"), "mov dword ptr [r8 + 8], 127")
  run a.store(Width.W32, Mem.at(Reg.R12, 0), Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x89\x2c\x24"), "mov dword ptr [r12], ebp")
  run a.storeImm(Width.W32, Mem.at(Reg.R12, 0), 128)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xc7\x04\x24\x80\x00\x00\x00"), "mov dword ptr [r12], 128")
  run a.store(Width.W32, Mem.at(Reg.R13, 8), Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x89\x55\x08"), "mov dword ptr [r13 + 8], r10d")
  run a.storeImm(Width.W32, Mem.at(Reg.R13, 8), -128)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xc7\x45\x08\x80\xff\xff\xff"), "mov dword ptr [r13 + 8], -128")
  run a.store(Width.W32, Mem.at(Reg.Rax, 127), Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x89\x78\x7f"), "mov dword ptr [rax + 127], r15d")
  run a.storeImm(Width.W32, Mem.at(Reg.Rax, 127), -129)
  run Testing.expect(emitted(&a, &mut at, b"\xc7\x40\x7f\x7f\xff\xff\xff"), "mov dword ptr [rax + 127], -129")
  run a.store(Width.W32, Mem.at(Reg.Rax, -129), Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x89\xa0\x7f\xff\xff\xff"), "mov dword ptr [rax - 129], esp")
  run a.storeImm(Width.W32, Mem.at(Reg.Rax, -129), 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\xc7\x80\x7f\xff\xff\xff\x78\x56\x34\x12"), "mov dword ptr [rax - 129], 305419896")
  run a.store(Width.W32, Mem.at(Reg.Rsp, 128), Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x89\x8c\x24\x80\x00\x00\x00"), "mov dword ptr [rsp + 128], r9d")
  run a.storeImm(Width.W32, Mem.at(Reg.Rsp, 128), 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\xc7\x84\x24\x80\x00\x00\x00\xff\xff\xff\x7f"), "mov dword ptr [rsp + 128], 2147483647")
  run a.store(Width.W32, Mem.at(Reg.Rbp, 127), Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x89\x75\x7f"), "mov dword ptr [rbp + 127], r14d")
  run a.storeImm(Width.W32, Mem.at(Reg.Rbp, 127), -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\xc7\x45\x7f\x00\x00\x00\x80"), "mov dword ptr [rbp + 127], -2147483648")
  run a.store(Width.W32, Mem.at(Reg.R12, 127), Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x89\x5c\x24\x7f"), "mov dword ptr [r12 + 127], ebx")
  run a.storeImm(Width.W32, Mem.at(Reg.R12, 127), 0)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xc7\x44\x24\x7f\x00\x00\x00\x00"), "mov dword ptr [r12 + 127], 0")
  run a.store(Width.W32, Mem.at(Reg.R12, -2147483648), Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x89\x84\x24\x00\x00\x00\x80"), "mov dword ptr [r12 - 2147483648], r8d")
  run a.storeImm(Width.W32, Mem.at(Reg.R12, -2147483648), 1)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xc7\x84\x24\x00\x00\x00\x80\x01\x00\x00\x00"), "mov dword ptr [r12 - 2147483648], 1")
  run a.store(Width.W32, Mem.at(Reg.R13, -2147483648), Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x45\x89\xad\x00\x00\x00\x80"), "mov dword ptr [r13 - 2147483648], r13d")
  run a.storeImm(Width.W32, Mem.at(Reg.R13, -2147483648), -1)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xc7\x85\x00\x00\x00\x80\xff\xff\xff\xff"), "mov dword ptr [r13 - 2147483648], -1")
  run a.store(Width.W32, Mem.indexed(Reg.Rax, Reg.Rcx, Scale.One, 0), Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\x89\x14\x08"), "mov dword ptr [rax + rcx*1], edx")
  run a.storeImm(Width.W32, Mem.indexed(Reg.Rax, Reg.Rcx, Scale.One, 0), 127)
  run Testing.expect(emitted(&a, &mut at, b"\xc7\x04\x08\x7f\x00\x00\x00"), "mov dword ptr [rax + rcx*1], 127")
  run a.store(Width.W32, Mem.indexed(Reg.Rsp, Reg.Rax, Scale.Two, 0), Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x89\x3c\x44"), "mov dword ptr [rsp + rax*2], edi")
  run a.storeImm(Width.W32, Mem.indexed(Reg.Rsp, Reg.Rax, Scale.Two, 0), 128)
  run Testing.expect(emitted(&a, &mut at, b"\xc7\x04\x44\x80\x00\x00\x00"), "mov dword ptr [rsp + rax*2], 128")
  run a.store(Width.W32, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), Reg.R12)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x89\x64\xad\x00"), "mov dword ptr [rbp + rbp*4], r12d")
  run a.storeImm(Width.W32, Mem.indexed(Reg.Rbp, Reg.Rbp, Scale.Four, 0), -128)
  run Testing.expect(emitted(&a, &mut at, b"\xc7\x44\xad\x00\x80\xff\xff\xff"), "mov dword ptr [rbp + rbp*4], -128")
  run a.store(Width.W32, Mem.indexed(Reg.R12, Reg.R13, Scale.Eight, 0), Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\x43\x89\x0c\xec"), "mov dword ptr [r12 + r13*8], ecx")
  run a.storeImm(Width.W32, Mem.indexed(Reg.R12, Reg.R13, Scale.Eight, 0), -129)
  run Testing.expect(emitted(&a, &mut at, b"\x43\xc7\x04\xec\x7f\xff\xff\xff"), "mov dword ptr [r12 + r13*8], -129")
  run a.store(Width.W32, Mem.indexed(Reg.R15, Reg.R8, Scale.One, 0), Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\x43\x89\x34\x07"), "mov dword ptr [r15 + r8*1], esi")
  run a.storeImm(Width.W32, Mem.indexed(Reg.R15, Reg.R8, Scale.One, 0), 305419896)
  run Testing.expect(emitted(&a, &mut at, b"\x43\xc7\x04\x07\x78\x56\x34\x12"), "mov dword ptr [r15 + r8*1], 305419896")
  run a.store(Width.W32, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x46\x89\x1c\x7f"), "mov dword ptr [rdi + r15*2], r11d")
  run a.storeImm(Width.W32, Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0), 2147483647)
  run Testing.expect(emitted(&a, &mut at, b"\x42\xc7\x04\x7f\xff\xff\xff\x7f"), "mov dword ptr [rdi + r15*2], 2147483647")
  run a.store(Width.W32, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16), Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x42\x89\x44\xcd\x10"), "mov dword ptr [rbp + r9*8 + 16], eax")
  run a.storeImm(Width.W32, Mem.indexed(Reg.Rbp, Reg.R9, Scale.Eight, 16), -2147483648)
  run Testing.expect(emitted(&a, &mut at, b"\x42\xc7\x44\xcd\x10\x00\x00\x00\x80"), "mov dword ptr [rbp + r9*8 + 16], -2147483648")
}

test effect fn storesMatchLlvm() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut a = Assembler.make()
  run storesCases(&mut a) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn narrowCases(a: &mut Assembler) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut at: usize = 0
  run a.store8(Mem.at(Reg.Rax, 0), Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x40\x88\x20"), "mov byte ptr [rax], spl")
  run a.store16(Mem.at(Reg.Rax, 0), Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x89\x20"), "mov word ptr [rax], sp")
  run a.loadZero8(Reg.Rdx, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xb6\x10"), "movzx edx, byte ptr [rax]")
  run a.loadZero16(Reg.Rdx, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xb7\x10"), "movzx edx, word ptr [rax]")
  run a.loadSigned32(Reg.Rdx, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\x10"), "movsxd rdx, dword ptr [rax]")
  run a.loadSigned8(Reg.Rdx, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xbe\x10"), "movsx edx, byte ptr [rax]")
  run a.loadSigned16(Reg.Rdx, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xbf\x10"), "movsx edx, word ptr [rax]")
  run a.store8(Mem.at(Reg.Rsp, 8), Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x88\x7c\x24\x08"), "mov byte ptr [rsp + 8], r15b")
  run a.store16(Mem.at(Reg.Rsp, 8), Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x44\x89\x7c\x24\x08"), "mov word ptr [rsp + 8], r15w")
  run a.loadZero8(Reg.Rbp, Mem.at(Reg.Rsp, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xb6\x6c\x24\x08"), "movzx ebp, byte ptr [rsp + 8]")
  run a.loadZero16(Reg.Rbp, Mem.at(Reg.Rsp, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xb7\x6c\x24\x08"), "movzx ebp, word ptr [rsp + 8]")
  run a.loadSigned32(Reg.Rbp, Mem.at(Reg.Rsp, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x63\x6c\x24\x08"), "movsxd rbp, dword ptr [rsp + 8]")
  run a.loadSigned8(Reg.Rbp, Mem.at(Reg.Rsp, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xbe\x6c\x24\x08"), "movsx ebp, byte ptr [rsp + 8]")
  run a.loadSigned16(Reg.Rbp, Mem.at(Reg.Rsp, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x0f\xbf\x6c\x24\x08"), "movsx ebp, word ptr [rsp + 8]")
  run a.store8(Mem.at(Reg.Rbp, 0), Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x44\x88\x55\x00"), "mov byte ptr [rbp], r10b")
  run a.store16(Mem.at(Reg.Rbp, 0), Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x44\x89\x55\x00"), "mov word ptr [rbp], r10w")
  run a.loadZero8(Reg.R8, Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xb6\x45\x00"), "movzx r8d, byte ptr [rbp]")
  run a.loadZero16(Reg.R8, Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xb7\x45\x00"), "movzx r8d, word ptr [rbp]")
  run a.loadSigned32(Reg.R8, Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x63\x45\x00"), "movsxd r8, dword ptr [rbp]")
  run a.loadSigned8(Reg.R8, Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xbe\x45\x00"), "movsx r8d, byte ptr [rbp]")
  run a.loadSigned16(Reg.R8, Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x44\x0f\xbf\x45\x00"), "movsx r8d, word ptr [rbp]")
  run a.store8(Mem.at(Reg.R8, 8), Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x41\x88\x68\x08"), "mov byte ptr [r8 + 8], bpl")
  run a.store16(Mem.at(Reg.R8, 8), Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x41\x89\x68\x08"), "mov word ptr [r8 + 8], bp")
  run a.loadZero8(Reg.R11, Mem.at(Reg.R8, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x45\x0f\xb6\x58\x08"), "movzx r11d, byte ptr [r8 + 8]")
  run a.loadZero16(Reg.R11, Mem.at(Reg.R8, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x45\x0f\xb7\x58\x08"), "movzx r11d, word ptr [r8 + 8]")
  run a.loadSigned32(Reg.R11, Mem.at(Reg.R8, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x63\x58\x08"), "movsxd r11, dword ptr [r8 + 8]")
  run a.loadSigned8(Reg.R11, Mem.at(Reg.R8, 8))
