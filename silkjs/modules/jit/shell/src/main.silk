//! silkjs-jit-shell: the qjs command line with an optional JIT (docs/jit/compiled-entry.md).
//! Its own flags come before the script and are removed before qjs parses the rest:
//!   --jit                 compile hot functions
//!   --jit-threshold=N     entries before a function is hot (default: the engine's 1000,
//!                         100 with --jit-baseline)
//!   --jit-stress=N        every compiled guard also fails on every Nth check
//!   --jit-deopt-limit=N   deopts before a function is unlinked (default 8, 0 = never)
//!   --jit-stats           print compile and deopt counters to stderr at exit
//!   --jit-stats=PATH      write them to PATH instead (one line)
//!   --jit-dump            print each hot function's bytecode and outcome to stderr
//!   --jit-calls           also compile functions that make calls (through the engine)
//!   --jit-baseline        hot functions get baseline code instead (docs/jit/baseline.md); implies --jit
//!   --jit-opt[=N]         baseline code, and optimized code on the same frame for a function that ran N
//!                         more times (default 500; docs/jit/optimizer.md); implies --jit-baseline
//!   --jit-no-inline       with --jit-calls: never inline a callee (docs/jit/inlining.md)
//!   --jit-compile-budget=N  bytecode bytes a function may have translated in all (default 32768, 0 = none)
//!   --jit-no-borrow       without the pass that makes element, length and variable reads borrow (ssa_opt)
//!   --jit-no-hoist        without the pass that moves loop-invariant guards and loads out of loops (ssa_opt)
//!   --jit-no-bounds       without the pass that proves a counted loop's element indexes in front of it (ssa_opt)
//!   --jit-no-unboxed      without the pass that makes exits name a value's unboxed number (ssa_opt)
//!   --jit-foresee=MASK    which sure deopts a recording refuses a function for (jit_runtime FORESEE_*, default 15)
//!   --jit-profile=N       record N instructions of feedback before a function's first compilation (default 100, plus 2 per bytecode byte; 0 = none)
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.collections.list { List }
import silk.system.host_input { HostInput, HostInputError }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.cli_options { Arguments, QjsResult }
import silkjs.cli_options as cli
import silkjs.cli_io as io
import silkjs.qjs_launch as launch
import jit.jit_runtime { Jit, Options }
import jit.ssa_opt { PASS_BORROW, PASS_HOIST, PASS_UNBOXED, PASS_BOUNDS }
import silk.num.u32

fn startsWith(bytes: &[u8], prefix: &[u8]) -> bool {
  if bytes.length < prefix.length { return false }
  return Slice.view(bytes, 0, prefix.length) == prefix
}
/// The decimal after prefix in bytes, or None.
fn number(bytes: &[u8], prefix: &[u8]) -> Option<u32> {
  if bytes.length == prefix.length { return Option<u32>.none() }
  let mut value: u32 = 0
  let mut index = prefix.length
  while index < bytes.length {
    let digit = bytes[index]
    if digit < 48 || digit > 57 || value > 400000000 { return Option<u32>.none() }
    value = value * 10 + u8.toU32(digit - 48) index = index + 1
  }
  return Option<u32>.some(value)
}
/// Removes the --jit flags ahead of the script from arguments into options.
effect fn takeFlags(arguments: &mut Arguments, options: &mut Options, statsPath: &mut List<u8>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut index: usize = 1
  while index < arguments.count() {
    let argument = arguments.bytes(index)
    if !startsWith(argument, b"-") { break }
    let mut taken = true
    if argument == b"--jit" { options.enabled = true }
    else if argument == b"--jit-stats" { options.stats = true }
    else if argument == b"--jit-dump" { options.dump = true }
    else if argument == b"--jit-calls" { options.calls = true }
    else if argument == b"--jit-baseline" { options.enabled = true options.baseline = true }
    else if argument == b"--jit-opt" { options.enabled = true options.baseline = true options.optimize = true }
    else if startsWith(argument, b"--jit-opt=") {
      options.enabled = true options.baseline = true options.optimize = true
      match number(argument, b"--jit-opt=") { Option<u32>.Some { value } => { options.optimizeEntries = value } Option<u32>.None => { return false } }
    }
    else if argument == b"--jit-no-borrow" { options.passes = u32.bitAnd(options.passes, u32.bitNot(PASS_BORROW)) }
    else if argument == b"--jit-no-hoist" { options.passes = u32.bitAnd(options.passes, u32.bitNot(PASS_HOIST)) }
    else if argument == b"--jit-no-bounds" { options.passes = u32.bitAnd(options.passes, u32.bitNot(PASS_BOUNDS)) }
    else if argument == b"--jit-no-unboxed" { options.passes = u32.bitAnd(options.passes, u32.bitNot(PASS_UNBOXED)) }
    else if argument == b"--jit-no-inline" { options.inlining = false }
    else if startsWith(argument, b"--jit-stats=") {
      options.stats = true
      run statsPath.appendSlice(Slice.view(argument, 12, argument.length - 12))
    }
    else if startsWith(argument, b"--jit-threshold=") {
      match number(argument, b"--jit-threshold=") { Option<u32>.Some { value } => { options.threshold = value } Option<u32>.None => { return false } }
    }
    else if startsWith(argument, b"--jit-stress=") {
      match number(argument, b"--jit-stress=") { Option<u32>.Some { value } => { options.stress = value } Option<u32>.None => { return false } }
    }
    else if startsWith(argument, b"--jit-compile-budget=") {
      match number(argument, b"--jit-compile-budget=") { Option<u32>.Some { value } => { options.compileBudget = value } Option<u32>.None => { return false } }
    }
    else if startsWith(argument, b"--jit-foresee=") {
      match number(argument, b"--jit-foresee=") { Option<u32>.Some { value } => { options.foresee = value } Option<u32>.None => { return false } }
    }
    else if startsWith(argument, b"--jit-profile=") {
      match number(argument, b"--jit-profile=") { Option<u32>.Some { value } => { options.profile = value } Option<u32>.None => { return false } }
    }
    else if startsWith(argument, b"--jit-deopt-limit=") {
      match number(argument, b"--jit-deopt-limit=") { Option<u32>.Some { value } => { options.deoptLimit = value } Option<u32>.None => { return false } }
    }
    else { taken = false }
    if taken { drop arguments.values.remove(index) } else { index = index + 1 }
  }
  return true
}

effect fn program() -> i32 ! HostInputError | OutOfMemoryError | SynchronizationError ? &mut HostInput | &mut Allocator {
  let mut arguments = run Arguments.load()
  let mut options = Options.make()
  let mut statsPath = List<u8>.make()
  if !run takeFlags(&mut arguments, &mut options, &mut statsPath) { io.stderr(b"silkjs-jit: bad --jit flag value\n") return 2 }
  let parsed = run cli.parseQjs(&arguments)
  match move parsed {
    QjsResult.Exit { status } => { return status }
    QjsResult.Options { value } => {
      let mut qjs = move value
      let mut jit = run Jit.make(move options)
      qjs.runtimeSetup = Jit.setupAddress()
      qjs.runtimeSetupData = jit.setupData()
      let status = run launch.runInterpreter(&arguments, &qjs)
      jit.collect()
      if jit.options.dump { let lines = run jit.deoptLines() io.stderr(lines.asSlice()) }
      if jit.options.dump { run jit.dumpOsrDeopts() }
      if jit.options.stats {
        let line = run jit.statsLine()
        if statsPath.length() == 0 { io.stderr(line.asSlice()) }
        else { drop run Effect.result(io.writeFile(statsPath.asSlice(), line.asSlice())) }
      }
      return status
    }
  }
}
pub effect fn main() -> i32 ? &mut HostInput {
  let mut system = Allocator.systemAllocatorProvider()
  let executed = run Effect.result(program()) |> Effect.provideMut<Allocator>(&mut system)
  match move executed {
    Result<i32, HostInputError | OutOfMemoryError | SynchronizationError>.Success { value } => { return value }
    Result<i32, HostInputError | OutOfMemoryError | SynchronizationError>.Failure { .. } => {
      io.stderr(b"silkjs-jit: unable to initialize native runtime resources\n")
      return 2
    }
  }
}
