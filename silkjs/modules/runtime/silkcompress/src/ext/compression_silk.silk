/// `[zlib, brotli, zstd]` for `process.versions`: the codecs are silk.compress's.
unsafe effect fn versions<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
