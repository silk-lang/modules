//! Repaired paint caches: after a change, the fragment hashes, ink, stacking and index by
//! source the tree repairs from what a layout pass kept are those a full rebuild makes.
import ui_tree.css
import ui_tree.css { px, Property }
import ui_tree.legacy {
  UiTree,
  TreeError,
  Batch,
  FrameInput,
  NodeKind,
  Mutation,
  Position,
  Overflow,
  CanvasCommand,
  VirtualItem,
  VirtualOptions,
}
import ui_fixtures.fixtures as fixtures
import ui_tree.mutation { Declaration }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u32
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

const MESSAGES: u32 = 24

fn input() -> FrameInput {
  // Tall enough that nothing overflows: a scrollbar that takes room turns css-layout's
  // reuse off, and with it everything this test is about.
  return FrameInput { width: 320.0, height: 6000.0, scale: 1.0, time: 0.0 }
}

fn z(value: i32) -> Declaration {
  return css.declare(Property.ZIndex, css.number(i32.toF32(value)))
}

/// Message `index`: box `index * 10` (relative), holding a paragraph box `+ 1` with text
/// `+ 2`, and an absolute badge `+ 3` above it.
effect fn message(batch: &mut Batch, parent: u32, index: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let id = index * 10
  run batch.box(parent, id, &[css.position(Position.Relative), css.backgroundColor(fixtures.rgb(0xf0f0f0))])
  run batch.box(id, id + 1, &[])
  run batch.text(id + 1, id + 2, "The quick brown fox jumps over the lazy dog and keeps going for a while.")
  run batch.box(
    id,
    id + 3,
    &[
      css.position(Position.Absolute),
      css.top(px(2.0)),
      css.left(px(2.0)),
      css.width(px(8.0)),
      css.height(px(8.0)),
      z(1),
      css.backgroundColor(fixtures.rgb(0xff0000)),
    ],
  )
}

/// A frame, then: the caches the frame repaired match a rebuild.
effect fn settle(tree: &mut UiTree<'_>, what: string<'static>) -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run tree.frame(input())
  run Testing.expect(tree.repair.mismatches == 0, what)
}

effect fn repairsBody() -> ()
  ! TreeError | FileError | HostInputError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(1, &[css.width(px(320.0)), css.backgroundColor(fixtures.rgb(0xffffff))])
  run batch.box(1, 2, &[])
  let mut index: u32 = 1
  while index <= MESSAGES {
    run message(&mut batch, 2, index)
    index = index + 1
  }
  run batch.box(1, 3, &[css.height(px(40.0)), css.backgroundColor(fixtures.rgb(0x00ff00))])
  run tree.apply(run batch.take())
  run tree.frame(input())
  tree.repair.verify = true
  let rebuilt = tree.repair.rebuilds

  // The last message's text grows, a few words a frame, onto new lines.
  let mut text = run String.copy("Streaming")
  let mut step: u32 = 0
  while step < 30 {
    run text.append(" three more words")
    run batch.setText(MESSAGES * 10 + 2, String.view(&text))
    run tree.apply(run batch.take())
    run settle(&mut tree, "growing text at the end")
    step = step + 1
  }
  run Testing.expect(tree.repair.fragileRebuilds == 0, "nothing here is fragile")
  run Testing.expect(tree.repair.uncarriedWhy != 1, "css-layout knows what each pass kept")
  run Testing.expect(tree.repair.uncarriedWhy != 2, "its report fits the fragments")
  run Testing.expect(tree.repair.uncarriedWhy != 3, "the index by source fits its report")
  run Testing.expect(tree.output.lastMode != 4 && tree.output.lastMode != 3, "the layout works in place")
  run Testing.expect(tree.repair.uncarried == 0, "css-layout reports what each pass kept")
  run Testing.expect(tree.repair.rebuilds == rebuilt, "a text change rebuilds nothing")
  run Testing.expect(tree.repair.repairs >= 30, "and repairs the caches")

  // One in the middle grows: everything after it moves.
  step = 0
  while step < 6 {
    run text.append(" and yet three more")
    run batch.setText(52, String.view(&text))
    run tree.apply(run batch.take())
    run settle(&mut tree, "growing text in the middle")
    step = step + 1
  }

  // A restyle that repaints, and one that changes stacking.
  run batch.style(70, &[css.position(Position.Relative), css.backgroundColor(fixtures.rgb(0x0000ff))])
  run tree.apply(run batch.take())
  run settle(&mut tree, "a background change")
  run batch.style(
    73,
    &[
      css.position(Position.Absolute),
      css.top(px(2.0)),
      css.left(px(2.0)),
      css.width(px(8.0)),
      css.height(px(8.0)),
      z(-1),
      css.backgroundColor(fixtures.rgb(0xff0000)),
    ],
  )
  run tree.apply(run batch.take())
  run settle(&mut tree, "a z-index change")
  run batch.style(80, &[css.backgroundColor(fixtures.rgb(0xf0f0f0)), css.opacity(0.5)])
  run tree.apply(run batch.take())
  run settle(&mut tree, "a box that stops being positioned and makes a stacking context")

  // Nodes come and go.
  run message(&mut batch, 2, MESSAGES + 1)
  run tree.apply(run batch.take())
  run settle(&mut tree, "a message added at the end")
  run batch.create(900, NodeKind.Box)
  run batch.style(900, &[css.height(px(30.0)), css.backgroundColor(fixtures.rgb(0xffff00))])
  run batch.insertBefore(2, 900, 40)
  run tree.apply(run batch.take())
  run settle(&mut tree, "a box inserted in the middle")
  run batch.push(Mutation.Destroy { id: 30 })
  run tree.apply(run batch.take())
  run settle(&mut tree, "a message destroyed")
  run batch.push(Mutation.Remove { id: 900 })
  run tree.apply(run batch.take())
  run settle(&mut tree, "a box removed")
  run batch.setText(MESSAGES * 10 + 2, "short again")
  run tree.apply(run batch.take())
  run settle(&mut tree, "text that shrinks")

  // A fixed box is a fragment root of its own, folded into the root that paints it.
  run batch.box(
    1,
    950,
    &[
      css.position(Position.Fixed),
      css.top(px(10.0)),
      css.left(px(200.0)),
      css.width(px(50.0)),
      css.height(px(20.0)),
      css.backgroundColor(fixtures.rgb(0x00ffff)),
    ],
  )
  run tree.apply(run batch.take())
  run settle(&mut tree, "a fixed box added")
  step = 0
  while step < 4 {
    run text.append(" beside a fixed box")
    run batch.setText(MESSAGES * 10 + 2, String.view(&text))
    run tree.apply(run batch.take())
    run settle(&mut tree, "growing text beside a fixed box")
    step = step + 1
  }
  run batch.push(Mutation.Destroy { id: 950 })
  run tree.apply(run batch.take())
  run settle(&mut tree, "the fixed box destroyed")
  run batch.setText(12, "the first message changes last")
  run tree.apply(run batch.take())
  run settle(&mut tree, "text at the start")
  run Testing.expect(tree.repair.mismatches == 0, "every repair matched a rebuild")
}

test effect fn repairedPaintCachesMatchARebuild() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run repairsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn canvasAndOffscreenBody() -> ()
  ! TreeError | FileError | HostInputError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(1, &[css.width(px(400.0)), css.height(px(300.0)), css.overflow(Overflow.Hidden)])
  // Visible canvas.
  run batch.create(2, NodeKind.Canvas)
  run batch.push(Mutation.InsertBefore { parent: 1, child: 2, before: Option<u32>.None })
  run batch.style(2, &[css.width(px(400.0)), css.height(px(100.0))])
  let mut cmds1 = List<CanvasCommand>.make()
  run cmds1.append(CanvasCommand.FillRect { x: 0.0, y: 0.0, width: 50.0, height: 20.0, radius: 0.0, color: fixtures.rgb(0x2288ff) })
  run batch.push(Mutation.SetCanvas { id: 2, commands: move cmds1 })
  // Off-screen translated panel holding a canvas with many quads.
  let shift = run css.text(b"100% 0")
  run batch.box(
    1,
    3,
    &[
      css.position(Position.Absolute),
      css.top(px(0.0)),
      css.left(px(0.0)),
      css.width(px(400.0)),
      css.height(px(300.0)),
      css.overflow(Overflow.Hidden),
      css.declare(Property.Translate, move shift),
    ],
  )
  run batch.create(4, NodeKind.Canvas)
  run batch.push(Mutation.InsertBefore { parent: 3, child: 4, before: Option<u32>.None })
  run batch.style(4, &[css.width(px(400.0)), css.height(px(300.0))])
  let mut hiddenCmds = List<CanvasCommand>.make()
  let mut k: u32 = 0
  while k < 32 {
    run hiddenCmds.append(CanvasCommand.FillRect {
      x: 4.0, y: 4.0, width: 20.0, height: 10.0, radius: 0.0, color: fixtures.rgb(0xff0000),
    })
    k = k + 1
  }
  run batch.push(Mutation.SetCanvas { id: 4, commands: move hiddenCmds })
  run tree.apply(run batch.take())
  let view = FrameInput { width: 400.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(view)
  run Testing.expect(tree.stats.primitives < 10, "offscreen translate(100% 0) canvas is culled")

  // Updating the visible canvas repairs paint caches incrementally without a full rebuild.
  let rebuildsBefore = tree.repair.rebuilds
  let repairsBefore = tree.repair.repairs
  tree.repair.verify = true
  let mut cmds2 = List<CanvasCommand>.make()
  run cmds2.append(CanvasCommand.FillRect { x: 10.0, y: 0.0, width: 80.0, height: 20.0, radius: 0.0, color: fixtures.rgb(0x44cc88) })
  run batch.push(Mutation.SetCanvas { id: 2, commands: move cmds2 })
  run tree.apply(run batch.take())
  run tree.frame(view)
  run Testing.expect(tree.repair.rebuilds == rebuildsBefore, "SetCanvas does not trigger full paint cache rebuild")
  run Testing.expect(tree.repair.repairs > repairsBefore, "SetCanvas repairs paint caches incrementally")
  run Testing.expect(tree.repair.mismatches == 0, "SetCanvas repair matches full rebuild")
}

effect fn noopVirtualListKeepsQuietFrameBody() -> ()
  ! TreeError | FileError | HostInputError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(1, &[css.width(px(300.0)), css.height(px(200.0))])
  run batch.box(1, 2, &[css.height(px(200.0)), css.overflow(Overflow.Auto)])
  run batch.box(2, 3, &[css.height(px(40.0))])
  let opts = VirtualOptions { estimatedHeight: 40.0, overscan: 80.0, gap: 0.0, revision: 0 }
  run batch.push(Mutation.SetVirtualList { id: 2, count: 100, options: opts })
  let mut items = List<VirtualItem>.make()
  run items.append(VirtualItem { index: 0, id: 3 })
  run batch.push(Mutation.SetVirtualItems { id: 2, items: move items })
  run tree.apply(run batch.take())
  let view = FrameInput { width: 300.0, height: 200.0, scale: 1.0, time: 0.0 }
  run tree.frame(view)
  // Second frame settles initial virtual range/measurements.
  run tree.frame(view)

  // Re-sending identical SetVirtualList + SetVirtualItems keeps the frame quiet.
  let keptBefore = tree.paintsKept
  let rebuildsBefore = tree.repair.rebuilds
  run batch.push(Mutation.SetVirtualList { id: 2, count: 100, options: opts })
  let mut sameItems = List<VirtualItem>.make()
  run sameItems.append(VirtualItem { index: 0, id: 3 })
  run batch.push(Mutation.SetVirtualItems { id: 2, items: move sameItems })
  run tree.apply(run batch.take())
  run tree.frame(view)
  run Testing.expect(tree.paintsKept > keptBefore, "unchanged SetVirtualList/SetVirtualItems keeps quiet frame")
  run Testing.expect(tree.repair.rebuilds == rebuildsBefore, "unchanged SetVirtualList/SetVirtualItems does not rebuild paint caches")
}

test effect fn canvasRepairsIncrementallyAndOffscreenCulls() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run canvasAndOffscreenBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn noopVirtualListKeepsQuietFrame() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run noopVirtualListKeepsQuietFrameBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
