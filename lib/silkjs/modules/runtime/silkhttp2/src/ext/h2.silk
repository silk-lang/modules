pub unsafe fn nghttp2_session_get_remote_window_size(session: ?*mut u8) -> i32 { let mut a = () let s = unsafe ses(&mut a, unsafe sessionOf(session)) return s.remoteWindow }
pub unsafe fn nghttp2_session_get_stream_local_close(session: ?*mut u8, stream: i32) -> i32 {
  let found = unsafe findStream(unsafe sessionOf(session), stream)
  if Pointer.isNull<Stream>(found) { return -1 }
  return if u8.bitAnd(unsafe shutOf(unsafe nonnull(found)), SHUT_WR) != 0 { 1 } else { 0 }
}
pub unsafe fn nghttp2_session_get_stream_remote_close(session: ?*mut u8, stream: i32) -> i32 {
