      if op == Op.GetElemF64 {
        run self.a.jcc(Cond.AboveOrEqual, miss)
        run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.typedData)))
        let out = self.at(inst.result)
        if out.kind == XMM { run self.a.loadDouble(out.xmm, element) } else {
          run self.a.load(Width.W64, Reg.Rax, element)
          run putBits(&mut self.a, out, Reg.Rax)
        }
      } else {
        // A numeric value stored outside a Float64Array (including a detached view) is ignored.
        let done = run self.a.label()
        run self.a.jcc(Cond.AboveOrEqual, done)
        run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.typedData)))
        let value = self.at(inst.b)
        if value.kind == XMM { run self.a.storeDouble(element, value.xmm) } else {
          run getBits(&mut self.a, Reg.Rax, value)
          run self.a.store(Width.W64, element, Reg.Rax)
        }
        self.a.bind(done)
      }
      return ()
    }
    if op == Op.PutKey {
      run self.stressGuard(inst.exit)
      run self.putKey(&function, inst)
      return ()
    }
    if op == Op.GetElem || op == Op.PutElem || op == Op.GetLength {
      run self.stressGuard(inst.exit)
      let done = run self.a.label()
      // A borrowed result (ssa_opt_borrow) takes no count. A length is a number: no count
      // either way.
      let borrowed = inst.result != NONE && function.value(inst.result).own == Own.Borrowed
      if op == Op.GetLength && inst.k == LENGTH_ARGUMENTS {
        let layout = self.settings.layout
        let p = self.plan
        run self.a.load(Width.W32, Reg.R9, p.rec(p.f.argc))
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.int()))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        return ()
      }
      if op == Op.GetElem && inst.k == ELEM_ARGUMENTS {
        let exit = self.exitLabels.get(u32.toUsize(inst.exit))
        let p = self.plan
        let index = self.at(inst.b)
        run getI32(&mut self.a, Reg.Rdx, index)
        run self.a.test(Width.W32, Reg.Rdx, Reg.Rdx)
        run self.a.jcc(Cond.Sign, exit)
        run self.a.mov(Width.W32, Reg.Rdx, Reg.Rdx)
        run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rdx, p.rec(p.f.argc))
        run self.a.jcc(Cond.AboveOrEqual, exit)
        run self.a.load(Width.W64, Reg.R11, p.rec(p.f.argv))
        run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rdx, 4)
        run self.a.load(Width.W64, Reg.Rax, Mem.indexed(Reg.R11, Reg.Rdx, Scale.One, 0))
        run self.a.load(Width.W64, Reg.R9, Mem.indexed(Reg.R11, Reg.Rdx, Scale.One, 8))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        if !borrowed { run self.retainBits(Reg.Rax, Reg.R9) }
        return ()
      }
      if op == Op.GetLength {
        // Inline: an Array keeps its length in slot 0.
        let layout = self.settings.layout
        let fields = self.fields
        let slow = run self.a.label()
        run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)))
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
        run self.a.jcc(Cond.NotEqual, slow)
        run self.a.load(Width.W64, Reg.R11, payloadOf(inst.a))
        run self.a.loadZero16(Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectClass)))
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(fields.arrayClass))
        run self.a.jcc(Cond.NotEqual, slow)
        run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectSlots)))
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, 8))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        if self.on {
          let step = self.stepAt()
          let mut shape: u32 = 0
          if step != 0 {
            let after = self.depthAfter(&function, inst, step)
            shape = leaving.stepShape(after - 1, 1, 0, after)
          }
          let extra: u32 = if borrowed { 1 } else { 0 }
          run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: done, inst: inst, step: step, shape: shape, out: NONE, extra: extra, kind: STEP_GET_LENGTH_SLOW })
          self.a.bind(done)
          return ()
        }
        run self.a.jmp(done)
        self.a.bind(slow)
      }
      if op == Op.GetElem && inst.k == ELEM_TRY {
        // A miss is Uninitialized, which owns nothing.
        let miss = run self.a.label()
        run self.elementSlot(inst.a, inst.b, miss)
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, 8))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        run self.retainBits(Reg.Rax, Reg.R9)
        run self.a.jmp(done)
        self.a.bind(miss)
        let layout = self.settings.layout
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.uninitialized()))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.storeImm(Width.W64, payloadOf(inst.result), 0)
        self.a.bind(done)
        return ()
      }
      // A trusted store whose value is the box right before it, made here (storedBox).
      let fused = op == Op.PutElem && self.cursor > 0 && self.storedBox(&function, self.cursor - 1)
      if op == Op.PutElem && inst.trusted {
        run self.trustedStore(&function, inst, fused, done)
        return ()
      }
      if op == Op.GetElem || op == Op.PutElem {
        self.element = addressed()
        let slow = run self.a.label()
        let mut index = inst.b
        if op == Op.PutElem { index = i32.wrappingToU32(inst.k) }
        // A site recorded on one typed array class tries that class first, then fast arrays.
        let kind = function.elementKind(&inst)
        let mut only: u32 = 0
        if kind >= u8.toU32(feedback.ELEMENT_TYPED) && kind <= u8.toU32(feedback.ELEMENT_TYPED) + classes.JS_CLASS_FLOAT64_ARRAY - classes.JS_CLASS_UINT8C_ARRAY { only = classes.JS_CLASS_UINT8C_ARRAY + kind - u8.toU32(feedback.ELEMENT_TYPED) }
        let mut typed = slow
        if only == 0 && !inst.trusted && !(op == Op.GetElem && inst.k == ELEM_STEP) { typed = run self.a.label() }
        if op == Op.GetElem && inst.k == ELEM_STEP {
          // A missing for-of element resumes the iterator in the interpreter.
          let miss = self.exitLabels.get(u32.toUsize(inst.exit))
          run self.elementSlot(inst.a, index, miss)
        } else if inst.trusted {
          // Past the count the interpreter takes over: no helper runs (ssa_opt_hoist).
          let miss = self.exitLabels.get(u32.toUsize(inst.exit))
          run self.trustedSlot(&function, inst.a, index, miss, inst.proven)
          self.elementEl = self.element
          self.elementAt = self.cursor self.elementObject = self.storage(inst.a) self.elementIndex = index
          self.elementNumber = false
          self.elementInt = false
          run self.bound(&function, index)
        } else if only != 0 {
          let fast = run self.a.label()
          run self.typedElement(op == Op.PutElem, inst.a, index, inst.b, inst.result, only, done, fast)
          self.a.bind(fast)
          run self.elementSlot(inst.a, index, slow)
        } else { run self.elementSlot(inst.a, index, typed) }
        let el = self.element
        if op == Op.GetElem {
          if borrowed && self.fusedUnbox(&function, inst) {
            // The next instruction unboxes this element and nothing else reads it: an Int
            // goes from the array to the number's place, and the unbox is skipped. Anything
            // else is copied to its slot as usual, for the unbox to refuse.
            let unbox = function.inst(self.cursor + 1)
            let general = run self.a.label()
            let layout = self.settings.layout
            if layout.tagWidth == 1 && layout.int() < 256 { run self.a.cmp8MemImm(el.at(u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.int())) }
            else {
              run self.loadTag(Reg.R8, el.at(u32.wrappingToI32(layout.tagOffset)))
              run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
            }
            // A trusted read needs no path past this one: anything but an Int goes out of
            // line to its slot and to the plain unbox's exit, which refuses it, and the
            // unbox itself is not lowered (omitAt). Stress keeps the unbox's guard.
            let outOfLine = inst.trusted && unbox.k == 0 && self.settings.stress == 0
            let cold = run self.a.label()
            if outOfLine { run self.a.jcc(Cond.NotEqual, cold) } else { run self.a.jcc(Cond.NotEqual, general) }
            let out = self.at(unbox.result)
            // The next instruction takes the number from the element (regalloc.foldedUnbox).
            let folded = outOfLine && u32.toUsize(self.cursor + 1) < self.cuts.folds.length() && self.cuts.folds.get(u32.toUsize(self.cursor + 1))
            if folded { self.memValue = unbox.result self.memFor = self.cursor + 2 self.memAt = el }
            else if out.kind == GPR { run self.a.load(Width.W32, out.gpr, el.at(8)) }
            else { run self.a.load(Width.W32, Reg.R8, el.at(8)) run self.a.store(Width.W64, slotOf(unbox.result), Reg.R8) }
            if outOfLine {
              self.omitAt = self.cursor + 1
              self.elementNumber = true
              self.elementInt = true
              run self.coldLabels.append(cold) run self.coldBacks.append(done) run self.coldInsts.append(inst) run self.coldAux.append(unbox.exit) run self.coldElements.append(el)
              self.a.bind(general)
              self.a.bind(done)
              return ()
            }
            self.cachedArr = NONE
            self.a.bind(cold)
            self.skipLabel = run self.a.label()
            self.skipAt = self.cursor + 1
            run self.a.jmp(self.skipLabel)
            self.a.bind(general)
          } else if (borrowed || function.value(inst.result).own == Own.Owned) && self.fusedUnboxF64(&function, inst) {
            // The next instruction unboxes this element as F64 and nothing else reads it:
            // a Float64 loads directly into the XMM place (or slot), an Int converts via
            // cvtsi2sd (out of line in coldPieces when outOfLine), and anything else goes
            // to its slot for the unbox's exit.
            let unbox = function.inst(self.cursor + 1)
            let layout = self.settings.layout
            let outOfLine = inst.trusted && self.settings.stress == 0
            let out = self.at(unbox.result)
            let byteTag = layout.tagWidth == 1 && layout.float64() < 256 && layout.int() < 256
            if outOfLine {
              let cold = run self.a.label()
              if byteTag {
                run self.a.cmp8MemImm(el.at(u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.float64()))
              } else {
                run self.loadTag(Reg.R8, el.at(u32.wrappingToI32(layout.tagOffset)))
                run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
              }
              run self.a.jcc(Cond.NotEqual, cold)
              if out.kind == XMM {
                run self.a.loadDouble(out.xmm, el.at(8))
              } else {
                run self.a.load(Width.W64, Reg.R8, el.at(8))
                run putBits(&mut self.a, out, Reg.R8)
              }
              self.omitAt = self.cursor + 1
              self.elementNumber = true
              run self.coldLabels.append(cold) run self.coldBacks.append(done) run self.coldInsts.append(inst) run self.coldAux.append(unbox.exit) run self.coldElements.append(el)
              self.a.bind(done)
              return ()
            }
            self.cachedArr = NONE
            let notFloat = run self.a.label()
            let general = run self.a.label()
            if byteTag {
              run self.a.cmp8MemImm(el.at(u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.float64()))
            } else {
              run self.loadTag(Reg.R8, el.at(u32.wrappingToI32(layout.tagOffset)))
              run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
            }
            run self.a.jcc(Cond.NotEqual, notFloat)
            if out.kind == XMM {
              run self.a.loadDouble(out.xmm, el.at(8))
            } else {
              run self.a.load(Width.W64, Reg.Rax, el.at(8))
              run putBits(&mut self.a, out, Reg.Rax)
            }
            self.skipLabel = run self.a.label()
            self.skipAt = self.cursor + 1
            run self.a.jmp(self.skipLabel)
            self.a.bind(notFloat)
            if byteTag {
              run self.a.cmp8MemImm(el.at(u32.wrappingToI32(layout.tagOffset)), u32.wrappingToU8(layout.int()))
            } else {
              run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
            }
            run self.a.jcc(Cond.NotEqual, general)
            run self.a.load(Width.W32, Reg.Rax, el.at(8))
            if out.kind == XMM {
              run self.a.intToDouble(Width.W32, out.xmm, Reg.Rax)
            } else {
              run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
              run putF64(&mut self.a, out, Xmm.Xmm0)
            }
            run self.a.jmp(self.skipLabel)
            self.a.bind(general)
          }
          self.cachedArr = NONE
          run self.a.load(Width.W64, Reg.Rax, el.at(0))
          run self.a.load(Width.W64, Reg.R9, el.at(8))
          run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
          run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
          if !borrowed { run self.retainBits(Reg.Rax, Reg.R9) }
          if inst.trusted || inst.k == ELEM_STEP {
            self.a.bind(done)
            // No other way comes to done on a trusted read: RAX and R9 hold the element.
            if inst.trusted && borrowed { self.setFresh(inst.result) }
            return ()
          }
        } else {
          // Only a non-heap value over a non-heap one: FastArrayData.store's plain and
          // clearHead stay true, and no count changes.
          let oldPlain = run self.a.label()
          let newPlain = run self.a.label()
          run self.a.load(Width.W64, Reg.Rax, el.at(0))
          run self.heapTest(Reg.Rax, oldPlain)
          run self.a.jmp(slow)
          self.a.bind(oldPlain)
          run self.a.load(Width.W64, Reg.Rax, slotOf(inst.b))
          // An immediate (a boxed number, undefined, a boolean) is never on the heap.
          if function.value(inst.b).own != Own.Imm {
            run self.heapTest(Reg.Rax, newPlain)
            run self.a.jmp(slow)
          }
          self.a.bind(newPlain)
          run self.a.load(Width.W64, Reg.R9, payloadOf(inst.b))
          run self.a.store(Width.W64, el.at(0), Reg.Rax)
          run self.a.store(Width.W64, el.at(8), Reg.R9)
        }
        if self.on {
          let mut step: u32 = 0
          let mut shape: u32 = 0
          if op == Op.GetElem {
            step = self.stepAt()
            if step != 0 && !borrowed {
              let after = self.depthAfter(&function, inst, step)
              shape = leaving.stepShape(after - 1, 1, 0, after)
            }
          }
          let extra: u32 = if borrowed { 1 } else { 0 }
          run self.stepSlows.append(StepSlow { entry: slow, auxLabel: typed, back: done, inst: inst, step: step, shape: shape, out: only, extra: extra, kind: STEP_ELEM_SLOW })
          self.a.bind(done)
          return ()
        }
        run self.a.jmp(done)
        if only == 0 && !inst.trusted {
          self.a.bind(typed)
          run self.typedElement(op == Op.PutElem, inst.a, index, inst.b, inst.result, 0, done, slow)
        }
        self.a.bind(slow)
      }
      // get_elem(env, object, index, out) / put_elem(env, object, index, value) /
      // get_length(env, object, out) -> 1 when done.
      run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
      if op == Op.GetElem {
        let index = self.at(inst.b) run getI32(&mut self.a, Reg.Rdx, index)
        run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
        if borrowed { run self.callHelper(helpers.GET_ELEM_BORROWED) } else { run self.callHelper(helpers.GET_ELEM) }
        let step = self.stepAt()
        if step != 0 && !borrowed {
          // It left before (ELEM_STEPS): the interpreter reads what the helper declines,
          // and its value is on top of the stack afterwards.
          run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
          let after = self.depthAfter(&function, inst, step)
          let cold = run self.deferStep(inst, step, leaving.stepShape(after - 1, 1, 0, after), inst.result, done, STEP_PLAIN)
          run self.a.jcc(Cond.Equal, cold)
          self.a.bind(done)
          return ()
        }
      } else if op == Op.PutElem {
        let index = self.at(i32.wrappingToU32(inst.k)) run getI32(&mut self.a, Reg.Rdx, index)
        run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.b))
        run self.callHelper(helpers.PUT_ELEM)
      } else if self.on {
        // length(env, source, out): a typed array's and any plain length property too
        // (js_vm_property_ops.quickLength), owned. A borrowed result gives its count back
        // (the object still holds the value).
        run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
        run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.result))
        run self.a.callMem(Mem.at(Reg.R12, baseline_env.helperOffset(baseline_env.LENGTH)))
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        let step = self.stepAt()
        if step != 0 {
          // It left before: the interpreter reads what the helper declines (a getter). Such a
          // read keeps its owned result (ssa_opt_borrow).
          let after = self.depthAfter(&function, inst, step)
          let cold = run self.deferStep(inst, step, leaving.stepShape(after - 1, 1, 0, after), inst.result, done, STEP_PLAIN)
          run self.a.jcc(Cond.Equal, cold)
        } else { run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit))) }
        if borrowed {
          run self.a.load(Width.W64, Reg.Rax, slotOf(inst.result))
          run self.heapTest(Reg.Rax, done)
          run self.a.load(Width.W64, Reg.Rdx, payloadOf(inst.result))
          run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rdx, 0), 1)
        }
        self.a.bind(done)
        return ()
      } else {
        run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.result))
        run self.callHelper(helpers.GET_LENGTH)
      }
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      self.a.bind(done)
      return ()
    }
    if op == Op.GetScope || op == Op.PutScope {
      run self.stressGuard(inst.exit)
      // get_scope(env, frame, site, out) / put_scope(env, frame, site, value) -> 1 when done;
      // site = slot | checked << 31 | captured << 30 | borrowed << 29.
      let k = i32.wrappingToU32(inst.k)
      let captured = (k & 0x20000) != 0
      let operand = k & 0xffff
      if (!captured || (operand & u16.toU32(SCOPE_OPERAND)) != 0) {
        let depth = if captured { u32.shiftRight(operand, u16.toU32(SCOPE_DEPTH_SHIFT)) & 7 } else { 0 }
        let slot = if captured { operand & u16.toU32(SCOPE_SLOT_MASK) } else { operand }
        if op == Op.GetScope {
          run self.readScope(&inst, depth, slot, captured || (k & 0x10000) != 0, function.value(inst.result).own)
        } else {
          run self.writeScope(&inst, depth, slot, captured || (k & 0x10000) != 0, function.value(inst.a).own == Own.Imm)
        }
        return ()
      }
      let mut site = u32.bitOr(u32.bitOr(k & 0xffff, u32.shiftLeft(u32.shiftRight(k, 16) & 1, 31)), u32.shiftLeft(u32.shiftRight(k, 17) & 1, 30))
      // A borrowed result (ssa_opt_borrow) takes no count: bit 29.
      if op == Op.GetScope && function.value(inst.result).own == Own.Borrowed { site = u32.bitOr(site, 0x20000000) }
      if self.on && op == Op.GetScope {
        let slow = run self.a.label()
        let done = run self.a.label()
        let mut closure = NONE
        if inst.frame != 0 { closure = self.inlineClosures.get(u32.toUsize(inst.frame - 1)) }
        run self.a.jmp(slow)
        self.a.bind(done)
        run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: done, inst: inst, step: 0, shape: 0, out: closure, extra: site, kind: STEP_HELPER_SLOW })
        return ()
      }
      run self.frameInto(Reg.Rsi)
      run self.a.movImm32(Reg.Rdx, site)
      if op == Op.GetScope { run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result)) run self.callHelper(helpers.GET_SCOPE) }
      else { run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.a)) run self.callHelper(helpers.PUT_SCOPE) }
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      return ()
    }
    if op == Op.GetVar && self.on && (inst.k & ssa.VAR_OWNED) != 0 && self.frameOf != 0 && self.plan.f.refTag != u32.MAX {
      // A cell of the body's one closure that owns its value for good, by its address: the
      // value, with no test.
      let f = self.plan.f
      let cell = u32.bitOr(u32.shiftLeft(self.frameOf - 1, 16), i32.wrappingToU32(inst.k & 0xffff))
      let mut n: u32 = 0
      while u32.toUsize(n) < self.ownedCells.length() && self.ownedCells.get(u32.toUsize(n)) != cell { n = n + 1 }
      let at = self.symbol(usize.toU32(function.inlineTargets.length()) * 3 + n)
      if self.fusedEqualsVar(&function, inst) {
        // The test right after compares the cell's number where it is (equalsFlags).
        self.cellFor = self.cursor + 1
        self.cellSymbol = at
        return ()
      }
      run self.a.movSymbol(Reg.Rax, at)
      if self.fusedUnboxI32(&function, inst) {
        // As a keyed field's (GetField): the number from the cell, the unbox not lowered.
        self.omitAt = self.unboxAt(&function, inst)
        let unbox = function.inst(self.omitAt)
        let cold = run self.a.label()
        let done = run self.a.label()
        run self.loadInt(unbox, Reg.Rax, signed(f.refValue), cold)
        run self.coldLabels.append(cold) run self.coldBacks.append(done) run self.coldInsts.append(inst) run self.coldAux.append(unbox.exit) run self.coldElements.append(addressed())
        self.a.bind(done)
        return ()
      }
      run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rax, signed(f.refValue + 8)))
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.refValue)))
      run self.storeFresh(&function, inst.result)
      if function.value(inst.result).own != Own.Borrowed { run self.retainBits(Reg.Rax, Reg.R9) }
      self.setFresh(inst.result)
      return ()
    }
    if op == Op.GetVar || op == Op.PutVar {
      run self.stressGuard(inst.exit)
      let read = run self.a.label()
      // The variable: a read's k may carry VAR_OWNED where the code above did not serve it.
      if op == Op.GetVar { inst.k = inst.k & (ssa.VAR_OWNED - 1) }
      if op == Op.GetVar && self.on && self.plan.f.refTag != u32.MAX && inst.k <= 4096 {
        // Inline, as baseline code reads it: the closure's variable cell when it owns its
        // value (a cell still in its frame, or a binding in its dead zone, is the helper's).
        let f = self.plan.f
        let slow = run self.a.label()
        let knownTarget = self.frameOf != 0 && self.knownFn(self.frameOf - 1)
        if self.frameOf == 0 { let own = self.plan.sf(f.currentFunction + 8) run self.a.load(Width.W64, Reg.Rax, own) }
        else if knownTarget {
          let target = self.symbol((self.frameOf - 1) * 3)
          run self.a.movSymbol(Reg.Rax, target)
        }
        else if self.exact(&function, self.frameOf - 1) {
          // The body's one closure, by its address: the read waits for no load of the callee.
          let closure = self.symbol((self.frameOf - 1) * 3 + 2)
          run self.a.movSymbol(Reg.Rax, closure)
        }
        else { run self.a.load(Width.W64, Reg.Rax, payloadOf(self.inlineClosures.get(u32.toUsize(self.frameOf - 1)))) }
        if (self.frameOf == 0 && self.plan.known) || knownTarget {
          run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.knownRefs)))
          run self.a.test(Width.W64, Reg.Rax, Reg.Rax)
          run self.a.jcc(Cond.Equal, slow)
        } else {
          run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.closureVarRefs)))
        }
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.boxHeader + i32.wrappingToU32(inst.k) * 8)))
        run self.a.test(Width.W64, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Equal, slow)
        run self.a.cmp8MemImm(Mem.at(Reg.Rax, signed(f.refTag)), u32.wrappingToU8(f.refDetached))
        run self.a.jcc(Cond.NotEqual, slow)
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rax, signed(f.refValue + 8)))
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.refValue)))
        run self.a.cmp8Imm(Reg.Rax, u32.wrappingToU8(self.settings.layout.uninitialized()))
        run self.a.jcc(Cond.Equal, slow)
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        if function.value(inst.result).own != Own.Borrowed { run self.retainBits(Reg.Rax, Reg.R9) }
        self.a.bind(read)
        let mut closure = NONE
        if self.frameOf != 0 { closure = self.inlineClosures.get(u32.toUsize(self.frameOf - 1)) }
        run self.outs.append(Out { kind: OUT_GET_VAR, entry: slow, back: read, frame: self.frameOf, inst: self.cursor, base: Reg.Rsp, at: 0, flags: closure })
        // The slow path comes back with the registers loaded too (out).
        self.setFresh(inst.result)
        return ()
      }
      if op == Op.PutVar && self.on && self.plan.f.refTag != u32.MAX && inst.k <= 4096 {
        let f = self.plan.f
        let c = self.construct
        let slow = run self.a.label()
        let oldNotHeap = run self.a.label()
        let knownTarget = self.frameOf != 0 && self.knownFn(self.frameOf - 1)
        if self.frameOf == 0 { let own = self.plan.sf(f.currentFunction + 8) run self.a.load(Width.W64, Reg.R8, own) }
        else if knownTarget {
          let target = self.symbol((self.frameOf - 1) * 3)
          run self.a.movSymbol(Reg.R8, target)
        }
        else if self.exact(&function, self.frameOf - 1) {
          let closureSym = self.symbol((self.frameOf - 1) * 3 + 2)
          run self.a.movSymbol(Reg.R8, closureSym)
        }
        else { run self.a.load(Width.W64, Reg.R8, payloadOf(self.inlineClosures.get(u32.toUsize(self.frameOf - 1)))) }
        if (self.frameOf == 0 && self.plan.known) || knownTarget {
          run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R8, signed(f.knownRefs)))
          run self.a.test(Width.W64, Reg.R8, Reg.R8)
          run self.a.jcc(Cond.Equal, slow)
        } else {
          run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R8, signed(f.closureVarRefs)))
        }
        run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R8, signed(f.boxHeader + i32.wrappingToU32(inst.k) * 8)))
        run self.a.test(Width.W64, Reg.R8, Reg.R8)
        run self.a.jcc(Cond.Equal, slow)
        run self.a.cmp8MemImm(Mem.at(Reg.R8, signed(f.refTag)), u32.wrappingToU8(f.refDetached))
        run self.a.jcc(Cond.NotEqual, slow)
        run self.a.cmp8MemImm(Mem.at(Reg.R8, signed(c.varRefIsConst)), 0)
        run self.a.jcc(Cond.NotEqual, slow)
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R8, signed(f.refValue)))
        run self.a.cmp8Imm(Reg.Rax, u32.wrappingToU8(self.settings.layout.uninitialized()))
        run self.a.jcc(Cond.Equal, slow)
        run self.heapTest(Reg.Rax, oldNotHeap)
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, signed(f.refValue + 8)))
        run self.a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.R9, 0), 1)
        run self.a.jcc(Cond.LessOrEqual, slow)
        run self.a.load(Width.W64, Reg.Rcx, slotOf(inst.a))
        run self.a.load(Width.W64, Reg.Rdx, payloadOf(inst.a))
        if function.value(inst.a).own != Own.Imm { run self.retainBits(Reg.Rcx, Reg.Rdx) }
        run self.a.store(Width.W64, Mem.at(Reg.R8, signed(f.refValue)), Reg.Rcx)
        run self.a.store(Width.W64, Mem.at(Reg.R8, signed(f.refValue + 8)), Reg.Rdx)
        run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R9, 0), 1)
        run self.a.jmp(read)
        self.a.bind(oldNotHeap)
        run self.a.load(Width.W64, Reg.Rcx, slotOf(inst.a))
        run self.a.load(Width.W64, Reg.Rdx, payloadOf(inst.a))
        if function.value(inst.a).own != Own.Imm { run self.retainBits(Reg.Rcx, Reg.Rdx) }
        run self.a.store(Width.W64, Mem.at(Reg.R8, signed(f.refValue)), Reg.Rcx)
        run self.a.store(Width.W64, Mem.at(Reg.R8, signed(f.refValue + 8)), Reg.Rdx)
        self.a.bind(read)
        let mut closure = NONE
        if inst.frame != 0 { closure = self.inlineClosures.get(u32.toUsize(inst.frame - 1)) }
        run self.stepSlows.append(StepSlow { entry: slow, auxLabel: slow, back: read, inst: inst, step: 0, shape: 0, out: closure, extra: i32.wrappingToU32(inst.k), kind: STEP_HELPER_SLOW })
        return ()
      }
      // get_var(env, frame, index, out) / put_var(env, frame, index, value) -> 1 when done.
      let mut index = i32.wrappingToU32(inst.k)
