//! Speech for the development screen reader (`screen_reader.silk`): the system's own text to
//! speech command, one utterance at a time, `say` on macOS and `espeak-ng`, `espeak` or
//! `spd-say` on Linux. Where none is found (or on other targets) the speaker is silent and the
//! screen reader shows captions only.
static if (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.collections.list { List }
  import silk.core.effect { Effect }
  import silk.core.option { Option }
  import silk.core.result { Result }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.system.child_process { ChildProcess }
  import silk.system.filesystem { FileSystem, FileError, Path }
  import silk.system.filesystem_machine { MachineFileSystem }
  import silk.system.subprocess { ExitStatus, SpawnOptions, Stdio, Subprocess, SubprocessError }
  import silk.text.string { String }

  static if Intrinsic.targetOperatingSystem() == "darwin" {
    const PROGRAMS: [string; 1] = ["/usr/bin/say"]
  } else {
    const PROGRAMS: [string; 5] = [
      "/usr/bin/espeak-ng",
      "/usr/bin/espeak",
      "/usr/local/bin/espeak-ng",
      "/usr/bin/spd-say",
      "/usr/local/bin/spd-say",
    ]
  }

  /// Says utterances in turn with the system's speech command.
  pub struct Speaker {
    /// The program found, once looked for: its index in `PROGRAMS`, or `PROGRAMS.length`.
    program: usize,
    looked: bool,
    /// The utterance being said, or -1.
    pid: i32,
    waiting: List<String>,
    /// Utterances stopped but not collected yet.
    stopped: List<i32>,
  }

  impl Speaker {
    pub fn make() -> Speaker {
      return Speaker {
        program: 0,
        looked: false,
        pid: -1,
        waiting: List<String>.make(),
        stopped: List<i32>.make(),
      }
    }

    /// Whether this machine has a speech command.
    pub effect fn available(self: &mut Self) -> bool ! OutOfMemoryError ? &mut Allocator {
      if !self.looked {
        self.looked = true
        self.program = PROGRAMS.length
        let mut files = run MachineFileSystem.make()
        let mut i: usize = 0
        while i < PROGRAMS.length {
          let found = run Effect.catchAll(present(PROGRAMS[i]), absent)
            |> Effect.provideMut<FileSystem>(&mut files)
          if found {
            self.program = i
            break
          }
          i = i + 1
        }
      }
      return self.program < PROGRAMS.length
    }

    /// The speech command's name, or "" when there is none.
    pub fn programName(self: &Self) -> string<'static> {
      if !self.looked || self.program >= PROGRAMS.length {
        return ""
      }
      return PROGRAMS[self.program]
    }

    /// Says `text` after what is being said, or (`interrupt`) instead of it.
    pub effect fn say(self: &mut Self, text: string, interrupt: bool) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {
      if interrupt {
        run self.stop()
      }
      if String.byteLength(text) == 0 || !(run self.available()) {
        return ()
      }
      run self.waiting.append(run String.copy(text))
      drop run self.poll()
    }

    /// Stops speaking and forgets what was waiting.
    pub effect fn stop(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
      self.waiting.clear()
      if self.pid > 0 {
        drop run Effect.result(Subprocess.kill(self.pid, 15))
        run self.stopped.append(self.pid)
        self.pid = -1
      }
      run self.collect()
    }

    /// Collects the exits of the utterances that were stopped.
    effect fn collect(self: &mut Self) -> () {
      let mut i: usize = 0
      while i < self.stopped.length() {
        let waited = run Effect.result(Subprocess.tryWait(self.stopped.asSlice()[i]))
        let ended = match move waited {
          Result<Option<ExitStatus>, SubprocessError>.Success { value } => value.isSome()
          Result<Option<ExitStatus>, SubprocessError>.Failure { .. } => true
        }
        if ended {
          drop self.stopped.remove(i)
        } else {
          i = i + 1
        }
      }
    }

    /// Whether something is being said or waits to be.
    pub fn busy(self: &Self) -> bool {
      return self.pid > 0 || self.waiting.length() != 0 || self.stopped.length() != 0
    }

    /// Collects the utterance that ended and starts the next. Returns whether the speaker went
    /// quiet just now: the last utterance ended and nothing waits.
    pub effect fn poll(self: &mut Self) -> bool ! OutOfMemoryError ? &mut Allocator {
      run self.collect()
      if self.pid > 0 {
        let waited = run Effect.result(Subprocess.tryWait(self.pid))
        let ended = match move waited {
          Result<Option<ExitStatus>, SubprocessError>.Success { value } => value.isSome()
          Result<Option<ExitStatus>, SubprocessError>.Failure { .. } => true
        }
        if !ended {
          return false
        }
        self.pid = -1
        if self.waiting.length() == 0 {
          return true
        }
      }
      while self.waiting.length() != 0 {
        let text = self.waiting.remove(0)
        let started = run Effect.result(start(PROGRAMS[self.program], text.view()))
        match move started {
          Result<i32, FileError | SubprocessError | OutOfMemoryError>.Success { value } => {
            self.pid = value
            return false
          }
          Result<i32, FileError | SubprocessError | OutOfMemoryError>.Failure { error } => match move error {
            OutOfMemoryError allocation => { fail move allocation }
            _ => {}
          }
        }
      }
      return false
    }
  }

  effect fn present(program: string) -> bool ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    let path = run Path.make(program)
    return run FileSystem.exists(&path)
  }

  effect fn absent(error: FileError | OutOfMemoryError) -> bool {
    return false
  }

  effect fn start(program: string, text: string) -> i32 ! FileError | SubprocessError | OutOfMemoryError ? &mut Allocator {
    let path = run Path.make(program)
    let mut request = run ChildProcess.request(&path)
    // spd-say returns at once unless told to wait, and speech must end before the next starts.
    if String.endsWith(program, "spd-say") {
      run ChildProcess.addArgument(&mut request, "-w")
    }
    run ChildProcess.addArgument(&mut request, "--")
    run ChildProcess.addArgument(&mut request, text)
    run Subprocess.inheritEnvironment(&mut request)
    let mut options = SpawnOptions.make()
    run options.setStdio(0, Stdio.ignore())
    run options.setStdio(1, Stdio.ignore())
    run options.setStdio(2, Stdio.ignore())
    let child = run Subprocess.spawn(&request, &options)
    return child.pid()
  }
} else {
  import silk.mem.allocator { Allocator, OutOfMemoryError }

  /// No speech command on this target yet: captions only.
  pub struct Speaker {}

  impl Speaker {
    pub fn make() -> Speaker {
      return Speaker {}
    }

    pub effect fn available(self: &mut Self) -> bool ! OutOfMemoryError ? &mut Allocator {
      return false
    }

    pub fn programName(self: &Self) -> string<'static> {
      return ""
    }

    pub effect fn say(self: &mut Self, text: string, interrupt: bool) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn stop(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {}

    pub fn busy(self: &Self) -> bool {
      return false
    }

    pub effect fn poll(self: &mut Self) -> bool ! OutOfMemoryError ? &mut Allocator {
      return false
    }
  }
}
