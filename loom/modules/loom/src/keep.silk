//! [`encode`] and [`restore`]: a model as JSON, by reflection, so a development host can stop
//! the program, rebuild it and start it again with the model the user had.
//!
//! The new program may have changed the model's type. [`restore`] writes the saved fields onto
//! the model `init` made, by name: a field that is gone is ignored, a new one keeps its `init`
//! value, and one whose type changed keeps its `init` value and is named in the report.
//!
//! What fits: numbers, booleans, `String`, `List`, and structs and unions with `pub` fields,
//! `Option` among them. An enum, an array, a map, a handle or a private field keeps its `init`
//! value.
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.reflect { Reflect, namedKind, unionKind }
import silk.core.result { Result }
import silk.core.static_text { StaticText }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.mem.raw_buffer { RawBuffer }
import silk.num.f32
import silk.num.f64
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.i8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.text.format { Format }
import silk.text.string { String }

/// The key that names a union's variant in its object.
pub const VARIANT_KEY: string<'static> = "$"

/// What [`restore`] could not put back: the paths of the fields that kept their `init` value
/// because the saved value no longer fits their type.
pub struct Restored {
  pub reset: List<String>,
  path: String,
}

impl Restored {
  pub fn make() -> Restored {
    return Restored { reset: List<String>.make(), path: String.make() }
  }

  /// Whether every saved value that still has a field went back.
  pub fn whole(self: &Self) -> bool {
    return self.reset.length() == 0
  }

  effect fn enter(self: &mut Self, label: string) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = String.byteLength(String.view(&self.path))
    if at != 0 {
      run self.path.append(".")
    }
    run self.path.append(label)
    return at
  }

  effect fn enterIndex(self: &mut Self, index: usize) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = String.byteLength(String.view(&self.path))
    run self.path.append("[")
    run decimal(&mut self.path, usize.toU64(index))
    run self.path.append("]")
    return at
  }

  effect fn leave(self: &mut Self, at: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.path = run String.copy(String.slice(String.view(&self.path), 0, at))
  }

  effect fn miss(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if String.byteLength(String.view(&self.path)) == 0 {
      return run self.reset.append(run String.copy("model"))
    }
    run self.reset.append(run String.copy(String.view(&self.path)))
  }
}

// --- Leaves ---

/// A value written as one JSON scalar.
interface Leaf {
  effect fn written(self: &Self, out: &mut String) -> () ! OutOfMemoryError ? &mut Allocator

  effect fn read(value: &Value) -> Option<Self> ! OutOfMemoryError ? &mut Allocator

  /// What a field of this type is when its saved struct does not have it.
  fn zero() -> Self
}

effect fn ascii(out: &mut String, bytes: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < bytes.length {
    let one: [u8; 1] = [bytes[i]]

    // The callers pass ASCII, whose bytes are whole characters.
    run out.append(unsafe String.fromUtf8Unchecked(&one))
    i = i + 1
  }
}

effect fn decimal(out: &mut String, value: u64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20]
  let mut at: usize = 20
  let mut rest = value
  while true {
    at = at - 1
    digits[at] = 48 + u64.toU8(rest % 10)
    rest = rest / 10
    if rest == 0 {
      break
    }
  }
  while at < 20 {
    let one: [u8; 1] = [digits[at]]
    run out.append(unsafe String.fromUtf8Unchecked(&one))
    at = at + 1
  }
}

effect fn signed(out: &mut String, value: i64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value < 0 {
    run out.append("-")

    // The least value has no positive counterpart.
    return run decimal(&mut out, i64.toU64(-(value + 1)) + 1)
  }
  run decimal(&mut out, i64.toU64(value))
}

effect fn real(out: &mut String, value: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !f64.isFinite(value) {
    return run out.append("null")
  }
  let mut bytes: [u8; 32] = [0; 32]
  let end = Format.writeF64Debug(value, &mut bytes, 0)
  let mut i: usize = 0
  while i < end {
    let one: [u8; 1] = [bytes[i]]
    run out.append(unsafe String.fromUtf8Unchecked(&one))
    i = i + 1
  }
}

effect fn quoted(out: &mut String, text: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  run out.append("\"")
  let mut from: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    let byte = bytes[i]
    if byte < 32 || byte == 34 || byte == 92 {
      run out.append(String.slice(text, from, i - from))
      if byte == 34 {
        run out.append("\\\"")
      } else if byte == 92 {
        run out.append("\\\\")
      } else if byte == 10 {
        run out.append("\\n")
      } else {
        let hex = "0123456789abcdef"
        run out.append("\\u00")
        run out.append(String.slice(hex, u8.toUsize(byte / 16), 1))
        run out.append(String.slice(hex, u8.toUsize(byte % 16), 1))
      }
      from = i + 1
    }
    i = i + 1
  }
  run out.append(String.slice(text, from, bytes.length - from))
  run out.append("\"")
}

impl Leaf for bool {
  effect fn written(self: &Self, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run out.append(
      if self.* {
        "true"
      } else {
        "false"
      },
    )
  }

  effect fn read(value: &Value) -> Option<bool>
    ! OutOfMemoryError
    ? &mut Allocator {
    return match &value.* {
      Value.Bool { value: flag } => Option<bool>.some(flag)
      _ => Option<bool>.none()
    }
  }

  fn zero() -> bool {
    return false
  }
}

impl Leaf for String {
  effect fn written(self: &Self, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run quoted(&mut out, String.view(self))
  }

  effect fn read(value: &Value) -> Option<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    return match &value.* {
      Value.String { text } => Option<String>.some(run String.copy(String.view(&text)))
      _ => Option<String>.none()
    }
  }

  fn zero() -> String {
    return String.make()
  }
}

impl Leaf for f64 {
  effect fn written(self: &Self, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run real(&mut out, self.*)
  }

  effect fn read(value: &Value) -> Option<f64>
    ! OutOfMemoryError
    ? &mut Allocator {
    return Json.asF64(Option<&Value>.some(value))
  }

  fn zero() -> f64 {
    return 0.0
  }
}

impl Leaf for f32 {
  effect fn written(self: &Self, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run real(&mut out, f32.toF64(self.*))
  }

  effect fn read(value: &Value) -> Option<f32>
    ! OutOfMemoryError
    ? &mut Allocator {
    return Json.asF32(Option<&Value>.some(value))
  }

  fn zero() -> f32 {
    return 0.0
  }
}

impl Leaf for u8 {
  effect fn written(self: &Self, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run decimal(&mut out, u8.toU64(self.*))
  }

  effect fn read(value: &Value) -> Option<u8>
    ! OutOfMemoryError
    ? &mut Allocator {
    return match Json.asU64(Option<&Value>.some(value)) {
      Option<u64>.Some { value: number } => u64.checkedToU8(number)
      Option<u64>.None => Option<u8>.none()
    }
  }

  fn zero() -> u8 {
    return 0
  }
}

