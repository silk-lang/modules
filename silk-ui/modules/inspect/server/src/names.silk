//! The names the protocol gives the tree's enums on the wire, both ways: roles as `describe`
//! writes them, event kinds as the DOM names its events, node kinds and cursors as CSS does.
import ui_inspect.view { cursorName }
import ui_tree.inspect { roleName, kindName }
import ui_tree.mutation { Role, NodeKind, Cursor }
import ui_tree.node { EventKind }
import silk.core.option { Option }

const ROLES: [Role; 66] = [
  Role.None,
  Role.Generic,
  Role.Button,
  Role.Link,
  Role.Checkbox,
  Role.Radio,
  Role.TextBox,
  Role.Heading,
  Role.Paragraph,
  Role.List,
  Role.ListItem,
  Role.Image,
  Role.Dialog,
  Role.Menu,
  Role.MenuItem,
  Role.Tab,
  Role.TabList,
  Role.TabPanel,
  Role.Toolbar,
  Role.Navigation,
  Role.Main,
  Role.Form,
  Role.Group,
  Role.Slider,
  Role.Switch,
  Role.ListBox,
  Role.Option,
  Role.Tooltip,
  Role.Alert,
  Role.AlertDialog,
  Role.Status,
  Role.Log,
  Role.Timer,
  Role.ProgressBar,
  Role.Separator,
  Role.ComboBox,
  Role.SearchBox,
  Role.SpinButton,
  Role.Table,
  Role.RowGroup,
  Role.Row,
  Role.Cell,
  Role.ColumnHeader,
  Role.RowHeader,
  Role.Grid,
  Role.GridCell,
  Role.Tree,
  Role.TreeGrid,
  Role.TreeItem,
  Role.MenuBar,
  Role.MenuItemCheckbox,
  Role.MenuItemRadio,
  Role.RadioGroup,
  Role.Region,
  Role.Banner,
  Role.ContentInfo,
  Role.Complementary,
  Role.Search,
  Role.Article,
  Role.Figure,
  Role.Document,
  Role.Application,
  Role.Note,
  Role.ScrollBar,
  Role.Feed,
  Role.Meter,
]

const EVENT_KINDS: [EventKind; 40] = [
  EventKind.PointerDown,
  EventKind.PointerUp,
  EventKind.Click,
  EventKind.PointerMove,
  EventKind.PointerEnter,
  EventKind.PointerLeave,
  EventKind.Wheel,
  EventKind.KeyDown,
  EventKind.KeyUp,
  EventKind.Focus,
  EventKind.Blur,
  EventKind.Input,
  EventKind.Layout,
  EventKind.PointerCancel,
  EventKind.GotPointerCapture,
  EventKind.LostPointerCapture,
  EventKind.Scroll,
  EventKind.Load,
  EventKind.Error,
  EventKind.TransitionRun,
  EventKind.TransitionStart,
  EventKind.TransitionEnd,
  EventKind.TransitionCancel,
  EventKind.AnimationStart,
  EventKind.AnimationIteration,
  EventKind.AnimationEnd,
  EventKind.AnimationCancel,
  EventKind.SelectionChange,
  EventKind.PointerOver,
  EventKind.PointerOut,
  EventKind.TouchStart,
  EventKind.TouchMove,
  EventKind.TouchEnd,
  EventKind.TouchCancel,
  EventKind.Copy,
  EventKind.Cut,
  EventKind.Paste,
  EventKind.BeforeInput,
  EventKind.CloseRequest,
  EventKind.Navigate,
]

const NODE_KINDS: [NodeKind; 6] = [
  NodeKind.Box,
  NodeKind.Text,
  NodeKind.Image,
  NodeKind.Icon,
  NodeKind.Input,
  NodeKind.Canvas,
]

const CURSORS: [Cursor; 35] = [
  Cursor.Default,
  Cursor.Pointer,
  Cursor.Text,
  Cursor.Move,
  Cursor.Grab,
  Cursor.Grabbing,
  Cursor.NotAllowed,
  Cursor.ResizeHorizontal,
  Cursor.ResizeVertical,
  Cursor.ResizeNorthWestSouthEast,
  Cursor.ResizeNorthEastSouthWest,
  Cursor.Crosshair,
  Cursor.None,
  Cursor.Wait,
  Cursor.Progress,
  Cursor.Help,
  Cursor.ContextMenu,
  Cursor.Copy,
  Cursor.Alias,
  Cursor.VerticalText,
  Cursor.ColumnResize,
  Cursor.RowResize,
  Cursor.ZoomIn,
  Cursor.ZoomOut,
  Cursor.Cell,
  Cursor.NoDrop,
  Cursor.AllScroll,
  Cursor.ResizeNorth,
  Cursor.ResizeEast,
  Cursor.ResizeSouth,
  Cursor.ResizeWest,
  Cursor.ResizeNorthEast,
  Cursor.ResizeNorthWest,
  Cursor.ResizeSouthEast,
  Cursor.ResizeSouthWest,
]

/// The name of an event kind, as the `events` command writes it (the DOM event's name).
pub fn eventName(kind: EventKind) -> string<'static> {
  return match kind {
    EventKind.PointerDown => "pointerdown"
    EventKind.PointerUp => "pointerup"
    EventKind.Click => "click"
    EventKind.PointerMove => "pointermove"
    EventKind.PointerEnter => "pointerenter"
    EventKind.PointerLeave => "pointerleave"
    EventKind.Wheel => "wheel"
    EventKind.KeyDown => "keydown"
    EventKind.KeyUp => "keyup"
    EventKind.Focus => "focus"
    EventKind.Blur => "blur"
    EventKind.Input => "input"
    EventKind.Layout => "layout"
    EventKind.PointerCancel => "pointercancel"
    EventKind.GotPointerCapture => "gotpointercapture"
    EventKind.LostPointerCapture => "lostpointercapture"
    EventKind.Load => "load"
    EventKind.Error => "error"
    EventKind.TransitionRun => "transitionrun"
    EventKind.TransitionStart => "transitionstart"
    EventKind.TransitionEnd => "transitionend"
    EventKind.TransitionCancel => "transitioncancel"
    EventKind.AnimationStart => "animationstart"
    EventKind.AnimationIteration => "animationiteration"
    EventKind.AnimationEnd => "animationend"
    EventKind.AnimationCancel => "animationcancel"
    EventKind.SelectionChange => "selectionchange"
    EventKind.PointerOver => "pointerover"
    EventKind.PointerOut => "pointerout"
    EventKind.TouchStart => "touchstart"
    EventKind.TouchMove => "touchmove"
    EventKind.TouchEnd => "touchend"
    EventKind.TouchCancel => "touchcancel"
    EventKind.Copy => "copy"
    EventKind.Cut => "cut"
    EventKind.Paste => "paste"
    EventKind.BeforeInput => "beforeinput"
    EventKind.CloseRequest => "closerequest"
    EventKind.Navigate => "navigate"
    EventKind.Scroll => "scroll"
  }
}

/// The event kind [`eventName`] calls `name`.
pub fn eventKindNamed(name: string) -> Option<EventKind> {
  let mut i: usize = 0
  while i < EVENT_KINDS.length {
    if eventName(EVENT_KINDS[i]) == name {
      return Option<EventKind>.Some { value: EVENT_KINDS[i] }
    }
    i = i + 1
  }
  return Option<EventKind>.None
}

/// The role whose ARIA name (as `describe` writes it) is `name`.
pub fn roleNamed(name: string) -> Option<Role> {
  let mut i: usize = 0
  while i < ROLES.length {
    if roleName(ROLES[i]) == name {
      return Option<Role>.Some { value: ROLES[i] }
    }
    i = i + 1
  }
  return Option<Role>.None
}

/// The node kind `describe` calls `name`.
pub fn kindNamed(name: string) -> Option<NodeKind> {
  let mut i: usize = 0
  while i < NODE_KINDS.length {
    if kindName(NODE_KINDS[i]) == name {
      return Option<NodeKind>.Some { value: NODE_KINDS[i] }
    }
    i = i + 1
  }
  return Option<NodeKind>.None
}

/// The cursor CSS calls `name`.
pub fn cursorNamed(name: string) -> Option<Cursor> {
  let mut i: usize = 0
  while i < CURSORS.length {
    if cursorName(CURSORS[i]) == name {
      return Option<Cursor>.Some { value: CURSORS[i] }
    }
    i = i + 1
  }
  return Option<Cursor>.None
}
