  let fp = unsafe Intrinsic.pointerReinterpret<*mut PriorityFrame, *mut Frame>(Pointer.fromMutRef<PriorityFrame>(&mut frame))
  if id == 0 {
    if increment == 0 { return unsafe invalidConnection(sp, fp, ERR_PROTO, b"WINDOW_UPDATE: window_size_increment == 0") }
    let s2 = unsafe ses(&mut a, sp)
    if MAX_WINDOW - increment < s2.remoteWindow { drop s2 return unsafe invalidConnection(sp, fp, ERR_FLOW_CONTROL, b"") }
    s2.remoteWindow = s2.remoteWindow + increment drop s2
    return unsafe frameReceived(sp, fp)
  }
  if unsafe detectIdleStream(sp, id) { return unsafe invalidConnection(sp, fp, ERR_PROTO, b"WINDOW_UPDATE to idle stream") }
  let found = unsafe findStream(sp, id)
  if Pointer.isNull<Stream>(found) { return 0 }
  let p = unsafe nonnull(found)
  let mut b = () let t = unsafe str(&mut b, p) let reservedRemote = t.state == S_RESERVED let window = t.remoteWindow drop t
  if reservedRemote && !unsafe isMyStream(sp, id) { return unsafe invalidConnection(sp, fp, ERR_PROTO, b"WINDOW_UPADATE to reserved stream") }
  if increment == 0 { return unsafe invalidConnection(sp, fp, ERR_PROTO, b"WINDOW_UPDATE: window_size_increment == 0") }
  if MAX_WINDOW - increment < window { return unsafe invalidStream(sp, id, fp, ERR_FLOW_CONTROL) }
  let t2 = unsafe str(&mut b, p) t2.remoteWindow = t2.remoteWindow + increment let positive = t2.remoteWindow > 0 drop t2
  if positive && unsafe deferredByFlowControl(p) { unsafe resumeDeferred(p, SF_DEFERRED_FLOW_CONTROL) }
  return unsafe frameReceived(sp, fp)
}
unsafe fn onAltsvcReceived(sp: *mut Session) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let id = s.hdStream let length = s.hdLength
  let originLength = u32.toUsize(u32.bitOr(u32.shiftLeft(u8.toU32(s.sbuf[0]), 8), u8.toU32(s.sbuf[1])))
  let base = s.lbuf.data let total = s.lbuf.length drop s
  let mut altsvc = AltSvc { origin: base, originLength: originLength, value: if total > originLength { unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe at(base, originLength)) } else { nil() }, valueLength: total - originLength }
  let mut frame = Extension { hd: unsafe frameHeader(length, id, ALTSVC, 0), payload: unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut AltSvc, *mut u8>(Pointer.fromMutRef<AltSvc>(&mut altsvc))) }
  let fp = unsafe Intrinsic.pointerReinterpret<*mut Extension, *mut Frame>(Pointer.fromMutRef<Extension>(&mut frame))
  if id == 0 { if originLength == 0 { return unsafe invalidFrame(sp, fp, ERR_PROTO) } }
  else {
    if originLength > 0 { return unsafe invalidFrame(sp, fp, ERR_PROTO) }
    let found = unsafe findStream(sp, id)
    if Pointer.isNull<Stream>(found) { return 0 }
    if unsafe stateOf(unsafe nonnull(found)) == S_CLOSING { return 0 }
  }
  if total - originLength == 0 { return unsafe invalidFrame(sp, fp, ERR_PROTO) }
  return unsafe frameReceived(sp, fp)
}
unsafe fn onOriginReceived(sp: *mut Session) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let length = s.hdLength let base = s.lbuf.data let total = s.lbuf.length drop s
  // nghttp2_frame_unpack_origin_payload: (length, origin) pairs; a malformed payload is ignored.
  let mut entries = emptyBuf()
  let mut offset: usize = 0 let mut count: usize = 0
  while offset < total {
    if total - offset < 2 { unsafe entries.release() return 0 }
    let n = u32.toUsize(getU16(unsafe constant(base), offset))
    offset = offset + 2
    if total - offset < n { unsafe entries.release() return 0 }
    let entry = OriginEntry { origin: if n > 0 { unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe at(base, offset)) } else { nil() }, length: n }
    if !unsafe entries.append(unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe Intrinsic.pointerReinterpret<*const OriginEntry, *const u8>(Pointer.fromRef<OriginEntry>(&entry))), Layout.of<OriginEntry>().bytes) { unsafe entries.release() return ERR_NOMEM }
    count = count + 1
    offset = offset + n
  }
  let mut origin = Origin { count: count, entries: unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut OriginEntry>(entries.data) }
  let mut frame = Extension { hd: unsafe frameHeader(length, 0, ORIGIN, 0), payload: unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut Origin, *mut u8>(Pointer.fromMutRef<Origin>(&mut origin))) }
  let rv = unsafe frameReceived(sp, unsafe Intrinsic.pointerReinterpret<*mut Extension, *mut Frame>(Pointer.fromMutRef<Extension>(&mut frame)))
  unsafe entries.release()
  return rv
}
unsafe fn dataFailFast(sp: *mut Session) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let id = s.hdStream drop s
  let mut reason: &[u8] = b""
  let mut code = PROTOCOL_ERROR
  if id == 0 { reason = b"DATA: stream_id == 0" }
  else if unsafe detectIdleStream(sp, id) { reason = b"DATA: stream in idle" }
  else {
    let found = unsafe findStream(sp, id)
    if Pointer.isNull<Stream>(found) { return ERR_IGN_PAYLOAD }
    let p = unsafe nonnull(found)
    let state = unsafe stateOf(p)
    if u8.bitAnd(unsafe shutOf(p), SHUT_RD) != 0 { reason = b"DATA: stream in half-closed(remote)" code = STREAM_CLOSED }
    else if unsafe isMyStream(sp, id) {
      if state == S_CLOSING { return ERR_IGN_PAYLOAD }
      if state != S_OPENED { reason = b"DATA: stream not opened" } else { return 0 }
    } else if state == S_RESERVED { reason = b"DATA: stream in reserved" }
    else if state == S_CLOSING { return ERR_IGN_PAYLOAD }
    else { return 0 }
  }
  let rv = unsafe terminateSession(sp, code, reason)
  if isFatal(rv) { return rv }
  return ERR_IGN_PAYLOAD
}
unsafe fn onDataReceived(sp: *mut Session) -> i32 {
  let mut a = () let s = unsafe ses(&mut a, sp) let id = s.hdStream let flags = s.hdFlags let length = s.hdLength let padlen = s.padlen drop s
  let found = unsafe findStream(sp, id)
  if Pointer.isNull<Stream>(found) || unsafe stateOf(unsafe nonnull(found)) == S_CLOSING { return 0 }
  let p = unsafe nonnull(found)
  if u8.bitAnd(flags, F_END_STREAM) != 0 {
    let mut b = () let t = unsafe str(&mut b, p) let bad = onRemoteEndStream(&t.*) != 0 drop t
    if bad {
      let rv = unsafe addRst(sp, id, PROTOCOL_ERROR, true)
      if isFatal(rv) { return rv }
      unsafe shutdown(p, SHUT_RD)
      return 0
    }
  }
  // nghttp2_data { hd, padlen }.
  let mut frame = Headers { hd: unsafe frameHeader(length, id, DATA, flags), padding: padlen, priority: Priority { stream: 0, weight: 0, exclusive: 0 }, entries: nil(), count: 0, category: 0 }
  let rv = unsafe frameReceived(sp, unsafe Intrinsic.pointerReinterpret<*mut Headers, *mut Frame>(Pointer.fromMutRef<Headers>(&mut frame)))
  if isFatal(rv) { return rv }
  if u8.bitAnd(flags, F_END_STREAM) != 0 {
    let again = unsafe findStream(sp, id)
    if Pointer.isNull<Stream>(again) { return 0 }
    unsafe shutdown(unsafe nonnull(again), SHUT_RD)
    let rv2 = unsafe closeIfShutRdwr(sp, unsafe nonnull(again))
    if isFatal(rv2) { return rv2 }
  }
  return 0
}
unsafe fn state(sp: *mut Session) -> i32 { let mut a = () let s = unsafe ses(&mut a, sp) return s.ib }
unsafe fn setState(sp: *mut Session, value: i32) -> () { let mut a = () let s = unsafe ses(&mut a, sp) s.ib = value }

pub unsafe fn nghttp2_session_mem_recv(session: ?*mut u8, data: ?*mut u8, length: usize) -> i64 {
  let sp = unsafe sessionOf(session)
  let input = unsafe constant(data)
  let inlen = usize.toI64(length)
  let mut at: usize = 0
  let end = length
  if unsafe nghttp2_session_want_read(session) == 0 { return inlen }
  let mut a = ()
  while true {
    let mut busy = false
    let st = unsafe state(sp)
    if st == IB_READ_CLIENT_MAGIC {
      let s = unsafe ses(&mut a, sp)
      let readlen = if end - at < s.payloadLeft { end - at } else { s.payloadLeft }
      let offset = 24 - s.payloadLeft
      let mut i: usize = 0
      while i < readlen { if unsafe byte(input, at + i) != MAGIC[offset + i] { return i32.toI64(ERR_BAD_CLIENT_MAGIC) } i = i + 1 }
      s.payloadLeft = s.payloadLeft - readlen
      at = at + readlen
      let done = s.payloadLeft == 0 drop s
      if done { unsafe ibReset(sp) unsafe setState(sp, IB_READ_FIRST_SETTINGS) }
    } else if st == IB_READ_FIRST_SETTINGS || st == IB_READ_HEAD {
      at = at + unsafe bufRead(sp, input, at, end)
      if unsafe markAvail(sp) > 0 { return usize.toI64(at) }
