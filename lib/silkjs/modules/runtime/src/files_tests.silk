//! Tests of the core's `Files` implementations: `silk test --root src/files_tests.silk`.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.testing.testing { Testing, AssertionError }
import silk.platform.native.file { OPEN_WRITE_ONLY, OPEN_CREATE, OPEN_TRUNCATE }
import silk.num.i64
import silk.num.i32
import silk.num.usize
import ext.fs_ops as ops
import ext.fs_ops { Call, Outcome }
import libs.core.capabilities { Files }
import libs.core.files { MemoryFiles, RootedFiles, GrantedFiles, OsFiles }

type Failures = AssertionError<'static> | OutOfMemoryError

effect fn pathCall(op: i32, path: &[u8]) -> Call ! OutOfMemoryError ? &mut Allocator {
  let mut call = ops.call(op)
  run call.path.appendBytes(path)
  return move call
}

/// Runs `call` and returns its code; `out` keeps the result.
fn run1<F: Files>(files: &F, call: &Call, out: &mut Outcome) -> i32 {
  unsafe files.execute(&call, &mut out)
  return out.code
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut at: usize = 0
  while at < a.length { if a[at] != b[at] { return false } at = at + 1 }
  return true
}

effect fn memoryFiles() -> () ! Failures ? &mut Allocator {
  let files = run MemoryFiles.make()
  run files.addFile(b"/a/b/seed.txt", b"seeded")
  let mut out = ops.outcome()
  let stat = run pathCall(ops.STAT, b"/a/b")
  run Testing.expect(run1(&files, &stat, &mut out) == 0 && (out.status.mode & 0o170000) == 0o040000, "addFile makes the directories above the file")

  let mut open = run pathCall(ops.OPEN, b"/a/b/new.txt")
  open.a = i32.toI64(OPEN_WRITE_ONLY | OPEN_CREATE | OPEN_TRUNCATE) open.b = 0o644
  out = ops.outcome()
  run Testing.expect(run1(&files, &open, &mut out) == 0 && out.count >= 1000, "open creates a file with a descriptor from 1000")
  let fd = i64.toI32(out.count)
  let mut text: [u8; 5] = [104, 101, 108, 108, 111]
  let mut write = ops.call(ops.WRITE)
  write.fd = fd write.buffer = Pointer.fromMutRef<u8>(&mut text[0]) write.length = 5
  out = ops.outcome()
  run Testing.expect(run1(&files, &write, &mut out) == 0 && out.count == 5, "a write at the current position")
  let mut close = ops.call(ops.CLOSE) close.fd = fd
  out = ops.outcome()
  run Testing.expect(run1(&files, &close, &mut out) == 0, "close")
  out = ops.outcome()
  run Testing.expect(run1(&files, &close, &mut out) == -9, "a second close is EBADF")

  let mut reopen = run pathCall(ops.OPEN, b"/a/b/new.txt")
  out = ops.outcome()
  run Testing.expect(run1(&files, &reopen, &mut out) == 0, "open for reading")
  let mut into: [u8; 8] = [0; 8]
  let mut read = ops.call(ops.READ)
  read.fd = i64.toI32(out.count) read.buffer = Pointer.fromMutRef<u8>(&mut into[0]) read.length = 8 read.position = 1
  out = ops.outcome()
  run Testing.expect(run1(&files, &read, &mut out) == 0 && out.count == 4 && into[0] == 101 && into[3] == 111, "a read at a position stops at the end")

  let scan = run pathCall(ops.SCANDIR, b"/a/b")
  out = ops.outcome()
  run Testing.expect(run1(&files, &scan, &mut out) == 0, "scandir")

  let mut rename = run pathCall(ops.RENAME, b"/a")
  run rename.dest.appendBytes(b"/c")
  out = ops.outcome()
  run Testing.expect(run1(&files, &rename, &mut out) == 0, "rename a directory")
  let moved = run pathCall(ops.STAT, b"/c/b/seed.txt")
  out = ops.outcome()
  run Testing.expect(run1(&files, &moved, &mut out) == 0 && out.status.size == 6, "what was below it moves with it")
  let gone = run pathCall(ops.STAT, b"/a/b/seed.txt")
  out = ops.outcome()
  run Testing.expect(run1(&files, &gone, &mut out) == -2, "the old name is gone")

  let rmdir = run pathCall(ops.RMDIR, b"/c/b")
  out = ops.outcome()
  run Testing.expect(run1(&files, &rmdir, &mut out) < 0, "rmdir of a directory with files fails")
  let relative = run pathCall(ops.REALPATH, b"c/./b/../b/seed.txt")
  out = ops.outcome()
  run Testing.expect(run1(&files, &relative, &mut out) == 0 && same(out.text.asSlice(), b"/c/b/seed.txt"), "a relative path is taken from /")
}

test effect fn memoryFilesTest() -> () ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  run memoryFiles() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rootedFiles() -> () ! Failures ? &mut Allocator {
  let files = RootedFiles.make(b"/tmp")
  let mut out = ops.outcome()
  let make = run pathCall(ops.MKDTEMP, b"/silkjs-rooted-")
  run Testing.expect(run1(&files, &make, &mut out) == 0, "mkdtemp under the root")
  let made = out.text.asSlice()
  run Testing.expect(made.length > 15 && made[0] == 47 && made[1] == 115, "the path it returns is inside the root, without it")
  let mut name = List<u8>.make()
  run name.appendBytes(made)
  let escape = run pathCall(ops.STAT, b"/../../tmp")
  out = ops.outcome()
  // `/../../tmp` stays inside the root: it is /tmp/tmp, not the host's /tmp.
  run Testing.expect(run1(&files, &escape, &mut out) == -2, ".. stops at the root")
  let real = run pathCall(ops.REALPATH, name.asSlice())
  out = ops.outcome()
  run Testing.expect(run1(&files, &real, &mut out) == 0 && same(out.text.asSlice(), name.asSlice()), "realpath loses the root")
  // symlink(target, link): the link is made inside the root, and the target kept as given.
  let link = run joined(name.asSlice(), b"/link")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run twoPathCall(ops.SYMLINK, b"/elsewhere", link.asSlice()), &mut out) == 0, "symlink under the root")
  let host = run joined(b"/tmp", link.asSlice())
  out = ops.outcome()
  run Testing.expect(run1(&OsFiles {}, &run pathCall(ops.READLINK, host.asSlice()), &mut out) == 0 && same(out.text.asSlice(), b"/elsewhere"), "the link is inside the root")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.UNLINK, link.asSlice()), &mut out) == 0, "unlink")
  let remove = run pathCall(ops.RMDIR, name.asSlice())
  out = ops.outcome()
  run Testing.expect(run1(&files, &remove, &mut out) == 0, "rmdir")
}

test effect fn rootedFilesTest() -> () ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rootedFiles() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn twoPathCall(op: i32, path: &[u8], dest: &[u8]) -> Call ! OutOfMemoryError ? &mut Allocator {
  let mut call = run pathCall(op, path)
  run call.dest.appendBytes(dest)
  return move call
}

effect fn joined(directory: &[u8], name: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut path = List<u8>.make()
  run path.appendBytes(directory)
  run path.appendBytes(name)
  return move path
}

effect fn grantedFiles() -> () ! Failures ? &mut Allocator {
  let os = OsFiles {}
  let mut out = ops.outcome()
  let make = run pathCall(ops.MKDTEMP, b"/tmp/silkjs-granted-XXXXXX")
  run Testing.expect(run1(&os, &make, &mut out) == 0, "mkdtemp")
  let mut root = List<u8>.make()
  run root.appendBytes(out.text.asSlice())
  let picked = run joined(root.asSlice(), b"/picked")
  let inner = run joined(root.asSlice(), b"/picked/inner")
  let other = run joined(root.asSlice(), b"/other")
  let link = run joined(root.asSlice(), b"/picked/out")
  out = ops.outcome() run Testing.expect(run1(&os, &run pathCall(ops.MKDIR, picked.asSlice()), &mut out) == 0, "mkdir picked")
  out = ops.outcome() run Testing.expect(run1(&os, &run pathCall(ops.MKDIR, inner.asSlice()), &mut out) == 0, "mkdir inner")
  out = ops.outcome() run Testing.expect(run1(&os, &run pathCall(ops.MKDIR, other.asSlice()), &mut out) == 0, "mkdir other")
  out = ops.outcome() run Testing.expect(run1(&os, &run twoPathCall(ops.SYMLINK, other.asSlice(), link.asSlice()), &mut out) == 0, "symlink out")

  let files = run GrantedFiles.make()
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.STAT, inner.asSlice()), &mut out) == -13, "nothing is reachable before a grant")
  run files.grant(picked.asSlice())
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.STAT, inner.asSlice()), &mut out) == 0, "below a granted directory")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.STAT, picked.asSlice()), &mut out) == 0, "the granted directory itself")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.STAT, other.asSlice()), &mut out) == -13, "a sibling is not granted")
  let escape = run joined(picked.asSlice(), b"/../other")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.STAT, escape.asSlice()), &mut out) == -13, ".. leaves the grant")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.STAT, link.asSlice()), &mut out) == -13, "a link does not reach outside")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.LSTAT, link.asSlice()), &mut out) == 0, "the link itself is inside")
  let outside = run joined(other.asSlice(), b"/link")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run twoPathCall(ops.SYMLINK, inner.asSlice(), outside.asSlice()), &mut out) == -13, "a link made outside the grant")
  let moved = run joined(other.asSlice(), b"/moved")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run twoPathCall(ops.RENAME, inner.asSlice(), moved.asSlice()), &mut out) == -13, "a rename out of the grant")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.STAT, b"picked"), &mut out) == -13, "relative paths are refused")
  let saved = run joined(other.asSlice(), b"/saved.txt")
  run files.grant(saved.asSlice())
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.STAT, saved.asSlice()), &mut out) == -2, "a granted file that does not exist yet")
  out = ops.outcome()
  run Testing.expect(run1(&files, &run pathCall(ops.STAT, other.asSlice()), &mut out) == -13, "granting a file grants not its directory")

  out = ops.outcome() drop run1(&os, &run pathCall(ops.UNLINK, link.asSlice()), &mut out)
  out = ops.outcome() drop run1(&os, &run pathCall(ops.RMDIR, inner.asSlice()), &mut out)
  out = ops.outcome() drop run1(&os, &run pathCall(ops.RMDIR, picked.asSlice()), &mut out)
  out = ops.outcome() drop run1(&os, &run pathCall(ops.RMDIR, other.asSlice()), &mut out)
  out = ops.outcome() drop run1(&os, &run pathCall(ops.RMDIR, root.asSlice()), &mut out)
}

test effect fn grantedFilesTest() -> () ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  run grantedFiles() |> Effect.provideMut<Allocator>(&mut allocator)
}
