//! A stale inspector socket in the project. An app run with `SILK_UI_INSPECT=1` listens on
//! `silk-ui-inspect.sock` in its working directory, the web project for a JavaScript app, and
//! removes it when it closes. An app that is killed leaves it behind, and this Silk's file
//! system then refuses to list the directory that holds it, so the next build stops with
//! "could not list a directory". [`clear`] removes the socket when no app answers on it.
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.text.string { String }

static if Intrinsic.targetOperatingSystem() != "windows"
  && Intrinsic.targetArchitecture() != "wasm32" {
  import silk.net.socket_native { ConnectOptions, Connection, NativeSocketError, connectUnixOwned }
  import silk.system.monotonic_clock { MonotonicClock }
  import silk.system.monotonic_clock_native { OsMonotonicClock }
  import silk.time.mark { Mark }

  unsafe extern "C" fn unlink(path: ?[*]const u8) -> i32
  unsafe extern "C" fn access(path: ?[*]const u8, mode: i32) -> i32
}

/// The socket name `SILK_UI_INSPECT=1` listens on.
pub const NAME: string = "silk-ui-inspect.sock"

/// Removes the inspector socket in `directory` (absolute) when one is there and no app answers
/// on it. Returns true when it removed one. A live app's socket is left alone.
pub effect fn clear(directory: string) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() != "windows"
    && Intrinsic.targetArchitecture() != "wasm32" {
    let mut path = run Bytes.copy(String.utf8Bytes(directory))
    if path.length() != 0 && path.asSlice()[path.length() - 1] != 47 {
      run path.append(b"/")
    }
    run path.append(String.utf8Bytes(NAME))
    let mut terminated = run Bytes.copy(path.asSlice())
    run terminated.append(b"\0")
    if unsafe access(Pointer.fromSlice(terminated.asSlice()), 0) != 0 {
      return false
    }
    let mut clock = OsMonotonicClock.make()
    let start = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    let probe = run Effect.result(
      connectUnixOwned(
        path.asSlice(),
        ConnectOptions.defaults(),
        Option<Mark>.some(MonotonicClock.deadlineAfter(&start, 200000000)),
      ),
    )
      |> Effect.provideMut<MonotonicClock>(&mut clock)
    match move probe {
      Result<Connection, NativeSocketError>.Success { value } => {
        // An app answers: it is running, and owns the socket.
        let mut live = move value
        drop run Effect.result(live.close())
        return false
      }
      Result<Connection, NativeSocketError>.Failure { error } => {
        drop error
      }
    }
    return unsafe unlink(Pointer.fromSlice(terminated.asSlice())) == 0
  } else {
    drop directory
    return false
  }
}
