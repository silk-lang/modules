/// The size an icon is rendered at to tell whether it paints only with `currentColor`.
const CLASSIFY_SIZE: u32 = 32

/// A resource that could not be defined: the data did not decode or parse.
pub struct ResourceError {}

/// A font family list.
struct FamilyList {
  id: u32,
  text: String,
  families: List<Family>,
}

fn isSpace(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

fn lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}

fn sameWord(bytes: &[u8], start: usize, end: usize, word: &[u8]) -> bool {
  if end - start != word.length {
    return false
  }
  let mut i: usize = 0
  while i < word.length {
    if lower(bytes[start + i]) != word[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn genericOf(bytes: &[u8], start: usize, end: usize) -> Option<Generic> {
  if sameWord(bytes, start, end, b"serif") {
    return Option<Generic>.Some { value: Generic.Serif }
  }
  if sameWord(bytes, start, end, b"sans-serif") {
    return Option<Generic>.Some { value: Generic.SansSerif }
  }
  if sameWord(bytes, start, end, b"monospace") {
    return Option<Generic>.Some { value: Generic.Monospace }
  }
  if sameWord(bytes, start, end, b"cursive") {
    return Option<Generic>.Some { value: Generic.Cursive }
  }
  if sameWord(bytes, start, end, b"fantasy") {
    return Option<Generic>.Some { value: Generic.Fantasy }
  }
  if sameWord(bytes, start, end, b"system-ui") {
    return Option<Generic>.Some { value: Generic.SystemUi }
  }
  // The names browsers took for the system font before `system-ui`, still first in most
  // stylesheets' font lists (Tailwind's, GitHub's): WebKit's and Blink's on macOS.
  if sameWord(bytes, start, end, b"-apple-system") || sameWord(bytes, start, end, b"blinkmacsystemfont") {
    return Option<Generic>.Some { value: Generic.SystemUi }
  }
  if sameWord(bytes, start, end, b"emoji") {
    return Option<Generic>.Some { value: Generic.Emoji }
  }
  if sameWord(bytes, start, end, b"math") {
    return Option<Generic>.Some { value: Generic.Math }
  }
  return uiGenericOf(bytes, start, end)
}

/// `ui-serif`, `ui-sans-serif`, `ui-monospace` and `ui-rounded`: the host's own families for
/// them when it configures any, then the plain generic they stand in for.
fn uiGenericOf(bytes: &[u8], start: usize, end: usize) -> Option<Generic> {
  if sameWord(bytes, start, end, b"ui-serif") {
    return Option<Generic>.Some { value: Generic.UiSerif }
  }
  if sameWord(bytes, start, end, b"ui-sans-serif") {
    return Option<Generic>.Some { value: Generic.UiSansSerif }
  }
  if sameWord(bytes, start, end, b"ui-monospace") {
    return Option<Generic>.Some { value: Generic.UiMonospace }
  }
  if sameWord(bytes, start, end, b"ui-rounded") {
    return Option<Generic>.Some { value: Generic.UiRounded }
  }
  return Option<Generic>.None
}

fn aliasOf(generic: Generic) -> Option<Generic> {
  return match generic {
    Generic.UiSerif => Option<Generic>.Some { value: Generic.Serif }
    Generic.UiSansSerif => Option<Generic>.Some { value: Generic.SystemUi }
    Generic.UiMonospace => Option<Generic>.Some { value: Generic.Monospace }
    Generic.UiRounded => Option<Generic>.Some { value: Generic.SystemUi }
    _ => Option<Generic>.None
  }
}

/// Parses CSS `font-family` text: comma-separated names, optionally quoted; unquoted generic
/// keywords become generic families, and a `ui-*` one is followed by the generic it aliases.
pub effect fn parseFamilies(text: &[u8], out: &mut List<Family>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  while at < text.length {
    let mut end = at
    while end < text.length && text[end] != 44 {
      end = end + 1
    }
    let mut start = at
    let mut stop = end
    while start < stop && isSpace(text[start]) {
      start = start + 1
    }
    while stop > start && isSpace(text[stop - 1]) {
      stop = stop - 1
    }
    let mut quoted = false
    if stop - start >= 2 && (text[start] == 34 || text[start] == 39)
      && text[stop - 1] == text[start] {
      start = start + 1
      stop = stop - 1
      quoted = true
    }
    if stop > start {
      let mut generic = Option<Generic>.None
      if !quoted {
        generic = genericOf(text, start, stop)
      }
      match generic {
        Option<Generic>.Some { value } => {
          run out.append(Family.generic(value))
          if let Option<Generic>.Some { value: alias } = aliasOf(value) {
            run out.append(Family.generic(alias))
          }
        }
        Option<Generic>.None => {
          let mut name = List<u8>.make()
          let mut i = start
          while i < stop {
            run name.append(text[i])
            i = i + 1
          }
          run out.append(run Family.named(name.asSlice()))
        }
      }
    }
    at = end + 1
  }
}

/// The font family lists defined so far.
pub struct Families {
  lists: List<FamilyList>,
  // The id `intern` gives the next text it has not met.
  nextNamed: u32,
}

/// The first family list id `intern` gives. Ids stay below 2^24 so a CSS number holds them.
const NAMED: u32 = 0xF00000

impl Families {
  pub fn make() -> Families {
    return Families { lists: List<FamilyList>.make(), nextNamed: NAMED }
  }

  /// The family list id for CSS `font-family` text, defined the first time the text is met.
  pub effect fn intern(self: &mut Self, text: string) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    let lists = self.lists.asSlice()
    let mut i: usize = 0
    while i < lists.length {
      if lists[i].id >= NAMED && String.view(&lists[i].text) == text {
        return lists[i].id
      }
      i = i + 1
    }
    let id = self.nextNamed
    self.nextNamed = id + 1
    run self.define(id, text)
    return id
  }

  /// Defines (or redefines) family list `id` from CSS `font-family` text.
  pub effect fn define(self: &mut Self, id: u32, text: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut families = List<Family>.make()
    run parseFamilies(String.utf8Bytes(text), &mut families)
    let copied = run String.copy(text)
    let lists = self.lists.asMutSlice()
    let mut i: usize = 0
    while i < lists.length {
      if lists[i].id == id {
        lists[i].families = move families
        lists[i].text = move copied
        return ()
      }
      i = i + 1
    }
    run self.lists.append(FamilyList { id: id, text: move copied, families: move families })
  }

  /// The `font-family` text family list `id` was defined from, if it is defined.
  pub fn text(self: &Self, id: u32) -> Option<string<'_>> {
    let lists = self.lists.asSlice()
    let mut i: usize = 0
    while i < lists.length {
      if lists[i].id == id {
        return Option<string<'_>>.some(String.view(&lists[i].text))
      }
      i = i + 1
    }
    return Option<string<'_>>.None
  }

  /// A copy of family list `id`, or `sans-serif` when it is not defined.
  pub effect fn copyOf(self: &Self, id: u32, out: &mut List<Family>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let lists = self.lists.asSlice()
    let mut i: usize = 0
    while i < lists.length {
      if lists[i].id == id {
        let families = lists[i].families.asSlice()
        let mut j: usize = 0
        while j < families.length {
          run out.append(run families[j].copy())
          j = j + 1
        }
        return ()
      }
      i = i + 1
    }
    run out.append(Family.generic(Generic.SansSerif))
  }
}

/// What a resource id names.
pub union Resource {
  Image { pub image: ImageId, pub width: u32, pub height: u32 },
  Icon { pub icon: IconId },
}

impl Copy for Resource {}

struct Entry {
  id: u32,
  resource: Resource,
}

// An icon's markup, kept to draw it again with page CSS on its root (`paintedIcon`).
struct Markup {
  id: u32,
  data: Bytes,
  /// The custom properties its `var()`s name (`--tone`), which page CSS on the inline
  /// `<svg>` supplies.
  variables: List<Bytes>,
}

/// The custom property declarations an inline `<svg>` node's markup reads, as the page cascade
/// resolves them for that node (`--tone:#123;`), and their key. Made for each frame.
/// `base` is the node's paint hash without the key, `mixed` with it.
pub struct IconVariables {
  pub slot: u32,
  pub key: u64,
  pub css: List<u8>,
  pub base: u64,
  pub mixed: u64,
}

/// An inline `<svg>` node's markup with page CSS rules resolved and injected onto its elements,
/// and its cache key.
pub struct StyledIconMarkup {
  pub slot: u32,
  pub resource: u32,
  pub revision: u64,
  pub key: u64,
  pub markup: List<u8>,
  pub base: u64,
  pub mixed: u64,
}

// Icon `id` drawn with the root paint keyed `key`; `icon` is the icon itself when that fails.
struct Painted {
  id: u32,
  key: u64,
  icon: IconId,
}

impl Copy for Painted {}

/// How many paints of one icon are kept; the oldest goes first.
const PAINTS_PER_ICON: usize = 4

impl Copy for Entry {}

struct IconHost<'a> {
  base: Url,
  fonts: &'a FontDatabase,
}

/// The icon host with `current` as `currentColor` and as CanvasText, the initial `color` of an
/// SVG's root, so that an icon inherits the node's color as an inline `<svg>` does.
fn hostOf<'h>(host: &'h IconHost<'_>, current: CssColor) -> Environment<'h, 'h> {
  let mut system = [CssColor.srgb(0.0, 0.0, 0.0, 1.0); 19]
  system[systemIndex(SystemColor.CanvasText)] = current
  let mut structure = StructureOptions.defaults()
  structure.policy.mode = ProcessingMode.Animated
  return Environment<'h, 'h> {
    base: &host.base,
    media: MediaEnvironment.headless(300.0, 150.0),
    colors: ColorContext.make(current, system),
    fontFamily: b"sans-serif",
    systemFonts: [b"16px sans-serif"; 6],
    cssLimits: Limits.make(),
    structure: move structure,
    fonts: host.fonts,
    styles: noHostStyles(),
  }
}

effect fn badUrl(error: UrlError) -> never
  ! ResourceError {
  drop error
  fail ResourceError {}
}

// The distinct names in `var(--name` references of `data`.
effect fn variableNames(data: &[u8]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<Bytes>.make()
  let mut at: usize = 0
  while at + 6 <= data.length {
    if data[at] == 118 && data[at + 1] == 97 && data[at + 2] == 114 && data[at + 3] == 40 {
      let mut start = at + 4
      while start < data.length && spaceByte(data[start]) { start = start + 1 }
      let mut end = start
      if end + 1 < data.length && data[end] == 45 && data[end + 1] == 45 {
        end = end + 2
        while end < data.length && nameByte(data[end]) { end = end + 1 }
      }
      if end > start + 2 {
        let name = Slice.view<u8>(data, start, end - start)
        let mut known = false
        let mut i: usize = 0
        while i < names.length() {
          if names.asSlice()[i].asSlice() == name { known = true }
          i = i + 1
        }
        if !known { run names.append(run Bytes.copy(name)) }
      }
      at = end
    } else {
      at = at + 1
    }
  }
  return move names
}

fn nameByte(c: u8) -> bool {
  return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c >= 128
}

// `data` with `css` first in the style of its root `<svg>`, or empty when it has no root tag.
effect fn withRootStyle(data: &[u8], css: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  let mut start: usize = 0
  let mut found = false
  while start + 5 <= data.length && !found {
    if data[start] == 60 && data[start + 1] == 115 && data[start + 2] == 118 && data[start + 3] == 103 && (spaceByte(data[start + 4]) || data[start + 4] == 62 || data[start + 4] == 47) {
      found = true
    } else {
      start = start + 1
    }
  }
  if !found { return move out }
  let afterName = start + 4
  // The root's style attribute, if it has one: where its value starts.
  let mut at = afterName
  let mut quote: u8 = 0
  let mut valueAt = usize.MAX
  while at < data.length && valueAt == usize.MAX {
    let c = data[at]
    if quote != 0 {
      if c == quote { quote = 0 }
    } else if c == 34 || c == 39 {
      quote = c
    } else if c == 62 {
      break
    } else if spaceByte(data[at - 1]) && at + 5 <= data.length && data[at] == 115 && data[at + 1] == 116 && data[at + 2] == 121 && data[at + 3] == 108 && data[at + 4] == 101 {
      let mut v = at + 5
      while v < data.length && spaceByte(data[v]) { v = v + 1 }
      if v < data.length && data[v] == 61 {
        v = v + 1
        while v < data.length && spaceByte(data[v]) { v = v + 1 }
        if v < data.length && (data[v] == 34 || data[v] == 39) { valueAt = v + 1 }
      }
    }
    at = at + 1
  }
  if valueAt != usize.MAX {
    run out.appendSlice(Slice.view<u8>(data, 0, valueAt))
    run out.appendSlice(css)
    run out.appendSlice(Slice.view<u8>(data, valueAt, data.length - valueAt))
  } else {
    run out.appendSlice(Slice.view<u8>(data, 0, afterName))
    run out.appendSlice(b" style=\"")
    run out.appendSlice(css)
    run out.append(34)
    run out.appendSlice(Slice.view<u8>(data, afterName, data.length - afterName))
  }
  return move out
}

fn spaceByte(c: u8) -> bool { return c == 32 || c == 9 || c == 10 || c == 13 }

const EMPTY_ICON: &'static [u8] = b"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'/>"

effect fn badSvg(error: RenderError) -> never
  ! ResourceError {
  drop error
  fail ResourceError {}
}

effect fn badImage<E>(error: E) -> never
  ! ResourceError {
  drop error
  fail ResourceError {}
}

effect fn noTile<E>(error: E) -> Option<AtlasTile> {
  drop error
  return Option<AtlasTile>.None
}

effect fn iconTileInViewport(
  icons: &mut IconCache,
  atlas: &mut Atlas,
  host: &Environment<'_, '_>,
  icon: IconId,
  width: u32,
  height: u32,
  viewportWidth: f64,
  viewportHeight: f64,
  style: IconStyle,
  time: f64,
) -> Option<AtlasTile>
  ! RenderError | AtlasError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  return Option<AtlasTile>.Some {
    value: run icons.iconInViewport(
      &mut atlas,
      host,
      icon,
      width,
      height,
      viewportWidth,
      viewportHeight,
      style,
      time,
    ),
  }
}

fn containsCurrentColor(data: &[u8]) -> bool {
  let needle = b"currentcolor"
  if data.length < needle.length {
    return false
  }
  let mut i: usize = 0
  let limit = data.length - needle.length
  while i <= limit {
    let c = lower(data[i])
    if c == 99 {
      let mut j: usize = 1
      while j < needle.length && lower(data[i + j]) == needle[j] {
        j = j + 1
      }
      if j == needle.length {
        return true
      }
    }
    i = i + 1
  }
  return false
}

effect fn unclassified(error: RenderError) -> bool {
  drop error
  return true
}

fn black() -> CssColor {
  return CssColor.srgb(0.0, 0.0, 0.0, 1.0)
}

effect fn imageTile(images: &mut ImageStore, atlas: &mut Atlas, id: ImageId) -> Option<AtlasTile>
  ! AtlasError | OutOfMemoryError
  ? &mut Allocator {
  return run images.tile(&mut atlas, id)
}

/// A cursor image: `width * height` RGBA pixels, not premultiplied, `scale` pixels per CSS
/// pixel.
pub struct CursorPixels {
  pub width: u32,
  pub height: u32,
  pub pixels: Bytes,
  pub scale: f32,
}

effect fn noPixmap(error: RenderError) -> Option<Pixmap> {
  drop error
  return Option<Pixmap>.None
}

fn capped(value: u32) -> u32 {
  return if value > 255 { 255 } else { value }
}

/// Premultiplied RGBA as straight RGBA.
effect fn straight(premultiplied: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = run Bytes.copy(premultiplied)
  let pixels = out.asMutSlice()
  let mut i: usize = 0
  while i + 3 < pixels.length {
    let a = u8.toU32(pixels[i + 3])
    if a > 0 && a < 255 {
      pixels[i] = u32.toU8(capped((u8.toU32(pixels[i]) * 255 + a / 2) / a))
      pixels[i + 1] = u32.toU8(capped((u8.toU32(pixels[i + 1]) * 255 + a / 2) / a))
      pixels[i + 2] = u32.toU8(capped((u8.toU32(pixels[i + 2]) * 255 + a / 2) / a))
    }
    i = i + 4
  }
  return move out
}

/// The first resource id the tree gives the images stylesheets name with `url()`. Clients
/// number their own resources from 1, and host font faces start at 0x80000000.
pub const CSS_IMAGE_BASE: u32 = 0x7F000000

/// Where a stylesheet image is: not asked for yet, asked for, loaded, or failed.
pub enum CssImageState { Wanted, Asked, Loaded, Failed }

/// An image a stylesheet names, as resource `CSS_IMAGE_BASE` plus its index.
pub struct CssImage {
  pub url: String,
  pub state: CssImageState,
}

/// The first resource id of the images `filter()` makes from loaded images.
pub const FILTERED_IMAGE_BASE: u32 = 0x7E000000

/// A `filter()` image: `source` filtered by the effects that hash to `key`, as resource `id`.
struct Filtered {
  source: u32,
  key: u64,
  id: u32,
}

impl Copy for Filtered {}

/// Images and icons by client resource id.
pub struct Resources<'a> {
  entries: List<Entry>,
  filtered: List<Filtered>,
  /// Images stylesheets name, in the order paint first met them.
  pub cssImages: List<CssImage>,
  pub images: ImageStore,
  pub icons: IconCache,
  host: IconHost<'a>,
  resolver: DataOnly,
  markup: List<Markup>,
  painted: List<Painted>,
  /// This frame's custom properties of inline svgs whose markup reads some.
  pub variables: List<IconVariables>,
  /// Page-CSS-styled markup overrides for inline `<svg>` nodes drawn via lib-svg.
  pub styledIcons: List<StyledIconMarkup>,
}

impl<'a> Resources<'a> {
  pub effect fn make(fonts: &'a FontDatabase) -> Resources<'a>
    ! ResourceError | OutOfMemoryError
    ? &mut Allocator {
    let base = run Effect.catch<UrlError>(Url.fromFilePath(b"/ui/icons/icon.svg"), badUrl)
    return Resources<'a> {
      entries: List<Entry>.make(),
      filtered: List<Filtered>.make(),
      cssImages: List<CssImage>.make(),
      images: ImageStore.make(),
      icons: IconCache.make(IconOptions.default()),
      host: IconHost<'a> { base: move base, fonts: fonts },
      resolver: DataOnly.make(ResourceLimits.defaults()),
      markup: List<Markup>.make(),
      painted: List<Painted>.make(),
      variables: List<IconVariables>.make(),
      styledIcons: List<StyledIconMarkup>.make(),
    }
  }

  /// The resource id of stylesheet image `url`, asked for in the next `takeLoads` the first
  /// time it is met.
  pub effect fn cssImage(self: &mut Self, url: &[u8]) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    let images = self.cssImages.asSlice()
    let mut i: usize = 0
    while i < images.length {
      if sameBytes(String.utf8Bytes(String.view(&images[i].url)), url) {
        return CSS_IMAGE_BASE + usize.toU32(i)
      }
      i = i + 1
    }
    let text = match String.fromBytes(run Bytes.copy(url)) {
      Result.Success { value } => move value
      _ => String.make()
    }
    run self.cssImages.append(CssImage { url: move text, state: CssImageState.Wanted })
    return CSS_IMAGE_BASE + usize.toU32(self.cssImages.length() - 1)
  }

  /// Records that stylesheet image `id` loaded or failed. False for other ids.
  pub fn settleCssImage(self: &mut Self, id: u32, ok: bool) -> bool {
    if id < CSS_IMAGE_BASE || u32.toUsize(id - CSS_IMAGE_BASE) >= self.cssImages.length() {
      return false
    }
    let images = self.cssImages.asMutSlice()
    images[u32.toUsize(id - CSS_IMAGE_BASE)].state = if ok { CssImageState.Loaded } else { CssImageState.Failed }
    return true
  }

  /// The decoded samples of stylesheet image `url`, once it loaded as a raster image.
  pub fn cssImageNamed(self: &Self, url: &[u8]) -> Option<&Image> {
    let images = self.cssImages.asSlice()
    let mut i: usize = 0
    while i < images.length {
      if sameBytes(String.utf8Bytes(String.view(&images[i].url)), url) {
        return match self.get(CSS_IMAGE_BASE + usize.toU32(i)) {
          Option<Resource>.Some { value } => match value {
            Resource.Image { image, .. } => self.images.image(image)
            _ => Option<&Image>.None
          }
          Option<Resource>.None => Option<&Image>.None
        }
      }
      i = i + 1
    }
    return Option<&Image>.None
  }

  /// The resource defined as `id`.
  pub fn get(self: &Self, id: u32) -> Option<Resource> {
    let entries = self.entries.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      if entries[i].id == id {
        return Option<Resource>.Some { value: entries[i].resource }
      }
      i = i + 1
    }
    return Option<Resource>.None
  }

  effect fn put(self: &mut Self, id: u32, resource: Resource) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let entries = self.entries.asMutSlice()
    let mut i: usize = 0
    while i < entries.length {
      if entries[i].id == id {
        entries[i].resource = resource
        return ()
      }
      i = i + 1
    }
    run self.entries.append(Entry { id: id, resource: resource })
  }

  /// Decodes a PNG or JPEG file as image `id`.
  pub effect fn defineImage(self: &mut Self, atlas: &mut Atlas, id: u32, data: &[u8]) -> ()
    ! ResourceError | OutOfMemoryError
    ? &mut Allocator {
    let image = run Effect.catchAll(decode.decodeSrgb(data), badImage)
    run self.defineDecoded(&mut atlas, id, move image)
  }

  /// Installs already decoded, premultiplied sRGB pixels. Replacing an image frees its old tile.
  pub effect fn defineDecoded(self: &mut Self, atlas: &mut Atlas, id: u32, image: Image) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let width = image.width()
    let height = image.height()
    let stored = run self.images.insert(move image)
    run self.release(&mut atlas, id)
    run self.put(id, Resource.Image { image: stored, width: width, height: height })
  }

  /// Removes a client resource and releases decoded image storage and its atlas tile.
  pub effect fn release(self: &mut Self, atlas: &mut Atlas, id: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < self.entries.length() {
      if self.entries.asSlice()[i].id == id {
        let old = self.entries.remove(i)
        match old.resource {
          Resource.Image { image, .. } => {
            drop run self.images.remove(&mut atlas, image)
          }
          Resource.Icon { icon } => {
            run self.icons.unregister(&mut atlas, icon)
            run self.forgetPaints(&mut atlas, id, icon, usize.MAX)
            let mut m: usize = 0
            while m < self.markup.length() {
              if self.markup.asSlice()[m].id == id { drop self.markup.remove(m) } else { m = m + 1 }
            }
          }
        }
        return ()
      }
      i = i + 1
    }
  }

  /// Parses an SVG file as icon `id`.
  pub effect fn defineIcon(self: &mut Self, atlas: &mut Atlas, id: u32, data: &[u8]) -> ()
    ! ResourceError | OutOfMemoryError
    ? &mut Allocator {
    let icon = run self.registerIcon(data)
    run self.release(&mut atlas, id)
    run self.put(id, Resource.Icon { icon: icon })
    run self.markup.append(Markup { id: id, data: run Bytes.copy(data), variables: run variableNames(data) })
  }

  // Parses and classifies `data`; an SVG that draws nothing, such as a zero-sized sprite of
  // symbols, is an empty icon.
  effect fn registerIcon(self: &mut Self, data: &[u8]) -> IconId
    ! ResourceError | OutOfMemoryError
    ? &mut Allocator {
    let host = hostOf(&self.host, black())
    let white = hostOf(&self.host, CssColor.srgb(1.0, 1.0, 1.0, 1.0))
    // An SVG that draws nothing, such as a zero-sized sprite of symbols, is an empty icon.
    let registered = run Effect.result(self.icons.register(data, &host))
      |> Effect.provideMut<Resolver>(&mut self.resolver)
    let icon = match move registered {
      Result<IconId, RenderError | OutOfMemoryError>.Success { value } => value
      Result<IconId, RenderError | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError failure => { fail move failure }
        RenderError _ => run Effect.catch<RenderError>(self.icons.register(EMPTY_ICON, &host), badSvg)
          |> Effect.provideMut<Resolver>(&mut self.resolver)
      }
    }
    if containsCurrentColor(data) {
      drop run Effect.catch<RenderError>(
        self.icons.classify(icon, CLASSIFY_SIZE, &host, &white),
        unclassified,
      )
        |> Effect.provideMut<Resolver>(&mut self.resolver)
    } else {
      self.icons.setTinted(icon, false)
    }
    drop host
    drop white
    return icon
  }

  /// The custom properties the markup of icon `id` reads, none when it is no icon.
  pub fn markupVariables(self: &Self, id: u32) -> &[Bytes] {
    let markup = self.markup.asSlice()
    let mut i: usize = 0
    while i < markup.length {
      if markup[i].id == id { return markup[i].variables.asSlice() }
      i = i + 1
    }
    return &[]
  }

  /// Whether any icon's markup reads custom properties.
  pub fn readsVariables(self: &Self) -> bool {
    let markup = self.markup.asSlice()
    let mut i: usize = 0
    while i < markup.length {
      if markup[i].variables.length() != 0 { return true }
      i = i + 1
    }
    return false
  }

  /// This frame's custom properties for the inline svg at `slot`.
  pub fn iconVariables(self: &Self, slot: u32) -> Option<&IconVariables> {
    let all = self.variables.asSlice()
    let mut i: usize = 0
    while i < all.length {
      if all[i].slot == slot { return Option<&IconVariables>.some(&all[i]) }
      i = i + 1
    }
    return Option<&IconVariables>.None
  }

  /// The raw SVG markup of icon `id`, or empty when not registered as an icon.
  pub fn rawMarkup(self: &Self, id: u32) -> &[u8] {
    let markup = self.markup.asSlice()
    let mut i: usize = 0
    while i < markup.length {
      if markup[i].id == id { return markup[i].data.asSlice() }
      i = i + 1
    }
    return b""
  }

  /// Marks any cached page-CSS-styled markup entry for `slot` dirty so the next sync re-resolves it.
  pub fn invalidateStyledIcon(self: &mut Self, slot: u32) -> () {
    let all = self.styledIcons.asMutSlice()
    let mut lo: usize = 0
    let mut hi: usize = all.length
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      if all[mid].slot < slot {
        lo = mid + 1
      } else if all[mid].slot > slot {
        hi = mid
      } else {
        all[mid].revision = 0
        return ()
      }
    }
  }

  /// The revision of the cached styled markup entry for `slot` and `resource`, or 0 when absent or dirty.
  pub fn styledIconRevision(self: &Self, slot: u32, resource: u32) -> u64 {
    let all = self.styledIcons.asSlice()
    let mut lo: usize = 0
    let mut hi: usize = all.length
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      if all[mid].slot < slot {
        lo = mid + 1
      } else if all[mid].slot > slot {
        hi = mid
      } else {
        return if all[mid].resource == resource { all[mid].revision } else { 0 }
      }
    }
    return 0
  }

  /// The page-CSS-styled markup override for the inline svg at `slot`, if any.
  pub fn styledIcon(self: &Self, slot: u32, resource: u32) -> Option<&StyledIconMarkup> {
    let all = self.styledIcons.asSlice()
    let mut i: usize = 0
    while i < all.length {
      if all[i].slot == slot && all[i].resource == resource && all[i].markup.length() != 0 {
        return Option<&StyledIconMarkup>.some(&all[i])
      }
      i = i + 1
    }
    return Option<&StyledIconMarkup>.None
  }

  /// Icon `id` rendered from pre-styled markup `data` (and optional root `css`), keyed `key`.
  pub effect fn paintedIconFromMarkup(
    self: &mut Self,
    atlas: &mut Atlas,
    id: u32,
    key: u64,
    data: &[u8],
    css: &[u8],
  ) -> Option<IconId>
    ! OutOfMemoryError
    ? &mut Allocator {
    let base = match self.get(id) {
      Option<Resource>.Some { value: Resource.Icon { icon } } => icon
      _ => { return Option<IconId>.None }
    }
    let painted = self.painted.asSlice()
    let mut i: usize = 0
    let mut count: usize = 0
    while i < painted.length {
      if painted[i].id == id {
        if painted[i].key == key { return Option<IconId>.some(painted[i].icon) }
        count = count + 1
      }
      i = i + 1
    }
    if count >= PAINTS_PER_ICON { run self.forgetPaints(&mut atlas, id, base, 1) }
    let mut styled = List<u8>.make()
    let source = if css.length != 0 {
      styled = run withRootStyle(data, css)
      styled.asSlice()
    } else {
      data
    }
    let mut made = base
    if source.length != 0 {
      let registered = run Effect.result(self.registerIcon(source))
      match move registered {
        Result<IconId, ResourceError | OutOfMemoryError>.Success { value } => { made = value }
        Result<IconId, ResourceError | OutOfMemoryError>.Failure { error } => match move error {
          OutOfMemoryError failure => { fail move failure }
          ResourceError _ => {}
        }
      }
    }
    run self.painted.append(Painted { id: id, key: key, icon: made })
    return Option<IconId>.some(made)
  }

  /// Icon `id` with `css`, declarations keyed `key`, on its root's style: page CSS on an inline
  /// `<svg>` beats the presentation attributes of its root. The icon itself when its markup
  /// does not take them; None when `id` is no icon.
  pub effect fn paintedIcon(self: &mut Self, atlas: &mut Atlas, id: u32, key: u64, css: &[u8]) -> Option<IconId>
    ! OutOfMemoryError
    ? &mut Allocator {
    let base = match self.get(id) {
      Option<Resource>.Some { value: Resource.Icon { icon } } => icon
      _ => { return Option<IconId>.None }
    }
    let painted = self.painted.asSlice()
    let mut i: usize = 0
    let mut count: usize = 0
    while i < painted.length {
      if painted[i].id == id {
        if painted[i].key == key { return Option<IconId>.some(painted[i].icon) }
        count = count + 1
      }
      i = i + 1
    }
    if count >= PAINTS_PER_ICON { run self.forgetPaints(&mut atlas, id, base, 1) }
    let mut styled = List<u8>.make()
    let markup = self.markup.asSlice()
    i = 0
    while i < markup.length {
      if markup[i].id == id { styled = run withRootStyle(markup[i].data.asSlice(), css) }
      i = i + 1
    }
    let mut made = base
    if styled.length() != 0 {
      let registered = run Effect.result(self.registerIcon(styled.asSlice()))
      match move registered {
        Result<IconId, ResourceError | OutOfMemoryError>.Success { value } => { made = value }
        Result<IconId, ResourceError | OutOfMemoryError>.Failure { error } => match move error {
          OutOfMemoryError failure => { fail move failure }
          ResourceError _ => {}
        }
      }
    }
    run self.painted.append(Painted { id: id, key: key, icon: made })
    return Option<IconId>.some(made)
  }

  // Drops up to `limit` of the paints of icon `id`, oldest first.
  effect fn forgetPaints(self: &mut Self, atlas: &mut Atlas, id: u32, base: IconId, limit: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut left = limit
    let mut i: usize = 0
    while i < self.painted.length() && left > 0 {
      let entry = self.painted.asSlice()[i]
      if entry.id == id {
        drop self.painted.remove(i)
        if entry.icon.index != base.index { run self.icons.unregister(&mut atlas, entry.icon) }
        left = left - 1
      } else {
        i = i + 1
      }
    }
  }

  /// The tile of `icon` at `width` x `height` device pixels, or None when it cannot be drawn:
  /// a mask to tint with `color` when the icon paints only with `currentColor`
  /// ([`Resources.tinted`]), otherwise its own colors with `color` as `currentColor`.
  pub effect fn iconTile(
    self: &mut Self,
    atlas: &mut Atlas,
    icon: IconId,
    width: u32,
    height: u32,
    time: f64,
    color: Rgba<f32>,
  ) -> Option<AtlasTile>
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.iconTileInViewport(&mut atlas, icon, width, height, 0.0, 0.0, time, color)
  }

  /// Like [`Resources.iconTile`], with positive `viewportWidth`/`viewportHeight` (CSS pixels)
  /// overriding the root `<svg>`'s CSS viewport without re-parsing its markup.
  pub effect fn iconTileInViewport(
    self: &mut Self,
    atlas: &mut Atlas,
    icon: IconId,
    width: u32,
    height: u32,
    viewportWidth: f64,
    viewportHeight: f64,
    time: f64,
    color: Rgba<f32>,
  ) -> Option<AtlasTile>
    ! OutOfMemoryError
    ? &mut Allocator {
    let tinted = self.icons.tinted(icon)
    let current = if tinted {
      black()
    } else {
      CssColor.srgb(f32.toF64(color.r), f32.toF64(color.g), f32.toF64(color.b), f32.toF64(color.a))
    }
    let style = if tinted {
      IconStyle.Mask
    } else {
      IconStyle.Color
    }
    let host = hostOf(&self.host, current)
    let tile = run Effect.catchAll(
      iconTileInViewport(
        &mut self.icons,
        &mut atlas,
        &host,
        icon,
        width,
        height,
        viewportWidth,
        viewportHeight,
        style,
        time,
      ),
      noTile,
    )
      |> Effect.provideMut<Resolver>(&mut self.resolver)
    drop host
    return tile
  }

  /// Width over height of `icon`'s own viewport, or 0 when it is unknown.
  pub fn iconRatio(self: &Self, icon: IconId) -> f64 {
    return self.icons.ratio(icon)
  }

  /// Whether `icon` is a left-anchored `xMin* slice` SVG whose narrower boxes are exact crops.
  pub fn iconXMinSlice(self: &Self, icon: IconId) -> bool {
    return self.icons.xMinSlice(icon)
  }

  /// The `width` `icon`'s root gives in pixels, 0 where it gives none.
  pub fn iconWidth(self: &Self, icon: IconId) -> f64 {
    return self.icons.width(icon)
  }

  /// The `height` `icon`'s root gives in pixels, 0 where it gives none.
  pub fn iconHeight(self: &Self, icon: IconId) -> f64 {
    return self.icons.height(icon)
  }

  /// Whether `icon` paints only with `currentColor`, so its tile is a mask to tint.
  pub fn tinted(self: &Self, icon: IconId) -> bool {
    return self.icons.tinted(icon)
  }

  /// Resource `id` as cursor pixels: an image at its own size, an icon at its own size (32
  /// pixels a side when it gives none) times `scale`. None when it is not loaded or a side
  /// passes 256 pixels.
  pub effect fn cursorPixels(self: &mut Self, id: u32, scale: f32) -> Option<CursorPixels>
    ! OutOfMemoryError
    ? &mut Allocator {
    match self.get(id) {
      Option<Resource>.Some { value: Resource.Image { image, width, height } } => {
        if width > 256 || height > 256 {
          return Option<CursorPixels>.None
        }
        return match self.images.image(image) {
          Option<&Image>.Some { value } => Option<CursorPixels>.Some {
            value: CursorPixels { width: width, height: height, pixels: run straight(value.data()), scale: 1.0 },
          }
          _ => Option<CursorPixels>.None
        }
      }
      Option<Resource>.Some { value: Resource.Icon { icon } } => {
        let ownWidth = self.icons.width(icon)
        let ownHeight = self.icons.height(icon)
        let ratio = self.icons.ratio(icon)
        let mut w = if ownWidth > 0.0 { ownWidth } else if ownHeight > 0.0 && ratio > 0.0 { ownHeight * ratio } else { 32.0 }
        let mut h = if ownHeight > 0.0 { ownHeight } else if ratio > 0.0 { w / ratio } else { 32.0 }
        w = w * f32.toF64(scale)
        h = h * f32.toF64(scale)
        if w < 1.0 || h < 1.0 || w > 256.0 || h > 256.0 {
          return Option<CursorPixels>.None
        }
        let width = f64.toU32(f64.ceil(w))
        let height = f64.toU32(f64.ceil(h))
        let host = hostOf(&self.host, black())
        let rendered = run Effect.catch<RenderError>(self.icons.rendered(&host, icon, width, height), noPixmap)
          |> Effect.provideMut<Resolver>(&mut self.resolver)
        drop host
        return match &rendered {
          Option<Pixmap>.Some { value } => Option<CursorPixels>.Some {
            value: CursorPixels { width: width, height: height, pixels: run straight(value.data()), scale: scale },
          }
          _ => Option<CursorPixels>.None
        }
      }
      _ => {
        return Option<CursorPixels>.None
      }
    }
  }

  /// Resource `id` as premultiplied sRGB RGBA8 pixels at its natural size: a loaded bitmap
  /// image, or an SVG icon rasterized at its own width and height (clamped to 4096px per side).
  pub effect fn resourcePixels(self: &mut Self, id: u32) -> Option<Image>
    ! OutOfMemoryError
    ? &mut Allocator {
    match self.get(id) {
      Option<Resource>.Some { value: Resource.Image { image, .. } } => {
        return match self.images.image(image) {
          Option<&Image>.Some { value } => Option<Image>.some(run value.copy())
          _ => Option<Image>.None
        }
      }
      Option<Resource>.Some { value: Resource.Icon { icon } } => {
        let ownWidth = self.icons.width(icon)
        let ownHeight = self.icons.height(icon)
        let ratio = self.icons.ratio(icon)
        let mut w = if ownWidth > 0.0 { ownWidth } else if ownHeight > 0.0 && ratio > 0.0 { ownHeight * ratio } else { 300.0 }
        let mut h = if ownHeight > 0.0 { ownHeight } else if ratio > 0.0 { w / ratio } else { 150.0 }
        if w > 4096.0 {
          h = h * (4096.0 / w)
          w = 4096.0
        }
        if h > 4096.0 {
          w = w * (4096.0 / h)
          h = 4096.0
        }
        let width = f64.toU32(f64.max(1.0, f64.ceil(w)))
        let height = f64.toU32(f64.max(1.0, f64.ceil(h)))
        let host = hostOf(&self.host, black())
        let rendered = run Effect.catch<RenderError>(self.icons.rendered(&host, icon, width, height), noPixmap)
          |> Effect.provideMut<Resolver>(&mut self.resolver)
        drop host
        if let Option<Pixmap>.Some { value: pixmap } = &rendered {
          let made = run Effect.result(Image.make(width, height))
          if let Result.Success { value } = move made {
            let mut out = move value
            let src = pixmap.data()
            let dst = out.dataMut()
            let len = if src.length < dst.length { src.length } else { dst.length }
            let mut i: usize = 0
            while i < len {
              dst[i] = src[i]
              i = i + 1
            }
            return Option<Image>.some(move out)
          }
        }
        return Option<Image>.None
      }
      _ => {
        return Option<Image>.None
      }
    }
  }

  /// The tile of `image`, or None when it cannot be placed.
  /// Image resource `source` with `groups` applied in order (in its own pixels, clipped to its
  /// size), made the first time and kept: a `filter()` image filters once, not every frame.
  /// None while `source` is not a loaded bitmap.
  pub effect fn filteredImage(self: &mut Self, atlas: &mut Atlas, source: u32, groups: &[LayerEffects]) -> Option<Resource>
    ! OutOfMemoryError
    ? &mut Allocator {
    let key = effectsKey(groups)
    let made = self.filtered.asSlice()
    let mut i: usize = 0
    while i < made.length {
      if made[i].source == source && made[i].key == key { return self.get(made[i].id) }
      i = i + 1
    }
    let stored = match self.get(source) {
      Option<Resource>.Some { value } => match value {
        Resource.Image { image, .. } => image
        _ => { return Option<Resource>.None }
      }
      Option<Resource>.None => { return Option<Resource>.None }
    }
    let original = match self.images.image(stored) {
      Option<&Image>.Some { value } => value
      Option<&Image>.None => { return Option<Resource>.None }
    }
    let width = original.width()
    let height = original.height()
    let mut bytes = List<u8>.make()
    run bytes.appendBytes(original.data())
    let mut pixels = Pixmap.fromBytes(width, height, move bytes)
    run applyGroups(&mut pixels, groups)
    let mut result = run original.copy()
    let out = result.dataMut()
    let filteredBytes = pixels.data()
    let mut b: usize = 0
    while b < out.length {
      out[b] = filteredBytes[b]
      b = b + 1
    }
    let id = FILTERED_IMAGE_BASE + usize.toU32(self.filtered.length())
    run self.defineDecoded(&mut atlas, id, move result)
    run self.filtered.append(Filtered { source: source, key: key, id: id })
    return self.get(id)
  }

  pub effect fn imageTile(self: &mut Self, atlas: &mut Atlas, image: ImageId) -> Option<AtlasTile>
    ! OutOfMemoryError
    ? &mut Allocator {
    return run Effect.catch<AtlasError>(imageTile(&mut self.images, &mut atlas, image), noTile)
  }
}

fn sameBytes(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn effectsKey(groups: &[LayerEffects]) -> u64 {
  let seed = Hash.seed(0x6a09e667f3bcc908)
  let mut h = Hash.mix(&seed, usize.toU64(groups.length))
  let mut g: usize = 0
  while g < groups.length {
    let e = groups[g]
    h = Hash.combine(h, u32.toU64(f32.toBits(e.blur)))
    let mut i: usize = 0
    while i < 20 {
      h = Hash.combine(h, u32.toU64(f32.toBits(e.color[i])))
      i = i + 1
    }
    h = Hash.combine(h, u32.toU64(f32.toBits(e.shadow.x)))
    h = Hash.combine(h, u32.toU64(f32.toBits(e.shadow.y)))
    h = Hash.combine(h, u32.toU64(f32.toBits(e.shadow.sigma)))
    h = Hash.combine(h, u32.toU64(f32.toBits(e.shadow.color.r)))
    h = Hash.combine(h, u32.toU64(f32.toBits(e.shadow.color.g)))
    h = Hash.combine(h, u32.toU64(f32.toBits(e.shadow.color.b)))
    h = Hash.combine(h, u32.toU64(f32.toBits(e.shadow.color.a)))
    g = g + 1
  }
  return h
}

/// The CPU renderer's filter steps (blur, color matrix, drop shadow) for each group in order.
effect fn applyGroups(pixels: &mut Pixmap, groups: &[LayerEffects]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let width = pixels.width()
  let height = pixels.height()
  let region = Region.make(0, 0, width, height)
  let mut g: usize = 0
  while g < groups.length {
    let effects = groups[g]
    if effects.blur > 0.0 {
      let plan = run BlurPlan.make(f32.toF64(effects.blur))
      let mut out = run Pixmap.make(width, height)
      run filtering.gaussianBlur(&mut out, &pixels.*, &plan, &plan, region)
      pixels.* = move out
    }
    if effects.hasColor() {
      let mut out = run Pixmap.make(width, height)
      filtering.colorMatrix(&mut out, &pixels.*, effects.matrix(), region)
      pixels.* = move out
    }
    if effects.hasShadow() {
      let mut shadow = run Pixmap.make(width, height)
      let mut moved = run Pixmap.make(width, height)
      if effects.shadow.sigma > 0.0 {
        let plan = run BlurPlan.make(f32.toF64(effects.shadow.sigma))
        run filtering.gaussianBlur(&mut moved, &pixels.*, &plan, &plan, region)
        filtering.colorMatrix(&mut shadow, &moved, effects.shadowMatrix(), region)
      } else {
        filtering.colorMatrix(&mut shadow, &pixels.*, effects.shadowMatrix(), region)
      }
      filtering.offset(&mut moved, &shadow, f32.toI32(f32.round(effects.shadow.x)), f32.toI32(f32.round(effects.shadow.y)), region)
      filtering.mergeOver(&mut moved, &pixels.*, region)
      pixels.* = move moved
    }
    g = g + 1
  }
}
