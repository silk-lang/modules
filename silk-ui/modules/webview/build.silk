import silk.build.plan { Framework, Plan }
import silk.build.step { sourcePath }

// macOS compiles the WKWebView bridge into every program that depends on this package and links
// WebKit. Its views live in platform-window's AppKit windows and it calls that bridge
// (silk_macos_metal_layer, silk_macos_wake), so a macOS program using it also depends on
// platform-window, as it must to have a window. Windows and Linux run the headless backend.
static fn plan() -> Plan {
  let mut plan = Plan.empty()
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan
      |> Plan.compileNative(
        "objc",
        sourcePath("native/macos/bridge.m"),
        &[
          "-fobjc-arc",
          "-fblocks",
          "-O2",
          "-Wall",
          "-Wextra",
          "-Werror",
          "-Wno-unused-parameter",
          "-mmacosx-version-min=14.0",
        ],
        &[],
      )
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("WebKit", Framework.make())
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("Cocoa", Framework.make())
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("QuartzCore", Framework.make())
  }
  return plan
}

pub const PLAN: Plan = plan()
