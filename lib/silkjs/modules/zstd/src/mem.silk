//! Unchecked little-endian memory access and copies for the Zstandard port.
//!
//! Every function here is `unsafe`: the caller proves that the bytes it names are inside a live
//! allocation. Positions are a base pointer and a `usize` offset, as the reference uses a base
//! pointer and an index.
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize

pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?[*]mut u8
pub unsafe extern "C" fn malloc(size: usize) -> ?[*]mut u8
pub unsafe extern "C" fn free(pointer: ?[*]mut u8) -> ()
pub unsafe extern "C" fn memcpy(to: [*]mut u8, from: [*]const u8, count: usize) -> [*]mut u8
pub unsafe extern "C" fn memmove(to: [*]mut u8, from: [*]const u8, count: usize) -> [*]mut u8
pub unsafe extern "C" fn memset(to: [*]mut u8, value: i32, count: usize) -> [*]mut u8

@inlineAlways
pub unsafe fn ro(p: [*]mut u8) -> [*]const u8 { return unsafe Intrinsic.pointerRequalify<[*]mut u8, [*]const u8>(p) }
@inlineAlways
pub unsafe fn add(p: [*]mut u8, n: usize) -> [*]mut u8 { return unsafe Intrinsic.pointerRequalify<*mut u8, [*]mut u8>(unsafe Pointer.atMut<u8>(p, n)) }
@inlineAlways
pub unsafe fn addc(p: [*]const u8, n: usize) -> [*]const u8 { return unsafe Intrinsic.pointerRequalify<*const u8, [*]const u8>(unsafe Pointer.at<u8>(p, n)) }

@inlineAlways
pub unsafe fn r8(p: [*]const u8, at: usize) -> u8 { return unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(p, at)) }
@inlineAlways
pub unsafe fn r16(p: [*]const u8, at: usize) -> u16 { return unsafe Pointer.readUnaligned<u16>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u16>(unsafe Pointer.at<u8>(p, at))) }
@inlineAlways
pub unsafe fn r32(p: [*]const u8, at: usize) -> u32 { return unsafe Pointer.readUnaligned<u32>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u32>(unsafe Pointer.at<u8>(p, at))) }
@inlineAlways
pub unsafe fn r64(p: [*]const u8, at: usize) -> u64 { return unsafe Pointer.readUnaligned<u64>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(unsafe Pointer.at<u8>(p, at))) }
@inlineAlways
pub unsafe fn w8(p: [*]mut u8, at: usize, v: u8) -> () { unsafe Pointer.write<u8>(unsafe Pointer.atMut<u8>(p, at), v) }
@inlineAlways
pub unsafe fn w16(p: [*]mut u8, at: usize, v: u16) -> () { unsafe Pointer.writeUnaligned<u16>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u16>(unsafe Pointer.atMut<u8>(p, at)), v) }
@inlineAlways
pub unsafe fn w32(p: [*]mut u8, at: usize, v: u32) -> () { unsafe Pointer.writeUnaligned<u32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u32>(unsafe Pointer.atMut<u8>(p, at)), v) }
@inlineAlways
pub unsafe fn w64(p: [*]mut u8, at: usize, v: u64) -> () { unsafe Pointer.writeUnaligned<u64>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u64>(unsafe Pointer.atMut<u8>(p, at)), v) }

/// Returns the position of the highest set bit of `v`, which must not be 0.
@inlineAlways
pub fn highbit32(v: u32) -> u32 { return 31 - u32.leadingZeros(v) }
@inlineAlways
pub fn highbit64(v: u64) -> u32 { return 63 - u64.leadingZeros(v) }

/// Returns how many bytes at `a[ai..]` and `b[bi..]` are equal, reading no byte at or after `a[limit]`.
pub unsafe fn count(a: [*]const u8, ai: usize, b: [*]const u8, bi: usize, limit: usize) -> usize {
  let mut i = ai let mut j = bi
  while usize.wrappingAdd(i, 8) <= limit {
    let diff = unsafe r64(a, i) ^ unsafe r64(b, j)
    if diff != 0 { return usize.wrappingAdd(usize.wrappingSubtract(i, ai), u32.toUsize(u32.shiftRight(u64.trailingZeros(diff), 3))) }
    i = usize.wrappingAdd(i, 8) j = usize.wrappingAdd(j, 8)
  }
  while i < limit && unsafe r8(a, i) == unsafe r8(b, j) { i = usize.wrappingAdd(i, 1) j = usize.wrappingAdd(j, 1) }
  return usize.wrappingSubtract(i, ai)
}

// ---- Helpers of the compressor (wrapping arithmetic and shifts whose count is masked). ----

/// `a + b` on `usize`, wrapping.
@inlineAlways
pub fn ua(a: usize, b: usize) -> usize { return usize.wrappingAdd(a, b) }
/// `a - b` on `usize`, wrapping.
@inlineAlways
pub fn us(a: usize, b: usize) -> usize { return usize.wrappingSubtract(a, b) }
/// `a + b` on `u32`, wrapping.
@inlineAlways
pub fn a32(a: u32, b: u32) -> u32 { return u32.wrappingAdd(a, b) }
/// `a - b` on `u32`, wrapping.
@inlineAlways
pub fn s32(a: u32, b: u32) -> u32 { return u32.wrappingSubtract(a, b) }
/// `a * b` on `u32`, wrapping.
@inlineAlways
pub fn m32(a: u32, b: u32) -> u32 { return u32.wrappingMultiply(a, b) }
/// `v << (n mod 32)`.
@inlineAlways
pub fn shl32(v: u32, n: u32) -> u32 { return u32.shiftLeft(v, n & 31) }
/// `v >> (n mod 32)`.
@inlineAlways
pub fn shr32(v: u32, n: u32) -> u32 { return u32.shiftRight(v, n & 31) }
/// `v << (n mod 64)`.
@inlineAlways
pub fn shl64(v: u64, n: u32) -> u64 { return u64.shiftLeft(v, u32.toU64(n & 63)) }
/// `v >> (n mod 64)`.
@inlineAlways
pub fn shr64(v: u64, n: u32) -> u64 { return u64.shiftRight(v, u32.toU64(n & 63)) }
/// `v << (n mod 64)` on `usize`.
@inlineAlways
pub fn shlz(v: usize, n: u32) -> usize { return usize.shiftLeft(v, u32.toUsize(n & 63)) }
/// `v >> (n mod 64)` on `usize`.
@inlineAlways
pub fn shrz(v: usize, n: u32) -> usize { return usize.shiftRight(v, u32.toUsize(n & 63)) }
/// `u32` to `usize`.
@inlineAlways
pub fn z(v: u32) -> usize { return u32.toUsize(v) }
/// The low 32 bits of a `usize`.
@inlineAlways
pub fn t32(v: usize) -> u32 { return usize.wrappingToU32(v) }
/// Writes the low 24 bits of `v` at `p[at..]`, little-endian.
@inlineAlways
pub unsafe fn w24(p: [*]mut u8, at: usize, v: u32) -> () {
  unsafe w16(p, at, u32.wrappingToU16(v))
  unsafe w8(p, usize.wrappingAdd(at, 2), u32.wrappingToU8(u32.shiftRight(v, 16)))
}
/// The address of `p`.
@inlineAlways
pub fn addr(p: [*]const u8) -> usize { return Pointer.addressMany<u8>(p) }
/// The address of `p`.
@inlineAlways
pub fn addrm(p: [*]mut u8) -> usize { return Pointer.addressMany<u8>(p) }
/// `p - n`, as a pointer; the caller uses it only with offsets that lead back into an allocation.
@inlineAlways
pub unsafe fn subc(p: [*]const u8, n: usize) -> [*]const u8 { return unsafe addc(p, usize.wrappingSubtract(0, n)) }
/// A nullable byte pointer as a non-null one. The caller proves that it is not null.
@inlineAlways
pub unsafe fn nn(p: ?[*]mut u8) -> [*]mut u8 { return unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(p) }
/// A non-null byte pointer as a nullable one.
@inlineAlways
pub fn opt(p: [*]mut u8) -> ?[*]mut u8 { return p }
/// A null byte pointer.
@inlineAlways
pub fn nullp() -> ?[*]mut u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]mut u8>(Pointer.null<u8>()) }

// A function that calls a foreign function directly is compiled `noinline`, whatever it is marked
// (ZSTD_NOTES.md, "Compiler walls"). So a function that must inline calls the C library through
// these, which are ordinary calls.

/// `memcpy(to, from, count)` for ranges that do not overlap.
pub unsafe fn copyBytes(to: [*]mut u8, from: [*]const u8, count: usize) -> () { let _r = unsafe memcpy(to, from, count) }
/// `memmove(to, from, count)`.
pub unsafe fn moveBytes(to: [*]mut u8, from: [*]const u8, count: usize) -> () { let _r = unsafe memmove(to, from, count) }
/// `memset(to, value, count)`.
pub unsafe fn fillBytes(to: [*]mut u8, value: u8, count: usize) -> () { let _r = unsafe memset(to, u8.toI32(value), count) }
