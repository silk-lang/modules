}
unsafe effect fn prepare<'m, S: EngineServices>(engine: &mut Engine<'m, S>, context: *mut HeapHeader, state: *mut State, j: &mut Job, argv: &FrameSlots) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let named = unsafe common.argument(argv, 0)
  if named.isNumber() {
    // The write op by number, so that a write does not make a string of its name.
    if f64.toI32(named.numericValue()) == 8 { j.op = 8 }
  }
  if j.op == 0 {
    let name = run unsafe host.text(&mut engine, context, named) let op = name.asSlice()
    if equal(op, b"create") { j.op = 1 } if equal(op, b"process") { j.op = 2 } if equal(op, b"reset") { j.op = 3 } if equal(op, b"params") { j.op = 4 } if equal(op, b"close") { j.op = 5 } if equal(op, b"crc32") { j.op = 6 }
    if equal(op, b"pledge") { j.op = 7 } if equal(op, b"write") { j.op = 8 } if equal(op, b"checksum") { j.op = 9 }
  }
  if j.op == 0 { let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Type, b"Unknown compression operation") return () }
  let args = unsafe common.argument(argv, 1) let mut index: u32 = 0
  let mut count: u32 = 8 if j.op == 8 { count = 9 }
  while index < count {
    let value = run unsafe owners.getIndex(&mut engine, context, args, index) let i = u32.toUsize(index)
    if j.op == 8 && i == 8 {
      // Where a synchronous write puts its words: an Int32Array's ArrayBuffer of the handle.
      j.words = value
      index = index + 1
      continue
    }
    if (j.op == 8 && (i == 2 || i == 5)) || (j.op == 9 && i == 2) {
      // The write op keeps the buffers themselves; dispatch or submit decide how to reach them.
      j.views[(i - 2) / 3] = value
      index = index + 1
      continue
    }
    if value.isNumber() {
      if (j.op == 8 && (i == 3 || i == 4 || i == 6 || i == 7)) || (j.op == 9 && (i == 3 || i == 4)) {
        let number = value.numericValue()
        if !(number >= 0.0) || number > 9007199254740991.0 { unsafe owners.release(&mut engine, context, value) let _ignored = run engine.throwError(unsafe lendRealm(&context, context), NativeErrorKind.Range, b"Invalid compression buffer range") return () }
        j.lengths[i] = u64.toUsize(f64.toU64(number))
      }
      else if j.op == 7 && i == 1 { j.pledgedSize = f64.toU64(value.numericValue()) }
      else {
        if (j.op == 6 || j.op == 9) && i == 1 { j.numbers[i] = u32.wrappingToI32(f64.toU32(value.numericValue())) }
        else { j.numbers[i] = f64.toI32(value.numericValue()) }
      }
      unsafe owners.release(&mut engine, context, value)
    }
    else {
      match value { ValueBits.Undefined => () ValueBits.Null => () _ => {
        let converted = run Effect.result(buffers.getArrayBuffer(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(value)))
        unsafe owners.release(&mut engine, context, value)
        let backing = match move converted { Result<buffers.BufferState, JsException>.Success { value: data } => data Result<buffers.BufferState, JsException>.Failure { error } => { fail move error } }
