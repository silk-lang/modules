//! Highlight colors inherit through the selector tree, independently of ordinary text color.
import thin { Thin }
import engine { UiTree, TreeError }
import node { Node, NONE }
import style_sheets
import svg_css.element { PseudoTarget, StateBits }
import svg_css.adopted { StyleSheets }
import svg_css.colors { ColorProgram, Color, Context }
import svg_css.colors
import properties.catalog { Property }
import properties.values { Value }
import properties.keywords { Keyword }
import properties.convert
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.collections.hash { Hash }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.f32
import silk.num.u32
import silk.num.usize

pub union ColorSource { Default, Current, Solid { pub value: Rgba<f32> } }
impl Copy for ColorSource {}

pub struct Colors {
  pub foreground: ColorSource,
  pub background: ColorSource,
}
impl Copy for Colors {}
impl Colors {
  pub fn initial() -> Colors { return Colors { foreground: ColorSource.Default, background: ColorSource.Default } }
}

pub struct Selection {
  pub colors: Colors,
  pub backgroundExpression: Option<ColorProgram>,
}

pub fn of(node: &Node) -> Colors {
  if let Option.Some { value } = node.identity() {
    if let Option.Some { value: selected } = value.selection.get() { return selected.colors }
  }
  return Colors.initial()
}

pub fn color(source: ColorSource, current: Rgba<f32>) -> Option<Rgba<f32>> {
  return match source { ColorSource.Solid { value } => Option<Rgba<f32>>.some(value)
    ColorSource.Current => Option<Rgba<f32>>.some(current) _ => Option<Rgba<f32>>.None }
}

pub fn styled(node: &Node) -> bool {
  return match node.identity() { Option.Some { value } => value.selection.isSome() _ => false }
}

pub fn foreground(node: &Node) -> Option<Rgba<f32>> { return color(of(node).foreground, node.computed().text.color) }

pub fn background(node: &Node) -> Rgba<f32> {
  let foreground = match foreground(node) { Option.Some { value } => value _ => node.computed().text.color }
  return match color(of(node).background, foreground) {
    Option.Some { value } => value
    _ => if styled(node) { Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 } } else { node.computed().text.selectionColor }
  }
}

pub fn present(sheets: &StyleSheets) -> bool {
  let mut i: usize = 0
  while i < sheets.sheets().length {
    let rules = sheets.sheets()[i].sheet.resolver.rules()
    let mut j: usize = 0
    while j < rules.length {
      if rules[j].selectors.hasPseudoTarget(PseudoTarget.Selection) { return true }
      j = j + 1
    }
    i = i + 1
  }
  return false
}

fn specified(value: &Value, inherited: ColorSource, foreground: bool) -> ColorSource {
  if convert.isKeyword(value, Keyword.Inherit) || convert.isKeyword(value, Keyword.Unset) {
    if let ColorSource.Default = inherited {
      return if foreground { ColorSource.Current } else { ColorSource.Solid { value: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 } } }
    }
    return inherited
  }
  if convert.isKeyword(value, Keyword.Currentcolor) { return ColorSource.Current }
  if convert.isKeyword(value, Keyword.Initial) { return ColorSource.Solid { value: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 } } }
  return match convert.color(value) { Option.Some { value: rgba } => ColorSource.Solid { value: rgba } _ => inherited }
}

pub effect fn resolve(tree: &mut UiTree<'_>, slot: u32) ! TreeError | OutOfMemoryError ? &mut Allocator {
  let at = style_sheets.index(tree.styleSheets.asSlice(), tree.current)
  let enabled = at != usize.MAX && tree.styleSheets.asSlice()[at].sheets.length() != 0 && tree.styleSheets.asSlice()[at].hasSelection
  if !enabled {
    if tree.node(slot).identity().isSome() {
      let node = tree.nodeMut(slot)
      let identity = run node.identityMut()
      identity.selection.clear()
    }
    return ()
  }
  let parent = tree.node(slot).parent
  let inherited = if parent == NONE { Colors.initial() } else { of(tree.node(parent)) }
  let mut selected = inherited
  let mut inheritBackground = true
  let mut expression = Option<ColorProgram>.None
  if tree.styleSheets.asSlice()[at].selectionSubjects.mayMatch(tree.node(slot), tree.isRootNode(slot)) {
    let resolved = run tree.resolvePseudoStyle(slot, PseudoTarget.Selection, StateBits.empty(), true)
    let declarations = resolved.style.declarations.asSlice()
    let mut i: usize = 0
    while i < declarations.length {
      let declaration = &declarations[i]
      if declaration.property == Property.Color { selected.foreground = specified(&declaration.value, inherited.foreground, true) }
      if declaration.property == Property.BackgroundColor {
        selected.background = specified(&declaration.value, inherited.background, false)
        inheritBackground = convert.isKeyword(&declaration.value, Keyword.Inherit) || convert.isKeyword(&declaration.value, Keyword.Unset)
      }
      i = i + 1
    }
    expression = move resolved.highlightBackground
  }
  if inheritBackground && parent != NONE {
    if let Option.Some { value: identity } = tree.node(parent).identity() {
      if let Option.Some { value: parentSelection } = identity.selection.get() {
        if let Option.Some { value: inheritedExpression } = &parentSelection.backgroundExpression {
          expression = Option<ColorProgram>.some(run inheritedExpression.copy())
        }
      }
    }
  }
  if let Option.Some { value: program } = &expression {
    let origin = tree.node(slot).computed().text.color
    let foreground = match color(selected.foreground, origin) { Option.Some { value } => value _ => origin }
    let current = Color.srgb(f32.toF64(foreground.r), f32.toF64(foreground.g), f32.toF64(foreground.b), f32.toF64(foreground.a))
    let context = Context.make(current, tree.styleSheets.asSlice()[at].systemColors)
    if let Option.Some { value } = program.evaluate(&context) {
      let rgba = colors.toSrgb(value)
      selected.background = ColorSource.Solid { value: Rgba<f32> { r: f64.toF32(rgba.r), g: f64.toF32(rgba.g), b: f64.toF32(rgba.b), a: f64.toF32(rgba.a) } }
    }
  }
  if let ColorSource.Default = selected.foreground {
    if let ColorSource.Default = selected.background {
      if tree.node(slot).identity().isSome() {
        let node = tree.nodeMut(slot)
        let identity = run node.identityMut()
        identity.selection.clear()
      }
      return ()
    }
  }
  let node = tree.nodeMut(slot)
  let identity = run node.identityMut()
  let resolvedSelection = Selection { colors: selected, backgroundExpression: move expression }
  match identity.selection.getMut() {
    Option.Some { value } => { value.* = move resolvedSelection }
    _ => { identity.selection.set(run Thin<Selection>.make(move resolvedSelection)) }
  }
}

fn colorHash(hash: u64, source: ColorSource) -> u64 {
  return match source {
    ColorSource.Default => Hash.combine(hash, 0)
    ColorSource.Current => Hash.combine(hash, 1)
    ColorSource.Solid { value } => Hash.combine(Hash.combine(Hash.combine(Hash.combine(Hash.combine(hash, 2),
      u32.toU64(f32.toBits(value.r))), u32.toU64(f32.toBits(value.g))), u32.toU64(f32.toBits(value.b))), u32.toU64(f32.toBits(value.a)))
  }
}

pub fn hash(node: &Node, hash: u64) -> u64 {
  if node.identity().isNone() { return hash }
  let selected = of(node)
  if let ColorSource.Default = selected.foreground {
    if let ColorSource.Default = selected.background { return hash }
  }
  return colorHash(colorHash(hash, selected.foreground), selected.background)
}
