//! Selector identity lives off the node record; class atoms are stable across all UI roots.
import svg_css.ancestor_filter { NameKind }
import svg_css.ancestor_filter
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import svg_css.tokens { equal, TokenBuffer }
import mutation { StyleState }
import selection { Selection }
import scrollbar_parts { Scrollbars }
import thin { Thin }
import svg_css.element { PseudoTarget }
import silk.num.u32
import silk.num.u8
import silk.num.usize
import silk.mem.frozen { Frozen }
import silk.collections.hash { Hash, Word }
import silk.collections.hash_map { HashMap }

pub struct CustomValue { pub state: StyleState, pub name: String, pub tokens: TokenBuffer, pub important: bool }

pub struct NamedAttribute { pub name: String, pub value: String }

/// What few nodes' identities hold, on the heap: an identity gets one with the first of these
/// it is given. Each is a list or a text whose header alone is 64 bytes, and every element of
/// a document has an identity. Read them through the identity (`NodeIdentity.attributes`, ...),
/// which gives the empty value without one.
pub struct IdentityExtras {
  pub containerNames: List<Bytes>,
  pub custom: List<CustomValue>,
  pub id: String,
  pub attributes: List<NamedAttribute>,
}

impl IdentityExtras {
  pub fn make() -> IdentityExtras {
    return IdentityExtras { containerNames: List<Bytes>.make(), custom: List<CustomValue>.make(), id: String.make(), attributes: List<NamedAttribute>.make() }
  }
}

pub struct NodeIdentity {
  pub selection: Thin<Selection>,
  pub scrollbars: Thin<Scrollbars>,
  /// Container names, custom properties, the id and named attributes (see `IdentityExtras`).
  pub extras: Thin<IdentityExtras>,
  pub generatedOrigin: u32,
  pub generatedTarget: PseudoTarget,
  pub before: u32,
  pub after: u32,
  /// The `::marker` box of a list item, or u32.MAX.
  pub marker: u32,
  /// `::first-letter`: on its origin and on the text it splits, the letter box; on the box,
  /// the text (u32.MAX when none). `letterRules` marks an origin that rules give a letter.
  pub letterBox: u32,
  pub letterText: u32,
  pub letterRules: bool,
  /// The hidden node holding an origin's `::first-line` style, or u32.MAX.
  pub lineBox: u32,
  /// The tag and the class attribute, shared by every element with the same ones (see
  /// `SelectorKeys`); none for an element with neither.
  pub key: Option<Frozen<SelectorKey>>,
  pub hasId: bool,
  pub hasClasses: bool,
}

impl NodeIdentity {
  /// The element's tag name, empty when it has none.
  pub fn tag(self: &Self) -> string {
    return match &self.key { Option.Some { value } => String.view(&value.get().tag) _ => "" }
  }

  /// The class attribute's text.
  pub fn classes(self: &Self) -> string {
    return match &self.key { Option.Some { value } => String.view(&value.get().classes) _ => "" }
  }

  /// Sorted unique atom ids, so class order and repeated tokens do not change sharing keys.
  pub fn classAtoms(self: &Self) -> &[usize] {
    return match &self.key { Option.Some { value } => value.get().classAtoms.asSlice() _ => &[] }
  }

  /// Whether both have the same tag and class attribute.
  pub fn sameKey(self: &Self, other: &NodeIdentity) -> bool {
    return match &self.key {
      Option.Some { value: left } => match &other.key {
        Option.Some { value: right } => Frozen<SelectorKey>.same(&left, &right) || sameKeyText(left.get(), right.get())
        _ => false
      }
      _ => other.key.isNone()
    }
  }

  fn extrasOf(self: &Self) -> Option<&IdentityExtras> {
    return self.extras.get()
  }

  /// The rarer parts to change, made on first use.
  pub effect fn extrasMut(self: &mut Self) -> &mut IdentityExtras ! OutOfMemoryError ? &mut Allocator {
    return run self.extras.getOrMake(IdentityExtras.make)
  }

  // The rarer parts to change, when the identity has them.
  fn extrasHeld(self: &mut Self) -> Option<&mut IdentityExtras> {
    return self.extras.getMut()
  }

  /// The container names the node's style gives it.
  pub fn containerNames(self: &Self) -> &[Bytes] {
    return match self.extrasOf() { Option.Some { value } => value.containerNames.asSlice() _ => &[] }
  }

  /// The custom properties set on the node itself.
  pub fn custom(self: &Self) -> &[CustomValue] {
    return match self.extrasOf() { Option.Some { value } => value.custom.asSlice() _ => &[] }
  }

  /// The element id; it counts when `hasId`.
  pub fn id(self: &Self) -> string {
    return match self.extrasOf() { Option.Some { value } => String.view(&value.id) _ => "" }
  }

  /// The named attributes selectors can read.
  pub fn attributes(self: &Self) -> &[NamedAttribute] {
    return match self.extrasOf() { Option.Some { value } => value.attributes.asSlice() _ => &[] }
  }

  pub effect fn setContainerNames(self: &mut Self, names: List<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
    if names.length() == 0 && self.extras.isNone() { return () }
    let extras = run self.extrasMut()
    extras.containerNames = move names
  }

  pub effect fn setId(self: &mut Self, id: String) -> () ! OutOfMemoryError ? &mut Allocator {
    let extras = run self.extrasMut()
    extras.id = move id
    self.hasId = true
  }

  pub fn clearCustom(self: &mut Self, state: StyleState) -> () {
    if let Option.Some { value: extras } = self.extrasHeld() {
      let mut i = extras.custom.length()
      while i > 0 {
        i = i - 1
        if extras.custom.asSlice()[i].state == state { drop extras.custom.remove(i) }
      }
    }
  }
  pub effect fn setCustom(self: &mut Self, state: StyleState, name: String, tokens: Option<TokenBuffer>, important: bool) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    if tokens.isNone() && self.extras.isNone() { return () }
    let extras = run self.extrasMut()
    let mut i: usize = 0
    while i < extras.custom.length() {
      let item = &extras.custom.asSlice()[i]
      if item.state == state && String.view(&item.name) == String.view(&name) { break }
      i = i + 1
    }
    match move tokens {
      Option<TokenBuffer>.Some { value } => {
        let item = CustomValue { state: state, name: move name, tokens: move value, important: important }
        if i == extras.custom.length() { run extras.custom.append(move item) }
        else { let items = extras.custom.asMutSlice()
          items[i] = move item }
      }
      _ => { if i < extras.custom.length() { drop extras.custom.remove(i) } }
    }
  }

  pub effect fn set(self: &mut Self, name: String, value: Option<String>) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    if value.isNone() && self.extras.isNone() { return () }
    let extras = run self.extrasMut()
    let mut index: usize = 0
    while index < extras.attributes.length() {
      if String.view(&extras.attributes.asSlice()[index].name) == String.view(&name) { break }
      index = index + 1
    }
    match move value {
      Option<String>.Some { value: text } => {
        if index < extras.attributes.length() { let items = extras.attributes.asMutSlice()
          items[index].value = move text
        }
        else { run extras.attributes.append(NamedAttribute { name: move name, value: move text }) }
      }
      Option<String>.None => {
        if index < extras.attributes.length() { drop extras.attributes.remove(index) }
      }
    }
  }

  pub fn make() -> Self {
    return NodeIdentity { selection: Thin<Selection>.none(), scrollbars: Thin<Scrollbars>.none(), extras: Thin<IdentityExtras>.none(), generatedOrigin: u32.MAX, generatedTarget: PseudoTarget.None, before: u32.MAX, after: u32.MAX, marker: u32.MAX, letterBox: u32.MAX, letterText: u32.MAX, letterRules: false, lineBox: u32.MAX, key: Option<Frozen<SelectorKey>>.None, hasId: false, hasClasses: false }
  }
}

/// What selectors read of an element that many elements have alike: its tag and class attribute.
pub struct SelectorKey {
  pub tag: String,
  pub classes: String,
  /// Sorted unique atom ids, so class order and repeated tokens do not change sharing keys.
  pub classAtoms: List<usize>,
}

fn sameKeyText(left: &SelectorKey, right: &SelectorKey) -> bool {
  return String.view(&left.tag) == String.view(&right.tag) && String.view(&left.classes) == String.view(&right.classes)
}

fn hashBytes(seed: u64, bytes: &[u8]) -> u64 {
  let mut hash = Hash.combine(seed, usize.toU64(bytes.length))
  let mut i: usize = 0
  while i < bytes.length {
    hash = Hash.combine(hash, u8.toU64(bytes[i]))
    i = i + 1
  }
  return hash
}

struct KeyEntry { hash: u64, key: Frozen<SelectorKey> }

/// What `SelectorKeys.room` counts.
pub struct KeysRoom { pub tag: usize, pub classes: usize, pub atoms: usize, pub atomRoom: usize }

/// One `SelectorKey` per distinct tag and class attribute, shared by the elements that have them.
/// A long document has a few dozen distinct ones for tens of thousands of elements.
pub struct SelectorKeys {
  /// Key hash to entry; a hash two different keys share keeps the first, and the second is made
  /// alone (sharing is only a saving, equal keys compare equal either way).
  map: HashMap<Word, u32>,
  entries: List<KeyEntry>,
  /// Entries at the last sweep, which drops the keys no element holds any more.
  swept: usize,
}

impl SelectorKeys {
  pub fn make() -> SelectorKeys {
    return SelectorKeys { map: HashMap<Word, u32>.make(Hash.seed(0x73656c6b)), entries: List<KeyEntry>.make(), swept: 16 }
  }

  /// The shared key for `tag` and `classes` (whose sorted atoms are `atoms`), or none when both
  /// are empty.
  pub effect fn intern(self: &mut Self, tag: string, classes: string, atoms: &[usize]) -> Option<Frozen<SelectorKey>>
    ! OutOfMemoryError ? &mut Allocator {
    if String.utf8Bytes(tag).length == 0 && String.utf8Bytes(classes).length == 0 { return Option<Frozen<SelectorKey>>.None }
    let hash = hashBytes(hashBytes(0x7461, String.utf8Bytes(tag)), String.utf8Bytes(classes))
    let word = Word { value: hash }
    if let Option.Some { value: at } = self.map.get(word) {
      let entry = &self.entries.asSlice()[u32.toUsize(at)]
      if String.view(&entry.key.get().tag) == tag && String.view(&entry.key.get().classes) == classes {
        return Option<Frozen<SelectorKey>>.some(entry.key.clone())
      }
    }
    let mut classAtoms = List<usize>.make()
    run classAtoms.appendSlice(atoms)
    let made = run Frozen<SelectorKey>.make(SelectorKey {
      tag: run String.copy(tag),
      classes: run String.copy(classes),
      classAtoms: move classAtoms,
    })
    if !self.map.contains(word) {
      if self.entries.length() >= self.swept * 2 { run self.sweep() }
      drop run self.map.insert(word, usize.toU32(self.entries.length()))
      run self.entries.append(KeyEntry { hash: hash, key: made.clone() })
    }
    return Option<Frozen<SelectorKey>>.some(move made)
  }

  /// How many distinct keys the table holds.
  pub fn length(self: &Self) -> usize { return self.entries.length() }

  /// The room the table's keys hold: tag text, class text, class atoms and the atoms' room.
  pub fn room(self: &Self) -> KeysRoom {
    let mut room = KeysRoom { tag: 0, classes: 0, atoms: 0, atomRoom: 0 }
    let entries = self.entries.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      let key = entries[i].key.get()
      room.tag = room.tag + key.tag.capacity()
      room.classes = room.classes + key.classes.capacity()
      room.atoms = room.atoms + key.classAtoms.length()
      room.atomRoom = room.atomRoom + key.classAtoms.capacity()
      i = i + 1
    }
    return move room
  }

  // Drops the keys only the table still holds.
  effect fn sweep(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut kept = List<KeyEntry>.make()
    let mut old = Intrinsic.replace(self.entries, List<KeyEntry>.make())
    self.map.clear()
    while old.length() != 0 {
      let last = old.length() - 1
      let entry = old.remove(last)
      if entry.key.count() > 1 {
        drop run self.map.insert(Word { value: entry.hash }, usize.toU32(kept.length()))
        run kept.append(move entry)
      }
    }
    self.entries = move kept
    self.swept = if self.entries.length() > 16 { self.entries.length() } else { 16 }
  }
}

/// Class names by atom id, and back: a hash of the name heads a chain through `next` of the
/// atoms whose names share it.
pub struct Atoms { names: List<Bytes>, heads: HashMap<Word, u32>, next: List<u32>, filterKeys: List<u32>, pub interns: usize, pub compares: usize }
fn space(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13 }

const NO_ATOM: u32 = 0xFFFFFFFF

impl Atoms {
  pub fn make() -> Self {
    return Atoms { names: List<Bytes>.make(), heads: HashMap<Word, u32>.make(Hash.seed(0x61746f6d)), next: List<u32>.make(), filterKeys: List<u32>.make(), interns: 0, compares: 0 }
  }

  /// For the bench census: the atoms, and the bytes of their names.
  pub fn length(self: &Self) -> usize { return self.names.length() }
  pub fn nameBytes(self: &Self) -> usize {
    let mut total: usize = 0
    let mut i: usize = 0
    while i < self.names.length() {
      total = total + self.names.asSlice()[i].asSlice().length
      i = i + 1
    }
    return total
  }

  /// The atom named `text`, or usize.MAX when no class has that name.
  pub fn find(self: &Self, text: &[u8]) -> usize {
    let mut at = match self.heads.get(Word { value: hashBytes(0x636c, text) }) { Option.Some { value } => value _ => NO_ATOM }
    while at != NO_ATOM {
      if equal(self.names.asSlice()[u32.toUsize(at)].asSlice(), text) { return u32.toUsize(at) }
      at = self.next.asSlice()[u32.toUsize(at)]
    }
    return usize.MAX
  }

  pub effect fn intern(self: &mut Self, text: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
    self.interns = self.interns + 1
    let word = Word { value: hashBytes(0x636c, text) }
    let head = match self.heads.get(word) { Option.Some { value } => value _ => NO_ATOM }
    let mut at = head
    while at != NO_ATOM {
      self.compares = self.compares + 1
      if equal(self.names.asSlice()[u32.toUsize(at)].asSlice(), text) { return u32.toUsize(at) }
      at = self.next.asSlice()[u32.toUsize(at)]
    }
    let index = self.names.length()
    run self.names.append(run Bytes.copy(text))
    run self.next.append(head)
    run self.filterKeys.append(ancestor_filter.key(NameKind.Class, text))
    drop run self.heads.insert(word, usize.toU32(index))
    return index
  }

  pub fn text(self: &Self, atom: usize) -> &[u8] { return self.names.asSlice()[atom].asSlice() }

  /// The ancestor filter's key of the class `atom`.
  pub fn filterKey(self: &Self, atom: usize) -> u32 { return self.filterKeys.asSlice()[atom] }

  pub effect fn classes(self: &mut Self, text: &[u8]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
    let mut result = List<usize>.make()
    let mut at: usize = 0
    while at < text.length {
      while at < text.length && space(text[at]) { at = at + 1 }
      let start = at
      while at < text.length && !space(text[at]) { at = at + 1 }
      if at > start {
        let atom = run self.intern(Slice.view<u8>(text, start, at - start))
        let mut i: usize = 0
        while i < result.length() && result.asSlice()[i] < atom { i = i + 1 }
        if i == result.length() || result.asSlice()[i] != atom {
          run result.append(atom)
          let mut end = result.length() - 1
          let items = result.asMutSlice()
          while end > i { items[end] = items[end - 1]
            end = end - 1
          }
          items[i] = atom
        }
      }
    }
    return move result
  }
}
