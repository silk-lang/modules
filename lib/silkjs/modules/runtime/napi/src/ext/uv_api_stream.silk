  if fd == -1 {
    let made = unsafe newSocket(family, SOCK_DGRAM, 0)
    if made < 0 { return made }
    fd = made
    unsafe setFd(udp, fd)
  }
  if (flags & UV_UDP_LINUX_RECVERR) != 0 { let err = unsafe setReceiveErrors(fd, family) if err != 0 { return err } }
  if (flags & UV_UDP_REUSEADDR) != 0 { let err2 = unsafe reuseAddress(fd) if err2 != 0 { return err2 } }
  if (flags & UV_UDP_REUSEPORT) != 0 { let err3 = unsafe reusePort(fd) if err3 != 0 { return err3 } }
  if (flags & UV_UDP_IPV6ONLY) != 0 { let err4 = unsafe setInt(fd, IPPROTO_IPV6, IPV6_V6ONLY, 1) if err4 != 0 { return err4 } }
