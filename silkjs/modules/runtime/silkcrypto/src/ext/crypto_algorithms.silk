    // Node compares a shorter tag with its first bytes.
    let shadow = match move ChaCha20Poly1305Encryptor.make(key, &nonce, aad) { Result<ChaCha20Poly1305Encryptor, AeadError>.Success { value } => move value Result<ChaCha20Poly1305Encryptor, AeadError>.Failure { .. } => { return false } }
