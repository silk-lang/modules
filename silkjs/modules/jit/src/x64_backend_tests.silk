// Runs x64_backend's code for a hand-built SSA function, without the engine: the
// compiled-entry ABI's results and every kind of exit (docs/jit/compiled-entry.md).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.mem.pointer { Pointer }
import silk.num.u32
import silk.num.u64
import silk.testing.testing { AssertionError, Testing }
import asm_x64 { Code, LinkError, UnboundLabelError }
import code_memory { CodeBlock, CodeMemory, MemoryError }
import ssa { Function, Op, Type, Own, RootKind, SlotMode, NONE }
import x64_backend { Lowering, Settings }
import x64_backend as backend
import silk.core.option { Option }
import silkjs.js_value { ValueBits }
import value_layout { ValueLayout }
import value_layout as layouts
import jit_helpers { CompiledEnv }
/// Bytecode offsets the hand-built function pretends to come from.
pub const PC_ENTRY: u32 = 0
pub const PC_HEADER: u32 = 7
pub const PC_ADD: u32 = 12
pub const PC_INC: u32 = 16

/// sum(n) { let s = 0; for (let i = 0; i < n; i++) s = s + i; return s } with locals
/// s (0) and i (1), as the translator would build it: guard n, loop with s and i as block
/// parameters, an exit before each checked add with the operands on the stack, a poll on
/// the back edge with an exit at the loop header.
pub effect fn sumFunction() -> Function ! OutOfMemoryError ? &mut Allocator {
  let mut f = Function.make(1, 2)
  let entry = run f.block()
  let header = run f.block()
  let body = run f.block()
  let done = run f.block()
  let n = run f.emit(entry, Op.Arg, true, Type.Value, Own.Borrowed, NONE, NONE, 0, PC_ENTRY)
  f.setOwnership(n, Own.Borrowed, RootKind.Argument, 0)
  let undefined = run f.emit(entry, Op.Imm, true, Type.Value, Own.Imm, NONE, NONE, 0, PC_ENTRY)
  let m = run f.emit(entry, Op.Unbox, true, Type.I32, Own.Unboxed, n, NONE, 0, PC_ENTRY)
  let last1 = f.lastInst() drop run f.exitFor(last1, PC_ENTRY, 0)
  run f.slotAt(undefined, SlotMode.Imm, NONE) run f.slotAt(undefined, SlotMode.Imm, NONE)
  let zero = run f.emit(entry, Op.ConstI32, true, Type.I32, Own.Unboxed, NONE, NONE, 0, PC_ENTRY)
  let toHeader = run f.newEdge(header)
  run f.edgeArgument(zero) run f.edgeArgument(zero)
  run f.terminate(entry, Op.Jump, NONE, toHeader, PC_ENTRY)
  let s = run f.addParam(header, Type.I32, Own.Unboxed)
  let i = run f.addParam(header, Type.I32, Own.Unboxed)
  let less = run f.emit(header, Op.Cmp, true, Type.Bool, Own.Unboxed, i, m, 0, PC_HEADER)
  let toBody = run f.newEdge(body)
  let toDone = run f.newEdge(done)
  run f.terminate(header, Op.Branch, less, toBody, PC_HEADER)
  drop toDone
  let sum = run f.emit(body, Op.Add, true, Type.I32, Own.Unboxed, s, i, 0, PC_ADD)
  let last2 = f.lastInst() drop run f.exitFor(last2, PC_ADD, 2)
  run f.slotAt(s, SlotMode.Int, NONE) run f.slotAt(i, SlotMode.Int, NONE)
  run f.slotAt(s, SlotMode.Int, NONE) run f.slotAt(i, SlotMode.Int, NONE)
  let one = run f.emit(body, Op.ConstI32, true, Type.I32, Own.Unboxed, NONE, NONE, 1, PC_INC)
  let next = run f.emit(body, Op.Add, true, Type.I32, Own.Unboxed, i, one, 0, PC_INC)
  let last3 = f.lastInst() drop run f.exitFor(last3, PC_INC, 0)
  run f.slotAt(sum, SlotMode.Int, NONE) run f.slotAt(i, SlotMode.Int, NONE)
  drop run f.emit(body, Op.Poll, false, Type.I32, Own.Unboxed, NONE, NONE, 0, PC_HEADER)
  let last4 = f.lastInst() drop run f.exitFor(last4, PC_HEADER, 0)
  run f.slotAt(sum, SlotMode.Int, NONE) run f.slotAt(next, SlotMode.Int, NONE)
  let back = run f.newEdge(header)
  run f.edgeArgument(sum) run f.edgeArgument(next)
  run f.terminate(body, Op.Jump, NONE, back, PC_HEADER)
  let boxed = run f.emit(done, Op.BoxI32, true, Type.Value, Own.Imm, s, NONE, 0, PC_HEADER)
  run f.terminate(done, Op.Return, boxed, NONE, PC_HEADER)
  run f.compact()
  return move f
}

fn layout() -> ValueLayout {
  return match layouts.probe() { Option<ValueLayout>.Some { value } => value Option<ValueLayout>.None => Intrinsic.trap("ValueBits layout not understood") }
}
effect fn compile(stress: u32) -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let f = run sumFunction()
  match move run backend.lower(&f, Settings { stress: stress, layout: layout(), map: false }) {
    Lowering.Code { value, .. } => { return move value }
    Lowering.Unsupported { .. } => { return Intrinsic.trap("sum must lower") }
  }
}
effect fn publish(memory: &mut CodeMemory, code: &mut Code) -> CodeBlock ! MemoryError | LinkError {
  let mut writer = run memory.allocate(code.bytes.length())
  let none: [usize; 1] = [0]
  run code.link(writer.address(), Slice.view<usize>(&none, 0, 0))
  run writer.append(code.bytes.asSlice())
  return run writer.finish()
}
unsafe fn enter(block: &CodeBlock, argument: ValueBits, state: *mut u64, counter: *mut i32, data: *mut i32) -> u32 {
  let address = block.entry()
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn(*const ValueBits, *mut u64, *mut i32, ?*mut u8, ?*mut u8, ?*const u8) -> u32>(Pointer.fromRef(&address))
  let function = unsafe Pointer.read<extern "C" fn(*const ValueBits, *mut u64, *mut i32, ?*mut u8, ?*mut u8, ?*const u8) -> u32>(slot)
  let cells: [ValueBits; 1] = [argument]
  // The exits call the EXIT_STATE helper through the environment.
  let mut env = CompiledEnv.make()
  return unsafe function(Pointer.fromRef<ValueBits>(&cells[0]), state, counter, unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(data),
    unsafe Intrinsic.pointerReinterpret<*mut CompiledEnv, *mut u8>(Pointer.fromMutRef<CompiledEnv>(&mut env)), Pointer.null<u8>())
}
/// The ValueBits at state word `word`.
fn at(state: &[u64; 16], word: usize) -> ValueBits {
  return unsafe Pointer.read<ValueBits>(unsafe Intrinsic.pointerReinterpret<*const u64, *const ValueBits>(Pointer.fromRef<u64>(&state[word])))
}
fn int(bits: ValueBits, expected: i32) -> bool { return match bits { ValueBits.Int { value } => value == expected _ => false } }
fn undefined(bits: ValueBits) -> bool { return match bits { ValueBits.Undefined => true _ => false } }
/// The i-th local or stack slot of an exit state.
fn slotAt(state: &[u64; 16], index: usize) -> ValueBits { return at(state, 2 + 2 * index) }

test effect fn compiledSumReturnsAndDeopts() -> () ! OutOfMemoryError | UnboundLabelError | MemoryError | LinkError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut code = run compile(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut memory = run CodeMemory.reserve(1048576)
  let block = run publish(&mut memory, &mut code)
  let mut state: [u64; 16] = [0; 16]
  let mut counter: i32 = 10000
  let mut stress: i32 = 0
  let s = Pointer.fromMutRef<u64>(&mut state[0])
  let c = Pointer.fromMutRef<i32>(&mut counter)
  let d = Pointer.fromMutRef<i32>(&mut stress)
  run Testing.expect(unsafe enter(&block, ValueBits.Int { value: 10 }, s, c, d) == 0 && int(at(&state, 0), 45) && state[2] == u32.toU64(PC_HEADER), "sum(10) returns the Int 45 and names its return")
  run Testing.expect(unsafe enter(&block, ValueBits.Int { value: 0 }, s, c, d) == 0 && int(at(&state, 0), 0), "sum(0) returns the Int 0")
  run Testing.expect(unsafe enter(&block, ValueBits.Int { value: -1 }, s, c, d) == 0 && int(at(&state, 0), 0), "sum(-1) returns the Int 0")
  // Not an Int: the entry guard leaves before anything ran, locals as the interpreter has them.
  run Testing.expect(unsafe enter(&block, ValueBits.Float64 { value: 2.5 }, s, c, d) == 1 && state[0] == u32.toU64(PC_ENTRY) && state[1] == 0
    && undefined(slotAt(&state, 0)) && undefined(slotAt(&state, 1)), "a non-Int argument deopts at entry")
  // 0 + 1 + ... + 65535 = 2147450880 fits; adding 65536 overflows, at i = 65536.
  counter = 1000000
  run Testing.expect(unsafe enter(&block, ValueBits.Int { value: 70000 }, s, c, d) == 1 && state[0] == u32.toU64(PC_ADD) && state[1] == 2
    && int(slotAt(&state, 0), 2147450880) && int(slotAt(&state, 1), 65536) && int(slotAt(&state, 2), 2147450880) && int(slotAt(&state, 3), 65536),
    "an overflowing add deopts before itself with its operands on the stack")
  // The poll: three back edges then a poll exit at the loop header with i = 3.
  counter = 3
  run Testing.expect(unsafe enter(&block, ValueBits.Int { value: 100 }, s, c, d) == 2 && state[0] == u32.toU64(PC_HEADER) && state[1] == 0
    && int(slotAt(&state, 0), 3) && int(slotAt(&state, 1), 3), "the back edge leaves through its poll exit when the counter runs out")
  run Testing.expect(counter == 0, "the poll consumed the counter as the interpreter's would")
  let mut stressed = run compile(5) |> Effect.provideMut<Allocator>(&mut allocator)
  let stressBlock = run publish(&mut memory, &mut stressed)
  counter = 10000 stress = 5
  // Guards checked: unbox, then per iteration add and inc. The 5th is the inc of i = 1.
  run Testing.expect(unsafe enter(&stressBlock, ValueBits.Int { value: 10 }, s, c, d) == 1 && state[0] == u32.toU64(PC_INC)
    && int(slotAt(&state, 0), 1) && int(slotAt(&state, 1), 1), "stress fails the Nth guard check")
  run Testing.expect(stress == 5, "stress re-arms its counter")
}

test effect fn valueLayoutIsUnderstood() -> () ! AssertionError<'static> {
  let probed = layouts.probe()
  run Testing.expect(probed.isSome(), "the engine's ValueBits layout is one compiled code understands")
}
