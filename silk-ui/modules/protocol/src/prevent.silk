//! Declarative `PreventDefaultRules`: key, code, modifier, and composition matchers
//! evaluated synchronously on Engine threads (and in DOM shims) with zero round-trips.
import input { MOD_SHIFT, MOD_CONTROL, MOD_ALT, MOD_META }
import silk.collections.list { List }
import silk.concurrency.thread { Transferable }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

/// Flags for [`Attribute.Prevent`] and baseline [`PreventDefaultRules.actions`].
///
/// A primary press does not move focus and does not start a text selection.
pub const PREVENT_FOCUS: u32 = 1

/// A wheel does not scroll.
pub const PREVENT_SCROLL: u32 = 2

/// A key does nothing by itself: no Tab navigation, no Enter or Space click, no editing, and
/// no text typed by it.
pub const PREVENT_KEYS: u32 = 4

/// Clipboard copy default is skipped at the node / subtree.
pub const PREVENT_COPY: u32 = 8

/// Clipboard cut default is skipped at the node / subtree.
pub const PREVENT_CUT: u32 = 16

/// Clipboard paste default is skipped at the node / subtree.
pub const PREVENT_PASTE: u32 = 32

/// `BeforeInput` edit application is skipped at the node / subtree.
pub const PREVENT_BEFORE_INPUT: u32 = 64

pub const PREVENT_ALL: u32 = 127

/// How a [`KeyRule`] matches a keyboard event.
pub enum KeyMatchKind {
  /// Matches UI Events `Event.key` (`value`).
  LogicalKey,
  /// Matches physical UI Events `Event.code` (`value`).
  PhysicalCode,
  /// Matches Enter, Tab, Backspace, Escape, Delete, Insert, Home, End, PageUp/Down, Arrows, F1..F24.
  NamedKeys,
  /// Matches any key event matching modifiers / composition guard.
  AnyKey,
}

/// Outcome of a matching [`KeyRule`].
pub enum KeyRuleEffect {
  Prevent,
  Allow,
}

/// One declarative key matching rule. Rules evaluate in declaration order; first match wins.
pub struct KeyRule {
  pub action: KeyRuleEffect,
  pub matchKind: KeyMatchKind,
  pub value: String,
  /// Bitmask of `MOD_*` modifier bits inspected (`0` = ignore modifier state).
  pub modifiersMask: u32,
  /// Expected values for bits in `modifiersMask`.
  pub modifiersValue: u32,
  /// When non-zero, requires `(held & anyModifierMask) != 0`.
  pub anyModifierMask: u32,
  /// When `true`, rule does not match while an IME composition is active.
  pub requireNotComposing: bool,
  /// When `true` with `LogicalKey`, compares single ASCII letters case-insensitively.
  pub caseInsensitive: bool,
}

impl Transferable for KeyRule {}

fn toLowerAscii(b: u8) -> u8 {
  if b >= 65 && b <= 90 {
    return b + 32
  }
  return b
}

fn sameKeyText(a: string, b: string, caseInsensitive: bool) -> bool {
  if !caseInsensitive {
    return a == b
  }
  let ba = String.utf8Bytes(a)
  let bb = String.utf8Bytes(b)
  if ba.length != bb.length {
    return false
  }
  let mut i: usize = 0
  while i < ba.length {
    if toLowerAscii(ba[i]) != toLowerAscii(bb[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

/// Returns `true` for UI Events non-character control/function key names (`Enter`, `Tab`, `Backspace`,
/// `Escape`, `Delete`, `Insert`, `Home`, `End`, `PageUp`, `PageDown`, `Arrow*`, `F1`..`F24`).
pub fn isNamedKey(key: string) -> bool {
  if key == "Enter" || key == "Tab" || key == "Backspace" || key == "Escape" || key == "Delete"
    || key == "Insert"
    || key == "Home"
    || key == "End"
    || key == "PageUp"
    || key == "PageDown"
    || key == "ArrowUp"
    || key == "ArrowDown"
    || key == "ArrowLeft"
    || key == "ArrowRight" {
    return true
  }
  let bytes = String.utf8Bytes(key)
  if bytes.length == 2 && bytes[0] == 70 {
    return bytes[1] >= 49 && bytes[1] <= 57
  }
  if bytes.length == 3 && bytes[0] == 70 {
    if bytes[1] == 49 {
      return bytes[2] >= 48 && bytes[2] <= 57
    }
    if bytes[1] == 50 {
      return bytes[2] >= 48 && bytes[2] <= 52
    }
  }
  return false
}

impl KeyRule {
  pub effect fn copy(self: &Self) -> KeyRule
    ! OutOfMemoryError
    ? &mut Allocator {
    return KeyRule {
      action: self.action,
      matchKind: self.matchKind,
      value: run String.copy(String.view(&self.value)),
      modifiersMask: self.modifiersMask,
      modifiersValue: self.modifiersValue,
      anyModifierMask: self.anyModifierMask,
      requireNotComposing: self.requireNotComposing,
      caseInsensitive: self.caseInsensitive,
    }
  }

  pub fn same(self: &Self, other: &Self) -> bool {
    return self.action == other.action
      && self.matchKind == other.matchKind
      && String.view(&self.value) == String.view(&other.value)
      && self.modifiersMask == other.modifiersMask
      && self.modifiersValue == other.modifiersValue
      && self.anyModifierMask == other.anyModifierMask
      && self.requireNotComposing == other.requireNotComposing
      && self.caseInsensitive == other.caseInsensitive
  }

  /// Whether this rule matches key input `(key, code, modifiers, composing)`.
  pub fn matches(self: &Self, key: string, code: string, modifiers: u32, composing: bool) -> bool {
    if self.requireNotComposing && composing {
      return false
    }
    let held = u32.bitAnd(modifiers, MOD_SHIFT + MOD_CONTROL + MOD_ALT + MOD_META)
    if self.modifiersMask != 0 && u32.bitAnd(held, self.modifiersMask) != self.modifiersValue {
      return false
    }
    if self.anyModifierMask != 0 && u32.bitAnd(held, self.anyModifierMask) == 0 {
      return false
    }
    return match self.matchKind {
      KeyMatchKind.LogicalKey => sameKeyText(key, String.view(&self.value), self.caseInsensitive)
      KeyMatchKind.PhysicalCode => code == String.view(&self.value)
      KeyMatchKind.NamedKeys => isNamedKey(key)
      KeyMatchKind.AnyKey => true
    }
  }
}

/// Declarative per-node rules replacing dynamic `decide`: bitmask `actions` (`PREVENT_*`) plus an
/// ordered list of key rules evaluated first-match-wins on the Engine thread.
pub struct PreventDefaultRules {
  pub actions: u32,
  pub keyRules: List<KeyRule>,
}

impl Transferable for PreventDefaultRules {}

impl PreventDefaultRules {
  pub fn empty() -> PreventDefaultRules {
    return PreventDefaultRules { actions: 0, keyRules: List<KeyRule>.make() }
  }

  pub fn fromActions(actions: u32) -> PreventDefaultRules {
    return PreventDefaultRules { actions: actions, keyRules: List<KeyRule>.make() }
  }

  pub effect fn addRule(self: &mut Self, rule: KeyRule) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.keyRules.append(move rule)
  }

  pub effect fn preventKey(
    self: &mut Self,
    key: string,
    modifiersMask: u32,
    modifiersValue: u32,
    requireNotComposing: bool,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.addRule(
      KeyRule {
        action: KeyRuleEffect.Prevent,
        matchKind: KeyMatchKind.LogicalKey,
        value: run String.copy(key),
        modifiersMask: modifiersMask,
        modifiersValue: modifiersValue,
        anyModifierMask: 0,
        requireNotComposing: requireNotComposing,
        caseInsensitive: false,
      },
    )
  }

  pub effect fn preventKeyCase(
    self: &mut Self,
    key: string,
    modifiersMask: u32,
    modifiersValue: u32,
    caseInsensitive: bool,
    requireNotComposing: bool,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.addRule(
      KeyRule {
        action: KeyRuleEffect.Prevent,
        matchKind: KeyMatchKind.LogicalKey,
        value: run String.copy(key),
        modifiersMask: modifiersMask,
        modifiersValue: modifiersValue,
        anyModifierMask: 0,
        requireNotComposing: requireNotComposing,
        caseInsensitive: caseInsensitive,
      },
    )
  }

  pub effect fn preventCode(
    self: &mut Self,
    code: string,
    modifiersMask: u32,
    modifiersValue: u32,
    requireNotComposing: bool,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.addRule(
      KeyRule {
        action: KeyRuleEffect.Prevent,
        matchKind: KeyMatchKind.PhysicalCode,
        value: run String.copy(code),
        modifiersMask: modifiersMask,
        modifiersValue: modifiersValue,
        anyModifierMask: 0,
        requireNotComposing: requireNotComposing,
        caseInsensitive: false,
      },
    )
  }

  pub effect fn allowKey(
    self: &mut Self,
    key: string,
    modifiersMask: u32,
    modifiersValue: u32,
    requireNotComposing: bool,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.addRule(
      KeyRule {
        action: KeyRuleEffect.Allow,
        matchKind: KeyMatchKind.LogicalKey,
        value: run String.copy(key),
        modifiersMask: modifiersMask,
        modifiersValue: modifiersValue,
        anyModifierMask: 0,
        requireNotComposing: requireNotComposing,
        caseInsensitive: false,
      },
    )
  }

  pub effect fn allowKeyCase(
    self: &mut Self,
    key: string,
    modifiersMask: u32,
    modifiersValue: u32,
    caseInsensitive: bool,
    requireNotComposing: bool,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.addRule(
      KeyRule {
        action: KeyRuleEffect.Allow,
        matchKind: KeyMatchKind.LogicalKey,
        value: run String.copy(key),
        modifiersMask: modifiersMask,
        modifiersValue: modifiersValue,
        anyModifierMask: 0,
        requireNotComposing: requireNotComposing,
        caseInsensitive: caseInsensitive,
      },
    )
  }

  pub effect fn allowCode(
    self: &mut Self,
    code: string,
    modifiersMask: u32,
    modifiersValue: u32,
    requireNotComposing: bool,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.addRule(
      KeyRule {
        action: KeyRuleEffect.Allow,
        matchKind: KeyMatchKind.PhysicalCode,
        value: run String.copy(code),
        modifiersMask: modifiersMask,
        modifiersValue: modifiersValue,
        anyModifierMask: 0,
        requireNotComposing: requireNotComposing,
        caseInsensitive: false,
      },
    )
  }

  pub effect fn preventAnyModifier(
    self: &mut Self,
    anyModifierMask: u32,
    requireNotComposing: bool,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.addRule(
      KeyRule {
        action: KeyRuleEffect.Prevent,
        matchKind: KeyMatchKind.AnyKey,
        value: String.make(),
        modifiersMask: 0,
        modifiersValue: 0,
        anyModifierMask: anyModifierMask,
        requireNotComposing: requireNotComposing,
        caseInsensitive: false,
      },
    )
  }

  pub effect fn allowAnyModifier(
    self: &mut Self,
    anyModifierMask: u32,
    requireNotComposing: bool,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.addRule(
      KeyRule {
        action: KeyRuleEffect.Allow,
        matchKind: KeyMatchKind.AnyKey,
        value: String.make(),
        modifiersMask: 0,
        modifiersValue: 0,
        anyModifierMask: anyModifierMask,
        requireNotComposing: requireNotComposing,
        caseInsensitive: false,
      },
    )
  }

  pub effect fn preventNamedKeys(
    self: &mut Self,
    modifiersMask: u32,
    modifiersValue: u32,
    requireNotComposing: bool,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.addRule(
      KeyRule {
        action: KeyRuleEffect.Prevent,
        matchKind: KeyMatchKind.NamedKeys,
        value: String.make(),
        modifiersMask: modifiersMask,
        modifiersValue: modifiersValue,
        anyModifierMask: 0,
        requireNotComposing: requireNotComposing,
        caseInsensitive: false,
      },
    )
  }

  /// Appends `allowed` exceptions (`Allow`) followed by a default-deny `AnyKey` (`Prevent`) rule.
  pub effect fn preventAllKeysExcept(
    self: &mut Self,
    allowed: &[KeyRule],
    requireNotComposing: bool,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < allowed.length {
      let mut copy = run allowed[i].copy()
      copy.action = KeyRuleEffect.Allow
      run self.addRule(move copy)
      i = i + 1
    }
    run self.addRule(
      KeyRule {
        action: KeyRuleEffect.Prevent,
        matchKind: KeyMatchKind.AnyKey,
        value: String.make(),
        modifiersMask: 0,
        modifiersValue: 0,
        anyModifierMask: 0,
        requireNotComposing: requireNotComposing,
        caseInsensitive: false,
      },
    )
  }

  /// Evaluates `keyRules` in declaration order; returns `Some` if an explicit rule matches.
  pub fn evaluateKey(
    self: &Self,
    key: string,
    code: string,
    modifiers: u32,
    composing: bool,
  ) -> Option<KeyRuleEffect> {
    let list = self.keyRules.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].matches(key, code, modifiers, composing) {
        return Option<KeyRuleEffect>.Some { value: list[i].action }
      }
      i = i + 1
    }
    return Option<KeyRuleEffect>.None
  }

  /// Returns `true` when this ruleset prevents the default action of `(key, code, modifiers, composing)`.
  pub fn matchesKey(
    self: &Self,
    key: string,
    code: string,
    modifiers: u32,
    composing: bool,
  ) -> bool {
    return match self.evaluateKey(key, code, modifiers, composing) {
      Option<KeyRuleEffect>.Some { value } => value == KeyRuleEffect.Prevent
      Option<KeyRuleEffect>.None => u32.bitAnd(self.actions, PREVENT_KEYS) != 0 && !composing
    }
  }

  pub fn same(self: &Self, other: &Self) -> bool {
    if self.actions != other.actions || self.keyRules.length() != other.keyRules.length() {
      return false
    }
    let a = self.keyRules.asSlice()
    let b = other.keyRules.asSlice()
    let mut i: usize = 0
    while i < a.length {
      if !a[i].same(&b[i]) {
        return false
      }
      i = i + 1
    }
    return true
  }

  pub effect fn copy(self: &Self) -> PreventDefaultRules
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut rules = List<KeyRule>.make()
    let list = self.keyRules.asSlice()
    let mut i: usize = 0
    while i < list.length {
      run rules.append(run list[i].copy())
      i = i + 1
    }
    return PreventDefaultRules { actions: self.actions, keyRules: move rules }
  }
}
