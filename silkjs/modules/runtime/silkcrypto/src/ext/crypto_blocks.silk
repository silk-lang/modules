//! The ciphers beyond AES's own modes: ARIA, Camellia, SM4 and two-key and three-key DES in the
//! generic modes of silk.crypto.block_cipher, AES and Camellia with ciphertext stealing (CS1, CS2
//! and CS3), AES-XTS, AES-OCB and the CMS 3DES key wrap, by OpenSSL's names and numbers.

import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.crypto.aes { Aes, AesError }
import silk.crypto.aria { Aria }
import silk.crypto.camellia { Camellia }
import silk.crypto.sm4 { Sm4 }
import silk.crypto.des { TripleDes }
import silk.crypto.block_cipher { BlockCipher, BlockCipherError }

pub const F_AES: i32 = 1
pub const F_ARIA: i32 = 2
pub const F_CAMELLIA: i32 = 3
pub const F_SM4: i32 = 4
pub const F_DES_EDE: i32 = 5
pub const F_DES_EDE3: i32 = 6

// Kinds: the generic modes, then the ones run whole.
pub const B_ECB: i32 = 1
pub const B_CBC: i32 = 2
pub const B_CFB: i32 = 3
pub const B_CFB8: i32 = 4
pub const B_CFB1: i32 = 5
pub const B_OFB: i32 = 6
pub const B_CTR: i32 = 7
pub const B_CTS: i32 = 8
pub const B_XTS: i32 = 9
pub const B_OCB: i32 = 10
pub const B_DES3_WRAP: i32 = 11

/// A cipher of the table: the name asked for, OpenSSL's name, its family and kind, and what
/// getCipherInfo reports (OpenSSL's mode number, nid, lengths).
pub struct BlockInfo {
  pub alias: &'static [u8], pub name: &'static [u8], pub family: i32, pub kind: i32, pub mode: i32,
  pub nid: i32, pub keyLength: i32, pub ivLength: i32, pub blockSize: i32,
}
impl Copy for BlockInfo {}
