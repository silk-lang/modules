//! Host 19100 is platformNative: the environment, the working directory and exit, answered by
//! the program's [`Platform`]. `platformNative(op, ...)`: op 0 `getenv(name)` (a string, or
//! undefined), 1 `setenv(name, value)`, 2 `unsetenv(name)`, 3 the names of the environment's
//! variables (an array), 4 the working directory (a string), 5 `chdir(path)`, 6 `exit(status)`.
//! A failure is a negative errno, which the bootstrap turns into Node's error for that call.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.num.f64
import silk.num.usize
import silkjs.js_owned_value { lendFor }
import silkjs.js_realm { lendRealm }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjs.js_std_support as text
import libs.core.common as common
import libs.core.owners as owners
import libs.core.host
import libs.core.capabilities { Composition }

pub const ID: u32 = 19100

unsafe effect fn argumentText<'m, C: Composition>(engine: &mut Engine<'m, host.Services<C>>, context: *mut HeapHeader, argv: &FrameSlots, index: usize) -> List<u8>
  ! OutOfMemoryError | JsException ? &mut Allocator {
  return run text.text(&mut engine, unsafe lendRealm(&context, context), unsafe lendFor(unsafe common.argument(argv, index)))
}

/// The NUL-separated names in `names`, as the elements of `array`.
unsafe effect fn namesBody<'m, C: Composition>(engine: &mut Engine<'m, host.Services<C>>, context: *mut HeapHeader, array: ValueBits, names: &[u8]) -> () ! JsException ? &mut Allocator {
  let mut start: usize = 0
  let mut at: usize = 0
  let mut index: u32 = 0
  while at < names.length {
    if names[at] == 0 {
      let name = run text.string(&mut engine, unsafe lendRealm(&context, context), Slice.view(names, start, at - start))
      run unsafe common.defineIndex(&mut engine, context, array, index, name.intoBits())
      index = index + 1
      start = at + 1
    }
    at = at + 1
  }
}

pub unsafe effect fn dispatch<'m, C: Composition>(engine: &mut Engine<'m, host.Services<C>>, context: *mut HeapHeader, argv: &FrameSlots) -> ValueBits
  ! OutOfMemoryError | JsException ? &mut Allocator {
  let op = (unsafe common.argument(argv, 0)).numericValue()
  if op == 6.0 { return Composition.platformExit(&engine.*, f64.toI32((unsafe common.argument(argv, 1)).numericValue())) }
  if op == 3.0 {
    let mut names = List<u8>.make()
    run Composition.platformNames(&engine.*, &mut names)
    let memory = engine.memory
    let array = run unsafe common.array(&mut engine, memory, context)
    let outcome = run Effect.result(unsafe namesBody(&mut engine, context, array, names.asSlice()))
    match move outcome {
      Result<(), JsException>.Success { .. } => { return array }
      Result<(), JsException>.Failure { error } => { unsafe owners.release(&mut engine, context, array) fail move error }
    }
  }
  let mut into = List<u8>.make()
  if op == 4.0 {
    let status = run Composition.platformCwd(&engine.*, &mut into)
    if status < 0 { return ValueBits.Int { value: status } }
    return (run text.string(&mut engine, unsafe lendRealm(&context, context), into.asSlice())).intoBits()
  }
  let name = run unsafe argumentText(&mut engine, context, argv, 1)
  if op == 0.0 {
    if !(run Composition.platformGetenv(&engine.*, name.asSlice(), &mut into)) { return ValueBits.Undefined }
    return (run text.string(&mut engine, unsafe lendRealm(&context, context), into.asSlice())).intoBits()
  }
  if op == 1.0 {
    let value = run unsafe argumentText(&mut engine, context, argv, 2)
    return ValueBits.Int { value: run Composition.platformSetenv(&engine.*, name.asSlice(), value.asSlice()) }
  }
  if op == 2.0 { return ValueBits.Int { value: run Composition.platformUnsetenv(&engine.*, name.asSlice()) } }
  return ValueBits.Int { value: run Composition.platformChdir(&engine.*, name.asSlice()) }
}
