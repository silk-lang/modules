//! File and HTTP loaders on native workers, and stylesheet fetches through the canvas host.
static if Intrinsic.targetArchitecture() == "wasm32" {
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import ui_tree.legacy { UiTree, TreeError }
  pub import ui_tree.image_load { ImageState }
  import silk.collections.bytes { Bytes }
  import silk.collections.list { List }

  /// A stylesheet fetched by the browser.
  pub struct SheetData {
    pub id: u32,
    pub css: Bytes,
  }

  import silk.core.ownership { Copy }
  import silk.mem.pointer { Pointer }
  import silk.text.string { String }
  import silk.num.i32

  @foreign(noCapture: .("url"))
  unsafe extern "C" fn fetchSheet(url: ?[*]const u8, length: usize) -> u32 as "silk_browser#sheet_fetch"
  unsafe extern "C" fn sheetLength(token: u32) -> i32 as "silk_browser#sheet_length"
  @foreign(noCapture: .("into"))
  unsafe extern "C" fn readSheet(token: u32, into: ?[*]mut u8, length: usize) -> i32 as "silk_browser#sheet_read"
  unsafe extern "C" fn forgetSheet(token: u32) -> () as "silk_browser#sheet_forget"

  struct Entry { id: u32, token: u32, state: ImageState }
  impl Copy for Entry {}
  pub struct Remote { entries: List<Entry>, finished: List<SheetData> }

  impl Remote {
    pub fn make() -> Remote {
      return Remote { entries: List<Entry>.make(), finished: List<SheetData>.make() }
    }

    pub fn forFonts() -> Remote {
      return Remote { entries: List<Entry>.make(), finished: List<SheetData>.make() }
    }

    pub fn forSheets() -> Remote {
      return Remote { entries: List<Entry>.make(), finished: List<SheetData>.make() }
    }

    pub effect fn sheetFile(self: &mut Self, id: u32, path: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {
      run self.sheetUrl(id, path)
    }

    pub effect fn sheetUrl(self: &mut Self, id: u32, url: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {
      self.forget(id)
      let bytes = String.utf8Bytes(url)
      let token = unsafe fetchSheet(Pointer.fromSlice(bytes), bytes.length)
      run self.entries.append(Entry { id: id, token: token, state: if token == 0 { ImageState.Failed } else { ImageState.Loading } })
    }

    pub effect fn takeSheets(self: &mut Self, out: &mut List<SheetData>) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {
      let mut done = Intrinsic.replace(self.finished, List<SheetData>.make())
      while done.length() > 0 { run out.append(done.remove(0)) }
    }

    pub fn forget(self: &mut Self, id: u32) -> () {
      let mut i: usize = 0
      while i < self.entries.length() {
        if self.entries.asSlice()[i].id == id {
          unsafe forgetSheet(self.entries.asSlice()[i].token)
          drop self.entries.remove(i)
          return ()
        }
        i = i + 1
      }
    }

    pub effect fn fontFile(self: &mut Self, face: u32, path: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn fontUrl(self: &mut Self, face: u32, url: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn file(self: &mut Self, resource: u32, path: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn fileIcon(self: &mut Self, resource: u32, path: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn url(self: &mut Self, resource: u32, url: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn urlIcon(self: &mut Self, resource: u32, url: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub fn state(self: &Self, resource: u32) -> ImageState {
      let entries = self.entries.asSlice()
      let mut i: usize = 0
      while i < entries.length {
        if entries[i].id == resource { return entries[i].state }
        i = i + 1
      }
      return ImageState.Failed
    }

    pub fn pending(self: &Self) -> bool {
      let entries = self.entries.asSlice()
      let mut i: usize = 0
      while i < entries.length {
        if entries[i].state == ImageState.Loading { return true }
        i = i + 1
      }
      return false
    }

    pub effect fn poll(self: &mut Self, tree: &mut UiTree<'_>) -> bool
      ! TreeError | OutOfMemoryError
      ? &mut Allocator {
      drop tree
      let mut changed = false
      let mut i: usize = 0
      while i < self.entries.length() {
        let entry = self.entries.asSlice()[i]
        if entry.state == ImageState.Loading {
          let length = unsafe sheetLength(entry.token)
          if length != -2 {
            let mut state = ImageState.Failed
            if length >= 0 && length <= 67108864 {
              let mut bytes = run Bytes.zeroed(i32.toUsize(length))
              let size = bytes.length()
              if (unsafe readSheet(entry.token, Pointer.fromMutSlice(bytes.asMutSlice()), size)) == length {
                run self.finished.append(SheetData { id: entry.id, css: move bytes })
                state = ImageState.Ready
              }
            }
            unsafe forgetSheet(entry.token)
            let entries = self.entries.asMutSlice()
            entries[i].state = state
            changed = true
          }
        }
        i = i + 1
      }
      return changed
    }
  }
} else {
  pub import images { Images as Remote, ImageState, SheetData }
}
