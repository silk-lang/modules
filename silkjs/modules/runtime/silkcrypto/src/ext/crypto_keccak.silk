//! Keccak-p[1600] with 12 or 24 rounds, in Silk: TurboSHAKE (RFC 9861) for TurboSHAKE and
//! KangarooTwelve, KECCAK-KMAC (OpenSSL's cSHAKE core, as a digest) for the JavaScript cSHAKE,
//! and KMAC128 and KMAC256 (NIST SP 800-185).

import silk.mem.pointer { Pointer }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u64
import silk.num.i64
import silk.num.usize
import ext.crypto_algorithms { Call }

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()

fn keccakRoundConstants() -> [u64; 24] {
  return [
    0x0000000000000001,
    0x0000000000008082,
    0x800000000000808a,
    0x8000000080008000,
    0x000000000000808b,
    0x0000000080000001,
    0x8000000080008081,
    0x8000000000008009,
    0x000000000000008a,
    0x0000000000000088,
    0x0000000080008009,
    0x000000008000000a,
    0x000000008000808b,
    0x800000000000008b,
    0x8000000000008089,
    0x8000000000008003,
    0x8000000000008002,
    0x8000000000000080,
    0x000000000000800a,
    0x800000008000000a,
    0x8000000080008081,
    0x8000000000008080,
    0x0000000080000001,
    0x8000000080008008,
  ]
}
fn keccakP(lanes: &mut [u64; 25], rounds: usize) -> () {
  let constants = keccakRoundConstants()
  let rotations: [u64; 25] = [0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14]
  let mut round: usize = 24 - rounds
  while round < 24 {
    let mut columns: [u64; 5] = [0; 5]
    let mut x: usize = 0
    while x < 5 {
      columns[x] = u64.bitXor(u64.bitXor(u64.bitXor(lanes[x], lanes[x + 5]), u64.bitXor(lanes[x + 10], lanes[x + 15])), lanes[x + 20])
      x = x + 1
    }
    x = 0
    while x < 5 {
      let d = u64.bitXor(columns[(x + 4) % 5], u64.rotateLeft(columns[(x + 1) % 5], 1))
      let mut y: usize = 0
      while y < 25 { lanes[x + y] = u64.bitXor(lanes[x + y], d) y = y + 5 }
      x = x + 1
    }
    let mut moved: [u64; 25] = [0; 25]
    x = 0
    while x < 5 {
      let mut y: usize = 0
      while y < 5 {
        moved[y + 5 * ((2 * x + 3 * y) % 5)] = u64.rotateLeft(lanes[x + 5 * y], rotations[x + 5 * y])
        y = y + 1
      }
      x = x + 1
    }
    let mut i: usize = 0
    while i < 25 {
      let row = i - i % 5 let column = i % 5
      lanes[i] = u64.bitXor(moved[i], u64.bitAnd(u64.bitNot(moved[row + (column + 1) % 5]), moved[row + (column + 2) % 5]))
      i = i + 1
    }
    lanes[0] = u64.bitXor(lanes[0], constants[round])
    round = round + 1
  }
}
fn keccakAbsorbByte(lanes: &mut [u64; 25], offset: usize, value: u8) -> () {
  lanes[offset / 8] = u64.bitXor(lanes[offset / 8], u64.shiftLeft(u8.toU64(value), usize.toU64((offset % 8) * 8)))
}
// A sponge of `rate` bytes: absorbs `data`, pads with `domain` and 0x80, squeezes `out`.
struct Sponge { lanes: [u64; 25], offset: usize, rate: usize, rounds: usize }
fn sponge(rate: usize, rounds: usize) -> Sponge { return Sponge { lanes: [0; 25], offset: 0, rate: rate, rounds: rounds } }
fn absorb(s: &mut Sponge, data: &[u8]) -> () {
  let mut i: usize = 0
  while i < data.length {
    keccakAbsorbByte(&mut s.lanes, s.offset, data[i])
    s.offset = s.offset + 1
    if s.offset == s.rate { keccakP(&mut s.lanes, s.rounds) s.offset = 0 }
    i = i + 1
  }
}
fn squeeze(s: &mut Sponge, domain: u8, out: &mut [u8]) -> () {
  keccakAbsorbByte(&mut s.lanes, s.offset, domain)
  keccakAbsorbByte(&mut s.lanes, s.rate - 1, 128)
  keccakP(&mut s.lanes, s.rounds)
  let mut offset: usize = 0
  let mut i: usize = 0
  while i < out.length {
    if offset == s.rate { keccakP(&mut s.lanes, s.rounds) offset = 0 }
    out[i] = u64.toU8(u64.bitAnd(u64.shiftRight(s.lanes[offset / 8], usize.toU64((offset % 8) * 8)), 255))
    offset = offset + 1 i = i + 1
  }
}
// SP 800-185 encodings: left_encode, right_encode, encode_string and bytepad.
fn encodeLength(value: u64, out: &mut [u8; 9], left: bool) -> usize {
  let mut digits: [u8; 8] = [0; 8]
  let mut n: usize = 0
  let mut rest = value
  while true { digits[n] = u64.toU8(u64.bitAnd(rest, 255)) n = n + 1 rest = u64.shiftRight(rest, 8) if rest == 0 { break } }
  let mut at: usize = 0
  if left { out[0] = usize.toU8(n) at = 1 }
  let mut i: usize = 0
  while i < n { out[at + i] = digits[n - 1 - i] i = i + 1 }
  if !left { out[n] = usize.toU8(n) }
  return n + 1
}
fn absorbEncoded(s: &mut Sponge, value: u64, left: bool, count: &mut usize) -> () {
  let mut buffer: [u8; 9] = [0; 9]
  let n = encodeLength(value, &mut buffer, left)
  absorb(&mut s.*, Slice.view<u8>(&buffer, 0, n))
  count.* = count.* + n
}
fn absorbString(s: &mut Sponge, bytes: &[u8], count: &mut usize) -> () {
  absorbEncoded(&mut s.*, usize.toU64(bytes.length * 8), true, &mut count.*)
  absorb(&mut s.*, bytes)
  count.* = count.* + bytes.length
}
fn padTo(s: &mut Sponge, count: usize) -> () {
  let zero: [u8; 1] = [0]
  let mut n = count
  while n % s.rate != 0 { absorb(&mut s.*, &zero) n = n + 1 }
}
/// KMAC (strength 128 or 256) of `data` under `key` with customization `custom`, `out.length`
/// bytes long.
pub fn kmac(strength: usize, key: &[u8], data: &[u8], custom: &[u8], out: &mut [u8]) -> () {
  let rate: usize = if strength == 128 { 168 } else { 136 }
  let mut s = sponge(rate, 24)
  let mut count: usize = 0
  absorbEncoded(&mut s, usize.toU64(rate), true, &mut count)
  absorbString(&mut s, b"KMAC", &mut count)
  absorbString(&mut s, custom, &mut count)
  padTo(&mut s, count)
  count = 0
  absorbEncoded(&mut s, usize.toU64(rate), true, &mut count)
  absorbString(&mut s, key, &mut count)
  padTo(&mut s, count)
  absorb(&mut s, data)
  let mut ignored: usize = 0
  absorbEncoded(&mut s, usize.toU64(out.length * 8), false, &mut ignored)
  squeeze(&mut s, 4, move out)
}

unsafe fn argument<'a>(anchor: &'a (), c: &Call, i: usize) -> &'a [u8] {
  if c.lengths[i] == 0 || Pointer.isNull<u8>(c.data[i]) { return Slice.view<u8>(&EMPTY, 0, 0) }
  return unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(c.data[i])), c.lengths[i])
}
const EMPTY: [u8; 1] = [0]
unsafe fn reserve(c: &mut Call, n: usize) -> bool {
  let p = unsafe calloc(1, if n == 0 { 1 } else { n })
  if Pointer.isNull<u8>(p) { return false }
  unsafe free(c.output)
  c.output = p c.length = n c.capacity = if n == 0 { 1 } else { n }
  return true
}
unsafe fn output<'a>(anchor: &'a mut (), c: &Call) -> &'a mut [u8] {
  return unsafe Pointer.borrowManyMut<(), u8>(move anchor, unsafe Pointer.assumeManyMut<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(c.output)), c.length)
}
fn startsWithName(name: &[u8], prefix: &[u8]) -> bool {
  if name.length < prefix.length { return false }
  let mut i: usize = 0
  while i < prefix.length { let b = name[i] if (if b >= 97 && b <= 122 { b - 32 } else { b }) != prefix[i] { return false } i = i + 1 }
  return true
}
/// Whether op 6 (a digest) names KECCAK-KMAC-128 or KECCAK-KMAC-256.
pub unsafe fn isKeccakKmac(c: &Call) -> bool { let anchor = () return startsWithName(unsafe argument(&anchor, &c.*, 0), b"KECCAK-KMAC-") }
/// TurboSHAKE (76), the KECCAK-KMAC digest (6) and KMAC (147).
pub unsafe fn execute(c: &mut Call) -> bool {
  let anchor = ()
  if c.op == 76 {
    let rate: usize = if c.numbers[1] == 128 { 168 } else { 136 }
    let domain = i64.toU8(c.numbers[2])
    let data = unsafe argument(&anchor, &c.*, 0)
    let mut a = ()
    let wanted = i64.toUsize(c.numbers[3])
    if !unsafe reserve(&mut c.*, wanted) { return false }
    let out = unsafe output(&mut a, &c.*)
    let mut s = sponge(rate, 12)
    absorb(&mut s, data)
    squeeze(&mut s, domain, move out)
    return true
  }
  if c.op == 6 {
    let name = unsafe argument(&anchor, &c.*, 0)
    let rate: usize = if startsWithName(name, b"KECCAK-KMAC-128") { 168 } else { 136 }
    let data = unsafe argument(&anchor, &c.*, 1)
    let mut a = ()
    let wanted = i64.toUsize(c.numbers[2])
    if !unsafe reserve(&mut c.*, wanted) { return false }
    let out = unsafe output(&mut a, &c.*)
    let mut s = sponge(rate, 24)
    absorb(&mut s, data)
    squeeze(&mut s, 4, move out)
    return true
  }
  let name = unsafe argument(&anchor, &c.*, 0)
  let strength: usize = if startsWithName(name, b"KMAC-128") { 128 } else { 256 }
  let key = unsafe argument(&anchor, &c.*, 1)
  let data = unsafe argument(&anchor, &c.*, 2)
  let custom = unsafe argument(&anchor, &c.*, 3)
  let mut a = ()
  let wanted = i64.toUsize(c.numbers[4])
    if !unsafe reserve(&mut c.*, wanted) { return false }
    let out = unsafe output(&mut a, &c.*)
  kmac(strength, key, data, custom, move out)
  return true
}

/// SHAKE128 (rate 168) or SHAKE256 (rate 136) of the concatenation of `first` and `second`, into
/// `out`; for ext/crypto_mldsa.
pub fn shake(rate: usize, first: &[u8], second: &[u8], out: &mut [u8]) -> () {
  let mut s = sponge(rate, 24)
  absorb(&mut s, first)
  absorb(&mut s, second)
  squeeze(&mut s, 31, move out)
}
