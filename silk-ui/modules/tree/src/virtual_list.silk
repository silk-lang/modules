//! Tree-owned variable-height virtualization for native and foreign-language clients.
//! Only the visible range and an overscan region need UI nodes. Measured heights
//! replace estimates, while the tree preserves the first visible item.
pub import ui_protocol.options { VirtualOptions, VirtualItem, VirtualRange }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.usize

/// Retained geometry for one virtual list. Managed by `UiTree`; clients configure it with mutations.
pub struct VirtualList {
  /// Current list configuration.
  pub options: VirtualOptions,
  /// Logical item count, independent of measurement storage.
  pub count: usize,
  /// Materialized strides, allocated only after a row differs from the estimate.
  pub heights: List<f32>,
  sums: List<f64>,
  /// Mounted client items in logical order.
  pub rows: List<VirtualItem>,
  /// Private layout-node IDs for omitted content and inter-item gaps.
  pub spacers: List<usize>,
  /// Last applied heights of the private layout nodes.
  pub spacerHeights: List<f32>,
  /// Client node ID of the scroll container.
  pub port: u32,
  /// First item in the mounted viewport range.
  pub first: usize,
  /// Exclusive end of the mounted viewport range.
  pub end: usize,
  /// Current vertical offset in CSS pixels.
  pub scroll: f32,
  /// Last measured width of the scroll container.
  pub width: f32,
  /// Last measured height of the scroll container.
  pub height: f32,
  /// Whether the tree must restore the scroll anchor.
  pub correction: bool,
  /// The item count the measurements are for while a count change waits for the rows that
  /// say where items came and went (see `remap`), or `usize.MAX`.
  pub previous: usize,
}

impl VirtualList {
  /// Creates empty controller geometry. Use tree mutations to attach a controller.
  pub fn make(options: VirtualOptions) -> VirtualList {
    return VirtualList {
      options: options,
      count: 0,
      heights: List<f32>.make(),
      sums: List<f64>.make(),
      rows: List<VirtualItem>.make(),
      spacers: List<usize>.make(),
      spacerHeights: List<f32>.make(),
      port: 0,
      first: 0,
      end: 0,
      scroll: 0.0,
      width: 0.0,
      height: 800.0,
      correction: false,
      previous: usize.MAX,
    }
  }

  /// Replaces all measurements with estimates for `count` items.
  pub effect fn reset(self: &mut Self, count: usize, options: VirtualOptions) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.options = options
    self.count = count
    self.heights = List<f32>.make()
    self.sums = List<f64>.make()
    self.previous = usize.MAX
    drop self.range(true)
  }

  /// The count becomes `count` and the measurements stay with their items: `before` are the
  /// rows bound to the old count and `after` the rows bound to the new one, and a row bound in
  /// both pins its item's old index to its new one. Items come and go between pinned rows,
  /// just before the first, or just after the last, so measured items keep their heights and
  /// the item at the top of the viewport keeps its offset. Returns whether the scroll moved.
  pub effect fn remap(self: &mut Self, count: usize, before: &[VirtualItem], after: &[VirtualItem]) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let old = if self.previous == usize.MAX { self.count } else { self.previous }
    self.count = old
    self.previous = usize.MAX
    // Pins in order: each one later than the last in both lists.
    let mut from = List<usize>.make()
    let mut to = List<usize>.make()
    let mut a: usize = 0
    while a < after.length {
      let mut b: usize = 0
      while b < before.length && before[b].id != after[a].id {
        b = b + 1
      }
      if b < before.length && before[b].index < old && after[a].index < count
        && (from.length() == 0 || (before[b].index > from.get(from.length() - 1)
          && after[a].index > to.get(to.length() - 1))) {
        run from.append(before[b].index)
        run to.append(after[a].index)
      }
      a = a + 1
    }
    let top = self.locate(self.scroll)
    let offset = self.scroll - self.prefix(top)
    let anchor = moved(top, old, count, from.asSlice(), to.asSlice())
    self.count = count
    if self.heights.length() != 0 {
      let estimate = self.stride()
      let mut heights = List<f32>.make()
      run heights.appendRepeated(estimate, count)
      // Before the first pin the items line up at its end, after the last at its start, and
      // between two pins at the earlier one.
      let mut segment: usize = 0
      while segment <= from.length() {
        let oldStart = if segment == 0 { 0 } else { from.get(segment - 1) + 1 }
        let oldEnd = if segment == from.length() { old } else { from.get(segment) }
        let newStart = if segment == 0 { 0 } else { to.get(segment - 1) + 1 }
        let newEnd = if segment == from.length() { count } else { to.get(segment) }
        let oldLength = oldEnd - oldStart
        let newLength = newEnd - newStart
        let length = if oldLength < newLength { oldLength } else { newLength }
        let lead = segment == 0 && from.length() != 0
        let mut i: usize = 0
        while i < length {
          let source = if lead { oldEnd - length + i } else { oldStart + i }
          let target = if lead { newEnd - length + i } else { newStart + i }
          heights.set(target, self.heights.get(source))
          i = i + 1
        }
        if segment < from.length() {
          heights.set(to.get(segment), self.heights.get(from.get(segment)))
        }
        segment = segment + 1
      }
      // The Fenwick sums of the new heights, in one pass.
      let mut sums = List<f64>.make()
      run sums.appendRepeated(0.0, count + 1)
      let mut i: usize = 1
      while i <= count {
        let sum = sums.get(i) + f32.toF64(heights.get(i - 1))
        sums.set(i, sum)
        let parent = i + (i - usize.bitAnd(i, i - 1))
        if parent <= count {
          let up = sums.get(parent) + sum
          sums.set(parent, up)
        }
        i = i + 1
      }
      self.heights = move heights
      self.sums = move sums
    }
    let scroll = if anchor < count { self.prefix(anchor) + offset } else { self.prefix(count) }
    let shift = f32.abs(scroll - self.scroll) > 0.01
    self.scroll = scroll
    drop self.range(true)
    return shift
  }

  fn stride(self: &Self) -> f32 {
    return f32.max(1.0, self.options.estimatedHeight) + self.options.gap
  }

  effect fn materialize(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let estimate = self.stride()
    let mut heights = List<f32>.make()
    let mut sums = List<f64>.make()
    run heights.appendRepeated(estimate, self.count)
    run sums.append(0.0)
    let mut i: usize = 1
    while i <= self.count {
      let low = i - usize.bitAnd(i, i - 1)
      run sums.append(usize.toF64(low) * f32.toF64(estimate))
      i = i + 1
    }
    self.heights = move heights
    self.sums = move sums
  }

  /// Returns the estimated or measured position before item `end`.
  /// `end` must not exceed the item count.
  pub fn prefix(self: &Self, end: usize) -> f32 {
    if self.heights.length() == 0 {
      return f64.toF32(usize.toF64(end) * f32.toF64(self.stride()))
    }
    let mut i = end
    let mut total = 0.0
    while i > 0 {
      total = total + self.sums.get(i)
      i = usize.bitAnd(i, i - 1)
    }
    return f64.toF32(total)
  }

  /// Returns the item at `position`, or the item count at the end.
  pub fn locate(self: &Self, position: f32) -> usize {
    if self.heights.length() == 0 {
      let index = f32.toF64(f32.max(0.0, position)) / f32.toF64(self.stride())
      return if index >= usize.toF64(self.count) { self.count } else { f64.toUsize(index) }
    }
    let mut bit: usize = 1
    while bit <= self.heights.length() / 2 {
      bit = bit * 2
    }
    let mut at: usize = 0
    let mut sum = 0.0
    while bit > 0 {
      let next = at + bit
      if next <= self.heights.length() && sum + self.sums.get(next) <= f32.toF64(position) {
        at = next
        sum = sum + self.sums.get(next)
      }
      bit = bit / 2
    }
    return at
  }

  /// Updates one measured height and returns whether it changed.
  /// `index` must be less than the item count.
  pub effect fn measure(self: &mut Self, index: usize, height: f32) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let value = f32.max(1.0, height)
    let uniform = self.heights.length() == 0
    let previous = if uniform { self.stride() } else { self.heights.get(index) }
    let delta = value - previous
    if f32.abs(delta) < 0.25 {
      return false
    }
    if uniform { run self.materialize() }
    self.heights.set(index, value)
    let mut i = index + 1
    while i < self.sums.length() {
      let sum = self.sums.get(i) + f32.toF64(delta)
      self.sums.set(i, sum)
      i = i + (i - usize.bitAnd(i, i - 1))
    }
    return true
  }

  /// Updates the mounted range, retaining overscan until its inner margin is crossed.
  pub fn range(self: &mut Self, force: bool) -> bool {
    let overscan = f32.max(0.0, self.options.overscan)
    let margin = overscan * 0.25
    if !force && (self.first == 0 || self.prefix(self.first) <= self.scroll - margin)
      && (self.end == self.count
        || self.prefix(self.end) >= self.scroll + self.height + margin) {
      return false
    }
    let first = self.locate(f32.max(0.0, self.scroll - overscan))
    let candidate = self.locate(self.scroll + self.height + overscan) + 1
    let end = if candidate < self.count {
      candidate
    } else {
      self.count
    }
    let changed = first != self.first || end != self.end
    self.first = first
    self.end = end
    return changed
  }
}

/// Where old index `index` of `old` items is after `remap` to `count` with pins `from` → `to`.
fn moved(index: usize, old: usize, count: usize, from: &[usize], to: &[usize]) -> usize {
  if index >= old {
    return count
  }
  let mut segment: usize = 0
  while segment < from.length && from[segment] < index {
    segment = segment + 1
  }
  if segment < from.length && from[segment] == index {
    return to[segment]
  }
  let oldStart = if segment == 0 { 0 } else { from[segment - 1] + 1 }
  let oldEnd = if segment == from.length { old } else { from[segment] }
  let newStart = if segment == 0 { 0 } else { to[segment - 1] + 1 }
  let newEnd = if segment == from.length { count } else { to[segment] }
  let target = if segment == 0 && from.length != 0 {
    // Lined up at the pin's end: an item that no longer fits came out.
    if newEnd < oldEnd - index { return newStart }
    newEnd - (oldEnd - index)
  } else {
    newStart + (index - oldStart)
  }
  return if target < newEnd { target } else if newEnd > newStart { newEnd - 1 } else { newEnd }
}

import engine { UiTree, TreeError }
import node { NONE }
import mutation { NodeKind }
import inspect { info, NodeInfo }
import interact
import layout.lib { NodeId, Style, SizeValue }
import silk.core.option { Option }
import silk.core.effect { Effect }

fn find(tree: &UiTree<'_>, id: u32) -> usize {
  let mut i: usize = 0
  while i < tree.virtualLists.length() {
    if tree.virtualLists.asSlice()[i].port == id {
      return i
    }
    i = i + 1
  }
  return usize.MAX
}

/// Returns a plain-data request for a configured container, or `None`.
pub fn request(tree: &UiTree<'_>, id: u32) -> Option<VirtualRange> {
  let index = find(tree, id)
  if index == usize.MAX {
    return Option<VirtualRange>.None
  }
  let list = &tree.virtualLists.asSlice()[index]
  let mut pinnedId = NONE
  let mut pinned = usize.MAX
  let mut r: usize = 0
  while r < list.rows.length() {
    let row = list.rows.get(r)
    let mut focused = tree.focused
    while focused != NONE {
      if tree.node(focused).id == row.id {
        pinned = row.index
        pinnedId = row.id
        break
      }
      focused = tree.node(focused).parent
    }
    r = r + 1
  }
  return Option<VirtualRange>.some(
    VirtualRange {
      count: list.count,
      first: list.first,
      end: list.end,
      pinned: pinned,
      pinnedId: pinnedId,
    },
  )
}

/// Installs or updates a controller. Called by `Mutation.SetVirtualList`.
/// Returns whether the controller or its requested range changed.
pub effect fn configure(
  tree: &mut UiTree<'_>,
  mutation: usize,
  id: u32,
  count: usize,
  options: VirtualOptions,
) -> bool
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let slot = tree.slotOf(id)
  if slot == NONE {
    fail TreeError.UnknownNode { index: mutation, id: id }
  }
  if tree.node(slot).kind != NodeKind.Box {
    fail TreeError.WrongKind { index: mutation, id: id }
  }
  if !f32.isFinite(options.estimatedHeight) || options.estimatedHeight <= 0.0
    || !f32.isFinite(options.overscan)
    || options.overscan < 0.0
    || !f32.isFinite(options.gap)
    || options.gap < 0.0
    || count == usize.MAX
    || !f32.isFinite((f32.max(1.0, options.estimatedHeight) + options.gap) * usize.toF32(count)) {
    fail TreeError.BadVirtualList { index: mutation, id: id }
  }
  let mut at = find(&tree, id)
  let mut changed = false
  if at == usize.MAX {
    changed = true
    at = tree.virtualLists.length()
    let mut list = VirtualList.make(options)
    list.port = id
    run tree.virtualLists.append(move list)
  }
  let list = &mut tree.virtualLists.asMutSlice()[at]
  let known = if list.previous == usize.MAX { list.count } else { list.previous }
  if list.count != count && known != 0 && list.options.revision == options.revision
    && list.options.estimatedHeight == options.estimatedHeight
    && list.options.gap == options.gap {
    // Items came or went: the rows bound next say where (see `bind` and `prepare`).
    if list.previous == usize.MAX {
      list.previous = list.count
    }
    list.count = count
    list.options = options
    return true
  }
  if list.previous != usize.MAX {
    changed = true
    list.count = list.previous
    list.previous = usize.MAX
  }
  if list.count != count || list.options.revision != options.revision
    || list.options.estimatedHeight != options.estimatedHeight
    || list.options.gap != options.gap {
    changed = true
    let old = list.locate(list.scroll)
    let offset = list.scroll - list.prefix(old)
    let anchor = if old < count {
      old
    } else {
      count
    }
    run list.reset(count, options)
    list.scroll = list.prefix(anchor) + offset
    list.correction = true
  }
  let overscanChanged = list.options.overscan != options.overscan
  if overscanChanged {
    changed = true
  }
  list.options = options
  if list.range(overscanChanged) {
    changed = true
  }
  return changed
}

/// Binds sorted direct children to indices. Invalid bindings leave the previous bindings intact.
/// Returns whether the bound items or pending remapping changed.
pub effect fn bind(tree: &mut UiTree<'_>, mutation: usize, id: u32, items: List<VirtualItem>) -> bool
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let at = find(&tree, id)
  if at == usize.MAX {
    fail TreeError.BadVirtualList { index: mutation, id: id }
  }
  let mut children = List<u32>.make()
  run tree.childSlots(tree.slotOf(id), &mut children)
  let mut child = children.length()
  while child > 0 {
    child = child - 1
    if tree.node(children.get(child)).isGenerated() { drop children.remove(child) }
  }
  let values = items.asSlice()
  if children.length() != values.length {
    fail TreeError.BadVirtualList { index: mutation, id: id }
  }
  let count = tree.virtualLists.asSlice()[at].count
  let mut i: usize = 0
  while i < values.length {
    let item = values[i]
    let slot = tree.slotOf(item.id)
    if slot == NONE || tree.node(slot).kind != NodeKind.Box || children.get(i) != slot
      || item.index >= count
      || (i > 0 && values[i - 1].index >= item.index) {
      fail TreeError.BadVirtualList { index: mutation, id: id }
    }
    i = i + 1
  }
  let list = &mut tree.virtualLists.asMutSlice()[at]
  let mut changed = list.previous != usize.MAX
  if !changed {
    let existing = list.rows.asSlice()
    if existing.length != values.length {
      changed = true
    } else {
      let mut k: usize = 0
      while k < values.length {
        if existing[k].index != values[k].index || existing[k].id != values[k].id {
          changed = true
          break
        }
        k = k + 1
      }
    }
  }
  if list.previous != usize.MAX {
    let count = list.count
    let before = Intrinsic.replace(list.rows, List<VirtualItem>.make())
    if run list.remap(count, before.asSlice(), items.asSlice()) {
      list.correction = true
    }
  }
  list.rows = move items
  return changed
}

effect fn layoutError<E>(error: E) -> never
  ! TreeError {
  drop error
  fail TreeError.Layout
}

/// Removes a controller and private layout nodes without destroying client items.
pub effect fn clear(tree: &mut UiTree<'_>, id: u32) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let at = find(&tree, id)
  if at == usize.MAX {
    return ()
  }
  let removed = tree.virtualLists.remove(at)
  let mut i: usize = 0
  while i < removed.spacers.length() {
    let node = NodeId { index: removed.spacers.get(i) }
    if tree.layout.contains(node) {
      run Effect.catchAll(tree.layout.destroy(node), layoutError)
    }
    i = i + 1
  }
}

/// Updates private spacers and pending scroll corrections before layout.
pub effect fn prepare(tree: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut v: usize = 0
  while v < tree.virtualLists.length() {
    let portId = tree.virtualLists.asSlice()[v].port
    let port = tree.slotOf(portId)
    if port == NONE {
      run clear(&mut tree, portId)
      continue
    }
    let waiting = &mut tree.virtualLists.asMutSlice()[v]
    if waiting.previous != usize.MAX {
      // No rows were bound since the count changed: the bound ones kept their indices.
      let count = waiting.count
      let rows = Intrinsic.replace(waiting.rows, List<VirtualItem>.make())
      if run waiting.remap(count, rows.asSlice(), rows.asSlice()) {
        waiting.correction = true
      }
      waiting.rows = move rows
    }
    let css = tree.node(port).css
    let mut rowCss = List<usize>.make()
    let mut r: usize = 0
    while r < tree.virtualLists.asSlice()[v].rows.length() {
      let row = tree.virtualLists.asSlice()[v].rows.get(r)
      let slot = tree.slotOf(row.id)
      if slot == NONE || tree.node(slot).parent != port
        || row.index >= tree.virtualLists.asSlice()[v].count {
        drop tree.virtualLists.asMutSlice()[v].rows.remove(r)
      } else {
        run rowCss.append(tree.node(slot).css)
        r = r + 1
      }
    }
    let after = match tree.node(port).identity() {
      Option.Some { value } => if value.after != NONE { tree.node(value.after).css } else { usize.MAX }
      _ => usize.MAX
    }
    let list = &mut tree.virtualLists.asMutSlice()[v]
    while list.spacers.length() > list.rows.length() + 1 {
      let at = list.spacers.length() - 1
      let node = NodeId { index: list.spacers.get(at) }
      run Effect.catchAll(tree.layout.destroy(node), layoutError)
      list.spacers.truncate(at)
      list.spacerHeights.truncate(at)
    }
    while list.spacers.length() < list.rows.length() + 1 {
      let node = run tree.layout.create(Style.make())
      run list.spacers.append(node.index)
      run list.spacerHeights.append(-1.0)
      while tree.slotOfCss.length() <= node.index {
        run tree.slotOfCss.append(NONE)
      }
      tree.slotOfCss.set(node.index, NONE)
    }
    let mut i: usize = 0
    let mut cursor: usize = 0
    while i < list.spacers.length() {
      let last = i == list.rows.length()
      let end = if last {
        list.count
      } else {
        list.rows.get(i).index
      }
      let gap: f32 = if i > 0 {
        list.options.gap
      } else {
        0.0
      }
      let height = f32.max(0.0, list.prefix(end) - list.prefix(cursor) + gap)
      let spacer = NodeId { index: list.spacers.get(i) }
      if list.spacerHeights.get(i) != height {
        let mut style = Style.make()
        style.height = SizeValue.px(height)
        style.flexShrink = 0.0
        run Effect.catchAll(tree.layout.setStyle(spacer, move style), layoutError)
        list.spacerHeights.set(i, height)
      }
      let before = if last {
        if after == usize.MAX { Option<NodeId>.None } else { Option<NodeId>.some(NodeId { index: after }) }
      } else {
        Option<NodeId>.some(NodeId { index: rowCss.get(i) })
      }
      let expected = match before {
        Option<NodeId>.Some { value } => value.index
        Option<NodeId>.None => usize.MAX
      }
      if tree.layout.parent(spacer.index) != css || tree.layout.nextSibling(spacer.index) != expected {
        run Effect.catchAll(
          tree.layout.insertBefore(NodeId { index: css }, spacer, before),
          layoutError,
        )
      }
      if !last {
        cursor = list.rows.get(i).index + 1
      }
      i = i + 1
    }
    let correction = list.correction
    let scroll = list.scroll
    list.correction = false
    if correction {
      run interact.scrollTo(&mut tree, port, 0.0, scroll)
    }
    v = v + 1
  }
}

/// Measures bound rows, maintains focus retention, and computes requested ranges after layout.
/// Returns whether spacer geometry or scroll anchoring requires another layout pass.
pub effect fn settle(tree: &mut UiTree<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut changed = false
  let mut v: usize = 0
  while v < tree.virtualLists.length() {
    let id = tree.virtualLists.asSlice()[v].port
    if let Option<NodeInfo>.Some { value: port } = run info(&tree, id) {
      if port.laidOut {
        let mut measured = List<f32>.make()
        let mut r: usize = 0
        while r < tree.virtualLists.asSlice()[v].rows.length() {
          let row = tree.virtualLists.asSlice()[v].rows.get(r)
          let height: f32 = match run info(&tree, row.id) {
            Option<NodeInfo>.Some { value } => if value.laidOut {
              value.bounds.height()
            } else {
              -1.0
            }
            Option<NodeInfo>.None => -1.0
          }
          run measured.append(height)
          r = r + 1
        }
        let list = &mut tree.virtualLists.asMutSlice()[v]
        list.scroll = port.scrollY
        list.height = port.bounds.height()
        let anchor = list.locate(list.scroll)
        let before = list.prefix(anchor)
        let mut resized = false
        if list.width != 0.0 && f32.abs(list.width - port.bounds.width()) > 0.5 {
          let count = list.count
          let options = list.options
          run list.reset(count, options)
          resized = true
        }
        list.width = port.bounds.width()
        let mut i: usize = 0
        while i < measured.length() {
          let row = list.rows.get(i)
          if measured.get(i) >= 0.0 && row.index < list.count {
            let height = measured.get(i) + list.options.gap
            if run list.measure(row.index, height) {
              resized = true
            }
          }
          i = i + 1
        }
        if resized {
          let shift = list.prefix(anchor) - before
          list.scroll = f32.max(0.0, list.scroll + shift)
          list.correction = f32.abs(shift) > 0.01
          changed = true
        }
        drop list.range(false)
      }
    }
    v = v + 1
  }
  return changed
}
