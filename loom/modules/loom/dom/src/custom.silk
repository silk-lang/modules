import css_style.lexer
import css_style.input { Input }
import css_style.declaration_values
import css_style.cssom_serialization
import css_style.tokens { Limits, CssError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

pub effect fn normalized(text: &String) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let parsed = run Effect.result(parse(text))
  return match move parsed {
    Result<Option<Bytes>, CssError | OutOfMemoryError>.Success { value } => move value
    Result<Option<Bytes>, CssError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      CssError _ => Option<Bytes>.None
    }
  }
}

effect fn parse(text: &String) -> Option<Bytes> ! CssError | OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(text.ownedUtf8Bytes(), &limits)
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let checked = run declaration_values.validate(&input, &limits)
  if !checked.valid { return Option<Bytes>.None }
  return Option<Bytes>.some(run cssom_serialization.components(&buffer, buffer.all()))
}

pub effect fn declaration(out: &mut Bytes, name: &String, value: &Bytes, important: bool) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let escaped = run cssom_serialization.identifier(name.ownedUtf8Bytes())
  run out.append(escaped.asSlice())
  run out.append(b": ")
  let text = value.asSlice()
  let mut i: usize = 0
  while i < text.length {
    if text[i] == 60 { run out.append(b"\\3c ") }
    else { run out.append(&[text[i]]) }
    i = i + 1
  }
  if important { run out.append(b" !important") }
  run out.append(b";")
}
