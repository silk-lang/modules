const UV_EAI_SOCKTYPE: i32 = -3011
const UV_EAI_BADHINTS: i32 = -3013
const UV_EAI_PROTOCOL: i32 = -3014
// IOV_MAX on both targets (libuv's uv__getiovmax).
const IOV_MAX: u32 = 1024
const SSIZE_MAX: i64 = 9223372036854775807
// Common errno values.
const EPERM: i32 = 1
const ENOENT: i32 = 2
const EINTR: i32 = 4
const EIO: i32 = 5
const E2BIG: i32 = 7
const ENOMEM: i32 = 12
const EACCES: i32 = 13
const EBUSY: i32 = 16
const EXDEV: i32 = 18
const EINVAL: i32 = 22
const ESPIPE: i32 = 29
const POLLOUT: i16 = 4
const F_GETFD: i32 = 1
const F_SETFD: i32 = 2
const FD_CLOEXEC: i32 = 1
const O_RDONLY: i32 = 0
const O_WRONLY: i32 = 1
const DT_FIFO: u8 = 1
const DT_CHR: u8 = 2
const DT_DIR: u8 = 4
const DT_BLK: u8 = 6
const DT_REG: u8 = 8
const DT_LNK: u8 = 10
const DT_SOCK: u8 = 12
const AF_INET: u32 = 2

extern "C" struct PollFd { fd: i32, events: i16, revents: i16 }

unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
unsafe extern "C" fn abort() -> ()
@foreign(noCapture: .("text"))
unsafe extern "C" fn strlen(text: *const u8) -> usize
unsafe extern "C" fn strcmp(left: *const u8, right: *const u8) -> i32
@foreign(noCapture: .("dest", "source"))
unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, count: usize) -> *mut u8
unsafe extern "C" fn access(path: ?[*]const u8, mode: i32) -> i32
unsafe extern "C" fn chmod(path: *const u8, mode: u32) -> i32
unsafe extern "C" fn chown(path: *const u8, uid: u32, gid: u32) -> i32
unsafe extern "C" fn lchown(path: *const u8, uid: u32, gid: u32) -> i32
unsafe extern "C" fn fchown(fd: i32, uid: u32, gid: u32) -> i32
unsafe extern "C" fn fsync(fd: i32) -> i32
unsafe extern "C" fn ftruncate(fd: i32, length: i64) -> i32
unsafe extern "C" fn fcntl(fd: i32, command: i32, ...) -> i32
unsafe extern "C" fn open(path: *const u8, flags: i32, ...) -> i32
unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize
unsafe extern "C" fn write(fd: i32, buffer: *const u8, count: usize) -> isize
unsafe extern "C" fn pread(fd: i32, buffer: ?[*]mut u8, count: usize, offset: i64) -> isize
unsafe extern "C" fn pwrite(fd: i32, buffer: ?[*]const u8, count: usize, offset: i64) -> isize
unsafe extern "C" fn readv(fd: i32, vectors: ?[*]const Buf, count: i32) -> isize
unsafe extern "C" fn writev(fd: i32, vectors: ?[*]const Buf, count: i32) -> isize
unsafe extern "C" fn preadv(fd: i32, vectors: ?[*]const Buf, count: i32, offset: i64) -> isize
unsafe extern "C" fn pwritev(fd: i32, vectors: ?[*]const Buf, count: i32, offset: i64) -> isize
unsafe extern "C" fn utimensat(directory: i32, path: ?[*]const u8, times: ?[*]const Timespec, flags: i32) -> i32
unsafe extern "C" fn futimens(fd: i32, times: ?[*]const Timespec) -> i32
unsafe extern "C" fn link(existing: ?[*]const u8, created: ?[*]const u8) -> i32
unsafe extern "C" fn symlink(target: ?[*]const u8, path: ?[*]const u8) -> i32
unsafe extern "C" fn readlink(path: ?[*]const u8, buffer: ?[*]mut u8, size: usize) -> isize
unsafe extern "C" fn rename(from: ?[*]const u8, to: ?[*]const u8) -> i32
unsafe extern "C" fn unlink(path: ?[*]const u8) -> i32
unsafe extern "C" fn rmdir(path: ?[*]const u8) -> i32
unsafe extern "C" fn pathconf(path: ?[*]const u8, name: i32) -> i64
unsafe extern "C" fn realpath(path: *const u8, result: ?*mut u8) -> ?*mut u8
unsafe extern "C" fn mkdtemp(template: *mut u8) -> ?*mut u8
unsafe extern "C" fn mkstemp(template: *mut u8) -> i32
unsafe extern "C" fn mkostemp(template: *mut u8, flags: i32) -> i32
