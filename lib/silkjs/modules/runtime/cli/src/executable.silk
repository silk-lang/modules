//! The executable's program: the runtime with the real implementation of every capability, the
//! package manager's commands, and the Node-API exports. ./silkjs is the executable; ./silk is the
//! same with the Silk libraries in place of the C ones.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.system.host_input { HostInput, HostInputError }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_libc_platform as platform
import silkjsruntime.runtime.worker
import silkjsruntime.ext.keep_exports
import napi_exports
import silkjsruntime.libs.core.capabilities { Compression, Crypto, Http, Http2, Tls, Capabilities, EmptyHostApi, OsProcesses, OsNetwork, OsSystemInfo, ThreadWorkers }
import silkjsruntime.libs.core.module_sources { NodeResolution }
import silkjsruntime.libs.core.platforms { OsPlatform }
import silkjsruntime.libs.core.files { OsFiles }
import wasm.wamr { WamrWasm }
import compress.compress { NativeCompression }
import http2.nghttp2 { Nghttp2 }
import http.llhttp { Llhttp }
import database.sqlite_database { SqliteDatabase }
import openssl.openssl_capabilities { OpenSslCrypto, OpenSslTls }
import inspector.node_inspector { NodeInspector }
import amaro.amaro_stripping { Amaro }
import addons.dlopen_addons { DlopenAddons }
import pm.cli
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.ownership { Copy }

unsafe extern "C" fn signal(number: i32, handler: usize) -> usize

// Whether the path the executable was called by ends in the name `node`.
fn calledNode(path: &[u8]) -> bool {
  let name = b"node"
  if path.length < name.length {
    return false
  }
  let start = path.length - name.length
  let mut index: usize = 0
  while index < name.length {
    if path[start + index] != name[index] {
      return false
    }
    index = index + 1
  }
  return start == 0 || path[start - 1] == 47
}

/// The executable with `compression`, `sessions`, `crypto`, `http` and `tls` as its Compression,
/// Http2, Crypto, Http and Tls capabilities (the executable has NativeCompression, Nghttp2,
/// OpenSslCrypto, Llhttp and OpenSslTls; ./silk the Silk ones).
effect fn program<Z: Compression + Copy, H: Http2 + Copy, Y: Crypto + Copy, L: Http + Copy, T: Tls + Copy>(compression: Z, sessions: H, crypto: Y, http: L, tls: T) -> i32 ! HostInputError | OutOfMemoryError | SynchronizationError ? &mut HostInput | &mut Allocator {
  // As Node does: a write to a closed pipe fails with EPIPE, which the stream reports, and a
  // write past RLIMIT_FSIZE fails with EFBIG (SIGXFSZ is 25 on Linux and macOS), instead of
  // ending the process. Children start with every signal at its default. The process is the
  // executable's, so these are too: an embedded runtime leaves its host's signals alone.
  static if Intrinsic.targetOperatingSystem() != "windows" { let _ignored = unsafe signal(13, 1) let _ignoredFileSize = unsafe signal(25, 1) }
  // The commands of the package manager come where a script would: `silkjs install`.
  // They run without the JavaScript engine. Called as `node`, which is what the package manager
  // gives the scripts of packages on a machine without Node.js, the executable has no commands:
  // `node install` runs the file.
  let asNode = match move run HostInput.argument(0) {
    Option.Some { value: called } => calledNode(Bytes.asSlice(&called))
    Option.None => false
  }
  match move run HostInput.argument(1) {
    Option.Some { value: word } => {
      if asNode == false && cli.isCommand(Bytes.asSlice(&word)) {
        return run cli.execute("silkjs", true)
      }
    }
    Option.None => {}
  }
  // The core's C exports that native code calls by name (Node-API for addons, among others) are
  // emitted only when Silk takes them, as embed.start does too; the ones that take a callback are
  // this package's own, in napi_exports.
  keep_exports.all()
  napi_exports.keep()
  let arguments = run HostInput.arguments()
  // The executable has every capability: the real implementation of each, and no host functions.
  let capabilities = Capabilities { platform: OsPlatform {}, modules: NodeResolution {}, files: OsFiles {}, compression: compression, http2: sessions, crypto: crypto, tls: tls, database: SqliteDatabase.make(), addons: DlopenAddons.make(), processes: OsProcesses {}, network: OsNetwork {}, http: http, systemInfo: OsSystemInfo {}, typeStripping: Amaro {}, workers: ThreadWorkers {}, inspector: NodeInspector.make(), wasm: WamrWasm.make(), hostApi: EmptyHostApi {} }
  return run worker.executeProgram(&arguments, move capabilities)
}
/// The executable: every capability real, with the C libraries for compression, HTTP/2, crypto,
/// HTTP/1 and TLS (./silk has the Silk ones).
pub effect fn start() -> i32 ? &mut HostInput { return run mainWith(NativeCompression.make(), Nghttp2.make(), OpenSslCrypto.make(), Llhttp.make(), OpenSslTls.make()) }
/// `main`, with `compression`, `sessions`, `crypto`, `http` and `tls`.
pub effect fn mainWith<Z: Compression + Copy, H: Http2 + Copy, Y: Crypto + Copy, L: Http + Copy, T: Tls + Copy>(compression: Z, sessions: H, crypto: Y, http: L, tls: T) -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(program(compression, sessions, crypto, http, tls)) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move result {
    Result<i32, HostInputError | OutOfMemoryError | SynchronizationError>.Success { value } => value
    Result<i32, HostInputError | OutOfMemoryError | SynchronizationError>.Failure { .. } => {
      let _written = platform.writeAll(2, b"silkjs: unable to initialize native runtime\n")
      return 1
    }
  }
}
