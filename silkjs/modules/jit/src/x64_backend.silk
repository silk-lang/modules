        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, at + 8))
        run self.storeFresh(&function, inst.result)
        if !borrowed { run self.retainBits(Reg.Rax, Reg.R9) }
        self.setFresh(inst.result)
        self.slotsValue = inst.a
        return ()
      }
      // Which read serves the site; FIELD_STEPS is above it.
