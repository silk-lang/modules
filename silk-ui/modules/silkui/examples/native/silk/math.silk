//! What the app computes natively: its JavaScript imports these from `../silk/math.silk`.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// Whether `n` is prime.
pub fn isPrime(n: u32) -> bool {
  if n < 2 {
    return false
  }
  let mut d: u32 = 2
  while d * d <= n {
    if n % d == 0 {
      return false
    }
    d = d + 1
  }
  return true
}

/// How many primes are below `limit`.
pub fn countPrimes(limit: u32) -> u32 {
  let mut found: u32 = 0
  let mut n: u32 = 0
  while n < limit {
    if isPrime(n) {
      found = found + 1
    }
    n = n + 1
  }
  return found
}

/// The `n`th Fibonacci number.
pub fn fib(n: u32) -> u64 {
  let mut a: u64 = 0
  let mut b: u64 = 1
  let mut i: u32 = 0
  while i < n {
    let next = a + b
    a = b
    b = next
    i = i + 1
  }
  return a
}

/// A greeting for `name`.
pub effect fn greet(name: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = run String.copy("Hello from Silk, ")
  run String.append(&mut out, name)
  return move out
}

/// `a` divided by `b`, which fails when `b` is zero.
pub effect fn divide(a: i32, b: i32) -> i32
  ! DivisionByZero {
  if b == 0 {
    fail DivisionByZero {}
  }
  return a / b
}

/// What [`divide`] fails with.
pub struct DivisionByZero {}
