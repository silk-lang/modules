//! CSS Pseudo 4 `::first-letter` and CSS Inline 3 `initial-letter`. The tree splits the first
//! letter of a block's first formatted line into a generated inline box placed before the text
//! it comes from, and css-layout reads that text from after the letter (`setTextStart`), so the
//! text keeps its own offsets. A drop cap is that box floated to the line start, sized so its
//! cap height spans `size` lines, its baseline on line `sink` (`dropCap`).
import svg_css.adopted { StyleSheets }
import svg_css.element { PseudoTarget }
import properties.catalog { Property }
import properties.values { Declaration, Value, Unit }
import properties.computed { Float, Direction, LineHeight, Display, DisplayOutside, DisplayInside }
import layout.lib { Dimension, DimensionKind, SizeValue, BoxSizing }
import style { Computed }
import silk.core.ownership { Copy }
import silk.num.f32
import silk.num.u8
import silk.num.u32
import silk.num.usize

/// Whether a rule of `sheets` styles pseudo-element `target`.
pub fn hasRules(sheets: &StyleSheets, target: PseudoTarget) -> bool {
  let mut i: usize = 0
  while i < sheets.sheets().length {
    let rules = sheets.sheets()[i].sheet.resolver.rules()
    let mut rule: usize = 0
    while rule < rules.length {
      if rules[rule].selectors.hasPseudoTarget(target) { return true }
      rule = rule + 1
    }
    i = i + 1
  }
  return false
}

/// Bytes `[start, end)` of a text: the first letter with the punctuation around it. `end` is 0
/// when the text has no letter, or when its first is not at the start of a line.
pub struct Letter { pub start: usize, pub end: usize }

impl Copy for Letter {}

pub fn decodeAt(text: &[u8], at: usize) -> u32 { return decode(text, at) }

fn decode(text: &[u8], at: usize) -> u32 {
  let b = u8.toU32(text[at])
  if b < 0x80 || at + 1 >= text.length { return b }
  let c1 = u8.toU32(text[at + 1]) & 0x3F
  if b < 0xE0 { return (b & 0x1F) * 64 + c1 }
  if at + 2 >= text.length { return b }
  let c2 = u8.toU32(text[at + 2]) & 0x3F
  if b < 0xF0 { return (b & 0x0F) * 4096 + c1 * 64 + c2 }
  if at + 3 >= text.length { return b }
  return (b & 0x07) * 262144 + c1 * 4096 + c2 * 64 + (u8.toU32(text[at + 3]) & 0x3F)
}

fn width(text: &[u8], at: usize) -> usize {
  let b = text[at]
  let n: usize = if b < 0x80 { 1 } else if b < 0xE0 { 2 } else if b < 0xF0 { 3 } else { 4 }
  return if at + n > text.length { text.length - at } else { n }
}

fn space(c: u32) -> bool {
  return c == 32 || c == 9 || c == 10 || c == 12 || c == 13
}

/// Unicode punctuation (Ps, Pe, Pi, Pf, Po) in the ranges text uses; CSS Pseudo 4 §2.5 takes
/// it around the letter.
fn punctuation(c: u32) -> bool {
  if c < 0x80 {
    return c == 33 || c == 34 || c == 35 || c == 37 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42
      || c == 44 || c == 46 || c == 47 || c == 58 || c == 59 || c == 63 || c == 64 || c == 91 || c == 92
      || c == 93 || c == 123 || c == 125
  }
  return c == 0xA1 || c == 0xA7 || c == 0xAB || c == 0xB6 || c == 0xB7 || c == 0xBB || c == 0xBF
    || (c >= 0x2010 && c <= 0x2027 && c != 0x2012 && c != 0x2013 && c != 0x2014 && c != 0x2015)
    || (c >= 0x2030 && c <= 0x205E) || (c >= 0x3001 && c <= 0x3003) || (c >= 0x3008 && c <= 0x3011)
    || (c >= 0x3014 && c <= 0x301F) || c == 0xFF01 || c == 0xFF08 || c == 0xFF09 || c == 0xFF0C
    || c == 0xFF0E || c == 0xFF1A || c == 0xFF1B || c == 0xFF1F
}

/// Whether a character gets an emphasis mark (CSS Text Decoration 3 §3.1): not a space, a
/// control or punctuation.
pub fn emphasized(c: u32) -> bool {
  return c > 32 && c != 0x7F && !(c >= 0x80 && c < 0xA0) && c != 0xA0 && c != 0x3000 && !(c >= 0x2000 && c <= 0x200F)
    && !punctuation(c) && !combining(c)
}

fn combining(c: u32) -> bool {
  return (c >= 0x300 && c <= 0x36F) || (c >= 0x1AB0 && c <= 0x1AFF) || (c >= 0x1DC0 && c <= 0x1DFF)
    || (c >= 0x20D0 && c <= 0x20FF) || (c >= 0xFE20 && c <= 0xFE2F) || c == 0x200D || (c >= 0xFE00 && c <= 0xFE0F)
}

/// The first letter of `text` (CSS Pseudo 4 §2.5): leading punctuation and the spaces between
/// it, one typographic letter unit, then punctuation up to a space. Leading spaces collapse
/// away when `collapses`; preserved ones put the letter after the line start, so none.
pub fn letterOf(text: &[u8], collapses: bool) -> Letter {
  let none = Letter { start: 0, end: 0 }
  let mut at: usize = 0
  while at < text.length && space(u8.toU32(text[at])) { at = at + 1 }
  if at == text.length || at != 0 && !collapses { return none }
  let start = at
  while at < text.length {
    let c = decode(text, at)
    if !punctuation(c) && !space(c) { break }
    at = at + width(text, at)
  }
  if at == text.length { return none }
  at = at + width(text, at)
  while at < text.length && combining(decode(text, at)) { at = at + width(text, at) }
  while at < text.length && punctuation(decode(text, at)) { at = at + width(text, at) }
  return Letter { start: start, end: at }
}

/// Whether `computed` makes a block container, the boxes `::first-letter` and `::first-line`
/// apply to (CSS Pseudo 4 §2): block, list-item, flow-root, inline-block and table cells.
pub fn blockContainer(computed: &Computed) -> bool {
  return match computed.layout.display {
    Display.Box { outside, inside } => inside == DisplayInside.FlowRoot || inside == DisplayInside.Flow && outside != DisplayOutside.Inline
      || inside == DisplayInside.TableCell
    _ => false
  }
}

/// The first line box of a block whose `::first-line` style is the node at `slot`.
pub struct FirstLine { pub line: usize, pub slot: u32, pub origin: u32 }

impl Copy for FirstLine {}

/// `initial-letter`: a size in lines and the line its baseline sinks to; size 0 is `normal`.
pub struct InitialLetter { pub size: f32, pub sink: u32 }

impl Copy for InitialLetter {}

fn number(css: &[u8], at: &mut usize) -> f32 {
  while at.* < css.length && space(u8.toU32(css[at.*])) { at.* = at.* + 1 }
  let mut value: f32 = 0.0
  let mut digits = false
  while at.* < css.length && css[at.*] >= 48 && css[at.*] <= 57 {
    value = value * 10.0 + u32.toF32(u8.toU32(css[at.*]) - 48)
    at.* = at.* + 1
    digits = true
  }
  if at.* < css.length && css[at.*] == 46 {
    at.* = at.* + 1
    let mut scale: f32 = 0.1
    while at.* < css.length && css[at.*] >= 48 && css[at.*] <= 57 {
      value = value + scale * u32.toF32(u8.toU32(css[at.*]) - 48)
      scale = scale / 10.0
      at.* = at.* + 1
      digits = true
    }
  }
  return if digits { value } else { -1.0 }
}

fn word(css: &[u8], at: &mut usize, name: &[u8]) -> bool {
  while at.* < css.length && space(u8.toU32(css[at.*])) { at.* = at.* + 1 }
  if at.* + name.length > css.length { return false }
  let mut i: usize = 0
  while i < name.length {
    let c = css[at.* + i]
    let lower = if c >= 65 && c <= 90 { c + 32 } else { c }
    if lower != name[i] { return false }
    i = i + 1
  }
  at.* = at.* + name.length
  return true
}

fn sinkOf(size: f32, written: f32, drops: bool, raised: bool) -> u32 {
  if raised { return 1 }
  if written >= 1.0 { return f32.toU32(f32.floor(written)) }
  let whole = f32.toU32(f32.floor(size))
  if drops { return f32.toU32(f32.ceil(size)) }
  return if whole < 1 { 1 } else { whole }
}

/// The last `initial-letter` of `declarations`: `normal`, or `<number> [<integer> | drop |
/// raise]?` with the size at least 1.
pub fn initialLetter(declarations: &[Declaration]) -> InitialLetter {
  let normal = InitialLetter { size: 0.0, sink: 0 }
  let mut i = declarations.length
  while i > 0 {
    i = i - 1
    if declarations[i].property != Property.InitialLetter { continue }
    return match &declarations[i].value {
      Value.Text { css } => parse(css.asSlice())
      Value.Unit { value, unit } => if unit == Unit.Number && value >= 1.0 { InitialLetter { size: value, sink: sinkOf(value, 0.0, false, false) } } else { normal }
      _ => normal
    }
  }
  return normal
}

fn parse(css: &[u8]) -> InitialLetter {
  let normal = InitialLetter { size: 0.0, sink: 0 }
  let mut at: usize = 0
  let size = number(css, &mut at)
  if size < 1.0 { return normal }
  let mut drops = false
  let mut raised = false
  let mut written: f32 = 0.0
  let mut probe = at
  if word(css, &mut probe, b"drop") { drops = true
    at = probe }
  else if word(css, &mut probe, b"raise") { raised = true
    at = probe }
  else {
    let mut after = at
    let value = number(css, &mut after)
    if value >= 0.0 {
      if value < 1.0 || f32.floor(value) != value { return normal }
      written = value
      at = after
    }
  }
  while at < css.length && space(u8.toU32(css[at])) { at = at + 1 }
  if at != css.length { return normal }
  return InitialLetter { size: size, sink: sinkOf(size, written, drops, raised) }
}

/// Font metrics of a paragraph or a letter at one size, in CSS pixels.
pub struct Face { pub size: f32, pub ascent: f32, pub descent: f32, pub capHeight: f32, pub lineHeight: f32 }

impl Copy for Face {}

fn pixels(value: Dimension) -> f32 {
  return if value.kind == DimensionKind.Length { value.value } else { 0.0 }
}

/// Turns the `::first-letter` box in `computed` into a drop cap of `letter` lines for a
/// paragraph whose first available font is `paragraph`, the letter's own font measured as
/// `own` (CSS Inline 3 §7). The box floats to the line start; its font size makes its cap
/// height `(size - 1)` line heights plus the paragraph's cap height, its margins put its
/// baseline on line `sink`'s and make it exclude exactly `sink` lines.
pub fn dropCap(computed: &mut Computed, letter: InitialLetter, paragraph: Face, own: Face) -> () {
  if letter.size < 1.0 || own.size <= 0.0 || own.capHeight <= 0.0 { return () }
  let lines = paragraph.lineHeight
  let cap = (letter.size - 1.0) * lines + paragraph.capHeight
  let size = cap * own.size / own.capHeight
  let ascent = own.ascent * size / own.size
  let descent = own.descent * size / own.size
  computed.text.size = size
  computed.text.lineHeight = LineHeight.Length { value: ascent + descent }
  computed.layout.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.FlowRoot }
  computed.layout.float = if computed.text.direction == Direction.Rtl { Float.Right } else { Float.Left }
  let layout = &mut computed.layout
  let above = pixels(layout.border.top) + pixels(layout.padding.top)
  let below = pixels(layout.border.bottom) + pixels(layout.padding.bottom)
  // The paragraph's baseline on its first line, below the line's top.
  let baseline = (lines - paragraph.ascent - paragraph.descent) / 2.0 + paragraph.ascent
  let sink = u32.toF32(if letter.sink < 1 { 1 } else { letter.sink })
  let top = (sink - 1.0) * lines + baseline - ascent - above
  layout.margin.top = Dimension.px(top)
  layout.margin.bottom = Dimension.px(sink * lines - top - above - ascent - descent - below)
  // An exact height: line boxes inside round their metrics, and a pixel more would push the
  // float past line `sink` and shorten the next line too.
  let inner = if layout.boxSizing == BoxSizing.BorderBox { ascent + descent + above + below } else { ascent + descent }
  layout.height = SizeValue.of(Dimension.px(inner))
}
