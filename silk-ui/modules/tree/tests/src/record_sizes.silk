//! The size of the records every node holds, so a field added to them is a choice and not an
//! accident: a long document has tens of thousands of nodes.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute }
import ui_tree.node { Node }
import ui_tree.style_identity { NodeIdentity, SelectorKey }
import font_collection.lib { FontCollection }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.frozen { Frozen }
import silk.mem.layout { Layout }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

test effect fn nodeRecordsStaySmall() -> () ! AssertionError<'static> {
  run Testing.expect(Layout.of<Node>().bytes <= 296, "a node record is at most 296 bytes")
  run Testing.expect(Layout.of<NodeIdentity>().bytes <= 88, "an element's selector identity is at most 88 bytes")
}

fn sameKey(tree: &UiTree<'_>, a: u32, b: u32) -> bool {
  let left = match tree.node(tree.slotOf(a)).identity() { Option.Some { value } => value _ => { return false } }
  let right = match tree.node(tree.slotOf(b)).identity() { Option.Some { value } => value _ => { return false } }
  return match &left.key {
    Option<Frozen<SelectorKey>>.Some { value: one } => match &right.key {
      Option<Frozen<SelectorKey>>.Some { value: other } => Frozen<SelectorKey>.same(&one, &other)
      _ => false
    }
    _ => false
  }
}

fn classesOf<'t>(tree: &'t UiTree<'_>, id: u32) -> string<'t> {
  return match tree.node(tree.slotOf(id)).identity() { Option.Some { value } => value.classes() _ => "" }
}

fn tagOf<'t>(tree: &'t UiTree<'_>, id: u32) -> string<'t> {
  return match tree.node(tree.slotOf(id)).identity() { Option.Some { value } => value.tag() _ => "" }
}

effect fn elementsShareSelectorKeys() -> () ! TreeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = FontCollection.make()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let mut id: u32 = 2
  while id < 6 {
    run batch.create(id, NodeKind.Box)
    run batch.append(1, id)
    run batch.attribute(id, Attribute.Element { name: run String.copy("li") })
    id = id + 1
  }
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("row") })
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("row") })
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("row selected") })
  run tree.apply(run batch.take())
  run Testing.expect(sameKey(&tree, 2, 3), "elements with the same tag and classes share one key")
  run Testing.expect(!sameKey(&tree, 2, 4) && !sameKey(&tree, 4, 5), "other classes or none make other keys")
  run Testing.expect(classesOf(&tree, 4) == "row selected", "the key keeps the class text")
  run Testing.expect(tree.selectorKeys.length() == 3, "one key per distinct tag and class attribute")
  // A class set after the tag keeps the tag, and the old key is dropped by the next sweep.
  let mut again = Batch.make()
  run again.attribute(3, Attribute.ClassName { value: run String.copy("row selected") })
  run tree.apply(run again.take())
  run Testing.expect(sameKey(&tree, 3, 4), "changing the class moves the element to the other key")
  run Testing.expect(tagOf(&tree, 3) == "li", "the tag stays")
}

test effect fn selectorKeysAreShared() -> () ! TreeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run elementsShareSelectorKeys() |> Effect.provideMut<Allocator>(&mut allocator)
}
