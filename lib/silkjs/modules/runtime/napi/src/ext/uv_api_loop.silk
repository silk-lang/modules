      } else {
        if unsafe socketpair(1, 1 | 524288, 0, pair) != 0 { failure = -(unsafe errno()) break }
      }
      entryFlags = UV_INHERIT_FD
      entryData = i32.toUsize(unsafe Pointer.read<i32>(unsafe Pointer.atMut<i32>(fds, i32.toUsize(index * 2 + 1))))
    } else {
      if mode == UV_INHERIT_FD { entryFlags = UV_INHERIT_FD entryData = data }
      if mode == UV_INHERIT_STREAM {
        let target = unsafe addressPointer(data)
        if Pointer.isNull<u8>(target) { failure = -22 break }
        let fd = unsafe uvl.ioDescriptor(unsafe abi.innerOf(unsafe nn(target)))
        if fd == -1 { failure = -22 break }
        entryFlags = UV_INHERIT_FD
        entryData = i32.toUsize(fd)
      }
    }
    unsafe writeInt(entries, offset, entryFlags)
    unsafe writeWord(entries, offset + 8, entryData)
    index = index + 1
  }
  if failure != 0 {
    index = 0
    while index < count * 2 { let fd = unsafe Pointer.read<i32>(unsafe Pointer.atMut<i32>(fds, i32.toUsize(index))) if fd >= 0 { let _c = unsafe close(fd) } index = index + 1 }
    unsafe free(translated) unsafe free(pairs)
    return failure
  }
