//! The stack, its screens, and what moves them.
import loom.lib {
  CommandSet,
  Document,
  Node,
  Attr,
  Reply,
  Event,
  Submodel,
  Subscriptions,
  Update,
  Heap
}
import loom.heap { allocate }
import loom.css
import loom.css { px, percent, Position, Overflow, Property, Keyword, FlexDirection, Align }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.num.u32
import silk.num.u64
import silk.text.string { String }

/// How a screen comes over the one below it.
pub union Presentation {
  /// Slides in from the trailing edge and covers the screen below, which shifts aside.
  Push,
  /// Rises from the bottom and covers the screen below.
  Modal,
  /// Rises from the bottom over a dimmed backdrop, as tall as its content: the screen below
  /// stays visible, and live, but out of reach. A click on the backdrop goes back.
  Sheet,
  /// Covers the screen below at once.
  Instant,
}

impl Copy for Presentation {}

/// What a screen asks of the stack it is on, reported from its `update`.
pub union Action<S> {
  /// Puts `screen` on top.
  Push { pub screen: S },
  /// Removes the top screen. On the last screen it reports [`Out.Exit`] instead.
  Pop,
  /// Removes the screens above the one keyed `key`.
  PopTo { pub key: u64 },
  /// Removes every screen but the first.
  PopToRoot,
  /// Puts `screen` in the top screen's place.
  Replace { pub screen: S },
  /// Replaces the whole stack; the last of `screens` is on top. An empty list is ignored.
  Reset { pub screens: List<S> },
}

/// A screen: a model with its own messages `M` and commands `C`.
pub interface Screen<M, C> {
  /// The commands a screen starts with when it is put on a stack: its loader.
  effect fn start(model: &Self) -> List<C> ! OutOfMemoryError ? &mut Allocator

  /// The model after `message`. `reporting(Action.…)` moves the stack.
  effect fn update(model: Self, message: M) -> Update<Self, C, Action<Self>>
    ! OutOfMemoryError
    ? &mut Allocator

  fn view(model: &Self, h: &Document<M>) -> Node

  fn subscriptions(model: &Self, subs: &mut Subscriptions<M>) -> () {
    return ()
  }

  /// How the screen comes over the one below. [`Presentation.Push`] by default.
  fn presentation(model: &Self) -> Presentation {
    return Presentation.Push
  }

  /// What going back does inside the screen, when it has something of its own to go back
  /// from: unsaved changes to ask about, a stack of its own. `None`, the default, lets the
  /// stack pop the screen.
  fn back(model: &Self) -> Option<M> {
    return Option<M>.none()
  }

  /// A message for the screen when it is the top one again, after what covered it left.
  fn shown(model: &Self) -> Option<M> {
    return Option<M>.none()
  }

  /// A message for the screen when another one is put over it.
  fn covered(model: &Self) -> Option<M> {
    return Option<M>.none()
  }

  /// The screen's path, such as `"/article/12"`, for a stack made `withLinks`: the location
  /// follows the top screen that has one. `None`, the default, for a screen with no address
  /// of its own (a sheet).
  effect fn path(model: &Self) -> Option<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    return Option<String>.none()
  }

  /// The screen `path` names, for a stack made `withLinks`: what a link (`h.link`), the
  /// address the app starts at or the browser's history puts on the stack. `None`, the
  /// default, for a path that names no screen.
  effect fn open(path: string) -> Option<Self>
    ! OutOfMemoryError
    ? &mut Allocator {
    return Option<Self>.none()
  }
}

/// A screen on a stack. `key` names it for as long as it is there: its nodes, its
/// subscriptions and its commands are kept under it.
pub struct Entry<S> {
  pub key: u64,
  pub screen: S,
  /// The screen's transition onto the stack is over.
  settled: bool,
  how: Presentation,
}

/// A stack of screens. The last one is on top.
pub struct Stack<S> {
  id: u32,
  entries: List<Entry<S>>,
  /// Popped screens that still slide out. They are no longer live: only drawn.
  leaving: List<Entry<S>>,
  next: u32,
  /// Grows with every transition, so each gets a timer of its own.
  moves: u64,
  motion: bool,
  escape: bool,
  links: bool,
}

/// A stack's messages: a screen's own, and what moves the stack from outside.
pub union Message<M> {
  /// `message`, for the screen keyed `key`. One for a screen that left is dropped.
  Screen { pub key: u64, pub message: M },
  /// Go back: the top screen's own `back` if it has one, else a pop.
  Back,
  /// Escape was pressed: go back from a sheet or a modal, or from any screen on a stack
  /// made `withEscape`.
  Escape,
  /// The transitions are over.
  Settled,
  /// The location moved to `path` (a stack made `withLinks` subscribes to it): a link was
  /// clicked, the app started at an address, or the browser's history went there. A path a
  /// screen on the stack has pops back to that screen; any other pushes the screen it opens.
  Located { pub path: String },
}

/// A screen's command on a stack: `owner` is the screen's key, so the command is cancelled
/// when the screen leaves and its message finds the screen it came from.
pub struct Owned<C> {
  pub owner: u64,
  pub command: C,
}

impl<M, C: CommandSet<M, R>, ? R> CommandSet<Message<M> ? R> for Owned<C> {
  effect fn execute(self: Self) -> Message<M>
    ! OutOfMemoryError
    ? R {
    let key = self.owner
    let message = run CommandSet.execute(move self.command)
    return Message<M>.Screen { key: key, message: move message }
  }

  fn owner(self: &Self) -> u64 {
    return self.owner
  }

  fn slot(self: &Self) -> u64 {
    return CommandSet<M, R>.slot(&self.command)
  }

  fn onUiThread(self: &Self) -> bool {
    return CommandSet<M, R>.onUiThread(&self.command)
  }
}

/// What a stack reports to the model that holds it.
pub union Out {
  /// Back was asked on the first screen: there is nothing to pop. A stack inside a screen
  /// passes it on (the screen reports `Action.Pop`); an app's only stack may ignore it.
  Exit,
}

/// How long a transition takes, in seconds.
pub const DURATION: f64 = 0.28

const EASING: string = "translate 280ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 280ms ease"

/// What an update gathers on its way through the screens.
struct Pending<C> {
  commands: List<Owned<C>>,
  cancels: List<u64>,
  destination: Option<String>,
  out: Option<Out>,
}

impl<S> Stack<S> {
  /// A stack with `root` as its first screen. `id` tells the stack from the app's others (a
  /// split view has two): it is part of every key. The parent runs what `Submodel.start`
  /// returns, as for any child.
  pub effect fn of(id: u32, root: S, how: Presentation) -> Stack<S>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut stack = Stack<S> {
      id: id,
      entries: List<Entry<S>>.make(),
      leaving: List<Entry<S>>.make(),
      next: 1,
      moves: 0,
      motion: true,
      escape: false,
      links: false,
    }
    let key = stack.mint()
    run stack.entries.append(Entry<S> { key: key, screen: move root, settled: true, how: how })
    return move stack
  }

  /// Escape goes back from every screen, not only from sheets and modals.
  pub fn withEscape(self: Self) -> Stack<S> {
    let mut stack = move self
    stack.escape = true
    return move stack
  }

  /// Ties the stack to the app's location through its screens' `path` and `open`: the
  /// location follows the top screen, a link to a screen's path pushes it, and going back in
  /// a browser's history pops. One stack of an app should have it.
  pub fn withLinks(self: Self) -> Stack<S> {
    let mut stack = move self
    stack.links = true
    return move stack
  }

  /// Screens change at once, with no transition.
  pub fn withoutMotion(self: Self) -> Stack<S> {
    let mut stack = move self
    stack.motion = false
    return move stack
  }

  fn mint(self: &mut Self) -> u64 {
    let key = u64.bitOr(u64.shiftLeft(u32.toU64(self.id), 32), u32.toU64(self.next))
    self.next = self.next + 1
    return key
  }

  /// How many screens are on the stack.
  pub fn depth(self: &Self) -> usize {
    return self.entries.length()
  }

  /// The screens, the first one first.
  pub fn screens(self: &Self) -> &[Entry<S>] {
    return self.entries.asSlice()
  }

  /// The top screen.
  pub fn top(self: &Self) -> &S {
    let entries = self.entries.asSlice()
    return &entries[entries.length - 1].screen
  }

  /// The top screen's key.
  pub fn topKey(self: &Self) -> u64 {
    let entries = self.entries.asSlice()
    return entries[entries.length - 1].key
  }

  /// Whether a transition still runs.
  pub fn moving(self: &Self) -> bool {
    if self.leaving.length() != 0 {
      return true
    }
    let entries = self.entries.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      if !entries[i].settled {
        return true
      }
      i = i + 1
    }
    return false
  }

  fn indexOf(self: &Self, key: u64) -> Option<usize> {
    let entries = self.entries.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      if entries[i].key == key {
        return Option<usize>.some(i)
      }
      i = i + 1
    }
    return Option<usize>.none()
  }

  /// The first screen that is drawn: the ones below it are fully covered.
  fn firstDrawn(self: &Self) -> usize {
    let entries = self.entries.asSlice()
    let mut i = entries.length - 1
    while i > 0 {
      let covers = match entries[i].how {
        Presentation.Sheet => false
        _ => true
      }
      if covers && entries[i].settled {
        return i
      }
      i = i - 1
    }
    return 0
  }

  fn settle(self: &mut Self) -> () {
    self.leaving.clear()
    let entries = self.entries.asMutSlice()
    let mut i: usize = 0
    while i < entries.length {
      entries[i].settled = true
      i = i + 1
    }
  }
}

/// Whether back has anywhere to go on this stack.
pub fn canGoBack<S: Screen<M, C>, M, C>(self: &Stack<S>) -> bool {
  return self.entries.length() > 1 || Screen<M, C>.back(self.top()).isSome()
}

/// Hands `message` to the screen at `index` and gathers what its update asks for.
effect fn deliver<S: Screen<M, C>, M, C>(
  self: &mut Stack<S>,
  index: usize,
  message: M,
  pending: &mut Pending<C>,
  actions: &mut List<Action<S>>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let key = self.entries.asSlice()[index].key
  let place = Pointer.fromMutRef(&mut self.entries.asMutSlice()[index].screen)

  // The screen is moved out, updated, and put back before anything else can see the hole.
  let before = unsafe Pointer.take(place)
  let next = run Screen<M, C>.update(move before, move message)
  unsafe Pointer.put(place, move next.model)
  let mut commands = move next.commands
  while commands.length() > 0 {
    run pending.commands.append(Owned<C> { owner: key, command: commands.remove(0) })
  }
  run pending.cancels.appendSlice(next.cancels.asSlice())
  if next.destination.isSome() {
    pending.destination = move next.destination
  }
  if let Option<Action<S>>.Some { value } = move next.out {
    run actions.append(move value)
  }
}

/// Puts `screen` on top and starts it.
effect fn put<S: Screen<M, C>, M, C>(
  self: &mut Stack<S>,
  screen: S,
  settled: bool,
  pending: &mut Pending<C>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let key = self.mint()
  let mut commands = run Screen<M, C>.start(&screen)
  while commands.length() > 0 {
    run pending.commands.append(Owned<C> { owner: key, command: commands.remove(0) })
  }
  let how = Screen<M, C>.presentation(&screen)
  let instant = match how {
    Presentation.Instant => true
    _ => false
  }
  run self.entries.append(
    Entry<S> { key: key, screen: move screen, settled: settled || instant || !self.motion, how: how },
  )
}

/// Takes the top screen off: its commands are cancelled, and it slides out when `shown`.
effect fn take<S: Screen<M, C>, M, C>(
  self: &mut Stack<S>, shown: bool, pending: &mut Pending<C>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let last = self.entries.length() - 1
  let entry = self.entries.remove(last)
  run pending.cancels.append(entry.key)
  let instant = match entry.how {
    Presentation.Instant => true
    _ => false
  }
  if shown && self.motion && !instant {
    run self.leaving.append(move entry)
  }
}

/// Tells the screen that is now on top that it shows again.
effect fn uncover<S: Screen<M, C>, M, C>(
  self: &mut Stack<S>, pending: &mut Pending<C>, actions: &mut List<Action<S>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let top = self.entries.length() - 1
  if let Option<M>.Some { value } = Screen<M, C>.shown(&self.entries.asSlice()[top].screen) {
    run deliver<S, M, C>(&mut self, top, move value, &mut pending, &mut actions)
  }
}

/// Removes the screens above `index`.
effect fn popTo<S: Screen<M, C>, M, C>(
  self: &mut Stack<S>,
  index: usize,
  pending: &mut Pending<C>,
  actions: &mut List<Action<S>>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if index + 1 >= self.entries.length() {
    return ()
  }
  self.settle()
  let mut first = true
  while self.entries.length() > index + 1 {
    // Only the one on top is seen leaving.
    run take<S, M, C>(&mut self, first, &mut pending)
    first = false
  }
  self.moves = self.moves + 1
  run uncover<S, M, C>(&mut self, &mut pending, &mut actions)
}

effect fn apply<S: Screen<M, C>, M, C>(
  self: &mut Stack<S>,
  action: Action<S>,
  pending: &mut Pending<C>,
  actions: &mut List<Action<S>>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match move action {
    Action<S>.Push { screen } => {
      self.settle()
      let below = self.entries.length() - 1
      run put<S, M, C>(&mut self, move screen, false, &mut pending)
      self.moves = self.moves + 1
      if let Option<M>.Some { value } = Screen<M, C>.covered(&self.entries.asSlice()[below].screen) {
        run deliver<S, M, C>(&mut self, below, move value, &mut pending, &mut actions)
      }
    }
    Action<S>.Pop => {
      if self.entries.length() < 2 {
        pending.out = Option<Out>.some(Out.Exit)
      } else {
        let below = self.entries.length() - 2
        run popTo<S, M, C>(&mut self, below, &mut pending, &mut actions)
      }
    }
    Action<S>.PopTo { key } => {
      if let Option<usize>.Some { value } = self.indexOf(key) {
        run popTo<S, M, C>(&mut self, value, &mut pending, &mut actions)
      }
    }
    Action<S>.PopToRoot => run popTo<S, M, C>(&mut self, 0, &mut pending, &mut actions)
    Action<S>.Replace { screen } => {
      self.settle()
      run take<S, M, C>(&mut self, false, &mut pending)
      run put<S, M, C>(&mut self, move screen, true, &mut pending)
    }
    Action<S>.Reset { screens } => {
      let mut rest = move screens
      if rest.length() != 0 {
        self.settle()
        while self.entries.length() > 0 {
          run take<S, M, C>(&mut self, false, &mut pending)
        }
        while rest.length() > 0 {
          run put<S, M, C>(&mut self, rest.remove(0), true, &mut pending)
        }
      }
    }
  }
}

/// Goes back: the top screen's own way if it has one, else a pop.
effect fn back<S: Screen<M, C>, M, C>(
  self: &mut Stack<S>, pending: &mut Pending<C>, actions: &mut List<Action<S>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let top = self.entries.length() - 1
  if let Option<M>.Some { value } = Screen<M, C>.back(&self.entries.asSlice()[top].screen) {
    run deliver<S, M, C>(&mut self, top, move value, &mut pending, &mut actions)
  } else {
    run actions.append(Action<S>.Pop)
  }
}

/// Does what `action` asks, as if the top screen had reported it: how the model that holds
/// the stack moves it (a deep link, a tab pressed again).
pub effect fn perform<S: Screen<M, C>, M, C>(stack: Stack<S>, action: Action<S>) -> Update<Stack<S>, Owned<C>, Out>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut stack = move stack
  let mut pending = Pending<C> {
    commands: List<Owned<C>>.make(),
    cancels: List<u64>.make(),
    destination: Option<String>.none(),
    out: Option<Out>.none(),
  }
  let before = run address<S, M, C>(&stack)
  let mut actions = List<Action<S>>.make()
  run actions.append(move action)
  run finish<S, M, C>(&mut stack, &mut pending, &mut actions)
  run follow<S, M, C>(&stack, move before, &mut pending)
  return done<S, C>(move stack, move pending)
}

/// The path of the topmost screen that has one, on a stack made `withLinks`.
effect fn address<S: Screen<M, C>, M, C>(stack: &Stack<S>) -> Option<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  if !stack.links {
    return Option<String>.none()
  }
  let entries = stack.entries.asSlice()
  let mut i = entries.length
  while i > 0 {
    i = i - 1
    let path = run Screen<M, C>.path(&entries[i].screen)
    if path.isSome() {
      return move path
    }
  }
  return Option<String>.none()
}

fn samePath(a: &Option<String>, b: &Option<String>) -> bool {
  return match &a.* {
    Option.Some { value: left } => match &b.* {
      Option.Some { value: right } => String.view(&left) == String.view(&right)
      Option.None => false
    }
    Option.None => b.isNone()
  }
}

/// Moves the location to where the stack is now, when an update changed that from `before`
/// and no screen named a destination itself.
effect fn follow<S: Screen<M, C>, M, C>(stack: &Stack<S>, before: Option<String>, pending: &mut Pending<C>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !stack.links || pending.destination.isSome() {
    return ()
  }
  let after = run address<S, M, C>(stack)
  if after.isSome() && !samePath(&before, &after) {
    pending.destination = move after
  }
}

/// Goes where the location went: back to the screen that has `path`, or on to the screen
/// `path` opens. A path the top screen already has, or one that opens nothing, changes
/// nothing.
effect fn locate<S: Screen<M, C>, M, C>(stack: &Stack<S>, path: string, actions: &mut List<Action<S>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let entries = stack.entries.asSlice()
  let mut topmost = true
  let mut i = entries.length
  while i > 0 {
    i = i - 1
    if let Option<String>.Some { value: own } = run Screen<M, C>.path(&entries[i].screen) {
      if String.view(&own) == path {
        if !topmost {
          run actions.append(Action<S>.PopTo { key: entries[i].key })
        }
        return ()
      }
      topmost = false
    }
  }
  if let Option<S>.Some { value: screen } = run Screen<M, C>.open(path) {
    run actions.append(Action<S>.Push { screen: move screen })
  }
}

effect fn finish<S: Screen<M, C>, M, C>(
  self: &mut Stack<S>, pending: &mut Pending<C>, actions: &mut List<Action<S>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  while actions.length() > 0 {
    let action = actions.remove(0)
    run apply<S, M, C>(&mut self, move action, &mut pending, &mut actions)
  }
}

fn done<S, C>(stack: Stack<S>, pending: Pending<C>) -> Update<Stack<S>, Owned<C>, Out> {
  return Update<Stack<S>, Owned<C>, Out> {
    model: move stack,
    commands: move pending.commands,
    out: move pending.out,
    destination: move pending.destination,
    cancels: move pending.cancels,
  }
}

impl<S: Screen<M, C>, M, C> Submodel<Message<M>, Owned<C>, Out> for Stack<S> {
  effect fn start(model: &Stack<S>) -> List<Owned<C>>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut owned = List<Owned<C>>.make()
    let entries = model.entries.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      let mut commands = run Screen<M, C>.start(&entries[i].screen)
      while commands.length() > 0 {
        run owned.append(Owned<C> { owner: entries[i].key, command: commands.remove(0) })
      }
      i = i + 1
    }
    return move owned
  }

  effect fn update(model: Stack<S>, message: Message<M>) -> Update<Stack<S>, Owned<C>, Out>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut stack = move model
    let mut pending = Pending<C> {
      commands: List<Owned<C>>.make(),
      cancels: List<u64>.make(),
      destination: Option<String>.none(),
      out: Option<Out>.none(),
    }
    let mut actions = List<Action<S>>.make()
    let before = run address<S, M, C>(&stack)
    let mut led = false
    match move message {
      Message<M>.Located { path } => {
        // The location is already there: the stack follows it and does not move it again.
        led = true
        if stack.links {
          run locate<S, M, C>(&stack, String.view(&path), &mut actions)
        }
      }
      Message<M>.Screen { key, message: inner } => {
        if let Option<usize>.Some { value } = stack.indexOf(key) {
          run deliver<S, M, C>(&mut stack, value, move inner, &mut pending, &mut actions)
        } else {
          // The screen left; what it started has nowhere to land.
          drop inner
        }
      }
      Message<M>.Back => run back<S, M, C>(&mut stack, &mut pending, &mut actions)
      Message<M>.Escape => {
        let entries = stack.entries.asSlice()
        let closes = match entries[entries.length - 1].how {
          Presentation.Sheet => true
          Presentation.Modal => true
          _ => stack.escape
        }
        if closes {
          run back<S, M, C>(&mut stack, &mut pending, &mut actions)
        }
      }
      Message<M>.Settled => stack.settle()
    }
    run finish<S, M, C>(&mut stack, &mut pending, &mut actions)
    if led {
      drop before
    } else {
      run follow<S, M, C>(&stack, move before, &mut pending)
    }
    return done<S, C>(move stack, move pending)
  }

  fn view(model: &Stack<S>, h: &Document<Message<M>>) -> Node {
    let mut heap = Heap.make()
    let mut nodes = List<Node>.make()
    let entries = model.entries.asSlice()
    let first = model.firstDrawn()
    let top = entries.length - 1
    let leaving = model.leaving.asSlice()

    // What the top screen came over, or uncovers: the screens below shift for a push only.
    let pushed = match (if leaving.length != 0 { leaving[0].how } else { entries[top].how }) {
      Presentation.Push => true
      _ => false
    }
    let mut i: usize = 0
    while i < entries.length {
      let entry = &entries[i]
      let key = entry.key
      let body = || -> Node {
        return h.map(
          |inner: &Document<M>| Screen<M, C>.view(&entry.screen, inner),
          |message: M| Message<M>.Screen { key: key, message: move message },
        )
      }
      if i < first {
        // Fully covered: its nodes stay as they were, and its view is not asked again.
        heap.alloc(
          nodes.append(
            h.lazy(
              key,
              HIDDEN,
              || -> Node {
                return screenNode<M>(h, Place.Hidden, entry.how, true, body())
              },
            ),
          ),
        )
      } else {
        let place = if i == top {
          Place.Top { fresh: !entry.settled, shifted: pushed && leaving.length != 0 }
        } else {
          Place.Under { shifted: pushed && i + 1 == top }
        }
        heap.alloc(nodes.append(h.keyed(key, screenNode<M>(h, place, entry.how, i != top, body()))))
      }
      i = i + 1
    }
    let mut j: usize = 0
    while j < leaving.length {
      let entry = &leaving[j]
      let key = entry.key
      let body = h.map(
        |inner: &Document<M>| Screen<M, C>.view(&entry.screen, inner),
        |message: M| Message<M>.Screen { key: key, message: move message },
      )
      heap.alloc(nodes.append(h.keyed(key, screenNode<M>(h, Place.Gone, entry.how, true, body))))
      j = j + 1
    }
    let back = canGoBack<S, M, C>(model)
    let escape = match entries[top].how {
      Presentation.Sheet => true
      Presentation.Modal => true
      _ => model.escape && back
    }
    return h.box(
      &[
        h.style(
          &[
            css.position(Position.Relative),
            css.overflow(Overflow.Hidden),
            css.flexGrow(1.0),
            css.minHeight(px(0.0)),
            css.minWidth(px(0.0)),
          ],
        ),
        // Back is the tree's to raise (see `Input.Request` in ui-protocol): it comes from the
        // focused node or the one last pressed and bubbles, so the innermost stack that can
        // act takes it and one that cannot lets it go on to the stack around it.
        h.onNavigate(
          |event: &Event| -> Reply<Message<M>> {
            if back && event.detail == 0 {
              return Reply<Message<M>>.EmitAndStop { message: Message<M>.Back }
            }
            return Reply<Message<M>>.Pass
          },
        ),
        h.onCloseRequest(
          |event: &Event| -> Reply<Message<M>> {
            if escape {
              return Reply<Message<M>>.EmitAndStop { message: Message<M>.Escape }
            }
            return Reply<Message<M>>.Pass
          },
        ),
      ],
      nodes.asSlice(),
    )
  }

  fn subscriptions(model: &Stack<S>, subs: &mut Subscriptions<Message<M>>) -> () {
    let entries = model.entries.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      let entry = &entries[i]
      let key = entry.key
      subs.lift(
        key,
        |inner: &mut Subscriptions<M>| Screen<M, C>.subscriptions(&entry.screen, &mut inner),
        |message: M| Message<M>.Screen { key: key, message: move message },
      )
      i = i + 1
    }
    if model.links {
      subs.location(
        u64.bitXor(LOCATED, u32.toU64(model.id)),
        |path: string| Message<M>.Located { path: allocate(String.copy(path)) },
      )
    }
    if model.moving() {
      // One timer per transition: a new one starts the wait again.
      subs.every(u64.bitXor(SETTLE, model.moves), DURATION + 0.04, |time: f64| Message<M>.Settled)
    }
  }
}

const HIDDEN: u64 = 0x6c6f6f6d6e617631

const SETTLE: u64 = 0x6c6f6f6d6e617632

const LOCATED: u64 = 0x6c6f6f6d6e617633

/// Where a screen is in its stack, for its look.
union Place {
  Top { fresh: bool, shifted: bool },
  Under { shifted: bool },
  Hidden,
  Gone,
}

impl Copy for Place {}

/// The style of a screen's frame at `place`.
fn frame<T>(h: &Document<T>, place: Place, how: Presentation, inert: bool) -> Attr {
  let sheet = match how {
    Presentation.Sheet => true
    _ => false
  }
  let away = match how {
    Presentation.Push => "100% 0"
    _ => "0 100%"
  }
  let offset = match place {
    Place.Top { fresh: _, shifted: _ } => "0 0"
    Place.Under { shifted } => if shifted { "-25% 0" } else { "0 0" }
    Place.Hidden => "0 0"
    Place.Gone => away
  }
  let from = match place {
    Place.Top { fresh, shifted } => if fresh { away } else if shifted { "-25% 0" } else { "0 0" }
    _ => offset
  }
  // A covered screen keeps its layout, and so its scroll offsets: it is only not painted.
  let seen = match place {
    Place.Hidden => false
    _ => true
  }
  return h.attrs(
    &[
      h.style(
        &[
          css.position(Position.Absolute),
          css.inset(px(0.0)),
          css.display(Keyword.Flex),
          css.visible(seen),
          css.flexDirection(FlexDirection.Column),
          css.justifyContent(if sheet { Align.End } else { Align.Stretch }),
          css.raw(Property.Translate, offset),
        ],
      ),
      h.starting(&[css.raw(Property.Translate, from)]),
      h.transition(EASING),
      h.inert(inert),
    ],
  )
}

/// A screen's frame around its view.
fn screenNode<M>(
  h: &Document<Message<M>>,
  place: Place,
  how: Presentation,
  inert: bool,
  body: Node,
) -> Node {
  let sheet = match how {
    Presentation.Sheet => true
    _ => false
  }
  if !sheet {
    return h.box(&[frame<Message<M>>(h, place, how, inert)], &[body])
  }
  let gone = match place {
    Place.Gone => true
    _ => false
  }
  let seen = match place {
    Place.Hidden => false
    _ => true
  }

  // A sheet's backdrop stays put and fades; the sheet itself moves.
  return h.box(
    &[
      h.style(
        &[
          css.position(Position.Absolute),
          css.inset(px(0.0)),
          css.display(Keyword.Flex),
          css.visible(seen),
          css.flexDirection(FlexDirection.Column),
        ],
      ),
      h.inert(inert),
    ],
    &[
      h.box(
        &[
          h.style(
            &[
              css.position(Position.Absolute),
              css.inset(px(0.0)),
              css.backgroundColor(Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.32 }),
              css.opacity(if gone { 0.0 } else { 1.0 }),
            ],
          ),
          h.starting(&[css.opacity(0.0)]),
          h.transition(EASING),
          h.onClick(Message<M>.Back),
        ],
        &[],
      ),
      // The frame lets clicks beside the sheet through to the backdrop.
      h.box(
        &[frame<Message<M>>(h, place, how, false), h.style(&[css.pointerEvents(false)])],
        &[
          h.box(
            &[
              h.style(
                &[
                  css.pointerEvents(true),
                  css.maxHeight(percent(90.0)),
                  css.display(Keyword.Flex),
                  css.flexDirection(FlexDirection.Column),
                ],
              ),
            ],
            &[body],
          ),
        ],
      ),
    ],
  )
}
