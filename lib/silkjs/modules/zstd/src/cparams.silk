/// `ZSTD_cycleLog`.
pub fn cycleLog(hashLog: u32, strategy: u32) -> u32 {
  if strategy >= BTLAZY2 { return mem.s32(hashLog, 1) }
  return hashLog
}

// `ZSTD_dictAndWindowLog`.
fn dictAndWindowLog(windowLog: u32, srcSize: u64, dictSize: u64) -> u32 {
  let maxWindowSize: u64 = 0x80000000
  if dictSize == 0 { return windowLog }
  let windowSize = mem.shl64(1, windowLog)
  let dictAndWindowSize = u64.wrappingAdd(dictSize, windowSize)
  if windowSize >= u64.wrappingAdd(dictSize, srcSize) { return windowLog }
  if dictAndWindowSize >= maxWindowSize { return WINDOWLOG_MAX }
  return mem.highbit32(mem.s32(u64.wrappingToU32(dictAndWindowSize), 1)) + 1
}

/// `ZSTD_adjustCParams_internal`.
pub fn adjustCParams(cPar0: CParams, srcSize0: u64, dictSize0: usize, mode: u32, useRowMatchFinder0: u32) -> CParams {
  let mut cPar = cPar0
  let mut srcSize = srcSize0
  let mut dictSize = usize.toU64(dictSize0)
  let mut useRowMatchFinder = useRowMatchFinder0
  let minSrcSize: u64 = 513
  let maxWindowResize: u64 = 0x40000000
  if mode == CPM_CREATE_CDICT {
    if dictSize != 0 && srcSize == CONTENTSIZE_UNKNOWN { srcSize = minSrcSize }
  } else if mode == CPM_ATTACH_DICT {
    dictSize = 0
  }
  // Resize the window to fit the input (+ dictionary).
  if srcSize <= maxWindowResize && dictSize <= maxWindowResize {
    let tSize = u64.wrappingToU32(u64.wrappingAdd(srcSize, dictSize))
    let srcLog: u32 = if tSize < 64 { HASHLOG_MIN } else { mem.highbit32(tSize - 1) + 1 }
    if cPar.windowLog > srcLog { cPar.windowLog = srcLog }
  }
  if srcSize != CONTENTSIZE_UNKNOWN {
    let dawLog = dictAndWindowLog(cPar.windowLog, srcSize, dictSize)
    let cycle = cycleLog(cPar.chainLog, cPar.strategy)
    if cPar.hashLog > dawLog + 1 { cPar.hashLog = dawLog + 1 }
    if cycle > dawLog { cPar.chainLog = mem.s32(cPar.chainLog, cycle - dawLog) }
  }
  if cPar.windowLog < WINDOWLOG_ABSOLUTEMIN { cPar.windowLog = WINDOWLOG_ABSOLUTEMIN }
  // Short cache tags of a CDict for `fast` and `dfast`.
  if mode == CPM_CREATE_CDICT && (cPar.strategy == FAST || cPar.strategy == DFAST) {
    let maxShortCacheHashLog: u32 = 32 - 8
    if cPar.hashLog > maxShortCacheHashLog { cPar.hashLog = maxShortCacheHashLog }
    if cPar.chainLog > maxShortCacheHashLog { cPar.chainLog = maxShortCacheHashLog }
  }
  // The row match finder needs a hash that fits the tag.
  if useRowMatchFinder == PS_AUTO { useRowMatchFinder = PS_ENABLE }
  if rowMatchFinderUsed(cPar.strategy, useRowMatchFinder) {
    let mut rowLog = cPar.searchLog
    if rowLog > 6 { rowLog = 6 }
    if rowLog < 4 { rowLog = 4 }
    let maxHashLog = 24 + rowLog
    if cPar.hashLog > maxHashLog { cPar.hashLog = maxHashLog }
  }
  return cPar
}

// `ZSTD_getCParamRowSize`.
fn getCParamRowSize(srcSizeHint: u64, dictSize0: usize, mode: u32) -> u64 {
  let mut dictSize = dictSize0
  if mode == CPM_ATTACH_DICT { dictSize = 0 }
  let unknown = srcSizeHint == CONTENTSIZE_UNKNOWN
  let addedSize: u64 = if unknown && dictSize > 0 { 500 } else { 0 }
  if unknown && dictSize == 0 { return CONTENTSIZE_UNKNOWN }
  return u64.wrappingAdd(u64.wrappingAdd(srcSizeHint, usize.toU64(dictSize)), addedSize)
}

/// `ZSTD_getCParams_internal`: the parameters of `compressionLevel` for a source of
/// `srcSizeHint` bytes (or `CONTENTSIZE_UNKNOWN`) and a dictionary of `dictSize` bytes.
pub fn getCParams(compressionLevel: i32, srcSizeHint: u64, dictSize: usize, mode: u32) -> CParams {
  let rSize = getCParamRowSize(srcSizeHint, dictSize, mode)
  let mut tableID: usize = 0
  if rSize <= 262144 { tableID = tableID + 1 }
  if rSize <= 131072 { tableID = tableID + 1 }
  if rSize <= 16384 { tableID = tableID + 1 }
  let mut row: i32 = compressionLevel
  if compressionLevel == 0 { row = CLEVEL_DEFAULT }
  else if compressionLevel < 0 { row = 0 }
  else if compressionLevel > MAX_CLEVEL { row = MAX_CLEVEL }
  let at = (tableID * 23 + i32.toUsize(row)) * 7
  let mut cp = CParams {
    windowLog: LEVELS[at], chainLog: LEVELS[at + 1], hashLog: LEVELS[at + 2], searchLog: LEVELS[at + 3],
    minMatch: LEVELS[at + 4], targetLength: LEVELS[at + 5], strategy: LEVELS[at + 6],
  }
  if compressionLevel < 0 {
    let clamped: i32 = if compressionLevel < MIN_CLEVEL { MIN_CLEVEL } else { compressionLevel }
    cp.targetLength = i32.toU32(0 - clamped)
  }
  return adjustCParams(cp, srcSizeHint, dictSize, mode, PS_AUTO)
}

/// `ZSTD_getCParamsFromCCtxParams`.
pub fn getCParamsFromCCtxParams(p: &Params, srcSizeHint0: u64, dictSize: usize, mode: u32) -> CParams {
  let mut srcSizeHint = srcSizeHint0
  if srcSizeHint == CONTENTSIZE_UNKNOWN && p.srcSizeHint > 0 { srcSizeHint = i32.toU64(p.srcSizeHint) }
  let mut cParams = getCParams(p.compressionLevel, srcSizeHint, dictSize, mode)
  if p.ldmParams.enableLdm == PS_ENABLE { cParams.windowLog = LDM_DEFAULT_WINDOW_LOG }
  // `ZSTD_overrideCParams`.
  if p.cParams.windowLog != 0 { cParams.windowLog = p.cParams.windowLog }
  if p.cParams.hashLog != 0 { cParams.hashLog = p.cParams.hashLog }
  if p.cParams.chainLog != 0 { cParams.chainLog = p.cParams.chainLog }
  if p.cParams.searchLog != 0 { cParams.searchLog = p.cParams.searchLog }
  if p.cParams.minMatch != 0 { cParams.minMatch = p.cParams.minMatch }
  if p.cParams.targetLength != 0 { cParams.targetLength = p.cParams.targetLength }
  if p.cParams.strategy != 0 { cParams.strategy = p.cParams.strategy }
  return adjustCParams(cParams, srcSizeHint, dictSize, mode, p.useRowMatchFinder)
}

/// `ZSTD_compressBound`.
pub fn compressBound(srcSize: usize) -> usize {
  if srcSize >= 0xFF00FF00FF00FF00 { return errors.err(errors.E_SRCSIZE_WRONG) }
  let mut margin: usize = 0
  if srcSize < 131072 { margin = usize.shiftRight(131072 - srcSize, 11) }
  return srcSize + usize.shiftRight(srcSize, 8) + margin
}
