    out.st_rdev = i64.toU64(i32.toI64(s.rdev)) out.st_ino = s.ino out.st_size = i64.toU64(s.size) out.st_blksize = i64.toU64(i32.toI64(s.blksize)) out.st_blocks = i64.toU64(s.blocks)
    out.st_flags = u32.toU64(s.flags) out.st_gen = u32.toU64(s.gen)
    out.st_atim = time(s.atime) out.st_mtim = time(s.mtime) out.st_ctim = time(s.ctime) out.st_birthtim = time(s.birthtime)
    return 0
