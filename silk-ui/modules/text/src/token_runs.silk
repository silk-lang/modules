//! The runs of plain words, shaped once per font and kept.
//!
//! A line of plain text (printable ASCII words between spaces, one font, left to right, no
//! spacing, transform or justification) is shaped by `shapeLine` into one `TextRun` per token.
//! When the line is made only of characters the shaping plan calls word-safe (font-shape's
//! `wordSafeAscii`: no lookup that involves the space glyph can start at any glyph they become),
//! shaping the whole line gives each token the glyphs it gets shaped on its own: no ligature,
//! kerning pair or context can reach across a space. Each token's run is then a function of its
//! font key, script and bytes, so [`TokenRuns`] keeps it by those and a line takes its runs
//! from the table without itemizing, shaping, emitting or interning anything, the way browsers
//! keep a cache of shaped words.
//!
//! Anything else (another script, a fallback face, bidi, letter-spacing, a partial token, two
//! words without a space between them, a character a space-involving lookup may start at, such
//! as Inter's case-sensitive `(` `-` `:`) goes the general way. `Shaping.reuse` off turns this off too, so a `fresh-` bench run
//! checks that both ways give the same glyphs.
import properties.census { Census }
import properties.computed { TextTransform }
import fonts { FontState, RawGlyph, PreparedShapeJob }
import glyphs { GlyphStore, PositionedGlyph }
import set { Link }
import analysis { tokenLength }
import font_collection.lib { Selection }
import layout.lib {
  TextShapeRequest,
  TextRun,
  TextTokenKind,
  WritingMode,
}
import silk.collections.hash { Word }
import silk.collections.hash_map { HashMap }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.text.unicode_script { Script }
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

// A kept run: its key, where its text is in `TokenRuns.bytes`, and the run it interned to.
struct Entry {
  hash: u64,
  fontKey: usize,
  script: u32,
  textStart: usize,
  textLength: usize,
  shapeKey: usize,
  advance: f32,
}

impl Copy for Entry {}

// A token of the line being shaped that carries text.
struct Tok {
  unit: usize,
  length: usize,
  // FNV of its bytes, before the font key and script are mixed in.
  hash: u64,
  word: bool,
  letter: bool,
  // The nearest word at or after it: 0 none, 1 without a letter, 2 with one.
  after: u8,
}

impl Copy for Tok {}

// What a font key of a token resolves to on the plain way. `state` is 0 before it is known,
// 1 when its lines may take the plain way, 2 when they never do.
struct Plain {
  state: u8,
  style: usize,
  // The key the general way gives runs of the key's primary face, and that key's face.
  key: usize,
  instance: usize,
  face: usize,
  size: f32,
  scale: f32,
  // Per script (0 Latin, 1 Common), two words each over the ASCII characters: those whose
  // face choice is known, and of those the ones that choose the primary face exactly.
  known: [u64; 4],
  primary: [u64; 4],
  // Per script, the word-safe characters of the key's plan (`FontState.wordSafeAscii`), once
  // `safeKnown`.
  safe: [u64; 4],
  safeKnown: [bool; 2],
}

impl Copy for Plain {}

fn unknownPlain() -> Plain {
  return Plain {
    state: 0, style: 0, key: 0, instance: 0, face: 0, size: 0.0, scale: 0.0,
    known: [0, 0, 0, 0], primary: [0, 0, 0, 0], safe: [0, 0, 0, 0], safeKnown: [false, false],
  }
}

// The table holds at most this many runs and text bytes, then starts over. Slots are twice the
// runs, a power of two.
const ENTRIES: usize = 65536
const SLOTS: usize = 131072
const BYTES: usize = 1048576

/// Runs of plain tokens by font key, script and text.
pub struct TokenRuns {
  // Open addressing over `entries`: an entry's index plus one, or 0 when the slot is free.
  slots: List<u32>,
  entries: List<Entry>,
  bytes: List<u8>,
  // By font key.
  plains: List<Plain>,
  // The font set generation, glyph store epoch and store truncations the tables were filled at.
  generation: u64,
  epoch: usize,
  truncations: usize,
  chain: List<Link>,
  raw: List<RawGlyph>,
  glyphs: List<PositionedGlyph>,
  toks: List<Tok>,
  /// Lines that took the plain way, runs they took from the table, and runs shaped for it.
  pub lines: usize,
  pub hits: usize,
  pub misses: usize,
}

impl TokenRuns {
  pub effect fn census(self: &Self, out: &mut Census) -> () ! OutOfMemoryError ? &mut Allocator {
    run out.held("text.token-runs.entries", self.entries.length(), self.entries.capacity(), Intrinsic.layoutOf<Entry>().bytes)
    run out.held("text.token-runs.slots", self.slots.length(), self.slots.capacity(), 4)
    run out.held("text.token-runs.text-bytes", self.bytes.length(), self.bytes.capacity(), 1)
    run out.work("text.token-runs.lines", self.lines)
    run out.work("text.token-runs.hits", self.hits)
    run out.work("text.token-runs.misses", self.misses)
  }

  pub fn make() -> TokenRuns {
    return TokenRuns {
      slots: List<u32>.make(),
      entries: List<Entry>.make(),
      bytes: List<u8>.make(),
      plains: List<Plain>.make(),
      generation: 0,
      epoch: 0,
      truncations: 0,
      chain: List<Link>.make(),
      raw: List<RawGlyph>.make(),
      glyphs: List<PositionedGlyph>.make(),
      toks: List<Tok>.make(),
      lines: 0,
      hits: 0,
      misses: 0,
    }
  }

  fn forgetRuns(self: &mut Self) -> () {
    let slots = self.slots.asMutSlice()
    let mut index: usize = 0
    while index < slots.length {
      slots[index] = 0
      index = index + 1
    }
    self.entries.clear()
    self.bytes.clear()
  }

  // The entry kept for `text` in `fontKey` and `script`, or u32.MAX.
  fn find(self: &Self, hash: u64, fontKey: usize, script: u32, text: &[u8]) -> u32 {
    if self.slots.length() == 0 {
      return u32.MAX
    }
    let slots = self.slots.asSlice()
    let entries = self.entries.asSlice()
    let bytes = self.bytes.asSlice()
    let mut slot = slotOf(hash)
    while true {
      let held = slots[slot]
      if held == 0 {
        return u32.MAX
      }
      let entry = &entries[u32.toUsize(held) - 1]
      if entry.hash == hash && entry.fontKey == fontKey && entry.script == script
        && entry.textLength == text.length && sameBytes(bytes, entry.textStart, text) {
        return held - 1
      }
      slot = (slot + 1) % SLOTS
    }
    return u32.MAX
  }

  effect fn keep(self: &mut Self, entry: Entry, text: &[u8]) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.slots.length() == 0 {
      run self.slots.appendRepeated(0, SLOTS)
    }
    if self.entries.length() >= ENTRIES || self.bytes.length() + text.length > BYTES {
      self.forgetRuns()
    }
    let mut kept = entry
    kept.textStart = self.bytes.length()
    run self.bytes.appendSlice(text)
    let index = usize.toU32(self.entries.length())
    run self.entries.append(kept)
    let slots = self.slots.asMutSlice()
    let mut slot = slotOf(entry.hash)
    while slots[slot] != 0 {
      slot = (slot + 1) % SLOTS
    }
    slots[slot] = index + 1
    return index
  }
}

fn slotOf(hash: u64) -> usize {
  return u64.toUsize(u64.shiftRight(u64.wrappingMultiply(hash, 0x9E3779B97F4A7C15), 47))
}

fn sameBytes(held: &[u8], start: usize, text: &[u8]) -> bool {
  let mut index: usize = 0
  while index < text.length {
    if held[start + index] != text[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn finish(hash: u64, fontKey: usize, script: u32) -> u64 {
  let mixed = u64.wrappingMultiply(hash ^ usize.toU64(fontKey), 0x100000001B3)
  let both = u64.wrappingMultiply(mixed ^ u32.toU64(script), 0x100000001B3)
  return both ^ u64.shiftRight(both, 29)
}

fn sameOption(left: Option<f64>, right: Option<f64>) -> bool {
  if let Option<f64>.Some { value: a } = left {
    if let Option<f64>.Some { value: b } = right {
      return a == b
    }
    return false
  }
  return right.isNone()
}

fn sameSelection(left: Selection, right: Selection) -> bool {
  return left.face == right.face && left.weight == right.weight && left.width == right.width
    && sameOption(left.italic, right.italic) && sameOption(left.oblique, right.oblique)
    && left.syntheticOblique == right.syntheticOblique && left.syntheticBold == right.syntheticBold
}

fn asciiLetter(byte: u8) -> bool {
  let folded = byte | 0x20
  return folded >= 0x61 && folded <= 0x7a
}

// Resolves font key `fontKey` for the plain way, once per font set generation.
effect fn plainOf<'a>(runs: &mut TokenRuns, fonts: &mut FontState<'a>, fontKey: usize) -> Plain
  ! OutOfMemoryError
  ? &mut Allocator {
  while runs.plains.length() <= fontKey {
    run runs.plains.append(unknownPlain())
  }
  let kept = runs.plains.get(fontKey)
  if kept.state != 0 {
    return kept
  }
  let mut plain = unknownPlain()
  plain.state = 2
  let info = fonts.key(fontKey)
  if info.instance == usize.MAX || info.style == usize.MAX {
    runs.plains.set(fontKey, plain)
    return plain
  }
  let treatment = fonts.treatment(fontKey)
  if treatment.transform != TextTransform.None || treatment.letterSpacing != 0.0
    || treatment.wordSpacing != 0.0 {
    runs.plains.set(fontKey, plain)
    return plain
  }
  if let Option<Selection>.Some { value: primary } = fonts.primary(info.style) {
    let key = run fonts.keyFor(info.style, primary)
    let resolved = fonts.key(key)
    if resolved.instance == usize.MAX {
      runs.plains.set(fontKey, plain)
      return plain
    }
    // The spacing and transform of the key the runs carry must be the token's too.
    let used = fonts.treatment(key)
    if used.transform != TextTransform.None || used.letterSpacing != 0.0 || used.wordSpacing != 0.0 {
      runs.plains.set(fontKey, plain)
      return plain
    }
    plain.state = 1
    plain.style = info.style
    plain.key = key
    plain.instance = resolved.instance
    plain.face = resolved.face
    plain.size = resolved.size
    plain.scale = fonts.scale(key)
  }
  runs.plains.set(fontKey, plain)
  return plain
}

// Whether the plan of `fontKey`'s key for `script` (0 Latin, 1 Common) shapes every character
// of `seen` (ASCII, two words; the space aside) word by word.
effect fn wordSafe<'a>(runs: &mut TokenRuns, fonts: &mut FontState<'a>, fontKey: usize, script: usize, tag: Script, seen: [u64; 2]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut plain = runs.plains.get(fontKey)
  if !plain.safeKnown[script] {
    let features = fonts.treatment(plain.key).features
    let safe = run fonts.wordSafeAscii(plain.instance, tag, &features)
    plain.safe[script * 2] = safe[0]
    plain.safe[script * 2 + 1] = safe[1]
    plain.safeKnown[script] = true
    runs.plains.set(fontKey, plain)
  }
  let low = plain.safe[script * 2]
  let high = plain.safe[script * 2 + 1]
  // An empty set: some lookup starts at the space itself, or the plan could not be read.
  if low == 0 && high == 0 {
    return false
  }
  let words = seen[0] & ~u64.shiftLeft(1, 32)
  return (words & ~low) == 0 && (seen[1] & ~high) == 0
}

// Whether every character of `seen` (a set over ASCII, two words) chooses the style's primary
// face exactly under `script` (0 Latin, 1 Common), as `itemize` would choose it. Characters
// not asked about before are asked now.
effect fn primaryCovers<'a>(
  runs: &mut TokenRuns,
  fonts: &mut FontState<'a>,
  fontKey: usize,
  script: usize,
  seen: [u64; 2],
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut plain = runs.plains.get(fontKey)
  let mut half: usize = 0
  while half < 2 {
    let word = script * 2 + half
    let unknown = seen[half] & ~plain.known[word]
    if unknown != 0 {
      let primary = match fonts.primary(plain.style) {
        Option<Selection>.Some { value } => value
        Option<Selection>.None => {
          return false
        }
      }
      runs.chain.clear()
      run runs.chain.appendSlice(fonts.chain(plain.style))
      let request = fonts.request(plain.style)
      let tag = if script == 0 { Script.of(0x61) } else { Script.common() }
      let mut b: u64 = 0
      while b < 64 {
        let mask = u64.shiftLeft(1, b)
        if (unknown & mask) != 0 {
          let cp = u64.toU32(usize.toU64(half) * 64 + b)
          if let Option<Selection>.Some { value } = run fonts.set.select(runs.chain.asSlice(), request, cp, tag) {
            if sameSelection(value, primary) {
              plain.primary[word] = plain.primary[word] | mask
            }
          }
          plain.known[word] = plain.known[word] | mask
        }
        b = b + 1
      }
      runs.plains.set(fontKey, plain)
    }
    if (seen[half] & ~plain.primary[word]) != 0 {
      return false
    }
    half = half + 1
  }
  return true
}

/// Shapes `request` the plain way if it can, appending one run per token to `output` and each
/// run's `unsafeBefore` to `unsafeRuns`; false, having appended nothing, when it cannot.
/// `wantSafety` is whether the request is a whole paragraph, whose cuts are judged.
pub effect fn shapePlainLine<'a>(
  runs: &mut TokenRuns,
  fonts: &mut FontState<'a>,
  store: &mut GlyphStore,
  request: &TextShapeRequest<'_, '_>,
  wantSafety: bool,
  output: &mut List<TextRun>,
  unsafeRuns: &mut List<bool>,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if request.hyphenated || request.ellipsis || request.justificationSpace != 0.0
    || request.start.offset != 0 {
    return false
  }
  let analysis = request.analysis
  if analysis.level != 0 || analysis.paragraph.level != 0 || analysis.levels.length() != 0
    || analysis.paragraphs.length() != 0 {
    return false
  }
  if runs.generation != fonts.set.generation {
    runs.plains.clear()
    runs.forgetRuns()
    runs.generation = fonts.set.generation
  }
  if runs.epoch != store.epoch() || runs.truncations != store.truncations() {
    runs.forgetRuns()
    runs.epoch = store.epoch()
    runs.truncations = store.truncations()
  }
  let tokens = request.context.tokens
  let mut unit = request.start.unit
  // The font of the first token with text: box edges before it may carry another.
  while unit < tokens.length && unit <= request.end.unit && tokens[unit].kind != TextTokenKind.Text
    && tokens[unit].kind != TextTokenKind.Space && tokens[unit].kind != TextTokenKind.PreservedSpace {
    unit = unit + 1
  }
  if unit >= tokens.length {
    return false
  }
  let fontKey = tokens[unit].fontKey
  unit = request.start.unit
  if fontKey >= fonts.keyCount() {
    return false
  }
  let plain = run plainOf(&mut runs, &mut fonts, fontKey)
  if plain.state != 1 {
    return false
  }
  runs.toks.clear()
  let mut letter = false
  let mut lastWord = false
  let mut seen: [u64; 2] = [0, 0]
  while unit < tokens.length && unit <= request.end.unit {
    let token = &tokens[unit]
    let kind = token.kind
    let word = kind == TextTokenKind.Text
    if word || kind == TextTokenKind.Space || kind == TextTokenKind.PreservedSpace {
      let length = tokenLength(token)
      let end = if unit == request.end.unit { request.end.offset } else { length }
      if end != 0 {
        if end != length || token.fontKey != fontKey || token.writingMode != WritingMode.HorizontalTb {
          return false
        }
        // Two words with nothing between them may kern or join across their edge.
        if word && lastWord {
          return false
        }
        let bytes = String.utf8Bytes(token.text)
        if bytes.length < length {
          return false
        }
        let mut hash: u64 = 0xCBF29CE484222325
        let mut hasLetter = false
        let mut at: usize = 0
        if word {
          while at < length {
            let byte = bytes[at]
            if byte <= 32 || byte >= 127 {
              return false
            }
            hasLetter = hasLetter || asciiLetter(byte)
            let half = u8.toUsize(byte) / 64
            seen[half] = seen[half] | u64.shiftLeft(1, u8.toU64(byte) % 64)
            hash = u64.wrappingMultiply(hash ^ u8.toU64(byte), 0x100000001B3)
            at = at + 1
          }
        } else {
          while at < length {
            if bytes[at] != 32 {
              return false
            }
            hash = u64.wrappingMultiply(hash ^ 32, 0x100000001B3)
            at = at + 1
          }
          seen[0] = seen[0] | u64.shiftLeft(1, 32)
        }
        letter = letter || hasLetter
        run runs.toks.append(Tok { unit: unit, length: length, hash: hash, word: word, letter: hasLetter, after: 0 })
        lastWord = word
      }
    } else if kind == TextTokenKind.Open || kind == TextTokenKind.Close {
      // A barrier ends the segment, and cuts are judged per segment.
      if token.shapingBarrier {
        return false
      }
    } else if unit != request.end.unit || request.end.offset != 0 {
      return false
    }
    unit = unit + 1
  }
  if runs.toks.length() == 0 {
    return false
  }
  // ASCII itemizes as one run: Latin with a letter in it, Common without.
  let scriptIndex: usize = if letter { 0 } else { 1 }
  if !run primaryCovers(&mut runs, &mut fonts, fontKey, scriptIndex, seen) {
    return false
  }
  let script = if letter { Script.of(0x61) } else { Script.common() }
  if !run wordSafe(&mut runs, &mut fonts, fontKey, scriptIndex, script, seen) {
    return false
  }
  // As `shaping.unsafeAt`: a key without shaping data has no cut judged safe, and without a
  // letter in the segment no cut is unsafe for want of one.
  let cuts = wantSafety && fonts.sliceable(plain.key)
  if cuts && letter {
    let toks = runs.toks.asMutSlice()
    let mut next: u8 = 0
    let mut back = toks.length
    while back > 0 {
      back = back - 1
      if toks[back].word {
        next = if toks[back].letter { 2 } else { 1 }
      }
      toks[back].after = next
    }
  }
  // The letter state of the nearest word before each token: 0 none yet.
  let mut previous: u8 = 0
  let count = runs.toks.length()
  let mut index: usize = 0
  while index < count {
    let tok = runs.toks.get(index)
    let token = &tokens[tok.unit]
    let bytes = Slice.view(String.utf8Bytes(token.text), 0, tok.length)
    let hash = finish(tok.hash, plain.key, script.value)
    let mut shapeKey: usize = 0
    let mut advance: f32 = 0.0
    let found = runs.find(hash, plain.key, script.value, bytes)
    if found != u32.MAX {
      runs.hits = runs.hits + 1
      let entry = &runs.entries.asSlice()[u32.toUsize(found)]
      shapeKey = entry.shapeKey
      advance = entry.advance
    } else {
      runs.misses = runs.misses + 1
      let features = fonts.treatment(plain.key).features
      runs.raw.clear()
      run fonts.shapeTextOriented(plain.instance, String.slice(token.text, 0, tok.length), 0, tok.length, false, script, false, &features, &mut runs.raw)
      runs.glyphs.clear()
      let mut pen: f32 = 0.0
      let mut g: usize = 0
      while g < runs.raw.length() {
        let raw = runs.raw.get(g)
        let glyphAdvance = i32.toF32(raw.xAdvance) * plain.scale
        run runs.glyphs.append(
          PositionedGlyph {
            glyph: raw.glyph,
            cluster: raw.cluster,
            upright: false,
            x: pen + i32.toF32(raw.xOffset) * plain.scale,
            y: i32.toF32(-raw.yOffset) * plain.scale,
            advance: glyphAdvance,
          },
        )
        pen = pen + glyphAdvance
        g = g + 1
      }
      shapeKey = run store.intern(plain.key, plain.face, plain.size, false, runs.glyphs.asSlice())
      advance = store.glyphRun(shapeKey).advance
      // A table that starts over here keeps the keys taken so far valid: they name store runs.
      drop run runs.keep(
        Entry {
          hash: hash,
          fontKey: plain.key,
          script: script.value,
          textStart: 0,
          textLength: tok.length,
          shapeKey: shapeKey,
          advance: advance,
        },
        bytes,
      )
    }
    let mut unsafeBefore = true
    if cuts {
      // Each side of the cut must keep a word with a letter next to it (`weakWord`).
      unsafeBefore = letter && (tok.after != 2 || (index != 0 && previous != 2))
    }
    if tok.word {
      previous = if tok.letter { 2 } else { 1 }
    }
    run unsafeRuns.append(unsafeBefore)
    run output.append(
      TextRun.Text {
        unit: tok.unit,
        start: 0,
        end: tok.length,
        advance: advance,
        fontKey: plain.key,
        bidiLevel: 0,
        shapeKey: shapeKey,
        unsafeBefore: unsafeBefore,
      },
    )
    index = index + 1
  }
  runs.lines = runs.lines + 1
  return true
}

/// For `shaping.collectShapeJobs` (the pre-shaping pass): when `text` in font key `fontKey`
/// would take the plain way, queues the shaping its words and runs of spaces miss on it, each
/// shaped on its own (`FontState.prepareShapeJob`), and returns true; false, queuing nothing,
/// when its lines would be itemized and shaped whole.
pub effect fn collectPlainJobs<'a>(
  runs: &mut TokenRuns,
  fonts: &mut FontState<'a>,
  fontKey: usize,
  text: string,
  textBuf: &mut List<u8>,
  seen: &mut HashMap<Word, u32>,
  jobs: &mut List<PreparedShapeJob>,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if runs.generation != fonts.set.generation {
    runs.plains.clear()
    runs.forgetRuns()
    runs.generation = fonts.set.generation
  }
  let plain = run plainOf(&mut runs, &mut fonts, fontKey)
  if plain.state != 1 {
    return false
  }
  let bytes = String.utf8Bytes(text)
  let mut letter = false
  let mut spaces = false
  let mut chars: [u64; 2] = [0, 0]
  let mut at: usize = 0
  while at < bytes.length {
    let byte = bytes[at]
    if byte < 32 || byte >= 127 {
      return false
    }
    if byte == 32 {
      spaces = true
    } else {
      letter = letter || asciiLetter(byte)
      let half = u8.toUsize(byte) / 64
      chars[half] = chars[half] | u64.shiftLeft(1, u8.toU64(byte) % 64)
    }
    at = at + 1
  }
  if spaces {
    chars[0] = chars[0] | u64.shiftLeft(1, 32)
  }
  let scriptIndex: usize = if letter { 0 } else { 1 }
  let script = if letter { Script.of(0x61) } else { Script.common() }
  if !run primaryCovers(&mut runs, &mut fonts, fontKey, scriptIndex, chars) {
    return false
  }
  if !run wordSafe(&mut runs, &mut fonts, fontKey, scriptIndex, script, chars) {
    return false
  }
  let features = fonts.treatment(plain.key).features
  // A collapsed run of spaces is one space token.
  if spaces {
    drop run fonts.prepareShapeJob(plain.instance, " ", 0, 1, false, script, false, &features, &mut textBuf, &mut seen, &mut jobs)
  }
  let mut start: usize = 0
  at = 0
  while at <= bytes.length {
    let edge = at == bytes.length || (at > start && (bytes[at] == 32) != (bytes[start] == 32))
    if edge {
      if at > start {
        drop run fonts.prepareShapeJob(plain.instance, String.slice(text, start, at - start), 0, at - start, false, script, false, &features, &mut textBuf, &mut seen, &mut jobs)
      }
      start = at
    }
    at = at + 1
  }
  return true
}

