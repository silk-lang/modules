the element's dir attribute is in the rtl state\x0a    //     The directionality of the element is 'rtl'.\x22\x0a    if (element.dir == \x22rtl\x22) {\x0a        return \x22rtl\x22;\x0a    }\x0a\x0a    // \x22If the element's dir attribute is in the auto state\x0a    // \x22If the element is a bdi element and the dir attribute is not in a\x0a    // defined state (i.e. it is not present or has an invalid value)\x0a    //     [lots of complicated stuff]\x0a    //\x0a    // Skip this, since no browser implements it anyway.\x0a\x0a    // \x22If the element is a root element and the dir attribute is not in a\x0a    // defined state (i.e. it is not present or has an invalid value)\x0a    //     The directionality of the element is 'ltr'.\x22\x0a    if (!isHtmlElement(element.parentNode)) {\x0a        return \x22ltr\x22;\x0a    }\x0a\x0a    // \x22If the element has a parent element and the dir attribute is not in a\x0a    // defined state (i.e. it is not present or has an invalid value)\x0a    //     The directionality of the element is the same as the element's\x0a    //     parent element's directionality.\x22\x0a    return getDirectionality(element.parentNode);\x0a}\x0a\x0a//@}\x0a\x0a///////////////////////////////////////////////////////////////////////////////\x0a///////////////////////////// DOM Range functions /////////////////////////////\x0a///////////////////////////////////////////////////////////////////////////////\x0a//@{\x0a\x0afunction getNodeIndex(node) {\x0a    return indexIn(node);\x0a}\x0a\x0a// \x22The length of a Node node is the following, depending on node:\x0a//\x0a// ProcessingInstruction\x0a// DocumentType\x0a//   Always 0.\x0a// Text\x0a// Comment\x0a//   node's length.\x0a// Any other node\x0a//   node's childNodes's length.\x22\x0afunction getNodeLength(node) {\x0a    switch (node.nodeType) {\x0a        case DOM.PROCESSING_INSTRUCTION_NODE:\x0a        case DOM.DOCUMENT_TYPE_NODE:\x0a            return 0;\x0a\x0a        case DOM.TEXT_NODE:\x0a        case DOM.COMMENT_NODE:\x0a            return node.length;\x0a\x0a        default:\x0a            return node.childNodes.length;\x0a    }\x0a}\x0a\x0a/**\x0a * The position of two boundary points relative to one another, as defined by\x0a * DOM Range.\x0a */\x0afunction getPosition(nodeA, offsetA, nodeB, offsetB) {\x0a    // \x22If node A is the same as node B, return equal if offset A equals offset\x0a    // B, before if offset A is less than offset B, and after if offset A is\x0a    // greater than offset B.\x22\x0a    if (nodeA == nodeB) {\x0a        if (offsetA == offsetB) {\x0a            return \x22equal\x22;\x0a        }\x0a        if (offsetA < offsetB) {\x0a            return \x22before\x22;\x0a        }\x0a        if (offsetA > offsetB) {\x0a            return \x22after\x22;\x0a        }\x0a    }\x0a\x0a    // \x22If node A is after node B in tree order, compute the position of (node\x0a    // B, offset B) relative to (node A, offset A). If it is before, return\x0a    // after. If it is after, return before.\x22\x0a    if (documentPosition(nodeB, nodeA) & DOM.DOCUMENT_POSITION_FOLLOWING) {\x0a        var pos = getPosition(nodeB, offsetB, nodeA, offsetA);\x0a        if (pos == \x22before\x22) {\x0a            return \x22after\x22;\x0a        }\x0a        if (pos == \x22after\x22) {\x0a            return \x22before\x22;\x0a        }\x0a    }\x0a\x0a    // \x22If node A is an ancestor of node B:\x22\x0a    if (documentPosition(nodeB, nodeA) & DOM.DOCUMENT_POSITION_CONTAINS) {\x0a        // \x22Let child equal node B.\x22\x0a        var child = nodeB;\x0a\x0a        // \x22While child is not a child of node A, set child to its parent.\x22\x0a        while (child.parentNode != nodeA) {\x0a            child = child.parentNode;\x0a        }\x0a\x0a        // \x22If the index of child is less than offset A, return after.\x22\x0a        if (getNodeIndex(child) < offsetA) {\x0a            return \x22after\x22;\x0a        }\x0a    }\x0a\x0a    // \x22Return before.\x22\x0a    return \x22before\x22;\x0a}\x0a\x0a/**\x0a * Returns the furthest ancestor of a Node as defined by DOM Range.\x0a */\x0afunction getFurthestAncestor(node) {\x0a    var root = node;\x0a    while (root.parentNode != null) {\x0a        root = root.parentNode;\x0a    }\x0a    return root;\x0a}\x0a\x0a/**\x0a * \x22contained\x22 as defined by DOM Range: \x22A Node node is contained in a range\x0a * range if node's furthest ancestor is the same as range's root, and (node, 0)\x0a * is after range's start, and (node, length of node) is before range's end.\x22\x0a */\x0afunction isContained(node, range) {\x0a    var pos1 = getPosition(node, 0, range.startContainer, range.startOffset);\x0a    var pos2 = getPosition(node, getNodeLength(node), range.endContainer, range.endOffset);\x0a\x0a    return getFurthestAncestor(node) == getFurthestAncestor(range.startContainer)\x0a        && pos1 == \x22after\x22\x0a        && pos2 == \x22before\x22;\x0a}\x0a\x0a/**\x0a * Return all nodes contained in range that the provided function returns true\x0a * for, omitting any with an ancestor already being returned.\x0a */\x0afunction getContainedNodes(range, condition) {\x0a    if (typeof condition == \x22undefined\x22) {\x0a        condition = function() { return true };\x0a    }\x0a    var node = range.startContainer;\x0a    if (node.hasChildNodes()\x0a    && range.startOffset < node.childNodes.length) {\x0a        // A child is contained\x0a        node = node.childNodes[range.startOffset];\x0a    } else if (range.startOffset == getNodeLength(node)) {\x0a        // No descendant can be contained\x0a        node = nextNodeDescendants(node);\x0a    } else {\x0a        // No children; this node at least can't be contained\x0a        node = nextNode(node);\x0a    }\x0a\x0a    var stop = range.endContainer;\x0a    if (stop.hasChildNodes()\x0a    && range.endOffset < stop.childNodes.length) {\x0a        // The node after the last contained node is a child\x0a        stop = stop