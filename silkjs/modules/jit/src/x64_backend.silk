          if self.a.offset() == start { self.slotsValue = self.slotsHeld }
          return ()
        }
        if arms.length() != 0 {
          let general = run self.a.label()
          run self.knownArms(&function, inst, &arms, (fact & FACT_OBJECT) != 0, borrowed, general)
          self.a.bind(general)
        }
        if target != NONE {
          let general = run self.a.label()
          let start = self.a.offset()
          run self.knownOne(&function, inst, target, (fact & FACT_OBJECT) != 0, proven, tested, borrowed, general)
          // A preset value's slot holds the closure already, and it takes no count (presets).
          // The known way runs on: the read for any other shape is out of line (with the
          // `check.callee` after it, which the known way has no use for: skipOut).
          if self.calleeNext(&function, inst.block, inst.result, target) {
            self.skipLabel = run self.a.label()
            self.skipAt = self.cursor + 1
            self.skipOut = true
            // A known way of no code keeps R11 as the receiver's slots: the read out of line
            // loads them again before it joins.
            if self.slotsHeld == inst.a && self.a.offset() == start && !self.lazy.get(u32.toUsize(inst.a)) { self.skipSlots = inst.a }
          } else {
