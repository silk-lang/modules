import window.keys { KeyCode }
import window.shell { Notification, Tray, TrayIcon }
import window.clipboard { ClipboardEntry }
import window.menu { MenuBar, MenuEntry, OpenDialog, SaveDialog }
import window.native { NativePlatform, Waker }
import window.headless { HeadlessPlatform }

