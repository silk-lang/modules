fn noBlock() -> BlockInfo { return BlockInfo { alias: b"", name: b"", family: 0, kind: 0, mode: 0, nid: 0, keyLength: 0, ivLength: 0, blockSize: 0 } }
fn lower(b: u8) -> u8 { return if b >= 65 && b <= 90 { b + 32 } else { b } }
fn sameName(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { if lower(a[i]) != b[i] { return false } i = i + 1 }
  return true
}
/// The cipher named `name` (any case), or one with family 0.
pub fn blockByName(name: &[u8]) -> BlockInfo {
  let mut i: usize = 0
  while i < TABLE.length { if sameName(name, TABLE[i].alias) { return TABLE[i] } i = i + 1 }
  return noBlock()
}
/// The cipher with OpenSSL's number `nid`, or one with family 0.
pub fn blockByNid(nid: i32) -> BlockInfo {
  if nid == 0 { return noBlock() }
  let mut i: usize = 0
  while i < TABLE.length { if TABLE[i].nid == nid { return TABLE[i] } i = i + 1 }
  return noBlock()
}

/// Any of the block ciphers, for the generic modes.
pub union AnyBlock { Aes { v: Aes }, Aria { v: Aria }, Camellia { v: Camellia }, Sm4 { v: Sm4 }, Des { v: TripleDes } }
impl BlockCipher for AnyBlock {
  fn blockLength(self: &Self) -> usize { return match &self.* { AnyBlock.Des { .. } => 8 _ => 16 } }
  fn encryptBlock(self: &Self, block: &mut [u8; 16]) -> () {
    match &self.* {
      AnyBlock.Aes { v } => { let input = block.* block.* = v.encryptBlock(&input) }
      AnyBlock.Aria { v } => v.encryptBlock(move block)
      AnyBlock.Camellia { v } => v.encryptBlock(move block)
      AnyBlock.Sm4 { v } => v.encryptBlock(move block)
      AnyBlock.Des { v } => v.encryptBlock(move block)
    }
  }
  fn decryptBlock(self: &Self, block: &mut [u8; 16]) -> () {
    match &self.* {
      AnyBlock.Aes { v } => { let input = block.* block.* = v.decryptBlock(&input) }
      AnyBlock.Aria { v } => v.decryptBlock(move block)
      AnyBlock.Camellia { v } => v.decryptBlock(move block)
      AnyBlock.Sm4 { v } => v.decryptBlock(move block)
      AnyBlock.Des { v } => v.decryptBlock(move block)
    }
  }
}
/// The cipher of `family` with `key` (two-key DES repeats its first key).
pub fn makeBlock(family: i32, key: &[u8]) -> Option<AnyBlock> {
  if family == F_AES { return match move Aes.make(key) { Result<Aes, AesError>.Success { value } => Option<AnyBlock>.some(AnyBlock.Aes { v: move value }) Result<Aes, AesError>.Failure { .. } => Option<AnyBlock>.None } }
  if family == F_ARIA { return match move Aria.make(key) { Result<Aria, BlockCipherError>.Success { value } => Option<AnyBlock>.some(AnyBlock.Aria { v: move value }) Result<Aria, BlockCipherError>.Failure { .. } => Option<AnyBlock>.None } }
  if family == F_CAMELLIA { return match move Camellia.make(key) { Result<Camellia, BlockCipherError>.Success { value } => Option<AnyBlock>.some(AnyBlock.Camellia { v: move value }) Result<Camellia, BlockCipherError>.Failure { .. } => Option<AnyBlock>.None } }
  if family == F_SM4 { return match move Sm4.make(key) { Result<Sm4, BlockCipherError>.Success { value } => Option<AnyBlock>.some(AnyBlock.Sm4 { v: move value }) Result<Sm4, BlockCipherError>.Failure { .. } => Option<AnyBlock>.None } }
  let mut full: [u8; 24] = [0; 24]
  let mut i: usize = 0
  if family == F_DES_EDE {
    if key.length != 16 { return Option<AnyBlock>.None }
    while i < 24 { full[i] = key[i % 16] i = i + 1 }
  } else {
    if key.length != 24 { return Option<AnyBlock>.None }
    while i < 24 { full[i] = key[i] i = i + 1 }
  }
  return match move TripleDes.make(&full) { Result<TripleDes, BlockCipherError>.Success { value } => Option<AnyBlock>.some(AnyBlock.Des { v: move value }) Result<TripleDes, BlockCipherError>.Failure { .. } => Option<AnyBlock>.None }
}

// Ciphertext stealing over CBC (NIST SP 800-38A addendum): CS1 keeps the blocks in order, CS2
// swaps the last two when the last is partial, CS3 always swaps them. At least one block.
fn swapsLast(variant: i32, partial: bool) -> bool { return variant == 3 || variant == 2 && partial }
fn xorInto(block: &mut [u8; 16], bytes: &[u8], offset: usize, length: usize) -> () {
  let mut i: usize = 0
  while i < length { block[i] = block[i] ^ bytes[offset + i] i = i + 1 }
}
fn put(output: &mut [u8], offset: usize, block: &[u8; 16], length: usize) -> () {
  let mut i: usize = 0
  while i < length { output[offset + i] = block[i] i = i + 1 }
}
/// Encrypts `input` into `output` (as long) with CBC and ciphertext stealing; false if the input
/// is shorter than a block.
pub fn ctsEncrypt(cipher: &AnyBlock, iv: &[u8], variant: i32, input: &[u8], output: &mut [u8]) -> bool {
  let n = input.length
  if n < 16 || iv.length != 16 { return false }
  let blocks = (n + 15) / 16
  let last = n - (blocks - 1) * 16
  let mut chain: [u8; 16] = [0; 16]
  let mut i: usize = 0
  while i < 16 { chain[i] = iv[i] i = i + 1 }
  let mut b: usize = 0
  while b + 2 < blocks || blocks == 1 && b == 0 {
    xorInto(&mut chain, input, b * 16, 16)
    cipher.encryptBlock(&mut chain)
    put(&mut output, b * 16, &chain, 16)
    b = b + 1
    if blocks == 1 { return true }
  }
  // The last two: C(n-1) from the full block, C(n) from the last one padded with zeros.
  let mut previous = chain
  xorInto(&mut previous, input, (blocks - 2) * 16, 16)
  cipher.encryptBlock(&mut previous)
  let mut final = previous
  xorInto(&mut final, input, (blocks - 1) * 16, last)
  cipher.encryptBlock(&mut final)
  let at = (blocks - 2) * 16
  if swapsLast(variant, last != 16) {
    put(&mut output, at, &final, 16)
    put(&mut output, at + 16, &previous, last)
  } else {
    put(&mut output, at, &previous, last)
    put(&mut output, at + last, &final, 16)
  }
  return true
}
/// Decrypts what ctsEncrypt wrote with the same variant.
pub fn ctsDecrypt(cipher: &AnyBlock, iv: &[u8], variant: i32, input: &[u8], output: &mut [u8]) -> bool {
  let n = input.length
  if n < 16 || iv.length != 16 { return false }
  let blocks = (n + 15) / 16
  let last = n - (blocks - 1) * 16
  let mut chain: [u8; 16] = [0; 16]
  let mut i: usize = 0
  while i < 16 { chain[i] = iv[i] i = i + 1 }
  let mut b: usize = 0
  while b + 2 < blocks || blocks == 1 && b == 0 {
    let mut block: [u8; 16] = [0; 16]
    xorInto(&mut block, input, b * 16, 16)
    let saved = block
    cipher.decryptBlock(&mut block)
    let mut j: usize = 0
    while j < 16 { block[j] = block[j] ^ chain[j] j = j + 1 }
    put(&mut output, b * 16, &block, 16)
    chain = saved
    b = b + 1
    if blocks == 1 { return true }
  }
  let at = (blocks - 2) * 16
  // The full last block C(n) and the stolen part of C(n-1), wherever the variant put them.
  let swapped = swapsLast(variant, last != 16)
  let fullAt = if swapped { at } else { at + last }
  let tailAt = if swapped { at + 16 } else { at }
  let mut final: [u8; 16] = [0; 16]
  xorInto(&mut final, input, fullAt, 16)
  cipher.decryptBlock(&mut final)
  // final = C(n-1) xor (P(n) padded): P(n) from the stolen bytes, C(n-1) from both.
  let mut previous = final
  let mut j: usize = 0
  while j < last { output[at + 16 + j] = final[j] ^ input[tailAt + j] previous[j] = input[tailAt + j] j = j + 1 }
  cipher.decryptBlock(&mut previous)
  j = 0
  while j < 16 { output[at + j] = previous[j] ^ chain[j] j = j + 1 }
  return true
}
