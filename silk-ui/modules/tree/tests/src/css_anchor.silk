//! CSS anchor positioning: `anchor()` insets, `position-area`, `anchor-size()` and flips.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, FrameInput }
import ui_tree.cssom_view as view
import ui_fixtures.fixtures as fixtures
import svg_css.cssom_error { CssomError }
import svg_css.cssom_geometry { DOMRect }
import svg_css.written
import svg_css.tokens { CssError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

fn frame() -> FrameInput {
  return FrameInput { width: 300.0, height: 200.0, scale: 1.0, time: 0.0 }
}

effect fn styled(batch: &mut Batch, id: u32, css: &[u8]) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let declarations = run written.declarations(css)
  run batch.style(id, declarations.asSlice())
}

/// A 300 by 200 positioned root (1) with a 60 by 20 anchor (2) at (50, 40), and a box (3)
/// styled `placed`.
effect fn anchored<'f>(tree: &mut UiTree<'f>, placed: &[u8]) -> ()
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run styled(&mut batch, 1, b"display:flow-root;position:relative;width:300px;height:200px")
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run styled(&mut batch, 2, b"display:block;margin-left:50px;margin-top:40px;width:60px;height:20px;anchor-name:--a")
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  run styled(&mut batch, 3, placed)
  run tree.apply(run batch.take())
  run tree.frame(frame())
}

effect fn rectOf(placed: &[u8]) -> DOMRect
  ! TreeError | CssError | CssomError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  run anchored(&mut tree, placed)
  return run view.getBoundingClientRect(&tree, 3)
}

effect fn at(placed: &[u8], x: f64, y: f64, w: f64, h: f64, message: string<'static>) -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let r = run rectOf(placed)
  run Testing.expect(r.x == x && r.y == y && r.width == w && r.height == h, message)
}

effect fn insets() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run at(b"position:absolute;position-anchor:--a;top:anchor(bottom);left:anchor(left);width:30px;height:10px", 50.0, 60.0, 30.0, 10.0, "top and left line up with the anchor's bottom and left")
  run at(b"position:absolute;top:anchor(--a top);right:anchor(--a left);width:30px;height:10px", 20.0, 40.0, 30.0, 10.0, "a named anchor() and a right inset against the anchor's left")
  run at(b"position:absolute;position-anchor:--a;top:calc(anchor(bottom) + 5px);left:anchor(50%);width:30px;height:10px", 80.0, 65.0, 30.0, 10.0, "calc adds to the anchor position, and a percentage picks a point")
  run at(b"position:absolute;position-anchor:--a;top:anchor(outside);bottom:anchor(inside);left:anchor(right);width:30px", 110.0, 60.0, 30.0, 0.0, "outside and inside flip with the inset, and two insets stretch")
  run at(b"position:absolute;position-anchor:--b;top:anchor(bottom);left:7px;width:30px;height:10px", 7.0, 60.0, 30.0, 10.0, "no such anchor leaves anchor() insets auto: the static position")
  run at(b"position:absolute;position-anchor:--a;top:anchor(bottom);left:anchor(left);width:anchor-size(width);height:anchor-size(height)", 50.0, 60.0, 60.0, 20.0, "anchor-size() takes the anchor's size")
}

effect fn areas() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run at(b"position:absolute;position-anchor:--a;position-area:bottom;width:30px;height:10px", 65.0, 60.0, 30.0, 10.0, "bottom: below the anchor, centred on it")
  run at(b"position:absolute;position-anchor:--a;position-area:top left;width:30px;height:10px", 20.0, 30.0, 30.0, 10.0, "top left: against the anchor's top-left corner")
  run at(b"position:absolute;position-anchor:--a;position-area:center right;width:30px;height:10px", 110.0, 45.0, 30.0, 10.0, "center right: centred in the anchor's row")
  run at(b"position:absolute;position-anchor:--a;position-area:span-bottom span-right;width:30px;height:10px", 50.0, 40.0, 30.0, 10.0, "span-bottom span-right: from the anchor's corner")
  run at(b"position:absolute;position-anchor:--a;position-area:bottom span-all;width:400px;height:10px", 0.0, 60.0, 400.0, 10.0, "an explicit size is kept, and stays as far inside as it can")
}

effect fn fallbacks() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run at(b"position:absolute;position-anchor:--a;position-area:top;position-try-fallbacks:flip-block;width:30px;height:50px", 65.0, 60.0, 30.0, 50.0, "no room above: flip-block moves it below")
  run at(b"position:absolute;position-anchor:--a;bottom:anchor(top);left:anchor(left);position-try-fallbacks:flip-block;width:30px;height:50px", 50.0, 60.0, 30.0, 50.0, "flip-block swaps bottom: anchor(top) for top: anchor(bottom)")
  run at(b"position:absolute;position-anchor:--a;position-area:top;position-try-fallbacks:flip-block;width:30px;height:30px", 65.0, 10.0, 30.0, 30.0, "a box that fits stays where it was asked")
}

test effect fn cssAnchorInsetsLineUpWithTheAnchor() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run insets() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssAnchorPositionAreaPlacesInTheGrid() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run areas() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssAnchorTriesFlipsThatFit() -> ()
  ! TreeError | CssError | CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fallbacks() |> Effect.provideMut<Allocator>(&mut allocator)
}

