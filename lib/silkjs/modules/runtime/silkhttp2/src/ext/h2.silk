  if kind == WINDOW_UPDATE {
    let rv = unsafe onWindowUpdateReceived(sp)
    if isFatal(rv) { return rv }
    if unsafe state(sp) == IB_IGN_ALL { return 1 }
    unsafe ibReset(sp)
    return 0
  }
  if kind == ALTSVC {
    let s2 = unsafe ses(&mut a, sp) let originLength = u32.toUsize(u32.bitOr(u32.shiftLeft(u8.toU32(s2.sbuf[0]), 8), u8.toU32(s2.sbuf[1]))) drop s2
    if originLength > left { unsafe setState(sp, IB_FRAME_SIZE_ERROR) return 2 }
    unsafe setState(sp, IB_READ_ALTSVC_PAYLOAD)
    return 2
  }
  unsafe ibReset(sp)
  return 0
}

// Sending.
unsafe fn popNext(sp: *mut Session) -> ?*mut Item {
  let mut a = () let s = unsafe ses(&mut a, sp)
  if !Pointer.isNull<Item>(s.urgent.head) { let p = queuePop(&mut s.urgent) let mut b = () let it = unsafe itm(&mut b, unsafe nonnull(p)) it.queued = false return p }
  if !Pointer.isNull<Item>(s.regular.head) { let p = queuePop(&mut s.regular) let mut b = () let it = unsafe itm(&mut b, unsafe nonnull(p)) it.queued = false return p }
  let window = s.remoteWindow > 0 let synReady = !Pointer.isNull<Item>(s.syn.head) drop s
  if synReady && !unsafe outgoingMax(sp) {
    let s2 = unsafe ses(&mut a, sp) let p = queuePop(&mut s2.syn) let mut b = () let it = unsafe itm(&mut b, unsafe nonnull(p)) it.queued = false return p
  }
  if window {
    let stream = unsafe schedNext(sp)
    if Pointer.isNull<Stream>(stream) { return nullItem() }
    let mut c = () let t = unsafe str(&mut c, unsafe nonnull(stream)) return t.item
  }
  return nullItem()
}
unsafe fn predicateForStreamSend(sp: *mut Session, stream: ?*mut Stream) -> i32 {
  if Pointer.isNull<Stream>(stream) { return ERR_STREAM_CLOSED }
  if unsafe isClosing(sp) { return ERR_SESSION_CLOSING }
  if u8.bitAnd(unsafe shutOf(unsafe nonnull(stream)), SHUT_WR) != 0 { return ERR_STREAM_SHUT_WR }
  return 0
}
unsafe fn predicateDataSend(sp: *mut Session, stream: ?*mut Stream) -> i32 {
  let rv = unsafe predicateForStreamSend(sp, stream)
  if rv != 0 { return rv }
  let p = unsafe nonnull(stream)
  let state = unsafe stateOf(p)
  if unsafe isMyStream(sp, unsafe idOf(p)) {
    if state == S_CLOSING { return ERR_STREAM_CLOSING }
    if state == S_RESERVED { return ERR_INVALID_STREAM_STATE }
    return 0
  }
  if state == S_OPENED { return 0 }
  if state == S_CLOSING { return ERR_STREAM_CLOSING }
  return ERR_INVALID_STREAM_STATE
}
// Frame packing into frameBuf, recording where each nghttp2 output chunk ends.
unsafe fn frameStart(sp: *mut Session, length: usize, kind: u8, flags: u8, id: i32) -> bool {
  let mut a = () let s = unsafe ses(&mut a, sp)
  return unsafe s.frameBuf.pushU24(usize.toU32(length)) && unsafe s.frameBuf.push(kind) && unsafe s.frameBuf.push(flags) && unsafe s.frameBuf.pushU32(i32.wrappingToU32(id))
}
unsafe fn chunkEnd(sp: *mut Session) -> bool { let mut a = () let s = unsafe ses(&mut a, sp) return unsafe s.chunkEnds.pushU32(usize.toU32(s.frameBuf.length)) }
unsafe fn resetOutput(sp: *mut Session) -> () { let mut a = () let s = unsafe ses(&mut a, sp) s.frameBuf.clear() s.chunkEnds.clear() s.chunkIndex = 0 }
// select_padding: the padded payload length, or a fatal error.
unsafe fn selectPadding(sp: *mut Session, frame: *mut Frame, maxPayload: usize) -> i64 {
  let mut a = () let s = unsafe ses(&mut a, sp) let set = u32.bitAnd(s.callbacks.set, CB_PADDING) != 0 let callback = s.callbacks.padding let me = s.me let user = s.user drop s
  let mut b = () let hd = unsafe Pointer.borrow<(), Frame>(&b, frame) let length = hd.length drop hd
  if length >= maxPayload || !set { return usize.toI64(length) }
  let maxPadded = if length + MAX_PADLEN < maxPayload { length + MAX_PADLEN } else { maxPayload }
  let rv = unsafe callback(me, frame, maxPadded, user)
  if rv < usize.toI64(length) || rv > usize.toI64(maxPadded) { return i32.toI64(ERR_CALLBACK_FAILURE) }
  return rv
}
// Serializes a header block (HEADERS or PUSH_PROMISE, CONTINUATION as needed) with padding.
unsafe fn packHeaderBlock(sp: *mut Session, item: *mut Item, kind: u8, flags: u8, id: i32, prefix: &[u8]) -> i32 {
  let mut block = emptyBuf()
  let mut a = () let s = unsafe ses(&mut a, sp)
  if !unsafe deflateStart(&mut s.hdDeflate, &mut block) { unsafe block.release() return ERR_NOMEM }
  let mut b = () let it = unsafe itm(&mut b, item)
  let data = it.nva.view() let length = it.nva.length
  let mut offset: usize = 0
  while offset + 9 <= length {
    let nn = u32.toUsize(getU32(data, offset)) let vn = u32.toUsize(getU32(data, offset + 4)) let nvFlags = unsafe byte(data, offset + 8)
    let name = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe atConst(data, offset + 9))
    let value = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe atConst(data, offset + 9 + nn))
    if !unsafe deflateField(&mut s.hdDeflate, &mut block, name, nn, value, vn, nvFlags) { unsafe block.release() return ERR_HEADER_COMP }
    offset = offset + 9 + nn + vn
  }
  drop it drop s
  // The first frame carries the prefix (promised stream id) and as much of the block as fits.
  let total = prefix.length + block.length
  let firstPayload = if total > MAX_PAYLOADLEN { MAX_PAYLOADLEN } else { total }
  let firstFlags = if total > MAX_PAYLOADLEN { flags } else { u8.bitOr(flags, F_END_HEADERS) }
  // Padding is chosen for the first frame (session_headers_add_pad).
  let mut hd = Headers { hd: Frame { length: firstPayload, stream: id, kind: kind, flags: firstFlags, reserved: 0 }, padding: 0, priority: Priority { stream: 0, weight: 16, exclusive: 0 }, entries: nil(), count: 0, category: 0 }
  let maxPayload = if MAX_PAYLOADLEN < firstPayload + MAX_PADLEN { MAX_PAYLOADLEN } else { firstPayload + MAX_PADLEN }
  let padded = unsafe selectPadding(sp, unsafe Intrinsic.pointerReinterpret<*mut Headers, *mut Frame>(Pointer.fromMutRef<Headers>(&mut hd)), maxPayload)
  if isFatal(i64.toI32(padded)) { unsafe block.release() return i64.toI32(padded) }
  let padlen = i64.toUsize(padded) - firstPayload
  let ok = if padlen > 0 { unsafe frameStart(sp, firstPayload + padlen, kind, u8.bitOr(firstFlags, F_PADDED), id) } else { unsafe frameStart(sp, firstPayload, kind, firstFlags, id) }
  if !ok { unsafe block.release() return ERR_NOMEM }
  let s2 = unsafe ses(&mut a, sp)
  if padlen > 0 && !unsafe s2.frameBuf.push(usize.toU8(padlen - 1)) { unsafe block.release() return ERR_NOMEM }
  if !unsafe s2.frameBuf.appendText(prefix) || !unsafe s2.frameBuf.append(block.view(), firstPayload - prefix.length) { unsafe block.release() return ERR_NOMEM }
  let mut zeros: usize = 1
  while zeros < padlen { if !unsafe s2.frameBuf.push(0) { unsafe block.release() return ERR_NOMEM } zeros = zeros + 1 }
  drop s2
  if !unsafe chunkEnd(sp) { unsafe block.release() return ERR_NOMEM }
  let mut sent = firstPayload - prefix.length
  while sent < block.length {
    let n = if block.length - sent > MAX_PAYLOADLEN { MAX_PAYLOADLEN } else { block.length - sent }
    let last = sent + n == block.length
    if !unsafe frameStart(sp, n, CONTINUATION, if last { F_END_HEADERS } else { 0 }, id) { unsafe block.release() return ERR_NOMEM }
    let s3 = unsafe ses(&mut a, sp)
    let ok2 = unsafe s3.frameBuf.append(unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(unsafe atConst(block.view(), sent)), n) drop s3
    if !ok2 || !unsafe chunkEnd(sp) { unsafe block.release() return ERR_NOMEM }
    sent = sent + n
  }
  let mut c = () let it2 = unsafe itm(&mut c, item) it2.padlen = padlen it2.length = firstPayload + padlen it2.flags = firstFlags
  unsafe block.release()
  return 0
}
unsafe fn headersEstimate(item: *mut Item) -> usize {
  let mut b = () let it = unsafe itm(&mut b, item)
  return 12 + 12 * it.count + (it.nva.length - 9 * it.count)
}
unsafe fn prepFrame(sp: *mut Session, item: *mut Item) -> i32 {
