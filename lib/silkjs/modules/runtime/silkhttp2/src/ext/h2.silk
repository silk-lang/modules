  let maxDeflate = opts.maxDeflate let burst = opts.resetBurst
  unsafe Pointer.put<Session>(sp, Session {
    me: raw, user: user, server: server, callbacks: callbacks, options: opts,
    streams: nullStream(), streamSeq: 0, numOutgoing: 0, numIncoming: 0, numIncomingReserved: 0,
    urgent: Queue { head: nullItem(), tail: nullItem(), size: 0 }, regular: Queue { head: nullItem(), tail: nullItem(), size: 0 }, syn: Queue { head: nullItem(), tail: nullItem(), size: 0 },
