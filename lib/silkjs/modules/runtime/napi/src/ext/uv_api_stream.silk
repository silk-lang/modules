  if !six {
    let mut request: [u32; 2] = [0; 2]
    let bytes = unsafe Intrinsic.pointerReinterpret<*mut u32, *mut u8>(Pointer.fromMutRef<u32>(&mut request[0]))
    if !Pointer.isNull<u8>(interfaceAddress) {
