    let known = unsafe HeapCell.payload<ObjectData, ()>(&anchor, unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(entry.holder))
    method = (unsafe known.slotUnchecked(entry.holderIndex)).valueBits()
  } else if keyHi == targetVersion {
    method = (unsafe targetData.slotUnchecked(u64.toUsize(key & 0xffff))).valueBits()
  } else {
    drop state drop targetData
    return unsafe forwardingAccessorSlow(runtime, ip, object, fused, arguments, result)
  }
  drop state
  let methodObj = match method { ValueBits.Object { reference } => reference _ => { return false } }
  let methodData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, methodObj)
  if methodData.classId() != classes.JS_CLASS_BYTECODE_FUNCTION { return false }
  let inner = match &methodData.payload {
    ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode
    _ => { return false }
  }
  drop methodData
  let mut count: usize = 0
  if unsafe codeByte(ip, ACCESSOR_TAIL + 5) == op.OP_get_arg0 { count = 1 }
  let innerBytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, inner)
  let innerLeaf = innerBytecode.leaf
  if (innerLeaf & LEAF_ACCESSOR) == 0 || (innerLeaf & LEAF_CREDIT_MASK) == 0 || u16.toUsize(innerBytecode.argumentCount) > count { return false }
  let innerIp = unsafe innerBytecode.code.start()
  drop innerBytecode
  let innerTail = unsafe codeByte(innerIp, ACCESSOR_TAIL)
  if unsafe codeByte(innerIp, 2) != op.OP_get_loc_field8
    || (innerTail != op.OP_return && innerTail != op.OP_get_length && innerTail != op.OP_get_arg0) { return false }
  let innerKey = unsafe properties.fieldKeyAt(unsafe codeAt(innerIp, 3))
  if u64.shiftRight(innerKey, 16) != targetVersion {
    drop targetData
    return unsafe plainAccessorSlow(runtime, innerIp, target, innerTail, arguments, result)
  }
  let field = (unsafe targetData.slotUnchecked(u64.toUsize(innerKey & 0xffff))).valueBits()
  drop targetData
  return unsafe finishPlainAccessor(field, innerTail, arguments, result)
}
@inlineNever
unsafe fn forwardingAccessorSlow(runtime: *mut HeapHeader, ip: *const u8, object: *mut HeapHeader, fused: bool, arguments: *mut ValueBits, result: *mut ValueBits) -> bool {
  let mut holder = ValueBits.Undefined
  let mut fieldSite: usize = 4
  if fused { fieldSite = 3 }
  if !unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, fieldSite), object, Pointer.fromMutRef<ValueBits>(&mut holder), false) { return false }
  let target = match holder { ValueBits.Object { reference } => reference _ => { return false } }
  let mut method = ValueBits.Undefined
  if !unsafe properties.readFieldCachedAt(runtime, unsafe codeAt(ip, ACCESSOR_TAIL + 1), target, Pointer.fromMutRef<ValueBits>(&mut method), false) { return false }
  if !unsafe isBytecodeFunction(method) { return false }
  let mut count: usize = 0
  if unsafe codeByte(ip, ACCESSOR_TAIL + 5) == op.OP_get_arg0 { count = 1 }
  let inner = match Pointer.nonNullMut<HeapHeader>(unsafe leafBytecode(method, count)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  if !unsafe isAccessor(inner) { return false }
  let innerAnchor = () let innerBytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&innerAnchor, inner)
  let innerIp = unsafe innerBytecode.code.start()
  drop innerBytecode
  let innerTail = unsafe codeByte(innerIp, ACCESSOR_TAIL)
  if unsafe codeByte(innerIp, 2) != op.OP_get_loc_field8
    || (innerTail != op.OP_return && innerTail != op.OP_get_length && innerTail != op.OP_get_arg0) { return false }
  return unsafe plainAccessorLeaf(runtime, innerIp, target, innerTail, arguments, result)
}
/// js_bytecode.charCodeAccessor (`if (this.i < this.len) return this.s.charCodeAt(this.i)`).
/// Zero-call leaf: checks shape.version once against all three inline keys,
/// verifies String.prototype.charCodeAt via RuntimeState's cached slot/cell, and
/// reads compact flat Latin-1 units inline; on any cold miss returns false so
/// evaluate warms the keys/cache once.
@inlineNever
unsafe fn charCodeFieldAccessor(runtime: *mut HeapHeader, code: *mut HeapHeader, ip: *const u8, object: *mut HeapHeader, result: *mut ValueBits) -> bool {
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let version = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).version
  let kPos = unsafe properties.fieldKeyAt(unsafe codeAt(ip, 3))
  let kLen = unsafe properties.fieldKeyAt(unsafe codeAt(ip, 17))
  let kSrc = unsafe properties.fieldKeyAt(unsafe codeAt(ip, 34))
  if ((u64.shiftRight(kPos, 16) ^ version) | (u64.shiftRight(kLen, 16) ^ version) | (u64.shiftRight(kSrc, 16) ^ version)) != 0 { return false }
  let posVal = (unsafe data.slotUnchecked(u64.toUsize(kPos & 0xffff))).valueBits()
  let lenVal = (unsafe data.slotUnchecked(u64.toUsize(kLen & 0xffff))).valueBits()
  let pos = match posVal { ValueBits.Int { value } => value _ => { return false } }
  let len = match lenVal { ValueBits.Int { value } => value _ => { return false } }
  if pos >= len { return false }
  let src = (unsafe data.slotUnchecked(u64.toUsize(kSrc & 0xffff))).valueBits()
  drop data
  let unit = unsafe nativeFunctions.flatCharCodeOf(src, pos)
  if unit < 0 { return false }
  let realm = (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, code)).realm
  if !unsafe properties.isVerifiedCharCodeAt(runtime, realm, unsafe codeAt(ip, 48)) { return false }
  unsafe Pointer.write<ValueBits>(result, ValueBits.Int { value: unit })
  return true
}
/// js_bytecode.charCodeAccessor (`if (arg0 < this.len) return this.s.charCodeAt(arg0)`).
/// Zero-call leaf.
@inlineNever
unsafe fn charCodeArgAccessor(runtime: *mut HeapHeader, code: *mut HeapHeader, ip: *const u8, object: *mut HeapHeader, arguments: *mut ValueBits, result: *mut ValueBits) -> bool {
  let posVal = unsafe Pointer.read<ValueBits>(arguments)
  let pos = match posVal { ValueBits.Int { value } => value _ => { return false } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let version = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, data.shape)).version
  let kLen = unsafe properties.fieldKeyAt(unsafe codeAt(ip, 4))
  let kSrc = unsafe properties.fieldKeyAt(unsafe codeAt(ip, 21))
  if ((u64.shiftRight(kLen, 16) ^ version) | (u64.shiftRight(kSrc, 16) ^ version)) != 0 { return false }
  let lenVal = (unsafe data.slotUnchecked(u64.toUsize(kLen & 0xffff))).valueBits()
  let len = match lenVal { ValueBits.Int { value } => value _ => { return false } }
  if pos >= len { return false }
  let src = (unsafe data.slotUnchecked(u64.toUsize(kSrc & 0xffff))).valueBits()
  drop data
  let unit = unsafe nativeFunctions.flatCharCodeOf(src, pos)
  if unit < 0 { return false }
  let realm = (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, code)).realm
  if !unsafe properties.isVerifiedCharCodeAt(runtime, realm, unsafe codeAt(ip, 35)) { return false }
  unsafe Pointer.write<ValueBits>(result, ValueBits.Int { value: unit })
  return true
}
/// js_bytecode.selectAccessor at ip for this object: compares this.a with the
/// variable (or its field) and returns this.b or this.c, borrowed; false when a
/// read misses the site cache or the comparison needs more than identity.
/// Zero-call leaf on inline-key hit with Int/Object comparison; tail-calls
/// selectAccessorSlow on any key miss or non-Int/Object comparison.
@inlineAlways
unsafe fn selectAccessor(runtime: *mut HeapHeader, function: ValueBits, ip: *const u8, object: *mut HeapHeader, result: *mut ValueBits) -> bool {
  let objAnchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&objAnchor, object)
  let version = (unsafe HeapCell.payload<ShapeData, ()>(&objAnchor, data.shape)).version
  let k1 = unsafe properties.fieldKeyAt(unsafe codeAt(ip, 3))
  if u64.shiftRight(k1, 16) != version {
    drop data
    return unsafe selectAccessorSlow(runtime, function, ip, object, result)
  }
  let left = (unsafe data.slotUnchecked(u64.toUsize(k1 & 0xffff))).valueBits()
  let index = u8.toUsize(unsafe codeByte(ip, ACCESSOR_TAIL + 1)) | usize.shiftLeft(u8.toUsize(unsafe codeByte(ip, ACCESSOR_TAIL + 2)), 8)
  let fnObj = match function { ValueBits.Object { reference } => reference _ => { return false } }
  let fnData = unsafe HeapCell.payload<ObjectData, ()>(&objAnchor, fnObj)
  let refs = match &fnData.payload {
    ObjectPayload.BytecodeFunction { function: closure } => unsafe closure.varRefs.first()
    _ => { return false }
  }
  let cell = match Pointer.nonNullMut<HeapHeader>(unsafe Pointer.read<?*mut HeapHeader>(unsafe Pointer.at<?*mut HeapHeader>(unsafe Pointer.assumeMany<?*mut HeapHeader>(refs), index))) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  drop fnData
  let mut right = unsafe cells.read(cell)
  match right { ValueBits.Uninitialized => { return false } _ => () }
  let mut pos: usize = ACCESSOR_TAIL + 3
  if unsafe codeByte(ip, pos) == op.OP_get_field {
    let holder = match right { ValueBits.Object { reference } => reference _ => { return false } }
    let hData = unsafe HeapCell.payload<ObjectData, ()>(&objAnchor, holder)
    let kRight = unsafe properties.fieldKeyAt(unsafe codeAt(ip, pos + 1))
    if u64.shiftRight(kRight, 16) != (unsafe HeapCell.payload<ShapeData, ()>(&objAnchor, hData.shape)).version {
      drop hData drop data
      return unsafe selectAccessorSlow(runtime, function, ip, object, result)
    }
    right = (unsafe hData.slotUnchecked(u64.toUsize(kRight & 0xffff))).valueBits()
    pos = pos + 1 + properties.FIELD_OPERAND_BYTES
  }
  let compare = unsafe codeByte(ip, pos)
  let mut same: i32 = -1
  match left {
    ValueBits.Int { value: x } => { match right { ValueBits.Int { value: y } => { same = 0 if x == y { same = 1 } } _ => () } }
    ValueBits.Object { reference: a } => { match right { ValueBits.Object { reference: b } => { same = 0 if Pointer.address<HeapHeader>(a) == Pointer.address<HeapHeader>(b) { same = 1 } } _ => () } }
    _ => ()
  }
  if same < 0 {
    drop data
    return unsafe selectAccessorSlow(runtime, function, ip, object, result)
  }
  // compare, if_false8 d, then get_loc_field8(b) return and get_loc_field8(c) return.
  let mut branch = pos + 3
  if (same == 1) != (compare == op.OP_eq || compare == op.OP_strict_eq) { branch = pos + ACCESSOR_TAIL + 2 }
  let k2 = unsafe properties.fieldKeyAt(unsafe codeAt(ip, branch + 1))
  if u64.shiftRight(k2, 16) != version {
    drop data
    return unsafe selectAccessorSlow(runtime, function, ip, object, result)
  }
  let picked = (unsafe data.slotUnchecked(u64.toUsize(k2 & 0xffff))).valueBits()
  unsafe Pointer.write<ValueBits>(result, picked)
  return true
}
@inlineNever
unsafe fn selectAccessorSlow(runtime: *mut HeapHeader, function: ValueBits, ip: *const u8, object: *mut HeapHeader, result: *mut ValueBits) -> bool {
  let mut left = ValueBits.Undefined
  if !unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, 3), object, Pointer.fromMutRef<ValueBits>(&mut left), false) { return false }
  let index = u8.toUsize(unsafe codeByte(ip, ACCESSOR_TAIL + 1)) | usize.shiftLeft(u8.toUsize(unsafe codeByte(ip, ACCESSOR_TAIL + 2)), 8)
  let mut empty = ValueBits.Undefined
  let refs = (unsafe captures(function, Pointer.fromMutRef<ValueBits>(&mut empty))).references
  let cell = match Pointer.nonNullMut<HeapHeader>(unsafe Pointer.read<?*mut HeapHeader>(unsafe Pointer.at<?*mut HeapHeader>(unsafe Pointer.assumeMany<?*mut HeapHeader>(refs), index))) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => invariant()
  }
  let mut right = unsafe cells.read(cell)
  match right { ValueBits.Uninitialized => { return false } _ => () }
  let mut pos: usize = ACCESSOR_TAIL + 3
  if unsafe codeByte(ip, pos) == op.OP_get_field {
    let holder = match right { ValueBits.Object { reference } => reference _ => { return false } }
    if !unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, pos + 1), holder, Pointer.fromMutRef<ValueBits>(&mut right), false) { return false }
    pos = pos + 1 + properties.FIELD_OPERAND_BYTES
  }
  let compare = unsafe codeByte(ip, pos)
  let mut same: i32 = -1
  match left {
    ValueBits.Int { value: x } => { match right { ValueBits.Int { value: y } => { same = 0 if x == y { same = 1 } } _ => () } }
    _ => ()
  }
  if same < 0 {
    if compare == op.OP_strict_eq || compare == op.OP_strict_neq { same = operators.strictIdentity(left, right) if same == 2 { return false } }
    else { same = unsafe operators.looseIdentity(left, right) }
    if same < 0 { return false }
  }
  let mut branch = pos + 3
  if (same == 1) != (compare == op.OP_eq || compare == op.OP_strict_eq) { branch = pos + ACCESSOR_TAIL + 2 }
  let mut picked = ValueBits.Undefined
  if !unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, branch + 1), object, Pointer.fromMutRef<ValueBits>(&mut picked), false) { return false }
  unsafe Pointer.write<ValueBits>(result, picked)
  return true
}
/// Where an accessor's code continues after its `push_this put_loc0` and the
/// fused get_loc_field8(f, 0) (or get_loc0 get_field(f)) that follows.
const ACCESSOR_TAIL: usize = 3 + properties.FIELD_OPERAND_BYTES + 1
@inlineAlways
unsafe fn codeAt(ip: *const u8, offset: usize) -> *const u8 { return unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(ip), offset) }
@inlineAlways
unsafe fn codeByte(ip: *const u8, offset: usize) -> u8 { return unsafe Pointer.read<u8>(unsafe codeAt(ip, offset)) }
/// Leaf fast path for plainAccessor (`return this.f`, `this.f.length`, `this.f[a]`):
/// checks the inline key directly with zero function calls on hit so accessor
/// stays a zero-push leaf, tail-calling plainAccessorSlow on key miss.
@inlineAlways
unsafe fn plainAccessorLeaf(runtime: *mut HeapHeader, ip: *const u8, object: *mut HeapHeader, tail: u8, arguments: *mut ValueBits, result: *mut ValueBits) -> bool {
  let objAnchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&objAnchor, object)
  let key = unsafe properties.fieldKeyAt(unsafe codeAt(ip, 3))
  if u64.shiftRight(key, 16) != (unsafe HeapCell.payload<ShapeData, ()>(&objAnchor, data.shape)).version {
    return unsafe plainAccessorSlow(runtime, ip, object, tail, arguments, result)
  }
  let field = (unsafe data.slotUnchecked(u64.toUsize(key & 0xffff))).valueBits()
  drop data
  return unsafe finishPlainAccessor(field, tail, arguments, result)
}
@inlineNever
unsafe fn plainAccessorSlow(runtime: *mut HeapHeader, ip: *const u8, object: *mut HeapHeader, tail: u8, arguments: *mut ValueBits, result: *mut ValueBits) -> bool {
  let mut field = ValueBits.Undefined
  if !unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, 3), object, Pointer.fromMutRef<ValueBits>(&mut field), false) { return false }
  return unsafe finishPlainAccessor(field, tail, arguments, result)
}
@inlineAlways
unsafe fn finishPlainAccessor(field: ValueBits, tail: u8, arguments: *mut ValueBits, result: *mut ValueBits) -> bool {
  if tail == op.OP_return { unsafe Pointer.write<ValueBits>(result, field) return true }
  let node = match field { ValueBits.Object { reference } => reference _ => { return false } }
  let objectAnchor = () let array = unsafe HeapCell.payload<ObjectData, ()>(&objectAnchor, node)
  if array.classId() != classes.JS_CLASS_ARRAY { return false }
  if tail == op.OP_get_length { unsafe Pointer.write<ValueBits>(result, (unsafe array.slotUnchecked(0)).valueBits()) return true }
  let at = match unsafe Pointer.read<ValueBits>(arguments) { ValueBits.Int { value } => value _ => { return false } }
  if at < 0 { return false }
  let element = match &array.payload {
    ObjectPayload.FastArray { array: fast } => {
      let idx = i32.toUsize(at)
      if idx >= fast.values().length() { return false }
      unsafe fast.values().getUnchecked(idx)
    }
    _ => { return false }
  }
  unsafe Pointer.write<ValueBits>(result, element)
  return true
}
/// function's capture table, or the aligned stand-in empty when it has none.
/// Computed where the caller has just matched function's payload, so the two share it.
@inlineAlways
unsafe fn captures(function: ValueBits, empty: *mut ValueBits) -> Captures {
  let object = match function { ValueBits.Object { reference } => reference _ => invariant() }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return match &data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => {
      let mut table = unsafe Intrinsic.pointerRequalify<*mut ?*mut HeapHeader, *const ?*mut HeapHeader>(unsafe Intrinsic.pointerReinterpret<*mut ValueBits, *mut ?*mut HeapHeader>(empty))
      if closure.varRefs.length() != 0 { table = unsafe closure.varRefs.first() }
      Captures { references: table, scope: closure.scope }
    }
    _ => invariant()
  }
}
@inlineAlways
unsafe fn isBytecodeFunction(value: ValueBits) -> bool {
  let object = match value { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  return data.classId() == classes.JS_CLASS_BYTECODE_FUNCTION
}
/// get_loc_check: an initialized local, else the call's TDZ error.
@inlineAlways
unsafe fn checkedLocal(s: &mut Machine) -> bool {
  let index = u16.toUsize(unsafe s.readU16())
  let value = unsafe s.local(index)
  match value { ValueBits.Uninitialized => { return false } _ => () }
  unsafe s.push(value) return true
}
/// A depth-0 scope slot's value, unless uninitialized.
@inlineAlways
unsafe fn pushScoped(s: &mut Machine, slot: usize) -> bool {
  let value = unsafe Pointer.read<ValueBits>(unsafe scopeSlot(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(s.scope), slot))
  match value { ValueBits.Uninitialized => { return false } _ => () }
  unsafe s.push(value) return true
}
/// A closure cell or global binding's value, unless uninitialized.
@inlineAlways
unsafe fn pushCell(s: &mut Machine, index: usize) -> bool {
  if index >= u16.toUsize(SCOPE_OPERAND) {
    let scoped = unsafe Pointer.read<ValueBits>(unsafe scopes.operandSlot(s.scope, usize.toU16(index)))
    match scoped { ValueBits.Uninitialized => { return false } _ => () }
    unsafe s.push(scoped) return true
  }
  let reference = match Pointer.nonNullMut<HeapHeader>(unsafe s.closureReference(index)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => invariant()
  }
  let value = unsafe cells.read(reference)
  match value { ValueBits.Uninitialized => { return false } _ => () }
  unsafe s.push(value) return true
}
/// OP_get_length's path: an Array's length is its first own property, a plain value.
@inlineAlways
unsafe fn arrayLength(s: &mut Machine) -> bool {
  let node = match unsafe s.top(1) { ValueBits.Object { reference } => reference _ => { return false } }
  let objectAnchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&objectAnchor, node)
  if object.classId() != classes.JS_CLASS_ARRAY { return false }
  let length = (unsafe object.slotUnchecked(0)).valueBits()
  drop object
  unsafe s.set(1, length)
  return true
}
/// OP_get_array_el's path: an in-bounds Int index into a fast Array, or a
/// non-index flat string key on an ordinary object (e.g. StringHashTable.lookup).
@inlineAlways
unsafe fn arrayElement(s: &mut Machine) -> bool {
  let node = match unsafe s.top(2) { ValueBits.Object { reference } => reference _ => { return false } }
  let key = unsafe s.top(1)
  match key {
    ValueBits.Int { value: at } => {
      if at < 0 { return false }
      let objectAnchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&objectAnchor, node)
      if object.classId() != classes.JS_CLASS_ARRAY { return false }
      let element = match &object.payload {
        ObjectPayload.FastArray { array } => {
          let idx = i32.toUsize(at)
          if idx >= array.values().length() { return false }
          unsafe array.values().getUnchecked(idx)
        }
        _ => { return false }
      }
      drop object
      unsafe operators.finishBinary(&mut s, element)
      return true
    }
    ValueBits.String { .. } => {
      if !unsafe properties.peekNamedString(s.runtime, node, key, unsafe s.topCell(2)) { return false }
      unsafe s.discard(1)
      return true
    }
    _ => { return false }
  }
}
/// Whether s.ip (right after a store instruction) is return_undef or a forward
/// goto8 to return_undef, so the store is guaranteed to be the leaf's final step.
@inlineAlways
unsafe fn endsWithReturnUndef(s: &Machine) -> bool {
  let next = unsafe s.peekU8(0)
  if next == op.OP_return_undef { return true }
  if next == op.OP_goto8 {
    let d = unsafe s.peekI8At(1)
    return d > 0 && unsafe s.peekU8(1 + i32.toUsize(d)) == op.OP_return_undef
  }
  return false
}
/// The truth of an operand the keep branches leave in place.
@inlineAlways
unsafe fn truth(value: ValueBits) -> bool {
  match value { ValueBits.Bool { value: flag } => { return flag } _ => () }
  return match value {
    ValueBits.Int { value: n } => n != 0
    ValueBits.Null => false
    ValueBits.Undefined => false
    _ => unsafe primitives.toBoolean(value) != 0
  }
}
/// The truth of the popped operand.
@inlineAlways
unsafe fn condition(s: &mut Machine) -> bool {
  let value = unsafe s.pop()
  match value { ValueBits.Bool { value: flag } => { return flag } _ => () }
  return match value {
    ValueBits.Int { value: n } => n != 0
    ValueBits.Null => false
    ValueBits.Undefined => false
    _ => unsafe primitives.toBoolean(value) != 0
  }
}
/// Float and mixed number operands for add, sub and mul.
@inlineAlways
unsafe fn numbers(s: &mut Machine, opcode: u8) -> bool {
  let mut a: f64 = 0.0 let mut b: f64 = 0.0
  if unsafe operators.floatOperands(&s.*, &mut a, &mut b) {
    let mut result = a * b
    if opcode == op.OP_add { result = a + b } else if opcode == op.OP_sub { result = a - b }
    unsafe operators.finishBinary(&mut s, ValueBits.Float64 { value: result })
    return true
  }
  return unsafe operators.binaryFast(&mut s, opcode)
}
/// eq, neq, strict_eq and strict_neq without coercion; equal tells which answer
/// identical operands give.
@inlineAlways
unsafe fn equality(s: &mut Machine, numeric: u8, strict: bool, equal: bool) -> bool {
  let mut x: i32 = 0 let mut y: i32 = 0
  if unsafe operators.intOperands(&s.*, &mut x, &mut y) {
    let ans = (x == y) == equal
    if !unsafe operators.fusedBranch(&mut s, ans) { unsafe operators.finishBinary(&mut s, ValueBits.Bool { value: ans }) }
    return true
  }
  // Strings, objects, booleans and nullish settle first; only a pair of
  // numbers goes on to the numeric path.
  let left = unsafe s.top(2) let right = unsafe s.top(1)
  let mut same: i32 = -1
  if strict {
    same = operators.strictIdentity(left, right)
    if same == 2 { same = 0 if unsafe operators.sameText(left, right) { same = 1 } }
  } else { same = unsafe operators.looseIdentity(left, right) }
  if same < 0 { return unsafe operators.binaryFast(&mut s, numeric) }
  let ans = (same == 1) == equal
  if !unsafe operators.fusedBranch(&mut s, ans) { unsafe operators.finishBinary(&mut s, ValueBits.Bool { value: ans }) }
  return true
}
/// OP_get_field2 on a primitive string receiver in a leaf: resolves a
/// String.prototype method without retaining it, and fuses
/// `str.charCodeAt(idx)` directly when followed by a simple index operand and
/// `call_method 1`. Takes 6 scalar register pointers (no &mut Machine, no stack
/// args) so evaluate's Machine stays fully SROA'd. Returns null on decline,
/// ip + 4 when the method was written to methodOut (caller advances 1), or
/// ip + skip (> 4) when the fused charCodeAt result was written to topCell.
@inlineNever
unsafe fn stringMethodLeaf(runtime: *mut HeapHeader, context: *mut HeapHeader, ip: *const u8,
  locals: *mut ValueBits, arguments: *mut ValueBits, methodOut: *mut ValueBits) -> ?*const u8 {
  let topCell = unsafe cellAt(methodOut, usize.wrappingSubtract(0, 1))
  let receiver = unsafe Pointer.read<ValueBits>(topCell)
  if !receiver.isString() || !unsafe properties.readStringMethodBorrowedAt(runtime, context, ip, methodOut) { return Pointer.null<u8>() }
  let method = unsafe Pointer.read<ValueBits>(methodOut)
  if unsafe nativeFunctions.unitMethod(method) == nativeFunctions.UNIT_METHOD_CHAR_CODE_AT {
    unsafe properties.noteStringCharCodeAt(runtime, context, ip, method)
    let nextOp = unsafe codeByte(ip, 4)
    let mut width: usize = 0
    let mut index = ValueBits.Undefined
    let mut haveIndex = false
    if nextOp == op.OP_get_loc_field8 {
      let fieldWidth = 1 + properties.FIELD_OPERAND_BYTES + 1
      if unsafe codeByte(ip, 4 + fieldWidth) == op.OP_call_method
        && unsafe codeByte(ip, 5 + fieldWidth) == 1 && unsafe codeByte(ip, 6 + fieldWidth) == 0 {
        let holder = unsafe Pointer.read<ValueBits>(unsafe cellAt(locals, u8.toUsize(unsafe codeByte(ip, 5 + properties.FIELD_OPERAND_BYTES))))
        match holder {
          ValueBits.Object { reference } => {
            if unsafe properties.readFieldKeyedAt(runtime, unsafe codeAt(ip, 5), reference, Pointer.fromMutRef<ValueBits>(&mut index), false) {
              let unit = unsafe nativeFunctions.charCodeOf(receiver, index)
              if unit >= 0 {
                unsafe Pointer.write<ValueBits>(topCell, ValueBits.Int { value: unit })
                return unsafe codeAt(ip, 4 + fieldWidth + 3)
              }
            }
          }
          _ => ()
        }
      }
    } else if nextOp >= op.OP_get_loc0 && nextOp <= op.OP_get_loc3 {
      index = unsafe Pointer.read<ValueBits>(unsafe cellAt(locals, u8.toUsize(nextOp - op.OP_get_loc0))) width = 1 haveIndex = true
    } else if nextOp == op.OP_get_loc8 {
      index = unsafe Pointer.read<ValueBits>(unsafe cellAt(locals, u8.toUsize(unsafe codeByte(ip, 5)))) width = 2 haveIndex = true
    } else if nextOp >= op.OP_get_arg0 && nextOp <= op.OP_get_arg3 {
      index = unsafe Pointer.read<ValueBits>(unsafe cellAt(arguments, u8.toUsize(nextOp - op.OP_get_arg0))) width = 1 haveIndex = true
    } else if nextOp == op.OP_get_arg {
      let argIdx = u8.toUsize(unsafe codeByte(ip, 5)) | usize.shiftLeft(u8.toUsize(unsafe codeByte(ip, 6)), 8)
      index = unsafe Pointer.read<ValueBits>(unsafe cellAt(arguments, argIdx)) width = 3 haveIndex = true
    } else if nextOp >= op.OP_push_0 && nextOp <= op.OP_push_1 {
      index = ValueBits.Int { value: u8.toI32(nextOp - op.OP_push_0) } width = 1 haveIndex = true
    } else if nextOp == op.OP_push_i8 {
      let b = unsafe codeByte(ip, 5)
      index = ValueBits.Int { value: if b >= 128 { u8.toI32(b) - 256 } else { u8.toI32(b) } } width = 2 haveIndex = true
    }
    if haveIndex && unsafe codeByte(ip, 4 + width) == op.OP_call_method
      && unsafe codeByte(ip, 5 + width) == 1 && unsafe codeByte(ip, 6 + width) == 0 {
      let unit = unsafe nativeFunctions.charCodeOf(receiver, index)
      if unit >= 0 {
        unsafe Pointer.write<ValueBits>(topCell, ValueBits.Int { value: unit })
        return unsafe codeAt(ip, 4 + width + 3)
      }
    }
  }
  return unsafe codeAt(ip, 4)
}
/// put_field of value on object using its inline field key first, then probing
/// and caching the key on miss; false leaves everything unchanged.
@inlineNever
unsafe fn storeKeyed(site: *const u8, object: ValueBits, atom: u32, value: ValueBits) -> bool {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let mut stored = unsafe value.retained()
  if unsafe properties.writeOwnField(site, node, Pointer.fromMutRef<ValueBits>(&mut stored)) { return true }
  if !unsafe properties.writeOwnFieldProbeKeyed(site, node, atom, Pointer.fromMutRef<ValueBits>(&mut stored)) {
    if !unsafe gc.releaseIfShared(stored) { invariant() }
    return false
  }
  return true
}
/// storeKeyed for a store that is not the run's last step: entry gets what
/// undoStores needs to take it back. false leaves everything unchanged.
@inlineNever
unsafe fn storeLogged(site: *const u8, object: ValueBits, atom: u32, value: ValueBits, entry: *mut Undo) -> bool {
  let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let mut stored = unsafe value.retained()
  let mut index: usize = 0 let mut old = ValueBits.Undefined
  if !unsafe properties.writeOwnFieldKeeping(site, node, atom, Pointer.fromMutRef<ValueBits>(&mut stored), Pointer.fromMutRef<usize>(&mut index), Pointer.fromMutRef<ValueBits>(&mut old)) {
    if !unsafe gc.releaseIfShared(stored) { invariant() }
    return false
  }
  unsafe Pointer.write<Undo>(entry, Undo { node: node, index: index, old: old })
  return true
}
/// A run's undo log: the scratch above the cells of LEAF_DEPTH runs from top.
@inlineAlways
unsafe fn undoLog(top: *mut ValueBits) -> *mut Undo {
  return unsafe Pointer.castMut<ValueBits, Undo>(unsafe cellAt(top, LEAF_DEPTH * LEAF_CELLS))
}
@inlineAlways
unsafe fn undoAt(log: *mut Undo, index: usize) -> *mut Undo { return unsafe Pointer.atMut<Undo>(unsafe Pointer.assumeManyMut<Undo>(log), index) }
/// Takes back a declined run's count logged stores, last first, so each slot
/// and reference count is what it was before the run.
@cold
unsafe fn undoStores(log: *mut Undo, count: usize) -> () {
  let mut index = count
  while index != 0 {
    index = index - 1
    let entry = unsafe Pointer.read<Undo>(unsafe undoAt(log, index))
    let mut old = entry.old
    unsafe properties.restoreOwnSlot(entry.node, entry.index, Pointer.fromMutRef<ValueBits>(&mut old))
  }
}
/// How a run treats the leaf calls it makes, its stores and its result: the
/// outermost run (Outer) may call other leaves and store, and completes the
/// call; a nested one (Inner) declines both, so nesting stops at one level and
/// only the outermost run has stores to take back, and hands its result to the
/// run that called it.
interface Nesting {
  fn outermost(self: &Self) -> bool
  /// Stores value in object's field atom, keyed at site, logged for rollback; false changed nothing.
  unsafe fn store(self: &mut Self, site: *const u8, object: ValueBits, atom: u32, value: ValueBits) -> bool
  /// Stores value in object's private field name, logged for rollback; false changed nothing.
  unsafe fn storePrivate(self: &mut Self, runtime: *mut HeapHeader, object: ValueBits, name: ValueBits, value: ValueBits) -> bool
  /// Takes back the stores of a run that declined.
  unsafe fn rollback(self: &mut Self) -> ()
  unsafe fn complete(self: &mut Self, value: ValueBits) -> ()
  /// complete with the value in cell, moved as one 16-byte copy: the caller's
  /// next instruction may load it whole, which two 8-byte stores would stall.
  unsafe fn completeFrom(self: &mut Self, cell: *mut ValueBits) -> ()
  /// Releases value, owned (a stored-over value): only the outermost run stores.
  unsafe fn releaseStored(self: &mut Self, runtime: *mut HeapHeader, value: ValueBits) -> ()
  /// Runs a leaf the run calls, with its result written to result.
  unsafe fn call(self: &mut Self, runtime: *mut HeapHeader, frame: *mut StackFrame, captured: Captures, code: *mut HeapHeader,
    arguments: *mut ValueBits, count: usize, receiver: *mut ValueBits, top: *mut ValueBits, result: *mut ValueBits) -> bool
}
struct Outer<H: HeapHooks> { hooks: *mut H, caller: *mut Machine, first: *mut ValueBits, undo: *mut Undo, stores: usize, split: bool }
struct Inner { result: *mut ValueBits }
impl<H: HeapHooks> Nesting for Outer<H> {
  @inlineAlways
  fn outermost(self: &Self) -> bool { return true }
  @inlineAlways
  unsafe fn store(self: &mut Self, site: *const u8, object: ValueBits, atom: u32, value: ValueBits) -> bool {
    if self.stores >= LEAF_UNDO { return false }
    let entry = unsafe undoAt(self.undo, self.stores)
    let node = match object { ValueBits.Object { reference } => reference _ => { return false } }
    // The site's key names the object's shape nearly every time: that store sits here.
    let mut source = value let mut old = ValueBits.Undefined
    let slot = unsafe properties.writeOwnFieldKeyedKeeping(site, node, Pointer.fromMutRef<ValueBits>(&mut source), Pointer.fromMutRef<ValueBits>(&mut old))
    if slot != usize.MAX {
      drop unsafe value.retained()
      unsafe Pointer.write<Undo>(entry, Undo { node: node, index: slot, old: old })
    } else if !unsafe storeLogged(site, object, atom, value, entry) { return false }
    self.stores = self.stores + 1
    return true
  }
  unsafe fn storePrivate(self: &mut Self, runtime: *mut HeapHeader, object: ValueBits, name: ValueBits, value: ValueBits) -> bool {
    if self.stores >= LEAF_UNDO { return false }
    let mut index: usize = 0 let mut old = ValueBits.Undefined
    if !unsafe privateFields.writeKeeping(runtime, object, name, value, Pointer.fromMutRef<usize>(&mut index), Pointer.fromMutRef<ValueBits>(&mut old)) { return false }
    drop unsafe value.retained()
    let node = match object { ValueBits.Object { reference } => reference _ => invariant() }
    unsafe Pointer.write<Undo>(unsafe undoAt(self.undo, self.stores), Undo { node: node, index: index, old: old })
    self.stores = self.stores + 1
    return true
  }
  @inlineAlways
  unsafe fn rollback(self: &mut Self) -> () { if self.stores != 0 { unsafe undoStores(self.undo, self.stores) } }
  @inlineAlways
  unsafe fn complete(self: &mut Self, value: ValueBits) -> () {
    let mut anchor = () let hooks = unsafe Pointer.borrowMut<(), H>(&mut anchor, self.hooks)
    unsafe finish(&mut hooks, self.caller, self.first, unsafe value.retained())
  }
  @inlineAlways
  unsafe fn completeFrom(self: &mut Self, cell: *mut ValueBits) -> () {
    drop unsafe (unsafe Pointer.read<ValueBits>(cell)).retained()
    let mut anchor = () let hooks = unsafe Pointer.borrowMut<(), H>(&mut anchor, self.hooks)
    unsafe release(&mut hooks, self.caller, self.first)
    if self.split { unsafe copyCell(cell, self.first) }
    else { unsafe Pointer.write<ValueBits>(self.first, unsafe Pointer.read<ValueBits>(cell)) }
  }
  @inlineAlways
  unsafe fn releaseStored(self: &mut Self, runtime: *mut HeapHeader, value: ValueBits) -> () {
    let mut anchor = () let hooks = unsafe Pointer.borrowMut<(), H>(&mut anchor, self.hooks)
    unsafe gc.release(&mut hooks, runtime, value)
  }
  unsafe fn call(self: &mut Self, runtime: *mut HeapHeader, frame: *mut StackFrame, captured: Captures, code: *mut HeapHeader,
    arguments: *mut ValueBits, count: usize, receiver: *mut ValueBits, top: *mut ValueBits, result: *mut ValueBits) -> bool {
    let mut nested = Inner { result: result }
    return unsafe evaluate<Inner>(&mut nested, runtime, frame, captured, code, arguments, count, receiver, top)
  }
}
impl Nesting for Inner {
  @inlineAlways
  fn outermost(self: &Self) -> bool { return false }
  @inlineAlways
  unsafe fn store(self: &mut Self, site: *const u8, object: ValueBits, atom: u32, value: ValueBits) -> bool { return false }
  @inlineAlways
  unsafe fn storePrivate(self: &mut Self, runtime: *mut HeapHeader, object: ValueBits, name: ValueBits, value: ValueBits) -> bool { return false }
  @inlineAlways
  unsafe fn rollback(self: &mut Self) -> () { return () }
  @inlineAlways
  unsafe fn complete(self: &mut Self, value: ValueBits) -> () { unsafe Pointer.write<ValueBits>(self.result, value) }
  @inlineAlways
  unsafe fn completeFrom(self: &mut Self, cell: *mut ValueBits) -> () { unsafe Pointer.write<ValueBits>(self.result, unsafe Pointer.read<ValueBits>(cell)) }
  unsafe fn releaseStored(self: &mut Self, runtime: *mut HeapHeader, value: ValueBits) -> () { return Intrinsic.trap("inner leaf runs never store") }
  unsafe fn call(self: &mut Self, runtime: *mut HeapHeader, frame: *mut StackFrame, captured: Captures, code: *mut HeapHeader,
    arguments: *mut ValueBits, count: usize, receiver: *mut ValueBits, top: *mut ValueBits, result: *mut ValueBits) -> bool { return false }
}
/// Completes the call with value, an owned result: the caller's operands from
/// first are released and value pushed in their place.
@inlineAlways
unsafe fn finish<H: HeapHooks>(hooks: &mut H, caller: *mut Machine, first: *mut ValueBits, value: ValueBits) -> () {
  unsafe release(&mut hooks, caller, first)
  unsafe Pointer.write<ValueBits>(first, value)
}
/// Releases the caller's operands from first and leaves first its top cell, for
/// the result to be written there.
@inlineAlways
unsafe fn release<H: HeapHooks>(hooks: &mut H, caller: *mut Machine, first: *mut ValueBits) -> () {
  let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, caller)
  let runtime = machine.runtime
  let end = Pointer.address<ValueBits>(machine.stackTop)
  let mut cell = first
  while Pointer.address<ValueBits>(cell) != end {
    unsafe gc.release(&mut hooks, runtime, unsafe Pointer.read<ValueBits>(cell))
    cell = unsafe cellAt(cell, 1)
  }
  machine.stackTop = unsafe cellAt(first, 1)
}
