      250 => { // OP_get_loc_field8
        // get_loc8 then get_field, without retaining the local's object.
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(properties.FIELD_OPERAND_BYTES)))
        if !unsafe properties.pushCellField(&mut m, cell, !observe) && !unsafe properties.cellFieldCached(&mut m, cell) {
          unsafe sync(&m, &mut machine)
          match Pointer.nonNullMut<Machine>(run unsafe readGetter(&mut hooks, memory, &mut machine, cell, false, properties.FIELD_OPERAND_BYTES + 1)) {
            Option<*mut Machine>.Some { value } => { current = value unsafe reloadFrom(current, &mut m) }
            Option<*mut Machine>.None => { run unsafe properties.cellFieldStep(&mut hooks, memory, &mut machine, cell) unsafe sync(&machine, &mut m) }
          }
        }
      }
      251 => { // OP_get_arg_field8
        // get_arg then get_field, without retaining the argument's object.
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.argumentCell(u8.toUsize(unsafe m.peekU8(properties.FIELD_OPERAND_BYTES)))
        if !unsafe properties.pushCellField(&mut m, cell, !observe) && !unsafe properties.cellFieldCached(&mut m, cell) {
          unsafe sync(&m, &mut machine)
          match Pointer.nonNullMut<Machine>(run unsafe readGetter(&mut hooks, memory, &mut machine, cell, false, properties.FIELD_OPERAND_BYTES + 1)) {
            Option<*mut Machine>.Some { value } => { current = value unsafe reloadFrom(current, &mut m) }
            Option<*mut Machine>.None => { run unsafe properties.cellFieldStep(&mut hooks, memory, &mut machine, cell) unsafe sync(&machine, &mut m) }
          }
        }
      }
      252 => { // OP_get_loc_length8
        // get_loc8 then get_length, without retaining the local.
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        if !unsafe properties.pushCellLength(&mut m, cell) { unsafe sync(&m, &mut machine) run unsafe properties.cellLengthStep(&mut hooks, memory, &mut machine, cell) unsafe sync(&machine, &mut m) }
      }
      253 => { // OP_get_arg_length8
        // get_arg then get_length, without retaining the argument.
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.argumentCell(u8.toUsize(unsafe m.peekU8(0)))
        if !unsafe properties.pushCellLength(&mut m, cell) { unsafe sync(&m, &mut machine) run unsafe properties.cellLengthStep(&mut hooks, memory, &mut machine, cell) unsafe sync(&machine, &mut m) }
      }
      254 => { // OP_get_loc_el8
        // get_loc8 array, get_loc8 index, then get_array_el, retaining neither.
        unsafe refresh(&machine, &mut m)
        let array = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(0)))
        let index = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(1)))
        if !unsafe properties.pushCellElement(&mut m, array, index) { unsafe sync(&m, &mut machine) if !((unsafe Pointer.read<ValueBits>(array)).isString() && run unsafe stringCellAnswer(&mut machine, array, index)) { run unsafe properties.cellElementStep(&mut hooks, memory, &mut machine, array, index) } unsafe sync(&machine, &mut m) }
      }
      255 => { // OP_get_arg_el8
        // get_arg array, get_loc8 index, then get_array_el, retaining neither.
        unsafe refresh(&machine, &mut m)
        let array = unsafe m.argumentCell(u8.toUsize(unsafe m.peekU8(0)))
        let index = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(1)))
        if !unsafe properties.pushCellElement(&mut m, array, index) { unsafe sync(&m, &mut machine) if !((unsafe Pointer.read<ValueBits>(array)).isString() && run unsafe stringCellAnswer(&mut machine, array, index)) { run unsafe properties.cellElementStep(&mut hooks, memory, &mut machine, array, index) } unsafe sync(&machine, &mut m) }
      }
      62 => { // OP_get_field2
        unsafe refresh(&machine, &mut m)
        let mut hit = unsafe properties.pushFieldOperand(&mut m)
        if !hit {
          unsafe sync(&m, &mut machine)
          // A method of a string (text.charCodeAt, text.substring) is read
          // without primitiveFieldSite's frame.
          let mut answer = FIELD_MISSED
          if (unsafe machine.top(1)).isString() { answer = unsafe stringFieldSite(&mut hooks, &mut machine, !observe) }
          else { answer = run unsafe primitiveFieldSite(&machine) }
          // Reloaded after the call, so no register stays live across it.
          unsafe sync(&machine, &mut m)
          // The method was pushed, n.toString() was answered whole, or
          // s.charCodeAt(i) was fused (which already updated ip and top).
          if answer == FIELD_PUSHED { unsafe m.skip(4) unsafe m.advance(1) hit = true }
          else if answer == FIELD_ANSWERED { unsafe m.skip(7) hit = true }
          else if answer == FIELD_FUSED { hit = true }
        }
        if !hit { unsafe sync(&m, &mut machine) drop run unsafe properties.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
      }
      63 => { // OP_put_field
        unsafe refresh(&machine, &mut m)
        let stored = run unsafe properties.putFieldOperand(&mut hooks, &mut m)
        if !stored {
          unsafe sync(&m, &mut machine)
          match Pointer.nonNullMut<Machine>(unsafe writeSetter(&mut hooks, &mut machine)) {
            Option<*mut Machine>.Some { value } => { current = value unsafe reloadFrom(current, &mut m) }
            Option<*mut Machine>.None => {
              if !run unsafe properties.putLengthOperand(&mut hooks, &mut machine) { drop run unsafe properties.step(&mut hooks, memory, &mut machine, opcode) }
              unsafe sync(&machine, &mut m)
            }
          }
        }
      }
      67 => { // OP_get_array_el
        unsafe refresh(&machine, &mut m)
        let read = unsafe properties.readElementOperand(&mut m)
        match Pointer.nonNullMut<HeapHeader>(read) {
          Option<*mut HeapHeader>.Some { value } => {
            // `heap[i] | 0` (compiled C's int coercion) of an Int element is the element.
            if unsafe operators.intCoercionNext(&m) { unsafe m.skip(3) }
            unsafe gc.releaseObjectHeader(&mut hooks, m.runtime, value)
          }
          Option<*mut HeapHeader>.None => {
            unsafe sync(&m, &mut machine)
            // this[symbol] (Node's internals key their fields by symbols).
            if !((unsafe machine.top(1)).tag() == -8 && unsafe properties.readSymbolOperand(&mut hooks, &mut machine)) {
            // text[i] of a Latin-1 code unit: the runtime's unit string.
            if !(unsafe machine.top(2)).isString() || !run unsafe stringElementAnswer(&mut hooks, &mut machine) {
            // arguments[i] on a lazy arguments slot's stand-in answers from the frame.
            if !((unsafe machine.top(2)).tag() == 4 && run unsafe factories.lazyArgumentsRead(&mut hooks, memory, &mut machine, opcode)) {
              let other = unsafe properties.readStringElementOperand(&mut hooks, &mut machine)
              match Pointer.nonNullMut<HeapHeader>(other) {
                Option<*mut HeapHeader>.Some { value } => { unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, value) }
                Option<*mut HeapHeader>.None => { drop run unsafe properties.step(&mut hooks, memory, &mut machine, opcode) }
              }
            }
            }
            }
            unsafe sync(&machine, &mut m)
          }
        }
      }
      68 => { let done = unsafe properties.replaceElementOperand(&mut m) if !done { unsafe sync(&m, &mut machine) if !((unsafe machine.top(1)).tag() == -8 && unsafe properties.keepSymbolOperand(&mut hooks, &mut machine, 2)) { drop run unsafe properties.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) } } // OP_get_array_el2
      69 => { let done = unsafe properties.pushElementOperand(&mut m) if !done { unsafe sync(&m, &mut machine) if !((unsafe machine.top(1)).tag() == -8 && unsafe properties.keepSymbolOperand(&mut hooks, &mut machine, 3)) { drop run unsafe properties.step(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) } } // OP_get_array_el3
      70 => { // OP_put_array_el
        unsafe refresh(&machine, &mut m)
        if !unsafe properties.storeElementOperand(&mut hooks, &mut m) {
          unsafe sync(&m, &mut machine)
          // this[symbol] = v (Node's internals key their fields by symbols).
          let stored = if (unsafe machine.top(2)).tag() == -8 { unsafe properties.storeSymbolOperand(&mut hooks, &mut machine) } else { unsafe properties.writeElementOperand(&mut hooks, &mut machine) }
          unsafe sync(&machine, &mut m)
          if !stored && !run unsafe properties.addElementOperand(&mut hooks, &mut machine) { drop run unsafe properties.step(&mut hooks, memory, &mut machine, opcode) }
          if !stored { unsafe sync(&machine, &mut m) }
        }
      }
      71 => { // OP_strict_eq_imm8: push_i8 k, then strict_eq
        unsafe refresh(&machine, &mut m)
        let k = unsafe m.readI8()
        let value = unsafe m.top(1)
        let same = operators.equalsSmallInt(value, k)
        if observe || !unsafe operators.fusedTestBranch(&mut m, same) { unsafe m.set(1, ValueBits.Bool { value: same }) }
        unsafe locals.releaseIn(&mut hooks, &machine, value)
      }
      72 => { // OP_strict_neq_imm8: push_i8 k, then strict_neq
        unsafe refresh(&machine, &mut m)
        let k = unsafe m.readI8()
        let value = unsafe m.top(1)
        let differ = !operators.equalsSmallInt(value, k)
        if observe || !unsafe operators.fusedTestBranch(&mut m, differ) { unsafe m.set(1, ValueBits.Bool { value: differ }) }
        unsafe locals.releaseIn(&mut hooks, &machine, value)
      }
      150 => { unsafe sync(&m, &mut machine) drop run unsafe properties.deleteOperation(&mut hooks, memory, &mut machine) unsafe sync(&machine, &mut m) } // OP_delete
      237 => { // OP_get_length
        // Array, String, Rope, and cached TypedArray lengths with refCount > 1
        // answer inline without sync; lazy arguments and last-ref fall back.
        unsafe refresh(&machine, &mut m)
        if !unsafe properties.fastLengthOperand(&mut m) {
          unsafe sync(&m, &mut machine)
          if !unsafe properties.lengthOperand(&mut hooks, &mut machine) {
            if !((unsafe machine.top(1)).tag() == 4 && run unsafe factories.lazyArgumentsRead(&mut hooks, memory, &mut machine, opcode)) {
              drop run unsafe properties.step(&mut hooks, memory, &mut machine, opcode)
            }
          }
          unsafe sync(&machine, &mut m)
        }
      }
      55 => { unsafe refresh(&machine, &mut m) let done = unsafe globals.pushInitialized(&mut m) if !done { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) } } // OP_get_var_undef
      56 => { // OP_get_var
        unsafe refresh(&machine, &mut m)
        let right = unsafe globals.peekInitialized(&m)
        match right {
          ValueBits.Uninitialized => { unsafe sync(&m, &mut machine) drop run unsafe globals.step(&mut hooks, memory, &mut machine, opcode) unsafe sync(&machine, &mut m) }
          ValueBits.Object { .. } => {
            // `x instanceof G` (Scheme's pair tests) tests against the global where
            // it is, skipping the retain and release of G: quickInstanceOf runs no
            // JS. Only an object can be a constructor, so other values skip the peek.
            let mut done = false
            if unsafe m.peekU8(2) == 165 {
              let left = unsafe m.top(1)
              let answer = unsafe objects.quickInstanceOf(machine.runtime, left, right)
              if answer >= 0 {
                unsafe m.set(1, ValueBits.Bool { value: answer == 1 })
                unsafe m.skip(3)
                unsafe locals.releaseIn(&mut hooks, &machine, left)
                done = true
              }
            }
            if !done { unsafe m.skip(2) unsafe m.push(unsafe right.retained()) }
          }
          _ => { unsafe m.skip(2) unsafe m.push(unsafe right.retained()) }
