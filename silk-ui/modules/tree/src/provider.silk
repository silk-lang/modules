//! The measurement provider css-layout calls during layout: text through ui-text, natural sizes
//! of image and icon nodes, overlay scrollbars that reserve no space.
import mutation { ScrollbarWidth, ScrollbarGutter }
import ui_text.system { TextSystem }
import layout.lib {
  TextMeasure,
  TextContext,
  TextBreak,
  TextAnalysis,
  TextShapeRequest,
  TextRun,
  TextError,
  FontRequest,
  FontMetrics,
  Measure,
  MeasureRequest,
  Measured,
  NaturalDimensions,
  ScrollbarRequest,
  ScrollbarMetrics,
  Size,
  Rect,
  BaselineSet
}
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.platform.native.clock { NativeClock }
import silk.num.u32
import silk.num.i64

pub struct Provider<'a> {
  pub text: TextSystem<'a>,
  /// Natural sizes by measurement key (the node's slot).
  pub naturals: List<NaturalDimensions>,
}

impl<'a> Provider<'a> {
  /// Sets the natural size of measurement key `key`.
  pub effect fn setNatural(self: &mut Self, key: usize, natural: NaturalDimensions) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while self.naturals.length() <= key {
      run self.naturals.append(NaturalDimensions.none())
    }
    self.naturals.set(key, natural)
  }
}

impl<'a> TextMeasure for Provider<'a> {
  fn beginTextLayout(provider: &mut Self) {
    TextMeasure.beginTextLayout(&mut provider.text)
  }

  fn plainText(provider: &Self) -> bool {
    return TextMeasure.plainText(&provider.text)
  }

  fn reportsBreakSafety(provider: &Self) -> bool {
    return TextMeasure.reportsBreakSafety(&provider.text)
  }

  effect fn analyze(
    provider: &mut Self,
    context: TextContext<'_, '_>,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    if provider.text.timing {
      let start = run clockNanos()
      let analysis = run TextMeasure.analyze(&mut provider.text, context, &mut output)
      let end = run clockNanos()
      provider.text.analyzeNanos = provider.text.analyzeNanos + i64.toU64(end - start)
      return move analysis
    }
    return run TextMeasure.analyze(&mut provider.text, context, &mut output)
  }

  effect fn shape(
    provider: &mut Self,
    request: TextShapeRequest<'_, '_>,
    output: &mut List<TextRun>,
  )
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    if provider.text.timing {
      let start = run clockNanos()
      run TextMeasure.shape(&mut provider.text, request, &mut output)
      let end = run clockNanos()
      provider.text.shapeNanos = provider.text.shapeNanos + i64.toU64(end - start)
      return
    }
    run TextMeasure.shape(&mut provider.text, request, &mut output)
  }
}

impl<'a> Measure for Provider<'a> {
  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    return Measured {
      size: Size { width: 0.0, height: 0.0 },
      contentBlockSize: 0.0,
      firstBaselines: BaselineSet.zero(),
      lastBaselines: BaselineSet.zero(),
      hasBaseline: false,
      hasLineBoxes: false,
      scrollableOverflow: Rect.zero(),
    }
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    if key < provider.naturals.length() {
      return provider.naturals.get(key)
    }
    return NaturalDimensions.none()
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    let thickness: f32 = if request.width == ScrollbarWidth.None {
      0.0
    } else if request.width == ScrollbarWidth.Thin {
      6.0
    } else {
      10.0
    }
    return ScrollbarMetrics {
      horizontal: thickness,
      vertical: thickness,
      overlay: request.gutter == ScrollbarGutter.Auto,
      horizontalOnTop: false,
      verticalOnLeft: false,
    }
  }

  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    return TextSystem.font(&provider.text, request)
  }
}

/// The monotonic clock in nanoseconds, for `TextSystem.timing` (benchmarks only). Only native
/// Linux and macOS builds read it: elsewhere it is 0, so a Wasm build imports no clock from its
/// host (the browser pages give it none).
effect fn clockNanos() -> i64 {
  static if (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
    let mark = run NativeClock.now()
    return mark.seconds() * 1000000000 + u32.toI64(mark.subsecondNanoseconds())
  } else {
    return 0
  }
}
