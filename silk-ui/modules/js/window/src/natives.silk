//! `fn.async(...)` of a `.silk` import: each `__ui.nativeStart` call runs the app's exported
//! Silk function on a thread of its own, and the window's loop hands the reply back to
//! JavaScript once the thread ends (see `ui_js_calls.natives`).
import ui_js.lib { Natives, NativeCall, Reply, StartedNative }
import ui_tree_window.background { Background }
import ui_tree_window.platform_thread { Nudge }
import ui_transport.cancel { CancellationToken }
import ui_transport.channel {
  TryRecvError,
  UnboundedChannel,
  UnboundedPair,
  UnboundedReceiver,
  UnboundedSender,
}
import ui_transport.pool { WorkPoolHandle }
import ui_transport.wake { WakeHandle }
import silk.collections.list { List }
import silk.concurrency.thread { Transferable }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

struct Running {
  token: u32,
  job: Background<NativeCall>,
}

/// A call that ended: its promise's token and what the function replied.
pub struct Finished {
  pub token: u32,
  pub reply: Reply,
}

impl Transferable for Finished {}

struct PooledNative {
  token: u32,
  natives: Natives,
  call: NativeCall,
  doneTx: UnboundedSender<Finished>,
  wake: Nudge,
}

impl Transferable for PooledNative {}

fn runPooledNative(payload: PooledNative, cancel: &CancellationToken) -> () {
  let PooledNative { token, natives, call, doneTx, wake } = move payload
  let _unused = cancel.check()
  let finished = ran(natives, move call)
  drop run Effect.result(doneTx.send(Finished { token: token, reply: move finished.reply }))
  wake.nudge()
}

/// The calls running on threads or pooled on `AppPool`.
pub struct NativeJobs {
  running: List<Running>,
  /// Calls that could not start, answered on the next poll.
  refused: List<Finished>,
  appPool: Option<WorkPoolHandle>,
  groupId: u32,
  wake: Option<Nudge>,
  doneTx: Option<UnboundedSender<Finished>>,
  doneRx: Option<UnboundedReceiver<Finished>>,
  inFlight: usize,
}

effect fn outOfMemory(error: OutOfMemoryError) -> () {
  drop error
}

/// Runs `call` on this thread: what a job's thread does.
fn ran(natives: Natives, call: NativeCall) -> NativeCall {
  let mut owned = move call
  let mut allocator = Allocator.systemAllocatorProvider()
  run Effect.catchAll(natives.call(&mut owned), outOfMemory)
    |> Effect.provideMut<Allocator>(&mut allocator)
  return move owned
}

impl NativeJobs {
  pub fn make() -> NativeJobs {
    return NativeJobs {
      running: List<Running>.make(),
      refused: List<Finished>.make(),
      appPool: Option<WorkPoolHandle>.None,
      groupId: 1,
      wake: Option<Nudge>.None,
      doneTx: Option<UnboundedSender<Finished>>.None,
      doneRx: Option<UnboundedReceiver<Finished>>.None,
      inFlight: 0,
    }
  }

  /// Dispatches `fn.async` calls onto `appPool` under `groupId` and wakes via `wake`.
  pub effect fn attachPool(
    self: &mut Self,
    appPool: WorkPoolHandle,
    groupId: u32,
    wake: Nudge,
  ) -> ()
    ! OutOfMemoryError {
    let pair = run UnboundedChannel.make<Finished>(WakeHandle.noop())
    let UnboundedPair<Finished> { sender, receiver } = move pair
    self.appPool = Option<WorkPoolHandle>.some(move appPool)
    self.groupId = groupId
    self.wake = Option<Nudge>.some(move wake)
    self.doneTx = Option<UnboundedSender<Finished>>.some(move sender)
    self.doneRx = Option<UnboundedReceiver<Finished>>.some(move receiver)
  }

  /// Whether completed native calls wake the owning group directly without polling.
  pub fn wakesOnCompletion(self: &Self) -> bool {
    return self.wake.isSome()
  }

  /// Whether a call is still running: the loop should come back for it.
  pub fn pending(self: &Self) -> bool {
    return self.inFlight != 0 || self.running.length() != 0 || self.refused.length() != 0
  }

  /// Starts each of `started` on the attached `AppPool` or a fallback thread.
  pub effect fn start(self: &mut Self, started: List<StartedNative>, natives: Natives) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut calls = move started
    while calls.length() > 0 {
      let StartedNative { token, call } = calls.remove(0)
      let mut fallback = Option<NativeCall>.None
      if let Option<WorkPoolHandle>.Some { value: pool } = &self.appPool {
        if let Option<UnboundedSender<Finished>>.Some { value: tx } = &self.doneTx {
          if let Option<Nudge>.Some { value: wake } = &self.wake {
            let cancelToken = run CancellationToken.make()
            let payload = PooledNative {
              token: token,
              natives: natives,
              call: move call,
              doneTx: tx.clone(),
              wake: wake.clone(),
            }
            drop run pool.submitWith(
              self.groupId,
              move payload,
              runPooledNative,
              move cancelToken,
              WakeHandle.noop(),
            )
            self.inFlight = self.inFlight + 1
          } else {
            fallback = Option<NativeCall>.some(move call)
          }
        } else {
          fallback = Option<NativeCall>.some(move call)
        }
      } else {
        fallback = Option<NativeCall>.some(move call)
      }
      let fallbackCall = match move fallback {
        Option<NativeCall>.Some { value } => move value
        Option<NativeCall>.None => { continue }
      }
      let begun = run Effect.result(
        Background<NativeCall>.start(
          || -> NativeCall {
            return ran(natives, move fallbackCall)
          },
        ),
      )
      match move begun {
        Result.Success { value } => {
          run self.running.append(Running { token: token, job: move value })
        }
        Result.Failure { error } => {
          drop error
          run self.refused.append(
            Finished {
              token: token,
              reply: Reply.Failed {
                message: run String.copy("could not start a thread for the Silk function"),
              },
            },
          )
        }
      }
    }
  }

  /// The calls that ended since the last poll, oldest first.
  pub effect fn finished(self: &mut Self) -> List<Finished>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut done = Intrinsic.replace(self.refused, List<Finished>.make())
    if let Option<UnboundedReceiver<Finished>>.Some { value: rx } = &mut self.doneRx {
      while true {
        match rx.tryRecv() {
          Result.Success { value } => {
            if self.inFlight > 0 {
              self.inFlight = self.inFlight - 1
            }
            run done.append(move value)
          }
          Result.Failure { error } => match error {
            TryRecvError.Empty => { break }
            TryRecvError.Closed => { break }
          }
        }
      }
    }
    let mut at: usize = 0
    while at < self.running.length() {
      if !self.running.asSlice()[at].job.ready() {
        at = at + 1
        continue
      }
      let mut running = self.running.remove(at)
      match running.job.poll() {
        Option<NativeCall>.Some { value } => {
          run done.append(Finished { token: running.token, reply: move value.reply })
        }
        Option<NativeCall>.None => {}
      }
    }
    return move done
  }
}
