/// libuv's uv_udp_try_send: the bytes sent, or a negative errno (UV_EAGAIN with sends queued).
pub export "C" fn uv_udp_try_send(udp: *mut u8, bufs: *const Buf, count: u32, address: ?*const u8) -> i32 {
