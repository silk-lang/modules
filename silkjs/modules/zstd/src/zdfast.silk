//! The `dfast` block compressor: a port of `lib/compress/zstd_double_fast.c` of Zstandard 1.5.7
//! (`ZSTD_fillDoubleHashTable`, `ZSTD_compressBlock_doubleFast` and its `extDict` variant).
//! The long hash (8 bytes) is `ms.hashTable`; the short hash is `ms.chainTable`.
//! See `zfast` for the signature of a block compressor.
import mem
import cstate
import cstate { MatchState, SeqStore }
import zfast
import silk.num.u8
import silk.num.u32
import silk.num.usize

/// `ZSTD_fillDoubleHashTable` for a context (`ZSTD_tfp_forCCtx`). `dtlm` is `zfast.DTLM_*`.
pub unsafe fn fillDoubleHashTable(ms: &mut MatchState, end: [*]const u8, dtlm: u32) -> () {
  let hashLarge = ms.hashTable
  let hBitsL = ms.cParams.hashLog
  let mls = ms.cParams.minMatch
  let hashSmall = ms.chainTable
  let hBitsS = ms.cParams.chainLog
  let base = ms.window.base
  let mut ip = mem.z(ms.nextToUpdate)
  // The reference compares pointers: with fewer than 8 bytes after the base, `end - 8` is
  // before every position and nothing is inserted. As an index it would wrap.
  if mem.us(mem.addr(end), mem.addr(base)) < 8 { return () }
  let iend = mem.us(mem.us(mem.addr(end), mem.addr(base)), 8)
  // Always insert into the long table; fill the other positions only if their slot is empty.
  while mem.ua(ip, 2) <= iend {
    let curr = mem.t32(ip)
    let mut i: u32 = 0
    while i < 3 {
      let smHash = unsafe cstate.hashPtr(base, mem.ua(ip, mem.z(i)), hBitsS, mls)
      let lgHash = unsafe cstate.hashPtr(base, mem.ua(ip, mem.z(i)), hBitsL, 8)
      if i == 0 { unsafe cstate.tset(hashSmall, smHash, mem.a32(curr, i)) }
      if i == 0 || unsafe cstate.tget(hashLarge, lgHash) == 0 { unsafe cstate.tset(hashLarge, lgHash, mem.a32(curr, i)) }
      // Only load the extra positions for the full method.
      if dtlm == 0 { break }
      i = i + 1
    }
    ip = mem.ua(ip, 3)
  }
}

// `ZSTD_compressBlock_doubleFast_noDict_generic`.
@inlineAlways
unsafe fn dfastNoDictGeneric(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize, mls: u32) -> usize {
  let hashLong = ms.hashTable
  let hBitsL = ms.cParams.hashLog
  let hashSmall = ms.chainTable
  let hBitsS = ms.cParams.chainLog
  let base = ms.window.base
  let istart = mem.us(mem.addr(src), mem.addr(base))
  let mut anchor = istart
  let endIndex = mem.t32(mem.ua(istart, srcSize))
  // The presplitter can reduce the block; the lowest valid index is that of the whole block.
  let prefixLowestIndex = cstate.getLowestPrefixIndex(&ms, endIndex, ms.cParams.windowLog)
  let prefixLowest = mem.z(prefixLowestIndex)
  let iend = mem.ua(istart, srcSize)
  let ilimit = mem.us(iend, 8)
  let mut offset1 = unsafe mem.r32(unsafe mem.ro(rep), 0)
  let mut offset2 = unsafe mem.r32(unsafe mem.ro(rep), 4)
  let mut offsetSaved1: u32 = 0
  let mut offsetSaved2: u32 = 0
  let kStepIncr: usize = 256
  let mut ip = istart
  if ip == prefixLowest { ip = mem.ua(ip, 1) }
  let current = mem.t32(ip)
  let windowLow = cstate.getLowestPrefixIndex(&ms, current, ms.cParams.windowLog)
  let maxRep = mem.s32(current, windowLow)
  if offset2 > maxRep { offsetSaved2 = offset2 offset2 = 0 }
  if offset1 > maxRep { offsetSaved1 = offset1 offset1 = 0 }
  // Outer loop: one turn for each sequence.
  while true {
    let mut step: usize = 1
    let mut nextStep = mem.ua(ip, kStepIncr)
    let mut ip1 = mem.ua(ip, step)
    if ip1 > ilimit { break }
    let mut hl0 = unsafe cstate.hashPtr(base, ip, hBitsL, 8)
    let mut idxl0 = unsafe cstate.tget(hashLong, hl0)
    let mut hl1: usize = 0
    let mut idxl1: u32 = 0
    let mut curr: u32 = 0
    let mut mLength: usize = 0
    let mut offset: u32 = 0
    let mut match_: usize = 0
    // 0: end of block; 1: repeat match, stored; 2: `_match_found`; 3: `_search_next_long`.
    let mut found: u32 = 0
    // Inner loop: one turn for each position searched.
    while true {
      let hs0 = unsafe cstate.hashPtr(base, ip, hBitsS, mls)
      let idxs0 = unsafe cstate.tget(hashSmall, hs0)
      curr = mem.t32(ip)
      // Update both tables.
      unsafe cstate.tset(hashSmall, hs0, curr)
      unsafe cstate.tset(hashLong, hl0, curr)
      // Check the repeat offset, without a branch on its validity.
      if offset1 > 0 && unsafe mem.r32(base, mem.us(mem.ua(ip, 1), mem.z(offset1))) == unsafe mem.r32(base, mem.ua(ip, 1)) {
        mLength = mem.ua(unsafe cstate.count(base, mem.ua(ip, 5), base, mem.us(mem.ua(ip, 5), mem.z(offset1)), iend), 4)
        ip = mem.ua(ip, 1)
        unsafe cstate.storeSeq(&mut seqStore, mem.us(ip, anchor), base, anchor, iend, cstate.REPCODE1, mLength)
        found = 1
        break
      }
      hl1 = unsafe cstate.hashPtr(base, ip1, hBitsL, 8)
      // A long match at `idxl0` must be inside the prefix.
      if idxl0 >= prefixLowestIndex && unsafe mem.r64(base, mem.z(idxl0)) == unsafe mem.r64(base, ip) {
        match_ = mem.z(idxl0)
        mLength = mem.ua(unsafe cstate.count(base, mem.ua(ip, 8), base, mem.ua(match_, 8), iend), 8)
        offset = mem.t32(mem.us(ip, match_))
        // Catch up.
        while ip > anchor && match_ > prefixLowest && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(base, mem.us(match_, 1)) {
          ip = mem.us(ip, 1) match_ = mem.us(match_, 1) mLength = mem.ua(mLength, 1)
        }
        found = 2
        break
      }
      idxl1 = unsafe cstate.tget(hashLong, hl1)
      // Check the short match.
      if idxs0 >= prefixLowestIndex && unsafe mem.r32(base, mem.z(idxs0)) == unsafe mem.r32(base, ip) {
        match_ = mem.z(idxs0)
        found = 3
        break
      }
      if ip1 >= nextStep {
        step = mem.ua(step, 1)
        nextStep = mem.ua(nextStep, kStepIncr)
      }
      ip = ip1
      ip1 = mem.ua(ip1, step)
      hl0 = hl1
      idxl0 = idxl1
      if ip1 > ilimit { break }
    }
    if found == 0 { break }
    if found == 3 {
      // `_search_next_long`: a short match was found; look for a long match at the next position.
      mLength = mem.ua(unsafe cstate.count(base, mem.ua(ip, 4), base, mem.ua(match_, 4), iend), 4)
      offset = mem.t32(mem.us(ip, match_))
      if idxl1 > prefixLowestIndex && unsafe mem.r64(base, mem.z(idxl1)) == unsafe mem.r64(base, ip1) {
        let l1len = mem.ua(unsafe cstate.count(base, mem.ua(ip1, 8), base, mem.z(idxl1) + 8, iend), 8)
        if l1len > mLength {
          // Use the long match instead.
          ip = ip1
          mLength = l1len
          offset = mem.t32(mem.us(ip, mem.z(idxl1)))
          match_ = mem.z(idxl1)
        }
      }
      // Catch up.
      while ip > anchor && match_ > prefixLowest && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(base, mem.us(match_, 1)) {
        ip = mem.us(ip, 1) match_ = mem.us(match_, 1) mLength = mem.ua(mLength, 1)
      }
    }
    if found != 1 {
      // `_match_found`.
      offset2 = offset1
      offset1 = offset
      if step < 4 {
        // Write the entry of the next position: it is already computed, and it helps the ratio
        // when the positions are close.
        unsafe cstate.tset(hashLong, hl1, mem.t32(ip1))
      }
      unsafe cstate.storeSeq(&mut seqStore, mem.us(ip, anchor), base, anchor, iend, cstate.offsetToOffBase(offset), mLength)
    }
    // `_match_stored`.
    ip = mem.ua(ip, mLength)
    anchor = ip
    if ip <= ilimit {
      // Complementary insertion; done after the repeat search in the reference too.
      let indexToInsert = mem.a32(curr, 2)
      unsafe cstate.tset(hashLong, unsafe cstate.hashPtr(base, mem.z(indexToInsert), hBitsL, 8), indexToInsert)
      unsafe cstate.tset(hashLong, unsafe cstate.hashPtr(base, mem.us(ip, 2), hBitsL, 8), mem.t32(mem.us(ip, 2)))
      unsafe cstate.tset(hashSmall, unsafe cstate.hashPtr(base, mem.z(indexToInsert), hBitsS, mls), indexToInsert)
      unsafe cstate.tset(hashSmall, unsafe cstate.hashPtr(base, mem.us(ip, 1), hBitsS, mls), mem.t32(mem.us(ip, 1)))
      // Check for immediate repeat codes.
      while ip <= ilimit && offset2 > 0 && unsafe mem.r32(base, ip) == unsafe mem.r32(base, mem.us(ip, mem.z(offset2))) {
        let rLength = mem.ua(unsafe cstate.count(base, mem.ua(ip, 4), base, mem.us(mem.ua(ip, 4), mem.z(offset2)), iend), 4)
        let tmpOff = offset2 offset2 = offset1 offset1 = tmpOff
        unsafe cstate.tset(hashSmall, unsafe cstate.hashPtr(base, ip, hBitsS, mls), mem.t32(ip))
        unsafe cstate.tset(hashLong, unsafe cstate.hashPtr(base, ip, hBitsL, 8), mem.t32(ip))
        unsafe cstate.storeSeq(&mut seqStore, 0, base, anchor, iend, cstate.REPCODE1, rLength)
        ip = mem.ua(ip, rLength)
        anchor = ip
      }
    }
  }
  // `_cleanup`: save the repeat offsets for the next block.
  if offsetSaved1 != 0 && offset1 != 0 { offsetSaved2 = offsetSaved1 }
  unsafe mem.w32(rep, 0, if offset1 != 0 { offset1 } else { offsetSaved1 })
  unsafe mem.w32(rep, 4, if offset2 != 0 { offset2 } else { offsetSaved2 })
  return mem.us(iend, anchor)
}

@inlineNever
unsafe fn dfastNoDict4(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastNoDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 4) }
@inlineNever
unsafe fn dfastNoDict5(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastNoDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 5) }
@inlineNever
unsafe fn dfastNoDict6(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastNoDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 6) }
@inlineNever
unsafe fn dfastNoDict7(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastNoDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 7) }

/// `ZSTD_compressBlock_doubleFast`: the block compressor of `dfast` without a dictionary.
pub unsafe fn compressBlockDoubleFast(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  let mls = ms.cParams.minMatch
  if mls == 5 { return unsafe dfastNoDict5(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mls == 6 { return unsafe dfastNoDict6(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mls == 7 { return unsafe dfastNoDict7(&mut ms, &mut seqStore, rep, src, srcSize) }
  return unsafe dfastNoDict4(&mut ms, &mut seqStore, rep, src, srcSize)
}

// `ZSTD_compressBlock_doubleFast_extDict_generic`.
@inlineAlways
unsafe fn dfastExtDictGeneric(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize, mls: u32) -> usize {
  let hashLong = ms.hashTable
  let hBitsL = ms.cParams.hashLog
  let hashSmall = ms.chainTable
  let hBitsS = ms.cParams.chainLog
  let base = ms.window.base
  let istart = mem.us(mem.addr(src), mem.addr(base))
  let mut ip = istart
  let mut anchor = istart
  let iend = mem.ua(istart, srcSize)
  let ilimit = mem.us(iend, 8)
  let endIndex = mem.t32(mem.ua(istart, srcSize))
  let lowLimit = cstate.getLowestMatchIndex(&ms, endIndex, ms.cParams.windowLog)
  let dictStartIndex = lowLimit
  let dictLimit = ms.window.dictLimit
  let prefixStartIndex = if dictLimit > lowLimit { dictLimit } else { lowLimit }
  let prefixStart = mem.z(prefixStartIndex)
  let dictBase = ms.window.dictBase
  let dictStart = mem.z(dictStartIndex)
  let dictEnd = mem.z(prefixStartIndex)
  let mut offset1 = unsafe mem.r32(unsafe mem.ro(rep), 0)
  let mut offset2 = unsafe mem.r32(unsafe mem.ro(rep), 4)
  // If the external dictionary is invalid, use the regular variant.
  if prefixStartIndex == dictStartIndex { return unsafe compressBlockDoubleFast(&mut ms, &mut seqStore, rep, src, srcSize) }
  // Search loop.
  while ip < ilimit {
    let hSmall = unsafe cstate.hashPtr(base, ip, hBitsS, mls)
    let matchIndex = unsafe cstate.tget(hashSmall, hSmall)
    let matchBase = if matchIndex < prefixStartIndex { dictBase } else { base }
    let mut match_ = mem.z(matchIndex)
    let hLong = unsafe cstate.hashPtr(base, ip, hBitsL, 8)
    let matchLongIndex = unsafe cstate.tget(hashLong, hLong)
    let matchLongBase = if matchLongIndex < prefixStartIndex { dictBase } else { base }
    let mut matchLong = mem.z(matchLongIndex)
    let curr = mem.t32(ip)
    let repIndex = mem.s32(mem.a32(curr, 1), offset1)
    let repBase = if repIndex < prefixStartIndex { dictBase } else { base }
    let mut mLength: usize = 0
    unsafe cstate.tset(hashSmall, hSmall, curr)
    unsafe cstate.tset(hashLong, hLong, curr)
    if cstate.indexOverlapCheck(prefixStartIndex, repIndex) && offset1 <= mem.s32(mem.a32(curr, 1), dictStartIndex)
      && unsafe mem.r32(repBase, mem.z(repIndex)) == unsafe mem.r32(base, mem.ua(ip, 1)) {
      let repMatchEnd = if repIndex < prefixStartIndex { dictEnd } else { iend }
      mLength = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip, 5), iend, repBase, mem.z(repIndex) + 4, repMatchEnd, prefixStart), 4)
      ip = mem.ua(ip, 1)
      unsafe cstate.storeSeq(&mut seqStore, mem.us(ip, anchor), base, anchor, iend, cstate.REPCODE1, mLength)
    } else if matchLongIndex > dictStartIndex && unsafe mem.r64(matchLongBase, matchLong) == unsafe mem.r64(base, ip) {
      let matchEnd = if matchLongIndex < prefixStartIndex { dictEnd } else { iend }
      let lowMatchPtr = if matchLongIndex < prefixStartIndex { dictStart } else { prefixStart }
      mLength = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip, 8), iend, matchLongBase, mem.ua(matchLong, 8), matchEnd, prefixStart), 8)
      let offset = mem.s32(curr, matchLongIndex)
      // Catch up.
      while ip > anchor && matchLong > lowMatchPtr && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(matchLongBase, mem.us(matchLong, 1)) {
        ip = mem.us(ip, 1) matchLong = mem.us(matchLong, 1) mLength = mem.ua(mLength, 1)
      }
      offset2 = offset1
      offset1 = offset
      unsafe cstate.storeSeq(&mut seqStore, mem.us(ip, anchor), base, anchor, iend, cstate.offsetToOffBase(offset), mLength)
    } else if matchIndex > dictStartIndex && unsafe mem.r32(matchBase, match_) == unsafe mem.r32(base, ip) {
      let h3 = unsafe cstate.hashPtr(base, mem.ua(ip, 1), hBitsL, 8)
      let matchIndex3 = unsafe cstate.tget(hashLong, h3)
      let match3Base = if matchIndex3 < prefixStartIndex { dictBase } else { base }
      let mut match3 = mem.z(matchIndex3)
      let mut offset: u32 = 0
      unsafe cstate.tset(hashLong, h3, mem.a32(curr, 1))
      if matchIndex3 > dictStartIndex && unsafe mem.r64(match3Base, match3) == unsafe mem.r64(base, mem.ua(ip, 1)) {
        let matchEnd = if matchIndex3 < prefixStartIndex { dictEnd } else { iend }
        let lowMatchPtr = if matchIndex3 < prefixStartIndex { dictStart } else { prefixStart }
        mLength = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip, 9), iend, match3Base, mem.ua(match3, 8), matchEnd, prefixStart), 8)
        ip = mem.ua(ip, 1)
        offset = mem.s32(mem.a32(curr, 1), matchIndex3)
        // Catch up.
        while ip > anchor && match3 > lowMatchPtr && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(match3Base, mem.us(match3, 1)) {
          ip = mem.us(ip, 1) match3 = mem.us(match3, 1) mLength = mem.ua(mLength, 1)
        }
      } else {
        let matchEnd = if matchIndex < prefixStartIndex { dictEnd } else { iend }
        let lowMatchPtr = if matchIndex < prefixStartIndex { dictStart } else { prefixStart }
        mLength = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip, 4), iend, matchBase, mem.ua(match_, 4), matchEnd, prefixStart), 4)
        offset = mem.s32(curr, matchIndex)
        // Catch up.
        while ip > anchor && match_ > lowMatchPtr && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(matchBase, mem.us(match_, 1)) {
          ip = mem.us(ip, 1) match_ = mem.us(match_, 1) mLength = mem.ua(mLength, 1)
        }
      }
      offset2 = offset1
      offset1 = offset
      unsafe cstate.storeSeq(&mut seqStore, mem.us(ip, anchor), base, anchor, iend, cstate.offsetToOffBase(offset), mLength)
    } else {
      ip = mem.ua(ip, mem.ua(usize.shiftRight(mem.us(ip, anchor), 8), 1))
      continue
    }
    // Move to the next sequence start.
    ip = mem.ua(ip, mLength)
    anchor = ip
    if ip <= ilimit {
      // Complementary insertion; done after the repeat search in the reference too.
      let indexToInsert = mem.a32(curr, 2)
      unsafe cstate.tset(hashLong, unsafe cstate.hashPtr(base, mem.z(indexToInsert), hBitsL, 8), indexToInsert)
      unsafe cstate.tset(hashLong, unsafe cstate.hashPtr(base, mem.us(ip, 2), hBitsL, 8), mem.t32(mem.us(ip, 2)))
      unsafe cstate.tset(hashSmall, unsafe cstate.hashPtr(base, mem.z(indexToInsert), hBitsS, mls), indexToInsert)
      unsafe cstate.tset(hashSmall, unsafe cstate.hashPtr(base, mem.us(ip, 1), hBitsS, mls), mem.t32(mem.us(ip, 1)))
      // Check for immediate repeat codes.
      while ip <= ilimit {
        let current2 = mem.t32(ip)
        let repIndex2 = mem.s32(current2, offset2)
        let repBase2 = if repIndex2 < prefixStartIndex { dictBase } else { base }
        if cstate.indexOverlapCheck(prefixStartIndex, repIndex2) && offset2 <= mem.s32(current2, dictStartIndex)
          && unsafe mem.r32(repBase2, mem.z(repIndex2)) == unsafe mem.r32(base, ip) {
          let repEnd2 = if repIndex2 < prefixStartIndex { dictEnd } else { iend }
          let repLength2 = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip, 4), iend, repBase2, mem.z(repIndex2) + 4, repEnd2, prefixStart), 4)
          let tmpOffset = offset2 offset2 = offset1 offset1 = tmpOffset
          unsafe cstate.storeSeq(&mut seqStore, 0, base, anchor, iend, cstate.REPCODE1, repLength2)
          unsafe cstate.tset(hashSmall, unsafe cstate.hashPtr(base, ip, hBitsS, mls), current2)
          unsafe cstate.tset(hashLong, unsafe cstate.hashPtr(base, ip, hBitsL, 8), current2)
          ip = mem.ua(ip, repLength2)
          anchor = ip
        } else {
          break
        }
      }
    }
  }
  // Save the repeat offsets for the next block.
  unsafe mem.w32(rep, 0, offset1)
  unsafe mem.w32(rep, 4, offset2)
  return mem.us(iend, anchor)
}

@inlineNever
unsafe fn dfastExtDict4(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastExtDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 4) }
@inlineNever
unsafe fn dfastExtDict5(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastExtDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 5) }
@inlineNever
unsafe fn dfastExtDict6(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastExtDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 6) }
@inlineNever
unsafe fn dfastExtDict7(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastExtDictGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 7) }

/// `ZSTD_compressBlock_doubleFast_extDict`: the block compressor of `dfast` when the window has
/// an external segment.
pub unsafe fn compressBlockDoubleFastExtDict(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  let mls = ms.cParams.minMatch
  if mls == 5 { return unsafe dfastExtDict5(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mls == 6 { return unsafe dfastExtDict6(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mls == 7 { return unsafe dfastExtDict7(&mut ms, &mut seqStore, rep, src, srcSize) }
  return unsafe dfastExtDict4(&mut ms, &mut seqStore, rep, src, srcSize)
}

// ---- `dictMatchState` (`ZSTD_compressBlock_doubleFast_dictMatchState`): an attached CDict,
// whose two tables have short cache tags (`cdict.silk`). ----

@inlineAlways
fn tagsMatch(packed: u32, hashAndTag: usize) -> bool { return (packed & 255) == (mem.t32(hashAndTag) & 255) }

// `ZSTD_compressBlock_doubleFast_dictMatchState_generic`.
@inlineAlways
unsafe fn dfastDmsGeneric(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize, mls: u32) -> usize {
  let hashLong = ms.hashTable
  let hBitsL = ms.cParams.hashLog
  let hashSmall = ms.chainTable
  let hBitsS = ms.cParams.chainLog
  let base = ms.window.base
  let istart = mem.us(mem.addr(src), mem.addr(base))
  let mut ip = istart
  let mut anchor = istart
  let endIndex = mem.t32(mem.ua(istart, srcSize))
  // An attached dictionary implies the attach mode.
  let prefixLowestIndex = cstate.getLowestPrefixIndex(&ms, endIndex, ms.cParams.windowLog)
  let prefixLowest = mem.z(prefixLowestIndex)
  let iend = mem.ua(istart, srcSize)
  let ilimit = mem.us(iend, cstate.HASH_READ_SIZE)
  let mut offset1 = unsafe mem.r32(unsafe mem.ro(rep), 0)
  let mut offset2 = unsafe mem.r32(unsafe mem.ro(rep), 4)
  let d = unsafe zfast.dmsView(&ms)
  let dictHashLong = d.hashTable
  let dictHashSmall = d.chainTable
  let dictStartIndex = d.startIndex
  let dictBase = d.base
  let dictStart = mem.z(dictStartIndex)
  let dictEnd = d.endIndex
  let dictIndexDelta = mem.s32(prefixLowestIndex, mem.t32(dictEnd))
  let dictHBitsL = d.hashLog + 8
  let dictHBitsS = d.chainLog + 8
  let dictAndPrefixLength = mem.t32(mem.ua(mem.us(ip, prefixLowest), mem.us(dictEnd, dictStart)))
  if dictAndPrefixLength == 0 { ip = mem.ua(ip, 1) }
  // Main search loop: `<` and not `<=`, because of the repeat check at ip + 1.
  while ip < ilimit {
    let mut mLength: usize = 0
    let mut offset: u32 = 0
    let h2 = unsafe cstate.hashPtr(base, ip, hBitsL, 8)
    let h = unsafe cstate.hashPtr(base, ip, hBitsS, mls)
    let dictHashAndTagL = unsafe cstate.hashPtr(base, ip, dictHBitsL, 8)
    let dictHashAndTagS = unsafe cstate.hashPtr(base, ip, dictHBitsS, mls)
    let dictMatchIndexAndTagL = unsafe cstate.tget(dictHashLong, usize.shiftRight(dictHashAndTagL, 8))
    let dictMatchIndexAndTagS = unsafe cstate.tget(dictHashSmall, usize.shiftRight(dictHashAndTagS, 8))
    let dictTagsMatchL = tagsMatch(dictMatchIndexAndTagL, dictHashAndTagL)
    let dictTagsMatchS = tagsMatch(dictMatchIndexAndTagS, dictHashAndTagS)
    let curr = mem.t32(ip)
    let matchIndexL = unsafe cstate.tget(hashLong, h2)
    let mut matchIndexS = unsafe cstate.tget(hashSmall, h)
    let mut matchLong = mem.z(matchIndexL)
    // The short match, in `matchBase` (the prefix or the dictionary).
    let mut match_ = mem.z(matchIndexS)
    let mut matchBase = base
    let repIndex = mem.s32(mem.a32(curr, 1), offset1)
    let repInDict = repIndex < prefixLowestIndex
    let repBase = if repInDict { dictBase } else { base }
    let repPos = if repInDict { mem.z(mem.s32(repIndex, dictIndexDelta)) } else { mem.z(repIndex) }
    // Update the hash tables.
    unsafe cstate.tset(hashLong, h2, curr)
    unsafe cstate.tset(hashSmall, h, curr)
    // 0: nothing; 1: repeat match, stored; 2: `_match_found`; 3: `_search_next_long`.
    let mut found: u32 = 0
    if cstate.indexOverlapCheck(prefixLowestIndex, repIndex) && unsafe mem.r32(repBase, repPos) == unsafe mem.r32(base, mem.ua(ip, 1)) {
      let repMatchEnd = if repInDict { dictEnd } else { iend }
      mLength = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip, 5), iend, repBase, mem.ua(repPos, 4), repMatchEnd, prefixLowest), 4)
      ip = mem.ua(ip, 1)
      unsafe cstate.storeSeq(&mut seqStore, mem.us(ip, anchor), base, anchor, iend, cstate.REPCODE1, mLength)
      found = 1
    }
    if found == 0 {
      if matchIndexL >= prefixLowestIndex && unsafe mem.r64(base, matchLong) == unsafe mem.r64(base, ip) {
        // A long match in the prefix.
        mLength = mem.ua(unsafe cstate.count(base, mem.ua(ip, 8), base, mem.ua(matchLong, 8), iend), 8)
        offset = mem.t32(mem.us(ip, matchLong))
        while ip > anchor && matchLong > prefixLowest && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(base, mem.us(matchLong, 1)) {
          ip = mem.us(ip, 1) matchLong = mem.us(matchLong, 1) mLength = mem.ua(mLength, 1)
        }
        found = 2
      } else if dictTagsMatchL {
        // A long match in the dictionary.
        let dictMatchIndexL = mem.shr32(dictMatchIndexAndTagL, 8)
        let mut dictMatchL = mem.z(dictMatchIndexL)
        if dictMatchL > dictStart && unsafe mem.r64(dictBase, dictMatchL) == unsafe mem.r64(base, ip) {
          mLength = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip, 8), iend, dictBase, mem.ua(dictMatchL, 8), dictEnd, prefixLowest), 8)
          offset = mem.s32(mem.s32(curr, dictMatchIndexL), dictIndexDelta)
          while ip > anchor && dictMatchL > dictStart && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(dictBase, mem.us(dictMatchL, 1)) {
            ip = mem.us(ip, 1) dictMatchL = mem.us(dictMatchL, 1) mLength = mem.ua(mLength, 1)
          }
          found = 2
        }
      }
    }
    if found == 0 {
      if matchIndexS > prefixLowestIndex {
        // A short match candidate.
        if unsafe mem.r32(base, match_) == unsafe mem.r32(base, ip) { found = 3 }
      } else if dictTagsMatchS {
        // A short match in the dictionary.
        let dictMatchIndexS = mem.shr32(dictMatchIndexAndTagS, 8)
        match_ = mem.z(dictMatchIndexS)
        matchBase = dictBase
        matchIndexS = mem.a32(dictMatchIndexS, dictIndexDelta)
        if match_ > dictStart && unsafe mem.r32(dictBase, match_) == unsafe mem.r32(base, ip) { found = 3 }
      }
    }
    if found == 0 {
      ip = mem.ua(ip, mem.ua(usize.shiftRight(mem.us(ip, anchor), 8), 1))
      continue
    }
    if found == 3 {
      // `_search_next_long`.
      let hl3 = unsafe cstate.hashPtr(base, mem.ua(ip, 1), hBitsL, 8)
      let dictHashAndTagL3 = unsafe cstate.hashPtr(base, mem.ua(ip, 1), dictHBitsL, 8)
      let matchIndexL3 = unsafe cstate.tget(hashLong, hl3)
      let dictMatchIndexAndTagL3 = unsafe cstate.tget(dictHashLong, usize.shiftRight(dictHashAndTagL3, 8))
      let dictTagsMatchL3 = tagsMatch(dictMatchIndexAndTagL3, dictHashAndTagL3)
      let mut matchL3 = mem.z(matchIndexL3)
      unsafe cstate.tset(hashLong, hl3, mem.a32(curr, 1))
      if matchIndexL3 >= prefixLowestIndex && unsafe mem.r64(base, matchL3) == unsafe mem.r64(base, mem.ua(ip, 1)) {
        // A long match at ip + 1, in the prefix.
        mLength = mem.ua(unsafe cstate.count(base, mem.ua(ip, 9), base, mem.ua(matchL3, 8), iend), 8)
        ip = mem.ua(ip, 1)
        offset = mem.t32(mem.us(ip, matchL3))
        while ip > anchor && matchL3 > prefixLowest && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(base, mem.us(matchL3, 1)) {
          ip = mem.us(ip, 1) matchL3 = mem.us(matchL3, 1) mLength = mem.ua(mLength, 1)
        }
        found = 2
      } else if dictTagsMatchL3 {
        // A long match at ip + 1, in the dictionary.
        let dictMatchIndexL3 = mem.shr32(dictMatchIndexAndTagL3, 8)
        let mut dictMatchL3 = mem.z(dictMatchIndexL3)
        if dictMatchL3 > dictStart && unsafe mem.r64(dictBase, dictMatchL3) == unsafe mem.r64(base, mem.ua(ip, 1)) {
          mLength = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip, 9), iend, dictBase, mem.ua(dictMatchL3, 8), dictEnd, prefixLowest), 8)
          ip = mem.ua(ip, 1)
          offset = mem.s32(mem.s32(mem.a32(curr, 1), dictMatchIndexL3), dictIndexDelta)
          while ip > anchor && dictMatchL3 > dictStart && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(dictBase, mem.us(dictMatchL3, 1)) {
            ip = mem.us(ip, 1) dictMatchL3 = mem.us(dictMatchL3, 1) mLength = mem.ua(mLength, 1)
          }
          found = 2
        }
      }
      if found == 3 {
        // No long match at ip + 1: take the short match.
        if matchIndexS < prefixLowestIndex {
          mLength = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip, 4), iend, matchBase, mem.ua(match_, 4), dictEnd, prefixLowest), 4)
          offset = mem.s32(curr, matchIndexS)
          while ip > anchor && match_ > dictStart && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(matchBase, mem.us(match_, 1)) {
            ip = mem.us(ip, 1) match_ = mem.us(match_, 1) mLength = mem.ua(mLength, 1)
          }
        } else {
          mLength = mem.ua(unsafe cstate.count(base, mem.ua(ip, 4), base, mem.ua(match_, 4), iend), 4)
          offset = mem.t32(mem.us(ip, match_))
          while ip > anchor && match_ > prefixLowest && unsafe mem.r8(base, mem.us(ip, 1)) == unsafe mem.r8(base, mem.us(match_, 1)) {
            ip = mem.us(ip, 1) match_ = mem.us(match_, 1) mLength = mem.ua(mLength, 1)
          }
        }
      }
    }
    if found != 1 {
      // `_match_found`.
      offset2 = offset1
      offset1 = offset
      unsafe cstate.storeSeq(&mut seqStore, mem.us(ip, anchor), base, anchor, iend, cstate.offsetToOffBase(offset), mLength)
    }
    // `_match_stored`.
    ip = mem.ua(ip, mLength)
    anchor = ip
    if ip <= ilimit {
      // Complementary insertion, after the limit test: the candidates can be after iend - 8.
      let indexToInsert = mem.a32(curr, 2)
      unsafe cstate.tset(hashLong, unsafe cstate.hashPtr(base, mem.z(indexToInsert), hBitsL, 8), indexToInsert)
      unsafe cstate.tset(hashLong, unsafe cstate.hashPtr(base, mem.us(ip, 2), hBitsL, 8), mem.t32(mem.us(ip, 2)))
      unsafe cstate.tset(hashSmall, unsafe cstate.hashPtr(base, mem.z(indexToInsert), hBitsS, mls), indexToInsert)
      unsafe cstate.tset(hashSmall, unsafe cstate.hashPtr(base, mem.us(ip, 1), hBitsS, mls), mem.t32(mem.us(ip, 1)))
      // Check for immediate repeat codes.
      while ip <= ilimit {
        let current2 = mem.t32(ip)
        let repIndex2 = mem.s32(current2, offset2)
        let inDict2 = repIndex2 < prefixLowestIndex
        let repBase2 = if inDict2 { dictBase } else { base }
        let repPos2 = if inDict2 { mem.z(mem.s32(repIndex2, dictIndexDelta)) } else { mem.z(repIndex2) }
        if cstate.indexOverlapCheck(prefixLowestIndex, repIndex2) && unsafe mem.r32(repBase2, repPos2) == unsafe mem.r32(base, ip) {
          let repEnd2 = if inDict2 { dictEnd } else { iend }
          let repLength2 = mem.ua(unsafe cstate.count2segments(base, mem.ua(ip, 4), iend, repBase2, mem.ua(repPos2, 4), repEnd2, prefixLowest), 4)
          let tmpOffset = offset2 offset2 = offset1 offset1 = tmpOffset
          unsafe cstate.storeSeq(&mut seqStore, 0, base, anchor, iend, cstate.REPCODE1, repLength2)
          unsafe cstate.tset(hashSmall, unsafe cstate.hashPtr(base, ip, hBitsS, mls), current2)
          unsafe cstate.tset(hashLong, unsafe cstate.hashPtr(base, ip, hBitsL, 8), current2)
          ip = mem.ua(ip, repLength2)
          anchor = ip
          continue
        }
        break
      }
    }
  }
  // Save the repeat offsets for the next block.
  unsafe mem.w32(rep, 0, offset1)
  unsafe mem.w32(rep, 4, offset2)
  return mem.us(iend, anchor)
}

@inlineNever
unsafe fn dfastDms4(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 4) }
@inlineNever
unsafe fn dfastDms5(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 5) }
@inlineNever
unsafe fn dfastDms6(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 6) }
@inlineNever
unsafe fn dfastDms7(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize { return unsafe dfastDmsGeneric(&mut ms, &mut seqStore, rep, src, srcSize, 7) }

/// `ZSTD_compressBlock_doubleFast_dictMatchState`: the block compressor of `dfast` with an
/// attached dictionary.
pub unsafe fn compressBlockDoubleFastDictMatchState(ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  let mls = ms.cParams.minMatch
  if mls == 5 { return unsafe dfastDms5(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mls == 6 { return unsafe dfastDms6(&mut ms, &mut seqStore, rep, src, srcSize) }
  if mls == 7 { return unsafe dfastDms7(&mut ms, &mut seqStore, rep, src, srcSize) }
  return unsafe dfastDms4(&mut ms, &mut seqStore, rep, src, srcSize)
}
