//! Post-stop CDP CPU profile encoding of the recorder's calling-context tree;
//! root is the only unconditional synthetic node. State nodes require an actual
//! native/idle/GC/program sample. JSON owns its bytes independently of the native profile.
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u16
import silk.num.u64
import silk.num.usize
import silk.num.i32
import byte_buffer { ByteBuffer }
import js_value_print_text as text
import js_cpu_profile { Profile, Frame }
import js_cpu_profile as cpu
import silk.collections.slice { Slice }
import js_heap { HeapCell, HeapHeader }
import js_core_types { RuntimeState }

const NONE: usize = usize.MAX
effect fn quoted(out: &mut ByteBuffer, units: &[u16]) -> () ! OutOfMemoryError ? &mut Allocator {
  run out.append(34) let mut i: usize = 0 let digits = b"0123456789abcdef"
  while i < units.length {
    let unit = units[i]
    if unit >= 32 && unit < 127 && unit != 34 && unit != 92 { run out.append(u16.toU8(unit)) }
    else {
      run out.appendSlice(b"\\u")
      run out.append(digits[u16.toUsize(u16.shiftRight(unit, 12) & 15)])
      run out.append(digits[u16.toUsize(u16.shiftRight(unit, 8) & 15)])
      run out.append(digits[u16.toUsize(u16.shiftRight(unit, 4) & 15)])
      run out.append(digits[u16.toUsize(unit & 15)])
    }
    i = i + 1
  }
  run out.append(34)
}
effect fn callFrame(out: &mut ByteBuffer, profile: &Profile, frame: Frame, root: bool) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run out.appendSlice(b"{\"functionName\":")
  let functions = profile.functions()
  if root { run out.appendSlice(b"\"(root)\"") }
  else if frame.kind == cpu.NATIVE { run out.appendSlice(b"\"(native)\"") }
  else if frame.kind == cpu.IDLE { run out.appendSlice(b"\"(idle)\"") }
  else if frame.kind == cpu.GC { run out.appendSlice(b"\"(garbage collector)\"") }
  else if frame.kind == cpu.PROGRAM { run out.appendSlice(b"\"(program)\"") }
  else if frame.functionIndex < functions.length { run quoted(&mut out, functions[frame.functionIndex].name()) }
  else { run out.appendSlice(b"\"\"") }
  run out.appendSlice(b",\"scriptId\":\"") run text.unsigned(&mut out, frame.scriptId)
  run out.appendSlice(b"\",\"url\":")
  if frame.functionIndex < functions.length { run quoted(&mut out, functions[frame.functionIndex].url()) }
  else { run out.appendSlice(b"\"\"") }
  run out.appendSlice(b",\"lineNumber\":") run text.signed(&mut out, i32.toI64(frame.line))
  run out.appendSlice(b",\"columnNumber\":") run text.signed(&mut out, i32.toI64(frame.column))
  run out.append(125)
}
pub effect fn encode(profile: &Profile) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  return run encodeRange(profile, 0, profile.startMicroseconds(), profile.endMicroseconds())
}
/// Stops a shared profile (cpu.startShared) and encodes the samples observed while
/// it was open; None when it is not open.
pub unsafe effect fn stopShared(runtime: *mut HeapHeader, id: u64) -> Option<List<u8>> ! OutOfMemoryError ? &mut Allocator {
  let since = match unsafe cpu.closeShared(runtime, id) { Option<i64>.Some { value } => value _ => { return Option<List<u8>>.none() } }
  if unsafe cpu.sharedOpen(runtime) == 0 {
    let profile = match run unsafe cpu.finishShared(runtime) { Option<Profile>.Some { value } => move value _ => { return Option<List<u8>>.none() } }
    let start = if since > profile.startMicroseconds() { since } else { profile.startMicroseconds() }
    return Option<List<u8>>.some(run encodeRange(&profile, cpu.firstSampleSince(&profile, since), start, profile.endMicroseconds()))
  }
  let end = run cpu.nowMicroseconds()
  let anchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let profile = state.cpuProfile.live()
  let start = if since > profile.startMicroseconds() { since } else { profile.startMicroseconds() }
  return Option<List<u8>>.some(run encodeRange(profile, cpu.firstSampleSince(profile, since), start, end))
}
/// The samples from index `first` on, as a profile from `start` to `end`.
pub effect fn encodeRange(profile: &Profile, first: usize, start: i64, end: i64) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let samples = Slice.view<cpu.Sample>(profile.samples(), first, profile.samples().length - first) let nodes = profile.nodes()
  // The recorder's tree as it is: a parent precedes its children, so one pass
  // from the end links each node in front of its later siblings.
  let mut firstChild = List<usize>.make() let mut nextSibling = List<usize>.make() let mut hits = List<u64>.make()
  run firstChild.reserveExact(nodes.length) run nextSibling.reserveExact(nodes.length) run hits.reserveExact(nodes.length)
  let mut i: usize = 0
  while i < nodes.length { run firstChild.append(NONE) run nextSibling.append(NONE) run hits.append(0) i = i + 1 }
  i = nodes.length
  while i > 1 {
    i = i - 1 let parent = nodes[i].parent
    let sibling = firstChild.get(parent) nextSibling.set(i, sibling) firstChild.set(parent, i)
  }
  i = 0 let mut truncated = false
  while i < samples.length {
    let sample = samples[i]
    if sample.truncatedStack { truncated = true }
    let count = hits.get(sample.node) hits.set(sample.node, count + 1) i = i + 1
  }
  i = 0
  while i < nodes.length {
    if nodes[i].frame.kind == cpu.JAVASCRIPT && nodes[i].frame.functionIndex == cpu.NO_FUNCTION && i != 0 { truncated = true }
    i = i + 1
  }
  let functions = profile.functions() i = 0
  while i < functions.length { if functions[i].nameTruncated() || functions[i].urlTruncated() { truncated = true } i = i + 1 }
  let mut out = ByteBuffer.make() run out.appendSlice(b"{\"nodes\":[") i = 0
  while i < nodes.length {
    if i != 0 { run out.append(44) }
    let node = nodes[i]
    run out.appendSlice(b"{\"id\":") run text.unsigned(&mut out, usize.toU64(i + 1))
    run out.appendSlice(b",\"callFrame\":") run callFrame(&mut out, &profile, node.frame, i == 0)
    run out.appendSlice(b",\"hitCount\":") run text.unsigned(&mut out, hits.get(i))
    run out.appendSlice(b",\"children\":[") let mut child = firstChild.get(i) let mut first = true
    while child != NONE {
      if !first { run out.append(44) } first = false
      run text.unsigned(&mut out, usize.toU64(child + 1)) child = nextSibling.get(child)
    }
    run out.appendSlice(b"],\"silk\":{\"functionAddress\":\"") run text.unsigned(&mut out, usize.toU64(node.frame.functionAddress))
    run out.appendSlice(b"\",\"pc\":")
    match node.frame.pc {
      Option<usize>.Some { value } => { run text.unsigned(&mut out, usize.toU64(value)) }
      Option<usize>.None => { run out.appendSlice(b"null") }
    }
    run out.appendSlice(b",\"pcIsReturnAddress\":")
    if node.frame.pcIsReturnAddress { run out.appendSlice(b"true") } else { run out.appendSlice(b"false") }
    run out.appendSlice(b"}}") i = i + 1
  }
  run out.appendSlice(b"],\"startTime\":") run text.signed(&mut out, start)
  run out.appendSlice(b",\"endTime\":") run text.signed(&mut out, end)
  run out.appendSlice(b",\"samples\":[") i = 0
  while i < samples.length { if i != 0 { run out.append(44) } run text.unsigned(&mut out, usize.toU64(samples[i].node + 1)) i = i + 1 }
  run out.appendSlice(b"],\"timeDeltas\":[") i = 0 let mut previous = start
  while i < samples.length {
    if i != 0 { run out.append(44) }
    run text.signed(&mut out, samples[i].timestampMicroseconds - previous)
    previous = samples[i].timestampMicroseconds i = i + 1
  }
  run out.appendSlice(b"],\"silk\":{\"safepointBias\":true,\"droppedObservations\":")
  run text.unsigned(&mut out, profile.droppedObservations())
  run out.appendSlice(b",\"truncated\":")
  if truncated { run out.appendSlice(b"true") } else { run out.appendSlice(b"false") }
  run out.appendSlice(b",\"intervalMicroseconds\":") run text.signed(&mut out, profile.intervalMicroseconds())
  run out.appendSlice(b"}}")
  return out.intoList()
}
