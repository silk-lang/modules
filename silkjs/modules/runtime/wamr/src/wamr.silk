//! WebAssembly and WASI over WAMR: the runtime's real `Wasm` capability.
//!
//! A program that provides `WamrWasm` depends on this package, and so compiles WAMR and SIMDe
//! (`silkjs-wamr`); a program that provides `EmptyWasm` does neither.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjs.js_gc { Tracer }
import silkjs.js_runtime_registry { ClassIdAllocator }
import silkjsruntime.ext.diagnostics_fatal { RuntimeHeap }
import silkjsruntime.libs.core.capabilities { Wasm, Composition }
import silkjsruntime.libs.core.host { Services }
import ext.wasm_native
import ext.wasi_native
import ext.wasm_ownership

/// WAMR's interpreter behind `WebAssembly`, and `node:wasi` over it.
pub struct WamrWasm {
  wasm: ?*mut wasm_native.State,
  wasi: ?*mut wasi_native.State,
}
impl Copy for WamrWasm {}

impl WamrWasm {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> WamrWasm {
    return WamrWasm { wasm: Pointer.null<wasm_native.State>(), wasi: Pointer.null<wasi_native.State>() }
  }
  unsafe fn wasmState(self: &Self) -> *mut wasm_native.State {
    if Pointer.isNull<wasm_native.State>(self.wasm) { Intrinsic.trap("WebAssembly provider is not initialized") }
    return unsafe Intrinsic.pointerRequalify<?*mut wasm_native.State, *mut wasm_native.State>(self.wasm)
  }
  unsafe fn wasiState(self: &Self) -> *mut wasi_native.State {
    if Pointer.isNull<wasi_native.State>(self.wasi) { Intrinsic.trap("WASI provider is not initialized") }
    return unsafe Intrinsic.pointerRequalify<?*mut wasi_native.State, *mut wasi_native.State>(self.wasi)
  }
}

impl Wasm for WamrWasm {
  static fn present() -> bool { return true }
  fn forWorker(self: &Self) -> Self { return WamrWasm.make() }
  effect fn open(self: &mut Self, allocator: *mut RuntimeHeap) -> () ! OutOfMemoryError {
    // The C entry points WAMR calls back are emitted only when something takes them.
    wasm_native.keepExports()
    wasm_ownership.keepExports()
    self.wasm = run wasm_native.open(allocator)
    self.wasi = run wasi_native.open(allocator)
  }
  unsafe effect fn install(self: &Self, rt: *mut HeapHeader, namespace: &ClassIdAllocator) -> () ! OutOfMemoryError ? &mut Allocator {
    run unsafe wasm_native.install(unsafe self.wasmState(), rt, namespace)
  }
  unsafe fn adoptClasses(self: &Self, rt: *mut HeapHeader, ids: [u32; 2]) -> () { unsafe wasm_native.adoptClasses(unsafe self.wasmState(), rt, ids) }
  unsafe fn classIds(self: &Self) -> [u32; 2] { return unsafe wasm_native.classIds(unsafe self.wasmState()) }
  unsafe fn ready(self: &Self) -> bool {
    return match Pointer.nonNullMut<wasm_native.State>(self.wasm) {
      Option<*mut wasm_native.State>.Some { value } => unsafe wasm_native.ready(value)
      Option<*mut wasm_native.State>.None => false
    }
  }
  unsafe effect fn poll<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe wasm_native.poll(&mut engine, context, unsafe self.wasmState())
  }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if id == 10000 { return run unsafe wasi_native.dispatch(&mut engine, context, unsafe self.wasiState(), id, argc, argv) }
    return run unsafe wasm_native.dispatch(&mut engine, context, unsafe self.wasmState(), argc, argv)
  }
  unsafe effect fn callData<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots, captured: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if id == 9001 { return run unsafe wasm_native.callExport(&mut engine, context, unsafe self.wasmState(), argc, argv, captured) }
    return run unsafe wasm_native.settleImport(&mut engine, context, unsafe self.wasmState(), argc, argv, captured)
  }
  unsafe effect fn rejectMutation<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> bool ! JsException ? &mut Allocator {
    return run unsafe wasm_native.rejectGcMutation(&mut engine, context)
  }
  unsafe fn trace(self: &Self, rt: *mut HeapHeader, object: *mut HeapHeader, tracer: &mut Tracer) -> () { unsafe wasm_native.mark(rt, object, &mut tracer) }
  unsafe fn finalize<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
    unsafe wasm_native.finalize(&mut engine, rt, object)
  }
  unsafe fn openHandles(self: &Self) -> usize {
    return match Pointer.nonNullMut<wasi_native.State>(self.wasi) {
      Option<*mut wasi_native.State>.Some { value } => unsafe wasi_native.openHandles(value)
      Option<*mut wasi_native.State>.None => 0
    }
  }
  unsafe fn closeWasi<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> () {
    if let Option<*mut wasi_native.State>.Some { value } = Pointer.nonNullMut<wasi_native.State>(self.wasi) {
      unsafe wasi_native.close(&mut engine, context, value)
      self.wasi = Pointer.null<wasi_native.State>()
    }
  }
  unsafe fn close<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> () {
    if let Option<*mut wasm_native.State>.Some { value } = Pointer.nonNullMut<wasm_native.State>(self.wasm) {
      unsafe wasm_native.close(&mut engine, context, value)
      self.wasm = Pointer.null<wasm_native.State>()
    }
  }
}
