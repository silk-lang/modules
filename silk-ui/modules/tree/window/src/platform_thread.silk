/// The accessibility side of the link, held by the window host's `HostState`.
pub struct AccessLink {
  link: Arc<Mutex<Link>>,
  waker: Waker,
}

impl AccessLink {
  /// Sends `update` for `window`'s accessibility tree to the platform thread. Its values must
  /// use the system allocator.
  pub effect fn publish(self: &Self, window: WindowId, update: TreeUpdate) -> ()
    ! OutOfMemoryError {
    let mut heap = Allocator.systemAllocatorProvider()
    let mut guard = self.link.get().lock()
    run guard.getMut().commands.append(
      Command.Accessibility { window: window, update: move update },
    )
      |> Effect.provideMut<Allocator>(&mut heap)
    drop guard
    self.waker.wake()
  }

  /// Whether assistive technology asked for `window`'s elements.
  pub fn wanted(self: &Self, window: WindowId) -> bool {
    let guard = self.link.get().lock()
    let windows = guard.get().accessWanted.asSlice()
    let mut i: usize = 0
    while i < windows.length {
      if windows[i] == window.value {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// The actions the OS asked for on `window` since the last call.
  pub effect fn take(self: &Self, window: WindowId) -> List<ActionRequest>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut taken = List<ActionRequest>.make()
    let mut guard = self.link.get().lock()
    let actions = &mut guard.getMut().actions
    let mut i: usize = 0
    while i < actions.length() {
      if actions.asSlice()[i].window == window.value {
        let action = actions.remove(i)
        run taken.append(move action.request)
      } else {
        i = i + 1
      }
    }
    return move taken
  }
}
