//! What each flavor says as keys move through a small page: a navigation list of links, a
//! main landmark with headings, a paragraph with an inline link, a form, a table and a live
//! region.
import accesskit.lib { ActionRequest, Node, NodeId, Role, Action, TreeInfo, TreeUpdate, Toggled, Live, Rect }
import reader { Reader, Utterance }
import flavor { Flavor, keyLabel, MOD_CONTROL, MOD_ALT, MOD_SHIFT, MOD_META }
import command { Command, Kind }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.num.f64
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }
import silk.io.writer_native { StderrWriter }

effect fn box(kind: Role, children: &[u64]) -> Node
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut node = Node.make(kind)
  let mut i: usize = 0
  while i < children.length {
    run node.pushChild(NodeId.of(children[i]))
    i = i + 1
  }
  return move node
}

/// Static text on row `row` of the page, `x` points from the left.
effect fn text(value: string, row: usize, x: f64) -> Node
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut node = Node.make(Role.Label)
  run node.setValue(value)
  let top = usize.toF64(row) * 20.0
  run node.setBounds(Rect.make(x, top, x + 8.0 * usize.toF64(String.byteLength(value)), top + 16.0))
  return move node
}

effect fn control(kind: Role, label: string, row: usize) -> Node
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut node = Node.make(kind)
  run node.setLabel(label)
  node.addAction(Action.Focus)
  node.addAction(Action.Click)
  let top = usize.toF64(row) * 20.0
  run node.setBounds(Rect.make(0.0, top, 120.0, top + 16.0))
  return move node
}

effect fn page(focus: u64, checked: bool, status: string) -> TreeUpdate
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut update = TreeUpdate.make(NodeId.of(focus))
  update.tree = Option.Some { value: TreeInfo.make(NodeId.of(1)) }
  let mut window = run box(Role.Window, &[2, 10])
  run window.setLabel("Shop")
  run update.push(NodeId.of(1), move window)
  let mut nav = run box(Role.Navigation, &[3])
  run nav.setLabel("Main")
  run update.push(NodeId.of(2), move nav)
  run update.push(NodeId.of(3), run box(Role.List, &[4, 7]))
  run update.push(NodeId.of(4), run box(Role.ListItem, &[5]))
  let mut home = run box(Role.Link, &[6])
  home.addAction(Action.Focus)
  home.addAction(Action.Click)
  run update.push(NodeId.of(5), move home)
  run update.push(NodeId.of(6), run text("Home", 0, 0.0))
  run update.push(NodeId.of(7), run box(Role.ListItem, &[8]))
  let mut about = run box(Role.Link, &[9])
  about.addAction(Action.Focus)
  run update.push(NodeId.of(8), move about)
  run update.push(NodeId.of(9), run text("About", 1, 0.0))
  run update.push(NodeId.of(10), run box(Role.Main, &[11, 13, 17, 18, 19, 20, 22, 33]))
  let mut welcome = run box(Role.Heading, &[12])
  run welcome.setLevel(1)
  run update.push(NodeId.of(11), move welcome)
  run update.push(NodeId.of(12), run text("Welcome", 2, 0.0))
  run update.push(NodeId.of(13), run box(Role.Paragraph, &[14, 15]))
  run update.push(NodeId.of(14), run text("Read our ", 3, 0.0))
  let mut policy = run box(Role.Link, &[16])
  policy.addAction(Action.Focus)
  run update.push(NodeId.of(15), move policy)
  run update.push(NodeId.of(16), run text("policy", 3, 72.0))
  let mut subscribe = run control(Role.CheckBox, "Subscribe", 4)
  run subscribe.setToggled(if checked { Toggled.True } else { Toggled.False })
  run update.push(NodeId.of(17), move subscribe)
  run update.push(NodeId.of(18), run control(Role.TextInput, "Email", 5))
  run update.push(NodeId.of(19), run control(Role.Button, "Send", 6))
  let mut prices = run box(Role.Heading, &[21])
  run prices.setLevel(2)
  run update.push(NodeId.of(20), move prices)
  run update.push(NodeId.of(21), run text("Prices", 7, 0.0))
  run update.push(NodeId.of(22), run box(Role.Table, &[23, 28]))
  run update.push(NodeId.of(23), run box(Role.Row, &[24, 26]))
  run update.push(NodeId.of(24), run box(Role.ColumnHeader, &[25]))
  run update.push(NodeId.of(25), run text("Fruit", 8, 0.0))
  run update.push(NodeId.of(26), run box(Role.ColumnHeader, &[27]))
  run update.push(NodeId.of(27), run text("Price", 8, 100.0))
  run update.push(NodeId.of(28), run box(Role.Row, &[29, 31]))
  run update.push(NodeId.of(29), run box(Role.Cell, &[30]))
  run update.push(NodeId.of(30), run text("Apple", 9, 0.0))
  run update.push(NodeId.of(31), run box(Role.Cell, &[32]))
  run update.push(NodeId.of(32), run text("$1", 9, 100.0))
  let mut live = run box(Role.Status, &[34])
  run live.setLive(Live.Polite)
  run update.push(NodeId.of(33), move live)
  run update.push(NodeId.of(34), run text(status, 10, 0.0))
  return move update
}

/// Presses `code` (with `modifiers`) and returns what the reader said, joined by " | ".
effect fn press(reader: &mut Reader, code: string, modifiers: u32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  drop run reader.key("", code, modifiers, true)
  drop run reader.key("", code, modifiers, false)
  return run heard(&mut reader)
}

effect fn heard(reader: &mut Reader) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut said = List<Utterance>.make()
  run reader.takeSpeech(&mut said)
  let mut out = String.make()
  let mut i: usize = 0
  while i < said.length() {
    let text = said.asSlice()[i].text.view()
    if String.byteLength(text) != 0 {
      if String.byteLength(out.view()) != 0 {
        run out.append(" | ")
      }
      run out.append(text)
    }
    i = i + 1
  }
  return move out
}

effect fn expectSaid(said: String, expected: string) -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  if said.view() != expected {
    StderrWriter.print("said     \"{}\"\nexpected \"{}\"\n", &.(said.view(), expected))
  }
  run Testing.expect(said.view() == expected, "the reader says what the flavor says")
}

effect fn started(flavor: Flavor) -> Reader
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reader = Reader.make(flavor)
  run reader.update(run page(1, false, ""))
  drop run heard(&mut reader)
  return move reader
}

effect fn nvdaBrowseMode() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut r = run started(Flavor.Nvda)
  run expectSaid(run press(&mut r, "ArrowDown", 0), "link About")
  run expectSaid(run press(&mut r, "ArrowDown", 0), "out of list main landmark heading level 1 Welcome")
  run expectSaid(run press(&mut r, "ArrowDown", 0), "Read our link policy")
  run expectSaid(run press(&mut r, "ArrowDown", 0), "Subscribe check box not checked")
  run expectSaid(run press(&mut r, "ArrowDown", 0), "Email edit blank")
  run expectSaid(run press(&mut r, "ArrowUp", 0), "Subscribe check box not checked")
  // Quick navigation, and nothing past the last.
  run expectSaid(run press(&mut r, "KeyH", 0), "heading level 2 Prices")
  run expectSaid(run press(&mut r, "KeyH", 0), "no next heading")
  run expectSaid(run press(&mut r, "KeyH", MOD_SHIFT), "heading level 1 Welcome")
  run expectSaid(run press(&mut r, "KeyK", 0), "link policy")
  run expectSaid(run press(&mut r, "KeyB", 0), "Send button")
  run expectSaid(run press(&mut r, "KeyT", 0), "table with 2 rows and 2 columns Fruit")
  run expectSaid(run press(&mut r, "KeyD", MOD_SHIFT), "out of table Main navigation landmark list with 2 items link Home")
  // Words and characters.
  drop run press(&mut r, "KeyH", 0)
  run expectSaid(run press(&mut r, "ArrowDown", 0), "Read our link policy")
  run expectSaid(run press(&mut r, "ArrowRight", 0), "e")
  run expectSaid(run press(&mut r, "ArrowRight", MOD_CONTROL), "our")
  run expectSaid(run press(&mut r, "End", 0), "y")
  // Tables: Control+Alt with the arrows.
  drop run press(&mut r, "KeyT", 0)
  run expectSaid(run press(&mut r, "ArrowDown", MOD_CONTROL | MOD_ALT), "row 2 Apple")
  run expectSaid(run press(&mut r, "ArrowRight", MOD_CONTROL | MOD_ALT), "Price column 2 $1")
  run expectSaid(run press(&mut r, "ArrowRight", MOD_CONTROL | MOD_ALT), "edge of table")
  // The reader key (Insert, or Control+Alt) with T, and letters stay in browse mode.
  run expectSaid(run press(&mut r, "KeyT", MOD_CONTROL | MOD_ALT), "Shop")
  run Testing.expect(run r.key("x", "KeyZ", 0, true), "browse mode keeps letters from the app")
}

test effect fn nvdaReadsTheBufferByLineWordAndCharacter() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nvdaBrowseMode() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn otherFlavors() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut vo = run started(Flavor.VoiceOver)
  run expectSaid(run press(&mut vo, "ArrowRight", MOD_CONTROL | MOD_ALT), "About, link")
  run expectSaid(run press(&mut vo, "ArrowRight", MOD_CONTROL | MOD_ALT), "end of list, main, Welcome, heading level 1")
  run expectSaid(run press(&mut vo, "KeyJ", MOD_CONTROL | MOD_ALT | MOD_META), "Subscribe, unchecked, checkbox")
  run Testing.expect(!run vo.key("h", "KeyH", 0, true), "VoiceOver leaves plain letters to the app")
  let mut jaws = run started(Flavor.Jaws)
  run expectSaid(run press(&mut jaws, "KeyU", 0), "link About")
  run expectSaid(run press(&mut jaws, "KeyH", 0), "list end main region heading level 1 Welcome")
  let mut orca = run started(Flavor.Orca)
  run expectSaid(run press(&mut orca, "KeyB", 0), "leaving list main landmark Send push button")
  let mut narrator = run started(Flavor.Narrator)
  run expectSaid(run press(&mut narrator, "KeyH", 0), "exiting list, main landmark, Welcome, heading level 1")
}

test effect fn flavorsUseTheirOwnKeysAndWords() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run otherFlavors() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn focusAndLive() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut r = run started(Flavor.Nvda)
  // Focus moves to the text field: the reader says so and goes into focus mode.
  run r.update(run page(18, false, ""))
  run expectSaid(run heard(&mut r), "main landmark Email edit blank")
  run Testing.expect(r.focusMode(), "a text field puts NVDA in focus mode")
  run Testing.expect(!run r.key("h", "KeyH", 0, true), "focus mode leaves letters to the app")
  run expectSaid(run press(&mut r, "Escape", 0), "browse mode")
  // Focus on the check box, then it is checked in place.
  run r.update(run page(17, false, ""))
  run expectSaid(run heard(&mut r), "Subscribe check box not checked")
  run r.update(run page(17, true, ""))
  run expectSaid(run heard(&mut r), "checked")
  // A polite live region.
  run r.update(run page(17, true, "Saved"))
  run expectSaid(run heard(&mut r), "Saved")
  // Activating clicks the element under the cursor.
  drop run press(&mut r, "KeyB", 0)
  drop run press(&mut r, "Enter", 0)
  let mut requests = List<ActionRequest>.make()
  run r.takeRequests(&mut requests)
  let mut clicked = false
  let mut i: usize = 0
  while i < requests.length() {
    let request = &requests.asSlice()[i]
    if request.action == Action.Click && request.targetNode.value == 19 {
      clicked = true
    }
    i = i + 1
  }
  run Testing.expect(clicked, "Enter clicks the button under the cursor")
}

test effect fn focusStatesAndLiveRegionsAreAnnounced() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run focusAndLive() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn listAndLabels() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut r = run started(Flavor.Nvda)
  run expectSaid(run press(&mut r, "F7", MOD_CONTROL | MOD_ALT), "elements list links Home 1 of 3")
  run expectSaid(run press(&mut r, "ArrowDown", 0), "About 2 of 3")
  run expectSaid(run press(&mut r, "ArrowLeft", 0), "elements list headings Welcome level 1 1 of 2")
  run expectSaid(run press(&mut r, "Enter", 0), "out of list main landmark heading level 1 Welcome")
  let mut label = String.make()
  run keyLabel(Flavor.Nvda, Command.Jump { kind: Kind.Heading, forward: true }, &mut label)
  run expectSaid(move label, "H")
  let mut vo = String.make()
  run keyLabel(Flavor.VoiceOver, Command.Jump { kind: Kind.Heading, forward: true }, &mut vo)
  run expectSaid(move vo, "VO+Cmd+H")
  let mut mode = String.make()
  run keyLabel(Flavor.Nvda, Command.ToggleMode, &mut mode)
  run expectSaid(move mode, "NVDA+Space")
}

test effect fn elementsListAndKeyLabels() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run listAndLabels() |> Effect.provideMut<Allocator>(&mut allocator)
}
