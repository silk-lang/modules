//! Owned virtual-list geometry and Fenwick-tree prefix sums. Extracted to `ui-protocol` so
//! `loom-dom` and remote clients track measured row strides and viewport ranges without
//! depending on `ui-tree`.
pub import options { VirtualOptions, VirtualItem, VirtualRange }
import silk.collections.list { List }
import silk.concurrency.thread { Transferable }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.usize

/// Retained geometry for one virtual list.
pub struct VirtualList {
  /// Current list configuration.
  pub options: VirtualOptions,
  /// Logical item count, independent of measurement storage.
  pub count: usize,
  /// Materialized strides, allocated only after a row differs from the estimate.
  pub heights: List<f32>,
  sums: List<f64>,
  /// Mounted client items in logical order.
  pub rows: List<VirtualItem>,
  /// Private layout-node IDs for omitted content and inter-item gaps.
  pub spacers: List<usize>,
  /// Last applied heights of the private layout nodes.
  pub spacerHeights: List<f32>,
  /// Client node ID of the scroll container.
  pub port: u32,
  /// First item in the mounted viewport range.
  pub first: usize,
  /// Exclusive end of the mounted viewport range.
  pub end: usize,
  /// Current vertical offset in CSS pixels.
  pub scroll: f32,
  /// Last measured width of the scroll container.
  pub width: f32,
  /// Last measured height of the scroll container.
  pub height: f32,
  /// Whether the tree must restore the scroll anchor.
  pub correction: bool,
  /// The item count the measurements are for while a count change waits for the rows that
  /// say where items came and went (see `remap`), or `usize.MAX`.
  pub previous: usize,
}

impl Transferable for VirtualList {}

impl VirtualList {
  /// Creates empty controller geometry. Use tree mutations to attach a controller.
  pub fn make(options: VirtualOptions) -> VirtualList {
    return VirtualList {
      options: options,
      count: 0,
      heights: List<f32>.make(),
      sums: List<f64>.make(),
      rows: List<VirtualItem>.make(),
      spacers: List<usize>.make(),
      spacerHeights: List<f32>.make(),
      port: 0,
      first: 0,
      end: 0,
      scroll: 0.0,
      width: 0.0,
      height: 800.0,
      correction: false,
      previous: usize.MAX,
    }
  }

  /// Replaces all measurements with estimates for `count` items.
  pub effect fn reset(self: &mut Self, count: usize, options: VirtualOptions) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.options = options
    self.count = count
    self.heights = List<f32>.make()
    self.sums = List<f64>.make()
    self.previous = usize.MAX
    drop self.range(true)
  }

  /// The count becomes `count` and the measurements stay with their items: `before` are the
  /// rows bound to the old count and `after` the rows bound to the new one, and a row bound in
  /// both pins its item's old index to its new one. Items come and go between pinned rows,
  /// just before the first, or just after the last, so measured items keep their heights and
  /// the item at the top of the viewport keeps its offset. Returns whether the scroll moved.
  pub effect fn remap(self: &mut Self, count: usize, before: &[VirtualItem], after: &[VirtualItem]) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let old = if self.previous == usize.MAX { self.count } else { self.previous }
    self.count = old
    self.previous = usize.MAX
    // Pins in order: each one later than the last in both lists.
    let mut from = List<usize>.make()
    let mut to = List<usize>.make()
    let mut a: usize = 0
    while a < after.length {
      let mut b: usize = 0
      while b < before.length && before[b].id != after[a].id {
        b = b + 1
      }
      if b < before.length && before[b].index < old && after[a].index < count
        && (from.length() == 0 || (before[b].index > from.get(from.length() - 1)
          && after[a].index > to.get(to.length() - 1))) {
        run from.append(before[b].index)
        run to.append(after[a].index)
      }
      a = a + 1
    }
    let top = self.locate(self.scroll)
    let offset = self.scroll - self.prefix(top)
    let anchor = moved(top, old, count, from.asSlice(), to.asSlice())
    self.count = count
    if self.heights.length() != 0 {
      let estimate = self.stride()
      let mut heights = List<f32>.make()
      run heights.appendRepeated(estimate, count)
      // Before the first pin the items line up at its end, after the last at its start, and
      // between two pins at the earlier one.
      let mut segment: usize = 0
      while segment <= from.length() {
        let oldStart = if segment == 0 { 0 } else { from.get(segment - 1) + 1 }
        let oldEnd = if segment == from.length() { old } else { from.get(segment) }
        let newStart = if segment == 0 { 0 } else { to.get(segment - 1) + 1 }
        let newEnd = if segment == from.length() { count } else { to.get(segment) }
        let oldLength = oldEnd - oldStart
        let newLength = newEnd - newStart
        let length = if oldLength < newLength { oldLength } else { newLength }
        let lead = segment == 0 && from.length() != 0
        let mut i: usize = 0
        while i < length {
          let source = if lead { oldEnd - length + i } else { oldStart + i }
          let target = if lead { newEnd - length + i } else { newStart + i }
          heights.set(target, self.heights.get(source))
          i = i + 1
        }
        if segment < from.length() {
          heights.set(to.get(segment), self.heights.get(from.get(segment)))
        }
        segment = segment + 1
      }
      // The Fenwick sums of the new heights, in one pass.
      let mut sums = List<f64>.make()
      run sums.appendRepeated(0.0, count + 1)
      let mut i: usize = 1
      while i <= count {
        let sum = sums.get(i) + f32.toF64(heights.get(i - 1))
        sums.set(i, sum)
        let parent = i + (i - usize.bitAnd(i, i - 1))
        if parent <= count {
          let up = sums.get(parent) + sum
          sums.set(parent, up)
        }
        i = i + 1
      }
      self.heights = move heights
      self.sums = move sums
    }
    let scroll = if anchor < count { self.prefix(anchor) + offset } else { self.prefix(count) }
    let shift = f32.abs(scroll - self.scroll) > 0.01
    self.scroll = scroll
    drop self.range(true)
    return shift
  }

  fn stride(self: &Self) -> f32 {
    return f32.max(1.0, self.options.estimatedHeight) + self.options.gap
  }

  effect fn materialize(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let estimate = self.stride()
    let mut heights = List<f32>.make()
    let mut sums = List<f64>.make()
    run heights.appendRepeated(estimate, self.count)
    run sums.append(0.0)
    let mut i: usize = 1
    while i <= self.count {
      let low = i - usize.bitAnd(i, i - 1)
      run sums.append(usize.toF64(low) * f32.toF64(estimate))
      i = i + 1
    }
    self.heights = move heights
    self.sums = move sums
  }

  /// Returns the estimated or measured position before item `end`.
  /// `end` must not exceed the item count.
  pub fn prefix(self: &Self, end: usize) -> f32 {
    if self.heights.length() == 0 {
      return f64.toF32(usize.toF64(end) * f32.toF64(self.stride()))
    }
    let mut i = end
    let mut total = 0.0
    while i > 0 {
      total = total + self.sums.get(i)
      i = usize.bitAnd(i, i - 1)
    }
    return f64.toF32(total)
  }

  /// Returns the item at `position`, or the item count at the end.
  pub fn locate(self: &Self, position: f32) -> usize {
    if self.heights.length() == 0 {
      let index = f32.toF64(f32.max(0.0, position)) / f32.toF64(self.stride())
      return if index >= usize.toF64(self.count) { self.count } else { f64.toUsize(index) }
    }
    let mut bit: usize = 1
    while bit <= self.heights.length() / 2 {
      bit = bit * 2
    }
    let mut at: usize = 0
    let mut sum = 0.0
    while bit > 0 {
      let next = at + bit
      if next <= self.heights.length() && sum + self.sums.get(next) <= f32.toF64(position) {
        at = next
        sum = sum + self.sums.get(next)
      }
      bit = bit / 2
    }
    return at
  }

  /// Updates one measured height and returns whether it changed.
  /// `index` must be less than the item count.
  pub effect fn measure(self: &mut Self, index: usize, height: f32) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let value = f32.max(1.0, height)
    let uniform = self.heights.length() == 0
    let previous = if uniform { self.stride() } else { self.heights.get(index) }
    let delta = value - previous
    if f32.abs(delta) < 0.25 {
      return false
    }
    if uniform { run self.materialize() }
    self.heights.set(index, value)
    let mut i = index + 1
    while i < self.sums.length() {
      let sum = self.sums.get(i) + f32.toF64(delta)
      self.sums.set(i, sum)
      i = i + (i - usize.bitAnd(i, i - 1))
    }
    return true
  }

  /// Updates the mounted range, retaining overscan until its inner margin is crossed.
  pub fn range(self: &mut Self, force: bool) -> bool {
    let overscan = f32.max(0.0, self.options.overscan)
    let margin = overscan * 0.25
    if !force && (self.first == 0 || self.prefix(self.first) <= self.scroll - margin)
      && (self.end == self.count
        || self.prefix(self.end) >= self.scroll + self.height + margin) {
      return false
    }
    let first = self.locate(f32.max(0.0, self.scroll - overscan))
    let candidate = self.locate(self.scroll + self.height + overscan) + 1
    let end = if candidate < self.count {
      candidate
    } else {
      self.count
    }
    let changed = first != self.first || end != self.end
    self.first = first
    self.end = end
    return changed
  }
}

/// Where old index `index` of `old` items is after `remap` to `count` with pins `from` → `to`.
fn moved(index: usize, old: usize, count: usize, from: &[usize], to: &[usize]) -> usize {
  if index >= old {
    return count
  }
  let mut segment: usize = 0
  while segment < from.length && from[segment] < index {
    segment = segment + 1
  }
  if segment < from.length && from[segment] == index {
    return to[segment]
  }
  let oldStart = if segment == 0 { 0 } else { from[segment - 1] + 1 }
  let oldEnd = if segment == from.length { old } else { from[segment] }
  let newStart = if segment == 0 { 0 } else { to[segment - 1] + 1 }
  let newEnd = if segment == from.length { count } else { to[segment] }
  let target = if segment == 0 && from.length != 0 {
    // Lined up at the pin's end: an item that no longer fits came out.
    if newEnd < oldEnd - index { return newStart }
    newEnd - (oldEnd - index)
  } else {
    newStart + (index - oldStart)
  }
  return if target < newEnd { target } else if newEnd > newStart { newEnd - 1 } else { newEnd }
}
