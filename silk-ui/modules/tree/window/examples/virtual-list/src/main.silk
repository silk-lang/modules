//! Scroll a million numbered, uniform rows using the retained tree's own range requests.
import ui_tree.css
import ui_tree.css { px, percent, Keyword }
import ui_tree.legacy { UiTree, TreeError, Batch, Mutation, FrameInput, NodeKind, FlexDirection, Overflow, VirtualItem, VirtualOptions }
import ui_tree.node { Event }
import ui_tree.mutation { Attribute, Role }
import ui_fixtures.fixtures as fixtures
import ui_tree_window.host { WindowClient, RunOptions, runWindow, StartedGpu }
import ui_tree_window.platform_thread { Launched, launch }
import ui_tree_window.console { StderrWriter }
import ui_inspect_server.lib { Inspector }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.text.format { Format }
import silk.text.string { String, InvalidUtf8 }
import silk.collections.slice { Slice }
import silk.collections.bytes { Bytes }
import silk.system.host_input { HostInput }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }

struct WindowRange { mounted: List<usize> }
struct Client { varied: bool, feed: bool }

impl WindowClient<WindowRange, never, never> for Client {
  effect fn start(self: &mut Self, state: &mut WindowRange, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let mut batch = Batch.make()
    run batch.create(1, NodeKind.Box)
    run batch.root(1)
    run batch.attribute(1, Attribute.Role { value: if self.feed { Role.Feed } else { Role.List } })
    if self.feed {
      run batch.attribute(1, Attribute.Label { value: run String.copy("Observatory dispatches") })
      run batch.attribute(1, Attribute.RoleDescription { value: run String.copy("feed") })
    }
    run batch.style(1, &[css.height(percent(100.0)), css.display(Keyword.Flex),
      css.flexDirection(FlexDirection.Column), css.overflowY(Overflow.Auto)])
    let count: usize = if self.feed { 100 } else if self.varied { 10000 } else { 1000000 }
    let estimate: f32 = if self.feed { 80.0 } else if self.varied { 52.0 } else { 32.0 }
    run batch.virtualList(1, count, VirtualOptions {
      estimatedHeight: estimate, overscan: 128.0, gap: 0.0, revision: 0,
    })
    run tree.apply(run batch.take())
  }

  effect fn pump(self: &mut Self, state: &mut WindowRange, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let mut events = List<Event>.make()
    run tree.takeEvents(&mut events)
  }

  effect fn layout(self: &mut Self, state: &mut WindowRange, tree: &mut UiTree<'_>, input: FrameInput) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    run tree.frame(input)
    if let Option.Some { value: range } = tree.virtualRange(1) {
      let wanted = run tree.virtualIndices(1)
      let mut same: usize = 0
      while same < wanted.length() && same < state.mounted.length() && wanted.get(same) == state.mounted.get(same) {
        same = same + 1
      }
      if same == wanted.length() && same == state.mounted.length() { return () }
      let mut batch = Batch.make()
      let mut old: usize = 0
      let mut next: usize = 0
      while old < state.mounted.length() {
        let index = state.mounted.get(old)
        while next < wanted.length() && wanted.get(next) < index { next = next + 1 }
        if next == wanted.length() || wanted.get(next) != index {
          run batch.push(Mutation.Destroy { id: rowId(index) })
        }
        old = old + 1
      }
      let mut rows = List<VirtualItem>.make()
      next = 0
      while next < wanted.length() {
        let i = wanted.get(next)
        let id = rowId(i)
        if !tree.contains(id) {
          let heights: [f32; 5] = [28.0, 44.0, 80.0, 36.0, 72.0]
          let height: f32 = if self.varied { heights[i % 5] } else { 32.0 }
          if self.feed {
            run batch.box(1, id, &[css.display(Keyword.Flex), css.flexDirection(FlexDirection.Column), css.flexShrink(0.0)])
          } else {
            run batch.box(1, id, &[css.height(px(height)), css.flexShrink(0.0)])
          }
          run batch.attribute(id, Attribute.Role { value: if self.feed { Role.Article } else { Role.ListItem } })
          run batch.attribute(id, Attribute.TabIndex { value: 0 })
          run batch.attribute(id, Attribute.PosInSet { value: usize.toI32(i + 1) })
          run batch.attribute(id, Attribute.SetSize { value: usize.toI32(range.count) })
          let mut digits: [u8; 20] = [0; 20]
          let n = Format.writeU64Display(usize.toU64(i + 1), &mut digits, 0)
          if let Result<string, InvalidUtf8>.Success { value } = String.fromUtf8(Slice.view<u8>(&digits, 0, n)) {
            if self.feed {
              let titles = ["First light", "The cloud report", "At the telescope", "Night watch"]
              let notes = ["Venus is visible just before sunrise.", "Thin clouds crossed the western sky. The northern horizon stayed clear.",
                "The team aligned the finder scope using Vega.", "Observers logged the last exposure and closed the dome."]
              let mut title = run String.copy(titles[i % 4])
              run title.append(" | Dispatch ")
              run title.append(value)
              run batch.box(id, id + 1, &[css.fontSize(px(20.0))])
              run batch.attribute(id + 1, Attribute.Role { value: Role.Heading })
              run batch.attribute(id + 1, Attribute.Level { value: 2 })
              run batch.text(id + 1, id + 2, title.view())
              let mut labels = List<u32>.make()
              run labels.append(id + 1)
              run batch.attribute(id, Attribute.LabelledBy { ids: move labels })
              run batch.text(id, id + 3, notes[i % 4])
            } else { run batch.text(id, id + 1, value) }
          }
        } else {
          run batch.push(Mutation.InsertBefore { parent: 1, child: id, before: Option<u32>.None })
        }
        run rows.append(VirtualItem { index: i, id: id })
        next = next + 1
      }
      run batch.virtualItems(1, rows.asSlice())
      run tree.apply(run batch.take())
      state.mounted = move wanted
      run tree.frame(input)
    }
  }
}

fn rowId(index: usize) -> u32 { return 2 + usize.toU32(index) * 4 }

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("Virtual list demo failed\n", &())
  return 1
}

pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mode: u32 = match move run Effect.result(HostInput.argument(1)) |> Effect.provideMut<Allocator>(&mut allocator) {
    Result.Success { value: Option.Some { value } } => match String.fromUtf8(Bytes.asSlice(&value)) {
      Result.Success { value: arg } => if arg == "--feed" { 2 } else if arg == "--varied" { 1 } else { 0 }
      _ => 0
    }
    _ => 0
  }
  return run Effect.catchAll(launch(|platform: Option<Launched>| -> i32 {
    return runApp(mode, move platform)
  }), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn runApp(mode: u32, platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(mode, move platform), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn program(mode: u32, platform: Option<Launched>) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
    let fonts = run fixtures.fonts()
    let options = RunOptions {
      title: if mode == 2 { "Observatory dispatches | Feed" } else if mode == 1 { "Variable heights | 10,000 rows" } else { "Virtual list | 1,000,000 rows" },
      width: 480.0, height: 520.0,
      check: false, checkClick: "", checkExpect: "", lowestLatency: false,
      platform: move platform, gpu: Option<StartedGpu>.None,
    }
    let mut state = WindowRange { mounted: List<usize>.make() }
    let mut client = Client { varied: mode == 1, feed: mode == 2 }
    return run runWindow(&mut state, &fonts, List<Mutation>.make(), move options, Inspector.off(), &mut client)
}
