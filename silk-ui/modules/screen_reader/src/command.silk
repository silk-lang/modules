//! What a screen reader user asks for, whatever keys their screen reader uses for it. Keys
//! become commands in [`flavor`]; panels and tools send commands directly.
import silk.core.ownership { Copy }

/// The kinds of element quick navigation, the elements list and the rotor move between.
pub enum Kind {
  Heading,
  Heading1,
  Heading2,
  Heading3,
  Heading4,
  Heading5,
  Heading6,
  Link,
  FormField,
  Button,
  Edit,
  CheckBox,
  Radio,
  ComboBox,
  Table,
  List,
  ListItem,
  Landmark,
  Graphic,
}

/// How many kinds the elements list and the rotor show.
pub const LIST_KINDS: usize = 5

/// The kind at `index` of the elements list and the rotor (wrapping).
pub fn listKind(index: usize) -> Kind {
  return match index % LIST_KINDS {
    0 => Kind.Heading
    1 => Kind.Link
    2 => Kind.FormField
    3 => Kind.Button
    _ => Kind.Landmark
  }
}

/// Where `kind` is in the elements list, or the first kind when it is not listed.
pub fn listIndex(kind: Kind) -> usize {
  return match kind {
    Kind.Link => 1
    Kind.FormField => 2
    Kind.Button => 3
    Kind.Landmark => 4
    _ => 0
  }
}

/// A screen reader command.
pub union Command {
  NextLine,
  PreviousLine,
  NextCharacter,
  PreviousCharacter,
  NextWord,
  PreviousWord,
  /// The next element: VoiceOver's VO+Right, object navigation elsewhere.
  NextItem,
  PreviousItem,
  LineStart,
  LineEnd,
  Top,
  Bottom,
  /// Quick navigation to the next (or previous) element of a kind.
  Jump { pub kind: Kind, pub forward: bool },
  /// Click the element under the cursor (Enter, Space, VO+Space).
  Activate,
  /// Browse mode to focus mode and back (NVDA+Space).
  ToggleMode,
  /// Leave focus mode (Escape in a text field).
  BrowseMode,
  SayAll,
  StopSpeech,
  CurrentLine,
  CurrentFocus,
  Title,
  /// Opens the elements list (NVDA+F7) or rotor (VO+U) at a kind.
  ElementsList { pub kind: Kind },
  /// Moves between table cells: rows down when positive, columns right when positive.
  TableMove { pub rows: i32, pub columns: i32 },
  /// Turns the screen reader off (NVDA+Q).
  Quit,
}

impl Copy for Command {}

/// How many commands have names ([`commandAt`]): what panels show as buttons and inspector
/// clients send by name.
pub const NAMED: usize = 62

/// Named command `index`: the commands a panel shows, in its order.
pub fn commandAt(index: usize) -> Command {
  return match index {
    0 => Command.SayAll
    1 => Command.StopSpeech
    2 => Command.CurrentLine
    3 => Command.CurrentFocus
    4 => Command.Title
    5 => Command.PreviousLine
    6 => Command.NextLine
    7 => Command.PreviousItem
    8 => Command.NextItem
    9 => Command.PreviousWord
    10 => Command.NextWord
    11 => Command.PreviousCharacter
    12 => Command.NextCharacter
    13 => Command.LineStart
    14 => Command.LineEnd
    15 => Command.Top
    16 => Command.Bottom
    17 => Command.Jump { kind: Kind.Heading, forward: true }
    18 => Command.Jump { kind: Kind.Heading, forward: false }
    19 => Command.Jump { kind: Kind.Heading1, forward: true }
    20 => Command.Jump { kind: Kind.Heading1, forward: false }
    21 => Command.Jump { kind: Kind.Heading2, forward: true }
    22 => Command.Jump { kind: Kind.Heading2, forward: false }
    23 => Command.Jump { kind: Kind.Heading3, forward: true }
    24 => Command.Jump { kind: Kind.Heading3, forward: false }
    25 => Command.Jump { kind: Kind.Link, forward: true }
    26 => Command.Jump { kind: Kind.Link, forward: false }
    27 => Command.Jump { kind: Kind.FormField, forward: true }
    28 => Command.Jump { kind: Kind.FormField, forward: false }
    29 => Command.Jump { kind: Kind.Button, forward: true }
    30 => Command.Jump { kind: Kind.Button, forward: false }
    31 => Command.Jump { kind: Kind.Edit, forward: true }
    32 => Command.Jump { kind: Kind.Edit, forward: false }
    33 => Command.Jump { kind: Kind.CheckBox, forward: true }
    34 => Command.Jump { kind: Kind.CheckBox, forward: false }
    35 => Command.Jump { kind: Kind.Radio, forward: true }
    36 => Command.Jump { kind: Kind.Radio, forward: false }
    37 => Command.Jump { kind: Kind.ComboBox, forward: true }
    38 => Command.Jump { kind: Kind.ComboBox, forward: false }
    39 => Command.Jump { kind: Kind.Table, forward: true }
    40 => Command.Jump { kind: Kind.Table, forward: false }
    41 => Command.Jump { kind: Kind.List, forward: true }
    42 => Command.Jump { kind: Kind.List, forward: false }
    43 => Command.Jump { kind: Kind.ListItem, forward: true }
    44 => Command.Jump { kind: Kind.ListItem, forward: false }
    45 => Command.Jump { kind: Kind.Landmark, forward: true }
    46 => Command.Jump { kind: Kind.Landmark, forward: false }
    47 => Command.Jump { kind: Kind.Graphic, forward: true }
    48 => Command.Jump { kind: Kind.Graphic, forward: false }
    49 => Command.ElementsList { kind: Kind.Heading }
    50 => Command.ElementsList { kind: Kind.Link }
    51 => Command.ElementsList { kind: Kind.FormField }
    52 => Command.ElementsList { kind: Kind.Button }
    53 => Command.ElementsList { kind: Kind.Landmark }
    54 => Command.TableMove { rows: 1, columns: 0 }
    55 => Command.TableMove { rows: -1, columns: 0 }
    56 => Command.TableMove { rows: 0, columns: 1 }
    57 => Command.TableMove { rows: 0, columns: -1 }
    58 => Command.Activate
    59 => Command.ToggleMode
    60 => Command.BrowseMode
    _ => Command.Quit
  }
}

/// The name inspector clients send for command `index` (`nextHeading`).
pub fn commandName(index: usize) -> string<'static> {
  return match index {
    0 => "sayAll"
    1 => "stopSpeech"
    2 => "currentLine"
    3 => "currentFocus"
    4 => "title"
    5 => "previousLine"
    6 => "nextLine"
    7 => "previousItem"
