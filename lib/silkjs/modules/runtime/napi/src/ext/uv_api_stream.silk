  return length > 0
}
/// libuv 1.52's uv_udp_open_ex: uv_udp_open with the address-reuse options of `flags`
/// (UV_UDP_REUSEADDR, UV_UDP_REUSEPORT) instead of SO_REUSEADDR always.
pub export "C" fn uv_udp_open_ex(udp: *mut u8, sock: i32, flags: u32) -> i32 {
  if (flags & ((UV_UDP_REUSEADDR | UV_UDP_REUSEPORT) ^ 4294967295)) != 0 { return -EINVAL }
