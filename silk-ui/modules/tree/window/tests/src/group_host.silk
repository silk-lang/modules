fn win(id: u32) -> WindowId {
  return WindowId { value: id }
}

fn pt(x: f64, y: f64) -> Point2<f64> {
  return Point2<f64>.new(x, y)
}

struct AtomicCounter {
  storage: Box<u32>,
  ptr: *mut u32,
}

impl Transferable for AtomicCounter {}
impl Concurrent for AtomicCounter {}

effect fn makeAtomicCounter() -> Arc<AtomicCounter>
  ! OutOfMemoryError {
  let mut heap = Allocator.systemAllocatorProvider()
  let mut storage = run Box<u32>.make(0) |> Effect.provideMut<Allocator>(&mut heap)
  let ptr = Pointer.fromMutRef(&mut storage.getMut()[0])
  return run Arc<AtomicCounter>.make(AtomicCounter { storage: move storage, ptr: ptr })
    |> Effect.provideMut<Allocator>(&mut heap)
}

fn makeScrollableSurface(window: WindowId, groupId: u32) -> HitTestSurface {
  let mut heap = Allocator.systemAllocatorProvider()
  let mut regions = List<HitRegion>.make()
  drop run Effect.result(
    regions.append(
      HitRegion {
        window: window,
        root: 0,
        groupId: groupId,
        kind: RegionKind.Document,
        bounds: Rect<f32>.new(0.0, 0.0, 400.0, 300.0),
        zOrder: 0,
        opaque: true,
        wheelListener: true,
        wheelPassive: true,
        preventScroll: false,
      },
    ),
  )
    |> Effect.provideMut<Allocator>(&mut heap)
  let mut groups = List<ScrollGroup>.make()
  drop run Effect.result(
    groups.append(
      ScrollGroup {
        parent: 0,
        link: ScrollLink { node: 0, x: ScrollAxis.fixed(), y: ScrollAxis.fixed() },
        clip: Rect<f32>.new(0.0, 0.0, 400.0, 300.0),
        clipRadii: Radii.zero(),
        bounds: Rect<f32>.new(0.0, 0.0, 400.0, 300.0),
      },
    ),
  )
    |> Effect.provideMut<Allocator>(&mut heap)
  drop run Effect.result(
    groups.append(
      ScrollGroup {
        parent: 0,
        link: ScrollLink { node: 10, x: ScrollAxis.content(), y: ScrollAxis.content() },
        clip: Rect<f32>.new(0.0, 0.0, 400.0, 300.0),
        clipRadii: Radii.zero(),
        bounds: Rect<f32>.new(0.0, 0.0, 400.0, 1300.0),
      },
    ),
  )
    |> Effect.provideMut<Allocator>(&mut heap)
  let mut painted = List<ScrollPosition>.make()
  drop run Effect.result(
    painted.append(
      ScrollPosition {
        node: 10,
        x: 0.0,
        y: 0.0,
        minX: 0.0,
        maxX: 0.0,
        minY: 0.0,
        maxY: 900.0,
      },
    ),
  )
    |> Effect.provideMut<Allocator>(&mut heap)
  let mut fast = FastScroll.make()
  drop run Effect.result(
    fast.scrollers.append(ScrollerAxes { node: 10, x: false, y: true, order: 0 }),
  )
    |> Effect.provideMut<Allocator>(&mut heap)
  return HitTestSurface {
    window: window,
    groupId: groupId,
    commitEpoch: 1,
    targetGeneration: 1,
    scale: 1.0,
    size: Size2<f32>.new(400.0, 300.0),
    consumedInputSeq: 0,
    regions: move regions,
    groups: move groups,
    painted: move painted,
    fast: move fast,
  }
}

fn f12Event(window: WindowId) -> Event {
  return Event.KeyDown {
    window: window,
    key: Key.Character { text: String.make() },
    code: KeyCode.F12,
    modifiers: Modifiers.none(),
    repeat: false,
    imeHandled: false,
  }
}

test effect fn multiGroupCompositorRoutesIndependentlyWhilePrimaryGroupStalled() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GpuError {
  let platform = HostPlatform.headless()
  let cmdPair = run UnboundedChannel.make<GpuCommand>(WakeHandle.noop())
  let UnboundedPair<GpuCommand> { sender: cmdTx, receiver: cmdRxInit } = move cmdPair
  let mut cmdRx = move cmdRxInit
  let mut comp = run CompositorThread.start(
    GpuHandle.make(move cmdTx),
    GroupWake.make(platform.nudge()),
  )
  let winA = win(1)
  let winB = win(2)
  comp.registerSurface(winA, PRIMARY_GROUP)
  comp.registerSurface(winB, DEVTOOLS_GROUP)
  let mut sub = run comp.openGroupChannel(DEVTOOLS_GROUP)
  comp.commitHitSurface(makeScrollableSurface(winA, PRIMARY_GROUP), true)
  comp.commitHitSurface(makeScrollableSurface(winB, DEVTOOLS_GROUP), true)
  let shortcuts = [
    GlobalShortcut {
      id: 1,
      code: KeyCode.F12,
      modifiers: Modifiers.none(),
      groupId: DEVTOOLS_GROUP,
    },
  ]
  run comp.setShortcuts(&shortcuts)
  comp.updateFocus(winA, 0, PRIMARY_GROUP)

  // Deliberately never call `comp.poll(...)` to simulate a stalled primary group.
  let sink = comp.platformInputSink()
  drop sink.push(Event.MouseMoved { window: winA, position: pt(15.0, 15.0), modifiers: Modifiers.none() }, 1.0)
  drop sink.push(Event.MouseMoved { window: winB, position: pt(30.0, 30.0), modifiers: Modifiers.none() }, 1.0)
  drop sink.push(
    Event.Scroll {
      window: winB,
      position: pt(40.0, 40.0),
      delta: ScrollDelta.Points { delta: Vector2<f64>.new(0.0, -25.0) },
      phase: Phase.None,
      modifiers: Modifiers.none(),
    },
    1.0,
  )
  drop sink.push(f12Event(winA), 1.0)

  let mut sawMove = false
  let mut sawShortcut = false
  let mut sawScroll = false
  let mut sawGpuScroll = false
  let mut attempts: u32 = 0
  while (!sawMove || !sawShortcut || !sawScroll || !sawGpuScroll) && attempts < 20 {
    while true {
      match sub.rx.tryRecv() {
        Result.Success { value: msg } => match move msg {
          CompositorToGroup.Input { routed } => {
            if routed.target.groupId == DEVTOOLS_GROUP {
              match &routed.event {
                Event.MouseMoved { window, .. } => {
                  if window.value == winB.value {
                    sawMove = true
                  }
                }
                Event.KeyDown { code, .. } => {
                  if code == KeyCode.F12 {
                    sawShortcut = true
                  }
                }
                _ => ()
              }
            }
          }
          CompositorToGroup.Scroll { update } => {
            if update.groupId == DEVTOOLS_GROUP && update.window.value == winB.value {
              sawScroll = true
            }
          }
          _ => ()
        }
        Result.Failure { .. } => { break }
      }
    }
    while true {
      match cmdRx.tryRecv() {
        Result.Success { value: cmd } => {
          if let GpuCommand.ApplyScroll { window, positions, .. } = move cmd {
            if window.value == winB.value && positions.length() == 1 && f32.abs(positions.get(0).y - 25.0) < 0.01 {
              sawGpuScroll = true
            }
          }
        }
        Result.Failure { .. } => { break }
      }
    }
    if !sawMove || !sawShortcut || !sawScroll || !sawGpuScroll {
      drop sub.waiter.waitTimeout(50000000)
      attempts = attempts + 1
    }
  }
  run Testing.expect(
    sawMove && sawShortcut && sawScroll && sawGpuScroll,
    "secondary DevTools group receives pointer, fast-scroll, and F12 shortcut even while primary group never drains",
  )
  comp.unregisterGroup(DEVTOOLS_GROUP)
  comp.stop()
}

struct BlockerTask {
  gate: Waiter,
  total: usize,
  entered: Arc<AtomicCounter>,
  readyWake: WakeHandle,
}

impl Transferable for BlockerTask {}

struct DoneSignal {
  flag: Arc<AtomicCounter>,
  wake: WakeHandle,
}

impl Transferable for DoneSignal {}

fn blockWorker(task: BlockerTask, cancel: &CancellationToken) -> () {
  drop cancel
  let BlockerTask { gate, total, entered, readyWake } = move task
  let prev = unsafe Atomic.fetchAdd<u32>(entered.get().ptr, 1, MemoryOrder.AcquireRelease)
  if u32.toUsize(prev + 1) >= total {
    readyWake.wake()
  }
  gate.wait()
}

fn markPoolDone(sig: DoneSignal, cancel: &CancellationToken) -> () {
  drop cancel
  let DoneSignal { flag, wake } = move sig
  unsafe Atomic.store<u32>(flag.get().ptr, 1, MemoryOrder.Release)
  wake.wake()
}

test effect fn poolsIsolateEngineFromAppAndWakeWithoutPolling() -> ()
  ! AssertionError<'static> | OutOfMemoryError | SpawnError {
  let mut heap = Allocator.systemAllocatorProvider()
  let mut pools = run Pools.make()
  let appWorkers = pools.app.workerCount()
  let entered = run makeAtomicCounter()
  let allEntered = run Waiter.make()
  let mut blockers = List<ClaimHandle>.make()
  let mut gateWakes = List<WakeHandle>.make()
  let mut i: usize = 0
  while i < appWorkers {
    let gate = run Waiter.make()
    run gateWakes.append(gate.handle()) |> Effect.provideMut<Allocator>(&mut heap)
    let payload = BlockerTask {
      gate: move gate,
      total: appWorkers,
      entered: entered.clone(),
      readyWake: allEntered.handle(),
    }
    let claim = run pools.app.submitWith(
      PRIMARY_GROUP,
      move payload,
      blockWorker,
      run CancellationToken.make(),
      WakeHandle.noop(),
    )
    run blockers.append(move claim) |> Effect.provideMut<Allocator>(&mut heap)
    i = i + 1
  }

  let mut waitedEntered: u32 = 0
  while u32.toUsize(unsafe Atomic.load<u32>(entered.get().ptr, MemoryOrder.Acquire)) < appWorkers && waitedEntered < 40 {
    drop allEntered.waitTimeout(50000000)
    waitedEntered = waitedEntered + 1
  }
  run Testing.expect(
    u32.toUsize(unsafe Atomic.load<u32>(entered.get().ptr, MemoryOrder.Acquire)) == appWorkers,
    "all AppPool workers engaged in blocking work",
  )

  let engineDone = run makeAtomicCounter()
  let ioDone = run makeAtomicCounter()
  let engineWaiter = run Waiter.make()
  let ioWaiter = run Waiter.make()
  let engineClaim = run pools.engine.submitWith(
    DEVTOOLS_GROUP,
    DoneSignal { flag: engineDone.clone(), wake: engineWaiter.handle() },
    markPoolDone,
    run CancellationToken.make(),
    WakeHandle.noop(),
  )
  let ioClaim = run pools.io.submitWith(
    DEVTOOLS_GROUP,
    DoneSignal { flag: ioDone.clone(), wake: ioWaiter.handle() },
    markPoolDone,
    run CancellationToken.make(),
    WakeHandle.noop(),
  )

  drop engineWaiter.waitTimeout(1000000000)
  drop ioWaiter.waitTimeout(1000000000)
  engineClaim.wait()
  ioClaim.wait()
  run Testing.expect(
    unsafe Atomic.load<u32>(engineDone.get().ptr, MemoryOrder.Acquire) == 1
      && unsafe Atomic.load<u32>(ioDone.get().ptr, MemoryOrder.Acquire) == 1,
    "EnginePool and IoPool finish and wake Waiters even while AppPool is completely saturated",
  )

  while gateWakes.length() != 0 {
    gateWakes.remove(0).wake()
  }
  while blockers.length() != 0 {
    blockers.remove(0).wait()
  }
  pools.stop()
}

test effect fn secondaryGroupThreadRunsAndTearsDownIndependently() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GpuError | SpawnError {
  let mut pools = run Pools.make()
  let platform = HostPlatform.headless()
  let cmdPair = run UnboundedChannel.make<GpuCommand>(WakeHandle.noop())
  let UnboundedPair<GpuCommand> { sender: cmdTx, receiver: cmdRxInit } = move cmdPair
  let gpu = GpuHandle.make(move cmdTx)
  let mut comp = run CompositorThread.start(
    gpu.clone(),
    GroupWake.make(platform.nudge()),
  )
  let pclient = run PlatformClient.disconnected()
  let services = GroupServices {
    groupId: DEVTOOLS_GROUP,
    kind: GroupKind.DevTools,
    pools: pools.handles(),
    wake: platform.nudge(),
    compositor: Option<CompositorHandle>.some(comp.handle()),
    gpu: Option<GpuHandle>.some(move gpu),
    platform: Option<PlatformClient>.some(move pclient),
  }

  let readyFlag = run makeAtomicCounter()
  let seenCount = run makeAtomicCounter()
  let readyWaiter = run Waiter.make()
  let doneWaiter = run Waiter.make()
  let threadReady = readyFlag.clone()
  let threadSeen = seenCount.clone()
  let readyWake = readyWaiter.handle()
  let doneWake = doneWaiter.handle()
  let targetWin = win(20)

  let spawned = run spawnGroupThread(
    DEVTOOLS_GROUP,
    GroupKind.DevTools,
    move services,
    |ctx: SecondaryGroupContext| -> i32 {
      let mut ctx = move ctx
      let threadReady = move threadReady
      let readyWake = move readyWake
      let threadSeen = move threadSeen
      let doneWake = move doneWake
      let threadWin = win(20)
      ctx.compositor.registerSurface(threadWin, DEVTOOLS_GROUP)
      ctx.compositor.commitHitSurface(makeScrollableSurface(threadWin, DEVTOOLS_GROUP), true)
      unsafe Atomic.store<u32>(threadReady.get().ptr, 1, MemoryOrder.Release)
      readyWake.wake()
      let mut heap = Allocator.systemAllocatorProvider()
      while !ctx.stop.isStopped() {
        let mut inbox = List<CompositorToGroup>.make()
        drop run Effect.result(ctx.rx.drain(&mut inbox, 0)) |> Effect.provideMut<Allocator>(&mut heap)
        while inbox.length() != 0 {
          if let CompositorToGroup.Input { .. } = inbox.remove(0) {
            let prev = unsafe Atomic.fetchAdd<u32>(threadSeen.get().ptr, 1, MemoryOrder.AcquireRelease)
            if prev + 1 >= 2 {
              doneWake.wake()
            }
          }
        }
        if !ctx.stop.isStopped() {
          ctx.waiter.wait()
        }
      }
      ctx.compositor.removeSurface(threadWin)
      return 0
    },
  )
  run Testing.expect(spawned.isSome(), "spawnGroupThread launches isolated thread")
  let mut handle = match move spawned {
    Option<SecondaryGroupHandle>.Some { value } => move value
    Option<SecondaryGroupHandle>.None => {
      comp.stop()
      pools.stop()
      return ()
    }
  }

  let mut waits: u32 = 0
  while unsafe Atomic.load<u32>(readyFlag.get().ptr, MemoryOrder.Acquire) == 0 && waits < 20 {
    drop readyWaiter.waitTimeout(50000000)
    waits = waits + 1
  }
  run Testing.expect(
    unsafe Atomic.load<u32>(readyFlag.get().ptr, MemoryOrder.Acquire) == 1,
    "secondary group thread initialized its compositor surface",
  )

  let sink = comp.platformInputSink()
  drop sink.push(Event.MouseMoved { window: targetWin, position: pt(20.0, 20.0), modifiers: Modifiers.none() }, 1.0)
  drop sink.push(Event.MouseMoved { window: targetWin, position: pt(25.0, 25.0), modifiers: Modifiers.none() }, 1.0)

  let mut recvWaits: u32 = 0
  while unsafe Atomic.load<u32>(seenCount.get().ptr, MemoryOrder.Acquire) < 2 && recvWaits < 20 {
    drop doneWaiter.waitTimeout(50000000)
    recvWaits = recvWaits + 1
  }
  run Testing.expect(
    unsafe Atomic.load<u32>(seenCount.get().ptr, MemoryOrder.Acquire) >= 2,
    "secondary group thread received routed events independently of primary group",
  )

  handle.stop()
  comp.stop()
  drop cmdRxInit
  pools.stop()
}
