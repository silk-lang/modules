//! Operating system queries with libuv 1.51's names, signatures, statuses and results, in Silk.
//!
//! Each function here replaces the C function of the same name (libuv src/unix/core.c, linux.c,
//! darwin.c, bsd-ifaddrs.c, thread.c and src/uv-common.c): it returns 0 or a negative errno, keeps
//! the buffer conventions (`*size` is the capacity on entry and the length on return; UV_ENOBUFS
//! stores the needed capacity), fills the same `extern "C"` structures, and gives results that the
//! matching `uv_free_*` function releases. That memory, and what libuv allocates with uv__malloc
//! on the way, comes from the functions that uv_replace_allocator installs (`uvMalloc`, `uvCalloc`,
//! `uvRealloc`, `uvFree` below, the C library's until then). The supported targets are GNU/Linux
//! and Darwin on LP64.
//! No function enters JavaScript or the event loop.
//!
//! The Linux functions follow libuv's code path by path, also where its result looks accidental
//! (see uv_cpu_info and cgroup2Cpu), because those results are what Node shows. What differs on
//! purpose is small: where libuv calls abort() (a /proc/stat with no first line, a cpufreq file
//! without a number, a failed close) these functions carry on with what they have; a null netmask
//! or a null text of a password entry is read as empty; and the Darwin notes on uv_cpu_info,
//! uv_resident_set_memory and uv_hrtime.
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy, Drop }
import silk.collections.slice { Slice }
import silk.mem.layout { Layout }
import silk.core.option { Option }
import silk.num.i32
import silk.num.i64
import silk.num.isize
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.f64
import silk.concurrency.atomic { Atomic, MemoryOrder }

// --- The structures of uv.h --------------------------------------------------------------------

/// `uv_cpu_times_t`: milliseconds since boot in each state.
pub extern "C" struct CpuTimes { pub user:u64, pub nice:u64, pub sys:u64, pub idle:u64, pub irq:u64 }
/// `uv_cpu_info_t`. `speed` is in MHz.
pub extern "C" struct Cpu { pub model:*const u8, pub speed:i32, pub times:CpuTimes }
/// `uv_interface_address_t`. `address` and `mask` each hold a `struct sockaddr_in` or
/// `struct sockaddr_in6`: both supported platforms use a 28-byte, four-byte-aligned union.
pub extern "C" struct Interface { pub name:*const u8, pub mac:[u8;6], pub internal:i32, pub address:[u32;7], pub mask:[u32;7] }
/// `uv_passwd_t`. The three texts are one allocation that starts at `username`.
pub extern "C" struct Passwd { pub username:*const u8, pub uid:usize, pub gid:usize, pub shell:*const u8, pub homedir:*const u8 }
/// `uv_utsname_t`.
pub extern "C" struct Uname { pub sysname:[u8;256], pub release:[u8;256], pub version:[u8;256], pub machine:[u8;256] }
/// `uv_timeval_t`.
pub extern "C" struct Timeval { pub sec:isize, pub usec:isize }
/// `uv_rusage_t`: the two times, then ru_maxrss (kilobytes) through ru_nivcsw.
pub extern "C" struct Usage { pub user:Timeval, pub system:Timeval, pub counters:[u64;14] }
/// `uv_group_t`. `members` is a null-terminated array in one allocation that also holds the member
/// names and, after them, `groupname`.
pub extern "C" struct Group { pub groupname:?*mut u8, pub gid:usize, pub members:?*mut ?*mut u8 }
/// `uv_env_item_t`. `name` owns one allocation that also holds `value`.
pub extern "C" struct EnvItem { pub name:?*mut u8, pub value:?*mut u8 }
// --- Statuses and constants --------------------------------------------------------------------

// errno values that Linux and Darwin share.
const UV_ENOENT: i32 = -2
const UV_EIO: i32 = -5
const UV_E2BIG: i32 = -7
const UV_ENOMEM: i32 = -12
const UV_EINVAL: i32 = -22
const EINTR: i32 = 4
const ERANGE: i32 = 34
const NONE: usize = 18446744073709551615
// IFF_UP, IFF_LOOPBACK and IFF_RUNNING have the same values on both.
const IFF_UP: u32 = 1
const IFF_LOOPBACK: u32 = 8
const IFF_RUNNING: u32 = 64

static if Intrinsic.targetOperatingSystem() == "darwin" {
  const UV_ENOBUFS: i32 = -55
  // O_RDONLY | O_CLOEXEC.
  const READ_ONLY: i32 = 16777216
  const SC_CLK_TCK: i32 = 3
  const SC_PAGESIZE: i32 = 29
  const SC_NPROCESSORS_ONLN: i32 = 58
  const AF_INET6: u32 = 30
  const AF_LINK: u32 = 18
  // MAXHOSTNAMELEN + 1.
  const HOSTNAME_SIZE: usize = 257
  unsafe extern "C" fn __error() -> *mut i32
  unsafe fn errorSlot() -> *mut i32 { return unsafe __error() }
} else {
  const UV_ENOBUFS: i32 = -105
  const READ_ONLY: i32 = 524288
  const SC_CLK_TCK: i32 = 2
  const SC_PAGESIZE: i32 = 30
  const SC_NPROCESSORS_ONLN: i32 = 84
  const AF_INET6: u32 = 10
  const AF_PACKET: u32 = 17
  const HOSTNAME_SIZE: usize = 65
  unsafe extern "C" fn __errno_location() -> *mut i32
  unsafe fn errorSlot() -> *mut i32 { return unsafe __errno_location() }
}

// --- The C library -----------------------------------------------------------------------------

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
unsafe extern "C" fn realloc(pointer: ?*mut u8, size: usize) -> ?*mut u8
@foreign(noCapture: .("source"))
unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, count: usize) -> *mut u8
@foreign(noCapture: .("text"))
unsafe extern "C" fn strlen(text: *const u8) -> usize
// `end` receives a pointer into `text`.
@foreign(noCapture: .("end"))
unsafe extern "C" fn strtod(text: *const u8, end: *mut ?*const u8) -> f64
@foreign(noCapture: .("path"))
unsafe extern "C" fn open(path: *const u8, flags: i32, ...) -> i32
unsafe extern "C" fn close(fd: i32) -> i32
@foreign(noCapture: .("buffer"))
unsafe extern "C" fn read(fd: i32, buffer: *mut u8, count: usize) -> isize
@foreign(noCapture: .("name"))
unsafe extern "C" fn getenv(name: *const u8) -> ?*const u8
unsafe extern "C" fn sysconf(name: i32) -> i64
@foreign(noCapture: .("name"))
unsafe extern "C" fn gethostname(name: *mut u8, length: usize) -> i32
unsafe extern "C" fn getppid() -> i32
unsafe extern "C" fn geteuid() -> u32
unsafe extern "C" fn getpriority(which: i32, who: u32) -> i32
unsafe extern "C" fn setpriority(which: i32, who: u32, value: i32) -> i32
@foreign(noCapture: .("usage"))
unsafe extern "C" fn getrusage(who: i32, usage: *mut [i64; 18]) -> i32
@foreign(noCapture: .("list"))
unsafe extern "C" fn getifaddrs(list: *mut ?*mut IfAddrs) -> i32
unsafe extern "C" fn freeifaddrs(list: ?*mut IfAddrs) -> ()
// The record receives pointers into `buffer`. `struct passwd` is at most ten 8-byte slots: the
// name, the password, the 32-bit uid and gid in one slot, then Linux has the gecos, home and
// shell, and Darwin has the change time, the class, the gecos, the home, the shell and the expiry.
unsafe extern "C" fn getpwuid_r(uid: u32, record: *mut [?*mut u8; 10], buffer: *mut u8, size: usize, result: *mut ?*mut u8) -> i32
// `struct group` is four 8-byte slots on both: the name, the password, the 32-bit gid, the members.
unsafe extern "C" fn getgrgid_r(gid: u32, record: *mut [?*mut u8; 4], buffer: *mut u8, size: usize, result: *mut ?*mut u8) -> i32

// `struct ifaddrs`. Linux keeps a union of the broadcast and destination addresses in `destination`.
extern "C" struct IfAddrs { next: ?*mut IfAddrs, name: ?*const u8, flags: u32, address: ?*const u8, netmask: ?*const u8, destination: ?*const u8, data: ?*mut u8 }
impl Copy for IfAddrs {}
// `struct timespec`.
extern "C" struct Timespec { seconds: i64, nanoseconds: i64 }

static if Intrinsic.targetOperatingSystem() == "darwin" {
  // `struct utsname`: five fields of 256 bytes (sysname, nodename, release, version, machine).
  const UTS_FIELD: usize = 256
  const UTS_SIZE: usize = 1280
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn uname(value: *mut [u8; 1280]) -> i32
  @foreign(noCapture: .("name", "value", "length", "replacement"))
  unsafe extern "C" fn sysctl(name: *const i32, nameLength: u32, value: *mut u8, length: *mut usize, replacement: ?*mut u8, replacementLength: usize) -> i32
  @foreign(noCapture: .("name", "value", "length", "replacement"))
  unsafe extern "C" fn sysctlbyname(name: *const u8, value: *mut u8, length: *mut usize, replacement: ?*mut u8, replacementLength: usize) -> i32
  unsafe extern "C" static taskPort: u32 as "mach_task_self_"
  // The task port of the process: the mach_task_self() macro of C.
  fn taskSelf() -> u32 { unsafe { return taskPort } }
  unsafe extern "C" fn mach_host_self() -> u32
  unsafe extern "C" fn mach_thread_self() -> u32
  unsafe extern "C" fn mach_port_deallocate(task: u32, name: u32) -> i32
  @foreign(noCapture: .("info", "count"))
  unsafe extern "C" fn host_statistics(host: u32, flavor: i32, info: *mut u32, count: *mut u32) -> i32
  @foreign(noCapture: .("processorCount", "info", "infoCount"))
  unsafe extern "C" fn host_processor_info(host: u32, flavor: i32, processorCount: *mut u32, info: *mut ?*mut i32, infoCount: *mut u32) -> i32
  unsafe extern "C" fn vm_deallocate(task: u32, address: usize, size: usize) -> i32
  @foreign(noCapture: .("info", "count"))
  unsafe extern "C" fn task_info(task: u32, flavor: u32, info: *mut u32, count: *mut u32) -> i32
  @foreign(noCapture: .("info", "count"))
  unsafe extern "C" fn thread_info(thread: u32, flavor: u32, info: *mut i32, count: *mut u32) -> i32
  @foreign(noCapture: .("buffer", "size"))
  unsafe extern "C" fn _NSGetExecutablePath(buffer: *mut u8, size: *mut u32) -> i32
  @foreign(noCapture: .("path"))
  unsafe extern "C" fn realpath(path: *const u8, resolved: *mut u8) -> ?*mut u8
  unsafe extern "C" fn time(seconds: ?*mut i64) -> i64
  unsafe extern "C" fn mach_continuous_time() -> u64
  @foreign(noCapture: .("info"))
  unsafe extern "C" fn mach_timebase_info(info: *mut [u32; 2]) -> i32
  @foreign(noCapture: .("name"))
  unsafe extern "C" fn pthread_setname_np(name: *const u8) -> i32
} else {
  // `struct utsname`: six fields of 65 bytes (sysname, nodename, release, version, machine, domain).
  const UTS_FIELD: usize = 65
  const UTS_SIZE: usize = 390
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn uname(value: *mut [u8; 390]) -> i32
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn clock_gettime(clock: i32, value: *mut Timespec) -> i32
  @foreign(noCapture: .("mask"))
  unsafe extern "C" fn sched_getaffinity(pid: i32, size: usize, mask: *mut u64) -> i32
  @foreign(noCapture: .("path", "buffer"))
  unsafe extern "C" fn readlink(path: *const u8, buffer: *mut u8, capacity: usize) -> isize
  // `struct sysinfo` on LP64 is fourteen 8-byte slots: uptime, loads[3], totalram, freeram,
  // sharedram, bufferram, totalswap, freeswap, procs (16 bits), totalhigh, freehigh, mem_unit (32 bits).
  @foreign(noCapture: .("info"))
  unsafe extern "C" fn sysinfo(info: *mut [u64; 14]) -> i32
  unsafe extern "C" fn pthread_self() -> usize
  @foreign(noCapture: .("name"))
  unsafe extern "C" fn pthread_setname_np(thread: usize, name: *const u8) -> i32
}

// --- Raw memory --------------------------------------------------------------------------------

unsafe fn errno() -> i32 { return unsafe Pointer.read<i32>(unsafe errorSlot()) }
// UV__ERR(errno).
unsafe fn failure() -> i32 { return 0 - unsafe errno() }
// A text literal that ends with a zero byte, as a C string.
fn cstr(text: &[u8]) -> *const u8 { return Pointer.fromRef<u8>(&text[0]) }
unsafe fn present(pointer: ?*const u8) -> *const u8 { return unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(pointer) }
unsafe fn presentMut(pointer: ?*mut u8) -> *mut u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer) }
unsafe fn offset(base: *const u8, index: usize) -> *const u8 { return unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(base), index) }
unsafe fn offsetMut(base: *mut u8, index: usize) -> *mut u8 { return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), index) }
unsafe fn byteAt(base: *const u8, index: usize) -> u8 { return unsafe Pointer.read<u8>(unsafe offset(base, index)) }
unsafe fn setByte(base: *mut u8, index: usize, value: u8) -> () { unsafe Pointer.write<u8>(unsafe offsetMut(base, index), value) }
// The length of a C string, or 0 for a null pointer.
unsafe fn textLength(text: ?*const u8) -> usize {
  if Pointer.isNull<u8>(text) { return 0 }
  return unsafe strlen(unsafe present(text))
}
// Copies `count` bytes from `source`, which may be null when `count` is 0.
unsafe fn copyBytes(dest: *mut u8, source: ?*const u8, count: usize) -> () {
  if count == 0 || Pointer.isNull<u8>(source) { return () }
  let _dest = unsafe memcpy(dest, unsafe present(source), count)
}
fn pageSize() -> u64 {
  let size = unsafe sysconf(SC_PAGESIZE)
  if size < 1 { return 4096 }
  return i64.toU64(size)
}

// A block from calloc that is freed when the owner goes out of scope.
struct Memory { pointer: ?*mut u8 }
impl Drop for Memory { fn drop(self: &mut Self) -> () { unsafe free(self.pointer) } }
// A block from uvMalloc that is freed with uvFree when the owner goes out of scope.
struct UvMemory { pointer: ?*mut u8 }
impl Drop for UvMemory { fn drop(self: &mut Self) -> () { unsafe uvFree(self.pointer) } }

// --- The allocator of uv_replace_allocator ------------------------------------------------------
// libuv allocates what it hands to the caller, and what it releases in its uv_free_* functions,
// through four functions that uv_replace_allocator may replace (src/uv-common.c). Each one is kept
// in a process word of its own, zero while the C library's is in use.

/// `uv_malloc_func`.
pub type MallocFunction = extern "C" fn(usize) -> ?*mut u8
/// `uv_realloc_func`.
pub type ReallocFunction = extern "C" fn(?*mut u8, usize) -> ?*mut u8
/// `uv_calloc_func`.
pub type CallocFunction = extern "C" fn(usize, usize) -> ?*mut u8
/// `uv_free_func`.
pub type FreeFunction = extern "C" fn(?*mut u8) -> ()

fn mallocWord() -> *mut u64 { return Intrinsic.processWord() }
fn timebaseWord() -> *mut u64 { return Intrinsic.processWord() }
fn reallocWord() -> *mut u64 { return Intrinsic.processWord() }
fn callocWord() -> *mut u64 { return Intrinsic.processWord() }
fn freeWord() -> *mut u64 { return Intrinsic.processWord() }
// The address of a C function, and back.
unsafe fn functionWord<F: Copy>(function: F) -> u64 {
  let mut slot: u64 = 0
  unsafe Pointer.write<F>(unsafe Intrinsic.pointerReinterpret<*mut u64, *mut F>(Pointer.fromMutRef<u64>(&mut slot)), function)
  return slot
}
unsafe fn functionAt<F: Copy>(word: u64) -> F {
  return unsafe Pointer.read<F>(unsafe Intrinsic.pointerReinterpret<*const u64, *const F>(Pointer.fromRef<u64>(&word)))
}

/// Installs the four functions of `uv_replace_allocator`, as libuv does: without synchronization
/// and without moving what was allocated before.
pub unsafe fn replaceAllocator(mallocFunction: MallocFunction, reallocFunction: ReallocFunction, callocFunction: CallocFunction, freeFunction: FreeFunction) -> () {
  unsafe Atomic.store<u64>(mallocWord(), unsafe functionWord<MallocFunction>(mallocFunction), MemoryOrder.Release)
  unsafe Atomic.store<u64>(reallocWord(), unsafe functionWord<ReallocFunction>(reallocFunction), MemoryOrder.Release)
  unsafe Atomic.store<u64>(callocWord(), unsafe functionWord<CallocFunction>(callocFunction), MemoryOrder.Release)
  unsafe Atomic.store<u64>(freeWord(), unsafe functionWord<FreeFunction>(freeFunction), MemoryOrder.Release)
}
/// uv__malloc: null for a size of 0.
pub unsafe fn uvMalloc(size: usize) -> ?*mut u8 {
  if size == 0 { return Pointer.null<u8>() }
  let word = unsafe Atomic.load<u64>(mallocWord(), MemoryOrder.Acquire)
  if word == 0 { return unsafe malloc(size) }
  let function = unsafe functionAt<MallocFunction>(word)
  return unsafe function(size)
}
/// uv__calloc.
pub unsafe fn uvCalloc(count: usize, size: usize) -> ?*mut u8 {
  let word = unsafe Atomic.load<u64>(callocWord(), MemoryOrder.Acquire)
  if word == 0 { return unsafe calloc(count, size) }
  let function = unsafe functionAt<CallocFunction>(word)
  return unsafe function(count, size)
}
/// uv__realloc: a size of 0 frees `pointer` and gives null.
pub unsafe fn uvRealloc(pointer: ?*mut u8, size: usize) -> ?*mut u8 {
  if size == 0 { unsafe uvFree(pointer) return Pointer.null<u8>() }
  let word = unsafe Atomic.load<u64>(reallocWord(), MemoryOrder.Acquire)
  if word == 0 { return unsafe realloc(pointer, size) }
  let function = unsafe functionAt<ReallocFunction>(word)
  return unsafe function(pointer, size)
}
/// uv__free: errno is kept.
pub unsafe fn uvFree(pointer: ?*mut u8) -> () {
  let saved = unsafe errno()
  let word = unsafe Atomic.load<u64>(freeWord(), MemoryOrder.Acquire)
  if word == 0 { unsafe free(pointer) } else { let function = unsafe functionAt<FreeFunction>(word) unsafe function(pointer) }
  unsafe Pointer.write<i32>(unsafe errorSlot(), saved)
}
/// uv__strdup: a copy of the C string `text` from uvMalloc, or null.
pub unsafe fn uvStrdup(text: *const u8) -> ?*mut u8 {
  let size = unsafe strlen(text) + 1
  let copy = unsafe uvMalloc(size)
  if Pointer.isNull<u8>(copy) { return copy }
  let _dest = unsafe memcpy(unsafe presentMut(copy), text, size)
  return copy
}

// --- C strings in byte slices ------------------------------------------------------------------
// The texts below live in zero-filled buffers or in whole-file reads. A text ends at its first
// zero byte or at the end of the slice, whichever comes first, as a C string would.

fn at(s: &[u8], index: usize) -> u8 { if index >= s.length { return 0 } return s[index] }
// strlen.
fn length(s: &[u8]) -> usize { let mut n: usize = 0 while n < s.length && s[n] != 0 { n = n + 1 } return n }
// isspace in the C locale.
fn isSpace(ch: u8) -> bool { return ch == 32 || (ch >= 9 && ch <= 13) }
fn skipSpace(s: &[u8], from: usize) -> usize { let mut n = from while isSpace(at(s, n)) { n = n + 1 } return n }
// strncmp(s + from, prefix, strlen(prefix)) == 0.
fn startsWith(s: &[u8], from: usize, prefix: &[u8]) -> bool {
  let mut n: usize = 0
  while n < prefix.length { if at(s, from + n) != prefix[n] { return false } n = n + 1 }
  return true
}
// strcmp(s, other) == 0, for an `other` without a zero byte.
fn same(s: &[u8], other: &[u8]) -> bool { return startsWith(s, 0, other) && at(s, other.length) == 0 }
// strchr(s + from, ch), as an index or NONE.
fn findByte(s: &[u8], from: usize, ch: u8) -> usize {
  let mut n = from
  while true { let c = at(s, n) if c == ch { return n } if c == 0 { return NONE } n = n + 1 }
  return NONE
}
// strrchr(s, ch).
fn findLastByte(s: &[u8], ch: u8) -> usize {
  let mut found = NONE
  let mut n: usize = 0
  while at(s, n) != 0 { if s[n] == ch { found = n } n = n + 1 }
  return found
}
// strstr(s + from, needle).
fn find(s: &[u8], from: usize, needle: &[u8]) -> usize {
  let mut n = from
  while at(s, n) != 0 { if startsWith(s, n, needle) { return n } n = n + 1 }
  return NONE
}
// strcspn(s + from, "\n").
fn lineSpan(s: &[u8], from: usize) -> usize {
  let mut n: usize = 0
  while true { let c = at(s, from + n) if c == 0 || c == 10 { return n } n = n + 1 }
  return n
}
// The part of `s` that starts at `from` and holds `count` bytes, cut at the end of the slice.
fn part(s: &[u8], from: usize, count: usize) -> &[u8] {
  if from >= s.length { return Slice.view<u8>(s, s.length, 0) }
  if count > s.length - from { return Slice.view<u8>(s, from, s.length - from) }
  return Slice.view<u8>(s, from, count)
}

// The digits of strtoull/strtoll at `pos.*`, after optional spaces and a sign. Returns 0 when there
// is no digit (and leaves `pos`), 1 for a value and 2 for a value beyond 64 bits; `negative` and
// the magnitude (saturated) are stored.
fn scanDigits(s: &[u8], pos: &mut usize, magnitude: &mut u64, negative: &mut bool) -> i32 {
  let mut n = skipSpace(s, pos.*)
  negative.* = false
  if at(s, n) == 45 { negative.* = true n = n + 1 } else if at(s, n) == 43 { n = n + 1 }
  let mut value: u64 = 0
  let mut digits: usize = 0
  let mut overflow = false
  while at(s, n) >= 48 && at(s, n) <= 57 {
    let digit = u8.toU64(s[n] - 48)
    if value > (u64.MAX - digit) / 10 { overflow = true } else { value = value * 10 + digit }
    digits = digits + 1
    n = n + 1
  }
  if digits == 0 { return 0 }
  pos.* = n
  if overflow { magnitude.* = u64.MAX return 2 }
  magnitude.* = value
  return 1
}
// sscanf("%llu"): true when a value was read. A value too large is ULLONG_MAX; a negative one wraps.
fn scanU64(s: &[u8], pos: &mut usize, out: &mut u64) -> bool {
  let mut magnitude: u64 = 0
  let mut negative = false
  let kind = scanDigits(s, &mut pos, &mut magnitude, &mut negative)
  if kind == 0 { return false }
  if kind == 1 && negative { magnitude = u64.wrappingSubtract(0, magnitude) }
  out.* = magnitude
  return true
}
// sscanf("%lld") and strtol: 0 for no value, 1 for a value, 2 for a value clamped to the range.
fn scanI64(s: &[u8], pos: &mut usize, out: &mut i64) -> i32 {
  let mut magnitude: u64 = 0
  let mut negative = false
  let kind = scanDigits(s, &mut pos, &mut magnitude, &mut negative)
  if kind == 0 { return 0 }
  if negative {
    if magnitude > 9223372036854775808 { out.* = i64.MIN return 2 }
    out.* = u64.wrappingToI64(u64.wrappingSubtract(0, magnitude))
    return kind
  }
  if magnitude > 9223372036854775807 { out.* = i64.MAX return 2 }
  out.* = u64.wrappingToI64(magnitude)
  return kind
}
// sscanf("%lf") by strtod, on a text that has a zero byte: true when a number was read.
unsafe fn scanF64(s: &[u8], pos: &mut usize, out: &mut f64) -> bool {
  if pos.* >= s.length { return false }
  let begin = Pointer.fromRef<u8>(&s[pos.*])
  let mut end: ?*const u8 = begin
  let value = unsafe strtod(begin, Pointer.fromMutRef<?*const u8>(&mut end))
  let used = Pointer.address<u8>(end) - Pointer.address<u8>(begin)
  if used == 0 { return false }
  pos.* = pos.* + used
  out.* = value
  return true
}

// snprintf("%s") at `at`: appends what fits before the last byte, ends the text with a zero byte,
// and returns the offset after it.
fn put(out: &mut [u8], at: usize, text: &[u8]) -> usize {
  let mut n = at
  let mut i: usize = 0
  while i < text.length && n + 1 < out.length { out[n] = text[i] n = n + 1 i = i + 1 }
  if n < out.length { out[n] = 0 }
  return n
}
// snprintf("%u").
fn putDecimal(out: &mut [u8], at: usize, value: u64) -> usize {
  let mut digits: [u8; 20] = [0; 20]
  let mut used: usize = 0
  let mut rest = value
  while true {
    digits[used] = u64.toU8(48 + rest % 10)
    used = used + 1
    rest = rest / 10
    if rest == 0 { break }
  }
  let mut n = at
  while used > 0 { used = used - 1 n = put(&mut out, n, Slice.view<u8>(&digits, used, 1)) }
  return n
}

// --- Files -------------------------------------------------------------------------------------

// uv__open_cloexec(path, O_RDONLY): a descriptor, or a negative errno.
unsafe fn openRead(path: &[u8]) -> i32 {
  let fd = unsafe open(cstr(path), READ_ONLY)
  if fd < 0 { return unsafe failure() }
  return fd
}
// read() that repeats after EINTR.
unsafe fn readSome(fd: i32, buffer: *mut u8, count: usize) -> isize {
  while true {
    let n = unsafe read(fd, buffer, count)
    if n >= 0 || unsafe errno() != EINTR { return n }
  }
  return -1
}
// uv__slurp: one read of at most the buffer less one byte, then a zero byte. Returns 0 or a
// negative errno. `path` ends with a zero byte.
unsafe fn slurp(path: &[u8], buffer: &mut [u8]) -> i32 {
  let fd = unsafe openRead(path)
  if fd < 0 { return fd }
  let n = unsafe readSome(fd, Pointer.fromMutRef<u8>(&mut buffer[0]), buffer.length - 1)
  let status = unsafe failure()
  let _closed = unsafe close(fd)
  if n < 0 { return status }
  buffer[isize.toUsize(n)] = 0
  return 0
}

static if Intrinsic.targetOperatingSystem() == "linux" {
  // A whole file, read to its end. `status` is 0, or the negative errno of the open (UV_ENOMEM
  // when there is no memory); a read error ends the text where it happened, as it ends a stdio stream.
  struct FileText { pointer: ?*mut u8, length: usize }
  impl Drop for FileText { fn drop(self: &mut Self) -> () { unsafe free(self.pointer) } }
  impl FileText {
    fn bytes<'a>(self: &'a Self) -> &'a [u8] {
      if Pointer.isNull<u8>(self.pointer) { return Slice.view<u8>(b"", 0, 0) }
      return unsafe Pointer.borrowMany<Self, u8>(&self, unsafe Pointer.assumeMany<u8>(unsafe presentMut(self.pointer)), self.length)
    }
  }
  unsafe fn readWhole(path: &[u8], status: &mut i32) -> FileText {
    let mut text = FileText { pointer: Pointer.null<u8>(), length: 0 }
    status.* = 0
    let fd = unsafe openRead(path)
    if fd < 0 { status.* = fd return move text }
    let mut capacity: usize = 16384
    text.pointer = unsafe calloc(1, capacity)
    while !Pointer.isNull<u8>(text.pointer) {
      let n = unsafe readSome(fd, unsafe offsetMut(unsafe presentMut(text.pointer), text.length), capacity - text.length)
      if n <= 0 { break }
      text.length = text.length + isize.toUsize(n)
      if text.length == capacity {
        let grown = unsafe calloc(1, capacity * 2)
        if !Pointer.isNull<u8>(grown) { unsafe copyBytes(unsafe presentMut(grown), text.pointer, text.length) }
        unsafe free(text.pointer)
        text.pointer = grown
        capacity = capacity * 2
      }
    }
    let _closed = unsafe close(fd)
    if Pointer.isNull<u8>(text.pointer) { text.length = 0 status.* = UV_ENOMEM }
    return move text
  }
  // The end of what fgets() would return from `pos` with a 1024-byte buffer: through the next
  // newline, or 1023 bytes, or the end of the text.
  fn chunkEnd(s: &[u8], pos: usize) -> usize {
    let mut n = pos
    while n < s.length && n - pos < 1023 { if s[n] == 10 { return n + 1 } n = n + 1 }
    return n
  }
}

// --- Version, errors, clock, threads -----------------------------------------------------------

/// The libuv version this module reproduces. It is a constant, not a query of a linked library:
/// process.versions.uv keeps reporting the release whose behaviour the runtime follows.
pub unsafe fn uv_version_string() -> *const u8 { return cstr(b"1.51.0\0") }

/// A libuv status for a system errno: negative errno on Unix. A value that is already negative or
/// zero is returned as it is.
pub unsafe fn uv_translate_sys_error(code: i32) -> i32 {
  if code <= 0 { return code }
  return 0 - code
}

/// Nanoseconds of a monotonic clock, from an arbitrary start. Linux: CLOCK_MONOTONIC, 0 if the
/// clock cannot be read. Darwin: mach_continuous_time() in the Mach timebase, as libuv.
pub unsafe fn uv_hrtime() -> u64 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    // libuv reads the timebase once (uv_once) and aborts if it cannot; it is kept here in a process
    // word as numerator << 32 | denominator, 0 until the first call.
    let word = timebaseWord()
    let mut cached = unsafe Atomic.load<u64>(word, MemoryOrder.Relaxed)
    if cached == 0 {
      let mut base: [u32; 2] = [0; 2]
      if unsafe mach_timebase_info(Pointer.fromMutRef<[u32; 2]>(&mut base)) != 0 || base[1] == 0 { return 0 }
      cached = u64.shiftLeft(u32.toU64(base[0]), 32) | u32.toU64(base[1])
      unsafe Atomic.store<u64>(word, cached, MemoryOrder.Relaxed)
    }
    return u64.wrappingMultiply(unsafe mach_continuous_time(), u64.shiftRight(cached, 32)) / (cached & 4294967295)
  } else {
    let mut now = Timespec { seconds: 0, nanoseconds: 0 }
    if unsafe clock_gettime(1, Pointer.fromMutRef<Timespec>(&mut now)) != 0 { return 0 }
    return u64.wrappingAdd(u64.wrappingMultiply(i64.wrappingToU64(now.seconds), 1000000000), i64.wrappingToU64(now.nanoseconds))
  }
}

/// Names the calling thread. The name is cut to 15 bytes on Linux and 63 on Darwin. Returns 0 or a
/// negative errno.
pub unsafe fn uv_thread_setname(name: *const u8) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    let mut copy: [u8; 64] = [0; 64]
    let mut n: usize = 0
    while n < 63 { let ch = unsafe byteAt(name, n) if ch == 0 { break } copy[n] = ch n = n + 1 }
    if unsafe pthread_setname_np(Pointer.fromRef<u8>(&copy[0])) != 0 { return unsafe failure() }
    return 0
  } else {
    let mut copy: [u8; 16] = [0; 16]
    let mut n: usize = 0
    while n < 15 { let ch = unsafe byteAt(name, n) if ch == 0 { break } copy[n] = ch n = n + 1 }
    // pthread_setname_np returns the error number.
    return 0 - unsafe pthread_setname_np(unsafe pthread_self(), Pointer.fromRef<u8>(&copy[0]))
  }
}

// --- Process -----------------------------------------------------------------------------------

/// The parent process id.
pub unsafe fn uv_os_getppid() -> i32 { return unsafe getppid() }

/// Stores the scheduling priority (nice value) of process `pid`; 0 is the calling process.
pub unsafe fn uv_os_getpriority(pid: i32, priority: *mut i32) -> i32 {
  // -1 is a valid priority, so errno tells an error apart.
  unsafe Pointer.write<i32>(unsafe errorSlot(), 0)
  let value = unsafe getpriority(0, i32.wrappingToU32(pid))
  if value == -1 && unsafe errno() != 0 { return unsafe failure() }
  unsafe Pointer.write<i32>(priority, value)
  return 0
}

/// Sets the scheduling priority of process `pid`. UV_EINVAL outside -20 through 19.
pub unsafe fn uv_os_setpriority(pid: i32, priority: i32) -> i32 {
  if priority < -20 || priority > 19 { return UV_EINVAL }
  if unsafe setpriority(0, i32.wrappingToU32(pid), priority) != 0 { return unsafe failure() }
  return 0
}

// getrusage into `uv_rusage_t`. `struct rusage` is two `struct timeval` and fourteen `long`: 18
// 8-byte slots. Darwin's tv_usec is the low 32 bits of its slot, and its ru_maxrss is in bytes.
unsafe fn resourceUsage(who: i32, usage: *mut Usage) -> i32 {
  let mut native: [i64; 18] = [0; 18]
  if unsafe getrusage(who, Pointer.fromMutRef<[i64; 18]>(&mut native)) != 0 { return unsafe failure() }
  let mut userMicro = native[1]
  let mut systemMicro = native[3]
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    userMicro = i32.toI64(i64.wrappingToI32(userMicro))
    systemMicro = i32.toI64(i64.wrappingToI32(systemMicro))
  }
  let mut counters: [u64; 14] = [0; 14]
  let mut n: usize = 0
  while n < 14 { counters[n] = i64.wrappingToU64(native[4 + n]) n = n + 1 }
  static if Intrinsic.targetOperatingSystem() == "darwin" { counters[0] = counters[0] / 1024 }
  unsafe Pointer.put<Usage>(usage, Usage { user: Timeval { sec: i64.toIsize(native[0]), usec: i64.toIsize(userMicro) }, system: Timeval { sec: i64.toIsize(native[2]), usec: i64.toIsize(systemMicro) }, counters: counters })
  return 0
}

/// The resource usage of the process (RUSAGE_SELF). ru_maxrss is in kilobytes.
pub unsafe fn uv_getrusage(usage: *mut Usage) -> i32 { return unsafe resourceUsage(0, usage) }

/// The resource usage of the calling thread. Linux: RUSAGE_THREAD. Darwin: the user and system
/// times of thread_info(THREAD_BASIC_INFO), with every counter zero; UV_EINVAL if that fails.
pub unsafe fn uv_getrusage_thread(usage: *mut Usage) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    // thread_basic_info: user_time and system_time, each seconds then microseconds, lead its
    // THREAD_BASIC_INFO_COUNT (10) integers.
    let mut info: [i32; 10] = [0; 10]
    let mut count: u32 = 10
    let thread = unsafe mach_thread_self()
    let status = unsafe thread_info(thread, 3, Pointer.fromMutRef<i32>(&mut info[0]), Pointer.fromMutRef<u32>(&mut count))
    let _released = unsafe mach_port_deallocate(taskSelf(), thread)
    if status != 0 { return UV_EINVAL }
    unsafe Pointer.put<Usage>(usage, Usage { user: Timeval { sec: i32.toIsize(info[0]), usec: i32.toIsize(info[1]) }, system: Timeval { sec: i32.toIsize(info[2]), usec: i32.toIsize(info[3]) }, counters: [0; 14] })
    return 0
  } else {
    return unsafe resourceUsage(1, usage)
  }
}

// --- Texts into caller buffers -----------------------------------------------------------------

// Copies the C string `text` and its zero byte to `buffer`, which holds `*size` bytes, and stores
// the length; UV_ENOBUFS with the needed capacity when it does not fit.
unsafe fn giveText(text: *const u8, buffer: *mut u8, size: *mut usize) -> i32 {
  let count = unsafe strlen(text)
  if count >= unsafe Pointer.read<usize>(size) {
    unsafe Pointer.write<usize>(size, count + 1)
    return UV_ENOBUFS
  }
  let _dest = unsafe memcpy(buffer, text, count + 1)
  unsafe Pointer.write<usize>(size, count)
  return 0
}

/// The host name. UV_EINVAL when `*size` is 0.
pub unsafe fn uv_os_gethostname(buffer: *mut u8, size: *mut usize) -> i32 {
  if unsafe Pointer.read<usize>(size) == 0 { return UV_EINVAL }
  // A buffer of the largest name, so that a short caller buffer is reported and not truncated.
  let mut name: [u8; 257] = [0; 257]
  if unsafe gethostname(Pointer.fromMutRef<u8>(&mut name[0]), HOSTNAME_SIZE) != 0 { return unsafe failure() }
  name[HOSTNAME_SIZE - 1] = 0
  return unsafe giveText(Pointer.fromRef<u8>(&name[0]), buffer, size)
}

/// The home directory: the HOME environment variable when it is set (also when empty), or else
/// the directory of the effective user in the password database.
pub unsafe fn uv_os_homedir(buffer: *mut u8, size: *mut usize) -> i32 {
  if unsafe Pointer.read<usize>(size) == 0 { return UV_EINVAL }
  let home = unsafe getenv(cstr(b"HOME\0"))
  if !Pointer.isNull<u8>(home) { return unsafe giveText(unsafe present(home), buffer, size) }
  let empty = cstr(b"\0")
  let mut info = Passwd { username: empty, uid: 0, gid: 0, shell: empty, homedir: empty }
  let status = unsafe uv_os_get_passwd(Pointer.fromMutRef<Passwd>(&mut info))
  if status != 0 { return status }
  let result = unsafe giveText(info.homedir, buffer, size)
  unsafe uv_os_free_passwd(Pointer.fromMutRef<Passwd>(&mut info))
  return result
}

/// The directory for temporary files: the first of TMPDIR, TMP, TEMP and TEMPDIR that is set, or
/// else /tmp, without one trailing slash (unless it is the whole text).
pub unsafe fn uv_os_tmpdir(buffer: *mut u8, size: *mut usize) -> i32 {
  if unsafe Pointer.read<usize>(size) == 0 { return UV_EINVAL }
  let mut found = unsafe getenv(cstr(b"TMPDIR\0"))
  if Pointer.isNull<u8>(found) { found = unsafe getenv(cstr(b"TMP\0")) }
  if Pointer.isNull<u8>(found) { found = unsafe getenv(cstr(b"TEMP\0")) }
  if Pointer.isNull<u8>(found) { found = unsafe getenv(cstr(b"TEMPDIR\0")) }
  let mut text = cstr(b"/tmp\0")
  if !Pointer.isNull<u8>(found) { text = unsafe present(found) }
  let mut count = unsafe strlen(text)
  // The capacity is checked before the slash is dropped, as libuv does.
  if count >= unsafe Pointer.read<usize>(size) {
    unsafe Pointer.write<usize>(size, count + 1)
    return UV_ENOBUFS
  }
  if count > 1 && unsafe byteAt(text, count - 1) == 47 { count = count - 1 }
  let _dest = unsafe memcpy(buffer, text, count)
  unsafe setByte(buffer, count, 0)
  unsafe Pointer.write<usize>(size, count)
  return 0
}

/// The path of the running executable. Linux: the target of /proc/self/exe, cut to `*size` - 1
/// bytes. Darwin: the real path of _NSGetExecutablePath, cut the same way. The length is stored.
pub unsafe fn uv_exepath(buffer: *mut u8, size: *mut usize) -> i32 {
  let capacity = unsafe Pointer.read<usize>(size)
  if capacity == 0 { return UV_EINVAL }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    // realpath may give more than PATH_MAX (1024), so libuv doubles the buffer.
    let mut absolute: [u8; 2049] = [0; 2049]
    let mut path: [u8; 1025] = [0; 1025]
    let mut pathSize: u32 = 1025
    if unsafe _NSGetExecutablePath(Pointer.fromMutRef<u8>(&mut path[0]), Pointer.fromMutRef<u32>(&mut pathSize)) != 0 { return UV_EIO }
    let resolved = unsafe realpath(Pointer.fromRef<u8>(&path[0]), Pointer.fromMutRef<u8>(&mut absolute[0]))
    if Pointer.isNull<u8>(resolved) { return unsafe failure() }
    let found = length(&absolute)
    if found == 0 { return UV_EIO }
    let mut count = capacity - 1
    if count > found { count = found }
    unsafe copyBytes(buffer, Pointer.fromRef<u8>(&absolute[0]), count)
    unsafe setByte(buffer, count, 0)
    unsafe Pointer.write<usize>(size, count)
    return 0
  } else {
    let mut count: isize = 0
    if capacity > 1 { count = unsafe readlink(cstr(b"/proc/self/exe\0"), buffer, capacity - 1) }
    if count < 0 { return unsafe failure() }
    unsafe setByte(buffer, isize.toUsize(count), 0)
    unsafe Pointer.write<usize>(size, isize.toUsize(count))
    return 0
  }
}

// uv__strscpy into a 256-byte field: the text and a zero byte, or UV_E2BIG after a cut text.
fn copyField(out: &mut [u8; 256], source: &[u8]) -> i32 {
  let mut n: usize = 0
  while n < 256 {
    let ch = at(source, n)
    out[n] = ch
    if ch == 0 { return 0 }
    n = n + 1
  }
  out[255] = 0
  return UV_E2BIG
}

/// The system name, release, version and machine of uname(). All four are empty after an error.
pub unsafe fn uv_os_uname(info: *mut Uname) -> i32 {
  let mut anchor = ()
  let out = unsafe Pointer.borrowMut<(), Uname>(&mut anchor, info)
  let mut native: [u8; UTS_SIZE] = [0; UTS_SIZE]
  let mut status: i32 = 0
  if unsafe uname(Pointer.fromMutRef<[u8; UTS_SIZE]>(&mut native)) == -1 { status = unsafe failure() }
  if status == 0 { status = copyField(&mut out.sysname, Slice.view<u8>(&native, 0, UTS_FIELD)) }
  if status == 0 { status = copyField(&mut out.release, Slice.view<u8>(&native, UTS_FIELD * 2, UTS_FIELD)) }
  if status == 0 { status = copyField(&mut out.version, Slice.view<u8>(&native, UTS_FIELD * 3, UTS_FIELD)) }
  if status == 0 { status = copyField(&mut out.machine, Slice.view<u8>(&native, UTS_FIELD * 4, UTS_FIELD)) }
  if status != 0 { out.sysname[0] = 0 out.release[0] = 0 out.version[0] = 0 out.machine[0] = 0 }
  return status
}

// --- The password database ---------------------------------------------------------------------

// uv__getpwuid_r: the entry of `uid`, with the name, home directory and shell in one allocation.
unsafe fn passwdOf(info: *mut Passwd, uid: u32) -> i32 {
  let mut capacity: usize = 2000
  while true {
    let scratch = UvMemory { pointer: unsafe uvMalloc(capacity) }
    if Pointer.isNull<u8>(scratch.pointer) { return UV_ENOMEM }
    let mut record: [?*mut u8; 10] = [Pointer.null<u8>(); 10]
    let mut result: ?*mut u8 = Pointer.null<u8>()
    let mut status = EINTR
    while status == EINTR {
      status = unsafe getpwuid_r(uid, Pointer.fromMutRef<[?*mut u8; 10]>(&mut record), unsafe presentMut(scratch.pointer), capacity, Pointer.fromMutRef<?*mut u8>(&mut result))
    }
    if status == ERANGE { capacity = capacity * 2 continue }
    if status != 0 { return 0 - status }
    if Pointer.isNull<u8>(result) { return UV_ENOENT }
    let mut homeSlot: usize = 4
    static if Intrinsic.targetOperatingSystem() == "darwin" { homeSlot = 6 }
    // The texts point into `scratch`.
    let name: ?*const u8 = record[0]
    let home: ?*const u8 = record[homeSlot]
    let shell: ?*const u8 = record[homeSlot + 1]
    let ids = Pointer.address<u8>(record[2])
    let nameSize = unsafe textLength(name) + 1
    let homeSize = unsafe textLength(home) + 1
    let shellSize = unsafe textLength(shell) + 1
    let block = unsafe uvMalloc(nameSize + homeSize + shellSize)
    if Pointer.isNull<u8>(block) { return UV_ENOMEM }
    let base = unsafe presentMut(block)
    unsafe copyBytes(base, name, nameSize - 1)
    unsafe setByte(base, nameSize - 1, 0)
    unsafe copyBytes(unsafe offsetMut(base, nameSize), home, homeSize - 1)
    unsafe setByte(base, nameSize + homeSize - 1, 0)
    unsafe copyBytes(unsafe offsetMut(base, nameSize + homeSize), shell, shellSize - 1)
    unsafe setByte(base, nameSize + homeSize + shellSize - 1, 0)
    unsafe Pointer.put<Passwd>(info, Passwd { username: base, uid: ids & 4294967295, gid: usize.shiftRight(ids, 32), shell: unsafe offsetMut(base, nameSize + homeSize), homedir: unsafe offsetMut(base, nameSize) })
    return 0
  }
  return UV_ENOENT
}

/// The password database entry of the effective user. UV_ENOENT when there is none. Release the
/// result with [`uv_os_free_passwd`].
pub unsafe fn uv_os_get_passwd(info: *mut Passwd) -> i32 { return unsafe passwdOf(info, unsafe geteuid()) }

/// The password database entry of user `uid`. UV_ENOENT when there is none. Release the result
/// with [`uv_os_free_passwd`].
pub unsafe fn uv_os_get_passwd2(info: *mut Passwd, uid: u32) -> i32 { return unsafe passwdOf(info, uid) }

/// Frees the texts of a filled `info` and clears its three pointers.
pub unsafe fn uv_os_free_passwd(info: *mut Passwd) -> () {
  // The five fields are 8-byte slots; username (0) owns the allocation, shell is 3 and homedir 4.
  let slots = unsafe Pointer.assumeManyMut<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut Passwd, *mut ?*mut u8>(info))
  unsafe uvFree(unsafe Pointer.read<?*mut u8>(unsafe Pointer.at<?*mut u8>(slots, 0)))
  unsafe Pointer.write<?*mut u8>(unsafe Pointer.atMut<?*mut u8>(slots, 0), Pointer.null<u8>())
  unsafe Pointer.write<?*mut u8>(unsafe Pointer.atMut<?*mut u8>(slots, 3), Pointer.null<u8>())
  unsafe Pointer.write<?*mut u8>(unsafe Pointer.atMut<?*mut u8>(slots, 4), Pointer.null<u8>())
}

// --- The group database ------------------------------------------------------------------------

unsafe fn pointerAt(table: *const ?*const u8, index: usize) -> ?*const u8 {
  return unsafe Pointer.read<?*const u8>(unsafe Pointer.at<?*const u8>(unsafe Pointer.assumeMany<?*const u8>(table), index))
}

/// The group database entry of `gid`: its name, its id, and its members, in one allocation that
/// starts at `members` (libuv src/unix/core.c). UV_ENOENT when there is none. Release the result
/// with [`uv_os_free_group`].
pub unsafe fn uv_os_get_group(info: *mut Group, gid: u32) -> i32 {
  let mut capacity: usize = 2000
  while true {
    let scratch = UvMemory { pointer: unsafe uvMalloc(capacity) }
    if Pointer.isNull<u8>(scratch.pointer) { return UV_ENOMEM }
    let mut record: [?*mut u8; 4] = [Pointer.null<u8>(); 4]
    let mut result: ?*mut u8 = Pointer.null<u8>()
    let mut status = EINTR
    while status == EINTR {
      status = unsafe getgrgid_r(gid, Pointer.fromMutRef<[?*mut u8; 4]>(&mut record), unsafe presentMut(scratch.pointer), capacity, Pointer.fromMutRef<?*mut u8>(&mut result))
    }
    if status == ERANGE { capacity = capacity * 2 continue }
    if status != 0 { return 0 - status }
    if Pointer.isNull<u8>(result) { return UV_ENOENT }
    // The texts and the member table point into `scratch`.
    let name: ?*const u8 = record[0]
    let id = Pointer.address<u8>(record[2]) & 4294967295
    let table = unsafe Intrinsic.pointerRequalify<?*mut ?*const u8, ?*const ?*const u8>(unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut ?*const u8>(record[3]))
    let nameSize = unsafe textLength(name) + 1
    let mut members: usize = 0
    let mut memberBytes: usize = 8
    if !Pointer.isNull<?*const u8>(table) {
      let present = unsafe Intrinsic.pointerRequalify<?*const ?*const u8, *const ?*const u8>(table)
      while !Pointer.isNull<u8>(unsafe pointerAt(present, members)) {
        memberBytes = memberBytes + unsafe textLength(unsafe pointerAt(present, members)) + 1 + 8
        members = members + 1
      }
    }
    let block = unsafe uvMalloc(nameSize + memberBytes)
    if Pointer.isNull<u8>(block) { return UV_ENOMEM }
    let base = unsafe presentMut(block)
    let slots = unsafe Pointer.assumeManyMut<?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(base))
    unsafe Pointer.write<?*mut u8>(unsafe Pointer.atMut<?*mut u8>(slots, members), Pointer.null<u8>())
    let mut at = (members + 1) * 8
    let mut index: usize = 0
    while index < members {
      let member = unsafe pointerAt(unsafe Intrinsic.pointerRequalify<?*const ?*const u8, *const ?*const u8>(table), index)
      let size = unsafe textLength(member) + 1
      let copy = unsafe offsetMut(base, at)
      unsafe copyBytes(copy, member, size - 1)
      unsafe setByte(copy, size - 1, 0)
      unsafe Pointer.write<?*mut u8>(unsafe Pointer.atMut<?*mut u8>(slots, index), copy)
      at = at + size
      index = index + 1
    }
    let groupname = unsafe offsetMut(base, at)
    unsafe copyBytes(groupname, name, nameSize - 1)
    unsafe setByte(groupname, nameSize - 1, 0)
    unsafe Pointer.put<Group>(info, Group { groupname: groupname, gid: id, members: unsafe Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(base) })
    return 0
  }
  return UV_ENOENT
}

/// Frees what [`uv_os_get_group`] stored and clears the two pointers. Null is allowed.
pub unsafe fn uv_os_free_group(info: ?*mut Group) -> () {
  if Pointer.isNull<Group>(info) { return () }
  let mut anchor = ()
  let out = unsafe Pointer.borrowMut<(), Group>(&mut anchor, unsafe Intrinsic.pointerRequalify<?*mut Group, *mut Group>(info))
  unsafe uvFree(unsafe Intrinsic.pointerReinterpret<?*mut ?*mut u8, ?*mut u8>(out.members))
  out.members = Pointer.null<?*mut u8>()
  out.groupname = Pointer.null<u8>()
}

// --- The environment ---------------------------------------------------------------------------

static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn _NSGetEnviron() -> *mut *const ?*const u8
  unsafe fn environment() -> *const ?*const u8 { return unsafe Pointer.read<*const ?*const u8>(unsafe _NSGetEnviron()) }
} else {
  unsafe extern "C" static environ: *const ?*const u8
  unsafe fn environment() -> *const ?*const u8 { unsafe { return environ } }
}

/// The variables of the environment as name and value pairs, in the order of `environ`; an
/// entry without `=` is left out. Each name and its value are one allocation. Release the result
/// with [`uv_os_free_environ`].
pub unsafe fn uv_os_environ(items: *mut ?*mut EnvItem, count: *mut i32) -> i32 {
  unsafe Pointer.write<?*mut EnvItem>(items, Pointer.null<EnvItem>())
  unsafe Pointer.write<i32>(count, 0)
  let table = unsafe environment()
  let mut total: usize = 0
  while !Pointer.isNull<u8>(unsafe pointerAt(table, total)) { total = total + 1 }
  let block = unsafe uvCalloc(total, Layout.of<EnvItem>().bytes)
  if Pointer.isNull<u8>(block) { return UV_ENOMEM }
  let entries = unsafe Pointer.assumeManyMut<EnvItem>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut EnvItem>(unsafe presentMut(block)))
  let mut used: usize = 0
  let mut index: usize = 0
  while index < total {
    let entry = unsafe pointerAt(table, index)
    index = index + 1
    if Pointer.isNull<u8>(entry) { break }
    let copy = unsafe uvStrdup(unsafe present(entry))
    if Pointer.isNull<u8>(copy) {
      // libuv's failure path frees the entry at `used`, which calloc left empty, `used` times.
      let mut n: usize = 0
      while n < used {
        let mut anchor = ()
        let item = unsafe Pointer.borrowMut<(), EnvItem>(&mut anchor, unsafe Pointer.atMut<EnvItem>(entries, used))
        unsafe uvFree(item.name)
        n = n + 1
      }
      unsafe uvFree(block)
      unsafe Pointer.write<?*mut EnvItem>(items, Pointer.null<EnvItem>())
      unsafe Pointer.write<i32>(count, 0)
      return UV_ENOMEM
    }
    let text = unsafe presentMut(copy)
    let mut n: usize = 0
    while unsafe byteAt(text, n) != 0 && unsafe byteAt(text, n) != 61 { n = n + 1 }
    if unsafe byteAt(text, n) == 0 { unsafe uvFree(copy) continue }
    unsafe setByte(text, n, 0)
    unsafe Pointer.put<EnvItem>(unsafe Pointer.atMut<EnvItem>(entries, used), EnvItem { name: text, value: unsafe offsetMut(text, n + 1) })
    used = used + 1
  }
  unsafe Pointer.write<?*mut EnvItem>(items, unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut EnvItem>(block))
  unsafe Pointer.write<i32>(count, usize.toI32(used))
  return 0
}

/// Frees what [`uv_os_environ`] stored: the first `count` names, then the array.
pub unsafe fn uv_os_free_environ(items: ?*mut EnvItem, count: i32) -> () {
  let mut index: i32 = 0
  while index < count {
    let entries = unsafe Pointer.assumeManyMut<EnvItem>(unsafe Intrinsic.pointerRequalify<?*mut EnvItem, *mut EnvItem>(items))
    let mut anchor = ()
    let item = unsafe Pointer.borrowMut<(), EnvItem>(&mut anchor, unsafe Pointer.atMut<EnvItem>(entries, i32.toUsize(index)))
    unsafe uvFree(item.name)
    index = index + 1
  }
  unsafe uvFree(unsafe Intrinsic.pointerReinterpret<?*mut EnvItem, ?*mut u8>(items))
}

// --- Network interfaces ------------------------------------------------------------------------

// sa_family of a `struct sockaddr`. Darwin keeps a length byte first.
unsafe fn family(address: *const u8) -> u32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return u8.toU32(unsafe byteAt(address, 1))
  } else {
    return u8.toU32(unsafe byteAt(address, 0)) | u32.shiftLeft(u8.toU32(unsafe byteAt(address, 1)), 8)
  }
}
// uv__ifaddr_exclude: an entry counts when the interface is up and running and has an address;
// `physical` selects the link-layer entries (the hardware addresses) and not the others.
unsafe fn excluded(entry: &IfAddrs, physical: bool) -> bool {
  if (entry.flags & IFF_UP) == 0 || (entry.flags & IFF_RUNNING) == 0 { return true }
  if Pointer.isNull<u8>(entry.address) { return true }
  let kind = unsafe family(unsafe present(entry.address))
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return (kind == AF_LINK) != physical
  } else {
    return (kind == AF_PACKET) != physical
  }
}
// Whether interface `name` takes the hardware address of the link-layer entry `link`. Linux: an
// alias `link:label` shares it.
unsafe fn sameInterface(name: *const u8, link: *const u8) -> bool {
  let mut n: usize = 0
  while true {
    let a = unsafe byteAt(name, n)
    let b = unsafe byteAt(link, n)
    if b == 0 {
      static if Intrinsic.targetOperatingSystem() == "darwin" { return a == 0 } else { return a == 0 || a == 58 }
    }
    if a != b { return false }
    n = n + 1
  }
  return false
}

/// The addresses of the interfaces that are up and running: one entry per IPv4 or IPv6 address,
/// with its netmask, the hardware address of its interface, and whether it is a loopback. Stores
/// an array of `*count` entries, or null and 0 when there is none. Release it with
/// [`uv_free_interface_addresses`].
pub unsafe fn uv_interface_addresses(addresses: *mut ?*mut Interface, count: *mut i32) -> i32 {
  unsafe Pointer.write<i32>(count, 0)
  unsafe Pointer.write<?*mut Interface>(addresses, Pointer.null<Interface>())
  let mut head: ?*mut IfAddrs = Pointer.null<IfAddrs>()
  if unsafe getifaddrs(Pointer.fromMutRef<?*mut IfAddrs>(&mut head)) != 0 { return unsafe failure() }
  // Count the entries and the bytes of their names.
  let mut total: usize = 0
  let mut names: usize = 0
  let mut cursor = head
  while !Pointer.isNull<IfAddrs>(cursor) {
    let entry = unsafe Pointer.read<IfAddrs>(unsafe Intrinsic.pointerRequalify<?*mut IfAddrs, *mut IfAddrs>(cursor))
    cursor = entry.next
    if unsafe excluded(&entry, false) { continue }
    names = names + unsafe textLength(entry.name) + 1
    total = total + 1
  }
  if total == 0 { unsafe freeifaddrs(head) return 0 }
  // One zeroed block: the entries, then the names.
  let size = Layout.of<Interface>().bytes
  let block = unsafe uvCalloc(1, total * size + names)
  if Pointer.isNull<u8>(block) { unsafe freeifaddrs(head) return UV_ENOMEM }
  let base = unsafe presentMut(block)
  let entries = unsafe Pointer.assumeManyMut<Interface>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Interface>(base))
  let mut nameAt = total * size
  let mut index: usize = 0
  cursor = head
  while !Pointer.isNull<IfAddrs>(cursor) {
    let entry = unsafe Pointer.read<IfAddrs>(unsafe Intrinsic.pointerRequalify<?*mut IfAddrs, *mut IfAddrs>(cursor))
    cursor = entry.next
    if unsafe excluded(&entry, false) { continue }
    let nameSize = unsafe textLength(entry.name) + 1
    let name = unsafe offsetMut(base, nameAt)
    unsafe copyBytes(name, entry.name, nameSize - 1)
    nameAt = nameAt + nameSize
    let mut internal: i32 = 0
    if (entry.flags & IFF_LOOPBACK) != 0 { internal = 1 }
    unsafe Pointer.put<Interface>(unsafe Pointer.atMut<Interface>(entries, index), Interface { name: name, mac: [0; 6], internal: internal, address: [0; 7], mask: [0; 7] })
    let mut anchor = ()
    let out = unsafe Pointer.borrowMut<(), Interface>(&mut anchor, unsafe Pointer.atMut<Interface>(entries, index))
    // A sockaddr_in6 is copied whole; anything else as a sockaddr_in.
    let address = unsafe present(entry.address)
    let mut bytes: usize = 16
    if unsafe family(address) == AF_INET6 { bytes = 28 }
    unsafe copyBytes(unsafe Intrinsic.pointerReinterpret<*mut u32, *mut u8>(Pointer.fromMutRef<u32>(&mut out.address[0])), address, bytes)
    // A missing netmask stays zero.
    if !Pointer.isNull<u8>(entry.netmask) {
      bytes = 16
      if unsafe family(unsafe present(entry.netmask)) == AF_INET6 { bytes = 28 }
      unsafe copyBytes(unsafe Intrinsic.pointerReinterpret<*mut u32, *mut u8>(Pointer.fromMutRef<u32>(&mut out.mask[0])), entry.netmask, bytes)
    }
    index = index + 1
  }
  // The hardware address of each interface, from its link-layer entry.
  cursor = head
  while !Pointer.isNull<IfAddrs>(cursor) {
    let entry = unsafe Pointer.read<IfAddrs>(unsafe Intrinsic.pointerRequalify<?*mut IfAddrs, *mut IfAddrs>(cursor))
    cursor = entry.next
    if unsafe excluded(&entry, true) || Pointer.isNull<u8>(entry.name) { continue }
    let link = unsafe present(entry.address)
    // Linux `struct sockaddr_ll`: sll_addr is at offset 12. Darwin `struct sockaddr_dl`: LLADDR is
    // sdl_data (offset 8) after the sdl_nlen (offset 5) bytes of the name.
    let mut start: usize = 12
    static if Intrinsic.targetOperatingSystem() == "darwin" { start = 8 + u8.toUsize(unsafe byteAt(link, 5)) }
    index = 0
    while index < total {
      let mut anchor = ()
      let out = unsafe Pointer.borrowMut<(), Interface>(&mut anchor, unsafe Pointer.atMut<Interface>(entries, index))
      if unsafe sameInterface(out.name, unsafe present(entry.name)) {
        let mut n: usize = 0
        while n < 6 { out.mac[n] = unsafe byteAt(link, start + n) n = n + 1 }
      }
      index = index + 1
    }
  }
  unsafe freeifaddrs(head)
  unsafe Pointer.write<i32>(count, usize.toI32(total))
  unsafe Pointer.write<?*mut Interface>(addresses, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Interface>(base))
  return 0
}

/// Frees the array that [`uv_interface_addresses`] stored; null is allowed.
pub unsafe fn uv_free_interface_addresses(addresses: ?*mut Interface, count: i32) -> () {
  unsafe uvFree(unsafe Intrinsic.pointerReinterpret<?*mut Interface, ?*mut u8>(addresses))
}

// --- Processors, memory, load: Linux -----------------------------------------------------------

static if Intrinsic.targetOperatingSystem() == "linux" {
  // The line of /proc/cpuinfo that names the model, and for arm64 the names of the part codes.
  static if Intrinsic.targetArchitecture() == "aarch64" {
    const MODEL_MARKER: &[u8] = b"CPU part\t: "
    const PARTS: &[u8] = b"0x811\nARM810\n0x920\nARM920\n0x922\nARM922\n0x926\nARM926\n0x940\nARM940\n0x946\nARM946\n0x966\nARM966\n0xa20\nARM1020\n0xa22\nARM1022\n0xa26\nARM1026\n0xb02\nARM11 MPCore\n0xb36\nARM1136\n0xb56\nARM1156\n0xb76\nARM1176\n0xc05\nCortex-A5\n0xc07\nCortex-A7\n0xc08\nCortex-A8\n0xc09\nCortex-A9\n0xc0d\nCortex-A17\n0xc0f\nCortex-A15\n0xc0e\nCortex-A17\n0xc14\nCortex-R4\n0xc15\nCortex-R5\n0xc17\nCortex-R7\n0xc18\nCortex-R8\n0xc20\nCortex-M0\n0xc21\nCortex-M1\n0xc23\nCortex-M3\n0xc24\nCortex-M4\n0xc27\nCortex-M7\n0xc60\nCortex-M0+\n0xd01\nCortex-A32\n0xd03\nCortex-A53\n0xd04\nCortex-A35\n0xd05\nCortex-A55\n0xd06\nCortex-A65\n0xd07\nCortex-A57\n0xd08\nCortex-A72\n0xd09\nCortex-A73\n0xd0a\nCortex-A75\n0xd0b\nCortex-A76\n0xd0c\nNeoverse-N1\n0xd0d\nCortex-A77\n0xd0e\nCortex-A76AE\n0xd13\nCortex-R52\n0xd20\nCortex-M23\n0xd21\nCortex-M33\n0xd41\nCortex-A78\n0xd42\nCortex-A78AE\n0xd4a\nNeoverse-E1\n0xd4b\nCortex-A78C\n"
  } else {
    const MODEL_MARKER: &[u8] = b"model name\t: "
    const PARTS: &[u8] = b""
  }
  // The kernel's largest processor count, and the slots of one processor in the working table:
  // frequency, user, nice, system, idle, interrupt, model index.
  const MAX_CPUS: usize = 8192
  const SLOTS: usize = 7

  unsafe fn slot(table: [*]mut u64, cpu: usize, field: usize) -> *mut u64 { return unsafe Pointer.atMut<u64>(table, cpu * SLOTS + field) }

  // The model text of a /proc/cpuinfo line: `line` from the end of the marker to the end of the
  // fgets chunk. arm64 has a part code there, which the table turns into a name.
  fn modelText<'a>(line: &'a [u8]) -> &'a [u8] {
    let count = lineSpan(line, 0)
    if PARTS.length == 0 { return part(line, 0, count) }
    // memmem(parts, p, n + 1): the code and its newline.
    let mut n: usize = 0
    while count < line.length && n + count + 1 <= PARTS.length {
      if startsWith(PARTS, n, part(line, 0, count + 1)) { return part(PARTS, n + count + 1, lineSpan(PARTS, n + count + 1)) }
      n = n + 1
    }
    return b"unknown"
  }

  /// One entry per online processor: the model name of /proc/cpuinfo, the current frequency of
  /// cpufreq in MHz (0 when the kernel does not report one), and the times of /proc/stat in
  /// milliseconds. Stores the array and its length; release it with [`uv_free_cpu_info`].
  pub unsafe fn uv_cpu_info(cpus: *mut ?*mut Cpu, count: *mut i32) -> i32 {
    let working = UvMemory { pointer: unsafe uvCalloc(MAX_CPUS * SLOTS, 8) }
    if Pointer.isNull<u8>(working.pointer) { return UV_ENOMEM }
    let table = unsafe Pointer.assumeManyMut<u64>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut u64>(unsafe presentMut(working.pointer)))
    let mut bitmap: [u8; 1024] = [0; 1024]
    // Eight names of 64 bytes. libuv expects a handful of different models at most.
    let mut models: [u8; 512] = [0; 512]
    let _first = put(&mut models, 0, b"unknown")
    let mut maxCpu: usize = 0

    let mut status: i32 = 0
    let statFile = unsafe readWhole(b"/proc/stat\0", &mut status)
    if status != 0 { return status }
    let stat = statFile.bytes()
    // The first line is the total. Then one line per processor: "cpu%u" and the user, nice,
    // system, idle, iowait and irq ticks.
    let mut pos = chunkEnd(stat, 0)
    while startsWith(stat, pos, b"cpu") {
      let mut n = pos + 3
      let mut values: [u64; 7] = [0; 7]
      let mut read: usize = 0
      while read < 7 && scanU64(stat, &mut n, &mut values[read]) { read = read + 1 }
      if read != 7 { break }
      pos = chunkEnd(stat, n)
      // %u keeps the low 32 bits.
      let cpu = u64.toUsize(values[0] & 4294967295)
      if cpu >= MAX_CPUS { continue }
      unsafe Pointer.write<u64>(unsafe slot(table, cpu, 1), values[1])
      unsafe Pointer.write<u64>(unsafe slot(table, cpu, 2), values[2])
      unsafe Pointer.write<u64>(unsafe slot(table, cpu, 3), values[3])
      unsafe Pointer.write<u64>(unsafe slot(table, cpu, 4), values[4])
      unsafe Pointer.write<u64>(unsafe slot(table, cpu, 5), values[6])
      bitmap[cpu / 8] = bitmap[cpu / 8] | u8.shiftLeft(1, usize.toU8(cpu % 8))
      if cpu >= maxCpu { maxCpu = cpu + 1 }
    }

    // A missing /proc/cpuinfo leaves every model "unknown".
    let infoFile = unsafe readWhole(b"/proc/cpuinfo\0", &mut status)
    let info = infoFile.bytes()
    pos = 0
    while true {
      // fscanf("processor\t: %u\n").
      if !startsWith(info, pos, b"processor") { break }
      let mut n = skipSpace(info, pos + 9)
      if at(info, n) != 58 { break }
      n = n + 1
      let mut number: u64 = 0
      if !scanU64(info, &mut n, &mut number) { break }
      pos = skipSpace(info, n)
      let cpu = u64.toUsize(number & 4294967295)
      // The next line that starts with the marker, wherever it is.
      let mut found = false
      let mut lineStart: usize = 0
      while pos < info.length {
        let end = chunkEnd(info, pos)
        if startsWith(part(info, pos, end - pos), 0, MODEL_MARKER) {
          lineStart = pos + MODEL_MARKER.length
          found = true
        }
        pos = end
        if found { break }
      }
      if found {
        let text = modelText(part(info, lineStart, pos - lineStart))
        // libuv looks for the first name that starts the text, where an unused (empty) name starts
        // every text, and then takes the name after that one, filling it if it is unused. So the
        // first processor's model lands in the third name, and a later processor shares it whatever
        // its own model is (unless a text starts with "unknown", which moves on by one name).
        let mut k: usize = 0
        let mut matched = false
        while !matched && k < 8 {
          matched = startsWith(text, 0, part(&models, k * 64, length(part(&models, k * 64, 64))))
          k = k + 1
        }
        if matched && k < 8 {
          if models[k * 64] == 0 {
            let mut i: usize = 0
            while i < 63 && i < text.length && text[i] != 0 && text[i] != 10 { models[k * 64 + i] = text[i] i = i + 1 }
          }
          if cpu < maxCpu { unsafe Pointer.write<u64>(unsafe slot(table, cpu, 6), usize.toU64(k)) }
        }
      }
      // Skip to the line after the next empty line.
      while pos < info.length {
        let begin = pos
        pos = chunkEnd(info, pos)
        if info[begin] == 10 { break }
      }
    }

    // The current frequency in kHz, where cpufreq has one.
    let mut online: usize = 0
    let mut cpu: usize = 0
    while cpu < maxCpu {
      if (bitmap[cpu / 8] & u8.shiftLeft(1, usize.toU8(cpu % 8))) != 0 {
        online = online + 1
        let mut path: [u8; 96] = [0; 96]
        let mut n = put(&mut path, 0, b"/sys/devices/system/cpu/cpu")
        n = putDecimal(&mut path, n, usize.toU64(cpu))
        let _end = put(&mut path, n, b"/cpufreq/scaling_cur_freq")
        let mut value: [u8; 64] = [0; 64]
        if unsafe slurp(&path, &mut value) == 0 {
          let mut at: usize = 0
          let mut frequency: u64 = 0
          if scanU64(&value, &mut at, &mut frequency) { unsafe Pointer.write<u64>(unsafe slot(table, cpu, 0), frequency) }
        }
      }
      cpu = cpu + 1
    }

    // One block: the entries, then the eight names that their `model` fields point into.
    let size = Layout.of<Cpu>().bytes
    unsafe Pointer.write<i32>(count, 0)
    let block = unsafe uvCalloc(1, online * size + 512)
    unsafe Pointer.write<?*mut Cpu>(cpus, unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut Cpu>(block))
    if Pointer.isNull<u8>(block) { return UV_ENOMEM }
    let base = unsafe presentMut(block)
    let names = unsafe offsetMut(base, online * size)
    unsafe copyBytes(names, Pointer.fromRef<u8>(&models[0]), 512)
    let entries = unsafe Pointer.assumeManyMut<Cpu>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Cpu>(base))
    let mut index: usize = 0
    cpu = 0
    while cpu < maxCpu {
      if (bitmap[cpu / 8] & u8.shiftLeft(1, usize.toU8(cpu % 8))) != 0 {
        let model = u64.toUsize(unsafe Pointer.read<u64>(unsafe slot(table, cpu, 6)))
        // sysconf(_SC_CLK_TCK) is fixed at 100 on Linux, so a tick is 10 milliseconds.
        unsafe Pointer.put<Cpu>(unsafe Pointer.atMut<Cpu>(entries, index), Cpu {
          model: unsafe offsetMut(names, model * 64),
          speed: u64.wrappingToI32(unsafe Pointer.read<u64>(unsafe slot(table, cpu, 0)) / 1000),
          times: CpuTimes {
            user: u64.wrappingMultiply(10, unsafe Pointer.read<u64>(unsafe slot(table, cpu, 1))),
            nice: u64.wrappingMultiply(10, unsafe Pointer.read<u64>(unsafe slot(table, cpu, 2))),
            sys: u64.wrappingMultiply(10, unsafe Pointer.read<u64>(unsafe slot(table, cpu, 3))),
            idle: u64.wrappingMultiply(10, unsafe Pointer.read<u64>(unsafe slot(table, cpu, 4))),
            irq: u64.wrappingMultiply(10, unsafe Pointer.read<u64>(unsafe slot(table, cpu, 5))),
          },
        })
        index = index + 1
      }
      cpu = cpu + 1
    }
    unsafe Pointer.write<i32>(count, usize.toI32(online))
    return 0
  }

  /// Frees the array that [`uv_cpu_info`] stored. The model names are part of the same block.
  pub unsafe fn uv_free_cpu_info(cpus: ?*mut Cpu, count: i32) -> () {
    unsafe uvFree(unsafe Intrinsic.pointerReinterpret<?*mut Cpu, ?*mut u8>(cpus))
  }

  // The kilobytes after `what` in /proc/meminfo, in bytes; 0 when the file or the key is missing.
  unsafe fn meminfo(what: &[u8]) -> u64 {
    let mut buffer: [u8; 4096] = [0; 4096]
    if unsafe slurp(b"/proc/meminfo\0", &mut buffer) != 0 { return 0 }
    let found = find(&buffer, 0, what)
    if found == NONE { return 0 }
    let mut pos = found + what.length
    let mut value: u64 = 0
    let _read = scanU64(&buffer, &mut pos, &mut value)
    return u64.wrappingMultiply(value, 1024)
  }

  /// The memory that is available without swapping, in bytes: MemAvailable of /proc/meminfo, or
  /// else the free memory of sysinfo(), or else 0.
  pub unsafe fn uv_get_free_memory() -> u64 {
    let available = unsafe meminfo(b"MemAvailable:")
    if available != 0 { return available }
    let mut info: [u64; 14] = [0; 14]
    if unsafe sysinfo(Pointer.fromMutRef<[u64; 14]>(&mut info)) == 0 { return u64.wrappingMultiply(info[5], info[13] & 4294967295) }
    return 0
  }

  /// The physical memory in bytes: MemTotal of /proc/meminfo, or else that of sysinfo(), or else 0.
  pub unsafe fn uv_get_total_memory() -> u64 {
    let total = unsafe meminfo(b"MemTotal:")
    if total != 0 { return total }
    let mut info: [u64; 14] = [0; 14]
    if unsafe sysinfo(Pointer.fromMutRef<[u64; 14]>(&mut info)) == 0 { return u64.wrappingMultiply(info[4], info[13] & 4294967295) }
    return 0
  }

  // uv__read_uint64: the number in a small file, the largest value for "max", or 0.
  unsafe fn readNumber(path: &[u8]) -> u64 {
    let mut buffer: [u8; 32] = [0; 32]
    let mut value: u64 = 0
    if unsafe slurp(path, &mut buffer) == 0 {
      let mut pos: usize = 0
      if !scanU64(&buffer, &mut pos, &mut value) && same(&buffer, b"max\n") { value = u64.MAX }
    }
    return value
  }

  // The path of the memory controller in a cgroup v1 /proc/self/cgroup, without its leading
  // slash: the index after ":memory:/" with the length in `count`, or NONE.
  fn cgroup1Memory(cgroup: &[u8], count: &mut usize) -> usize {
    let mut p = findByte(cgroup, 0, 58)
    while p != NONE && !startsWith(cgroup, p, b":memory:") {
      p = findByte(cgroup, p, 10)
      if p != NONE { p = findByte(cgroup, p, 58) }
    }
    if p == NONE { return NONE }
    p = p + 9
    count.* = lineSpan(cgroup, p)
    return p
  }

  // A file of the cgroup at `cgroup[from..from + count]` under `root` (which ends with a slash).
  unsafe fn cgroupNumber(root: &[u8], cgroup: &[u8], from: usize, count: usize, file: &[u8]) -> u64 {
    let mut path: [u8; 4097] = [0; 4097]
    let mut n = put(&mut path, 0, root)
    n = put(&mut path, n, part(cgroup, from, count))
    let _end = put(&mut path, n, file)
    return unsafe readNumber(&path)
  }

  // The lower of the soft and hard memory limits of the cgroup, where the largest value means
  // unlimited; 0 when either cannot be read.
  unsafe fn cgroupConstrainedMemory(cgroup: &[u8]) -> u64 {
    let mut high: u64 = 0
    let mut max: u64 = 0
    // cgroup v2 has the single entry "0::/path".
    if startsWith(cgroup, 0, b"0::/") {
      let count = lineSpan(cgroup, 4)
      max = unsafe cgroupNumber(b"/sys/fs/cgroup/", cgroup, 4, count, b"/memory.max")
      high = unsafe cgroupNumber(b"/sys/fs/cgroup/", cgroup, 4, count, b"/memory.high")
    } else {
      let mut count: usize = 0
      let p = cgroup1Memory(cgroup, &mut count)
      if p != NONE {
        high = unsafe cgroupNumber(b"/sys/fs/cgroup/memory/", cgroup, p, count, b"/memory.soft_limit_in_bytes")
        max = unsafe cgroupNumber(b"/sys/fs/cgroup/memory/", cgroup, p, count, b"/memory.limit_in_bytes")
      }
      // Without a mounted controller of its own, the limits of the global one.
      if p == NONE || high == 0 || max == 0 {
        high = unsafe readNumber(b"/sys/fs/cgroup/memory/memory.soft_limit_in_bytes\0")
        max = unsafe readNumber(b"/sys/fs/cgroup/memory/memory.limit_in_bytes\0")
      }
      // cgroup v1 writes "unlimited" as LONG_MAX rounded down to a page.
      let unlimited = 9223372036854775807 & u64.bitNot(pageSize() - 1)
      if high == unlimited { high = u64.MAX }
      if max == unlimited { max = u64.MAX }
    }
    if high == 0 || max == 0 { return 0 }
    if high < max { return high }
    return max
  }

  /// The memory limit of the process's cgroup in bytes: 0 when it is unknown, and the largest
  /// value when there is a cgroup without a limit.
  pub unsafe fn uv_get_constrained_memory() -> u64 {
    let mut cgroup: [u8; 1024] = [0; 1024]
    if unsafe slurp(b"/proc/self/cgroup\0", &mut cgroup) != 0 { return 0 }
    return unsafe cgroupConstrainedMemory(&cgroup)
  }

  /// The memory the process can still use, in bytes: the cgroup limit less the cgroup's usage when
  /// a limit below the physical memory applies, or else [`uv_get_free_memory`].
  pub unsafe fn uv_get_available_memory() -> u64 {
    let mut cgroup: [u8; 1024] = [0; 1024]
    if unsafe slurp(b"/proc/self/cgroup\0", &mut cgroup) != 0 { return 0 }
    let constrained = unsafe cgroupConstrainedMemory(&cgroup)
    if constrained == 0 { return unsafe uv_get_free_memory() }
    if constrained > unsafe uv_get_total_memory() { return unsafe uv_get_free_memory() }
    let mut current: u64 = 0
    if startsWith(&cgroup, 0, b"0::/") {
      current = unsafe cgroupNumber(b"/sys/fs/cgroup/", &cgroup, 4, lineSpan(&cgroup, 4), b"/memory.current")
    } else {
      let mut count: usize = 0
      let p = cgroup1Memory(&cgroup, &mut count)
      if p != NONE { current = unsafe cgroupNumber(b"/sys/fs/cgroup/memory/", &cgroup, p, count, b"/memory.usage_in_bytes") }
      if current == 0 { current = unsafe readNumber(b"/sys/fs/cgroup/memory/memory.usage_in_bytes\0") }
    }
    // The usage can exceed the limit for a short time.
    if constrained < current { return 0 }
    return constrained - current
  }

  // uv__get_cgroupv2_constrained_cpu: walks from the process's cgroup up to the mount and reads
  // each cpu.max ("quota period"). `quota` is left as the whole processors of the last limit read,
  // which is the one nearest the root: libuv computes the smallest and then does not use it.
  unsafe fn cgroup2Cpu(cgroup: &[u8], quota: &mut i64) -> i32 {
    let count = lineSpan(cgroup, 4)
    let mut path: [u8; 256] = [0; 256]
    let mut n = put(&mut path, 0, b"/sys/fs/cgroup/")
    n = put(&mut path, n, part(cgroup, 4, count))
    let _end = put(&mut path, n, b"/cgroup.controllers")
    // Without its controllers file this is not really a cgroup.
    let mut controllers: [u8; 1024] = [0; 1024]
    if unsafe slurp(&path, &mut controllers) < 0 { return UV_EIO }
    path[n] = 0
    while startsWith(&path, 0, b"/sys/fs/cgroup") {
      let mut full: [u8; 256] = [0; 256]
      let end = put(&mut full, 0, part(&path, 0, length(&path)))
      let _full = put(&mut full, end, b"/cpu.max")
      let mut text: [u8; 16] = [0; 16]
      // A missing file, "max" (no limit), an unreadable pair and a zero period are all skipped.
      if unsafe slurp(&full, &mut text) >= 0 && !startsWith(&text, 0, b"max") {
        let mut pos: usize = 0
        let mut limit: i64 = 0
        let mut period: i64 = 0
        if scanI64(&text, &mut pos, &mut limit) != 0 && scanI64(&text, &mut pos, &mut period) != 0 && period != 0 {
          match i64.checkedDivide(limit, period) {
            Option<i64>.Some { value } => { quota.* = value }
            Option<i64>.None => {}
          }
        }
      }
      // Up one level; the mount point is the last.
      let slash = findLastByte(&path, 47)
      if slash == NONE || same(&path, b"/sys/fs/cgroup") { break }
      path[slash] = 0
    }
    return 0
  }

  // uv__get_cgroupv1_constrained_cpu: cpu.cfs_quota_us / cpu.cfs_period_us of the entry whose
  // controller list starts with "cpu,". The path is what follows ":cpu,", as libuv builds it.
  unsafe fn cgroup1Cpu(cgroup: &[u8], quota: &mut i64) -> i32 {
    let found = find(cgroup, 0, b":cpu,")
    if found == NONE { return UV_EIO }
    let count = lineSpan(cgroup, found + 5)
    let mut path: [u8; 256] = [0; 256]
    let mut n = put(&mut path, 0, b"/sys/fs/cgroup/")
    n = put(&mut path, n, part(cgroup, found + 5, count))
    let _quota = put(&mut path, n, b"/cpu.cfs_quota_us")
    let mut text: [u8; 1024] = [0; 1024]
    if unsafe slurp(&path, &mut text) < 0 { return UV_EIO }
    let mut pos: usize = 0
    let mut perPeriod: i64 = 0
    if scanI64(&text, &mut pos, &mut perPeriod) == 0 { return UV_EINVAL }
    let _period = put(&mut path, n, b"/cpu.cfs_period_us")
    if unsafe slurp(&path, &mut text) < 0 { return UV_EIO }
    pos = 0
    let mut period: i64 = 0
    if scanI64(&text, &mut pos, &mut period) == 0 { return UV_EINVAL }
    if period == 0 { return UV_EINVAL }
    match i64.checkedDivide(perPeriod, period) {
      Option<i64>.Some { value } => { quota.* = value }
      Option<i64>.None => { return UV_EINVAL }
    }
    return 0
  }

  /// How many threads the process can usefully run: the processors in its affinity mask (or else
  /// the online processors), lowered to a whole-processor cgroup CPU quota when one applies; at least 1.
  pub unsafe fn uv_available_parallelism() -> u32 {
    let mut result: i64 = -1
    // cpu_set_t is 1024 bits.
    let mut mask: [u64; 16] = [0; 16]
    if unsafe sched_getaffinity(0, 128, Pointer.fromMutRef<u64>(&mut mask[0])) == 0 {
      result = 0
      let mut n: usize = 0
      while n < 16 { result = result + u32.toI64(u64.countOnes(mask[n])) n = n + 1 }
    }
    if result < 0 { result = unsafe sysconf(SC_NPROCESSORS_ONLN) }
    let mut cgroup: [u8; 1024] = [0; 1024]
    let mut quota: i64 = 0
    let mut status = UV_EIO
    if unsafe slurp(b"/proc/self/cgroup\0", &mut cgroup) >= 0 {
      if startsWith(&cgroup, 0, b"0::/") { status = unsafe cgroup2Cpu(&cgroup, &mut quota) } else { status = unsafe cgroup1Cpu(&cgroup, &mut quota) }
    }
    if status == 0 && quota > 0 && quota < result { result = quota }
    if result < 1 { result = 1 }
    return i64.wrappingToU32(result)
  }

  /// The 1, 5 and 15 minute load averages into `avg[0..3]`: /proc/loadavg, or else sysinfo().
  /// The three are left as they were if neither can be read.
  pub unsafe fn uv_loadavg(avg: *mut f64) -> () {
    let out = unsafe Pointer.assumeManyMut<f64>(avg)
    let mut text: [u8; 128] = [0; 128]
    if unsafe slurp(b"/proc/loadavg\0", &mut text) == 0 {
      // sscanf stores each value as it converts it.
      let mut pos: usize = 0
      let mut n: usize = 0
      while n < 3 {
        let mut value: f64 = 0.0
        if !unsafe scanF64(&text, &mut pos, &mut value) { break }
        unsafe Pointer.write<f64>(unsafe Pointer.atMut<f64>(out, n), value)
        n = n + 1
      }
      if n == 3 { return () }
    }
    let mut info: [u64; 14] = [0; 14]
    if unsafe sysinfo(Pointer.fromMutRef<[u64; 14]>(&mut info)) < 0 { return () }
    let mut n: usize = 0
    while n < 3 { unsafe Pointer.write<f64>(unsafe Pointer.atMut<f64>(out, n), u64.toF64(info[1 + n]) / 65536.0) n = n + 1 }
  }

  /// Seconds since boot: /proc/uptime, which is right in containers where the clock is not, or
  /// else whole seconds of CLOCK_BOOTTIME.
  pub unsafe fn uv_uptime(seconds: *mut f64) -> i32 {
    let mut text: [u8; 128] = [0; 128]
    if unsafe slurp(b"/proc/uptime\0", &mut text) == 0 {
      let mut pos: usize = 0
      let mut value: f64 = 0.0
      if unsafe scanF64(&text, &mut pos, &mut value) { unsafe Pointer.write<f64>(seconds, value) return 0 }
    }
    let mut now = Timespec { seconds: 0, nanoseconds: 0 }
    if unsafe clock_gettime(7, Pointer.fromMutRef<Timespec>(&mut now)) != 0 { return unsafe failure() }
    unsafe Pointer.write<f64>(seconds, i64.toF64(now.seconds))
    return 0
  }

  /// The resident set size in bytes: the 24th field of /proc/self/stat, in pages. UV_EINVAL when
  /// the file does not have that shape.
  pub unsafe fn uv_resident_set_memory(rss: *mut usize) -> i32 {
    let mut text: [u8; 1024] = [0; 1024]
    let status = unsafe slurp(b"/proc/self/stat\0", &mut text)
    if status < 0 { return status }
    // The process name is in parentheses and may hold spaces: count the fields after the last ')'.
    let mut pos = findLastByte(&text, 41)
    if pos == NONE { return UV_EINVAL }
    let mut n: i32 = 1
    while n <= 22 {
      pos = findByte(&text, pos + 1, 32)
      if pos == NONE { return UV_EINVAL }
      n = n + 1
    }
    let mut pages: i64 = 0
    let kind = scanI64(&text, &mut pos, &mut pages)
    if kind == 2 || pages < 0 { return UV_EINVAL }
    unsafe Pointer.write<usize>(rss, u64.toUsize(u64.wrappingMultiply(i64.toU64(pages), pageSize())))
    return 0
  }
}

// --- Processors, memory, load: Darwin ----------------------------------------------------------

static if Intrinsic.targetOperatingSystem() == "darwin" {
  // sysctlbyname of `name` (which ends with a zero byte) into `capacity` bytes at `value`.
  unsafe fn sysctlNamed(name: &[u8], value: *mut u8, capacity: usize) -> i32 {
    let mut size = capacity
    return unsafe sysctlbyname(cstr(name), value, Pointer.fromMutRef<usize>(&mut size), Pointer.null<u8>(), 0)
  }
  // sysctl of the two-level name `first`.`second`.
  unsafe fn sysctlPair(first: i32, second: i32, value: *mut u8, capacity: usize) -> i32 {
    let name: [i32; 2] = [first, second]
    let mut size = capacity
    return unsafe sysctl(Pointer.fromRef<i32>(&name[0]), 2, value, Pointer.fromMutRef<usize>(&mut size), Pointer.null<u8>(), 0)
  }

  /// One entry per processor: the brand string (or else the hardware model), the frequency in MHz
  /// (2400 where the system does not report one, as on Apple silicon), and the user, nice, system
  /// and idle times of host_processor_info() in milliseconds; irq is 0. Stores the array and its
  /// length; release it with [`uv_free_cpu_info`]. Unlike libuv, this returns the whole
  /// host_processor_info() array to the kernel (libuv passes the integer count as the byte size),
  /// and fails with UV_ENOMEM when a model text cannot be copied (libuv stores a null model).
  pub unsafe fn uv_cpu_info(cpus: *mut ?*mut Cpu, count: *mut i32) -> i32 {
    let ticks = i64.wrappingToU32(unsafe sysconf(SC_CLK_TCK))
    let mut multiplier: u64 = 0
    if ticks != 0 { multiplier = u32.toU64(1000 / ticks) }
    let mut model: [u8; 513] = [0; 513]
    if unsafe sysctlNamed(b"machdep.cpu.brand_string\0", Pointer.fromMutRef<u8>(&mut model[0]), 512) != 0 && unsafe sysctlNamed(b"hw.model\0", Pointer.fromMutRef<u8>(&mut model[0]), 512) != 0 { return unsafe failure() }
    let mut frequency: u64 = 0
    let _status = unsafe sysctlNamed(b"hw.cpufrequency\0", unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef<u64>(&mut frequency)), 8)
    if frequency == 0 { frequency = 2400000000 }
    // PROCESSOR_CPU_LOAD_INFO: four tick counts per processor, in the order user, system, idle, nice.
    let mut processors: u32 = 0
    let mut info: ?*mut i32 = Pointer.null<i32>()
    let mut infoCount: u32 = 0
    if unsafe host_processor_info(unsafe mach_host_self(), 2, Pointer.fromMutRef<u32>(&mut processors), Pointer.fromMutRef<?*mut i32>(&mut info), Pointer.fromMutRef<u32>(&mut infoCount)) != 0 { return UV_EINVAL }
    // The array is `infoCount` integers of kernel-allocated memory.
    let region = Pointer.address<i32>(info)
    let regionSize = u32.toUsize(infoCount) * 4
    let total = u32.toUsize(processors)
    let size = Layout.of<Cpu>().bytes
    let modelSize = length(&model) + 1
    // The entries, zeroed so that a partly filled array can be freed.
    let block = unsafe uvCalloc(total + 1, size)
    if Pointer.isNull<u8>(block) || Pointer.isNull<i32>(info) || u32.toUsize(infoCount) < total * 4 {
      unsafe uvFree(block)
      let _freed = unsafe vm_deallocate(taskSelf(), region, regionSize)
      return UV_ENOMEM
    }
    let entries = unsafe Pointer.assumeManyMut<Cpu>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Cpu>(unsafe presentMut(block)))
    let load = unsafe Pointer.assumeMany<i32>(unsafe Intrinsic.pointerRequalify<?*mut i32, *const i32>(info))
    let mut index: usize = 0
    let mut status: i32 = 0
    while index < total {
      // Each entry owns a copy of the model text.
      let copy = unsafe uvCalloc(1, modelSize)
      if Pointer.isNull<u8>(copy) { status = UV_ENOMEM break }
      unsafe copyBytes(unsafe presentMut(copy), Pointer.fromRef<u8>(&model[0]), modelSize - 1)
      let user = u32.toU64(i32.wrappingToU32(unsafe Pointer.read<i32>(unsafe Pointer.at<i32>(load, index * 4))))
      let system = u32.toU64(i32.wrappingToU32(unsafe Pointer.read<i32>(unsafe Pointer.at<i32>(load, index * 4 + 1))))
      let idle = u32.toU64(i32.wrappingToU32(unsafe Pointer.read<i32>(unsafe Pointer.at<i32>(load, index * 4 + 2))))
      let nice = u32.toU64(i32.wrappingToU32(unsafe Pointer.read<i32>(unsafe Pointer.at<i32>(load, index * 4 + 3))))
      unsafe Pointer.put<Cpu>(unsafe Pointer.atMut<Cpu>(entries, index), Cpu {
        model: unsafe presentMut(copy),
        speed: u64.wrappingToI32(frequency / 1000000),
        times: CpuTimes { user: user * multiplier, nice: nice * multiplier, sys: system * multiplier, idle: idle * multiplier, irq: 0 },
      })
      index = index + 1
    }
    let _freed = unsafe vm_deallocate(taskSelf(), region, regionSize)
    if status != 0 {
      unsafe uv_free_cpu_info(unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut Cpu>(block), usize.toI32(index))
      return status
    }
    unsafe Pointer.write<?*mut Cpu>(cpus, unsafe Intrinsic.pointerReinterpret<?*mut u8, ?*mut Cpu>(block))
    unsafe Pointer.write<i32>(count, usize.toI32(total))
    return 0
  }

  /// Frees the array that [`uv_cpu_info`] stored, and the model text of each of its `count` entries.
  pub unsafe fn uv_free_cpu_info(cpus: ?*mut Cpu, count: i32) -> () {
    if Pointer.isNull<Cpu>(cpus) { return () }
    let entries = unsafe Pointer.assumeManyMut<Cpu>(unsafe Intrinsic.pointerRequalify<?*mut Cpu, *mut Cpu>(cpus))
    let mut index: i32 = 0
    while index < count {
      let mut anchor = ()
      let entry = unsafe Pointer.borrowMut<(), Cpu>(&mut anchor, unsafe Pointer.atMut<Cpu>(entries, i32.toUsize(index)))
      unsafe uvFree(unsafe Intrinsic.pointerRequalify<*const u8, ?*mut u8>(entry.model))
      index = index + 1
    }
    unsafe uvFree(unsafe Intrinsic.pointerReinterpret<?*mut Cpu, ?*mut u8>(cpus))
  }

  /// The free memory in bytes: the free pages of host_statistics(HOST_VM_INFO), or 0.
  pub unsafe fn uv_get_free_memory() -> u64 {
    // vm_statistics_data_t is 15 integers; free_count is the first.
    let mut info: [u32; 15] = [0; 15]
    let mut count: u32 = 15
    if unsafe host_statistics(unsafe mach_host_self(), 2, Pointer.fromMutRef<u32>(&mut info[0]), Pointer.fromMutRef<u32>(&mut count)) != 0 { return 0 }
    return u32.toU64(info[0]) * pageSize()
  }

  /// The physical memory in bytes (hw.memsize), or 0.
  pub unsafe fn uv_get_total_memory() -> u64 {
    let mut total: u64 = 0
    // CTL_HW, HW_MEMSIZE.
    if unsafe sysctlPair(6, 24, unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef<u64>(&mut total)), 8) != 0 { return 0 }
    return total
  }

  /// Always 0: Darwin has no memory constraint to report.
  pub unsafe fn uv_get_constrained_memory() -> u64 { return 0 }

  /// The same as [`uv_get_free_memory`].
  pub unsafe fn uv_get_available_memory() -> u64 { return unsafe uv_get_free_memory() }

  // The positive `int` of sysctl `name`, or -1.
  unsafe fn processorCount(name: &[u8]) -> i64 {
    let mut processors: i32 = 0
    let mut size: usize = 4
    let status = unsafe sysctlbyname(cstr(name), unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(Pointer.fromMutRef<i32>(&mut processors)), Pointer.fromMutRef<usize>(&mut size), Pointer.null<u8>(), 0)
    if status == 0 && size == 4 && processors > 0 { return i32.toI64(processors) }
    return -1
  }

  /// The online processors: the first of hw.activecpu, hw.logicalcpu and hw.ncpu that is positive,
  /// or else sysconf(_SC_NPROCESSORS_ONLN); at least 1.
  pub unsafe fn uv_available_parallelism() -> u32 {
    let mut result: i64 = unsafe processorCount(b"hw.activecpu\0")
    if result < 0 { result = unsafe processorCount(b"hw.logicalcpu\0") }
    if result < 0 { result = unsafe processorCount(b"hw.ncpu\0") }
    if result < 0 { result = unsafe sysconf(SC_NPROCESSORS_ONLN) }
    if result < 1 { result = 1 }
    return i64.wrappingToU32(result)
  }

  /// The 1, 5 and 15 minute load averages into `avg[0..3]` (vm.loadavg); left as they were on an error.
  pub unsafe fn uv_loadavg(avg: *mut f64) -> () {
    // struct loadavg: three 32-bit fixed-point values, padding, then the `long` scale.
    let mut info: [u64; 3] = [0; 3]
    // CTL_VM, VM_LOADAVG.
    if unsafe sysctlPair(2, 2, unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef<u64>(&mut info[0])), 24) < 0 { return () }
    let scale = i64.toF64(u64.wrappingToI64(info[2]))
    let out = unsafe Pointer.assumeManyMut<f64>(avg)
    unsafe Pointer.write<f64>(unsafe Pointer.atMut<f64>(out, 0), u64.toF64(info[0] & 4294967295) / scale)
    unsafe Pointer.write<f64>(unsafe Pointer.atMut<f64>(out, 1), u64.toF64(u64.shiftRight(info[0], 32)) / scale)
    unsafe Pointer.write<f64>(unsafe Pointer.atMut<f64>(out, 2), u64.toF64(info[1] & 4294967295) / scale)
  }

  /// Whole seconds since boot: the wall clock less kern.boottime.
  pub unsafe fn uv_uptime(seconds: *mut f64) -> i32 {
    // struct timeval: the seconds are the first 8 bytes.
    let mut boot: [i64; 2] = [0; 2]
    // CTL_KERN, KERN_BOOTTIME.
    if unsafe sysctlPair(1, 21, unsafe Intrinsic.pointerReinterpret<*mut i64, *mut u8>(Pointer.fromMutRef<i64>(&mut boot[0])), 16) != 0 { return unsafe failure() }
    let now = unsafe time(Pointer.null<i64>())
    unsafe Pointer.write<f64>(seconds, i64.toF64(i64.wrappingSubtract(now, boot[0])))
    return 0
  }

  /// The resident set size in bytes, from task_info(). libuv asks for TASK_BASIC_INFO and asserts
  /// that it succeeds; this asks for MACH_TASK_BASIC_INFO, whose resident_size is the same number
  /// and whose layout does not depend on the architecture, and returns UV_EINVAL if it fails.
  pub unsafe fn uv_resident_set_memory(rss: *mut usize) -> i32 {
    // mach_task_basic_info is 12 integers: virtual_size (64 bits), then resident_size (64 bits).
    let mut info: [u32; 12] = [0; 12]
    let mut count: u32 = 12
    if unsafe task_info(taskSelf(), 20, Pointer.fromMutRef<u32>(&mut info[0]), Pointer.fromMutRef<u32>(&mut count)) != 0 { return UV_EINVAL }
    unsafe Pointer.write<usize>(rss, u64.toUsize(u64.shiftLeft(u32.toU64(info[3]), 32) | u32.toU64(info[2])))
    return 0
  }
}
