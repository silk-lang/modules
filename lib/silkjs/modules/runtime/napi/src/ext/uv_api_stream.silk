    let option = if which == UV_JOIN_GROUP { IP_ADD_MEMBERSHIP } else { if which == UV_LEAVE_GROUP { IP_DROP_MEMBERSHIP } else { 0 } }
    if option == 0 { return -EINVAL }
    if unsafe setsockopt(fd, IPPROTO_IP, option, bytes, 8) != 0 { return -(unsafe errno()) }
    return 0
  }
  let mut request6: [u32; 5] = [0; 5]
  let bytes6 = unsafe Intrinsic.pointerReinterpret<*mut u32, *mut u8>(Pointer.fromMutRef<u32>(&mut request6[0]))
  if !Pointer.isNull<u8>(interfaceAddress) {
    let mut storage: [u64; 4] = [0; 4]
    let local = unsafe words(Pointer.fromMutRef<u64>(&mut storage[0]))
    if unsafe inet.uv_ip6_addr(unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(interfaceAddress), 0, local) != 0 { return -EINVAL }
    unsafe set<u32>(bytes6, 16, unsafe get<u32>(local, 24))
