//! `::first-letter` boxes, `initial-letter` drop caps, `::first-line` paint, `text-box` trims and `text-emphasis` marks.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, Mutation, CpuSnapshot }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import ui_tree.inspect
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.tokens { CssError }
import svg_css.written
import ui_fixtures.fixtures as fixtures
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.num.f32
import silk.num.u32

const NONE: u32 = u32.MAX

fn letterOf(tree: &UiTree<'_>, id: u32) -> u32 {
  return match tree.node(tree.slotOf(id)).identity() { Option.Some { value } => value.letterBox _ => NONE }
}
fn textOf<'a>(tree: &'a UiTree<'_>, box: u32) -> string<'a> {
  if box == NONE { return "<none>" }
  let child = tree.slotOfCssNode(tree.layout.firstChild(tree.node(box).css))
  return String.view(&tree.node(child).text)
}
fn startOf(tree: &UiTree<'_>, id: u32) -> usize {
  return tree.layout.textStart(tree.node(tree.slotOf(id)).css)
}

effect fn node(batch: &mut Batch, parent: u32, id: u32, tag: string, css: &[u8]) -> ()
  ! CssError | OutOfMemoryError ? &mut Allocator {
  run batch.create(id, NodeKind.Box)
  run batch.attribute(id, Attribute.Element { name: run String.copy(tag) })
  let declarations = run written.declarations(css)
  run batch.style(id, declarations.asSlice())
  run batch.append(parent, id)
}
effect fn bounds(tree: &UiTree<'_>, slot: u32) -> inspect.NodeInfo ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  return match run inspect.infoSlot(tree, slot) {
    Option.Some { value } => value
    _ => {
      run Testing.expect(false, "the node is laid out")
      return Intrinsic.trap("unreachable")
    }
  }
}
effect fn frame(tree: &mut UiTree<'_>) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
  run tree.frame(FrameInput { width: 400.0, height: 600.0, scale: 1.0, time: 0.0 })
}

effect fn firstLetters() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run node(&mut batch, 1, 2, "p", b"display: block; width: 300px; font-size: 16px; line-height: 20px")
  run batch.text(2, 100, "\u{201c}Hello world")
  run node(&mut batch, 1, 3, "p", b"display: block; width: 300px")
  run node(&mut batch, 3, 4, "em", b"")
  run batch.text(4, 101, "  Once upon a time")
  run node(&mut batch, 1, 5, "div", b"display: flex")
  run batch.text(5, 102, "Flex")
  run node(&mut batch, 1, 6, "p", b"display: block; width: 300px")
  run node(&mut batch, 6, 7, "span", b"display: block; float: left; width: 40px")
  run node(&mut batch, 7, 8, "span", b"display: block")
  run batch.text(8, 104, "Seal")
  run batch.text(6, 105, "Body")
  let sheet = run compile.compile(b"p::first-letter{color:red;font-size:32px}div::first-letter{color:red}", &Options.make())
  run Testing.expect(sheet.diagnostics.length() == 0, "the sheet compiles")
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run frame(&mut tree)
  let letter = letterOf(&tree, 2)
  run Testing.expect(textOf(&tree, letter) == "\u{201c}H" && startOf(&tree, 100) == 4, "the letter takes its leading punctuation, and the text lays out after it")
  let color = tree.node(letter).computed().text.color
  run Testing.expect(color.r == 1.0 && color.g == 0.0 && tree.node(letter).computed().text.size == 32.0, "::first-letter styles its box")
  let box = run bounds(&tree, letter)
  let rest = run bounds(&tree, tree.slotOf(100))
  let paragraph = run bounds(&tree, tree.slotOf(2))
  run Testing.expect(box.bounds.xMin == paragraph.bounds.xMin, "the letter starts the line")
  run Testing.expect(rest.bounds.xMin == box.bounds.xMax, "the text follows it")
  let nested = letterOf(&tree, 3)
  run Testing.expect(textOf(&tree, nested) == "O" && tree.node(nested).parent == tree.slotOf(4), "a letter inside an inline sits in it; leading spaces collapse away")
  run Testing.expect(letterOf(&tree, 5) == NONE, "a flex container has no first letter")
  run Testing.expect(textOf(&tree, letterOf(&tree, 6)) == "B" && startOf(&tree, 104) == 0, "a float before the text holds no first letter")
  run Testing.expect(letterOf(&tree, 1) == NONE, "the root's ::first-letter yields the letter to the paragraph's")

  // Edits move the letter.
  let mut edit = Batch.make()
  run edit.setText(100, "(a) list")
  run tree.apply(run edit.take())
  run frame(&mut tree)
  run Testing.expect(textOf(&tree, letterOf(&tree, 2)) == "(a)" && startOf(&tree, 100) == 3, "a new text has a new letter")
  run edit.text(2, 103, "First")
  run edit.insertBefore(2, 103, 100)
  run tree.apply(run edit.take())
  run frame(&mut tree)
  run Testing.expect(textOf(&tree, letterOf(&tree, 2)) == "F" && startOf(&tree, 100) == 0 && startOf(&tree, 103) == 1, "a text put before takes the letter, the old one gets it back")
  run edit.push(Mutation.Remove { id: 103 })
  run tree.apply(run edit.take())
  run frame(&mut tree)
  run Testing.expect(textOf(&tree, letterOf(&tree, 2)) == "(a)" && startOf(&tree, 103) == 0, "removing the text gives the letter back")
  run edit.push(Mutation.Remove { id: 4 })
  run tree.apply(run edit.take())
  run frame(&mut tree)
  run Testing.expect(letterOf(&tree, 3) == NONE && startOf(&tree, 101) == 0, "an inline taken out takes no letter box with it")
}

test effect fn firstLetterSplitsTheFirstText() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run firstLetters() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn dropCaps() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run node(&mut batch, 1, 2, "p", b"display: block; width: 200px; font-size: 16px; line-height: 20px")
  run batch.text(2, 100, "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.")
  let sheet = run compile.compile(b"p::first-letter{initial-letter:3;margin-right:4px}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run frame(&mut tree)
  let letter = letterOf(&tree, 2)
  let computed = tree.node(letter).computed().*
  run Testing.expect(computed.text.size > 48.0, "a three-line letter is far larger than the text")
  let box = run bounds(&tree, letter)
  let paragraph = run bounds(&tree, tree.slotOf(2))
  let top = computed.layout.margin.top
  let bottom = computed.layout.margin.bottom
  run Testing.expect(f32.abs(top.value + box.bounds.height() + bottom.value - 60.0) < 0.01, "it excludes exactly three lines")
  run Testing.expect(box.bounds.xMin == paragraph.bounds.xMin && f32.abs(box.bounds.yMin - top.value - paragraph.bounds.yMin) < 0.01, "it floats to the first line's start")
  run Testing.expect(paragraph.bounds.height() > 60.0, "the paragraph goes on below it")
}

test effect fn initialLetterMakesADropCap() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dropCaps() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn redIn(painted: &Pixmap, top: u32, bottom: u32) -> u32 {
  let mut count: u32 = 0
  let mut y = top
  while y < bottom {
    let mut x: u32 = 0
    while x < 200 {
      let pixel = painted.pixel(x, y)
      if pixel.r > 150 && pixel.g < 90 && pixel.b < 90 { count = count + 1 }
      x = x + 1
    }
    y = y + 1
  }
  return count
}

effect fn firstLines() -> ()
  ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"display:block;width:400px;height:300px;background-color:white;color:black")
  run batch.style(1, root.asSlice())
  run node(&mut batch, 1, 2, "p", b"display: block; width: 200px; font-size: 16px; line-height: 20px")
  run batch.text(2, 100, "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.")
  let sheet = run compile.compile(b"p::first-line{color:rgb(255,0,0)}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run frame(&mut tree)
  let lineBox = match tree.node(tree.slotOf(2)).identity() { Option.Some { value } => value.lineBox _ => NONE }
  run Testing.expect(lineBox != NONE, "the paragraph keeps a ::first-line style")
  run Testing.expect(tree.node(lineBox).computed().text.color.r == 1.0, "in red")
  run Testing.expect(tree.firstLines.length() == 1, "and its first line box")
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let painted = run snapshot.render(&tree)
  run Testing.expect(redIn(&painted, 0, 20) > 20, "the first line paints in the ::first-line color")
  run Testing.expect(redIn(&painted, 20, 60) == 0, "the lines after it keep the block's")
}

test effect fn firstLinePaintsTheFirstLine() -> ()
  ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run firstLines() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn trimmedBoxes() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run node(&mut batch, 1, 2, "h1", b"display: block; width: 300px; font-size: 16px; line-height: 40px")
  run batch.text(2, 100, "Heading")
  run node(&mut batch, 1, 3, "p", b"display: block; width: 300px; font-size: 16px; line-height: 40px")
  run batch.text(3, 101, "Plain")
  let sheet = run compile.compile(b"h1{text-box:trim-both cap alphabetic}", &Options.make())
  run Testing.expect(sheet.diagnostics.length() == 0, "the sheet compiles")
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run frame(&mut tree)
  let heading = run bounds(&tree, tree.slotOf(2))
  let plain = run bounds(&tree, tree.slotOf(3))
  run Testing.expect(plain.bounds.height() == 40.0, "an untrimmed line keeps its line height")
  // Cap height to baseline: about 0.7em of the 16px font.
  run Testing.expect(heading.bounds.height() > 9.0 && heading.bounds.height() < 14.0, "trim-both cap alphabetic leaves the cap height")
  run Testing.expect(plain.bounds.yMin == heading.bounds.yMax, "the next block follows the trimmed one")
}

test effect fn textBoxTrimsAHeading() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run trimmedBoxes() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn emphasisMarks() -> ()
  ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"display:block;width:400px;height:300px;background-color:white;color:black")
  run batch.style(1, root.asSlice())
  run node(&mut batch, 1, 2, "p", b"display: block; width: 200px; font-size: 20px")
  run batch.text(2, 100, "Marks here")
  run node(&mut batch, 1, 3, "div", b"display: block; width: 200px; font-size: 20px")
  run batch.text(3, 101, "Plain")
  let sheet = run compile.compile(b"p{text-emphasis:filled circle rgb(255,0,0)}", &Options.make())
  run Testing.expect(sheet.diagnostics.length() == 0, "the sheet compiles")
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run frame(&mut tree)
  let marked = run bounds(&tree, tree.slotOf(2))
  let plain = run bounds(&tree, tree.slotOf(3))
  run Testing.expect(marked.bounds.height() > plain.bounds.height() + 5.0, "the marks take room above the line")
  let text = run bounds(&tree, tree.slotOf(100))
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let painted = run snapshot.render(&tree)
  let top = f32.toU32(text.bounds.yMin)
  run Testing.expect(redIn(&painted, 0, top) > 20, "red marks over the text")
  run Testing.expect(redIn(&painted, top, f32.toU32(plain.bounds.yMax)) == 0, "none on or under it")
}

test effect fn textEmphasisMarksCharacters() -> ()
  ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run emphasisMarks() |> Effect.provideMut<Allocator>(&mut allocator)
}
