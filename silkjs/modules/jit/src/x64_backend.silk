          run self.a.load(Width.W64, Reg.R9, payloadOf(inst.b))
        }
        run self.a.store(Width.W64, Mem.at(Reg.R11, at), Reg.Rax)
        run self.a.store(Width.W64, Mem.at(Reg.R11, at + 8), Reg.R9)
        if !moved { run self.retainBits(Reg.Rax, Reg.R9) }
        self.a.bind(done)
        let mut flags: u32 = 0
        if held { flags = PUT_HELD }
        if moved { flags = u32.bitOr(flags, PUT_MOVED) self.dropAt = self.cursor + 1 }
        if inst.k != 0 { run self.outs.append(Out { kind: OUT_PUT_LAST, entry: last, back: done, frame: self.frameOf, inst: self.cursor, base: Reg.R11, at: at, flags: flags }) }
        return ()
      }
