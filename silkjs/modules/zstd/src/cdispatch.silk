//! The table of block compressors: `ZSTD_selectBlockCompressor` of `lib/compress/zstd_compress.c`.
//!
//! [`compressBlock`] calls the block compressor of a strategy, of the row match finder mode and
//! of a dictionary mode (`cstate.NO_DICT`, `EXT_DICT`, `DICT_MATCH_STATE`,
//! `DEDICATED_DICT_SEARCH`). A block compressor has the signature that `zfast` documents.
//!
//! Every strategy has its `NO_DICT`, `EXT_DICT` and `DICT_MATCH_STATE` compressors.
//! `DEDICATED_DICT_SEARCH` is not ported: only `ZSTD_c_enableDedicatedDictSearch`, which Node does
//! not expose, selects it.
import cstate
import cstate { MatchState, SeqStore }
import cparams
import zfast
import zdfast
import zopt
import zlazy

/// Whether [`compressBlock`] runs the block compressor of the reference for `strategy`, and not
/// a stand-in.
pub fn isExact(strategy: u32) -> bool { return strategy >= cparams.FAST || strategy == 0 }

/// Runs the block compressor that `ZSTD_selectBlockCompressor(strategy, useRowMatchFinder,
/// dictMode)` selects on `src[0..srcSize]`, and returns the size of the last literals.
pub unsafe fn compressBlock(strategy: u32, useRowMatchFinder: u32, dictMode: u32, ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  let hasChain = cparams.allocateChainTable(strategy, useRowMatchFinder, false)
  if dictMode == cstate.EXT_DICT {
    if strategy <= cparams.FAST { return unsafe zfast.compressBlockFastExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
    if strategy == cparams.DFAST { return unsafe zdfast.compressBlockDoubleFastExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
    // greedy .. btultra2, extDict: plug `zlazy` and `zopt` in here.
    if strategy >= cparams.GREEDY && strategy <= cparams.BTLAZY2 {
      let row = strategy <= cparams.LAZY2 && useRowMatchFinder == cparams.PS_ENABLE
      if strategy == cparams.GREEDY { if row { return unsafe zlazy.compressBlockGreedyExtDictRow(&mut ms, &mut seqStore, rep, src, srcSize) } return unsafe zlazy.compressBlockGreedyExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
      if strategy == cparams.LAZY { if row { return unsafe zlazy.compressBlockLazyExtDictRow(&mut ms, &mut seqStore, rep, src, srcSize) } return unsafe zlazy.compressBlockLazyExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
      if strategy == cparams.LAZY2 { if row { return unsafe zlazy.compressBlockLazy2ExtDictRow(&mut ms, &mut seqStore, rep, src, srcSize) } return unsafe zlazy.compressBlockLazy2ExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
      return unsafe zlazy.compressBlockBtlazy2ExtDict(&mut ms, &mut seqStore, rep, src, srcSize)
    }
    if strategy == cparams.BTOPT { return unsafe zopt.compressBlockBtoptExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
    if strategy >= cparams.BTULTRA { return unsafe zopt.compressBlockBtultraExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
    if !hasChain { return unsafe zfast.compressBlockFastExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
    return unsafe zdfast.compressBlockDoubleFastExtDict(&mut ms, &mut seqStore, rep, src, srcSize)
  }
  if dictMode == cstate.DICT_MATCH_STATE {
    // An attached dictionary (`cdict.silk`).
    if strategy <= cparams.FAST { return unsafe zfast.compressBlockFastDictMatchState(&mut ms, &mut seqStore, rep, src, srcSize) }
    if strategy == cparams.DFAST { return unsafe zdfast.compressBlockDoubleFastDictMatchState(&mut ms, &mut seqStore, rep, src, srcSize) }
    if strategy >= cparams.GREEDY && strategy <= cparams.BTLAZY2 {
      let row = strategy <= cparams.LAZY2 && useRowMatchFinder == cparams.PS_ENABLE
      if strategy == cparams.GREEDY { if row { return unsafe zlazy.compressBlockGreedyDictMatchStateRow(&mut ms, &mut seqStore, rep, src, srcSize) } return unsafe zlazy.compressBlockGreedyDictMatchState(&mut ms, &mut seqStore, rep, src, srcSize) }
      if strategy == cparams.LAZY { if row { return unsafe zlazy.compressBlockLazyDictMatchStateRow(&mut ms, &mut seqStore, rep, src, srcSize) } return unsafe zlazy.compressBlockLazyDictMatchState(&mut ms, &mut seqStore, rep, src, srcSize) }
      if strategy == cparams.LAZY2 { if row { return unsafe zlazy.compressBlockLazy2DictMatchStateRow(&mut ms, &mut seqStore, rep, src, srcSize) } return unsafe zlazy.compressBlockLazy2DictMatchState(&mut ms, &mut seqStore, rep, src, srcSize) }
      return unsafe zlazy.compressBlockBtlazy2DictMatchState(&mut ms, &mut seqStore, rep, src, srcSize)
    }
    if strategy == cparams.BTOPT { return unsafe zopt.compressBlockBtoptDictMatchState(&mut ms, &mut seqStore, rep, src, srcSize) }
    if strategy >= cparams.BTULTRA { return unsafe zopt.compressBlockBtultraDictMatchState(&mut ms, &mut seqStore, rep, src, srcSize) }
  }
  // NO_DICT. (DEDICATED_DICT_SEARCH: plug the dictionary variants in here.)
  if strategy <= cparams.FAST { return unsafe zfast.compressBlockFast(&mut ms, &mut seqStore, rep, src, srcSize) }
  if strategy == cparams.DFAST { return unsafe zdfast.compressBlockDoubleFast(&mut ms, &mut seqStore, rep, src, srcSize) }
  // greedy .. btultra2, noDict: plug `zlazy` and `zopt` in here.
  if strategy >= cparams.GREEDY && strategy <= cparams.BTLAZY2 {
    let row = strategy <= cparams.LAZY2 && useRowMatchFinder == cparams.PS_ENABLE
    if strategy == cparams.GREEDY { if row { return unsafe zlazy.compressBlockGreedyRow(&mut ms, &mut seqStore, rep, src, srcSize) } return unsafe zlazy.compressBlockGreedy(&mut ms, &mut seqStore, rep, src, srcSize) }
    if strategy == cparams.LAZY { if row { return unsafe zlazy.compressBlockLazyRow(&mut ms, &mut seqStore, rep, src, srcSize) } return unsafe zlazy.compressBlockLazy(&mut ms, &mut seqStore, rep, src, srcSize) }
    if strategy == cparams.LAZY2 { if row { return unsafe zlazy.compressBlockLazy2Row(&mut ms, &mut seqStore, rep, src, srcSize) } return unsafe zlazy.compressBlockLazy2(&mut ms, &mut seqStore, rep, src, srcSize) }
    return unsafe zlazy.compressBlockBtlazy2(&mut ms, &mut seqStore, rep, src, srcSize)
  }
  if strategy == cparams.BTOPT { return unsafe zopt.compressBlockBtopt(&mut ms, &mut seqStore, rep, src, srcSize) }
  if strategy == cparams.BTULTRA { return unsafe zopt.compressBlockBtultra(&mut ms, &mut seqStore, rep, src, srcSize) }
  if strategy >= cparams.BTULTRA2 { return unsafe zopt.compressBlockBtultra2(&mut ms, &mut seqStore, rep, src, srcSize) }
  if !hasChain { return unsafe zfast.compressBlockFast(&mut ms, &mut seqStore, rep, src, srcSize) }
  return unsafe zdfast.compressBlockDoubleFast(&mut ms, &mut seqStore, rep, src, srcSize)
}
