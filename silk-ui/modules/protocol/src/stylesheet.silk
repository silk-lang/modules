import silk.collections.bytes { Bytes }
import silk.text.string { String }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub union StyleSource {
  Text { pub bytes: Bytes },
  Url { pub url: String },
}
impl StyleSource {
  pub effect fn text(bytes: &[u8]) -> StyleSource ! OutOfMemoryError ? &mut Allocator {
    return StyleSource.Text { bytes: run Bytes.copy(bytes) }
  }
  pub effect fn url(url: string) -> StyleSource ! OutOfMemoryError ? &mut Allocator {
    return StyleSource.Url { url: run String.copy(url) }
  }
  pub effect fn copy(self: &Self) -> StyleSource ! OutOfMemoryError ? &mut Allocator {
    return match &self.* {
      StyleSource.Text { bytes } => run StyleSource.text(bytes.asSlice())
      StyleSource.Url { url } => run StyleSource.url(String.view(&url))
    }
  }
}
