//! The embedding smoke test (the core's src/embed_smoke.silk) with every capability: the same host,
//! started with `WamrWasm`, so the program links WAMR and `typeof WebAssembly` is 'object'.
import silk.system.host_input { HostInput }
import silkjsruntime.embed_smoke
import wasm.wamr { WamrWasm }
import compress.compress { NativeCompression }
import http2.nghttp2 { Nghttp2 }
import http.llhttp { Llhttp }
import database.sqlite_database { SqliteDatabase }
import openssl.openssl_capabilities { OpenSslCrypto, OpenSslTls }
import inspector.node_inspector { NodeInspector }
import amaro.amaro_stripping { Amaro }
import addons.dlopen_addons { DlopenAddons }

pub effect fn main() -> i32 ? &mut HostInput { return run embed_smoke.report(WamrWasm.make(), NativeCompression.make(), Nghttp2.make(), Llhttp.make(), SqliteDatabase.make(), OpenSslCrypto.make(), OpenSslTls.make(), NodeInspector.make(), Amaro {}, DlopenAddons.make()) }
