//! Pooled background computation on `AppPool` with `Waiter` wakeup and zero polling.
import ui_transport.cancel { CancellationToken }
import ui_transport.channel {
  TryRecvError,
  UnboundedChannel,
  UnboundedPair,
  UnboundedReceiver,
  UnboundedSender
}
import ui_transport.pool { ClaimHandle, WorkPoolHandle }
import ui_transport.wake { WakeHandle }
import silk.concurrency.thread { Transferable }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { OutOfMemoryError }

struct ComputeJob<
  Payload,
  Res,
  F: 'static + once fn<'static>(Payload, CancellationToken) -> Res + Transferable
> {
  payload: Payload,
  work: F,
  tx: UnboundedSender<Res>,
}

impl<
  Payload: Transferable,
  Res: Transferable,
  F: 'static + once fn<'static>(Payload, CancellationToken) -> Res + Transferable
> Transferable for ComputeJob<Payload, Res, F> {}

fn runComputeJob<
  Payload: 'static + Transferable,
  Res: 'static + Transferable,
  F: 'static + once fn<'static>(Payload, CancellationToken) -> Res + Transferable
>(
  job: ComputeJob<Payload, Res, F>,
  cancel: &CancellationToken,
) -> () {
  let ComputeJob<Payload, Res, F> { payload, work, tx } = move job
  let result = work(move payload, cancel.clone())
  if !cancel.isRequested() {
    drop run Effect.result(tx.send(move result))
  } else {
    drop result
  }
  tx.close()
}

/// Handle to an in-flight `AppPool` computation started via [`compute`].
pub struct ComputeHandle<T> {
  rx: UnboundedReceiver<T>,
  claim: ClaimHandle,
  cancelToken: CancellationToken,
  done: bool,
}

impl<T: Transferable> ComputeHandle<T> {
  /// Nonblocking check for the completed result; returns `None` while still running or cancelled.
  pub fn poll(self: &mut Self) -> Option<T> {
    if self.done {
      return Option<T>.None
    }
    return match self.rx.tryRecv() {
      Result.Success { value } => {
        self.done = true
        Option<T>.some(move value)
      }
      Result.Failure { error } => match error {
        TryRecvError.Empty => Option<T>.None
        TryRecvError.Closed => {
          self.done = true
          Option<T>.None
        }
      }
    }
  }

  /// Requests cooperative cancellation and suppresses late delivery.
  pub fn cancel(self: &mut Self) -> () {
    self.cancelToken.request()
  }

  /// True once the worker task finished or was cancelled and claimed.
  pub fn isDone(self: &Self) -> bool {
    return self.done || self.claim.isDone()
  }
}

/// Submits `work(payload, cancel)` to `AppPool` under `groupId`, waking `wake` upon completion.
pub effect<'static> fn compute<
  Payload: 'static + Transferable,
  Res: 'static + Transferable,
  F: 'static + once fn<'static>(Payload, CancellationToken) -> Res + Transferable
>(
  pool: &WorkPoolHandle,
  groupId: u32,
  payload: Payload,
  work: F,
  wake: WakeHandle,
) -> ComputeHandle<Res>
  ! OutOfMemoryError {
  let pair = run UnboundedChannel.make<Res>(wake.clone())
  let UnboundedPair<Res> { sender, receiver } = move pair
  let cancel = run CancellationToken.make()
  let job = ComputeJob<Payload, Res, F> {
    payload: move payload,
    work: move work,
    tx: move sender,
  }
  let claim = run pool.submitWith(
    groupId,
    move job,
    runComputeJob<Payload, Res, F>,
    cancel.clone(),
    move wake,
  )
  return ComputeHandle<Res> {
    rx: move receiver,
    claim: move claim,
    cancelToken: move cancel,
    done: false,
  }
}
