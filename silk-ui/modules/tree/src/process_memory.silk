//! The memory of this process as the system's own tools show it to users: macOS's
//! `phys_footprint` (Activity Monitor's "Memory"), Linux's proportional set size (`Pss`) and
//! Windows's private bytes (`PrivateUsage`). Each read makes one or three system calls and
//! allocates nothing, so a page can ask every second.
static if Intrinsic.targetOperatingSystem() == "darwin" {
  import silk.mem.pointer { Pointer }
  import silk.num.u32
  import silk.num.u64

  // Declared as `silk.system.system_info_native` declares them: two declarations of one C
  // symbol must agree (SEM0192).
  unsafe extern "C" static taskPort: u32 as "mach_task_self_"
  unsafe extern "C" fn task_info(task: u32, flavor: u32, info: ?[*]mut u32, count: *mut u32) -> i32

  fn taskSelf() -> u32 { unsafe { return taskPort } }

  /// The process's footprint in bytes, or 0 when the system cannot say.
  pub fn footprint() -> u64 {
    // `TASK_VM_INFO` (22) fills as many revisions of `task_vm_info` as the buffer holds; the
    // 64-bit `phys_footprint` is in words 36 and 37 from revision 1 on.
    let mut info: [u32; 128] = [0; 128]
    let mut count: u32 = 128
    let status = unsafe task_info(taskSelf(), 22, Pointer.fromMutSlice<u32>(&mut info), Pointer.fromMutRef<u32>(&mut count))
    if status != 0 || count < 38 { return 0 }
    return u64.shiftLeft(u32.toU64(info[37]), 32) | u32.toU64(info[36])
  }

  /// Nothing to set in the process: see `useSpaceEfficientMalloc`.
  pub fn returnLargeFrees() -> () {}

  // Declared as `silk.io.logger_native` and `silk.system.system_info_native` declare them.
  @foreign(noCapture: .("name"))
  unsafe extern "C" fn getenv(name: ?[*]const u8) -> ?[*]const u8
  @foreign(noCapture: ("name", "value"))
  unsafe extern "C" fn setenv(name: ?[*]const u8, value: ?[*]const u8, overwrite: i32) -> i32
  unsafe extern "C" fn _NSGetArgv() -> *const ?[*]const ?[*]const u8
  @foreign(noCapture: ("buffer", "size"))
  unsafe extern "C" fn _NSGetExecutablePath(buffer: ?[*]mut u8, size: *mut u32) -> i32
  @foreign(noCapture: ("path", "argv"))
  unsafe extern "C" fn execv(path: ?[*]const u8, argv: ?[*]const ?[*]const u8) -> i32

  fn isSet(name: &[u8]) -> bool {
    return !Pointer.isNullMany<u8>(unsafe getenv(Pointer.fromSlice<u8>(name)))
  }

  /// Starts this program again with macOS's space-efficient allocator, unless it already runs
  /// with it or `SILK_UI_MALLOC=default` asks for the default one. Returns when it does not
  /// restart (either variable set, or the restart failed); a restart that works never returns.
  /// Call it first in `main`, before any thread starts.
  ///
  /// The default allocator keeps the pages of freed blocks dirty: layout scratch, a grown list's
  /// old buffer or a transient string stays in the footprint after it is freed, and
  /// `malloc_zone_pressure_relief` returns none of it (macOS 27). The space-efficient mode gives
  /// pages back as they empty. `malloc` reads its `MallocSpaceEfficient` variable once, before
  /// `main`, hence the restart. Headless React demo on an M1 Max, footprint after the first
  /// frame: 1,000 chat messages 263 to 199 MB, 2,000 paragraphs 128 to 52 MB, layout time the
  /// same.
  pub fn useSpaceEfficientMalloc() -> () {
    if isSet(b"MallocSpaceEfficient\x00") || isSet(b"SILK_UI_MALLOC\x00") { return }
    let mut path: [u8; 1025] = [0; 1025]
    let mut size: u32 = 1024
    if unsafe _NSGetExecutablePath(Pointer.fromMutSlice<u8>(&mut path), Pointer.fromMutRef<u32>(&mut size)) != 0 { return }
    if unsafe setenv(Pointer.fromSlice<u8>(b"MallocSpaceEfficient\x00"), Pointer.fromSlice<u8>(b"1\x00"), 1) != 0 { return }
    let argv = unsafe Pointer.read<?[*]const ?[*]const u8>(unsafe _NSGetArgv())
    let _failed = unsafe execv(Pointer.fromSlice<u8>(&path), argv)
    // The restart failed: go on with the default allocator. The variable stays set, so the
    // program's children get the space-efficient one.
  }
} else {
static if Intrinsic.targetOperatingSystem() == "linux" {
  import silk.mem.pointer { Pointer }
  import silk.num.isize
  import silk.num.u8
  import silk.num.u64
  import silk.num.usize

  unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32
  unsafe extern "C" fn close(fd: i32) -> i32
  unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize
  unsafe extern "C" fn mallopt(parameter: i32, value: i32) -> i32

  // glibc's `M_MMAP_THRESHOLD`.
  const MMAP_THRESHOLD: i32 = -3
  // Buffers from this size up get a mapping of their own.
  const LARGE_BUFFER: i32 = 65536

  /// Has the allocator give each large buffer its own mapping, so freeing one returns its pages
  /// at once. glibc's heap only shrinks from its end, so a long-lived allocation above a freed
  /// list keeps the whole list resident: a feed of 1,000 items that was cleared stayed at 367 MB
  /// and is 92 MB with this. glibc otherwise raises the threshold as large buffers are freed, up
  /// to 32 MB, which is how a growing list ends up on the heap. Call once, before the first
  /// large allocation. Other C libraries ignore the call.
  pub fn returnLargeFrees() -> () {
    let _set = unsafe mallopt(MMAP_THRESHOLD, LARGE_BUFFER)
  }

  /// Nothing to choose: only macOS's allocator has a mode to restart into.
  pub fn useSpaceEfficientMalloc() -> () {}

  // `O_RDONLY | O_CLOEXEC`.
  const READ_ONLY: i32 = 524288

  /// The start of the file at `path` (ending in a zero byte) in `buffer`, and its length; 0 when
  /// it cannot be read.
  pub fn readStart(path: &[u8], buffer: &mut [u8]) -> usize {
    let fd = unsafe open(Pointer.fromSlice<u8>(path), READ_ONLY)
    if fd < 0 { return 0 }
    let capacity = buffer.length
    let base = Pointer.fromMutSlice<u8>(move buffer)
    let mut total: usize = 0
    while total < capacity {
      let mut transferred: isize = 0
      unsafe {
        let start = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(base)
        transferred = read(fd, Pointer.assumeManyMut<u8>(Pointer.atMut<u8>(start, total)), capacity - total)
      }
      if transferred <= 0 { break }
      total = total + isize.toUsize(transferred)
    }
    let _closed = unsafe close(fd)
    return total
  }

  /// The number after `key` on the line that starts with it, times `scale`; 0 when no line does.
  fn field(values: &[u8], length: usize, key: &[u8], scale: u64) -> u64 {
    let mut line: usize = 0
    while line < length {
      let mut matches = line + key.length <= length
      let mut at: usize = 0
      while matches && at < key.length {
        matches = values[line + at] == key[at]
        at = at + 1
      }
      let mut index = line + key.length
      if matches {
        while index < length && values[index] == 32 { index = index + 1 }
        let mut value: u64 = 0
        while index < length && values[index] >= 48 && values[index] <= 57 {
          value = value * 10 + u8.toU64(values[index] - 48)
          index = index + 1
        }
        return value * scale
      }
      index = line
      while index < length && values[index] != 10 { index = index + 1 }
      line = index + 1
    }
    return 0
  }

  /// The process's footprint in bytes, or 0 when the system cannot say.
  pub fn footprint() -> u64 {
    // `smaps_rollup` (Linux 4.14 on) is about 20 short lines, `Pss:` among the first.
    let mut table: [u8; 2048] = [0; 2048]
    let length = readStart(b"/proc/self/smaps_rollup\0", &mut table)
    return field(&table, length, b"Pss:", 1024)
  }
} else {
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.mem.pointer { Pointer }
  import silk.num.u64

  // `PROCESS_MEMORY_COUNTERS_EX` on 64-bit Windows: `cb`, `PageFaultCount`, then nine sizes,
  // `PrivateUsage` last.
  extern "C" struct Counters {
    size: u32,
    pageFaults: u32,
    peakWorkingSet: u64,
    workingSet: u64,
    peakPagedPool: u64,
    pagedPool: u64,
    peakNonPagedPool: u64,
    nonPagedPool: u64,
    pagefile: u64,
    peakPagefile: u64,
    privateUsage: u64,
  }

  unsafe extern "C" fn GetCurrentProcess() -> ?*mut u8
  // kernel32's export of psapi's `GetProcessMemoryInfo`, so nothing more is linked.
  unsafe extern "C" fn K32GetProcessMemoryInfo(process: ?*mut u8, counters: *mut Counters, size: u32) -> i32

  /// The process's footprint in bytes, or 0 when the system cannot say.
  pub fn footprint() -> u64 {
    let mut counters = Counters { size: 80, pageFaults: 0, peakWorkingSet: 0, workingSet: 0, peakPagedPool: 0, pagedPool: 0, peakNonPagedPool: 0, nonPagedPool: 0, pagefile: 0, peakPagefile: 0, privateUsage: 0 }
    if unsafe K32GetProcessMemoryInfo(unsafe GetCurrentProcess(), Pointer.fromMutRef<Counters>(&mut counters), 80) == 0 { return 0 }
    return counters.privateUsage
  }

  /// Nothing to set on Windows.
  pub fn returnLargeFrees() -> () {}

  /// Nothing to choose: only macOS's allocator has a mode to restart into.
  pub fn useSpaceEfficientMalloc() -> () {}
} else {
  /// The process's footprint in bytes, or 0 when the system cannot say.
  pub fn footprint() -> u64 {
    return 0
  }

  /// Nothing to set here.
  pub fn returnLargeFrees() -> () {}

  /// Nothing to choose: only macOS's allocator has a mode to restart into.
  pub fn useSpaceEfficientMalloc() -> () {}
}
}
}
