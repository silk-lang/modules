//! The files a release host on the SilkJS runtime reads beside itself: what the folder of the
//! bundle it embeds holds besides the bundle (wasm modules, workers, images), in `app/`.
import silk.system.filesystem { FileSystem, FileError, Path, DirectoryEntry }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// Copies what the folder of `bundle` holds beside it to the folder `into`, replacing what
/// was there. The bundle and its stylesheet are embedded, so they stay; so do hidden entries
/// and `output`, the folder the build writes into, when it is inside.
pub effect fn bundleFiles(bundle: string, into: string, output: string) -> ()
  ! FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let mut end = String.byteLength(bundle)
  while end > 0 && String.utf8Bytes(bundle)[end - 1] != 47 { end = end - 1 }
  if end <= 1 { return () }
  let from = run Path.make(String.slice(bundle, 0, end - 1))
  let target = run Path.make(into)
  if run FileSystem.exists(&target) {
    run FileSystem.removeDirectoryRecursively(&target)
  }
  run FileSystem.createDirectoriesRecursively(&target)
  let entries = run FileSystem.listDirectory(&from)
  let items = List<DirectoryEntry>.asSlice(&entries)
  let mut at: usize = 0
  while at < items.length {
    let name = Path.name(&items[at].path) |> Option<string>.unwrapOr("")
    let path = Path.view(&items[at].path).unwrapOr("")
    if path != bundle && name != "app.sheet" && !String.startsWith(name, ".") && !inside(output, path) {
      run copied(&items[at], &run Path.resolve(&target, name))
    }
    at = at + 1
  }
}

/// Whether `path` is the folder `output` or holds it.
fn inside(output: string, path: string) -> bool {
  if output == "" { return false }
  if output == path { return true }
  let length = String.byteLength(path)
  return String.byteLength(output) > length && String.startsWith(output, path) && String.utf8Bytes(output)[length] == 47
}

effect fn copied(entry: &DirectoryEntry, to: &Path) -> ()
  ! FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  if entry.kind.code != 1 {
    let bytes = run FileSystem.readFile(&entry.path)
    run FileSystem.writeFile(to, Bytes.asSlice(&bytes))
    return ()
  }
  run FileSystem.createDirectoriesRecursively(to)
  let entries = run FileSystem.listDirectory(&entry.path)
  let items = List<DirectoryEntry>.asSlice(&entries)
  let mut at: usize = 0
  while at < items.length {
    let name = Path.name(&items[at].path) |> Option<string>.unwrapOr("")
    run copied(&items[at], &run Path.resolve(to, name))
    at = at + 1
  }
}
