//! `font-variant` and its longhands, `font-kerning`, `font-feature-settings`,
//! `font-variation-settings` and `font-width`
//! (`font-stretch`), read from their CSS text into the computed text, where ui-text hands them
//! to the shaper.
import mutation { Declaration, CssProperty }
import properties.computed { Text, FontFeatures, MAX_FEATURE_SETTINGS }
import properties.convert
import ui_text.fonts { Variations, MAX_VARIATIONS }
import ui_text.fonts as fonts
import silk.collections.list { List }
import silk.core.option { Option }
import silk.num.f32
import properties.computed as computed
import properties.values
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.num.usize

/// Applies `declaration` to `text` when it sets one of these properties; false when it does
/// not. A value that does not parse leaves `text` as it was, as CSS drops it.
pub effect fn apply(text: &mut Text, declaration: &Declaration) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let property = declaration.property
  let group = groupOf(property)
  let extras = extrasShift(property)
  if group == 0 && property != CssProperty.FontVariant && property != CssProperty.FontFeatureSettings
    && property != CssProperty.FontVariationSettings && property != CssProperty.FontWidth && property != CssProperty.FontStretch
    && extras == INVALID && property != CssProperty.FontSmooth {
    return false
  }
  let written = run values.cssText(&declaration.value)
  let css = Bytes.asSlice(&written)
  if property == CssProperty.FontSmooth {
    // `never` (font-smooth) and `none` (-webkit-font-smoothing) draw aliased glyphs; the
    // other values all mean the grayscale antialiasing glyphs always get.
    let never = named(css, b"never") || named(css, b"none")
    text.features.extras = fonts.withExtrasField(text.features.extras, fonts.EXTRAS_SMOOTH, if never { 1 } else { 0 })
  } else if extras != INVALID {
    // The tree turns written values into negative handles first (UiTree.namedFamilies).
    if let Option.Some { value } = convert.number(&declaration.value) {
      if value < 0.0 {
        text.features.extras = fonts.withExtrasField(text.features.extras, extras, f32.toU32(-value - 1.0))
      }
    } else if named(css, b"normal") || named(css, b"none") || named(css, b"initial") {
      text.features.extras = fonts.withExtrasField(text.features.extras, extras, 0)
    }
  } else if property == CssProperty.FontFeatureSettings {
    let mut parsed = text.features
    if featureSettings(css, &mut parsed) {
      text.features = parsed
    }
  } else if property == CssProperty.FontVariationSettings {
    // The tree turns the settings into a VariationTable id first (UiTree.namedFamilies).
    if let Option.Some { value } = convert.number(&declaration.value) {
      if value >= 0.0 {
        text.features.variations = f32.toU32(value)
      }
    }
  } else if property == CssProperty.FontWidth || property == CssProperty.FontStretch {
    let width = widthOf(css)
    if width > 0.0 {
      text.width = width
    }
  } else if property == CssProperty.FontVariant {
    let all = computed.FEATURE_LIGATURES | computed.FEATURE_CAPS | computed.FEATURE_NUMERIC
      | computed.FEATURE_POSITION
    let bits = variantBits(css, all, true)
    if bits != INVALID {
      text.features.variant = (text.features.variant & ~all) | bits
    }
  } else {
    let bits = variantBits(css, group, false)
    if bits != INVALID {
      text.features.variant = (text.features.variant & ~group) | bits
    }
  }
  return true
}

const INVALID: u32 = 0xFFFFFFFF

/// The `FontFeatures.extras` field `property` writes a tree handle to, or INVALID.
pub fn extrasShift(property: CssProperty) -> u32 {
  return match property {
    CssProperty.FontPalette => fonts.EXTRAS_PALETTE
    CssProperty.FontVariantAlternates => fonts.EXTRAS_ALTERNATES
    CssProperty.FontSizeAdjust => fonts.EXTRAS_SIZE_ADJUST
    _ => INVALID
  }
}

fn groupOf(property: CssProperty) -> u32 {
  return match property {
    CssProperty.FontVariantLigatures => computed.FEATURE_LIGATURES
    CssProperty.FontVariantCaps => computed.FEATURE_CAPS
    CssProperty.FontVariantNumeric => computed.FEATURE_NUMERIC
    CssProperty.FontVariantPosition => computed.FEATURE_POSITION
    CssProperty.FontKerning => computed.FEATURE_KERNING
    _ => 0
  }
}

fn lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}

fn named(part: &[u8], name: &[u8]) -> bool {
  if part.length != name.length {
    return false
  }
  let mut i: usize = 0
  while i < part.length {
    if lower(part[i]) != name[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn space(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

/// The bits one keyword stands for within `allowed`, 0 for `normal`/`auto`, or INVALID.
fn wordBits(word: &[u8], allowed: u32) -> u32 {
  let mut bits: u32 = INVALID
  if named(word, b"normal") || named(word, b"auto") {
    bits = 0
  } else if named(word, b"none") {
    bits = if allowed == computed.FEATURE_KERNING {
      computed.FEATURE_NO_KERNING
    } else {
      computed.FEATURE_NO_COMMON_LIGATURES | computed.FEATURE_NO_CONTEXTUAL
    }
  } else if named(word, b"common-ligatures") || named(word, b"no-discretionary-ligatures")
    || named(word, b"no-historical-ligatures") || named(word, b"contextual") {
    bits = 0
  } else if named(word, b"no-common-ligatures") {
    bits = computed.FEATURE_NO_COMMON_LIGATURES
  } else if named(word, b"discretionary-ligatures") {
    bits = computed.FEATURE_DISCRETIONARY_LIGATURES
  } else if named(word, b"historical-ligatures") {
    bits = computed.FEATURE_HISTORICAL_LIGATURES
  } else if named(word, b"no-contextual") {
    bits = computed.FEATURE_NO_CONTEXTUAL
  } else if named(word, b"small-caps") {
    bits = computed.FEATURE_SMALL_CAPS
  } else if named(word, b"all-small-caps") {
    bits = computed.FEATURE_SMALL_CAPS | computed.FEATURE_CAPS_TO_SMALL_CAPS
  } else if named(word, b"petite-caps") {
    bits = computed.FEATURE_PETITE_CAPS
  } else if named(word, b"all-petite-caps") {
    bits = computed.FEATURE_PETITE_CAPS | computed.FEATURE_CAPS_TO_PETITE_CAPS
  } else if named(word, b"unicase") {
    bits = computed.FEATURE_UNICASE
  } else if named(word, b"titling-caps") {
    bits = computed.FEATURE_TITLING_CAPS
  } else if named(word, b"lining-nums") {
    bits = computed.FEATURE_LINING_NUMS
  } else if named(word, b"oldstyle-nums") {
    bits = computed.FEATURE_OLDSTYLE_NUMS
  } else if named(word, b"proportional-nums") {
    bits = computed.FEATURE_PROPORTIONAL_NUMS
  } else if named(word, b"tabular-nums") {
    bits = computed.FEATURE_TABULAR_NUMS
  } else if named(word, b"diagonal-fractions") {
    bits = computed.FEATURE_DIAGONAL_FRACTIONS
  } else if named(word, b"stacked-fractions") {
    bits = computed.FEATURE_STACKED_FRACTIONS
  } else if named(word, b"ordinal") {
    bits = computed.FEATURE_ORDINAL
  } else if named(word, b"slashed-zero") {
    bits = computed.FEATURE_SLASHED_ZERO
  } else if named(word, b"sub") {
    bits = computed.FEATURE_SUB
  } else if named(word, b"super") {
    bits = computed.FEATURE_SUPER
  }
  if bits != INVALID && bits != 0 && (bits & allowed) != bits {
    return INVALID
  }
  if bits == 0 && allowed == computed.FEATURE_KERNING && !named(word, b"normal") && !named(word, b"auto") {
    return INVALID
  }
  return bits
}

/// The bits a space-separated list of keywords stands for, or INVALID. The `font-variant`
/// shorthand (`lenient`) skips the keywords of the longhands the tree does not read.
fn variantBits(css: &[u8], allowed: u32, lenient: bool) -> u32 {
  let mut bits: u32 = 0
  let mut words: usize = 0
  let mut start: usize = 0
  let mut i: usize = 0
  while i <= css.length {
    if i == css.length || space(css[i]) {
      if i > start {
        let word = Slice.view(css, start, i - start)
        let found = wordBits(word, allowed)
        if found == INVALID {
          if !lenient {
            return INVALID
          }
        } else {
          if (named(word, b"normal") || named(word, b"none") || named(word, b"auto")) && words > 0 {
            return INVALID
          }
          bits = bits | found
        }
        words = words + 1
      }
      start = i + 1
    }
    i = i + 1
  }
  if words == 0 {
    return INVALID
  }
  return bits
}

fn digit(byte: u8) -> bool {
  return byte >= 48 && byte <= 57
}

/// `font-feature-settings`: `normal`, or a comma-separated list of a quoted four-letter tag
/// and an optional integer, `on` or `off`. Says whether it parsed.
fn featureSettings(css: &[u8], out: &mut FontFeatures) -> bool {
  let mut at: usize = 0
  while at < css.length && space(css[at]) {
    at = at + 1
  }
  if named(trimmed(Slice.view(css, at, css.length - at)), b"normal") {
    out.count = 0
    return true
  }
  let mut result = out.*
  result.count = 0
  while true {
    while at < css.length && space(css[at]) {
      at = at + 1
    }
    if at + 6 > css.length || (css[at] != 34 && css[at] != 39) || css[at + 5] != css[at] {
      return false
    }
    let mut tag: u32 = 0
    let mut k: usize = 1
    while k <= 4 {
      let byte = css[at + k]
      if byte < 32 || byte > 126 {
        return false
      }
      tag = u32.shiftLeft(tag, 8) | u8.toU32(byte)
      k = k + 1
    }
    at = at + 6
    while at < css.length && space(css[at]) {
      at = at + 1
    }
    let mut value: u32 = 1
    if at < css.length && css[at] != 44 {
      let start = at
      while at < css.length && css[at] != 44 && !space(css[at]) {
        at = at + 1
      }
      let word = Slice.view(css, start, at - start)
      if named(word, b"on") {
        value = 1
      } else if named(word, b"off") {
        value = 0
      } else {
        let mut number: u32 = 0
        let mut j: usize = 0
        while j < word.length {
          if !digit(word[j]) || number > 100000 {
            return false
          }
          number = number * 10 + u8.toU32(word[j] - 48)
          j = j + 1
        }
        value = number
      }
      while at < css.length && space(css[at]) {
        at = at + 1
      }
    }
    // A tag named again replaces its earlier value.
    let mut slot = result.count
    let mut s: usize = 0
    while s < result.count {
      if result.tags[s] == tag {
        slot = s
      }
      s = s + 1
    }
    if slot < MAX_FEATURE_SETTINGS {
      result.tags[slot] = tag
      result.values[slot] = value
      if slot == result.count {
        result.count = result.count + 1
      }
    }
    if at >= css.length {
      break
    }
    if css[at] != 44 {
      return false
    }
    at = at + 1
  }
  out.* = result
  return true
}

struct VariationEntry {
  text: Bytes,
  axes: Variations,
}

/// The `font-variation-settings` values met so far, by id. Id 0 is `normal`; a value's id
/// stays the same while the tree lives, so it is a computed value that compares cheaply.
pub struct VariationTable {
  entries: List<VariationEntry>,
}

impl VariationTable {
  pub fn make() -> VariationTable {
    return VariationTable { entries: List<VariationEntry>.make() }
  }

  /// The id of the settings written as `css`, or None when they do not parse.
  pub effect fn intern(self: &mut Self, css: &[u8]) -> Option<u32>
    ! OutOfMemoryError
    ? &mut Allocator {
    let entries = self.entries.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      if Bytes.asSlice(&entries[i].text) == css {
        return Option<u32>.Some { value: usize.toU32(i + 1) }
      }
      i = i + 1
    }
    let mut axes = Variations.none()
    if !variationSettings(css, &mut axes) {
      return Option<u32>.None
    }
    if axes.count == 0 {
      return Option<u32>.Some { value: 0 }
    }
    run self.entries.append(VariationEntry { text: run Bytes.copy(css), axes: axes })
    return Option<u32>.Some { value: usize.toU32(self.entries.length()) }
  }

  /// The axes of id `id`; none for 0 or an id it did not give.
  pub fn axes(self: &Self, id: u32) -> Variations {
    let index = u32.toUsize(id)
    if index == 0 || index > self.entries.length() {
      return Variations.none()
    }
    return self.entries.asSlice()[index - 1].axes
  }
}

/// `font-variation-settings`: `normal`, or a comma-separated list of a quoted four-letter axis
/// tag and a number. Says whether it parsed.
fn variationSettings(css: &[u8], out: &mut Variations) -> bool {
  let mut at: usize = 0
  while at < css.length && space(css[at]) {
    at = at + 1
  }
  if named(trimmed(Slice.view(css, at, css.length - at)), b"normal") {
    out.count = 0
    return true
  }
  let mut result = out.*
  result.count = 0
  while true {
    while at < css.length && space(css[at]) {
      at = at + 1
    }
    if at + 6 > css.length || (css[at] != 34 && css[at] != 39) || css[at + 5] != css[at] {
      return false
    }
    let mut tag: u32 = 0
    let mut k: usize = 1
    while k <= 4 {
      let byte = css[at + k]
      if byte < 32 || byte > 126 {
        return false
      }
      tag = u32.shiftLeft(tag, 8) | u8.toU32(byte)
      k = k + 1
    }
    at = at + 6
    while at < css.length && space(css[at]) {
      at = at + 1
    }
    let start = at
    while at < css.length && css[at] != 44 && !space(css[at]) {
      at = at + 1
    }
    let mut value: f32 = 0.0
    if !numberOf(Slice.view(css, start, at - start), &mut value) {
      return false
    }
    while at < css.length && space(css[at]) {
      at = at + 1
    }
    // An axis named again replaces its earlier value.
    let mut slot = result.count
    let mut s: usize = 0
    while s < result.count {
      if result.tags[s] == tag {
        slot = s
      }
      s = s + 1
    }
    if slot < MAX_VARIATIONS {
      result.tags[slot] = tag
      result.values[slot] = value
      if slot == result.count {
        result.count = result.count + 1
      }
    }
    if at >= css.length {
      break
    }
    if css[at] != 44 {
      return false
    }
    at = at + 1
  }
  out.* = result
  return true
}

/// A CSS number: an optional sign, digits with an optional fraction, and an optional exponent.
fn numberOf(word: &[u8], out: &mut f32) -> bool {
  let mut i: usize = 0
  let mut negative = false
  if i < word.length && (word[i] == 43 || word[i] == 45) {
    negative = word[i] == 45
    i = i + 1
  }
  let mut whole: f32 = 0.0
  let mut digits: usize = 0
  while i < word.length && digit(word[i]) {
    whole = whole * 10.0 + u32.toF32(u8.toU32(word[i] - 48))
    digits = digits + 1
    i = i + 1
  }
  if i < word.length && word[i] == 46 {
    i = i + 1
    let mut scale: f32 = 0.1
    while i < word.length && digit(word[i]) {
      whole = whole + u32.toF32(u8.toU32(word[i] - 48)) * scale
      scale = scale / 10.0
      digits = digits + 1
      i = i + 1
    }
  }
  if digits == 0 {
    return false
  }
  if i < word.length && (word[i] == 101 || word[i] == 69) {
    i = i + 1
    let mut down = false
    if i < word.length && (word[i] == 43 || word[i] == 45) {
      down = word[i] == 45
      i = i + 1
    }
    let mut power: u32 = 0
    let mut powerDigits: usize = 0
    while i < word.length && digit(word[i]) && power < 100 {
      power = power * 10 + u8.toU32(word[i] - 48)
      powerDigits = powerDigits + 1
      i = i + 1
    }
    if powerDigits == 0 {
      return false
    }
    while power > 0 {
      if down { whole = whole / 10.0 } else { whole = whole * 10.0 }
      power = power - 1
    }
  }
  if i != word.length {
    return false
  }
  out.* = if negative { -whole } else { whole }
  return true
}

fn trimmed(css: &[u8]) -> &[u8] {
  let mut end = css.length
  while end > 0 && space(css[end - 1]) {
    end = end - 1
  }
  return Slice.view(css, 0, end)
}

/// `font-width` as a percentage, or 0 when it does not parse.
fn widthOf(css: &[u8]) -> f32 {
  let word = trimmed(css)
  if named(word, b"normal") { return 100.0 }
  if named(word, b"ultra-condensed") { return 50.0 }
  if named(word, b"extra-condensed") { return 62.5 }
  if named(word, b"condensed") { return 75.0 }
  if named(word, b"semi-condensed") { return 87.5 }
  if named(word, b"semi-expanded") { return 112.5 }
  if named(word, b"expanded") { return 125.0 }
  if named(word, b"extra-expanded") { return 150.0 }
  if named(word, b"ultra-expanded") { return 200.0 }
  if word.length < 2 || word[word.length - 1] != 37 {
    return 0.0
  }
  let mut whole: f32 = 0.0
  let mut fraction: f32 = 0.0
  let mut scale: f32 = 1.0
  let mut dot = false
  let mut i: usize = 0
  while i < word.length - 1 {
    let byte = word[i]
    if byte == 46 && !dot {
      dot = true
    } else if digit(byte) {
      let d = u32.toF32(u8.toU32(byte - 48))
      if dot {
        scale = scale / 10.0
        fraction = fraction + d * scale
      } else {
        whole = whole * 10.0 + d
      }
    } else {
      return 0.0
    }
    i = i + 1
  }
  return whole + fraction
}
