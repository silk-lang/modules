      if rv == 1 { return inlen }
      if rv < 0 { return i32.toI64(rv) }
      busy = rv == 2
    } else if st == IB_READ_NBYTE {
      let readlen = unsafe bufRead(sp, input, at, end)
      at = at + readlen
      let s = unsafe ses(&mut a, sp) s.payloadLeft = s.payloadLeft - readlen drop s
      if unsafe markAvail(sp) > 0 { return usize.toI64(at) }
      let rv = unsafe readNbyteDone(sp)
      if rv == 1 { return inlen }
      if rv < 0 { return i32.toI64(rv) }
      busy = rv == 2
    } else if st == IB_READ_HEADER_BLOCK || st == IB_IGN_HEADER_BLOCK {
      let readlen = unsafe payloadReadLen(sp, at, end)
      let s = unsafe ses(&mut a, sp) let left = s.payloadLeft drop s
      let mut dataReadlen = unsafe effectiveReadlen(sp, left - readlen, readlen)
      if dataReadlen == -1 { dataReadlen = 0 }
      if dataReadlen > 0 {
