//! The plain data a UI tree and its client exchange. Nothing here holds a tree: every value can
//! be built on one side of a wire and read on the other.
//!
//! This front door carries the typed forms: [`Input`] going in, [`EventRecord`] and
//! [`HostRequest`] coming out, node handles, and [`Propagation`] for walking an event's path.
//! The flat forms that travel as they are live in the `input`, `record` and `request` modules.
pub import id {
  NodeId,
  Node,
  Parent,
  Textual,
  Sourced,
  BoxNode,
  TextNode,
  ImageNode,
  IconNode,
  InputNode,
  CanvasNode,
  FontFamily,
  FontFaceId,
  Resource
}
pub import event {
  Input,
  Modifiers,
  Button,
  Pointer,
  PointerKind,
  Key,
  InputType,
  InputChange,
  ClipboardData,
  Motion,
  Selection,
  Event,
  EventRecord,
  HostRequest,
  DefaultAction,
  Propagation,
  Phase,
  Step,
  listenFlags,
  listenFlag,
  preventFlags,
  bubbles
}
pub import record { EventKind }
pub import input { EditCommand, Request }
pub import rich { MarkSpan, Atom, OBJECT }
pub import mutation { Mutation, Attribute, NodeKind, StyleState, Role, TriState, Live, Orientation, Cursor, CanvasCommand, Keyframe, Declaration, Value, Keyword, NO_SURFACE, NOT_FOCUSABLE, FIRST_ROOT, FACE_NORMAL, FACE_ITALIC, FACE_OBLIQUE }
pub import batch { Batch }
pub import grid { Grid }
pub import options { AnchorOptions, VirtualOptions, VirtualItem, VirtualRange, RootOptions, RootKind }
pub import root { RootEvent, RootEventKind, RootSupport, ExtraRoot }
pub import prevent { KeyMatchKind, KeyRuleEffect, KeyRule, PreventDefaultRules, isNamedKey, PREVENT_FOCUS, PREVENT_SCROLL, PREVENT_KEYS, PREVENT_COPY, PREVENT_CUT, PREVENT_PASTE, PREVENT_BEFORE_INPUT, PREVENT_ALL }
pub import editing { EditOwnership, CaseTransform, AllowedChars, InputFilter, EditConfig }
pub import snapshot { NodeGeometry, VirtualListSnapshot, RootSnapshot, InputRevision, FrameSnapshot }
pub import virtual_list { VirtualList }
