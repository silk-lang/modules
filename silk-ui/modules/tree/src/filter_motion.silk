//! Easing `filter` (Filter Effects 1 §Interpolation of Filters). A filter list lives in the
//! node's paint effects (`paint_css.Effects`), not in `Computed`, so `motion` and `animation`
//! ease it through the small copy here: up to [`CAPACITY`] computed functions, with every
//! amount resolved to a number (degrees for `hue-rotate`, CSS pixels for lengths).
//!
//! Two lists ease function by function when one of them is `none`, or when the functions of
//! the shorter one match the start of the longer one; a missing function eases from or to its
//! initial value for interpolation. Any other pair, or a list with a `url()`, flips halfway.
import paint_css { Effects }
import svg_css.effect_values { Filter, FilterKind }
import svg_css.dimensions
import svg_css.dimensions { Unit }
import svg_css.colors
import svg_css.colors { Color }
import silk.collections.hash { Hash }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.num.usize

/// The most functions a list can have and still ease. A longer one keeps its value.
pub const CAPACITY: usize = 6

/// One computed filter function.
pub struct Step {
  /// The function, when `shadow` is false.
  pub kind: FilterKind,
  /// `drop-shadow()`.
  pub shadow: bool,
  /// `url()`: never eases, and paints nothing.
  pub url: bool,
  /// The amount of a function: a number, degrees for `hue-rotate`, pixels for `blur`. The x
  /// offset of a shadow.
  pub amount: f32,
  pub y: f32,
  pub blur: f32,
  pub color: Rgba<f32>,
}

impl Copy for Step {}

impl Step {
  fn function(kind: FilterKind, amount: f32) -> Step {
    return Step { kind: kind, shadow: false, url: false, amount: amount, y: 0.0, blur: 0.0, color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 } }
  }

  /// Whether `self` and `other` are the same function, so their values can ease.
  fn matches(self: &Self, other: &Step) -> bool {
    if self.url || other.url { return false }
    if self.shadow || other.shadow { return self.shadow == other.shadow }
    return self.kind == other.kind
  }

  /// The function's initial value for interpolation: the value that leaves the image as it is.
  fn initial(self: &Self) -> Step {
    if self.shadow {
      return Step { kind: self.kind, shadow: true, url: false, amount: 0.0, y: 0.0, blur: 0.0, color: clearLike(self.color) }
    }
    let k = self.kind
    let one = k == FilterKind.Brightness || k == FilterKind.Contrast || k == FilterKind.Opacity
      || k == FilterKind.Saturate
    return Step.function(k, if one { 1.0 } else { 0.0 })
  }

  fn same(self: &Self, other: &Step) -> bool {
    if self.url != other.url || self.shadow != other.shadow { return false }
    if self.url { return true }
    if !self.shadow && self.kind != other.kind { return false }
    return self.amount == other.amount && self.y == other.y && self.blur == other.blur
      && sameColor(self.color, other.color)
  }
}

/// A computed `filter`: `count` functions, none for `none`.
pub struct FilterList {
  pub count: u32,
  pub steps: [Step; 6],
}

impl Copy for FilterList {}

impl FilterList {
  pub fn none() -> FilterList {
    return FilterList { count: 0, steps: [Step.function(FilterKind.Blur, 0.0); 6] }
  }

  pub fn step(self: &Self, index: u32) -> Step {
    return self.steps[u32.toUsize(index)]
  }

  fn push(self: &mut Self, step: Step) -> () {
    self.steps[u32.toUsize(self.count)] = step
    self.count = self.count + 1
  }
}

/// `effects`' filter list, or None when it has more than [`CAPACITY`] functions.
pub fn of(effects: &Effects) -> Option<FilterList> {
  let items = effects.filters.asSlice()
  if items.length > CAPACITY {
    return Option<FilterList>.None
  }
  let mut list = FilterList.none()
  let mut i: usize = 0
  while i < items.length {
    match &items[i] {
      Filter.Function { kind, amount } => {
        let value = if kind == FilterKind.Blur { effects.pixels(amount, 0.0) } else { effects.number(amount) }
        list.push(Step.function(kind, value))
      }
      Filter.DropShadow { x, y, blur, color } => {
        let c = colorsToSrgb(color)
        list.push(Step {
          kind: FilterKind.Blur,
          shadow: true,
          url: false,
          amount: effects.pixels(x, 0.0),
          y: effects.pixels(y, 0.0),
          blur: f32.max(0.0, effects.pixels(blur, 0.0)),
          color: c,
        })
      }
      Filter.Url { .. } => {
        let mut step = Step.function(FilterKind.Blur, 0.0)
        step.url = true
        list.push(step)
      }
    }
    i = i + 1
  }
  return Option<FilterList>.some(list)
}

/// The filter list of the node effects `effects`, none without any.
pub fn ofNode(effects: Option<&Effects>) -> Option<FilterList> {
  return match effects {
    Option<&Effects>.Some { value } => of(value)
    _ => Option<FilterList>.some(FilterList.none())
  }
}

fn colorsToSrgb(color: Color) -> Rgba<f32> {
  let c = colors.toSrgb(color)
  return Rgba<f32> { r: f64.toF32(c.r), g: f64.toF32(c.g), b: f64.toF32(c.b), a: f64.toF32(c.a) }
}

fn sameColor(a: Rgba<f32>, b: Rgba<f32>) -> bool {
  return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a
}

fn clearLike(color: Rgba<f32>) -> Rgba<f32> {
  return Rgba<f32> { r: color.r, g: color.g, b: color.b, a: 0.0 }
}

/// Whether two lists are the same value.
pub fn same(a: &FilterList, b: &FilterList) -> bool {
  if a.count != b.count { return false }
  let mut i: u32 = 0
  while i < a.count {
    if !a.step(i).same(&b.step(i)) { return false }
    i = i + 1
  }
  return true
}

/// Whether `a` can ease to `b` function by function.
pub fn interpolable(a: &FilterList, b: &FilterList) -> bool {
  let shorter = if a.count < b.count { a.count } else { b.count }
  let mut i: u32 = 0
  while i < shorter {
    if !a.step(i).matches(&b.step(i)) { return false }
    i = i + 1
  }
  // A `url()` past the shorter list has no initial value to ease from.
  let longer = if a.count >= b.count { a } else { b }
  while i < longer.count {
    if longer.step(i).url { return false }
    i = i + 1
  }
  return true
}

fn lerp(a: f32, b: f32, p: f32) -> f32 {
  return a + (b - a) * p
}

// Colors ease premultiplied, as CSS Color 4 interpolates in sRGB.
fn mixColor(a: Rgba<f32>, b: Rgba<f32>, p: f32) -> Rgba<f32> {
  let alpha = lerp(a.a, b.a, p)
  if alpha <= 0.0 {
    return Rgba<f32> { r: lerp(a.r, b.r, p), g: lerp(a.g, b.g, p), b: lerp(a.b, b.b, p), a: 0.0 }
  }
  return Rgba<f32> {
    r: lerp(a.r * a.a, b.r * b.a, p) / alpha,
    g: lerp(a.g * a.a, b.g * b.a, p) / alpha,
    b: lerp(a.b * a.a, b.b * b.a, p) / alpha,
    a: f32.min(1.0, alpha),
  }
}

// An amount past its range (an easing that overshoots) is clamped, as a declared one is.
fn clampAmount(kind: FilterKind, value: f32) -> f32 {
  if kind == FilterKind.HueRotate { return value }
  let atMostOne = kind == FilterKind.Grayscale || kind == FilterKind.Invert || kind == FilterKind.Opacity
    || kind == FilterKind.Sepia
  let low = f32.max(0.0, value)
  return if atMostOne { f32.min(1.0, low) } else { low }
}

fn mixStep(a: &Step, b: &Step, p: f32) -> Step {
  if a.shadow {
    return Step {
      kind: a.kind,
      shadow: true,
      url: false,
      amount: lerp(a.amount, b.amount, p),
      y: lerp(a.y, b.y, p),
      blur: f32.max(0.0, lerp(a.blur, b.blur, p)),
      color: mixColor(a.color, b.color, p),
    }
  }
  return Step.function(a.kind, clampAmount(a.kind, lerp(a.amount, b.amount, p)))
}

/// `a` eased to `b` at progress `p`. A pair that does not interpolate flips at 0.5.
pub fn mix(a: &FilterList, b: &FilterList, p: f32) -> FilterList {
  if p <= 0.0 { return a.* }
  if p >= 1.0 { return b.* }
  if !interpolable(a, b) {
    return if p < 0.5 { a.* } else { b.* }
  }
  let count = if a.count > b.count { a.count } else { b.count }
  let mut out = FilterList.none()
  let mut i: u32 = 0
  while i < count {
    let from = if i < a.count { a.step(i) } else { b.step(i).initial() }
    let to = if i < b.count { b.step(i) } else { a.step(i).initial() }
    out.push(mixStep(&from, &to, p))
    i = i + 1
  }
  return out
}

/// Replaces `effects`' filters with `list` (its `url()`s, which paint nothing, are left out)
/// and folds `list` into `effects.hash`, so a moving filter paints anew.
pub effect fn write(list: &FilterList, effects: &mut Effects) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut items = List<Filter>.make()
  run items.reserve(u32.toUsize(list.count))
  let mut h = Hash.combine(effects.hash, 0x66696c746572)
  let mut i: u32 = 0
  while i < list.count {
    let s = list.step(i)
    if s.shadow {
      run items.append(Filter.DropShadow {
        x: run dimensions.literal(&mut effects.numerics, f32.toF64(s.amount), Unit.Px),
        y: run dimensions.literal(&mut effects.numerics, f32.toF64(s.y), Unit.Px),
        blur: run dimensions.literal(&mut effects.numerics, f32.toF64(s.blur), Unit.Px),
        color: Color.srgb(f32.toF64(s.color.r), f32.toF64(s.color.g), f32.toF64(s.color.b), f32.toF64(s.color.a)),
      })
      h = floatHash(floatHash(floatHash(h, s.amount), s.y), s.blur)
      h = floatHash(floatHash(floatHash(floatHash(h, s.color.r), s.color.g), s.color.b), s.color.a)
    } else if !s.url {
      let unit = if s.kind == FilterKind.Blur { Unit.Px } else if s.kind == FilterKind.HueRotate { Unit.Deg } else { Unit.Number }
      run items.append(Filter.Function {
        kind: s.kind,
        amount: run dimensions.literal(&mut effects.numerics, f32.toF64(s.amount), unit),
      })
      h = floatHash(Hash.combine(h, u32.toU64(i) + 1), s.amount)
    }
    i = i + 1
  }
  effects.filters = move items
  effects.hash = h
}

fn floatHash(h: u64, value: f32) -> u64 {
  return Hash.combine(h, u32.toU64(f32.toBits(value)))
}
