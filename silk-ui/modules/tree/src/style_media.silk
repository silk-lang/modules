import svg_css.media_features { Environment, Pointer, ColorScheme, Update, OverflowBlock }
import svg_css.cssom_media { MediaList }
import svg_css.tokens { CssError, Limits }
import silk.core.ownership { Copy }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32

/// Host preferences shared by every window of a tree. Bit positions are also
/// used by the browser host's matchMedia adapter.
pub struct Preferences { flags: u32 }
impl Copy for Preferences {}

impl Preferences {
  pub fn fromBits(bits: u32) -> Preferences { return Preferences { flags: u32.bitAnd(bits, 511) } }
  pub fn bits(self: &Self) -> u32 { return self.flags }
  pub fn desktop(dark: bool) -> Preferences {
    return Preferences { flags: if dark { 213 } else { 212 } }
  }
  fn has(self: &Self, flag: u32) -> bool { return u32.bitAnd(self.flags, flag) != 0 }
  pub fn apply(self: &Self, environment: &mut Environment) -> () {
    environment.colorScheme = if self.has(1) { ColorScheme.Dark } else { ColorScheme.Light }
    environment.reducedMotion = self.has(2)
    environment.forcedColors = self.has(256)
    environment.hover = self.has(4)
    environment.pointer = if self.has(8) { Pointer.Coarse } else if self.has(16) { Pointer.Fine } else { Pointer.None }
    environment.anyPointerCoarse = self.has(32)
    environment.anyPointerFine = self.has(64)
    environment.anyHover = self.has(128)
    environment.update = Update.Fast
    environment.overflowBlock = OverflowBlock.Scroll
    environment.overflowInline = true
  }
}

/// The media a frame shows a script, for `matchMedia` and `devicePixelRatio`: the current
/// root's stylesheet environment with the frame's viewport and scale.
pub struct MediaState { environment: Environment }
impl Copy for MediaState {}

impl MediaState {
  pub fn of(environment: Environment) -> MediaState { return MediaState { environment: environment } }

  /// Before the first frame: a viewport not known yet, at `scale`.
  pub fn initial(scale: f64) -> MediaState {
    let mut environment = Environment.headless(0.0, 0.0)
    environment.resolutionDppx = scale
    return MediaState { environment: environment }
  }

  /// Device pixels per CSS pixel.
  pub fn scale(self: &Self) -> f64 { return self.environment.resolutionDppx }

  /// Whether a query could answer differently in `other`: the viewport, the scale or a
  /// host preference moved.
  pub fn differs(self: &Self, other: &MediaState) -> bool {
    let a = &self.environment
    let b = &other.environment
    return a.initial.viewportWidth != b.initial.viewportWidth || a.initial.viewportHeight != b.initial.viewportHeight ||
      a.resolutionDppx != b.resolutionDppx || a.colorScheme != b.colorScheme || a.reducedMotion != b.reducedMotion ||
      a.forcedColors != b.forcedColors || a.hover != b.hover || a.pointer != b.pointer || a.anyHover != b.anyHover ||
      a.anyPointerCoarse != b.anyPointerCoarse || a.anyPointerFine != b.anyPointerFine
  }

  /// Whether media query list `query` matches, as `matchMedia(query).matches`. A query that
  /// does not parse is "not all" and matches nothing.
  pub effect fn matches(self: &Self, query: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
    let limits = Limits.make()
    let parsed = run Effect.result(MediaList.parse(query, &limits))
    let list = match move parsed {
      Result<MediaList, CssError | OutOfMemoryError>.Success { value } => move value
      Result<MediaList, CssError | OutOfMemoryError>.Failure { error } => {
        match move error { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { return false } }
      }
    }
    let answered = run Effect.result(list.matches(&self.environment, &limits))
    return match move answered {
      Result<bool, CssError | OutOfMemoryError>.Success { value } => value
      Result<bool, CssError | OutOfMemoryError>.Failure { error } => {
        match move error { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => false }
      }
    }
  }
}
