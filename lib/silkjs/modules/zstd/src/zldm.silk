//! Long distance matching: a port of `lib/compress/zstd_ldm.c` and `zstd_ldm_geartab.h` of
//! Zstandard 1.5.7.
//!
//! The long distance matcher looks for matches of `minMatchLength` bytes or more at any distance
//! in the window. It cuts the input at the positions where a rolling "gear" hash of the last
//! bytes has `hashRateLog` chosen bits at zero, hashes the `minMatchLength` bytes before each cut
//! with XXH64, and keeps the positions in a table of buckets ([`cctx.LdmState`]). A block is then
//! compressed around the matches found: the block compressor of the strategy runs on the
//! literals between them ([`blockCompress`]), or, for `btopt` and above, the optimal parser gets
//! them as candidates through `ms.ldmSeqStore`.
//!
//! A `RawSeqStore_t` is 40 bytes behind a pointer, with the layout that `zopt` documents
//! (`zopt.RSS_*`); a `rawSeq` is 12 bytes: `u32 offset`, `u32 litLength`, `u32 matchLength`.
//! An entry of the hash table (`ldmEntry_t`) is 8 bytes: `u32 offset`, `u32 checksum`.
//!
//! The parameters (`ZSTD_ldm_adjustParameters`) are in `cparams.ldmAdjustParameters`.
import mem
import errors
import cparams
import cparams { LdmParams }
import cstate
import cstate { MatchState, SeqStore }
import cctx { CCtx, LdmState }
import cdispatch
import zfast
import zdfast
import zopt
import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// `LDM_BATCH_SIZE`: how many cut points are found before they are looked up.
const BATCH_SIZE: u32 = 64
/// `kMaxChunkSize` of `ZSTD_ldm_generateSequences`.
const MAX_CHUNK_SIZE: usize = 1048576

