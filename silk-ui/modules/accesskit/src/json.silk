//! AccessKit updates as JSON, for a host that hands the tree to a script: the canvas browser
//! host of ui-tree-window sends it to `browser/access-mirror.js`, which keeps a hidden DOM copy
//! of the tree for screen readers.
import node { NodeId, Node, Live }
import update { TreeUpdate }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

/// `update` as JSON: `focus`, the root when the update has one,
/// and `nodes`, each with only the properties it has. Ids are decimal strings, since they can
/// be larger than a JavaScript number holds exactly.
pub effect fn encode(update: &TreeUpdate, out: &mut Bytes) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(b"{\"focus\":")
  run id(&mut out, update.focus)
  match &update.tree {
    Option.Some { value } => {
      run out.append(b",\"root\":")
      run id(&mut out, value.root)
    }
    Option.None => {}
  }
  run out.append(b",\"nodes\":[")
  let nodes = update.nodes.asSlice()
  let mut i: usize = 0
  while i < nodes.length {
    if i > 0 {
      run out.append(b",")
    }
    run node(&mut out, nodes[i].id, &nodes[i].node)
    i = i + 1
  }
  run out.append(b"]}")
}

effect fn node(out: &mut Bytes, key: NodeId, value: &Node) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(b"{\"id\":")
  run id(&mut out, key)
  run out.append(b",\"role\":")
  run text(&mut out, value.accessRole().name())
  run out.append(b",\"actions\":")
  run digits(&mut out, u32.toU64(value.actionMask()))
  run maybeText(&mut out, b"label", value.label())
  run maybeText(&mut out, b"value", value.value())
  run maybeText(&mut out, b"description", value.description())
  run maybeText(&mut out, b"placeholder", value.placeholder())
  run maybeText(&mut out, b"roleDescription", value.roleDescription())
  run ids(&mut out, b"children", value.children())
  run ids(&mut out, b"labelledBy", value.labelledBy())
  run ids(&mut out, b"describedBy", value.describedBy())
  run ids(&mut out, b"controls", value.controls())
  match value.activeDescendant() {
    Option.Some { value: target } => {
      run out.append(b",\"activeDescendant\":")
      run id(&mut out, target)
    }
    Option.None => {}
  }
  match value.bounds() {
    Option.Some { value: b } => {
      run out.append(b",\"bounds\":[")
      run number(&mut out, b.x0)
      run out.append(b",")
      run number(&mut out, b.y0)
      run out.append(b",")
      run number(&mut out, b.x1)
      run out.append(b",")
      run number(&mut out, b.y1)
      run out.append(b"]")
    }
    Option.None => {}
  }
  run flag(&mut out, b"hidden", value.isHidden())
  run flag(&mut out, b"disabled", value.isDisabled())
  run flag(&mut out, b"readOnly", value.isReadOnly())
  run flag(&mut out, b"required", value.isRequired())
  run flag(&mut out, b"busy", value.isBusy())
  run flag(&mut out, b"modal", value.isModal())
  run flag(&mut out, b"multiselectable", value.isMultiselectable())
  run flag(&mut out, b"atomic", value.isLiveAtomic())
  match value.toggled() {
    Option.Some { value: state } => {
      run out.append(b",\"toggled\":")
      run text(&mut out, state.name())
    }
    Option.None => {}
  }
  match value.live() {
    Option.Some { value: politeness } => {
      if politeness != Live.Off {
        run out.append(b",\"live\":")
        run text(&mut out, politeness.name())
      }
    }
    Option.None => {}
  }
  match value.invalid() {
    Option.Some { value: state } => {
      run out.append(b",\"invalid\":")
      run text(&mut out, state.name())
    }
    Option.None => {}
  }
  match value.orientation() {
    Option.Some { value: direction } => {
      run out.append(b",\"orientation\":")
      run text(&mut out, direction.name())
    }
    Option.None => {}
  }
  match value.isExpanded() {
    Option.Some { value: on } => run boolean(&mut out, b"expanded", on)
    Option.None => {}
  }
  match value.isSelected() {
    Option.Some { value: on } => run boolean(&mut out, b"selected", on)
    Option.None => {}
  }
  run count(&mut out, b"level", value.level())
  run count(&mut out, b"posInSet", value.positionInSet())
  run count(&mut out, b"setSize", value.sizeOfSet())
  run float(&mut out, b"min", value.minNumericValue())
  run float(&mut out, b"max", value.maxNumericValue())
  run float(&mut out, b"now", value.numericValue())
  run out.append(b"}")
}

effect fn key(out: &mut Bytes, name: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run out.append(b",\"")
  run out.append(name)
  run out.append(b"\":")
}

effect fn maybeText(out: &mut Bytes, name: &[u8], value: Option<string>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match value {
    Option.Some { value: s } => {
      run key(&mut out, name)
      run text(&mut out, s)
    }
    Option.None => {}
  }
}

effect fn flag(out: &mut Bytes, name: &[u8], on: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if on {
    run boolean(&mut out, name, true)
  }
}

effect fn boolean(out: &mut Bytes, name: &[u8], on: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  run key(&mut out, name)
  run out.append(
    if on {
      b"true"
    } else {
      b"false"
    },
  )
}

effect fn count(out: &mut Bytes, name: &[u8], value: Option<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match value {
    Option.Some { value: n } => {
      run key(&mut out, name)
      run digits(&mut out, usize.toU64(n))
    }
    Option.None => {}
  }
}

effect fn float(out: &mut Bytes, name: &[u8], value: Option<f64>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match value {
    Option.Some { value: n } => {
      run key(&mut out, name)
      run number(&mut out, n)
    }
    Option.None => {}
  }
}

effect fn ids(out: &mut Bytes, name: &[u8], values: &[NodeId]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if values.length == 0 {
    return ()
  }
  run key(&mut out, name)
  run out.append(b"[")
  let mut i: usize = 0
  while i < values.length {
    if i > 0 {
      run out.append(b",")
    }
    run id(&mut out, values[i])
    i = i + 1
  }
  run out.append(b"]")
}

effect fn id(out: &mut Bytes, value: NodeId) -> () ! OutOfMemoryError ? &mut Allocator {
  run out.append(b"\"")
  run digits(&mut out, value.value)
  run out.append(b"\"")
}

effect fn digits(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 {
    run digits(&mut out, value / 10)
  }
  run out.append(&[u64.toU8(48 + value % 10)])
}

/// `value` to two decimal places, which is finer than a screen reader or a CSS pixel needs.
effect fn number(out: &mut Bytes, value: f64) -> () ! OutOfMemoryError ? &mut Allocator {
  if !f64.isFinite(value) {
    run out.append(b"0")
    return ()
  }
  let hundredths = f64.toU64(f64.round(f64.abs(value) * 100.0))
  if value < 0.0 && hundredths != 0 {
    run out.append(b"-")
  }
  run digits(&mut out, hundredths / 100)
  let fraction = hundredths % 100
  if fraction != 0 {
    run out.append(&[46, u64.toU8(48 + fraction / 10)])
    if fraction % 10 != 0 {
      run out.append(&[u64.toU8(48 + fraction % 10)])
    }
  }
}

/// `value` as a JSON string.
effect fn text(out: &mut Bytes, value: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(value)
  let hex = b"0123456789abcdef"
  run out.append(b"\"")
  let mut i: usize = 0
  while i < bytes.length {
    let byte = bytes[i]
    if byte == 34 {
      run out.append(b"\\\"")
    } else if byte == 92 {
      run out.append(b"\\\\")
    } else if byte < 32 {
      run out.append(b"\\u00")
      run out.append(&[hex[u8.toUsize(byte / 16)], hex[u8.toUsize(byte % 16)]])
    } else {
      run out.append(&[byte])
    }
    i = i + 1
  }
  run out.append(b"\"")
}
