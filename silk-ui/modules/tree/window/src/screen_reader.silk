//! The development screen reader in the window: ui-screen-reader's [`Reader`] as a window host
//! [`Companion`], so an app can be tried with NVDA, VoiceOver, JAWS, Narrator or Orca keys and
//! speech without turning a real screen reader on. Debug builds run it beside every client.
//!
//! It reads the tree the platform adapter reads (its own [`Publisher`] builds the same
//! `TreeUpdate`s), sees every key first, and answers the ones its flavor uses as the real
//! screen reader would, in browse mode or focus mode. Its actions (focus, click, scroll into
//! view) reach the app as assistive technology's do. It draws over the first window without
//! taking input (`Companion.overlay`): a ring around the element under its virtual cursor, and
//! captions of what it says at the bottom. Speech goes to the system's speech command
//! (`speech.silk`), unless muted.
//!
//! [`VARIABLE`] turns it on at start: `1` or a flavor (`nvda`, `voiceover`, `jaws`,
//! `narrator`, `orca`), with `muted` for captions only and `nocaptions` for speech only, joined
//! by commas (`SILK_UI_SCREEN_READER=voiceover,muted`). Whatever the variable says, these keys
//! work at any time in a debug build, and the app never sees them:
//!
//! - Ctrl+Alt+Shift+S turns the screen reader on or off.
//! - Ctrl+Alt+Shift+F plays the next flavor.
//! - Ctrl+Alt+Shift+M mutes or unmutes speech; the captions stay.
//! - Ctrl+Alt+Shift+C shows or hides the captions.
//!
//! It is an inspector extension too ([`EXTENSION`]), so devtools, the CLI and MCP clients reach
//! it while the inspector is on: commands `state`, `set` (`on`, `flavor`, `speech`,
//! `captions`), `do` (a command by name, as `ui_screen_reader.commandName` names them:
//! `nextHeading`, `sayAll`) and `transcript`; topic `changed`; and panel `reader`, which
//! devtools show as the Screen reader tab: a switch, the flavors, and a button for each command
//! labelled with the flavor's keys for it.
import companion { Companion }
import accessibility { Publisher }
import accessibility
import speech { Speaker }
import ui_screen_reader.lib { Reader, Utterance, Flavor, Command, flavorAt, flavorIndex, flavorName, flavorNamed, FLAVORS }
import accesskit.lib { ActionRequest, Rect as AccessRect, TreeUpdate }
import ui_tree.css
import ui_tree.css { px, percent, Declaration }
import ui_tree.legacy { UiTree, TreeError, FrameInput, Batch, NodeKind, Keyword, Position, WhiteSpace, FlexDirection, BorderStyle, Mutation }
import ui_tree.lib { RootOptions }
import ui_tree.mutation { FIRST_ROOT }
import ui_tree.node { NONE }
import ui_tree.input { Input, MOD_SHIFT, MOD_CONTROL, MOD_ALT, MOD_META }
import ui_inspect_server.lib { Inspector }
import ui_inspect_server.extension { Extension, ExtensionHandler, News, View }
import ui_inspect_server.reply { begin, finish, failure, putText, putFlag, putKey, writeString, textField, flagField, has, numberField }
import ui_tree.inspect { writeInt }
import ui_tree.legacy { Role, Attribute, FlexWrap }
import ui_tree.mutation { LISTEN_CLICK }
import ui_tree.node { Event, EventKind }
import ui_screen_reader.lib { NAMED, commandAt, commandName, commandTitle, commandGroup, commandIndex, keyLabel }
import silk.json.value { Value }
import silk.num.u64
import ui_scene.color as color
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

/// The environment variable that turns the screen reader on at start (see the module
/// documentation).
pub const VARIABLE: string = "SILK_UI_SCREEN_READER"

/// The root the ring and the captions draw in, beside the devtools' at the top of the id space.
pub const SCREEN_READER_ROOT: u32 = 4294901776

/// The overlay's nodes count up from here, past the ids the devtools use for themselves and
/// for the panel views they replay.
pub const FIRST_ID: u32 = 4278190080

const BOX: u32 = 4278190080

const RING: u32 = 4278190081

const STRIP: u32 = 4278190082

const BADGE: u32 = 4278190083

const BADGE_TEXT: u32 = 4278190084

/// Caption lines: a box each, its text node `LINES` after it.
const FIRST_LINE: u32 = 4278190088

const LINES: u32 = 3

/// Seconds a muted utterance is taken to last, for say all: a start and a time per word, about
/// as fast as a screen reader's default voice.
const QUIET_START: f64 = 0.35

const QUIET_WORD: f64 = 0.28

/// How often the speech command is asked whether it finished, in seconds.
const POLL: f64 = 0.1

/// The screen reader in the window. See the module documentation.
pub struct ScreenReader {
  /// Whether this build runs it: a debug build out of check mode.
  pub available: bool,
  on: bool,
  startOn: bool,
  reader: Reader,
  publisher: Publisher,
  speaker: Speaker,
  speaking: bool,
  captions: bool,
  /// The last captions, oldest first.
  lines: List<String>,
  /// The overlay's nodes exist.
  built: bool,
  /// The overlay shows something new.
  dirty: bool,
  /// The ring's rectangle as last drawn; empty: hidden.
  ring: AccessRect,
  /// The code of the shortcut key that went down, whose release is taken too.
  held: String,
  now: f64,
  /// When the last muted utterance ends, in host seconds.
  quietUntil: f64,
  /// Turned on and has not read the tree yet: it reads where its cursor starts.
  fresh: bool,
  /// What inspector clients asked for that needs the tree: turn on (1) or off (0), or -1.
  wanted: i32,
  /// A command to do once it is on, asked for while it was off.
  queued: Option<Command>,
  /// Counts what clients can see change (speech, flavor, mode, switches); `changed` says it.
  revision: u64,
  announced: u64,
  /// The revision the panel's view shows, and whether it was built.
  shown: u64,
  viewBuilt: bool,
  /// The flavor whose keys the view's buttons show, as an index, or `FLAVORS`.
  viewFlavor: usize,
  extended: bool,
}

impl ScreenReader {
  fn syncBrowse(self: &Self, tree: &mut UiTree<'_>) {
    tree.browseCursor = match self.reader.cursorId() {
      Option.Some { value } => if value.local.value == u64.shiftLeft(1, 32) { NONE }
        else { u64.toU32(u64.bitAnd(value.local.value, 0xffffffff)) }
      _ => NONE
    }
  }

  /// A screen reader that runs when `available`, on at start as `asked` (the value of
  /// [`VARIABLE`], if set) says.
  pub effect fn make(available: bool, asked: Option<String>) -> ScreenReader
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut flavor = Flavor.Nvda
    let mut startOn = false
    let mut speaking = true
    let mut captions = true
    if let Option<String>.Some { value } = &asked {
      let text = String.view(&value)
      startOn = !(text == "0" || text == "off" || String.byteLength(text) == 0)
      let bytes = String.utf8Bytes(text)
      let mut start: usize = 0
      while start <= bytes.length {
        let mut end = start
        while end < bytes.length && bytes[end] != 44 {
          end = end + 1
        }
        let token = run String.copy(String.trim(String.slice(text, start, end - start)))
        let word = String.view(&token)
        if let Option<Flavor>.Some { value: named } = flavorNamed(word) {
          flavor = named
        } else if word == "muted" || word == "silent" || word == "captions" {
          speaking = false
        } else if word == "nocaptions" || word == "speech" {
          captions = false
        }
        start = end + 1
      }
    }
    return ScreenReader {
      available: available,
      on: false,
      startOn: startOn && available,
      reader: Reader.make(flavor),
      publisher: Publisher.make(),
      speaker: Speaker.make(),
      speaking: speaking,
      captions: captions,
      lines: List<String>.make(),
      built: false,
      dirty: false,
      ring: AccessRect.make(0.0, 0.0, 0.0, 0.0),
      held: String.make(),
      now: 0.0,
      quietUntil: 0.0,
      fresh: false,
      wanted: -1,
      queued: Option<Command>.None,
      revision: 1,
      announced: 0,
      shown: 0,
      viewBuilt: false,
      viewFlavor: FLAVORS,
      extended: false,
    }
  }

  pub fn isOn(self: &Self) -> bool {
    return self.on
  }

  pub fn flavor(self: &Self) -> Flavor {
    return self.reader.flavor()
  }

  pub fn speaks(self: &Self) -> bool {
    return self.speaking
  }

  pub fn showsCaptions(self: &Self) -> bool {
    return self.captions
  }

  /// The reader, for panels that show its state (the mode, the elements list, the transcript).
  pub fn screenReader(self: &Self) -> &Reader {
    return &self.reader
  }

  /// Turns it on or off. On, it reads the first root from the top, as a screen reader started
  /// over a window does; off, its overlay goes and the app has its keys back.
  pub effect fn setOn(self: &mut Self, tree: &mut UiTree<'_>, inspector: &mut Inspector, on: bool) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if on == self.on || on && !self.available {
      return ()
    }
    self.on = on
    self.revision = self.revision + 1
    if on {
      self.reader = Reader.make(self.reader.flavor())
      self.publisher = Publisher.make()
      self.lines.clear()
      self.fresh = true
      let mut said = String.make()
      run said.append(flavorName(self.reader.flavor()))
      run said.append(" on")
      run self.speak(said.view(), true)
      run self.build(&mut tree, &mut inspector)
    } else {
      tree.browseCursor = NONE
      run self.speaker.stop()
      run self.tear(&mut tree, &mut inspector)
    }
  }

  /// Plays `flavor` from now on.
  pub effect fn setFlavor(self: &mut Self, flavor: Flavor) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.reader.setFlavor(flavor)
    self.dirty = true
    self.revision = self.revision + 1
  }

  /// Speech on or off; captions show either way, if shown.
  pub effect fn setSpeech(self: &mut Self, speaking: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.speaking = speaking
    if !speaking {
      run self.speaker.stop()
    }
    self.dirty = true
    self.revision = self.revision + 1
  }

  pub fn setCaptions(self: &mut Self, captions: bool) -> () {
    self.captions = captions
    self.dirty = true
    self.revision = self.revision + 1
  }

  /// Does `command` as its key would, for panels and inspector clients.
  pub effect fn perform(self: &mut Self, command: Command) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.on {
      run self.reader.perform(command)
      self.dirty = true
      self.revision = self.revision + 1
    } else {
      self.queued = Option<Command>.some(command)
      self.wanted = 1
    }
  }

  /// Says `text` (and captions it).
  effect fn speak(self: &mut Self, text: string, interrupt: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if interrupt {
      self.quietUntil = self.now
    }
    if String.byteLength(text) == 0 {
      if interrupt {
        run self.speaker.stop()
      }
      return ()
    }
    if self.speaking {
      run self.speaker.say(text, interrupt)
    } else if interrupt {
      run self.speaker.stop()
    }
    let start = f64.max(self.now, self.quietUntil)
    self.quietUntil = start + QUIET_START + QUIET_WORD * usize.toF64(words(text))
    run self.lines.append(run String.copy(text))
    while self.lines.length() > u32.toUsize(LINES) {
      drop self.lines.remove(0)
    }
    self.dirty = true
    self.revision = self.revision + 1
  }

  /// Says what the reader has to say.
  effect fn speakAll(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut said = List<Utterance>.make()
    run self.reader.takeSpeech(&mut said)
    let list = said.asSlice()
    let mut i: usize = 0
    while i < list.length {
      run self.speak(list[i].text.view(), list[i].interrupt)
      i = i + 1
    }
  }

  /// Whether the last utterance ended: the speech command finished, or a muted one's time
  /// passed.
  effect fn quiet(self: &mut Self) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.speaking && run self.speaker.available() {
      drop run self.speaker.poll()
      return !self.speaker.busy()
    }
    return self.now >= self.quietUntil
  }

  /// Makes the overlay's nodes, in a root set aside from the app and hidden from the inspector.
  effect fn build(self: &mut Self, tree: &mut UiTree<'_>, inspector: &mut Inspector) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.built {
      return ()
    }
    run inspector.hide(SCREEN_READER_ROOT, true)
    run tree.setAside(SCREEN_READER_ROOT, true)
    let back = tree.current
    let mut batch = Batch.make()
    run batch.create(BOX, NodeKind.Box)
    run batch.style(
      BOX,
      &[css.width(percent(100.0)), css.height(percent(100.0)), css.position(Position.Relative)],
    )
    run batch.box(
      BOX,
      RING,
      &[
        css.position(Position.Absolute),
        css.left(px(0.0)),
        css.top(px(0.0)),
        css.width(px(0.0)),
        css.height(px(0.0)),
        css.borderWidth(px(0.0)),
        css.borderStyle(BorderStyle.Solid),
        css.borderColor(color.rgba(0x1d4ed8ff)),
        css.borderRadius(px(4.0)),
      ],
    )
    run batch.box(
      BOX,
      STRIP,
      &[
        css.position(Position.Absolute),
        css.left(px(12.0)),
        css.right(px(12.0)),
        css.bottom(px(12.0)),
        css.display(Keyword.Flex),
        css.flexDirection(FlexDirection.Column),
        css.gap(px(2.0)),
        css.padding(px(10.0)),
        css.borderRadius(px(8.0)),
        css.backgroundColor(color.rgba(0x111827e0)),
        css.color(color.rgba(0xffffffff)),
        css.fontSize(px(15.0)),
      ],
    )
    run batch.box(STRIP, BADGE, &[css.fontSize(px(11.0)), css.color(color.rgba(0x9ca3afff))])
    run batch.text(BADGE, BADGE_TEXT, "")
    let mut i: u32 = 0
    while i < LINES {
      run batch.box(STRIP, FIRST_LINE + i, &[css.whiteSpace(WhiteSpace.PreWrap)])
      run batch.text(FIRST_LINE + i, FIRST_LINE + LINES + i, "")
      i = i + 1
    }
    run batch.openRoot(SCREEN_READER_ROOT, BOX, RootOptions.default())
    drop run tree.useRoot(SCREEN_READER_ROOT)
    run tree.apply(run batch.take())
    drop run tree.useRoot(back)
    self.built = true
    self.dirty = true
    self.ring = AccessRect.make(0.0, 0.0, 0.0, 0.0)
  }

  effect fn tear(self: &mut Self, tree: &mut UiTree<'_>, inspector: &mut Inspector) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if !self.built {
      return ()
    }
    let back = tree.current
    let mut batch = List<Mutation>.make()
    run batch.append(Mutation.CloseRoot { root: SCREEN_READER_ROOT })
    run batch.append(Mutation.Destroy { id: BOX })
    drop run tree.useRoot(SCREEN_READER_ROOT)
    run tree.apply(move batch)
    drop run tree.useRoot(back)
    run tree.setAside(SCREEN_READER_ROOT, false)
    run inspector.hide(SCREEN_READER_ROOT, false)
    self.built = false
  }

  /// Moves the ring to the cursor and shows the latest captions. Returns whether it changed
  /// the overlay.
  effect fn refresh(self: &mut Self, tree: &mut UiTree<'_>) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if !self.built {
      return false
    }
    let mut ring = AccessRect.make(0.0, 0.0, 0.0, 0.0)
    if let Option<AccessRect>.Some { value } = self.reader.cursorBounds() {
      // The reader's tree is in device pixels (the window node's transform); the ring is CSS.
      let scale = if tree.input.scale > 0.0 {
        f32.toF64(tree.input.scale)
      } else {
        1.0
      }
      ring = AccessRect.make(value.x0 / scale, value.y0 / scale, value.x1 / scale, value.y1 / scale)
    }
    let moved = ring.x0 != self.ring.x0 || ring.y0 != self.ring.y0 || ring.x1 != self.ring.x1
      || ring.y1 != self.ring.y1
    if !moved && !self.dirty {
      return false
    }
    let mut batch = Batch.make()
    if moved {
      self.ring = ring
      let empty = ring.x1 <= ring.x0 || ring.y1 <= ring.y0
      let pad: f32 = 3.0
      // Kept inside the window, so a ring around an element at its edge shows whole.
      let x0 = f32.max(0.0, f64.toF32(ring.x0) - pad)
      let y0 = f32.max(0.0, f64.toF32(ring.y0) - pad)
      if empty {
        run batch.style(RING, &[css.width(px(0.0)), css.height(px(0.0)), css.borderWidth(px(0.0))])
      } else {
        run batch.style(
          RING,
          &[
            css.left(px(x0)),
            css.top(px(y0)),
            css.width(px(f64.toF32(ring.x1) + pad - x0)),
            css.height(px(f64.toF32(ring.y1) + pad - y0)),
            css.borderWidth(px(3.0)),
          ],
        )
      }
    }
    if self.dirty {
      self.dirty = false
      run batch.style(STRIP, &[css.display(if self.captions { Keyword.Flex } else { Keyword.None })])
      let mut badge = String.make()
      run badge.append(flavorName(self.reader.flavor()))
      if self.reader.elementsList().isSome() {
        run badge.append(" · elements list")
      } else if self.reader.flavor() != Flavor.VoiceOver {
        run badge.append(if self.reader.focusMode() { " · focus mode" } else { " · browse mode" })
      }
      if !self.speaking {
        run badge.append(" · muted")
      } else if !(run self.speaker.available()) {
        run badge.append(" · no speech command found, captions only")
      }
      run badge.append("   Ctrl+Alt+Shift: S off, F flavor, M mute, C captions")
      run batch.setText(BADGE_TEXT, badge.view())
      let shown = self.lines.length()
      let mut i: u32 = 0
      while i < LINES {
        let at = u32.toUsize(i)
        // The newest line is the last; older ones are dimmed.
        let first = u32.toUsize(LINES) - (if shown < u32.toUsize(LINES) { shown } else { u32.toUsize(LINES) })
        if at >= first {
          let line = self.lines.asSlice()[at - first].view()
          run batch.setText(FIRST_LINE + LINES + i, line)
          let newest = at + 1 == u32.toUsize(LINES)
          run batch.style(
            FIRST_LINE + i,
            &[
              css.display(Keyword.Block),
              css.color(color.rgba(if newest { 0xffffffff } else { 0xd1d5dbb0 })),
            ],
          )
        } else {
          run batch.setText(FIRST_LINE + LINES + i, "")
          run batch.style(FIRST_LINE + i, &[css.display(Keyword.None)])
        }
        i = i + 1
      }
    }
    let back = tree.current
    drop run tree.useRoot(SCREEN_READER_ROOT)
    run tree.apply(run batch.take())
    drop run tree.useRoot(back)
    return true
  }
}

/// Whether a key press is one of the screen reader's own shortcuts: Ctrl+Alt+Shift and a
/// letter. Returns the letter's code, or "".
fn shortcut(code: string, modifiers: u32) -> string<'static> {
  if modifiers & (MOD_CONTROL | MOD_ALT | MOD_SHIFT | MOD_META) != MOD_CONTROL | MOD_ALT | MOD_SHIFT {
    return ""
  }
  if code == "KeyS" {
    return "KeyS"
  }
  if code == "KeyF" {
    return "KeyF"
  }
  if code == "KeyM" {
    return "KeyM"
  }
  if code == "KeyC" {
    return "KeyC"
  }
  return ""
}

fn words(text: string) -> usize {
  let mut count: usize = 0
  let mut inWord = false
  let mut i: usize = 0
  let bytes = String.utf8Bytes(text)
  while i < bytes.length {
    let b = bytes[i]
    let space = b == 32 || b == 10 || b == 9
    if !space && !inWord {
      count = count + 1
    }
    inWord = !space
    i = i + 1
  }
  return count
}

impl Companion for ScreenReader {
  effect fn attach(self: &mut Self, tree: &mut UiTree<'_>, inspector: &mut Inspector) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.available && !self.extended {
      self.extended = true
      run inspector.extend(run extension())
    }
    if self.startOn {
      run self.setOn(&mut tree, &mut inspector, true)
    }
  }

  effect fn key(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    inspector: &mut Inspector,
    input: &Input,
  ) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if !self.available {
      return false
    }
    match &input.* {
      Input.KeyDown { key, code, modifiers, repeat } => {
        let own = shortcut(String.view(&code), modifiers)
        if String.byteLength(own) != 0 {
          self.held = run String.copy(own)
          if !repeat {
            if own == "KeyS" {
              let on = !self.on
              run self.setOn(&mut tree, &mut inspector, on)
            } else if self.on && own == "KeyF" {
              let next = flavorAt((flavorIndex(self.reader.flavor()) + 1) % FLAVORS)
              run self.setFlavor(next)
            } else if self.on && own == "KeyM" {
              let speaking = !self.speaking
              run self.setSpeech(speaking)
              run self.speak(if speaking { "speech on" } else { "speech muted" }, true)
            } else if self.on && own == "KeyC" {
              let captions = !self.captions
              self.setCaptions(captions)
            }
          }
          return true
        }
        if !self.on {
          return false
        }
        let taken = run self.reader.key(String.view(&key), String.view(&code), modifiers, true)
        self.syncBrowse(&mut tree)
        self.dirty = true
        self.revision = self.revision + 1
        return taken
      }
      Input.KeyUp { key, code, modifiers } => {
        if self.held.ownedByteLength() != 0 && String.view(&code) == String.view(&self.held) {
          self.held.clear()
          return true
        }
        if !self.on {
          return false
        }
        return run self.reader.key(String.view(&key), String.view(&code), modifiers, false)
      }
      Input.TextInput { .. } => {
        return self.on && self.reader.takesText()
      }
      _ => {
        return false
      }
    }
  }

  fn owns(self: &Self, root: u32) -> bool {
    return root == SCREEN_READER_ROOT && self.built
  }

  fn overlay(self: &Self) -> u32 {
    return if self.built { SCREEN_READER_ROOT } else { NONE }
  }

  effect fn pump(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    inspector: &mut Inspector,
    time: f64,
  ) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if time >= 0.0 {
      self.now = time
    }
    if self.extended {
      run inspector.serveExtension(EXTENSION, &mut self)
    }
    if self.wanted >= 0 {
      let on = self.wanted == 1
      self.wanted = -1
      run self.setOn(&mut tree, &mut inspector, on)
    }
    if !self.on {
      return false
    }
    let back = tree.current
    drop run tree.useRoot(FIRST_ROOT)
    if let Option<TreeUpdate>.Some { value } = move run self.publisher.next(&tree.*, true) {
      run self.reader.update(move value)
      if self.fresh {
        // Started over a window and focus said nothing: it reads where it starts, at the top.
        self.fresh = false
        if !self.reader.hasSpeech() {
          run self.reader.perform(Command.CurrentLine)
        }
      }
      if let Option<Command>.Some { value: command } = self.queued {
        self.queued = Option<Command>.None
        run self.reader.perform(command)
      }
    }
    let mut requests = List<ActionRequest>.make()
    run self.reader.takeRequests(&mut requests)
    if requests.length() != 0 {
      run accessibility.apply(&mut tree, &mut requests)
    }
    run self.speakAll()
    if self.reader.isSayingAll() && run self.quiet() {
      run self.reader.spoken()
      run self.speakAll()
    } else {
      drop run self.speaker.poll()
    }
    self.syncBrowse(&mut tree)
    drop run tree.useRoot(back)
    return run self.refresh(&mut tree)
  }

  effect fn layout(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    inspector: &mut Inspector,
    root: u32,
    input: FrameInput,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if root == SCREEN_READER_ROOT && self.built {
      run tree.frameRoot(root, input)
    }
  }

  fn nextDeadline(self: &Self) -> Option<f64> {
    if !self.on {
      return Option<f64>.None
    }
    if self.reader.isSayingAll() {
      if self.speaking && self.speaker.busy() {
        return Option<f64>.some(self.now + POLL)
      }
      return Option<f64>.some(f64.max(self.quietUntil, self.now + POLL))
    }
    if self.speaker.busy() {
      return Option<f64>.some(self.now + POLL * 2.5)
    }
    return Option<f64>.None
  }
}

/// The inspector extension's id: its commands are `screen-reader.<command>`.
pub const EXTENSION: string = "screen-reader"

/// The panel devtools show as the Screen reader tab.
pub const PANEL: string = "reader"

/// What the screen reader adds to the inspector.
pub effect fn extension() -> Extension
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut info = run Extension.make(EXTENSION, "0.1.0")
  run info.command("state")
  run info.command("set")
  run info.command("do")
  run info.command("transcript")
  run info.topic("changed")
  run info.panel(PANEL, "Screen reader", "state", "changed", true)
  run info.tool(
    "state",
    "Screen reader state",
    "The development screen reader: whether it is on, the screen reader it plays (flavor: nvda, voiceover, jaws, narrator or orca), browse or focus mode, speech and captions, what its virtual cursor is on, the last things it said, and every command it knows with the keys the flavor uses for it.",
    "",
    true,
  )
  run info.tool(
    "set",
    "Set up the screen reader",
    "Turns the development screen reader on or off, picks the screen reader it plays, and mutes speech or hides captions. Any member left out stays as it is.",
    r"""{"type":"object","properties":{"on":{"type":"boolean"},"flavor":{"type":"string","enum":["nvda","voiceover","jaws","narrator","orca"]},"speech":{"type":"boolean","description":"Speak with the system's speech command; false shows captions only."},"captions":{"type":"boolean"}}}""",
    false,
  )
  run info.tool(
    "do",
    "Screen reader command",
    "Does a screen reader command as its key would, and returns what the screen reader said. Commands are named as `state` lists them: nextLine, nextItem, nextWord, nextCharacter (and previous...), nextHeading, nextHeading1, nextLink, nextFormField, nextButton, nextTable, nextLandmark (and previous...), sayAll, currentLine, currentFocus, title, activate, toggleMode, listHeadings, listLinks, nextRow, nextColumn. It turns the screen reader on if it is off.",
    r"""{"type":"object","properties":{"command":{"type":"string"}},"required":["command"]}""",
    false,
  )
  run info.tool(
    "transcript",
    "Screen reader transcript",
    "Everything the screen reader said since it was turned on, oldest first, numbered. since skips the lines up to that number.",
    r"""{"type":"object","properties":{"since":{"type":"integer"}}}""",
    true,
  )
  return move info
}

// The panel's view: ids of its own, from 1.
const V_ROOT: u32 = 1
const V_SWITCH: u32 = 2
const V_SWITCH_TEXT: u32 = 3
const V_FLAVOR: u32 = 10
const V_FLAVOR_TEXT: u32 = 20
const V_SPEECH: u32 = 30
const V_SPEECH_TEXT: u32 = 31
const V_CAPTIONS: u32 = 32
const V_CAPTIONS_TEXT: u32 = 33
const V_STATUS_TEXT: u32 = 41
const V_GROUP: u32 = 100
const V_COMMAND: u32 = 1000
const V_COMMAND_TEXT: u32 = 2000
const V_SAID: u32 = 300
const V_SAID_TEXT: u32 = 400
const SAID_LINES: u32 = 12
const GROUPS: [string; 6] = ["Reading", "Moving", "Jumping", "Lists", "Tables", "Acting"]

impl ScreenReader {
  /// The state reply's members.
  effect fn describe(self: &mut Self, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let flavor = self.reader.flavor()
    run putFlag(&mut out, "on", self.on)
    run putText(&mut out, "flavor", flavorName(flavor))
    run putText(&mut out, "mode", if self.reader.focusMode() { "focus" } else { "browse" })
    run putFlag(&mut out, "speech", self.speaking)
    run putFlag(&mut out, "captions", self.captions)
    let available = run self.speaker.available()
    run putText(&mut out, "speechCommand", if available { self.speaker.programName() } else { "" })
    run putKey(&mut out, "cursor")
    let mut cursor = String.make()
    if let Option<usize>.Some { value } = self.reader.cursorItem() {
      run cursor.append(self.reader.document().item(value).text.view())
    }
    run writeString(&mut out, cursor.view())
    run putKey(&mut out, "said")
    run out.append("[")
    let said = self.reader.history()
    let first = if said.length > 8 { said.length - 8 } else { 0 }
    let mut i = first
    while i < said.length {
      if i > first {
        run out.append(",")
      }
      run writeString(&mut out, said[i].view())
      i = i + 1
    }
    run out.append("]")
    run putKey(&mut out, "commands")
    run out.append("[")
    let mut c: usize = 0
    while c < NAMED {
      if c > 0 {
        run out.append(",")
      }
      run out.append("{\"name\":")
      run writeString(&mut out, commandName(c))
      run out.append(",\"title\":")
      run writeString(&mut out, commandTitle(c))
      run out.append(",\"keys\":")
      let mut keys = String.make()
      run keyLabel(flavor, commandAt(c), &mut keys)
      run writeString(&mut out, keys.view())
      run out.append("}")
      c = c + 1
    }
    run out.append("]")
  }

  /// Builds the panel's view from nothing.
  effect fn buildView(self: &mut Self, view: &mut View) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut batch = Batch.make()
    run batch.create(V_ROOT, NodeKind.Box)
    run batch.style(
      V_ROOT,
      &[
        css.display(Keyword.Flex),
        css.flexDirection(FlexDirection.Column),
        css.gap(px(10.0)),
        css.padding(px(12.0)),
        css.fontSize(px(12.0)),
      ],
    )
    let bar = V_ROOT + 3000
    run batch.box(V_ROOT, bar, &rowStyle())
    run batch.attribute(bar, Attribute.Role { value: Role.Toolbar })
    run button(&mut batch, bar, V_SWITCH, V_SWITCH_TEXT)
    let mut f: usize = 0
    while f < FLAVORS {
      let id = V_FLAVOR + usize.toU32(f)
      run button(&mut batch, bar, id, V_FLAVOR_TEXT + usize.toU32(f))
      run batch.setText(V_FLAVOR_TEXT + usize.toU32(f), flavorName(flavorAt(f)))
      f = f + 1
    }
    run button(&mut batch, bar, V_SPEECH, V_SPEECH_TEXT)
    run button(&mut batch, bar, V_CAPTIONS, V_CAPTIONS_TEXT)
    run batch.box(V_ROOT, V_STATUS_TEXT - 1, &[css.color(color.rgba(0x9ca3afff))])
    run batch.attribute(V_STATUS_TEXT - 1, Attribute.Role { value: Role.Status })
    run batch.text(V_STATUS_TEXT - 1, V_STATUS_TEXT, "")
    let mut g: usize = 0
    while g < GROUPS.length {
      let heading = V_GROUP + usize.toU32(g)
      run batch.box(V_ROOT, heading, &[css.fontWeight(600.0), css.marginTop(px(4.0))])
      run batch.attribute(heading, Attribute.Role { value: Role.Heading })
      run batch.text(heading, heading + 10, GROUPS[g])
      let row = heading + 20
      run batch.box(V_ROOT, row, &rowStyle())
      run batch.attribute(row, Attribute.Role { value: Role.Group })
      run batch.label(row, GROUPS[g])
      let mut c: usize = 0
      while c < NAMED {
        if commandGroup(c) == GROUPS[g] {
          run button(&mut batch, row, V_COMMAND + usize.toU32(c), V_COMMAND_TEXT + usize.toU32(c))
        }
        c = c + 1
      }
      g = g + 1
    }
    let saidHeading = V_GROUP + 50
    run batch.box(V_ROOT, saidHeading, &[css.fontWeight(600.0), css.marginTop(px(4.0))])
    run batch.attribute(saidHeading, Attribute.Role { value: Role.Heading })
    run batch.text(saidHeading, saidHeading + 1, "Said")
    let log = V_GROUP + 60
    run batch.box(V_ROOT, log, &[css.display(Keyword.Flex), css.flexDirection(FlexDirection.Column), css.gap(px(2.0))])
    run batch.attribute(log, Attribute.Role { value: Role.Log })
    let mut j: u32 = 0
    while j < SAID_LINES {
      run batch.box(log, V_SAID + j, &[css.whiteSpace(WhiteSpace.PreWrap)])
      run batch.text(V_SAID + j, V_SAID_TEXT + j, "")
      j = j + 1
    }
    run batch.openRoot(FIRST_ROOT, V_ROOT, RootOptions.default())
    let mutations = run batch.take()
    run view.send(mutations.asSlice())
    self.viewBuilt = true
    self.shown = 0
    self.viewFlavor = FLAVORS
  }

  /// Brings the panel's view up to date: switches, labels with the flavor's keys, what was said.
  effect fn updateView(self: &mut Self, view: &mut View) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.shown == self.revision {
      return ()
    }
    self.shown = self.revision
    let flavor = self.reader.flavor()
    let mut batch = Batch.make()
    run batch.setText(V_SWITCH_TEXT, if self.on { "Turn off · Ctrl+Alt+Shift+S" } else { "Turn on · Ctrl+Alt+Shift+S" })
    run batch.style(V_SWITCH, &chosen(self.on))
    let mut f: usize = 0
    while f < FLAVORS {
      run batch.style(V_FLAVOR + usize.toU32(f), &chosen(flavorAt(f) == flavor))
      f = f + 1
    }
    run batch.setText(V_SPEECH_TEXT, if self.speaking { "Speech on · Ctrl+Alt+Shift+M" } else { "Speech muted · Ctrl+Alt+Shift+M" })
    run batch.style(V_SPEECH, &chosen(self.speaking))
    run batch.setText(V_CAPTIONS_TEXT, if self.captions { "Captions on · Ctrl+Alt+Shift+C" } else { "Captions off · Ctrl+Alt+Shift+C" })
    run batch.style(V_CAPTIONS, &chosen(self.captions))
    let mut status = String.make()
    run status.append(flavorName(flavor))
    if !self.on {
      run status.append(" is off. A command button turns it on.")
    } else if self.reader.elementsList().isSome() {
      run status.append(" · elements list")
    } else if flavor != Flavor.VoiceOver {
      run status.append(if self.reader.focusMode() { " · focus mode" } else { " · browse mode" })
    }
    run batch.setText(V_STATUS_TEXT, status.view())
    let labelled = self.viewFlavor == flavorIndex(flavor)
    self.viewFlavor = flavorIndex(flavor)
    let mut c: usize = 0
    while c < NAMED && !labelled {
      let mut label = String.make()
      run label.append(commandTitle(c))
      let mut keys = String.make()
      run keyLabel(flavor, commandAt(c), &mut keys)
      if keys.ownedByteLength() != 0 {
        run label.append(" · ")
        run label.append(keys.view())
      }
      run batch.setText(V_COMMAND_TEXT + usize.toU32(c), label.view())
      run batch.label(V_COMMAND + usize.toU32(c), label.view())
      c = c + 1
    }
    let said = self.reader.history()
    let lines = u32.toUsize(SAID_LINES)
    let first = if said.length > lines { said.length - lines } else { 0 }
    let mut j: usize = 0
    while j < lines {
      let at = first + j
      let id = usize.toU32(j)
      run batch.setText(V_SAID_TEXT + id, if at < said.length { said[at].view() } else { "" })
      j = j + 1
    }
    let mutations = run batch.take()
    run view.send(mutations.asSlice())
  }

  /// Handles the clicks the panel's view sent back.
  effect fn viewEvents(self: &mut Self, view: &mut View) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut events = List<Event>.make()
    run view.takeEvents(&mut events)
    let list = events.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].kind == EventKind.Click {
        run self.clicked(list[i].target)
      }
      i = i + 1
    }
  }

  effect fn clicked(self: &mut Self, target: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if target == V_SWITCH || target == V_SWITCH_TEXT {
      self.wanted = if self.on { 0 } else { 1 }
    } else if target >= V_FLAVOR && target < V_FLAVOR + usize.toU32(FLAVORS) {
      run self.setFlavor(flavorAt(u32.toUsize(target - V_FLAVOR)))
    } else if target >= V_FLAVOR_TEXT && target < V_FLAVOR_TEXT + usize.toU32(FLAVORS) {
      run self.setFlavor(flavorAt(u32.toUsize(target - V_FLAVOR_TEXT)))
    } else if target == V_SPEECH || target == V_SPEECH_TEXT {
      let speaking = !self.speaking
      run self.setSpeech(speaking)
    } else if target == V_CAPTIONS || target == V_CAPTIONS_TEXT {
      let captions = !self.captions
      self.setCaptions(captions)
    } else if target >= V_COMMAND && target < V_COMMAND + usize.toU32(NAMED) {
      run self.perform(commandAt(u32.toUsize(target - V_COMMAND)))
    } else if target >= V_COMMAND_TEXT && target < V_COMMAND_TEXT + usize.toU32(NAMED) {
      run self.perform(commandAt(u32.toUsize(target - V_COMMAND_TEXT)))
    }
  }
}

fn rowStyle() -> [Declaration; 4] {
  return [
    css.display(Keyword.Flex),
    css.flexWrap(FlexWrap.Wrap),
    css.gap(px(6.0)),
    css.flexDirection(FlexDirection.Row),
  ]
}

/// The devtools' look: a chosen button in their amber accent.
fn chosen(on: bool) -> [Declaration; 2] {
  return [
    css.backgroundColor(color.rgba(if on { 0xffb02033 } else { 0x8080801f })),
    css.color(color.rgba(if on { 0xffb020ff } else { 0xedededff })),
  ]
}

/// A button `id` with text node `text` under `parent`.
effect fn button(batch: &mut Batch, parent: u32, id: u32, text: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run batch.box(
    parent,
    id,
    &[
      css.paddingTop(px(4.0)),
      css.paddingBottom(px(4.0)),
      css.paddingLeft(px(8.0)),
      css.paddingRight(px(8.0)),
      css.borderRadius(px(6.0)),
      css.backgroundColor(color.rgba(0x8080801f)),
    ],
  )
  run batch.attribute(id, Attribute.Role { value: Role.Button })
  run batch.attribute(id, Attribute.TabIndex { value: 0 })
  run batch.listen(id, LISTEN_CLICK)
  run batch.text(id, text, "")
}

impl ExtensionHandler for ScreenReader {
  effect fn command(self: &mut Self, name: string, request: &Value, out: &mut String) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if name == "state" {
      run begin(&mut out, request)
      run self.describe(&mut out)
      run finish(&mut out)
      return true
    }
    if name == "set" {
      let named = textField(request, "flavor")
      if String.byteLength(named) != 0 {
        match flavorNamed(named) {
          Option<Flavor>.Some { value } => run self.setFlavor(value)
          Option<Flavor>.None => {
            run failure(&mut out, request, "no such flavor: nvda, voiceover, jaws, narrator or orca")
            return true
          }
        }
      }
      if has(request, "speech") {
        run self.setSpeech(flagField(request, "speech", true))
      }
      if has(request, "captions") {
        self.setCaptions(flagField(request, "captions", true))
      }
      if has(request, "on") {
        self.wanted = if flagField(request, "on", true) { 1 } else { 0 }
      }
      run begin(&mut out, request)
      run putFlag(&mut out, "on", if self.wanted >= 0 { self.wanted == 1 } else { self.on })
      run putText(&mut out, "flavor", flavorName(self.reader.flavor()))
      run finish(&mut out)
      return true
    }
    if name == "do" {
      let index = commandIndex(textField(request, "command"))
      if index >= NAMED {
        run failure(&mut out, request, "no such command; screen-reader.state lists them")
        return true
      }
      let before = self.reader.history().length
      run self.perform(commandAt(index))
      run begin(&mut out, request)
      run putFlag(&mut out, "on", self.on)
      run putKey(&mut out, "said")
      run out.append("[")
      let said = self.reader.history()
      let mut i = if self.on { before } else { said.length }
      let start = i
      while i < said.length {
        if i > start {
          run out.append(",")
        }
        run writeString(&mut out, said[i].view())
        i = i + 1
      }
      run out.append("]")
      run finish(&mut out)
      return true
    }
    if name == "transcript" {
      let since = numberField(request, "since", 0.0)
      let said = self.reader.history()
      run begin(&mut out, request)
      run putKey(&mut out, "lines")
      run out.append("[")
      let mut first = true
      let mut i: usize = 0
      while i < said.length {
        if f32.toF64(since) < usize.toF64(i + 1) {
          if !first {
            run out.append(",")
          }
          first = false
          run out.append("{\"n\":")
          run writeInt(&mut out, usize.toU64(i + 1))
          run out.append(",\"text\":")
          run writeString(&mut out, said[i].view())
          run out.append("}")
        }
        i = i + 1
      }
      run out.append("]")
      run finish(&mut out)
      return true
    }
    return false
  }

  effect fn topics(self: &mut Self, news: &mut News) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.announced == self.revision {
      return ()
    }
    self.announced = self.revision
    let mut members = run String.copy("{\"revision\":")
    run writeInt(&mut members, self.revision)
    run members.append("}")
    run news.post("changed", members.view())
  }

  effect fn view(self: &mut Self, panel: string, view: &mut View) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if panel != PANEL {
      return ()
    }
    if !view.open {
      self.viewBuilt = false
      return ()
    }
    run self.viewEvents(&mut view)
    if view.fresh || !self.viewBuilt {
      run self.buildView(&mut view)
    }
    run self.updateView(&mut view)
  }
}
