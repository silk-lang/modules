fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length { if a[i] != b[i] { return false } i = i + 1 }
  return true
}

fn startsWith(a: &[u8], prefix: &[u8]) -> bool {
  if a.length < prefix.length { return false }
  let mut i: usize = 0
  while i < prefix.length { if a[i] != prefix[i] { return false } i = i + 1 }
  return true
}

effect fn say(out: &mut List<u8>, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator { run out.appendSlice(bytes) }

/// The optimized, verified SSA text of the function `source` evaluates to, or a line saying why
/// there is none ("refused: ...", "verify: ...").
unsafe effect fn describe<'m>(engine: &mut Engine<'m, NoHostServices>, context: *mut HeapHeader, source: &[u8], withInput: bool, passes: u32, header: u32, out: &mut List<u8>) -> ()
  ! JsException | OutOfMemoryError ? &mut Allocator {
  let memory = engine.memory
  let result = run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"ssa.js", 0)
  match ObjectRef.of(result.borrow()).functionCode() {
    Option.Some { value: cell } => {
      let anchor = ()
      let input = run inputOf(cell.get(&anchor))
      if withInput {
        run say(&mut out, b"input: args ") run ssa.number(&mut out, input.argumentCount)
        run say(&mut out, b" locals ") run ssa.number(&mut out, input.localCount)
        run say(&mut out, b" closure ") run ssa.number(&mut out, input.closureVars)
        run say(&mut out, b" scope ") run ssa.number(&mut out, input.scopeSlots)
        if input.normal { run say(&mut out, b" normal code") } else { run say(&mut out, b" special code") }
        let mut i: usize = 0
        while i < input.code.length() { run say(&mut out, b" ") run ssa.number(&mut out, u8.toU32(input.code.get(i))) i = i + 1 }
        run say(&mut out, b"\n")
      }
      // header: NONE for the function's own code, or the loop header an OSR artefact enters at.
      let attempt = if header == NONE { run Effect.result(translate(&input)) } else { run Effect.result(translateOsr(&input, header, false)) }
      match move attempt {
        Result.Success { value: translated } => {
          let mut f = move translated
          let none = List<u32>.make()
          run ssa_opt.pipeline(&mut f, &input, passes, &none)
          match move run Effect.result(verify(&f)) {
            Result.Success { .. } => { run f.print(&mut out) }
            Result.Failure { error } => {
              match move error {
                VerifyError { reason, .. } => { run say(&mut out, b"verify: ") run say(&mut out, reason) }
                OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
              }
            }
          }
        }
        Result.Failure { error } => {
          match move error {
            Refusal { reason, .. } => { run say(&mut out, b"refused: ") run say(&mut out, reason) }
            OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
          }
        }
      }
    }
    Option.None => { run say(&mut out, b"not a function") }
  }
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), Value.intoBits(move result))
}

/// Runs `source` in a fresh engine (a runtime instance of its own) and describes the function it evaluates to.
effect fn ssaOf(source: &[u8], withInput: bool, passes: u32, header: u32) -> List<u8> ! OutOfMemoryError | SynchronizationError | JsException {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: NoHostServices {} }
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut out = List<u8>.make()
  let checked = run Effect.result(unsafe describe(&mut engine, context, source, withInput, passes, header, &mut out)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), JsException | OutOfMemoryError>.Success { value: _ } => ()
    Result<(), JsException | OutOfMemoryError>.Failure { error } => { fail move error }
  }
  return move out
}

/// The ownership pass alone.
effect fn expectSsa(source: &[u8], expected: &[u8], message: string<'static>) -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectPasses(source, 0, expected, message)
}
/// The ownership pass and the code quality passes `passes` names (ssa_opt).
effect fn expectPasses(source: &[u8], passes: u32, expected: &[u8], message: string<'static>) -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectAt(source, passes, NONE, expected, message)
}
/// The same for the code entered at the loop header at bytecode offset `header` (NONE: the
/// function's own code).
effect fn expectAt(source: &[u8], passes: u32, header: u32, expected: &[u8], message: string<'static>) -> ()
  ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let got = run ssaOf(source, false, passes, header)
  if !same(got.asSlice(), expected) {
    StderrWriter.print("{}\n--- got:\n{}\n--- expected:\n{}\n", &.(unsafe String.fromUtf8Unchecked(source),
      unsafe String.fromUtf8Unchecked(got.asSlice()), unsafe String.fromUtf8Unchecked(expected)))
  }
  run Testing.expect(same(got.asSlice(), expected), message)
}

