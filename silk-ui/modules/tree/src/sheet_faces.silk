import engine { UiTree }
import style_sheets
import ui_text.set { FaceRule, UnicodeRange, FontDisplay }
import svg_fonts.database { Range, FaceStyle }
import svg_fonts.names { same }
import font_collection.lib { Family }
import svg_css.sheet_fonts { FontFaceRule, FaceSource, FaceStyle as SheetStyle, FontDisplay as SheetDisplay }
import svg_css.sheet_fonts
import svg_css.sheet_binary { Writer }
import svg_css.tokens { equal }
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.usize

pub struct Alias { pub root: u32, pub name: Bytes, pub privateName: Bytes, pub active: bool }
pub union Source { Url { pub url: String }, Local { pub name: Bytes } }
pub struct Entry { pub alias: usize, pub signature: Bytes, pub id: u32, pub sources: List<Source>, pub next: usize, pub wanted: bool, pub order: usize }
pub struct Registry { pub aliases: List<Alias>, pub entries: List<Entry> }
impl Registry {
  pub fn make() -> Registry { return Registry { aliases: List<Alias>.make(), entries: List<Entry>.make() } }
}

struct Pending { family: Bytes, signature: Bytes, rule: FaceRule, sources: List<Source> }

effect fn faceRule(rule: &FontFaceRule) -> FaceRule ! OutOfMemoryError ? &mut Allocator {
  let weight = match rule.weight { Option.Some { value } => Range { min: value.min, max: value.max } _ => Range.point(400.0) }
  let mut result = run FaceRule.make(rule.family.asSlice(), weight)
  if let Option.Some { value } = rule.width { result.width = Range { min: value.min, max: value.max } }
  result.display = match rule.display {
    SheetDisplay.Block => FontDisplay.Block
    SheetDisplay.Swap => FontDisplay.Swap
    SheetDisplay.Fallback => FontDisplay.Fallback
    SheetDisplay.Optional => FontDisplay.Optional
    _ => FontDisplay.Auto
  }
  result.style = match rule.style {
    Option.Some { value: SheetStyle.Italic } => FaceStyle.Italic
    Option.Some { value: SheetStyle.Oblique { min, max } } => FaceStyle.Oblique { min: min, max: max }
    _ => FaceStyle.Normal
  }
  let mut i: usize = 0
  while i < rule.ranges.length() {
    let range = rule.ranges.asSlice()[i]
    run result.ranges.append(UnicodeRange { first: range.start, last: range.end })
    i = i + 1
  }
  return move result
}

effect fn pending(tree: &UiTree<'_>) -> List<Pending> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Pending>.make()
  let at = style_sheets.index(tree.styleSheets.asSlice(), tree.current)
  if at == usize.MAX { return move result }
  let sheets = &tree.styleSheets.asSlice()[at].sheets
  let faces = run sheets.fontFaces()
  let mut i: usize = 0
  while i < faces.length() {
    let item = faces.get(i)
    let rule = &sheets.sheets()[item.sheet].sheet.fontFaces.asSlice()[item.rule].rule
    let mut sources = List<Source>.make()
    let mut source: usize = 0
    while source < rule.sources.length() {
      match &rule.sources.asSlice()[source] {
        FaceSource.Url { url, format, tech } => {
          if String.byteLength(String.view(&url)) != 0 && sheet_fonts.loadable(format.asSlice(),tech.asSlice()) {
            run sources.append(Source.Url { url: run String.copy(String.view(&url)) })
          }
        }
        FaceSource.Local { name } => run sources.append(Source.Local { name: run Bytes.copy(name.asSlice()) })
      }
      source = source + 1
    }
    if sources.length() != 0 {
      let mut signature = Writer.make()
      run sheet_fonts.encode(rule,&mut signature)
      run result.append(Pending { family: run Bytes.copy(rule.family.asSlice()), signature: move signature.bytes, rule: run faceRule(rule), sources: move sources })
    }
    i = i + 1
  }
  return move result
}

effect fn alias(registry: &mut Registry, root: u32, name: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < registry.aliases.length() {
    let item = &registry.aliases.asSlice()[i]
    if item.root == root && same(item.name.asSlice(),name) { return i }
    i = i + 1
  }
  let mut suffix = Bytes.make()
  let mut value = registry.aliases.length()
  let digits = b"0123456789"
  while true {
    run suffix.append(&[digits[value % 10]])
    value = value / 10
    if value == 0 { break }
  }
  let mut privateName = run Bytes.copy(b"\0silk-sheet-font-")
  let mut digit = suffix.length()
  while digit > 0 { digit = digit - 1 run privateName.append(&[suffix.asSlice()[digit]]) }
  let index = registry.aliases.length()
  run registry.aliases.append(Alias { root: root, name: run Bytes.copy(name), privateName: move privateName, active: false })
  return index
}

pub fn original<'a>(registry: &'a Registry, name: &[u8]) -> Option<&'a Alias> {
  let mut i: usize = 0
  while i < registry.aliases.length() {
    let item = &registry.aliases.asSlice()[i]
    if equal(item.privateName.asSlice(),name) { return Option<&'a Alias>.some(item) }
    i = i + 1
  }
  return Option<&'a Alias>.None
}

pub effect fn mapFamilies(registry: &Registry, root: u32, families: &mut List<Family>) ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < families.length() {
    let mut found = usize.MAX
    if let Family.Named { name } = &families.asSlice()[i] {
      let mut a: usize = 0
      while a < registry.aliases.length() {
        let item = &registry.aliases.asSlice()[a]
        if item.root == root && item.active && same(item.name.asSlice(),name.asSlice()) { found = a break }
        a = a + 1
      }
    }
    if found != usize.MAX {
      let name = run Bytes.copy(registry.aliases.asSlice()[found].privateName.asSlice())
      let entries = families.asMutSlice()
      entries[i] = Family.Named { name: move name }
    }
    i = i + 1
  }
}

pub effect fn sync(tree: &mut UiTree<'_>) ! OutOfMemoryError ? &mut Allocator {
  let root = tree.current
  let mut wanted = run pending(&tree)
  let mut i: usize = 0
  while i < tree.sheetFaces.entries.length() {
    let entries = tree.sheetFaces.entries.asMutSlice()
    if tree.sheetFaces.aliases.asSlice()[entries[i].alias].root == root { entries[i].wanted = false }
    i = i + 1
  }
  let mut order: usize = 0
  while wanted.length() != 0 {
    let mut item = wanted.remove(0)
    let family = run alias(&mut tree.sheetFaces, root, item.family.asSlice())
    let mut found = usize.MAX
    i = 0
    while i < tree.sheetFaces.entries.length() {
      let entry = &tree.sheetFaces.entries.asSlice()[i]
      if entry.alias == family && equal(entry.signature.asSlice(), item.signature.asSlice()) { found = i break }
      i = i + 1
    }
    if found == usize.MAX {
      item.rule.family = run Bytes.copy(tree.sheetFaces.aliases.asSlice()[family].privateName.asSlice())
      let mut source: usize = 0
      let mut url = String.make()
      let mut local = Option<Bytes>.None
      while source < item.sources.length() {
        let candidate = &item.sources.asSlice()[source]
        source = source + 1
        match &candidate.* {
          Source.Url { url: value } => { url = run String.copy(String.view(&value)) break }
          Source.Local { name } => {
            if tree.provider.text.fonts.set.installedFace(name.asSlice()).isSome() { local = Option<Bytes>.some(run Bytes.copy(name.asSlice())) break }
          }
        }
      }
      let id = run tree.declareHostFontFace(move item.rule, String.view(&url))
      found = tree.sheetFaces.entries.length()
      run tree.sheetFaces.entries.append(Entry { alias: family, signature: move item.signature, id: id, sources: move item.sources, next: source, wanted: true, order: order })
      if let Option.Some { value } = &local { drop run tree.loadLocalHostFontFace(id,value.asSlice()) }
      else if String.byteLength(String.view(&url)) == 0 { tree.failFontFace(id) }
    }
    let entries = tree.sheetFaces.entries.asMutSlice()
    entries[found].wanted = true
    entries[found].order = order
    order = order + 1
  }
  i = 0
  while i < tree.sheetFaces.aliases.length() {
    if tree.sheetFaces.aliases.asSlice()[i].root == root {
      let mut active = false
      let mut e: usize = 0
      while e < tree.sheetFaces.entries.length() {
        let entry = &tree.sheetFaces.entries.asSlice()[e]
        active = active || entry.alias == i && entry.wanted
        e = e + 1
      }
      let aliases = tree.sheetFaces.aliases.asMutSlice()
      aliases[i].active = active
    }
    i = i + 1
  }
  i = 0
  while i < tree.sheetFaces.entries.length() {
    let entry = &tree.sheetFaces.entries.asSlice()[i]
    if tree.sheetFaces.aliases.asSlice()[entry.alias].root == root {
      let id = entry.id
      let active = entry.wanted
      let rank = entry.order
      run tree.setHostFontFaceActive(id,active,rank)
    }
    i = i + 1
  }
}

pub effect fn close(tree: &mut UiTree<'_>, root: u32) ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < tree.sheetFaces.entries.length() {
    let entry = &tree.sheetFaces.entries.asSlice()[i]
    if tree.sheetFaces.aliases.asSlice()[entry.alias].root == root {
      let id = entry.id
      let rank = entry.order
      run tree.setHostFontFaceActive(id,false,rank)
      let entries = tree.sheetFaces.entries.asMutSlice()
      entries[i].wanted = false
    }
    i = i + 1
  }
  i = 0
  while i < tree.sheetFaces.aliases.length() {
    let aliases = tree.sheetFaces.aliases.asMutSlice()
    if aliases[i].root == root { aliases[i].active = false }
    i = i + 1
  }
}

pub fn retryable(registry: &Registry, id: u32) -> bool {
  let mut i: usize = 0
  while i < registry.entries.length() {
    let entry = &registry.entries.asSlice()[i]
    if entry.id == id { return entry.wanted && entry.next < entry.sources.length() }
    i = i + 1
  }
  return false
}

pub effect fn retry(tree: &mut UiTree<'_>) ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < tree.sheetFaces.entries.length() {
    let id = tree.sheetFaces.entries.asSlice()[i].id
    while tree.sheetFaces.entries.asSlice()[i].wanted && tree.hostFontFaceFailed(id)
      && tree.sheetFaces.entries.asSlice()[i].next < tree.sheetFaces.entries.asSlice()[i].sources.length() {
      let entry = &tree.sheetFaces.entries.asSlice()[i]
      let mut local = Option<Bytes>.None
      let mut url = Option<String>.None
      match &entry.sources.asSlice()[entry.next] {
        Source.Local { name } => { local = Option<Bytes>.some(run Bytes.copy(name.asSlice())) }
        Source.Url { url: value } => { url = Option<String>.some(run String.copy(String.view(&value))) }
      }
      let entries = tree.sheetFaces.entries.asMutSlice()
      entries[i].next = entries[i].next + 1
      if let Option.Some { value } = &local { drop run tree.loadLocalHostFontFace(id,value.asSlice()) }
      if let Option.Some { value } = &url { run tree.retryHostFontFace(id,String.view(&value)) }
    }
    i = i + 1
  }
}
