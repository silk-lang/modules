static fn presentOf<W: Wasm>() -> bool { return Wasm.present() }
static fn nativeFiles<F: Files>() -> bool { return Files.native() }
static fn directFiles<F: Files>() -> bool { return Files.direct() }
static fn presentFiles<F: Files>() -> bool { return Files.present() }
static fn presentCompression<Z: Compression>() -> bool { return Compression.present() }
static fn presentHttp2<H: Http2>() -> bool { return Http2.present() }
static fn presentCrypto<K: Crypto>() -> bool { return Crypto.present() }
static fn presentTls<T: Tls>() -> bool { return Tls.present() }
static fn presentDatabase<D: Database>() -> bool { return Database.present() }
static fn presentAddons<N: NativeAddons>() -> bool { return NativeAddons.present() }
static fn presentProcesses<R: Processes>() -> bool { return Processes.present() }
static fn presentNetwork<E: Network>() -> bool { return Network.present() }
static fn presentHttp<L: Http>() -> bool { return Http.present() }
static fn presentSystemInfo<S: SystemInfo>() -> bool { return SystemInfo.present() }
static fn presentTypeStripping<Y: TypeStripping>() -> bool { return TypeStripping.present() }
static fn presentWorkers<X: Workers>() -> bool { return Workers.present() }
static fn presentInspector<I: Inspector>() -> bool { return Inspector.present() }

