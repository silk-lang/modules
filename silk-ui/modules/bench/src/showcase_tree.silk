//! The CSS showcase app's tree (react-demo), rendered to markup and generated by a script.
import ui_tree.lib { BoxNode, Tree, TreeError, Attribute }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// Builds the showcase under `root`; returns the app's top box.
pub effect fn build(tree: &mut Tree<'_>, root: BoxNode) -> BoxNode ! TreeError | OutOfMemoryError ? &mut Allocator {
  let n1 = run tree.box(&[])
  run tree.setAttribute(n1, Attribute.ClassName { value: run String.copy("absolute inset-0 flex flex-col gap-3.5 bg-canvas p-5 font-sans text-ink transition-colors duration-500  ") })
  run tree.append(root, n1)
  let n2 = run tree.box(&[])
  run tree.setAttribute(n2, Attribute.ClassName { value: run String.copy("flex h-9 shrink-0 items-center gap-3") })
  run tree.append(n1, n2)
  let n3 = run tree.box(&[])
