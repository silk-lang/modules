//! The capability graph's task, run from this directory:
//!
//!   silk task graph                      # writes ../../docs/capability-graph.md
//!   silk task graph --check              # fails on an edge across services that is not in the list
//!   silk task graph --sizes ../../build  # first records that build's linked sizes
//!   silk task symbols --binary ../../build/embed-smoke/embed-smoke --prefix wasm_runtime_ --absent
//!   silk task image --program ../../build/embed-smoke-wamr/embed-smoke-wamr
//!   silk task tls-stdlib                 # writes ../../build/stdlib-tls for cli/src/main_silk_tls.silk
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import graph
import image

union Tasks {
  Graph { pub check: bool, pub sizes: Option<Bytes>, pub profile: Option<Bytes> },
  Symbols { pub binary: Bytes, pub prefix: Bytes, pub absent: bool },
  Image { pub program: Bytes },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "The composable runtime's capability graph")
      |> Command.variant("Graph", "Write the runtime's capability graph, docs/capability-graph.md")
      |> Command.option(
        "check",
        Opt.about(
          "Write nothing; fail on a new edge across services or a report that is out of date",
        ),
      )
      |> Command.option(
        "sizes",
        Opt.about(
          "A tools/build.py build directory, relative to the runtime: record its linked sizes first",
        ),
      )
      |> Command.option("profile", Opt.about("How that build was made, for the report"))
      |> Command.variant("Symbols", "Check that a linked program has, or with --absent lacks, symbols starting with a prefix")
      |> Command.option("binary", Opt.about("The program, relative to this directory") |> Opt.required)
      |> Command.option("prefix", Opt.about("The symbol prefix, such as wasm_runtime_ for WAMR") |> Opt.required)
      |> Command.option("absent", Opt.about("Fail when any such symbol is there, rather than when none is"))
      |> Command.variant("Image", "Have an embedding program write its heap image, and append it to the program")
      |> Command.option("program", Opt.about("The embedding program, relative to this directory") |> Opt.required)
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Graph { check, sizes, profile } => run graph.perform(check, move sizes, move profile)
      Tasks.Symbols { binary, prefix, absent } => run graph.symbols(binary.asSlice(), prefix.asSlice(), absent)
      Tasks.Image { program } => run image.image(program.asSlice())
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
