        drop s2
        let rv = unsafe terminateSession(sp, PROTOCOL_ERROR, b"unexpected non-CONTINUATION frame or stream_id is invalid")
        if isFatal(rv) { return i32.toI64(rv) }
        return inlen
      }
      s2.hdFlags = u8.bitOr(s2.hdFlags, u8.bitAnd(contFlags, F_END_HEADERS))
      s2.hdLength = s2.hdLength + contLength
      s2.ib = if st == IB_EXPECT_CONTINUATION { IB_READ_HEADER_BLOCK } else { IB_IGN_HEADER_BLOCK }
      busy = true
    } else if st == IB_READ_PAD_DATA {
      let readlen = unsafe bufRead(sp, input, at, end)
      at = at + readlen
      let s = unsafe ses(&mut a, sp) s.payloadLeft = s.payloadLeft - readlen let id = s.hdStream let flags = s.hdFlags let remaining = s.payloadLeft drop s
      if unsafe markAvail(sp) > 0 { return usize.toI64(at) }
      let rv = unsafe updateRecvConnectionWindow(sp, readlen)
      if isFatal(rv) { return i32.toI64(rv) }
      if unsafe state(sp) == IB_IGN_ALL { return inlen }
      let rv2 = unsafe consumeInternal(sp, id, readlen)
      if isFatal(rv2) { return i32.toI64(rv2) }
      if unsafe state(sp) == IB_IGN_ALL { return inlen }
      let found = unsafe findStream(sp, id)
      if !Pointer.isNull<Stream>(found) {
        let rv3 = unsafe updateRecvStreamWindow(sp, unsafe nonnull(found), readlen, remaining > 0 || u8.bitAnd(flags, F_END_STREAM) == 0)
        if isFatal(rv3) { return i32.toI64(rv3) }
      }
      busy = true
      if unsafe computePad(sp) < 0 {
        let rv4 = unsafe terminateSession(sp, PROTOCOL_ERROR, b"DATA: invalid padding")
        if isFatal(rv4) { return i32.toI64(rv4) }
        return inlen
      }
      unsafe setState(sp, IB_READ_DATA)
    } else if st == IB_READ_DATA {
      let s = unsafe ses(&mut a, sp) let id = s.hdStream let flags = s.hdFlags drop s
      let found = unsafe findStream(sp, id)
      if Pointer.isNull<Stream>(found) { busy = true unsafe setState(sp, IB_IGN_DATA) }
      else {
        let p = unsafe nonnull(found)
        let readlen = unsafe payloadReadLen(sp, at, end)
        let s2 = unsafe ses(&mut a, sp) s2.payloadLeft = s2.payloadLeft - readlen let remaining = s2.payloadLeft drop s2
        let chunk = at
        at = at + readlen
        let mut handled = false
        if readlen > 0 {
          let rv = unsafe updateRecvConnectionWindow(sp, readlen)
          if isFatal(rv) { return i32.toI64(rv) }
          if unsafe state(sp) == IB_IGN_ALL { return inlen }
          let rv2 = unsafe updateRecvStreamWindow(sp, p, readlen, remaining > 0 || u8.bitAnd(flags, F_END_STREAM) == 0)
          if isFatal(rv2) { return i32.toI64(rv2) }
          let mut dataReadlen = unsafe effectiveReadlen(sp, remaining, readlen)
          if dataReadlen == -1 { dataReadlen = 0 }
          let padlen = usize.toI64(readlen) - dataReadlen
          if padlen > 0 {
            let rv3 = unsafe consumeInternal(sp, id, i64.toUsize(padlen))
            if isFatal(rv3) { return i32.toI64(rv3) }
            if unsafe state(sp) == IB_IGN_ALL { return inlen }
          }
          if dataReadlen > 0 {
            let mut b = () let t = unsafe str(&mut b, p) let bad = onDataChunk(&mut t.*, i64.toUsize(dataReadlen)) != 0 drop t
            if bad {
