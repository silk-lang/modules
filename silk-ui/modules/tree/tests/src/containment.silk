//! `contain` and `content-visibility`: size containment, paint clipping, and hidden contents.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, FrameInput, CpuSnapshot }
import ui_fixtures.fixtures as fixtures
import svg_css.written
import svg_css.tokens { CssError }
import vector.geometry_error { GeometryError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.f32

fn frame() -> FrameInput { return FrameInput { width: 200.0, height: 200.0, scale: 1.0, time: 0.0 } }

fn height(tree: &UiTree<'_>, id: u32) -> f32 {
  let node = tree.node(tree.slotOf(id))
  return tree.output.fragments.values.asSlice()[tree.fragmentOf.get(node.css)].size.height
}

/// Root 1 holds box 2 (the subject) holding a 60px red child 3 and an absolute blue child 4.
effect fn build(tree: &mut UiTree<'_>, subject: &[u8]) ! TreeError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"display:block;width:200px;height:200px;background-color:white")
  run batch.style(1, root.asSlice())
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  let own = run written.declarations(subject)
  run batch.style(2, own.asSlice())
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  let child = run written.declarations(b"display:block;width:50px;height:60px;background-color:red")
  run batch.style(3, child.asSlice())
  run batch.create(4, NodeKind.Box)
  run batch.append(2, 4)
  let placed = run written.declarations(b"position:absolute;left:100px;top:40px;width:20px;height:20px;background-color:blue")
  run batch.style(4, placed.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
}

effect fn containment() ! TreeError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()

  let mut sized = run UiTree.make(&fonts)
  run build(&mut sized, b"display:block;contain:size")
  run Testing.expect(height(&sized, 2) == 0.0 && height(&sized, 3) == 60.0, "contain: size lays out as if empty")

  let mut both = run UiTree.make(&fonts)
  run build(&mut both, b"display:block;container-type:inline-size;contain:size;contain:none")
  run Testing.expect(height(&both, 2) == 60.0 && both.node(both.slotOf(2)).computed().layout.containsSize(true), "contain: none keeps container-type's containment")

  let mut painted = run UiTree.make(&fonts)
  run build(&mut painted, b"display:block;position:relative;height:20px;contain:paint")
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut painted)
  let clipped = run snapshot.render(&painted)
  run Testing.expect(clipped.pixel(10, 10).r > 250 && clipped.pixel(10, 10).g < 5, "contents inside the box paint")
  run Testing.expect(clipped.pixel(10, 40).g > 250, "contain: paint clips flowing contents")
  run Testing.expect(clipped.pixel(110, 50).r > 250 && clipped.pixel(110, 50).b > 250, "and positioned ones it contains")
  run Testing.expect(painted.hitTest(10.0, 10.0) == 3 && painted.hitTest(10.0, 40.0) == 1, "clipped contents are not hit")

  // Layout and paint containment make the box the containing block of the absolute child.
  let mut laidOut = run UiTree.make(&fonts)
  run build(&mut laidOut, b"display:block;margin-left:20px;height:20px;contain:layout")
  let mut third = CpuSnapshot.make()
  run third.sync(&mut laidOut)
  let placed = run third.render(&laidOut)
  run Testing.expect(placed.pixel(135, 50).b > 250 && placed.pixel(105, 50).g > 250, "contain: layout places the absolute child in the box")
  run Testing.expect(laidOut.hitTest(135.0, 50.0) == 4, "and it is hit there")
  let mut unpositioned = run UiTree.make(&fonts)
  run build(&mut unpositioned, b"display:block;margin-left:20px;height:20px;contain:paint")
  let mut fourth = CpuSnapshot.make()
  run fourth.sync(&mut unpositioned)
  let cut = run fourth.render(&unpositioned)
  run Testing.expect(cut.pixel(135, 50).g > 250 && cut.pixel(105, 50).g > 250, "contain: paint clips the absolute child without position")

  let mut hidden = run UiTree.make(&fonts)
  run build(&mut hidden, b"display:block;height:100px;content-visibility:hidden;background-color:lime")
  let mut second = CpuSnapshot.make()
  run second.sync(&mut hidden)
  let shown = run second.render(&hidden)
  let own = shown.pixel(10, 10)
  run Testing.expect(own.g > 250 && own.r < 5, "content-visibility: hidden still paints the box itself")
  run Testing.expect(shown.pixel(110, 50).g > 250 && shown.pixel(110, 50).b < 5, "but none of its contents")
  run Testing.expect(hidden.hitTest(10.0, 10.0) == 2, "hits land on the box, not its contents")
  let auto = run written.declarations(b"display:block;height:100px;content-visibility:visible;background-color:lime")
  let mut batch = Batch.make()
  run batch.style(2, auto.asSlice())
  run hidden.apply(run batch.take())
  run hidden.frame(frame())
  run second.sync(&mut hidden)
  let back = run second.render(&hidden)
  run Testing.expect(back.pixel(10, 10).r > 250 && back.pixel(10, 10).g < 5, "visible draws the contents again")
}

test effect fn containSizePaintAndContentVisibility() ! TreeError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run containment() |> Effect.provideMut<Allocator>(&mut allocator)
}
