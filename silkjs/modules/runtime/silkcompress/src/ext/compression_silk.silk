// The write op: codec calls from the caller's input into its output, while the codec asks to go
// on and the output has room. The input and output are the caller's bytes or their staging
// copies; nothing here copies them.
unsafe fn runWrite(j: &mut Job, h: &mut CodecState) -> () {
  let base = j.source let total = j.sourceLength let out = j.target let room = j.capacity
  let mut consumed: usize = 0 let mut written: usize = 0
