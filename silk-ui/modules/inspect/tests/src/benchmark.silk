//! Repeated inspector queries, node descriptions and overlays over the inbox fixture.
//! Run from the repository root. The application remains unoptimized when comparing
//! package overrides for ui_tree and ui_inspect; PNG encoding is outside this workload.
import ui_fixtures.fixtures as fixtures
import ui_inspect.lib { Query, Highlight, InspectOptions, queryAll, inspectNode, compose }
import ui_tree.legacy { UiTree, TreeError, Batch, FrameInput }
import ui_scene.scene { Scene }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

effect fn benchmark() -> i32
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.inbox(&mut batch)
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.0 })
  let query = Query.any()
  let mut highlight = Highlight.make()
  run highlight.nodes.append(fixtures.ARCHIVE_BUTTON)
  run highlight.selected.append(fixtures.NESTED)
  let mut total: usize = 0
  let mut iteration: usize = 0
  while iteration < 5000 {
    let mut nodes = List<u32>.make()
    run queryAll(&tree, &query, &mut nodes)
    let mut text = String.make()
    run inspectNode(&tree, fixtures.ARCHIVE_BUTTON, InspectOptions.all(), &mut text)
    run inspectNode(&tree, fixtures.NESTED, InspectOptions.all(), &mut text)
    let mut scene = Scene.make()
    run compose(&tree, &highlight, &mut scene)
    total = total + nodes.length() + String.utf8Bytes(text.view()).length + scene.operationCount()
    iteration = iteration + 1
  }
  return if total > 5000 {
    0
  } else {
    1
  }
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 2
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(benchmark(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
