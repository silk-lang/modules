// Bytes an update of `length` can write.
fn updateRoom(x: &CipherContext, length: usize) -> usize { return length + 32 }
unsafe fn polyOpenFailed(v: &mut ChaCha20Poly1305Decryptor, shadow: &mut ChaCha20Poly1305Encryptor, input: &[u8], out: &mut [u8]) -> bool {
  let plain = Slice.viewMut<u8>(move out, 0, input.length)
  if aeadFailed(v.update(input, &mut plain)) { return true }
  let scratch = unsafe calloc(1, input.length + 1)
  if Pointer.isNull<u8>(scratch) { return true }
  let mut a = ()
  let sink = unsafe Pointer.borrowManyMut<(), u8>(&mut a, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(scratch)), input.length)
  let failed = aeadFailed(shadow.update(&plain, move sink))
  unsafe free(scratch)
  return failed
}
unsafe fn randomInto(bytes: &mut [u8]) -> () {
  let mut random = OsRandom.make()
  run Random.fillBytes(move bytes) |> Effect.provideMut<Random>(&mut random)
}
fn blockApplyFailed(result: Result<(), BlockCipherError>) -> bool { return match move result { Result<(), BlockCipherError>.Success { .. } => false Result<(), BlockCipherError>.Failure { .. } => true } }
fn ocbFailed(result: Result<usize, AesOcbError>, n: &mut usize) -> bool {
  return match move result { Result<usize, AesOcbError>.Success { value } => { n.* = value false } Result<usize, AesOcbError>.Failure { .. } => true }
}
unsafe fn blockFailed(result: Result<usize, BlockCipherError>, n: &mut usize) -> bool {
  return match move result { Result<usize, BlockCipherError>.Success { value } => { n.* = value false } Result<usize, BlockCipherError>.Failure { .. } => true }
}
// Key wrap and CCM: the whole message in one update.
unsafe fn oneShotUpdate(c: &mut Call, x: &mut CipherContext, input: &[u8]) -> bool {
  match &x.state { CipherState.Pending => () _ => { return unsafe failWith(&mut c.*, b"") } }
  // CTS and XTS need a block: a shorter input fails and leaves the cipher as it was.
  if (x.kind == C_CTS || x.kind == C_XTS) && input.length < 16 { return unsafe failWith(&mut c.*, b"") }
  x.state = CipherState.Consumed
  let anchor = ()
  let key = Slice.view<u8>(&x.key, 0, x.keyLength)
  let iv = unsafe ctxIv(&anchor, &x.*)
  if !unsafe reserve(&mut c.*, input.length + 16) { return false }
  let mut a = ()
  let out = unsafe outputSlice(&mut a, &c.*)
  if x.kind == C_CTS {
    let cipher = match move blocks.makeBlock(x.family, key) { Option<AnyBlock>.Some { value } => move value Option<AnyBlock>.None => { return unsafe failWith(&mut c.*, b"") } }
    let body = Slice.viewMut<u8>(move out, 0, input.length)
    let ok = if x.encrypt { blocks.ctsEncrypt(&cipher, iv, x.variant, input, move body) } else { blocks.ctsDecrypt(&cipher, iv, x.variant, input, move body) }
    if !ok { return unsafe failWith(&mut c.*, b"error:1C80006B:Provider routines::wrong final block length") }
    c.length = input.length
    return true
  }
  if x.kind == C_XTS {
    let body = Slice.viewMut<u8>(move out, 0, input.length)
    let r = if x.encrypt { AesXts.encrypt(key, iv, input, move body) } else { AesXts.decrypt(key, iv, input, move body) }
    return match move r {
      Result<(), AesXtsError>.Success { .. } => { c.length = input.length true }
      Result<(), AesXtsError>.Failure { error } => match move error {
        AesXtsError.DuplicateKeyHalves => unsafe failWith(&mut c.*, b"error:1C800095:Provider routines::xts duplicated keys")
        _ => unsafe failWith(&mut c.*, b"error:1C80006B:Provider routines::wrong final block length")
      }
    }
  }
  if x.kind == C_DES3_WRAP {
    let r = if x.encrypt {
      let mut random: [u8; 8] = [0; 8]
      unsafe randomInto(&mut random)
      TripleDesKeyWrap.wrap(key, &random, input, move out)
    } else { TripleDesKeyWrap.unwrap(key, input, move out) }
    return match move r { Result<usize, TripleDesKeyWrapError>.Success { value } => { c.length = value true } Result<usize, TripleDesKeyWrapError>.Failure { .. } => unsafe failWith(&mut c.*, b"") }
  }
  if x.kind == C_CCM {
    let aad = unsafe ctxAad(&anchor, &x.*)
    let body = Slice.viewMut<u8>(move out, 0, input.length)
    if x.encrypt {
      let length = x.authTagLength
      let r = AesCcm.seal(key, iv, aad, input, move body, Slice.viewMut<u8>(&mut x.tag, 0, length))
      match move r { Result<(), AesCcmError>.Success { .. } => { x.tagLength = length } Result<(), AesCcmError>.Failure { .. } => { return unsafe failWith(&mut c.*, b"") } }
    } else {
      let r = AesCcm.open(key, iv, aad, input, Slice.view<u8>(&x.tag, 0, x.tagLength), move body)
      match move r { Result<(), AesCcmError>.Success { .. } => () Result<(), AesCcmError>.Failure { .. } => { return unsafe failWith(&mut c.*, b"") } }
    }
    c.length = input.length
    return true
  }
  let r = if x.kind == C_WRAP { if x.encrypt { AesKeyWrap.wrap(key, iv, input, move out) } else { AesKeyWrap.unwrap(key, iv, input, move out) } }
    else { if x.encrypt { AesKeyWrap.wrapPadded(key, iv, input, move out) } else { AesKeyWrap.unwrapPadded(key, iv, input, move out) } }
  return match move r { Result<usize, AesKeyWrapError>.Success { value } => { c.length = value true } Result<usize, AesKeyWrapError>.Failure { .. } => unsafe failWith(&mut c.*, b"") }
}
unsafe fn cipherUpdate(c: &mut Call, x: &mut CipherContext, input: &[u8]) -> bool {
  if x.kind == C_WRAP || x.kind == C_WRAP_PAD || x.kind == C_CCM || x.kind == C_CTS || x.kind == C_XTS || x.kind == C_DES3_WRAP { return unsafe oneShotUpdate(&mut c.*, &mut x.*, input) }
  if !unsafe start(&mut x.*) { return unsafe failWith(&mut c.*, b"") }
  x.processed = x.processed + input.length
  if !unsafe reserve(&mut c.*, updateRoom(&x.*, input.length)) { return false }
  let mut anchor = ()
  let out = unsafe outputSlice(&mut anchor, &c.*)
  let mut n = input.length
  let failed = match &mut x.state {
    CipherState.Ecb { v } => aesFailed(v.update(input, move out), &mut n)
    CipherState.Cbc { v } => aesFailed(v.update(input, move out), &mut n)
    CipherState.Cfb { v } => aesApplyFailed(v.apply(input, move out))
    CipherState.Cfb8 { v } => aesApplyFailed(v.apply(input, move out))
    CipherState.Cfb1 { v } => aesApplyFailed(v.apply(input, move out))
    CipherState.Ofb { v } => aesApplyFailed(v.apply(input, move out))
    CipherState.Ctr { v } => aesApplyFailed(v.apply(input, move out))
    CipherState.GcmSeal { v } => gcmFailed(v.update(input, move out))
    CipherState.GcmOpen { v } => gcmFailed(v.update(input, move out))
    CipherState.PolySeal { v } => aeadFailed(v.update(input, move out))
    CipherState.PolyOpen { v, shadow } => unsafe polyOpenFailed(&mut v, &mut shadow, input, move out)
    CipherState.Stream { v } => match move v.apply(input, move out) { Result<(), ChaCha20Error>.Success { .. } => false Result<(), ChaCha20Error>.Failure { .. } => true }
    CipherState.TdesEcb { v } => unsafe blockFailed(v.update(input, move out), &mut n)
    CipherState.TdesCbc { v } => unsafe blockFailed(v.update(input, move out), &mut n)
    CipherState.BEcb { v } => unsafe blockFailed(v.update(input, move out), &mut n)
    CipherState.BCbc { v } => unsafe blockFailed(v.update(input, move out), &mut n)
    CipherState.BCfb { v } => blockApplyFailed(v.apply(input, move out))
    CipherState.BCfb8 { v } => blockApplyFailed(v.apply(input, move out))
    CipherState.BCfb1 { v } => blockApplyFailed(v.apply(input, move out))
    CipherState.BOfb { v } => blockApplyFailed(v.apply(input, move out))
    CipherState.BCtr { v } => blockApplyFailed(v.apply(input, move out))
    CipherState.OcbSeal { v } => ocbFailed(v.update(input, move out), &mut n)
    CipherState.OcbOpen { v } => ocbFailed(v.update(input, move out), &mut n)
    _ => true
  }
  if failed { return unsafe failWith(&mut c.*, b"") }
  c.length = n
  return true
}
unsafe fn cipherFinal(c: &mut Call, x: &mut CipherContext) -> bool {
