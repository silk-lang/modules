//! FlattenIntoArray and flat/flatMap, quickjs.c:44632-44735. Only the
//! top-level flatMap applies its mapper; recursion preserves Has-before-Get.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.num.i64
import js_value { ValueBits }
import js_intl_realm as ops
import js_realm { Realm, Arguments }
import js_core_types { FrameSlots, NativeErrorKind, JS_PROP_C_W_E, JS_PROP_THROW }
import js_gc { HeapHooks }
import js_gc as gc
import js_heap { HeapCell }
import js_core_types { ObjectData, ObjectPayload }
import js_class_data as classes
import silk.num.i32
import js_coercion_host { CoercionHooks }
import js_property_host { OwnPropertyHooks, GetPropertyHooks, HasPropertyHooks }
import js_property_write_host { PropertyWriteHooks }
import js_call_host { CallHooks }
import js_typed_array_methods_array_species as species
import js_array_intrinsics_support as support
import js_array_storage as storage
import js_collection_support as owners
import js_owned_value { Value, ValueRef, immediateRef }
import js_function_invoke as invoke
import js_boxing as boxing
import js_property_get as properties
import js_property_mutations as mutations
import js_integer_coercions as integers
import js_proxy_core as core
import native_stack { currentFrameAddress }
import js_string_types { StringLengthError }
import js_bigint { BigIntError }
import js_exceptions { JsException }
import runtime_memory { AllocationObserver }

effect fn flattenBody<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, realm: Realm<'a>, target: ValueRef<'b>, source: ValueRef<'b>, length: i64, start: i64,
  depth: i32, mapper: ValueRef<'b>, thisArg: ValueRef<'b>) -> i64
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  if realm.stackOverflows(currentFrameAddress(), 0) {
    return run ops.throwError(&mut hooks,realm, NativeErrorKind.Range, b"Maximum call stack size exceeded")
  }
  let mut sourceIndex: i64 = 0 let mut targetIndex = start
  while sourceIndex < length {
    let mut bits = ValueBits.Undefined
    let mut present = unsafe fastElement(source.view(), sourceIndex, &mut bits)
    if !present { present = run properties.tryGetPropertyInt64(&mut hooks, realm, source, sourceIndex, &mut bits) }
    let mut element = unsafe Value.adoptBits(bits)
    if present {
      if !core.undefined(mapper.view()) {
        let mut values = [element.view(), ValueBits.number(i64.toF64(sourceIndex)), source.view()]
        let argv = FrameSlots { data: Pointer.fromMutRef<ValueBits>(&mut values[0]), count: 3 }
        element = run unsafe owners.call(&mut hooks, realm, mapper, thisArg, &argv)
      }
      let mut flatten = false
      let mut elementLength = support.fastCount(element.borrow())
      // A fast Array's length is its element count when all are present:
      // IsArray and the length read then need no generic lookups.
      if depth > 0 && elementLength >= 0 && unsafe fastLength(element.view()) == elementLength { flatten = true }
      else if depth > 0 {
        flatten = run support.isArray(&mut hooks, realm, element.borrow())
        if flatten { run invoke.getLength64(&mut hooks, realm, &mut elementLength, element.borrow()) }
      }
      if flatten {
        // The last level of a fast Array with every index present, into a
        // target that takes appends: each Has and Get reads storage and each
        // CreateDataProperty appends, so one copy does them all.
        let mut copied = false
        if depth == 1 && elementLength >= 0 && support.fastCount(element.borrow()) == elementLength && targetIndex + elementLength <= 2147483647 {
          if let ValueBits.Object { reference: into } = target.view() {
            if let ValueBits.Object { reference: from } = element.view() {
              copied = run unsafe storage.appendDenseGrowing(&mut hooks, realm, into, i64.toUsize(targetIndex), from, 0, i64.toUsize(elementLength))
            }
          }
        }
        if copied { targetIndex = targetIndex + elementLength }
        else {
          targetIndex = run flattenIntoArray(&mut hooks, realm, target, element.borrow(), elementLength, targetIndex, depth - 1, immediateRef(ValueBits.Undefined), immediateRef(ValueBits.Undefined))
        }
        // A mapper's fresh array dies here, most often holding only numbers.
        unsafe gc.releaseLeafCandidate(&mut hooks, realm.runtime(), element.intoBits())
      } else {
        if targetIndex >= 9007199254740991 { return run ops.error(&mut hooks,realm, b"Array too long") }
        // pushOwned takes the reference when it appends and releases it on
        // OOM; otherwise it stays here for the ordinary definition.
        let bits = element.intoBits()
        let mut pushed = false
        if targetIndex < 2147483647 {
          if let ValueBits.Object { reference: into } = target.view() {
            pushed = run unsafe storage.pushOwned(&mut hooks, realm, into, i64.toUsize(targetIndex), bits)
          }
        }
        if !pushed {
          let _written = run mutations.definePropertyValueInt64(&mut hooks, realm, target, targetIndex, unsafe Value.adoptBits(bits), JS_PROP_C_W_E | JS_PROP_THROW)
        }
        targetIndex = targetIndex + 1
      }
    }
    sourceIndex = sourceIndex + 1
  }
  return targetIndex
}
/// The element of source, a fast Array, at index when it holds one: retained
/// into bits. False, with bits unchanged, otherwise.
@inlineAlways
unsafe fn fastElement(source: ValueBits, index: i64, bits: &mut ValueBits) -> bool {
  let node = match source { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  if data.classId() != classes.JS_CLASS_ARRAY || !data.fastArray() || index < 0 { return false }
  return match &data.payload {
    ObjectPayload.FastArray { array } => {
      let at = i64.toUsize(index)
      if at >= array.values().length() { false }
      else { bits.* = unsafe (unsafe array.values().getUnchecked(at)).retained() true }
    }
    _ => false
  }
}
/// The Int length of value, a fast Array (support.fastCount accepted it); -1 otherwise.
@inlineAlways
unsafe fn fastLength(value: ValueBits) -> i64 {
  let node = match value { ValueBits.Object { reference } => reference _ => { return -1 } }
  let anchor = () let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, node)
  return match (unsafe data.slotUnchecked(0)).valueBits() { ValueBits.Int { value: length } => i32.toI64(length) _ => -1 }
}
pub effect fn flattenIntoArray<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, realm: Realm<'a>, target: ValueRef<'b>, source: ValueRef<'b>, length: i64, start: i64,
  depth: i32, mapper: ValueRef<'b>, thisArg: ValueRef<'b>) -> i64 ! JsException ? &mut Allocator {
  let called = run Effect.result(flattenBody(&mut hooks, realm, target, source, length, start, depth, mapper, thisArg))
  let mut index: i64 = -1
  match move called {
    Result<i64, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => { index = value }
    Result<i64, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } => {
      let _pending = run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
    }
  }
  if index < 0 { fail JsException {} }
  return index
}
effect fn body<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>,
  args: Arguments<'a>, mapping: bool) -> ValueBits
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {
  let object = run boxing.toObjectValue(&mut hooks, memory, realm, receiver)
  let mut length: i64 = 0 run invoke.getLength64(&mut hooks, realm, &mut length, object.borrow())
  let mut depth: i32 = 1
  let mut mapper = immediateRef(ValueBits.Undefined) let mut thisArg = immediateRef(ValueBits.Undefined)
  let first = args.get(0).view()
  if mapping {
    mapper = args.get(0) thisArg = args.get(1)
    if !hooks.isCallable(realm, mapper) { return run ops.error(&mut hooks,realm, b"not a function") }
  } else if !core.undefined(first) { run integers.toInt32Sat(&mut hooks, realm, &mut depth, args.get(0)) }
  let created = run species.create(&mut hooks, memory, realm, object.borrow(), 0)
  let _final = run flattenIntoArray(&mut hooks, realm, created.borrow(), object.borrow(), length, 0, depth, mapper, thisArg)
  return created.intoBits()
}
pub effect fn call<'a, 'b, H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + PropertyWriteHooks + CallHooks>(
  hooks: &mut H, memory: &AllocationObserver, realm: Realm<'a>, receiver: ValueRef<'b>,
  args: Arguments<'a>, mapping: bool) -> ValueBits ! JsException ? &mut Allocator {
  let called = run Effect.result(body(&mut hooks, memory, realm, receiver, args, mapping))
  let result = match move called {
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | StringLengthError | BigIntError | JsException>.Failure { error } =>
      run Effect.catch<JsException>(ops.materialize(&mut hooks,realm, move error), core.exceptionValue)
  }
  if result.isException() { fail JsException {} }
  return result
}
