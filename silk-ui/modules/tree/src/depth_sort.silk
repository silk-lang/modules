//! Depth sorting for 3D rendering contexts (`transform-style: preserve-3d`), as Chromium does it
//! (`cc/trees/bsp_tree`, `draw_polygon`): every plane of a context is a convex polygon in the
//! space the context flattens into, after the perspective divide; a BSP tree orders them back
//! to front and splits a polygon that crosses another's plane. The viewer looks down the z
//! axis from positive z, as CSS has it.
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.matrix { Matrix4 }
import silk.geometry.point { Point3 }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.usize

/// The most corners a polygon keeps: a quad cut by the viewer's plane and a few others. A
/// split that would need more leaves the polygon whole.
pub const MAX_POINTS: usize = 16

/// How far from a plane a point still lies on it, in pixels.
const ON_PLANE: f32 = 0.05

/// The smallest `w` a corner keeps after the perspective divide: anything nearer the viewer's
/// plane is behind the viewer or at infinity.
const MIN_W: f32 = 0.00001

/// A convex polygon on plane `plane` (an index into the caller's planes). `whole`: it is the
/// plane's quad as it was, not a piece of it.
pub struct Polygon {
  pub plane: u32,
  pub whole: bool,
  pub count: u32,
  pub x: [f32; 16],
  pub y: [f32; 16],
  pub z: [f32; 16],
}

impl Copy for Polygon {}

impl Polygon {
  fn empty(plane: u32) -> Polygon {
    return Polygon { plane: plane, whole: true, count: 0, x: [0.0; 16], y: [0.0; 16], z: [0.0; 16] }
  }

  fn add(self: &mut Self, x: f32, y: f32, z: f32) -> bool {
    let n = u32.toUsize(self.count)
    if n >= MAX_POINTS {
      return false
    }
    self.x[n] = x
    self.y[n] = y
    self.z[n] = z
    self.count = self.count + 1
    return true
  }

  /// The unit normal (Newell's method), or zero for a polygon without area.
  pub fn normal(self: &Self) -> [f32; 3] {
    let n = u32.toUsize(self.count)
    let mut nx: f32 = 0.0
    let mut ny: f32 = 0.0
    let mut nz: f32 = 0.0
    let mut i: usize = 0
    while i < n {
      let j = if i + 1 == n { 0 } else { i + 1 }
      nx = nx + (self.y[i] - self.y[j]) * (self.z[i] + self.z[j])
      ny = ny + (self.z[i] - self.z[j]) * (self.x[i] + self.x[j])
      nz = nz + (self.x[i] - self.x[j]) * (self.y[i] + self.y[j])
      i = i + 1
    }
    let length = f32.sqrt(nx * nx + ny * ny + nz * nz)
    if length < 0.000001 {
      return [0.0, 0.0, 0.0]
    }
    return [nx / length, ny / length, nz / length]
  }
}

/// The quad `rect` of a plane whose layout space `m` maps into the context's space, cut to
/// what lies in front of the viewer and projected; None when none of it does.
pub fn ofRect(plane: u32, m: &Matrix4<f32>, rect: Rect<f32>) -> Option<Polygon> {
  let xs = [rect.xMin, rect.xMax, rect.xMax, rect.xMin]
  let ys = [rect.yMin, rect.yMin, rect.yMax, rect.yMax]
  let mut h: [[f32; 4]; 4] = [[0.0; 4]; 4]
  let mut k: usize = 0
  while k < 4 {
    h[k] = m.transformHomogeneous(Point3<f32> { x: xs[k], y: ys[k], z: 0.0 })
    k = k + 1
  }
  let mut out = Polygon.empty(plane)
  k = 0
  while k < 4 {
    let a = h[k]
    let b = h[(k + 1) % 4]
    if a[3] > MIN_W {
      drop out.add(a[0] / a[3], a[1] / a[3], a[2] / a[3])
    }
    if (a[3] > MIN_W) != (b[3] > MIN_W) {
      let t = (a[3] - MIN_W) / (a[3] - b[3])
      let w = a[3] + (b[3] - a[3]) * t
      drop out.add(
        (a[0] + (b[0] - a[0]) * t) / w,
        (a[1] + (b[1] - a[1]) * t) / w,
        (a[2] + (b[2] - a[2]) * t) / w,
      )
    }
    k = k + 1
  }
  if out.count < 3 {
    return Option<Polygon>.None
  }
  return Option<Polygon>.some(out)
}

fn distance(n: [f32; 3], origin: [f32; 3], p: &Polygon, i: usize) -> f32 {
  return n[0] * (p.x[i] - origin[0]) + n[1] * (p.y[i] - origin[1]) + n[2] * (p.z[i] - origin[2])
}

const COPLANAR: u8 = 0
const FRONT: u8 = 1
const BACK: u8 = 2
const SPLIT: u8 = 3

fn side(n: [f32; 3], origin: [f32; 3], p: &Polygon) -> u8 {
  let mut front = false
  let mut back = false
  let mut i: usize = 0
  while i < u32.toUsize(p.count) {
    let d = distance(n, origin, p, i)
    if d > ON_PLANE {
      front = true
    } else if d < -ON_PLANE {
      back = true
    }
    i = i + 1
  }
  if front && back {
    return SPLIT
  }
  if front {
    return FRONT
  }
  if back {
    return BACK
  }
  return COPLANAR
}

/// `p` cut by the plane through `origin` with normal `n`: the piece in front, then the piece
/// behind. None when a piece would have too many corners.
fn split(n: [f32; 3], origin: [f32; 3], p: &Polygon) -> Option<[Polygon; 2]> {
  let mut front = Polygon.empty(p.plane)
  let mut back = Polygon.empty(p.plane)
  front.whole = false
  back.whole = false
  let count = u32.toUsize(p.count)
  let mut i: usize = 0
  let mut fits = true
  while i < count {
    let j = if i + 1 == count { 0 } else { i + 1 }
    let a = distance(n, origin, p, i)
    let b = distance(n, origin, p, j)
    if a >= -ON_PLANE {
      fits = fits && front.add(p.x[i], p.y[i], p.z[i])
    }
    if a <= ON_PLANE {
      fits = fits && back.add(p.x[i], p.y[i], p.z[i])
    }
    if (a > ON_PLANE && b < -ON_PLANE) || (a < -ON_PLANE && b > ON_PLANE) {
      let t = a / (a - b)
      let x = p.x[i] + (p.x[j] - p.x[i]) * t
      let y = p.y[i] + (p.y[j] - p.y[i]) * t
      let z = p.z[i] + (p.z[j] - p.z[i]) * t
      fits = fits && front.add(x, y, z) && back.add(x, y, z)
    }
    i = i + 1
  }
  if !fits || front.count < 3 || back.count < 3 {
    return Option<[Polygon; 2]>.None
  }
  return Option<[Polygon; 2]>.some([front, back])
}

/// `items` (in tree order) back to front onto `out`. Coplanar polygons keep tree order, so the
/// later one draws on top.
pub effect fn sort(items: &List<Polygon>, out: &mut List<Polygon>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if items.length() == 0 {
    return ()
  }
  let root = items.get(0)
  let n = root.normal()
  let origin = [root.x[0], root.y[0], root.z[0]]
  let mut front = List<Polygon>.make()
  let mut back = List<Polygon>.make()
  let mut same = List<Polygon>.make()
  run same.append(root)
  let flat = n[0] == 0.0 && n[1] == 0.0 && n[2] == 0.0
  let mut i: usize = 1
  while i < items.length() {
    let p = items.get(i)
    i = i + 1
    let kind = if flat { COPLANAR } else { side(n, origin, &p) }
    if kind == COPLANAR {
      run same.append(p)
    } else if kind == FRONT {
      run front.append(p)
    } else if kind == BACK {
      run back.append(p)
    } else {
      match split(n, origin, &p) {
        Option.Some { value } => {
          run front.append(value[0])
          run back.append(value[1])
        }
        Option.None => {
          run front.append(p)
        }
      }
    }
  }
  // Seen from the front, what is behind the plane draws first.
  let seen = n[2] >= 0.0
  if seen {
    run sort(&back, &mut out)
  } else {
    run sort(&front, &mut out)
  }
  run out.appendSlice(same.asSlice())
  if seen {
    run sort(&front, &mut out)
  } else {
    run sort(&back, &mut out)
  }
}
