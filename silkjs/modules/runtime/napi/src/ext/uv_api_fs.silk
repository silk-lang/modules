  const EAI_BADFLAGS: i32 = -1
  const EAI_NONAME: i32 = -2
  const EAI_AGAIN: i32 = -3
  const EAI_FAIL: i32 = -4
  const EAI_NODATA: i32 = -5
  const EAI_FAMILY: i32 = -6
  const EAI_SOCKTYPE: i32 = -7
  const EAI_SERVICE: i32 = -8
  const EAI_ADDRFAMILY: i32 = -9
  const EAI_MEMORY: i32 = -10
  const EAI_SYSTEM: i32 = -11
  const EAI_OVERFLOW: i32 = -12
  const EAI_CANCELED: i32 = -101
  // FICLONE, _IOW(0x94, 9, int).
  const FICLONE: u64 = 1074041865
  unsafe extern "C" fn mkdir(path: ?[*]const u8, mode: u32) -> i32
  unsafe extern "C" fn fchmod(fd: i32, mode: u32) -> i32
  unsafe extern "C" fn fdatasync(fd: i32) -> i32
  unsafe extern "C" fn syscall(number: i64, ...) -> i64
  unsafe extern "C" fn ioctl(fd: i32, request: u64, ...) -> i32
  unsafe extern "C" fn gnuPoll(fds: [*]mut PollFd, count: usize, timeout: i32) -> i32 as "poll"
  unsafe fn pollOne(fds: *mut PollFd) -> i32 { return unsafe gnuPoll(unsafe Pointer.assumeManyMut<PollFd>(fds), 1, -1) }
  @foreign(noCapture: .("offset"))
  unsafe extern "C" fn linuxSendfile(output: i32, input: i32, offset: *mut i64, count: usize) -> isize as "sendfile"
  unsafe extern "C" fn statfs(path: *const u8, buffer: *mut [u64; 15]) -> i32
  unsafe extern "C" fn fstatfs(fd: i32, buffer: *mut [u64; 15]) -> i32
  unsafe extern "C" fn uname(value: *mut [u8; 390]) -> i32
  fn modeOf(mode: i32) -> u32 { return i32.wrappingToU32(mode) }
  unsafe fn makeDirectory(path: ?[*]const u8, mode: u32) -> i32 { return unsafe mkdir(path, mode) }
  unsafe fn changeMode(fd: i32, mode: u32) -> i32 { return unsafe fchmod(fd, mode) }
  unsafe fn familyOf(address: *const u8) -> u32 { return u16.toU32(unsafe Pointer.read<u16>(unsafe Intrinsic.pointerReinterpret<*const u8, *const u16>(address))) }
  unsafe fn closeNocancel(fd: i32) -> i32 { return i64.wrappingToI32(unsafe syscall(SYS_CLOSE, i32.toI64(fd))) }
  static if Intrinsic.targetArchitecture() == "x86_64" {
    const SYS_CLOSE: i64 = 3
    const SYS_NEWFSTATAT: i64 = 262
    const SYS_COPY_FILE_RANGE: i64 = 326
    const SYS_STATX: i64 = 332
    // The kernel's `struct stat`, which newfstatat fills (glibc's is the same).
    extern "C" struct NativeStat {
      dev: u64, ino: u64, nlink: u64, mode: u32, uid: u32, gid: u32, pad: u32, rdev: u64,
      size: i64, blksize: i64, blocks: i64, atime: Timespec, mtime: Timespec, ctime: Timespec, unused: [i64; 3]
    }
    fn emptyNativeStat() -> NativeStat {
      let zero = Timespec { seconds: 0, nanoseconds: 0 }
      return NativeStat { dev: 0, ino: 0, nlink: 0, mode: 0, uid: 0, gid: 0, pad: 0, rdev: 0, size: 0, blksize: 0, blocks: 0, atime: zero, mtime: zero, ctime: zero, unused: [0, 0, 0] }
    }
    fn nativeLinks(value: &NativeStat) -> u64 { return value.nlink }
    fn nativeBlockSize(value: &NativeStat) -> u64 { return i64.wrappingToU64(value.blksize) }
  } else {
    const SYS_CLOSE: i64 = 57
    const SYS_NEWFSTATAT: i64 = 79
    const SYS_COPY_FILE_RANGE: i64 = 285
    const SYS_STATX: i64 = 291
    // The kernel's generic `struct stat`.
    extern "C" struct NativeStat {
      dev: u64, ino: u64, mode: u32, nlink: u32, uid: u32, gid: u32, rdev: u64, pad: u64,
      size: i64, blksize: i32, pad2: i32, blocks: i64, atime: Timespec, mtime: Timespec, ctime: Timespec, unused: [u32; 2]
    }
    fn emptyNativeStat() -> NativeStat {
      let zero = Timespec { seconds: 0, nanoseconds: 0 }
      return NativeStat { dev: 0, ino: 0, mode: 0, nlink: 0, uid: 0, gid: 0, rdev: 0, pad: 0, size: 0, blksize: 0, pad2: 0, blocks: 0, atime: zero, mtime: zero, ctime: zero, unused: [0, 0] }
    }
    fn nativeLinks(value: &NativeStat) -> u64 { return u32.toU64(value.nlink) }
    fn nativeBlockSize(value: &NativeStat) -> u64 { return i64.wrappingToU64(i32.toI64(value.blksize)) }
  }
  fn uvTime(value: Timespec) -> UvTimespec { return UvTimespec { tv_sec: i64.toIsize(value.seconds), tv_nsec: i64.toIsize(value.nanoseconds) } }
  // libuv's uv__stat, uv__lstat or uv__fstat (`kind` 0, 1, 2) and uv__to_stat on Linux, where the
  // birth time is the status change time. 0, or -1 with errno.
  unsafe fn systemStat(kind: i32, fd: i32, path: ?*const u8, out: *mut UvStat) -> i32 {
    unsafe {
      let empty: [u8; 1] = [0]
      let mut s = emptyNativeStat()
      let directory = if kind == 2 { fd } else { AT_FDCWD }
      let name: *const u8 = if kind == 2 { Pointer.fromRef<u8>(&empty[0]) } else { nn(path) }
      let flags = if kind == 2 { AT_EMPTY_PATH } else { if kind == 1 { AT_SYMLINK_NOFOLLOW } else { 0 } }
      if syscall(SYS_NEWFSTATAT, i32.toI64(directory), name, Pointer.fromMutRef<NativeStat>(&mut s), i32.toI64(flags)) != 0 { return -1 }
      Pointer.write<UvStat>(out, UvStat {
        st_dev: s.dev, st_mode: u32.toU64(s.mode), st_nlink: nativeLinks(&s), st_uid: u32.toU64(s.uid), st_gid: u32.toU64(s.gid),
        st_rdev: s.rdev, st_ino: s.ino, st_size: i64.wrappingToU64(s.size), st_blksize: nativeBlockSize(&s), st_blocks: i64.wrappingToU64(s.blocks),
        st_flags: 0, st_gen: 0,
        st_atim: uvTime(s.atime), st_mtim: uvTime(s.mtime), st_ctim: uvTime(s.ctime), st_birthtim: uvTime(s.ctime)
      })
      return 0
    }
  }
  extern "C" struct StatxTime { seconds: i64, nanoseconds: u32, reserved: i32 }
  impl Copy for StatxTime {}
  extern "C" struct Statx {
    mask: u32, blksize: u32, attributes: u64, nlink: u32, uid: u32, gid: u32, mode: u16, spare0: u16,
    ino: u64, size: u64, blocks: u64, attributesMask: u64,
    atime: StatxTime, btime: StatxTime, ctime: StatxTime, mtime: StatxTime,
    rdevMajor: u32, rdevMinor: u32, devMajor: u32, devMinor: u32, spare: [u64; 14]
  }
  fn statxTime(value: StatxTime) -> UvTimespec { return UvTimespec { tv_sec: i64.toIsize(value.seconds), tv_nsec: u32.toIsize(value.nanoseconds) } }
  // glibc's makedev.
  fn device(major: u32, minor: u32) -> u64 {
    let high = u64.shiftLeft(u32.toU64(major & 4294963200), 32)
    let middle = u64.shiftLeft(u32.toU64(major & 4095), 8)
    let low = u64.shiftLeft(u32.toU64(minor & 4294967040), 12)
    return high | middle | low | u32.toU64(minor & 255)
  }
  // libuv's no_statx: set once the kernel has refused statx.
  unsafe fn noStatx() -> *mut u64 { return Intrinsic.processWord() }
  // libuv's uv__fs_statx and uv__statx_to_stat: 0, -1 with errno, or -ENOSYS to fall back.
  unsafe fn statxStat(fd: i32, path: ?*const u8, isFstat: bool, isLstat: bool, out: *mut UvStat) -> i32 {
    unsafe {
      if Atomic.load<u64>(noStatx(), MemoryOrder.Relaxed) != 0 { return -ENOSYS }
      let mut directory = AT_FDCWD
      let mut flags: i32 = 0
      if isFstat { directory = fd flags = flags | AT_EMPTY_PATH }
      if isLstat { flags = flags | AT_SYMLINK_NOFOLLOW }
      let zero = StatxTime { seconds: 0, nanoseconds: 0, reserved: 0 }
      let mut s = Statx {
        mask: 0, blksize: 0, attributes: 0, nlink: 0, uid: 0, gid: 0, mode: 0, spare0: 0, ino: 0, size: 0, blocks: 0, attributesMask: 0,
        atime: zero, btime: zero, ctime: zero, mtime: zero, rdevMajor: 0, rdevMinor: 0, devMajor: 0, devMinor: 0, spare: [0; 14]
      }
      let rc = syscall(SYS_STATX, i32.toI64(directory), nn(path), i32.toI64(flags), 4095, Pointer.fromMutRef<Statx>(&mut s))
      if rc != 0 {
        if rc == -1 {
          // EPERM comes from a seccomp filter that rejects the call, EOPNOTSUPP from DVS exports.
          let code = errno()
          if code != EINVAL && code != EPERM && code != ENOSYS && code != EOPNOTSUPP { return -1 }
        }
        Atomic.store<u64>(noStatx(), 1, MemoryOrder.Relaxed)
        return -ENOSYS
      }
      Pointer.write<UvStat>(out, UvStat {
        st_dev: device(s.devMajor, s.devMinor), st_mode: u16.toU64(s.mode), st_nlink: u32.toU64(s.nlink), st_uid: u32.toU64(s.uid), st_gid: u32.toU64(s.gid),
        st_rdev: device(s.rdevMajor, s.rdevMinor), st_ino: s.ino, st_size: s.size, st_blksize: u32.toU64(s.blksize), st_blocks: s.blocks,
        st_flags: 0, st_gen: 0,
        st_atim: statxTime(s.atime), st_mtim: statxTime(s.mtime), st_ctim: statxTime(s.ctime), st_birthtim: statxTime(s.btime)
      })
      return 0
    }
  }
  // libuv's uv__fs_statfs: glibc's struct statfs is fifteen words (f_type, f_bsize, f_blocks,
  // f_bfree, f_bavail, f_files, f_ffree, f_fsid, f_namelen, f_frsize, f_flags, f_spare[4]).
  unsafe fn statfsOf(path: *const u8, out: *mut UvStatfsRecord) -> i32 {
    unsafe {
      let mut buffer: [u64; 15] = [0; 15]
      if statfs(path, Pointer.fromMutRef<[u64; 15]>(&mut buffer)) != 0 { return -1 }
      Pointer.write<UvStatfsRecord>(out, UvStatfsRecord { f_type: buffer[0], f_bsize: buffer[1], f_blocks: buffer[2], f_bfree: buffer[3], f_bavail: buffer[4], f_files: buffer[5], f_ffree: buffer[6], f_frsize: buffer[9], f_spare: [0; 3] })
      return 0
    }
  }
  // The f_type of the file system that `fd` is on, or none.
  unsafe fn fileSystemType(fd: i32) -> Option<u64> {
    unsafe {
      let mut buffer: [u64; 15] = [0; 15]
      if fstatfs(fd, Pointer.fromMutRef<[u64; 15]>(&mut buffer)) == -1 { return Option<u64>.none() }
      return Option<u64>.some(buffer[0])
    }
  }
  // libuv's uv__is_buggy_cephfs: CephFS before Linux 4.20.
  unsafe fn isBuggyCephfs(fd: i32) -> bool {
    unsafe {
      if let Option<u64>.Some { value: kind } = fileSystemType(fd) {
        if kind != 12805120 { return false }
        return kernelVersion() < 267264
      }
      return false
    }
  }
  // libuv's uv__is_cifs_or_smb.
  unsafe fn isCifsOrSmb(fd: i32) -> bool {
    unsafe {
      if let Option<u64>.Some { value: kind } = fileSystemType(fd) {
        let low = kind & 4294967295
        return low == 20859 || low == 4266872130 || low == 4283649346
      }
      return false
    }
  }
  unsafe fn fullSync(fd: i32) -> isize { return i32.toIsize(unsafe fsync(fd)) }
  unsafe fn dataSync(fd: i32) -> isize { return i32.toIsize(unsafe fdatasync(fd)) }
  // libuv's no_copy_file_range_support.
  unsafe fn noCopyFileRange() -> *mut u64 { return Intrinsic.processWord() }
  // libuv's uv__fs_try_copy_file_range: the count, or -1 with errno (ENOSYS to use sendfile).
  unsafe fn tryCopyFileRange(input: i32, offset: *mut i64, output: i32, length: usize) -> isize {
    unsafe {
      if Atomic.load<u64>(noCopyFileRange(), MemoryOrder.Relaxed) != 0 { setErrno(ENOSYS) return -1 }
      let r = syscall(SYS_COPY_FILE_RANGE, i32.toI64(input), offset, i32.toI64(output), Pointer.null<i64>(), u64.wrappingToI64(usize.toU64(length)), 0)
      if r != -1 { return i64.toIsize(r) }
      let code = errno()
      if code == EACCES { if isBuggyCephfs(input) { setErrno(ENOSYS) } }
      else { if code == ENOSYS { Atomic.store<u64>(noCopyFileRange(), 1, MemoryOrder.Relaxed) }
      else { if code == EPERM { if isCifsOrSmb(output) { setErrno(ENOSYS) } }
      else { if code == ENOTSUP || code == EXDEV { setErrno(ENOSYS) } } } }
      return -1
    }
  }
  // libuv's uv__fs_sendfile on Linux: copy_file_range, then sendfile(2), then the emulation.
  unsafe fn sendfileCall(r: *mut FsReq) -> isize {
    unsafe {
      let mut anchor = () let q = Pointer.borrowMut<(), FsReq>(&mut anchor, r)
      let input = q.flags let output = q.file let start = q.off let length = q.bufsml[0].len
      drop q
      let mut offset = start
      let mut result = tryCopyFileRange(input, Pointer.fromMutRef<i64>(&mut offset), output, length)
      let trySendfile = result == -1 && errno() == ENOSYS
      if trySendfile { result = linuxSendfile(output, input, Pointer.fromMutRef<i64>(&mut offset), length) }
      if result != -1 || offset > start {
        let q2 = Pointer.borrowMut<(), FsReq>(&mut anchor, r) q2.off = offset
        return i64.toIsize(offset - start)
      }
      let code = errno()
      if code == EINVAL || code == EIO || code == ENOTSOCK || code == EXDEV { setErrno(0) return sendfileEmulation(r) }
      return -1
    }
  }
  // FICLONE: 1 when the clone was made, 0 to copy, or a negative error.
  unsafe fn cloneFile(flags: i32, destination: i32, source: i32) -> i32 {
    unsafe {
      if (flags & COPYFILE_FICLONE) != 0 || (flags & COPYFILE_FICLONE_FORCE) != 0 {
        if ioctl(destination, FICLONE, source) == 0 { return 1 }
        if (flags & COPYFILE_FICLONE_FORCE) != 0 { return -errno() }
      }
      return 0
    }
  }
  // libuv's uv__kernel_version: major * 65536 + minor * 256 + patch, or 0; cached.
  unsafe fn kernelVersionWord() -> *mut u64 { return Intrinsic.processWord() }
  unsafe fn kernelVersion() -> u32 {
    unsafe {
      let cached = Atomic.load<u64>(kernelVersionWord(), MemoryOrder.Relaxed)
      if cached != 0 { return u64.wrappingToU32(cached) }
      let mut numbers: [u32; 3] = [0; 3]
      let mut found = false
      // /proc/version_signature: "Ubuntu <ubuntu version> <mainline version>".
      let mut signature: [u8; 256] = [0; 256]
      if slurp(b"/proc/version_signature\0", &mut signature) {
        let prefix = b"Ubuntu "
        let mut at: usize = 0
        let mut matches = true
        while at < 7 { if signature[at] != prefix[at] { matches = false } at = at + 1 }
        if matches {
          while at < 255 && (signature[at] == 32 || signature[at] == 9 || signature[at] == 10) { at = at + 1 }
          while at < 255 && signature[at] != 0 && signature[at] != 32 && signature[at] != 9 && signature[at] != 10 { at = at + 1 }
          found = scanVersion(&signature, at, &mut numbers)
        }
      }
      if !found {
        let mut names: [u8; 390] = [0; 390]
        if uname(Pointer.fromMutRef<[u8; 390]>(&mut names)) == -1 { return 0 }
        // The version field (offset 195) names Debian's mainline version: "#1 SMP Debian 5.10.46-4".
        let needle = b"Debian "
        let mut at: usize = 195
        while !found && at + 7 <= 260 {
          let mut same = true
          let mut index: usize = 0
          while index < 7 { if names[at + index] != needle[index] { same = false } index = index + 1 }
          if same { found = scanVersion(&names, at + 7, &mut numbers) break }
          if names[at] == 0 { break }
          at = at + 1
        }
        if !found {
          // The release (offset 65).
          if !scanVersion(&names, 65, &mut numbers) { return 0 }
          // UNAME26: kernels >= 3.x identify as 2.6.40+x, >= 4.x as 2.6.60+x.
          if numbers[0] == 2 && numbers[1] == 6 {
            if numbers[2] >= 60 { numbers[0] = 4 numbers[1] = numbers[2] - 60 numbers[2] = 0 }
            else { if numbers[2] >= 40 { numbers[0] = 3 numbers[1] = numbers[2] - 40 numbers[2] = 0 } }
          }
        }
      }
      let version = u32.wrappingAdd(u32.wrappingAdd(u32.wrappingMultiply(numbers[0], 65536), u32.wrappingMultiply(numbers[1], 256)), numbers[2])
      Atomic.store<u64>(kernelVersionWord(), u32.toU64(version), MemoryOrder.Relaxed)
      return version
    }
  }
  // sscanf's "%u.%u.%u" at `at`: true when all three numbers were read.
  fn scanVersion(text: &[u8], start: usize, numbers: &mut [u32; 3]) -> bool {
    let mut at = start
    let mut index: usize = 0
    while index < 3 {
      if index > 0 { if at >= text.length || text[at] != 46 { return false } at = at + 1 }
      if index == 0 { while at < text.length && (text[at] == 32 || text[at] == 9 || text[at] == 10) { at = at + 1 } }
      if at >= text.length || text[at] < 48 || text[at] > 57 { return false }
      let mut value: u32 = 0
      while at < text.length && text[at] >= 48 && text[at] <= 57 { value = u32.wrappingAdd(u32.wrappingMultiply(value, 10), u8.toU32(text[at] - 48)) at = at + 1 }
      numbers[index] = value
      index = index + 1
    }
    return true
  }
  // libuv's uv__slurp: the file's first bytes, NUL-terminated; false when it cannot be read.
  unsafe fn slurp(path: &[u8], buffer: &mut [u8; 256]) -> bool {
    unsafe {
      let fd = open(Pointer.fromRef<u8>(&path[0]), O_RDONLY | O_CLOEXEC)
      if fd == -1 { return false }
      let mut count = read(fd, Pointer.fromMutSlice<u8>(&mut buffer.*), 255)
      while count == -1 && errno() == EINTR { count = read(fd, Pointer.fromMutSlice<u8>(&mut buffer.*), 255) }
      let _closed = closeNocancel(fd)
      if count < 0 { return false }
      buffer[isize.toUsize(count)] = 0
      return true
    }
  }
}

/// libuv 1.52's uv_statfs_t (1.51's has f_spare[4] where 1.52 has f_frsize, f_spare[3]).
impl Copy for UvStatfsRecord {}
extern "C" struct UvStatfsRecord { f_type: u64, f_bsize: u64, f_blocks: u64, f_bfree: u64, f_bavail: u64, f_files: u64, f_ffree: u64, f_frsize: u64, f_spare: [u64; 3] }

// ---- Helpers ----------------------------------------------------------------------------------
unsafe fn errno() -> i32 { return unsafe Pointer.read<i32>(unsafe errnoSlot()) }
unsafe fn setErrno(value: i32) -> () { unsafe Pointer.write<i32>(unsafe errnoSlot(), value) }
unsafe fn nn<T>(pointer: ?*const T) -> *const T { return unsafe Intrinsic.pointerRequalify<?*const T, *const T>(pointer) }
unsafe fn nnMut<T>(pointer: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(pointer) }
unsafe fn byteAt(base: *mut u8, offset: usize) -> *mut u8 { return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), offset) }
unsafe fn constAt(base: *const u8, offset: usize) -> *const u8 { return unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(base), offset) }
unsafe fn offsetMany(base: ?*mut u8, offset: usize) -> ?[*]mut u8 {
  if Pointer.isNull<u8>(base) { return unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]mut u8>(base) }
  return unsafe Pointer.assumeManyMut<u8>(unsafe byteAt(unsafe nnMut<u8>(base), offset))
}
// A pointer from an address (libuv's container_of needs one).
unsafe fn fromAddress(address: usize) -> *mut u8 {
  let word = address
  return unsafe Pointer.read<*mut u8>(unsafe Intrinsic.pointerReinterpret<*const usize, *const *mut u8>(Pointer.fromRef<usize>(&word)))
}
unsafe fn containerOf(unit: *mut Work, offset: usize) -> *mut u8 { return unsafe fromAddress(Pointer.address<Work>(unit) - offset) }
unsafe fn fsOf(pointer: *mut u8) -> *mut FsReq { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut FsReq>(pointer) }
unsafe fn bufAt(bufs: ?*mut Buf, index: usize) -> *mut Buf { return unsafe Pointer.atMut<Buf>(unsafe Pointer.assumeManyMut<Buf>(unsafe nnMut<Buf>(bufs)), index) }
unsafe fn sameAddress(a: ?*const u8, b: ?*const u8) -> bool { return Pointer.address<u8>(a) == Pointer.address<u8>(b) }
fn text(bytes: &[u8]) -> *const u8 { return Pointer.fromRef<u8>(&bytes[0]) }
/// The loop memory of `ext.uv_loop` that an addon's uv_loop_t* stands for.
unsafe fn loopMemory(loop: ?*mut u8) -> *mut u8 { return unsafe nnMut<u8>(loop) }
// libuv's uv__malloc, uv__free and uv__strdup (see the module comment).
unsafe fn allocate(size: usize) -> ?*mut u8 { return unsafe os.uvMalloc(size) }
unsafe fn release(pointer: ?*mut u8) -> () { unsafe os.uvFree(pointer) }
unsafe fn duplicate(source: *const u8) -> ?*mut u8 { return unsafe os.uvStrdup(source) }
fn zeroTime() -> UvTimespec { return UvTimespec { tv_sec: 0, tv_nsec: 0 } }
fn zeroStat() -> UvStat {
  return UvStat { st_dev: 0, st_mode: 0, st_nlink: 0, st_uid: 0, st_gid: 0, st_rdev: 0, st_ino: 0, st_size: 0, st_blksize: 0, st_blocks: 0, st_flags: 0, st_gen: 0, st_atim: zeroTime(), st_mtim: zeroTime(), st_ctim: zeroTime(), st_birthtim: zeroTime() }
}
fn emptyWork() -> Work {
  return Work { work: Intrinsic.pointerNullFunction<?extern "C" fn(*mut Work) -> ()>(), done: Intrinsic.pointerNullFunction<?extern "C" fn(*mut Work, i32) -> ()>(), loop: Pointer.null<u8>(), next: Pointer.null<Work>(), previous: Pointer.null<Work>() }
}
fn emptyBuf() -> Buf { return Buf { base: Pointer.null<u8>(), len: 0 } }
// A uv_fs_t on the stack, for the synchronous requests that uv_fs_copyfile makes.
fn blankRequest() -> FsReq {
  return FsReq {
    data: Pointer.null<u8>(), kind: 0, padding: 0, reserved: [0; 6],
    fsType: 0, padding2: 0, loop: Pointer.null<u8>(), cb: Intrinsic.pointerNullFunction<FsCallback>(), result: 0, ptr: Pointer.null<u8>(), path: Pointer.null<u8>(), statbuf: zeroStat(),
    newPath: Pointer.null<u8>(), file: 0, flags: 0, mode: 0, nbufs: 0, bufs: Pointer.null<Buf>(), off: 0, uid: 0, gid: 0,
    atime: 0.0, mtime: 0.0, work: emptyWork(), bufsml: [emptyBuf(); 4]
  }
}
// uv__fs_to_timespec: infinity is UTIME_NOW, NaN UTIME_OMIT, else microsecond resolution.
fn timespecOf(time: f64) -> Timespec {
  if f64.isInfinite(time) { return Timespec { seconds: UTIME_NOW, nanoseconds: UTIME_NOW } }
  if f64.isNaN(time) { return Timespec { seconds: UTIME_OMIT, nanoseconds: UTIME_OMIT } }
  let mut seconds = truncate(time)
  let mut nanoseconds = truncate((time - i64.toF64(seconds)) * 1000000000.0)
  nanoseconds = nanoseconds - nanoseconds % 1000
  if nanoseconds < 0 { nanoseconds = nanoseconds + 1000000000 seconds = seconds - 1 }
  return Timespec { seconds: seconds, nanoseconds: nanoseconds }
}
// C's conversion of a double to long (toward zero; out of range gives the x86 "integer indefinite").
fn truncate(value: f64) -> i64 {
  if let Option<i64>.Some { value: converted } = f64.checkedToI64(value) { return converted }
  return -9223372036854775807 - 1
}
// uv__close_nocheckstdio: 0, or a negative error; errno is kept.
unsafe fn closeChecked(fd: i32) -> i32 {
  unsafe {
    let saved = errno()
    let mut rc = closeNocancel(fd)
    if rc == -1 {
      rc = -errno()
      if rc == -EINTR || rc == -EINPROGRESS { rc = 0 }
      setErrno(saved)
    }
    return rc
  }
}
// uv__cloexec(fd, 1): 0, or a negative error with errno set.
unsafe fn setCloexec(fd: i32) -> i32 {
  unsafe {
    let mut rc = fcntl(fd, F_SETFD, FD_CLOEXEC)
    while rc == -1 && errno() == EINTR { rc = fcntl(fd, F_SETFD, FD_CLOEXEC) }
    if rc != 0 { return -errno() }
    return 0
  }
}

// ---- The operations (libuv's uv__fs_*): a result, or -1 with errno -------------------------
// uv__fs_close.
unsafe fn closeCall(fd: i32) -> isize {
  unsafe {
    let mut rc = closeNocancel(fd)
    if rc == -1 { let code = errno() if code == EINTR || code == EINPROGRESS { rc = 0 } }
    return i32.toIsize(rc)
  }
}
// uv__fs_mkstemp: the template must end in XXXXXX; mkostemp with O_CLOEXEC, else mkstemp and
// FD_CLOEXEC. On failure the path becomes empty.
unsafe fn noCloexecMkostemp() -> *mut u64 { return Intrinsic.processWord() }
unsafe fn mkstempCall(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let path = Intrinsic.pointerRequalify<?*const u8, *mut u8>(r.path)
    drop r
    let length = strlen(path)
    let pattern = b"XXXXXX\0"
    let mut result: i32 = -1
    if length < 6 || strcmp(constAt(path, length - 6), text(pattern)) != 0 { setErrno(EINVAL) }
    else {
      let mut done = false
      if Atomic.load<u64>(noCloexecMkostemp(), MemoryOrder.Relaxed) == 0 {
        result = mkostemp(path, O_CLOEXEC)
        if result >= 0 { return i32.toIsize(result) }
        if errno() != EINVAL { done = true }
        else { Atomic.store<u64>(noCloexecMkostemp(), 1, MemoryOrder.Relaxed) }
      }
      if !done {
        result = mkstemp(path)
        if result >= 0 && setCloexec(result) != 0 {
          if closeChecked(result) != 0 { abort() }
          result = -1
        }
      }
    }
    if result < 0 { Pointer.write<u8>(path, 0) }
    return i32.toIsize(result)
  }
}
// The iovec count for the system calls: at most IOV_MAX.
fn vectorCount(count: u32) -> i32 { if count > IOV_MAX { return u32.toI32(IOV_MAX) } return u32.toI32(count) }
// uv__fs_read.
unsafe fn readCall(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let fd = r.file let off = r.off let bufs = r.bufs let count = vectorCount(r.nbufs)
    let small = Pointer.fromMutRef<Buf>(&mut r.bufsml[0])
    let async = !Intrinsic.pointerIsNull<FsCallback>(r.cb)
    drop r
    let mut result: isize = 0
    if count >= 1 {
      let vectors = Intrinsic.pointerRequalify<?*mut Buf, ?[*]const Buf>(bufs)
      let first = Pointer.read<Buf>(bufAt(bufs, 0))
      let base = Intrinsic.pointerRequalify<?*mut u8, ?[*]mut u8>(first.base)
      if off < 0 {
        if count == 1 { result = read(fd, base, first.len) } else { result = readv(fd, vectors, count) }
      } else {
        if count == 1 { result = pread(fd, base, first.len, off) } else { result = preadv(fd, vectors, count, off) }
      }
    }
    // The bufs copy of an asynchronous request is the request's; a synchronous one reads the caller's.
    if async && Pointer.address<Buf>(bufs) != Pointer.address<Buf>(small) {
      release(Intrinsic.pointerReinterpret<?*mut Buf, ?*mut u8>(bufs))
    }
    let r2 = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    r2.bufs = Pointer.null<Buf>() r2.nbufs = 0
    return result
  }
}
// uv__fs_write: one write of the request's current bufs.
unsafe fn writeOnce(q: *mut FsReq) -> isize {
  unsafe {
    let anchor = () let r = Pointer.borrow<(), FsReq>(&anchor, q)
    let fd = r.file let off = r.off let bufs = r.bufs let count = r.nbufs
    drop r
    if count == 0 { return 0 }
    let vectors = Intrinsic.pointerRequalify<?*mut Buf, ?[*]const Buf>(bufs)
    let first = Pointer.read<Buf>(bufAt(bufs, 0))
    let base = Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(first.base)
    if off < 0 {
      if count == 1 { return write(fd, nn<u8>(first.base), first.len) }
      return writev(fd, vectors, u32.toI32(count))
    }
    if count == 1 { return pwrite(fd, base, first.len, off) }
    return pwritev(fd, vectors, u32.toI32(count), off)
  }
}
// uv__fs_buf_offset: how many bufs `size` bytes complete; a partly written one is advanced.
unsafe fn bufOffset(bufs: ?*mut Buf, total: usize) -> u32 {
  unsafe {
    let mut size = total
    let mut offset: usize = 0
    while size > 0 && Pointer.read<Buf>(bufAt(bufs, offset)).len <= size {
      size = size - Pointer.read<Buf>(bufAt(bufs, offset)).len
      offset = offset + 1
    }
    if size > 0 {
      let slot = bufAt(bufs, offset)
      let current = Pointer.read<Buf>(slot)
      Pointer.write<Buf>(slot, Buf { base: Intrinsic.pointerRequalify<?[*]mut u8, ?*mut u8>(offsetMany(current.base, size)), len: current.len - size })
    }
    return usize.wrappingToU32(offset)
  }
}
// uv__fs_write_all: writes IOV_MAX bufs at a time until all are written or one write fails.
unsafe fn writeAll(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let mut nbufs = r.nbufs let original = r.bufs
    let small = Pointer.fromMutRef<Buf>(&mut r.bufsml[0])
    drop r
    let mut total: isize = 0
    while nbufs > 0 {
      let r1 = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
      r1.nbufs = if nbufs > IOV_MAX { IOV_MAX } else { nbufs }
      drop r1
      let mut result = writeOnce(q)
      while result < 0 && errno() == EINTR { result = writeOnce(q) }
      if result <= 0 { if total == 0 { total = result } break }
      let r2 = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
      if r2.off >= 0 { r2.off = r2.off + isize.toI64(result) }
      let done = bufOffset(r2.bufs, isize.toUsize(result))
      r2.nbufs = done
      r2.bufs = bufAt(r2.bufs, u32.toUsize(done))
      nbufs = nbufs - done
      total = total + result
    }
    if Pointer.address<Buf>(original) != Pointer.address<Buf>(small) {
      release(Intrinsic.pointerReinterpret<?*mut Buf, ?*mut u8>(original))
    }
    let r3 = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    r3.bufs = Pointer.null<Buf>() r3.nbufs = 0
    return total
  }
}
// uv__fs_scandir_filter and uv__fs_scandir_sort.
export "C" fn silkUvApiFsScandirFilter(entry: *const u8) -> i32 {
  unsafe {
    let name = constAt(entry, D_NAME)
    if strcmp(name, text(b".\0")) != 0 && strcmp(name, text(b"..\0")) != 0 { return 1 }
    return 0
  }
}
export "C" fn silkUvApiFsScandirSort(left: *const ?*const u8, right: *const ?*const u8) -> i32 {
  unsafe { return strcmp(constAt(nn<u8>(Pointer.read<?*const u8>(left)), D_NAME), constAt(nn<u8>(Pointer.read<?*const u8>(right)), D_NAME)) }
}
// uv__fs_scandir: the sorted entries from scandir(3), kept in `ptr`; nbufs is the cursor.
unsafe fn scandirCall(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let path = nn<u8>(r.path)
    drop r
    let mut entries: ?*mut ?*mut u8 = Pointer.null<?*mut u8>()
    let count = scandir(path, Pointer.fromMutRef<?*mut ?*mut u8>(&mut entries), silkUvApiFsScandirFilter, silkUvApiFsScandirSort)
    let r2 = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    r2.nbufs = 0
    if count == 0 {
      // The system allocator's memory: free(), not uv__free.
      free(Intrinsic.pointerReinterpret<?*mut ?*mut u8, ?*mut u8>(entries))
      entries = Pointer.null<?*mut u8>()
    } else { if count == -1 { return -1 } }
    r2.ptr = Intrinsic.pointerReinterpret<?*mut ?*mut u8, ?*mut u8>(entries)
    return i32.toIsize(count)
  }
}
// uv__fs_get_dirent_type.
unsafe fn direntType(entry: *const u8) -> i32 {
  let kind = unsafe Pointer.read<u8>(unsafe constAt(entry, D_TYPE))
  if kind == DT_DIR { return DIRENT_DIR }
  if kind == DT_REG { return DIRENT_FILE }
  if kind == DT_LNK { return DIRENT_LINK }
  if kind == DT_FIFO { return DIRENT_FIFO }
  if kind == DT_SOCK { return DIRENT_SOCKET }
  if kind == DT_CHR { return DIRENT_CHAR }
  if kind == DT_BLK { return DIRENT_BLOCK }
  return DIRENT_UNKNOWN
}
fn dirOf(pointer: ?*mut u8) -> *mut Dir { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Dir>(unsafe nnMut<u8>(pointer)) }
// uv__fs_opendir: a uv_dir_t from uv__malloc around opendir(3).
unsafe fn opendirCall(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let path = nn<u8>(r.path)
    drop r
    let memory = allocate(Layout.of<Dir>().bytes)
    if !Pointer.isNull<u8>(memory) {
      let stream = opendir(path)
      let mut second = () let d = Pointer.borrowMut<(), Dir>(&mut second, dirOf(memory))
      d.dir = stream drop d
      if !Pointer.isNull<u8>(stream) {
        let r2 = Pointer.borrowMut<(), FsReq>(&mut anchor, q) r2.ptr = memory
        return 0
      }
    }
    release(memory)
    let r3 = Pointer.borrowMut<(), FsReq>(&mut anchor, q) r3.ptr = Pointer.null<u8>()
    return -1
  }
}
// uv__fs_readdir: up to nentries entries into the caller's dirents, "." and ".." skipped.
unsafe fn readdirCall(q: *mut FsReq) -> isize {
  unsafe {
    let anchor = () let r = Pointer.borrow<(), FsReq>(&anchor, q)
    let dir = dirOf(r.ptr)
    drop r
    let mut second = () let d = Pointer.borrowMut<(), Dir>(&mut second, dir)
    let stream = nnMut<u8>(d.dir) let limit = d.nentries let dirents = d.dirents
    drop d
    let entries = Pointer.assumeManyMut<Dirent>(nnMut<Dirent>(dirents))
    let mut index: usize = 0
    let mut failed = false
    while index < limit {
      setErrno(0)
      let found = readdir(stream)
      if Pointer.isNull<u8>(found) { if errno() != 0 { failed = true } break }
      let entry = nn<u8>(found)
      let name = constAt(entry, D_NAME)
      if strcmp(name, text(b".\0")) == 0 || strcmp(name, text(b"..\0")) == 0 { continue }
      let copy = duplicate(name)
      let slot = Pointer.atMut<Dirent>(entries, index)
      Pointer.write<Dirent>(slot, Dirent { name: copy, kind: 0, padding: 0 })
      if Pointer.isNull<u8>(copy) { failed = true break }
      Pointer.write<Dirent>(slot, Dirent { name: copy, kind: direntType(entry), padding: 0 })
      index = index + 1
    }
    if !failed { return usize.toIsize(index) }
    let mut cleared: usize = 0
    while cleared < index {
      let slot = Pointer.atMut<Dirent>(entries, cleared)
      let entry = Pointer.read<Dirent>(slot)
      release(Intrinsic.pointerRequalify<?*const u8, ?*mut u8>(entry.name))
      Pointer.write<Dirent>(slot, Dirent { name: Pointer.null<u8>(), kind: entry.kind, padding: entry.padding })
      cleared = cleared + 1
    }
    return -1
  }
}
// uv__fs_closedir.
unsafe fn closedirCall(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let memory = r.ptr
    drop r
    let mut second = () let d = Pointer.borrowMut<(), Dir>(&mut second, dirOf(memory))
    if !Pointer.isNull<u8>(d.dir) { let _closed = closedir(nnMut<u8>(d.dir)) d.dir = Pointer.null<u8>() }
    drop d
    release(memory)
    let r2 = Pointer.borrowMut<(), FsReq>(&mut anchor, q) r2.ptr = Pointer.null<u8>()
    return 0
  }
}
// uv__fs_statfs: a uv_statfs_t from uv__malloc.
unsafe fn statfsCall(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let path = nn<u8>(r.path)
    drop r
    let mut value = UvStatfsRecord { f_type: 0, f_bsize: 0, f_blocks: 0, f_bfree: 0, f_bavail: 0, f_files: 0, f_ffree: 0, f_frsize: 0, f_spare: [0; 3] }
    if statfsOf(path, Pointer.fromMutRef<UvStatfsRecord>(&mut value)) != 0 { return -1 }
    let memory = allocate(Layout.of<UvStatfsRecord>().bytes)
    if Pointer.isNull<u8>(memory) { setErrno(ENOMEM) return -1 }
    Pointer.put<UvStatfsRecord>(Intrinsic.pointerReinterpret<*mut u8, *mut UvStatfsRecord>(nnMut<u8>(memory)), value)
    let r2 = Pointer.borrowMut<(), FsReq>(&mut anchor, q) r2.ptr = memory
    return 0
  }
}
// uv__fs_readlink: a buffer of pathconf(_PC_PATH_MAX) bytes, grown by one when the link fills it.
unsafe fn readlinkCall(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let path = Pointer.assumeMany<u8>(nn<u8>(r.path))
    drop r
    let mut maxlen = pathconf(path, PC_PATH_MAX)
    if maxlen == -1 { maxlen = PATH_MAX }
    let size = i64.wrappingToUsize(maxlen)
    let mut buffer = allocate(size)
    if Pointer.isNull<u8>(buffer) { setErrno(ENOMEM) return -1 }
    let length = readlink(path, offsetMany(buffer, 0), size)
    if length == -1 { release(buffer) return -1 }
    if isize.toUsize(length) == size {
      // uv__reallocf.
      let grown = os.uvRealloc(buffer, size + 1)
      if Pointer.isNull<u8>(grown) { release(buffer) return -1 }
      buffer = grown
    }
    Pointer.write<u8>(byteAt(nnMut<u8>(buffer), isize.toUsize(length)), 0)
    let r2 = Pointer.borrowMut<(), FsReq>(&mut anchor, q) r2.ptr = buffer
    return 0
  }
}
// uv__fs_realpath: realpath(3)'s result, copied with uv__strdup.
unsafe fn realpathCall(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let path = nn<u8>(r.path)
    drop r
    let resolved = realpath(path, Pointer.null<u8>())
    if Pointer.isNull<u8>(resolved) { return -1 }
    let copy = duplicate(nn<u8>(resolved))
    free(resolved)
    if Pointer.isNull<u8>(copy) { setErrno(ENOMEM) return -1 }
    let r2 = Pointer.borrowMut<(), FsReq>(&mut anchor, q) r2.ptr = copy
    return 0
  }
}
// uv__fs_sendfile_emul: pread (read when the source cannot seek), write, and poll when the
// target would block. Read errors count only before anything was sent; write errors always.
unsafe fn sendfileEmulation(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let length = r.bufsml[0].len let input = r.flags let output = r.file let mut offset = r.off
    drop r
    let mut usePread = true
    let mut buffer: [u8; 8192] = [0; 8192]
    let base = Pointer.fromMutSlice<u8>(&mut buffer)
    let mut sent: isize = 0
    let mut failed = false
    while isize.toUsize(sent) < length {
      let mut chunk = length - isize.toUsize(sent)
      if chunk > 8192 { chunk = 8192 }
      let mut count: isize = 0
      while true {
        if usePread { count = pread(input, base, chunk, offset) } else { count = read(input, base, chunk) }
        if !(count == -1 && errno() == EINTR) { break }
      }
      if count == 0 { break }
      if count == -1 {
        let code = errno()
        if usePread && sent == 0 && (code == EIO || code == ESPIPE) { usePread = false continue }
        if sent == 0 { sent = -1 }
        break
      }
      let mut written: isize = 0
      while written < count {
        let mut n: isize = 0
        while true {
          n = write(output, constAt(Pointer.fromRef<u8>(&buffer[0]), isize.toUsize(written)), isize.toUsize(count - written))
          if !(n == -1 && errno() == EINTR) { break }
        }
        if n != -1 { written = written + n continue }
        let code = errno()
        if code != EAGAIN { sent = -1 failed = true break }
        let mut poll = PollFd { fd: output, events: POLLOUT, revents: 0 }
        let mut polled: i32 = 0
        while true {
          polled = pollOne(Pointer.fromMutRef<PollFd>(&mut poll))
          if !(polled == -1 && errno() == EINTR) { break }
        }
        if polled == -1 || (poll.revents & (~POLLOUT)) != 0 { setErrno(EIO) sent = -1 failed = true break }
      }
      if failed { break }
      offset = offset + isize.toI64(count)
      sent = sent + count
    }
    if sent != -1 { let r2 = Pointer.borrowMut<(), FsReq>(&mut anchor, q) r2.off = offset }
    return sent
  }
}
// uv__fs_copyfile: open both files, match the destination's times, owner and mode to the
// source's, clone or copy the bytes, and remove the destination when anything failed.
unsafe fn copyfileCall(q: *mut FsReq) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let path = r.path let newPath = r.newPath let flags = r.flags
    drop r
    let mut scratch = blankRequest()
    let scratchAt = Intrinsic.pointerReinterpret<*mut FsReq, *mut u8>(Pointer.fromMutRef<FsReq>(&mut scratch))
    let source = fsOpen(Pointer.null<u8>(), scratchAt, path, O_RDONLY, 0, Intrinsic.pointerNullFunction<FsCallback>())
    uv_fs_req_cleanup(scratchAt)
    if source < 0 { return i32.toIsize(source) }
    let mut destination: i32 = -1
    let mut err: i32 = 0
    let mut sourceStat = zeroStat()
    while true {
      if systemStat(2, source, Pointer.null<u8>(), Pointer.fromMutRef<UvStat>(&mut sourceStat)) != 0 { err = -errno() break }
      let mut destinationFlags = O_WRONLY | O_CREAT
      if (flags & COPYFILE_EXCL) != 0 { destinationFlags = destinationFlags | O_EXCL }
      destination = fsOpen(Pointer.null<u8>(), scratchAt, newPath, destinationFlags, u64.wrappingToI32(sourceStat.st_mode), Intrinsic.pointerNullFunction<FsCallback>())
      uv_fs_req_cleanup(scratchAt)
      if destination < 0 { err = destination break }
      if (flags & COPYFILE_EXCL) == 0 {
        let mut destinationStat = zeroStat()
        if systemStat(2, destination, Pointer.null<u8>(), Pointer.fromMutRef<UvStat>(&mut destinationStat)) != 0 { err = -errno() break }
        // The same file: nothing to copy.
        if sourceStat.st_dev == destinationStat.st_dev && sourceStat.st_ino == destinationStat.st_ino { break }
        if ftruncate(destination, 0) != 0 {
          err = -errno()
          // ceph-fuse refuses to truncate a new read-only file with EACCES.
          if err != -EACCES { break }
          if destinationStat.st_size > 0 { break }
          err = 0
        }
      }
      let times: [Timespec; 2] = [
        Timespec { seconds: isize.toI64(sourceStat.st_atim.tv_sec), nanoseconds: isize.toI64(sourceStat.st_atim.tv_nsec) },
        Timespec { seconds: isize.toI64(sourceStat.st_mtim.tv_sec), nanoseconds: isize.toI64(sourceStat.st_mtim.tv_nsec) },
      ]
      if futimens(destination, Pointer.fromSlice<Timespec>(&times)) == -1 { err = -errno() break }
      // Like cp -p, an ownership failure is not an error.
      let _owned = fchown(destination, u64.wrappingToU32(sourceStat.st_uid), u64.wrappingToU32(sourceStat.st_gid))
      if changeMode(destination, u64.wrappingToU32(sourceStat.st_mode)) == -1 {
        err = -errno()
        static if Intrinsic.targetOperatingSystem() == "darwin" { break } else {
          // fchmod on a CIFS share fails with EPERM unless it is mounted with noperm.
          if err != -EPERM { break }
          if !isCifsOrSmb(destination) { break }
          err = 0
        }
      }
      let cloned = cloneFile(flags, destination, source)
      if cloned < 0 { err = cloned break }
      if cloned == 1 { break }
      let mut remaining = u64.wrappingToI64(sourceStat.st_size)
      let mut position: i64 = 0
      while remaining != 0 {
        let mut chunk = SSIZE_MAX
        if remaining < chunk { chunk = remaining }
        let _sent = fsSendfile(Pointer.null<u8>(), scratchAt, destination, source, position, i64.wrappingToUsize(chunk), Intrinsic.pointerNullFunction<FsCallback>())
        let written = isize.toI64(scratch.result)
        uv_fs_req_cleanup(scratchAt)
        if written < 0 { err = i64.wrappingToI32(written) break }
        remaining = remaining - written
        position = position + written
      }
      break
    }
    let mut result: i32 = if err < 0 { err } else { 0 }
    let closedSource = closeChecked(source)
    if closedSource != 0 && result == 0 { result = closedSource }
    if destination >= 0 {
      let closedDestination = closeChecked(destination)
      if closedDestination != 0 && result == 0 { result = closedDestination }
      if result != 0 {
        let _removed = fsUnlink(Pointer.null<u8>(), scratchAt, newPath, Intrinsic.pointerNullFunction<FsCallback>())
        uv_fs_req_cleanup(scratchAt)
      }
    }
    if result == 0 { return 0 }
    setErrno(-result)
    return -1
  }
}
// uv__fs_stat, uv__fs_lstat, uv__fs_fstat: statx where the kernel has it, else stat(2).
unsafe fn statCall(kind: i32, fd: i32, path: ?*const u8, out: *mut UvStat) -> isize {
  unsafe {
    let empty: [u8; 1] = [0]
    let name: ?*const u8 = if kind == 2 { Pointer.fromRef<u8>(&empty[0]) } else { path }
    let rc = statxStat(fd, name, kind == 2, kind == 1, out)
    if rc != -ENOSYS { return i32.toIsize(rc) }
    return i32.toIsize(systemStat(kind, fd, path, out))
  }
}
unsafe fn utimeCall(q: *mut FsReq, kind: i32) -> isize {
  unsafe {
    let anchor = () let r = Pointer.borrow<(), FsReq>(&anchor, q)
    let times: [Timespec; 2] = [timespecOf(r.atime), timespecOf(r.mtime)]
    let fd = r.file let path = Intrinsic.pointerRequalify<?*const u8, ?[*]const u8>(r.path)
    drop r
    if kind == FS_FUTIME { return i32.toIsize(futimens(fd, Pointer.fromSlice<Timespec>(&times))) }
    let flags = if kind == FS_LUTIME { AT_SYMLINK_NOFOLLOW } else { 0 }
    return i32.toIsize(utimensat(AT_FDCWD, path, Pointer.fromSlice<Timespec>(&times), flags))
  }
}
// One attempt of the request's operation.
unsafe fn perform(q: *mut FsReq, kind: i32) -> isize {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
    let path = r.path let pathMany = Intrinsic.pointerRequalify<?*const u8, ?[*]const u8>(r.path)
    let newPath = Intrinsic.pointerRequalify<?*const u8, ?[*]const u8>(r.newPath)
    let fd = r.file let flags = r.flags let mode = r.mode let uid = r.uid let gid = r.gid let off = r.off
    let statbuf = Pointer.fromMutRef<UvStat>(&mut r.statbuf)
    drop r
    if kind == FS_ACCESS { return i32.toIsize(access(pathMany, flags)) }
    if kind == FS_CHMOD { return i32.toIsize(chmod(nn<u8>(path), mode)) }
    if kind == FS_CHOWN { return i32.toIsize(chown(nn<u8>(path), uid, gid)) }
    if kind == FS_CLOSE { return closeCall(fd) }
    if kind == FS_COPYFILE { return copyfileCall(q) }
    if kind == FS_FCHMOD { return i32.toIsize(changeMode(fd, mode)) }
    if kind == FS_FCHOWN { return i32.toIsize(fchown(fd, uid, gid)) }
    if kind == FS_LCHOWN { return i32.toIsize(lchown(nn<u8>(path), uid, gid)) }
    if kind == FS_FDATASYNC { return dataSync(fd) }
    if kind == FS_FSTAT { return statCall(2, fd, path, statbuf) }
    if kind == FS_FSYNC { return fullSync(fd) }
    if kind == FS_FTRUNCATE { return i32.toIsize(ftruncate(fd, off)) }
    if kind == FS_FUTIME || kind == FS_UTIME || kind == FS_LUTIME { return utimeCall(q, kind) }
    if kind == FS_LSTAT { return statCall(1, fd, path, statbuf) }
    if kind == FS_LINK { return i32.toIsize(link(pathMany, newPath)) }
    if kind == FS_MKDIR { return i32.toIsize(makeDirectory(pathMany, mode)) }
    if kind == FS_MKDTEMP {
      if Pointer.isNull<u8>(mkdtemp(Intrinsic.pointerRequalify<?*const u8, *mut u8>(path))) { return -1 }
      return 0
    }
    if kind == FS_MKSTEMP { return mkstempCall(q) }
    if kind == FS_OPEN { return i32.toIsize(open(nn<u8>(path), flags | O_CLOEXEC, mode)) }
    if kind == FS_READ { return readCall(q) }
    if kind == FS_SCANDIR { return scandirCall(q) }
    if kind == FS_OPENDIR { return opendirCall(q) }
    if kind == FS_READDIR { return readdirCall(q) }
    if kind == FS_CLOSEDIR { return closedirCall(q) }
    if kind == FS_READLINK { return readlinkCall(q) }
    if kind == FS_REALPATH { return realpathCall(q) }
    if kind == FS_RENAME { return i32.toIsize(rename(pathMany, newPath)) }
    if kind == FS_RMDIR { return i32.toIsize(rmdir(pathMany)) }
    if kind == FS_SENDFILE { return sendfileCall(q) }
    if kind == FS_STAT { return statCall(0, fd, path, statbuf) }
    if kind == FS_STATFS { return statfsCall(q) }
    if kind == FS_SYMLINK { return i32.toIsize(symlink(pathMany, newPath)) }
    if kind == FS_UNLINK { return i32.toIsize(unlink(pathMany)) }
    if kind == FS_WRITE { return writeAll(q) }
    abort()
    return -1
  }
}
// uv__fs_work: the operation, retried on EINTR except for close and read; the result is the
// count or -errno, and a successful stat points `ptr` at `statbuf`.
unsafe fn fsWork(q: *mut FsReq) -> () {
  unsafe {
    let anchor = () let r = Pointer.borrow<(), FsReq>(&anchor, q)
    let kind = r.fsType
    drop r
    let retry = !(kind == FS_CLOSE || kind == FS_READ)
    let mut result: isize = 0
    while true {
      setErrno(0)
      result = perform(q, kind)
      if !(result == -1 && errno() == EINTR && retry) { break }
    }
    let mut second = () let r2 = Pointer.borrowMut<(), FsReq>(&mut second, q)
    if result == -1 { r2.result = i32.toIsize(-errno()) } else { r2.result = result }
    if result == 0 && (kind == FS_STAT || kind == FS_FSTAT || kind == FS_LSTAT) {
      r2.ptr = Intrinsic.pointerReinterpret<*mut UvStat, *mut u8>(Pointer.fromMutRef<UvStat>(&mut r2.statbuf))
    }
  }
}
export "C" fn silkUvApiFsWork(unit: *mut Work) -> () { unsafe fsWork(unsafe fsOf(unsafe containerOf(unit, FS_WORK))) }
// uv__fs_done: the request stops holding the loop, then its callback runs.
export "C" fn silkUvApiFsDone(unit: *mut Work, status: i32) -> () {
  unsafe {
    let bytes = containerOf(unit, FS_WORK)
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, fsOf(bytes))
    uvl.requestFinished(loopMemory(r.loop))
    if status == -ECANCELED { r.result = i32.toIsize(-ECANCELED) }
    let callback = r.cb
    drop r
    if !Intrinsic.pointerIsNull<FsCallback>(callback) {
      let present = Intrinsic.pointerRequalify<FsCallback, extern "C" fn(*mut u8) -> ()>(callback)
      present(bytes)
    }
  }
}

// ---- Request setup (libuv's INIT, PATH, PATH2 and POST) -------------------------------------
// INIT: false (UV_EINVAL) without a request.
unsafe fn initRequest(loop: ?*mut u8, req: ?*mut u8, kind: i32, cb: FsCallback) -> bool {
  if Pointer.isNull<u8>(req) { return false }
  let mut anchor = () let r = unsafe Pointer.borrowMut<(), FsReq>(&mut anchor, unsafe fsOf(unsafe nnMut<u8>(req)))
  r.kind = UV_FS r.fsType = kind r.result = 0 r.ptr = Pointer.null<u8>() r.loop = loop
  r.path = Pointer.null<u8>() r.newPath = Pointer.null<u8>() r.bufs = Pointer.null<Buf>() r.cb = cb
  return true
}
fn isAsync(cb: FsCallback) -> bool { return !Intrinsic.pointerIsNull<FsCallback>(cb) }
// PATH: the caller's path for a synchronous request, a copy for an asynchronous one. 0 or UV_ENOMEM.
unsafe fn setPath(req: ?*mut u8, path: ?*const u8, cb: FsCallback) -> i32 {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, fsOf(nnMut<u8>(req)))
    if !isAsync(cb) { r.path = path return 0 }
    let copy = duplicate(nn<u8>(path))
    r.path = copy
    if Pointer.isNull<u8>(copy) { return -ENOMEM }
    return 0
  }
}
// PATH2: both paths in one allocation for an asynchronous request.
unsafe fn setPaths(req: ?*mut u8, path: ?*const u8, newPath: ?*const u8, cb: FsCallback) -> i32 {
  unsafe {
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, fsOf(nnMut<u8>(req)))
    if !isAsync(cb) { r.path = path r.newPath = newPath return 0 }
    let pathLength = strlen(nn<u8>(path)) + 1
    let newPathLength = strlen(nn<u8>(newPath)) + 1
    let memory = allocate(pathLength + newPathLength)
    r.path = memory
    if Pointer.isNull<u8>(memory) { return -ENOMEM }
    let second = byteAt(nnMut<u8>(memory), pathLength)
    r.newPath = second
    let _a = memcpy(nnMut<u8>(memory), nn<u8>(path), pathLength)
    let _b = memcpy(second, nn<u8>(newPath), newPathLength)
    return 0
  }
}
// POST: an asynchronous request holds the loop and goes to the pool as fast I/O; a synchronous
// one runs here and answers its result.
unsafe fn post(loop: ?*mut u8, req: ?*mut u8, cb: FsCallback) -> i32 {
  unsafe {
    let q = fsOf(nnMut<u8>(req))
    if isAsync(cb) {
      let memory = loopMemory(loop)
      uvl.requestStarted(memory)
      let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, q)
      let unit = Pointer.fromMutRef<Work>(&mut r.work)
      drop r
      uvl.workSubmit(memory, unit, uvl.WORK_FAST_IO, silkUvApiFsWork, silkUvApiFsDone)
      return 0
    }
    fsWork(q)
    let anchor = () let r2 = Pointer.borrow<(), FsReq>(&anchor, q)
    return isize.wrappingToI32(r2.result)
  }
}
unsafe fn setFields(req: ?*mut u8) -> *mut FsReq { return unsafe fsOf(unsafe nnMut<u8>(req)) }
// A request on a path (PATH), with `fill` done by the caller before POST.
unsafe fn pathRequest(loop: ?*mut u8, req: ?*mut u8, kind: i32, path: ?*const u8, cb: FsCallback) -> i32 {
  if !unsafe initRequest(loop, req, kind, cb) { return -EINVAL }
  return unsafe setPath(req, path, cb)
}
unsafe fn fsOpen(loop: ?*mut u8, req: ?*mut u8, path: ?*const u8, flags: i32, mode: i32, cb: FsCallback) -> i32 {
  unsafe {
    let status = pathRequest(loop, req, FS_OPEN, path, cb)
    if status != 0 { return status }
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, setFields(req))
    r.flags = flags r.mode = modeOf(mode)
    drop r
    return post(loop, req, cb)
  }
}
unsafe fn fsUnlink(loop: ?*mut u8, req: ?*mut u8, path: ?*const u8, cb: FsCallback) -> i32 {
  unsafe {
    let status = pathRequest(loop, req, FS_UNLINK, path, cb)
    if status != 0 { return status }
    return post(loop, req, cb)
  }
}
unsafe fn fsSendfile(loop: ?*mut u8, req: ?*mut u8, output: i32, input: i32, off: i64, length: usize, cb: FsCallback) -> i32 {
  unsafe {
    if !initRequest(loop, req, FS_SENDFILE, cb) { return -EINVAL }
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, setFields(req))
    // libuv keeps the input descriptor in `flags` and the length in bufsml[0].len.
    r.flags = input r.file = output r.off = off r.bufsml[0].len = length
    drop r
    return post(loop, req, cb)
  }
}
// A request on a descriptor.
unsafe fn fileRequest(loop: ?*mut u8, req: ?*mut u8, kind: i32, file: i32, cb: FsCallback) -> i32 {
  unsafe {
    if !initRequest(loop, req, kind, cb) { return -EINVAL }
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, setFields(req))
    r.file = file
    return 0
  }
}
// uv_fs_read and uv_fs_write: the bufs are copied for an asynchronous read and for every write.
unsafe fn ioRequest(loop: ?*mut u8, req: ?*mut u8, kind: i32, file: i32, bufs: ?*const Buf, nbufs: u32, off: i64, cb: FsCallback) -> i32 {
  unsafe {
    if !initRequest(loop, req, kind, cb) { return -EINVAL }
    if Pointer.isNull<Buf>(bufs) || nbufs == 0 { return -EINVAL }
    let mut anchor = () let r = Pointer.borrowMut<(), FsReq>(&mut anchor, setFields(req))
    r.file = file r.nbufs = nbufs r.off = off
    if kind == FS_READ && !isAsync(cb) {
      r.bufs = Intrinsic.pointerRequalify<?*const Buf, ?*mut Buf>(bufs)
      drop r
      return post(loop, req, cb)
    }
    let mut copy = Pointer.fromMutRef<Buf>(&mut r.bufsml[0])
    if nbufs > 4 {
      let memory = allocate(u32.toUsize(nbufs) * Layout.of<Buf>().bytes)
      if Pointer.isNull<u8>(memory) { r.bufs = Pointer.null<Buf>() return -ENOMEM }
      copy = Intrinsic.pointerReinterpret<*mut u8, *mut Buf>(nnMut<u8>(memory))
    }
    r.bufs = copy
    drop r
    let _copied = memcpy(Intrinsic.pointerReinterpret<*mut Buf, *mut u8>(copy), Intrinsic.pointerReinterpret<*const Buf, *const u8>(nn<Buf>(bufs)), u32.toUsize(nbufs) * Layout.of<Buf>().bytes)
    return post(loop, req, cb)
  }
}

