//! Byte histograms of the compressor: a port of `lib/compress/hist.c` of Zstandard 1.5.7.
//!
//! A count table is an array of `u32` behind a byte pointer, as the reference uses `unsigned*`.
//! Every function is `unsafe`: the caller proves that the tables and the source are inside live
//! allocations of the sizes the reference asks for.
import mem
import errors
import silk.num.u8
import silk.num.u32
import silk.num.usize

/// `HIST_WKSP_SIZE`: the bytes of workspace that the parallel count needs.
pub const WKSP_SIZE: usize = 4096

@inlineAlways
unsafe fn inc(count: [*]mut u8, symbol: usize) -> () {
  let at = usize.wrappingMultiply(symbol, 4)
  unsafe mem.w32(count, at, u32.wrappingAdd(unsafe mem.r32(unsafe mem.ro(count), at), 1))
}

@inlineAlways
unsafe fn get(count: [*]mut u8, symbol: usize) -> u32 {
  return unsafe mem.r32(unsafe mem.ro(count), usize.wrappingMultiply(symbol, 4))
}

/// `HIST_add`: adds the bytes of `src` to `count`, which is not reset first.
pub unsafe fn add(count: [*]mut u8, src: [*]const u8, srcSize: usize) -> () {
  let mut i: usize = 0
  while i < srcSize {
    unsafe inc(count, u8.toUsize(unsafe mem.r8(src, i)))
    i = mem.ua(i, 1)
  }
}

/// `HIST_count_simple`: counts the bytes of `src` into `count[0..=*maxSymbolValuePtr]`, sets
/// `*maxSymbolValuePtr` to the largest byte present and returns the largest count.
pub unsafe fn countSimple(count: [*]mut u8, maxSymbolValuePtr: &mut u32, src: [*]const u8, srcSize: usize) -> u32 {
  let mut maxSymbolValue = maxSymbolValuePtr.*
  let mut largestCount: u32 = 0
  let _m = unsafe mem.memset(count, 0, mem.z(maxSymbolValue + 1) * 4)
  if srcSize == 0 { maxSymbolValuePtr.* = 0 return 0 }
  let mut i: usize = 0
  while i < srcSize {
    unsafe inc(count, u8.toUsize(unsafe mem.r8(src, i)))
    i = mem.ua(i, 1)
  }
  while unsafe get(count, mem.z(maxSymbolValue)) == 0 { maxSymbolValue = maxSymbolValue - 1 }
  maxSymbolValuePtr.* = maxSymbolValue
  let mut s: u32 = 0
  while s <= maxSymbolValue {
    let c = unsafe get(count, mem.z(s))
    if c > largestCount { largestCount = c }
    s = s + 1
  }
  return largestCount
}

// `HIST_count_parallel_wksp`. `check` is `checkMaxSymbolValue`.
unsafe fn countParallel(count: [*]mut u8, maxSymbolValuePtr: &mut u32, src: [*]const u8, srcSize: usize, check: bool, workSpace: [*]mut u8) -> usize {
  let countSize = mem.z(maxSymbolValuePtr.* + 1) * 4
  let mut max: u32 = 0
  let c1 = workSpace
  let c2 = unsafe mem.add(workSpace, 1024)
  let c3 = unsafe mem.add(workSpace, 2048)
  let c4 = unsafe mem.add(workSpace, 3072)
  if srcSize == 0 {
    let _m = unsafe mem.memset(count, 0, countSize)
    maxSymbolValuePtr.* = 0
    return 0
  }
  let _m = unsafe mem.memset(workSpace, 0, 4096)
  // The reference reads 4 bytes ahead; the result is the same as counting each byte once.
  let mut ip: usize = 0
  if srcSize >= 20 {
    let mut cached = unsafe mem.r32(src, 0)
    ip = 4
    let limit = mem.us(srcSize, 15)
    while ip < limit {
      let mut c = cached
      cached = unsafe mem.r32(src, ip) ip = mem.ua(ip, 4)
      unsafe inc(c1, mem.z(c & 255))
      unsafe inc(c2, mem.z(u32.shiftRight(c, 8) & 255))
      unsafe inc(c3, mem.z(u32.shiftRight(c, 16) & 255))
      unsafe inc(c4, mem.z(u32.shiftRight(c, 24)))
      c = cached
      cached = unsafe mem.r32(src, ip) ip = mem.ua(ip, 4)
      unsafe inc(c1, mem.z(c & 255))
      unsafe inc(c2, mem.z(u32.shiftRight(c, 8) & 255))
      unsafe inc(c3, mem.z(u32.shiftRight(c, 16) & 255))
      unsafe inc(c4, mem.z(u32.shiftRight(c, 24)))
      c = cached
      cached = unsafe mem.r32(src, ip) ip = mem.ua(ip, 4)
      unsafe inc(c1, mem.z(c & 255))
      unsafe inc(c2, mem.z(u32.shiftRight(c, 8) & 255))
      unsafe inc(c3, mem.z(u32.shiftRight(c, 16) & 255))
      unsafe inc(c4, mem.z(u32.shiftRight(c, 24)))
      c = cached
      cached = unsafe mem.r32(src, ip) ip = mem.ua(ip, 4)
      unsafe inc(c1, mem.z(c & 255))
      unsafe inc(c2, mem.z(u32.shiftRight(c, 8) & 255))
      unsafe inc(c3, mem.z(u32.shiftRight(c, 16) & 255))
      unsafe inc(c4, mem.z(u32.shiftRight(c, 24)))
    }
    ip = mem.us(ip, 4)
  }
  while ip < srcSize {
    unsafe inc(c1, u8.toUsize(unsafe mem.r8(src, ip)))
    ip = mem.ua(ip, 1)
  }
  let mut s: usize = 0
  while s < 256 {
    let total = u32.wrappingAdd(u32.wrappingAdd(unsafe get(c1, s), unsafe get(c2, s)), u32.wrappingAdd(unsafe get(c3, s), unsafe get(c4, s)))
    unsafe mem.w32(c1, s * 4, total)
    if total > max { max = total }
    s = s + 1
  }
  let mut maxSymbolValue: u32 = 255
  while unsafe get(c1, mem.z(maxSymbolValue)) == 0 { maxSymbolValue = maxSymbolValue - 1 }
  if check && maxSymbolValue > maxSymbolValuePtr.* { return errors.err(errors.E_MAXSYMBOLVALUE_TOOSMALL) }
  maxSymbolValuePtr.* = maxSymbolValue
  let _c = unsafe mem.memmove(count, unsafe mem.ro(c1), countSize)
  return mem.z(max)
}

/// `HIST_countFast_wksp`: as [`countSimple`], for a source whose bytes are all at most
/// `*maxSymbolValuePtr`. `workSpace` has [`WKSP_SIZE`] bytes and is aligned to 4.
pub unsafe fn countFast(count: [*]mut u8, maxSymbolValuePtr: &mut u32, src: [*]const u8, srcSize: usize, workSpace: [*]mut u8, workSpaceSize: usize) -> usize {
  if srcSize < 1500 { return mem.z(unsafe countSimple(count, &mut maxSymbolValuePtr, src, srcSize)) }
  if (mem.addrm(workSpace) & 3) != 0 { return errors.err(errors.E_GENERIC) }
  if workSpaceSize < WKSP_SIZE { return errors.err(errors.E_WORKSPACE_TOOSMALL) }
  return unsafe countParallel(count, &mut maxSymbolValuePtr, src, srcSize, false, workSpace)
}

/// `HIST_count_wksp`: as [`countFast`], and fails with `maxSymbolValue_tooSmall` if a byte is
/// larger than `*maxSymbolValuePtr`.
pub unsafe fn count(count: [*]mut u8, maxSymbolValuePtr: &mut u32, src: [*]const u8, srcSize: usize, workSpace: [*]mut u8, workSpaceSize: usize) -> usize {
  if (mem.addrm(workSpace) & 3) != 0 { return errors.err(errors.E_GENERIC) }
  if workSpaceSize < WKSP_SIZE { return errors.err(errors.E_WORKSPACE_TOOSMALL) }
  if maxSymbolValuePtr.* < 255 {
    return unsafe countParallel(count, &mut maxSymbolValuePtr, src, srcSize, true, workSpace)
  }
  maxSymbolValuePtr.* = 255
  return unsafe countFast(count, &mut maxSymbolValuePtr, src, srcSize, workSpace, workSpaceSize)
}
