export "C" fn baselineTypeofIs(env: *mut BaselineEnv, cell: *mut ValueBits, how: u32) -> u32 {
  if unsafe engine.typeofIs(unsafe runtimeOf(env), cell, u32.wrappingToU8(how & 0xff), u32.wrappingToU8(u32.shiftRight(how, 8) & 0xff)) { return 1 }
  return 0
}
export "C" fn baselineUnary(env: *mut BaselineEnv, cell: *mut ValueBits, opcode: u32) -> u32 {
  if unsafe engine.unary(cell, u32.wrappingToU8(opcode)) { return 1 }
  return 0
}
export "C" fn baselineNot(env: *mut BaselineEnv, cell: *mut ValueBits) -> u32 {
  if unsafe engine.logicalNot(cell) { return 1 }
  return 0
