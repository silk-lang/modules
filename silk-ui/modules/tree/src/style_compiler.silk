import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }

/// A compiler callback is present only in hosts that opt into runtime CSS text.
/// It writes an owned Bytes into the initialized output and retains no pointers.
pub struct Compiler {
  active: bool,
  callback: extern "C" fn(?[*]const u8, usize, ?*mut u8) -> u32,
}
impl Copy for Compiler {}

export "C" fn disabled(source: ?[*]const u8, length: usize, output: ?*mut u8) -> u32 {
  drop source
  drop length
  drop output
  return 0
}

impl Compiler {
  pub fn enabled(self: &Self) -> bool { return self.active }
  pub fn off() -> Compiler { return Compiler { active: false, callback: disabled } }
  pub unsafe fn fromCallback(callback: extern "C" fn(?[*]const u8, usize, ?*mut u8) -> u32) -> Compiler {
    return Compiler { active: true, callback: callback }
  }
  pub fn call(self: &Self, source: &[u8]) -> Option<Bytes> {
    let mut bytes = Bytes.make()
    let output = unsafe Intrinsic.pointerReinterpret<*mut Bytes, *mut u8>(Pointer.fromMutRef(&mut bytes))
    let status = unsafe self.callback(Pointer.fromSlice(source), source.length, output)
    return if status == 1 { Option<Bytes>.some(move bytes) } else { Option<Bytes>.None }
  }
}

