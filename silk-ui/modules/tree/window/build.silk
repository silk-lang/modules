import silk.build.plan { Framework, Plan }
import silk.build.step { sourcePath }

// The Metal Performance HUD switch (native/metal_hud.m). Other platforms compile nothing here.
static fn plan() -> Plan {
  let mut plan = Plan.empty()
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan
      |> Plan.compileNative(
        "objc",
        sourcePath("native/metal_hud.m"),
        &["-fobjc-arc", "-fblocks", "-O2", "-Wall", "-Wextra", "-Werror", "-mmacosx-version-min=11.0"],
        &[],
      )
    plan = plan |> Plan.linkFramework("QuartzCore", Framework.make())
  }
  return plan
}

pub const PLAN: Plan = plan()
