//! Accessibility attributes in the document backend's markup, by their ARIA names.
import loom_dom.html { Html }
import loom_dom.wire
import loom.lib { Document, drain, NoCommand, Node, NoOutput, Program, Update }
import loom.program as program
import loom.backend { Backend, TreeError }
import ui_protocol.mutation { Mutation, Attribute, NodeKind, Role, TriState, Live, FIRST_ROOT }
import ui_protocol.options { RootOptions }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn has(text: &[u8], needle: string) -> bool {
  let wanted = String.utf8Bytes(needle)
  let mut at: usize = 0
  while at + wanted.length <= text.length {
    let mut i: usize = 0
    while i < wanted.length && text[at + i] == wanted[i] { i = i + 1 }
    if i == wanted.length { return true }
    at = at + 1
  }
  return false
}

effect fn set(page: &mut Html, attribute: Attribute) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut batch = List<Mutation>.make()
  run batch.append(Mutation.SetAttribute { id: 1, attribute: move attribute })
  run page.mutate(move batch)
}

test effect fn ariaAttributesReachTheMarkup() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run markupBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn markupBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut page = Html.make()
  let mut batch = List<Mutation>.make()
  run batch.append(Mutation.Create { id: 1, kind: NodeKind.Box })
  run batch.append(Mutation.OpenRoot { root: FIRST_ROOT, node: 1, options: RootOptions.default() })
  run page.mutate(move batch)
  run set(&mut page, Attribute.Role { value: Role.Alert })
  run set(&mut page, Attribute.Level { value: 2 })
  run set(&mut page, Attribute.Live { value: Live.Polite })
  run set(&mut page, Attribute.Pressed { value: TriState.Mixed })
  run set(&mut page, Attribute.Checked { value: true })
  run set(&mut page, Attribute.Indeterminate { value: true })
  run set(&mut page, Attribute.Description { value: run String.copy("Saved just now") })
  let markup = run page.markup()
  let text = Bytes.asSlice(&markup)
  run Testing.expect(has(text, "role=\"alert\""), "the new role")
  run Testing.expect(has(text, "aria-level=\"2\""), "a number")
  run Testing.expect(has(text, "aria-live=\"polite\""), "a keyword")
  run Testing.expect(has(text, "aria-pressed=\"mixed\""), "a three-way state")
  run Testing.expect(has(text, "aria-checked=\"mixed\""), "indeterminate wins over checked")
  run Testing.expect(has(text, "aria-description=\"Saved just now\""), "text")
  run set(&mut page, Attribute.Inert { value: true })
  let inert = run page.markup()
  run Testing.expect(has(Bytes.asSlice(&inert), "inert=\"true\""), "inert, as HTML spells it")

  run set(&mut page, Attribute.Live { value: Live.Off })
  let off = run page.markup()
  run Testing.expect(has(Bytes.asSlice(&off), "aria-live=\"off\""), "explicit off writes aria-live=off")

  run set(&mut page, Attribute.Level { value: 0 })
  run set(&mut page, Attribute.Live { value: Live.Unset })
  run set(&mut page, Attribute.Indeterminate { value: false })
  let cleared = run page.markup()
  let after = Bytes.asSlice(&cleared)
  run Testing.expect(!has(after, "aria-level") && !has(after, "aria-live"), "defaults leave the attribute out")
  run Testing.expect(has(after, "aria-checked=\"true\""), "checked again without indeterminate")
}

struct Toggle {
  on: bool,
}

union Flip {
  Flip,
}

type FlipNext = Update<Toggle, NoCommand, NoOutput>

impl Program<Flip, NoCommand> for Toggle {
  effect fn init() -> FlipNext ! OutOfMemoryError ? &mut Allocator {
    return FlipNext.of(Toggle { on: false })
  }

  effect fn update(mut model: Toggle, message: Flip) -> FlipNext ! OutOfMemoryError ? &mut Allocator {
    match move message {
      Flip.Flip => { model.on = !model.on }
    }
    return FlipNext.of(move model)
  }

  fn view(model: &Toggle, h: &Document<Flip>) -> Node {
    return h.column(
      &[
        h.accessRole(Role.Button),
        h.pressed(if model.on { TriState.True } else { TriState.False }),
        h.level(if model.on { 3 } else { 0 }),
        h.live(Live.Polite),
        h.description(if model.on { "On now" } else { "" }),
      ],
      &[h.text("Bold"), h.liveRegion(if model.on { "Bold on" } else { "" }, Live.Assertive)],
    )
  }
}

effect fn builderBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut page = Html.make()
  let mut app = run program.make<Toggle, Flip, NoCommand>()
  run app.start(&mut page, 0.0)
  run drain(&mut app, &mut page)
  let first = run page.markup()
  let before = Bytes.asSlice(&first)
  run Testing.expect(has(before, "aria-pressed=\"false\"") && has(before, "aria-live=\"polite\""), "builders reach the backend")
  run Testing.expect(!has(before, "aria-level") && !has(before, "aria-description"), "defaults set nothing")
  app.send(Flip.Flip)
  run drain(&mut app, &mut page)
  let second = run page.markup()
  let after = Bytes.asSlice(&second)
  run Testing.expect(has(after, "aria-pressed=\"true\"") && has(after, "aria-level=\"3\""), "changes are diffed")
  run Testing.expect(has(after, "aria-description=\"On now\""), "text attributes too")
  run Testing.expect(has(before, "aria-live=\"assertive\"") && !has(before, "Bold on"), "a live region is there, empty, from the start")
  run Testing.expect(has(after, "Bold on"), "and says its message when it changes")
}

test effect fn documentBuildersSetAriaAttributes() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run builderBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn setOn(page: &mut Html, id: u32, attribute: Attribute) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut batch = List<Mutation>.make()
  run batch.append(Mutation.SetAttribute { id: id, attribute: move attribute })
  run page.mutate(move batch)
}

effect fn ids(a: u32, b: u32) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut list = List<u32>.make()
  run list.append(a)
  if b != 0 { run list.append(b) }
  return move list
}

test effect fn relationsNameElementIds() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run relationsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn relationsBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut page = Html.make()
  let mut batch = List<Mutation>.make()
  run batch.append(Mutation.Create { id: 1, kind: NodeKind.Box })
  run batch.append(Mutation.Create { id: 2, kind: NodeKind.Box })
  run batch.append(Mutation.Create { id: 3, kind: NodeKind.Box })
  run batch.append(Mutation.InsertBefore { parent: 1, child: 2, before: Option<u32>.none() })
  run batch.append(Mutation.InsertBefore { parent: 1, child: 3, before: Option<u32>.none() })
  run batch.append(Mutation.OpenRoot { root: FIRST_ROOT, node: 1, options: RootOptions.default() })
  run page.mutate(move batch)
  run setOn(&mut page, 3, Attribute.ElementId { value: run String.copy("hint") })
  run setOn(&mut page, 1, Attribute.LabelledBy { ids: run ids(2, 9) })
  run setOn(&mut page, 1, Attribute.DescribedBy { ids: run ids(3, 0) })
  let markup = run page.markup()
  let text = Bytes.asSlice(&markup)
  run Testing.expect(has(text, "aria-labelledby=\"silk-2\""), "a target without an id is named by its node, and a missing one is left out")
  run Testing.expect(has(text, "id=\"silk-2\""), "and gets that id")
  run Testing.expect(has(text, "aria-describedby=\"hint\""), "a target with an id is named by it")
}

struct SelectorView { on: bool }
type SelectorNext = Update<SelectorView, NoCommand, NoOutput>
impl Program<Flip, NoCommand> for SelectorView {
  effect fn init() -> SelectorNext ! OutOfMemoryError ? &mut Allocator {
    return SelectorNext.of(SelectorView { on: false })
  }
  effect fn update(mut model: SelectorView, message: Flip) -> SelectorNext ! OutOfMemoryError ? &mut Allocator {
    drop message
    model.on = !model.on
    return SelectorNext.of(move model)
  }
  fn view(model: &SelectorView, h: &Document<Flip>) -> Node {
    if model.on {
      return h.column(&[h.class("button"), h.classWhen(!model.on, "primary"), h.classSelect(model.on, "closed", "open"),
        h.classes(&["wide", "", "tall dense"]), h.id("toggle"), h.attribute("data-state", "closed")], &[])
    }
    return h.column(&[h.class("button"), h.classWhen(!model.on, "primary"), h.classSelect(model.on, "closed", "open"),
      h.classes(&["wide", "", "tall dense"]), h.id("toggle"),
      h.attribute("data-state", "ignored"), h.attribute("data-state", "open"),
      h.attribute("data-empty", ""), h.attribute("aria-expanded", "false")], &[])
  }
}

effect fn literalBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError ? &mut Allocator {
  let mut page = Html.make()
  let mut app = run program.make<SelectorView, Flip, NoCommand>()
  run app.start(&mut page, 0.0)
  run drain(&mut app, &mut page)
  let first = run page.markup()
  run Testing.expect(has(first.asSlice(), "class=\"button primary open wide tall dense\"") && has(first.asSlice(), "id=\"toggle\""), "class helpers add up in order and reach markup with the id")
  run Testing.expect(has(first.asSlice(), "data-state=\"open\"") && !has(first.asSlice(), "ignored"), "last named assignment wins")
  run Testing.expect(has(first.asSlice(), "data-empty=\"\"") && has(first.asSlice(), "aria-expanded=\"false\""), "empty and false remain present")
  app.send(Flip.Flip)
  run drain(&mut app, &mut page)
  let second = run page.markup()
  run Testing.expect(has(second.asSlice(), "class=\"button closed wide tall dense\"") && has(second.asSlice(), "data-state=\"closed\""), "changed attributes replace previous values")
  run Testing.expect(!has(second.asSlice(), "data-empty") && !has(second.asSlice(), "aria-expanded"), "omitted named attributes are removed")
  app.send(Flip.Flip)
  run drain(&mut app, &mut page)
  let again = run page.markup()
  run Testing.expect(has(again.asSlice(), "data-empty=\"\""), "an attribute can be added again after removal")
}

test effect fn literalAttributesSurviveViewDiffAndRemoval() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run literalBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn literalMarkupBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError ? &mut Allocator {
  let mut page = Html.make()
  let mut batch = List<Mutation>.make()
  run batch.append(Mutation.Create { id: 1, kind: NodeKind.Box })
  run batch.append(Mutation.OpenRoot { root: FIRST_ROOT, node: 1, options: RootOptions.default() })
  run page.mutate(move batch)
  run set(&mut page, Attribute.Expanded { value: true })
  run set(&mut page, Attribute.Named { name: run String.copy("aria-expanded"), value: Option<String>.some(run String.copy("false")) })
  run set(&mut page, Attribute.Named { name: run String.copy("data-label"), value: Option<String>.some(run String.copy("<\"&")) })
  let literal = run page.markup()
  run Testing.expect(has(literal.asSlice(), "aria-expanded=\"false\"") && !has(literal.asSlice(), "aria-expanded=\"true\""), "literal attributes override typed spelling without duplicate attributes")
  run Testing.expect(has(literal.asSlice(), "data-label=\"&lt;&quot;&amp;\""), "literal values are escaped as markup")
  run set(&mut page, Attribute.Expanded { value: true })
  run set(&mut page, Attribute.Named { name: run String.copy("data-label"), value: Option<String>.None })
  let typed = run page.markup()
  run Testing.expect(has(typed.asSlice(), "aria-expanded=\"true\"") && !has(typed.asSlice(), "data-label"), "subsequent typed writes and explicit removal replace literal values")
}

test effect fn namedMarkupEscapesAndReplacesAttributes() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run literalMarkupBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn literalWireBody() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut bytes = Bytes.make()
  let set = Mutation.SetAttribute { id: 1, attribute: Attribute.Named {
    name: run String.copy("data-empty"), value: Option<String>.some(String.make()) } }
  run Testing.expect(run wire.writeMutation(&mut bytes, &set), "named mutation is carried by the wire")
  run Testing.expect(bytes.length() == 25 && bytes.asSlice()[0] == wire.OP_ATTRIBUTE
    && bytes.asSlice()[5] == 22 && bytes.asSlice()[20] == 1 && bytes.asSlice()[21] == 0, "empty is a present value with a zero byte length")
  let mut removed = Bytes.make()
  let remove = Mutation.SetAttribute { id: 1, attribute: Attribute.Named {
    name: run String.copy("data-empty"), value: Option<String>.None } }
  run Testing.expect(run wire.writeMutation(&mut removed, &remove), "removal is carried")
  run Testing.expect(removed.length() == 21 && removed.asSlice()[20] == 0, "removal has no value payload")
}

test effect fn namedWireDistinguishesEmptyFromAbsent() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run literalWireBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_protocol.batch { Batch }
import ui_protocol.mutation { StyleState }

effect fn customMarkupBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError ? &mut Allocator {
  let mut page = Html.make()
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.customProperty(1, StyleState.Base, "--Gap", Option<string>.some("8px"), true)
  run batch.customProperty(1, StyleState.Hover, "--content", Option<string>.some("'</style><script>'"), false)
  run batch.customProperty(1, StyleState.Base, "--empty", Option<string>.some(""), false)
  run page.mutate(run batch.take())
  let first = run page.markup()
  run Testing.expect(has(first.asSlice(), "--Gap: 8px !important;") && has(first.asSlice(), "--empty: ;"), "markup preserves custom property case, empty tokens and priority")
  run Testing.expect(has(first.asSlice(), ":hover{") && has(first.asSlice(), "--content:"), "state custom properties create a rule even without ordinary declarations")
  run Testing.expect(!has(first.asSlice(), "</style><script>"), "custom tokens cannot close the style element")
  run batch.customProperty(1, StyleState.Base, "--Gap", Option<string>.some("4px; color:red"), false)
  run page.mutate(run batch.take())
  let invalid = run page.markup()
  run Testing.expect(has(invalid.asSlice(), "--Gap: 8px !important;"), "invalid declaration tokens preserve the previous custom property")
  run batch.customProperty(1, StyleState.Base, "--Gap", Option<string<'static>>.None, false)
  run batch.push(Mutation.ClearStyle { id: 1, state: StyleState.Hover })
  run page.mutate(run batch.take())
  let removed = run page.markup()
  run Testing.expect(!has(removed.asSlice(), "--Gap:") && !has(removed.asSlice(), "--content:"), "removal and clearing a look remove their custom properties")
  let mut wireBytes = Bytes.make()
  let mutation = Mutation.SetCustomProperty { id: 1, state: StyleState.Base, name: run String.copy("--Gap"), value: Option<String>.None, important: false }
  run Testing.expect(run wire.writeMutation(&mut wireBytes, &mutation), "custom properties travel over the DOM wire")
  run Testing.expect(wireBytes.asSlice()[0] == wire.OP_CUSTOM_PROPERTY && wireBytes.length() == 17, "the removal wire payload contains the name and no value")
}

test effect fn customPropertiesReachMarkupAndDomWire() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run customMarkupBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_protocol.css

struct CustomView { on: bool }
type CustomNext = Update<CustomView, NoCommand, NoOutput>
impl Program<Flip, NoCommand> for CustomView {
  effect fn init() -> CustomNext ! OutOfMemoryError ? &mut Allocator {
    return CustomNext.of(CustomView { on: false })
  }
  effect fn update(mut model: CustomView, message: Flip) -> CustomNext ! OutOfMemoryError ? &mut Allocator {
    drop message
    model.on = !model.on
    return CustomNext.of(move model)
  }
  fn view(model: &CustomView, h: &Document<Flip>) -> Node {
    if model.on {
      return h.box(&[h.customProperty("--Keep", "8px"), h.customPropertyFor(StyleState.Hover, "--Hover", "2", true)], &[])
    }
    return h.box(&[h.style(&[css.height(css.px(10.0))]), h.customProperty("--Keep", "4px"),
      h.customProperty("--Keep", "8px"), h.customProperty("--Gone", ""),
      h.customPropertyFor(StyleState.Hover, "--Hover", "1", false)], &[])
  }
}

effect fn customDiffBody() -> () ! AssertionError<'static> | TreeError | OutOfMemoryError ? &mut Allocator {
  let mut page = Html.make()
  let mut app = run program.make<CustomView, Flip, NoCommand>()
  run app.start(&mut page, 0.0)
  run drain(&mut app, &mut page)
  let first = run page.markup()
  run Testing.expect(has(first.asSlice(), "--Keep: 8px;") && !has(first.asSlice(), "--Keep: 4px;"), "the last custom declaration in a look wins")
  run Testing.expect(has(first.asSlice(), "--Gone: ;"), "the custom helper can declare empty tokens")
  app.send(Flip.Flip)
  run drain(&mut app, &mut page)
  let next = run page.markup()
  run Testing.expect(has(next.asSlice(), "--Keep: 8px;"), "clearing an ordinary style restores unchanged custom properties in the same look")
  run Testing.expect(!has(next.asSlice(), "--Gone:") && has(next.asSlice(), "--Hover: 2 !important;"), "diff removes omitted custom properties and updates state looks")
}

test effect fn customPropertyHelpersSurviveStyleResetAndRemoval() -> () ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run customDiffBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_protocol.stylesheet { StyleSource }

effect fn runtimeSheetsBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError ? &mut Allocator {
  let mut page = Html.make()
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.loadStyleSheet(0, 9, run StyleSource.text(b".a { content: '</style><script>'; width: 8px }"))
  run batch.loadStyleSheet(0, 10, run StyleSource.url("theme.css?a=1&b=2"))
  run page.mutate(run batch.take())
  let first = run page.markup()
  run Testing.expect(has(first.asSlice(), "data-silk-runtime=\"9\"") && has(first.asSlice(), "width: 8px"), "server rendering includes runtime CSS text")
  run Testing.expect(!has(first.asSlice(), "</style><script>"), "runtime CSS cannot terminate its HTML style element")
  run Testing.expect(has(first.asSlice(), "data-silk-runtime=\"10\"") && has(first.asSlice(), "a=1&amp;b=2"), "server rendering links and escapes stylesheet URLs")
  run batch.loadStyleSheet(0, 9, run StyleSource.text(b".a { width: 12px }"))
  run batch.removeStyleSheet(0, 10)
  run page.mutate(run batch.take())
  let replaced = run page.markup()
  run Testing.expect(has(replaced.asSlice(), "width: 12px") && !has(replaced.asSlice(), "width: 8px") && !has(replaced.asSlice(), "data-silk-runtime=\"10\""), "replacement and removal update server-rendered stylesheet state")
  let mut bytes = Bytes.make()
  let load = Mutation.LoadStyleSheet { root: 0, sheet: 9, source: run StyleSource.text(b"a{}") }
  run Testing.expect(run wire.writeMutation(&mut bytes, &load), "runtime CSS travels over the DOM wire")
  run Testing.expect(bytes.length() == 17 && bytes.asSlice()[0] == 38 && bytes.asSlice()[9] == 0, "wire identifies CSS text separately from a URL")
  run batch.closeRoot(0)
  run page.mutate(run batch.take())
  let closed = run page.markup()
  run Testing.expect(!has(closed.asSlice(), "data-silk-runtime"), "closing a root releases its sheets")
}

test effect fn runtimeStylesheetsReachMarkupAndDomWire() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run runtimeSheetsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

struct TopView { on: bool }
type TopNext = Update<TopView, NoCommand, NoOutput>
impl Program<Flip, NoCommand> for TopView {
  effect fn init() -> TopNext ! OutOfMemoryError ? &mut Allocator {
    return TopNext.of(TopView { on: false })
  }
  effect fn update(mut model: TopView, message: Flip) -> TopNext ! OutOfMemoryError ? &mut Allocator {
    drop message
    model.on = !model.on
    return TopNext.of(move model)
  }
  fn view(model: &TopView, h: &Document<Flip>) -> Node {
    return h.box(&[h.classWhen(model.on, "cards")], &[])
  }
}

effect fn topBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError ? &mut Allocator {
  let mut page = Html.make()
  let mut app = run program.make<TopView, Flip, NoCommand>()
  run app.start(&mut page, 0.0)
  run drain(&mut app, &mut page)
  let plain = run page.markup()
  run Testing.expect(has(plain.asSlice(), "flex-direction") && has(plain.asSlice(), "box-sizing"), "a top node without classes is a column filling its viewport")
  app.send(Flip.Flip)
  run drain(&mut app, &mut page)
  let classed = run page.markup()
  run Testing.expect(!has(classed.asSlice(), "flex-direction") && has(classed.asSlice(), "box-sizing"), "with classes it leaves display to the stylesheets and still fills its viewport")
  app.send(Flip.Flip)
  run drain(&mut app, &mut page)
  let again = run page.markup()
  run Testing.expect(has(again.asSlice(), "flex-direction"), "and it is a column again once the classes go")
}

test effect fn aClassedTopNodeLeavesDisplayToStylesheets() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run topBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
