//! The document a screen reader reads: the accessibility tree laid out as the flat buffer
//! that NVDA, JAWS, Narrator and Orca build for browse mode, and that VoiceOver walks element
//! by element.
//!
//! Every exposed node becomes an [`Info`] (the facts a reader says about it). Text and
//! controls become [`Item`]s, in tree order: one per line fragment of text (a text run), one
//! per control. Containers a reader announces (headings, links, lists, tables, landmarks,
//! dialogs) are *fields*: each item lists the fields it is inside, outermost first, so a
//! reader can say what the cursor entered and left. Items are grouped into lines by their
//! bounds, as on screen, and a block field (a heading, a list item, a cell) always starts and
//! ends a line.
import accesskit.lib { Role, Toggled, Live, Rect }
import accesskit_consumer.lib { TreeState, NodeRef, FullNodeId, NodeFilter, FilterResult }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.usize
import silk.num.f64
import silk.text.string { String }

/// What a reader says about one node.
pub struct Info {
  pub id: FullNodeId,
  pub kind: Role,
  /// The accessible name, or for a control named by its content, that content.
  pub name: String,
  pub value: String,
  pub description: String,
  pub placeholder: String,
  /// The heading level, or 0.
  pub level: usize,
  pub toggled: Option<Toggled>,
  pub expanded: Option<bool>,
  pub selected: Option<bool>,
  pub disabled: bool,
  pub readOnly: bool,
  pub required: bool,
  pub invalid: bool,
  pub visited: bool,
  pub modal: bool,
  pub focusable: bool,
  pub focused: bool,
  /// 1-based place in its set and the set's size, or 0.
  pub position: usize,
  pub setSize: usize,
  /// Items of a list, rows and columns of a table.
  pub count: usize,
  pub rows: usize,
  pub columns: usize,
  pub live: Live,
  pub atomic: bool,
  pub bounds: Option<Rect>,
}

impl Info {
  /// An info with only an id and a role, every state unset.
  pub fn blank(id: FullNodeId, kind: Role) -> Info {
    return Info {
      id: id,
      kind: kind,
      name: String.make(),
      value: String.make(),
      description: String.make(),
      placeholder: String.make(),
      level: 0,
      toggled: Option.None,
      expanded: Option.None,
      selected: Option.None,
      disabled: false,
      readOnly: false,
      required: false,
      invalid: false,
      visited: false,
      modal: false,
      focusable: false,
      focused: false,
      position: 0,
      setSize: 0,
      count: 0,
      rows: 0,
      columns: 0,
      live: Live.Off,
      atomic: false,
      bounds: Option.None,
    }
  }
}

/// One stop of the virtual cursor: a line fragment of text, or a control.
pub struct Item {
  /// The node it belongs to: the text node, or the control.
  pub info: usize,
  /// Its text, for text. Controls have none: a reader says their [`Info`].
  pub text: String,
  /// Byte offsets in `text` where words start.
  pub words: List<usize>,
  /// What it covers on screen (the text run's bounds for text).
  pub bounds: Option<Rect>,
  /// The fields it is inside, outermost first: `path[pathStart..pathStart + pathLength]`.
  pub pathStart: usize,
  pub pathLength: usize,
  /// The line it is on.
  pub line: usize,
}

impl Item {
  pub fn isText(self: &Self) -> bool {
    return String.byteLength(self.text.view()) != 0 || self.words.length() != 0
  }
}

/// The document of one tree state.
pub struct Document {
  pub infos: List<Info>,
  pub items: List<Item>,
  /// The fields of every item, as indexes into `infos` (see [`Item.pathStart`]).
  pub path: List<usize>,
  /// The first item of each line.
  pub lines: List<usize>,
  /// The window's title.
  pub title: String,
}

impl Document {
  pub fn empty() -> Document {
    return Document {
      infos: List<Info>.make(),
      items: List<Item>.make(),
      path: List<usize>.make(),
      lines: List<usize>.make(),
      title: String.make(),
    }
  }

  /// The document of `state`.
  pub effect fn of(state: &TreeState) -> Document
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut document = Document.empty()
    let root = state.rootNode()
    match root.data().label() {
      Option.Some { value } => run document.title.append(value)
      Option.None => {}
    }
    let mut fields = List<usize>.make()
    run document.walk(root, &mut fields)
    run document.layLines()
    return move document
  }

  pub fn info(self: &Self, index: usize) -> &Info {
    return &self.infos.asSlice()[index]
  }

  pub fn item(self: &Self, index: usize) -> &Item {
    return &self.items.asSlice()[index]
  }

  /// The fields item `index` is inside, outermost first.
  pub fn fieldsOf(self: &Self, index: usize) -> &[usize] {
    let item = self.item(index)
    return Slice.view<usize>(self.path.asSlice(), item.pathStart, item.pathLength)
  }

  /// The items of line `line`: `[start, end)`.
  pub fn lineStart(self: &Self, line: usize) -> usize {
    return self.lines.get(line)
  }

  pub fn lineEnd(self: &Self, line: usize) -> usize {
    if line + 1 < self.lines.length() {
      return self.lines.get(line + 1)
    }
    return self.items.length()
  }

  /// The info of node `id`, if it is in the document.
  pub fn find(self: &Self, id: FullNodeId) -> Option<usize> {
    let mut i: usize = 0
    while i < self.infos.length() {
      if self.infos.asSlice()[i].id.equals(id) {
        return Option.Some { value: i }
      }
      i = i + 1
    }
    return Option.None
  }

  /// The first item of info `info`: its own item, or the first item inside it.
  pub fn firstItemOf(self: &Self, info: usize) -> Option<usize> {
    let mut i: usize = 0
    while i < self.items.length() {
      if self.within(i, info) {
        return Option.Some { value: i }
      }
      i = i + 1
    }
    return Option.None
  }

  /// Whether item `index` is info `info`'s or inside it.
  pub fn within(self: &Self, index: usize, info: usize) -> bool {
    if self.item(index).info == info {
      return true
    }
    let fields = self.fieldsOf(index)
    let mut f: usize = 0
    while f < fields.length {
      if fields[f] == info {
        return true
      }
      f = f + 1
    }
    return false
  }

  /// The bounds of info `info`: its own, or those of its items joined.
  pub fn boundsOf(self: &Self, info: usize) -> Option<Rect> {
    match self.info(info).bounds {
      Option.Some { value } => {
        return Option.Some { value: value }
      }
      Option.None => {}
    }
    let mut out = Option<Rect>.None
    let mut i: usize = 0
    while i < self.items.length() {
      if self.within(i, info) {
        if let Option<Rect>.Some { value } = self.item(i).bounds {
          out = Option.Some { value: joined(out, value) }
        }
      }
      i = i + 1
    }
    return out
  }

  effect fn walk(self: &mut Self, node: NodeRef<'_>, fields: &mut List<usize>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if node.isHidden() {
      return ()
    }
    let kind = node.accessRole()
    if kind == Role.TextRun {
      return ()
    }
    if isControl(kind) || (kind == Role.Link && !run hasText(node)) {
      let info = run self.describe(node)
      run self.push(info, String.make(), List<usize>.make(), node.boundingBox(), fields.asSlice())
      return ()
    }
    if kind == Role.Label || hasRuns(node) {
      let info = run self.describe(node)
      run self.text(node, info, fields.asSlice())
      return ()
    }
    let field = isField(node)
    if field {
      let info = run self.describe(node)
      run fields.append(info)
    } else if kind != Role.Window && kind != Role.GenericContainer && kind != Role.RootWebArea
      && node.data().label().isSome() && node.childCount() == 0 {
      // A named box with nothing inside: a reader says its name.
      let info = run self.describe(node)
      run self.push(info, String.make(), List<usize>.make(), node.boundingBox(), fields.asSlice())
      return ()
    }
    let mut children = List<NodeRef<'_>>.make()
    run node.children(&mut children)
    let mut i: usize = 0
    while i < children.length() {
      run self.walk(children.get(i), &mut fields)
      i = i + 1
    }
    if field {
      drop fields.pop()
    }
  }

  /// Items for the text of `node`: one per text run, or one for its value.
  effect fn text(self: &mut Self, node: NodeRef<'_>, info: usize, fields: &[usize]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut children = List<NodeRef<'_>>.make()
    run node.children(&mut children)
    let mut runs: usize = 0
    let mut i: usize = 0
    while i < children.length() {
      let child = children.get(i)
      i = i + 1
      if child.accessRole() != Role.TextRun {
        continue
      }
      let data = child.data()
      let value = data.value().unwrapOr("")
      if String.byteLength(value) == 0 {
        continue
      }
      let mut text = String.make()
      run text.append(value)
      let mut words = List<usize>.make()
      run wordOffsets(value, data.characterLengths(), data.wordStarts(), &mut words)
      run self.push(info, move text, move words, child.boundingBox(), fields)
      runs = runs + 1
    }
    if runs == 0 {
      let value = match node.data().value() {
        Option.Some { value } => value
        Option.None => node.data().label().unwrapOr("")
      }
      if String.byteLength(String.trim(value)) == 0 {
        return ()
      }
      let mut text = String.make()
      run text.append(value)
      let mut words = List<usize>.make()
      run spaceWords(value, &mut words)
      run self.push(info, move text, move words, node.boundingBox(), fields)
    }
  }

  effect fn push(
    self: &mut Self,
    info: usize,
    text: String,
    words: List<usize>,
    bounds: Option<Rect>,
    fields: &[usize],
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let start = self.path.length()
    run self.path.appendSlice(fields)
    run self.items.append(Item {
      info: info,
      text: move text,
      words: move words,
      bounds: bounds,
      pathStart: start,
      pathLength: fields.length,
      line: 0,
    })
  }

  effect fn describe(self: &mut Self, node: NodeRef<'_>) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let data = node.data()
    let kind = node.accessRole()
    let mut name = String.make()
    let labelled = run node.writeLabel(&mut name)
    if !labelled && namedByContent(kind) {
      run contentText(node, &mut name)
    }
    let mut value = String.make()
    if kind != Role.Label {
      drop run node.writeValue(&mut value)
    }
    let mut description = String.make()
    run description.append(data.description().unwrapOr(""))
    let mut placeholder = String.make()
    run placeholder.append(data.placeholder().unwrapOr(""))
    let mut count: usize = 0
    let mut rows: usize = 0
    let mut columns: usize = 0
    if kind == Role.List || kind == Role.ListBox || kind == Role.Menu || kind == Role.Tree {
      count = run countRole(node, &[Role.ListItem, Role.ListBoxOption, Role.MenuItem, Role.TreeItem])
    }
    if kind == Role.Table || kind == Role.Grid || kind == Role.TreeGrid {
      rows = data.rowCount().unwrapOr(run countRole(node, &[Role.Row]))
      columns = data.columnCount().unwrapOr(run widestRow(node))
    }
    let index = self.infos.length()
    run self.infos.append(Info {
      id: node.id,
      kind: kind,
      name: move name,
      value: move value,
      description: move description,
      placeholder: move placeholder,
      level: node.level().unwrapOr(0),
      toggled: node.toggled(),
      expanded: data.isExpanded(),
      selected: node.isSelected(),
      disabled: node.isDisabled(),
      readOnly: data.isReadOnly(),
      required: node.isRequired(),
      invalid: data.invalid().isSome(),
      visited: data.isVisited(),
      modal: node.isModal(),
      focusable: node.isFocusable(&EveryNode {}),
      focused: node.isFocused(),
      position: node.positionInSet().unwrapOr(0),
      setSize: node.sizeOfSet().unwrapOr(0),
      count: count,
      rows: rows,
      columns: columns,
      live: match data.live() {
        Option.Some { value: live } => live
        Option.None => Live.Off
      },
      atomic: node.isLiveAtomic(),
      bounds: node.boundingBox(),
    })
    return index
  }

  /// Groups the items into lines: an item continues the line of the one before when both are
  /// in the same block fields and it sits beside it on screen.
  effect fn layLines(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.lines.clear()
    let mut i: usize = 0
    while i < self.items.length() {
      if i == 0 || !self.continuesLine(i - 1, i) {
        run self.lines.append(i)
      }
      let line = self.lines.length() - 1
      let item = &mut self.items.asMutSlice()[i]
      item.line = line
      i = i + 1
    }
  }

  fn continuesLine(self: &Self, before: usize, at: usize) -> bool {
    if self.blocks(before) != self.blocks(at) {
      return false
    }
    let a = self.item(before)
    let b = self.item(at)
    if !a.isText() && !b.isText() && isBlockControl(self.info(a.info).kind) {
      return false
    }
    return match a.bounds {
      Option.Some { value: ra } => match b.bounds {
        Option.Some { value: rb } => {
          let overlap = f64.min(ra.y1, rb.y1) - f64.max(ra.y0, rb.y0)
          let shorter = f64.min(ra.y1 - ra.y0, rb.y1 - rb.y0)
          overlap > shorter * 0.5 && rb.x0 >= ra.x0
        }
        Option.None => false
      }
      Option.None => false
    }
  }

  /// A key for the block fields an item is in: the innermost one's index plus one, or 0.
  fn blocks(self: &Self, index: usize) -> usize {
    let fields = self.fieldsOf(index)
    let mut f = fields.length
    while f > 0 {
      f = f - 1
      if isBlockField(self.info(fields[f]).kind) {
        return fields[f] + 1
      }
    }
    return 0
  }
}

fn joined(a: Option<Rect>, b: Rect) -> Rect {
  return match a {
    Option.Some { value } => Rect {
      x0: f64.min(value.x0, b.x0),
      y0: f64.min(value.y0, b.y0),
      x1: f64.max(value.x1, b.x1),
      y1: f64.max(value.y1, b.y1),
    }
    Option.None => b
  }
}

struct EveryNode {}

impl NodeFilter for EveryNode {
  fn filter(self: &Self, node: &NodeRef<'_>) -> FilterResult {
    return FilterResult.Include
  }
}

/// Roles a reader treats as one stop, its children presentational.
pub fn isControl(kind: Role) -> bool {
  return match kind {
    Role.Button => true
    Role.DefaultButton => true
    Role.CheckBox => true
    Role.RadioButton => true
    Role.Switch => true
    Role.TextInput => true
    Role.MultilineTextInput => true
    Role.SearchInput => true
    Role.DateInput => true
    Role.DateTimeInput => true
    Role.WeekInput => true
    Role.MonthInput => true
    Role.TimeInput => true
    Role.EmailInput => true
    Role.NumberInput => true
    Role.PasswordInput => true
    Role.PhoneNumberInput => true
    Role.UrlInput => true
    Role.ComboBox => true
    Role.EditableComboBox => true
    Role.Slider => true
    Role.SpinButton => true
    Role.ProgressIndicator => true
    Role.Meter => true
    Role.Image => true
    Role.Tab => true
    Role.MenuItem => true
    Role.MenuItemCheckBox => true
    Role.MenuItemRadio => true
    Role.ListBoxOption => true
    Role.TreeItem => true
    Role.Splitter => true
    Role.ColorWell => true
    Role.ScrollBar => true
    _ => false
  }
}

/// Controls that sit on a line of their own (everything but buttons, links and images, which
/// can be inline).
fn isBlockControl(kind: Role) -> bool {
  return match kind {
    Role.Button => false
    Role.DefaultButton => false
    Role.Image => false
    Role.Link => false
    _ => true
  }
}

/// Whether a reader takes a control's name from its content when it has no label.
fn namedByContent(kind: Role) -> bool {
  return isControl(kind) || kind == Role.Link || kind == Role.Heading || kind == Role.Cell
    || kind == Role.ColumnHeader || kind == Role.RowHeader || kind == Role.GridCell
}

pub fn isLandmark(kind: Role) -> bool {
  return match kind {
    Role.Navigation => true
    Role.Main => true
    Role.Banner => true
    Role.ContentInfo => true
    Role.Complementary => true
    Role.Search => true
    Role.Form => true
    Role.Region => true
    _ => false
  }
}

/// Containers a reader announces on the way in (and some on the way out).
fn isField(node: NodeRef<'_>) -> bool {
  let kind = node.accessRole()
  if kind == Role.Group || kind == Role.Region {
    return node.data().label().isSome()
  }
  return match kind {
    Role.Heading => true
    Role.Link => true
    Role.List => true
    Role.ListItem => true
    Role.Table => true
    Role.Grid => true
    Role.TreeGrid => true
    Role.Row => true
    Role.Cell => true
    Role.GridCell => true
    Role.ColumnHeader => true
    Role.RowHeader => true
    Role.Dialog => true
    Role.AlertDialog => true
    Role.Alert => true
    Role.Blockquote => true
    Role.Figure => true
    Role.Article => true
    Role.Paragraph => true
    Role.Toolbar => true
    Role.Menu => true
    Role.MenuBar => true
    Role.TabList => true
    Role.TabPanel => true
    Role.ListBox => true
    Role.Tree => true
    Role.RadioGroup => true
    _ => isLandmark(kind)
  }
}

/// Fields that start and end a line.
pub fn isBlockField(kind: Role) -> bool {
  return kind != Role.Link
}

fn hasRuns(node: NodeRef<'_>) -> bool {
  let mut i: usize = 0
  while i < node.childCount() {
    match node.childAt(i) {
      Option.Some { value } => {
        if value.accessRole() == Role.TextRun {
          return true
        }
      }
      Option.None => {}
    }
    i = i + 1
  }
  return false
}

effect fn hasText(node: NodeRef<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  run contentText(node, &mut text)
  return String.byteLength(String.trim(text.view())) != 0
}

/// The text inside `node`, joined by spaces, image names included.
effect fn contentText(node: NodeRef<'_>, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < node.childCount() {
    match node.childAt(i) {
      Option.Some { value: child } => {
        if !child.isHidden() {
          let kind = child.accessRole()
          if kind == Role.Label {
            run appendWord(&mut out, child.data().value().unwrapOr(""))
          } else if kind == Role.Image {
            run appendWord(&mut out, child.data().label().unwrapOr(""))
          }
          if kind != Role.Label && kind != Role.TextRun {
            run contentText(child, &mut out)
          }
        }
      }
      Option.None => {}
    }
    i = i + 1
  }
}

/// Appends `value` trimmed, a space before it when `out` has text.
pub effect fn appendWord(out: &mut String, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let trimmed = String.trim(value)
  if String.byteLength(trimmed) == 0 {
    return ()
  }
  if String.byteLength(out.view()) != 0 {
    run out.append(" ")
  }
  run out.append(trimmed)
}

effect fn countRole(node: NodeRef<'_>, roles: &[Role]) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut count: usize = 0
  let mut i: usize = 0
  while i < node.childCount() {
    match node.childAt(i) {
      Option.Some { value: child } => {
        if !child.isHidden() {
          let kind = child.accessRole()
          let mut r: usize = 0
          let mut matched = false
          while r < roles.length {
            if roles[r] == kind {
              matched = true
            }
            r = r + 1
          }
          if matched {
            count = count + 1
          } else if kind == Role.GenericContainer || kind == Role.RowGroup || kind == Role.Group {
            count = count + run countRole(child, roles)
          }
        }
      }
      Option.None => {}
    }
    i = i + 1
  }
  return count
}

effect fn widestRow(node: NodeRef<'_>) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut widest: usize = 0
  let mut i: usize = 0
  while i < node.childCount() {
    match node.childAt(i) {
      Option.Some { value: child } => {
        let kind = child.accessRole()
        if kind == Role.Row {
          let cells = run countRole(
            child,
            &[Role.Cell, Role.GridCell, Role.ColumnHeader, Role.RowHeader],
          )
          if cells > widest {
            widest = cells
          }
        } else if kind == Role.GenericContainer || kind == Role.RowGroup {
          let inner = run widestRow(child)
          if inner > widest {
            widest = inner
          }
        }
      }
      Option.None => {}
    }
    i = i + 1
  }
  return widest
}

/// Byte offsets of word starts from a text run's character lengths and word starts.
effect fn wordOffsets(text: string, lengths: &[u8], starts: &[u8], out: &mut List<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if lengths.length == 0 || starts.length == 0 {
    run spaceWords(text, &mut out)
    return ()
  }
  let mut offset: usize = 0
  let mut character: usize = 0
  let mut s: usize = 0
  while character < lengths.length && s < starts.length {
    if u8.toUsize(starts[s]) == character {
      run out.append(offset)
      s = s + 1
    }
    offset = offset + u8.toUsize(lengths[character])
    character = character + 1
  }
  if out.length() == 0 || out.get(0) != 0 {
    run out.insertSlice(0, &[0])
  }
}

/// Word starts at each non-space after a space.
pub effect fn spaceWords(text: string, out: &mut List<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut i: usize = 0
  let mut space = true
  while i < bytes.length {
    let b = bytes[i]
    let isSpace = b == 32 || b == 9 || b == 10 || b == 13
    if space && !isSpace {
      run out.append(i)
    }
    space = isSpace
    i = i + 1
  }
}
