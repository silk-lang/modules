//! libuv 1.51's thread, synchronization, error, process, OS and address functions, exported as C
//! symbols with libuv's names, signatures, struct layouts and statuses, so that a Node-API addon
//! compiled against libuv's own uv.h links against the runtime as it linked against Node.
//!
//! Each export follows the C function of the same name in libuv (src/unix/thread.c,
//! src/thread-common.c, src/unix/core.c, src/uv-common.c, src/unix/proctitle.c, src/idna.c,
//! src/inet.c, src/unix/dl.c, src/unix/tty.c, src/unix/pipe.c, src/unix/tcp.c, src/unix/process.c,
//! src/unix/getaddrinfo.c, src/random.c and src/unix/random-*.c) on GNU/Linux (x86_64, aarch64)
//! and Darwin (arm64), as built without assertions (NDEBUG), as Node and the libuv release
//! archives are: 0 or a negative errno (`UV_E*`), abort() where libuv aborts, the same buffer
//! conventions, and the same allocations, made through the functions that uv_replace_allocator
//! installs (`ext.uv_os`). The OS queries that `ext.uv_os` and `ext.uv_inet` already answer with
//! libuv's semantics are exported as thin wrappers that add libuv's argument checks.
//!
//! The runtime never calls uv_setup_args, so uv_get_process_title and uv_set_process_title answer
//! as libuv does then (UV_ENOBUFS) unless a caller does; the runtime's own process.title does not
//! go through them. What differs from libuv on purpose:
//! - uv_thread_create and uv_thread_create_ex start the thread through a Silk entry that calls the
//!   caller's (libuv casts the entry to a start routine), so the thread's exit value is null where
//!   libuv's is whatever the entry left in the result register, and a failed allocation of the
//!   two-word start record is UV_ENOMEM.
//! - uv_sem_* on glibc older than 2.21 would use libuv's mutex-and-condition semaphore; glibc's
//!   sem_t is used on every glibc (2.21 is from 2015).
//! - uv_library_shutdown releases what this module keeps (the uv_setup_args copy); libuv also
//!   closes its signal pipe and stops its thread pool, which are not this module's.
//! - The descriptors that uv_pipe and uv_socketpair close on failure are closed with close(), not
//!   with the non-cancelable system call.
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.concurrency.atomic { Atomic, MemoryOrder, CompareExchange }
import silk.core.ownership { Copy }
import silk.num.i32
import silk.num.i64
import silk.num.isize
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.f64
import ext.uv_os as os
import ext.uv_os { Cpu, Interface, Passwd, Group, EnvItem, Uname, Usage, MallocFunction, ReallocFunction, CallocFunction, FreeFunction }
import ext.uv_inet as inet
import silkjsruntime.ext.uv_errno as errors
import ext.uv_shapes { UvBuf }

