struct Expression { index: usize, program: ColorProgram }

pub struct RootSheets {
  pub states: States,
  pub cache: Cache,
  pub loads: List<Status>,
  pub root: u32,
  pub inlineVariables: bool,
  pub hasStarting: bool,
  pub startingSubjects: StartingSubjects,
  /// The subjects of the rules that test a state on an ancestor (`StateSubjects`).
  pub stateSubjects: StateSubjects,
  /// O(1) class, attribute, and id invalidation extents for adopted rules.
  pub invalidation: InvalidationMap,
  pub hasGenerated: bool,
  pub beforeSubjects: PseudoSubjects,
  pub afterSubjects: PseudoSubjects,
  /// Some rule styles `::marker`.
  pub hasMarker: bool,
  pub hasFirstLetter: bool,
  pub firstLetterSubjects: PseudoSubjects,
  pub hasFirstLine: bool,
  pub firstLineSubjects: PseudoSubjects,
  pub hasSelection: bool,
  pub selectionSubjects: PseudoSubjects,
  pub hasPlaceholder: bool,
  pub hasScrollbars: bool,
  pub scrollbarSubjects: PseudoSubjects,
  /// The `READS_*` relations of the adopted rules, from `style_invalidation.reads`.
  pub reads: u32,
  /// The bounds a shared match has to respect, from `style_invalidation.sharing`.
  pub sharing: Sharing,
  /// Since the last root restyle, some node is watched with `WATCH_HAS_SIBLINGS`.
  pub siblingAnchors: bool,
  /// Since the last root restyle, some match watched more elements than a match context holds:
  /// an element it tested inside a `:has()` may carry no watch.
  pub watchOverflowed: bool,
  pub sheets: StyleSheets,
  pub environment: Environment,
  /// The environment the work counters last counted an evaluation of the sheets' conditions for.
  pub evaluated: Environment,
  pub systemColors: [Color; 19],
}
impl RootSheets {
  pub fn make(root: u32) -> RootSheets {
    return RootSheets { states: States.make(), cache: Cache.make(), loads: List<Status>.make(), root: root, inlineVariables: false, hasStarting: false, hasGenerated: false, beforeSubjects: PseudoSubjects.make(), afterSubjects: PseudoSubjects.make(), hasMarker: false, hasFirstLetter: false, firstLetterSubjects: PseudoSubjects.make(), hasFirstLine: false, firstLineSubjects: PseudoSubjects.make(), hasSelection: false, selectionSubjects: PseudoSubjects.make(), hasPlaceholder: false, hasScrollbars: false, scrollbarSubjects: PseudoSubjects.make(), reads: 0, siblingAnchors: false, watchOverflowed: false, sharing: Sharing.none(), sheets: StyleSheets.make(), environment: Environment.headless(0.0, 0.0), evaluated: Environment.headless(0.0, 0.0),
      startingSubjects: StartingSubjects.make(), stateSubjects: StateSubjects.make(), invalidation: InvalidationMap.make(), systemColors: [Color.srgb(0.0, 0.0, 0.0, 1.0); 19] }
  }
}
pub struct Resolved {
  /// The result depends only on the cascade inputs and the parent, so equal nodes may share it.
  pub plain: bool,
  /// The custom properties the values here mention, as name bits (`VariableMasks`): under a
  /// parent scope that differs in none of them, the same match gives these declarations
  /// again. Every bit is set when a container, an override, a starting style, an animation
  /// or an inline value kept as text feeds the style.
  pub variables: u64,
  /// The custom properties it declares, as name bits.
  pub declares: u64,
  /// The candidates of its match that declare a custom property: with the node's inline
  /// custom properties, what gives its scope under another parent (`movedScope`).
  pub customs: List<Candidate>,
  /// What matching read about the node's siblings, index and descendants, and in the bits
  /// above `READS_ABOVE` about its ancestors': `MatchContext.reads`.
  pub reads: u32,
  pub states: u32,
  pub keyframes: List<Rule>,
  pub overrides: List<Declaration>,
  pub starting: Option<List<Declaration>>,
  pub declarations: List<Declaration>,
  pub matches: List<MatchedRule>,
  pub scope: ScopeId,
}

pub struct Resolution {
  /// Highlight backgrounds inherit their currentColor expression, not an ancestor's used color.
  pub highlightBackground: Option<ColorProgram>,
  pub style: Resolved,
  pub containers: List<ContainerDependency>,
  /// An equal node's style from this pass; `style` is empty then.
  pub hit: Option<Frozen<Resolved>>,
  pub pending: Option<Pending>,
  /// The nodes this match watched (`Node.styleWatch`); `watchAll` when there were too many.
  pub watched: List<Watch>,
  pub watchAll: bool,
}

pub fn index(roots: &[RootSheets], root: u32) -> usize {
  let mut i: usize = 0
  while i < roots.length {
    if roots[i].root == root { return i }
    i = i + 1
  }
  return usize.MAX
}

effect fn inlineValues(out: &mut List<Declaration>, source: &[Declaration], tree: &UiTree<'_>, id: u32, state: StyleState) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  if let Option<&StyleOverride>.Some { value } = tree.overrideOf(id, state) {
    if value.replace { return () }
  }
  let mut i: usize = 0
  while i < source.length {
    run out.append(run values.cloneDeclaration(&source[i]))
    i = i + 1
  }
}

pub effect fn resolve(sheets: &mut StyleSheets, cache: &mut Cache, system: [Color; 19], hasStarting: bool, tree: &UiTree<'_>, slot: u32, stops: &mut EasingStops) -> Resolution
  ! ResolverError | RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
  let enters = !style_change.rendered(tree, slot) && (hasStarting || tree.node(slot).starting().length != 0)
  let mut resolved = run resolveWith(&mut sheets, &mut cache, system, tree, slot, false, PseudoTarget.None, StateBits.empty(), !enters)
  if resolved.hit.isSome() { return move resolved }
  if enters {
    let before = run resolveWith(&mut sheets, &mut cache, system, tree, slot, true, PseudoTarget.None, StateBits.empty(), false)
    run resolved.watched.appendSlice(before.watched.asSlice())
    resolved.watchAll = resolved.watchAll || before.watchAll
    let style = &mut resolved.style
    style.starting = Option<List<Declaration>>.some(move before.style.declarations)
    resolved.containers = move before.containers
  }
  let frames = run keyframes(&sheets.*, &mut cache, system, tree, tree.node(slot).parent, &resolved.style, &mut stops)
  // Inherited animation names come from the parent's values, which the shared record does not key.
  if inheritsAnimation(resolved.style.declarations.asSlice()) { resolved.pending = Option<Pending>.None }
  // Keyframes and a starting style are resolved in the node's scope too.
  if enters || frames.length() != 0 {
    let fed = &mut resolved.style
    fed.variables = u64.MAX
  }
  let style = &mut resolved.style
  style.keyframes = move frames
  return move resolved
}

fn inheritsAnimation(declarations: &[Declaration]) -> bool {
  let mut i: usize = 0
  while i < declarations.length {
    if declarations[i].property == Property.AnimationName && convert.isKeyword(&declarations[i].value, Keyword.Inherit) { return true }
    i = i + 1
  }
  return false
}

pub effect fn resolvePseudo(sheets: &mut StyleSheets, cache: &mut Cache, system: [Color; 19], hasStarting: bool,
  tree: &UiTree<'_>, origin: u32, target: PseudoTarget, states: StateBits, rendered: bool, stops: &mut EasingStops) -> Resolution
  ! ResolverError | RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
  if target == PseudoTarget.None { return run resolve(&mut sheets, &mut cache, system, hasStarting, tree, origin, &mut stops) }
  let resolved = run resolvePart(&mut sheets, &mut cache, system, hasStarting, tree, origin, target, states, rendered, &mut stops)
  // The origin keeps no record of what its parts read: it only knows that one read something.
  let reads = match &resolved.hit {
    Option<Frozen<Resolved>>.Some { value } => u64.bitOr(value.get().variables, value.get().declares)
    _ => u64.bitOr(resolved.style.variables, resolved.style.declares)
  }
  if reads != 0 { cache.variableUses = cache.variableUses + 1 }
  return move resolved
}

effect fn resolvePart(sheets: &mut StyleSheets, cache: &mut Cache, system: [Color; 19], hasStarting: bool,
  tree: &UiTree<'_>, origin: u32, target: PseudoTarget, states: StateBits, rendered: bool, stops: &mut EasingStops) -> Resolution
  ! ResolverError | RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
  let mut resolved = run resolveWith(&mut sheets, &mut cache, system, tree, origin, false, target, states, false)
  if target != PseudoTarget.Before && target != PseudoTarget.After { return move resolved }
  if !rendered && hasStarting {
    let before = run resolveWith(&mut sheets, &mut cache, system, tree, origin, true, target, states, false)
    run resolved.watched.appendSlice(before.watched.asSlice())
    resolved.watchAll = resolved.watchAll || before.watchAll
    let style = &mut resolved.style
    style.starting = Option<List<Declaration>>.some(move before.style.declarations)
    resolved.containers = move before.containers
  }
  let frames = run keyframes(&sheets.*, &mut cache, system, tree, origin, &resolved.style, &mut stops)
  if resolved.style.starting.isSome() || frames.length() != 0 {
    let fed = &mut resolved.style
    fed.variables = u64.MAX
  }
  let style = &mut resolved.style
  style.keyframes = move frames
  return move resolved
}

/// Whether `::before` or `::after` of `origin` may get a box: some matched rule declares
/// `content` or `all` there, or what matched depends on a container or a watch. Without
/// one, `content` computes to none, so a pseudo-element with no box yet needs no style.
/// `reads` takes what the match read (`MatchContext.reads`), whatever it answers.
pub effect fn mayGenerate(sheets: &mut StyleSheets, tree: &UiTree<'_>, origin: u32, target: PseudoTarget, reads: &mut u32) -> bool
  ! ResolverError | CssError | OutOfMemoryError ? &mut Allocator {
  let adapter = SelectorTree { tree: tree }
  let mut context = MatchContext.make(u32.toUsize(tree.root), NO_ELEMENT)
  context.pseudo = target
  run sheets.resolveWith(&adapter, u32.toUsize(origin), &[], &mut context, false)
  reads.* = context.reads
  if context.containers.length() != 0 || context.watched().length != 0 || context.watchOverflow { return true }
  let candidates = sheets.candidates()
  let mut i: usize = 0
  while i < candidates.length {
    if let Source.Sheet { sheet, declaration } = candidates[i].source {
      let mentions = match &sheets.sheets()[sheet].sheet.declarations.asSlice()[declaration] {
        SheetDeclaration.Custom { .. } => false
        SheetDeclaration.Typed { property, .. } => property == Property.Content || property == Property.All
        SheetDeclaration.Pending { property, .. } => property == Property.Content || property == Property.All
        SheetDeclaration.ColorExpression { property, .. } => property == Property.Content || property == Property.All
      }
      if mentions { return true }
    }
    i = i + 1
  }
  return false
}

effect fn resolveWith(sheets: &mut StyleSheets, cache: &mut Cache, system: [Color; 19], tree: &UiTree<'_>, slot: u32, starting: bool, target: PseudoTarget, states: StateBits, shareable: bool) -> Resolution
  ! ResolverError | RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
  let node = tree.node(slot)
  let parentSlot = if target == PseudoTarget.None { node.parent } else { slot }
  let mut inline = List<Declaration>.make()
  if target == PseudoTarget.None {
    run inlineValues(&mut inline, node.base.asSlice(), tree, node.id, StyleState.Base)
    if node.hovered { run inlineValues(&mut inline, node.hover(), tree, node.id, StyleState.Hover) }
    if node.pressed { run inlineValues(&mut inline, node.active(), tree, node.id, StyleState.Active) }
    if tree.focused == slot {
      run inlineValues(&mut inline, node.focus(), tree, node.id, StyleState.Focus)
      if tree.focusVisible || node.kind == NodeKind.Input { run inlineValues(&mut inline, node.focusVisible(), tree, node.id, StyleState.FocusVisible) }
    }
    if starting { run inlineValues(&mut inline, node.starting(), tree, node.id, StyleState.Starting) }
  }
  let mut priorities = List<Priority>.make()
  let mut i: usize = 0
  while i < inline.length() {
    let mut priority = Priority.make(Origin.Author, i)
    priority.inline = true
    priority.important = inline.asSlice()[i].important
    run priorities.append(priority)
    i = i + 1
  }
  let adapter = SelectorTree { tree: tree }
  let mut context = MatchContext.make(u32.toUsize(tree.root), NO_ELEMENT)
  context.pseudo = target
  context.pseudoStates = states
  run sheets.resolveWith(&adapter, u32.toUsize(slot), priorities.asSlice(), &mut context, starting)
  let reads = context.reads
  let mut watched = List<Watch>.make()
  run watched.appendSlice(context.watched())
  let watchAll = context.watchOverflow
  let mut parent = Option<ScopeId>.None
  if parentSlot != NONE {
    parent = tree.node(parentSlot).sheetScope()
  }
  let mut custom = List<InlineCustom<'_, '_>>.make()
  if target == PseudoTarget.None {
    if let Option<&NodeIdentity>.Some { value: identity } = node.identity() {
      if identity.custom().length != 0 {
        let states = [StyleState.Base, StyleState.Hover, StyleState.Active, StyleState.Focus, StyleState.FocusVisible, StyleState.Starting]
        let mut stateIndex: usize = 0
        while stateIndex < states.length {
          let state = states[stateIndex]
          if active(tree, slot, state) || (starting && state == StyleState.Starting) {
            let mut at: usize = 0
            while at < identity.custom().length {
              let item = &identity.custom()[at]
              if item.state == state {
                let mut priority = Priority.make(Origin.Author, custom.length())
                priority.important = item.important
                run custom.append(InlineCustom<'_, '_> { name: String.utf8Bytes(String.view(&item.name)), tokens: &item.tokens, priority: priority })
              }
              at = at + 1
            }
          }
          stateIndex = stateIndex + 1
        }
      }
    }
  }
  let scope = run sheets.variableScopeWith(parent, custom.asSlice(), &Limits.make())
  let share = shareable && tree.styleOverrides().length == 0 && context.containers.length() == 0
  let inherited = Inherited { rooted: parentSlot == NONE, color: parentColor(tree, parentSlot) }
  if share {
    if let Option<Frozen<Resolved>>.Some { value } = move cache.find(scope, inherited, sheets.stateDependencies(), reads, sheets.candidates(), sheets.matches(), inline.asSlice()) {
      return Resolution { highlightBackground: Option<ColorProgram>.None, containers: List<ContainerDependency>.make(), hit: Option<Frozen<Resolved>>.some(move value), pending: Option<Pending>.None, watched: move watched, watchAll: watchAll,
        style: Resolved { plain: false, variables: u64.MAX, declares: u64.MAX, customs: List<Candidate>.make(), reads: 0, states: 0, keyframes: List<Rule>.make(), overrides: List<Declaration>.make(), declarations: List<Declaration>.make(),
          matches: List<MatchedRule>.make(), scope: scope, starting: Option<List<Declaration>>.None } }
    }
  }
  let mut declarations = List<Declaration>.make()
  let mut ranks = List<Priority>.make()
  let mut expressions = List<Expression>.make()
  let candidates = sheets.candidates()
  i = 0
  while i < candidates.length {
    match candidates[i].source {
      Source.Inline { declaration } => {
        let item = &inline.asSlice()[declaration]
        if let Value.Text { css } = &item.value {
          let expanded = run substituteText(&sheets.variableInputs()[0], scope, css.asSlice())
          match move expanded {
            Option<Bytes>.Some { value } => run appendText(&mut declarations, &mut expressions, item.property, item.important, value.asSlice())
            _ => run declarations.append(Declaration { property: item.property, important: item.important, value: values.keyword(Keyword.Unset) })
          }
        } else { run declarations.append(run values.cloneDeclaration(item)) }
      }
      Source.Sheet { sheet, declaration } => {
        run appendSheet(&mut declarations, &mut expressions, &sheets.*, &mut cache, scope, sheet, declaration, candidates[i].priority.important)
      }
    }
    while ranks.length() < declarations.length() { run ranks.append(candidates[i].priority) }
    i = i + 1
  }
  let states = [StyleState.Base, StyleState.Hover, StyleState.Active, StyleState.Focus, StyleState.FocusVisible, StyleState.Starting]
  i = 0
  while target == PseudoTarget.None && tree.styleOverrides().length != 0 && i < states.length {
    if active(tree, slot, states[i]) || (starting && states[i] == StyleState.Starting) {
      if let Option<&StyleOverride>.Some { value: item } = tree.overrideOf(node.id, states[i]) {
        let mut at: usize = 0
        while at < item.declarations.length() {
          run declarations.append(run values.cloneDeclaration(&item.declarations.asSlice()[at]))
          run ranks.append(Priority.make(Origin.Transition, declarations.length()))
          at = at + 1
        }
      }
    }
    i = i + 1
  }
  let masks = sheets.variableMasks(custom.asSlice())
  let tracked = tree.styleOverrides().length == 0 && context.containers.length() == 0 && !keepsText(inline.asSlice())
  let mut customs = List<Candidate>.make()
  run sheets.customCandidates(&mut customs)
  let finished = run finish(move declarations, move ranks, move expressions, system, tree, parentSlot, Option<Color>.None, target == PseudoTarget.Selection)
  let mut pending = Option<Pending>.None
  if share {
    let mut inputs = List<Candidate>.make()
    run inputs.appendSlice(sheets.candidates())
    pending = Option<Pending>.some(Pending { scope: scope, parent: inherited, candidates: move inputs, inline: move inline })
  }
  let mut matches = List<MatchedRule>.make()
  run matches.appendSlice(sheets.matches())
  return Resolution { highlightBackground: move finished.highlightBackground, containers: move context.containers, hit: Option<Frozen<Resolved>>.None, pending: move pending, watched: move watched, watchAll: watchAll,
    style: Resolved { plain: share, variables: if tracked { masks.reads } else { u64.MAX }, declares: masks.declares, customs: move customs, reads: reads, states: sheets.stateDependencies(), keyframes: List<Rule>.make(), overrides: move finished.overrides, declarations: move finished.declarations, matches: move matches, scope: scope, starting: Option<List<Declaration>>.None } }
}

/// Whether an inline value is kept as text, to be substituted in the node's scope.
fn keepsText(inline: &[Declaration]) -> bool {
  let mut i: usize = 0
  while i < inline.length {
    if let Value.Text { .. } = &inline[i].value { return true }
    i = i + 1
  }
  return false
}

/// The scope of the node at `slot` under its parent's scope as it is now, for a node that
/// keeps the style of an earlier match: `customs` is that match's custom-property part.
pub effect fn movedScope(sheets: &mut StyleSheets, tree: &UiTree<'_>, slot: u32, customs: &[Candidate]) -> ScopeId
  ! RegistrationError | CssError | OutOfMemoryError ? &mut Allocator {
  let node = tree.node(slot)
  let parent = if node.parent != NONE { tree.node(node.parent).sheetScope() } else { Option<ScopeId>.None }
  let mut custom = List<InlineCustom<'_, '_>>.make()
  if let Option<&NodeIdentity>.Some { value: identity } = node.identity() {
    if identity.custom().length != 0 {
      let states = [StyleState.Base, StyleState.Hover, StyleState.Active, StyleState.Focus, StyleState.FocusVisible]
      let mut stateIndex: usize = 0
      while stateIndex < states.length {
        let state = states[stateIndex]
        if active(tree, slot, state) {
          let mut at: usize = 0
          while at < identity.custom().length {
            let item = &identity.custom()[at]
            if item.state == state {
              let mut priority = Priority.make(Origin.Author, custom.length())
              priority.important = item.important
              run custom.append(InlineCustom<'_, '_> { name: String.utf8Bytes(String.view(&item.name)), tokens: &item.tokens, priority: priority })
            }
            at = at + 1
          }
        }
        stateIndex = stateIndex + 1
      }
    }
  }
  return run sheets.variableScopeOf(parent, customs, custom.asSlice(), &Limits.make())
}

effect fn appendSheet(declarations: &mut List<Declaration>, expressions: &mut List<Expression>, sheets: &StyleSheets, memo: &mut Cache,
  scope: ScopeId, sheet: usize, declaration: usize, important: bool) -> ()
  ! CssError | OutOfMemoryError ? &mut Allocator {
  match &sheets.sheets()[sheet].sheet.declarations.asSlice()[declaration] {
    SheetDeclaration.Typed { property, value, .. } => run declarations.append(Declaration { property: property, important: important, value: run values.clone(&value) })
    SheetDeclaration.Pending { property, .. } => {
      // Substitution serializes and parses the value again; scopes that give its variables the
      // same values share one result.
      let mut reads = List<u64>.make()
      run sheets.variableInputs()[0].substitutionReads(scope, sheet, declaration, &mut reads)
      if let Option<&Substituted>.Some { value: kept } = memo.substitution(sheet, declaration, reads.asSlice()) {
        if let Option<ColorProgram>.Some { value: program } = &kept.program {
          run expressions.append(Expression { index: declarations.length(), program: run program.copy() })
        }
        run declarations.append(Declaration { property: kept.value.property, important: important, value: run values.clone(&kept.value.value) })
        return ()
      }
      let before = expressions.length()
      let substituted = run sheets.variableInputs()[0].substitute(scope, sheet, declaration, &Limits.make())
      match move substituted {
        Option<Bytes>.Some { value } => run appendText(&mut declarations.*, &mut expressions.*, property, important, value.asSlice())
        Option<Bytes>.None => {
          run declarations.append(Declaration { property: property, important: important, value: values.keyword(Keyword.Unset) })
        }
      }
      let program = if expressions.length() > before { Option<ColorProgram>.some(run expressions.asSlice()[before].program.copy()) } else { Option<ColorProgram>.None }
      let made = run values.cloneDeclaration(&declarations.asSlice()[declarations.length() - 1])
      run memo.keepSubstitution(sheet, declaration, move reads, move made, move program)
    }
    SheetDeclaration.ColorExpression { property, program, .. } => {
      run expressions.append(Expression { index: declarations.length(), program: run program.copy() })
      run declarations.append(Declaration { property: property, important: important, value: values.color(Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }) })
    }
    SheetDeclaration.Custom { .. } => {}
  }
}

effect fn keyframes(sheets: &StyleSheets, memo: &mut Cache, system: [Color; 19], tree: &UiTree<'_>, parent: u32, resolved: &Resolved, stops: &mut EasingStops) -> List<Rule>
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let declarations = resolved.declarations.asSlice()
  let mut hasAnimation = false
  let mut i: usize = 0
  while i < declarations.length {
    if declarations[i].property == Property.AnimationName {
      hasAnimation = true
      break
    }
    i = i + 1
  }
  if !hasAnimation { return List<Rule>.make() }
  let mut names = AnimationLists.initial()
  let mut foreground = parentComputed(tree, parent).text.color
  i = 0
  while i < declarations.length {
    let declaration = &declarations[i]
    if declaration.property == Property.AnimationName {
      if convert.isKeyword(&declaration.value, Keyword.Inherit) { names = parentComputed(tree, parent).animation }
      else {
        let text = run values.cssText(&declaration.value)
        run timing.declareAnimation(&mut names, timing.ANIMATION_NAME, text.asSlice(), &mut stops)
      }
    } else if declaration.property == Property.Color {
      if let Option.Some { value } = convert.color(&declaration.value) { foreground = value }
    }
    i = i + 1
  }
  let color = Color.srgb(f32.toF64(foreground.r), f32.toF64(foreground.g), f32.toF64(foreground.b), f32.toF64(foreground.a))
  let mut out = List<Rule>.make()
  i = 0
  while i < names.names.count {
    let hash = stops.animationItem(names.names, i).name
    let mut found = false
    let mut previous: usize = 0
    while previous < out.length() {
      if out.asSlice()[previous].hash == hash { found = true }
      previous = previous + 1
    }
    let mut sheet: usize = 0
    while hash != 0 && !found && sheet < sheets.sheets().length {
      let definitions = sheets.sheets()[sheet].sheet.keyframes.asSlice()
      let mut rule: usize = 0
      while !found && rule < definitions.length {
        if timing.nameHash(definitions[rule].name.asSlice()) == hash {
          if let Option<KeyframesRef>.Some { value } = sheets.keyframes(definitions[rule].name.asSlice()) {
            let name = match String.fromUtf8(definitions[rule].name.asSlice()) {
              Result<string, InvalidUtf8>.Success { value: text } => run String.copy(text)
              _ => String.make()
            }
            let frames = run keyframeValues(sheets, &mut memo, system, tree, parent, resolved.scope, value, color)
            run out.append(run animation.make(move name, move frames, &mut stops))
          }
          found = true
        }
        rule = rule + 1
      }
      sheet = sheet + 1
    }
    i = i + 1
  }
  return move out
}

effect fn keyframeValues(sheets: &StyleSheets, memo: &mut Cache, system: [Color; 19], tree: &UiTree<'_>, parent: u32,
  scope: ScopeId, reference: KeyframesRef, color: Color) -> List<Keyframe>
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let sheet = &sheets.sheets()[reference.sheet].sheet
  let frames = sheet.keyframes.asSlice()[reference.rule].frames.asSlice()
  let mut out = List<Keyframe>.make()
  let mut i: usize = 0
  while i < frames.length {
    let frame = frames[i]
    let mut declarations = List<Declaration>.make()
    let mut expressions = List<Expression>.make()
    let mut ranks = List<Priority>.make()
    let mut declaration = frame.declarations.start
    while declaration < frame.declarations.end {
      run appendSheet(&mut declarations, &mut expressions, sheets, &mut memo, scope, reference.sheet, declaration, false)
      while ranks.length() < declarations.length() {
        let priority = Priority.make(Origin.Animation, ranks.length())
        run ranks.append(priority)
      }
      declaration = declaration + 1
    }
    let resolved = run finish(move declarations, move ranks, move expressions, system, tree, parent, Option<Color>.some(color), false)
    run out.append(Keyframe { offset: f64.toF32(frame.offset), declarations: move resolved.declarations })
    i = i + 1
  }
  return move out
}

struct Finished { highlightBackground: Option<ColorProgram>, declarations: List<Declaration>, overrides: List<Declaration> }

effect fn finish(mut declarations: List<Declaration>, ranks: List<Priority>, mut expressions: List<Expression>,
  system: [Color; 19], tree: &UiTree<'_>, parent: u32, baseColor: Option<Color>, highlight: bool) -> Finished
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  let selected = run sheet_cascade.winners(declarations.asSlice(), ranks.asSlice())
  let mut winning = List<Declaration>.make()
  let mut winningExpressions = List<Expression>.make()
  let mut targets = List<Property>.make()
  let mut projected = List<Option<Value>>.make()
  i = 0
  while i < declarations.length() {
    let declaration = &declarations.asSlice()[i]
    // These native compound values retain information beyond their component
    // fields. Keep their representation when every component has this winner.
    let mut whole = declaration.property == Property.WhiteSpace || declaration.property == Property.VerticalAlign || declaration.property == Property.TextAlign
      || declaration.property == Property.BorderImage || declaration.property == Property.MaskBorder
    if sheet_cascade.wide(&declaration.value).isSome() { whole = false }
    let count = catalog.longhandCount(declaration.property)
    let mut check: usize = 0
    while whole && check < count {
      if selected[catalog.index(catalog.longhandAt(declaration.property, check))] != i { whole = false }
      check = check + 1
    }
    if whole {
      run winning.append(run values.cloneDeclaration(declaration))
      i = i + 1
      continue
    }
    targets.truncate(0)
    projected.truncate(0)
    if count == 1 && catalog.longhandAt(declaration.property, 0) == declaration.property {
      if selected[catalog.index(declaration.property)] == i {
        run targets.append(declaration.property)
        run projected.append(Option<Value>.some(run values.clone(&declaration.value)))
      }
    } else {
      let mut at: usize = 0
      while at < count {
        let target = catalog.longhandAt(declaration.property, at)
        if selected[catalog.index(target)] == i { run targets.append(target) }
        at = at + 1
      }
      if targets.length() != 0 {
        run written.longhands(declaration, targets.asSlice(), &mut projected)
      }
    }
    let mut at: usize = 0
    while at < projected.length() {
      let target = targets.asSlice()[at]
      let item = Intrinsic.replace(projected.asMutSlice()[at], Option<Value>.None)
      if let Option<Value>.Some { value } = move item {
        let mut expressionIndex: usize = 0
        while expressionIndex < expressions.length() {
          let expression = &expressions.asSlice()[expressionIndex]
          if expression.index == i && (target == declaration.property || convert.color(&value).isSome()) {
            run winningExpressions.append(Expression { index: winning.length(), program: run expression.program.copy() })
            break
          }
          expressionIndex = expressionIndex + 1
        }
        let mut resolved = move value
        if let Option<Wide>.Some { value: wide } = &sheet_cascade.wide(&resolved) {
          let inherits = wide == Wide.Inherit || (wide == Wide.Unset && (highlight || catalog.inherited(target)))
          if inherits && parent != NONE {
            resolved = values.keyword(Keyword.Inherit)
          } else {
            if target == Property.Color {
              let rgba = colors.toSrgb(system[colors.systemIndex(SystemColor.CanvasText)])
              resolved = values.color(Rgba<f32> { r: f64.toF32(rgba.r), g: f64.toF32(rgba.g), b: f64.toF32(rgba.b), a: f64.toF32(rgba.a) })
            } else if paint_css.handles(target) {
              resolved = run written.value(catalog.initial(target))
            } else {
              resolved = values.keyword(Keyword.Initial)
            }
          }
        }
        run winning.append(Declaration { property: target, important: declaration.important, value: move resolved })
      }
      at = at + 1
    }
    i = i + 1
  }
  // Only the transient selection result retains this program; ordinary per-node
  // Resolved storage stays unchanged. Each descendant evaluates its own highlight color.
  let mut highlightBackground = Option<ColorProgram>.None
  if highlight {
    let mut at: usize = 0
    while at < winningExpressions.length() {
      let expression = &winningExpressions.asSlice()[at]
      if winning.asSlice()[expression.index].property == Property.BackgroundColor {
        highlightBackground = Option<ColorProgram>.some(run expression.program.copy())
      }
      at = at + 1
    }
  }
  declarations = move winning
  expressions = move winningExpressions
  let mut inherited = parentComputed(tree, parent).text.color
  if highlight {
    let ancestor = tree.node(parent).parent
    let initial = colors.toSrgb(system[colors.systemIndex(SystemColor.CanvasText)])
    inherited = Rgba<f32> { r: f64.toF32(initial.r), g: f64.toF32(initial.g), b: f64.toF32(initial.b), a: f64.toF32(initial.a) }
    if ancestor != NONE {
      if let Option.Some { value } = selection.foreground(tree.node(ancestor)) { inherited = value }
    }
  }
  let inheritedColor = Color.srgb(f32.toF64(inherited.r), f32.toF64(inherited.g), f32.toF64(inherited.b), f32.toF64(inherited.a))
  let mut foreground = match baseColor { Option.Some { value } => value Option.None => inheritedColor }
  if highlight {
    let origin = tree.node(parent)
    let mut color = origin.computed().text.color
    if origin.parent != NONE {
      if let Option.Some { value } = selection.color(selection.of(tree.node(origin.parent)).foreground, color) { color = value }
    }
    foreground = Color.srgb(f32.toF64(color.r), f32.toF64(color.g), f32.toF64(color.b), f32.toF64(color.a))
  }
  let items = declarations.asMutSlice()
  i = 0
  while i < items.length {
    if items[i].property == Property.Color {
      if !highlight || !convert.isKeyword(&items[i].value, Keyword.Currentcolor) {
        resolveColor(&mut items[i].value, expressions.asSlice(), i, inheritedColor, system)
      } else {
        let origin = tree.node(parent).computed().text.color
        foreground = Color.srgb(f32.toF64(origin.r), f32.toF64(origin.g), f32.toF64(origin.b), f32.toF64(origin.a))
      }
      if let Option<Rgba<f32>>.Some { value } = convert.color(&items[i].value) {
        foreground = Color.srgb(f32.toF64(value.r), f32.toF64(value.g), f32.toF64(value.b), f32.toF64(value.a))
      }
    }
    i = i + 1
  }
  i = 0
  while i < items.length {
    if items[i].property != Property.Color && (!highlight || !convert.isKeyword(&items[i].value, Keyword.Currentcolor)) { resolveColor(&mut items[i].value, expressions.asSlice(), i, foreground, system) }
    i = i + 1
  }
  let mut finalOverrides = List<Declaration>.make()
  i = 0
  while tree.styleOverrides().length != 0 && i < declarations.length() {
    let declaration = &declarations.asSlice()[i]
    let target = catalog.longhandAt(declaration.property, 0)
    let winner = selected[catalog.index(target)]
    if winner < ranks.length() && ranks.asSlice()[winner].origin == Origin.Transition {
      run finalOverrides.append(run values.cloneDeclaration(declaration))
    }
    i = i + 1
  }
  return Finished { highlightBackground: move highlightBackground, declarations: move declarations, overrides: move finalOverrides }
}

pub fn parentStyle(tree: &UiTree<'_>, slot: u32) -> Computed {
  return parentComputed(tree, tree.node(slot).parent)
}

fn parentColor(tree: &UiTree<'_>, parent: u32) -> Rgba<f32> {
  if parent == NONE { return TextStyle.initial().color }
  return tree.node(parent).computed().text.color
}

fn parentComputed(tree: &UiTree<'_>, parent: u32) -> Computed {
  if parent == NONE { return tree.rootParent() }
  return tree.node(parent).computed().*
}

fn resolveColor(value: &mut Value, expressions: &[Expression], index: usize, current: Color, system: [Color; 19]) -> () {
  if let Value.Keyword { value: keyword } = &value.* {
    if keyword == Keyword.Unset { return () }
    if keyword == Keyword.Currentcolor {
      let rgba = colors.toSrgb(current)
      value.* = values.color(Rgba<f32> { r: f64.toF32(rgba.r), g: f64.toF32(rgba.g), b: f64.toF32(rgba.b), a: f64.toF32(rgba.a) })
      return ()
    }
  }
  let mut i: usize = 0
  while i < expressions.length {
    if expressions[i].index == index {
      let context = Context.make(current, system)
      if let Option<Color>.Some { value: result } = expressions[i].program.evaluate(&context) {
        let rgba = colors.toSrgb(result)
        value.* = values.color(Rgba<f32> { r: f64.toF32(rgba.r), g: f64.toF32(rgba.g), b: f64.toF32(rgba.b), a: f64.toF32(rgba.a) })
      }
      return ()
    }
    i = i + 1
  }
}



pub effect fn substituteText(inputs: &Inputs, scope: ScopeId, text: &[u8]) -> Option<Bytes>
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(text, &limits)
  let range = buffer.all()
  let mut buffers = run inputs.buffers.reading()
  let index = buffers.length()
  run buffers.append(move buffer)
  let expanded = run inputs.variables.substitute(buffers.view(), scope, index, range, &limits)
  if let Option<List<TokenRef>>.Some { value } = move expanded {
    return Option<Bytes>.some(run cssom_serialization.componentsInput(&Input.Expanded { buffers: buffers.view(), references: value.asSlice() }))
  }
  return Option<Bytes>.None
}

effect fn appendText(declarations: &mut List<Declaration>, expressions: &mut List<Expression>, property: Property, important: bool, text: &[u8]) -> ()
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let value = run written.propertyValue(property, text)
  if property == Property.ContainerName || property == Property.Container {
    run declarations.append(Declaration { property: property, important: important, value: move value })
    return
  }
  if let Value.Text { css } = &value {
    let buffer = run lexer.tokenize(css.asSlice(), &Limits.make())
    let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
    let mut cursor = Cursor.make(&input)
    let parsed = run colors.parseProgram(&input, &mut cursor)
    if cursor.done(&input) {
      if let Option<ColorProgram>.Some { value: program } = move parsed {
        run expressions.append(Expression { index: declarations.length(), program: move program })
      }
    }
  }
  run declarations.append(Declaration { property: property, value: move value, important: important })
}

pub fn active(tree: &UiTree<'_>, slot: u32, state: StyleState) -> bool {
  let node = tree.node(slot)
  return state == StyleState.Base || (state == StyleState.Hover && node.hovered)
    || (state == StyleState.Active && node.pressed) || (state == StyleState.Focus && tree.focused == slot)
    || (state == StyleState.FocusVisible && tree.focused == slot && (tree.focusVisible || node.kind == NodeKind.Input))
}

pub fn needsScope(declarations: &[Declaration]) -> bool {
  let mut i: usize = 0
  while i < declarations.length {
    match &declarations[i].value {
      Value.Unit { .. } | Value.Color { .. } => {}
      _ => { if sheet_cascade.contextual(&declarations[i].value) { return true } }
    }
    i = i + 1
  }
  return false
}

pub effect fn customValue(text: &[u8]) -> Option<TokenBuffer> ! CssError | OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(text, &limits)
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let validation = run declaration_values.validate(&input, &limits)
  if !validation.valid { return Option<TokenBuffer>.None }
  return Option<TokenBuffer>.some(move buffer)
}
