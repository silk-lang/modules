//! A Loom app in the page's own elements: what the host silkui generates for the web-dom
//! target runs. The page (`modules/loom/dom/js/silk-ui-dom.js`) calls two functions the host
//! exports, `silk_ui_open` once and `silk_ui_call` for everything after; they forward here.
//!
//! ```silk,ignore
//! import project.app { Model, Message }
//! import silkui_web_dom.app { open, call }
//!
//! static if Intrinsic.targetArchitecture() == "wasm32" {
//!   export "C" fn opened() -> ?*mut u8 as "silk_ui_open" { return open<Model, Message>() }
//!   export "C" fn called(token: ?*mut u8, op: u32, a: f64, b: f64, c: f64) -> f64 as "silk_ui_call" {
//!     return call<Model, Message>(token, op, a, b, c)
//!   }
//! }
//! ```
import loom.app { NoCommand }
import loom.program { Program }
import loom_dom.page
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator }

/// Makes the app's first model. Answers the token the page passes to [`call`].
pub fn open<P: Program<M, NoCommand>, M>() -> ?*mut u8 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(page.open<P, M, NoCommand>(), page.unopened)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

/// One call from the page: an event, a timer, a frame, a resize or a new location.
pub fn call<P: Program<M, NoCommand>, M>(token: ?*mut u8, op: u32, a: f64, b: f64, c: f64) -> f64 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(page.call<P, M, NoCommand>(token, op, a, b, c), page.failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
