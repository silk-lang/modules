//! The crypto bridge of ../openssl (ext/crypto_native) with its OpenSSL calls replaced by Silk's
//! (ext/crypto_algorithms over silk.crypto): the same operations by name, arguments, handles,
//! worker jobs and results, so the JavaScript above it is the same. Worker callbacks only touch
//! C-owned payloads; JavaScript conversion and callback delivery stay on the loop.
import silkjsruntime.ext.blocking_pool as pool
import silkjsruntime.ext.fs_async as fs_async
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value,  lendFor }
import silkjs.js_realm { lendRealm }
