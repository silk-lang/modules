g is a br, append that br to node list.\x22\x0a    if (isInlineNode(nodeList[nodeList.length - 1])\x0a    && !isHtmlElement(nodeList[nodeList.length - 1], \x22br\x22)\x0a    && isHtmlElement(nodeList[nodeList.length - 1].nextSibling, \x22br\x22)) {\x0a        nodeList.push(nodeList[nodeList.length - 1].nextSibling);\x0a    }\x0a\x0a    // \x22While node list's first member's previousSibling is invisible, prepend\x0a    // it to node list.\x22\x0a    while (isInvisible(nodeList[0].previousSibling)) {\x0a        nodeList.unshift(nodeList[0].previousSibling);\x0a    }\x0a\x0a    // \x22While node list's last member's nextSibling is invisible, append it to\x0a    // node list.\x22\x0a    while (isInvisible(nodeList[nodeList.length - 1].nextSibling)) {\x0a        nodeList.push(nodeList[nodeList.length - 1].nextSibling);\x0a    }\x0a\x0a    // \x22If the previousSibling of the first member of node list is editable and\x0a    // running sibling criteria on it returns true, let new parent be the\x0a    // previousSibling of the first member of node list.\x22\x0a    var newParent;\x0a    if (isEditable(nodeList[0].previousSibling)\x0a    && siblingCriteria(nodeList[0].previousSibling)) {\x0a        newParent = nodeList[0].previousSibling;\x0a\x0a    // \x22Otherwise, if the nextSibling of the last member of node list is\x0a    // editable and running sibling criteria on it returns true, let new parent\x0a    // be the nextSibling of the last member of node list.\x22\x0a    } else if (isEditable(nodeList[nodeList.length - 1].nextSibling)\x0a    && siblingCriteria(nodeList[nodeList.length - 1].nextSibling)) {\x0a        newParent = nodeList[nodeList.length - 1].nextSibling;\x0a\x0a    // \x22Otherwise, run new parent instructions, and let new parent be the\x0a    // result.\x22\x0a    } else {\x0a        newParent = newParentInstructions();\x0a    }\x0a\x0a    // \x22If new parent is null, abort these steps and return null.\x22\x0a    if (!newParent) {\x0a        return null;\x0a    }\x0a\x0a    // \x22If new parent's parent is null:\x22\x0a    if (!newParent.parentNode) {\x0a        // \x22Insert new parent into the parent of the first member of node list\x0a        // immediately before the first member of node list.\x22\x0a        nodeList[0].parentNode.insertBefore(newParent, nodeList[0]);\x0a\x0a        // \x22If any range has a boundary point with node equal to the parent of\x0a        // new parent and offset equal to the index of new parent, add one to\x0a        // that boundary point's offset.\x22\x0a        //\x0a        // Only try to fix the global range.\x0a        if (globalRange.startContainer == newParent.parentNode\x0a        && globalRange.startOffset == getNodeIndex(newParent)) {\x0a            globalRange.setStart(globalRange.startContainer, globalRange.startOffset + 1);\x0a        }\x0a        if (globalRange.endContainer == newParent.parentNode\x0a        && globalRange.endOffset == getNodeIndex(newParent)) {\x0a            globalRange.setEnd(globalRange.endContainer, globalRange.endOffset + 1);\x0a        }\x0a    }\x0a\x0a    // \x22Let original parent be the parent of the first member of node list.\x22\x0a    var originalParent = nodeList[0].parentNode;\x0a\x0a    // \x22If new parent is before the first member of node list in tree order:\x22\x0a    if (isBefore(newParent, nodeList[0])) {\x0a        // \x22If new parent is not an inline node, but the last visible child of\x0a        // new parent and the first visible member of node list are both inline\x0a        // nodes, and the last child of new parent is not a br, call\x0a        // createElement(\x22br\x22) on the ownerDocument of new parent and append\x0a        // the result as the last child of new parent.\x22\x0a        if (!isInlineNode(newParent)\x0a        && isInlineNode([].filter.call(newParent.childNodes, isVisible).slice(-1)[0])\x0a        && isInlineNode(nodeList.filter(isVisible)[0])\x0a        && !isHtmlElement(newParent.lastChild, \x22BR\x22