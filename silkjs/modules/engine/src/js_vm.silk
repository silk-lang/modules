        machine.stackTop = m.stackTop
        current = unsafe finishInline(&mut hooks, &machine, value, !observe) unsafe reloadFrom(current, &mut m)
      }
      41 => { // OP_return_undef
        if Pointer.isNull<u8>(machine.record) { unsafe sync(&m, &mut machine) return ValueBits.Undefined }
        machine.stackTop = m.stackTop
        current = unsafe finishInline(&mut hooks, &machine, ValueBits.Undefined, !observe) unsafe reloadFrom(current, &mut m)
      }
      47 => { unsafe sync(&m, &mut machine) return ValueBits.Undefined } // OP_return_async
      137 => { unsafe sync(&m, &mut machine) return ValueBits.Int { value: AWAIT } } // OP_await
      134 => { unsafe sync(&m, &mut machine) return ValueBits.Int { value: YIELD } } // OP_yield
      135 => { unsafe sync(&m, &mut machine) return ValueBits.Int { value: YIELD_STAR } } // OP_yield_star
      136 => { unsafe sync(&m, &mut machine) return ValueBits.Int { value: YIELD_STAR } } // OP_async_yield_star
      133 => { unsafe sync(&m, &mut machine) return ValueBits.Int { value: INITIAL_YIELD } } // OP_initial_yield
      79 => { unsafe sync(&m, &mut machine) run unsafe spread.execute(&mut hooks, memory, &mut machine) unsafe sync(&machine, &mut m) } // OP_append
      // Opcodes no bytecode emits, spelled out so the match covers every u8 value:
      // the dispatch jump table then needs no range check.
      0 => { unsafe sync(&m, &mut machine) if unsafe iteration.quick(&mut hooks, &mut machine) { unsafe sync(&machine, &mut m) } else if run unsafe iteration.step(&mut hooks, memory, &mut machine) { unsafe sync(&machine, &mut m) } else { match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } }
      // Free in final code (their opcodes moved behind OP_extended): invalid, as 0 is.
      177 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } // OP_freed_177
      180 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } // OP_freed_180
      181 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } // OP_freed_181
      // Every u8 value has an arm, so the jump table alone dispatches: a reachable
      // default would leave a dead range test in front of every opcode.
      39 => { unsafe sync(&m, &mut machine) match Pointer.nonNullMut<Machine>(unsafe applyInline(&mut hooks, &mut machine)) { Option<*mut Machine>.Some { value } => { current = value unsafe reloadFrom(current, &mut m) } Option<*mut Machine>.None => { match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } } } } // OP_apply
      42 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } }
      43 => { unsafe sync(&m, &mut machine) if core.undefined(unsafe activation.newTargetOf(&machine)) { drop run unsafe instruction(&mut hooks, memory, &mut machine, opcode) } unsafe sync(&machine, &mut m) } // OP_check_ctor: throws without new
      44 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } }
      50 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } }
      51 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } }
      54 => { unsafe sync(&m, &mut machine) match move run unsafe instruction(&mut hooks, memory, &mut machine, opcode) { Step.Continue => { unsafe sync(&machine, &mut m) } Step.Done { value } => { if Pointer.isNull<u8>(machine.record) { return value } current = unsafe returnInline(&mut hooks, &machine, value) unsafe reloadFrom(current, &mut m) } } }
      235 => { // OP_put_loc_field_loc8
        // put_field of a local's value into a local's object, both read in place.
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(properties.FIELD_OPERAND_BYTES)))
        let source = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(properties.FIELD_OPERAND_BYTES + 1)))
        if run unsafe properties.storeCellsField(&mut hooks, m.runtime, m.ip, cell, source) { unsafe m.skip(properties.FIELD_OPERAND_BYTES + 2) }
        else { unsafe sync(&m, &mut machine) run unsafe properties.cellsPutStep(&mut hooks, memory, &mut machine, cell, source) unsafe sync(&machine, &mut m) }
      }
      236 => { // OP_put_loc_field_arg8
        unsafe refresh(&machine, &mut m)
        let cell = unsafe m.localCell(u8.toUsize(unsafe m.peekU8(properties.FIELD_OPERAND_BYTES)))
        let source = unsafe m.argumentCell(u8.toUsize(unsafe m.peekU8(properties.FIELD_OPERAND_BYTES + 1)))
        if run unsafe properties.storeCellsField(&mut hooks, m.runtime, m.ip, cell, source) { unsafe m.skip(properties.FIELD_OPERAND_BYTES + 2) }
        else { unsafe sync(&m, &mut machine) run unsafe properties.cellsPutStep(&mut hooks, memory, &mut machine, cell, source) unsafe sync(&machine, &mut m) }
      }
    }
  }
}
/// The cell count cells below cell.
@inlineAlways
unsafe fn operandCell(cell: *mut ValueBits, count: usize) -> *mut ValueBits {
  return unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(cell), usize.wrappingSubtract(0, count))
}
/// releaseOperands from the operand cell first up to the stack top.
@inlineAlways
unsafe fn releaseOperandsFrom<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, first: *mut ValueBits) -> () {
  let runtime = machine.runtime
  let end = Pointer.address<ValueBits>(machine.stackTop)
  let mut cell = first
  while Pointer.address<ValueBits>(cell) != end {
    unsafe gc.release(&mut hooks, runtime, unsafe Pointer.read<ValueBits>(cell))
    cell = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(cell), 1)
  }
  machine.stackTop = first
}
/// releaseOperandsFrom after a planned construct: the function and new.target
/// operands are the same object, so it loses both references at once.
@inlineAlways
unsafe fn releasePlannedOperands<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, function: ValueBits,
  arguments: *mut ValueBits, first: *mut ValueBits) -> () {
  let node = core.reference(function)
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  if header.referenceCount > 2 {
    header.referenceCount = header.referenceCount - 2
    drop header
    unsafe releaseOperandsFrom(&mut hooks, &mut machine, arguments)
    machine.stackTop = first
    return ()
  }
  drop header
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first)
}
/// releasePlannedOperands once the arguments were moved out: only the function and
/// new.target (the same value) remain above first.
@inlineAlways
unsafe fn releasePlannedFunction<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, function: ValueBits, first: *mut ValueBits) -> () {
  machine.stackTop = first
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, core.reference(function))
  if header.referenceCount > 2 { header.referenceCount = header.referenceCount - 2 return () }
  drop header
  unsafe gc.release(&mut hooks, machine.runtime, function)
  unsafe gc.release(&mut hooks, machine.runtime, function)
}
unsafe fn releaseOperands<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, first: usize) -> () {
  // Bounds and base are read once: a release can free cells but never moves the
  // operand stack, and rereading machine after each opaque release cost ~40 Ir a call.
  let runtime = machine.runtime
  let count = machine.sp() - first
  let base = unsafe machine.slot(first)
  let operands = unsafe Pointer.assumeManyMut<ValueBits>(base)
  let mut index: usize = 0
  while index < count { unsafe gc.release(&mut hooks, runtime, unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(operands, index))) index = index + 1 }
  machine.stackTop = base
}
unsafe fn isEval(machine: &Machine, function: ValueBits) -> bool {
  let anchor = () let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  return unsafe core.sameValue(function, context.evalObject.view())
}
unsafe effect fn evaluate<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &Machine, function: ValueBits, argv: &FrameSlots, scope: i32, flags: u32) -> ValueBits
  ! JsException ? &mut Allocator {
  if unsafe isEval(machine, function) {
    let mut input = ValueBits.Undefined if argv.length() != 0 { input = unsafe argv.get(0) }
    return run hooks.evaluateObject(unsafe lendRealm(&machine.context, machine.context), immediateRef(ValueBits.Undefined), unsafe lendBits(&input, input), 2, scope)
  }
  return run unsafe callInternal(&mut hooks, memory, machine.context, function, ValueBits.Undefined, ValueBits.Undefined, argv, flags)
}
/// callInternal for callOperation, kept out of line: callOperation runs inline in
/// execute, and inlining the frame setup too would raise register pressure across
/// the whole dispatch loop.
@inlineNever
unsafe effect fn callFromBytecode<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  // Native callees skip callInternal's activation setup (a large frame even
  // when unused); only its interrupt poll applies to them.
  if function.isObject() && unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION {
    if interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
    if unsafe classId(function) == classes.JS_CLASS_BOUND_FUNCTION && Bound.of(unsafe lendBits(&function, function)).count() == 0 {
      return run unsafe callBound(&mut hooks, memory, context, function, argv)
    }
    return run unsafe callClass(&mut hooks, memory, context, function, receiver, argv, 0)
  }
  return run unsafe callBytecode(&mut hooks, memory, context, function, receiver, argv)
}
/// callFromBytecode for a call made by compiled code (js_compiled_calls): argv's cells are
/// borrowed, so a bytecode callee copies them. A known local function's value (its
/// FunctionBytecode) is not callable from here: the caller checks for it first.
pub unsafe effect fn callForCompiled<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  if function.isObject() && unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION {
    return run unsafe callFromBytecode(&mut hooks, memory, context, function, receiver, argv)
  }
  return run unsafe callInternal(&mut hooks, memory, context, function, receiver, ValueBits.Undefined, argv, activation.COPY_ARGUMENTS)
}
/// callFromBytecode for a bound function with no bound arguments, called (not
/// constructed): its target runs directly with the bound this. A target of
/// Function.prototype.call, as primordials' uncurryThis (bind.bind(call)(fn))
/// makes, runs the bound this with the first argument as receiver and the rest
/// as arguments, skipping both native layers. The bound function's operand
/// slot keeps its target and bound this alive for the call.
@inlineNever
unsafe effect fn callBound<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  let record = Bound.of(unsafe lendBits(&function, function))
  let target = record.target().view()
  let boundThis = record.boundThis().view()
  if unsafe invoke.isCall(target) && unsafe callsPlainly(boundThis) {
    if argv.length() == 0 { return run unsafe callFromBytecode(&mut hooks, memory, context, boundThis, ValueBits.Undefined, argv) }
    let rest = argv.after(1)
    return run unsafe callFromBytecode(&mut hooks, memory, context, boundThis, unsafe argv.get(0), &rest)
  }
  return run unsafe callFromBytecode(&mut hooks, memory, context, target, boundThis, argv)
}
/// Whether value is a function callFromBytecode calls without a class callback
/// that could see the call came through Function.prototype.call.
unsafe fn callsPlainly(value: ValueBits) -> bool {
  if !value.isObject() { return false }
  let class = unsafe classId(value)
  return class == classes.JS_CLASS_BYTECODE_FUNCTION || class == classes.JS_CLASS_C_FUNCTION || class == classes.JS_CLASS_C_FUNCTION_DATA || class == classes.JS_CLASS_BOUND_FUNCTION
}
@inlineNever
unsafe effect fn callBytecode<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits, argv: &FrameSlots) -> ValueBits
  ! JsException ? &mut Allocator {
  return run unsafe callInternal(&mut hooks, memory, context, function, receiver, ValueBits.Undefined, argv, 0)
}
/// Whether the call opcode at machine calls a plain bytecode function, the
/// callee callInline takes. Reads without consuming the operand count.
@inlineAlways
unsafe fn callsBytecode(machine: &Machine, opcode: u8) -> bool {
  return unsafe calleeIsBytecode(machine, unsafe callCount(machine, opcode))
}
/// callsBytecode once the operand count is known, so a caller that decoded it
/// can hand the same count on to enterMethodCall.
@inlineAlways
unsafe fn calleeIsBytecode(machine: &Machine, count: usize) -> bool {
  let function = unsafe machine.top(count + 1)
  // A known local function's value is its FunctionBytecode (js_compiler_known).
  if !function.isObject() { return function.tag() == -2 }
  return unsafe classId(function) == classes.JS_CLASS_BYTECODE_FUNCTION
}
@inlineAlways
unsafe fn callCount(machine: &Machine, opcode: u8) -> usize {
  if opcode >= op.OP_call0 && opcode <= op.OP_call3 { return u8.toUsize(opcode - op.OP_call0) }
  let low = u8.toU16(unsafe Pointer.read<u8>(machine.ip))
  let high = u8.toU16(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(machine.ip), 1)))
  return u16.toUsize(low | u16.shiftLeft(high, 8))
}
/// OP_call_method for receiver.push(value) on a fast Array with spare capacity
/// (arraySupport.pushOne), String.fromCharCode(code) of a cached unit string
/// (nativeFunctions.unitStringOf) and string.charCodeAt(index) on a flat string
/// (nativeFunctions.charCodeOf): answered in the dispatch loop, with no native
/// call. False leaves machine untouched.
/// pushInline answered the call.
const PUSH_ANSWERED: u8 = 1
/// pushInline left the call untouched, and it is arr.pop() or a Map, Set,
/// WeakMap or WeakSet method with one or two arguments: collectionInline's.
const PUSH_COLLECTION: u8 = 2
const PUSH_NUMBER: u8 = 3
/// pushInline's answer for Date.now(): clockInline reads the host clock.
const PUSH_CLOCK: u8 = 4
/// pushInline's answer for a CALL_KIND_LEAN native: leanInline calls it.
const PUSH_LEAN: u8 = 5
/// The classification is a leaf that saves no registers: each answer is a tail
/// call to its own worker, so calls it declines (Math.sqrt, f.call) cost a few
/// loads and compares, not a frame.
@inlineNever
unsafe fn pushInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let count = unsafe callCount(&machine, op.OP_call_method)
  if count > 2 { return 0 }
  let receiver = unsafe machine.top(count + 2)
  if !receiver.isObject() {
    // A string receiver: only charCodeAt is answered here.
    if count == 1 && unsafe nativeFunctions.isCharCodeAt(unsafe machine.top(2)) { return unsafe charCodeAnswer(&mut hooks, &mut machine) }
    // A number receiver of an intrinsic Number method (toFixed, toString and
    // the like): numberInline formats it without quickInline's layers.
    if count <= 1 && receiver.isNumber() && unsafe nativeFunctions.isNumberMethod(unsafe machine.top(count + 1)) { return PUSH_NUMBER }
    // A string method with a primitive entry (CALL_KIND_STRING): leanInline's stringInline.
    if receiver.isString() && unsafe nativeFunctions.objectMethod(unsafe machine.top(count + 1)) >= nativeFunctions.OBJECT_METHOD_LEAN { return PUSH_LEAN }
    return 0
  }
  let kind = unsafe nativeFunctions.objectMethod(unsafe machine.top(count + 1))
  if kind >= nativeFunctions.OBJECT_METHOD_LEAN { return PUSH_LEAN }
  if kind == nativeFunctions.OBJECT_METHOD_PUSH { return if count == 1 { unsafe pushAnswer(&mut hooks, &mut machine) } else { 0 } }
  if kind == nativeFunctions.OBJECT_METHOD_POP { return if count == 0 { unsafe popAnswer(&mut hooks, &mut machine) } else { 0 } }
  if kind == nativeFunctions.OBJECT_METHOD_COLLECTION {
    if count == 1 { return unsafe collectionRead(&mut hooks, &mut machine) }
    return if count != 0 { unsafe collectionWrite(&mut hooks, &mut machine, 2) } else { 0 }
  }
  if kind == nativeFunctions.OBJECT_METHOD_MATH { return unsafe mathAnswer(&mut hooks, &mut machine, count) }
  if kind == nativeFunctions.OBJECT_METHOD_CLOCK { return PUSH_CLOCK }
  if count != 1 { return 0 }
  if kind == nativeFunctions.OBJECT_METHOD_FROM_CHAR_CODE { return unsafe fromCharCodeAnswer(&mut hooks, &mut machine) }
  return 0
}
/// receiver.get(key), .has(key) or .delete(key) for pushInline, on the hash
/// state of a Map, Set, WeakMap or WeakSet receiver of the method's own kind:
/// none allocates or throws, so there is no pc to publish, and the answer takes
/// the receiver's slot. add (and set with one argument) goes to
/// collectionWrite; 0 leaves another receiver to the general call.
@inlineNever
unsafe fn collectionRead<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let function = unsafe machine.top(2)
  let call = unsafe nativeFunctions.collectionMethod(function)
  if call.method == collections.SET { return unsafe collectionWrite(&mut hooks, &mut machine, 1) }
  let target = unsafe machine.top(3)
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe mapStorage.state(target, call.kind)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return 0 } }
  let key = unsafe machine.top(1)
  let runtime = machine.runtime
  let mut result = ValueBits.Undefined
  if call.method == collections.GET { result = unsafe mapStorage.get(node, key) }
  else if call.method == collections.HAS { result = ValueBits.Bool { value: unsafe mapStorage.has(node, key) } }
  else if call.method == collections.DELETE { result = ValueBits.Bool { value: unsafe mapStorage.erase(&mut hooks, runtime, node, key) } }
  else { return 0 }
  unsafe machine.skip(2)
  unsafe machine.set(3, result)
  unsafe machine.discard(2)
  unsafe releaseOperand(&mut hooks, runtime, key)
  unsafe gc.releaseObjectHeader(&mut hooks, runtime, core.reference(function))
  // Last: the receiver may be a temporary that this frees.
  unsafe gc.release(&mut hooks, runtime, target)
  return PUSH_ANSWERED
}
/// map.set(key, value) or set.add(value) for pushInline (count is the argument
/// count), on a Map, Set, WeakMap or WeakSet receiver of the method's own kind,
/// when the entry needs no allocation and the key cannot be rejected
/// (mapStorage.putMayFail): nothing can fail, so there is no pc to publish and
/// no realm to find. The receiver is the answer and already sits in its slot.
/// PUSH_COLLECTION leaves every other case to collectionInline.
@inlineNever
unsafe fn collectionWrite<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, count: usize) -> u8 {
  let function = unsafe machine.top(count + 1)
  let call = unsafe nativeFunctions.collectionMethod(function)
  let isSet = (call.kind & 1) != 0
  if call.method != collections.SET || !call.generic || isSet != (count == 1) { return PUSH_COLLECTION }
  let target = unsafe machine.top(count + 2)
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe mapStorage.state(target, call.kind)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return PUSH_COLLECTION } }
  let key = unsafe machine.top(count)
  if (call.kind >= 2 && !key.isObject()) || unsafe mapStorage.putMayFail(node, key.isObject()) { return PUSH_COLLECTION }
  let runtime = machine.runtime
  let mut stored = ValueBits.Undefined
  if !isSet { stored = unsafe machine.top(1) }
  unsafe mapStorage.putWithin(&mut hooks, runtime, node, key, stored)
  unsafe machine.skip(2)
  unsafe machine.discard(count + 1)
  if !isSet { unsafe releaseOperand(&mut hooks, runtime, stored) }
  unsafe releaseOperand(&mut hooks, runtime, key)
  unsafe gc.releaseObjectHeader(&mut hooks, runtime, core.reference(function))
  return PUSH_ANSWERED
}
/// receiver.push(value) for pushInline: arraySupport.pushOne on a fast Array with room.
@inlineNever
unsafe fn pushAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let receiver = unsafe machine.top(3)
  // The array takes the operand's reference to the value, so only the
  // receiver and the function are released.
  let length = unsafe arraySupport.pushTaken(receiver, unsafe machine.top(1))
  if length < 0 { return 0 }
  let function = unsafe machine.top(2)
  if unsafe machine.peekU8(2) == op.OP_drop {
    unsafe machine.skip(3)
    unsafe machine.discard(3)
  } else {
    unsafe machine.skip(2)
    unsafe machine.set(3, ValueBits.Int { value: i64.toI32(length) })
    unsafe machine.discard(2)
  }
  // Array.prototype holds push and a variable usually holds the array: each
  // then loses one reference in line.
  if unsafe keepsHolder(function) { unsafe dropShared(function) } else { unsafe gc.release(&mut hooks, machine.runtime, function) }
  if unsafe keepsHolder(receiver) { unsafe dropShared(receiver) } else { unsafe gc.release(&mut hooks, machine.runtime, receiver) }
  return PUSH_ANSWERED
}
/// receiver.pop() for pushInline: arraySupport.popOne on a fast Array.
@inlineNever
unsafe fn popAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let receiver = unsafe machine.top(2)
  let answer = match unsafe arraySupport.popOne(receiver) { Option<ValueBits>.Some { value } => value Option<ValueBits>.None => { return 0 } }
  let function = unsafe machine.top(1)
  if unsafe machine.peekU8(2) == op.OP_drop {
    unsafe machine.skip(3)
    unsafe machine.discard(2)
    unsafe releaseOperand(&mut hooks, machine.runtime, answer)
  } else {
    unsafe machine.skip(2)
    unsafe machine.set(2, answer)
    unsafe machine.discard(1)
  }
  if unsafe keepsHolder(function) { unsafe dropShared(function) } else { unsafe gc.release(&mut hooks, machine.runtime, function) }
  if unsafe keepsHolder(receiver) { unsafe dropShared(receiver) } else { unsafe gc.release(&mut hooks, machine.runtime, receiver) }
  return PUSH_ANSWERED
}
/// Math.min(a, b), Math.floor(x) and the other Math methods on number
/// arguments, for pushInline: quickMath's answer without quickInline's layers.
@inlineNever
unsafe fn mathAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, count: usize) -> u8 {
  let argv = FrameSlots { data: unsafe operandCell(machine.stackTop, count), count: count }
  let answer = unsafe nativeFunctions.mathCall(unsafe machine.top(count + 1), argv)
  if let ValueBits.Uninitialized = answer { return 0 }
  unsafe machine.skip(2)
  // mathCall succeeded only on Int/Float64 arguments (immediates), so only Math
  // and its method (base[0] and base[1]) can hold heap references.
  let operands = usize.wrappingAdd(count, 2)
  let base = unsafe operandCell(machine.stackTop, operands)
  let many = unsafe Pointer.assumeManyMut<ValueBits>(base)
  let receiver = unsafe Pointer.read<ValueBits>(base)
  let callee = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, 1))
  if unsafe keepsHolder(receiver) && unsafe keepsHolder(callee) {
    unsafe dropShared(receiver)
    unsafe dropShared(callee)
    unsafe Pointer.write<ValueBits>(base, answer)
    machine.stackTop = unsafe Pointer.atMut<ValueBits>(many, 1)
    return PUSH_ANSWERED
  }
  let first = machine.sp() - operands
  unsafe releaseOperands(&mut hooks, &mut machine, first)
  unsafe machine.push(answer)
  return PUSH_ANSWERED
}
/// String.fromCharCode(code) of a cached unit string, for pushInline.
@inlineNever
unsafe fn fromCharCodeAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let answer = unsafe nativeFunctions.unitStringOf(machine.runtime, unsafe machine.top(1))
  if let ValueBits.Uninitialized = answer { return 0 }
  return unsafe answerOne(&mut hooks, &mut machine, answer)
}
/// text[index] with an in-range Int index whose code unit is Latin-1: the
/// runtime's cached unit string (owned), or Uninitialized to decline. A rope is
/// flattened first, as V8 flattens a cons string read by index: walking a long
/// `s += piece` rope costs its depth on every read. text stays borrowed.
@inlineNever
unsafe effect fn stringUnitAnswer(runtime: *mut HeapHeader, text: ValueBits, index: ValueBits) -> ValueBits ? &mut Allocator {
  if text.tag() == -6 && Strings.flatView(text).tag() != -7 {
    match move run Effect.result(Strings.flatten(text)) {
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => { Strings.dropHolder(value) }
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => { drop error return ValueBits.Uninitialized }
    }
  }
  let unit = unsafe nativeFunctions.charCodeOf(text, index)
  if unit < 0 { return ValueBits.Uninitialized }
  return unsafe nativeFunctions.unitStringOf(runtime, ValueBits.Int { value: unit })
}
/// get_array_el of a string operand: stringUnitAnswer's unit string in place of
/// both operands. False leaves them to the generic path.
@inlineAlways
unsafe effect fn stringElementAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool ? &mut Allocator {
  let text = unsafe machine.top(2)
  let answer = run unsafe stringUnitAnswer(machine.runtime, text, unsafe machine.top(1))
  if let ValueBits.Uninitialized = answer { return false }
  // The key is an Int: only the string's operand reference goes.
  unsafe machine.discard(2)
  unsafe gc.release(&mut hooks, machine.runtime, text)
  unsafe machine.push(answer)
  return true
}
/// get_loc_el8 / get_arg_el8 on a string cell: the unit string pushed, past the
/// two slot indexes. The cells are only read, so nothing is released.
@inlineAlways
unsafe effect fn stringCellAnswer(machine: &mut Machine, array: *mut ValueBits, index: *mut ValueBits) -> bool ? &mut Allocator {
  let answer = run unsafe stringUnitAnswer(machine.runtime, unsafe Pointer.read<ValueBits>(array), unsafe Pointer.read<ValueBits>(index))
  if let ValueBits.Uninitialized = answer { return false }
  unsafe machine.push(answer)
  unsafe machine.skip(2)
  return true
}
/// call_method with one argument for text.charCodeAt(index) on a flat string
/// and String.fromCharCode(code) of a cached unit string, the calls made once
/// per character: answered in the arm before any other classification of the
/// callee. False leaves machine untouched.
@inlineAlways
unsafe fn unitInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool {
  let function = unsafe machine.top(2)
  let kind = unsafe nativeFunctions.unitMethod(function)
  if kind == nativeFunctions.UNIT_METHOD_NONE { return false }
  let receiver = unsafe machine.top(3)
  let mut answer = ValueBits.Uninitialized
  if kind == nativeFunctions.UNIT_METHOD_CHAR_CODE_AT {
    match receiver { ValueBits.String { .. } => {} _ => { return false } }
    let unit = unsafe nativeFunctions.charCodeOf(receiver, unsafe machine.top(1))
    if unit < 0 { return false }
    answer = ValueBits.Int { value: unit }
  } else if kind == nativeFunctions.UNIT_METHOD_CHAR_AT {
    match receiver { ValueBits.String { .. } => {} _ => { return false } }
    let unit = unsafe nativeFunctions.charCodeOf(receiver, unsafe machine.top(1))
    if unit < 0 { return false }
    answer = unsafe nativeFunctions.unitStringOf(machine.runtime, ValueBits.Int { value: unit })
    if let ValueBits.Uninitialized = answer { return false }
  } else {
    answer = unsafe nativeFunctions.unitStringOf(machine.runtime, unsafe machine.top(1))
    if let ValueBits.Uninitialized = answer { return false }
  }
  // The argument is an Int; the receiver and the function each give up a reference.
  unsafe machine.skip(2)
  unsafe machine.discard(2)
  unsafe machine.set(1, answer)
  unsafe gc.release(&mut hooks, machine.runtime, function)
  unsafe gc.release(&mut hooks, machine.runtime, receiver)
  return true
}
/// string.charCodeAt(index) on a flat string, for pushInline.
@inlineNever
unsafe fn charCodeAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> u8 {
  let unit = unsafe nativeFunctions.charCodeOf(unsafe machine.top(3), unsafe machine.top(1))
  if unit < 0 { return 0 }
  return unsafe answerOne(&mut hooks, &mut machine, ValueBits.Int { value: unit })
}
/// Replaces a one-argument call_method's receiver, function and argument with answer.
@inlineAlways
unsafe fn answerOne<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, answer: ValueBits) -> u8 {
  unsafe machine.skip(2)
  // Every operand usually keeps another holder (the array or string, the
  // builtin, a small argument): drop one reference each inline. A last
  // reference goes to a tail call, so this path needs no frame.
  let base = unsafe operandCell(machine.stackTop, 3)
  let many = unsafe Pointer.assumeManyMut<ValueBits>(base)
  let first = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, 0))
  let second = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, 1))
  let third = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, 2))
  if !(unsafe keepsHolder(first) && unsafe keepsHolder(second) && unsafe keepsHolder(third)) {
    // Scalars only, so the call stays in tail position (a ValueBits goes by pointer).
    let mut text = Pointer.null<HeapHeader>() let mut integer: i32 = 0
    match answer {
      ValueBits.String { reference } => { text = reference }
      ValueBits.Int { value } => { integer = value }
      _ => invariant()
    }
    return unsafe answerReleasing(&mut hooks, &mut machine, text, integer)
  }
  unsafe dropShared(first) unsafe dropShared(second) unsafe dropShared(third)
  unsafe Pointer.write<ValueBits>(base, answer)
  machine.stackTop = unsafe Pointer.atMut<ValueBits>(many, 1)
  return PUSH_ANSWERED
}
/// Whether releasing value leaves it alive: an immediate, or a cell with another holder.
@inlineAlways
unsafe fn keepsHolder(value: ValueBits) -> bool {
  match ValueBits.heapReference(&value) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let anchor = ()
      let header = unsafe Pointer.borrow<(), HeapHeader>(&anchor, node)
      return header.referenceCount > 1
    }
    Option<*mut HeapHeader>.None => { return true }
  }
}
/// Drops one reference of a value keepsHolder accepted.
@inlineAlways
unsafe fn dropShared(value: ValueBits) -> () {
  match ValueBits.heapReference(&value) {
    Option<*mut HeapHeader>.Some { value: node } => {
      let mut anchor = ()
      let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
      header.referenceCount = i32.wrappingSubtract(header.referenceCount, 1)
    }
    Option<*mut HeapHeader>.None => ()
  }
}
/// answerOne's ending when an operand loses its last reference.
@inlineNever
unsafe fn answerReleasing<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, text: ?*mut HeapHeader, integer: i32) -> u8 {
  let first = machine.sp() - 3
  unsafe releaseOperands(&mut hooks, &mut machine, first)
  match Pointer.nonNullMut<HeapHeader>(text) {
    Option<*mut HeapHeader>.Some { value } => { unsafe machine.push(ValueBits.String { reference: value }) }
    Option<*mut HeapHeader>.None => { unsafe machine.push(ValueBits.Int { value: integer }) }
  }
  return PUSH_ANSWERED
}
/// call_method answers for pushInline's PUSH_NUMBER: an intrinsic Number method
/// (toFixed, toString and the like) on a number receiver, formatted in one frame.
/// false declines, leaving machine for quickInline.
@inlineNever
unsafe effect fn numberInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> bool ? &mut Allocator {
  let count = unsafe callCount(&machine, op.OP_call_method)
  let mut argument = ValueBits.Undefined
  if count != 0 { argument = unsafe machine.top(1) }
  unsafe machine.publishPc()
  let answer = run unsafe nativeFunctions.numberMethodCall(unsafe machine.top(count + 1), unsafe machine.top(count + 2), argument)
  if let ValueBits.Uninitialized = answer { return false }
  unsafe machine.skip(2)
  let base = machine.sp() - count - 2
  unsafe releaseOperands(&mut hooks, &mut machine, base)
  unsafe machine.push(answer)
  return true
}
/// call_method answers for pushInline's PUSH_CLOCK: Date.now() with any
/// arguments is the host clock; nothing is read from the receiver or them.
/// false declines (a host without a frameless clock), leaving machine for
/// quickInline.
@inlineNever
unsafe effect fn clockInline<H: HeapHooks + NativeFunctionHooks>(hooks: &mut H, machine: &mut Machine) -> bool {
  let milliseconds = match run hooks.nativeClockMilliseconds() { Option<i64>.Some { value } => value Option<i64>.None => { return false } }
  let count = unsafe callCount(&machine, op.OP_call_method)
  unsafe machine.skip(2)
  let base = machine.sp() - count - 2
  unsafe releaseOperands(&mut hooks, &mut machine, base)
  unsafe machine.push(ValueBits.number(i64.toF64(milliseconds)))
  return true
}
/// call_method on a function pushInline classified PUSH_COLLECTION: a Map, Set,
/// WeakMap or WeakSet set or add called on the receiver's hash state directly,
/// without a native frame, when collectionWrite left it: the entry may allocate
/// (get, has and delete are collectionRead's). The function is decoded once and
/// the operands are released in place: the answer takes the receiver's slot.
/// false leaves machine for the general call (another receiver or argument
/// count, a primitive weak key).
@inlineNever
unsafe effect fn collectionInline<H: HeapHooks + CoercionHooks>(hooks: &mut H, machine: &mut Machine) -> bool ! JsException ? &mut Allocator {
  let count = unsafe callCount(&machine, op.OP_call_method)
  if count == 0 { return false }
  let function = unsafe machine.top(count + 1)
  let target = unsafe machine.top(count + 2)
  let call = unsafe nativeFunctions.collectionMethod(function)
  if !call.found { return false }
  let node = match Pointer.nonNullMut<HeapHeader>(unsafe mapStorage.state(target, call.kind)) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
  let key = unsafe machine.top(count)
  let runtime = machine.runtime
  if call.method == collections.SET {
    // set(key, value) on a Map or WeakMap, add(value) on a Set or WeakSet.
    let isSet = (call.kind & 1) != 0
    if !call.generic || (isSet && count != 1) || (!isSet && count != 2) { return false }
    // Weak collections take object keys only: any other throws in the full call.
    if call.kind >= 2 && !key.isObject() { return false }
    let home = match Pointer.nonNullMut<HeapHeader>(call.realm) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return false } }
    let mut stored = ValueBits.Undefined
    if !isSet { stored = unsafe machine.top(1) }
    // An entry that allocates may fail, and the error reports the pc.
    if unsafe mapStorage.putMayFail(node, key.isObject()) { unsafe machine.publishPc() }
    run unsafe mapStorage.put(&mut hooks, unsafe lendRealm(&home, home), node, key, stored)
    // The receiver is the answer and already sits in the answer's slot.
    unsafe machine.skip(2)
    unsafe machine.discard(count + 1)
    if !isSet { unsafe releaseOperand(&mut hooks, runtime, stored) }
    unsafe releaseOperand(&mut hooks, runtime, key)
    unsafe gc.releaseObjectHeader(&mut hooks, runtime, core.reference(function))
    return true
  }
  // get, has and delete with one argument are collectionRead's.
  return false
}
/// gc.release of a key or value operand, with the Int case decided here.
@inlineAlways
unsafe fn releaseOperand<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  if let ValueBits.Int { .. } = value { return () }
  unsafe gc.release(&mut hooks, runtime, value)
}
/// A call opcode on a native builtin with a frameless answer (nativeFunctions.quick
/// and quickWrite: Math, String, Map and Set reads and writes, Date.now and the
/// like): answered in the dispatch loop, without the native call layers. The
/// interrupt poll is charged as for a bytecode call; when it is due, or the
/// builtin declines, false leaves machine for callOperation.
/// quickInline for any other native builtin (regexp exec, string methods and
/// the like): the native call itself, without callFromBytecode's and callClass's
/// layers. The poll is charged as theirs would be; false when it is due.
/// Pushes a frameless boolean answer, or fuses a following forward
/// OP_if_false8 / OP_if_true8 when instructions are not being observed.
@inlineAlways
unsafe fn pushOrBranchBool(machine: &mut Machine, flag: bool) -> () {
  let anchor = ()
  if !(unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)).observeInstructions {
    let next = unsafe machine.peekU8(0)
    if next == op.OP_if_false8 || next == op.OP_if_true8 {
      let displacement = unsafe machine.peekI8At(1)
      if displacement > 0 {
        let advance: usize = if flag == (next == op.OP_if_true8) { usize.wrappingAdd(1, i32.toUsize(displacement)) } else { 2 }
        unsafe machine.skip(advance)
        return ()
      }
    }
  }
  unsafe machine.push(ValueBits.Bool { value: flag })
}
@inlineAlways
unsafe fn releaseStackValueFast<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  if value.tag() < 0 {
    if let Option<*mut HeapHeader>.Some { value: cell } = ValueBits.heapReference(&value) {
      let mut anchor = ()
      let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, cell)
      let rc = header.referenceCount
      if rc > 1 {
        header.referenceCount = i32.wrappingSubtract(rc, 1)
        return ()
      }
      drop header
      unsafe gc.releaseLast(&mut hooks, runtime, cell)
    }
  }
}
@inlineAlways
unsafe fn pushOrBranchAnswer(machine: &mut Machine, answer: ValueBits) -> () {
  if let ValueBits.Bool { value: flag } = answer {
    unsafe pushOrBranchBool(&mut machine, flag)
    return ()
  }
  unsafe machine.push(answer)
}
@inlineNever
unsafe effect fn nativeInlineSlow<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, context: *mut HeapHeader, callee: ValueBits, thisArg: ValueBits, argv: FrameSlots, first: *mut ValueBits) -> bool ! JsException ? &mut Allocator {
  unsafe machine.publishPc()
  let result = run unsafe callNativePlain(&mut hooks, memory, context, callee, thisArg, &argv)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first)
  unsafe machine.push(result)
  return true
}
@inlineAlways
unsafe effect fn nativeInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8, count: usize, function: ValueBits) -> bool ! JsException ? &mut Allocator {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let mut receiver = ValueBits.Undefined let mut extra: usize = 1
  if opcode == op.OP_call_method { receiver = unsafe machine.top(count + 2) extra = 2 }
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let context = machine.context
  if opcode == op.OP_call || opcode == op.OP_call_method { unsafe machine.skip(2) }
  unsafe Pointer.write<i32>(counter, i32.wrappingSubtract(left, 1))
  let first = unsafe operandCell(data, extra)
  // native.call(thisArg, ...args), as in hasOwnProperty.call(object, key): the
  // target is called itself, without Function.prototype.call's frame around it.
  if count != 0 && opcode == op.OP_call_method && receiver.isObject() && unsafe classId(receiver) == classes.JS_CLASS_C_FUNCTION
    && unsafe invoke.functionMethod(function) == invoke.CALL_METHOD {
    let arg0 = unsafe Pointer.read<ValueBits>(data)
    let rest = FrameSlots { data: unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(data), 1), count: usize.wrappingSubtract(count, 1) }
    return run unsafe nativeInlineSlow(&mut hooks, memory, &mut machine, context, receiver, arg0, rest, first)
  }
  return run unsafe nativeInlineSlow(&mut hooks, memory, &mut machine, context, function, receiver, argv, first)
}
/// A CALL_KIND_FRAMELESS native called with no native frame (see
/// NativeCallProtocol.Frameless). Its contract rules out failure; one that
/// fails anyway is materialized in its realm as a full call's would be.
@inlineNever
unsafe effect fn framelessCall<H: HeapHooks + CoercionHooks + NativeFunctionHooks>(hooks: &mut H, machine: &mut Machine,
  opcode: u8, count: usize, function: ValueBits) -> bool ! JsException ? &mut Allocator {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let mut receiver = ValueBits.Undefined let mut extra: usize = 1
  if opcode == op.OP_call_method { receiver = unsafe machine.top(count + 2) extra = 2 }
  let data = unsafe operandCell(machine.stackTop, count)
  if opcode == op.OP_call || opcode == op.OP_call_method { unsafe machine.skip(2) }
  unsafe Pointer.write<i32>(counter, left - 1)
  let target = unsafe nativeFunctions.framelessTarget(function)
  let context = machine.context
  let home = match Pointer.nonNullMut<HeapHeader>(target.realm) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => context }
  let argv = FrameSlots { data: data, count: count }
  let called = run Effect.result(hooks.nativeGeneric(target.id, unsafe lendRealm(&home, home), unsafe lendBits(&receiver, receiver), usize.toI32(count), unsafe lendArguments(&argv)))
  let answer = match move called {
    Result<ValueBits, OutOfMemoryError | JsException>.Success { value } => value
    Result<ValueBits, OutOfMemoryError | JsException>.Failure { error } => { unsafe machine.publishPc() run core.materialize(&mut hooks, unsafe lendRealm(&home, home), move error) }
  }
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
  unsafe machine.push(answer)
  return true
}
/// leanInline for OP_call_method, from pushInline's PUSH_LEAN.
@inlineAlways
unsafe effect fn leanMethod<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, count: usize) -> bool ! JsException ? &mut Allocator {
  let function = unsafe machine.top(count + 1)
  let kind = unsafe nativeFunctions.callKind(function)
  return run unsafe leanInline(&mut hooks, memory, &mut machine, op.OP_call_method, count, function, kind)
}
/// The native call for a function whose callKind is not SLOW: a
/// CALL_KIND_ANSWER builtin's frameless answer first (answerInline), else
/// leanCall.
@inlineAlways
unsafe effect fn leanInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8, count: usize, function: ValueBits, kind: u8) -> bool ! JsException ? &mut Allocator {
  if kind == nativeFunctions.CALL_KIND_ANSWER && unsafe answerInline(&mut hooks, &mut machine, opcode, count, function) { return true }
  if kind == nativeFunctions.CALL_KIND_OBJECT_KEYS && count == 1 && run unsafe objectKeysInline(&mut hooks, memory, &mut machine, opcode, function) { return true }
  if kind == nativeFunctions.CALL_KIND_STRING && opcode == op.OP_call_method && run unsafe stringInline(&mut hooks, &mut machine, count, function) { return true }
  if kind == nativeFunctions.CALL_KIND_REGEXP_EXEC && opcode == op.OP_call_method && count != 0 && run unsafe regexpMethodInline(&mut hooks, memory, &mut machine, count, function, false) { return true }
  if kind == nativeFunctions.CALL_KIND_REGEXP_TEST && opcode == op.OP_call_method && count != 0 && run unsafe regexpMethodInline(&mut hooks, memory, &mut machine, count, function, true) { return true }
  if kind == nativeFunctions.CALL_KIND_STRING_REPLACE && opcode == op.OP_call_method && count == 2 && run unsafe stringReplaceInline(&mut hooks, memory, &mut machine, function) { return true }
  if kind == nativeFunctions.CALL_KIND_FRAMELESS { return run unsafe framelessCall(&mut hooks, &mut machine, opcode, count, function) }
  if kind == nativeFunctions.CALL_KIND_ASYNC_CONTEXT && unsafe asyncContextCall(&mut hooks, &mut machine, opcode, count, function) { return true }
  return run unsafe leanCall(&mut hooks, memory, &mut machine, opcode, count, function)
}
/// Inline rc > 1 decrement with @cold releaseLastCold fallback so out-of-line
/// VM helpers avoid spilling registers around teardown calls.
@inlineAlways
unsafe fn releaseHeaderCold<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, node: *mut HeapHeader) -> () {
  let mut anchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut anchor, node)
  let rc = header.referenceCount
  if rc > 1 {
    header.referenceCount = i32.wrappingSubtract(rc, 1)
    return ()
  }
  drop header
  unsafe gc.releaseLastCold(&mut hooks, runtime, node)
}
@inlineAlways
unsafe fn releaseStackValueCold<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  if value.tag() >= 0 { return () }
  if let Option<*mut HeapHeader>.Some { value: cell } = ValueBits.heapReference(&value) {
    unsafe releaseHeaderCold(&mut hooks, runtime, cell)
  }
}
@cold
unsafe effect fn objectKeysSlow<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  machine: &mut Machine, opcode: u8, funcRef: *mut HeapHeader) -> bool ? &mut Allocator {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let fnAnchor = ()
  let fnData = unsafe HeapCell.payload<ObjectData, ()>(&fnAnchor, funcRef)
  let homeOpt = match &fnData.payload {
    ObjectPayload.NativeFunction { function: native } => native.realm()
    _ => Pointer.null<HeapHeader>()
  }
  drop fnData
  let home = match Pointer.nonNullMut<HeapHeader>(homeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let data = unsafe operandCell(machine.stackTop, 1)
  let input = unsafe Pointer.read<ValueBits>(data)
  unsafe machine.publishPc()
  let answer = run unsafe objectIntrinsics.quickKeys(&mut hooks, memory, unsafe lendRealm(&home, home), input)
  if !answer.isObject() { return false }
  let mut extra: usize = 1
  if opcode == op.OP_call_method { extra = 2 }
  if opcode == op.OP_call || opcode == op.OP_call_method { unsafe machine.skip(2) }
  unsafe Pointer.write<i32>(counter, i32.wrappingSubtract(left, 1))
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
  unsafe machine.push(answer)
  return true
}
/// Non-effect 5-register fast path for Object.keys(obj): bypasses leanInlineSlow,
/// Allocator, AllocationObserver, and ValueBits parameter spills. Returns false on
/// spare/cache miss so quickInline falls through to leanInlineSlow -> objectKeysInline.
@inlineNever
unsafe fn objectKeysFast<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8, funcRef: *mut HeapHeader) -> bool {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let fnAnchor = ()
  let fnData = unsafe HeapCell.payload<ObjectData, ()>(&fnAnchor, funcRef)
  let homeOpt = match &fnData.payload {
    ObjectPayload.NativeFunction { function: native } => native.realm()
    _ => Pointer.null<HeapHeader>()
  }
  drop fnData
  let home = match Pointer.nonNullMut<HeapHeader>(homeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let data = unsafe operandCell(machine.stackTop, 1)
  let input = unsafe Pointer.read<ValueBits>(data)
  let inputRef = match input { ValueBits.Object { reference } => reference _ => { return false } }
  let runtime = machine.runtime
  let answer = unsafe objectIntrinsics.quickKeysSpareRef(runtime, home, inputRef)
  if !answer.isObject() { return false }
  let isMethod = opcode == op.OP_call_method
  let first = if isMethod { unsafe operandCell(data, 2) } else { unsafe operandCell(data, 1) }
  if opcode == op.OP_call || isMethod { unsafe machine.skip(2) }
  unsafe Pointer.write<i32>(counter, i32.wrappingSubtract(left, 1))
  let receiver = if isMethod { unsafe Pointer.read<ValueBits>(first) } else { ValueBits.Undefined }
  unsafe Pointer.write<ValueBits>(first, answer)
  machine.stackTop = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(first), 1)
  if isMethod { unsafe releaseStackValueCold(&mut hooks, runtime, receiver) }
  unsafe releaseHeaderCold(&mut hooks, runtime, funcRef)
  unsafe releaseHeaderCold(&mut hooks, runtime, inputRef)
  return true
}
/// A CALL_KIND_OBJECT_KEYS call (`Object.keys(obj)`): runs objectIntrinsics.quickKeysSpareRef
/// directly with zero non-cold calls on its hot path (all slow paths @cold),
/// unrolling operand release. False leaves machine untouched.
@inlineNever
unsafe effect fn objectKeysInline<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver,
  machine: &mut Machine, opcode: u8, function: ValueBits) -> bool ? &mut Allocator {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let funcRef = match function { ValueBits.Object { reference } => reference _ => { return false } }
  let fnAnchor = ()
  let fnData = unsafe HeapCell.payload<ObjectData, ()>(&fnAnchor, funcRef)
  let homeOpt = match &fnData.payload {
    ObjectPayload.NativeFunction { function: native } => native.realm()
    _ => Pointer.null<HeapHeader>()
  }
  drop fnData
  let home = match Pointer.nonNullMut<HeapHeader>(homeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let data = unsafe operandCell(machine.stackTop, 1)
  let input = unsafe Pointer.read<ValueBits>(data)
  let inputRef = match input {
    ValueBits.Object { reference } => reference
    _ => { return run unsafe objectKeysSlow(&mut hooks, memory, &mut machine, opcode, funcRef) }
  }
  let runtime = machine.runtime
  let answer = unsafe objectIntrinsics.quickKeysSpareRef(runtime, home, inputRef)
  if !answer.isObject() {
    return run unsafe objectKeysSlow(&mut hooks, memory, &mut machine, opcode, funcRef)
  }
  let isMethod = opcode == op.OP_call_method
  let first = if isMethod { unsafe operandCell(data, 2) } else { unsafe operandCell(data, 1) }
  if opcode == op.OP_call || isMethod { unsafe machine.skip(2) }
  unsafe Pointer.write<i32>(counter, i32.wrappingSubtract(left, 1))
  let receiver = if isMethod { unsafe Pointer.read<ValueBits>(first) } else { ValueBits.Undefined }
  unsafe Pointer.write<ValueBits>(first, answer)
  machine.stackTop = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(first), 1)
  if isMethod { unsafe releaseStackValueCold(&mut hooks, runtime, receiver) }
  unsafe releaseHeaderCold(&mut hooks, runtime, funcRef)
  unsafe releaseHeaderCold(&mut hooks, runtime, inputRef)
  return true
}
/// A CALL_KIND_REGEXP_EXEC / _TEST call (`re.exec(s)` / `re.test(s)`): runs
/// quickExec directly with a small dedicated frame, bypassing quickInline.
/// False leaves machine untouched.
@inlineNever
unsafe effect fn regexpMethodInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, count: usize, function: ValueBits, test: bool) -> bool ! JsException ? &mut Allocator {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let home = match Pointer.nonNullMut<HeapHeader>(unsafe nativeFunctions.nativeRealm(function)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let receiver = unsafe machine.top(usize.wrappingAdd(count, 2))
  if test && !unsafe regexpSymbols.standard(unsafe lendRealm(&home, home), receiver) { return false }
  let data = unsafe operandCell(machine.stackTop, count)
  let arg0 = unsafe Pointer.read<ValueBits>(data)
  unsafe machine.publishPc()
  let quick = run regexpExec.quickExec(&mut hooks, memory, unsafe lendRealm(&home, home), receiver, arg0, test)
  let answer = match move quick { Option<ValueBits>.Some { value } => value Option<ValueBits>.None => { return false } }
  unsafe machine.skip(2)
  unsafe Pointer.write<i32>(counter, i32.wrappingSubtract(left, 1))
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, 2))
  unsafe machine.push(answer)
  return true
}
/// A CALL_KIND_STRING_REPLACE call (`s.replace(re, rep)`): runs quickReplace
/// directly with a small dedicated frame. False leaves machine untouched.
@inlineNever
unsafe effect fn stringReplaceInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, function: ValueBits) -> bool ! JsException ? &mut Allocator {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let home = match Pointer.nonNullMut<HeapHeader>(unsafe nativeFunctions.nativeRealm(function)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let receiver = unsafe machine.top(4)
  let data = unsafe operandCell(machine.stackTop, 2)
  let arg0 = unsafe Pointer.read<ValueBits>(data)
  let arg1 = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(data), 1))
  unsafe machine.publishPc()
  let quick = run regexpSymbols.quickReplace(&mut hooks, memory, unsafe lendRealm(&home, home), receiver, arg0, arg1)
  let answer = match move quick { Option<ValueBits>.Some { value } => value Option<ValueBits>.None => { return false } }
  unsafe machine.skip(2)
  unsafe Pointer.write<i32>(counter, i32.wrappingSubtract(left, 1))
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, 2))
  unsafe machine.push(answer)
  return true
}
/// A CALL_KIND_STRING method called on a string: its primitive entry
/// (nativeFunctions.stringCall) with no native frame. False, with machine
/// untouched, when it declines or the interrupt poll is due.
@inlineNever
unsafe effect fn stringInline<H: HeapHooks + CoercionHooks>(hooks: &mut H, machine: &mut Machine, count: usize, function: ValueBits) -> bool
  ! JsException ? &mut Allocator {
  let receiver = unsafe machine.top(count + 2)
  if !receiver.isString() { return false }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let data = unsafe operandCell(machine.stackTop, count)
  // The text may allocate, which may collect or fail, and the error reports the pc.
  unsafe machine.publishPc()
  let quick = run unsafe nativeFunctions.stringCall(&mut hooks, function, receiver, &FrameSlots { data: data, count: count })
  let answer = match move quick { Option<ValueBits>.Some { value } => value Option<ValueBits>.None => { return false } }
  unsafe machine.skip(2)
  unsafe Pointer.write<i32>(counter, left - 1)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, 2))
  unsafe machine.push(answer)
  return true
}
/// A CALL_KIND_ASYNC_CONTEXT call: the getter pushes the runtime's async context,
/// the setter installs its first argument (undefined when absent) and pushes
/// undefined. Neither throws, calls JavaScript or allocates, so there is no
/// native frame. False, with machine untouched, when the interrupt poll is due.
@inlineNever
unsafe fn asyncContextCall<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8, count: usize, function: ValueBits) -> bool {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let data = unsafe operandCell(machine.stackTop, count)
  let mut answer = ValueBits.Undefined
  if unsafe nativeFunctions.asyncContextSets(function) {
    let mut value = ValueBits.Undefined
    if count != 0 { value = unsafe Pointer.read<ValueBits>(data) }
    unsafe runtime.setAsyncContext(&mut hooks, machine.runtime, unsafe Value.retain(value))
  } else { answer = (unsafe runtime.getAsyncContext(machine.runtime)).intoBits() }
  let mut extra: usize = 1
  if opcode == op.OP_call_method { extra = 2 }
  if opcode == op.OP_call || opcode == op.OP_call_method { unsafe machine.skip(2) }
  unsafe Pointer.write<i32>(counter, left - 1)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
  unsafe machine.push(answer)
  return true
}
/// Cold operand-release fallback for answerKnown / callMethodAnswer on unusual arg counts.
@cold
unsafe fn releaseOperandsSlow<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, first: *mut ValueBits) -> () {
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first)
}
/// nativeFunctions.leanAnswerKnown in place of a CALL_KIND_ANSWER call:
/// takes 6 register arguments (no ValueBits spill or stack arguments at call sites).
@inlineNever
unsafe fn answerKnown<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8, count: usize,
  funcRef: *mut HeapHeader) -> bool {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let anchor = ()
  let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, funcRef)
  let mut family = BuiltinFamily.Runtime
  let mut method: u32 = 0
  let mut ok = false
  match &object.payload {
    ObjectPayload.NativeFunction { function: native } => {
      if let NativeFunctionId.Builtin { family: f, method: m } = native.function {
        family = f
        method = m
        ok = true
      }
    }
    _ => ()
  }
  drop object
  if !ok { return false }
  let isMethod = opcode == op.OP_call_method
  let width: usize = if isMethod || opcode == op.OP_call { 2 } else { 0 }
  let mut receiver = ValueBits.Undefined
  let mut extra: usize = 1
  if isMethod {
    receiver = unsafe machine.top(usize.wrappingAdd(count, 2))
    extra = 2
  }
  let data = unsafe operandCell(machine.stackTop, count)
  let runtime = machine.runtime
  let answer = unsafe nativeFunctions.leanAnswerKnown(runtime, family, method, receiver,
    unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(data), count)
  if answer < 0 { return false }
  if width != 0 { unsafe machine.skip(width) }
  unsafe Pointer.write<i32>(counter, i32.wrappingSubtract(left, 1))
  let first = unsafe operandCell(data, extra)
  if count == 1 || count == 2 {
    let arg0 = unsafe Pointer.read<ValueBits>(data)
    if count == 2 {
      let arg1 = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(data), 1))
      machine.stackTop = first
      unsafe releaseStackValueCold(&mut hooks, runtime, arg1)
    } else {
      machine.stackTop = first
    }
    unsafe releaseStackValueCold(&mut hooks, runtime, arg0)
    unsafe releaseHeaderCold(&mut hooks, runtime, funcRef)
    if isMethod { unsafe releaseStackValueCold(&mut hooks, runtime, receiver) }
  } else {
    unsafe releaseOperandsSlow(&mut hooks, &mut machine, first)
  }
  unsafe pushOrBranchBool(&mut machine, answer != 0)
  return true
}
/// Cold fallback for Function.prototype.call on CALL_KIND_ANSWER builtins other
/// than the common 2-argument hasOwnProperty.call(obj, key).
@cold
unsafe fn callMethodAnswerOther<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, count: usize,
  family: BuiltinFamily, method: u32) -> bool {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let data = unsafe operandCell(machine.stackTop, count)
  let arg0 = unsafe Pointer.read<ValueBits>(data)
  let restPtr = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(data), 1)
  let restCount = usize.wrappingSubtract(count, 1)
  let answer = unsafe nativeFunctions.leanAnswerKnown(machine.runtime, family, method, arg0,
    unsafe Intrinsic.pointerRequalify<*mut ValueBits, *const ValueBits>(restPtr), restCount)
  if answer < 0 { return false }
  unsafe machine.skip(2)
  unsafe Pointer.write<i32>(counter, i32.wrappingSubtract(left, 1))
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, 2))
  unsafe pushOrBranchBool(&mut machine, answer != 0)
  return true
}
/// Function.prototype.call on a CALL_KIND_ANSWER builtin (e.g. hasOwnProperty.call(o, k)),
/// dispatched directly from quickInline without entering quickTargetInline.
@inlineNever
unsafe fn callMethodAnswer<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, count: usize, funcRef: *mut HeapHeader) -> bool {
  let receiver = unsafe machine.top(usize.wrappingAdd(count, 2))
  let recvRef = match receiver { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = ()
  let rData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, recvRef)
  if rData.classId() != classes.JS_CLASS_C_FUNCTION { return false }
  let mut family = BuiltinFamily.Runtime
  let mut method: u32 = 0
  let mut matched = false
  match &rData.payload {
    ObjectPayload.NativeFunction { function: native } => {
      if native.callKind == nativeFunctions.CALL_KIND_ANSWER {
        if let NativeFunctionId.Builtin { family: f, method: m } = native.function {
          family = f
          method = m
          matched = true
        }
      }
    }
    _ => ()
  }
  drop rData
  if !matched { return false }
  if count != 2 || family != BuiltinFamily.Object || method != nativeFunctions.OBJECT_HAS_OWN_PROPERTY {
    return unsafe callMethodAnswerOther(&mut hooks, &mut machine, count, family, method)
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let data = unsafe operandCell(machine.stackTop, 2)
  let objRef = match unsafe Pointer.read<ValueBits>(data) { ValueBits.Object { reference } => reference _ => { return false } }
  let keyRef = match unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(data), 1)) { ValueBits.String { reference } => reference _ => { return false } }
  let runtime = machine.runtime
  let answer = unsafe nativeFunctions.leanHasOwnRefs(runtime, objRef, keyRef)
  if answer < 0 { return false }
  unsafe machine.skip(2)
  unsafe Pointer.write<i32>(counter, i32.wrappingSubtract(left, 1))
  machine.stackTop = unsafe operandCell(data, 2)
  unsafe releaseHeaderCold(&mut hooks, runtime, keyRef)
  unsafe releaseHeaderCold(&mut hooks, runtime, objRef)
  unsafe releaseHeaderCold(&mut hooks, runtime, funcRef)
  unsafe releaseHeaderCold(&mut hooks, runtime, recvRef)
  unsafe pushOrBranchBool(&mut machine, answer != 0)
  return true
}
/// nativeFunctions.leanAnswer in place of the call: the answer replaces the
/// function, receiver and arguments. False, with machine untouched, when it
/// declines or the interrupt poll is due.
@inlineNever
unsafe fn answerInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8, count: usize, function: ValueBits) -> bool {
  return unsafe answerKnown(&mut hooks, &mut machine, opcode, count, core.reference(function))
}
/// quickInline for a native function classified CALL_KIND_LEAN: no frameless
/// answer exists, so the native call itself, as nativeInline makes it.
@inlineNever
unsafe effect fn leanCall<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8, count: usize, function: ValueBits) -> bool ! JsException ? &mut Allocator {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let mut receiver = ValueBits.Undefined let mut extra: usize = 1
  if opcode == op.OP_call_method { receiver = unsafe machine.top(count + 2) extra = 2 }
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let context = machine.context
  if opcode == op.OP_call || opcode == op.OP_call_method { unsafe machine.skip(2) }
  unsafe Pointer.write<i32>(counter, left - 1)
  unsafe machine.publishPc()
  let plain = run nativeFunctions.callPlainInline(&mut hooks, memory, unsafe lendRealm(&context, context), unsafe lendBits(&function, function), unsafe lendBits(&receiver, receiver), unsafe lendArguments(&argv))
  let mut result = ValueBits.Undefined
  match move plain {
    Option<ValueBits>.Some { value } => { if value.isException() { fail JsException {} } result = value }
    Option<ValueBits>.None => { result = run unsafe callClassSlow(&mut hooks, memory, context, function, receiver, &argv, 0) }
  }
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
  unsafe machine.push(result)
  return true
}
/// call1 with an Int argument on the intrinsic String constructor, as in key
/// building (`String(i)`): the decimal text takes the callee's slot, ahead of
/// quickInline's general dispatch and frame, and the arm drops the argument's
/// slot. The poll is charged as quickInline's would be; when it is due, or
/// the callee is anything else, false changes nothing.
@inlineNever
unsafe effect fn stringOfIntSite<H: HeapHooks>(hooks: &mut H, machine: &Machine) -> bool ? &mut Allocator {
  let number = match unsafe machine.top(1) {
    ValueBits.Int { value } => value
    _ => { return false }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let function = unsafe machine.top(2)
  // A text the runtime holds allocates nothing: no pc to publish.
  let held = unsafe nativeFunctions.stringCallCached(function, number)
  if held.isString() {
    unsafe Pointer.write<i32>(counter, left - 1)
    unsafe machine.set(2, held)
    unsafe gc.release(&mut hooks, machine.runtime, function)
    return true
  }
  // The text may allocate, which may collect.
  unsafe machine.publishPc()
  if let Option<ValueBits>.Some { value: text } = run unsafe nativeFunctions.stringCallOfInteger(function, number) {
    unsafe Pointer.write<i32>(counter, left - 1)
    unsafe machine.set(2, text)
    unsafe gc.release(&mut hooks, machine.runtime, function)
    return true
  }
  return false
}
/// OP_call1 on a number argument when the callee is the intrinsic parseInt:
/// answers without quickInline's effect frame, Allocator, or quick dispatch.
@inlineNever
unsafe fn parseIntSite<H: HeapHooks>(hooks: &mut H, machine: &Machine) -> bool {
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let function = unsafe machine.top(2)
  let answer = unsafe nativeFunctions.parseIntCall(function, unsafe machine.top(1))
  if let ValueBits.Uninitialized = answer { return false }
  unsafe Pointer.write<i32>(counter, left - 1)
  unsafe machine.set(2, answer)
  unsafe gc.release(&mut hooks, machine.runtime, function)
  return true
}
const FIELD_MISSED: u8 = 0
const FIELD_PUSHED: u8 = 1
const FIELD_ANSWERED: u8 = 2
const FIELD_FUSED: u8 = 3
/// get_field2 on a primitive string receiver: looks up the method on
/// String.prototype without retaining it. When fuse is true and the method is
/// String.prototype.charCodeAt followed by a simple index operand and
/// `call_method 1`, answers the code unit in place (FIELD_FUSED) without
/// retaining/releasing the function or dispatching the call. Otherwise retains
/// and pushes the method (FIELD_PUSHED), or returns FIELD_MISSED.
@inlineNever
unsafe fn stringFieldSite<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, fuse: bool) -> u8 {
  let mut function = ValueBits.Undefined
  let mut kind: u8 = 0
  let mut haveFunction = false
  if fuse && unsafe properties.isVerifiedCharCodeAt(machine.runtime, machine.context, machine.ip) {
    kind = nativeFunctions.UNIT_METHOD_CHAR_CODE_AT
  } else {
    if !unsafe properties.readStringMethodBorrowed(&machine, Pointer.fromMutRef<ValueBits>(&mut function)) { return FIELD_MISSED }
    haveFunction = true
    if fuse {
      kind = unsafe nativeFunctions.unitMethod(function)
      if kind == nativeFunctions.UNIT_METHOD_CHAR_CODE_AT {
        unsafe properties.noteStringCharCodeAt(machine.runtime, machine.context, machine.ip, function)
      }
    }
  }
  if fuse && (kind == nativeFunctions.UNIT_METHOD_CHAR_CODE_AT || kind == nativeFunctions.UNIT_METHOD_CHAR_AT) {
    let nextOp = unsafe machine.peekU8(4)
    let mut width: usize = 0
    let mut index = ValueBits.Undefined
    let mut haveIndex = false
    if nextOp == op.OP_get_loc_field8 {
      let fieldWidth = 1 + properties.FIELD_OPERAND_BYTES + 1
      if unsafe machine.peekU8(4 + fieldWidth) == op.OP_call_method && unsafe machine.peekU16At(5 + fieldWidth) == 1 {
        let holder = unsafe machine.local(u8.toUsize(unsafe machine.peekU8(5 + properties.FIELD_OPERAND_BYTES)))
        match holder {
          ValueBits.Object { reference } => {
            let fieldIp = unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(machine.ip), 5)
            if unsafe properties.readFieldKeyedAt(machine.runtime, fieldIp, reference, Pointer.fromMutRef<ValueBits>(&mut index), false) {
              width = fieldWidth haveIndex = true
            }
          }
          _ => ()
        }
      }
    } else if nextOp >= op.OP_get_loc0 && nextOp <= op.OP_get_loc3 {
      index = unsafe machine.local(u8.toUsize(nextOp - op.OP_get_loc0)) width = 1 haveIndex = true
    } else if nextOp == op.OP_get_loc8 {
      index = unsafe machine.local(u8.toUsize(unsafe machine.peekU8(5))) width = 2 haveIndex = true
    } else if nextOp >= op.OP_get_arg0 && nextOp <= op.OP_get_arg3 {
      index = unsafe machine.argument(u8.toUsize(nextOp - op.OP_get_arg0)) width = 1 haveIndex = true
    } else if nextOp == op.OP_get_arg {
      index = unsafe machine.argument(u16.toUsize(unsafe machine.peekU16At(5))) width = 3 haveIndex = true
    } else if nextOp >= op.OP_push_0 && nextOp <= op.OP_push_1 {
      index = ValueBits.Int { value: u8.toI32(nextOp - op.OP_push_0) } width = 1 haveIndex = true
    } else if nextOp == op.OP_push_i8 {
      let b = unsafe machine.peekU8(5)
      index = ValueBits.Int { value: if b >= 128 { u8.toI32(b) - 256 } else { u8.toI32(b) } } width = 2 haveIndex = true
    }
    if haveIndex && unsafe machine.peekU8(4 + width) == op.OP_call_method && unsafe machine.peekU16At(5 + width) == 1 {
      let receiver = unsafe machine.top(1)
      let unit = unsafe nativeFunctions.charCodeOf(receiver, index)
      if unit >= 0 {
        if kind == nativeFunctions.UNIT_METHOD_CHAR_CODE_AT {
          unsafe machine.set(1, ValueBits.Int { value: unit })
          unsafe machine.skip(4 + width + 3)
          if receiver.tag() == -7 && !Strings.heldOnce(receiver) { Strings.dropHolder(receiver) return FIELD_FUSED }
          return unsafe releaseStringFusedSlow(&mut hooks, machine.runtime, receiver)
        }
        let ch = unsafe nativeFunctions.unitStringOf(machine.runtime, ValueBits.Int { value: unit })
        if ch.isString() {
          unsafe machine.set(1, ch)
          unsafe machine.skip(4 + width + 3)
          if receiver.tag() == -7 && !Strings.heldOnce(receiver) { Strings.dropHolder(receiver) return FIELD_FUSED }
          return unsafe releaseStringFusedSlow(&mut hooks, machine.runtime, receiver)
        }
      }
    }
  }
  if !haveFunction && !unsafe properties.readStringMethodBorrowed(&machine, Pointer.fromMutRef<ValueBits>(&mut function)) { return FIELD_MISSED }
  unsafe Pointer.write<ValueBits>(machine.stackTop, unsafe function.retained())
  return FIELD_PUSHED
}
@inlineNever
unsafe fn releaseStringFusedSlow<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, receiver: ValueBits) -> u8 {
  unsafe gc.release(&mut hooks, runtime, receiver)
  return FIELD_FUSED
}
/// get_field2 on a primitive receiver, past pushFieldOperand's objects:
/// FIELD_ANSWERED when intToStringSite answered `n.toString()` whole,
/// FIELD_PUSHED when the property was read through the site cache into the
/// slot above the receiver (properties.pushStringFieldOperand), else
/// FIELD_MISSED with nothing changed. ip and stackTop stay for the arm to move.
@inlineNever
unsafe effect fn primitiveFieldSite(machine: &Machine) -> u8 ? &mut Allocator {
  if unsafe operators.intTop(&machine) && run unsafe intToStringSite(&machine) { return FIELD_ANSWERED }
  if unsafe properties.pushStringFieldOperand(&machine) { return FIELD_PUSHED }
  return FIELD_MISSED
}
/// get_field2 on an Int directly followed by call_method 0, with the field
/// still the intrinsic Number.prototype.toString: the decimal text takes the
/// receiver's slot without pushing the method or making the call (ip is at
/// the atom). The method is read through the site cache from Number.prototype
/// and only inspected, so it is never retained. The poll is charged as
/// quickInline's would be; when it is due, or the field is anything else,
/// false changes nothing and both instructions run as usual.
@inlineAlways
unsafe effect fn intToStringSite(machine: &Machine) -> bool ? &mut Allocator {
  if unsafe machine.peekU8(4) != op.OP_call_method || unsafe machine.peekU16At(5) != 0 { return false }
  let number = match unsafe machine.top(1) {
    ValueBits.Int { value } => value
    _ => { return false }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let anchor = () let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  let prototype = match context.classPrototypes.get(u32.toUsize(classes.JS_CLASS_NUMBER)) {
    ValueBits.Object { reference } => reference
    _ => { return false }
  }
  drop context
  let mut function = ValueBits.Undefined
  if !unsafe properties.readFieldCachedAt(machine.runtime, machine.ip, prototype, Pointer.fromMutRef<ValueBits>(&mut function), false) { return false }
  if let Option<ValueBits>.Some { value: text } = run unsafe nativeFunctions.intToStringCall(function, number) {
    unsafe Pointer.write<i32>(counter, left - 1)
    unsafe machine.set(1, text)
    return true
  }
  return false
}
/// OP_regexp directly followed by `.exec(x)` with x a plain local or argument
/// read and exec the builtin: the literal's object could
/// never be seen (nothing else holds it, and its lastIndex starts at 0), so the
/// call is answered from the bytecode constant without creating it. The poll
/// is charged as the call's would be. False, with nothing changed, for any
/// other shape, a non-string x, or a quick path that declines.
@inlineNever
unsafe effect fn literalCall<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> bool ! JsException ? &mut Allocator {
  if unsafe machine.peekU8(0) != op.OP_get_field2 { return run unsafe literalReplaceCall(&mut hooks, memory, &mut machine) }
  let atom = u16.toU32(unsafe machine.peekU16At(1)) | u32.shiftLeft(u16.toU32(unsafe machine.peekU16At(3)), 16)
  if atom != atoms.JS_ATOM_exec { return false }
  let read = unsafe machine.peekU8(5)
  let mut input = ValueBits.Undefined
  let mut width: usize = 1
  if read >= op.OP_get_loc0 && read <= op.OP_get_loc3 { input = unsafe machine.local(u8.toUsize(read - op.OP_get_loc0)) }
  else if read >= op.OP_get_arg0 && read <= op.OP_get_arg3 { input = unsafe machine.argument(u8.toUsize(read - op.OP_get_arg0)) }
  else if read == op.OP_get_loc8 { input = unsafe machine.local(u8.toUsize(unsafe machine.peekU8(6))) width = 2 }
  else if read == op.OP_get_loc { input = unsafe machine.local(u16.toUsize(unsafe machine.peekU16At(6))) width = 3 }
  else if read == op.OP_get_arg { input = unsafe machine.argument(u16.toUsize(unsafe machine.peekU16At(6))) width = 3 }
  else { return false }
  if input.tag() != -7 { return false }
  if unsafe machine.peekU8(5 + width) != op.OP_call_method || unsafe machine.peekU16At(6 + width) != 1 { return false }
  let anchor = ()
  let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  let maybeShape = context.regexpShape
  drop context
  let shape = match Pointer.nonNullMut<HeapHeader>(maybeShape) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let exec = unsafe regexpSymbols.literalExecMethod(machine.context, shape)
  if !exec.isObject() || unsafe classId(exec) != classes.JS_CLASS_C_FUNCTION { return false }
  let mut test = false
  let home = unsafe nativeFunctions.regexpExecRealm(exec, &mut test)
  if test { return false }
  let realm = match Pointer.nonNullMut<HeapHeader>(home) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let code = unsafe machine.top(1)
  unsafe machine.publishPc()
  // `r = /re/.exec(s)`: the result a plain local r holds now may take this match
  // (regexpExec.refillResult), since the store that follows frees it.
  let store = unsafe machine.peekU8(5 + width + 3)
  let mut previous = ValueBits.Undefined
  if store >= op.OP_put_loc0 && store <= op.OP_put_loc3 { previous = unsafe machine.local(u8.toUsize(store - op.OP_put_loc0)) }
  else if store == op.OP_put_loc8 { previous = unsafe machine.local(u8.toUsize(unsafe machine.peekU8(5 + width + 4))) }
  let quick = run regexpExec.literalExec(&mut hooks, memory, unsafe lendRealm(&realm, realm), code, input, false, previous)
  let answer = match move quick {
    Option<ValueBits>.Some { value } => value
    Option<ValueBits>.None => { return false }
  }
  unsafe Pointer.write<i32>(counter, left - 1)
  // The pattern and bytecode constants go; the answer takes their place.
  let first = unsafe operandCell(machine.stackTop, 2)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first)
  unsafe machine.push(answer)
  unsafe machine.skip(5 + width + 3)
  return true
}
/// literalCall's `s.replace(/re/, text)`: the stack holds s, the replace
/// function, then the literal's pattern and bytecode; text comes next from a
/// string atom or a local, then call_method 2. With the builtins all the way
/// down (regexpSymbols.literalReplace) the answer replaces all four and the
/// call, and the RegExp object is never created. False with nothing changed
/// otherwise.
@inlineNever
unsafe effect fn literalReplaceCall<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine) -> bool ! JsException ? &mut Allocator {
  let read = unsafe machine.peekU8(0)
  let mut width: usize = 1
  if read == op.OP_push_atom_value { width = 5 }
  else if read == op.OP_get_loc8 { width = 2 }
  else if !(read >= op.OP_get_loc0 && read <= op.OP_get_loc3) { return false }
  if unsafe machine.peekU8(width) != op.OP_call_method || unsafe machine.peekU16At(width + 1) != 2 { return false }
  if machine.sp() < 4 { return false }
  let function = unsafe machine.top(3) let receiver = unsafe machine.top(4)
  if receiver.tag() != -7 || !function.isObject() || unsafe classId(function) != classes.JS_CLASS_C_FUNCTION { return false }
  let target = match unsafe nativeFunctions.quickTarget(function) {
    Option<nativeFunctions.QuickTarget>.Some { value } => value
    Option<nativeFunctions.QuickTarget>.None => { return false }
  }
  let home = match Pointer.nonNullMut<HeapHeader>(nativeFunctions.stringReplaceRealm(&target)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let anchor = ()
  let context = unsafe HeapCell.payload<ContextState, ()>(&anchor, machine.context)
  let maybeShape = context.regexpShape
  drop context
  let shape = match Pointer.nonNullMut<HeapHeader>(maybeShape) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return false }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let mut replacement = ValueBits.Undefined
  let mut owned = false
  if read == op.OP_push_atom_value {
    let atom = u16.toU32(unsafe machine.peekU16At(1)) | u32.shiftLeft(u16.toU32(unsafe machine.peekU16At(3)), 16)
    if AtomTable.isInteger(atom) { return false }
    let stateAnchor = () let state = unsafe HeapCell.payload<RuntimeState, ()>(&stateAnchor, machine.runtime)
    replacement = state.atoms.storedValue(atom, false) drop state
    owned = true
  }
  else if read == op.OP_get_loc8 { replacement = unsafe machine.local(u8.toUsize(unsafe machine.peekU8(1))) }
  else { replacement = unsafe machine.local(u8.toUsize(read - op.OP_get_loc0)) }
  let code = unsafe machine.top(1)
  unsafe machine.publishPc()
  let attempted = run Effect.result(regexpSymbols.literalReplace(&mut hooks, memory, unsafe lendRealm(&home, home), shape, code, receiver, replacement))
  if owned { unsafe gc.release(&mut hooks, machine.runtime, replacement) }
  let quick = match move attempted {
    Result<Option<ValueBits>, JsException>.Success { value } => value
    Result<Option<ValueBits>, JsException>.Failure { error } => { fail move error }
  }
  let answer = match move quick {
    Option<ValueBits>.Some { value } => value
    Option<ValueBits>.None => { return false }
  }
  unsafe Pointer.write<i32>(counter, left - 1)
  let first = unsafe operandCell(machine.stackTop, 4)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first)
  unsafe machine.push(answer)
  unsafe machine.skip(width + 3)
  return true
}
/// nativeInline's RegExp.prototype.test call, out of line so exec's path stays
/// lean. test reads exec through a property: quick only when that read finds
/// the builtin (regexpSymbols.standard).
@inlineNever
unsafe effect fn testInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, home: *mut HeapHeader, function: ValueBits, receiver: ValueBits,
  data: *mut ValueBits, count: usize, extra: usize) -> bool ! JsException ? &mut Allocator {
  let argv = FrameSlots { data: data, count: count }
  let mut answer = ValueBits.Undefined
  let mut quick = Option<ValueBits>.none()
  if unsafe regexpSymbols.standard(unsafe lendRealm(&home, home), receiver) {
    quick = run regexpExec.quickExec(&mut hooks, memory, unsafe lendRealm(&home, home), receiver, unsafe argv.get(0), true)
  }
  match move quick {
    Option<ValueBits>.Some { value } => { answer = value }
    Option<ValueBits>.None => { answer = run unsafe callNativePlain(&mut hooks, memory, machine.context, function, receiver, &argv) }
  }
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
  unsafe machine.push(answer)
  return true
}
@inlineNever
unsafe effect fn leanInlineSlow<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8, count: usize, function: ValueBits, kind: u8) -> bool ! JsException ? &mut Allocator {
  return run unsafe leanInline(&mut hooks, memory, &mut machine, opcode, count, function, kind)
}
@inlineNever
unsafe effect fn quickInlineCold<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8, count: usize, function: ValueBits, receiver: ValueBits,
  data: *mut ValueBits, extra: usize, target: &nativeFunctions.QuickTarget, counter: *mut i32, left: i32, fromQuickMiss: bool) -> bool ! JsException ? &mut Allocator {
  let argv = FrameSlots { data: data, count: count }
  let context = machine.context
  if !fromQuickMiss {
    if count == 1 && nativeFunctions.isStringConstructor(target) {
      unsafe machine.publishPc()
      if let Option<ValueBits>.Some { value: text } = run nativeFunctions.stringOfInteger(target, &argv) {
        if opcode == op.OP_call || opcode == op.OP_call_method { unsafe machine.skip(2) }
        unsafe Pointer.write<i32>(counter, left - 1)
        unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
        unsafe machine.push(text)
        return true
      }
    }
    if count != 0 && opcode == op.OP_call_method {
      if let Option<*mut HeapHeader>.Some { value: home } = Pointer.nonNullMut<HeapHeader>(nativeFunctions.arraySpliceRealm(target)) {
        let plan = run arrayMutation.quickSplicePlan(&mut hooks, unsafe lendRealm(&home, home), receiver, &argv)
        if plan.start >= 0 {
          unsafe machine.skip(2)
          unsafe machine.publishPc()
          unsafe Pointer.write<i32>(counter, left - 1)
          let wanted = unsafe machine.peekU8(0) != op.OP_drop
          let answer = run arrayMutation.quickSplice(&mut hooks, memory, unsafe lendRealm(&home, home), receiver, &argv, plan, wanted)
          unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
          unsafe machine.push(answer)
          return true
        }
      }
    }
    return false
  }
  unsafe machine.publishPc()
  let mut result = ValueBits.Undefined
  match run unsafe nativeFunctions.quickWrite(&mut hooks, target, receiver, &argv) {
    Option<ValueBits>.Some { value } => { result = value }
    Option<ValueBits>.None => {
      unsafe Pointer.write<i32>(counter, left - 1)
      result = run unsafe callNativePlain(&mut hooks, memory, context, function, receiver, &argv)
      unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
      unsafe machine.push(result)
      return true
    }
  }
  unsafe Pointer.write<i32>(counter, left - 1)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
  unsafe machine.push(result)
  return true
}
@inlineNever
unsafe effect fn quickTargetInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8, count: usize, function: ValueBits) -> bool ! JsException ? &mut Allocator {
  let target = match unsafe nativeFunctions.quickTarget(function) {
    Option<nativeFunctions.QuickTarget>.Some { value } => value
    Option<nativeFunctions.QuickTarget>.None => { return run unsafe nativeInline(&mut hooks, memory, &mut machine, opcode, count, function) }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return false }
  let mut receiver = ValueBits.Undefined let mut extra: usize = 1
  if opcode == op.OP_call_method { receiver = unsafe machine.top(usize.wrappingAdd(count, 2)) extra = 2 }
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let context = machine.context
  // String(n) on an Int or arr.splice(...) on a plain fast Array.
  if (count == 1 && nativeFunctions.isStringConstructor(&target))
    || (count != 0 && opcode == op.OP_call_method && !Pointer.isNull<HeapHeader>(nativeFunctions.arraySpliceRealm(&target))) {
    if run unsafe quickInlineCold(&mut hooks, memory, &mut machine, opcode, count, function, receiver, data, extra, &target, counter, left, false) { return true }
  }
  let result = nativeFunctions.quick(&mut hooks, unsafe lendRealm(&context, context), &target, unsafe lendBits(&receiver, receiver), argv)
  if opcode == op.OP_call || opcode == op.OP_call_method { unsafe machine.skip(2) }
  if let ValueBits.Uninitialized = result {
    return run unsafe quickInlineCold(&mut hooks, memory, &mut machine, opcode, count, function, receiver, data, extra, &target, counter, left, true)
  }
  unsafe Pointer.write<i32>(counter, i32.wrappingSubtract(left, 1))
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, unsafe operandCell(data, extra))
  unsafe machine.push(result)
  return true
}
@inlineNever
unsafe effect fn quickInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks + InterruptHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> bool ! JsException ? &mut Allocator {
  let count = unsafe callCount(&machine, opcode)
  let function = unsafe machine.top(usize.wrappingAdd(count, 1))
  let funcRef = match function { ValueBits.Object { reference } => reference _ => { return false } }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, funcRef)
  if data.classId() != classes.JS_CLASS_C_FUNCTION { return false }
  let mut kind = nativeFunctions.CALL_KIND_SLOW
  let mut isCallMethod = false
  match &data.payload {
    ObjectPayload.NativeFunction { function: native } => {
      kind = native.callKind
      if kind == nativeFunctions.CALL_KIND_ANSWER {
        drop data
        if unsafe answerKnown(&mut hooks, &mut machine, opcode, count, funcRef) { return true }
        return run unsafe leanInlineSlow(&mut hooks, memory, &mut machine, opcode, count, function, kind)
      }
      if kind == nativeFunctions.CALL_KIND_OBJECT_KEYS && count == 1 {
        drop data
        if unsafe objectKeysFast(&mut hooks, &mut machine, opcode, funcRef) { return true }
        return run unsafe leanInlineSlow(&mut hooks, memory, &mut machine, opcode, count, function, kind)
      }
      if kind < nativeFunctions.CALL_KIND_LEAN && opcode == op.OP_call_method && count != 0 && native.magicBits == 0 {
        if let NativeFunctionId.Builtin { family, method } = native.function {
          if family == BuiltinFamily.Function && method == invoke.CALL_METHOD { isCallMethod = true }
        }
      }
    }
    _ => ()
  }
  drop data
  if isCallMethod {
    if unsafe callMethodAnswer(&mut hooks, &mut machine, count, funcRef) { return true }
  }
  if kind >= nativeFunctions.CALL_KIND_LEAN {
    return run unsafe leanInlineSlow(&mut hooks, memory, &mut machine, opcode, count, function, kind)
  }
  return run unsafe quickTargetInline(&mut hooks, memory, &mut machine, opcode, count, function)
}
/// The most array elements an inlined apply call (appliesInline) copies.
const APPLY_INLINE_ARGUMENTS: usize = 8
/// Whether OP_call_method at machine is target.apply(thisArg, array) or
/// target.call(thisArg, ...args) with the intrinsic method and target a plain
/// bytecode function: callInline then runs target inline (for apply, when array
/// is dense: invoke.denseArguments).
@inlineAlways
unsafe fn appliesInline(machine: &Machine) -> bool {
  let count = unsafe callCount(machine, op.OP_call_method)
  if count == 0 { return false }
  // A lazy arguments slot's stand-in (factories.lazyArgumentsSlot): callInline
  // applies on the frame's own arguments or builds the object.
  if count == 2 && (unsafe machine.top(1)).tag() == 4 { return true }
  let method = unsafe invoke.functionMethod(unsafe machine.top(count + 1))
  if method != invoke.CALL_METHOD && !(method == invoke.APPLY_METHOD && count == 2) {
    // Reflect.apply(target, thisArg, array) runs target inline as target.apply would.
    if method != u32.MAX || !unsafe iteration.directFamily(unsafe machine.top(count + 1)) { return false }
    return unsafe directInline(machine, count)
  }
  return unsafe inlineCallee(unsafe machine.top(count + 2))
}
/// appliesInline for a callee that is not the intrinsic call or apply, kept out
/// of the dispatch loop: Reflect.apply(target, thisArg, array) with target run
/// inline as target.apply would; a bound function called directly; an Array
/// callback method, unless its callback is native (arr.map(String)), which keeps
/// the method's native loop.
@inlineNever
unsafe fn directInline(machine: &Machine, count: usize) -> bool {
  let function = unsafe machine.top(count + 1)
  if !function.isObject() { return false }
  let class = unsafe classId(function)
  if class == classes.JS_CLASS_BOUND_FUNCTION { return unsafe boundEnters(function) }
  if class != classes.JS_CLASS_C_FUNCTION { return false }
  if count == 3 && unsafe invoke.isReflectApply(function) { return unsafe inlineCallee(unsafe machine.top(3)) }
  if unsafe iteration.methodOf(function) == u32.MAX { return false }
  let callback = unsafe machine.top(count)
  return !callback.isObject() || unsafe classId(callback) != classes.JS_CLASS_C_FUNCTION
}
/// Whether enterCallee may run value in an inline frame: a plain bytecode
/// function, or a directCallee.
@inlineAlways
unsafe fn inlineCallee(value: ValueBits) -> bool {
  if !value.isObject() { return false }
  if unsafe classId(value) == classes.JS_CLASS_BYTECODE_FUNCTION { return true }
  return unsafe directCallee(value)
}
/// Whether value, an object, is a bound function or an Array callback method
/// (js_vm_iteration): callees enterCallee runs inline although they are not bytecode.
@inlineAlways
unsafe fn directCallee(value: ValueBits) -> bool {
  let class = unsafe classId(value)
  if class == classes.JS_CLASS_BOUND_FUNCTION { return unsafe boundEnters(value) }
  return class == classes.JS_CLASS_C_FUNCTION && unsafe iteration.methodOf(value) != u32.MAX
}
/// Whether enterCallee would run bound function value inline: its callee after
/// unwrapping one level (the target, or uncurryThis's function) is bytecode, a
/// bound function or an Array callback method. A native one keeps the native call.
@inlineNever
unsafe fn boundEnters(value: ValueBits) -> bool {
  let enters = unsafe computeBoundEnters(value)
  let mut state: u8 = 2 if enters { state = 1 }
  unsafe bound.noteInline(core.reference(value), state)
  return enters
}
unsafe fn computeBoundEnters(value: ValueBits) -> bool {
  let record = Bound.of(unsafe lendBits(&value, value))
  let mut callee = record.target().view()
  let boundThis = record.boundThis().view()
  if record.count() == 0 && unsafe invoke.isCall(callee) && unsafe callsPlainly(boundThis) { callee = boundThis }
  if !callee.isObject() { return false }
  let class = unsafe classId(callee)
  if class == classes.JS_CLASS_BYTECODE_FUNCTION || class == classes.JS_CLASS_BOUND_FUNCTION { return true }
  return class == classes.JS_CLASS_C_FUNCTION && unsafe iteration.methodOf(callee) != u32.MAX
}
/// Whether the plain call (call0-3, call) at machine with count arguments calls a
/// bound function: callInline then runs its target inline (enterCallee).
@inlineAlways
unsafe fn boundCallee(machine: &Machine, count: usize) -> bool {
  let function = unsafe machine.top(count + 1)
  if !function.isObject() || unsafe classId(function) != classes.JS_CLASS_BOUND_FUNCTION { return false }
  let state = Bound.of(unsafe lendBits(&function, function)).inline()
  if state != 0 { return state == 1 }
  return unsafe boundEnters(function)
}
/// The most arguments, bound ones included, a bound call copies for enterCallee.
const BOUND_INLINE_ARGUMENTS: usize = 8
/// The bound functions enterCallee unwraps before giving up.
const BOUND_INLINE_DEPTH: usize = 4
/// Enters function, called with receiver and argv, in an inline frame whose call
/// completes at first (the caller's first call operand): a plain bytecode function
/// directly; a bound function as its target with its receiver and bound arguments
/// (and Function.prototype.call bound to f, primordials' uncurryThis, as f with
/// the first argument as receiver); an Array callback method as its iteration
/// loop (js_vm_iteration). copy: argv is scratch the frame must copy. Null with
/// machine untouched when it cannot. The callee and receiver stay alive through
/// the caller's operands (a bound function's record holds its parts).
/// enterCallee with a plain bytecode function entered directly, without the
/// unwrapping loop's frame and scratch list.
@inlineAlways
unsafe effect fn enterAny(machine: &mut Machine, function: ValueBits, receiver: ValueBits, argv: FrameSlots, first: *mut ValueBits,
  copy: bool) -> ?*mut Machine ? &mut Allocator {
  if function.isObject() && unsafe classId(function) == classes.JS_CLASS_BYTECODE_FUNCTION {
    let running = Pointer.fromMutRef<Machine>(&mut machine)
    return match unsafe activation.enterInline(machine.runtime, function, argv, first, running, machine.context, receiver,
      ValueBits.Undefined, false, copy) {
      Option<*mut Machine>.Some { value } => value
      Option<*mut Machine>.None => Pointer.null<Machine>()
    }
  }
  return run unsafe enterCallee(&mut machine, function, receiver, argv, first, copy)
}
@inlineNever
unsafe effect fn enterCallee(machine: &mut Machine, function: ValueBits, receiver: ValueBits, argv: FrameSlots, first: *mut ValueBits,
  copy: bool) -> ?*mut Machine ? &mut Allocator {
  let buffer = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(BOUND_INLINE_ARGUMENTS))
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let mut callee = function let mut thisValue = receiver let mut arguments = argv let mut copied = copy
  let mut depth: usize = 0
  while depth < BOUND_INLINE_DEPTH {
    if !callee.isObject() { return Pointer.null<Machine>() }
    let class = unsafe classId(callee)
    if class == classes.JS_CLASS_BYTECODE_FUNCTION {
      return match unsafe activation.enterInline(machine.runtime, callee, arguments, first, running, machine.context, thisValue,
        ValueBits.Undefined, false, copied) {
        Option<*mut Machine>.Some { value } => value
        Option<*mut Machine>.None => Pointer.null<Machine>()
      }
    }
    if class == classes.JS_CLASS_BOUND_FUNCTION {
      let record = Bound.of(unsafe lendBits(&callee, callee))
      let target = record.target().view()
      let boundThis = record.boundThis().view()
      let bound = record.count()
      if bound == 0 && unsafe invoke.isCall(target) && unsafe callsPlainly(boundThis) {
        callee = boundThis
        if arguments.length() == 0 { thisValue = ValueBits.Undefined }
        else { thisValue = unsafe arguments.get(0) arguments = arguments.after(1) }
      } else {
        if bound != 0 {
          // One scratch list: the bound arguments, then the call's.
          if copied || bound + arguments.length() > BOUND_INLINE_ARGUMENTS { return Pointer.null<Machine>() }
          let many = unsafe Pointer.assumeManyMut<ValueBits>(buffer)
          let mut index: usize = 0
          while index < bound { unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, index), record.argument(index).view()) index = index + 1 }
          index = 0
          while index < arguments.length() { unsafe Pointer.write<ValueBits>(unsafe Pointer.atMut<ValueBits>(many, bound + index), unsafe arguments.get(index)) index = index + 1 }
          arguments = FrameSlots { data: buffer, count: bound + arguments.length() }
          copied = true
        }
        callee = target thisValue = boundThis
      }
      depth = depth + 1
      continue
    }
    let method = unsafe iteration.methodOf(callee)
    if method == u32.MAX { return Pointer.null<Machine>() }
    return run unsafe iteration.enter(&mut machine, callee, method, thisValue, arguments, first, copied)
  }
  return Pointer.null<Machine>()
}
/// OP_call3 of Reflect.apply(target, thisArg, array) with target a plain bytecode
/// function, wherever the call got Reflect.apply from (primordials keep it as a
/// plain function, ReflectApply): target runs inline as in appliesInline, so the
/// call costs no native frames on the C stack.
@inlineAlways
unsafe fn reflectAppliesInline(machine: &Machine) -> bool {
  if !unsafe invoke.isReflectApply(unsafe machine.top(4)) { return false }
  let applied = unsafe machine.top(3)
  return applied.isObject() && unsafe classId(applied) == classes.JS_CLASS_BYTECODE_FUNCTION
}
/// OP_apply for `f(...x)` (APPLY_ITERABLE, not a construct) with f a plain
/// bytecode function and x an array whose spread runs no code
/// (iterators.spreadsPlainly): f runs inline on copies of x's elements, as
/// callInline does for f.apply. Returns the callee's machine, or null with
/// machine untouched.
@inlineNever
unsafe fn applyInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> ?*mut Machine {
  if unsafe machine.peekU16() != op.APPLY_ITERABLE { return Pointer.null<Machine>() }
  let function = unsafe machine.top(3)
  if !function.isObject() || unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION { return Pointer.null<Machine>() }
  let source = unsafe machine.top(1)
  let spread = iterators.spreadCount(unsafe lendRealm(&machine.context, machine.context), source)
  if spread < 0 || i32.toUsize(spread) > APPLY_INLINE_ARGUMENTS { return Pointer.null<Machine>() }
  let applied = i32.toUsize(spread)
  let buffer = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(APPLY_INLINE_ARGUMENTS))
  unsafe iterators.spreadElements(source, buffer, applied)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let callee = unsafe activation.calleeOf(function)
  if unsafe leaves.runsLeaf(callee.bytecode, applied) {
    // The elements stay owned by the array operand until the leaf's result replaces the operands.
    if unsafe leaves.attempt(&mut hooks, running, function, callee.bytecode, FrameSlots { data: buffer, count: applied }, unsafe machine.topCell(3), unsafe machine.topCell(2)) {
      unsafe machine.skip(2) return running
    }
    unsafe leaves.miss(machine.runtime, callee.bytecode)
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return Pointer.null<Machine>() }
  unsafe Pointer.write<i32>(counter, left - 1)
  let entered = unsafe activation.enterDecoded(machine.runtime, function, callee, FrameSlots { data: buffer, count: applied }, unsafe machine.topCell(3), running,
    machine.context, unsafe machine.top(2), ValueBits.Undefined, false, true)
  match entered {
    Option<*mut Machine>.Some { value } => { unsafe machine.skip(2) unsafe machine.publishPc() return value }
    Option<*mut Machine>.None => { unsafe refund(counter) return Pointer.null<Machine>() }
  }
}
/// callInline's common case with no effect context: a call to a plain bytecode
/// function (callsBytecode; apply calls are left to callInline) whose frame fits
/// the region while no interrupt poll is due. Returns the callee's machine, or null with machine untouched for
/// callInline to handle.
@inlineNever
unsafe fn enterCallObject<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8, count: usize, width: usize) -> ?*mut Machine {
  return unsafe enterCallWith(&mut hooks, &mut machine, opcode, count, width, true)
}
@inlineNever
unsafe fn enterCall<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8) -> ?*mut Machine {
  let count = unsafe callCount(&machine, opcode)
  let mut width: usize = 0
  if opcode == op.OP_call || opcode == op.OP_call_method { width = 2 }
  if opcode != op.OP_call_method {
    let data = unsafe operandCell(machine.stackTop, count)
    match unsafe Pointer.read<ValueBits>(unsafe operandCell(data, 1)) {
      ValueBits.FunctionBytecode { reference } => { return unsafe enterKnownCall(&mut hooks, &mut machine, reference, count, width) }
      _ => ()
    }
  }
  return unsafe enterCallObject(&mut hooks, &mut machine, opcode, count, width)
}
/// Lean non-effectful inline entry for target.call(thisArg, ...args) and
/// target.apply(thisArg, arguments) on a plain bytecode function (e.g. ES5
/// `_super.call(this, ...)` / `fn.apply(this, arguments)`): avoids callInline's
/// effectful 14-trait frame and lazyArgumentsSlot bytecode scan, and supports
/// frameless leaf targets too. Returns null with machine untouched on fallback.
@inlineNever
unsafe fn enterApplyInline<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, count: usize) -> ?*mut Machine {
  if count == 0 { return Pointer.null<Machine>() }
  let data = unsafe operandCell(machine.stackTop, count)
  let function = unsafe Pointer.read<ValueBits>(unsafe operandCell(data, 1))
  let mut copy = false
  let mut forwarded = FrameSlots { data: unsafe operandCell(data, usize.wrappingSubtract(0, 1)), count: count - 1 }
  if count == 2 && (unsafe machine.top(1)).tag() == 4 {
    if !unsafe invoke.isApply(function) { return Pointer.null<Machine>() }
    forwarded = unsafe Pointer.read<FrameSlots>(unsafe activation.originalArgumentsOf(&machine))
    copy = true
  } else if !unsafe invoke.isCall(function) {
    return Pointer.null<Machine>()
  }
  let first = unsafe operandCell(data, 2)
  let target = unsafe Pointer.read<ValueBits>(first)
  if !target.isObject() || unsafe classId(target) != classes.JS_CLASS_BYTECODE_FUNCTION { return Pointer.null<Machine>() }
  let thisArg = unsafe Pointer.read<ValueBits>(data)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let callee = unsafe activation.calleeOf(target)
  if unsafe leaves.runsLeaf(callee.bytecode, forwarded.count) {
    if unsafe leaves.attempt(&mut hooks, running, target, callee.bytecode, forwarded, first, data) {
      unsafe machine.skip(2)
      return running
    }
    unsafe leaves.miss(machine.runtime, callee.bytecode)
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return Pointer.null<Machine>() }
  unsafe Pointer.write<i32>(counter, left - 1)
  unsafe machine.skip(2)
  unsafe machine.publishFramePc()
  let entered = unsafe activation.enterDecoded(machine.runtime, target, callee, forwarded, first, running, machine.context, thisArg,
    ValueBits.Undefined, false, copy)
  match entered {
    Option<*mut Machine>.Some { value } => { return value }
    Option<*mut Machine>.None => {
      unsafe machine.skip(usize.wrappingSubtract(0, 2))
      unsafe refund(counter)
      return Pointer.null<Machine>()
    }
  }
}
/// enterCall for OP_call_method, the common call in method-heavy code: the
/// opcode is a constant, so the width and receiver need no tests, and count is
/// the one calleeIsBytecode saw (decoding it again cost a second operand read).
@inlineAlways
unsafe fn enterMethodCall<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, count: usize) -> ?*mut Machine {
  return unsafe enterCallWith(&mut hooks, &mut machine, op.OP_call_method, count, 2, true)
}
@inlineAlways
unsafe fn enterCallFor<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8) -> ?*mut Machine {
  let count = unsafe callCount(&machine, opcode)
  let mut width: usize = 0
  if opcode == op.OP_call || opcode == op.OP_call_method { width = 2 }
  return unsafe enterCallWith(&mut hooks, &mut machine, opcode, count, width, true)
}
/// The rest of enterCall once the count is known; opcode only tells a method call
/// (with its receiver below the function) from the others. The caller already saw
/// callsBytecode, so the class test is skipped. The operands are read before the
/// interrupt counter is charged: that store could alias the machine, and loads after
/// it would be reloaded from memory.
@inlineAlways
unsafe fn enterCallWith<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8, count: usize, width: usize, handOff: bool) -> ?*mut Machine {
  // Pointers only: bytecode never calls with fewer operands than it names.
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let function = unsafe Pointer.read<ValueBits>(unsafe operandCell(data, 1))
  let mut receiver = ValueBits.Undefined let mut first = unsafe operandCell(data, 1)
  if opcode == op.OP_call_method {
    // A lazy arguments slot's stand-in goes to callInline, which builds the object.
    if (unsafe machine.top(1)).tag() == 4 { return Pointer.null<Machine>() }
    first = unsafe operandCell(data, 2)
    receiver = unsafe Pointer.read<ValueBits>(first)
  }
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  if !function.isObject() {
    if opcode == op.OP_call_method { return Pointer.null<Machine>() }
    return match function {
      ValueBits.FunctionBytecode { reference } => unsafe enterKnownCall(&mut hooks, &mut machine, reference, count, width)
      _ => Pointer.null<Machine>()
    }
  }
  // A leaf callee runs without a frame (js_vm_leaf); a declined run changed nothing.
  // A leaf cannot loop or recurse (forward branches, one nesting level), so it
  // is not charged to the interrupt counter, and runs before that store.
  let callee = unsafe activation.calleeOf(function)
  if unsafe leaves.runsLeaf(callee.bytecode, count) {
    // A method call's receiver is its first operand; others pass undefined.
    let mut absent = ValueBits.Undefined let mut receiverCell = Pointer.fromMutRef<ValueBits>(&mut absent)
    if opcode == op.OP_call_method { receiverCell = first }
    if unsafe leaves.attempt(&mut hooks, running, function, callee.bytecode, argv, first, receiverCell) { unsafe machine.skip(width) return running }
    unsafe leaves.miss(machine.runtime, callee.bytecode)
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return Pointer.null<Machine>() }
  // Charged up front so left is dead across the frame setup; refunded on a miss.
  unsafe Pointer.write<i32>(counter, left - 1)
  unsafe machine.skip(width)
  unsafe machine.publishFramePc()
  let entered = unsafe activation.enterDecoded(machine.runtime, function, callee, argv, first, running, machine.context, receiver,
    ValueBits.Undefined, false, false)
  match entered {
    Option<*mut Machine>.Some { value } => { return value }
    Option<*mut Machine>.None => {
      unsafe machine.skip(usize.wrappingSubtract(0, width))
      unsafe refund(counter)
      // Refused: no room, a stub, or linked to machine code (frameCells is the stub sentinel
      // then). Everything is decoded again out of line so the entered path keeps its registers.
      return unsafe linkedCall(&mut hooks, &mut machine, opcode, count, width, handOff)
    }
  }
}
/// enterCallWith's refusal of a closure: when it is linked to machine code, the
/// call runs it (enterCompiled), charged and past the call's width as an entry is;
/// otherwise null with nothing changed.
@inlineNever
unsafe fn linkedCall<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, opcode: u8, count: usize, width: usize, handOff: bool) -> ?*mut Machine {
  let function = unsafe machine.top(count + 1)
  let callee = unsafe activation.calleeOf(function)
  let index = unsafe compiledIndex(callee.bytecode)
  if index == 0 { return Pointer.null<Machine>() }
  let callWords = unsafe compiled.callWords(machine.runtime, index)
  // Code that makes calls runs on the activation stack; a run that leaves needs callInline's
  // hooks, so only a caller that goes on to callInline (handOff) may start one here.
  if callWords != 0 && (!handOff || callWords == u32.toUsize(OSR_ONLY_CALL_WORDS)) { return Pointer.null<Machine>() }
  let mut receiver = ValueBits.Undefined let mut extra: usize = 1
  if opcode == op.OP_call_method { receiver = unsafe machine.top(count + 2) extra = 2 }
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, extra)
  let counter = unsafe interrupts.counter(machine.context)
  if callWords != 0 {
    // Charged as any call is (enterCallWith refunded it): a free call would still take every
    // poll due when the counter reaches it at 1, so a loop calling it never polls on its back
    // edge, where OSR enters.
    unsafe Pointer.write<i32>(counter, unsafe Pointer.read<i32>(counter) - 1)
    let started = unsafe startActivation(&mut hooks, &mut machine, function, callee.bytecode, index, receiver, argv, first, width)
    // Null and nothing handed off: not started, and callInline charges the call.
    if Pointer.isNull<Machine>(started) && !unsafe handedOff(machine.runtime) { unsafe refund(counter) }
    return started
  }
  unsafe Pointer.write<i32>(counter, unsafe Pointer.read<i32>(counter) - 1)
  unsafe machine.skip(width)
  unsafe machine.publishPc()
  return unsafe enterCompiled(&mut hooks, &mut machine, function, callee, argv, first, receiver, index, counter, width)
}
/// linkedCall for code that makes calls: runs it on the activation stack from the caller's
/// operand cells. A return replaces the operands from first with the result (the caller
/// continues, past the call); a run that leaves is handed to the callInline that follows
/// (CompiledTable.handedOff), with machine as it was. Null with nothing changed when the
/// stack has no room or instructions are observed.
@inlineNever
unsafe fn startActivation<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, function: ValueBits, bytecode: *mut HeapHeader, index: u32,
  receiver: ValueBits, argv: FrameSlots, first: *mut ValueBits, width: usize) -> ?*mut Machine {
  let anchor = ()
  if (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)).observeInstructions { return Pointer.null<Machine>() }
  let captures = unsafe activation.capturesOf(function, bytecode, Pointer.fromRef<Machine>(&machine), false)
  let pushed = unsafe pushActivation(machine.runtime, unsafe compiled.entryAt(machine.runtime, index), function, bytecode, index, receiver, argv, captures, 0, Pointer.null<Activation>(), false)
  let root = match Pointer.nonNullMut<Activation>(pushed) { Option<*mut Activation>.Some { value } => value _ => { return Pointer.null<Machine>() } }
  // The code may run getters that read the caller's pc, as callInline would have set it.
  unsafe machine.skip(width)
  unsafe machine.publishPc()
  let exit = unsafe runActivation(root)
  let mut rootAnchor = () let ran = unsafe Pointer.borrowMut<(), Activation>(&mut rootAnchor, root)
  if exit == compiled.EXIT_RETURNED {
    let value = unsafe compiled.result(ran.state)
    unsafe popActivation(machine.runtime, &ran)
    drop ran
    unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(value)
    return Pointer.fromMutRef<Machine>(&mut machine)
  }
  ran.exit = exit
  drop ran
  unsafe machine.skip(usize.wrappingSubtract(0, width))
  let mut stateAnchor = () let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, machine.runtime)
  state.compiled.handedOff = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut Activation, *mut u8>(root))
  return Pointer.null<Machine>()
}
/// enterCallWith for a callee linked to machine code as index (the caller's ip
/// already past the call's width, the counter charged): the code runs on the
/// operand cells with no frame. A return replaces the operands from first with
/// the result and continues the caller; a deopt or poll exit continues the run in
/// an inline frame restored from the exit state. Returns null with the caller as
/// it was (ip back, counter refunded) when the code is skipped: observed
/// instructions, or no room for the frame a deopt would need.
@inlineNever
unsafe fn enterCompiled<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, function: ValueBits, callee: activation.Callee, argv: FrameSlots,
  first: *mut ValueBits, receiver: ValueBits, index: u32, counter: *mut i32, width: usize) -> ?*mut Machine {
  let anchor = ()
  let runtime = machine.runtime
  let frameCells = unsafe compiled.linkedFrameCells(runtime, index)
  if (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).observeInstructions || unsafe compiled.callWords(runtime, index) != 0
    || !unsafe activation.linkedRoom(runtime, callee.bytecode, argv.count, frameCells) {
    unsafe machine.skip(usize.wrappingSubtract(0, width))
    unsafe refund(counter)
    return Pointer.null<Machine>()
  }
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, callee.bytecode)
  let words = compiled.stateWords(u16.toUsize(code.variableCount) + compiled.argumentRoom(code.argumentCount, code.borrowsArguments), u16.toUsize(code.stackSize))
  let realm = code.realm
  drop code
  let state = unsafe Intrinsic.pointerRequalify<[*]mut u64, *mut u64>(unsafe Intrinsic.stackAllocate<u64>(words))
  let frame = unsafe compiledFrame(&machine, function, callee.bytecode, realm, &receiver, !function.isObject())
  let exit = unsafe compiled.runCode(index, &frame, argv.data, argv.count, state)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  if exit == compiled.EXIT_RETURNED {
    let value = unsafe compiled.result(state)
    unsafe releaseOperandsFrom(&mut hooks, &mut machine, first)
    unsafe machine.push(value)
    return running
  }
  let entered = unsafe activation.enterResumed(runtime, function, callee, argv, first, running, machine.context, receiver, frameCells, !function.isObject())
  match entered {
    Option<*mut Machine>.Some { value: resumed } => {
      let mut resumedAnchor = () let frame = unsafe Pointer.borrowMut<(), Machine>(&mut resumedAnchor, resumed)
      unsafe compiled.restore(&mut frame, index, exit, state)
      return resumed
    }
    Option<*mut Machine>.None => invariant()
  }
}
/// Leaf path for enterKnownCall, out of line so the common non-leaf path keeps
/// Outer<H>, knownContext, and leaves.miss off its stack frame and registers.
@inlineNever
unsafe fn enterKnownLeaf<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, bytecode: *mut HeapHeader, count: usize, width: usize) -> bool {
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 1)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let emptyRefs = unsafe Intrinsic.pointerRequalify<*mut ?*mut HeapHeader, *const ?*mut HeapHeader>(unsafe Intrinsic.pointerReinterpret<*mut Machine, *mut ?*mut HeapHeader>(running))
  let leafKnown = unsafe activation.knownContext(bytecode, unsafe Intrinsic.pointerRequalify<*mut Machine, *const Machine>(running), emptyRefs)
  if unsafe leaves.attemptKnown(&mut hooks, running, bytecode, leafKnown.references, leafKnown.scope, argv, first) {
    unsafe machine.skip(width)
    return true
  }
  unsafe leaves.miss(machine.runtime, bytecode)
  return false
}
/// enterCallWith for a known local function (calleeIsBytecode): out of line, so
/// closure calls inline none of it. Takes 5 register arguments (no stack args,
/// no ValueBits tag check) and resolves knownContext at most once.
@inlineNever
unsafe fn enterKnownCall<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, bytecode: *mut HeapHeader, count: usize, width: usize) -> ?*mut Machine {
  if unsafe leaves.runsKnownLeaf(bytecode, count) {
    if unsafe enterKnownLeaf(&mut hooks, &mut machine, bytecode, count, width) {
      return Pointer.fromMutRef<Machine>(&mut machine)
    }
  }
  let counter = unsafe interrupts.counter(machine.context)
  let left = unsafe Pointer.read<i32>(counter)
  if left <= 1 { return Pointer.null<Machine>() }
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 1)
  let entered = unsafe activation.enterKnownFrame(Pointer.fromMutRef<Machine>(&mut machine), bytecode, argv, first, width, counter, left)
  if !Pointer.isNull<Machine>(entered) { return entered }
  let index = unsafe compiledIndex(bytecode)
  if index != 0 {
    unsafe Pointer.write<i32>(counter, left - 1)
    unsafe machine.skip(width)
    unsafe machine.publishFramePc()
    // A known function has no closure object: enterResumed uses callee.bytecode only.
    let callee = activation.Callee { bytecode: bytecode, closureReferences: Pointer.null<?*mut HeapHeader>(), scope: Pointer.null<HeapHeader>() }
    return unsafe enterCompiled(&mut hooks, &mut machine, ValueBits.FunctionBytecode { reference: bytecode }, callee, argv, first, ValueBits.Undefined, index, counter, width)
  }
  return Pointer.null<Machine>()
}
/// get_field, get_loc_field8 or get_arg_field8 (ip at the atom, width bytes of
/// operands) of an accessor with a function getter. A bytecode getter runs as
/// `push getter; call_method 0` would, so it gets an inline frame (or runs as a
/// leaf); a native one is called directly. Either way the generic lookup and
/// call layers are skipped. cell holds the object; owned says it is already the
/// top operand (get_field), else a retained copy is pushed. Returns the machine
/// to run next (machine itself once the value is pushed), or null with the
/// machine as it was.
@cold
unsafe effect fn readTypedViewGetter<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, cell: *mut ValueBits, object: *mut HeapHeader, owned: bool, width: usize) -> ?*mut Machine ! JsException ? &mut Allocator {
  if restricted.active(unsafe lendRealm(&machine, machine.context)) { return Pointer.null<Machine>() }
  let method = unsafe properties.typedViewGetter(machine.runtime, object, unsafe properties.fieldAtomAt(machine.ip))
  if method == u32.MAX { return Pointer.null<Machine>() }
  unsafe machine.skip(width)
  unsafe machine.publishPc()
  let receiver = unsafe Pointer.read<ValueBits>(cell)
  let value = run typedBuffer.getter(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context), method, unsafe lendBits(&receiver, receiver))
  if owned { let old = unsafe machine.pop() unsafe machine.push(value) unsafe gc.release(&mut hooks, machine.runtime, old) }
  else { unsafe machine.push(value) }
  return Pointer.fromMutRef<Machine>(&mut machine)
}
@inlineNever
unsafe effect fn readNativeGetter<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, cell: *mut ValueBits, getter: *mut HeapHeader, owned: bool, width: usize) -> *mut Machine ! JsException ? &mut Allocator {
  let function = ValueBits.Object { reference: getter }
  unsafe machine.skip(width)
  // Map and Set size, the getters read most, need no call.
  let size = unsafe invoke.collectionSize(getter, unsafe Pointer.read<ValueBits>(cell))
  if size >= 0 {
    let value = if size <= 2147483647 { ValueBits.Int { value: i64.toI32(size) } } else { ValueBits.Float64 { value: i64.toF64(size) } }
    if owned {
      let old = unsafe machine.top(1)
      unsafe machine.set(1, value)
      unsafe releaseStackValueCold(&mut hooks, machine.runtime, old)
    } else { unsafe machine.push(value) }
    return Pointer.fromMutRef<Machine>(&mut machine)
  }
  // A Buffer's length, byteLength, byteOffset and buffer, read from the view.
  let typed = unsafe invoke.typedArrayMethod(function)
  if typed != u32.MAX {
    let receiverValue = unsafe Pointer.read<ValueBits>(cell)
    let value = typedBuffers.quickGetter(typed, unsafe lendBits(&receiverValue, receiverValue))
    match value {
      ValueBits.Uninitialized => ()
      _ => {
        if owned {
          let old = unsafe machine.top(1)
          unsafe machine.set(1, value)
          unsafe releaseStackValueCold(&mut hooks, machine.runtime, old)
        } else { unsafe machine.push(value) }
        return Pointer.fromMutRef<Machine>(&mut machine)
      }
    }
  }
  unsafe machine.publishPc()
  unsafe HeapCell.retain(getter)
  let receiver = unsafe Pointer.read<ValueBits>(cell)
  let none = FrameSlots { data: machine.stackTop, count: 0 }
  let called = run Intrinsic.catchFailure<JsException>(unsafe callClass(&mut hooks, memory, machine.context, function, receiver, &none, 0), failedJs)
  unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, getter)
  let value = match move called {
    ValueBits value => value
    FailedJs { error } => { fail move error }
  }
  if owned { let old = unsafe machine.pop() unsafe machine.push(value) unsafe gc.release(&mut hooks, machine.runtime, old) }
  else { unsafe machine.push(value) }
  return Pointer.fromMutRef<Machine>(&mut machine)
}
@inlineNever
unsafe fn readBytecodeGetter<H: HeapHooks>(hooks: &mut H, machine: &mut Machine,
  cell: *mut ValueBits, object: *mut HeapHeader, getter: *mut HeapHeader, owned: bool, width: usize) -> ?*mut Machine {
  let function = ValueBits.Object { reference: getter }
  if !owned { unsafe machine.push(unsafe receiverCopy(cell)) }
  unsafe HeapCell.retain(getter)
  unsafe machine.push(function)
  let entered = unsafe enterCallWith(&mut hooks, &mut machine, op.OP_call_method, 0, width, false)
  if Pointer.isNull<Machine>(entered) {
    unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, getter) drop unsafe machine.pop()
    if !owned { unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, object) drop unsafe machine.pop() }
  }
  return entered
}
@inlineNever
unsafe effect fn readGetter<H: HeapHooks + CoercionHooks + OwnPropertyHooks + PropertyWriteHooks + NativeFunctionHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, cell: *mut ValueBits, owned: bool, width: usize) -> ?*mut Machine ! JsException ? &mut Allocator {
  let object = match unsafe Pointer.read<ValueBits>(cell) { ValueBits.Object { reference } => reference _ => { return Pointer.null<Machine>() } }
  let anchor = ()
  let viewClass = (unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)).classId()
  if viewClass >= classes.JS_CLASS_UINT8C_ARRAY && viewClass <= classes.JS_CLASS_FLOAT64_ARRAY {
    let answered = run unsafe readTypedViewGetter(&mut hooks, memory, &mut machine, cell, object, owned, width)
    if !Pointer.isNull<Machine>(answered) { return answered }
  }
  let getter = match Pointer.nonNullMut<HeapHeader>(unsafe properties.resolveGetter(machine.runtime, machine.ip, object)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<Machine>() }
  }
  // A side-effect-free evaluation refuses getters on the generic path.
  if restricted.active(unsafe lendRealm(&machine, machine.context)) { return Pointer.null<Machine>() }
  let getterData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, getter)
  let getterClass = getterData.classId()
  if getterClass == classes.JS_CLASS_BYTECODE_FUNCTION {
    let bytecode = match &getterData.payload {
      ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode
      _ => { drop getterData return unsafe readBytecodeGetter(&mut hooks, &mut machine, cell, object, getter, owned, width) }
    }
    drop getterData
    if unsafe leaves.runsLeaf(bytecode, 0) {
      let mut result = ValueBits.Undefined
      if unsafe leaves.attemptGetter(machine.runtime, machine.frame, getter, bytecode, cell, Pointer.fromMutRef<ValueBits>(&mut result)) {
        let answer = unsafe result.retained()
        unsafe machine.skip(width)
        if owned {
          unsafe machine.set(1, answer)
          unsafe releaseHeaderCold(&mut hooks, machine.runtime, object)
        } else {
          unsafe machine.push(answer)
        }
        return Pointer.fromMutRef<Machine>(&mut machine)
      }
    }
    return unsafe readBytecodeGetter(&mut hooks, &mut machine, cell, object, getter, owned, width)
  }
  drop getterData
  if getterClass == classes.JS_CLASS_C_FUNCTION {
    return run unsafe readNativeGetter(&mut hooks, memory, &mut machine, cell, getter, owned, width)
  }
  return unsafe readBytecodeGetter(&mut hooks, &mut machine, cell, object, getter, owned, width)
}
/// put_field (ip at the atom) of an accessor with a bytecode setter: the setter
/// runs as `call_method 1` would, in an inline frame tagged to drop its result
/// (or as a leaf), so the generic lookup and the nested dispatch loop are
/// skipped. Returns the machine to run next (machine itself once a leaf ran),
/// or null with the machine as it was.
@inlineNever
unsafe fn writeSetter<H: HeapHooks>(hooks: &mut H, machine: &mut Machine) -> ?*mut Machine {
  let object = match unsafe machine.top(2) { ValueBits.Object { reference } => reference _ => { return Pointer.null<Machine>() } }
  let setter = match Pointer.nonNullMut<HeapHeader>(unsafe properties.resolveSetter(machine.runtime, machine.ip, object)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<Machine>() }
  }
  // A side-effect-free evaluation refuses setters on the generic path.
  if restricted.active(unsafe lendRealm(&machine, machine.context)) { return Pointer.null<Machine>() }
  // object value -> object setter value: call_method's operands.
  unsafe HeapCell.retain(setter)
  let value = unsafe machine.pop()
  unsafe machine.push(ValueBits.Object { reference: setter })
  unsafe machine.push(value)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let entered = unsafe enterCallWith(&mut hooks, &mut machine, op.OP_call_method, 1, properties.FIELD_OPERAND_BYTES, false)
  match Pointer.nonNullMut<Machine>(entered) {
    Option<*mut Machine>.Some { value: next } => {
      if Pointer.address<Machine>(next) == Pointer.address<Machine>(running) {
        // A leaf ran and pushed its result.
        let result = unsafe machine.pop()
        unsafe gc.release(&mut hooks, machine.runtime, result)
      } else { unsafe activation.markDiscarding(next) }
    }
    Option<*mut Machine>.None => {
      drop unsafe machine.pop() drop unsafe machine.pop()
      unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, setter)
      unsafe machine.push(value)
    }
  }
  return entered
}
@inlineAlways
unsafe fn receiverCopy(cell: *mut ValueBits) -> ValueBits { return unsafe (unsafe Pointer.read<ValueBits>(cell)).retained() }
struct FailedJs { error: JsException }
effect fn failedJs(error: JsException) -> FailedJs { return FailedJs { error: move error } }
/// Whether a run linkedCall started left, for callInline to continue (CompiledTable.handedOff).
unsafe fn handedOff(runtime: *mut HeapHeader) -> bool {
  let anchor = ()
  return !Pointer.isNull<u8>((unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)).compiled.handedOff)
}
@inlineAlways
unsafe fn refund(counter: *mut i32) -> () { unsafe Pointer.write<i32>(counter, i32.wrappingAdd(unsafe Pointer.read<i32>(counter), 1)) }
/// callInline for a known local function (calleeIsBytecode), first the slot of
/// its function operand: inline when its frame fits, else a base frame.
@inlineNever
unsafe effect fn callInlineKnown<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, function: ValueBits, argv: FrameSlots, first: usize) -> *mut Machine ! JsException ? &mut Allocator {
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let bytecode = match function { ValueBits.FunctionBytecode { reference } => reference _ => invariant() }
  // Linked to baseline code (js_baseline): it runs on the operand cells, in the scope an
  // inline frame of it would get.
  let linked = unsafe baselineIndex(bytecode)
  if linked != 0 && unsafe baselineOpen(machine.runtime) {
    let emptyRefs = unsafe Intrinsic.pointerRequalify<*mut ?*mut HeapHeader, *const ?*mut HeapHeader>(unsafe Intrinsic.pointerReinterpret<*mut Machine, *mut ?*mut HeapHeader>(running))
    let known = unsafe activation.knownContext(bytecode, unsafe Intrinsic.pointerRequalify<*mut Machine, *const Machine>(running), emptyRefs)
    let mut value = ValueBits.Undefined
    let host = unsafe Intrinsic.pointerReinterpret<*mut H, *mut u8>(Pointer.fromMutRef<H>(&mut hooks))
    if unsafe enterBaselineKnown(machine.runtime, host, bytecode, known.scope, argv, Pointer.fromMutRef<ValueBits>(&mut value), linked) != 0 { fail JsException {} }
    unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(value)
    return running
  }
  let entered = unsafe activation.enterKnown(machine.runtime, function, argv, unsafe machine.slot(first), running, machine.context)
  match entered { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
  let index = unsafe compiledIndex(bytecode)
  if index != 0 && run unsafe callCompiled(&mut hooks, memory, &mut machine, function, bytecode, index, ValueBits.Undefined, argv, first, true) {
    return running
  }
  let result = run unsafe callKnown(&mut hooks, memory, &machine, function, &argv, compiled.fresh())
  unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(result)
  return running
}
/// What compiled code for function (bytecode, realm) runs with when the caller runs it
/// without a frame: the closure's captures (or a known function's, from caller) and
/// receiver, borrowed for the call.
unsafe fn compiledFrame(caller: &Machine, function: ValueBits, bytecode: *mut HeapHeader, realm: *mut HeapHeader, receiver: &ValueBits,
  known: bool) -> compiled.CompiledFrame {
  let captures = unsafe activation.capturesOf(function, bytecode, Pointer.fromRef<Machine>(&caller), known)
  let anchor = ()
  let start = unsafe (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)).code.start()
  return compiled.CompiledFrame { thisValue: Pointer.fromRef<ValueBits>(&receiver), bytecode: bytecode, context: realm,
    runtime: caller.runtime, closureReferences: captures.references, scope: captures.scope,
    calls: Pointer.null<u64>(), code: start, activation: Pointer.null<u8>() }
}
/// FunctionBytecode.compiled of bytecode: nonzero when it is linked to machine code.
@inlineAlways
unsafe fn compiledIndex(bytecode: *mut HeapHeader) -> u32 {
  let anchor = () return (unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)).compiled
}
/// A call made in the dispatch loop to function (a bytecode closure, or a known
/// local function when known), linked to machine code as index, with arguments
/// argv among the operands from first: the code runs on the operand cells
/// with no interpreter frame. Only a deopt or poll exit builds one, a base frame
/// that continues from the exit's state (callResuming, callKnown). True once the
/// operands from first are replaced by the result; false with nothing changed
/// when compiled code is skipped (observed instructions).
@inlineNever
unsafe effect fn callCompiled<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, function: ValueBits, bytecode: *mut HeapHeader, index: u32, receiver: ValueBits,
  argv: FrameSlots, first: usize, known: bool) -> bool ! JsException ? &mut Allocator {
  let anchor = ()
  if (unsafe HeapCell.payload<RuntimeState, ()>(&anchor, machine.runtime)).observeInstructions { return false }
  if unsafe compiled.callWords(machine.runtime, index) != 0 {
    // Code that makes calls runs on the activation stack, still without a frame.
    let captures = unsafe activation.capturesOf(function, bytecode, Pointer.fromRef<Machine>(&machine), known)
    let pushed = unsafe pushActivation(machine.runtime, unsafe compiled.entryAt(machine.runtime, index), function, bytecode, index, receiver, argv, captures, 0, Pointer.null<Activation>(), known)
    let root = match Pointer.nonNullMut<Activation>(pushed) { Option<*mut Activation>.Some { value } => value _ => { return false } }
    // Run it here; only a run that leaves needs the runner.
    let exit = unsafe runActivation(root)
    let mut rootAnchor = () let ran = unsafe Pointer.borrowMut<(), Activation>(&mut rootAnchor, root)
    let mut value = ValueBits.Undefined
    if exit == compiled.EXIT_RETURNED {
      value = unsafe compiled.result(ran.state)
      unsafe popActivation(machine.runtime, &ran)
    } else {
      ran.exit = exit
      drop ran
      value = run unsafe runActivations(&mut hooks, memory, Pointer.fromMutRef<Machine>(&mut machine), machine.context, root)
    }
    unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(value)
    return true
  }
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let words = compiled.stateWords(u16.toUsize(code.variableCount) + compiled.argumentRoom(code.argumentCount, code.borrowsArguments), u16.toUsize(code.stackSize))
  let realm = code.realm
  drop code
  let state = unsafe Intrinsic.pointerRequalify<[*]mut u64, *mut u64>(unsafe Intrinsic.stackAllocate<u64>(words))
  let frame = unsafe compiledFrame(&machine, function, bytecode, realm, &receiver, known)
  let exit = unsafe compiled.runCode(index, &frame, argv.data, argv.count, state)
  let mut value = ValueBits.Undefined
  if exit == compiled.EXIT_RETURNED { value = unsafe compiled.result(state) }
  else {
    let resume = compiled.Resume { state: state, exit: exit, index: index }
    if known { value = run unsafe callKnown(&mut hooks, memory, &machine, function, &argv, resume) }
    else { value = run unsafe callResuming(&mut hooks, memory, machine.context, function, receiver, ValueBits.Undefined, &argv, 0, resume) }
  }
  unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(value)
  return true
}
/// A target the inline paths of apply, Reflect.apply, call and a lazy arguments apply could
/// not enter because it is linked to compiled code (its frame size is the stub's): called
/// natively on copies of argv instead of through the native method, so a compiled callee keeps
/// its callers on their fast path. The operands from first become the result. False, with
/// nothing changed, for any other target.
@inlineNever
unsafe effect fn callLinked<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, target: ValueBits, receiver: ValueBits, argv: FrameSlots, first: usize) -> bool
  ! JsException ? &mut Allocator {
  if !target.isObject() || unsafe classId(target) != classes.JS_CLASS_BYTECODE_FUNCTION { return false }
  if unsafe compiledIndex((unsafe activation.calleeOf(target)).bytecode) == 0 { return false }
  let result = run unsafe callFromCompiled(&mut hooks, memory, machine.runtime, machine.context, target, receiver, argv)
  unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(result)
  return true
}
/// A call to a plain bytecode function (callsBytecode) made inside the running
/// dispatch loop: the callee's frame and machine go on the runtime's call-frame
/// region and dispatch continues there until returnInline. Returns the machine to
/// run next: the callee's, or machine itself once a full region made the call natively.
@inlineNever
unsafe effect fn callInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> *mut Machine ! JsException ? &mut Allocator {
  let count = unsafe callCount(&machine, opcode)
  unsafe census.censusBump(machine.runtime, census.CENSUS_CALLS, 1)
  let mut width: usize = 0
  if opcode == op.OP_call || opcode == op.OP_call_method { width = 2 }
  let function = unsafe machine.top(count + 1)
  unsafe machine.skip(width)
  unsafe machine.publishPc()
  let mut receiver = ValueBits.Undefined let mut extra: usize = 1
  if opcode == op.OP_call_method { receiver = unsafe machine.top(count + 2) extra = 2 }
  let start = machine.sp() - count
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  // linkedCall already ran this call's callee, which left: continue it.
  let mut tableAnchor = () let table = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut tableAnchor, machine.runtime)
  if let Option<*mut u8>.Some { value: handed } = Pointer.nonNullMut<u8>(table.compiled.handedOff) {
    table.compiled.handedOff = Pointer.null<u8>()
    drop table
    let root = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Activation>(handed)
    let value = run unsafe runActivations(&mut hooks, memory, Pointer.fromMutRef<Machine>(&mut machine), machine.context, root)
    unsafe releaseOperands(&mut hooks, &mut machine, start - extra) unsafe machine.push(value)
    return running
  }
  drop table
  if interrupts.due(unsafe lendRealm(&machine.context, machine.context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&machine.context, machine.context)) }
  let argv = FrameSlots { data: unsafe machine.slot(start), count: count }
  if function.tag() == -2 { return run unsafe callInlineKnown(&mut hooks, memory, &mut machine, function, argv, start - extra) }
  if function.isObject() && unsafe classId(function) == classes.JS_CLASS_BYTECODE_FUNCTION {
    // A closure linked to code that makes calls (linkedCall left it here) runs at once.
    let callee = unsafe activation.calleeOf(function)
    let index = unsafe compiledIndex(callee.bytecode)
    if index != 0 && run unsafe callCompiled(&mut hooks, memory, &mut machine, function, callee.bytecode, index, receiver, argv, start - extra, false) {
      return running
    }
  }
  if opcode == op.OP_call_method && count == 2 && (unsafe argv.get(1)).tag() == 4 {
    let slot = unsafe factories.lazyArgumentsSlot(&machine)
    if slot != usize.MAX {
      // f.apply(x, arguments) in a function with a lazy arguments slot: f runs
      // inline on copies of this frame's own arguments, else the object is
      // built now and stored in the slot for any later use.
      if unsafe invoke.isApply(function) && receiver.isObject() && unsafe classId(receiver) == classes.JS_CLASS_BYTECODE_FUNCTION {
        let own = unsafe Pointer.read<FrameSlots>(unsafe activation.originalArgumentsOf(&machine))
        let entered = unsafe activation.enterInline(machine.runtime, receiver, own, unsafe machine.slot(start - extra), running,
          machine.context, unsafe argv.get(0), ValueBits.Undefined, false, true)
        match entered { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
        if run unsafe callLinked(&mut hooks, memory, &mut machine, receiver, unsafe argv.get(0), own, start - extra) { return running }
      }
      let built = run Effect.result(unsafe factories.lazyArguments(&mut hooks, memory, &machine))
      let object = match move built {
        Result<ValueBits, OutOfMemoryError>.Success { value } => value
        Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error)
      }
      unsafe Pointer.write<ValueBits>(unsafe cellAt(machine.locals, slot), unsafe object.retained())
      unsafe Pointer.write<ValueBits>(unsafe cellAt(argv.data, 1), object)
    }
    let result = run unsafe callFromBytecode(&mut hooks, memory, machine.context, function, receiver, &argv)
    unsafe releaseOperands(&mut hooks, &mut machine, start - extra) unsafe machine.push(result)
    return running
  }
  if unsafe invoke.isApply(function) {
    // target.apply(thisArg, array) (appliesInline): target runs inline on the
    // frame's own copies of array's elements, skipping apply's argument list.
    let buffer = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(APPLY_INLINE_ARGUMENTS))
    match unsafe invoke.denseArguments(unsafe argv.get(1), buffer, APPLY_INLINE_ARGUMENTS) {
      Option<usize>.Some { value: applied } => {
        let operand = unsafe machine.slot(start - extra)
        let copied = run unsafe enterAny(&mut machine, receiver, unsafe argv.get(0), FrameSlots { data: buffer, count: applied }, operand, true)
        if !Pointer.isNull<Machine>(copied) { return unsafe Intrinsic.pointerRequalify<?*mut Machine, *mut Machine>(copied) }
        if run unsafe callLinked(&mut hooks, memory, &mut machine, receiver, unsafe argv.get(0), FrameSlots { data: buffer, count: applied }, start - extra) { return running }
      }
      Option<usize>.None => ()
    }
  } else if count == 3 && unsafe invoke.isReflectApply(function) {
    // Reflect.apply(target, thisArg, array) (appliesInline), as target.apply above.
    let buffer = unsafe Intrinsic.pointerRequalify<[*]mut ValueBits, *mut ValueBits>(unsafe Intrinsic.stackAllocate<ValueBits>(APPLY_INLINE_ARGUMENTS))
    match unsafe invoke.denseArguments(unsafe argv.get(2), buffer, APPLY_INLINE_ARGUMENTS) {
      Option<usize>.Some { value: applied } => {
        let operand = unsafe machine.slot(start - extra)
        let copied = run unsafe enterAny(&mut machine, unsafe argv.get(0), unsafe argv.get(1), FrameSlots { data: buffer, count: applied }, operand, true)
        if !Pointer.isNull<Machine>(copied) { return unsafe Intrinsic.pointerRequalify<?*mut Machine, *mut Machine>(copied) }
        if run unsafe callLinked(&mut hooks, memory, &mut machine, unsafe argv.get(0), unsafe argv.get(1), FrameSlots { data: buffer, count: applied }, start - extra) { return running }
      }
      Option<usize>.None => ()
    }
  } else if count != 0 && unsafe invoke.isCall(function) {
    // target.call(thisArg, ...args) (appliesInline): target runs inline on the
    // operands after thisArg, which stays in place until the call returns.
    let forwarded = FrameSlots { data: unsafe operandCell(argv.data, usize.wrappingSubtract(0, 1)), count: count - 1 }
    let operand = unsafe machine.slot(start - extra)
    let called = run unsafe enterAny(&mut machine, receiver, unsafe argv.get(0), forwarded, operand, false)
    if !Pointer.isNull<Machine>(called) { return unsafe Intrinsic.pointerRequalify<?*mut Machine, *mut Machine>(called) }
    if run unsafe callLinked(&mut hooks, memory, &mut machine, receiver, unsafe argv.get(0), forwarded, start - extra) { return running }
  } else {
    if function.isObject() && unsafe classId(function) == classes.JS_CLASS_BYTECODE_FUNCTION {
      let callee = unsafe activation.calleeOf(function)
      // Linked to baseline code (js_baseline): it runs on the operand cells, on its own frame.
      let linked = unsafe baselineIndex(callee.bytecode)
      if linked != 0 && unsafe baselineOpen(machine.runtime) {
        let mut value = ValueBits.Undefined
        let host = unsafe Intrinsic.pointerReinterpret<*mut H, *mut u8>(Pointer.fromMutRef<H>(&mut hooks))
        if unsafe enterBaseline(machine.runtime, host, function, receiver, argv, Pointer.fromMutRef<ValueBits>(&mut value), linked, false) != 0 { fail JsException {} }
        unsafe releaseOperands(&mut hooks, &mut machine, start - extra) unsafe machine.push(value)
        return running
      }
      let index = unsafe compiledIndex(callee.bytecode)
      if index != 0 && run unsafe callCompiled(&mut hooks, memory, &mut machine, function, callee.bytecode, index, receiver, argv, start - extra, false) {
        return running
      }
    }
    let operand = unsafe machine.slot(start - extra)
    let entered = run unsafe enterAny(&mut machine, function, receiver, argv, operand, false)
    if !Pointer.isNull<Machine>(entered) { return unsafe Intrinsic.pointerRequalify<?*mut Machine, *mut Machine>(entered) }
  }
  let result = run unsafe callFromBytecode(&mut hooks, memory, machine.context, function, receiver, &argv)
  unsafe releaseOperands(&mut hooks, &mut machine, start - extra) unsafe machine.push(result)
  return running
}
/// Whether OP_call_constructor at machine constructs with a plain bytecode
/// constructor, the callee constructInline takes.
@inlineAlways
unsafe fn constructsBytecode(machine: &Machine) -> bool {
  let function = unsafe machine.top(unsafe callCount(machine, op.OP_call_constructor) + 2)
  if !function.isObject() { return false }
  if unsafe classId(function) != classes.JS_CLASS_BYTECODE_FUNCTION { return false }
  return boxing.isConstructor(unsafe lendBits(&function, function))
}
/// The fast-construct form of the constructsBytecode callee at machine when it
/// is its own new.target: CONSTRUCT_STORES, CONSTRUCT_FORWARD, or CONSTRUCT_EVAL,
/// or 0 for all other constructs (generic / fields-only / subclass new.target).
@inlineAlways
unsafe fn plannedForm(machine: &Machine) -> u8 {
  let count = u16.toUsize(unsafe machine.peekU16())
  let function = unsafe machine.top(count + 2)
  if !unsafe sameValueBits(function, unsafe machine.top(count + 1)) { return 0 }
  let form = unsafe constructors.formOf(function)
  if form == CONSTRUCT_STORES || form == CONSTRUCT_FORWARD || form == CONSTRUCT_EVAL { return form }
  return 0
}
/// OP_call_constructor fast path for CONSTRUCT_EVAL and CONSTRUCT_FORWARD when
/// receiverCache + constructCache hold a simple plan: runs evaluation.plannedFast
/// without publishPc, pinConstructed, or reloadFrom, and releases operands inline.
/// Returns 1 when completed, 2 when receiverCache has no matching plan (so
/// constructInline can skip constructRecipe), or 0 to retry constructRecipe.
@cold
unsafe fn releaseUnmovedArgs<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, data: *mut ValueBits, count: usize, moved: u32) -> () {
  let operands = unsafe Pointer.assumeManyMut<ValueBits>(data)
  let mut index: usize = 0
  while index < count {
    if index >= 4 || (moved & u32.shiftLeft(1, usize.toU32(index))) == 0 {
      let value = unsafe Pointer.read<ValueBits>(unsafe Pointer.atMut<ValueBits>(operands, index))
      if value.tag() < 0 { unsafe gc.release(&mut hooks, runtime, value) }
    }
    index = usize.wrappingAdd(index, 1)
  }
}
@inlineNever
unsafe effect fn constructRecipeFast<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine, form: u8) -> u8 ? &mut Allocator {
  let context = machine.context
  if interrupts.due(unsafe lendRealm(&context, context)) { return 0 }
  let count = u16.toUsize(unsafe machine.peekU16())
  let function = unsafe machine.top(usize.wrappingAdd(count, 2))
  let owner = core.reference(function)
  let anchor = ()
  let ownerObj = unsafe HeapCell.payload<ObjectData, ()>(&anchor, owner)
  let ownerBytecode = match &ownerObj.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { return 2 } }
  drop ownerObj
  let ownerCode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, ownerBytecode)
  if ownerCode.isDerivedClassConstructor { return 2 }
  let isForward = form == CONSTRUCT_FORWARD
  let mut atom: u32 = 0
  if isForward {
    let bytes = unsafe Pointer.assumeMany<u8>(unsafe ownerCode.code.pointerAt(0))
    atom = u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, 6)))
      | u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, 7))), 8)
      | u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, 8))), 16)
      | u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, 9))), 24)
  }
  drop ownerCode
  let plan = unsafe gc.plannedRecipeTarget(machine.runtime, owner, ownerBytecode, isForward, atom)
  let final = match Pointer.nonNullMut<HeapHeader>(plan.final) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return 2 }
  }
  if isForward && !unsafe invoke.isApply(plan.method) { return 2 }
  let empty = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(plan.empty)
  let targetBytecode = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(plan.bytecode)
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 2)
  let mut moved: u32 = 0
  let planned = run unsafe evaluation.plannedFast(&mut hooks, memory, machine.runtime, final, empty, targetBytecode, plan.stores, plan.tail, plan.recipeSlot, plan.cacheSlot, &argv, &mut moved)
  let plannedNode = match planned { ValueBits.Object { reference } => reference _ => { return 0 } }
  unsafe machine.skip(2)
  if count != 0 && (count > 4 || moved != u32.wrappingSubtract(u32.shiftLeft(1, usize.toU32(count)), 1)) {
    unsafe releaseUnmovedArgs(&mut hooks, machine.runtime, data, count, moved)
  }
  let mut fnAnchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut fnAnchor, owner)
  let fnCount = header.referenceCount
  if fnCount > 2 {
    header.referenceCount = i32.wrappingSubtract(fnCount, 2)
    drop header
    unsafe Pointer.write<ValueBits>(first, ValueBits.Object { reference: plannedNode })
    machine.stackTop = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(first), 1)
    return 1
  }
  drop header
  let _done = unsafe finishConstructRecipeDropSlow(&mut hooks, &mut machine, owner, plannedNode, first)
  return 1
}
@cold
unsafe fn finishConstructRecipeDropSlow<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, owner: *mut HeapHeader, plannedNode: *mut HeapHeader, first: *mut ValueBits) -> bool {
  machine.stackTop = first
  unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, owner)
  unsafe gc.releaseObjectHeader(&mut hooks, machine.runtime, owner)
  unsafe Pointer.write<ValueBits>(first, ValueBits.Object { reference: plannedNode })
  machine.stackTop = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(first), 1)
  return true
}
/// OP_call_constructor for a CONSTRUCT_STORES callee whose receiver cache holds a
/// plan: builds the object from the plan and pushes it. It runs no JS and raises
/// nothing (allocation failure, or no plan, returns false with nothing changed for
/// constructInline to redo), so it publishes no pc, and its small signature keeps
/// constructInline's prologue and spills off the common construct.
@inlineNever
unsafe effect fn constructStores<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine) -> bool ? &mut Allocator {
  let count = u16.toUsize(unsafe machine.peekU16())
  let function = unsafe machine.top(usize.wrappingAdd(count, 2))
  let node = core.reference(function)
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 2)
  let planned = run unsafe constructors.plannedConstructInPlace(&mut hooks, memory, machine.runtime, node, &argv)
  if !planned.isObject() {
    return run unsafe constructStoresFallback(&mut hooks, memory, &mut machine)
  }
  unsafe machine.skip(2)
  let mut fnAnchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut fnAnchor, node)
  let fnCount = header.referenceCount
  if fnCount > 2 {
    header.referenceCount = i32.wrappingSubtract(fnCount, 2)
    drop header
    unsafe Pointer.write<ValueBits>(first, planned)
    machine.stackTop = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(first), 1)
    return true
  }
  drop header
  return unsafe finishConstructStoresDropSlow(&mut hooks, &mut machine, function, planned, first)
}
@inlineNever
unsafe effect fn constructStoresFallback<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine) -> bool ? &mut Allocator {
  let count = u16.toUsize(unsafe machine.peekU16())
  let function = unsafe machine.top(usize.wrappingAdd(count, 2))
  let node = core.reference(function)
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 2)
  let planned = run unsafe constructors.plannedConstructFast(&mut hooks, memory, machine.runtime, node, &argv)
  if !planned.isObject() {
    return run unsafe constructStoresSlow(&mut hooks, memory, &mut machine)
  }
  unsafe machine.skip(2)
  let mut fnAnchor = ()
  let header = unsafe Pointer.borrowMut<(), HeapHeader>(&mut fnAnchor, node)
  let fnCount = header.referenceCount
  if fnCount > 2 {
    header.referenceCount = i32.wrappingSubtract(fnCount, 2)
    drop header
    unsafe Pointer.write<ValueBits>(first, planned)
    machine.stackTop = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(first), 1)
    return true
  }
  drop header
  return unsafe finishConstructStoresDropSlow(&mut hooks, &mut machine, function, planned, first)
}
@inlineNever
unsafe fn finishConstructStoresDropSlow<H: HeapHooks>(hooks: &mut H, machine: &mut Machine, function: ValueBits, planned: ValueBits, first: *mut ValueBits) -> bool {
  machine.stackTop = first
  unsafe gc.release(&mut hooks, machine.runtime, function)
  unsafe gc.release(&mut hooks, machine.runtime, function)
  unsafe Pointer.write<ValueBits>(first, planned)
  machine.stackTop = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(first), 1)
  return true
}
@inlineNever
unsafe effect fn constructStoresSlow<H: HeapHooks>(hooks: &mut H, memory: &AllocationObserver, machine: &mut Machine) -> bool ? &mut Allocator {
  let count = u16.toUsize(unsafe machine.peekU16())
  let function = unsafe machine.top(count + 2)
  let node = core.reference(function)
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 2)
  let context = machine.context
  let mut consumed = false
  let created = run Effect.result(unsafe constructors.plannedConstruct(&mut hooks, memory, unsafe lendRealm(&context, context), node, &argv, &mut consumed))
  let planned = match move created {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => { drop error return false }
  }
  if !planned.isObject() { return false }
  // The pc moves first and the result lands at first with one stack top store:
  // a push right after the releases' stack top store let LLVM fuse the pc and
  // stack top updates into a 16-byte reload of both, which stalls on that store.
  unsafe machine.skip(2)
  // Consumed arguments moved into the object bitwise: drop them unreleased.
  if consumed { unsafe releasePlannedFunction(&mut hooks, &mut machine, function, first) }
  else { unsafe releasePlannedOperands(&mut hooks, &mut machine, function, data, first) }
  unsafe Pointer.write<ValueBits>(first, planned)
  machine.stackTop = unsafe Pointer.atMut<ValueBits>(unsafe Pointer.assumeManyMut<ValueBits>(first), 1)
  return true
}
/// The fusion prefix before a class constructor's field initializer call
/// (get_var_ref_check K, dup, if_false8, get_loc0, swap, call_method 0, drop;
/// machine's ip at the prefix's operand): how far to move on. Past the call
/// when the class has no instance fields (K holds undefined) or when its
/// initializer's constant fields were defined on this here, without a frame
/// (objects.initializeFields); otherwise to the call, which then runs.
@inlineNever
unsafe effect fn fieldsPrefix<H: HeapHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks + CoercionHooks + PropertyWriteHooks + CallHooks + PrototypeHooks + InterruptHooks>(hooks: &mut H, machine: &mut Machine) -> usize ! OutOfMemoryError | JsException ? &mut Allocator {
  // this is a local the call reads with get_loc0..3 or get_loc8, one byte longer.
  let read = unsafe machine.peekU8(FIELDS_PREFIX_SIZE - 1 + 6)
  let mut skipped = FIELDS_PREFIX_SIZE - 1 + FIELDS_INIT_SIZE
  let mut local: usize = 0
  if read >= op.OP_get_loc0 && read <= op.OP_get_loc0 + 3 { local = u8.toUsize(read - op.OP_get_loc0) }
  else if read == op.OP_get_loc8 { local = u8.toUsize(unsafe machine.peekU8(FIELDS_PREFIX_SIZE - 1 + 7)) skipped = skipped + 1 }
  else { return FIELDS_PREFIX_SIZE - 1 }
  // A default constructor's call ends at its return_undef, which took the drop's place.
  if unsafe machine.peekU8(skipped - 1) != op.OP_drop { skipped = skipped - 1 }
  let index = u16.toUsize(unsafe machine.peekU16At(5))
  return match unsafe locals.capturedValue(&machine, machine.scope, index) {
    ValueBits.Undefined => skipped
    ValueBits.Object { reference } => {
      let receiver = unsafe machine.local(local)
      if run unsafe objects.initializeFields(&mut hooks, &mut machine, reference, receiver) { skipped } else { FIELDS_PREFIX_SIZE - 1 }
    }
    _ => FIELDS_PREFIX_SIZE - 1
  }
}
/// constructInline for a derived constructor, which binds this itself (super)
/// and returns it: its construct frame owns no receiver, and its object result
/// stands. Out of line so base-class constructs keep their registers.
@inlineNever
unsafe effect fn constructDerived<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, count: usize) -> *mut Machine ! JsException ? &mut Allocator {
  let function = unsafe machine.top(count + 2) let newTarget = unsafe machine.top(count + 1)
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 2)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let context = machine.context
  if interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
  let entered = unsafe activation.enterInline(machine.runtime, function, argv, first, running, context, ValueBits.Undefined, newTarget, true, false)
  match entered { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
  let result = run unsafe constructInternal(&mut hooks, memory, context, function, newTarget, &argv, 0)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(result)
  return running
}
/// OP_call_constructor for constructsBytecode: a base-class constructor runs in an
/// inline frame that owns the new receiver (see finishInline); a derived one, or
/// any when the region is full, constructs natively. Returns the machine to run next.
@inlineNever
unsafe effect fn constructInline<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, skipRecipe: bool) -> *mut Machine ! JsException ? &mut Allocator {
  let count = u16.toUsize(unsafe machine.readU16())
  let function = unsafe machine.top(usize.wrappingAdd(count, 2)) let newTarget = unsafe machine.top(usize.wrappingAdd(count, 1))
  unsafe machine.publishPc()
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let first = unsafe operandCell(data, 2)
  let running = Pointer.fromMutRef<Machine>(&mut machine)
  let context = machine.context
  let mut realm = context
  if unsafe isDerivedConstructor(function, &mut realm) {
    return run unsafe constructDerived(&mut hooks, memory, &mut machine, count)
  }
  let form = unsafe constructors.formOf(function)
  // A planned store-list constructor is straight-line and never polls;
  // recipes and regular bodies may allocate in loops or call frames without
  // their back edges, so only the paths that may run code poll here.
  let mut polled = false
  if unsafe sameValueBits(function, newTarget) && form != CONSTRUCT_GENERIC {
    let mut planned = ValueBits.Uninitialized
    let mut consumed = false
    if form == CONSTRUCT_STORES { planned = run unsafe constructPlanned(&mut hooks, memory, realm, function, &argv, &mut consumed) }
    else if !skipRecipe {
      if interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
      polled = true
      planned = run unsafe constructRecipe(&mut hooks, memory, realm, machine.runtime, function, form, &argv)
    }
    match planned {
      ValueBits.Object { .. } => {
        // Both plannedConstruct and evaluation.planned get their final shape
        // straight from receiverCache (held until collect), so neither walks
        // intermediate shapes nor needs pinConstructed.
        // Consumed arguments moved into the object bitwise: drop them unreleased.
        if consumed { unsafe releasePlannedFunction(&mut hooks, &mut machine, function, first) }
        else { unsafe releasePlannedOperands(&mut hooks, &mut machine, function, data, first) }
        unsafe machine.push(planned)
        return running
      }
      _ => ()
    }
  }
  if !polled && interrupts.due(unsafe lendRealm(&context, context)) { run interrupts.handle(&mut hooks, memory, unsafe lendRealm(&context, context)) }
  let receiver = run unsafe constructors.createReceiver(&mut hooks, memory, unsafe lendRealm(&realm, realm), newTarget)
  if form == CONSTRUCT_STORES && unsafe constructors.simpleConstruct(&mut hooks, machine.runtime, function, receiver, &argv) {
    match receiver { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, machine.runtime, reference) } _ => () }
    unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(receiver)
    return running
  }
  // A super() call's plan would be noted on the derived class, whose own
  // constructs never follow it.
  if form == CONSTRUCT_EVAL && run unsafe evaluation.constructGrowing(&mut hooks, machine.runtime, core.reference(newTarget), function, receiver, &argv, unsafe sameValueBits(function, newTarget)) {
    match receiver { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, machine.runtime, reference) } _ => () }
    unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(receiver)
    return running
  }
  if form == CONSTRUCT_FORWARD {
    let name = unsafe constructors.forwardedAtom(function)
    // new W(...) for a Class.create wrapper W: this[name] runs as the
    // construct frame itself (see activation.markForwarded).
    let target = unsafe forwardedTarget(machine.runtime, function, receiver, name)
    if target.isObject() && unsafe constructors.formOf(target) == CONSTRUCT_EVAL && run unsafe evaluation.constructGrowing(&mut hooks, machine.runtime, core.reference(newTarget), target, receiver, &argv, true) {
      match receiver { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, machine.runtime, reference) } _ => () }
      unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(receiver)
      return running
    }
    if target.isObject() {
      let forwarded = unsafe activation.enterInline(machine.runtime, target, argv, first, running, context, receiver,
        newTarget, true, false)
      match forwarded { Option<*mut Machine>.Some { value } => { unsafe activation.markForwarded(value) return value } Option<*mut Machine>.None => () }
      // No inline frame: the wrapper's function may be linked to baseline code (its frame
      // cells are the sentinel then, js_baseline.link). A plain call on the receiver, whose
      // result the wrapper drops.
      let linked = unsafe baselineIndex((unsafe activation.calleeOf(target)).bytecode)
      if linked != 0 && unsafe baselineOpen(machine.runtime) {
        let mut value = ValueBits.Undefined
        let host = unsafe Intrinsic.pointerReinterpret<*mut H, *mut u8>(Pointer.fromMutRef<H>(&mut hooks))
        if unsafe enterBaseline(machine.runtime, host, target, receiver, argv, Pointer.fromMutRef<ValueBits>(&mut value), linked, false) != 0 {
          unsafe gc.release(&mut hooks, machine.runtime, receiver)
          fail JsException {}
        }
        unsafe gc.release(&mut hooks, machine.runtime, value)
        unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(receiver)
        return running
      }
    }
  }
  let entered = unsafe activation.enterInline(machine.runtime, function, argv, first, running, context, receiver,
    newTarget, true, false)
  match entered { Option<*mut Machine>.Some { value } => { return value } Option<*mut Machine>.None => () }
  return run unsafe constructInlineFallback(&mut hooks, memory, &mut machine, context, function, receiver, newTarget, &argv, first, running)
}
/// Out-of-line fallback when enterInline declines (call frame region full).
@inlineNever
unsafe effect fn constructInlineFallback<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, context: *mut HeapHeader, function: ValueBits, receiver: ValueBits,
  newTarget: ValueBits, argv: &FrameSlots, first: *mut ValueBits, running: *mut Machine) -> *mut Machine ! JsException ? &mut Allocator {
  let result = run unsafe constructWith(&mut hooks, memory, context, function, receiver, newTarget, &argv, JS_CALL_FLAG_CONSTRUCTOR)
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(result)
  return running
}
/// The function the wrapper body this[name].apply(this, arguments) calls, when
/// both reads find plain data properties, apply is the intrinsic one and the
/// function is a plain bytecode function: Undefined otherwise. Not retained.
unsafe fn forwardedTarget(runtime: *mut HeapHeader, function: ValueBits, receiver: ValueBits, name: u32) -> ValueBits {
  let object = match receiver { ValueBits.Object { reference } => reference _ => { return ValueBits.Undefined } }
  let wrapper = core.reference(function)
  let cached = unsafe constructors.cachedForward(runtime, wrapper, object, name)
  if cached.target.isObject() && unsafe classId(cached.target) == classes.JS_CLASS_BYTECODE_FUNCTION && unsafe invoke.isApply(cached.method) {
    return cached.target
  }
  return unsafe resolveForward(runtime, wrapper, object, name)
}
/// forwardedTarget by full lookups, recording what they found for the next time.
@inlineNever
unsafe fn resolveForward(runtime: *mut HeapHeader, wrapper: *mut HeapHeader, object: *mut HeapHeader, name: u32) -> ValueBits {
  let mut target = ValueBits.Undefined
  if !unsafe properties.lookupField(object, name, Pointer.fromMutRef<ValueBits>(&mut target), false) { return ValueBits.Undefined }
  if !target.isObject() || unsafe classId(target) != classes.JS_CLASS_BYTECODE_FUNCTION { return ValueBits.Undefined }
  let mut method = ValueBits.Undefined
  if !unsafe properties.lookupField(core.reference(target), atoms.JS_ATOM_apply, Pointer.fromMutRef<ValueBits>(&mut method), false) { return ValueBits.Undefined }
  if !unsafe invoke.isApply(method) { return ValueBits.Undefined }
  unsafe constructors.noteForward(runtime, wrapper, object, name, core.reference(target))
  return target
}
@inlineAlways
unsafe fn sameValueBits(left: ValueBits, right: ValueBits) -> bool {
  return match left {
    ValueBits.Object { reference } => match right {
      ValueBits.Object { reference: other } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(other)
      _ => false
    }
    _ => false
  }
}
/// evaluation.planned for constructInline: function's own body (CONSTRUCT_EVAL)
/// or the one its wrapper forwards to (CONSTRUCT_FORWARD, found from the plan's
/// prototype; the plan then proves it is function.prototype). Allocation
/// failure is raised as the pending exception; Uninitialized when no plan applies.
@inlineAlways
unsafe effect fn constructRecipe<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  runtime: *mut HeapHeader, function: ValueBits, form: u8, argv: &FrameSlots) -> ValueBits ! JsException ? &mut Allocator {
  let owner = core.reference(function)
  let mut target = function
  if form == CONSTRUCT_FORWARD {
    let cached = unsafe constructors.cachedForwardFrom(runtime, owner, unsafe gc.planPrototype(runtime, owner), unsafe constructors.forwardedAtom(function))
    if !cached.target.isObject() || unsafe classId(cached.target) != classes.JS_CLASS_BYTECODE_FUNCTION || !unsafe invoke.isApply(cached.method) { return ValueBits.Uninitialized }
    target = cached.target
  } else if form != CONSTRUCT_EVAL { return ValueBits.Uninitialized }
  let realm = unsafe lendRealm(&context, context)
  let created = run Effect.result(unsafe evaluation.planned(&mut hooks, memory, realm, owner, core.reference(target), &argv))
  return match move created {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
/// constructors.plannedConstruct for constructInline, with allocation failure
/// raised as the pending exception.
@inlineNever
unsafe effect fn constructPlanned<H: HeapHooks + CoercionHooks>(hooks: &mut H, memory: &AllocationObserver, context: *mut HeapHeader,
  function: ValueBits, argv: &FrameSlots, consumed: &mut bool) -> ValueBits ! JsException ? &mut Allocator {
  let node = match function { ValueBits.Object { reference } => reference _ => { return ValueBits.Uninitialized } }
  let realm = unsafe lendRealm(&context, context)
  let created = run Effect.result(unsafe constructors.plannedConstruct(&mut hooks, memory, realm, node, &argv, &mut consumed))
  return match move created {
    Result<ValueBits, OutOfMemoryError>.Success { value } => value
    Result<ValueBits, OutOfMemoryError>.Failure { error } => run core.materialize(&mut hooks, realm, move error)
  }
}
unsafe fn isDerivedConstructor(function: ValueBits, realm: &mut *mut HeapHeader) -> bool {
  let anchor = () let object = unsafe HeapCell.payload<ObjectData, ()>(&anchor, core.reference(function))
  let bytecode = match &object.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => invariant() }
  drop object
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  realm.* = code.realm
  return code.isDerivedClassConstructor
}
/// Completes an inline call with value: leaves the callee frame, then finishes the
/// caller's call operation as callOperation does. Returns the caller's machine.
@inlineNever
unsafe fn returnInline<H: HeapHooks>(hooks: &mut H, machine: &Machine, value: ValueBits) -> *mut Machine {
  return unsafe finishInline(&mut hooks, machine, value, false)
}
/// returnInline for the return opcodes, inlined into the dispatch loop.
@inlineAlways
unsafe fn finishInline<H: HeapHooks>(hooks: &mut H, machine: &Machine, value: ValueBits, dropsAhead: bool) -> *mut Machine {
  let exit = unsafe activation.leaveInline(&mut hooks, machine)
  let mut anchor = () let caller = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, exit.caller)
  unsafe releaseOperandsFrom(&mut hooks, &mut caller, exit.first)
  let flagged = activation.flagged(machine)
  // A call statement drops the result: answer the caller's drop here (unless
  // observed, or a construct or setter frame, whose result finishFlagged replaces).
  if dropsAhead && !flagged && unsafe caller.peekU8(0) == op.OP_drop {
    unsafe caller.skip(1) unsafe locals.releaseIn(&mut hooks, &caller, value)
    return exit.caller
  }
  unsafe caller.push(value)
  drop caller
  // The left record stays intact until the next inline call: releases never
  // run JS synchronously, so machine is still readable here.
  if flagged { unsafe finishFlagged(&mut hooks, machine, exit.caller) }
  return exit.caller
}
/// finishInline's rare half: a construct frame's result, an owned scope's
/// release and a setter frame's dropped result.
@inlineNever
unsafe fn finishFlagged<H: HeapHooks>(hooks: &mut H, callee: &Machine, caller: *mut Machine) -> () {
  unsafe activation.leaveScope(&mut hooks, callee)
  if activation.constructing(callee) { unsafe constructResult(&mut hooks, callee, caller) }
  if activation.discarding(callee) {
    let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, caller)
    let result = unsafe machine.pop()
    unsafe gc.release(&mut hooks, machine.runtime, result)
  }
}
/// gc.pinConstructed for a derived construct frame's object result, out of line
/// so the return path keeps its registers.
@inlineNever
unsafe fn pinResult<H: HeapHooks>(hooks: &mut H, runtime: *mut HeapHeader, value: ValueBits) -> () {
  match value { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, runtime, reference) } _ => () }
}
/// [[Construct]]'s result for a construct frame that just returned into caller:
/// an object result stays, anything else is replaced by the receiver the frame owned.
@inlineAlways
unsafe fn constructResult<H: HeapHooks>(hooks: &mut H, callee: &Machine, caller: *mut Machine) -> () {
  let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, caller)
  let value = unsafe machine.top(1)
  if value.isObject() && !activation.forwarded(callee) {
    // A derived constructor's frame owns no receiver: its result is the object it built.
    if core.undefined(callee.thisValue) { unsafe pinResult(&mut hooks, machine.runtime, value) }
    else { unsafe gc.release(&mut hooks, machine.runtime, callee.thisValue) }
    return ()
  }
  unsafe gc.release(&mut hooks, machine.runtime, value)
  unsafe machine.set(1, callee.thisValue)
  match callee.thisValue { ValueBits.Object { reference } => { unsafe gc.pinConstructed(&mut hooks, machine.runtime, reference) } _ => () }
}
/// unwind from the innermost frame over base: a frame without a handler is left
/// and its caller unwound in turn, down to base.
unsafe effect fn unwindFrames<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + CallHooks + ErrorHooks>(hooks: &mut H,
  memory: &AllocationObserver, base: &mut Machine) -> bool ? &mut Allocator {
  let mut current = unsafe activation.innermost(&mut base)
  while true {
    let mut anchor = () let machine = unsafe Pointer.borrowMut<(), Machine>(&mut anchor, current)
    if run unsafe unwind(&mut hooks, memory, &mut machine) { return true }
    if Pointer.isNull<u8>(machine.record) { return false }
    let runtime = machine.runtime let receiver = machine.thisValue let construct = activation.constructing(&machine)
    let exit = unsafe activation.leaveInline(&mut hooks, &machine)
    unsafe activation.leaveScope(&mut hooks, &machine)
    if construct { unsafe gc.release(&mut hooks, runtime, receiver) }
    current = exit.caller
  }
  return false
}
@inlineAlways
unsafe effect fn callOperation<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> Step ! JsException ? &mut Allocator {
  let mut count: usize = 0
  if opcode >= op.OP_call0 && opcode <= op.OP_call3 { count = u8.toUsize(opcode - op.OP_call0) }
  else { count = u16.toUsize(unsafe machine.readU16()) }
  let data = unsafe operandCell(machine.stackTop, count)
  let argv = FrameSlots { data: data, count: count }
  let mut receiver = ValueBits.Undefined let mut first = unsafe operandCell(data, 1)
  let mut function = unsafe machine.top(count + 1)
  if opcode == op.OP_call_method || opcode == op.OP_tail_call_method { receiver = unsafe machine.top(count + 2) first = unsafe operandCell(data, 2) }
  unsafe machine.publishPc()
  let mut result = ValueBits.Undefined
  if opcode == op.OP_call_constructor {
    let newTarget = function function = unsafe machine.top(count + 2) first = unsafe operandCell(data, 2)
    result = run unsafe constructInternal(&mut hooks, memory, machine.context, function, newTarget, &argv, 0)
  } else { result = run unsafe callFromBytecode(&mut hooks, memory, machine.context, function, receiver, &argv) }
  if opcode == op.OP_tail_call || opcode == op.OP_tail_call_method { return Step.Done { value: result } }
  unsafe releaseOperandsFrom(&mut hooks, &mut machine, first) unsafe machine.push(result) return Step.Continue
}
unsafe effect fn instruction<H: HeapHooks + CoercionHooks + OwnPropertyHooks + GetPropertyHooks + HasPropertyHooks + OwnKeysHooks
  + PropertyWriteHooks + PrototypeHooks + InterruptHooks + NativeFunctionHooks + CallHooks + ErrorHooks + EvalHooks>(hooks: &mut H,
  memory: &AllocationObserver, machine: &mut Machine, opcode: u8) -> Step
  ! OutOfMemoryError | StringLengthError | BigIntError | JsException ? &mut Allocator {

  if opcode == op.OP_apply {
    let mut magic = u16.toI32(unsafe machine.readU16()) unsafe machine.publishPc()
    if (magic & u16.toI32(op.APPLY_ITERABLE)) != 0 {
      // f(...x): x is spread here, unless the spread is x's own elements.
      magic = magic & 1
      let source = unsafe machine.top(1)
      if iterators.spreadCount(unsafe lendRealm(&machine.context, machine.context), source) < 0 {
        let array = run unsafe spread.spreadArray(&mut hooks, memory, &machine, source)
        unsafe gc.release(&mut hooks, machine.runtime, source)
        unsafe machine.set(1, array)
      }
    }
    let argv = FrameSlots { data: unsafe machine.topCell(2), count: 2 }
    let result = run unsafe invoke.apply(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(3)), &argv, magic)
    let first = machine.sp() - 3 unsafe releaseOperands(&mut hooks, &mut machine, first)
    unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_check_ctor_return {
    let value = unsafe machine.top(1)
    if !value.isObject() && !core.undefined(value) {
      let callerContext = unsafe activation.callerContextOf(&machine)
      return run hooks.throwError(unsafe lendRealm(&callerContext, callerContext), NativeErrorKind.Type, b"derived class constructor must return an object or undefined")
    }
    unsafe machine.push(ValueBits.Bool { value: !value.isObject() }) return Step.Continue
  }
  if opcode == op.OP_check_ctor || opcode == op.OP_init_ctor {
    if opcode == op.OP_init_ctor { unsafe machine.publishPc() }
    if core.undefined(unsafe activation.newTargetOf(&machine)) { return run core.throwClassCall(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&machine, unsafe machine.currentFunction())) }
    if opcode == op.OP_init_ctor {
      let fetched = run Effect.result(prototypes.getPrototype(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendBits(&machine, unsafe machine.currentFunction())))
      let prototype = match move fetched {
        Result<Value, OutOfMemoryError | JsException>.Success { value } => value.intoBits()
        Result<Value, OutOfMemoryError | JsException>.Failure { error } => run core.materialize(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move error)
      }
      let anchor = () let argv = unsafe Pointer.borrow<(), FrameSlots>(&anchor, unsafe activation.originalArgumentsOf(&machine))
      let called = run Effect.result(unsafe construct(&mut hooks, memory, machine.context, prototype, unsafe activation.newTargetOf(&machine), argv))
      unsafe gc.release(&mut hooks, machine.runtime, prototype)
      match move called {
        Result<ValueBits, JsException>.Success { value } => { unsafe machine.push(value) }
        Result<ValueBits, JsException>.Failure { error } => { fail move error }
      }
    }
    return Step.Continue
  }
  if opcode == op.OP_eval {
    let count = u16.toUsize(unsafe machine.readU16()) let scope = u16.toI32(unsafe machine.readU16()) - 2
    let start = machine.sp() - count
    let argv = FrameSlots { data: unsafe machine.slot(start), count: count }
    unsafe machine.publishPc()
    let result = run unsafe evaluate(&mut hooks, memory, &machine, unsafe machine.top(count + 1), &argv, scope, 0)
    unsafe releaseOperands(&mut hooks, &mut machine, start - 1) unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_apply_eval {
    let scope = u16.toI32(unsafe machine.readU16()) - 2 unsafe machine.publishPc()
    let mut arguments = run invoke.buildArgList(&mut hooks, unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(1)))
    let argv = arguments.view()
    let called = run Effect.result(unsafe evaluate(&mut hooks, memory, &machine, unsafe machine.top(2), &argv, scope, activation.COPY_ARGUMENTS))
    drop argv invoke.freeArgList(&mut hooks, unsafe lendRealm(&machine.context, machine.context), move arguments)
    let result = match move called {
      Result<ValueBits, JsException>.Success { value } => value
      Result<ValueBits, JsException>.Failure { error } => { fail move error }
    }
    let first = machine.sp() - 2 unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_import {
    unsafe machine.publishPc()
    let result = run hooks.dynamicImport(unsafe lendRealm(&machine.context, machine.context), unsafe lendFor(unsafe machine.top(2)), unsafe lendFor(unsafe machine.top(1)))
    let first = machine.sp() - 2 unsafe releaseOperands(&mut hooks, &mut machine, first) unsafe machine.push(result) return Step.Continue
  }
  if opcode == op.OP_append { run unsafe spread.execute(&mut hooks, memory, &mut machine) return Step.Continue }
  let mut message = DiagnosticMessage.make() message.append(b"invalid opcode: pc=")
  let mut digits: [u8; 10] = [0; 10] let mut at: usize = 10 let mut position = usize.toU32(machine.pc() - 1)
  while true {
    at = at - 1 digits[at] = 48 + u32.toU8(position % 10) position = position / 10
    if position == 0 { break }
  }
  message.append(Slice.view(&digits, at, 10 - at)) message.append(b" opcode=0x")
  let hex = b"0123456789abcdef" let encoded = [hex[u8.toUsize(opcode / 16)], hex[u8.toUsize(opcode % 16)]]
  message.append(&encoded)
  return run hooks.throwError(unsafe lendRealm(&machine.context, machine.context), NativeErrorKind.Internal, message.bytes())
}
// ---- direct calls from machine code (docs/jit/compiled-entry.md 7.7) ----

/// The first js_compiled.DIRECT_* constant that does not match this build's layout, for
/// function (a bytecode closure linked as a table entry of runtime): field 0 when all hold,
/// else its 1-based place in the list below and the offset this build has.
pub struct DirectLayoutCheck { pub field: u32, pub actual: i64 }
fn offset(base: usize, at: usize) -> i64 { return usize.wrappingToI64(usize.wrappingSubtract(at, base)) }
pub unsafe fn directLayoutHolds(runtime: *mut HeapHeader, function: ValueBits) -> DirectLayoutCheck {
  let anchor = ()
  let mut checks: [i64; 64] = [0; 64]
  let mut wanted: [i64; 64] = [0; 64]
  let mut n: usize = 0
  // 1: the tag byte of an object value.
  let tag = u8.toU32(unsafe Pointer.read<u8>(unsafe Intrinsic.pointerReinterpret<*const ValueBits, *const u8>(Pointer.fromRef<ValueBits>(&function))))
  checks[n] = u32.toI64(tag) wanted[n] = u32.toI64(compiled.DIRECT_OBJECT_TAG) n = n + 1
  let object = core.reference(function)
  let base = Pointer.address<HeapHeader>(object)
  // 2: the class at DIRECT_OBJECT_CLASS; 3: the bytecode class.
  let at = i32.toUsize(compiled.DIRECT_OBJECT_CLASS)
  let word = unsafe Pointer.read<u64>(unsafe Pointer.atMut<u64>(unsafe Pointer.assumeManyMut<u64>(unsafe Intrinsic.pointerReinterpret<*mut HeapHeader, *mut u64>(object)), at / 8))
  let class = u64.wrappingToU32(u64.shiftRight(word, usize.toU64((at % 8) * 8)) & 0xffff)
  checks[n] = u32.toI64(class) wanted[n] = u32.toI64(unsafe classId(function)) n = n + 1
  checks[n] = u32.toI64(classes.JS_CLASS_BYTECODE_FUNCTION) wanted[n] = u32.toI64(compiled.DIRECT_BYTECODE_CLASS) n = n + 1
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  let mut bytecode = Pointer.null<HeapHeader>()
  match &data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => {
      // 4-6: the closure's fields; 7: the captured cells after the list's block.
      checks[n] = offset(base, Pointer.address<*mut HeapHeader>(Pointer.fromRef<*mut HeapHeader>(&closure.bytecode))) wanted[n] = i32.toI64(compiled.DIRECT_CLOSURE_BYTECODE) n = n + 1
      let list = Pointer.address<BoxList<?*mut HeapHeader>>(Pointer.fromRef<BoxList<?*mut HeapHeader>>(&closure.varRefs))
      checks[n] = offset(base, list) wanted[n] = i32.toI64(compiled.DIRECT_CLOSURE_REFERENCES) n = n + 1
      checks[n] = offset(base, Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&closure.scope))) wanted[n] = i32.toI64(compiled.DIRECT_CLOSURE_SCOPE) n = n + 1
      if closure.varRefs.length() != 0 {
        let block = usize.toU64(unsafe Pointer.read<usize>(unsafe Intrinsic.pointerReinterpret<*const BoxList<?*mut HeapHeader>, *const usize>(Pointer.fromRef<BoxList<?*mut HeapHeader>>(&closure.varRefs))))
        let first = Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&closure.varRefs.asSlice()[0]))
        checks[n] = offset(u64.toUsize(block), first) wanted[n] = i32.toI64(compiled.DIRECT_BOX_DATA) n = n + 1
      }
      bytecode = closure.bytecode
    }
    _ => { return DirectLayoutCheck { field: 100, actual: 0 } }
  }
  drop data
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(bytecode))
  checks[n] = offset(Pointer.address<HeapHeader>(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(bytecode)), Pointer.address<u32>(Pointer.fromRef<u32>(&code.compiled))) wanted[n] = i32.toI64(compiled.DIRECT_BYTECODE_INDEX) n = n + 1
  let index = code.compiled
  drop code
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  let r = Pointer.address<HeapHeader>(runtime)
  checks[n] = offset(r, Pointer.address<bool>(Pointer.fromRef<bool>(&state.observeInstructions))) wanted[n] = i32.toI64(compiled.DIRECT_RUNTIME_OBSERVE) n = n + 1
  checks[n] = offset(r, Pointer.address<?*mut CompiledEntry>(Pointer.fromRef<?*mut CompiledEntry>(&state.compiled.entries))) wanted[n] = i32.toI64(compiled.DIRECT_RUNTIME_ENTRIES) n = n + 1
  checks[n] = offset(r, Pointer.address<u32>(Pointer.fromRef<u32>(&state.compiled.count))) wanted[n] = i32.toI64(compiled.DIRECT_RUNTIME_COUNT) n = n + 1
  drop state
  if index == 0 { return DirectLayoutCheck { field: 101, actual: 0 } }
  let slot = unsafe compiled.entryAt(runtime, index)
  let entry = unsafe Pointer.borrow<(), CompiledEntry>(&anchor, slot)
  let e = Pointer.address<CompiledEntry>(slot)
  checks[n] = u32.toI64(usize.toU32(Layout.of<CompiledEntry>().bytes)) wanted[n] = u32.toI64(compiled.DIRECT_ENTRY_BYTES) n = n + 1
  checks[n] = offset(e, Pointer.address<?*const u8>(Pointer.fromRef<?*const u8>(&entry.code))) wanted[n] = i32.toI64(compiled.DIRECT_ENTRY_CODE) n = n + 1
  checks[n] = offset(e, Pointer.address<?*mut u8>(Pointer.fromRef<?*mut u8>(&entry.data))) wanted[n] = i32.toI64(compiled.DIRECT_ENTRY_DATA) n = n + 1
  checks[n] = offset(e, Pointer.address<?*mut u8>(Pointer.fromRef<?*mut u8>(&entry.env))) wanted[n] = i32.toI64(compiled.DIRECT_ENTRY_ENV) n = n + 1
  checks[n] = offset(e, Pointer.address<u64>(Pointer.fromRef<u64>(&entry.runs))) wanted[n] = i32.toI64(compiled.DIRECT_ENTRY_RUNS) n = n + 1
  checks[n] = offset(e, Pointer.address<?*mut i32>(Pointer.fromRef<?*mut i32>(&entry.counter))) wanted[n] = i32.toI64(compiled.DIRECT_ENTRY_COUNTER) n = n + 1
  checks[n] = offset(e, Pointer.address<u32>(Pointer.fromRef<u32>(&entry.directArity))) wanted[n] = i32.toI64(compiled.DIRECT_ENTRY_ARITY) n = n + 1
  checks[n] = offset(e, Pointer.address<?*mut HeapHeader>(Pointer.fromRef<?*mut HeapHeader>(&entry.directRealm))) wanted[n] = i32.toI64(compiled.DIRECT_ENTRY_REALM) n = n + 1
  checks[n] = offset(e, Pointer.address<?*const u8>(Pointer.fromRef<?*const u8>(&entry.directCode))) wanted[n] = i32.toI64(compiled.DIRECT_ENTRY_SOURCE) n = n + 1
  checks[n] = offset(e, Pointer.address<u32>(Pointer.fromRef<u32>(&entry.callWords))) wanted[n] = i32.toI64(compiled.DIRECT_ENTRY_CALL_WORDS) n = n + 1
  checks[n] = offset(e, Pointer.address<u32>(Pointer.fromRef<u32>(&entry.activationWords))) wanted[n] = i32.toI64(compiled.DIRECT_ENTRY_WORDS) n = n + 1
  drop entry
  // The activation stack, the bytecode's mode and an activation's fields (DIRECT_ACT_*).
  let table = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, runtime)
  checks[n] = offset(r, Pointer.address<?*mut u64>(Pointer.fromRef<?*mut u64>(&table.compiled.activations))) wanted[n] = i32.toI64(compiled.DIRECT_RUNTIME_ACTIVATIONS) n = n + 1
  checks[n] = offset(r, Pointer.address<usize>(Pointer.fromRef<usize>(&table.compiled.activationWords))) wanted[n] = i32.toI64(compiled.DIRECT_RUNTIME_CAPACITY) n = n + 1
  checks[n] = offset(r, Pointer.address<usize>(Pointer.fromRef<usize>(&table.compiled.activationTop))) wanted[n] = i32.toI64(compiled.DIRECT_RUNTIME_TOP) n = n + 1
  checks[n] = offset(r, Pointer.address<u32>(Pointer.fromRef<u32>(&table.compiled.nativeDepth))) wanted[n] = i32.toI64(compiled.DIRECT_RUNTIME_DEPTH) n = n + 1
  drop table
  let mode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(bytecode))
  checks[n] = offset(Pointer.address<HeapHeader>(unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(bytecode)), Pointer.address<u8>(Pointer.fromRef<u8>(&mode.mode))) wanted[n] = i32.toI64(compiled.DIRECT_BYTECODE_MODE) n = n + 1
  drop mode
  // Only field addresses are taken: the zeroed words are never read as an activation.
  let words: [u64; 64] = [0; 64]
  let record = unsafe Intrinsic.pointerReinterpret<*const u64, *const Activation>(Pointer.fromRef<u64>(&words[0]))
  let a = Pointer.address<Activation>(record)
  let act = unsafe Pointer.borrow<(), Activation>(&anchor, record)
  checks[n] = offset(a, Pointer.address<CompiledFrame>(Pointer.fromRef<CompiledFrame>(&act.frame))) wanted[n] = 0 n = n + 1
  checks[n] = offset(a, Pointer.address<compiled.Prepared>(Pointer.fromRef<compiled.Prepared>(&act.prepared))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_PREPARED) n = n + 1
  checks[n] = offset(a, Pointer.address<?*mut u8>(Pointer.fromRef<?*mut u8>(&act.prepared.data))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_PREPARED + 8) n = n + 1
  checks[n] = offset(a, Pointer.address<?*mut u8>(Pointer.fromRef<?*mut u8>(&act.prepared.env))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_PREPARED + 16) n = n + 1
  checks[n] = offset(a, Pointer.address<*mut i32>(Pointer.fromRef<*mut i32>(&act.prepared.counter))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_PREPARED + 24) n = n + 1
  checks[n] = offset(a, Pointer.address<*const ValueBits>(Pointer.fromRef<*const ValueBits>(&act.cells))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_CELLS) n = n + 1
  checks[n] = offset(a, Pointer.address<*mut u64>(Pointer.fromRef<*mut u64>(&act.state))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_STATE) n = n + 1
  checks[n] = offset(a, Pointer.address<*mut StackFrame>(Pointer.fromRef<*mut StackFrame>(&act.stackFrame))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_STACK_FRAME) n = n + 1
  checks[n] = offset(a, Pointer.address<usize>(Pointer.fromRef<usize>(&act.pc))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_PC) n = n + 1
  checks[n] = offset(a, Pointer.address<bool>(Pointer.fromRef<bool>(&act.published))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_PUBLISHED) n = n + 1
  checks[n] = offset(a, Pointer.address<u8>(Pointer.fromRef<u8>(&act.mode))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_PUBLISHED + 1) n = n + 1
  checks[n] = offset(a, Pointer.address<ValueBits>(Pointer.fromRef<ValueBits>(&act.function))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_FUNCTION) n = n + 1
  checks[n] = offset(a, Pointer.address<ValueBits>(Pointer.fromRef<ValueBits>(&act.receiver))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_RECEIVER) n = n + 1
  checks[n] = offset(a, Pointer.address<*mut ValueBits>(Pointer.fromRef<*mut ValueBits>(&act.argv.data))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_ARGV) n = n + 1
  checks[n] = offset(a, Pointer.address<usize>(Pointer.fromRef<usize>(&act.argv.count))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_ARGV + 8) n = n + 1
  checks[n] = offset(a, Pointer.address<?*mut Activation>(Pointer.fromRef<?*mut Activation>(&act.parent))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_PARENT) n = n + 1
  checks[n] = offset(a, Pointer.address<usize>(Pointer.fromRef<usize>(&act.mark))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_MARK) n = n + 1
  checks[n] = offset(a, Pointer.address<u32>(Pointer.fromRef<u32>(&act.index))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_INDEX) n = n + 1
  checks[n] = offset(a, Pointer.address<u32>(Pointer.fromRef<u32>(&act.flags))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_INDEX + 4) n = n + 1
  checks[n] = offset(a, Pointer.address<u32>(Pointer.fromRef<u32>(&act.exit))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_EXIT) n = n + 1
  checks[n] = offset(a, Pointer.address<bool>(Pointer.fromRef<bool>(&act.known))) wanted[n] = i32.toI64(compiled.DIRECT_ACT_EXIT + 4) n = n + 1
  drop act
  checks[n] = usize.wrappingToI64((Layout.of<Activation>().bytes + 7) / 8) wanted[n] = i32.toI64(compiled.DIRECT_ACTIVATION_WORDS) n = n + 1
  checks[n] = usize.wrappingToI64((Layout.of<Activation>().bytes + 7) / 8 + (Layout.of<StackFrame>().bytes + 7) / 8) wanted[n] = i32.toI64(compiled.DIRECT_ACTIVATION_HEADER) n = n + 1
  checks[n] = u32.toI64(activation.COPY_ARGUMENTS) wanted[n] = u32.toI64(compiled.DIRECT_COPY_ARGUMENTS) n = n + 1
  checks[n] = -1 wanted[n] = usize.wrappingToI64(NO_PC) n = n + 1
  // The table index is 1-based: entry index sits at entries + (index - 1) * the entry size.
  let mut i: usize = 0
  while i < n {
    if checks[i] != wanted[i] { return DirectLayoutCheck { field: usize.toU32(i + 1), actual: checks[i] } }
    i = i + 1
  }
  return DirectLayoutCheck { field: 0, actual: 0 }
}
