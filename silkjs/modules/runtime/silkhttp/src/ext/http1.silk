//! An HTTP/1 parser in Silk with llhttp 9's interface (ext/http_parser_native calls it as it calls
//! llhttp): the same callbacks in the same order, the same callback return protocol (0, a pause,
//! an error; 1 and 2 from headers complete), the same flags, keep-alive and body rules (llhttp's
//! http.c), the same HPE_* codes and reasons, and error positions by llhttp's rule: one past the
//! byte that ended a span or completed a step when that byte was consumed, the byte itself when it
//! was refused. Strict parsing is the default; LENIENT_HEADERS, LENIENT_CHUNKED_LENGTH,
//! LENIENT_KEEP_ALIVE, LENIENT_TRANSFER_ENCODING, LENIENT_VERSION and LENIENT_DATA_AFTER_CLOSE are
//! honoured, and the HTTP/2 preface (`PRI * HTTP/2.0`) pauses with HPE_PAUSED_H2_UPGRADE as in
//! llhttp. Not here: RTSP and ICE start lines and chunk extension callbacks
//! (extensions are checked and skipped).
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i32
import silk.num.usize

pub unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
pub unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
pub unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
pub unsafe extern "C" fn realloc(pointer: ?*mut u8, size: usize) -> ?*mut u8
@foreign(noCapture: .("dest", "source"))
pub unsafe extern "C" fn memcpy(dest: *mut u8, source: *const u8, length: usize) -> *mut u8

const REQUEST: i32 = 1
const RESPONSE: i32 = 2
// llhttp_errno.
const OK: i32 = 0
const E_CLOSED_CONNECTION: i32 = 5
const E_INVALID_METHOD: i32 = 6
const E_INVALID_URL: i32 = 7
const E_INVALID_CONSTANT: i32 = 8
const E_INVALID_VERSION: i32 = 9
const E_INVALID_HEADER_TOKEN: i32 = 10
const E_INVALID_CONTENT_LENGTH: i32 = 11
const E_INVALID_CHUNK_SIZE: i32 = 12
const E_INVALID_STATUS: i32 = 13
const E_INVALID_EOF_STATE: i32 = 14
const E_INVALID_TRANSFER_ENCODING: i32 = 15
const E_CB_MESSAGE_BEGIN: i32 = 16
const E_CB_HEADERS_COMPLETE: i32 = 17
const E_CB_MESSAGE_COMPLETE: i32 = 18
const E_CB_CHUNK_HEADER: i32 = 19
const E_CB_CHUNK_COMPLETE: i32 = 20
const E_PAUSED: i32 = 21
const E_PAUSED_UPGRADE: i32 = 22
const E_UNEXPECTED_CONTENT_LENGTH: i32 = 4
const E_LF_EXPECTED: i32 = 3
const E_CR_EXPECTED: i32 = 25
const E_CB_HEADER_VALUE_COMPLETE: i32 = 29
// llhttp_flags.
const F_KEEP_ALIVE: u32 = 1
const F_CLOSE: u32 = 2
const F_CONNECTION_UPGRADE: u32 = 4
const F_CHUNKED: u32 = 8
const F_UPGRADE: u32 = 16
const F_CONTENT_LENGTH: u32 = 32
const F_SKIPBODY: u32 = 64
const F_TRAILING: u32 = 128
const F_TRANSFER_ENCODING: u32 = 512
// llhttp_lenient_flags.
const L_HEADERS: u32 = 1
const L_CHUNKED_LENGTH: u32 = 2
const L_KEEP_ALIVE: u32 = 4
const L_TRANSFER_ENCODING: u32 = 8
const L_VERSION: u32 = 16
const L_DATA_AFTER_CLOSE: u32 = 32
// finish.
const FINISH_SAFE: i32 = 0
const FINISH_SAFE_WITH_CB: i32 = 1
const FINISH_UNSAFE: i32 = 2
// The events of the bridge (http_parser_native's silkHTTPParserEvent).
const EV_BEGIN: i32 = 0
const EV_URL: i32 = 1
const EV_STATUS: i32 = 2
const EV_FIELD: i32 = 3
const EV_VALUE: i32 = 4
const EV_VALUE_COMPLETE: i32 = 6
const EV_HEADERS_COMPLETE: i32 = 7
const EV_BODY: i32 = 8
const EV_MESSAGE_COMPLETE: i32 = 9
const EV_CHUNK_HEADER: i32 = 10
const EV_CHUNK_COMPLETE: i32 = 11
// States. Those from S_AFTER_HEADERS read no byte.
const S_START: i32 = 0
const S_METHOD: i32 = 1
const S_URL_START: i32 = 2
const S_URL: i32 = 3
const S_PROTOCOL: i32 = 4
const S_MAJOR: i32 = 5
const S_DOT: i32 = 6
const S_MINOR: i32 = 7
const S_REQUEST_LF: i32 = 8
const S_AFTER_VERSION: i32 = 9
const S_STATUS: i32 = 10
const S_AFTER_STATUS: i32 = 11
const S_REASON: i32 = 12
const S_RESPONSE_LF: i32 = 13
const S_FIELD_START: i32 = 14
const S_FIELD: i32 = 15
const S_VALUE_WS: i32 = 16
const S_VALUE: i32 = 17
const S_VALUE_LF: i32 = 18
const S_VALUE_NEXT: i32 = 19
const S_HEADERS_LF: i32 = 20
const S_BODY: i32 = 21
const S_BODY_EOF: i32 = 22
const S_CHUNK_START: i32 = 23
const S_CHUNK_SIZE: i32 = 24
const S_CHUNK_EXTENSION: i32 = 25
const S_CHUNK_LF: i32 = 26
const S_CHUNK_DATA: i32 = 27
const S_CHUNK_DATA_CR: i32 = 28
const S_CHUNK_DATA_LF: i32 = 29
const S_CLOSED: i32 = 30
const S_AFTER_HEADERS: i32 = 40
const S_MESSAGE_DONE: i32 = 41
const S_AFTER_MESSAGE: i32 = 42
const S_TRAILERS_DONE: i32 = 43
const S_VALUE_DONE: i32 = 44
// The rest of the HTTP/2 connection preface after `PRI * HTTP/2.0`.
const S_PRI_PREFACE: i32 = 45
const E_PAUSED_H2_UPGRADE: i32 = 23
// What the header being read is.
const H_GENERAL: i32 = 0
const H_CONTENT_LENGTH: i32 = 1
const H_TRANSFER_ENCODING: i32 = 2
const H_CONNECTION: i32 = 3
const H_UPGRADE: i32 = 4

pub struct Parser {
  owner: ?*mut u8,
  event: extern "C" fn(?*mut u8, i32, ?*const u8, usize, ?*const u8) -> i32,
  kind: i32, lenient: u32, error: i32, reason: ?*const u8, errorPos: ?*const u8,
  state: i32, flags: u32, method: i32, major: i32, minor: i32, status: i32, upgrade: bool,
  contentLength: u64, finish: i32,
  // The span being read (an EV_* data event), and where it started in this execute's input.
  span: i32, spanStart: usize, spanOpen: bool,
  word: [u8; 24], wordLength: usize, constant: usize, digits: u32,
  header: i32, sawValue: bool, token: [u8; 16], tokenLength: usize, tokenOverflow: bool, lastChunked: bool,
  query: bool, fragment: bool, chunkSize: u64, quoted: bool,
}

const METHODS: [&[u8]; 47] = [b"DELETE", b"GET", b"HEAD", b"POST", b"PUT", b"CONNECT", b"OPTIONS", b"TRACE", b"COPY", b"LOCK", b"MKCOL",
  b"MOVE", b"PROPFIND", b"PROPPATCH", b"SEARCH", b"UNLOCK", b"BIND", b"REBIND", b"UNBIND", b"ACL", b"REPORT", b"MKACTIVITY", b"CHECKOUT",
  b"MERGE", b"M-SEARCH", b"NOTIFY", b"SUBSCRIBE", b"UNSUBSCRIBE", b"PATCH", b"PURGE", b"MKCALENDAR", b"LINK", b"UNLINK", b"SOURCE", b"PRI",
  b"DESCRIBE", b"ANNOUNCE", b"SETUP", b"PLAY", b"PAUSE", b"TEARDOWN", b"GET_PARAMETER", b"SET_PARAMETER", b"REDIRECT", b"RECORD", b"FLUSH",
  b"QUERY"]
const METHOD_NAMES: [&[u8]; 47] = [b"DELETE\0", b"GET\0", b"HEAD\0", b"POST\0", b"PUT\0", b"CONNECT\0", b"OPTIONS\0", b"TRACE\0", b"COPY\0",
  b"LOCK\0", b"MKCOL\0", b"MOVE\0", b"PROPFIND\0", b"PROPPATCH\0", b"SEARCH\0", b"UNLOCK\0", b"BIND\0", b"REBIND\0", b"UNBIND\0", b"ACL\0",
  b"REPORT\0", b"MKACTIVITY\0", b"CHECKOUT\0", b"MERGE\0", b"M-SEARCH\0", b"NOTIFY\0", b"SUBSCRIBE\0", b"UNSUBSCRIBE\0", b"PATCH\0",
  b"PURGE\0", b"MKCALENDAR\0", b"LINK\0", b"UNLINK\0", b"SOURCE\0", b"PRI\0", b"DESCRIBE\0", b"ANNOUNCE\0", b"SETUP\0", b"PLAY\0",
  b"PAUSE\0", b"TEARDOWN\0", b"GET_PARAMETER\0", b"SET_PARAMETER\0", b"REDIRECT\0", b"RECORD\0", b"FLUSH\0", b"QUERY\0"]
const ERROR_NAMES: [&[u8]; 39] = [b"HPE_OK\0", b"HPE_INTERNAL\0", b"HPE_STRICT\0", b"HPE_LF_EXPECTED\0", b"HPE_UNEXPECTED_CONTENT_LENGTH\0",
  b"HPE_CLOSED_CONNECTION\0", b"HPE_INVALID_METHOD\0", b"HPE_INVALID_URL\0", b"HPE_INVALID_CONSTANT\0", b"HPE_INVALID_VERSION\0",
  b"HPE_INVALID_HEADER_TOKEN\0", b"HPE_INVALID_CONTENT_LENGTH\0", b"HPE_INVALID_CHUNK_SIZE\0", b"HPE_INVALID_STATUS\0",
  b"HPE_INVALID_EOF_STATE\0", b"HPE_INVALID_TRANSFER_ENCODING\0", b"HPE_CB_MESSAGE_BEGIN\0", b"HPE_CB_HEADERS_COMPLETE\0",
  b"HPE_CB_MESSAGE_COMPLETE\0", b"HPE_CB_CHUNK_HEADER\0", b"HPE_CB_CHUNK_COMPLETE\0", b"HPE_PAUSED\0", b"HPE_PAUSED_UPGRADE\0",
  b"HPE_PAUSED_H2_UPGRADE\0", b"HPE_USER\0", b"HPE_CR_EXPECTED\0", b"HPE_CB_URL_COMPLETE\0", b"HPE_CB_STATUS_COMPLETE\0",
  b"HPE_CB_HEADER_FIELD_COMPLETE\0", b"HPE_CB_HEADER_VALUE_COMPLETE\0", b"HPE_UNEXPECTED_SPACE\0", b"HPE_CB_RESET\0",
  b"HPE_CB_METHOD_COMPLETE\0", b"HPE_CB_VERSION_COMPLETE\0", b"HPE_CB_CHUNK_EXTENSION_NAME_COMPLETE\0",
  b"HPE_CB_CHUNK_EXTENSION_VALUE_COMPLETE\0", b"HPE_UNKNOWN\0", b"HPE_UNKNOWN\0", b"HPE_CB_PROTOCOL_COMPLETE\0"]

fn text(bytes: &'static [u8]) -> ?*const u8 { return Pointer.fromRef<u8>(&bytes[0]) }
unsafe fn parserOf(p: *mut u8) -> *mut Parser { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Parser>(p) }
unsafe fn byteAt(data: *const u8, index: usize) -> u8 { return unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(data), index)) }
unsafe fn address(data: *const u8, index: usize) -> ?*const u8 { return unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(data), index) }
fn lower(byte: u8) -> u8 { if byte >= 65 && byte <= 90 { return byte + 32 } return byte }
fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }
fn isAlpha(byte: u8) -> bool { return byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 }
fn hexValue(byte: u8) -> i32 {
  if isDigit(byte) { return u8.toI32(byte) - 48 }
  if byte >= 97 && byte <= 102 { return u8.toI32(byte) - 87 }
  if byte >= 65 && byte <= 70 { return u8.toI32(byte) - 55 }
  return -1
}
// tchar of RFC 9110.
fn isToken(byte: u8) -> bool {
  if isDigit(byte) || isAlpha(byte) { return true }
  return byte == 33 || byte == 35 || byte == 36 || byte == 37 || byte == 38 || byte == 39 || byte == 42 || byte == 43 || byte == 45
    || byte == 46 || byte == 94 || byte == 95 || byte == 96 || byte == 124 || byte == 126
}
fn isValueByte(byte: u8) -> bool { return byte == 9 || byte >= 32 && byte != 127 }

/// llhttp_init: a request parser of `owner`, whose events go to `event`.
pub unsafe fn silk_http_parser_new(owner: *mut u8, event: extern "C" fn(?*mut u8, i32, ?*const u8, usize, ?*const u8) -> i32) -> ?*mut u8 {
  let memory = unsafe calloc(1, Layout.of<Parser>().bytes)
  if Pointer.isNull<u8>(memory) { return memory }
  let p = unsafe parserOf(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(memory))
  unsafe Pointer.put<Parser>(p, Parser {
    owner: owner, event: event, kind: REQUEST, lenient: 0, error: OK, reason: Pointer.null<u8>(), errorPos: Pointer.null<u8>(),
    state: S_START, flags: 0, method: 0, major: 0, minor: 0, status: 0, upgrade: false, contentLength: 0, finish: FINISH_SAFE,
    span: -1, spanStart: 0, spanOpen: false, word: [0; 24], wordLength: 0, constant: 0, digits: 0,
    header: H_GENERAL, sawValue: false, token: [0; 16], tokenLength: 0, tokenOverflow: false, lastChunked: false,
    query: false, fragment: false, chunkSize: 0, quoted: false,
  })
  return memory
}
pub unsafe fn silk_http_parser_initialize(parser: *mut u8, kind: i32, flags: u32) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, unsafe parserOf(parser))
  s.kind = kind s.lenient = flags s.error = OK s.reason = Pointer.null<u8>() s.errorPos = Pointer.null<u8>()
  s.state = S_START s.flags = 0 s.method = 0 s.major = 0 s.minor = 0 s.status = 0 s.upgrade = false s.contentLength = 0
  s.finish = FINISH_SAFE s.span = -1 s.spanOpen = false s.wordLength = 0 s.constant = 0 s.header = H_GENERAL
}
pub unsafe fn silk_http_parser_free(parser: *mut u8) -> () {
  let owned = unsafe Pointer.take<Parser>(unsafe parserOf(parser)) drop owned
  unsafe free(parser)
}
pub unsafe fn silk_http_parser_set_upgrade(parser: *mut u8, upgrade: i32) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, unsafe parserOf(parser)) s.upgrade = upgrade != 0
}
pub unsafe fn silk_http_parser_error(parser: *mut u8, kind: i32) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, unsafe parserOf(parser))
  s.reason = if kind == 1 { text(b"HPE_HEADER_OVERFLOW:Header overflow\0") } else if kind == 2 { text(b"HPE_CHUNK_EXTENSIONS_OVERFLOW:Chunk extensions overflow\0") } else { text(b"HPE_JS_EXCEPTION:JS Exception\0") }
}
pub unsafe fn llhttp_pause(parser: *mut u8) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, unsafe parserOf(parser))
  if s.error != OK { return () }
  s.error = E_PAUSED s.reason = text(b"Paused\0")
}
pub unsafe fn llhttp_resume(parser: *mut u8) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, unsafe parserOf(parser)) if s.error == E_PAUSED { s.error = OK }
}
pub unsafe fn llhttp_resume_after_upgrade(parser: *mut u8) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, unsafe parserOf(parser)) if s.error == E_PAUSED_UPGRADE { s.error = OK }
}
pub unsafe fn llhttp_get_type(parser: *mut u8) -> u8 { let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, unsafe parserOf(parser)) return i32.wrappingToU8(s.kind) }
pub unsafe fn llhttp_get_http_major(parser: *mut u8) -> u8 { let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, unsafe parserOf(parser)) return i32.wrappingToU8(s.major) }
pub unsafe fn llhttp_get_http_minor(parser: *mut u8) -> u8 { let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, unsafe parserOf(parser)) return i32.wrappingToU8(s.minor) }
pub unsafe fn llhttp_get_method(parser: *mut u8) -> u8 { let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, unsafe parserOf(parser)) return i32.wrappingToU8(s.method) }
pub unsafe fn llhttp_get_status_code(parser: *mut u8) -> i32 { let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, unsafe parserOf(parser)) return s.status }
pub unsafe fn llhttp_get_upgrade(parser: *mut u8) -> u8 { let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, unsafe parserOf(parser)) return if s.upgrade { 1 } else { 0 } }
pub unsafe fn llhttp_get_error_pos(parser: *const u8) -> ?*const u8 {
  let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, unsafe parserOf(unsafe Intrinsic.pointerRequalify<*const u8, *mut u8>(parser))) return s.errorPos
}
pub unsafe fn llhttp_get_error_reason(parser: *const u8) -> ?*const u8 {
  let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, unsafe parserOf(unsafe Intrinsic.pointerRequalify<*const u8, *mut u8>(parser))) return s.reason
}
pub unsafe fn llhttp_errno_name(code: i32) -> *const u8 {
  let name = if code >= 0 && code < 39 { ERROR_NAMES[i32.toUsize(code)] } else { b"HPE_UNKNOWN\0" }
  return Pointer.fromRef<u8>(&name[0])
}
pub unsafe fn llhttp_method_name(method: i32) -> *const u8 {
  let name = if method >= 0 && method < 47 { METHOD_NAMES[i32.toUsize(method)] } else { b"<unknown>\0" }
  return Pointer.fromRef<u8>(&name[0])
}
fn needsEof(s: &Parser) -> bool {
  if s.kind == REQUEST { return false }
  if s.status / 100 == 1 || s.status == 204 || s.status == 304 || u32.bitAnd(s.flags, F_SKIPBODY) != 0 { return false }
  if u32.bitAnd(s.flags, F_TRANSFER_ENCODING) != 0 && u32.bitAnd(s.flags, F_CHUNKED) == 0 { return true }
  if u32.bitAnd(s.flags, u32.bitOr(F_CHUNKED, F_CONTENT_LENGTH)) != 0 { return false }
  return true
}
fn keepAlive(s: &Parser) -> bool {
  if s.major > 0 && s.minor > 0 { if u32.bitAnd(s.flags, F_CLOSE) != 0 { return false } }
  else { if u32.bitAnd(s.flags, F_KEEP_ALIVE) == 0 { return false } }
  return !needsEof(s)
}
pub unsafe fn llhttp_message_needs_eof(parser: *const u8) -> i32 {
  let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, unsafe parserOf(unsafe Intrinsic.pointerRequalify<*const u8, *mut u8>(parser))) return if needsEof(&s.*) { 1 } else { 0 }
}
pub unsafe fn llhttp_should_keep_alive(parser: *const u8) -> i32 {
  let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, unsafe parserOf(unsafe Intrinsic.pointerRequalify<*const u8, *mut u8>(parser))) return if keepAlive(&s.*) { 1 } else { 0 }
}

// Calls the owner's callback for `event`. The parser is not borrowed while it runs: the callback
// may use it (pause it, or execute it again).
unsafe fn emit(parser: *mut Parser, event: i32, data: ?*const u8, length: usize, position: ?*const u8) -> i32 {
  let a = () let s = unsafe Pointer.borrow<(), Parser>(&a, parser) let owner = s.owner let callback = s.event drop s
  return unsafe callback(owner, event, data, length, position)
}
unsafe fn refuse(parser: *mut Parser, code: i32, reason: &'static [u8], position: ?*const u8) -> i32 {
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, parser)
  s.error = code s.reason = text(reason) s.errorPos = position
  return code
}
// A data callback's result: 0, or the error (a pause too) it leaves the parser in at `position`.
unsafe fn dataResult(parser: *mut Parser, result: i32, position: ?*const u8) -> i32 {
  if result == 0 { return 0 }
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, parser)
  s.error = result s.errorPos = position
  if result == E_PAUSED { s.reason = text(b"Paused\0") }
  return result
}
// A notification's result: a pause, or llhttp's error for that callback.
unsafe fn noticeResult(parser: *mut Parser, result: i32, code: i32, reason: &'static [u8], pause: &'static [u8], position: ?*const u8) -> i32 {
  if result == 0 { return 0 }
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, parser)
  s.errorPos = position
  if result == E_PAUSED { s.error = E_PAUSED s.reason = text(pause) return E_PAUSED }
  s.error = code s.reason = text(reason)
  return code
}
// Ends the open span at `end` (exclusive), reporting it; `position` is where an error leaves it.
unsafe fn closeSpan(parser: *mut Parser, data: *const u8, end: usize, position: ?*const u8) -> i32 {
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, parser)
  if !s.spanOpen { return 0 }
  let kind = s.span let start = s.spanStart s.spanOpen = false s.span = -1 drop s
  if end <= start && kind != EV_BODY { return 0 }
  let result = unsafe emit(parser, kind, unsafe address(data, start), end - start, unsafe address(data, end))
  return unsafe dataResult(parser, result, position)
}
unsafe fn openSpan(parser: *mut Parser, kind: i32, at: usize) -> () {
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, parser) s.span = kind s.spanStart = at s.spanOpen = true
}
// A token of a Connection or Transfer-Encoding value, lowercased, as it ends.
unsafe fn endToken(s: &mut Parser) -> () {
  // Trailing spaces of the token.
  while s.tokenLength > 0 && (s.token[s.tokenLength - 1] == 32 || s.token[s.tokenLength - 1] == 9) { s.tokenLength = s.tokenLength - 1 }
  let length = s.tokenLength
  let mut view: [u8; 16] = [0; 16] let mut i: usize = 0
  while i < length { view[i] = s.token[i] i = i + 1 }
  let word = Slice16 { bytes: view, length: length }
  if s.header == H_CONNECTION && !s.tokenOverflow {
    if word.is(b"keep-alive") { s.flags = u32.bitOr(s.flags, F_KEEP_ALIVE) }
    else if word.is(b"close") { s.flags = u32.bitOr(s.flags, F_CLOSE) }
    else if word.is(b"upgrade") { s.flags = u32.bitOr(s.flags, F_CONNECTION_UPGRADE) }
  }
  if s.header == H_TRANSFER_ENCODING { s.lastChunked = !s.tokenOverflow && word.is(b"chunked") }
  s.tokenLength = 0 s.tokenOverflow = false
}
struct Slice16 { bytes: [u8; 16], length: usize }
impl Slice16 {
  fn is(self: &Self, word: &[u8]) -> bool {
    if self.length != word.length { return false }
    let mut i: usize = 0
    while i < word.length { if self.bytes[i] != word[i] { return false } i = i + 1 }
    return true
  }
}
// The header whose name `word` (lowercase) is.
fn headerKind(word: &[u8; 24], length: usize) -> i32 {
  if prefixIs(word, length, b"content-length") { return H_CONTENT_LENGTH }
  if prefixIs(word, length, b"transfer-encoding") { return H_TRANSFER_ENCODING }
  if prefixIs(word, length, b"connection") || prefixIs(word, length, b"proxy-connection") { return H_CONNECTION }
  if prefixIs(word, length, b"upgrade") { return H_UPGRADE }
  return H_GENERAL
}
fn prefixIs(word: &[u8; 24], length: usize, name: &[u8]) -> bool {
  if length != name.length { return false }
  let mut i: usize = 0
  while i < length { if word[i] != name[i] { return false } i = i + 1 }
  return true
}
fn methodPrefix(word: &[u8], length: usize) -> bool {
  let mut m: usize = 0
  while m < 47 {
    let name = METHODS[m]
    if name.length >= length {
      let mut i: usize = 0 let mut ok = true
      while i < length { if name[i] != word[i] { ok = false break } i = i + 1 }
      if ok { return true }
    }
    m = m + 1
  }
  return false
}
fn methodIndex(word: &[u8], length: usize) -> i32 {
  let mut m: usize = 0
  while m < 47 {
    let name = METHODS[m]
    if name.length == length {
      let mut i: usize = 0 let mut ok = true
      while i < length { if name[i] != word[i] { ok = false break } i = i + 1 }
      if ok { return usize.toI32(m) }
    }
    m = m + 1
  }
  return -1
}

// A new message: what the last one left goes.
unsafe fn beginMessage(s: &mut Parser) -> () {
  s.flags = 0 s.method = 0 s.major = 0 s.minor = 0 s.status = 0 s.upgrade = false s.contentLength = 0
  s.wordLength = 0 s.constant = 0 s.digits = 0 s.query = false s.fragment = false s.header = H_GENERAL
  s.finish = FINISH_UNSAFE
}

pub unsafe fn llhttp_execute(parser: *mut u8, data: *const u8, length: usize) -> i32 {
  let p = unsafe parserOf(parser)
  let mut b = () let first = unsafe Pointer.borrowMut<(), Parser>(&mut b, p)
  if first.error != OK { return first.error }
  // A span left open by the last input goes on at the start of this one.
  if first.spanOpen { first.spanStart = 0 }
  drop first
  let mut i: usize = 0
  while true {
    let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, p)
    let state = s.state
    // The steps that read no byte.
    if state == S_AFTER_HEADERS {
      let hasBody = u32.bitAnd(s.flags, F_CHUNKED) != 0 || s.contentLength > 0
      if s.upgrade && (s.method == 5 || u32.bitAnd(s.flags, F_SKIPBODY) != 0 || !hasBody) || s.kind == RESPONSE && s.status == 101 {
        s.state = S_MESSAGE_DONE continue
      }
      if s.kind == RESPONSE && s.status == 100 { s.state = S_MESSAGE_DONE continue }
      if u32.bitAnd(s.flags, F_SKIPBODY) != 0 || s.kind == RESPONSE && (s.status == 102 || s.status == 103 || s.status == 204 || s.status == 304) { s.state = S_MESSAGE_DONE continue }
      if u32.bitAnd(s.flags, F_CHUNKED) != 0 { s.state = S_CHUNK_START s.chunkSize = 0 continue }
      if u32.bitAnd(s.flags, F_TRANSFER_ENCODING) != 0 {
        if s.kind == REQUEST && u32.bitAnd(s.lenient, u32.bitOr(L_CHUNKED_LENGTH, L_TRANSFER_ENCODING)) == 0 {
          drop s return unsafe refuse(p, E_INVALID_TRANSFER_ENCODING, b"Request has invalid `Transfer-Encoding`\0", unsafe address(data, i))
        }
        s.state = S_BODY_EOF s.finish = FINISH_SAFE_WITH_CB continue
      }
      if u32.bitAnd(s.flags, F_CONTENT_LENGTH) == 0 {
        if needsEof(&s.*) { s.state = S_BODY_EOF s.finish = FINISH_SAFE_WITH_CB continue }
        s.state = S_MESSAGE_DONE continue
      }
      if s.contentLength == 0 { s.state = S_MESSAGE_DONE continue }
      s.state = S_BODY continue
    }
    if state == S_MESSAGE_DONE {
      s.state = S_AFTER_MESSAGE drop s
      let result = unsafe emit(p, EV_MESSAGE_COMPLETE, Pointer.null<u8>(), 0, unsafe address(data, i))
      let code = unsafe noticeResult(p, result, E_CB_MESSAGE_COMPLETE, b"`on_message_complete` callback error\0", b"on_message_complete pause\0", unsafe address(data, i))
      if code != 0 { return code }
      continue
    }
    if state == S_AFTER_MESSAGE {
      let alive = keepAlive(&s.*) let upgrade = s.upgrade
      s.finish = FINISH_SAFE s.flags = 0
      if upgrade {
        s.state = S_START drop s
        return unsafe refuse(p, E_PAUSED_UPGRADE, b"Pause on CONNECT/Upgrade\0", unsafe address(data, i))
      }
      s.state = if alive || u32.bitAnd(s.lenient, L_KEEP_ALIVE) != 0 { S_START } else { S_CLOSED }
      continue
    }
    if state == S_TRAILERS_DONE {
      s.state = S_MESSAGE_DONE drop s
      let result = unsafe emit(p, EV_CHUNK_COMPLETE, Pointer.null<u8>(), 0, unsafe address(data, i))
      let code = unsafe noticeResult(p, result, E_CB_CHUNK_COMPLETE, b"`on_chunk_complete` callback error\0", b"on_chunk_complete pause\0", unsafe address(data, i))
      if code != 0 { return code }
      continue
    }
    if i == length { break }
    let byte = unsafe byteAt(data, i)
    if state == S_START {
      if byte == 13 || byte == 10 { i = i + 1 continue }
      // Data after an upgrade: llhttp begins a message, then pauses for the upgrade again.
      let upgraded = s.upgrade
      if !upgraded {
        unsafe beginMessage(&mut s)
        s.state = if s.kind == RESPONSE { S_PROTOCOL } else { S_METHOD }
      }
      drop s
      let result = unsafe emit(p, EV_BEGIN, Pointer.null<u8>(), 0, unsafe address(data, i))
      let code = unsafe noticeResult(p, result, E_CB_MESSAGE_BEGIN, b"`on_message_begin` callback error\0", b"on_message_begin pause\0", unsafe address(data, i))
      if code != 0 { return code }
      if upgraded { return unsafe refuse(p, E_PAUSED_UPGRADE, b"Pause on CONNECT/Upgrade\0", unsafe address(data, i)) }
      continue
    }
    if state == S_METHOD {
      if byte == 32 && s.wordLength > 0 {
        let index = methodIndex(&s.word, s.wordLength)
        if index < 0 { drop s return unsafe refuse(p, E_INVALID_METHOD, b"Invalid method encountered\0", unsafe address(data, i)) }
        s.method = index s.state = S_URL_START i = i + 1 continue
      }
      if s.wordLength >= 24 { drop s return unsafe refuse(p, E_INVALID_METHOD, b"Invalid method encountered\0", unsafe address(data, i)) }
      s.word[s.wordLength] = byte
      if !methodPrefix(&s.word, s.wordLength + 1) { drop s return unsafe refuse(p, E_INVALID_METHOD, b"Invalid method encountered\0", unsafe address(data, i)) }
      s.wordLength = s.wordLength + 1 i = i + 1 continue
    }
    if state == S_URL_START {
      if byte == 47 || byte == 42 || isAlpha(byte) || isDigit(byte) {
        s.state = S_URL s.query = false s.fragment = false drop s unsafe openSpan(p, EV_URL, i) i = i + 1 continue
      }
      drop s return unsafe refuse(p, E_INVALID_URL, b"Unexpected start char in url\0", unsafe address(data, i))
    }
    if state == S_URL {
      if byte == 32 {
        s.state = S_PROTOCOL s.constant = 0 drop s
        let code = unsafe closeSpan(p, data, i, unsafe address(data, i + 1))
        if code != 0 { return code }
        i = i + 1 continue
      }
      if byte < 33 || byte == 127 {
        let fragment = s.fragment let query = s.query drop s
        if fragment { return unsafe refuse(p, E_INVALID_URL, b"Invalid char in url fragment start\0", unsafe address(data, i)) }
        if query { return unsafe refuse(p, E_INVALID_URL, b"Invalid char in url query\0", unsafe address(data, i)) }
        return unsafe refuse(p, E_INVALID_URL, b"Invalid char in url path\0", unsafe address(data, i))
      }
      if byte == 63 { s.query = true }
      if byte == 35 { s.fragment = true }
      i = i + 1 continue
    }
    if state == S_PROTOCOL {
      let expected = b"HTTP/"
      if byte != expected[s.constant] { drop s return unsafe refuse(p, E_INVALID_CONSTANT, b"Expected HTTP/, RTSP/ or ICE/\0", unsafe address(data, i)) }
      s.constant = s.constant + 1
      if s.constant == 5 { s.state = S_MAJOR }
      i = i + 1 continue
    }
    if state == S_MAJOR {
      if !isDigit(byte) { drop s return unsafe refuse(p, E_INVALID_VERSION, b"Invalid major version\0", unsafe address(data, i)) }
      s.major = u8.toI32(byte) - 48 s.state = S_DOT i = i + 1 continue
    }
    if state == S_DOT {
      if byte != 46 { drop s return unsafe refuse(p, E_INVALID_VERSION, b"Expected dot\0", unsafe address(data, i)) }
      s.state = S_MINOR i = i + 1 continue
    }
    if state == S_MINOR {
      if !isDigit(byte) { drop s return unsafe refuse(p, E_INVALID_VERSION, b"Invalid minor version\0", unsafe address(data, i)) }
      s.minor = u8.toI32(byte) - 48
      let valid = s.major == 1 && (s.minor == 0 || s.minor == 1) || s.major == 0 && s.minor == 9 || s.major == 2 && s.minor == 0
      if !valid && u32.bitAnd(s.lenient, L_VERSION) == 0 { drop s return unsafe refuse(p, E_INVALID_VERSION, b"Invalid HTTP version\0", unsafe address(data, i + 1)) }
      s.state = if s.kind == RESPONSE { S_AFTER_VERSION } else if s.method == 34 { S_PRI_PREFACE } else { S_REQUEST_LF }
      s.digits = 0 s.constant = 0 i = i + 1 continue
    }
    if state == S_PRI_PREFACE {
      // llhttp's req_pri_upgrade: the preface pauses the parser one past its last byte.
      let preface = b"\r\n\r\nSM\r\n\r\n"
      if byte != preface[s.constant] { drop s return unsafe refuse(p, E_INVALID_VERSION, b"Expected HTTP/2 Connection Preface\0", unsafe address(data, i)) }
      s.constant = s.constant + 1
      if s.constant == 10 { drop s return unsafe refuse(p, E_PAUSED_H2_UPGRADE, b"Pause on PRI/Upgrade\0", unsafe address(data, i + 1)) }
      i = i + 1 continue
    }
    if state == S_REQUEST_LF {
      // After the version: CR, then LF.
      if s.digits == 0 {
        if byte == 13 { s.digits = 1 i = i + 1 continue }
        drop s return unsafe refuse(p, E_INVALID_VERSION, b"Expected CRLF after version\0", unsafe address(data, i + 1))
      }
      if byte != 10 { drop s return unsafe refuse(p, E_LF_EXPECTED, b"Expected LF after CR\0", unsafe address(data, i)) }
      s.state = S_FIELD_START i = i + 1 continue
    }
    if state == S_AFTER_VERSION {
      if byte != 32 { drop s return unsafe refuse(p, E_INVALID_VERSION, b"Expected space after version\0", unsafe address(data, i)) }
      s.state = S_STATUS s.status = 0 s.digits = 0 i = i + 1 continue
    }
    if state == S_STATUS {
      if !isDigit(byte) { drop s return unsafe refuse(p, E_INVALID_STATUS, b"Invalid status code\0", unsafe address(data, i)) }
      s.status = s.status * 10 + u8.toI32(byte) - 48 s.digits = s.digits + 1
      if s.digits == 3 { s.state = S_AFTER_STATUS }
      i = i + 1 continue
    }
    if state == S_AFTER_STATUS {
      if byte == 32 { s.state = S_REASON drop s unsafe openSpan(p, EV_STATUS, i + 1) i = i + 1 continue }
      if byte == 13 { s.state = S_RESPONSE_LF i = i + 1 continue }
      drop s return unsafe refuse(p, E_INVALID_STATUS, b"Invalid response status\0", unsafe address(data, i))
    }
    if state == S_REASON {
      if byte == 13 {
        s.state = S_RESPONSE_LF drop s
        let code = unsafe closeSpan(p, data, i, unsafe address(data, i + 1))
        if code != 0 { return code }
        i = i + 1 continue
      }
      if !isValueByte(byte) { drop s return unsafe refuse(p, E_INVALID_STATUS, b"Invalid response status\0", unsafe address(data, i)) }
      i = i + 1 continue
    }
    if state == S_RESPONSE_LF {
      if byte != 10 { drop s return unsafe refuse(p, E_CR_EXPECTED, b"Missing expected CR after response line\0", unsafe address(data, i)) }
      s.state = S_FIELD_START i = i + 1 continue
    }
    if state == S_FIELD_START {
      if byte == 13 { s.state = S_HEADERS_LF i = i + 1 continue }
      if !isToken(byte) { drop s return unsafe refuse(p, E_INVALID_HEADER_TOKEN, b"Invalid header token\0", unsafe address(data, i)) }
      s.state = S_FIELD s.wordLength = 0
      s.word[0] = lower(byte) s.wordLength = 1
      drop s unsafe openSpan(p, EV_FIELD, i) i = i + 1 continue
    }
    if state == S_FIELD {
      if byte == 58 {
        let kind = if s.wordLength <= 24 { headerKind(&s.word, s.wordLength) } else { H_GENERAL }
        s.header = kind s.state = S_VALUE_WS s.sawValue = false s.digits = 0 s.tokenLength = 0 s.tokenOverflow = false s.quoted = false
        if kind == H_CONTENT_LENGTH && u32.bitAnd(s.flags, F_TRANSFER_ENCODING) != 0 && u32.bitAnd(s.lenient, L_CHUNKED_LENGTH) == 0 {
          drop s
          let code = unsafe closeSpan(p, data, i, unsafe address(data, i + 1))
          if code != 0 { return code }
          return unsafe refuse(p, E_INVALID_CONTENT_LENGTH, b"Content-Length can't be present with Transfer-Encoding\0", unsafe address(data, i + 1))
        }
        if kind == H_TRANSFER_ENCODING && u32.bitAnd(s.flags, F_CONTENT_LENGTH) != 0 && u32.bitAnd(s.lenient, L_CHUNKED_LENGTH) == 0 {
          drop s
          let code = unsafe closeSpan(p, data, i, unsafe address(data, i + 1))
          if code != 0 { return code }
          return unsafe refuse(p, E_UNEXPECTED_CONTENT_LENGTH, b"Transfer-Encoding can't be present with Content-Length\0", unsafe address(data, i + 1))
        }
        drop s
        let code = unsafe closeSpan(p, data, i, unsafe address(data, i + 1))
        if code != 0 { return code }
        i = i + 1 continue
      }
      if !isToken(byte) { drop s return unsafe refuse(p, E_INVALID_HEADER_TOKEN, b"Invalid header token\0", unsafe address(data, i)) }
      if s.wordLength < 24 { s.word[s.wordLength] = lower(byte) }
      s.wordLength = s.wordLength + 1
      i = i + 1 continue
    }
    if state == S_VALUE_WS {
      if byte == 32 || byte == 9 { i = i + 1 continue }
      if byte == 13 { s.state = S_VALUE_LF i = i + 1 continue }
      s.state = S_VALUE continue
    }
    if state == S_VALUE {
      if byte == 13 {
        s.state = S_VALUE_LF drop s
        let code = unsafe closeSpan(p, data, i, unsafe address(data, i + 1))
        if code != 0 { return code }
        i = i + 1 continue
      }
      if !isValueByte(byte) && u32.bitAnd(s.lenient, L_HEADERS) == 0 {
        drop s return unsafe refuse(p, E_INVALID_HEADER_TOKEN, b"Invalid header value char\0", unsafe address(data, i))
      }
      if !s.sawValue {
        s.sawValue = true
        if s.header == H_CONTENT_LENGTH && u32.bitAnd(s.flags, F_CONTENT_LENGTH) != 0 {
          drop s return unsafe refuse(p, E_UNEXPECTED_CONTENT_LENGTH, b"Duplicate Content-Length\0", unsafe address(data, i))
        }
        drop s unsafe openSpan(p, EV_VALUE, i)
        let mut c = () let t = unsafe Pointer.borrowMut<(), Parser>(&mut c, p)
        if t.header == H_CONTENT_LENGTH { t.contentLength = 0 }
        drop t
        continue
      }
      if s.header == H_CONTENT_LENGTH {
        if isDigit(byte) && s.digits == 0 {
          let next = s.contentLength * 10 + u8.toU64(byte - 48)
          if next / 10 != s.contentLength { drop s return unsafe refuse(p, E_INVALID_CONTENT_LENGTH, b"Content-Length overflow\0", unsafe address(data, i + 1)) }
          s.contentLength = next
        } else if byte == 32 || byte == 9 { s.digits = 1 }
        else { drop s return unsafe refuse(p, E_INVALID_CONTENT_LENGTH, b"Invalid character in Content-Length\0", unsafe address(data, i)) }
      } else if s.header == H_CONNECTION || s.header == H_TRANSFER_ENCODING {
        if byte == 44 { unsafe endToken(&mut s) }
        else if s.tokenLength == 0 && (byte == 32 || byte == 9) {}
        else if s.tokenLength < 16 { s.token[s.tokenLength] = lower(byte) s.tokenLength = s.tokenLength + 1 }
        else { s.tokenOverflow = true }
      }
      i = i + 1 continue
    }
    if state == S_VALUE_LF {
      if byte != 10 { drop s return unsafe refuse(p, E_LF_EXPECTED, b"Missing expected LF after header value\0", unsafe address(data, i)) }
      s.state = S_VALUE_NEXT i = i + 1 continue
    }
    if state == S_VALUE_NEXT {
      if (byte == 32 || byte == 9) && u32.bitAnd(s.lenient, L_HEADERS) == 0 {
        drop s return unsafe refuse(p, E_INVALID_HEADER_TOKEN, b"Unexpected whitespace after header value\0", unsafe address(data, i))
      }
      // The value is complete.
      if s.header == H_CONTENT_LENGTH && !s.sawValue { drop s return unsafe refuse(p, E_INVALID_CONTENT_LENGTH, b"Empty Content-Length\0", unsafe address(data, i)) }
      if s.header == H_CONTENT_LENGTH { s.flags = u32.bitOr(s.flags, F_CONTENT_LENGTH) }
      if s.header == H_CONNECTION { unsafe endToken(&mut s) }
      if s.header == H_TRANSFER_ENCODING {
        unsafe endToken(&mut s)
        s.flags = u32.bitOr(s.flags, F_TRANSFER_ENCODING)
        s.flags = if s.lastChunked { u32.bitOr(s.flags, F_CHUNKED) } else { u32.bitAnd(s.flags, u32.bitXor(F_CHUNKED, 4294967295)) }
      }
      if s.header == H_UPGRADE { s.flags = u32.bitOr(s.flags, F_UPGRADE) }
      s.header = H_GENERAL s.state = S_FIELD_START drop s
      let result = unsafe emit(p, EV_VALUE_COMPLETE, Pointer.null<u8>(), 0, unsafe address(data, i))
      let code = unsafe noticeResult(p, result, E_CB_HEADER_VALUE_COMPLETE, b"`on_header_value_complete` callback error\0", b"on_header_value_complete pause\0", unsafe address(data, i))
      if code != 0 { return code }
      continue
    }
    if state == S_HEADERS_LF {
      if byte != 10 { drop s return unsafe refuse(p, E_LF_EXPECTED, b"Expected LF after headers\0", unsafe address(data, i)) }
      i = i + 1
      if u32.bitAnd(s.flags, F_TRAILING) != 0 { s.state = S_TRAILERS_DONE continue }
      // llhttp__before_headers_complete.
      if u32.bitAnd(s.flags, F_UPGRADE) != 0 && u32.bitAnd(s.flags, F_CONNECTION_UPGRADE) != 0 { s.upgrade = s.kind == REQUEST || s.status == 101 }
      else { s.upgrade = s.method == 5 && s.kind == REQUEST }
      s.state = S_AFTER_HEADERS drop s
      let result = unsafe emit(p, EV_HEADERS_COMPLETE, Pointer.null<u8>(), 0, unsafe address(data, i))
      if result == 1 || result == 2 {
        let mut c = () let t = unsafe Pointer.borrowMut<(), Parser>(&mut c, p)
        t.flags = u32.bitOr(t.flags, F_SKIPBODY) if result == 2 { t.upgrade = true }
        continue
      }
      let code = unsafe noticeResult(p, result, E_CB_HEADERS_COMPLETE, b"User callback error\0", b"Paused by on_headers_complete\0", unsafe address(data, i))
      if code != 0 { return code }
      continue
    }
    if state == S_BODY || state == S_CHUNK_DATA {
      let available = length - i
      let mut take = available
      let remaining = if state == S_BODY { s.contentLength } else { s.chunkSize }
      if usize.toU64(take) > remaining { take = u64.toUsize(remaining) }
      let left = remaining - usize.toU64(take)
      if state == S_BODY { s.contentLength = left } else { s.chunkSize = left }
      if left == 0 { s.state = if state == S_BODY { S_MESSAGE_DONE } else { S_CHUNK_DATA_CR } }
      drop s
      let result = unsafe emit(p, EV_BODY, unsafe address(data, i), take, unsafe address(data, i + take))
      i = i + take
      let code = unsafe dataResult(p, result, unsafe address(data, i))
      if code != 0 { return code }
      continue
    }
    if state == S_BODY_EOF {
      drop s
      let take = length - i
      let result = unsafe emit(p, EV_BODY, unsafe address(data, i), take, unsafe address(data, length))
      i = length
      let code = unsafe dataResult(p, result, unsafe address(data, i))
      if code != 0 { return code }
      continue
    }
    if state == S_CHUNK_START {
      let value = hexValue(byte)
      if value < 0 { drop s return unsafe refuse(p, E_INVALID_CHUNK_SIZE, b"Invalid character in chunk size\0", unsafe address(data, i)) }
      s.chunkSize = i32.toU64(value) s.state = S_CHUNK_SIZE i = i + 1 continue
    }
    if state == S_CHUNK_SIZE {
      let value = hexValue(byte)
      if value >= 0 {
        if s.chunkSize > 1152921504606846975 { drop s return unsafe refuse(p, E_INVALID_CHUNK_SIZE, b"Chunk size overflow\0", unsafe address(data, i)) }
        s.chunkSize = s.chunkSize * 16 + i32.toU64(value) i = i + 1 continue
      }
      if byte == 59 { s.state = S_CHUNK_EXTENSION s.quoted = false i = i + 1 continue }
      if byte == 13 { s.state = S_CHUNK_LF i = i + 1 continue }
      drop s return unsafe refuse(p, E_INVALID_CHUNK_SIZE, b"Invalid character in chunk size\0", unsafe address(data, i))
    }
    if state == S_CHUNK_EXTENSION {
      if s.quoted { if byte == 34 { s.quoted = false } i = i + 1 continue }
      if byte == 34 { s.quoted = true i = i + 1 continue }
      if byte == 13 { s.state = S_CHUNK_LF i = i + 1 continue }
      if !isToken(byte) && byte != 59 && byte != 61 && byte != 32 && byte != 9 {
        drop s return unsafe refuse(p, E_INVALID_CHUNK_SIZE, b"Invalid character in chunk extensions\0", unsafe address(data, i))
      }
      i = i + 1 continue
    }
    if state == S_CHUNK_LF {
      if byte != 10 { drop s return unsafe refuse(p, E_LF_EXPECTED, b"Expected LF after chunk size\0", unsafe address(data, i)) }
      i = i + 1
      let size = s.chunkSize
      s.state = if size == 0 { S_FIELD_START } else { S_CHUNK_DATA }
      if size == 0 { s.flags = u32.bitOr(s.flags, F_TRAILING) }
      drop s
      let result = unsafe emit(p, EV_CHUNK_HEADER, Pointer.null<u8>(), 0, unsafe address(data, i))
      let code = unsafe noticeResult(p, result, E_CB_CHUNK_HEADER, b"`on_chunk_header` callback error\0", b"on_chunk_header pause\0", unsafe address(data, i))
      if code != 0 { return code }
      continue
    }
    if state == S_CHUNK_DATA_CR {
      if byte != 13 { drop s return unsafe refuse(p, E_CR_EXPECTED, b"Missing expected CR after chunk data\0", unsafe address(data, i)) }
      s.state = S_CHUNK_DATA_LF i = i + 1 continue
    }
    if state == S_CHUNK_DATA_LF {
      if byte != 10 { drop s return unsafe refuse(p, E_LF_EXPECTED, b"Expected LF after chunk data\0", unsafe address(data, i)) }
      i = i + 1 s.state = S_CHUNK_START drop s
      let result = unsafe emit(p, EV_CHUNK_COMPLETE, Pointer.null<u8>(), 0, unsafe address(data, i))
      let code = unsafe noticeResult(p, result, E_CB_CHUNK_COMPLETE, b"`on_chunk_complete` callback error\0", b"on_chunk_complete pause\0", unsafe address(data, i))
      if code != 0 { return code }
      continue
    }
    if state == S_CLOSED {
      if byte == 13 || byte == 10 { i = i + 1 continue }
      if u32.bitAnd(s.lenient, L_DATA_AFTER_CLOSE) != 0 { s.state = S_START continue }
      drop s return unsafe refuse(p, E_CLOSED_CONNECTION, b"Data after `Connection: close`\0", unsafe address(data, i + 1))
    }
    drop s return unsafe refuse(p, 1, b"Invalid internal state\0", unsafe address(data, i))
  }
  // The input ends inside a span: what is here of it is reported now.
  let a2 = () let s2 = unsafe Pointer.borrow<(), Parser>(&a2, p) let open = s2.spanOpen let kind = s2.span drop s2
  if open {
    let code = unsafe closeSpan(p, data, length, unsafe address(data, length))
    if code != 0 { return code }
    // The span goes on in the next input.
    unsafe openSpan(p, kind, 0)
  }
  return OK
}
pub unsafe fn llhttp_finish(parser: *mut u8) -> i32 {
  let p = unsafe parserOf(parser)
  let mut a = () let s = unsafe Pointer.borrowMut<(), Parser>(&mut a, p)
  if s.error != OK { return 0 }
  let finish = s.finish
  if finish == FINISH_SAFE_WITH_CB {
    s.finish = FINISH_SAFE drop s
    let result = unsafe emit(p, EV_MESSAGE_COMPLETE, Pointer.null<u8>(), 0, Pointer.null<u8>())
    return if result == 0 || result == E_PAUSED { 0 } else { E_CB_MESSAGE_COMPLETE }
  }
  if finish == FINISH_SAFE { return 0 }
  s.reason = text(b"Invalid EOF state\0")
  return E_INVALID_EOF_STATE
}
