  if 2 + originLength + valueLength > MAX_PAYLOADLEN { return ERR_INVALID_ARGUMENT }
  if stream == 0 { if originLength == 0 { return ERR_INVALID_ARGUMENT } } else if originLength != 0 { return ERR_INVALID_ARGUMENT }
