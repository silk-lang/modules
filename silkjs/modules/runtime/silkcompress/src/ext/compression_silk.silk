//! Incremental compression with owned worker inputs and exclusive codec jobs, over silk.compress:
//! the protocol of ./compress (NativeCompression) with no C library behind it.
//! Results are ArrayBuffers: five little-endian i32 words (status, consumed,
//! written, finished, again), followed by exactly `written` output bytes and
//! then, when the status is a failure, the codec's own message text.
//! The loop thread owns handle links/busy/disposed; workers only touch codec state.
import silkjsruntime.ext.blocking_pool as pool
import silkjsruntime.ext.fs_async as fs_async
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_owned_value { Value,  lendFor }
import silkjs.js_realm { lendRealm }
import silkjs.js_std_support as text
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.compress.checksum { CompressionChecksum }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i32
import silk.num.usize
import silk.num.f64
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots, NativeErrorKind }
import silkjs.js_exceptions { JsException }
import silkjs.js_coercion_host { CoercionHooks }
import silkjsruntime.libs.core.owners as owners
import silkjsruntime.libs.core.common as common
import silkjs.js_buffer_storage as buffers
import silkjs.js_promise as promise
import silkjsruntime.libs.core.host as host
import silk.compress.inflate { Decoder, DecodeError, ErrorKind, Format, Limits, Progress, Status }
import silk.compress.deflate { EncodeError, EncodeProgress, EncodeStatus, Encoder, Flush, Hash, Options, Strategy }
import silk.compress.brotli { Brotli, BrotliError, BrotliLimits, BrotliProgress, BrotliReason, BrotliStatus }
import silk.compress.brotli_encode { BrotliEncodeError, BrotliEncodeProgress, BrotliEncodeStatus, BrotliEncoder, BrotliFlush, BrotliOptions }
import silk.compress.zstd { Zstd, ZstdError, ZstdLimits, ZstdProgress, ZstdReason, ZstdStatus }
import silk.compress.zstd_encode { ZstdEncodeError, ZstdEncodeProgress, ZstdEncodeStatus, ZstdEncoder, ZstdFlush, ZstdOptions }
unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
import silkjsruntime.ext.resource_snapshot as resources
import silkjs.js_proxy_core as core

pub struct State { first: ?*mut Handle, jobs: ?*mut Job, next: i32, closing: bool }
struct Handle {
  next: ?*mut Handle, id: i32, busy: bool, disposed: bool, stream: *mut CodecState
}
// The codecs, over silk.compress: each stream's encoder or decoder lives in memory of its own,
// made on the loop thread when the handle is created and stepped on whichever thread runs the job.
struct CodecState {
  kind: i32,
  deflater: ?*mut Encoder, inflater: ?*mut Decoder,
  brotliEncoder: ?*mut BrotliEncoder, brotliDecoder: ?*mut Brotli,
  zstdEncoder: ?*mut ZstdEncoder, zstdDecoder: ?*mut Zstd,
  dictionary: ?*mut u8, dictionaryLength: usize,
  params: ?*mut u8, paramsLength: usize,
  ended: bool, gzip: bool, header: u32, headerLength: u32,
  ignoring: bool, strict: bool, frameSeen: bool,
  input: ?*mut u8, inputLength: usize, inputOffset: usize,
  // A Zstandard frame's pledged size and the input it has consumed so far.
  // reset() restores an initial pledge (pledgeInitial) for the next frame.
  pledged: bool, pledgeInitial: bool, pledgedSize: u64, frameInput: u64,
  // The zstd decoder's window limit (ZSTD_d_windowLogMax), for a reset.
  windowLogMax: u32
}
struct Job {
  next: ?*mut Job, work: pool.Job, callback: ValueBits, done: bool,
  handle: ?*mut Handle, stream: ?*mut CodecState, op: i32, numbers: [i32; 8], data: [?*mut u8; 8], lengths: [usize; 8],
  output: ?*mut u8, capacity: usize, written: usize, consumed: usize,
  status: i32, finished: bool, again: bool, pledgedSize: u64,
  // The codec failure's text, as zlib's msg or ZSTD_getErrorName names it; empty for none.
  message: &'static [u8],
  // What one codec call reads and writes: process() takes these, whichever op set them.
  flush: i32, source: ?*mut u8, sourceLength: usize, target: ?*mut u8,
  // The write op: the caller's input and output ArrayBuffers (retained while a worker runs),
  // their leases when the worker writes in place, and the staging copies otherwise.
  views: [ValueBits; 2], leaseIn: Option<buffers.BufferReadLease>, leaseOut: Option<buffers.BufferReadLease>,
  stagedOut: bool, direct: bool, words: ValueBits
}
unsafe fn nonnull<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn raw<T>(p: *mut T) -> *mut u8 { return unsafe Intrinsic.pointerReinterpret<*mut T, *mut u8>(p) }
fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
fn equal(a: &[u8], b: &[u8]) -> bool { if a.length != b.length { return false } let mut i: usize = 0 while i < a.length { if a[i] != b[i] { return false } i = i + 1 } return true }
unsafe fn at(p: ?*mut u8, n: usize) -> *mut u8 { return unsafe buffers.dataAt(p, usize.toU64(n)) }
unsafe fn word(p: ?*mut u8, offset: usize) -> i32 {
  let mut value: u32 = 0 let mut i: u32 = 0
  while i < 4 { value = u32.bitOr(value, u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe at(p, offset + u32.toUsize(i)))), i * 8)) i = i + 1 }
  return u32.wrappingToI32(value)
}
unsafe fn putWord(p: ?*mut u8, offset: usize, value: i32) -> () {
  let bits = i32.wrappingToU32(value)
  let mut i: u32 = 0 while i < 4 { unsafe Pointer.put<u8>(unsafe at(p, offset + u32.toUsize(i)), u32.wrappingToU8(u32.shiftRight(bits, i * 8))) i = i + 1 }
}
effect fn allocate(size: usize) -> *mut u8 ! OutOfMemoryError { let p = unsafe calloc(1, size) if Pointer.isNull<u8>(p) { fail OutOfMemoryError {} } return unsafe nonnull(p) }
pub effect fn open() -> *mut State ! OutOfMemoryError {
  let s = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(run allocate(Layout.of<State>().bytes))
  unsafe Pointer.put<State>(s, State { first: Pointer.null<Handle>(), jobs: Pointer.null<Job>(), next: 1, closing: false }) return s
}
pub unsafe effect fn appendResources<'m,S:EngineServices>(engine:&mut Engine<'m,S>,context:*mut HeapHeader,state:*mut State,array:ValueBits,index:&mut u32)->() !JsException ?&mut Allocator {
  let anchor=() let owner=unsafe Pointer.borrow<(),State>(&anchor,state) let mut cursor=owner.jobs drop owner
  while !Pointer.isNull<Job>(cursor) {
    let request=unsafe raw(unsafe nonnull(cursor))
    let job=unsafe Pointer.borrow<(),Job>(&anchor,unsafe nonnull(cursor))
    cursor=job.next drop job
    run unsafe resources.appendRequest(&mut engine,context,array,&mut index,request,b"work",b"")
  }
}
unsafe fn locate(s: *mut State, id: i32) -> ?*mut Handle {
  let anchor = () let state = unsafe Pointer.borrow<(), State>(&anchor, s) let mut p = state.first drop state
  while !Pointer.isNull<Handle>(p) { let h = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nonnull(p)) if h.id == id && !h.disposed { return p } p = h.next }
  return Pointer.null<Handle>()
}
unsafe fn releaseHandle(s: *mut State, id: i32) -> () {
  let mut anchor = () let state = unsafe Pointer.borrowMut<(), State>(&mut anchor, s) let mut link = Pointer.fromMutRef<?*mut Handle>(&mut state.first) drop state
  while !Pointer.isNull<Handle>(unsafe Pointer.read<?*mut Handle>(link)) {
    let p = unsafe nonnull(unsafe Pointer.read<?*mut Handle>(link)) let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, p)
    if h.id == id {
      h.disposed = true if h.busy { return () }
      unsafe Pointer.put<?*mut Handle>(link, h.next) let stream = h.stream drop h
      let codec = unsafe Pointer.borrowMut<(), CodecState>(&mut anchor, stream)
      unsafe destroyCodec(&mut codec) unsafe free(codec.dictionary) unsafe free(codec.params) unsafe free(codec.input) drop codec
      let ownedCodec = unsafe Pointer.take<CodecState>(stream) drop ownedCodec unsafe free(unsafe raw(stream))
      let owned = unsafe Pointer.take<Handle>(p) drop owned unsafe free(unsafe raw(p)) return ()
    }
    link = Pointer.fromMutRef<?*mut Handle>(&mut h.next) drop h
  }
}
// ---- codecs over silk.compress -----------------------------------------------------------------

unsafe fn store<T>(value: T) -> ?*mut T {
  let memory = unsafe calloc(1, Layout.of<T>().bytes)
  if Pointer.isNull<u8>(memory) { return Pointer.null<T>() }
  let typed = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(unsafe nonnull(memory))
  unsafe Pointer.put<T>(typed, move value)
  return typed
}
unsafe fn discard<T>(p: ?*mut T) -> () {
  if Pointer.isNull<T>(p) { return () }
  let owned = unsafe Pointer.take<T>(unsafe nonnull(p)) drop owned
  unsafe free(unsafe raw(unsafe nonnull(p)))
}
// `n` bytes at `p + offset`; empty when `n` is 0, whatever `p` is.
unsafe fn view<'a>(anchor: &'a (), p: ?*mut u8, offset: usize, n: usize) -> &'a [u8] {
  if n == 0 { return b"" }
  return unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(unsafe at(p, offset)), n)
}
unsafe fn viewMut<'a>(anchor: &'a mut (), p: ?*mut u8, offset: usize, n: usize) -> &'a mut [u8] {
  return unsafe Pointer.borrowManyMut<(), u8>(&mut anchor, unsafe Pointer.assumeManyMut<u8>(unsafe at(p, offset)), n)
}
fn deflateFormat(kind: i32) -> Format {
  if kind == 3 || kind == 4 { return Format.Gzip }
  if kind == 5 || kind == 6 { return Format.Raw }
  return Format.Zlib
}
fn noLimits() -> Limits {
  return Limits { maxInputBytes: u64.MAX, maxOutputBytes: u64.MAX, maxMembers: 1, maxHeaderBytes: u64.MAX, maxMemoryBytes: u64.MAX }
}
fn brotliLimits() -> BrotliLimits {
  let defaults = BrotliLimits.make()
  return BrotliLimits { inputBytes: u64.MAX, outputBytes: u64.MAX, windowBytes: defaults.windowBytes, workspaceBytes: defaults.workspaceBytes }
}
fn zstdLimits(windowLogMax: u32) -> ZstdLimits {
  let defaults = ZstdLimits.make()
  return ZstdLimits { inputBytes: u64.MAX, outputBytes: u64.MAX, frames: u64.MAX, skippableBytes: u64.MAX,
    windowBytes: u64.toUsize(u64.shiftLeft(1, u32.toU64(windowLogMax))), workspaceBytes: defaults.workspaceBytes }
}
fn strategy(value: i32) -> Strategy {
  if value == 1 { return Strategy.Filtered }
  if value == 2 { return Strategy.HuffmanOnly }
  if value == 3 { return Strategy.Rle }
  if value == 4 { return Strategy.Fixed }
  return Strategy.Default
}
fn deflateFlush(flush: i32) -> Flush {
  if flush == 1 { return Flush.Partial }
  if flush == 2 { return Flush.Sync }
  if flush == 3 { return Flush.Full }
  if flush == 4 { return Flush.Finish }
  if flush == 5 { return Flush.Block }
  return Flush.None
}
unsafe fn destroyCodec(h: &mut CodecState) -> () {
  unsafe discard<Encoder>(h.deflater) h.deflater = Pointer.null<Encoder>()
  unsafe discard<Decoder>(h.inflater) h.inflater = Pointer.null<Decoder>()
  unsafe discard<BrotliEncoder>(h.brotliEncoder) h.brotliEncoder = Pointer.null<BrotliEncoder>()
  unsafe discard<Brotli>(h.brotliDecoder) h.brotliDecoder = Pointer.null<Brotli>()
  unsafe discard<ZstdEncoder>(h.zstdEncoder) h.zstdEncoder = Pointer.null<ZstdEncoder>()
  unsafe discard<Zstd>(h.zstdDecoder) h.zstdDecoder = Pointer.null<Zstd>()
}
// The status and message zlib's inflate gives for a decoder failure.
fn inflateFailure(kind: ErrorKind) -> i32 {
  return match kind {
    ErrorKind.MissingDictionary => 2
    ErrorKind.DictionaryMismatch => -3001
    ErrorKind.TruncatedInput => -5
    ErrorKind.InvalidUse => -2
    ErrorKind.MemoryLimit => -4
    _ => -3
  }
}
fn inflateMessage(kind: ErrorKind) -> &'static [u8] {
  return match kind {
    ErrorKind.InvalidHeader => b"incorrect header check"
    ErrorKind.UnsupportedMethod => b"unknown compression method"
    ErrorKind.InvalidBlock => b"invalid block type"
    ErrorKind.InvalidHuffman => b"invalid code lengths set"
    ErrorKind.InvalidDistance => b"invalid distance too far back"
    ErrorKind.ChecksumMismatch => b"incorrect data check"
    ErrorKind.SizeMismatch => b"incorrect length check"
    _ => b""
  }
}
// BROTLI_DECODER_ERROR_* for a decoder failure, as the native codec reports it (code - 1000).
fn brotliFailure(reason: BrotliReason) -> i32 {
  return match reason {
    BrotliReason.Truncated => -5
    BrotliReason.WindowBits => -1000 - 13
    BrotliReason.Header => -1000 - 2
    BrotliReason.PrefixCode => -1000 - 7
    BrotliReason.ContextMap => -1000 - 8
    BrotliReason.BlockLength => -1000 - 9
    BrotliReason.Distance => -1000 - 16
    BrotliReason.Dictionary => -1000 - 12
    BrotliReason.WindowLimit => -1000 - 13
    BrotliReason.WorkspaceLimit => -1000 - 30
    _ => -1000 - 31
  }
}
// ZSTD_error_* for a decoder failure (-2000 - code), with ZSTD_getErrorName's text.
fn zstdFailure(reason: ZstdReason) -> i32 {
  return match reason {
    ZstdReason.Truncated => -5
    ZstdReason.InvalidMagic => -2000 - 10
    ZstdReason.ReservedFrame => -2000 - 14
    ZstdReason.WindowLimit => -2000 - 16
    ZstdReason.Checksum => -2000 - 22
    ZstdReason.UnsupportedDictionary => -2000 - 32
    _ => -2000 - 20
  }
}
fn zstdMessage(reason: ZstdReason) -> &'static [u8] {
  return match reason {
    ZstdReason.InvalidMagic => b"Unknown frame descriptor"
    ZstdReason.ReservedFrame => b"Unsupported frame parameter"
    ZstdReason.WindowLimit => b"Frame requires too much memory for decoding"
    ZstdReason.Checksum => b"Restored data doesn't match checksum"
    ZstdReason.UnsupportedDictionary => b"Dictionary mismatch"
    ZstdReason.Truncated => b""
    _ => b"Data corruption detected"
  }
}
// The options of brotli and zstd come as (key, value) pairs of BROTLI_PARAM_* and ZSTD_c_* /
// ZSTD_d_* numbers; those that change nothing these codecs do are accepted and ignored.
// -3002: a parameter this implementation does not have.
unsafe fn brotliOptions(h: &CodecState, options: &mut BrotliOptions) -> i32 {
  let mut offset: usize = 0
  while offset + 8 <= h.paramsLength {
    let key = unsafe word(h.params, offset) let value = unsafe word(h.params, offset + 4)
    if key == 1 { if value < 0 || value > 11 { return -3002 } options.quality = i32.toU32(value) }
    else if key == 2 { if value < 10 || value > 24 { return -3002 } options.windowBits = i32.toU32(value) }
    else if key == 6 && value != 0 { return -3002 }
    else if key > 9 { return -3002 }
    offset = offset + 8
  }
  return 0
}
unsafe fn brotliDecoderOptions(h: &CodecState) -> i32 {
  let mut offset: usize = 0
  while offset + 8 <= h.paramsLength {
    let key = unsafe word(h.params, offset) let value = unsafe word(h.params, offset + 4)
    if key == 1 && value != 0 || key > 1 { return -3002 }
    offset = offset + 8
  }
  return 0
}
unsafe fn zstdOptions(h: &CodecState, options: &mut ZstdOptions) -> i32 {
  let mut offset: usize = 0
  let mut window: i32 = 0
  while offset + 8 <= h.paramsLength {
    let key = unsafe word(h.params, offset) let value = unsafe word(h.params, offset + 4)
    if key == 100 {
      // Levels below 1 (zstd's fast levels) and 0 (its default) are level 1 and 3 here.
      let level = if value == 0 { 3 } else if value < 1 { 1 } else if value > 22 { 22 } else { value }
      let fresh = ZstdOptions.make(i32.toU32(level))
      options.level = fresh.level options.windowLog = fresh.windowLog
    }
    else if key == 101 { window = value }
    else if key == 200 { options.contentSize = value != 0 }
    else if key == 201 { options.checksum = value != 0 }
    else if key == 400 && value != 0 { return -3002 }
    else if key < 100 || key > 1000 { return -3002 }
    offset = offset + 8
  }
  if window != 0 { if window < 10 || window > 27 { return -3002 } options.windowLog = i32.toU32(window) }
  return 0
}
unsafe fn zstdWindowLogMax(h: &CodecState) -> u32 {
  let mut offset: usize = 0
  let mut log: u32 = 27
  while offset + 8 <= h.paramsLength {
    let key = unsafe word(h.params, offset) let value = unsafe word(h.params, offset + 4)
    if key == 100 && value >= 10 && value <= 31 { log = i32.toU32(value) }
    offset = offset + 8
  }
  return log
}
// Sets the stream's dictionary, after its making or a reset. Not for gzip, which has none.
unsafe fn loadDictionary(h: &mut CodecState) -> i32 {
  if h.dictionaryLength == 0 { return 0 }
  let anchor = ()
  let dictionary = unsafe view(&anchor, h.dictionary, 0, h.dictionaryLength)
  if !Pointer.isNull<Encoder>(h.deflater) && (h.kind == 1 || h.kind == 5) {
    let mut a = () let e = unsafe Pointer.borrowMut<(), Encoder>(&mut a, unsafe nonnull(h.deflater))
    return match e.setDictionary(dictionary) { Result<(), EncodeError>.Success { .. } => 0 Result<(), EncodeError>.Failure { .. } => -2 }
  }
  if !Pointer.isNull<Decoder>(h.inflater) && (h.kind == 2 || h.kind == 6) {
    let mut a = () let d = unsafe Pointer.borrowMut<(), Decoder>(&mut a, unsafe nonnull(h.inflater))
    return match d.setDictionary(dictionary) { Result<(), DecodeError>.Success { .. } => 0 Result<(), DecodeError>.Failure { .. } => -2 }
  }
  return 0
}
unsafe effect fn initialize(h: &mut CodecState, numbers: &[i32; 8]) -> i32 ? &mut Allocator {
  let kind = h.kind
  if kind == 1 || kind == 3 || kind == 5 {
    let level = if numbers[2] < 0 { 6 } else { numbers[2] }
    let options = Options { level: i32.toU32(level), windowBits: i32.toU32(numbers[1]), memoryLevel: i32.toU32(numbers[3]), strategy: strategy(numbers[4]), hash: Hash.Multiplicative }
    if numbers[1] < 8 || numbers[1] > 15 || level > 9 || numbers[3] < 1 || numbers[3] > 9 { return -2 }
    match run Effect.result(Encoder.make(deflateFormat(kind), move options)) {
      Result<Encoder, OutOfMemoryError | EncodeError>.Success { value } => {
        h.deflater = unsafe store<Encoder>(move value) if Pointer.isNull<Encoder>(h.deflater) { return -4 }
      }
      Result<Encoder, OutOfMemoryError | EncodeError>.Failure { .. } => { return -2 }
    }
    return unsafe loadDictionary(&mut h)
  }
  if kind == 2 || kind == 4 || kind == 6 || kind == 7 {
    match run Effect.result(Decoder.make(deflateFormat(kind), noLimits())) {
      Result<Decoder, OutOfMemoryError | DecodeError>.Success { value } => {
        h.inflater = unsafe store<Decoder>(move value) if Pointer.isNull<Decoder>(h.inflater) { return -4 }
      }
      Result<Decoder, OutOfMemoryError | DecodeError>.Failure { .. } => { return -4 }
    }
    return unsafe loadDictionary(&mut h)
  }
  // Brotli and Zstandard dictionaries are not in silk.compress.
  if h.dictionaryLength != 0 { return -2 }
  if kind == 8 {
    let mut options = BrotliOptions.make(11)
    let status = unsafe brotliOptions(&h.*, &mut options) if status != 0 { return status }
    match run Effect.result(BrotliEncoder.make(move options)) {
      Result<BrotliEncoder, OutOfMemoryError | BrotliEncodeError>.Success { value } => {
        h.brotliEncoder = unsafe store<BrotliEncoder>(move value) if Pointer.isNull<BrotliEncoder>(h.brotliEncoder) { return -4 }
      }
      Result<BrotliEncoder, OutOfMemoryError | BrotliEncodeError>.Failure { .. } => { return -3002 }
    }
    return 0
  }
  if kind == 9 {
    let status = unsafe brotliDecoderOptions(&h.*) if status != 0 { return status }
    match run Effect.result(Brotli.make(brotliLimits())) {
      Result<Brotli, BrotliError | OutOfMemoryError>.Success { value } => {
        h.brotliDecoder = unsafe store<Brotli>(move value) if Pointer.isNull<Brotli>(h.brotliDecoder) { return -4 }
      }
      Result<Brotli, BrotliError | OutOfMemoryError>.Failure { .. } => { return -4 }
    }
    return 0
  }
  if kind == 10 {
    let mut options = ZstdOptions.make(3)
    let status = unsafe zstdOptions(&h.*, &mut options) if status != 0 { return status }
    match run Effect.result(ZstdEncoder.make(move options)) {
      Result<ZstdEncoder, OutOfMemoryError | ZstdEncodeError>.Success { value } => {
        h.zstdEncoder = unsafe store<ZstdEncoder>(move value) if Pointer.isNull<ZstdEncoder>(h.zstdEncoder) { return -4 }
      }
      Result<ZstdEncoder, OutOfMemoryError | ZstdEncodeError>.Failure { .. } => { return -3002 }
    }
    return 0
  }
  if kind == 11 {
    h.windowLogMax = unsafe zstdWindowLogMax(&h.*)
    return run unsafe renewZstdDecoder(&mut h)
  }
  return -2
}
// The zstd decoder has no reset: a reset makes a new one.
unsafe effect fn renewZstdDecoder(h: &mut CodecState) -> i32 ? &mut Allocator {
  unsafe discard<Zstd>(h.zstdDecoder) h.zstdDecoder = Pointer.null<Zstd>()
  match run Effect.result(Zstd.make(zstdLimits(h.windowLogMax))) {
    Result<Zstd, ZstdError | OutOfMemoryError>.Success { value } => {
      h.zstdDecoder = unsafe store<Zstd>(move value) if Pointer.isNull<Zstd>(h.zstdDecoder) { return -4 }
    }
    Result<Zstd, ZstdError | OutOfMemoryError>.Failure { .. } => { return -4 }
  }
  return 0
}
unsafe fn deflateStep(j: &mut Job, h: &mut CodecState, input: ?*mut u8, length: usize, output: ?*mut u8, capacity: usize) -> () {
  let flush = j.flush
  let mut a = () let e = unsafe Pointer.borrowMut<(), Encoder>(&mut a, unsafe nonnull(h.deflater))
  if j.op == 4 {
    // deflateParams: the new level and strategy take effect from the next block.
    let level = if j.numbers[2] < 0 { 6 } else { j.numbers[2] }
    if level > 9 { j.status = -2 return () }
    match e.setParameters(i32.toU32(level), strategy(j.numbers[3])) { Result<(), EncodeError>.Success { .. } => () Result<(), EncodeError>.Failure { .. } => { j.status = -2 } }
    return ()
  }
  let inAnchor = () let source = unsafe view(&inAnchor, input, 0, length)
  let mut outAnchor = () let destination = unsafe viewMut(&mut outAnchor, output, 0, capacity)
  match e.step(source, move destination, deflateFlush(flush)) {
    Result<EncodeProgress, EncodeError>.Success { value } => {
      j.consumed = value.consumed j.written = value.written
      match value.status {
        EncodeStatus.NeedOutput => { j.again = true }
        EncodeStatus.Finished => { h.ended = true j.finished = true }
        _ => ()
      }
    }
    Result<EncodeProgress, EncodeError>.Failure { error } => { j.consumed = error.consumed j.written = error.written j.status = -2 }
  }
}
unsafe fn inflateStep(j: &mut Job, h: &mut CodecState, input: ?*mut u8, length: usize, output: ?*mut u8, capacity: usize) -> () {
  let flush = j.flush let kind = h.kind
  if h.ended {
    if h.strict && length != 0 { j.status = -3000 return () }
    if !h.gzip || length == 0 { j.finished = true return () }
    // After a gzip member: zero bytes are padding, anything else is the next member.
    let first = unsafe Pointer.read<u8>(unsafe at(input, 0))
    if first == 0 { h.ignoring = true j.finished = true return () }
    let mut a = () let d = unsafe Pointer.borrowMut<(), Decoder>(&mut a, unsafe nonnull(h.inflater))
    match d.reset(Format.Gzip, noLimits()) { Result<(), DecodeError>.Success { .. } => () Result<(), DecodeError>.Failure { .. } => { j.status = -2 return () } }
    drop d h.ended = false
  }
  let mut skip: usize = 0
  if kind == 7 && h.headerLength < 2 {
    // unzip: gzip when the stream starts with its magic, else zlib.
    let before = h.headerLength
    while skip < length && h.headerLength < 2 {
      h.header = u32.bitOr(h.header, u32.shiftLeft(u8.toU32(unsafe Pointer.read<u8>(unsafe at(input, skip))), h.headerLength * 8))
      h.headerLength = h.headerLength + 1 skip = skip + 1
    }
    if h.headerLength < 2 {
      j.consumed = length
      if flush == 4 { j.status = -5 }
      return ()
    }
    h.gzip = h.header == 35615
