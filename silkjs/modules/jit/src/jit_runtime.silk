struct LoopBook { sites: List<u32>, spent: u64,
  /// With --jit-dump, the function's bytecode, to name the opcodes its code deoptimized at.
  code: List<u8> }

/// The loop header of a report from entries (CompiledTable.loopPc).
const NO_LOOP: u32 = 4294967295
/// Loop headers per table entry that get OSR code; polls at more are refused.
const OSR_HEADERS: usize = 8
/// Nanoseconds of OSR compilation per table entry after which its further headers are refused.
const OSR_BUDGET_NS: u64 = 50000000
/// Bytecode bytes of a loop (ssa_translate.loopRegion) above which OSR is refused.
const OSR_LOOP_BYTES: u32 = 16384

/// Functions one runtime can have compiled; the table never moves.
pub const CAPACITY: usize = 4096
/// u64 words of the runtime's activation stack (js_vm.runActivations): 2 MiB, room for about a
/// thousand nested activations before calls take native frames.
pub const ACTIVATION_WORDS: usize = 262144
/// Inline targets one runtime's code may name (each retained until the runtime goes).
pub const KEPT_CAPACITY: usize = 16384
/// Entries of the table the runtime records cached field sites' shapes in for the optimizer
/// (js_compiled_inline.setSiteShapes): a power of two.
pub const SITE_SHAPE_ENTRIES: usize = 4096
/// The most shapes a site is compiled against (js_core_types.SITE_SHAPES).
const SITE_PAIRS: u32 = 4
/// Candidates looked up for one compilation, nested ones included, and how deep they nest.
const MAX_CANDIDATES: usize = 128
const CANDIDATE_DEPTH: u32 = 6
/// A callee longer than this many bytes of code is not a candidate (ssa_translate's limit).
const CANDIDATE_BYTES: usize = 460
/// Tighter limits for `OP_get_var` -> `OP_call` candidates so large/looped global helpers stay out-of-line.
/// A call that passes a literal number to a parameter the callee compares with a literal
/// (`decides`) has the general limit: the body is compiled for that number, the branch is
/// decided and the side not taken goes (NavierStokes' `lin_solve(0, p, div, 1, 4)`, whose
/// body starts `if (a === 0 && c === 1)`).
const VAR_CALL_BYTES: usize = 96
const VAR_CALL_DEPTH: u32 = 2
/// Largest caller (in bytecode bytes) allowed to inline a looped var-call helper at depth 0:
/// larger callers can hold dozens of such sites whose duplicated loops cost more to compile
/// than the call overhead saves.
const LOOPED_VAR_CALLER_BYTES: usize = 1500
/// Address space reserved for machine code.
const CODE_BYTES: usize = 67108864

pub struct Options {
  /// --jit: compile hot functions.
  pub enabled: bool,
  /// --jit-threshold=N: entries before a function is reported hot (engine default 1000).
  pub threshold: u32,
  /// --jit-stress=N: every compiled guard also fails on its Nth evaluation, and so on.
  pub stress: u32,
  /// --jit-deopt-limit=N: deopts after which the engine unlinks a function (0: never).
  pub deoptLimit: u32,
  /// --jit-stats: print counters to stderr at exit.
  pub stats: bool,
  /// --jit-dump: print each hot function's bytecode and the compile outcome to stderr.
  pub dump: bool,
  /// --jit-no-inline clears it: method calls whose site names one small plain function run
  /// that function's body in place, guarded by its identity (docs/jit/inlining.md).
  pub inlining: bool,
  /// --jit-calls: compile functions that make calls (call exits, compiled-entry.md 7.3). Off by
  /// default until calls between compiled functions are direct: through the engine a call costs
  /// more than the interpreter's inline call.
  pub calls: bool,
  /// --jit-compile-budget=N: bytecode bytes a function may have translated in all, over its
  /// normal and OSR lowerings and recompilations (0: no budget). Every lowering translates the
  /// whole body, once per loop header for OSR, so compile cost grows with size times headers
  /// times reports while the run it can speed up does not.
  pub compileBudget: u32,
  /// --jit-profile=N: a function reported hot at its entry first records feedback
  /// (js_feedback) for N of its instructions, and is compiled at its next report with the
  /// arithmetic sites that saw a double or an overflow as number sites (0: compile at once;
  /// default DEFAULT_PROFILE).
  pub profile: u32,
  /// --jit-foresee=MASK: the FORESEE_* refusals a recording may make (default FORESEE_ALL).
  pub foresee: u32,
  /// --jit-no-<pass> clears a bit: the code quality passes that run (ssa_opt.PASS_*).
  pub passes: u32,
  /// --jit-baseline: hot functions get baseline code (docs/jit/baseline.md) and nothing else.
  pub baseline: bool,
  /// --jit-opt, with --jit-baseline: baseline code counts its entries and a function that
  /// keeps running gets optimized code on the same frame (docs/jit/optimizer.md).
  pub optimize: bool,
  /// --jit-opt=N: the entries baseline code runs before the function is optimized.
  pub optimizeEntries: u32
}
/// The default of Options.optimizeEntries: enough runs for the site caches the optimizer
/// reads to have settled.
pub const OPTIMIZE_ENTRIES: u32 = 500
/// The compile budget's default, in bytecode bytes (measured: K-doubles report, "Compile budget").
pub const DEFAULT_COMPILE_BUDGET: u32 = 32768
/// Entries before a function is hot when only the baseline tier compiles and no
/// --jit-threshold is given. Baseline code costs about 4,700 instructions to make per
/// bytecode instruction and saves about 20 each time one runs, so it pays after a few
/// hundred executions; the eight V8 benchmarks run the same or fewer instructions at 100
/// than at the engine's 1000 (docs/jit/baseline.md).
pub const BASELINE_ENTRIES: u32 = 100
impl Options {
  pub fn make() -> Self {
    return Self { enabled: false, threshold: 0, stress: 0, deoptLimit: 8, stats: false, dump: false, calls: false, compileBudget: DEFAULT_COMPILE_BUDGET, profile: DEFAULT_PROFILE, foresee: FORESEE_ALL, passes: 4294967295, inlining: true, baseline: false, optimize: false, optimizeEntries: OPTIMIZE_ENTRIES }
  }
}

/// What the optimizer needs of a function's baseline code, by its baseline index: where it
/// runs, where its `moved` and `finish` tails are in it (optimized code's exits go on
/// there), and what came of its report to the optimizer (TIER_*).
/// exits counts the guard failures of its optimized code since that was linked, and
/// compiles the optimized code it has had. learned is set when that code left at a site
/// its next compile will know (a new one, or a field site recorded with a new shape);
/// stale counts the times in a row it was given back without having learned one; waits
/// the times its first optimization was put off for method calls not yet run (unseenCalls),
/// and unseen how many there were when it was last put off.
struct BaselineInfo { entry: usize, code: *const u8, construct: *const u8, moved: usize, finish: usize, stepEnded: usize, tier: u8, compiles: u8, exits: u32, learned: bool, hasLoop: bool, stale: u8, waits: u8, unseen: u32 }
impl Copy for BaselineInfo {}
/// Optimized code that left at guards this often, and at more than one entry in EXIT_RATE
/// (a loop's turns do not count: code that leaves on each is slow whatever its entries),
/// gives the function back to its baseline code. It is optimized again, with the sites it
/// left at kept general (a site that left once is stepped where it would leave again,
/// x64_backend.stepOnFrame): after the usual wait when leaving taught its next compile a
/// site (each compile then leaves at fewer, and a function has at most MAX_LEFT), else
/// once it ran OPTIMIZE_BACKOFF times longer than the time before, up to some sixteen
/// million entries. No function keeps its baseline code for good. Code with a loop is given
/// back at the first exit of an arithmetic site (noteLeft): the rest of that activation runs
/// in baseline code, which notes its other such sites.
const EXIT_BURST: u32 = 8
const EXIT_RATE: u64 = 1000
const OPTIMIZE_BACKOFF: u32 = 8
/// Jit.leftHow: a compile kept the site general; code compiled so left there again.
const LEFT_GENERAL: u8 = 1
const LEFT_AGAIN: u8 = 2
/// Sites remembered per function (Jit.leftAt).
const MAX_LEFT: usize = 32
const TIER_NONE: u8 = 0
const TIER_OPTIMIZED: u8 = 1
const TIER_REFUSED: u8 = 2
/// js_baseline.countFrom's argument that leaves a count as far from the shared prologue's
/// next report as it goes.
const PARKED: u32 = 2147483647

pub struct Jit {
  pub options: Options,
  memory: Option<CodeMemory>,
  entries: List<CompiledEntry>,
  /// Storage lent to the runtime for its activation stack (never grows, so never moves).
  activations: List<u64>,
  /// Storage lent to the runtime for the inline targets it keeps alive (js_compiled_inline).
  kept: List<ValueBits>,
  /// Storage lent to the runtime for what cached field sites read from (SITE_SHAPE_ENTRIES
  /// entries with the optimizer on, none otherwise).
  siteShapes: List<SiteShapes>,
  /// Functions inlined into installed code, by site.
  pub inlinedSites: u64,
  /// One CompiledEnv, in storage that never moves (every entry's env points at it).
  pub env: List<CompiledEnv>,
  blocks: List<CodeBlock>,
  /// Countdown the stress configuration's guards share (CompiledEntry.data).
  stressCounter: i32,
  handler: HotHandler,
  pub runtime: ?*mut HeapHeader,
  pub reported: u64,
  pub compiledFunctions: u64,
  pub refused: u64,
  pub failed: u64,
  pub codeBytes: u64,
  /// The address the last installed code runs at.
  pub lastEntry: u64,
  /// Monotonic nanoseconds spent in compileHot, refusals included.
  pub compileNanoseconds: u64,
  /// Sums of the table's counters (collect).
  pub runs: u64,
  pub deopts: u64,
  pub polls: u64,
  pub unlinked: u64,
  /// Earlier compilations per function and their deopt sites (jit_recompile).
  history: History,
  /// Reports of functions compiled or refused before (recompilations attempted).
  pub recompiled: u64,
  /// Loop-header entries (docs/jit/osr.md): per linked function, the list its
  /// CompiledEntry.osr points into (never appended to once linked).
  osrLists: List<List<OsrEntry>>,
  /// Per table entry: the double sites it was compiled with (for its loop headers, compiled
  /// later) and the nanoseconds its loop headers took to compile.
  books: List<LoopBook>,
  pub osrCompiled: u64,
  pub osrRefused: u64,
  /// Functions linked for on-stack replacement only (their normal entry was refused).
  pub osrOnly: u64,
  pub osrRuns: u64,
  pub osrDeopts: u64,
  /// Compile time by phase and the sizes compiled (jit_cost).
  pub cost: Cost,
  /// Lowerings skipped by the compile budget (Options.compileBudget).
  pub overBudget: u64,
  /// Recompilations put off until the function ran more (jit_recompile.backoff).
  pub waited: u64,
  /// Functions sent to record feedback before their first compilation, and the number sites
  /// those recordings gave (Options.profile).
  pub profiled: u64,
  pub learned: u64,
  /// Functions refused because their recording showed a site the code would deoptimize at.
  pub foreseen: u64,
  /// Generic instruction exits in installed code (--jit-stats generic-sites).
  pub genericSites: u64,
  /// Baseline code (Options.baseline): the table lent to the runtime, the environment its
  /// code runs with (neither ever moves), what it is compiled against, and whether the
  /// entry and release stubs are in place.
  baselineTable: List<?*const u8>,
  pub baselineEnv: List<BaselineEnv>,
  baselineSettings: Option<BaselineSettings>,
  baselineReady: bool,
  /// Where the shared stubs run (baseline.stubs), by STUB_* index: the symbols of every
  /// function's code.
  baselineSymbols: List<usize>,
  pub baselineCompiled: u64,
  pub baselineRefused: u64,
  pub baselineBytes: u64,
  /// Reachable instructions without a template in installed baseline code.
  pub baselineUncovered: u64,
  /// Options.optimize: each baseline function's BaselineInfo, the functions optimized and
  /// refused, and the bytes of optimized code.
  baselineInfo: List<BaselineInfo>,
  /// Where optimized code left at a guard: a function's index in baselineInfo in the high
  /// half, the bytecode offset in the low. Its next compilation keeps those sites general.
  leftAt: List<u64>,
  /// By leftAt entry: how many shapes the site was recorded with (inline.siteSeen) when
  /// code first left there, then when a compile last took it as learned. A field site
  /// recorded with more by the next compile learned a shape from leaving, and is compiled
  /// against its shapes again instead of kept general.
  leftSeen: List<u32>,
  /// By leftAt entry: LEFT_GENERAL once a compile kept the site general, LEFT_AGAIN once
  /// code compiled so left there again. Such a site is named twice to the next compile,
  /// which has the engine run its instruction (ssa_translate.stepped).
  leftHow: List<u8>,
  /// The Array.prototype push and pop natives optimized code tests callees against
  /// (inline.arrayNative): each is kept by the runtime from when it is first used.
  arrayNatives: List<usize>,
  /// The records optimized code reads slots of as constants (inline.cellRecord), each
  /// watched from the compile that first found it in a target's variable cells.
  records: List<WatchedRecord>,
  /// Inlined construct descriptors (`Op.NewObject`), fixed-capacity so linked pointers never move.
  constructDescs: List<ConstructDesc>,
  /// Functions given back to their baseline code for leaving too often.
  pub optimizeBacked: u64,
  pub optimized: u64,
  pub optimizeRefused: u64,
  pub optimizedBytes: u64
}
/// Maximum distinct inlined construct descriptors per runtime (storage never reallocates).
const CONSTRUCT_DESC_CAPACITY: usize = 512
impl Jit {
  pub effect fn make(options: Options) -> Self ! OutOfMemoryError ? &mut Allocator {
    let entries = run List<CompiledEntry>.makeWithCapacity(CAPACITY)
    let activations = run List<u64>.makeWithCapacity(ACTIVATION_WORDS)
    let kept = run List<ValueBits>.makeWithCapacity(KEPT_CAPACITY)
    let mut siteShapes = List<SiteShapes>.make()
    if options.baseline && options.optimize { run siteShapes.appendRepeated(SiteShapes.none(), SITE_SHAPE_ENTRIES) }
    let mut env = run List<CompiledEnv>.makeWithCapacity(1)
    drop env.appendWithinCapacity(CompiledEnv.make())
    // Two entries a function (js_baseline.link).
    let baselineTable = run List<?*const u8>.makeWithCapacity(CAPACITY * engineBaseline.TABLE_WORDS)
    let mut baselineEnv = run List<BaselineEnv>.makeWithCapacity(1)
    drop baselineEnv.appendWithinCapacity(BaselineEnv.make())
    let constructDescs = run List<ConstructDesc>.makeWithCapacity(CONSTRUCT_DESC_CAPACITY)
    return Self { options: move options, memory: Option<CodeMemory>.none(), entries: move entries, activations: move activations, kept: move kept, siteShapes: move siteShapes, inlinedSites: 0, env: move env, blocks: List<CodeBlock>.make(),
      stressCounter: 0, handler: HotHandler { function: hotAddress(), data: Pointer.null<u8>() }, runtime: Pointer.null<HeapHeader>(),
      reported: 0, compiledFunctions: 0, refused: 0, failed: 0, codeBytes: 0, lastEntry: 0, compileNanoseconds: 0, runs: 0, deopts: 0, polls: 0, unlinked: 0,
      history: History.make(), recompiled: 0,
      osrLists: List<List<OsrEntry>>.make(), books: List<LoopBook>.make(), osrCompiled: 0, osrRefused: 0, osrOnly: 0, osrRuns: 0, osrDeopts: 0, cost: Cost.make(), overBudget: 0, waited: 0, profiled: 0, learned: 0, foreseen: 0, genericSites: 0,
      baselineTable: move baselineTable, baselineEnv: move baselineEnv, baselineSettings: Option<BaselineSettings>.none(), baselineReady: false, baselineSymbols: List<usize>.make(),
      baselineCompiled: 0, baselineRefused: 0, baselineBytes: 0, baselineUncovered: 0,
      baselineInfo: List<BaselineInfo>.make(), leftAt: List<u64>.make(), leftSeen: List<u32>.make(), leftHow: List<u8>.make(), arrayNatives: List<usize>.make(), records: List<WatchedRecord>.make(), constructDescs: move constructDescs, optimizeBacked: 0, optimized: 0, optimizeRefused: 0, optimizedBytes: 0 }
  }
  /// The runtime setup callback (QjsOptions.runtimeSetup) and its data word for self.
  pub fn setupAddress() -> *const u8 {
    let function: extern "C" fn(*mut HeapHeader, ?*mut u8) -> () = jitRuntimeSetup
    let slot = unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut HeapHeader, ?*mut u8) -> (), *const *const u8>(Pointer.fromRef(&function))
    return unsafe Pointer.read<*const u8>(slot)
  }
  pub fn setupData(self: &mut Self) -> ?*mut u8 {
    return unsafe Intrinsic.pointerReinterpret<*mut Jit, *mut u8>(Pointer.fromMutRef<Jit>(&mut self))
  }
  /// Installs the host's optional Tier-3 pooled fresh-cell allocator callback (AllocCellFn).
  pub fn setAllocCell(self: &mut Self, raw: ?*const u8) -> () {
    let mut env = self.env.asSlice()[0]
    env.allocCell = raw
    self.env.set(0, env)
  }
  /// The counters (--jit-stats) as one line.
  pub effect fn statsLine(self: &Self) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
    let mut line = List<u8>.make()
    run line.appendSlice(b"jit: reported ") run decimal(&mut line, self.reported)
    run line.appendSlice(b" compiled ") run decimal(&mut line, self.compiledFunctions)
    run line.appendSlice(b" refused ") run decimal(&mut line, self.refused)
    run line.appendSlice(b" failed ") run decimal(&mut line, self.failed)
    run line.appendSlice(b" runs ") run decimal(&mut line, self.runs)
    run line.appendSlice(b" deopts ") run decimal(&mut line, self.deopts)
    run line.appendSlice(b" polls ") run decimal(&mut line, self.polls)
    run line.appendSlice(b" unlinked ") run decimal(&mut line, self.unlinked)
    run line.appendSlice(b" recompiled ") run decimal(&mut line, self.recompiled)
    run line.appendSlice(b" direct-calls ") run decimal(&mut line, self.env.get(0).directCalls)
    run line.appendSlice(b" generic-sites ") run decimal(&mut line, self.genericSites)
    run line.appendSlice(b" generic-runs ") run decimal(&mut line, self.env.get(0).genericRuns)
    run line.appendSlice(b" inlined ") run decimal(&mut line, self.inlinedSites)
    run line.appendSlice(b" osr-compiled ") run decimal(&mut line, self.osrCompiled)
    run line.appendSlice(b" osr-refused ") run decimal(&mut line, self.osrRefused)
    run line.appendSlice(b" osr-only ") run decimal(&mut line, self.osrOnly)
    run line.appendSlice(b" osr-runs ") run decimal(&mut line, self.osrRuns)
    run line.appendSlice(b" osr-deopts ") run decimal(&mut line, self.osrDeopts)
    run line.appendSlice(b" code-bytes ") run decimal(&mut line, self.codeBytes)
    run line.appendSlice(b" compile-ns ") run decimal(&mut line, self.compileNanoseconds)
    run line.appendSlice(b" translate-ns ") run decimal(&mut line, self.cost.translate)
    run line.appendSlice(b" optimize-ns ") run decimal(&mut line, self.cost.optimize)
    run line.appendSlice(b" verify-ns ") run decimal(&mut line, self.cost.verify)
    run line.appendSlice(b" backend-ns ") run decimal(&mut line, self.cost.backend)
    run line.appendSlice(b" attempts ") run decimal(&mut line, self.cost.attempts)
    run line.appendSlice(b" bytecode-bytes ") run decimal(&mut line, self.cost.bytecodeBytes)
    run line.appendSlice(b" ssa-translated ") run decimal(&mut line, self.cost.translated)
    run line.appendSlice(b" ssa-optimized ") run decimal(&mut line, self.cost.optimized)
    run line.appendSlice(b" over-budget ") run decimal(&mut line, self.overBudget)
    run line.appendSlice(b" waited ") run decimal(&mut line, self.waited)
    run line.appendSlice(b" profiled ") run decimal(&mut line, self.profiled)
    run line.appendSlice(b" learned ") run decimal(&mut line, self.learned)
    run line.appendSlice(b" foreseen ") run decimal(&mut line, self.foreseen)
    run line.appendSlice(b" baseline-compiled ") run decimal(&mut line, self.baselineCompiled)
    run line.appendSlice(b" baseline-refused ") run decimal(&mut line, self.baselineRefused)
    run line.appendSlice(b" baseline-bytes ") run decimal(&mut line, self.baselineBytes)
    run line.appendSlice(b" baseline-uncovered ") run decimal(&mut line, self.baselineUncovered)
    run line.appendSlice(b" baseline-departures ") run decimal(&mut line, self.baselineEnv.asSlice()[0].departures)
    run line.appendSlice(b" baseline-service-calls ") run decimal(&mut line, self.baselineEnv.asSlice()[0].serviceCalls)
    run line.appendSlice(b" baseline-direct-calls ") run decimal(&mut line, self.baselineEnv.asSlice()[0].directCalls)
    run line.appendSlice(b" baseline-steps ") run decimal(&mut line, self.baselineEnv.asSlice()[0].steps)
    let mut code: usize = 0
    while code < 256 {
      let n = self.baselineEnv.asSlice()[0].stepCounts[code]
      if n != 0 { run line.appendSlice(b" step:") run line.appendSlice(op.opcodeName(usize.toU8(code), true)) run line.append(32) run decimal(&mut line, n) }
      code = code + 1
    }
    run line.appendSlice(b" baseline-steps-ended ") run decimal(&mut line, self.baselineEnv.asSlice()[0].stepsEnded)
    run line.appendSlice(b" baseline-resumes ") run decimal(&mut line, self.baselineEnv.asSlice()[0].resumes)
    run line.appendSlice(b" optimized ") run decimal(&mut line, self.optimized)
    run line.appendSlice(b" optimize-refused ") run decimal(&mut line, self.optimizeRefused)
    run line.appendSlice(b" optimized-bytes ") run decimal(&mut line, self.optimizedBytes)
    run line.appendSlice(b" optimize-backed ") run decimal(&mut line, self.optimizeBacked)
    run line.appendSlice(b" frame-exits ") run decimal(&mut line, self.baselineEnv.asSlice()[0].frameExits)
    run line.appendSlice(b" inlined-exits ") run decimal(&mut line, self.baselineEnv.asSlice()[0].inlinedExits)
    code = 0
    while code < 256 {
      let n = self.baselineEnv.asSlice()[0].exitCounts[code]
      if n != 0 { run line.appendSlice(b" exit:") run line.appendSlice(op.opcodeName(usize.toU8(code), true)) run line.append(32) run decimal(&mut line, n) }
      code = code + 1
    }
    run line.append(10)
    return move line
  }
  /// --jit-dump at exit: each entry that deoptimized, with its runs and first deopt pcs.
  pub effect fn deoptLines(self: &Self) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
    let mut line = List<u8>.make()
    let entries = self.entries.asSlice()
    let mut index: usize = 0
    while index < entries.length {
      let entry = &entries[index]
      if entry.deopts > 0 {
        run line.appendSlice(b"jit: entry ") run decimal(&mut line, usize.toU64(index))
        run line.appendSlice(b" runs ") run decimal(&mut line, entry.runs)
        run line.appendSlice(b" deopts ") run decimal(&mut line, entry.deopts)
        if entry.deoptLimit != 0 && entry.deopts >= u32.toU64(entry.deoptLimit) { run line.appendSlice(b" unlinked") }
        run line.appendSlice(b" at")
        let mut k: usize = 0
        while k < u8.toUsize(entry.deoptPcCount) { run line.append(32) run decimal(&mut line, u32.toU64(entry.deoptPcs[k])) k = k + 1 }
        run line.append(10)
      }
      index = index + 1
    }
    return move line
  }
  /// --jit-dump: the opcode each OSR entry last deoptimized at, with its deopts.
  pub effect fn dumpOsrDeopts(self: &Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let entries = self.entries.asSlice()
    let mut index: usize = 0
    while index < entries.length {
      let count = entries[index].osrCount
      if count != 0 {
        let list = unsafe Pointer.assumeMany<OsrEntry>(unsafe Intrinsic.pointerRequalify<?*mut OsrEntry, *const OsrEntry>(entries[index].osr))
        let mut i: u32 = 0
        while i < count {
          let osr = unsafe Pointer.read<OsrEntry>(unsafe Pointer.at<OsrEntry>(list, u32.toUsize(i)))
          if osr.deopts != 0 && osr.deoptOpcode != 0 {
            let mut line = List<u8>.make()
            run line.appendSlice(b"jit: osr deoptimized at: ") run line.appendSlice(op.opcodeName(u32.wrappingToU8(osr.deoptOpcode - 1), true))
            run line.appendSlice(b" x") run decimal(&mut line, u32.toU64(osr.deopts)) run line.append(10)
            io.stderr(line.asSlice())
          }
          i = i + 1
        }
      }
      // The entry code's own deopts: `jit: unlinked after: <opcodes>` or `jit: deopts at: <opcodes>`.
      if entries[index].deopts != 0 && index < self.books.length() {
        let code = self.books.asSlice()[index].code.asSlice()
        let mut line = List<u8>.make()
        if entries[index].deoptLimit != 0 && entries[index].deopts >= u32.toU64(entries[index].deoptLimit) { run line.appendSlice(b"jit: unlinked after:") }
        else { run line.appendSlice(b"jit: deopts at:") }
        let mut k: usize = 0
        while k < u8.toUsize(entries[index].deoptPcCount) {
          let pc = u32.toUsize(entries[index].deoptPcs[k])
          if pc < code.length { run line.append(32) run line.appendSlice(op.opcodeName(code[pc], true)) }
          k = k + 1
        }
        run line.append(10)
        io.stderr(line.asSlice())
      }
      index = index + 1
    }
  }
  /// Sums the compiled code table's counters into runs, deopts, polls and unlinked.
  pub fn collect(self: &mut Self) -> () {
    self.runs = 0 self.deopts = 0 self.polls = 0 self.unlinked = 0 self.osrRuns = 0 self.osrDeopts = 0
    let entries = self.entries.asSlice()
    let mut index: usize = 0
    while index < entries.length {
      let entry = &entries[index]
      self.runs = self.runs + entry.runs self.deopts = self.deopts + entry.deopts self.polls = self.polls + entry.polls
      self.osrRuns = self.osrRuns + entry.osrRuns self.osrDeopts = self.osrDeopts + entry.osrDeopts
      if entry.deoptLimit != 0 && entry.deopts >= u32.toU64(entry.deoptLimit) { self.unlinked = self.unlinked + 1 }
      index = index + 1
    }
  }
}

pub effect fn decimal(line: &mut List<u8>, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20]
  let mut count: usize = 0
  let mut rest = value
  while true {
    digits[count] = u64.wrappingToU8(rest % 10) + 48
    count = count + 1 rest = rest / 10
    if rest == 0 { break }
  }
  while count > 0 { count = count - 1 run line.append(digits[count]) }
}
effect fn hex(line: &mut List<u8>, value: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let table = b"0123456789abcdef"
  run line.append(table[u8.toUsize(u8.shiftRight(value, 4))]) run line.append(table[u8.toUsize(value & 15)])
}

fn hotAddress() -> *const u8 {
  let function: extern "C" fn(*mut HeapHeader, *mut HeapHeader, ?*mut u8) -> () = jitHotFunction
  let slot = unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut HeapHeader, *mut HeapHeader, ?*mut u8) -> (), *const *const u8>(Pointer.fromRef(&function))
  return unsafe Pointer.read<*const u8>(slot)
}
unsafe fn jitOf<'a>(anchor: &'a mut (), data: ?*mut u8) -> &'a mut Jit {
  return unsafe Pointer.borrowMut<(), Jit>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Jit>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(data)))
}

/// QjsOptions.runtimeSetup: installs the hot handler and the compiled code table.
export "C" fn jitRuntimeSetup(rt: *mut HeapHeader, data: ?*mut u8) -> () {
  let mut anchor = ()
  let jit = unsafe jitOf(&mut anchor, data)
  unsafe enable(&mut jit, rt)
}
/// Enables hot-function compilation in a host that forwards C_HOT_FUNCTION reports. A Jit
/// attaches once, to a runtime with no compiled code table or hot handler. Call on the runtime's
/// owning thread and keep the Jit alive at the same address until the runtime is destroyed.
pub unsafe fn enable(jit: &mut Jit, rt: *mut HeapHeader) -> () {
  if !jit.options.enabled { return () }
  if !Pointer.isNull<HeapHeader>(jit.runtime) { Intrinsic.trap("JIT already attached") }
  unsafe attach(&mut jit, rt)
  let data = jit.setupData()
  jit.handler.data = data
  let handler = unsafe Intrinsic.pointerReinterpret<*mut HotHandler, *mut u8>(Pointer.fromMutRef<HotHandler>(&mut jit.handler))
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: C_HOT_FUNCTION }), opaque: handler })
}
/// Gives rt jit's compiled code table and hot budget. An embedder that is not the libc
/// session sets its own hot function handler and calls compileHot from it.
pub unsafe fn attach(jit: &mut Jit, rt: *mut HeapHeader) -> () {
  jit.runtime = rt
  let prevAlloc = jit.env.asSlice()[0].allocCell
  let mut env = CompiledEnv.make()
  env.runtime = rt
  env.allocCell = prevAlloc
  jit.env.set(0, env)
  let mut threshold = jit.options.threshold
  if threshold == 0 && jit.options.baseline { threshold = BASELINE_ENTRIES }
  if threshold != 0 { unsafe runtime.setHotEntryBudget(rt, threshold) }
  let table = unsafe jit.entries.storage()
  unsafe runtime.setCompiledTable(rt, unsafe Intrinsic.pointerRequalify<?[*]mut CompiledEntry, ?*mut CompiledEntry>(table), usize.toU32(CAPACITY))
  let stack = unsafe jit.activations.storage()
  unsafe runtime.setActivationStack(rt, unsafe Intrinsic.pointerRequalify<?[*]mut u64, ?*mut u64>(stack), ACTIVATION_WORDS)
  let kept = unsafe jit.kept.storage()
  unsafe inline.setKept(rt, unsafe Intrinsic.pointerRequalify<?[*]mut ValueBits, ?*mut ValueBits>(kept), KEPT_CAPACITY)
  if jit.options.baseline {
    let mut baselineEnv = BaselineEnv.make()
    baselineEnv.runtime = rt
    if jit.options.optimize {
      let recorded = unsafe jit.siteShapes.storage()
      unsafe inline.setSiteShapes(rt, unsafe Intrinsic.pointerRequalify<?[*]mut SiteShapes, ?*mut SiteShapes>(recorded), jit.siteShapes.length())
      // The helpers of optimized code: the report that makes it, its exits, and the
      // CompiledEnv whose helpers it calls for what it has no stub for.
      baselineEnv.owner = jit.setupData()
      let tier: extern "C" fn(*mut BaselineEnv, *mut HeapHeader, ?*mut HeapHeader, u32) -> () = jitTierUp
      baselineEnv.helpers[u32.toUsize(baseline_env.TIER)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut HeapHeader, ?*mut HeapHeader, u32) -> (), *const ?*const u8>(Pointer.fromRef(&tier)))
      let exit: extern "C" fn(*mut BaselineEnv, *mut BaselineFrame, *mut u8, *mut u32, *mut u64, u32) -> u64 = jitFrameLeft
      baselineEnv.helpers[u32.toUsize(baseline_env.FRAME_EXIT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut BaselineFrame, *mut u8, *mut u32, *mut u64, u32) -> u64, *const ?*const u8>(Pointer.fromRef(&exit)))
      baselineEnv.compiled = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut CompiledEnv, *mut u8>(Pointer.fromMutRef<CompiledEnv>(&mut jit.env.asMutSlice()[0])))
    }
    jit.baselineEnv.set(0, baselineEnv)
    jit.baselineSettings = baseline.probe(jit.options.stats, jit.options.optimize)
    let slots = unsafe jit.baselineTable.storage()
    unsafe engineBaseline.setTable(rt, unsafe Intrinsic.pointerRequalify<?[*]mut ?*const u8, ?*mut ?*const u8>(slots))
  }
}

/// Publishes the entry and release stubs of baseline code and gives the runtime its entry,
/// once. False when they cannot be made.
unsafe effect fn baselineStubs(jit: &mut Jit, settings: &BaselineSettings) -> bool ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  if jit.baselineReady { return true }
  let rt = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  let mut entryCode = match move run Effect.result(baseline.entryStub(settings)) {
    Result<Code, OutOfMemoryError | UnboundLabelError>.Success { value } => move value
    Result<Code, OutOfMemoryError | UnboundLabelError>.Failure { .. } => { return false }
  }
  let mut releaseCode = match move run Effect.result(baseline.releaseStub()) {
    Result<Code, OutOfMemoryError | UnboundLabelError>.Success { value } => move value
    Result<Code, OutOfMemoryError | UnboundLabelError>.Failure { .. } => { return false }
  }
  let shared = match move run Effect.result(baseline.stubs(settings)) {
    Result<BaselineStubs, OutOfMemoryError | UnboundLabelError>.Success { value } => move value
    Result<BaselineStubs, OutOfMemoryError | UnboundLabelError>.Failure { .. } => { return false }
  }
  if jit.memory.isNone() { jit.memory = Option<CodeMemory>.some(run CodeMemory.reserve(CODE_BYTES)) }
  let none = List<usize>.make()
  match move shared {
    BaselineStubs { code: made, offsets } => {
      let mut sharedCode = move made
      let sharedBlock = match &mut jit.memory {
        Option<CodeMemory>.Some { value } => run publishIn(&mut value, PACK_BASE_HOT, &mut sharedCode, none.asSlice())
        Option<CodeMemory>.None => { return false }
      }
      let base = Pointer.address<u8>(sharedBlock.entry())
      run jit.blocks.append(move sharedBlock)
      let mut which: usize = 0
      while which < offsets.length() { run jit.baselineSymbols.append(base + u32.toUsize(offsets.get(which))) which = which + 1 }
      jit.baselineBytes = jit.baselineBytes + usize.toU64(sharedCode.bytes.length())
      if jit.options.dump {
        // The stubs as one more piece of code, each start a place of its own (@4608 + index).
        run dumpPlaced(b"jit: baseline code at ", base, &sharedCode)
        let mut places = List<u8>.make()
        run places.appendSlice(b"jit: baseline map")
        which = 0
        while which < offsets.length() {
          run places.append(32)
          run decimal(&mut places, u32.toU64(offsets.get(which)))
          run places.appendSlice(b":0:@")
          run decimal(&mut places, u32.toU64(baseline.MARK_STUB) + usize.toU64(which))
          which = which + 1
        }
        run places.append(10)
        io.stderr(places.asSlice())
      }
    }
  }
  let entryBlock = match &mut jit.memory {
    Option<CodeMemory>.Some { value } => run publishIn(&mut value, PACK_OPT_HOT, &mut entryCode, none.asSlice())
    Option<CodeMemory>.None => { return false }
  }
  let releaseBlock = match &mut jit.memory {
    Option<CodeMemory>.Some { value } => run publishIn(&mut value, PACK_OPT_HOT, &mut releaseCode, none.asSlice())
    Option<CodeMemory>.None => { return false }
  }
  let enter = entryBlock.entry()
  let release = releaseBlock.entry()
  run jit.blocks.append(move entryBlock)
  run jit.blocks.append(move releaseBlock)
  let env = &mut jit.baselineEnv.asMutSlice()[0]
  env.helpers[u32.toUsize(baseline_env.RELEASE_STUB)] = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(release)
  drop env
  let envAddress = unsafe Intrinsic.pointerReinterpret<*mut BaselineEnv, *mut u8>(Pointer.fromMutRef<BaselineEnv>(&mut jit.baselineEnv.asMutSlice()[0]))
  unsafe engineBaseline.setEntry(rt, unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(enter), unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(envAddress))
  jit.baselineReady = true
  return true
}

/// compileHot with Options.baseline: bytecode gets baseline code, or stays interpreted.
unsafe effect fn compileBaseline(jit: &mut Jit, bytecode: *mut HeapHeader) -> () ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  let rt = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  if function.baseline != 0 { return () }
  jit.reported = jit.reported + 1
  if jit.options.dump { run unsafe dumpBytecode(&function) }
  let settings = match jit.baselineSettings {
    Option<BaselineSettings>.Some { value } => value
    Option<BaselineSettings>.None => { jit.baselineRefused = jit.baselineRefused + 1 if jit.options.dump { run say(b"jit: baseline refused: ", b"the engine's value layout") } return () }
  }
  if !unsafe engineBaseline.serviced(rt) || jit.baselineCompiled >= usize.toU64(CAPACITY) {
    jit.baselineRefused = jit.baselineRefused + 1
    if jit.options.dump { run say(b"jit: baseline refused: ", b"no service, or the table is full") }
    return ()
  }
  let shape = unsafe engineBaseline.shape(bytecode)
  let bytes = unsafe function.code.asSlice()
  let outcome = match move run Effect.result(baseline.compile(&settings, &shape, bytes)) {
    Result<BaselineOutcome, OutOfMemoryError | UnboundLabelError>.Success { value } => move value
    Result<BaselineOutcome, OutOfMemoryError | UnboundLabelError>.Failure { .. } => { jit.failed = jit.failed + 1 return () }
  }
  let looped = hasBackEdge(bytes)
  let wait = if jit.options.optimize { tierUpWait(jit.options.optimizeEntries, bytes) } else { jit.options.optimizeEntries }
  drop function
  match move outcome {
    BaselineOutcome { code: made, split, why, uncovered, stepped, map, construct, resume } => {
      let mut code = match move made {
        Option<Code>.Some { value } => move value
        Option<Code>.None => {
          jit.baselineRefused = jit.baselineRefused + 1
          if jit.options.dump {
            run say(b"jit: baseline refused: ", why)
            let mut line = List<u8>.make()
            run line.appendSlice(b"jit: baseline refused with:")
            let mut k: usize = 0
            while k < uncovered.length() { run line.append(32) run line.appendSlice(op.opcodeName(uncovered.get(k), true)) k = k + 1 }
            k = 0
            while k < stepped.length() { run line.append(32) run line.appendSlice(op.opcodeName(stepped.get(k), true)) k = k + 1 }
            run line.append(10)
            io.stderr(line.asSlice())
          }
          return ()
        }
      }
      if !run unsafe baselineStubs(&mut jit, &settings) { jit.failed = jit.failed + 1 return () }
      let symbols = jit.baselineSymbols.asSlice()
      let isSplit = split.hotBytes != usize.MAX && split.hotBytes > 0 && split.hotBytes < code.bytes.length()
      let mut entry: ?*const u8 = Pointer.null<u8>()
      let mut coldEntry: ?*const u8 = Pointer.null<u8>()
      if isSplit {
        let blocks = match &mut jit.memory {
          Option<CodeMemory>.Some { value } => run publishSplitIn(&mut value, PACK_BASE_HOT, &mut code, &split, symbols)
          Option<CodeMemory>.None => { return () }
        }
        match move blocks {
          SplitBlocks { hot, cold } => {
            entry = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(hot.entry())
            coldEntry = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(cold.entry())
            run jit.blocks.append(move hot)
            run jit.blocks.append(move cold)
          }
        }
      } else {
        let block = match &mut jit.memory {
          Option<CodeMemory>.Some { value } => run publishIn(&mut value, PACK_BASE_HOT, &mut code, symbols)
          Option<CodeMemory>.None => { return () }
        }
        entry = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(block.entry())
        coldEntry = entry
        run jit.blocks.append(move block)
      }
      let hotPtr = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(entry)
      let coldPtr = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(coldEntry)
      let hotAddr = Pointer.address<u8>(hotPtr)
      let coldAddr = Pointer.address<u8>(coldPtr)
      let constructOff = u32.toUsize(construct)
      let constructEntry = if isSplit && constructOff >= split.hotBytes {
        unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(coldPtr), constructOff - split.hotBytes)
      } else {
        unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(hotPtr), constructOff)
      }
      let mut resumeEntry: ?*const u8 = Pointer.null<u8>()
      if resume != 0 {
        let resumeOff = u32.toUsize(resume)
        let rp = if isSplit && resumeOff >= split.hotBytes {
          unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(coldPtr), resumeOff - split.hotBytes)
        } else {
          unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(hotPtr), resumeOff)
        }
        resumeEntry = unsafe Intrinsic.pointerRequalify<*const u8, ?*const u8>(rp)
      }
      unsafe engineBaseline.link(rt, bytecode, u64.wrappingToU32(jit.baselineCompiled), hotPtr, constructEntry, resumeEntry)
      // Where the tails optimized code leaves through are; the shared prologue counts the
      // entries until the function is reported for it.
      let mut info = BaselineInfo { entry: hotAddr, code: hotPtr, construct: constructEntry, moved: 0, finish: 0, stepEnded: 0, tier: TIER_NONE, compiles: 0, exits: 0, learned: false, hasLoop: looped, stale: 0, waits: 0, unseen: 0 }
      let mut mark: usize = 0
      while mark + 2 < map.length() {
        let off = u32.toUsize(map.get(mark))
        let addr = if isSplit && off >= split.hotBytes { coldAddr + (off - split.hotBytes) } else { hotAddr + off }
        let what = map.get(mark + 2)
        if what == baseline.MARK_MOVED { info.moved = addr }
        if what == baseline.MARK_FINISH { info.finish = addr }
        if what == baseline.MARK_STEP_ENDED { info.stepEnded = addr }
        mark = mark + 3
      }
      run jit.baselineInfo.append(info)
      if jit.options.optimize {
        unsafe syncSiteShapes(rt, bytecode, true)
        unsafe engineBaseline.countFrom(bytecode, wait)
      }
      jit.baselineCompiled = jit.baselineCompiled + 1
      jit.baselineBytes = jit.baselineBytes + usize.toU64(code.bytes.length())
      jit.baselineUncovered = jit.baselineUncovered + usize.toU64(uncovered.length())
      if jit.options.dump {
        run dumpSplitPlaced(b"baseline", hotAddr, coldAddr, if isSplit { split.hotBytes } else { 0 }, &code)
        let mut line = List<u8>.make()
        run line.appendSlice(b"jit: baseline uncovered:")
        let mut k: usize = 0
        while k < uncovered.length() { run line.append(32) run line.appendSlice(op.opcodeName(uncovered.get(k), true)) k = k + 1 }
        run line.append(10)
        io.stderr(line.asSlice())
        let mut steps = List<u8>.make()
        run steps.appendSlice(b"jit: baseline stepped:")
        let mut q: usize = 0
        while q < stepped.length() { run steps.append(32) run steps.appendSlice(op.opcodeName(stepped.get(q), true)) q = q + 1 }
        run steps.append(10)
        io.stderr(steps.asSlice())
        // code offset:bytecode offset:what, for tools (scripts/jit_baseline_profile.py).
        let mut places = List<u8>.make()
        run places.appendSlice(b"jit: baseline map")
        let mut m: usize = 0
        while m + 2 < map.length() {
          run places.append(32)
          run decimal(&mut places, u32.toU64(map.get(m)))
          run places.append(58)
          run decimal(&mut places, u32.toU64(map.get(m + 1)))
          run places.append(58)
          let what = map.get(m + 2)
          if what < 256 { run places.appendSlice(op.opcodeName(u32.wrappingToU8(what), true)) } else { run places.append(64) run decimal(&mut places, u32.toU64(what)) }
          m = m + 3
        }
        run places.append(10)
        io.stderr(places.asSlice())
      }
    }
  }
}

/// BaselineEnv.TIER: the shared prologue's count of bytecode's entries ran out. The call
/// that reported it goes on in the code it entered; the next one finds what this made.
export "C" fn jitTierUp(env: *mut BaselineEnv, bytecode: *mut HeapHeader, owner: ?*mut HeapHeader, isKnown: u32) -> () {
  let envAnchor = ()
  let jitOwner = (unsafe Pointer.borrow<(), BaselineEnv>(&envAnchor, env)).owner
  let mut anchor = ()
  let jit = unsafe jitOf(&mut anchor, jitOwner)
  let mut system = Allocator.systemAllocatorProvider()
  let closure = if isKnown == 0 { owner } else { Pointer.null<HeapHeader>() }
  let knownScope = if isKnown != 0 { owner } else { Pointer.null<HeapHeader>() }
  let started = now()
  let outcome = run Effect.result(unsafe compileOptimized(&mut jit, bytecode, closure, knownScope)) |> Effect.provideMut<Allocator>(&mut system)
  jit.compileNanoseconds = jit.compileNanoseconds + elapsed(started)
  match move outcome {
    Result<(), OutOfMemoryError | MemoryError | LinkError>.Success { .. } => ()
    Result<(), OutOfMemoryError | MemoryError | LinkError>.Failure { .. } => { jit.failed = jit.failed + 1 }
  }
}
/// BaselineEnv.FRAME_EXIT: x64_frame_exit.jitFrameExit, after a guard's failure is counted
/// against the function's optimized code (noteLeft).
export "C" fn jitFrameLeft(env: *mut BaselineEnv, record: *mut BaselineFrame, slots: *mut u8, exit: *mut u32, dump: *mut u64, how: u32) -> u64 {
  if how == leaving.HOW_DEOPT {
    let envAnchor = ()
    let owner = (unsafe Pointer.borrow<(), BaselineEnv>(&envAnchor, env)).owner
    let mut anchor = ()
    let jit = unsafe jitOf(&mut anchor, owner)
    let mut system = Allocator.systemAllocatorProvider()
    let pc = unsafe Pointer.read<u32>(exit)
    let code = unsafe Pointer.read<u32>(unsafe Pointer.atMut<u32>(unsafe Pointer.assumeManyMut<u32>(exit), 2))
    let mut loopCheck: u32 = 0
    if u32.bitAnd(code, exitState.CODE_ARRAY_CHECK) != 0 { loopCheck = SITE_ARRAY }
    else if u32.bitAnd(code, exitState.CODE_BOUND_CHECK) != 0 { loopCheck = SITE_BOUND }
    let outcome = run Effect.result(unsafe noteLeft(&mut jit, record, pc, loopCheck)) |> Effect.provideMut<Allocator>(&mut system)
    match move outcome {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { .. } => { jit.failed = jit.failed + 1 }
    }
  }
  return unsafe jitFrameExit(env, record, slots, exit, dump, how)
}
/// The optimized code of the function whose frame record is left at a guard at bytecode
/// offset pc. The site is remembered; code that leaves too often is unlinked (EXIT_BURST).
/// loopCheck: SITE_ARRAY or SITE_BOUND when the guard is a loop's `check.array` or
/// `check.bound`, remembered as the header's pc with that bit; else 0.
unsafe effect fn noteLeft(jit: &mut Jit, record: *mut BaselineFrame, pc: u32, loopCheck: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let rt = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  let bytecode = (unsafe engineBaseline.cellsOf(record)).bytecode
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let linked = function.baseline
  // The entries since the code was linked: the shared prologue counts down from the top.
  let entries = u32.toU64(4294967295 - function.hotness)
  drop function
  if linked == 0 { return () }
  let index = engineBaseline.linkedIndex(linked)
  if index >= jit.baselineInfo.length() { return () }
  let mut info = jit.baselineInfo.get(index)
  // An activation that outlived its code's unlinking.
  if info.tier != TIER_OPTIMIZED { return () }
  let key = u32.bitOr(pc, loopCheck)
  let site = u64.bitOr(u64.shiftLeft(usize.toU64(index), 32), u32.toU64(key))
  if jit.options.dump {
    // `jit: left: <function> <pc> <opcode> shapes <seen>[ versions <v>...]`.
    let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
    let bytes = unsafe code.code.asSlice()
    let mut line = List<u8>.make()
    run decimal(&mut line, usize.toU64(index))
    run line.append(32)
    run decimal(&mut line, u32.toU64(pc))
    run line.append(32)
    if u32.toUsize(pc) < bytes.length { run line.appendSlice(op.opcodeName(bytes[u32.toUsize(pc)], true)) }
    if loopCheck == SITE_ARRAY { run line.appendSlice(b" array") }
    if loopCheck == SITE_BOUND { run line.appendSlice(b" bound") }
    run line.appendSlice(b" shapes ")
    run decimal(&mut line, u32.toU64(unsafe inline.siteSeen(rt, bytecode, pc)))
    // ` versions <v>...`: the shape versions the site recorded, receivers first.
    let mut keys: [u64; 4] = [0; 4] let mut protoKeys: [u64; 4] = [0; 4] let mut firstKeys: [u64; 4] = [0; 4]
    let recorded = unsafe inline.siteShapes(rt, bytecode, pc, &mut keys, &mut protoKeys, &mut firstKeys)
    if recorded != 0 {
      run line.appendSlice(b" versions")
      let mut n: usize = 0
      while n < u32.toUsize(recorded) { run line.append(32) run decimal(&mut line, u64.shiftRight(u64.shiftLeft(keys[n], 1), 17)) n = n + 1 }
    }
    run say(b"jit: left: ", line.asSlice())
  }
  let mut known = false
  let mut own: usize = 0
  let seen = unsafe inline.siteSeen(rt, bytecode, pc)
  let mut l: usize = 0
  while l < jit.leftAt.length() {
    let left = jit.leftAt.get(l)
    if left == site {
      known = true
      if (seen > jit.leftSeen.get(l) && seen <= SITE_PAIRS) || (seen > SITE_PAIRS && jit.leftHow.get(l) == 0) { info.learned = true }
      // Kept general and left again: the next compile steps it.
      if jit.leftHow.get(l) == LEFT_GENERAL { jit.leftHow.set(l, LEFT_AGAIN) info.learned = true }
    }
    if u64.toUsize(u64.shiftRight(left, 32)) == index { own = own + 1 }
    l = l + 1
  }
  let fresh = !known && own < MAX_LEFT
  if fresh { run jit.leftAt.append(site) run jit.leftSeen.append(seen) run jit.leftHow.append(0) info.learned = true }
  info.exits = info.exits + 1
  // An arithmetic site that leaves for the first time has learned all it can (an operand was
  // no int32), and code with a loop pays for leaving with the rest of its activation in
  // baseline code, which notes the other such sites it runs: that code is unlinked at once.
  // (A function entered once that loops is optimized at its next entry, so the instructions
  // in front of its loops never ran in baseline code and none of their sites is noted.)
  let mut numeric = false
  if fresh && info.hasLoop && loopCheck == 0 {
    let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
    let bytes = unsafe code.code.asSlice()
    numeric = u32.toUsize(pc) < bytes.length && numericOpcode(bytes[u32.toUsize(pc)])
  }
  // Baseline back-edges also decrement `function.hotness` when an activation resumes in
  // baseline after a guard exit, which can inflate `entries` by thousands of loop turns per
  // exit and mask a 100%-exit function; unlink at EXIT_BURST once a looped function has
  // learned a new site to widen/step on recompile.
  if numeric || (info.exits >= EXIT_BURST && (u32.toU64(info.exits) * EXIT_RATE > entries || (info.learned && info.hasLoop))) {
    unsafe engineBaseline.relink(rt, linked, info.code, info.construct)
    unsafe syncSiteShapes(rt, bytecode, true)
    jit.optimizeBacked = jit.optimizeBacked + 1
    info.exits = 0
    info.tier = TIER_NONE
    let mut wait = jit.options.optimizeEntries
    if wait == 0 { wait = 1 }
    if info.learned {
      info.stale = 0
      // Gentle backoff once a function has already recompiled multiple times so
      // remaining polymorphic inline caches settle in baseline without starving
      // hot functions on their first 1-2 recompiles.
      if wait >= 10 && info.compiles >= 2 {
        let shift = if info.compiles < 6 { u8.toU32(info.compiles - 1) } else { 5 }
        let scaled = wait * u32.shiftLeft(1, shift)
        if scaled > wait { wait = scaled }
        if wait > 512 { wait = 512 }
      }
    } else if info.stale < 255 { info.stale = info.stale + 1 }
    info.learned = false
    let mut n: u8 = 0
    while n < info.stale && wait < 16777216 { wait = wait * OPTIMIZE_BACKOFF n = n + 1 }
    unsafe engineBaseline.countFrom(bytecode, wait)
    if jit.options.dump {
      let mut line = List<u8>.make()
      run line.appendSlice(b"it left at guards too often, last at pc ")
      run decimal(&mut line, u32.toU64(pc))
      run say(b"jit: optimized code unlinked: ", line.asSlice())
    }
  }
  jit.baselineInfo.set(index, info)
}
/// Adds to sites (the sites the code is to keep general, FunctionInput.doubleSites) the
/// element and field instructions of function that baseline code noted where the optimized
/// Collects all non-zero entries from BaselineEnv.misses once per compilation so missedSites
/// and calleeDoubleSites (called across many inline candidates) scan only populated slots.
effect fn collectActiveMisses(jit: &Jit) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut active = List<usize>.make()
  if jit.baselineEnv.length() == 0 { return move active }
  let misses = &jit.baselineEnv.asSlice()[0].misses
  let mut i: usize = 0
  while i < baseline_env.MISSES {
    let raw = misses[i]
    if raw != 0 && (raw & baseline_env.MISS_ONCE) == 0 { run active.append(raw) }
    i = i + 1
  }
  return move active
}
/// code's inline read or store would miss too (BaselineEnv.misses): the optimizer compiles
/// the helper and a step behind it from the start, instead of a guess that leaves.
effect fn missedSites(activeMisses: &List<usize>, function: &FunctionBytecode, sites: &mut List<u32>) -> () ! OutOfMemoryError ? &mut Allocator {
  let length = function.code.length()
  if length == 0 || activeMisses.length() == 0 { return () }
  let first = Pointer.address<u8>(unsafe function.code.start()) + 1
  let bytes = unsafe function.code.asSlice()
  let mut i: usize = 0
  while i < activeMisses.length() {
    let raw = activeMisses.get(i)
    let concat = (raw & baseline_env.MISS_CONCAT) != 0
    let site = raw & usize.bitNot(baseline_env.MISS_CONCAT)
    if site >= first && site < first + length {
      let opcode = bytes[site - first]
      if elementOpcode(opcode) || fieldOpcode(opcode) || numericOpcode(opcode) {
        let pc = usize.toU32(site - first)
        let mut known: u32 = 0
        let mut n: usize = 0
        while n < sites.length() { if sites.get(n) == pc { known = known + 1 } n = n + 1 }
        if known == 0 {
          run sites.append(pc)
          // An add named twice is the engine's join (ssa_translate.concatenates).
          if concat && addOpcode(opcode) { run sites.append(pc) }
        } else if known == 1 && concat && addOpcode(opcode) {
          run sites.append(pc)
        }
      }
    }
    i = i + 1
  }
}
/// The numeric sites of an inline candidate (callee) that baseline code or earlier compiles
/// saw with non-Int numbers, so the inlined body widens them to doubles from the start, and
/// the field stores baseline code noted: a body with one is not inlined (ssa_translate,
/// inlineTarget), as its store would leave at the call. And the element reads baseline code
/// noted (a slow Array, an ordinary object): the body reads them by key (ssa_translate,
/// getElem), where an index guess would leave at the call every time.
effect fn calleeDoubleSites(jit: &Jit, activeMisses: &List<usize>, callee: &FunctionBytecode) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut sites = List<u32>.make()
  let length = callee.code.length()
  if length == 0 { return move sites }
  let bytes = unsafe callee.code.asSlice()
  if activeMisses.length() != 0 {
    let first = Pointer.address<u8>(unsafe callee.code.start()) + 1
    let mut i: usize = 0
    while i < activeMisses.length() {
      let raw = activeMisses.get(i)
      let concat = (raw & baseline_env.MISS_CONCAT) != 0
      let site = raw & usize.bitNot(baseline_env.MISS_CONCAT)
      if !concat && site >= first && site < first + length && (numericOpcode(bytes[site - first]) || fieldStore(bytes[site - first]) || elementRead(bytes[site - first])) {
        let pc = usize.toU32(site - first)
        let mut known = false
        let mut n: usize = 0
        while n < sites.length() { if sites.get(n) == pc { known = true } n = n + 1 }
        if !known { run sites.append(pc) }
      }
      i = i + 1
    }
  }
  if callee.baseline != 0 {
    let index = engineBaseline.linkedIndex(callee.baseline)
    let mut l: usize = 0
    while l < jit.leftAt.length() {
      let left = jit.leftAt.get(l)
      if u64.toUsize(u64.shiftRight(left, 32)) == index {
        let pc = u64.wrappingToU32(left)
        let at = u32.toUsize(pc)
        if at < bytes.length && numericOpcode(bytes[at]) {
          let mut known = false
          let mut n: usize = 0
          while n < sites.length() { if sites.get(n) == pc { known = true } n = n + 1 }
          if !known { run sites.append(pc) }
        }
      }
      l = l + 1
    }
  }
  return move sites
}
/// Whether opcode reads an element with the object and the index on the stack or in a
/// local or an argument (ssa_translate.getElem).
fn elementRead(opcode: u8) -> bool {
  return opcode == op.OP_get_array_el || opcode == op.OP_get_array_el2 || opcode == op.OP_get_array_el3
    || opcode == op.OP_get_loc_el8 || opcode == op.OP_get_arg_el8 || opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8
}
/// Whether opcode stores a named property: baseline code notes one that met a setter, or
/// that keeps turning between adding the property and storing to it (baseline_env.noteTurn).
fn fieldStore(opcode: u8) -> bool {
  return opcode == op.OP_put_field || opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8
}
/// Whether opcode is an add that baseline code notes where it joined a string.
fn addOpcode(opcode: u8) -> bool {
  return opcode == op.OP_add || opcode == op.OP_add_loc || opcode == op.OP_add_loc_loc8 || opcode == op.OP_add_top_loc8 || opcode == op.OP_add_top_arg8
}
/// Whether opcode is an arithmetic, comparison or unary op that baseline code notes when it
/// handles a non-Int number (BaselineEnv.misses).
fn numericOpcode(opcode: u8) -> bool {
  return addOpcode(opcode) || opcode == op.OP_add_imm
    || opcode == op.OP_sub || opcode == op.OP_sub_loc_loc8 || opcode == op.OP_sub_top_loc8 || opcode == op.OP_sub_top_arg8
    || opcode == op.OP_mul || opcode == op.OP_mul_loc_loc8 || opcode == op.OP_mul_top_loc8 || opcode == op.OP_mul_top_arg8
    || opcode == op.OP_div || opcode == op.OP_mod
    || opcode == op.OP_lt || opcode == op.OP_lte || opcode == op.OP_gt || opcode == op.OP_gte
    || opcode == op.OP_and || opcode == op.OP_or || opcode == op.OP_xor
    || opcode == op.OP_and_imm || opcode == op.OP_or_imm
    || opcode == op.OP_shl || opcode == op.OP_sar || opcode == op.OP_shr
    || opcode == op.OP_shl_imm || opcode == op.OP_sar_imm
    || opcode == op.OP_neg || opcode == op.OP_plus
    || opcode == op.OP_strict_eq_imm8 || opcode == op.OP_strict_neq_imm8
}
fn hasNumericOpcode(bytes: &[u8]) -> bool {
  let mut pc: usize = 0
  while pc < bytes.length {
    let opcode = bytes[pc]
    let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
    if size == 0 || pc + size > bytes.length { break }
    if numericOpcode(opcode) { return true }
    pc = pc + size
  }
  return false
}
/// Whether opcode is a named property read or store, whose site baseline code notes where
/// it met an accessor (BaselineEnv.misses).
fn fieldOpcode(opcode: u8) -> bool { return op.fieldKeyed(opcode) || opcode == op.OP_get_field2 }
/// Whether opcode is an element instruction that notes its Symbol keys in the element site
/// cache.
fn elementOpcode(opcode: u8) -> bool {
  return opcode == op.OP_get_array_el || opcode == op.OP_get_array_el2 || opcode == op.OP_get_array_el3 || opcode == op.OP_put_array_el
    || opcode == op.OP_get_loc_el8 || opcode == op.OP_get_arg_el8 || opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8
    || opcode == op.OP_get_scope0_el
}
/// The element sites of function where baseline code found an own property under a Symbol
/// key (its element site cache, js_baseline.ElementSite, names the instruction's operand
/// address): pc << 8 | js_feedback.ELEMENT_ORDINARY, so that the optimizer reads and
/// stores them by key (FunctionInput.elementKinds) instead of guessing an index.
effect fn keyedSites(jit: &Jit, function: &FunctionBytecode) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<u32>.make()
  let length = function.code.length()
  if length == 0 || jit.baselineEnv.length() == 0 { return move found }
  let first = Pointer.address<u8>(unsafe function.code.start()) + 1
  let bytes = unsafe function.code.asSlice()
  let mut i: usize = 0
  while i < engineBaseline.ELEMENT_SITES {
    let site = jit.baselineEnv.asSlice()[0].elements[i].site
    // An entry outlives the code it was made for: one in this code's range names an
    // element instruction of it, or was left by code that was here before.
    if site >= first && site < first + length && elementOpcode(bytes[site - first]) {
      let entry = u32.shiftLeft(usize.toU32(site - first), 8) | u8.toU32(feedback.ELEMENT_ORDINARY)
      let mut known = false
      let mut n: usize = 0
      while n < found.length() { if found.get(n) == entry { known = true } n = n + 1 }
      if !known { run found.append(entry) }
    }
    i = i + 1
  }
  return move found
}
effect fn sayOptimizer(dump: bool, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  if dump { run say(b"jit: not optimized: ", text) }
}
/// Gives bytecode, which has baseline code, optimized code on the same frame
/// (x64_backend.lowerOnFrame, docs/jit/optimizer.md), or leaves it its baseline code.
/// closure: the function's closure object as its prologue had it, or null for a known
/// local function (a function's own methods read off its variables need it, candidates).
unsafe effect fn compileOptimized(jit: &mut Jit, bytecode: *mut HeapHeader, closure: ?*mut HeapHeader, knownScope: ?*mut HeapHeader) -> () ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  // The count stays clear of the prologue's report from here on, whatever comes of this.
  unsafe engineBaseline.countFrom(bytecode, PARKED)
  let rt = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let linked = function.baseline
  if linked == 0 { return () }
  let index = engineBaseline.linkedIndex(linked)
  if index >= jit.baselineInfo.length() { return () }
  let mut info = jit.baselineInfo.get(index)
  if info.tier != TIER_NONE { return () }
  info.tier = TIER_REFUSED
  jit.baselineInfo.set(index, info)
  unsafe syncSiteShapes(rt, bytecode, false)
  // A method call of the function's own code that has not run yet is a call for good in
  // its optimized code (no exit there teaches a later compile its target): the first
  // optimization waits, up to UNSEEN_WAITS times, while baseline code runs them. A wait
  // that ran none of them is the last: they are on paths the function does not take (a
  // server's per-request function waited some ten thousand entries for them).
  let defaultLoopFree = jit.options.optimizeEntries == OPTIMIZE_ENTRIES && !hasBackEdge(unsafe function.code.asSlice())
  let unseen = if info.compiles == 0 && info.waits < UNSEEN_WAITS && !defaultLoopFree { unsafe unseenCalls(rt, bytecode) } else { 0 }
  if unseen != 0 && (info.waits == 0 || unseen < info.unseen) {
    info.waits = info.waits + 1
    info.unseen = unseen
    info.tier = TIER_NONE
    jit.baselineInfo.set(index, info)
    let mut wait = jit.options.optimizeEntries
    if wait == 0 { wait = 1 }
    let mut n: u8 = 0
    while n < info.waits { wait = wait * UNSEEN_BACKOFF n = n + 1 }
    unsafe engineBaseline.countFrom(bytecode, wait)
    run sayOptimizer(jit.options.dump, b"a method call that has not run yet: waits")
    return ()
  }
  if jit.options.dump {
    // `jit: optimizing <function> <name> <file>:<line>`, the index `jit: left:` names it by.
    let mut line = List<u8>.make()
    run decimal(&mut line, usize.toU64(index))
    run line.append(32)
    let label = run unsafe backtrace.dumpLabel(rt, bytecode)
    run line.appendSlice(label.asSlice())
    run say(b"jit: optimizing ", line.asSlice())
    run unsafe dumpBytecode(&function)
  }
  let settings = match jit.baselineSettings {
    Option<BaselineSettings>.Some { value } => value
    Option<BaselineSettings>.None => { return () }
  }
  let shape = unsafe engineBaseline.shape(bytecode)
  let mut cost = Cost.make()
  cost.dump = jit.options.dump
  cost.passes = jit.options.passes
  // What its method calls call, to inline: cells[id] is the FunctionBytecode cell of the
  // target a CallTarget names.
  let mut cells = List<?*mut HeapHeader>.make()
  let mut closures = List<?*mut HeapHeader>.make()
  let mut targets = List<CallTarget>.make()
  let mut holders = List<?*mut HeapHeader>.make()
  let mut localDescs = List<ConstructDesc>.make()
  let mut rootConstructs = List<ConstructTarget>.make()
  let activeMisses = run collectActiveMisses(&jit)
  if jit.options.inlining {
    // First the watches (they change versions the sites' shapes are read with), over the
    // same walk; then the candidates.
    let mut firstCells = List<?*mut HeapHeader>.make()
    let mut firstClosures = List<?*mut HeapHeader>.make()
    let mut firstHolders = List<?*mut HeapHeader>.make()
    let mut dummyDescs = List<ConstructDesc>.make()
    let mut dummyConstructs = List<ConstructTarget>.make()
    let _watched = run unsafe candidates(&jit, &activeMisses, bytecode, 0, &mut firstCells, &mut firstClosures, &mut firstHolders, true, true, closure, knownScope, Pointer.null<HeapHeader>(), &mut dummyDescs, &mut dummyConstructs)
    run unsafe watchRecords(&mut jit, rt, &firstClosures)
    targets = run unsafe candidates(&jit, &activeMisses, bytecode, 0, &mut cells, &mut closures, &mut holders, true, false, closure, knownScope, Pointer.null<HeapHeader>(), &mut localDescs, &mut rootConstructs)
  }
  // Leaf-executed callees bypass the baseline tier until linked, so their float arithmetic
  // misses are not yet in BaselineEnv.misses. Compile un-baselined numeric inline candidates
  // to baseline and wait one short warmup so baseline records their float sites before inlining.
  if jit.options.inlining && info.compiles == 0 && info.waits < UNSEEN_WAITS && !defaultLoopFree {
    let mut warmed: u32 = 0
    let mut ci: usize = 0
    while ci < cells.length() {
      if let Option<*mut HeapHeader>.Some { value: cell } = Pointer.nonNullMut<HeapHeader>(cells.get(ci)) {
        if Pointer.address<HeapHeader>(cell) != Pointer.address<HeapHeader>(bytecode) {
          let cAnchor = ()
          let callee = unsafe HeapCell.payload<FunctionBytecode, ()>(&cAnchor, cell)
          let needsBaseline = callee.baseline == 0 && hasNumericOpcode(unsafe callee.code.asSlice())
          drop callee
          if needsBaseline {
            run unsafe compileBaseline(&mut jit, cell)
            warmed = warmed + 1
          }
        }
      }
      ci = ci + 1
    }
    if warmed > 0 {
      info.waits = info.waits + 1
      info.tier = TIER_NONE
      jit.baselineInfo.set(index, info)
      let mut wait = jit.options.optimizeEntries
      if wait == 0 { wait = 1 }
      unsafe engineBaseline.countFrom(bytecode, wait)
      run sayOptimizer(jit.options.dump, b"an inline callee has not run baseline yet: waits")
      return ()
    }
  }
  // Where its earlier code left at guards.
  let mut sites = List<u32>.make()
  let mut l: usize = 0
  while l < jit.leftAt.length() {
    let left = jit.leftAt.get(l)
    if u64.toUsize(u64.shiftRight(left, 32)) == index {
      // A field site that is recorded with more shapes than when it left learned one there:
      // it is tested against them all, and leaves on another.
      let now = unsafe inline.siteSeen(rt, bytecode, u32.bitAnd(u64.wrappingToU32(left), u32.bitXor(u32.bitOr(SITE_ARRAY, SITE_BOUND), u32.MAX)))
      if jit.options.dump {
        // `jit: kept general: <pc> how <0, 1, 2> seen <then> <now>`.
        let mut line = List<u8>.make()
        run decimal(&mut line, u64.shiftRight(u64.shiftLeft(left, 32), 32))
        run line.appendSlice(b" how ") run decimal(&mut line, u8.toU64(jit.leftHow.get(l)))
        run line.appendSlice(b" seen ") run decimal(&mut line, u32.toU64(jit.leftSeen.get(l)))
        run line.append(32) run decimal(&mut line, u32.toU64(now))
        run say(b"jit: kept general: ", line.asSlice())
      }
      if now <= jit.leftSeen.get(l) || now > SITE_PAIRS {
        run sites.append(u64.wrappingToU32(left))
        if jit.leftHow.get(l) == LEFT_AGAIN { run sites.append(u64.wrappingToU32(left)) }
        else { jit.leftHow.set(l, LEFT_GENERAL) }
      }
      else { jit.leftSeen.set(l, now) }
    }
    l = l + 1
  }
  let read = run unsafe siteShapesOf(rt, bytecode)
  // The realm's Array.prototype push and pop, and the names they are under: a method call
  // under one of them is the array operation when its callee is that native.
  let mut arrayAtoms: [u32; 2] = [0, 0]
  let mut arrayObjects: [usize; 2] = [0, 0]
  let mut which: u32 = 0
  while which < 2 {
    let mut atom: u32 = 0
    if let Option<*mut HeapHeader>.Some { value: native } = Pointer.nonNullMut<HeapHeader>(unsafe inline.arrayNative(bytecode, which, &mut atom)) {
      let address = Pointer.address<HeapHeader>(native)
      let mut kept = false
      let mut n: usize = 0
      while n < jit.arrayNatives.length() { if jit.arrayNatives.get(n) == address { kept = true } n = n + 1 }
      if !kept && unsafe inline.keepClosure(rt, native) { run jit.arrayNatives.append(address) kept = true }
      if kept { arrayAtoms[u32.toUsize(which)] = atom arrayObjects[u32.toUsize(which)] = address }
    }
    which = which + 1
  }
  let records = run unsafe recordSlots(&jit)
  // A fresh array's shape, for pushes in place: versions above 31 bits are not compared.
  let mut arrayShape = unsafe inline.arrayShapeVersion(bytecode)
  if arrayShape >= 2147483648 { arrayShape = 0 }
  let elements = run keyedSites(&jit, &function)
  let earlier = sites.length()
  run missedSites(&activeMisses, &function, &mut sites)
  if jit.options.dump && sites.length() > earlier {
    // `jit: noted: <pc>...`, the sites baseline code noted (BaselineEnv.misses).
    let mut line = List<u8>.make()
    let mut n = earlier
    while n < sites.length() { if n > earlier { run line.append(32) } run decimal(&mut line, u32.toU64(sites.get(n))) n = n + 1 }
    run say(b"jit: noted: ", line.asSlice())
  }
  let lowered = run Effect.result(unsafe lower.lowerOnFrame(&function, &sites, earlier, move targets, &elements, move read, FramePlan.of(settings.frame, &shape), arrayAtoms[0], arrayAtoms[1], u64.wrappingToU32(arrayShape), move records, move rootConstructs, &mut cost))
  jit.cost.add(&cost)
  if jit.options.dump { run dumpCost(b"jit: cost optimized", &cost) }
  drop function
  let result = match move lowered {
    Result<Lowered, OutOfMemoryError | UnboundLabelError>.Success { value } => move value
    Result<Lowered, OutOfMemoryError | UnboundLabelError>.Failure { .. } => { jit.failed = jit.failed + 1 return () }
  }
  // The symbols: the shared stubs, the baseline code's tails and entry, then per inline
  // target the address of its cell, of the first byte of its code and of its closure.
  let mut symbols = List<usize>.make()
  run symbols.appendSlice(jit.baselineSymbols.asSlice())
  run symbols.append(info.moved)
  run symbols.append(info.finish)
  run symbols.append(info.entry)
  run symbols.append(info.stepEnded)
  run symbols.append(Pointer.address<u8>(info.construct))
  let mut inlinedSites: usize = 0
  if let Lowered.Code { inlined, .. } = &result {
    let mut k: usize = 0
    while k < inlined.length() {
      let id = u32.toUsize(u32.bitAnd(inlined.get(k), u32.bitNot(TARGET_FLAGS)))
      let cell = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(cells.get(id))
      if !(unsafe inline.keep(rt, cell)) { jit.optimizeRefused = jit.optimizeRefused + 1 return () }
      run symbols.append(Pointer.address<HeapHeader>(cell))
      run symbols.append(Pointer.address<u8>(unsafe inline.codeStart(cell)))
      // The closure of an exact target: the code holds its address, the runtime a count.
      let mut closure: usize = 0
      if u32.bitAnd(inlined.get(k), TARGET_EXACT) != 0 {
        let object = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(closures.get(id))
        if !(unsafe inline.keepClosure(rt, object)) { jit.optimizeRefused = jit.optimizeRefused + 1 return () }
        closure = Pointer.address<HeapHeader>(object)
      }
      run symbols.append(closure)
      k = k + 1
    }
    // The variable cells the code reads by address: (target << 16 | variable), each a cell
    // of that target's closure, which the runtime keeps.
    if let Lowered.Code { cells: named, .. } = &result {
      let mut c: usize = 0
      while c < named.length() {
        let entry = named.get(c)
        c = c + 1
        let id = u32.toUsize(u32.bitAnd(inlined.get(u32.toUsize(u32.shiftRight(entry, 16))), u32.bitNot(TARGET_FLAGS)))
        let mut cell: usize = 0
        if let Option<*mut HeapHeader>.Some { value: object } = Pointer.nonNullMut<HeapHeader>(closures.get(id)) { cell = unsafe inline.ownedCell(object, u32.bitAnd(entry, 0xffff)) }
        if cell == 0 { jit.optimizeRefused = jit.optimizeRefused + 1 return () }
        run symbols.append(cell)
      }
    }
    // The watched objects of each known target (the engine keeps them since the watch).
    k = 0
    while k < inlined.length() {
      let first = u32.toUsize(u32.bitAnd(inlined.get(k), u32.bitNot(TARGET_FLAGS))) * u32.toUsize(KNOWN_SYMBOLS)
      let mut n: usize = 0
      while n < u32.toUsize(KNOWN_SYMBOLS) {
        let mut holder: usize = 0
        if u32.bitAnd(inlined.get(k), TARGET_KNOWN) != 0 { holder = Pointer.address<HeapHeader>(holders.get(first + n)) }
        run symbols.append(holder)
        n = n + 1
      }
      k = k + 1
    }
    // The realm's Array.prototype push and pop (x64_backend.arraySymbol).
    run symbols.append(arrayObjects[0])
    run symbols.append(arrayObjects[1])
    // The realm's String.prototype, or 0 (x64_backend.stringSymbol).
    run symbols.append(Pointer.address<HeapHeader>(unsafe inline.stringPrototype(bytecode)))
    // The string cells of the atoms the code pushes (x64_backend.atomSymbol), which the
    // bytecode that names them keeps.
    if let Lowered.Code { atoms, .. } = &result {
      let mut a: usize = 0
      while a < atoms.length() {
        let cell = unsafe inline.atomString(rt, atoms.get(a))
        if cell == 0 { jit.optimizeRefused = jit.optimizeRefused + 1 return () }
        run symbols.append(cell)
        a = a + 1
      }
    }
    // Inlined construct descriptors (x64_backend.constructSymbol): deduplicated in
    // jit.constructDescs, with all referenced objects kept alive for the runtime.
    if let Lowered.Code { constructs, .. } = &result {
      let mut ci: usize = 0
      while ci < constructs.length() {
        let descAddr = unsafe commitConstructDesc(&mut jit, rt, &localDescs, u32.toUsize(constructs.get(ci)), 0)
        if descAddr == 0 { jit.optimizeRefused = jit.optimizeRefused + 1 return () }
        run symbols.append(descAddr)
        ci = ci + 1
      }
    }
    inlinedSites = inlined.length()
  }
  let mut construct: u32 = 0
  let mut split = SplitInfo.none()
  let mut code = match move result {
    Lowered.Code { value, construct: at, split: splitInfo, .. } => { construct = at split = move splitInfo move value }
    Lowered.Refused { reason } => {
      jit.optimizeRefused = jit.optimizeRefused + 1
      if jit.options.dump { run sayRefusal(&reason) }
      return ()
    }
  }
  if jit.options.dump { run dumpMachine(&code) }
  let isSplit = split.hotBytes != usize.MAX && split.hotBytes > 0 && split.hotBytes < code.bytes.length()
  let mut entry = info.code
  let mut coldEntry = info.code
  if isSplit {
    let blocks = match &mut jit.memory {
      Option<CodeMemory>.Some { value } => run publishSplit(&mut value, &mut code, &split, symbols.asSlice())
      Option<CodeMemory>.None => { return () }
    }
    match move blocks {
      SplitBlocks { hot, cold } => {
        entry = hot.entry()
        coldEntry = cold.entry()
        run jit.blocks.append(move hot)
        run jit.blocks.append(move cold)
      }
    }
  } else {
    let block = match &mut jit.memory {
      Option<CodeMemory>.Some { value } => run publishIn(&mut value, PACK_OPT_HOT, &mut code, symbols.asSlice())
      Option<CodeMemory>.None => { return () }
    }
    entry = block.entry()
    coldEntry = entry
    run jit.blocks.append(move block)
  }
  // Constructs run the code too, through its own construct entry (which lives in cold when split).
  let mut constructEntry = info.construct
  if construct != 0 {
    let off = u32.toUsize(construct)
    if isSplit && off >= split.hotBytes {
      constructEntry = unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(coldEntry), off - split.hotBytes)
    } else {
      constructEntry = unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(entry), off)
    }
  }
  unsafe engineBaseline.relink(rt, linked, entry, constructEntry)
  info.tier = TIER_OPTIMIZED
  if info.compiles < 255 { info.compiles = info.compiles + 1 }
  info.exits = 0
  jit.baselineInfo.set(index, info)
  jit.optimized = jit.optimized + 1
  jit.optimizedBytes = jit.optimizedBytes + usize.toU64(code.bytes.length())
  jit.inlinedSites = jit.inlinedSites + usize.toU64(inlinedSites)
  if jit.options.dump { run dumpSplitPlaced(b"optimized", Pointer.address<u8>(entry), Pointer.address<u8>(coldEntry), if isSplit { split.hotBytes } else { 0 }, &code) }
}

/// LibcServices.hotFunction through HotHandler: compile bytecode or refuse it.
export "C" fn jitHotFunction(rt: *mut HeapHeader, bytecode: *mut HeapHeader, data: ?*mut u8) -> () {
  let mut anchor = ()
  let jit = unsafe jitOf(&mut anchor, data)
  let mut system = Allocator.systemAllocatorProvider()
  let started = now()
  let outcome = run Effect.result(unsafe compileHot(&mut jit, bytecode)) |> Effect.provideMut<Allocator>(&mut system)
  jit.compileNanoseconds = jit.compileNanoseconds + elapsed(started)
  match move outcome {
    Result<(), OutOfMemoryError | MemoryError | LinkError>.Success { .. } => ()
    Result<(), OutOfMemoryError | MemoryError | LinkError>.Failure { .. } => { jit.failed = jit.failed + 1 }
  }
}

/// Options.foresee bits: which sure deopts a recording refuses a function for. Each stands for
/// an exit compiled code takes today; when that exit becomes a slow path, clear its bit (or
/// drop it from FORESEE_ALL) and the functions compile again.
/// A call to a bytecode function that was reported and has no code (js_vm.compiledCall
/// answers CALL_DEOPT).
pub const FORESEE_CALLEE: u32 = 1
/// Arithmetic or a comparison on a string, object or other non-number.
pub const FORESEE_NUMBERS: u32 = 2
/// A named property read or store on a value that is not an object.
pub const FORESEE_RECEIVER: u32 = 4
/// A named store to objects of five or more shapes (js_compiled_objects.writeField declines).
pub const FORESEE_STORE: u32 = 8
pub const FORESEE_ALL: u32 = 15
/// Options.profile unless --jit-profile says otherwise: the recording is this many
/// instructions plus two per bytecode byte. Measured on Octane (compile-cost.md): with the
/// per-byte part, 100 does as well as 500 on the large benchmarks and costs the small ones
/// (richards, deltablue) a fifth as much.
pub const DEFAULT_PROFILE: u32 = 100
/// Recorded instructions from which a site the recording never reached counts as cold.
const SEEN_ENOUGH: u64 = 100
/// Entries a function runs while it records feedback before it is reported again.
const PROFILE_ENTRIES: u32 = 24

/// Stops bytecode's recording and adds to sites what it teaches the translator: arithmetic
/// sites that saw a double operand or an int32 overflow, branches that tested something other
/// than a boolean. Returns why the function should stay interpreted, or nothing: a call it
/// recorded reached a bytecode function that was reported and has no code to call (compiled
/// code deoptimizes at each such call, js_vm.compiledCall), or a property site the helpers
/// decline.
unsafe effect fn learn(jit: &mut Jit, rt: *mut HeapHeader, bytecode: *mut HeapHeader, sites: &mut List<u32>, elements: &mut List<u32>) -> &'static [u8] ! OutOfMemoryError ? &mut Allocator {
  drop unsafe feedback.stop(rt, bytecode)
  let seen = match run unsafe feedback.snapshot(rt, bytecode) {
    Option<feedback.Snapshot>.Some { value } => move value
    Option<feedback.Snapshot>.None => { return b"" }
  }
  let mut hopeless = false
  let mut why: &'static [u8] = b"it calls a function that stays interpreted"
  let mut index: usize = 0
  while index < seen.sites.length() {
    let site = seen.sites.get(index)
    let numeric = site.kind == feedback.KIND_BINARY || site.kind == feedback.KIND_UNARY
    let wide = u8.bitAnd(u8.bitOr(site.left, site.right), feedback.SEEN_DOUBLE) != 0 || u8.bitAnd(site.flags, feedback.SEEN_OVERFLOW) != 0
    // A branch the recording never reached is cold or late: ToBoolean there costs a helper call,
    // a wrong guess that it tests a boolean costs the function its code.
    let truthy = site.kind == feedback.KIND_BRANCH && (u8.bitAnd(site.flags, feedback.SEEN_NOT_BOOL) != 0 || (site.count == 0 && seen.observed >= SEEN_ENOUGH))
    if (numeric && wide) || truthy {
      let mut k: usize = 0
      let mut known = false
      while k < sites.length() { if sites.get(k) == site.offset { known = true } k = k + 1 }
      if !known { run sites.append(site.offset) jit.learned = jit.learned + 1 }
    }
    // Arithmetic and order comparisons are compiled for numbers only; an equality that met
    // other values is widened instead (ssa_translate's Equals helper call).
    let equality = site.opcode == op.OP_eq || site.opcode == op.OP_neq || site.opcode == op.OP_strict_eq
      || site.opcode == op.OP_strict_neq || site.opcode == op.OP_strict_eq_imm8 || site.opcode == op.OP_strict_neq_imm8
    if numeric && site.count != 0 && u8.bitAnd(u8.bitOr(site.left, site.right), u8.bitOr(u8.bitOr(feedback.SEEN_STRING, feedback.SEEN_OBJECT), feedback.SEEN_OTHER)) != 0 {
      if equality {
        let mut k: usize = 0
        let mut known = false
        while k < sites.length() { if sites.get(k) == site.offset { known = true } k = k + 1 }
        if !known { run sites.append(site.offset) jit.learned = jit.learned + 1 }
      } else if u32.bitAnd(jit.options.foresee, FORESEE_NUMBERS) != 0 { hopeless = true why = b"an operand of arithmetic or a comparison that is not a number" }
    }
    // A store whose receivers had too many shapes for its caches, or a named read or store on
    // something that is not an object: the helpers decline those and the code would deoptimize.
    if site.kind == feedback.KIND_PROPERTY && site.count != 0 {
      if u32.bitAnd(jit.options.foresee, FORESEE_RECEIVER) != 0 && site.left != feedback.SEEN_OBJECT && site.opcode != op.OP_get_length { hopeless = true why = b"a named property of a value that is not an object" }
      else if u32.bitAnd(jit.options.foresee, FORESEE_STORE) != 0 && site.shapeCount == feedback.MEGAMORPHIC_SHAPES && (site.opcode == op.OP_put_field || site.opcode == op.OP_put_loc_field_loc8 || site.opcode == op.OP_put_loc_field_arg8) {
        hopeless = true why = b"a store to objects of too many shapes"
      }
    }
    if site.kind == feedback.KIND_ELEMENT && site.right != feedback.ELEMENT_NONE && site.right != feedback.ELEMENT_MIXED {
      run elements.append(u32.shiftLeft(site.offset, 8) | u8.toU32(site.right))
    }
    if site.kind == feedback.KIND_CALL && jit.options.calls && u32.bitAnd(jit.options.foresee, FORESEE_CALLEE) != 0 {
      if site.first != feedback.NO_TARGET && unsafe codeless(rt, &seen.targets.get(u32.toUsize(site.first))) { hopeless = true }
      if site.second != feedback.NO_TARGET && unsafe codeless(rt, &seen.targets.get(u32.toUsize(site.second))) { hopeless = true }
    }
    index = index + 1
  }
  if hopeless { return why }
  return b""
}
/// Whether target is a bytecode function the engine reported hot that was refused: no code,
/// or code for its loops only, and not counting entries towards another report.
unsafe fn codeless(rt: *mut HeapHeader, target: &feedback.Target) -> bool {
  if target.kind != feedback.TARGET_BYTECODE { return false }
  let callee = match target.function { ValueBits.FunctionBytecode { reference } => reference _ => { return false } }
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, callee)
  if code.compiled != 0 {
    let index = code.compiled
    drop code
    return unsafe compiled.callWords(rt, index) == u32.toUsize(OSR_ONLY_CALL_WORDS)
  }
  return code.hotness >= REPORTED_FLOOR
}
/// js_hotness parks a reported function's count at or above this.
const REPORTED_FLOOR: u32 = 2147483648

/// Compiles bytecode, a FunctionBytecode cell reported hot, and links it, or refuses it.
pub unsafe effect fn compileHot(jit: &mut Jit, bytecode: *mut HeapHeader) -> () ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  if jit.options.baseline { run unsafe compileBaseline(&mut jit, bytecode) return () }
  let attached = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  let loopPc = unsafe runtime.hotLoopPc(attached)
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  // A poll in a linked function at a header with no OSR entry yet: that header alone.
  if function.compiled != 0 && loopPc != NO_LOOP {
    let index = u32.toUsize(function.compiled - 1)
    drop function
    run unsafe addHeader(&mut jit, bytecode, index, loopPc)
    return ()
  }
  jit.reported = jit.reported + 1
  if jit.entries.length() >= CAPACITY { jit.refused = jit.refused + 1 return () }
  if jit.options.dump { run unsafe dumpBytecode(&function) }
  let mut plan = run unsafe jit.history.plan(&function, Pointer.address<HeapHeader>(bytecode), &jit.entries)
  if plan.recompile { jit.recompiled = jit.recompiled + 1 }
  if jit.options.dump && plan.recompile { run unsafe dumpSites(&function, plan.sites.asSlice(), plan.kinds.asSlice(), plan.fresh, plan.refuse) }
  if jit.options.dump && plan.recompile && jit.options.profile != 0 { run unsafe dumpSeen(attached, bytecode, &function, plan.sites.asSlice(), plan.fresh) }
  if plan.refuse {
    jit.refused = jit.refused + 1
    if jit.options.dump { run say(b"jit: refused: ", plan.why) }
    return ()
  }
  // A first compilation learns its number sites from a short recording first: the function is
  // reported again after PROFILE_ENTRIES entries, or at the next poll in one of its loops.
  if jit.options.profile != 0 {
    if jit.history.profile(&plan) {
      // Recording costs observed-loop time: only for a function the translator can take.
      let input = run inputOf(&function)
      // A longer body needs a longer look: two more instructions per bytecode byte.
      let mut budget = jit.options.profile
      let extra = usize.toU32(input.code.length()) * 2
      if extra < u32.MAX - budget { budget = budget + extra }
      if (run admits(&input, jit.options.calls)) && run unsafe feedback.start(attached, bytecode, budget) {
        drop function
        let mut codeAnchor = () let owner = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut codeAnchor, bytecode)
        // Never above the hot budget: the engine takes such a count for a function without code
        // and deoptimizes compiled callers at their calls to it (js_vm.reportedWithoutCode).
        let mut entries = PROFILE_ENTRIES
        if jit.options.threshold != 0 && jit.options.threshold < entries { entries = jit.options.threshold }
        owner.hotness = entries
        drop owner
        jit.profiled = jit.profiled + 1
        jit.reported = jit.reported - 1
        if jit.options.dump { run say(b"jit: records feedback first", b"") }
        return ()
      }
    } else if !plan.recompile {
      let why = run unsafe learn(&mut jit, attached, bytecode, &mut plan.sites, &mut plan.elements)
      if why.length != 0 {
        jit.refused = jit.refused + 1
        jit.foreseen = jit.foreseen + 1
        if jit.options.dump { run say(b"jit: refused: ", why) }
        run jit.history.remember(&plan, recompile.noEntry())
        return ()
      }
    }
  }
  // A recompilation after an unlink waits for more entries first (jit_recompile.backoff); a
  // report from a loop poll is a loop running now and compiles at once.
  if loopPc == NO_LOOP {
    let wait = jit.history.backoff(&plan)
    if wait != 0 {
      drop function
      let mut base = jit.options.threshold
      if base == 0 { base = HOT_ENTRY_BUDGET }
      let mut entries = u32.MAX / 4
      if base < entries / wait { entries = base * wait }
      let mut codeAnchor = () let owner = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut codeAnchor, bytecode)
      owner.hotness = entries
      drop owner
      jit.waited = jit.waited + 1
      jit.reported = jit.reported - 1
      jit.recompiled = jit.recompiled - 1
      if jit.options.dump { run say(b"jit: waits before recompiling", b"") }
      return ()
    }
  }
  let bytes = (unsafe function.code.asSlice()).length
  if !jit.history.charge(&plan, bytes, u32.toU64(jit.options.compileBudget)) {
    jit.refused = jit.refused + 1
    jit.overBudget = jit.overBudget + 1
    if jit.options.dump { run say(b"jit: refused: ", b"over the compile budget (--jit-compile-budget)") }
    run jit.history.remember(&plan, recompile.noEntry())
    return ()
  }
  let mut cost = Cost.make()
  cost.dump = jit.options.dump
  cost.passes = jit.options.passes
  // What its method calls called last, to inline (docs/jit/inlining.md): cells[id] is the
  // FunctionBytecode cell of the target a CallTarget names.
  let mut cells = List<?*mut HeapHeader>.make()
  let mut closures = List<?*mut HeapHeader>.make()
  let mut targets = List<CallTarget>.make()
  let mut holders = List<?*mut HeapHeader>.make()
  let mut dummyDescs = List<ConstructDesc>.make()
  let mut dummyConstructs = List<ConstructTarget>.make()
  let activeMisses = run collectActiveMisses(&jit)
  if jit.options.calls && jit.options.inlining { targets = run unsafe candidates(&jit, &activeMisses, bytecode, 0, &mut cells, &mut closures, &mut holders, false, false, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), &mut dummyDescs, &mut dummyConstructs) }
  let lowered = run Effect.result(unsafe lower.lowerInlining(&function, jit.options.stress, jit.options.calls, &plan.sites, move targets, &plan.elements, &mut cost))
  jit.cost.add(&cost)
  if jit.options.dump { run dumpCost(b"jit: cost entry", &cost) }
  drop function
  // OSR code only for the loop whose poll reported the function; other headers compile when
  // a poll lands at them (addHeader).
  let mut osr = List<OsrEntry>.make()
  let mut spent: u64 = 0
  if loopPc != NO_LOOP {
    let started = now()
    run osr.append(run unsafe compileHeader(&mut jit, bytecode, &plan.sites, loopPc))
    spent = elapsed(started)
  }
  let result = match move lowered {
    Result<Lowered, OutOfMemoryError | UnboundLabelError>.Success { value } => move value
    Result<Lowered, OutOfMemoryError | UnboundLabelError>.Failure { .. } => { jit.failed = jit.failed + 1 return () }
  }
  let mut callWords: u32 = 0
  let mut genericSites: u32 = 0
    // The inline targets the code names, in symbol order.
  let mut used = List<?*mut HeapHeader>.make()
  if let Lowered.Code { callWords: words, inlined, genericSites: sites, .. } = &result {
    callWords = words genericSites = sites
    let mut k: usize = 0
    while k < inlined.length() { run used.append(cells.get(u32.toUsize(inlined.get(k)))) k = k + 1 }
  }
  let mut code = match move result {
    Lowered.Code { value, .. } => move value
    Lowered.Refused { reason } => {
      jit.refused = jit.refused + 1
      if jit.options.dump { run sayRefusal(&reason) }
      let mut linked = recompile.noEntry()
      if hasCode(&osr) { linked = run unsafe installOsrOnly(&mut jit, bytecode, move osr, &plan.sites, spent) }
      run jit.history.remember(&plan, linked)
      return ()
    }
  }
  if jit.options.dump { run dumpMachine(&code) }
  let installed = run unsafe installLinked(&mut jit, bytecode, &mut code, callWords, &plan.sites, spent, &used)
  if !installed { jit.refused = jit.refused + 1 return () }
  jit.inlinedSites = jit.inlinedSites + usize.toU64(used.length())
  run jit.history.remember(&plan, usize.toU32(jit.entries.length() - 1))
  jit.compiledFunctions = jit.compiledFunctions + 1
  jit.genericSites = jit.genericSites + u32.toU64(genericSites)
  if jit.options.dump {
    let mut line = List<u8>.make()
    run line.appendSlice(b"jit: compiled entry ") run decimal(&mut line, usize.toU64(jit.entries.length() - 1))
    run line.append(10)
    io.stderr(line.asSlice())
  }
  let last = jit.entries.length() - 1
  run unsafe attachOsr(&mut jit, last, move osr)
}

fn hasCode(list: &List<OsrEntry>) -> bool {
  let mut i: usize = 0
  while i < list.length() { if !Pointer.isNull<u8>(list.get(i).code) { return true } i = i + 1 }
  return false
}

/// Gives linked table entry index an OSR entry for loop header pc of bytecode: compiled, or
/// refused (null code) past OSR_HEADERS compiled headers or OSR_BUDGET_NS of compiling.
unsafe effect fn addHeader(jit: &mut Jit, bytecode: *mut HeapHeader, index: usize, pc: u32) -> () ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  let mut list = List<OsrEntry>.make()
  let count = jit.entries.asSlice()[index].osrCount
  let pointer = jit.entries.asSlice()[index].osr
  if count != 0 {
    let old = unsafe Pointer.assumeMany<OsrEntry>(unsafe Intrinsic.pointerRequalify<?*mut OsrEntry, *const OsrEntry>(pointer))
    let mut i: u32 = 0
    while i < count { run list.append(unsafe Pointer.read<OsrEntry>(unsafe Pointer.at<OsrEntry>(old, u32.toUsize(i)))) i = i + 1 }
  }
  let mut compiled: usize = 0
  let mut i: usize = 0
  while i < list.length() { if !Pointer.isNull<u8>(list.get(i).code) { compiled = compiled + 1 } i = i + 1 }
  let over = compiled >= OSR_HEADERS || jit.books.asSlice()[index].spent >= OSR_BUDGET_NS
  if over {
    jit.osrRefused = jit.osrRefused + 1
    if jit.options.dump { run say(b"jit: osr refused: ", b"loop budget of the function used up") }
    run list.append(refusedHeader(pc))
  } else {
    let sites = run copySites(&jit.books.asSlice()[index].sites)
    let started = now()
    run list.append(run unsafe compileHeader(&mut jit, bytecode, &sites, pc))
    let books = jit.books.asMutSlice()
    books[index].spent = books[index].spent + elapsed(started)
  }
  run unsafe attachOsr(&mut jit, index, move list)
}
effect fn copySites(from: &List<u32>) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u32>.make()
  run out.appendSlice(from.asSlice())
  return move out
}
fn refusedHeader(pc: u32) -> OsrEntry {
  return OsrEntry { pc: pc, depth: 0, code: Pointer.null<u8>(), callWords: 0, start: 0, end: 0, deopts: 0, wait: 0, deoptOpcode: 0 }
}

/// Compiles and publishes the on-stack-replacement entry for loop header pc of bytecode
/// (docs/jit/osr.md); a refusal (or a pc that is no loop header) is an entry with null code.
unsafe effect fn compileHeader(jit: &mut Jit, bytecode: *mut HeapHeader, doubleSites: &List<u32>, header: u32) -> OsrEntry ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let input = run inputOf(&function)
  let headers = run loopHeaders(&input)
  let mut known = false
  let mut i: usize = 0
  while i < headers.length() { if headers.get(i) == header { known = true } i = i + 1 }
  if !known { return refusedHeader(header) }
  let region = run loopRegion(&input, header)
  if region.end - region.start > OSR_LOOP_BYTES {
    jit.osrRefused = jit.osrRefused + 1
    if jit.options.dump { run say(b"jit: osr refused: ", b"a loop of too much code") }
    return refusedHeader(header)
  }
  if jit.options.dump {
    match move run Effect.result(translateOsr(&input, header, jit.options.calls)) {
      Result<Function, TranslateRefusal | OutOfMemoryError>.Success { value } => { let mut out = List<u8>.make() run value.print(&mut out) io.stderr(out.asSlice()) }
      Result<Function, TranslateRefusal | OutOfMemoryError>.Failure { .. } => ()
    }
  }
  let mut cost = Cost.make()
  cost.dump = jit.options.dump
  cost.passes = jit.options.passes
  let lowered = run Effect.result(unsafe lower.lowerOsr(&function, jit.options.stress, jit.options.calls, doubleSites, header, &mut cost))
  jit.cost.add(&cost)
  if jit.options.dump { run dumpCost(b"jit: cost osr", &cost) }
  drop function
  let result = match move lowered {
    Result<Lowered, OutOfMemoryError | UnboundLabelError>.Success { value } => move value
    Result<Lowered, OutOfMemoryError | UnboundLabelError>.Failure { .. } => { jit.failed = jit.failed + 1 return refusedHeader(header) }
  }
  let mut osrCallWords: u32 = 0
  let mut code = match move result {
    Lowered.Code { value, callWords, .. } => { osrCallWords = callWords move value }
    Lowered.Refused { reason } => {
      jit.osrRefused = jit.osrRefused + 1
      if jit.options.dump { run say(b"jit: osr refused: ", reason.text()) }
      return refusedHeader(header)
    }
  }
  if jit.memory.isNone() { jit.memory = Option<CodeMemory>.some(run CodeMemory.reserve(CODE_BYTES)) }
  let noSymbols: [usize; 1] = [0]
  let block = match &mut jit.memory {
    Option<CodeMemory>.Some { value } => run publish(&mut value, &mut code, Slice.view<usize>(&noSymbols, 0, 0))
    Option<CodeMemory>.None => { return refusedHeader(header) }
  }
  if jit.options.dump { run dumpPlaced(b"jit: osr code at ", Pointer.address<u8>(block.entry()), &code) }
  jit.codeBytes = jit.codeBytes + usize.toU64(code.bytes.length())
  let base = run osrMarkers(&input, header)
  let entry = OsrEntry { pc: header, depth: usize.toU32(base.length()), code: block.entry(), callWords: osrCallWords, start: region.start, end: region.end, deopts: 0, wait: 0, deoptOpcode: 0 }
  run jit.blocks.append(move block)
  jit.osrCompiled = jit.osrCompiled + 1
  if jit.options.dump { run say(b"jit: osr compiled", b"") }
  return entry
}
/// Gives table entry index the loop-header entries in list (replacing any it had; the old
/// list stays allocated, as a poll may still hold an entry of it).
unsafe effect fn attachOsr(jit: &mut Jit, index: usize, list: List<OsrEntry>) -> () ! OutOfMemoryError ? &mut Allocator {
  if list.length() == 0 { return () }
  let count = usize.toU32(list.length())
  run jit.osrLists.append(move list)
  let stored = jit.osrLists.length() - 1
  let lists = jit.osrLists.asMutSlice()
  let pointer = unsafe Intrinsic.pointerRequalify<?[*]mut OsrEntry, ?*mut OsrEntry>(unsafe lists[stored].storage())
  let entries = jit.entries.asMutSlice()
  entries[index].osr = pointer
  entries[index].osrCount = count
}
unsafe effect fn codeCopy(dump: bool, bytecode: *mut HeapHeader) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  if !dump { return move out }
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  run out.appendSlice(unsafe function.code.asSlice())
  return move out
}
/// Links bytecode, whose normal entry was refused, for on-stack replacement only.
/// Returns its table index (for jit_recompile, which reads its OSR deopt sites) or
/// recompile.noEntry() when the table is full.
unsafe effect fn installOsrOnly(jit: &mut Jit, bytecode: *mut HeapHeader, list: List<OsrEntry>, sites: &List<u32>, spent: u64) -> u32 ! OutOfMemoryError ? &mut Allocator {
  if jit.entries.length() >= CAPACITY { return recompile.noEntry() }
  let index = jit.entries.length()
  // The osr code reads the stress countdown through the entry's data word, as normal code does.
  let mut stress: ?*mut u8 = Pointer.null<u8>()
  if jit.options.stress != 0 {
    jit.stressCounter = u32.wrappingToI32(jit.options.stress)
    stress = unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(Pointer.fromMutRef<i32>(&mut jit.stressCounter))
  }
  let env = unsafe Intrinsic.pointerReinterpret<*mut CompiledEnv, *mut u8>(Pointer.fromMutRef<CompiledEnv>(&mut jit.env.asMutSlice()[0]))
  let added = jit.entries.appendWithinCapacity(blankEntry(Pointer.null<u8>(), stress, env, jit.options.deoptLimit, OSR_ONLY_CALL_WORDS))
  if !added { return recompile.noEntry() }
  let kept = run unsafe codeCopy(jit.options.dump, bytecode)
  run jit.books.append(LoopBook { sites: run copySites(&sites), spent: spent, code: move kept })
  run unsafe attachOsr(&mut jit, index, move list)
  let attached = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  unsafe runtime.linkOsr(attached, bytecode, usize.toU32(index))
  jit.osrOnly = jit.osrOnly + 1
  return usize.toU32(index)
}
fn blankEntry(code: ?*const u8, data: ?*mut u8, env: ?*mut u8, deoptLimit: u32, callWords: u32) -> CompiledEntry {
  return CompiledEntry { code: code, data: data, env: env, deoptLimit: deoptLimit, frameCells: 0, leaf: 0, callWords: callWords, runs: 0, deopts: 0, polls: 0, deoptPcs: [0; 4], deoptPcCount: 0,
    osr: Pointer.null<OsrEntry>(), osrCount: 0, osrRuns: 0, osrDeopts: 0, deoptKinds: [0; 4], activationWords: 0, counter: Pointer.null<i32>(),
    directArity: compiled.DIRECT_NOT_READY, directRealm: Pointer.null<HeapHeader>(), directCode: Pointer.null<u8>() }
}

/// Links code, lowered from bytecode by this or another runtime's compiler (it holds no
/// process-local address until linked), publishes it at this runtime's next code address and
/// links bytecode to it. callWords: its call block size (Lowered.Code.callWords). False when
/// the table is full.
pub unsafe effect fn install(jit: &mut Jit, bytecode: *mut HeapHeader, code: &mut Code, callWords: u32, sites: &List<u32>, spent: u64) -> bool ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  let none = List<?*mut HeapHeader>.make()
  return run unsafe installLinked(&mut jit, bytecode, &mut code, callWords, sites, spent, &none)
}
/// install for code that names inline targets: targets holds each one's FunctionBytecode
/// cell, in symbol order (Lowered.Code.inlined). Each is kept alive for the runtime's life
/// first; false, with nothing linked, when that cannot be done.
unsafe effect fn installLinked(jit: &mut Jit, bytecode: *mut HeapHeader, code: &mut Code, callWords: u32, sites: &List<u32>, spent: u64, targets: &List<?*mut HeapHeader>) -> bool ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  if jit.entries.length() >= CAPACITY { return false }
  let attachedRuntime = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  // Per target: the address of its cell, of the first byte of its code, and a word for the
  // closure of an exact target, which this entry kind has none of.
  let mut symbols = List<usize>.make()
  let mut s: usize = 0
  while s < targets.length() {
    let cell = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(targets.get(s))
    if !(unsafe inline.keep(attachedRuntime, cell)) { return false }
    run symbols.append(Pointer.address<HeapHeader>(cell))
    run symbols.append(Pointer.address<u8>(unsafe inline.codeStart(cell)))
    run symbols.append(0)
    s = s + 1
  }
  if jit.memory.isNone() { jit.memory = Option<CodeMemory>.some(run CodeMemory.reserve(CODE_BYTES)) }
  let block = match &mut jit.memory {
    Option<CodeMemory>.Some { value } => run publish(&mut value, &mut code, symbols.asSlice())
    Option<CodeMemory>.None => { return false }
  }
  let entry = block.entry()
  jit.codeBytes = jit.codeBytes + usize.toU64(code.bytes.length())
  if jit.options.dump { run dumpPlaced(b"jit: code at ", Pointer.address<u8>(entry), &code) }
  run jit.blocks.append(move block)
  let mut stress: ?*mut u8 = Pointer.null<u8>()
  if jit.options.stress != 0 {
    jit.stressCounter = u32.wrappingToI32(jit.options.stress)
    stress = unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(Pointer.fromMutRef<i32>(&mut jit.stressCounter))
  }
  let index = jit.entries.length()
  let env = unsafe Intrinsic.pointerReinterpret<*mut CompiledEnv, *mut u8>(Pointer.fromMutRef<CompiledEnv>(&mut jit.env.asMutSlice()[0]))
  let added = jit.entries.appendWithinCapacity(blankEntry(entry, stress, env, jit.options.deoptLimit, callWords))
  if !added { return false }
  let kept = run unsafe codeCopy(jit.options.dump, bytecode)
  run jit.books.append(LoopBook { sites: run copySites(&sites), spent: spent, code: move kept })
  let attached = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  unsafe runtime.linkCompiled(attached, bytecode, usize.toU32(index))
  jit.lastEntry = usize.toU64(Pointer.address<u8>(entry))
  return true
}

/// Starts the watch of the records in the variable cells of the targets' closures
/// (inline.cellRecord) and remembers each new one. Runs where watchHolder may: inside the
/// compile a function's entry made.
unsafe effect fn watchRecords(jit: &mut Jit, rt: *mut HeapHeader, closures: &List<?*mut HeapHeader>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut c: usize = 0
  while c < closures.length() {
    let found = closures.get(c)
    c = c + 1
    let closure = match Pointer.nonNullMut<HeapHeader>(found) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { continue } }
    let mut i: u32 = 0
    while i < 64 {
      let mut record = WatchedRecord.none()
      if unsafe inline.ownedCell(closure, i) != 0 && run unsafe inline.cellRecord(rt, closure, i, true, &mut record) {
        let mut known = false
        let mut n: usize = 0
        while n < jit.records.length() { if Pointer.address<HeapHeader>(jit.records.get(n).object) == Pointer.address<HeapHeader>(record.object) { known = true } n = n + 1 }
        if !known {
          if jit.options.dump {
            // `jit: watched record: <version before> <version> <slots>`.
            let mut line = List<u8>.make()
            run decimal(&mut line, record.before) run line.append(32) run decimal(&mut line, record.version) run line.append(32) run decimal(&mut line, usize.toU64(record.count))
            run say(b"jit: watched record: ", line.asSlice())
          }
          run jit.records.append(record)
        }
      }
      i = i + 1
    }
  }
}
/// The constant slots of the records still watched as they were found (recordHolds), for
/// FunctionInput.records.
unsafe effect fn recordSlots(jit: &Jit) -> List<RecordSlot> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<RecordSlot>.make()
  let mut n: usize = 0
  while n < jit.records.length() {
    let record = jit.records.get(n)
    n = n + 1
    let object = match Pointer.nonNullMut<HeapHeader>(record.object) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { continue } }
    // Versions the code compares as 32-bit immediates.
    if record.version >= 2147483648 || !unsafe inline.recordHolds(object, record.version) { continue }
    let mut before = record.version
    if record.before < 2147483648 { before = record.before }
    let mut i: usize = 0
    while i < record.count {
      if record.kinds[i] != inline.RECORD_NONE {
        run out.append(RecordSlot { before: u64.wrappingToU32(before), version: u64.wrappingToU32(record.version), slot: usize.toU32(i), kind: record.kinds[i], value: record.values[i] })
      }
      i = i + 1
    }
  }
  return move out
}

/// How many times a first optimization waits for method calls not yet run, and how much
/// longer each wait is than the last (unseenCalls).
const UNSEEN_WAITS: u8 = 2
const UNSEEN_BACKOFF: u32 = 4
/// How many `get_field2` sites of bytecode's own code nothing has recorded yet: no shape in
/// the site table and the field cache entry another site's (inline.methodMiss 1), as for a
/// read that has not run.
unsafe fn unseenCalls(rt: *mut HeapHeader, bytecode: *mut HeapHeader) -> u32 {
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let bytes = unsafe function.code.asSlice()
  let length = bytes.length
  let mut unseen: u32 = 0
  let mut pc: usize = 0
  while pc < length {
    let opcode = bytes[pc]
    let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
    if size == 0 { return unseen }
    if opcode == op.OP_get_field2 && unsafe inline.siteSeen(rt, bytecode, usize.toU32(pc)) == 0 && unsafe inline.methodMiss(rt, bytecode, usize.toU32(pc)) == 1 { unseen = unseen + 1 }
    pc = pc + size
  }
  return unseen
}

/// The local `push_this; put_loc` puts `this` in where the code starts, when no other
/// instruction writes or refers to it (so it holds `this` for good), else usize.MAX.
fn thisLocal(bytes: &[u8]) -> usize {
  if bytes.length < 2 || bytes[0] != op.OP_push_this { return usize.MAX }
  let first = writtenLocal(bytes, 1)
  if first == usize.MAX || first == usize.MAX - 1 { return usize.MAX }
  let mut pc: usize = 1 + u8.toUsize(op.opcodeInfo(bytes[1], true).size)
  while pc < bytes.length {
    let size = u8.toUsize(op.opcodeInfo(bytes[pc], true).size)
    if size == 0 || pc + size > bytes.length { return usize.MAX }
    let written = writtenLocal(bytes, pc)
    if written == first || written == usize.MAX - 1 { return usize.MAX }
    pc = pc + size
  }
  return first
}
/// The local the instruction at pc writes, usize.MAX - 1 for one that may write or refer
/// to any (references to locals), usize.MAX for none.
fn writtenLocal(bytes: &[u8], pc: usize) -> usize {
  let opcode = bytes[pc]
  if opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3 { return u8.toUsize(opcode - op.OP_put_loc0) }
  if opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8 || opcode == op.OP_inc_loc || opcode == op.OP_dec_loc || opcode == op.OP_add_loc || opcode == op.OP_step_loc8 {
    if pc + 1 >= bytes.length { return usize.MAX - 1 }
    return u8.toUsize(bytes[pc + 1])
  }
  if opcode == op.OP_put_loc || opcode == op.OP_set_loc || opcode == op.OP_put_loc_check || opcode == op.OP_set_loc_check
    || opcode == op.OP_put_loc_check_init || opcode == op.OP_set_loc_uninitialized {
    if pc + 2 >= bytes.length { return usize.MAX - 1 }
    return u8.toUsize(bytes[pc + 1]) | usize.shiftLeft(u8.toUsize(bytes[pc + 2]), 8)
  }
  if opcode == op.OP_close_loc || opcode == op.OP_make_loc_ref { return usize.MAX - 1 }
  return usize.MAX
}
/// The local the instruction at `at`, which ends at `next`, reads onto the stack (get_loc
/// and its short forms), or usize.MAX.
fn readLocal(bytes: &[u8], at: usize, next: usize) -> usize {
  let opcode = bytes[at]
  if opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3 && at + 1 == next { return u8.toUsize(opcode - op.OP_get_loc0) }
  if opcode == op.OP_get_loc8 && at + 2 == next { return u8.toUsize(bytes[at + 1]) }
  if opcode == op.OP_get_loc && at + 3 == next { return u8.toUsize(bytes[at + 1]) | usize.shiftLeft(u8.toUsize(bytes[at + 2]), 8) }
  return usize.MAX
}

/// CallTarget.owned for a target whose one closure is closure (null: none): which of its
/// first 64 variable cells own an initialized value.
unsafe fn ownedCells(closure: ?*mut HeapHeader) -> u64 {
  let object = match Pointer.nonNullMut<HeapHeader>(closure) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return 0 } }
  let mut owned: u64 = 0
  let mut i: u32 = 0
  while i < 64 {
    if unsafe inline.ownedCell(object, i) != 0 { owned = u64.bitOr(owned, u64.shiftLeft(1, u32.toU64(i))) }
    i = i + 1
  }
  return owned
}

/// The inline candidates of bytecode (docs/jit/inlining.md): for each get_field2 whose site
/// cache names a small plain function on a prototype, that function, with its own candidates
/// while depth allows. cells receives each one's FunctionBytecode cell address, at its id.
/// closures receives, at the same place, the closure of a target that is one closure (exact:
/// its id carries ssa.TARGET_EXACT), or null. owner is bytecode's closure when it is known
/// (null else): the variables it reads are its, and a method read off one is a target too;
/// receiver is the object its `this` is when that is known (an own method read off a
/// variable, inlined there), and a method read off `this` is a target too.
unsafe effect fn candidates(jit: &Jit, activeMisses: &List<usize>, bytecode: *mut HeapHeader, depth: u32, cells: &mut List<?*mut HeapHeader>, closures: &mut List<?*mut HeapHeader>, holders: &mut List<?*mut HeapHeader>, exact: bool, watch: bool, owner: ?*mut HeapHeader, knownScope: ?*mut HeapHeader, receiver: ?*mut HeapHeader, constructDescs: &mut List<ConstructDesc>, outConstructs: &mut List<ConstructTarget>) -> List<CallTarget> ! OutOfMemoryError ? &mut Allocator {
  let mut targets = List<CallTarget>.make()
  let rt = match Pointer.nonNullMut<HeapHeader>(jit.runtime) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return move targets } }
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let bytes = unsafe function.code.asSlice()
  // What the recording saw each call call (js_feedback): the one bytecode function of a site
  // with a single target.
  if jit.options.profile != 0 {
    if let Option<feedback.Snapshot>.Some { value: seen } = run unsafe feedback.snapshot(rt, bytecode) {
      let mut index: usize = 0
      while index < seen.sites.length() && cells.length() < MAX_CANDIDATES {
        let site = seen.sites.get(index)
        index = index + 1
        if site.kind != feedback.KIND_CALL || site.targets != 1 || site.first == feedback.NO_TARGET || site.opcode == op.OP_call_constructor { continue }
        let target = seen.targets.get(u32.toUsize(site.first))
        if target.kind != feedback.TARGET_BYTECODE { continue }
        let cell = match target.function { ValueBits.FunctionBytecode { reference } => reference _ => { continue } }
        if !unsafe inline.plainTarget(cell, bytecode) { continue }
        let callee = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, cell)
        if (unsafe callee.code.asSlice()).length > CANDIDATE_BYTES {
          if jit.options.dump && depth == 0 && !watch { run say(b"jit: no inline target: ", b"the function is too long") }
          continue
        }
        let mut input = run inputOf(&callee)
        if !watch {
          input.doubleSites = run calleeDoubleSites(jit, activeMisses, &callee)
          input.siteShapes = run unsafe siteShapesOf(rt, cell)
        }
        let id = usize.toU32(cells.length())
        run cells.append(unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(cell))
        run closures.append(Pointer.null<HeapHeader>())
        run appendKnown(&mut holders, &KnownMethod.none())
        let mut childConstructs = List<ConstructTarget>.make()
        if depth < CANDIDATE_DEPTH { input.targets = run unsafe candidates(jit, activeMisses, cell, depth + 1, &mut cells, &mut closures, &mut holders, exact, watch, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), &mut constructDescs, &mut childConstructs) }
        input.constructs = move childConstructs
        run targets.append(CallTarget { pc: site.offset, id: id, input: move input, atCall: true, chained: false, owned: 0, known: KnownShapes.none() })
      }
    }
  }
  let mut pc: usize = 0
  // The object produced by a contiguous `get_var` / `push_this` / `thisLocal` followed by
  // zero or more `get_field` hops (e.g. `Flog.RayTracer.Vector.prototype`), ending at `chainEnd`.
  // `chainPc` is the pc of the final `get_var` or `get_field` in the chain (or usize.MAX).
  let mut chainObj = Pointer.null<HeapHeader>()
  let mut chainEnd: usize = usize.MAX
  let mut chainPc: usize = usize.MAX
  let mut this = usize.MAX
  if !Pointer.isNull<HeapHeader>(receiver) { this = thisLocal(bytes) }
  let startScope = if !Pointer.isNull<HeapHeader>(knownScope) { knownScope } else { unsafe ownerScope(owner) }
  // Straight-line stack tracking for `get_var`/`get_scope0`; `<args>`; `call/call0..3` direct function calls.
  let trackVars = exact && (!Pointer.isNull<HeapHeader>(owner) || !Pointer.isNull<HeapHeader>(knownScope) || function.known.refs.length() != 0)
  let callerHasLoop = hasBackEdge(bytes)
  let mut jumpTargets = List<bool>.make()
  if trackVars { jumpTargets = run markJumpTargets(bytes) }
  let mut varStack: [ValueBits; 32] = [ValueBits.Undefined; 32]
  let mut varDepth: usize = 0
  while pc < bytes.length && cells.length() < MAX_CANDIDATES {
    if trackVars && jumpTargets.get(pc) { varDepth = 0 }
    let opcode = bytes[pc]
    let opInfo = op.opcodeInfo(opcode, true)
    let size = u8.toUsize(opInfo.size)
    if size == 0 || pc + size > bytes.length { break }
    // The methods a site read for the shapes it saw (the engine records them when shapes
    // are recorded): several, or one among shapes whose method is not known, are tested in
    // turn where they are called (CallTarget.chained).
    let mut several: [?*mut HeapHeader; 4] = [Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>()]
    // The closure each was read as, when the site read one closure for it: the target is
    // then that closure (ssa.TARGET_EXACT).
    let mut objects: [?*mut HeapHeader; 4] = [Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>()]
    let mut partial = false
    let mut known: u32 = 0
    if watch && opcode == op.OP_get_field2 { run unsafe inline.watchSite(rt, bytecode, usize.toU32(pc)) }
    if opcode == op.OP_get_field2 { known = unsafe inline.methodTargets(rt, bytecode, usize.toU32(pc), &mut several, &mut objects, &mut partial) }
    if known > 1 || (known == 1 && partial) {
      let mut n: usize = 0
      while n < u32.toUsize(known) && cells.length() < MAX_CANDIDATES {
        let cell = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(several[n])
        let mut object = objects[n]
        if !exact { object = Pointer.null<HeapHeader>() }
        n = n + 1
        let callee = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, cell)
        if (unsafe callee.code.asSlice()).length > CANDIDATE_BYTES {
          if jit.options.dump && depth == 0 && !watch { run say(b"jit: no inline target: ", b"one of the site's methods is too long") }
          continue
        }
        let mut id = usize.toU32(cells.length())
        run cells.append(unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(cell))
        run closures.append(object)
        if watch {
          if depth < CANDIDATE_DEPTH { drop run unsafe candidates(jit, activeMisses, cell, depth + 1, &mut cells, &mut closures, &mut holders, exact, true, object, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), &mut constructDescs, &mut outConstructs) }
          continue
        }
        let mut input = run inputOf(&callee)
        input.doubleSites = run calleeDoubleSites(jit, activeMisses, &callee)
        input.siteShapes = run unsafe siteShapesOf(rt, cell)
        // Known for the shapes that read it through watched prototypes (ssa.TARGET_KNOWN):
        // the receiver's shape then tells the callee, with no read and no test of it.
        let mut found = KnownMethod.none()
        if let Option<*mut HeapHeader>.Some { value: closure } = Pointer.nonNullMut<HeapHeader>(object) { unsafe inline.knownMethod(rt, bytecode, usize.toU32(pc), closure, &mut found) }
        run appendKnown(&mut holders, &found)
        if !Pointer.isNull<HeapHeader>(object) { id = u32.bitOr(id, TARGET_EXACT) }
        if found.count != 0 { id = u32.bitOr(id, TARGET_KNOWN) }
        if jit.options.dump {
          // `jit: chained target: <pc> <depth> <exact> <known shapes>`.
          let mut line = List<u8>.make()
          run decimal(&mut line, usize.toU64(pc)) run line.append(32) run decimal(&mut line, u32.toU64(depth)) run line.append(32)
          run decimal(&mut line, if Pointer.isNull<HeapHeader>(object) { 0 } else { 1 }) run line.append(32) run decimal(&mut line, usize.toU64(found.count))
          run say(b"jit: chained target: ", line.asSlice())
        }
        let mut childConstructs = List<ConstructTarget>.make()
        if depth < CANDIDATE_DEPTH { input.targets = run unsafe candidates(jit, activeMisses, cell, depth + 1, &mut cells, &mut closures, &mut holders, exact, false, object, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), &mut constructDescs, &mut childConstructs) }
        input.constructs = move childConstructs
        run targets.append(CallTarget { pc: usize.toU32(pc), id: id, input: move input, atCall: false, chained: true, owned: unsafe ownedCells(object), known: knownShapes(&found) })
      }
    } else if opcode == op.OP_get_field2 {
      // The one method every shape the site saw reads, else (nothing recorded of the site)
      // what its site cache entry names.
      let mut object = objects[0]
      let mut single = several[0]
      if known == 0 { single = unsafe inline.methodTarget(rt, bytecode, usize.toU32(pc), &mut object) }
      // A function's own method, read off the object a variable or property chain of this
      // code holds (`Strength.stronger(a, b)`, `Flog.RayTracer.Vector.prototype.subtract`),
      // or off `this` when this code's `this` is known to be such an object: the closure
      // there now, which the call tests its callee against. holder is that object.
      let mut holder = Pointer.null<HeapHeader>()
      if known == 0 && Pointer.isNull<HeapHeader>(single) && chainEnd == pc {
        holder = chainObj
        if let Option<*mut HeapHeader>.Some { value: from } = Pointer.nonNullMut<HeapHeader>(holder) {
          let atom = u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8) | u32.shiftLeft(u8.toU32(bytes[pc + 3]), 16) | u32.shiftLeft(u8.toU32(bytes[pc + 4]), 24)
          object = unsafe engineBaseline.ownMethod(from, atom, bytecode)
          if let Option<*mut HeapHeader>.Some { value: method } = Pointer.nonNullMut<HeapHeader>(object) { single = unsafe inline.closureBytecode(ValueBits.Object { reference: method }) }
          else { holder = Pointer.null<HeapHeader>() }
        }
      }
      if let Option<*mut HeapHeader>.Some { value: cell } = Pointer.nonNullMut<HeapHeader>(single) {
        if !exact { object = Pointer.null<HeapHeader>() }
        let callee = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, cell)
        if (unsafe callee.code.asSlice()).length <= CANDIDATE_BYTES {
          let mut id = usize.toU32(cells.length())
          run cells.append(unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(cell))
          run closures.append(object)
          if watch {
            if depth < CANDIDATE_DEPTH { drop run unsafe candidates(jit, activeMisses, cell, depth + 1, &mut cells, &mut closures, &mut holders, exact, true, object, Pointer.null<HeapHeader>(), holder, &mut constructDescs, &mut outConstructs) }
          } else {
            let mut input = run inputOf(&callee)
            input.doubleSites = run calleeDoubleSites(jit, activeMisses, &callee)
            input.siteShapes = run unsafe siteShapesOf(rt, cell)
            // The method read through watched prototypes is known without the read
            // (ssa.TARGET_KNOWN).
            let mut found = KnownMethod.none()
            if let Option<*mut HeapHeader>.Some { value: closure } = Pointer.nonNullMut<HeapHeader>(object) { unsafe inline.knownMethod(rt, bytecode, usize.toU32(pc), closure, &mut found) }
            run appendKnown(&mut holders, &found)
            if !Pointer.isNull<HeapHeader>(object) { id = u32.bitOr(id, TARGET_EXACT) }
            if found.count != 0 { id = u32.bitOr(id, TARGET_KNOWN) }
            let mut childConstructs = List<ConstructTarget>.make()
            if depth < CANDIDATE_DEPTH { input.targets = run unsafe candidates(jit, activeMisses, cell, depth + 1, &mut cells, &mut closures, &mut holders, exact, false, object, Pointer.null<HeapHeader>(), holder, &mut constructDescs, &mut childConstructs) }
            input.constructs = move childConstructs
            run targets.append(CallTarget { pc: usize.toU32(pc), id: id, input: move input, atCall: false, chained: false, owned: unsafe ownedCells(object), known: knownShapes(&found) })
          }
        } else if jit.options.dump && depth == 0 && !watch { run say(b"jit: no inline target: ", b"the method is too long") }
      } else if jit.options.dump && depth == 0 && !watch {
        let why = unsafe inline.methodMiss(rt, bytecode, usize.toU32(pc))
        let mut text: &'static [u8] = b"the slot holds no plain bytecode closure"
        if why == 1 { text = b"the site cache entry is another site's" }
        else if why == 2 { text = b"the site cache entry is not a prototype hit" }
        else if why == 3 { text = b"the site cache entry is stale" }
        else if why == 4 { text = b"no holder" }
        else if why == 6 { text = b"another realm's function" }
        run say(b"jit: no inline target: ", text)
      }
    } else if opcode == op.OP_dup && size == 1 && !watch && exact && chainEnd == pc && chainPc != usize.MAX {
      if let Option<*mut HeapHeader>.Some { value: ctor } = Pointer.nonNullMut<HeapHeader>(chainObj) {
        run unsafe buildConstruct(rt, ctor, usize.toU32(chainPc), &mut constructDescs, &mut outConstructs, 0)
      }
    } else if trackVars && ((opcode == op.OP_call && size == 3) || (opcode >= op.OP_call0 && opcode <= op.OP_call3)) {
      let argc = if opcode == op.OP_call { u8.toUsize(bytes[pc + 1]) | usize.shiftLeft(u8.toUsize(bytes[pc + 2]), 8) } else { u8.toUsize(opcode - op.OP_call0) }
      if varDepth >= argc + 1 {
        let calleeVal = varStack[varDepth - argc - 1]
        // The arguments that are literal numbers, by position (the first 32).
        let mut literals: u32 = 0
        let mut argAt: usize = 0
        while argAt < argc && argAt < 32 {
          match varStack[varDepth - argc + argAt] { ValueBits.Int { .. } => { literals = u32.bitOr(literals, u32.shiftLeft(1, usize.toU32(argAt))) } _ => () }
          argAt = argAt + 1
        }
        let mut seenAtCall = false
        let mut ti: usize = 0
        while ti < targets.length() {
          let existing = &targets.asSlice()[ti]
          if existing.atCall && existing.pc == usize.toU32(pc) { seenAtCall = true break }
          ti = ti + 1
        }
        if !seenAtCall {
          match calleeVal {
            ValueBits.Object { reference: calleeObj } => {
              let calleeOpt = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(calleeObj)
              if let Option<*mut HeapHeader>.Some { value: cell } = Pointer.nonNullMut<HeapHeader>(unsafe inline.closureBytecode(calleeVal)) {
                if Pointer.address<HeapHeader>(cell) != Pointer.address<HeapHeader>(bytecode) {
                  let callee = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, cell)
                  let calleeBytes = unsafe callee.code.asSlice()
                  let codeLen = calleeBytes.length
                  if callee.scopeSlots == 0 && callee.varRefCount == 0
                    && Pointer.address<HeapHeader>(callee.realm) == Pointer.address<HeapHeader>(function.realm)
                    && codeLen > 0 && (codeLen <= VAR_CALL_BYTES || (codeLen <= CANDIDATE_BYTES && decides(calleeBytes, literals))) && ((depth == 0 && bytes.length <= LOOPED_VAR_CALLER_BYTES) || !hasBackEdge(calleeBytes)) {
                    let id = u32.bitOr(usize.toU32(cells.length()), TARGET_EXACT)
                    run cells.append(unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(cell))
                    run closures.append(calleeOpt)
                    if watch {
                      if depth < VAR_CALL_DEPTH { drop run unsafe candidates(jit, activeMisses, cell, depth + 1, &mut cells, &mut closures, &mut holders, exact, true, calleeOpt, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), &mut constructDescs, &mut outConstructs) }
                    } else {
                      let mut input = run inputOf(&callee)
                      input.doubleSites = run calleeDoubleSites(jit, activeMisses, &callee)
                      input.siteShapes = run unsafe siteShapesOf(rt, cell)
                      run appendKnown(&mut holders, &KnownMethod.none())
                      let mut childConstructs = List<ConstructTarget>.make()
                      if depth < VAR_CALL_DEPTH { input.targets = run unsafe candidates(jit, activeMisses, cell, depth + 1, &mut cells, &mut closures, &mut holders, exact, false, calleeOpt, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), &mut constructDescs, &mut childConstructs) }
                      input.constructs = move childConstructs
                      run targets.append(CallTarget { pc: usize.toU32(pc), id: id, input: move input, atCall: true, chained: false, owned: unsafe ownedCells(calleeOpt), known: KnownShapes.none() })
                    }
                  }
                }
              }
            }
            ValueBits.FunctionBytecode { reference: cell } => {
              if Pointer.address<HeapHeader>(cell) != Pointer.address<HeapHeader>(bytecode) && unsafe inline.plainTarget(cell, bytecode) {
                let callee = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, cell)
                let calleeBytes = unsafe callee.code.asSlice()
                let codeLen = calleeBytes.length
                if callee.scopeSlots == 0 && callee.varRefCount == 0
                  && codeLen > 0 && (codeLen <= VAR_CALL_BYTES || (codeLen <= CANDIDATE_BYTES && decides(calleeBytes, literals))) && ((depth == 0 && bytes.length <= LOOPED_VAR_CALLER_BYTES) || !hasBackEdge(calleeBytes)) {
                  let id = u32.bitOr(usize.toU32(cells.length()), TARGET_KNOWN_FN)
                  run cells.append(unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(cell))
                  run closures.append(Pointer.null<HeapHeader>())
                  if watch {
                    if depth < VAR_CALL_DEPTH { drop run unsafe candidates(jit, activeMisses, cell, depth + 1, &mut cells, &mut closures, &mut holders, exact, true, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), &mut constructDescs, &mut outConstructs) }
                  } else {
                    let mut input = run inputOf(&callee)
                    input.doubleSites = run calleeDoubleSites(jit, activeMisses, &callee)
                    input.siteShapes = run unsafe siteShapesOf(rt, cell)
                    run appendKnown(&mut holders, &KnownMethod.none())
                    let mut childConstructs = List<ConstructTarget>.make()
                    if depth < VAR_CALL_DEPTH { input.targets = run unsafe candidates(jit, activeMisses, cell, depth + 1, &mut cells, &mut closures, &mut holders, exact, false, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), &mut constructDescs, &mut childConstructs) }
                    input.constructs = move childConstructs
                    // A body that reads its scope is inlined only under a scope on the heap
                    // (check.callee tests it where the body begins): one still in its frame
                    // now would leave there every time.
                    if !(readsScope(&input) && unsafe frameScopeAt(startScope, callee.known.envLevel)) {
                      run targets.append(CallTarget { pc: usize.toU32(pc), id: id, input: move input, atCall: true, chained: false, owned: 0, known: KnownShapes.none() })
                    }
                  }
                }
              }
            }
            _ => ()
          }
        }
      }
    }
    if opcode == op.OP_get_var && size == 3 {
      let varIdx = u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8)
      chainObj = Pointer.null<HeapHeader>()
      if let Option<*mut HeapHeader>.Some { value: reader } = Pointer.nonNullMut<HeapHeader>(owner) {
        chainObj = unsafe engineBaseline.variableObject(reader, varIdx)
      } else if function.known.refs.length() != 0 {
        chainObj = unsafe knownVariableObject(bytecode, varIdx)
      }
      chainEnd = pc + size
      chainPc = pc
      if trackVars {
        let pushed = match Pointer.nonNullMut<HeapHeader>(chainObj) {
          Option<*mut HeapHeader>.Some { value } => ValueBits.Object { reference: value }
          Option<*mut HeapHeader>.None => ValueBits.Undefined
        }
        if varDepth < 32 { varStack[varDepth] = pushed varDepth = varDepth + 1 } else { varDepth = 0 }
      }
    } else if (opcode == op.OP_get_scope0 || opcode == op.OP_get_scope0_check) && size == 3 {
      chainObj = Pointer.null<HeapHeader>()
      let mut pushed = ValueBits.Undefined
      if function.scopeSlots == 0 && !Pointer.isNull<HeapHeader>(startScope) {
        let slot = u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8)
        let val = unsafe scopeValue(startScope, 0, slot)
        match val {
          ValueBits.FunctionBytecode { .. } => { pushed = val }
          ValueBits.Object { reference } => {
            if callerHasLoop {
              pushed = val
              chainObj = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(reference)
            }
          }
          _ => ()
        }
      }
      chainEnd = pc + size
      chainPc = usize.MAX
      if trackVars {
        if varDepth < 32 { varStack[varDepth] = pushed varDepth = varDepth + 1 } else { varDepth = 0 }
      }
    } else if (opcode == op.OP_get_var_ref || opcode == op.OP_get_var_ref_check) && size == 3 {
      let raw = u8.toU16(bytes[pc + 1]) | u16.shiftLeft(u8.toU16(bytes[pc + 2]), 8)
      chainObj = Pointer.null<HeapHeader>()
      let mut pushed = ValueBits.Undefined
      if raw >= SCOPE_OPERAND && !Pointer.isNull<HeapHeader>(startScope) {
        let hop = u16.toU32(u16.shiftRight(raw, SCOPE_DEPTH_SHIFT) & 7)
        let ownOffset: u32 = if function.scopeSlots != 0 { 1 } else { 0 }
        if hop >= ownOffset {
          let slot = u16.toU32(raw & SCOPE_SLOT_MASK)
          let val = unsafe scopeValue(startScope, hop - ownOffset, slot)
          match val {
            ValueBits.FunctionBytecode { .. } => { pushed = val }
            ValueBits.Object { reference } => {
              if callerHasLoop {
                pushed = val
                chainObj = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(reference)
              }
            }
            _ => ()
          }
        }
      }
      chainEnd = pc + size
      chainPc = usize.MAX
      if trackVars {
        if varDepth < 32 { varStack[varDepth] = pushed varDepth = varDepth + 1 } else { varDepth = 0 }
      }
    } else {
      if opcode == op.OP_push_this && size == 1 {
        chainObj = receiver
        chainEnd = pc + size
        chainPc = usize.MAX
      } else if this != usize.MAX && readLocal(bytes, pc, pc + size) == this {
        chainObj = receiver
        chainEnd = pc + size
        chainPc = usize.MAX
      } else if opcode == op.OP_get_field && size >= 5 && chainEnd == pc {
        if let Option<*mut HeapHeader>.Some { value: from } = Pointer.nonNullMut<HeapHeader>(chainObj) {
          let atom = u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8) | u32.shiftLeft(u8.toU32(bytes[pc + 3]), 16) | u32.shiftLeft(u8.toU32(bytes[pc + 4]), 24)
          chainObj = unsafe ownObject(from, atom)
          chainEnd = pc + size
          chainPc = pc
        }
      }
      if trackVars {
        if isControlOrShuffle(opcode, opInfo.format) {
          varDepth = 0
        } else {
          let mut pops = u8.toUsize(opInfo.pops)
          let mut unknownPop = false
          if opcode == op.OP_call || opcode == op.OP_call_method || opcode == op.OP_call_constructor || opcode == op.OP_array_from {
            if size == 3 { pops = pops + (u8.toUsize(bytes[pc + 1]) | usize.shiftLeft(u8.toUsize(bytes[pc + 2]), 8)) }
            else { unknownPop = true }
          } else if opcode >= op.OP_call0 && opcode <= op.OP_call3 {
            pops = 1 + u8.toUsize(opcode - op.OP_call0)
          } else if opInfo.format == op.OP_FMT_npop || opInfo.format == op.OP_FMT_npopx || opInfo.format == op.OP_FMT_npop_u16 {
            unknownPop = true
          }
          if unknownPop || pops > varDepth {
            varDepth = 0
          } else {
            varDepth = varDepth - pops
            let pushes = u8.toUsize(opInfo.pushes)
            if varDepth + pushes > 32 {
              varDepth = 0
            } else {
              // A literal number is told from what is not known: a call that passes one
              // may have a longer callee (VAR_CALL_BYTES).
              let literal = literalPush(opcode)
              let mut p: usize = 0
              while p < pushes { varStack[varDepth] = if literal { ValueBits.Int { value: 0 } } else { ValueBits.Undefined } varDepth = varDepth + 1 p = p + 1 }
            }
          }
        }
      }
    }
    pc = pc + size
  }
  return move targets
}

/// The captured lexical scope of closure `owner`, or null.
unsafe fn ownerScope(owner: ?*mut HeapHeader) -> ?*mut HeapHeader {
  let obj = match Pointer.nonNullMut<HeapHeader>(owner) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, obj)
  return match &data.payload {
    ObjectPayload.BytecodeFunction { function: closure } => closure.scope
    _ => Pointer.null<HeapHeader>()
  }
}

/// The object held in global variable cell `index` of a known local function's `known.refs`,
/// or null.
unsafe fn knownVariableObject(bytecode: *mut HeapHeader, index: u32) -> ?*mut HeapHeader {
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  if u32.toUsize(index) >= code.known.refs.length() { return Pointer.null<HeapHeader>() }
  let cell = code.known.refs.get(u32.toUsize(index))
  drop code
  let found = match Pointer.nonNullMut<HeapHeader>(cell) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<HeapHeader>() }
  }
  let binding = unsafe HeapCell.payload<VarRef, ()>(&anchor, found)
  return match binding.state {
    VarRefState.Detached { value } => match value {
      ValueBits.Object { reference } => unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(reference)
      _ => Pointer.null<HeapHeader>()
    }
    _ => Pointer.null<HeapHeader>()
  }
}

/// The object or known-function value held in slot `slot` at `depth` hops up `startScope`,
/// or Undefined.
/// Whether the code compares one of the parameters in `literals` (a bit per position) with a
/// literal number for equality: `get_arg k` followed by the compare with its operand, or by
/// the literal's push and the compare.
fn decides(bytes: &[u8], literals: u32) -> bool {
  if literals == 0 { return false }
  let mut pc: usize = 0
  while pc < bytes.length {
    let opcode = bytes[pc]
    let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
    if size == 0 || pc + size > bytes.length { break }
    let mut parameter: u32 = u32.MAX
    if opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3 { parameter = u8.toU32(opcode - op.OP_get_arg0) }
    else if opcode == op.OP_get_arg && size == 3 { parameter = u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8) }
    let next = pc + size
    if parameter < 32 && u32.bitAnd(literals, u32.shiftLeft(1, parameter)) != 0 && next < bytes.length {
      let test = bytes[next]
      if test == op.OP_strict_eq_imm8 || test == op.OP_strict_neq_imm8 { return true }
      if literalPush(test) {
        let after = next + u8.toUsize(op.opcodeInfo(test, true).size)
        if after < bytes.length && (bytes[after] == op.OP_strict_eq || bytes[after] == op.OP_strict_neq || bytes[after] == op.OP_eq || bytes[after] == op.OP_neq) { return true }
      }
    }
    pc = next
  }
  return false
}
/// Whether `opcode` pushes a literal integer.
fn literalPush(opcode: u8) -> bool {
  return opcode == op.OP_push_i32 || opcode == op.OP_push_0 || opcode == op.OP_push_1 || opcode == op.OP_push_i8 || opcode == op.OP_push_i16
}

/// Whether the scope of `level` on the chain from `startScope` (js_scopes.atLevel) is still
/// in its frame (js_scopes.inFrame: no count), not on the heap.
unsafe fn frameScopeAt(startScope: ?*mut HeapHeader, level: u32) -> bool {
  let anchor = ()
  let mut scopeOpt = startScope
  while true {
    let scope = match Pointer.nonNullMut<HeapHeader>(scopeOpt) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return false }
    }
    let data = unsafe HeapCell.payload<ScopeData, ()>(&anchor, scope)
    if data.level == level { return (unsafe Pointer.borrow<(), HeapHeader>(&anchor, scope)).referenceCount == 0 }
    scopeOpt = data.parent
  }
  return false
}
unsafe fn scopeValue(startScope: ?*mut HeapHeader, depth: u32, slot: u32) -> ValueBits {
  let anchor = ()
  let mut scopeOpt = startScope
  let mut hop: u32 = 0
  while hop < depth {
    let cur = match Pointer.nonNullMut<HeapHeader>(scopeOpt) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return ValueBits.Undefined }
    }
    scopeOpt = (unsafe HeapCell.payload<ScopeData, ()>(&anchor, cur)).parent
    hop = hop + 1
  }
  let scope = match Pointer.nonNullMut<HeapHeader>(scopeOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return ValueBits.Undefined }
  }
  let count = (unsafe HeapCell.payload<ScopeData, ()>(&anchor, scope)).count
  if slot >= count { return ValueBits.Undefined }
  return match unsafe Pointer.read<ValueBits>(unsafe scopeSlot(scope, u32.toUsize(slot))) {
    ValueBits.Object { reference } => ValueBits.Object { reference: reference }
    ValueBits.FunctionBytecode { reference } => ValueBits.FunctionBytecode { reference: reference }
    _ => ValueBits.Undefined
  }
}

fn isControlOrShuffle(opcode: u8, format: u8) -> bool {
  if format == op.OP_FMT_label8 || format == op.OP_FMT_label16 || format == op.OP_FMT_label
    || format == op.OP_FMT_atom_label_u8 || format == op.OP_FMT_atom_label_u16 || format == op.OP_FMT_label_u16 { return true }
  if opcode >= op.OP_nip && opcode <= op.OP_rot5l { return true }
  return opcode == op.OP_return || opcode == op.OP_return_undef || opcode == op.OP_return_async
    || opcode == op.OP_throw || opcode == op.OP_throw_error || opcode == op.OP_ret || opcode == op.OP_nip_catch
    || opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8
    || opcode == op.OP_if_true_keep8 || opcode == op.OP_if_false_keep8 || opcode == op.OP_if_not_nullish_keep8
    || opcode == op.OP_tail_call || opcode == op.OP_tail_call_method
}

effect fn markJumpTargets(bytes: &[u8]) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut targets = List<bool>.make()
  run targets.appendRepeated(false, bytes.length)
  let mut pc: usize = 0
  while pc < bytes.length {
    let opcode = bytes[pc]
    let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
    if size == 0 || pc + size > bytes.length { break }
    let mut target: i64 = -1
    if (opcode == op.OP_if_false8 || opcode == op.OP_if_true8 || opcode == op.OP_goto8) && size == 2 {
      let raw = usize.toI64(u8.toUsize(bytes[pc + 1]))
      let disp = if raw >= 128 { raw - 256 } else { raw }
      target = usize.toI64(pc + 1) + disp
    } else if opcode == op.OP_goto16 && size == 3 {
      let raw = u32.toI64(u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8))
      let disp = if raw >= 32768 { raw - 65536 } else { raw }
      target = usize.toI64(pc + 1) + disp
    } else if (opcode == op.OP_if_false || opcode == op.OP_if_true || opcode == op.OP_goto || opcode == op.OP_catch || opcode == op.OP_gosub) && size == 5 {
      let raw = u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8) | u32.shiftLeft(u8.toU32(bytes[pc + 3]), 16) | u32.shiftLeft(u8.toU32(bytes[pc + 4]), 24)
      target = usize.toI64(pc + 1) + i32.toI64(u32.wrappingToI32(raw))
    } else if (opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8) && size == 3 {
      let raw = usize.toI64(u8.toUsize(bytes[pc + 2]))
      let disp = if raw >= 128 { raw - 256 } else { raw }
      target = usize.toI64(pc + 2) + disp
    } else if (opcode == op.OP_if_true_keep8 || opcode == op.OP_if_false_keep8) && size == 4 {
      let raw = usize.toI64(u8.toUsize(bytes[pc + 2]))
      let disp = if raw >= 128 { raw - 256 } else { raw }
      target = usize.toI64(pc + 2) + disp
    } else if opcode == op.OP_if_not_nullish_keep8 && size == 5 {
      let raw = usize.toI64(u8.toUsize(bytes[pc + 3]))
      let disp = if raw >= 128 { raw - 256 } else { raw }
      target = usize.toI64(pc + 3) + disp
    }
    if target >= 0 && i64.toUsize(target) < bytes.length { targets.set(i64.toUsize(target), true) }
    pc = pc + size
  }
  return move targets
}

fn hasBackEdge(bytes: &[u8]) -> bool {
  let mut pc: usize = 0
  while pc < bytes.length {
    let opcode = bytes[pc]
    let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
    if size == 0 || pc + size > bytes.length { break }
    let mut target: i64 = -1
    if (opcode == op.OP_if_false8 || opcode == op.OP_if_true8 || opcode == op.OP_goto8) && size == 2 {
      let raw = usize.toI64(u8.toUsize(bytes[pc + 1]))
      let disp = if raw >= 128 { raw - 256 } else { raw }
      target = usize.toI64(pc + 1) + disp
    } else if opcode == op.OP_goto16 && size == 3 {
      let raw = u32.toI64(u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8))
      let disp = if raw >= 32768 { raw - 65536 } else { raw }
      target = usize.toI64(pc + 1) + disp
    } else if (opcode == op.OP_if_false || opcode == op.OP_if_true || opcode == op.OP_goto || opcode == op.OP_catch || opcode == op.OP_gosub) && size == 5 {
      let raw = u8.toU32(bytes[pc + 1]) | u32.shiftLeft(u8.toU32(bytes[pc + 2]), 8) | u32.shiftLeft(u8.toU32(bytes[pc + 3]), 16) | u32.shiftLeft(u8.toU32(bytes[pc + 4]), 24)
      target = usize.toI64(pc + 1) + i32.toI64(u32.wrappingToI32(raw))
    } else if (opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8) && size == 3 {
      let raw = usize.toI64(u8.toUsize(bytes[pc + 2]))
      let disp = if raw >= 128 { raw - 256 } else { raw }
      target = usize.toI64(pc + 2) + disp
    } else if (opcode == op.OP_if_true_keep8 || opcode == op.OP_if_false_keep8) && size == 4 {
      let raw = usize.toI64(u8.toUsize(bytes[pc + 2]))
      let disp = if raw >= 128 { raw - 256 } else { raw }
      target = usize.toI64(pc + 2) + disp
    } else if opcode == op.OP_if_not_nullish_keep8 && size == 5 {
      let raw = usize.toI64(u8.toUsize(bytes[pc + 3]))
      let disp = if raw >= 128 { raw - 256 } else { raw }
      target = usize.toI64(pc + 3) + disp
    }
    if target >= 0 && target <= usize.toI64(pc) { return true }
    pc = pc + size
  }
  return false
}

fn tierUpWait(optimizeEntries: u32, bytes: &[u8]) -> u32 {
  if optimizeEntries != OPTIMIZE_ENTRIES { return optimizeEntries }
  let looped = hasBackEdge(bytes)
  if looped && bytes.length <= 650 { return 250 }
  let mut callCount: u32 = 0
  let mut hasForInOrOf = false
  let mut pc: usize = 0
  while pc < bytes.length {
    let opcode = bytes[pc]
    let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
    if size == 0 || pc + size > bytes.length { break }
    if opcode == op.OP_call || (opcode >= op.OP_call0 && opcode <= op.OP_call3)
      || opcode == op.OP_call_method || opcode == op.OP_call_constructor {
      callCount = callCount + 1
    } else if opcode == op.OP_for_in_start || opcode == op.OP_for_of_start {
      hasForInOrOf = true
    }
    pc = pc + size
  }
  if looped {
    // Oversized loop functions with for-in/for-of or heavy call density expand into huge
    // optimized bodies without loop payoff; keep them parked in compact baseline.
    if hasForInOrOf || callCount >= 10 { return PARKED }
    return 250
  }
  // Large or call-heavy loop-free glue expands in the optimizer without loop payoff;
  // park it in compact baseline so it does not tier up mid-measurement or split hot code
  // across lanes.
  if bytes.length > 140 || callCount >= 3 || (bytes.length > 72 && callCount >= 2) { return PARKED }
  return 250
}

const CTOR_FORM_STORES: u8 = 1
const CTOR_FORM_FORWARD: u8 = 2
const CTOR_FORM_EVAL: u8 = 3
const CTOR_STORE_SIZE: usize = 15
const CTOR_APPLY_METHOD: u32 = 3

/// The own data-property slot index of `atom` on non-exotic `object`, or usize.MAX.
unsafe fn ownDataSlot(object: *mut HeapHeader, atom: u32) -> usize {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  if data.isExotic() { return usize.MAX }
  return match unsafe shapes.lookup(data.shape, atom) {
    Option<usize>.Some { value: slot } => {
      if slot < data.slotCount() && (u8.toU32(unsafe shapes.slotFlags(data.shape, slot)) & JS_PROP_TMASK) == 0 { slot }
      else { usize.MAX }
    }
    Option<usize>.None => usize.MAX
  }
}

unsafe fn isApplyBuiltin(object: *mut HeapHeader) -> bool {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  if data.classId() != classes.JS_CLASS_C_FUNCTION { return false }
  return match &data.payload {
    ObjectPayload.NativeFunction { function: native } => if native.magicBits != 0 { false } else { match native.function {
      NativeFunctionId.Builtin { family, method } => family == BuiltinFamily.Function && method == CTOR_APPLY_METHOD
      _ => false
    } }
    _ => false
  }
}

unsafe fn recipeCacheWay(state: &RuntimeState, code: usize) -> usize {
  let first = u64.toUsize(u64.shiftRight(u64.wrappingMultiply(usize.toU64(code / 16), 0x9e3779b97f4a7c15), 58)) & 62
  let second = first + 1
  if state.constructCache[first].code == code { return first }
  if state.constructCache[second].code == code { return second }
  return first
}

fn constValTruthy(v: ValueBits) -> i32 {
  return match v {
    ValueBits.Undefined => 0
    ValueBits.Null => 0
    ValueBits.Bool { value } => if value { 1 } else { 0 }
    ValueBits.Int { value } => if value != 0 { 1 } else { 0 }
    ValueBits.Float64 { value } => if value != 0.0 && value == value { 1 } else { 0 }
    _ => -1
  }
}

fn evalConstConstructTarget(t: ConstructTarget, argVals: &[ValueBits; 4], argCount: usize, outVals: &mut [ValueBits; 8], outCount: &mut u8) -> bool {
  let stores = u8.toUsize(t.stores)
  if stores == 0 || stores > 8 { return false }
  if t.kind == CONSTRUCT_PLAN_STORES {
    let mut s: usize = 0
    while s < stores {
      let src = u8.toUsize(t.sources[s])
      let v = if src < argCount { argVals[src] } else { ValueBits.Undefined }
      if v.tag() < 0 { return false }
      outVals[s] = v
      s = s + 1
    }
    outCount.* = t.stores
    return true
  }
  if t.kind != CONSTRUCT_PLAN_RECIPE { return false }
  let nodeCount = u8.toUsize(t.nodeCount)
  if nodeCount < 2 || nodeCount > 32 { return false }
  let mut nodeVals: [ValueBits; 32] = [ValueBits.Undefined; 32]
  let mut i: usize = 2
  while i < nodeCount {
    let word = t.nodes[i]
    let kind = word & 255
    let a = u32.toUsize(u32.shiftRight(word, 8) & 255) & 31
    if kind == RECIPE_RECEIVER { return false }
    if kind == RECIPE_ARG {
      nodeVals[i] = if a < argCount { argVals[a] } else { ValueBits.Undefined }
    } else if kind == RECIPE_CONST {
      let ci = a & 15
      let ck = t.constKinds[ci]
      let cb = t.constBits[ci]
      if ck == RCONST_UNDEF { nodeVals[i] = ValueBits.Undefined }
      else if ck == RCONST_NULL { nodeVals[i] = ValueBits.Null }
      else if ck == RCONST_FALSE { nodeVals[i] = ValueBits.Bool { value: false } }
      else if ck == RCONST_TRUE { nodeVals[i] = ValueBits.Bool { value: true } }
      else if ck == RCONST_INT { nodeVals[i] = ValueBits.Int { value: u32.wrappingToI32(u64.wrappingToU32(cb)) } }
      else { nodeVals[i] = ValueBits.Float64 { value: f64.fromBits(cb) } }
    } else if kind == RECIPE_NOT {
      if a == 0 { return false }
      let tr = constValTruthy(nodeVals[a])
      if tr < 0 { return false }
      nodeVals[i] = ValueBits.Bool { value: tr == 0 }
    } else if kind >= RECIPE_SELECT {
      let b = u32.toUsize(u32.shiftRight(word, 16) & 255) & 31
      let c = u32.toUsize(u32.shiftRight(word, 24)) & 31
      if a == 0 || b == 0 || c == 0 { return false }
      let tr = constValTruthy(nodeVals[a])
      if tr < 0 { return false }
      nodeVals[i] = if tr != 0 { nodeVals[b] } else { nodeVals[c] }
    } else {
      return false
    }
    i = i + 1
  }
  let mut s: usize = 0
  while s < stores {
    let r = u8.toUsize(t.roots[s]) & 31
    if r == 0 || r >= nodeCount { return false }
    let v = nodeVals[r]
    if v.tag() < 0 { return false }
    outVals[s] = v
    s = s + 1
  }
  outCount.* = t.stores
  return true
}

/// Inspects a constructor object found by a `get_var`/`get_field` chain right before `OP_dup`
/// and, when it has a valid planned shape and store/recipe/nested plan, appends a
/// `ConstructDesc` and `ConstructTarget` for `readPc`.
unsafe effect fn buildConstruct(rt: *mut HeapHeader, ctor: *mut HeapHeader, readPc: u32, descs: &mut List<ConstructDesc>, targets: &mut List<ConstructTarget>, nestDepth: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let anchor = ()
  let ctorData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, ctor)
  if ctorData.classId() != classes.JS_CLASS_BYTECODE_FUNCTION || ctorData.isExotic() || !ctorData.isConstructor() { return () }
  let bytecode = match &ctorData.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { return () } }
  let ctorVersion = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, ctorData.shape)).version
  let ctorSlots = ctorData.slotCount()
  drop ctorData
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let form = code.constructForm
  let derived = code.isDerivedClassConstructor
  let realm = code.realm
  drop code
  if derived || (form == 0 && nestDepth >= 2) { return () }
  let ctorAddr = Pointer.address<HeapHeader>(ctor)
  let state = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
  let set = u64.toUsize(u64.shiftRight(u64.wrappingMultiply(usize.toU64(ctorAddr / 16), 0x9e3779b97f4a7c15), 60))
  let first = set * 4
  let mut recvSlot = usize.MAX
  let mut way: usize = 0
  while way < 4 {
    if state.receiverFunctions[first + way] == ctorAddr { recvSlot = first + way break }
    way = way + 1
  }
  if recvSlot == usize.MAX { drop state return () }
  let entry = state.receiverCache[recvSlot]
  let epoch = state.shapeEpoch
  drop state
  if entry.version != ctorVersion { return () }
  let empty = match Pointer.nonNullMut<HeapHeader>(entry.empty) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return () }
  }
  let protoSlot = entry.index
  if protoSlot >= ctorSlots { return () }
  let emptyProto = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, empty)).prototype
  let proto = match Pointer.nonNullMut<HeapHeader>(emptyProto) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return () }
  }
  let ctorData2 = unsafe HeapCell.payload<ObjectData, ()>(&anchor, ctor)
  let protoMatches = match (unsafe ctorData2.slotUnchecked(protoSlot)).valueBits() {
    ValueBits.Object { reference } => Pointer.address<HeapHeader>(reference) == Pointer.address<HeapHeader>(proto)
    _ => false
  }
  drop ctorData2
  if !protoMatches { return () }
  let forward = form == CTOR_FORM_FORWARD
  let mut targetOpt = Pointer.null<HeapHeader>()
  let mut fnProtoOpt = Pointer.null<HeapHeader>()
  let mut applyOpt = Pointer.null<HeapHeader>()
  let mut holderSlot: usize = 0
  let mut applySlot: usize = 0
  let mut targetVersion: u64 = 0
  let mut fnProtoVersion: u64 = 0
  let mut targetBytecode = bytecode
  let mut targetForm = form
  let mut fnObj = ctor
  if forward {
    let fwdAtom = unsafe constructors.forwardedAtom(ValueBits.Object { reference: ctor })
    if fwdAtom == 0 { return () }
    holderSlot = unsafe ownDataSlot(proto, fwdAtom)
    if holderSlot == usize.MAX { return () }
    let protoData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, proto)
    let targetObj = match (unsafe protoData.slotUnchecked(holderSlot)).valueBits() {
      ValueBits.Object { reference } => reference
      _ => { drop protoData return () }
    }
    drop protoData
    let targetData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, targetObj)
    if targetData.classId() != classes.JS_CLASS_BYTECODE_FUNCTION || targetData.isExotic() { drop targetData return () }
    targetBytecode = match &targetData.payload { ObjectPayload.BytecodeFunction { function: closure } => closure.bytecode _ => { drop targetData return () } }
    if let Option<usize>.Some { .. } = unsafe shapes.lookup(targetData.shape, atomData.JS_ATOM_apply) { drop targetData return () }
    let tShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, targetData.shape)
    targetVersion = tShape.version
    let fnProtoVal = tShape.prototype
    drop tShape drop targetData
    let fnProto = match Pointer.nonNullMut<HeapHeader>(fnProtoVal) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return () }
    }
    let fnProtoData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, fnProto)
    if fnProtoData.isExotic() || !fnProtoData.isPrototype() { drop fnProtoData return () }
    fnProtoVersion = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, fnProtoData.shape)).version
    drop fnProtoData
    applySlot = unsafe ownDataSlot(fnProto, atomData.JS_ATOM_apply)
    if applySlot == usize.MAX { return () }
    let fnProtoData2 = unsafe HeapCell.payload<ObjectData, ()>(&anchor, fnProto)
    let applyObj = match (unsafe fnProtoData2.slotUnchecked(applySlot)).valueBits() {
      ValueBits.Object { reference } => reference
      _ => { drop fnProtoData2 return () }
    }
    drop fnProtoData2
    if !unsafe isApplyBuiltin(applyObj) { return () }
    let tCode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, targetBytecode)
    if tCode.isDerivedClassConstructor { drop tCode return () }
    targetForm = tCode.constructForm
    drop tCode
    targetOpt = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(targetObj)
    fnProtoOpt = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(fnProto)
    applyOpt = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(applyObj)
    fnObj = targetObj
  }
  let mut finalOpt = Pointer.null<HeapHeader>()
  let mut stores: usize = 0
  let mut planKind: u8 = 0
  let mut fromEmpty: u8 = 0
  let mut checkInterrupt: u8 = 1
  let mut nodeCount: u8 = 0
  let mut sources: [u8; 8] = [0; 8]
  let mut roots: [u8; 8] = [0; 8]
  let mut nodes: [u32; 32] = [0; 32]
  let mut constKinds: [u8; 16] = [0; 16]
  let mut constBits: [u64; 16] = [0; 16]
  let mut addAtoms: [u32; 8] = [0; 8]
  let mut storedAtoms: [u32; 8] = [0; 8]
  let mut guardVarCell = Pointer.null<HeapHeader>()
  let mut guardVarExpect = Pointer.null<HeapHeader>()
  let mut guardHopObjs: [?*mut HeapHeader; 2] = [Pointer.null<HeapHeader>(); 2]
  let mut guardHopExpect: [?*mut HeapHeader; 2] = [Pointer.null<HeapHeader>(); 2]
  let mut guardHopVersions: [u64; 2] = [0; 2]
  let mut guardHopSlots: [usize; 2] = [0; 2]
  let mut guardHopCount: u8 = 0
  let mut nestedKind: u8 = helpers.NESTED_NONE
  let mut nestedInitCount: u8 = 0
  let mut nestedDescIdx: u32 = 0
  let mut nestedArrayShape = Pointer.null<HeapHeader>()
  let mut nestedInitVals: [ValueBits; 8] = [ValueBits.Undefined; 8]
  if !forward && targetForm == CTOR_FORM_STORES {
    stores = u8.toUsize(entry.stores)
    if stores == 0 || stores > 8 || entry.bytecode != Pointer.address<HeapHeader>(targetBytecode) { return () }
    let final = match Pointer.nonNullMut<HeapHeader>(entry.final) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return () }
    }
    let fShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, final)
    if fShape.properties.length() != stores { drop fShape return () }
    let mut i: usize = 0
    while i < stores {
      storedAtoms[i] = fShape.properties.get(i).atom
      sources[i] = entry.sources[i] & 0x3F
      i = i + 1
    }
    drop fShape
    finalOpt = entry.final
    planKind = CONSTRUCT_PLAN_STORES
    fromEmpty = 0
    checkInterrupt = 0
  } else if forward && targetForm == CTOR_FORM_STORES {
    let tCode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, targetBytecode)
    let codeBytes = unsafe tCode.code.asSlice()
    let len = codeBytes.length
    if len < 3 + CTOR_STORE_SIZE || len > 3 + CTOR_STORE_SIZE * 8 || (len - 3) % CTOR_STORE_SIZE != 0 { drop tCode return () }
    if codeBytes[0] != op.OP_push_this || codeBytes[1] != op.OP_put_loc0 || codeBytes[len - 1] != op.OP_return_undef { drop tCode return () }
    stores = (len - 3) / CTOR_STORE_SIZE
    let mut cur = empty
    let mut i: usize = 0
    while i < stores {
      let at = 2 + i * CTOR_STORE_SIZE
      let argOp = codeBytes[at + 1]
      if codeBytes[at] != op.OP_get_loc0 || argOp < op.OP_get_arg0 || argOp > op.OP_get_arg3 || codeBytes[at + 2] != op.OP_put_field { drop tCode return () }
      let atom = u8.toU32(codeBytes[at + 3]) | u32.shiftLeft(u8.toU32(codeBytes[at + 4]), 8)
        | u32.shiftLeft(u8.toU32(codeBytes[at + 5]), 16) | u32.shiftLeft(u8.toU32(codeBytes[at + 6]), 24)
      let next = match Pointer.nonNullMut<HeapHeader>(unsafe shapes.verifiedAdd(rt, cur, atom)) {
        Option<*mut HeapHeader>.Some { value } => value
        Option<*mut HeapHeader>.None => { drop tCode return () }
      }
      if (unsafe Pointer.borrow<(), HeapHeader>(&anchor, next)).referenceCount <= 0 { drop tCode return () }
      addAtoms[i] = atom
      storedAtoms[i] = atom
      sources[i] = argOp - op.OP_get_arg0
      cur = next
      i = i + 1
    }
    drop tCode
    finalOpt = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(cur)
    planKind = CONSTRUCT_PLAN_STORES
    fromEmpty = 1
    checkInterrupt = 1
  } else if targetForm == CTOR_FORM_EVAL {
    stores = u8.toUsize(entry.stores)
    if stores == 0 || stores > 8 || entry.bytecode != Pointer.address<HeapHeader>(targetBytecode) { return () }
    let final = match Pointer.nonNullMut<HeapHeader>(entry.final) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return () }
    }
    let tCode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, targetBytecode)
    if tCode.code.length() == 0 { drop tCode return () }
    let codeAddr = Pointer.address<u8>(unsafe tCode.code.pointerAt(0))
    drop tCode
    let st = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, rt)
    let rEntry = &st.constructCache[unsafe recipeCacheWay(&st.*, codeAddr)]
    if rEntry.code != codeAddr || u8.toUsize(rEntry.recipe.stores) != stores || rEntry.base != Pointer.address<HeapHeader>(empty)
      || rEntry.recipe.fieldsReference != 255 || rEntry.recipe.nodeCount < 2 || rEntry.recipe.nodeCount > 32 {
      drop rEntry drop st return ()
    }
    let rFinal = match Pointer.nonNullMut<HeapHeader>(rEntry.final) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { drop rEntry drop st return () }
    }
    if Pointer.address<HeapHeader>(rFinal) != Pointer.address<HeapHeader>(final) { drop rEntry drop st return () }
    nodeCount = rEntry.recipe.nodeCount
    nodes = rEntry.recipe.nodes
    let mut i: usize = 0
    while i < stores {
      roots[i] = rEntry.recipe.roots[i]
      storedAtoms[i] = rEntry.recipe.atoms[i]
      i = i + 1
    }
    i = 2
    while i < u8.toUsize(nodeCount) {
      let word = nodes[i]
      if (word & 255) == RECIPE_CONST {
        let ci = u32.toUsize(u32.shiftRight(word, 8) & 255) & 15
        match rEntry.recipe.constants[ci] {
          ValueBits.Undefined => { constKinds[ci] = RCONST_UNDEF constBits[ci] = 0 }
          ValueBits.Null => { constKinds[ci] = RCONST_NULL constBits[ci] = 0 }
          ValueBits.Bool { value: b } => { constKinds[ci] = if b { RCONST_TRUE } else { RCONST_FALSE } constBits[ci] = 0 }
          ValueBits.Int { value: n } => { constKinds[ci] = RCONST_INT constBits[ci] = u32.toU64(i32.wrappingToU32(n)) }
          ValueBits.Float64 { value: x } => { constKinds[ci] = RCONST_F64 constBits[ci] = f64.toBits(x) }
          _ => { drop rEntry drop st return () }
        }
      }
      i = i + 1
    }
    drop rEntry drop st
    finalOpt = entry.final
    planKind = CONSTRUCT_PLAN_RECIPE
    fromEmpty = 0
    checkInterrupt = 1
  } else if targetForm == 0 && nestDepth < 2 {
    // Match 1-field nested construct: `this.<field> = new <var>[.<f1>[.<f2>]](<constArgs...>)`.
    let tCode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, targetBytecode)
    let codeBytes = unsafe tCode.code.asSlice()
    let len = codeBytes.length
    if len < 12 || codeBytes[0] != op.OP_push_this || codeBytes[1] != op.OP_put_loc0 || codeBytes[2] != op.OP_get_loc0 || codeBytes[3] != op.OP_get_var {
      drop tCode return ()
    }
    let varIdx = u8.toUsize(codeBytes[4]) | usize.shiftLeft(u8.toUsize(codeBytes[5]), 8)
    let fnData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, fnObj)
    let varCellOpt = match &fnData.payload {
      ObjectPayload.BytecodeFunction { function: closure } => if varIdx < closure.varRefs.length() { closure.varRefs.asSlice()[varIdx] } else { Pointer.null<HeapHeader>() }
      _ => Pointer.null<HeapHeader>()
    }
    drop fnData
    let varCell = match Pointer.nonNullMut<HeapHeader>(varCellOpt) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { drop tCode return () }
    }
    let varRef = unsafe HeapCell.payload<VarRef, ()>(&anchor, varCell)
    let varObjOpt = match varRef.state {
      VarRefState.Detached { value } => match value {
        ValueBits.Object { reference } => unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(reference)
        _ => Pointer.null<HeapHeader>()
      }
      _ => Pointer.null<HeapHeader>()
    }
    drop varRef
    let mut curObj = match Pointer.nonNullMut<HeapHeader>(varObjOpt) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { drop tCode return () }
    }
    guardVarCell = varCellOpt
    guardVarExpect = varObjOpt
    let gfSize = u8.toUsize(op.opcodeInfo(op.OP_get_field, true).size)
    let pfSize = u8.toUsize(op.opcodeInfo(op.OP_put_field, true).size)
    if gfSize < 5 || pfSize < 5 { drop tCode return () }
    let mut pc: usize = 6
    while pc + gfSize <= len && codeBytes[pc] == op.OP_get_field && guardHopCount < 2 {
      let atom = u8.toU32(codeBytes[pc + 1]) | u32.shiftLeft(u8.toU32(codeBytes[pc + 2]), 8)
        | u32.shiftLeft(u8.toU32(codeBytes[pc + 3]), 16) | u32.shiftLeft(u8.toU32(codeBytes[pc + 4]), 24)
      let slot = unsafe ownDataSlot(curObj, atom)
      if slot == usize.MAX { drop tCode return () }
      let curData = unsafe HeapCell.payload<ObjectData, ()>(&anchor, curObj)
      let ver = (unsafe HeapCell.payload<ShapeData, ()>(&anchor, curData.shape)).version
      let nextOpt = match (unsafe curData.slotUnchecked(slot)).valueBits() {
        ValueBits.Object { reference } => unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(reference)
        _ => Pointer.null<HeapHeader>()
      }
      drop curData
      let nextObj = match Pointer.nonNullMut<HeapHeader>(nextOpt) {
        Option<*mut HeapHeader>.Some { value } => value
        Option<*mut HeapHeader>.None => { drop tCode return () }
      }
      let hi = u8.toUsize(guardHopCount)
      guardHopObjs[hi] = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(curObj)
      guardHopExpect[hi] = nextOpt
      guardHopVersions[hi] = ver
      guardHopSlots[hi] = slot
      guardHopCount = guardHopCount + 1
      curObj = nextObj
      pc = pc + gfSize
    }
    if pc >= len || codeBytes[pc] != op.OP_dup { drop tCode return () }
    pc = pc + 1
    let mut argVals: [ValueBits; 4] = [ValueBits.Undefined; 4]
    let mut argCount: usize = 0
    while pc < len && argCount < 4 {
      let opb = codeBytes[pc]
      if opb == op.OP_undefined { argVals[argCount] = ValueBits.Undefined argCount = argCount + 1 pc = pc + 1 }
      else if opb == op.OP_null { argVals[argCount] = ValueBits.Null argCount = argCount + 1 pc = pc + 1 }
      else if opb == op.OP_push_false { argVals[argCount] = ValueBits.Bool { value: false } argCount = argCount + 1 pc = pc + 1 }
      else if opb == op.OP_push_true { argVals[argCount] = ValueBits.Bool { value: true } argCount = argCount + 1 pc = pc + 1 }
      else if opb >= op.OP_push_0 && opb <= op.OP_push_1 { argVals[argCount] = ValueBits.Int { value: u8.toI32(opb - op.OP_push_0) } argCount = argCount + 1 pc = pc + 1 }
      else if opb == op.OP_push_i8 && pc + 2 <= len {
        let raw = u8.toI32(codeBytes[pc + 1])
        argVals[argCount] = ValueBits.Int { value: if raw >= 128 { raw - 256 } else { raw } }
        argCount = argCount + 1 pc = pc + 2
      } else if opb == op.OP_push_i16 && pc + 3 <= len {
        let raw = u8.toI32(codeBytes[pc + 1]) | i32.shiftLeft(u8.toI32(codeBytes[pc + 2]), 8)
        argVals[argCount] = ValueBits.Int { value: if raw >= 32768 { raw - 65536 } else { raw } }
        argCount = argCount + 1 pc = pc + 3
      } else if opb == op.OP_push_i32 && pc + 5 <= len {
        let raw = u8.toU32(codeBytes[pc + 1]) | u32.shiftLeft(u8.toU32(codeBytes[pc + 2]), 8)
          | u32.shiftLeft(u8.toU32(codeBytes[pc + 3]), 16) | u32.shiftLeft(u8.toU32(codeBytes[pc + 4]), 24)
        argVals[argCount] = ValueBits.Int { value: u32.wrappingToI32(raw) }
        argCount = argCount + 1 pc = pc + 5
      } else { break }
    }
    if pc + 3 > len || codeBytes[pc] != op.OP_call_constructor { drop tCode return () }
    let argc = u8.toUsize(codeBytes[pc + 1]) | usize.shiftLeft(u8.toUsize(codeBytes[pc + 2]), 8)
    if argc != argCount { drop tCode return () }
    pc = pc + 3
    if pc + pfSize + 1 != len || codeBytes[pc] != op.OP_put_field || codeBytes[pc + pfSize] != op.OP_return_undef {
      drop tCode return ()
    }
    let fieldAtom = u8.toU32(codeBytes[pc + 1]) | u32.shiftLeft(u8.toU32(codeBytes[pc + 2]), 8)
      | u32.shiftLeft(u8.toU32(codeBytes[pc + 3]), 16) | u32.shiftLeft(u8.toU32(codeBytes[pc + 4]), 24)
    drop tCode
    let nextShape = match Pointer.nonNullMut<HeapHeader>(unsafe shapes.verifiedAdd(rt, empty, fieldAtom)) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return () }
    }
    if (unsafe Pointer.borrow<(), HeapHeader>(&anchor, nextShape)).referenceCount <= 0 { return () }
    // Resolve inner planned plain constructor (e.g. IntersectionInfo -> Color(0, 0, 0)), or
    // the realm's `new Array()` (OrderedCollection -> Array), made in a spare or pooled cell
    // (jit_helpers.emptyArrayCell).
    let arrayShape = unsafe helpers.realmArrayShape(curObj)
    if argCount == 0 && !Pointer.isNull<HeapHeader>(arrayShape) {
      nestedKind = helpers.NESTED_EMPTY_ARRAY
      nestedArrayShape = arrayShape
    } else if Pointer.address<HeapHeader>(curObj) != Pointer.address<HeapHeader>(ctor) {
      let mut innerTargets = List<ConstructTarget>.make()
      run unsafe buildConstruct(rt, curObj, u32.MAX, &mut descs, &mut innerTargets, nestDepth + 1)
      if innerTargets.length() == 1 {
        let it = innerTargets.get(0)
        if it.kind == CONSTRUCT_PLAN_PREINIT && argCount == 0 {
          nestedKind = helpers.NESTED_PLAIN
          nestedDescIdx = it.id
          nestedInitCount = 0
        } else if (it.kind == CONSTRUCT_PLAN_STORES || it.kind == CONSTRUCT_PLAN_RECIPE)
          && evalConstConstructTarget(it, &argVals, argCount, &mut nestedInitVals, &mut nestedInitCount) {
          nestedKind = helpers.NESTED_PLAIN
          nestedDescIdx = it.id
        }
      }
    }
    if nestedKind == helpers.NESTED_NONE { return () }
    stores = 1
    addAtoms[0] = fieldAtom
    storedAtoms[0] = fieldAtom
    finalOpt = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(nextShape)
    planKind = CONSTRUCT_PLAN_PREINIT
    fromEmpty = 1
    checkInterrupt = 1
  } else {
    return ()
  }
  let final = match Pointer.nonNullMut<HeapHeader>(finalOpt) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return () }
  }
  let fShape = unsafe HeapCell.payload<ShapeData, ()>(&anchor, final)
  if fShape.properties.length() != stores || fShape.version >= 2147483648 { drop fShape return () }
  let shapeVersion = u64.wrappingToU32(fShape.version)
  drop fShape
  let mut tail = unsafe shapes.planInline(empty, stores)
  if fromEmpty != 0 || (tail != 0 && tail < stores) { tail = shapes.INLINE_SLOTS }
  if (tail != shapes.INLINE_SLOTS && tail != shapes.PAIR_SLOTS) || stores > tail { return () }
  // Live-verify prototype chain: non-exotic, isPrototype(), and no inherited property for
  // any stored atom (so adding all `stores` fields invokes no setters or read-only slots).
  let mut protoObjs: [?*mut HeapHeader; 4] = [Pointer.null<HeapHeader>(); 4]
  let mut protoVersions: [u64; 4] = [0; 4]
  let mut protoCount: usize = 0
  let mut curOpt = unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(proto)
  while true {
    let link = match Pointer.nonNullMut<HeapHeader>(curOpt) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { break }
    }
    if protoCount >= 4 { return () }
    let ld = unsafe HeapCell.payload<ObjectData, ()>(&anchor, link)
    if ld.isExotic() || !ld.isPrototype() { drop ld return () }
    let lShape = ld.shape
    drop ld
    let mut j: usize = 0
    while j < stores {
      if let Option<usize>.Some { value: slot } = unsafe shapes.lookup(lShape, storedAtoms[j]) {
        let flags = u8.toU32(unsafe shapes.slotFlags(lShape, slot))
        if (flags & JS_PROP_TMASK) != 0 || (flags & JS_PROP_WRITABLE) == 0 { return () }
      }
      j = j + 1
    }
    let ls = unsafe HeapCell.payload<ShapeData, ()>(&anchor, lShape)
    protoObjs[protoCount] = curOpt
    protoVersions[protoCount] = ls.version
    curOpt = ls.prototype
    drop ls
    protoCount = protoCount + 1
  }
  let id = usize.toU32(descs.length())
  run descs.append(ConstructDesc {
    ctor: unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(ctor),
    proto: unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(proto),
    target: targetOpt,
    fnProto: fnProtoOpt,
    applyFn: applyOpt,
    realm: unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(realm),
    finalShapePtr: unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(final),
    ctorVersion: ctorVersion,
    targetVersion: targetVersion,
    fnProtoVersion: fnProtoVersion,
    shapeEpoch: epoch,
    finalShape: Pointer.address<HeapHeader>(final),
    emptyShape: Pointer.address<HeapHeader>(empty),
    protoSlot: protoSlot,
    holderSlot: holderSlot,
    applySlot: applySlot,
    receiverSlot: recvSlot,
    stores: stores,
    tail: tail,
    protoObjs: protoObjs,
    protoVersions: protoVersions,
    addAtoms: addAtoms,
    protoCount: usize.toU8(protoCount),
    forward: if forward { 1 } else { 0 },
    fromEmpty: fromEmpty,
    checkInterrupt: checkInterrupt,
    guardVarCell: guardVarCell,
    guardVarExpect: guardVarExpect,
    guardHopObjs: guardHopObjs,
    guardHopExpect: guardHopExpect,
    guardHopVersions: guardHopVersions,
    guardHopSlots: guardHopSlots,
    guardHopCount: guardHopCount,
    nestedKind: nestedKind,
    nestedInitCount: nestedInitCount,
    nestedDescIdx: nestedDescIdx,
    nestedDesc: Pointer.null<u8>(),
    nestedArrayShape: nestedArrayShape,
    nestedInitVals: nestedInitVals
  })
  run targets.append(ConstructTarget {
    pc: readPc,
    id: id,
    shapeVersion: shapeVersion,
    kind: planKind,
    stores: usize.toU8(stores),
    nodeCount: nodeCount,
    sources: sources,
    roots: roots,
    nodes: nodes,
    constKinds: constKinds,
    constBits: constBits
  })
}

fn sameValueBits(a: ValueBits, b: ValueBits) -> bool {
  return match a {
    ValueBits.Undefined => match b { ValueBits.Undefined => true _ => false }
    ValueBits.Null => match b { ValueBits.Null => true _ => false }
    ValueBits.Bool { value: x } => match b { ValueBits.Bool { value: y } => x == y _ => false }
    ValueBits.Int { value: x } => match b { ValueBits.Int { value: y } => x == y _ => false }
    ValueBits.Float64 { value: x } => match b { ValueBits.Float64 { value: y } => f64.toBits(x) == f64.toBits(y) _ => false }
    _ => false
  }
}

fn sameConstructDesc(a: &ConstructDesc, b: &ConstructDesc) -> bool {
  if !(Pointer.address<HeapHeader>(a.ctor) == Pointer.address<HeapHeader>(b.ctor)
    && Pointer.address<HeapHeader>(a.proto) == Pointer.address<HeapHeader>(b.proto)
    && Pointer.address<HeapHeader>(a.target) == Pointer.address<HeapHeader>(b.target)
    && Pointer.address<HeapHeader>(a.fnProto) == Pointer.address<HeapHeader>(b.fnProto)
    && Pointer.address<HeapHeader>(a.applyFn) == Pointer.address<HeapHeader>(b.applyFn)
    && a.ctorVersion == b.ctorVersion && a.targetVersion == b.targetVersion && a.fnProtoVersion == b.fnProtoVersion
    && a.finalShape == b.finalShape && a.emptyShape == b.emptyShape
    && a.stores == b.stores && a.tail == b.tail
    && a.forward == b.forward && a.fromEmpty == b.fromEmpty && a.checkInterrupt == b.checkInterrupt
    && a.receiverSlot == b.receiverSlot && a.protoCount == b.protoCount
    && Pointer.address<HeapHeader>(a.guardVarCell) == Pointer.address<HeapHeader>(b.guardVarCell)
    && Pointer.address<HeapHeader>(a.guardVarExpect) == Pointer.address<HeapHeader>(b.guardVarExpect)
    && a.guardHopCount == b.guardHopCount
    && a.nestedKind == b.nestedKind && a.nestedInitCount == b.nestedInitCount
    && Pointer.address<u8>(a.nestedDesc) == Pointer.address<u8>(b.nestedDesc)
    && Pointer.address<HeapHeader>(a.nestedArrayShape) == Pointer.address<HeapHeader>(b.nestedArrayShape)) {
    return false
  }
  let mut h: usize = 0
  while h < u8.toUsize(a.guardHopCount) {
    if Pointer.address<HeapHeader>(a.guardHopObjs[h]) != Pointer.address<HeapHeader>(b.guardHopObjs[h])
      || Pointer.address<HeapHeader>(a.guardHopExpect[h]) != Pointer.address<HeapHeader>(b.guardHopExpect[h])
      || a.guardHopVersions[h] != b.guardHopVersions[h] || a.guardHopSlots[h] != b.guardHopSlots[h] {
      return false
    }
    h = h + 1
  }
  let mut s: usize = 0
  while s < u8.toUsize(a.nestedInitCount) {
    if !sameValueBits(a.nestedInitVals[s], b.nestedInitVals[s]) { return false }
    s = s + 1
  }
  return true
}

/// Deduplicates `localDescs[idx]` (and any nested child descriptor) into `jit.constructDescs`,
/// keeping every referenced heap object alive for the runtime, and returns its stable pointer.
unsafe fn commitConstructDescPtr(jit: &mut Jit, rt: *mut HeapHeader, localDescs: &List<ConstructDesc>, idx: usize, depth: usize) -> ?*mut u8 {
  if depth > 2 || idx >= localDescs.length() { return Pointer.null<u8>() }
  let mut desc = localDescs.get(idx)
  if desc.nestedKind == helpers.NESTED_PLAIN {
    let innerPtr = unsafe commitConstructDescPtr(&mut jit, rt, &localDescs, u32.toUsize(desc.nestedDescIdx), depth + 1)
    if Pointer.isNull<u8>(innerPtr) { return Pointer.null<u8>() }
    desc.nestedDesc = innerPtr
  }
  let mut i: usize = 0
  while i < jit.constructDescs.length() {
    if sameConstructDesc(&jit.constructDescs.asSlice()[i], &desc) {
      let ptr = Pointer.fromMutRef<ConstructDesc>(&mut jit.constructDescs.asMutSlice()[i])
      return unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut ConstructDesc, *mut u8>(ptr))
    }
    i = i + 1
  }
  if jit.constructDescs.length() >= CONSTRUCT_DESC_CAPACITY { return Pointer.null<u8>() }
  if let Option<*mut HeapHeader>.Some { value: o } = Pointer.nonNullMut<HeapHeader>(desc.ctor) { if !(unsafe inline.keepClosure(rt, o)) { return Pointer.null<u8>() } }
  if let Option<*mut HeapHeader>.Some { value: o } = Pointer.nonNullMut<HeapHeader>(desc.proto) { if !(unsafe inline.keepClosure(rt, o)) { return Pointer.null<u8>() } }
  if desc.forward != 0 {
    if let Option<*mut HeapHeader>.Some { value: o } = Pointer.nonNullMut<HeapHeader>(desc.target) { if !(unsafe inline.keepClosure(rt, o)) { return Pointer.null<u8>() } }
    if let Option<*mut HeapHeader>.Some { value: o } = Pointer.nonNullMut<HeapHeader>(desc.fnProto) { if !(unsafe inline.keepClosure(rt, o)) { return Pointer.null<u8>() } }
    if let Option<*mut HeapHeader>.Some { value: o } = Pointer.nonNullMut<HeapHeader>(desc.applyFn) { if !(unsafe inline.keepClosure(rt, o)) { return Pointer.null<u8>() } }
  }
  let mut p: usize = 0
  while p < u8.toUsize(desc.protoCount) {
    if let Option<*mut HeapHeader>.Some { value: o } = Pointer.nonNullMut<HeapHeader>(desc.protoObjs[p]) { if !(unsafe inline.keepClosure(rt, o)) { return Pointer.null<u8>() } }
    p = p + 1
  }
  if let Option<*mut HeapHeader>.Some { value: o } = Pointer.nonNullMut<HeapHeader>(desc.guardVarExpect) { if !(unsafe inline.keepClosure(rt, o)) { return Pointer.null<u8>() } }
  let mut h: usize = 0
  while h < u8.toUsize(desc.guardHopCount) {
    if let Option<*mut HeapHeader>.Some { value: o } = Pointer.nonNullMut<HeapHeader>(desc.guardHopObjs[h]) { if !(unsafe inline.keepClosure(rt, o)) { return Pointer.null<u8>() } }
    if let Option<*mut HeapHeader>.Some { value: o } = Pointer.nonNullMut<HeapHeader>(desc.guardHopExpect[h]) { if !(unsafe inline.keepClosure(rt, o)) { return Pointer.null<u8>() } }
    h = h + 1
  }
  // Pin one sentinel plain object holding `desc.finalShapePtr` in the runtime's kept table
  // so the final shape stays alive (referenceCount >= 1) for deopt materialization.
  let finalShape = match Pointer.nonNullMut<HeapHeader>(desc.finalShapePtr) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<u8>() }
  }
  let sentinel = match Pointer.nonNullMut<HeapHeader>(unsafe helpers.allocSentinelPlain(rt, finalShape, desc.stores, desc.tail)) {
    Option<*mut HeapHeader>.Some { value } => value
    Option<*mut HeapHeader>.None => { return Pointer.null<u8>() }
  }
  let keptSentinel = unsafe inline.keepClosure(rt, sentinel)
  unsafe gc.releaseDeferred(ValueBits.Object { reference: sentinel })
  if !keptSentinel { return Pointer.null<u8>() }
  if desc.tail == shapes.PAIR_SLOTS {
    // jitNewObject asks the plan on the prototype's empty shape for each object's tail
    // while the plan was a pair's trial; a second sentinel keeps that shape alive.
    let empty = unsafe Pointer.read<*mut HeapHeader>(unsafe Intrinsic.pointerReinterpret<*const usize, *const *mut HeapHeader>(Pointer.fromRef<usize>(&desc.emptyShape)))
    let emptySentinel = match Pointer.nonNullMut<HeapHeader>(unsafe helpers.allocSentinelPlain(rt, empty, 0, shapes.PAIR_SLOTS)) {
      Option<*mut HeapHeader>.Some { value } => value
      Option<*mut HeapHeader>.None => { return Pointer.null<u8>() }
    }
    let keptEmpty = unsafe inline.keepClosure(rt, emptySentinel)
    unsafe gc.releaseDeferred(ValueBits.Object { reference: emptySentinel })
    if !keptEmpty { return Pointer.null<u8>() }
  }
  let slot = jit.constructDescs.length()
  if !jit.constructDescs.appendWithinCapacity(desc) { return Pointer.null<u8>() }
  let ptr = Pointer.fromMutRef<ConstructDesc>(&mut jit.constructDescs.asMutSlice()[slot])
  return unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(unsafe Intrinsic.pointerReinterpret<*mut ConstructDesc, *mut u8>(ptr))
}

unsafe fn commitConstructDesc(jit: &mut Jit, rt: *mut HeapHeader, localDescs: &List<ConstructDesc>, idx: usize, depth: usize) -> usize {
  return Pointer.address<u8>(unsafe commitConstructDescPtr(&mut jit, rt, &localDescs, idx, depth))
}

/// The own data-property object `atom` of `object`, or null for anything else.
unsafe fn ownObject(object: *mut HeapHeader, atom: u32) -> ?*mut HeapHeader {
  let anchor = ()
  let data = unsafe HeapCell.payload<ObjectData, ()>(&anchor, object)
  if data.isExotic() { return Pointer.null<HeapHeader>() }
  let slot = match unsafe shapes.lookup(data.shape, atom) { Option<usize>.Some { value } => value Option<usize>.None => { return Pointer.null<HeapHeader>() } }
  if slot >= data.slotCount() || (u8.toU32(unsafe shapes.slotFlags(data.shape, slot)) & JS_PROP_TMASK) != 0 { return Pointer.null<HeapHeader>() }
  return match (unsafe data.slotUnchecked(slot)).valueBits() {
    ValueBits.Object { reference } => unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(reference)
    _ => Pointer.null<HeapHeader>()
  }
}

/// The watched objects of one candidate, KNOWN_SYMBOLS of them, into holders.
effect fn appendKnown(holders: &mut List<?*mut HeapHeader>, known: &KnownMethod) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut n: usize = 0
  while n < u32.toUsize(KNOWN_SYMBOLS) { run holders.append(known.chain[n]) n = n + 1 }
}
/// known as an inline target carries it (ssa.KnownShapes).
fn knownShapes(known: &KnownMethod) -> KnownShapes {
  let mut shapes = KnownShapes.none()
  let mut n: usize = 0
  while n < known.count { shapes.shapes[n] = u64.wrappingToU32(known.shapes[n]) shapes.lengths[n] = known.lengths[n] n = n + 1 }
  return shapes
}
/// Merges live bytecode inline keys and fieldCache own entries of bytecode into
/// RuntimeState.compiled.siteShapes (covering interpreter/engine polyFields hits that
/// bypass noteSiteShape). When clearMethodCache is true, also clears get_field2
/// fieldCache entries of bytecode so baseline warms them through baselineGetField2.
unsafe fn syncSiteShapes(rt: *mut HeapHeader, bytecode: *mut HeapHeader, clearMethodCache: bool) -> () {
  let mut stateAnchor = ()
  let state = unsafe HeapCell.payloadMut<RuntimeState, ()>(&mut stateAnchor, rt)
  let table = match Pointer.nonNullMut<SiteShapes>(state.compiled.siteShapes) {
    Option<*mut SiteShapes>.Some { value } => value
    Option<*mut SiteShapes>.None => { return () }
  }
  let mask = state.compiled.siteShapeMask
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let bytes = unsafe function.code.asSlice()
  let codeStart = unsafe Pointer.assumeMany<u8>(unsafe function.code.start())
  let base = Pointer.address<u8>(unsafe function.code.start())
  let mut pc: usize = 0
  while pc < bytes.length {
    let opcode = bytes[pc]
    let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
    if size == 0 || pc + size > bytes.length { break }
    let site = base + pc + 1
    if (opcode == op.OP_get_field || opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8
        || opcode == op.OP_put_field || opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8)
      && size >= 13 {
      let key = unsafe Pointer.readUnaligned<u64>(unsafe Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(unsafe Pointer.at<u8>(codeStart, pc + 5)))
      if key != 0 && u64.shiftRight(key, 62) == 0 {
        let version = u64.shiftRight(key, 16)
        if version != 0 && version < 2147483648 {
          unsafe noteSiteShape(table, mask, site, key, 0, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), 0)
        }
      }
      let slot = fieldCacheIndex(site)
      let spare = fieldSpareIndex(slot)
      let mut pass: usize = 0
      while pass < 2 {
        let idx = if pass == 0 { slot } else { spare }
        if state.fieldCache[idx].site == site {
          let fk = state.fieldCache[idx].key
          if fk != 0 && u64.shiftRight(fk, 62) == 0 {
            let fv = u64.shiftRight(fk, 16)
            if fv != 0 && fv < 2147483648 {
              unsafe noteSiteShape(table, mask, site, fk, 0, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), 0)
            }
          }
        }
        pass = pass + 1
      }
    } else if opcode == op.OP_get_field2 {
      let slot = fieldCacheIndex(site)
      let spare = fieldSpareIndex(slot)
      let mut pass: usize = 0
      while pass < 2 {
        let idx = if pass == 0 { slot } else { spare }
        if state.fieldCache[idx].site == site {
          let fk = state.fieldCache[idx].key
          if fk != 0 && u64.shiftRight(fk, 62) == 0 {
            let fv = u64.shiftRight(fk, 16)
            if fv != 0 && fv < 2147483648 {
              unsafe noteSiteShape(table, mask, site, fk, 0, Pointer.null<HeapHeader>(), Pointer.null<HeapHeader>(), 0)
            }
          }
          if clearMethodCache && (state.fieldCache[idx].protoKey == 0 || u64.bitAnd(fk, FIELD_PROTO_KEY) != 0) {
            state.fieldCache[idx].site = 0
          }
        }
        pass = pass + 1
      }
    }
    pc = pc + size
  }
}
/// What the runtime recorded of each get_field2 of bytecode (FunctionInput.siteShapes).
unsafe effect fn siteShapesOf(rt: *mut HeapHeader, bytecode: *mut HeapHeader) -> List<SiteShape> ! OutOfMemoryError ? &mut Allocator {
  unsafe syncSiteShapes(rt, bytecode, false)
  let mut found = List<SiteShape>.make()
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let bytes = unsafe function.code.asSlice()
  let mut pc: usize = 0
  while pc < bytes.length {
    let opcode = bytes[pc]
    let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
    if size == 0 || pc + size > bytes.length { break }
    if opcode == op.OP_get_field2 {
      let mut site = SiteShape { pc: usize.toU32(pc), count: 0, keys: [0, 0, 0, 0], protoKeys: [0, 0, 0, 0], firstKeys: [0, 0, 0, 0] }
      site.count = unsafe inline.siteShapes(rt, bytecode, site.pc, &mut site.keys, &mut site.protoKeys, &mut site.firstKeys)
      // A primitive's method (`s.trim()`): no shape of the receiver to test, which would leave
      // on every string; the cached read's helper reads it from the class prototype.
      if site.count != 0 && !unsafe inline.primitiveReceiver(bytecode, &site.keys, site.count) { run found.append(site) }
    }
    if opcode == op.OP_get_field || opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8 {
      // A read with an inline key: emit its SiteShape when it saw multiple shapes (including
      // mixed own + prototype hits) or a single prototype-chain hit (which keyAt cannot carry).
      let mut site = SiteShape { pc: usize.toU32(pc), count: 0, keys: [0, 0, 0, 0], protoKeys: [0, 0, 0, 0], firstKeys: [0, 0, 0, 0] }
      site.count = unsafe inline.siteShapes(rt, bytecode, site.pc, &mut site.keys, &mut site.protoKeys, &mut site.firstKeys)
      if (site.count >= 2 || (site.count == 1 && site.protoKeys[0] != 0))
        && !unsafe inline.primitiveReceiver(bytecode, &site.keys, site.count) {
        run found.append(site)
      }
    }
    if opcode == op.OP_put_field || opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8 {
      // A store with an inline key: only own keys, when there are several
      // (one shape is what the key itself says).
      let mut site = SiteShape { pc: usize.toU32(pc), count: 0, keys: [0, 0, 0, 0], protoKeys: [0, 0, 0, 0], firstKeys: [0, 0, 0, 0] }
      site.count = unsafe inline.siteShapes(rt, bytecode, site.pc, &mut site.keys, &mut site.protoKeys, &mut site.firstKeys)
      let mut own = site.count >= 2
      let mut n: usize = 0
      while n < u32.toUsize(site.count) { if site.protoKeys[n] != 0 || site.firstKeys[n] != 0 || u64.shiftRight(site.keys[n], 63) != 0 { own = false } n = n + 1 }
      if own { run found.append(site) }
    }
    pc = pc + size
  }
  return move found
}
/// Links code for the address it will run at, with symbols for its relocations, and
/// publishes it.
effect fn publish(memory: &mut CodeMemory, code: &mut Code, symbols: &[usize]) -> CodeBlock ! MemoryError | LinkError {
  let mut writer = run memory.allocatePacked(code.bytes.length() + TRAP_TAIL)
  run code.link(writer.address(), symbols)
  run appendCode(&mut writer, code.bytes.asSlice())
  return run writer.finish()
}
/// Trapping bytes after every published block. Code that ended on the last bytes of a page
/// would otherwise be followed by a page that cannot be read, and a decoder that reads ahead
/// of the last instruction (valgrind's) faults there.
const TRAP_TAIL: usize = 16
effect fn appendCode(writer: &mut CodeWriter, bytes: &[u8]) -> () ! MemoryError {
  run writer.append(bytes)
  run writer.append(b"\xcc\xcc\xcc\xcc\xcc\xcc\xcc\xcc\xcc\xcc\xcc\xcc\xcc\xcc\xcc\xcc")
}
struct SplitBlocks { hot: CodeBlock, cold: CodeBlock }
/// Links code for the address it will run at in packed `lane`, and publishes it.
effect fn publishIn(memory: &mut CodeMemory, lane: usize, code: &mut Code, symbols: &[usize]) -> CodeBlock ! MemoryError | LinkError {
  let mut writer = run memory.allocatePackedIn(lane, code.bytes.length() + TRAP_TAIL)
  run code.link(writer.address(), symbols)
  run appendCode(&mut writer, code.bytes.asSlice())
  return run writer.finish()
}
/// Links split code across `hotLane` (`PACK_OPT_HOT` or `PACK_BASE_HOT`) and `PACK_COLD`
/// within the same `CodeMemory` mapping, patching both external relocations and hot<->cold
/// cross-region displacements, and publishes both halves.
effect fn publishSplitIn(memory: &mut CodeMemory, hotLane: usize, code: &mut Code, split: &SplitInfo, symbols: &[usize]) -> SplitBlocks ! MemoryError | LinkError {
  let hotLen = split.hotBytes
  let coldLen = code.bytes.length() - hotLen
  let mut hotWriter = run memory.allocatePackedIn(hotLane, hotLen + TRAP_TAIL)
  let mut coldWriter = run memory.allocatePackedIn(PACK_COLD, coldLen + TRAP_TAIL)
  run code.linkSplit(hotWriter.address(), coldWriter.address(), split, symbols)
  let bytes = code.bytes.asSlice()
  run appendCode(&mut hotWriter, Slice.view<u8>(bytes, 0, hotLen))
  run appendCode(&mut coldWriter, Slice.view<u8>(bytes, hotLen, coldLen))
  let hot = run hotWriter.finish()
  let cold = run coldWriter.finish()
  return SplitBlocks { hot: move hot, cold: move cold }
}
effect fn publishSplit(memory: &mut CodeMemory, code: &mut Code, split: &SplitInfo, symbols: &[usize]) -> SplitBlocks ! MemoryError | LinkError {
  return run publishSplitIn(&mut memory, PACK_OPT_HOT, &mut code, split, symbols)
}
effect fn sayRefusal(reason: &Refusal) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(b"jit: refused: ") run line.appendSlice(reason.text())
  if reason.hasOpcode { run line.appendSlice(b": ") run line.appendSlice(op.opcodeName(reason.opcode, true)) }
  run line.append(10)
  io.stderr(line.asSlice())
}
/// --jit-dump: one compilation's phase times and sizes.
effect fn dumpCost(prefix: &[u8], cost: &Cost) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(prefix)
  run line.appendSlice(b" bytes ") run decimal(&mut line, cost.bytecodeBytes)
  run line.appendSlice(b" ssa ") run decimal(&mut line, cost.translated)
  run line.appendSlice(b" optimized ") run decimal(&mut line, cost.optimized)
  run line.appendSlice(b" translate-ns ") run decimal(&mut line, cost.translate)
  run line.appendSlice(b" optimize-ns ") run decimal(&mut line, cost.optimize)
  run line.appendSlice(b" verify-ns ") run decimal(&mut line, cost.verify)
  run line.appendSlice(b" backend-ns ") run decimal(&mut line, cost.backend)
  run line.append(10)
  io.stderr(line.asSlice())
}
effect fn say(prefix: &[u8], text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(prefix) run line.appendSlice(text) run line.append(10)
  io.stderr(line.asSlice())
}

/// --jit-dump: the machine code before linking, as hex (`llvm-mc --disassemble` reads it).
/// --jit-dump: where code was published and its bytes as linked there, `<prefix><address>
/// <hex bytes>` (scripts/jit_hot.py maps a callgrind profile's addresses onto them).
effect fn dumpPlaced(prefix: &[u8], address: usize, code: &Code) -> () ! OutOfMemoryError ? &mut Allocator {
  run dumpBytes(prefix, address, code.bytes.asSlice())
}
/// dumpPlaced for code split in two: the hot part at `hot`, and the cold part, from
/// `hotBytes` on, at `cold` on a `<kind> cold code at` line.
effect fn dumpSplitPlaced(kind: &[u8], hot: usize, cold: usize, hotBytes: usize, code: &Code) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = code.bytes.asSlice()
  let mut prefix = List<u8>.make()
  run prefix.appendSlice(b"jit: ") run prefix.appendSlice(kind)
  if hotBytes == 0 || hotBytes >= bytes.length {
    run prefix.appendSlice(b" code at ")
    run dumpBytes(prefix.asSlice(), hot, bytes)
    return ()
  }
  run prefix.appendSlice(b" code at ")
  run dumpBytes(prefix.asSlice(), hot, Slice.view<u8>(bytes, 0, hotBytes))
  let mut coldPrefix = List<u8>.make()
  run coldPrefix.appendSlice(b"jit: ") run coldPrefix.appendSlice(kind) run coldPrefix.appendSlice(b" cold code at ")
  run dumpBytes(coldPrefix.asSlice(), cold, Slice.view<u8>(bytes, hotBytes, bytes.length - hotBytes))
}
effect fn dumpBytes(prefix: &[u8], address: usize, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(prefix)
  run decimal(&mut line, usize.toU64(address))
  run line.append(32)
  let mut index: usize = 0
  while index < bytes.length { run hex(&mut line, bytes[index]) index = index + 1 }
  run line.append(10)
  io.stderr(line.asSlice())
}
effect fn dumpMachine(code: &Code) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(b"jit: machine")
  let bytes = code.bytes.asSlice()
  let mut index: usize = 0
  while index < bytes.length { run line.appendSlice(b" 0x") run hex(&mut line, bytes[index]) index = index + 1 }
  run line.append(10)
  io.stderr(line.asSlice())
}

/// --jit-dump: the opcodes at the sites a recompiled function deoptimized at so far (refused:
/// it is refused now, for deoptimizing again there or recompiling too often).
unsafe effect fn dumpSites(function: &FunctionBytecode, sites: &[u32], kinds: &[u8], fresh: usize, refused: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = unsafe function.code.asSlice()
  let mut index: usize = fresh
  while index < sites.length {
    let pc = u32.toUsize(sites[index])
    if pc < bytes.length {
      if refused { run say(b"jit: refused after deoptimizing at: ", op.opcodeName(bytes[pc], true)) }
      else { run say(b"jit: deoptimized at: ", op.opcodeName(bytes[pc], true)) }
      // `jit: deopt operands: <opcode> <decisive>/<next>`, the kinds this compilation met there.
      if index < kinds.length && kinds[index] != 0 {
        let mut line = List<u8>.make()
        run line.appendSlice(b"jit: deopt operands: ") run line.appendSlice(op.opcodeName(bytes[pc], true))
        run line.append(32) run line.appendSlice(kindName(kinds[index] & 15))
        run line.append(47) run line.appendSlice(kindName(kinds[index] / 16))
        run line.append(10)
        io.stderr(line.asSlice())
      }
    }
    index = index + 1
  }
}
/// js_compiled.KIND_* by number.
fn kindName(kind: u8) -> &'static [u8] {
  if kind == 1 { return b"int" } if kind == 2 { return b"float64" } if kind == 3 { return b"bool" }
  if kind == 4 { return b"undefined" } if kind == 5 { return b"null" } if kind == 6 { return b"string" }
  if kind == 7 { return b"symbol-or-bigint" } if kind == 8 { return b"local-function" } if kind == 9 { return b"object" }
  if kind == 10 { return b"array" } if kind == 11 { return b"linked-function" } if kind == 12 { return b"bytecode-function" }
  if kind == 13 { return b"native-function" } if kind == 14 { return b"bound-function" } if kind == 15 { return b"other" }
  return b"-"
}
/// What the recording saw at each offset of sites from fresh on: `jit: seen <opcode> count N
/// left L right R flags F shapes S targets T` (js_feedback.Site).
unsafe effect fn dumpSeen(rt: *mut HeapHeader, bytecode: *mut HeapHeader, function: &FunctionBytecode, sites: &[u32], fresh: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let seen = match run unsafe feedback.snapshot(rt, bytecode) {
    Option<feedback.Snapshot>.Some { value } => move value
    Option<feedback.Snapshot>.None => { return () }
  }
  let bytes = unsafe function.code.asSlice()
  let mut index: usize = fresh
  while index < sites.length {
    let mut k: usize = 0
    let mut found = false
    while k < seen.sites.length() {
      let site = seen.sites.get(k)
      if site.offset == sites[index] {
        found = true
        let mut line = List<u8>.make()
        run line.appendSlice(b"jit: seen ") run line.appendSlice(op.opcodeName(site.opcode, true))
        run line.appendSlice(b" count ") run decimal(&mut line, u32.toU64(site.count))
        run line.appendSlice(b" left ") run decimal(&mut line, u8.toU64(site.left))
        run line.appendSlice(b" right ") run decimal(&mut line, u8.toU64(site.right))
        run line.appendSlice(b" flags ") run decimal(&mut line, u8.toU64(site.flags))
        run line.appendSlice(b" shapes ") run decimal(&mut line, u8.toU64(site.shapeCount))
        run line.appendSlice(b" targets ") run decimal(&mut line, u8.toU64(site.targets))
        run line.append(10)
        io.stderr(line.asSlice())
      }
      k = k + 1
    }
    if !found && u32.toUsize(sites[index]) < bytes.length { run say(b"jit: unseen ", op.opcodeName(bytes[u32.toUsize(sites[index])], true)) }
    index = index + 1
  }
}
unsafe effect fn dumpBytecode(function: &FunctionBytecode) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(b"jit: hot args ") run decimal(&mut line, u16.toU64(function.argumentCount))
  run line.appendSlice(b" locals ") run decimal(&mut line, u16.toU64(function.variableCount))
  run line.appendSlice(b" stack ") run decimal(&mut line, u16.toU64(function.stackSize))
  run line.appendSlice(b" refs ") run decimal(&mut line, u16.toU64(function.varRefCount))
  run line.appendSlice(b" scope ") run decimal(&mut line, u16.toU64(function.scopeSlots))
  run line.appendSlice(b" mode ") run decimal(&mut line, u8.toU64(function.mode))
  run line.appendSlice(b" constants ") run decimal(&mut line, usize.toU64(function.constants.length()))
  run line.appendSlice(b" code")
  let bytes = unsafe function.code.asSlice()
  let mut index: usize = 0
  while index < bytes.length { run line.append(32) run hex(&mut line, bytes[index]) index = index + 1 }
  run line.append(10)
  io.stderr(line.asSlice())
}
