    ib: if server { IB_READ_CLIENT_MAGIC } else { IB_READ_FIRST_SETTINGS }, hdLength: 0, hdStream: 0, hdKind: 0, hdFlags: 0, payloadLeft: if server { 24 } else { 0 }, padlen: 0,
