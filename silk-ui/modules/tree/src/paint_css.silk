//! The paint effects of a node: `filter`, `clip-path`, `mask` and its longhands,
//! `mix-blend-mode`, `text-shadow`, and the background image layers with their size, position,
//! repeat, origin and clip. Each declaration is parsed with css-style's grammars (Filter Effects
//! 1, Masking 1, Shapes 1, Images 3, Text Decoration 3) and computed against the node's font size
//! and color, keeping percentages for paint to resolve against the box. As in CSS, a value that
//! does not parse is dropped and the earlier one stays.
import mutation { Declaration, CssProperty }
import thin { Thin }
import properties.values
import properties.convert { Context }
import properties.convert
import properties.values { Value, Separator }
import mutation { DimensionKind }
import silk.geometry.corners { Corners }
import properties.catalog
import svg_css.lexer
import svg_css.tokens { Limits, CssError }
import svg_css.input { Input, TokenView }
import svg_css.tokens { Kind }
import svg_css.value_cursor { Cursor }
import svg_css.dimensions
import svg_css.dimensions { ExprId, Store, Context as LengthContext }
import svg_css.colors
import svg_css.colors { Color, Context as ColorContext }
import svg_css.effect_values
import svg_css.effect_values {
  EffectValue,
  Filter,
  Image,
  MaskLayer,
  ClipSource,
  GeometryBox,
  Size,
  RepeatPair,
  Repeat,
  Composite,
  MaskMode,
  Border,
  BorderMeasure,
}
import svg_css.transform_values { Position, PositionAxis, Edge }
import svg_css.dimensions { Dimension, Unit }
import svg_css.text_values
import svg_css.text_values { Atom }
import vector.layer {
  BLEND_NORMAL,
  BLEND_MULTIPLY,
  BLEND_SCREEN,
  BLEND_OVERLAY,
  BLEND_DARKEN,
  BLEND_LIGHTEN,
  BLEND_COLOR_DODGE,
  BLEND_COLOR_BURN,
  BLEND_HARD_LIGHT,
  BLEND_SOFT_LIGHT,
  BLEND_DIFFERENCE,
  BLEND_EXCLUSION,
  BLEND_HUE,
  BLEND_SATURATION,
  BLEND_COLOR,
  BLEND_LUMINOSITY,
}
import silk.collections.bytes { Bytes }
import silk.collections.hash { Hash }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// Whether the tree reads `property` here rather than in `Computed`.
pub fn handles(property: CssProperty) -> bool {
  return property == CssProperty.Filter || property == CssProperty.ClipPath
    || property == CssProperty.MixBlendMode
    || property == CssProperty.TextShadow
    || property == CssProperty.ShapeOutside
    || property == CssProperty.ShapeMargin
    || property == CssProperty.ShapeImageThreshold
    || isMask(property)
    || isBackgroundLayer(property)
    || isMaskBorder(property)
    || maskBorderOf(property) != property
}

fn isMaskBorder(property: CssProperty) -> bool {
  return property == CssProperty.MaskBorder || property == CssProperty.MaskBorderSource
    || property == CssProperty.MaskBorderMode
    || property == CssProperty.MaskBorderSlice
    || property == CssProperty.MaskBorderWidth
    || property == CssProperty.MaskBorderOutset
    || property == CssProperty.MaskBorderRepeat
}

/// The `mask-border` property whose grammar a `border-image` one shares, or `property` itself.
fn maskBorderOf(property: CssProperty) -> CssProperty {
  return if property == CssProperty.BorderImage {
    CssProperty.MaskBorder
  } else if property == CssProperty.BorderImageSource {
    CssProperty.MaskBorderSource
  } else if property == CssProperty.BorderImageSlice {
    CssProperty.MaskBorderSlice
  } else if property == CssProperty.BorderImageWidth {
    CssProperty.MaskBorderWidth
  } else if property == CssProperty.BorderImageOutset {
    CssProperty.MaskBorderOutset
  } else if property == CssProperty.BorderImageRepeat {
    CssProperty.MaskBorderRepeat
  } else {
    property
  }
}

/// Whether `image` is or holds a `url()` image.
pub fn usesUrl(image: &Image) -> bool {
  return match &image.* {
    Image.Url { .. } => true
    Image.CrossFade { layers } => {
      let mut i: usize = 0
      while i < layers.length() {
        if usesUrl(&layers.asSlice()[i].image) { return true }
        i = i + 1
      }
      return false
    }
    Image.Filtered { source, .. } => source.length() > 0 && usesUrl(&source.asSlice()[0])
    _ => false
  }
}

/// `border-image` or `mask-border`, with its longhands merged: an image cut in nine by `slice`
/// and drawn over the border area grown by `outset`. `set` is false until one is declared.
pub struct ImageBorder {
  pub set: bool,
  pub image: Image,
  pub mode: MaskMode,
  /// Numbers are image pixels, percentages of the image's size.
  pub slice: [ExprId; 4],
  pub fill: bool,
  /// Numbers are multiples of the border width; `auto` takes the slice.
  pub width: [BorderMeasure; 4],
  /// Numbers are multiples of the border width.
  pub outset: [ExprId; 4],
  pub repeat: RepeatPair,
}

impl ImageBorder {
  pub fn make() -> ImageBorder {
    let z = ExprId { index: 0 }
    return ImageBorder {
      set: false,
      image: Image.None,
      mode: MaskMode.Alpha,
      slice: [z; 4],
      fill: false,
      width: [BorderMeasure.Auto; 4],
      outset: [z; 4],
      repeat: RepeatPair { x: Repeat.Stretch, y: Repeat.Stretch },
    }
  }

  /// Whether it has an image to draw.
  pub fn drawn(self: &Self) -> bool {
    if !self.set { return false }
    return match &self.image {
      Image.None => false
      _ => true
    }
  }
}

/// Whether `apply` reads `property`: the ones it `handles`, `isolation` and `will-change`
/// (which `Computed.set` routes here itself), and the corner radii, whose percentages it keeps
/// (`Computed` keeps their lengths).
pub fn reads(property: CssProperty) -> bool {
  return handles(property) || isRadius(property) || property == CssProperty.Isolation
    || property == CssProperty.WillChange || property == CssProperty.OffsetPath
}

fn isRadius(property: CssProperty) -> bool {
  return property == CssProperty.BorderRadius || property == CssProperty.BorderTopLeftRadius
    || property == CssProperty.BorderTopRightRadius
    || property == CssProperty.BorderBottomRightRadius
    || property == CssProperty.BorderBottomLeftRadius
}

fn isMask(property: CssProperty) -> bool {
  return property == CssProperty.Mask || property == CssProperty.MaskImage
    || property == CssProperty.MaskMode
    || property == CssProperty.MaskRepeat
    || property == CssProperty.MaskPosition
    || property == CssProperty.MaskClip
    || property == CssProperty.MaskOrigin
    || property == CssProperty.MaskSize
    || property == CssProperty.MaskComposite
}

fn isBackgroundLayer(property: CssProperty) -> bool {
  return property == CssProperty.BackgroundImage || property == CssProperty.BackgroundPosition
    || property == CssProperty.BackgroundSize
    || property == CssProperty.BackgroundRepeat
    || property == CssProperty.BackgroundOrigin
    || property == CssProperty.BackgroundClip
    || property == CssProperty.BackgroundPositionX
    || property == CssProperty.BackgroundPositionY
    || property == CssProperty.BackgroundBlendMode
    || property == CssProperty.BackgroundAttachment
}

/// One computed `text-shadow`, in CSS pixels.
pub struct TextShadow {
  pub x: f32,
  pub y: f32,
  pub blur: f32,
  pub color: Rgba<f32>,
}

impl Copy for TextShadow {}

/// `background-clip`, with `text` beside the boxes.
pub enum Clip { Border, Padding, Content, Text }

/// A list of image layers with their longhands, as `background-*` and `mask-*` keep them: each
/// longhand list repeats to the number of images.
pub struct Layers {
  pub images: List<Image>,
  pub positions: List<Position>,
  pub sizes: List<Size>,
  pub repeats: List<RepeatPair>,
  pub origins: List<GeometryBox>,
  pub clips: List<Clip>,
  pub composites: List<Composite>,
  pub modes: List<MaskMode>,
  /// `background-blend-mode`, one `BLEND_*` a layer.
  pub blends: List<u8>,
  /// `background-attachment`, one `ATTACH_*` a layer.
  pub attachments: List<u8>,
}

/// `background-attachment: scroll`: the layer stays with the box, not its scrolled content.
pub const ATTACH_SCROLL: u8 = 0
/// `background-attachment: fixed`: the layer is placed on the viewport and stays there.
pub const ATTACH_FIXED: u8 = 1
/// `background-attachment: local`: the layer scrolls with the box's content.
pub const ATTACH_LOCAL: u8 = 2

impl Layers {
  pub fn make() -> Layers {
    return Layers {
      images: List<Image>.make(),
      positions: List<Position>.make(),
      sizes: List<Size>.make(),
      repeats: List<RepeatPair>.make(),
      origins: List<GeometryBox>.make(),
      clips: List<Clip>.make(),
      composites: List<Composite>.make(),
      modes: List<MaskMode>.make(),
      blends: List<u8>.make(),
      attachments: List<u8>.make(),
    }
  }

  /// Whether any layer has an image.
  pub fn painted(self: &Self) -> bool {
    let images = self.images.asSlice()
    let mut i: usize = 0
    while i < images.length {
      match &images[i] {
        Image.Linear { .. } => {
          return true
        }
        Image.Radial { .. } => {
          return true
        }
        Image.Conic { .. } => {
          return true
        }
        Image.Url { .. } => {
          return true
        }
        Image.CrossFade { .. } => {
          return true
        }
        Image.Filtered { .. } => {
          return true
        }
        _ => {}
      }
      i = i + 1
    }
    return false
  }

  /// Whether any layer is a `url()` image.
  pub fn hasUrl(self: &Self) -> bool {
    let images = self.images.asSlice()
    let mut i: usize = 0
    while i < images.length {
      if usesUrl(&images[i]) {
        return true
      }
      i = i + 1
    }
    return false
  }

  pub fn count(self: &Self) -> usize {
    return self.images.length()
  }

  /// `None` for the initial `0% 0%`.
  pub fn position(self: &Self, layer: usize) -> Option<Position> {
    let n = self.positions.length()
    return if n == 0 { Option<Position>.None } else { Option<Position>.some(self.positions.get(layer % n)) }
  }

  pub fn size(self: &Self, layer: usize) -> Size {
    let n = self.sizes.length()
    return if n == 0 {
      Size.Explicit { x: Option<ExprId>.None, y: Option<ExprId>.None }
    } else {
      self.sizes.get(layer % n)
    }
  }

  pub fn repeat(self: &Self, layer: usize) -> RepeatPair {
    let n = self.repeats.length()
    return if n == 0 {
      RepeatPair { x: Repeat.Repeat, y: Repeat.Repeat }
    } else {
      self.repeats.get(layer % n)
    }
  }

  pub fn origin(self: &Self, layer: usize, initial: GeometryBox) -> GeometryBox {
    let n = self.origins.length()
    return if n == 0 { initial } else { self.origins.get(layer % n) }
  }

  pub fn blend(self: &Self, layer: usize) -> u8 {
    let n = self.blends.length()
    return if n == 0 { BLEND_NORMAL } else { self.blends.get(layer % n) }
  }

  /// Whether a layer with an image blends with what is under it.
  pub fn blended(self: &Self) -> bool {
    if self.blends.length() == 0 {
      return false
    }
    let mut i: usize = 0
    while i < self.images.length() {
      if self.blend(i) != BLEND_NORMAL {
        return true
      }
      i = i + 1
    }
    return false
  }

  pub fn clip(self: &Self, layer: usize) -> Clip {
    let n = self.clips.length()
    return if n == 0 { Clip.Border } else { self.clips.get(layer % n) }
  }

  /// The `background-clip` of the background color: the bottom layer's.
  pub fn colorClip(self: &Self) -> Clip {
    let n = self.images.length()
    return self.clip(if n == 0 { 0 } else { n - 1 })
  }

  /// Whether a layer or the color is clipped to the text.
  pub fn textClipped(self: &Self) -> bool {
    let n = if self.images.length() == 0 { 1 } else { self.images.length() }
    let mut i: usize = 0
    while i < n {
      if self.clip(i) == Clip.Text {
        return true
      }
      i = i + 1
    }
    return false
  }

  pub fn mode(self: &Self, layer: usize) -> MaskMode {
    let n = self.modes.length()
    return if n == 0 { MaskMode.MatchSource } else { self.modes.get(layer % n) }
  }

  pub fn attachment(self: &Self, layer: usize) -> u8 {
    let n = self.attachments.length()
    return if n == 0 { ATTACH_SCROLL } else { self.attachments.get(layer % n) }
  }

  /// Whether any layer has `attachment`.
  pub fn attached(self: &Self, attachment: u8) -> bool {
    let mut i: usize = 0
    while i < self.attachments.length() {
      if self.attachments.get(i) == attachment { return true }
      i = i + 1
    }
    return false
  }

  pub fn composite(self: &Self, layer: usize) -> Composite {
    let n = self.composites.length()
    return if n == 0 { Composite.Add } else { self.composites.get(layer % n) }
  }
}

/// The paint effects one node declares, computed.
pub struct Effects {
  /// The numeric expressions the values below refer to.
  pub numerics: Store<'static>,
  pub filters: List<Filter>,
  /// Zero or one `clip-path`.
  pub clip: List<ClipSource>,
  pub masks: Thin<Layers>,
  pub backgrounds: Layers,
  /// `text-shadow`, first painted on top. `hasShadows` says the node sets it (`none` included),
  /// so it does not inherit its parent's.
  pub shadows: List<TextShadow>,
  pub hasShadows: bool,
  /// A `vector.layer` blend mode.
  pub blend: u8,
  /// The percentage part of each corner's horizontal radius, a fraction of the box's width.
  pub radii: Corners<f32>,
  /// Each corner's vertical radius: a length part and a fraction of the box's height. Without a
  /// vertical radius of its own a corner's are its horizontal ones.
  pub radiiY: Corners<f32>,
  pub lengthsY: Corners<f32>,
  /// `isolation: isolate`: blending inside stays inside.
  pub isolate: bool,
  /// `will-change` names a property that makes a stacking context.
  pub stacks: bool,
  /// Zero or one `shape-outside`, for floats. `shapeBox` says it names its reference box.
  pub shape: List<ClipSource>,
  pub shapeBox: bool,
  /// `shape-margin`, a length or percentage in `numerics`.
  pub shapeMargin: Option<ExprId>,
  /// Zero or one `shape-outside` image (`url()` or a gradient), in place of `shape`.
  pub shapeImage: List<Image>,
  /// `shape-image-threshold`, the alpha an image's pixels must pass to be in the shape.
  pub shapeThreshold: f32,
  /// `border-image`, drawn in place of the border's style.
  pub borderImage: Thin<ImageBorder>,
  /// `mask-border`, a mask over the border area besides the mask layers.
  pub maskBorder: Thin<ImageBorder>,
  /// Zero or one `offset-path` basic shape or `path()`; `transform.Offset` holds the rest.
  pub offset: List<ClipSource>,
  /// Same declarations at the same font size and color hash alike.
  pub hash: u64,
}

impl Effects {
  pub fn make() -> Effects {
    return Effects {
      numerics: Store<'static>.make(),
      filters: List<Filter>.make(),
      clip: List<ClipSource>.make(),
      masks: Thin<Layers>.none(),
      backgrounds: Layers.make(),
      shadows: List<TextShadow>.make(),
      hasShadows: false,
      blend: BLEND_NORMAL,
      radii: Corners<f32>.zero(),
      radiiY: Corners<f32>.zero(),
      lengthsY: Corners<f32>.zero(),
      isolate: false,
      stacks: false,
      shape: List<ClipSource>.make(),
      shapeBox: false,
      shapeMargin: Option<ExprId>.None,
      shapeImage: List<Image>.make(),
      shapeThreshold: 0.0,
      borderImage: Thin<ImageBorder>.none(),
      maskBorder: Thin<ImageBorder>.none(),
      offset: List<ClipSource>.make(),
      hash: 0,
    }
  }

  pub fn masksPainted(self: &Self) -> bool {
    return match self.masks.get() { Option.Some { value } => value.painted() _ => false }
  }

  pub fn masksCount(self: &Self) -> usize {
    return match self.masks.get() { Option.Some { value } => value.count() _ => 0 }
  }

  pub fn masksHasUrl(self: &Self) -> bool {
    return match self.masks.get() { Option.Some { value } => value.hasUrl() _ => false }
  }

  pub fn borderImageDrawn(self: &Self) -> bool {
    return match self.borderImage.get() { Option.Some { value } => value.drawn() _ => false }
  }

  pub fn maskBorderDrawn(self: &Self) -> bool {
    return match self.maskBorder.get() { Option.Some { value } => value.drawn() _ => false }
  }

  pub fn borderImageHasUrl(self: &Self) -> bool {
    return match self.borderImage.get() { Option.Some { value } => usesUrl(&value.image) _ => false }
  }

  pub fn maskBorderHasUrl(self: &Self) -> bool {
    return match self.maskBorder.get() { Option.Some { value } => usesUrl(&value.image) _ => false }
  }

  /// Whether paint needs an isolated layer for this node's own effects.
  pub fn layered(self: &Self) -> bool {
    return self.filters.length() != 0 || self.clip.length() != 0 || self.masksPainted()
      || self.maskBorderDrawn()
      || self.blend != BLEND_NORMAL
      || self.isolate
  }

  /// `length` or `percentage` `id` in CSS pixels, percentages of `basis`.
  pub fn pixels(self: &Self, id: ExprId, basis: f32) -> f32 {
    return f64.toF32(dimensions.evaluate(&self.numerics, id, f32.toF64(basis)))
  }

  /// A number, angle in degrees, or `amount` in CSS pixels, as computed.
  pub fn number(self: &Self, id: ExprId) -> f32 {
    return f64.toF32(dimensions.evaluate(&self.numerics, id, 1.0))
  }
}

/// What lengths and `currentColor` compute against.
pub struct Basis {
  pub units: Context,
  pub color: Rgba<f32>,
}

impl Copy for Basis {}

fn colorOf(color: Color, context: &ColorContext) -> Rgba<f32> {
  let c = colors.toSrgb(colors.compute(color, context))
  return Rgba<f32> { r: f64.toF32(c.r), g: f64.toF32(c.g), b: f64.toF32(c.b), a: f64.toF32(c.a) }
}

/// `declarations`' effect properties over `effects`, in order.
pub effect fn applyAll(effects: &mut Effects, declarations: &[Declaration], basis: Basis) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < declarations.length {
    if reads(declarations[i].property) {
      run apply(&mut effects.*, &declarations[i], basis)
    }
    i = i + 1
  }
}

/// Reset a longhand before explicit inheritance or CSS-wide defaulting.
pub effect fn initial(effects: &mut Effects, property: CssProperty, basis: Basis) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let declaration = Declaration { property: property, important: false, value: run values.text(catalog.initial(property)) }
  run apply(&mut effects.*, &declaration, basis)
}

/// Applies one effect declaration. A value that does not parse is ignored.
pub effect fn apply(effects: &mut Effects, declaration: &Declaration, basis: Basis) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = run values.cssText(&declaration.value)
  let seed = Hash.seed(0x9e3779b97f4a7c15)
  let mut h = Hash.combine(effects.hash, Hash.mix(&seed, usize.toU64(catalog.index(declaration.property))))
  let bytes = Bytes.asSlice(&text)
  let mut b: usize = 0
  while b < bytes.length {
    h = Hash.combine(h, u8.toU64(bytes[b]))
    b = b + 1
  }
  let units = &basis.units
  let metrics = units.metrics()
  let root = units.rootMetrics()
  let bases = [units.fontSize, units.rootFontSize,
    metrics.xHeight, metrics.capHeight, metrics.zeroAdvance, metrics.ideographAdvance, metrics.lineHeight,
    root.xHeight, root.capHeight, root.zeroAdvance, root.ideographAdvance, root.lineHeight,
    basis.color.r, basis.color.g, basis.color.b, basis.color.a, units.viewportWidth, units.viewportHeight]
  let mut i: usize = 0
  while i < bases.length { h = Hash.combine(h, u32.toU64(f32.toBits(bases[i]))) i = i + 1 }
  let optional = [units.smallViewportWidth, units.smallViewportHeight,
    units.containerWidth, units.containerHeight, units.containerInlineSize, units.containerBlockSize]
  i = 0
  while i < optional.length {
    h = Hash.combine(h, match optional[i] {
      Option.Some { value } => u32.toU64(f32.toBits(value)) + 1
      _ => 0
    })
    i = i + 1
  }
  h = Hash.combine(h, if units.vertical { 1 } else { 0 })
  effects.hash = h
  if isRadius(declaration.property) {
    applyRadius(&mut effects.*, declaration, units)
    return
  }
  drop run Effect.catch<CssError>(applyText(&mut effects.*, declaration.property, bytes, basis), ignored)
}

/// The percentage parts of a corner radius longhand and its vertical radius, or of each corner
/// `border-radius` sets (`Computed` keeps the horizontal lengths).
fn applyRadius(effects: &mut Effects, declaration: &Declaration, units: &Context) -> () {
  let property = declaration.property
  let value = &declaration.value
  if property != CssProperty.BorderRadius {
    let corner: usize = if property == CssProperty.BorderTopLeftRadius {
      0
    } else if property == CssProperty.BorderTopRightRadius {
      1
    } else if property == CssProperty.BorderBottomRightRadius {
      2
    } else {
      3
    }
    match &value.* {
      Value.Sequence { separator: Separator.Space, values } => {
        let items = values.asSlice()
        if items.length == 2 {
          setCorner(&mut effects.*, corner, &items[0], &items[1], units)
        }
      }
      _ => setCorner(&mut effects.*, corner, value, value, units)
    }
    return
  }
  // One to four radii, then optionally a slash and one to four vertical ones, as `margin`
  // repeats them.
  let mut horizontal = value
  let mut vertical = value
  match &value.* {
    Value.Sequence { separator: Separator.Slash, values } => {
      let items = values.asSlice()
      if items.length != 2 {
        return
      }
      horizontal = &items[0]
      vertical = &items[1]
    }
    _ => {}
  }
  let across = spacedCount(horizontal)
  let down = spacedCount(vertical)
  if across == 0 || across > 4 || down == 0 || down > 4 {
    return
  }
  let mut corner: usize = 0
  while corner < 4 {
    setCorner(&mut effects.*, corner, spacedItem(horizontal, pick(across, corner)), spacedItem(vertical, pick(down, corner)), units)
    corner = corner + 1
  }
}

/// Corner `corner` (top-left first) with radii `horizontal` and `vertical`; nothing when either
/// is not a radius.
fn setCorner(effects: &mut Effects, corner: usize, horizontal: &Value, vertical: &Value, units: &Context) -> () {
  let across = match share(horizontal, units) {
    Option.Some { value } => value
    Option.None => {
      return
    }
  }
  let down = match share(vertical, units) {
    Option.Some { value } => value
    Option.None => {
      return
    }
  }
  let length: f32 = match convert.dimension(vertical, units) {
    Option.Some { value: found } => found.value
    Option.None => 0.0
  }
  if corner == 0 {
    effects.radii.topLeft = across
    effects.radiiY.topLeft = down
    effects.lengthsY.topLeft = length
  } else if corner == 1 {
    effects.radii.topRight = across
    effects.radiiY.topRight = down
    effects.lengthsY.topRight = length
  } else if corner == 2 {
    effects.radii.bottomRight = across
    effects.radiiY.bottomRight = down
    effects.lengthsY.bottomRight = length
  } else {
    effects.radii.bottomLeft = across
    effects.radiiY.bottomLeft = down
    effects.lengthsY.bottomLeft = length
  }
}

fn spacedCount(value: &Value) -> usize {
  return match &value.* {
    Value.Sequence { separator: Separator.Space, values } => values.length()
    _ => 1
  }
}

fn spacedItem(value: &Value, index: usize) -> &Value {
  return match &value.* {
    Value.Sequence { separator: Separator.Space, values } => &values.asSlice()[index]
    _ => value
  }
}

fn pick(count: usize, corner: usize) -> usize {
  if count == 1 {
    return 0
  }
  if count == 2 {
    return corner % 2
  }
  if count == 3 {
    return if corner == 3 { 1 } else { corner }
  }
  return corner
}

/// The percentage of a length-percentage radius, as a fraction; `None` when it is not one.
fn share(value: &Value, units: &Context) -> Option<f32> {
  return match convert.dimension(value, units) {
    Option.Some { value: found } => {
      if (found.kind == DimensionKind.Length || found.kind == DimensionKind.Percent
        || found.kind == DimensionKind.Calc) && found.value >= 0.0 && found.percent >= 0.0 {
        Option<f32>.some(found.percent)
      } else {
        Option<f32>.None
      }
    }
    Option.None => Option<f32>.None
  }
}

effect fn ignored(error: CssError) -> () {
  drop error
}

effect fn applyText(effects: &mut Effects, property: CssProperty, css: &[u8], basis: Basis) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(css, &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let context = LengthContext.fromProperties(&basis.units)
  let current = Color.srgb(
    f32.toF64(basis.color.r),
    f32.toF64(basis.color.g),
    f32.toF64(basis.color.b),
    f32.toF64(basis.color.a),
  )
  let black = Color.srgb(0.0, 0.0, 0.0, 1.0)
  let colorContext = ColorContext.make(current, [black; 19])
  if property == CssProperty.MixBlendMode {
    let mode = blendOf(&source, &mut cursor)
    if mode != 255 && cursor.done(&source) {
      effects.blend = mode
    }
    return
  }
  if property == CssProperty.Isolation {
    if cursor.ident(&source, b"isolate") && cursor.done(&source) {
      effects.isolate = true
    } else if cursor.ident(&source, b"auto") && cursor.done(&source) {
      effects.isolate = false
    }
    return
  }
  if property == CssProperty.WillChange {
    applyWillChange(&mut effects.*, &source, &mut cursor)
    return
  }
  if property == CssProperty.MaskBorderMode {
    let luminance = cursor.ident(&source, b"luminance")
    if (luminance || cursor.ident(&source, b"alpha")) && cursor.done(&source) {
      let mb = run effects.maskBorder.getOrMake(ImageBorder.make)
      if !mb.set {
        let zero = run dimensions.literal(&mut effects.numerics, 0.0, Unit.Number)
        mb.set = true
        mb.slice = [zero; 4]
        mb.outset = [zero; 4]
      }
      mb.mode = if luminance { MaskMode.Luminance } else { MaskMode.Alpha }
    }
    return
  }
  if property == CssProperty.TextShadow {
    run applyShadows(&mut effects.*, &source, &mut cursor, &context, &colorContext)
    return
  }
  if property == CssProperty.BackgroundImage {
    run applyImages(&mut effects.*, &source, &mut cursor, &context, &colorContext)
    return
  }
  if property == CssProperty.BackgroundClip {
    run applyClips(&mut effects.*, &source, &mut cursor)
    return
  }
  if property == CssProperty.BackgroundAttachment {
    let mut attachments = List<u8>.make()
    while true {
      let attachment = if cursor.ident(&source, b"scroll") {
        ATTACH_SCROLL
      } else if cursor.ident(&source, b"fixed") {
        ATTACH_FIXED
      } else if cursor.ident(&source, b"local") {
        ATTACH_LOCAL
      } else {
        return
      }
      run attachments.append(attachment)
      if !cursor.comma(&source) {
        break
      }
    }
    if cursor.done(&source) {
      effects.backgrounds.attachments = move attachments
    }
    return
  }
  if property == CssProperty.BackgroundBlendMode {
    let mut blends = List<u8>.make()
    while true {
      let mode = blendOf(&source, &mut cursor)
      if mode == 255 {
        return
      }
      run blends.append(mode)
      if !cursor.comma(&source) {
        break
      }
    }
    if cursor.done(&source) {
      effects.backgrounds.blends = move blends
    }
    return
  }
  if property == CssProperty.OffsetPath {
    run applyOffsetPath(&mut effects.*, &source, &mut cursor, &context)
    return
  }
  if property == CssProperty.ShapeOutside || property == CssProperty.ShapeMargin
    || property == CssProperty.ShapeImageThreshold {
    run applyShape(&mut effects.*, property, css, &source, &mut cursor, &context)
    return
  }
  if property == CssProperty.BackgroundPositionX || property == CssProperty.BackgroundPositionY {
    run applyAxis(&mut effects.*, property == CssProperty.BackgroundPositionX, &source, &mut cursor, &context)
    return
  }
  // The background longhands share the mask longhands' grammar.
  let parsed = if property == CssProperty.BackgroundPosition {
    CssProperty.MaskPosition
  } else if property == CssProperty.BackgroundSize {
    CssProperty.MaskSize
  } else if property == CssProperty.BackgroundRepeat {
    CssProperty.MaskRepeat
  } else if property == CssProperty.BackgroundOrigin {
    CssProperty.MaskOrigin
  } else {
    maskBorderOf(property)
  }
  let value = match run effect_values.parse(&mut effects.numerics, parsed, &source, &mut cursor, false) {
    Option<EffectValue>.Some { value } => move value
    _ => {
      return
    }
  }
  if !cursor.done(&source) {
    return
  }
  let computed = run effect_values.compute(&value, &mut effects.numerics, &context, &colorContext)
  match move computed {
    EffectValue.None => {
      if property == CssProperty.Filter {
        effects.filters.clear()
      } else if property == CssProperty.ClipPath {
        effects.clip.clear()
      }
    }
    EffectValue.Filters { items } => {
      effects.filters = move items
    }
    EffectValue.ClipPath { source: clip } => {
      effects.clip.clear()
      run effects.clip.append(move clip)
    }
    EffectValue.Masks { layers, resetBorder } => {
      drop resetBorder
      // The `mask` shorthand resets `mask-border` too.
      if property == CssProperty.Mask { effects.maskBorder.clear() }
      if isBackgroundLayer(property) {
        run assignLayers(&mut effects.backgrounds, property, move layers)
      } else {
        let m = run effects.masks.getOrMake(Layers.make)
        run assignLayers(&mut m.*, property, move layers)
      }
    }
    EffectValue.MaskBorder { border } => {
      run assignBorder(&mut effects.*, property, move border)
    }
    EffectValue other => {
      drop other
    }
  }
}

/// Merges `border` (parsed for `property`, a `border-image` or `mask-border` property) into the
/// one the node keeps: a shorthand sets every part, a longhand its own.
effect fn assignBorder(effects: &mut Effects, property: CssProperty, border: Border) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let image = maskBorderOf(property) != property
  let field = maskBorderOf(property)
  let mut parsed = move border
  let zero = run dimensions.literal(&mut effects.numerics, 0.0, Unit.Number)
  let one = run dimensions.literal(&mut effects.numerics, 1.0, Unit.Number)
  let whole = run dimensions.literal(&mut effects.numerics, 100.0, Unit.Percent)
  let target = if image {
    run effects.borderImage.getOrMake(ImageBorder.make)
  } else {
    run effects.maskBorder.getOrMake(ImageBorder.make)
  }
  if !target.set {
    // The initial values: border-image slices at 100% one border width wide; mask-border at 0.
    target.set = true
    target.slice = if image { [whole; 4] } else { [zero; 4] }
    target.width = if image { [BorderMeasure.Numeric { value: one }; 4] } else { [BorderMeasure.Auto; 4] }
    target.outset = [zero; 4]
  }
  if field == CssProperty.MaskBorder {
    target.image = Intrinsic.replace(parsed.image, Image.None)
    target.mode = parsed.mode
    target.repeat = parsed.repeat
    target.fill = parsed.fill
    target.outset = parsed.outset
    // The shorthand's parser fills what it leaves out with mask-border's initial values.
    let defaultSlice = allZero(&effects.numerics, &parsed.slice)
    target.slice = if image && defaultSlice { [whole; 4] } else { parsed.slice }
    let defaultWidth = allAuto(&parsed.width)
    target.width = if image && defaultWidth { [BorderMeasure.Numeric { value: one }; 4] } else { parsed.width }
  } else if field == CssProperty.MaskBorderSource {
    target.image = Intrinsic.replace(parsed.image, Image.None)
  } else if field == CssProperty.MaskBorderSlice {
    target.slice = parsed.slice
    target.fill = parsed.fill
  } else if field == CssProperty.MaskBorderWidth {
    target.width = parsed.width
  } else if field == CssProperty.MaskBorderOutset {
    target.outset = parsed.outset
  } else if field == CssProperty.MaskBorderRepeat {
    target.repeat = parsed.repeat
  } else if field == CssProperty.MaskBorderMode {
    target.mode = parsed.mode
  }
}

fn allZero(store: &Store<'_>, values: &[ExprId; 4]) -> bool {
  let mut i: usize = 0
  while i < 4 {
    match dimensions.numberLiteral(store, values[i]) {
      Option<f64>.Some { value } => { if value != 0.0 { return false } }
      Option<f64>.None => { return false }
    }
    i = i + 1
  }
  return true
}

fn allAuto(values: &[BorderMeasure; 4]) -> bool {
  let mut i: usize = 0
  while i < 4 {
    match &values[i] {
      BorderMeasure.Auto => {}
      _ => { return false }
    }
    i = i + 1
  }
  return true
}

/// `shape-outside` takes `clip-path`'s shapes and boxes, with the margin box as the default
/// reference, or an image. `shape-margin` is one nonnegative length or percentage, and
/// `shape-image-threshold` one alpha value, clamped to 0 to 1.
effect fn applyShape(effects: &mut Effects, property: CssProperty, css: &[u8], source: &Input<'_>, cursor: &mut Cursor, context: &LengthContext) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if property == CssProperty.ShapeMargin {
    match run dimensions.parse(&mut effects.numerics, source, &mut cursor.*, Dimension.LengthPercentage, false) {
      Option<ExprId>.Some { value } => {
        if cursor.done(source) && !dimensions.negativeLiteral(&effects.numerics, value) {
          effects.shapeMargin = Option<ExprId>.some(run dimensions.compute(&mut effects.numerics, value, context))
        }
      }
      _ => {}
    }
    return
  }
  if property == CssProperty.ShapeImageThreshold {
    match run dimensions.parse(&mut effects.numerics, source, &mut cursor.*, Dimension.NumberPercentage, false) {
      Option<ExprId>.Some { value } => {
        if cursor.done(source) {
          let id = run dimensions.compute(&mut effects.numerics, value, context)
          effects.shapeThreshold = f32.min(1.0, f32.max(0.0, effects.number(id)))
        }
      }
      _ => {}
    }
    return
  }
  if cursor.ident(source, b"none") {
    if cursor.done(source) {
      effects.shape.clear()
      effects.shapeImage.clear()
    }
    return
  }
  // Colors only matter for their alpha, so `currentColor` computes as opaque black.
  let black = Color.srgb(0.0, 0.0, 0.0, 1.0)
  let colors = ColorContext.make(black, [black; 19])
  let start = cursor.*
  match run effect_values.parseImage(&mut effects.numerics, source, &mut cursor.*) {
    Option<Image>.Some { value } => {
      if cursor.done(source) {
        let image = run effect_values.computeImage(&value, &mut effects.numerics, context, &colors)
        effects.shape.clear()
        effects.shapeImage.clear()
        run effects.shapeImage.append(move image)
        return
      }
    }
    _ => {}
  }
  cursor.* = start
  let named = namesBox(css)
  let value = match run effect_values.parse(&mut effects.numerics, CssProperty.ClipPath, source, &mut cursor.*, false) {
    Option<EffectValue>.Some { value } => move value
    _ => {
      return
    }
  }
  if !cursor.done(source) {
    return
  }
  let computed = run effect_values.compute(&value, &mut effects.numerics, context, &colors)
  match move computed {
    EffectValue.ClipPath { source: clip } => {
      match &clip {
        ClipSource.Url { .. } => {
          return
        }
        _ => {}
      }
      effects.shape.clear()
      effects.shapeImage.clear()
      run effects.shape.append(move clip)
      effects.shapeBox = named
    }
    EffectValue other => {
      drop other
    }
  }
}

/// `offset-path`'s basic shapes and `path()`, read with `clip-path`'s grammar; a box alone, a
/// `ray()` and the rest leave none here (`transform.Offset` reads those).
effect fn applyOffsetPath(effects: &mut Effects, source: &Input<'_>, cursor: &mut Cursor, context: &LengthContext) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  effects.offset.clear()
  let value = match run effect_values.parse(&mut effects.numerics, CssProperty.ClipPath, source, &mut cursor.*, false) {
    Option<EffectValue>.Some { value } => move value
    _ => {
      return
    }
  }
  if !cursor.done(source) {
    return
  }
  let black = Color.srgb(0.0, 0.0, 0.0, 1.0)
  let colors = ColorContext.make(black, [black; 19])
  let computed = run effect_values.compute(&value, &mut effects.numerics, context, &colors)
  match move computed {
    EffectValue.ClipPath { source: clip } => {
      match &clip {
        ClipSource.Shape { .. } => {
          run effects.offset.append(move clip)
        }
        _ => {}
      }
    }
    EffectValue other => {
      drop other
    }
  }
}

/// Whether `css` names a reference box (`margin-box`, `border-box` and so on).
fn namesBox(css: &[u8]) -> bool {
  let mut i: usize = 0
  while i + 4 <= css.length {
    if css[i] == 45 && css[i + 1] == 98 && css[i + 2] == 111 && css[i + 3] == 120 { return true }
    i = i + 1
  }
  return false
}

/// Sets the longhand lists of `target` that `property` names from parsed `layers`.
effect fn assignLayers(target: &mut Layers, property: CssProperty, layers: List<MaskLayer>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let all = property == CssProperty.Mask
  let mut owned = move layers
  let items = owned.asSlice()
  if all || property == CssProperty.MaskPosition || property == CssProperty.BackgroundPosition {
    target.positions.clear()
    let mut i: usize = 0
    while i < items.length {
      run target.positions.append(items[i].position)
      i = i + 1
    }
  }
  if all || property == CssProperty.MaskSize || property == CssProperty.BackgroundSize {
    target.sizes.clear()
    let mut i: usize = 0
    while i < items.length {
      run target.sizes.append(items[i].size)
      i = i + 1
    }
  }
  if all || property == CssProperty.MaskRepeat || property == CssProperty.BackgroundRepeat {
    target.repeats.clear()
    let mut i: usize = 0
    while i < items.length {
      run target.repeats.append(items[i].repeat)
      i = i + 1
    }
  }
  if all || property == CssProperty.MaskOrigin || property == CssProperty.BackgroundOrigin {
    target.origins.clear()
    let mut i: usize = 0
    while i < items.length {
      run target.origins.append(items[i].origin)
      i = i + 1
    }
  }
  if all || property == CssProperty.MaskClip {
    target.clips.clear()
    let mut i: usize = 0
    while i < items.length {
      run target.clips.append(clipOfBox(items[i].clip))
      i = i + 1
    }
  }
  if all || property == CssProperty.MaskComposite {
    target.composites.clear()
    let mut i: usize = 0
    while i < items.length {
      run target.composites.append(items[i].composite)
      i = i + 1
    }
  }
  if all || property == CssProperty.MaskMode {
    target.modes.clear()
    let mut i: usize = 0
    while i < items.length {
      run target.modes.append(items[i].mode)
      i = i + 1
    }
  }
  if all || property == CssProperty.MaskImage {
    let mut reversed = List<Image>.make()
    while true {
      match owned.pop() {
        Option<MaskLayer>.Some { value } => {
          run reversed.append(move value.image)
        }
        Option<MaskLayer>.None => {
          break
        }
      }
    }
    target.images.clear()
    while true {
      match reversed.pop() {
        Option<Image>.Some { value } => {
          run target.images.append(move value)
        }
        Option<Image>.None => {
          break
        }
      }
    }
  }
}

fn clipOfBox(value: GeometryBox) -> Clip {
  return match value {
    GeometryBox.Content => Clip.Content
    GeometryBox.Padding => Clip.Padding
    _ => Clip.Border
  }
}

/// `background-image`: a comma-separated list of images or `none`.
effect fn applyImages(
  effects: &mut Effects,
  source: &Input<'_>,
  cursor: &mut Cursor,
  context: &LengthContext,
  colorContext: &ColorContext,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut images = List<Image>.make()
  while true {
    if cursor.ident(source, b"none") {
      run images.append(Image.None)
    } else {
      match run effect_values.parseImage(&mut effects.numerics, source, &mut cursor.*) {
        Option<Image>.Some { value } => {
          run images.append(
            run effect_values.computeImage(&value, &mut effects.numerics, context, colorContext),
          )
        }
        _ => {
          return
        }
      }
    }
    if !cursor.comma(source) {
      break
    }
  }
  if !cursor.done(source) {
    return
  }
  effects.backgrounds.images = move images
}

/// `background-clip`: boxes or `text`, comma separated.
/// `background-position-x` or `-y` (Backgrounds 4): a comma list of `[center | <edge>]?
/// <length-percentage>?` that replaces one axis of each layer's position, adding layers at
/// `0% 0%` when there are none.
effect fn applyAxis(
  effects: &mut Effects,
  horizontal: bool,
  source: &Input<'_>,
  cursor: &mut Cursor,
  context: &LengthContext,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut axes = List<PositionAxis>.make()
  while true {
    let mut edge = Edge.Start
    let mut named = true
    if cursor.ident(source, b"center") {
      edge = Edge.Center
    } else if cursor.ident(source, if horizontal { b"left" } else { b"top" }) {
      edge = Edge.Start
    } else if cursor.ident(source, if horizontal { b"right" } else { b"bottom" }) {
      edge = Edge.End
    } else {
      named = false
    }
    let offset = if edge == Edge.Center {
      Option<ExprId>.None
    } else {
      run dimensions.parse(&mut effects.numerics, source, &mut cursor.*, Dimension.LengthPercentage, false)
    }
    let value = match offset {
      Option<ExprId>.Some { value } => run dimensions.compute(&mut effects.numerics, value, context)
      _ => {
        if !named {
          return
        }
        run dimensions.literal(&mut effects.numerics, 0.0, Unit.Px)
      }
    }
    run axes.append(PositionAxis { edge: edge, offset: value })
    if !cursor.comma(source) {
      break
    }
  }
  if !cursor.done(source) {
    return
  }
  let items = axes.asSlice()
  let positions = &mut effects.backgrounds.positions
  let existing = positions.length()
  if existing == 0 {
    let zero = run dimensions.literal(&mut effects.numerics, 0.0, Unit.Percent)
    let start = PositionAxis { edge: Edge.Start, offset: zero }
    run positions.append(Position { x: start, y: start })
  }
  // Both lists repeat to the layer count, so the longer one sets it.
  let known = positions.length()
  while positions.length() < items.length {
    let repeated = positions.get(positions.length() % known)
    run positions.append(repeated)
  }
  let mut i: usize = 0
  while i < positions.length() {
    let mut position = positions.get(i)
    if horizontal {
      position.x = items[i % items.length]
    } else {
      position.y = items[i % items.length]
    }
    positions.set(i, position)
    i = i + 1
  }
}

effect fn applyClips(effects: &mut Effects, source: &Input<'_>, cursor: &mut Cursor) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut clips = List<Clip>.make()
  while true {
    if cursor.ident(source, b"border-box") {
      run clips.append(Clip.Border)
    } else if cursor.ident(source, b"padding-box") {
      run clips.append(Clip.Padding)
    } else if cursor.ident(source, b"content-box") {
      run clips.append(Clip.Content)
    } else if cursor.ident(source, b"text") {
      run clips.append(Clip.Text)
    } else {
      return
    }
    if !cursor.comma(source) {
      break
    }
  }
  if !cursor.done(source) {
    return
  }
  effects.backgrounds.clips = move clips
}

effect fn applyShadows(
  effects: &mut Effects,
  source: &Input<'_>,
  cursor: &mut Cursor,
  context: &LengthContext,
  colorContext: &ColorContext,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let value = match run text_values.parse(&mut effects.numerics, CssProperty.TextShadow, source, &mut cursor.*, false) {
    Option<text_values.TextValue>.Some { value } => move value
    _ => {
      return
    }
  }
  if !cursor.done(source) {
    return
  }
  let mut shadows = List<TextShadow>.make()
  let items = value.items.asSlice()
  let mut i: usize = 0
  while i < items.length {
    match items[i].atom {
      Atom.Shadow { x, y, blur, color } => {
        let cx = run dimensions.compute(&mut effects.numerics, x, context)
        let cy = run dimensions.compute(&mut effects.numerics, y, context)
        let cb = run dimensions.compute(&mut effects.numerics, blur, context)
        run shadows.append(
          TextShadow {
            x: effects.pixels(cx, 0.0),
            y: effects.pixels(cy, 0.0),
            blur: f32.max(0.0, effects.pixels(cb, 0.0)),
            color: colorOf(color, colorContext),
          },
        )
      }
      _ => {}
    }
    i = i + 1
  }
  effects.shadows = move shadows
  effects.hasShadows = true
}

/// Steps over one identifier.
fn anyIdent(source: &Input<'_>, cursor: &mut Cursor) -> bool {
  cursor.skip(source)
  if cursor.position >= cursor.end {
    return false
  }
  match source.at(cursor.position) {
    Option<TokenView>.Some { value } => {
      match &value.token.kind {
        Kind.Ident { .. } => {
          cursor.position = cursor.position + 1
          return true
        }
        _ => {}
      }
    }
    _ => {}
  }
  return false
}

/// `will-change`: `auto`, or a comma-separated list of property names. A property whose
/// non-initial value makes a stacking context makes one now, as in browsers.
fn applyWillChange(effects: &mut Effects, source: &Input<'_>, cursor: &mut Cursor) -> () {
  if cursor.ident(source, b"auto") {
    if cursor.done(source) {
      effects.stacks = false
    }
    return
  }
  let names: [&[u8]; 14] = [
    b"transform",
    b"translate",
    b"rotate",
    b"scale",
    b"perspective",
    b"opacity",
    b"filter",
    b"backdrop-filter",
    b"mix-blend-mode",
    b"isolation",
    b"clip-path",
    b"mask",
    b"mask-image",
    b"z-index",
  ]
  let mut stacks = false
  while true {
    let mut matched = false
    let mut i: usize = 0
    while i < names.length {
      if cursor.ident(source, names[i]) {
        matched = true
        stacks = true
        break
      }
      i = i + 1
    }
    if !matched && !anyIdent(source, &mut cursor.*) {
      return
    }
    if !cursor.comma(source) {
      break
    }
  }
  if cursor.done(source) {
    effects.stacks = stacks
  }
}

/// The `vector.layer` blend mode a `mix-blend-mode` keyword names, or 255.
fn blendOf(source: &Input<'_>, cursor: &mut Cursor) -> u8 {
  let names: [&[u8]; 16] = [
    b"normal",
    b"multiply",
    b"screen",
    b"overlay",
    b"darken",
    b"lighten",
    b"color-dodge",
    b"color-burn",
    b"hard-light",
    b"soft-light",
    b"difference",
    b"exclusion",
    b"hue",
    b"saturation",
    b"color",
    b"luminosity",
  ]
  let modes: [u8; 16] = [
    BLEND_NORMAL,
    BLEND_MULTIPLY,
    BLEND_SCREEN,
    BLEND_OVERLAY,
    BLEND_DARKEN,
    BLEND_LIGHTEN,
    BLEND_COLOR_DODGE,
    BLEND_COLOR_BURN,
    BLEND_HARD_LIGHT,
    BLEND_SOFT_LIGHT,
    BLEND_DIFFERENCE,
    BLEND_EXCLUSION,
    BLEND_HUE,
    BLEND_SATURATION,
    BLEND_COLOR,
    BLEND_LUMINOSITY,
  ]
  let mut i: usize = 0
  while i < 16 {
    if cursor.ident(source, names[i]) {
      return modes[i]
    }
    i = i + 1
  }
  return 255
}
