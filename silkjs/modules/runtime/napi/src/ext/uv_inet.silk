//! Text and binary forms of IPv4 and IPv6 socket addresses: libuv 1.51's uv_ip4_addr, uv_ip6_addr,
//! uv_ip4_name and uv_ip6_name (src/uv-common.c over src/inet.c), in Silk. The names, signatures
//! and statuses are libuv's, so the callers read as they did when these were C.
//!
//! An address is a `struct sockaddr_in` (16 bytes) or `struct sockaddr_in6` (28 bytes): the family
//! in the first two bytes (Darwin: a length byte, then a family byte), the port in network order at
//! offset 2, the IPv4 address at offset 4, the IPv6 address at offset 8 and its scope at offset 24.
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.usize

// UV_EINVAL and UV_ENOSPC: EINVAL is 22 and ENOSPC is 28 on both Linux and Darwin.
const INVALID: i32 = -22
const NO_SPACE: i32 = -28
// A text that is read to its terminating zero byte.
const UNBOUNDED: usize = 18446744073709551615

@foreign(noCapture: .("name"))
unsafe extern "C" fn if_nametoindex(name: *const u8) -> u32

unsafe fn byteAt(base: *const u8, index: usize) -> u8 {
  return unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(base), index))
}
unsafe fn setByte(base: *mut u8, index: usize, value: u8) -> () {
  unsafe Pointer.write<u8>(unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(base), index), value)
}
// The byte of a C string at `index`; the text ends at `limit` when no zero byte comes first.
unsafe fn textAt(text: *const u8, limit: usize, index: usize) -> u8 {
  if index >= limit { return 0 }
  return unsafe byteAt(text, index)
}

// inet_pton4: exactly four decimal octets, none with a leading zero, none above 255.
unsafe fn parse4(text: *const u8, limit: usize, start: usize, out: &mut [u8], at: usize) -> i32 {
  let mut tmp: [u8; 4] = [0; 4]
  let mut tp: usize = 0
  let mut sawDigit = false
  let mut octets: i32 = 0
  let mut i = start
  while true {
    let ch = unsafe textAt(text, limit, i)
    i = i + 1
    if ch == 0 { break }
    if ch >= 48 && ch <= 57 {
      let next = u8.toU32(tmp[tp]) * 10 + u8.toU32(ch - 48)
      if sawDigit && tmp[tp] == 0 { return INVALID }
      if next > 255 { return INVALID }
      tmp[tp] = u32.toU8(next)
      if !sawDigit {
        octets = octets + 1
        if octets > 4 { return INVALID }
        sawDigit = true
      }
    } else if ch == 46 && sawDigit {
      if octets == 4 { return INVALID }
      tp = tp + 1
      tmp[tp] = 0
      sawDigit = false
    } else { return INVALID }
  }
  if octets < 4 { return INVALID }
  let mut n: usize = 0
  while n < 4 { out[at + n] = tmp[n] n = n + 1 }
  return 0
}

// The value of a hexadecimal digit of either case, or 16.
fn hexValue(ch: u8) -> u32 {
  if ch >= 48 && ch <= 57 { return u8.toU32(ch - 48) }
  if ch >= 97 && ch <= 102 { return u8.toU32(ch - 87) }
  if ch >= 65 && ch <= 70 { return u8.toU32(ch - 55) }
  return 16
}

// inet_pton6: groups of up to four hexadecimal digits, one `::`, and an optional dotted IPv4 tail.
unsafe fn parse6(text: *const u8, limit: usize, out: &mut [u8; 16]) -> i32 {
  let mut tmp: [u8; 16] = [0; 16]
  let mut tp: usize = 0
  let mut colon: usize = 16
  let mut hasColon = false
  let mut i: usize = 0
  // A leading `::` needs both colons.
  if unsafe textAt(text, limit, 0) == 58 {
    i = 1
    if unsafe textAt(text, limit, 1) != 58 { return INVALID }
  }
  let mut token = i
  let mut seen: i32 = 0
  let mut value: u32 = 0
  while true {
    let ch = unsafe textAt(text, limit, i)
    i = i + 1
    if ch == 0 { break }
    let digit = hexValue(ch)
    if digit < 16 {
      value = u32.shiftLeft(value, 4) | digit
      seen = seen + 1
      if seen > 4 { return INVALID }
      continue
    }
    if ch == 58 {
      token = i
      if seen == 0 {
        if hasColon { return INVALID }
        hasColon = true
        colon = tp
        continue
      } else if unsafe textAt(text, limit, i) == 0 { return INVALID }
      if tp + 2 > 16 { return INVALID }
      tmp[tp] = u32.toU8(u32.shiftRight(value, 8) & 255)
      tmp[tp + 1] = u32.toU8(value & 255)
      tp = tp + 2
      seen = 0
      value = 0
      continue
    }
    if ch == 46 && tp + 4 <= 16 {
      if unsafe parse4(text, limit, token, &mut tmp, tp) == 0 {
        tp = tp + 4
        seen = 0
        break
      }
    }
    return INVALID
  }
  if seen != 0 {
    if tp + 2 > 16 { return INVALID }
    tmp[tp] = u32.toU8(u32.shiftRight(value, 8) & 255)
    tmp[tp + 1] = u32.toU8(value & 255)
    tp = tp + 2
  }
  if hasColon {
    // Move what follows the `::` to the end; the gap is the run of zero groups.
    let n = tp - colon
    if tp == 16 { return INVALID }
    let mut k: usize = 1
    while k <= n {
      tmp[16 - k] = tmp[colon + n - k]
      tmp[colon + n - k] = 0
      k = k + 1
    }
    tp = 16
  }
  if tp != 16 { return INVALID }
  out.* = tmp
  return 0
}

// Appends `value` in decimal at `at` and returns the offset after it.
fn writeDecimal(out: &mut [u8], at: usize, value: u32) -> usize {
  let mut digits: [u8; 10] = [0; 10]
  let mut used: usize = 0
  let mut rest = value
  while true {
    digits[used] = u32.toU8(48 + rest % 10)
    used = used + 1
    rest = rest / 10
    if rest == 0 { break }
  }
  let mut n = at
  while used > 0 { used = used - 1 out[n] = digits[used] n = n + 1 }
  return n
}

// Appends `value` in lowercase hexadecimal without leading zeros, as printf's %x.
fn writeHex(out: &mut [u8], at: usize, value: u32) -> usize {
  let digits = b"0123456789abcdef"
  let mut shift: u32 = 12
  let mut n = at
  let mut started = false
  while true {
    let nibble = u32.shiftRight(value, shift) & 15
    if nibble != 0 || started || shift == 0 { out[n] = digits[u32.toUsize(nibble)] n = n + 1 started = true }
    if shift == 0 { break }
    shift = shift - 4
  }
  return n
}

// Writes the dotted form of the four bytes at `source` + `offset`, and returns the offset after it.
unsafe fn format4(source: *const u8, offset: usize, out: &mut [u8], at: usize) -> usize {
  let mut n = at
  let mut k: usize = 0
  while k < 4 {
    if k > 0 { out[n] = 46 n = n + 1 }
    n = writeDecimal(&mut out, n, u8.toU32(unsafe byteAt(source, offset + k)))
    k = k + 1
  }
  return n
}

// uv__strscpy of a text that is known to fit with its zero byte.
unsafe fn copyOut(tmp: &[u8], length: usize, out: *mut u8) -> () {
  let mut n: usize = 0
  while n < length { unsafe setByte(out, n, tmp[n]) n = n + 1 }
  unsafe setByte(out, length, 0)
}

// inet_ntop4 of the four bytes at `source` + `offset`. UV_ENOSPC when the text and its zero byte
// do not fit in `size`.
unsafe fn name4(source: *const u8, offset: usize, out: *mut u8, size: usize) -> i32 {
  let mut tmp: [u8; 16] = [0; 16]
  let length = unsafe format4(source, offset, &mut tmp, 0)
  if length >= size { return NO_SPACE }
  unsafe copyOut(&tmp, length, out)
  return 0
}

// inet_ntop6 of the sixteen bytes at `source` + `offset`: the longest run of two or more zero
// groups becomes `::`, and the IPv4-compatible and IPv4-mapped forms end in dotted decimal.
unsafe fn name6(source: *const u8, offset: usize, out: *mut u8, size: usize) -> i32 {
  let mut tmp: [u8; 46] = [0; 46]
  let mut words: [u32; 8] = [0; 8]
  let mut i: usize = 0
  while i < 8 {
    words[i] = u32.shiftLeft(u8.toU32(unsafe byteAt(source, offset + i * 2)), 8) | u8.toU32(unsafe byteAt(source, offset + i * 2 + 1))
    i = i + 1
  }
  // A base of 8 means no run.
  let mut bestBase: usize = 8
  let mut bestLength: usize = 0
  let mut curBase: usize = 8
  let mut curLength: usize = 0
  i = 0
  while i < 8 {
    if words[i] == 0 {
      if curBase == 8 { curBase = i curLength = 1 } else { curLength = curLength + 1 }
    } else if curBase != 8 {
      if bestBase == 8 || curLength > bestLength { bestBase = curBase bestLength = curLength }
      curBase = 8
    }
    i = i + 1
  }
  if curBase != 8 && (bestBase == 8 || curLength > bestLength) { bestBase = curBase bestLength = curLength }
  if bestBase != 8 && bestLength < 2 { bestBase = 8 }
  let mut tp: usize = 0
  i = 0
  while i < 8 {
    if bestBase != 8 && i >= bestBase && i < bestBase + bestLength {
      if i == bestBase { tmp[tp] = 58 tp = tp + 1 }
      i = i + 1
      continue
    }
    if i != 0 { tmp[tp] = 58 tp = tp + 1 }
    if i == 6 && bestBase == 0 && (bestLength == 6 || (bestLength == 7 && words[7] != 1) || (bestLength == 5 && words[5] == 65535)) {
      tp = unsafe format4(source, offset + 12, &mut tmp, tp)
      break
    }
    tp = writeHex(&mut tmp, tp, words[i])
    i = i + 1
  }
  if bestBase != 8 && bestBase + bestLength == 8 { tmp[tp] = 58 tp = tp + 1 }
  // libuv counts the zero byte here.
  if tp + 1 > size { return NO_SPACE }
  unsafe copyOut(&tmp, tp, out)
  return 0
}

// The family and port of a zeroed socket address of `length` bytes.
unsafe fn start(address: *mut u8, length: usize, family: u8, port: i32) -> () {
  let mut n: usize = 0
  while n < length { unsafe setByte(address, n, 0) n = n + 1 }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe setByte(address, 0, usize.toU8(length))
    unsafe setByte(address, 1, family)
  } else {
    unsafe setByte(address, 0, family)
  }
  // htons((uint16_t) port).
  let low = i32.wrappingToU32(port) & 65535
  unsafe setByte(address, 2, u32.toU8(u32.shiftRight(low, 8)))
  unsafe setByte(address, 3, u32.toU8(low & 255))
}

/// Fills the `struct sockaddr_in` at `address` from dotted decimal `text` and `port`. Returns 0, or
/// UV_EINVAL when the text is not an IPv4 address; the family and port are set either way.
pub unsafe fn uv_ip4_addr(text: *const u8, port: i32, address: *mut u8) -> i32 {
  unsafe start(address, 16, 2, port)
  let mut parsed: [u8; 4] = [0; 4]
  let status = unsafe parse4(text, UNBOUNDED, 0, &mut parsed, 0)
  if status != 0 { return status }
  let mut n: usize = 0
  while n < 4 { unsafe setByte(address, 4 + n, parsed[n]) n = n + 1 }
  return 0
}

/// Fills the `struct sockaddr_in6` at `address` from `text` and `port`. A `%zone` suffix names an
/// interface, whose index becomes the scope (0 when there is no such interface); at most 39 bytes
/// before the `%` are parsed. Returns 0, or UV_EINVAL when the text is not an IPv6 address; the
/// family, port and scope are set either way.
pub unsafe fn uv_ip6_addr(text: *const u8, port: i32, address: *mut u8) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { unsafe start(address, 28, 30, port) } else { unsafe start(address, 28, 10, port) }
  let mut limit = UNBOUNDED
  let mut n: usize = 0
  while true {
    let ch = unsafe byteAt(text, n)
    if ch == 0 { break }
    if ch == 37 {
      limit = n
      if limit > 39 { limit = 39 }
      let zone = unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(text), n + 1)
      let scope = unsafe if_nametoindex(zone)
      // The scope is kept in host order.
      let mut k: usize = 0
      while k < 4 { unsafe setByte(address, 24 + k, u32.toU8(u32.shiftRight(scope, usize.toU32(k) * 8) & 255)) k = k + 1 }
      break
    }
    n = n + 1
  }
  let mut parsed: [u8; 16] = [0; 16]
  let status = unsafe parse6(text, limit, &mut parsed)
  if status != 0 { return status }
  n = 0
  while n < 16 { unsafe setByte(address, 8 + n, parsed[n]) n = n + 1 }
  return 0
}

/// Writes the dotted decimal form of the `struct sockaddr_in` at `address` to `text`, which holds
/// `size` bytes. Returns 0, or UV_ENOSPC when the form and its zero byte do not fit.
pub unsafe fn uv_ip4_name(address: *const u8, text: *mut u8, size: usize) -> i32 {
  return unsafe name4(address, 4, text, size)
}

/// Writes the text form of the `struct sockaddr_in6` at `address` to `text`, which holds `size`
/// bytes. The scope is not written. Returns 0, or UV_ENOSPC when the form and its zero byte do not fit.
pub unsafe fn uv_ip6_name(address: *const u8, text: *mut u8, size: usize) -> i32 {
  return unsafe name6(address, 8, text, size)
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  const FAMILY6: i32 = 30
  // UV_EAFNOSUPPORT.
  const NO_FAMILY: i32 = -47
} else {
  const FAMILY6: i32 = 10
  const NO_FAMILY: i32 = -97
}
const FAMILY4: i32 = 2

/// Writes the text form of the IPv4 (`af` AF_INET, 4 bytes) or IPv6 (AF_INET6, 16 bytes) address
/// at `source` to `text`, which holds `size` bytes. Returns 0, UV_ENOSPC when the form and its zero
/// byte do not fit, or UV_EAFNOSUPPORT for another family.
pub unsafe fn uv_inet_ntop(af: i32, source: *const u8, text: *mut u8, size: usize) -> i32 {
  if af == FAMILY4 { return unsafe name4(source, 0, text, size) }
  if af == FAMILY6 { return unsafe name6(source, 0, text, size) }
  return NO_FAMILY
}

/// Parses the text form of an IPv4 (`af` AF_INET) or IPv6 (AF_INET6) address into the 4 or 16
/// bytes at `destination`, which are written only on success. An IPv6 text may end in a `%zone`,
/// which is ignored when at most 45 bytes come before it and is UV_EINVAL otherwise. Returns 0,
/// UV_EINVAL for a null argument or a text that is not an address, or UV_EAFNOSUPPORT.
pub unsafe fn uv_inet_pton(af: i32, text: ?*const u8, destination: ?*mut u8) -> i32 {
  if Pointer.isNull<u8>(text) || Pointer.isNull<u8>(destination) { return INVALID }
  let source = unsafe Intrinsic.pointerRequalify<?*const u8, *const u8>(text)
  let out = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(destination)
  if af == FAMILY4 {
    let mut parsed: [u8; 4] = [0; 4]
    let status = unsafe parse4(source, UNBOUNDED, 0, &mut parsed, 0)
    if status != 0 { return status }
    let mut n: usize = 0
    while n < 4 { unsafe setByte(out, n, parsed[n]) n = n + 1 }
    return 0
  }
  if af == FAMILY6 {
    let mut limit = UNBOUNDED
    let mut n: usize = 0
    while true {
      let ch = unsafe byteAt(source, n)
      if ch == 0 { break }
      if ch == 37 {
        if n > 45 { return INVALID }
        limit = n
        break
      }
      n = n + 1
    }
    let mut parsed: [u8; 16] = [0; 16]
    let status = unsafe parse6(source, limit, &mut parsed)
    if status != 0 { return status }
    n = 0
    while n < 16 { unsafe setByte(out, n, parsed[n]) n = n + 1 }
    return 0
  }
  return NO_FAMILY
}
