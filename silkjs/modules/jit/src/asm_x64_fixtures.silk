  run Testing.expect(emitted(&a, &mut at, b"\x49\x8b\x45\x08"), "mov rax, qword ptr [r13 + 8]")
  run a.load(Width.W64, Reg.Rdi, Mem.at(Reg.R14, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x49\x8b\x3e"), "mov rdi, qword ptr [r14]")
  run a.load(Width.W64, Reg.R14, Mem.at(Reg.R14, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x8b\x76\x08"), "mov r14, qword ptr [r14 + 8]")
  run a.load(Width.W64, Reg.Rbp, Mem.at(Reg.R15, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x49\x8b\x2f"), "mov rbp, qword ptr [r15]")
  run a.load(Width.W64, Reg.R12, Mem.at(Reg.R15, 8))
  run Testing.expect(emitted(&a, &mut at, b"\x4d\x8b\x67\x08"), "mov r12, qword ptr [r15 + 8]")
  run a.load(Width.W64, Reg.Rbx, Mem.at(Reg.Rax, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x8b\x58\x7f"), "mov rbx, qword ptr [rax + 127]")
  run a.load(Width.W64, Reg.R10, Mem.at(Reg.Rax, 128))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\x90\x80\x00\x00\x00"), "mov r10, qword ptr [rax + 128]")
  run a.load(Width.W64, Reg.Rcx, Mem.at(Reg.Rax, -128))
  run Testing.expect(emitted(&a, &mut at, b"\x48\x8b\x48\x80"), "mov rcx, qword ptr [rax - 128]")
  run a.load(Width.W64, Reg.R8, Mem.at(Reg.Rax, -129))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\x80\x7f\xff\xff\xff"), "mov r8, qword ptr [rax - 129]")
  run a.load(Width.W64, Reg.R15, Mem.at(Reg.Rax, 305419896))
  run Testing.expect(emitted(&a, &mut at, b"\x4c\x8b\xb8\x78\x56\x34\x12"), "mov r15, qword ptr [rax + 305419896]")
  run a.load(Width.W64, Reg.Rsi, Mem.at(Reg.Rax, -2147483648))
