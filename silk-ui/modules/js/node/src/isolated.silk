//! Helper for spawning an isolated secondary Document Thread group.
//!
//! Launches a dedicated [`SecondaryGroupHandle`] under `GroupKind.Document` with its own
//! `Waiter`, compositor channel, GPU handle, platform client, and worker pool handles.
import ui_tree_window.compositor_thread { GroupKind, GroupServices }
import ui_tree_window.group_host { SecondaryGroupContext, SecondaryGroupHandle, spawnGroupThread }
import silk.concurrency.thread { Transferable }
import silk.core.option { Option }
import silk.mem.allocator { OutOfMemoryError }

/// Spawns an isolated secondary Document Thread (`GroupKind.Document`) running `body` with
/// the compositor, GPU, platform, and pool handles from `services`. Returns `None` on
/// `wasm32`, if services are incomplete, or if thread creation fails.
pub effect fn spawnIsolatedDocument<
  F: 'static + once fn(SecondaryGroupContext) -> i32 + Intrinsic.Detached + Transferable
>(
  groupId: u32,
  services: GroupServices,
  body: F,
) -> Option<SecondaryGroupHandle>
  ! OutOfMemoryError {
  return run spawnGroupThread(groupId, GroupKind.Document, move services, move body)
}
