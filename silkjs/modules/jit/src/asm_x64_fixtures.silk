  run a.scalar(ScalarOp.Max, Xmm.Xmm7, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x5f\xf8"), "maxsd xmm7, xmm0")
  run a.scalar(ScalarOp.Max, Xmm.Xmm8, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x45\x0f\x5f\xc7"), "maxsd xmm8, xmm15")
  run a.scalar(ScalarOp.Max, Xmm.Xmm15, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x45\x0f\x5f\xf8"), "maxsd xmm15, xmm8")
  run a.scalarLoad(ScalarOp.Max, Xmm.Xmm2, Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x5f\x10"), "maxsd xmm2, qword ptr [rax]")
  run a.scalarLoad(ScalarOp.Max, Xmm.Xmm7, Mem.at(Reg.R12, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x5f\x3c\x24"), "maxsd xmm7, qword ptr [r12]")
  run a.scalarLoad(ScalarOp.Max, Xmm.Xmm12, Mem.at(Reg.Rsp, 128))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x5f\xa4\x24\x80\x00\x00\x00"), "maxsd xmm12, qword ptr [rsp + 128]")
  run a.scalarLoad(ScalarOp.Max, Xmm.Xmm1, Mem.at(Reg.R13, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x5f\x8d\x00\x00\x00\x80"), "maxsd xmm1, qword ptr [r13 - 2147483648]")
  run a.scalarLoad(ScalarOp.Max, Xmm.Xmm6, Mem.indexed(Reg.R12, Reg.R13, Scale.Eight, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x43\x0f\x5f\x34\xec"), "maxsd xmm6, qword ptr [r12 + r13*8]")
  run a.packed(PackedOp.Movapd, Xmm.Xmm0, Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x28\xc1"), "movapd xmm0, xmm1")
  run a.packed(PackedOp.Movapd, Xmm.Xmm1, Xmm.Xmm9)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x41\x0f\x28\xc9"), "movapd xmm1, xmm9")
  run a.packed(PackedOp.Movapd, Xmm.Xmm7, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x28\xf8"), "movapd xmm7, xmm0")
  run a.packed(PackedOp.Movapd, Xmm.Xmm8, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x28\xc7"), "movapd xmm8, xmm15")
  run a.packed(PackedOp.Movapd, Xmm.Xmm15, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x28\xf8"), "movapd xmm15, xmm8")
  run a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x2e\xc1"), "ucomisd xmm0, xmm1")
  run a.packed(PackedOp.Ucomisd, Xmm.Xmm1, Xmm.Xmm9)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x41\x0f\x2e\xc9"), "ucomisd xmm1, xmm9")
  run a.packed(PackedOp.Ucomisd, Xmm.Xmm7, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x2e\xf8"), "ucomisd xmm7, xmm0")
  run a.packed(PackedOp.Ucomisd, Xmm.Xmm8, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x2e\xc7"), "ucomisd xmm8, xmm15")
  run a.packed(PackedOp.Ucomisd, Xmm.Xmm15, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x2e\xf8"), "ucomisd xmm15, xmm8")
  run a.packed(PackedOp.Andpd, Xmm.Xmm0, Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x54\xc1"), "andpd xmm0, xmm1")
  run a.packed(PackedOp.Andpd, Xmm.Xmm1, Xmm.Xmm9)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x41\x0f\x54\xc9"), "andpd xmm1, xmm9")
  run a.packed(PackedOp.Andpd, Xmm.Xmm7, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x54\xf8"), "andpd xmm7, xmm0")
  run a.packed(PackedOp.Andpd, Xmm.Xmm8, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x54\xc7"), "andpd xmm8, xmm15")
  run a.packed(PackedOp.Andpd, Xmm.Xmm15, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x54\xf8"), "andpd xmm15, xmm8")
  run a.packed(PackedOp.Andnpd, Xmm.Xmm0, Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x55\xc1"), "andnpd xmm0, xmm1")
  run a.packed(PackedOp.Andnpd, Xmm.Xmm1, Xmm.Xmm9)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x41\x0f\x55\xc9"), "andnpd xmm1, xmm9")
  run a.packed(PackedOp.Andnpd, Xmm.Xmm7, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x55\xf8"), "andnpd xmm7, xmm0")
  run a.packed(PackedOp.Andnpd, Xmm.Xmm8, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x55\xc7"), "andnpd xmm8, xmm15")
  run a.packed(PackedOp.Andnpd, Xmm.Xmm15, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x55\xf8"), "andnpd xmm15, xmm8")
  run a.packed(PackedOp.Orpd, Xmm.Xmm0, Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x56\xc1"), "orpd xmm0, xmm1")
  run a.packed(PackedOp.Orpd, Xmm.Xmm1, Xmm.Xmm9)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x41\x0f\x56\xc9"), "orpd xmm1, xmm9")
  run a.packed(PackedOp.Orpd, Xmm.Xmm7, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x56\xf8"), "orpd xmm7, xmm0")
  run a.packed(PackedOp.Orpd, Xmm.Xmm8, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x56\xc7"), "orpd xmm8, xmm15")
  run a.packed(PackedOp.Orpd, Xmm.Xmm15, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x56\xf8"), "orpd xmm15, xmm8")
  run a.packed(PackedOp.Xorpd, Xmm.Xmm0, Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x57\xc1"), "xorpd xmm0, xmm1")
  run a.packed(PackedOp.Xorpd, Xmm.Xmm1, Xmm.Xmm9)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x41\x0f\x57\xc9"), "xorpd xmm1, xmm9")
  run a.packed(PackedOp.Xorpd, Xmm.Xmm7, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x0f\x57\xf8"), "xorpd xmm7, xmm0")
  run a.packed(PackedOp.Xorpd, Xmm.Xmm8, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x57\xc7"), "xorpd xmm8, xmm15")
  run a.packed(PackedOp.Xorpd, Xmm.Xmm15, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x45\x0f\x57\xf8"), "xorpd xmm15, xmm8")
  run a.intToDouble(Width.W64, Xmm.Xmm0, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x48\x0f\x2a\xc0"), "cvtsi2sd xmm0, rax")
  run a.doubleToInt(Width.W64, Reg.Rax, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x48\x0f\x2c\xc0"), "cvttsd2si rax, xmm0")
  run a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x2a\xc0"), "cvtsi2sd xmm0, eax")
  run a.doubleToInt(Width.W32, Reg.Rax, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x2c\xc0"), "cvttsd2si eax, xmm0")
  run a.bitsToDouble(Xmm.Xmm0, Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x48\x0f\x6e\xc0"), "movq xmm0, rax")
  run a.doubleToBits(Reg.Rax, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x48\x0f\x7e\xc0"), "movq rax, xmm0")
  run a.intToDouble(Width.W64, Xmm.Xmm1, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x49\x0f\x2a\xc9"), "cvtsi2sd xmm1, r9")
  run a.doubleToInt(Width.W64, Reg.R9, Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x4c\x0f\x2c\xc9"), "cvttsd2si r9, xmm1")
  run a.intToDouble(Width.W32, Xmm.Xmm1, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x2a\xc9"), "cvtsi2sd xmm1, r9d")
  run a.doubleToInt(Width.W32, Reg.R9, Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x2c\xc9"), "cvttsd2si r9d, xmm1")
  run a.bitsToDouble(Xmm.Xmm1, Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x49\x0f\x6e\xc9"), "movq xmm1, r9")
  run a.doubleToBits(Reg.R9, Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x49\x0f\x7e\xc9"), "movq r9, xmm1")
  run a.intToDouble(Width.W64, Xmm.Xmm7, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x48\x0f\x2a\xfc"), "cvtsi2sd xmm7, rsp")
  run a.doubleToInt(Width.W64, Reg.Rsp, Xmm.Xmm7)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x48\x0f\x2c\xe7"), "cvttsd2si rsp, xmm7")
  run a.intToDouble(Width.W32, Xmm.Xmm7, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x2a\xfc"), "cvtsi2sd xmm7, esp")
  run a.doubleToInt(Width.W32, Reg.Rsp, Xmm.Xmm7)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x2c\xe7"), "cvttsd2si esp, xmm7")
  run a.bitsToDouble(Xmm.Xmm7, Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x48\x0f\x6e\xfc"), "movq xmm7, rsp")
  run a.doubleToBits(Reg.Rsp, Xmm.Xmm7)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x48\x0f\x7e\xfc"), "movq rsp, xmm7")
  run a.intToDouble(Width.W64, Xmm.Xmm8, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x4d\x0f\x2a\xc5"), "cvtsi2sd xmm8, r13")
  run a.doubleToInt(Width.W64, Reg.R13, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x4d\x0f\x2c\xe8"), "cvttsd2si r13, xmm8")
  run a.intToDouble(Width.W32, Xmm.Xmm8, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x45\x0f\x2a\xc5"), "cvtsi2sd xmm8, r13d")
  run a.doubleToInt(Width.W32, Reg.R13, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x45\x0f\x2c\xe8"), "cvttsd2si r13d, xmm8")
  run a.bitsToDouble(Xmm.Xmm8, Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x4d\x0f\x6e\xc5"), "movq xmm8, r13")
  run a.doubleToBits(Reg.R13, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x4d\x0f\x7e\xc5"), "movq r13, xmm8")
  run a.intToDouble(Width.W64, Xmm.Xmm15, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x4c\x0f\x2a\xff"), "cvtsi2sd xmm15, rdi")
  run a.doubleToInt(Width.W64, Reg.Rdi, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x49\x0f\x2c\xff"), "cvttsd2si rdi, xmm15")
  run a.intToDouble(Width.W32, Xmm.Xmm15, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x44\x0f\x2a\xff"), "cvtsi2sd xmm15, edi")
  run a.doubleToInt(Width.W32, Reg.Rdi, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x2c\xff"), "cvttsd2si edi, xmm15")
  run a.bitsToDouble(Xmm.Xmm15, Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x4c\x0f\x6e\xff"), "movq xmm15, rdi")
  run a.doubleToBits(Reg.Rdi, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\x66\x4c\x0f\x7e\xff"), "movq rdi, xmm15")
  run a.doubleToFloat(Xmm.Xmm0, Xmm.Xmm1)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x5a\xc1"), "cvtsd2ss xmm0, xmm1")
  run a.doubleToFloat(Xmm.Xmm1, Xmm.Xmm9)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x41\x0f\x5a\xc9"), "cvtsd2ss xmm1, xmm9")
  run a.doubleToFloat(Xmm.Xmm7, Xmm.Xmm0)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x0f\x5a\xf8"), "cvtsd2ss xmm7, xmm0")
  run a.doubleToFloat(Xmm.Xmm8, Xmm.Xmm15)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x45\x0f\x5a\xc7"), "cvtsd2ss xmm8, xmm15")
  run a.doubleToFloat(Xmm.Xmm15, Xmm.Xmm8)
  run Testing.expect(emitted(&a, &mut at, b"\xf2\x45\x0f\x5a\xf8"), "cvtsd2ss xmm15, xmm8")
}

test effect fn doublesMatchLlvm() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut a = Assembler.make()
  run doublesCases(&mut a) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn controlCases(a: &mut Assembler) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut at: usize = 0
  run a.jmpReg(Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xe0"), "jmp rax")
  run a.callReg(Reg.Rax)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xd0"), "call rax")
  run a.jmpReg(Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xe1"), "jmp rcx")
  run a.callReg(Reg.Rcx)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xd1"), "call rcx")
  run a.jmpReg(Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xe2"), "jmp rdx")
  run a.callReg(Reg.Rdx)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xd2"), "call rdx")
  run a.jmpReg(Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xe3"), "jmp rbx")
  run a.callReg(Reg.Rbx)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xd3"), "call rbx")
  run a.jmpReg(Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xe4"), "jmp rsp")
  run a.callReg(Reg.Rsp)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xd4"), "call rsp")
  run a.jmpReg(Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xe5"), "jmp rbp")
  run a.callReg(Reg.Rbp)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xd5"), "call rbp")
  run a.jmpReg(Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xe6"), "jmp rsi")
  run a.callReg(Reg.Rsi)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xd6"), "call rsi")
  run a.jmpReg(Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xe7"), "jmp rdi")
  run a.callReg(Reg.Rdi)
  run Testing.expect(emitted(&a, &mut at, b"\xff\xd7"), "call rdi")
  run a.jmpReg(Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xe0"), "jmp r8")
  run a.callReg(Reg.R8)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xd0"), "call r8")
  run a.jmpReg(Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xe1"), "jmp r9")
  run a.callReg(Reg.R9)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xd1"), "call r9")
  run a.jmpReg(Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xe2"), "jmp r10")
  run a.callReg(Reg.R10)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xd2"), "call r10")
  run a.jmpReg(Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xe3"), "jmp r11")
  run a.callReg(Reg.R11)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xd3"), "call r11")
  run a.jmpReg(Reg.R12)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xe4"), "jmp r12")
  run a.callReg(Reg.R12)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xd4"), "call r12")
  run a.jmpReg(Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xe5"), "jmp r13")
  run a.callReg(Reg.R13)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xd5"), "call r13")
  run a.jmpReg(Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xe6"), "jmp r14")
  run a.callReg(Reg.R14)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xd6"), "call r14")
  run a.jmpReg(Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xe7"), "jmp r15")
  run a.callReg(Reg.R15)
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xd7"), "call r15")
  run a.callMem(Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xff\x10"), "call qword ptr [rax]")
  run a.jmpMem(Mem.at(Reg.Rax, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xff\x20"), "jmp qword ptr [rax]")
  run a.callMem(Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xff\x55\x00"), "call qword ptr [rbp]")
  run a.jmpMem(Mem.at(Reg.Rbp, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xff\x65\x00"), "jmp qword ptr [rbp]")
  run a.callMem(Mem.at(Reg.R12, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\x14\x24"), "call qword ptr [r12]")
  run a.jmpMem(Mem.at(Reg.R12, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\x24\x24"), "jmp qword ptr [r12]")
  run a.callMem(Mem.at(Reg.Rax, 127))
  run Testing.expect(emitted(&a, &mut at, b"\xff\x50\x7f"), "call qword ptr [rax + 127]")
  run a.jmpMem(Mem.at(Reg.Rax, 127))
  run Testing.expect(emitted(&a, &mut at, b"\xff\x60\x7f"), "jmp qword ptr [rax + 127]")
  run a.callMem(Mem.at(Reg.Rsp, 128))
  run Testing.expect(emitted(&a, &mut at, b"\xff\x94\x24\x80\x00\x00\x00"), "call qword ptr [rsp + 128]")
  run a.jmpMem(Mem.at(Reg.Rsp, 128))
  run Testing.expect(emitted(&a, &mut at, b"\xff\xa4\x24\x80\x00\x00\x00"), "jmp qword ptr [rsp + 128]")
  run a.callMem(Mem.at(Reg.R12, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\x54\x24\x7f"), "call qword ptr [r12 + 127]")
  run a.jmpMem(Mem.at(Reg.R12, 127))
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\x64\x24\x7f"), "jmp qword ptr [r12 + 127]")
  run a.callMem(Mem.at(Reg.R13, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\x95\x00\x00\x00\x80"), "call qword ptr [r13 - 2147483648]")
  run a.jmpMem(Mem.at(Reg.R13, -2147483648))
  run Testing.expect(emitted(&a, &mut at, b"\x41\xff\xa5\x00\x00\x00\x80"), "jmp qword ptr [r13 - 2147483648]")
  run a.callMem(Mem.indexed(Reg.Rsp, Reg.Rax, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xff\x14\x44"), "call qword ptr [rsp + rax*2]")
  run a.jmpMem(Mem.indexed(Reg.Rsp, Reg.Rax, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\xff\x24\x44"), "jmp qword ptr [rsp + rax*2]")
  run a.callMem(Mem.indexed(Reg.R12, Reg.R13, Scale.Eight, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x43\xff\x14\xec"), "call qword ptr [r12 + r13*8]")
  run a.jmpMem(Mem.indexed(Reg.R12, Reg.R13, Scale.Eight, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x43\xff\x24\xec"), "jmp qword ptr [r12 + r13*8]")
  run a.callMem(Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x42\xff\x14\x7f"), "call qword ptr [rdi + r15*2]")
  run a.jmpMem(Mem.indexed(Reg.Rdi, Reg.R15, Scale.Two, 0))
  run Testing.expect(emitted(&a, &mut at, b"\x42\xff\x24\x7f"), "jmp qword ptr [rdi + r15*2]")
  run a.ret()
  run Testing.expect(emitted(&a, &mut at, b"\xc3"), "ret")
  run a.int3()
  run Testing.expect(emitted(&a, &mut at, b"\xcc"), "int3")
  run a.ud2()
  run Testing.expect(emitted(&a, &mut at, b"\x0f\x0b"), "ud2")
  run a.nop()
  run Testing.expect(emitted(&a, &mut at, b"\x90"), "nop")
}

test effect fn controlMatchLlvm() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut a = Assembler.make()
  run controlCases(&mut a) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nops(a: &mut Assembler, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut index: usize = 0
  while index < count { run a.nop() index = index + 1 }
}

effect fn nearRefsProgram() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  let mut labels = List<Label>.make()
  while labels.length() < 2 { let label = run a.label() run labels.append(label) }
  a.bind(labels.get(0))
  run a.jcc(Cond.Equal, labels.get(1))
  run a.jmp(labels.get(0))
  run a.call(labels.get(1))
  run a.leaLabel(Reg.R9, labels.get(0))
  a.bind(labels.get(1))
  run a.ret()
  return run a.finish()
}

test effect fn nearRefsMatchesLlvm() -> () ! OutOfMemoryError | UnboundLabelError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let code = run nearRefsProgram() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(sameBytes(code.bytes.asSlice(), b"\x74\x0e\xeb\xfc\xe8\x07\x00\x00\x00\x4c\x8d\x0d\xf0\xff\xff\xff\xc3"), "nearRefs: the bytes llvm-mc assembles")
}

effect fn forwardEdgeProgram() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  let mut labels = List<Label>.make()
  while labels.length() < 2 { let label = run a.label() run labels.append(label) }
  run a.jmp(labels.get(0))
  run nops(&mut a, 127)
  a.bind(labels.get(0))
  run a.jcc(Cond.Below, labels.get(1))
  run nops(&mut a, 128)
  a.bind(labels.get(1))
  run a.ret()
  return run a.finish()
}

