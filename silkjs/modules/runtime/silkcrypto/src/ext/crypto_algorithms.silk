  if !unsafe reserve(&mut c.*, 32) { return false }
  c.length = 0
  let slot = Pointer.fromMutRef<CipherState>(&mut x.state)
  let state = unsafe Pointer.take<CipherState>(slot)
  unsafe Pointer.put<CipherState>(slot, CipherState.Done)
