//! Which printable ASCII characters a shape plan can shape word by word: a line made only of
//! them and U+0020 spaces shapes to the glyphs of its space-separated words, and its runs of
//! spaces, each shaped alone.
//!
//! A lookup that never involves the space glyph (`space_lookups.lookupUse`) acts within words. One
//! that does acts only where a match starts, at a glyph of its start coverage. So the plan's
//! active lookups that involve the space glyph give a set T of start glyphs, and a character is
//! word-safe when no glyph its nominal glyph can become under the plan's substitutions is in T
//! or is a GDEF mark. Anything the scan cannot read makes the whole plan unsafe.
import view { View }
import space_lookups {
  lookupCount,
  lookupAt,
  lookupUse,
  gdefUse,
  covers,
  fits,
  REASON_NONE,
  REASON_UNKNOWN_LOOKUP,
  REASON_UNKNOWN_FORMAT,
  REASON_MALFORMED,
  REASON_BUDGET
}
import plan { OtPlan, LookupStep, CHECK_FRACTION }
import shape_plan { ShapePlan }
import font { ShaperData }
import feature { Feature }
import read_fonts.lib { FontRef }
import font_types.lib { Tag }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The most glyphs the scan expands from coverages and substitutions, all told, before it
/// gives up and calls the plan unsafe. Fonts reach a small part of it.
const BUDGET: usize = 67108864

/// The highest glyph the scan keeps sets of; coverages past it make the plan unsafe.
const MAX_GLYPH: u32 = 16777215

/// The characters of 0x21 to 0x7E that `plan` can shape word by word with `font`, as bits of two
/// words (bit `c % 64` of word `c / 64`). See `wordSafeAsciiWith`.
pub effect fn wordSafeAscii<'a>(font: &FontRef<'a>, plan: &ShapePlan<'a>) -> [u64; 2]
  ! OutOfMemoryError
  ? &mut Allocator {
  let data = ShaperData.new(font)
  return run wordSafeAsciiWith(&data, plan)
}

/// The characters of 0x21 to 0x7E that `plan`, made for `data`'s font, can shape word by word:
/// a line made only of them and U+0020 spaces, shaped with `plan` and the plan's own features,
/// gives the glyphs of its words and runs of spaces shaped alone and joined. Empty when the
/// font has no space glyph, its GDEF makes the space a mark, ligature or filtered mark, it has a
/// legacy `kern` or AAT table, an active lookup that involves the space can start at it, or a
/// table the scan needs cannot be read.
pub effect fn wordSafeAsciiWith<'a>(data: &ShaperData<'a>, plan: &ShapePlan<'a>) -> [u64; 2]
  ! OutOfMemoryError
  ? &mut Allocator {
  let none: [u64; 2] = [0, 0]
  if View.len(&data.kern) != 0 || View.len(&data.morx) != 0 || View.len(&data.mort) != 0
    || View.len(&data.kerx) != 0 {
    return none
  }
  let space = ShaperData.nominalGlyph(data, 32)
  if space == 0 || gdefUse(data.gdef, space) != REASON_NONE {
    return none
  }
  let features = List<Feature>.asSlice(&plan.features)
  let mut budget = BUDGET
  let mut substitutions = List<bool>.make()
  let mut positions = List<bool>.make()
  let substituting = run activeLookups(
    data.gsub,
    false,
    &plan.substitutions,
    features,
    &mut substitutions,
  )
  let positioning = run activeLookups(data.gpos, true, &plan.positions, features, &mut positions)
  if !substituting || !positioning {
    return none
  }

  // T: where the active lookups that involve the space can start.
  let mut starts = List<u64>.make()
  if !run addInvolvedStarts(data.gsub, false, &substitutions, space, &mut starts, &mut budget) {
    return none
  }
  if !run addInvolvedStarts(data.gpos, true, &positions, space, &mut starts, &mut budget) {
    return none
  }

  // Every substitution of the active GSUB lookups, as edges from glyph to glyph.
  let mut froms = List<u32>.make()
  let mut tos = List<u32>.make()
  let mut index: usize = 0
  while index < List<bool>.length(&substitutions) {
    if List<bool>.get(&substitutions, index) {
      let lookup = lookupAt(data.gsub, index)
      let count = u16.toUsize(View.u16(&lookup, 4))
      let mut i: usize = 0
      while i < count {
        let mut kind: u16 = 0
        let subtable = subtableAt(lookup, false, i, &mut kind)
        if !run addEdges(subtable, kind, &mut froms, &mut tos, &mut budget) {
          return none
        }
        i = i + 1
      }
    }
    index = index + 1
  }

  // The edges by source glyph.
  let mut top: u32 = space
  let mut e: usize = 0
  while e < List<u32>.length(&froms) {
    top = larger(top, larger(List<u32>.get(&froms, e), List<u32>.get(&tos, e)))
    e = e + 1
  }
  let mut glyphs: [u32; 128] = [0; 128]
  let mut c: usize = 0x21
  while c <= 0x7e {
    glyphs[c] = ShaperData.nominalGlyph(data, usize.toU32(c))
    top = larger(top, glyphs[c])
    c = c + 1
  }
  if top > MAX_GLYPH {
    return none
  }
  let size = u32.toUsize(top) + 1
  let mut heads = List<u32>.make()
  run List<u32>.appendRepeated(&mut heads, 0, size + 1)
  e = 0
  while e < List<u32>.length(&froms) {
    let at = u32.toUsize(List<u32>.get(&froms, e)) + 1
    let counted = List<u32>.get(&heads, at) + 1
    List<u32>.set(&mut heads, at, counted)
    e = e + 1
  }
  let mut g: usize = 0
  while g < size {
    let total = List<u32>.get(&heads, g + 1) + List<u32>.get(&heads, g)
    List<u32>.set(&mut heads, g + 1, total)
    g = g + 1
  }
  let mut fill = List<u32>.make()
  run List<u32>.appendSlice(&mut fill, List<u32>.asSlice(&heads))
  let mut targets = List<u32>.make()
  run List<u32>.appendRepeated(&mut targets, 0, List<u32>.length(&froms))
  e = 0
  while e < List<u32>.length(&froms) {
    let from = u32.toUsize(List<u32>.get(&froms, e))
    let at = u32.toUsize(List<u32>.get(&fill, from))
    List<u32>.set(&mut targets, at, List<u32>.get(&tos, e))
    List<u32>.set(&mut fill, from, usize.toU32(at + 1))
    e = e + 1
  }

  // Each character is safe when nothing its glyph can become starts an involved lookup or is a
  // mark.
  let classes = View.gdefList(&data.gdef, 0)
  let mut seen = List<u8>.make()
  run List<u8>.appendRepeated(&mut seen, 0, size)
  let mut stack = List<u32>.make()
  let mut safe: [u64; 2] = [0, 0]
  c = 0x21
  while c <= 0x7e {
    let first = glyphs[c]
    let mark = usize.toU8(c)
    let mut ok = first != 0 && first != space
    if ok {
      List<u32>.clear(&mut stack)
      run List<u32>.append(&mut stack, first)
      List<u8>.set(&mut seen, u32.toUsize(first), mark)
      while ok && List<u32>.length(&stack) != 0 {
        let glyph = List<u32>.pop(&mut stack) |> Option<u32>.unwrapOr(0)
        if has(&starts, glyph) || View.class(&classes, glyph) == 3 {
          ok = false
          break
        }
        let from = u32.toUsize(glyph)
        let mut k = u32.toUsize(List<u32>.get(&heads, from))
        let end = u32.toUsize(List<u32>.get(&heads, from + 1))
        while k < end {
          let next = List<u32>.get(&targets, k)
          if List<u8>.get(&seen, u32.toUsize(next)) != mark {
            List<u8>.set(&mut seen, u32.toUsize(next), mark)
            run List<u32>.append(&mut stack, next)
          }
          k = k + 1
        }
      }
    }
    if ok {
      safe[c / 64] = safe[c / 64] | u64.shiftLeft(1, usize.toU64(c % 64))
    }
    c = c + 1
  }
  return safe
}

/// Whether a plan step's lookup can apply to some glyph of a line of printable ASCII and
/// spaces shaped with `features`. A step is active when it is required, or when its feature's
/// value can be nonzero: a user feature for its tag has a nonzero value, or no user feature for
/// it covers every cluster and its default value is nonzero. Fraction features are on only
/// around U+2044 FRACTION SLASH (`shape.markFractions`), which such a line does not have; every
/// other per-glyph check counts as passing.
pub fn stepActive(step: &LookupStep, features: &[Feature]) -> bool {
  if step.required {
    return true
  }
  let mut initial = step.value != 0
  if step.checks == CHECK_FRACTION
    && (step.tag == 0x66726163 || step.tag == 0x6e756d72 || step.tag == 0x646e6f6d) {
    initial = false
  }
  let mut global = false
  let mut i: usize = 0
  while i < features.length {
    if Tag.toU32(features[i].tag) == step.tag {
      if features[i].value != 0 {
        return true
      }
      if Feature.isGlobal(&features[i]) {
        global = true
      }
    }
    i = i + 1
  }
  return initial && !global
}

/// Marks in `out`, one entry per lookup of `layout`, the lookups of `otplan`'s active steps and
/// every lookup their contextual rules apply, transitively. False when the lookup list or a
/// contextual subtable cannot be read.
effect fn activeLookups(
  layout: View<'_>,
  positioning: bool,
  otplan: &OtPlan<'_>,
  features: &[Feature],
  out: &mut List<bool>,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = lookupCount(layout)
  if count == usize.MAX {
    return false
  }
  run List<bool>.appendRepeated(&mut out, false, count)
  let mut pending = List<u32>.make()
  let steps = List<LookupStep>.asSlice(&otplan.steps)
  let mut s: usize = 0
  while s < steps.length {
    let index = u16.toUsize(steps[s].index)
    if index < count && !List<bool>.get(&out, index) && stepActive(&steps[s], features) {
      List<bool>.set(&mut out, index, true)
      run List<u32>.append(&mut pending, usize.toU32(index))
    }
    s = s + 1
  }
  let mut nested = List<u32>.make()
  while List<u32>.length(&pending) != 0 {
    let index = u32.toUsize(List<u32>.pop(&mut pending) |> Option<u32>.unwrapOr(0))
    let lookup = lookupAt(layout, index)
    let subtables = u16.toUsize(View.u16(&lookup, 4))
    if !fits(&lookup, 6, subtables, 2) {
      return false
    }
    let mut i: usize = 0
    while i < subtables {
      let mut kind: u16 = 0
      let subtable = subtableAt(lookup, positioning, i, &mut kind)
      if kind == 0 {
        return false
      }
      if contextual(kind, positioning) {
        List<u32>.clear(&mut nested)
        if !run addNested(subtable, kind == 6 || kind == 8, &mut nested) {
          return false
        }
        let mut n: usize = 0
        while n < List<u32>.length(&nested) {
          let target = u32.toUsize(List<u32>.get(&nested, n))
          if target < count && !List<bool>.get(&out, target) {
            List<bool>.set(&mut out, target, true)
            run List<u32>.append(&mut pending, usize.toU32(target))
          }
          n = n + 1
        }
      }
      i = i + 1
    }
  }
  return true
}

fn contextual(kind: u16, positioning: bool) -> bool {
  return (!positioning && (kind == 5 || kind == 6)) || (positioning && (kind == 7 || kind == 8))
}

/// Subtable `i` of `lookup`, through any extension, with its lookup type in `kind`; `kind` is 0
/// when the extension cannot be read or holds another extension.
fn subtableAt<'a>(lookup: View<'a>, positioning: bool, i: usize, kind: &mut u16) -> View<'a> {
  let mut subtable = View.offset16(&lookup, 6 + i * 2)
  kind.* = View.u16(&lookup, 0)
  let extension: u16 = if positioning {
    9
  } else {
    7
  }
  if kind.* == extension {
    if View.u16(&subtable, 0) != 1 || View.u16(&subtable, 2) == extension {
      kind.* = 0
      return subtable
    }
    kind.* = View.u16(&subtable, 2)
    subtable = View.offset32(&subtable, 4)
  }
  return subtable
}

/// Appends the lookups a contextual subtable's rules apply. False when it cannot be read.
effect fn addNested(subtable: View<'_>, chained: bool, out: &mut List<u32>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let format = View.u16(&subtable, 0)
  if format == 3 {
    if !chained {
      let inputs = u16.toUsize(View.u16(&subtable, 2))
      return run addRecords(subtable, 4, 6 + inputs * 2, &mut out)
    }
    let backs = u16.toUsize(View.u16(&subtable, 2))
    let inputAt = 4 + backs * 2
    let aheadAt = inputAt + 2 + u16.toUsize(View.u16(&subtable, inputAt)) * 2
    let countAt = aheadAt + 2 + u16.toUsize(View.u16(&subtable, aheadAt)) * 2
    return run addRecords(subtable, countAt, countAt + 2, &mut out)
  }
  if format != 1 && format != 2 {
    return false
  }
  let mut setsAt: usize = 4
  if format == 2 {
    setsAt = 6
    if chained {
      setsAt = 10
    }
  }
  let sets = u16.toUsize(View.u16(&subtable, setsAt))
  if View.len(&subtable) < setsAt + 2 || !fits(&subtable, setsAt + 2, sets, 2) {
    return false
  }
  let mut i: usize = 0
  while i < sets {
    let set = View.offset16(&subtable, setsAt + 2 + i * 2)
    let rules = u16.toUsize(View.u16(&set, 0))
    if !fits(&set, 2, rules, 2) {
      return false
    }
    let mut j: usize = 0
    while j < rules {
      let rule = View.offset16(&set, 2 + j * 2)
      if !chained {
        let inputs = usize.saturatingSubtract(u16.toUsize(View.u16(&rule, 0)), 1)
        if !run addRecords(rule, 2, 4 + inputs * 2, &mut out) {
          return false
        }
      } else {
        let inputAt = 2 + u16.toUsize(View.u16(&rule, 0)) * 2
        let aheadAt = inputAt + 2
          + usize.saturatingSubtract(u16.toUsize(View.u16(&rule, inputAt)), 1) * 2
        let countAt = aheadAt + 2 + u16.toUsize(View.u16(&rule, aheadAt)) * 2
        if !run addRecords(rule, countAt, countAt + 2, &mut out) {
          return false
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  return true
}

/// Appends the lookup indices of the sequence lookup records counted at `countAt` and starting
/// at `at` in `table`. False when they do not fit.
effect fn addRecords(table: View<'_>, countAt: usize, at: usize, out: &mut List<u32>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = u16.toUsize(View.u16(&table, countAt))
  if countAt + 2 > View.len(&table) || !fits(&table, at, count, 4) {
    return false
  }
  let mut i: usize = 0
  while i < count {
    run List<u32>.append(&mut out, u16.toU32(View.u16(&table, at + i * 4 + 2)))
    i = i + 1
  }
  return true
}

/// For every active lookup of `layout` that involves `space`, adds to `starts` the glyphs its
/// subtables can start a match at. False when one can start at `space` itself, or a lookup
/// cannot be read.
effect fn addInvolvedStarts(
  layout: View<'_>,
  positioning: bool,
  active: &List<bool>,
  space: u32,
  starts: &mut List<u64>,
  budget: &mut usize,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut index: usize = 0
  while index < List<bool>.length(active) {
    if List<bool>.get(active, index) {
      let use = lookupUse(layout, positioning, space, index)
      if use.involved {
        if use.reason == REASON_UNKNOWN_LOOKUP || use.reason == REASON_UNKNOWN_FORMAT
          || use.reason == REASON_MALFORMED
          || use.reason == REASON_BUDGET {
          return false
        }
        let lookup = lookupAt(layout, index)
        let count = u16.toUsize(View.u16(&lookup, 4))
        let mut i: usize = 0
        while i < count {
          let mut kind: u16 = 0
          let subtable = subtableAt(lookup, positioning, i, &mut kind)
          if !run addStarts(subtable, kind, positioning, space, &mut starts, &mut budget) {
            return false
          }
          i = i + 1
        }
      }
    }
    index = index + 1
  }
  return true
}

/// Adds the glyphs a subtable can start a match at: its coverage, the first input coverage of a
/// format 3 contextual subtable, and both coverages of a mark attachment. False when one has
/// `space` or cannot be read, or the format is not one the scan reads.
effect fn addStarts(
  subtable: View<'_>,
  kind: u16,
  positioning: bool,
  space: u32,
  starts: &mut List<u64>,
  budget: &mut usize,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let format = View.u16(&subtable, 0)
  if contextual(kind, positioning) {
    if format == 1 || format == 2 {
      return run addStartCoverage(View.offset16(&subtable, 2), space, &mut starts, &mut budget)
    }
    if format != 3 {
      return false
    }
    let mut inputAt: usize = 2
    if kind == 6 || kind == 8 {
      inputAt = 4 + u16.toUsize(View.u16(&subtable, 2)) * 2
    }
    if View.u16(&subtable, inputAt) == 0 {
      return false
    }
    return run addStartCoverage(
      View.offset16(&subtable, inputAt + 2),
      space,
      &mut starts,
      &mut budget,
    )
  }
  let mut readable = false
  if !positioning {
    readable = ((kind == 1 && format == 2) || format == 1) && kind >= 1 && kind <= 8 && kind != 7
  } else {
    readable = (format == 1 && kind >= 1 && kind <= 6) || (format == 2 && kind <= 2 && kind >= 1)
  }
  if !readable {
    return false
  }
  if !run addStartCoverage(View.offset16(&subtable, 2), space, &mut starts, &mut budget) {
    return false
  }
  if positioning && kind >= 4 && kind <= 6 {
    return run addStartCoverage(View.offset16(&subtable, 4), space, &mut starts, &mut budget)
  }
  return true
}

effect fn addStartCoverage(
  coverage: View<'_>,
  space: u32,
  starts: &mut List<u64>,
  budget: &mut usize,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if covers(coverage, space) {
    return false
  }
  let mut glyphs = List<u32>.make()
  if !run coverageGlyphs(coverage, &mut glyphs, &mut budget) {
    return false
  }
  let mut i: usize = 0
  while i < List<u32>.length(&glyphs) {
    run add(&mut starts, List<u32>.get(&glyphs, i))
    i = i + 1
  }
  return true
}

/// Appends `coverage`'s glyphs in coverage index order. False when it cannot be read, its
/// ranges' start indices do not follow on, or it spends the budget.
effect fn coverageGlyphs(coverage: View<'_>, out: &mut List<u32>, budget: &mut usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let format = View.u16(&coverage, 0)
  if format < 1 || format > 4 {
    return false
  }
  let mut width: usize = 2
  if format >= 3 {
    width = 3
  }
  let count = u32.toUsize(View.uint(&coverage, 2, width))
  if format == 1 || format == 3 {
    if !fits(&coverage, 2 + width, count, width) || !spend(&mut budget, count) {
      return false
    }
    let mut i: usize = 0
    while i < count {
      let glyph = View.uint(&coverage, 2 + width + i * width, width)
      if glyph > MAX_GLYPH {
        return false
      }
      run List<u32>.append(&mut out, glyph)
      i = i + 1
    }
    return true
  }
  let stride = width * 3
  if !fits(&coverage, 2 + width, count, stride) {
    return false
  }
  let mut next: u32 = 0
  let mut i: usize = 0
  while i < count {
    let at = 2 + width + i * stride
    let first = View.uint(&coverage, at, width)
    let last = View.uint(&coverage, at + width, width)
    if last < first || last > MAX_GLYPH || View.uint(&coverage, at + width * 2, width) != next {
      return false
    }
    if !spend(&mut budget, u32.toUsize(last - first) + 1) {
      return false
    }
    let mut glyph = first
    while glyph <= last {
      run List<u32>.append(&mut out, glyph)
      glyph = glyph + 1
    }
    next = next + (last - first) + 1
    i = i + 1
  }
  return true
}

fn spend(budget: &mut usize, count: usize) -> bool {
  if count > budget.* {
    budget.* = 0
    return false
  }
  budget.* = budget.* - count
  return true
}

/// Appends an edge from each glyph a GSUB subtable substitutes to each glyph it can put in its
/// place: single, multiple and alternate substitutes, a ligature from each of its components,
/// and reverse chaining substitutes. Contextual subtables add none, as the lookups they apply
/// are active themselves. False when the subtable cannot be read.
effect fn addEdges(
  subtable: View<'_>,
  kind: u16,
  froms: &mut List<u32>,
  tos: &mut List<u32>,
  budget: &mut usize,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if kind == 5 || kind == 6 {
    return true
  }
  let format = View.u16(&subtable, 0)
  if kind < 1 || kind > 8 || kind == 7 || (format != 1 && !(kind == 1 && format == 2)) {
    return false
  }
  let mut covered = List<u32>.make()
  if !run coverageGlyphs(View.offset16(&subtable, 2), &mut covered, &mut budget) {
    return false
  }
  let glyphs = List<u32>.asSlice(&covered)
  if kind == 1 && format == 1 {
    let delta = u16.toU32(View.u16(&subtable, 4))
    let mut i: usize = 0
    while i < glyphs.length {
      run edge(&mut froms, &mut tos, glyphs[i], (glyphs[i] + delta) & 0xffff)
      i = i + 1
    }
    return true
  }
  if kind == 1 || kind == 8 {
    let mut at: usize = 4
    if kind == 8 {
      let backs = u16.toUsize(View.u16(&subtable, 4))
      let aheadAt = 6 + backs * 2
      at = aheadAt + 2 + u16.toUsize(View.u16(&subtable, aheadAt)) * 2
    }
    let count = u16.toUsize(View.u16(&subtable, at))
    if at + 2 > View.len(&subtable) || !fits(&subtable, at + 2, count, 2) {
      return false
    }
    let mut i: usize = 0
    while i < count && i < glyphs.length {
      run edge(&mut froms, &mut tos, glyphs[i], u16.toU32(View.u16(&subtable, at + 2 + i * 2)))
      i = i + 1
    }
    return true
  }
  let sets = u16.toUsize(View.u16(&subtable, 4))
  if !fits(&subtable, 6, sets, 2) {
    return false
  }
  let mut i: usize = 0
  while i < sets && i < glyphs.length {
    let set = View.offset16(&subtable, 6 + i * 2)
    let count = u16.toUsize(View.u16(&set, 0))
    if !fits(&set, 2, count, 2) || !spend(&mut budget, count) {
      return false
    }
    let mut j: usize = 0
    while j < count {
      if kind == 4 {
        let ligature = View.offset16(&set, 2 + j * 2)
        let target = u16.toU32(View.u16(&ligature, 0))
        let components = usize.saturatingSubtract(u16.toUsize(View.u16(&ligature, 2)), 1)
        if View.len(&ligature) < 4 || !fits(&ligature, 4, components, 2)
          || !spend(&mut budget, components) {
          return false
        }
        run edge(&mut froms, &mut tos, glyphs[i], target)
        let mut k: usize = 0
        while k < components {
          run edge(&mut froms, &mut tos, u16.toU32(View.u16(&ligature, 4 + k * 2)), target)
          k = k + 1
        }
      } else {
        run edge(&mut froms, &mut tos, glyphs[i], u16.toU32(View.u16(&set, 2 + j * 2)))
      }
      j = j + 1
    }
    i = i + 1
  }
  return true
}

effect fn edge(froms: &mut List<u32>, tos: &mut List<u32>, from: u32, to: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run List<u32>.append(&mut froms, from)
  run List<u32>.append(&mut tos, to)
}

effect fn add(set: &mut List<u64>, glyph: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let word = u32.toUsize(glyph / 64)
  let length = List<u64>.length(&set)
  if length <= word {
    run List<u64>.appendRepeated(&mut set, 0, word + 1 - length)
  }
  let bits = List<u64>.get(&set, word) | u64.shiftLeft(1, u32.toU64(glyph % 64))
  List<u64>.set(&mut set, word, bits)
}

fn has(set: &List<u64>, glyph: u32) -> bool {
  let word = u32.toUsize(glyph / 64)
  if word >= List<u64>.length(set) {
    return false
  }
  return (List<u64>.get(set, word) & u64.shiftLeft(1, u32.toU64(glyph % 64))) != 0
}

fn larger(left: u32, right: u32) -> u32 {
  if left > right {
    return left
  }
  return right
}
