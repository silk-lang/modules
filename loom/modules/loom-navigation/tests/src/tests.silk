//! A small shop on a stack: a list, details that load, and a sheet.
import loom_navigation.lib { Stack, Screen, Action, Presentation, Message, Owned, Out, header }
import loom.lib {
  CommandSet,
  Document,
  fold,
  Node,
  NoOutput,
  Program,
  Submodel,
  Subscriptions,
  Update
}
import loom.program as program
import loom.program { Hosted, Run }
import loom.runtime { Runtime, tick, drain, navigate }
import loom_tree.harness { click, press }
import ui_tree.inspect { findAll }
import ui_tree.legacy { UiTree, TreeError, FrameInput }
import ui_fixtures.fixtures as fixtures
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

union Page {
  Items { loaded: bool, shows: u32 },
  Detail { id: i64, loaded: bool, dirty: bool },
  Filters,
}

union PageMessage {
  Loaded,
  Opened { id: i64 },
  OpenedFilters,
  Closed,
  WentHome,
  Swapped,
  Edited,
  AskedToLeave,
  Shown,
}

union PageCommand {
  Load,
}

impl CommandSet<PageMessage ? never> for PageCommand {
  effect fn execute(self: Self) -> PageMessage
    ! OutOfMemoryError {
    return PageMessage.Loaded
  }
}

type Step = Update<Page, PageCommand, Action<Page>>

impl Screen<PageMessage, PageCommand> for Page {
  effect fn start(model: &Page) -> List<PageCommand>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut commands = List<PageCommand>.make()
    match &model.* {
      Page.Filters => {}
      _ => run commands.append(PageCommand.Load)
    }
    return move commands
  }

  effect fn update(model: Page, message: PageMessage) -> Step
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      PageMessage.Loaded => {
        return match move model {
          Page.Items { loaded: _, shows } => Step.of(Page.Items { loaded: true, shows: shows })
          Page.Detail { id, loaded: _, dirty } => Step.of(Page.Detail { id: id, loaded: true, dirty: dirty })
          Page.Filters => Step.of(Page.Filters)
        }
      }
      PageMessage.Opened { id } => {
        return Step.of(move model).reporting(
          Action<Page>.Push { screen: Page.Detail { id: id, loaded: false, dirty: false } },
        )
      }
      PageMessage.OpenedFilters => {
        return Step.of(move model).reporting(Action<Page>.Push { screen: Page.Filters })
      }
      PageMessage.Closed => { return Step.of(move model).reporting(Action<Page>.Pop) }
      PageMessage.WentHome => { return Step.of(move model).reporting(Action<Page>.PopToRoot) }
      PageMessage.Swapped => {
        return Step.of(move model).reporting(
          Action<Page>.Replace { screen: Page.Detail { id: 99, loaded: false, dirty: false } },
        )
      }
      PageMessage.Edited => {
        return match move model {
          Page.Detail { id, loaded, dirty: _ } => Step.of(Page.Detail { id: id, loaded: loaded, dirty: true })
          Page other => Step.of(move other)
        }
      }
      PageMessage.AskedToLeave => {
        // Asked once: the second back leaves.
        return match move model {
          Page.Detail { id, loaded, dirty: _ } => Step.of(Page.Detail { id: id, loaded: loaded, dirty: false })
          Page other => Step.of(move other)
        }
      }
      PageMessage.Shown => {
        return match move model {
          Page.Items { loaded, shows } => Step.of(Page.Items { loaded: loaded, shows: shows + 1 })
          Page other => Step.of(move other)
        }
      }
    }
  }

  fn view(model: &Page, h: &Document<PageMessage>) -> Node {
    match &model.* {
      Page.Items { loaded, shows: _ } => {
        if !loaded {
          return h.column(&[], &[h.text("loading items")])
        }
        return h.column(
          &[],
          &[
            header<PageMessage>(h, "Items", Option<PageMessage>.none()),
            h.button(&[h.onClick(PageMessage.Opened { id: 1 })], &[h.text("Open 1")]),
            h.button(&[h.onClick(PageMessage.Opened { id: 2 })], &[h.text("Open 2")]),
          ],
        )
      }
      Page.Detail { id, loaded, dirty: _ } => {
        if !loaded {
          return h.column(&[], &[h.text("loading detail")])
        }
        return h.column(
          &[],
          &[
            header<PageMessage>(h, "Detail", Option<PageMessage>.some(PageMessage.Closed)),
            h.number(id),
            h.button(&[h.onClick(PageMessage.OpenedFilters)], &[h.text("Filters")]),
            h.button(&[h.onClick(PageMessage.Opened { id: id + 10 })], &[h.text("Deeper")]),
            h.button(&[h.onClick(PageMessage.WentHome)], &[h.text("Home")]),
            h.button(&[h.onClick(PageMessage.Swapped)], &[h.text("Swap")]),
            h.button(&[h.onClick(PageMessage.Edited)], &[h.text("Edit")]),
            h.link("/detail/7", &[], &[h.text("Seven")]),
          ],
        )
      }
      Page.Filters => {
        return h.column(
          &[],
          &[h.text("filters"), h.button(&[h.onClick(PageMessage.Closed)], &[h.text("Done")])],
        )
      }
    }
  }

  fn presentation(model: &Page) -> Presentation {
    return match &model.* {
      Page.Filters => Presentation.Sheet
      _ => Presentation.Push
    }
  }

  fn back(model: &Page) -> Option<PageMessage> {
    return match &model.* {
      Page.Detail { id: _, loaded: _, dirty } => if dirty {
        Option<PageMessage>.some(PageMessage.AskedToLeave)
      } else {
        Option<PageMessage>.none()
      }
      _ => Option<PageMessage>.none()
    }
  }

  fn shown(model: &Page) -> Option<PageMessage> {
    return Option<PageMessage>.some(PageMessage.Shown)
  }

  effect fn path(model: &Page) -> Option<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let text: string = match &model.* {
      Page.Items { .. } => "/"
      Page.Detail { id, .. } => if id == 1 { "/detail/1" } else if id == 7 { "/detail/7" } else { "/detail/other" }
      // The sheet has no address: the location stays at the screen under it.
      Page.Filters => { return Option<String>.none() }
    }
    return Option<String>.some(run String.copy(text))
  }

  effect fn open(path: string) -> Option<Page>
    ! OutOfMemoryError
    ? &mut Allocator {
    if path == "/detail/1" {
      return Option<Page>.some(Page.Detail { id: 1, loaded: false, dirty: false })
    }
    if path == "/detail/7" {
      return Option<Page>.some(Page.Detail { id: 7, loaded: false, dirty: false })
    }
    return Option<Page>.none()
  }
}

type Msg = Message<PageMessage>

type Cmd = Owned<PageCommand>

struct Shop {
  stack: Stack<Page>,
  exits: u32,
}

impl Program<Msg, Cmd> for Shop {
  effect fn init() -> Update<Shop, Cmd, NoOutput>
    ! OutOfMemoryError
    ? &mut Allocator {
    let stack = (run Stack<Page>.of(1, Page.Items { loaded: false, shows: 0 }, Presentation.Push)).withLinks()
    let commands = run Submodel<Msg, Cmd, Out>.start(&stack)
    return Update<Shop, Cmd, NoOutput>.batch(Shop { stack: move stack, exits: 0 }, move commands)
  }

  effect fn update(model: Shop, message: Msg) -> Update<Shop, Cmd, NoOutput>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut model = move model
    let folded = run fold<Stack<Page>, Msg, Cmd, Out>(&mut model.stack, move message)
    if folded.out.isSome() {
      model.exits = model.exits + 1
    }
    return run Update<Shop, Cmd, NoOutput>.batch(move model, move folded.commands)
      .heading(move folded.destination)
      .dropping(move folded.cancels)
  }

  fn view(model: &Shop, h: &Document<Msg>) -> Node {
    return h.submodel(&model.stack, |message: Msg| move message)
  }

  fn subscriptions(model: &Shop, subs: &mut Subscriptions<Msg>) -> () {
    subs.submodel(1, &model.stack, |message: Msg| move message)
  }
}

type Host = Runtime<Hosted<Shop>, Msg, Run<Cmd>>

fn at(time: f64) -> FrameInput {
  return FrameInput { width: 600.0, height: 600.0, scale: 1.0, time: time }
}

effect fn count(tree: &mut UiTree<'_>, value: string) -> usize
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(&tree, value, &mut found)
  return found.length()
}

effect fn first(tree: &mut UiTree<'_>, value: string) -> u32
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(&tree, value, &mut found)
  return if found.length() == 0 { 0 } else { found.get(0) }
}

/// Performs the commands that wait, and the ones their messages start.
effect fn settle(app: &mut Host, tree: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  while app.deferred() != 0 {
    let held = run app.takeWork()
    let message = run CommandSet.execute(move held.command.command)
    drop app.finish(held.ticket, move message)
    run drain(&mut app, &mut tree)
  }
}

effect fn say(app: &mut Host, tree: &mut UiTree<'_>, message: Msg) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  app.send(move message)
  run drain(&mut app, &mut tree)
}

test effect fn screensComeAndGo() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shop() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn shop() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut app = run program.make<Shop, Msg, Cmd>()
  let mut now: f64 = 0.0
  app.deferCommands()
  run app.start(&mut tree, 0.0)
  run drain(&mut app, &mut tree)

  // The first screen shows before its loader ran.
  run Testing.expect(app.deferred() == 1, "the first screen's loader waits")
  run Testing.expect((run count(&mut tree, "loading items")) == 1, "and its shell shows")
  run settle(&mut app, &mut tree)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect((run count(&mut tree, "Open 1")) == 1, "the items loaded")
  let button = run first(&mut tree, "Open 1")

  // A push shows the new screen at once, with its loader still to run.
  drop run click(&mut app, &mut tree, at(now), "Open 1")
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 2, "a click pushes the detail")
  run Testing.expect((run count(&mut tree, "loading detail")) == 1, "its shell shows")
  run Testing.expect(app.deferred() == 1, "its loader waits")
  run Testing.expect(app.model.value.stack.moving(), "the transition runs")

  // Back while it loads: the loader is dropped.
  run say(&mut app, &mut tree, Message<PageMessage>.Back)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 1, "back pops it")
  run Testing.expect(app.deferred() == 0, "and its waiting loader is cancelled")

  // Back while the loader runs: its late message lands nowhere.
  drop run click(&mut app, &mut tree, at(now), "Open 2")
  now = now + 10.0
  run tree.frame(at(now))
  let running = run app.takeWork()
  now = now + 10.0
  run tree.frame(at(now))
  run say(&mut app, &mut tree, Message<PageMessage>.Back)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.cancelled(running.ticket), "a running loader is told it was cancelled")
  let late = run CommandSet.execute(move running.command.command)
  run Testing.expect(!app.finish(running.ticket, move late), "and what it loaded is dropped")
  run Testing.expect(app.model.value.stack.depth() == 1, "the stack is as it was")

  // The screen below keeps its nodes while it is covered, and when it shows again.
  drop run click(&mut app, &mut tree, at(now), "Open 1")
  now = now + 10.0
  run tree.frame(at(now))
  run settle(&mut app, &mut tree)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect((run count(&mut tree, "Deeper")) == 1, "the detail loaded")
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(!app.model.value.stack.moving(), "the transition settles on its timer")
  run Testing.expect((run first(&mut tree, "Open 1")) == button, "the covered screen keeps its nodes")
  run say(&mut app, &mut tree, Message<PageMessage>.Settled)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.stats.reused > 0, "and its view is not asked again while it is covered")

  // A sheet: Escape closes it, and only it.
  drop run click(&mut app, &mut tree, at(now), "Filters")
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 3, "the sheet is a screen")
  run Testing.expect((run count(&mut tree, "Deeper")) == 1, "the screen under a sheet stays")
  run press(&mut app, &mut tree, at(now), "Escape", 0)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 2, "Escape closes the sheet")
  run press(&mut app, &mut tree, at(now), "Escape", 0)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 2, "Escape leaves a pushed screen")
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))

  // The keyboard goes back from where the focus is.
  drop run click(&mut app, &mut tree, at(now), "Edit")
  now = now + 10.0
  run tree.frame(at(now))
  run press(&mut app, &mut tree, at(now), "ArrowLeft", 4)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 2, "a screen with unsaved work answers back itself")
  run press(&mut app, &mut tree, at(now), "ArrowLeft", 4)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 1, "then back leaves it")
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect((run first(&mut tree, "Open 1")) == button, "the uncovered screen is the same nodes")
  let shows = match &app.model.value.stack.top().* {
    Page.Items { loaded: _, shows } => shows
    _ => 0
  }
  run Testing.expect(shows == 3, "a screen hears each time it shows again")

  // Deeper, home, replace.
  drop run click(&mut app, &mut tree, at(now), "Open 1")
  now = now + 10.0
  run tree.frame(at(now))
  run settle(&mut app, &mut tree)
  now = now + 10.0
  run tree.frame(at(now))
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))
  drop run click(&mut app, &mut tree, at(now), "Deeper")
  now = now + 10.0
  run tree.frame(at(now))
  run settle(&mut app, &mut tree)
  now = now + 10.0
  run tree.frame(at(now))
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 3, "screens stack")
  run Testing.expect((run count(&mut tree, "11")) == 1, "the top one shows")
  // The covered detail has a Swap of its own, so the top screen is told by its key.
  let top = app.model.value.stack.topKey()
  run say(&mut app, &mut tree, Message<PageMessage>.Screen { key: top, message: PageMessage.Swapped })
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 3, "replace keeps the depth")
  run settle(&mut app, &mut tree)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect((run count(&mut tree, "99")) == 1, "and shows the new screen")
  let last = app.model.value.stack.topKey()
  run say(&mut app, &mut tree, Message<PageMessage>.Screen { key: last, message: PageMessage.WentHome })
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 1, "home pops to the first screen")

  // Back on the first screen is the parent's to answer.
  run say(&mut app, &mut tree, Message<PageMessage>.Back)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.exits == 1, "back at the root is reported")

  // Links: the location follows the top screen, and the stack follows the location.
  run Testing.expect(app.location() == "/", "the location is the first screen's path")
  drop run click(&mut app, &mut tree, at(now), "Open 1")
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.location() == "/detail/1", "a push moves the location to the new screen's path")
  run navigate(&mut app, &mut tree, "/detail/7")
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 3, "a link to a path pushes the screen it opens")
  run navigate(&mut app, &mut tree, "/detail/1")
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 2, "history going back to a screen on the stack pops to it")
  run navigate(&mut app, &mut tree, "/detail/7")
  now = now + 10.0
  run tree.frame(at(now))
  run say(&mut app, &mut tree, Message<PageMessage>.Back)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(
    app.model.value.stack.depth() == 2 && app.location() == "/detail/1",
    "back from a linked screen pops it and the location follows",
  )
  run navigate(&mut app, &mut tree, "/nowhere")
  run Testing.expect(app.model.value.stack.depth() == 2, "a path that opens nothing changes nothing")
  // A click on a link is the runtime's: that answer is for the click only, and the key
  // pressed next still has its default.
  run settle(&mut app, &mut tree)
  now = now + 10.0
  run tree.frame(at(now))
  drop run click(&mut app, &mut tree, at(now), "Seven")
  now = now + 10.0
  run tree.frame(at(now))
  run settle(&mut app, &mut tree)
  now = now + 1000.0
  run tree.frame(at(now))
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 3, "a click on a link pushes the screen it opens")
  run press(&mut app, &mut tree, at(now), "BrowserBack", 0)
  now = now + 10.0
  run tree.frame(at(now))
  run settle(&mut app, &mut tree)
  now = now + 1000.0
  run tree.frame(at(now))
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 2, "the back key right after a link pops it")
  // Back asked twice from a node that was covered in between: the node last pressed is in
  // the screen that shows again.
  run settle(&mut app, &mut tree)
  now = now + 10.0
  run tree.frame(at(now))
  drop run click(&mut app, &mut tree, at(now), "Deeper")
  now = now + 10.0
  run tree.frame(at(now))
  run settle(&mut app, &mut tree)
  now = now + 1000.0
  run tree.frame(at(now))
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 3, "a screen is pushed from a button")
  run press(&mut app, &mut tree, at(now), "BrowserBack", 0)
  now = now + 10.0
  run tree.frame(at(now))
  run settle(&mut app, &mut tree)
  now = now + 1000.0
  run tree.frame(at(now))
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 2, "the back key pops it")
  run press(&mut app, &mut tree, at(now), "BrowserBack", 0)
  now = now + 10.0
  run tree.frame(at(now))
  run settle(&mut app, &mut tree)
  now = now + 1000.0
  run tree.frame(at(now))
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(app.model.value.stack.depth() == 1, "and again from the screen that shows again")
  drop run click(&mut app, &mut tree, at(now), "Open 1")
  now = now + 10.0
  run tree.frame(at(now))
  run settle(&mut app, &mut tree)
  now = now + 1000.0
  run tree.frame(at(now))
  run tick(&mut app, &mut tree, now, false)
  now = now + 10.0
  run tree.frame(at(now))
  run say(&mut app, &mut tree, Message<PageMessage>.Back)
  now = now + 10.0
  run tree.frame(at(now))
  run Testing.expect(
    app.model.value.stack.depth() == 1 && app.location() == "/",
    "a pop moves the location back",
  )
}
