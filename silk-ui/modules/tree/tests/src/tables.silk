//! Table layout from CSS: display table values, border-spacing, border-collapse, captions,
//! and spans from `colspan` and `rowspan` attributes.
import ui_tree.lib { Tree, TreeError, Viewport, BoxNode, Attribute }
import ui_fixtures.fixtures as fixtures
import svg_css.written as written
import svg_css.tokens { CssError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn viewport() -> Viewport {
  return Viewport { width: 400.0, height: 300.0, scale: 1.0 }
}

effect fn styled(tree: &mut Tree<'_>, parent: BoxNode, css: &[u8]) -> BoxNode
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let node = run tree.box(&[])
  let declarations = run written.declarations(css)
  run tree.setStyle(node, declarations.asSlice())
  run tree.append(parent, node)
  return node
}

effect fn named(tree: &mut Tree<'_>, node: BoxNode, name: string, value: string) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  run tree.setAttribute(node, Attribute.Named { name: run String.copy(name), value: Option<String>.some(run String.copy(value)) })
}

effect fn box(tree: &Tree<'_>, node: BoxNode, x: f32, y: f32, width: f32, height: f32) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match run tree.bounds(node) {
    Option.Some { value } => value.xMin == x && value.yMin == y && value.xMax - value.xMin == width && value.yMax - value.yMin == height
    Option.None => false
  }
}

effect fn tableFromStyles() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let root = run tree.box(&[])
  run tree.setRoot(root)
  let table = run styled(&mut tree, root, b"display: table; border-spacing: 4px 2px")
  let caption = run styled(&mut tree, table, b"display: table-caption; caption-side: bottom; height: 10px")
  let body = run styled(&mut tree, table, b"display: table-row-group")
  let first = run styled(&mut tree, body, b"display: table-row")
  let a = run styled(&mut tree, first, b"display: table-cell; width: 50px; height: 20px")
  let b = run styled(&mut tree, first, b"display: table-cell; width: 30px; vertical-align: bottom")
  let inner = run styled(&mut tree, b, b"height: 10px")
  let second = run styled(&mut tree, body, b"display: table-row")
  let wide = run styled(&mut tree, second, b"display: table-cell; height: 16px")
  run named(&mut tree, wide, "colspan", "2")
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(run box(&tree, table, 0.0, 0.0, 92.0, 52.0), "a table is as wide as its columns and spacing")
  run Testing.expect(run box(&tree, a, 4.0, 2.0, 50.0, 20.0), "spacing comes before the first cell")
  run Testing.expect(run box(&tree, b, 58.0, 2.0, 30.0, 20.0), "and between cells, which stretch to the row")
  run Testing.expect(run box(&tree, inner, 58.0, 12.0, 30.0, 10.0), "vertical-align: bottom puts content at the cell's bottom")
  run Testing.expect(run box(&tree, wide, 4.0, 24.0, 84.0, 16.0), "colspan spans both columns and the spacing between")
  run Testing.expect(run box(&tree, caption, 0.0, 42.0, 92.0, 10.0), "a bottom caption goes below the rows")
  run Testing.expect(run box(&tree, second, 4.0, 24.0, 84.0, 16.0), "a row spans the columns")

  // Collapsed borders: cells and the table keep half of the winning widths, the table no
  // padding, and captions sit outside its borders (as Chromium lays them out).
  let declarations = run written.declarations(b"display: table; border-collapse: collapse; border: 2px solid black; padding: 8px")
  run tree.setStyle(table, declarations.asSlice())
  run tree.setAttribute(wide, Attribute.Named { name: run String.copy("colspan"), value: Option<String>.None })
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(run box(&tree, a, 1.0, 1.0, 51.0, 21.0), "a collapsed table's first cell keeps half the table's border")
  run Testing.expect(run box(&tree, wide, 1.0, 22.0, 51.0, 17.0), "a cell without colspan takes one column")
  run Testing.expect(run box(&tree, b, 52.0, 1.0, 31.0, 21.0), "the next cell follows it")
  run Testing.expect(run box(&tree, caption, 0.0, 40.0, 84.0, 10.0), "a caption goes below the table's border")
  run Testing.expect(run box(&tree, table, 0.0, 0.0, 84.0, 50.0), "and the table holds its border, rows and caption")
}

test effect fn tablesLayOutFromStyles() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run tableFromStyles() |> Effect.provideMut<Allocator>(&mut allocator)
}
