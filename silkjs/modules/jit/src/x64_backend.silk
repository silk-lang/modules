          // and nothing else (ssa_shapes proved what they test on from here).
          if target == NONE { run self.a.jmp(miss) return () }
          let start = self.a.offset()
          run self.knownOne(&function, inst, target, (fact & FACT_OBJECT) != 0, proven, tested, borrowed, miss)
          if self.calleeNext(&function, inst.block, inst.result, target) { self.omitAt = self.cursor + 1 }
          if !self.isPreset(inst.result) { self.setFresh(inst.result) }
