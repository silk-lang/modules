import ui_protocol.stylesheet { StyleSource }
import silk.core.ownership { Copy }

pub enum LoadState { Loading, Ready, Failed }

pub struct Ticket {
  pub root: u32,
  pub sheet: u32,
  pub generation: u64,
}
impl Copy for Ticket {}

pub struct Request {
  pub ticket: Ticket,
  pub source: StyleSource,
}

import silk.text.string { String }

pub struct Status {
  pub base: String,
  pub sheet: u32,
  pub generation: u64,
  pub state: LoadState,
}

import tree { Tree }
import error { TreeError, ProtocolError }
import batch { Batch }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct StyleSheet { pub root: u32, pub id: u32 }
impl Copy for StyleSheet {}
impl StyleSheet {
  pub effect fn load(tree: &mut Tree<'_>, source: StyleSource) -> StyleSheet
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    return run tree.loadStyleSheet(0, move source)
  }
  pub fn state(self: &Self, tree: &Tree<'_>) -> Option<LoadState> {
    return tree.engine().styleLoadState(self.root, self.id)
  }
  pub effect fn replace(self: &Self, tree: &mut Tree<'_>, source: StyleSource) -> ()
    ! ProtocolError | OutOfMemoryError ? &mut Allocator {
    let mut batch = Batch.make()
    run batch.loadStyleSheet(self.root, self.id, move source)
    run tree.apply(run batch.take())
  }
  pub effect fn remove(self: &Self, tree: &mut Tree<'_>) -> ()
    ! ProtocolError | OutOfMemoryError ? &mut Allocator {
    let mut batch = Batch.make()
    run batch.removeStyleSheet(self.root, self.id)
    run tree.apply(run batch.take())
  }
}
