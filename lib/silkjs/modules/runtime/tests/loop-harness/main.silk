import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.num.i32
import silk.num.i64
import ext.uv_loop as uvl
import ext.uv_api_loop as api
import ext.uv_api_abi as abi
import ext.uv_shapes { Options, Stdio }
import silkjsruntime.ext.uv_fs { UvStat }

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
static if Intrinsic.targetOperatingSystem() == "darwin" { const SIGNAL_USR1: i32 = 30 const SIGNAL_USR2: i32 = 31 }
else { const SIGNAL_USR1: i32 = 10 const SIGNAL_USR2: i32 = 12 }
unsafe extern "C" fn printf(format: *const u8, ...) -> i32
unsafe extern "C" fn getpid() -> i32
unsafe extern "C" fn kill(pid: i32, signal: i32) -> i32
unsafe extern "C" fn system(command: *const u8) -> i32
unsafe extern "C" fn usleep(micro: u32) -> i32

unsafe fn nn(p: ?*mut u8) -> *mut u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(p) }
unsafe fn counters(handle: *mut u8) -> [*]mut i32 {
  return unsafe Pointer.assumeManyMut<i32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut i32>(unsafe nn(unsafe uvl.uv_handle_get_data(handle))))
}
unsafe fn bump(handle: *mut u8, index: usize, by: i32) -> () {
  let slot = unsafe Pointer.atMut<i32>(unsafe counters(handle), index)
  unsafe Pointer.write<i32>(slot, unsafe Pointer.read<i32>(slot) + by)
}
unsafe fn get(c: [*]mut i32, index: usize) -> i32 { return unsafe Pointer.read<i32>(unsafe Pointer.atMut<i32>(c, index)) }
fn text(value: &[u8]) -> *const u8 { return Pointer.fromRef<u8>(&value[0]) }
export "C" fn onAsync(handle: *mut u8) -> () { unsafe bump(handle, 0, 1) }
export "C" fn onSignal(handle: *mut u8, signal: i32) -> () { unsafe bump(handle, 1, signal) }
export "C" fn onExit(handle: *mut u8, code: i64, signal: i32) -> () { unsafe bump(handle, 2, 1000 + i64.toI32(code)) unsafe bump(handle, 3, signal) }
export "C" fn onEvent(handle: *mut u8, name: ?*const u8, events: i32, status: i32) -> () {
  unsafe bump(handle, 4, events)
  let _p = unsafe printf(text(b"  event %s events=%d status=%d\n\0"), name, events, status)
}
export "C" fn onStat(handle: *mut u8, status: i32, previous: *const UvStat, current: *const UvStat) -> () {
  unsafe bump(handle, 5, 1)
  let a = () let p = unsafe Pointer.borrow<(), UvStat>(&a, previous) let c = unsafe Pointer.borrow<(), UvStat>(&a, current)
  let _p = unsafe printf(text(b"  stat status=%d size %lu -> %lu mode %lo\n\0"), status, p.st_size, c.st_size, c.st_mode)
}
export "C" fn onClose(handle: *mut u8) -> () { unsafe bump(handle, 6, 1) }
// Through the addon facade: `handle` is the addon's own record, whose first word is its data.
export "C" fn onAddonTimer(handle: *mut u8) -> () { unsafe bump2(unsafe api.handleGetData(handle), 7, 1) unsafe api.closeHandle(handle, onAddonClosed) }
export "C" fn onAddonClosed(handle: *mut u8) -> () { unsafe bump2(unsafe api.handleGetData(handle), 8, 1) }
export "C" fn onThread(argument: ?*mut u8) -> () { unsafe bump2(argument, 9, 1) }
unsafe fn bump2(data: ?*mut u8, index: usize, by: i32) -> () {
  let slot = unsafe Pointer.atMut<i32>(unsafe Pointer.assumeManyMut<i32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut i32>(unsafe nn(data))), index)
  unsafe Pointer.write<i32>(slot, unsafe Pointer.read<i32>(slot) + by)
}

unsafe fn handle(kind: i32, data: *mut u8) -> *mut u8 { let h = unsafe nn(unsafe calloc(1, unsafe uvl.uv_handle_size(kind))) return h }
unsafe fn check(name: &[u8], ok: bool, failures: &mut i32) -> () {
  let _p = unsafe printf(text(b"%s %s\n\0"), if ok { text(b"ok  \0") } else { text(b"FAIL\0") }, text(name))
  if !ok { failures.* = failures.* + 1 }
}
unsafe fn spawn(loop: *mut u8, process: *mut u8, file: &[u8], script: &[u8]) -> i32 {
  let args: [?*const u8; 4] = [text(b"sh\0"), text(b"-c\0"), text(script), Pointer.null<u8>()]
  let env: [?*const u8; 2] = [text(b"PATH=/usr/bin:/bin\0"), Pointer.null<u8>()]
  let stdio: [Stdio; 3] = [Stdio { flags: 2, data: 0 }, Stdio { flags: 2, data: 1 }, Stdio { flags: 2, data: 2 }]
  let options = Options { exitCallback: onExit, file: text(file), args: Pointer.fromRef<?*const u8>(&args[0]), env: Pointer.fromRef<?*const u8>(&env[0]), cwd: Pointer.null<u8>(), flags: 0, stdioCount: 3, stdio: Pointer.fromRef<Stdio>(&stdio[0]), uid: 0, gid: 0 }
  return unsafe uvl.uv_spawn(loop, process, Pointer.fromRef<Options>(&options))
}
pub fn main() -> i32 {
  let _abiSize = Layout.of<abi.Head>().bytes
  unsafe {
    let mut failures: i32 = 0
    let data = nn(calloc(16, 4)) let c = Pointer.assumeManyMut<i32>(Intrinsic.pointerReinterpret<*mut u8, *mut i32>(data))
    let loop = nn(calloc(1, uvl.uv_loop_size()))
    check(b"loop init\0", uvl.uv_loop_init(loop) == 0, &mut failures)
    check(b"empty loop is not alive\0", uvl.uv_loop_alive(loop) == 0 && uvl.uv_run(loop, 2) == 0, &mut failures)
    let wake = handle(1, data) let a1 = uvl.uv_async_init(loop, wake, onAsync) uvl.uv_handle_set_data(wake, data)
    check(b"async holds the loop\0", a1 == 0 && uvl.uv_loop_alive(loop) == 1 && uvl.uv_backend_timeout(loop) == -1, &mut failures)
    let _s1 = uvl.uv_async_send(wake) let _s2 = uvl.uv_async_send(wake)
    let _r = uvl.uv_run(loop, 2)
    check(b"two sends, one callback\0", get(c, 0) == 1, &mut failures)
    let _r2 = uvl.uv_run(loop, 2)
    check(b"no spurious async\0", get(c, 0) == 1, &mut failures)
    uvl.uv_unref(wake)
    check(b"unref releases the loop\0", uvl.uv_loop_alive(loop) == 0 && uvl.uv_has_ref(wake) == 0, &mut failures)

    let sig = handle(16, data) let _i = uvl.uv_signal_init(loop, sig) uvl.uv_handle_set_data(sig, data)
    check(b"signal start\0", uvl.uv_signal_start(sig, onSignal, SIGNAL_USR1) == 0 && uvl.uv_is_active(sig) == 1, &mut failures)
    let _k = kill(getpid(), SIGNAL_USR1)
    let _r3 = uvl.uv_run(loop, 1)
    check(b"SIGUSR1 delivered\0", get(c, 1) == SIGNAL_USR1, &mut failures)
    check(b"signal stop\0", uvl.uv_signal_stop(sig) == 0 && uvl.uv_is_active(sig) == 0, &mut failures)
    uvl.uv_unref(sig)

    let child = handle(10, data)
    let spawned = spawn(loop, child, b"/bin/sh\0", b"exit 3\0") uvl.uv_handle_set_data(child, data)
    check(b"spawn\0", spawned == 0 && uvl.uv_process_get_pid(child) > 0 && uvl.uv_loop_alive(loop) == 1, &mut failures)
    let _r4 = uvl.uv_run(loop, 0)
    check(b"exit code 3\0", get(c, 2) == 1003 && get(c, 3) == 0 && uvl.uv_is_active(child) == 0, &mut failures)
    let killed = handle(10, data)
    let spawned2 = spawn(loop, killed, b"sh\0", b"sleep 30\0") uvl.uv_handle_set_data(killed, data)
    Pointer.write<i32>(Pointer.atMut<i32>(c, 2), 0)
    check(b"spawn by PATH and kill\0", spawned2 == 0 && uvl.uv_process_kill(killed, 15) == 0, &mut failures)
    let _r5 = uvl.uv_run(loop, 0)
    check(b"terminated by SIGTERM\0", get(c, 2) == 1000 && get(c, 3) == 15, &mut failures)
    let missing = handle(10, data)
    let spawned3 = spawn(loop, missing, b"/nonexistent/program\0", b"true\0") uvl.uv_handle_set_data(missing, data)
    check(b"missing program is ENOENT\0", spawned3 == -2 && uvl.uv_is_active(missing) == 0, &mut failures)

    let _f = system(text(b"echo a > /tmp/uvtest-file\0"))
    let watch = handle(3, data) let _w = uvl.uv_fs_event_init(loop, watch) uvl.uv_handle_set_data(watch, data)
    check(b"fs event start\0", uvl.uv_fs_event_start(watch, onEvent, text(b"/tmp/uvtest-file\0"), 0) == 0, &mut failures)
    check(b"fs event on a missing path\0", uvl.uv_fs_event_start(handleInit(loop, data), onEvent, text(b"/tmp/uvtest-none/x\0"), 0) == -2, &mut failures)
    let _f2 = system(text(b"echo b >> /tmp/uvtest-file\0"))
    let _r6 = uvl.uv_run(loop, 1)
    check(b"change event\0", (get(c, 4) & 2) != 0, &mut failures)
    check(b"fs event stop\0", uvl.uv_fs_event_stop(watch) == 0 && uvl.uv_loop_alive(loop) == 0, &mut failures)

    let poll = handle(4, data) let _pi = uvl.uv_fs_poll_init(loop, poll) uvl.uv_handle_set_data(poll, data)
    check(b"fs poll start\0", uvl.uv_fs_poll_start(poll, onStat, text(b"/tmp/uvtest-file\0"), 20) == 0 && uvl.activeRequests(loop) == 1, &mut failures)
    let _r7 = uvl.uv_run(loop, 1)
    while uvl.activeRequests(loop) > 0 { let _again = uvl.uv_run(loop, 1) }
    let _dbg = printf(text(b"  dbg c5=%d reqs=%u timeout=%d\n\0"), get(c, 5), uvl.activeRequests(loop), uvl.uv_backend_timeout(loop))
    check(b"first stat is silent\0", get(c, 5) == 0 && uvl.activeRequests(loop) == 0 && uvl.uv_backend_timeout(loop) > 0 && uvl.uv_backend_timeout(loop) <= 20, &mut failures)
    let _f3 = system(text(b"echo cc >> /tmp/uvtest-file\0"))
    let mut spins: i32 = 0
    while get(c, 5) == 0 && spins < 200 { let _r8 = uvl.uv_run(loop, 1) spins = spins + 1 }
    check(b"stat change reported once\0", get(c, 5) == 1, &mut failures)
    let _r9 = uvl.uv_run(loop, 1) let _r9b = uvl.uv_run(loop, 1)
    check(b"no repeat without change\0", get(c, 5) == 1, &mut failures)
    let _f4 = system(text(b"rm /tmp/uvtest-file\0"))
    let mut spins2: i32 = 0
    while get(c, 5) == 1 && spins2 < 200 { let _r10 = uvl.uv_run(loop, 1) spins2 = spins2 + 1 }
    check(b"removal reported once as an error\0", get(c, 5) == 2, &mut failures)

    let _ps = uvl.uv_fs_poll_stop(poll)
    let timer = nn(calloc(1, 152))
    let ti = api.timerInit(loop, timer) api.handleSetData(timer, data)
    check(b"addon timer start\0", ti == 0 && api.timerStart(timer, onAddonTimer, 5, 0) == 0 && api.isActive(timer) == 1, &mut failures)
    let _ra = uvl.uv_run(loop, 0)
    check(b"addon timer fired once and closed\0", get(c, 7) == 1 && get(c, 8) == 1, &mut failures)
    check(b"loop close refuses open handles\0", uvl.uv_loop_close(loop) == -16, &mut failures)
    uvl.uv_close(wake, onClose) uvl.uv_close(sig, onClose) uvl.uv_close(child, onClose) uvl.uv_close(killed, onClose) uvl.uv_close(missing, onClose) uvl.uv_close(watch, onClose) uvl.uv_close(poll, onClose)
    check(b"closing handles keep the loop alive\0", uvl.uv_loop_alive(loop) == 1 && get(c, 6) == 0, &mut failures)
    let _r12 = uvl.uv_run(loop, 0)
    check(b"seven close callbacks\0", get(c, 6) == 7, &mut failures)
    let _r13 = uvl.uv_run(loop, 0)
    round2(&mut failures)
    return failures
  }
}
unsafe fn handleInit(loop: *mut u8, data: *mut u8) -> *mut u8 { let h = unsafe handle(3, data) let _i = unsafe uvl.uv_fs_event_init(loop, h) return h }

// ---- second round: thread pool, phases, timers, one-shot signals, walk order
export "C" fn onWork(unit: *mut uvl.Work) -> () { let _s = unsafe usleep(20000) }
export "C" fn onWorkDone(unit: *mut uvl.Work, status: i32) -> () {
  let anchor = () let w = unsafe Pointer.borrow<(), uvl.Work>(&anchor, unit)
  let loop = unsafe nn(w.loop) drop w
  let c = unsafe Pointer.assumeManyMut<i32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut i32>(unsafe nn(unsafe uvl.uv_loop_get_data(loop))))
  let slot: usize = if status == 0 { 10 } else { 11 }
  unsafe Pointer.write<i32>(unsafe Pointer.atMut<i32>(c, slot), unsafe Pointer.read<i32>(unsafe Pointer.atMut<i32>(c, slot)) + 1)
  unsafe uvl.requestFinished(loop)
}
export "C" fn onPhase(handle: *mut u8) -> () {
  let d = unsafe nn(unsafe uvl.uv_handle_get_data(handle))
  let c = unsafe Pointer.assumeManyMut<i32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut i32>(d))
  let kind = unsafe uvl.uv_handle_get_type(handle)
  let at = unsafe Pointer.read<i32>(unsafe Pointer.atMut<i32>(c, 12))
  if at < 12 { unsafe Pointer.write<i32>(unsafe Pointer.atMut<i32>(c, i32.toUsize(16 + at)), kind) unsafe Pointer.write<i32>(unsafe Pointer.atMut<i32>(c, 12), at + 1) }
  let _s = unsafe uvl.phaseStopMemory(handle)
}
export "C" fn onRepeat(handle: *mut u8) -> () {
  let d = unsafe nn(unsafe uvl.uv_handle_get_data(handle))
  let c = unsafe Pointer.assumeManyMut<i32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut i32>(d))
  let n = unsafe Pointer.read<i32>(unsafe Pointer.atMut<i32>(c, 13)) + 1
  unsafe Pointer.write<i32>(unsafe Pointer.atMut<i32>(c, 13), n)
  if n == 3 { let _s = unsafe uvl.uv_timer_stop(handle) }
}
export "C" fn onOneShot(handle: *mut u8, signal: i32) -> () {
  let d = unsafe nn(unsafe uvl.uv_handle_get_data(handle))
  let c = unsafe Pointer.assumeManyMut<i32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut i32>(d))
  unsafe Pointer.write<i32>(unsafe Pointer.atMut<i32>(c, 14), unsafe Pointer.read<i32>(unsafe Pointer.atMut<i32>(c, 14)) + 1)
}
export "C" fn onWalk(handle: *mut u8, argument: *mut u8) -> () {
  let c = unsafe Pointer.assumeManyMut<i32>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut i32>(argument))
  let at = unsafe Pointer.read<i32>(unsafe Pointer.atMut<i32>(c, 0))
  unsafe Pointer.write<i32>(unsafe Pointer.atMut<i32>(c, i32.toUsize(1 + at)), unsafe uvl.uv_handle_get_type(handle))
  unsafe Pointer.write<i32>(unsafe Pointer.atMut<i32>(c, 0), at + 1)
}
unsafe fn round2(failures: &mut i32) -> () {
  unsafe {
    let data = nn(calloc(64, 4)) let c = Pointer.assumeManyMut<i32>(Intrinsic.pointerReinterpret<*mut u8, *mut i32>(data))
    let loop = nn(calloc(1, uvl.uv_loop_size()))
    Pointer.write<?*mut u8>(Intrinsic.pointerReinterpret<*mut u8, *mut ?*mut u8>(loop), data)
    check(b"loop init keeps data\0", uvl.uv_loop_init(loop) == 0 && Pointer.address<u8>(uvl.uv_loop_get_data(loop)) == Pointer.address<u8>(data), &mut failures)
    // Thread pool: 6 units on 4 threads, one cancelled before it starts.
    let units = nn(calloc(6, 40))
    let base = Pointer.assumeManyMut<uvl.Work>(Intrinsic.pointerReinterpret<*mut u8, *mut uvl.Work>(units))
    let mut i: usize = 0
    while i < 6 { uvl.requestStarted(loop) uvl.workSubmit(loop, Pointer.atMut<uvl.Work>(base, i), uvl.WORK_CPU, onWork, onWorkDone) i = i + 1 }
    let cancelled = uvl.workCancel(loop, Pointer.atMut<uvl.Work>(base, 5))
    check(b"cancel a waiting unit\0", cancelled == 0, &mut failures)
    // The first unit is running (EBUSY) or, if no pool thread has taken it yet, still waiting (0).
    let first = uvl.workCancel(loop, Pointer.atMut<uvl.Work>(base, 0))
    check(b"cancel of the first unit is EBUSY or 0\0", first == -16 || first == 0, &mut failures)
    check(b"requests keep the loop alive\0", uvl.uv_loop_alive(loop) == 1, &mut failures)
    let _r = uvl.uv_run(loop, 0)
    let _dbg2 = printf(text(b"  dbg done=%d cancelled=%d alive=%d reqs=%u\n\0"), get(c, 10), get(c, 11), uvl.uv_loop_alive(loop), uvl.activeRequests(loop))
    check(b"every unit done or cancelled\0", get(c, 10) + get(c, 11) == 6 && get(c, 11) >= 1 && uvl.uv_loop_alive(loop) == 0, &mut failures)
    // Phases: idle and prepare run before the wait, check after, each newest first.
    let idle = handle(6, data) let _i1 = uvl.uv_idle_init(loop, idle) uvl.uv_handle_set_data(idle, data)
    let prep = handle(9, data) let _i2 = uvl.uv_prepare_init(loop, prep) uvl.uv_handle_set_data(prep, data)
    let chk = handle(2, data) let _i3 = uvl.uv_check_init(loop, chk) uvl.uv_handle_set_data(chk, data)
    let _a = uvl.phaseStart(chk, onPhase) let _b = uvl.phaseStart(prep, onPhase) let _c = uvl.phaseStart(idle, onPhase)
    check(b"an idle handle makes the wait 0\0", uvl.uv_backend_timeout(loop) == 0, &mut failures)
    // A check handle alone would wait forever, as in libuv: a short timer ends the wait.
    let waker = handle(13, data) let _w1 = uvl.uv_timer_init(loop, waker) uvl.uv_handle_set_data(waker, data)
    let _w2 = uvl.uv_timer_start(waker, onClose, 5, 0)
    let _r2 = uvl.uv_run(loop, 0)
    Pointer.write<i32>(Pointer.atMut<i32>(c, 6), 0)
    check(b"idle, prepare, check order\0", get(c, 12) == 3 && get(c, 16) == 6 && get(c, 17) == 9 && get(c, 18) == 2, &mut failures)
    // Repeating timer, stopped by its third call.
    let t = handle(13, data) let _t1 = uvl.uv_timer_init(loop, t) uvl.uv_handle_set_data(t, data)
    let _t2 = uvl.uv_timer_start(t, onRepeat, 1, 2)
    check(b"timer repeat and due\0", uvl.uv_timer_get_repeat(t) == 2 && uvl.uv_timer_get_due_in(t) <= 1, &mut failures)
    let _r3 = uvl.uv_run(loop, 0)
    check(b"repeat ran 3 times\0", get(c, 13) == 3 && uvl.uv_is_active(t) == 0, &mut failures)
    let unstarted = handleInit2(loop, data)
    check(b"again without callback start is EINVAL\0", uvl.uv_timer_again(unstarted) == -22, &mut failures)
    // One-shot signal: delivered once, then the handle stops by itself.
    let sig = handle(16, data) let _s1 = uvl.uv_signal_init(loop, sig) uvl.uv_handle_set_data(sig, data)
    check(b"oneshot start\0", uvl.uv_signal_start_oneshot(sig, onOneShot, SIGNAL_USR2) == 0, &mut failures)
    let _k1 = kill(getpid(), SIGNAL_USR2)
    let _r4 = uvl.uv_run(loop, 1)
    check(b"oneshot delivered and stopped\0", get(c, 14) == 1 && uvl.uv_is_active(sig) == 0 && uvl.signalNumber(sig) == 0, &mut failures)
    // Walk: oldest first (idle 6, prepare 9, check 2, timer 13, timer 13, signal 16).
    let walked = nn(calloc(32, 4)) let w = Pointer.assumeManyMut<i32>(Intrinsic.pointerReinterpret<*mut u8, *mut i32>(walked))
    uvl.uv_walk(loop, onWalk, walked)
    check(b"walk is oldest first\0", get(w, 0) == 7 && get(w, 1) == 6 && get(w, 2) == 9 && get(w, 3) == 2 && get(w, 4) == 13 && get(w, 7) == 16, &mut failures)
    let _p = printf(text(b"  walk: %d %d %d %d %d %d %d\n\0"), get(w, 0), get(w, 1), get(w, 2), get(w, 3), get(w, 4), get(w, 5), get(w, 6))
    // Stat poll on the pool: first stat silent, a change reported, close waits for the context.
    let _f = system(text(b"echo a > /tmp/uvtest-poll\0"))
    let poll = handle(4, data) let _p1 = uvl.uv_fs_poll_init(loop, poll) uvl.uv_handle_set_data(poll, data)
    check(b"poll start submits a stat\0", uvl.uv_fs_poll_start(poll, onStat, text(b"/tmp/uvtest-poll\0"), 10) == 0 && uvl.activeRequests(loop) == 1, &mut failures)
    let _r5 = uvl.uv_run(loop, 1)
    let _f2 = system(text(b"echo bb >> /tmp/uvtest-poll\0"))
    let _r6 = uvl.uv_run(loop, 1) let _r7 = uvl.uv_run(loop, 1) let _r8 = uvl.uv_run(loop, 1)
    check(b"poll saw the change\0", get(c, 5) >= 1, &mut failures)
    uvl.uv_close(poll, onClose) uvl.uv_close(idle, onClose) uvl.uv_close(prep, onClose) uvl.uv_close(chk, onClose) uvl.uv_close(t, onClose) uvl.uv_close(sig, onClose) uvl.uv_close(waker, onClose) uvl.uv_close(unstarted, onClose)
    let _r9 = uvl.uv_run(loop, 0)
    check(b"all closed, poll after its context\0", get(c, 6) == 8 && uvl.uv_loop_alive(loop) == 0, &mut failures)
    check(b"loop closes\0", uvl.uv_loop_close(loop) == 0, &mut failures)
  }
}
unsafe fn handleInit2(loop: *mut u8, data: *mut u8) -> *mut u8 { let h = unsafe handle(13, data) let _i = unsafe uvl.uv_timer_init(loop, h) unsafe uvl.uv_handle_set_data(h, data) return h }
