pub unsafe fn nghttp2_strerror(code: i32) -> ?*mut u8 {
  if code == 0 { return cText(b"Success\0") }
  if code == -501 { return cText(b"Invalid argument\0") }
  if code == -502 { return cText(b"Out of buffer space\0") }
  if code == -503 { return cText(b"Unsupported SPDY version\0") }
  if code == -504 { return cText(b"Operation would block\0") }
  if code == -505 { return cText(b"Protocol error\0") }
  if code == -506 { return cText(b"Invalid frame octets\0") }
  if code == -507 { return cText(b"EOF\0") }
  if code == -508 { return cText(b"Data transfer deferred\0") }
  if code == -509 { return cText(b"No more Stream ID available\0") }
  if code == -510 { return cText(b"Stream was already closed or invalid\0") }
  if code == -511 { return cText(b"Stream is closing\0") }
  if code == -512 { return cText(b"The transmission is not allowed for this stream\0") }
  if code == -513 { return cText(b"Stream ID is invalid\0") }
  if code == -514 { return cText(b"Invalid stream state\0") }
  if code == -515 { return cText(b"Another DATA frame has already been deferred\0") }
  if code == -516 { return cText(b"request HEADERS is not allowed\0") }
  if code == -517 { return cText(b"GOAWAY has already been sent\0") }
  if code == -518 { return cText(b"Invalid header block\0") }
  if code == -519 { return cText(b"Invalid state\0") }
  if code == -521 { return cText(b"The user callback function failed due to the temporal error\0") }
  if code == -522 { return cText(b"The length of the frame is invalid\0") }
  if code == -523 { return cText(b"Header compression/decompression error\0") }
  if code == -524 { return cText(b"Flow control error\0") }
  if code == -525 { return cText(b"Insufficient buffer size given to function\0") }
  if code == -526 { return cText(b"Callback was paused by the application\0") }
  if code == -527 { return cText(b"Too many inflight SETTINGS\0") }
  if code == -528 { return cText(b"Server push is disabled by peer\0") }
  if code == -529 { return cText(b"DATA or HEADERS frame has already been submitted for the stream\0") }
  if code == -530 { return cText(b"The current session is closing\0") }
  if code == -531 { return cText(b"Invalid HTTP header field was received\0") }
  if code == -532 { return cText(b"Violation in HTTP messaging rule\0") }
  if code == -533 { return cText(b"Stream was refused\0") }
  if code == -534 { return cText(b"Internal error\0") }
  if code == -535 { return cText(b"Cancel\0") }
  if code == -536 { return cText(b"When a local endpoint expects to receive SETTINGS frame, it receives an other type of frame\0") }
  if code == -901 { return cText(b"Out of memory\0") }
  if code == -902 { return cText(b"The user callback function failed\0") }
  if code == -903 { return cText(b"Received bad client magic byte string\0") }
  if code == -904 { return cText(b"Flooding was detected in this HTTP/2 session, and it must be closed\0") }
  if code == -537 { return cText(b"SETTINGS frame contained more than the maximum allowed entries\0") }
  if code == -905 { return cText(b"Too many CONTINUATION frames following a HEADER frame\0") }
  return cText(b"Unknown error code\0")
}

/// Takes each C export as a value, so that Silk emits it.
pub fn keepExports() -> () {
  let _a: FrameCallback = silkH2NoFrame
  let _b: NotSentCallback = silkH2NoNotSent
  let _c: HeaderCallback = silkH2NoHeader
  let _d: ErrorCallback = silkH2NoError
  let _e: PaddingCallback = silkH2NoPadding
  let _f: DataCallback = silkH2NoData
  let _g: CloseCallback = silkH2NoClose
  let _h: ReadCallback = silkH2NoRead
}
