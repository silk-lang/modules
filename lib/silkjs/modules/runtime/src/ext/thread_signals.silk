//! Signals reach the runtime through `silk.system.signal_watch`, which blocks a watched signal in
//! the thread that adds it (on Linux) so that it stays pending for the watch's descriptor. A thread
//! that does not block it would take the signal with its default action instead, so every thread
//! the runtime starts calls `blockAsynchronous` first: process signals then go to the main thread,
//! and to a watch while one holds them (the loop plan, step 7, in docs/composable-runtime.md).
//! The faults a thread raises itself (SIGSEGV, SIGBUS, SIGFPE, SIGILL, SIGTRAP) stay unblocked.
//! A thread is also started with them blocked (`blockForStart`), as it begins with its creator's
//! mask: a signal arriving before its own `blockAsynchronous` would otherwise take it.
import silk.mem.pointer { Pointer }

// Opaque sigset_t storage: Darwin writes one u32; GNU/Linux uses all 128 bytes.
extern "C" struct ThreadSignalSet { words: [u64; 16] }
@foreign(noCapture: .("set"))
unsafe extern "C" fn sigfillset(set: *mut ThreadSignalSet) -> i32
@foreign(noCapture: .("set"))
unsafe extern "C" fn sigdelset(set: *mut ThreadSignalSet, signal: i32) -> i32
@foreign(noCapture: ("set", "previous"))
unsafe extern "C" fn pthread_sigmask(how: i32, set: ?*const ThreadSignalSet, previous: ?*mut ThreadSignalSet) -> i32

fn blockOperation() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return 1 }
  return 0
}
fn busError() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return 10 }
  return 7
}

/// Blocks every signal but the synchronous faults in the calling thread, as Node's platform and
/// worker threads do. Call it first in each thread the runtime starts.
pub fn blockAsynchronous() -> () {
  let mut set = ThreadSignalSet { words: [0; 16] }
  if unsafe sigfillset(Pointer.fromMutRef(&mut set)) != 0 { Intrinsic.trap("could not construct a thread signal mask") }
  let faults: [i32; 5] = [11, busError(), 8, 4, 5]
  let mut i: usize = 0
  while i < 5 { let _removed = unsafe sigdelset(Pointer.fromMutRef(&mut set), faults[i]) i = i + 1 }
  if unsafe pthread_sigmask(blockOperation(), Pointer.fromRef(&set), Pointer.null<ThreadSignalSet>()) != 0 {
    Intrinsic.trap("could not block a thread's signals")
  }
}

/// The calling thread's signal mask before `blockForStart`, which `restore` gives back.
pub struct SavedSignals { set: ThreadSignalSet }

/// Blocks the asynchronous signals in the calling thread while it starts a thread: a new thread
/// begins with its creator's mask, so no signal reaches it before its own `blockAsynchronous`.
/// Give the result to `restore` once the thread is started.
pub fn blockForStart() -> SavedSignals {
  let mut saved = SavedSignals { set: ThreadSignalSet { words: [0; 16] } }
  let mut set = ThreadSignalSet { words: [0; 16] }
  if unsafe sigfillset(Pointer.fromMutRef(&mut set)) != 0 { Intrinsic.trap("could not construct a thread signal mask") }
  let faults: [i32; 5] = [11, busError(), 8, 4, 5]
  let mut i: usize = 0
  while i < 5 { let _removed = unsafe sigdelset(Pointer.fromMutRef(&mut set), faults[i]) i = i + 1 }
  if unsafe pthread_sigmask(blockOperation(), Pointer.fromRef(&set), Pointer.fromMutRef(&mut saved.set)) != 0 {
    Intrinsic.trap("could not block a thread's signals")
  }
  return move saved
}

/// Gives the calling thread back the mask `blockForStart` saved.
pub fn restore(saved: SavedSignals) -> () {
  if unsafe pthread_sigmask(setOperation(), Pointer.fromRef(&saved.set), Pointer.null<ThreadSignalSet>()) != 0 {
    Intrinsic.trap("could not restore a thread's signals")
  }
}
fn setOperation() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return 3 }
  return 2
}
