//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The answers of docs/caniuse/support/svg.json.
import caniuse_data { Answer }

pub fn answer(id: string) -> Answer {
  if id == "link-icon-svg" {
    return Answer { support: "x", note: "About the icon a browser shows for a web page. An app sets its window and tray icons itself." }
  }
  if id == "svg" {
    return Answer { support: "y", note: "Inline `<svg>` and SVG images draw with lib-svg: shapes, paths, text, gradients, patterns, clipping, masks and markers." }
  }
  if id == "svg-filters" {
    return Answer { support: "y", note: "In icons: lib-svg draws `<filter>` elements with every primitive." }
  }
  if id == "svg-fonts" {
    return Answer { support: "n", note: "App text cannot use SVG fonts: `@font-face` does not load them. Inside an icon's markup, lib-svg draws the document's own `<font>` elements." }
  }
  if id == "svg-fragment" {
    return Answer { support: "n", note: "An icon draws its whole document; a `#id` or `#svgView(...)` fragment in its URL does not pick out a part." }
  }
  if id == "svg-html" {
    return Answer { support: "n", note: "Nodes cannot use SVG effects by reference: `filter: url(#id)` is skipped, `clip-path: url(#id)` clips to the border box, and there is no `foreignObject` for nodes. CSS filter functions, shapes and gradient masks work." }
  }
  if id == "svg-html5" {
    return Answer { support: "a", note: "Inline `<svg>` markup works in React, Foldkit and plain JavaScript (`createSvgElement`, or `document.createElementNS` after importing `@silkui/core/globals`); markup held as a string goes in as a `data:image/svg+xml` image. An `<svg>` drawn once and then changed updates element by element, redrawing only the shapes that changed, so script animations such as stock lottie-web play. Listeners on its elements hear pointer events on their shapes, and `getBBox()`, `getTotalLength()` and `getPointAtLength()` work. The whole `<svg>` is one node: its elements take attributes and `style`, not app stylesheets, and `foreignObject` is not drawn." }
  }
  if id == "svg-img" {
    return Answer { support: "y", note: "An image node draws an `.svg` file or a `data:image/svg+xml` URL (base64 or percent-encoded), as `<img>` does, at the file's own `width` and `height` when CSS gives no size. Unlike `<img>`, its `currentColor` is the node's `color`." }
  }
  if id == "svg-smil" {
    return Answer { support: "y", note: "SMIL and CSS animations inside an icon play, rendered per frame. Good for small icons such as spinners; each frame is a separate texture." }
  }
  if id == "vector-effect" {
    return Answer { support: "y", note: "In icons: lib-svg honors `vector-effect: non-scaling-stroke`." }
  }
  return Answer { support: "u", note: "" }
}
