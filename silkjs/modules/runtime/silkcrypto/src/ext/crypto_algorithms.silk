      c.length = n
    }
    CipherState.Cbc { v } => {
      let mut n: usize = 0
      if aesFailed(v.finish(move out), &mut n) { return unsafe failWith(&mut c.*, if encrypt || noFinalBlock { b"error:1C80006B:Provider routines::wrong final block length" } else { b"error:1C800064:Provider routines::bad decrypt" }) }
      c.length = n
    }
    CipherState.GcmSeal { v } => {
      let length = x.authTagLength
      if gcmFailed(v.finish(Slice.viewMut<u8>(&mut x.tag, 0, length))) { return unsafe failWith(&mut c.*, b"") }
      x.tagLength = length
    }
    CipherState.GcmOpen { v } => {
      if x.tagLength == 0 || gcmFailed(v.finish(Slice.view<u8>(&x.tag, 0, x.tagLength))) { return unsafe failWith(&mut c.*, b"") }
