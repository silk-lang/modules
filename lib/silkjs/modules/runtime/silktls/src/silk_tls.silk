//! TLS in Silk (ext/tls_engine over silk.tls's sans-IO client and server, behind ext/tls_silk's
//! operations): an implementation of the runtime's `Tls` capability with no C library
//! (docs/composable-runtime.md, step 8). TLS 1.2 and 1.3 with the AEAD suites, ECDHE, RSA, ECDSA
//! and Ed25519 certificates, SNI, ALPN and client certificates are here; session resumption and
//! tickets, PSK, OCSP stapling, keylog, keying material export, renegotiation, TLS 1.0 and 1.1,
//! CBC suites and PKCS #12 are not (ext/tls_silk says how each answers).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjsruntime.ext.diagnostics_fatal { RuntimeHeap }
import silkjsruntime.ext.library_hooks { SecureOps }
import silkjsruntime.libs.core.capabilities { Tls, Composition }
import silkjsruntime.libs.core.host { Services }
import ext.tls_silk

/// silk.tls behind `node:tls`, `node:https` and the network's native TLS sockets.
pub struct SilkTls {
  state: ?*mut tls_silk.State,
}
impl Copy for SilkTls {}

impl SilkTls {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> SilkTls { return SilkTls { state: Pointer.null<tls_silk.State>() } }
}

impl Tls for SilkTls {
  static fn present() -> bool { return true }
  fn secureOps(self: &Self) -> SecureOps { return tls_silk.secureOps() }
  fn forWorker(self: &Self) -> Self { return SilkTls.make() }
  effect fn open(self: &mut Self, allocator: *mut RuntimeHeap) -> () ! OutOfMemoryError {
    self.state = run tls_silk.open(allocator)
  }
  unsafe fn sessions(self: &Self) -> ?*mut u8 { return unsafe Intrinsic.pointerReinterpret<?*mut tls_silk.State, ?*mut u8>(self.state) }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    if Pointer.isNull<tls_silk.State>(self.state) { Intrinsic.trap("TLS provider is not initialized") }
    let state = unsafe Intrinsic.pointerRequalify<?*mut tls_silk.State, *mut tls_silk.State>(self.state)
    return run unsafe tls_silk.dispatch(&mut engine, context, state, argc, argv)
  }
  unsafe fn openHandles(self: &Self) -> usize {
    return match Pointer.nonNullMut<tls_silk.State>(self.state) {
      Option<*mut tls_silk.State>.Some { value } => unsafe tls_silk.openHandles(value)
      Option<*mut tls_silk.State>.None => 0
    }
  }
  unsafe fn close<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> () {
    match Pointer.nonNullMut<tls_silk.State>(self.state) {
      Option<*mut tls_silk.State>.Some { value } => {
        unsafe tls_silk.close(&mut engine, context, value)
        self.state = Pointer.null<tls_silk.State>()
      }
      Option<*mut tls_silk.State>.None => ()
    }
  }
}
