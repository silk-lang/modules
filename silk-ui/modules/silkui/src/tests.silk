fn plan(target: string<'static>, kind: Kind, dev: bool, count: usize) -> Plan {
  return Plan { target: target, kind: kind, dev: dev, title: "Styles", width: 400.0,
    height: 300.0, transparentTitleBar: false, titleBarHeight: 0.0, controlsLeft: 0.0, controlsTop: 0.0, module: "app", command: "", stylesheets: count, runtimeCss: false, natives: false, image: false, tools: false, metalHud: false, allows: Allows.none() }
}

effect fn generatedHosts() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let kinds = [Kind.Engine, Kind.Node, Kind.Loom]
  let modes = [false, true]
  let mut i: usize = 0
  while i < kinds.length {
    let mut j: usize = 0
    while j < modes.length {
      let p = plan("window", kinds[i], modes[j], 2)
      let source = run host.main(&p)
      run Testing.expect(String.contains(String.view(&source), ", &[style_0.data, style_1.data]"), "native hosts embed all sheets in adoption order")
      run Testing.expect(String.contains(String.view(&source), if modes[j] { if kinds[i] == Kind.Loom { "WithRuntimeSheets" } else { "WithSheetUpdates" } } else { "WithSheets" }), "native entry uses compiled sheet API")
      run Testing.expect(String.contains(String.view(&source), "style_updates.path") == modes[j], "only dev hosts watch published sheet updates")
      let empty = run host.main(&plan("window", kinds[i], modes[j], 0))
      run Testing.expect(!String.contains(String.view(&empty), "WithSheets") && !String.contains(String.view(&empty), "style_0"), "existing apps retain their entry point")
      j = j + 1
    }
    i = i + 1
  }
  let mut bars: usize = 0
  while bars < kinds.length {
    let mut transparent = plan("window", kinds[bars], bars == 1, 0)
    transparent.transparentTitleBar = true
    transparent.titleBarHeight = 56.0
    transparent.controlsLeft = 20.0
    transparent.controlsTop = 18.0
    let source = run host.main(&transparent)
    run Testing.expect(String.contains(String.view(&source), "titleBar: TitleBar.Transparent, titleBarHeight: 56.0, controlsLeft: 20.0, controlsTop: 18.0") && String.contains(String.view(&source), "TitleBar, "), "window hosts carry a transparent title bar")
    bars = bars + 1
  }
  let mut runtime = plan("window", Kind.Engine, false, 0)
  runtime.runtimeCss = true
  let runtimeHost = run host.main(&runtime)
  run Testing.expect(String.contains(String.view(&runtimeHost), "releaseWithRuntimeSheets as release") && String.contains(String.view(&runtimeHost), "app_bundle.data, &[]"), "runtime text compilation is an explicit release option even without embedded sheets")
  // A release host on the engine with a bytecode image starts from it and keeps the text.
  let mut imaged = plan("window", Kind.Engine, false, 0)
  imaged.image = true
  let imagedHost = run host.main(&imaged)
  run Testing.expect(String.contains(String.view(&imagedHost), "import app_bundle\nimport app_image\nimport core_image\n") && String.contains(String.view(&imagedHost), "Bundle, releaseBundle as release }"), "a host with an image embeds it beside the bundle and the library's image")
  run Testing.expect(String.contains(String.view(&imagedHost), "Bundle { source: app_bundle.data, image: app_image.data, library: core_image.data }, &[])"), "the image goes to the release entry with the bundle's text, and no sheets")
  imaged.stylesheets = 2
  let imagedSheets = run host.main(&imaged)
  run Testing.expect(String.contains(String.view(&imagedSheets), "library: core_image.data }, &[style_0.data, style_1.data])"), "an imaged host embeds its sheets in adoption order")
  imaged.runtimeCss = true
  let imagedRuntime = run host.main(&imaged)
  run Testing.expect(String.contains(String.view(&imagedRuntime), "Bundle, releaseBundleWithRuntimeSheets as release }"), "an imaged host keeps the runtime compiler option")
  imaged.dev = true
  let imagedDev = run host.main(&imaged)
  run Testing.expect(!String.contains(String.view(&imagedDev), "app_image") && !String.contains(String.view(&imagedDev), "app_bundle"), "a development host has no bundle and no image: it runs what the server sends")
  run Testing.expect(!String.contains(String.view(&runtimeHost), "app_image"), "a host without an image starts from the bundle's text")
  runtime.kind = Kind.Node
  let runtimeNode = run host.main(&runtime)
  run Testing.expect(String.contains(String.view(&runtimeNode), "releaseWithRuntimeSheets as release"), "Node release hosts share the runtime compiler option")
  // A release host on the runtime imports the tools' switch only when the build asks for it.
  let mut measuredNode = plan("window", Kind.Node, false, 0)
  let plainNode = run host.main(&measuredNode)
  run Testing.expect(!String.contains(String.view(&plainNode), "ui_inspect_server"), "a release host leaves the development tools out")
  measuredNode.tools = true
  let toolsNode = run host.main(&measuredNode)
  run Testing.expect(String.contains(String.view(&toolsNode), "import ui_inspect_server.devtools") && String.contains(String.view(&toolsNode), "release"), "a measured release host imports the tools' switch so the build can bind it on")
  let loomDev = run host.main(&plan("window", Kind.Loom, true, 0))
  run Testing.expect(String.contains(String.view(&loomDev), "mainWithRuntimeSheets as loom") && String.contains(String.view(&loomDev), ", &[], \"\")"), "Loom dev includes runtime compilation even without build sheets")
  let mut runtimeCanvas = plan("web-canvas", Kind.Loom, false, 0)
  runtimeCanvas.runtimeCss = true
  let canvasRuntime = run host.main(&runtimeCanvas)
  run Testing.expect(String.contains(String.view(&canvasRuntime), "mainWithRuntimeSheets as loom") && String.contains(String.view(&canvasRuntime), ", &[], \"\")"), "canvas release runtime compilation is explicit")
  let canvas = run host.main(&plan("web-canvas", Kind.Loom, false, 2))
  run Testing.expect(String.contains(String.view(&canvas), "mainWithSheets as loom") && String.contains(String.view(&canvas), "style_1.data"), "canvas embeds compiled sheets")
  let mut commands = plan("window", Kind.Loom, false, 2)
  commands.command = "Commands"
  let nativeCommands = run host.main(&commands)
  run Testing.expect(String.contains(String.view(&nativeCommands), "withCommandsAndSheets<Model, Message, Commands>"), "command hosts retain their command type")
  commands.target = "web-canvas"
  let canvasCommands = run host.main(&commands)
  run Testing.expect(String.contains(String.view(&canvasCommands), "withCommandsAndSheets as loom") && String.contains(String.view(&canvasCommands), "loom<Model, Message, Commands>"), "canvas command hosts accept sheets")
  commands.dev = true
  let canvasDev = run host.main(&commands)
  run Testing.expect(String.contains(String.view(&canvasDev), "withCommandsAndRuntimeSheets as loom") && String.contains(String.view(&canvasDev), "style_updates.path"), "canvas development hosts consume compiled updates")
  let canvasDevPage = run host.page(&commands)
  let canvasReleasePage = run host.page(&plan("web-canvas", Kind.Loom, false, 2))
  run Testing.expect(String.contains(String.view(&canvasDevPage), "stylesheetUpdates: '/styles.update'") && !String.contains(String.view(&canvasReleasePage), "stylesheetUpdates:"), "canvas update fetching is development-only")
  let domPlan = plan("web-dom", Kind.Loom, false, 2)
  let dom = run host.main(&domPlan)
  let page = run host.page(&domPlan)
  run Testing.expect(!String.contains(String.view(&dom), "style_0") && !String.contains(String.view(&dom), "WithSheets"), "DOM leaves CSS to the browser")
  let devPage = run host.page(&plan("web-dom", Kind.Loom, true, 2))
  run Testing.expect(String.contains(String.view(&devPage), "/__silkui/styles") && !String.contains(String.view(&page), "/__silkui/styles"), "CSS replacement polling is development-only")
  run Testing.expect(String.contains(String.view(&page), "<link data-silkui-sheet rel=\"stylesheet\" href=\"style-0.css\">\n<link data-silkui-sheet rel=\"stylesheet\" href=\"style-1.css\">\n<div"), "DOM links sheets in order before mounting")
}

test effect fn orderedAssetsAcrossGeneratedHosts() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run generatedHosts() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn compileAsset() -> () ! TaskError | DecodeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let bytes = run stylesheets.compiled(b"@layer base { .card { width: 123px; --accent: red } }", "app.css")
  let sheet = run Sheet.decode(bytes.asSlice(), &Limits.make())
  run Testing.expect(sheet.declarations.length() == 2 && sheet.diagnostics.length() == 0, "pipeline emits decodable rules and custom properties")
  let number = run stylesheets.name(120, false)
  run Testing.expect(String.view(&number) == "style-120.sheet", "asset names remain unique beyond single digits")
}

test effect fn compiledAssetRoundTrip() -> () ! TaskError | DecodeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run compileAsset() |> Effect.provideMut<Allocator>(&mut allocator)
}


effect fn bundledFonts() ! TaskError | FileError | DecodeError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut FileSystem {
  let temporary = run FileSystem.temporaryDirectory(&run Path.root(),"silk-font-assets-")
  let root = temporary.path.view().unwrapOr("")
  let font = run Path.resolve(&temporary.path,"fonts/font one.ttf")
  let other = run Path.resolve(&temporary.path,"fonts/root.woff2")
  let source = run Path.resolve(&temporary.path,"styles/main.css")
  let host = run Path.resolve(&temporary.path,"host")
  run FileSystem.writeFileWithParents(&font,b"first font")
  run FileSystem.writeFileWithParents(&other,b"second font")
  run FileSystem.writeFileWithParents(&source,b"@layer fonts{@media(min-width:1px){@font-face{font-family:Brand;src:local('Full Name'),url('../fonts/font%20one.ttf?v=1#face') format('truetype'),url(/fonts/root.woff2),url(https://example.invalid/a.woff2);font-display:swap}}}.untouched{background:url(../images/keep.png)}")
  let paths: [string<'static>; 1] = ["styles/main.css"]
  run stylesheets.emit(root,&paths,host.view().unwrapOr(""),false)
  let compiledPath = run Path.resolve(&host,"style-0.sheet")
  let compiled = run FileSystem.readFile(&compiledPath)
  let sheet = run Sheet.decode(compiled.asSlice(),&Limits.make())
  run Testing.expect(sheet.fontFaces.length() == 1 && sheet.fontFaces.asSlice()[0].rule.sources.length() == 4,"bundling preserves conditions, local sources and URL alternatives")
  let sources = sheet.fontFaces.asSlice()[0].rule.sources.asSlice()
  run Testing.expect(match &sources[1] { FaceSource.Url { url, format, .. } => String.view(&url) == "data:application/octet-stream;base64,Zmlyc3QgZm9udA==" && equal(format.asSlice(),b"truetype") _ => false },"relative escaped font path is bundled with its format hint")
  run Testing.expect(match &sources[2] { FaceSource.Url { url, .. } => String.view(&url) == "data:application/octet-stream;base64,c2Vjb25kIGZvbnQ=" _ => false },"root-relative font path uses the app root")
  run Testing.expect(match &sources[3] { FaceSource.Url { url, .. } => String.view(&url) == "https://example.invalid/a.woff2" _ => false },"remote URLs remain lazy host loads")
  run stylesheets.emit(root,&paths,host.view().unwrapOr(""),true)
  let dom = run FileSystem.readFile(&run Path.resolve(&host,"style-0.css"))
  let domText = match String.fromUtf8(dom.asSlice()) { Result.Success { value } => value _ => "" }
  run Testing.expect(String.contains(domText,"data:application/octet-stream;base64,Zmlyc3QgZm9udA==") && String.contains(domText,".untouched{background:url(../images/keep.png)}"),"DOM output embeds the font and preserves unrelated CSS source")
  let before = run stylesheets.fingerprint(root,&paths)
  run FileSystem.writeFile(&font,b"updated font")
  let after = run stylesheets.fingerprint(root,&paths)
  run Testing.expect(before != after,"editing only a font changes the stylesheet update fingerprint")
  run stylesheets.emit(root,&paths,host.view().unwrapOr(""),false)
  let updated = run FileSystem.readFile(&compiledPath)
  run Testing.expect(!equal(compiled.asSlice(),updated.asSlice()),"font edits change the embedded sheet without application source edits")
  let updatePath = run Path.resolve(&host,"styles.update")
  let previous = run FileSystem.readFile(&updatePath)
  run FileSystem.writeFile(&source,b"@font-face{font-family:Missing;src:url(missing.ttf)}")
  let failed = run Effect.result(stylesheets.emit(root,&paths,host.view().unwrapOr(""),false))
  run Testing.expect(match &failed { Result.Failure { .. } => true _ => false },"missing local assets fail the build")
  let retained = run FileSystem.readFile(&updatePath)
  run Testing.expect(equal(previous.asSlice(),retained.asSlice()),"failed font updates retain the last published bundle")
  run FileSystem.release(move temporary)
}

effect fn withFontFiles() ! TaskError | FileError | DecodeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut files = run OsFileSystem.make("/tmp")
  run bundledFonts() |> Effect.provideMut<FileSystem>(&mut files)
}

test effect fn stylesheetBuildBundlesLocalFontsForNativeAndDomAndTracksChanges() ! TaskError | FileError | DecodeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run withFontFiles() |> Effect.provideMut<Allocator>(&mut allocator)
}


effect fn hostNatives() ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // A JavaScript app that exports Silk functions hands the bridge their dispatcher; without
  // any, the bridge has none.
  let kinds = [Kind.Engine, Kind.Node]
  let mut k: usize = 0
  while k < kinds.length {
    let mut exporting = plan("window", kinds[k], k == 1, 0)
    exporting.natives = true
    let main = run host.main(&exporting)
    run Testing.expect(String.contains(String.view(&main), "import natives as exported") && String.contains(String.view(&main), "natives: exported.all() }"), "a host with exported Silk functions passes their dispatcher")
    let plain = run host.main(&plan("window", kinds[k], k == 1, 0))
    run Testing.expect(String.contains(String.view(&plain), "natives: Natives.off() }") && !String.contains(String.view(&plain), "import natives"), "a host without exported Silk functions passes none")
    k = k + 1
  }
}

test effect fn generatedHostsPassExportedFunctions() ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hostNatives() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stopsTheWholeGroup() ! TaskError | FileError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut FileSystem {
  let temporary = run FileSystem.temporaryDirectory(&run Path.root(), "silkui-stop-")
  let ready = run Path.resolve(&temporary.path, "ready")
  let stopped = run Path.resolve(&temporary.path, "stopped")
  // The leader waits for a process of its own, as npm waits for Vite: stopping only the leader
  // would leave that one running.
  // It gives up after ten seconds, so a failing run leaves nothing behind.
  let script = "(trap 'echo > stopped; exit 0' TERM; echo > ready; i=0; while [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done) </dev/null >/dev/null 2>&1 & wait"
  // The file system is rooted at /tmp, so its paths are relative to that.
  let name = temporary.path.view().unwrapOr("")
  let mut directory = run String.copy("/tmp")
  if !String.startsWith(name, "/") { run String.append(&mut directory, "/") }
  run String.append(&mut directory, name)
  let mut child = run process.start("sh", &["-c", script], String.view(&directory), &[])
  let mut waited: u32 = 0
  while waited < 200 {
    if run FileSystem.exists(&ready) { break }
    process.pause(25)
    waited = waited + 1
  }
  let started = run FileSystem.exists(&ready)
  child.stop()
  run Testing.expect(started, "the program started its own process")
  run Testing.expect(child.ended(), "stop waits for the program")
  run Testing.expect(run FileSystem.exists(&stopped), "stop reaches what the program started")
}

effect fn stopsInTmp() ! TaskError | FileError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut files = run OsFileSystem.make("/tmp")
  run stopsTheWholeGroup() |> Effect.provideMut<FileSystem>(&mut files)
}

test effect fn stoppingAProgramStopsWhatItStarted() ! TaskError | FileError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run stopsInTmp() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// `text` at `dir` + `name`, with the folders it needs.
effect fn shipFile(dir: string, name: string, text: string) -> () ! FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut path = run String.copy(dir)
  run String.append(&mut path, name)
  run FileSystem.writeFileWithParents(&run Path.make(String.view(&path)), String.utf8Bytes(text))
}

effect fn shipped(dir: string, name: string) -> bool ! OutOfMemoryError | FileError ? &mut Allocator | &mut FileSystem {
  let mut path = run String.copy(dir)
  run String.append(&mut path, name)
  return run FileSystem.exists(&run Path.make(String.view(&path)))
}

/// What a release host reads beside itself: the bundle's folder without the bundle, its
/// stylesheet, hidden entries, or the folder the build writes into.
effect fn shipsBesideTheBundle() ! FileError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut FileSystem {
  let temporary = run FileSystem.temporaryDirectory(&run Path.root(), "silkui-ship-")
  let mut dist = run String.copy(temporary.path.view().unwrapOr(""))
  run String.append(&mut dist, "/dist")
  let d = String.view(&dist)
  run shipFile(d, "/app.js", "bundle")
  run shipFile(d, "/app.sheet", "sheet")
  run shipFile(d, "/ghostty.wasm", "wasm")
  run shipFile(d, "/assets/worker.js", "worker")
  run shipFile(d, "/.vite/manifest.json", "{}")
  run shipFile(d, "/window/old", "a build before")
  let mut bundle = run String.copy(d)
  run String.append(&mut bundle, "/app.js")
  let mut output = run String.copy(d)
  run String.append(&mut output, "/window")
  let mut into = run String.copy(String.view(&output))
  run String.append(&mut into, "/app")
  run ship.bundleFiles(String.view(&bundle), String.view(&into), String.view(&output))
  let i = String.view(&into)
  let wasm = run shipped(i, "/ghostty.wasm")
  let worker = run shipped(i, "/assets/worker.js")
  let embedded = run shipped(i, "/app.js")
  let sheet = run shipped(i, "/app.sheet")
  let hidden = run shipped(i, "/.vite")
  let nested = run shipped(i, "/window")
  run Testing.expect(wasm && worker, "the files beside the bundle ship")
  run Testing.expect(!embedded && !sheet, "the embedded bundle and stylesheet do not")
  run Testing.expect(!hidden && !nested, "nor hidden entries or the build's own folder")
}

effect fn shipsInTmp() ! FileError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut files = run OsFileSystem.make("/tmp")
  run shipsBesideTheBundle() |> Effect.provideMut<FileSystem>(&mut files)
}

test effect fn releaseHostsGetTheFilesBesideTheirBundle() ! FileError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shipsInTmp() |> Effect.provideMut<Allocator>(&mut allocator)
}
