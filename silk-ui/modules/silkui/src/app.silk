//! An app and the pipeline that builds and runs it, in three stages: an [`App`] (the
//! definition), a [`Built`] (the artifacts per target) and a [`Running`] (live processes).
//! Each step is scoped under the stage it takes, so `App.build` takes an App and gives a
//! Built, and `Built.launch` takes a Built and gives a Running. Steps are effects, so a chain
//! starts with `run`:
//!
//! ```silk,ignore
//! effect fn app() -> App {
//!   return run App.make("my-app")
//!     |> App.framework(Framework.react("."))
//!     |> App.target(Target.window(Window { title: "My app", width: 900.0, height: 600.0 }))
//! }
//!
//! // The app draws under the window's title bar on macOS, and a press in its top 56 pixels
//! // moves the window.
//! Target.window(Window { title: "My app", width: 900.0, height: 600.0 })
//!   .titleBar(TitleBar.transparent(56.0))
//!
//! // The same, with the window buttons 20 pixels from the left and 18 from the top.
//!   .titleBar(TitleBar.transparent(56.0).buttons(20.0, 18.0))
//!
//! // The Metal Performance HUD over the window on macOS: presented fps and frame times.
//!   .metalHud(true)
//!
//! run app() |> App.dev(&options) |> Built.launch() |> Running.watch()
//! run app() |> App.build(&options) |> Built.write(out)
//! ```
//!
//! `--target` picks where it runs: a platform name (`window`, `web-canvas`, `web-dom`) keeps only
//! that target of the app, and a triple such as `aarch64-apple-darwin` builds the window host for
//! it. With no platform named, every target of the app is built.
//!
//! A build keeps its files where the compiler keeps any program's, by triple and mode: the window
//! host at `build/<triple>/<mode>/<name>` with its working files in
//! `build/<triple>/<mode>/silkui/window/`, and a page in
//! `build/wasm32-unknown-unknown/<mode>/pages/<platform>/`. A development host's folders end in
//! `-dev`, and its program in `-dev`, so it never replaces the build of the same mode.
//!
//! A project's own step is a function of the same shape, `effect fn sign<'env, E, ?R>(built:
//! once Effect<'env; Built ! E ? R>) -> Built ! … ? …`, placed in the chain. `tap` and `map`
//! take a closure for something small between two steps.
//!
//! The steps run inside a task (`silk task`): they use the task's root as the project
//! directory and its compiler for `silk build`.
import stylesheets
import inspector_socket
import ship
import host { Kind, Plan, Allows, main as hostMain, page as hostPage, imageWriter, inspectorWriter, webgpuExports, libm }
import manifest { Project, read as readProject }
import bundle as Bundles
import web { Server, site }
import silk.cli.task { Task, TaskError }
import silk.build.graph {
  Build,
  BuildError,
  Compilation,
  Deferred,
  Package,
  WriteFiles,
  Options,
  Optimize
}
import silk.build.context as Context
import silk.build.run { Run }
import silk.build.step { StepHandle }
import silk.build.definition { Definition, Settings as Values, Package as PackageSettings }
import silk.schema.schema { Dictionary }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { WriterError }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem {
  DirectoryEntry,
  FileError,
  FileInfo,
  DirectoryInfo,
  FileSystem,
