//! The application identity read from its manifest; dependencies remain in the compiler's graph.
import silk.cli.task { Task, TaskError }
import silk.build.manifest { Manifest, Package }
import silk.build.step { StepFailure }
import silk.build.context as Context
import silk.core.option { Option }
import silk.schema.toml { SchemaToml }
import silk.mem.allocator { Allocator }
import silk.system.filesystem { FileSystem, Path }
import silk.system.host_input { HostInput }
import silk.text.string { String }

/// The application's directory, package name and Silk source directory.
pub struct Project {
  pub root: String,
  pub name: String,
  /// The Silk source directory, relative to the root: `[package] source`, else `src`.
  pub source: String,
}

/// Reads the application manifest through the same schema as the compiler.
pub effect fn read() -> Project
  ! StepFailure | TaskError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let root = run Task.root()
  let bytes = run FileSystem.readFile(&run Path.join(&root, "silk.toml"))
  let document = run SchemaToml.decode<Manifest>(bytes.asSlice())
  let package = match move document.package {
    Option<Package>.Some { value } => move value
    Option<Package>.None => {
      run Task.abort("silkui: the application needs a package manifest")
    }
  }
  return Project { root: run Context.text(&root), name: move package.name, source: move package.source }
}
