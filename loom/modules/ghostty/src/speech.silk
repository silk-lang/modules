//! What a screen reader hears of a terminal: the text programs write, without their control
//! sequences, one chunk per write, since the user's last input. The view keeps the chunks in
//! a hidden polite live region, so each new one is read once, as it arrives.
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.text.string { String }

/// The most chunks kept: past it, writes join the last one, so a flood stays one message.
const MOST_CHUNKS: usize = 32

/// The longest a chunk grows, in bytes; the rest of a flood is not read.
const LONGEST_CHUNK: usize = 2000

const GROUND: u8 = 0
const ESCAPE: u8 = 1
const CONTROL: u8 = 2
const STRING: u8 = 3
const STRING_ESCAPE: u8 = 4

pub struct Speech {
  /// Where the control-sequence parser is: sequences can span writes.
  state: u8,
  heard: List<String>,
  /// The number of chunks cleared before the first kept one, so each keeps its key.
  cleared: u64,
}

impl Speech {
  pub fn make() -> Speech {
    return Speech { state: GROUND, heard: List<String>.make(), cleared: 0 }
  }

  /// Takes in program output `bytes`: its text, without escape sequences, becomes a chunk.
  pub effect fn hear(self: &mut Self, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut text = Bytes.make()
    let mut i: usize = 0
    while i < bytes.length {
      let byte = bytes[i]
      i = i + 1
      if self.state == ESCAPE {
        // `[` starts a control sequence; `]`, `P`, `_`, `^` and `X` a string up to BEL or ST.
        self.state = if byte == 91 { CONTROL } else if byte == 93 || byte == 80 || byte == 95 || byte == 94 || byte == 88 { STRING } else { GROUND }
        continue
      }
      if self.state == CONTROL {
        if byte >= 64 && byte <= 126 {
          self.state = GROUND
        }
        continue
      }
      if self.state == STRING {
        if byte == 7 {
          self.state = GROUND
        } else if byte == 27 {
          self.state = STRING_ESCAPE
        }
        continue
      }
      if self.state == STRING_ESCAPE {
        self.state = if byte == 92 { GROUND } else { STRING }
        continue
      }
      if byte == 27 {
        self.state = ESCAPE
      } else if byte == 10 || byte == 13 || byte == 9 {
        run space(&mut text)
      } else if byte == 8 {
        // A backspace echoed for an erased character takes it back.
        let length = text.length()
        if length > 0 && text.asSlice()[length - 1] < 128 {
          text.truncate(length - 1)
        }
      } else if byte >= 32 && byte != 127 {
        run text.append(&[byte])
      }
    }
    let mut start: usize = 0
    let mut end = text.length()
    let view = text.asSlice()
    while start < end && view[start] == 32 {
      start = start + 1
    }
    while end > start && view[end - 1] == 32 {
      end = end - 1
    }
    if start == end {
      return ()
    }
    let words = unsafe String.fromUtf8Unchecked(Slice.view(view, start, end - start))
    if self.heard.length() < MOST_CHUNKS {
      run self.heard.append(run String.copy(words))
      return ()
    }
    let at = self.heard.length() - 1
    let mut last = self.heard.remove(at)
    if last.ownedByteLength() < LONGEST_CHUNK {
      run last.append(" ")
      run last.append(words)
    }
    run self.heard.append(move last)
  }

  /// Forgets what was heard, after the user's input: what comes next answers it.
  pub fn clear(self: &mut Self) -> () {
    self.cleared = self.cleared + usize.toU64(self.heard.length())
    self.heard.clear()
  }

  /// The chunks heard since the last input, oldest first.
  pub fn chunks(self: &Self) -> &[String] {
    return self.heard.asSlice()
  }

  /// The key of the first chunk: chunk `i` is `first() + i`.
  pub fn first(self: &Self) -> u64 {
    return self.cleared
  }
}

/// Appends a space unless the text is empty or already ends with one.
effect fn space(text: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  let length = text.length()
  if length > 0 && text.asSlice()[length - 1] != 32 {
    run text.append(b" ")
  }
}
