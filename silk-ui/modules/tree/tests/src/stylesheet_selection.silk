import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, CpuSnapshot, MarkSpan }
import ui_tree.selection
import ui_fixtures.fixtures as fixtures
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.written
import svg_css.tokens { CssError }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.color.rgba { Rgba }
import silk.num.f32

fn frame() -> FrameInput { return FrameInput { width: 220.0, height: 70.0, scale: 1.0, time: 0.0 } }
fn equal(a: Rgba<f32>, b: Rgba<f32>) -> bool {
  return f32.abs(a.r-b.r) < 0.002 && f32.abs(a.g-b.g) < 0.002 && f32.abs(a.b-b.b) < 0.002 && f32.abs(a.a-b.a) < 0.002
}
fn rgb(r: f32, g: f32, b: f32) -> Rgba<f32> { return Rgba<f32> { r:r, g:g, b:b, a:1.0 } }

effect fn base(batch: &mut Batch) ! CssError | OutOfMemoryError ? &mut Allocator {
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("parent") })
  run batch.create(3, NodeKind.Input)
  run batch.append(2, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("input") })
  run batch.setText(3, "MMMM")
  let declarations = run written.declarations(b"font-family:'Geist Mono';font-size:40px;line-height:50px;width:180px;height:60px;color:black;background:white;padding:0;border:0;outline:none")
  run batch.style(3, declarations.asSlice())
  run batch.focus(3)
}

effect fn replace(batch: &mut Batch, css: &[u8], first: bool) ! CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let sheet = run compile.compile(css, &Options.make())
  let bytes = run sheet.encode()
  if first { run batch.adoptStyleSheet(0, 1, bytes.asSlice()) }
  else { run batch.replaceStyleSheet(0, 1, bytes.asSlice()) }
}

effect fn inherits() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch)
  let green = run written.declarations(b"color:lime")
  run batch.style(3, green.asSlice())
  let sheets = [
    b".parent::selection{color:red;background:blue}",
    b".parent::selection{color:currentColor;background:currentColor}",
    b".parent::selection{color:red;background:currentColor}.input::selection{color:lime}",
    b".parent::selection{color:red;background:blue}.input::selection{color:inherit;background-color:inherit}",
    b".parent::selection{color:red;background:blue}.input::selection{color:unset;background-color:unset}",
    b".parent::selection{color:red;background:blue}.input::selection{color:initial;background-color:initial}",
    b".parent::selection{color:color-mix(in srgb,red 50%,blue);background:blue}",
    b".parent::selection{color:currentColor}.input::selection{background:color-mix(in srgb,currentColor 50%,blue)}",
    b".parent::selection{color:currentColor}.input::selection{color:color-mix(in srgb,currentColor 50%,red)}",
    b".parent::selection{color:inherit;background-color:inherit}",
    b".parent::selection{color:red}",
    b".parent::selection{color:currentColor;background:color-mix(in srgb,currentColor 50%,blue)}",
    b".parent::selection{color:red;background:color-mix(in srgb,currentColor 50%,blue)}.input::selection{color:lime}",
    b".parent::selection{color:red;background:color-mix(in srgb,currentColor 50%,blue)}.input::selection{color:lime;background-color:inherit}",
  ]
  let fg = [rgb(1.0,0.0,0.0),rgb(0.0,1.0,0.0),rgb(0.0,1.0,0.0),rgb(1.0,0.0,0.0),rgb(1.0,0.0,0.0),rgb(0.0,0.0,0.0),rgb(0.5,0.0,0.5),rgb(0.0,1.0,0.0),rgb(0.5,0.0,0.0),rgb(0.0,1.0,0.0),rgb(1.0,0.0,0.0),rgb(0.0,1.0,0.0),rgb(0.0,1.0,0.0),rgb(0.0,1.0,0.0)]
  let bg = [rgb(0.0,0.0,1.0),rgb(0.0,1.0,0.0),rgb(0.0,1.0,0.0),rgb(0.0,0.0,1.0),rgb(0.0,0.0,1.0),Rgba<f32>{r:0.0,g:0.0,b:0.0,a:0.0},rgb(0.0,0.0,1.0),rgb(0.0,0.5,0.5),Rgba<f32>{r:0.0,g:0.0,b:0.0,a:0.0},Rgba<f32>{r:0.0,g:0.0,b:0.0,a:0.0},Rgba<f32>{r:0.0,g:0.0,b:0.0,a:0.0},rgb(0.0,0.5,0.5),rgb(0.0,0.5,0.5),rgb(0.0,0.5,0.5)]
  let descriptions = ["literal inherited background", "origin currentColor background", "overridden highlight currentColor background", "explicit inherited background", "unset inherited background", "initial transparent background", "mixed foreground with literal background", "mixed background uses the current origin color", "author color disables native default highlight", "explicit inheritance of defaults is transparent", "foreground-only highlight is transparent", "inherited color mix uses each originating color", "inherited color mix uses descendant highlight foreground", "explicit inheritance retains the color program"]
  let mut i: usize = 0
  while i < sheets.length {
    run replace(&mut batch, sheets[i], i == 0)
    run tree.apply(run batch.take())
    run tree.frame(frame())
    let node = tree.node(tree.slotOf(3))
    run Testing.expect(match selection.foreground(node) { Option.Some { value } => equal(value, fg[i]) _ => false }, "highlight foreground follows Chromium's separate inheritance chain")
    run Testing.expect(equal(selection.background(node), bg[i]), descriptions[i])
    run Testing.expect(equal(node.computed().text.color, rgb(0.0,1.0,0.0)), "selection does not change ordinary text color")
    i = i + 1
  }
  run batch.removeStyleSheet(0, 1)
  run tree.apply(run batch.take())
  run tree.frame(frame())
  let node = tree.node(tree.slotOf(3))
  run Testing.expect(selection.foreground(node).isNone() && equal(selection.background(node), node.computed().text.selectionColor), "removing sheets clears inherited highlight colors")
}

test effect fn selectionColorsInheritIndependentlyAndPreserveCurrentColor() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inherits() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pixels(tree: &mut UiTree<'_>, snapshot: &mut CpuSnapshot) -> Pixmap ! GeometryError | OutOfMemoryError ? &mut Allocator {
  run snapshot.sync(&mut tree)
  return run snapshot.render(&tree)
}

effect fn selectedInk(rich: bool, scale: f32) ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch)
  if rich {
    run batch.defineMark(3, 0, &[])
    run batch.richText(3, "MMMM", &[MarkSpan { start: 2, end: 4, marks: 1 }], &[])
  }
  run batch.select(3, 1, 3)
  run replace(&mut batch, b".input::selection{color:transparent;background-color:white}", true)
  run tree.apply(run batch.take())
  let mut input = frame()
  input.scale = scale
  run tree.frame(input)
  let mut snapshot = CpuSnapshot.make()
  let transparent = run pixels(&mut tree, &mut snapshot)
  let mut dark: usize = 0
  let mut y: u32 = 0
  while y < f32.toU32(50.0 * scale) {
    let mut x: u32 = 0
    while x < f32.toU32(96.0 * scale) {
      let pixel = transparent.pixel(x, y)
      if x >= f32.toU32(24.0 * scale) && x < f32.toU32(72.0 * scale) {
        run Testing.expect(pixel.r == 255 && pixel.g == 255 && pixel.b == 255, "transparent highlight removes selected ink, including text across rich run boundaries")
      } else if pixel.r < 100 { dark = dark + 1 }
      x = x + 1
    }
    y = y + 1
  }
  run Testing.expect(dark > 20, "unselected glyphs remain visible")
  run replace(&mut batch, b".input::selection{color:rgb(255 0 0 / .5);background-color:white}", false)
  run tree.apply(run batch.take())
  run tree.frame(input)
  let half = run pixels(&mut tree, &mut snapshot)
  let mut pink: usize = 0
  y = 0
  while y < f32.toU32(50.0 * scale) {
    let mut x = f32.toU32(24.0 * scale)
    while x < f32.toU32(72.0 * scale) {
      let pixel = half.pixel(x, y)
      if pixel.g < 180 {
        run Testing.expect(pixel.r > 245 && pixel.g >= 120 && pixel.b >= 120, "selected alpha blends with its background, never with old black glyphs")
        pink = pink + 1
      }
      x = x + 1
    }
    y = y + 1
  }
  run Testing.expect(pink > 20, "selection foreground changes repaint cached text")
  run tree.frame(input)
  let replay = run pixels(&mut tree, &mut snapshot)
  y = 0
  while y < half.height() {
    let mut x: u32 = 0
    while x < half.width() {
      let a = half.pixel(x, y)
      let b = replay.pixel(x, y)
      run Testing.expect(a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a, "highlight clipping survives scene replay")
      x = x + 1
    }
    y = y + 1
  }
}

test effect fn selectionForegroundReplacesInkAtBothScalesAndAcrossRichRuns() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run selectedInk(false, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run selectedInk(false, 2.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run selectedInk(true, 1.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run selectedInk(true, 2.0) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn invalidates() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch)
  let container = run written.declarations(b"container-type:inline-size")
  run batch.style(3, container.asSlice())
  run replace(&mut batch, b".parent{--selected:red}.parent::selection{color:var(--selected)}.parent:hover::selection{color:blue}@container(width>150px){.input::selection{background-color:lime}}", true)
  run tree.apply(run batch.take())
  run tree.frame(frame())
  let child = tree.slotOf(3)
  run Testing.expect(equal(selection.background(tree.node(child)), rgb(0.0,1.0,0.0)), "a part query can select its originating input as the container")
  let parent = tree.slotOf(2)
  let node = tree.nodeMut(parent)
  node.hovered = true
  tree.restyleLocal(parent)
  run tree.frame(frame())
  run Testing.expect(match selection.foreground(tree.node(child)) { Option.Some { value } => equal(value,rgb(0.0,0.0,1.0)) _ => false }, "origin hover invalidates inherited highlights")
  let small = run written.declarations(b"width:100px")
  run batch.style(3, small.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(selection.background(tree.node(child)).a == 0.0, "container query changes clear part colors in the same frame")
}

test effect fn selectionRespondsToOriginStatesVariablesAndContainerChanges() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run invalidates() |> Effect.provideMut<Allocator>(&mut allocator)
}
