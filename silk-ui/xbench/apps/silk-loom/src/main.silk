//! The xbench scenes (SCENES.md) as a Loom app: a model, a view of the whole page each render,
//! and Loom's diff. Each item is a keyed lazy region (React's `memo(ItemView)`), each wall cell
//! too (`memo(Cell)`), so a render rebuilds only what changed.
//!
//!   silk-loom <scene>            feed, wall, stream, churn; a size after a dash: feed-3000
//!
//! With SILK_UI_BENCH it runs on ui-tree-window's windowless bench (no window, GPU or display,
//! a clock that moves 1/120 s a frame); without it, in a window. Either way it prints the
//! protocol lines (PROTOCOL.md) on standard error.
import ui_tree.css { px }
import loom.app { App, Context, NoCommand, Subscriptions }
import loom.lib { EventKind, Reply }
import loom.runtime { Runtime }
import loom.ui { Ui }
import loom_window.lib { Launched, RunOptions, StartedGpu, WindowContent, launch, runWindowHostedWithSheets, startGpu }
import loom_window.program { systemFonts }
import ui_inspect_server.lib { Inspector }
import ui_tree.legacy { TreeError, Mutation }
import ui_tree.style_assets { StyleAssets }
import ui_tree_window.host { environmentVariable }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import window.types { TitleBar, WindowError, WindowOptions }
import webgpu.runtime { GpuError }
import silk.build.source { Source }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String, InvalidUtf8 }

const WIDTH: f64 = 1040.0
const HEIGHT: f64 = 720.0

const AVATARS: [string<'static>; 8] = ["avatar c0", "avatar c1", "avatar c2", "avatar c3", "avatar c4", "avatar c5", "avatar c6", "avatar c7"]
const CELL_CLASSES: [string<'static>; 8] = ["cell cl0", "cell cl1", "cell cl2", "cell cl3", "cell cl4", "cell cl5", "cell cl6", "cell cl7"]

fn text(bytes: &[u8]) -> string {
  return String.fromUtf8(bytes) |> Result<string, InvalidUtf8>.unwrapOr("")
}

fn corpus() -> string<'static> {
  return String.fromUtf8(Source.read("assets/corpus.txt")) |> Result<string<'static>, InvalidUtf8>.unwrapOr("")
}

fn picture(index: u32) -> string<'static> {
  let bytes = if index == 0 {
    Source.read("assets/picture-0.dataurl")
  } else if index == 1 {
    Source.read("assets/picture-1.dataurl")
  } else if index == 2 {
    Source.read("assets/picture-2.dataurl")
  } else {
    Source.read("assets/picture-3.dataurl")
  }
  return String.fromUtf8(bytes) |> Result<string<'static>, InvalidUtf8>.unwrapOr("")
}

fn say(line: string) -> () {
  StderrWriter.print("XB {}\n", &.(line))
}

fn say2(word: string, name: string) -> () {
  StderrWriter.print("XB {} {}\n", &(word, name))
}

// ---------- the corpus ----------

struct Corpus {
  source: string<'static>,
  starts: List<usize>,
}

impl Corpus {
  effect fn make() -> Corpus ! OutOfMemoryError ? &mut Allocator {
    let source = corpus()
    let bytes = String.utf8Bytes(source)
    let mut starts = List<usize>.make()
    let mut at: usize = 0
    while at < bytes.length {
      if bytes[at] == 35 {
        run starts.append(at)
      }
      while at < bytes.length && bytes[at] != 10 {
        at = at + 1
      }
      at = at + 1
    }
    return Corpus { source: source, starts: move starts }
  }

  fn count(self: &Self) -> usize {
    return self.starts.length()
  }

  fn item(self: &Self, index: usize) -> string<'static> {
    let starts = self.starts.asSlice()
    let start = starts[index]
    let end = if index + 1 < starts.length { starts[index + 1] } else { String.byteLength(self.source) }
    return String.slice(self.source, start, end - start)
  }

  /// The first line of item `index`: its header.
  fn header(self: &Self, index: usize) -> string<'static> {
    return match String.split(self.item(index), "\n").next() {
      Option.Some { value } => value
      Option.None => ""
    }
  }
}

fn field(line: string<'static>, n: usize) -> string<'static> {
  let bytes = String.utf8Bytes(line)
  let mut at: usize = 0
  let mut k: usize = 0
  let mut start: usize = 0
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 124 {
      if k == n {
        return String.slice(line, start, at - start)
      }
      k = k + 1
      start = at + 1
    }
    at = at + 1
  }
  return ""
}

fn hash(value: string) -> u32 {
  let bytes = String.utf8Bytes(value)
  let mut h: u32 = 0
  let mut i: usize = 0
  while i < bytes.length {
    h = u32.wrappingAdd(u32.wrappingMultiply(h, 31), u8.toU32(bytes[i]))
    i = i + 1
  }
  return h
}

fn number(value: string) -> u32 {
  let bytes = String.utf8Bytes(value)
  let mut n: u32 = 0
  let mut i: usize = 0
  while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 {
    n = n * 10 + u8.toU32(bytes[i] - 48)
    i = i + 1
  }
  return n
}

effect fn appendNumber(out: &mut String, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 {
    run appendNumber(&mut out, value / 10)
  }
  run out.append(String.slice("0123456789", u32.toUsize(value % 10), 1))
}

// ---------- the view ----------

fn labelled(ui: &mut Ui<Message>, class: string, value: string) -> () {
  ui.box(
    |ui| {
      ui.class(class)
      ui.text(value)
    },
  )
}

/// Inline text with its marks (*bold*, _italic_, `code`, [link]).
fn inline(ui: &mut Ui<Message>, value: string) -> () {
  let bytes = String.utf8Bytes(value)
  let mut plain: usize = 0
  let mut at: usize = 0
  while at < bytes.length {
    let c = bytes[at]
    let close: u8 = if c == 42 { 42 } else if c == 95 { 95 } else if c == 96 { 96 } else if c == 91 { 93 } else { 0 }
    let mut end: usize = 0
    if close != 0 {
      let mut j = at + 1
      while j < bytes.length && bytes[j] != close {
        j = j + 1
      }
      if j < bytes.length && j > at + 1 {
        end = j
      }
    }
    if end != 0 {
      if at > plain {
        ui.text(String.slice(value, plain, at - plain))
      }
      let class = if c == 42 { "b" } else if c == 95 { "i" } else if c == 96 { "k" } else { "a" }
      labelled(&mut ui, class, String.slice(value, at + 1, end - at - 1))
      at = end + 1
      plain = at
    } else {
      at = at + 1
    }
  }
  if bytes.length > plain {
    ui.text(String.slice(value, plain, bytes.length - plain))
  }
}

/// An item's header row, from its `#` line.
fn head(ui: &mut Ui<Message>, line: string<'static>) -> () {
  let author = field(String.slice(line, 1, String.byteLength(line) - 1), 1)
  ui.box(
    |ui| {
      ui.class("head")
      let a = String.utf8Bytes(author)
      let mut s = a.length
      while s > 0 && a[s - 1] != 32 {
        s = s - 1
      }
      let mut initials = ui.alloc(String.copy(String.slice(author, 0, 1)))
      ui.alloc(initials.append(String.slice(author, s, 1)))
      labelled(&mut ui, AVATARS[u32.toUsize(hash(author) % 8)], String.view(&initials))
      ui.box(
        |ui| {
          ui.class("who")
          labelled(&mut ui, "name", author)
          labelled(&mut ui, "time", field(line, 2))
        },
      )
      ui.box(
        |ui| {
          ui.class("tags")
          let mut each = String.split(field(line, 3), ",")
          while true {
            match each.next() {
              Option.Some { value } => { labelled(&mut ui, "tag", value) }
              Option.None => { break }
            }
          }
        },
      )
    },
  )
}

fn foot(ui: &mut Ui<Message>, line: string<'static>) -> () {
  ui.box(
    |ui| {
      ui.class("foot")
      let mut counts = String.split(field(line, 4), ",")
      let mut reply = ui.alloc(String.copy("Reply "))
      ui.alloc(reply.append(counts.next() |> Option<string>.unwrapOr("0")))
      let mut like = ui.alloc(String.copy("Like "))
      ui.alloc(like.append(counts.next() |> Option<string>.unwrapOr("0")))
      labelled(&mut ui, "act", String.view(&reply))
      labelled(&mut ui, "act", String.view(&like))
      labelled(&mut ui, "act", "Share")
    },
  )
}

/// The end of the run of lines of `kind` that starts at `at`.
fn runEnd(lines: &[string<'static>], at: usize, kind: u8) -> usize {
  let mut end = at
  while end < lines.length && String.utf8Bytes(lines[end])[0] == kind {
    end = end + 1
  }
  return end
}

fn rest(line: string<'static>) -> string<'static> {
  return String.slice(line, 2, String.byteLength(line) - 2)
}

/// A list, a code block or a table: lines `from` to `to`, all of `kind`.
fn group(ui: &mut Ui<Message>, lines: &[string<'static>], from: usize, to: usize, kind: u8) -> () {
  if kind == 76 {
    ui.box(
      |ui| {
        ui.class("ul")
        let mut i = from
        while i < to {
          let line = lines[i]
          ui.box(
            |ui| {
              ui.class("li")
              ui.box(|ui| { ui.class("dot") })
              ui.box(
                |ui| {
                  ui.class("lt")
                  inline(&mut ui, rest(line))
                },
              )
            },
          )
          i = i + 1
        }
      },
    )
  } else if kind == 67 {
    ui.box(
      |ui| {
        ui.class("pre")
        let mut i = from
        while i < to {
          labelled(&mut ui, "cl", rest(lines[i]))
          i = i + 1
        }
      },
    )
  } else {
    let first = String.utf8Bytes(rest(lines[from]))
    let mut columns: usize = 1
    let mut c: usize = 0
    while c < first.length {
      if first[c] == 124 { columns = columns + 1 }
      c = c + 1
    }
    ui.box(
      |ui| {
        ui.class(if columns == 3 { "t3" } else { "t4" })
        let mut i = from
        while i < to {
          let mut cells = String.split(rest(lines[i]), "|")
          while true {
            match cells.next() {
              Option.Some { value } => { labelled(&mut ui, if i == from { "th" } else { "td" }, value) }
              Option.None => { break }
            }
          }
          i = i + 1
        }
      },
    )
  }
}

fn figure(ui: &mut Ui<Message>, line: string<'static>) -> () {
  let mut parts = String.split(rest(line), " ")
  let p = number(parts.next() |> Option<string<'static>>.unwrapOr("0"))
  let w = number(parts.next() |> Option<string<'static>>.unwrapOr("0"))
  let h = number(parts.next() |> Option<string<'static>>.unwrapOr("0"))
  let caption = parts.remainder() |> Option<string<'static>>.unwrapOr("")
  ui.box(
    |ui| {
      ui.class("fig")
      ui.imageWith(
        picture(p),
        |ui| {
          ui.class("img")
          ui.width(px(u32.toF32(w)))
          ui.height(px(u32.toF32(h)))
        },
      )
      labelled(&mut ui, "cap", caption)
    },
  )
}

/// Item `lines` (one item of the corpus) as the scenes show it.
fn itemView(ui: &mut Ui<Message>, lines: string<'static>) -> () {
  let mut list = List<string<'static>>.make()
  let mut split = String.split(lines, "\n")
  while true {
    match split.next() {
      Option.Some { value } => {
        if String.byteLength(value) != 0 {
          ui.alloc(list.append(value))
        }
      }
      Option.None => { break }
    }
  }
  let all = list.asSlice()
  ui.box(
    |ui| {
      ui.class("item")
      let mut header: string<'static> = ""
      let mut at: usize = 0
      while at < all.length {
        let line = all[at]
        let kind = String.utf8Bytes(line)[0]
        if kind == 35 {
          header = line
          head(&mut ui, line)
          at = at + 1
        } else if kind == 76 || kind == 67 || kind == 84 {
          let end = runEnd(all, at, kind)
          group(&mut ui, all, at, end, kind)
          at = end
        } else {
          if kind == 80 || kind == 81 {
            ui.box(
              |ui| {
                ui.class(if kind == 80 { "p" } else { "q" })
                inline(&mut ui, rest(line))
              },
            )
          } else if kind == 72 {
            ui.box(
              |ui| {
                ui.class("h")
                inline(&mut ui, rest(line))
              },
            )
          } else if kind == 73 {
            figure(&mut ui, line)
          }
          at = at + 1
        }
      }
      foot(&mut ui, header)
    },
  )
}

/// A streamed item: an author's header and footer around the paragraphs written so far.
fn streamedView(ui: &mut Ui<Message>, streamed: &Streamed) -> () {
  ui.box(
    |ui| {
      ui.class("item")
      head(&mut ui, streamed.header)
      let paragraphs = streamed.paragraphs.asSlice()
      let mut i: usize = 0
      while i < paragraphs.length {
        let paragraph = &paragraphs[i]
        ui.box(
          |ui| {
            ui.class("p")
            inline(&mut ui, String.view(&paragraph))
          },
        )
        i = i + 1
      }
      foot(&mut ui, streamed.header)
    },
  )
}

fn cell(ui: &mut Ui<Message>, index: u32, value: u32) -> () {
  ui.box(
    |ui| {
      ui.class(CELL_CLASSES[u32.toUsize(value % 8)])
      let mut name = ui.alloc(String.copy("cell "))
      ui.alloc(appendNumber(&mut name, index))
      labelled(&mut ui, "cn", String.view(&name))
      let mut shown = String.make()
      ui.alloc(appendNumber(&mut shown, value))
      labelled(&mut ui, "cv", String.view(&shown))
    },
  )
}

// ---------- the model ----------

enum Kind { Feed, Wall, Stream, Churn }

const CELLS: u32 = 544
const NOTES: usize = 24

struct Streamed {
  header: string<'static>,
  paragraphs: List<String>,
  version: u64,
}

/// An item in the churn feed: which corpus item, and a key no earlier item had.
struct Shown {
  index: usize,
  key: u64,
}

enum Op { Idle, Mark, Drive, Done }

struct Step {
  op: Op,
  name: string<'static>,
  amount: u32,
}

fn sizeOf(name: string) -> usize {
  let bytes = String.utf8Bytes(name)
  let mut at: usize = 0
  while at < bytes.length && bytes[at] != 45 {
    at = at + 1
  }
  if at >= bytes.length {
    return 0
  }
  return u32.toUsize(number(String.slice(name, at + 1, bytes.length - at - 1)))
}

fn kindOf(name: string) -> Kind {
  if String.startsWith(name, "wall") { return Kind.Wall }
  if String.startsWith(name, "stream") { return Kind.Stream }
  if String.startsWith(name, "churn") { return Kind.Churn }
  return Kind.Feed
}

fn script(kind: Kind, size: usize, at: usize) -> Step {
  if kind == Kind.Feed {
    if at == 0 { return Step { op: Op.Idle, name: "loaded", amount: 3000 } }
    if at == 1 { return Step { op: Op.Mark, name: "loaded", amount: 0 } }
    if at == 2 { return Step { op: Op.Drive, name: "scroll", amount: 600 } }
    if at == 3 { return Step { op: Op.Drive, name: "sweep", amount: 0 } }
    if at == 4 { return Step { op: Op.Idle, name: "swept", amount: 3000 } }
    if at == 5 { return Step { op: Op.Mark, name: "swept", amount: 0 } }
  } else if kind == Kind.Wall {
    if at == 0 { return Step { op: Op.Idle, name: "loaded", amount: 3000 } }
    if at == 1 { return Step { op: Op.Mark, name: "loaded", amount: 0 } }
    if at == 2 { return Step { op: Op.Drive, name: "update", amount: 600 } }
    if at == 3 { return Step { op: Op.Drive, name: "pan", amount: 600 } }
    if at == 4 { return Step { op: Op.Mark, name: "end", amount: 0 } }
  } else if kind == Kind.Stream {
    if at == 0 { return Step { op: Op.Idle, name: "loaded", amount: 3000 } }
    if at == 1 { return Step { op: Op.Mark, name: "loaded", amount: 0 } }
    if at == 2 { return Step { op: Op.Drive, name: "stream", amount: 900 } }
    if at == 3 { return Step { op: Op.Idle, name: "streamed", amount: 3000 } }
    if at == 4 { return Step { op: Op.Mark, name: "streamed", amount: 0 } }
  } else {
    let grow = usize.toU32((size + 24) / 25)
    if at == 0 { return Step { op: Op.Idle, name: "base", amount: 1000 } }
    if at == 1 { return Step { op: Op.Mark, name: "base", amount: 0 } }
    if at == 2 { return Step { op: Op.Drive, name: "grow-1", amount: grow } }
    if at == 3 { return Step { op: Op.Idle, name: "full-1", amount: 1000 } }
    if at == 4 { return Step { op: Op.Mark, name: "full-1", amount: 0 } }
    if at == 5 { return Step { op: Op.Drive, name: "clear-1", amount: 1 } }
    if at == 6 { return Step { op: Op.Idle, name: "empty-1", amount: 1500 } }
    if at == 7 { return Step { op: Op.Mark, name: "empty-1", amount: 0 } }
    if at == 8 { return Step { op: Op.Drive, name: "grow-2", amount: grow } }
    if at == 9 { return Step { op: Op.Idle, name: "full-2", amount: 1000 } }
    if at == 10 { return Step { op: Op.Mark, name: "full-2", amount: 0 } }
    if at == 11 { return Step { op: Op.Drive, name: "clear-2", amount: 1 } }
    if at == 12 { return Step { op: Op.Idle, name: "empty-2", amount: 1500 } }
    if at == 13 { return Step { op: Op.Mark, name: "empty-2", amount: 0 } }
    if at == 14 { return Step { op: Op.Drive, name: "grow-3", amount: grow } }
    if at == 15 { return Step { op: Op.Idle, name: "full-3", amount: 1000 } }
    if at == 16 { return Step { op: Op.Mark, name: "full-3", amount: 0 } }
    if at == 17 { return Step { op: Op.Drive, name: "clear-3", amount: 1 } }
    if at == 18 { return Step { op: Op.Idle, name: "empty-3", amount: 1500 } }
    if at == 19 { return Step { op: Op.Mark, name: "empty-3", amount: 0 } }
  }
  return Step { op: Op.Done, name: "", amount: 0 }
}

pub union Message {
  Frame { pub time: f64 },
  Viewport { pub height: f32 },
  Content { pub height: f32 },
}

pub struct Model {
  kind: Kind,
  size: usize,
  title: String,
  corpus: Corpus,
  viewHeight: f64,
  contentHeight: f64,
  /// Where the scroller is asked to be; `scrolled` once a driver has moved it.
  top: f64,
  scrolled: bool,
  pin: bool,
  // wall
  values: List<u32>,
  // stream
  words: List<string<'static>>,
  nextWord: usize,
  written: u32,
  made: usize,
  streamed: List<Streamed>,
  // churn
  shown: List<Shown>,
  serial: u64,
  // the script
  step: usize,
  stepFrame: u32,
  stepStart: f64,
  frames: u32,
  lastTime: f64,
  swept: bool,
  times: List<f64>,
  painted: bool,
  done: bool,
}

impl Model {
  effect fn make(name: string) -> Model ! OutOfMemoryError ? &mut Allocator {
    let kind = kindOf(name)
    let asked = sizeOf(name)
    let size: usize = if asked != 0 { asked } else if kind == Kind.Feed { 1000 } else if kind == Kind.Stream { 300 } else if kind == Kind.Churn { 1000 } else { 0 }
    let mut title = run String.copy("xbench ")
    if kind == Kind.Feed { run title.append("feed-") } else if kind == Kind.Stream { run title.append("stream-") } else if kind == Kind.Churn { run title.append("churn-") } else { run title.append("wall") }
    if kind != Kind.Wall { run appendNumber(&mut title, usize.toU32(size)) }
    let mut model = Model {
      kind: kind, size: size, title: move title, corpus: run Corpus.make(),
      viewHeight: 0.0, contentHeight: 0.0, top: 0.0, scrolled: false, pin: false,
      values: List<u32>.make(),
      words: List<string<'static>>.make(), nextWord: 0, written: 0, made: 0, streamed: List<Streamed>.make(),
      shown: List<Shown>.make(), serial: 0,
      step: 0, stepFrame: 0, stepStart: 0.0, frames: 0, lastTime: -1.0, swept: false, times: List<f64>.make(),
      painted: false, done: false,
    }
    if kind == Kind.Wall {
      let mut i: u32 = 0
      while i < CELLS {
        run model.values.append((i * 7919) % 10000)
        i = i + 1
      }
    }
    if kind == Kind.Stream {
      // The words the stream writes: the paragraphs of the items after the transcript.
      let mut i = size
      while i < size + 200 && i < model.corpus.count() {
        let mut split = String.split(model.corpus.item(i), "\n")
        while true {
          match split.next() {
            Option.Some { value } => {
              if String.startsWith(value, "P ") {
                let mut words = String.split(rest(value), " ")
                while true {
                  match words.next() {
                    Option.Some { value: w } => { if String.byteLength(w) != 0 { run model.words.append(w) } }
                    Option.None => { break }
                  }
                }
              }
            }
            Option.None => { break }
          }
        }
        i = i + 1
      }
    }
    return move model
  }

  fn maxScroll(self: &Self) -> f64 {
    return f64.max(self.contentHeight - self.viewHeight, 0.0)
  }

  effect fn drive(self: &mut Self, name: string, f: u32) -> bool ! OutOfMemoryError ? &mut Allocator {
    if name == "scroll" {
      self.top = self.top + 24.0
      self.scrolled = true
    } else if name == "sweep" {
      if self.swept {
        return false
      }
      self.top = self.top + 720.0
      if self.top >= self.maxScroll() {
        self.top = 0.0
        self.swept = true
      }
    } else if name == "update" {
      let values = self.values.asMutSlice()
      let mut k: u32 = 0
      while k < 32 {
        let i = ((f * 32 + k) * 37) % CELLS
        values[u32.toUsize(i)] = (f * 31 + k * 7 + i) % 10000
        k = k + 1
      }
    } else if name == "pan" {
      self.top = if f < 300 { u32.toF64(f + 1) } else { u32.toF64(599 - f) }
      self.scrolled = true
    } else if name == "stream" {
      run self.stream()
    } else if String.startsWith(name, "grow-") {
      let cycle = u32.toUsize(number(String.slice(name, 5, 1))) - 1
      let mut i: usize = 0
      while i < 25 && self.shown.length() < self.size {
        let n = cycle * 1000 + self.shown.length()
        self.serial = self.serial + 1
        run self.shown.append(Shown { index: n % self.corpus.count(), key: self.serial })
        i = i + 1
      }
    } else if String.startsWith(name, "clear-") {
      self.shown.clear()
    }
    return true
  }

  /// One frame of the stream: three more words; a new paragraph every 60, a new item every 240.
  effect fn stream(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.written % 240 == 0 {
      let header = self.corpus.header(self.size + self.made % 50)
      run self.streamed.append(Streamed { header: header, paragraphs: List<String>.make(), version: 0 })
      self.made = self.made + 1
    }
    let all = self.streamed.asMutSlice()
    let last = &mut all[all.length - 1]
    last.version = last.version + 1
    if self.written % 60 == 0 {
      run last.paragraphs.append(String.make())
    }
    let paragraphs = last.paragraphs.asMutSlice()
    let paragraph = &mut paragraphs[paragraphs.length - 1]
    let words = self.words.asSlice()
    let mut k: u32 = 0
    while k < 3 {
      if paragraph.ownedByteLength() != 0 {
        run paragraph.append(" ")
      }
      run paragraph.append(words[self.nextWord % words.length])
      self.nextWord = self.nextWord + 1
      k = k + 1
    }
    self.written = self.written + 3
    self.pin = !self.pin
  }

  effect fn frame(self: &mut Self, time: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    if time == self.lastTime || self.done {
      return ()
    }
    self.lastTime = time
    let now = time * 1000.0
    self.frames = self.frames + 1
    if !self.painted {
      // The second frame: the first one's layout and paint are done (as the React app's two
      // requestAnimationFrame callbacks). Loom's window host does not pass on presentation.
      if self.frames >= 2 {
        self.painted = true
        say("first-paint")
        self.stepStart = now
      }
      return ()
    }
    let step = script(self.kind, self.size, self.step)
    if step.op == Op.Done {
      say("done")
      self.done = true
      return ()
    }
    if step.op == Op.Idle {
      if self.stepFrame == 0 {
        say2("idle-begin", step.name)
        self.stepStart = now
        self.stepFrame = 1
      } else if now - self.stepStart >= u32.toF64(step.amount) - 0.5 {
        say2("idle-end", step.name)
        self.next(now)
      }
      return ()
    }
    if step.op == Op.Mark {
      if self.stepFrame == 0 {
        say2("mark", step.name)
        self.stepStart = now
        self.stepFrame = 1
      } else if now - self.stepStart >= 399.5 {
        self.next(now)
      }
      return ()
    }
    if self.stepFrame == 0 {
      say2("begin", step.name)
      self.times.clear()
      self.stepFrame = 1
      return ()
    }
    run self.times.append(now)
    let f = self.stepFrame - 1
    let more = if step.amount != 0 && f >= step.amount { false } else { run self.drive(step.name, f) }
    if !more {
      StderrWriter.print("XB end {} {}\n", &(step.name, f))
      let mut gaps = String.make()
      let times = self.times.asSlice()
      let mut i: usize = 1
      while i < times.length {
        if i > 1 { run gaps.append(",") }
        let ms = times[i] - times[i - 1]
        run appendNumber(&mut gaps, f64.toU32(ms))
        run gaps.append(".")
        let frac = f64.toU32((ms - f64.floor(ms)) * 1000.0)
        if frac < 100 { run gaps.append("0") }
        if frac < 10 { run gaps.append("0") }
        run appendNumber(&mut gaps, frac)
        i = i + 1
      }
      StderrWriter.print("XB frames {} {}\n", &(step.name, String.view(&gaps)))
      self.next(now)
      return ()
    }
    self.stepFrame = self.stepFrame + 1
  }

  fn next(self: &mut Self, now: f64) -> () {
    self.step = self.step + 1
    self.stepFrame = 0
    self.stepStart = now
  }

  fn wantsFrames(self: &Self) -> bool {
    if !self.painted || self.done {
      return !self.done
    }
    let step = script(self.kind, self.size, self.step)
    return step.op == Op.Drive || self.stepFrame == 0
  }

  /// Seconds from the last frame to the end of the current idle or mark.
  fn wait(self: &Self) -> f64 {
    let step = script(self.kind, self.size, self.step)
    let amount = if step.op == Op.Idle { u32.toF64(step.amount) } else { 400.0 }
    return f64.max((self.stepStart + amount - self.lastTime * 1000.0) / 1000.0, 0.001)
  }

  fn content(self: &Self, ui: &mut Ui<Message>) -> () {
    if self.kind == Kind.Wall {
      ui.box(
        |ui| {
          ui.class("wall")
          ui.box(
            |ui| {
              ui.class("cells")
              let values = self.values.asSlice()
              let mut i: usize = 0
              while i < values.length {
                let value = values[i]
                let index = usize.toU32(i)
                ui.lazyKeyed(
                  usize.toU64(i) + 1,
                  u32.toU64(value) + 1,
                  |ui| {
                    ui.key(u32.toU64(index) + 1)
                    cell(&mut ui, index, value)
                  },
                )
                i = i + 1
              }
            },
          )
          ui.box(
            |ui| {
              ui.class("notes")
              let mut n: usize = 0
              while n < NOTES {
                let mut split = String.split(self.corpus.item(n), "\n")
                while true {
                  match split.next() {
                    Option.Some { value } => {
                      if String.startsWith(value, "P ") {
                        ui.box(
                          |ui| {
                            ui.class("note")
                            inline(&mut ui, rest(value))
                          },
                        )
                        break
                      }
                    }
                    Option.None => { break }
                  }
                }
                n = n + 1
              }
            },
          )
        },
      )
      return ()
    }
    ui.box(
      |ui| {
        ui.class("feed")
        ui.on(
          EventKind.Layout,
          |event| {
            let height = event.bounds.yMax - event.bounds.yMin
            if f32.toF64(height) != self.contentHeight {
              return Reply<Message>.Emit { message: Message.Content { height: height } }
            }
            return Reply<Message>.Pass
          },
        )
        if self.kind == Kind.Churn {
          let shown = self.shown.asSlice()
          let mut i: usize = 0
          while i < shown.length {
            let item = &shown[i]
            let lines = self.corpus.item(item.index)
            ui.lazyKeyed(
              item.key,
              item.key,
              |ui| {
                ui.key(item.key)
                itemView(&mut ui, lines)
              },
            )
            i = i + 1
          }
          return ()
        }
        let mut i: usize = 0
        while i < self.size {
          let lines = self.corpus.item(i)
          let key = usize.toU64(i) + 1
          ui.lazyKeyed(
            key,
            key,
            |ui| {
              ui.key(key)
              itemView(&mut ui, lines)
            },
          )
          i = i + 1
        }
        let streamed = self.streamed.asSlice()
        let mut s: usize = 0
        while s < streamed.length {
          let item = &streamed[s]
          let key = 100000 + usize.toU64(s)
          ui.lazyKeyed(
            key,
            item.version,
            |ui| {
              ui.key(key)
              streamedView(&mut ui, item)
            },
          )
          s = s + 1
        }
      },
    )
  }
}

impl App<Message, NoCommand> for Model {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.box(
      |ui| {
        ui.class("app")
        labelled(&mut ui, "bar", String.view(&self.title))
        ui.box(
          |ui| {
            ui.class("scroll")
            ui.on(
              EventKind.Layout,
              |event| {
                let height = event.bounds.yMax - event.bounds.yMin
                if f32.toF64(height) != self.viewHeight {
                  return Reply<Message>.Emit { message: Message.Viewport { height: height } }
                }
                return Reply<Message>.Pass
              },
            )
            if self.kind == Kind.Stream {
              // Pinned to the end: an offset past it, a different one each render so the tree
              // scrolls again as the stream grows.
              ui.scrollTo(0.0, if self.pin { 100000000.0 } else { 100000016.0 })
            } else if self.scrolled || self.top != 0.0 {
              ui.scrollTo(0.0, f64.toF32(self.top))
            }
            self.content(&mut ui)
          },
        )
      },
    )
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {
    match move message {
      Message.Frame { time } => {
        cx.alloc(self.frame(time))
      }
      Message.Viewport { height } => {
        self.viewHeight = f32.toF64(height)
      }
      Message.Content { height } => {
        self.contentHeight = f32.toF64(height)
      }
    }
  }

  fn subscriptions(self: &Self, subs: &mut Subscriptions<Message>) -> () {
    if self.done {
      return ()
    }
    if self.wantsFrames() {
      subs.animationFrame(1, |time| Message.Frame { time: time })
    } else {
      // Idle or holding after a mark: one timer for the end of it, no frames meanwhile. A new
      // key for each step, so each one starts its own timer.
      subs.every(100 + usize.toU64(self.step), self.wait(), |time| Message.Frame { time: time })
    }
  }
}

// ---------- the host ----------

struct Bar {}

impl WindowContent<Model, Message, NoCommand> for Bar {
  fn configure(self: &Self, options: &mut WindowOptions<'_>) -> () {
    options.titleBar = TitleBar.Transparent
    options.titleBarHeight = 40.0
    options.controlsLeft = 14.0
    options.controlsTop = 12.0
  }
}

effect fn windowed(name: String, platform: Option<Launched>) -> i32
  ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let bench = (run environmentVariable("SILK_UI_BENCH")).isSome()
  let gpu = if bench { Option<StartedGpu>.None } else { Option<StartedGpu>.some(run startGpu(false)) }
  let fonts = run systemFonts()
  let model = run Model.make(String.view(&name))
  let mut runtime = Runtime<Model, Message, NoCommand>.make(move model)
  let sheets = run StyleAssets.from(&[Source.read("assets/app.sheet")])
  let options = RunOptions {
    title: "xbench",
    width: WIDTH,
    height: HEIGHT,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: move platform,
    gpu: move gpu,
  }
  let mut content = Bar {}
  return run runWindowHostedWithSheets(
    &mut runtime,
    &fonts,
    List<Mutation>.make(),
    move options,
    Inspector.off(),
    &mut content,
    move sheets,
  )
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("silk-loom: failed (tree, window, GPU, atlas, geometry or allocation)\n", &())
  return 2
}

fn runWindowed(name: String, platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(windowed(move name, move platform), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sceneAsked() -> String ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  if (run HostInput.argumentCount()) > 1 {
    if let Option<Bytes>.Some { value } = run HostInput.argument(1) {
      return run String.copy(text(Bytes.asSlice(&value)))
    }
  }
  return run String.copy("feed")
}

effect fn feedDefault<E>(error: E) -> String {
  drop error
  return String.make()
}

pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let scene = run Effect.catchAll(sceneAsked(), feedDefault)
    |> Effect.provideMut<Allocator>(&mut allocator)
  // The main thread keeps the OS event loop; the app runs on its own thread.
  return run Effect.catchAll(
    launch(
      |platform: Option<Launched>| -> i32 {
        return runWindowed(move scene, move platform)
      },
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
