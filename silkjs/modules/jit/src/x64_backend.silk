        // object's slots (slotsValue), the slot is at the key's offset from them.
        let pair = u8.toU32(u8.shiftRight(fact, FACT_PAIR))
        let own = if pair != 0 { site.protoKeys[u32.toUsize(pair - 1)] == 0 } else { site.count == 1 && site.protoKeys[0] == 0 }
        let mut disp: i32 = 0
        if own && pair != 0 && (fact & FACT_OBJECT) != 0 && self.slotsHeld == inst.a && !joins && !hedged {
          disp = u64.wrappingToI32(u64.bitAnd(site.keys[u32.toUsize(pair - 1)], 65535)) * 16
        } else { disp = run self.siteSlot(inst.a, &site, fact, miss) }
        // What R11 holds after: the object's own slots, on the one way here.
        let ownSlots = own && !joins && !hedged && target == NONE && arms.length() == 0
        if !joins && !hedged && target == NONE && arms.length() == 0 && (inst.k & FIELD_STEPS) == 0 && self.fusedUnboxI32(&function, inst) {
          // As at a keyed site: the number from the slot R11 addresses, and the field to its
          // slot only on the way to the unbox's exit (coldPieces, at 0 from R11).
          self.omitAt = self.unboxAt(&function, inst)
          let unbox = function.inst(self.omitAt)
          let cold = run self.a.label()
          let back = run self.a.label()
          run self.loadInt(unbox, Reg.R11, disp, cold)
          run self.coldLabels.append(cold) run self.coldBacks.append(back) run self.coldInsts.append(inst) run self.coldAux.append(unbox.exit) run self.coldElements.append(addressedAt(disp))
          self.a.bind(back)
