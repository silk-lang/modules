//! Web views driven by text: the form JavaScript's calls and the views' events take on their
//! way between a ui-js realm and the thread that owns the views.
//!
//! A call is an op and its fields, separated by U+001F; the last field may hold anything:
//!
//! - 40, open: view, node, url, profile, flags (1 inspectable, 2 ask before navigating,
//!   4 transparent). Answered with 1 when the view opened.
//! - 41, close: view.
//! - 42, a command: view, its name, its fields (see [`commandOf`]).
//! - 43, clear data: request, cookies (0 or 1), cache (0 or 1), profile.
//!
//! An event is a view, a code (native/bridge.h's `SILK_WEBVIEW_*` numbers) and fields (see
//! [`encode`]). Numbers are decimal; fractions are thousandths.
import command { Command }
import event { WebViewEvent, EventKind }
import host { WebViewHost }
import types { WebViewOptions, Placement, ColorScheme, ConsoleLevel }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.encoding.base64 { Base64, Base64Error }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.text.string { String }

pub const OP_OPEN: u32 = 40

pub const OP_CLOSE: u32 = 41

pub const OP_COMMAND: u32 = 42

pub const OP_CLEAR: u32 = 43

const SEPARATOR: u8 = 31

/// An event of a view, as text.
pub struct WireEvent {
  pub view: u32,
  pub code: u32,
  pub text: String,
}

/// Views of backend `H`, served from calls as text.
pub struct WireViews<H> {
  pub views: H,
  /// The views open now.
  open: List<u32>,
}

impl<H: WebViewHost> WireViews<H> {
  pub fn make(views: H) -> WireViews<H> {
    return WireViews<H> { views: move views, open: List<u32>.make() }
  }

  /// Whether any view is open.
  pub fn any(self: &Self) -> bool {
    return self.open.length() != 0
  }

  /// Runs call `op` with `text`'s fields; views open in window `window`. The answer is 1 for a
  /// view that opened and 0 otherwise.
  pub effect fn serve(self: &mut Self, op: u32, window: u32, text: string) -> f64
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut fields = List<string>.make()
    if op == OP_OPEN {
      run split(text, 5, &mut fields)
      let view = number(field(&fields, 0))
      let flags = number(field(&fields, 4))
      let options = WebViewOptions {
        window: window,
        url: run String.copy(field(&fields, 2)),
        inspectable: (flags & 1) != 0,
        profile: run String.copy(field(&fields, 3)),
        askBeforeNavigating: (flags & 2) != 0,
        transparent: (flags & 4) != 0,
      }
      let opened = run Effect.result(self.views.open(view, &options))
      if let Result.Failure { .. } = &opened {
        return 0.0
      }
      run self.open.append(view)
      return 1.0
    }
    if op == OP_CLOSE {
      run split(text, 1, &mut fields)
      let view = number(field(&fields, 0))
      run self.views.close(view)
      let mut i: usize = 0
      while i < self.open.length() {
        if self.open.get(i) == view {
          drop self.open.remove(i)
        } else {
          i = i + 1
        }
      }
      return 0.0
    }
    if op == OP_COMMAND {
      run split(text, 2, &mut fields)
      let view = number(field(&fields, 0))
      let rest = field(&fields, 1)
      let mut parts = List<string>.make()
      run split(rest, 2, &mut parts)
      let name = field(&parts, 0)
      let mut args = List<string>.make()
      run split(field(&parts, 1), argumentCount(name), &mut args)
      if let Option<Command>.Some { value } = run commandOf(name, &args) {
        drop run Effect.result(self.views.send(view, move value))
      }
      return 0.0
    }
    if op == OP_CLEAR {
      run split(text, 4, &mut fields)
      run self.views.clearData(
        number(field(&fields, 0)),
        field(&fields, 3),
        number(field(&fields, 1)) != 0,
        number(field(&fields, 2)) != 0,
      )
      return 0.0
    }
    return 0.0
  }

  pub fn place(self: &mut Self, view: u32, placement: Placement) -> () {
    self.views.place(view, placement)
  }

  /// Moves the views' events, as text, onto the end of `out`.
  pub effect fn take(self: &mut Self, out: &mut List<WireEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut events = List<WebViewEvent>.make()
    run self.views.takeEvents(&mut events)
    while events.length() != 0 {
      let event = events.remove(0)
      let mut text = String.make()
      let code = run encode(&event.kind, &mut text)
      run out.append(WireEvent { view: event.view, code: code, text: move text })
    }
  }
}

/// How many fields command `name` takes; the last holds the rest of the text.
fn argumentCount(name: string) -> usize {
  if name == "loadHtml" || name == "fill" || name == "answer" || name == "key" || name == "evaluate"
    || name == "click" {
    return if name == "fill" {
      3
    } else {
      2
    }
  }
  if name == "clickAt" || name == "scroll" {
    return 5
  }
  if name == "move" {
    return 3
  }
  if name == "find" {
    return 4
  }
  return 1
}

/// The command named `name` with fields `args`, or none for a name this does not know.
pub effect fn commandOf(name: string, args: &List<string>) -> Option<Command>
  ! OutOfMemoryError
  ? &mut Allocator {
  let a0 = field(args, 0)
  let a1 = field(args, 1)
  let a2 = field(args, 2)
  let command = if name == "navigate" {
    Command.Navigate { url: run String.copy(a0) }
  } else if name == "loadHtml" {
    // baseUrl first: the page may hold anything.
    Command.LoadHtml { baseUrl: run String.copy(a0), html: run String.copy(a1) }
  } else if name == "back" {
    Command.Back
  } else if name == "forward" {
    Command.Forward
  } else if name == "reload" {
    Command.Reload
  } else if name == "hardReload" {
    Command.HardReload
  } else if name == "stop" {
    Command.Stop
  } else if name == "zoom" {
    Command.SetZoom { factor: f64.toF32(thousandths(a0)) }
  } else if name == "focus" {
    Command.Focus
  } else if name == "evaluate" {
    Command.Evaluate { request: number(a0), script: run String.copy(a1) }
  } else if name == "snapshot" {
    Command.Snapshot { request: number(a0) }
  } else if name == "screenshot" {
    Command.Screenshot { request: number(a0) }
  } else if name == "click" {
    Command.ClickElement { request: number(a0), element: run String.copy(a1) }
  } else if name == "fill" {
    Command.FillElement {
      request: number(a0),
      element: run String.copy(a1),
      text: run String.copy(a2),
    }
  } else if name == "clickAt" {
    Command.ClickAt {
      x: f64.toF32(thousandths(a0)),
      y: f64.toF32(thousandths(a1)),
      button: number(a2),
      clickCount: number(field(args, 3)),
      modifiers: number(field(args, 4)),
    }
  } else if name == "move" {
    Command.MovePointer {
      x: f64.toF32(thousandths(a0)),
      y: f64.toF32(thousandths(a1)),
      modifiers: number(a2),
    }
  } else if name == "scroll" {
    Command.Scroll {
      x: f64.toF32(thousandths(a0)),
      y: f64.toF32(thousandths(a1)),
      deltaX: f64.toF32(thousandths(a2)),
      deltaY: f64.toF32(thousandths(field(args, 3))),
      modifiers: number(field(args, 4)),
    }
  } else if name == "type" {
    Command.TypeText { text: run String.copy(a0) }
  } else if name == "key" {
    Command.PressKey { modifiers: number(a0), key: run String.copy(a1) }
  } else if name == "answer" {
    Command.AnswerNavigation { request: number(a0), allow: number(a1) != 0 }
  } else if name == "devtools" {
    Command.OpenDevTools
  } else if name == "mute" {
    Command.SetAudioMuted { muted: number(a0) != 0 }
  } else if name == "scheme" {
    let scheme = if a0 == "light" {
      ColorScheme.Light
    } else if a0 == "dark" {
      ColorScheme.Dark
    } else {
      ColorScheme.System
    }
    Command.SetColorScheme { scheme: scheme }
  } else if name == "find" {
    Command.FindInPage {
      request: number(a0),
      forward: number(a1) != 0,
      newSession: number(a2) != 0,
      text: run String.copy(field(args, 3)),
    }
  } else if name == "stopFind" {
    Command.StopFindInPage
  } else {
    return Option<Command>.None
  }
  return Option<Command>.some(move command)
}

/// Writes `kind`'s fields into `out` and says its code.
pub effect fn encode(kind: &EventKind, out: &mut String) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &kind.* {
    EventKind.Created => 1
    EventKind.Closed => 2
    EventKind.LoadStarted { url } => {
      run out.append(String.view(&url))
      3
    }
    EventKind.LoadProgress { fraction } => {
      run decimal(&mut out, f64.toU32(f64.max(0.0, f64.min(1.0, f32.toF64(fraction))) * 1000.0))
      4
    }
    EventKind.LoadFinished { url, ok, error, code } => {
      run flag(&mut out, ok)
      run separate(&mut out)
      run decimal(&mut out, i32.toU32(0 - code))
      run separate(&mut out)
      run out.append(String.view(&url))
      run separate(&mut out)
      run out.append(String.view(&error))
      5
    }
    EventKind.UrlChanged { url } => {
      run out.append(String.view(&url))
      6
    }
    EventKind.TitleChanged { title } => {
      run out.append(String.view(&title))
      7
    }
    EventKind.HistoryChanged { canGoBack, canGoForward } => {
      run flag(&mut out, canGoBack)
      run separate(&mut out)
      run flag(&mut out, canGoForward)
      8
    }
    EventKind.NavigationRequested { request, url, userInitiated } => {
      run decimal(&mut out, request)
      run separate(&mut out)
      run flag(&mut out, userInitiated)
      run separate(&mut out)
      run out.append(String.view(&url))
      9
    }
    EventKind.NewWindowRequested { url } => {
      run out.append(String.view(&url))
      10
    }
    EventKind.FocusChanged { focused } => {
      run flag(&mut out, focused)
      11
    }
    EventKind.ScriptResult { request, ok, value } => {
      run decimal(&mut out, request)
      run separate(&mut out)
      run flag(&mut out, ok)
      run separate(&mut out)
      run out.append(String.view(&value))
      12
    }
    EventKind.Snapshot { request, text } => {
      run decimal(&mut out, request)
      run separate(&mut out)
      run out.append(String.view(&text))
      13
    }
    EventKind.Screenshot { request, width, height, pixels } => {
      run decimal(&mut out, request)
      run separate(&mut out)
      run decimal(&mut out, width)
      run separate(&mut out)
      run decimal(&mut out, height)
      run separate(&mut out)
      run base64(&mut out, pixels.asSlice())
      14
    }
    EventKind.ActionResult { request, ok, error } => {
      run decimal(&mut out, request)
      run separate(&mut out)
      run flag(&mut out, ok)
      run separate(&mut out)
      run out.append(String.view(&error))
      15
    }
    EventKind.Console { level, message } => {
      let number: u32 = match level {
        ConsoleLevel.Debug => 0
        ConsoleLevel.Log => 1
        ConsoleLevel.Info => 2
        ConsoleLevel.Warning => 3
        ConsoleLevel.Error => 4
      }
      run decimal(&mut out, number)
      run separate(&mut out)
      run out.append(String.view(&message))
      16
    }
    EventKind.Unsupported { request, command } => {
      run decimal(&mut out, request)
      run separate(&mut out)
      run out.append(String.view(&command))
      17
    }
    EventKind.Crashed { reason } => {
      run out.append(String.view(&reason))
      18
    }
    EventKind.FaviconChanged { url } => {
      run out.append(String.view(&url))
      19
    }
    EventKind.FoundInPage { request, matches, active } => {
      run decimal(&mut out, request)
      run separate(&mut out)
      run decimal(&mut out, matches)
      run separate(&mut out)
      run decimal(&mut out, active)
      20
    }
    EventKind.DataCleared { request } => {
      run decimal(&mut out, request)
      21
    }
  }
}

effect fn separate(out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append("\u{1f}")
}

effect fn flag(out: &mut String, value: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(
    if value {
      "1"
    } else {
      "0"
    },
  )
}

effect fn decimal(out: &mut String, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut digits: [u8; 10] = [0; 10]
  let mut count: usize = 0
  let mut left = value
  while true {
    digits[9 - count] = u32.toU8(48 + left % 10)
    count = count + 1
    left = left / 10
    if left == 0 {
      break
    }
  }
  let mut i: usize = 10 - count
  while i < 10 {
    let one: [u8; 1] = [digits[i]]
    if let Result.Success { value: text } = String.fromUtf8(&one) {
      run out.append(text)
    }
    i = i + 1
  }
}

effect fn base64(out: &mut String, bytes: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let length = match Base64.encodedLength(bytes.length) {
    Result<usize, Base64Error>.Success { value } => value
    Result<usize, Base64Error>.Failure { .. } => {
      return ()
    }
  }
  let mut encoded = List<u8>.make()
  run encoded.appendRepeated(0, length)
  if let Result<usize, Base64Error>.Success { .. } = Base64.encodeInto(
    encoded.asMutSlice(),
    bytes,
  ) {
    if let Result.Success { value: text } = String.fromUtf8(encoded.asSlice()) {
      run out.append(text)
    }
  }
}

/// Splits `text` at U+001F into at most `count` fields: the last holds the rest.
effect fn split<'a>(text: string<'a>, count: usize, out: &mut List<string<'a>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length && out.length() + 1 < count {
    if bytes[i] == SEPARATOR {
      run out.append(String.slice(text, start, i - start))
      start = i + 1
    }
    i = i + 1
  }
  run out.append(String.slice(text, start, bytes.length - start))
}

fn field<'a>(fields: &List<string<'a>>, at: usize) -> string<'a> {
  if at < fields.length() {
    return fields.get(at)
  }
  return ""
}

fn number(text: string) -> u32 {
  let bytes = String.utf8Bytes(text)
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 {
    value = value * 10 + u8.toU32(bytes[i] - 48)
    i = i + 1
  }
  return value
}

/// A signed whole number of thousandths, as a value.
fn thousandths(text: string) -> f64 {
  let bytes = String.utf8Bytes(text)
  let negative = bytes.length > 0 && bytes[0] == 45
  let digits = if negative {
    String.slice(text, 1, bytes.length - 1)
  } else {
    text
  }
  let value = u32.toF64(number(digits)) / 1000.0
  return if negative {
    -value
  } else {
    value
  }
}
