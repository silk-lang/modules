import css_style.lexer
import css_style.syntax { RuleKind }
import css_style.syntax
import css_style.tokens { TokenBuffer, TokenRange, Kind, Limits, CssError, insensitive }
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.text.string { String }
import silk.encoding.base64 { Base64 }
import silk.uri.percent { UriPercent, PercentComponent }
import silk.url.url { Url }
import silk.url.percent { UrlPercent }

struct Reference { start: usize, end: usize, url: String }

effect fn references(buffer: &TokenBuffer, range: TokenRange, top: bool, out: &mut List<Reference>)
  ! CssError | OutOfMemoryError ? &mut Allocator {
  let limits = Limits.make()
  let rules = run syntax.parseRules(buffer,range,top,&limits)
  let mut i: usize = 0
  while i < rules.length() {
    let rule = rules.get(i)
    if rule.kind == RuleKind.AtBlock {
      if insensitive(buffer.text(rule.name),b"font-face") {
        let declarations = run syntax.parseDeclarations(buffer,rule.body,&limits)
        let mut d: usize = 0
        while d < declarations.length() {
          let declaration = declarations.get(d)
          if !declaration.important && insensitive(buffer.text(declaration.name),b"src") {
            let mut at = declaration.value.start
            while at < declaration.value.end {
              let token = buffer.tokens.asSlice()[at]
              let mut end = at + 1
              let text = match token.kind {
                Kind.Url { text } => buffer.text(text)
                Kind.Function { name } => {
                  end = if token.matching < declaration.value.end { token.matching + 1 } else { declaration.value.end }
                  let mut inner = at + 1
                  while inner < end && match buffer.tokens.asSlice()[inner].kind { Kind.Whitespace => true _ => false } { inner = inner + 1 }
                  if insensitive(buffer.text(name),b"url") && inner < end {
                    match buffer.tokens.asSlice()[inner].kind { Kind.String { text } => buffer.text(text) _ => b"" }
                  } else { b"" }
                }
                _ => b""
              }
              if text.length != 0 {
                if let Result.Success { value } = String.fromUtf8(text) {
                  run out.append(Reference { start: token.source.start, end: buffer.tokens.asSlice()[end - 1].source.end, url: run String.copy(value) })
                }
              }
              at = end
            }
          }
          d = d + 1
        }
      } else { run references(buffer,rule.body,false,&mut out) }
    }
    i = i + 1
  }
}

effect fn localPath(root: string, source: string, url: string) -> Option<Path>
  ! FileError | OutOfMemoryError ? &mut Allocator {
  if String.startsWith(url,"//") || String.startsWith(url,"#") { return Option<Path>.None }
  let encoded = run UriPercent.encodeOwned(String.utf8Bytes(source),PercentComponent.Path)
  let mut baseText = run String.copy("file://")
  run String.append(&mut baseText,String.view(&encoded))
  let base = run Url.parse(String.view(&baseText),Option<&'static Url>.None)
  let parsed = match &base { Option.Some { value } => run Url.parse(url,Option<&Url>.some(&value)) _ => Option<Url>.None }
  if let Option.Some { value } = &parsed {
    if value.scheme() != "file" || (value.hostname() != "" && value.hostname() != "localhost") { return Option<Path>.None }
    let mut decoded = String.make()
    run UrlPercent.appendDecodedText(&mut decoded,String.utf8Bytes(value.pathname()),false)
    let basePath = run Path.make(if String.startsWith(url,"/") { root } else { "/" })
    let path = String.view(&decoded)
    let child = if String.startsWith(path,"/") { String.slice(path,1,String.byteLength(path)-1) } else { path }
    return Option<Path>.some(run Path.resolve(&basePath,child))
  }
  return Option<Path>.None
}

effect fn dataUrl(data: &[u8]) -> Bytes ! TaskError | OutOfMemoryError ? &mut Allocator {
  let length = match Base64.encodedLength(data.length) { Result.Success { value } => value _ => run Task.abort("silkui: font asset is too large") }
  if length > Limits.make().maxStorageBytes { run Task.abort("silkui: font asset exceeds the 64 MiB stylesheet limit") }
  let mut encoded = run Bytes.zeroed(length)
  if let Result.Failure { .. } = Base64.encodeInto(encoded.asMutSlice(),data) { run Task.abort("silkui: could not encode font asset") }
  let mut out = run Bytes.copy(b"url(\"data:application/octet-stream;base64,")
  run out.append(encoded.asSlice())
  run out.append(b"\")")
  return move out
}

effect fn rewrite(source: &[u8], root: string, path: string) -> Bytes
  ! CssError | TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let buffer = run lexer.tokenize(source,&Limits.make())
  let mut urls = List<Reference>.make()
  run references(&buffer,buffer.all(),true,&mut urls)
  let mut out = Bytes.make()
  let mut previous: usize = 0
  let mut i: usize = 0
  while i < urls.length() {
    let reference = &urls.asSlice()[i]
    if let Option.Some { value } = run localPath(root,path,String.view(&reference.url)) {
      if !run FileSystem.exists(&value) {
        let mut message = run String.copy("silkui: font asset not found: ")
        run String.append(&mut message,value.view().unwrapOr("<invalid path>"))
        fail TaskError { message: move message, status: 1 }
      }
      let font = run FileSystem.readFile(&value)
      let replacement = run dataUrl(font.asSlice())
      run out.append(Slice.view<u8>(buffer.source(),previous,reference.start - previous))
      if out.length() + replacement.length() > Limits.make().maxStorageBytes { run Task.abort("silkui: bundled fonts exceed the 64 MiB stylesheet limit") }
      run out.append(replacement.asSlice())
      previous = reference.end
    }
    i = i + 1
  }
  if out.length() + buffer.source().length - previous > Limits.make().maxStorageBytes { run Task.abort("silkui: bundled fonts exceed the 64 MiB stylesheet limit") }
  run out.append(Slice.view<u8>(buffer.source(),previous,buffer.source().length - previous))
  return move out
}

effect fn invalid(error: CssError) -> never ! TaskError | OutOfMemoryError ? &mut Allocator {
  drop error
  run Task.abort("silkui: could not tokenize stylesheet font assets")
}

pub effect fn bundle(source: &[u8], root: string, path: string) -> Bytes
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  return run Effect.catch<CssError>(rewrite(source,root,path),invalid)
}
