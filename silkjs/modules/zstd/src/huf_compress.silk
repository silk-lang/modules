//! Huffman table building and encoding: a port of `lib/compress/huf_compress.c` of Zstandard 1.5.7.
//!
//! A `HUF_CElt` table is an array of 257 `u64` behind a byte pointer: element 0 is the header
//! (`tableLog` in byte 0, `maxSymbolValue` in byte 1), element `s + 1` is the code of symbol `s`,
//! with the number of bits in the low byte and the code in the high bits. Every function is
//! `unsafe`: the caller proves the sizes the reference asks for.
import mem
import errors
import hist
import fse_compress as fse
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u16
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.usize

pub const TABLELOG_MAX: u32 = 12
pub const TABLELOG_DEFAULT: u32 = 11
pub const SYMBOLVALUE_MAX: u32 = 255
pub const BLOCKSIZE_MAX: usize = 131072
/// The bytes of a `HUF_CElt` table for 256 symbols (`HUF_CTABLE_SIZE_ST(255) * 8`).
pub const CTABLE_BYTES: usize = 2056
/// `HUF_WORKSPACE_SIZE`.
pub const WORKSPACE_SIZE: usize = 8704

/// `HUF_repeat_none`: the previous table cannot be used.
pub const REPEAT_NONE: u32 = 0
/// `HUF_repeat_check`: the previous table can be used after a check.
pub const REPEAT_CHECK: u32 = 1
/// `HUF_repeat_valid`: the previous table can be used.
pub const REPEAT_VALID: u32 = 2

pub const FLAG_BMI2: u32 = 1
pub const FLAG_OPTIMAL_DEPTH: u32 = 2
pub const FLAG_PREFER_REPEAT: u32 = 4
pub const FLAG_SUSPECT_UNCOMPRESSIBLE: u32 = 8

// Layout of `HUF_compress_tables_t` inside the workspace.
const T_COUNT: usize = 0
const T_CTABLE: usize = 1024
const T_WKSPS: usize = 3080
const T_SIZE: usize = 7944
// `sizeof(HUF_buildCTable_wksp_tables)`: 512 nodes of 8 bytes, 192 rank positions of 4 bytes.
const BUILD_WKSP_SIZE: usize = 4864
const RANK_POSITION: usize = 4096
// Layout of `HUF_CompressWeightsWksp` and `HUF_WriteCTableWksp`.
const CW_CTABLE: usize = 0
const CW_SCRATCH: usize = 236
const CW_SCRATCH_SIZE: usize = 164
const CW_COUNT: usize = 400
const CW_NORM: usize = 452
const CW_SIZE: usize = 480
const WR_BITS_TO_WEIGHT: usize = 480
const WR_HUFF_WEIGHT: usize = 493
const WR_SIZE: usize = 748

const RANK_POSITION_TABLE_SIZE: u32 = 192
const RANK_POSITION_LOG_BUCKETS_BEGIN: u32 = 158
const RANK_POSITION_DISTINCT_COUNT_CUTOFF: u32 = 165
const STARTNODE: i32 = 256

@inlineAlways
unsafe fn elt(ctable: [*]const u8, index: usize) -> u64 { return unsafe mem.r64(ctable, usize.wrappingMultiply(index, 8)) }
@inlineAlways
unsafe fn cnt(count: [*]const u8, s: usize) -> u32 { return unsafe mem.r32(count, usize.wrappingMultiply(s, 4)) }

/// The `tableLog` of a CTable (`HUF_readCTableHeader(ctable).tableLog`).
@inlineAlways
pub unsafe fn tableLogOf(ctable: [*]const u8) -> u32 { return u8.toU32(unsafe mem.r8(ctable, 0)) }
/// The `maxSymbolValue` of a CTable.
@inlineAlways
pub unsafe fn maxSymbolValueOf(ctable: [*]const u8) -> u32 { return u8.toU32(unsafe mem.r8(ctable, 1)) }

unsafe fn writeCTableHeader(ctable: [*]mut u8, tableLog: u32, maxSymbolValue: u32) -> () {
  unsafe mem.w64(ctable, 0, u32.toU64(tableLog & 255) | u64.shiftLeft(u32.toU64(maxSymbolValue & 255), 8))
}

/// `HUF_getNbBitsFromCTable`.
pub unsafe fn getNbBitsFromCTable(ctable: [*]const u8, symbolValue: u32) -> u32 {
  if symbolValue > unsafe maxSymbolValueOf(ctable) { return 0 }
  return u64.wrappingToU32(unsafe elt(ctable, mem.z(symbolValue) + 1) & 255)
}

// `HUF_compressWeights`.
unsafe fn compressWeights(dst: [*]mut u8, dstSize: usize, weightTable: [*]const u8, wtSize: usize, wksp: [*]mut u8) -> usize {
  let mut op: usize = 0
  let mut maxSymbolValue: u32 = TABLELOG_MAX
  let mut tableLog: u32 = 6
  let count = unsafe mem.add(wksp, CW_COUNT)
  let nrm = unsafe mem.add(wksp, CW_NORM)
  let ctable = unsafe mem.add(wksp, CW_CTABLE)
  if wtSize <= 1 { return 0 }
  let maxCount = unsafe hist.countSimple(count, &mut maxSymbolValue, weightTable, wtSize)
  if mem.z(maxCount) == wtSize { return 1 }
  if maxCount == 1 { return 0 }
  tableLog = fse.optimalTableLog(tableLog, wtSize, maxSymbolValue)
  let e1 = unsafe fse.normalizeCount(nrm, tableLog, unsafe mem.ro(count), wtSize, maxSymbolValue, false)
  if errors.isError(e1) { return e1 }
  let hSize = unsafe fse.writeNCount(dst, dstSize, unsafe mem.ro(nrm), maxSymbolValue, tableLog)
  if errors.isError(hSize) { return hSize }
  op = op + hSize
  let e2 = unsafe fse.buildCTable(ctable, unsafe mem.ro(nrm), maxSymbolValue, tableLog, unsafe mem.add(wksp, CW_SCRATCH), CW_SCRATCH_SIZE)
  if errors.isError(e2) { return e2 }
  let cSize = unsafe fse.compressUsingCTable(unsafe mem.add(dst, op), dstSize - op, weightTable, wtSize, unsafe mem.ro(ctable))
  if errors.isError(cSize) { return cSize }
  if cSize == 0 { return 0 }
  op = op + cSize
  return op
}

/// `HUF_writeCTable_wksp`: writes the description of `ctable` at `dst`. `workspace` has at least
/// 748 bytes and is aligned to 4.
pub unsafe fn writeCTable(dst: [*]mut u8, maxDstSize: usize, ctable: [*]const u8, maxSymbolValue: u32, huffLog: u32, workspace: [*]mut u8, workspaceSize: usize) -> usize {
  let bitsToWeight = unsafe mem.add(workspace, WR_BITS_TO_WEIGHT)
  let huffWeight = unsafe mem.add(workspace, WR_HUFF_WEIGHT)
  if workspaceSize < WR_SIZE { return errors.err(errors.E_GENERIC) }
  if maxSymbolValue > SYMBOLVALUE_MAX { return errors.err(errors.E_MAXSYMBOLVALUE_TOOLARGE) }
  // Convert to weights.
  unsafe mem.w8(bitsToWeight, 0, 0)
  let mut n: u32 = 1
  while n < huffLog + 1 {
    unsafe mem.w8(bitsToWeight, mem.z(n), u32.wrappingToU8(huffLog + 1 - n))
    n = n + 1
  }
  n = 0
  while n < maxSymbolValue {
    let nbBits = u64.toUsize(unsafe elt(ctable, mem.z(n) + 1) & 255)
    unsafe mem.w8(huffWeight, mem.z(n), unsafe mem.r8(unsafe mem.ro(bitsToWeight), nbBits))
    n = n + 1
  }
  // Attempt weights compression by FSE.
  if maxDstSize < 1 { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
  let hSize = unsafe compressWeights(unsafe mem.add(dst, 1), maxDstSize - 1, unsafe mem.ro(huffWeight), mem.z(maxSymbolValue), workspace)
  if errors.isError(hSize) { return hSize }
  if hSize > 1 && hSize < mem.z(maxSymbolValue / 2) {
    unsafe mem.w8(dst, 0, usize.wrappingToU8(hSize))
    return hSize + 1
  }
  // Write raw values as 4-bit fields (at most 15).
  if maxSymbolValue > (256 - 128) { return errors.err(errors.E_GENERIC) }
  if mem.z((maxSymbolValue + 1) / 2) + 1 > maxDstSize { return errors.err(errors.E_DSTSIZE_TOOSMALL) }
  unsafe mem.w8(dst, 0, u32.wrappingToU8(128 + (maxSymbolValue - 1)))
  unsafe mem.w8(huffWeight, mem.z(maxSymbolValue), 0)
  n = 0
  while n < maxSymbolValue {
    let hi = u8.toU32(unsafe mem.r8(unsafe mem.ro(huffWeight), mem.z(n)))
    let lo = u8.toU32(unsafe mem.r8(unsafe mem.ro(huffWeight), mem.z(n) + 1))
    unsafe mem.w8(dst, mem.z(n / 2) + 1, u32.wrappingToU8(u32.shiftLeft(hi, 4) + lo))
    n = n + 2
  }
  return mem.z((maxSymbolValue + 1) / 2) + 1
}

// ---- Tree nodes: `nodeElt { u32 count; u16 parent; u8 byte; u8 nbBits }`, 8 bytes each. ----
// `nodes` points at `huffNode0`; node `i` of the reference's `huffNode` is at `8 * (i + 1)`.

@inlineAlways
fn nodeAt(i: i32) -> usize { return i32.wrappingToUsize(i32.wrappingAdd(i, 1)) * 8 }
@inlineAlways
unsafe fn nCount(nodes: [*]mut u8, i: i32) -> u32 { return unsafe mem.r32(unsafe mem.ro(nodes), nodeAt(i)) }
@inlineAlways
unsafe fn setNCount(nodes: [*]mut u8, i: i32, v: u32) -> () { unsafe mem.w32(nodes, nodeAt(i), v) }
@inlineAlways
unsafe fn nParent(nodes: [*]mut u8, i: i32) -> i32 { return u16.toI32(unsafe mem.r16(unsafe mem.ro(nodes), nodeAt(i) + 4)) }
@inlineAlways
unsafe fn setNParent(nodes: [*]mut u8, i: i32, v: i32) -> () { unsafe mem.w16(nodes, nodeAt(i) + 4, i32.wrappingToU16(v)) }
@inlineAlways
unsafe fn nByte(nodes: [*]mut u8, i: i32) -> u8 { return unsafe mem.r8(unsafe mem.ro(nodes), nodeAt(i) + 6) }
@inlineAlways
unsafe fn nBits(nodes: [*]mut u8, i: i32) -> u32 { return u8.toU32(unsafe mem.r8(unsafe mem.ro(nodes), nodeAt(i) + 7)) }
@inlineAlways
unsafe fn setNBits(nodes: [*]mut u8, i: i32, v: u32) -> () { unsafe mem.w8(nodes, nodeAt(i) + 7, u32.wrappingToU8(v)) }
@inlineAlways
unsafe fn nWhole(nodes: [*]mut u8, i: i32) -> u64 { return unsafe mem.r64(unsafe mem.ro(nodes), nodeAt(i)) }
@inlineAlways
unsafe fn setNWhole(nodes: [*]mut u8, i: i32, v: u64) -> () { unsafe mem.w64(nodes, nodeAt(i), v) }

// `HUF_setMaxHeight`: enforces `targetNbBits` on the tree, and returns the largest length.
unsafe fn setMaxHeight(nodes: [*]mut u8, lastNonNull: u32, targetNbBits: u32) -> u32 {
  let largestBits = unsafe nBits(nodes, u32.toI32(lastNonNull))
  if largestBits <= targetNbBits { return largestBits }
  let mut totalCost: i32 = 0
  let baseCost: i32 = u32.toI32(mem.shl32(1, largestBits - targetNbBits))
  let mut n: i32 = u32.toI32(lastNonNull)
  while unsafe nBits(nodes, n) > targetNbBits {
    totalCost = totalCost + (baseCost - u32.toI32(mem.shl32(1, largestBits - unsafe nBits(nodes, n))))
    unsafe setNBits(nodes, n, targetNbBits)
    n = n - 1
  }
  // `n` stops at a node with nbBits <= targetNbBits; the cost of the others is now repaid.
  while unsafe nBits(nodes, n) == targetNbBits { n = n - 1 }
  totalCost = i32.shiftRight(totalCost, u32.toI32((largestBits - targetNbBits) & 31))
  let noSymbol: u32 = 0xF0F0F0F0
  let mut rankLast: [u32; 14] = [0xF0F0F0F0; 14]
  // Get the position of the last (smallest count) symbol of each rank.
  let mut currentNbBits = targetNbBits
  let mut pos = n
  while pos >= 0 {
    let b = unsafe nBits(nodes, pos)
    if b < currentNbBits {
      currentNbBits = b
      rankLast[mem.z(targetNbBits - currentNbBits)] = i32.wrappingToU32(pos)
    }
    pos = pos - 1
  }
  while totalCost > 0 {
    let mut nBitsToDecrease = mem.highbit32(i32.wrappingToU32(totalCost)) + 1
    while nBitsToDecrease > 1 {
      let highPos = rankLast[mem.z(nBitsToDecrease)]
      let lowPos = rankLast[mem.z(nBitsToDecrease - 1)]
      if highPos != noSymbol {
        if lowPos == noSymbol { break }
        let highTotal = unsafe nCount(nodes, u32.wrappingToI32(highPos))
        let lowTotal = mem.m32(2, unsafe nCount(nodes, u32.wrappingToI32(lowPos)))
        if highTotal <= lowTotal { break }
      }
      nBitsToDecrease = nBitsToDecrease - 1
    }
    // Only triggered when no more rank-1 symbol is left: go to the closest rank with a symbol.
    while nBitsToDecrease <= TABLELOG_MAX && rankLast[mem.z(nBitsToDecrease)] == noSymbol { nBitsToDecrease = nBitsToDecrease + 1 }
    totalCost = totalCost - u32.toI32(mem.shl32(1, nBitsToDecrease - 1))
    let target = u32.wrappingToI32(rankLast[mem.z(nBitsToDecrease)])
    unsafe setNBits(nodes, target, unsafe nBits(nodes, target) + 1)
    if rankLast[mem.z(nBitsToDecrease - 1)] == noSymbol {
      rankLast[mem.z(nBitsToDecrease - 1)] = rankLast[mem.z(nBitsToDecrease)]
    }
    if rankLast[mem.z(nBitsToDecrease)] == 0 {
      rankLast[mem.z(nBitsToDecrease)] = noSymbol
    } else {
      rankLast[mem.z(nBitsToDecrease)] = rankLast[mem.z(nBitsToDecrease)] - 1
      if unsafe nBits(nodes, u32.wrappingToI32(rankLast[mem.z(nBitsToDecrease)])) != targetNbBits - nBitsToDecrease {
        rankLast[mem.z(nBitsToDecrease)] = noSymbol
      }
    }
  }
  // The cost can be negative after an overshoot: give bits back to rank-1 symbols.
  while totalCost < 0 {
    if rankLast[1] == noSymbol {
      while unsafe nBits(nodes, n) == targetNbBits { n = n - 1 }
      unsafe setNBits(nodes, n + 1, unsafe nBits(nodes, n + 1) - 1)
      rankLast[1] = i32.wrappingToU32(n + 1)
      totalCost = totalCost + 1
    } else {
      let target = u32.wrappingToI32(rankLast[1]) + 1
      unsafe setNBits(nodes, target, unsafe nBits(nodes, target) - 1)
      rankLast[1] = rankLast[1] + 1
      totalCost = totalCost + 1
    }
  }
  return targetNbBits
}

@inlineAlways
fn getIndex(count: u32) -> u32 {
  if count < RANK_POSITION_DISTINCT_COUNT_CUTOFF { return count }
  return mem.highbit32(count) + RANK_POSITION_LOG_BUCKETS_BEGIN
}

// The sort helpers work on `arr`, a pointer to the first node of a bucket, with plain indices.
@inlineAlways
unsafe fn aCount(arr: [*]mut u8, i: i32) -> u32 { return unsafe mem.r32(unsafe mem.ro(arr), i32.wrappingToUsize(i) * 8) }
@inlineAlways
unsafe fn aGet(arr: [*]mut u8, i: i32) -> u64 { return unsafe mem.r64(unsafe mem.ro(arr), i32.wrappingToUsize(i) * 8) }
@inlineAlways
unsafe fn aSet(arr: [*]mut u8, i: i32, v: u64) -> () { unsafe mem.w64(arr, i32.wrappingToUsize(i) * 8, v) }
@inlineAlways
unsafe fn aSwap(arr: [*]mut u8, i: i32, j: i32) -> () {
  let t = unsafe aGet(arr, i)
  unsafe aSet(arr, i, unsafe aGet(arr, j))
  unsafe aSet(arr, j, t)
}

// `HUF_insertionSort`: sorts `arr[low..=high]` by decreasing count.
unsafe fn insertionSort(arr0: [*]mut u8, low: i32, high: i32) -> () {
  let size = high - low + 1
  let arr = unsafe mem.add(arr0, i32.wrappingToUsize(low) * 8)
  let mut i: i32 = 1
  while i < size {
    let key = unsafe aGet(arr, i)
    let keyCount = u64.wrappingToU32(key)
    let mut j = i - 1
    while j >= 0 && unsafe aCount(arr, j) < keyCount {
      unsafe aSet(arr, j + 1, unsafe aGet(arr, j))
      j = j - 1
    }
    unsafe aSet(arr, j + 1, key)
    i = i + 1
  }
}

// `HUF_quickSortPartition`: the pivot is `arr[high]`.
unsafe fn quickSortPartition(arr: [*]mut u8, low: i32, high: i32) -> i32 {
  let pivot = unsafe aCount(arr, high)
  let mut i = low - 1
  let mut j = low
  while j < high {
    if unsafe aCount(arr, j) > pivot {
      i = i + 1
      unsafe aSwap(arr, i, j)
    }
    j = j + 1
  }
  unsafe aSwap(arr, i + 1, high)
  return i + 1
}

// `HUF_simpleQuickSort`: recurses on the smaller side.
unsafe fn simpleQuickSort(arr: [*]mut u8, low0: i32, high0: i32) -> () {
  let mut low = low0
  let mut high = high0
  if high - low < 8 {
    unsafe insertionSort(arr, low, high)
    return ()
  }
  while low < high {
    let idx = unsafe quickSortPartition(arr, low, high)
    if idx - low < high - idx {
      unsafe simpleQuickSort(arr, low, idx - 1)
      low = idx + 1
    } else {
      unsafe simpleQuickSort(arr, idx + 1, high)
      high = idx - 1
    }
  }
}

// `HUF_sort`: sorts the symbols by decreasing count into `huffNode` (`nodes + 8`).
unsafe fn sort(nodes: [*]mut u8, count: [*]const u8, maxSymbolValue: u32, rankPosition: [*]mut u8) -> () {
  let maxSymbolValue1 = maxSymbolValue + 1
  let rp = unsafe mem.ro(rankPosition)
  let _m = unsafe mem.memset(rankPosition, 0, 768)
  let mut n: u32 = 0
  while n < maxSymbolValue1 {
    let lowerRank = mem.z(getIndex(unsafe cnt(count, mem.z(n))))
    unsafe mem.w16(rankPosition, lowerRank * 4, u16.wrappingAdd(unsafe mem.r16(rp, lowerRank * 4), 1))
    n = n + 1
  }
  n = RANK_POSITION_TABLE_SIZE - 1
  while n > 0 {
    let at = mem.z(n - 1) * 4
    let base = u16.wrappingAdd(unsafe mem.r16(rp, at), unsafe mem.r16(rp, mem.z(n) * 4))
    unsafe mem.w16(rankPosition, at, base)
    unsafe mem.w16(rankPosition, at + 2, base)
    n = n - 1
  }
  n = 0
  while n < maxSymbolValue1 {
    let c = unsafe cnt(count, mem.z(n))
    let r = mem.z(getIndex(c) + 1)
    let pos = unsafe mem.r16(rp, r * 4 + 2)
    unsafe mem.w16(rankPosition, r * 4 + 2, u16.wrappingAdd(pos, 1))
    unsafe setNCount(nodes, u16.toI32(pos), c)
    unsafe mem.w8(nodes, nodeAt(u16.toI32(pos)) + 6, u32.wrappingToU8(n))
    n = n + 1
  }
  n = RANK_POSITION_DISTINCT_COUNT_CUTOFF
  while n < RANK_POSITION_TABLE_SIZE - 1 {
    let base = unsafe mem.r16(rp, mem.z(n) * 4)
    let curr = unsafe mem.r16(rp, mem.z(n) * 4 + 2)
    let bucketSize = u16.toI32(curr) - u16.toI32(base)
    if bucketSize > 1 {
      unsafe simpleQuickSort(unsafe mem.add(nodes, nodeAt(u16.toI32(base))), 0, bucketSize - 1)
    }
    n = n + 1
  }
}

// `HUF_buildTree`: returns the rank of the last symbol with a count.
unsafe fn buildTree(nodes: [*]mut u8, maxSymbolValue: u32) -> i32 {
  let mut nodeNb: i32 = STARTNODE
  let mut nonNullRank: i32 = u32.toI32(maxSymbolValue)
  while unsafe nCount(nodes, nonNullRank) == 0 { nonNullRank = nonNullRank - 1 }
  let mut lowS = nonNullRank
  let nodeRoot = nodeNb + lowS - 1
  let mut lowN = nodeNb
  unsafe setNCount(nodes, nodeNb, mem.a32(unsafe nCount(nodes, lowS), unsafe nCount(nodes, lowS - 1)))
  unsafe setNParent(nodes, lowS, nodeNb)
  unsafe setNParent(nodes, lowS - 1, nodeNb)
  nodeNb = nodeNb + 1 lowS = lowS - 2
  let mut n = nodeNb
  while n <= nodeRoot { unsafe setNCount(nodes, n, 0x40000000) n = n + 1 }
  // A fake entry, strong barrier.
  unsafe setNCount(nodes, -1, 0x80000000)
  while nodeNb <= nodeRoot {
    let mut n1: i32 = 0
    let mut n2: i32 = 0
    if unsafe nCount(nodes, lowS) < unsafe nCount(nodes, lowN) { n1 = lowS lowS = lowS - 1 } else { n1 = lowN lowN = lowN + 1 }
    if unsafe nCount(nodes, lowS) < unsafe nCount(nodes, lowN) { n2 = lowS lowS = lowS - 1 } else { n2 = lowN lowN = lowN + 1 }
    unsafe setNCount(nodes, nodeNb, mem.a32(unsafe nCount(nodes, n1), unsafe nCount(nodes, n2)))
    unsafe setNParent(nodes, n1, nodeNb)
    unsafe setNParent(nodes, n2, nodeNb)
    nodeNb = nodeNb + 1
  }
  // Distribute weights (unlimited tree height).
  unsafe setNBits(nodes, nodeRoot, 0)
  n = nodeRoot - 1
  while n >= STARTNODE {
    unsafe setNBits(nodes, n, unsafe nBits(nodes, unsafe nParent(nodes, n)) + 1)
    n = n - 1
  }
  n = 0
  while n <= nonNullRank {
    unsafe setNBits(nodes, n, unsafe nBits(nodes, unsafe nParent(nodes, n)) + 1)
    n = n + 1
  }
  return nonNullRank
}

// `HUF_buildCTableFromTree`.
unsafe fn buildCTableFromTree(ctable: [*]mut u8, nodes: [*]mut u8, nonNullRank: i32, maxSymbolValue: u32, maxNbBits: u32) -> () {
  let mut nbPerRank: [u16; 16] = [0; 16]
  let mut valPerRank: [u16; 16] = [0; 16]
  let alphabetSize: i32 = u32.toI32(maxSymbolValue + 1)
  let mut n: i32 = 0
  while n <= nonNullRank {
    let b = mem.z(unsafe nBits(nodes, n)) & 15
    nbPerRank[b] = u16.wrappingAdd(nbPerRank[b], 1)
    n = n + 1
  }
  // Determine the starting value per rank.
  let mut min: u16 = 0
  let mut r = maxNbBits
  while r > 0 {
    valPerRank[mem.z(r) & 15] = min
    min = u16.wrappingAdd(min, nbPerRank[mem.z(r) & 15])
    min = u16.shiftRight(min, 1)
    r = r - 1
  }
  n = 0
  while n < alphabetSize {
    unsafe mem.w64(ctable, 8 + u8.toUsize(unsafe nByte(nodes, n)) * 8, u32.toU64(unsafe nBits(nodes, n)))
    n = n + 1
  }
  n = 0
  while n < alphabetSize {
    let at = 8 + i32.toUsize(n) * 8
    let e = unsafe mem.r64(unsafe mem.ro(ctable), at)
    let nbBits = u64.wrappingToU32(e & 255)
    let value = valPerRank[mem.z(nbBits) & 15]
    valPerRank[mem.z(nbBits) & 15] = u16.wrappingAdd(value, 1)
    if nbBits > 0 {
      unsafe mem.w64(ctable, at, e | mem.shl64(u16.toU64(value), 64 - nbBits))
    }
    n = n + 1
  }
  unsafe writeCTableHeader(ctable, maxNbBits, maxSymbolValue)
}

/// `HUF_buildCTable_wksp`: builds the table of `count[0..=maxSymbolValue]` with codes of at most
/// `maxNbBits` bits, and returns the largest length. `workSpace` has 4864 bytes, aligned to 4.
pub unsafe fn buildCTable(ctable: [*]mut u8, count: [*]const u8, maxSymbolValue: u32, maxNbBits0: u32, workSpace: [*]mut u8, wkspSize: usize) -> usize {
  let mut maxNbBits = maxNbBits0
  let nodes = workSpace
  if wkspSize < BUILD_WKSP_SIZE { return errors.err(errors.E_WORKSPACE_TOOSMALL) }
  if maxNbBits == 0 { maxNbBits = TABLELOG_DEFAULT }
  if maxSymbolValue > SYMBOLVALUE_MAX { return errors.err(errors.E_MAXSYMBOLVALUE_TOOLARGE) }
  let _m = unsafe mem.memset(nodes, 0, 4096)
  unsafe sort(nodes, count, maxSymbolValue, unsafe mem.add(workSpace, RANK_POSITION))
  let nonNullRank = unsafe buildTree(nodes, maxSymbolValue)
  maxNbBits = unsafe setMaxHeight(nodes, i32.wrappingToU32(nonNullRank), maxNbBits)
  if maxNbBits > TABLELOG_MAX { return errors.err(errors.E_GENERIC) }
  unsafe buildCTableFromTree(ctable, nodes, nonNullRank, maxSymbolValue, maxNbBits)
  return mem.z(maxNbBits)
}

/// `HUF_estimateCompressedSize`.
pub unsafe fn estimateCompressedSize(ctable: [*]const u8, count: [*]const u8, maxSymbolValue: u32) -> usize {
  let mut nbBits: usize = 0
  let mut s: u32 = 0
  while s <= maxSymbolValue {
    nbBits = mem.ua(nbBits, usize.wrappingMultiply(u64.toUsize(unsafe elt(ctable, mem.z(s) + 1) & 255), mem.z(unsafe cnt(count, mem.z(s)))))
    s = s + 1
  }
  return usize.shiftRight(nbBits, 3)
}

/// `HUF_validateCTable`: whether `ctable` has a code for each symbol of `count`.
pub unsafe fn validateCTable(ctable: [*]const u8, count: [*]const u8, maxSymbolValue: u32) -> bool {
  let mut bad = false
  if unsafe maxSymbolValueOf(ctable) < maxSymbolValue { return false }
  let mut s: u32 = 0
  while s <= maxSymbolValue {
    if unsafe cnt(count, mem.z(s)) != 0 && (unsafe elt(ctable, mem.z(s) + 1) & 255) == 0 { bad = true }
    s = s + 1
  }
  return !bad
}

// ---- Encoding (`HUF_CStream_t`). ----

struct HufC {
  c0: u64,
  c1: u64,
  p0: u64,
  p1: u64,
  start: [*]mut u8,
  ptr: usize,
  endPtr: usize,
}
impl Copy for HufC {}

@inlineAlways
unsafe fn add0(b: &mut HufC, ct: [*]const u8, symbol: u8, fast: bool) -> () {
  let e = unsafe mem.r64(ct, 8 + u8.toUsize(symbol) * 8)
  b.c0 = u64.shiftRight(b.c0, e & 63)
  b.c0 = b.c0 | (if fast { e } else { e & 0xFFFFFFFFFFFFFF00 })
  b.p0 = u64.wrappingAdd(b.p0, e)
}

@inlineAlways
unsafe fn add1(b: &mut HufC, ct: [*]const u8, symbol: u8, fast: bool) -> () {
  let e = unsafe mem.r64(ct, 8 + u8.toUsize(symbol) * 8)
  b.c1 = u64.shiftRight(b.c1, e & 63)
  b.c1 = b.c1 | (if fast { e } else { e & 0xFFFFFFFFFFFFFF00 })
  b.p1 = u64.wrappingAdd(b.p1, e)
}

@inlineAlways
unsafe fn flush(b: &mut HufC, fast: bool) -> () {
  let nbBits = b.p0 & 255
  let nbBytes = u64.shiftRight(nbBits, 3)
  let container = u64.shiftRight(b.c0, u64.wrappingSubtract(64, nbBits) & 63)
  b.p0 = b.p0 & 7
  unsafe mem.w64(b.start, b.ptr, container)
  b.ptr = mem.ua(b.ptr, u64.toUsize(nbBytes))
  if !fast && b.ptr > b.endPtr { b.ptr = b.endPtr }
}

@inlineAlways
unsafe fn encodeLoop(b: &mut HufC, ip: [*]const u8, srcSize: usize, ct: [*]const u8, kUnroll: usize, kFastFlush: bool, kLastFast: bool) -> () {
  let mut n = srcSize
  let mut rem = n % kUnroll
  if rem > 0 {
    while rem > 0 {
      n = n - 1
      unsafe add0(&mut b, ct, unsafe mem.r8(ip, n), false)
      rem = rem - 1
    }
    unsafe flush(&mut b, kFastFlush)
  }
  if (n % (2 * kUnroll)) != 0 {
    let mut u: usize = 1
    while u < kUnroll {
      unsafe add0(&mut b, ct, unsafe mem.r8(ip, n - u), true)
      u = u + 1
    }
    unsafe add0(&mut b, ct, unsafe mem.r8(ip, n - kUnroll), kLastFast)
    unsafe flush(&mut b, kFastFlush)
    n = n - kUnroll
  }
  while n > 0 {
    let mut u: usize = 1
    while u < kUnroll {
      unsafe add0(&mut b, ct, unsafe mem.r8(ip, n - u), true)
      u = u + 1
    }
    unsafe add0(&mut b, ct, unsafe mem.r8(ip, n - kUnroll), kLastFast)
    unsafe flush(&mut b, kFastFlush)
    // The second container starts empty and is merged in before the next flush.
    b.c1 = 0
    b.p1 = 0
    u = 1
    while u < kUnroll {
      unsafe add1(&mut b, ct, unsafe mem.r8(ip, n - kUnroll - u), true)
      u = u + 1
    }
    unsafe add1(&mut b, ct, unsafe mem.r8(ip, n - kUnroll - kUnroll), kLastFast)
    b.c0 = u64.shiftRight(b.c0, b.p1 & 63)
    b.c0 = b.c0 | b.c1
    b.p0 = u64.wrappingAdd(b.p0, b.p1)
    unsafe flush(&mut b, kFastFlush)
    n = n - 2 * kUnroll
  }
}

@inlineNever
unsafe fn loop4(b: &mut HufC, ip: [*]const u8, srcSize: usize, ct: [*]const u8) -> () { unsafe encodeLoop(&mut b, ip, srcSize, ct, 4, false, false) }
@inlineNever
unsafe fn loop5a(b: &mut HufC, ip: [*]const u8, srcSize: usize, ct: [*]const u8) -> () { unsafe encodeLoop(&mut b, ip, srcSize, ct, 5, true, false) }
@inlineNever
unsafe fn loop5b(b: &mut HufC, ip: [*]const u8, srcSize: usize, ct: [*]const u8) -> () { unsafe encodeLoop(&mut b, ip, srcSize, ct, 5, true, true) }
@inlineNever
unsafe fn loop6(b: &mut HufC, ip: [*]const u8, srcSize: usize, ct: [*]const u8) -> () { unsafe encodeLoop(&mut b, ip, srcSize, ct, 6, true, false) }
@inlineNever
unsafe fn loop7(b: &mut HufC, ip: [*]const u8, srcSize: usize, ct: [*]const u8) -> () { unsafe encodeLoop(&mut b, ip, srcSize, ct, 7, true, false) }
@inlineNever
unsafe fn loop8(b: &mut HufC, ip: [*]const u8, srcSize: usize, ct: [*]const u8) -> () { unsafe encodeLoop(&mut b, ip, srcSize, ct, 8, true, false) }
@inlineNever
unsafe fn loop9(b: &mut HufC, ip: [*]const u8, srcSize: usize, ct: [*]const u8) -> () { unsafe encodeLoop(&mut b, ip, srcSize, ct, 9, true, true) }

/// `HUF_compress1X_usingCTable`: one stream. Returns 0 if `dst` is too small.
pub unsafe fn compress1XUsingCTable(dst: [*]mut u8, dstSize: usize, src: [*]const u8, srcSize: usize, ctable: [*]const u8) -> usize {
  let tableLog = unsafe tableLogOf(ctable)
  if dstSize < 8 { return 0 }
  if dstSize <= 8 { return 0 }
  let mut b = HufC { c0: 0, c1: 0, p0: 0, p1: 0, start: dst, ptr: 0, endPtr: dstSize - 8 }
  if dstSize < usize.shiftRight(srcSize * mem.z(tableLog), 3) + 8 || tableLog > 11 {
    unsafe loop4(&mut b, src, srcSize, ctable)
  } else if tableLog == 11 {
    unsafe loop5a(&mut b, src, srcSize, ctable)
  } else if tableLog == 10 {
    unsafe loop5b(&mut b, src, srcSize, ctable)
  } else if tableLog == 9 {
    unsafe loop6(&mut b, src, srcSize, ctable)
  } else if tableLog == 8 {
    unsafe loop7(&mut b, src, srcSize, ctable)
  } else if tableLog == 7 {
    unsafe loop8(&mut b, src, srcSize, ctable)
  } else {
    unsafe loop9(&mut b, src, srcSize, ctable)
  }
  // `HUF_closeCStream`: the end mark is one bit of value 1.
  b.c0 = u64.shiftRight(b.c0, 1)
  b.c0 = b.c0 | 0x8000000000000000
  b.p0 = u64.wrappingAdd(b.p0, 1)
  unsafe flush(&mut b, false)
  if b.ptr >= b.endPtr { return 0 }
  if (b.p0 & 255) > 0 { return b.ptr + 1 }
  return b.ptr
}

/// `HUF_compress4X_usingCTable`: four streams after a jump table of 6 bytes.
pub unsafe fn compress4XUsingCTable(dst: [*]mut u8, dstSize: usize, src: [*]const u8, srcSize: usize, ctable: [*]const u8) -> usize {
  let segmentSize = (srcSize + 3) / 4
  let mut ip: usize = 0
  let mut op: usize = 0
  if dstSize < 6 + 1 + 1 + 1 + 8 { return 0 }
  if srcSize < 12 { return 0 }
  op = 6
  let mut stream: usize = 0
  while stream < 3 {
    let cSize = unsafe compress1XUsingCTable(unsafe mem.add(dst, op), dstSize - op, unsafe mem.addc(src, ip), segmentSize, ctable)
    if errors.isError(cSize) { return cSize }
    if cSize == 0 || cSize > 65535 { return 0 }
    unsafe mem.w16(dst, stream * 2, usize.wrappingToU16(cSize))
    op = op + cSize
    ip = ip + segmentSize
    stream = stream + 1
  }
  let cSize = unsafe compress1XUsingCTable(unsafe mem.add(dst, op), dstSize - op, unsafe mem.addc(src, ip), srcSize - ip, ctable)
  if errors.isError(cSize) { return cSize }
  if cSize == 0 || cSize > 65535 { return 0 }
  op = op + cSize
  return op
}

// `HUF_compressCTable_internal`. `op` is the offset in `ostart` where the streams begin.
unsafe fn compressCTableInternal(ostart: [*]mut u8, op: usize, oend: usize, src: [*]const u8, srcSize: usize, singleStream: bool, ctable: [*]const u8) -> usize {
  let mut cSize: usize = 0
  if singleStream {
    cSize = unsafe compress1XUsingCTable(unsafe mem.add(ostart, op), oend - op, src, srcSize, ctable)
  } else {
    cSize = unsafe compress4XUsingCTable(unsafe mem.add(ostart, op), oend - op, src, srcSize, ctable)
  }
  if errors.isError(cSize) { return cSize }
  if cSize == 0 { return 0 }
  // Check compressibility.
  if op + cSize >= srcSize - 1 { return 0 }
  return op + cSize
}

/// `HUF_cardinality`.
pub unsafe fn cardinality(count: [*]const u8, maxSymbolValue: u32) -> u32 {
  let mut result: u32 = 0
  let mut i: u32 = 0
  while i < maxSymbolValue + 1 {
    if unsafe cnt(count, mem.z(i)) != 0 { result = result + 1 }
    i = i + 1
  }
  return result
}

/// `HUF_optimalTableLog`. `workSpace` is the `wksps` union of the compression tables.
pub unsafe fn optimalTableLog(maxTableLog: u32, srcSize: usize, maxSymbolValue: u32, workSpace: [*]mut u8, wkspSize: usize, table: [*]mut u8, count: [*]const u8, flags: u32) -> u32 {
  if (flags & FLAG_OPTIMAL_DEPTH) == 0 {
    // Cheap evaluation, based on FSE.
    return fse.optimalTableLogInternal(maxTableLog, srcSize, maxSymbolValue, 1)
  }
  let dst = unsafe mem.add(workSpace, WR_SIZE)
  let dstSize = wkspSize - WR_SIZE
  let symbolCardinality = unsafe cardinality(count, maxSymbolValue)
  let minTableLog = mem.highbit32(symbolCardinality) + 1
  let mut optSize: usize = 0xFFFFFFFFFFFFFFFE
  let mut optLog = maxTableLog
  // Search until the size increases.
  let mut optLogGuess = minTableLog
  while optLogGuess <= maxTableLog {
    let maxBits = unsafe buildCTable(table, count, maxSymbolValue, optLogGuess, workSpace, wkspSize)
    if !errors.isError(maxBits) {
      if maxBits < mem.z(optLogGuess) && optLogGuess > minTableLog { break }
      let hSize = unsafe writeCTable(dst, dstSize, unsafe mem.ro(table), maxSymbolValue, mem.t32(maxBits), workSpace, wkspSize)
      if !errors.isError(hSize) {
        let newSize = unsafe estimateCompressedSize(unsafe mem.ro(table), count, maxSymbolValue) + hSize
        if newSize > optSize + 1 { break }
        if newSize < optSize {
          optSize = newSize
          optLog = optLogGuess
        }
      }
    }
    optLogGuess = optLogGuess + 1
  }
  return optLog
}

// `HUF_compress_internal`.
unsafe fn compressInternal(dst: [*]mut u8, dstSize: usize, src: [*]const u8, srcSize: usize, maxSymbolValue0: u32, huffLog0: u32, singleStream: bool, workSpace0: [*]mut u8, wkspSize0: usize, oldHufTable: [*]mut u8, repeat: &mut u32, flags: u32) -> usize {
  let mut maxSymbolValue = maxSymbolValue0
  let mut huffLog = huffLog0
  // `HUF_alignUpWorkspace(workSpace, &wkspSize, 8)`.
  let pad = mem.us(8, mem.addrm(workSpace0) & 7) & 7
  if wkspSize0 < pad + T_SIZE { return errors.err(errors.E_WORKSPACE_TOOSMALL) }
  let table = unsafe mem.add(workSpace0, pad)
  let count = unsafe mem.add(table, T_COUNT)
  let ctable = unsafe mem.add(table, T_CTABLE)
  let wksps = unsafe mem.add(table, T_WKSPS)
  let oend = dstSize
  let mut op: usize = 0
  // Checks and inits.
  if srcSize == 0 { return 0 }
  if dstSize == 0 { return 0 }
  if srcSize > BLOCKSIZE_MAX { return errors.err(errors.E_SRCSIZE_WRONG) }
  if huffLog > TABLELOG_MAX { return errors.err(errors.E_TABLELOG_TOOLARGE) }
  if maxSymbolValue > SYMBOLVALUE_MAX { return errors.err(errors.E_MAXSYMBOLVALUE_TOOLARGE) }
  if maxSymbolValue == 0 { maxSymbolValue = SYMBOLVALUE_MAX }
  if huffLog == 0 { huffLog = TABLELOG_DEFAULT }
  // Heuristic: if the old table is valid, use it for small inputs.
  if (flags & FLAG_PREFER_REPEAT) != 0 && repeat.* == REPEAT_VALID {
    return unsafe compressCTableInternal(dst, op, oend, src, srcSize, singleStream, unsafe mem.ro(oldHufTable))
  }
  // If uncompressible data is suspected, sample the start and the end before the full scan.
  if (flags & FLAG_SUSPECT_UNCOMPRESSIBLE) != 0 && srcSize >= 4096 * 10 {
    let mut largestTotal: usize = 0
    let mut maxSymbolValueBegin = maxSymbolValue
    largestTotal = largestTotal + mem.z(unsafe hist.countSimple(count, &mut maxSymbolValueBegin, src, 4096))
    let mut maxSymbolValueEnd = maxSymbolValue
    largestTotal = largestTotal + mem.z(unsafe hist.countSimple(count, &mut maxSymbolValueEnd, unsafe mem.addc(src, srcSize - 4096), 4096))
    if largestTotal <= usize.shiftRight(2 * 4096, 7) + 4 { return 0 }
  }
  // Scan the input and build the symbol stats.
  let largest = unsafe hist.count(count, &mut maxSymbolValue, src, srcSize, wksps, hist.WKSP_SIZE)
  if errors.isError(largest) { return largest }
  if largest == srcSize { unsafe mem.w8(dst, 0, unsafe mem.r8(src, 0)) return 1 }
  if largest <= usize.shiftRight(srcSize, 7) + 4 { return 0 }
  // Check the validity of the previous table.
  if repeat.* == REPEAT_CHECK && !unsafe validateCTable(unsafe mem.ro(oldHufTable), unsafe mem.ro(count), maxSymbolValue) {
    repeat.* = REPEAT_NONE
  }
  // Heuristic: use the existing table for small inputs.
  if (flags & FLAG_PREFER_REPEAT) != 0 && repeat.* != REPEAT_NONE {
    return unsafe compressCTableInternal(dst, op, oend, src, srcSize, singleStream, unsafe mem.ro(oldHufTable))
  }
  // Build a new table.
  huffLog = unsafe optimalTableLog(huffLog, srcSize, maxSymbolValue, wksps, BUILD_WKSP_SIZE, ctable, unsafe mem.ro(count), flags)
  let maxBits = unsafe buildCTable(ctable, unsafe mem.ro(count), maxSymbolValue, huffLog, wksps, BUILD_WKSP_SIZE)
  if errors.isError(maxBits) { return maxBits }
  huffLog = mem.t32(maxBits)
  // Write the table description header.
  let hSize = unsafe writeCTable(dst, dstSize, unsafe mem.ro(ctable), maxSymbolValue, huffLog, wksps, WR_SIZE)
  if errors.isError(hSize) { return hSize }
  // Check if reusing the previous table is beneficial.
  if repeat.* != REPEAT_NONE {
    let oldSize = unsafe estimateCompressedSize(unsafe mem.ro(oldHufTable), unsafe mem.ro(count), maxSymbolValue)
    let newSize = unsafe estimateCompressedSize(unsafe mem.ro(ctable), unsafe mem.ro(count), maxSymbolValue)
    if oldSize <= hSize + newSize || hSize + 12 >= srcSize {
      return unsafe compressCTableInternal(dst, op, oend, src, srcSize, singleStream, unsafe mem.ro(oldHufTable))
    }
  }
  // Use the new table.
  if hSize + 12 >= srcSize { return 0 }
  op = op + hSize
  repeat.* = REPEAT_NONE
  let _c = unsafe mem.memcpy(oldHufTable, unsafe mem.ro(ctable), CTABLE_BYTES)
  return unsafe compressCTableInternal(dst, op, oend, src, srcSize, singleStream, unsafe mem.ro(ctable))
}

/// `HUF_compress1X_repeat`: compresses into one stream, with the table that `repeat` allows.
/// `hufTable` is replaced if a new table is used, and `repeat` is then set to `REPEAT_NONE`.
pub unsafe fn compress1XRepeat(dst: [*]mut u8, dstSize: usize, src: [*]const u8, srcSize: usize, maxSymbolValue: u32, huffLog: u32, workSpace: [*]mut u8, wkspSize: usize, hufTable: [*]mut u8, repeat: &mut u32, flags: u32) -> usize {
  return unsafe compressInternal(dst, dstSize, src, srcSize, maxSymbolValue, huffLog, true, workSpace, wkspSize, hufTable, &mut repeat, flags)
}

/// `HUF_compress4X_repeat`: as [`compress1XRepeat`], into four streams.
pub unsafe fn compress4XRepeat(dst: [*]mut u8, dstSize: usize, src: [*]const u8, srcSize: usize, maxSymbolValue: u32, huffLog: u32, workSpace: [*]mut u8, wkspSize: usize, hufTable: [*]mut u8, repeat: &mut u32, flags: u32) -> usize {
  return unsafe compressInternal(dst, dstSize, src, srcSize, maxSymbolValue, huffLog, false, workSpace, wkspSize, hufTable, &mut repeat, flags)
}
