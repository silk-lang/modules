//! The runtime's tasks, run with `silk task <name>` from `modules/runtime`.
//!
//! `runtime` is how the runtime executable is made: a plain `silk build` with the Clang driver in
//! `tools/clang.py`, then a second link with the built-ins' bytecode and a heap image appended,
//! which only an executable that runs on the build machine can make. The work stays in the
//! Python tools; this program is their entry point.
//!
//! The `bench` tasks compare the runtime with Bun (`bench/README.md`). They are Silk all the way:
//! the harness is the `runtimes` module of `../benchkit`.

import benchkit.kit as Kit
import benchkit.runtimes as Runtimes
import benchkit.runtimes { Asked }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }

union Tasks {
  Runtime { pub release: bool, pub output: Option<Bytes> },
  Embed,
  Compat { pub pattern: Option<Bytes> },
  Sea { pub runtime: Bytes, pub blob: Bytes, pub executable: Bytes, pub sign: Option<Bytes> },
  BenchSetup { pub work: Option<Bytes>, pub steps: List<Bytes> },
  Bench { pub measure: Measure, pub groups: List<Bytes> },
  BenchMem { pub measure: Measure },
  BenchCold { pub measure: Measure, pub cases: List<Bytes> },
  BenchAll { pub measure: Measure, pub memRounds: Option<u32>, pub coldRuns: Option<u32> },
  OfflineDeps { pub work: Option<Bytes>, pub archives: Option<Bytes> },
}

/// The options the measuring tasks share.
struct Measure {
  pub rounds: Option<u32>,
  pub executable: Option<Bytes>,
  pub runtimes: Option<Bytes>,
  pub out: Option<Bytes>,
  pub work: Option<Bytes>,
  pub force: bool,
}

impl CommandLine for Measure {
  static fn command() -> Command<Measure> {
    return Command<Measure>.make("measure", "")
      |> Command.option(
        "rounds",
        Opt.about(
          "Interleaved rounds (default: 6 for bench, 3 for bench-mem; runs per case for bench-cold, 30)",
        ),
      )
      |> Command.option(
        "executable",
        Opt.about("The runtime executable (default: build/silkjs)")
          |> Opt.long("runtime")
          |> Opt.env("SILKJS_RUNTIME"),
      )
      |> Command.option(
        "runtimes",
        Opt.about(
          "Columns, comma-separated: silkjs,bun_nojit,bun_nojit_smol (the default); bench-cold also takes bun",
        )
          |> Opt.env("RUNTIMES"),
      )
      |> Command.option(
        "out",
        Opt.about("The results directory (default: <work>/results/<UTC time>)"),
      )
      |> Command.option(
        "work",
        Opt.about("The work directory of bench-setup (default: build/bench)")
          |> Opt.env("SILKJS_BENCH_WORK"),
      )
      |> Command.option("force", Opt.about("Measure even while a build runs"))
  }
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "The SilkJS runtime's tasks")
      |> Command.variant(
        "Runtime",
        "Build the runtime executable with its built-ins and heap image, build/silkjs",
      )
      |> Command.option("release", Opt.about("Optimize for speed"))
      |> Command.option("output", Opt.about("Where to write the executable"))
      |> Command.variant(
        "Embed",
        "Regenerate the built-ins index (builtin_sources.c, src/runtime/embedded.silk) after adding or removing a built-in",
      )
      |> Command.variant(
        "Compat",
        "Run the differential cases against Node 24 (needs node; SILKJS_RUNTIME and NODE_REFERENCE select executables)",
      )
      |> Command.arg("pattern", Opt.about("A regular expression selecting cases"))
      |> Command.variant(
        "Sea",
        "Inject a prepared single-executable blob into a Darwin arm64 runtime and sign it",
      )
      |> Command.option(
        "runtime",
        Opt.about("The runtime executable to start from") |> Opt.required,
      )
      |> Command.option(
        "blob",
        Opt.about("The blob from --experimental-sea-config") |> Opt.required,
      )
      |> Command.option("executable", Opt.about("The executable to write") |> Opt.required)
      |> Command.option("sign", Opt.about("The codesign identity (default: ad-hoc)"))
      |> Command.variant(
        "BenchSetup",
        "Prepare the Bun comparison: wrk, Postgres, Bun's bench folders, Northwind, the TLS certificate, the 1 GB file",
      )
      |> Command.option(
        "work",
        Opt.about("The work directory (default: build/bench)") |> Opt.env("SILKJS_BENCH_WORK"),
      )
      |> Command.arg(
        "steps",
        Opt.about(
          "Steps to run (default all): wrk postgres bunrepo install northwind cert bigfile",
        ),
      )
      |> Command.variant(
        "Bench",
        "Run the benchmarks against Bun with its JIT off (needs bench-setup and a release build)",
      )
      |> Command.flatten("measure")
      |> Command.arg(
        "groups",
        Opt.about("Groups or benchmarks to run: http ws pg sqlite spawn cat imm"),
      )
      |> Command.variant("BenchMem", "Measure the peak RSS of the non-server benchmarks")
      |> Command.variant(
        "BenchCold",
        "Measure cold start: wall time, CPU time, peak RSS and page faults per process start",
      )
      |> Command.arg("cases", Opt.about("Cases to run: empty hello cjs esm local fsread net timer"))
      |> Command.variant(
        "BenchAll",
        "Run bench, bench-mem and bench-cold into one results directory",
      )
      |> Command.option("memRounds", Opt.about("Rounds of bench-mem (default 3)"))
      |> Command.option("coldRuns", Opt.about("Runs per case of bench-cold (default 30)"))
      |> Command.variant(
        "OfflineDeps",
        "Point the build at prepared copies of its downloads, for a network that blocks them",
      )
      |> Command.option(
        "archives",
        Opt.about("The folder with the prepared archives")
          |> Opt.long("from")
          |> Opt.env("SILKJS_OFFLINE_DEPS"),
      )
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let mut argv = List<Bytes>.make()
    match move self {
      Tasks.BenchSetup { work, steps } => {
        let asked = run asked(onlyWork(move work), move steps)
        run Runtimes.setup(&asked)
        return
      }
      Tasks.Bench { measure, groups } => {
        let asked = run asked(move measure, move groups)
        run Runtimes.bench(&asked)
        return
      }
      Tasks.BenchMem { measure } => {
        let asked = run asked(move measure, List<Bytes>.make())
        run Runtimes.mem(&asked)
        return
      }
      Tasks.BenchCold { measure, cases } => {
        let asked = run asked(move measure, move cases)
        run Runtimes.cold(&asked)
        return
      }
      Tasks.BenchAll { measure, memRounds, coldRuns } => {
        let asked = run asked(move measure, List<Bytes>.make())
        run Runtimes.all(&asked, count(memRounds), count(coldRuns))
        return
      }
      Tasks.OfflineDeps { work, archives } => {
        let asked = run asked(onlyWork(move work), List<Bytes>.make())
        let from = Kit.orEmpty(move archives)
        run Runtimes.offlineDeps(&asked, Bytes.asSlice(&from))
        return
      }
      Tasks.Runtime { release, output } => {
        run word(&mut argv, b"tools/build.py")
        if release {
          run word(&mut argv, b"--release")
        }
        run valued(&mut argv, b"--output", move output)
      }
      Tasks.Embed => run word(&mut argv, b"tools/embed.py")
      Tasks.Compat { pattern } => {
        run word(&mut argv, b"tests/compat.mjs")
        match move pattern {
          Option<Bytes>.Some { value } => run List<Bytes>.append(&mut argv, move value)
          Option<Bytes>.None => {}
        }
        run Task.execBytes(b"node", List<Bytes>.asSlice(&argv))
        return
      }
      Tasks.Sea { runtime: base, blob, executable, sign } => {
        run word(&mut argv, b"tools/sea.py")
        run word(&mut argv, b"--runtime")
        run List<Bytes>.append(&mut argv, move base)
        run word(&mut argv, b"--blob")
        run List<Bytes>.append(&mut argv, move blob)
        run word(&mut argv, b"--output")
        run List<Bytes>.append(&mut argv, move executable)
        run valued(&mut argv, b"--sign", move sign)
      }
    }
    run Task.execBytes(b"python3", List<Bytes>.asSlice(&argv))
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}

// The options of a task that takes only a work directory.
fn onlyWork(work: Option<Bytes>) -> Measure {
  return Measure {
    rounds: Option<u32>.none(),
    executable: Option<Bytes>.none(),
    runtimes: Option<Bytes>.none(),
    out: Option<Bytes>.none(),
    work: move work,
    force: false,
  }
}

fn count(value: Option<u32>) -> u32 {
  return match move value {
    Option<u32>.Some { value: given } => given
    Option<u32>.None => 0
  }
}

// What a benchmark task was asked, from its options and names.
effect fn asked(measure: Measure, names: List<Bytes>) -> Asked
  ! TaskError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let root = run Task.root()
  let Measure { rounds, executable, runtimes, out, work, force } = move measure
  return Asked {
    root: run Bytes.copy(Path.rawBytes(&root)),
    work: Kit.orEmpty(move work),
    out: Kit.orEmpty(move out),
    runtime: Kit.orEmpty(move executable),
    runtimes: Kit.orEmpty(move runtimes),
    rounds: count(rounds),
    force: force,
    names: move names,
  }
}

// Appends one argument.
effect fn word(argv: &mut List<Bytes>, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run List<Bytes>.append(&mut argv.*, run Bytes.copy(text))
}

// Appends `flag` and its value when the option was given.
effect fn valued(argv: &mut List<Bytes>, flag: &[u8], value: Option<Bytes>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match move value {
    Option<Bytes>.Some { value: given } => {
      run word(&mut argv.*, flag)
      run List<Bytes>.append(&mut argv.*, move given)
    }
    Option<Bytes>.None => {}
  }
}
