      while true {
        static if Intrinsic.targetOperatingSystem() == "darwin" { r = isize.wrappingToI32(unsafe sendmsg_x(fd, base, n, MSG_DONTWAIT)) }
        else { r = unsafe sendmmsg(fd, base, n, 0) }
        if r != -1 || unsafe errno() != EINTR { break }
