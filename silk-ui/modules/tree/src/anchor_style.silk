//! CSS Anchor Positioning 1 as the tree stores it per box: `anchor-name`, `position-anchor`,
//! `anchor()` in the insets, `position-area`, `anchor-size()` in `width` and `height`, and
//! `position-try-fallbacks` flips. Names are kept as hashes, so a box's style stays `Copy`.
//! `css_anchor` places the boxes after layout.
import mutation { Value, Keyword }
import properties.values { Separator }
import properties.convert
import properties.keywords
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.f32
import silk.num.i16
import silk.num.u8
import silk.num.u32

/// `anchor()` sides, as `AnchorStyle.edges` holds them. 0 is no `anchor()`; 10 to 110 is a
/// percentage of the anchor (10 + the percentage).
pub const SIDE_NONE: u8 = 0
pub const SIDE_TOP: u8 = 1
pub const SIDE_RIGHT: u8 = 2
pub const SIDE_BOTTOM: u8 = 3
pub const SIDE_LEFT: u8 = 4
pub const SIDE_CENTER: u8 = 5
pub const SIDE_START: u8 = 6
pub const SIDE_END: u8 = 7
pub const SIDE_INSIDE: u8 = 8
pub const SIDE_OUTSIDE: u8 = 9
pub const SIDE_PERCENT: u8 = 10

/// `position-area` tracks, per axis: the start track (above or left of the anchor), the
/// anchor's own track, and the end track. Rows sit in bits 0 to 2, columns in bits 3 to 5.
pub const TRACK_START: u8 = 1
pub const TRACK_CENTER: u8 = 2
pub const TRACK_END: u8 = 4
pub const TRACKS_ALL: u8 = 7

/// `anchor-size()` per axis: the anchor's width or height.
pub const SIZE_NONE: u8 = 0
pub const SIZE_WIDTH: u8 = 1
pub const SIZE_HEIGHT: u8 = 2

/// `position-try-fallbacks` options, two bits each, up to three in order.
pub const TRY_FLIP_BLOCK: u8 = 1
pub const TRY_FLIP_INLINE: u8 = 2
pub const TRY_FLIP_BOTH: u8 = 3

pub struct AnchorStyle {
  /// `anchor-name`: the hash of the box's first name, 0 for `none`.
  pub name: u32,
  /// `position-anchor`: the hash of the default anchor's name, 0 for `auto`.
  pub target: u32,
  /// The name an `anchor()` or `anchor-size()` spelled, which wins over `target`.
  pub named: u32,
  /// `anchor()` side per inset, top, right, bottom, left (see `SIDE_*`).
  pub edges: [u8; 4],
  /// The length a `calc(anchor(...) + 4px)` adds, per inset, in quarter pixels.
  pub offsets: [i16; 4],
  /// `position-area` (see `TRACK_*`), 0 for `none`.
  pub area: u8,
  /// `anchor-size()` for `width` (bits 0-1) and `height` (bits 2-3).
  pub size: u8,
  /// `position-try-fallbacks` (see `TRY_*`).
  pub tries: u8,
}

impl Copy for AnchorStyle {}

impl AnchorStyle {
  pub fn none() -> AnchorStyle {
    return AnchorStyle { name: 0, target: 0, named: 0, edges: [SIDE_NONE; 4], offsets: [0; 4], area: 0, size: 0, tries: 0 }
  }

  /// Whether the box is placed against an anchor.
  pub fn anchored(self: &Self) -> bool {
    return self.area != 0 || self.size != 0
      || self.edges[0] != SIDE_NONE || self.edges[1] != SIDE_NONE
      || self.edges[2] != SIDE_NONE || self.edges[3] != SIDE_NONE
  }

  /// The name of the anchor the box is placed against, 0 for none.
  pub fn anchor(self: &Self) -> u32 {
    return if self.named != 0 { self.named } else { self.target }
  }

  pub fn rows(self: &Self) -> u8 { return u8.bitAnd(self.area, 7) }
  pub fn columns(self: &Self) -> u8 { return u8.bitAnd(self.area / 8, 7) }
  pub fn widthSize(self: &Self) -> u8 { return u8.bitAnd(self.size, 3) }
  pub fn heightSize(self: &Self) -> u8 { return u8.bitAnd(self.size / 4, 3) }
  pub fn tryAt(self: &Self, index: u8) -> u8 {
    let mut bits = self.tries
    let mut i: u8 = 0
    while i < index {
      bits = bits / 4
      i = i + 1
    }
    return u8.bitAnd(bits, 3)
  }

  /// `anchor-name`.
  pub fn setName(self: &mut Self, value: &Value) -> () {
    if convert.isKeyword(value, Keyword.None) {
      self.name = 0
      return ()
    }
    let mut words = Words.of(value)
    let word = words.next()
    if word.length > 2 && word[0] == 45 && word[1] == 45 {
      self.name = hash(word)
    }
  }

  /// `position-anchor`.
  pub fn setTarget(self: &mut Self, value: &Value) -> () {
    if convert.isKeyword(value, Keyword.Auto) || convert.isKeyword(value, Keyword.None) {
      self.target = 0
      return ()
    }
    let mut words = Words.of(value)
    let word = words.next()
    if word.length > 2 && word[0] == 45 && word[1] == 45 && words.next().length == 0 {
      self.target = hash(word)
    }
  }

  /// An inset (0 top, 1 right, 2 bottom, 3 left) that may be `anchor()`: returns whether it
  /// was. Any other value clears the edge.
  pub fn setEdge(self: &mut Self, edge: usize, value: &Value) -> bool {
    self.edges[edge] = SIDE_NONE
    self.offsets[edge] = 0
    let css = match &value.* {
      Value.Text { css } => css.asSlice()
      _ => { return false }
    }
    let parsed = insetOf(css, edge)
    if parsed.side == SIDE_NONE {
      return false
    }
    self.edges[edge] = parsed.side
    self.offsets[edge] = f32.toI16(f32.round(f32.max(-32000.0, f32.min(32000.0, parsed.offset * 4.0))))
    if parsed.name != 0 { self.named = parsed.name }
    return true
  }

  /// The length added to inset `edge`'s anchor position.
  pub fn offset(self: &Self, edge: usize) -> f32 {
    return i16.toF32(self.offsets[edge]) / 4.0
  }

  /// `width` (`horizontal`) or `height` that may be `anchor-size()`; returns whether it was.
  pub fn setSize(self: &mut Self, horizontal: bool, value: &Value) -> bool {
    let mut code = SIZE_NONE
    if let Value.Text { css } = &value.* {
      let mut scan = Scan { css: css.asSlice(), at: 0 }
      if scan.function(b"anchor-size") {
        let mut word = scan.word()
        if word.length > 2 && word[0] == 45 && word[1] == 45 {
          self.named = hash(word)
          word = scan.word()
        }
        code = if same(word, b"width") || same(word, b"inline") || same(word, b"self-inline") { SIZE_WIDTH } else if same(word, b"height") || same(word, b"block") || same(word, b"self-block") { SIZE_HEIGHT } else if word.length == 0 { if horizontal { SIZE_WIDTH } else { SIZE_HEIGHT } } else { SIZE_NONE }
      }
    }
    if horizontal {
      self.size = u8.bitOr(u8.bitAnd(self.size, 12), code)
    } else {
      self.size = u8.bitOr(u8.bitAnd(self.size, 3), code * 4)
    }
    return code != SIZE_NONE
  }

  /// `position-area`.
  pub fn setArea(self: &mut Self, value: &Value) -> () {
    if convert.isKeyword(value, Keyword.None) {
      self.area = 0
      return ()
    }
    if let Option<u8>.Some { value: area } = areaOf(value) {
      self.area = area
    }
  }

  /// `position-try-fallbacks`: flips only; a named `@position-try` rule ends the list.
  pub fn setTries(self: &mut Self, value: &Value) -> () {
    if convert.isKeyword(value, Keyword.None) {
      self.tries = 0
      return ()
    }
    let mut words = Words.of(value)
    let mut tries: u8 = 0
    let mut shift: u8 = 1
    let mut option: u8 = 0
    let mut count: u8 = 0
    while true {
      let word = words.next()
      let comma = words.comma
      if same(word, b"flip-block") { option = u8.bitOr(option, TRY_FLIP_BLOCK) } else if same(word, b"flip-inline") { option = u8.bitOr(option, TRY_FLIP_INLINE) } else if word.length != 0 { break }
      if (word.length == 0 || comma) && option != 0 {
        if count < 3 {
          tries = u8.bitOr(tries, option * shift)
          shift = shift * 4
          count = count + 1
        }
        option = 0
      }
      if word.length == 0 { break }
    }
    self.tries = tries
  }
}

/// The hash of an anchor name; never 0.
pub fn hash(name: &[u8]) -> u32 {
  let mut h: u32 = 2166136261
  let mut i: usize = 0
  while i < name.length {
    h = u32.wrappingMultiply(u32.bitXor(h, u8.toU32(name[i])), 16777619)
    i = i + 1
  }
  return if h == 0 { 1 } else { h }
}

struct Inset {
  side: u8,
  name: u32,
  offset: f32,
}

impl Copy for Inset {}

/// `anchor([name] side [, fallback])`, or `calc(anchor(...) ± length)`.
fn insetOf(css: &[u8], edge: usize) -> Inset {
  let none = Inset { side: SIDE_NONE, name: 0, offset: 0.0 }
  let mut scan = Scan { css: css, at: 0 }
  let calc = scan.function(b"calc")
  if !scan.function(b"anchor") {
    return none
  }
  let mut word = scan.word()
  let mut name: u32 = 0
  if word.length > 2 && word[0] == 45 && word[1] == 45 {
    name = hash(word)
    word = scan.word()
  }
  let vertical = edge == 0 || edge == 2
  let mut side = SIDE_NONE
  if same(word, b"top") && vertical { side = SIDE_TOP } else if same(word, b"bottom") && vertical { side = SIDE_BOTTOM } else if same(word, b"left") && !vertical { side = SIDE_LEFT } else if same(word, b"right") && !vertical { side = SIDE_RIGHT } else if same(word, b"center") { side = SIDE_CENTER } else if same(word, b"start") || same(word, b"self-start") { side = SIDE_START } else if same(word, b"end") || same(word, b"self-end") { side = SIDE_END } else if same(word, b"inside") { side = SIDE_INSIDE } else if same(word, b"outside") { side = SIDE_OUTSIDE } else if word.length > 1 && word[word.length - 1] == 37 {
    if let Option<f32>.Some { value: percent } = number(word, 1) {
      if percent >= 0.0 && percent <= 100.0 { side = SIDE_PERCENT + f32.toU8(f32.round(percent)) }
    }
  }
  if side == SIDE_NONE {
    return none
  }
  scan.close()
  let mut offset: f32 = 0.0
  if calc {
    let sign = scan.word()
    if sign.length == 1 && (sign[0] == 43 || sign[0] == 45) {
      let length = scan.word()
      let found = if length.length > 2 && same(cut(length, length.length - 2, length.length), b"px") { number(length, 2) } else if same(length, b"0") { Option<f32>.some(0.0) } else { Option<f32>.None }
      match found {
        Option.Some { value } => { offset = if sign[0] == 45 { 0.0 - value } else { value } }
        Option.None => { return none }
      }
    } else if sign.length != 0 {
      return none
    }
  }
  return Inset { side: side, name: name, offset: offset }
}

/// `position-area`: one or two keywords.
fn areaOf(value: &Value) -> Option<u8> {
  let mut words = Words.of(value)
  let first = words.next()
  let second = words.next()
  if first.length == 0 || words.next().length != 0 {
    return Option<u8>.None
  }
  let a = areaWord(first)
  if a[0] == 255 {
    return Option<u8>.None
  }
  let mut rows: u8 = 0
  let mut columns: u8 = 0
  if second.length == 0 {
    // One keyword: an axis keyword leaves the other axis `span-all`; a keyword of either
    // axis is repeated.
    if a[0] == 1 {
      columns = a[1]
      rows = TRACKS_ALL
    } else if a[0] == 2 {
      rows = a[1]
      columns = TRACKS_ALL
    } else {
      rows = a[1]
      columns = a[1]
    }
  } else {
    let b = areaWord(second)
    if b[0] == 255 {
      return Option<u8>.None
    }
    // Axis words go to their axis; words of either axis fill block, then inline.
    if a[0] == 1 && b[0] != 1 {
      columns = a[1]
      rows = b[1]
    } else if b[0] == 1 && a[0] != 1 {
      columns = b[1]
      rows = a[1]
    } else if a[0] == 2 && b[0] != 2 {
      rows = a[1]
      columns = b[1]
    } else if b[0] == 2 && a[0] != 2 {
      rows = b[1]
      columns = a[1]
    } else if a[0] == 0 && b[0] == 0 {
      rows = a[1]
      columns = b[1]
    } else { return Option<u8>.None }
  }
  return Option<u8>.some(u8.bitOr(rows, columns * 8))
}

/// [axis, tracks]: axis 0 is either, 1 horizontal, 2 vertical; 255 when not an area word.
fn areaWord(word: &[u8]) -> [u8; 2] {
  let mut w = word
  let mut span = false
  if w.length > 5 && same(cut(w, 0, 5), b"span-") {
    span = true
    w = cut(w, 5, w.length)
  }
  if span && same(w, b"all") { return [0, TRACKS_ALL] }
  if !span && same(w, b"center") { return [0, TRACK_CENTER] }
  let mut axis: u8 = 255
  let mut start = false
  if same(w, b"left") || same(w, b"x-start") || same(w, b"inline-start") || same(w, b"self-inline-start") || same(w, b"x-self-start") {
    axis = 1
    start = true
  } else if same(w, b"right") || same(w, b"x-end") || same(w, b"inline-end") || same(w, b"self-inline-end") || same(w, b"x-self-end") { axis = 1 } else if same(w, b"top") || same(w, b"y-start") || same(w, b"block-start") || same(w, b"self-block-start") || same(w, b"y-self-start") {
    axis = 2
    start = true
  } else if same(w, b"bottom") || same(w, b"y-end") || same(w, b"block-end") || same(w, b"self-block-end") || same(w, b"y-self-end") { axis = 2 } else if same(w, b"start") || same(w, b"self-start") {
    axis = 0
    start = true
  } else if same(w, b"end") || same(w, b"self-end") { axis = 0 }
  if axis == 255 {
    return [255, 0]
  }
  let track = if start { TRACK_START } else { TRACK_END }
  return [axis, if span { u8.bitOr(track, TRACK_CENTER) } else { track }]
}

/// The words of a value: its keywords, or the identifiers of its CSS text.
struct Words<'a> {
  keywords: [Keyword; 4],
  count: usize,
  at: usize,
  scan: Scan<'a>,
  text: bool,
  /// The last word ended a comma-separated item.
  pub comma: bool,
}

impl<'a> Words<'a> {
  fn of(value: &'a Value) -> Words<'a> {
    let text = match &value.* {
      Value.Text { css } => css.asSlice()
      _ => Slice.view<u8>(keywords.name(Keyword.None), 0, 0)
    }
    let mut words = Words { keywords: [Keyword.None; 4], count: 0, at: 0, scan: Scan { css: text, at: 0 }, text: false, comma: false }
    match &value.* {
      Value.Text { css: _ } => {
        words.text = true
      }
      Value.Keyword { value: word } => {
        words.keywords[0] = word
        words.count = 1
      }
      Value.Sequence { separator, values } => {
        let items = values.asSlice()
        let mut i: usize = 0
        while i < items.length && i < 4 {
          match convert.keywordOf(&items[i]) {
            Option.Some { value: word } => {
              words.keywords[i] = word
            }
            Option.None => {
              return move words
            }
          }
          i = i + 1
        }
        words.count = if items.length <= 4 && separator == Separator.Space { items.length } else { 0 }
      }
      _ => {}
    }
    return move words
  }

  fn next(self: &mut Self) -> &'a [u8] {
    if self.text {
      let word = self.scan.word()
      self.comma = self.scan.comma()
      return word
    }
    self.comma = false
    if self.at >= self.count {
      return b""
    }
    let word = keywords.name(self.keywords[self.at])
    self.at = self.at + 1
    return word
  }
}

/// A cursor over CSS text that reads words: identifiers, numbers with units, and `+`/`-`.
struct Scan<'a> {
  css: &'a [u8],
  at: usize,
}

impl<'a> Scan<'a> {
  fn space(self: &mut Self) -> () {
    while self.at < self.css.length && (self.css[self.at] == 32 || self.css[self.at] == 9 || self.css[self.at] == 10) {
      self.at = self.at + 1
    }
  }

  /// Reads `name(` when it comes next.
  fn function(self: &mut Self, name: &[u8]) -> bool {
    self.space()
    let end = self.at + name.length
    if end < self.css.length && same(cut(self.css, self.at, end), name) && self.css[end] == 40 {
      self.at = end + 1
      return true
    }
    return false
  }

  /// Skips to after the `)` that closes the current function.
  fn close(self: &mut Self) -> () {
    let mut depth: usize = 1
    while self.at < self.css.length {
      let c = self.css[self.at]
      self.at = self.at + 1
      if c == 40 { depth = depth + 1 }
      if c == 41 {
        depth = depth - 1
        if depth == 0 { return () }
      }
    }
  }

  fn comma(self: &mut Self) -> bool {
    self.space()
    if self.at < self.css.length && self.css[self.at] == 44 {
      self.at = self.at + 1
      return true
    }
    return false
  }

  fn word(self: &mut Self) -> &'a [u8] {
    self.space()
    let start = self.at
    if start < self.css.length && (self.css[start] == 43 || (self.css[start] == 45 && !(start + 1 < self.css.length && wordByte(self.css[start + 1])))) {
      self.at = start + 1
      return cut(self.css, start, self.at)
    }
    while self.at < self.css.length && wordByte(self.css[self.at]) {
      self.at = self.at + 1
    }
    return cut(self.css, start, self.at)
  }
}

fn wordByte(c: u8) -> bool {
  return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46 || c == 37 || c >= 128
}

/// ASCII case-insensitive equality with a lowercase `expected`.
fn same(word: &[u8], expected: &[u8]) -> bool {
  if word.length != expected.length {
    return false
  }
  let mut i: usize = 0
  while i < word.length {
    let c = word[i]
    let lower = if c >= 65 && c <= 90 { c + 32 } else { c }
    if lower != expected[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// The number at the start of `word`, without its last `unit` bytes.
fn number(word: &[u8], unit: usize) -> Option<f32> {
  if word.length <= unit {
    return Option<f32>.None
  }
  let digits = cut(word, 0, word.length - unit)
  let mut value: f32 = 0.0
  let mut scale: f32 = 0.0
  let mut any = false
  let mut i: usize = 0
  while i < digits.length {
    let c = digits[i]
    if c >= 48 && c <= 57 {
      let d = u8.toF32(c - 48)
      if scale == 0.0 { value = value * 10.0 + d } else {
        value = value + d * scale
        scale = scale / 10.0
      }
      any = true
    } else if c == 46 && scale == 0.0 {
      scale = 0.1
    } else {
      return Option<f32>.None
    }
    i = i + 1
  }
  return if any { Option<f32>.some(value) } else { Option<f32>.None }
}

fn cut<'a>(bytes: &'a [u8], start: usize, end: usize) -> &'a [u8] {
  return Slice.view<u8>(bytes, start, end - start)
}
