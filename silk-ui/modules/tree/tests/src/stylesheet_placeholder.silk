import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, CpuSnapshot }
import ui_tree.edit
import ui_tree.placeholder
import ui_fixtures.fixtures as fixtures
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.written
import svg_css.tokens { CssError }
import properties.computed { LineHeight }
import vector.geometry_error { GeometryError }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.num.f32

fn frame(width: f32) -> FrameInput { return FrameInput { width: width, height: 100.0, scale: 1.0, time: 0.0 } }
fn close(a: f32, b: f32) -> bool { return f32.abs(a-b) < 0.02 }

effect fn base(batch: &mut Batch) ! CssError | OutOfMemoryError ? &mut Allocator {
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Input)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("input") })
  run batch.attribute(2, Attribute.Placeholder { value: run String.copy("MMMM") })
  let declared = run written.declarations(b"font-family:'Noto Sans';font-size:20px;line-height:30px;width:200px;height:80px;color:black;background:white;padding:0;border:0;outline:none")
  run batch.style(2, declared.asSlice())
}

effect fn sheet(batch: &mut Batch, css: &[u8]) ! CompileError | CssError | OutOfMemoryError ? &mut Allocator {
  let compiled = run compile.compile(css, &Options.make())
  let bytes = run compiled.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
}

effect fn fontsAndVisibility() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch)
  run sheet(&mut batch, b".input::placeholder{font-family:'Geist Mono';font-size:2em;line-height:90px;color:red;background-color:blue;opacity:.5}")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  let slot = tree.slotOf(2)
  let initial = tree.node(slot).computed().*
  run Testing.expect(close(initial.text.size,20.0), "placeholder does not change the input font")
  if let Option.Some { value } = placeholder.of(tree.node(slot)) {
    run Testing.expect(close(value.computed.text.size,40.0) && value.computed.layout.fontKey != tree.node(slot).fontKey, "placeholder shapes with its own family and parent-relative size")
    run Testing.expect(match value.computed.text.lineHeight { LineHeight.Normal => true _ => false }, "placeholder line-height stays normal as in Chromium")
    run Testing.expect(close(value.computed.text.color.r,1.0) && close(value.computed.text.color.g,0.0) && close(value.computed.paint.opacity,0.5), "placeholder colors and opacity resolve separately")
  } else { run Testing.expect(false, "placeholder style is installed") }
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let painted = run snapshot.render(&tree)
  let mut red: usize = 0
  let mut blue: usize = 0
  let mut beyondInk: usize = 0
  let mut y: u32 = 0
  while y < 80 {
    let mut x: u32 = 0
    while x < 180 {
      let pixel = painted.pixel(x,y)
      if pixel.r > 240 && pixel.g >= 120 && pixel.g <= 140 && pixel.b >= 120 && pixel.b <= 140 { red = red + 1 }
      if pixel.b > 240 && pixel.r >= 120 && pixel.r <= 140 && pixel.g >= 120 && pixel.g <= 140 {
        blue = blue + 1
        if x == 150 { beyondInk = beyondInk + 1 }
      }
      x = x + 1
    }
    y = y + 1
  }
  run Testing.expect(red > 20 && blue > 20, "opacity composites placeholder ink and background together")
  run Testing.expect(beyondInk > 20, "placeholder background spans the input content width as in Chromium")
  let placeholderCaret = run edit.caretRectOf(&tree, slot)
  run batch.setText(2, "typed")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(placeholder.of(tree.node(slot)).isNone() && tree.layout.parent(tree.node(slot).inner) == tree.node(slot).css, "typing restores the original input text node and font path")
  let typedCaret = run edit.caretRectOf(&tree, slot)
  run Testing.expect(close(placeholderCaret.height(), typedCaret.height()), "placeholder font size does not resize the input caret or IME geometry")
  run batch.setText(2, "")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(placeholder.of(tree.node(slot)).isSome(), "clearing a value reinstalls the placeholder style")
  run batch.defineMark(2, 0, &[])
  run batch.richText(2, "rich", &[], &[])
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(placeholder.of(tree.node(slot)).isNone() && tree.node(slot).edit().hasRuns(), "rich text replaces the placeholder wrapper")
  run batch.richText(2, "", &[], &[])
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(placeholder.of(tree.node(slot)).isSome() && !tree.node(slot).edit().hasRuns(), "empty rich inputs show the styled placeholder")
  run batch.removeStyleSheet(0, 1)
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(placeholder.of(tree.node(slot)).isNone() && tree.node(slot).edit().showsPlaceholder, "sheet removal restores native placeholder styling")
}

test effect fn placeholderOwnsFontPaintAndOpacityWithoutChangingTypedOrRichText() ! TreeError | CompileError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fontsAndVisibility() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn units() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run base(&mut batch)
  let container = run written.declarations(b"container-type:inline-size")
  run batch.style(2,container.asSlice())
  run sheet(&mut batch,b".input::placeholder{font-size:10cqw;color:red}.input:hover::placeholder{color:blue}@container(width>150px){.input::placeholder{font-family:'Geist Mono'}}")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  let slot = tree.slotOf(2)
  run Testing.expect(match placeholder.of(tree.node(slot)) { Option.Some { value } => close(value.computed.text.size,20.0) _ => false }, "placeholder units select their originating input container in the first frame")
  let small = run written.declarations(b"width:100px")
  run batch.style(2,small.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(match placeholder.of(tree.node(slot)) { Option.Some { value } => close(value.computed.text.size,10.0) _ => false }, "part container units respond even when the input has no relative lengths")
  let node = tree.nodeMut(slot)
  node.hovered = true
  tree.restyleLocal(slot)
  run tree.frame(frame(240.0))
  run Testing.expect(match placeholder.of(tree.node(slot)) { Option.Some { value } => close(value.computed.text.color.b,1.0) _ => false }, "placeholder selectors use origin states")
  run batch.removeStyleSheet(0, 1)
  run sheet(&mut batch, b"@container(width>150px){.input::placeholder{font-size:40px}}")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(placeholder.of(tree.node(slot)).isNone(), "unmatched part conditions need no private wrapper")
  let large = run written.declarations(b"width:200px")
  let mut i: usize = 0
  while i < 2 {
    run batch.style(2, large.asSlice())
    run tree.apply(run batch.take())
    run tree.frame(frame(240.0))
    run Testing.expect(placeholder.of(tree.node(slot)).isSome(), "matching the container creates the placeholder wrapper")
    run batch.style(2, small.asSlice())
    run tree.apply(run batch.take())
    run tree.frame(frame(240.0))
    run Testing.expect(placeholder.of(tree.node(slot)).isNone(), "removing a wrapper retains its query dependencies")
    i = i + 1
  }
  run batch.removeStyleSheet(0, 1)
  run sheet(&mut batch, b".input::placeholder{font-size:10vw}")
  run tree.apply(run batch.take())
  run tree.frame(frame(240.0))
  run Testing.expect(match placeholder.of(tree.node(slot)) { Option.Some { value } => close(value.computed.text.size,24.0) _ => false }, "placeholder viewport lengths use the current root viewport")
  run tree.frame(frame(400.0))
  run Testing.expect(match placeholder.of(tree.node(slot)) { Option.Some { value } => close(value.computed.text.size,40.0) _ => false }, "viewport changes invalidate the part even without origin viewport lengths")
}

test effect fn placeholderUnitsAndConditionsTrackTheirOriginContainer() ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run units() |> Effect.provideMut<Allocator>(&mut allocator)
}
