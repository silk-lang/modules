pub unsafe export "C" fn uv_udp_recv_start(udp: *mut u8, alloc: Alloc, callback: Recv) -> i32 {
  if unsafe kindOf(udp) != UV_UDP || Intrinsic.pointerIsNull<Alloc>(alloc) || Intrinsic.pointerIsNull<Recv>(callback) { return -EINVAL }
  if unsafe ioActive(udp, POLLIN) { return -EALREADY }
