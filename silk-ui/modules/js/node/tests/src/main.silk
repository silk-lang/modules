//! The network check of `ui-js-node`: runs the module at the path in its first argument in a
//! runtime-backed realm with `@silkui/core`, turns the loop until the module calls process.exit,
//! and exits with its status (2 when JavaScript queued no mutation for the tree).
//! With a second argument, a file's path, the module runs from its bytecode image instead: the
//! check writes the image there, maps the file and starts from it, as a release host does (6
//! when the file is not accepted). Run by
//! `scripts/check`, which starts `fixtures/server.mjs` and passes its port in SILK_TEST_PORT.
import ui_js.lib { uiPackage }
import ui_js_node.lib { NodeApp, ImageFile, saveImage }
import silk.core.result { Result }
import silk.system.filesystem { FileError }
import ui_js_node.lib { UiApi }
import node_runtime.libs.core.capabilities { Composition }
import node_runtime.libs.core.capabilities { Capabilities, OsProcesses, OsNetwork, OsSystemInfo, ThreadWorkers }
import node_runtime.libs.core.module_sources { NodeResolution }
import node_runtime.libs.core.platforms { OsPlatform }
import node_runtime.libs.core.files { OsFiles }
import wasm.wamr { WamrWasm }
import compress.compress { NativeCompression }
import http2.nghttp2 { Nghttp2 }
import http.llhttp { Llhttp }
import database.sqlite_database { SqliteDatabase }
import openssl.openssl_capabilities { OpenSslCrypto, OpenSslTls }
import inspector.node_inspector { NodeInspector }
import amaro.amaro_stripping { Amaro }
import addons.dlopen_addons { DlopenAddons }
import node_runtime.runtime.embed { Host, Options }
import node_runtime.runtime.embed as embed
import node_runtime.runtime.session { Runtime }
import silkjs.js_exceptions { JsException }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_libc_platform as platform
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput }

struct Check {
  api: UiApi,
  source: List<u8>,
  /// Where the module's bytecode image goes, to run from it; empty to run the text.
  imagePath: List<u8>,
  /// The image's file, mapped for as long as the runtime reads it.
  image: ImageFile,
  /// JavaScript queued mutations for the tree.
  built: bool,
}

impl Host for Check {
  effect fn drive<'e, 'm, C: Composition>(self: &mut Self, runtime: &mut Runtime<'e, 'm, C>) -> i32 ! OutOfMemoryError | JsException ? &mut Allocator {
    let mut app = run NodeApp.make(&mut runtime.*, self.api)
    run app.define(b"@silkui/core", uiPackage())
    if self.imagePath.length() != 0 {
      // Written under another name than the module runs with, as a build writes it.
      let compiled = run app.writeImage(b"/ui-js-node-built/net.js", self.source.asSlice())
      let saved = run Effect.result(saveImage(self.imagePath.asSlice(), self.source.asSlice(), compiled.asSlice()))
      if let Result<usize, FileError | OutOfMemoryError>.Failure { error } = move saved { drop error return 6 }
      self.image = run ImageFile.open(self.imagePath.asSlice())
      let bytes = self.image.image(self.source.asSlice())
      if bytes.length == 0 { return 6 }
      run unsafe app.entryImage(b"/ui-js-node-check/net.js", self.source.asSlice(), bytes)
    } else {
      run app.entry(b"/ui-js-node-check/net.js", self.source.asSlice())
    }
    let mut turns: u32 = 0
    while turns < 1200 {
      run app.turn(0.05)
      if app.pending() != 0 { self.built = true }
      if let Option<i32>.Some { value } = app.exitStatus() {
        if value == 0 && !self.built { return 2 }
        return value
      }
      turns = turns + 1
    }
    return 3
  }
}

effect fn check(path: &[u8], imagePath: &[u8]) -> i32 ! OutOfMemoryError | SynchronizationError | platform.PlatformError ? &mut Allocator {
  let api = run UiApi.make()
  let mut imageCopy = List<u8>.make()
  run imageCopy.appendSlice(imagePath)
  let mut host = Check { api: api, source: run platform.readFile(path), imagePath: move imageCopy, image: ImageFile.none(), built: false }
  let options = run Options.make(b"ui-js-node-check")
  return run embed.start(move options, &mut host, Capabilities { platform: OsPlatform {}, modules: NodeResolution {}, files: OsFiles {}, compression: NativeCompression.make(), http2: Nghttp2.make(), crypto: OpenSslCrypto.make(), tls: OpenSslTls.make(), database: SqliteDatabase.make(), addons: DlopenAddons.make(), processes: OsProcesses {}, network: OsNetwork {}, http: Llhttp.make(), systemInfo: OsSystemInfo {}, typeStripping: Amaro {}, workers: ThreadWorkers {}, inspector: NodeInspector.make(), wasm: WamrWasm.make(), hostApi: api })
}

effect fn noArgument<E>(error: E) -> Option<Bytes> {
  drop error
  return Option<Bytes>.None
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 4
}

pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let argument = run Effect.catchAll(HostInput.argument(1), noArgument) |> Effect.provideMut<Allocator>(&mut allocator)
  let path = match move argument {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => { return 5 }
  }
  let second = run Effect.catchAll(HostInput.argument(2), noArgument) |> Effect.provideMut<Allocator>(&mut allocator)
  let image = match move second {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => Bytes.make()
  }
  return run Effect.catchAll(check(Bytes.asSlice(&path), Bytes.asSlice(&image)), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
