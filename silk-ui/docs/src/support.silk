//! The "Can I use" lists: what Silk UI does with each feature caniuse names, beside the
//! browsers that have it. docs/caniuse/sync.py writes the `caniuse_*` modules this reads.
import caniuse_answers { answer as answerTo }
import caniuse_data
import caniuse_data { Answer, Feature }
import prose { inline }
import theme { FAINT, INK, MUTED, PANEL, SIGNAL_INK, SIGNAL_SOFT, background, color, pad, round }
import loom.css
import loom.css { px, Align, Property }
import loom.heap { Heap }
import loom.lib { Document, Node, Role }
import silk.collections.list { List }

/// What a `support` letter says, and the colors it is said in: text, then background.
fn answer(support: string) -> [string<'static>; 3] {
  if support == "y" {
    return ["Works", SIGNAL_INK, SIGNAL_SOFT]
  }
  if support == "a" {
    return ["Partly", "var(--partly-ink)", "var(--partly-soft)"]
  }
  if support == "n" {
    return ["Not yet", MUTED, PANEL]
  }
  if support == "x" {
    return ["Not for apps", MUTED, PANEL]
  }
  return ["Not checked", FAINT, "transparent"]
}

fn count(group: string, support: string) -> i64 {
  let all = caniuse_data.features()
  let mut found: i64 = 0
  let mut i: usize = 0
  while i < caniuse_data.COUNT {
    if all[i].group == group && answerTo(all[i]).support == support {
      found = found + 1
    }
    i = i + 1
  }
  return found
}

fn tally<M>(h: &Document<M>, group: string, support: string, label: string) -> Node {
  return h.row(
    &[h.style(&[css.columnGap(px(6.0)), css.alignItems(Align.Baseline)])],
    &[
      h.box(&[h.style(&[css.fontWeight(600.0), color(INK)])], &[h.number(count(group, support))]),
      h.text(label),
    ],
  )
}

/// A browser's name and the first version that has the feature, or a dash.
fn browser<M>(h: &Document<M>, name: string, version: string) -> Node {
  return h.box(
    &[],
    &[h.text(name), h.text(" "), if version == "" { h.text("\u{2013}") } else { h.text(version) }],
  )
}

fn row<M>(h: &Document<M>, feature: Feature, given: Answer) -> Node {
  let said = answer(given.support)
  let mut note = List<Node>.make()
  inline(h, given.note, &mut note)
  return h.row(
    &[
      h.accessRole(Role.Group),
      h.style(
        &[
          css.columnGap(px(16.0)),
          css.alignItems(Align.Start),
          css.raw(Property.BorderTop, "1px solid var(--rule)"),
        ],
      ),
      h.style(&pad(12.0, 0.0)),
    ],
    &[
      h.column(
        &[h.style(&[css.flexGrow(1.0), css.raw(Property.FlexBasis, "0"), css.minWidth(px(0.0)), css.rowGap(px(3.0))])],
        &[
          h.link(
            feature.link,
            &[h.label(feature.about), h.style(&[color(INK), css.fontWeight(600.0), css.fontSize(px(15.0))])],
            &[h.text(feature.title)],
          ),
          if given.note == "" {
            h.empty()
          } else {
            h.box(&[h.style(&[css.fontSize(px(14.0)), color(MUTED), css.raw(Property.LineHeight, "1.5")])], note.asSlice())
          },
          h.row(
            &[h.style(&[css.columnGap(px(12.0)), css.fontSize(px(12.5)), color(FAINT), css.raw(Property.FlexWrap, "wrap")])],
            &[
              browser(h, "Chrome", feature.chrome),
              browser(h, "Firefox", feature.firefox),
              browser(h, "Safari", feature.safari),
            ],
          ),
        ],
      ),
      h.box(
        &[
          h.style(
            &[
              css.fontSize(px(12.5)),
              css.fontWeight(600.0),
              css.raw(Property.WhiteSpace, "nowrap"),
              css.raw(Property.Border, if given.support == "u" { "1px dashed var(--rule)" } else { "1px solid transparent" }),
              color(said[1]),
              background(said[2]),
              round(999.0),
            ],
          ),
          h.style(&pad(3.0, 10.0)),
        ],
        &[h.text(said[0])],
      ),
    ],
  )
}

/// The features of `group` ("CSS", "SVG", "JavaScript", "JavaScript APIs"): how many have
/// each answer, then one row a feature.
pub fn list<M>(h: &Document<M>, group: string) -> Node {
  let mut heap = Heap.make()
  let all = caniuse_data.features()
  let mut nodes = List<Node>.make()
  heap.alloc(
    nodes.append(
      h.row(
        &[
          h.style(
            &[
              css.columnGap(px(18.0)),
              css.rowGap(px(4.0)),
              css.raw(Property.FlexWrap, "wrap"),
              css.fontSize(px(14.0)),
              color(MUTED),
              css.marginBottom(px(12.0)),
            ],
          ),
        ],
        &[
          tally(h, group, "y", "work"),
          tally(h, group, "a", "partly"),
          tally(h, group, "n", "not yet"),
          tally(h, group, "x", "not for apps"),
          tally(h, group, "u", "not checked"),
        ],
      ),
    ),
  )
  let mut i: usize = 0
  while i < caniuse_data.COUNT {
    if all[i].group == group {
      heap.alloc(nodes.append(row(h, all[i], answerTo(all[i]))))
    }
    i = i + 1
  }
  return h.column(&[h.style(&[css.marginTop(px(18.0)), css.raw(Property.BorderBottom, "1px solid var(--rule)")])], nodes.asSlice())
}
