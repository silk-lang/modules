//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The answers of docs/caniuse/support/css-text.json.
import caniuse_data { Answer }

pub fn answer(id: string) -> Answer {
  if id == "background-clip-text" {
    return Answer { support: "y", note: "`background-clip: text`, also spelled `-webkit-background-clip: text`, fills the text with the background color and gradient layers, as Tailwind's `bg-clip-text text-transparent` expects. `-webkit-text-fill-color: transparent` works too." }
  }
  if id == "ch-unit" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-first-letter" {
    return Answer { support: "y", note: "`::first-letter` splits the first letter, with the punctuation around it, of a block container's first line into its own inline box that takes any style." }
  }
  if id == "css-first-line" {
    return Answer { support: "a", note: "`::first-line` paints the first line in its `color`, `-webkit-text-fill-color` and text decorations. Properties that change layout, such as `font-size` or `letter-spacing`, are ignored there." }
  }
  if id == "css-font-palette" {
    return Answer { support: "a", note: "`font-palette: normal | light | dark | <name>` and `@font-palette-values` (`font-family`, `base-palette`, `override-colors`) recolor COLR fonts, version 0 and 1. `palette-mix()` is not supported and draws the normal palette. `@font-palette-values` inside `@media` or `@supports` is ignored." }
  }
  if id == "css-font-rendering-controls" {
    return Answer { support: "y", note: "`font-display` periods follow Chromium: `auto` and `block` hide text for up to 3 s while the face loads, then show the fallback and swap the face in whenever it loads; `swap` shows the fallback at once; `fallback` hides text for 100 ms and swaps only within 3 s; `optional` hides text for 100 ms and uses the face only if it is ready by then." }
  }
  if id == "css-font-stretch" {
    return Answer { support: "y", note: "`font-stretch` and `font-width` pick the nearest width among a family's faces and set the `wdth` axis of a variable font." }
  }
  if id == "css-hanging-punctuation" {
    return Answer { support: "n", note: "`hanging-punctuation` is ignored; punctuation stays inside the line box." }
  }
  if id == "css-hyphens" {
    return Answer { support: "a", note: "`hyphens: manual` and `none` work. `auto` breaks only at soft hyphens (`&shy;`), like `manual`: there are no hyphenation dictionaries." }
  }
  if id == "css-initial-letter" {
    return Answer { support: "y", note: "`initial-letter` makes `::first-letter` a drop cap: `3`, `3 2`, `3 drop` and `3 raise` size its cap height to that many lines and sink its baseline to the given line, floated to the line start." }
  }
  if id == "css-letter-spacing" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-line-clamp" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-text-align-last" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-text-box-trim" {
    return Answer { support: "a", note: "`text-box`, `text-box-trim` and `text-box-edge` trim a block's first and last lines to the `cap`, `ex`, `text` or `alphabetic` edge of its own font, as for buttons and headings that hold their text. The trim does not yet reach into a first or last child block, works in horizontal writing modes only, and measures the block's font, so a taller inline box on the trimmed line overflows the edge instead of moving it." }
  }
  if id == "css-text-indent" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-text-justify" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-text-orientation" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-text-wrap-balance" {
    return Answer { support: "a", note: "`text-wrap: balance` evens out the lines of plain text, up to six lines, and aligns them in the full width. Text beside floats or broken across columns or pages, and `text-wrap: pretty`, wrap like `wrap`." }
  }
  if id == "css-textshadow" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-widows-orphans" {
    return Answer { support: "x", note: "About pages and printing. They are honored when a host lays out pages (`frameFragmented`); an app's continuous layout never breaks a paragraph across pages." }
  }
  if id == "css-writing-mode" {
    return Answer { support: "y", note: "" }
  }
  if id == "css3-tabsize" {
    return Answer { support: "y", note: "" }
  }
  if id == "extended-system-fonts" {
    return Answer { support: "y", note: "`ui-sans-serif`, `ui-serif`, `ui-monospace` and `ui-rounded` use the families the host sets for them (on macOS the system loader sets San Francisco, New York, SF Mono and SF Pro Rounded), then stand in for `system-ui`, `serif`, `monospace` and `system-ui`." }
  }
  if id == "font-family-system-ui" {
    return Answer { support: "y", note: "`system-ui` picks the platform's interface font from the installed fonts: San Francisco on macOS, Segoe UI on Windows, then Noto Sans or DejaVu Sans." }
  }
  if id == "font-feature" {
    return Answer { support: "y", note: "" }
  }
  if id == "font-kerning" {
    return Answer { support: "y", note: "" }
  }
  if id == "font-loading" {
    return Answer { support: "n", note: "There is no `FontFace` constructor or `document.fonts` in a JS app. Declare faces with `@font-face`; they load when text needs them." }
  }
  if id == "font-size-adjust" {
    return Answer { support: "y", note: "Each face is scaled so its `ex-height` (the default), `cap-height`, `ch-width`, `ic-width` or `ic-height` is the given fraction of `font-size`, so fallback faces match the first font. `from-font` takes the first available font's own aspect." }
  }
  if id == "font-smooth" {
    return Answer { support: "y", note: "`-webkit-font-smoothing: none` and `font-smooth: never` draw aliased glyphs. `antialiased`, `grayscale` and `subpixel-antialiased` all draw the grayscale antialiasing text always gets, as Chrome on macOS does." }
  }
  if id == "font-unicode-range" {
    return Answer { support: "y", note: "A face is requested only when text uses a character in its `unicode-range`; until then the next family draws it." }
  }
  if id == "font-variant-alternates" {
    return Answer { support: "y", note: "`historical-forms`, `stylistic()`, `styleset()`, `character-variant()`, `swash()`, `ornaments()` and `annotation()` turn on their OpenType features, with names from `@font-feature-values`. A name resolves in the first family of `font-family` that defines it. `@font-feature-values` inside `@media` or `@supports` is ignored." }
  }
  if id == "font-variant-numeric" {
    return Answer { support: "y", note: "" }
  }
  if id == "fontface" {
    return Answer { support: "y", note: "`src` takes `url()` (loaded by the host) and `local()` (an installed font); `unicode-range`, media conditions and cascade layers apply." }
  }
  if id == "kerning-pairs-ligatures" {
    return Answer { support: "y", note: "Kerning and ligatures are always on (turn them off with `font-kerning` or `font-feature-settings`); `text-rendering` is accepted and changes nothing." }
  }
  if id == "rem" {
    return Answer { support: "y", note: "" }
  }
  if id == "text-decoration" {
    return Answer { support: "y", note: "" }
  }
  if id == "text-emphasis" {
    return Answer { support: "y", note: "`text-emphasis`, `-style`, `-color` and `-position` draw a mark over or under each character, skipping spaces and punctuation, and the marks take room in the line when its half-leading cannot hold them. Keyword marks are drawn as shapes; a string mark draws its first character from the text's own font." }
  }
  if id == "text-overflow" {
    return Answer { support: "y", note: "" }
  }
  if id == "text-size-adjust" {
    return Answer { support: "x", note: "About mobile browsers enlarging the text of pages made for desktops. An app's text is drawn at the size it asks for." }
  }
  if id == "text-stroke" {
    return Answer { support: "a", note: "`-webkit-text-fill-color` fills the glyphs, while decorations, borders and `currentcolor` keep following `color`. `-webkit-text-stroke` is ignored: glyphs get no outline." }
  }
  if id == "ttf" {
    return Answer { support: "y", note: "" }
  }
  if id == "variable-fonts" {
    return Answer { support: "y", note: "" }
  }
  if id == "word-break" {
    return Answer { support: "y", note: "" }
  }
  if id == "wordwrap" {
    return Answer { support: "y", note: "" }
  }
  return Answer { support: "u", note: "" }
}
