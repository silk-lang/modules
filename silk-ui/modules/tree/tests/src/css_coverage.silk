effect fn everyRowMatchesSheet() -> ()
  ! TreeError | ProtocolError | CssError | CompileError | GeometryError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut i: usize = 0
  while true {
    let entry = match row(i) {
      Option.Some { value } => value
      Option.None => { return }
    }
    let mut inlineTree = run Tree.make(&fonts)
    let inlineFixture = run fixture(&mut inlineTree, entry)
    run restyle(&mut inlineTree, inlineFixture.target, entry.sample)
    drop run inlineTree.frame(viewport(), 0.0)
    let mut inlinePaint = List<u64>.make()
    let inlineLook = run look(&inlineTree, inlineFixture, &mut inlinePaint)

    let mut sheetTree = run Tree.make(&fonts)
    let sheetFixture = run fixture(&mut sheetTree, entry)
    run sheetTree.setAttribute(sheetFixture.target, Attribute.ClassName { value: run String.copy("sample") })
    drop run sheetTree.frame(viewport(), 0.0)
    let mut originalPaint = List<u64>.make()
    let originalLook = run look(&sheetTree, sheetFixture, &mut originalPaint)
    let mut source = run String.copy(".sample {")
    run String.append(&mut source, unsafe String.fromUtf8Unchecked(entry.sample))
    run String.append(&mut source, " !important}")
    let compiled = run compile.compile(String.utf8Bytes(String.view(&source)), &Options.make())
    run Testing.expect(compiled.diagnostics.length() == 0, unsafe String.fromUtf8Unchecked(entry.sample))
    let bytes = run compiled.encode()
    let mut batch = Batch.make()
    run batch.adoptStyleSheet(0, 1, bytes.asSlice())
    run sheetTree.apply(run batch.take())
    drop run sheetTree.frame(viewport(), 0.0)
    let mut sheetPaint = List<u64>.make()
    let sheetLook = run look(&sheetTree, sheetFixture, &mut sheetPaint)
    let paintsMatch = sameHashes(&inlinePaint, &sheetPaint)
      || (run sameRendered(&inlineTree, inlineFixture, &sheetTree, sheetFixture))
    run Testing.expect(sameFloats(&inlineLook, &sheetLook) && paintsMatch,
      unsafe String.fromUtf8Unchecked(entry.sample))
    run batch.removeStyleSheet(0, 1)
    run sheetTree.apply(run batch.take())
    drop run sheetTree.frame(viewport(), 0.0)
    let mut restoredPaint = List<u64>.make()
    let restoredLook = run look(&sheetTree, sheetFixture, &mut restoredPaint)
    run Testing.expect(sameFloats(&originalLook, &restoredLook) && sameHashes(&originalPaint, &restoredPaint),
      unsafe String.fromUtf8Unchecked(entry.sample))
    i = i + 1
  }
}

