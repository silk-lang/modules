//! CSS `zoom`: lengths in the subtree multiply by the effective zoom and lay out again, with the
//! cases of the css-viewport zoom tests in web-platform-tests.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, Input, Keymap, MOD_CONTROL }
import svg_css.compile { CompileError, Options }
import svg_css.compile
import svg_css.written
import svg_css.tokens { CssError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import ui_fixtures.fixtures as fixtures

fn frame() -> FrameInput { return FrameInput { width: 400.0, height: 400.0, scale: 1.0, time: 0.0 } }

fn height(tree: &UiTree<'_>, id: u32) -> f32 {
  let node = tree.node(tree.slotOf(id))
  return tree.output.fragments.values.asSlice()[tree.fragmentOf.get(node.css)].size.height
}

fn width(tree: &UiTree<'_>, id: u32) -> f32 {
  let node = tree.node(tree.slotOf(id))
  return tree.output.fragments.values.asSlice()[tree.fragmentOf.get(node.css)].size.width
}

fn near(a: f32, b: f32) -> bool { return a - b < 0.01 && b - a < 0.01 }

// relative-units.html: the root (1) and a box (3) both have `font-size: 10px; zoom: 2`. Box 2
// sits outside the zoomed box, box 4 inside it; `source` gives 2, 3 and 4 `height: 1<unit>`.
effect fn units(source: &[u8], outside: f32, zoomed: f32) -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("z") })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("z") })
  run batch.create(4, NodeKind.Box)
  run batch.append(3, 4)
  let sheet = run compile.compile(source, &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(near(height(&tree, 2), outside), "a unit outside the zoomed box scales with the root's zoom")
  run Testing.expect(near(height(&tree, 3), zoomed), "a unit on the zoomed box scales with both zooms")
  run Testing.expect(near(height(&tree, 4), zoomed), "a unit inside the zoomed box scales with both zooms")
}

effect fn unitsBody() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run units(b".z{display:block;font-size:10px;line-height:10px;zoom:2}.z>*{display:block;height:1px}", 2.0, 4.0)
  run units(b".z{display:block;font-size:10px;line-height:10px;zoom:2}.z>*{display:block;height:1em}", 20.0, 40.0)
  run units(b".z{display:block;font-size:10px;line-height:10px;zoom:2}.z>*{display:block;height:1rem}", 20.0, 40.0)
  run units(b".z{display:block;font-size:10px;line-height:10px;zoom:2}.z>*{display:block;height:1lh}", 20.0, 40.0)
  run units(b".z{display:block;font-size:10px;line-height:10px;zoom:2}.z>*{display:block;height:1rlh}", 20.0, 40.0)
  run units(b".z{display:block;font-size:10px;line-height:10px;zoom:2}.z>*{display:block;height:1vh}", 8.0, 16.0)
  run units(b".z{display:block;font-size:10px;line-height:10px;zoom:2}.z>*{display:block;height:1vw}", 8.0, 16.0)
  run units(b".z{display:block;font-size:10px;line-height:10px;zoom:2}.z>*{display:block;height:1in}", 192.0, 384.0)
  run units(b".z{display:block;font-size:10px;line-height:10px;zoom:2}.z>*{display:block;height:1%}", 0.0, 0.0)
}

test effect fn cssZoomMultipliesLengthUnits() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run unitsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Inline styles, which take the tree's own style path rather than a sheet's.
effect fn inlineBody() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"display:block;width:400px;font-size:12px;letter-spacing:1px")
  run batch.style(1, root.asSlice())
  // inherited-length.html: `width: inherit` under `zoom: 2` doubles the parent's 50px.
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  let parent = run written.declarations(b"display:block;width:50px;height:50px")
  run batch.style(2, parent.asSlice())
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  let child = run written.declarations(b"display:block;zoom:2;width:inherit;height:inherit")
  run batch.style(3, child.asSlice())
  // An inherited font size and letter spacing follow the zoom; percentages do not move.
  run batch.create(4, NodeKind.Box)
  run batch.append(1, 4)
  let zoomed = run written.declarations(b"display:block;zoom:150%;width:50%;height:10px;border:thin solid")
  run batch.style(4, zoomed.asSlice())
  // Nested zooms multiply; `zoom: 0` reads as 1.
  run batch.create(5, NodeKind.Box)
  run batch.append(4, 5)
  let nested = run written.declarations(b"display:block;zoom:2;width:10px;height:10px")
  run batch.style(5, nested.asSlice())
  run batch.create(6, NodeKind.Box)
  run batch.append(5, 6)
  let zero = run written.declarations(b"display:block;zoom:0;width:10px;height:1em")
  run batch.style(6, zero.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(near(width(&tree, 3), 100.0) && near(height(&tree, 3), 100.0), "width: inherit doubles under zoom: 2")
  let four = tree.node(tree.slotOf(4)).computed().*
  run Testing.expect(near(four.text.zoom, 1.5), "zoom: 150% is 1.5")
  run Testing.expect(near(four.text.size, 18.0), "the inherited 12px font size is 18px at zoom 1.5")
  run Testing.expect(near(four.text.letterSpacing, 1.5), "inherited letter spacing follows the zoom")
  run Testing.expect(near(width(&tree, 4), 203.0), "a percentage width does not zoom")
  run Testing.expect(near(height(&tree, 4), 15.0 + 3.0), "px and thin borders zoom")
  run Testing.expect(near(width(&tree, 5), 30.0), "nested zooms multiply")
  run Testing.expect(near(width(&tree, 6), 30.0) && near(height(&tree, 6), 36.0), "zoom: 0 reads as 1")
  // Zoom 1 again lays the box out at its own lengths.
  let mut again = Batch.make()
  let plain = run written.declarations(b"zoom:normal")
  run again.style(4, plain.asSlice())
  run tree.apply(run again.take())
  run tree.frame(frame())
  run Testing.expect(near(height(&tree, 4), 12.0), "zoom: normal restores the lengths")
  run Testing.expect(near(tree.node(tree.slotOf(5)).computed().text.size, 24.0), "descendants follow the new zoom")
}

test effect fn cssZoomRescalesInheritedLengths() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inlineBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Page zoom: the root's lengths and text grow, media queries and viewport units read the
// viewport over the zoom, and Ctrl with = - 0 steps it when the host turns the keys on.
effect fn pageBody() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  tree.keymap = Keymap.Standard
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("a") })
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("b") })
  // container-queries.html: queries compare CSS pixels, not the zoomed box.
  run batch.create(4, NodeKind.Box)
  run batch.append(1, 4)
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("c") })
  run batch.create(5, NodeKind.Box)
  run batch.append(4, 5)
  run batch.attribute(5, Attribute.ClassName { value: run String.copy("d") })
  let source = b".a{display:block;width:100px;height:1em}@media (max-width: 300px){.a{width:50px}}.b{display:block;width:50vw;height:10px}.c{display:block;container-type:inline-size;width:100px;zoom:2}.d{display:block;height:1px}@container (width > 120px){.d{height:9px}}"
  let sheet = run compile.compile(source, &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(frame())
  run Testing.expect(near(width(&tree, 2), 100.0) && near(height(&tree, 2), 16.0), "at 100% nothing moves")
  run Testing.expect(near(height(&tree, 5), 2.0), "a 100px container at zoom 2 does not match width > 120px")
  run Testing.expect(tree.setPageZoom(2.0), "the zoom changes")
  run tree.frame(frame())
  run Testing.expect(near(height(&tree, 2), 32.0), "text and em lengths double")
  run Testing.expect(near(width(&tree, 2), 100.0), "the media query sees a 200px viewport and matches: 50px at 2x")
  run Testing.expect(near(width(&tree, 3), 200.0) && near(height(&tree, 3), 20.0), "50vw is still half the window")
  run Testing.expect(!tree.setPageZoom(2.0), "the same zoom changes nothing")
  run keyDown(&mut tree, "=", MOD_CONTROL)
  run Testing.expect(tree.pageZoom() == 2.0, "the keys are off until the host turns them on")
  tree.zoomKeys = true
  run keyDown(&mut tree, "=", MOD_CONTROL)
  run Testing.expect(tree.pageZoom() == 2.5, "Ctrl = zooms in a step")
  run keyDown(&mut tree, "-", MOD_CONTROL)
  run keyDown(&mut tree, "-", MOD_CONTROL)
  run Testing.expect(near(tree.pageZoom(), 1.75), "Ctrl - zooms out a step")
  run keyDown(&mut tree, "0", MOD_CONTROL)
  run tree.frame(frame())
  run Testing.expect(tree.pageZoom() == 1.0 && near(width(&tree, 2), 100.0) && near(height(&tree, 2), 16.0), "Ctrl 0 goes back to 100%")
}

effect fn keyDown(tree: &mut UiTree<'_>, key: string, modifiers: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  run tree.dispatch(Input.KeyDown { key: run String.copy(key), code: run String.copy(key), modifiers: modifiers, repeat: false })
}

test effect fn pageZoomReflowsAgainstASmallerViewport() -> ()
  ! TreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pageBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
