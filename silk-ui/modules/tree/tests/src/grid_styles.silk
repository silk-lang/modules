  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run contentSizedColumns() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn gridStylesNameLinesAndAreas() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run namedLinesAndAreas() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn gridStylesPlaceItems() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run placementShorthands() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Grid 3 grid lanes from style: each item goes to the shortest lane, with both spellings,
/// and setting a track list again turns the older `masonry` spelling back into a grid.
effect fn lanesFromStyle() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let items = run grid(&mut tree, b"display: grid-lanes; grid-template-columns: 100px 100px", 3)
  let nodes = items.asSlice()
  run restyle(&mut tree, nodes[1], b"height: 50px")
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(run at(&tree, nodes[2], 100.0, 0.0), "the second item takes the empty lane")
  run Testing.expect(run at(&tree, nodes[3], 100.0, 20.0), "the third goes under the shorter one")

  run restyle(&mut tree, nodes[0], b"display: grid; grid-template-rows: masonry")
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(run at(&tree, nodes[3], 100.0, 20.0), "grid-template-rows: masonry stacks the same way")

  run restyle(&mut tree, nodes[0], b"grid-template-rows: auto")
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(run at(&tree, nodes[3], 0.0, 50.0), "a track list makes it a grid again")
}

test effect fn gridStylesStackLanes() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run lanesFromStyle() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn expandReceiptScroll() -> ()
  ! LegacyTreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let source = b".sink { --gap: 14px; --cell: 288px; width: 400px; height: 900px; overflow: auto; } :where(.sink) { *, *::before, *::after { box-sizing: border-box; } .bento { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--cell), 1fr)); grid-auto-rows: 320px; grid-auto-flow: dense; gap: var(--gap); } .tile { position: relative; display: flex; flex-direction: column; min-width: 0; overflow: hidden; } .tile[data-size='tall'] { grid-row: span 2; } .tile-stage { position: relative; flex: 1; min-height: 0; display: grid; place-items: center; padding: 22px 22px 16px; overflow: hidden; } .tile-copy { height: 100px; } } .ly-orders { display: flex; flex-direction: column; gap: 8px; width: 100%; height: 100%; overflow: auto; align-self: start; scrollbar-width: none; } .ly-order { flex: none; } .ly-order-trigger { height: 60px; width: 100%; } .ly-receipt { height: var(--ly-panel); overflow: hidden; transition: height 280ms; } .ly-receipt:is([data-starting-style], [data-ending-style]) { height: 0; opacity: 0; } .ly-receipt-lines { height: 200px; }"
  let sheet = run compile.compile(source, &Options.make())
  let bytes = run sheet.encode()
  let mut batch = Batch.make()
  // 1: root (.sink), 2: .bento, 3: .tile[data-size=tall], 4: .tile-stage, 5: .ly-orders, 6: .tile-copy
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("sink") })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("bento") })
  run batch.create(3, NodeKind.Box)
  run batch.append(2, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("tile") })
  run batch.attribute(3, Attribute.Named { name: run String.copy("data-size"), value: Option<String>.some(run String.copy("tall")) })
  run batch.create(4, NodeKind.Box)
  run batch.append(3, 4)
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("tile-stage") })
  run batch.create(5, NodeKind.Box)
  run batch.append(4, 5)
  run batch.attribute(5, Attribute.ClassName { value: run String.copy("ly-orders") })
  run batch.create(6, NodeKind.Box)
  run batch.append(3, 6)
  run batch.attribute(6, Attribute.ClassName { value: run String.copy("tile-copy") })
  // Order 1 (10: .ly-order, 11: trigger, 12: panel open with --ly-panel: auto, 13: lines)
  run batch.create(10, NodeKind.Box)
  run batch.append(5, 10)
  run batch.attribute(10, Attribute.ClassName { value: run String.copy("ly-order") })
  run batch.create(11, NodeKind.Box)
  run batch.append(10, 11)
  run batch.attribute(11, Attribute.ClassName { value: run String.copy("ly-order-trigger") })
  run batch.create(12, NodeKind.Box)
  run batch.append(10, 12)
  run batch.attribute(12, Attribute.ClassName { value: run String.copy("ly-receipt") })
  run batch.customProperty(12, StyleState.Base, "--ly-panel", Option<string>.some("auto"), false)
  run batch.create(13, NodeKind.Box)
  run batch.append(12, 13)
  run batch.attribute(13, Attribute.ClassName { value: run String.copy("ly-receipt-lines") })
  // Order 2 (20: .ly-order, 21: trigger; panel 22 not mounted yet)
  run batch.create(20, NodeKind.Box)
  run batch.append(5, 20)
  run batch.attribute(20, Attribute.ClassName { value: run String.copy("ly-order") })
  run batch.create(21, NodeKind.Box)
  run batch.append(20, 21)
  run batch.attribute(21, Attribute.ClassName { value: run String.copy("ly-order-trigger") })
  // Order 3 (30: .ly-order, 31: trigger)
  run batch.create(30, NodeKind.Box)
  run batch.append(5, 30)
  run batch.attribute(30, Attribute.ClassName { value: run String.copy("ly-order") })
  run batch.create(31, NodeKind.Box)
  run batch.append(30, 31)
  run batch.attribute(31, Attribute.ClassName { value: run String.copy("ly-order-trigger") })
  // Order 4 (40: .ly-order, 41: trigger)
  run batch.create(40, NodeKind.Box)
  run batch.append(5, 40)
  run batch.attribute(40, Attribute.ClassName { value: run String.copy("ly-order") })
  run batch.create(41, NodeKind.Box)
  run batch.append(40, 41)
  run batch.attribute(41, Attribute.ClassName { value: run String.copy("ly-order-trigger") })
  run tree.apply(run batch.take())

  let vp = FrameInput { width: 400.0, height: 900.0, scale: 1.0, time: 0.0 }
  run tree.frame(vp)
  let mOrders1 = cssom_view.metrics(&tree, 5)
  let mStage1 = cssom_view.metrics(&tree, 4)

  // Now expand Order 2 as bindPanel does when getAnimations() returns []:
  // 1) mount panel 22 + lines 23 + data-starting-style
  let mut b2 = Batch.make()
  run b2.create(22, NodeKind.Box)
  run b2.append(20, 22)
  run b2.attribute(22, Attribute.ClassName { value: run String.copy("ly-receipt") })
  run b2.attribute(22, Attribute.Named { name: run String.copy("data-open"), value: Option<String>.some(String.make()) })
  run b2.attribute(22, Attribute.Named { name: run String.copy("data-starting-style"), value: Option<String>.some(String.make()) })
  run b2.create(23, NodeKind.Box)
  run b2.append(22, 23)
  run b2.attribute(23, Attribute.ClassName { value: run String.copy("ly-receipt-lines") })
  run tree.apply(run b2.take())
  run tree.frame(FrameInput { width: 400.0, height: 900.0, scale: 1.0, time: 0.016 })
  let mPanelStart = cssom_view.metrics(&tree, 22)

  // 2) set --ly-panel: 200px
  let mut b3 = Batch.make()
  run b3.customProperty(22, StyleState.Base, "--ly-panel", Option<string>.some("200px"), false)
  run tree.apply(run b3.take())
  run tree.frame(FrameInput { width: 400.0, height: 900.0, scale: 1.0, time: 0.032 })

  // 3) In the SAME callback (when getAnimations() is empty), remove data-starting-style AND set --ly-panel: auto!
  let mut b4 = Batch.make()
  run b4.attribute(22, Attribute.Named { name: run String.copy("data-starting-style"), value: Option<String>.None })
  run b4.customProperty(22, StyleState.Base, "--ly-panel", Option<string>.some("auto"), false)
  run tree.apply(run b4.take())
  run tree.frame(FrameInput { width: 400.0, height: 900.0, scale: 1.0, time: 0.048 })

  let mOrders2 = cssom_view.metrics(&tree, 5)
  let mStage2 = cssom_view.metrics(&tree, 4)
  let mPanelEnd = cssom_view.metrics(&tree, 22)

  let scrolls = tree.scene().scrolls()
  let mut maxY: f32 = -1.0
  let mut i: usize = 0
  while i < scrolls.length {
    if scrolls[i].node == 5 { maxY = scrolls[i].maxY }
    i = i + 1
  }

  // Try wheel scroll inside orders
  run tree.dispatch(TreeInput.Wheel { x: 100.0, y: 100.0, deltaX: 0.0, deltaY: 60.0, modifiers: 0 })
  run tree.frame(FrameInput { width: 400.0, height: 900.0, scale: 1.0, time: 0.064 })
  let mOrders3 = cssom_view.metrics(&tree, 5)

  run Testing.expect(mOrders1.scrollHeight <= mOrders1.clientHeight, "orders1 does not overflow before expand")
  run Testing.expect(mPanelStart.scrollHeight == 200.0, "panel scrollHeight at starting style is 200")
  run Testing.expect(mPanelEnd.clientHeight == 200.0, "panel expanded to 200")
  run Testing.expect(mStage2.clientHeight == mStage1.clientHeight, "stage2 height stays same")
  run Testing.expect(mOrders2.clientHeight == mOrders1.clientHeight, "orders2 clientHeight stays same")
  run Testing.expect(mOrders2.scrollHeight > mOrders2.clientHeight + 100.0, "orders scrollHeight exceeds clientHeight")
  run Testing.expect(maxY > 100.0, "scene scroll maxY > 100")
  run Testing.expect(mOrders3.scrollTop > 0.0, "wheel scrolled orders")
}

test effect fn gridStylesExpandReceiptScroll() -> ()
  ! LegacyTreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run expandReceiptScroll() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aspectRatioSlashAndAuto() -> ()
  ! LegacyTreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let source = b".wrap { width: 400px; } .a { width: 120px; aspect-ratio: 4 / 3; } .b { width: 120px; aspect-ratio: auto 4 / 3; } .c { width: 120px; aspect-ratio: 4 / 3 auto; } .d { width: 120px; aspect-ratio: 2; } .e { width: 120px; height: 50px; aspect-ratio: 4 / 3; aspect-ratio: auto; }"
  let sheet = run compile.compile(source, &Options.make())
  let bytes = run sheet.encode()
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.adoptStyleSheet(0, 1, bytes.asSlice())
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("wrap") })
  run batch.create(2, NodeKind.Box)
  run batch.append(1, 2)
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("a") })
  run batch.create(3, NodeKind.Box)
  run batch.append(1, 3)
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("b") })
  run batch.create(4, NodeKind.Box)
  run batch.append(1, 4)
  run batch.attribute(4, Attribute.ClassName { value: run String.copy("c") })
  run batch.create(5, NodeKind.Box)
  run batch.append(1, 5)
  run batch.attribute(5, Attribute.ClassName { value: run String.copy("d") })
  run batch.create(6, NodeKind.Box)
  run batch.append(1, 6)
  run batch.attribute(6, Attribute.ClassName { value: run String.copy("e") })
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 400.0, height: 600.0, scale: 1.0, time: 0.0 })
  let ra = run cssom_view.getBoundingClientRect(&tree, 2)
  let rb = run cssom_view.getBoundingClientRect(&tree, 3)
  let rc = run cssom_view.getBoundingClientRect(&tree, 4)
  let rd = run cssom_view.getBoundingClientRect(&tree, 5)
  let re = run cssom_view.getBoundingClientRect(&tree, 6)
  run Testing.expect(ra.height > 89.5 && ra.height < 90.5, "aspect-ratio: 4 / 3 gives 90px height for 120px width")
  run Testing.expect(rb.height > 89.5 && rb.height < 90.5, "aspect-ratio: auto 4 / 3 gives 90px height")
  run Testing.expect(rc.height > 89.5 && rc.height < 90.5, "aspect-ratio: 4 / 3 auto gives 90px height")
  run Testing.expect(rd.height > 59.5 && rd.height < 60.5, "aspect-ratio: 2 gives 60px height")
  run Testing.expect(re.height > 49.5 && re.height < 50.5, "aspect-ratio: auto clears prior ratio")
}

test effect fn gridStylesAspectRatioSlash() -> ()
  ! LegacyTreeError | CompileError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aspectRatioSlashAndAuto() |> Effect.provideMut<Allocator>(&mut allocator)
}
