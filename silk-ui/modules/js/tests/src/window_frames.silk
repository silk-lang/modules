import ui_js.lib { JsError, uiPackage }
import ui_js_window.lib { JsApp, JsClient, NoTools }
import ui_tree.legacy { UiTree, TreeError, FrameInput }
import ui_tree_window.host { WindowClient }
import ui_fixtures.fixtures as fixtures
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.runtime_memory { RuntimeAllocator }

effect fn idleFrames() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let domain = run WaiterDomain.make()
  let memoryAllocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run memoryAllocator.observe()
  let mut app = run JsApp.open(&memory, move memoryAllocator, domain.handle())
  run app.define(b"@silkui/core", uiPackage())
  run app.entry(b"frames.js", b"import {createBox,createText,mount} from '@silkui/core'; const text=createText('0'); mount(createBox({},text)); let count=0; const schedule=()=>requestAnimationFrame(()=>{text.data=String(++count)}); setTimeout(schedule,1000); setTimeout(schedule,2000);")
  let result = run Effect.result(checkFrames(&mut app, &mut tree))
  run app.close()
  match move result {
    Result.Success { .. } => {}
    Result.Failure { error } => { fail move error }
  }
}

effect fn checkFrames<'m>(app: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut client = JsClient.make(NoTools {})
  run app.startEntry(&mut tree.*)
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client, &mut app.*, &mut tree.*, FrameInput { width: 420.0, height: 200.0, scale: 1.0, time: 0.0 })
  run Testing.expect(!WindowClient<JsApp<'m>, never, never>.needsFrame(&client, &app.*, &tree.*), "the initial window becomes idle")
  let times = [1.0, 2.0]
  let expected = ["1", "2"]
  let mut index: usize = 0
  while index < times.length {
    run WindowClient<JsApp<'m>, never, never>.tick(&mut client, &mut app.*, &mut tree.*, times[index], false)
    run Testing.expect(!tree.needsFrame(), "requestAnimationFrame has not changed the tree yet")
    run Testing.expect(WindowClient<JsApp<'m>, never, never>.needsFrame(&client, &app.*, &tree.*), "a requested JavaScript frame wakes an idle window")
    run WindowClient<JsApp<'m>, never, never>.tick(&mut client, &mut app.*, &mut tree.*, times[index], true)
    run WindowClient<JsApp<'m>, never, never>.layout(&mut client, &mut app.*, &mut tree.*, FrameInput { width: 420.0, height: 200.0, scale: 1.0, time: times[index] })
    run Testing.expect(String.view(&tree.node(tree.slotOf(1)).text) == expected[index], "the scheduled callback updates the visible text")
    run Testing.expect(!WindowClient<JsApp<'m>, never, never>.needsFrame(&client, &app.*, &tree.*), "the completed callback lets the window sleep again")
    index = index + 1
  }
}

test effect fn javascriptFramesWakeIdleWindowsRepeatedly() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run idleFrames() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn virtualFrame() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let domain = run WaiterDomain.make()
  let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut app = run JsApp.open(&memory, move allocator, domain.handle())
  run app.define(b"@silkui/core", uiPackage())
  run app.entry(b"list.js", b"import {createBox,mount} from '@silkui/core'; const p=mount(createBox({height:200,display:'flex',flexDirection:'column',overflowY:'auto'})); p.setVirtualList({count:1000000,estimatedRowHeight:32},indices=>{ for(const i of indices)p.appendChild(createBox({height:32,flexShrink:0})); p.bindVirtualRows(indices); });")
  run firstVirtualFrame(&mut app, &mut tree)
  run app.close()
  run Testing.expect(tree.virtualLists.length() == 1, "JavaScript configured a native list")
  let list = &tree.virtualLists.asSlice()[0]
  run Testing.expect(list.count == 1000000 && list.rows.length() == list.end - list.first
    && list.rows.length() >= 7 && list.rows.length() < 40,
    "the first JS frame binds the native request, not the entire data set")
}

effect fn firstVirtualFrame<'m>(app: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut client = JsClient.make(NoTools {})
  run app.startEntry(&mut tree.*)
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client, &mut app.*, &mut tree.*, FrameInput { width: 400.0, height: 200.0, scale: 1.0, time: 0.0 })
}

test effect fn javascriptVirtualListBindsBeforePresenting() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run virtualFrame() |> Effect.provideMut<Allocator>(&mut allocator)
}
