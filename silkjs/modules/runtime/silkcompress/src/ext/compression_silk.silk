  if j.op == 8 { unsafe runWrite(&mut j, &mut h) return () }
  if j.op == 3 {
    h.ended = false h.header = 0 h.headerLength = 0 h.gzip = h.kind == 4 h.ignoring = false h.frameSeen = false
    h.pledged = false h.frameInput = 0
