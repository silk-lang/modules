import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// A canvas context that is configured: its canvas, the device that draws it and the node
/// that shows it.
struct Shown {
  canvas: GpuCanvas,
  device: u32,
  node: u32,
  /// Whether a context asked for the texture since the last present.
  drawn: bool,
}

/// What a number of JavaScript's stands for.
union Object {
  Empty,
  Adapter { value: Adapter },
  Device { value: CanvasGpu },
  Buffer { value: Buffer },
  Texture { value: Texture },
  View { value: TextureView },
  Sampler { value: Sampler },
  BindGroupLayout { value: BindGroupLayout },
  PipelineLayout { value: PipelineLayout },
  BindGroup { value: BindGroup },
  Shader { value: ShaderModule },
  RenderPipeline { value: RenderPipeline },
  ComputePipeline { value: ComputePipeline },
  Commands { value: CommandBuffer },
  Canvas { value: Shown },
}

/// The GPU side of one ui-js realm.
pub struct GpuService {
  instance: Option<Instance>,
  presenter: CanvasPresenter,
  objects: List<Object>,
  replies: List<GpuReply>,
  /// The token of the command being run, 0 when it has none: a failure answers it.
  token: u32,
  /// The device of the command being run, for the error of a command that fails.
  device: u32,
  /// The buffers JavaScript mapped for writing and did not unmap yet.
  maps: List<Held>,
}

/// A buffer mapped for writing: dropping `mapped` unmaps it.
struct Held {
  buffer: u32,
  mapped: MappedBuffer,
}

effect fn problem(text: &[u8]) -> GpuError
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut message = List<u8>.make()
  run message.appendSlice(text)
  return GpuError { code: flags.WGPUErrorType_Validation, message: move message }
}

effect fn slot<'o>(objects: &'o List<Object>, id: u32) -> &'o Object
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let values = objects.asSlice()
  let at = u32.toUsize(id)
  if at >= values.length {
    fail run problem(b"a GPU object that does not exist was used")
  }
  return &values[at]
}

effect fn deviceOf<'o>(objects: &'o List<Object>, id: u32) -> &'o CanvasGpu
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let found = run slot(objects, id)
  match &found.* {
    Object.Device { value } => {
      return &value
    }
    _ => {
      fail run problem(b"a GPU device that does not exist was used")
    }
  }
}

