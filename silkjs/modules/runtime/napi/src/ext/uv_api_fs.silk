@deferredCallbacks("cb")
pub unsafe export "C" fn uv_fs_open(loop: ?*mut u8, req: ?*mut u8, path: ?*const u8, flags: i32, mode: i32, cb: FsCallback) -> i32 { return unsafe fsOpen(loop, req, path, flags, mode, cb) }
@deferredCallbacks("cb")
pub unsafe export "C" fn uv_fs_read(loop: ?*mut u8, req: ?*mut u8, file: i32, bufs: ?*const u8, nbufs: u32, off: i64, cb: FsCallback) -> i32 {
  return unsafe ioRequest(loop, req, FS_READ, file, unsafe Intrinsic.pointerReinterpret<?*const u8, ?*const Buf>(bufs), nbufs, off, cb)
}
@deferredCallbacks("cb")
pub unsafe export "C" fn uv_fs_write(loop: ?*mut u8, req: ?*mut u8, file: i32, bufs: ?*const u8, nbufs: u32, off: i64, cb: FsCallback) -> i32 {
  return unsafe ioRequest(loop, req, FS_WRITE, file, unsafe Intrinsic.pointerReinterpret<?*const u8, ?*const Buf>(bufs), nbufs, off, cb)
