//! Node-API and `process.dlopen`: the runtime's real `NativeAddons` capability.
//!
//! A program that provides `DlopenAddons` depends on this package, and so exports Node-API's C
//! functions and libuv 1.51's C API (in Silk, ext.uv_api_*) for addons to find by name; a program that provides `EmptyAddons` has none of them.
//! The functions that take a callback cannot be taken as values, which is what makes a
//! dependency's C export appear, so a program that loads addons exports those itself, as
//! cli/src/napi_exports.silk does.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjsruntime.ext.diagnostics_fatal { RuntimeHeap }
import silkjsruntime.ext.fs_async as fs_async
import silkjsruntime.ext.worker_native
import silkjsruntime.libs.core.capabilities { NativeAddons, Composition }
import silkjsruntime.libs.core.host { Services }
import ext.napi_native
import ext.napi_async
import ext.napi_core
import ext.napi_values
import ext.uv_api_abi
import ext.uv_api_fs
import ext.uv_api_loop
import ext.uv_api_stream
import ext.uv_api_sys
import ext.uv_loop

/// Addons loaded with dlopen, over Node-API.
pub struct DlopenAddons {
  state: ?*mut napi_native.State,
}
impl Copy for DlopenAddons {}

impl DlopenAddons {
  /// Nothing opened yet: the runtime opens it when it starts.
  pub fn make() -> DlopenAddons { return DlopenAddons { state: Pointer.null<napi_native.State>() } }
  unsafe fn opened(self: &Self) -> *mut napi_native.State {
    if Pointer.isNull<napi_native.State>(self.state) { Intrinsic.trap("Node-API provider is not initialized") }
    return unsafe Intrinsic.pointerRequalify<?*mut napi_native.State, *mut napi_native.State>(self.state)
  }
}

impl NativeAddons for DlopenAddons {
  static fn present() -> bool { return true }
  fn forWorker(self: &Self) -> Self { return DlopenAddons.make() }
  effect fn open(self: &mut Self, allocator: *mut RuntimeHeap, workers: *mut u8, io: *mut fs_async.State) -> () ! OutOfMemoryError {
    // Node-API's C functions are emitted, for addons to find by name, when something takes them.
    napi_native.keepExports() napi_async.keepExports() napi_core.keepExports() napi_values.keepExports()
    // So is libuv's C API, which addons call on the loop napi_get_uv_event_loop gives them.
    uv_api_abi.keepExports() uv_api_fs.keepExports() uv_api_loop.keepExports() uv_api_stream.keepExports()
    uv_api_sys.keepExports() uv_loop.keepExports()
    self.state = run napi_native.open(allocator, workers, worker_native.silkNodeFatalReport, io)
  }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    return run unsafe napi_native.dispatch(&mut engine, context, unsafe self.opened(), argc, argv)
  }
  unsafe fn freeBuffer<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, opaque: ?*mut u8) -> () {
    unsafe napi_native.freeBuffer(&mut engine, unsafe self.opened(), opaque)
  }
  unsafe fn alive(self: &Self) -> bool {
    return match Pointer.nonNullMut<napi_native.State>(self.state) {
      Option<*mut napi_native.State>.Some { value } => unsafe napi_native.alive(value)
      Option<*mut napi_native.State>.None => false
    }
  }
  unsafe fn poll<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> bool {
    return match Pointer.nonNullMut<napi_native.State>(self.state) {
      Option<*mut napi_native.State>.Some { value } => unsafe napi_native.poll(&mut engine, context, value)
      Option<*mut napi_native.State>.None => false
    }
  }
  unsafe fn close<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> () {
    if let Option<*mut napi_native.State>.Some { value } = Pointer.nonNullMut<napi_native.State>(self.state) { unsafe napi_native.close(&mut engine, context, value) }
  }
  unsafe fn loaded(self: &Self) -> bool {
    return match Pointer.nonNullMut<napi_native.State>(self.state) {
      Option<*mut napi_native.State>.Some { value } => unsafe napi_native.loaded(value)
      Option<*mut napi_native.State>.None => false
    }
  }
  unsafe fn dispose(self: &mut Self) -> () {
    if let Option<*mut napi_native.State>.Some { value } = Pointer.nonNullMut<napi_native.State>(self.state) { unsafe napi_native.dispose(value) }
    self.state = Pointer.null<napi_native.State>()
  }
}
