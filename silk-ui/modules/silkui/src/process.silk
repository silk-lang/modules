//! Programs the steps start and keep running beside the tasks program: Vite's development
//! server, an app's window. Unlike `Task.exec`, starting one does not wait for it.
//!
//! Each program leads a process group of its own, so stopping it reaches what it started too
//! (npm, its shell, Vite, the window Vite started). While one runs, SIGTERM, SIGINT and SIGHUP do
//! not end the tasks program at once: the next wait stops the program's group, then the tasks
//! program ends by the same signal.
static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
import silk.cli.task { Task, TaskError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { FileError, Path }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.signal_watch { SignalError, SignalWatch }
import silk.system.subprocess { Subprocess, SubprocessError, SpawnOptions, Stdio, ExitStatus }

unsafe extern "C" fn getpid() -> i32
unsafe extern "C" fn kill(pid: i32, signal: i32) -> i32

/// One environment variable a started program gets besides the task's own.
pub struct Variable<'a> {
  pub name: string<'static>,
  pub value: string<'a>,
}

/// A started program.
pub struct Child {
  process: Subprocess,
  running: bool,
  code: i32,
  /// The signals that end the tasks program, held while the program runs.
  stops: Option<SignalWatch>,
}

// Holds SIGTERM, SIGINT and SIGHUP, or none when the system refuses.
effect fn stopSignals() -> Option<SignalWatch> {
  let opened = run Effect.result(watched())
  return match move opened {
    Result<SignalWatch, SignalError>.Success { value } => Option<SignalWatch>.Some { value: move value }
    Result<SignalWatch, SignalError>.Failure { error } => {
      drop error
      Option<SignalWatch>.None
    }
  }
}

effect fn watched() -> SignalWatch ! SignalError {
  let mut watch = run SignalWatch.open()
  run watch.add(SignalWatch.terminate())
  run watch.add(SignalWatch.interrupt())
  run watch.add(SignalWatch.hangup())
  return move watch
}

/// Starts `program` (looked up on `PATH` when it has no `/`) with `arguments` in `directory`,
/// sharing the task's terminal and environment, plus `variables`. Does not wait for it.
pub effect fn start(program: string, arguments: &[string], directory: string, variables: &[Variable<'_>]) -> Child
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator {
  // env looks the program up on PATH, as a shell does.
  let env = run Path.make("/usr/bin/env")
  let within = run Path.make(directory)
  let mut request = run ChildProcess.requestWithin(&env, &within)
  run ChildProcess.addArgument(&mut request, program)
  let mut at: usize = 0
  while at < arguments.length {
    run ChildProcess.addArgument(&mut request, arguments[at])
    at = at + 1
  }
  run Subprocess.inheritEnvironment(&mut request)
  at = 0
  while at < variables.length {
    run ChildProcess.setVariable(&mut request, variables[at].name, variables[at].value)
    at = at + 1
  }
  let mut options = SpawnOptions.make()
  // Its own group, which `stop` signals whole. The terminal's Control-C then reaches only the
  // tasks program, which stops the group.
  options.setDetached(true)
  run options.setStdio(0, Stdio.inherit(0))
  run options.setStdio(1, Stdio.inherit(1))
  run options.setStdio(2, Stdio.inherit(2))
  // Held before the program starts, so that no signal falls between.
  let stops = run stopSignals()
  return match move run Effect.result(Subprocess.spawn(&request, &options)) {
    Result<Subprocess, SubprocessError | OutOfMemoryError>.Success { value } => Child { process: move value, running: true, code: 0, stops: move stops }
    Result<Subprocess, SubprocessError | OutOfMemoryError>.Failure { error } => {
      drop error
      run Task.abort("silkui: a program could not be started")
    }
  }
}

impl Child {
  /// Whether it has ended, collecting its status when it has. A stop signal that arrived stops
  /// the program, then ends the tasks program by that signal.
  pub fn ended(self: &mut Self) -> bool {
    if !self.running { return true }
    let arrived = self.arrived()
    if arrived != 0 {
      self.stop()
      // Without the watch the signal has its earlier action again: for these, ending the process.
      let _raised = unsafe kill(unsafe getpid(), arrived)
      return true
    }
    return self.collected()
  }

  // The first stop signal that arrived since the last look, or 0.
  fn arrived(self: &mut Self) -> i32 {
    if let Option<SignalWatch>.Some { value: watch } = &mut self.stops {
      let mut received: [i32; 4] = [0; 4]
      let read = run Effect.result(watch.read(&mut received))
      return match move read {
        Result<usize, SignalError>.Success { value: count } => if count != 0 { received[0] } else { 0 }
        Result<usize, SignalError>.Failure { error } => {
          drop error
          0
        }
      }
    }
    return 0
  }

  // Whether the program has ended, collecting its status when it has; the stop signals go back to
  // their earlier action then.
  fn collected(self: &mut Self) -> bool {
    if !self.running { return true }
    let result = run Effect.result(Subprocess.tryWait(self.process.pid()))
    match move result {
      Result<Option<ExitStatus>, SubprocessError>.Success { value } => match move value {
        Option<ExitStatus>.Some { value: status } => {
          self.running = false
          self.code = if status.signaled { 128 + status.signal } else { status.code }
        }
        Option<ExitStatus>.None => {}
      }
      Result<Option<ExitStatus>, SubprocessError>.Failure { error } => {
        drop error
        self.running = false
        self.code = 1
      }
    }
    if !self.running { self.stops = Option<SignalWatch>.None }
    return !self.running
  }

  /// Waits for it to end, and answers its exit status.
  pub fn wait(self: &mut Self) -> i32 {
    while !self.ended() { pause(50) }
    return self.code
  }

  /// Asks it and what it started to end (SIGTERM to its group), then makes them (SIGKILL) if
  /// they have not after five seconds.
  pub fn stop(self: &mut Self) -> () {
    if !self.running { return () }
    let group = 0 - self.process.pid()
    drop run Effect.result(Subprocess.kill(group, 15))
    let mut waited: u32 = 0
    // The leader ends first; the rest of its group can outlive it.
    while (!self.collected() || unsafe kill(group, 0) == 0) && waited < 200 {
      if waited == 100 { drop run Effect.result(Subprocess.kill(group, 9)) }
      pause(50)
      waited = waited + 1
    }
    self.stops = Option<SignalWatch>.None
  }
}

/// Waits `milliseconds`.
pub fn pause(milliseconds: u64) -> () {
  let mut clock = OsMonotonicClock.make()
  run MonotonicClock.waitFor(milliseconds * 1000000) |> Effect.provideMut<MonotonicClock>(&mut clock)
}
} else {
import silk.cli.task { Task, TaskError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError }

pub struct Variable<'a> {
  pub name: string<'static>,
  pub value: string<'a>,
}

/// Starting programs beside the tasks needs subprocess support Silk has only on macOS and Linux.
pub struct Child {}

pub effect fn start(program: string, arguments: &[string], directory: string, variables: &[Variable<'_>]) -> Child
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator {
  run Task.abort("silkui: starting programs needs Windows subprocess support in Silk")
}

impl Child {
  pub fn ended(self: &mut Self) -> bool { return true }
  pub fn wait(self: &mut Self) -> i32 { return 0 }
  pub fn stop(self: &mut Self) -> () {}
}

pub fn pause(milliseconds: u64) -> () {}
}
