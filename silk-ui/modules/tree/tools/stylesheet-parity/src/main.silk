import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, Attribute, FrameInput, info }
import ui_tree.style { Fill }
import ui_tree.style_media { Preferences }
import ui_fixtures.fixtures as fixtures
import css_style.compile { Options, CompileError }
import css_style.compile
import css_style.tokens { CssError }
import css_properties.computed { Display, DisplayInside, DisplayOutside, FlexDirection, FlexWrap, LineHeight }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.json.value { Json, JsonEntry, JsonNumber, Value }
import silk.json.scanner { JsonError }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.build.source { Source }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.filesystem_native { OsFileSystem }
import silk.text.string { String }
import silk.color.rgba { Rgba }
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_input { WindowsHostInput }
  import silk.system.host_input { HostInput }
} else {
  import silk.platform.native.host_input { NativeHostInput }
}
import silk.system.host_input { HostInputError }
import silk.num.f32
import silk.num.usize
import silk.core.result { Result }

fn word<'a>(row: &'a Value, key: string) -> string<'a> {
  return Json.field(row,key) |> Json.asString |> Option<string<'a>>.unwrapOr("")
}
fn flag(row: &Value, key: string) -> bool {
  return match Json.field(row,key) { Option.Some { value } => match &value.* { Value.Bool { value: yes } => yes _ => false } _ => false }
}
fn number(value: f32) -> Value { return Value.Number { value: JsonNumber.Float { value: f32.toF64(value) } } }
fn object() -> Value { return Value.Object { entries: List<JsonEntry>.make() } }
effect fn text(value: string) -> Value ! OutOfMemoryError ? &mut Allocator { return Value.String { text: run String.copy(value) } }
effect fn put(out: &mut Value, key: string, value: Value) ! OutOfMemoryError ? &mut Allocator {
  if let Value.Object { entries } = &mut out.* { run entries.append(JsonEntry { key: run String.copy(key), value: move value }) }
}
effect fn numbers(values: &[f32]) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<Value>.make()
  let mut i: usize = 0
  while i < values.length { run out.append(number(values[i])) i = i + 1 }
  return Value.Array { values: move out }
}
fn clamp(value: f32) -> f32 { return if value < 0.0 { 0.0 } else if value > 1.0 { 1.0 } else { value } }
effect fn color(value: Rgba<f32>) -> Value ! OutOfMemoryError ? &mut Allocator {
  let alpha = clamp(value.a)
  return run numbers(&[clamp(value.r)*alpha,clamp(value.g)*alpha,clamp(value.b)*alpha,alpha])
}
fn display(value: Display) -> string<'static> {
  return match value {
    Display.None => "none"
    Display.Contents => "contents"
    Display.Box { outside, inside } => match inside {
      DisplayInside.Flow => if outside == DisplayOutside.Inline { "inline" } else { "block" }
      DisplayInside.FlowRoot => if outside == DisplayOutside.Inline { "inline-block" } else { "flow-root" }
      DisplayInside.Flex => if outside == DisplayOutside.Inline { "inline-flex" } else { "flex" }
      DisplayInside.Grid => if outside == DisplayOutside.Inline { "inline-grid" } else { "grid" }
      DisplayInside.GridLanes => if outside == DisplayOutside.Inline { "inline-grid-lanes" } else { "grid-lanes" }
      DisplayInside.Table => if outside == DisplayOutside.Inline { "inline-table" } else { "table" }
      DisplayInside.TableRowGroup => "table-row-group"
      DisplayInside.TableHeaderGroup => "table-header-group"
      DisplayInside.TableFooterGroup => "table-footer-group"
      DisplayInside.TableRow => "table-row"
      DisplayInside.TableColumnGroup => "table-column-group"
      DisplayInside.TableColumn => "table-column"
      DisplayInside.TableCell => "table-cell"
      DisplayInside.TableCaption => "table-caption"
    }
  }
}
effect fn attribute(batch: &mut Batch, id: u32, name: string, value: string) ! OutOfMemoryError ? &mut Allocator {
  run batch.attribute(id,Attribute.Named { name: run String.copy(name), value: Option<String>.some(run String.copy(value)) })
}
effect fn node(batch: &mut Batch, id: u32, parent: u32, tag: string, name: string, classes: string) ! OutOfMemoryError ? &mut Allocator {
  run batch.create(id,NodeKind.Box)
  if parent != 0 { run batch.append(parent,id) }
  run batch.attribute(id,Attribute.Element { name: run String.copy(tag) })
  run batch.attribute(id,Attribute.ElementId { value: run String.copy(name) })
  run batch.attribute(id,Attribute.ClassName { value: run String.copy(classes) })
}

effect fn measure(row: &Value, sheet: &[u8], baseline: &[u8]) -> Value
  ! TreeError | OutOfMemoryError ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  drop tree.setStylePreferences(Preferences.desktop(false))
  let mut batch = Batch.make()
  run node(&mut batch,1,0,"html","root",word(row,"root"))
  run node(&mut batch,2,1,"body","body","")
  run node(&mut batch,3,2,"div","parent",word(row,"parent"))
  run node(&mut batch,4,3,"input","lead",word(row,"lead"))
  let tag = Json.field(row,"tag") |> Json.asString |> Option<string>.unwrapOr("div")
  run node(&mut batch,5,3,tag,"subject",word(row,"classes"))
  run node(&mut batch,6,5,"div","one","probe")
  run node(&mut batch,7,5,"div","two","probe")
  run node(&mut batch,8,5,"div","three","probe")
  run attribute(&mut batch,5,"data-state",if flag(row,"open") { "open" } else { "closed" })
  if flag(row,"childOpen") { run attribute(&mut batch,6,"data-state","open") }
  run attribute(&mut batch,4,"type","checkbox")
  run batch.attribute(4,Attribute.Checked { value: flag(row,"checked") })
  run batch.attribute(5,Attribute.Disabled { value: flag(row,"disabled") })
  run batch.root(1)
  run batch.adoptStyleSheet(0,1,baseline)
  run batch.adoptStyleSheet(0,2,sheet)
  run tree.apply(run batch.take())
  let subject = tree.slotOf(5)
  let parent = tree.slotOf(3)
  if flag(row,"hover") { let item = tree.nodeMut(subject) item.hovered = true }
  if flag(row,"parentHover") { let item = tree.nodeMut(parent) item.hovered = true }
  if flag(row,"focus") { tree.focused = subject tree.focusVisible = true }
  let width = Json.field(row,"width") |> Json.asF32 |> Option<f32>.unwrapOr(640.0)
  run tree.frame(FrameInput { width: width, height: 600.0, scale: 1.0, time: 0.0 })
  let c = &tree.node(subject).computed().*
  let mut values = object()
  run put(&mut values,"display",run text(display(c.layout.display)))
  run put(&mut values,"flex-direction",run text(match c.layout.flexDirection { FlexDirection.Row => "row" FlexDirection.RowReverse => "row-reverse" FlexDirection.Column => "column" FlexDirection.ColumnReverse => "column-reverse" }))
  run put(&mut values,"flex-wrap",run text(match c.layout.flexWrap { FlexWrap.NoWrap => "nowrap" FlexWrap.Wrap => "wrap" FlexWrap.WrapReverse => "wrap-reverse" }))
  run put(&mut values,"padding",run numbers(&[c.layout.padding.top.value,c.layout.padding.right.value,c.layout.padding.bottom.value,c.layout.padding.left.value]))
  run put(&mut values,"margin",run numbers(&[c.layout.margin.top.value,c.layout.margin.right.value,c.layout.margin.bottom.value,c.layout.margin.left.value]))
  run put(&mut values,"border",run numbers(&[c.layout.border.top.value,c.layout.border.right.value,c.layout.border.bottom.value,c.layout.border.left.value]))
  run put(&mut values,"radius",run numbers(&[c.paint.radii.topLeft,c.paint.radii.topRight,c.paint.radii.bottomRight,c.paint.radii.bottomLeft]))
  run put(&mut values,"gap",run numbers(&[c.layout.rowGap.value,c.layout.columnGap.value]))
  run put(&mut values,"font-size",number(c.text.size))
  run put(&mut values,"font-weight",number(c.text.weight))
  run put(&mut values,"line-height",number(match c.text.lineHeight { LineHeight.Number { value } => c.text.size*value LineHeight.Length { value } => value _ => c.text.size }))
  run put(&mut values,"letter-spacing",number(c.text.letterSpacing))
  run put(&mut values,"opacity",number(c.paint.opacity))
  run put(&mut values,"outline-width",number(c.outline.width))
  run put(&mut values,"outline-offset",number(c.outline.offset))
  run put(&mut values,"flex-grow",number(c.layout.flexGrow))
  run put(&mut values,"flex-shrink",number(c.layout.flexShrink))
  run put(&mut values,"color",run color(c.text.color))
  run put(&mut values,"background-color",run color(match c.paint.background { Fill.Solid { color: value } => value _ => Rgba<f32> { r: 0.0,g: 0.0,b: 0.0,a: 0.0 } }))
  run put(&mut values,"border-color",run color(c.paint.borderColor))
  let ids: [u32; 4] = [5,6,7,8]
  let mut boxes = List<Value>.make()
  let mut i: usize = 0
  while i < ids.length {
    let box = run info(&tree,ids[i])
    let values: [f32; 4] = match box {
      Option.Some { value } => if value.laidOut { [value.bounds.xMin,value.bounds.yMin,value.bounds.width(),value.bounds.height()] } else { [0.0,0.0,0.0,0.0] }
      _ => [0.0,0.0,0.0,0.0]
    }
    run boxes.append(run numbers(&values))
    i = i + 1
  }
  let mut out = object()
  run put(&mut out,"values",move values)
  run put(&mut out,"rects",Value.Array { values: move boxes })
  return move out
}

effect fn report() -> Value ! TreeError | CompileError | CssError | JsonError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let baseline = run compile.compile(Source.read("baseline.css"),&Options.make())
  let baselineBytes = run baseline.encode()
  let sources = ["/modules/tree/tests/fixtures/stylesheets/plain.css","/modules/tree/tests/fixtures/stylesheets/tailwind-small.css","/modules/tree/tests/fixtures/stylesheets/tailwind-app.css"]
  let mut sheets = List<Bytes>.make()
  let mut diagnostics = List<Value>.make()
  let mut i: usize = 0
  while i < sources.length {
    let path = run Path.make(sources[i])
    let source = run FileSystem.readFile(&path)
    let sheet = run compile.compile(source.asSlice(),&Options.make())
    run sheets.append(run sheet.encode())
    let mut entries = List<Value>.make()
    let mut d: usize = 0
    while d < sheet.diagnostics.length() {
      let entry = &sheet.diagnostics.asSlice()[d]
      let mut item = object()
      run put(&mut item,"count",Value.Number { value: JsonNumber.Unsigned { value: usize.toU64(entry.count) } })
      let feature = match String.fromUtf8(entry.feature.asSlice()) { Result.Success { value } => value _ => "" }
      run put(&mut item,"feature",run text(feature))
      run entries.append(move item)
      d = d + 1
    }
    run diagnostics.append(Value.Array { values: move entries })
    i = i + 1
  }
  let cases = run Json.parse(Source.read("cases.json"))
  let mut rows = List<Value>.make()
  if let Value.Array { values } = &cases {
    i = 0
    while i < values.length() {
      let row = &values.asSlice()[i]
      let fixture = word(row,"fixture")
      let sheet: usize = if fixture == "plain" { 0 } else if fixture == "tailwind-small" { 1 } else { 2 }
      run rows.append(run measure(row,sheets.asSlice()[sheet].asSlice(),baselineBytes.asSlice()))
      i = i + 1
    }
  }
  let mut out = object()
  run put(&mut out,"cases",Value.Array { values: move rows })
  run put(&mut out,"diagnostics",Value.Array { values: move diagnostics })
  return move out
}

effect fn workingDirectory() -> Bytes ! HostInputError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut inputs = run WindowsHostInput.capture()
    return run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
  } else {
    return run NativeHostInput.workingDirectory()
  }
}

effect fn application() -> i32 ! TreeError | CompileError | CssError | JsonError | FileError | HostInputError | OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut stdout = StdoutWriter.make()
  let cwd = run workingDirectory() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut files = run OsFileSystem.makeBytes(cwd.asSlice()) |> Effect.provideMut<Allocator>(&mut allocator)
  let result = run report() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
  run Json.write(&result) |> Effect.provideMut<Writer>(&mut stdout)
  run Writer.writeString("\n") |> Effect.provideMut<Writer>(&mut stdout)
  return 0
}
effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("stylesheet parity failed to run\n",&.())
  return 1
}
pub fn main() -> i32 { return run Effect.catchAll(application(),failed) }
