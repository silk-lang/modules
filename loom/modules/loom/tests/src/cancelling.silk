//! Commands a host runs apart from the update: tickets, owners, slots and cancelling.
import loom.app { App, Context, Perform }
import loom.runtime { Runtime, settle }
import loom.ui { Ui }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }

struct Screens {
  loaded: List<u64>,
}

union Message {
  Open { screen: u64 },
  Search { screen: u64, query: u64 },
  Close { screen: u64 },
  Paste,
  Loaded { value: u64 },
}

union Work {
  Load { screen: u64 },
  Find { screen: u64, query: u64 },
  Clipboard,
}

impl Perform<Message, never ? never> for Work {
  effect fn perform(self: Self) -> Message {
    match move self {
      Work.Load { screen } => { return Message.Loaded { value: screen } }
      Work.Find { screen, query } => { return Message.Loaded { value: screen * 100 + query } }
      Work.Clipboard => { return Message.Loaded { value: 7 } }
    }
  }

  fn owner(self: &Self) -> u64 {
    match &self.* {
      Work.Load { screen } => { return screen }
      Work.Find { screen, query: _ } => { return screen }
      Work.Clipboard => { return 0 }
    }
  }

  fn slot(self: &Self) -> u64 {
    match &self.* {
      Work.Find { screen: _, query: _ } => { return 1 }
      _ => { return 0 }
    }
  }

  fn onUiThread(self: &Self) -> bool {
    match &self.* {
      Work.Clipboard => { return true }
      _ => { return false }
    }
  }
}

impl App<Message, Work> for Screens {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    return ()
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<Work>) -> () {
    match move message {
      Message.Open { screen } => { cx.command(Work.Load { screen: screen }) }
      Message.Search { screen, query } => { cx.command(Work.Find { screen: screen, query: query }) }
      Message.Close { screen } => { cx.cancel(screen) }
      Message.Paste => { cx.command(Work.Clipboard) }
      Message.Loaded { value } => { cx.alloc(self.loaded.append(value)) }
    }
  }
}

effect fn body() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut app = Runtime<Screens, Message, Work>.make(Screens { loaded: List<u64>.make() })
  app.deferCommands()
  run app.record()

  // A command that ends after its owner was cancelled says nothing.
  app.send(Message.Open { screen: 1 })
  app.send(Message.Open { screen: 2 })
  drop run settle(&mut app)
  run Testing.expect(app.deferred() == 2, "both loads wait")
  let first = run app.takeWork()
  run Testing.expect(first.owner == 1 && !first.ui, "the oldest first, with its owner")
  let lines = run app.workLines()
  run Testing.expect(
    lines.length() == 2 && String.startsWith(String.view(&lines.asSlice()[0]), "running ")
      && String.endsWith(String.view(&lines.asSlice()[0]), " for 1")
      && String.startsWith(String.view(&lines.asSlice()[1]), "waiting ")
      && String.endsWith(String.view(&lines.asSlice()[1]), " for 2"),
    "a host can list what runs and what waits, with the owners",
  )
  app.send(Message.Close { screen: 1 })
  app.send(Message.Close { screen: 2 })
  drop run settle(&mut app)
  run Testing.expect(app.deferred() == 0, "a waiting command of a cancelled owner is dropped")
  run Testing.expect(app.cancelled(first.ticket), "a running one is told")
  let message = run Perform<Message, never, never>.perform(move first.command)
  run Testing.expect(!app.finish(first.ticket, move message), "and its message is dropped")
  drop run settle(&mut app)
  run Testing.expect(app.model.loaded.length() == 0 && app.inFlight() == 0, "nothing arrived")
  run Testing.expect((run app.workLines()).length() == 0, "and nothing is listed any more")

  // A newer command in a slot replaces the older one, waiting or running.
  app.send(Message.Search { screen: 3, query: 1 })
  drop run settle(&mut app)
  let stale = run app.takeWork()
  app.send(Message.Search { screen: 3, query: 2 })
  app.send(Message.Search { screen: 3, query: 3 })
  app.send(Message.Search { screen: 4, query: 9 })
  drop run settle(&mut app)
  run Testing.expect(app.deferred() == 2, "one search waits per owner")
  run Testing.expect(app.cancelled(stale.ticket), "the running search was replaced")
  let late = run Perform<Message, never, never>.perform(move stale.command)
  drop app.finish(stale.ticket, move late)
  while app.deferred() != 0 {
    let work = run app.takeWork()
    let ticket = work.ticket
    let result = run Perform<Message, never, never>.perform(move work.command)
    run Testing.expect(app.finish(ticket, move result), "a wanted command's message is queued")
  }
  drop run settle(&mut app)
  run Testing.expect(app.model.loaded.length() == 2, "the newest search of each owner arrived")
  run Testing.expect(
    app.model.loaded.get(0) == 303 && app.model.loaded.get(1) == 409,
    "and no older one",
  )

  // What must stay on the UI thread is told apart.
  app.send(Message.Paste)
  app.send(Message.Open { screen: 5 })
  drop run settle(&mut app)
  run Testing.expect(app.deferredOn(true) == 1 && app.deferredOn(false) == 1, "one of each")
  let ui = run app.takeWorkOn(true)
  run Testing.expect(ui.ui && ui.owner == 0, "the paste is the UI thread's")
  let off = run app.takeWorkOn(false)
  run Testing.expect(!off.ui && off.owner == 5, "the load may leave it")
}

test effect fn cancelledCommandsSayNothing() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}
