/// An open root other than the current one: its share of the tree's state, kept while the
/// current root is laid out, painted and given input. [`UiTree.useRoot`] swaps it in. The
/// fields mean what the `UiTree` fields of the same names mean for the current root.
pub struct RootState {
  pub id: u32,
  pub options: RootOptions,
  /// The slot of the root node, or NONE.
  pub root: u32,
  /// The focused slot, or NONE.
  pub focused: u32,
  pub focusVisible: bool,
  /// The root's text selection.
  textSelection: TextSelection,
  /// The input of the root's last frame: its viewport.
  pub input: FrameInput,
  /// What the root's last frame did.
  pub stats: FrameStats,
  /// Changes to the root's published semantics or geometry (see `UiTree.revisionOf`).
  pub revision: u64,
  /// What the root's last layout and paint left behind, and what changed since, so a root
  /// nothing reached while it waited is neither laid out nor painted again when it is current.
  laidOut: FrameInput,
  laidOutRevision: usize,
  laidOutScrolls: usize,
  replayable: bool,
  stylesDirty: bool,
  applied: bool,
  paintDirty: bool,
  paintCachesStale: bool,
  layoutObserversDirty: bool,
  facesDirty: bool,
  paintedAt: u64,
  /// Whether a change reached the root's nodes while it waited without making it current (a
  /// node moved out of it, a resource or font family they use was defined again): its next
  /// frame styles, lays out and hashes again.
  pub touched: bool,
  output: LayoutTree,
  containerWatches: List<Watch>,
  sceneA: Scene,
  sceneB: Scene,
  flipped: bool,
  paintOrder: List<u32>,
  fragmentHashes: List<u64>,
  fragmentInk: List<Rect<f32>>,
  fragmentScrollers: List<bool>,
  fragmentStacking: Stacking,
  fragmentOf: List<usize>,
  nextSourceFragment: List<usize>,
  paintIndexOf: List<u32>,
  scrolled: bool,
  hoverChain: List<u64>,
  pressChain: List<u64>,
  capture: u32,
  captureId: u32,
  captureMode: u32,
  captureTo: u32,
  captureToId: u32,
  suppressText: bool,
  pendingTarget: u32,
  pendingTargetId: u32,
  pressed: u32,
  pressedId: u32,
  pressCount: u32,
  thumbSlot: u32,
  thumbVertical: bool,
  thumbStart: f32,
  thumbOffset: f32,
  pointerX: f32,
  pointerY: f32,
  pointerInside: bool,
  reveal: List<u64>,
}

impl RootState {
  /// A root that was never framed, with root node `slot`.
  fn fresh(id: u32, options: RootOptions, slot: u32) -> RootState {
    return RootState {
      id: id,
      options: move options,
      root: slot,
      focused: NONE,
      focusVisible: false,
      textSelection: TextSelection.make(),
      input: FrameInput { width: 0.0, height: 0.0, scale: 1.0, time: 0.0 },
      stats: FrameStats.zero(),
      revision: 0,
      laidOut: FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 },
      laidOutRevision: usize.MAX,
      laidOutScrolls: usize.MAX,
      replayable: false,
      stylesDirty: true,
      applied: true,
      paintDirty: false,
      paintCachesStale: true,
      layoutObserversDirty: true,
      facesDirty: true,
      paintedAt: 0,
      touched: false,
      output: LayoutTree.make(),
      containerWatches: List<Watch>.make(),
      sceneA: Scene.make(),
      sceneB: Scene.make(),
      flipped: false,
      paintOrder: List<u32>.make(),
      fragmentHashes: List<u64>.make(),
      fragmentInk: List<Rect<f32>>.make(),
      fragmentScrollers: List<bool>.make(),
      fragmentStacking: Stacking.make(),
      fragmentOf: List<usize>.make(),
      nextSourceFragment: List<usize>.make(),
      paintIndexOf: List<u32>.make(),
      scrolled: false,
      hoverChain: List<u64>.make(),
      pressChain: List<u64>.make(),
      capture: NONE,
      captureId: NONE,
      captureMode: 0,
      captureTo: NONE,
      captureToId: NONE,
      suppressText: false,
      pendingTarget: NONE,
      pendingTargetId: NONE,
      pressed: NONE,
      pressedId: NONE,
      pressCount: 0,
      thumbSlot: NONE,
      thumbVertical: true,
      thumbStart: 0.0,
      thumbOffset: 0.0,
      pointerX: 0.0,
      pointerY: 0.0,
      pointerInside: false,
      reveal: List<u64>.make(),
    }
  }
}

/// Whether `input` goes to the root that has the keyboard rather than the one under the
/// pointer.
fn keyboardInput(input: &Input) -> bool {
  return match &input.* {
    Input.KeyDown { .. } => true
    Input.KeyUp { .. } => true
    Input.TextInput { .. } => true
    Input.ImePreedit { .. } => true
    Input.Paste { .. } => true
    Input.Command { .. } => true
    Input.Edit { .. } => true
    Input.Request { target, .. } => target == REQUEST_ANYWHERE
    _ => false
  }
}

/// The node a mutation is about, in whose root it applies, or NONE: a new node, a resource,
/// a root, or the root that has the keyboard or the press.
fn nodeOf(mutation: &Mutation) -> u32 {
  return match &mutation.* {
    Mutation.SetAnchor { id, .. } => id
    Mutation.ClearAnchor { id } => id
    Mutation.SetVirtualList { id, .. } => id
    Mutation.SetVirtualItems { id, .. } => id
    Mutation.ClearVirtualList { id } => id
    Mutation.InsertBefore { parent, .. } => parent
    Mutation.Remove { id } => id
    Mutation.Destroy { id } => id
    Mutation.SetStyle { id, .. } => id
    Mutation.SetCustomProperty { id, .. } => id
    Mutation.ClearStyle { id, .. } => id
    Mutation.SetText { id, .. } => id
    Mutation.SetSelection { id, .. } => id
    Mutation.SetAttribute { id, .. } => id
    Mutation.SetListeners { id, .. } => id
    Mutation.Focus { id } => id
    Mutation.SetPointerCapture { id } => id
    Mutation.ScrollTo { id, .. } => id
    Mutation.ScrollIntoView { id } => id
    Mutation.SetGrid { id, .. } => id
    Mutation.SetSource { id, .. } => id
    Mutation.SetCanvas { id, .. } => id
    Mutation.SetCanvasSurface { id, .. } => id
    Mutation.SetCanvasPixels { id, .. } => id
    Mutation.SvgInsert { id, .. } => id
    Mutation.SvgRemove { id, .. } => id
    Mutation.SvgAttribute { id, .. } => id
    Mutation.SetRichText { id, .. } => id
    Mutation.DefineMark { id, .. } => id
    Mutation.DefineAtom { id, .. } => id
    Mutation.Format { id, .. } => id
    Mutation.InsertAtom { id, .. } => id
    _ => NONE
  }
}

/// Whether a mutation that names no node changes every root: a resource, a font family. A new
/// node is nobody's yet, and a root mutation changes its own root.
/// Whether `mutation` only moves a scroll container's content.
/// Whether all a mutation changes of what is painted is its node's own paint inputs, styles
/// and layout (see `UiTree.repair`).
fn repaintsNode(mutation: &Mutation) -> bool {
  return match &mutation.* {
    Mutation.Create { .. } => true
    Mutation.InsertBefore { .. } => true
    Mutation.Remove { .. } => true
    Mutation.Destroy { .. } => true
    Mutation.SetStyle { .. } => true
    Mutation.SetCustomProperty { .. } => true
    Mutation.ClearStyle { .. } => true
    Mutation.SetText { .. } => true
    Mutation.SetAttribute { .. } => true
    Mutation.SetListeners { .. } => true
    Mutation.SetCanvas { .. } => true
    Mutation.SetCanvasSurface { .. } => true
    Mutation.SetCanvasPixels { .. } => true
    Mutation.SvgInsert { .. } => true
    Mutation.SvgRemove { .. } => true
    Mutation.SvgAttribute { .. } => true
    _ => false
  }
}

fn scrollsOnly(mutation: &Mutation) -> bool {
  return match &mutation.* {
    Mutation.ScrollTo { .. } => true
    _ => false
  }
}

fn virtualOnly(mutation: &Mutation) -> bool {
  return match &mutation.* {
    Mutation.SetVirtualList { .. } => true
    Mutation.SetVirtualItems { .. } => true
    _ => false
  }
}

fn reachesEveryRoot(mutation: &Mutation) -> bool {
  return match &mutation.* {
    Mutation.Create { .. } => false
    Mutation.OpenRoot { .. } => false
    Mutation.UpdateRoot { .. } => false
    Mutation.CloseRoot { .. } => false
    Mutation.LoadStyleSheet { .. } => false
    Mutation.AdoptStyleSheet { .. } => false
    Mutation.ReplaceStyleSheet { .. } => false
    Mutation.RemoveStyleSheet { .. } => false
    Mutation.SetStyleSheetOrder { .. } => false
    _ => true
  }
}

/// Where the file of a face declared with a URL is, and whether the host was asked for it.
struct FaceSource {
  id: u32,
  url: String,
  asked: bool,
}

/// The first id of the faces a host declares (`declareHostFontFace`), above the ids clients
/// choose.
const FIRST_HOST_FACE: u32 = 0x80000000

/// A font face a client declared, by the client's id.
struct FontFaceEntry {
  id: u32,
  /// Its index in the text system's font set.
  declared: usize,
}

impl Copy for FontFaceEntry {}

struct FontKeyEntry {
  root: u32,
  family: u32,
  size: f32,
  weight: f32,
  italic: bool,
  width: f32,
  treatment: Treatment,
  key: usize,
}

impl Copy for FontKeyEntry {}

fn sameTreatment(a: Treatment, b: Treatment) -> bool {
  return a.letterSpacing == b.letterSpacing && a.wordSpacing == b.wordSpacing && a.transform == b.transform
    && a.wordBreak == b.wordBreak && a.overflowWrap == b.overflowWrap && a.lineBreak == b.lineBreak
    && a.hyphens == b.hyphens && a.features.same(&b.features)
}

effect fn layoutFailed<E>(error: E) -> never
  ! TreeError {
  drop error
  fail TreeError.Layout
}

effect fn noShape(error: TreeError) -> () {
  drop error
}

effect fn viewFailed(error: CssomError) -> never
  ! TreeError {
  fail TreeError.View { error: error }
}

effect fn generatedFailed(error: CssError | OutOfMemoryError) -> Option<String>
  ! OutOfMemoryError {
  match move error {
    OutOfMemoryError allocation => { fail move allocation }
    CssError invalid => { drop invalid return Option<String>.None }
  }
}

effect fn appendGrid(target: &mut List<Declaration>, declarations: &[Declaration]) ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < declarations.length {
    if grid_css.isGridProperty(declarations[i].property) { run target.append(run values.cloneDeclaration(&declarations[i])) }
    i = i + 1
  }
}

fn defaultDisplay(kind: NodeKind) -> CssDisplay {
  return match kind {
    NodeKind.Box => CssDisplay.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
    NodeKind.Text => CssDisplay.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
    NodeKind.Image => CssDisplay.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
    NodeKind.Icon => CssDisplay.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
    NodeKind.Input => CssDisplay.Box {
      outside: DisplayOutside.Inline,
      inside: DisplayInside.FlowRoot,
    }
    NodeKind.Canvas => CssDisplay.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
  }
}

/// Form controls lay out their contents as a browser's do, whatever display or align-content
/// the app gives them. An input's text flows in one block (the inner editor); a one-line
/// input centers it in the block axis even when it overflows, as Chromium does. A button,
/// a select and a button-typed input center their contents unless they overflow (the HTML
/// rendering's anonymous button content box), except as flex or grid containers.
fn controlLayout(node: &Node, style: CssStyle) -> CssStyle {
  let mut used = style
  match style.display {
    CssDisplay.Box { outside, inside } => {
      if node.kind == NodeKind.Input {
        used.display = CssDisplay.Box { outside: outside, inside: DisplayInside.FlowRoot }
        if !node.edit().multiline {
          used.alignContent = Align.Center
          used.alignContentSafety = OverflowAlignment.Unsafe
        }
      } else if node.kind == NodeKind.Box && (inside == DisplayInside.Flow || inside == DisplayInside.FlowRoot) && buttonLike(node) {
        used.display = CssDisplay.Box { outside: outside, inside: DisplayInside.FlowRoot }
        used.alignContent = Align.Center
        used.alignContentSafety = OverflowAlignment.Safe
      }
    }
    _ => {}
  }
  return used
}

fn buttonLike(node: &Node) -> bool {
  let identity = match node.identity() {
    Option.Some { value } => value
    Option.None => { return false }
  }
  let tag = identity.tag()
  if tag == "button" || tag == "select" { return true }
  if tag != "input" { return false }
  let attributes = identity.attributes()
  let mut i: usize = 0
  while i < attributes.length {
    if String.view(&attributes[i].name) == "type" {
      let kind = String.view(&attributes[i].value)
      return kind == "button" || kind == "submit" || kind == "reset"
    }
    i = i + 1
  }
  return false
}

effect fn invalidInitial(error: CssError) -> Value {
  drop error
  return values.keyword(Keyword.Initial)
}

pub effect fn applyInitial(computed: &mut Computed, property: CssProperty) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let mut initial = Computed.inViewport(TextStyle.initial(), computed.viewportWidth, computed.viewportHeight)
  // Start with native initial representations for values such as font-size:
  // medium, then let the catalog override native user-agent defaults.
  let value = run Effect.catch<CssError>(css_written.value(catalog.initial(property)), invalidInitial)
  let mut declaration = Declaration { property: property, important: false, value: move value }
  if properties_convert.isKeyword(&declaration.value, Keyword.Currentcolor) && property != CssProperty.WebkitTextFillColor { declaration.value = values.color(computed.text.color) }
  if !run applyWritten(&mut initial, &declaration) { initial.apply(&declaration) }
  drop style_inherit.apply(&mut computed.*, &initial, property)
}

/// Sheet winners have already been selected per longhand. Copy explicit inheritance from computed
/// parent values, and establish writing mode/direction/font size before dependents.
pub effect fn applyResolved(computed: &mut Computed, list: &List<Declaration>, parent: &Computed, stops: &mut EasingStops) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let items = list.asSlice()
  let dependencies = [CssProperty.WritingMode, CssProperty.Direction, CssProperty.FontSize, CssProperty.Color]
  let mut dependency: usize = 0
  while dependency < dependencies.length {
    let mut i: usize = 0
    while i < items.length {
      if items[i].property == dependencies[dependency] {
        if properties_convert.isKeyword(&items[i].value, Keyword.Initial) {
          run applyInitial(&mut computed.*, items[i].property)
        } else if properties_convert.isKeyword(&items[i].value, Keyword.Inherit) {
          drop style_inherit.apply(&mut computed.*, parent, items[i].property)
        } else { computed.apply(&items[i]) }
      }
      i = i + 1
    }
    dependency = dependency + 1
  }
  let mut i: usize = 0
  while i < items.length {
    let property = items[i].property
    if property != CssProperty.FontSize && property != CssProperty.WritingMode && property != CssProperty.Direction && property != CssProperty.Color {
      if properties_convert.isKeyword(&items[i].value, Keyword.Initial) {
        run applyInitial(&mut computed.*, property)
      } else if properties_convert.isKeyword(&items[i].value, Keyword.Inherit) {
        if paint_css.handles(property) { computed.effects.declared = true }
        drop style_inherit.apply(&mut computed.*, parent, property)
      } else {
        let which = transitionList(property)
        if which != NONE {
          let text = run values.cssText(&items[i].value)
          run stops.read(text.asSlice())
          run motion.declare(&mut computed.transition, which, text.asSlice(), &mut stops)
        } else if animationList(property) != NONE {
          let text = run values.cssText(&items[i].value)
          run stops.read(text.asSlice())
          run timing.declareAnimation(&mut computed.animation, animationList(property), text.asSlice(), &mut stops)
        } else if !run applyWritten(&mut computed.*, &items[i]) {
          computed.apply(&items[i])
        }
      }
    }
    i = i + 1
  }
}

/// Applies non-font declarations after the node's font dependencies have resolved.
pub effect fn applyUsing(computed: &mut Computed, items: &[Declaration], parent: &Computed,
  stops: &mut EasingStops, units: &Context) ! OutOfMemoryError ? &mut Allocator {
  let mut pass: u32 = 0
  while pass < 2 {
    let mut i: usize = 0
    while i < items.length {
      let declaration = &items[i]
      let property = declaration.property
      if font_units.phase(property) == 0 && (property == CssProperty.Color) == (pass == 0) {
        if properties_convert.isKeyword(&declaration.value, Keyword.Initial) {
          run applyInitial(&mut computed.*, property)
        } else if properties_convert.isKeyword(&declaration.value, Keyword.Inherit) {
          if paint_css.handles(property) { computed.effects.declared = true }
          drop style_inherit.apply(&mut computed.*, parent, property)
        } else {
          let which = transitionList(property)
          if which != NONE {
            let text = run values.cssText(&declaration.value)
            run stops.read(text.asSlice())
            run motion.declare(&mut computed.transition, which, text.asSlice(), &mut stops)
          } else if animationList(property) != NONE {
            let text = run values.cssText(&declaration.value)
            run stops.read(text.asSlice())
            run timing.declareAnimation(&mut computed.animation, animationList(property), text.asSlice(), &mut stops)
          } else if property == CssProperty.Container {
            if let Option.Some { value } = move run containers.typeOf(declaration) {
              computed.applyIn(&Declaration { property: CssProperty.ContainerType, important: declaration.important, value: move value }, units)
            }
          } else if !run applyTransformIn(&mut computed.*, declaration, units) {
            computed.applyIn(declaration, units)
          }
        }
      }
      i = i + 1
    }
    pass = pass + 1
  }
}

pub effect fn applyAll(computed: &mut Computed, list: &List<Declaration>, stops: &mut EasingStops) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let items = list.asSlice()

  let dependencies = [CssProperty.WritingMode, CssProperty.Direction, CssProperty.FontSize]
  let mut dependency: usize = 0
  let mut i: usize = 0
  while dependency < dependencies.length {
    i = 0
    while i < items.length {
      if items[i].property == dependencies[dependency] { computed.apply(&items[i]) }
      i = i + 1
    }
    dependency = dependency + 1
  }
  i = 0
  while i < items.length {
    let property = items[i].property
    let which = transitionList(property)
    if which != NONE {
      let text = run values.cssText(&items[i].value)
      run stops.read(text.asSlice())
      run motion.declare(&mut computed.transition, which, text.asSlice(), &mut stops)
    } else if animationList(property) != NONE {
      let text = run values.cssText(&items[i].value)
      run stops.read(text.asSlice())
      run timing.declareAnimation(&mut computed.animation, animationList(property), text.asSlice(), &mut stops)
    } else if run applyWritten(&mut computed, &items[i]) {
    } else if property != CssProperty.FontSize && property != CssProperty.WritingMode && property != CssProperty.Direction {
      computed.apply(&items[i])
    }
    i = i + 1
  }
}

fn applyPixelList(computed: &mut Computed, items: &[Declaration]) {
  let units = computed.unitContext()
  let mut i: usize = 0
  while i < items.length {
    computed.applyFixed(&items[i], &units)
    i = i + 1
  }
}

/// Applies `declaration` when it sets a property read from its CSS text (a transform or a font
/// feature); false when it does not.
pub effect fn applyWritten(computed: &mut Computed, declaration: &Declaration) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if declaration.property == CssProperty.Container {
    if let Option<Value>.Some { value } = move run containers.typeOf(declaration) {
      computed.apply(&Declaration { property: CssProperty.ContainerType, important: declaration.important, value: move value })
    }
    return true
  }
  if run font_features.apply(&mut computed.text, declaration) {
    return true
  }
  return run applyTransform(&mut computed, declaration)
}

/// Applies `declaration` when it sets a transform property; false when it does not.
pub effect fn applyTransform(computed: &mut Computed, declaration: &Declaration) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if transformProperty(declaration.property) == NONE { return false }
  let units = computed.unitContext()
  return run applyTransformIn(&mut computed.*, declaration, &units)
}

pub effect fn applyTransformIn(computed: &mut Computed, declaration: &Declaration, context: &Context) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  let which = transformProperty(declaration.property)
  if which == NONE {
    return false
  }
  let text = run values.cssText(&declaration.value)
  let units = transform.Units { context: context.* }
  transform.declare(&mut computed.transform, which, text.asSlice(), &units)
  if which == transform.OFFSET_PATH_PROPERTY && computed.transform.offset.path == transform.PATH_SHAPE {
    computed.effects.declared = true
  }
  if !computed.usesViewport && style.viewportDependent(declaration) {
    computed.usesViewport = true
  }
  if style.containerDependent(declaration) {
    computed.usesContainer = true
    computed.usesViewport = true
  }
  return true
}

/// Which transform property `property` is (see `transform.declare`), or NONE.
fn transformProperty(property: CssProperty) -> u32 {
  return match property {
    CssProperty.Transform => transform.TRANSFORM_LIST
    CssProperty.Translate => transform.TRANSLATE_PROPERTY
    CssProperty.Rotate => transform.ROTATE_PROPERTY
    CssProperty.Scale => transform.SCALE_PROPERTY
    CssProperty.TransformOrigin => transform.ORIGIN_PROPERTY
    CssProperty.Perspective => transform.PERSPECTIVE_PROPERTY
    CssProperty.PerspectiveOrigin => transform.PERSPECTIVE_ORIGIN_PROPERTY
    CssProperty.BackfaceVisibility => transform.BACKFACE_PROPERTY
    CssProperty.OffsetPath => transform.OFFSET_PATH_PROPERTY
    CssProperty.OffsetDistance => transform.OFFSET_DISTANCE_PROPERTY
    CssProperty.OffsetRotate => transform.OFFSET_ROTATE_PROPERTY
    CssProperty.OffsetAnchor => transform.OFFSET_ANCHOR_PROPERTY
    CssProperty.OffsetPosition => transform.OFFSET_POSITION_PROPERTY
    CssProperty.TransformStyle => transform.TRANSFORM_STYLE_PROPERTY
    _ => NONE
  }
}

/// Which `animation-*` list `property` sets (see `timing.declareAnimation`), or NONE.
fn animationList(property: CssProperty) -> u32 {
  return match property {
    CssProperty.Animation => timing.ANIMATION
    CssProperty.AnimationName => timing.ANIMATION_NAME
    CssProperty.AnimationDuration => timing.ANIMATION_DURATION
    CssProperty.AnimationTimingFunction => timing.ANIMATION_TIMING
    CssProperty.AnimationDelay => timing.ANIMATION_DELAY
    CssProperty.AnimationIterationCount => timing.ANIMATION_ITERATIONS
    CssProperty.AnimationDirection => timing.ANIMATION_DIRECTION
    CssProperty.AnimationFillMode => timing.ANIMATION_FILL
    CssProperty.AnimationPlayState => timing.ANIMATION_PLAY_STATE
    _ => NONE
  }
}

/// Which `transition-*` list `property` sets (see `motion.declare`), or NONE.
fn transitionList(property: CssProperty) -> u32 {
  return match property {
    CssProperty.Transition => motion.SHORTHAND
    CssProperty.TransitionProperty => motion.PROPERTY
    CssProperty.TransitionDuration => motion.DURATION
    CssProperty.TransitionTimingFunction => motion.TIMING
    CssProperty.TransitionDelay => motion.DELAY
    CssProperty.TransitionBehavior => motion.BEHAVIOR
    _ => NONE
  }
}

/// Declarations a second party that shares the tree lays over what its client set for one
/// node in one state: the inspector's style edits. The tree applies them when it resolves the
/// node's style, over the client's declarations as `css.set` would (or instead of them, with
/// `replace`), so a client that restyles the node changes only what lies underneath: its own
/// declarations stay as it set them, the client is never told of the override, and taking the
/// override away shows exactly what the client last set. See [`UiTree.setOverride`].
pub struct StyleOverride {
  pub id: u32,
  pub state: StyleState,
  pub declarations: List<Declaration>,
  /// The client's declarations in this state are left out.
  pub replace: bool,
}

const SOURCE_PENDING: u8 = 0
const SOURCE_LOADED: u8 = 1
const SOURCE_FAILED: u8 = 2

/// How long content must stay still after a scroll before hover follows the pointer again.
pub const HOVER_SETTLE_SECONDS: f64 = 0.1

/// The retained tree.
///
/// It borrows the fonts it draws with. Each frame: [`UiTree.apply`] the client's batches, call
/// [`UiTree.frame`], hand [`UiTree.scene`] and [`UiTree.uploads`] to a renderer, and drain
/// [`UiTree.takeEvents`].
///
/// It holds several roots (`Mutation.OpenRoot`), each laid out in its own viewport, in one id
/// space and with one glyph atlas. One root at a time is current: `frame`, `scene`, hit testing,
/// the geometry queries and pointer input are about it, and the per-root fields below (`root`,
/// `focused`, `input`, `stats`, `revision`, `output`, the scenes, hover, press and capture) are
/// its state. The other open roots wait in `parked`. [`UiTree.useRoot`] and
/// [`UiTree.frameRoot`] change the current root; key and text input go to `keyRoot`. A root
/// keeps what its last layout and paint left with its state, so changing roots costs no layout
/// or paint of its own: a root is laid out and painted again only for what changed in it.
/// `apply` leaves the current root as it was.
///
/// A root can be set aside for a second client that shares the tree, such as devtools running
/// in the app's process (`setAside`): its records and root events wait for that client.
struct EndedFilter {
  slot: u32,
  id: u32,
  filters: FilterList,
}

impl Copy for EndedFilter {}

pub struct UiTree<'a> {
  /// Tree-owned virtualization controllers. Use mutations and `virtualRange` to access them.
  pub virtualLists: List<VirtualList>,
  /// Client node under the host-reported accessibility browse cursor, independent of focus.
  pub browseCursor: u32,
  /// Retained popup placement relationships. Configure them through SetAnchor.
  pub anchors: List<Anchored>,
  /// The tree css-layout lays out (see `layout_table`).
  pub layout: LayoutTable,
  pub output: LayoutTree,
  pub containerWatches: List<Watch>,
  pub styleChanges: List<Change>,
  pub changingStyles: bool,
  pub provider: Provider<'a>,
  pub nodes: List<Node>,
  /// The tags and class attributes elements share (see `NodeIdentity.key`).
  pub selectorKeys: SelectorKeys,
  /// The nodes' paint caches (see `Node.paintCache`).
  pub paintCaches: PaintCaches,
  pub styleAtoms: Atoms,
  /// During a style pass: the names the ancestors of the node being styled hold, those
  /// ancestors from the root down, and whether the two are kept (see `prepareFilter`).
  pub ancestorFilter: AncestorFilter,
  pub filterPath: List<u32>,
  pub filterOn: bool,
  /// During a style pass: 1-based element index among siblings (by slot), total element
  /// children (by parent slot), and the pass stamp for each parent whose children were counted.
  pub siblingIndex: List<u32>,
  pub siblingCount: List<u32>,
  pub siblingStamp: List<u32>,
  pub siblingPass: u32,
  pub siblingOn: bool,
  pub styleSheets: List<RootSheets>,
  pendingFirstRootSheets: List<Bytes>,
  styleLoads: List<StyleRequest>,
  styleGeneration: u64,
  pub svgStyleRevision: u64,
  pub svgStylesPending: bool,
  nextStyleId: u32,
  hostStylePreferences: Option<Preferences>,
  free: List<u32>,
  ids: HashMap<Word, u32>,
  /// The slot of each css-layout node, or NONE.
  pub slotOfCss: List<u32>,
  /// The root slot, or NONE.
  pub root: u32,
  /// The focused slot, or NONE.
  pub focused: u32,
  /// The current root's text selection (see `text_selection`).
  pub textSelection: TextSelection,
  /// Where focus goes back to when it leaves a focus trap's subtree by removal: by trap id,
  /// the id of the node focused before focus went into the trap, as a modal `<dialog>` does.
  returns: List<FocusReturn>,
  /// How many nodes are inert, so input skips looking for inert ancestors when none are.
  pub inerts: u32,
  families: Families,
  variations: VariationTable,
  pub resources: Resources<'a>,
  /// `LoadImage`, `LoadIcon`, `LoadFontFace` and `LoadFontStylesheet` mutations waiting for
  /// the host's loaders (`takeLoads`). The tree does no I/O: a host reads, fetches or looks up
  /// the URL, then defines the resource or gives the face its file.
  pub loads: List<Mutation>,
  /// What became of each loaded resource, by id: `SOURCE_*`.
  sourceStates: List<u8>,
  /// Nodes that were given a source that already settled, told after the batch.
  sourceTells: List<u32>,
  fontKeys: List<FontKeyEntry>,
  fontFaces: List<FontFaceEntry>,
  pub sheetFaces: SheetFaces,
  /// `@font-palette-values` and `@font-feature-values` rules, and font property handles.
  pub fontRules: FontRules,
  /// When the next `font-display` block or swap period ends, or negative.
  fontBlockEnd: f64,
  /// The files of faces declared with a URL (`Mutation.DeclareFontFace`).
  faceSources: List<FaceSource>,
  nextHostFace: u32,
  pub faces: List<FaceSlot<'a>>,
  /// The bitmaps of the canvas nodes JavaScript draws with Canvas 2D.
  pub canvas2d: Canvas2d<'a>,
  /// The bitmaps of large canvases' commands (see `canvas_raster`).
  pub canvasRasters: CanvasRasters,
  pub atlas: Atlas,
  pub glyphs: GlyphCache,
  pub paths: PathCache,
  pub sceneA: Scene,
  pub sceneB: Scene,
  /// Whether `sceneB` holds the current frame.
  pub flipped: bool,
  /// Whether the previous scene can be replayed from (false after a resize of the atlas
  /// or before the first frame).
  pub replayable: bool,
  pub seed: HashSeed,
  pub stylesDirty: bool,
  /// Some nodes have `styleDirty`: the next resolve visits only their subtrees' paths.
  pub stylesPending: bool,
  /// Some node is a list item or changes counters, or generated content names one: each
  /// style pass that touches lists/counters or tree structure ends with `lists.update`.
  pub listsUsed: bool,
  listsDirty: bool,
  listsStructure: usize,
  /// Some node has had a `::first-letter` box: edits under one may move its letter.
  pub letterUsed: bool,
  /// Blocks whose `::first-letter` the style pass syncs once their subtrees are styled: the
  /// letter's text is found by its descendants' computed floats and displays.
  letterPending: List<u32>,
  /// Blocks with a `::first-line` style, and the first line box of each from the last layout.
  pub lineOrigins: List<u32>,
  pub firstLines: List<first_letter.FirstLine>,
  /// Whether any node is a scroll snap container (see `scroll_snap`).
  pub snapUsed: bool,
  /// A style used anchor positioning (`anchor-name` or an anchored box).
  pub cssAnchorUsed: bool,
  /// A style used `offset-path` (see `offset_path.settle`).
  pub offsetUsed: bool,
  /// Whether some style ever set `transform-style: preserve-3d`: until then paint and hit
  /// testing skip the 3D rendering context checks.
  pub preserveUsed: bool,
  pub cssPlacements: List<css_anchor.Placement>,
  /// User scrolls of snap containers that snap once they stop.
  pub snapWaits: List<SnapWait>,
  /// Scroll containers away from their block start and their anchors (see `scroll_anchor`).
  pub scrollAnchors: List<ScrollAnchor>,
  /// The last `Node.styleClass` handed out.
  pub styleClasses: u32,
  /// The nodes that matched selectors themselves in this pass, by `style_share.modelKey`.
  pub styleModels: HashMap<u64, u32>,
  /// The class nodes take in this pass when they keep their style under a changed variable
  /// scope, by the class they held and their parent's new one: nodes that shared a class and
  /// moved under parents of one class share one again (`UiTree.moveScope`).
  pub movedClasses: HashMap<u64, u32>,
  /// The computed styles the nodes hold, each once.
  pub stylePool: StylePool,
  /// The style a text node takes under a parent, by the parent's stamp (see `TextInherit`).
  pub textInherits: List<TextInherit>,
  /// The style a new node of each kind starts with (see `freshStyle`).
  freshStyles: List<FreshStyle>,
  /// The last `Node.computedStamp` handed out.
  pub computedStamps: u32,
  pub frameNumber: u64,
  /// Changes to published semantics or allocated geometry.
  pub semanticRevision: u64,
  /// The changes of `semanticRevision` that reached the current root (see `revisionOf`).
  pub revision: u64,
  pub input: FrameInput,
  laidOut: FrameInput,
  laidOutRevision: usize,
  laidOutScrolls: usize,
  /// The viewport size css-layout's root has: the last root laid out sets it.
  styledViewport: FrameInput,
  /// The viewport the styles' viewport units last resolved against.
  unitsWidth: f32,
  unitsHeight: f32,
  /// The page zoom: the root's effective zoom before its own `zoom`. Media queries and viewport
  /// units see the viewport divided by it, so a zoomed page reflows as a browser's does.
  pageZoomFactor: f32,
  /// Whether Ctrl (Cmd on macOS) with `=`, `-` and `0` changes the page zoom. Hosts whose
  /// platform zooms on its own, a browser, leave it off.
  pub zoomKeys: bool,
  /// Whether a mutation naming a node that no longer exists is skipped, and counted in
  /// `staleSkipped`, instead of failing its batch: a script host whose page outlives one bad
  /// mutation turns it on.
  pub skipsStale: bool,
  pub staleSkipped: u64,
  /// The frame the current root last painted at: its subtrees cached then can be replayed.
  paintedAt: u64,
  /// The viewport and the layout and scroll revisions of the current root's last paint: a
  /// frame where none of them changed and nothing else asked for paint keeps that scene
  /// (see `quietFrame`). A width of -1 means no paint is known, as after a root switch.
  quietInput: FrameInput,
  quietRevision: usize,
  quietScrolls: usize,
  /// Frames whose paint was skipped because nothing changed since the last paint.
  pub paintsKept: u64,
  /// While content scrolls under a still pointer, the frame time at which hover follows it
  /// again (see `followHover`); negative when no hover update waits.
  hoverSettleAt: f64,
  /// Of those, the frames that only scrolled: the scene was kept and its scroll positions
  /// moved (see `scrollsWithinLead`). A host draws such a frame by scrolling the last one.
  pub scrollsKept: u64,
  /// The scroll positions the last paint recorded, in device pixels: what its culling was
  /// centered on. The scene's own positions move with the frames that keep it.
  paintedScrolls: List<ScrollPosition>,
  pub stats: FrameStats,
  pub events: List<Event>,
  /// The node ids in the order the last frame painted them (replayed subtrees included).
  pub paintOrder: List<u32>,
  /// Per fragment of the last layout: the hash of its subtree's paint inputs.
  pub fragmentHashes: List<u64>,
  /// Per fragment of the last layout: the bounds of its subtree's ink in CSS pixels.
  pub fragmentInk: List<Rect<f32>>,
  /// Per fragment of the last layout: whether its subtree holds a scroll container.
  pub fragmentScrollers: List<bool>,
  /// Per fragment of the last layout: where stacking paints it (see `stacking`).
  pub fragmentStacking: Stacking,
  /// Whether the fragment hashes, ink and stacking must all be worked out again: something
  /// changed that `repair` does not follow. Scrolling leaves them as they are.
  paintCachesStale: bool,
  /// What changed for them short of that: the fragments a layout pass wrote, the nodes a
  /// restyle or a mutation repaints. The next refresh works out those alone (see `repair`).
  pub repair: Repair,
  /// The slots of the nodes that listen for layout (see `notifyLayout`): each one that began
  /// to, until the next report finds it gone or no longer listening.
  layoutListeners: List<u32>,
  /// Whether a scroll offset changed since the last frame.
  pub scrolled: bool,
  /// Whether some node may hold a scroll offset other than zero: set by every write of one,
  /// cleared by `settleScrolls` when it finds none, so a tree that never scrolled skips its
  /// walk over the nodes.
  pub offsets: bool,
  /// The most nodes the tree has held since it last gave back what a larger tree left
  /// (see `releaseSlack`).
  heldNodes: usize,
  /// The nodes that may hold a scroll offset (see `interact.settleScrolls`): each node whose
  /// offset left zero since it was last settled.
  pub scrolledSlots: List<u32>,
  /// Whether no scroll offset changed between the previous frame and this one.
  scrollsStill: bool,
  /// The child lists `restylePlaceReaders` walked since styles last resolved (`placeTick` is
  /// `Work.styleCalls` then): a slot and its node id.
  placeWalked: [u64; 8],
  placeCount: usize,
  placeTick: usize,
  pub textInk: List<TextInk>,
  facesDirty: bool,
  pub uploads: Pending,
  /// The first fragment of each css-layout node in the last layout, or NO_INDEX.
  pub fragmentOf: List<usize>,
  /// The layout revision, scroll revision and viewport height `content-visibility: auto`
  /// elements were last reviewed at (see `reviewSkipped`).
  skipReview: [usize; 3],
  /// How far, in CSS pixels, scroll offsets may move after that review before any
  /// `content-visibility: auto` element could wake or be skipped, and how far they have moved
  /// since (see `reviewSkipped`).
  skipSlack: f32,
  pub skipTravel: f32,
  /// The css nodes `wakeFor` woke this frame: they stay awake until the next one.
  heldAwake: List<u32>,
  /// Next fragment with the same CSS source, in arena order.
  pub nextSourceFragment: List<usize>,
  /// First paint-order index per node slot, or NONE.
  pub paintIndexOf: List<u32>,
  /// Whether focus should show as focus-visible: the last focus change came from the keyboard.
  pub focusVisible: bool,
  /// The hovered nodes as (slot, id) pairs, the target first, then its ancestors.
  pub hoverChain: List<u64>,
  /// The nodes in the active state as (slot, id) pairs, and the node holding the pointer
  /// capture (NONE when no button is down).
  pub pressChain: List<u64>,
  pub capture: u32,
  pub captureId: u32,
  /// Where the press sends its pointer records: `CAPTURE_IMPLICIT` (the pressed node),
  /// `CAPTURE_EXPLICIT` (the node below, set with `SetPointerCapture`) or `CAPTURE_RELEASED`
  /// (the node under the pointer).
  pub captureMode: u32,
  pub captureTo: u32,
  pub captureToId: u32,
  /// The key that is down had its default prevented, so the text it types is dropped.
  pub suppressText: bool,
  /// The target `begin` found for the input under way, as a (slot, id) pair, so `finish`
  /// applies the default action to that node even when handlers changed the tree between.
  pub pendingTarget: u32,
  pub pendingTargetId: u32,
  /// The node of the last pointer down, as a (slot, id) pair: where a request (close, back)
  /// starts when nothing has focus.
  pub pressed: u32,
  pub pressedId: u32,
  /// The click count of the press, for its click record.
  pub pressCount: u32,
  /// A scrollbar thumb being dragged: the container slot (NONE when none), the axis, and the
  /// pointer and scroll offset where the drag started.
  pub thumbSlot: u32,
  pub thumbVertical: bool,
  pub thumbStart: f32,
  pub thumbOffset: f32,
  /// Fingers on the screen, the gesture they make, and a flick (see `touch`).
  pub touch: TouchState,
  /// What a touch input's `begin` left for its `finish` (`touch.TOUCH_*`), and the finger it
  /// saw come off.
  pub touchPending: u8,
  pub touchEnded: usize,
  /// The pointer the pointer records being made speak for: DOM `pointerId`, `POINTER_*` type
  /// and `isPrimary`.
  pub pointerId: u32,
  pub pointerType: u32,
  pub pointerPrimary: bool,
  /// Where the pointer is, and whether it is in the window.
  pub pointerX: f32,
  pub pointerY: f32,
  pub pointerInside: bool,
  /// Nodes to scroll into view at the next frame, as (slot, id) pairs.
  pub reveal: List<u64>,
  /// CSSOM scroll completion/events and the animations driven by the real frame clock.
  pub viewScrollState: ScrollState,
  pub viewScrollAnimations: List<ScrollAnimation>,
  /// Whether a mutation was applied since the last frame.
  applied: bool,
  pub layoutObserversDirty: bool,
  /// Whether something only paint shows changed since the last frame (a caret moved).
  pub paintDirty: bool,
  /// Requests for the host (clipboard), oldest first.
  pub requests: List<HostRequest>,
  /// Input the tree fed itself as the default action of another: the copy or cut of a
  /// shortcut, the edit of a cut or paste. Hosts run each through `begin` and `finish` like
  /// their own input (`takeFollowUp`).
  pub followUps: List<Input>,
  /// The modifier keys editing shortcuts use; the compilation target's by default.
  pub keymap: Keymap,
  /// Whether text selections follow what is seen or the tree where layout reorders children.
  pub selectionOrder: SelectionOrder,
  /// The id of the current root, and whether it is open. Before any root opens, the current
  /// root is the first one, closed.
  pub current: u32,
  pub currentOpen: bool,
  pub currentOptions: RootOptions,
  /// The open roots other than the current one.
  pub parked: List<RootState>,
  /// The root key and text input go to: the last one a host reported `Focused`, the first
  /// root until then.
  pub keyRoot: u32,
  /// The root of the input `begin` started, for `finish`.
  pendingRoot: u32,
  /// What roots this tree shows: any number of headless surfaces unless a host says less.
  pub rootSupport: RootSupport,
  /// Root events for the client, oldest first.
  pub rootEvents: List<RootEvent>,
  /// The roots set aside for a second client in the same tree (see `setAside`).
  pub aside: List<u32>,
  /// What `sceneOf` gives for a root that is not open.
  empty: Scene,
  /// The style overrides (see `setOverride`), a few at most; styles resolve as before while
  /// there are none.
  overrides: List<StyleOverride>,
  /// The running CSS transitions of every root (see `motion`).
  pub transitions: List<Running>,
  /// Shared empty `Effects` sentinel for nodes without declared paint effects (keeps `Node` at 296 B).
  emptyEffects: Frozen<Effects>,
  /// Final filter values of `filter` transitions that just ended, consumed by `moveFilters`.
  endedFilters: List<EndedFilter>,
  /// Whether `translate` transitions are handed to the renderer as [`Move`]s. A host turns
  /// it on when its renderer draws frames by itself (`motion.slides`).
  pub compositedMoves: bool,
  /// The moves of the frame painted last.
  pub moves: List<Move>,
  /// What `moves` named, to see when the set changes.
  pub movesKey: u64,
  /// The points of the `linear()` easings styles have used.
  pub easingStops: EasingStops,
  /// The `@keyframes` rules the client defined (see `animation`).
  pub keyframes: List<Rule>,
  /// The CSS animations every root plays.
  pub animations: List<Playing>,
  /// The style under the animations of each node that plays some, as its last full restyle
  /// left it: a frame of the clock starts from it instead of applying the node's declarations
  /// again (see `resolve`). `tickPlaces[slot]` is the node's index here + 1, or 0.
  pub tickBases: List<TickBase>,
  pub tickPlaces: List<u32>,
  /// The viewport `tickBases` were built in: its size is in every one of them.
  tickWidth: f32,
  tickHeight: f32,
  /// What the host last showed for a cursor image (`cursorShown`), 0 for a keyword.
  pub cursorShown: u64,
  /// Work done since the tree was made, for the bench census.
  pub work: Work,
}

/// What `scene` holds, for the bench census: its layers and the primitives of each kind.
effect fn sceneCensus(scene: &Scene, out: &mut Census) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let layers = scene.layerCount()
  let mut quads: usize = 0
  let mut glyphs: usize = 0
  let mut images: usize = 0
  let mut shadows: usize = 0
  let mut paths: usize = 0
  let mut underlines: usize = 0
  let mut sprites: usize = 0
  let mut batches: usize = 0
  let mut layer: u32 = 0
  while layer < layers {
    quads = quads + scene.quads(layer).length
    glyphs = glyphs + scene.glyphs(layer).length
    images = images + scene.images(layer).length
    shadows = shadows + scene.shadows(layer).length
    paths = paths + scene.paths(layer).length
    underlines = underlines + scene.underlines(layer).length
    sprites = sprites + scene.layers(layer).length
    batches = batches + scene.batches(layer).length
    layer = layer + 1
  }
  run out.unit("scene.layers", u32.toUsize(layers))
  run out.unit("scene.operations", scene.operationCount())
  run out.held("scene.quads", quads, quads, Intrinsic.layoutOf<Quad>().bytes)
  run out.held("scene.glyphs", glyphs, glyphs, Intrinsic.layoutOf<GlyphSprite>().bytes)
  run out.held("scene.images", images, images, Intrinsic.layoutOf<ImageSprite>().bytes)
  run out.held("scene.shadows", shadows, shadows, Intrinsic.layoutOf<Shadow>().bytes)
  run out.held("scene.paths", paths, paths, Intrinsic.layoutOf<PathSprite>().bytes)
  run out.held("scene.underlines", underlines, underlines, Intrinsic.layoutOf<Underline>().bytes)
  run out.held("scene.layer-sprites", sprites, sprites, Intrinsic.layoutOf<LayerSprite>().bytes)
  run out.unit("scene.batches", batches)
  run out.unit("scene.scroll-groups", scene.scrollGroups().length)
  run out.unit("scene.scroll-positions", scene.scrolls().length)
}

/// The style nodes of one kind are made with.
struct FreshStyle { kind: NodeKind, styled: Frozen<Computed> }

/// Text nodes take their style from their parent alone: equal parents (one computed stamp, the
/// same rendered state, in one viewport) give their text children one style. The first text
/// child builds it; the others take its handle and keys (`UiTree.inheritText`). Blink and Stylo
/// give text no style of its own for the same reason.
struct TextInherit {
  parentStamp: u32,
  parentRendered: bool,
  width: f32,
  height: f32,
  styled: Frozen<Computed>,
  stamp: u32,
  rendered: bool,
  fontKey: usize,
  paintHash: u64,
}

/// Entries `UiTree.textInherits` holds, indexed by the parent's stamp.
const TEXT_INHERITS: usize = 64

/// The style of a node before its animations (see `UiTree.tickBases`).
pub struct TickBase {
  /// The node it is of, [`NONE`] once it no longer holds.
  pub id: u32,
  pub computed: Computed,
  /// The keyframe values of its first animation over `computed`.
  pub samples: KeptSamples,
}

impl<'a> UiTree<'a> {
  /// What the tree holds and the work it did since it was made, as rows of a census
  /// (`properties.census`): the bench prints them with `SILK_UI_BENCH_CENSUS`. It reads
  /// everything and changes nothing.
  pub effect fn census(self: &Self, out: &mut Census) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let u = Intrinsic.layoutOf<usize>().bytes
    let declaration = Intrinsic.layoutOf<Declaration>().bytes
    // Natural units.
    let mut live: usize = 0
    let mut texts: usize = 0
    let mut boxes: usize = 0
    let mut other: usize = 0
    let mut generated: usize = 0
    let mut textBytes: usize = 0
    let mut textRoom: usize = 0
    let mut labelRoom: usize = 0
    let mut baseUsed: usize = 0
    let mut baseRoom: usize = 0
    let mut withBase: usize = 0
    let mut extras: usize = 0
    let mut rares: usize = 0
    let mut moving: usize = 0
    let mut editing: usize = 0
    let mut effects: usize = 0
    let mut semantics: usize = 0
    let mut sheets: usize = 0
    let mut twins: usize = 0
    let mut identities: usize = 0
    let mut identityExtras: usize = 0
    let mut classBytes: usize = 0
    let mut classAtoms: usize = 0
    let mut withClasses: usize = 0
    let mut listening: usize = 0
    let mut hovered: usize = 0
    let mut distinctClasses = HashMap<u64, usize>.make(self.seed)
    let mut distinctTexts = HashMap<u64, usize>.make(self.seed)
    let mut distinctEffects = HashMap<u64, usize>.make(self.seed)
    let mut repeatedTextBytes: usize = 0
    let mut at: usize = 0
    while at < self.nodes.length() {
      let node = &self.nodes.asSlice()[at]
      at = at + 1
      if !node.live { continue }
      live = live + 1
      if node.kind == NodeKind.Text { texts = texts + 1 } else if node.kind == NodeKind.Box { boxes = boxes + 1 } else { other = other + 1 }
      if node.isGenerated() { generated = generated + 1 }
      let bytes = String.utf8Bytes(String.view(&node.text))
      textBytes = textBytes + bytes.length
      textRoom = textRoom + node.text.capacity()
      if bytes.length != 0 {
        let mut hashed = Hash.mix(&self.seed, usize.toU64(bytes.length))
        let mut b: usize = 0
        while b < bytes.length {
          hashed = Hash.combine(hashed, u8.toU64(bytes[b]))
          b = b + 1
        }
        if distinctTexts.contains(hashed) { repeatedTextBytes = repeatedTextBytes + bytes.length } else { drop run distinctTexts.insert(hashed, 1) }
      }
      if let Option.Some { value: rare } = node.rare.get() {
        rares = rares + 1
        labelRoom = labelRoom + rare.label.capacity()
      }
      baseUsed = baseUsed + node.base.length()
      baseRoom = baseRoom + node.base.capacity()
      if node.base.length() != 0 { withBase = withBase + 1 }
      if node.extras.isSome() { extras = extras + 1 }
      if node.moving.isSome() { moving = moving + 1 }
      if node.editing.isSome() { editing = editing + 1 }
      if node.hasEffectsFlag {
        effects = effects + 1
        let addr = usize.toU64(Pointer.address<Effects>(Pointer.fromRef<Effects>(node.effects.get())))
        drop run distinctEffects.insert(addr, 1)
      }
      if node.semantics.isSome() { semantics = semantics + 1 }
      if node.resolvedSheet.isSome() { sheets = sheets + 1 }
      if node.styleTwin != NONE { twins = twins + 1 }
      if node.listeners != 0 { listening = listening + 1 }
      if node.hovered { hovered = hovered + 1 }
      if let Option<&NodeIdentity>.Some { value: identity } = node.identity() {
        identities = identities + 1
        if identity.extras.isSome() { identityExtras = identityExtras + 1 }
        let classes = String.utf8Bytes(identity.classes())
        classBytes = classBytes + classes.length
        classAtoms = classAtoms + identity.classAtoms().length
        if classes.length != 0 {
          withClasses = withClasses + 1
          let mut hashed = Hash.mix(&self.seed, usize.toU64(classes.length))
          let mut b: usize = 0
          while b < classes.length {
            hashed = Hash.combine(hashed, u8.toU64(classes[b]))
            b = b + 1
          }
          if !distinctClasses.contains(hashed) { drop run distinctClasses.insert(hashed, 1) }
        }
      }
    }
    run out.unit("nodes", live)
    run out.unit("nodes.elements", boxes + other)
    run out.unit("nodes.text", texts)
    run out.unit("nodes.other(input, image, icon, canvas)", other)
    run out.unit("nodes.generated", generated)
    run out.unit("nodes.with-inline-style", withBase)
    run out.unit("nodes.with-classes", withClasses)
    run out.unit("nodes.with-sheet-record", sheets)
    run out.unit("nodes.sheet-record-from-twin", twins)
    run out.unit("nodes.listening", listening)
    run out.unit("nodes.hovered", hovered)
    run out.unit("classes.distinct-class-attributes", distinctClasses.length())
    run out.unit("classes.atoms-on-nodes", classAtoms)
    run out.unit("text.distinct-node-texts", distinctTexts.length())
    run out.unit("text.bytes-in-repeated-node-texts", repeatedTextBytes)
    run out.unit("style.sheet-classes-handed-out", u32.toUsize(self.styleClasses))
    run out.unit("fragments", self.output.fragments.values.length())
    run out.unit("text-records", self.output.fragments.texts.length())

    // The node table and what hangs off a node.
    run out.held("tree.nodes", live, self.nodes.capacity(), Intrinsic.layoutOf<Node>().bytes)
    run out.unit("tree.nodes.slots", self.nodes.length())
    run out.bytes("tree.nodes.text", textBytes, textRoom)
    run out.bytes("tree.nodes.label", 0, labelRoom)
    run out.held("tree.nodes.base-declarations", baseUsed, baseRoom, declaration)
    run out.held("tree.nodes.rare(NodeRare)", rares, rares, Intrinsic.layoutOf<NodeRare>().bytes)
    run out.held("tree.nodes.extras(NodeExtras)", extras, extras, Intrinsic.layoutOf<NodeExtras>().bytes)
    run out.held("tree.nodes.moving(Computed)", moving, moving, Intrinsic.layoutOf<Computed>().bytes)
    run out.held("tree.nodes.editing", editing, editing, Intrinsic.layoutOf<EditState>().bytes)
    run out.held("tree.nodes.effects", distinctEffects.length(), distinctEffects.length(), Intrinsic.layoutOf<Effects>().bytes + 16)
    run out.unit("nodes.with-effects", effects)
    run out.held("tree.nodes.semantics", semantics, semantics, Intrinsic.layoutOf<Semantics>().bytes)
    run out.held("tree.nodes.identity(NodeIdentity)", identities, identities, Intrinsic.layoutOf<NodeIdentity>().bytes)
    run out.held("tree.nodes.identity.extras", identityExtras, identityExtras, Intrinsic.layoutOf<IdentityExtras>().bytes)
    // Tag and class text live once per distinct key, shared by the elements that have it.
    let keys = self.selectorKeys.room()
    run out.unit("classes.bytes-on-nodes", classBytes)
    run out.held("tree.selector-keys(SelectorKey)", self.selectorKeys.length(), self.selectorKeys.length(), Intrinsic.layoutOf<SelectorKey>().bytes)
    run out.bytes("tree.selector-keys.class-text", keys.classes, keys.classes)
    run out.bytes("tree.selector-keys.tag-text", 0, keys.tag)
    run out.held("tree.selector-keys.class-atoms", keys.atoms, keys.atomRoom, u)
    run out.held("tree.ids(map id to slot)", self.ids.length(), self.ids.bucketCount(), 21)
    run out.held("tree.slot-of-css", self.slotOfCss.length(), self.slotOfCss.capacity(), 4)
    run out.held("tree.free-slots", self.free.length(), self.free.capacity(), 4)
    run out.held("tree.tick-places", self.tickPlaces.length(), self.tickPlaces.capacity(), 4)
    run out.held("tree.tick-bases", self.tickBases.length(), self.tickBases.capacity(), Intrinsic.layoutOf<TickBase>().bytes)
    run out.held("tree.layout-listeners", self.layoutListeners.length(), self.layoutListeners.capacity(), 4)
    run out.held("tree.events", self.events.length(), self.events.capacity(), Intrinsic.layoutOf<Event>().bytes)
    run out.held("tree.transitions", self.transitions.length(), self.transitions.capacity(), Intrinsic.layoutOf<Running>().bytes)
    run out.held("tree.animations", self.animations.length(), self.animations.capacity(), Intrinsic.layoutOf<Playing>().bytes)
    run out.held("tree.container-watches", self.containerWatches.length(), self.containerWatches.capacity(), Intrinsic.layoutOf<Watch>().bytes)
    run out.held("tree.style-changes", self.styleChanges.length(), self.styleChanges.capacity(), Intrinsic.layoutOf<Change>().bytes)
    run out.held("tree.naturals(per slot)", self.provider.naturals.length(), self.provider.naturals.capacity(), Intrinsic.layoutOf<NaturalDimensions>().bytes)
    // Style: atoms, sheets, shared records and computed values.
    run out.held("tree.class-atoms", self.styleAtoms.length(), self.styleAtoms.length(), Intrinsic.layoutOf<Bytes>().bytes)
    run out.bytes("tree.class-atoms.names", self.styleAtoms.nameBytes(), self.styleAtoms.nameBytes())
    run out.held("tree.style-models", self.styleModels.length(), self.styleModels.bucketCount(), 21)
    run self.stylePool.census(&mut out)
    run out.held("tree.font-keys", self.fontKeys.length(), self.fontKeys.capacity(), Intrinsic.layoutOf<FontKeyEntry>().bytes)
    let mut loadedFaces: usize = 0
    let mut fi: usize = 0
    while fi < self.faces.length() {
      if self.faces.asSlice()[fi].face.isSome() { loadedFaces = loadedFaces + 1 }
      fi = fi + 1
    }
    run out.held("tree.faces", self.faces.length(), self.faces.capacity(), Intrinsic.layoutOf<FaceSlot<'a>>().bytes)
    run out.held("tree.faces.loaded", loadedFaces, loadedFaces, Intrinsic.layoutOf<FontFace<'a>>().bytes)
    let mut root: usize = 0
    while root < self.styleSheets.length() {
      let sheets = &self.styleSheets.asSlice()[root]
      run sheets.cache.census(&mut out)
      run sheets.sheets.census(&mut out)
      root = root + 1
    }
    // Per fragment and per node paint tables.
    run out.held("tree.fragment-hashes", self.fragmentHashes.length(), self.fragmentHashes.capacity(), 8)
    run out.held("tree.fragment-ink", self.fragmentInk.length(), self.fragmentInk.capacity(), 16)
    run out.held("tree.fragment-scrollers", self.fragmentScrollers.length(), self.fragmentScrollers.capacity(), 1)
    run self.fragmentStacking.census(&mut out)
    run self.repair.index.census(&mut out)
    run out.bytes("tree.repair.lists", self.repair.nodes.length() * 4 + self.repair.fragments.length() * 8,
      self.repair.nodes.capacity() * 4 + (self.repair.fragments.capacity() + self.repair.dirty.capacity() + self.repair.stack.capacity() + self.repair.spareHashes.capacity()) * 8
        + self.repair.spareInk.capacity() * 16 + self.repair.spareFlags.capacity() + self.repair.marks.capacity())
    run out.held("tree.fragment-of(per css node)", self.fragmentOf.length(), self.fragmentOf.capacity(), u)
    run out.held("tree.next-source-fragment(per fragment)", self.nextSourceFragment.length(), self.nextSourceFragment.capacity(), u)
    run out.held("tree.paint-order", self.paintOrder.length(), self.paintOrder.capacity(), 4)
    run out.held("tree.paint-index-of(per slot)", self.paintIndexOf.length(), self.paintIndexOf.capacity(), 4)
    run out.held("tree.text-ink", self.textInk.length(), self.textInk.capacity(), Intrinsic.layoutOf<TextInk>().bytes)
    run out.held("tree.scrolled-slots", self.scrolledSlots.length(), self.scrolledSlots.capacity(), 4)
    // The scenes: what the last frame drew.
    run sceneCensus(self.scene(), &mut out)
    run out.unit("atlas.tiles", u32.toUsize(self.atlas.tileCount()))
    run out.unit("atlas.textures", self.atlas.textureCount())
    run out.unit("paths.cached", self.paths.length())
    run out.unit("images.decoded", self.resources.images.length())
    run out.bytes("images.decoded-pixels(RGBA)", self.resources.images.censusPixels() * 4, self.resources.images.censusPixels() * 4)
    run out.unit("images.with-atlas-tile", self.resources.images.censusTiles())
    run out.work("images.uploads", u64.wrappingToUsize(self.resources.images.uploadCount()))
    // css-layout and text.
    run self.layout.census(&mut out)
    run self.output.census(&mut out)
    run self.provider.text.census(&mut out)
    run self.censusWork(&mut out)
  }

  /// The work rows of `census` alone: counts since the tree was made, cheap enough to read
  /// between inputs (the inspector's `stats`).
  pub effect fn censusWork(self: &Self, out: &mut Census) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    let w = &self.work
    run out.work("frames", w.frames)
    run out.work("frames.styled", w.styleFrames)
    run out.work("frames.layout-step", w.layoutFrames)
    run out.work("mutations", w.mutations)
    run out.work("mutations.batches", w.batches)
    run out.work("mutations.create", w.creates)
    run out.work("mutations.insert", w.inserts)
    run out.work("mutations.set-style", w.setStyles)
    run out.work("mutations.set-style.declarations", w.styleDeclarations)
    run out.work("mutations.set-text", w.setTexts)
    run out.work("mutations.set-text.bytes", w.textBytes)
    run out.work("mutations.set-attribute", w.attributes)
    run out.work("mutations.set-attribute.class-and-named-bytes", w.attributeBytes)
    run out.work("bridge.calls", w.bridgeCalls)
    run out.work("mutations.set-listeners", w.listens)
    run out.work("atoms.interns", self.styleAtoms.interns)
    run out.work("atoms.compares", self.styleAtoms.compares)
    run out.work("style.resolve-styles-calls", w.styleCalls)
    run out.work("style.resolve-styles-calls.past-early-return", w.stylePasses)
    run out.work("style.resolve-styles-calls.full", w.fullStylePasses)
    run out.work("style.root-restyles", w.rootRestyles)
    run out.work("style.watch-overflows", w.watchOverflows)
    let dirtyNames = [
      "style.dirty-cause.00-anchor-set",
      "style.dirty-cause.01-anchor-clear",
      "style.dirty-cause.02-css-anchor",
      "style.dirty-cause.03-restyle",
      "style.dirty-cause.04-other",
      "style.dirty-cause.05-other",
      "style.dirty-cause.06-sheet-order",
      "style.dirty-cause.07-sheet-remove",
      "style.dirty-cause.08-font-family",
      "style.dirty-cause.09-keyframes",
      "style.dirty-cause.10-touch-root",
      "style.dirty-cause.11-use-root-touched",
      "style.dirty-cause.12-font-rules",
      "style.dirty-cause.13-set-root",
      "style.dirty-cause.14-style-prefs",
      "style.dirty-cause.15-font-face-load",
      "style.dirty-cause.16-font-face-fail",
      "style.dirty-cause.17-page-zoom",
      "style.dirty-cause.18-style-env",
      "style.dirty-cause.19-adopt-sheet",
      "style.dirty-cause.20-media-cond",
      "style.dirty-cause.21-class-wrap",
      "style.dirty-cause.22-scope-limit",
      "style.dirty-cause.23-detached",
    ]
    let mut dirtyCause: usize = 0
    while dirtyCause < dirtyNames.length {
      if w.dirtyCauses[dirtyCause] != 0 {
        run out.work(dirtyNames[dirtyCause], w.dirtyCauses[dirtyCause])
      }
      dirtyCause = dirtyCause + 1
    }
    run out.work("style.media-conditions-evaluated", w.conditionsEvaluated)
    run out.work("style.rules-walked-for-conditions", w.conditionRulesWalked)
    run out.work("style.resolves", w.resolves)
    run out.work("style.resolves.ticks", w.ticks)
    run out.work("style.scope-moves", w.scopeMoves)
    run out.work("style.resolves.cause.full-pass", w.resolveCauses[0])
    run out.work("style.resolves.cause.root-font-changed", w.resolveCauses[1])
    run out.work("style.resolves.cause.parent-inherited-values-changed", w.resolveCauses[2])
    run out.work("style.resolves.cause.reached-through-selectors", w.resolveCauses[3])
    run out.work("style.resolves.cause.own-change", w.resolveCauses[4])
    run out.work("style.resolves.cause.scope.also-dirty", w.resolveCauses[5])
    run out.work("style.resolves.cause.scope.a-part-reads-variables", w.resolveCauses[6])
    run out.work("style.resolves.cause.scope.no-sheet-style", w.resolveCauses[7])
    run out.work("style.resolves.cause.scope.reads-any-variable", w.resolveCauses[8])
    run out.work("style.resolves.cause.scope.reads-a-differing-variable", w.resolveCauses[9])
    run out.work("style.resolves.cause.scope.first-letter", w.resolveCauses[10])
    run out.work("style.resolves.cause.scope.all-variables-may-differ", w.resolveCauses[11])
    run out.work("style.sheet.skipped(text or no sheet)", w.sheetSkips)
    run out.work("style.sheet.from-twin", w.sheetTwins)
    run out.work("style.sheet.matched", w.sheetMatches)
    run out.work("style.sheet.matched.record-cache-hits", w.sheetCacheHits)
    run out.work("style.computed-from-lender", w.lenders)
    run out.work("style.computed-from-lender.whole-result", w.sharedResults)
    run out.work("style.text-inherited", w.textInherits)
    run out.work("style.pool-shares", w.styleShares)
    run out.work("layout.computes.passes", w.layoutPasses)
    run out.work("layout.full-layouts", w.layoutFull)
    run out.work("layout.size-probes", w.layoutProbes)
    run out.work("layout.cache-hits", w.layoutCacheHits)
    run out.work("layout.reused-layouts", w.layoutReused)
    run out.work("layout.inline-layouts-and-probes", w.inlineLayouts)
    run out.work("layout.plain-line-probes", w.plainLines)
    run out.work("layout.lines-emitted", w.linesEmitted)
    run out.work("layout.scroll-only-moves", w.layoutMoves)
    run out.work("layout.fragments-resolved", w.fragmentsResolved)
    run out.work("hover.refreshes", w.hoverRefreshes)
    run out.work("paint.cache-repairs", self.repair.repairs)
    run out.work("paint.cache-rebuilds", self.repair.rebuilds)
    run out.work("paint.fragments-painted", w.paintedFragments)
    run out.work("paint.subtrees-culled", w.culledSubtrees)
    run out.work("paint.subtrees-replayed", w.replayedSubtrees)
    run out.work("paint.subtrees-repainted", w.repaintedSubtrees)
    run out.work("paint.operations-replayed", w.replayedOperations)
    run out.work("paint.glyphs-emitted", w.paintedGlyphs)
    run out.work("paths.hits", u64.wrappingToUsize(self.paths.hits()))
    run out.work("paths.misses", u64.wrappingToUsize(self.paths.misses()))
  }

  /// An empty tree drawing with the fonts of `collection`.
  pub effect fn make(collection: &'a FontCollection) -> UiTree<'a>
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut viewport = CssStyle.make()
    viewport.width = SizeValue.px(0.0)
    viewport.height = SizeValue.px(0.0)
    let mut layout = run LayoutTable.make(move viewport)

    // Scroll and sticky offsets are applied when painting, so scrolling needs no layout.
    layout.stickyDeferred = true
    let resources = run Effect.catch<ResourceError>(Resources.make(&collection.database), layoutFailed)
    let seed = Hash.seed(0x7569747265)
    return UiTree<'a> {
      virtualLists: List<VirtualList>.make(),
      browseCursor: NONE,
      anchors: List<Anchored>.make(),
      layout: move layout,
      output: LayoutTree.make(),
      containerWatches: List<Watch>.make(),
      styleChanges: List<Change>.make(),
      changingStyles: false,
      provider: Provider<'a> {
        text: TextSystem.make(collection),
        naturals: List<NaturalDimensions>.make(),
      },
      nodes: List<Node>.make(),
      selectorKeys: SelectorKeys.make(),
      paintCaches: PaintCaches.make(),
      styleAtoms: Atoms.make(),
      ancestorFilter: AncestorFilter.make(),
      filterPath: List<u32>.make(),
      filterOn: false,
      siblingIndex: List<u32>.make(),
      siblingCount: List<u32>.make(),
      siblingStamp: List<u32>.make(),
      siblingPass: 0,
      siblingOn: false,
      styleSheets: List<RootSheets>.make(),
      pendingFirstRootSheets: List<Bytes>.make(),
      styleLoads: List<StyleRequest>.make(),
      styleGeneration: 0,
      svgStyleRevision: 1,
      svgStylesPending: true,
      nextStyleId: 1,
      hostStylePreferences: Option<Preferences>.None,
      free: List<u32>.make(),
      ids: HashMap<Word, u32>.make(seed),
      slotOfCss: List<u32>.make(),
      root: NONE,
      focused: NONE,
      textSelection: TextSelection.make(),
      returns: List<FocusReturn>.make(),
      inerts: 0,
      families: Families.make(),
      variations: VariationTable.make(),
      resources: move resources,
      loads: List<Mutation>.make(),
      sourceStates: List<u8>.make(),
      sourceTells: List<u32>.make(),
      fontKeys: List<FontKeyEntry>.make(),
      fontFaces: List<FontFaceEntry>.make(),
      sheetFaces: SheetFaces.make(),
      fontRules: FontRules.make(),
      fontBlockEnd: -1.0,
      faceSources: List<FaceSource>.make(),
      nextHostFace: FIRST_HOST_FACE,
      faces: List<FaceSlot<'a>>.make(),
      canvas2d: Canvas2d<'a>.make(),
      canvasRasters: CanvasRasters.make(),
      atlas: Atlas.make(AtlasOptions.default()),
      glyphs: GlyphCache.make(),
      paths: PathCache.make(),
      sceneA: Scene.make(),
      sceneB: Scene.make(),
      flipped: false,
      replayable: false,
      seed: seed,
      stylesDirty: true,
      stylesPending: false,
      listsUsed: false,
      listsDirty: false,
      listsStructure: usize.MAX,
      letterUsed: false,
      letterPending: List<u32>.make(),
      lineOrigins: List<u32>.make(),
      firstLines: List<first_letter.FirstLine>.make(),
      snapUsed: false,
      cssAnchorUsed: false,
      offsetUsed: false,
      preserveUsed: false,
      cssPlacements: List<css_anchor.Placement>.make(),
      snapWaits: List<SnapWait>.make(),
      scrollAnchors: List<ScrollAnchor>.make(),
      styleClasses: 0,
      styleModels: HashMap<u64, u32>.make(Hash.seed(5399)),
      movedClasses: HashMap<u64, u32>.make(Hash.seed(5407)),
      stylePool: StylePool.make(),
      textInherits: List<TextInherit>.make(),
      freshStyles: List<FreshStyle>.make(),
      computedStamps: 0,
      frameNumber: 0,
      semanticRevision: 0,
      revision: 0,
      input: FrameInput { width: 0.0, height: 0.0, scale: 1.0, time: 0.0 },
      laidOut: FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 },
      laidOutRevision: usize.MAX,
      laidOutScrolls: usize.MAX,
      styledViewport: FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 },
      unitsWidth: 0.0,
      unitsHeight: 0.0,
      pageZoomFactor: 1.0,
      zoomKeys: false,
      skipsStale: false,
      staleSkipped: 0,
      paintedAt: 0,
      quietInput: FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 },
      quietRevision: usize.MAX,
      quietScrolls: usize.MAX,
      paintsKept: 0,
      hoverSettleAt: -1.0,
      scrollsKept: 0,
      paintedScrolls: List<ScrollPosition>.make(),
      stats: FrameStats.zero(),
      events: List<Event>.make(),
      paintOrder: List<u32>.make(),
      fragmentHashes: List<u64>.make(),
      fragmentInk: List<Rect<f32>>.make(),
      fragmentScrollers: List<bool>.make(),
      fragmentStacking: Stacking.make(),
      paintCachesStale: true,
      repair: Repair.make(),
      layoutListeners: List<u32>.make(),
      scrolled: false,
      offsets: false,
      scrolledSlots: List<u32>.make(),
      heldNodes: 0,
      scrollsStill: false,
      placeWalked: [0; 8],
      placeCount: 0,
      placeTick: usize.MAX,
      textInk: List<TextInk>.make(),
      facesDirty: true,
      uploads: Pending.make(),
      fragmentOf: List<usize>.make(),
      skipReview: [usize.MAX; 3],
      skipSlack: 0.0,
      skipTravel: 0.0,
      heldAwake: List<u32>.make(),
      nextSourceFragment: List<usize>.make(),
      paintIndexOf: List<u32>.make(),
      focusVisible: false,
      hoverChain: List<u64>.make(),
      pressChain: List<u64>.make(),
      capture: NONE,
      captureId: NONE,
      captureMode: 0,
      captureTo: NONE,
      captureToId: NONE,
      suppressText: false,
      pendingTarget: NONE,
      pendingTargetId: NONE,
      pressed: NONE,
      pressedId: NONE,
      pressCount: 0,
      thumbSlot: NONE,
      thumbVertical: true,
      thumbStart: 0.0,
      thumbOffset: 0.0,
      touch: TouchState.make(),
      touchPending: 0,
      touchEnded: usize.MAX,
      pointerId: 1,
      pointerType: 0,
      pointerPrimary: true,
      pointerX: 0.0,
      pointerY: 0.0,
      pointerInside: false,
      reveal: List<u64>.make(),
      viewScrollState: ScrollState.make(),
      viewScrollAnimations: List<ScrollAnimation>.make(),
      applied: false,
      layoutObserversDirty: false,
      paintDirty: false,
      requests: List<HostRequest>.make(),
      followUps: List<Input>.make(),
      keymap: NATIVE_KEYMAP,
      selectionOrder: SelectionOrder.Visual,
      current: FIRST_ROOT,
      currentOpen: false,
      currentOptions: RootOptions.default(),
      parked: List<RootState>.make(),
      keyRoot: FIRST_ROOT,
      pendingRoot: FIRST_ROOT,
      rootSupport: RootSupport { count: u32.MAX, extra: ExtraRoot.Surface },
      rootEvents: List<RootEvent>.make(),
      aside: List<u32>.make(),
      empty: Scene.make(),
      overrides: List<StyleOverride>.make(),
      transitions: List<Running>.make(),
      emptyEffects: run Frozen<Effects>.make(Effects.make()),
      endedFilters: List<EndedFilter>.make(),
      compositedMoves: false,
      moves: List<Move>.make(),
      movesKey: 0,
      easingStops: EasingStops.make(),
      keyframes: List<Rule>.make(),
      animations: List<Playing>.make(),
      tickBases: List<TickBase>.make(),
      tickPlaces: List<u32>.make(),
      tickWidth: 0.0,
      tickHeight: 0.0,
      cursorShown: 0,
      work: Work.zero(),
    }
  }

  // Nodes.

  /// Says that resource `resource` (from a `LoadImage` or `LoadIcon`) loaded or failed: each
  /// image or icon showing it that listens gets a `Load` or `Error` record, and so does any
  /// node that shows it later.
  pub effect fn settleSource(self: &mut Self, resource: u32, ok: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.resources.settleCssImage(resource, ok) {
      self.paintCachesStale = true
      // Floats whose `shape-outside` is a stylesheet image wrap around it once it loads.
      let mut i: usize = 0
      while i < self.nodes.length() {
        let node = &self.nodes.asSlice()[i]
        let imaged = node.live && node.kind != NodeKind.Text && match node.paintEffects() {
          Option<&Effects>.Some { value } => value.shapeImage.length() != 0
          Option<&Effects>.None => false
        }
        if imaged {
          run Effect.catch<TreeError>(self.updateShape(usize.toU32(i)), noShape)
        }
        i = i + 1
      }
      return ()
    }
    let at = u32.toUsize(resource)
    let have = self.sourceStates.length()
    if at >= have {
      run self.sourceStates.appendRepeated(SOURCE_PENDING, at + 1 - have)
    }
    let states = self.sourceStates.asMutSlice()
    states[at] = if ok { SOURCE_LOADED } else { SOURCE_FAILED }
    drop states
    let mut i: usize = 0
    while i < self.nodes.length() {
      let node = &self.nodes.asSlice()[i]
      if node.live && node.resource == resource
        && (node.kind == NodeKind.Image || node.kind == NodeKind.Icon) {
        run self.tellSource(usize.toU32(i), ok)
      }
      i = i + 1
    }
  }

  /// Gives css-layout the `shape-outside` of element `slot`, asking for its image first.
  effect fn updateShape(self: &mut Self, slot: u32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut url = Bytes.make()
    if let Option<&Effects>.Some { value } = self.node(slot).paintEffects() {
      if value.shapeImage.length() != 0 {
        if let Image.Url { url: named } = &value.shapeImage.asSlice()[0] {
          run url.append(Bytes.asSlice(&named))
        }
      }
    }
    if url.length() != 0 {
      drop run self.resources.cssImage(Bytes.asSlice(&url))
    }
    let node = self.node(slot)
    let css = node.css
    let shape = match node.paintEffects() {
      Option<&Effects>.Some { value } => run float_shapes.of(value, node.computed().paint.radii, node.computed().effects.radiusShare, &self.resources, float_shapes.contentSize(&node.computed().layout))
      Option<&Effects>.None => FloatShape.make()
    }
    run Effect.catchAll(self.layout.setShape(NodeId { index: css }, &shape), layoutFailed)
  }

  fn sourceState(self: &Self, resource: u32) -> u8 {
    let at = u32.toUsize(resource)
    if at >= self.sourceStates.length() {
      return SOURCE_PENDING
    }
    return self.sourceStates.asSlice()[at]
  }

  /// `[state, naturalWidth, naturalHeight]` of image/icon node `id`: state 0 = pending,
  /// 1 = loaded, 2 = failed. Dimensions are unzoomed CSS/natural pixels (0 while pending/failed).
  pub fn imageInfo(self: &Self, id: u32) -> [f64; 3] {
    let slot = self.slotOf(id)
    if slot == NONE {
      return [0.0, 0.0, 0.0]
    }
    let node = self.node(slot)
    if !node.live {
      return [0.0, 0.0, 0.0]
    }
    if let Option<&LiveSvg>.Some { value } = node.svg.get() {
      if value.width > 0.0 && value.height > 0.0 {
        return [1.0, value.width, value.height]
      }
    }
    let resource = node.resource
    if resource == 0 {
      return [0.0, 0.0, 0.0]
    }
    let state = self.sourceState(resource)
    if state != SOURCE_LOADED {
      return [u8.toF64(state), 0.0, 0.0]
    }
    if let Option<Resource>.Some { value } = self.resources.get(resource) {
      return match value {
        Resource.Image { width, height, .. } => [1.0, u32.toF64(width), u32.toF64(height)]
        Resource.Icon { icon } => {
          let w = self.resources.iconWidth(icon)
          let h = self.resources.iconHeight(icon)
          let ratio = self.resources.iconRatio(icon)
          let nw = if w > 0.0 { w } else if h > 0.0 && ratio > 0.0 { h * ratio } else { 300.0 }
          let nh = if h > 0.0 { h } else if ratio > 0.0 { nw / ratio } else { 150.0 }
          [1.0, nw, nh]
        }
      }
    }
    return [u8.toF64(state), 0.0, 0.0]
  }

  /// Premultiplied sRGB RGBA8 pixels of image/icon node `id` at its natural size, for Canvas 2D
  /// `drawImage(HTMLImageElement)` and `createImageBitmap(HTMLImageElement)`.
  pub effect fn imagePixels(self: &mut Self, id: u32) -> Option<DecodedImage>
    ! OutOfMemoryError
    ? &mut Allocator {
    let slot = self.slotOf(id)
    if slot == NONE {
      return Option<DecodedImage>.None
    }
    let resource = if self.node(slot).live { self.node(slot).resource } else { 0 }
    if resource == 0 {
      return Option<DecodedImage>.None
    }
    return run self.resources.resourcePixels(resource)
  }

  /// Queues the `Load` or `Error` record of node `slot`, if it listens.
  effect fn tellSource(self: &mut Self, slot: u32, ok: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let node = self.node(slot)
    let flag = if ok { LISTEN_LOAD } else { LISTEN_ERROR }
    if u32.bitAnd(node.listeners, flag) == 0 {
      return ()
    }
    let id = node.id
    let mut path = List<u32>.make()
    run self.pathTo(slot, &mut path)
    let kind = if ok { EventKind.Load } else { EventKind.Error }
    run self.queueEvent(Event.make(kind, id, move path))
  }

  /// The `LoadImage`, `LoadIcon`, `LoadFontFace` and `LoadFontStylesheet` requests since the
  /// last call, for the host to serve: it loads each URL and answers with `DefineImage` or
  /// `DefineIcon`, `loadFontFace` or `failFontFace`, and `declareHostFontFace` for each rule
  /// of a stylesheet. A face declared with a URL is asked for once text needs it.
  pub effect fn takeLoads(self: &mut Self) -> List<Mutation>
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.requestFontFaces()
    run self.requestCssImages()
    return Intrinsic.replace(self.loads, List<Mutation>.make())
  }

  /// Asks for the images stylesheets named in the last paints, once each.
  effect fn requestCssImages(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let images = self.resources.cssImages.asMutSlice()
    let mut i: usize = 0
    while i < images.length {
      if images[i].state == CssImageState.Wanted {
        images[i].state = CssImageState.Asked
        let resource = CSS_IMAGE_BASE + usize.toU32(i)
        let url = run String.copy(String.view(&images[i].url))
        if isSvgUrl(String.utf8Bytes(String.view(&url))) {
          run self.loads.append(Mutation.LoadIcon { resource: resource, url: move url })
        } else {
          run self.loads.append(Mutation.LoadImage { resource: resource, url: move url })
        }
      }
      i = i + 1
    }
  }

  /// The slot of node `id`, or NONE.
  pub fn slotOf(self: &Self, id: u32) -> u32 {
    return match self.ids.get(Word { value: u32.toU64(id) }) {
      Option<u32>.Some { value } => value
      Option<u32>.None => NONE
    }
  }

  /// Whether node `id` exists.
  pub fn contains(self: &Self, id: u32) -> bool {
    return self.slotOf(id) != NONE
  }

  pub fn node(self: &Self, slot: u32) -> &Node {
    return &self.nodes.asSlice()[u32.toUsize(slot)]
  }

  effect fn richDeclarations(self: &mut Self, declarations: List<Declaration>) -> List<Declaration>
    ! OutOfMemoryError ? &mut Allocator {
    let expanded = match move run expand.prepared(declarations.asSlice()) {
      Option.Some { value } => move value
      Option.None => move declarations
    }
    return match move run self.namedFamilies(expanded.asSlice()) {
      Option.Some { value } => move value
      Option.None => move expanded
    }
  }

  /// `declared` with each `font-family` written as CSS text (`Inter, sans-serif`) turned into
  /// the family list id the computed style reads, or None when none is written so.
  pub effect fn namedFamilies(self: &mut Self, declared: &[Declaration]) -> Option<List<Declaration>>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut found = false
    let mut i: usize = 0
    while i < declared.length {
      if writtenFamily(&declared[i]) || writtenVariations(&declared[i]) || writtenHandle(&declared[i]) {
        found = true
      }
      i = i + 1
    }
    if !found {
      return Option<List<Declaration>>.None
    }
    let mut out = List<Declaration>.make()
    i = 0
    while i < declared.length {
      if writtenFamily(&declared[i]) {
        let text = run values.cssText(&declared[i].value)
        match String.fromUtf8(Bytes.asSlice(&text)) {
          Result.Success { value: names } => {
            let id = run self.families.intern(names)
            run out.append(Declaration {
              property: CssProperty.FontFamily,
              value: values.number(u32.toF32(id)),
              important: declared[i].important,
            })
          }
          Result.Failure { error: _ } => {}
        }
      } else if writtenVariations(&declared[i]) {
        // Settings that do not parse are dropped, as CSS drops an invalid declaration.
        let text = run values.cssText(&declared[i].value)
        if let Option.Some { value: id } = run self.variations.intern(Bytes.asSlice(&text)) {
          run out.append(Declaration {
            property: CssProperty.FontVariationSettings,
            value: values.number(u32.toF32(id)),
            important: declared[i].important,
          })
        }
      } else if writtenHandle(&declared[i]) {
        // A negative number: font_features.apply reads -(handle + 1). Values that do not
        // parse are dropped.
        let text = run values.cssText(&declared[i].value)
        let css = Bytes.asSlice(&text)
        let property = declared[i].property
        let handle = if property == CssProperty.FontPalette {
          run self.fontRules.paletteHandle(css)
        } else if property == CssProperty.FontVariantAlternates {
          run self.fontRules.alternatesHandle(css)
        } else {
          run self.fontRules.adjustHandle(css)
        }
        if let Option.Some { value: id } = handle {
          run out.append(Declaration {
            property: property,
            value: values.number(-u32.toF32(id) - 1.0),
            important: declared[i].important,
          })
        }
      } else {
        run out.append(run values.cloneDeclaration(&declared[i]))
      }
      i = i + 1
    }
    return Option<List<Declaration>>.Some { value: move out }
  }

  effect fn resolveGrid(self: &mut Self, slot: u32, computed: &Computed) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let node = self.node(slot)
    let mut declarations = List<Declaration>.make()
    if let Option.Some { value } = node.sheetStyle() {
      run appendGrid(&mut declarations, value.declarations.asSlice())
      run appendGrid(&mut declarations, value.overrides.asSlice())
    } else {
      if !node.gridDeclared && !node.gridStyled && self.overrides.length() == 0 { return () }
      let states = [StyleState.Base, StyleState.Hover, StyleState.Active, StyleState.Focus, StyleState.FocusVisible]
      let mut i: usize = 0
      while i < states.length {
        let state = states[i]
        if style_sheets.active(&self, slot, state) {
          let list = match state {
            StyleState.Hover => node.hover()
            StyleState.Active => node.active()
            StyleState.Focus => node.focus()
            StyleState.FocusVisible => node.focusVisible()
            _ => node.base.asSlice()
          }
          let replace = match self.overrideOf(node.id, state) { Option.Some { value } => value.replace _ => false }
          if node.gridDeclared && !replace { run appendGrid(&mut declarations, list) }
        }
        i = i + 1
      }
      i = 0
      while i < states.length {
        if style_sheets.active(&self, slot, states[i]) {
          if let Option.Some { value } = self.overrideOf(node.id, states[i]) { run appendGrid(&mut declarations, value.declarations.asSlice()) }
        }
        i = i + 1
      }
    }
    let styled = declarations.length() != 0
    if !styled && !node.gridStyled { return () }
    let css = node.css
    let was = node.gridStyled
    let grid = run grid_css.gridOfWith(declarations.asSlice(), &font_units.context(&self, slot, computed, node.fontKey))
    let before = self.layout.revision()
    run Effect.catchAll(self.layout.installGrid(move grid, NodeId { index: css }), layoutFailed)
    let target = self.nodeMut(slot)
    target.gridStyled = styled
    // The grid the node already had changes nothing to paint.
    if was != styled || self.layout.revision() != before {
      self.paintDirty = true
    }
  }

  /// Asks for a style pass that matches every node again; `cause` counts who asked
  /// (`Work.dirtyCauses`).
  pub fn markStylesDirty(self: &mut Self, cause: usize) -> () {
    if !self.stylesDirty && cause < 32 { self.work.dirtyCauses[cause] = self.work.dirtyCauses[cause] + 1 }
    self.stylesDirty = true
  }

  pub fn restyle(self: &mut Self, slot: u32) -> () { self.restyleFor(slot, 3) }

  /// `restyle`, counting the root restyle under `cause`.
  fn restyleFor(self: &mut Self, slot: u32, cause: usize) -> () {
    if self.styleSheets.length() != 0 {
      let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
      if at != usize.MAX && (self.styleSheets.asSlice()[at].sheets.length() != 0 || self.styleSheets.asSlice()[at].inlineVariables) {
        if !self.stylesDirty { self.work.rootRestyles = self.work.rootRestyles + 1 }
        self.markStylesDirty(cause)
      }
    }
    self.restyleLocal(slot)
  }

  /// The node at `slot` shows another moment of an animation or transition: it applies its
  /// declarations again, with the match and the variables it has.
  pub fn restyleTick(self: &mut Self, slot: u32) -> () {
    let clean = !self.node(slot).styleDirty
    self.restyleLocal(slot)
    if clean {
      let nodes = self.nodes.asMutSlice()
      nodes[u32.toUsize(slot)].styleTick = true
    }
  }

  // Callers must rule out selector changes outside this subtree and changed variable inputs.
  pub fn restyleLocal(self: &mut Self, slot: u32) -> () {
    self.markStyle(slot, true)
  }

  /// Resolves the node at `slot` again, and below it only the children whose inherited values,
  /// variables or explicitly inherited properties change: what changed reaches no selector of
  /// another element.
  pub fn restyleSelf(self: &mut Self, slot: u32) -> () {
    self.markStyle(slot, false)
  }

  /// Gives up the share classes below `slot` (`Node.styleClass`).
  effect fn forgetShares(self: &mut Self, slot: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut stack = List<usize>.make()
    run stack.append(self.layout.firstChild(self.node(slot).css))
    while stack.length() != 0 {
      let last = stack.length() - 1
      let css = stack.get(last)
      stack.truncate(last)
      if css == NO_INDEX { continue }
      run stack.append(self.layout.nextSibling(css))
      let found = self.slotOfCssNode(css)
      if found != NONE {
        let shared = self.nodeMut(found)
        shared.styleClass = 0
      }
      run stack.append(self.layout.firstChild(css))
    }
  }

  fn markStyle(self: &mut Self, slot: u32, subtree: bool) -> () {
    self.stylesPending = true
    let nodes = self.nodes.asMutSlice()
    nodes[u32.toUsize(slot)].styleDirty = true
    nodes[u32.toUsize(slot)].styleTick = false
    if subtree { nodes[u32.toUsize(slot)].styleSubtree = true }
    let mut up = nodes[u32.toUsize(slot)].parent
    while up != NONE {
      let at = u32.toUsize(up)
      if nodes[at].subtreeDirty {
        return ()
      }
      nodes[at].subtreeDirty = true
      up = nodes[at].parent
    }
  }

  fn classReach(self: &Self, slot: u32, after: &[usize]) -> Extent {
    let subtree = Extent.of(Reach.Subtree)
    if self.stylesDirty || self.styleSheets.length() == 0 { return subtree }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX { return subtree }
    let sheets = &self.styleSheets.asSlice()[at]
    let before = match self.node(slot).identity() { Option.Some { value } => value.classAtoms() _ => &[] }
    // Generated content can read the class with attr().
    let least = if sheets.hasGenerated { Extent.itself() } else { Extent.none() }
    return sheets.invalidation.classReach(before, after, least)
  }

  /// Restyles the subtree of `slot`'s parent, which holds every sibling a selector can relate it to.
  fn restyleSiblings(self: &mut Self, slot: u32) -> () {
    let parent = self.node(slot).parent
    self.restyleLocal(if parent == NONE { slot } else { parent })
  }

  /// The relations the current root's sheets read, or None when it resolves no sheet styles or
  /// a root restyle is already due.
  fn sheetReads(self: &Self) -> Option<u32> {
    if self.stylesDirty || self.styleSheets.length() == 0 { return Option<u32>.None }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX || (self.styleSheets.asSlice()[at].sheets.length() == 0 && !self.styleSheets.asSlice()[at].inlineVariables) { return Option<u32>.None }
    return Option<u32>.some(self.styleSheets.asSlice()[at].reads)
  }

  /// Restyles what a change in `parent`'s child list reaches besides the child itself, given the
  /// element siblings on either side of the place it entered or left. A text child is `text`.
  fn restyleAround(self: &mut Self, reads: u32, parent: u32, previous: u32, next: u32, text: bool) -> () {
    let has = u32.bitAnd(reads, css_selectors.READS_DESCENDANTS) != 0
    if text {
      if u32.bitAnd(reads, css_selectors.READS_EMPTY) != 0 {
        self.restyleLocal(parent)
        // `:has(:empty)` above the parent, whose emptiness changed.
        if has {
          let above = self.node(parent).parent
          let beside = self.elementBeside(parent, true)
          self.restyleAnchors(above, beside)
        }
      }
      return ()
    }
    if has { self.restyleAnchors(parent, previous) }
    // With no element on either side the parent may have been empty, or be so now.
    if u32.bitAnd(reads, css_selectors.READS_EMPTY) != 0 && previous == NONE && next == NONE {
      self.restyleLocal(parent)
      return ()
    }
    if u32.bitAnd(reads, css_selectors.READS_INDEX | css_selectors.READS_SIBLINGS) != 0 {
      self.restylePlaceReaders(parent)
    }
    if u32.bitAnd(reads, css_selectors.READS_EDGE) != 0 {
      if previous != NONE { self.restyleLocal(previous) }
      if next != NONE { self.restyleLocal(next) }
    }
  }

  /// Restyles the nodes below `parent` whose match read the place of a child of `parent` among
  /// its siblings: `+`, `~`, `:nth-*()` and the `*-of-type` classes. Each node's record says
  /// what its own match read (`Resolved.reads`): a child of `parent` that read its own place,
  /// and a node further down that read an ancestor's. A node with a pseudo-element whose match
  /// read a place restyles too (`WATCH_PSEUDO_PLACE`). The other nodes matched without asking,
  /// so a child that enters or leaves cannot change their styles.
  ///
  /// One walk serves every change to the same child list until styles resolve next: it marks
  /// each reader there is, and a child that enters after it is restyled as new.
  fn restylePlaceReaders(self: &mut Self, parent: u32) -> () {
    let above = self.node(parent)
    if above.styleDirty && above.styleSubtree { return () }
    let key = u64.bitOr(u64.shiftLeft(u32.toU64(parent), 32), u32.toU64(above.id))
    let top = above.css
    if self.placeTick != self.work.styleCalls {
      self.placeTick = self.work.styleCalls
      self.placeCount = 0
    }
    let mut seen: usize = 0
    while seen < self.placeCount {
      if self.placeWalked[seen] == key { return () }
      seen = seen + 1
    }
    if self.placeCount < 8 {
      self.placeWalked[self.placeCount] = key
      self.placeCount = self.placeCount + 1
    }
    let own = css_selectors.READS_INDEX | css_selectors.READS_SIBLINGS
    let up = u32.shiftLeft(own, css_selectors.READS_ABOVE)
    let mut css = self.layout.firstChild(top)
    let mut depth: usize = 1
    while css != NO_INDEX {
      let slot = self.slotOfCssNode(css)
      let mut enter = false
      if slot != NONE {
        let node = self.node(slot)
        // A subtree that restyles whole asks nothing more.
        if !(node.styleDirty && node.styleSubtree) {
          enter = true
          if !node.styleDirty {
            let read = match node.sheetStyle() { Option.Some { value } => value.reads _ => 0 }
            if u32.bitAnd(read, if depth == 1 { own } else { up }) != 0 || u32.bitAnd(node.styleWatch, WATCH_PSEUDO_PLACE) != 0 {
              self.restyleSelf(slot)
            }
          }
        }
      }
      let child = if enter { self.layout.firstChild(css) } else { NO_INDEX }
      if child != NO_INDEX {
        css = child
        depth = depth + 1
        continue
      }
      while true {
        let beside = self.layout.nextSibling(css)
        if beside != NO_INDEX {
          css = beside
          break
        }
        css = self.layout.parent(css)
        depth = depth - 1
        if depth == 0 {
          css = NO_INDEX
          break
        }
      }
    }
  }

  /// Restyles the `:has()` anchors that can see a change in `parent`'s child list after the
  /// element `previous` (NONE for the start): `parent` and its ancestors, which hold the place
  /// in their subtrees, and, for arguments that start with `+` or `~`, the elements before it
  /// and before each ancestor. Only nodes a match asked `:has()` of are anchors
  /// (`Node.styleWatch`); what follows from an anchor's match lies in its subtree, or in its
  /// parent's when a `:has()` rule also relates siblings.
  fn restyleAnchors(self: &mut Self, parent: u32, previous: u32) -> () {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX || self.stylesDirty { return () }
    let sheets = &self.styleSheets.asSlice()[at]
    let wide = sheets.states.wide
    let siblings = sheets.siblingAnchors
    let mut before = previous
    let mut up = parent
    while true {
      while siblings && before != NONE {
        if u32.bitAnd(self.node(before).styleWatch, css_element.WATCH_HAS_SIBLINGS) != 0 { self.restyleAnchor(before, wide) }
        before = self.elementBeside(before, true)
      }
      if up == NONE { break }
      if u32.bitAnd(self.node(up).styleWatch, css_element.WATCH_HAS) != 0 { self.restyleAnchor(up, wide) }
      before = if siblings { self.elementBeside(up, true) } else { NONE }
      up = self.node(up).parent
    }
  }

  /// Restyles a `:has()` anchor whose argument may have changed: itself when only its own match
  /// asked, else what other matches could read it from, below it or, when `wide`, beside it.
  fn restyleAnchor(self: &mut Self, slot: u32, wide: bool) -> () {
    self.restyleSelf(slot)
    if u32.bitAnd(self.node(slot).styleWatch, WATCH_HAS_FOR_OTHERS) == 0 { return () }
    // Another node's match that read this anchor's `:has()` asked a node its record does not
    // place, and says so (`WATCH_OUTSIDE`).
    let parent = self.node(slot).parent
    self.restyleOutside(if wide && parent != NONE { parent } else { slot }, NONE)
  }

  /// Restyles the elements below `top` whose own match asked a node their record does not place
  /// (`WATCH_OUTSIDE`), leaving out the subtree of `done`.
  fn restyleOutside(self: &mut Self, top: u32, done: u32) -> () {
    let root = u32.toUsize(top)
    let mut at = self.elementAfter(root, root, true)
    while at != css_element.NO_ELEMENT {
      let down = usize.toU32(at) != done
      if down && u32.bitAnd(self.node(usize.toU32(at)).styleWatch, WATCH_OUTSIDE) != 0 { self.restyleSelf(usize.toU32(at)) }
      at = self.elementAfter(at, root, down)
    }
  }

  /// The first element child of `at`, or its next element sibling.
  fn elementLink(self: &Self, at: usize, child: bool) -> usize {
    let adapter = SelectorTree { tree: self }
    return if child { ElementTree.firstChild(&adapter, at) } else { ElementTree.nextSibling(&adapter, at) }
  }

  fn restyleRadioGroup(self: &mut Self, slot: u32) -> () {
    let parent = self.node(slot).parent
    if parent == NONE { return }
    let mut at = self.elementLink(u32.toUsize(parent), true)
    while at != css_element.NO_ELEMENT {
      let next = self.elementLink(at, false)
      let sibling = usize.toU32(at)
      if sibling != slot && self.node(sibling).accessRole == Role.Radio {
        let extent = self.stateReach(sibling, css_element.INDETERMINATE)
        self.restyleExtent(sibling, extent)
      }
      at = next
    }
  }

  fn selectorStates(self: &Self, slot: u32) -> u32 {
    let adapter = SelectorTree { tree: self }
    return adapter.state(u32.toUsize(slot)).bits
  }

  /// What rules that read one of the attributes `names` reach from a node that changed it; an
  /// empty name is skipped. `ids` are the node's id before and after when `id` is among them.
  fn attributeReach(self: &Self, names: &[&[u8]], ids: &[&[u8]]) -> Extent {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX { return Extent.none() }
    let sheets = &self.styleSheets.asSlice()[at]
    // Generated content can read any attribute of its origin with attr().
    let mut least = if sheets.hasGenerated { Extent.itself() } else { Extent.none() }
    let mut any = false
    let mut i: usize = 0
    while i < names.length {
      if names[i].length != 0 { any = true }
      // `:lang()`, `:dir()` and `:link` are no invalidation key, but what they read inherits
      // down from the node: its subtree, its siblings' (combinators) and `:has()` above.
      if sheets.states.derived && (css_tokens.insensitive(names[i], b"lang") || css_tokens.insensitive(names[i], b"href")
        || css_tokens.insensitive(names[i], b"dir")) {
        let mut derived = Extent.of(Reach.Siblings)
        derived.anchors = true
        return derived
      }
      // HTML `dir` is a presentational hint for `direction` (inherited) and `unicode-bidi`.
      if css_tokens.insensitive(names[i], b"dir") {
        least = least.with(Extent.of(Reach.Subtree))
      }
      i = i + 1
    }
    if !any { return Extent.none() }
    if !sheets.states.attributes { return least }
    return least.with(sheets.invalidation.attributeReach(names, ids))
  }

  fn idReach(self: &Self, slot: u32, after: &[u8]) -> Extent {
    let before = match self.node(slot).identity() {
      Option.Some { value } => String.utf8Bytes(value.id())
      _ => b""
    }
    return self.attributeReach(&[b"id"], &[before, after])
  }

  /// Restyles what `change` at `slot` reaches.
  fn restyleExtent(self: &mut Self, slot: u32, change: Extent) -> () {
    if change.anchors {
      let above = self.node(slot).parent
      let beside = self.elementBeside(slot, true)
      self.restyleAnchors(above, beside)
    }
    match change.reach {
      Reach.None => { if change.own { self.restyleSelf(slot) } }
      Reach.Descendants => {
        if change.own { self.restyleSelf(slot) }
        self.restyleCarriers(slot, &change)
      }
      Reach.Subtree => self.restyleLocal(slot)
      Reach.Siblings => self.restyleSiblings(slot)
      Reach.Root => self.restyle(slot)
    }
  }

  fn markIconStyleDirty(self: &mut Self, slot: u32) -> () {
    let node = self.nodeMut(slot)
    if node.kind != NodeKind.Icon { return () }
    let mut isLive = false
    if let Option<&mut LiveSvg>.Some { value: svg } = node.svg.getMut() {
      svg.styleDirty = true
      isLive = true
    }
    if !isLive {
      self.resources.invalidateStyledIcon(slot)
    }
    self.svgStylesPending = true
  }

  /// Restyles the elements below `slot` that carry one of `change.keys`: the subjects a
  /// selector that tests `slot` in an ancestor compound can match.
  fn restyleCarriers(self: &mut Self, slot: u32, change: &Extent) -> () {
    let root = u32.toUsize(slot)
    let mut at = self.elementAfter(root, root, true)
    while at != css_element.NO_ELEMENT {
      let s = usize.toU32(at)
      if self.node(s).kind == NodeKind.Icon { self.markIconStyleDirty(s) }
      if self.carries(s, change) { self.restyleSelf(s) }
      at = self.elementAfter(at, root, true)
    }
  }

  /// The element after `at` in document order within `root`'s subtree, entering `at`'s children
  /// when `down`, or NO_ELEMENT.
  fn elementAfter(self: &Self, at: usize, root: usize, down: bool) -> usize {
    let adapter = SelectorTree { tree: self }
    if down {
      let child = ElementTree.firstChild(&adapter, at)
      if child != css_element.NO_ELEMENT { return child }
    }
    let mut from = at
    while from != root && from != css_element.NO_ELEMENT {
      let next = ElementTree.nextSibling(&adapter, from)
      if next != css_element.NO_ELEMENT { return next }
      from = ElementTree.parent(&adapter, from)
    }
    return css_element.NO_ELEMENT
  }

  fn carries(self: &Self, slot: u32, change: &Extent) -> bool {
    let adapter = SelectorTree { tree: self }
    let node = self.node(slot)
    if change.states != 0 {
      let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
      if at == usize.MAX { return true }
      let subjects = &self.styleSheets.asSlice()[at].stateSubjects
      if u32.bitAnd(subjects.states(ancestor_filter.key(NameKind.Element, ElementTree.localName(&adapter, u32.toUsize(slot)))), change.states) != 0 { return true }
      if let Option.Some { value } = node.identity() {
        if value.hasId && u32.bitAnd(subjects.states(ancestor_filter.key(NameKind.Id, String.utf8Bytes(value.id()))), change.states) != 0 { return true }
        let atoms = value.classAtoms()
        let mut a: usize = 0
        while a < atoms.length {
          if u32.bitAnd(subjects.states(self.styleAtoms.filterKey(atoms[a])), change.states) != 0 { return true }
          a = a + 1
        }
      }
    }
    let mut i: u32 = 0
    while i < change.count {
      let key = change.keys[u32.toUsize(i)]
      if key == ancestor_filter.key(NameKind.Element, ElementTree.localName(&adapter, u32.toUsize(slot))) { return true }
      if let Option.Some { value } = node.identity() {
        if value.hasId && key == ancestor_filter.key(NameKind.Id, String.utf8Bytes(value.id())) { return true }
        let atoms = value.classAtoms()
        let mut a: usize = 0
        while a < atoms.length {
          if self.styleAtoms.filterKey(atoms[a]) == key { return true }
          a = a + 1
        }
      }
      i = i + 1
    }
    return false
  }

  /// Restyles the elements whose own match asked `slot` a pointer state: below it, those that
  /// recorded asking the ancestor that many levels up (`ASKED_UP_SHIFT`). When some match
  /// asked from further away (`far`, `WATCH_POINTER_FAR`), also those that asked a node their
  /// record does not place (`WATCH_OUTSIDE`), below it and, with `siblings`, when a rule
  /// relates the state to siblings, under its parent, where every sibling and its subtree lie.
  fn restyleAskers(self: &mut Self, slot: u32, far: bool, siblings: bool) -> () {
    let root = u32.toUsize(slot)
    let mut at = self.elementAfter(root, root, true)
    while at != css_element.NO_ELEMENT {
      let s = usize.toU32(at)
      if self.node(s).kind == NodeKind.Icon { self.markIconStyleDirty(s) }
      let watch = self.node(s).styleWatch
      let depth = self.depthAbove(s, slot)
      if (far && u32.bitAnd(watch, WATCH_OUTSIDE) != 0) || (depth != 0 && u32.bitAnd(watch, u32.shiftLeft(1, ASKED_UP_SHIFT + depth - 1)) != 0) {
        self.restyleSelf(s)
      }
      at = self.elementAfter(at, root, true)
    }
    let parent = self.node(slot).parent
    if far && siblings && parent != NONE { self.restyleOutside(parent, slot) }
  }

  /// What a change of the state bits `mask` on `slot` reaches. The node's own record names the
  /// states its candidate rules read.
  fn stateReach(self: &Self, slot: u32, mask: u32) -> Extent {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if mask == 0 || at == usize.MAX { return Extent.none() }
    let reach = &self.styleSheets.asSlice()[at].states
    let own = match self.node(slot).sheetStyle() { Option.Some { value } => value.states _ => 0 }
    let mut extent = Extent.of(if u32.bitAnd(reach.siblings, mask) != 0 { Reach.Siblings }
      else if u32.bitAnd(reach.descendants, mask) != 0 { Reach.Subtree }
      else { Reach.None })
    // Rules that test the state on an ancestor and whose subjects all carry a key restyle the
    // descendants with one of those keys, not the subtree.
    if extent.reach == Reach.Subtree && u32.bitAnd(self.styleSheets.asSlice()[at].stateSubjects.open, mask) == 0 {
      extent = Extent.subjects(u32.bitAnd(reach.descendants, mask))
      // The element resolves too: its new share class tells its descendants apart from those
      // of an equal element in the other state.
      extent.own = true
    }
    extent.own = extent.own || u32.bitAnd(own, mask) != 0
    extent.anchors = u32.bitAnd(reach.has, mask) != 0
    return extent
  }

  /// Restyles the nodes whose `:focus-within` changes when focus moves from `from` to `to`
  /// (either may be NONE): each one's ancestors, and itself, that do not hold the other. Only
  /// nodes a match asked `:focus-within` of can change style.
  fn focusWithinMoved(self: &mut Self, from: u32, to: u32) -> () {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX || self.stylesDirty { return () }
    let sheets = &self.styleSheets.asSlice()[at]
    if u32.bitAnd(sheets.states.any, css_element.FOCUS_WITHIN) == 0 { return () }
    let siblings = u32.bitAnd(sheets.states.siblings, css_element.FOCUS_WITHIN) != 0
    let descendants = u32.bitAnd(sheets.states.descendants, css_element.FOCUS_WITHIN) != 0
    let open = u32.bitAnd(sheets.stateSubjects.open, css_element.FOCUS_WITHIN) != 0
    let mut side: usize = 0
    while side < 2 {
      let other = if side == 0 { to } else { from }
      let mut up = if side == 0 { from } else { to }
      while up != NONE && !(other != NONE && self.within(other, up)) {
        if u32.bitAnd(self.node(up).styleWatch, css_element.WATCH_FOCUS_WITHIN) != 0 {
          if siblings { self.restyleSiblings(up) }
          else if descendants && open { self.restyleLocal(up) }
          else if descendants {
            let mut change = Extent.subjects(css_element.FOCUS_WITHIN)
            change.own = true
            self.restyleExtent(up, change)
          }
          else { self.restyleSelf(up) }
        }
        up = self.node(up).parent
      }
      side = side + 1
    }
  }

  fn elementBeside(self: &Self, slot: u32, backwards: bool) -> u32 {
    let adapter = SelectorTree { tree: self }
    let found = if backwards { adapter.previousSibling(u32.toUsize(slot)) } else { adapter.nextSibling(u32.toUsize(slot)) }
    return if found == css_element.NO_ELEMENT { NONE } else { usize.toU32(found) }
  }

  /// Focus looks apply to the focused node alone; sheet rules can carry focus further.
  pub fn focusStyleChanged(self: &mut Self, slot: u32) -> () {
    if self.sheetReads().isNone() { self.restyle(slot)
      return () }
    let mut change = self.stateReach(slot, css_element.FOCUS | css_element.FOCUS_VISIBLE)
    // `:has(:focus-within)` anchors lie above the node as those of `:has(:focus)` do.
    if self.stateReach(slot, css_element.FOCUS_WITHIN).anchors { change.anchors = true }
    change.own = true
    self.restyleExtent(slot, change)
  }

  pub fn pointerStyleChanged(self: &mut Self, slot: u32, state: StyleState, inline: bool) -> () {
    if self.stylesDirty { self.restyleLocal(slot)
      return () }
    let node = self.node(slot)
    if node.kind == NodeKind.Text && !inline { return () }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX || (self.styleSheets.asSlice()[at].sheets.length() == 0 && !self.styleSheets.asSlice()[at].inlineVariables) {
      if inline { self.restyleLocal(slot) }
      return ()
    }
    let mut custom = false
    if let Option.Some { value } = node.identity() {
      let mut i: usize = 0
      while i < value.custom().length {
        if value.custom()[i].state == state { custom = true }
        i = i + 1
      }
    }
    let mask = if state == StyleState.Hover { css_element.HOVER } else { css_element.ACTIVE }
    let mut change = self.stateReach(slot, mask)
    // A press flips the state of every ancestor up to the root: only those some other node's
    // match asked about can change what their subtree or siblings compute.
    let asked = if state == StyleState.Hover { css_element.WATCH_HOVER } else { css_element.WATCH_ACTIVE }
    // A match that tested this element's state from a sibling, from under one or from a
    // `:has()` anchor watched it and said so (`WATCH_POINTER_FAR`), unless it watched more
    // than it could record.
    let far = u32.bitAnd(node.styleWatch, WATCH_POINTER_FAR) != 0 || self.styleSheets.asSlice()[at].watchOverflowed
    if !far { change.anchors = false }
    if u32.bitAnd(node.styleWatch, asked) == 0 {
      change.reach = Reach.None
      change.own = match node.sheetStyle() { Option.Some { value } => u32.bitAnd(value.states, mask) != 0 _ => false }
    } else if !inline && !custom && change.reach != Reach.None && change.reach != Reach.Root {
      // The matches that asked are known: each node records the ancestors it asked a pointer
      // state of, or that it asked a node elsewhere. Only those can compute another style.
      self.restyleAskers(slot, far, change.reach == Reach.Siblings)
      change.reach = Reach.None
      // Its new share class tells its descendants apart from those of an equal element in
      // the other state.
      change.own = true
    }
    // The node's own looks and variables change what it and its subtree compute, no selector.
    if inline || custom { change.reach = style_invalidation.wider(change.reach, Reach.Subtree) }
    self.restyleExtent(slot, change)
  }

  pub fn nodeMut(self: &mut Self, slot: u32) -> &mut Node {
    return &mut self.nodes.asMutSlice()[u32.toUsize(slot)]
  }

  /// The slot of css-layout node `index`, or NONE.
  pub fn slotOfCssNode(self: &Self, index: usize) -> u32 {
    if index < self.slotOfCss.length() {
      return self.slotOfCss.get(index)
    }
    return NONE
  }

  /// Maps css-layout node `index`, one the tree made for itself, to no slot.
  pub effect fn forgetCss(self: &mut Self, index: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.mapCss(index, NONE)
  }

  effect fn mapCss(self: &mut Self, index: usize, slot: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while self.slotOfCss.length() <= index {
      run self.slotOfCss.append(NONE)
    }
    self.slotOfCss.set(index, slot)
  }

  /// Returns the items a virtual container needs mounted after the latest configuration or frame.
  /// Clients reconcile this range with ordinary node mutations, then call `frame` again.
  pub fn virtualRange(self: &Self, id: u32) -> Option<VirtualRange> {
    return virtual.request(&self, id)
  }

  /// Complete ordered mount request, including independent accessibility pins.
  pub effect fn virtualIndices(self: &Self, id: u32) -> List<usize>
    ! OutOfMemoryError ? &mut Allocator {
    let mut indices = List<usize>.make()
    if let Option.Some { value: range } = self.virtualRange(id) {
      let active = run self.activeVirtualTarget()
      let mut at = range.first
      let mut v: usize = 0
      while v < self.virtualLists.length() {
        let list = &self.virtualLists.asSlice()[v]
        v = v + 1
        if list.port != id { continue }
        let mut r: usize = 0
        while r < list.rows.length() {
          let row = list.rows.get(r)
          r = r + 1
          if row.index >= range.count || (row.index >= range.first && row.index < range.end) { continue }
          let slot = self.slotOf(row.id)
          if slot == NONE || !self.retainsVirtual(slot, active) { continue }
          if row.index >= range.end {
            while at < range.end { run indices.append(at) at = at + 1 }
          }
          run indices.append(row.index)
        }
      }
      while at < range.end { run indices.append(at) at = at + 1 }
    }
    return move indices
  }

  /// A host only needs to cross into its frontend when the requested rows differ from the bindings.
  pub effect fn changedVirtualIndices(self: &Self, at: usize) -> Option<List<usize>>
    ! OutOfMemoryError ? &mut Allocator {
    let list = &self.virtualLists.asSlice()[at]
    let slot = self.slotOf(list.port)
    if slot == NONE || !self.holdsCurrent(slot) { return Option.None }
    let wanted = run self.virtualIndices(list.port)
    let mut i: usize = 0
    while i < wanted.length() && i < list.rows.length() && wanted.get(i) == list.rows.get(i).index { i = i + 1 }
    if i == wanted.length() && i == list.rows.length() { return Option.None }
    return Option.Some { value: move wanted }
  }

  effect fn activeVirtualTarget(self: &Self) -> u32 ! OutOfMemoryError ? &mut Allocator {
    if self.focused == NONE { return NONE }
    if let Option.Some { value } = self.node(self.focused).semanticsOf() {
      if let Option.Some { value: ids } = move run style_relations.literal(self, self.focused, "aria-activedescendant") {
        return if ids.length() == 0 { NONE } else { self.slotOf(ids.get(0)) }
      }
      if value.activeDescendant.length() != 0 { return self.slotOf(value.activeDescendant.get(0)) }
    }
    return NONE
  }

  fn retainsVirtual(self: &Self, row: u32, active: u32) -> bool {
    return self.within(self.focused, row) || self.within(active, row) || self.within(self.slotOf(self.browseCursor), row)
  }

  /// The number of live nodes.
  pub fn nodeCount(self: &Self) -> usize {
    return self.ids.length()
  }

  /// The id of the root node, or NONE.
  pub fn rootId(self: &Self) -> u32 {
    if self.root == NONE {
      return NONE
    }
    return self.node(self.root).id
  }

  /// The children of `slot`, in order.
  pub effect fn childSlots(self: &Self, slot: u32, out: &mut List<u32>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    let css = self.node(slot).css
    let nodes = &self.layout
    let mut child = nodes.firstChild(css)
    while child != NO_INDEX {
      let found = self.slotOfCssNode(child)
      if found != NONE {
        run out.append(found)
      }
      child = nodes.nextSibling(child)
    }
  }

  // Mutations.

  /// Applies `batch` in order. On a bad mutation it stops and fails with its index; the
  /// mutations before it stay applied. A mutation about a node of another open root applies
  /// in that root (see `applyOne`); the root that was current is current again afterwards,
  /// unless the batch closed it.
  pub effect fn apply(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let _span = Prof.span("ui_tree.apply")
    let count = batch.length()
    Prof.set("mutations", &count)
    let before = self.current
    self.work.batches = self.work.batches + 1
    if self.laidOutCurrent() && !self.stylesDirty && !self.stylesPending {
      run scroll_anchor.select(&mut self)
    }
    run self.applyAll(move batch)
    run edit.reportSelection(&mut self)
    run text_selection.report(&mut self)
    if self.current != before && self.rootOpen(before) {
      drop run self.useRoot(before)
    }
    if self.sourceTells.length() > 0 {
      let tells = Intrinsic.replace(self.sourceTells, List<u32>.make())
      let ids = tells.asSlice()
      let mut i: usize = 0
      while i < ids.length {
        let slot = self.slotOf(ids[i])
        if slot != NONE {
          let state = self.sourceState(self.node(slot).resource)
          if state != SOURCE_PENDING {
            run self.tellSource(slot, state == SOURCE_LOADED)
          }
        }
        i = i + 1
      }
    }
  }

  effect fn applyAll(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut mutations = move batch
    let entries = mutations.asMutSlice()
    let mut index: usize = 0
    while index < entries.length {
      let value = Intrinsic.replace(entries[index], Mutation.Blur)
      if self.skipsStale {
        let applied = run Effect.result(self.applyOne(index, move value))
        match move applied {
          Result<(), TreeError | OutOfMemoryError>.Success { .. } => ()
          Result<(), TreeError | OutOfMemoryError>.Failure { error } => match move error {
            OutOfMemoryError failure => { fail move failure }
            TreeError failure => match failure {
              TreeError.UnknownNode { .. } => { self.staleSkipped = self.staleSkipped + 1 }
              _ => { fail failure }
            }
          }
        }
      } else {
        run self.applyOne(index, move value)
      }
      index = index + 1
    }
  }

  /// Applies one mutation; `index` is reported in errors. A mutation about a node of another
  /// open root makes that root current first, so what it changes is that root's to lay out and
  /// paint, and the current root's last frame still stands.
  pub effect fn applyOne(self: &mut Self, index: usize, mutation: Mutation) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    self.semanticRevision = self.semanticRevision + 1
    self.work.mutations = self.work.mutations + 1
    match &mutation {
      Mutation.Create { .. } => { self.work.creates = self.work.creates + 1 }
      Mutation.InsertBefore { .. } => { self.work.inserts = self.work.inserts + 1 }
      Mutation.SetStyle { declarations, .. } => {
        self.work.setStyles = self.work.setStyles + 1
        self.work.styleDeclarations = self.work.styleDeclarations + declarations.length()
      }
      Mutation.SetText { value, .. } => {
        self.work.setTexts = self.work.setTexts + 1
        self.work.textBytes = self.work.textBytes + String.byteLength(String.view(&value))
      }
      Mutation.SetAttribute { attribute, .. } => {
        self.work.attributes = self.work.attributes + 1
        match &attribute {
          Attribute.ClassName { value } => { self.work.attributeBytes = self.work.attributeBytes + String.byteLength(String.view(&value)) }
          Attribute.Named { name, .. } => { self.work.attributeBytes = self.work.attributeBytes + String.byteLength(String.view(&name)) }
          _ => {}
        }
      }
      Mutation.SetListeners { .. } => { self.work.listens = self.work.listens + 1 }
      _ => {}
    }
    let about = nodeOf(&mutation)
    let isVirtual = virtualOnly(&mutation)
    let mut bumpRevision = false
    if self.parked.length() == 0 {
      bumpRevision = true
    } else if about != NONE {
      // The change is the root's that holds the node; one to a detached node is nobody's yet.
      let slot = self.slotOf(about)
      if slot != NONE {
        let holder = self.rootOfTop(self.topOf(slot))
        if holder != NONE {
          drop run self.useRoot(holder)
          bumpRevision = true
        }
      }
    } else if reachesEveryRoot(&mutation) {
      self.changedEveryRoot()
    }
    if bumpRevision && !isVirtual {
      self.revision = self.revision + 1
    }
    // A scroll moves what is painted and changes none of it: the fragments' hashes and ink
    // stand, and `setOffset` says the frame scrolled. Virtual-list configure/bind report below
    // whether anything actually changed, so unchanged lists keep quiet frames and paint caches.
    if !scrollsOnly(&mutation) && !isVirtual {
      self.applied = true
      // What a mutation changes of the paint is its node's own, a restyle's, which says so
      // itself, or a layout's, which css-layout reports: the caches are repaired for those.
      // Any other mutation rebuilds them.
      if repaintsNode(&mutation) {
        let slot = if about == NONE { NONE } else { self.slotOf(about) }
        if slot != NONE {
          run self.repair.nodes.append(slot)
          self.repair.pending = true
        }
      } else {
        self.paintCachesStale = true
      }
    }
    match move mutation {
      Mutation.SetAnchor { id, target, options } => {
        run anchoring.configure(&mut self, index, id, target, options)
      }
      Mutation.ClearAnchor { id } => {
        anchoring.clear(&mut self, id)
      }
      Mutation.SetVirtualList { id, count, options } => {
        if run virtual.configure(&mut self, index, id, count, options) {
          if bumpRevision { self.revision = self.revision + 1 }
          self.applied = true
          self.paintCachesStale = true
        }
      }
      Mutation.SetVirtualItems { id, items } => {
        if run virtual.bind(&mut self, index, id, move items) {
          if bumpRevision { self.revision = self.revision + 1 }
          self.applied = true
          self.paintCachesStale = true
        }
      }
      Mutation.ClearVirtualList { id } => {
        run virtual.clear(&mut self, id)
      }
      Mutation.Create { id, kind } => {
        run self.create(index, id, kind)
      }
      Mutation.InsertBefore { parent, child, before } => {
        run self.insertBefore(index, parent, child, before)
      }
      Mutation.Remove { id } => {
        let slot = run self.require(index, id)
        run self.checkVirtualUnmount(index, slot)
        run self.detach(index, slot)
      }
      Mutation.Destroy { id } => {
        let slot = run self.require(index, id)
        run self.checkVirtualUnmount(index, slot)
        run self.destroy(index, slot)
      }
      Mutation.SetCustomProperty { id, state, name, value, important } => {
        let slot = run self.require(index, id)
        if !declaration_values.customName(String.utf8Bytes(String.view(&name))) { return () }
        let mut tokens = Option<TokenBuffer>.None
        if let Option<String>.Some { value: text } = move value {
          let parsed = run Effect.result(style_sheets.customValue(String.utf8Bytes(String.view(&text))))
          match move parsed {
            Result<Option<TokenBuffer>, CssError | OutOfMemoryError>.Success { value: buffer } => {
              if buffer.isNone() { return () }
              tokens = move buffer
            }
            Result<Option<TokenBuffer>, CssError | OutOfMemoryError>.Failure { error: why } => {
              match move why { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { fail TreeError.StyleSheet { index: index, root: self.current, sheet: 0 } } }
            }
          }
        }
        let node = self.nodeMut(slot)
        let identity = run node.identityMut()
        run identity.setCustom(state, move name, move tokens, important)
        run self.enableInlineScope()
        // The node's variable scope changes: it and what inherits from it, and no selector.
        self.restyleSelf(slot)
      }
      Mutation.SetStyle { id, state, declarations } => {
        let slot = run self.require(index, id)
        let prepared = run expand.prepared(declarations.asSlice())
        let expanded = match &prepared {
          Option.Some { value } => value.asSlice()
          Option.None => declarations.asSlice()
        }
        if style_sheets.needsScope(expanded) { run self.enableInlineScope() }
        let named = run self.namedFamilies(expanded)
        let values = match &named {
          Option.Some { value } => value.asSlice()
          Option.None => expanded
        }
        let node = self.nodeMut(slot)
        if grid_css.mentionsGrid(values) { node.gridDeclared = true }
        if !node.styleNeedsContext && style.requiresContext(values) { node.styleNeedsContext = true }
        let mut i: usize = 0
        while i < values.length {
          match state {
            StyleState.Base => {
              run css.set(&mut node.base, &values[i])
            }
            StyleState.Hover => {
              run css.set(&mut (run node.extrasMut()).hover, &values[i])
            }
            StyleState.Active => {
              run css.set(&mut (run node.extrasMut()).active, &values[i])
            }
            StyleState.Focus => {
              run css.set(&mut (run node.extrasMut()).focus, &values[i])
            }
            StyleState.FocusVisible => {
              run css.set(&mut (run node.extrasMut()).focusVisible, &values[i])
            }
            StyleState.Starting => {
              run css.set(&mut (run node.extrasMut()).starting, &values[i])
            }
          }
          i = i + 1
        }
        // A style object changes no selector input: only this node, and below it the children
        // whose inherited values or variables change (a row's `top` or a thumb's `transform`
        // restyles that node alone, not its subtree).
        self.restyleSelf(slot)
      }
      Mutation.ClearStyle { id, state } => {
        let slot = run self.require(index, id)
        let node = self.nodeMut(slot)
        if node.selectorIdentity.isSome() {
          let identity = run node.identityMut()
          identity.clearCustom(state)
        }
        match state {
          StyleState.Base => {
            node.base.clear()
          }
          StyleState.Hover => {
            if let Option.Some { value } = node.extrasHeld() { value.hover.clear() }
          }
          StyleState.Active => {
            if let Option.Some { value } = node.extrasHeld() { value.active.clear() }
          }
          StyleState.Focus => {
            if let Option.Some { value } = node.extrasHeld() { value.focus.clear() }
          }
          StyleState.FocusVisible => {
            if let Option.Some { value } = node.extrasHeld() { value.focusVisible.clear() }
          }
          StyleState.Starting => {
            if let Option.Some { value } = node.extrasHeld() { value.starting.clear() }
          }
        }
        node.gridDeclared = grid_css.mentionsGrid(node.base.asSlice()) || grid_css.mentionsGrid(node.hover())
          || grid_css.mentionsGrid(node.active()) || grid_css.mentionsGrid(node.focus()) || grid_css.mentionsGrid(node.focusVisible())
        node.styleNeedsContext = style.requiresContext(node.base.asSlice()) || style.requiresContext(node.hover())
          || style.requiresContext(node.active()) || style.requiresContext(node.focus())
          || style.requiresContext(node.focusVisible()) || style.requiresContext(node.starting())
        self.restyleSelf(slot)
      }
      Mutation.SetRichText { id, value, marks, atoms } => {
        let slot = run self.requireInput(index, id)
        run edit.setRich(&mut self, slot, move value, move marks, move atoms)
      }
      Mutation.DefineMark { id, mark, declarations } => {
        let slot = run self.requireInput(index, id)
        let prepared = run self.richDeclarations(move declarations)
        run edit.defineStyle(&mut self, slot, false, mark, move prepared)
      }
      Mutation.DefineAtom { id, kind, declarations } => {
        let slot = run self.requireInput(index, id)
        let prepared = run self.richDeclarations(move declarations)
        run edit.defineStyle(&mut self, slot, true, kind, move prepared)
      }
      Mutation.Format { id, mark, on } => {
        let slot = run self.requireInput(index, id)
        run edit.format(&mut self, slot, mark, on)
      }
      Mutation.InsertAtom { id, start, end, atom } => {
        let slot = run self.requireInput(index, id)
        run edit.insertAtom(&mut self, slot, start, end, move atom)
      }
      Mutation.SetText { id, value } => {
        let slot = run self.require(index, id)
        run self.setText(index, slot, move value)
      }
      Mutation.SetAttribute { id, attribute } => {
        let slot = run self.require(index, id)
        let classAtoms = match &attribute {
          Attribute.ClassName { value } => run self.styleAtoms.classes(String.utf8Bytes(String.view(&value)))
          _ => List<usize>.make()
        }
        // No selector outside a detached subtree can see it; attaching it restyles what the insert
        // reaches. Without sheets, or with a root restyle due, there is nothing to narrow.
        let attached = self.rootHolding(slot) != NONE
        let tracked = attached && self.sheetReads().isSome()
        let statesBefore = if tracked { self.selectorStates(slot) } else { 0 }
        let radioToggled = match &attribute {
          Attribute.Checked { .. } => self.node(slot).accessRole == Role.Radio
          _ => false
        }
        let mut change = if !tracked { Extent.of(Reach.Subtree) } else { match &attribute {
          Attribute.ClassName { .. } => self.classReach(slot, classAtoms.asSlice())
          Attribute.ElementId { value } => self.idReach(slot, String.utf8Bytes(String.view(&value)))
          // Type selectors are no invalidation key.
          Attribute.Element { .. } => Extent.of(Reach.Root)
          Attribute.Named { name, .. } => self.attributeReach(&[String.utf8Bytes(String.view(&name))], &[])
          _ => Extent.none()
        } }
        let reflected = run style_attributes.reflect(self.nodeMut(slot), &attribute)
        if tracked { change = change.with(self.attributeReach(&[String.utf8Bytes(reflected[0]), String.utf8Bytes(reflected[1]), String.utf8Bytes(reflected[2])], &[])) }
        let node = self.nodeMut(slot)
        match move attribute {
          Attribute.ValueRange { min, max, value } => {
            let rare = run node.rareMut()
            rare.hasValueRange = true
            rare.valueMin = min
            rare.valueMax = max
            rare.valueNow = value
            node.content = node.content + 1
            self.paintDirty = true
          }
          Attribute.ClearValueRange => {
            if let Option.Some { value: rare } = node.rare.getMut() { rare.hasValueRange = false }
            node.content = node.content + 1
            self.paintDirty = true
          }

          Attribute.Role { value } => {
            if node.accessRole != value {
              node.accessRole = value
              node.content = node.content + 1
              self.paintDirty = true
            }
          }
          Attribute.Label { value } => {
            if value.ownedByteLength() != 0 || node.rare.isSome() {
              let rare = run node.rareMut()
              rare.label = move value
            }
          }
          Attribute.TestId { value } => {
            // An empty id on a node without one changes nothing, and makes no extras.
            if value.ownedByteLength() != 0 || node.extras.isSome() {
              let extras = run node.extrasMut()
              extras.testId = move value
            }
          }
          Attribute.TabIndex { value } => {
            node.tabIndex = value
          }
          Attribute.Cursor { value } => {
            node.cursor = value
          }
          Attribute.Disabled { value } => {
            if node.disabled != value {
              let isGroup = match node.identity() {
                Option.Some { value: found } => found.tag() == "fieldset" || found.tag() == "optgroup"
                _ => false
              }
              node.disabled = value
              node.content = node.content + 1
              self.paintDirty = true
              if isGroup {
                self.restyleLocal(slot)
              }
            }
          }
          Attribute.Prevent { actions } => {
            node.prevents = actions
          }
          Attribute.FocusTrap { value } => {
            node.focusTrap = value
          }
          Attribute.Checked { value } => {
            if node.checked != value {
              node.checked = value
              node.content = node.content + 1
              self.paintDirty = true
            }
          }
          Attribute.Selected { value } => {
            node.selected = value
          }
          Attribute.Expanded { value } => {
            node.expanded = value
          }
          Attribute.Level { value } => {
            let semantics = run node.semanticsMut()
            semantics.level = value
          }
          Attribute.Description { value } => {
            let semantics = run node.semanticsMut()
            semantics.description = move value
          }
          Attribute.RoleDescription { value } => {
            let semantics = run node.semanticsMut()
            semantics.roleDescription = move value
          }
          Attribute.ValueText { value } => {
            let semantics = run node.semanticsMut()
            semantics.valueText = move value
          }
          Attribute.Hidden { value } => {
            let semantics = run node.semanticsMut()
            semantics.hidden = value
          }
          Attribute.Live { value } => {
            let semantics = run node.semanticsMut()
            semantics.live = value
          }
          Attribute.Atomic { value } => {
            let semantics = run node.semanticsMut()
            semantics.atomic = value
          }
          Attribute.Busy { value } => {
            let semantics = run node.semanticsMut()
            semantics.busy = value
          }
          Attribute.Pressed { value } => {
            let semantics = run node.semanticsMut()
            semantics.pressed = value
          }
          Attribute.Indeterminate { value } => {
            let semantics = run node.semanticsMut()
            if semantics.indeterminate != value {
              semantics.indeterminate = value
              node.content = node.content + 1
              self.paintDirty = true
            }
          }
          Attribute.Required { value } => {
            let semantics = run node.semanticsMut()
            semantics.required = value
          }
          Attribute.Invalid { value } => {
            let semantics = run node.semanticsMut()
            semantics.invalid = value
          }
          Attribute.MultiSelectable { value } => {
            let semantics = run node.semanticsMut()
            semantics.multiSelectable = value
          }
          Attribute.Orientation { value } => {
            let semantics = run node.semanticsMut()
            semantics.orientation = value
          }
          Attribute.PosInSet { value } => {
            let semantics = run node.semanticsMut()
            semantics.posInSet = value
          }
          Attribute.SetSize { value } => {
            let semantics = run node.semanticsMut()
            semantics.setSize = value
          }
          Attribute.Modal { value } => {
            let semantics = run node.semanticsMut()
            semantics.modal = value
          }
          Attribute.Inert { value } => {
            if node.inert != value {
              node.inert = value
              self.inerts = if value { self.inerts + 1 } else { self.inerts - 1 }
              self.semanticRevision = self.semanticRevision + 1
              // As in a browser, a focused node that becomes inert loses focus.
              if value && self.focused != NONE && self.within(self.focused, slot) {
                run self.moveFocus(NONE, false)
              }
            }
          }
          Attribute.Multiline { value } => {
            run node.ensureEdit()
            let edited = node.editMut()
            edited.multiline = value
            let isInput = node.kind == NodeKind.Input
            // Single or multiple lines change the input's own display, nothing a selector reads.
            self.restyleLocal(slot)
            if isInput {
              run edit.syncDisplay(&mut self, slot)
            }
          }
          Attribute.ReadOnly { value } => {
            run node.ensureEdit()
            let edited = node.editMut()
            edited.readOnly = value
            node.content = node.content + 1
            self.paintDirty = true
          }
          Attribute.Placeholder { value } => {
            run node.ensureEdit()
            let edited = node.editMut()
            edited.placeholder = move value
            let isInput = node.kind == NodeKind.Input
            if isInput {
              run edit.syncDisplay(&mut self, slot)
            }
          }
          Attribute.Href { value } => {
            // The client follows its links; the tree draws nothing for them.
            drop value
          }
          Attribute.Transition { value } => {
            if value.ownedByteLength() != 0 || node.extras.isSome() {
              let extras = run node.extrasMut()
              extras.transition = move value
            }
            // Transitions are the node's own: no selector or descendant reads them.
            self.restyleLocal(slot)
          }
          Attribute.LabelledBy { ids } => {
            let semantics = run node.semanticsMut()
            semantics.literalRelations = semantics.literalRelations & 14
            semantics.labelledBy = move ids
          }
          Attribute.DescribedBy { ids } => {
            let semantics = run node.semanticsMut()
            semantics.literalRelations = semantics.literalRelations & 13
            semantics.describedBy = move ids
          }
          Attribute.Controls { ids } => {
            let semantics = run node.semanticsMut()
            semantics.literalRelations = semantics.literalRelations & 11
            semantics.controls = move ids
          }
          Attribute.ActiveDescendant { ids } => {
            let semantics = run node.semanticsMut()
            semantics.literalRelations = semantics.literalRelations & 7
            semantics.activeDescendant = move ids
          }
          Attribute.Element { name } => {
            // Document backends make the element; the tree takes its implicit role, which
            // a `Role` attribute set before or after replaces.
            let tag = String.utf8Bytes(String.view(&name))
            if node.accessRole == Role.None {
              node.accessRole = implicitRole(tag)
            }
            let level = implicitLevel(tag)
            if level != 0 {
              let semantics = run node.semanticsMut()
              if semantics.level == 0 {
                semantics.level = level
              }
            }
            let classes = match node.identity() { Option.Some { value } => run String.copy(value.classes()) _ => String.make() }
            let mut atoms = List<usize>.make()
            if let Option.Some { value } = node.identity() { run atoms.appendSlice(value.classAtoms()) }
            let key = run self.selectorKeys.intern(String.view(&name), String.view(&classes), atoms.asSlice())
            let identity = run self.nodeMut(slot).identityMut()
            identity.key = move key
            if self.listsUsed { self.listsDirty = true }
          }
          Attribute.Named { name, value } => {
            if !isNamedAttribute(String.view(&name)) { return () }
            if self.listsUsed && (String.view(&name) == "start" || String.view(&name) == "value") {
              self.stylesPending = true
              self.listsDirty = true
            }
            let words = match &value { Option<String>.Some { value: text } => String.view(&text) _ => "" }
            if String.view(&name) == "class" || String.view(&name) == "id" {
              let present = value.isSome()
              let isClass = String.view(&name) == "class"
              let mapped = if isClass { Attribute.ClassName { value: run String.copy(words) } }
                else { Attribute.ElementId { value: run String.copy(words) } }
              run self.applyOne(index, Mutation.SetAttribute { id: id, attribute: move mapped })
              let identity = run self.nodeMut(slot).identityMut()
              if isClass { identity.hasClasses = present } else { identity.hasId = present }
              return ()
            }
            let semantic = run style_attributes.semantic(String.view(&name), words)
            if String.view(&name) == "aria-checked" {
              run self.applyOne(index, Mutation.SetAttribute { id: id,
                attribute: Attribute.Indeterminate { value: words == "mixed" } })
            }
            if let Option<Attribute>.Some { value: mapped } = move semantic {
              run self.applyOne(index, Mutation.SetAttribute { id: id, attribute: move mapped })
            }
            let relation = style_attributes.relationBit(String.view(&name))
            if relation != 0 {
              let semantics = run self.nodeMut(slot).semanticsMut()
              semantics.literalRelations = semantics.literalRelations & (15 - relation)
              if value.isSome() { semantics.literalRelations = semantics.literalRelations | relation }
            }
            let range = style_attributes.isRange(String.view(&name))
            let span = style_attributes.isSpan(String.view(&name))
            let isType = String.view(&name) == "type"
            let isSelectLabel = String.view(&name) == "-silk-select-label"
            let isControlPaint = String.view(&name) == "-silk-color" || String.view(&name) == "-silk-meter-state" || isSelectLabel
            let identity = run self.nodeMut(slot).identityMut()
            run identity.set(move name, move value)
            if range { run style_attributes.syncRange(self.nodeMut(slot)) }
            if span { self.restyleFor(slot, 24) }
            if isType && self.node(slot).kind == NodeKind.Input && self.node(slot).hasEdit() {
              run edit.syncDisplay(&mut self, slot)
            }
            if isControlPaint {
              let n = self.nodeMut(slot)
              n.content = n.content + 1
              self.paintDirty = true
              if isSelectLabel { self.restyleSelf(slot) }
            }
          }
          Attribute.ClassName { value } => {
            let tag = match node.identity() { Option.Some { value: identity } => run String.copy(identity.tag()) _ => String.make() }
            let key = run self.selectorKeys.intern(String.view(&tag), String.view(&value), classAtoms.asSlice())
            let identity = run self.nodeMut(slot).identityMut()
            identity.key = move key
            identity.hasClasses = true
          }
          Attribute.ElementId { value } => {
            let identity = run node.identityMut()
            run identity.setId(move value)
          }
        }
        if tracked { change = change.with(self.stateReach(slot, u32.bitXor(statesBefore, self.selectorStates(slot)))) }
        self.restyleExtent(slot, change)
        // A radio's group is `:indeterminate` while none of it is checked.
        if tracked && radioToggled { self.restyleRadioGroup(slot) }
      }
      Mutation.SetSelection { id, anchor, focus } => {
        let slot = run self.require(index, id)
        if self.node(slot).kind != NodeKind.Input {
          fail TreeError.WrongKind { index: index, id: id }
        }
        run edit.setSelection(&mut self, slot, anchor, focus)
      }
      Mutation.SetListeners { id, flags } => {
        let slot = run self.require(index, id)
        let node = self.nodeMut(slot)
        if u32.bitAnd(node.listeners, LISTEN_LAYOUT) == 0 {
          if let Option.Some { value: rare } = node.rare.getMut() { rare.layoutReported = false }
        }
        let asksLayout = u32.bitAnd(node.listeners, LISTEN_LAYOUT) == 0 && u32.bitAnd(flags, LISTEN_LAYOUT) != 0
        node.listeners = flags
        self.layoutObserversDirty = true
        if asksLayout { run self.layoutListeners.append(slot) }
      }
      Mutation.OpenRoot { root, node, options } => {
        let slot = run self.require(index, node)
        let owner = self.rootHolding(slot)
        run self.openRoot(index, root, slot, move options)
        self.changedRoot(root)
        if owner != NONE && owner != root {
          self.touchRoot(owner)
        }
      }
      Mutation.UpdateRoot { root, options } => {
        self.changedRoot(root)
        if root == self.current {
          if self.currentOpen {
            self.currentOptions = move options
          }
        } else {
          let at = self.parkedIndex(root)
          if at != usize.MAX {
            let parked = self.parked.asMutSlice()
            parked[at].options = move options
          }
        }
      }
      Mutation.CloseRoot { root } => {
        run sheet_faces.close(&mut self, root)
        font_rules.close(&mut self.fontRules, root)
        run self.closeRoot(index, root)
        let at = style_sheets.index(self.styleSheets.asSlice(), root)
        if at != usize.MAX { drop self.styleSheets.remove(at) }
      }
      Mutation.LoadStyleSheet { root, sheet, source } => run self.requestStyleSheet(root, sheet, move source)
      Mutation.AdoptStyleSheet { root, sheet, bytes } => {
        run self.adoptSheet(index, root, sheet, bytes.asSlice(), false)
        self.cancelStyleLoad(root, sheet)
      }
      Mutation.ReplaceStyleSheet { root, sheet, bytes } => {
        run self.adoptSheet(index, root, sheet, bytes.asSlice(), true)
        self.cancelStyleLoad(root, sheet)
      }
      Mutation.SetStyleSheetOrder { root, sheets } => {
        let at = style_sheets.index(self.styleSheets.asSlice(), root)
        if !self.rootOpen(root) { fail TreeError.StyleSheet { index: index, root: root, sheet: 0 } }
        if at == usize.MAX {
          if sheets.length() == 0 { return () }
          fail TreeError.StyleSheet { index: index, root: root, sheet: 0 }
        }
        let roots = self.styleSheets.asMutSlice()
        let reordered = run Effect.result(roots[at].sheets.reorder(sheets.asSlice()))
        if let Result<(), AdoptionError | OutOfMemoryError>.Failure { error: why } = move reordered {
          match move why { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { fail TreeError.StyleSheet { index: index, root: root, sheet: 0 } } }
        }
        drop run self.useRoot(root)
        self.markStylesDirty(6)
      }
      Mutation.RemoveStyleSheet { root, sheet } => {
        self.cancelStyleLoad(root, sheet)
        if !self.rootOpen(root) { fail TreeError.StyleSheet { index: index, root: root, sheet: sheet } }
        let at = style_sheets.index(self.styleSheets.asSlice(), root)
        if at != usize.MAX {
          let roots = self.styleSheets.asMutSlice()
          if run roots[at].sheets.remove(sheet) {
            drop run self.useRoot(root)
            self.markStylesDirty(7)
          }
        }
      }
      Mutation.Focus { id } => {
        let slot = run self.require(index, id)
        run self.focusSlot(slot)
      }
      Mutation.Blur => {
        let keyed = self.keyTarget()
        drop run self.useRoot(keyed)
        run self.focusSlot(NONE)
      }
      Mutation.SetPointerCapture { id } => {
        let slot = run self.require(index, id)
        drop run interact.setCapture(&mut self, slot)
      }
      Mutation.ReleasePointerCapture => {
        run interact.releaseCapture(&mut self)
      }
      Mutation.ScrollTo { id, x, y } => {
        let slot = run self.require(index, id)
        self.viewScrollState.interruptTarget(
          ViewTarget { kind: ViewTargetKind.Element, id: u32.toUsize(id) },
        )
        run interact.scrollTo(&mut self, slot, x, y)
      }
      Mutation.ScrollIntoView { id } => {
        let slot = run self.require(index, id)
        run self.revealSlot(slot, id)
      }
      Mutation.SetGrid { id, value } => {
        let slot = run self.require(index, id)
        let css = self.node(slot).css
        let grid = Box<Grid>.into(move value)
        run Effect.catchAll(self.layout.installGrid(move grid, NodeId { index: css }), layoutFailed)
        let node = self.nodeMut(slot)
        node.gridStyled = false
        node.gridDeclared = false
        self.paintDirty = true
      }
      Mutation.SetSource { id, resource } => {
        let slot = run self.require(index, id)
        let kind = self.node(slot).kind
        if kind != NodeKind.Image && kind != NodeKind.Icon {
          fail TreeError.WrongKind { index: index, id: id }
        }
        match self.resources.get(resource) {
          Option<Resource>.Some { value } => {
            // An image shows an SVG file as an icon, as an `<img>` shows one.
            let matches = match value {
              Resource.Image { .. } => kind == NodeKind.Image
              Resource.Icon { .. } => true
            }
            if !matches {
              fail TreeError.WrongKind { index: index, id: id }
            }
          }
          // Not loaded yet: the node shows nothing until it is (see `Mutation.LoadImage`).
          Option<Resource>.None => {}
        }
        let node = self.nodeMut(slot)
        node.resource = resource
        node.content = node.content + 1
        if kind == NodeKind.Icon {
          self.resources.invalidateStyledIcon(slot)
          self.svgStylesPending = true
        }
        run self.updateNatural(slot)
        // A source that already settled still tells a new node, as an image from the cache
        // does on the web.
        // Told once the batch is applied, when the node is in place.
        if self.sourceState(resource) != SOURCE_PENDING {
          run self.sourceTells.append(id)
        }
      }
      Mutation.SetCanvas { id, commands } => {
        let slot = run self.require(index, id)
        if self.node(slot).kind != NodeKind.Canvas {
          fail TreeError.WrongKind { index: index, id: id }
        }
        let node = self.nodeMut(slot)
        if commands.length() != 0 || node.extras.isSome() {
          let extras = run node.extrasMut()
          extras.canvas = move commands
        }
        node.content = node.content + 1
      }
      Mutation.SetCanvasPixels { id, width, height, opaque, pixels } => {
        let slot = run self.require(index, id)
        if self.node(slot).kind != NodeKind.Canvas {
          fail TreeError.WrongKind { index: index, id: id }
        }
        run self.canvas2d.setPixels(id, width, height, opaque, move pixels)
      }
      Mutation.SetCanvasSurface { id, surface, width, height, opaque } => {
        let slot = run self.require(index, id)
        if self.node(slot).kind != NodeKind.Canvas {
          fail TreeError.WrongKind { index: index, id: id }
        }
        let node = self.nodeMut(slot)
        if surface != NO_SURFACE || node.extras.isSome() {
          let extras = run node.extrasMut()
          extras.surface = if surface == NO_SURFACE {
            CanvasSurface.none()
          } else {
            CanvasSurface { id: surface, width: width, height: height, opaque: opaque }
          }
        }
        node.content = node.content + 1
        run self.updateNatural(slot)
      }
      Mutation.SvgInsert { id, element, tag, parent, before } => {
        let slot = run self.requireSvg(index, id)
        let at = match before {
          Option<u32>.Some { value } => value
          _ => live_svg.NO_ELEMENT
        }
        let node = self.nodeMut(slot)
        let svg = run node.liveSvg()
        drop run svg.insert(element, String.utf8Bytes(String.view(&tag)), parent, at)
        svg.styleDirty = true
        node.content = node.content + 1
        self.svgStylesPending = true
      }
      Mutation.SvgRemove { id, element } => {
        let slot = run self.requireSvg(index, id)
        let node = self.nodeMut(slot)
        if element == 0 {
          node.svg.clear()
        } else if let Option<&mut LiveSvg>.Some { value } = node.svg.getMut() {
          drop value.remove(element)
          value.styleDirty = true
        }
        node.content = node.content + 1
        self.svgStylesPending = true
        run self.updateNatural(slot)
      }
      Mutation.SvgAttribute { id, element, name, value } => {
        let slot = run self.requireSvg(index, id)
        let node = self.nodeMut(slot)
        let svg = run node.liveSvg()
        let sized = element == 0 && (String.view(&name) == "width" || String.view(&name) == "height")
        match &value {
          Option<String>.Some { value: text } => {
            drop run svg.set(element, String.utf8Bytes(String.view(&name)), String.utf8Bytes(String.view(&text)), true)
          }
          _ => {
            drop run svg.set(element, String.utf8Bytes(String.view(&name)), b"", false)
          }
        }
        svg.styleDirty = true
        node.content = node.content + 1
        self.svgStylesPending = true
        if sized {
          run self.updateNatural(slot)
        }
      }
      Mutation.DefineFontFamily { family, names } => {
        run self.families.define(family, String.view(&names))

        // Keys made from the old list keep their faces; restyle so new keys are made.
        let entries = self.fontKeys.asMutSlice()
        let mut i: usize = 0
        while i < entries.length {
          if entries[i].family == family {
            entries[i].family = NONE
          }
          i = i + 1
        }
        self.markStylesDirty(8)
        let parked = self.parked.asMutSlice()
        let mut p: usize = 0
        while p < parked.length {
          parked[p].touched = true
          p = p + 1
        }
      }
      Mutation.DefineKeyframes { name, frames } => {
        run animation.define(&mut self, move name, move frames)
        self.markStylesDirty(9)
        let parked = self.parked.asMutSlice()
        let mut p: usize = 0
        while p < parked.length {
          parked[p].touched = true
          p = p + 1
        }
      }
      Mutation.DefineImage { resource, data } => {
        let ok = run Effect.catch<ResourceError>(
          defineImage(&mut self.resources, &mut self.atlas, resource, Bytes.asSlice(&data)),
          resourceFailed,
        )
        if !ok {
          fail TreeError.BadResource { index: index, resource: resource }
        }
        run self.refreshSources(resource)
      }
      Mutation.DefineDecodedImage { resource, image } => {
        run self.resources.defineDecoded(&mut self.atlas, resource, move image)
        run self.refreshSources(resource)
      }
      Mutation.ReleaseResource { resource } => {
        run self.resources.release(&mut self.atlas, resource)
        run self.refreshSources(resource)
      }
      Mutation.DefineIcon { resource, data } => {
        let ok = run Effect.catch<ResourceError>(
          defineIcon(&mut self.resources, &mut self.atlas, resource, Bytes.asSlice(&data)),
          resourceFailed,
        )
        if !ok {
          fail TreeError.BadResource { index: index, resource: resource }
        }
        run self.refreshSources(resource)
      }
      Mutation.LoadImage { resource, url } => {
        run self.loads.append(Mutation.LoadImage { resource: resource, url: move url })
      }
      Mutation.LoadIcon { resource, url } => {
        run self.loads.append(Mutation.LoadIcon { resource: resource, url: move url })
      }
      Mutation.DeclareFontFace {
        face,
        family,
        url,
        weightMin,
        weightMax,
        widthMin,
        widthMax,
        style,
        ranges,
      } => {
        let mut rule = run FaceRule.make(
          String.utf8Bytes(String.view(&family)),
          RuleRange { min: f32.toF64(weightMin), max: f32.toF64(weightMax) },
        )
        rule.width = RuleRange { min: f32.toF64(widthMin), max: f32.toF64(widthMax) }
        rule.style = if style == FACE_ITALIC {
          RuleStyle.Italic
        } else if style == FACE_OBLIQUE {
          RuleStyle.Oblique { min: 14.0, max: 14.0 }
        } else {
          RuleStyle.Normal
        }
        let pairs = ranges.asSlice()
        let mut r: usize = 0
        while r + 1 < pairs.length {
          run rule.ranges.append(UnicodeRange { first: pairs[r], last: pairs[r + 1] })
          r = r + 2
        }
        run self.declareFaceAt(face, move rule, move url)
      }
      Mutation.LoadFontFace { face, url } => {
        let sources = self.faceSources.asMutSlice()
        let mut f: usize = 0
        while f < sources.length {
          if sources[f].id == face {
            sources[f].asked = true
          }
          f = f + 1
        }
        run self.loads.append(Mutation.LoadFontFace { face: face, url: move url })
      }
      Mutation.LoadFontStylesheet { url } => {
        run self.loads.append(Mutation.LoadFontStylesheet { url: move url })
      }
    }
  }

  /// Declares face `id` from `rule` with its file at `url` (none when empty).
  effect fn declareFaceAt(self: &mut Self, id: u32, rule: FaceRule, url: String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.fontFaceIndex(id) != usize.MAX {
      return
    }
    if String.byteLength(String.view(&url)) > 0 {
      run self.faceSources.append(FaceSource { id: id, url: move url, asked: false })
    }
    run self.declareFontFace(id, move rule)
  }

  /// Declares a face a host found, such as a rule of a stylesheet it loaded for
  /// `LoadFontStylesheet`, with its file at `url` (resolved against the stylesheet). Its id,
  /// returned, is above any a client chooses. The tree asks for the file in `takeLoads`, as a
  /// `LoadFontFace`, once text needs one of its characters.
  pub effect fn declareHostFontFace(self: &mut Self, rule: FaceRule, url: string) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    let id = self.nextHostFace
    self.nextHostFace = id + 1
    run self.declareFaceAt(id, move rule, run String.copy(url))
    return id
  }

  /// The slot of input `id`.
  effect fn requireInput(self: &Self, index: usize, id: u32) -> u32
    ! TreeError {
    let slot = run self.require(index, id)
    if self.node(slot).kind != NodeKind.Input {
      fail TreeError.WrongKind { index: index, id: id }
    }
    return slot
  }

  /// The slot of icon node `id`, which a live svg mutation addresses.
  effect fn requireSvg(self: &Self, index: usize, id: u32) -> u32
    ! TreeError {
    let slot = run self.require(index, id)
    if self.node(slot).kind != NodeKind.Icon {
      fail TreeError.WrongKind { index: index, id: id }
    }
    return slot
  }

  effect fn require(self: &Self, index: usize, id: u32) -> u32
    ! TreeError {
    let slot = self.slotOf(id)
    if slot == NONE {
      fail TreeError.UnknownNode { index: index, id: id }
    }
    return slot
  }

  effect fn create(self: &mut Self, index: usize, id: u32, kind: NodeKind) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    drop run self.createNode(index, id, kind, NONE, PseudoTarget.None)
  }

  effect fn createNode(self: &mut Self, index: usize, id: u32, kind: NodeKind, origin: u32, target: PseudoTarget) -> u32
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    if origin == NONE && self.contains(id) {
      fail TreeError.IdInUse { index: index, id: id }
    }
    let mut css: usize = 0
    let mut inner: usize = NO_INDEX
    if kind == NodeKind.Text {
      // Its text is the node's own (`Node.text`), read through `slotOfCss`.
      let made = run self.layout.createBorrowedText()
      css = made.index
    } else {
      let made = run self.layout.create(CssStyle.make())
      css = made.index
      if kind == NodeKind.Input {
        let text = run self.layout.createText(String.make())
        inner = text.index
        run Effect.catchAll(
          self.layout.insertBefore(
            NodeId { index: css },
            NodeId { index: inner },
            Option<NodeId>.None,
          ),
          layoutFailed,
        )
      }
    }
    let styled = run self.freshStyle(kind)
    let mut editing = Thin<EditState>.none()
    if kind == NodeKind.Input {
      editing = run Thin<EditState>.make(EditState.make())
    }
    let node = Node {
      id: id,
      kind: kind,
      live: true,
      css: css,
      inner: inner,
      parent: NONE,
      base: List<Declaration>.make(),
      extras: Thin<NodeExtras>.none(),
      styled: move styled,
      moving: Thin<Computed>.none(),
      fontKey: 0,
      paintHash: 0,
      text: String.make(),
      accessRole: Role.None,
      rare: Thin<NodeRare>.none(),
      tabIndex: if kind == NodeKind.Input {
        0
      } else {
        NOT_FOCUSABLE
      },
      cursor: Cursor.Default,
      disabled: false,
      focusTrap: false,
      inert: false,
      prevents: 0,
      checked: false,
      selected: false,
      expanded: false,
      listeners: 0,
      hovered: false,
      pressed: false,
      styleDirty: true,
      styleTick: false,
      styleSubtree: true,
      gridDeclared: false,
      gridStyled: false,
      styleNeedsContext: false,
      sliding: false,
      containerWatch: NONE,
      styleChange: NONE,
      generatedSuppressed: false,
      subtreeDirty: false,
      rendered: false,
      resource: NONE,
      svg: Thin<LiveSvg>.none(),
      content: 1,
      editing: move editing,
      effects: self.emptyEffects.clone(),
      semantics: Thin<Semantics>.none(),
      resolvedSheet: Option<Frozen<Resolved>>.None,
      styleClass: 0,
      styleTwin: NONE,
      movedScope: NONE,
      variableFree: false,
      styleWatch: 0,
      activeTransitions: 0,
      hasEffectsFlag: false,
      computedStamp: 0,
      selectorIdentity: Thin<NodeIdentity>.none(),
      paintCache: NONE,
    }
    let mut slot: u32 = 0
    if self.free.length() != 0 {
      slot = takeLowest(&mut self.free)
      let nodes = self.nodes.asMutSlice()
      nodes[u32.toUsize(slot)] = move node
    } else {
      slot = usize.toU32(self.nodes.length())
      run self.nodes.append(move node)
    }
    if origin == NONE { drop run self.ids.insert(Word { value: u32.toU64(id) }, slot) }
    else {
      let node = self.nodeMut(slot)
      let identity = run node.identityMut()
      identity.generatedOrigin = origin
      identity.generatedTarget = target
    }
    run self.mapCss(css, slot)
    if inner != NO_INDEX {
      // The input's text node maps to no slot, but the table reaches it so `destroy` can clear it.
      run self.mapCss(inner, NONE)
    }
    if kind == NodeKind.Image || kind == NodeKind.Icon {
      run Effect.catchAll(
        self.layout.setNaturalMeasurement(NodeId { index: css }, u32.toUsize(slot)),
        layoutFailed,
      )
    }
    if kind == NodeKind.Input {
      run edit.syncDisplay(&mut self, slot)
    }
    // A new node is detached: it is resolved when it is attached (`restyle`).
    return slot
  }

  fn canHaveChildren(kind: NodeKind) -> bool {
    return kind == NodeKind.Box
  }

  /// Whether `slot` is `ancestor` or inside it.
  fn within(self: &Self, slot: u32, ancestor: u32) -> bool {
    let mut at = slot
    while at != NONE {
      if at == ancestor {
        return true
      }
      at = self.node(at).parent
    }
    return false
  }

  // Reject a stale eviction before touching layout, focus, or row bindings.
  // Removing the list itself is teardown, not eviction of one of its rows.
  effect fn checkVirtualUnmount(self: &Self, index: usize, slot: u32) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    if self.virtualLists.length() == 0 { return () }
    let parent = self.node(slot).parent
    if parent == NONE { return () }
    let port = self.node(parent).id
    let mut v: usize = 0
    while v < self.virtualLists.length() {
      let list = &self.virtualLists.asSlice()[v]
      v = v + 1
      if list.port != port { continue }
      if !self.retainsVirtual(slot, run self.activeVirtualTarget()) { return () }
      let mut r: usize = 0
      while r < list.rows.length() {
        let row = list.rows.get(r)
        r = r + 1
        if row.id == self.node(slot).id { fail TreeError.BadVirtualList { index: index, id: port } }
      }
    }
  }

  effect fn insertBefore(
    self: &mut Self,
    index: usize,
    parent: u32,
    child: u32,
    before: Option<u32>,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let parentSlot = run self.require(index, parent)
    let childSlot = run self.require(index, child)
    if self.node(childSlot).parent != parentSlot {
      run self.checkVirtualUnmount(index, childSlot)
    }
    if !UiTree.canHaveChildren(self.node(parentSlot).kind) {
      fail TreeError.WrongKind { index: index, id: parent }
    }
    if self.isRootNode(childSlot) || self.within(parentSlot, childSlot) {
      fail TreeError.BadMove { index: index, id: child }
    }
    let mut beforeCss = Option<NodeId>.None
    if let Option<u32>.Some { value } = before {
      let beforeSlot = run self.require(index, value)
      if self.node(beforeSlot).parent != parentSlot {
        fail TreeError.BadMove { index: index, id: value }
      }
      if beforeSlot == childSlot {
        return ()
      }
      beforeCss = Option<NodeId>.Some { value: NodeId { index: self.node(beforeSlot).css } }
    } else if let Option.Some { value } = self.node(parentSlot).identity() {
      if value.after != NONE { beforeCss = Option<NodeId>.some(NodeId { index: self.node(value.after).css }) }
    }
    let parentCss = self.node(parentSlot).css
    let childCss = self.node(childSlot).css
    let from = self.rootHolding(childSlot)
    run Effect.catchAll(
      self.layout.insertBefore(NodeId { index: parentCss }, NodeId { index: childCss }, beforeCss),
      layoutFailed,
    )
    let moved = self.nodeMut(childSlot)
    moved.parent = parentSlot
    if self.letterUsed || self.letterRulesUsed() { self.restyleLetterOrigins(parentSlot) }
    match self.sheetReads() {
      Option<u32>.Some { value: reads } => {
        let text = self.node(childSlot).kind == NodeKind.Text
        let before = self.elementBeside(childSlot, true)
        let after = self.elementBeside(childSlot, false)
        self.restyleLocal(childSlot)
        self.restyleAround(reads, parentSlot, before, after, text)
      }
      Option<u32>.None => self.restyle(childSlot)
    }

    // The child left another root, which is not current: that root changed all the same.
    if from != NONE && from != self.current {
      self.touchRoot(from)
    }
  }

  effect fn detach(self: &mut Self, index: usize, slot: u32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let parent = self.node(slot).parent
    let css = self.node(slot).css
    if parent == NONE && slot != self.root {
      return ()
    }
    if self.letterUsed && parent != NONE && !self.node(slot).isGenerated() { run self.detachLetters(slot, parent) }
    let before = if parent == NONE { NONE } else { self.elementBeside(slot, true) }
    let after = if parent == NONE { NONE } else { self.elementBeside(slot, false) }
    run Effect.catchAll(self.layout.remove(NodeId { index: css }), layoutFailed)
    if slot == self.root {
      self.root = NONE
    }
    let detached = self.nodeMut(slot)
    detached.parent = NONE
    if parent != NONE {
      if let Option<u32>.Some { value: reads } = self.sheetReads() {
        let text = self.node(slot).kind == NodeKind.Text
        self.restyleAround(reads, parent, before, after, text)
      }
    }
    if self.focused != NONE && self.within(self.focused, slot) {
      let to = self.returnSlot(self.focused, slot)
      // The removed subtree took focus out of its former ancestors.
      if parent != NONE { self.focusWithinMoved(parent, NONE) }
      run self.moveFocus(to, false)
    }
    // Counters after it count one less.
    if self.listsUsed {
      self.stylesPending = true
      self.listsDirty = true
    }
    // The detached subtree is resolved when it is attached again.
    self.applied = true
  }

  effect fn destroy(self: &mut Self, index: usize, slot: u32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut doomed = List<u32>.make()
    run doomed.append(slot)
    let mut children = List<u32>.make()
    let mut at: usize = 0
    while at < doomed.length() {
      run self.childSlots(doomed.get(at), &mut children)
      run doomed.appendSlice(children.asSlice())
      at = at + 1
    }
    let mut v: usize = 0
    while v < doomed.length() {
      let gone = doomed.get(v)
      if self.node(gone).isGenerated() {
        let computed = self.node(gone).computed().*
        drop run animation.update(&mut self, gone, false, &computed)
        run motion.cancelAll(&mut self, gone)
      }
      v = v + 1
    }
    run self.detach(index, slot)
    v = 0
    while v < doomed.length() {
      let gone = doomed.get(v)
      if !self.node(gone).isGenerated() {
        let id = self.node(gone).id
        run virtual.clear(&mut self, id)
        anchoring.clear(&mut self, id)
      }
      v = v + 1
    }
    let css = self.node(slot).css
    run Effect.catchAll(self.layout.destroy(NodeId { index: css }), layoutFailed)

    // A node moved here from another root can still be that root's focus.
    let parked = self.parked.asMutSlice()
    let mut p: usize = 0
    while p < parked.length {
      if parked[p].focused != NONE && contains(&doomed, parked[p].focused) {
        parked[p].focused = NONE
        parked[p].touched = true
      }
      p = p + 1
    }
    let mut i: usize = 0
    while i < doomed.length() {
      let gone = doomed.get(i)
      let emptyEffects = self.emptyEffects.clone()
      let node = self.nodeMut(gone)
      node.live = false
      let id = node.id
      let nodeCss = node.css
      let inner = node.inner
      let trap = node.focusTrap
      let generated = node.isGenerated()
      // A slot waits for its next node holding nothing: what this one owned goes now, not
      // when (or if) the slot is taken again.
      node.base.clearAndFree()
      node.extras.clear()
      node.text.clearAndFree()
      node.rare.clear()
      let paintCache = node.paintCache
      node.paintCache = NONE
      node.moving.clear()
      node.editing.clear()
      node.effects = move emptyEffects
      node.hasEffectsFlag = false
      node.semantics.clear()
      node.resolvedSheet = Option<Frozen<Resolved>>.None
      node.selectorIdentity.clear()
      if node.inert {
        self.inerts = self.inerts - 1
      }
      if !generated { drop self.ids.remove(Word { value: u32.toU64(id) }) }
      if !generated && self.browseCursor == id { self.browseCursor = NONE }
      if trap {
        self.forgetReturn(id)
      }
      if !generated && self.overrides.length() != 0 {
        // The id may name another node later: its overrides go with this one.
        self.dropOverrides(id)
      }
      self.slotOfCss.set(nodeCss, NONE)
      if inner != NO_INDEX {
        self.slotOfCss.set(inner, NONE)
      }
      run self.paintCaches.release(paintCache)
      run self.free.append(gone)
      let added = self.free.length() - 1
      siftUp(&mut self.free, added)
      i = i + 1
    }
  }

  /// Gives back what laying out and painting a much larger tree left, once the tree holds
  /// under a quarter of the nodes it held: the layout's output and caches, the shaped text
  /// and what each frame fills for its fragments. The frame then lays the smaller tree out
  /// afresh, as its first frame did. With other roots open, whose layouts hold shaped text
  /// too, the shaped text stays.
  fn releaseSlack(self: &mut Self) -> () {
    let live = self.liveNodes()
    if live >= self.heldNodes {
      self.heldNodes = live
      return
    }
    if self.heldNodes < RELEASE_NODES || live * 4 >= self.heldNodes {
      return
    }
    self.heldNodes = live
    self.output = LayoutTree.make()
    self.laidOutRevision = usize.MAX
    if self.parked.length() == 0 {
      self.provider.text.release()
    }
    self.paintOrder.clearAndFree()
    self.fragmentHashes.clearAndFree()
    self.fragmentInk.clearAndFree()
    self.fragmentScrollers.clearAndFree()
    self.textInk.clearAndFree()
    self.fragmentOf.clearAndFree()
    self.nextSourceFragment.clearAndFree()
    self.paintIndexOf.clearAndFree()
    self.fragmentStacking = Stacking.make()
    self.paintCachesStale = true
    self.repair.reset()
    self.facesDirty = true
  }

  /// How many nodes the tree holds.
  pub fn liveNodes(self: &Self) -> usize {
    return self.nodes.length() - self.free.length()
  }

  /// Gives back the end of the node table when most of the table is free slots there, as after
  /// a large subtree is destroyed. A slot something outside the table still names (a capture, a
  /// focus) stays.
  effect fn trimNodes(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let length = self.nodes.length()
    if length < TRIM_NODES || self.free.length() * 2 < length {
      return
    }
    let mut keep: usize = length
    while keep > 0 && !self.node(usize.toU32(keep - 1)).live {
      keep = keep - 1
    }
    keep = keepSlot(keep, self.root)
    keep = keepSlot(keep, self.focused)
    keep = keepSlot(keep, self.capture)
    keep = keepSlot(keep, self.captureTo)
    keep = keepSlot(keep, self.pendingTarget)
    keep = keepSlot(keep, self.thumbSlot)
    let parked = self.parked.asSlice()
    let mut p: usize = 0
    while p < parked.length {
      keep = keepSlot(keep, parked[p].root)
      keep = keepSlot(keep, parked[p].focused)
      keep = keepSlot(keep, parked[p].capture)
      keep = keepSlot(keep, parked[p].captureTo)
      keep = keepSlot(keep, parked[p].pendingTarget)
      keep = keepSlot(keep, parked[p].thumbSlot)
      p = p + 1
    }
    drop parked
    if keep * 2 > length {
      return
    }
    while self.nodes.length() > keep {
      drop self.nodes.pop()
    }
    run self.nodes.shrinkToFit()
    // What each frame fills for the nodes it paints was sized by the larger tree.
    run self.paintOrder.shrinkToFit()
    run self.fragmentHashes.shrinkToFit()
    run self.fragmentInk.shrinkToFit()
    run self.fragmentScrollers.shrinkToFit()
    run self.textInk.shrinkToFit()
    run self.fragmentOf.shrinkToFit()
    run self.nextSourceFragment.shrinkToFit()
    run self.paintIndexOf.shrinkToFit()
    run self.events.shrinkToFit()
    run self.styleChanges.shrinkToFit()
    let mut kept: usize = 0
    let mut i: usize = 0
    while i < self.free.length() {
      let slot = self.free.get(i)
      if u32.toUsize(slot) < keep {
        self.free.set(kept, slot)
        kept = kept + 1
      }
      i = i + 1
    }
    self.free.truncate(kept)
    run self.free.shrinkToFit()
    // Fewer slots, in the order they were: put the lowest first again.
    let mut at = kept / 2
    while at > 0 {
      at = at - 1
      siftDown(&mut self.free, at)
    }
  }

  // Roots.

  /// The index of open root `root` in `parked`, or `usize.MAX`.
  fn parkedIndex(self: &Self, root: u32) -> usize {
    let parked = self.parked.asSlice()
    let mut i: usize = 0
    while i < parked.length {
      if parked[i].id == root {
        return i
      }
      i = i + 1
    }
    return usize.MAX
  }

  /// Whether root `root` is open.
  pub fn rootOpen(self: &Self, root: u32) -> bool {
    if root == self.current {
      return self.currentOpen
    }
    return self.parkedIndex(root) != usize.MAX
  }

  /// The ids of the open roots: the current one first, then the others in the order they
  /// were parked.
  pub effect fn openRoots(self: &Self, out: &mut List<u32>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    if self.currentOpen {
      run out.append(self.current)
    }
    let parked = self.parked.asSlice()
    let mut i: usize = 0
    while i < parked.length {
      run out.append(parked[i].id)
      i = i + 1
    }
  }

  /// The id of the root node of root `root`, or NONE when it is not open or has none.
  pub fn rootNode(self: &Self, root: u32) -> u32 {
    let mut slot = NONE
    if root == self.current {
      slot = self.root
    } else {
      let at = self.parkedIndex(root)
      if at != usize.MAX {
        slot = self.parked.asSlice()[at].root
      }
    }
    if slot == NONE {
      return NONE
    }
    return self.node(slot).id
  }

  /// The viewport of root `root`'s last frame, in CSS pixels; empty for a root that is not
  /// open.
  pub fn rootViewport(self: &Self, root: u32) -> Rect<f32> {
    if root == self.current {
      return Rect<f32>.new(0.0, 0.0, self.input.width, self.input.height)
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
    }
    let input = self.parked.asSlice()[at].input
    return Rect<f32>.new(0.0, 0.0, input.width, input.height)
  }

  /// The options root `root` was opened or last updated with, or None when it is not open.
  pub fn rootOptions(self: &Self, root: u32) -> Option<&RootOptions> {
    if root == self.current {
      if self.currentOpen {
        return Option<&RootOptions>.some(&self.currentOptions)
      }
      return Option<&RootOptions>.None
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return Option<&RootOptions>.None
    }
    return Option<&RootOptions>.some(&self.parked.asSlice()[at].options)
  }

  /// The id of the open root `slot` is in, or NONE for a node in none.
  pub fn rootHolding(self: &Self, slot: u32) -> u32 {
    return self.rootOfTop(self.topOf(slot))
  }

  /// Whether the node at `slot` is in the current root.
  pub fn holdsCurrent(self: &Self, slot: u32) -> bool {
    return self.root != NONE && self.topOf(slot) == self.root
  }

  /// The computed value of custom property `name` (`--gap`) on the node at `slot`, as
  /// `getComputedStyle` reads it: the tokens of the declaration that won, inherited ones too,
  /// with their own `var()`s substituted. False when the node has none.
  pub effect fn customProperty(self: &Self, slot: u32, name: &[u8], out: &mut Bytes) -> bool
    ! OutOfMemoryError ? &mut Allocator {
    let scope = match self.node(slot).sheetScope() {
      Option<ScopeId>.Some { value } => value
      Option<ScopeId>.None => { return false }
    }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.rootOfTop(self.topOf(slot)))
    if at == usize.MAX { return false }
    let inputs = self.styleSheets.asSlice()[at].sheets.variableInputs()
    if inputs.length == 0 { return false }
    let mut reference = Bytes.make()
    run reference.append(b"var(")
    run reference.append(name)
    run reference.append(b")")
    let expanded = run Effect.result(style_sheets.substituteText(&inputs[0], scope, reference.asSlice()))
    return match move expanded {
      Result.Success { value: Option<Bytes>.Some { value } } => {
        run out.append(value.asSlice())
        true
      }
      Result.Success { value: _ } => false
      Result.Failure { error } => match move error {
        OutOfMemoryError allocation => { fail move allocation }
        _ => false
      }
    }
  }

  // The custom properties each inline svg's markup reads, resolved for its node, for paint
  // (`Resources.iconVariables`): an icon's resource has no cascade of its own. Their key is
  // folded into the node's paint hash, so a change repaints it.
  effect fn collectIconVariables(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.resources.variables.length() == 0 && !self.resources.readsVariables() { return () }
    let old = Intrinsic.replace(self.resources.variables, List<IconVariables>.make())
    let mut found = List<IconVariables>.make()
    let count = self.nodes.length()
    let mut oldCursor: usize = 0
    let mut slot: usize = 0
    while slot < count {
      let n = &self.nodes.asSlice()[slot]
      if n.live && n.rendered && n.kind == NodeKind.Icon {
        let slotU32 = usize.toU32(slot)
        let names = self.resources.markupVariables(n.resource)
        if names.length == 0 {
          slot = slot + 1
          continue
        }
        let mut css = List<u8>.make()
        let mut i: usize = 0
        while i < names.length {
          let mut value = Bytes.make()
          if run self.customProperty(slotU32, names[i].asSlice(), &mut value) {
            run css.appendSlice(names[i].asSlice())
            run css.append(58)
            run css.appendSlice(value.asSlice())
            run css.append(59)
          }
          i = i + 1
        }
        let mut key: u64 = 0
        let bytes = css.asSlice()
        i = 0
        while i < bytes.length {
          key = Hash.combine(key, u8.toU64(bytes[i]))
          i = i + 1
        }
        let current = self.nodes.asSlice()[slot].paintHash
        // A restyle since the last frame wrote a fresh hash; otherwise it still holds the old key.
        let mut base = current
        while oldCursor < old.length() && old.asSlice()[oldCursor].slot < slotU32 {
          oldCursor = oldCursor + 1
        }
        if oldCursor < old.length() {
          let entry = &old.asSlice()[oldCursor]
          if entry.slot == slotU32 && entry.mixed == current { base = entry.base }
        }
        let mixed = if bytes.length == 0 { base } else { Hash.combine(base, key) }
        if mixed != current {
          let target = self.nodeMut(slotU32)
          target.paintHash = mixed
          run self.repair.nodes.append(slotU32)
          self.repair.pending = true
        }
        if bytes.length != 0 {
          run found.append(IconVariables { slot: slotU32, key: key, css: move css, base: base, mixed: mixed })
        }
      }
      slot = slot + 1
    }
    self.resources.variables = move found
  }

  /// The id of the open root whose node is `top`, or NONE.
  fn rootOfTop(self: &Self, top: u32) -> u32 {
    if top == self.root && self.currentOpen {
      return self.current
    }
    let parked = self.parked.asSlice()
    let mut i: usize = 0
    while i < parked.length {
      if parked[i].root == top {
        return parked[i].id
      }
      i = i + 1
    }
    return NONE
  }

  /// How often what root `root` publishes changed: its nodes, their text, styles, focus or
  /// geometry. A change to one root leaves the others' revisions alone, so a client that
  /// watches some roots is not woken by the rest. 0 for a root that is not open.
  pub fn revisionOf(self: &Self, root: u32) -> u64 {
    if root == self.current {
      return self.revision
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return 0
    }
    return self.parked.asSlice()[at].revision
  }

  /// Counts a change to root `root` in its revision.
  fn changedRoot(self: &mut Self, root: u32) -> () {
    if root == self.current {
      self.revision = self.revision + 1
      return ()
    }
    let at = self.parkedIndex(root)
    if at != usize.MAX {
      let parked = self.parked.asMutSlice()
      parked[at].revision = parked[at].revision + 1
    }
  }

  /// Counts a change to every root in their revisions.
  fn changedEveryRoot(self: &mut Self) -> () {
    self.revision = self.revision + 1
    let parked = self.parked.asMutSlice()
    let mut i: usize = 0
    while i < parked.length {
      parked[i].revision = parked[i].revision + 1
      i = i + 1
    }
  }

  /// Says that something reached open root `root`'s nodes from outside it, so its next frame
  /// styles and lays out again (see `RootState.touched`).
  fn touchRoot(self: &mut Self, root: u32) -> () {
    self.changedRoot(root)
    if root == self.current {
      self.markStylesDirty(10)
      self.applied = true
      self.paintCachesStale = true
      return ()
    }
    let at = self.parkedIndex(root)
    if at != usize.MAX {
      let parked = self.parked.asMutSlice()
      parked[at].touched = true
    }
  }

  /// `needsFrame` for root `root`, current or not: whether its next frame would draw something
  /// new. A host with a window per root frames only the roots that answer yes. False for a
  /// root that is not open.
  pub fn needsFrameOf(self: &Self, root: u32) -> bool {
    if root == self.current {
      return self.currentOpen && self.needsFrame()
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return false
    }
    let s = &self.parked.asSlice()[at]
    return s.touched || s.applied || s.stylesDirty || s.paintDirty || s.scrolled
      || s.reveal.length() != 0
      || !s.replayable
      || s.laidOutRevision == usize.MAX
      || s.laidOutScrolls == usize.MAX
  }

  /// The slot at the top of `slot`'s ancestors: a root node, or the top of a detached subtree.
  fn topOf(self: &Self, slot: u32) -> u32 {
    let mut at = slot
    while self.node(at).parent != NONE {
      at = self.node(at).parent
    }
    return at
  }

  /// Whether `slot` is the root node of an open root.
  pub fn isRootNode(self: &Self, slot: u32) -> bool {
    if slot == self.root {
      return true
    }
    let parked = self.parked.asSlice()
    let mut i: usize = 0
    while i < parked.length {
      if parked[i].root == slot {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// Whether `slot` is in a root other than the current one. The current root's layout says
  /// nothing about such a node, so per-frame work leaves it alone.
  pub fn inParkedRoot(self: &Self, slot: u32) -> bool {
    if self.parked.length() == 0 {
      return false
    }
    let top = self.topOf(slot)
    let parked = self.parked.asSlice()
    let mut i: usize = 0
    while i < parked.length {
      if parked[i].root == top {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// The root key input goes to: `keyRoot` while it is open, else the current root.
  pub fn keyTarget(self: &Self) -> u32 {
    if self.rootOpen(self.keyRoot) {
      return self.keyRoot
    }
    return self.current
  }

  /// Moves the per-root state out of the tree, leaving that of a root never framed.
  fn park(self: &mut Self) -> RootState {
    // What was pending for the paint caches is not kept: they are rebuilt.
    if self.repair.pending { self.paintCachesStale = true }
    self.repair.reset()
    return RootState {
      id: self.current,
      options: Intrinsic.replace(self.currentOptions, RootOptions.default()),
      root: Intrinsic.replace(self.root, NONE),
      focused: Intrinsic.replace(self.focused, NONE),
      focusVisible: Intrinsic.replace(self.focusVisible, false),
      textSelection: Intrinsic.replace(self.textSelection, TextSelection.make()),
      input: Intrinsic.replace(
        self.input,
        FrameInput { width: 0.0, height: 0.0, scale: 1.0, time: 0.0 },
      ),
      stats: Intrinsic.replace(self.stats, FrameStats.zero()),
      revision: Intrinsic.replace(self.revision, 0),
      laidOut: Intrinsic.replace(
        self.laidOut,
        FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 },
      ),
      laidOutRevision: Intrinsic.replace(self.laidOutRevision, usize.MAX),
      laidOutScrolls: Intrinsic.replace(self.laidOutScrolls, usize.MAX),
      replayable: Intrinsic.replace(self.replayable, false),
      stylesDirty: Intrinsic.replace(self.stylesDirty, true) || Intrinsic.replace(self.stylesPending, false),
      applied: Intrinsic.replace(self.applied, true),
      paintDirty: Intrinsic.replace(self.paintDirty, false),
      paintCachesStale: Intrinsic.replace(self.paintCachesStale, true),
      layoutObserversDirty: Intrinsic.replace(self.layoutObserversDirty, true),
      facesDirty: Intrinsic.replace(self.facesDirty, true),
      paintedAt: Intrinsic.replace(self.paintedAt, 0),
      touched: false,
      output: Intrinsic.replace(self.output, LayoutTree.make()),
      containerWatches: Intrinsic.replace(self.containerWatches, List<Watch>.make()),
      sceneA: Intrinsic.replace(self.sceneA, Scene.make()),
      sceneB: Intrinsic.replace(self.sceneB, Scene.make()),
      flipped: Intrinsic.replace(self.flipped, false),
      paintOrder: Intrinsic.replace(self.paintOrder, List<u32>.make()),
      fragmentHashes: Intrinsic.replace(self.fragmentHashes, List<u64>.make()),
      fragmentInk: Intrinsic.replace(self.fragmentInk, List<Rect<f32>>.make()),
      fragmentScrollers: Intrinsic.replace(self.fragmentScrollers, List<bool>.make()),
      fragmentStacking: Intrinsic.replace(self.fragmentStacking, Stacking.make()),
      fragmentOf: Intrinsic.replace(self.fragmentOf, List<usize>.make()),
      nextSourceFragment: Intrinsic.replace(self.nextSourceFragment, List<usize>.make()),
      paintIndexOf: Intrinsic.replace(self.paintIndexOf, List<u32>.make()),
      scrolled: Intrinsic.replace(self.scrolled, false),
      hoverChain: Intrinsic.replace(self.hoverChain, List<u64>.make()),
      pressChain: Intrinsic.replace(self.pressChain, List<u64>.make()),
      capture: Intrinsic.replace(self.capture, NONE),
      captureId: Intrinsic.replace(self.captureId, NONE),
      captureMode: Intrinsic.replace(self.captureMode, 0),
      captureTo: Intrinsic.replace(self.captureTo, NONE),
      captureToId: Intrinsic.replace(self.captureToId, NONE),
      suppressText: Intrinsic.replace(self.suppressText, false),
      pendingTarget: Intrinsic.replace(self.pendingTarget, NONE),
      pendingTargetId: Intrinsic.replace(self.pendingTargetId, NONE),
      pressed: Intrinsic.replace(self.pressed, NONE),
      pressedId: Intrinsic.replace(self.pressedId, NONE),
      pressCount: Intrinsic.replace(self.pressCount, 0),
      thumbSlot: Intrinsic.replace(self.thumbSlot, NONE),
      thumbVertical: Intrinsic.replace(self.thumbVertical, true),
      thumbStart: Intrinsic.replace(self.thumbStart, 0.0),
      thumbOffset: Intrinsic.replace(self.thumbOffset, 0.0),
      pointerX: Intrinsic.replace(self.pointerX, 0.0),
      pointerY: Intrinsic.replace(self.pointerY, 0.0),
      pointerInside: Intrinsic.replace(self.pointerInside, false),
      reveal: Intrinsic.replace(self.reveal, List<u64>.make()),
    }
  }

  /// Makes `state` the current root's, with what its last layout and paint left behind.
  fn unpark(self: &mut Self, state: RootState) -> () {
    let mut s = move state
    self.current = s.id
    self.currentOpen = true
    self.currentOptions = Intrinsic.replace(s.options, RootOptions.default())
    self.root = s.root
    self.focused = s.focused
    self.focusVisible = s.focusVisible
    self.textSelection = Intrinsic.replace(s.textSelection, TextSelection.make())
    self.input = s.input
    self.stats = s.stats
    self.revision = s.revision
    self.laidOut = s.laidOut
    self.laidOutRevision = s.laidOutRevision
    self.laidOutScrolls = s.laidOutScrolls
    self.replayable = s.replayable
    self.stylesDirty = s.stylesDirty
    self.applied = s.applied
    self.paintDirty = s.paintDirty
    self.paintCachesStale = s.paintCachesStale || s.applied
    self.repair.reset()
    self.listsDirty = true
    self.layoutObserversDirty = s.layoutObserversDirty
    self.facesDirty = s.facesDirty
    self.paintedAt = s.paintedAt
    // Another root's paint is not this one's: the next frame paints.
    self.quietInput = FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 }
    self.output = Intrinsic.replace(s.output, LayoutTree.make())
    self.containerWatches = Intrinsic.replace(s.containerWatches, List<Watch>.make())
    self.sceneA = Intrinsic.replace(s.sceneA, Scene.make())
    self.sceneB = Intrinsic.replace(s.sceneB, Scene.make())
    self.flipped = s.flipped
    self.paintOrder = Intrinsic.replace(s.paintOrder, List<u32>.make())
    self.fragmentHashes = Intrinsic.replace(s.fragmentHashes, List<u64>.make())
    self.fragmentInk = Intrinsic.replace(s.fragmentInk, List<Rect<f32>>.make())
    self.fragmentScrollers = Intrinsic.replace(s.fragmentScrollers, List<bool>.make())
    self.fragmentStacking = Intrinsic.replace(s.fragmentStacking, Stacking.make())
    self.fragmentOf = Intrinsic.replace(s.fragmentOf, List<usize>.make())
    self.nextSourceFragment = Intrinsic.replace(s.nextSourceFragment, List<usize>.make())
    self.paintIndexOf = Intrinsic.replace(s.paintIndexOf, List<u32>.make())
    self.scrolled = s.scrolled
    self.hoverChain = Intrinsic.replace(s.hoverChain, List<u64>.make())
    self.pressChain = Intrinsic.replace(s.pressChain, List<u64>.make())
    self.capture = s.capture
    self.captureId = s.captureId
    self.captureMode = s.captureMode
    self.captureTo = s.captureTo
    self.captureToId = s.captureToId
    self.suppressText = s.suppressText
    self.pendingTarget = s.pendingTarget
    self.pendingTargetId = s.pendingTargetId
    self.pressed = s.pressed
    self.pressedId = s.pressedId
    self.pressCount = s.pressCount
    self.thumbSlot = s.thumbSlot
    self.thumbVertical = s.thumbVertical
    self.thumbStart = s.thumbStart
    self.thumbOffset = s.thumbOffset
    self.pointerX = s.pointerX
    self.pointerY = s.pointerY
    self.pointerInside = s.pointerInside
    self.reveal = Intrinsic.replace(s.reveal, List<u64>.make())
    if s.touched {
      self.markStylesDirty(11)
      self.applied = true
      self.paintCachesStale = true
      self.layoutObserversDirty = true
      self.laidOutRevision = usize.MAX
    }
    drop s
  }

  /// Forgets what the last layout and paint left behind, for state that belongs to another
  /// root now.
  fn restart(self: &mut Self) -> () {
    self.laidOut = FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 }
    self.laidOutRevision = usize.MAX
    self.laidOutScrolls = usize.MAX
    self.replayable = false
    self.paintCachesStale = true
    self.markStylesDirty(12)
    self.layoutObserversDirty = true
  }

  /// Puts the current root's node in css-layout's viewport, or takes it out.
  effect fn mountCurrent(self: &mut Self, mounted: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.root == NONE {
      return ()
    }
    let css = NodeId { index: self.node(self.root).css }
    if mounted {
      let viewport = self.layout.root()
      run Effect.catchAll(
        self.layout.insertBefore(viewport, css, Option<NodeId>.None),
        ignoreInvalid,
      )
    } else {
      run Effect.catchAll(self.layout.remove(css), ignoreInvalid)
    }
  }

  /// At the next frame, scrolls the containers around node `id` at `slot` the least that
  /// brings it into view, as `scrollIntoView({ block: "nearest" })`.
  pub effect fn revealSlot(self: &mut Self, slot: u32, id: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.viewScrollState.interruptAll()
    self.viewScrollAnimations.clear()
    run self.reveal.append(interact.pair(slot, id))
  }

  /// Makes open root `root` the current one: the one `frame`, `scene`, hit testing, the
  /// geometry queries and pointer input are about. Returns whether `root` is open.
  pub effect fn useRoot(self: &mut Self, root: u32) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if root == self.current {
      return self.currentOpen
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return false
    }

    // A change to the leaving root that its layout has not seen yet must not be caught up
    // with below when it comes back.
    if self.layout.revision() != self.laidOutRevision {
      self.laidOutRevision = usize.MAX
    }
    if self.layout.scrollRevision() != self.laidOutScrolls {
      self.laidOutScrolls = usize.MAX
    }
    run self.mountCurrent(false)
    let next = self.parked.remove(at)
    let untouched = !next.touched
    let previous = self.park()
    if self.currentOpen {
      run self.parked.append(move previous)
    } else {
      drop previous
    }
    self.unpark(move next)
    run self.mountCurrent(true)

    // Moving root nodes in and out of css-layout's viewport, and the other roots' changes,
    // moved css-layout's revisions but not this root's nodes: its last layout stands.
    if untouched && self.laidOutRevision != usize.MAX && self.laidOutScrolls != usize.MAX {
      self.laidOutRevision = self.layout.revision()
      self.laidOutScrolls = self.layout.scrollRevision()
    }
    return true
  }

  /// Makes the root that holds `slot` current, when that is another open root.
  effect fn useRootOf(self: &mut Self, slot: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.parked.length() == 0 {
      return ()
    }
    let holder = self.rootOfTop(self.topOf(slot))
    if holder != NONE {
      drop run self.useRoot(holder)
    }
  }

  effect fn openRoot(
    self: &mut Self,
    index: usize,
    root: u32,
    slot: u32,
    options: RootOptions,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if root != self.current && self.parkedIndex(root) != usize.MAX {
      drop run self.useRoot(root)
    }
    if root == self.current {
      run self.setRootNode(index, slot)
      self.currentOpen = true
      self.currentOptions = move options
      if root == FIRST_ROOT && self.pendingFirstRootSheets.length() != 0 {
        run self.installPendingFirstRootSheets(index)
      }
      return ()
    }
    let mut open = usize.toU32(self.parked.length())
    if self.currentOpen {
      open = open + 1
    }
    if root != FIRST_ROOT && !self.rootSupport.admits(open) {
      run self.reportRoot(root, RootEventKind.Failed)
      return ()
    }
    if !self.currentOpen {
      // No open root owns the current state: the new root starts from a fresh one.
      drop self.park()
      self.restart()
      self.current = root
      run self.setRootNode(index, slot)
      self.currentOpen = true
      self.currentOptions = move options
      if root == FIRST_ROOT && self.pendingFirstRootSheets.length() != 0 {
        run self.installPendingFirstRootSheets(index)
      }
      return ()
    }

    // Another root is current: the new one waits for its first frame.
    if self.isRootNode(slot) {
      fail TreeError.BadMove { index: index, id: self.node(slot).id }
    }
    if self.node(slot).kind == NodeKind.Text {
      fail TreeError.WrongKind { index: index, id: self.node(slot).id }
    }
    if self.node(slot).parent != NONE {
      run self.detach(index, slot)
    }
    run self.parked.append(RootState.fresh(root, move options, slot))
  }

  effect fn closeRoot(self: &mut Self, index: usize, root: u32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if !(run self.useRoot(root)) {
      return ()
    }
    let node = self.root
    if node != NONE {
      run self.detach(index, node)
    }
    self.currentOpen = false
    self.currentOptions = RootOptions.default()
    if self.parked.length() != 0 {
      let next = if self.parkedIndex(self.keyRoot) != usize.MAX {
        self.keyRoot
      } else {
        self.parked.asSlice()[0].id
      }
      drop run self.useRoot(next)
    }
    if self.keyRoot == root {
      self.keyRoot = self.current
    }
  }

  /// Frames root `root` (see `frame`), making it current. Nothing happens for a root that is
  /// not open, unless it is current already.
  pub effect fn frameRoot(self: &mut Self, root: u32, input: FrameInput) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if !(run self.useRoot(root)) && root != self.current {
      return ()
    }
    run self.frame(input)
  }

  /// `dispatch` with pointer input aimed at root `root`. Key and text input go to `keyRoot`
  /// either way.
  pub effect fn dispatchTo(self: &mut Self, root: u32, input: Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !keyboardInput(&input) {
      drop run self.useRoot(root)
    }
    run self.dispatch(move input)
  }

  /// `begin` with pointer input aimed at root `root`.
  pub effect fn beginAt(self: &mut Self, root: u32, input: &Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !keyboardInput(input) {
      drop run self.useRoot(root)
    }
    run self.begin(input)
  }

  /// A host tells the tree what the system did with root `root`, and the client hears it as
  /// a root event. `Focused` also makes the root `keyRoot`. A root event that waits is
  /// replaced by a later one of the same kind for the same root (see `RootEvent.replacedBy`),
  /// so the queue stays short when nobody drains it.
  pub effect fn reportRoot(self: &mut Self, root: u32, kind: RootEventKind) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match kind {
      RootEventKind.Focused => {
        self.keyRoot = root
      }
      _ => {}
    }
    let event = RootEvent { root: root, kind: kind }
    let mut i: usize = 0
    while i < self.rootEvents.length() {
      let waiting = self.rootEvents.get(i)
      if waiting.replacedBy(&event) {
        drop self.rootEvents.remove(i)
      } else {
        i = i + 1
      }
    }
    run self.rootEvents.append(event)
  }

  /// Moves the queued root events to `out`, oldest first, but those of roots set aside.
  pub effect fn takeRootEvents(self: &mut Self, out: &mut List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.aside.length() == 0 {
      run out.appendSlice(self.rootEvents.asSlice())
      self.rootEvents.clear()
      return ()
    }
    let mut i: usize = 0
    while i < self.rootEvents.length() {
      if self.isAside(self.rootEvents.get(i).root) {
        i = i + 1
      } else {
        run out.append(self.rootEvents.remove(i))
      }
    }
  }

  /// Moves the queued root events of root `root` to `out`, oldest first.
  pub effect fn takeRootEventsOf(self: &mut Self, root: u32, out: &mut List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < self.rootEvents.length() {
      if self.rootEvents.get(i).root == root {
        run out.append(self.rootEvents.remove(i))
      } else {
        i = i + 1
      }
    }
  }

  /// Sets root `root` aside for a second client that shares the tree, or gives it back: the
  /// records whose path starts at its node and its root events wait for `takeEventsOf` and
  /// `takeRootEventsOf`, and `takeEvents` and `takeRootEvents` leave them. The client that
  /// owns the rest of the tree then never hears of it. The root need not be open yet.
  pub effect fn setAside(self: &mut Self, root: u32, aside: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < self.aside.length() {
      if self.aside.get(i) == root {
        drop self.aside.remove(i)
      } else {
        i = i + 1
      }
    }
    if aside {
      run self.aside.append(root)
    }
  }

  /// Whether root `root` is set aside (see `setAside`).
  pub fn isAside(self: &Self, root: u32) -> bool {
    let list = self.aside.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i] == root {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// Whether a record whose path starts at node `first` belongs to a root set aside.
  fn asideRecord(self: &Self, first: u32) -> bool {
    let list = self.aside.asSlice()
    let mut i: usize = 0
    while i < list.length {
      let node = self.rootNode(list[i])
      if node != NONE && node == first {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// The scene of root `root`'s last frame, current or not, finished and ready to draw. A host
  /// that draws several roots on one surface composes them from these. Empty for a root that
  /// is not open.
  pub fn sceneOf(self: &Self, root: u32) -> &Scene {
    if root == self.current {
      return self.scene()
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return &self.empty
    }
    let state = &self.parked.asSlice()[at]
    if state.flipped {
      return &state.sceneB
    }
    return &state.sceneA
  }

  /// Makes `slot` the current root's node. The previous one is detached.
  effect fn setRootNode(self: &mut Self, index: usize, slot: u32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if slot == self.root {
      return ()
    }
    if self.parked.length() != 0 && self.isRootNode(slot) {
      fail TreeError.BadMove { index: index, id: self.node(slot).id }
    }
    let previous = self.root
    if previous != NONE {
      run self.detach(index, previous)
    }
    if self.node(slot).parent != NONE {
      run self.detach(index, slot)
    }
    if self.node(slot).kind == NodeKind.Text {
      fail TreeError.WrongKind { index: index, id: self.node(slot).id }
    }
    let css = self.node(slot).css
    let viewport = self.layout.root()
    run Effect.catchAll(
      self.layout.insertBefore(viewport, NodeId { index: css }, Option<NodeId>.None),
      layoutFailed,
    )
    self.root = slot
    self.markStylesDirty(13)
  }

  effect fn setText(self: &mut Self, index: usize, slot: u32, value: String) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let kind = self.node(slot).kind
    let mut target: usize = 0
    if kind == NodeKind.Text {
      target = self.node(slot).css
    } else if kind == NodeKind.Input {
      run edit.setValue(&mut self, slot, move value)
      return ()
    } else {
      fail TreeError.WrongKind { index: index, id: self.node(slot).id }
    }
    let wasBlank = Engine.blank(String.view(&self.node(slot).text))
    let blank = Engine.blank(String.view(&value))
    let node = self.nodeMut(slot)
    node.text = move value
    node.content = node.content + 1
    run Effect.catchAll(self.layout.borrowedTextChanged(NodeId { index: target }, wasBlank, blank), layoutFailed)
    if (self.letterUsed || self.letterRulesUsed()) && !self.node(slot).isGenerated() { self.restyleLetterOrigins(slot) }
  }

  fn letterRulesUsed(self: &Self) -> bool {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    return at != usize.MAX && self.styleSheets.asSlice()[at].hasFirstLetter
  }

  /// Where focus goes when `focused` leaves the tree with the subtree at `removed`: the node
  /// focused before focus entered the outermost trap being removed, when that node is still
  /// in the root and outside the subtree; NONE (blur) otherwise.
  fn returnSlot(self: &Self, focused: u32, removed: u32) -> u32 {
    let mut target = NONE
    let mut at = focused
    while at != NONE {
      if self.node(at).focusTrap {
        let to = self.returnOf(self.node(at).id)
        if to != NONE {
          target = to
        }
      }
      if at == removed {
        break
      }
      at = self.node(at).parent
    }
    if target == NONE || !self.node(target).live || self.within(target, removed) || !self.within(target, self.root) {
      return NONE
    }
    return target
  }

  fn returnOf(self: &Self, trap: u32) -> u32 {
    let returns = self.returns.asSlice()
    let mut i: usize = 0
    while i < returns.length {
      if returns[i].trap == trap {
        return self.slotOf(returns[i].to)
      }
      i = i + 1
    }
    return NONE
  }

  fn forgetReturn(self: &mut Self, trap: u32) -> () {
    let mut i: usize = 0
    while i < self.returns.length() {
      if self.returns.asSlice()[i].trap == trap {
        drop self.returns.remove(i)
        return ()
      }
      i = i + 1
    }
  }

  /// Notes, for each focus trap that `slot` is in and `previous` is not, that focus came from
  /// `previous`.
  effect fn noteReturns(self: &mut Self, previous: u32, slot: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut at = slot
    while at != NONE {
      if self.node(at).focusTrap && !self.within(previous, at) {
        let trap = self.node(at).id
        let to = self.node(previous).id
        self.forgetReturn(trap)
        run self.returns.append(FocusReturn { trap: trap, to: to })
      }
      at = self.node(at).parent
    }
  }

  /// Moves focus to `slot` (NONE blurs), queueing focus and blur records for listeners.
  pub effect fn focusSlot(self: &mut Self, slot: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.moveFocus(slot, true)
  }

  /// [`focusSlot`], noting where focus came from when `note`: not when it goes back.
  effect fn moveFocus(self: &mut Self, slot: u32, note: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if slot == self.focused {
      return ()
    }
    // A focused element inside skipped contents is laid out, as one that is shown.
    if slot != NONE && u32.toUsize(slot) < self.nodes.length() {
      let id = self.node(slot).id
      run self.wakeFor(id)
    }
    let before = self.focused
    if note && before != NONE && slot != NONE {
      run self.noteReturns(before, slot)
    }
    self.semanticRevision = self.semanticRevision + 1
    self.revision = self.revision + 1
    let previous = self.focused
    self.focused = slot
    run edit.focusChanged(&mut self, previous, slot)
    if previous != NONE && self.node(previous).live
      && u32.bitAnd(self.node(previous).listeners, LISTEN_BLUR) != 0 {
      run self.queue(EventKind.Blur, previous)
    }
    if slot != NONE && u32.bitAnd(self.node(slot).listeners, LISTEN_FOCUS) != 0 {
      run self.queue(EventKind.Focus, slot)
    }
    let left = if previous != NONE && self.node(previous).live { previous } else { NONE }
    if left != NONE {
      self.focusStyleChanged(left)
    }
    if slot != NONE {
      self.focusStyleChanged(slot)
    }
    self.focusWithinMoved(left, slot)
  }

  /// The node ids from the root down to `slot`.
  pub effect fn pathTo(self: &Self, slot: u32, out: &mut List<u32>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    let mut at = slot
    while at != NONE {
      if !self.node(at).isGenerated() { run out.append(self.node(at).id) }
      at = self.node(at).parent
    }
    let values = out.asMutSlice()
    let mut i: usize = 0
    let mut j = values.length
    while i + 1 < j {
      j = j - 1
      let swap = values[i]
      values[i] = values[j]
      values[j] = swap
      i = i + 1
    }
  }

  effect fn queue(self: &mut Self, kind: EventKind, slot: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut path = List<u32>.make()
    run self.pathTo(slot, &mut path)
    let target = self.node(slot).id
    run self.events.append(Event.make(kind, target, move path))
  }

  /// Queues `event` for the client.
  pub effect fn queueEvent(self: &mut Self, event: Event) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.events.append(move event)
  }

  /// Feeds one input record to the tree: hit testing against the last frame, hover and active
  /// states, pointer capture, focus, tab order, keyboard clicks and scrolling, and the event
  /// records for listeners. State changes show at the next frame. Pointer input goes to the
  /// current root, key and text input to `keyRoot` (see `dispatchTo`).
  pub effect fn dispatch(self: &mut Self, input: Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if keyboardInput(&input) {
      let keyed = self.keyTarget()
      drop run self.useRoot(keyed)
    }
    let interruptsScroll = match &input {
      Input.Wheel { deltaX, deltaY, .. } => !scroll_snap.continuesFling(&self.*, deltaX, deltaY)
      Input.PointerDown { .. } => true
      Input.TouchStart { .. } => true
      Input.KeyDown { .. } => true
      _ => false
    }
    if interruptsScroll {
      self.viewScrollState.interruptAll()
      self.viewScrollAnimations.clear()
    }
    run interact.begin(&mut self, &input)
    run interact.finish(&mut self, move input, false)
    run edit.reportSelection(&mut self)
    run text_selection.report(&mut self)
    while self.followUps.length() > 0 {
      let next = self.followUps.remove(0)
      run self.dispatch(move next)
    }
  }

  /// Queues `input` to follow the one under way, as a host's own input would. The tree queues
  /// the copy or cut of a shortcut and the edit of a cut or paste, so each gets its own
  /// records and its own say for the client; a host answering `HostRequest.ReadClipboard`
  /// queues its `Input.Paste`.
  pub effect fn queueFollowUp(self: &mut Self, input: Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.followUps.append(move input)
  }

  /// The next queued follow-up input, oldest first. A host that splits input into `begin`
  /// and `finish` runs each one the same way after the input that queued it and after serving
  /// requests; `dispatch` runs them itself.
  pub fn takeFollowUp(self: &mut Self) -> Option<Input> {
    if self.followUps.length() == 0 {
      return Option<Input>.None
    }
    return Option<Input>.some(self.followUps.remove(0))
  }

  /// The first half of `dispatch`: hit testing, hover, and the record of the input itself
  /// (pointer down, wheel, key down and so on), with no default action taken yet. Follow it
  /// with `finish` for the same input.
  pub effect fn begin(self: &mut Self, input: &Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if keyboardInput(input) {
      let keyed = self.keyTarget()
      drop run self.useRoot(keyed)
    }
    self.pendingRoot = self.current
    let interruptsScroll = match &input.* {
      Input.Wheel { deltaX, deltaY, .. } => !scroll_snap.continuesFling(&self.*, deltaX, deltaY)
      Input.PointerDown { .. } => true
      Input.TouchStart { .. } => true
      Input.KeyDown { .. } => true
      _ => false
    }
    if interruptsScroll {
      self.viewScrollState.interruptAll()
      self.viewScrollAnimations.clear()
    }
    run interact.begin(&mut self, input)
  }

  /// The second half of `dispatch`: the default action of `input` (focus, scrolling, Tab,
  /// keyboard clicks, editing) unless `prevented`, and the records that follow from it.
  pub effect fn finish(self: &mut Self, input: Input, prevented: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let started = self.pendingRoot
    drop run self.useRoot(started)
    run interact.finish(&mut self, move input, prevented)
    run edit.reportSelection(&mut self)
    run text_selection.report(&mut self)
  }

  /// The id of the node a pointer at (`x`, `y`) would target in the last frame, or NONE.
  pub fn hitTest(self: &Self, x: f32, y: f32) -> u32 {
    let slot = interact.hitSlot(self, x, y)
    if slot == NONE {
      return NONE
    }
    return self.node(slot).id
  }

  /// Whether a press at (`x`, `y`) moves the window, as Electron's drag regions decide: the
  /// pressed node or its nearest ancestor that sets `app-region` says `drag`.
  pub fn dragsWindow(self: &Self, x: f32, y: f32) -> bool {
    let mut at = interact.hitSlot(self, x, y)
    while at != NONE {
      let region = self.node(at).computed().appRegion
      if region != REGION_NONE { return region == REGION_DRAG }
      at = self.node(at).parent
    }
    return false
  }

  /// The cursor for the hovered node: the nearest cursor attribute other than `Default` on
  /// its path.
  pub fn cursor(self: &Self) -> Cursor {
    return interact.cursorOf(self)
  }

  /// The image CSS `cursor: url(...)` shows over the hovered node: the first of its images that
  /// loaded, skipping those that failed. None while there is none, or while an earlier one
  /// still loads; `cursor()` is the keyword to show then. Images not asked for yet are asked
  /// for in the next `takeLoads`.
  pub effect fn cursorImage(self: &mut Self) -> Option<CursorImage>
    ! OutOfMemoryError
    ? &mut Allocator {
    let from = interact.cursorFrom(&self.*)
    if from.images == NONE {
      return Option<CursorImage>.None
    }
    let node = self.node(from.images)
    let declarations = match node.sheetStyle() {
      Option.Some { value } => value.declarations.asSlice()
      _ => node.base.asSlice()
    }
    let mut css = Bytes.make()
    let mut i = declarations.length
    while i > 0 {
      i = i - 1
      if declarations[i].property == CssProperty.Cursor {
        css = run values.cssText(&declarations[i].value)
        break
      }
    }
    let urls = run css_cursor.urlsOf(css.asSlice())
    let list = urls.asSlice()
    let mut ids = List<u32>.make()
    let mut k: usize = 0
    while k < list.length {
      run ids.append(run self.resources.cssImage(list[k].url.asSlice()))
      k = k + 1
    }
    k = 0
    while k < list.length {
      let resource = ids.asSlice()[k]
      match self.resources.cssImages.asSlice()[u32.toUsize(resource - CSS_IMAGE_BASE)].state {
        CssImageState.Loaded => {
          return Option<CursorImage>.Some {
            value: CursorImage { resource: resource, hotX: list[k].hotX, hotY: list[k].hotY, hot: list[k].hot },
          }
        }
        CssImageState.Failed => {}
        _ => {
          return Option<CursorImage>.None
        }
      }
      k = k + 1
    }
    return Option<CursorImage>.None
  }

  /// The pixels of cursor `image` for a display of `scale` pixels per CSS pixel, None when the
  /// image cannot be a cursor (a side past 256 pixels).
  pub effect fn cursorPixels(self: &mut Self, image: CursorImage, scale: f32) -> Option<CursorPixels>
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.resources.cursorPixels(image.resource, scale)
  }

  /// The scroll offset of node `id`, (0, 0) when it does not scroll or does not exist.
  /// Node `id` was scrolled to (`x`, `y`) outside the tree, as a compositor scrolls the last
  /// frame without the tree: the tree takes the offset and tells scroll listeners, as a wheel
  /// scroll does. The node's root becomes current.
  pub effect fn scrolledElsewhere(self: &mut Self, id: u32, x: f32, y: f32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let slot = self.slotOf(id)
    if slot == NONE {
      return ()
    }
    run self.useRootOf(slot)
    self.viewScrollState.interruptTarget(
      ViewTarget { kind: ViewTargetKind.Element, id: u32.toUsize(id) },
    )
    let fromX = self.node(slot).scrollX()
    let fromY = self.node(slot).scrollY()
    run interact.scrolledElsewhere(&mut self, slot, x, y)
    run scroll_snap.userScrolled(&mut self, slot, fromX, fromY, false)
  }

  pub fn scrollOffset(self: &Self, id: u32) -> Vector2<f32> {
    let slot = self.slotOf(id)
    if slot == NONE {
      return Vector2<f32> { x: 0.0, y: 0.0 }
    }
    return Vector2<f32> { x: self.node(slot).scrollX(), y: self.node(slot).scrollY() }
  }

  /// Moves the queued host requests (clipboard reads and writes, font faces to load) to `out`,
  /// oldest first.
  pub effect fn takeRequests(self: &mut Self, out: &mut List<HostRequest>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.requestFontFaces()
    let mut reversed = List<HostRequest>.make()
    while true {
      match self.requests.pop() {
        Option<HostRequest>.Some { value } => {
          run reversed.append(move value)
        }
        Option<HostRequest>.None => {
          break
        }
      }
    }
    while true {
      match reversed.pop() {
        Option<HostRequest>.Some { value } => {
          run out.append(move value)
        }
        Option<HostRequest>.None => {
          break
        }
      }
    }
  }

  /// What the platform input method needs after the last frame: whether a text field has
  /// focus, and the caret rectangle in CSS pixels to place the candidate window by.
  pub effect fn imeArea(self: &Self) -> ImeArea
    ! OutOfMemoryError
    ? &mut Allocator {
    let area = run edit.imeArea(self)
    if area.enabled || text_selection.focusedHost(self) == NONE { return area }
    // A focused editing host takes text too; the candidate window goes by its caret.
    let mut rect = Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
    drop run text_selection.caretRect(self, &mut rect)
    return ImeArea { enabled: true, rect: rect }
  }

  /// The time the focused caret blinks next, or -1 when no caret shows. Hosts that draw only
  /// on demand ask for a frame at that time.
  pub fn nextBlink(self: &Self) -> f64 {
    return edit.nextBlink(self)
  }

  /// When a `font-display` block or swap period ends, in frame time, or negative: text
  /// waiting for its face shows the fallback then, so the host draws a frame.
  pub fn fontWake(self: &Self) -> f64 {
    return self.fontBlockEnd
  }

  /// Whether a block or swap period ended by frame time `time` and no frame saw it yet.
  pub fn fontWakeDue(self: &Self, time: f64) -> bool {
    return self.fontBlockEnd >= 0.0 && time >= self.fontBlockEnd
  }

  /// When the tree next wants a frame without new input, in frame time: a caret blink, or the
  /// end of a `font-display` block period. Negative when it does not.
  pub fn nextWake(self: &Self) -> f64 {
    let blink = edit.nextBlink(self)
    if blink < 0.0 || self.fontBlockEnd >= 0.0 && self.fontBlockEnd < blink {
      return self.fontBlockEnd
    }
    return blink
  }

  /// The selection of input `id` as (anchor, focus) UTF-8 byte offsets into its value, or
  /// (0, 0) when it is not an input.
  pub fn selection(self: &Self, id: u32) -> Vector2<usize> {
    let slot = self.slotOf(id)
    if slot == NONE {
      return Vector2<usize> { x: 0, y: 0 }
    }
    if !self.node(slot).hasEdit() {
      return Vector2<usize> { x: 0, y: 0 }
    }
    let e = self.node(slot).edit()
    return Vector2<usize> { x: e.anchor, y: e.focus }
  }

  /// The caret rectangle of input `id` in CSS pixels of the viewport, from the last layout.
  pub effect fn caretRect(self: &Self, id: u32) -> Rect<f32>
    ! OutOfMemoryError
    ? &mut Allocator {
    let slot = self.slotOf(id)
    if slot == NONE || self.node(slot).kind != NodeKind.Input {
      return Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
    }
    return run edit.caretRectOf(self, slot)
  }

  /// Moves the queued event records to `out`, oldest first, but those of roots set aside.
  pub effect fn takeEvents(self: &mut Self, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.aside.length() != 0 {
      run self.takeWhere(NONE, &mut out)
      return ()
    }
    let mut reversed = List<Event>.make()
    while true {
      match self.events.pop() {
        Option<Event>.Some { value } => {
          run reversed.append(move value)
        }
        Option<Event>.None => {
          break
        }
      }
    }
    while true {
      match reversed.pop() {
        Option<Event>.Some { value } => {
          run out.append(move value)
        }
        Option<Event>.None => {
          break
        }
      }
    }
  }

  /// Moves the queued records whose path starts at root `root`'s node to `out`, oldest first:
  /// what a client that owns a root set aside takes (see `setAside`).
  pub effect fn takeEventsOf(self: &mut Self, root: u32, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.rootNode(root) == NONE {
      return ()
    }
    run self.takeWhere(root, &mut out)
  }

  /// Moves the records of root `root` to `out`, or with NONE, every record of no root set aside.
  effect fn takeWhere(self: &mut Self, root: u32, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let node = if root == NONE {
      NONE
    } else {
      self.rootNode(root)
    }
    let mut kept = List<Event>.make()
    let mut reversed = List<Event>.make()
    while true {
      match self.events.pop() {
        Option<Event>.Some { value } => {
          run reversed.append(move value)
        }
        Option<Event>.None => {
          break
        }
      }
    }
    while true {
      match reversed.pop() {
        Option<Event>.Some { value } => {
          let first = if value.path.length() == 0 {
            NONE
          } else {
            value.path.get(0)
          }
          let taken = if root == NONE {
            first == NONE || !self.asideRecord(first)
          } else {
            first == node
          }
          if taken {
            run out.append(move value)
          } else {
            run kept.append(move value)
          }
        }
        Option<Event>.None => {
          break
        }
      }
    }
    self.events = move kept
  }

  effect fn refreshSources(self: &mut Self, resource: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if resource >= CSS_IMAGE_BASE {
      // Stylesheet images are not node resources: repaint every node with a `url()` layer.
      let mut at: usize = 0
      while at < self.nodes.length() {
        let uses = match self.nodes.asSlice()[at].paintEffects() {
          Option<&Effects>.Some { value } => value.backgrounds.hasUrl() || value.masksHasUrl()
            || value.borderImageHasUrl() || value.maskBorderHasUrl()
          Option<&Effects>.None => false
        }
        if uses && self.nodes.asSlice()[at].live {
          let node = &mut self.nodes.asMutSlice()[at]
          node.content = node.content + 1
        }
        at = at + 1
      }
      self.paintCachesStale = true
      return ()
    }
    let mut slot: u32 = 0
    while u32.toUsize(slot) < self.nodes.length() {
      let matches = self.node(slot).live && self.node(slot).resource == resource
      if matches {
        let node = self.nodeMut(slot)
        node.content = node.content + 1
        self.paintCachesStale = true
        if self.parked.length() != 0 {
          let holder = self.rootHolding(slot)
          if holder != NONE && holder != self.current {
            self.touchRoot(holder)
          }
        }
        run self.updateNatural(slot)
      }
      slot = slot + 1
    }
  }

  /// Gives css-layout the natural size of an image or icon node.
  effect fn updateNatural(self: &mut Self, slot: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let kind = self.node(slot).kind
    let resource = self.node(slot).resource
    let fontSize = self.node(slot).computed().text.size
    // Natural sizes scale with `zoom`, as replaced elements do in browsers.
    let zoom = self.node(slot).computed().text.zoom
    let mut natural = NaturalDimensions.none()
    if kind == NodeKind.Canvas {
      // A canvas showing a GPU surface is a replaced element of the surface's size, as a
      // `<canvas>` is. One drawn with commands has no natural size.
      let surface = self.node(slot).surface()
      if surface.isSome() {
        natural.size = OptionalSize.definite(u32.toF32(surface.width) * zoom, u32.toF32(surface.height) * zoom)
        if surface.height != 0 {
          natural.aspectRatio = u32.toF32(surface.width) / u32.toF32(surface.height)
        }
      }
      run self.setNatural(slot, natural)
      return ()
    }
    if kind != NodeKind.Image && kind != NodeKind.Icon {
      return ()
    }
    let shown = self.resources.get(resource)
    let liveSize = match self.node(slot).svg.get() {
      Option<&LiveSvg>.Some { value } => [value.width, value.height]
      _ => [0.0, 0.0]
    }
    if liveSize[0] > 0.0 && liveSize[1] > 0.0 {
      natural.size = OptionalSize.definite(f64.toF32(liveSize[0]), f64.toF32(liveSize[1]))
      natural.aspectRatio = f64.toF32(liveSize[0] / liveSize[1])
    } else if let Option<Resource>.Some { value } = shown {
      match value {
        Resource.Image { width, height, .. } => {
          natural.size = OptionalSize.definite(u32.toF32(width) * zoom, u32.toF32(height) * zoom)
          if height != 0 {
            natural.aspectRatio = u32.toF32(width) / u32.toF32(height)
          }
        }
        // The root's own width and height, as an inline `<svg>` has; a square of the
        // font size where it gives none.
        Resource.Icon { icon } => {
          let width = self.resources.iconWidth(icon)
          let height = self.resources.iconHeight(icon)
          if width > 0.0 && height > 0.0 {
            natural.size = OptionalSize.definite(f64.toF32(width) * zoom, f64.toF32(height) * zoom)
            natural.aspectRatio = f64.toF32(width / height)
          } else {
            natural.size = OptionalSize.definite(fontSize, fontSize)
            natural.aspectRatio = 1.0
          }
        }
      }
    } else if kind == NodeKind.Icon {
      natural.size = OptionalSize.definite(fontSize, fontSize)
      natural.aspectRatio = 1.0
    }
    run self.setNatural(slot, natural)
  }

  /// Gives the layout the natural size of `slot` when it changed.
  effect fn setNatural(self: &mut Self, slot: u32, natural: NaturalDimensions) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let css = self.node(slot).css
    let key = u32.toUsize(slot)
    let changed = key >= self.provider.naturals.length()
      || !sameNatural(self.provider.naturals.get(key), natural)
    if changed {
      run self.provider.setNatural(key, natural)
      run Effect.catch<InvalidNode>(
        self.layout.setNaturalMeasurement(NodeId { index: css }, key),
        ignoreInvalid,
      )
    }
  }

  // Styles.

  /// The font key of a text style, registering it with the text system on first use.
  pub effect fn fontKeyOf(self: &mut Self, text: TextStyle) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let italic = text.style == FontStyle.Italic
    let mut treatment = Treatment {
      letterSpacing: text.letterSpacing,
      wordSpacing: text.wordSpacing,
      transform: text.textTransform,
      wordBreak: text.wordBreak,
      overflowWrap: text.overflowWrap,
      lineBreak: text.lineBreak,
      hyphens: text.hyphens,
      features: text.features,
    }
    // Palette and smoothing are paint's: keys do not differ by them.
    treatment.features.extras = text_fonts.withExtrasField(text_fonts.withExtrasField(text.features.extras, text_fonts.EXTRAS_PALETTE, 0), text_fonts.EXTRAS_SMOOTH, 0)
    let entries = self.fontKeys.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      let entry = entries[i]
      if entry.root == self.current && entry.family == text.family && entry.size == text.size && entry.weight == text.weight
        && entry.italic == italic && entry.width == text.width
        && sameTreatment(entry.treatment, treatment) {
        return entry.key
      }
      i = i + 1
    }
    let mut families = List<Family>.make()
    run self.families.copyOf(text.family, &mut families)
    let mut named = List<Bytes>.make()
    if text_fonts.extrasField(text.features.extras, text_fonts.EXTRAS_ALTERNATES) != 0 {
      let mut f: usize = 0
      while f < families.length() {
        if let Family.Named { name } = &families.asSlice()[f] {
          run named.append(run Bytes.copy(Bytes.asSlice(&name)))
        }
        f = f + 1
      }
    }
    run sheet_faces.mapFamilies(&self.sheetFaces,self.current,&mut families)
    let mut request = FontStyleRequest.make(move families, text.size)
    request.request = Request {
      weight: f32.toF64(text.weight),
      width: f32.toF64(text.width),
      style: if italic {
        FaceStyle.Italic
      } else {
        FaceStyle.Normal
      },
    }
    request.treatment = treatment
    request.variations = self.variations.axes(text.features.variations)
    request.sizeAdjust = self.fontRules.adjust(text_fonts.extrasField(text.features.extras, text_fonts.EXTRAS_SIZE_ADJUST))
    let alternates = text_fonts.extrasField(text.features.extras, text_fonts.EXTRAS_ALTERNATES)
    if alternates != 0 {
      let mut pairs = List<u32>.make()
      run self.fontRules.alternates(self.current, alternates, named.asSlice(), &mut pairs)
      let defined = if pairs.length() == 0 { Option<u32>.None } else { run self.provider.text.fonts.defineFeatures(pairs.asSlice()) }
      let resolved = match defined { Option.Some { value } => value _ => 0 }
      request.treatment.features.extras = text_fonts.withExtrasField(request.treatment.features.extras, text_fonts.EXTRAS_ALTERNATES, resolved)
    }
    let key = run self.provider.text.addStyle(move request)
    run self.fontKeys.append(
      FontKeyEntry {
        root: self.current,
        family: text.family,
        size: text.size,
        weight: text.weight,
        italic: italic,
        width: text.width,
        treatment: treatment,
        key: key,
      },
    )
    return key
  }

  /// The root's `@font-feature-values` changed: its styles get new font keys.
  fn fontRulesChanged(self: &mut Self) -> () {
    let entries = self.fontKeys.asMutSlice()
    let mut i: usize = 0
    while i < entries.length {
      if entries[i].root == self.current { entries[i].family = NONE }
      i = i + 1
    }
    let parked = self.parked.asMutSlice()
    let mut p: usize = 0
    while p < parked.length {
      parked[p].touched = true
      p = p + 1
    }
  }

  // Font faces added at run time.

  /// Text whose font-family list names `family` lays out again: its styles get new font
  /// keys, so css-layout measures it with the faces the font set has now.
  effect fn fontFamilyChanged(self: &mut Self, family: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut actual = run Bytes.copy(family)
    let mut root = NONE
    if let Option.Some { value } = sheet_faces.original(&self.sheetFaces,family) {
      actual = run Bytes.copy(value.name.asSlice())
      root = value.root
    }
    let mut changed = false
    let mut names = List<Family>.make()
    let mut i: usize = 0
    while i < self.fontKeys.length() {
      let list = self.fontKeys.get(i).family
      if list != NONE && (root == NONE || self.fontKeys.get(i).root == root) {
        names.clear()
        run self.families.copyOf(list, &mut names)
        let mut j: usize = 0
        while j < names.length() {
          if let Family.Named { name } = &names.asSlice()[j] {
            if sameFamilyName(Bytes.asSlice(&name), actual.asSlice()) {
              let entries = self.fontKeys.asMutSlice()
              entries[i].family = NONE
              changed = true
              break
            }
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    if !changed {
      return
    }
    self.markStylesDirty(14)
    let parked = self.parked.asMutSlice()
    let mut p: usize = 0
    while p < parked.length {
      parked[p].touched = true
      p = p + 1
    }
  }

  /// Adds the faces of a font file (TTF, OTF or a collection) under the family names the file
  /// gives, and returns how many it had. Text in those families lays out again with them.
  pub effect fn addFont(self: &mut Self, data: Bytes) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let set = &mut self.provider.text.fonts.set
    let first = set.declaredCount()
    let added = run set.addFont(move data)
    let mut i = first
    while i < first + added {
      let mut family = Bytes.make()
      run Bytes.append(&mut family, self.provider.text.fonts.set.familyOf(i))
      run self.fontFamilyChanged(Bytes.asSlice(&family))
      i = i + 1
    }
    return added
  }

  fn fontFaceIndex(self: &Self, id: u32) -> usize {
    let entries = self.fontFaces.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      if entries[i].id == id {
        return entries[i].declared
      }
      i = i + 1
    }
    return usize.MAX
  }

  /// Declares font face `id` as an `@font-face` rule does, before its file is there. Its
  /// family hides installed faces of the same name at once. When text laid out needs a
  /// character in its `unicode-range`, `takeRequests` gives `HostRequest.LoadFontFace`; the
  /// text draws with the next family that has the character until `loadFontFace`, then lays
  /// out again with the face (`font-display: swap`). Declaring an id again does nothing.
  pub effect fn declareFontFace(self: &mut Self, id: u32, rule: FaceRule) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.fontFaceIndex(id) != usize.MAX {
      return
    }
    let mut family = Bytes.make()
    run Bytes.append(&mut family, Bytes.asSlice(&rule.family))
    let declared = run self.provider.text.fonts.set.declare(move rule)
    run self.fontFaces.append(FontFaceEntry { id: id, declared: declared })
    run self.fontFamilyChanged(Bytes.asSlice(&family))
  }

  /// Gives declared font face `id` its file, face `index` of a TTF, OTF or collection.
  /// Text in its family lays out again. Returns false when the id is unknown or the data is
  /// no usable font; the face then counts as failed and the fallback stays.
  pub effect fn loadFontFace(self: &mut Self, id: u32, data: Bytes, index: u32) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let declared = self.fontFaceIndex(id)
    if declared == usize.MAX {
      return false
    }
    let ok = run self.provider.text.fonts.set.load(declared, move data, index)
    if ok {
      let mut family = Bytes.make()
      run Bytes.append(&mut family, self.provider.text.fonts.set.familyOf(declared))
      run self.fontFamilyChanged(Bytes.asSlice(&family))
    }
    if !ok && sheet_faces.retryable(&self.sheetFaces,id) { self.markStylesDirty(15) }
    return ok
  }

  /// Records that font face `id` could not load: its text keeps the fallback.
  pub fn failFontFace(self: &mut Self, id: u32) -> () {
    let declared = self.fontFaceIndex(id)
    if declared != usize.MAX {
      self.provider.text.fonts.set.markFailed(declared)
      if sheet_faces.retryable(&self.sheetFaces,id) { self.markStylesDirty(16) }
    }
  }

  pub effect fn loadLocalHostFontFace(self: &mut Self, id: u32, name: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
    let index = self.fontFaceIndex(id)
    if index == usize.MAX || !self.provider.text.fonts.set.loadLocal(index,name) { return false }
    let family = run Bytes.copy(self.provider.text.fonts.set.familyOf(index))
    run self.fontFamilyChanged(family.asSlice())
    return true
  }

  pub fn hostFontFaceFailed(self: &Self, id: u32) -> bool {
    let index = self.fontFaceIndex(id)
    return index != usize.MAX && self.provider.text.fonts.set.state(index) == FaceState.Failed
      && !self.provider.text.fonts.set.expired(index)
  }

  pub effect fn setHostFontFaceActive(self: &mut Self, id: u32, active: bool, order: usize) ! OutOfMemoryError ? &mut Allocator {
    let index = self.fontFaceIndex(id)
    if index != usize.MAX && self.provider.text.fonts.set.setActive(index,active,order) {
      let family = run Bytes.copy(self.provider.text.fonts.set.familyOf(index))
      run self.fontFamilyChanged(family.asSlice())
    }
  }

  pub effect fn retryHostFontFace(self: &mut Self, id: u32, url: string) ! OutOfMemoryError ? &mut Allocator {
    let index = self.fontFaceIndex(id)
    if index == usize.MAX || !self.provider.text.fonts.set.retry(index) { return () }
    run self.loads.append(Mutation.LoadFontFace { face: id, url: run String.copy(url) })
  }

  /// Moves the font faces text needed in the last layouts to the host requests.
  effect fn requestFontFaces(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run sheet_faces.retry(&mut self)
    if !self.provider.text.fonts.set.hasWanted() {
      return
    }
    let mut wanted = List<usize>.make()
    run self.provider.text.fonts.set.takeWanted(&mut wanted)
    let mut i: usize = 0
    while i < wanted.length() {
      let entries = self.fontFaces.asSlice()
      let mut j: usize = 0
      while j < entries.length {
        if entries[j].declared == wanted.get(i) {
          let id = entries[j].id
          let sources = self.faceSources.asMutSlice()
          let mut found = false
          let mut f: usize = 0
          while f < sources.length {
            if sources[f].id == id {
              found = true
              if !sources[f].asked {
                sources[f].asked = true
                let url = run String.copy(String.view(&sources[f].url))
                run self.loads.append(Mutation.LoadFontFace { face: id, url: move url })
              }
            }
            f = f + 1
          }
          drop sources
          if !found {
            run self.requests.append(HostRequest.LoadFontFace { face: id })
          }
        }
        j = j + 1
      }
      i = i + 1
    }
  }

  /// Restyles the nodes whose declarations use viewport units, after the viewport changed.
  /// The page zoom (see `setPageZoom`).
  pub fn pageZoom(self: &Self) -> f32 { return self.pageZoomFactor }

  /// Zooms the whole page, as a browser's Ctrl/Cmd + and - do: every length multiplies by
  /// `zoom` (from 0.25 to 5), text is laid out at the larger size and the page reflows against
  /// a viewport `zoom` times smaller. Returns whether the zoom changed.
  pub fn setPageZoom(self: &mut Self, zoom: f32) -> bool {
    let wanted: f32 = f32.max(MIN_PAGE_ZOOM, f32.min(MAX_PAGE_ZOOM, zoom))
    if wanted == self.pageZoomFactor { return false }
    self.pageZoomFactor = wanted
    self.markStylesDirty(17)
    let count = self.nodes.length()
    let mut slot: usize = 0
    while slot < count {
      if self.nodes.asSlice()[slot].live { self.restyle(usize.toU32(slot)) }
      slot = slot + 1
    }
    return true
  }

  /// The viewport width in CSS pixels, which media queries and viewport units read.
  pub fn cssWidth(self: &Self) -> f32 { return self.input.width / self.pageZoomFactor }
  pub fn cssHeight(self: &Self) -> f32 { return self.input.height / self.pageZoomFactor }

  /// The text the root inherits: the initial values at the page zoom.
  pub fn rootText(self: &Self) -> TextStyle {
    let mut text = TextStyle.initial()
    text.rezoom(self.pageZoomFactor)
    return text
  }

  /// The style the root inherits from.
  pub fn rootParent(self: &Self) -> Computed { return Computed.inheriting(self.rootText()) }

  fn restyleViewportUnits(self: &mut Self) -> () {
    let count = self.nodes.length()
    let mut slot: usize = 0
    while slot < count {
      let node = &self.nodes.asSlice()[slot]
      // Viewport units change values, not what selectors match.
      if node.live && (node.computed().usesViewport || placeholder.usesViewport(node) || scrollbar_parts.usesViewport(node)) {
        self.restyleLocal(usize.toU32(slot))
      }
      slot = slot + 1
    }
  }

  /// The media `input` gives the current root's stylesheets: what a script's `matchMedia`
  /// evaluates its queries against.
  pub fn mediaState(self: &Self, input: FrameInput) -> MediaState {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    let mut environment = Environment.headless(0.0, 0.0)
    if at != usize.MAX {
      environment = self.styleSheets.asSlice()[at].environment
    } else if let Option<Preferences>.Some { value } = &self.hostStylePreferences {
      value.apply(&mut environment)
    }
    environment.initial.viewportWidth = f32.toF64(input.width)
    environment.initial.viewportHeight = f32.toF64(input.height)
    environment.resolutionDppx = f32.toF64(input.scale)
    return MediaState.of(environment)
  }

  /// Updates host media inputs without restyling until a condition changes truth.
  pub fn setStylePreferences(self: &mut Self, preferences: Preferences) -> bool {
    if let Option<Preferences>.Some { value } = &self.hostStylePreferences {
      if value.bits() == preferences.bits() { return false }
    }
    self.hostStylePreferences = Option<Preferences>.some(preferences)
    let roots = self.styleSheets.asMutSlice()
    let mut i: usize = 0
    while i < roots.length {
      preferences.apply(&mut roots[i].environment)
      i = i + 1
    }
    return true
  }

  pub effect fn loadStyleSheet(self: &mut Self, root: u32, source: StyleSource) -> u32
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    while self.nextStyleId < 2147483648 && self.styleLoadState(root, self.nextStyleId).isSome() {
      self.nextStyleId = self.nextStyleId + 1
    }
    if self.nextStyleId >= 2147483648 { fail TreeError.StyleSheet { index: 0, root: root, sheet: 0 } }
    let id = self.nextStyleId
    self.nextStyleId = id + 1
    run self.requestStyleSheet(root, id, move source)
    return id
  }

  pub fn takeStyleLoads(self: &mut Self) -> List<StyleRequest> {
    return Intrinsic.replace(self.styleLoads, List<StyleRequest>.make())
  }

  fn cancelStyleLoad(self: &mut Self, root: u32, sheet: u32) -> () {
    let at = style_sheets.index(self.styleSheets.asSlice(), root)
    if at == usize.MAX { return () }
    let roots = self.styleSheets.asMutSlice()
    let mut i: usize = 0
    while i < roots[at].loads.length() {
      if roots[at].loads.asSlice()[i].sheet == sheet { drop roots[at].loads.remove(i) return () }
      i = i + 1
    }
  }

  pub fn styleLoadCurrent(self: &Self, ticket: StyleTicket) -> bool {
    let at = style_sheets.index(self.styleSheets.asSlice(), ticket.root)
    if at == usize.MAX { return false }
    let loads = self.styleSheets.asSlice()[at].loads.asSlice()
    let mut i: usize = 0
    while i < loads.length {
      if loads[i].sheet == ticket.sheet {
        return loads[i].generation == ticket.generation && loads[i].state == StyleLoadState.Loading
      }
      i = i + 1
    }
    return false
  }

  pub fn styleLoadState(self: &Self, root: u32, sheet: u32) -> Option<StyleLoadState> {
    let at = style_sheets.index(self.styleSheets.asSlice(), root)
    if at == usize.MAX { return Option<StyleLoadState>.None }
    let scope = &self.styleSheets.asSlice()[at]
    let mut i: usize = 0
    while i < scope.loads.length() {
      if scope.loads.asSlice()[i].sheet == sheet { return Option<StyleLoadState>.some(scope.loads.asSlice()[i].state) }
      i = i + 1
    }
    i = 0
    while i < scope.sheets.sheets().length {
      if scope.sheets.sheets()[i].id == sheet { return Option<StyleLoadState>.some(StyleLoadState.Ready) }
      i = i + 1
    }
    return Option<StyleLoadState>.None
  }

  pub effect fn requestStyleSheet(self: &mut Self, root: u32, sheet: u32, source: StyleSource) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    if !self.rootOpen(root) || self.styleGeneration == 18446744073709551615 {
      fail TreeError.StyleSheet { index: 0, root: root, sheet: sheet }
    }
    if self.styleLoadState(root, sheet).isNone() {
      let empty = run Sheet.make().encode()
      run self.adoptSheet(0, root, sheet, empty.asSlice(), false)
    }
    self.styleGeneration = self.styleGeneration + 1
    let ticket = StyleTicket { root: root, sheet: sheet, generation: self.styleGeneration }
    self.cancelStyleLoad(root, sheet)
    let at = style_sheets.index(self.styleSheets.asSlice(), root)
    let roots = self.styleSheets.asMutSlice()
    let base = match &source { StyleSource.Url { url } => run String.copy(String.view(&url)) _ => String.make() }
    run roots[at].loads.append(StyleStatus { base: move base, sheet: sheet, generation: ticket.generation, state: StyleLoadState.Loading })
    drop roots
    run self.styleLoads.append(StyleRequest { ticket: ticket, source: move source })
  }

  pub effect fn settleStyleSheet(self: &mut Self, ticket: StyleTicket, bytes: Option<Bytes>) -> bool
    ! OutOfMemoryError ? &mut Allocator {
    if !self.styleLoadCurrent(ticket) { return false }
    let mut base = String.make()
    let rootIndex = style_sheets.index(self.styleSheets.asSlice(),ticket.root)
    let statuses = self.styleSheets.asSlice()[rootIndex].loads.asSlice()
    let mut status: usize = 0
    while status < statuses.length {
      if statuses[status].sheet == ticket.sheet { base = run String.copy(String.view(&statuses[status].base)) break }
      status = status + 1
    }
    let mut state = StyleLoadState.Failed
    if let Option<Bytes>.Some { value } = move bytes {
      let result = run Effect.result(self.adoptSheetFrom(0, ticket.root, ticket.sheet, value.asSlice(), true, String.view(&base)))
      match move result {
        Result.Success { .. } => { state = StyleLoadState.Ready }
        Result.Failure { error } => match move error {
          OutOfMemoryError allocation => { fail move allocation }
          TreeError invalid => { drop invalid }
        }
      }
    }
    let at = style_sheets.index(self.styleSheets.asSlice(), ticket.root)
    let roots = self.styleSheets.asMutSlice()
    let loads = roots[at].loads.asMutSlice()
    let mut i: usize = 0
    while i < loads.length {
      if loads[i].sheet == ticket.sheet { loads[i].state = state break }
      i = i + 1
    }
    return true
  }

  fn rootSheets(self: &Self, root: u32) -> RootSheets {
    let mut sheets = RootSheets.make(root)
    if let Option<Preferences>.Some { value } = &self.hostStylePreferences {
      value.apply(&mut sheets.environment)
    }
    return move sheets
  }

  effect fn enableInlineScope(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX {
      at = self.styleSheets.length()
      let sheets = self.rootSheets(self.current)
      run self.styleSheets.append(move sheets)
    }
    let roots = self.styleSheets.asMutSlice()
    roots[at].inlineVariables = true
  }

  pub effect fn setStyleEnvironment(self: &mut Self, root: u32, environment: Environment, systemColors: [SheetColor; 19]) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    if !self.rootOpen(root) { fail TreeError.StyleSheet { index: 0, root: root, sheet: 0 } }
    let mut at = style_sheets.index(self.styleSheets.asSlice(), root)
    if at == usize.MAX {
      at = self.styleSheets.length()
      let sheets = self.rootSheets(root)
      run self.styleSheets.append(move sheets)
    }
    let roots = self.styleSheets.asMutSlice()
    roots[at].environment = environment
    roots[at].systemColors = systemColors
    if root == self.current { self.markStylesDirty(18) }
    else {
      let parked = self.parkedIndex(root)
      let states = self.parked.asMutSlice()
      states[parked].stylesDirty = true
      states[parked].touched = true
    }
  }

  /// Registers compiled application stylesheets to adopt automatically when `FIRST_ROOT` opens.
  pub effect fn setPendingFirstRootSheets(self: &mut Self, sources: &[Bytes]) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    self.pendingFirstRootSheets.clear()
    let mut i: usize = 0
    while i < sources.length {
      run self.pendingFirstRootSheets.append(run Bytes.copy(sources[i].asSlice()))
      i = i + 1
    }
  }

  effect fn installPendingFirstRootSheets(self: &mut Self, index: usize) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let sources = Intrinsic.replace(self.pendingFirstRootSheets, List<Bytes>.make())
    let mut i: usize = 0
    while i < sources.length() {
      let id = u32.MAX - usize.toU32(i)
      run self.adoptSheet(index, FIRST_ROOT, id, sources.asSlice()[i].asSlice(), false)
      i = i + 1
    }
  }

  effect fn adoptSheet(self: &mut Self, index: usize, root: u32, id: u32, bytes: &[u8], replace: bool) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    run self.adoptSheetFrom(index,root,id,bytes,replace,"")
  }

  effect fn adoptSheetFrom(self: &mut Self, index: usize, root: u32, id: u32, bytes: &[u8], replace: bool, base: string) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    if !self.rootOpen(root) { fail TreeError.StyleSheet { index: index, root: root, sheet: id } }
    let decoded = run Effect.result(Sheet.decode(bytes, &Limits.make()))
    let mut sheet = match move decoded {
      Result<Sheet, DecodeError | OutOfMemoryError>.Success { value } => move value
      Result<Sheet, DecodeError | OutOfMemoryError>.Failure { error: why } => {
        match move why { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { fail TreeError.StyleSheet { index: index, root: root, sheet: id } } }
      }
    }
    run sheet_urls.rebase(&mut sheet,base)
    let mut at = style_sheets.index(self.styleSheets.asSlice(), root)
    if at == usize.MAX {
      if replace { fail TreeError.StyleSheet { index: index, root: root, sheet: id } }
      at = self.styleSheets.length()
      let sheets = self.rootSheets(root)
      run self.styleSheets.append(move sheets)
    }
    let roots = self.styleSheets.asMutSlice()
    let changed = if replace { run Effect.result(roots[at].sheets.replace(id, move sheet)) }
      else { run Effect.result(roots[at].sheets.adopt(id, move sheet)) }
    if let Result<(), AdoptionError | OutOfMemoryError>.Failure { error: why } = move changed {
      match move why { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { fail TreeError.StyleSheet { index: index, root: root, sheet: id } } }
    }
    drop run self.useRoot(root)
    self.markStylesDirty(19)
  }

  pub effect fn resolveGeneratedStyle(self: &mut Self, origin: u32, target: PseudoTarget, states: StateBits, rendered: bool) -> Resolved
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let resolved = run self.resolvePseudoStyle(origin, target, states, rendered)
    return move resolved.style
  }

  /// Records on `origin` that the match of one of its pseudo-elements read `reads`, when that
  /// includes the place of an element among its siblings (`WATCH_PSEUDO_PLACE`).
  fn notePseudoReads(self: &mut Self, origin: u32, reads: u32) -> () {
    let place = css_selectors.READS_INDEX | css_selectors.READS_SIBLINGS
    if u32.bitAnd(reads, u32.bitOr(place, u32.shiftLeft(place, css_selectors.READS_ABOVE))) == 0 { return () }
    let node = self.nodeMut(origin)
    node.styleWatch = u32.bitOr(node.styleWatch, WATCH_PSEUDO_PLACE)
  }

  pub effect fn resolvePseudoStyle(self: &mut Self, origin: u32, target: PseudoTarget, states: StateBits, rendered: bool) -> Resolution
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX { fail TreeError.StyleSheet { index: 0, root: self.current, sheet: 0 } }
    let mut roots = Intrinsic.replace(self.styleSheets, List<RootSheets>.make())
    let entries = roots.asMutSlice()
    let mut stops = Intrinsic.replace(self.easingStops, EasingStops.make())
    let result = run Effect.result(style_sheets.resolvePseudo(&mut entries[at].sheets, &mut entries[at].cache,
      entries[at].systemColors, entries[at].hasStarting, &self, origin, target, states, rendered, &mut stops))
    self.easingStops = move stops
    self.styleSheets = move roots
    match move result {
      Result<Resolution, ResolverError | RegistrationError | CssError | OutOfMemoryError>.Success { value } => {
        run container_watch.record(&mut self, origin, target, value.containers.asSlice())
        self.noteWatches(origin, value.watched.asSlice(), value.watchAll)
        self.notePseudoReads(origin, value.style.reads)
        return move value
      }
      Result<Resolution, ResolverError | RegistrationError | CssError | OutOfMemoryError>.Failure { error: why } => {
        match move why { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { fail TreeError.StyleSheet { index: 0, root: self.current, sheet: 0 } } }
      }
    }
  }

  effect fn mayGenerate(self: &mut Self, origin: u32, target: PseudoTarget) -> bool
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX { return true }
    let mut roots = Intrinsic.replace(self.styleSheets, List<RootSheets>.make())
    let entries = roots.asMutSlice()
    let mut read: u32 = 0
    let result = run Effect.result(style_sheets.mayGenerate(&mut entries[at].sheets, &self, origin, target, &mut read))
    self.styleSheets = move roots
    self.notePseudoReads(origin, read)
    match move result {
      Result<bool, ResolverError | CssError | OutOfMemoryError>.Success { value } => { return value }
      Result<bool, ResolverError | CssError | OutOfMemoryError>.Failure { error: why } => {
        match move why { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { return true } }
      }
    }
  }

  effect fn installResolved(self: &mut Self, slot: u32, resolvedStyle: Resolved) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let mut value = move resolvedStyle
    if let Option<List<Declaration>>.Some { value: named } = move run self.namedFamilies(value.declarations.asSlice()) {
      value.declarations = move named
    }
    let namedStarting = match &value.starting {
      Option<List<Declaration>>.Some { value: before } => run self.namedFamilies(before.asSlice())
      Option<List<Declaration>>.None => Option<List<Declaration>>.None
    }
    if let Option<List<Declaration>>.Some { value: named } = move namedStarting {
      value.starting = Option<List<Declaration>>.some(move named)
    }
    let shared = run Frozen<Resolved>.make(move value)
    let node = self.nodeMut(slot)
    node.resolvedSheet = Option<Frozen<Resolved>>.some(move shared)
  }

  effect fn resolveSheet(self: &mut Self, slot: u32) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    // The record this installs carries the node's scope again.
    let unmoved = self.nodeMut(slot)
    unmoved.movedScope = NONE
    if at == usize.MAX || (self.styleSheets.asSlice()[at].sheets.length() == 0 && !self.styleSheets.asSlice()[at].inlineVariables) || self.node(slot).kind == NodeKind.Text {
      let node = self.nodeMut(slot)
      node.resolvedSheet = Option<Frozen<Resolved>>.None
      node.styleClass = 0
      node.styleTwin = NONE
      self.work.sheetSkips = self.work.sheetSkips + 1
      run container_watch.record(&mut self, slot, PseudoTarget.None, &[])
      return ()
    }
    let reads = self.styleSheets.asSlice()[at].reads
    let sheets = &self.styleSheets.asSlice()[at]
    let sheetStarting = sheets.hasStarting && (self.overrides.length() != 0 || sheets.startingSubjects.mayMatch(self.node(slot)))
    if !sheetStarting {
      let twin = style_share.twin(&self, slot, reads, self.styleSheets.asSlice()[at].sharing)
      if twin != NONE {
        let shared = match &self.node(twin).resolvedSheet {
          Option<Frozen<Resolved>>.Some { value } => Option<Frozen<Resolved>>.some(value.clone())
          _ => Option<Frozen<Resolved>>.None
        }
        let class = self.node(twin).styleClass
        // An equal node is asked the same of itself; the twin's own match asked no other node.
        let watch = self.node(twin).styleWatch
        let askedUp = u32.shiftRight(watch, ASKED_UP_SHIFT)
        let moved = self.node(twin).movedScope
        let node = self.nodeMut(slot)
        node.resolvedSheet = move shared
        node.movedScope = moved
        node.styleClass = class
        node.styleTwin = twin
        node.styleWatch = u32.bitOr(u32.bitAnd(node.styleWatch, WATCH_KEPT), watch)
        if askedUp != 0 { self.askUp(slot, askedUp) }
        self.work.sheetTwins = self.work.sheetTwins + 1
        run container_watch.record(&mut self, slot, PseudoTarget.None, &[])
        return ()
      }
    }
    let class = self.styleClasses + 1
    self.styleClasses = class
    self.work.sheetMatches = self.work.sheetMatches + 1
    let fresh = self.nodeMut(slot)
    fresh.styleClass = class
    fresh.styleTwin = NONE
    fresh.styleWatch = u32.bitAnd(fresh.styleWatch, WATCH_KEPT)
    let mut roots = Intrinsic.replace(self.styleSheets, List<RootSheets>.make())
    let entries = roots.asMutSlice()
    let mut stops = Intrinsic.replace(self.easingStops, EasingStops.make())
    let resolved = run Effect.result(style_sheets.resolve(&mut entries[at].sheets, &mut entries[at].cache, entries[at].systemColors, sheetStarting, &self, slot, &mut stops))
    self.easingStops = move stops
    self.styleSheets = move roots
    match move resolved {
      Result<Resolution, ResolverError | RegistrationError | CssError | OutOfMemoryError>.Success { value } => {
        run container_watch.record(&mut self, slot, PseudoTarget.None, value.containers.asSlice())
        self.noteWatches(slot, value.watched.asSlice(), value.watchAll)
        let key = style_share.modelKey(&self, slot)
        if key != 0 { drop run self.styleModels.insert(key, slot) }
        if let Option<Frozen<Resolved>>.Some { value: shared } = move value.hit {
          self.work.sheetCacheHits = self.work.sheetCacheHits + 1
          let node = self.nodeMut(slot)
          node.resolvedSheet = Option<Frozen<Resolved>>.some(move shared)
          return ()
        }
        run self.installResolved(slot, move value.style)
        if let Option<PendingStyle>.Some { value: pending } = move value.pending {
          let style = match &self.node(slot).resolvedSheet {
            Option<Frozen<Resolved>>.Some { value: installed } => installed.clone()
            _ => { return () }
          }
          let roots = self.styleSheets.asMutSlice()
          run roots[at].cache.insert(move pending, move style)
        }
      }
      Result<Resolution, ResolverError | RegistrationError | CssError | OutOfMemoryError>.Failure { error: why } => {
        match move why { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { fail TreeError.StyleSheet { index: 0, root: self.current, sheet: 0 } } }
      }
    }
  }

  /// Flags the nodes that the match for `slot` (or a part of it) watched.
  fn noteWatches(self: &mut Self, slot: u32, watched: &[css_element.Watch], all: bool) -> () {
    if watched.length == 0 && !all { return () }
    let mut outside = all
    let mut siblings = false
    if all {
      self.work.watchOverflows = self.work.watchOverflows + 1
      self.work.lastOverflow = u32.toUsize(slot)
    }
    let pointer = css_element.WATCH_HOVER | css_element.WATCH_ACTIVE
    // The watched nodes whose pointer state this match asked from outside their near subtree.
    let mut far: u32 = 0
    let mut i: usize = 0
    while i < watched.length {
      let at = watched[i].node
      if at != u32.toUsize(slot) {
        let depth = if u32.bitAnd(watched[i].bits, u32.bitNot(pointer)) == 0 { self.depthAbove(slot, usize.toU32(at)) } else { 0 }
        if depth == 0 {
          outside = true
          if u32.bitAnd(watched[i].bits, pointer) != 0 { far = u32.bitOr(far, u32.shiftLeft(1, usize.toU32(i))) }
        }
        else {
          let own = self.nodeMut(slot)
          own.styleWatch = u32.bitOr(own.styleWatch, u32.shiftLeft(1, ASKED_UP_SHIFT + depth - 1))
        }
      }
      i = i + 1
    }
    let nodes = self.nodes.asMutSlice()
    i = 0
    while i < watched.length {
      let at = watched[i].node
      let mut bits = watched[i].bits
      if at != u32.toUsize(slot) && u32.bitAnd(bits, css_element.WATCH_HAS) != 0 { bits = u32.bitOr(bits, WATCH_HAS_FOR_OTHERS) }
      if u32.bitAnd(far, u32.shiftLeft(1, usize.toU32(i))) != 0 { bits = u32.bitOr(bits, WATCH_POINTER_FAR) }
      nodes[at].styleWatch = u32.bitOr(nodes[at].styleWatch, bits)
      if u32.bitAnd(watched[i].bits, css_element.WATCH_HAS_SIBLINGS) != 0 { siblings = true }
      i = i + 1
    }
    if outside { nodes[u32.toUsize(slot)].styleWatch = u32.bitOr(nodes[u32.toUsize(slot)].styleWatch, WATCH_OUTSIDE) }
    if all {
      self.watchAround(slot)
      siblings = true
    }
    if siblings {
      let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
      if at == usize.MAX { return () }
      let roots = self.styleSheets.asMutSlice()
      roots[at].siblingAnchors = true
      if all { roots[at].watchOverflowed = true }
    }
  }

  /// How many levels above `slot` its ancestor `other` is, or zero when it is not one within 16.
  fn depthAbove(self: &Self, slot: u32, other: u32) -> u32 {
    let mut up = self.node(slot).parent
    let mut depth: u32 = 1
    while up != NONE && depth <= 16 {
      if up == other { return depth }
      up = self.node(up).parent
      depth = depth + 1
    }
    return 0
  }

  /// Flags the ancestors of `slot` that `askedUp` names as asked their pointer states.
  fn askUp(self: &mut Self, slot: u32, askedUp: u32) -> () {
    let mut up = self.node(slot).parent
    let mut depth: u32 = 0
    while up != NONE && depth < 16 {
      if u32.bitAnd(askedUp, u32.shiftLeft(1, depth)) != 0 {
        let node = self.nodeMut(up)
        node.styleWatch = u32.bitOr(node.styleWatch, css_element.WATCH_HOVER | css_element.WATCH_ACTIVE)
      }
      up = self.node(up).parent
      depth = depth + 1
    }
  }

  /// Flags every element a match for `slot` can have watched when it watched more than a match
  /// context holds: combinators only step to parents and earlier siblings, so those are `slot`,
  /// its ancestors and the elements before each of them.
  fn watchAround(self: &mut Self, slot: u32) -> () {
    let bits = WATCH_KEPT
    let mut up = slot
    while up != NONE {
      let mut beside = up
      while beside != NONE {
        let node = self.nodeMut(beside)
        node.styleWatch = u32.bitOr(node.styleWatch, bits)
        beside = self.elementBeside(beside, true)
      }
      up = self.node(up).parent
    }
  }


  fn hasPlayingAnimation(self: &Self, slot: u32) -> bool {
    if self.animations.length() == 0 { return false }
    let range = animation.rangeOf(self.animations.asSlice(), slot)
    return range[0] < range[1]
  }

  /// The node whose computed values `slot` can copy, or NONE: the twin it just took its record
  /// from, when both inherit from one parent, or from parents that hold one set of values, and
  /// nothing feeds the style but that record and what is inherited. Motion, inspector
  /// overrides, anchors and focus are per node, so any of them keeps the node computing.
  fn computedLender(self: &Self, slot: u32) -> u32 {
    if self.overrides.length() != 0 { return NONE }
    let node = self.node(slot)
    let lender = node.styleTwin
    if lender == NONE || node.kind != NodeKind.Box || node.isGenerated() || self.focused == slot || self.focused == lender { return NONE }
    if node.activeTransitions != 0 || node.hasTransition() || node.starting().length != 0 || node.styleNeedsContext { return NONE }
    let other = self.node(lender)
    if !other.live || other.styleDirty || other.computedStamp == 0 || other.styleClass != node.styleClass { return NONE }
    if other.kind != NodeKind.Box || other.isGenerated() || other.activeTransitions != 0 || other.hasTransition() || other.styleNeedsContext { return NONE }
    if other.hovered != node.hovered || other.pressed != node.pressed { return NONE }
    if self.hasPlayingAnimation(slot) || self.hasPlayingAnimation(lender) { return NONE }
    if self.anchors.length() != 0 && (anchoring.find(&self, node.id) != usize.MAX || anchoring.find(&self, other.id) != usize.MAX) { return NONE }
    let same = match &node.resolvedSheet {
      Option<Frozen<Resolved>>.Some { value: mine } => match &other.resolvedSheet {
        Option<Frozen<Resolved>>.Some { value: theirs } => Frozen.same(&mine, &theirs) && mine.get().plain
        _ => false
      }
      _ => false
    }
    if !same { return NONE }
    let values = &other.computed().*
    if values.viewportWidth != self.cssWidth() || values.viewportHeight != self.cssHeight() || values.usesContainer { return NONE }
    let none = usize.MAX
    if values.transition.properties.start != none || values.transition.durations.start != none || values.transition.delays.start != none
      || values.transition.easings.start != none || values.transition.discrete.start != none || values.animation.names.start != none { return NONE }
    if node.parent != other.parent {
      if node.parent == NONE || other.parent == NONE { return NONE }
      let above = self.node(node.parent)
      let beside = self.node(other.parent)
      if above.computedStamp == 0 || above.computedStamp != beside.computedStamp || above.rendered != beside.rendered { return NONE }
    }
    return lender
  }

  /// The lender's finished values, or the initial ones to apply this node's declarations to.
  /// The index in `tickBases` of the style under the animations of the node at `slot`, or
  /// `usize.MAX` when none holds.
  fn tickBaseOf(self: &Self, slot: u32) -> usize {
    let at = u32.toUsize(slot)
    if at >= self.tickPlaces.length() { return usize.MAX }
    let place = self.tickPlaces.get(at)
    if place == 0 { return usize.MAX }
    let index = u32.toUsize(place) - 1
    if self.tickBases.asSlice()[index].id != self.node(slot).id { return usize.MAX }
    return index
  }

  /// Keeps `computed` as the style under the animations of the node at `slot` when it `plays`
  /// some, and forgets the one it had when it does not.
  effect fn keepTickBase(self: &mut Self, slot: u32, computed: &Computed, plays: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = u32.toUsize(slot)
    let place = if at < self.tickPlaces.length() { self.tickPlaces.get(at) } else { 0 }
    if !plays {
      if place != 0 {
        let bases = self.tickBases.asMutSlice()
        bases[u32.toUsize(place) - 1].id = NONE
      }
      return ()
    }
    let id = self.node(slot).id
    if place != 0 {
      let bases = self.tickBases.asMutSlice()
      bases[u32.toUsize(place) - 1] = TickBase { id: id, computed: computed.*, samples: KeptSamples.none() }
      return ()
    }
    let held = self.tickPlaces.length()
    if at >= held {
      run self.tickPlaces.appendRepeated(0, at + 1 - held)
    }
    run self.tickBases.append(TickBase { id: id, computed: computed.*, samples: KeptSamples.none() })
    self.tickPlaces.set(at, usize.toU32(self.tickBases.length()))
  }

  /// The style a node of `kind` has until its first resolve.
  effect fn freshStyle(self: &mut Self, kind: NodeKind) -> Frozen<Computed> ! OutOfMemoryError ? &mut Allocator {
    let known = self.freshStyles.asSlice()
    let mut i: usize = 0
    while i < known.length {
      if known[i].kind == kind { return known[i].styled.clone() }
      i = i + 1
    }
    let mut computed = Computed.inheriting(TextStyle.initial())
    computed.layout.display = defaultDisplay(kind)
    let styled = run self.stylePool.share(&computed)
    run self.freshStyles.append(FreshStyle { kind: kind, styled: styled.clone() })
    return move styled
  }

  /// Gives the node at `slot` the style `value`: the handle it has when that already holds
  /// these values, else the pool's handle to them.
  pub effect fn setComputed(self: &mut Self, slot: u32, value: &Computed) -> () ! OutOfMemoryError ? &mut Allocator {
    let node = self.node(slot)
    if node.moving.isNone() && style_pool.same(node.styled.get(), value) { return () }
    let shared = run self.stylePool.share(value)
    self.work.styleShares = self.work.styleShares + 1
    let target = self.nodeMut(slot)
    target.styled = move shared
    target.moving.clear()
  }

  /// Gives the node at `slot` the style `value` of a frame of the clock. An animation or a
  /// transition gives a node a style no other has and replaces it next frame: through the
  /// pool each frame would key it, hash it and allocate it. The node holds it alone instead
  /// and the next frame writes over it; its next full restyle shares again (`setComputed`).
  effect fn setMovingComputed(self: &mut Self, slot: u32, value: &Computed) -> () ! OutOfMemoryError ? &mut Allocator {
    let target = self.nodeMut(slot)
    match target.moving.getMut() {
      Option<&mut Computed>.Some { value: held } => {
        held.* = value.*
      }
      Option<&mut Computed>.None => {
        target.moving.set(run Thin<Computed>.make(value.*))
      }
    }
  }

  fn valuesToStartFrom(self: &Self, lender: u32, inherited: TextStyle) -> Computed {
    if lender != NONE { return self.node(lender).computed().* }
    return Computed.inViewport(inherited, self.cssWidth(), self.cssHeight())
  }

  effect fn syncGenerated(self: &mut Self, origin: u32) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    if self.node(origin).isGenerated() || self.node(origin).kind != NodeKind.Box { return () }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    let enabled = at != usize.MAX && self.styleSheets.asSlice()[at].sheets.length() != 0 && self.styleSheets.asSlice()[at].hasGenerated
    let targets = [PseudoTarget.Before, PseudoTarget.After]
    let mut i: usize = 0
    while i < targets.length {
      let target = targets[i]
      let old = match self.node(origin).identity() {
        Option.Some { value } => if target == PseudoTarget.Before { value.before } else { value.after }
        _ => NONE
      }
      let mut prepared = Option<Resolved>.None
      let mut content = Option<String>.None
      let maySubject = if !enabled { false }
        else if target == PseudoTarget.Before { self.styleSheets.asSlice()[at].beforeSubjects.mayMatch(self.node(origin), self.isRootNode(origin)) }
        else { self.styleSheets.asSlice()[at].afterSubjects.mayMatch(self.node(origin), self.isRootNode(origin)) }
      // A pseudo-element with no box yet keeps none unless something may give it content.
      if enabled && (old != NONE || (maySubject && run self.mayGenerate(origin, target))) {
        let rendered = old != NONE && style_change.rendered(&self, old)
        let value = run self.resolveGeneratedStyle(origin, target, StateBits.empty(), rendered)
        let mut counted = false
        content = run Effect.catchAll(generated.content(&self, origin, value.declarations.asSlice(), &Scope.empty(), &mut counted), generatedFailed)
        if counted {
          self.listsUsed = true
          self.listsDirty = true
        }
        prepared = Option<Resolved>.some(move value)
      }
      if let Option<String>.Some { value: text } = move content {
        let mut slot = old
        if slot == NONE {
          let id = self.node(origin).id
          slot = run self.createNode(0, id, NodeKind.Box, origin, target)
          let child = run self.createNode(0, id, NodeKind.Text, origin, target)
          let parentCss = self.node(origin).css
          let boxCss = self.node(slot).css
          let textCss = self.node(child).css
          let mut first = self.layout.firstChild(parentCss)
          // ::before follows the ::marker box, which stays first.
          if let Option.Some { value } = self.node(origin).identity() {
            if value.marker != NONE && first == self.node(value.marker).css { first = self.layout.nextSibling(first) }
          }
          let before = if target == PseudoTarget.Before && first != NO_INDEX { Option<NodeId>.some(NodeId { index: first }) } else { Option<NodeId>.None }
          run Effect.catchAll(self.layout.insertBefore(NodeId { index: parentCss }, NodeId { index: boxCss }, before), layoutFailed)
          run Effect.catchAll(self.layout.insertBefore(NodeId { index: boxCss }, NodeId { index: textCss }, Option<NodeId>.None), layoutFailed)
          let boxNode = self.nodeMut(slot)
          boxNode.parent = origin
          let textNode = self.nodeMut(child)
          textNode.parent = slot
          let originNode = self.nodeMut(origin)
          let identity = run originNode.identityMut()
          if target == PseudoTarget.Before { identity.before = slot } else { identity.after = slot }
        }
        let active = self.nodeMut(slot)
        active.generatedSuppressed = false
        let child = self.slotOfCssNode(self.layout.firstChild(self.node(slot).css))
        if String.view(&self.node(child).text) != String.view(&text) { run self.setText(0, child, move text) }
        if let Option<Resolved>.Some { value } = move prepared { run self.installResolved(slot, move value) }
      } else if old != NONE && style_change.tracks(&self, origin) {
        let dormant = self.nodeMut(old)
        dormant.generatedSuppressed = true
        if let Option<Resolved>.Some { value } = move prepared { run self.installResolved(old, move value) }
      } else if old != NONE {
        let originNode = self.nodeMut(origin)
        let identity = run originNode.identityMut()
        if target == PseudoTarget.Before { identity.before = NONE } else { identity.after = NONE }
        run self.destroy(0, old)
      }
      i = i + 1
    }
  }

  /// Keeps the `::marker` box of a list item (CSS Lists 3 §3): the origin's first layout child,
  /// holding one text node that the counters pass (`lists.update`) fills.
  @inlineNever
  effect fn syncMarker(self: &mut Self, origin: u32) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let node = self.node(origin)
    if node.kind != NodeKind.Box || node.isGenerated() { return () }
    let old = match node.identity() { Option.Some { value } => value.marker _ => NONE }
    let list = node.computed().list
    if !list.item() && old == NONE { return () }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    let styled = list.item() && at != usize.MAX && self.styleSheets.asSlice()[at].hasMarker
    let mut prepared = Option<Resolved>.None
    let mut wanted = list.item() && list.typeCode() != LIST_NONE
    if styled {
      let rendered = old != NONE && style_change.rendered(&self, old)
      let value = run self.resolveGeneratedStyle(origin, PseudoTarget.Marker, StateBits.empty(), rendered)
      let content = lists.markerContent(value.declarations.asSlice())
      if content == lists.CONTENT_NONE { wanted = false }
      if content == lists.CONTENT_SET { wanted = true }
      prepared = Option<Resolved>.some(move value)
    }
    if !wanted {
      if old != NONE {
        let originNode = self.nodeMut(origin)
        let identity = run originNode.identityMut()
        identity.marker = NONE
        run self.destroy(0, old)
      }
      return ()
    }
    let mut slot = old
    if slot == NONE {
      let id = self.node(origin).id
      slot = run self.createNode(0, id, NodeKind.Box, origin, PseudoTarget.Marker)
      let child = run self.createNode(0, id, NodeKind.Text, origin, PseudoTarget.Marker)
      let parentCss = self.node(origin).css
      let first = self.layout.firstChild(parentCss)
      let before = if first != NO_INDEX { Option<NodeId>.some(NodeId { index: first }) } else { Option<NodeId>.None }
      let boxCss = self.node(slot).css
      let textCss = self.node(child).css
      run Effect.catchAll(self.layout.insertBefore(NodeId { index: parentCss }, NodeId { index: boxCss }, before), layoutFailed)
      run Effect.catchAll(self.layout.insertBefore(NodeId { index: boxCss }, NodeId { index: textCss }, Option<NodeId>.None), layoutFailed)
      let boxNode = self.nodeMut(slot)
      boxNode.parent = origin
      let textNode = self.nodeMut(child)
      textNode.parent = slot
      let originNode = self.nodeMut(origin)
      let identity = run originNode.identityMut()
      identity.marker = slot
    }
    self.listsUsed = true
    self.listsDirty = true
    if let Option<Resolved>.Some { value } = move prepared { run self.installResolved(slot, move value) }
  }

  /// Keeps the `::first-letter` box of block container `origin` (CSS Pseudo 4 §2.5): an inline
  /// box before the text the letter comes from, under that text's parent, holding the letter;
  /// css-layout reads that text from after the letter.
  @inlineNever
  /// Whether `syncFirstLetter` has anything to do at `slot`.
  fn letterCandidate(self: &Self, slot: u32) -> bool {
    let node = self.node(slot)
    if node.kind != NodeKind.Box || node.isGenerated() { return false }
    let held = match node.identity() { Option.Some { value } => value.letterBox != NONE || value.letterRules _ => false }
    if held { return true }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    return at != usize.MAX && self.styleSheets.asSlice()[at].hasFirstLetter
      && self.styleSheets.asSlice()[at].firstLetterSubjects.mayMatch(node, self.isRootNode(slot))
  }

  /// Whether `syncFirstLine` has anything to do at `slot`.
  fn lineCandidate(self: &Self, slot: u32) -> bool {
    let node = self.node(slot)
    if node.kind != NodeKind.Box || node.isGenerated() { return false }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    return at != usize.MAX && self.styleSheets.asSlice()[at].hasFirstLine
      && self.styleSheets.asSlice()[at].firstLineSubjects.mayMatch(node, self.isRootNode(slot))
  }

  effect fn syncFirstLetter(self: &mut Self, origin: u32) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let node = self.node(origin)
    if node.kind != NodeKind.Box || node.isGenerated() { return () }
    let old = match node.identity() { Option.Some { value } => value.letterBox _ => NONE }
    let ruled = match node.identity() { Option.Some { value } => value.letterRules _ => false }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    let enabled = at != usize.MAX && self.styleSheets.asSlice()[at].hasFirstLetter && node.rendered && first_letter.blockContainer(&node.computed().*)
    if !enabled && old == NONE && !ruled { return () }
    let mut prepared = Option<Resolved>.None
    let mut wanted = false
    if enabled {
      let rendered = old != NONE && style_change.rendered(&self, old)
      let value = run self.resolveGeneratedStyle(origin, PseudoTarget.FirstLetter, StateBits.empty(), rendered)
      wanted = value.declarations.length() != 0
      prepared = Option<Resolved>.some(move value)
    }
    if wanted || ruled {
      let originNode = self.nodeMut(origin)
      let identity = run originNode.identityMut()
      identity.letterRules = wanted
    }
    let target = if wanted { self.letterTarget(origin) } else { NONE }
    let mut letter = first_letter.Letter { start: 0, end: 0 }
    if target != NONE {
      let holder = self.node(target).parent
      let collapse = if holder == NONE { WhiteSpaceCollapse.Collapse } else { self.node(holder).computed().text.whiteSpaceCollapse }
      letter = first_letter.letterOf(String.utf8Bytes(String.view(&self.node(target).text)), collapse != WhiteSpaceCollapse.Preserve && collapse != WhiteSpaceCollapse.BreakSpaces && collapse != WhiteSpaceCollapse.PreserveSpaces)
    }
    // An inner block's own ::first-letter takes the letter its ancestors would.
    if letter.end != 0 {
      let held = match self.node(target).identity() { Option.Some { value } => value.letterBox _ => NONE }
      let other = if held == NONE { NONE } else { self.node(held).generatedOrigin() }
      if other != NONE && other != origin {
        if self.within(other, origin) { letter.end = 0 }
        else { run self.releaseFirstLetter(other) }
      }
    }
    let mut slot = old
    if slot != NONE && (letter.end == 0 || self.letterTextOf(slot) != target) {
      run self.releaseFirstLetter(origin)
      slot = NONE
    }
    if letter.end == 0 { return () }
    if slot == NONE {
      let id = self.node(origin).id
      let holder = self.node(target).parent
      slot = run self.createNode(0, id, NodeKind.Box, origin, PseudoTarget.FirstLetter)
      let child = run self.createNode(0, id, NodeKind.Text, origin, PseudoTarget.FirstLetter)
      let boxCss = self.node(slot).css
      let holderCss = self.node(holder).css
      let targetCss = self.node(target).css
      let childCss = self.node(child).css
      run Effect.catchAll(self.layout.insertBefore(NodeId { index: holderCss }, NodeId { index: boxCss }, Option<NodeId>.some(NodeId { index: targetCss })), layoutFailed)
      run Effect.catchAll(self.layout.insertBefore(NodeId { index: boxCss }, NodeId { index: childCss }, Option<NodeId>.None), layoutFailed)
      let boxNode = self.nodeMut(slot)
      boxNode.parent = holder
      let boxIdentity = run boxNode.identityMut()
      boxIdentity.letterText = target
      let textNode = self.nodeMut(child)
      textNode.parent = slot
      let targetNode = self.nodeMut(target)
      let targetIdentity = run targetNode.identityMut()
      targetIdentity.letterBox = slot
      let originNode = self.nodeMut(origin)
      let identity = run originNode.identityMut()
      identity.letterBox = slot
      self.letterUsed = true
      // Its parent's walk may already be past: the pass reaches it through its ancestors.
      self.restyleLocal(slot)
    }
    let full = String.view(&self.node(target).text)
    let piece = run String.copy(String.slice(full, letter.start, letter.end - letter.start))
    run self.fillGenerated(slot, move piece)
    let targetCss = self.node(target).css
    run Effect.catchAll(self.layout.setTextStart(NodeId { index: targetCss }, letter.end, String.view(&self.nodes.asSlice()[u32.toUsize(target)].text)), layoutFailed)
    if let Option<Resolved>.Some { value } = move prepared { run self.installResolved(slot, move value) }
  }

  /// `initial-letter` on the `::first-letter` box `slot`: sizes and places it against its
  /// origin's first available font (see `first_letter.dropCap`).
  effect fn dropCap(self: &mut Self, slot: u32, computed: &mut Computed) -> () ! OutOfMemoryError ? &mut Allocator {
    let origin = self.node(slot).generatedOrigin()
    let first = match self.node(slot).identity() { Option.Some { value } => value.generatedTarget == PseudoTarget.FirstLetter _ => false }
    if !first || origin == NONE { return () }
    let letter = match self.node(slot).sheetStyle() { Option.Some { value } => first_letter.initialLetter(value.declarations.asSlice()) _ => first_letter.InitialLetter { size: 0.0, sink: 0 } }
    if letter.size < 1.0 { return () }
    let paragraph = self.faceOf(self.node(origin).computed().text, self.node(origin).fontKey)
    let key = run self.fontKeyOf(computed.text)
    let own = self.faceOf(computed.text, key)
    first_letter.dropCap(&mut computed.*, letter, paragraph, own)
  }

  fn faceOf(self: &Self, text: TextStyle, key: usize) -> first_letter.Face {
    let measured = self.provider.text.font(FontRequest { key: key,
      writingMode: text.writingMode, textOrientation: text.textOrientation, direction: text.direction })
    let known = measured.fontSize > 0.0
    let ascent = if known { measured.ascent } else { text.size * 0.8 }
    let descent = if known { measured.descent } else { text.size * 0.2 }
    let lineHeight = match text.lineHeight {
      LineHeight.Number { value } => text.size * value
      LineHeight.Length { value } => value
      LineHeight.Normal => if known { measured.ascent + measured.descent + measured.lineGap } else { text.size }
    }
    return first_letter.Face { size: text.size, ascent: ascent, descent: descent,
      capHeight: if known { measured.capHeight } else { text.size * 0.7 }, lineHeight: lineHeight }
  }

  /// Keeps the `::first-line` style of block container `origin` (CSS Pseudo 4 §2.4) in a node
  /// outside layout, whose values paint the text of the block's first line box.
  @inlineNever
  effect fn syncFirstLine(self: &mut Self, origin: u32) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let node = self.node(origin)
    if node.kind != NodeKind.Box || node.isGenerated() { return () }
    let old = match node.identity() { Option.Some { value } => value.lineBox _ => NONE }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    let enabled = at != usize.MAX && self.styleSheets.asSlice()[at].hasFirstLine && node.rendered && first_letter.blockContainer(&node.computed().*)
    if !enabled && old == NONE { return () }
    let mut prepared = Option<Resolved>.None
    if enabled {
      let value = run self.resolveGeneratedStyle(origin, PseudoTarget.FirstLine, StateBits.empty(), false)
      if value.declarations.length() != 0 { prepared = Option<Resolved>.some(move value) }
    }
    if prepared.isNone() {
      if old != NONE {
        let originNode = self.nodeMut(origin)
        let identity = run originNode.identityMut()
        identity.lineBox = NONE
        run self.destroy(0, old)
        self.paintDirty = true
      }
      return ()
    }
    let mut slot = old
    if slot == NONE {
      let id = self.node(origin).id
      slot = run self.createNode(0, id, NodeKind.Box, origin, PseudoTarget.FirstLine)
      let lineNode = self.nodeMut(slot)
      lineNode.parent = origin
      let originNode = self.nodeMut(origin)
      let identity = run originNode.identityMut()
      identity.lineBox = slot
      run self.lineOrigins.append(origin)
    }
    if let Option<Resolved>.Some { value } = move prepared { run self.installResolved(slot, move value) }
    drop run self.resolve(slot, false)
    self.paintDirty = true
  }

  /// Finds the first line box of each block with a `::first-line` style, after layout.
  effect fn indexFirstLines(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    self.firstLines.clear()
    let mut kept: usize = 0
    let mut i: usize = 0
    while i < self.lineOrigins.length() {
      let origin = self.lineOrigins.get(i)
      i = i + 1
      let box = if self.node(origin).live { match self.node(origin).identity() { Option.Some { value } => value.lineBox _ => NONE } } else { NONE }
      if box == NONE || self.lineOriginSeen(origin, kept) { continue }
      self.lineOrigins.set(kept, origin)
      kept = kept + 1
      let line = self.firstLineOf(self.node(origin).css)
      if line != NO_INDEX { run self.firstLines.append(first_letter.FirstLine { line: line, slot: box, origin: origin }) }
    }
    self.lineOrigins.truncate(kept)
  }

  fn lineOriginSeen(self: &Self, origin: u32, kept: usize) -> bool {
    let mut j: usize = 0
    while j < kept {
      if self.lineOrigins.get(j) == origin { return true }
      j = j + 1
    }
    return false
  }

  /// The first line box in the first fragment of css node `css`, through in-flow blocks: its
/// fragment, or what `PlacedText.line` names it by.
  fn firstLineOf(self: &Self, css: usize) -> usize {
    if css >= self.fragmentOf.length() { return NO_INDEX }
    let top = self.fragmentOf.get(css)
    if top == NO_INDEX { return NO_INDEX }
    let values = self.output.fragments.values.asSlice()
    let mut at = values[top].firstChild
    while at != NO_INDEX {
      if values[at].kind == FragmentKind.Line { return at }
      if values[at].kind == FragmentKind.Text && values[at].textData != NO_INDEX {
        // A line of text alone has no fragment: its runs name it.
        let mut runs = self.output.fragments.textRuns(at)
        if runs.next() { return runs.current.line }
      }
      let mut descend = values[at].kind == FragmentKind.Box
      let slot = if values[at].source == NO_INDEX { NONE } else { self.slotOfCssNode(values[at].source) }
      if descend && slot != NONE {
        let layout = &self.node(slot).computed().layout
        descend = layout.float == Float.None && layout.position != Position.Absolute && layout.position != Position.Fixed
          && layout.display.insideIs(DisplayInside.Flow)
      }
      if descend && values[at].firstChild != NO_INDEX {
        at = values[at].firstChild
        continue
      }
      while at != top && values[at].nextSibling == NO_INDEX { at = values[at].parent }
      if at == top { break }
      at = values[at].nextSibling
    }
    return NO_INDEX
  }

  fn letterTextOf(self: &Self, box: u32) -> u32 {
    return match self.node(box).identity() { Option.Some { value } => value.letterText _ => NONE }
  }

  /// The text the first letter of block container `origin` comes from: the first text of its
  /// first formatted line, through inline and block descendants in flow, or NONE when an
  /// atomic inline or other content comes first.
  fn letterTarget(self: &Self, origin: u32) -> u32 {
    let top = self.node(origin).css
    let mut at = self.layout.firstChild(top)
    while at != NO_INDEX {
      let slot = self.slotOfCssNode(at)
      let mut descend = false
      if slot != NONE {
        let node = self.node(slot)
        if node.kind == NodeKind.Text {
          if !blankText(String.utf8Bytes(String.view(&node.text))) { return slot }
        } else if node.kind != NodeKind.Box {
          return NONE
        } else {
          let target = match node.identity() { Option.Some { value } => value.generatedTarget _ => PseudoTarget.None }
          let layout = &node.computed().layout
          if target == PseudoTarget.Marker || target == PseudoTarget.FirstLetter || layout.display.isNone() {
          } else if layout.float != Float.None || layout.position == Position.Absolute || layout.position == Position.Fixed {
          } else if layout.display.isContents() || layout.display.insideIs(DisplayInside.Flow) {
            descend = true
          } else {
            return NONE
          }
        }
      }
      let links = &self.layout
      if descend && links.firstChild(at) != NO_INDEX {
        at = links.firstChild(at)
        continue
      }
      while at != top && links.nextSibling(at) == NO_INDEX { at = links.parent(at) }
      if at == top { break }
      at = links.nextSibling(at)
    }
    return NONE
  }

  /// Takes the `::first-letter` box of `origin` away and gives its text the letter back.
  effect fn releaseFirstLetter(self: &mut Self, origin: u32) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let box = match self.node(origin).identity() { Option.Some { value } => value.letterBox _ => NONE }
    if box == NONE { return () }
    let originNode = self.nodeMut(origin)
    let identity = run originNode.identityMut()
    identity.letterBox = NONE
    let text = self.letterTextOf(box)
    if text != NONE && self.node(text).live && self.node(text).kind == NodeKind.Text {
      let held = match self.node(text).identity() { Option.Some { value } => value.letterBox _ => NONE }
      if held == box {
        let textNode = self.nodeMut(text)
        let textIdentity = run textNode.identityMut()
        textIdentity.letterBox = NONE
        let textCss = self.node(text).css
        run Effect.catchAll(self.layout.setTextStart(NodeId { index: textCss }, 0, String.view(&self.nodes.asSlice()[u32.toUsize(text)].text)), layoutFailed)
      }
    }
    run self.destroy(0, box)
  }

  /// An edit at `from` can change the first letter of a block above it: those that have or
  /// want one restyle, which places it again.
  fn restyleLetterOrigins(self: &mut Self, from: u32) -> () {
    let mut at = from
    while at != NONE {
      let marked = match self.node(at).identity() { Option.Some { value } => value.letterRules || value.letterBox != NONE _ => false }
      if marked && !self.node(at).isGenerated() { self.restyleLocal(at) }
      at = self.node(at).parent
    }
  }

  /// Before `slot` leaves its parent: a letter box it holds whose origin stays behind, or the
  /// letter of the text it is, goes back to its text.
  effect fn detachLetters(self: &mut Self, slot: u32, parent: u32) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let mut at = parent
    while at != NONE {
      let box = match self.node(at).identity() { Option.Some { value } => value.letterBox _ => NONE }
      if box != NONE && !self.node(at).isGenerated() && (self.letterTextOf(box) == slot || self.within(box, slot)) {
        run self.releaseFirstLetter(at)
      }
      at = self.node(at).parent
    }
    self.restyleLetterOrigins(parent)
  }

  /// Sets the text of generated box `slot` to `text`, when it differs.
  pub effect fn fillGenerated(self: &mut Self, slot: u32, text: String) -> ()
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    let child = self.slotOfCssNode(self.layout.firstChild(self.node(slot).css))
    if child == NONE || self.node(child).kind != NodeKind.Text { return () }
    if String.view(&self.node(child).text) != String.view(&text) { run self.setText(0, child, move text) }
  }

  /// The ancestor filter keys of the element at `slot`: its element name, id and classes.
  effect fn filterKeys(self: &Self, slot: u32) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
    let mut keys = List<u32>.make()
    let node = self.node(slot)
    if node.kind == NodeKind.Text { return move keys }
    let adapter = SelectorTree { tree: self }
    run keys.append(ancestor_filter.key(NameKind.Element, ElementTree.localName(&adapter, u32.toUsize(slot))))
    if let Option.Some { value } = node.identity() {
      if value.hasId { run keys.append(ancestor_filter.key(NameKind.Id, String.utf8Bytes(value.id()))) }
      let atoms = value.classAtoms()
      let mut i: usize = 0
      while i < atoms.length {
        run keys.append(self.styleAtoms.filterKey(atoms[i]))
        i = i + 1
      }
    }
    return move keys
  }

  effect fn filterNames(self: &mut Self, slot: u32, push: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let keys = run self.filterKeys(slot)
    let mut i: usize = 0
    while i < keys.length() {
      if push { self.ancestorFilter.push(keys.get(i)) } else { self.ancestorFilter.pop(keys.get(i)) }
      i = i + 1
    }
  }

  /// Makes the ancestor filter hold the ancestors of `slot`. A pass styles nodes parents first,
  /// so this is usually nothing, or one push for a first child; a restyle that starts deep in the
  /// tree walks up once to the nearest ancestor already held.
  effect fn prepareFilter(self: &mut Self, slot: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if !self.filterOn { return () }
    let mut chain = List<u32>.make()
    let mut keep: usize = 0
    let mut up = self.node(slot).parent
    while up != NONE {
      let path = self.filterPath.asSlice()
      let mut at = path.length
      while at > 0 && path[at - 1] != up { at = at - 1 }
      if at > 0 {
        keep = at
        break
      }
      run chain.append(up)
      up = self.node(up).parent
    }
    while self.filterPath.length() > keep {
      let last = self.filterPath.length() - 1
      let held = self.filterPath.get(last)
      run self.filterNames(held, false)
      self.filterPath.truncate(last)
    }
    let mut i = chain.length()
    while i > 0 {
      i = i - 1
      let next = chain.get(i)
      run self.filterNames(next, true)
      run self.filterPath.append(next)
    }
  }

  effect fn resolveStyles(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    self.work.styleCalls = self.work.styleCalls + 1
    if self.cssWidth() != self.unitsWidth || self.cssHeight() != self.unitsHeight {
      self.unitsWidth = self.cssWidth()
      self.unitsHeight = self.cssHeight()
      self.restyleViewportUnits()
    }
    let conditionIndex = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if conditionIndex != usize.MAX {
      let cssWidth = self.cssWidth()
      let cssHeight = self.cssHeight()
      let pageZoom = self.pageZoomFactor
      let roots = self.styleSheets.asMutSlice()
      let mut environment = roots[conditionIndex].environment
      environment.initial.viewportWidth = f32.toF64(cssWidth)
      environment.initial.viewportHeight = f32.toF64(cssHeight)
      environment.resolutionDppx = f32.toF64(self.input.scale * pageZoom)
      // The sheets keep their conditions while the environment is the one they were evaluated
      // for and no sheet changed, which asks for a full pass.
      if self.stylesDirty || !Environment.same(&roots[conditionIndex].evaluated, &environment) {
        self.work.conditionsEvaluated = self.work.conditionsEvaluated + roots[conditionIndex].sheets.censusConditions()
        self.work.conditionRulesWalked = self.work.conditionRulesWalked + roots[conditionIndex].sheets.censusConditionRules()
        roots[conditionIndex].evaluated = environment
      }
      let updated = run Effect.result(roots[conditionIndex].sheets.environment(&environment, false, &Limits.make()))
      roots[conditionIndex].hasStarting = roots[conditionIndex].sheets.hasStarting()
      match move updated {
        Result<bool, CssError | OutOfMemoryError>.Success { value } => { if value { self.markStylesDirty(20) } }
        Result<bool, CssError | OutOfMemoryError>.Failure { error: why } => {
          match move why { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { fail TreeError.StyleSheet { index: 0, root: self.current, sheet: 0 } } }
        }
      }
    }
    // A full pass hands every node a fresh class long before the counter can wrap into a live one.
    if self.styleClasses > 2147483647 {
      self.styleClasses = 0
      self.markStylesDirty(21)
    }
    // Before the stamp counter wraps, no node holds a stamp, so none lends until it computes again.
    if self.computedStamps > 2147483647 {
      self.computedStamps = 0
      self.textInherits.clear()
      let nodes = self.nodes.asMutSlice()
      let mut at: usize = 0
      while at < nodes.length {
        nodes[at].computedStamp = 0
        at = at + 1
      }
    }
    if !self.stylesDirty && !self.stylesPending {
      return ()
    }
    self.work.stylePasses = self.work.stylePasses + 1
    if self.stylesDirty {
      self.svgStyleRevision = self.svgStyleRevision + 1
      self.svgStylesPending = true
      run sheet_faces.sync(&mut self)
      if run font_rules.sync(&mut self) { self.fontRulesChanged() }
    }
    let sheetIndex = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if sheetIndex != usize.MAX && (self.styleSheets.asSlice()[sheetIndex].sheets.length() != 0 || self.styleSheets.asSlice()[sheetIndex].inlineVariables) {
      if !self.styleSheets.asSlice()[sheetIndex].sheets.canRetainScopes() { self.markStylesDirty(22) }
      let roots = self.styleSheets.asMutSlice()
      if self.stylesDirty {
        roots[sheetIndex].siblingAnchors = false
        roots[sheetIndex].watchOverflowed = false
        roots[sheetIndex].sheets.resetScopes()
        roots[sheetIndex].states = style_invalidation.states(&roots[sheetIndex].sheets)
        roots[sheetIndex].reads = style_invalidation.reads(&roots[sheetIndex].sheets)
        roots[sheetIndex].sharing = style_invalidation.sharing(&roots[sheetIndex].sheets)
        roots[sheetIndex].stateSubjects = run StateSubjects.collect(&roots[sheetIndex].sheets)
        roots[sheetIndex].invalidation = run InvalidationMap.collect(&roots[sheetIndex].sheets, &mut self.styleAtoms)
        roots[sheetIndex].startingSubjects = if roots[sheetIndex].hasStarting {
          run StartingSubjects.collect(&roots[sheetIndex].sheets, &mut self.styleAtoms)
        } else { StartingSubjects.make() }
        roots[sheetIndex].hasGenerated = generated.hasContent(&roots[sheetIndex].sheets)
        roots[sheetIndex].beforeSubjects = if roots[sheetIndex].hasGenerated {
          run PseudoSubjects.collect(&roots[sheetIndex].sheets, &mut self.styleAtoms, PseudoTarget.Before, true)
        } else { PseudoSubjects.make() }
        roots[sheetIndex].afterSubjects = if roots[sheetIndex].hasGenerated {
          run PseudoSubjects.collect(&roots[sheetIndex].sheets, &mut self.styleAtoms, PseudoTarget.After, true)
        } else { PseudoSubjects.make() }
        roots[sheetIndex].hasMarker = lists.hasMarkerRules(&roots[sheetIndex].sheets)
        roots[sheetIndex].hasFirstLetter = first_letter.hasRules(&roots[sheetIndex].sheets, PseudoTarget.FirstLetter)
        roots[sheetIndex].firstLetterSubjects = if roots[sheetIndex].hasFirstLetter {
          run PseudoSubjects.collect(&roots[sheetIndex].sheets, &mut self.styleAtoms, PseudoTarget.FirstLetter, false)
        } else { PseudoSubjects.make() }
        roots[sheetIndex].hasFirstLine = first_letter.hasRules(&roots[sheetIndex].sheets, PseudoTarget.FirstLine)
        roots[sheetIndex].firstLineSubjects = if roots[sheetIndex].hasFirstLine {
          run PseudoSubjects.collect(&roots[sheetIndex].sheets, &mut self.styleAtoms, PseudoTarget.FirstLine, false)
        } else { PseudoSubjects.make() }
        roots[sheetIndex].hasSelection = selection.present(&roots[sheetIndex].sheets)
        roots[sheetIndex].selectionSubjects = if roots[sheetIndex].hasSelection {
          run PseudoSubjects.collect(&roots[sheetIndex].sheets, &mut self.styleAtoms, PseudoTarget.Selection, false)
        } else { PseudoSubjects.make() }
        roots[sheetIndex].hasPlaceholder = placeholder.present(&roots[sheetIndex].sheets)
        roots[sheetIndex].hasScrollbars = scrollbar_parts.present(&roots[sheetIndex].sheets)
        roots[sheetIndex].scrollbarSubjects = if roots[sheetIndex].hasScrollbars {
          run PseudoSubjects.collectScrollbars(&roots[sheetIndex].sheets, &mut self.styleAtoms)
        } else { PseudoSubjects.make() }
      }
      roots[sheetIndex].cache.reset()
    }
    // Only a node styled earlier in this pass is known to hold its current match.
    self.styleModels.clear()
    self.movedClasses.clear()
    let full = self.stylesDirty
    if full {
      self.work.fullStylePasses = self.work.fullStylePasses + 1
      self.containerWatches.clear()
      self.clearWatches()
    }
    self.stylesDirty = false
    self.stylesPending = false
    // A restyle that leaves every node painting as it did keeps the fragment hashes and ink:
    // each restyled node says below whether what they are built from changed. Layout changes
    // reach them through the layout pass.
    if full {
      self.paintCachesStale = true
      self.listsDirty = true
    }
    let scrollbarRules = sheetIndex != usize.MAX && self.styleSheets.asSlice()[sheetIndex].hasScrollbars
    let firstLetterRules = sheetIndex != usize.MAX && self.styleSheets.asSlice()[sheetIndex].hasFirstLetter
    let firstLineRules = sheetIndex != usize.MAX && self.styleSheets.asSlice()[sheetIndex].hasFirstLine
    let generatedRules = sheetIndex != usize.MAX && self.styleSheets.asSlice()[sheetIndex].hasGenerated
    let selectionRules = sheetIndex != usize.MAX && self.styleSheets.asSlice()[sheetIndex].hasSelection
    let placeholderRules = sheetIndex != usize.MAX && self.styleSheets.asSlice()[sheetIndex].hasPlaceholder
    if self.root == NONE {
      return ()
    }
    // Root font units cross descendants with an independently specified font.
    let mut rootFontChanged = false
    run self.ancestorFilter.clear()
    self.filterPath.clear()
    self.filterOn = true
    if self.siblingPass == u32.MAX {
      self.siblingPass = 1
      let stamps = self.siblingStamp.asMutSlice()
      let mut s: usize = 0
      while s < stamps.length { stamps[s] = 0 s = s + 1 }
    } else {
      self.siblingPass = self.siblingPass + 1
    }
    let nodeCount = self.nodes.length()
    if self.siblingIndex.length() < nodeCount {
      let missing = nodeCount - self.siblingIndex.length()
      run self.siblingIndex.reserve(missing)
      while self.siblingIndex.length() < nodeCount { run self.siblingIndex.append(0) }
    }
    if self.siblingCount.length() < nodeCount {
      let missing = nodeCount - self.siblingCount.length()
      run self.siblingCount.reserve(missing)
      while self.siblingCount.length() < nodeCount { run self.siblingCount.append(0) }
    }
    if self.siblingStamp.length() < nodeCount {
      let missing = nodeCount - self.siblingStamp.length()
      run self.siblingStamp.reserve(missing)
      while self.siblingStamp.length() < nodeCount { run self.siblingStamp.append(0) }
    }
    self.siblingOn = true
    // Each entry is a slot and whether its parent's inherited values changed.
    let mut stack = List<u64>.make()
    run stack.append(u32.toU64(self.root))
    // For each entry, the custom properties that may differ in its parent's new scope, as name
    // bits (`VariableMasks`): read where bit 34 is set.
    let mut differing = List<u64>.make()
    run differing.append(0)
    while stack.length() != 0 {
      let last = stack.length() - 1
      let entry = stack.get(last)
      stack.truncate(last)
      let differs = differing.get(last)
      differing.truncate(last)
      let slot = u64.toU32(u64.bitAnd(entry, 0xFFFFFFFF))
      // Bit 33: an ancestor's change reaches this subtree through selectors.
      let reached = u64.bitAnd(entry, 0x200000000) != 0
      // Bit 34: all that changed in the parent is its variable scope. A node that reads none
      // of the variables that differ keeps its style and moves under the new scope.
      let scoped = u64.bitAnd(entry, 0x400000000) != 0
      // Bit 35: all that changed in the parent is its `rendered` visibility (e.g. toggling
      // `display: none` / `hidden`). Clean descendants without animations, transitions, or
      // `@starting-style` only update `rendered` without re-matching selectors or recomputing styles.
      let rendOnly = u64.bitAnd(entry, 0x800000000) != 0
      let moves = scoped && !full && !rootFontChanged && !reached && u64.bitAnd(entry, 0x100000000) == 0 && self.movesScope(slot, differs)
      let fastRendered = rendOnly && !full && !rootFontChanged && !reached && u64.bitAnd(entry, 0x100000000) == 0 && !scoped
        && self.canFastRendered(slot, sheetIndex, firstLetterRules, firstLineRules)
      // A node that cannot move takes the new scope as any other change of what it inherits.
      let forced = full || rootFontChanged || u64.bitAnd(entry, 0x100000000) != 0 || (scoped && !moves) || (rendOnly && !fastRendered)
      let mut changed = full
      // The change is the node's variable scope and nothing else its children inherit.
      let mut scopeOnly = false
      // The change is the node's `rendered` flag and nothing else its children inherit.
      let mut renderedOnly = false
      // The properties that may differ in this node's new scope, for its children.
      let mut differBelow = differs
      if moves {
        changed = run self.moveScope(slot)
        scopeOnly = changed
        if changed && self.node(slot).kind == NodeKind.Icon { self.markIconStyleDirty(slot) }
        // Its children are not visited: what they share was taken under the class it held.
        if !changed { run self.forgetShares(slot) }
      } else if fastRendered {
        let parentRendered = self.node(self.node(slot).parent).rendered
        let newRendered = parentRendered && !self.node(slot).computed().layout.display.isNone()
        if newRendered != self.node(slot).rendered {
          let target = self.nodeMut(slot)
          target.rendered = newRendered
          if newRendered && target.kind == NodeKind.Icon {
            let resource = target.resource
            let needsSvg = match target.svg.get() {
              Option<&LiveSvg>.Some { value: svg } => svg.styleDirty || svg.styleRevision != self.svgStyleRevision
              _ => resource != 0 && self.resources.styledIconRevision(slot, resource) != self.svgStyleRevision
            }
            if needsSvg { self.svgStylesPending = true }
          }
          if !self.paintCachesStale {
            run self.repair.nodes.append(slot)
            self.repair.pending = true
          }
          if self.listsUsed { self.listsDirty = true }
          changed = true
          renderedOnly = true
        }
      }
      let node = self.node(slot)
      let own = !moves && !fastRendered && (forced || reached || node.styleDirty)
      let tick = !forced && !reached && node.styleTick
      let below = node.subtreeDirty
      let mut subtree = false
      let mut forget = false
      if own {
        let usesBefore = self.variableUses()
        let scopeBefore = node.sheetScope()
        let classBefore = node.styleClass
        let before = node.computed().text
        let beforeFont = node.fontKey
        let events = node.computed().paint.pointerEvents
        let nearest = node.computed().nearest
        let selects = node.computed().userSelect
        let barColors = node.computed().scroll.colors
        let listStyle = node.computed().list
        let shadow = node.computed().effects
        let wasRendered = node.rendered
        let paintBefore = node.paintHash
        // Paint caches built again from scratch need no list of what to repair.
        let tracksPaint = !self.paintCachesStale
        let selectedBefore = if tracksPaint { selection.hash(node, 0) } else { 0 }
        let placedBefore = if tracksPaint { transform.placementHash(&node.computed().transform, 0) } else { 0 }
        let perspectiveBefore = if tracksPaint { transform.perspectiveHash(&node.computed().transform, 0) } else { 0 }
        let containment = node.computed().contain.query()
        let containStyleBefore = node.computed().contain.style()
        let skips = node.computed().contain.hidden()
        run self.prepareFilter(slot)
        if !tick {
          let cause = self.resolveCause(slot, full, rootFontChanged, entry, differs)
          self.work.resolveCauses[cause] = self.work.resolveCauses[cause] + 1
        }
        let namesChanged = run self.resolve(slot, tick)
        self.stats.styledNodes = self.stats.styledNodes + 1
        let resolvedKind = self.node(slot).kind
        let hasSel = match self.node(slot).identity() { Option<&NodeIdentity>.Some { value } => value.selection.isSome() _ => false }
        let hasBar = match self.node(slot).identity() { Option<&NodeIdentity>.Some { value } => value.scrollbars.isSome() _ => false }
        let hasGen = match self.node(slot).identity() { Option<&NodeIdentity>.Some { value } => value.before != NONE || value.after != NONE _ => false }
        if (selectionRules || hasSel) && resolvedKind != NodeKind.Text { run selection.resolve(&mut self, slot) }
        if resolvedKind == NodeKind.Input && (placeholderRules || self.styleSheets.length() != 0) { run placeholder.resolve(&mut self, slot) }
        if (scrollbarRules || hasBar) && resolvedKind != NodeKind.Text { run scrollbar_parts.resolve(&mut self, slot) }
        if generatedRules || hasGen { run self.syncGenerated(slot) }
        if listStyle.item() || self.node(slot).computed().list.item() { run self.syncMarker(slot) }
        if (self.letterUsed || firstLetterRules) && self.letterCandidate(slot) { run self.letterPending.append(slot) }
        if self.lineOrigins.length() != 0 || (firstLineRules && self.lineCandidate(slot)) { run self.syncFirstLine(slot) }
        let styled = self.node(slot)
        let repaints = tracksPaint && !self.paintCachesStale && (scrollbarRules || styled.kind == NodeKind.Input
          || paintBefore != styled.paintHash || beforeFont != styled.fontKey || wasRendered != styled.rendered
          || shadow.shadowFrom != styled.computed().effects.shadowFrom
          || selectedBefore != selection.hash(styled, 0)
          || placedBefore != transform.placementHash(&styled.computed().transform, 0)
          || perspectiveBefore != transform.perspectiveHash(&styled.computed().transform, 0))
        if repaints {
          run self.repair.nodes.append(slot)
          self.repair.pending = true
        }
        let after = &self.node(slot).computed().*
        let listsChanged = self.listsUsed && (wasRendered != self.node(slot).rendered || &listStyle != &after.list
          || listStyle.counters() || after.list.counters() || containStyleBefore != after.contain.style()
          || self.node(slot).isGenerated())
        if slot == self.root && (beforeFont != self.node(slot).fontKey || &before.lineHeight != &after.text.lineHeight) { rootFontChanged = true }
        // A tick leaves the variables below as they were: only inherited values can pass on.
        subtree = !tick && (reached || self.node(slot).styleSubtree) && self.node(slot).sheetStyle().isSome()
        // A descendant's share class says its ancestors had equal selector inputs: those it
        // does not resolve again in this pass give it up.
        forget = classBefore != self.node(slot).styleClass && !subtree
        let scopeChanged = !sameScope(scopeBefore, self.node(slot).sheetScope())
        let renderedChanged = wasRendered != self.node(slot).rendered
        let otherValuesChanged = !sameText(&before, &after.text) || events != after.paint.pointerEvents
          || selects != after.userSelect || &barColors != &after.scroll.colors || &listStyle != &after.list || nearest != after.nearest
          || namesChanged || containment != after.contain.query() || skips != after.contain.hidden()
          || shadow.shadowFrom != after.effects.shadowFrom
          || shadow.shadowHash != after.effects.shadowHash
        let valuesChanged = otherValuesChanged || renderedChanged
        // What may differ below: what differed above, where that is known, and what the node's
        // own declarations give another value now.
        let known = scopeBefore.isSome() && !full && !rootFontChanged && (scoped || u64.bitAnd(entry, 0x100000000) == 0)
        differBelow = if known { u64.bitOr(if scoped { differs } else { 0 }, self.scopesDiffer(scopeBefore, self.node(slot).sheetScope())) } else { u64.MAX }
        // Only non-inheriting custom properties changed in this scope: descendants see no change.
        let inheritsScope = scopeChanged && (!known || differBelow != 0)
        changed = full || rootFontChanged || inheritsScope || valuesChanged
        scopeOnly = !full && !rootFontChanged && scopeChanged && !valuesChanged
        renderedOnly = !full && !rootFontChanged && !inheritsScope && !otherValuesChanged && renderedChanged
        let free = self.variableUses() == usesBefore
        if listsChanged { self.listsDirty = true }
        let flagged = self.nodeMut(slot)
        flagged.variableFree = free
        if resolvedKind == NodeKind.Icon { self.markIconStyleDirty(slot) }
      }
      // Under a change of scope alone every child is visited and takes a class again.
      if forget && !scopeOnly { run self.forgetShares(slot) }
      let cleared = self.nodeMut(slot)
      cleared.styleDirty = false
      cleared.styleTick = false
      cleared.subtreeDirty = false
      cleared.styleSubtree = false
      if changed || below || subtree || own {
        let flag: u64 = u64.bitOr(
          u64.bitOr(if changed && !scopeOnly && !renderedOnly { 0x100000000 } else { 0 }, if subtree { 0x200000000 } else { 0 }),
          u64.bitOr(if scopeOnly { 0x400000000 } else { 0 }, if renderedOnly { 0x800000000 } else { 0 }),
        )
        // Children in reverse, so the first is resolved first.
        let css = self.node(slot).css
        let first = stack.length()
        let mut child = self.layout.firstChild(css)
        let mut elemCount: u32 = 0
        let parentIndex = u32.toUsize(slot)
        let pass = self.siblingPass
        while child != NO_INDEX {
          let found = self.slotOfCssNode(child)
          if found != NONE {
            let isElem = self.node(found).live && self.node(found).kind != NodeKind.Text && !self.node(found).isGenerated()
            if isElem {
              elemCount = elemCount + 1
              let idx = u32.toUsize(found)
              if idx < self.siblingIndex.length() {
                let indices = self.siblingIndex.asMutSlice()
                indices[idx] = elemCount
              }
            }
            // A child that inherits a property explicitly reads what its parent resolved to.
            let inherit = explicitInherit(self.node(found))
            if changed || below || subtree || self.node(found).styleDirty || inherit {
              let extra: u64 = if own && !changed && inherit { 0x100000000 } else { 0 }
              run stack.append(u64.bitOr(u32.toU64(found), u64.bitOr(flag, extra)))
              run differing.append(differBelow)
            }
          }
          child = self.layout.nextSibling(child)
        }
        if parentIndex < self.siblingCount.length() {
          let counts = self.siblingCount.asMutSlice()
          counts[parentIndex] = elemCount
          let stamps = self.siblingStamp.asMutSlice()
          stamps[parentIndex] = pass
        }
        let items = stack.asMutSlice()
        let mut a = first
        let mut b = items.length
        while b > a + 1 {
          b = b - 1
          let swap = items[a]
          items[a] = items[b]
          items[b] = swap
          a = a + 1
        }
      }
    }
    self.siblingOn = false
    self.filterOn = false
    if self.letterPending.length() != 0 {
      let mut i: usize = 0
      while i < self.letterPending.length() {
        let origin = self.letterPending.get(i)
        run self.syncFirstLetter(origin)
        i = i + 1
      }
      self.letterPending.clear()
      // A new or moved letter box asked for its own style.
      if self.stylesPending { run self.resolveStyles() }
    }
    if self.listsUsed && (self.listsDirty || self.layout.structureRevision() != self.listsStructure) {
      run lists.update(&mut self)
      self.listsDirty = false
      self.listsStructure = self.layout.structureRevision()
    }
  }

  /// The styles of parts resolved so far that read a variable or declare one (`Cache.variableUses`).
  fn variableUses(self: &Self) -> u64 {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX { return 0 }
    return self.styleSheets.asSlice()[at].cache.variableUses
  }

  /// The custom properties two scopes of one node give different values of its own, as name bits.
  fn scopesDiffer(self: &Self, before: Option<ScopeId>, after: Option<ScopeId>) -> u64 {
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX { return u64.MAX }
    return self.styleSheets.asSlice()[at].sheets.variablesDiffering(before, after)
  }

  fn canFastRendered(self: &Self, slot: u32, sheetIndex: usize, firstLetterRules: bool, firstLineRules: bool) -> bool {
    let node = self.node(slot)
    if node.parent == NONE || node.styleDirty || node.styleTick || node.computedStamp == 0 { return false }
    if node.generatedSuppressed || node.activeTransitions != 0 || self.hasPlayingAnimation(slot) { return false }
    if node.computed().animation.names.start != usize.MAX { return false }
    if style_change.tracks(self, slot) { return false }
    if firstLetterRules && self.letterCandidate(slot) { return false }
    if firstLineRules && self.lineCandidate(slot) { return false }
    let parentRendered = self.node(node.parent).rendered
    let newRendered = parentRendered && !node.computed().layout.display.isNone()
    if newRendered && !node.rendered {
      if node.starting().length != 0 { return false }
      if sheetIndex != usize.MAX {
        let sheets = &self.styleSheets.asSlice()[sheetIndex]
        if sheets.hasStarting && sheets.startingSubjects.mayMatch(node) { return false }
      }
    }
    return true
  }

  /// Whether the node at `slot`, whose parent changed only its variable scope, can keep its
  /// style: it is clean, its own style mentions none of the custom properties `differs` that
  /// may differ in that scope, none of its parts reads a variable, and it holds no first
  /// letter, whose style is resolved apart from the node's.
  fn movesScope(self: &Self, slot: u32, differs: u64) -> bool {
    let node = self.node(slot)
    if node.styleDirty || !node.variableFree || node.parent == NONE { return false }
    if node.kind == NodeKind.Text { return true }
    let reads = match node.sheetStyle() { Option.Some { value } => value.variables _ => { return false } }
    if u64.bitAnd(reads, differs) != 0 { return false }
    return match node.identity() { Option.Some { value } => value.letterBox == NONE && !value.letterRules _ => true }
  }

  /// Why the node at `slot` resolves in this pass, as an index into `Work.resolveCauses`: the
  /// first reason of the pass's own order, and under a parent's change of scope the first thing
  /// that kept it from moving (`movesScope`).
  fn resolveCause(self: &Self, slot: u32, full: bool, rootFontChanged: bool, entry: u64, differs: u64) -> usize {
    if full { return 0 }
    if rootFontChanged { return 1 }
    if u64.bitAnd(entry, 0x100000000) != 0 { return 2 }
    if u64.bitAnd(entry, 0x200000000) != 0 { return 3 }
    if u64.bitAnd(entry, 0x400000000) == 0 { return 4 }
    let node = self.node(slot)
    if node.styleDirty { return 5 }
    if !node.variableFree { return 6 }
    let reads = match node.sheetStyle() { Option.Some { value } => value.variables _ => { return 7 } }
    if differs == u64.MAX { return 11 }
    if reads == u64.MAX { return 8 }
    if u64.bitAnd(reads, differs) != 0 { return 9 }
    return 10
  }

  /// Moves the node at `slot` under its parent's new variable scope, keeping its style: the
  /// scope its own custom properties give there. Returns whether its scope changed, which is
  /// all its children can inherit of the change.
  effect fn moveScope(self: &mut Self, slot: u32) -> bool
    ! TreeError | OutOfMemoryError ? &mut Allocator {
    self.work.scopeMoves = self.work.scopeMoves + 1
    let record = match &self.node(slot).resolvedSheet {
      Option<Frozen<Resolved>>.Some { value } => value.clone()
      _ => { return false }
    }
    let at = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if at == usize.MAX { return false }
    let before = self.node(slot).sheetScope()
    let mut roots = Intrinsic.replace(self.styleSheets, List<RootSheets>.make())
    let entries = roots.asMutSlice()
    let rebuilt = run Effect.result(style_sheets.movedScope(&mut entries[at].sheets, &self, slot, record.get().customs.asSlice()))
    self.styleSheets = move roots
    let scope = match move rebuilt {
      Result<ScopeId, RegistrationError | CssError | OutOfMemoryError>.Success { value } => value
      Result<ScopeId, RegistrationError | CssError | OutOfMemoryError>.Failure { error: why } => {
        match move why { OutOfMemoryError {} => { fail OutOfMemoryError {} } _ => { fail TreeError.StyleSheet { index: 0, root: self.current, sheet: 0 } } }
      }
    }
    // Nodes of one class under parents of one class still have equal ancestors.
    let held = self.node(slot).styleClass
    let parentClass = self.node(self.node(slot).parent).styleClass
    let mut class: u32 = 0
    if held != 0 && parentClass != 0 {
      let key = u64.bitOr(u64.shiftLeft(u32.toU64(held), 32), u32.toU64(parentClass))
      class = match self.movedClasses.get(key) {
        Option.Some { value } => value
        _ => {
          let next = self.styleClasses + 1
          self.styleClasses = next
          drop run self.movedClasses.insert(key, next)
          next
        }
      }
    }
    let node = self.nodeMut(slot)
    node.movedScope = usize.toU32(scope.index)
    node.styleClass = class
    return !sameScope(before, Option<ScopeId>.some(scope))
  }

  /// Forgets what matching watched under the current root: a root restyle asks it all again.
  /// A match can watch a node the pass has not reached yet, so this cannot wait for the visit.
  fn clearWatches(self: &mut Self) -> () {
    if self.root == NONE { return () }
    let index = style_sheets.index(self.styleSheets.asSlice(), self.current)
    if index == usize.MAX { return () }
    let sheets = &self.styleSheets.asSlice()[index]
    if u32.bitAnd(sheets.reads, css_selectors.READS_DESCENDANTS) == 0 && u32.bitAnd(sheets.states.any, css_element.FOCUS_WITHIN) == 0 { return () }
    let top = self.node(self.root).css
    let mut at = top
    while true {
      let slot = self.slotOfCssNode(at)
      if slot != NONE {
        let watched = self.nodeMut(slot)
        watched.styleWatch = 0
      }
      let links = &self.layout
      if links.firstChild(at) != NO_INDEX { at = links.firstChild(at)
        continue }
      while at != top && links.nextSibling(at) == NO_INDEX { at = links.parent(at) }
      if at == top { break }
      at = links.nextSibling(at)
    }
  }

  fn applyPixelStyles(self: &Self, slot: u32, computed: &mut Computed) {
    let node = self.node(slot)
    if node.kind == NodeKind.Text { return () }
    applyPixelList(&mut computed.*, node.base.asSlice())
    if node.hovered { applyPixelList(&mut computed.*, node.hover()) }
    if node.pressed { applyPixelList(&mut computed.*, node.active()) }
    if self.focused == slot {
      applyPixelList(&mut computed.*, node.focus())
      if self.focusVisible || node.kind == NodeKind.Input {
        applyPixelList(&mut computed.*, node.focusVisible())
      }
    }
  }

  effect fn applyNodeLengths(self: &Self, slot: u32, computed: &mut Computed, parentStyle: &Computed,
    stops: &mut EasingStops, units: &Context) ! OutOfMemoryError ? &mut Allocator {
    let node = self.node(slot)
    if let Option<&Resolved>.Some { value } = node.sheetStyle() {
      run applyUsing(&mut computed.*, value.declarations.asSlice(), parentStyle, &mut stops.*, units)
    } else if node.kind != NodeKind.Text && self.overrides.length() == 0 {
      run applyUsing(&mut computed.*, node.base.asSlice(), parentStyle, &mut stops.*, units)
      if node.hovered {
        run applyUsing(&mut computed.*, node.hover(), parentStyle, &mut stops.*, units)
      }
      if node.pressed {
        run applyUsing(&mut computed.*, node.active(), parentStyle, &mut stops.*, units)
      }
      if self.focused == slot {
        run applyUsing(&mut computed.*, node.focus(), parentStyle, &mut stops.*, units)
        if self.focusVisible || node.kind == NodeKind.Input {
          run applyUsing(&mut computed.*, node.focusVisible(), parentStyle, &mut stops.*, units)
        }
      }
    } else if node.kind != NodeKind.Text {
      run self.applyOverridden(&mut computed.*, node.id, StyleState.Base, node.base.asSlice(), &mut stops.*, parentStyle, units)
      if node.hovered {
        run self.applyOverridden(&mut computed.*, node.id, StyleState.Hover, node.hover(), &mut stops.*, parentStyle, units)
      }
      if node.pressed {
        run self.applyOverridden(&mut computed.*, node.id, StyleState.Active, node.active(), &mut stops.*, parentStyle, units)
      }
      if self.focused == slot {
        run self.applyOverridden(&mut computed.*, node.id, StyleState.Focus, node.focus(), &mut stops.*, parentStyle, units)
        if self.focusVisible || node.kind == NodeKind.Input {
          run self.applyOverridden(
            &mut computed.*,
            node.id,
            StyleState.FocusVisible,
            node.focusVisible(),
            &mut stops.*,
            parentStyle,
            units,
          )
        }
      }
    }
  }


  // The text child style key of node `slot`'s parent, or usize.MAX when the text node at
  // `slot` cannot take a shared one: it must be plain text with nothing of its own.
  fn textInheritPlace(self: &Self, slot: u32) -> usize {
    let node = self.node(slot)
    if node.kind != NodeKind.Text || node.styleNeedsContext || node.sheetStyle().isSome() || node.isGenerated() || node.generatedSuppressed { return usize.MAX }
    if self.overrides.length() != 0 || self.anchors.length() != 0 || node.parent == NONE { return usize.MAX }
    let stamp = self.node(node.parent).computedStamp
    if stamp == 0 { return usize.MAX }
    return usize.bitAnd(u32.toUsize(stamp), TEXT_INHERITS - 1)
  }

  // Gives text node `slot` the style an equal parent's text child has, when one is kept.
  effect fn inheritText(self: &mut Self, slot: u32) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    let place = self.textInheritPlace(slot)
    if place == usize.MAX || place >= self.textInherits.length() { return false }
    let parent = self.node(self.node(slot).parent)
    let kept = &self.textInherits.asSlice()[place]
    if kept.parentStamp != parent.computedStamp || kept.parentRendered != parent.rendered
      || kept.width != self.cssWidth() || kept.height != self.cssHeight() { return false }
    let styled = kept.styled.clone()
    let stamp = kept.stamp
    let rendered = kept.rendered
    let fontKey = kept.fontKey
    let paintHash = kept.paintHash
    run style_change.prepare(&mut self, slot, false)
    self.work.textInherits = self.work.textInherits + 1
    let emptyEffects = if self.node(slot).hasEffectsFlag { Option<Frozen<Effects>>.some(self.emptyEffects.clone()) } else { Option<Frozen<Effects>>.None }
    let target = self.nodeMut(slot)
    if !Frozen.same(&target.styled, &styled) || target.moving.isSome() {
      target.styled = move styled
      target.moving.clear()
    }
    target.computedStamp = stamp
    target.rendered = rendered
    target.fontKey = fontKey
    target.paintHash = paintHash
    if let Option<Frozen<Effects>>.Some { value } = move emptyEffects {
      target.hasEffectsFlag = false
      target.effects = move value
    }
    run self.dropTickBase(slot)
    return true
  }

  // Keeps what text node `slot` was just given, for its parent's equals' text children.
  effect fn keepTextInherit(self: &mut Self, slot: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let place = self.textInheritPlace(slot)
    if place == usize.MAX { return () }
    let node = self.node(slot)
    if node.moving.isSome() || node.hasEffectsFlag { return () }
    let parent = self.node(node.parent)
    let entry = TextInherit {
      parentStamp: parent.computedStamp, parentRendered: parent.rendered, width: self.cssWidth(), height: self.cssHeight(),
      styled: node.styled.clone(), stamp: node.computedStamp, rendered: node.rendered, fontKey: node.fontKey, paintHash: node.paintHash,
    }
    while self.textInherits.length() <= place {
      let filler = entry.styled.clone()
      run self.textInherits.append(TextInherit {
        parentStamp: 0, parentRendered: false, width: 0.0, height: 0.0,
        styled: move filler, stamp: 0, rendered: false, fontKey: 0, paintHash: 0,
      })
    }
    let entries = self.textInherits.asMutSlice()
    entries[place] = move entry
  }

  // Forgets the base of animations node `slot` kept, as a full restyle with none playing does.
  effect fn dropTickBase(self: &mut Self, slot: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let at = u32.toUsize(slot)
    if at >= self.tickPlaces.length() { return () }
    let place = self.tickPlaces.get(at)
    if place != 0 {
      let bases = self.tickBases.asMutSlice()
      bases[u32.toUsize(place) - 1].id = NONE
    }
  }

  // The lender of node `slot` when the node can take the lender's whole result, else NONE:
  // what `resolve` would build from the lender's values is then the lender's own result.
  fn wholeLender(self: &Self, slot: u32) -> u32 {
    let node = self.node(slot)
    if node.styleTwin == NONE || node.generatedSuppressed || node.moving.isSome() { return NONE }
    let lender = self.computedLender(slot)
    if lender == NONE { return NONE }
    let other = self.node(lender)
    if other.moving.isSome() || other.generatedSuppressed { return NONE }
    let values = other.computed()
    if values.effects.shadowFrom == lender || values.list.item() || values.list.counters() { return NONE }
    // A table part's spans come from its own attributes.
    if values.layout.display.isTablePart() && !sameSpans(node, &values.layout) { return NONE }
    if values.anchor.name != 0 || values.anchor.anchored() || values.cursorUrl { return NONE }
    if node.parent != NONE && self.node(node.parent).computed().contain.hidden() { return NONE }
    return lender
  }

  // Gives node `slot` the whole result of its lender (`wholeLender`): the lender's style
  // handle, stamp, font and paint keys, and its layout style entry.
  effect fn takeLenderResult(self: &mut Self, slot: u32, lender: u32) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    self.work.lenders = self.work.lenders + 1
    self.work.sharedResults = self.work.sharedResults + 1
    let other = self.node(lender)
    let styled = other.styled.clone()
    let lentHasEffects = other.hasEffectsFlag
    let lentEffects = other.effects.clone()
    let stamp = other.computedStamp
    let fontKey = other.fontKey
    let paintHash = other.paintHash
    let parent = self.node(slot).parent
    let parentRendered = parent == NONE || self.node(parent).rendered
    let rendered = parentRendered && !styled.get().layout.display.isNone()
    let lenderCss = other.css
    let lenderGrid = other.gridStyled
    run style_change.prepare(&mut self, slot, false)
    let target = self.nodeMut(slot)
    if !Frozen.same(&target.styled, &styled) || target.moving.isSome() {
      target.styled = styled.clone()
      target.moving.clear()
    }
    target.computedStamp = stamp
    target.rendered = rendered
    target.fontKey = fontKey
    target.paintHash = paintHash
    target.hasEffectsFlag = lentHasEffects
    target.effects = move lentEffects
    run self.dropTickBase(slot)
    let css = self.node(slot).css
    let values = styled.get()
    run Effect.catchAll(self.layout.shareStyle(NodeId { index: css }, NodeId { index: lenderCss }, values.layout), layoutFailed)
    if values.contain.automatic() != self.layout.automatic(css) {
      run Effect.catchAll(
        self.layout.setAutomatic(NodeId { index: css }, values.contain.automatic(), values.contain.intrinsicBlock()),
        layoutFailed,
      )
    }
    // The lender's match is this node's: no grid declaration there leaves no grid here.
    if lenderGrid || self.node(slot).gridStyled { run self.resolveGrid(slot, values) }
    run self.updateShape(slot)
    let names = run containers.names(&self, slot)
    let namesChanged = !containers.sameNames(&self, slot, names.asSlice())
    if names.length() != 0 || self.node(slot).identity().isSome() {
      let node = self.nodeMut(slot)
      let identity = run node.identityMut()
      run identity.setContainerNames(move names)
    }
    return namesChanged
  }

  effect fn resolve(self: &mut Self, slot: u32, tick: bool) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    self.work.resolves = self.work.resolves + 1
    if tick { self.work.ticks = self.work.ticks + 1 }
    if !tick && self.styleSheets.length() != 0 && !(self.node(slot).isGenerated() && self.node(slot).kind == NodeKind.Box) { run self.resolveSheet(slot) }
    if !tick {
      if run self.inheritText(slot) { return false }
      let shared = self.wholeLender(slot)
      if shared != NONE { return run self.takeLenderResult(slot, shared) }
    }
    if self.tickWidth != self.input.width || self.tickHeight != self.input.height {
      self.tickBases.clear()
      self.tickPlaces.clear()
      self.tickWidth = self.input.width
      self.tickHeight = self.input.height
    }
    let parent = self.node(slot).parent
    let inherited = if parent != NONE { self.node(parent).computed().text } else { self.rootText() }
    let mut stops = Intrinsic.replace(self.easingStops, EasingStops.make())
    let initialNode = self.node(slot)
    let simpleStyles = !initialNode.styleNeedsContext && initialNode.sheetStyle().isNone() && self.overrides.length() == 0 && !initialNode.isGenerated()
    // A frame of the clock changes nothing under the node's animations: the style its last
    // full restyle built there is the one this would build. Anchors move without a restyle.
    let based = if tick && self.anchors.length() == 0 { self.tickBaseOf(slot) } else { usize.MAX }
    let lender = if based != usize.MAX || simpleStyles || initialNode.styleTwin == NONE { NONE } else { self.computedLender(slot) }

    let mut computed = if based != usize.MAX { self.tickBases.asSlice()[based].computed } else { self.valuesToStartFrom(lender, inherited) }
    if based == usize.MAX {
    // border-collapse, border-spacing, caption-side and empty-cells inherit.
    if lender == NONE && parent != NONE {
      inheritTable(&mut computed.layout, &self.node(parent).computed().layout)
      computed.emptyCellsHide = self.node(parent).computed().emptyCellsHide
      computed.accentColor = self.node(parent).computed().accentColor
      computed.hasAccentColor = self.node(parent).computed().hasAccentColor
      computed.list = ListStyle.inherited(self.node(parent).computed().list)
    }
    if lender == NONE && !simpleStyles && containers.usesUnits(&self, slot) {
      computed.containerWidth = containers.physicalUnit(&self, slot, true)
      computed.containerHeight = containers.physicalUnit(&self, slot, false)
      computed.usesContainer = true
      computed.usesViewport = true
    }

    // A lender's values are the finished ones: everything below would write them again.
    if lender == NONE {
    // CSS pointer-events inherits, but an explicit descendant auto remains targetable.
    if parent != NONE {
      computed.paint.pointerEvents = self.node(parent).computed().paint.pointerEvents
      computed.scroll.colors = self.node(parent).computed().scroll.colors
      computed.nearest = self.node(parent).computed().nearest
      computed.svg = self.node(parent).computed().svg
    }
    computed.layout.display = defaultDisplay(if initialNode.isGenerated() { NodeKind.Text } else { initialNode.kind })
    if initialNode.kind == NodeKind.Input {
      // Inputs keep their spaces; one line scrolls sideways, several wrap and scroll down.
      if initialNode.edit().multiline {
        computed.apply(&declare.whiteSpace(WhiteSpace.PreWrap))
        computed.layout.overflowX = Overflow.Hidden
        computed.layout.overflowY = Overflow.Auto
      } else {
        computed.apply(&declare.whiteSpace(WhiteSpace.Pre))
        computed.layout.overflowX = Overflow.Hidden
        computed.layout.overflowY = Overflow.Hidden
      }
    } else if initialNode.kind == NodeKind.Icon {
      // HTML/SVG UA default: `svg:not(:root) { overflow: hidden }`, overridable by author CSS.
      computed.layout.overflowX = Overflow.Hidden
      computed.layout.overflowY = Overflow.Hidden
    }
    applyDirAttribute(initialNode, &mut computed)
    if initialNode.hasTransition() {
      run stops.read(String.utf8Bytes(initialNode.transition()))
      run motion.declare(&mut computed.transition, motion.SHORTHAND, String.utf8Bytes(initialNode.transition()), &mut stops)
    }
    // The user agent's `:focus-visible { outline: auto }`, under every look the app sets, so
    // `outline: none` or another outline in any of them replaces it, as in a browser.
    if self.focused == slot && initialNode.kind != NodeKind.Text && (self.focusVisible || initialNode.kind == NodeKind.Input) {
      computed.outline.auto = true
      computed.outline.width = FOCUS_RING_WIDTH * computed.text.zoom
    }
    if simpleStyles {
      self.applyPixelStyles(slot, &mut computed)
    } else {
      let units = run font_units.prepare(&mut self, slot, &mut computed, FontSource.Node)
      let parentStyle = if parent == NONE { self.rootParent() } else { self.node(parent).computed().* }
      run self.applyNodeLengths(slot, &mut computed, &parentStyle, &mut stops, &units)
    }
    }
    if computed.layout.display.isTablePart() { tableSpans(self.node(slot), &mut computed.layout) }
    if self.listsUsed && self.node(slot).kind == NodeKind.Box && lists.isMarker(self.node(slot)) { lists.markerLayout(&mut computed, self.node(parent).computed().list) }
    if computed.list.item() || computed.list.counters() {
      self.listsUsed = true
      self.listsDirty = true
    }
    if computed.scroll.snapsX() || computed.scroll.snapsY() { self.snapUsed = true }
    if computed.transform.offset.path != transform.PATH_NONE { self.offsetUsed = true }
    if computed.transform.preserve3d { self.preserveUsed = true }
    let node = self.node(slot)
    if !node.isGenerated() { anchoring.apply(&self, node.id, &mut computed) }
    if computed.anchor.name != 0 || computed.anchor.anchored() {
      self.cssAnchorUsed = true
      css_anchor.apply(&self, slot, self.node(slot).id, &mut computed)
    }
    let animationUnits = if simpleStyles { 0 } else { animation.relativeUnits(&self, slot, &computed.animation, &stops) }
    if animationUnits & 2 != 0 && !computed.usesContainer {
      computed.containerWidth = containers.physicalUnit(&self, slot, true)
      computed.containerHeight = containers.physicalUnit(&self, slot, false)
      computed.usesContainer = true
    }
    if animationUnits != 0 { computed.usesViewport = true }
    run self.keepTickBase(slot, &computed, !simpleStyles && computed.animation.names.start != usize.MAX)
    }
    let node = self.node(slot)
    let kind = node.kind
    computed.userSelect = usedUserSelect(
      computed.userSelect,
      if parent == NONE { SELECT_TEXT } else { self.node(parent).computed().userSelect },
      kind == NodeKind.Input,
    )
    // `content-visibility: hidden` skips its contents the way `display: none` does.
    if node.generatedSuppressed || parent != NONE && self.node(parent).computed().contain.hidden() { computed.layout.display = CssDisplay.None }
    run style_change.prepare(&mut self, slot, computed.usesContainer)
    let parentRendered = parent == NONE || self.node(parent).rendered
    let rendered = parentRendered && !computed.layout.display.isNone()
    let needsMotion = kind != NodeKind.Text && (!simpleStyles || self.node(slot).hasTransition()
      || self.node(slot).starting().length != 0 || self.node(slot).activeTransitions != 0 || self.hasPlayingAnimation(slot))
    // What `filter`, which lives in the paint effects, eases with (see `moveFilters`).
    let mut filterBefore = false
    let mut motionAnimated: u64 = 0
    if needsMotion {
      let mut before = style_change.before(&self, slot)
      let mut hasBefore = style_change.rendered(&self, slot) && parentRendered
      filterBefore = hasBefore
      let sheetStarting = match self.node(slot).sheetStyle() { Option.Some { value } => value.starting.isSome() _ => false }
      if !hasBefore && rendered && (sheetStarting || self.node(slot).starting().length != 0) {
        before = computed
        let parentStyle = if parent == NONE { self.rootParent() } else { self.node(parent).computed().* }
        let startUnits = run font_units.prepare(&mut self, slot, &mut before, FontSource.Starting)
        run self.applyNodeLengths(slot, &mut before, &parentStyle, &mut stops, &startUnits)
        if sheetStarting {
          if let Option.Some { value } = self.node(slot).sheetStyle() {
            if let Option.Some { value: start } = &value.starting {
              run applyUsing(&mut before, start.asSlice(), &parentStyle, &mut stops, &startUnits)
            }
          }
        } else {
          run applyUsing(&mut before, self.node(slot).starting(), &parentStyle, &mut stops, &startUnits)
        }
        hasBefore = true
      }
      self.easingStops = move stops
      let underlyingFontSize = computed.text.size
      let animated = run animation.update(&mut self, slot, rendered, &computed)
      motionAnimated = animated
      if self.node(slot).generatedSuppressed { run motion.cancelAll(&mut self, slot) }
      else { run motion.transition(&mut self, slot, &before, hasBefore, &mut computed, animated) }
      if u64.bitAnd(animated, u64.shiftLeft(1, u32.toU64(motion.FONT_SIZE))) != 0 {
        let fontUnits = run font_units.inherited(&mut self, slot, &computed)
        let mut unkept = KeptSamples.none()
        run animation.apply(&self, slot, &mut computed, &fontUnits, true, &mut unkept)
      }
      if computed.text.size != underlyingFontSize {
        let moving = computed
        let parentStyle = if parent == NONE { self.rootParent() } else { self.node(parent).computed().* }
        let currentUnits = run font_units.refresh(&mut self, slot, &mut computed)
        let mut currentStops = Intrinsic.replace(self.easingStops, EasingStops.make())
        run self.applyNodeLengths(slot, &mut computed, &parentStyle, &mut currentStops, &currentUnits)
        self.easingStops = move currentStops
        if self.node(slot).activeTransitions != 0 {
          let transitions = self.transitions.asSlice()
          let mut i: usize = 0
          while i < transitions.length {
            let item = transitions[i]
            if item.slot == slot && item.id == self.node(slot).id {
              motion.write(&mut computed, item.field, motion.sample(&moving, item.field))
            }
            i = i + 1
          }
        }
      }
      if animated != 0 {
        let key = run self.fontKeyOf(computed.text)
        let currentUnits = font_units.context(&self, slot, &computed, key)
        // The keyframes' values hold while the style under the animations and the font their
        // units read do: the font moves when an animation sets its size.
        let held = self.tickBaseOf(slot)
        let steady = held != usize.MAX && u64.bitAnd(animated, u64.shiftLeft(1, u32.toU64(motion.FONT_SIZE))) == 0
          && computed.text.size == underlyingFontSize
        let mut kept = if steady { self.tickBases.asSlice()[held].samples } else { KeptSamples.none() }
        run animation.apply(&self, slot, &mut computed, &currentUnits, false, &mut kept)
        if steady {
          let bases = self.tickBases.asMutSlice()
          bases[held].samples = kept
        }
      }
    } else {
      self.easingStops = move stops
    }
    if kind != NodeKind.Text && !self.node(slot).isGenerated() && self.overrides.length() != 0 {
      let finalUnits = run font_units.prepare(&mut self, slot, &mut computed, FontSource.Overrides)
      let parentStyle = style_sheets.parentStyle(&self, slot)
      let mut finalStops = Intrinsic.replace(self.easingStops, EasingStops.make())
      let node = self.node(slot)
      if let Option<&Resolved>.Some { value } = node.sheetStyle() {
        run applyUsing(&mut computed, value.overrides.asSlice(), &parentStyle, &mut finalStops, &finalUnits)
      } else {
        let mut declarations = List<Declaration>.make()
        let states = [StyleState.Base, StyleState.Hover, StyleState.Active, StyleState.Focus, StyleState.FocusVisible]
        let mut i: usize = 0
        while i < states.length {
          if style_sheets.active(&self, slot, states[i]) {
            if let Option<&StyleOverride>.Some { value } = self.overrideOf(node.id, states[i]) {
              let mut j: usize = 0
              while j < value.declarations.length() {
                run css.set(&mut declarations, &value.declarations.asSlice()[j])
                j = j + 1
              }
            }
          }
          i = i + 1
        }
        run applyUsing(&mut computed, declarations.asSlice(), &parentStyle, &mut finalStops, &finalUnits)
      }
      self.easingStops = move finalStops
    }
    if self.letterUsed && kind == NodeKind.Box && self.node(slot).isGenerated() { run self.dropCap(slot, &mut computed) }
    let css = self.node(slot).css
    let sizeChanged = self.node(slot).computed().text.size != computed.text.size
    let zoomChanged = self.node(slot).computed().text.zoom != computed.text.zoom
    if parent != NONE {
      let above = self.node(parent).computed().effects
      computed.effects.shadowFrom = above.shadowFrom
      computed.effects.shadowHash = above.shadowHash
    }
    let fontKey = if simpleStyles && kind == NodeKind.Text && parent != NONE { self.node(parent).fontKey } else { run self.fontKeyOf(computed.text) }
    run self.resolveEffects(slot, &mut computed, fontKey, needsMotion, filterBefore, motionAnimated)
    computed.finish(fontKey)
    let paintHash = computed.paintHash(&self.seed)
    let stamp = if lender == NONE { self.computedStamps + 1 } else { self.node(lender).computedStamp }
    if lender == NONE { self.computedStamps = stamp }
    if lender != NONE { self.work.lenders = self.work.lenders + 1 }
    if tick { run self.setMovingComputed(slot, &computed) } else { run self.setComputed(slot, &computed) }
    let target = self.nodeMut(slot)
    target.computedStamp = stamp
    target.rendered = rendered
    target.fontKey = fontKey
    target.paintHash = paintHash
    run container_watch.units(&mut self, slot)
    if !tick && kind == NodeKind.Text && simpleStyles { run self.keepTextInherit(slot) }
    if kind != NodeKind.Text {
      // css-layout leaves the node clean when the style is the one it already has.
      let used = controlLayout(self.node(slot), computed.layout)
      run Effect.catchAll(
        self.layout.setStyle(NodeId { index: css }, used),
        layoutFailed,
      )
      if computed.contain.automatic() != self.layout.automatic(css) {
        run Effect.catchAll(
          self.layout.setAutomatic(NodeId { index: css }, computed.contain.automatic(), computed.contain.intrinsicBlock()),
          layoutFailed,
        )
      }
      run self.resolveGrid(slot, &computed)
      run self.updateShape(slot)
    }
    let mut namesChanged = false
    if kind != NodeKind.Text {
      let names = if simpleStyles { List<Bytes>.make() } else { run containers.names(&self, slot) }
      namesChanged = !containers.sameNames(&self, slot, names.asSlice())
      if names.length() != 0 || self.node(slot).identity().isSome() {
        let node = self.nodeMut(slot)
        let identity = run node.identityMut()
        run identity.setContainerNames(move names)
      }
    }
    if (kind == NodeKind.Icon && sizeChanged) || (kind == NodeKind.Image && zoomChanged) {
      run self.updateNatural(slot)
    }
    if kind == NodeKind.Input && self.node(slot).edit().runs.length() != 0 {
      run rich.styleRuns(&mut self, slot)
    }
    return namesChanged
  }

  /// Reads the effect properties of node `slot`'s active looks into its `Effects`, after the
  /// rest of its style is in `computed`, so `em` and `currentColor` see its font and color.
  /// With `moving` (the node's style went through `motion`), its `filter` also eases: see
  /// [`moveFilters`] for `hasBefore` and `animated`.
  effect fn resolveEffects(self: &mut Self, slot: u32, computed: &mut Computed, fontKey: usize, moving: bool, hasBefore: bool, animated: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let moves = moving && motion.filterMoves(&self, slot, &computed.transition, animated)
    if !computed.effects.declared {
      // A filter that eases away (or an animation's filter) still needs effects to paint.
      let showing = match self.node(slot).paintEffects() {
        Option.Some { value } => value.filters.length() != 0
        _ => false
      }
      let animatesFilter = u64.bitAnd(animated, u64.shiftLeft(1, u32.toU64(motion.FILTER))) != 0
      if !moves || !(showing || animatesFilter) {
        if self.node(slot).hasEffectsFlag {
          let empty = self.emptyEffects.clone()
          let target = self.nodeMut(slot)
          target.hasEffectsFlag = false
          target.effects = move empty
        }
        return ()
      }
    }
    let basis = font_units.paintBasis(&self, slot, &computed.*, fontKey)
    let mut effects = Effects.make()
    let node = self.node(slot)
    if let Option<&Resolved>.Some { value } = node.sheetStyle() {
      run self.applyEffects(&mut effects, value.declarations.asSlice(), node.parent, basis)
      run self.applyEffects(&mut effects, value.overrides.asSlice(), node.parent, basis)
    } else {
      let states = [StyleState.Base, StyleState.Hover, StyleState.Active, StyleState.Focus, StyleState.FocusVisible]
      let mut i: usize = 0
      while i < states.length {
        let state = states[i]
        if style_sheets.active(&self, slot, state) {
          let replace = match self.overrideOf(node.id, state) { Option.Some { value } => value.replace _ => false }
          if !replace { run self.applyEffects(&mut effects, effectLook(node, state), node.parent, basis) }
        }
        i = i + 1
      }
      if self.overrides.length() != 0 {
        i = 0
        while i < states.length {
          if style_sheets.active(&self, slot, states[i]) {
            if let Option.Some { value } = self.overrideOf(node.id, states[i]) {
              run self.applyEffects(&mut effects, value.declarations.asSlice(), node.parent, basis)
            }
          }
          i = i + 1
        }
      }
    }
    if moves { run self.moveFilters(slot, &mut effects, &computed.*, basis, hasBefore, animated) }
    if !computed.effects.declared && effects.filters.length() == 0 {
      // Eased all the way to `none`, with nothing else declared.
      if self.node(slot).hasEffectsFlag {
        let empty = self.emptyEffects.clone()
        let target = self.nodeMut(slot)
        target.hasEffectsFlag = false
        target.effects = move empty
      }
      return ()
    }
    computed.effects.hash = effects.hash
    computed.effects.layered = effects.layered()
    computed.effects.stacks = effects.stacks
    if effects.hasShadows {
      if effects.shadows.length() == 0 {
        computed.effects.shadowFrom = NO_SHADOW
        computed.effects.shadowHash = 0
      } else {
        computed.effects.shadowFrom = slot
        computed.effects.shadowHash = effects.hash
      }
    }
    let frozen = run Frozen<Effects>.make(move effects)
    let target = self.nodeMut(slot)
    target.hasEffectsFlag = true
    target.effects = move frozen
  }

  pub effect fn recordEndedFilter(self: &mut Self, slot: u32, id: u32, filters: FilterList) -> () ! OutOfMemoryError ? &mut Allocator {
    let items = self.endedFilters.asMutSlice()
    let mut i: usize = 0
    while i < items.length {
      if items[i].slot == slot {
        items[i] = EndedFilter { slot: slot, id: id, filters: filters }
        return ()
      }
      i = i + 1
    }
    run self.endedFilters.append(EndedFilter { slot: slot, id: id, filters: filters })
  }

  fn takeEndedFilter(self: &mut Self, slot: u32, id: u32) -> Option<FilterList> {
    let mut i: usize = 0
    while i < self.endedFilters.length() {
      let item = self.endedFilters.asSlice()[i]
      if item.slot == slot {
        drop self.endedFilters.remove(i)
        if item.id == id { return Option<FilterList>.some(item.filters) }
        return Option<FilterList>.None
      }
      i = i + 1
    }
    return Option<FilterList>.None
  }

  /// Eases the `filter` of `effects`, the paint effects node `slot`'s new style `computed`
  /// computes: a `filter` transition from the list the node showed (when `hasBefore`, it had a
  /// before-change style), then the animations that set it (bits of `animated`) over that.
  effect fn moveFilters(self: &mut Self, slot: u32, effects: &mut Effects, computed: &Computed, basis: paint_css.Basis, hasBefore: bool, animated: u64) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    let after = match filter_motion.of(&effects.*) {
      Option.Some { value } => value
      // Too long to ease: it shows as computed.
      _ => { return () }
    }
    let nodeId = self.node(slot).id
    let showed = match self.takeEndedFilter(slot, nodeId) {
      Option<FilterList>.Some { value } => Option<FilterList>.some(value)
      Option<FilterList>.None => filter_motion.ofNode(self.node(slot).paintEffects())
    }
    let before = match showed { Option.Some { value } => value _ => FilterList.none() }
    let mut shown = after
    let mut moved = false
    if let Option.Some { value } = run motion.transitionFilter(&mut self, slot, computed, before, hasBefore && showed.isSome(), after, animated) {
      shown = value
      moved = true
    }
    if u64.bitAnd(animated, u64.shiftLeft(1, u32.toU64(motion.FILTER))) != 0 {
      if let Option.Some { value } = run animation.applyFilters(&self, slot, shown, basis) {
        shown = value
        moved = true
      }
    }
    if moved { run filter_motion.write(&shown, &mut effects.*) }
  }

  effect fn applyEffects(self: &Self, effects: &mut Effects, declarations: &[Declaration], parent: u32, basis: paint_css.Basis) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    while i < declarations.length {
      let declaration = &declarations[i]
      let property = declaration.property
      if paint_css.reads(property) {
        let inherited = properties_convert.isKeyword(&declaration.value, Keyword.Inherit)
          || properties_convert.isKeyword(&declaration.value, Keyword.Unset) && catalog.inherited(property)
        if inherited {
          // Inheritance with no defining ancestor still replaces an earlier look.
          run paint_css.initial(&mut effects.*, property, basis)
          run self.inheritEffect(&mut effects.*, parent, property)
        } else if properties_convert.isKeyword(&declaration.value, Keyword.Initial)
          || properties_convert.isKeyword(&declaration.value, Keyword.Unset) {
          run paint_css.initial(&mut effects.*, property, basis)
        } else { run paint_css.apply(&mut effects.*, declaration, basis) }
      }
      i = i + 1
    }
  }

  /// The winning active declaration, with inspector overrides above all client looks.
  fn effectDeclaration(self: &Self, slot: u32, property: CssProperty) -> Option<&Declaration> {
    let node = self.node(slot)
    if let Option.Some { value } = node.sheetStyle() {
      let override = lastEffect(value.overrides.asSlice(), property)
      if override.isSome() { return override }
      return lastEffect(value.declarations.asSlice(), property)
    }
    let states = [StyleState.FocusVisible, StyleState.Focus, StyleState.Active, StyleState.Hover, StyleState.Base]
    let mut i: usize = 0
    if self.overrides.length() != 0 {
      while i < states.length {
        if style_sheets.active(&self, slot, states[i]) {
          if let Option.Some { value } = self.overrideOf(node.id, states[i]) {
            let found = lastEffect(value.declarations.asSlice(), property)
            if found.isSome() { return found }
          }
        }
        i = i + 1
      }
    }
    i = 0
    while i < states.length {
      if style_sheets.active(&self, slot, states[i]) {
        let replace = match self.overrideOf(node.id, states[i]) { Option.Some { value } => value.replace _ => false }
        if !replace {
          let found = lastEffect(effectLook(node, states[i]), property)
          if found.isSome() { return found }
        }
      }
      i = i + 1
    }
    return Option<&Declaration>.None
  }

  /// Replay the inherited longhand against its defining ancestor's computed font
  /// and foreground, freezing em/currentColor but retaining box percentages.
  effect fn inheritEffect(self: &Self, effects: &mut Effects, parent: u32, property: CssProperty) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    let mut ancestor = parent
    while ancestor != NONE {
      let node = self.node(ancestor)
      let mut inherit = catalog.inherited(property)
      if let Option.Some { value } = self.effectDeclaration(ancestor, property) {
        if properties_convert.isKeyword(&value.value, Keyword.Inherit) {
          inherit = true
        } else if properties_convert.isKeyword(&value.value, Keyword.Unset) {
          inherit = catalog.inherited(property)
        } else if properties_convert.isKeyword(&value.value, Keyword.Initial) {
          return ()
        } else {
          run paint_css.apply(&mut effects.*, value, font_units.paintBasis(&self, ancestor, &node.computed().*, node.fontKey))
          return ()
        }
      }
      if !inherit { return () }
      ancestor = node.parent
    }
  }

  // Style overrides.

  /// The index of node `id`'s override in `state`, or `usize.MAX`.
  fn overrideIndex(self: &Self, id: u32, state: StyleState) -> usize {
    let list = self.overrides.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].id == id && list[i].state == state {
        return i
      }
      i = i + 1
    }
    return usize.MAX
  }

  /// Applies `client`, node `id`'s own declarations in `state`, with its override laid over
  /// them as one list, so `em` lengths see the font size either of them sets.
  effect fn applyOverridden(
    self: &Self,
    computed: &mut Computed,
    id: u32,
    state: StyleState,
    client: &[Declaration],
    stops: &mut EasingStops,
    parent: &Computed,
    units: &Context,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = self.overrideIndex(id, state)
    if at == usize.MAX {
      run applyUsing(&mut computed, client, parent, &mut stops, units)
      return ()
    }
    let laid = &self.overrides.asSlice()[at]
    let mut merged = List<Declaration>.make()
    if !laid.replace {
      let own = client
      let mut i: usize = 0
      while i < own.length {
        run merged.append(run css.cloneDeclaration(&own[i]))
        i = i + 1
      }
    }
    let over = laid.declarations.asSlice()
    let mut j: usize = 0
    while j < over.length {
      run css.set(&mut merged, &over[j])
      j = j + 1
    }
    run applyUsing(&mut computed, merged.asSlice(), parent, &mut stops, units)
  }

  /// Whether node `id` has an override in `state`. Costs nothing while there are none.
  pub fn overridden(self: &Self, id: u32, state: StyleState) -> bool {
    if self.overrides.length() == 0 {
      return false
    }
    return self.overrideIndex(id, state) != usize.MAX
  }

  /// The `font-family` text font family `family` was defined with, if the tree knows it.
  pub fn fontFamilyText(self: &Self, family: u32) -> Option<string<'_>> {
    return self.families.text(family)
  }

  /// Node `id`'s override in `state`, if it has one.
  pub fn overrideOf(self: &Self, id: u32, state: StyleState) -> Option<&StyleOverride> {
    let at = self.overrideIndex(id, state)
    if at == usize.MAX {
      return Option<&StyleOverride>.None
    }
    return Option<&StyleOverride>.some(&self.overrides.asSlice()[at])
  }

  /// Every override, oldest first.
  pub fn styleOverrides(self: &Self) -> &[StyleOverride] {
    return self.overrides.asSlice()
  }

  /// Lays `declarations` over what the client set for node `id` in `state` (instead of it,
  /// with `replace`), in place of the override the node had there: for a second party that
  /// shares the tree, such as the inspector trying a style. The client's own declarations
  /// are kept underneath and stay its to change (`SetStyle`, `ClearStyle`); the override
  /// applies over whatever they are, until `clearOverride`, and goes when the node is
  /// destroyed. No declarations and no `replace` clears the override. The node's root styles
  /// again at its next frame, as after a mutation of it; no other root does, and no event
  /// record tells the client. Returns false when there is no node `id`.
  pub effect fn setOverride(
    self: &mut Self,
    id: u32,
    state: StyleState,
    declarations: List<Declaration>,
    replace: bool,
  ) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let slot = self.slotOf(id)
    if slot == NONE {
      return false
    }
    let at = self.overrideIndex(id, state)
    if declarations.length() == 0 && !replace {
      if at != usize.MAX {
        drop self.overrides.remove(at)
        self.restyled(slot)
      }
      return true
    }
    let laid = StyleOverride {
      id: id,
      state: state,
      declarations: move declarations,
      replace: replace,
    }
    if at == usize.MAX {
      run self.overrides.append(move laid)
    } else {
      self.overrides.set(at, move laid)
    }
    self.restyled(slot)
    return true
  }

  /// Takes node `id`'s override in `state` away: the node shows what its client set again.
  /// Returns whether it had one.
  pub fn clearOverride(self: &mut Self, id: u32, state: StyleState) -> bool {
    let at = self.overrideIndex(id, state)
    if at == usize.MAX {
      return false
    }
    drop self.overrides.remove(at)
    let slot = self.slotOf(id)
    if slot != NONE {
      self.restyled(slot)
    }
    return true
  }

  /// Takes every override of node `id` away, for a node being destroyed.
  fn dropOverrides(self: &mut Self, id: u32) -> () {
    let mut i: usize = 0
    while i < self.overrides.length() {
      if self.overrides.asSlice()[i].id == id {
        drop self.overrides.remove(i)
      } else {
        i = i + 1
      }
    }
  }

  /// An override of the node at `slot` changed: its root styles again at its next frame and
  /// counts the change in its revision, as a mutation of the node would.
  fn restyled(self: &mut Self, slot: u32) -> () {
    self.semanticRevision = self.semanticRevision + 1
    let holder = self.rootHolding(slot)
    if holder != NONE {
      self.touchRoot(holder)
    } else {
      // A detached node styles when it is attached again.
      self.markStylesDirty(23)
    }
  }

  // Frames.

  /// Whether the last layout still describes css-layout's tree: no change since.
  pub fn laidOutCurrent(self: &Self) -> bool {
    return self.layout.revision() == self.laidOutRevision
  }

  /// Whether the last layout has a fragment for every node it could: no node was created or
  /// moved since, though styles may have changed.
  pub fn laidOutNodes(self: &Self) -> bool {
    return self.laidOutRevision != usize.MAX && self.layout.structureRevision() <= self.laidOutRevision
  }

  /// Whether a frame would draw something new: styles, layout or scroll offsets changed, or a
  /// scroll into view waits. Hosts that draw only on demand ask after applying batches and
  /// dispatching input.
  pub fn needsFrame(self: &Self) -> bool {
    return self.applied || self.stylesDirty || self.stylesPending || self.paintDirty || self.scrolled
      || self.hoverSettleAt >= 0.0
      || cssom_view.scrollAnimating(self)
      || self.textSelection.scrolling
      || scroll_snap.waiting(self)
      || touch.animating(self)
      || motion.animating(self)
      || animation.animating(self)
      || self.layout.revision() != self.laidOutRevision
      || self.layout.scrollRevision() != self.laidOutScrolls
      || self.reveal.length() != 0
      || !self.replayable
  }

  /// The scene of the last frame, finished and ready to draw.
  pub fn scene(self: &Self) -> &Scene {
    if self.flipped {
      return &self.sceneB
    }
    return &self.sceneA
  }

  /// Whether a frame at `input` can keep the last scene: the tree asks for no frame of its
  /// own (no mutation, style, layout, scroll, animation or paint change since it was painted:
  /// `needsFrame`), the viewport is the one painted, and nothing paints differently with time
  /// alone (a caret in another blink phase, an animated icon, a font block period ending) or waits to be
  /// picked up at paint (faces to load, a selection to rebuild). A frame asked for only by the
  /// host or the client (`requestAnimationFrame`, a canvas present) then skips its paint.
  fn quietFrame(self: &Self, input: FrameInput) -> bool {
    return !self.needsFrame() && self.paintsAlike(input) && text_selection.settled(self)
  }

  /// [`quietFrame`] for a frame that only scrolled: scroll containers moved, by a `ScrollTo`,
  /// a wheel or a scroll animation, and nothing else asks for a frame. Scrolling changes no
  /// primitive of the scene, only where its scroll groups are drawn, so such a frame keeps
  /// the scene while what it shows was painted (`scrollsWithinLead`). A scroll mutation moves
  /// the tree's revision, so the selection is checked again in the frame, not here.
  fn scrolledFrame(self: &Self, input: FrameInput) -> bool {
    return (self.scrolled || cssom_view.scrollAnimating(self)) && !self.changesBesidesScroll()
      && self.paintsAlike(input)
  }

  /// `needsFrame` without the reasons that are a scroll: an offset that moved, and a scroll
  /// animation that moves one every frame.
  fn changesBesidesScroll(self: &Self) -> bool {
    return self.applied || self.stylesDirty || self.stylesPending || self.paintDirty
      || self.textSelection.scrolling
      || scroll_snap.waiting(self)
      || touch.animating(self)
      || motion.animating(self)
      || animation.animating(self)
      || self.layout.revision() != self.laidOutRevision
      || self.layout.scrollRevision() != self.laidOutScrolls
      || self.reveal.length() != 0
      || !self.replayable
  }

  /// Whether a paint at `input` now would draw what the last one drew, were nothing in the
  /// tree to change: the second half of [`quietFrame`].
  fn paintsAlike(self: &Self, input: FrameInput) -> bool {
    return self.paintedAt != 0
      && input.width == self.quietInput.width && input.height == self.quietInput.height
      && input.scale == self.quietInput.scale
      && !self.facesDirty && !self.paintCachesStale && !self.paintDirty
      && self.fontBlockEnd < 0.0
      && !edit.blinkDue(self, input.time)
      && !self.resources.icons.anyAnimated()
  }

  /// Applies styles, lays out what changed and paints the frame.
  pub effect fn frame(self: &mut Self, input: FrameInput) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let _frameSpan = Prof.span("ui_tree.frame")
    // Asked before the frame clears its flags: whether nothing changed since the last paint.
    let quiet = self.quietFrame(input)
    let scrolledOnly = self.scrolledFrame(input)
    self.frameNumber = self.frameNumber + 1
    self.heldAwake.clear()
    run self.trimNodes()
    self.releaseSlack()
    // A mutation said what it repaints when it was applied (see `repaintsNode`).
    if self.paintDirty {
      self.paintCachesStale = true
    }
    self.applied = false
    self.input = input
    self.provider.text.fonts.set.now = input.time
    drop self.provider.text.fonts.set.expireLate()
    if self.fontBlockEnd >= 0.0 && input.time >= self.fontBlockEnd {
      // Text waiting for a face shows its fallback now.
      self.invalidatePaint()
    }
    self.stats = FrameStats.zero()
    self.stats.frame = self.frameNumber
    run motion.tick(&mut self)
    run animation.tick(&mut self)
    style_change.begin(&mut self)
    let _styleSpan = Prof.span("ui_tree.resolveStyles")
    run self.resolveStyles()
    Prof.set("styledNodes", &self.stats.styledNodes)
    drop _styleSpan
    if self.laidOutNodes() {
      run scroll_anchor.select(&mut self)
    }
    run virtual.prepare(&mut self)
    let _layoutSpan = Prof.span("ui_tree.layout")
    run self.layoutFrame()
    Prof.set("skipped", &self.stats.layoutSkipped)
    drop _layoutSpan
    run Effect.catch<CssomError>(cssom_view.advanceScrolls(&mut self), viewFailed)
    if run text_selection.autoscroll(&mut self) {
      run self.layoutFrame()
    }
    run touch.advance(&mut self)
    run scroll_snap.settle(&mut self)
    if run scroll_snap.resnap(&mut self) {
      run self.layoutFrame()
    }
    if run interact.settleScrolls(&mut self) {
      run self.layoutFrame()
      drop run interact.settleScrolls(&mut self)
    }
    if run edit.revealCaret(&mut self) {
      run self.layoutFrame()
    }

    // Scrolling and relayout move content under a still pointer: hover follows, and a hover
    // variant that changes layout is laid out in the same frame. While content scrolls, hover
    // waits until the scroll settles (`followHover`).
    if !self.stats.layoutSkipped || self.scrolled || self.hoverDue() {
      // The hit test prunes by ink and follows stacking when those are current.
      if self.pointerInside && !self.paintDirty && !self.scrolled { run self.refreshPaintCaches() }
      run self.followHover()
      run self.resolveStyles()
      run self.layoutFrame()
    }
    run self.settleVirtual()
    run self.settleSkipped()
    run self.settleAnchors()
    run offset_path.settle(&mut self)
    run self.finishStyleChange()
    run self.notifyLayout()
    if self.laidOutCurrent() {
      run scroll_anchor.select(&mut self)
    }
    edit.beginPaint(&mut self)
    // A replayed scroll container keeps the cull lead (`quietInput.height * quietInput.scale`)
    // it was originally painted with. If the viewport grew since the last paint, scrollers must
    // repaint so `quietInput` does not overstate the lead of a replayed scroll group.
    self.scrollsStill = !self.scrolled
      && (self.paintedAt == 0
        || self.input.height * self.input.scale <= self.quietInput.height * self.quietInput.scale)
    if scrolledOnly {
      // What paint does first: a selection that changed asks for paint (`paintDirty`).
      run text_selection.refresh(&mut self)
    }
    if quiet && self.stats.layoutSkipped && self.stats.styledNodes == 0 && !self.paintDirty && !self.scrolled
      && self.layout.revision() == self.quietRevision && self.layout.scrollRevision() == self.quietScrolls {
      // Nothing this frame did changed what paints either: the last scene is this frame's.
      self.paintsKept = self.paintsKept + 1
      self.stats.primitives = self.scene().primitiveCount()
      Prof.set("paintKept", &true)
    } else if (scrolledOnly || quiet) && self.stats.layoutSkipped && self.stats.styledNodes == 0 && !self.paintDirty
      && self.layout.revision() == self.quietRevision && self.layout.scrollRevision() == self.quietScrolls
      && self.scrollsWithinLead() {
      // The frame scrolled and changed nothing else, and the last paint reached everything
      // the new offsets show: the last scene is this frame's, at the new offsets.
      run self.moveSceneScrolls()
      self.paintsKept = self.paintsKept + 1
      self.scrollsKept = self.scrollsKept + 1
      self.stats.primitives = self.scene().primitiveCount()
      Prof.set("scrollKept", &true)
    } else {
      run self.paintFrame()
      // Record the offsets each scroll group in this scene was actually painted (or replayed) at,
      // before `placeSceneScrolls` shifts replayed groups to the nodes' current offsets. Otherwise
      // an unrelated paint after a kept scroll advances `paintedScrolls` without repainting the
      // scroller, letting later kept scrolls drift past its cull lead.
      self.paintedScrolls.clear()
      if self.flipped {
        run self.paintedScrolls.appendSlice(self.sceneB.scrolls())
      } else {
        run self.paintedScrolls.appendSlice(self.sceneA.scrolls())
      }
      run self.placeSceneScrolls()
      self.quietInput = self.input
      self.quietRevision = self.layout.revision()
      self.quietScrolls = self.layout.scrollRevision()
    }
    self.fontBlockEnd = self.provider.text.fonts.set.nextDeadline()
    self.scrolled = false
    self.paintDirty = false
    self.stats.nodes = self.nodeCount()
    self.stats.fragments = self.output.fragments.values.length()
    self.work.frames = self.work.frames + 1
    if self.stats.styledNodes != 0 { self.work.styleFrames = self.work.styleFrames + 1 }
    self.work.paintFrames = self.work.paintFrames + 1
    self.work.paintedFragments = self.work.paintedFragments + self.stats.paintedFragments
    self.work.culledSubtrees = self.work.culledSubtrees + self.stats.culledSubtrees
    self.work.replayedSubtrees = self.work.replayedSubtrees + self.stats.replayedSubtrees
    self.work.repaintedSubtrees = self.work.repaintedSubtrees + self.stats.repaintedSubtrees
    self.work.replayedOperations = self.work.replayedOperations + self.stats.replayedOperations
    self.work.paintedGlyphs = self.work.paintedGlyphs + self.stats.glyphs
  }

  /// Whether every scroll container the last paint recorded is still within the paint's lead
  /// of where it was painted. Paint culls a scroll container's content to its scrollport and
  /// a lead of one viewport height past it each way (`Painter.lead`), so offsets within that
  /// lead show only content the scene holds. A container the paint did not record was culled
  /// whole, with what it holds.
  fn scrollsWithinLead(self: &Self) -> bool {
    let scale = self.quietInput.scale
    // A pixel short of the lead: device offsets are rounded where they are drawn.
    let reach = self.quietInput.height * scale - 1.0
    if reach <= 0.0 {
      return false
    }
    let painted = self.paintedScrolls.asSlice()
    let mut i: usize = 0
    while i < painted.length {
      let slot = self.slotOf(painted[i].node)
      if slot == NONE {
        return false
      }
      let node = self.node(slot)
      if f32.abs(node.scrollX() * scale - painted[i].x) > reach
        || f32.abs(node.scrollY() * scale - painted[i].y) > reach {
        return false
      }
      i = i + 1
    }
    return true
  }

  /// Moves the kept scene's scroll positions to the nodes' offsets now, so whoever draws the
  /// scene draws this frame.
  /// Gives the scene just painted the offset of every scroll container it recorded. A subtree
  /// that paint replayed says the offset it was first painted at, which is not the node's
  /// when frames since then kept the scene and only moved its scroll positions
  /// (`moveSceneScrolls`). What a replayed subtree draws does not depend on the offset: paint
  /// replays it only where the cull the offset gives leaves it whole.
  effect fn placeSceneScrolls(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let scale = self.input.scale
    let mut i: usize = 0
    while i < self.scene().scrolls().length {
      let mut position = self.scene().scrolls()[i]
      i = i + 1
      let slot = self.slotOf(position.node)
      if slot == NONE { continue }
      let x = self.node(slot).scrollX() * scale
      let y = self.node(slot).scrollY() * scale
      if position.x != x || position.y != y {
        position.x = x
        position.y = y
        if self.flipped {
          run self.sceneB.setScroll(position)
        } else {
          run self.sceneA.setScroll(position)
        }
      }
    }
  }

  effect fn moveSceneScrolls(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let scale = self.quietInput.scale
    let mut i: usize = 0
    while i < self.paintedScrolls.length() {
      let mut position = self.scene().scrolls()[i]
      let slot = self.slotOf(position.node)
      let x = self.node(slot).scrollX() * scale
      let y = self.node(slot).scrollY() * scale
      if position.x != x || position.y != y {
        position.x = x
        position.y = y
        if self.flipped {
          run self.sceneB.setScroll(position)
        } else {
          run self.sceneA.setScroll(position)
        }
      }
      i = i + 1
    }
  }

  /// Wakes the `content-visibility: auto` elements near the viewport, nearest first, and skips
  /// the contents of those far from it, laying out again until none changes or the frame's
  /// passes are spent.
  effect fn settleSkipped(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut pass: usize = 0
    while pass < SKIP_PASSES {
      if !(run self.reviewSkipped()) { break }
      run self.layoutFrame()
      pass = pass + 1
    }
  }

  // One look at the automatic elements: wakes up to SKIP_WAKES of the skipped ones within
  // SKIP_NEAR viewports, nearest first, and skips those beyond SKIP_FAR. Returns whether any
  // changed.
  effect fn reviewSkipped(self: &mut Self) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    // Nothing moved since the last look that found nothing to change.
    let seen = [self.layout.revision(), self.layout.scrollRevision(), f32.toUsize(self.input.height)]
    // Scroll offsets move fragments while painting, without a layout revision: `scrolled`.
    // A scroll moves each element by no more than the offsets moved: while that stays under the
    // distance the nearest element was from waking or being skipped, none changes, and a
    // scroll frame does not walk every element.
    if seen[0] == self.skipReview[0] && seen[1] == self.skipReview[1] && seen[2] == self.skipReview[2]
      && (!self.scrolled || self.skipTravel < self.skipSlack) { return false }
    let mut automatic = List<u32>.make()
    run self.layout.automaticElements(&mut automatic)
    if automatic.length() == 0 { return false }
    let height: f32 = self.input.height
    let near: f32 = height * SKIP_NEAR
    let far = height * SKIP_FAR
    let mut wakes = List<u64>.make()
    let mut changed = false
    let mut slack: f32 = far
    // Siblings under one parent fragment move by the same offset where the parent's chain only
    // translates them: one walk up for the first, the offset for the rest.
    let mut lastParent = NO_INDEX
    let mut dx: f32 = 0.0
    let mut dy: f32 = 0.0
    let mut at: usize = 0
    while at < automatic.length() {
      let css = u32.toUsize(automatic.get(at))
      at = at + 1
      if css >= self.fragmentOf.length() { continue }
      let index = self.fragmentOf.get(css)
      if index == NO_INDEX { continue }
      let fragment = self.output.fragments.values.asSlice()[index]
      let box = borderBox(&fragment)
      let slot = self.slotOfCssNode(css)
      let plain = slot != NONE && !self.node(slot).computed().transform.any()
        && self.node(slot).computed().layout.position == Position.Static
      let mut seen = box
      if plain && fragment.parent != NO_INDEX && fragment.parent == lastParent {
        seen = Rect<f32>.new(box.xMin + dx, box.yMin + dy, box.xMax + dx, box.yMax + dy)
      } else {
        seen = self.visualRect(index, box)
        let translated = f32.abs(seen.width() - box.width()) < 0.01 && f32.abs(seen.height() - box.height()) < 0.01
        if plain && translated {
          lastParent = fragment.parent
          dx = seen.xMin - box.xMin
          dy = seen.yMin - box.yMin
        } else {
          lastParent = NO_INDEX
        }
        // A scaled element moves farther than the scroll that moves it.
        if !translated { slack = 0.0 }
      }
      let distance: f32 = if seen.yMax < 0.0 { 0.0 - seen.yMax } else if seen.yMin > height { seen.yMin - height } else { 0.0 }
      if self.layout.skipped(css) {
        if distance <= near {
          run wakes.append(u64.bitOr(u64.shiftLeft(f32.toU64(distance), 32), usize.toU64(css)))
        } else {
          slack = f32.min(slack, distance - near)
        }
      } else if distance > far {
        if self.held(css) {
          // Held awake for this frame only: the next review skips it.
          slack = 0.0
        } else {
          run Effect.catchAll(self.layout.setSkipped(NodeId { index: css }, true, box.height()), layoutFailed)
          changed = true
        }
      } else {
        slack = f32.min(slack, far - distance)
      }
    }
    run wakes.sort()
    at = 0
    while at < wakes.length() && at < SKIP_WAKES {
      let css = u64.wrappingToUsize(u64.bitAnd(wakes.get(at), 4294967295))
      run Effect.catchAll(self.layout.setSkipped(NodeId { index: css }, false, 0.0), layoutFailed)
      changed = true
      at = at + 1
    }
    self.skipReview = if changed { [usize.MAX; 3] } else { seen }
    self.skipSlack = if changed { 0.0 } else { slack }
    self.skipTravel = 0.0
    return changed
  }

  /// Wakes every `content-visibility: auto` element above node `id` whose contents are
  /// skipped and lays out again, so that what is read of `id` next is its real geometry. They
  /// stay awake until the next frame.
  pub effect fn wakeFor(self: &mut Self, id: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let slot = self.slotOf(id)
    if slot == NONE { return () }
    let mut woke = false
    let mut at = self.node(slot).parent
    while at != NONE {
      let css = self.node(at).css
      if css < self.layout.nodeCount() && self.layout.automatic(css) {
        run self.heldAwake.append(usize.toU32(css))
        if self.layout.skipped(css) {
          run Effect.catch<TreeError>(self.wake(css), noShape)
          woke = true
        }
      }
      at = self.node(at).parent
    }
    if woke { run Effect.catch<TreeError>(self.layoutFrame(), noShape) }
  }

  fn held(self: &Self, css: usize) -> bool {
    let mut at: usize = 0
    while at < self.heldAwake.length() {
      if u32.toUsize(self.heldAwake.get(at)) == css { return true }
      at = at + 1
    }
    return false
  }

  effect fn wake(self: &mut Self, css: usize) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    run Effect.catchAll(self.layout.setSkipped(NodeId { index: css }, false, 0.0), layoutFailed)
  }

  /// Wakes every `content-visibility: auto` element whose contents are skipped, for a check
  /// of the whole logical result, and holds them awake until the next frame.
  pub effect fn wakeAll(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut automatic = List<u32>.make()
    run self.layout.automaticElements(&mut automatic)
    let mut at: usize = 0
    while at < automatic.length() {
      let css = u32.toUsize(automatic.get(at))
      run self.heldAwake.append(usize.toU32(css))
      if self.layout.skipped(css) { run Effect.catch<TreeError>(self.wake(css), noShape) }
      at = at + 1
    }
    run Effect.catch<TreeError>(self.layoutFrame(), noShape)
  }

  effect fn settleAnchors(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut pass: usize = 0
    while pass <= self.anchors.length() + 3 {
      // A box placed against an anchor can move or size the next one: a few passes.
      if !(run css_anchor.settle(&mut self)) {
        break
      }
      run self.resolveStyles()
      run self.layoutFrame()
      if run interact.settleScrolls(&mut self) {
        run self.layoutFrame()
      }
      run self.followHover()
      run self.resolveStyles()
      run self.layoutFrame()
      pass = pass + 1
    }
  }

  effect fn settleVirtual(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut pass: usize = 0
    while pass < 4 {
      if !(run virtual.settle(&mut self)) {
        break
      }
      run virtual.prepare(&mut self)
      run self.layoutFrame()
      if run interact.settleScrolls(&mut self) {
        run self.layoutFrame()
      }
      run self.followHover()
      run self.resolveStyles()
      run self.layoutFrame()
      pass = pass + 1
    }
  }

  /// Lays out and paints pages or columns supplied by the host. Break policies, widows,
  /// orphans and fixed page-positioned elements use the same styles as continuous frames.
  /// Geometry queries describe this output until the next frame; `frame` resumes continuous
  /// layout. Fragmentainer slices are borrowed only for this call.
  /// Virtual scroll containers require continuous layout; clear them first or this returns `TreeError.Layout`.
  pub effect fn frameFragmented(
    self: &mut Self,
    input: FrameInput,
    frames: Fragmentainers<'_>,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.virtualLists.length() != 0 {
      fail TreeError.Layout
    }
    self.frameNumber = self.frameNumber + 1
    self.applied = false
    self.input = input
    self.stats = FrameStats.zero()
    self.stats.frame = self.frameNumber
    style_change.begin(&mut self)
    run self.resolveStyles()
    let mut viewport = CssStyle.make()
    let root = self.layout.root()
    run Effect.catchAll(self.layout.setStyle(root, move viewport), layoutFailed)
    let mut pass: usize = 0
    let mut budget = container_watch.depth(&self)
    while true {
      run Effect.catchAll(
        computeFragmented(
          &LayoutView { table: &self.layout, nodes: self.nodes.asSlice(), slots: self.slotOfCss.asSlice() },
          &mut self.output,
          &mut self.provider,
          OptionalSize.none(),
          Fragmentainers { rects: frames.rects, contexts: frames.contexts, ancestors: frames.ancestors,
            repeatStep: frames.repeatStep, kind: frames.kind, writingMode: frames.writingMode,
            direction: frames.direction, firstPageRight: frames.firstPageRight, rectoOnRight: frames.rectoOnRight },
        ),
        layoutFailed,
      )
      self.output.fragments.resolveLocations()
      self.paintCachesStale = true
      self.semanticRevision = self.semanticRevision + 1
      self.revision = self.revision + 1
      self.laidOutRevision = usize.MAX
      self.stats.layout = self.output.stats
      self.stats.layoutSkipped = false
      run self.indexFragments()
      let depth = container_watch.depth(&self)
      if depth > budget { budget = depth }
      if pass >= budget || !(run self.refineContainers()) { break }
      pass = pass + 1
    }
    run self.finishStyleChange()
    self.layoutObserversDirty = true
    run self.notifyLayout()
    edit.beginPaint(&mut self)
    self.scrollsStill = false
    run self.paintFrame()
    run self.placeSceneScrolls()
    self.paintDirty = false
    self.stats.nodes = self.nodeCount()
    self.stats.fragments = self.output.fragments.values.length()
  }

  /// The atlas tile for a registered image, for custom scene composition. Allocation and
  /// re-upload after eviction are managed by the resource store and collected by `frame`.
  pub effect fn imageTile(self: &mut Self, resource: u32) -> Option<AtlasTile>
    ! OutOfMemoryError
    ? &mut Allocator {
    return match self.resources.get(resource) {
      Option<Resource>.Some { value: Resource.Image { image, .. } } => run self.resources.imageTile(
        &mut self.atlas,
        image,
      )
      _ => Option<AtlasTile>.None
    }
  }

  /// Whether a mutation or an edit changed styles or layout inputs since the last layout.
  pub fn layoutPending(self: &Self) -> bool {
    return self.stylesDirty || self.stylesPending || self.layout.revision() != self.laidOutRevision
  }

  /// Whether hover is held while content that scrolled under the pointer settles.
  pub fn hoverHeld(self: &Self) -> bool {
    return self.hoverSettleAt >= 0.0
  }

  /// Whether a hover update held back while content scrolled is due in this frame.
  fn hoverDue(self: &Self) -> bool {
    return self.hoverSettleAt >= 0.0 && self.input.time >= self.hoverSettleAt
  }

  /// Hit tests the pointer again after layout or scrolling moved content under it. While content
  /// scrolls under a still pointer, hover waits until no scroll has moved it for
  /// `HOVER_SETTLE_SECONDS`, as browsers hold hover during a scroll: each scrolled frame would
  /// otherwise restyle the rows that slide under the pointer, run their pointer enter and leave
  /// handlers (a row's tooltip opening and closing), and with them the layout reads those
  /// handlers make.
  effect fn followHover(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.pointerInside {
      self.hoverSettleAt = -1.0
      return ()
    }
    if self.scrolled {
      self.hoverSettleAt = self.input.time + HOVER_SETTLE_SECONDS
      return ()
    }
    if self.hoverSettleAt >= 0.0 && !self.hoverDue() { return () }
    self.hoverSettleAt = -1.0
    run interact.refreshHover(&mut self)
  }

  /// Resolves styles now without laying out, for reads of computed values. A container query
  /// makes styles depend on layout, so with one this lays out too.
  pub effect fn stylesNow(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.containerWatches.length() != 0 {
      if self.layoutPending() { run self.layoutNow() }
      return ()
    }
    if !self.stylesDirty && !self.stylesPending && self.cssWidth() == self.unitsWidth && self.cssHeight() == self.unitsHeight { return () }
    style_change.begin(&mut self)
    run self.resolveStyles()
    run self.finishStyleChange()
  }

  /// Resolves styles and lays out now, at the last frame's size, so geometry queries between
  /// frames see the current text. The next frame paints as usual.
  pub effect fn layoutNow(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    style_change.begin(&mut self)
    run self.resolveStyles()
    if self.laidOutCurrent()
      && self.layout.revision() == self.laidOutRevision
      && self.layout.scrollRevision() == self.laidOutScrolls
      && self.input.width == self.laidOut.width
      && self.input.height == self.laidOut.height
      && self.virtualLists.length() == 0 {
      run self.finishStyleChange()
      return ()
    }
    if self.laidOutNodes() {
      run scroll_anchor.select(&mut self)
    }
    run virtual.prepare(&mut self)
    run self.layoutFrame()
    if run interact.settleScrolls(&mut self) {
      run self.layoutFrame()
    }
    run self.settleVirtual()
    run self.settleSkipped()
    run self.settleAnchors()
    run offset_path.settle(&mut self)
    run self.finishStyleChange()
    if self.laidOutCurrent() {
      run scroll_anchor.select(&mut self)
    }
  }

  effect fn refineContainers(self: &mut Self) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    let changed = run Effect.result(container_watch.changed(&self))
    let slots = match move changed {
      Result.Success { value } => move value
      Result.Failure { error: why } => match move why {
        OutOfMemoryError allocation => { fail move allocation }
        CssError invalid => { drop invalid fail TreeError.StyleSheet { index: 0, root: self.current, sheet: 0 } }
      }
    }
    let mut i: usize = 0
    while i < slots.length() { self.restyleLocal(slots.get(i)) i = i + 1 }
    if slots.length() == 0 { return false }
    run self.resolveStyles()
    return true
  }

  effect fn layoutFrame(self: &mut Self) ! TreeError | OutOfMemoryError ? &mut Allocator {
    if !(run self.layoutPass()) || self.containerWatches.length() == 0 { return () }
    let mut pass: usize = 0
    let mut budget = container_watch.depth(&self)
    while pass < budget && (run self.refineContainers()) {
      if !(run self.layoutPass()) { break }
      pass = pass + 1
      let depth = container_watch.depth(&self)
      if depth > budget { budget = depth }
    }
  }

  effect fn finishStyleChange(self: &mut Self) ! TreeError | OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    while i < self.styleChanges.length() {
      let entry = &self.styleChanges.asSlice()[i]
      let slot = entry.slot
      if self.node(slot).live && self.node(slot).id == entry.id && self.node(slot).generatedSuppressed {
        let origin = self.node(slot).parent
        let target = self.node(slot).pseudoElement()
        let parent = self.nodeMut(origin)
        let identity = run parent.identityMut()
        if target == "::before" { identity.before = NONE } else { identity.after = NONE }
        run self.destroy(0, slot)
      }
      i = i + 1
    }
    run style_change.finish(&mut self)
  }

  effect fn layoutPass(self: &mut Self) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.layout.revision() == self.laidOutRevision
      && self.layout.scrollRevision() == self.laidOutScrolls
      && self.input.width == self.laidOut.width
      && self.input.height == self.laidOut.height {
      return false
    }

    // css-layout has one viewport, sized by whichever root was laid out last.
    if self.input.width != self.styledViewport.width
      || self.input.height != self.styledViewport.height {
      let mut viewport = CssStyle.make()
      viewport.width = SizeValue.px(self.input.width)
      viewport.height = SizeValue.px(self.input.height)
      let viewportId = self.layout.root()
      run Effect.catchAll(self.layout.setStyle(viewportId, move viewport), layoutFailed)
      self.styledViewport = self.input
    }
    let viewport = OptionalSize.definite(self.input.width, self.input.height)
    let moved = self.layout.revision() == self.laidOutRevision
      && self.input.width == self.laidOut.width
      && self.input.height == self.laidOut.height
      && (run Engine.repositionScroll(&LayoutView { table: &self.layout, nodes: self.nodes.asSlice(), slots: self.slotOfCss.asSlice() }, &mut self.output, viewport))
    if !moved {
      run Effect.catchAll(
        Engine.compute(
          &LayoutView { table: &self.layout, nodes: self.nodes.asSlice(), slots: self.slotOfCss.asSlice() },
          &mut self.output,
          &mut self.provider,
          OptionalSize.definite(self.input.width, self.input.height),
        ),
        layoutFailed,
      )
    }
    self.output.fragments.resolveLocations()
    self.semanticRevision = self.semanticRevision + 1
    self.revision = self.revision + 1
    // A viewport of another size moves what sticks to it.
    if self.input.width != self.laidOut.width || self.input.height != self.laidOut.height {
      self.paintCachesStale = true
    }
    self.laidOut = self.input
    self.laidOutRevision = self.layout.revision()
    self.laidOutScrolls = self.layout.scrollRevision()
    self.stats.layout = self.output.stats
    self.stats.layoutSkipped = false
    self.work.layoutFrames = self.work.layoutFrames + 1
    self.work.fragmentsResolved = self.work.fragmentsResolved + self.output.fragments.resolved
    if moved { self.work.layoutMoves = self.work.layoutMoves + 1 } else {
      self.work.layoutPasses = self.work.layoutPasses + self.output.stats.passes
      self.work.layoutFull = self.work.layoutFull + self.output.stats.fullLayouts
      self.work.layoutProbes = self.work.layoutProbes + self.output.stats.sizeProbes
      self.work.layoutCacheHits = self.work.layoutCacheHits + self.output.stats.cacheHits
      self.work.layoutReused = self.work.layoutReused + self.output.stats.reusedLayouts
      self.work.inlineLayouts = self.work.inlineLayouts + self.output.stats.inlineLayouts
      self.work.plainLines = self.work.plainLines + self.output.stats.plainLines
      self.work.linesEmitted = self.work.linesEmitted + self.output.stats.linesEmitted
    }
    if moved {
      // Only visual offsets changed: every fragment may have moved, none was renumbered.
      self.paintCachesStale = true
    } else {
      run self.carryFragments()
      if self.scrollAnchors.length() != 0 { run scroll_anchor.adjust(&mut self) }
    }
    self.layoutObserversDirty = true
    return !moved
  }

  /// Reports changed geometry once after layout, including scrolling and first attachment.
  effect fn notifyLayout(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.layoutObserversDirty {
      return ()
    }
    self.layoutObserversDirty = false
    // The nodes that listen, in slot order, without those that stopped or are gone.
    let mut listening = Intrinsic.replace(self.layoutListeners, List<u32>.make())
    run listening.sort()
    let mut kept: usize = 0
    let mut at: usize = 0
    while at < listening.length() {
      let slot = listening.get(at)
      at = at + 1
      if kept != 0 && listening.get(kept - 1) == slot { continue }
      if u32.toUsize(slot) >= self.nodes.length() { continue }
      let listener = self.node(slot)
      if !listener.live || u32.bitAnd(listener.listeners, LISTEN_LAYOUT) == 0 { continue }
      listening.set(kept, slot)
      kept = kept + 1
    }
    listening.truncate(kept)
    let mut l: usize = 0
    while l < listening.length() {
      let i = u32.toUsize(listening.get(l))
      l = l + 1
      let node = &self.nodes.asSlice()[i]
      if node.live && u32.bitAnd(node.listeners, LISTEN_LAYOUT) != 0
        && !self.inParkedRoot(usize.toU32(i)) {
        let id = node.id
        let before = match node.rare.get() { Option.Some { value: rare } => rare.reportedBounds _ => Rect<f32>.new(0.0, 0.0, 0.0, 0.0) }
        let reported = match node.rare.get() { Option.Some { value: rare } => rare.layoutReported _ => false }
        if let Option<inspect.NodeInfo>.Some { value } = run inspect.info(&self.*, id) {
          let bounds = value.bounds
          if !reported || before.xMin != bounds.xMin || before.yMin != bounds.yMin
            || before.xMax != bounds.xMax
            || before.yMax != bounds.yMax {
            let slot = usize.toU32(i)
            let target = self.nodeMut(slot)
            let rare = run target.rareMut()
            rare.layoutReported = true
            rare.reportedBounds = bounds
            let mut path = List<u32>.make()
            run self.pathTo(slot, &mut path)
            let mut event = Event.make(EventKind.Layout, id, move path)
            event.bounds = bounds
            run self.queueEvent(move event)
          }
        }
      }
    }
    self.layoutListeners = move listening
  }

  /// Fills `fragmentOf` from the last layout.
  effect fn indexFragments(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.facesDirty = true
    run buildIndex(
      &self.output,
      self.layout.nodeCount(),
      &mut self.fragmentOf,
      &mut self.nextSourceFragment,
      &mut self.repair.index,
    )
  }

  /// After a layout pass: brings what the tree keeps per fragment to the fragments css-layout
  /// kept (`FragmentArena.carried`), and notes the others for the next refresh of the paint
  /// caches. The index by source is repaired at once: geometry queries read it before paint.
  effect fn carryFragments(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.output.fragments.values.length()
    let old = self.nextSourceFragment.length()
    let mut plan = Intrinsic.replace(self.repair.plan, CarryPlan.make())
    let mut dirty = Intrinsic.replace(self.repair.dirty, List<usize>.make())
    dirty.clear()
    let mut why: u8 = 1
    let mut carried = self.output.fragments.carriedKnown
    if carried {
      why = 2
      carried = run plan.set(self.output.fragments.carried.asSlice(), old, count)
    }
    if carried {
      run plan.uncovered(&mut dirty)
      // When much changed, working everything out again costs less than repairing it.
      why = 4
      carried = dirty.length() <= count / 4 + 64
    }
    if carried {
      why = 3
      carried = run repairIndex(
        &plan,
        &self.output,
        self.layout.nodeCount(),
        &mut self.fragmentOf,
        &mut self.nextSourceFragment,
        &mut self.repair.index,
        dirty.asSlice(),
      )
    }
    if !carried {
      run self.indexFragments()
      if !self.paintCachesStale {
        self.repair.uncarried = self.repair.uncarried + 1
        self.repair.uncarriedWhy = why
      }
      self.paintCachesStale = true
    } else {
      // A text fragment of a font not seen before loads its face.
      let values = self.output.fragments.values.asSlice()
      let mut d: usize = 0
      while d < dirty.length() && !self.facesDirty {
        if values[dirty.get(d)].textData != NO_INDEX {
          let key = u32.toUsize(values[dirty.get(d)].fontKey)
          if key >= self.faces.length() || !self.faces.asSlice()[key].loaded { self.facesDirty = true }
        }
        d = d + 1
      }
    }
    if !self.paintCachesStale {
      if self.fragmentHashes.length() != old || self.fragmentInk.length() != old
        || self.fragmentScrollers.length() != old || !self.fragmentStacking.carries(old) {
        self.paintCachesStale = true
      } else {
        let empty = Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
        run carryList<u64>(&plan, &mut self.fragmentHashes, &mut self.repair.spareHashes, 0)
        run carryList<Rect<f32>>(&plan, &mut self.fragmentInk, &mut self.repair.spareInk, empty)
        run carryList<bool>(&plan, &mut self.fragmentScrollers, &mut self.repair.spareFlags, false)
        run self.fragmentStacking.carry(&plan)
        // What was pending from an earlier pass moves too, or is gone.
        if !plan.identity {
          let pending = self.repair.fragments.asMutSlice()
          let mut kept: usize = 0
          let mut i: usize = 0
          while i < pending.length {
            let to = plan.newIndex(pending[i])
            if to != NO_INDEX {
              pending[kept] = to
              kept = kept + 1
            }
            i = i + 1
          }
          self.repair.fragments.truncate(kept)
          let tracked = self.repair.fragiles.asMutSlice()
          kept = 0
          i = 0
          while i < tracked.length {
            let to = plan.newIndex(tracked[i].fragment)
            if to != NO_INDEX {
              tracked[kept] = FragileEntry { fragment: to, kind: tracked[i].kind }
              kept = kept + 1
            }
            i = i + 1
          }
          self.repair.fragiles.truncate(kept)
        } else {
          let pending = self.repair.fragments.asMutSlice()
          let mut kept: usize = 0
          let mut i: usize = 0
          while i < pending.length {
            if pending[i] < count {
              pending[kept] = pending[i]
              kept = kept + 1
            }
            i = i + 1
          }
          self.repair.fragments.truncate(kept)
          let tracked = self.repair.fragiles.asMutSlice()
          kept = 0
          i = 0
          while i < tracked.length {
            if tracked[i].fragment < count {
              tracked[kept] = tracked[i]
              kept = kept + 1
            }
            i = i + 1
          }
          self.repair.fragiles.truncate(kept)
        }
        run self.repair.fragments.appendSlice(dirty.asSlice())
        self.repair.pending = true
      }
    }
    if self.paintCachesStale { self.repair.settle() }
    self.repair.plan = move plan
    self.repair.dirty = move dirty
    if self.lineOrigins.length() != 0 { run self.indexFirstLines() }
  }

  /// Loads the raster face of every font key the layout's text fragments use.
  effect fn loadFaces(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.facesDirty {
      return ()
    }
    // Every text fragment's font.
    let values = self.output.fragments.values.asSlice()
    let count = values.length
    let mut i: usize = 0
    while i < count {
      if values[i].textData == NO_INDEX {
        i = i + 1
        continue
      }
      let key = u32.toUsize(values[i].fontKey)
      while self.faces.length() <= key {
        run self.faces.append(FaceSlot<'a> { loaded: false, face: Thin<FontFace<'a>>.none() })
      }
      if !self.faces.asSlice()[key].loaded {
        let face = match move run self.provider.text.rasterFace(key) {
          Option<FontFace<'a>>.Some { value } => run Thin<FontFace<'a>>.make(move value)
          Option<FontFace<'a>>.None => Thin<FontFace<'a>>.none()
        }
        let slots = self.faces.asMutSlice()
        slots[key] = FaceSlot<'a> { loaded: true, face: move face }
      }
      i = i + 1
    }
    self.facesDirty = false
  }

  /// Hashes and bounds every fragment again when layout, styles or mutations changed since they
  /// were last computed. A frame that only scrolled keeps them.
  effect fn refreshPaintCaches(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.output.fragments.values.length()
    let sized = self.fragmentHashes.length() == count && self.fragmentInk.length() == count
      && self.fragmentScrollers.length() == count
    if !self.paintCachesStale && !self.repair.pending && sized && self.fragmentStacking.covers(count) {
      return ()
    }
    let _span = Prof.span("ui_tree.refreshPaintCaches")
    // Only what changed, when that is known and no fragment's caches read another's.
    let mut repaired = !self.paintCachesStale && sized && self.fragmentStacking.carries(count)
      && self.nextSourceFragment.length() == count
    if repaired && self.repair.fragile {
      self.repair.fragileRebuilds = self.repair.fragileRebuilds + 1
      repaired = false
    }
    if repaired {
      repaired = run self.repairPaintCaches()
    }
    Prof.set("repaired", &repaired)
    Prof.set("fragments", &count)
    if repaired {
      self.repair.repairs = self.repair.repairs + 1
    } else {
      self.repair.rebuilds = self.repair.rebuilds + 1
      self.repair.fragile = run cacheFragments(
        &self.seed, &self.output, &self.slotOfCss, &self.layout, &self.nodes,
        self.input.width, self.input.height,
        &mut self.fragmentHashes, &mut self.fragmentInk, &mut self.fragmentScrollers,
        &mut self.repair.fragiles,
      )
      run self.fragmentStacking.update(&self.output, &self.slotOfCss, &self.layout, &self.nodes)
      run foldLiftedRoots(
        &self.fragmentStacking,
        &mut self.fragmentHashes,
        &mut self.fragmentInk,
        &mut self.fragmentScrollers,
      )
      self.repair.lifted = self.fragmentStacking.lifted.length() != 0
    }
    self.repair.settle()
    self.paintCachesStale = false
    if repaired && self.repair.verify { run self.verifyPaintCaches() }
  }

  /// Works out again the caches of the fragments noted in `repair`, of the fragments of its
  /// nodes, and of every fragment above those. False when it cannot: the caller rebuilds.
  effect fn repairPaintCaches(self: &mut Self) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let values = self.output.fragments.values.asSlice()
    let count = values.length
    let mut dirty = Intrinsic.replace(self.repair.fragments, List<usize>.make())
    let mut stack = Intrinsic.replace(self.repair.stack, List<usize>.make())
    let mut marks = Intrinsic.replace(self.repair.marks, List<bool>.make())
    if marks.length() < count {
      let have = marks.length()
      run marks.appendRepeated(false, count - have)
    }
    // Each fragment once.
    let mut kept: usize = 0
    let mut d: usize = 0
    while d < dirty.length() {
      let index = dirty.get(d)
      if index < count && !marks.get(index) {
        marks.set(index, true)
        dirty.set(kept, index)
        kept = kept + 1
      }
      d = d + 1
    }
    dirty.truncate(kept)

    // The fragments a node's paint inputs reach: its own, and those of the text and the
    // boxes the tree made inside it, which paint with its style (see `styleSlot`).
    let layoutNodes = &self.layout
    let mut n: usize = 0
    while n < self.repair.nodes.length() {
      let slot = self.repair.nodes.get(n)
      n = n + 1
      if u32.toUsize(slot) >= self.nodes.length() || !self.node(slot).live { continue }
      let text = self.node(slot).kind == NodeKind.Text
      let own = self.node(slot).css
      stack.clear()
      run stack.append(own)
      while stack.length() != 0 {
        let last = stack.length() - 1
        let css = stack.get(last)
        stack.truncate(last)
        if css >= layoutNodes.nodeCount() { continue }
        let mut fragment = if css < self.fragmentOf.length() { self.fragmentOf.get(css) } else { NO_INDEX }
        while fragment != NO_INDEX && fragment < count {
          if !marks.get(fragment) {
            marks.set(fragment, true)
            run dirty.append(fragment)
          }
          fragment = self.nextSourceFragment.get(fragment)
        }
        if text { continue }
        let mut child = layoutNodes.firstChild(css)
        while child != NO_INDEX {
          let owner = self.slotOfCssNode(child)
          if owner == NONE || self.node(owner).kind == NodeKind.Text {
            run stack.append(child)
          }
          child = layoutNodes.nextSibling(child)
        }
      }
    }

    // Directly changed subtree-fragile fragments (perspective, preserve-3d) affect their
    // descendants: fall back to a full rebuild. Self-fragile fragments (sticky, offset-path,
    // positioning shells) may read an ancestor or skip SourceIndex, so recompute them too.
    let mut fIdx: usize = 0
    while fIdx < self.repair.fragiles.length() {
      let entry = self.repair.fragiles.get(fIdx)
      fIdx = fIdx + 1
      if entry.fragment >= count { continue }
      if u8.bitAnd(entry.kind, FRAGILE_SUBTREE) != 0 && marks.get(entry.fragment) {
        d = 0
        while d < dirty.length() {
          marks.set(dirty.get(d), false)
          d = d + 1
        }
        dirty.clear()
        self.repair.fragments = move dirty
        self.repair.stack = move stack
        self.repair.marks = move marks
        self.repair.fragileRebuilds = self.repair.fragileRebuilds + 1
        return false
      }
      if u8.bitAnd(entry.kind, FRAGILE_SELF) != 0 && !marks.get(entry.fragment) {
        marks.set(entry.fragment, true)
        run dirty.append(entry.fragment)
      }
    }

    // Every fragment above a changed one folds it in.
    let listed = dirty.length()
    d = 0
    while d < listed {
      let mut at = values[dirty.get(d)].parent
      while at != NO_INDEX && !marks.get(at) {
        marks.set(at, true)
        run dirty.append(at)
        at = values[at].parent
      }
      d = d + 1
    }
    d = 0
    while d < dirty.length() {
      marks.set(dirty.get(d), false)
      d = d + 1
    }
    self.repair.stack = move stack
    self.repair.marks = move marks
    run dirty.sort()

    run self.fragmentStacking.repair(
      &self.output, &self.slotOfCss, &self.layout, &self.nodes, &self.fragmentOf, dirty.asSlice(),
    )
    // A fixed box's root is folded into the roots that paint it: those start over.
    let lifts = self.repair.lifted || self.fragmentStacking.lifted.length() != 0
    if lifts {
      run dirty.appendSlice(self.fragmentStacking.roots.asSlice())
      run sortUnique(&mut dirty)
    }
    let mut ordered = true
    let mut foundFragiles = Intrinsic.replace(self.repair.spareFragiles, List<FragileEntry>.make())
    run repairFragments(
      &self.seed, &self.output, &self.slotOfCss, &self.layout, &self.nodes,
      self.input.width, self.input.height,
      &mut self.fragmentHashes, &mut self.fragmentInk, &mut self.fragmentScrollers,
      dirty.asSlice(), &mut foundFragiles, &mut ordered,
    )
    dirty.clear()
    self.repair.fragments = move dirty
    let mut needRebuild = !ordered
    let mut fi: usize = 0
    while !needRebuild && fi < foundFragiles.length() {
      let found = foundFragiles.get(fi)
      fi = fi + 1
      let mut known: usize = 0
      while known < self.repair.fragiles.length() && self.repair.fragiles.get(known).fragment != found.fragment {
        known = known + 1
      }
      if known < self.repair.fragiles.length() {
        let prev = self.repair.fragiles.get(known)
        if u8.bitAnd(found.kind, FRAGILE_SUBTREE) != 0 && u8.bitAnd(prev.kind, FRAGILE_SUBTREE) == 0 {
          needRebuild = true
        } else {
          self.repair.fragiles.set(known, FragileEntry { fragment: found.fragment, kind: u8.bitOr(prev.kind, found.kind) })
        }
      } else if u8.bitAnd(found.kind, FRAGILE_SUBTREE) != 0 {
        needRebuild = true
      } else if self.repair.fragiles.length() < MAX_TRACKED_FRAGILE {
        run self.repair.fragiles.append(found)
      } else {
        self.repair.fragile = true
        needRebuild = true
      }
    }
    foundFragiles.clear()
    self.repair.spareFragiles = move foundFragiles
    if needRebuild {
      if ordered { self.repair.fragileRebuilds = self.repair.fragileRebuilds + 1 }
      return false
    }
    if lifts {
      run foldLiftedRoots(
        &self.fragmentStacking,
        &mut self.fragmentHashes,
        &mut self.fragmentInk,
        &mut self.fragmentScrollers,
      )
    }
    self.repair.lifted = self.fragmentStacking.lifted.length() != 0
    return true
  }

  /// Compares the repaired caches and the index by source with a full rebuild, which then
  /// stands; `repair.mismatches` counts the refreshes that differed.
  effect fn verifyPaintCaches(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let hashes = Intrinsic.replace(self.fragmentHashes, List<u64>.make())
    let ink = Intrinsic.replace(self.fragmentInk, List<Rect<f32>>.make())
    let scrollers = Intrinsic.replace(self.fragmentScrollers, List<bool>.make())
    let stacking = Intrinsic.replace(self.fragmentStacking, Stacking.make())
    let firsts = Intrinsic.replace(self.fragmentOf, List<usize>.make())
    let nexts = Intrinsic.replace(self.nextSourceFragment, List<usize>.make())
    let fragile = run cacheFragments(
      &self.seed, &self.output, &self.slotOfCss, &self.layout, &self.nodes,
      self.input.width, self.input.height,
      &mut self.fragmentHashes, &mut self.fragmentInk, &mut self.fragmentScrollers,
      &mut self.repair.fragiles,
    )
    run self.fragmentStacking.update(&self.output, &self.slotOfCss, &self.layout, &self.nodes)
    run foldLiftedRoots(
      &self.fragmentStacking,
      &mut self.fragmentHashes,
      &mut self.fragmentInk,
      &mut self.fragmentScrollers,
    )
    let facesDirty = self.facesDirty
    run self.indexFragments()
    self.facesDirty = facesDirty
    let count = self.output.fragments.values.length()
    let mut same = hashes.length() == count && ink.length() == count && scrollers.length() == count
      && nexts.length() == count && firsts.length() == self.fragmentOf.length()
      && stacking.matches(&self.fragmentStacking)
    let mut i: usize = 0
    while same && i < count {
      let a = ink.get(i)
      let b = self.fragmentInk.get(i)
      same = hashes.get(i) == self.fragmentHashes.get(i) && scrollers.get(i) == self.fragmentScrollers.get(i)
        && a.xMin == b.xMin && a.yMin == b.yMin && a.xMax == b.xMax && a.yMax == b.yMax
        && nexts.get(i) == self.nextSourceFragment.get(i)
      i = i + 1
    }
    i = 0
    while same && i < firsts.length() {
      same = firsts.get(i) == self.fragmentOf.get(i)
      i = i + 1
    }
    if !same {
      self.repair.mismatches = self.repair.mismatches + 1
      if VERIFY_ALWAYS { Intrinsic.trap("ui-tree: repaired paint caches differ from a rebuild") }
    }
    self.repair.lifted = self.fragmentStacking.lifted.length() != 0
    self.repair.fragile = fragile
  }

  /// Whether the fragment ink describes the last layout, so hit testing can skip by it.
  pub fn inkCurrent(self: &Self) -> bool {
    return !self.paintCachesStale && !self.repair.pending
      && self.fragmentInk.length() == self.output.fragments.values.length()
  }

  /// Where fragment `index` of the last layout draws against where the layout put it, in CSS
  /// pixels: the scroll offsets and sticky offsets above it (see `layers`).
  pub fn shiftOf(self: &Self, index: usize) -> Vector2<f32> {
    return layers.shiftOf(
      &self.output,
      &self.slotOfCss,
      &self.layout,
      &self.nodes,
      index,
      self.input.width,
      self.input.height,
    )
  }

  /// The bounding box of where `rect` (in the layout space of fragment `index`) draws: through
  /// transforms as well as scroll and sticky offsets.
  pub fn visualRect(self: &Self, index: usize, rect: Rect<f32>) -> Rect<f32> {
    return layers.visualRect(
      &self.output,
      &self.slotOfCss,
      &self.layout,
      &self.nodes,
      index,
      rect,
      self.input.width,
      self.input.height,
    )
  }

  /// The border box of fragment `index` of the last layout, where it draws: for a text fragment,
  /// the box around its runs (empty at the origin when it has none).
  pub fn visualBounds(self: &Self, index: usize) -> Rect<f32> {
    let values = self.output.fragments.values.asSlice()
    if values[index].kind != FragmentKind.Text {
      return borderBox(&self.visualFragment(index))
    }
    let shift = self.shiftOf(index)
    let mut bounds = Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
    let mut any = false
    let mut runs = self.output.fragments.textRuns(index)
    while runs.next() {
      let x = runs.current.location.x + shift.x
      let y = runs.current.location.y + shift.y
      let box = Rect<f32>.new(x, y, x + runs.current.size.width, y + runs.current.size.height)
      bounds = if any {
        Rect<f32>.new(f32.min(bounds.xMin, box.xMin), f32.min(bounds.yMin, box.yMin), f32.max(bounds.xMax, box.xMax), f32.max(bounds.yMax, box.yMax))
      } else {
        box
      }
      any = true
    }
    return bounds
  }

  /// Whether (`x`, `y`) lies in the box of one of the runs of text fragment `index`, where
  /// they draw.
  pub fn textContains(self: &Self, index: usize, x: f32, y: f32) -> bool {
    let shift = self.shiftOf(index)
    let mut runs = self.output.fragments.textRuns(index)
    while runs.next() {
      let left = runs.current.location.x + shift.x
      let top = runs.current.location.y + shift.y
      if x >= left && x < left + runs.current.size.width && y >= top && y < top + runs.current.size.height {
        return true
      }
    }
    return false
  }

  /// Fragment `index` of the last layout, moved to where it draws.
  pub fn visualFragment(self: &Self, index: usize) -> Fragment {
    let values = self.output.fragments.values.asSlice()
    return layers.visual(&values[index], self.shiftOf(index))
  }

  effect fn paintFrame(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let _paintSpan = Prof.span("ui_tree.paint")
    run self.loadFaces()
    run self.collectIconVariables()
    run svg_styles.sync(&mut self)
    run text_selection.refresh(&mut self)
    if run motion.slides(&mut self) {
      // A node that starts or stops being a move paints through another group.
      self.paintCachesStale = true
    }
    if self.paintDirty {
      self.paintCachesStale = true
    }
    run self.refreshPaintCaches()
    run self.paths.beginFrame()
    self.paintOrder.clear()
    let window = ContentMask.new(
      Rect<f32>.new(
        0.0,
        0.0,
        self.input.width * self.input.scale,
        self.input.height * self.input.scale,
      ),
    )
    self.flipped = !self.flipped
    if self.flipped {
      self.sceneB.clear()
      let mut painter = Painter {
        nodes: &mut self.nodes,
        caches: &mut self.paintCaches,
        slotOfCss: &self.slotOfCss,
        css: &self.layout,
        output: &self.output,
        text: &self.provider.text,
        faces: &self.faces,
        fontRules: &self.fontRules,
        sheetFaces: &self.sheetFaces,
        root: self.current,
        atlas: &mut self.atlas,
        glyphs: &mut self.glyphs,
        textInk: &mut self.textInk,
        firstLines: &self.firstLines,
        resources: &mut self.resources,
        paths: &mut self.paths,
        rasters: &mut self.canvasRasters,
        scene: &mut self.sceneB,
        previous: &self.sceneA,
        replayable: self.replayable,
        scrollsStill: self.scrollsStill,
        paintedScrolls: self.paintedScrolls.asSlice(),
        hashes: &self.fragmentHashes,
        ink: &self.fragmentInk,
        scrollers: &self.fragmentScrollers,
        stacking: &self.fragmentStacking,
        cull: window.bounds,
        lead: self.input.height * self.input.scale,
        width: self.input.width,
        height: self.input.height,
        stats: &mut self.stats,
        order: &mut self.paintOrder,
        selected: &self.textSelection.selected,
        caretSlot: self.textSelection.caret.slot,
        caretOffset: self.textSelection.caret.offset,
        firstOf: &self.fragmentOf,
        frame: self.frameNumber,
        moves: &self.moves,
        previousFrame: self.paintedAt,
        scale: self.input.scale,
        time: self.input.time,
        seed: self.seed,
        only: NONE,
        inside: false,
        planes: self.preserveUsed,
      }
      let _rootsSpan = Prof.span("ui_tree.paintRoots")
      run paintRoots(&mut painter, window)
      drop _rootsSpan
      drop painter
      let _finishSpan = Prof.span("ui_tree.scene.finish")
      run self.sceneB.finish()
      drop _finishSpan
      self.stats.primitives = self.sceneB.primitiveCount()
    } else {
      self.sceneA.clear()
      let mut painter = Painter {
        nodes: &mut self.nodes,
        caches: &mut self.paintCaches,
        slotOfCss: &self.slotOfCss,
        css: &self.layout,
        output: &self.output,
        text: &self.provider.text,
        faces: &self.faces,
        fontRules: &self.fontRules,
        sheetFaces: &self.sheetFaces,
        root: self.current,
        atlas: &mut self.atlas,
        glyphs: &mut self.glyphs,
        textInk: &mut self.textInk,
        firstLines: &self.firstLines,
        resources: &mut self.resources,
        paths: &mut self.paths,
        rasters: &mut self.canvasRasters,
        scene: &mut self.sceneA,
        previous: &self.sceneB,
        replayable: self.replayable,
        scrollsStill: self.scrollsStill,
        paintedScrolls: self.paintedScrolls.asSlice(),
        hashes: &self.fragmentHashes,
        ink: &self.fragmentInk,
        scrollers: &self.fragmentScrollers,
        stacking: &self.fragmentStacking,
        cull: window.bounds,
        lead: self.input.height * self.input.scale,
        width: self.input.width,
        height: self.input.height,
        stats: &mut self.stats,
        order: &mut self.paintOrder,
        selected: &self.textSelection.selected,
        caretSlot: self.textSelection.caret.slot,
        caretOffset: self.textSelection.caret.offset,
        firstOf: &self.fragmentOf,
        frame: self.frameNumber,
        moves: &self.moves,
        previousFrame: self.paintedAt,
        scale: self.input.scale,
        time: self.input.time,
        seed: self.seed,
        only: NONE,
        inside: false,
        planes: self.preserveUsed,
      }
      let _rootsSpan = Prof.span("ui_tree.paintRoots")
      run paintRoots(&mut painter, window)
      drop _rootsSpan
      drop painter
      let _finishSpan = Prof.span("ui_tree.scene.finish")
      run self.sceneA.finish()
      drop _finishSpan
      self.stats.primitives = self.sceneA.primitiveCount()
    }
    Prof.set("primitives", &self.stats.primitives)
    Prof.set("repainted", &self.stats.repaintedSubtrees)
    Prof.set("replayed", &self.stats.replayedSubtrees)
    self.replayable = true
    self.paintedAt = self.frameNumber
    self.paintIndexOf.clear()
    run self.paintIndexOf.appendRepeated(NONE, self.nodes.length())
    let mut orderIndex: usize = 0
    while orderIndex < self.paintOrder.length() {
      let slot = self.slotOf(self.paintOrder.get(orderIndex))
      if slot != NONE && self.paintIndexOf.get(u32.toUsize(slot)) == NONE {
        self.paintIndexOf.set(u32.toUsize(slot), usize.toU32(orderIndex))
      }
      orderIndex = orderIndex + 1
    }
    let _uploadSpan = Prof.span("ui_tree.gatherUploads")
    run self.gatherUploads()
    drop _uploadSpan
  }

  /// Paints node `slot` and its subtree alone into `scene` (finished), from the last layout,
  /// without touching the paint caches. For snapshots of one node.
  pub effect fn paintSubtree(self: &mut Self, slot: u32, scene: &mut Scene) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.collectIconVariables()
    run svg_styles.sync(&mut self)
    // Between a layout pass and the refresh, stacking lists no roots to paint from.
    if self.repair.pending && !self.paintCachesStale { run self.refreshPaintCaches() }
    let window = ContentMask.new(
      Rect<f32>.new(
        0.0,
        0.0,
        self.input.width * self.input.scale,
        self.input.height * self.input.scale,
      ),
    )
    let mut stats = FrameStats.zero()
    let mut order = List<u32>.make()
    let mut painter = Painter {
      nodes: &mut self.nodes,
      caches: &mut self.paintCaches,
      slotOfCss: &self.slotOfCss,
      css: &self.layout,
      output: &self.output,
      text: &self.provider.text,
      faces: &self.faces,
      fontRules: &self.fontRules,
      sheetFaces: &self.sheetFaces,
      root: self.current,
      atlas: &mut self.atlas,
      glyphs: &mut self.glyphs,
      textInk: &mut self.textInk,
      firstLines: &self.firstLines,
      resources: &mut self.resources,
      paths: &mut self.paths,
      rasters: &mut self.canvasRasters,
      scene: &mut scene,
      previous: &self.sceneA,
      replayable: false,
      scrollsStill: false,
      paintedScrolls: &[],
      hashes: &self.fragmentHashes,
      ink: &self.fragmentInk,
      scrollers: &self.fragmentScrollers,
      stacking: &self.fragmentStacking,
      cull: window.bounds,
      lead: 0.0,
      width: self.input.width,
      height: self.input.height,
      stats: &mut stats,
      order: &mut order,
      selected: &self.textSelection.selected,
      caretSlot: self.textSelection.caret.slot,
      caretOffset: self.textSelection.caret.offset,
      firstOf: &self.fragmentOf,
      frame: self.frameNumber,
      moves: &self.moves,
      previousFrame: self.paintedAt,
      scale: self.input.scale,
      time: self.input.time,
      seed: self.seed,
      only: slot,
      inside: false,
      planes: self.preserveUsed,
    }
    run paintRoots(&mut painter, window)
    drop painter
    run scene.finish()
    run self.gatherUploads()
  }

  /// Moves the tiles the caches allocated this frame into [`UiTree.uploads`].
  effect fn gatherUploads(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let glyphs = self.glyphs.uploads()
    let mut i: usize = 0
    while i < glyphs.length {
      run self.uploads.push(
        glyphs[i].tile,
        self.glyphs.uploadBytes(),
        glyphs[i].offset,
        glyphs[i].bytesPerRow,
      )
      i = i + 1
    }
    self.glyphs.clearUploads()
    let icons = self.resources.icons.uploads()
    i = 0
    while i < icons.length {
      run self.uploads.push(
        icons[i].tile,
        self.resources.icons.uploadBytes(),
        icons[i].offset,
        icons[i].bytesPerRow,
      )
      i = i + 1
    }
    self.resources.icons.clearUploads()
    let images = self.resources.images.uploads()
    i = 0
    while i < images.length {
      run self.uploads.push(
        images[i].tile,
        self.resources.images.uploadBytes(),
        images[i].offset,
        images[i].bytesPerRow,
      )
      i = i + 1
    }
    self.resources.images.clearUploads()
  }

  /// The atlas tiles allocated since the last [`UiTree.clearUploads`], with their pixels, for
  /// the renderer to copy into its textures.
  /// Runs the Canvas 2D commands JavaScript wrote (see [`canvas2d`]).
  pub effect fn drawCanvas2d(self: &mut Self, commands: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.canvas2d.draw(&mut self.provider.text, commands)
  }

  /// Whether canvas node `node` is still at `content`, still large enough to rasterize, and has
  /// neither shown nor refused `key`.
  pub fn acceptsRaster(self: &Self, node: u32, content: u64, key: u64) -> bool {
    let slot = self.slotOf(node)
    if slot == NONE { return false }
    let item = self.node(slot)
    if item.kind != NodeKind.Canvas { return false }
    if item.content != content { return false }
    if item.canvas().length < canvas_raster.MIN_COMMANDS { return false }
    let raster = item.raster()
    return raster.key != key && raster.refused != key
  }

  /// Validates `want`, computes its bitmap bounds, and copies its commands onto the process heap
  /// into an owned [`canvas_raster.Job`] for background rasterization. Refuses empty or oversized
  /// bitmaps (`canvas_raster.MAX_SIDE`) and returns `None` when `want` is stale or refused.
  pub effect fn prepareRasterJob(self: &mut Self, want: canvas_raster.Want) -> Option<RasterJob>
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.acceptsRaster(want.node, want.content, want.key) {
      return Option<RasterJob>.None
    }
    let slot = self.slotOf(want.node)
    let ink = canvas_raster.ink(self.node(slot).canvas(), want.scale, want.fx, want.fy)
    let width = ink.xMax - ink.xMin
    let height = ink.yMax - ink.yMin
    if width <= 0.0 || height <= 0.0 || width > canvas_raster.MAX_SIDE || height > canvas_raster.MAX_SIDE {
      let extras = run self.nodeMut(slot).extrasMut()
      extras.raster.refused = want.key
      return Option<RasterJob>.None
    }
    let mut heap = Allocator.systemAllocatorProvider()
    let mut commands = List<CanvasCommand>.make()
    run commands.appendSlice(self.node(slot).canvas()) |> Effect.provideMut<Allocator>(&mut heap)
    return Option<RasterJob>.some(
      RasterJob {
        node: want.node,
        key: want.key,
        content: want.content,
        scale: want.scale,
        dx: want.fx - ink.xMin,
        dy: want.fy - ink.yMin,
        x: f32.toI32(ink.xMin),
        y: f32.toI32(ink.yMin),
        width: f32.toU32(width),
        height: f32.toU32(height),
        commands: move commands,
      },
    )
  }

  /// Draws the bitmaps paint asked for since the last call whose canvas did not change since
  /// (see [`canvas_raster`]), into `canvasRasters.frames` for the window to present. A canvas
  /// whose bitmap would be too large is refused: paint keeps drawing its commands.
  pub effect fn rasterCanvases(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let wants = Intrinsic.replace(self.canvasRasters.wants, List<canvas_raster.Want>.make())
    let all = wants.asSlice()
    if all.length == 0 {
      drop wants
      return ()
    }
    let _span = Prof.span("ui_tree.rasterCanvases")
    Prof.set("wants", &all.length)
    let mut i: usize = 0
    while i < all.length {
      let want = all[i]
      i = i + 1
      let mut seen = false
      let mut k: usize = 0
      while k + 1 < i && !seen {
        seen = all[k].node == want.node && all[k].key == want.key
        k = k + 1
      }
      if seen || !self.acceptsRaster(want.node, want.content, want.key) { continue }
      let slot = self.slotOf(want.node)
      let ink = canvas_raster.ink(self.node(slot).canvas(), want.scale, want.fx, want.fy)
      let width = ink.xMax - ink.xMin
      let height = ink.yMax - ink.yMin
      if width <= 0.0 || height <= 0.0 || width > canvas_raster.MAX_SIDE || height > canvas_raster.MAX_SIDE {
        let extras = run self.nodeMut(slot).extrasMut()
        extras.raster.refused = want.key
        continue
      }
      let pixels = run self.canvas2d.drawCommands(
        self.nodes.asSlice()[u32.toUsize(slot)].canvas(),
        want.scale,
        want.fx - ink.xMin,
        want.fy - ink.yMin,
        f32.toU32(width),
        f32.toU32(height),
      )
      run self.canvasRasters.frames.append(
        RasterFrame {
          node: want.node,
          key: want.key,
          content: want.content,
          x: f32.toI32(ink.xMin),
          y: f32.toI32(ink.yMin),
          pixels: move pixels,
        },
      )
    }
    drop wants
  }

  /// The window shows the bitmap of canvas node `node` drawn for `key` through `surface`, at
  /// `x`, `y` (see [`RasterFrame`]): paint shows it from the next frame on.
  pub effect fn showRaster(self: &mut Self, node: u32, surface: u32, key: u64, x: i32, y: i32, width: u32, height: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let slot = self.slotOf(node)
    if slot == NONE { return () }
    let extras = run self.nodeMut(slot).extrasMut()
    extras.raster.surface = surface
    extras.raster.key = key
    extras.raster.x = x
    extras.raster.y = y
    extras.raster.width = width
    extras.raster.height = height
    extras.raster.stamp = u32.wrappingAdd(extras.raster.stamp, 1)
    if self.canvasRasters.surfaceOf(node, NO_SURFACE) == NO_SURFACE {
      run self.canvasRasters.live.append(RasterLive { node: node, surface: surface })
    }
    // Paint replays the canvas's subtree until its hash changes.
    run self.repair.nodes.append(slot)
    self.repair.pending = true
    self.applied = true
  }

  /// `measureText` of `value` in `font`, as [`canvas2d.Canvas2d.measure`] gives it.
  pub effect fn measureCanvasText(self: &mut Self, font: &[u8], value: &[u8]) -> TextMeasured ! OutOfMemoryError ? &mut Allocator {
    return run self.canvas2d.measure(&mut self.provider.text, font, value)
  }

  pub fn pendingUploads(self: &Self) -> &Pending {
    return &self.uploads
  }

  pub fn clearUploads(self: &mut Self) -> () {
    self.uploads.clear()
  }

  /// Forces the next frame of every root to paint everything again.
  pub fn invalidatePaint(self: &mut Self) -> () {
    self.replayable = false
    let parked = self.parked.asMutSlice()
    let mut i: usize = 0
    while i < parked.length {
      parked[i].replayable = false
      i = i + 1
    }
  }
}

effect fn ignoreInvalid(error: InvalidNode) -> () {
  drop error
}

// The free slots of the node table are a binary heap with the lowest slot first: a new node
// takes the lowest free slot, so the nodes that stay after many are destroyed sit at the start
// of the table and its end can be given back (see `UiTree.trimNodes`).

/// Moves the free slot at `at` up to its place in the heap.
fn siftUp(free: &mut List<u32>, at: usize) -> () {
  let slots = free.asMutSlice()
  let mut i = at
  while i > 0 {
    let parent = (i - 1) / 2
    if slots[parent] <= slots[i] {
      return
    }
    let moved = slots[parent]
    slots[parent] = slots[i]
    slots[i] = moved
    i = parent
  }
}

/// Moves the free slot at `at` down to its place in the heap.
fn siftDown(free: &mut List<u32>, at: usize) -> () {
  let slots = free.asMutSlice()
  let mut i = at
  while true {
    let left = i * 2 + 1
    if left >= slots.length {
      return
    }
    let right = left + 1
    let least = if right < slots.length && slots[right] < slots[left] { right } else { left }
    if slots[i] <= slots[least] {
      return
    }
    let moved = slots[i]
    slots[i] = slots[least]
    slots[least] = moved
    i = least
  }
}

/// Takes the lowest free slot. `free` is not empty.
fn takeLowest(free: &mut List<u32>) -> u32 {
  let last = free.length() - 1
  let lowest = free.get(0)
  let moved = free.get(last)
  free.set(0, moved)
  free.truncate(last)
  if last > 0 {
    siftDown(&mut free.*, 0)
  }
  return lowest
}

/// A tree gives back what a larger one left only after it has held this many nodes
/// (see `UiTree.releaseSlack`).
/// `content-visibility: auto`: skipped elements within this many viewports of the viewport
/// wake, awake ones beyond SKIP_FAR are skipped, at most SKIP_WAKES a pass and SKIP_PASSES
/// passes a frame.
const SKIP_NEAR: f32 = 2.0
const SKIP_FAR: f32 = 3.0
const SKIP_WAKES: usize = 8
const SKIP_PASSES: usize = 8
const RELEASE_NODES: usize = 4096

/// The node table is not trimmed below this many slots (see `UiTree.trimNodes`).
const TRIM_NODES: usize = 1024

/// `keep` slots of the node table, or as many as keep `slot` in it.
fn keepSlot(keep: usize, slot: u32) -> usize {
  if slot == NONE || u32.toUsize(slot) < keep {
    return keep
  }
  return u32.toUsize(slot) + 1
}

fn contains(list: &List<u32>, value: u32) -> bool {
  let values = list.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i] == value {
      return true
    }
    i = i + 1
  }
  return false
}

fn sameNatural(a: NaturalDimensions, b: NaturalDimensions) -> bool {
  return a.aspectRatio == b.aspectRatio && a.size.width == b.size.width
    && a.size.height == b.size.height
}

effect fn defineImage(
  resources: &mut Resources<'_>,
  atlas: &mut Atlas,
  resource: u32,
  data: &[u8],
) -> bool
  ! ResourceError | OutOfMemoryError
  ? &mut Allocator {
  run resources.defineImage(&mut atlas, resource, data)
  return true
}

effect fn defineIcon(
  resources: &mut Resources<'_>,
  atlas: &mut Atlas,
  resource: u32,
  data: &[u8],
) -> bool
  ! ResourceError | OutOfMemoryError
  ? &mut Allocator {
  run resources.defineIcon(&mut atlas, resource, data)
  return true
}

effect fn resourceFailed(error: ResourceError) -> bool {
  drop error
  return false
}

/// Whether two computed text styles are the same, so the children that inherit them need no
/// restyle.
fn sameScope(left: Option<ScopeId>, right: Option<ScopeId>) -> bool {
  return match left {
    Option<ScopeId>.Some { value: a } => match right { Option<ScopeId>.Some { value: b } => a.index == b.index _ => false }
    _ => right.isNone()
  }
}

/// The node's sheet style takes some property from its parent with `inherit` or `unset`.
fn explicitInherit(node: &Node) -> bool {
  if let Option.Some { value } = node.sheetStyle() {
    let declarations = value.declarations.asSlice()
    let mut i: usize = 0
    while i < declarations.length {
      if properties_convert.isKeyword(&declarations[i].value, Keyword.Inherit)
        || properties_convert.isKeyword(&declarations[i].value, Keyword.Unset) { return true }
      i = i + 1
    }
  }
  return false
}

fn sameText(left: &TextStyle, right: &TextStyle) -> bool {
  return left.writingMode == right.writingMode && left.textOrientation == right.textOrientation
    && &left.textBoxEdge == &right.textBoxEdge
    && &left.emphasis == &right.emphasis
    && left.textAlignLast == right.textAlignLast
    && left.textWrap == right.textWrap
    && left.whiteSpaceCollapse == right.whiteSpaceCollapse
    && left.textJustify == right.textJustify
    && &left.textIndent == &right.textIndent
    && &left.tabSize == &right.tabSize
    && left.orphans == right.orphans
    && left.widows == right.widows
    && left.visibility == right.visibility
    && left.family == right.family
    && left.size == right.size
    && left.weight == right.weight
    && left.style == right.style
    && &left.lineHeight == &right.lineHeight
    && &left.color == &right.color
    && left.align == right.align
    && left.whiteSpace == right.whiteSpace
    && left.direction == right.direction
    && left.decoration.underline == right.decoration.underline
    && left.decoration.overline == right.decoration.overline
    && left.decoration.lineThrough == right.decoration.lineThrough
    && &left.decorationColor == &right.decorationColor
    && left.hasDecorationColor == right.hasDecorationColor
    && left.wavy == right.wavy
    && left.visible == right.visible
    && &left.caretColor == &right.caretColor
    && left.hasCaretColor == right.hasCaretColor
    && &left.selectionColor == &right.selectionColor
    && &left.placeholderColor == &right.placeholderColor
    && left.hasPlaceholderColor == right.hasPlaceholderColor
    && left.fillColor == right.fillColor
    && left.textWrapStyle == right.textWrapStyle
    && left.width == right.width
    && left.features.same(&right.features)
}

// `font-variation-settings` written as CSS text rather than as a VariationTable id.
fn writtenVariations(declaration: &Declaration) -> bool {
  return declaration.property == CssProperty.FontVariationSettings && convert.number(&declaration.value).isNone()
    && !properties_convert.isKeyword(&declaration.value, Keyword.Initial)
    && !properties_convert.isKeyword(&declaration.value, Keyword.Inherit)
    && !properties_convert.isKeyword(&declaration.value, Keyword.Unset)
    && !properties_convert.isKeyword(&declaration.value, Keyword.Revert)
    && !properties_convert.isKeyword(&declaration.value, Keyword.RevertLayer)
}

// A `font-palette`, `font-variant-alternates` or `font-size-adjust` not yet a handle.
fn writtenHandle(declaration: &Declaration) -> bool {
  if font_features.extrasShift(declaration.property) == 0xFFFFFFFF { return false }
  if let Option.Some { value } = convert.number(&declaration.value) {
    if value < 0.0 { return false }
  }
  return !properties_convert.isKeyword(&declaration.value, Keyword.Initial)
    && !properties_convert.isKeyword(&declaration.value, Keyword.Inherit)
    && !properties_convert.isKeyword(&declaration.value, Keyword.Unset)
    && !properties_convert.isKeyword(&declaration.value, Keyword.Revert)
    && !properties_convert.isKeyword(&declaration.value, Keyword.RevertLayer)
}

// A `font-family` written as CSS text rather than as a family list id.
fn writtenFamily(declaration: &Declaration) -> bool {
  return declaration.property == CssProperty.FontFamily && convert.number(&declaration.value).isNone()
    && !properties_convert.isKeyword(&declaration.value, Keyword.Initial)
    && !properties_convert.isKeyword(&declaration.value, Keyword.Inherit)
    && !properties_convert.isKeyword(&declaration.value, Keyword.Unset)
    && !properties_convert.isKeyword(&declaration.value, Keyword.Revert)
    && !properties_convert.isKeyword(&declaration.value, Keyword.RevertLayer)
}

/// The width of the default focus ring, as Chromium draws `outline: auto`.
const FOCUS_RING_WIDTH: f32 = 2.0
const MIN_PAGE_ZOOM: f32 = 0.25
const MAX_PAGE_ZOOM: f32 = 5.0

/// A focus trap and the node focus returns to when the trap is removed (see `returnSlot`).
struct FocusReturn {
  trap: u32,
  to: u32,
}

impl Copy for FocusReturn {}

/// Loom and any other protocol client drive the tree through this.
impl<'a> Backend for UiTree<'a> {
  effect fn mutate(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.apply(move batch)
  }

  effect fn events(self: &mut Self, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.takeEvents(&mut out)
  }

  effect fn rootEvents(self: &mut Self, out: &mut List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.takeRootEvents(&mut out)
  }

  fn viewport(self: &Self, root: u32) -> Rect<f32> {
    return self.rootViewport(root)
  }

  fn roots(self: &Self) -> RootSupport {
    return self.rootSupport
  }

  effect fn measure(self: &Self, id: u32) -> Option<Measured>
    ! OutOfMemoryError
    ? &mut Allocator {
    if let Option<inspect.NodeInfo>.Some { value: node } = run inspect.info(self, id) {
      if node.laidOut {
        return Option<Measured>.Some {
          value: Measured {
            bounds: node.bounds,
            pressed: node.pressed,
            hovered: node.hovered,
            focused: node.focused,
          },
        }
      }
    }
    return Option<Measured>.None
  }

  fn range(self: &Self, id: u32) -> Option<VirtualRange> {
    return self.virtualRange(id)
  }

  effect fn indices(self: &Self, id: u32, out: &mut List<usize>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    if self.virtualRange(id).isNone() {
      return false
    }
    let wanted = run self.virtualIndices(id)
    run out.appendSlice(wanted.asSlice())
    return true
  }
}

fn effectLook<'a>(node: &'a Node, state: StyleState) -> &'a [Declaration] {
  return match state {
    StyleState.Hover => node.hover()
    StyleState.Active => node.active()
    StyleState.Focus => node.focus()
    StyleState.FocusVisible => node.focusVisible()
    _ => node.base.asSlice()
  }
}

fn lastEffect<'a>(declarations: &'a [Declaration], property: CssProperty) -> Option<&'a Declaration> {
  let mut i = declarations.length
  while i != 0 {
    i = i - 1
    if declarations[i].property == property { return Option<&'a Declaration>.some(&declarations[i]) }
  }
  return Option<&'a Declaration>.None
}

fn inheritTable(target: &mut CssStyle, parent: &CssStyle) {
  target.borderCollapse = parent.borderCollapse
  target.borderSpacingX = parent.borderSpacingX
  target.borderSpacingY = parent.borderSpacingY
  target.captionSide = parent.captionSide
}

// HTML `dir` attribute presentational hint: maps `rtl`/`ltr` to CSS `direction` + `unicode-bidi: isolate`
// and `auto` to `unicode-bidi: plaintext`, before author styles so CSS overrides it.
fn applyDirAttribute(node: &Node, computed: &mut Computed) {
  if let Option.Some { value: identity } = node.identity() {
    let attributes = identity.attributes()
    let mut i: usize = 0
    while i < attributes.length {
      let name = String.utf8Bytes(String.view(&attributes[i].name))
      if css_tokens.insensitive(name, b"dir") {
        let value = String.utf8Bytes(String.view(&attributes[i].value))
        if css_tokens.insensitive(value, b"rtl") {
          computed.apply(&declare.direction(Direction.Rtl))
          computed.apply(&declare.unicodeBidi(UnicodeBidi.Isolate))
        } else if css_tokens.insensitive(value, b"ltr") {
          computed.apply(&declare.direction(Direction.Ltr))
          computed.apply(&declare.unicodeBidi(UnicodeBidi.Isolate))
        } else if css_tokens.insensitive(value, b"auto") {
          computed.apply(&declare.unicodeBidi(UnicodeBidi.Plaintext))
        }
        return ()
      }
      i = i + 1
    }
  }
}

// HTML's `colspan` and `rowspan` on cells and `span` on columns, for the table layout.
fn tableSpans(node: &Node, layout: &mut CssStyle) {
  let spans = spansOf(node)
  layout.columnSpan = spans.0
  layout.rowSpan = spans.1
}

// A table part's column and row spans.
tuple Spans(usize, usize)

// The column and row spans `node`'s attributes give a table part.
fn spansOf(node: &Node) -> Spans {
  let mut columns: usize = 1
  let mut rows: usize = 1
  if let Option.Some { value: identity } = node.identity() {
    let attributes = identity.attributes()
    let mut i: usize = 0
    while i < attributes.length {
      let name = String.view(&attributes[i].name)
      let value = style_attributes.spanValue(String.view(&attributes[i].value))
      if (name == "colspan" || name == "span") && value > 0 && value != usize.MAX { columns = if value > 1000 { 1000 } else { value } }
      if name == "rowspan" && value != usize.MAX { rows = value }
      i = i + 1
    }
  }
  return Spans(columns, rows)
}

// Whether `node`'s span attributes give the spans `layout` holds.
fn sameSpans(node: &Node, layout: &CssStyle) -> bool {
  let spans = spansOf(node)
  return spans.0 == layout.columnSpan && spans.1 == layout.rowSpan
}

/// Whether `url` names an SVG file: a `.svg` path (before any query or fragment) or a
/// `data:image/svg` URL.
pub fn isSvgUrl(url: &[u8]) -> bool {
  let svg = b".svg"
  let data = b"data:image/svg"
  let mut end = url.length
  let mut q: usize = 0
  while q < url.length {
    if url[q] == 63 || url[q] == 35 {
      end = q
      break
    }
    q = q + 1
  }
  if end >= svg.length {
    let mut same = true
    let mut i: usize = 0
    while i < svg.length {
      let c = url[end - svg.length + i]
      let lower = if c >= 65 && c <= 90 { c + 32 } else { c }
      if lower != svg[i] {
        same = false
      }
      i = i + 1
    }
    if same {
      return true
    }
  }
  if url.length >= data.length {
    let mut i: usize = 0
    while i < data.length {
      if url[i] != data[i] {
        return false
      }
      i = i + 1
    }
    return true
  }
  return false
}

fn blankText(text: &[u8]) -> bool {
  let mut i: usize = 0
  while i < text.length {
    let c = text[i]
    if c != 32 && c != 9 && c != 10 && c != 12 && c != 13 { return false }
    i = i + 1
  }
  return true
}

